{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Low",
  "scopeName": "source.low",
  "fileTypes": ["low"],
  "patterns": [
    { "include": "#comment" },
    { "include": "#import" },
    { "include": "#declaration" },
    { "include": "#expression" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.double-slash.low",
      "match": "//.*$"
    },
    "import": {
      "match": "^\\s*(import)\\s+(?:([A-Za-z_][A-Za-z0-9_]*)\\s*(=)\\s*)?([A-Za-z_][A-Za-z0-9_/]*)",
      "captures": {
        "1": { "name": "keyword.control.import.low" },
        "2": { "name": "entity.name.namespace.low" },
        "3": { "name": "keyword.operator.assignment.low" },
        "4": { "name": "entity.name.namespace.low" }
      }
    },
    "declaration": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.function.low" },
            "2": { "name": "entity.name.function.low" }
          }
        },
        {
          "match": "\\b(struct|enum)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.low" },
            "2": { "name": "entity.name.type.low" }
          }
        },
        {
          "match": "\\b(const)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.low" },
            "2": { "name": "variable.other.constant.low" }
          }
        },
        {
          "match": "\\b(let|var|using(?:\\s+var)?)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.low" },
            "2": { "name": "variable.other.declaration.low" }
          }
        }
      ]
    },
    "expression": {
      "patterns": [
        { "include": "#comment" },
        { "include": "#string" },
        { "include": "#char" },
        { "include": "#number" },
        { "include": "#label" },
        { "include": "#keyword" },
        { "include": "#type" },
        { "include": "#call" },
        { "include": "#constructor" },
        { "include": "#field" },
        { "include": "#operator" },
        { "include": "#punctuation" }
      ]
    },
    "label": {
      "patterns": [
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(:)(?=\\s*for\\b)",
          "captures": {
            "1": { "name": "entity.name.label.low" },
            "2": { "name": "punctuation.separator.label.low" }
          }
        },
        {
          "match": "\\b(break|continue)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.loop.low" },
            "2": { "name": "entity.name.label.low" }
          }
        }
      ]
    },
    "keyword": {
      "patterns": [
        { "name": "keyword.control.conditional.low", "match": "\\b(if|else|match)\\b" },
        { "name": "keyword.control.loop.low", "match": "\\b(for|in|break|continue)\\b" },
        { "name": "keyword.control.return.low", "match": "\\breturn\\b" },
        { "name": "keyword.control.exception.low", "match": "\\b(fail|catch|or)\\b" },
        { "name": "keyword.control.concurrency.low", "match": "\\b(spawn|select|defer)\\b" },
        { "name": "keyword.control.resource.low", "match": "\\b(using|drop)\\b" },
        { "name": "keyword.control.import.low", "match": "\\bimport\\b" },
        { "name": "keyword.other.select-timeout.low", "match": "^\\s*\\b(after)\\b(?=\\s*\\()" },
        { "name": "keyword.other.when.low", "match": "(?<=[\\w)\\]}\"'?] )\\b(when)\\b(?= +[\\w(!\"'\\[])" },
        { "name": "storage.type.function.low", "match": "\\bfn\\b" },
        { "name": "storage.type.low", "match": "\\b(let|var|const|struct|enum)\\b" },
        { "name": "storage.modifier.low", "match": "\\b(pub|mut|extern)\\b" },
        { "name": "constant.language.boolean.low", "match": "\\b(true|false)\\b" },
        { "name": "constant.language.low", "match": "\\b(none|null)\\b" }
      ]
    },
    "type": {
      "patterns": [
        { "name": "support.type.primitive.low", "match": "\\b(i64|i32|u64|u32|u16|u8|f64|f32|bool|str|ptr|chan|u8x16|u8x32|u16x8|u16x16|i32x4|i32x8|u32x4|u32x8|i64x2|i64x4|u64x2|u64x4|f32x4|f32x8|f64x2|f64x4)\\b" },
        { "name": "support.type.constraint.low", "match": "\\b(Eq|Ord|Hash|Number|Integer|Float|Vector)\\b(?=\\s*[+,\\]])" }
      ]
    },
    "call": {
      "patterns": [
        {
          "match": "\\b(print|new|panic|push|pop|truncate|delete|bytes|cstr|view|load|store|pin|unpin|embed|sqrt|floor|exp|close|sleep|wait_readable|wait_writable)\\s*(?=\\()",
          "captures": { "1": { "name": "support.function.builtin.low" } }
        },
        {
          "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(?=\\(|\\[[^\\]]*\\]\\s*\\()",
          "captures": { "1": { "name": "entity.name.function.call.low" } }
        }
      ]
    },
    "constructor": {
      "match": "\\b[A-Z][A-Za-z0-9_]*\\b",
      "name": "entity.name.type.low"
    },
    "field": {
      "match": "(?<=[^.]\\.)[a-z_][A-Za-z0-9_]*",
      "name": "variable.other.property.low"
    },
    "number": {
      "patterns": [
        { "name": "constant.numeric.hex.low", "match": "\\b0x[0-9A-Fa-f_]+\\b" },
        { "name": "constant.numeric.binary.low", "match": "\\b0b[01_]+\\b" },
        { "name": "constant.numeric.octal.low", "match": "\\b0o[0-7_]+\\b" },
        { "name": "constant.numeric.float.low", "match": "\\b[0-9][0-9_]*(\\.[0-9][0-9_]*)?[eE][+-]?[0-9_]+\\b" },
        { "name": "constant.numeric.float.low", "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*\\b" },
        { "name": "constant.numeric.integer.low", "match": "\\b[0-9][0-9_]*\\b" }
      ]
    },
    "escape": {
      "name": "constant.character.escape.low",
      "match": "\\\\[ntr0\\\\\"']"
    },
    "char": {
      "name": "string.quoted.single.low",
      "match": "'(\\\\[ntr0\\\\\"']|[^'\\\\])'",
      "captures": {
        "1": { "patterns": [{ "include": "#escape" }] }
      }
    },
    "string": {
      "name": "string.quoted.double.low",
      "begin": "\"",
      "end": "\"|$",
      "patterns": [
        { "include": "#escape" },
        { "name": "constant.character.escape.low", "match": "\\{\\{|\\}\\}" },
        {
          "name": "meta.interpolation.low",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.low" } },
          "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.low" } },
          "contentName": "source.low",
          "patterns": [
            {
              "match": "([,:])([^{}\"()\\[\\]]*)(?=\\})",
              "captures": {
                "1": { "name": "punctuation.separator.interpolation.low" },
                "2": { "name": "constant.other.format.low" }
              }
            },
            { "include": "#interpolated" }
          ]
        }
      ]
    },
    "interpolated": {
      "patterns": [
        {
          "begin": "\\{",
          "end": "\\}",
          "patterns": [{ "include": "#interpolated" }]
        },
        { "include": "#expression" }
      ]
    },
    "operator": {
      "patterns": [
        { "name": "keyword.operator.pipe.low", "match": "\\|>" },
        { "name": "keyword.operator.arrow.low", "match": "->|=>|<-" },
        { "name": "keyword.operator.range.low", "match": "\\.\\.\\.?" },
        { "name": "keyword.operator.coalesce.low", "match": "\\?\\?" },
        { "name": "keyword.operator.assignment.compound.low", "match": "(<<|>>|[+\\-*/%&|^])=" },
        { "name": "keyword.operator.comparison.low", "match": "==|!=|<=|>=|<|>" },
        { "name": "keyword.operator.logical.low", "match": "&&|\\|\\||!" },
        { "name": "keyword.operator.bitwise.low", "match": "<<|>>|[&|^~]" },
        { "name": "keyword.operator.arithmetic.low", "match": "[+\\-*/%]" },
        { "name": "keyword.operator.assignment.low", "match": "=" },
        { "name": "keyword.operator.try.low", "match": "\\?" }
      ]
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.separator.comma.low", "match": "," },
        { "name": "punctuation.separator.colon.low", "match": ":" },
        { "name": "punctuation.accessor.low", "match": "\\." }
      ]
    }
  }
}
