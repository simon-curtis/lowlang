{
  "name": "lowlang",
  "displayName": "LowLang",
  "description": "LowLang syntax highlighting and language server client",
  "version": "0.1.0",
  "publisher": "lowlang",
  "private": true,
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "icon": "icon.png",
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "low",
        "aliases": [
          "LowLang",
          "low"
        ],
        "extensions": [
          ".low"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "low",
        "scopeName": "source.low",
        "path": "./syntaxes/low.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "LowLang",
      "properties": {
        "lowlang.server.path": {
          "type": "string",
          "default": "low",
          "description": "Path to the low binary that serves `low lsp`."
        }
      }
    },
    "commands": [
      {
        "command": "lowlang.restartServer",
        "title": "LowLang: Restart Language Server"
      }
    ]
  },
  "scripts": {
    "check": "tsc -p .",
    "build": "esbuild src/extension.ts --bundle --minify --platform=node --format=cjs --external:vscode --outfile=out/extension.js",
    "package": "npm run check && npm run build && vsce package --no-dependencies --allow-missing-repository --skip-license"
  },
  "dependencies": {
    "vscode-languageclient": "11.0.0"
  },
  "devDependencies": {
    "@types/vscode": "1.91.0",
    "@vscode/vsce": "4.1.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
