struct __Rune {
    code: u32
    size: i64
}

fn __continuation(s: str, i: i64) -> bool {
    i < s.len && s[i] & 0xC0 == 0x80
}

fn __utf8_decode(s: str, i: i64) -> __Rune {
    let b0 = u32(s[i])
    if b0 < 0x80 {
        return __Rune { code: b0, size: 1 }
    }
    if b0 >= 0xC2 && b0 < 0xE0 && __continuation(s, i + 1) {
        let code = (b0 & 0x1F) << 6 | u32(s[i + 1]) & 0x3F
        return __Rune { code, size: 2 }
    }
    if b0 >= 0xE0 && b0 < 0xF0 && __continuation(s, i + 1) && __continuation(s, i + 2) {
        let code = (b0 & 0x0F) << 12 | (u32(s[i + 1]) & 0x3F) << 6 | u32(s[i + 2]) & 0x3F
        if code >= 0x800 && (code < 0xD800 || code >= 0xE000) {
            return __Rune { code, size: 3 }
        }
    }
    if b0 >= 0xF0 && b0 < 0xF5 && __continuation(s, i + 1) && __continuation(s, i + 2) && __continuation(s, i + 3) {
        let high = (b0 & 0x07) << 18 | (u32(s[i + 1]) & 0x3F) << 12
        let code = high | (u32(s[i + 2]) & 0x3F) << 6 | u32(s[i + 3]) & 0x3F
        if code >= 0x10000 && code <= 0x10FFFF {
            return __Rune { code, size: 4 }
        }
    }
    __Rune { code: 0xFFFD, size: 1 }
}

fn __append_str(mut b: []u8, s: str) {
    for i in 0..s.len {
        push(mut b, s[i])
    }
}

fn __append_bool(mut b: []u8, v: bool) {
    if v {
        __append_str(mut b, "true")
    } else {
        __append_str(mut b, "false")
    }
}

fn __append_i64(mut b: []u8, n: i64) {
    if n < 0 {
        push(mut b, '-')
    }
    var digits: []u8 = []
    var v = n
    for {
        var d = v % 10
        if d < 0 {
            d = -d
        }
        push(mut digits, u8(d) + '0')
        v = v / 10
        if v == 0 {
            break
        }
    }
    var i = digits.len - 1
    for i >= 0 {
        push(mut b, digits[i])
        i -= 1
    }
}

fn __append_f64(mut b: []u8, x: f64) {
    let bits = __bits(x)
    __append_float(mut b, bits < 0, bits >> 52 & 0x7FF, bits & 0xFFFFFFFFFFFFF, 52, 1023)
}

fn __append_f32(mut b: []u8, x: f32) {
    let bits = i64(__bits(x))
    __append_float(mut b, bits & 0x80000000 != 0, bits >> 23 & 0xFF, bits & 0x7FFFFF, 23, 127)
}

fn __append_float(mut b: []u8, negative: bool, exponent: i64, fraction: i64, mantissa: i64, bias: i64) {
    if exponent == 2 * bias + 1 {
        if fraction != 0 {
            __append_str(mut b, "NaN")
            return
        }
        if negative {
            push(mut b, '-')
        }
        __append_str(mut b, "inf")
        return
    }
    if negative {
        push(mut b, '-')
    }
    if exponent == 0 && fraction == 0 {
        push(mut b, '0')
        return
    }
    let hidden = 1 << mantissa
    let minExp = 1 - bias - mantissa
    var f = fraction
    var e = minExp
    if exponent != 0 {
        f = fraction | hidden
        e = exponent - bias - mantissa
    }
    var digits: []u8 = []
    let k = __shortest(f, e, minExp, hidden, mut digits)
    __place_digits(mut b, digits, k)
}

fn __shortest(f: i64, e: i64, minExp: i64, hidden: i64, mut digits: []u8) -> i64 {
    let even = f % 2 == 0
    var r = __big(f)
    var s = __big(1)
    var mp = __big(1)
    var mm = __big(1)
    if e >= 0 {
        __shl(mut mp, e)
        __shl(mut mm, e)
        if f != hidden {
            __shl(mut r, e + 1)
            s = __big(2)
        } else {
            __shl(mut r, e + 2)
            s = __big(4)
            __shl(mut mp, 1)
        }
    } else {
        if e == minExp || f != hidden {
            __shl(mut r, 1)
            __shl(mut s, 1 - e)
        } else {
            __shl(mut r, 2)
            __shl(mut s, 2 - e)
            mp = __big(2)
        }
    }
    var k = __estimate(f, e)
    if k >= 0 {
        __pow10(mut s, k)
    } else {
        __pow10(mut r, -k)
        __pow10(mut mp, -k)
        __pow10(mut mm, -k)
    }
    for __high(r, mp, s, even) {
        __mul(mut s, 10)
        k += 1
    }
    for {
        __mul(mut r, 10)
        __mul(mut mp, 10)
        __mul(mut mm, 10)
        var d: u8 = 0
        for __cmp(r, s) >= 0 {
            __sub(mut r, s)
            d += 1
        }
        let low = if even { __cmp(r, mm) <= 0 } else { __cmp(r, mm) < 0 }
        let high = __high(r, mp, s, even)
        if !low && !high {
            push(mut digits, '0' + d)
            continue
        }
        if low && high {
            var twice = __copy(r)
            __mul(mut twice, 2)
            if __cmp(twice, s) >= 0 {
                d += 1
            }
        } else if high {
            d += 1
        }
        push(mut digits, '0' + d)
        break
    }
    k
}

fn __high(r: []i64, mp: []i64, s: []i64, even: bool) -> bool {
    let sum = __add(r, mp)
    if even { __cmp(sum, s) >= 0 } else { __cmp(sum, s) > 0 }
}

fn __estimate(f: i64, e: i64) -> i64 {
    var bits = 0
    var v = f
    for v > 0 {
        v = v >> 1
        bits += 1
    }
    let log = f64(e + bits - 1) * 0.30102999566398114
    -i64(floor(-log))
}

fn __place_digits(mut b: []u8, digits: []u8, k: i64) {
    let n = digits.len
    if k >= -5 && k <= 21 {
        if k <= 0 {
            __append_str(mut b, "0.")
            for i in 0..-k {
                push(mut b, '0')
            }
            for d in digits {
                push(mut b, d)
            }
        } else if k >= n {
            for d in digits {
                push(mut b, d)
            }
            for i in 0..k - n {
                push(mut b, '0')
            }
        } else {
            for i in 0..k {
                push(mut b, digits[i])
            }
            push(mut b, '.')
            for i in k..n {
                push(mut b, digits[i])
            }
        }
        return
    }
    push(mut b, digits[0])
    if n > 1 {
        push(mut b, '.')
        for i in 1..n {
            push(mut b, digits[i])
        }
    }
    push(mut b, 'e')
    let x = k - 1
    if x < 0 {
        push(mut b, '-')
        __append_i64(mut b, -x)
    } else {
        push(mut b, '+')
        __append_i64(mut b, x)
    }
}

fn __big(n: i64) -> []i64 {
    var a: []i64 = []
    push(mut a, n & 0xFFFFFFFF)
    push(mut a, n >> 32)
    a
}

fn __copy(a: []i64) -> []i64 {
    var c: []i64 = []
    for x in a {
        push(mut c, x)
    }
    c
}

fn __mul(mut a: []i64, m: i64) {
    var carry = 0
    for i in 0..a.len {
        let v = a[i] * m + carry
        a[i] = v & 0xFFFFFFFF
        carry = v >> 32
    }
    if carry != 0 {
        push(mut a, carry)
    }
}

fn __shl(mut a: []i64, n: i64) {
    let words = n / 32
    if words > 0 {
        var shifted: []i64 = []
        for i in 0..words {
            push(mut shifted, 0)
        }
        for x in a {
            push(mut shifted, x)
        }
        a = shifted
    }
    let bits = n % 32
    if bits > 0 {
        __mul(mut a, 1 << bits)
    }
}

fn __pow10(mut a: []i64, k: i64) {
    for i in 0..k {
        __mul(mut a, 10)
    }
}

fn __top(a: []i64) -> i64 {
    var i = a.len - 1
    for i >= 0 && a[i] == 0 {
        i -= 1
    }
    i
}

fn __cmp(a: []i64, b: []i64) -> i64 {
    let ta = __top(a)
    let tb = __top(b)
    if ta != tb {
        return if ta < tb { -1 } else { 1 }
    }
    var i = ta
    for i >= 0 {
        if a[i] != b[i] {
            return if a[i] < b[i] { -1 } else { 1 }
        }
        i -= 1
    }
    0
}

fn __add(a: []i64, b: []i64) -> []i64 {
    var out: []i64 = []
    var carry = 0
    var i = 0
    for i < a.len || i < b.len {
        var v = carry
        if i < a.len {
            v += a[i]
        }
        if i < b.len {
            v += b[i]
        }
        push(mut out, v & 0xFFFFFFFF)
        carry = v >> 32
        i += 1
    }
    if carry != 0 {
        push(mut out, carry)
    }
    out
}

fn __sub(mut a: []i64, b: []i64) {
    var borrow = 0
    for i in 0..a.len {
        var v = a[i] - borrow
        if i < b.len {
            v -= b[i]
        }
        if v < 0 {
            v += 0x100000000
            borrow = 1
        } else {
            borrow = 0
        }
        a[i] = v
    }
}

fn __format_f64(x: f64) -> str {
    var b: []u8 = []
    __append_f64(mut b, x)
    __str_view(b)
}

fn __format_f32(x: f32) -> str {
    var b: []u8 = []
    __append_f32(mut b, x)
    __str_view(b)
}

fn __concat(a: str, c: str) -> str {
    var b: []u8 = []
    __append_str(mut b, a)
    __append_str(mut b, c)
    __str_view(b)
}

fn __bytes(s: str) -> []u8 {
    var b: []u8 = []
    __append_str(mut b, s)
    b
}

fn __from_bytes(src: []u8) -> str {
    var b: []u8 = []
    for x in src {
        push(mut b, x)
    }
    __str_view(b)
}

struct __Map {
    entries: []__word
    index: []i64
    width: i64
    text: bool
    count: i64
    dead: i64
}

fn __map_new(width: i64, text: bool) -> *__Map {
    var index: []i64 = []
    for i in 0..8 {
        push(mut index, 0)
    }
    new(__Map { entries: [], index, width, text, count: 0, dead: 0 })
}

fn __map_len(m: *__Map) -> i64 {
    m.count
}

fn __map_hash(m: *__Map, k0: __word, k1: __word) -> i64 {
    var h = 1469598103934665603
    if m.text {
        let s = __str_raw(k0, k1)
        for i in 0..s.len {
            h = (h ^ i64(s[i])) * 1099511628211
        }
    } else {
        let k = i64(k0)
        h = (k ^ k >> 31) * 0x9E3779B97F4A7C1
        h = h ^ h >> 29
    }
    h & 0x7FFFFFFFFFFFFFFF
}

fn __map_same(m: *__Map, base: i64, k0: __word, k1: __word) -> bool {
    if m.text {
        return __str_raw(m.entries[base + 1], m.entries[base + 2]) == __str_raw(k0, k1)
    }
    m.entries[base + 1] == k0
}

fn __map_probe(m: *__Map, k0: __word, k1: __word) -> i64 {
    let mask = m.index.len - 1
    var i = __map_hash(m, k0, k1) & mask
    for {
        let slot = m.index[i]
        if slot == 0 {
            return i
        }
        if slot > 0 && __map_same(m, (slot - 1) * m.width, k0, k1) {
            return i
        }
        i = (i + 1) & mask
    }
}

fn __map_find(m: *__Map, k0: __word, k1: __word) -> i64 {
    let slot = m.index[__map_probe(m, k0, k1)]
    if slot <= 0 {
        return -1
    }
    (slot - 1) * m.width
}

fn __map_slot(m: *__Map, k0: __word, k1: __word) -> i64 {
    var i = __map_probe(m, k0, k1)
    let slot = m.index[i]
    if slot > 0 {
        return (slot - 1) * m.width
    }
    if (m.count + m.dead + 1) * 4 > m.index.len * 3 {
        __map_rebuild(m)
        i = __map_probe(m, k0, k1)
    }
    let base = m.entries.len
    push(mut m.entries, 1)
    push(mut m.entries, k0)
    var used = 2
    if m.text {
        push(mut m.entries, k1)
        used = 3
    }
    for j in used..m.width {
        push(mut m.entries, 0)
    }
    m.index[i] = base / m.width + 1
    m.count += 1
    base
}

fn __map_delete(m: *__Map, k0: __word, k1: __word) {
    let i = __map_probe(m, k0, k1)
    let slot = m.index[i]
    if slot <= 0 {
        return
    }
    m.entries[(slot - 1) * m.width] = 0
    m.index[i] = -1
    m.count -= 1
    m.dead += 1
}

fn __map_rebuild(m: *__Map) {
    var entries: []__word = []
    var e = 0
    for e < m.entries.len {
        if m.entries[e] == 1 {
            for j in 0..m.width {
                push(mut entries, m.entries[e + j])
            }
        }
        e += m.width
    }
    var size = 8
    for size * 3 <= (m.count + 1) * 8 {
        size *= 2
    }
    var index: []i64 = []
    for i in 0..size {
        push(mut index, 0)
    }
    let mask = size - 1
    var n = 0
    for n * m.width < entries.len {
        let base = n * m.width
        let k1: __word = if m.text { entries[base + 2] } else { 0 }
        var i = __map_hash(m, entries[base + 1], k1) & mask
        for index[i] != 0 {
            i = (i + 1) & mask
        }
        index[i] = n + 1
        n += 1
    }
    m.entries = entries
    m.index = index
    m.dead = 0
}

fn __map_next(m: *__Map, from: i64) -> i64 {
    var e = from
    for e < m.entries.len {
        if m.entries[e] == 1 {
            return e
        }
        e += m.width
    }
    -1
}
