struct __Rune {
    code: u32
    size: i64
}

fn __continuation(s: str, i: i64) -> bool {
    i < s.len && s[i] & 0xC0 == 0x80
}

fn __utf8_decode(s: str, i: i64) -> __Rune {
    let b0 = u32(s[i])
    if b0 < 0x80 {
        return __Rune { code: b0, size: 1 }
    }
    if b0 >= 0xC2 && b0 < 0xE0 && __continuation(s, i + 1) {
        let code = (b0 & 0x1F) << 6 | u32(s[i + 1]) & 0x3F
        return __Rune { code, size: 2 }
    }
    if b0 >= 0xE0 && b0 < 0xF0 && __continuation(s, i + 1) && __continuation(s, i + 2) {
        let code = (b0 & 0x0F) << 12 | (u32(s[i + 1]) & 0x3F) << 6 | u32(s[i + 2]) & 0x3F
        if code >= 0x800 && (code < 0xD800 || code >= 0xE000) {
            return __Rune { code, size: 3 }
        }
    }
    if b0 >= 0xF0 && b0 < 0xF5 && __continuation(s, i + 1) && __continuation(s, i + 2) && __continuation(s, i + 3) {
        let high = (b0 & 0x07) << 18 | (u32(s[i + 1]) & 0x3F) << 12
        let code = high | (u32(s[i + 2]) & 0x3F) << 6 | u32(s[i + 3]) & 0x3F
        if code >= 0x10000 && code <= 0x10FFFF {
            return __Rune { code, size: 4 }
        }
    }
    __Rune { code: 0xFFFD, size: 1 }
}

fn __append_str(mut b: []u8, s: str) {
    __extend(mut b, s)
}

fn __append_bool(mut b: []u8, v: bool) {
    if v {
        __append_str(mut b, "true")
    } else {
        __append_str(mut b, "false")
    }
}

fn __append_i64(mut b: []u8, n: i64) {
    if n < 0 {
        push(mut b, '-')
    }
    var digits: []u8 = []
    var v = n
    for {
        var d = v % 10
        if d < 0 {
            d = -d
        }
        push(mut digits, u8(d) + '0')
        v = v / 10
        if v == 0 {
            break
        }
    }
    var i = digits.len - 1
    for i >= 0 {
        push(mut b, digits[i])
        i -= 1
    }
}

fn __append_f64(mut b: []u8, x: f64) {
    let bits = __bits(x)
    __append_float(mut b, bits < 0, bits >> 52 & 0x7FF, bits & 0xFFFFFFFFFFFFF, 52, 1023)
}

fn __append_f32(mut b: []u8, x: f32) {
    let bits = i64(__bits(x))
    __append_float(mut b, bits & 0x80000000 != 0, bits >> 23 & 0xFF, bits & 0x7FFFFF, 23, 127)
}

fn __append_float(mut b: []u8, negative: bool, exponent: i64, fraction: i64, mantissa: i64, bias: i64) {
    if exponent == 2 * bias + 1 {
        if fraction != 0 {
            __append_str(mut b, "NaN")
            return
        }
        if negative {
            push(mut b, '-')
        }
        __append_str(mut b, "inf")
        return
    }
    if negative {
        push(mut b, '-')
    }
    if exponent == 0 && fraction == 0 {
        push(mut b, '0')
        return
    }
    let hidden = 1 << mantissa
    let minExp = 1 - bias - mantissa
    var f = fraction
    var e = minExp
    if exponent != 0 {
        f = fraction | hidden
        e = exponent - bias - mantissa
    }
    var digits: []u8 = []
    let k = __shortest(f, e, minExp, hidden, mut digits)
    __place_digits(mut b, digits, k)
}

fn __shortest(f: i64, e: i64, minExp: i64, hidden: i64, mut digits: []u8) -> i64 {
    let even = f % 2 == 0
    var r = __big(f)
    var s = __big(1)
    var mp = __big(1)
    var mm = __big(1)
    if e >= 0 {
        __shl(mut mp, e)
        __shl(mut mm, e)
        if f != hidden {
            __shl(mut r, e + 1)
            s = __big(2)
        } else {
            __shl(mut r, e + 2)
            s = __big(4)
            __shl(mut mp, 1)
        }
    } else {
        if e == minExp || f != hidden {
            __shl(mut r, 1)
            __shl(mut s, 1 - e)
        } else {
            __shl(mut r, 2)
            __shl(mut s, 2 - e)
            mp = __big(2)
        }
    }
    var k = __estimate(f, e)
    if k >= 0 {
        __pow10(mut s, k)
    } else {
        __pow10(mut r, -k)
        __pow10(mut mp, -k)
        __pow10(mut mm, -k)
    }
    for __high(r, mp, s, even) {
        __mul(mut s, 10)
        k += 1
    }
    for {
        __mul(mut r, 10)
        __mul(mut mp, 10)
        __mul(mut mm, 10)
        var d: u8 = 0
        for __cmp(r, s) >= 0 {
            __sub(mut r, s)
            d += 1
        }
        let low = if even { __cmp(r, mm) <= 0 } else { __cmp(r, mm) < 0 }
        let high = __high(r, mp, s, even)
        if !low && !high {
            push(mut digits, '0' + d)
            continue
        }
        if low && high {
            var twice = __copy(r)
            __mul(mut twice, 2)
            if __cmp(twice, s) >= 0 {
                d += 1
            }
        } else if high {
            d += 1
        }
        push(mut digits, '0' + d)
        break
    }
    k
}

fn __high(r: []i64, mp: []i64, s: []i64, even: bool) -> bool {
    let sum = __add(r, mp)
    if even { __cmp(sum, s) >= 0 } else { __cmp(sum, s) > 0 }
}

fn __estimate(f: i64, e: i64) -> i64 {
    var bits = 0
    var v = f
    for v > 0 {
        v = v >> 1
        bits += 1
    }
    let log = f64(e + bits - 1) * 0.30102999566398114
    -i64(floor(-log))
}

fn __place_digits(mut b: []u8, digits: []u8, k: i64) {
    let n = digits.len
    if k >= -5 && k <= 21 {
        if k <= 0 {
            __append_str(mut b, "0.")
            for i in 0..-k {
                push(mut b, '0')
            }
            for d in digits {
                push(mut b, d)
            }
        } else if k >= n {
            for d in digits {
                push(mut b, d)
            }
            for i in 0..k - n {
                push(mut b, '0')
            }
        } else {
            for i in 0..k {
                push(mut b, digits[i])
            }
            push(mut b, '.')
            for i in k..n {
                push(mut b, digits[i])
            }
        }
        return
    }
    push(mut b, digits[0])
    if n > 1 {
        push(mut b, '.')
        for i in 1..n {
            push(mut b, digits[i])
        }
    }
    push(mut b, 'e')
    let x = k - 1
    if x < 0 {
        push(mut b, '-')
        __append_i64(mut b, -x)
    } else {
        push(mut b, '+')
        __append_i64(mut b, x)
    }
}

fn __big(n: i64) -> []i64 {
    var a: []i64 = []
    push(mut a, n & 0xFFFFFFFF)
    push(mut a, n >> 32)
    a
}

fn __copy(a: []i64) -> []i64 {
    var c: []i64 = []
    for x in a {
        push(mut c, x)
    }
    c
}

fn __mul(mut a: []i64, m: i64) {
    var carry = 0
    for i in 0..a.len {
        let v = a[i] * m + carry
        a[i] = v & 0xFFFFFFFF
        carry = v >> 32
    }
    if carry != 0 {
        push(mut a, carry)
    }
}

fn __shl(mut a: []i64, n: i64) {
    let words = n / 32
    if words > 0 {
        var shifted: []i64 = []
        for i in 0..words {
            push(mut shifted, 0)
        }
        for x in a {
            push(mut shifted, x)
        }
        a = shifted
    }
    let bits = n % 32
    if bits > 0 {
        __mul(mut a, 1 << bits)
    }
}

fn __pow10(mut a: []i64, k: i64) {
    for i in 0..k {
        __mul(mut a, 10)
    }
}

fn __top(a: []i64) -> i64 {
    var i = a.len - 1
    for i >= 0 && a[i] == 0 {
        i -= 1
    }
    i
}

fn __cmp(a: []i64, b: []i64) -> i64 {
    let ta = __top(a)
    let tb = __top(b)
    if ta != tb {
        return if ta < tb { -1 } else { 1 }
    }
    var i = ta
    for i >= 0 {
        if a[i] != b[i] {
            return if a[i] < b[i] { -1 } else { 1 }
        }
        i -= 1
    }
    0
}

fn __add(a: []i64, b: []i64) -> []i64 {
    var out: []i64 = []
    var carry = 0
    var i = 0
    for i < a.len || i < b.len {
        var v = carry
        if i < a.len {
            v += a[i]
        }
        if i < b.len {
            v += b[i]
        }
        push(mut out, v & 0xFFFFFFFF)
        carry = v >> 32
        i += 1
    }
    if carry != 0 {
        push(mut out, carry)
    }
    out
}

fn __sub(mut a: []i64, b: []i64) {
    var borrow = 0
    for i in 0..a.len {
        var v = a[i] - borrow
        if i < b.len {
            v -= b[i]
        }
        if v < 0 {
            v += 0x100000000
            borrow = 1
        } else {
            borrow = 0
        }
        a[i] = v
    }
}

fn __format_f64(x: f64) -> str {
    var b: []u8 = []
    __append_f64(mut b, x)
    __str_view(b)
}

fn __format_f32(x: f32) -> str {
    var b: []u8 = []
    __append_f32(mut b, x)
    __str_view(b)
}

fn __concat(a: str, c: str) -> str {
    var b: []u8 = []
    __append_str(mut b, a)
    __append_str(mut b, c)
    __str_view(b)
}

fn __str_cmp(a: str, b: str) -> i64 {
    var n = a.len
    if b.len < n {
        n = b.len
    }
    for i in 0..n {
        if a[i] != b[i] {
            return i64(a[i]) - i64(b[i])
        }
    }
    a.len - b.len
}

fn __bytes(s: str) -> []u8 {
    var b: []u8 = []
    __append_str(mut b, s)
    b
}

fn __cstr(s: str) -> ptr[u8] {
    var b: []u8 = []
    __append_str(mut b, s)
    push(mut b, 0)
    __slice_ptr(b)
}

fn __from_cstr(p: ptr[u8]) -> str {
    let bytes = view(p, 0x7FFFFFFFFFFFFFFF)
    var b: []u8 = []
    var i = 0
    for bytes[i] != 0 {
        push(mut b, bytes[i])
        i += 1
    }
    __str_view(b)
}

fn __from_bytes(src: []u8) -> str {
    var b: []u8 = []
    __extend(mut b, __str_view(src))
    __str_view(b)
}

fn __hash_word(k: i64) -> i64 {
    var h = (k ^ k >> 31) * 0x9E3779B97F4A7C1
    h = h ^ h >> 29
    h & 0x7FFFFFFFFFFFFFFF
}

fn __hash_str(s: str) -> i64 {
    var h = 1469598103934665603
    for i in 0..s.len {
        h = (h ^ i64(s[i])) * 1099511628211
    }
    h & 0x7FFFFFFFFFFFFFFF
}

struct __Entry[K, V] {
    live: bool
    key: K
    value: V
}

struct __Map[K, V] {
    entries: []__Entry[K, V]
    index: []i64
    count: i64
    dead: i64
}

fn __map_index(size: i64) -> []i64 {
    var index: []i64 = []
    for i in 0..size {
        push(mut index, 0)
    }
    index
}

fn __map_new[K: Hash, V]() -> *__Map[K, V] {
    new(__Map { entries: [], index: __map_index(8), count: 0, dead: 0 })
}

fn __map_len[K: Hash, V](m: *__Map[K, V]) -> i64 {
    m.count
}

fn __map_probe[K: Hash, V](m: *__Map[K, V], k: K) -> i64 {
    let mask = m.index.len - 1
    var i = __hash(k) & mask
    for {
        let slot = m.index[i]
        if slot == 0 {
            return i
        }
        if slot > 0 && m.entries[slot - 1].key == k {
            return i
        }
        i = (i + 1) & mask
    }
}

fn __map_get[K: Hash, V](m: *__Map[K, V], k: K) -> V? {
    let slot = m.index[__map_probe(m, k)]
    if slot <= 0 {
        return none
    }
    m.entries[slot - 1].value
}

fn __map_set[K: Hash, V](m: *__Map[K, V], k: K, v: V) {
    var i = __map_probe(m, k)
    let slot = m.index[i]
    if slot > 0 {
        m.entries[slot - 1].value = v
        return
    }
    if (m.count + m.dead + 1) * 4 > m.index.len * 3 {
        __map_rebuild(m)
        i = __map_probe(m, k)
    }
    push(mut m.entries, __Entry { live: true, key: k, value: v })
    m.index[i] = m.entries.len
    m.count += 1
}

fn __map_delete[K: Hash, V](m: *__Map[K, V], k: K) {
    let i = __map_probe(m, k)
    let slot = m.index[i]
    if slot <= 0 {
        return
    }
    m.entries[slot - 1] = __Entry { live: false, key: k, value: __zero() }
    m.index[i] = -1
    m.count -= 1
    m.dead += 1
}

fn __map_rebuild[K: Hash, V](m: *__Map[K, V]) {
    var entries: []__Entry[K, V] = []
    for e in m.entries {
        if e.live {
            push(mut entries, e)
        }
    }
    var size = 8
    for size * 3 <= (m.count + 1) * 8 {
        size *= 2
    }
    var index = __map_index(size)
    let mask = size - 1
    for n in 0..entries.len {
        var i = __hash(entries[n].key) & mask
        for index[i] != 0 {
            i = (i + 1) & mask
        }
        index[i] = n + 1
    }
    m.entries = entries
    m.index = index
    m.dead = 0
}

fn __map_next[K: Hash, V](m: *__Map[K, V], from: i64) -> i64 {
    var e = from
    for e < m.entries.len {
        if m.entries[e].live {
            return e
        }
        e += 1
    }
    -1
}

fn __map_key[K: Hash, V](m: *__Map[K, V], e: i64) -> K {
    m.entries[e].key
}

fn __map_value[K: Hash, V](m: *__Map[K, V], e: i64) -> V {
    m.entries[e].value
}

struct __Waiter {
    claimed: i64
    index: i64
    ok: bool
    g: ptr
    wake: ptr
}

struct __Box[T] {
    value: T
}

struct __Wait[T] {
    w: *__Waiter
    index: i64
    box: *__Box[T]
}

struct __Queue[T] {
    items: []T
    head: i64
    count: i64
}

struct __Chan[T] {
    lock: i64
    buf: []T
    head: i64
    count: i64
    closed: bool
    recvq: __Queue[__Wait[T]]
    sendq: __Queue[__Wait[T]]
}

struct __Sent {
    done: bool
    wake: ptr
}

struct __Got[T] {
    state: i64
    value: T
    wake: ptr
}

fn __waiter() -> *__Waiter {
    new(__Waiter { claimed: 0, index: -1, ok: false, g: __current(), wake: null })
}

fn __box[T]() -> *__Box[T] {
    new(__Box { value: __zero() })
}

fn __wake(g: ptr) {
    if g != null {
        __ready(g)
    }
}

fn __claim(w: *__Waiter, index: i64, ok: bool) -> bool {
    if !__cas(mut w.claimed, 0, 1) {
        return false
    }
    w.index = index
    w.ok = ok
    true
}

fn __queue[T]() -> __Queue[T] {
    __Queue { items: [], head: 0, count: 0 }
}

fn __enqueue[T](mut q: __Queue[T], item: T) {
    if q.count == q.items.len {
        var grown: []T = []
        var size = 2 * q.items.len
        if size < 4 {
            size = 4
        }
        for i in 0..size {
            push(mut grown, __zero())
        }
        for i in 0..q.count {
            grown[i] = q.items[__wrap(q.head + i, q.items.len)]
        }
        q.items = grown
        q.head = 0
    }
    q.items[__wrap(q.head + q.count, q.items.len)] = item
    q.count += 1
}

fn __dequeue[T](mut q: __Queue[T]) -> T? {
    if q.count == 0 {
        return none
    }
    let item = q.items[q.head]
    q.items[q.head] = __zero()
    q.head = __wrap(q.head + 1, q.items.len)
    q.count -= 1
    item
}

fn __pop[T](mut q: __Queue[__Wait[T]], ok: bool) -> __Wait[T]? {
    for {
        match __dequeue(mut q) {
            some(e) => {
                if __claim(e.w, e.index, ok) {
                    return e
                }
            }
            none => return none
        }
    }
}

fn __remove[T](mut q: __Queue[__Wait[T]], w: *__Waiter) {
    let n = q.count
    for i in 0..n {
        let e = __dequeue(mut q) ?? __zero()
        if e.w != w {
            __enqueue(mut q, e)
        }
    }
}

fn __chan_new[T](cap: i64) -> *__Chan[T] {
    if cap < 0 {
        __panic("negative channel capacity")
    }
    var buf: []T = []
    for i in 0..cap {
        push(mut buf, __zero())
    }
    new(__Chan { lock: 0, buf, head: 0, count: 0, closed: false, recvq: __queue(), sendq: __queue() })
}

fn __wrap(i: i64, n: i64) -> i64 {
    if i >= n {
        return i - n
    }
    i
}

fn __try_recv[T](c: *__Chan[T]) -> __Got[T] {
    if c.count > 0 {
        let v = c.buf[c.head]
        c.buf[c.head] = __zero()
        c.head = __wrap(c.head + 1, c.buf.len)
        c.count -= 1
        var wake: ptr = null
        if c.sendq.count > 0 {
            match __pop(mut c.sendq, true) {
                some(s) => {
                    c.buf[__wrap(c.head + c.count, c.buf.len)] = s.box.value
                    c.count += 1
                    wake = s.w.g
                }
                none => {}
            }
        }
        return __Got { state: 1, value: v, wake }
    }
    if c.sendq.count > 0 {
        match __pop(mut c.sendq, true) {
            some(s) => return __Got { state: 1, value: s.box.value, wake: s.w.g }
            none => {}
        }
    }
    let state = if c.closed { 0 } else { -1 }
    __Got { state, value: __zero(), wake: null }
}

fn __try_send[T](c: *__Chan[T], v: T) -> __Sent {
    if c.closed {
        __panic("send on closed channel")
    }
    if c.recvq.count > 0 {
        match __pop(mut c.recvq, true) {
            some(r) => {
                r.box.value = v
                return __Sent { done: true, wake: r.w.g }
            }
            none => {}
        }
    }
    if c.count < c.buf.len {
        c.buf[__wrap(c.head + c.count, c.buf.len)] = v
        c.count += 1
        return __Sent { done: true, wake: null }
    }
    __Sent { done: false, wake: null }
}

fn __chan_send[T](c: *__Chan[T], v: T) {
    __lock(mut c.lock)
    let sent = __try_send(c, v)
    if sent.done {
        __unlock(mut c.lock)
        __wake(sent.wake)
        return
    }
    let w = __waiter()
    __enqueue(mut c.sendq, __Wait { w, index: 0, box: new(__Box { value: v }) })
    __unlock(mut c.lock)
    __park()
    if !w.ok {
        __panic("send on closed channel")
    }
}

fn __chan_recv[T](c: *__Chan[T]) -> T? {
    __lock(mut c.lock)
    let got = __try_recv(c)
    if got.state >= 0 {
        __unlock(mut c.lock)
        __wake(got.wake)
        if got.state == 1 {
            return got.value
        }
        return none
    }
    let w = __waiter()
    let box: *__Box[T] = __box()
    __enqueue(mut c.recvq, __Wait { w, index: 0, box })
    __unlock(mut c.lock)
    __park()
    if w.ok {
        return box.value
    }
    none
}

fn __chan_close[T](c: *__Chan[T]) {
    __lock(mut c.lock)
    if c.closed {
        __panic("close of closed channel")
    }
    c.closed = true
    var wake: []ptr = []
    for {
        match __pop(mut c.recvq, false) {
            some(r) => push(mut wake, r.w.g)
            none => break
        }
    }
    for {
        match __pop(mut c.sendq, false) {
            some(s) => push(mut wake, s.w.g)
            none => break
        }
    }
    __unlock(mut c.lock)
    for g in wake {
        __ready(g)
    }
}

fn __sel_recv[T](c: *__Chan[T], w: *__Waiter, index: i64, box: *__Box[T]) -> bool {
    let got = __try_recv(c)
    if got.state < 0 {
        return false
    }
    box.value = got.value
    w.index = index
    w.ok = got.state == 1
    w.wake = got.wake
    true
}

fn __sel_send[T](c: *__Chan[T], w: *__Waiter, index: i64, v: T) -> bool {
    let sent = __try_send(c, v)
    if !sent.done {
        return false
    }
    w.index = index
    w.ok = true
    w.wake = sent.wake
    true
}

fn __sel_wake(w: *__Waiter) {
    __wake(w.wake)
}

fn __sel_wait_recv[T](c: *__Chan[T], w: *__Waiter, index: i64, box: *__Box[T]) {
    __enqueue(mut c.recvq, __Wait { w, index, box })
}

fn __sel_wait_send[T](c: *__Chan[T], w: *__Waiter, index: i64, v: T) {
    __enqueue(mut c.sendq, __Wait { w, index, box: new(__Box { value: v }) })
}

fn __sel_cancel_recv[T](c: *__Chan[T], w: *__Waiter) {
    __lock(mut c.lock)
    __remove(mut c.recvq, w)
    __unlock(mut c.lock)
}

fn __sel_cancel_send[T](c: *__Chan[T], w: *__Waiter) {
    __lock(mut c.lock)
    __remove(mut c.sendq, w)
    __unlock(mut c.lock)
}

fn __sel_value[T](w: *__Waiter, box: *__Box[T]) -> T? {
    if w.ok {
        return box.value
    }
    none
}
