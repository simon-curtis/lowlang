import std/io
import std/protobuf
import std/text

struct Phone {
    number: str
    mobile: bool
}

struct Contact {
    name: str
    id: i32
    balance: i64
    scores: []u64
    phones: []Phone
    rating: f64
    unknown: i64
}

fn encode_contact(c: Contact) -> []u8 {
    let e = protobuf.encoder()
    protobuf.write_string(e, 1, c.name)
    protobuf.write_int32(e, 2, c.id)
    protobuf.write_sint64(e, 3, c.balance)
    protobuf.write_packed_varints(e, 4, c.scores)
    for p in c.phones {
        let mark = protobuf.begin_message(e, 5)
        protobuf.write_string(e, 1, p.number)
        protobuf.write_bool(e, 2, p.mobile)
        protobuf.end_message(e, mark)
    }
    protobuf.write_double(e, 6, c.rating)
    protobuf.write_uint64(e, 99, 7)
    var out: []u8 = []
    let written = protobuf.encoded(e)
    for b in written {
        push(mut out, b)
    }
    out
}

fn decode_phone(f: protobuf.Field) -> Phone ! io.Error {
    var phone = Phone { number: "", mobile: false }
    let d = protobuf.as_message(f)?
    for {
        let field = protobuf.next(d)? ?? break
        match field.number {
            1 => { phone.number = protobuf.as_string(field)? }
            2 => { phone.mobile = protobuf.as_bool(field)? }
            _ => {}
        }
    }
    phone
}

fn decode_contact(data: []u8) -> Contact ! io.Error {
    var c = Contact { name: "", id: 0, balance: 0, scores: [], phones: [], rating: 0.0, unknown: 0 }
    let d = protobuf.decoder(data)
    for {
        let field = protobuf.next(d)? ?? break
        match field.number {
            1 => { c.name = protobuf.as_string(field)? }
            2 => { c.id = protobuf.as_int32(field)? }
            3 => { c.balance = protobuf.as_sint64(field)? }
            4 => {
                let values = protobuf.unpack_varints(field)?
                for v in values {
                    push(mut c.scores, v)
                }
            }
            5 => {
                let phone = decode_phone(field)?
                push(mut c.phones, phone)
            }
            6 => { c.rating = protobuf.as_double(field)? }
            _ => { c.unknown += 1 }
        }
    }
    c
}

/// Writes a message with a nested record, a packed list and a ZigZag number, decodes it field by field and counts the unknown field.
fn main() ! io.Error {
    let contact = Contact {
        name: "Ada",
        id: -2,
        balance: -150,
        scores: [3, 270, 86942],
        phones: [Phone { number: "555-0100", mobile: true }, Phone { number: "555-0111", mobile: false }],
        rating: 4.5,
        unknown: 0,
    }
    let data = encode_contact(contact)
    print("{data.len} bytes: {text.encode_hex(data)}")

    let back = decode_contact(data)?
    print("{back.name} id {back.id} balance {back.balance} rating {back.rating}")
    print("scores {back.scores}")
    for p in back.phones {
        print("phone {p.number} mobile {p.mobile}")
    }
    print("unknown fields {back.unknown}")

    let single = protobuf.encoder()
    protobuf.write_uint64(single, 1, 150)
    print(text.encode_hex(protobuf.encoded(single)))

    let truncated = decode_contact(data[..data.len - 1]) catch {
        e => {
            print("truncated input: {e}")
            return
        }
    }
    print(truncated.name)
}
