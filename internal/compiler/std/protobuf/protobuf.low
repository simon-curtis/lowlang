import std/io

pub enum Wire {
    Varint
    Fixed64
    Bytes
    Fixed32
}

pub struct Encoder {
    buf: []u8
    at: i64
}

pub struct Field {
    pub number: i64
    pub wire: Wire
    pub value: u64
    pub data: []u8
}

pub struct Decoder {
    data: []u8
    at: i64
}

fn wire_code(w: Wire) -> u64 {
    match w {
        Varint => 0
        Fixed64 => 1
        Bytes => 2
        Fixed32 => 5
    }
}

pub fn zigzag(v: i64) -> u64 {
    u64(v << 1) ^ u64(v >> 63)
}

pub fn unzigzag(v: u64) -> i64 {
    i64(v >> 1) ^ -i64(v & 1)
}

pub fn varint_size(v: u64) -> i64 {
    var n = 1
    var rest = v >> 7
    for rest != 0 {
        n += 1
        rest = rest >> 7
    }
    n
}

pub fn encoder() -> *Encoder {
    encoder_with(256)
}

pub fn encoder_with(capacity: i64) -> *Encoder {
    new(Encoder { buf: __make(if capacity < 16 { 16 } else { capacity }), at: 0 })
}

pub fn encoded(e: *Encoder) -> []u8 {
    e.buf[..e.at]
}

pub fn size(e: *Encoder) -> i64 {
    e.at
}

pub fn reset(e: *Encoder) {
    e.at = 0
}

fn reserve(e: *Encoder, n: i64) {
    if e.at + n <= e.buf.len {
        return
    }
    var capacity = e.buf.len * 2
    for capacity < e.at + n {
        capacity *= 2
    }
    let grown: []u8 = __make(capacity)
    __memmove(grown, e.buf[..e.at])
    e.buf = grown
}

pub fn put_varint(e: *Encoder, v: u64) {
    reserve(e, 10)
    let buf = e.buf
    var at = e.at
    var rest = v
    for rest >= 0x80 {
        buf[at] = u8(rest) | 0x80
        rest = rest >> 7
        at += 1
    }
    buf[at] = u8(rest)
    e.at = at + 1
}

pub fn put_tag(e: *Encoder, field: i64, w: Wire) {
    put_varint(e, u64(field) << 3 | wire_code(w))
}

pub fn put_fixed64(e: *Encoder, v: u64) {
    reserve(e, 8)
    let buf = e.buf
    for i in 0..8 {
        buf[e.at + i] = u8(v >> u64(i * 8))
    }
    e.at += 8
}

pub fn put_fixed32(e: *Encoder, v: u32) {
    reserve(e, 4)
    let buf = e.buf
    for i in 0..4 {
        buf[e.at + i] = u8(v >> u32(i * 8))
    }
    e.at += 4
}

pub fn put_raw(e: *Encoder, data: []u8) {
    reserve(e, data.len)
    __memmove(e.buf[e.at..], data)
    e.at += data.len
}

pub fn put_raw_str(e: *Encoder, s: str) {
    reserve(e, s.len)
    __memmove(e.buf[e.at..], s)
    e.at += s.len
}

pub fn write_uint64(e: *Encoder, field: i64, v: u64) {
    put_tag(e, field, Varint)
    put_varint(e, v)
}

pub fn write_int64(e: *Encoder, field: i64, v: i64) {
    put_tag(e, field, Varint)
    put_varint(e, u64(v))
}

pub fn write_int32(e: *Encoder, field: i64, v: i32) {
    put_tag(e, field, Varint)
    put_varint(e, u64(i64(v)))
}

pub fn write_sint64(e: *Encoder, field: i64, v: i64) {
    put_tag(e, field, Varint)
    put_varint(e, zigzag(v))
}

pub fn write_bool(e: *Encoder, field: i64, v: bool) {
    put_tag(e, field, Varint)
    put_varint(e, if v { 1 } else { 0 })
}

pub fn write_fixed64(e: *Encoder, field: i64, v: u64) {
    put_tag(e, field, Fixed64)
    put_fixed64(e, v)
}

pub fn write_sfixed64(e: *Encoder, field: i64, v: i64) {
    put_tag(e, field, Fixed64)
    put_fixed64(e, u64(v))
}

pub fn write_fixed32(e: *Encoder, field: i64, v: u32) {
    put_tag(e, field, Fixed32)
    put_fixed32(e, v)
}

pub fn write_sfixed32(e: *Encoder, field: i64, v: i32) {
    put_tag(e, field, Fixed32)
    put_fixed32(e, u32(v))
}

pub fn write_double(e: *Encoder, field: i64, v: f64) {
    put_tag(e, field, Fixed64)
    put_fixed64(e, u64(__bits(v)))
}

pub fn write_float(e: *Encoder, field: i64, v: f32) {
    put_tag(e, field, Fixed32)
    put_fixed32(e, __bits(v))
}

pub fn write_string(e: *Encoder, field: i64, s: str) {
    put_tag(e, field, Bytes)
    put_varint(e, u64(s.len))
    put_raw_str(e, s)
}

pub fn write_bytes(e: *Encoder, field: i64, data: []u8) {
    put_tag(e, field, Bytes)
    put_varint(e, u64(data.len))
    put_raw(e, data)
}

pub fn begin_message(e: *Encoder, field: i64) -> i64 {
    put_tag(e, field, Bytes)
    e.at
}

pub fn end_message(e: *Encoder, mark: i64) {
    let length = e.at - mark
    let prefix = varint_size(u64(length))
    reserve(e, prefix)
    __memmove(e.buf[mark + prefix..e.at + prefix], e.buf[mark..e.at])
    let end = e.at + prefix
    e.at = mark
    put_varint(e, u64(length))
    e.at = end
}

pub fn write_packed_varints(e: *Encoder, field: i64, values: []u64) {
    if values.len == 0 {
        return
    }
    let mark = begin_message(e, field)
    for v in values {
        put_varint(e, v)
    }
    end_message(e, mark)
}

pub fn write_packed_sint64(e: *Encoder, field: i64, values: []i64) {
    if values.len == 0 {
        return
    }
    let mark = begin_message(e, field)
    for v in values {
        put_varint(e, zigzag(v))
    }
    end_message(e, mark)
}

pub fn write_packed_fixed64(e: *Encoder, field: i64, values: []u64) {
    if values.len == 0 {
        return
    }
    put_tag(e, field, Bytes)
    put_varint(e, u64(values.len * 8))
    for v in values {
        put_fixed64(e, v)
    }
}

pub fn write_packed_fixed32(e: *Encoder, field: i64, values: []u32) {
    if values.len == 0 {
        return
    }
    put_tag(e, field, Bytes)
    put_varint(e, u64(values.len * 4))
    for v in values {
        put_fixed32(e, v)
    }
}

pub fn write_packed_doubles(e: *Encoder, field: i64, values: []f64) {
    if values.len == 0 {
        return
    }
    put_tag(e, field, Bytes)
    put_varint(e, u64(values.len * 8))
    for v in values {
        put_fixed64(e, u64(__bits(v)))
    }
}

pub fn decoder(data: []u8) -> *Decoder {
    new(Decoder { data, at: 0 })
}

pub fn done(d: *Decoder) -> bool {
    d.at >= d.data.len
}

pub fn read_varint(data: []u8, mut at: i64) -> u64 ! io.Error {
    var v: u64 = 0
    var shift: u64 = 0
    for {
        if at >= data.len {
            fail Malformed
        }
        let b = data[at]
        at += 1
        if shift == 63 && b > 1 {
            fail Malformed
        }
        v |= u64(b & 0x7F) << shift
        if b < 0x80 {
            return v
        }
        shift += 7
    }
}

fn read_fixed(data: []u8, at: i64, n: i64) -> u64 ! io.Error {
    if at + n > data.len {
        fail Malformed
    }
    var v: u64 = 0
    for i in 0..n {
        v |= u64(data[at + i]) << u64(i * 8)
    }
    v
}

pub fn next(d: *Decoder) -> Field? ! io.Error {
    if d.at >= d.data.len {
        return none
    }
    var at = d.at
    let key = read_varint(d.data, mut at)?
    let number = i64(key >> 3)
    if number == 0 || key >> 3 > 0x1FFFFFFF {
        fail Malformed
    }
    let code = key & 7
    var f = Field { number, wire: Varint, value: 0, data: [] }
    if code == 0 {
        f.value = read_varint(d.data, mut at)?
    } else if code == 1 {
        f.wire = Fixed64
        f.value = read_fixed(d.data, at, 8)?
        at += 8
    } else if code == 2 {
        let n = read_varint(d.data, mut at)?
        if n > u64(d.data.len - at) {
            fail Malformed
        }
        f.wire = Bytes
        f.value = n
        f.data = d.data[at..at + i64(n)]
        at += i64(n)
    } else if code == 5 {
        f.wire = Fixed32
        f.value = read_fixed(d.data, at, 4)?
        at += 4
    } else if code == 3 || code == 4 {
        fail Unsupported
    } else {
        fail Malformed
    }
    d.at = at
    f
}

fn expect(f: Field, w: Wire) ! io.Error {
    if wire_code(f.wire) != wire_code(w) {
        fail Malformed
    }
}

pub fn as_uint64(f: Field) -> u64 ! io.Error {
    expect(f, Varint)?
    f.value
}

pub fn as_int64(f: Field) -> i64 ! io.Error {
    expect(f, Varint)?
    i64(f.value)
}

pub fn as_int32(f: Field) -> i32 ! io.Error {
    expect(f, Varint)?
    i32(f.value)
}

pub fn as_sint64(f: Field) -> i64 ! io.Error {
    expect(f, Varint)?
    unzigzag(f.value)
}

pub fn as_bool(f: Field) -> bool ! io.Error {
    expect(f, Varint)?
    f.value != 0
}

pub fn as_fixed64(f: Field) -> u64 ! io.Error {
    expect(f, Fixed64)?
    f.value
}

pub fn as_fixed32(f: Field) -> u32 ! io.Error {
    expect(f, Fixed32)?
    u32(f.value)
}

fn double_of(bits: u64) -> f64 {
    let cell: []u64 = [bits]
    let raw: ptr = __slice_ptr(cell)
    let typed: ptr[f64] = raw
    load(typed)
}

fn float_of(bits: u32) -> f32 {
    let cell: []u32 = [bits]
    let raw: ptr = __slice_ptr(cell)
    let typed: ptr[f32] = raw
    load(typed)
}

pub fn as_double(f: Field) -> f64 ! io.Error {
    expect(f, Fixed64)?
    double_of(f.value)
}

pub fn as_float(f: Field) -> f32 ! io.Error {
    expect(f, Fixed32)?
    float_of(u32(f.value))
}

pub fn as_bytes(f: Field) -> []u8 ! io.Error {
    expect(f, Bytes)?
    f.data
}

pub fn as_string(f: Field) -> str ! io.Error {
    expect(f, Bytes)?
    str(f.data)
}

pub fn as_message(f: Field) -> *Decoder ! io.Error {
    expect(f, Bytes)?
    decoder(f.data)
}

pub fn unpack_varints(f: Field) -> []u64 ! io.Error {
    match f.wire {
        Varint => return [f.value]
        Bytes => {}
        _ => fail Malformed
    }
    var out: []u64 = []
    var at = 0
    for at < f.data.len {
        push(mut out, read_varint(f.data, mut at)?)
    }
    out
}

fn unpack_fixed(f: Field, width: i64) -> []u64 ! io.Error {
    let single = if width == 8 { Wire.Fixed64 } else { Wire.Fixed32 }
    if wire_code(f.wire) == wire_code(single) {
        return [f.value]
    }
    expect(f, Bytes)?
    if f.data.len % width != 0 {
        fail Malformed
    }
    let out: []u64 = __make(f.data.len / width)
    for i in 0..out.len {
        out[i] = read_fixed(f.data, i * width, width)?
    }
    out
}

pub fn unpack_fixed64(f: Field) -> []u64 ! io.Error {
    unpack_fixed(f, 8)
}

pub fn unpack_fixed32(f: Field) -> []u32 ! io.Error {
    let wide = unpack_fixed(f, 4)?
    let out: []u32 = __make(wide.len)
    for i, v in wide {
        out[i] = u32(v)
    }
    out
}

pub fn unpack_doubles(f: Field) -> []f64 ! io.Error {
    let wide = unpack_fixed(f, 8)?
    let out: []f64 = __make(wide.len)
    for i, v in wide {
        out[i] = double_of(v)
    }
    out
}
