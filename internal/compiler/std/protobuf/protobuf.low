import std/compress/codec
import std/io
import std/text

/// A protobuf wire type, which says how the value of a field is laid out.
///
/// Groups (wire types `3` and `4`) are not supported.
pub enum Wire {
    /// Wire type `0`: a base-128 varint of one to ten bytes. Used by `int32`, `int64`, `uint32`, `uint64`, `sint32`, `sint64`, `bool` and enums.
    Varint
    /// Wire type `1`: eight little-endian bytes. Used by `fixed64`, `sfixed64` and `double`.
    Fixed64
    /// Wire type `2`: a varint length followed by that many bytes. Used by `string`, `bytes`, embedded messages and packed repeated fields.
    Bytes
    /// Wire type `5`: four little-endian bytes. Used by `fixed32`, `sfixed32` and `float`.
    Fixed32
}

/// A growable buffer that fields are appended to in the protobuf wire format.
///
/// Made by `encoder` or `encoder_with`. The buffer grows as needed. `encoded` returns the bytes written so far.
pub struct Encoder {
    buf: []u8
    at: i64
}

/// One field read from an encoded message by `Decoder.next`: its number, wire type and raw value.
///
/// The `as_` functions interpret it as a protobuf type, and the `unpack_` functions read repeated fields.
pub struct Field {
    /// The field number, from `1` to `536870911`.
    pub number: i64
    /// The wire type the field was encoded with.
    pub wire: Wire
    /// The raw value for `Varint`, `Fixed64` and `Fixed32` fields, as unsigned bits with no sign extension, and the payload length in bytes for a `Bytes` field.
    pub value: u64
    /// The payload of a `Bytes` field, as a slice of the decoded input; empty for the other wire types.
    pub data: []u8
}

/// A cursor over an encoded message that yields its fields in order.
///
/// Made by `decoder` or `as_message`; `next` advances it.
pub struct Decoder {
    data: []u8
    at: i64
}

fn wire_code(w: Wire) -> u64 {
    match w {
        Varint => 0
        Fixed64 => 1
        Bytes => 2
        Fixed32 => 5
    }
}

/// Returns the ZigZag encoding of `v`, which maps small magnitudes of either sign to small unsigned numbers: `0`, `-1`, `1` and `-2` become `0`, `1`, `2` and `3`.
///
/// This is the encoding of `sint32` and `sint64`.
pub fn zigzag(v: i64) -> u64 {
    u64(v << 1) ^ u64(v >> 63)
}

/// Returns the signed number whose ZigZag encoding is `v`.
pub fn unzigzag(v: u64) -> i64 {
    i64(v >> 1) ^ -i64(v & 1)
}

/// Returns the number of bytes the varint encoding of `v` takes, from `1` to `10`.
pub fn varint_size(v: u64) -> i64 {
    var n = 1
    var rest = v >> 7
    for rest != 0 {
        n += 1
        rest = rest >> 7
    }
    n
}

/// Returns an empty encoder with room for `256` bytes.
pub fn encoder() -> *Encoder {
    encoder_with(256)
}

/// Returns an empty encoder with room for `capacity` bytes, and at least `16`.
pub fn encoder_with(capacity: i64) -> *Encoder {
    new(Encoder { buf: __make(if capacity < 16 { 16 } else { capacity }), at: 0 })
}

/// Returns the bytes written so far.
///
/// The slice views the encoder's own buffer, so a later write or `reset` can change it. Copy it to keep it past the next write.
pub fn encoded(e: *Encoder) -> []u8 {
    e.buf[..e.at]
}

/// Returns the number of bytes written so far.
pub fn size(e: *Encoder) -> i64 {
    e.at
}

/// Discards everything written so the encoder can be used again, keeping its buffer.
pub fn reset(e: *Encoder) {
    e.at = 0
}

fn reserve(e: *Encoder, n: i64) {
    if e.at + n <= e.buf.len {
        return
    }
    var capacity = e.buf.len * 2
    for capacity < e.at + n {
        capacity *= 2
    }
    let grown: []u8 = __make(capacity)
    __memmove(grown, e.buf[..e.at])
    e.buf = grown
}

/// Appends `v` as a varint of one to ten bytes, seven bits per byte, least significant group first.
///
/// This writes no field tag.
pub fn put_varint(e: *Encoder, v: u64) {
    reserve(e, 10)
    e.at = codec.write_varint(e.buf, e.at, v)
}

/// Appends the tag that starts a field, the number `field` and the wire type `w` packed as `field << 3 | wire`, as a varint.
///
/// `field` is not validated; a valid field number is `1` to `536870911`.
pub fn put_tag(e: *Encoder, field: i64, w: Wire) {
    put_varint(e, u64(field) << 3 | wire_code(w))
}

/// Appends `v` as eight little-endian bytes, with no field tag.
pub fn put_fixed64(e: *Encoder, v: u64) {
    reserve(e, 8)
    let buf = e.buf
    for i in 0..8 {
        buf[e.at + i] = u8(v >> u64(i * 8))
    }
    e.at += 8
}

/// Appends `v` as four little-endian bytes, with no field tag.
pub fn put_fixed32(e: *Encoder, v: u32) {
    reserve(e, 4)
    let buf = e.buf
    for i in 0..4 {
        buf[e.at + i] = u8(v >> u32(i * 8))
    }
    e.at += 4
}

/// Appends the bytes of `data` as they are, with no tag or length.
pub fn put_raw(e: *Encoder, data: []u8) {
    reserve(e, data.len)
    __memmove(e.buf[e.at..], data)
    e.at += data.len
}

/// Appends the bytes of `s` as they are, with no tag or length.
pub fn put_raw_str(e: *Encoder, s: str) {
    reserve(e, s.len)
    __memmove(e.buf[e.at..], s)
    e.at += s.len
}

/// Writes field `field` as a `uint32` or `uint64` varint.
///
/// A `uint32` field takes the same encoding, so `v` must fit that range for such a field.
pub fn write_uint64(e: *Encoder, field: i64, v: u64) {
    put_tag(e, field, Varint)
    put_varint(e, v)
}

/// Writes field `field` as an `int64` varint.
///
/// A negative value takes ten bytes, as the specification requires.
pub fn write_int64(e: *Encoder, field: i64, v: i64) {
    put_tag(e, field, Varint)
    put_varint(e, u64(v))
}

/// Writes field `field` as an `int32` varint.
///
/// A negative value is sign-extended to 64 bits and takes ten bytes, as the specification requires. The same call writes an enum value.
pub fn write_int32(e: *Encoder, field: i64, v: i32) {
    put_tag(e, field, Varint)
    put_varint(e, u64(i64(v)))
}

/// Writes field `field` as a `sint64` varint, ZigZag encoded.
///
/// Use it for `sint32` too.
pub fn write_sint64(e: *Encoder, field: i64, v: i64) {
    put_tag(e, field, Varint)
    put_varint(e, zigzag(v))
}

/// Writes field `field` as a `bool` varint, `1` for `true` and `0` for `false`.
pub fn write_bool(e: *Encoder, field: i64, v: bool) {
    put_tag(e, field, Varint)
    put_varint(e, if v { 1 } else { 0 })
}

/// Writes field `field` as `fixed64`, eight little-endian bytes.
pub fn write_fixed64(e: *Encoder, field: i64, v: u64) {
    put_tag(e, field, Fixed64)
    put_fixed64(e, v)
}

/// Writes field `field` as `sfixed64`, eight little-endian bytes of the two's complement.
pub fn write_sfixed64(e: *Encoder, field: i64, v: i64) {
    put_tag(e, field, Fixed64)
    put_fixed64(e, u64(v))
}

/// Writes field `field` as `fixed32`, four little-endian bytes.
pub fn write_fixed32(e: *Encoder, field: i64, v: u32) {
    put_tag(e, field, Fixed32)
    put_fixed32(e, v)
}

/// Writes field `field` as `sfixed32`, four little-endian bytes of the two's complement.
pub fn write_sfixed32(e: *Encoder, field: i64, v: i32) {
    put_tag(e, field, Fixed32)
    put_fixed32(e, u32(v))
}

/// Writes field `field` as a `double`, eight little-endian bytes of the IEEE 754 bits.
pub fn write_double(e: *Encoder, field: i64, v: f64) {
    put_tag(e, field, Fixed64)
    put_fixed64(e, text.float_bits(v))
}

/// Writes field `field` as a `float`, four little-endian bytes of the IEEE 754 bits.
pub fn write_float(e: *Encoder, field: i64, v: f32) {
    put_tag(e, field, Fixed32)
    put_fixed32(e, text.float32_bits(v))
}

/// Writes field `field` as a `string`: its tag, the byte length and the bytes of `s`.
///
/// `s` is not checked for UTF-8.
pub fn write_string(e: *Encoder, field: i64, s: str) {
    put_tag(e, field, Bytes)
    put_varint(e, u64(s.len))
    put_raw_str(e, s)
}

/// Writes field `field` as `bytes`: its tag, the byte length and the bytes of `data`.
pub fn write_bytes(e: *Encoder, field: i64, data: []u8) {
    put_tag(e, field, Bytes)
    put_varint(e, u64(data.len))
    put_raw(e, data)
}

/// Starts an embedded message in field `field` and returns a mark to pass to `end_message`.
///
/// The tag is written now and the message's fields follow, written with the other `write_` functions. The length prefix is inserted by `end_message`, which moves the message's bytes. Messages can nest.
pub fn begin_message(e: *Encoder, field: i64) -> i64 {
    put_tag(e, field, Bytes)
    e.at
}

/// Ends the embedded message that `begin_message` started, which returned `mark`.
///
/// It inserts the varint length of everything written since the mark.
pub fn end_message(e: *Encoder, mark: i64) {
    let length = e.at - mark
    let prefix = varint_size(u64(length))
    reserve(e, prefix)
    __memmove(e.buf[mark + prefix..e.at + prefix], e.buf[mark..e.at])
    let end = e.at + prefix
    e.at = mark
    put_varint(e, u64(length))
    e.at = end
}

/// Writes field `field` as a packed repeated `uint64`, `uint32`, `bool` or enum field: one `Bytes` field holding the varints back to back.
///
/// Writes nothing when `values` is empty, as the specification omits an empty packed field.
pub fn write_packed_varints(e: *Encoder, field: i64, values: []u64) {
    if values.len == 0 {
        return
    }
    let mark = begin_message(e, field)
    for v in values {
        put_varint(e, v)
    }
    end_message(e, mark)
}

/// Writes field `field` as a packed repeated `sint64` or `sint32` field, each value ZigZag encoded.
///
/// Writes nothing when `values` is empty.
pub fn write_packed_sint64(e: *Encoder, field: i64, values: []i64) {
    if values.len == 0 {
        return
    }
    let mark = begin_message(e, field)
    for v in values {
        put_varint(e, zigzag(v))
    }
    end_message(e, mark)
}

/// Writes field `field` as a packed repeated `fixed64` or `sfixed64` field: one `Bytes` field holding eight bytes per value.
///
/// Writes nothing when `values` is empty. For `sfixed64`, convert each value to `u64` first.
pub fn write_packed_fixed64(e: *Encoder, field: i64, values: []u64) {
    if values.len == 0 {
        return
    }
    put_tag(e, field, Bytes)
    put_varint(e, u64(values.len * 8))
    for v in values {
        put_fixed64(e, v)
    }
}

/// Writes field `field` as a packed repeated `fixed32` or `sfixed32` field: one `Bytes` field holding four bytes per value.
///
/// Writes nothing when `values` is empty. For `sfixed32`, convert each value to `u32` first.
pub fn write_packed_fixed32(e: *Encoder, field: i64, values: []u32) {
    if values.len == 0 {
        return
    }
    put_tag(e, field, Bytes)
    put_varint(e, u64(values.len * 4))
    for v in values {
        put_fixed32(e, v)
    }
}

/// Writes field `field` as a packed repeated `double` field: one `Bytes` field holding eight bytes per value.
///
/// Writes nothing when `values` is empty.
pub fn write_packed_doubles(e: *Encoder, field: i64, values: []f64) {
    if values.len == 0 {
        return
    }
    put_tag(e, field, Bytes)
    put_varint(e, u64(values.len * 8))
    for v in values {
        put_fixed64(e, text.float_bits(v))
    }
}

/// Returns a decoder over `data`, positioned at the first field.
///
/// The decoder keeps `data`; it does not copy it.
pub fn decoder(data: []u8) -> *Decoder {
    new(Decoder { data, at: 0 })
}

/// Returns whether the decoder has consumed all of its input.
pub fn done(d: *Decoder) -> bool {
    d.at >= d.data.len
}

/// Reads the varint that starts at `data[at]` and advances `at` past it.
///
/// Fails with `Malformed` when the input ends inside the varint or the value does not fit in 64 bits. Varints longer than necessary are accepted, up to ten bytes. When it fails, `at` may already have advanced.
pub fn read_varint(data: []u8, mut at: i64) -> u64 ! io.Error {
    codec.read_varint(data, mut at, 10)?
}

fn read_fixed(data: []u8, at: i64, n: i64) -> u64 ! io.Error {
    if at + n > data.len {
        fail Malformed
    }
    io.uint_le(data, at, n)
}

/// Reads the next field of the message, or returns `none` at the end of the input.
///
/// Fails with `Malformed` when a field is truncated, the field number is `0` or above `536870911`, a length runs past the end of the input or the wire type is `6` or `7`, and with `Unsupported` for the group wire types `3` and `4`. When it fails the decoder does not advance. Unknown fields are returned like known ones, so a caller skips one by ignoring it.
pub fn next(d: *Decoder) -> Field? ! io.Error {
    if d.at >= d.data.len {
        return none
    }
    var at = d.at
    let key = read_varint(d.data, mut at)?
    let number = i64(key >> 3)
    if number == 0 || key >> 3 > 0x1FFFFFFF {
        fail Malformed
    }
    let code = key & 7
    var f = Field { number, wire: Varint, value: 0, data: [] }
    if code == 0 {
        f.value = read_varint(d.data, mut at)?
    } else if code == 1 {
        f.wire = Fixed64
        f.value = read_fixed(d.data, at, 8)?
        at += 8
    } else if code == 2 {
        let n = read_varint(d.data, mut at)?
        if n > u64(d.data.len - at) {
            fail Malformed
        }
        f.wire = Bytes
        f.value = n
        f.data = d.data[at..at + i64(n)]
        at += i64(n)
    } else if code == 5 {
        f.wire = Fixed32
        f.value = read_fixed(d.data, at, 4)?
        at += 4
    } else if code == 3 || code == 4 {
        fail Unsupported
    } else {
        fail Malformed
    }
    d.at = at
    f
}

fn expect(f: Field, w: Wire) ! io.Error {
    if wire_code(f.wire) != wire_code(w) {
        fail Malformed
    }
}

/// Returns the value of a `uint32` or `uint64` field.
///
/// Fails with `Malformed` unless the field has wire type `Varint`. A `uint32` field is not range checked.
pub fn as_uint64(f: Field) -> u64 ! io.Error {
    expect(f, Varint)?
    f.value
}

/// Returns the value of an `int64` field, the varint reinterpreted as two's complement.
///
/// Fails with `Malformed` unless the field has wire type `Varint`.
pub fn as_int64(f: Field) -> i64 ! io.Error {
    expect(f, Varint)?
    i64(f.value)
}

/// Returns the value of an `int32` field or an enum field, the low 32 bits of the varint.
///
/// Fails with `Malformed` unless the field has wire type `Varint`.
pub fn as_int32(f: Field) -> i32 ! io.Error {
    expect(f, Varint)?
    i32(f.value)
}

/// Returns the value of a `sint32` or `sint64` field, undoing the ZigZag encoding.
///
/// Fails with `Malformed` unless the field has wire type `Varint`.
pub fn as_sint64(f: Field) -> i64 ! io.Error {
    expect(f, Varint)?
    unzigzag(f.value)
}

/// Returns the value of a `bool` field: `false` for `0` and `true` for any other varint.
///
/// Fails with `Malformed` unless the field has wire type `Varint`.
pub fn as_bool(f: Field) -> bool ! io.Error {
    expect(f, Varint)?
    f.value != 0
}

/// Returns the value of a `fixed64` field; reinterpret it as `i64` for `sfixed64`.
///
/// Fails with `Malformed` unless the field has wire type `Fixed64`.
pub fn as_fixed64(f: Field) -> u64 ! io.Error {
    expect(f, Fixed64)?
    f.value
}

/// Returns the value of a `fixed32` field; reinterpret it as `i32` for `sfixed32`.
///
/// Fails with `Malformed` unless the field has wire type `Fixed32`.
pub fn as_fixed32(f: Field) -> u32 ! io.Error {
    expect(f, Fixed32)?
    u32(f.value)
}

/// Returns the value of a `double` field.
///
/// Fails with `Malformed` unless the field has wire type `Fixed64`.
pub fn as_double(f: Field) -> f64 ! io.Error {
    expect(f, Fixed64)?
    text.float_from_bits(f.value)
}

/// Returns the value of a `float` field.
///
/// Fails with `Malformed` unless the field has wire type `Fixed32`.
pub fn as_float(f: Field) -> f32 ! io.Error {
    expect(f, Fixed32)?
    text.float32_from_bits(u32(f.value))
}

/// Returns the payload of a `bytes` field as a slice of the decoded input.
///
/// Fails with `Malformed` unless the field has wire type `Bytes`.
pub fn as_bytes(f: Field) -> []u8 ! io.Error {
    expect(f, Bytes)?
    f.data
}

/// Returns the payload of a `string` field.
///
/// Fails with `Malformed` unless the field has wire type `Bytes`. The bytes are not checked for UTF-8.
pub fn as_string(f: Field) -> str ! io.Error {
    expect(f, Bytes)?
    str(f.data)
}

/// Returns a decoder over the payload of an embedded message field.
///
/// Fails with `Malformed` unless the field has wire type `Bytes`.
pub fn as_message(f: Field) -> *Decoder ! io.Error {
    expect(f, Bytes)?
    decoder(f.data)
}

/// Returns the values of a repeated varint field.
///
/// Accepts both encodings of a repeated field: a single `Varint` field gives one value, and a packed `Bytes` field gives every varint in it. Call it once per occurrence and concatenate the results. Fails with `Malformed` for another wire type or a truncated varint.
pub fn unpack_varints(f: Field) -> []u64 ! io.Error {
    match f.wire {
        Varint => return [f.value]
        Bytes => {}
        _ => fail Malformed
    }
    var out: []u64 = []
    var at = 0
    for at < f.data.len {
        push(mut out, read_varint(f.data, mut at)?)
    }
    out
}

fn unpack_fixed(f: Field, width: i64) -> []u64 ! io.Error {
    let single = if width == 8 { Wire.Fixed64 } else { Wire.Fixed32 }
    if wire_code(f.wire) == wire_code(single) {
        return [f.value]
    }
    expect(f, Bytes)?
    if f.data.len % width != 0 {
        fail Malformed
    }
    let out: []u64 = __make(f.data.len / width)
    for i in 0..out.len {
        out[i] = read_fixed(f.data, i * width, width)?
    }
    out
}

/// Returns the values of a repeated `fixed64` or `sfixed64` field, as unsigned bits.
///
/// Accepts a single `Fixed64` field, which gives one value, or a packed `Bytes` field, which gives every eight-byte value in it. Fails with `Malformed` for another wire type or a packed length that is not a multiple of eight.
pub fn unpack_fixed64(f: Field) -> []u64 ! io.Error {
    unpack_fixed(f, 8)
}

/// Returns the values of a repeated `fixed32` or `sfixed32` field, as unsigned bits.
///
/// Accepts a single `Fixed32` field, which gives one value, or a packed `Bytes` field, which gives every four-byte value in it. Fails with `Malformed` for another wire type or a packed length that is not a multiple of four.
pub fn unpack_fixed32(f: Field) -> []u32 ! io.Error {
    let wide = unpack_fixed(f, 4)?
    let out: []u32 = __make(wide.len)
    for i, v in wide {
        out[i] = u32(v)
    }
    out
}

/// Returns the values of a repeated `double` field.
///
/// Accepts a single `Fixed64` field, which gives one value, or a packed `Bytes` field, which gives every eight-byte value in it. Fails with `Malformed` for another wire type or a packed length that is not a multiple of eight.
pub fn unpack_doubles(f: Field) -> []f64 ! io.Error {
    let wide = unpack_fixed(f, 8)?
    let out: []f64 = __make(wide.len)
    for i, v in wide {
        out[i] = text.float_from_bits(v)
    }
    out
}
