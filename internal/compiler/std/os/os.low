import std/file
import std/io
import std/text

/// An account entry from `/etc/passwd`.
pub struct User {
    /// The login name.
    pub name: str
    /// The numeric user id.
    pub uid: i64
    /// The numeric id of the user's primary group.
    pub gid: i64
    /// The home directory path.
    pub home: str
    /// The login shell path.
    pub shell: str
}

struct Anchor {
    words: []i64
    data: []u8
}

fn anchor_address() -> i64 {
    0x3e5700000000
}

fn anchor_size() -> i64 {
    1048576
}

fn anchor_data() -> i64 {
    64
}

fn anchor_magic() -> i64 {
    0x4c4f574f56455231
}

fn view_anchor() -> Anchor {
    let raw = __slice_ptr(__str_raw(anchor_address(), anchor_size()))
    let any: ptr = raw
    let words: ptr[i64] = any
    Anchor { words: view(words, anchor_size() / 8), data: view(raw, anchor_size()) }
}

fn anchor_mapped() -> bool {
    __syscall(28, anchor_address(), 4096, 0) == 0
}

fn anchor_ready(a: Anchor) -> bool {
    __cas(mut a.words[1], anchor_magic(), anchor_magic())
}

fn attach() -> Anchor? {
    if !anchor_mapped() {
        return none
    }
    let a = view_anchor()
    if anchor_ready(a) {
        return a
    }
    none
}

fn create() -> Anchor ! io.Error {
    if !anchor_mapped() {
        let r = __syscall(9, anchor_address(), anchor_size(), 3, 0x104022, -1, 0)
        if r == anchor_address() {
            let fresh = view_anchor()
            __cas(mut fresh.words[1], 0, anchor_magic())
            return fresh
        }
        if r >= 0 {
            __syscall(11, r, anchor_size())
            fail Unsupported
        }
        if r != -17 {
            fail io.errno(-r)
        }
    }
    let a = view_anchor()
    for _ in 0..1000 {
        if anchor_ready(a) {
            return a
        }
        __syscall(24)
    }
    fail Unsupported
}

fn records(blob: str) -> []str {
    var out: []str = []
    var start = 0
    for i in 0..blob.len {
        if blob[i] == 0 {
            push(mut out, blob[start..i])
            start = i + 1
        }
    }
    out
}

fn record_name(record: str) -> str {
    let at = text.index_byte(record, '=')
    if at < 0 {
        return record
    }
    record[..at]
}

fn snapshot() -> str {
    let a = attach() ?? return ""
    __lock(mut a.words[0])
    let blob = str(a.data[anchor_data()..anchor_data() + a.words[2]])
    __unlock(mut a.words[0])
    blob
}

fn put_record(name: str, record: str) ! io.Error {
    let a = create()?
    __lock(mut a.words[0])
    defer __unlock(mut a.words[0])
    var out: []u8 = []
    for existing in records(str(a.data[anchor_data()..anchor_data() + a.words[2]])) {
        if record_name(existing) != name {
            text.append(mut out, existing)
            push(mut out, 0)
        }
    }
    text.append(mut out, record)
    push(mut out, 0)
    if anchor_data() + out.len > a.data.len {
        fail NoSpace
    }
    __memmove(a.data[anchor_data()..], out)
    a.words[2] = out.len
}

fn valid_name(name: str) -> bool {
    name.len > 0 && text.index_byte(name, '=') < 0 && text.index_byte(name, 0) < 0
}

/// Sets the environment variable `name` to `value` for this program.
///
/// The change is seen by `env`, `environment`, `std/process`'s `find` and the environment `std/process` passes to children that do not set their own. It is kept in a shared memory region, not in the operating system's environment block, so code outside Low that reads that block does not see it. Fails with `Invalid` if `name` is empty or contains `=` or NUL, or `value` contains NUL; with `NoSpace` when the region (1 MiB) is full; and with `Unsupported` if the region cannot be set up.
pub fn set_env(name: str, value: str) ! io.Error {
    if !valid_name(name) || text.index_byte(value, 0) >= 0 {
        fail Invalid
    }
    put_record(name, "{name}={value}")?
}

/// Removes the environment variable `name` from this program's view of the environment.
///
/// Afterwards `env` returns `none` and `environment` omits the name, even when the program started with it. Fails with `Invalid` if `name` is empty or contains `=` or NUL, and with `NoSpace` or `Unsupported` as `set_env` does.
pub fn unset_env(name: str) ! io.Error {
    if !valid_name(name) {
        fail Invalid
    }
    put_record(name, name)?
}

/// Returns the command-line arguments the program started with, the program name first.
pub fn args() -> []str {
    var out: []str = []
    for i in 0..__argc() {
        push(mut out, str(__argv(i)))
    }
    out
}

fn environ() -> []str {
    var out: []str = []
    var i = 0
    for {
        let entry = __envv(i)
        if entry == null {
            return out
        }
        push(mut out, str(entry))
        i += 1
    }
}

/// Returns every environment variable as a map from name to value.
///
/// Starts from the environment the program was started with and applies the changes made by `set_env` and `unset_env`.
pub fn environment() -> [str: str] {
    var vars: [str: str] = [:]
    for entry in environ() {
        for i in 0..entry.len {
            if entry[i] == '=' {
                vars[entry[..i]] = entry[i + 1..]
                break
            }
        }
    }
    for record in records(snapshot()) {
        let name = record_name(record)
        if record.len == name.len {
            delete(mut vars, name)
        } else {
            vars[name] = record[name.len + 1..]
        }
    }
    vars
}

fn inherited(name: str) -> str? {
    for entry in environ() {
        if entry.len > name.len && entry[name.len] == '=' && entry[..name.len] == name {
            return entry[name.len + 1..]
        }
    }
    none
}

/// Returns the value of the environment variable `name`, or `none` if it is not set.
///
/// A variable that is set to an empty string returns `some("")`. Changes made by `set_env` and `unset_env` take precedence over the starting environment.
pub fn env(name: str) -> str? {
    for record in records(snapshot()) {
        if record_name(record) == name {
            if record.len == name.len {
                return none
            }
            return record[name.len + 1..]
        }
    }
    inherited(name)
}

/// Sets the file creation mask to `mask & 0o777` and returns the previous mask.
///
/// The mask is process-wide.
pub fn umask(mask: i64) -> i64 {
    __syscall(95, mask & 0o777)
}

/// Returns the process id.
pub fn pid() -> i64 {
    __syscall(39)
}

/// Returns the process id of the parent.
pub fn ppid() -> i64 {
    __syscall(110)
}

/// Returns the real user id.
pub fn uid() -> i64 {
    __syscall(102)
}

/// Returns the real group id.
pub fn gid() -> i64 {
    __syscall(104)
}

/// Returns the effective user id.
pub fn euid() -> i64 {
    __syscall(107)
}

/// Returns the effective group id.
pub fn egid() -> i64 {
    __syscall(108)
}

/// Ends the process immediately with the status `code`.
///
/// Does not run pending `defer` blocks or drops and does not wait for other green threads. Does not return.
pub fn exit(code: i64) {
    __syscall(231, code)
}

fn c_string(buf: []u8, from: i64) -> str {
    var end = from
    for end < buf.len && buf[end] != 0 {
        end += 1
    }
    str(buf[from..end])
}

/// Returns the absolute path of the current working directory.
///
/// Fails with `NotFound` if the directory has been removed and with `TooLarge` if the path exceeds 1 MiB.
pub fn getcwd() -> str ! io.Error {
    var size = 256
    for size <= 1048576 {
        let buf = io.buffer(size)
        let r = __syscall(79, __slice_ptr(buf), size)
        if r == -34 {
            size *= 4
            continue
        }
        let n = io.syscall_result(r)?
        return str(buf[..n - 1])
    }
    fail TooLarge
}

/// Changes the working directory of the whole process to `path`.
///
/// Fails with `NotFound`, `NotDir` or `Denied` as the operating system reports. The change affects every green thread and relative paths used afterwards.
pub fn chdir(path: str) ! io.Error {
    io.syscall_result(__syscall(80, cstr(path)))?
}

/// Returns the host name of the machine.
pub fn hostname() -> str ! io.Error {
    let buf = io.buffer(390)
    io.syscall_result(__syscall(63, __slice_ptr(buf)))?
    c_string(buf, 65)
}

/// Returns the path of the running executable, read from `/proc/self/exe`.
///
/// Fails with the error of `file.readlink`, such as `NotFound` when `/proc` is not mounted. Blocks the OS thread for the call.
pub fn executable() -> str ! io.Error {
    file.readlink("/proc/self/exe")?
}

/// Returns the number of seconds the machine has been running.
pub fn uptime() -> i64 ! io.Error {
    let buf = io.buffer(112)
    io.syscall_result(__syscall(99, __slice_ptr(buf)))?
    io.le64(buf, 0)
}

fn bit_count(b: u8) -> i64 {
    var n = 0
    var rest = b
    for rest != 0 {
        n += i64(rest & 1)
        rest >>= 1
    }
    n
}

/// Returns the number of CPUs the process may run on, according to its affinity mask.
///
/// Returns `1` if the mask cannot be read.
pub fn cpu_count() -> i64 {
    let buf = io.buffer(1024)
    let r = __syscall(204, 0, buf.len, __slice_ptr(buf))
    if r <= 0 {
        return 1
    }
    var n = 0
    for i in 0..r {
        n += bit_count(buf[i])
    }
    n
}

fn parse_user(line: str) -> User? {
    let parts = text.split(line, ':')
    if parts.len < 7 {
        return none
    }
    let uid = text.parse_int(parts[2]) catch { _ => return none }
    let gid = text.parse_int(parts[3]) catch { _ => return none }
    User { name: parts[0], uid, gid, home: parts[5], shell: parts[6] }
}

/// Returns the `/etc/passwd` entry whose user id is `id`, or `none`.
///
/// Returns `none` as well when the file cannot be read. Lines with fewer than seven fields or a non-numeric id are skipped. Reads the file on every call and blocks the OS thread while doing so.
pub fn lookup_user(id: i64) -> User? {
    let content = file.read_text("/etc/passwd") catch { _ => return none }
    for line in text.lines(content) {
        let user = parse_user(line)
        match user {
            some(u) => {
                if u.uid == id {
                    return u
                }
            }
            none => {}
        }
    }
    none
}

/// Returns the login name of the effective user, or `none` if `/etc/passwd` has no entry for it.
pub fn user_name() -> str? {
    let user = lookup_user(euid()) ?? return none
    user.name
}

fn account_home() -> str? {
    let user = lookup_user(euid()) ?? return none
    user.home
}

fn present(name: str) -> str? {
    let value = env(name) ?? return none
    if value.len == 0 {
        return none
    }
    value
}

/// Returns the home directory of the current user, or `none` if it cannot be found.
///
/// Uses `HOME` when it is set and not empty, and otherwise the home field of the effective user's `/etc/passwd` entry.
pub fn home_dir() -> str? {
    present("HOME") ?? account_home()
}

fn xdg_dir(variable: str, fallback: str) -> str? {
    let configured = present(variable) ?? ""
    if configured.len > 0 && configured[0] == '/' {
        return configured
    }
    let home = home_dir() ?? return none
    "{home}/{fallback}"
}

/// Returns the per-user cache directory, or `none` if no home directory can be found.
///
/// Uses `XDG_CACHE_HOME` when it is an absolute path, and otherwise `.cache` under `home_dir`.
pub fn cache_dir() -> str? {
    xdg_dir("XDG_CACHE_HOME", ".cache")
}

/// Returns the per-user configuration directory, or `none` if no home directory can be found.
///
/// Uses `XDG_CONFIG_HOME` when it is an absolute path, and otherwise `.config` under `home_dir`.
pub fn config_dir() -> str? {
    xdg_dir("XDG_CONFIG_HOME", ".config")
}

/// Returns the per-user data directory, or `none` if no home directory can be found.
///
/// Uses `XDG_DATA_HOME` when it is an absolute path, and otherwise `.local/share` under `home_dir`.
pub fn data_dir() -> str? {
    xdg_dir("XDG_DATA_HOME", ".local/share")
}

/// Returns the per-user state directory, or `none` if no home directory can be found.
///
/// Uses `XDG_STATE_HOME` when it is an absolute path, and otherwise `.local/state` under `home_dir`.
pub fn state_dir() -> str? {
    xdg_dir("XDG_STATE_HOME", ".local/state")
}

/// Returns the directory for temporary files: `TMPDIR` when it is set and not empty, and `/tmp` otherwise.
pub fn temp_dir_path() -> str {
    present("TMPDIR") ?? "/tmp"
}
