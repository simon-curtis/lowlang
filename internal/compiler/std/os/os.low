import std/io
import std/sys
import std/text

/// An account entry from `/etc/passwd`.
pub struct User {
    /// The login name.
    pub name: str
    /// The numeric user id.
    pub uid: i64
    /// The numeric id of the user's primary group.
    pub gid: i64
    /// The home directory path.
    pub home: str
    /// The login shell path.
    pub shell: str
}

struct Anchor {
    words: []i64
    data: []u8
}

fn anchor_address() -> i64 {
    0x3e5700000000
}

fn anchor_size() -> i64 {
    1048576
}

fn anchor_data() -> i64 {
    64
}

fn anchor_magic() -> i64 {
    0x4c4f574f56455231
}

fn view_anchor() -> Anchor {
    let raw = __slice_ptr(__str_raw(anchor_address(), anchor_size()))
    let any: ptr = raw
    let words: ptr[i64] = any
    Anchor { words: view(words, anchor_size() / 8), data: view(raw, anchor_size()) }
}

fn anchor_mapped() -> bool {
    sys.is_mapped(anchor_address())
}

fn anchor_ready(a: Anchor) -> bool {
    __cas(mut a.words[1], anchor_magic(), anchor_magic())
}

fn attach() -> Anchor? {
    if !anchor_mapped() {
        return none
    }
    let a = view_anchor()
    if anchor_ready(a) {
        return a
    }
    none
}

fn create() -> Anchor ! io.Error {
    if !anchor_mapped() {
        let mapped = sys.map_anonymous_at(anchor_address(), anchor_size()) catch {
            Exists => -1
            e => fail e
        }
        if mapped == anchor_address() {
            let fresh = view_anchor()
            __cas(mut fresh.words[1], 0, anchor_magic())
            return fresh
        }
        if mapped >= 0 {
            sys.unmap(mapped, anchor_size())
            fail Unsupported
        }
    }
    let a = view_anchor()
    for _ in 0..1000 {
        if anchor_ready(a) {
            return a
        }
        sys.yield_thread()
    }
    fail Unsupported
}

fn records(blob: str) -> []str {
    var out: []str = []
    var start = 0
    for i in 0..blob.len {
        if blob[i] == 0 {
            push(mut out, blob[start..i])
            start = i + 1
        }
    }
    out
}

fn record_name(record: str) -> str {
    let at = text.index_byte(record, '=')
    if at < 0 {
        return record
    }
    record[..at]
}

fn snapshot() -> str {
    let a = attach() ?? return ""
    __lock(mut a.words[0])
    let blob = str(a.data[anchor_data()..anchor_data() + a.words[2]])
    __unlock(mut a.words[0])
    blob
}

fn put_record(name: str, record: str) ! io.Error {
    let a = create()?
    __lock(mut a.words[0])
    defer __unlock(mut a.words[0])
    var out: []u8 = []
    for existing in records(str(a.data[anchor_data()..anchor_data() + a.words[2]])) {
        if !same_name(record_name(existing), name) {
            text.append(mut out, existing)
            push(mut out, 0)
        }
    }
    text.append(mut out, record)
    push(mut out, 0)
    if anchor_data() + out.len > a.data.len {
        fail NoSpace
    }
    __memmove(a.data[anchor_data()..], out)
    a.words[2] = out.len
}

fn valid_name(name: str) -> bool {
    name.len > 0 && text.index_byte(name, '=') < 0 && text.index_byte(name, 0) < 0
}

/// Sets the environment variable `name` to `value` for this program.
///
/// The change is seen by `env`, `environment`, `std/process`'s `find` and the environment `std/process` passes to children that do not set their own. It is kept in a shared memory region, not in the operating system's environment block, so code outside Low that reads that block does not see it. Fails with `Invalid` if `name` is empty or contains `=` or NUL, or `value` contains NUL; with `NoSpace` when the region (1 MiB) is full; and with `Unsupported` if the region cannot be set up.
pub fn set_env(name: str, value: str) ! io.Error {
    if !valid_name(name) || text.index_byte(value, 0) >= 0 {
        fail Invalid
    }
    put_record(name, "{name}={value}")?
}

/// Removes the environment variable `name` from this program's view of the environment.
///
/// Afterwards `env` returns `none` and `environment` omits the name, even when the program started with it. Fails with `Invalid` if `name` is empty or contains `=` or NUL, and with `NoSpace` or `Unsupported` as `set_env` does.
pub fn unset_env(name: str) ! io.Error {
    if !valid_name(name) {
        fail Invalid
    }
    put_record(name, name)?
}

/// Returns the command-line arguments the program started with, the program name first.
pub fn args() -> []str {
    sys.arguments()
}

fn forget(mut vars: [str: str], name: str) {
    var matching: []str = []
    for existing, _ in vars {
        if same_name(existing, name) {
            push(mut matching, existing)
        }
    }
    for existing in matching {
        delete(mut vars, existing)
    }
}

/// Returns every environment variable as a map from name to value.
///
/// Starts from the environment the program was started with and applies the changes made by `set_env` and `unset_env`.
pub fn environment() -> [str: str] {
    var vars: [str: str] = [:]
    for entry in sys.environment() {
        let name = record_name(entry)
        if entry.len > name.len {
            vars[name] = entry[name.len + 1..]
        }
    }
    for record in records(snapshot()) {
        let name = record_name(record)
        forget(mut vars, name)
        if record.len > name.len {
            vars[name] = record[name.len + 1..]
        }
    }
    vars
}

fn inherited(name: str) -> str? {
    for entry in sys.environment() {
        let entry_name = record_name(entry)
        if entry.len > entry_name.len && same_name(entry_name, name) {
            return entry[entry_name.len + 1..]
        }
    }
    none
}

/// Returns the value of the environment variable `name`, or `none` if it is not set.
///
/// A variable that is set to an empty string returns `some("")`. Changes made by `set_env` and `unset_env` take precedence over the starting environment.
pub fn env(name: str) -> str? {
    for record in records(snapshot()) {
        if same_name(record_name(record), name) {
            if record.len == name.len {
                return none
            }
            return record[name.len + 1..]
        }
    }
    inherited(name)
}

/// Sets the file creation mask to `mask & 0o777` and returns the previous mask.
///
/// The mask is process-wide.
pub fn umask(mask: i64) -> i64 {
    sys.umask(mask)
}

/// Returns the process id.
pub fn pid() -> i64 {
    sys.pid()
}

/// Returns the process id of the parent.
pub fn ppid() -> i64 {
    sys.ppid()
}

/// Returns the real user id.
pub fn uid() -> i64 {
    sys.uid()
}

/// Returns the real group id.
pub fn gid() -> i64 {
    sys.gid()
}

/// Returns the effective user id.
pub fn euid() -> i64 {
    sys.euid()
}

/// Returns the effective group id.
pub fn egid() -> i64 {
    sys.egid()
}

/// Ends the process immediately with the status `code`.
///
/// Does not run pending `defer` blocks or drops and does not wait for other green threads. Does not return.
pub fn exit(code: i64) {
    sys.exit_process(code)
}

/// Returns the absolute path of the current working directory.
///
/// Fails with `NotFound` if the directory has been removed and with `TooLarge` if the path exceeds 1 MiB.
pub fn getcwd() -> str ! io.Error {
    sys.getcwd()?
}

/// Changes the working directory of the whole process to `path`.
///
/// Fails with `NotFound`, `NotDir` or `Denied` as the operating system reports. The change affects every green thread and relative paths used afterwards.
pub fn chdir(path: str) ! io.Error {
    sys.chdir(path)?
}

/// Returns the host name of the machine.
pub fn hostname() -> str ! io.Error {
    sys.hostname()?
}

/// Returns the path of the running executable.
///
/// Reads `/proc/self/exe` on Linux, and fails with the system error of reading the link, such as `NotFound` when `/proc` is not mounted. Blocks the OS thread for the call.
pub fn executable() -> str ! io.Error {
    sys.executable_path()?
}

/// Returns the number of seconds the machine has been running.
pub fn uptime() -> i64 ! io.Error {
    sys.uptime()?
}

/// Returns the number of CPUs the process may run on, according to its affinity mask.
///
/// Returns `1` if the mask cannot be read.
pub fn cpu_count() -> i64 {
    sys.cpu_count() or 1
}

fn present(name: str) -> str? {
    let value = env(name) ?? return none
    if value.len == 0 {
        return none
    }
    value
}
