import std/file

fn entries(path: str) -> []str {
    let raw = file.read_text(path) catch {
        _ => ""
    }
    var out: []str = []
    var start = 0
    for i in 0..raw.len {
        if raw[i] == 0 {
            push(mut out, raw[start..i])
            start = i + 1
        }
    }
    out
}

pub fn args() -> []str {
    entries("/proc/self/cmdline")
}

pub fn environment() -> [str: str] {
    var vars: [str: str] = [:]
    for entry in entries("/proc/self/environ") {
        for i in 0..entry.len {
            if entry[i] == '=' {
                vars[entry[..i]] = entry[i + 1..]
                break
            }
        }
    }
    vars
}

pub fn env(name: str) -> str? {
    environment()[name]
}

pub fn pid() -> i64 {
    __syscall(39)
}

pub fn exit(code: i64) {
    __syscall(231, code)
}
