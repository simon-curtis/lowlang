import std/io

pub enum Signal {
    Hangup
    Interrupt
    Quit
    Abort
    Kill
    User1
    User2
    Pipe
    Alarm
    Terminate
    Child
    Continue
    Stop
    TerminalStop
    WindowChange
}

struct Watching {
    signals: chan[Signal]
    done: chan[bool]
    read_fd: i64
    write_fd: i64
    page: i64
    numbers: []i64
    previous: []u8
    stopped: i64
    superseded: bool
}

pub struct WatchHandle {
    pub signals: chan[Signal]
    state: *Watching
}

pub struct Watch {
    pub handle: WatchHandle
    pub signals: chan[Signal]
    drop stop_on(handle)
}

fn handler_code(fd: i64) -> []u8 {
    let code: []u8 = [
        0x48, 0x83, 0xEC, 0x08,
        0x40, 0x88, 0x3C, 0x24,
        0xBF, 0, 0, 0, 0,
        0x48, 0x89, 0xE6,
        0xBA, 0x01, 0, 0, 0,
        0xB8, 0x01, 0, 0, 0,
        0x0F, 0x05,
        0x48, 0x83, 0xC4, 0x08,
        0xC3,
        0xB8, 0x0F, 0, 0, 0,
        0x0F, 0x05,
    ]
    io.set_le32(code, fd_offset(), fd)
    code
}

fn fd_offset() -> i64 {
    9
}

fn restorer_offset() -> i64 {
    33
}

fn page_size() -> i64 {
    4096
}

fn action_size() -> i64 {
    32
}

fn catch_flags() -> i64 {
    0x1C000000
}

fn stop_byte() -> u8 {
    0
}

fn disposition_default() -> i64 {
    0
}

fn disposition_ignore() -> i64 {
    1
}

pub fn number(s: Signal) -> i64 {
    match s {
        Hangup => 1
        Interrupt => 2
        Quit => 3
        Abort => 6
        Kill => 9
        User1 => 10
        User2 => 12
        Pipe => 13
        Alarm => 14
        Terminate => 15
        Child => 17
        Continue => 18
        Stop => 19
        TerminalStop => 20
        WindowChange => 28
    }
}

pub fn name(s: Signal) -> str {
    match s {
        Hangup => "SIGHUP"
        Interrupt => "SIGINT"
        Quit => "SIGQUIT"
        Abort => "SIGABRT"
        Kill => "SIGKILL"
        User1 => "SIGUSR1"
        User2 => "SIGUSR2"
        Pipe => "SIGPIPE"
        Alarm => "SIGALRM"
        Terminate => "SIGTERM"
        Child => "SIGCHLD"
        Continue => "SIGCONT"
        Stop => "SIGSTOP"
        TerminalStop => "SIGTSTP"
        WindowChange => "SIGWINCH"
    }
}

pub fn from_number(n: i64) -> Signal? {
    match n {
        == 1 => some(Hangup)
        == 2 => some(Interrupt)
        == 3 => some(Quit)
        == 6 => some(Abort)
        == 9 => some(Kill)
        == 10 => some(User1)
        == 12 => some(User2)
        == 13 => some(Pipe)
        == 14 => some(Alarm)
        == 15 => some(Terminate)
        == 17 => some(Child)
        == 18 => some(Continue)
        == 19 => some(Stop)
        == 20 => some(TerminalStop)
        == 28 => some(WindowChange)
        _ => none
    }
}

pub fn catchable(s: Signal) -> bool {
    s != Kill && s != Stop
}

fn catchable_numbers(signals: []Signal) -> []i64 ! io.Error {
    var out: []i64 = []
    for s in signals {
        if !catchable(s) {
            fail Invalid
        }
        let n = number(s)
        var seen = false
        for existing in out {
            if existing == n {
                seen = true
            }
        }
        if !seen {
            push(mut out, n)
        }
    }
    out
}

fn action(handler: i64, flags: i64, restorer: i64) -> []u8 {
    let a = io.buffer(action_size())
    io.set_le64(a, 0, handler)
    io.set_le64(a, 8, flags)
    io.set_le64(a, 16, restorer)
    a
}

fn sigaction(n: i64, act: []u8, old: []u8) -> i64 {
    __syscall(13, n, __slice_ptr(act), __slice_ptr(old), 8)
}

fn current_handler(n: i64) -> i64 {
    let old = io.buffer(action_size())
    let r = __syscall(13, n, 0, __slice_ptr(old), 8)
    if r < 0 {
        return -1
    }
    io.le64(old, 0)
}

fn set_disposition(n: i64, handler: i64) ! io.Error {
    let discarded = io.buffer(action_size())
    io.syscall_result(sigaction(n, action(handler, 0, 0), discarded))?
}

fn set_all(signals: []Signal, handler: i64) ! io.Error {
    let numbers = catchable_numbers(signals)?
    for n in numbers {
        set_disposition(n, handler)?
    }
}

pub fn ignore(signals: []Signal) ! io.Error {
    set_all(signals, disposition_ignore())?
}

pub fn reset(signals: []Signal) ! io.Error {
    set_all(signals, disposition_default())?
}

fn page_bytes(page: i64) -> []u8 {
    let raw = __slice_ptr(__str_raw(page, page_size()))
    view(raw, page_size())
}

fn map_page(fd: i64) -> i64 ! io.Error {
    let page = io.syscall_result(__syscall(9, 0, page_size(), 7, 0x22, -1, 0))?
    let code = handler_code(fd)
    io.copy(page_bytes(page), code)
    page
}

fn open_pipe() -> []i64 ! io.Error {
    let fds = io.buffer(8)
    io.syscall_result(__syscall(293, __slice_ptr(fds), 0x80800))?
    [io.le32(fds, 0), io.le32(fds, 4)]
}

fn close_fd(fd: i64) {
    if fd >= 0 {
        __syscall(3, fd)
    }
}

fn read_signals(h: *Watching, buf: []u8) -> i64 {
    for {
        let r = __syscall(0, h.read_fd, __slice_ptr(buf), buf.len)
        if r == -4 {
            continue
        }
        if r == -11 {
            wait_readable(h.read_fd)
            continue
        }
        return r
    }
}

fn offer(h: *Watching, n: i64) {
    let s = from_number(n) ?? return
    select {
        h.signals <- s => {}
        else => {}
    }
}

fn deliver(h: *Watching, buf: []u8, count: i64) -> bool {
    for i in 0..count {
        if buf[i] == stop_byte() {
            return true
        }
        offer(h, i64(buf[i]))
    }
    false
}

fn forward(h: *Watching) {
    let buf = io.buffer(64)
    for {
        let count = read_signals(h, buf)
        if count <= 0 || deliver(h, buf, count) {
            break
        }
    }
    close(h.signals)
    h.done <- true
}

fn install(h: *Watching, n: i64) ! io.Error {
    let act = action(h.page, catch_flags(), h.page + restorer_offset())
    let old = io.buffer(action_size())
    io.syscall_result(sigaction(n, act, old))?
    push(mut h.numbers, n)
    io.append(mut h.previous, old)
}

fn install_all(h: *Watching, numbers: []i64) ! io.Error {
    for n in numbers {
        install(h, n)?
    }
}

pub fn notify_handle(signals: []Signal) -> WatchHandle ! io.Error {
    let numbers = catchable_numbers(signals)?
    if numbers.len == 0 {
        fail Invalid
    }
    let fds = open_pipe()?
    let page = map_page(fds[1]) catch {
        e => {
            close_fd(fds[0])
            close_fd(fds[1])
            fail e
        }
    }
    let state = new(Watching {
        signals: chan[Signal](16)
        done: chan[bool](1)
        read_fd: fds[0]
        write_fd: fds[1]
        page
        numbers: []
        previous: []
        stopped: 0
        superseded: false
    })
    let handle = WatchHandle { signals: state.signals, state }
    spawn forward(state)
    install_all(state, numbers) catch {
        e => {
            using failed = adopt(handle)
            fail e
        }
    }
    handle
}

pub fn adopt(h: WatchHandle) -> Watch {
    Watch { handle: h, signals: h.signals }
}

pub fn notify(signals: []Signal) -> Watch ! io.Error {
    let h = notify_handle(signals)?
    adopt(h)
}

fn restore(h: *Watching) {
    for i in 0..h.numbers.len {
        let n = h.numbers[i]
        if current_handler(n) != h.page {
            h.superseded = true
            continue
        }
        let saved = h.previous[i * action_size()..(i + 1) * action_size()]
        let old = io.buffer(action_size())
        sigaction(n, saved, old)
    }
}

fn silence_handler(h: *Watching) {
    let code = handler_code(-1)
    io.copy(page_bytes(h.page), code)
}

fn finished(h: *Watching) -> bool {
    select {
        <-h.done => true
        else => false
    }
}

fn request_stop(h: *Watching) {
    let b = io.buffer(1)
    b[0] = stop_byte()
    for _ in 0..2000 {
        let r = __syscall(1, h.write_fd, __slice_ptr(b), 1)
        if r == -11 {
            sleep(1)
            continue
        }
        if r != -4 {
            return
        }
    }
}

pub fn stop(w: Watch) {
    stop_on(w.handle)
}

pub fn stop_on(h: WatchHandle) {
    let s = h.state
    if !__cas(mut s.stopped, 0, 1) {
        return
    }
    restore(s)
    if s.superseded {
        silence_handler(s)
    }
    if !finished(s) {
        request_stop(s)
        <-s.done
    }
    close_fd(s.read_fd)
    close_fd(s.write_fd)
    if !s.superseded {
        __syscall(11, s.page, page_size())
    }
}

pub fn wait_for(w: Watch) -> Signal ! io.Error {
    wait_for_on(w.handle)?
}

pub fn wait_for_on(h: WatchHandle) -> Signal ! io.Error {
    let got = <-h.signals
    match got {
        some(s) => s
        none => fail NotConnected
    }
}

pub fn wait_timeout(w: Watch, millis: i64) -> Signal? {
    wait_timeout_on(w.handle, millis)
}

pub fn wait_timeout_on(h: WatchHandle, millis: i64) -> Signal? {
    select {
        s = <-h.signals => s
        after(millis) => none
    }
}

pub fn wait_any(signals: []Signal) -> Signal ! io.Error {
    using w = notify(signals)?
    wait_for(w)?
}

pub fn send(pid: i64, s: Signal) ! io.Error {
    io.syscall_result(__syscall(62, pid, number(s)))?
}

pub fn raise(s: Signal) ! io.Error {
    io.syscall_result(__syscall(234, __syscall(39), __syscall(186), number(s)))?
}
