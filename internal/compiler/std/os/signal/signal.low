import std/atomic
import std/io
import std/sys

/// A Linux signal that this module can send, catch or ignore.
pub enum Signal {
    /// The terminal closed or the controlling process ended (`SIGHUP`, 1).
    Hangup
    /// Interrupt from the keyboard (`SIGINT`, 2).
    Interrupt
    /// Quit from the keyboard (`SIGQUIT`, 3).
    Quit
    /// Illegal instruction (`SIGILL`, 4).
    IllegalInstruction
    /// Trace or breakpoint trap (`SIGTRAP`, 5).
    Trap
    /// Abnormal termination (`SIGABRT`, 6).
    Abort
    /// Access to an invalid memory address or a misaligned access (`SIGBUS`, 7).
    BusError
    /// Arithmetic error such as division by zero (`SIGFPE`, 8).
    FloatingPoint
    /// Unconditional termination (`SIGKILL`, 9), which cannot be caught or ignored.
    Kill
    /// First user-defined signal (`SIGUSR1`, 10).
    User1
    /// Invalid memory reference (`SIGSEGV`, 11).
    SegmentationFault
    /// Second user-defined signal (`SIGUSR2`, 12).
    User2
    /// Write to a pipe or socket with no reader (`SIGPIPE`, 13).
    Pipe
    /// Timer expiry (`SIGALRM`, 14).
    Alarm
    /// Request to terminate (`SIGTERM`, 15).
    Terminate
    /// A child process stopped or ended (`SIGCHLD`, 17).
    Child
    /// Resume a stopped process (`SIGCONT`, 18).
    Continue
    /// Unconditional stop (`SIGSTOP`, 19), which cannot be caught or ignored.
    Stop
    /// Stop from the keyboard (`SIGTSTP`, 20).
    TerminalStop
    /// A background process read from its terminal (`SIGTTIN`, 21).
    TerminalInput
    /// A background process wrote to its terminal (`SIGTTOU`, 22).
    TerminalOutput
    /// Urgent data on a socket (`SIGURG`, 23).
    UrgentData
    /// CPU time limit exceeded (`SIGXCPU`, 24).
    CpuLimit
    /// File size limit exceeded (`SIGXFSZ`, 25).
    FileSizeLimit
    /// Virtual timer expiry (`SIGVTALRM`, 26).
    VirtualAlarm
    /// Profiling timer expiry (`SIGPROF`, 27).
    ProfilingAlarm
    /// The terminal window was resized (`SIGWINCH`, 28).
    WindowChange
    /// I/O is possible on a descriptor (`SIGIO`, 29).
    IoReady
    /// Power failure (`SIGPWR`, 30).
    PowerFailure
    /// Bad system call (`SIGSYS`, 31).
    BadSystemCall
    /// A signal without a name here, such as a real-time signal, with its Linux number from 1 to 64.
    Other(number: i64)
}

struct Described {
    number: i64
    name: str
}

struct Watching {
    signals: chan[Signal]
    done: chan[bool]
    read_fd: i64
    write_fd: i64
    page: i64
    numbers: []i64
    previous: []sys.Action
    stopped: atomic.Flag
    superseded: bool
}

/// A copyable view of a signal watch, used to receive signals and to stop the watch from another green thread.
///
/// Dropping a handle does not stop the watch; `stop_on` or the owning `Watch` does.
pub struct WatchHandle {
    /// The channel the caught signals arrive on.
    ///
    /// It holds 16 signals and drops a signal that arrives while it is full. It is closed when the watch stops.
    pub signals: chan[Signal]
    state: *Watching
}

/// The owner of a signal watch.
///
/// Dropping it stops the watch.
pub struct Watch {
    /// The copyable view of the watch.
    pub handle: WatchHandle
    drop stop_on(handle)
}

fn page_size() -> i64 {
    4096
}

fn stop_byte() -> u8 {
    0
}

fn last_number() -> i64 {
    64
}

fn describe(s: Signal) -> Described {
    match s {
        Hangup => Described { number: 1, name: "SIGHUP" }
        Interrupt => Described { number: 2, name: "SIGINT" }
        Quit => Described { number: 3, name: "SIGQUIT" }
        IllegalInstruction => Described { number: 4, name: "SIGILL" }
        Trap => Described { number: 5, name: "SIGTRAP" }
        Abort => Described { number: 6, name: "SIGABRT" }
        BusError => Described { number: 7, name: "SIGBUS" }
        FloatingPoint => Described { number: 8, name: "SIGFPE" }
        Kill => Described { number: 9, name: "SIGKILL" }
        User1 => Described { number: 10, name: "SIGUSR1" }
        SegmentationFault => Described { number: 11, name: "SIGSEGV" }
        User2 => Described { number: 12, name: "SIGUSR2" }
        Pipe => Described { number: 13, name: "SIGPIPE" }
        Alarm => Described { number: 14, name: "SIGALRM" }
        Terminate => Described { number: 15, name: "SIGTERM" }
        Child => Described { number: 17, name: "SIGCHLD" }
        Continue => Described { number: 18, name: "SIGCONT" }
        Stop => Described { number: 19, name: "SIGSTOP" }
        TerminalStop => Described { number: 20, name: "SIGTSTP" }
        TerminalInput => Described { number: 21, name: "SIGTTIN" }
        TerminalOutput => Described { number: 22, name: "SIGTTOU" }
        UrgentData => Described { number: 23, name: "SIGURG" }
        CpuLimit => Described { number: 24, name: "SIGXCPU" }
        FileSizeLimit => Described { number: 25, name: "SIGXFSZ" }
        VirtualAlarm => Described { number: 26, name: "SIGVTALRM" }
        ProfilingAlarm => Described { number: 27, name: "SIGPROF" }
        WindowChange => Described { number: 28, name: "SIGWINCH" }
        IoReady => Described { number: 29, name: "SIGIO" }
        PowerFailure => Described { number: 30, name: "SIGPWR" }
        BadSystemCall => Described { number: 31, name: "SIGSYS" }
        Other(n) => Described { number: n, name: "SIG{n}" }
    }
}

fn named() -> []Signal {
    [
        Hangup, Interrupt, Quit, IllegalInstruction, Trap, Abort, BusError, FloatingPoint
        Kill, User1, SegmentationFault, User2, Pipe, Alarm, Terminate, Child
        Continue, Stop, TerminalStop, TerminalInput, TerminalOutput, UrgentData, CpuLimit, FileSizeLimit
        VirtualAlarm, ProfilingAlarm, WindowChange, IoReady, PowerFailure, BadSystemCall
    ]
}

/// Returns the Linux signal number of `s`.
pub fn number(s: Signal) -> i64 {
    describe(s).number
}

/// Returns the conventional name of `s`, such as `SIGINT`.
///
/// A signal without a name gives `SIG` followed by its number.
pub fn name(s: Signal) -> str {
    describe(s).name
}

/// Returns the signal with Linux number `n`, or `none` if `n` is outside 1 to 64.
///
/// A number without a named variant gives `Other(n)`.
pub fn from_number(n: i64) -> Signal? {
    for s in named() {
        if describe(s).number == n {
            return some(s)
        }
    }
    if n >= 1 && n <= last_number() {
        return some(Other(n))
    }
    none
}

/// Returns whether `s` can be caught or ignored, which is `false` for `Kill` and `Stop`.
pub fn catchable(s: Signal) -> bool {
    s != Kill && s != Stop
}

fn catchable_numbers(signals: []Signal) -> []i64 ! io.Error {
    var out: []i64 = []
    for s in signals {
        if !catchable(s) {
            fail Invalid
        }
        let n = number(s)
        var seen = false
        for existing in out {
            if existing == n {
                seen = true
            }
        }
        if !seen {
            push(mut out, n)
        }
    }
    out
}

fn set_all(signals: []Signal, how: sys.Disposition) ! io.Error {
    let numbers = catchable_numbers(signals)?
    for n in numbers {
        sys.set_disposition(n, how)?
    }
}

/// Sets the disposition of each signal in `signals` to ignored, for the whole process.
///
/// Fails with `Invalid`, without changing any signal, if the list contains `Kill` or `Stop`. Fails with the system error if a disposition cannot be set.
pub fn ignore(signals: []Signal) ! io.Error {
    set_all(signals, sys.Disposition.Ignore)?
}

/// Sets the disposition of each signal in `signals` back to the system default, for the whole process.
///
/// Fails with `Invalid`, without changing any signal, if the list contains `Kill` or `Stop`.
pub fn reset(signals: []Signal) ! io.Error {
    set_all(signals, sys.Disposition.Default)?
}

fn page_bytes(page: i64) -> []u8 {
    let raw = __slice_ptr(__str_raw(page, page_size()))
    view(raw, page_size())
}

fn map_page(fd: i64) -> i64 ! io.Error {
    let page = sys.map_executable(page_size())?
    let code = sys.handler_code(fd)
    io.copy(page_bytes(page), code)
    page
}

fn offer(h: *Watching, n: i64) {
    let s = from_number(n) ?? return
    select {
        h.signals <- s => {}
        else => {}
    }
}

fn deliver(h: *Watching, buf: []u8, count: i64) -> bool {
    for i in 0..count {
        if buf[i] == stop_byte() {
            return true
        }
        offer(h, i64(buf[i]))
    }
    false
}

fn forward(h: *Watching) {
    let buf = io.buffer(64)
    for {
        let count = sys.read(h.read_fd, buf) catch { _ => 0 }
        if count <= 0 || deliver(h, buf, count) {
            break
        }
    }
    close(h.signals)
    h.done <- true
}

fn install(h: *Watching, n: i64) ! io.Error {
    let old = sys.catch_signal(n, h.page, h.page + sys.restorer_offset())?
    push(mut h.numbers, n)
    push(mut h.previous, old)
}

fn install_all(h: *Watching, numbers: []i64) ! io.Error {
    for n in numbers {
        install(h, n)?
    }
}

/// Starts delivering `signals` to a channel and returns the view of the watch.
///
/// Installs a handler for each signal, replacing the current disposition, and starts a green thread that forwards them. The caller must stop the watch with `stop_on`, or bind it with `adopt` so that dropping it does. Fails with `Invalid` if `signals` is empty or contains `Kill` or `Stop`, and with the system error if a pipe, page or handler cannot be set up, in which case nothing stays installed.
pub fn notify_handle(signals: []Signal) -> WatchHandle ! io.Error {
    let numbers = catchable_numbers(signals)?
    if numbers.len == 0 {
        fail Invalid
    }
    let ends = sys.pipe(true)?
    let page = map_page(ends.second) catch {
        e => {
            sys.close_fd(ends.first)
            sys.close_fd(ends.second)
            fail e
        }
    }
    let state = new(Watching {
        signals: chan[Signal](16)
        done: chan[bool](1)
        read_fd: ends.first
        write_fd: ends.second
        page
        numbers: []
        previous: []
        stopped: atomic.flag()
        superseded: false
    })
    let handle = WatchHandle { signals: state.signals, state }
    spawn forward(state)
    install_all(state, numbers) catch {
        e => {
            using failed = adopt(handle)
            fail e
        }
    }
    handle
}

/// Returns the `Watch` that owns the watch behind `h`, which stops it when dropped.
pub fn adopt(h: WatchHandle) -> Watch {
    Watch { handle: h }
}

/// Starts delivering `signals` to the `signals` channel of the handle of the returned `Watch`.
///
/// The watch ends when the `Watch` is dropped or passed to `stop`. Fails as `notify_handle` does.
pub fn notify(signals: []Signal) -> Watch ! io.Error {
    let h = notify_handle(signals)?
    adopt(h)
}

fn restore(h: *Watching) {
    for i in 0..h.numbers.len {
        let n = h.numbers[i]
        let installed = sys.handler_of(n) catch { _ => -1 }
        if installed != h.page {
            h.superseded = true
            continue
        }
        sys.restore_action(n, h.previous[i]) catch { _ => {} }
    }
}

fn silence_handler(h: *Watching) {
    let code = sys.handler_code(-1)
    io.copy(page_bytes(h.page), code)
}

fn finished(h: *Watching) -> bool {
    select {
        <-h.done => true
        else => false
    }
}

fn request_stop(h: *Watching) {
    let b = io.buffer(1)
    b[0] = stop_byte()
    sys.write_all(h.write_fd, b) catch { _ => {} }
}

/// Stops the watch owned by `w`. Does the same as `stop_on` on its handle.
pub fn stop(w: Watch) {
    stop_on(w.handle)
}

/// Stops the watch behind `h`.
///
/// Restores the dispositions that were in place before the watch, except for signals whose handler another `notify` has replaced since. Closes the `signals` channel, which wakes any green thread waiting on it, and parks the calling green thread until the forwarding green thread has finished. Later calls do nothing.
pub fn stop_on(h: WatchHandle) {
    let s = h.state
    if !atomic.set(s.stopped) {
        return
    }
    restore(s)
    if s.superseded {
        silence_handler(s)
    }
    if !finished(s) {
        request_stop(s)
        <-s.done
    }
    sys.close_fd(s.read_fd)
    sys.close_fd(s.write_fd)
    if !s.superseded {
        sys.unmap(s.page, page_size())
    }
}

/// Parks the green thread until `w` delivers a signal and returns it.
///
/// Fails with `NotConnected` once the watch has stopped.
pub fn wait_for(w: Watch) -> Signal ! io.Error {
    wait_for_on(w.handle)?
}

/// Parks the green thread until the watch behind `h` delivers a signal and returns it.
///
/// Fails with `NotConnected` once the watch has stopped.
pub fn wait_for_on(h: WatchHandle) -> Signal ! io.Error {
    let got = <-h.signals
    match got {
        some(s) => s
        none => fail NotConnected
    }
}

/// Waits up to `millis` milliseconds for `w` to deliver a signal, and returns it, or `none` on timeout or when the watch has stopped.
///
/// Parks the green thread while it waits.
pub fn wait_timeout(w: Watch, millis: i64) -> Signal? {
    wait_timeout_on(w.handle, millis)
}

/// Waits up to `millis` milliseconds for the watch behind `h` to deliver a signal, and returns it, or `none` on timeout or when the watch has stopped.
///
/// Parks the green thread while it waits.
pub fn wait_timeout_on(h: WatchHandle, millis: i64) -> Signal? {
    select {
        s = <-h.signals => s
        after(millis) => none
    }
}

/// Parks the green thread until one of `signals` arrives and returns it.
///
/// Watches the signals only for the duration of the call and restores their dispositions before returning. Fails as `notify` does.
pub fn wait_any(signals: []Signal) -> Signal ! io.Error {
    using w = notify(signals)?
    wait_for(w)?
}

/// Sends the signal `s` to the process `pid`.
///
/// The signal is directed at the process and is delivered to any of its threads. Fails with `NotFound` if the process does not exist and `Denied` if the caller may not signal it.
pub fn send(pid: i64, s: Signal) ! io.Error {
    sys.kill(pid, number(s))?
}

/// Sends the signal `s` to the calling thread.
///
/// A handler installed in this process has run by the time `raise` returns.
pub fn raise(s: Signal) ! io.Error {
    sys.raise(number(s))?
}
