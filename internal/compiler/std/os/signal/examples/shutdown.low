import std/io
import std/os
import std/os/signal

fn describe(s: signal.Signal) -> str {
    "{signal.name(s)} ({signal.number(s)})"
}

fn deliver(w: signal.Watch, s: signal.Signal) -> signal.Signal ! io.Error {
    signal.send(os.pid(), s)?
    signal.wait_for(w)?
}

/// Catches signals the way a service handles reload and shutdown, sending each one to the process itself.
fn main() ! io.Error {
    using w = signal.notify([signal.Signal.Interrupt, signal.Signal.Terminate, signal.Signal.User1])?
    let reload = deliver(w, signal.Signal.User1)?
    print("{describe(reload)}: reloading configuration")
    let stop = deliver(w, signal.Signal.Terminate)?
    print("{describe(stop)}: shutting down")
    let quiet = signal.wait_timeout(w, 50)
    print("pending after shutdown: {quiet != none}")

    signal.ignore([signal.Signal.Kill]) or print("SIGKILL cannot be ignored")
    print("catchable: {signal.catchable(signal.Signal.Interrupt)} {signal.catchable(signal.Signal.Stop)}")

    signal.ignore([signal.Signal.Hangup])?
    signal.raise(signal.Signal.Hangup)?
    print("survived SIGHUP")
    signal.reset([signal.Signal.Hangup])?
}
