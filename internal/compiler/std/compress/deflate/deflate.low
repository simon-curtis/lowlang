import std/io

/// The container around a DEFLATE stream.
pub enum Format {
    /// A bare DEFLATE stream (RFC 1951) with no header or checksum.
    Raw
    /// A zlib stream (RFC 1950): a two byte header, the DEFLATE stream and an Adler-32 checksum.
    Zlib
    /// A gzip member (RFC 1952): a ten byte header, the DEFLATE stream and a CRC-32 and size trailer.
    Gzip
}

struct Collector {
    data: []u8
    len: i64
}

fn collector(hint: i64, limit: i64) -> *Collector {
    var size = if hint > limit { limit } else { hint }
    if size < 64 {
        size = 64
    }
    new(Collector { data: __make(size), len: 0 })
}

fn collect(c: *Collector, chunk: []u8) {
    let need = c.len + chunk.len
    if need > c.data.len {
        let size = if c.data.len * 2 > need { c.data.len * 2 } else { need }
        let grown: []u8 = __make(size)
        __memmove(grown, c.data[..c.len])
        c.data = grown
    }
    __memmove(c.data[c.len..], chunk)
    c.len = need
}

fn contents(c: *Collector) -> []u8 {
    c.data[..c.len]
}

fn encode_buffer(data: []u8, format: Format, level: i64) -> []u8 {
    let c = collector(data.len / 2 + 64, data.len + 1024)
    let sink: fn([]u8) ! io.Error = fn(chunk) { collect(c, chunk) }
    let e = encoder(format, level, sink)
    encode(e, data) catch {
        _ => {}
    }
    finish(e) catch {
        _ => {}
    }
    contents(c)
}

/// Returns `data` compressed as a raw DEFLATE stream.
///
/// `level` is clamped to `0..9`, with a negative value meaning `6`; `0` stores the data without compression.
pub fn compress(data: []u8, level: i64) -> []u8 {
    encode_buffer(data, Raw, level)
}

/// Returns `data` compressed as a zlib stream.
///
/// `level` is clamped to `0..9`, with a negative value meaning `6`; `0` stores the data without compression.
pub fn zlib_compress(data: []u8, level: i64) -> []u8 {
    encode_buffer(data, Zlib, level)
}

/// Returns `data` compressed as a single gzip member.
///
/// `level` is clamped to `0..9`, with a negative value meaning `6`; `0` stores the data without compression. The header carries no name, comment or modification time and marks the operating system as unknown.
pub fn gzip_compress(data: []u8, level: i64) -> []u8 {
    encode_buffer(data, Gzip, level)
}
