import std/compress/codec
import std/hash
import std/io
import std/math

/// A streaming DEFLATE encoder made by `encoder`, producing a raw, zlib or gzip stream.
///
/// `encode` takes input in any chunking, `flush` ends the data written so far on a byte boundary, and `finish` writes the end of the stream and any trailer. After `finish`, `encode`, `flush` and `finish` fail with `Invalid`. A chunk is valid only during the call to `sink`.
pub struct Encoder {
    core: *Deflater
    sink: fn([]u8) ! io.Error
    finished: bool
}

struct Deflater {
    format: Format
    level: i64
    good: i64
    max_lazy: i64
    nice: i64
    chain: i64
    win: []u8
    base: i64
    end: i64
    pos: i64
    covered: i64
    block_start: i64
    head: []u32
    prev: []u32
    match_available: bool
    match_length: i64
    match_start: i64
    prev_length: i64
    prev_match: i64
    syms: []u32
    nsyms: i64
    lit_freq: []i64
    dist_freq: []i64
    clen_freq: []i64
    len_sym: []i64
    dist_sym: []i64
    tables: Tables
    builder: *codec.Builder
    fixed_lit: *codec.Code
    fixed_dist: *codec.Code
    lit: *codec.Code
    dist: *codec.Code
    clen: *codec.Code
    all: []u8
    rle: []u8
    rle_extra: []u8
    nrle: i64
    out: *codec.Buffer
    crc: *hash.Crc32
    adler: u32
    size: i64
}

fn level_config(level: i64) -> []i64 {
    let configs: [][]i64 = [
        [0, 0, 0, 0], [4, 4, 8, 4], [4, 5, 16, 8], [4, 6, 32, 32], [4, 4, 16, 16],
        [8, 16, 32, 32], [8, 16, 128, 128], [8, 32, 128, 256], [32, 128, 258, 1024], [32, 258, 258, 4096],
    ]
    configs[level]
}

fn length_symbols(t: Tables) -> []i64 {
    let syms: []i64 = __make(259)
    for c in 0..28 {
        for n in 0..1 << t.len_extra[c] {
            syms[t.len_base[c] + n] = 257 + c
        }
    }
    syms[258] = 285
    syms
}

fn distance_symbols(t: Tables) -> []i64 {
    let syms: []i64 = __make(512)
    for c in 0..30 {
        if c < 16 {
            for n in 0..1 << t.dist_extra[c] {
                syms[t.dist_base[c] - 1 + n] = c
            }
        } else {
            for n in 0..1 << (t.dist_extra[c] - 7) {
                syms[256 + ((t.dist_base[c] - 1) >> 7) + n] = c
            }
        }
    }
    syms
}

/// Returns an encoder that writes a stream in `format` to `sink`; a zlib or gzip header is written immediately.
///
/// `level` is clamped to `0..9`, with a negative value meaning `6`; `0` stores the data without compression.
pub fn encoder(format: Format, level: i64, sink: fn([]u8) ! io.Error) -> *Encoder {
    new(Encoder { core: deflater(format, level, 65536), sink, finished: false })
}

fn deflater(format: Format, level: i64, capacity: i64) -> *Deflater {
    let lvl = if level < 0 { 6 } else if level > 9 { 9 } else { level }
    let config = level_config(lvl)
    let t = tables()
    let b = codec.builder(288)
    let fixed_lit = fixed_code(fixed_lengths(), b)
    let fixed_dist = fixed_code(fixed_distance_lengths(), b)
    let e = new(Deflater {
        format
        level: lvl
        good: config[0]
        max_lazy: config[1]
        nice: config[2]
        chain: config[3]
        win: __make(98304)
        base: 0
        end: 0
        pos: 0
        covered: 0
        block_start: 0
        head: __make(32768)
        prev: __make(32768)
        match_available: false
        match_length: 2
        match_start: 0
        prev_length: 2
        prev_match: 0
        syms: __make(16384)
        nsyms: 0
        lit_freq: __make(286)
        dist_freq: __make(30)
        clen_freq: __make(19)
        len_sym: length_symbols(t)
        dist_sym: distance_symbols(t)
        tables: t
        builder: b
        fixed_lit
        fixed_dist
        lit: codec.code(286)
        dist: codec.code(30)
        clen: codec.code(19)
        all: __make(316)
        rle: __make(316)
        rle_extra: __make(316)
        nrle: 0
        out: codec.buffer(capacity)
        crc: hash.crc32_new()
        adler: 1
        size: 0
    })
    write_header(e)
    e
}

fn write_header(e: *Deflater) {
    match e.format {
        Raw => {}
        Zlib => {
            let flevel = if e.level < 2 { 0 } else if e.level < 6 { 1 } else if e.level == 6 { 2 } else { 3 }
            var flg = flevel << 6
            flg += 31 - (0x7800 | flg) % 31
            codec.put_bits(e.out, 0x78, 8)
            codec.put_bits(e.out, flg, 8)
        }
        Gzip => {
            codec.put_bits(e.out, 0x8B1F, 16)
            codec.put_bits(e.out, 8, 8)
            codec.put_bits(e.out, 0, 8)
            codec.put_bits(e.out, 0, 32)
            codec.put_bits(e.out, if e.level == 9 { 2 } else if e.level == 1 { 4 } else { 0 }, 8)
            codec.put_bits(e.out, 255, 8)
        }
    }
}

fn insert(e: *Deflater, p: i64) -> i64 {
    let w = e.win
    let i = p - e.base
    let key = u32(w[i]) | u32(w[i + 1]) << 8 | u32(w[i + 2]) << 16
    let h = i64(key * 0x9E3779B1 >> 17)
    let c = e.head[h]
    e.head[h] = u32(i + 1)
    e.prev[p & 32767] = c
    i64(c) - 1 + e.base
}

fn insert_range(e: *Deflater, from: i64, to: i64) {
    let stop = if to > e.end - 2 { e.end - 2 } else { to }
    for p in from..stop {
        insert(e, p)
    }
}

fn longest(e: *Deflater, pos: i64, first: i64, start: i64) -> i64 {
    let w = e.win
    let base = e.base
    let max = if e.end - pos > 258 { 258 } else { e.end - pos }
    var best = start
    if best >= max {
        return best
    }
    let nice = if e.nice > max { max } else { e.nice }
    var chain = if start >= e.good { e.chain >> 2 } else { e.chain }
    let pi = pos - base
    var cand = first
    for {
        let ci = cand - base
        if w[ci + best] == w[pi + best] && w[ci] == w[pi] && w[ci + 1] == w[pi + 1] {
            var n = 2
            for n < max && w[ci + n] == w[pi + n] {
                n += 1
            }
            if n > best {
                best = n
                e.match_start = cand
                if n >= nice {
                    break
                }
            }
        }
        chain -= 1
        let next = i64(e.prev[cand & 32767]) - 1 + base
        if chain <= 0 || next < base || next >= cand || pos - next > 32768 {
            break
        }
        cand = next
    }
    best
}

fn literal(e: *Deflater, b: u8) {
    e.syms[e.nsyms] = u32(b)
    e.nsyms += 1
    e.lit_freq[b] += 1
    e.covered += 1
    if e.nsyms == e.syms.len {
        emit_block(e, false)
    }
}

fn distance_symbol(e: *Deflater, distance: i64) -> i64 {
    if distance <= 256 {
        return e.dist_sym[distance - 1]
    }
    e.dist_sym[256 + ((distance - 1) >> 7)]
}

fn matched(e: *Deflater, distance: i64, length: i64) {
    e.syms[e.nsyms] = 0x80000000 | u32(length - 3) << 16 | u32(distance - 1)
    e.nsyms += 1
    e.lit_freq[e.len_sym[length]] += 1
    e.dist_freq[distance_symbol(e, distance)] += 1
    e.covered += length
    if e.nsyms == e.syms.len {
        emit_block(e, false)
    }
}

fn match_fast(e: *Deflater, limit: i64) {
    for e.pos < limit {
        let pos = e.pos
        var length = 0
        if pos + 2 < e.end {
            let cand = insert(e, pos)
            if cand >= e.base && pos - cand <= 32768 {
                length = longest(e, pos, cand, 2)
            }
        }
        if length >= 3 {
            matched(e, pos - e.match_start, length)
            if length <= e.max_lazy {
                insert_range(e, pos + 1, pos + length)
            }
            e.pos = pos + length
        } else {
            literal(e, e.win[pos - e.base])
            e.pos = pos + 1
        }
    }
}

fn match_lazy(e: *Deflater, limit: i64) {
    for e.pos < limit {
        let pos = e.pos
        e.prev_length = e.match_length
        e.prev_match = e.match_start
        e.match_length = 2
        if pos + 2 < e.end {
            let cand = insert(e, pos)
            if cand >= e.base && pos - cand <= 32768 && e.prev_length < e.max_lazy {
                let found = longest(e, pos, cand, e.prev_length)
                e.match_length = if found == 3 && pos - e.match_start > 4096 { 2 } else { found }
            }
        }
        if e.prev_length >= 3 && e.match_length <= e.prev_length {
            let stop = pos - 1 + e.prev_length
            matched(e, pos - 1 - e.prev_match, e.prev_length)
            insert_range(e, pos + 1, stop)
            e.pos = stop
            e.match_available = false
            e.match_length = 2
        } else if e.match_available {
            literal(e, e.win[pos - 1 - e.base])
            e.pos = pos + 1
        } else {
            e.match_available = true
            e.pos = pos + 1
        }
    }
}

fn process(e: *Deflater, flushing: bool) {
    if e.level == 0 {
        e.pos = e.end
        e.covered = e.end
        return
    }
    let limit = if flushing { e.end } else { e.end - 262 }
    if e.level <= 3 {
        match_fast(e, limit)
        return
    }
    match_lazy(e, limit)
    if flushing && e.match_available {
        literal(e, e.win[e.pos - 1 - e.base])
        e.match_available = false
        e.match_length = 2
    }
}

fn slide_window(e: *Deflater) {
    let keep = e.pos - 32768
    if e.block_start < keep {
        emit_block(e, false)
    }
    let shift = u32(keep - e.base)
    rebase(e.head, shift)
    rebase(e.prev, shift)
    __memmove(e.win, e.win[keep - e.base..e.end - e.base])
    e.base = keep
}

fn rebase(links: []u32, shift: u32) {
    for i in 0..links.len {
        let v = links[i]
        links[i] = if v > shift { v - shift } else { 0 }
    }
}

fn extra_bits(e: *Deflater) -> i64 {
    let t = e.tables
    var bits = 0
    for c in 0..29 {
        bits += e.lit_freq[257 + c] * t.len_extra[c]
    }
    for c in 0..30 {
        bits += e.dist_freq[c] * t.dist_extra[c]
    }
    bits
}

fn trimmed(lens: []u8, least: i64) -> i64 {
    var n = lens.len
    for n > least && lens[n - 1] == 0 {
        n -= 1
    }
    n
}

fn rle_put(e: *Deflater, sym: u8, extra: i64) {
    e.rle[e.nrle] = sym
    e.rle_extra[e.nrle] = u8(extra)
    e.nrle += 1
    e.clen_freq[sym] += 1
}

fn rle(e: *Deflater, hlit: i64, hdist: i64) {
    let all = e.all
    __memmove(all, e.lit.lens[..hlit])
    __memmove(all[hlit..], e.dist.lens[..hdist])
    let n = hlit + hdist
    for i in 0..19 {
        e.clen_freq[i] = 0
    }
    e.nrle = 0
    var i = 0
    for i < n {
        let l = all[i]
        var run = 1
        for i + run < n && all[i + run] == l {
            run += 1
        }
        var left = run
        if l == 0 {
            for left >= 11 {
                let k = if left > 138 { 138 } else { left }
                rle_put(e, 18, k - 11)
                left -= k
            }
            if left >= 3 {
                rle_put(e, 17, left - 3)
                left = 0
            }
        } else {
            rle_put(e, l, 0)
            left -= 1
            for left >= 3 {
                let k = if left > 6 { 6 } else { left }
                rle_put(e, 16, k - 3)
                left -= k
            }
        }
        for _ in 0..left {
            rle_put(e, l, 0)
        }
        i += run
    }
}

fn rle_cost(e: *Deflater) -> i64 {
    codec.code_cost(e.clen_freq, e.clen) + 2 * e.clen_freq[16] + 3 * e.clen_freq[17] + 7 * e.clen_freq[18]
}

fn stored_cost(e: *Deflater, n: i64) -> i64 {
    let chunks = if n == 0 { 1 } else { (n + 65534) / 65535 }
    3 + (8 - (codec.pending_bits(e.out) + 3) % 8) % 8 + 32 + 40 * (chunks - 1) + 8 * n
}

fn write_stored(e: *Deflater, raw: []u8, last: bool) {
    var at = 0
    for {
        let n = if raw.len - at > 65535 { 65535 } else { raw.len - at }
        let final = last && at + n == raw.len
        codec.put_bits(e.out, if final { 1 } else { 0 }, 3)
        codec.align(e.out)
        codec.put_bits(e.out, n | (~n & 0xFFFF) << 16, 32)
        codec.put_bytes(e.out, raw[at..at + n])
        at += n
        if at == raw.len {
            break
        }
    }
}

fn write_symbols(e: *Deflater, lit: *codec.Code, dist: *codec.Code) {
    let t = e.tables
    let syms = e.syms
    let out = e.out
    for i in 0..e.nsyms {
        let v = syms[i]
        if v & 0x80000000 == 0 {
            codec.put_bits(out, i64(lit.codes[v]), i64(lit.lens[v]))
            continue
        }
        let length = i64(v >> 16 & 0xFF) + 3
        let distance = i64(v & 0xFFFF) + 1
        let ls = e.len_sym[length]
        let lc = ls - 257
        let ln = i64(lit.lens[ls])
        codec.put_bits(out, i64(lit.codes[ls]) | (length - t.len_base[lc]) << ln, ln + t.len_extra[lc])
        let ds = distance_symbol(e, distance)
        let dn = i64(dist.lens[ds])
        codec.put_bits(out, i64(dist.codes[ds]) | (distance - t.dist_base[ds]) << dn, dn + t.dist_extra[ds])
    }
    codec.put_bits(out, i64(lit.codes[256]), i64(lit.lens[256]))
}

fn write_dynamic(e: *Deflater, hlit: i64, hdist: i64, hclen: i64, last: bool) {
    codec.put_bits(e.out, if last { 5 } else { 4 }, 3)
    codec.put_bits(e.out, hlit - 257, 5)
    codec.put_bits(e.out, hdist - 1, 5)
    codec.put_bits(e.out, hclen - 4, 4)
    let order = e.tables.order
    for i in 0..hclen {
        codec.put_bits(e.out, i64(e.clen.lens[order[i]]), 3)
    }
    for k in 0..e.nrle {
        let sym = e.rle[k]
        codec.put_bits(e.out, i64(e.clen.codes[sym]), i64(e.clen.lens[sym]))
        if sym == 16 {
            codec.put_bits(e.out, i64(e.rle_extra[k]), 2)
        } else if sym == 17 {
            codec.put_bits(e.out, i64(e.rle_extra[k]), 3)
        } else if sym == 18 {
            codec.put_bits(e.out, i64(e.rle_extra[k]), 7)
        }
    }
    write_symbols(e, e.lit, e.dist)
}

fn write_compressed(e: *Deflater, raw: []u8, last: bool) {
    let b = e.builder
    e.lit_freq[256] = 1
    let extra = extra_bits(e)
    huffman(b, e.lit_freq, e.lit, 15)
    huffman(b, e.dist_freq, e.dist, 15)
    let hlit = trimmed(e.lit.lens, 257)
    let hdist = trimmed(e.dist.lens, 1)
    rle(e, hlit, hdist)
    huffman(b, e.clen_freq, e.clen, 7)
    var hclen = 19
    for hclen > 4 && e.clen.lens[e.tables.order[hclen - 1]] == 0 {
        hclen -= 1
    }
    let dynamic = 17 + 3 * hclen + rle_cost(e) + codec.code_cost(e.lit_freq, e.lit) + codec.code_cost(e.dist_freq, e.dist) + extra
    let fixed = 3 + codec.code_cost(e.lit_freq, e.fixed_lit) + codec.code_cost(e.dist_freq, e.fixed_dist) + extra
    let stored = stored_cost(e, raw.len)
    if stored < fixed && stored < dynamic {
        write_stored(e, raw, last)
    } else if fixed <= dynamic {
        codec.put_bits(e.out, if last { 3 } else { 2 }, 3)
        write_symbols(e, e.fixed_lit, e.fixed_dist)
    } else {
        write_dynamic(e, hlit, hdist, hclen, last)
    }
}

fn emit_block(e: *Deflater, last: bool) {
    let raw = e.win[e.block_start - e.base..e.covered - e.base]
    if e.level == 0 {
        write_stored(e, raw, last)
    } else {
        write_compressed(e, raw, last)
    }
    for i in 0..286 {
        e.lit_freq[i] = 0
    }
    for i in 0..30 {
        e.dist_freq[i] = 0
    }
    e.nsyms = 0
    e.block_start = e.covered
}

fn feed(e: *Deflater, data: []u8) {
    match e.format {
        Raw => {}
        Zlib => {
            e.adler = hash.adler32_update(e.adler, data)
        }
        Gzip => hash.crc32_update(e.crc, data)
    }
    e.size += data.len
    var rest = data
    for rest.len > 0 {
        if e.end - e.base == e.win.len {
            slide_window(e)
        }
        let n = __memmove(e.win[e.end - e.base..], rest)
        e.end += n
        rest = rest[n..]
        process(e, false)
    }
}

fn sync(e: *Deflater) {
    process(e, true)
    if e.covered > e.block_start {
        emit_block(e, false)
    }
    codec.put_bits(e.out, 0, 3)
    codec.align(e.out)
    codec.put_bits(e.out, 0xFFFF0000, 32)
}

fn close(e: *Deflater) {
    process(e, true)
    emit_block(e, true)
    codec.align(e.out)
    match e.format {
        Raw => {}
        Zlib => {
            let a = i64(e.adler)
            codec.put_bits(e.out, a >> 24 | (a >> 8 & 0xFF00) | (a << 8 & 0xFF0000) | (a & 0xFF) << 24, 32)
        }
        Gzip => {
            codec.put_bits(e.out, i64(hash.crc32_sum(e.crc)), 32)
            codec.put_bits(e.out, e.size & 0xFFFFFFFF, 32)
        }
    }
}

fn encode_buffer(data: []u8, format: Format, level: i64) -> []u8 {
    let e = deflater(format, level, data.len / 2 + 64)
    feed(e, data)
    close(e)
    codec.contents(e.out)
}

fn drain(e: *Encoder) ! io.Error {
    let ready = codec.drain(e.core.out)
    if ready.len > 0 {
        e.sink(ready)?
    }
}

/// Compresses `data` and passes the compressed bytes that are ready to the encoder's `sink`, updating the checksum for the zlib and gzip formats.
///
/// Input is buffered, so a call can produce no output. Fails with `Invalid` after `finish`, and with any error `sink` returns.
pub fn encode(e: *Encoder, data: []u8) ! io.Error {
    if e.finished {
        fail Invalid
    }
    var rest = data
    for rest.len > 0 {
        let n = math.min(rest.len, 32768)
        feed(e.core, rest[..n])
        drain(e)?
        rest = rest[n..]
    }
}

/// Writes the buffered input and an empty stored block that pads the output to a byte boundary, so a decoder can read everything encoded so far.
///
/// Fails with `Invalid` after `finish`, and with any error `sink` returns.
pub fn flush(e: *Encoder) ! io.Error {
    if e.finished {
        fail Invalid
    }
    sync(e.core)
    drain(e)?
}

/// Writes the buffered input, the final block and, for zlib and gzip, the checksum trailer.
///
/// Fails with `Invalid` when the stream is already finished, and with any error `sink` returns.
pub fn finish(e: *Encoder) ! io.Error {
    if e.finished {
        fail Invalid
    }
    close(e.core)
    e.finished = true
    drain(e)?
}
