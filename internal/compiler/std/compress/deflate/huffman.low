struct Code {
    lens: []u8
    codes: []i64
}

struct Builder {
    sorted: []i64
    weight: []i64
    parent: []i64
    counts: []i64
    next: []i64
}

fn code(n: i64) -> Code {
    Code { lens: __make(n), codes: __make(n) }
}

fn builder() -> *Builder {
    new(Builder { sorted: __make(288), weight: __make(576), parent: __make(576), counts: __make(16), next: __make(16) })
}

fn fixed_code(lens: []u8, b: *Builder) -> Code {
    let c = Code { lens, codes: __make(lens.len) }
    assign_codes(b, c)
    c
}

fn assign_codes(b: *Builder, c: Code) {
    let counts = b.counts
    let next = b.next
    for i in 0..16 {
        counts[i] = 0
    }
    for l in c.lens {
        counts[l] += 1
    }
    counts[0] = 0
    var code = 0
    for len in 1..16 {
        code = (code + counts[len - 1]) << 1
        next[len] = code
    }
    for sym, l in c.lens {
        if l != 0 {
            c.codes[sym] = reverse(next[l], i64(l))
            next[l] += 1
        }
    }
}

fn sort_used(b: *Builder, freq: []i64) -> i64 {
    let sorted = b.sorted
    var used = 0
    for sym, f in freq {
        if f == 0 {
            continue
        }
        var j = used
        for j > 0 && freq[sorted[j - 1]] > f {
            sorted[j] = sorted[j - 1]
            j -= 1
        }
        sorted[j] = sym
        used += 1
    }
    used
}

fn tree_depths(b: *Builder, freq: []i64, used: i64) {
    let sorted = b.sorted
    let weight = b.weight
    let parent = b.parent
    for i in 0..used {
        weight[i] = freq[sorted[i]]
    }
    var leaf = 0
    var node = used
    for k in used..2 * used - 1 {
        var a = 0
        if leaf < used && (node >= k || weight[leaf] <= weight[node]) {
            a = leaf
            leaf += 1
        } else {
            a = node
            node += 1
        }
        var z = 0
        if leaf < used && (node >= k || weight[leaf] <= weight[node]) {
            z = leaf
            leaf += 1
        } else {
            z = node
            node += 1
        }
        weight[k] = weight[a] + weight[z]
        parent[a] = k
        parent[z] = k
    }
    let root = 2 * used - 2
    weight[root] = 0
    var i = root - 1
    for i >= 0 {
        weight[i] = weight[parent[i]] + 1
        i -= 1
    }
}

fn limit_lengths(b: *Builder, used: i64, limit: i64) {
    let counts = b.counts
    for i in 0..16 {
        counts[i] = 0
    }
    for i in 0..used {
        let d = b.weight[i]
        counts[if d > limit { limit } else { d }] += 1
    }
    var total = 0
    for len in 1..limit + 1 {
        total += counts[len] << (limit - len)
    }
    for total > 1 << limit {
        counts[limit] -= 1
        var len = limit - 1
        for len > 0 {
            if counts[len] != 0 {
                counts[len] -= 1
                counts[len + 1] += 2
                break
            }
            len -= 1
        }
        total -= 1
    }
}

fn huffman(b: *Builder, freq: []i64, c: Code, limit: i64) {
    let lens = c.lens
    for i in 0..lens.len {
        lens[i] = 0
    }
    let used = sort_used(b, freq)
    if used < 2 {
        let first = if used == 1 { b.sorted[0] } else { 0 }
        lens[first] = 1
        lens[if first == 0 { 1 } else { 0 }] = 1
        assign_codes(b, c)
        return
    }
    tree_depths(b, freq, used)
    limit_lengths(b, used, limit)
    var at = 0
    var len = limit
    for len > 0 {
        for _ in 0..b.counts[len] {
            lens[b.sorted[at]] = u8(len)
            at += 1
        }
        len -= 1
    }
    assign_codes(b, c)
}

fn code_cost(freq: []i64, c: Code) -> i64 {
    var bits = 0
    for sym, f in freq {
        bits += f * i64(c.lens[sym])
    }
    bits
}
