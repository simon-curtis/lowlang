import std/io

/// A growable byte buffer that also packs bits from the least significant end of each byte.
///
/// Every write is infallible, so an encoder core builds its output here and the caller decides when to hand it to a sink. Whole bytes land in `data` as bits are packed, and a partial byte waits in the accumulator until `align` or more bits complete it. Use the byte writes with no bits pending, or after `align`.
pub struct Buffer {
    /// The backing storage. The first `len` bytes are written.
    pub data: []u8
    /// The number of bytes written to `data`.
    pub len: i64
    acc: u64
    count: i64
}

/// Returns an empty buffer with room for `capacity` bytes, and at least `16`.
pub fn buffer(capacity: i64) -> *Buffer {
    new(Buffer { data: __make(if capacity < 16 { 16 } else { capacity }), len: 0, acc: 0, count: 0 })
}

/// Makes room for `n` more bytes after `len`.
pub fn reserve(b: *Buffer, n: i64) {
    if b.len + n <= b.data.len {
        return
    }
    let size = if b.data.len * 2 > b.len + n { b.data.len * 2 } else { b.len + n }
    let grown: []u8 = __make(size)
    __memmove(grown, b.data[..b.len])
    b.data = grown
}

/// Appends the byte `v`.
pub fn put_byte(b: *Buffer, v: u8) {
    if b.len == b.data.len {
        reserve(b, 1)
    }
    b.data[b.len] = v
    b.len += 1
}

/// Appends `data`, after writing any whole bytes still pending in the bit accumulator.
///
/// Call `align` first when a partial byte is pending.
pub fn put_bytes(b: *Buffer, data: []u8) {
    flush_bits(b)
    reserve(b, data.len)
    __memmove(b.data[b.len..], data)
    b.len += data.len
}

/// Appends the low `n` bytes of `v` in little-endian order, for an `n` from 0 to 8.
pub fn put_le(b: *Buffer, v: i64, n: i64) {
    reserve(b, n)
    let data = b.data
    for i in 0..n {
        data[b.len + i] = u8(v >> (8 * i))
    }
    b.len += n
}

/// Appends the low `n` bits of `v`, least significant bit first, for an `n` from 0 to 32.
///
/// Bits of `v` above `n` must be zero.
pub fn put_bits(b: *Buffer, v: i64, n: i64) {
    let acc = b.acc | u64(v) << u64(b.count)
    let count = b.count + n
    if count < 32 {
        b.acc = acc
        b.count = count
        return
    }
    if b.len + 4 > b.data.len {
        reserve(b, 4)
    }
    let data = b.data
    let at = b.len
    data[at] = u8(acc)
    data[at + 1] = u8(acc >> 8)
    data[at + 2] = u8(acc >> 16)
    data[at + 3] = u8(acc >> 24)
    b.len = at + 4
    b.acc = acc >> 32
    b.count = count - 32
}

/// Writes the whole bytes pending in the bit accumulator to `data`, leaving fewer than eight bits.
pub fn flush_bits(b: *Buffer) {
    if b.count < 8 {
        return
    }
    reserve(b, 8)
    let data = b.data
    var acc = b.acc
    var count = b.count
    var at = b.len
    for count >= 8 {
        data[at] = u8(acc)
        acc >>= 8
        count -= 8
        at += 1
    }
    b.acc = acc
    b.count = count
    b.len = at
}

/// Pads with zero bits to the next byte boundary and writes everything pending.
pub fn align(b: *Buffer) {
    flush_bits(b)
    if b.count > 0 {
        put_byte(b, u8(b.acc))
        b.acc = 0
        b.count = 0
    }
}

/// Returns the bytes written so far, not counting bits still pending.
///
/// The slice views the buffer's storage, so a later write or `reset` can change it.
pub fn contents(b: *Buffer) -> []u8 {
    b.data[..b.len]
}

/// Returns the whole bytes ready to send and empties the buffer of them, keeping a partial byte pending.
///
/// The slice is valid until the next write.
pub fn drain(b: *Buffer) -> []u8 {
    flush_bits(b)
    let ready = b.data[..b.len]
    b.len = 0
    ready
}

/// Discards everything written and everything pending, keeping the storage.
pub fn reset(b: *Buffer) {
    b.len = 0
    b.acc = 0
    b.count = 0
}

/// Returns the number of bits waiting in the accumulator, including whole bytes not yet written to `data`.
///
/// The result modulo eight is the position within the current byte.
pub fn pending_bits(b: *Buffer) -> i64 {
    b.count
}

/// Returns a sink function that appends each chunk to `b`, for the one-shot decoders.
pub fn collector(b: *Buffer) -> fn([]u8) ! io.Error {
    fn(chunk) {
        put_bytes(b, chunk)
    }
}
