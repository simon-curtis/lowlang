import std/io

/// The best match a search has found so far.
pub struct Match {
    /// The length in bytes, or the length to beat when the search starts.
    pub len: i64
    /// The distance back from the search position to the start of the match.
    pub off: i64
}

/// A hash chain over a byte history: a table of the latest position for each hash of a few bytes and a ring of the position before each one with the same hash.
///
/// Made by `chain`. Positions are stored one above their value, so zero marks the end of a chain.
pub struct Chain {
    head: []i32
    links: []i32
    mask: i64
    shift_in: u64
    shift_out: u64
}

/// Returns the number of leading bytes at `a` that equal the bytes at `b` in `hist`, up to `limit`.
pub fn match_length(hist: []u8, a: i64, b: i64, limit: i64) -> i64 {
    var n = 0
    for n < limit && hist[a + n] == hist[b + n] {
        n += 1
    }
    n
}

/// Copies `length` bytes from `distance` bytes behind `pos` to `pos` in `out`.
///
/// The ranges can overlap, in which case the copy repeats the last `distance` bytes written, as LZ77 decoders need.
pub fn copy_match(out: []u8, pos: i64, distance: i64, length: i64) {
    let from = pos - distance
    if distance >= length && length > 16 {
        __memmove(out[pos..pos + length], out[from..from + length])
        return
    }
    if length > 16 {
        copy_overlapping(out, pos, distance, length)
        return
    }
    for i in 0..length {
        out[pos + i] = out[from + i]
    }
}

fn copy_overlapping(out: []u8, pos: i64, distance: i64, length: i64) {
    let from = pos - distance
    if distance == 1 {
        let v = out[from]
        for i in pos..pos + length {
            out[i] = v
        }
        return
    }
    var done = 0
    for done < length {
        var k = distance + done
        if k > length - done {
            k = length - done
        }
        __memmove(out[pos + done..pos + done + k], out[from..from + k])
        done += k
    }
}

/// Returns a hash chain that hashes `width` bytes into `hash_bits` bits and remembers the last `1 << link_bits` positions.
///
/// `width` runs from 1 to 8, and positions must be below `2^31`.
pub fn chain(width: i64, hash_bits: i64, link_bits: i64) -> *Chain {
    new(Chain { head: __make(1 << hash_bits), links: __make(1 << link_bits), mask: (1 << link_bits) - 1, shift_in: u64(64 - 8 * width), shift_out: u64(64 - hash_bits) })
}

fn hash_at(c: *Chain, hist: []u8, i: i64) -> i64 {
    i64((io.u64_le(hist, i) << c.shift_in) * 0x9E3779B185EBCA87 >> c.shift_out)
}

/// Adds position `i` of `hist` to the chain.
///
/// Reads 8 bytes from `i`, so `i + 8` must not pass the end of `hist`.
pub fn link(c: *Chain, hist: []u8, i: i64) {
    let h = hash_at(c, hist, i)
    c.links[i & c.mask] = c.head[h]
    c.head[h] = i32(i + 1)
}

/// Walks the chain for position `p` of `hist` and records in `found` any match longer than `found.len`, nearest candidates first.
///
/// At most `tries` candidates are checked, none more than `window` bytes back or older than the chain remembers, and a match may not reach past `end`. The walk stops once a match of `nice` bytes is found.
pub fn walk(c: *Chain, hist: []u8, p: i64, end: i64, window: i64, nice: i64, tries: i64, found: *Match) {
    let links = c.links
    let mask = c.mask
    var floor = p - window
    if p - links.len > floor {
        floor = p - links.len
    }
    if floor < -1 {
        floor = -1
    }
    let most = end - p
    var best = found.len
    var cand = i64(c.head[hash_at(c, hist, p)]) - 1
    var left = tries
    for left > 0 && cand > floor && best < most && best < nice {
        if hist[cand + best] == hist[p + best] {
            let n = match_length(hist, p, cand, most)
            if n > best {
                best = n
                found.len = n
                found.off = p - cand
            }
        }
        cand = i64(links[cand & mask]) - 1
        left -= 1
    }
}

fn shift_table(t: []i32, delta: i32) {
    for i in 0..t.len {
        let v = t[i] - delta
        t[i] = if v > 0 { v } else { 0 }
    }
}

/// Moves every remembered position back by `delta`, for a history that has slid forward by that much, and forgets those that fall off the front.
pub fn slide(c: *Chain, delta: i64) {
    shift_table(c.head, i32(delta))
    shift_table(c.links, i32(delta))
}
