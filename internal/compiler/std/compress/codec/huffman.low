/// The code lengths and bit patterns of a canonical Huffman code, ready for `put_code`.
///
/// Made by `code` and filled by `build`. A pattern is stored bit-reversed, so writing it least significant bit first emits the code from its first bit.
pub struct Code {
    /// The length in bits of each symbol's code, `0` for a symbol that does not occur.
    pub lens: []u8
    /// The bit-reversed pattern of each symbol's code.
    pub codes: []u32
    /// The number of symbols that occur.
    pub used: i64
    /// The first symbol that occurs, or `0` when none does.
    pub first: i64
}

/// The scratch space `build` and `lengths` need, sized for an alphabet.
pub struct Builder {
    sorted: []i64
    weight: []i64
    parent: []i64
    counts: []i64
    next: []i64
}

/// Returns a code for an alphabet of `n` symbols with every length zero.
pub fn code(n: i64) -> *Code {
    new(Code { lens: __make(n), codes: __make(n), used: 0, first: 0 })
}

/// Returns scratch space for building codes over alphabets of up to `max_symbols` symbols.
pub fn builder(max_symbols: i64) -> *Builder {
    new(Builder { sorted: __make(max_symbols), weight: __make(2 * max_symbols), parent: __make(2 * max_symbols), counts: __make(16), next: __make(16) })
}

/// Returns the low `len` bits of `code` in reverse order.
pub fn reverse_bits(code: i64, len: i64) -> i64 {
    var v = code
    var r = 0
    for _ in 0..len {
        r = r << 1 | (v & 1)
        v >>= 1
    }
    r
}

/// Fills `codes` with the bit-reversed canonical codes for the lengths `lens`, shorter codes first and equal lengths in symbol order.
///
/// Lengths run from `0`, which skips the symbol, to `15`.
pub fn assign_codes(b: *Builder, lens: []u8, codes: []u32) {
    let counts = b.counts
    let next = b.next
    for i in 0..16 {
        counts[i] = 0
    }
    for l in lens {
        counts[l] += 1
    }
    counts[0] = 0
    var code = 0
    for len in 1..16 {
        code = (code + counts[len - 1]) << 1
        next[len] = code
    }
    for sym, l in lens {
        if l != 0 {
            codes[sym] = u32(reverse_bits(next[l], i64(l)))
            next[l] += 1
        }
    }
}

fn sort_used(b: *Builder, freq: []i64) -> i64 {
    let sorted = b.sorted
    var used = 0
    for sym, f in freq {
        if f == 0 {
            continue
        }
        var j = used
        for j > 0 && freq[sorted[j - 1]] > f {
            sorted[j] = sorted[j - 1]
            j -= 1
        }
        sorted[j] = sym
        used += 1
    }
    used
}

fn tree_depths(b: *Builder, freq: []i64, used: i64) {
    let sorted = b.sorted
    let weight = b.weight
    let parent = b.parent
    for i in 0..used {
        weight[i] = freq[sorted[i]]
    }
    var leaf = 0
    var node = used
    for k in used..2 * used - 1 {
        var a = 0
        if leaf < used && (node >= k || weight[leaf] <= weight[node]) {
            a = leaf
            leaf += 1
        } else {
            a = node
            node += 1
        }
        var z = 0
        if leaf < used && (node >= k || weight[leaf] <= weight[node]) {
            z = leaf
            leaf += 1
        } else {
            z = node
            node += 1
        }
        weight[k] = weight[a] + weight[z]
        parent[a] = k
        parent[z] = k
    }
    let root = 2 * used - 2
    weight[root] = 0
    var i = root - 1
    for i >= 0 {
        weight[i] = weight[parent[i]] + 1
        i -= 1
    }
}

fn limit_lengths(b: *Builder, used: i64, limit: i64) {
    let counts = b.counts
    for i in 0..16 {
        counts[i] = 0
    }
    for i in 0..used {
        let d = b.weight[i]
        counts[if d > limit { limit } else { d }] += 1
    }
    var total = 0
    for len in 1..limit + 1 {
        total += counts[len] << (limit - len)
    }
    for total > 1 << limit {
        counts[limit] -= 1
        var len = limit - 1
        for len > 0 {
            if counts[len] != 0 {
                counts[len] -= 1
                counts[len + 1] += 2
                break
            }
            len -= 1
        }
        total -= 1
    }
}

/// Fills `lens` with the lengths of a Huffman code for the symbol frequencies `freq`, none longer than `limit` bits, and returns the number of symbols with a nonzero frequency.
///
/// The code is complete when two or more symbols occur. With fewer than two the lengths stay zero and the caller picks the format's form for a one-symbol code. `limit` is at most `15`.
pub fn lengths(b: *Builder, freq: []i64, lens: []u8, limit: i64) -> i64 {
    for i in 0..lens.len {
        lens[i] = 0
    }
    let used = sort_used(b, freq)
    if used < 2 {
        return used
    }
    tree_depths(b, freq, used)
    limit_lengths(b, used, limit)
    var at = 0
    var len = limit
    for len > 0 {
        for _ in 0..b.counts[len] {
            lens[b.sorted[at]] = u8(len)
            at += 1
        }
        len -= 1
    }
    used
}

/// Builds the code for `freq` into `c`, with no code longer than `limit` bits.
///
/// Sets `c.used` and `c.first`. With fewer than two symbols present no lengths are assigned, and the code of `c.first` is `0`.
pub fn build(b: *Builder, freq: []i64, c: *Code, limit: i64) {
    let used = lengths(b, freq, c.lens, limit)
    c.used = used
    c.first = if used > 0 { b.sorted[0] } else { 0 }
    if used < 2 {
        c.codes[c.first] = 0
        return
    }
    assign_codes(b, c.lens, c.codes)
}

/// Returns the total number of bits that coding the symbol counts `freq` takes with the lengths of `c`.
pub fn code_cost(freq: []i64, c: *Code) -> i64 {
    var bits = 0
    for sym, f in freq {
        bits += f * i64(c.lens[sym])
    }
    bits
}

/// Writes the code of `sym` to `out`.
pub fn put_code(out: *Buffer, c: *Code, sym: i64) {
    put_bits(out, i64(c.codes[sym]), i64(c.lens[sym]))
}
