import std/io

/// Writes `v` as a base-128 varint, seven bits per byte with the least significant group first, into `buf` starting at `at`, and returns the position after it.
///
/// A varint takes one to ten bytes, so `buf` needs room for ten from `at`.
pub fn write_varint(buf: []u8, at: i64, v: u64) -> i64 {
    var pos = at
    var rest = v
    for rest >= 0x80 {
        buf[pos] = u8(rest) | 0x80
        rest = rest >> 7
        pos += 1
    }
    buf[pos] = u8(rest)
    pos + 1
}

/// Appends `v` to `out` as a base-128 varint of one to ten bytes.
pub fn put_varint(mut out: []u8, v: u64) {
    let tmp: []u8 = __make(10)
    let n = write_varint(tmp, 0, v)
    io.append(mut out, tmp[..n])
}

/// Reads the varint that starts at `data[at]` and advances `at` past it.
///
/// Fails with `Malformed` when the input ends inside the varint, it runs past `max_bytes` bytes, or the value does not fit in 64 bits. A varint longer than necessary is accepted. `max_bytes` is at most `10`.
pub fn read_varint(data: []u8, mut at: i64, max_bytes: i64) -> u64 ! io.Error {
    var v: u64 = 0
    for i in 0..max_bytes {
        if at >= data.len {
            fail Malformed
        }
        let b = data[at]
        at += 1
        if i == 9 && b > 1 {
            fail Malformed
        }
        v |= u64(b & 0x7F) << u64(7 * i)
        if b < 0x80 {
            return v
        }
    }
    fail Malformed
}
