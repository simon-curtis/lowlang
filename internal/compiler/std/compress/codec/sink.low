import std/io
import std/math

/// Passes the whole bytes ready in `b` to `sink` and empties `b` of them, calling `sink` only when there are some.
///
/// Fails with any error `sink` returns.
pub fn deliver(b: *Buffer, sink: fn([]u8) ! io.Error) ! io.Error {
    let ready = drain(b)
    if ready.len > 0 {
        sink(ready)?
    }
}

/// Calls `step` with consecutive pieces of `data` of at most `size` bytes.
///
/// Fails with the first error `step` returns.
pub fn each_chunk(data: []u8, size: i64, step: fn([]u8) ! io.Error) ! io.Error {
    var rest = data
    for rest.len > 0 {
        let n = math.min(rest.len, size)
        step(rest[..n])?
        rest = rest[n..]
    }
}
