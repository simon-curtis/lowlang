import std/io

/// A streaming encoder over a format's core, made by `encoder`.
///
/// `encode`, `flush` and `finish` run the format's steps on its output buffer and pass the bytes that are ready to `sink`. After `finish`, all three fail with `Invalid`.
pub struct Encoder {
    sink: fn([]u8) ! io.Error
    out: *Buffer
    chunk: i64
    feed: fn([]u8)
    sync: fn()
    close: fn()
    finished: bool
}

/// Returns an encoder that delivers `out` to `sink`.
///
/// `feed` takes at most `chunk` bytes of input, `sync` ends the data written so far on a boundary a decoder can read, and `close` writes the end of the stream. All three write into `out`.
pub fn encoder(out: *Buffer, chunk: i64, sink: fn([]u8) ! io.Error, feed: fn([]u8), sync: fn(), close: fn()) -> *Encoder {
    new(Encoder { sink, out, chunk, feed, sync, close, finished: false })
}

/// Feeds `data` in pieces of at most the encoder's chunk size, passing the output that is ready to the sink after each piece.
///
/// Fails with `Invalid` after `finish`, and with any error the sink returns.
pub fn encode(e: *Encoder, data: []u8) ! io.Error {
    if e.finished {
        fail Invalid
    }
    each_chunk(data, e.chunk, fn(piece) {
        e.feed(piece)
        deliver(e.out, e.sink)?
    })?
}

/// Syncs the format and passes the output to the sink.
///
/// Fails with `Invalid` after `finish`, and with any error the sink returns.
pub fn flush(e: *Encoder) ! io.Error {
    if e.finished {
        fail Invalid
    }
    e.sync()
    deliver(e.out, e.sink)?
}

/// Closes the format, marks the encoder finished and passes the output to the sink.
///
/// Fails with `Invalid` when the encoder is already finished, and with any error the sink returns.
pub fn finish(e: *Encoder) ! io.Error {
    if e.finished {
        fail Invalid
    }
    e.close()
    e.finished = true
    deliver(e.out, e.sink)?
}
