import std/compress/codec
import std/hash
import std/io
import std/math

/// A streaming LZ4 frame encoder made by `encoder`.
///
/// `encode` takes input in any chunking, `flush` writes the buffered input as blocks, and `finish` writes the end mark and the content checksum. After `finish`, `encode`, `flush` and `finish` fail with `Invalid`. The frame uses linked blocks of up to 64 KiB. A chunk is valid only during the call to `sink`.
pub struct Encoder {
    core: *Compressor
    sink: fn([]u8) ! io.Error
    finished: bool
}

struct Compressor {
    depth: i64
    lazy: bool
    skip: i64
    win: *codec.History
    content_size: i64
    started: bool
    sum: *hash.Xxh32
    out: *codec.Buffer
    found: *codec.Match
}

fn block_max() -> i64 {
    1 << 16
}

/// Returns an encoder that writes one LZ4 frame to `sink`.
///
/// `level` is clamped to `1..12`; higher levels search more candidates and, from `3`, parse lazily. The frame header carries no content size.
pub fn encoder(level: i64, sink: fn([]u8) ! io.Error) -> *Encoder {
    let core = compressor(level, -1, block_max() + block_max() / 255 + 64)
    new(Encoder { core, sink, finished: false })
}

fn compressor(level: i64, content_size: i64, capacity: i64) -> *Compressor {
    let l = math.clamp(level, 1, 12)
    let span = if content_size >= 0 && content_size < 1 << 30 { if content_size > 0 { content_size } else { 1 } } else { 2 * history() + 2 * block_max() }
    new(Compressor {
        depth: 1 << (l - 1)
        lazy: l >= 3
        skip: if l < 2 { 6 } else { 8 }
        win: codec.history(history(), span, 4, 16, 16)
        content_size
        started: false
        sum: hash.xxh32_new(0)
        out: codec.buffer(capacity)
        found: new(codec.Match { len: 0, off: 0 })
    })
}

fn search(e: *Compressor, c: *codec.Chain, p: i64, match_end: i64, tries: i64) {
    codec.walk(c, e.win.data, p, match_end, e.win.window, match_end - p, tries, e.found)
}

fn find(e: *Compressor, p: i64, match_end: i64) {
    codec.index_to(e.win, p, e.depth > 1)
    e.found.len = 3
    e.found.off = 0
    if e.depth > 1 {
        search(e, e.win.long, p, match_end, e.depth)
        search(e, e.win.short, p, match_end, if e.depth > 8 { e.depth / 4 } else { 2 })
    } else {
        search(e, e.win.short, p, match_end, e.depth)
    }
    if e.found.len < 4 {
        e.found.len = 0
    }
}

fn write_length(data: []u8, at: i64, n: i64) -> i64 {
    var pos = at
    var rest = n - 15
    for rest >= 255 {
        data[pos] = 255
        pos += 1
        rest -= 255
    }
    data[pos] = u8(rest)
    pos + 1
}

fn sequence(e: *Compressor, anchor: i64, p: i64, off: i64, len: i64) {
    let out = e.out
    let ll = p - anchor
    let ml = if len > 0 { len - 4 } else { 0 }
    codec.reserve(out, ll + ll / 255 + ml / 255 + 8)
    let data = out.data
    var at = out.len
    let token = (if ll < 15 { ll } else { 15 }) << 4 | if ml < 15 { ml } else { 15 }
    data[at] = u8(token)
    at += 1
    if ll >= 15 {
        at = write_length(data, at, ll)
    }
    io.copy(data[at..], e.win.data[anchor..p])
    at += ll
    if len > 0 {
        data[at] = u8(off)
        data[at + 1] = u8(off >> 8)
        at += 2
        if ml >= 15 {
            at = write_length(data, at, ml)
        }
    }
    out.len = at
}

fn compress_block(e: *Compressor, start: i64, end: i64) {
    let hist = e.win.data
    let found = e.found
    let match_end = end - 5
    let limit = end - 12
    var anchor = start
    var p = start
    for p < limit {
        find(e, p, match_end)
        var len = found.len
        var off = found.off
        if len == 0 {
            p += 1 + ((p - anchor) >> e.skip)
            continue
        }
        if e.lazy && p + 1 < limit {
            find(e, p + 1, match_end)
            if found.len > len + 1 {
                p += 1
                len = found.len
                off = found.off
            }
        }
        let back = codec.extend_back(e.win, p, anchor, off)
        p -= back
        len += back
        sequence(e, anchor, p, off, len)
        p += len
        anchor = p
    }
    sequence(e, anchor, end, 0, 0)
}

fn start_frame(e: *Compressor) {
    if e.started {
        return
    }
    e.started = true
    let out = e.out
    let mark = out.len
    codec.put_le(out, 0x184D2204, 4)
    let sized = e.content_size >= 0
    codec.put_byte(out, if sized { 0x4C } else { 0x44 })
    codec.put_byte(out, 0x40)
    if sized {
        codec.put_le(out, e.content_size, 8)
    }
    let sum = hash.xxh32(codec.contents(out)[mark + 4..], 0)
    codec.put_byte(out, u8(sum >> 8))
}

fn emit_block(e: *Compressor, end: i64) {
    start_frame(e)
    let out = e.out
    let start = e.win.pos
    let size = end - start
    let mark = out.len
    codec.put_le(out, 0, 4)
    var packed = size
    if size >= 13 {
        compress_block(e, start, end)
        packed = out.len - mark - 4
    }
    if packed >= size {
        out.len = mark + 4
        codec.put_bytes(out, e.win.data[start..end])
        io.set_le32(out.data, mark, size | 1 << 31)
    } else {
        io.set_le32(out.data, mark, packed)
    }
    e.win.pos = end
}

fn feed(e: *Compressor, data: []u8) {
    var at = 0
    for at < data.len {
        let n = codec.append(e.win, data[at..])
        hash.xxh32_update(e.sum, data[at..at + n])
        at += n
        for e.win.fill - e.win.pos >= block_max() {
            emit_block(e, e.win.pos + block_max())
        }
    }
}

fn settle(e: *Compressor) {
    for e.win.pos < e.win.fill {
        emit_block(e, math.min(e.win.fill, e.win.pos + block_max()))
    }
}

fn close(e: *Compressor) {
    settle(e)
    start_frame(e)
    codec.put_le(e.out, 0, 4)
    codec.put_le(e.out, i64(hash.xxh32_sum(e.sum)), 4)
}

/// Compresses `data` and passes each completed 64 KiB block to the encoder's `sink`.
///
/// Input is buffered until a block is full, so a call can produce no output. Fails with `Invalid` after `finish`, and with any error `sink` returns.
pub fn encode(e: *Encoder, data: []u8) ! io.Error {
    if e.finished {
        fail Invalid
    }
    codec.each_chunk(data, block_max(), fn(chunk) {
        feed(e.core, chunk)
        codec.deliver(e.core.out, e.sink)?
    })?
}

/// Writes the buffered input as blocks, so a decoder can read everything encoded so far.
///
/// Fails with `Invalid` after `finish`, and with any error `sink` returns.
pub fn flush(e: *Encoder) ! io.Error {
    if e.finished {
        fail Invalid
    }
    settle(e.core)
    codec.deliver(e.core.out, e.sink)?
}

/// Writes the buffered input, the end mark and the content checksum.
///
/// An encoder that received no input still writes a complete empty frame. Fails with `Invalid` when the stream is already finished, and with any error `sink` returns.
pub fn finish(e: *Encoder) ! io.Error {
    if e.finished {
        fail Invalid
    }
    close(e.core)
    e.finished = true
    codec.deliver(e.core.out, e.sink)?
}

/// Returns `data` compressed as one LZ4 frame.
///
/// `level` is clamped to `1..12`. The frame header records the content size.
pub fn compress(data: []u8, level: i64) -> []u8 {
    let c = compressor(level, data.len, data.len + data.len / 255 + 64)
    feed(c, data)
    close(c)
    codec.contents(c.out)
}
