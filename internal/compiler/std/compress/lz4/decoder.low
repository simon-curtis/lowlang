import std/compress/codec
import std/hash
import std/io

struct Decoder {
    r: *io.Reader
    sink: fn([]u8) ! io.Error
    limit: i64
    total: i64
    head: []u8
    src: []u8
    hist: []u8
    pos: i64
    emitted: i64
    sum: *hash.Xxh32
}

fn history() -> i64 {
    1 << 16
}

/// Decodes LZ4 frames from `r` and passes the decoded bytes to `sink` in chunks until the input ends.
///
/// Concatenated frames are decoded in turn and skippable frames are ignored. Content and block checksums are verified. Input with no frame is `Malformed`; the legacy frame format and frames that need a dictionary are `Unsupported`.
/// Fails with `TooLarge` when the output would exceed `limit` bytes, `Malformed` when the input is invalid or truncated, and with any error `r` or `sink` returns. A chunk is valid only during the call to `sink`.
pub fn decode(r: *io.Reader, sink: fn([]u8) ! io.Error, limit: i64) ! io.Error {
    let d = new(Decoder {
        r
        sink
        limit
        total: 0
        head: io.buffer(32)
        src: []
        hist: []
        pos: 0
        emitted: 0
        sum: hash.xxh32_new(0)
    })
    var frames = 0
    for {
        if !codec.read_head(r, d.head[..4])? {
            break
        }
        let magic = io.le32(d.head, 0)
        if magic == 0x184D2204 {
            frame(d)?
        } else if magic & 0xFFFFFFF0 == 0x184D2A50 {
            skip_frame(d)?
        } else if magic == 0x184C2102 {
            fail Unsupported
        } else {
            fail Malformed
        }
        frames += 1
    }
    if frames == 0 {
        fail Malformed
    }
}

fn skip_frame(d: *Decoder) ! io.Error {
    codec.read_full(d.r, d.head[..4])?
    codec.skip(d.r, io.le32(d.head, 0))?
}

fn frame(d: *Decoder) ! io.Error {
    codec.read_full(d.r, d.head[..2])?
    let flg = i64(d.head[0])
    let bd = i64(d.head[1])
    if flg >> 6 != 1 || flg & 2 != 0 || bd & 0x8F != 0 {
        fail Malformed
    }
    let size_id = bd >> 4 & 7
    if size_id < 4 {
        fail Malformed
    }
    let independent = flg >> 5 & 1 == 1
    let block_sums = flg >> 4 & 1 == 1
    let sized = flg >> 3 & 1 == 1
    let content_sum = flg >> 2 & 1 == 1
    let dict = flg & 1 == 1
    var at = 2
    if sized {
        at += 8
    }
    if dict {
        at += 4
    }
    codec.read_full(d.r, d.head[2..at + 1])?
    if i64(hash.xxh32(d.head[..at], 0) >> 8 & 0xFF) != i64(d.head[at]) {
        fail Malformed
    }
    if dict {
        fail Unsupported
    }
    var expected = -1
    if sized {
        expected = io.le64(d.head, 2)
        if expected < 0 || expected > d.limit - d.total {
            fail TooLarge
        }
    }
    let block_max = 1 << (8 + 2 * size_id)
    if d.src.len < block_max + 4 {
        d.src = io.buffer(block_max + 4)
    }
    if d.hist.len < history() + 2 * block_max {
        d.hist = io.buffer(history() + 2 * block_max)
    }
    d.pos = 0
    d.emitted = 0
    if content_sum {
        d.sum = hash.xxh32_new(0)
    }
    let start_total = d.total
    for {
        codec.read_full(d.r, d.head[..4])?
        let word = io.le32(d.head, 0)
        if word == 0 {
            break
        }
        let raw = word >> 31 == 1
        let size = word & 0x7FFFFFFF
        if size > block_max {
            fail Malformed
        }
        let stored = if block_sums { size + 4 } else { size }
        if d.pos + block_max + 4 > d.hist.len {
            let keep = if d.pos < history() { d.pos } else { history() }
            io.copy(d.hist, d.hist[d.pos - keep..d.pos])
            d.pos = keep
            d.emitted = keep
        }
        let data = if raw { d.hist[d.pos..d.pos + stored] } else { d.src[..stored] }
        codec.read_full(d.r, data)?
        if block_sums && i64(hash.xxh32(data[..size], 0)) != io.le32(data, size) {
            fail Malformed
        }
        if raw {
            d.pos += size
        } else {
            let lowest = if independent { d.pos } else { 0 }
            d.pos = decode_block(d.src, size, d.hist, d.pos, d.pos + block_max, lowest)?
        }
        emit(d, content_sum)?
    }
    if content_sum {
        codec.read_full(d.r, d.head[..4])?
        if i64(hash.xxh32_sum(d.sum)) != io.le32(d.head, 0) {
            fail Malformed
        }
    }
    if sized && d.total - start_total != expected {
        fail Malformed
    }
}

fn emit(d: *Decoder, checksum: bool) ! io.Error {
    let chunk = d.hist[d.emitted..d.pos]
    d.emitted = d.pos
    if chunk.len == 0 {
        return
    }
    d.total += chunk.len
    if d.total > d.limit {
        fail TooLarge
    }
    if checksum {
        hash.xxh32_update(d.sum, chunk)
    }
    d.sink(chunk)?
}

fn extend(src: []u8, n: i64, mut ip: i64, base: i64) -> i64 ! io.Error {
    var v = base
    if base == 15 {
        for {
            if ip >= n {
                fail Malformed
            }
            let b = i64(src[ip])
            ip += 1
            v += b
            if b != 255 {
                break
            }
        }
    }
    v
}

fn decode_block(src: []u8, n: i64, out: []u8, start: i64, end: i64, lowest: i64) -> i64 ! io.Error {
    var ip = 0
    var op = start
    for {
        if ip >= n {
            fail Malformed
        }
        let token = i64(src[ip])
        ip += 1
        let ll = extend(src, n, mut ip, token >> 4)?
        if ip + ll > n || op + ll > end {
            fail Malformed
        }
        io.copy(out[op..op + ll], src[ip..ip + ll])
        ip += ll
        op += ll
        if ip == n {
            return op
        }
        if ip + 2 > n {
            fail Malformed
        }
        let offset = io.le16(src, ip)
        ip += 2
        let ml = extend(src, n, mut ip, token & 15)? + 4
        if offset == 0 || offset > op - lowest || op + ml > end {
            fail Malformed
        }
        codec.copy_match(out, op, offset, ml)
        op += ml
    }
}

/// Returns the bytes decoded from LZ4 frames in `data`.
///
/// Concatenated frames are decoded in turn and skippable frames are ignored. Input with no frame is `Malformed`; the legacy frame format and frames that need a dictionary are `Unsupported`.
/// Fails with `TooLarge` when the output would exceed `limit` bytes and with `Malformed` when the input is invalid or truncated.
pub fn decompress(data: []u8, limit: i64) -> []u8 ! io.Error {
    codec.decompress(data, limit, decode)?
}
