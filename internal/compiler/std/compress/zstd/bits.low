import std/bits
import std/io

struct BitIn {
    buf: []u8
    start: i64
    ptr: i64
    bits: u64
    used: i64
}

struct BitOut {
    buf: []u8
    len: i64
    bits: u64
    count: i64
}

fn highbit(v: u64) -> i64 {
    if v == 0 { 0 } else { 63 - bits.leading_zeros(v) }
}

fn load64(b: []u8, at: i64) -> u64 {
    u64(b[at]) | u64(b[at + 1]) << 8 | u64(b[at + 2]) << 16 | u64(b[at + 3]) << 24 | u64(b[at + 4]) << 32 | u64(b[at + 5]) << 40 | u64(b[at + 6]) << 48 | u64(b[at + 7]) << 56
}

fn bit_in(buf: []u8, start: i64, end: i64) -> BitIn ! io.Error {
    if end <= start || end > buf.len || buf[end - 1] == 0 {
        fail Malformed
    }
    let padding = 8 - highbit(u64(buf[end - 1]))
    let size = end - start
    if size >= 8 {
        return BitIn { buf, start, ptr: end - 8, bits: load64(buf, end - 8), used: padding }
    }
    var bits: u64 = 0
    for i in 0..size {
        bits |= u64(buf[start + i]) << (8 * i)
    }
    BitIn { buf, start, ptr: start, bits, used: padding + (8 - size) * 8 }
}

fn refill(mut b: BitIn) {
    var step = b.used >> 3
    if b.ptr - step < b.start {
        step = b.ptr - b.start
    }
    if step > 0 {
        b.ptr -= step
        b.used -= step * 8
        b.bits = load64(b.buf, b.ptr)
    }
}

fn read_bits(mut b: BitIn, n: i64) -> i64 {
    if b.used + n > 64 {
        refill(mut b)
    }
    let v = b.bits << b.used >> (64 - n)
    b.used += n
    i64(v)
}

fn bits_left(b: BitIn) -> i64 {
    (b.ptr - b.start) * 8 + 64 - b.used
}

fn bit_out(size: i64) -> BitOut {
    BitOut { buf: io.buffer(size), len: 0, bits: 0, count: 0 }
}

fn reset_bits(mut w: BitOut) {
    w.len = 0
    w.bits = 0
    w.count = 0
}

fn reserve(mut w: BitOut, n: i64) {
    if w.len + n > w.buf.len {
        let bigger = io.buffer(w.buf.len * 2 + n + 64)
        io.copy(bigger, w.buf[..w.len])
        w.buf = bigger
    }
}

fn put_byte(mut w: BitOut, v: u8) {
    reserve(mut w, 1)
    w.buf[w.len] = v
    w.len += 1
}

fn put_bytes(mut w: BitOut, data: []u8) {
    reserve(mut w, data.len)
    io.copy(w.buf[w.len..], data)
    w.len += data.len
}

fn put_le(mut w: BitOut, v: i64, n: i64) {
    reserve(mut w, n)
    for i in 0..n {
        w.buf[w.len + i] = u8(v >> (8 * i))
    }
    w.len += n
}

fn add_bits(mut w: BitOut, value: u64, n: i64) {
    if w.count + n > 64 {
        flush_bits(mut w)
    }
    w.bits |= (value & ((u64(1) << n) - 1)) << w.count
    w.count += n
}

fn flush_bits(mut w: BitOut) {
    reserve(mut w, 8)
    var bits = w.bits
    var count = w.count
    let buf = w.buf
    var len = w.len
    for count >= 8 {
        buf[len] = u8(bits)
        bits >>= 8
        count -= 8
        len += 1
    }
    w.bits = bits
    w.count = count
    w.len = len
}

fn align_bits(mut w: BitOut) {
    flush_bits(mut w)
    if w.count > 0 {
        put_byte(mut w, u8(w.bits))
        w.bits = 0
        w.count = 0
    }
}

fn close_bits(mut w: BitOut) {
    add_bits(mut w, 1, 1)
    align_bits(mut w)
}
