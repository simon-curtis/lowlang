import std/compress/codec
import std/math
import std/slices

const max_encoded_length = 17

fn make_lengths(freq: []i64, lens: []u8, alpha: i64) {
    let weight: []i64 = __make(alpha)
    for i in 0..alpha {
        weight[i] = if freq[i] == 0 { 1 } else { freq[i] }
    }
    var keys: []i64 = __make(alpha)
    let node: []i64 = __make(2 * alpha)
    let parent: []i64 = __make(2 * alpha)
    for {
        for i in 0..alpha {
            keys[i] = weight[i] << 9 | i
        }
        keys |> slices.sort()
        for i in 0..alpha {
            node[i] = keys[i] >> 9
        }
        codec.leaf_depths(node, parent, alpha)
        var deepest = 0
        for leaf in 0..alpha {
            let depth = node[leaf]
            lens[keys[leaf] & 511] = u8(depth)
            deepest = math.max(deepest, depth)
        }
        if deepest <= max_encoded_length {
            return
        }
        for i in 0..alpha {
            weight[i] = 1 + weight[i] / 2
        }
    }
}



fn assign_codes(lens: []u8, codes: []i64, alpha: i64) {
    var min = 32
    var max = 0
    for i in 0..alpha {
        let l = i64(lens[i])
        if l < min {
            min = l
        }
        if l > max {
            max = l
        }
    }
    var code = 0
    for len in min..max + 1 {
        for i in 0..alpha {
            if i64(lens[i]) == len {
                codes[i] = code
                code += 1
            }
        }
        code <<= 1
    }
}
