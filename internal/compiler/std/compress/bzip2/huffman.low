import std/slices

fn max_encoded_length() -> i64 {
    17
}

fn make_lengths(freq: []i64, lens: []u8, alpha: i64) {
    let weight: []i64 = __make(alpha)
    for i in 0..alpha {
        weight[i] = if freq[i] == 0 { 1 } else { freq[i] }
    }
    var keys: []i64 = __make(alpha)
    let node: []i64 = __make(2 * alpha)
    let parent: []i64 = __make(2 * alpha)
    for {
        for i in 0..alpha {
            keys[i] = weight[i] << 9 | i
        }
        keys |> slices.sort()
        for i in 0..alpha {
            node[i] = keys[i] >> 9
        }
        join_nodes(node, parent, alpha)
        if assign_depths(keys, node, parent, lens, alpha) <= max_encoded_length() {
            return
        }
        for i in 0..alpha {
            weight[i] = 1 + weight[i] / 2
        }
    }
}

fn join_nodes(node: []i64, parent: []i64, alpha: i64) {
    var leaf = 0
    var next = alpha
    for k in alpha..2 * alpha - 1 {
        var a = 0
        if leaf < alpha && (next >= k || node[leaf] <= node[next]) {
            a = leaf
            leaf += 1
        } else {
            a = next
            next += 1
        }
        var b = 0
        if leaf < alpha && (next >= k || node[leaf] <= node[next]) {
            b = leaf
            leaf += 1
        } else {
            b = next
            next += 1
        }
        node[k] = node[a] + node[b]
        parent[a] = k
        parent[b] = k
    }
}

fn assign_depths(keys: []i64, node: []i64, parent: []i64, lens: []u8, alpha: i64) -> i64 {
    let root = 2 * alpha - 2
    node[root] = 0
    var i = root - 1
    for i >= 0 {
        node[i] = node[parent[i]] + 1
        i -= 1
    }
    var deepest = 0
    for leaf in 0..alpha {
        let depth = node[leaf]
        lens[keys[leaf] & 511] = u8(depth)
        if depth > deepest {
            deepest = depth
        }
    }
    deepest
}

fn assign_codes(lens: []u8, codes: []i64, alpha: i64) {
    var min = 32
    var max = 0
    for i in 0..alpha {
        let l = i64(lens[i])
        if l < min {
            min = l
        }
        if l > max {
            max = l
        }
    }
    var code = 0
    for len in min..max + 1 {
        for i in 0..alpha {
            if i64(lens[i]) == len {
                codes[i] = code
                code += 1
            }
        }
        code <<= 1
    }
}
