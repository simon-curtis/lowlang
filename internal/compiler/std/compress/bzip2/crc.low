struct Crc {
    table: []u32
    value: u32
}

fn crc_new() -> Crc {
    let table: []u32 = __make(256)
    for n in 0..256 {
        var c = u32(n) << 24
        for _ in 0..8 {
            c = if c & 0x80000000 != 0 { c << 1 ^ 0x04C11DB7 } else { c << 1 }
        }
        table[n] = c
    }
    Crc { table, value: 0xFFFFFFFF }
}

fn crc_reset(mut c: Crc) {
    c.value = 0xFFFFFFFF
}

fn crc_update(mut c: Crc, data: []u8) {
    var v = c.value
    let table = c.table
    for b in data {
        v = v << 8 ^ table[(v >> 24 ^ u32(b)) & 0xFF]
    }
    c.value = v
}

fn crc_byte(mut c: Crc, b: u8, count: i64) {
    var v = c.value
    let table = c.table
    for _ in 0..count {
        v = v << 8 ^ table[(v >> 24 ^ u32(b)) & 0xFF]
    }
    c.value = v
}

fn crc_sum(c: Crc) -> u32 {
    c.value ^ 0xFFFFFFFF
}

fn rotate_crc(combined: u32, block: u32) -> u32 {
    (combined << 1 | combined >> 31) ^ block
}
