import std/io

struct Work {
    order: []i32
    class: []i32
    next_order: []i32
    next_class: []i32
    count: []i32
    last: []u8
    symbols: []u16
    selectors: []u8
    freq: []i64
    rfreq: []i64
    lens: []u8
    codes: []i64
}

fn work() -> *Work {
    new(Work {
        order: []
        class: []
        next_order: []
        next_class: []
        count: []
        last: []
        symbols: []
        selectors: []
        freq: __make(max_symbols())
        rfreq: __make(6 * max_symbols())
        lens: io.buffer(6 * max_symbols())
        codes: __make(6 * max_symbols())
    })
}

fn reserve_work(w: *Work, n: i64) {
    if w.order.len >= n {
        return
    }
    w.order = __make(n)
    w.class = __make(n)
    w.next_order = __make(n)
    w.next_class = __make(n)
    w.count = __make(if n > 256 { n } else { 256 })
    w.last = io.buffer(n)
    w.symbols = __make(n + 2)
    w.selectors = io.buffer(n / group_size() + 2)
}

fn initial_order(w: *Work, data: []u8, n: i64) -> i64 {
    let count = w.count
    let order = w.order
    let class = w.class
    for i in 0..256 {
        count[i] = 0
    }
    for i in 0..n {
        count[data[i]] += 1
    }
    var start: i32 = 0
    for i in 0..256 {
        let c = count[i]
        count[i] = start
        start += c
    }
    for i in 0..n {
        let b = data[i]
        order[count[b]] = i32(i)
        count[b] += 1
    }
    var classes = 1
    class[order[0]] = 0
    for i in 1..n {
        if data[order[i]] != data[order[i - 1]] {
            classes += 1
        }
        class[order[i]] = i32(classes - 1)
    }
    classes
}

fn sort_rotations(w: *Work, data: []u8, n: i64) {
    var classes = initial_order(w, data, n)
    let order = w.order
    let next_order = w.next_order
    let count = w.count
    var class = w.class
    var next_class = w.next_class
    var k = 1
    for k < n {
        for i in 0..n {
            var j = i64(order[i]) - k
            if j < 0 {
                j += n
            }
            next_order[i] = i32(j)
        }
        for i in 0..classes {
            count[i] = 0
        }
        for i in 0..n {
            count[class[next_order[i]]] += 1
        }
        var start: i32 = 0
        for i in 0..classes {
            let c = count[i]
            count[i] = start
            start += c
        }
        for i in 0..n {
            let j = next_order[i]
            let c = class[j]
            order[count[c]] = j
            count[c] += 1
        }
        next_class[order[0]] = 0
        var found = 1
        for i in 1..n {
            let a = i64(order[i])
            let b = i64(order[i - 1])
            let a2 = if a + k >= n { a + k - n } else { a + k }
            let b2 = if b + k >= n { b + k - n } else { b + k }
            if class[a] != class[b] || class[a2] != class[b2] {
                found += 1
            }
            next_class[a] = i32(found - 1)
        }
        let swap = class
        class = next_class
        next_class = swap
        if found == n || found == classes {
            break
        }
        classes = found
        k *= 2
    }
}

fn transform(w: *Work, data: []u8, n: i64) -> i64 {
    sort_rotations(w, data, n)
    var orig = 0
    for i in 0..n {
        let j = i64(w.order[i])
        if j == 0 {
            orig = i
            w.last[i] = data[n - 1]
        } else {
            w.last[i] = data[j - 1]
        }
    }
    orig
}
