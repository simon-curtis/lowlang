import std/bits
import std/compress/codec
import std/io
import std/math

/// A streaming bzip2 encoder made by `encoder`.
///
/// `encode` takes input in any chunking and `finish` ends the stream. After `finish`, `encode` and `finish` fail with `Invalid`. Each block holds up to `level * 100000` bytes of run-length encoded input. A chunk is valid only during the call to `sink`.
pub struct Encoder {
    core: *Compressor
    sink: fn([]u8) ! io.Error
    finished: bool
}

struct Compressor {
    level: i64
    block: []u8
    len: i64
    limit: i64
    run_byte: u8
    run_len: i64
    crc: Crc
    combined: u32
    started: bool
    bits: *BitOut
    work: *Work
}

fn block_unit() -> i64 {
    100000
}

fn table_iterations() -> i64 {
    4
}

/// Returns an encoder that writes a bzip2 stream to `sink`.
///
/// `level` is clamped to `1..9` and sets the block size to `level * 100000` bytes.
pub fn encoder(level: i64, sink: fn([]u8) ! io.Error) -> *Encoder {
    new(Encoder { core: compressor(level, 65536), sink, finished: false })
}

fn compressor(level: i64, capacity: i64) -> *Compressor {
    let l = math.clamp(level, 1, 9)
    let size = l * block_unit()
    new(Compressor {
        level: l
        block: io.buffer(size)
        len: 0
        limit: size - 19
        run_byte: 0
        run_len: 0
        crc: crc_new()
        combined: 0
        started: false
        bits: bit_out(capacity)
        work: work()
    })
}

/// Adds `data` to the current block and passes each completed block to the encoder's `sink`.
///
/// Input is buffered until a block is full, so a call can produce no output. Fails with `Invalid` after `finish`, and with any error `sink` returns.
pub fn encode(e: *Encoder, data: []u8) ! io.Error {
    if e.finished {
        fail Invalid
    }
    codec.each_chunk(data, 65536, fn(chunk) {
        feed(e.core, chunk)
        codec.deliver(e.core.bits.out, e.sink)?
    })?
}

fn feed(c: *Compressor, data: []u8) {
    for b in data {
        if c.run_len > 0 && b == c.run_byte && c.run_len < 255 {
            c.run_len += 1
            continue
        }
        end_run(c)
        c.run_byte = b
        c.run_len = 1
    }
}

fn end_run(c: *Compressor) {
    let n = c.run_len
    if n == 0 {
        return
    }
    c.run_len = 0
    crc_byte(mut c.crc, c.run_byte, n)
    if n < 4 {
        for _ in 0..n {
            c.block[c.len] = c.run_byte
            c.len += 1
        }
    } else {
        for _ in 0..4 {
            c.block[c.len] = c.run_byte
            c.len += 1
        }
        c.block[c.len] = u8(n - 4)
        c.len += 1
    }
    if c.len >= c.limit {
        write_block(c)
    }
}

/// Writes the final block and the stream trailer with the combined checksum.
///
/// Fails with `Invalid` when the stream is already finished, and with any error `sink` returns.
pub fn finish(e: *Encoder) ! io.Error {
    if e.finished {
        fail Invalid
    }
    close(e.core)
    e.finished = true
    codec.deliver(e.core.bits.out, e.sink)?
}

fn close(c: *Compressor) {
    end_run(c)
    if c.len > 0 {
        write_block(c)
    }
    start_stream(c)
    let b = c.bits
    put(b, 0x177245, 24)
    put(b, 0x385090, 24)
    put(b, i64(c.combined), 32)
    align_out(b)
}

fn start_stream(c: *Compressor) {
    if c.started {
        return
    }
    c.started = true
    put(c.bits, 0x425A68, 24)
    put(c.bits, 0x30 + c.level, 8)
}

fn write_block(c: *Compressor) {
    start_stream(c)
    let n = c.len
    let sum = crc_sum(c.crc)
    c.combined = bits.rotl32(c.combined, 1) ^ sum
    crc_reset(mut c.crc)
    c.len = 0
    let w = c.work
    let data = c.block
    reserve_work(w, n)
    let orig = transform(w, data, n)
    let present = io.buffer(256)
    let map = io.buffer(256)
    let used = symbol_map(data, n, present, map)
    let count = move_to_front(w, n, map, used)
    let b = c.bits
    put(b, 0x314159, 24)
    put(b, 0x265359, 24)
    put(b, i64(sum), 32)
    put(b, 0, 1)
    put(b, orig, 24)
    put_map(b, present)
    let alpha = used + 2
    let groups = table_count(count)
    let selectors = fit_tables(w, count, alpha, groups)
    put(b, groups, 3)
    put(b, selectors, 15)
    put_selectors(b, w, selectors)
    put_tables(b, w, groups, alpha)
    put_symbols(b, w, count)
}

fn symbol_map(data: []u8, n: i64, present: []u8, map: []u8) -> i64 {
    for i in 0..n {
        present[data[i]] = 1
    }
    var used = 0
    for v in 0..256 {
        if present[v] != 0 {
            map[v] = u8(used)
            used += 1
        }
    }
    used
}

fn put_map(b: *BitOut, present: []u8) {
    var ranges = 0
    for i in 0..16 {
        for j in 0..16 {
            if present[i * 16 + j] != 0 {
                ranges |= 1 << (15 - i)
            }
        }
    }
    put(b, ranges, 16)
    for i in 0..16 {
        if ranges >> (15 - i) & 1 == 0 {
            continue
        }
        var members = 0
        for j in 0..16 {
            members = members << 1 | i64(present[i * 16 + j])
        }
        put(b, members, 16)
    }
}

fn put_zero_run(w: *Work, at: i64, run: i64) -> i64 {
    var pending = run - 1
    var out = at
    for {
        let sym = pending & 1
        w.symbols[out] = u16(sym)
        w.freq[sym] += 1
        out += 1
        if pending < 2 {
            break
        }
        pending = (pending - 2) / 2
    }
    out
}

fn move_to_front(w: *Work, n: i64, map: []u8, used: i64) -> i64 {
    let list = io.buffer(256)
    for i in 0..used {
        list[i] = u8(i)
    }
    for i in 0..max_symbols() {
        w.freq[i] = 0
    }
    var out = 0
    var zeros = 0
    for i in 0..n {
        let v = map[w.last[i]]
        if list[0] == v {
            zeros += 1
            continue
        }
        if zeros > 0 {
            out = put_zero_run(w, out, zeros)
            zeros = 0
        }
        var carry = list[0]
        var j = 1
        for list[j] != v {
            let t = list[j]
            list[j] = carry
            carry = t
            j += 1
        }
        list[j] = carry
        list[0] = v
        w.symbols[out] = u16(j + 1)
        w.freq[j + 1] += 1
        out += 1
    }
    if zeros > 0 {
        out = put_zero_run(w, out, zeros)
    }
    w.symbols[out] = u16(used + 1)
    w.freq[used + 1] += 1
    out + 1
}

fn table_count(count: i64) -> i64 {
    if count < 200 {
        2
    } else if count < 600 {
        3
    } else if count < 1200 {
        4
    } else if count < 2400 {
        5
    } else {
        6
    }
}

fn initial_tables(w: *Work, count: i64, alpha: i64, groups: i64) {
    var parts = groups
    var remaining = count
    var start = 0
    for parts > 0 {
        let target = remaining / parts
        var end = start - 1
        var covered = 0
        for covered < target && end < alpha - 1 {
            end += 1
            covered += w.freq[end]
        }
        if end > start && parts != groups && parts != 1 && (groups - parts) % 2 == 1 {
            covered -= w.freq[end]
            end -= 1
        }
        for v in 0..alpha {
            w.lens[(parts - 1) * max_symbols() + v] = if v >= start && v <= end { 0 } else { 15 }
        }
        parts -= 1
        start = end + 1
        remaining -= covered
    }
}

fn fit_tables(w: *Work, count: i64, alpha: i64, groups: i64) -> i64 {
    initial_tables(w, count, alpha, groups)
    let cost: []i64 = __make(6)
    var selectors = 0
    for _ in 0..table_iterations() {
        for i in 0..groups * max_symbols() {
            w.rfreq[i] = 0
        }
        selectors = 0
        var start = 0
        for start < count {
            let end = math.min(start + group_size(), count)
            var best = 0
            for t in 0..groups {
                var c = 0
                let row = t * max_symbols()
                for i in start..end {
                    c += i64(w.lens[row + i64(w.symbols[i])])
                }
                cost[t] = c
                if c < cost[best] {
                    best = t
                }
            }
            let row = best * max_symbols()
            for i in start..end {
                w.rfreq[row + i64(w.symbols[i])] += 1
            }
            w.selectors[selectors] = u8(best)
            selectors += 1
            start = end
        }
        for t in 0..groups {
            let row = t * max_symbols()
            make_lengths(w.rfreq[row..], w.lens[row..], alpha)
        }
    }
    selectors
}

fn put_selectors(b: *BitOut, w: *Work, selectors: i64) {
    let order = io.buffer(6)
    for i in 0..6 {
        order[i] = u8(i)
    }
    for i in 0..selectors {
        let v = w.selectors[i]
        var j = 0
        for order[j] != v {
            j += 1
        }
        for k in 0..j {
            order[j - k] = order[j - k - 1]
        }
        order[0] = v
        put(b, ((1 << j) - 1) << 1, j + 1)
    }
}

fn put_tables(b: *BitOut, w: *Work, groups: i64, alpha: i64) {
    for t in 0..groups {
        let row = t * max_symbols()
        var curr = i64(w.lens[row])
        put(b, curr, 5)
        for i in 0..alpha {
            let target = i64(w.lens[row + i])
            for curr < target {
                put(b, 2, 2)
                curr += 1
            }
            for curr > target {
                put(b, 3, 2)
                curr -= 1
            }
            put(b, 0, 1)
        }
        assign_codes(w.lens[row..], w.codes[row..], alpha)
    }
}

fn put_symbols(b: *BitOut, w: *Work, count: i64) {
    var start = 0
    var g = 0
    for start < count {
        let end = math.min(start + group_size(), count)
        let row = i64(w.selectors[g]) * max_symbols()
        for i in start..end {
            let sym = i64(w.symbols[i])
            put(b, w.codes[row + sym], i64(w.lens[row + sym]))
        }
        start = end
        g += 1
    }
}

/// Returns `data` compressed as a bzip2 stream.
///
/// `level` is clamped to `1..9` and sets the block size to `level * 100000` bytes.
pub fn compress(data: []u8, level: i64) -> []u8 {
    let c = compressor(level, data.len / 2 + 64)
    feed(c, data)
    close(c)
    codec.contents(c.bits.out)
}

