import std/io

fn read_full(r: *io.Reader, dst: []u8) ! io.Error {
    var got = 0
    for got < dst.len {
        let n = io.read_some(r, dst[got..])?
        if n == 0 {
            fail Malformed
        }
        got += n
    }
}

fn read_available(r: *io.Reader, dst: []u8) -> i64 ! io.Error {
    var got = 0
    for got < dst.len {
        let n = io.read_some(r, dst[got..])?
        if n == 0 {
            break
        }
        got += n
    }
    got
}

fn decode_lzma2(r: *io.Reader, d: *Decoder, input: []u8, head: []u8) -> i64 ! io.Error {
    var need_dictionary = true
    var need_properties = true
    var consumed = 0
    for {
        read_full(r, head[..1])?
        consumed += 1
        let control = i64(head[0])
        if control == 0 {
            return consumed
        }
        if control >= 0xE0 || control == 1 {
            need_properties = true
            need_dictionary = false
            reset_dictionary(d)
        } else if need_dictionary {
            fail Malformed
        }
        if control >= 0x80 {
            decode_lzma_chunk(r, d, input, head, control, need_properties)?
            need_properties = false
            consumed += io.be16(head, 2) + 1
            consumed += if control >= 0xC0 { 5 } else { 4 }
        } else if control <= 2 {
            read_full(r, head[..2])?
            let size = io.be16(head, 0) + 1
            read_full(r, input[..size])?
            put_raw(d, input[..size])?
            consumed += 2 + size
        } else {
            fail Malformed
        }
        flush(d)?
    }
}

fn decode_lzma_chunk(r: *io.Reader, d: *Decoder, input: []u8, head: []u8, control: i64, need_properties: bool) ! io.Error {
    let props = control >= 0xC0
    read_full(r, head[..if props { 5 } else { 4 }])?
    let unpacked = ((control & 0x1F) << 16 | io.be16(head, 0)) + 1
    let packed = io.be16(head, 2) + 1
    if props {
        let m = d.model
        if !set_properties_byte(m, head[4]) {
            fail Malformed
        }
        if m.lc + m.lp > 4 {
            fail Malformed
        }
    } else if need_properties {
        fail Malformed
    }
    if control >= 0xA0 {
        reset(d.model)
    }
    read_full(r, input[..packed])?
    start_range(d, input[..packed])
    if d.bad {
        fail Malformed
    }
    decode_until(d, d.total + unpacked)?
    if d.ended || d.pending > 0 || d.at != packed || d.code != 0 {
        fail Malformed
    }
}
