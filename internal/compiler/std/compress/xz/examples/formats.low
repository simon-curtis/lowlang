import std/compress/xz
import std/io
import std/slices
import std/text

/// Compresses one document as an `.xz` container and as a legacy `.lzma` stream, checks the signature bytes of each, and shows a truncated container being rejected.
fn main() ! io.Error {
    let doc = bytes(text.repeat("package: lowlang\nversion: 1.0\nlicense: MIT\n", 50))

    let container = xz.compress(doc, 6)
    let legacy = xz.lzma_compress(doc, 6)
    print("xz magic: {text.encode_hex(container[..6])}")
    print("lzma header: properties {legacy[0]:x2}, size {io.le64(legacy, 5)} of {doc.len}")

    print("xz round trip: {slices.equal(xz.decompress(container, 1 << 20)?, doc)}")
    print("lzma round trip: {slices.equal(xz.lzma_decompress(legacy, 1 << 20)?, doc)}")

    let cut = container[..container.len - 8]
    let _ = xz.decompress(cut, 1 << 20) catch {
        Malformed => {
            print("truncated container rejected")
            return
        }
        _ => return
    }
}
