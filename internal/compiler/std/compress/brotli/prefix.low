struct TableBuilder {
    count: []i64
    next: []i64
    codes: []i64
    sub: []i64
    pool: []u32
    used: i64
}

fn table_builder() -> *TableBuilder {
    new(TableBuilder { count: __make(16), next: __make(16), codes: __make(704), sub: __make(256), pool: __make(16384), used: 0 })
}

fn reverse_bits(code: i64, len: i64) -> i64 {
    var v = code
    var r = 0
    for _ in 0..len {
        r = r << 1 | (v & 1)
        v >>= 1
    }
    r
}

fn bit_length(n: i64) -> i64 {
    var v = n
    var bits = 0
    for v > 0 {
        bits += 1
        v >>= 1
    }
    bits
}

fn reserve(b: *TableBuilder, size: i64) -> i64 {
    let base = b.used
    if base + size > b.pool.len {
        var cap = b.pool.len * 2
        for cap < base + size {
            cap *= 2
        }
        let grown: []u32 = __make(cap)
        __memmove(grown, b.pool[..base])
        b.pool = grown
    }
    b.used = base + size
    base
}

fn build_single(b: *TableBuilder, sym: i64) -> i64 {
    let base = reserve(b, 256)
    let entry = u32(sym) << 8
    for i in 0..256 {
        b.pool[base + i] = entry
    }
    base
}

fn build_table(b: *TableBuilder, lens: []u8) -> i64 {
    let count = b.count
    let next = b.next
    let codes = b.codes
    let sub = b.sub
    for i in 0..16 {
        count[i] = 0
    }
    var single = 0
    for sym, l in lens {
        count[l] += 1
        if l != 0 {
            single = sym
        }
    }
    if lens.len - count[0] == 1 {
        return build_single(b, single)
    }
    count[0] = 0
    var code = 0
    for len in 1..16 {
        code = (code + count[len - 1]) << 1
        next[len] = code
    }
    for i in 0..256 {
        sub[i] = 0
    }
    for sym, l in lens {
        if l == 0 {
            continue
        }
        let n = i64(l)
        let reversed = reverse_bits(next[n], n)
        next[n] += 1
        codes[sym] = reversed
        if n > 8 && n - 8 > sub[reversed & 255] {
            sub[reversed & 255] = n - 8
        }
    }
    var size = 256
    for i in 0..256 {
        if sub[i] > 0 {
            size += 1 << sub[i]
        }
    }
    let base = reserve(b, size)
    let pool = b.pool
    var spare = 256
    for i in 0..256 {
        if sub[i] > 0 {
            pool[base + i] = u32(spare) << 8 | 0x80 | u32(sub[i])
            spare += 1 << sub[i]
        }
    }
    for sym, l in lens {
        if l == 0 {
            continue
        }
        let n = i64(l)
        let reversed = codes[sym]
        let entry = u32(sym) << 8 | u32(n)
        if n <= 8 {
            var i = reversed
            for i < 256 {
                pool[base + i] = entry
                i += 1 << n
            }
            continue
        }
        let link = pool[base + (reversed & 255)]
        let start = base + i64(link >> 8)
        let span = 1 << i64(link & 15)
        var i = reversed >> 8
        for i < span {
            pool[start + i] = entry
            i += 1 << (n - 8)
        }
    }
    base
}
