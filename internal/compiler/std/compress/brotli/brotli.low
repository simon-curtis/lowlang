import std/io

struct Collector {
    data: []u8
    len: i64
}

fn collector(hint: i64) -> *Collector {
    new(Collector { data: __make(if hint < 64 { 64 } else { hint }), len: 0 })
}

fn collect(c: *Collector, chunk: []u8) {
    let need = c.len + chunk.len
    if need > c.data.len {
        let size = if c.data.len * 2 > need { c.data.len * 2 } else { need }
        let grown: []u8 = __make(size)
        __memmove(grown, c.data[..c.len])
        c.data = grown
    }
    __memmove(c.data[c.len..], chunk)
    c.len = need
}

pub fn compress(data: []u8, level: i64) -> []u8 {
    let c = collector(data.len / 2 + 64)
    let e = new_encoder(level, window_bits(data.len), fn(chunk) { collect(c, chunk) })
    encode(e, data) catch {
        _ => {}
    }
    finish(e) catch {
        _ => {}
    }
    c.data[..c.len]
}

pub fn decode(r: *io.Reader, sink: fn([]u8) ! io.Error, limit: i64) ! io.Error {
    decode_stream(decoder(r, sink, limit))?
}

pub fn decompress(data: []u8, limit: i64) -> []u8 ! io.Error {
    let c = collector(if data.len * 4 < limit { data.len * 4 } else { limit })
    let d = decoder(io.bytes_reader(data), fn(chunk) { collect(c, chunk) }, limit)
    decode_stream(d)?
    if d.at < d.end || d.count >= 8 || io.read_some(d.source, d.input)? > 0 {
        fail Malformed
    }
    c.data[..c.len]
}
