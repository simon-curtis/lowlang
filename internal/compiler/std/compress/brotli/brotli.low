import std/compress/codec
import std/io
import std/math

/// Returns `data` compressed as a Brotli stream.
///
/// `level` is clamped to `0..11`; `0` stores the data in uncompressed meta-blocks. The window is sized from `data.len`, up to 22 bits.
pub fn compress(data: []u8, level: i64) -> []u8 {
    let e = compressor(level, window_bits(data.len), data.len / 2 + 64)
    feed(e, data)
    close(e)
    codec.contents(e.out)
}

/// Decodes a Brotli stream from `r` and passes the decoded bytes to `sink` in chunks until the input ends.
///
/// Decoding stops at the end of the stream.
/// Fails with `TooLarge` when the output would exceed `limit` bytes, `Malformed` when the input is invalid or truncated, and with any error `r` or `sink` returns. A chunk is valid only during the call to `sink`.
pub fn decode(r: *io.Reader, sink: fn([]u8) ! io.Error, limit: i64) ! io.Error {
    let reader = codec.stream_reader(r, 16384)
    let d = decoder(reader, sink, limit)
    reader.before_read = fn() ! io.Error {
        emit(d)
    }
    decode_stream(d)?
}

/// Returns the bytes decoded from a Brotli stream in `data`.
///
/// Bytes after the end of the stream are `Malformed`.
/// Fails with `TooLarge` when the output would exceed `limit` bytes and with `Malformed` when the input is invalid or truncated.
pub fn decompress(data: []u8, limit: i64) -> []u8 ! io.Error {
    let out = codec.buffer(math.min(data.len * 4, limit))
    let sink = codec.collector(out)
    let d = decoder(codec.slice_reader(data), sink, limit)
    decode_stream(d)?
    if codec.has_more(d.r)? {
        fail Malformed
    }
    codec.contents(out)
}
