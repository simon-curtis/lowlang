struct Code {
    lens: []u8
    codes: []u32
    used: i64
    first: i64
}

struct CodeBuilder {
    sorted: []i64
    weight: []i64
    parent: []i64
    counts: []i64
    next: []i64
}

struct BitWriter {
    data: []u8
    len: i64
    acc: u64
    count: i64
}

fn code(n: i64) -> *Code {
    new(Code { lens: __make(n), codes: __make(n), used: 0, first: 0 })
}

fn code_builder() -> *CodeBuilder {
    new(CodeBuilder { sorted: __make(704), weight: __make(1408), parent: __make(1408), counts: __make(16), next: __make(16) })
}

fn bit_writer() -> *BitWriter {
    new(BitWriter { data: __make(4096), len: 0, acc: 0, count: 0 })
}

fn put(w: *BitWriter, value: i64, n: i64) {
    w.acc |= u64(value) << u64(w.count)
    w.count += n
    if w.count >= 32 {
        if w.len + 4 > w.data.len {
            let grown: []u8 = __make(w.data.len * 2)
            __memmove(grown, w.data[..w.len])
            w.data = grown
        }
        let data = w.data
        let at = w.len
        let acc = w.acc
        data[at] = u8(acc)
        data[at + 1] = u8(acc >> 8)
        data[at + 2] = u8(acc >> 16)
        data[at + 3] = u8(acc >> 24)
        w.len = at + 4
        w.acc = acc >> 32
        w.count -= 32
    }
}

fn put_code(w: *BitWriter, c: *Code, sym: i64) {
    put(w, i64(c.codes[sym]), i64(c.lens[sym]))
}

fn align_writer(w: *BitWriter) {
    put(w, 0, (8 - w.count % 8) % 8)
    drain(w)
}

fn drain(w: *BitWriter) {
    for w.count >= 8 {
        if w.len == w.data.len {
            let grown: []u8 = __make(w.data.len * 2)
            __memmove(grown, w.data[..w.len])
            w.data = grown
        }
        w.data[w.len] = u8(w.acc)
        w.len += 1
        w.acc >>= 8
        w.count -= 8
    }
}

fn put_bytes_aligned(w: *BitWriter, bytes: []u8) {
    drain(w)
    if w.len + bytes.len > w.data.len {
        var size = w.data.len * 2
        for size < w.len + bytes.len {
            size *= 2
        }
        let grown: []u8 = __make(size)
        __memmove(grown, w.data[..w.len])
        w.data = grown
    }
    __memmove(w.data[w.len..], bytes)
    w.len += bytes.len
}

fn assign_codes(b: *CodeBuilder, c: *Code) {
    let counts = b.counts
    let next = b.next
    for i in 0..16 {
        counts[i] = 0
    }
    for l in c.lens {
        counts[l] += 1
    }
    counts[0] = 0
    var code = 0
    for len in 1..16 {
        code = (code + counts[len - 1]) << 1
        next[len] = code
    }
    for sym, l in c.lens {
        if l != 0 {
            c.codes[sym] = u32(reverse_bits(next[l], i64(l)))
            next[l] += 1
        }
    }
}

fn sort_used(b: *CodeBuilder, freq: []i64) -> i64 {
    let sorted = b.sorted
    var used = 0
    for sym, f in freq {
        if f == 0 {
            continue
        }
        var j = used
        for j > 0 && freq[sorted[j - 1]] > f {
            sorted[j] = sorted[j - 1]
            j -= 1
        }
        sorted[j] = sym
        used += 1
    }
    used
}

fn tree_depths(b: *CodeBuilder, freq: []i64, used: i64) {
    let sorted = b.sorted
    let weight = b.weight
    let parent = b.parent
    for i in 0..used {
        weight[i] = freq[sorted[i]]
    }
    var leaf = 0
    var node = used
    for k in used..2 * used - 1 {
        var a = 0
        if leaf < used && (node >= k || weight[leaf] <= weight[node]) {
            a = leaf
            leaf += 1
        } else {
            a = node
            node += 1
        }
        var z = 0
        if leaf < used && (node >= k || weight[leaf] <= weight[node]) {
            z = leaf
            leaf += 1
        } else {
            z = node
            node += 1
        }
        weight[k] = weight[a] + weight[z]
        parent[a] = k
        parent[z] = k
    }
    let root = 2 * used - 2
    weight[root] = 0
    var i = root - 1
    for i >= 0 {
        weight[i] = weight[parent[i]] + 1
        i -= 1
    }
}

fn limit_lengths(b: *CodeBuilder, used: i64, limit: i64) {
    let counts = b.counts
    for i in 0..16 {
        counts[i] = 0
    }
    for i in 0..used {
        let d = b.weight[i]
        counts[if d > limit { limit } else { d }] += 1
    }
    var total = 0
    for len in 1..limit + 1 {
        total += counts[len] << (limit - len)
    }
    for total > 1 << limit {
        counts[limit] -= 1
        var len = limit - 1
        for len > 0 {
            if counts[len] != 0 {
                counts[len] -= 1
                counts[len + 1] += 2
                break
            }
            len -= 1
        }
        total -= 1
    }
}

fn huffman(b: *CodeBuilder, freq: []i64, c: *Code, limit: i64) {
    let lens = c.lens
    for i in 0..lens.len {
        lens[i] = 0
    }
    let used = sort_used(b, freq)
    c.used = used
    c.first = if used > 0 { b.sorted[0] } else { 0 }
    if used < 2 {
        c.codes[c.first] = 0
        return
    }
    tree_depths(b, freq, used)
    limit_lengths(b, used, limit)
    var at = 0
    var len = limit
    for len > 0 {
        for _ in 0..b.counts[len] {
            lens[b.sorted[at]] = u8(len)
            at += 1
        }
        len -= 1
    }
    assign_codes(b, c)
}
