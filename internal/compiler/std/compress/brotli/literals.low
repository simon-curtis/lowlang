struct LiteralModel {
    limit: i64
    hist: []i64
    merged: []i64
    total: []i64
    cost: []f64
    delta: []f64
    owner: []i64
    active: []bool
    ids: []i64
    rows: []i64
    map: []u8
    clusters: i64
    codes: []*Code
    map_freq: []i64
    map_code: *Code
    mtf: []u8
    nlogn: []f64
}

fn log2(x: f64) -> f64 {
    var e = 0.0
    var m = x
    for m >= 2.0 {
        m = m / 2.0
        e += 1.0
    }
    let y = (m - 1.0) / (m + 1.0)
    let y2 = y * y
    let series = y * (1.0 + y2 * (1.0 / 3.0 + y2 * (1.0 / 5.0 + y2 * (1.0 / 7.0 + y2 * (1.0 / 9.0 + y2 / 11.0)))))
    e + 2.0 * series / 0.6931471805599453
}

fn literal_model(limit: i64) -> *LiteralModel {
    let codes: []*Code = __make(limit)
    for i in 0..limit {
        codes[i] = code(256)
    }
    let nlogn: []f64 = if limit > 1 { __make(4096) } else { [] }
    for n in 1..nlogn.len {
        nlogn[n] = f64(n) * log2(f64(n))
    }
    new(LiteralModel {
        limit
        hist: __make(64 * 256)
        merged: __make(64 * 256)
        total: __make(64)
        cost: __make(64)
        delta: __make(64 * 64)
        owner: __make(64)
        active: __make(64)
        ids: __make(64)
        rows: __make(64)
        map: __make(64)
        clusters: 1
        codes
        map_freq: __make(64)
        map_code: code(64)
        mtf: __make(64)
        nlogn
    })
}

fn nlog2n(m: *LiteralModel, n: i64) -> f64 {
    if n < m.nlogn.len {
        return m.nlogn[n]
    }
    f64(n) * log2(f64(n))
}

fn population_cost(m: *LiteralModel, a: i64, b: i64) -> f64 {
    let h = m.merged
    var total = 0
    var used = 0
    var bits = 0.0
    let ra = a * 256
    let rb = b * 256
    for i in 0..256 {
        var f = h[ra + i]
        if b >= 0 {
            f += h[rb + i]
        }
        if f > 0 {
            total += f
            used += 1
            bits -= nlog2n(m, f)
        }
    }
    if total == 0 {
        return 0.0
    }
    bits + nlog2n(m, total) + f64(3 * used + 30)
}

fn pair_delta(m: *LiteralModel, a: i64, b: i64) -> f64 {
    population_cost(m, a, b) - m.cost[a] - m.cost[b]
}

fn refresh_row(m: *LiteralModel, a: i64) {
    for b in 0..64 {
        if b != a && m.active[b] {
            let d = pair_delta(m, a, b)
            m.delta[a * 64 + b] = d
            m.delta[b * 64 + a] = d
        }
    }
}

fn merge_clusters(m: *LiteralModel, a: i64, b: i64) {
    let h = m.merged
    for i in 0..256 {
        h[a * 256 + i] += h[b * 256 + i]
    }
    m.total[a] += m.total[b]
    m.active[b] = false
    m.cost[a] = population_cost(m, a, -1)
    for ctx in 0..64 {
        if m.owner[ctx] == b {
            m.owner[ctx] = a
        }
    }
    refresh_row(m, a)
}

fn best_pair(m: *LiteralModel) -> i64 {
    var best = -1
    var lowest = 0.0
    for a in 0..64 {
        if !m.active[a] {
            continue
        }
        for b in a + 1..64 {
            if m.active[b] && (best < 0 || m.delta[a * 64 + b] < lowest) {
                best = a * 64 + b
                lowest = m.delta[best]
            }
        }
    }
    best
}

fn collapse(m: *LiteralModel) {
    let h = m.merged
    for ctx in 1..64 {
        for i in 0..256 {
            h[i] += h[ctx * 256 + i]
        }
        m.total[0] += m.total[ctx]
        m.owner[ctx] = 0
        m.active[ctx] = false
    }
    m.active[0] = m.total[0] > 0
}

fn agglomerate(m: *LiteralModel, initial: i64) {
    for ctx in 0..64 {
        if m.active[ctx] {
            m.cost[ctx] = population_cost(m, ctx, -1)
        }
    }
    for a in 0..64 {
        if m.active[a] {
            refresh_row(m, a)
        }
    }
    var count = initial
    for count > 1 {
        let pair = best_pair(m)
        if count <= m.limit && m.delta[pair] >= 0.0 {
            break
        }
        merge_clusters(m, pair / 64, pair % 64)
        count -= 1
    }
}

fn cluster_literals(m: *LiteralModel) {
    var count = 0
    __memmove(m.merged, m.hist)
    for ctx in 0..64 {
        var total = 0
        for i in 0..256 {
            total += m.hist[ctx * 256 + i]
        }
        m.total[ctx] = total
        m.owner[ctx] = ctx
        m.active[ctx] = total > 0
        if total > 0 {
            count += 1
        }
    }
    if m.limit == 1 {
        collapse(m)
    } else {
        agglomerate(m, count)
    }
    for i in 0..64 {
        m.ids[i] = -1
    }
    var next = 0
    m.rows[0] = 0
    for ctx in 0..64 {
        let o = m.owner[ctx]
        if m.active[o] && m.ids[o] < 0 {
            m.ids[o] = next
            m.rows[next] = o
            next += 1
        }
    }
    m.clusters = if next == 0 { 1 } else { next }
    for ctx in 0..64 {
        let o = m.owner[ctx]
        m.map[ctx] = if m.active[o] { u8(m.ids[o]) } else { 0 }
    }
}

fn cluster_freq(m: *LiteralModel, id: i64) -> []i64 {
    let row = m.rows[id] * 256
    m.merged[row..row + 256]
}
