import std/io

fn max_expansion() -> i64 {
    22
}

fn hash_bits_limit() -> i64 {
    16
}

/// Returns the decoded length stored in the header of the Snappy block `data`.
///
/// Reads only the leading varint. Fails with `Malformed` when it is truncated, longer than five bytes or above `0xFFFFFFFF`.
pub fn decoded_length(data: []u8) -> i64 ! io.Error {
    let header = read_varint(data)?
    header.value
}

struct Varint {
    value: i64
    size: i64
}

fn read_varint(data: []u8) -> Varint ! io.Error {
    var value = 0
    for i in 0..5 {
        if i >= data.len {
            fail Malformed
        }
        let b = i64(data[i])
        value |= (b & 0x7F) << (7 * i)
        if b < 0x80 {
            if value > 0xFFFFFFFF {
                fail Malformed
            }
            return Varint { value, size: i + 1 }
        }
    }
    fail Malformed
}

/// Returns the bytes decoded from the Snappy block `data`, which is the raw block format with no framing.
///
/// Fails with `TooLarge` when the decoded length in the header exceeds `limit` and with `Malformed` when the header is invalid, claims more than 22 times the compressed size or the block does not decode to exactly that length.
pub fn decompress_block(data: []u8, limit: i64) -> []u8 ! io.Error {
    let header = read_varint(data)?
    if header.value > limit {
        fail TooLarge
    }
    if header.value > max_expansion() * (data.len - header.size) {
        fail Malformed
    }
    let out = io.buffer(header.value)
    unpack(data, header.size, out)?
    out
}

fn unpack(data: []u8, start: i64, out: []u8) ! io.Error {
    let n = out.len
    var ip = start
    var op = 0
    for ip < data.len {
        let tag = i64(data[ip])
        ip += 1
        let kind = tag & 3
        if kind == 0 {
            var len = tag >> 2
            if len >= 60 {
                let width = len - 59
                if ip + width > data.len {
                    fail Malformed
                }
                len = 0
                for k in 0..width {
                    len |= i64(data[ip + k]) << (8 * k)
                }
                ip += width
            }
            len += 1
            if len > data.len - ip || len > n - op {
                fail Malformed
            }
            io.copy(out[op..op + len], data[ip..ip + len])
            ip += len
            op += len
            continue
        }
        var len = 0
        var offset = 0
        if kind == 1 {
            if ip + 1 > data.len {
                fail Malformed
            }
            len = 4 + (tag >> 2 & 7)
            offset = (tag >> 5) << 8 | i64(data[ip])
            ip += 1
        } else if kind == 2 {
            if ip + 2 > data.len {
                fail Malformed
            }
            len = 1 + (tag >> 2)
            offset = io.le16(data, ip)
            ip += 2
        } else {
            if ip + 4 > data.len {
                fail Malformed
            }
            len = 1 + (tag >> 2)
            offset = io.le32(data, ip)
            ip += 4
        }
        if offset == 0 || offset > op || len > n - op {
            fail Malformed
        }
        copy_match(out, op, offset, len)
        op += len
    }
    if op != n {
        fail Malformed
    }
}

fn copy_match(out: []u8, op: i64, offset: i64, n: i64) {
    let from = op - offset
    if offset >= n {
        io.copy(out[op..op + n], out[from..from + n])
        return
    }
    if offset == 1 {
        let v = out[from]
        for i in op..op + n {
            out[i] = v
        }
        return
    }
    var done = 0
    for done < n {
        var k = offset + done
        if k > n - done {
            k = n - done
        }
        io.copy(out[op + done..op + done + k], out[from..from + k])
        done += k
    }
}

fn max_compressed(n: i64) -> i64 {
    32 + n + n / 6
}

fn put_varint(dst: []u8, at: i64, value: i64) -> i64 {
    var v = value
    var op = at
    for v >= 0x80 {
        dst[op] = u8(v | 0x80)
        v >>= 7
        op += 1
    }
    dst[op] = u8(v)
    op + 1
}

fn put_literal(dst: []u8, at: i64, src: []u8) -> i64 {
    var op = at
    let n = src.len - 1
    if n < 60 {
        dst[op] = u8(n << 2)
        op += 1
    } else {
        var width = 1
        for n >> (8 * width) != 0 {
            width += 1
        }
        dst[op] = u8((59 + width) << 2)
        op += 1
        for k in 0..width {
            dst[op] = u8(n >> (8 * k))
            op += 1
        }
    }
    io.copy(dst[op..], src)
    op + src.len
}

fn put_copy_piece(dst: []u8, at: i64, offset: i64, len: i64) -> i64 {
    var op = at
    if len < 12 && offset < 2048 {
        dst[op] = u8(1 | (len - 4) << 2 | (offset >> 8) << 5)
        dst[op + 1] = u8(offset)
        return op + 2
    }
    if offset < 65536 {
        dst[op] = u8(2 | (len - 1) << 2)
        dst[op + 1] = u8(offset)
        dst[op + 2] = u8(offset >> 8)
        return op + 3
    }
    dst[op] = u8(3 | (len - 1) << 2)
    for k in 0..4 {
        dst[op + 1 + k] = u8(offset >> (8 * k))
    }
    op + 5
}

fn put_copy(dst: []u8, at: i64, offset: i64, length: i64) -> i64 {
    var op = at
    var len = length
    for len >= 68 {
        op = put_copy_piece(dst, op, offset, 64)
        len -= 64
    }
    if len > 64 {
        op = put_copy_piece(dst, op, offset, 60)
        len -= 60
    }
    put_copy_piece(dst, op, offset, len)
}

fn load32(b: []u8, at: i64) -> u32 {
    u32(b[at]) | u32(b[at + 1]) << 8 | u32(b[at + 2]) << 16 | u32(b[at + 3]) << 24
}

fn slot(v: u32, shift: i64) -> i64 {
    i64((v * 0x1E35A7BD) >> shift)
}

fn table_bits(n: i64) -> i64 {
    var bits = 8
    for bits < hash_bits_limit() && 1 << bits < n {
        bits += 1
    }
    bits
}

fn match_length(src: []u8, cand: i64, ip: i64) -> i64 {
    var len = 4
    let n = src.len
    for ip + len < n && src[cand + len] == src[ip + len] {
        len += 1
    }
    len
}

fn compress_into(table: []u32, bits: i64, src: []u8, dst: []u8) -> i64 {
    let n = src.len
    var op = put_varint(dst, 0, n)
    if n == 0 {
        return op
    }
    for i in 0..table.len {
        table[i] = 0
    }
    let shift = 32 - bits
    let last = n - 4
    var ip = 0
    var anchor = 0
    for ip <= last {
        let v = load32(src, ip)
        let h = slot(v, shift)
        let cand = i64(table[h]) - 1
        table[h] = u32(ip + 1)
        if cand >= 0 && load32(src, cand) == v {
            let len = match_length(src, cand, ip)
            let offset = ip - cand
            if offset < 65536 || len >= 8 {
                if ip > anchor {
                    op = put_literal(dst, op, src[anchor..ip])
                }
                op = put_copy(dst, op, offset, len)
                ip += len
                anchor = ip
                if ip <= last {
                    table[slot(load32(src, ip - 1), shift)] = u32(ip)
                }
                continue
            }
        }
        ip += 1 + ((ip - anchor) >> 5)
    }
    if anchor < n {
        op = put_literal(dst, op, src[anchor..])
    }
    op
}

/// Returns `data` compressed as one Snappy block, which is the raw block format with no framing.
///
/// The block holds the whole of `data`. `compress` and `encoder` write the framing format, which splits input into 64 KiB chunks.
pub fn compress_block(data: []u8) -> []u8 {
    let bits = table_bits(data.len)
    let table: []u32 = __make(1 << bits)
    let dst = io.buffer(max_compressed(data.len))
    let n = compress_into(table, bits, data, dst)
    dst[..n]
}
