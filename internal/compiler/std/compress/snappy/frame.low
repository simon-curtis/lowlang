import std/hash
import std/io

fn chunk_limit() -> i64 {
    65536
}

fn frame_bits() -> i64 {
    14
}

fn identifier() -> []u8 {
    [0xFF, 6, 0, 0, 0x73, 0x4E, 0x61, 0x50, 0x70, 0x59]
}

fn checksum(data: []u8) -> i64 {
    let c = hash.crc32c_new()
    hash.crc32_update(c, data)
    let v = hash.crc32_sum(c)
    i64((v >> 15 | v << 17) + 0xA282EAD8)
}

struct Decoder {
    r: *io.Reader
    sink: fn([]u8) ! io.Error
    limit: i64
    total: i64
    head: []u8
    packed: []u8
    plain: []u8
}

fn fill(d: *Decoder, dst: []u8) ! io.Error {
    var got = 0
    for got < dst.len {
        let n = io.read_some(d.r, dst[got..])?
        if n == 0 {
            fail Malformed
        }
        got += n
    }
}

fn skip(d: *Decoder, n: i64) ! io.Error {
    var left = n
    for left > 0 {
        let step = if left > d.packed.len { d.packed.len } else { left }
        fill(d, d.packed[..step])?
        left -= step
    }
}

/// Decodes the Snappy framing format from `r` and passes the decoded bytes to `sink` in chunks until the input ends.
///
/// Chunk checksums are verified. Skippable chunks are ignored; a reserved unskippable chunk type is `Unsupported`, and input without the leading stream identifier is `Malformed`.
/// Fails with `TooLarge` when the output would exceed `limit` bytes, `Malformed` when the input is invalid or truncated, and with any error `r` or `sink` returns. A chunk is valid only during the call to `sink`.
pub fn decode(r: *io.Reader, sink: fn([]u8) ! io.Error, limit: i64) ! io.Error {
    let d = new(Decoder {
        r
        sink
        limit
        total: 0
        head: io.buffer(4)
        packed: io.buffer(max_compressed(chunk_limit()) + 4)
        plain: io.buffer(chunk_limit())
    })
    var started = false
    for {
        let got = io.read_some(r, d.head[..1])?
        if got == 0 {
            break
        }
        fill(d, d.head[1..4])?
        let kind = i64(d.head[0])
        let size = io.le16(d.head, 1) | i64(d.head[3]) << 16
        if kind == 0xFF {
            start(d, size)?
            started = true
        } else if !started {
            fail Malformed
        } else if kind == 0x00 {
            compressed(d, size)?
        } else if kind == 0x01 {
            stored(d, size)?
        } else if kind < 0x80 {
            fail Unsupported
        } else {
            skip(d, size)?
        }
    }
    if !started {
        fail Malformed
    }
}

fn start(d: *Decoder, size: i64) ! io.Error {
    if size != 6 {
        fail Malformed
    }
    let name = d.packed[..6]
    fill(d, name)?
    if str(name) != "sNaPpY" {
        fail Malformed
    }
}

fn emit(d: *Decoder, chunk: []u8, expected: i64) ! io.Error {
    if checksum(chunk) != expected {
        fail Malformed
    }
    if chunk.len > d.limit - d.total {
        fail TooLarge
    }
    d.total += chunk.len
    d.sink(chunk)?
}

fn stored(d: *Decoder, size: i64) ! io.Error {
    if size < 4 || size > chunk_limit() + 4 {
        fail Malformed
    }
    let body = d.packed[..size]
    fill(d, body)?
    emit(d, body[4..], io.le32(body, 0))?
}

fn compressed(d: *Decoder, size: i64) ! io.Error {
    if size < 5 || size > d.packed.len {
        fail Malformed
    }
    let body = d.packed[..size]
    fill(d, body)?
    let plain = decompress_block(body[4..], chunk_limit()) catch {
        TooLarge => fail Malformed
        e => fail e
    }
    emit(d, plain, io.le32(body, 0))?
}

struct Collector {
    data: []u8
    len: i64
}

fn collect(c: *Collector, chunk: []u8) {
    let need = c.len + chunk.len
    if need > c.data.len {
        let size = if c.data.len * 2 > need { c.data.len * 2 } else { need }
        let grown: []u8 = __make(size)
        io.copy(grown, c.data[..c.len])
        c.data = grown
    }
    io.copy(c.data[c.len..], chunk)
    c.len = need
}

/// Returns the bytes decoded from the Snappy framing format in `data`.
///
/// Chunk checksums are verified. Input without the leading stream identifier is `Malformed`.
/// Fails with `TooLarge` when the output would exceed `limit` bytes and with `Malformed` when the input is invalid or truncated.
pub fn decompress(data: []u8, limit: i64) -> []u8 ! io.Error {
    let hint = data.len * 2 + 64
    let c = new(Collector { data: __make(if hint < limit { hint } else if limit > 0 { limit } else { 0 }), len: 0 })
    let sink: fn([]u8) ! io.Error = fn(chunk) { collect(c, chunk) }
    decode(io.bytes_reader(data), sink, limit)?
    c.data[..c.len]
}

/// A streaming encoder for the Snappy framing format made by `encoder`.
///
/// `encode` takes input in any chunking and writes it as chunks of up to 64 KiB, storing a chunk uncompressed when compression saves less than an eighth. The stream identifier is written with the first call. A chunk is valid only during the call to `sink`.
pub struct Encoder {
    sink: fn([]u8) ! io.Error
    pending: []u8
    len: i64
    table: []u32
    out: []u8
    started: bool
}

/// Returns an encoder that writes the Snappy framing format to `sink`.
pub fn encoder(sink: fn([]u8) ! io.Error) -> *Encoder {
    new(Encoder {
        sink
        pending: io.buffer(chunk_limit())
        len: 0
        table: __make(1 << frame_bits())
        out: io.buffer(max_compressed(chunk_limit()) + 8)
        started: false
    })
}

fn put_header(out: []u8, kind: u8, size: i64, sum: i64) {
    out[0] = kind
    out[1] = u8(size)
    out[2] = u8(size >> 8)
    out[3] = u8(size >> 16)
    io.set_le32(out, 4, sum)
}

fn emit_chunk(e: *Encoder) ! io.Error {
    let n = e.len
    e.len = 0
    let plain = e.pending[..n]
    let sum = checksum(plain)
    let size = compress_into(e.table, frame_bits(), plain, e.out[8..])
    if size < n - n / 8 {
        put_header(e.out, 0x00, size + 4, sum)
        e.sink(e.out[..8 + size])?
        return
    }
    let header = io.buffer(8)
    put_header(header, 0x01, n + 4, sum)
    e.sink(header)?
    e.sink(plain)?
}

fn start_stream(e: *Encoder) ! io.Error {
    if e.started {
        return
    }
    e.started = true
    e.sink(identifier())?
}

/// Compresses `data` and passes each completed 64 KiB chunk to the encoder's `sink`.
///
/// Input is buffered until a chunk is full, so a call can produce no output beyond the stream identifier. Fails with any error `sink` returns.
pub fn encode(e: *Encoder, data: []u8) ! io.Error {
    start_stream(e)?
    var at = 0
    for at < data.len {
        let n = io.copy(e.pending[e.len..], data[at..])
        e.len += n
        at += n
        if e.len == chunk_limit() {
            emit_chunk(e)?
        }
    }
}

/// Writes the buffered input as a chunk, so a decoder can read everything encoded so far.
///
/// Fails with any error `sink` returns.
pub fn flush(e: *Encoder) ! io.Error {
    start_stream(e)?
    if e.len > 0 {
        emit_chunk(e)?
    }
}

/// Writes the buffered input as a chunk. The format has no trailer, so this equals `flush`.
///
/// Fails with any error `sink` returns.
pub fn finish(e: *Encoder) ! io.Error {
    flush(e)?
}

/// Returns `data` compressed in the Snappy framing format.
pub fn compress(data: []u8) -> []u8 {
    let c = new(Collector { data: __make(data.len / 2 + 64), len: 0 })
    let sink: fn([]u8) ! io.Error = fn(chunk) { collect(c, chunk) }
    let e = encoder(sink)
    encode(e, data) catch {
        _ => {}
    }
    finish(e) catch {
        _ => {}
    }
    c.data[..c.len]
}
