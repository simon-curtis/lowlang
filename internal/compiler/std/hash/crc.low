/// An incremental CRC-32 checksum state.
///
/// Made by `crc32_new` or `crc32c_new`. The state is mutated in place by `crc32_update`.
pub struct Crc32 {
    table: []u32
    value: u32
}

/// An incremental CRC-64 checksum state.
///
/// Made by `crc64_new` and mutated in place by `crc64_update`.
pub struct Crc64 {
    table: []u64
    value: u64
}

fn crc32_table(poly: u32) -> []u32 {
    let table: []u32 = __make(256)
    for n in 0..256 {
        var c = u32(n)
        for _ in 0..8 {
            c = if c & 1 != 0 { poly ^ c >> 1 } else { c >> 1 }
        }
        table[n] = c
    }
    table
}

/// Returns a CRC-32 state using the IEEE 802.3 polynomial (`0xEDB88320` reflected), the checksum used by zlib, gzip, PNG and Ethernet.
///
/// The initial value is `0xFFFFFFFF` and `crc32_sum` inverts the result.
pub fn crc32_new() -> *Crc32 {
    new(Crc32 { table: crc32_table(0xEDB88320), value: 0xFFFFFFFF })
}

/// Returns a CRC-32C state using the Castagnoli polynomial (`0x82F63B78` reflected), the checksum used by iSCSI, ext4 and SCTP.
///
/// The initial value is `0xFFFFFFFF` and `crc32_sum` inverts the result.
pub fn crc32c_new() -> *Crc32 {
    new(Crc32 { table: crc32_table(0x82F63B78), value: 0xFFFFFFFF })
}

/// Feeds `data` into the CRC-32 state `c`.
///
/// Updating with several slices in turn gives the same sum as updating with their concatenation. An empty slice leaves the state unchanged.
pub fn crc32_update(c: *Crc32, data: []u8) {
    var v = c.value
    let table = c.table
    for b in data {
        v = table[(v ^ u32(b)) & 0xFF] ^ v >> 8
    }
    c.value = v
}

/// Returns the CRC-32 of everything fed to `c` so far.
///
/// The state is not consumed; more data can be fed afterwards.
pub fn crc32_sum(c: *Crc32) -> u32 {
    c.value ^ 0xFFFFFFFF
}

/// Returns the IEEE CRC-32 of `data`.
///
/// The CRC-32 of empty input is `0`.
pub fn crc32(data: []u8) -> u32 {
    let c = crc32_new()
    crc32_update(c, data)
    crc32_sum(c)
}

/// Returns a CRC-64 state using the ECMA-182 polynomial in its reflected form (`0xC96C5795D7870F42`), the CRC-64/XZ variant.
///
/// The initial value is all ones and `crc64_sum` inverts the result.
pub fn crc64_new() -> *Crc64 {
    let table: []u64 = __make(256)
    for n in 0..256 {
        var c = u64(n)
        for _ in 0..8 {
            c = if c & 1 != 0 { 0xC96C5795D7870F42 ^ c >> 1 } else { c >> 1 }
        }
        table[n] = c
    }
    new(Crc64 { table, value: 0xFFFFFFFFFFFFFFFF })
}

/// Feeds `data` into the CRC-64 state `c`.
///
/// Updating with several slices in turn gives the same sum as updating with their concatenation.
pub fn crc64_update(c: *Crc64, data: []u8) {
    var v = c.value
    let table = c.table
    for b in data {
        v = table[(v ^ u64(b)) & 0xFF] ^ v >> 8
    }
    c.value = v
}

/// Returns the CRC-64 of everything fed to `c` so far.
///
/// The state is not consumed; more data can be fed afterwards.
pub fn crc64_sum(c: *Crc64) -> u64 {
    c.value ^ 0xFFFFFFFFFFFFFFFF
}

/// Returns the CRC-64/XZ of `data`.
pub fn crc64(data: []u8) -> u64 {
    let c = crc64_new()
    crc64_update(c, data)
    crc64_sum(c)
}

/// Returns the Adler-32 checksum (RFC 1950) after appending `data` to input whose checksum was `adler`.
///
/// Pass `1` as `adler` to start a new checksum. The result carries the second sum in the high 16 bits and the first in the low 16 bits, both reduced modulo `65521`.
pub fn adler32_update(adler: u32, data: []u8) -> u32 {
    var a = adler & 0xFFFF
    var b = adler >> 16
    var i = 0
    for i < data.len {
        let end = if data.len - i < 5552 { data.len } else { i + 5552 }
        for j in i..end {
            a += u32(data[j])
            b += a
        }
        a = a % 65521
        b = b % 65521
        i = end
    }
    b << 16 | a
}

/// Returns the Adler-32 checksum (RFC 1950) of `data`.
///
/// The checksum of empty input is `1`.
pub fn adler32(data: []u8) -> u32 {
    adler32_update(1, data)
}
