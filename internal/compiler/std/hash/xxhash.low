fn p32(i: i64) -> u32 {
    let primes: []u32 = [0x9E3779B1, 0x85EBCA77, 0xC2B2AE3D, 0x27D4EB2F, 0x165667B1]
    primes[i - 1]
}

fn p64(i: i64) -> u64 {
    let primes: []u64 = [0x9E3779B185EBCA87, 0xC2B2AE3D27D4EB4F, 0x165667B19E3779F9, 0x85EBCA77C2B2AE63, 0x27D4EB2F165667C5]
    primes[i - 1]
}

fn rotl32(x: u32, n: i64) -> u32 {
    x << n | x >> (32 - n)
}

fn rotl64(x: u64, n: i64) -> u64 {
    x << n | x >> (64 - n)
}

fn le32(b: []u8, at: i64) -> u32 {
    u32(b[at]) | u32(b[at + 1]) << 8 | u32(b[at + 2]) << 16 | u32(b[at + 3]) << 24
}

fn le64(b: []u8, at: i64) -> u64 {
    u64(le32(b, at)) | u64(le32(b, at + 4)) << 32
}

fn round32(acc: u32, input: u32) -> u32 {
    rotl32(acc + input * p32(2), 13) * p32(1)
}

pub struct Xxh32 {
    v: []u32
    buf: []u8
    held: i64
    total: i64
    seed: u32
}

pub fn xxh32_new(seed: u32) -> *Xxh32 {
    let v: []u32 = [seed + p32(1) + p32(2), seed + p32(2), seed, seed - p32(1)]
    new(Xxh32 { v, buf: __make(16), held: 0, total: 0, seed })
}

fn xxh32_stripe(x: *Xxh32, data: []u8, at: i64) {
    let v = x.v
    v[0] = round32(v[0], le32(data, at))
    v[1] = round32(v[1], le32(data, at + 4))
    v[2] = round32(v[2], le32(data, at + 8))
    v[3] = round32(v[3], le32(data, at + 12))
}

pub fn xxh32_update(x: *Xxh32, data: []u8) {
    x.total += data.len
    var at = 0
    if x.held > 0 {
        let n = __memmove(x.buf[x.held..], data)
        x.held += n
        at = n
        if x.held < 16 {
            return
        }
        xxh32_stripe(x, x.buf, 0)
        x.held = 0
    }
    for at + 16 <= data.len {
        xxh32_stripe(x, data, at)
        at += 16
    }
    x.held = __memmove(x.buf, data[at..])
}

pub fn xxh32_sum(x: *Xxh32) -> u32 {
    let v = x.v
    var h = if x.total >= 16 { rotl32(v[0], 1) + rotl32(v[1], 7) + rotl32(v[2], 12) + rotl32(v[3], 18) } else { x.seed + p32(5) }
    h += u32(x.total)
    var at = 0
    for at + 4 <= x.held {
        h = rotl32(h + le32(x.buf, at) * p32(3), 17) * p32(4)
        at += 4
    }
    for at < x.held {
        h = rotl32(h + u32(x.buf[at]) * p32(5), 11) * p32(1)
        at += 1
    }
    h = (h ^ h >> 15) * p32(2)
    h = (h ^ h >> 13) * p32(3)
    h ^ h >> 16
}

pub fn xxh32(data: []u8, seed: u32) -> u32 {
    let x = xxh32_new(seed)
    xxh32_update(x, data)
    xxh32_sum(x)
}

fn round64(acc: u64, input: u64) -> u64 {
    rotl64(acc + input * p64(2), 31) * p64(1)
}

fn merge64(acc: u64, v: u64) -> u64 {
    (acc ^ round64(0, v)) * p64(1) + p64(4)
}

pub struct Xxh64 {
    v: []u64
    buf: []u8
    total: i64
    seed: u64
}

pub fn xxh64_new(seed: u64) -> *Xxh64 {
    let v: []u64 = [seed + p64(1) + p64(2), seed + p64(2), seed, seed - p64(1)]
    new(Xxh64 { v, buf: [], total: 0, seed })
}

fn xxh64_stripe(x: *Xxh64, data: []u8, at: i64) {
    let v = x.v
    v[0] = round64(v[0], le64(data, at))
    v[1] = round64(v[1], le64(data, at + 8))
    v[2] = round64(v[2], le64(data, at + 16))
    v[3] = round64(v[3], le64(data, at + 24))
}

pub fn xxh64_update(x: *Xxh64, data: []u8) {
    x.total += data.len
    var at = 0
    if x.buf.len > 0 {
        let room = 32 - x.buf.len
        at = if data.len < room { data.len } else { room }
        __extend(mut x.buf, __str_view(data[..at]))
        if x.buf.len < 32 {
            return
        }
        xxh64_stripe(x, x.buf, 0)
        x.buf = []
    }
    for at + 32 <= data.len {
        xxh64_stripe(x, data, at)
        at += 32
    }
    __extend(mut x.buf, __str_view(data[at..]))
}

pub fn xxh64_sum(x: *Xxh64) -> u64 {
    let v = x.v
    var h: u64 = 0
    if x.total >= 32 {
        h = rotl64(v[0], 1) + rotl64(v[1], 7) + rotl64(v[2], 12) + rotl64(v[3], 18)
        for k in 0..4 {
            h = merge64(h, v[k])
        }
    } else {
        h = x.seed + p64(5)
    }
    h += u64(x.total)
    let rest = x.buf
    var at = 0
    for at + 8 <= rest.len {
        h = rotl64(h ^ round64(0, le64(rest, at)), 27) * p64(1) + p64(4)
        at += 8
    }
    if at + 4 <= rest.len {
        h = rotl64(h ^ u64(le32(rest, at)) * p64(1), 23) * p64(2) + p64(3)
        at += 4
    }
    for at < rest.len {
        h = rotl64(h ^ u64(rest[at]) * p64(5), 11) * p64(1)
        at += 1
    }
    h = (h ^ h >> 33) * p64(2)
    h = (h ^ h >> 29) * p64(3)
    h ^ h >> 32
}

pub fn xxh64(data: []u8, seed: u64) -> u64 {
    let x = xxh64_new(seed)
    xxh64_update(x, data)
    xxh64_sum(x)
}
