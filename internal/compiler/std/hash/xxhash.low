fn p32(i: i64) -> u32 {
    let primes: []u32 = [0x9E3779B1, 0x85EBCA77, 0xC2B2AE3D, 0x27D4EB2F, 0x165667B1]
    primes[i - 1]
}

fn p64(i: i64) -> u64 {
    let primes: []u64 = [0x9E3779B185EBCA87, 0xC2B2AE3D27D4EB4F, 0x165667B19E3779F9, 0x85EBCA77C2B2AE63, 0x27D4EB2F165667C5]
    primes[i - 1]
}

fn rotl32(x: u32, n: i64) -> u32 {
    x << n | x >> (32 - n)
}

fn rotl64(x: u64, n: i64) -> u64 {
    x << n | x >> (64 - n)
}

fn le32(b: []u8, at: i64) -> u32 {
    u32(b[at]) | u32(b[at + 1]) << 8 | u32(b[at + 2]) << 16 | u32(b[at + 3]) << 24
}

fn le64(b: []u8, at: i64) -> u64 {
    u64(le32(b, at)) | u64(le32(b, at + 4)) << 32
}

fn round32(acc: u32, input: u32) -> u32 {
    rotl32(acc + input * p32(2), 13) * p32(1)
}

pub fn xxh32(data: []u8, seed: u32) -> u32 {
    var h: u32 = 0
    var at = 0
    if data.len >= 16 {
        var v1 = seed + p32(1) + p32(2)
        var v2 = seed + p32(2)
        var v3 = seed
        var v4 = seed - p32(1)
        for at + 16 <= data.len {
            v1 = round32(v1, le32(data, at))
            v2 = round32(v2, le32(data, at + 4))
            v3 = round32(v3, le32(data, at + 8))
            v4 = round32(v4, le32(data, at + 12))
            at += 16
        }
        h = rotl32(v1, 1) + rotl32(v2, 7) + rotl32(v3, 12) + rotl32(v4, 18)
    } else {
        h = seed + p32(5)
    }
    h += u32(data.len)
    for at + 4 <= data.len {
        h = rotl32(h + le32(data, at) * p32(3), 17) * p32(4)
        at += 4
    }
    for at < data.len {
        h = rotl32(h + u32(data[at]) * p32(5), 11) * p32(1)
        at += 1
    }
    h = (h ^ h >> 15) * p32(2)
    h = (h ^ h >> 13) * p32(3)
    h ^ h >> 16
}

fn round64(acc: u64, input: u64) -> u64 {
    rotl64(acc + input * p64(2), 31) * p64(1)
}

fn merge64(acc: u64, v: u64) -> u64 {
    (acc ^ round64(0, v)) * p64(1) + p64(4)
}

pub struct Xxh64 {
    v: []u64
    buf: []u8
    total: i64
    seed: u64
}

pub fn xxh64_new(seed: u64) -> *Xxh64 {
    let v: []u64 = [seed + p64(1) + p64(2), seed + p64(2), seed, seed - p64(1)]
    new(Xxh64 { v, buf: [], total: 0, seed })
}

fn xxh64_stripe(x: *Xxh64, data: []u8, at: i64) {
    let v = x.v
    v[0] = round64(v[0], le64(data, at))
    v[1] = round64(v[1], le64(data, at + 8))
    v[2] = round64(v[2], le64(data, at + 16))
    v[3] = round64(v[3], le64(data, at + 24))
}

pub fn xxh64_update(x: *Xxh64, data: []u8) {
    x.total += data.len
    var at = 0
    if x.buf.len > 0 {
        for at < data.len && x.buf.len < 32 {
            push(mut x.buf, data[at])
            at += 1
        }
        if x.buf.len < 32 {
            return
        }
        xxh64_stripe(x, x.buf, 0)
        x.buf = []
    }
    for at + 32 <= data.len {
        xxh64_stripe(x, data, at)
        at += 32
    }
    for at < data.len {
        push(mut x.buf, data[at])
        at += 1
    }
}

pub fn xxh64_sum(x: *Xxh64) -> u64 {
    let v = x.v
    var h: u64 = 0
    if x.total >= 32 {
        h = rotl64(v[0], 1) + rotl64(v[1], 7) + rotl64(v[2], 12) + rotl64(v[3], 18)
        for k in 0..4 {
            h = merge64(h, v[k])
        }
    } else {
        h = x.seed + p64(5)
    }
    h += u64(x.total)
    let rest = x.buf
    var at = 0
    for at + 8 <= rest.len {
        h = rotl64(h ^ round64(0, le64(rest, at)), 27) * p64(1) + p64(4)
        at += 8
    }
    if at + 4 <= rest.len {
        h = rotl64(h ^ u64(le32(rest, at)) * p64(1), 23) * p64(2) + p64(3)
        at += 4
    }
    for at < rest.len {
        h = rotl64(h ^ u64(rest[at]) * p64(5), 11) * p64(1)
        at += 1
    }
    h = (h ^ h >> 33) * p64(2)
    h = (h ^ h >> 29) * p64(3)
    h ^ h >> 32
}

pub fn xxh64(data: []u8, seed: u64) -> u64 {
    let x = xxh64_new(seed)
    xxh64_update(x, data)
    xxh64_sum(x)
}
