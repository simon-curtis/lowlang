import std/bits
import std/io

/// The error type of the SipHash functions.
pub enum Error {
    /// The key is not exactly 16 bytes long.
    BadKey
}

/// A 128-bit hash value held as two 64-bit halves.
///
/// `hash128_bytes` serialises it to 16 bytes.
pub struct Hash128 {
    /// The low 64 bits, serialised first by `hash128_bytes` in little-endian order.
    pub lo: u64
    /// The high 64 bits, serialised after `lo` by `hash128_bytes` in little-endian order.
    pub hi: u64
}

/// An incremental SipHash state.
///
/// Made by one of the `siphash*_new` functions, which fix the number of compression and finalisation rounds and the output width. `siphash_sum` needs a 64-bit state and `siphash_sum128` a 128-bit one.
pub struct Sip {
    v0: u64
    v1: u64
    v2: u64
    v3: u64
    buf: []u8
    held: i64
    total: i64
    compression: i64
    finalization: i64
    wide: bool
}

fn sip_round(mut v0: u64, mut v1: u64, mut v2: u64, mut v3: u64) {
    v0 += v1
    v1 = bits.rotl64(v1, 13)
    v1 ^= v0
    v0 = bits.rotl64(v0, 32)
    v2 += v3
    v3 = bits.rotl64(v3, 16)
    v3 ^= v2
    v0 += v3
    v3 = bits.rotl64(v3, 21)
    v3 ^= v0
    v2 += v1
    v1 = bits.rotl64(v1, 17)
    v1 ^= v2
    v2 = bits.rotl64(v2, 32)
}

fn sip_new(key: []u8, compression: i64, finalization: i64, wide: bool) -> *Sip ! Error {
    if key.len != 16 {
        fail BadKey
    }
    let k0 = io.u64_le(key, 0)
    let k1 = io.u64_le(key, 8)
    let v1 = if wide { k1 ^ 0x646F72616E646F6D ^ 0xEE } else { k1 ^ 0x646F72616E646F6D }
    new(Sip {
        v0: k0 ^ 0x736F6D6570736575
        v1
        v2: k0 ^ 0x6C7967656E657261
        v3: k1 ^ 0x7465646279746573
        buf: __make(8)
        held: 0
        total: 0
        compression
        finalization
        wide
    })
}

/// Returns a SipHash-2-4 state with a 64-bit output keyed by the 16-byte `key`.
///
/// Fails with `BadKey` when `key` is not 16 bytes. Finish it with `siphash_sum`.
pub fn siphash24_new(key: []u8) -> *Sip ! Error {
    sip_new(key, 2, 4, false)?
}

/// Returns a SipHash-1-3 state with a 64-bit output keyed by the 16-byte `key`.
///
/// Fails with `BadKey` when `key` is not 16 bytes. Finish it with `siphash_sum`. SipHash-1-3 is faster than SipHash-2-4 with a smaller security margin.
pub fn siphash13_new(key: []u8) -> *Sip ! Error {
    sip_new(key, 1, 3, false)?
}

/// Returns a SipHash-2-4 state with a 128-bit output keyed by the 16-byte `key`.
///
/// Fails with `BadKey` when `key` is not 16 bytes. Finish it with `siphash_sum128`.
pub fn siphash24_128_new(key: []u8) -> *Sip ! Error {
    sip_new(key, 2, 4, true)?
}

/// Returns a SipHash-1-3 state with a 128-bit output keyed by the 16-byte `key`.
///
/// Fails with `BadKey` when `key` is not 16 bytes. Finish it with `siphash_sum128`.
pub fn siphash13_128_new(key: []u8) -> *Sip ! Error {
    sip_new(key, 1, 3, true)?
}

fn sip_block(s: *Sip, m: u64) {
    var v0 = s.v0
    var v1 = s.v1
    var v2 = s.v2
    var v3 = s.v3
    v3 ^= m
    for _ in 0..s.compression {
        sip_round(mut v0, mut v1, mut v2, mut v3)
    }
    v0 ^= m
    s.v0 = v0
    s.v1 = v1
    s.v2 = v2
    s.v3 = v3
}

/// Feeds `data` into the SipHash state `s`.
///
/// Input is processed in little-endian 8-byte blocks and a partial block is held until more data arrives, so splitting the input across calls does not change the hash.
pub fn siphash_update(s: *Sip, data: []u8) {
    s.total += data.len
    var at = 0
    if s.held > 0 {
        let n = __memmove(s.buf[s.held..], data)
        s.held += n
        at = n
        if s.held < 8 {
            return
        }
        sip_block(s, io.u64_le(s.buf, 0))
        s.held = 0
    }
    for at + 8 <= data.len {
        sip_block(s, io.u64_le(data, at))
        at += 8
    }
    s.held = __memmove(s.buf, data[at..])
}

fn sip_tail(s: *Sip) -> u64 {
    var b = u64(s.total) << 56
    for i in 0..s.held {
        b |= u64(s.buf[i]) << u64(8 * i)
    }
    b
}

fn sip_finish(s: *Sip, mut v0: u64, mut v1: u64, mut v2: u64, mut v3: u64) {
    let b = sip_tail(s)
    v3 ^= b
    for _ in 0..s.compression {
        sip_round(mut v0, mut v1, mut v2, mut v3)
    }
    v0 ^= b
    let flag: u64 = if s.wide { 0xEE } else { 0xFF }
    v2 ^= flag
    for _ in 0..s.finalization {
        sip_round(mut v0, mut v1, mut v2, mut v3)
    }
}

/// Returns the 64-bit SipHash of everything fed to `s` so far.
///
/// The state is not consumed. Panics when `s` was made by a 128-bit constructor.
pub fn siphash_sum(s: *Sip) -> u64 {
    if s.wide {
        __panic("hash: siphash_sum needs a 64-bit hasher")
    }
    var v0 = s.v0
    var v1 = s.v1
    var v2 = s.v2
    var v3 = s.v3
    sip_finish(s, mut v0, mut v1, mut v2, mut v3)
    v0 ^ v1 ^ v2 ^ v3
}

/// Returns the 128-bit SipHash of everything fed to `s` so far.
///
/// The state is not consumed. Panics when `s` was made by a 64-bit constructor.
pub fn siphash_sum128(s: *Sip) -> Hash128 {
    if !s.wide {
        __panic("hash: siphash_sum128 needs a 128-bit hasher")
    }
    var v0 = s.v0
    var v1 = s.v1
    var v2 = s.v2
    var v3 = s.v3
    sip_finish(s, mut v0, mut v1, mut v2, mut v3)
    let lo = v0 ^ v1 ^ v2 ^ v3
    v1 ^= 0xDD
    for _ in 0..s.finalization {
        sip_round(mut v0, mut v1, mut v2, mut v3)
    }
    Hash128 { lo, hi: v0 ^ v1 ^ v2 ^ v3 }
}

/// Returns the 16 bytes of `h`: `lo` then `hi`, each in little-endian order.
pub fn hash128_bytes(h: Hash128) -> []u8 {
    let out: []u8 = __make(16)
    for i in 0..8 {
        out[i] = u8(h.lo >> u64(8 * i))
        out[8 + i] = u8(h.hi >> u64(8 * i))
    }
    out
}

/// Returns the SipHash-2-4 of `data` under the 16-byte `key` as a 64-bit value.
///
/// Fails with `BadKey` when `key` is not 16 bytes. SipHash is a keyed pseudorandom function suited to hash tables that must resist collision flooding.
pub fn siphash24(key: []u8, data: []u8) -> u64 ! Error {
    let s = siphash24_new(key)?
    siphash_update(s, data)
    siphash_sum(s)
}

/// Returns the SipHash-1-3 of `data` under the 16-byte `key` as a 64-bit value.
///
/// Fails with `BadKey` when `key` is not 16 bytes.
pub fn siphash13(key: []u8, data: []u8) -> u64 ! Error {
    let s = siphash13_new(key)?
    siphash_update(s, data)
    siphash_sum(s)
}

/// Returns the 128-bit SipHash-2-4 of `data` under the 16-byte `key`.
///
/// Fails with `BadKey` when `key` is not 16 bytes.
pub fn siphash24_128(key: []u8, data: []u8) -> Hash128 ! Error {
    let s = siphash24_128_new(key)?
    siphash_update(s, data)
    siphash_sum128(s)
}

/// Returns the 128-bit SipHash-1-3 of `data` under the 16-byte `key`.
///
/// Fails with `BadKey` when `key` is not 16 bytes.
pub fn siphash13_128(key: []u8, data: []u8) -> Hash128 ! Error {
    let s = siphash13_128_new(key)?
    siphash_update(s, data)
    siphash_sum128(s)
}
