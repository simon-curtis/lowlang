/// An incremental 32-bit FNV hash state, in either the FNV-1 or the FNV-1a order.
pub struct Fnv32 {
    value: u32
    xor_first: bool
}

/// An incremental 64-bit FNV hash state, in either the FNV-1 or the FNV-1a order.
pub struct Fnv64 {
    value: u64
    xor_first: bool
}

/// Returns a 32-bit FNV-1 state (multiply, then XOR each byte) with the offset basis `0x811C9DC5` and prime `0x01000193`.
pub fn fnv32_new() -> *Fnv32 {
    new(Fnv32 { value: 0x811C9DC5, xor_first: false })
}

/// Returns a 32-bit FNV-1a state (XOR each byte, then multiply) with the offset basis `0x811C9DC5` and prime `0x01000193`.
pub fn fnv32a_new() -> *Fnv32 {
    new(Fnv32 { value: 0x811C9DC5, xor_first: true })
}

/// Feeds `data` into the 32-bit FNV state `f`, using the order the state was made with.
///
/// Updating with several slices in turn gives the same hash as updating with their concatenation.
pub fn fnv32_update(f: *Fnv32, data: []u8) {
    var h = f.value
    if f.xor_first {
        for b in data {
            h = (h ^ u32(b)) * 0x01000193
        }
    } else {
        for b in data {
            h = h * 0x01000193 ^ u32(b)
        }
    }
    f.value = h
}

/// Returns the 32-bit FNV hash of everything fed to `f` so far.
///
/// The state is not consumed. The hash of empty input is the offset basis.
pub fn fnv32_sum(f: *Fnv32) -> u32 {
    f.value
}

/// Returns the 32-bit FNV-1 hash of `data`.
pub fn fnv1_32(data: []u8) -> u32 {
    let f = fnv32_new()
    fnv32_update(f, data)
    fnv32_sum(f)
}

/// Returns the 32-bit FNV-1a hash of `data`.
pub fn fnv1a_32(data: []u8) -> u32 {
    let f = fnv32a_new()
    fnv32_update(f, data)
    fnv32_sum(f)
}

/// Returns a 64-bit FNV-1 state (multiply, then XOR each byte) with the offset basis `0xCBF29CE484222325` and prime `0x00000100000001B3`.
pub fn fnv64_new() -> *Fnv64 {
    new(Fnv64 { value: 0xCBF29CE484222325, xor_first: false })
}

/// Returns a 64-bit FNV-1a state (XOR each byte, then multiply) with the offset basis `0xCBF29CE484222325` and prime `0x00000100000001B3`.
pub fn fnv64a_new() -> *Fnv64 {
    new(Fnv64 { value: 0xCBF29CE484222325, xor_first: true })
}

/// Feeds `data` into the 64-bit FNV state `f`, using the order the state was made with.
///
/// Updating with several slices in turn gives the same hash as updating with their concatenation.
pub fn fnv64_update(f: *Fnv64, data: []u8) {
    var h = f.value
    if f.xor_first {
        for b in data {
            h = (h ^ u64(b)) * 0x00000100000001B3
        }
    } else {
        for b in data {
            h = h * 0x00000100000001B3 ^ u64(b)
        }
    }
    f.value = h
}

/// Returns the 64-bit FNV hash of everything fed to `f` so far.
///
/// The state is not consumed. The hash of empty input is the offset basis.
pub fn fnv64_sum(f: *Fnv64) -> u64 {
    f.value
}

/// Returns the 64-bit FNV-1 hash of `data`.
pub fn fnv1_64(data: []u8) -> u64 {
    let f = fnv64_new()
    fnv64_update(f, data)
    fnv64_sum(f)
}

/// Returns the 64-bit FNV-1a hash of `data`.
pub fn fnv1a_64(data: []u8) -> u64 {
    let f = fnv64a_new()
    fnv64_update(f, data)
    fnv64_sum(f)
}
