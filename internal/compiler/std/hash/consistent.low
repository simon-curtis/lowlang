pub fn jump(key: u64, buckets: i64) -> i64 {
    var k = key
    var b = -1
    var j = 0
    for j < buckets {
        b = j
        k = k * 2862933555777941757 + 1
        j = i64(f64(b + 1) * (2147483648.0 / f64((k >> 33) + 1)))
    }
    b
}

fn rendezvous_best(count: i64, score: fn(i64) -> u64) -> i64? {
    if count == 0 {
        return none
    }
    var best = 0
    var best_score = score(0)
    for i in 1..count {
        let s = score(i)
        if s > best_score {
            best = i
            best_score = s
        }
    }
    best
}

pub fn rendezvous(key: u64, nodes: []u64) -> i64? {
    let seed = fmix64(key)
    rendezvous_best(nodes.len, fn(i) { fmix64(nodes[i] ^ seed) })
}

pub fn rendezvous_str(key: str, nodes: []str) -> i64? {
    let seed = xxh64(bytes(key), 0)
    rendezvous_best(nodes.len, fn(i) { xxh64(bytes(nodes[i]), seed) })
}
