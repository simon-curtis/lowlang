import std/header
import std/io

struct Frame {
    kind: i64
    flags: i64
    stream: i64
    payload: []u8
}

enum Fault {
    BadFrame
    BadSize
}

struct Setting {
    id: i64
    value: i64
}

const frame_data = 0
const frame_headers = 1
const frame_priority = 2
const frame_reset = 3
const frame_settings = 4
const frame_push_promise = 5
const frame_ping = 6
const frame_goaway = 7
const frame_window_update = 8
const frame_continuation = 9
const flag_end_stream = 0x1
const flag_ack = 0x1
const flag_end_headers = 0x4
const flag_padded = 0x8
const flag_priority = 0x20
const error_protocol = 1
const error_flow_control = 3
const error_stream_closed = 5
const error_frame_size = 6
const error_refused_stream = 7
const error_cancel = 8
const error_compression = 9
const error_enhance_your_calm = 11
const setting_enable_push = 2
const setting_max_streams = 3
const setting_initial_window = 4
const setting_max_frame_size = 5
const window_limit = 0x7FFFFFFF
const default_window = 65535
const default_frame_size = 16384
const max_frame_size = 16777215
const max_header_block = 1 << 20

fn connection_specific(name: str) -> bool {
    name == "connection" || name == "keep-alive" || name == "transfer-encoding" || name == "upgrade" || name == "proxy-connection"
}

const preface_line = "PRI * HTTP/2.0"
const preface = preface_line + "\r\n\r\nSM\r\n\r\n"

fn read_preface_rest(r: *io.Reader) ! io.Error {
    for want in ["", "SM", ""] {
        if io.read_line(r)? != want {
            fail Malformed
        }
    }
}

fn put_frame(mut out: []u8, kind: i64, flags: i64, stream: i64, payload: []u8) {
    io.put_be24(mut out, payload.len)
    push(mut out, u8(kind))
    push(mut out, u8(flags))
    io.put_be32(mut out, stream)
    io.append(mut out, payload)
}

fn put_window_update(mut out: []u8, stream: i64, n: i64) {
    var amount: []u8 = []
    io.put_be32(mut amount, n)
    put_frame(mut out, frame_window_update, 0, stream, amount)
}

fn put_reset(mut out: []u8, stream: i64, code: i64) {
    var payload: []u8 = []
    io.put_be32(mut payload, code)
    put_frame(mut out, frame_reset, 0, stream, payload)
}

fn put_goaway(mut out: []u8, last: i64, code: i64) {
    var payload: []u8 = []
    io.put_be32(mut payload, last)
    io.put_be32(mut payload, code)
    put_frame(mut out, frame_goaway, 0, 0, payload)
}

fn put_settings_ack(mut out: []u8) {
    put_frame(mut out, frame_settings, flag_ack, 0, [])
}

fn put_ping_ack(mut out: []u8, payload: []u8) {
    put_frame(mut out, frame_ping, flag_ack, 0, payload)
}

fn put_initial_settings(mut out: []u8, server: bool) {
    var payload: []u8 = []
    if server {
        io.put_be16(mut payload, setting_max_streams)
        io.put_be32(mut payload, 100)
    } else {
        io.put_be16(mut payload, setting_enable_push)
        io.put_be32(mut payload, 0)
    }
    io.put_be16(mut payload, setting_initial_window)
    io.put_be32(mut payload, 1 << 20)
    put_frame(mut out, frame_settings, 0, 0, payload)
    put_window_update(mut out, 0, (1 << 30) - default_window)
}

fn put_headers(mut out: []u8, statics: []header.Header, frame_size: i64, id: i64, fields: []header.Header, ends: bool) {
    var rest = encode(statics, fields)
    var kind = frame_headers
    var flags = if ends { flag_end_stream } else { 0 }
    for {
        let n = if rest.len < frame_size { rest.len } else { frame_size }
        let last = n == rest.len
        put_frame(mut out, kind, if last { flags | flag_end_headers } else { flags }, id, rest[..n])
        if last {
            return
        }
        rest = rest[n..]
        kind = frame_continuation
        flags = 0
    }
}

fn read_frame(r: *io.Reader) -> Frame ! io.Error {
    let head = io.read_exact(r, 9)?
    let size = io.be24(head, 0)
    if size > default_frame_size {
        fail TooLarge
    }
    let payload = io.read_exact(r, size)?
    Frame { kind: i64(head[3]), flags: i64(head[4]), stream: io.be32(head, 5) & window_limit, payload }
}

fn unpadded(f: Frame) -> []u8 ! Fault {
    if f.flags & flag_padded == 0 {
        return f.payload
    }
    if f.payload.len == 0 || i64(f.payload[0]) >= f.payload.len {
        fail BadFrame
    }
    f.payload[1..f.payload.len - i64(f.payload[0])]
}

fn header_block(f: Frame) -> []u8 ! Fault {
    let block = unpadded(f)?
    if f.flags & flag_priority == 0 {
        return block
    }
    if block.len < 5 {
        fail BadSize
    }
    if io.be32(block, 0) & window_limit == f.stream {
        fail BadFrame
    }
    block[5..]
}

fn settings_of(f: Frame) -> []Setting {
    var out: []Setting = []
    var at = 0
    for at + 6 <= f.payload.len {
        push(mut out, Setting { id: io.be16(f.payload, at), value: io.be32(f.payload, at + 2) })
        at += 6
    }
    out
}

fn setting_fault(s: Setting) -> i64 {
    if s.id == setting_enable_push && s.value > 1 {
        return error_protocol
    }
    if s.id == setting_initial_window && s.value > window_limit {
        return error_flow_control
    }
    if s.id == setting_max_frame_size && (s.value < default_frame_size || s.value > max_frame_size) {
        return error_protocol
    }
    0
}
