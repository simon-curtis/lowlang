import std/io
import std/time

struct Deadline {
    at: i64
    fd: i64
    fired: bool
    done: bool
}

struct Reaper {
    lock: chan[bool]
    entries: []*Deadline
    wake: chan[bool]
    running: bool
    target: i64
}

fn new_reaper() -> *Reaper {
    new(Reaper { lock: chan[bool](1), entries: [], wake: chan[bool](1), running: false, target: 0 })
}

fn now_ms() -> i64 {
    time.monotonic() / 1000000
}

fn notify(c: chan[bool]) {
    select {
        c <- true => {}
        else => {}
    }
}

fn arm(r: *Reaper, millis: i64) -> *Deadline {
    if millis <= 0 {
        return new(Deadline { at: 0, fd: -1, fired: false, done: false })
    }
    let d = new(Deadline { at: now_ms() + millis, fd: -1, fired: false, done: false })
    r.lock <- true
    push(mut r.entries, d)
    if !r.running {
        r.running = true
        r.target = d.at
        spawn reap(r)
    } else if d.at < r.target {
        r.target = d.at
        notify(r.wake)
    }
    <-r.lock
    d
}

fn disarm(r: *Reaper, d: *Deadline) {
    if d.at == 0 {
        return
    }
    r.lock <- true
    d.done = true
    d.fd = -1
    <-r.lock
}

fn attach(r: *Reaper, d: *Deadline, fd: i64) {
    if d.at == 0 {
        return
    }
    r.lock <- true
    d.fd = fd
    if d.fired {
        __syscall(48, fd, 2)
    }
    <-r.lock
}

fn detach(r: *Reaper, d: *Deadline) {
    if d.at == 0 {
        return
    }
    r.lock <- true
    d.fd = -1
    <-r.lock
}

fn remaining(d: *Deadline) -> i64 {
    if d.at == 0 {
        return 0
    }
    let left = d.at - now_ms()
    if left > 0 { left } else { -1 }
}

fn expired(d: *Deadline) -> bool {
    d.fired || d.at != 0 && now_ms() >= d.at
}

fn await(c: chan[bool], d: *Deadline) ! io.Error {
    if d.at == 0 {
        <-c
        return
    }
    let left = remaining(d)
    if left < 0 {
        fail TimedOut
    }
    let woken = select {
        <-c => true
        after(left) => false
    }
    if !woken {
        fail TimedOut
    }
}

fn reap(r: *Reaper) {
    for {
        r.lock <- true
        let now = now_ms()
        var kept: []*Deadline = []
        var next = 0
        for d in r.entries {
            if d.done {
                continue
            }
            if d.at <= now {
                d.fired = true
                if d.fd >= 0 {
                    __syscall(48, d.fd, 2)
                }
                continue
            }
            push(mut kept, d)
            if next == 0 || d.at < next {
                next = d.at
            }
        }
        r.entries = kept
        if kept.len == 0 {
            r.running = false
            <-r.lock
            return
        }
        r.target = next
        <-r.lock
        select {
            <-r.wake => {}
            after(next - now) => {}
        }
    }
}
