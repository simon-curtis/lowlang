import std/cancel
import std/io
import std/net
import std/time

struct Deadline {
    at: i64
    conn: net.ConnHandle?
    fired: bool
    done: bool
    stopped: bool
    stop: chan[bool]
    link: cancel.RegistrationHandle?
}

struct Armed {
    reaper: *Reaper
    deadline: *Deadline
    drop disarm(reaper, deadline)
}

struct Reaper {
    lock: chan[bool]
    entries: []*Deadline
    wake: chan[bool]
    running: bool
    target: i64
}

fn new_reaper() -> *Reaper {
    new(Reaper { lock: chan[bool](1), entries: [], wake: chan[bool](1), running: false, target: 0 })
}

fn now_ms() -> i64 {
    time.monotonic() / 1000000
}

fn notify(c: chan[bool]) {
    select {
        c <- true => {}
        else => {}
    }
}

const unbounded = 1 << 40

fn arm(r: *Reaper, millis: i64, token: *cancel.Token?) -> *Deadline {
    let limit = if millis <= 0 && token != none { unbounded } else { millis }
    if limit <= 0 {
        return new(Deadline { at: 0, conn: none, fired: false, done: false, stopped: false, stop: chan[bool](), link: none })
    }
    let d = new(Deadline { at: now_ms() + limit, conn: none, fired: false, done: false, stopped: false, stop: chan[bool](), link: none })
    r.lock <- true
    push(mut r.entries, d)
    if !r.running {
        r.running = true
        r.target = d.at
        spawn reap(r)
    } else if d.at < r.target {
        r.target = d.at
        notify(r.wake)
    }
    <-r.lock
    match token {
        some(t) => {
            d.link = some(cancel.on_cancel_handle(t, fn() { abort(r, d) }))
        }
        none => {}
    }
    d
}

fn abort(r: *Reaper, d: *Deadline) {
    r.lock <- true
    if !d.done && !d.stopped {
        d.fired = true
        d.stopped = true
        sever(d)
        close(d.stop)
    }
    <-r.lock
}

fn disarm(r: *Reaper, d: *Deadline) {
    if d.at == 0 {
        return
    }
    match d.link {
        some(l) => cancel.release_on(l)
        none => {}
    }
    r.lock <- true
    d.done = true
    d.conn = none
    <-r.lock
}

fn sever(d: *Deadline) {
    match d.conn {
        some(h) => net.close_on(h)
        none => {}
    }
}

fn track(r: *Reaper, d: *Deadline, conn: net.ConnHandle) {
    if d.at == 0 {
        return
    }
    r.lock <- true
    d.conn = some(conn)
    if d.fired {
        sever(d)
    }
    <-r.lock
}

fn untrack(r: *Reaper, d: *Deadline) {
    if d.at == 0 {
        return
    }
    r.lock <- true
    d.conn = none
    <-r.lock
}

fn remaining(d: *Deadline) -> i64 {
    if d.at == 0 {
        return 0
    }
    let left = d.at - now_ms()
    if left > 0 { left } else { -1 }
}

fn expired(d: *Deadline) -> bool {
    d.fired || d.at != 0 && now_ms() >= d.at
}

fn await(c: chan[bool], d: *Deadline) ! io.Error {
    if d.at == 0 {
        <-c
        return
    }
    let left = remaining(d)
    if left < 0 {
        fail TimedOut
    }
    let woken = select {
        <-c => true
        <-d.stop => false
        after(left) => false
    }
    if !woken {
        fail TimedOut
    }
}

fn reap(r: *Reaper) {
    for {
        r.lock <- true
        let now = now_ms()
        var kept: []*Deadline = []
        var next = 0
        for d in r.entries {
            if d.done {
                continue
            }
            if d.at <= now {
                d.fired = true
                sever(d)
                continue
            }
            push(mut kept, d)
            if next == 0 || d.at < next {
                next = d.at
            }
        }
        r.entries = kept
        if kept.len == 0 {
            r.running = false
            <-r.lock
            return
        }
        r.target = next
        <-r.lock
        select {
            <-r.wake => {}
            after(next - now) => {}
        }
    }
}
