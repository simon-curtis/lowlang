import std/cancel
import std/http

/// Settings for a server-sent events response.
pub struct Options {
    /// The milliseconds of silence after which a keepalive comment is sent so proxies keep the connection open. The default is `15000`; `0` or less turns keepalives off.
    pub keepalive: i64 = 15000
    /// The reconnection delay in milliseconds sent to the client as the first thing in the stream. The default `-1` sends none.
    pub retry: i64 = -1
}

/// The handle a producer uses to send events to the client.
///
/// The events go to the response created by `stream` or `stream_with`.
pub struct Emitter {
    /// The cancellation token of the request. It is cancelled when the client disconnects.
    pub token: *cancel.Token
    events: chan[Event]
}

/// Returns the default `Options`.
pub fn options() -> Options {
    Options {}
}

/// Returns the `last-event-id` header of `req`, which a reconnecting client sends to resume, or `none` when it is missing or empty.
pub fn last_event_id(req: http.Request) -> str? {
    let value = http.header(req.headers, "last-event-id") ?? ""
    if value.len == 0 {
        return none
    }
    value
}

/// Sends `e` to the client and returns `true`, or returns `false` when the request has been cancelled.
///
/// Blocks while the response is not keeping up. A `false` result means the client is gone and the producer should return.
pub fn send(em: *Emitter, e: Event) -> bool {
    let gone = cancel.done(em.token)
    select {
        em.events <- e => true
        <-gone => false
    }
}

fn head() -> []http.Header {
    [
        http.Header { name: "content-type", value: "text/event-stream" }
        http.Header { name: "cache-control", value: "no-cache" }
        http.Header { name: "x-accel-buffering", value: "no" }
    ]
}

fn offer(out: chan[[]u8], gone: chan[bool], payload: str) -> bool {
    select {
        out <- bytes(payload) => true
        <-gone => false
    }
}

fn relay(events: chan[Event], out: chan[[]u8], token: *cancel.Token, o: Options) {
    let gone = cancel.done(token)
    defer close(out)
    if o.retry >= 0 && !offer(out, gone, format(Event { retry: some(o.retry) })) {
        return
    }
    let quiet = if o.keepalive > 0 { o.keepalive } else { 31536000000 }
    for {
        let alive = select {
            ev = <-events => match ev {
                some(e) => offer(out, gone, format(e))
                none => false
            }
            <-gone => false
            after(quiet) => offer(out, gone, keepalive())
        }
        if !alive {
            return
        }
    }
}

fn produce(producer: fn(*Emitter), em: *Emitter) {
    producer(em)
    close(em.events)
}

fn reply(out: chan[[]u8]) -> http.Response {
    http.Response { status: 200, headers: head(), body: [], stream: some(out) }
}

/// Returns a streaming `200` response that writes each event received from `events` in the `text/event-stream` format.
///
/// The response has `content-type: text/event-stream`, `cache-control: no-cache` and `x-accel-buffering: no`. If `o.retry` is not negative it is sent first, and after `o.keepalive` milliseconds without an event a keepalive comment is sent. The stream ends when the caller closes `events` or the request is cancelled. Nothing reads `events` after cancellation, so a sender should watch `req.token`.
pub fn serve_events_with(req: http.Request, o: Options, events: chan[Event]) -> http.Response {
    let out = chan[[]u8](16)
    spawn relay(events, out, req.token, o)
    reply(out)
}

/// Returns the response of `serve_events_with` with the default `Options`.
pub fn serve_events(req: http.Request, events: chan[Event]) -> http.Response {
    serve_events_with(req, options(), events)
}

/// Returns a streaming response that runs `producer` on a new task and sends the events it passes to `send`.
///
/// The stream ends when `producer` returns. The producer should stop when `send` returns `false`.
pub fn stream_with(req: http.Request, o: Options, producer: fn(*Emitter)) -> http.Response {
    let events = chan[Event](16)
    let em = new(Emitter { token: req.token, events })
    spawn produce(producer, em)
    serve_events_with(req, o, events)
}

/// Returns the response of `stream_with` with the default `Options`.
pub fn stream(req: http.Request, producer: fn(*Emitter)) -> http.Response {
    stream_with(req, options(), producer)
}
