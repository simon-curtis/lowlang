import std/io
import std/http
import std/text

/// An incremental parser for a `text/event-stream` body.
///
/// It follows the WHATWG event stream rules: lines end in `\n`, `\r` or `\r\n`, a leading byte order mark is skipped, lines beginning with `:` are comments, unknown fields are ignored, and a blank line dispatches the event. A `Parser` keeps partial lines and a partial event between calls to `feed`, so chunks may be split anywhere.
pub struct Parser {
    /// The reconnection delay in milliseconds from the latest valid `retry` field the parser has seen, or `-1` when the stream has sent none.
    pub reconnect: i64
    line: []u8
    skip_lf: bool
    first: bool
    data: []u8
    has_data: bool
    kind: str
    last_id: str
    retry: i64
}

/// Returns a new `Parser` that has read nothing.
pub fn parser() -> *Parser {
    new(Parser { reconnect: -1, line: [], skip_lf: false, first: true, data: [], has_data: false, kind: "", last_id: "", retry: -1 })
}

fn strip_bom(line: []u8) -> []u8 {
    if line.len >= 3 && line[0] == 0xEF && line[1] == 0xBB && line[2] == 0xBF {
        return line[3..]
    }
    line
}

fn dispatch(p: *Parser, mut out: []Event) {
    let retry = p.retry
    p.retry = -1
    if !p.has_data {
        p.kind = ""
        return
    }
    var data = p.data
    if data.len > 0 && data[data.len - 1] == '\n' {
        data = data[..data.len - 1]
    }
    push(mut out, Event {
        id: if p.last_id.len > 0 { some(p.last_id) } else { none }
        event: if p.kind.len > 0 { some(p.kind) } else { none }
        data: str(data)
        retry: if retry >= 0 { some(retry) } else { none }
    })
    p.data = []
    p.has_data = false
    p.kind = ""
}

fn apply(p: *Parser, name: str, value: str) {
    if name == "data" {
        text.append(mut p.data, value)
        push(mut p.data, '\n')
        p.has_data = true
    } else if name == "event" {
        p.kind = value
    } else if name == "id" {
        if text.index_byte(value, 0) < 0 {
            p.last_id = value
        }
    } else if name == "retry" {
        let ms = text.parse_uint(value, 10) or return
        p.retry = ms
        p.reconnect = ms
    }
}

fn consume(p: *Parser, line: str, mut out: []Event) {
    if line.len == 0 {
        dispatch(p, mut out)
        return
    }
    if line[0] == ':' {
        return
    }
    let colon = text.index_byte(line, ':')
    if colon < 0 {
        apply(p, line, "")
        return
    }
    var value = line[colon + 1..]
    if value.len > 0 && value[0] == ' ' {
        value = value[1..]
    }
    apply(p, line[..colon], value)
}

fn finish_line(p: *Parser, mut out: []Event) {
    var raw = p.line
    if p.first {
        raw = strip_bom(raw)
        p.first = false
    }
    consume(p, str(raw), mut out)
    p.line = []
}

/// Parses `chunk` and returns the events it completes, in order.
///
/// An event is returned when its terminating blank line is read, and only if it had at least one `data` field. Multiple `data` lines are joined with `\n`. `Event.id` is the latest `id` the stream set, which carries over to later events and is `none` when that `id` was empty, `Event.event` is the `event` field if one was given, and `Event.retry` is set only on the event that followed a `retry` field. An `id` containing a zero byte is ignored, and so is a `retry` that is not all digits. Input after the last line ending stays in the parser until more arrives.
pub fn feed(p: *Parser, chunk: []u8) -> []Event {
    var out: []Event = []
    for b in chunk {
        if p.skip_lf {
            p.skip_lf = false
            if b == '\n' {
                continue
            }
        }
        if b == '\r' {
            p.skip_lf = true
            finish_line(p, mut out)
        } else if b == '\n' {
            finish_line(p, mut out)
        } else {
            push(mut p.line, b)
        }
    }
    out
}

/// Parses `data` as a complete event stream and returns its events.
///
/// An event not ended by a blank line is dropped.
pub fn parse(data: []u8) -> []Event {
    feed(parser(), data)
}

/// Sends the request built by `b` and calls `on_event` for each event of the response as it arrives, until the stream ends.
///
/// The request gets `accept: text/event-stream` and `cache-control: no-cache`. Returns the response, whose body is empty because it was delivered to `on_event`. Failures are those of `stream_to`; an error from `on_event` stops reading and is returned as `Io`. It does not reconnect or send `last-event-id`.
pub fn listen(b: http.Builder[http.Response], on_event: fn(Event) ! io.Error) -> http.Response ! http.Error {
    let p = parser()
    let request = b.with_header("accept", "text/event-stream").with_header("cache-control", "no-cache")
    request.stream_to(fn(chunk: []u8) ! io.Error {
        for e in feed(p, chunk) {
            on_event(e)?
        }
    })?
}
