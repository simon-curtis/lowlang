import std/base64
import std/cancel
import std/compress/deflate
import std/compress/brotli
import std/compress/zstd
import std/crypto
import std/crypto/x509
import std/file
import std/header
import std/io
import std/json
import std/net
import std/serde
import std/text
import std/tls
import std/uri

/// The failure of a client request or of a response helper.
///
/// A response with any status is a success for `send`; `ensure_success` turns a non-`2xx` status into `Status`. Whatever stage a request has reached, it fails with `Cancelled` when the token given to `with_cancel` has been cancelled.
pub enum Error {
    /// A URL could not be used. `url` holds the text at fault: the request URL when it does not parse or its scheme is not `http` or `https`, a `Location` header that does not parse or has another scheme, or the configured proxy URL when it is not valid.
    InvalidUrl(url: str)
    /// Opening the connection failed, including a failed name lookup, a refused or unreachable peer and a failed proxy handshake. `cause` is the underlying error. A connection attempt that runs out of time is `Timeout`.
    Connect(cause: io.Error)
    /// The TLS handshake failed, including a server certificate that does not verify. `cause` is the underlying error.
    Tls(cause: io.Error)
    /// The request ran out of time: the limit from `with_timeout` passed, a connection attempt took longer than `with_connect_timeout`, or a read or write on the connection timed out.
    Timeout
    /// The response was a redirect after the limit from `with_redirects` was used up. `count` is the number of redirects followed.
    TooManyRedirects(count: i64)
    /// The peer sent a response that is not valid HTTP, or one the client does not support. `cause` is `Malformed`, `TooLarge` or `Unsupported`.
    Protocol(cause: io.Error)
    /// The body could not be decompressed according to its `content-encoding`. `cause` is the decoder's error. It only occurs while decompression is on.
    Decode(cause: io.Error)
    /// The body did not deserialize into the requested type, as returned by `json`. `cause` is the `serde.Error`.
    Json(cause: serde.Error)
    /// The status was outside `200` to `299`, as returned by `ensure_success`. `code` is the status.
    Status(code: i64)
    /// Any other failure while sending the request or receiving the response, such as a connection that resets or closes early, a request header that is not valid, a request body reader that fails, or the sink given to `stream_to` failing. `cause` is the underlying error.
    Io(cause: io.Error)
    /// The token given to `with_cancel` was cancelled. The connection in use is closed.
    Cancelled
}

/// A configuration under construction: a client when `K` is `Client`, a single request when `K` is `Response`.
///
/// `client()` returns a `Builder[Client]` and `build` turns it into a `Client`. `request` returns a `Builder[Response]` that `send`, `stream_to` or `download` runs. Each `with_*` function returns an updated copy and leaves its argument unchanged. The functions that are generic in `K` apply to either kind; the rest apply to one. A request starts with the client's headers, timeout, connect timeout, redirect limit, retry count, version, prior knowledge and decompression settings. The fields are private.
///
/// ```low
/// let client = http.client().with_timeout(5000).with_retries(2).build()
/// let resp = client.request("POST", "https://example.com/items").with_text("hello").send() catch {
///     _ => return
/// }
/// ```
pub struct Builder[K] {
    base_url: str = ""
    headers: []header.Header = []
    timeout: i64 = 0
    connect_timeout: i64 = 0
    redirects: i64 = 10
    retries: i64 = 0
    cookies: bool = false
    http_proxy: str = ""
    https_proxy: str = ""
    no_proxy: []str = []
    dialer: net.Dialer? = none
    jar: CookieJar? = none
    version: Version = Http2
    prior_knowledge: bool = false
    max_per_host: i64 = 0
    idle_timeout: i64 = 90000
    decompression: bool = true
    tls: tls.Config = tls.Config {}
    device: str = ""
    resolver: fn(str) -> [][]u8 ! io.Error = net.lookup
    token: *cancel.Token? = none
    client: *Client? = none
    method: str = "GET"
    url: str = ""
    query: []uri.Field = []
    body: []u8 = []
    source: *io.Reader? = none
}

/// A pooled HTTP client, made by `build`.
///
/// It keeps HTTP/1.1 connections alive and reuses them after a response has been read in full, and sends concurrent requests to an HTTPS host, or to any host with `with_prior_knowledge`, over one multiplexed HTTP/2 connection when the server accepts it. It is safe to use from several tasks. It holds no drop: idle connections are closed after the idle timeout or by `close_idle`. Its fields are private.
pub struct Client {
    options: Builder[Client]
    lock: chan[bool]
    hosts: [str: *Host]
    jar: CookieJar?
    reaper: *Reaper
    tidying: bool
}

/// An open connection returned by `connect`, either plain TCP or TLS.
///
/// Releasing a `Connection` closes its stream unless `detach` was called.
pub struct Connection {
    /// The stream to read from and write to the connection. Closing it closes the connection.
    pub stream: io.Stream
    /// The ALPN protocol the server selected, for example `h2` or `http/1.1`. Empty for a plain connection and when TLS negotiated none.
    pub protocol: str
    /// `true` for a TLS connection, from an `https` or `wss` URL.
    pub secure: bool
    detached: bool = false
    drop {
        if !detached {
            stream.close()
        }
    }
}

struct Outgoing {
    method: str
    url: Url
    headers: []header.Header
    body: []u8
    source: *io.Reader?
    absolute: bool = false
    proxy_auth: str = ""
}

struct Incoming {
    status: i64
    headers: []header.Header
    version: Version
    body: io.Stream
    length: i64
    attempt: *Attempt
    finish: fn(bool)
}

struct Framing {
    reader: *io.Reader
    attempt: *Attempt
    mode: Mode
    left: i64
    first: bool
    done: bool
}

enum Mode {
    Empty
    Length
    Chunked
    UntilClose
}

struct Head1 {
    status: i64
    headers: []header.Header
    keep: bool
}

struct Inflow {
    pending: []u8
    done: bool
}

struct Collector {
    data: []u8
    size: i64
}

enum Outcome[T] {
    Done(T)
    Failed(io.Error)
}

fn outcome[T](op: fn() -> T ! io.Error) -> Outcome[T] {
    let v = op() catch {
        e => return Failed(e)
    }
    Done(v)
}

/// Opens a connection to the host and port of `u` and returns it as a `Connection`.
///
/// The scheme must be `http`, `ws`, `https` or `wss`, or the call fails with `Unsupported`. The host is resolved and connected with `net.dial`; no client settings, proxy or timeout option apply. For `https` and `wss` a TLS handshake follows, with `protocols` offered through ALPN, `u.host` as the server name and the certificate checked against the system roots; `protocols` is ignored for a plain connection. Blocks until the connection is ready, and fails with the error of the connection or the handshake.
pub fn connect(u: Url, protocols: []str) -> Connection ! io.Error {
    let secure = secure_scheme(u.scheme)
    if !secure && u.scheme != "http" && u.scheme != "ws" {
        fail Unsupported
    }
    using var c = net.dial(u.host, u.port)?
    if !secure {
        let plain = net.detach(mut c)
        return Connection { stream: net.stream_on(plain), protocol: "", secure }
    }
    let carrier = net.stream(c)
    let t = tls.client_handle(carrier, tls.Config { alpn: protocols, server_name: u.host })?
    net.detach(mut c)
    Connection { stream: tls.stream_on(t), protocol: t.protocol, secure }
}

/// Stops `c` from closing its stream when released, and returns the stream.
///
/// The caller becomes responsible for closing it.
pub fn detach(mut c: Connection) -> io.Stream {
    c.detached = true
    c.stream
}

/// Returns a `Builder[Client]` with the default settings.
///
/// By default there is no timeout and no connect timeout, up to 10 redirects are followed, there are no retries, cookies and proxies are off, HTTP/2 is used where available, response decompression is on, certificates are verified against the system roots, connections per host are unlimited and idle connections are kept for 90 seconds.
pub fn client() -> Builder[Client] {
    Builder[Client] {}
}

/// Returns the `Client` for the settings in `b`.
///
/// The settings are copied, so later changes to `b` do not reach the client. When `b` has a jar from `with_cookie_jar` the client uses it; otherwise `with_cookies` gives it a new private jar, and without either it keeps no cookies. No connection is made until the first request.
pub fn build(b: Builder[Client]) -> *Client {
    new(Client {
        options: b
        lock: chan[bool](1)
        hosts: [:]
        jar: match b.jar {
            some(j) => some(j)
            none => if b.cookies { some(cookie_jar()) } else { none }
        }
        reaper: new_reaper()
        tidying: false
    })
}

/// Sets the header `name` to `value` on every request, replacing any header of that name, ignoring case.
///
/// The name is sent as written. On a client builder the header is a default for all its requests; on a request builder it replaces the client's header of that name for that request. A name or value that is not valid fails the request with `Io(Invalid)`. Headers the client adds itself, `user-agent`, `accept`, `accept-encoding` and `authorization` from the URL's user information, are skipped when one of that name is set.
pub fn with_header[K](b: Builder[K], name: str, value: str) -> Builder[K] {
    var out = b
    var headers: []header.Header = []
    for h in b.headers {
        if !text.equal_fold(h.name, name) {
            push(mut headers, h)
        }
    }
    push(mut headers, header.Header { name, value })
    out.headers = headers
    out
}

/// Sets the `user-agent` header. Without it the client sends `lowlang-http/1`.
pub fn with_user_agent[K](b: Builder[K], agent: str) -> Builder[K] {
    with_header(b, "user-agent", agent)
}

/// Sets the `authorization` header to `Bearer ` followed by `token`.
///
/// The header is dropped when a redirect leads to another origin.
pub fn with_bearer_token[K](b: Builder[K], token: str) -> Builder[K] {
    with_header(b, "authorization", "Bearer {token}")
}

/// Sets the `authorization` header to HTTP Basic credentials for `user` and `password`.
///
/// The header is dropped when a redirect leads to another origin. A URL with user information gets the same header when none is set.
pub fn with_basic_auth[K](b: Builder[K], user: str, password: str) -> Builder[K] {
    with_header(b, "authorization", basic_credentials(user, password))
}

/// Sets the header `name` to the key `value`, as `with_header` does.
pub fn with_api_key[K](b: Builder[K], name: str, value: str) -> Builder[K] {
    with_header(b, name, value)
}

/// Sets the time limit for a request, in milliseconds.
///
/// The limit covers the whole request: connecting, sending, redirects, retries and reading the whole body, including time spent in the `stream_to` sink. A request that exceeds it fails with `Timeout` and its connection is closed. `0`, the default, sets no limit.
pub fn with_timeout[K](b: Builder[K], millis: i64) -> Builder[K] {
    var out = b
    out.timeout = millis
    out
}

/// Sets the time limit for the TCP connection to the target, or to the proxy, in milliseconds.
///
/// A connection that is not established in time fails with `Timeout`. The time left under `with_timeout` also bounds it. Name lookup and proxy negotiation are not counted. `0`, the default, sets no limit of its own.
pub fn with_connect_timeout[K](b: Builder[K], millis: i64) -> Builder[K] {
    var out = b
    out.connect_timeout = millis
    out
}

/// Binds every connection the client makes to the network interface named `device`, for example `eth0`. An empty name, the default, leaves the choice to the system. It does not apply to connections opened by `with_dialer`.
pub fn with_interface(b: Builder[Client], device: str) -> Builder[Client] {
    var out = b
    out.device = device
    out
}

/// Sets the function that turns a host name into addresses, in place of `net.lookup`.
///
/// It is called for the target host, or for the proxy host when a proxy is used, and returns the addresses to try in order. TLS still uses the host name for SNI and certificate checks. A failure from it is a connection failure. It does not apply to connections opened by `with_dialer`.
pub fn with_resolver(b: Builder[Client], resolver: fn(str) -> [][]u8 ! io.Error) -> Builder[Client] {
    var out = b
    out.resolver = resolver
    out
}

/// Sets a token that, once cancelled, aborts the request.
///
/// The connection in use is closed and the request fails with `Cancelled`, whatever it was doing. Set it on the builder returned by `request`; a token set on a client builder is not carried to its requests.
pub fn with_cancel[K](b: Builder[K], token: *cancel.Token) -> Builder[K] {
    var out = b
    out.token = some(token)
    out
}

/// Sets how many redirects a request follows, `10` by default.
///
/// Responses `301`, `302`, `303`, `307` and `308` with a `location` header are followed. `301`, `302` and `303` turn the request into a `GET` with no body, except that `HEAD` stays `HEAD`; `307` and `308` repeat the method and body, but a request with a body from `with_body_reader` is not followed and its redirect response is returned. `authorization`, `cookie` and `proxy-authorization` are dropped when the target has another origin. A request that has used up the limit fails with `TooManyRedirects`, and a `location` that is not an `http` or `https` URL fails with `InvalidUrl`. `0` or less returns every redirect response as it is. `Response.url` holds the final URL.
pub fn with_redirects[K](b: Builder[K], max: i64) -> Builder[K] {
    var out = b
    out.redirects = max
    out
}

/// Sets how many times a failed request is sent again, `0` by default.
///
/// A request is retried only when its body can be replayed, so not with `with_body_reader`. A failed connection attempt is retried for any method. For `GET`, `HEAD`, `PUT`, `DELETE`, `OPTIONS` and `TRACE`, a connection that resets, closes early, times out or breaks after it opened, and a response with status `429`, `502`, `503` or `504`, are also retried. A TLS handshake failure is not. The first retry waits 100 ms and each later one doubles the wait, up to 6.4 s, or the whole seconds in a `retry-after` header when that is longer, up to 30 s. A retry that would not fit in the time left under `with_timeout` is not made, and the last failure or response is returned.
///
/// Separately from this setting, a replayable request on a pooled connection that the server had already closed is sent once more on a new connection.
pub fn with_retries[K](b: Builder[K], n: i64) -> Builder[K] {
    var out = b
    out.retries = n
    out
}

/// Sets the HTTP version to use. `Http2`, the default, offers HTTP/2 and falls back to HTTP/1.1 when the server does not accept it; `Http1` always uses HTTP/1.1.
///
/// HTTP/2 is negotiated through ALPN on `https` and is not used through a forwarding proxy. Plain `http` uses HTTP/2 only with `with_prior_knowledge`.
pub fn with_version[K](b: Builder[K], v: Version) -> Builder[K] {
    var out = b
    out.version = v
    out
}

/// Sets whether plain `http` requests start HTTP/2 directly, without negotiation, `false` by default.
///
/// Only enable it for servers known to speak HTTP/2 over cleartext. It has no effect with `with_version` set to `Http1`.
pub fn with_prior_knowledge[K](b: Builder[K], on: bool) -> Builder[K] {
    var out = b
    out.prior_knowledge = on
    out
}

/// Sets whether the client asks for and decodes compressed responses, `true` by default.
///
/// When on, a request without an `accept-encoding` header sends `gzip, deflate, br, zstd`, and a body with `content-encoding` of `gzip`, `x-gzip`, `deflate`, `br` or `zstd` is decoded. The response then has no `content-encoding` header, and `send` sets `content-length` to the decoded length. A body that cannot be decoded fails with `Decode`. When off, no header is added and the body is returned as received.
pub fn with_decompression[K](b: Builder[K], on: bool) -> Builder[K] {
    var out = b
    out.decompression = on
    out
}

/// Sets the URL that relative request URLs are resolved against, as `resolve` does, so `/items` with the base `https://example.com/api/` becomes `https://example.com/items`.
///
/// A request URL that has a scheme is used as it is.
pub fn with_base_url(b: Builder[Client], url: str) -> Builder[Client] {
    var out = b
    out.base_url = url
    out
}

/// Gives the client its own cookie jar, which stores the cookies from every response and sends matching ones with every request.
///
/// Cookies set by a redirect response are kept for the following hop, and a `cookie` header set on the request is sent before the jar's cookies. `with_cookie_jar` takes precedence.
pub fn with_cookies(b: Builder[Client]) -> Builder[Client] {
    var out = b
    out.cookies = true
    out
}

/// Gives the client the shared jar `jar`, so that several clients can use the same cookies. It takes precedence over `with_cookies`.
pub fn with_cookie_jar(b: Builder[Client], jar: CookieJar) -> Builder[Client] {
    var out = b
    out.jar = some(jar)
    out
}

/// Limits the open HTTP/1.1 connections the client keeps to one host to `n`.
///
/// A request over the limit waits until a connection is free, or fails with `Timeout` when the request time runs out. `0`, the default, sets no limit. HTTP/2 requests share one connection per host and are not counted.
pub fn with_max_connections_per_host(b: Builder[Client], n: i64) -> Builder[Client] {
    var out = b
    out.max_per_host = n
    out
}

/// Sets how long an unused pooled connection is kept, in milliseconds, `90000` by default.
///
/// A connection idle for longer is closed rather than reused, and a background sweep closes them while the client has connections.
pub fn with_idle_timeout(b: Builder[Client], millis: i64) -> Builder[Client] {
    var out = b
    out.idle_timeout = millis
    out
}

/// Sets the TLS configuration for `https` connections, replacing the earlier one including `with_roots`, `with_insecure` and `with_groups`.
///
/// The client overwrites `config.alpn` with the protocols it negotiates, and uses the host of the request as `config.server_name` when that is empty.
pub fn with_tls(b: Builder[Client], config: tls.Config) -> Builder[Client] {
    var out = b
    out.tls = config
    out
}

/// Sets the certificates that server certificate chains are verified against. With an empty list, the default, the system roots are used.
pub fn with_roots(b: Builder[Client], roots: []x509.Certificate) -> Builder[Client] {
    var out = b
    out.tls.roots = roots
    out
}

/// Turns off verification of server certificates, so that any `https` server is accepted and the connection can be intercepted. Use it for tests only.
pub fn with_insecure(b: Builder[Client]) -> Builder[Client] {
    var out = b
    out.tls.verify = false
    out
}

/// Sets the TLS key exchange groups the client offers, as IANA named group numbers in preference order.
///
/// The default is `0x11EC` (X25519MLKEM768), `0x001D` (X25519), `0x0017` (secp256r1) and `0x0018` (secp384r1).
pub fn with_groups(b: Builder[Client], groups: []i64) -> Builder[Client] {
    var out = b
    out.tls.groups = groups
    out
}

/// Returns a request builder for `method` and `url` on `c`.
///
/// Run it with `send`, `stream_to` or `download`. The method is sent as given. `url` is resolved against the client's base URL when it has no scheme, and its scheme must be `http` or `https`; anything else fails the request with `InvalidUrl` when it runs. The builder starts with the client's headers, timeout, connect timeout, redirect limit, retry count, version, prior knowledge and decompression settings.
pub fn request(c: *Client, method: str, url: str) -> Builder[Response] {
    let o = c.options
    Builder[Response] {
        headers: o.headers
        timeout: o.timeout
        connect_timeout: o.connect_timeout
        redirects: o.redirects
        retries: o.retries
        version: o.version
        prior_knowledge: o.prior_knowledge
        decompression: o.decompression
        client: c
        method
        url
    }
}

/// Appends `name=value` to the query of the request URL, percent-encoding both parts.
///
/// Existing query parameters, including repeated names, are kept.
pub fn with_query(b: Builder[Response], name: str, value: str) -> Builder[Response] {
    var out = b
    var query = b.query
    push(mut query, uri.Field { name, value })
    out.query = query
    out
}

/// Sets the request body to `body` and the `content-type` header to `content_type`, replacing any earlier body or body reader.
pub fn with_body(b: Builder[Response], body: []u8, content_type: str) -> Builder[Response] {
    var out = with_header(b, "content-type", content_type)
    out.body = body
    out.source = none
    out
}

/// Sets the request body to the bytes of `body`, with `content-type` set to `text/plain; charset=utf-8`.
pub fn with_text(b: Builder[Response], body: str) -> Builder[Response] {
    with_body(b, bytes(body), "text/plain; charset=utf-8")
}

/// Sets the request body to `value` serialized with `json.serialize`, with `content-type` set to `application/json`.
pub fn with_json[T](b: Builder[Response], value: T) -> Builder[Response] {
    with_body(b, bytes(json.serialize(value)), "application/json")
}

/// Sets the request body to `fields` encoded as `application/x-www-form-urlencoded`, with that `content-type`.
pub fn with_form(b: Builder[Response], fields: []uri.Field) -> Builder[Response] {
    let body = uri.encode_form(fields)
    with_body(b, bytes(body), "application/x-www-form-urlencoded")
}

/// Sets the request body to be read from `source` as the request is sent, with the `content-type` header `content_type`, replacing any earlier body.
///
/// The length is not known in advance, so the body is sent with chunked transfer coding on HTTP/1.1 and as DATA frames on HTTP/2. `source` is read once, so the request is never retried and a `307` or `308` redirect is not followed. A read error from `source` fails the request.
pub fn with_body_reader(b: Builder[Response], source: *io.Reader, content_type: str) -> Builder[Response] {
    var out = with_header(b, "content-type", content_type)
    out.body = []
    out.source = source
    out
}

fn joined(a: []u8, b: []u8) -> []u8 {
    let out: []u8 = __make(a.len + b.len)
    __memmove(out, a)
    __memmove(out[a.len..], b)
    out
}

fn basic_credentials(user: str, password: str) -> str {
    "Basic {base64.encode(bytes("{user}:{password}"))}"
}

/// Sends the request and returns the response with its whole body read into `Response.body`.
///
/// Blocks until the body has arrived. Any status is a success; use `ensure_success` to treat other than `2xx` as an error. Redirects, retries, cookies and decompression follow the settings of the builder. The response has the final `url`, the `version` it arrived on, and any `trailers`. A response to `HEAD`, `1xx`, `204` or `304` has an empty body. A body over 64 MiB fails with a `TooLarge` cause. Failures are the variants of `Error`.
pub fn send(b: Builder[Response]) -> Response ! Error {
    perform(b, true, fn(chunk: []u8) ! io.Error {})
}

/// Sends the request and passes the body to `sink` in chunks as it arrives, without holding it in memory.
///
/// The returned response has the status, headers, `url`, `version` and `trailers` but an empty `body`. `sink` is called after redirects have been followed and decompression applied, and its failure fails the request with `Io`, closing the connection. Failures are the variants of `Error`.
pub fn stream_to(b: Builder[Response], sink: fn([]u8) ! io.Error) -> Response ! Error {
    perform(b, false, sink)
}

/// Sends the request and writes the body to the file at `path`, creating it or truncating it.
///
/// The returned response has an empty `body`. The file is written whatever the status, so call `ensure_success` on the result and remove the file for a status that is not wanted. When the request fails part way, the file is removed. A file that cannot be created fails with `Io(Denied)`, whatever the cause.
pub fn download(b: Builder[Response], path: str) -> Response ! Error {
    using f = file.create(path) catch {
        _ => fail Io(Denied)
    }
    let target = f.handle
    let resp = perform(b, false, fn(chunk: []u8) ! io.Error { file.write_all_on(target, chunk)? }) catch {
        e => {
            file.remove(path) catch {
                _ => {}
            }
            fail e
        }
    }
    resp
}

/// Sends a `GET` request to `url` and returns the response, as `send` does.
pub fn get(c: *Client, url: str) -> Response ! Error {
    send(request(c, "GET", url))
}

/// Sends a `HEAD` request to `url` and returns the response, as `send` does. The body is empty.
pub fn head(c: *Client, url: str) -> Response ! Error {
    send(request(c, "HEAD", url))
}

/// Sends a `DELETE` request to `url` and returns the response, as `send` does.
pub fn del(c: *Client, url: str) -> Response ! Error {
    send(request(c, "DELETE", url))
}

/// Sends a `POST` request to `url` with `body` as the content of type `content_type`, and returns the response as `send` does.
pub fn post(c: *Client, url: str, content_type: str, body: []u8) -> Response ! Error {
    send(with_body(request(c, "POST", url), body, content_type))
}

/// Sends a `PUT` request to `url` with `body` as the content of type `content_type`, and returns the response as `send` does.
pub fn put(c: *Client, url: str, content_type: str, body: []u8) -> Response ! Error {
    send(with_body(request(c, "PUT", url), body, content_type))
}

/// Sends a `PATCH` request to `url` with `body` as the content of type `content_type`, and returns the response as `send` does.
pub fn patch(c: *Client, url: str, content_type: str, body: []u8) -> Response ! Error {
    send(with_body(request(c, "PATCH", url), body, content_type))
}

/// Returns the body of `resp` as a string, taking its bytes as they are without checking the encoding.
pub fn text(resp: Response) -> str {
    str(resp.body)
}

/// Deserializes the body of `resp` as JSON into `T`.
///
/// Fails with `Json` holding the `serde.Error` when the body is not valid JSON or does not fit `T`. The status is not checked; call `ensure_success` first.
pub fn json[T](resp: Response) -> T ! Error {
    json.deserialize[T](resp.body) catch {
        Syntax(at, message) => fail Json(serde.Error.Syntax(at, message))
        Mismatch(expected, at) => fail Json(serde.Error.Mismatch(expected, at))
        Missing(field) => fail Json(serde.Error.Missing(field))
        UnknownVariant(name) => fail Json(serde.Error.UnknownVariant(name))
        Range(at) => fail Json(serde.Error.Range(at))
        TooDeep => fail Json(serde.Error.TooDeep)
    }
}

/// Returns `resp` when its status is `200` to `299`, and fails with `Status` holding the status otherwise.
pub fn ensure_success(resp: Response) -> Response ! Error {
    if resp.status < 200 || resp.status > 299 {
        fail Status(resp.status)
    }
    resp
}

/// Returns the value of the first header of `resp` named `name`, ignoring case, or `none` when there is none.
pub fn header_value(resp: Response, name: str) -> str? {
    header.get(resp.headers, name)
}

/// Returns the values of every header of `resp` named `name`, ignoring case, in the order received. The slice is empty when there are none.
pub fn header_values(resp: Response, name: str) -> []str {
    var out: []str = []
    for h in resp.headers {
        if text.equal_fold(h.name, name) {
            push(mut out, h.value)
        }
    }
    out
}

/// Returns the `cookie` header value that the jar of `c` would send to `url`.
///
/// Returns an empty string when `c` has no jar, `url` does not parse, or no cookie matches.
pub fn cookies_for(c: *Client, url: str) -> str {
    let u = parse_url(url) catch {
        _ => return ""
    }
    match c.jar {
        some(j) => cookie_header(j, u)
        none => ""
    }
}

/// Closes the idle pooled connections of `c`.
///
/// HTTP/1.1 connections that are idle are closed, and an HTTP/2 connection is closed once its in-flight requests finish. Requests in flight are not interrupted, and later requests open new connections.
pub fn close_idle(c: *Client) {
    c.lock <- true
    var hosts: []*Host = []
    for _, h in c.hosts {
        push(mut hosts, h)
    }
    <-c.lock
    for h in hosts {
        h.lock <- true
        let idle = h.idle
        h.idle = []
        h.open -= idle.len
        let current = h.mux
        h.mux = none
        <-h.lock
        for conn in idle {
            conn.wire.stream.close()
        }
        match current {
            some(m) => drain_mux(m)
            none => {}
        }
    }
}

fn target_url(c: *Client, b: Builder[Response]) -> Url ! io.Error {
    let base = c.options.base_url
    var u = if base.len > 0 && uri.scheme_end(b.url) <= 0 { resolve(parse_url(base)?, b.url)? } else { parse_url(b.url)? }
    if u.scheme != "http" && u.scheme != "https" {
        fail Unsupported
    }
    for q in b.query {
        u = with_query_pair(u, q.name, q.value)
    }
    u
}

fn request_headers(b: Builder[Response], u: Url) -> []header.Header {
    var headers = b.headers
    if !header.has(headers, "user-agent") {
        push(mut headers, header.Header { name: "user-agent", value: "lowlang-http/1" })
    }
    if !header.has(headers, "accept") {
        push(mut headers, header.Header { name: "accept", value: "*/*" })
    }
    if b.decompression && !header.has(headers, "accept-encoding") {
        push(mut headers, header.Header { name: "accept-encoding", value: "gzip, deflate, br, zstd" })
    }
    if u.user.len > 0 && !header.has(headers, "authorization") {
        push(mut headers, header.Header { name: "authorization", value: basic_credentials(u.user, u.password) })
    }
    headers
}

fn without_headers(headers: []header.Header, names: []str) -> []header.Header {
    var out: []header.Header = []
    for h in headers {
        var dropped = false
        for name in names {
            if text.equal_fold(h.name, name) {
                dropped = true
            }
        }
        if !dropped {
            push(mut out, h)
        }
    }
    out
}

fn redirect_status(status: i64) -> bool {
    status == 301 || status == 302 || status == 303 || status == 307 || status == 308
}

fn perform(b: Builder[Response], collect: bool, sink: fn([]u8) ! io.Error) -> Response ! Error {
    let token = b.token
    let resp = follow(b, collect, sink) catch {
        e => fail if stopped(token) { Cancelled } else { e }
    }
    resp
}

fn stopped(token: *cancel.Token?) -> bool {
    match token {
        some(t) => cancel.cancelled(t)
        none => false
    }
}

fn follow(b: Builder[Response], collect: bool, sink: fn([]u8) ! io.Error) -> Response ! Error {
    let c = match b.client {
        some(c) => c
        none => fail InvalidUrl(b.url)
    }
    var url = target_url(c, b) catch {
        _ => fail InvalidUrl(b.url)
    }
    let d = arm(c.reaper, b.timeout, b.token)
    using armed = Armed { reaper: c.reaper, deadline: d }
    let job = Job { client: c, deadline: d, connect_timeout: b.connect_timeout, version: b.version, prior_knowledge: b.prior_knowledge }
    var req = Outgoing { method: b.method, url, headers: request_headers(b, url), body: b.body, source: b.source }
    let trace = tracing()
    var hops = 0
    for {
        let inc = attempt(job, b, req, trace)?
        match c.jar {
            some(j) => store_cookies(j, req.url, inc.headers)
            none => {}
        }
        let location = header.get(inc.headers, "location") ?? ""
        let keeps_body = inc.status == 307 || inc.status == 308
        let follow = b.redirects > 0 && location.len > 0 && redirect_status(inc.status) && !(keeps_body && req.source != none)
        if !follow {
            return finish_response(job, inc, req.url, b.decompression, collect, sink, trace)
        }
        let version = version_text(inc.version)
        let next = resolve(req.url, location) catch {
            _ => {
                inc.finish(false)
                settle(trace, inc.status, version, "InvalidUrl")
                fail InvalidUrl(location)
            }
        }
        if next.scheme != "http" && next.scheme != "https" {
            inc.finish(false)
            settle(trace, inc.status, version, "InvalidUrl")
            fail InvalidUrl(location)
        }
        if hops == b.redirects {
            inc.finish(false)
            settle(trace, inc.status, version, "TooManyRedirects")
            fail TooManyRedirects(hops)
        }
        discard(inc)
        settle(trace, inc.status, version, "")
        hops += 1
        if !keeps_body && req.method != "HEAD" {
            req.method = "GET"
            req.body = []
            req.source = none
            req.headers = without_headers(req.headers, ["content-type", "content-length", "transfer-encoding"])
        }
        if origin(next) != origin(req.url) {
            req.headers = without_headers(req.headers, ["authorization", "cookie", "proxy-authorization"])
        }
        req.url = next
    }
}

fn idempotent(method: str) -> bool {
    method == "GET" || method == "HEAD" || method == "PUT" || method == "DELETE" || method == "OPTIONS" || method == "TRACE"
}

fn retry_status(status: i64) -> bool {
    status == 429 || status == 502 || status == 503 || status == 504
}

fn transport_failure(e: io.Error) -> bool {
    match e {
        Reset => true
        Eof => true
        BrokenPipe => true
        Refused => true
        Unreachable => true
        Aborted => true
        NotConnected => true
        TimedOut => true
        _ => false
    }
}

fn backoff(tries: i64, headers: []header.Header) -> i64 {
    let shift = if tries > 6 { 6 } else { tries }
    var wait = 100 << shift
    let after = text.parse_uint(text.trim(header.get(headers, "retry-after") ?? ""), 10) catch -1
    if after >= 0 && after * 1000 > wait {
        wait = after * 1000
    }
    if wait > 30000 { 30000 } else { wait }
}

fn fits(d: *Deadline, wait: i64) -> bool {
    let left = remaining(d)
    left == 0 || left > wait
}

fn attempt(job: Job, b: Builder[Response], base: Outgoing, trace: *Trace?) -> Incoming ! Error {
    let c = job.client
    let h = host_for(c, base.url)
    let route = via(c.options, base.url) catch {
        _ => fail InvalidUrl(proxy_setting(c.options, base.url))
    }
    var req = base
    match route {
        Forward(p) => {
            req.absolute = true
            req.proxy_auth = proxy_credentials(p)
        }
        _ => {}
    }
    match c.jar {
        some(j) => {
            let jar_cookies = cookie_header(j, req.url)
            if jar_cookies.len > 0 {
                let own = header.get(req.headers, "cookie") ?? ""
                header.set(mut req.headers, "cookie", if own.len > 0 { "{own}; {jar_cookies}" } else { jar_cookies })
            }
        }
        none => {}
    }
    let replayable = req.source == none
    let safe = idempotent(req.method)
    var tries = 0
    var fresh = false
    var avoid: *Mux? = none
    var stale_retried = false
    for {
        let a = new_attempt(fresh, avoid, route)
        fresh = false
        avoid = none
        let announced = announce(trace, req)
        let result = outcome(fn() -> Incoming ! io.Error { open(job, h, announced, a) })
        match result {
            Done(inc) => {
                if safe && replayable && tries < b.retries && retry_status(inc.status) {
                    let wait = backoff(tries, inc.headers)
                    if fits(job.deadline, wait) {
                        discard(inc)
                        settle(trace, inc.status, version_text(inc.version), "")
                        sleep(wait)
                        tries += 1
                        continue
                    }
                }
                return inc
            }
            Failed(e) => {
                if expired(job.deadline) {
                    settle(trace, 0, "", "Timeout")
                    fail Timeout
                }
                let failure = classify(e, a)
                settle(trace, 0, "", error_name(failure))
                if a.stale && replayable && !stale_retried {
                    stale_retried = true
                    fresh = true
                    avoid = a.used
                    continue
                }
                let retryable = a.phase == Connecting || safe && a.phase != Handshaking && transport_failure(e)
                if retryable && replayable && tries < b.retries {
                    let wait = backoff(tries, [])
                    if fits(job.deadline, wait) {
                        sleep(wait)
                        tries += 1
                        fresh = true
                        avoid = a.used
                        continue
                    }
                }
                fail failure
            }
        }
    }
}

fn classify(e: io.Error, a: *Attempt) -> Error {
    if a.sinking {
        return Io(e)
    }
    match a.phase {
        Connecting => if e == io.Error.TimedOut { Timeout } else { Connect(e) }
        Handshaking => Tls(e)
        Decoding => if a.broken { transport_error(e) } else { Decode(e) }
        _ => transport_error(e)
    }
}

fn transport_error(e: io.Error) -> Error {
    match e {
        Malformed => Protocol(e)
        TooLarge => Protocol(e)
        Unsupported => Protocol(e)
        TimedOut => Timeout
        _ => Io(e)
    }
}

fn open(job: Job, h: *Host, req: Outgoing, a: *Attempt) -> Incoming ! io.Error {
    match acquire(job, h, req.url, a)? {
        Single(conn) => exchange1(job, conn, req, a)
        Multiplexed(m) => exchange2(job, m, req, a)
    }
}

fn discard(inc: Incoming) {
    let buf = io.buffer(16384)
    var total = 0
    for total < 1 << 20 {
        let n = inc.body.read(buf) catch {
            _ => {
                inc.finish(false)
                return
            }
        }
        if n == 0 {
            inc.finish(true)
            return
        }
        total += n
    }
    inc.finish(false)
}

fn finish_response(job: Job, inc: Incoming, u: Url, decode: bool, collect: bool, sink: fn([]u8) ! io.Error, trace: *Trace?) -> Response ! Error {
    let a = inc.attempt
    a.phase = Receiving
    a.broken = false
    a.sinking = false
    let encoding = if decode { text.lower(text.trim(header.get(inc.headers, "content-encoding") ?? "")) } else { "" }
    let decoded = encoding == "gzip" || encoding == "x-gzip" || encoding == "deflate" || encoding == "br" || encoding == "zstd"
    let delivered = outcome(fn() -> []u8 ! io.Error { deliver_body(inc, if decoded { encoding } else { "" }, collect, sink) })
    let body = match delivered {
        Done(body) => body
        Failed(e) => {
            inc.finish(false)
            let version = version_text(inc.version)
            if expired(job.deadline) {
                settle(trace, inc.status, version, "Timeout")
                fail Timeout
            }
            let failure = classify(e, a)
            settle(trace, inc.status, version, error_name(failure))
            fail failure
        }
    }
    inc.finish(true)
    settle(trace, inc.status, version_text(inc.version), "")
    var headers = inc.headers
    if decoded {
        headers = without_headers(headers, ["content-encoding", "content-length"])
        if collect {
            push(mut headers, header.Header { name: "content-length", value: "{body.len}" })
        }
    }
    Response { status: inc.status, headers, body, url: format_url(u), version: inc.version, trailers: a.trailers }
}

fn collect_into(c: *Collector, chunk: []u8) ! io.Error {
    if c.size + chunk.len > max_body() {
        fail TooLarge
    }
    if c.size + chunk.len > c.data.len {
        var capacity = c.data.len * 2
        if capacity < c.size + chunk.len {
            capacity = c.size + chunk.len
        }
        if capacity < 16384 {
            capacity = 16384
        }
        let grown: []u8 = __make(capacity)
        __memmove(grown, c.data[..c.size])
        c.data = grown
    }
    __memmove(c.data[c.size..], chunk)
    c.size += chunk.len
}

fn deliver_body(inc: Incoming, encoding: str, collect: bool, sink: fn([]u8) ! io.Error) -> []u8 ! io.Error {
    let a = inc.attempt
    if collect && encoding.len == 0 && inc.length >= 0 {
        return read_known(inc)
    }
    let collector = new(Collector { data: [], size: 0 })
    let target = fn(chunk: []u8) ! io.Error {
        a.sinking = true
        if collect {
            collect_into(collector, chunk)?
        } else {
            sink(chunk)?
        }
        a.sinking = false
    }
    if encoding.len == 0 {
        let buf = io.buffer(65536)
        for {
            let n = inc.body.read(buf)?
            if n == 0 {
                break
            }
            target(buf[..n])?
        }
        return collector.data[..collector.size]
    }
    let first = io.buffer(2)
    var got = 0
    for got < 2 {
        let n = inc.body.read(first[got..])?
        if n == 0 {
            break
        }
        got += n
    }
    if got == 0 {
        return []
    }
    var replay = first[..got]
    let source = inc.body
    let joined_stream = io.Stream {
        read: fn(buf) -> i64 ! io.Error {
            if replay.len > 0 {
                let n = io.copy(buf, replay)
                replay = replay[n..]
                return n
            }
            source.read(buf)
        }
        write: source.write
        close: source.close
    }
    let r = io.reader(joined_stream)
    let limit = if collect { max_body() } else { 1 << 62 }
    a.phase = Decoding
    if encoding == "zstd" {
        zstd.decode(r, target, limit)?
    } else if encoding == "br" {
        brotli.decode(r, target, limit)?
    } else if encoding == "deflate" {
        let zlib = got == 2 && first[0] & 0x0F == 8 && (i64(first[0]) * 256 + i64(first[1])) % 31 == 0
        if zlib {
            deflate.zlib_decode(r, target, limit)?
        } else {
            deflate.decode(r, target, limit)?
        }
    } else {
        deflate.gzip_decode(r, target, limit)?
    }
    a.phase = Receiving
    let rest = io.buffer(16384)
    for io.read_some(r, rest)? > 0 {}
    collector.data[..collector.size]
}

fn read_known(inc: Incoming) -> []u8 ! io.Error {
    if inc.length > max_body() {
        fail TooLarge
    }
    let out: []u8 = __make(inc.length)
    var got = 0
    for got < out.len {
        let n = inc.body.read(out[got..])?
        if n == 0 {
            fail Eof
        }
        got += n
    }
    let probe = io.buffer(1)
    if inc.body.read(probe)? != 0 {
        fail Malformed
    }
    out
}

fn exchange1(job: Job, conn: *Conn1, req: Outgoing, a: *Attempt) -> Incoming ! io.Error {
    let c = job.client
    track(c.reaper, job.deadline, conn.wire.conn)
    let before = conn.received.n
    let opened = outcome(fn() -> Head1 ! io.Error { start1(conn, req, a) })
    let head = match opened {
        Done(h) => h
        Failed(e) => {
            a.stale = a.reused && conn.received.n == before
            untrack(c.reaper, job.deadline)
            release(c, conn, false)
            fail e
        }
    }
    let framing = new(Framing { reader: conn.reader, attempt: a, mode: Empty, left: 0, first: true, done: false })
    var length = -1
    if !bodiless(req.method, head.status) && head.status != 101 {
        if chunked(head.headers) {
            framing.mode = Chunked
        } else {
            let declared = text.trim(header.get(head.headers, "content-length") ?? "")
            if declared.len > 0 {
                length = text.parse_uint(declared, 10) catch {
                    _ => {
                        untrack(c.reaper, job.deadline)
                        release(c, conn, false)
                        fail Malformed
                    }
                }
                framing.mode = if length > 0 { Length } else { Empty }
                framing.left = length
            } else {
                framing.mode = UntilClose
            }
        }
    } else {
        length = 0
    }
    let reusable = head.keep && head.status != 101 && framing.mode != UntilClose
    let body = io.Stream {
        read: fn(buf) -> i64 ! io.Error {
            a.broken = true
            let n = framed_read(framing, buf)?
            a.broken = false
            n
        }
        write: fn(data) -> i64 ! io.Error { fail Unsupported }
        close: fn() {}
    }
    Incoming {
        status: head.status
        headers: head.headers
        version: Http1
        body
        length
        attempt: a
        finish: fn(ok: bool) {
            untrack(c.reaper, job.deadline)
            release(c, conn, ok && reusable && framing.done)
        }
    }
}

fn start1(conn: *Conn1, req: Outgoing, a: *Attempt) -> Head1 ! io.Error {
    a.phase = Sending
    write_request1(conn.stream, req)?
    a.phase = Receiving
    for {
        let line = io.read_line(conn.reader)?
        let status = parse_status_line(line)?
        let headers = read_headers(conn.reader)?
        if status >= 100 && status < 200 && status != 101 {
            continue
        }
        return Head1 { status, headers, keep: keep_alive(line, headers) }
    }
}

fn write_request1(s: io.Stream, req: Outgoing) ! io.Error {
    var out: []u8 = []
    let target = if req.absolute { format_url(req.url) } else { req.url.target }
    text.append(mut out, "{req.method} {target} HTTP/1.1\r\n")
    if req.proxy_auth.len > 0 {
        text.append(mut out, "proxy-authorization: {req.proxy_auth}\r\n")
    }
    if !header.has(req.headers, "host") {
        text.append(mut out, "host: {authority(req.url)}\r\n")
    }
    write_head(mut out, req.headers)?
    match req.source {
        some(src) => {
            text.append(mut out, "transfer-encoding: chunked\r\n\r\n")
            io.write_all(s, out)?
            let buf = io.buffer(16384)
            for {
                let n = io.read_some(src, buf)?
                if n == 0 {
                    break
                }
                var chunk: []u8 = []
                text.append(mut chunk, "{text.hex(n)}\r\n")
                chunk = joined(chunk, buf[..n])
                text.append(mut chunk, "\r\n")
                io.write_all(s, chunk)?
            }
            io.write_str(s, "0\r\n\r\n")?
        }
        none => {
            let sends_length = req.body.len > 0 || req.method == "POST" || req.method == "PUT" || req.method == "PATCH"
            if sends_length && !header.has(req.headers, "content-length") {
                text.append(mut out, "content-length: {req.body.len}\r\n")
            }
            text.append(mut out, "\r\n")
            if req.body.len <= 65536 {
                io.write_all(s, joined(out, req.body))?
            } else {
                io.write_all(s, out)?
                io.write_all(s, req.body)?
            }
        }
    }
}

fn framed_read(f: *Framing, buf: []u8) -> i64 ! io.Error {
    if f.done {
        return 0
    }
    match f.mode {
        Empty => {
            f.done = true
            return 0
        }
        UntilClose => {
            let n = io.read_some(f.reader, buf)?
            if n == 0 {
                f.done = true
            }
            return n
        }
        Chunked => {
            if f.left == 0 {
                if !f.first && io.read_line(f.reader)?.len != 0 {
                    fail Malformed
                }
                f.first = false
                let line = io.read_line(f.reader)?
                let semi = text.index_byte(line, ';')
                let size = text.parse_uint(text.trim(if semi >= 0 { line[..semi] } else { line }), 16) catch {
                    _ => fail Malformed
                }
                if size == 0 {
                    f.attempt.trailers = read_headers(f.reader)?
                    f.done = true
                    return 0
                }
                f.left = size
            }
        }
        Length => {}
    }
    let want = if buf.len < f.left { buf.len } else { f.left }
    let n = io.read_some(f.reader, buf[..want])?
    if n == 0 {
        fail Eof
    }
    f.left -= n
    if f.mode == Length && f.left == 0 {
        f.done = true
    }
    n
}

fn exchange2(job: Job, m: *Mux, req: Outgoing, a: *Attempt) -> Incoming ! io.Error {
    let d = job.deadline
    a.phase = Sending
    a.used = m
    reserve(m, d) catch {
        TimedOut => fail TimedOut
        _ => {
            a.stale = true
            fail Reset
        }
    }
    let lane = new(Lane { id: 0, events: [], signal: chan[bool](1), window: 0, unacked: 0, ended: false, reset: false })
    let started = outcome(fn() -> Event ! io.Error { start2(m, lane, req, d, a) })
    let head = match started {
        Done(ev) => ev
        Failed(e) => {
            finish_lane(m, lane, false)
            fail e
        }
    }
    let flow = new(Inflow { pending: [], done: false })
    let declared = text.trim(header.get(head.headers, "content-length") ?? "")
    let length = if bodiless(req.method, head.status) { 0 } else { text.parse_uint(declared, 10) catch -1 }
    let body = io.Stream {
        read: fn(buf) -> i64 ! io.Error {
            for flow.pending.len == 0 {
                if flow.done {
                    return 0
                }
                a.broken = true
                let ev = next_event(m, lane, d)?
                match ev.kind {
                    Data => {
                        flow.pending = ev.data
                    }
                    End => {
                        flow.done = true
                        lane.ended = true
                    }
                    Head => {
                        a.trailers = ev.headers
                    }
                    _ => fail Reset
                }
                a.broken = false
            }
            let n = io.copy(buf, flow.pending)
            flow.pending = flow.pending[n..]
            n
        }
        write: fn(data) -> i64 ! io.Error { fail Unsupported }
        close: fn() {}
    }
    Incoming {
        status: head.status
        headers: head.headers
        version: Http2
        body
        length
        attempt: a
        finish: fn(ok: bool) {
            finish_lane(m, lane, ok && flow.done)
        }
    }
}

fn start2(m: *Mux, lane: *Lane, req: Outgoing, d: *Deadline, a: *Attempt) -> Event ! io.Error {
    var fields: []header.Header = [
        header.Header { name: ":method", value: req.method }
        header.Header { name: ":scheme", value: req.url.scheme }
        header.Header { name: ":authority", value: authority(req.url) }
        header.Header { name: ":path", value: req.url.target }
    ]
    for h in req.headers {
        let name = text.lower(h.name)
        if !header.token(name) || !header.valid_value(h.value) {
            fail Invalid
        }
        if connection_specific(name) || name == "host" || name == "te" && h.value != "trailers" {
            continue
        }
        push(mut fields, header.Header { name, value: h.value })
    }
    let streamed = req.source != none
    let has_body = streamed || req.body.len > 0
    let sends_length = req.body.len > 0 || req.method == "POST" || req.method == "PUT" || req.method == "PATCH"
    if !streamed && sends_length && !header.has(req.headers, "content-length") {
        push(mut fields, header.Header { name: "content-length", value: "{req.body.len}" })
    }
    open_lane(m, lane, fields, !has_body)?
    match req.source {
        some(src) => {
            let buf = io.buffer(16384)
            for {
                let n = io.read_some(src, buf)?
                if n == 0 {
                    send_data(m, lane, [], true, d)?
                    break
                }
                send_data(m, lane, buf[..n], false, d)?
            }
        }
        none => {
            if has_body {
                send_data(m, lane, req.body, true, d)?
            }
        }
    }
    a.phase = Receiving
    for {
        let ev = next_event(m, lane, d)?
        match ev.kind {
            Head => return ev
            Reset => {
                a.stale = ev.code == 7
                fail Reset
            }
            Lost => {
                a.stale = a.reused
                fail Reset
            }
            _ => fail Malformed
        }
    }
}
