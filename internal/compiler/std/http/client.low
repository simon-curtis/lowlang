import std/compress/deflate
import std/io
import std/net
import std/text
import std/tls

pub struct Connection {
    pub stream: io.Stream
    pub protocol: str
    pub secure: bool
}

pub fn connect(u: Url, protocols: []str) -> Connection ! io.Error {
    let secure = u.scheme == "https" || u.scheme == "wss"
    if !secure && u.scheme != "http" && u.scheme != "ws" {
        fail Unsupported
    }
    if !secure {
        let c = net.dial(u.host, u.port)?
        return Connection { stream: net.stream(c), protocol: "", secure }
    }
    let t = tls.dial(u.host, u.port, tls.Config { alpn: protocols })?
    Connection { stream: tls.stream(t), protocol: t.protocol, secure }
}

pub fn fetch(method: str, url: str, headers: []Header, body: []u8, version: Version) -> Response ! io.Error {
    let u = parse_url(url)?
    let alpn = match version {
        Http2 => ["h2"]
        Http1 => ["http/1.1"]
    }
    let conn = connect(u, alpn)?
    let s = conn.stream
    defer s.close()
    var req = request(method, u.target)
    req.authority = authority(u)
    req.headers = headers
    req.body = body
    if !has_header(req.headers, "accept-encoding") {
        set_header(mut req.headers, "accept-encoding", "gzip, deflate")
    }
    let resp = match version {
        Http2 => {
            if conn.secure && conn.protocol != "h2" {
                fail Unsupported
            }
            send_h2(s, req, if conn.secure { "https" } else { "http" })?
        }
        Http1 => {
            set_header(mut req.headers, "connection", "close")
            write_request(s, req)?
            read_response(io.reader(s), method)?
        }
    }
    decoded(resp)
}

fn decoded(resp: Response) -> Response ! io.Error {
    let encoding = text.lower(header(resp.headers, "content-encoding") ?? "")
    if encoding.len == 0 || encoding == "identity" {
        return resp
    }
    var out = resp
    if encoding == "gzip" || encoding == "x-gzip" {
        out.body = deflate.gzip_decompress(resp.body, max_body())?
    } else if encoding == "deflate" {
        out.body = deflate.zlib_decompress(resp.body, max_body())?
    } else {
        return resp
    }
    var kept: []Header = []
    for h in resp.headers {
        if !text.equal_fold(h.name, "content-encoding") && !text.equal_fold(h.name, "content-length") {
            push(mut kept, h)
        }
    }
    out.headers = kept
    out
}

pub fn get(url: str) -> Response ! io.Error {
    fetch("GET", url, [], [], Http1)
}

pub fn post(url: str, content_type: str, body: []u8) -> Response ! io.Error {
    fetch("POST", url, [Header { name: "content-type", value: content_type }], body, Http1)
}
