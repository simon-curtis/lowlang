import std/header

fn static_table() -> []header.Header {
    [
        header.Header { name: ":authority", value: "" },
        header.Header { name: ":method", value: "GET" },
        header.Header { name: ":method", value: "POST" },
        header.Header { name: ":path", value: "/" },
        header.Header { name: ":path", value: "/index.html" },
        header.Header { name: ":scheme", value: "http" },
        header.Header { name: ":scheme", value: "https" },
        header.Header { name: ":status", value: "200" },
        header.Header { name: ":status", value: "204" },
        header.Header { name: ":status", value: "206" },
        header.Header { name: ":status", value: "304" },
        header.Header { name: ":status", value: "400" },
        header.Header { name: ":status", value: "404" },
        header.Header { name: ":status", value: "500" },
        header.Header { name: "accept-charset", value: "" },
        header.Header { name: "accept-encoding", value: "gzip, deflate" },
        header.Header { name: "accept-language", value: "" },
        header.Header { name: "accept-ranges", value: "" },
        header.Header { name: "accept", value: "" },
        header.Header { name: "access-control-allow-origin", value: "" },
        header.Header { name: "age", value: "" },
        header.Header { name: "allow", value: "" },
        header.Header { name: "authorization", value: "" },
        header.Header { name: "cache-control", value: "" },
        header.Header { name: "content-disposition", value: "" },
        header.Header { name: "content-encoding", value: "" },
        header.Header { name: "content-language", value: "" },
        header.Header { name: "content-length", value: "" },
        header.Header { name: "content-location", value: "" },
        header.Header { name: "content-range", value: "" },
        header.Header { name: "content-type", value: "" },
        header.Header { name: "cookie", value: "" },
        header.Header { name: "date", value: "" },
        header.Header { name: "etag", value: "" },
        header.Header { name: "expect", value: "" },
        header.Header { name: "expires", value: "" },
        header.Header { name: "from", value: "" },
        header.Header { name: "host", value: "" },
        header.Header { name: "if-match", value: "" },
        header.Header { name: "if-modified-since", value: "" },
        header.Header { name: "if-none-match", value: "" },
        header.Header { name: "if-range", value: "" },
        header.Header { name: "if-unmodified-since", value: "" },
        header.Header { name: "last-modified", value: "" },
        header.Header { name: "link", value: "" },
        header.Header { name: "location", value: "" },
        header.Header { name: "max-forwards", value: "" },
        header.Header { name: "proxy-authenticate", value: "" },
        header.Header { name: "proxy-authorization", value: "" },
        header.Header { name: "range", value: "" },
        header.Header { name: "referer", value: "" },
        header.Header { name: "refresh", value: "" },
        header.Header { name: "retry-after", value: "" },
        header.Header { name: "server", value: "" },
        header.Header { name: "set-cookie", value: "" },
        header.Header { name: "strict-transport-security", value: "" },
        header.Header { name: "transfer-encoding", value: "" },
        header.Header { name: "user-agent", value: "" },
        header.Header { name: "vary", value: "" },
        header.Header { name: "via", value: "" },
        header.Header { name: "www-authenticate", value: "" },
    ]
