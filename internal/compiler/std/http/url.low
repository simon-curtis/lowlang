import std/io
import std/net
import std/text
import std/uri

/// A parsed absolute URL.
///
/// Produced by `parse_url` and `resolve`. The fragment is never kept.
pub struct Url {
    /// The lowercase scheme, for example `https`.
    pub scheme: str
    /// The lowercase host. An IPv6 address is held without its brackets.
    pub host: str
    /// The port number: the one in the URL, or `443` for `https` and `wss` and `80` for any other scheme.
    pub port: i64
    /// The path and query, beginning with `/`. Dot segments are resolved and bytes that are not allowed in a request target are percent-encoded. `/` when the URL has no path.
    pub target: str
    /// The user name from the userinfo, percent-decoded. Empty when there is none.
    pub user: str = ""
    /// The password from the userinfo, percent-decoded. Empty when there is none.
    pub password: str = ""
}

fn secure_scheme(scheme: str) -> bool {
    scheme == "https" || scheme == "wss"
}

fn default_port(scheme: str) -> i64 {
    if secure_scheme(scheme) { 443 } else { 80 }
}

fn path_of(target: str) -> str {
    let q = text.index_byte(target, '?')
    if q >= 0 { target[..q] } else { target }
}

fn normal_target(raw: str) -> str {
    let q = text.index_byte(raw, '?')
    let path = if q >= 0 { raw[..q] } else { raw }
    let query = if q >= 0 { raw[q..] } else { "" }
    let rooted = if path.len == 0 || path[0] != '/' { "/{path}" } else { path }
    let normalized = uri.remove_dots(rooted)
    uri.escape_target("{normalized}{query}")
}

/// Parses an absolute URL of the form `scheme://[user[:password]@]host[:port][/path][?query]`.
///
/// Any scheme is accepted. The scheme and host are lowercased, the fragment is dropped, and the target is normalised as described on `Url.target`. An empty or absent port uses the default for the scheme.
///
/// Fails with `Invalid` when the scheme or the `//` is missing, the host is empty or contains a space, `/`, `\` or `@`, the port is not a number from `1` to `65535`, or a bracketed host is not an IP address. Fails with `Malformed` when the userinfo holds a bad percent-escape.
pub fn parse_url(s: str) -> Url ! io.Error {
    let sep = uri.scheme_end(s)
    if sep <= 0 || s.len < sep + 3 || s[sep + 1] != '/' || s[sep + 2] != '/' {
        fail Invalid
    }
    let scheme = text.lower(s[..sep])
    let rest = uri.without_fragment(s[sep + 3..])
    var slash = text.index_byte(rest, '/')
    let query = text.index_byte(rest, '?')
    if query >= 0 && (slash < 0 || query < slash) {
        slash = query
    }
    var authority = if slash >= 0 { rest[..slash] } else { rest }
    let target = if slash >= 0 { normal_target(rest[slash..]) } else { "/" }
    var user = ""
    var password = ""
    let at = text.last_index_byte(authority, '@')
    if at >= 0 {
        let info = authority[..at]
        authority = authority[at + 1..]
        let colon = text.index_byte(info, ':')
        user = uri.unescape(if colon >= 0 { info[..colon] } else { info }) ?? fail Malformed
        password = if colon >= 0 { uri.unescape(info[colon + 1..]) ?? fail Malformed } else { "" }
    }
    var host = authority
    var port = default_port(scheme)
    let bracket = text.last_index_byte(authority, ']')
    let colon = text.last_index_byte(authority, ':')
    if colon > bracket {
        host = authority[..colon]
        let digits = authority[colon + 1..]
        if digits.len > 0 {
            port = text.parse_uint(digits, 10) or -1
            if port <= 0 || port > 65535 {
                fail Invalid
            }
        }
    }
    if host.len >= 2 && host[0] == '[' && host[host.len - 1] == ']' {
        host = host[1..host.len - 1]
        let zone = text.index_byte(host, '%')
        net.parse_ip(if zone >= 0 { host[..zone] } else { host })?
    } else if text.index_byte(host, ':') >= 0 || text.index_byte(host, '[') >= 0 {
        fail Invalid
    }
    if host.len == 0 {
        fail Invalid
    }
    for i in 0..host.len {
        if host[i] <= 0x20 || host[i] >= 0x7F || host[i] == '/' || host[i] == '\\' || host[i] == '@' {
            fail Invalid
        }
    }
    Url { scheme, host: text.lower(host), port, target, user, password }
}

/// Returns the `host[:port]` part of `u`, as sent in a `host` header.
///
/// An IPv6 host is put in brackets, and the port is left out when it is the default for the scheme.
pub fn authority(u: Url) -> str {
    let host = bracketed_host(u.host)
    if u.port == default_port(u.scheme) {
        return host
    }
    "{host}:{u.port}"
}

fn bracketed_host(host: str) -> str {
    if text.index_byte(host, ':') >= 0 { "[{host}]" } else { host }
}

/// Returns the host of a `host[:port]` authority as sent in a `host` header, without the port and without the brackets of an IPv6 host.
pub fn authority_host(authority: str) -> str {
    if authority.len > 0 && authority[0] == '[' {
        let close = text.index_byte(authority, ']')
        return if close > 0 { authority[1..close] } else { authority }
    }
    let colon = text.last_index_byte(authority, ':')
    if colon >= 0 { authority[..colon] } else { authority }
}

/// Returns `scheme://authority` for `u`.
pub fn origin(u: Url) -> str {
    "{u.scheme}://{authority(u)}"
}

/// Returns `u` as text: its origin followed by its target.
///
/// The user, password and fragment are not included.
pub fn format_url(u: Url) -> str {
    "{origin(u)}{u.target}"
}

/// Resolves `reference` against `base`, following the rules of RFC 3986.
///
/// Leading and trailing whitespace and any fragment are removed from `reference` first. An absolute reference is parsed on its own, and one starting with `//` takes the scheme of `base`. An empty reference returns `base`. A reference starting with `/` replaces the target, one starting with `?` replaces only the query, and any other reference is joined to the directory of the base path. Dot segments are resolved. The relative forms keep the host, port and userinfo of `base`.
///
/// Fails like `parse_url` when the reference is absolute and does not parse.
pub fn resolve(base: Url, reference: str) -> Url ! io.Error {
    let r = uri.without_fragment(text.trim(reference))
    if uri.scheme_end(r) > 0 {
        return parse_url(r)
    }
    if text.starts_with(r, "//") {
        return parse_url("{base.scheme}:{r}")
    }
    var out = base
    if r.len == 0 {
        return out
    }
    let resolved = uri.resolve(base.target, r)
    out.target = uri.escape_target(resolved)
    out
}

/// Returns `u` with `name=value` appended to its query, separated by `?` or `&`.
///
/// Both parts are percent-encoded with `escape`. An existing pair of the same name is kept.
pub fn with_query_pair(u: Url, name: str, value: str) -> Url {
    var out = u
    let joiner = if text.index_byte(u.target, '?') >= 0 { "&" } else { "?" }
    out.target = "{u.target}{joiner}{uri.escape(name)}={uri.escape(value)}"
    out
}
