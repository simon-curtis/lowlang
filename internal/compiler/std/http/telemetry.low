import std/header
/// The value at the start of a task's context slot that the HTTP server and client read to find an `Observer`.
///
/// `__context()` reads the running green thread's context slot as an `*Ambient`, and `spawn` copies it to child tasks. A task whose slot is not set, or whose `observer` is `none`, is not observed. A program that sets the slot must make its context type begin with an `Ambient`.
pub struct Ambient {
    /// The observer that receives the server and client events of this task, or `none` for no observation.
    pub observer: *Observer?
}

/// A pair of hooks that watch every request the HTTP server handles and every attempt the HTTP client makes.
pub struct Observer {
    /// Handles one request received by `serve`, `serve_tls`, `serve_conn` or `serve_stream`, over HTTP/1 or HTTP/2.
    ///
    /// It is called with the request and the handler that would otherwise run, and returns the response to send. It calls the handler, typically inside a context of its own, and returns the response to send.
    pub serve: fn(Request, fn(Request) -> Response) -> Response
    /// Called before each attempt the client makes to send a request, with a `Sending` that describes it, and returns the `Sent` for that attempt.
    ///
    /// A request that is redirected or retried makes one call per attempt. The attempt's request headers are replaced by `Sent.headers`, and `Sent.done` is called once when the attempt ends.
    pub send: fn(Sending) -> Sent
}

/// The description of a client request attempt that is about to be sent, passed to `Observer.send`.
pub struct Sending {
    /// The request method of the attempt, for example `GET`.
    pub method: str
    /// The URL the attempt is for. After a redirect it is the redirect's target.
    pub url: Url
    /// The number of attempts that this request has already made, so `0` for the first attempt and one more for each redirect or retry.
    pub resend: i64
    /// The headers the attempt would send, including those the client added, such as `user-agent` and `accept`, and the `cookie` header from the client's cookie jar.
    pub headers: []header.Header
}

/// The answer an `Observer` gives for a client request attempt: the headers to send and the callback that reports the outcome.
pub struct Sent {
    /// The headers to send in place of `Sending.headers`. An observer that adds nothing returns the headers it was given.
    pub headers: []header.Header
    /// Called once when the attempt ends, with the response status, the protocol version and the error type.
    ///
    /// The status is `0` when no response head arrived. The version is `"1.1"` or `"2"`, and is an empty string when no response head arrived. The error type is the name of the `Error` variant that ended the attempt, for example `"Timeout"`, or an empty string when the attempt received a response that the client accepted, including a redirect or a retried status. A failure while reading the body is reported with the status of the response.
    pub done: fn(i64, str, str)
}

struct Trace {
    observer: *Observer
    resend: i64
    open: Sent?
}

fn observer() -> *Observer? {
    if !__has_context() {
        return none
    }
    let a: *Ambient = __context()
    a.observer
}

fn traced(handler: fn(Request) -> Response, req: Request) -> Response {
    match observer() {
        some(o) => o.serve(req, handler)
        none => handler(req)
    }
}

fn tracing() -> *Trace? {
    match observer() {
        some(o) => new(Trace { observer: o, resend: 0, open: none })
        none => none
    }
}

fn announce(t: *Trace?, req: Outgoing) -> Outgoing {
    let trace = match t {
        some(x) => x
        none => return req
    }
    let sent = trace.observer.send(Sending { method: req.method, url: req.url, resend: trace.resend, headers: req.headers })
    trace.resend += 1
    trace.open = sent
    var out = req
    out.headers = sent.headers
    out
}

fn settle(t: *Trace?, status: i64, version: str, error_type: str) {
    let trace = match t {
        some(x) => x
        none => return
    }
    match trace.open {
        some(sent) => {
            trace.open = none
            sent.done(status, version, error_type)
        }
        none => {}
    }
}

fn version_text(v: Version) -> str {
    match v {
        Http1 => "1.1"
        Http2 => "2"
    }
}

fn error_name(e: Error) -> str {
    match e {
        InvalidUrl(_) => "InvalidUrl"
        Connect(_) => "Connect"
        Tls(_) => "Tls"
        Timeout => "Timeout"
        TooManyRedirects(_) => "TooManyRedirects"
        Protocol(_) => "Protocol"
        Decode(_) => "Decode"
        Json(_) => "Json"
        Status(_) => "Status"
        Io(_) => "Io"
    }
}
