import std/net
import std/sync
import std/text
import std/time

pub enum SameSite {
    Unset
    NoRestriction
    Lax
    Strict
}

pub struct Cookie {
    pub name: str
    pub value: str
    pub domain: str
    pub host_only: bool
    pub path: str
    pub expires: i64
    pub secure: bool
    pub http_only: bool
    pub same_site: SameSite
    pub created: i64
    pub accessed: i64
}

struct JarState {
    lock: sync.Mutex
    cookies: []Cookie
    tick: i64
}

pub struct CookieJar {
    state: *JarState
}

pub fn cookie_jar() -> CookieJar {
    CookieJar { state: new(JarState { lock: sync.mutex(), cookies: [], tick: 0 }) }
}

fn session_expiry() -> i64 {
    0x7FFFFFFFFFFFFFFF
}

fn max_cookie_bytes() -> i64 {
    4096
}

fn max_attribute_bytes() -> i64 {
    1024
}

fn max_cookies_per_domain() -> i64 {
    50
}

fn max_cookies() -> i64 {
    3000
}

fn cookie_delimiter(c: u8) -> bool {
    c == 0x09 || c >= 0x20 && c <= 0x2F || c >= 0x3B && c <= 0x40 || c >= 0x5B && c <= 0x60 || c >= 0x7B && c <= 0x7E
}

fn date_tokens(s: str) -> []str {
    var tokens: []str = []
    var start = -1
    for i in 0..s.len {
        if cookie_delimiter(s[i]) {
            if start >= 0 {
                push(mut tokens, s[start..i])
                start = -1
            }
        } else if start < 0 {
            start = i
        }
    }
    if start >= 0 {
        push(mut tokens, s[start..])
    }
    tokens
}

fn leading_digits(s: str, low: i64, high: i64) -> i64 {
    var n = 0
    var count = 0
    for count < s.len && s[count] >= '0' && s[count] <= '9' {
        n = n * 10 + i64(s[count] - '0')
        count += 1
    }
    if count < low || count > high {
        return -1
    }
    n
}

fn clock(token: str) -> i64 {
    let parts = text.split(token, ':')
    if parts.len != 3 {
        return -1
    }
    let h = leading_digits(parts[0], 1, 2)
    let m = leading_digits(parts[1], 1, 2)
    let s = leading_digits(parts[2], 1, 2)
    if h < 0 || m < 0 || s < 0 || parts[0].len > 2 || parts[1].len > 2 {
        return -1
    }
    if h > 23 || m > 59 || s > 59 {
        return -2
    }
    h * 3600 + m * 60 + s
}

fn month_of(token: str) -> i64 {
    if token.len < 3 {
        return -1
    }
    let names = ["jan", "feb", "mar", "apr", "may", "jun", "jul", "aug", "sep", "oct", "nov", "dec"]
    let prefix = text.lower(token[..3])
    for i, name in names {
        if prefix == name {
            return i + 1
        }
    }
    -1
}

fn parse_cookie_date(s: str) -> i64? {
    var seconds = -1
    var day = -1
    var month = -1
    var year = -1
    for token in date_tokens(s) {
        if seconds == -1 {
            let t = clock(token)
            if t == -2 {
                return none
            }
            if t >= 0 {
                seconds = t
                continue
            }
        }
        if day < 0 {
            let d = leading_digits(token, 1, 2)
            if d >= 0 && token.len <= 2 {
                day = d
                continue
            }
        }
        if month < 0 {
            let m = month_of(token)
            if m > 0 {
                month = m
                continue
            }
        }
        if year < 0 {
            let y = leading_digits(token, 2, 4)
            if y >= 0 {
                year = y
            }
        }
    }
    if year >= 70 && year <= 99 {
        year += 1900
    } else if year >= 0 && year <= 69 {
        year += 2000
    }
    if seconds < 0 || day < 1 || day > 31 || month < 0 || year < 1601 {
        return none
    }
    time.days_from_civil(year, month, day) * 86400 + seconds
}

fn default_path(target: str) -> str {
    let q = text.index_byte(target, '?')
    let path = if q >= 0 { target[..q] } else { target }
    if path.len == 0 || path[0] != '/' {
        return "/"
    }
    let slash = text.last_index_byte(path, '/')
    if slash == 0 { "/" } else { path[..slash] }
}

fn domain_match(host: str, domain: str) -> bool {
    if host == domain {
        return true
    }
    if !text.ends_with(host, domain) || host.len <= domain.len || host[host.len - domain.len - 1] != '.' {
        return false
    }
    !ip_literal(host)
}

fn ip_literal(host: str) -> bool {
    let parsed = net.parse_ip(host) catch {
        _ => return false
    }
    parsed.len > 0
}

fn path_match(path: str, cookie_path: str) -> bool {
    if path == cookie_path {
        return true
    }
    if !text.starts_with(path, cookie_path) {
        return false
    }
    cookie_path[cookie_path.len - 1] == '/' || path[cookie_path.len] == '/'
}

fn secure_origin(u: Url) -> bool {
    u.scheme == "https" || u.scheme == "wss"
}

fn same_site_of(value: str) -> SameSite {
    if value == "strict" {
        return Strict
    }
    if value == "lax" {
        return Lax
    }
    if value == "none" {
        return NoRestriction
    }
    Unset
}

fn max_age_expiry(value: str, now: i64) -> i64? {
    let negative = value.len > 0 && value[0] == '-'
    let digits = if negative { value[1..] } else { value }
    if digits.len == 0 || digits.len > 12 {
        return none
    }
    let n = text.parse_uint(digits, 10) catch -1
    if n < 0 {
        return none
    }
    if negative || n == 0 { 0 } else { now + n * 1000 }
}

fn prefix_allows(c: Cookie, u: Url) -> bool {
    let name = text.lower(c.name)
    if text.starts_with(name, "__secure-") {
        return c.secure
    }
    if text.starts_with(name, "__host-") {
        return c.secure && c.host_only && c.path == "/"
    }
    true
}

fn parse_set_cookie(u: Url, line: str, now: i64) -> Cookie? {
    let parts = text.split(line, ';')
    let pair = parts[0]
    let eq = text.index_byte(pair, '=')
    if eq < 0 {
        return none
    }
    let name = text.trim(pair[..eq])
    let value = text.trim(pair[eq + 1..])
    if name.len == 0 || name.len + value.len > max_cookie_bytes() {
        return none
    }
    var c = Cookie {
        name
        value
        domain: u.host
        host_only: true
        path: default_path(u.target)
        expires: session_expiry()
        secure: false
        http_only: false
        same_site: Unset
        created: 0
        accessed: 0
    }
    var max_age_seen = false
    for attr in parts[1..] {
        let at = text.index_byte(attr, '=')
        let key = text.lower(text.trim(if at >= 0 { attr[..at] } else { attr }))
        let attribute = text.trim(if at >= 0 { attr[at + 1..] } else { "" })
        if attribute.len > max_attribute_bytes() {
            continue
        }
        if key == "max-age" {
            match max_age_expiry(attribute, now) {
                some(t) => {
                    max_age_seen = true
                    c.expires = t
                }
                none => {}
            }
        } else if key == "expires" && !max_age_seen {
            match parse_cookie_date(attribute) {
                some(t) => {
                    c.expires = t * 1000
                }
                none => {}
            }
        } else if key == "domain" {
            let d = text.lower(if attribute.len > 0 && attribute[0] == '.' { attribute[1..] } else { attribute })
            if d.len == 0 {
                continue
            }
            if !domain_match(u.host, d) {
                return none
            }
            c.domain = d
            c.host_only = false
        } else if key == "path" {
            c.path = if attribute.len > 0 && attribute[0] == '/' { attribute } else { default_path(u.target) }
        } else if key == "secure" {
            c.secure = true
        } else if key == "httponly" {
            c.http_only = true
        } else if key == "samesite" {
            c.same_site = same_site_of(text.lower(attribute))
        }
    }
    if c.secure && !secure_origin(u) || !prefix_allows(c, u) {
        return none
    }
    c
}

fn live_cookies(cookies: []Cookie, now: i64) -> []Cookie {
    var live: []Cookie = []
    for c in cookies {
        if c.expires > now {
            push(mut live, c)
        }
    }
    live
}

fn oldest_index(cookies: []Cookie, domain: str) -> i64 {
    var found = -1
    for i, c in cookies {
        if (domain.len == 0 || c.domain == domain) && (found < 0 || c.accessed < cookies[found].accessed) {
            found = i
        }
    }
    found
}

fn without_index(cookies: []Cookie, skip: i64) -> []Cookie {
    var kept: []Cookie = []
    for i, c in cookies {
        if i != skip {
            push(mut kept, c)
        }
    }
    kept
}

fn count_domain(cookies: []Cookie, domain: str) -> i64 {
    var n = 0
    for c in cookies {
        if c.domain == domain {
            n += 1
        }
    }
    n
}

fn trim_jar(s: *JarState, domain: str) {
    if count_domain(s.cookies, domain) > max_cookies_per_domain() {
        s.cookies = without_index(s.cookies, oldest_index(s.cookies, domain))
    }
    if s.cookies.len > max_cookies() {
        s.cookies = without_index(s.cookies, oldest_index(s.cookies, ""))
    }
}

fn keep_cookie(s: *JarState, u: Url, c: Cookie, now: i64) -> bool {
    let current = live_cookies(s.cookies, now)
    var fresh = c
    s.tick += 1
    fresh.created = s.tick
    fresh.accessed = s.tick
    var kept: []Cookie = []
    for old in current {
        if old.name == c.name && old.domain == c.domain && old.path == c.path {
            if old.secure && !secure_origin(u) {
                s.cookies = current
                return false
            }
            fresh.created = old.created
        } else {
            push(mut kept, old)
        }
    }
    let stored = c.expires > now
    if stored {
        push(mut kept, fresh)
    }
    s.cookies = kept
    trim_jar(s, c.domain)
    stored
}

fn store_cookies(j: CookieJar, u: Url, headers: []Header) {
    let now = time.now_millis()
    let s = j.state
    sync.lock(s.lock)
    defer sync.unlock(s.lock)
    for h in headers {
        if !text.equal_fold(h.name, "set-cookie") {
            continue
        }
        match parse_set_cookie(u, h.value, now) {
            some(c) => {
                keep_cookie(s, u, c, now)
            }
            none => {}
        }
    }
}

fn cookie_header(j: CookieJar, u: Url) -> str {
    let now = time.now_millis()
    let secure = secure_origin(u)
    let path = path_of(u.target)
    let s = j.state
    var chosen: []Cookie = []
    sync.lock(s.lock)
    s.cookies = live_cookies(s.cookies, now)
    s.tick += 1
    for i, c in s.cookies {
        let host_ok = if c.host_only { u.host == c.domain } else { domain_match(u.host, c.domain) }
        if host_ok && path_match(path, c.path) && (!c.secure || secure) {
            s.cookies[i].accessed = s.tick
            push(mut chosen, c)
        }
    }
    sync.unlock(s.lock)
    for i in 1..chosen.len {
        var k = i
        for k > 0 && cookie_before(chosen[k], chosen[k - 1]) {
            let t = chosen[k]
            chosen[k] = chosen[k - 1]
            chosen[k - 1] = t
            k -= 1
        }
    }
    var parts: []str = []
    for c in chosen {
        push(mut parts, "{c.name}={c.value}")
    }
    text.join(parts, "; ")
}

fn cookie_before(a: Cookie, b: Cookie) -> bool {
    if a.path.len != b.path.len {
        return a.path.len > b.path.len
    }
    a.created < b.created
}

pub fn jar_set(j: CookieJar, url: str, set_cookie: str) -> bool {
    let u = parse_url(url) catch {
        _ => return false
    }
    let now = time.now_millis()
    let c = match parse_set_cookie(u, set_cookie, now) {
        some(c) => c
        none => return false
    }
    let s = j.state
    sync.lock(s.lock)
    defer sync.unlock(s.lock)
    keep_cookie(s, u, c, now)
}

pub fn jar_header(j: CookieJar, url: str) -> str {
    let u = parse_url(url) catch {
        _ => return ""
    }
    cookie_header(j, u)
}

pub fn jar_cookies(j: CookieJar) -> []Cookie {
    let s = j.state
    sync.lock(s.lock)
    s.cookies = live_cookies(s.cookies, time.now_millis())
    var copy: []Cookie = []
    for c in s.cookies {
        push(mut copy, c)
    }
    sync.unlock(s.lock)
    copy
}

pub fn jar_clear(j: CookieJar) {
    let s = j.state
    sync.lock(s.lock)
    s.cookies = []
    sync.unlock(s.lock)
}
