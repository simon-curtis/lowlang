import std/header
import std/io
import std/text

const max_body = 1 << 26

fn read_headers(r: *io.Reader) -> []header.Header ! io.Error {
    var headers: []header.Header = []
    for {
        let line = io.read_line(r)?
        if line.len == 0 {
            return headers
        }
        if headers.len == 100 {
            fail TooLarge
        }
        let colon = text.index_byte(line, ':')
        if colon <= 0 || !header.token(line[..colon]) {
            fail Malformed
        }
        push(mut headers, header.Header { name: lower_name(line[..colon]), value: text.trim(line[colon + 1..]) })
    }
}

enum Mode {
    Empty
    Length
    Chunked
    UntilClose
}

struct BodyFraming {
    mode: Mode
    length: i64
}

struct ResponseHead {
    status: i64
    headers: []header.Header
    keep: bool
}

fn declared_length(headers: []header.Header) -> i64 ! io.Error {
    let value = text.trim(header.get(headers, "content-length") ?? "")
    if value.len == 0 {
        return -1
    }
    text.parse_uint(value, 10) or fail Malformed
}

fn content_length(headers: []header.Header) -> i64 ! io.Error {
    let n = declared_length(headers)?
    if n > max_body {
        fail TooLarge
    }
    n
}

fn body_framing(method: str, status: i64, headers: []header.Header) -> BodyFraming ! io.Error {
    if bodiless(method, status) {
        return BodyFraming { mode: Empty, length: 0 }
    }
    if chunked(headers) {
        return BodyFraming { mode: Chunked, length: -1 }
    }
    let n = declared_length(headers)?
    if n < 0 {
        return BodyFraming { mode: UntilClose, length: -1 }
    }
    BodyFraming { mode: if n > 0 { Length } else { Empty }, length: n }
}

fn chunked(headers: []header.Header) -> bool {
    text.has_token(header.get(headers, "transfer-encoding") ?? "", "chunked")
}

fn read_chunk_size(r: *io.Reader) -> i64 ! io.Error {
    let line = io.read_line(r)?
    let semi = text.index_byte(line, ';')
    text.parse_uint(text.trim(if semi >= 0 { line[..semi] } else { line }), 16) or fail Malformed
}

fn put_chunk(mut out: []u8, data: []u8) {
    text.append(mut out, "{text.hex(data.len)}\r\n")
    io.append(mut out, data)
    text.append(mut out, "\r\n")
}

const last_chunk = "0\r\n\r\n"

struct Framing {
    reader: *io.Reader
    mode: Mode
    left: i64
    first: bool
    done: bool
    trailers: []header.Header
}

fn framing_of(r: *io.Reader, shape: BodyFraming) -> *Framing {
    new(Framing { reader: r, mode: shape.mode, left: if shape.mode == Length { shape.length } else { 0 }, first: true, done: false, trailers: [] })
}

fn framed_read(f: *Framing, buf: []u8) -> i64 ! io.Error {
    if f.done {
        return 0
    }
    match f.mode {
        Empty => {
            f.done = true
            return 0
        }
        UntilClose => {
            let n = io.read_some(f.reader, buf)?
            if n == 0 {
                f.done = true
            }
            return n
        }
        Chunked => {
            if f.left == 0 {
                if !f.first && io.read_line(f.reader)?.len != 0 {
                    fail Malformed
                }
                f.first = false
                let size = read_chunk_size(f.reader)?
                if size == 0 {
                    f.trailers = read_headers(f.reader)?
                    f.done = true
                    return 0
                }
                f.left = size
            }
        }
        Length => {}
    }
    let want = if buf.len < f.left { buf.len } else { f.left }
    let n = io.read_some(f.reader, buf[..want])?
    if n == 0 {
        fail Eof
    }
    f.left -= n
    if f.mode == Length && f.left == 0 {
        f.done = true
    }
    n
}

fn read_body(f: *Framing) -> []u8 ! io.Error {
    if f.mode == Length {
        let out: []u8 = __make(f.left)
        var got = 0
        for got < out.len {
            got += framed_read(f, out[got..])?
        }
        return out
    }
    var body: []u8 = []
    let chunk = io.buffer(16384)
    for {
        let n = framed_read(f, chunk)?
        if n == 0 {
            return body
        }
        if body.len + n > max_body {
            fail TooLarge
        }
        io.append(mut body, chunk[..n])
    }
}

fn request_framing(headers: []header.Header) -> BodyFraming ! io.Error {
    if chunked(headers) {
        return BodyFraming { mode: Chunked, length: -1 }
    }
    let n = content_length(headers)?
    if n > 0 {
        return BodyFraming { mode: Length, length: n }
    }
    BodyFraming { mode: Empty, length: 0 }
}

fn parse_request_line(line: str) -> Request ! io.Error {
    let parts = text.split(line, ' ')
    if parts.len != 3 || parts[0].len == 0 || parts[1].len == 0 || !header.token(parts[0]) {
        fail Malformed
    }
    if parts[2] != "HTTP/1.1" && parts[2] != "HTTP/1.0" {
        fail Unsupported
    }
    var req = new_request(parts[0], parts[1])
    req.http10 = parts[2] == "HTTP/1.0"
    req
}

fn read_request_rest(r: *io.Reader, line: str) -> Request ! io.Error {
    var req = parse_request_line(line)?
    req.headers = read_headers(r)?
    req.authority = header.get(req.headers, "host") ?? ""
    req.connection = r
    if text.has_token(header.get(req.headers, "expect") ?? "", "100-continue") {
        io.write_str(io.reader_stream(r), "HTTP/1.1 100 Continue\r\n\r\n")?
    }
    let shape = request_framing(req.headers)?
    let framing = framing_of(r, shape)
    req.body = read_body(framing)?
    req
}

/// Reads one HTTP/1 request from `r`, including its whole body.
///
/// Blocks until the request is complete. Blank lines before the request line are skipped. The returned request has `version` `Http1`, `http10` set when the request line says `HTTP/1.0`, its `authority` taken from the `host` header, and `connection` set to `r`. The body is read from `chunked` transfer coding, or from `content-length` bytes; a request with neither has an empty body. When the request carries `expect: 100-continue`, `HTTP/1.1 100 Continue` is written to the stream beneath `r` before the body is read.
///
/// Fails with `Eof` when the input ends before a complete request, `Malformed` for a request line that is not `METHOD target HTTP/1.x`, a header line without a valid name and `:`, a bad chunk size or a `content-length` that is not a number, `Unsupported` when the version is not `HTTP/1.0` or `HTTP/1.1`, and `TooLarge` for more than 100 headers, a line longer than the reader's buffer, or a body over 64 MiB. Header names are lowercased.
pub fn read_request(r: *io.Reader) -> Request ! io.Error {
    var line = io.read_line(r)?
    for line.len == 0 {
        line = io.read_line(r)?
    }
    read_request_rest(r, line)
}

fn keep_alive(http10: bool, headers: []header.Header) -> bool {
    let connection = header.get(headers, "connection") ?? ""
    if http10 {
        return text.has_token(connection, "keep-alive")
    }
    !text.has_token(connection, "close")
}

fn read_response_head(r: *io.Reader) -> ResponseHead ! io.Error {
    for {
        let line = io.read_line(r)?
        let status = parse_status_line(line)?
        let headers = read_headers(r)?
        if status >= 100 && status < 200 && status != 101 {
            continue
        }
        return ResponseHead { status, headers, keep: keep_alive(text.starts_with(line, "HTTP/1.0"), headers) }
    }
}

fn write_head(mut out: []u8, headers: []header.Header) ! io.Error {
    for h in headers {
        if !header.token(h.name) || !header.valid_value(h.value) {
            fail Invalid
        }
        text.append(mut out, h.name)
        text.append(mut out, ": ")
        text.append(mut out, h.value)
        text.append(mut out, "\r\n")
    }
}

/// Writes `resp` to `s` as an HTTP/1.1 response in one write.
///
/// `method` is the method of the request being answered. The body is left out for `HEAD` and for `1xx`, `204` and `304` responses. `content-length` is added from the body when `resp.headers` has none, except for `1xx`, `204` and `304`. When `closing` is `true`, `connection: close` is added, except for a `101` response. The status line carries the reason phrase from `status_text`. `resp.stream` and `resp.trailers` are not written.
///
/// Fails with `Invalid` before writing anything when a header name or value is not valid, and otherwise with the error of the write.
pub fn write_response(s: io.Stream, method: str, resp: Response, closing: bool) ! io.Error {
    var out: []u8 = []
    text.append(mut out, "HTTP/1.1 {resp.status} {status_text(resp.status)}\r\n")
    write_head(mut out, resp.headers)?
    let empty = bodiless(method, resp.status)
    if !header.has(resp.headers, "content-length") && !status_bodiless(resp.status) {
        text.append(mut out, "content-length: {resp.body.len}\r\n")
    }
    if closing && resp.status != 101 {
        text.append(mut out, "connection: close\r\n")
    }
    text.append(mut out, "\r\n")
    if !empty {
        io.append(mut out, resp.body)
    }
    io.write_all(s, out)?
}

/// Writes `req` to `s` as an HTTP/1.1 request in one write.
///
/// The request line is `req.method`, `req.target` and `HTTP/1.1`. A `host` header from `req.authority` is added when `req.headers` has none. `content-length` is added from the body when it is absent and the body is not empty or the method is `POST`, `PUT` or `PATCH`. The body follows the headers.
///
/// Fails with `Invalid` before writing anything when a header name or value is not valid, and otherwise with the error of the write.
pub fn write_request(s: io.Stream, req: Request) ! io.Error {
    var out: []u8 = []
    put_request_head(mut out, req.method, req.target, req.authority, req.headers, req.body.len)?
    io.append(mut out, req.body)
    io.write_all(s, out)?
}

fn put_request_head(mut out: []u8, method: str, target: str, host: str, headers: []header.Header, body_len: i64) ! io.Error {
    text.append(mut out, "{method} {target} HTTP/1.1\r\n")
    if !header.has(headers, "host") {
        text.append(mut out, "host: {host}\r\n")
    }
    write_head(mut out, headers)?
    if body_len < 0 {
        text.append(mut out, "transfer-encoding: chunked\r\n")
    } else if sends_length(method, body_len) && !header.has(headers, "content-length") {
        text.append(mut out, "content-length: {body_len}\r\n")
    }
    text.append(mut out, "\r\n")
}

fn sends_length(method: str, body_len: i64) -> bool {
    body_len > 0 || method == "POST" || method == "PUT" || method == "PATCH"
}

fn parse_status_line(line: str) -> i64 ! io.Error {
    if !text.starts_with(line, "HTTP/1.") || line.len < 12 || line[8] != ' ' {
        fail Malformed
    }
    text.parse_uint(line[9..12], 10) or fail Malformed
}

/// Reads one HTTP/1 response from `r`, including its whole body.
///
/// `method` is the method of the request being answered. Blocks until the response is complete. Interim `1xx` responses other than `101` are skipped. The body is empty for a response to `HEAD` and for `1xx`, `204` and `304`; otherwise it is read from `chunked` transfer coding, from `content-length` bytes, or, when neither is present, until the peer closes the connection. Chunked trailers are returned in `trailers`. The returned response has `version` `Http1` and an empty `url`.
///
/// Fails with `Eof` when the input ends early, `Malformed` for a status line that is not `HTTP/1.x` and a three-digit status, a bad header, a bad chunk size or a `content-length` that is not a number, and `TooLarge` for more than 100 headers or a body over 64 MiB.
pub fn read_response(r: *io.Reader, method: str) -> Response ! io.Error {
    let head = read_response_head(r)?
    let shape = body_framing(method, head.status, head.headers)?
    if shape.length > max_body {
        fail TooLarge
    }
    let framing = framing_of(r, shape)
    let body = read_body(framing)?
    Response { status: head.status, headers: head.headers, body, trailers: framing.trailers }
}
