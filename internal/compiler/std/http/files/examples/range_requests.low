import std/file
import std/http
import std/http/files
import std/io
import std/net

fn show(label: str, resp: http.Response) {
    let kind = http.header_value(resp, "content-type") ?? "-"
    let range = http.header_value(resp, "content-range") ?? "-"
    print("{label}: {resp.status} type={kind} range={range} body={http.text(resp)}")
}

/// Serves a file from disk and fetches it whole, by byte range, conditionally and when it is missing.
fn main() ! io.Error {
    using report = file.temp_file("", "report-*.txt")?
    file.write_str(report.file, "0123456789abcdef")?
    let path = report.path

    let handler = fn(req: http.Request) -> http.Response {
        if req.path == "/report.txt" {
            return files.serve_file(req, path)
        }
        files.serve_file(req, "{path}.missing")
    }
    using l = net.listen("127.0.0.1", 0)?
    let listening = l.handle
    spawn fn() { http.serve_on(listening, handler) or {} }()

    let client = http.client().with_base_url("http://127.0.0.1:{l.handle.addr.port}").with_timeout(5000).build()
    let whole = client.get("/report.txt") or return
    show("whole", whole)

    let part = client.request("GET", "/report.txt").with_header("range", "bytes=10-").send() or return
    show("tail", part)
    let first = client.request("GET", "/report.txt").with_header("range", "bytes=0-3").send() or return
    show("head", first)

    let tag = http.header_value(whole, "etag") ?? ""
    let cached = client.request("GET", "/report.txt").with_header("if-none-match", tag).send() or return
    show("cached", cached)

    let beyond = client.request("GET", "/report.txt").with_header("range", "bytes=99-").send() or return
    show("beyond", beyond)
    let gone = client.get("/other") or return
    show("missing", gone)
    net.close_listener(l)
}
