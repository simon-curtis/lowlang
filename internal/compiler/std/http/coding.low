import std/compress/brotli
import std/compress/deflate
import std/compress/zstd
import std/io
import std/text

struct Coding {
    name: str
    encodes: bool
}

fn codings() -> []Coding {
    [
        Coding { name: "gzip", encodes: true }
        Coding { name: "deflate", encodes: false }
        Coding { name: "br", encodes: true }
        Coding { name: "zstd", encodes: true }
    ]
}

fn accept_encoding() -> str {
    var names: []str = []
    for c in codings() {
        push(mut names, c.name)
    }
    text.join(names, ", ")
}

fn canonical_coding(raw: str) -> str {
    let name = text.lower(text.trim(raw))
    if name == "x-gzip" {
        return "gzip"
    }
    for c in codings() {
        if c.name == name {
            return name
        }
    }
    ""
}

fn weighted_out(item: str, semi: i64) -> bool {
    if semi < 0 {
        return false
    }
    let q = text.trim(item[semi + 1..])
    q == "q=0" || q == "q=0.0" || q == "q=0.00" || q == "q=0.000"
}

/// Returns `true` when the `accept-encoding` value `accept` lists `coding`, ignoring case, with a quality other than zero.
///
/// `*` is not treated as a wildcard.
pub fn accepts_coding(accept: str, coding: str) -> bool {
    for part in text.split(accept, ',') {
        let item = text.trim(part)
        let semi = text.index_byte(item, ';')
        let name = text.trim(if semi >= 0 { item[..semi] } else { item })
        if text.equal_fold(name, coding) {
            return !weighted_out(item, semi)
        }
    }
    false
}

/// Returns the coding `encode_body` should use for the `accept-encoding` value `accept`: the first of `zstd`, `br` and `gzip` that it accepts, or an empty string when it accepts none.
pub fn negotiate_coding(accept: str) -> str {
    let table = codings()
    for i in 0..table.len {
        let c = table[table.len - 1 - i]
        if c.encodes && accepts_coding(accept, c.name) {
            return c.name
        }
    }
    ""
}

/// Compresses `body` with `coding`, one of `zstd`, `br` and `gzip`, at `level`.
///
/// Any other coding is written as `gzip`.
pub fn encode_body(coding: str, body: []u8, level: i64) -> []u8 {
    if coding == "zstd" {
        zstd.compress(body, level)
    } else if coding == "br" {
        brotli.compress(body, level)
    } else {
        deflate.gzip_compress(body, level)
    }
}

fn zlib_wrapped(head: []u8) -> bool {
    head.len == 2 && head[0] & 0x0F == 8 && (i64(head[0]) * 256 + i64(head[1])) % 31 == 0
}

fn decode_body(coding: str, r: *io.Reader, target: fn([]u8) ! io.Error, limit: i64, head: []u8) ! io.Error {
    if coding == "zstd" {
        zstd.decode(r, target, limit)?
    } else if coding == "br" {
        brotli.decode(r, target, limit)?
    } else if coding == "deflate" {
        if zlib_wrapped(head) {
            deflate.zlib_decode(r, target, limit)?
        } else {
            deflate.decode(r, target, limit)?
        }
    } else {
        deflate.gzip_decode(r, target, limit)?
    }
}
