import std/header
import std/http/huffman
import std/io
import std/text

fn entry_size(h: header.Header) -> i64 {
    32 + h.name.len + h.value.len
}

fn read_int(b: []u8, mut at: i64, prefix: i64) -> i64 ! io.Error {
    if at >= b.len {
        fail Eof
    }
    let mask = (1 << prefix) - 1
    var n = i64(b[at]) & mask
    at += 1
    if n < mask {
        return n
    }
    var shift = 0
    for {
        if at >= b.len {
            fail Eof
        }
        if shift > 56 {
            fail Malformed
        }
        let c = i64(b[at])
        at += 1
        let part = c & 0x7F
        if shift == 56 && part > 0x3F {
            fail Malformed
        }
        n += part << shift
        if n >= 1 << 62 {
            fail Malformed
        }
        shift += 7
        if c & 0x80 == 0 {
            return n
        }
    }
}

fn read_string(b: []u8, mut at: i64, prefix: i64, limit: i64) -> str ! io.Error {
    if at >= b.len {
        fail Eof
    }
    let coded = i64(b[at]) & (1 << (prefix - 1)) != 0
    let n = read_int(b, mut at, prefix - 1)?
    if n > limit {
        fail Malformed
    }
    if at + n > b.len {
        fail Eof
    }
    let raw = b[at..at + n]
    at += n
    if coded {
        return huffman.decode(raw)
    }
    str(raw)
}

fn put_int(mut out: []u8, first: u8, prefix: i64, n: i64) {
    let mask = (1 << prefix) - 1
    if n < mask {
        push(mut out, first | u8(n))
        return
    }
    push(mut out, first | u8(mask))
    var rest = n - mask
    for rest >= 0x80 {
        push(mut out, u8(rest & 0x7F | 0x80))
        rest = rest >> 7
    }
    push(mut out, u8(rest))
}

fn put_string(mut out: []u8, first: u8, prefix: i64, s: str) {
    let coded = huffman.encoded_size(s)
    if coded < s.len {
        put_int(mut out, first | u8(1 << (prefix - 1)), prefix - 1, coded)
        huffman.encode(mut out, s)
        return
    }
    put_int(mut out, first, prefix - 1, s.len)
    text.append(mut out, s)
}
