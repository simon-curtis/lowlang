/// Returns `0x200`, the HTTP/3 error code `QPACK_DECOMPRESSION_FAILED`.
///
/// It is the code for a failure of `decode`.
pub fn decompression_failed() -> i64 {
    0x200
}

/// Returns `0x201`, the HTTP/3 error code `QPACK_ENCODER_STREAM_ERROR`.
///
/// It is the code for a failure of `on_encoder_stream`.
pub fn encoder_stream_error() -> i64 {
    0x201
}

/// Returns `0x202`, the HTTP/3 error code `QPACK_DECODER_STREAM_ERROR`.
///
/// It is the code for a failure of `on_decoder_stream`.
pub fn decoder_stream_error() -> i64 {
    0x202
}
