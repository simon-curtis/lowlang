/// The HTTP/3 error code `QPACK_DECOMPRESSION_FAILED`, `0x200`.
///
/// It is the code for a failure of `decode`.
pub const decompression_failed = 0x200

/// The HTTP/3 error code `QPACK_ENCODER_STREAM_ERROR`, `0x201`.
///
/// It is the code for a failure of `on_encoder_stream`.
pub const encoder_stream_error = 0x201

/// The HTTP/3 error code `QPACK_DECODER_STREAM_ERROR`, `0x202`.
///
/// It is the code for a failure of `on_decoder_stream`.
pub const decoder_stream_error = 0x202
