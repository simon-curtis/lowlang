import std/cancel
import std/header
import std/io
import std/net
import std/tls

/// Returns the response a handler returns after it has taken over the connection.
///
/// On an HTTP/1 request that carries an `upgrade` header, a handler that has run another protocol over `Request.connection`, as `websocket.accept` does, returns this response. The server then writes nothing and stops serving the connection, which `serve_conn` and `serve_conn_on` close. Over HTTP/2 the response is written as an ordinary `101`.
pub fn upgraded() -> Response {
    Response { status: 101, headers: [], body: [] }
}

/// Accepts connections from `l` and serves each on its own task, calling `handler` for every request.
///
/// Blocks until accepting fails and returns that error; it never returns otherwise. The server speaks HTTP/1.1 with keep-alive and, on plain connections, HTTP/2 to a client that opens with the HTTP/2 connection preface. Requests on one HTTP/1 connection run one after another; requests on an HTTP/2 connection run concurrently. A request that cannot be parsed is answered with `400`, a body or header block that is too large with `413`, and an unsupported protocol version with `505`; any other read or write failure ends that connection without a response. Errors on one connection never reach the caller.
pub fn serve(l: net.Listener, handler: fn(Request) -> Response) ! io.Error {
    serve_on(l.handle, handler)?
}

/// Serves HTTP as `serve` does, accepting from a `ListenerHandle`.
pub fn serve_on(l: net.ListenerHandle, handler: fn(Request) -> Response) ! io.Error {
    for {
        let h = net.accept_handle(l)?
        spawn serve_conn_on(h, handler)
    }
}

/// Serves HTTPS as `serve` does, terminating TLS on every accepted connection with `config`.
///
/// `config` must hold the server certificates and key. When `config.alpn` is empty it is set to `h2` and `http/1.1`. A connection whose handshake fails is closed.
pub fn serve_tls(l: net.Listener, config: tls.Config, handler: fn(Request) -> Response) ! io.Error {
    serve_tls_on(l.handle, config, handler)?
}

/// Serves HTTPS as `serve_tls` does, accepting from a `ListenerHandle`.
pub fn serve_tls_on(l: net.ListenerHandle, config: tls.Config, handler: fn(Request) -> Response) ! io.Error {
    var secured = config
    if secured.alpn.len == 0 {
        secured.alpn = ["h2", "http/1.1"]
    }
    for {
        let h = net.accept_handle(l)?
        spawn serve_secure(h, secured, handler)
    }
}

fn serve_secure(h: net.ConnHandle, config: tls.Config, handler: fn(Request) -> Response) {
    using c = net.adopt(h)
    net.set_nodelay(c, true) catch {
        _ => {}
    }
    using t = tls.server(net.stream(c), config) catch {
        _ => return
    }
    serve_from(tls.stream(t), net.format_ip(c.handle.remote.ip), handler) catch {
        _ => {}
    }
}

/// Serves requests from one accepted connection until the connection ends, then closes it.
///
/// Blocks for the lifetime of the connection. `serve` spawns this once per connection.
pub fn serve_conn_on(h: net.ConnHandle, handler: fn(Request) -> Response) {
    using c = net.adopt(h)
    serve_conn(c, handler)
}

/// Serves requests from `c` as `serve_conn_on` does, and closes `c` when the connection ends.
pub fn serve_conn(c: net.Conn, handler: fn(Request) -> Response) {
    net.set_nodelay(c, true) catch {
        _ => {}
    }
    serve_from(net.stream(c), net.format_ip(c.handle.remote.ip), handler) catch {
        _ => {}
    }
    net.close(c)
}

fn reject(s: io.Stream, status: i64) ! io.Error {
    write_response(s, "GET", response(status, status_text(status)), true)?
}

/// Serves requests read from `s` and writes the responses to it, until the peer ends the stream or a response requires the connection to close.
///
/// Blocks until then. `s` is not closed, and `Request.remote` is empty. Returns the error from a failed write; a read failure or end of input ends the loop and returns normally.
pub fn serve_stream(s: io.Stream, handler: fn(Request) -> Response) ! io.Error {
    serve_from(s, "", handler)?
}

/// Writes a `101 Switching Protocols` response with `headers` to the connection of `req` and returns the reader of that connection, for a handler to speak another protocol.
///
/// Fails with `Unsupported` when `req` has no connection to take over, as on HTTP/2 and for a request made by `new_request`, and with `Invalid` for a header that is not valid. After using the connection, return `upgraded()` from the handler.
pub fn upgrade(req: Request, headers: []header.Header) -> *io.Reader ! io.Error {
    let r = match req.connection {
        some(r) => r
        none => fail Unsupported
    }
    write_response(io.reader_stream(r), "GET", Response { status: 101, headers, body: [] }, false)?
    r
}

fn serve_from(s: io.Stream, remote: str, handler: fn(Request) -> Response) ! io.Error {
    let r = io.reader(s)
    for {
        var line = io.read_line(r)?
        for line.len == 0 {
            line = io.read_line(r)?
        }
        if line == preface_line() {
            read_preface_rest(r)?
            return serve_h2(s, r, remote, handler)
        }
        var req = read_request_rest(r, line) catch {
            Malformed => return reject(s, 400)
            TooLarge => return reject(s, 413)
            Unsupported => return reject(s, 505)
            _ => return
        }
        req.remote = remote
        let closing = !keep_alive(req.http10, req.headers)
        if header.has(req.headers, "upgrade") {
            let resp = traced(handler, req)
            cancel.cancel(req.token)
            if resp.status == 101 {
                return
            }
            write_response(s, req.method, resp, closing)?
            if closing {
                return
            }
            continue
        }
        let exchange = watched(r, handler, req)
        let resp = unstreamed(req.method, exchange.response, req.token)
        var ending = closing
        if streaming(resp) {
            ending = write_live(s, req.http10, req.token, resp, exchange.arrived, closing)?
        } else {
            write_response(s, req.method, resp, closing)?
        }
        if ending {
            return
        }
        if ((<-exchange.arrived) ?? -1) <= 0 {
            return
        }
    }
}

struct Watched {
    response: Response
    arrived: chan[i64]
}

fn watch(r: *io.Reader, arrived: chan[i64], token: *cancel.Token) {
    if io.buffered(r) > 0 {
        arrived <- 1
        return
    }
    let n = io.fill(r) catch -1
    if n <= 0 {
        cancel.cancel(token)
    }
    arrived <- n
}

fn watched(r: *io.Reader, handler: fn(Request) -> Response, req: Request) -> Watched {
    let arrived = chan[i64](1)
    spawn watch(r, arrived, req.token)
    let resp = traced(handler, req)
    if !streaming(resp) {
        cancel.cancel(req.token)
    }
    Watched { response: resp, arrived }
}
