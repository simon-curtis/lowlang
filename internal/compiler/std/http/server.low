import std/cancel
import std/io
import std/net
import std/tls

pub fn upgraded() -> Response {
    Response { status: 101, headers: [], body: [] }
}

pub fn serve(l: net.Listener, handler: fn(Request) -> Response) ! io.Error {
    for {
        let c = net.accept(l)?
        spawn serve_conn(c, handler)
    }
}

pub fn serve_tls(l: net.Listener, config: tls.Config, handler: fn(Request) -> Response) ! io.Error {
    var secured = config
    if secured.alpn.len == 0 {
        secured.alpn = ["h2", "http/1.1"]
    }
    for {
        let c = net.accept(l)?
        spawn serve_secure(c, secured, handler)
    }
}

fn serve_secure(c: net.Conn, config: tls.Config, handler: fn(Request) -> Response) {
    net.set_nodelay(c, true) catch {
        _ => {}
    }
    let t = tls.server(net.stream(c), config) catch {
        _ => {
            net.close(c)
            return
        }
    }
    defer tls.close(t)
    serve_stream(tls.stream(t), from_peer(c, handler)) catch {
        _ => {}
    }
}

pub fn serve_conn(c: net.Conn, handler: fn(Request) -> Response) {
    net.set_nodelay(c, true) catch {
        _ => {}
    }
    defer net.close(c)
    serve_stream(net.stream(c), from_peer(c, handler)) catch {
        _ => {}
    }
}

fn from_peer(c: net.Conn, handler: fn(Request) -> Response) -> fn(Request) -> Response {
    let remote = net.format_ip(c.remote.ip)
    fn(req: Request) -> Response {
        var tagged = req
        tagged.remote = remote
        handler(tagged)
    }
}

fn reject(s: io.Stream, status: i64) ! io.Error {
    write_response(s, "GET", response(status, status_text(status)), true)?
}

fn expect_line(r: *io.Reader, want: str) ! io.Error {
    if io.read_line(r)? != want {
        fail Malformed
    }
}

pub fn serve_stream(s: io.Stream, handler: fn(Request) -> Response) ! io.Error {
    let r = io.reader(s)
    for {
        var line = io.read_line(r)?
        for line.len == 0 {
            line = io.read_line(r)?
        }
        if line == "PRI * HTTP/2.0" {
            expect_line(r, "")?
            expect_line(r, "SM")?
            expect_line(r, "")?
            return serve_h2(s, r, handler)
        }
        let req = read_request_rest(r, line) catch {
            Malformed => return reject(s, 400)
            TooLarge => return reject(s, 413)
            Unsupported => return reject(s, 505)
            _ => return
        }
        let closing = !keep_alive(line, req.headers)
        if has_header(req.headers, "upgrade") {
            let resp = traced(handler, req)
            cancel.cancel(req.token)
            if resp.status == 101 {
                return
            }
            write_response(s, req.method, resp, closing)?
            if closing {
                return
            }
            continue
        }
        let exchange = watched(r, handler, req)
        write_response(s, req.method, exchange.response, closing)?
        if closing {
            return
        }
        if ((<-exchange.arrived) ?? -1) <= 0 {
            return
        }
    }
}

struct Watched {
    response: Response
    arrived: chan[i64]
}

fn answer(handler: fn(Request) -> Response, req: Request, out: chan[Response]) {
    out <- traced(handler, req)
}

fn watch(r: *io.Reader, arrived: chan[i64]) {
    if io.buffered(r) > 0 {
        arrived <- 1
        return
    }
    let n = io.fill(r) catch -1
    arrived <- n
}

fn watched(r: *io.Reader, handler: fn(Request) -> Response, req: Request) -> Watched {
    let out = chan[Response](1)
    let arrived = chan[i64](1)
    spawn answer(handler, req, out)
    spawn watch(r, arrived)
    let finished = select {
        resp = <-out => resp
        n = <-arrived => {
            let more = n ?? -1
            arrived <- more
            if more <= 0 {
                cancel.cancel(req.token)
            }
            <-out
        }
    }
    cancel.cancel(req.token)
    Watched { response: finished ?? response(500, ""), arrived }
}
