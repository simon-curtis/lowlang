import std/cancel
import std/header
import std/io
import std/text

fn write_live_head(s: io.Stream, resp: Response, chunked: bool, closing: bool) ! io.Error {
    var out: []u8 = []
    text.append(mut out, "HTTP/1.1 {resp.status} {status_text(resp.status)}\r\n")
    write_head(mut out, resp.headers)?
    if chunked {
        text.append(mut out, "transfer-encoding: chunked\r\n")
    }
    if closing {
        text.append(mut out, "connection: close\r\n")
    }
    text.append(mut out, "\r\n")
    io.write_all(s, out)?
}

fn write_live_part(s: io.Stream, data: []u8, chunked: bool, declared: i64, sent: i64) -> i64 ! io.Error {
    if data.len == 0 {
        return sent
    }
    if declared >= 0 && sent + data.len > declared {
        fail Malformed
    }
    if chunked {
        var framed: []u8 = []
        put_chunk(mut framed, data)
        io.write_all(s, framed)?
    } else {
        io.write_all(s, data)?
    }
    sent + data.len
}

fn pump_live(s: io.Stream, chunks: chan[[]u8], token: *cancel.Token, arrived: chan[i64], chunked: bool, declared: i64) ! io.Error {
    let silent = chan[i64](1)
    var watching = true
    var sent = 0
    for {
        let gate = if watching { arrived } else { silent }
        select {
            part = <-chunks => match part {
                some(data) => {
                    sent = write_live_part(s, data, chunked, declared, sent)?
                }
                none => {
                    if declared >= 0 && sent != declared {
                        fail Malformed
                    }
                    if chunked {
                        io.write_str(s, last_chunk())?
                    }
                    return
                }
            }
            n = <-gate => {
                let more = n ?? -1
                arrived <- more
                if more <= 0 {
                    return
                }
                watching = false
            }
        }
    }
}

fn write_live(s: io.Stream, http10: bool, token: *cancel.Token, resp: Response, arrived: chan[i64], closing: bool) -> bool ! io.Error {
    let chunks = match resp.stream {
        some(c) => c
        none => return closing
    }
    let declared = declared_length(resp.headers) catch -1
    let framed = declared < 0
    let chunked = framed && !http10
    let close = closing || framed && http10
    write_live_head(s, resp, chunked, close) catch {
        e => {
            cancel.cancel(token)
            fail e
        }
    }
    pump_live(s, chunks, token, arrived, chunked, declared) catch {
        e => {
            cancel.cancel(token)
            fail e
        }
    }
    cancel.cancel(token)
    close
}
