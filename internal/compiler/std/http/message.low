import std/cancel
import std/header
import std/io
import std/text

/// The HTTP protocol version a message travelled over.
pub enum Version {
    /// HTTP/1.1, or HTTP/1.0 on a server request that says so.
    Http1
    /// HTTP/2.
    Http2
}

/// An HTTP request, as received by a handler or as written by `write_request`.
///
/// Build one with `new_request` and set the remaining fields directly.
pub struct Request {
    /// The request method, for example `GET`.
    pub method: str
    /// The request target exactly as received, including the query string.
    pub target: str
    /// The part of `target` before the first `?`.
    pub path: str
    /// The part of `target` after the first `?`, without the `?`, or an empty string when there is none. It is not decoded.
    pub query: str
    /// The host and optional port the request is for: the `:authority` pseudo-header on HTTP/2, falling back to `host`, or the `host` header on HTTP/1. Empty when neither was sent.
    pub authority: str
    /// The header fields in the order received. Names are lowercase, and HTTP/2 pseudo-headers are not included.
    pub headers: []header.Header
    /// The complete request body, read before the handler runs; empty when the request has none.
    ///
    /// A body, including a chunked one, larger than 64 MiB is rejected with status `413` on HTTP/1 and by resetting the stream on HTTP/2.
    pub body: []u8
    /// The protocol version the request arrived on.
    pub version: Version
    /// The buffered reader of the underlying connection on HTTP/1, which a handler can take over to speak another protocol; `websocket.accept` does so.
    ///
    /// `none` on HTTP/2 and on a request made by `new_request`.
    pub connection: *io.Reader?
    /// A cancellation token for the request.
    ///
    /// On a server it is cancelled once the handler's response is complete or, for a streaming response, once its last chunk is sent. It is also cancelled when the peer disconnects or the connection fails, so a long-running handler or a streaming producer can watch `cancel.done` to stop early.
    pub token: *cancel.Token
    /// The IP address of the peer as text, without a port. Empty when the connection has no address, as with `serve_stream`.
    pub remote: str
}

/// An HTTP response, as returned by a handler or by the client.
///
/// Build one with `response` or a struct literal. On a server a response is either whole, with the content in `body`, or streaming, with the content delivered through `stream`.
pub struct Response {
    /// The status code, for example `200`.
    pub status: i64
    /// The header fields. A server adds `content-length` to a response that is not streaming when it is absent, except on HTTP/1 for `1xx`, `204` and `304`.
    ///
    /// A header with an invalid name or value makes writing the response fail.
    pub headers: []header.Header
    /// The complete body. Empty for a streaming response and for a response to `HEAD`, `1xx`, `204` and `304`, where it is not sent.
    pub body: []u8
    /// The final URL after following redirects, for a response returned by the client. Empty on a response built by a handler.
    pub url: str = ""
    /// The protocol version the client received the response on. A server ignores it.
    pub version: Version = Http1
    /// The trailer fields. The client fills them from the trailers it receives. A server sends them only over HTTP/2; HTTP/1 responses carry none.
    pub trailers: []header.Header = []
    /// A channel of body chunks that a server writes to the peer as they arrive, or `none`.
    ///
    /// Closing the channel ends the body. If `content-length` is set the chunks must add up to exactly that length or the connection fails; otherwise the body is chunked, or delimited by closing the connection on HTTP/1.0. The server drops the stream and cancels the request token for `HEAD` requests and for `1xx`, `204` and `304` responses. Responses returned by the client never have a stream.
    pub stream: chan[[]u8]? = none
}

/// Returns `true` when `resp` delivers its body through `stream`.
pub fn streaming(resp: Response) -> bool {
    match resp.stream {
        some(_) => true
        none => false
    }
}

fn unstreamed(method: str, resp: Response, token: *cancel.Token) -> Response {
    if !streaming(resp) || !bodiless(method, resp.status) {
        return resp
    }
    cancel.cancel(token)
    var out = resp
    out.stream = none
    out
}

/// Returns a `Request` for `method` and `target`, splitting `path` and `query` at the first `?`.
///
/// The request is `Http1`, has no headers or body, an empty `authority` and `remote`, no `connection` and a fresh cancellation token. Nothing is validated until the request is written.
pub fn new_request(method: str, target: str) -> Request {
    let q = text.index_byte(target, '?')
    Request {
        method
        target
        path: if q >= 0 { target[..q] } else { target }
        query: if q >= 0 { target[q + 1..] } else { "" }
        authority: ""
        headers: []
        body: []
        version: Http1
        connection: none
        token: cancel.token()
        remote: ""
    }
}

/// Returns a `Response` with `status` and the bytes of `body` and no headers.
pub fn response(status: i64, body: str) -> Response {
    Response { status, headers: [], body: bytes(body) }
}

/// Returns the reason phrase for `status`, such as `Not Found` for `404`, or an empty string for a code without a known phrase.
pub fn status_text(status: i64) -> str {
    match status {
        200 => "OK"
        404 => "Not Found"
        500 => "Internal Server Error"
        100 => "Continue"
        101 => "Switching Protocols"
        201 => "Created"
        202 => "Accepted"
        204 => "No Content"
        206 => "Partial Content"
        301 => "Moved Permanently"
        302 => "Found"
        303 => "See Other"
        304 => "Not Modified"
        307 => "Temporary Redirect"
        308 => "Permanent Redirect"
        400 => "Bad Request"
        401 => "Unauthorized"
        403 => "Forbidden"
        405 => "Method Not Allowed"
        407 => "Proxy Authentication Required"
        408 => "Request Timeout"
        409 => "Conflict"
        411 => "Length Required"
        413 => "Content Too Large"
        414 => "URI Too Long"
        415 => "Unsupported Media Type"
        416 => "Range Not Satisfiable"
        417 => "Expectation Failed"
        422 => "Unprocessable Content"
        426 => "Upgrade Required"
        429 => "Too Many Requests"
        431 => "Request Header Fields Too Large"
        501 => "Not Implemented"
        502 => "Bad Gateway"
        503 => "Service Unavailable"
        504 => "Gateway Timeout"
        505 => "HTTP Version Not Supported"
        _ => ""
    }
}

fn known_name(raw: str) -> str? {
    match raw.len {
        4 => {
            if text.equal_fold(raw, "host") { return "host" }
            if text.equal_fold(raw, "date") { return "date" }
            if text.equal_fold(raw, "etag") { return "etag" }
            if text.equal_fold(raw, "vary") { return "vary" }
        }
        5 => {
            if text.equal_fold(raw, "range") { return "range" }
        }
        6 => {
            if text.equal_fold(raw, "accept") { return "accept" }
            if text.equal_fold(raw, "cookie") { return "cookie" }
            if text.equal_fold(raw, "origin") { return "origin" }
            if text.equal_fold(raw, "server") { return "server" }
            if text.equal_fold(raw, "pragma") { return "pragma" }
        }
        7 => {
            if text.equal_fold(raw, "referer") { return "referer" }
            if text.equal_fold(raw, "upgrade") { return "upgrade" }
            if text.equal_fold(raw, "expires") { return "expires" }
        }
        8 => {
            if text.equal_fold(raw, "location") { return "location" }
        }
        10 => {
            if text.equal_fold(raw, "connection") { return "connection" }
            if text.equal_fold(raw, "user-agent") { return "user-agent" }
            if text.equal_fold(raw, "set-cookie") { return "set-cookie" }
        }
        12 => {
            if text.equal_fold(raw, "content-type") { return "content-type" }
        }
        13 => {
            if text.equal_fold(raw, "authorization") { return "authorization" }
            if text.equal_fold(raw, "cache-control") { return "cache-control" }
            if text.equal_fold(raw, "last-modified") { return "last-modified" }
            if text.equal_fold(raw, "if-none-match") { return "if-none-match" }
        }
        14 => {
            if text.equal_fold(raw, "content-length") { return "content-length" }
        }
        15 => {
            if text.equal_fold(raw, "accept-encoding") { return "accept-encoding" }
            if text.equal_fold(raw, "accept-language") { return "accept-language" }
            if text.equal_fold(raw, "x-forwarded-for") { return "x-forwarded-for" }
        }
        16 => {
            if text.equal_fold(raw, "content-encoding") { return "content-encoding" }
        }
        17 => {
            if text.equal_fold(raw, "transfer-encoding") { return "transfer-encoding" }
            if text.equal_fold(raw, "if-modified-since") { return "if-modified-since" }
        }
        _ => {}
    }
    none
}

fn lower_name(raw: str) -> str {
    known_name(raw) ?? text.lower(raw)
}

fn bodiless(method: str, status: i64) -> bool {
    method == "HEAD" || status < 200 || status == 204 || status == 304
}
