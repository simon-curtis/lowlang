import std/io
import std/text

pub struct Header {
    pub name: str
    pub value: str
}

pub enum Version {
    Http1
    Http2
}

pub struct Request {
    pub method: str
    pub target: str
    pub path: str
    pub query: str
    pub authority: str
    pub headers: []Header
    pub body: []u8
    pub version: Version
    pub connection: *io.Reader?
}

pub struct Response {
    pub status: i64
    pub headers: []Header
    pub body: []u8
    pub url: str = ""
    pub version: Version = Http1
    pub trailers: []Header = []
}

pub fn new_request(method: str, target: str) -> Request {
    let q = text.index_byte(target, '?')
    Request {
        method
        target
        path: if q >= 0 { target[..q] } else { target }
        query: if q >= 0 { target[q + 1..] } else { "" }
        authority: ""
        headers: []
        body: []
        version: Http1
        connection: none
    }
}

pub fn response(status: i64, body: str) -> Response {
    Response { status, headers: [], body: bytes(body) }
}

pub fn header(headers: []Header, name: str) -> str? {
    for h in headers {
        if text.equal_fold(h.name, name) {
            return h.value
        }
    }
    none
}

pub fn has_header(headers: []Header, name: str) -> bool {
    match header(headers, name) {
        some(_) => true
        none => false
    }
}

pub fn add_header(mut headers: []Header, name: str, value: str) {
    push(mut headers, Header { name, value })
}

pub fn set_header(mut headers: []Header, name: str, value: str) {
    for i, h in headers {
        if text.equal_fold(h.name, name) {
            headers[i] = Header { name, value }
            return
        }
    }
    push(mut headers, Header { name, value })
}

pub fn status_text(status: i64) -> str {
    let known: [i64: str] = [
        100: "Continue", 101: "Switching Protocols", 200: "OK", 201: "Created", 202: "Accepted",
        204: "No Content", 206: "Partial Content", 301: "Moved Permanently", 302: "Found",
        303: "See Other", 304: "Not Modified", 307: "Temporary Redirect", 308: "Permanent Redirect",
        400: "Bad Request", 401: "Unauthorized", 403: "Forbidden", 404: "Not Found",
        405: "Method Not Allowed", 408: "Request Timeout", 409: "Conflict", 411: "Length Required",
        413: "Content Too Large", 414: "URI Too Long", 415: "Unsupported Media Type", 422: "Unprocessable Content",
        417: "Expectation Failed", 426: "Upgrade Required", 429: "Too Many Requests",
        431: "Request Header Fields Too Large", 500: "Internal Server Error", 501: "Not Implemented",
        502: "Bad Gateway", 503: "Service Unavailable", 504: "Gateway Timeout",
        505: "HTTP Version Not Supported",
    ]
    known[status] ?? ""
}

fn bodiless(method: str, status: i64) -> bool {
    method == "HEAD" || status < 200 || status == 204 || status == 304
}

fn token_byte(c: u8) -> bool {
    if c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9' {
        return true
    }
    text.index_byte("!#$%&'*+-.^_`|~", c) >= 0
}

fn valid_name(name: str) -> bool {
    if name.len == 0 {
        return false
    }
    for i in 0..name.len {
        if !token_byte(name[i]) {
            return false
        }
    }
    true
}

fn valid_value(value: str) -> bool {
    for i in 0..value.len {
        let c = value[i]
        if c == '\r' || c == '\n' || c == 0 {
            return false
        }
    }
    true
}
