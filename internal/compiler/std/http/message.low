import std/cancel
import std/io
import std/text

pub struct Header {
    pub name: str
    pub value: str
}

pub enum Version {
    Http1
    Http2
}

pub struct Request {
    pub method: str
    pub target: str
    pub path: str
    pub query: str
    pub authority: str
    pub headers: []Header
    pub body: []u8
    pub version: Version
    pub connection: *io.Reader?
    pub token: *cancel.Token
    pub remote: str
}

pub struct Response {
    pub status: i64
    pub headers: []Header
    pub body: []u8
    pub url: str = ""
    pub version: Version = Http1
    pub trailers: []Header = []
    pub stream: chan[[]u8]? = none
}

pub fn streaming(resp: Response) -> bool {
    match resp.stream {
        some(_) => true
        none => false
    }
}

fn unstreamed(method: str, resp: Response, token: *cancel.Token) -> Response {
    if !streaming(resp) || !bodiless(method, resp.status) {
        return resp
    }
    cancel.cancel(token)
    var out = resp
    out.stream = none
    out
}

pub fn new_request(method: str, target: str) -> Request {
    let q = text.index_byte(target, '?')
    Request {
        method
        target
        path: if q >= 0 { target[..q] } else { target }
        query: if q >= 0 { target[q + 1..] } else { "" }
        authority: ""
        headers: []
        body: []
        version: Http1
        connection: none
        token: cancel.token()
        remote: ""
    }
}

pub fn response(status: i64, body: str) -> Response {
    Response { status, headers: [], body: bytes(body) }
}

pub fn header(headers: []Header, name: str) -> str? {
    for h in headers {
        if text.equal_fold(h.name, name) {
            return h.value
        }
    }
    none
}

pub fn has_header(headers: []Header, name: str) -> bool {
    match header(headers, name) {
        some(_) => true
        none => false
    }
}

pub fn add_header(mut headers: []Header, name: str, value: str) {
    push(mut headers, Header { name, value })
}

pub fn set_header(mut headers: []Header, name: str, value: str) {
    for i, h in headers {
        if text.equal_fold(h.name, name) {
            headers[i] = Header { name, value }
            return
        }
    }
    push(mut headers, Header { name, value })
}

pub fn status_text(status: i64) -> str {
    match status {
        200 => "OK"
        404 => "Not Found"
        500 => "Internal Server Error"
        100 => "Continue"
        101 => "Switching Protocols"
        201 => "Created"
        202 => "Accepted"
        204 => "No Content"
        206 => "Partial Content"
        301 => "Moved Permanently"
        302 => "Found"
        303 => "See Other"
        304 => "Not Modified"
        307 => "Temporary Redirect"
        308 => "Permanent Redirect"
        400 => "Bad Request"
        401 => "Unauthorized"
        403 => "Forbidden"
        405 => "Method Not Allowed"
        407 => "Proxy Authentication Required"
        408 => "Request Timeout"
        409 => "Conflict"
        411 => "Length Required"
        413 => "Content Too Large"
        414 => "URI Too Long"
        415 => "Unsupported Media Type"
        416 => "Range Not Satisfiable"
        417 => "Expectation Failed"
        422 => "Unprocessable Content"
        426 => "Upgrade Required"
        429 => "Too Many Requests"
        431 => "Request Header Fields Too Large"
        501 => "Not Implemented"
        502 => "Bad Gateway"
        503 => "Service Unavailable"
        504 => "Gateway Timeout"
        505 => "HTTP Version Not Supported"
        _ => ""
    }
}

fn known_name(raw: str) -> str? {
    match raw.len {
        4 => {
            if text.equal_fold(raw, "host") { return "host" }
            if text.equal_fold(raw, "date") { return "date" }
            if text.equal_fold(raw, "etag") { return "etag" }
            if text.equal_fold(raw, "vary") { return "vary" }
        }
        5 => {
            if text.equal_fold(raw, "range") { return "range" }
        }
        6 => {
            if text.equal_fold(raw, "accept") { return "accept" }
            if text.equal_fold(raw, "cookie") { return "cookie" }
            if text.equal_fold(raw, "origin") { return "origin" }
            if text.equal_fold(raw, "server") { return "server" }
            if text.equal_fold(raw, "pragma") { return "pragma" }
        }
        7 => {
            if text.equal_fold(raw, "referer") { return "referer" }
            if text.equal_fold(raw, "upgrade") { return "upgrade" }
            if text.equal_fold(raw, "expires") { return "expires" }
        }
        8 => {
            if text.equal_fold(raw, "location") { return "location" }
        }
        10 => {
            if text.equal_fold(raw, "connection") { return "connection" }
            if text.equal_fold(raw, "user-agent") { return "user-agent" }
            if text.equal_fold(raw, "set-cookie") { return "set-cookie" }
        }
        12 => {
            if text.equal_fold(raw, "content-type") { return "content-type" }
        }
        13 => {
            if text.equal_fold(raw, "authorization") { return "authorization" }
            if text.equal_fold(raw, "cache-control") { return "cache-control" }
            if text.equal_fold(raw, "last-modified") { return "last-modified" }
            if text.equal_fold(raw, "if-none-match") { return "if-none-match" }
        }
        14 => {
            if text.equal_fold(raw, "content-length") { return "content-length" }
        }
        15 => {
            if text.equal_fold(raw, "accept-encoding") { return "accept-encoding" }
            if text.equal_fold(raw, "accept-language") { return "accept-language" }
            if text.equal_fold(raw, "x-forwarded-for") { return "x-forwarded-for" }
        }
        16 => {
            if text.equal_fold(raw, "content-encoding") { return "content-encoding" }
        }
        17 => {
            if text.equal_fold(raw, "transfer-encoding") { return "transfer-encoding" }
            if text.equal_fold(raw, "if-modified-since") { return "if-modified-since" }
        }
        _ => {}
    }
    none
}

fn lower_name(raw: str) -> str {
    known_name(raw) ?? text.lower(raw)
}

fn bodiless(method: str, status: i64) -> bool {
    method == "HEAD" || status < 200 || status == 204 || status == 304
}

fn token_byte(c: u8) -> bool {
    if c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9' {
        return true
    }
    text.index_byte("!#$%&'*+-.^_`|~", c) >= 0
}

fn valid_name(name: str) -> bool {
    if name.len == 0 {
        return false
    }
    for i in 0..name.len {
        if !token_byte(name[i]) {
            return false
        }
    }
    true
}

fn valid_value(value: str) -> bool {
    for i in 0..value.len {
        let c = value[i]
        if c == '\r' || c == '\n' || c == 0 {
            return false
        }
    }
    true
}
