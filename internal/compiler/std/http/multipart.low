import std/header
import std/io
import std/multipart

/// One part of a `multipart/form-data` body, as taken by `with_multipart`.
///
/// Make one with `text_part` or `file_part`.
pub struct Part {
    /// The form field name. It is quoted as `header.quote` does, so a `"` or `\` is escaped with a backslash and a carriage return or line feed is percent-encoded.
    pub name: str
    /// The file name sent with the part. When empty, the default, the part is sent as a plain field without a `filename`. Quoted like `name`.
    pub filename: str = ""
    /// The media type of the part. When empty, the default, the part has no `content-type` line. A value with a carriage return, line feed or zero byte is treated as empty.
    pub content_type: str = ""
    /// The content of the part, sent as it is.
    pub data: []u8
}

/// Returns a `Part` for a plain form field `name` with the bytes of `value` and no file name or content type.
pub fn text_part(name: str, value: str) -> Part {
    Part { name, data: bytes(value) }
}

/// Returns a `Part` for the file `filename` sent under the field `name`, with `content_type` and the bytes `data`.
pub fn file_part(name: str, filename: str, content_type: str, data: []u8) -> Part {
    Part { name, filename, content_type, data }
}

/// Sets the request body to `parts` encoded as `multipart/form-data` by `multipart.Writer`, with a `content-type` that names a random boundary.
///
/// Each part is held in memory; use `with_body_reader` to send a large body.
pub fn with_multipart(b: Builder[Response], parts: []Part) -> Builder[Response] {
    let w = multipart.writer()
    for p in parts {
        append_part(w, p)
    }
    with_body(b, multipart.finish(w), multipart.content_type(w))
}

fn append_part(w: *multipart.Writer, p: Part) {
    var disposition = "form-data; name={header.quote(p.name)}"
    if p.filename.len > 0 {
        disposition = "{disposition}; filename={header.quote(p.filename)}"
    }
    var fields: []header.Header = [header.Header { name: "content-disposition", value: disposition }]
    if p.content_type.len > 0 && header.valid_value(p.content_type) {
        header.add(mut fields, "content-type", p.content_type)
    }
    multipart.write_part(w, fields, p.data) catch {
        _ => {}
    }
}

/// Returns a reader for the multipart body of a request.
///
/// Fails with `BadContentType` when the request has no `content-type` header, and with the errors of `multipart.boundary_from_content_type`.
pub fn multipart_reader(req: Request, limits: multipart.Limits) -> *multipart.Reader ! multipart.Error {
    let content_type = header.get(req.headers, "content-type") ?? fail multipart.Error.BadContentType
    let boundary = multipart.boundary_from_content_type(content_type)?
    multipart.reader(io.bytes_reader(req.body), boundary, limits)?
}

/// Reads the whole multipart body of a request into a `multipart.Form`.
///
/// Fails with the errors of `multipart_reader` and `multipart.read_form`.
pub fn multipart_form(req: Request, limits: multipart.Limits, spill: multipart.Spill?) -> multipart.Form ! multipart.Error {
    let r = multipart_reader(req, limits)?
    multipart.read_form(r, spill)?
}

/// Sets the body and `content-type` of a request from a multipart writer.
///
/// The writer is finished, so nothing can be added to it afterwards. An existing `content-type` header is replaced.
pub fn set_multipart(mut req: Request, w: *multipart.Writer) {
    header.set(mut req.headers, "Content-Type", multipart.content_type(w))
    req.body = multipart.finish(w)
}
