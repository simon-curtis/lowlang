import std/archive
import std/file
import std/io
import std/slices

struct Stamp {
    path: str
    mtime: i64
}

/// Extracts the tar archive in `data` below `dir`, as `extract_from` does.
pub fn extract(data: []u8, dir: str) ! io.Error {
    extract_from(bytes_reader(data), dir)?
}

/// Extracts the gzip-compressed tar archive in `data` below `dir`.
///
/// Fails as `read_gzip` and `extract_from` do.
pub fn extract_gzip(data: []u8, dir: str) ! io.Error {
    extract_from(read_gzip(data)?, dir)?
}

/// Extracts the entries of `r` below `dir`, creating `dir` and its missing parents.
///
/// Each name goes through `archive.resolve`, so an absolute name, a `..` segment, a NUL byte or a path through a symbolic link below `dir` fails with `Denied`. Files are created exclusively and without following links, and an existing file or link at the target is replaced. Permission bits are masked to `0o777`, so setuid, setgid and sticky bits are dropped, and the process umask applies. Modification times are applied to files as they are written and to directories once all entries are placed. Symbolic links are created with their stored target, which is not validated. A hard link is created to the path its target resolves to below `dir`, so the target must already exist. Entries of kind `Other` are skipped.
///
/// Fails with the errors of `next` and of the filesystem.
pub fn extract_from(r: *Reader, dir: str) ! io.Error {
    archive.make_root(dir)?
    var stamps: []Stamp = []
    for {
        let e = next(r)? ?? break
        place(r, e, dir, mut stamps)?
    }
    var i = stamps.len - 1
    for i >= 0 {
        archive.set_mtime(stamps[i].path, stamps[i].mtime)?
        i -= 1
    }
}

fn place(r: *Reader, e: Entry, dir: str, mut stamps: []Stamp) ! io.Error {
    let target = archive.resolve(dir, e.name)?
    match e.kind {
        File => {
            copy_body(r, target, e.mode)?
            archive.set_mtime(target, e.mtime)?
        }
        Dir => {
            archive.make_dir(target, e.mode)?
            push(mut stamps, Stamp { path: target, mtime: e.mtime })
        }
        Symlink => {
            archive.symlink(target, e.link)?
        }
        Hardlink => {
            let source = archive.resolve(dir, e.link)?
            archive.hardlink(target, source)?
        }
        Other => {}
    }
}

fn copy_body(r: *Reader, target: str, mode: i64) ! io.Error {
    using out = archive.create(target, mode)?
    let chunk = io.buffer(65536)
    for {
        let n = read_body(r, chunk)?
        if n == 0 {
            break
        }
        archive.put(out, chunk[..n])?
    }
}

/// Returns a tar archive of the tree below `dir`.
///
/// Names are relative to `dir`, which is not an entry itself, and come in sorted depth-first order. Directories, symbolic links, which are not followed, and regular files are archived with the mode, owner and modification time that `lstat` reports. Other objects are skipped, and hard-linked files are stored as separate copies. Each file is read fully into memory.
///
/// Fails with the error of the filesystem call that failed.
pub fn create(dir: str) -> []u8 ! io.Error {
    let w = writer()
    add_tree(w, dir, "")?
    finish(w)?
    output(w)
}

/// Returns the archive `create` builds, compressed as gzip at deflate `level`.
///
/// Fails as `create` and `write_gzip` do.
pub fn create_gzip(dir: str, level: i64) -> []u8 ! io.Error {
    let w = writer()
    add_tree(w, dir, "")?
    write_gzip(w, level)?
}

fn add_tree(w: *Writer, root: str, rel: str) ! io.Error {
    let here = if rel.len == 0 { root } else { "{root}/{rel}" }
    var names = file.list(here)?
    names |> slices.sort()
    for name in names {
        let child = if rel.len == 0 { name } else { "{rel}/{name}" }
        let kind = add_path(w, "{root}/{child}", child)?
        if kind == archive.Kind.Dir {
            add_tree(w, root, child)?
        }
    }
}

fn add_path(w: *Writer, full: str, name: str) -> archive.Kind ! io.Error {
    let st = archive.lstat(full)?
    let e = Entry { name, size: st.size, mode: st.mode, uid: st.uid, gid: st.gid, mtime: st.mtime }
    match st.kind {
        File => {
            let data = file.read_file(full)?
            add(w, e, data)?
        }
        Dir => {
            add(w, Entry { name, mode: st.mode, uid: st.uid, gid: st.gid, mtime: st.mtime, kind: Dir }, [])?
        }
        Symlink => {
            let target = archive.read_link(full)?
            add(w, Entry { name, mode: st.mode, uid: st.uid, gid: st.gid, mtime: st.mtime, kind: Symlink, link: target }, [])?
        }
        _ => {}
    }
    st.kind
}
