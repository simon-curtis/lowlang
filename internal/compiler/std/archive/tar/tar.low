import std/compress/deflate
import std/io

pub enum Kind {
    File
    Dir
    Symlink
    Hardlink
    Other
}

pub struct Entry {
    pub name: str
    pub size: i64 = 0
    pub mode: i64 = 0o644
    pub uid: i64 = 0
    pub gid: i64 = 0
    pub mtime: i64 = 0
    pub kind: Kind = File
    pub link: str = ""
}

pub struct Limits {
    pub header: i64 = 1 << 20
    pub entry: i64 = 1 << 30
    pub total: i64 = 1 << 30
}

pub struct Reader {
    source: *io.Reader
    limits: Limits
    left: i64
    pad: i64
    consumed: i64
    ended: bool
    scratch: []u8
}

pub fn reader(source: *io.Reader) -> *Reader {
    reader_with(source, Limits {})
}

pub fn reader_with(source: *io.Reader, limits: Limits) -> *Reader {
    new(Reader {
        source
        limits
        left: 0
        pad: 0
        consumed: 0
        ended: false
        scratch: io.buffer(8192)
    })
}

pub fn bytes_reader(data: []u8) -> *Reader {
    reader(io.bytes_reader(data))
}

pub fn read_gzip(data: []u8) -> *Reader ! io.Error {
    read_gzip_with(data, Limits {})
}

pub fn read_gzip_with(data: []u8, limits: Limits) -> *Reader ! io.Error {
    let raw = deflate.gzip_decompress(data, limits.total)?
    reader_with(io.bytes_reader(raw), limits)
}

fn charge(r: *Reader, n: i64) ! io.Error {
    if n > r.limits.total - r.consumed {
        fail TooLarge
    }
    r.consumed += n
}

fn read_up_to(r: *Reader, dst: []u8) -> i64 ! io.Error {
    var got = 0
    for got < dst.len {
        let n = io.read_some(r.source, dst[got..])?
        if n == 0 {
            break
        }
        got += n
    }
    got
}

fn skip(r: *Reader, n: i64) ! io.Error {
    var rest = n
    for rest > 0 {
        let want = if rest < r.scratch.len { rest } else { r.scratch.len }
        let got = io.read_some(r.source, r.scratch[..want])?
        if got == 0 {
            fail Eof
        }
        rest -= got
    }
}

fn discard(r: *Reader) ! io.Error {
    let rest = r.left + r.pad
    r.left = 0
    r.pad = 0
    skip(r, rest)?
}

fn padding(n: i64) -> i64 {
    (512 - n % 512) % 512
}

fn read_block(r: *Reader) -> []u8? ! io.Error {
    let block = io.buffer(512)
    let got = read_up_to(r, block)?
    if got == 0 {
        r.ended = true
        return none
    }
    if got < 512 {
        fail Eof
    }
    charge(r, 512)?
    if is_zero(block) {
        r.ended = true
        return none
    }
    block
}

fn read_extension(r: *Reader, size: i64) -> []u8 ! io.Error {
    let pad = padding(size)
    charge(r, size + pad)?
    let body = io.buffer(size)
    if read_up_to(r, body)? < size {
        fail Eof
    }
    skip(r, pad)?
    body
}

fn extension_size(h: Header, budget: i64) -> i64 ! io.Error {
    if h.size < 0 || h.size > budget {
        fail TooLarge
    }
    h.size
}

fn entry_of(h: Header, p: Pending, limits: Limits) -> Entry ! io.Error {
    let name = p.name ?? h.name
    if name.len == 0 {
        fail Malformed
    }
    let kind = kind_of(h.flag, name)
    let declared = p.size ?? h.size
    if declared < 0 {
        fail Malformed
    }
    let size = if header_only(kind) { 0 } else { declared }
    if size > limits.entry {
        fail TooLarge
    }
    Entry {
        name
        size
        mode: h.mode
        uid: p.uid ?? h.uid
        gid: p.gid ?? h.gid
        mtime: p.mtime ?? h.mtime
        kind
        link: p.link ?? h.link
    }
}

pub fn next(r: *Reader) -> Entry? ! io.Error {
    if r.ended {
        return none
    }
    discard(r)?
    var pending = Pending {}
    var budget = r.limits.header
    for {
        let block = read_block(r)? ?? return none
        let h = parse_header(block)?
        if h.flag == 'S' {
            fail Unsupported
        }
        if h.flag == 'x' || h.flag == 'g' || h.flag == 'L' || h.flag == 'K' {
            let size = extension_size(h, budget)?
            budget -= size
            let body = read_extension(r, size)?
            if h.flag == 'x' {
                parse_pax(body, mut pending)?
            } else if h.flag == 'L' {
                pending.name = cstring(body)
            } else if h.flag == 'K' {
                pending.link = cstring(body)
            }
            continue
        }
        let e = entry_of(h, pending, r.limits)?
        let pad = padding(e.size)
        charge(r, e.size + pad)?
        r.left = e.size
        r.pad = pad
        return e
    }
}

pub fn read_body(r: *Reader, dst: []u8) -> i64 ! io.Error {
    let want = if dst.len < r.left { dst.len } else { r.left }
    if want == 0 {
        return 0
    }
    let n = io.read_some(r.source, dst[..want])?
    if n == 0 {
        fail Eof
    }
    r.left -= n
    n
}

pub fn read_entry(r: *Reader) -> []u8 ! io.Error {
    let out = io.buffer(r.left)
    var got = 0
    for got < out.len {
        got += read_body(r, out[got..])?
    }
    out
}

pub fn list(data: []u8) -> []Entry ! io.Error {
    let r = bytes_reader(data)
    var entries: []Entry = []
    for {
        let e = next(r)? ?? break
        push(mut entries, e)
    }
    entries
}
