import std/archive
import std/compress/deflate
import std/io

/// The type of object a tar entry stores, taken from its type flag.
pub enum Kind {
    /// A regular file.
    File
    /// A directory.
    Dir
    /// A symbolic link; its target is in `Entry.link`.
    Symlink
    /// A hard link to an earlier entry named by `Entry.link`.
    Hardlink
    /// Any other type flag, such as a device or a FIFO.
    ///
    /// The reader returns it with its data. `extract` skips it and the writer rejects it with `Unsupported`.
    Other
}

/// A tar archive member: its name, metadata and, for a link, its target.
///
/// The defaults describe an empty regular file with mode `0o644` owned by id `0`. A writer stores values that do not fit a ustar header field, such as a long name or a large size, in a pax extended header.
pub struct Entry {
    /// The path of the member inside the archive.
    ///
    /// A reader joins a ustar prefix to the name and applies pax and GNU long names. It does not check the result; `extract` does. A directory written by a `Writer` gets a trailing `/`.
    pub name: str
    /// The length of the entry's data in bytes.
    ///
    /// It is `0` for a directory, symbolic link or hard link. A writer ignores it and uses the length of the data it is given.
    pub size: i64 = 0
    /// The permission bits as the header stores them, which can include setuid, setgid and sticky.
    pub mode: i64 = 0o644
    /// The numeric id of the owning user.
    pub uid: i64 = 0
    /// The numeric id of the owning group.
    pub gid: i64 = 0
    /// The modification time in seconds since the Unix epoch.
    ///
    /// A pax `mtime` record replaces the header value and drops any fractional part.
    pub mtime: i64 = 0
    /// The type of object the entry stores.
    pub kind: Kind = File
    /// The target of a `Symlink` or `Hardlink`; empty for other kinds.
    pub link: str = ""
}

/// Bounds a `Reader` applies to the input, so a hostile archive fails with `TooLarge` instead of exhausting memory.
pub struct Limits {
    /// The most bytes of extended header records, pax and GNU long name and link, accepted for one entry. The default is `1 << 20`.
    pub header: i64 = 1 << 20
    /// The largest accepted data size of one entry in bytes. The default is `1 << 30`.
    pub entry: i64 = 1 << 30
    /// The most bytes the reader accepts from the source across headers, data and padding. For `read_gzip` it also bounds the decompressed size. The default is `1 << 30`.
    pub total: i64 = 1 << 30
}

/// A streaming tar reader made by `reader`, `reader_with`, `bytes_reader` or `read_gzip`.
///
/// Call `next` for each entry and read its data with `read_body` or `read_entry` before calling `next` again.
pub struct Reader {
    input: *archive.Input
    limits: Limits
    left: i64
    pad: i64
    ended: bool
}

/// Returns a `Reader` over `source` with the default `Limits`.
pub fn reader(source: *io.Reader) -> *Reader {
    reader_with(source, Limits {})
}

/// Returns a `Reader` over `source` that applies `limits`.
pub fn reader_with(source: *io.Reader, limits: Limits) -> *Reader {
    new(Reader {
        input: archive.input(source, limits.total)
        limits
        left: 0
        pad: 0
        ended: false
    })
}

/// Returns a `Reader` over the archive in `data` with the default `Limits`.
pub fn bytes_reader(data: []u8) -> *Reader {
    reader(io.bytes_reader(data))
}

/// Decompresses the gzip data and returns a `Reader` over the tar archive in it, with the default `Limits`.
///
/// The whole archive is decompressed in memory before this returns. Fails when the data is not valid gzip or decompresses to more than `Limits.total` bytes.
pub fn read_gzip(data: []u8) -> *Reader ! io.Error {
    read_gzip_with(data, Limits {})
}

/// Decompresses the gzip data and returns a `Reader` over the tar archive in it that applies `limits`.
///
/// Fails as `read_gzip` does, with `limits.total` as the decompressed size limit.
pub fn read_gzip_with(data: []u8, limits: Limits) -> *Reader ! io.Error {
    let raw = deflate.gzip_decompress(data, limits.total)?
    reader_with(io.bytes_reader(raw), limits)
}

fn discard(r: *Reader) ! io.Error {
    let rest = r.left + r.pad
    r.left = 0
    r.pad = 0
    archive.skip(r.input, rest)?
}

fn padding(n: i64) -> i64 {
    (512 - n % 512) % 512
}

fn read_block(r: *Reader) -> []u8? ! io.Error {
    let block = io.buffer(512)
    let got = io.read_up_to(r.input.source, block)?
    if got == 0 {
        r.ended = true
        return none
    }
    if got < 512 {
        fail Eof
    }
    archive.charge(r.input, 512)?
    if is_zero(block) {
        r.ended = true
        return none
    }
    block
}

fn read_extension(r: *Reader, size: i64) -> []u8 ! io.Error {
    let pad = padding(size)
    archive.charge(r.input, size + pad)?
    let body = io.read_exact(r.input.source, size)?
    archive.skip(r.input, pad)?
    body
}

fn extension_size(h: Header, budget: i64) -> i64 ! io.Error {
    if h.size < 0 || h.size > budget {
        fail TooLarge
    }
    h.size
}

fn entry_of(h: Header, p: Pending, limits: Limits) -> Entry ! io.Error {
    let name = p.name ?? h.name
    if name.len == 0 {
        fail Malformed
    }
    let kind = kind_of(h.flag, name)
    let declared = p.size ?? h.size
    if declared < 0 {
        fail Malformed
    }
    let size = if header_only(kind) { 0 } else { declared }
    if size > limits.entry {
        fail TooLarge
    }
    Entry {
        name
        size
        mode: h.mode
        uid: p.uid ?? h.uid
        gid: p.gid ?? h.gid
        mtime: p.mtime ?? h.mtime
        kind
        link: p.link ?? h.link
    }
}

/// Returns the next entry, or `none` at the end of the archive.
///
/// The end is a zero block or the end of the input at a block boundary, and every later call returns `none`. Data of the previous entry that was not read is skipped. Pax extended headers (`path`, `linkpath`, `size`, `mtime`, `uid`, `gid`) and GNU long name and link records apply to the entry that follows; pax global headers are skipped. Numbers are read as octal or base-256.
///
/// Fails with `Malformed` for a bad checksum, a bad number or an entry with an empty name, with `Eof` when the input ends inside a block or an entry, with `TooLarge` when a limit is exceeded, and with `Unsupported` for a sparse file.
pub fn next(r: *Reader) -> Entry? ! io.Error {
    if r.ended {
        return none
    }
    discard(r)?
    var pending = Pending {}
    var budget = r.limits.header
    for {
        let block = read_block(r)? ?? return none
        let h = parse_header(block)?
        if h.flag == 'S' {
            fail Unsupported
        }
        if h.flag == 'x' || h.flag == 'g' || h.flag == 'L' || h.flag == 'K' {
            let size = extension_size(h, budget)?
            budget -= size
            let body = read_extension(r, size)?
            if h.flag == 'x' {
                parse_pax(body, mut pending)?
            } else if h.flag == 'L' {
                pending.name = cstring(body)
            } else if h.flag == 'K' {
                pending.link = cstring(body)
            }
            continue
        }
        let e = entry_of(h, pending, r.limits)?
        let pad = padding(e.size)
        archive.charge(r.input, e.size + pad)?
        r.left = e.size
        r.pad = pad
        return e
    }
}

/// Reads up to `dst.len` bytes of the current entry's data into `dst` and returns the count, or `0` once the data is exhausted.
///
/// Fails with `Eof` when the source ends first.
pub fn read_body(r: *Reader, dst: []u8) -> i64 ! io.Error {
    let want = if dst.len < r.left { dst.len } else { r.left }
    if want == 0 {
        return 0
    }
    let n = io.read_some(r.input.source, dst[..want])?
    if n == 0 {
        fail Eof
    }
    r.left -= n
    n
}

/// Returns the rest of the current entry's data in a new slice.
///
/// Errors are those of `read_body`. The slice is empty for a directory, symbolic link and hard link.
pub fn read_entry(r: *Reader) -> []u8 ! io.Error {
    let out = io.buffer(r.left)
    var got = 0
    for got < out.len {
        got += read_body(r, out[got..])?
    }
    out
}

/// Returns the entries of the archive in `data` without their data.
///
/// Fails as `next` does.
pub fn list(data: []u8) -> []Entry ! io.Error {
    let r = bytes_reader(data)
    var entries: []Entry = []
    for {
        let e = next(r)? ?? break
        push(mut entries, e)
    }
    entries
}
