import std/compress/deflate
import std/hash
import std/io
import std/slices

/// The compression method of a zip entry.
pub enum Method {
    /// The data is stored without compression.
    Stored
    /// The data is compressed with deflate.
    Deflate
    /// A method this module cannot read, with its zip method number in `code`.
    ///
    /// Reading such an entry fails with `Unsupported`, and a writer stores it uncompressed.
    Other(code: i64)
}

/// The type of object a zip entry stores.
pub enum Kind {
    /// A regular file.
    File
    /// A directory.
    Dir
    /// A symbolic link; the entry's data is the target path.
    Symlink
}

/// A zip archive member, as listed in the central directory or given to `Writer.add`.
///
/// A writer uses only `name`, `mtime`, `mode`, `kind` and `method`; the other fields are computed. The defaults describe a deflated regular file with mode `0o644`.
pub struct Entry {
    /// The path of the member inside the archive, as stored.
    ///
    /// A directory name ends in `/`. A reader does not check it; `extract_archive` does.
    pub name: str
    /// The uncompressed size in bytes.
    pub size: i64 = 0
    /// The compressed size in bytes as stored in the archive.
    pub compressed: i64 = 0
    /// The compression method.
    ///
    /// A writer stores a `Deflate` file uncompressed when deflate would not make it smaller, and stores any other method uncompressed.
    pub method: Method = Deflate
    /// The CRC-32 of the uncompressed data.
    pub crc: i64 = 0
    /// The modification time in seconds since the Unix epoch.
    ///
    /// A reader takes the extended timestamp field when present and otherwise the MS-DOS date and time, which has two-second resolution, or `0` when the date is unset. A writer stores both; dates before 1980 are stored in the MS-DOS fields as 1980-01-01.
    pub mtime: i64 = 0
    /// The permission bits, including setuid, setgid and sticky.
    ///
    /// A reader takes them from the Unix attributes of an entry made on Unix, and uses `0o755` for a directory and `0o644` for anything else when none are set.
    pub mode: i64 = 0o644
    /// The type of object the entry stores.
    ///
    /// A reader reports a symbolic link from the Unix attributes, and a directory from them, the DOS directory attribute or a trailing `/` in the name.
    pub kind: Kind = File
    /// The offset of the entry's local header from the start of the archive.
    pub offset: i64 = 0
    /// The general purpose bit flags of the entry.
    ///
    /// Bit `0` marks an encrypted entry and bit `11` (`0x800`) marks a UTF-8 name.
    pub flags: i64 = 0
}

/// Bounds applied to an archive when it is opened and when an entry is read, so a hostile archive fails with `TooLarge` instead of exhausting memory.
pub struct Limits {
    /// The largest accepted number of entries. The default is `1 << 20`.
    pub entries: i64 = 1 << 20
    /// The largest accepted uncompressed size of one entry in bytes. The default is `1 << 30`.
    pub entry: i64 = 1 << 30
    /// The largest accepted sum of the uncompressed sizes of all entries in bytes. The default is `1 << 30`.
    pub total: i64 = 1 << 30
    /// The largest accepted ratio of uncompressed to compressed size, for each entry and for the whole archive against its length. The default is `1100`.
    pub ratio: i64 = 1100
}

/// An opened zip archive: its entries and comment, together with the bytes they are read from.
///
/// Made by `open` or `open_with`.
pub struct Archive {
    data: []u8
    limits: Limits
    /// The entries in central directory order.
    pub entries: []Entry
    /// The archive comment; empty when there is none.
    pub comment: str
}

/// Opens the zip archive in `data` with the default `Limits`.
///
/// See `open_with`.
pub fn open(data: []u8) -> Archive ! io.Error {
    open_with(data, Limits {})
}

/// Opens the zip archive in `data` by reading its central directory, applying `limits`.
///
/// zip64 archives are supported. Entry data is neither decompressed nor checked until it is read.
///
/// Fails with `Malformed` when no end of central directory record is found in the last 64 KiB or the records are inconsistent, with `Unsupported` for an archive split over several disks, and with `TooLarge` when the entry count, an entry size, the total size or the compression ratio exceeds a limit.
pub fn open_with(data: []u8, limits: Limits) -> Archive ! io.Error {
    let eocd = find_eocd(data)?
    let dir = locate(data, eocd, limits)?
    let entries = parse_directory(data, dir)?
    check_totals(entries, data.len, limits)?
    let comment_len = io.le16(data, eocd + 20)
    Archive { data, limits, entries, comment: str(data[eocd + 22..eocd + 22 + comment_len]) }
}

/// Returns the first entry whose name equals `name`, or `none`.
pub fn find(a: Archive, name: str) -> Entry? {
    for e in a.entries {
        if e.name == name {
            return e
        }
    }
    none
}

/// Returns the uncompressed data of the entry named `name`.
///
/// Fails with `NotFound` when there is no such entry, and otherwise as `read` does.
pub fn read_entry(a: Archive, name: str) -> []u8 ! io.Error {
    let e = find(a, name) ?? fail NotFound
    read(a, e)?
}

fn encrypted(e: Entry) -> bool {
    e.flags & 1 != 0
}

fn data_range(a: Archive, e: Entry) -> []u8 ! io.Error {
    let at = e.offset
    if at < 0 || at > a.data.len - 30 || io.le32(a.data, at) != local_signature() {
        fail Malformed
    }
    let start = at + 30 + io.le16(a.data, at + 26) + io.le16(a.data, at + 28)
    if start > a.data.len || e.compressed > a.data.len - start {
        fail Malformed
    }
    a.data[start..start + e.compressed]
}

fn unpack(raw: []u8, e: Entry) -> []u8 ! io.Error {
    match e.method {
        Stored => {
            if e.compressed != e.size {
                fail Malformed
            }
            slices.clone(raw)
        }
        Deflate => deflate.decompress(raw, e.size)?
        Other(_) => fail Unsupported
    }
}

/// Returns the uncompressed data of the entry `e` of `a` in a new slice.
///
/// Fails with `Unsupported` for an encrypted entry or a method other than stored or deflate, with `TooLarge` when `e.size` exceeds `Limits.entry`, and with `Malformed` when the local header is missing or out of range, the stored sizes disagree, the deflate data is invalid, or the length or CRC-32 of the result does not match the entry.
pub fn read(a: Archive, e: Entry) -> []u8 ! io.Error {
    if encrypted(e) {
        fail Unsupported
    }
    if e.size > a.limits.entry {
        fail TooLarge
    }
    let raw = data_range(a, e)?
    let out = unpack(raw, e)?
    if out.len != e.size || i64(hash.crc32(out)) != e.crc {
        fail Malformed
    }
    out
}
