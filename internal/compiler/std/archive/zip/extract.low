import std/archive
import std/io

pub fn extract(data: []u8, dir: str) ! io.Error {
    let a = open(data)?
    extract_archive(a, dir)?
}

pub fn extract_archive(a: Archive, dir: str) ! io.Error {
    for e in a.entries {
        archive.clean_name(e.name)?
    }
    archive.make_root(dir)?
    for e in a.entries {
        place(a, e, dir)?
    }
}

fn place(a: Archive, e: Entry, dir: str) ! io.Error {
    let target = archive.resolve(dir, e.name)?
    match e.kind {
        Dir => {
            archive.make_dir(target, e.mode)?
        }
        File => {
            let body = read(a, e)?
            archive.write_file(target, body, e.mode)?
            archive.set_mtime(target, e.mtime)?
        }
        Symlink => {
            let body = read(a, e)?
            archive.symlink(target, str(body))?
        }
    }
}
