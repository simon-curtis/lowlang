import std/compress/deflate
import std/hash
import std/io
import std/text
import std/time/datetime

/// A zip writer made by `writer` or `stream_writer`.
///
/// Each entry is written as `add` is called, compressed in memory, and `finish` writes the central directory. Entries are written without data descriptors.
pub struct Writer {
    sink: io.Stream?
    data: []u8
    central: []u8
    count: i64
    written: i64
    force64: bool
    closed: bool
}

struct Prepared {
    name: str
    body: []u8
    method: i64
    crc: i64
    size: i64
    flags: i64
    mode: i64
    external: i64
}

/// Returns a `Writer` that collects the archive in memory; `output` returns the bytes.
pub fn writer() -> *Writer {
    new(Writer { sink: none, data: [], central: [], count: 0, written: 0, force64: false, closed: false })
}

/// Returns a `Writer` that writes the archive to `sink`.
///
/// The writer does not close `sink`, and `output` stays empty.
pub fn stream_writer(sink: io.Stream) -> *Writer {
    new(Writer { sink, data: [], central: [], count: 0, written: 0, force64: false, closed: false })
}

/// Makes the writer use zip64 records for every entry added after the call and for the end of the archive, even when no size or count needs them.
pub fn force_zip64(w: *Writer) {
    w.force64 = true
}

/// Returns the bytes collected by a `Writer` made with `writer`.
///
/// Call it after `finish` for a complete archive. It is empty for a stream writer.
pub fn output(w: *Writer) -> []u8 {
    w.data
}

fn emit(w: *Writer, chunk: []u8) ! io.Error {
    match w.sink {
        some(s) => io.write_all(s, chunk)?
        none => io.append(mut w.data, chunk)
    }
    w.written += chunk.len
}

fn dos_date(seconds: i64) -> i64 {
    let when = datetime.from_civil_seconds(seconds, 0) catch {
        _ => return if seconds < 0 { 0x21 } else { 0xFF9F }
    }
    let year = datetime.year(when)
    if year < 1980 {
        return 0x21
    }
    (year - 1980) << 9 | datetime.month_number(when) << 5 | datetime.day(when)
}

fn dos_clock(seconds: i64) -> i64 {
    let when = datetime.from_civil_seconds(seconds, 0) catch {
        _ => return if seconds < 0 { 0 } else { 0xBF7D }
    }
    if datetime.year(when) < 1980 {
        return 0
    }
    datetime.hour(when) << 11 | datetime.minute(when) << 5 | datetime.second(when) / 2
}

fn timestamp_extra(mtime: i64) -> []u8 {
    var out: []u8 = []
    if mtime < 0 || mtime > saturated32() {
        return out
    }
    io.put_le16(mut out, 0x5455)
    io.put_le16(mut out, 5)
    push(mut out, 1)
    io.put_le32(mut out, mtime)
    out
}

fn validate(w: *Writer, e: Entry) ! io.Error {
    if w.closed || e.name.len == 0 || e.name.len > saturated16() || text.index_byte(e.name, 0) >= 0 {
        fail Invalid
    }
}

fn compress(data: []u8, method: Method) -> Packed {
    match method {
        Deflate => {
            let packed = deflate.compress(data, 6)
            if packed.len < data.len {
                return Packed { body: packed, method: 8 }
            }
            Packed { body: data, method: 0 }
        }
        _ => Packed { body: data, method: 0 }
    }
}

struct Packed {
    body: []u8
    method: i64
}

fn prepare(e: Entry, data: []u8) -> Prepared {
    let perm = e.mode & 0o7777
    match e.kind {
        Dir => {
            let name = if text.ends_with(e.name, "/") { e.name } else { "{e.name}/" }
            Prepared { name, body: [], method: 0, crc: 0, size: 0, flags: flags_of(name), mode: 0o40000 | perm, external: 0x10 }
        }
        Symlink => Prepared { name: e.name, body: data, method: 0, crc: i64(hash.crc32(data)), size: data.len, flags: flags_of(e.name), mode: 0o120000 | perm, external: 0 }
        File => {
            let packed = compress(data, e.method)
            Prepared { name: e.name, body: packed.body, method: packed.method, crc: i64(hash.crc32(data)), size: data.len, flags: flags_of(e.name), mode: 0o100000 | perm, external: 0 }
        }
    }
}

fn flags_of(name: str) -> i64 {
    if text.is_ascii(name) { 0 } else { 0x800 }
}

fn local_header(w: *Writer, p: Prepared, mtime: i64) -> []u8 {
    let wide = w.force64 || p.size >= saturated32() || p.body.len >= saturated32()
    var extra: []u8 = []
    if wide {
        io.put_le16(mut extra, 1)
        io.put_le16(mut extra, 16)
        io.put_le64(mut extra, p.size)
        io.put_le64(mut extra, p.body.len)
    }
    io.append(mut extra, timestamp_extra(mtime))
    var out: []u8 = []
    io.put_le32(mut out, local_signature())
    io.put_le16(mut out, if wide { 45 } else { 20 })
    io.put_le16(mut out, p.flags)
    io.put_le16(mut out, p.method)
    io.put_le16(mut out, dos_clock(mtime))
    io.put_le16(mut out, dos_date(mtime))
    io.put_le32(mut out, p.crc)
    io.put_le32(mut out, if wide { saturated32() } else { p.body.len })
    io.put_le32(mut out, if wide { saturated32() } else { p.size })
    io.put_le16(mut out, p.name.len)
    io.put_le16(mut out, extra.len)
    text.append(mut out, p.name)
    io.append(mut out, extra)
    out
}

fn add_central(w: *Writer, p: Prepared, mtime: i64, offset: i64) {
    let sizes_wide = w.force64 || p.size >= saturated32() || p.body.len >= saturated32()
    let offset_wide = w.force64 || offset >= saturated32()
    var extra: []u8 = []
    if sizes_wide || offset_wide {
        io.put_le16(mut extra, 1)
        io.put_le16(mut extra, (if sizes_wide { 16 } else { 0 }) + (if offset_wide { 8 } else { 0 }))
        if sizes_wide {
            io.put_le64(mut extra, p.size)
            io.put_le64(mut extra, p.body.len)
        }
        if offset_wide {
            io.put_le64(mut extra, offset)
        }
    }
    io.append(mut extra, timestamp_extra(mtime))
    var record: []u8 = []
    io.put_le32(mut record, central_signature())
    io.put_le16(mut record, 3 << 8 | if sizes_wide || offset_wide { 45 } else { 20 })
    io.put_le16(mut record, if sizes_wide || offset_wide { 45 } else { 20 })
    io.put_le16(mut record, p.flags)
    io.put_le16(mut record, p.method)
    io.put_le16(mut record, dos_clock(mtime))
    io.put_le16(mut record, dos_date(mtime))
    io.put_le32(mut record, p.crc)
    io.put_le32(mut record, if sizes_wide { saturated32() } else { p.body.len })
    io.put_le32(mut record, if sizes_wide { saturated32() } else { p.size })
    io.put_le16(mut record, p.name.len)
    io.put_le16(mut record, extra.len)
    io.put_le16(mut record, 0)
    io.put_le16(mut record, 0)
    io.put_le16(mut record, 0)
    io.put_le32(mut record, p.mode << 16 | p.external)
    io.put_le32(mut record, if offset_wide { saturated32() } else { offset })
    text.append(mut record, p.name)
    io.append(mut record, extra)
    io.append(mut w.central, record)
    w.count += 1
}

/// Writes the entry `e` with `data` as its contents.
///
/// A `File` is compressed per `e.method`. A `Symlink` stores `data` as the link target. A `Dir` stores no data and gets a trailing `/` when it lacks one. The type and the low 12 bits of `e.mode` are recorded as Unix attributes, `e.mtime` as an MS-DOS timestamp and as an extended timestamp when it is between `0` and `0xFFFFFFFF`, and a non-ASCII name sets the UTF-8 flag. Sizes or offsets of `0xFFFFFFFF` or more are written as zip64 extra fields.
///
/// Fails with `Invalid` after `finish`, for an empty name, a name longer than 65535 bytes and a name with a NUL byte, and with the error of the sink.
pub fn add(w: *Writer, e: Entry, data: []u8) ! io.Error {
    validate(w, e)?
    let p = prepare(e, data)
    let offset = w.written
    emit(w, local_header(w, p, e.mtime))?
    emit(w, p.body)?
    add_central(w, p, e.mtime, offset)
}

/// Writes a regular file `name` with `data` compressed with `method`, with mode `0o644` and a modification time of `0`.
pub fn add_file(w: *Writer, name: str, data: []u8, method: Method) ! io.Error {
    add(w, Entry { name, method }, data)?
}

/// Writes a directory `name` with mode `0o755` and a modification time of `0`.
pub fn add_dir(w: *Writer, name: str) ! io.Error {
    add(w, Entry { name, kind: Dir, method: Stored, mode: 0o755 }, [])?
}

/// Writes a symbolic link `name` that points to `target`, with mode `0o777` and a modification time of `0`.
pub fn add_symlink(w: *Writer, name: str, target: str) ! io.Error {
    add(w, Entry { name, kind: Symlink, method: Stored, mode: 0o777 }, bytes(target))?
}

/// Writes the central directory and the end of central directory record.
///
/// zip64 end records are added when the writer is forced, when the entry count reaches `0xFFFF` or when the directory size or offset reaches `0xFFFFFFFF`. A second call does nothing. After `finish`, `add` fails with `Invalid`.
pub fn finish(w: *Writer) ! io.Error {
    if w.closed {
        return
    }
    w.closed = true
    let offset = w.written
    let size = w.central.len
    emit(w, w.central)?
    let wide = w.force64 || w.count >= saturated16() || size >= saturated32() || offset >= saturated32()
    var out: []u8 = []
    if wide {
        io.put_le32(mut out, zip64_end_signature())
        io.put_le64(mut out, 44)
        io.put_le16(mut out, 45)
        io.put_le16(mut out, 45)
        io.put_le32(mut out, 0)
        io.put_le32(mut out, 0)
        io.put_le64(mut out, w.count)
        io.put_le64(mut out, w.count)
        io.put_le64(mut out, size)
        io.put_le64(mut out, offset)
        io.put_le32(mut out, zip64_locator_signature())
        io.put_le32(mut out, 0)
        io.put_le64(mut out, offset + size)
        io.put_le32(mut out, 1)
    }
    io.put_le32(mut out, end_signature())
    io.put_le16(mut out, 0)
    io.put_le16(mut out, 0)
    io.put_le16(mut out, if wide { saturated16() } else { w.count })
    io.put_le16(mut out, if wide { saturated16() } else { w.count })
    io.put_le32(mut out, if wide { saturated32() } else { size })
    io.put_le32(mut out, if wide { saturated32() } else { offset })
    io.put_le16(mut out, 0)
    emit(w, out)?
}
