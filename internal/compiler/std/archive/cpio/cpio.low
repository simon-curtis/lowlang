import std/archive
import std/io

/// The type of object a cpio entry stores, taken from the file type bits of its mode.
pub enum Kind {
    /// A regular file.
    File
    /// A directory.
    Dir
    /// A symbolic link; its target is in `Entry.link`.
    Symlink
    /// A character device.
    Char
    /// A block device.
    Block
    /// A named pipe.
    Fifo
    /// A socket.
    Socket
}

/// The header layout of a cpio archive.
///
/// A `Reader` detects the layout of each entry from its magic number. A `Writer` writes every entry in the format it was made with.
pub enum Format {
    /// The SVR4 `newc` format, magic `070701`: hexadecimal header fields and names and data aligned to 4 bytes.
    Newc
    /// The SVR4 format with a checksum, magic `070702`: `Newc` plus the byte sum of each regular file's data.
    Crc
    /// The POSIX portable `odc` format, magic `070707`: octal header fields and no alignment.
    Odc
}

/// A cpio archive member: its name and metadata, and for a symbolic link its target.
///
/// The defaults describe an empty regular file with mode `0o644` owned by id `0`. When an entry is written, a value that does not fit its header field fails with `TooLarge`: 8 hexadecimal digits in `Newc` and `Crc`, and 6 or 11 octal digits in `Odc`.
pub struct Entry {
    /// The path of the member inside the archive, as stored.
    ///
    /// The reader does not check it; `extract` does. The writer rejects an empty name, `TRAILER!!!` and a name with a NUL byte.
    pub name: str
    /// The length of the file data in bytes.
    ///
    /// A reader reports `0` for a symbolic link, whose target is in `link`. A writer ignores it and uses the length of the data it is given.
    pub size: i64 = 0
    /// The permission bits, including setuid, setgid and sticky; the file type is in `kind`.
    pub mode: i64 = 0o644
    /// The numeric id of the owning user.
    pub uid: i64 = 0
    /// The numeric id of the owning group.
    pub gid: i64 = 0
    /// The modification time in seconds since the Unix epoch.
    pub mtime: i64 = 0
    /// The type of object the entry stores.
    pub kind: Kind = File
    /// The target of a symbolic link; empty for every other kind.
    pub link: str = ""
    /// The inode number.
    ///
    /// Entries with the same `ino`, `dev_major` and `dev_minor` and an `nlink` above `1` are hard links to one file. A writer assigns the next unused number, starting at `1`, when this is negative, which is the default.
    pub ino: i64 = -1
    /// The number of links to the file.
    ///
    /// A value above `1` marks the entry as one name of a hard-linked file; `extract` recreates the links. In `Newc` and `Crc` only the last link of a file carries its data.
    pub nlink: i64 = 1
    /// The major number of the device that holds the file.
    pub dev_major: i64 = 0
    /// The minor number of the device that holds the file.
    pub dev_minor: i64 = 0
    /// The major number of the device a `Char` or `Block` entry stands for.
    pub rdev_major: i64 = 0
    /// The minor number of the device a `Char` or `Block` entry stands for.
    pub rdev_minor: i64 = 0
}

/// Bounds a `Reader` applies to the input, so a hostile archive fails with `TooLarge` instead of exhausting memory.
pub struct Limits {
    /// The largest accepted name field in bytes, including its terminating NUL, and the largest accepted symbolic link target. The default is `65536`.
    pub name: i64 = 65536
    /// The largest accepted data size of one entry in bytes. The default is `1 << 30`.
    pub entry: i64 = 1 << 30
    /// The most bytes the reader accepts from the source across headers, names, data and padding. The default is `1 << 30`.
    pub total: i64 = 1 << 30
}

/// A streaming cpio reader made by `reader`, `reader_with` or `bytes_reader`.
///
/// Call `next` for each entry and read its data with `read_body` or `read_entry` before calling `next` again.
pub struct Reader {
    input: *archive.Input
    limits: Limits
    left: i64
    pad: i64
    ended: bool
    verify: bool
    expected: i64
    sum: i64
}

/// Returns a `Reader` over `source` with the default `Limits`.
pub fn reader(source: *io.Reader) -> *Reader {
    reader_with(source, Limits {})
}

/// Returns a `Reader` over `source` that applies `limits`.
pub fn reader_with(source: *io.Reader, limits: Limits) -> *Reader {
    new(Reader {
        input: archive.input(source, limits.total)
        limits
        left: 0
        pad: 0
        ended: false
        verify: false
        expected: 0
        sum: 0
    })
}

/// Returns a `Reader` over the archive in `data` with the default `Limits`.
pub fn bytes_reader(data: []u8) -> *Reader {
    reader(io.bytes_reader(data))
}

fn discard(r: *Reader) ! io.Error {
    for r.left > 0 {
        read_body(r, r.input.scratch)?
    }
    let rest = r.pad
    r.pad = 0
    archive.skip(r.input, rest)?
}

fn read_header(r: *Reader) -> Header ! io.Error {
    let magic = io.read_exact(r.input.source, 6)?
    let format = parse_magic(magic)?
    if format == Odc {
        let rest = io.read_exact(r.input.source, odc_length - 6)?
        return parse_odc(rest)?
    }
    let rest = io.read_exact(r.input.source, newc_length - 6)?
    parse_newc(format, rest)?
}

fn read_name(r: *Reader, h: Header) -> str ! io.Error {
    if h.name_size < 1 {
        fail Malformed
    }
    if h.name_size > r.limits.name {
        fail TooLarge
    }
    let raw = io.read_exact(r.input.source, h.name_size)?
    if raw[h.name_size - 1] != 0 {
        fail Malformed
    }
    for i in 0..h.name_size - 1 {
        if raw[i] == 0 {
            fail Malformed
        }
    }
    if h.format != Odc {
        archive.skip(r.input, padding(h.length + h.name_size))?
    }
    str(raw[..h.name_size - 1])
}

fn body_padding(h: Header, size: i64) -> i64 {
    if h.format == Odc {
        return 0
    }
    padding(size)
}

fn entry_of(r: *Reader, h: Header, name: str) -> Entry ! io.Error {
    if name.len == 0 {
        fail Malformed
    }
    let kind = kind_of(h.mode)?
    if h.size > r.limits.entry {
        fail TooLarge
    }
    var e = Entry {
        name
        size: h.size
        mode: h.mode & 0o7777
        uid: h.uid
        gid: h.gid
        mtime: h.mtime
        kind
        ino: h.ino
        nlink: h.nlink
        dev_major: h.dev_major
        dev_minor: h.dev_minor
        rdev_major: h.rdev_major
        rdev_minor: h.rdev_minor
    }
    let pad = body_padding(h, h.size)
    archive.charge(r.input, h.size + pad)?
    r.left = h.size
    r.pad = pad
    r.verify = h.format == Crc && kind == File && h.size > 0
    r.expected = h.check
    r.sum = 0
    if kind == Symlink {
        if h.size > r.limits.name {
            fail TooLarge
        }
        e.link = str(read_entry(r)?)
        e.size = 0
    }
    e
}

/// Returns the next entry, or `none` at the `TRAILER!!!` entry. Every later call returns `none`.
///
/// Data of the previous entry that was not read is read and discarded, which still checks the checksum of a `Crc` entry. The target of a symbolic link is read into `link` and its `size` is `0`.
///
/// Fails with `Eof` when the input ends before the trailer, with `Malformed` for an unknown magic number, a non-digit in a header field, an empty or unterminated name or an unknown file type, with `Unsupported` for the binary cpio format, and with `TooLarge` when a limit is exceeded.
pub fn next(r: *Reader) -> Entry? ! io.Error {
    if r.ended {
        return none
    }
    discard(r)?
    let h = read_header(r)?
    let name = read_name(r, h)?
    archive.charge(r.input, h.length + h.name_size + padding(h.length + h.name_size))?
    if name == trailer {
        r.ended = true
        return none
    }
    entry_of(r, h, name)?
}

/// Reads up to `dst.len` bytes of the current entry's data into `dst` and returns the count, or `0` once the data is exhausted.
///
/// Fails with `Eof` when the source ends first. For a regular file in the `Crc` format the byte sum is checked when the last byte is read, and a mismatch fails with `Malformed`. A directory has no data and a symbolic link's data was already read by `next`, so both return `0`.
pub fn read_body(r: *Reader, dst: []u8) -> i64 ! io.Error {
    let want = if dst.len < r.left { dst.len } else { r.left }
    if want == 0 {
        return 0
    }
    let n = io.read_some(r.input.source, dst[..want])?
    if n == 0 {
        fail Eof
    }
    r.left -= n
    if r.verify {
        for b in dst[..n] {
            r.sum += i64(b)
        }
        if r.left == 0 && r.sum & 0xFFFFFFFF != r.expected {
            fail Malformed
        }
    }
    n
}

/// Returns the rest of the current entry's data in a new slice.
///
/// Errors are those of `read_body`. The slice is empty for a directory and a symbolic link.
pub fn read_entry(r: *Reader) -> []u8 ! io.Error {
    let out = io.buffer(r.left)
    var got = 0
    for got < out.len {
        got += read_body(r, out[got..])?
    }
    out
}

/// Returns the entries of the archive in `data` without their data.
///
/// Fails as `next` does.
pub fn list(data: []u8) -> []Entry ! io.Error {
    let r = bytes_reader(data)
    var entries: []Entry = []
    for {
        let e = next(r)? ?? break
        push(mut entries, e)
    }
    entries
}
