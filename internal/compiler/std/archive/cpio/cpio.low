import std/io

pub enum Kind {
    File
    Dir
    Symlink
    Char
    Block
    Fifo
    Socket
}

pub enum Format {
    Newc
    Crc
    Odc
}

pub struct Entry {
    pub name: str
    pub size: i64 = 0
    pub mode: i64 = 0o644
    pub uid: i64 = 0
    pub gid: i64 = 0
    pub mtime: i64 = 0
    pub kind: Kind = File
    pub link: str = ""
    pub ino: i64 = -1
    pub nlink: i64 = 1
    pub dev_major: i64 = 0
    pub dev_minor: i64 = 0
    pub rdev_major: i64 = 0
    pub rdev_minor: i64 = 0
}

pub struct Limits {
    pub name: i64 = 65536
    pub entry: i64 = 1 << 30
    pub total: i64 = 1 << 30
}

pub struct Reader {
    source: *io.Reader
    limits: Limits
    left: i64
    pad: i64
    consumed: i64
    ended: bool
    scratch: []u8
    verify: bool
    expected: i64
    sum: i64
}

pub fn reader(source: *io.Reader) -> *Reader {
    reader_with(source, Limits {})
}

pub fn reader_with(source: *io.Reader, limits: Limits) -> *Reader {
    new(Reader {
        source
        limits
        left: 0
        pad: 0
        consumed: 0
        ended: false
        scratch: io.buffer(8192)
        verify: false
        expected: 0
        sum: 0
    })
}

pub fn bytes_reader(data: []u8) -> *Reader {
    reader(io.bytes_reader(data))
}

fn charge(r: *Reader, n: i64) ! io.Error {
    if n > r.limits.total - r.consumed {
        fail TooLarge
    }
    r.consumed += n
}

fn read_up_to(r: *Reader, dst: []u8) -> i64 ! io.Error {
    var got = 0
    for got < dst.len {
        let n = io.read_some(r.source, dst[got..])?
        if n == 0 {
            break
        }
        got += n
    }
    got
}

fn read_exact(r: *Reader, n: i64) -> []u8 ! io.Error {
    let out = io.buffer(n)
    if read_up_to(r, out)? < n {
        fail Eof
    }
    out
}

fn skip(r: *Reader, n: i64) ! io.Error {
    var rest = n
    for rest > 0 {
        let want = if rest < r.scratch.len { rest } else { r.scratch.len }
        let got = io.read_some(r.source, r.scratch[..want])?
        if got == 0 {
            fail Eof
        }
        rest -= got
    }
}

fn discard(r: *Reader) ! io.Error {
    for r.left > 0 {
        read_body(r, r.scratch)?
    }
    let rest = r.pad
    r.pad = 0
    skip(r, rest)?
}

fn read_header(r: *Reader) -> Header ! io.Error {
    let magic = io.buffer(6)
    if read_up_to(r, magic)? < 6 {
        fail Eof
    }
    let format = parse_magic(magic)?
    if format == Odc {
        return parse_odc(read_exact(r, odc_length() - 6)?)?
    }
    parse_newc(format, read_exact(r, newc_length() - 6)?)?
}

fn read_name(r: *Reader, h: Header) -> str ! io.Error {
    if h.name_size < 1 {
        fail Malformed
    }
    if h.name_size > r.limits.name {
        fail TooLarge
    }
    let raw = read_exact(r, h.name_size)?
    if raw[h.name_size - 1] != 0 {
        fail Malformed
    }
    for i in 0..h.name_size - 1 {
        if raw[i] == 0 {
            fail Malformed
        }
    }
    if h.format != Odc {
        skip(r, padding(h.length + h.name_size))?
    }
    str(raw[..h.name_size - 1])
}

fn body_padding(h: Header, size: i64) -> i64 {
    if h.format == Odc {
        return 0
    }
    padding(size)
}

fn entry_of(r: *Reader, h: Header, name: str) -> Entry ! io.Error {
    if name.len == 0 {
        fail Malformed
    }
    let kind = kind_of(h.mode)?
    if h.size > r.limits.entry {
        fail TooLarge
    }
    var e = Entry {
        name
        size: h.size
        mode: h.mode & 0o7777
        uid: h.uid
        gid: h.gid
        mtime: h.mtime
        kind
        ino: h.ino
        nlink: h.nlink
        dev_major: h.dev_major
        dev_minor: h.dev_minor
        rdev_major: h.rdev_major
        rdev_minor: h.rdev_minor
    }
    let pad = body_padding(h, h.size)
    charge(r, h.size + pad)?
    r.left = h.size
    r.pad = pad
    r.verify = h.format == Crc && kind == File && h.size > 0
    r.expected = h.check
    r.sum = 0
    if kind == Symlink {
        if h.size > r.limits.name {
            fail TooLarge
        }
        e.link = str(read_entry(r)?)
        e.size = 0
    }
    e
}

pub fn next(r: *Reader) -> Entry? ! io.Error {
    if r.ended {
        return none
    }
    discard(r)?
    let h = read_header(r)?
    let name = read_name(r, h)?
    charge(r, h.length + h.name_size + padding(h.length + h.name_size))?
    if name == trailer() {
        r.ended = true
        return none
    }
    entry_of(r, h, name)?
}

pub fn read_body(r: *Reader, dst: []u8) -> i64 ! io.Error {
    let want = if dst.len < r.left { dst.len } else { r.left }
    if want == 0 {
        return 0
    }
    let n = io.read_some(r.source, dst[..want])?
    if n == 0 {
        fail Eof
    }
    r.left -= n
    if r.verify {
        for b in dst[..n] {
            r.sum += i64(b)
        }
        if r.left == 0 && r.sum & 0xFFFFFFFF != r.expected {
            fail Malformed
        }
    }
    n
}

pub fn read_entry(r: *Reader) -> []u8 ! io.Error {
    let out = io.buffer(r.left)
    var got = 0
    for got < out.len {
        got += read_body(r, out[got..])?
    }
    out
}

pub fn list(data: []u8) -> []Entry ! io.Error {
    let r = bytes_reader(data)
    var entries: []Entry = []
    for {
        let e = next(r)? ?? break
        push(mut entries, e)
    }
    entries
}
