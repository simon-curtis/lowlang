import std/archive
import std/file
import std/io
import std/slices

struct Stamp {
    path: str
    mtime: i64
}

struct Group {
    seen: i64
    placed: str
    pending: []str
    mtime: i64
}

struct Item {
    name: str
    full: str
    info: file.Info
}

/// Extracts the cpio archive in `data` below `dir`, as `extract_from` does.
pub fn extract(data: []u8, dir: str) ! io.Error {
    extract_from(bytes_reader(data), dir)?
}

/// Extracts the entries of `r` below `dir`, creating `dir` and its missing parents.
///
/// Each name goes through `archive.resolve`, so an absolute name, a `..` segment, a NUL byte or a path through a symbolic link below `dir` fails with `Denied`. Files are created exclusively and without following links, and an existing file or link at the target is replaced. Permission bits are masked to `0o777`, so setuid, setgid and sticky bits are dropped, and the process umask applies. Modification times are applied to files as they are written and to directories once all entries are placed. Symbolic links are created with their stored target, which is not validated. Character, block, fifo and socket entries are skipped.
///
/// Hard links are recreated: files that share `dev_major`, `dev_minor` and `ino` with an `nlink` above `1` are linked to the one entry that carries data. A group with no data becomes an empty file with the other names linked to it.
///
/// Fails with the errors of `next` and of the filesystem.
pub fn extract_from(r: *Reader, dir: str) ! io.Error {
    archive.make_root(dir)?
    var stamps: []Stamp = []
    var groups: [str: *Group] = [:]
    for {
        let e = next(r)? ?? break
        place(r, e, dir, mut stamps, groups)?
    }
    for _, g in groups {
        settle(g)?
    }
    var i = stamps.len - 1
    for i >= 0 {
        archive.set_mtime(stamps[i].path, stamps[i].mtime)?
        i -= 1
    }
}

fn group_key(e: Entry) -> str {
    "{e.dev_major}:{e.dev_minor}:{e.ino}"
}

fn group_of(groups: [str: *Group], e: Entry) -> *Group {
    let key = group_key(e)
    let known = groups[key]
    match known {
        some(g) => g
        none => {
            let g = new(Group { seen: 0, placed: "", pending: [], mtime: e.mtime })
            groups[key] = g
            g
        }
    }
}

fn settle(g: *Group) ! io.Error {
    if g.pending.len == 0 {
        return
    }
    var first = g.placed
    if first.len == 0 {
        first = g.pending[0]
        archive.write_file(first, [], 0o644)?
        archive.set_mtime(first, g.mtime)?
        g.placed = first
    }
    for p in g.pending {
        if p != first {
            archive.hardlink(p, first)?
        }
    }
    g.pending = []
}

fn place(r: *Reader, e: Entry, dir: str, mut stamps: []Stamp, groups: [str: *Group]) ! io.Error {
    let target = archive.resolve(dir, e.name)?
    match e.kind {
        File => place_file(r, e, target, groups)?
        Dir => {
            archive.make_dir(target, e.mode)?
            push(mut stamps, Stamp { path: target, mtime: e.mtime })
        }
        Symlink => {
            archive.symlink(target, e.link)?
        }
        _ => {}
    }
}

fn place_file(r: *Reader, e: Entry, target: str, groups: [str: *Group]) ! io.Error {
    if e.nlink < 2 {
        copy_body(r, target, e.mode)?
        archive.set_mtime(target, e.mtime)?
        return
    }
    let g = group_of(groups, e)
    g.seen += 1
    if g.placed.len > 0 {
        archive.hardlink(target, g.placed)?
        return
    }
    if e.size > 0 {
        copy_body(r, target, e.mode)?
        archive.set_mtime(target, e.mtime)?
        g.placed = target
        settle(g)?
        return
    }
    push(mut g.pending, target)
    g.mtime = e.mtime
    if g.seen >= e.nlink {
        settle(g)?
    }
}

fn copy_body(r: *Reader, target: str, mode: i64) ! io.Error {
    using out = archive.create(target, mode)?
    let chunk = io.buffer(65536)
    for {
        let n = read_body(r, chunk)?
        if n == 0 {
            break
        }
        archive.put(out, chunk[..n])?
    }
}

/// Returns an archive of the tree below `dir` in `format`.
///
/// Names are relative to `dir`, which is not an entry itself, and come in sorted depth-first order. Directories, symbolic links, which are not followed, and regular files are archived with the mode, owner and modification time that `lstat` reports. Other objects are skipped. Regular files that share a device and inode are written with `add_links`. The archive is built in memory and ends with the trailer.
///
/// Fails with the error of the filesystem call that failed.
pub fn create(dir: str, format: Format) -> []u8 ! io.Error {
    let w = writer(format)
    var items: []Item = []
    collect(dir, "", mut items)?
    var links: [str: []str] = [:]
    for item in items {
        if item.info.regular {
            let key = "{item.info.device}:{item.info.inode}"
            var names = links[key] ?? []
            push(mut names, item.name)
            links[key] = names
        }
    }
    for item in items {
        add_item(w, item, links)?
    }
    finish(w)?
    output(w)
}

fn collect(root: str, rel: str, mut items: []Item) ! io.Error {
    let here = if rel.len == 0 { root } else { "{root}/{rel}" }
    var names = file.list(here)?
    names |> slices.sort()
    for name in names {
        let child = if rel.len == 0 { name } else { "{rel}/{name}" }
        let full = "{root}/{child}"
        let info = file.lstat(full)?
        push(mut items, Item { name: child, full, info })
        if info.dir {
            collect(root, child, mut items)?
        }
    }
}

fn entry_for(item: Item, kind: Kind) -> Entry {
    Entry {
        name: item.name
        size: item.info.size
        mode: item.info.mode
        uid: item.info.uid
        gid: item.info.gid
        mtime: item.info.modified
        kind
    }
}

fn add_item(w: *Writer, item: Item, links: [str: []str]) ! io.Error {
    let info = item.info
    if info.dir {
        add(w, entry_for(item, Dir), [])?
        return
    }
    if info.link {
        var e = entry_for(item, Symlink)
        e.link = file.readlink(item.full)?
        add(w, e, [])?
        return
    }
    if !info.regular {
        return
    }
    let names = links["{info.device}:{info.inode}"] ?? []
    if names.len > 1 {
        if names[names.len - 1] != item.name {
            return
        }
        let data = file.read_file(item.full)?
        add_links(w, entry_for(item, File), names, data)?
        return
    }
    let data = file.read_file(item.full)?
    add(w, entry_for(item, File), data)?
}
