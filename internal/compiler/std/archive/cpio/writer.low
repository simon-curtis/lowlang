import std/io

pub struct Writer {
    sink: io.Stream?
    data: []u8
    closed: bool
    format: Format
    next_ino: i64
    written: i64
}

pub fn writer(format: Format) -> *Writer {
    new(Writer { sink: none, data: [], closed: false, format, next_ino: 1, written: 0 })
}

pub fn stream_writer(sink: io.Stream, format: Format) -> *Writer {
    new(Writer { sink, data: [], closed: false, format, next_ino: 1, written: 0 })
}

pub fn output(w: *Writer) -> []u8 {
    w.data
}

fn emit(w: *Writer, chunk: []u8) ! io.Error {
    w.written += chunk.len
    match w.sink {
        some(s) => io.write_all(s, chunk)?
        none => io.append(mut w.data, chunk)
    }
}

fn has_nul(s: str) -> bool {
    for i in 0..s.len {
        if s[i] == 0 {
            return true
        }
    }
    false
}

fn validate(w: *Writer, e: Entry) ! io.Error {
    if w.closed || e.name.len == 0 || e.name == trailer() || has_nul(e.name) || has_nul(e.link) {
        fail Invalid
    }
}

fn body_of(e: Entry, data: []u8) -> []u8 {
    match e.kind {
        File => data
        Symlink => bytes(e.link)
        _ => []
    }
}

fn byte_sum(data: []u8) -> i64 {
    var sum = 0
    for b in data {
        sum += i64(b)
    }
    sum & 0xFFFFFFFF
}

fn header_for(w: *Writer, e: Entry, ino: i64, nlink: i64, body: []u8) -> Header {
    Header {
        format: w.format
        ino
        mode: type_bits(e.kind) | e.mode & 0o7777
        uid: e.uid
        gid: e.gid
        nlink
        mtime: e.mtime
        size: body.len
        dev_major: e.dev_major
        dev_minor: e.dev_minor
        rdev_major: e.rdev_major
        rdev_minor: e.rdev_minor
        name_size: 0
        check: if w.format == Crc && e.kind == File { byte_sum(body) } else { 0 }
        length: 0
    }
}

fn allocate(w: *Writer) -> i64 {
    let ino = w.next_ino
    w.next_ino += 1
    ino
}

fn write_entry(w: *Writer, e: Entry, ino: i64, nlink: i64, body: []u8) ! io.Error {
    let h = header_for(w, e, ino, nlink, body)
    let head = put_header(w.format, h, e.name)?
    emit(w, head)?
    if body.len == 0 {
        return
    }
    emit(w, body)?
    let pad = body_padding(h, body.len)
    if pad > 0 {
        emit(w, io.buffer(pad))?
    }
}

pub fn add(w: *Writer, e: Entry, data: []u8) ! io.Error {
    validate(w, e)?
    let ino = if e.ino >= 0 { e.ino } else { allocate(w) }
    write_entry(w, e, ino, e.nlink, body_of(e, data))?
}

fn with_name(e: Entry, name: str) -> Entry {
    Entry {
        name
        size: e.size
        mode: e.mode
        uid: e.uid
        gid: e.gid
        mtime: e.mtime
        kind: e.kind
        link: e.link
        ino: e.ino
        nlink: e.nlink
        dev_major: e.dev_major
        dev_minor: e.dev_minor
        rdev_major: e.rdev_major
        rdev_minor: e.rdev_minor
    }
}

pub fn add_links(w: *Writer, e: Entry, names: []str, data: []u8) ! io.Error {
    if names.len == 0 || e.kind != File {
        fail Invalid
    }
    for name in names {
        validate(w, with_name(e, name))?
    }
    let ino = if e.ino >= 0 { e.ino } else { allocate(w) }
    let last = names.len - 1
    for i, name in names {
        var body: []u8 = []
        if i == last || w.format == Odc {
            body = data
        }
        write_entry(w, with_name(e, name), ino, names.len, body)?
    }
}

pub fn add_file(w: *Writer, name: str, data: []u8, mode: i64) ! io.Error {
    add(w, Entry { name, mode }, data)?
}

pub fn add_dir(w: *Writer, name: str, mode: i64) ! io.Error {
    add(w, Entry { name, mode, kind: Dir }, [])?
}

pub fn add_symlink(w: *Writer, name: str, target: str) ! io.Error {
    add(w, Entry { name, mode: 0o777, kind: Symlink, link: target }, [])?
}

pub fn finish(w: *Writer) ! io.Error {
    if w.closed {
        return
    }
    w.closed = true
    let h = Header {
        format: w.format
        ino: 0
        mode: 0
        uid: 0
        gid: 0
        nlink: 1
        mtime: 0
        size: 0
        dev_major: 0
        dev_minor: 0
        rdev_major: 0
        rdev_minor: 0
        name_size: 0
        check: 0
        length: 0
    }
    let head = put_header(w.format, h, trailer())?
    emit(w, head)?
    let pad = (512 - w.written % 512) % 512
    if pad > 0 {
        emit(w, io.buffer(pad))?
    }
}
