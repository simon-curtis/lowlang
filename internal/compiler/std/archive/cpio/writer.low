import std/io

/// A cpio writer made by `writer` or `stream_writer`.
///
/// Add entries in order and call `finish` to write the trailer.
pub struct Writer {
    sink: io.Stream?
    data: []u8
    closed: bool
    format: Format
    next_ino: i64
    written: i64
}

/// Returns a `Writer` that collects an archive in `format` in memory; `output` returns the bytes.
pub fn writer(format: Format) -> *Writer {
    new(Writer { sink: none, data: [], closed: false, format, next_ino: 1, written: 0 })
}

/// Returns a `Writer` that writes an archive in `format` to `sink`.
///
/// The writer does not close `sink`, and `output` stays empty.
pub fn stream_writer(sink: io.Stream, format: Format) -> *Writer {
    new(Writer { sink, data: [], closed: false, format, next_ino: 1, written: 0 })
}

/// Returns the bytes collected by a `Writer` made with `writer`.
///
/// Call it after `finish` for a complete archive. It is empty for a stream writer.
pub fn output(w: *Writer) -> []u8 {
    w.data
}

fn emit(w: *Writer, chunk: []u8) ! io.Error {
    w.written += chunk.len
    match w.sink {
        some(s) => io.write_all(s, chunk)?
        none => io.append(mut w.data, chunk)
    }
}

fn has_nul(s: str) -> bool {
    for i in 0..s.len {
        if s[i] == 0 {
            return true
        }
    }
    false
}

fn validate(w: *Writer, e: Entry) ! io.Error {
    if w.closed || e.name.len == 0 || e.name == trailer() || has_nul(e.name) || has_nul(e.link) {
        fail Invalid
    }
}

fn body_of(e: Entry, data: []u8) -> []u8 {
    match e.kind {
        File => data
        Symlink => bytes(e.link)
        _ => []
    }
}

fn byte_sum(data: []u8) -> i64 {
    var sum = 0
    for b in data {
        sum += i64(b)
    }
    sum & 0xFFFFFFFF
}

fn header_for(w: *Writer, e: Entry, ino: i64, nlink: i64, body: []u8) -> Header {
    Header {
        format: w.format
        ino
        mode: type_bits(e.kind) | e.mode & 0o7777
        uid: e.uid
        gid: e.gid
        nlink
        mtime: e.mtime
        size: body.len
        dev_major: e.dev_major
        dev_minor: e.dev_minor
        rdev_major: e.rdev_major
        rdev_minor: e.rdev_minor
        name_size: 0
        check: if w.format == Crc && e.kind == File { byte_sum(body) } else { 0 }
        length: 0
    }
}

fn allocate(w: *Writer) -> i64 {
    let ino = w.next_ino
    w.next_ino += 1
    ino
}

fn write_entry(w: *Writer, e: Entry, ino: i64, nlink: i64, body: []u8) ! io.Error {
    let h = header_for(w, e, ino, nlink, body)
    let head = put_header(w.format, h, e.name)?
    emit(w, head)?
    if body.len == 0 {
        return
    }
    emit(w, body)?
    let pad = body_padding(h, body.len)
    if pad > 0 {
        emit(w, io.buffer(pad))?
    }
}

/// Writes the entry `e` with `data` as its contents.
///
/// `data` is used for a `File` only; a `Symlink` stores `e.link` and every other kind stores nothing. `e.size` is ignored. A negative `e.ino` is replaced by the next unused inode number. A `Crc` entry carries the byte sum of its data.
///
/// Fails with `Invalid` after `finish`, for an empty name, for `TRAILER!!!` and for a name or link with a NUL byte, with `TooLarge` when a value does not fit its header field, and with the error of the sink.
pub fn add(w: *Writer, e: Entry, data: []u8) ! io.Error {
    validate(w, e)?
    let ino = if e.ino >= 0 { e.ino } else { allocate(w) }
    write_entry(w, e, ino, e.nlink, body_of(e, data))?
}

fn with_name(e: Entry, name: str) -> Entry {
    Entry {
        name
        size: e.size
        mode: e.mode
        uid: e.uid
        gid: e.gid
        mtime: e.mtime
        kind: e.kind
        link: e.link
        ino: e.ino
        nlink: e.nlink
        dev_major: e.dev_major
        dev_minor: e.dev_minor
        rdev_major: e.rdev_major
        rdev_minor: e.rdev_minor
    }
}

/// Writes `names` as hard links to one file whose metadata is `e`.
///
/// Every name gets `e` with `name` replaced and an `nlink` of `names.len`, and all share one inode number. In `Newc` and `Crc` only the last name carries `data`; in `Odc` every name does. `e.name` and `e.nlink` are ignored.
///
/// Fails with `Invalid` when `names` is empty or `e.kind` is not `File`, and otherwise as `add`.
pub fn add_links(w: *Writer, e: Entry, names: []str, data: []u8) ! io.Error {
    if names.len == 0 || e.kind != File {
        fail Invalid
    }
    for name in names {
        validate(w, with_name(e, name))?
    }
    let ino = if e.ino >= 0 { e.ino } else { allocate(w) }
    let last = names.len - 1
    for i, name in names {
        var body: []u8 = []
        if i == last || w.format == Odc {
            body = data
        }
        write_entry(w, with_name(e, name), ino, names.len, body)?
    }
}

/// Writes a regular file `name` with `data` and the permission bits `mode`, owned by id `0` with a modification time of `0`.
pub fn add_file(w: *Writer, name: str, data: []u8, mode: i64) ! io.Error {
    add(w, Entry { name, mode }, data)?
}

/// Writes a directory `name` with the permission bits `mode`, owned by id `0` with a modification time of `0`.
pub fn add_dir(w: *Writer, name: str, mode: i64) ! io.Error {
    add(w, Entry { name, mode, kind: Dir }, [])?
}

/// Writes a symbolic link `name` that points to `target`, with mode `0o777`, owned by id `0` with a modification time of `0`.
pub fn add_symlink(w: *Writer, name: str, target: str) ! io.Error {
    add(w, Entry { name, mode: 0o777, kind: Symlink, link: target }, [])?
}

/// Writes the `TRAILER!!!` entry and pads the output with zero bytes to a multiple of 512.
///
/// A second call does nothing. After `finish`, `add` fails with `Invalid`.
pub fn finish(w: *Writer) ! io.Error {
    if w.closed {
        return
    }
    w.closed = true
    let h = Header {
        format: w.format
        ino: 0
        mode: 0
        uid: 0
        gid: 0
        nlink: 1
        mtime: 0
        size: 0
        dev_major: 0
        dev_minor: 0
        rdev_major: 0
        rdev_minor: 0
        name_size: 0
        check: 0
        length: 0
    }
    let head = put_header(w.format, h, trailer())?
    emit(w, head)?
    let pad = (512 - w.written % 512) % 512
    if pad > 0 {
        emit(w, io.buffer(pad))?
    }
}
