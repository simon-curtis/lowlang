import std/io
import std/path
import std/text

pub enum Kind {
    Missing
    File
    Dir
    Symlink
    Other
}

pub struct Stat {
    pub kind: Kind
    pub size: i64
    pub mode: i64
    pub uid: i64
    pub gid: i64
    pub mtime: i64
}

pub struct Output {
    fd: i64
    drop close_fd(fd)
}

fn close_fd(fd: i64) {
    __syscall(3, fd)
}

fn at_cwd() -> i64 {
    -100
}

fn retry(r: i64) -> bool {
    r == -4
}

fn kind_of(mode: i64) -> Kind {
    let format = mode & 0xF000
    if format == 0x8000 {
        return File
    }
    if format == 0x4000 {
        return Dir
    }
    if format == 0xA000 {
        return Symlink
    }
    Other
}

fn lstat_raw(path: str, buf: []u8) -> i64 {
    __syscall(262, at_cwd(), cstr(path), __slice_ptr(buf), 0x100)
}

fn probe(path: str) -> Kind {
    let buf = io.buffer(144)
    let r = lstat_raw(path, buf)
    if r < 0 {
        return Missing
    }
    kind_of(io.le32(buf, 24))
}

pub fn lstat(path: str) -> Stat ! io.Error {
    let buf = io.buffer(144)
    io.syscall_result(lstat_raw(path, buf))?
    let mode = io.le32(buf, 24)
    Stat {
        kind: kind_of(mode)
        size: io.le64(buf, 48)
        mode: mode & 0xFFF
        uid: io.le32(buf, 28)
        gid: io.le32(buf, 32)
        mtime: io.le64(buf, 88)
    }
}

pub fn read_link(path: str) -> str ! io.Error {
    let buf = io.buffer(4096)
    let n = io.syscall_result(__syscall(89, cstr(path), __slice_ptr(buf), buf.len))?
    str(buf[..n])
}

pub fn clean_name(name: str) -> str ! io.Error {
    if name.len == 0 {
        fail Malformed
    }
    if path.is_absolute(name) {
        fail Denied
    }
    for i in 0..name.len {
        if name[i] == 0 {
            fail Denied
        }
    }
    for part in text.split(name, '/') {
        if part == ".." {
            fail Denied
        }
    }
    path.clean(name)
}

fn confine(dir: str) ! io.Error {
    match probe(dir) {
        Missing => {
            io.syscall_result(__syscall(258, at_cwd(), cstr(dir), 0o755))?
        }
        Dir => {}
        Symlink => fail Denied
        _ => fail NotDir
    }
}

pub fn resolve(root: str, name: str) -> str ! io.Error {
    let rel = clean_name(name)?
    if rel == "." {
        return root
    }
    let parts = text.split(rel, '/')
    var at = root
    for i in 0..parts.len - 1 {
        at = "{at}/{parts[i]}"
        confine(at)?
    }
    "{at}/{parts[parts.len - 1]}"
}

fn clear(target: str) ! io.Error {
    match probe(target) {
        Missing => {}
        Dir => fail IsDir
        _ => {
            io.syscall_result(__syscall(263, at_cwd(), cstr(target), 0))?
        }
    }
}

pub fn make_dir(target: str, mode: i64) ! io.Error {
    match probe(target) {
        Dir => return
        Missing => {}
        _ => clear(target)?
    }
    io.syscall_result(__syscall(258, at_cwd(), cstr(target), mode & 0o777 | 0o700))?
}

pub fn create(target: str, mode: i64) -> Output ! io.Error {
    clear(target)?
    for {
        let r = __syscall(257, at_cwd(), cstr(target), 0xA00C1, mode & 0o777)
        if !retry(r) {
            return Output { fd: io.syscall_result(r)? }
        }
    }
}

pub fn put(o: Output, data: []u8) ! io.Error {
    var rest = data
    for rest.len > 0 {
        let r = __syscall(1, o.fd, __slice_ptr(rest), rest.len)
        if retry(r) {
            continue
        }
        let n = io.syscall_result(r)?
        rest = rest[n..]
    }
}

pub fn write_file(target: str, data: []u8, mode: i64) ! io.Error {
    using out = create(target, mode)?
    put(out, data)?
}

pub fn symlink(target: str, to: str) ! io.Error {
    clear(target)?
    io.syscall_result(__syscall(88, cstr(to), cstr(target)))?
}

pub fn hardlink(target: str, source: str) ! io.Error {
    clear(target)?
    io.syscall_result(__syscall(86, cstr(source), cstr(target)))?
}

pub fn set_mtime(target: str, seconds: i64) ! io.Error {
    let times = io.buffer(32)
    io.set_le64(times, 8, 0x3FFFFFFE)
    io.set_le64(times, 16, seconds)
    io.syscall_result(__syscall(280, at_cwd(), cstr(target), __slice_ptr(times), 0x100))?
}

pub fn make_root(root: str) ! io.Error {
    match probe(root) {
        Missing => {
            for i in 1..root.len {
                if root[i] == '/' {
                    make_dir(root[..i], 0o755)?
                }
            }
            make_dir(root, 0o755)?
        }
        Dir => {}
        Symlink => {}
        _ => fail NotDir
    }
}
