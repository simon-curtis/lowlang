import std/text

fn table() -> [][]str {
    [
        ["html", "text/html; charset=utf-8"], ["htm", "text/html; charset=utf-8"],
        ["css", "text/css; charset=utf-8"], ["js", "text/javascript; charset=utf-8"],
        ["mjs", "text/javascript; charset=utf-8"], ["json", "application/json"],
        ["txt", "text/plain; charset=utf-8"], ["csv", "text/csv; charset=utf-8"],
        ["xml", "application/xml"], ["svg", "image/svg+xml"], ["wasm", "application/wasm"],
        ["png", "image/png"], ["jpg", "image/jpeg"], ["jpeg", "image/jpeg"],
        ["gif", "image/gif"], ["webp", "image/webp"], ["avif", "image/avif"],
        ["ico", "image/vnd.microsoft.icon"], ["bmp", "image/bmp"],
        ["woff", "font/woff"], ["woff2", "font/woff2"], ["ttf", "font/ttf"], ["otf", "font/otf"],
        ["pdf", "application/pdf"], ["zip", "application/zip"], ["gz", "application/gzip"],
        ["zst", "application/zstd"], ["tar", "application/x-tar"],
        ["mp3", "audio/mpeg"], ["flac", "audio/flac"], ["ogg", "audio/ogg"], ["opus", "audio/opus"],
        ["wav", "audio/wav"], ["m4a", "audio/mp4"], ["aac", "audio/aac"],
        ["mp4", "video/mp4"], ["m4v", "video/mp4"], ["webm", "video/webm"], ["mkv", "video/x-matroska"],
        ["mov", "video/quicktime"], ["ts", "video/mp2t"], ["m3u8", "application/vnd.apple.mpegurl"],
        ["srt", "application/x-subrip"], ["vtt", "text/vtt; charset=utf-8"],
    ]
}

/// Returns the content type for a file extension, or `none` when it is not known.
///
/// The extension may start with a dot and is matched without regard to case. Text types carry `charset=utf-8`.
pub fn by_extension(ext: str) -> str? {
    let key = text.lower(text.trim_prefix(ext, "."))
    for row in table() {
        if row[0] == key {
            return row[1]
        }
    }
    none
}

/// Returns the file extension, without a dot, for a content type, or `none` when it is not known.
///
/// Parameters such as `charset` are ignored and the type is matched without regard to case. When several extensions share a type, such as `jpg` and `jpeg`, the first is returned.
pub fn extension(content_type: str) -> str? {
    let bare = text.lower(text.trim(text.split(content_type, ';')[0]))
    for row in table() {
        if text.split(row[1], ';')[0] == bare {
            return row[0]
        }
    }
    none
}

fn has(data: []u8, at: i64, magic: []u8) -> bool {
    if data.len < at + magic.len {
        return false
    }
    for i in 0..magic.len {
        if data[at + i] != magic[i] {
            return false
        }
    }
    true
}

/// Returns the content type that the leading bytes of `data` suggest.
///
/// Images, audio, video, archives, PDF and WebAssembly are recognised by their signatures. After leading whitespace, `<!doctype html` and `<html` give `text/html; charset=utf-8`, `<?xml` gives `application/xml`, and a first byte of `{` or `[` gives `application/json` without checking that the rest is valid. Anything else is `text/plain; charset=utf-8` unless it contains control bytes, which give `application/octet-stream`. Empty data is plain text.
pub fn sniff(data: []u8) -> str {
    if has(data, 0, [0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a]) {
        return "image/png"
    }
    if has(data, 0, [0xff, 0xd8, 0xff]) {
        return "image/jpeg"
    }
    if has(data, 0, [0x47, 0x49, 0x46, 0x38, 0x37, 0x61]) || has(data, 0, [0x47, 0x49, 0x46, 0x38, 0x39, 0x61]) {
        return "image/gif"
    }
    if has(data, 0, [0x52, 0x49, 0x46, 0x46]) && has(data, 8, [0x57, 0x45, 0x42, 0x50]) {
        return "image/webp"
    }
    if has(data, 0, [0x52, 0x49, 0x46, 0x46]) && has(data, 8, [0x57, 0x41, 0x56, 0x45]) {
        return "audio/wav"
    }
    if has(data, 0, [0x25, 0x50, 0x44, 0x46, 0x2d]) {
        return "application/pdf"
    }
    if has(data, 0, [0x50, 0x4b, 0x03, 0x04]) {
        return "application/zip"
    }
    if has(data, 0, [0x1f, 0x8b]) {
        return "application/gzip"
    }
    if has(data, 0, [0x28, 0xb5, 0x2f, 0xfd]) {
        return "application/zstd"
    }
    if has(data, 0, [0x66, 0x4c, 0x61, 0x43]) {
        return "audio/flac"
    }
    if has(data, 0, [0x4f, 0x67, 0x67, 0x53]) {
        return "audio/ogg"
    }
    if has(data, 0, [0x49, 0x44, 0x33]) || (data.len > 1 && data[0] == 0xff && data[1] & 0xe0 == 0xe0) {
        return "audio/mpeg"
    }
    if has(data, 4, [0x66, 0x74, 0x79, 0x70]) {
        return "video/mp4"
    }
    if has(data, 0, [0x1a, 0x45, 0xdf, 0xa3]) {
        return "video/webm"
    }
    if has(data, 0, [0x00, 0x61, 0x73, 0x6d]) {
        return "application/wasm"
    }
    var start = 0
    for start < data.len && text.space(data[start]) {
        start += 1
    }
    let head = text.lower(str(data[start..if data.len - start > 16 { start + 16 } else { data.len }]))
    if text.starts_with(head, "<!doctype html") || text.starts_with(head, "<html") {
        return "text/html; charset=utf-8"
    }
    if text.starts_with(head, "<?xml") {
        return "application/xml"
    }
    if start < data.len && (data[start] == '{' || data[start] == '[') {
        return "application/json"
    }
    for b in data {
        if b < 0x09 || (b > 0x0d && b < 0x20 && b != 0x1b) {
            return "application/octet-stream"
        }
    }
    "text/plain; charset=utf-8"
}
