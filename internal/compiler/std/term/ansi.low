import std/text

/// A terminal colour for `fg` and `bg`.
pub enum Colour {
    /// Standard black.
    Black
    /// Standard red.
    Red
    /// Standard green.
    Green
    /// Standard yellow.
    Yellow
    /// Standard blue.
    Blue
    /// Standard magenta.
    Magenta
    /// Standard cyan.
    Cyan
    /// Standard white.
    White
    /// Bright black, usually shown as grey.
    BrightBlack
    /// Bright red.
    BrightRed
    /// Bright green.
    BrightGreen
    /// Bright yellow.
    BrightYellow
    /// Bright blue.
    BrightBlue
    /// Bright magenta.
    BrightMagenta
    /// Bright cyan.
    BrightCyan
    /// Bright white.
    BrightWhite
    /// An entry `n` of the 256-colour palette.
    Indexed(n: u8)
    /// A 24-bit colour with the given red, green and blue levels.
    Rgb(r: u8, g: u8, b: u8)
}

fn esc() -> str {
    text.from_char(27)
}

fn sequence(body: str) -> str {
    "{esc()}[{body}"
}

fn wrap(on: str, inner: str, off: str) -> str {
    "{sequence(on)}{inner}{sequence(off)}"
}

fn basic_index(c: Colour) -> i64 {
    match c {
        Black => 0
        Red => 1
        Green => 2
        Yellow => 3
        Blue => 4
        Magenta => 5
        Cyan => 6
        White => 7
        BrightBlack => 8
        BrightRed => 9
        BrightGreen => 10
        BrightYellow => 11
        BrightBlue => 12
        BrightMagenta => 13
        BrightCyan => 14
        BrightWhite => 15
        Indexed(_) => -1
        Rgb(_, _, _) => -1
    }
}

fn colour_code(c: Colour, base: i64) -> str {
    match c {
        Indexed(n) => "{base + 8};5;{n}m"
        Rgb(r, g, b) => "{base + 8};2;{r};{g};{b}m"
        _ => {
            let i = basic_index(c)
            let offset = if i < 8 { i } else { i + 52 }
            "{base + offset}m"
        }
    }
}

/// Returns the escape sequence that turns off every text attribute and colour.
pub fn reset() -> str {
    sequence("0m")
}

/// Returns `s` wrapped in the escape sequences that turn bold on and off.
pub fn bold(s: str) -> str {
    wrap("1m", s, "22m")
}

/// Returns `s` wrapped in the escape sequences that turn dim on and off.
pub fn dim(s: str) -> str {
    wrap("2m", s, "22m")
}

/// Returns `s` wrapped in the escape sequences that turn underline on and off.
pub fn underline(s: str) -> str {
    wrap("4m", s, "24m")
}

/// Returns `s` wrapped in the escape sequences that set the foreground colour to `c` and then back to the default.
pub fn fg(c: Colour, s: str) -> str {
    wrap(colour_code(c, 30), s, "39m")
}

/// Returns `s` wrapped in the escape sequences that set the background colour to `c` and then back to the default.
pub fn bg(c: Colour, s: str) -> str {
    wrap(colour_code(c, 40), s, "49m")
}

fn movement(n: i64, direction: str) -> str {
    if n < 1 { "" } else { sequence("{n}{direction}") }
}

/// Returns the escape sequence that moves the cursor up `n` rows, or an empty string if `n` is less than 1.
pub fn cursor_up(n: i64) -> str {
    movement(n, "A")
}

/// Returns the escape sequence that moves the cursor down `n` rows, or an empty string if `n` is less than 1.
pub fn cursor_down(n: i64) -> str {
    movement(n, "B")
}

/// Returns the escape sequence that moves the cursor right `n` columns, or an empty string if `n` is less than 1.
pub fn cursor_forward(n: i64) -> str {
    movement(n, "C")
}

/// Returns the escape sequence that moves the cursor left `n` columns, or an empty string if `n` is less than 1.
pub fn cursor_back(n: i64) -> str {
    movement(n, "D")
}

/// Returns the escape sequence that moves the cursor to the 1-based `column` on the current row.
pub fn cursor_column(column: i64) -> str {
    sequence("{column}G")
}

/// Returns the escape sequence that moves the cursor to the 1-based `row` and `column`.
pub fn cursor_to(row: i64, column: i64) -> str {
    sequence("{row};{column}H")
}

/// Returns the escape sequence that moves the cursor to the top left corner.
pub fn cursor_home() -> str {
    sequence("H")
}

/// Returns the escape sequence that saves the cursor position.
pub fn save_cursor() -> str {
    sequence("s")
}

/// Returns the escape sequence that moves the cursor to the position saved by `save_cursor`.
pub fn restore_cursor() -> str {
    sequence("u")
}

/// Returns the escape sequence that hides the cursor.
pub fn hide_cursor() -> str {
    sequence("?25l")
}

/// Returns the escape sequence that shows the cursor.
pub fn show_cursor() -> str {
    sequence("?25h")
}

/// Returns the escape sequence that erases the whole current line without moving the cursor.
pub fn clear_line() -> str {
    sequence("2K")
}

/// Returns the escape sequence that erases from the cursor to the end of the line.
pub fn clear_to_end_of_line() -> str {
    sequence("K")
}

/// Returns the escape sequences that erase the whole screen and move the cursor to the top left corner.
pub fn clear_screen() -> str {
    "{sequence("2J")}{cursor_home()}"
}

/// Returns the escape sequence that switches to the alternate screen buffer.
pub fn enter_alternate_screen() -> str {
    sequence("?1049h")
}

/// Returns the escape sequence that switches back to the main screen buffer.
pub fn leave_alternate_screen() -> str {
    sequence("?1049l")
}

fn skip_csi(s: str, from: i64) -> i64 {
    var i = from
    for i < s.len {
        let c = s[i]
        i += 1
        if c >= 64 && c <= 126 {
            break
        }
    }
    i
}

fn skip_string(s: str, from: i64) -> i64 {
    var i = from
    for i < s.len {
        if s[i] == 7 {
            return i + 1
        }
        if s[i] == 27 && i + 1 < s.len && s[i + 1] == '\\' {
            return i + 2
        }
        i += 1
    }
    i
}

fn skip_other(s: str, from: i64) -> i64 {
    var i = from
    for i < s.len && s[i] >= 32 && s[i] <= 47 {
        i += 1
    }
    if i < s.len { i + 1 } else { i }
}

fn skip_escape(s: str, from: i64) -> i64 {
    if from >= s.len {
        return from
    }
    match s[from] {
        == '[' => skip_csi(s, from + 1)
        == ']' => skip_string(s, from + 1)
        == 'P' => skip_string(s, from + 1)
        == '_' => skip_string(s, from + 1)
        == '^' => skip_string(s, from + 1)
        _ => skip_other(s, from)
    }
}

/// Returns `s` without its escape sequences.
///
/// Removes CSI sequences such as colours and cursor movement, string sequences ended by BEL or `ESC \`, and other short escapes. Text outside escapes is kept.
pub fn strip(s: str) -> str {
    var out: []u8 = []
    var i = 0
    for i < s.len {
        if s[i] == 27 {
            i = skip_escape(s, i + 1)
        } else {
            push(mut out, s[i])
            i += 1
        }
    }
    __str_view(out)
}

/// Returns the number of Unicode code points in `s` once its escape sequences are removed.
///
/// Wide and combining characters are counted as one each.
pub fn visible_width(s: str) -> i64 {
    text.char_count(strip(s))
}
