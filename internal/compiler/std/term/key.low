import std/io
import std/sys

/// A key press decoded from terminal input.
pub enum Key {
    /// A printable character, given as its code point.
    Char(c: u32)
    /// A control combination. `c` is the lowercase letter, so Ctrl+A is `Ctrl('a')`; Ctrl+Space is `Ctrl(' ')`, and the codes 28 to 31 give `\`, `]`, `^` and `_`.
    Ctrl(c: u32)
    /// Alt with a key, reported as an escape followed by one byte `c`.
    Alt(c: u32)
    /// A function key, `n` from 1 to 12.
    Function(n: i64)
    /// The Enter key, sent as carriage return or line feed.
    Enter
    /// The Tab key.
    Tab
    /// Shift+Tab.
    BackTab
    /// The Backspace key, sent as byte 8 or 127.
    Backspace
    /// The Escape key, a lone escape byte with nothing following within the timeout.
    Escape
    /// The up arrow.
    Up
    /// The down arrow.
    Down
    /// The left arrow.
    Left
    /// The right arrow.
    Right
    /// The Home key.
    Home
    /// The End key.
    End
    /// The Page Up key.
    PageUp
    /// The Page Down key.
    PageDown
    /// The Insert key.
    Insert
    /// The Delete key.
    Delete
    /// An escape sequence that is not recognised or was cut short.
    Unknown
}

fn escape_timeout() -> i64 {
    50
}

fn read_input(fd: i64) -> i64 ! io.Error {
    let b = io.buffer(1)
    let n = sys.read(fd, b)?
    if n == 0 {
        fail Eof
    }
    i64(b[0])
}

fn next_byte(fd: i64, wait_ms: i64) -> i64 ! io.Error {
    var waited = 0
    for !sys.readable_now(fd) {
        if wait_ms < 0 {
            wait_readable(fd)
            continue
        }
        if waited >= wait_ms {
            return -1
        }
        sleep(2)
        waited += 2
    }
    read_input(fd)?
}

fn plain_key(b: i64) -> Key {
    match b {
        == 10 => Enter
        == 13 => Enter
        == 9 => Tab
        == 8 => Backspace
        == 127 => Backspace
        == 0 => Ctrl(' ')
        < 27 => Ctrl(u32(b + 96))
        < 32 => Ctrl(u32(b + 64))
        _ => Char(u32(b))
    }
}

fn utf8_length(lead: i64) -> i64 {
    match lead {
        >= 0xF8 => 0
        >= 0xF0 => 3
        >= 0xE0 => 2
        >= 0xC0 => 1
        _ => 0
    }
}

fn utf8_char(src: fn(i64) -> i64 ! io.Error, wait_ms: i64, lead: i64) -> u32 ! io.Error {
    let follow = utf8_length(lead)
    if follow == 0 {
        return 0xFFFD
    }
    var cp = lead & (0x3F >> follow)
    for _ in 0..follow {
        let b = src(wait_ms)?
        if b < 0 || b & 0xC0 != 0x80 {
            return 0xFFFD
        }
        cp = cp << 6 | b & 0x3F
    }
    u32(cp)
}

fn letter_key(b: i64) -> Key {
    match b {
        == 65 => Up
        == 66 => Down
        == 67 => Right
        == 68 => Left
        == 72 => Home
        == 70 => End
        == 90 => BackTab
        == 80 => Function(1)
        == 81 => Function(2)
        == 82 => Function(3)
        == 83 => Function(4)
        _ => Unknown
    }
}

fn function_key(n: i64) -> Key {
    if n >= 11 && n <= 15 {
        return Function(n - 10)
    }
    if n >= 17 && n <= 21 {
        return Function(n - 11)
    }
    if n == 23 || n == 24 {
        return Function(n - 12)
    }
    Unknown
}

fn tilde_key(n: i64) -> Key {
    match n {
        == 1 => Home
        == 2 => Insert
        == 3 => Delete
        == 4 => End
        == 5 => PageUp
        == 6 => PageDown
        == 7 => Home
        == 8 => End
        _ => function_key(n)
    }
}

fn csi_key(first: i64, last: i64) -> Key {
    if last == 126 {
        return tilde_key(first)
    }
    letter_key(last)
}

fn csi(src: fn(i64) -> i64 ! io.Error, wait_ms: i64) -> Key ! io.Error {
    var first = -1
    var index = 0
    var current = -1
    for {
        let b = src(wait_ms)?
        if b < 0 {
            return Unknown
        }
        if b >= 48 && b <= 57 {
            current = (if current < 0 { 0 } else { current }) * 10 + b - 48
        } else if b == 59 {
            if index == 0 {
                first = current
            }
            index += 1
            current = -1
        } else if b >= 64 && b <= 126 {
            if index == 0 {
                first = current
            }
            return csi_key(first, b)
        }
    }
}

fn ss3(src: fn(i64) -> i64 ! io.Error, wait_ms: i64) -> Key ! io.Error {
    let b = src(wait_ms)?
    if b < 0 {
        return Unknown
    }
    letter_key(b)
}

fn escape(src: fn(i64) -> i64 ! io.Error, wait_ms: i64) -> Key ! io.Error {
    let b = src(wait_ms)?
    match b {
        < 0 => Escape
        == 27 => Escape
        == 91 => csi(src, wait_ms)?
        == 79 => ss3(src, wait_ms)?
        _ => Alt(u32(b))
    }
}

fn decode(src: fn(i64) -> i64 ! io.Error, wait_ms: i64) -> Key ! io.Error {
    let b = src(-1)?
    if b < 0 {
        fail Eof
    }
    if b == 27 {
        return escape(src, wait_ms)?
    }
    if b >= 0x80 {
        return Char(utf8_char(src, wait_ms, b)?)
    }
    plain_key(b)
}

/// Reads one key press from the descriptor `fd`, waiting 50 milliseconds after an escape byte to tell an `Escape` key from a longer sequence.
///
/// Does the same as `read_key_with` with that timeout.
pub fn read_key(fd: i64) -> Key ! io.Error {
    read_key_with(fd, escape_timeout())?
}

/// Reads one key press from the descriptor `fd`.
///
/// Parks the green thread until the first byte arrives. After an escape byte, and while it reads the rest of a sequence, it waits at most `escape_ms` milliseconds for each following byte and reports `Escape` when none comes. A multi-byte UTF-8 character is decoded to `Char`, and a malformed one gives `Char(0xFFFD)`. The terminal should be in raw mode, or input arrives only after Enter. Fails with `Eof` at end of input and with the system error otherwise.
pub fn read_key_with(fd: i64, escape_ms: i64) -> Key ! io.Error {
    let src = fn(wait: i64) -> i64 ! io.Error { next_byte(fd, wait) }
    decode(src, escape_ms)?
}

/// Decodes the key presses in `data`, which holds bytes already read from a terminal.
///
/// Does not wait: a sequence cut short by the end of `data` gives `Unknown`, and a lone escape byte at the end gives `Escape`. Never fails.
pub fn parse_keys(data: []u8) -> []Key {
    var at = 0
    let src = fn(wait: i64) -> i64 ! io.Error {
        if at >= data.len {
            return -1
        }
        let b = data[at]
        at += 1
        i64(b)
    }
    var out: []Key = []
    for at < data.len {
        let k = decode(src, 0) catch {
            _ => break
        }
        push(mut out, k)
    }
    out
}
