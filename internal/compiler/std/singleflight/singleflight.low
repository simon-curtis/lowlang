import std/sync

pub enum Result[V, E] {
    Ok(V)
    Err(E)
}

pub struct Shared[V] {
    pub value: V
    pub shared: bool
}

struct Call[V] {
    id: i64
    done: chan[bool]
    value: V?
    followers: i64
}

struct GroupState[K: Hash, V] {
    guard: sync.Mutex
    calls: [K: *Call[V]]
    serial: i64
}

pub struct Group[K: Hash, V] {
    state: *GroupState[K, V]
}

pub fn group[K: Hash, V]() -> Group[K, V] {
    Group[K, V] { state: new(GroupState[K, V] { guard: sync.mutex(), calls: [:], serial: 0 }) }
}

fn settled[V](c: *Call[V]) -> V {
    c.value ?? __panic("singleflight: call finished without a value")
}

fn follow[V](c: *Call[V]) -> Shared[V] {
    let released = <-c.done
    Shared[V] { value: settled(c), shared: true }
}

fn open_call[K: Hash, V](st: *GroupState[K, V], key: K) -> *Call[V] {
    st.serial += 1
    let c = new(Call[V] { id: st.serial, done: chan[bool](), value: none, followers: 0 })
    st.calls[key] = c
    c
}

fn is_current[K: Hash, V](st: *GroupState[K, V], key: K, c: *Call[V]) -> bool {
    match st.calls[key] {
        some(open) => open.id == c.id
        none => false
    }
}

fn finish[K: Hash, V](st: *GroupState[K, V], key: K, c: *Call[V], v: V) -> bool {
    sync.lock(st.guard)
    if is_current(st, key, c) {
        delete(mut st.calls, key)
    }
    c.value = some(v)
    let shared = c.followers > 0
    sync.unlock(st.guard)
    close(c.done)
    shared
}

pub fn do_shared[K: Hash, V](g: Group[K, V], key: K, f: fn() -> V) -> Shared[V] {
    let st = g.state
    sync.lock(st.guard)
    match st.calls[key] {
        some(open) => {
            open.followers += 1
            sync.unlock(st.guard)
            return follow(open)
        }
        none => {}
    }
    let c = open_call(st, key)
    sync.unlock(st.guard)
    let v = f()
    let shared = finish(st, key, c, v)
    Shared[V] { value: v, shared }
}

pub fn do[K: Hash, V](g: Group[K, V], key: K, f: fn() -> V) -> V {
    do_shared(g, key, f).value
}

pub fn forget[K: Hash, V](g: Group[K, V], key: K) {
    let st = g.state
    sync.lock(st.guard)
    delete(mut st.calls, key)
    sync.unlock(st.guard)
}

pub fn in_flight[K: Hash, V](g: Group[K, V], key: K) -> bool {
    let st = g.state
    sync.lock(st.guard)
    let open = st.calls[key] != none
    sync.unlock(st.guard)
    open
}

pub fn followers[K: Hash, V](g: Group[K, V], key: K) -> i64 {
    let st = g.state
    sync.lock(st.guard)
    var n = 0
    match st.calls[key] {
        some(open) => { n = open.followers }
        none => {}
    }
    sync.unlock(st.guard)
    n
}

pub fn pending[K: Hash, V](g: Group[K, V]) -> i64 {
    let st = g.state
    sync.lock(st.guard)
    let n = st.calls.len
    sync.unlock(st.guard)
    n
}
