import std/sync
import std/time/clock
import std/time/duration

struct Flight[V] {
    done: chan[bool]
    value: V?
}

struct ExpiringState[V] {
    guard: sync.Mutex
    clock: clock.Clock
    ttl: i64
    refresh: fn() -> V
    value: V?
    stamp: i64
    epoch: i64
    refreshes: i64
    flight: *Flight[V]?
}

pub struct Expiring[V] {
    state: *ExpiringState[V]
}

fn max_i64() -> i64 {
    9223372036854775807
}

fn nanos_of(d: duration.Duration) -> i64 {
    duration.as_nanos(d) ?? if duration.is_negative(d) { 0 } else { max_i64() }
}

pub fn expiring[V](ttl: duration.Duration, c: clock.Clock, refresh: fn() -> V) -> Expiring[V] {
    let s = ExpiringState[V] {
        guard: sync.mutex(),
        clock: c,
        ttl: nanos_of(ttl),
        refresh,
        value: none,
        stamp: 0,
        epoch: 0,
        refreshes: 0,
        flight: none
    }
    Expiring[V] { state: new(s) }
}

fn now_of[V](s: *ExpiringState[V]) -> i64 {
    nanos_of(s.clock.monotonic())
}

fn fresh[V](s: *ExpiringState[V], now: i64) -> bool {
    now - s.stamp < s.ttl
}

fn lead[V](s: *ExpiringState[V], now: i64) -> V {
    let f = new(Flight[V] { done: chan[bool](), value: none })
    s.flight = some(f)
    let epoch = s.epoch
    sync.unlock(s.guard)
    let produce = s.refresh
    let v = produce()
    sync.lock(s.guard)
    s.refreshes += 1
    if s.epoch == epoch {
        s.value = some(v)
        s.stamp = now
    }
    s.flight = none
    f.value = some(v)
    sync.unlock(s.guard)
    close(f.done)
    v
}

fn await[V](f: *Flight[V]) -> V {
    let released = <-f.done
    f.value ?? __panic("singleflight: refresh finished without a value")
}

pub fn fetch[V](e: Expiring[V]) -> V {
    let s = e.state
    sync.lock(s.guard)
    let now = now_of(s)
    match s.value {
        some(v) => {
            if fresh(s, now) {
                sync.unlock(s.guard)
                return v
            }
        }
        none => {}
    }
    match s.flight {
        some(f) => {
            sync.unlock(s.guard)
            return await(f)
        }
        none => {}
    }
    lead(s, now)
}

pub fn cached[V](e: Expiring[V]) -> V? {
    let s = e.state
    sync.lock(s.guard)
    let now = now_of(s)
    var held: V? = none
    if fresh(s, now) {
        held = s.value
    }
    sync.unlock(s.guard)
    held
}

pub fn invalidate[V](e: Expiring[V]) {
    let s = e.state
    sync.lock(s.guard)
    s.value = none
    s.epoch += 1
    sync.unlock(s.guard)
}

pub fn refresh_count[V](e: Expiring[V]) -> i64 {
    let s = e.state
    sync.lock(s.guard)
    let n = s.refreshes
    sync.unlock(s.guard)
    n
}
