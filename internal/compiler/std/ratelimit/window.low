import std/cancel
import std/sync
import std/time/clock
import std/time/duration

struct WindowState {
    guard: sync.Mutex
    clock: clock.Clock
    sleeper: fn(duration.Duration)?
    limit: i64
    per: i64
    stamps: []i64
    head: i64
}

/// A sliding-window limiter that admits at most `limit` events in any interval of `per`.
///
/// It records the time of each admitted event and forgets one once `per` has passed, so unlike `Bucket` it allows no bursts across window edges. A `Window` is a handle: copies share one state, and every operation is safe to call from several green threads.
pub struct Window {
    state: *WindowState
}

/// Returns a window that admits `limit` events per `per`, reading time from `c`.
///
/// Panics if `limit` or `per` is not positive.
pub fn window(limit: i64, per: duration.Duration, c: clock.Clock) -> Window {
    let interval = nanos_of(per)
    if limit < 1 || interval < 1 {
        __panic("ratelimit: window limit and interval must be positive")
    }
    let s = WindowState { guard: sync.mutex(), clock: c, sleeper: none, limit, per: interval, stamps: [], head: 0 }
    Window { state: new(s) }
}

/// Replaces how `admit_wait` pauses with `f`, which receives the time still to wait.
///
/// By default a wait parks the green thread on the cancel token. A custom sleeper is not interrupted by the token; it is meant for tests that drive a fake clock.
pub fn set_window_sleeper(w: Window, f: fn(duration.Duration)) {
    let s = w.state
    sync.lock(s.guard)
    s.sleeper = some(f)
    sync.unlock(s.guard)
}

fn expire(s: *WindowState, now: i64) {
    for s.head < s.stamps.len && s.stamps[s.head] <= now - s.per {
        s.head += 1
    }
    if s.head >= 64 && s.head * 2 >= s.stamps.len {
        s.stamps = s.stamps[s.head..]
        s.head = 0
    }
}

fn live(s: *WindowState) -> i64 {
    s.stamps.len - s.head
}

fn current(s: *WindowState) -> i64 {
    let now = nanos_of(s.clock.monotonic())
    expire(s, now)
    now
}

/// Records an event and returns `true` if fewer than `limit` events fall in the last `per`, or returns `false` without recording it.
///
/// Never blocks.
pub fn admit(w: Window) -> bool {
    let s = w.state
    sync.lock(s.guard)
    let now = current(s)
    let granted = live(s) < s.limit
    if granted {
        push(mut s.stamps, now)
    }
    sync.unlock(s.guard)
    granted
}

/// Returns how long until `admit` would succeed.
///
/// Returns a zero duration when the window has room now.
pub fn retry_in(w: Window) -> duration.Duration {
    let s = w.state
    sync.lock(s.guard)
    let now = current(s)
    let wait = pending(s, now)
    sync.unlock(s.guard)
    duration.nanoseconds(wait)
}

fn pending(s: *WindowState, now: i64) -> i64 {
    if live(s) < s.limit {
        return 0
    }
    s.stamps[s.head] + s.per - now
}

/// Returns the number of admitted events still inside the window.
pub fn in_window(w: Window) -> i64 {
    let s = w.state
    sync.lock(s.guard)
    current(s)
    let n = live(s)
    sync.unlock(s.guard)
    n
}

/// Waits until an event is admitted and records it.
///
/// Blocks the calling green thread, pausing for `retry_in` between attempts. Fails with `Cancelled` if `t` is cancelled before an attempt or during a pause.
pub fn admit_wait(w: Window, t: *cancel.Token) ! Error {
    let s = w.state
    for {
        if cancel.cancelled(t) {
            fail Cancelled
        }
        if admit(w) {
            return
        }
        let wait = retry_in(w)
        match s.sleeper {
            some(f) => f(wait)
            none => {
                let finished = cancel.pause(t, millis_up(nanos_of(wait)))
            }
        }
    }
}
