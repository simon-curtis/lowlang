struct Decimal {
    digits: []u8
    count: i64
    point: i64
    truncated: bool
}

fn decimal_capacity() -> i64 {
    800
}

pub fn float_bits(v: f64) -> u64 {
    u64(__bits(v))
}

pub fn float_from_bits(bits: u64) -> f64 {
    let cell: []u64 = [bits]
    let raw: ptr = __slice_ptr(cell)
    let typed: ptr[f64] = raw
    load(typed)
}

fn trim_decimal(d: *Decimal) {
    for d.count > 0 && d.digits[d.count - 1] == 0 {
        d.count -= 1
    }
    if d.count == 0 {
        d.point = 0
    }
}

fn shift_right(d: *Decimal, k: i64) {
    var read = 0
    var write = 0
    var n: u64 = 0
    for n >> k == 0 {
        if read >= d.count {
            if n == 0 {
                d.count = 0
                return
            }
            for n >> k == 0 {
                n = n * 10
                read += 1
            }
            break
        }
        n = n * 10 + u64(d.digits[read])
        read += 1
    }
    d.point -= read - 1
    let mask: u64 = (1 << k) - 1
    for read < d.count {
        let c = d.digits[read]
        d.digits[write] = u8(n >> k)
        write += 1
        n = (n & mask) * 10 + u64(c)
        read += 1
    }
    for n > 0 {
        let digit = u8(n >> k)
        n = n & mask
        if write < decimal_capacity() {
            d.digits[write] = digit
            write += 1
        } else if digit > 0 {
            d.truncated = true
        }
        n = n * 10
    }
    d.count = write
    trim_decimal(d)
}

fn shift_left(d: *Decimal, k: i64) {
    var reversed: []u8 = []
    var carry: u64 = 0
    var i = d.count - 1
    for i >= 0 {
        let v = u64(d.digits[i]) << k + carry
        push(mut reversed, u8(v % 10))
        carry = v / 10
        i -= 1
    }
    for carry > 0 {
        push(mut reversed, u8(carry % 10))
        carry = carry / 10
    }
    d.point += reversed.len - d.count
    var kept = reversed.len
    if kept > decimal_capacity() {
        kept = decimal_capacity()
    }
    for j in 0..reversed.len {
        let digit = reversed[reversed.len - 1 - j]
        if j < kept {
            d.digits[j] = digit
        } else if digit != 0 {
            d.truncated = true
        }
    }
    d.count = kept
    trim_decimal(d)
}

fn shift_decimal(d: *Decimal, k: i64) {
    if d.count == 0 {
        return
    }
    var rest = k
    for rest > 60 {
        shift_left(d, 60)
        rest -= 60
    }
    if rest > 0 {
        shift_left(d, rest)
    }
    for rest < -60 {
        shift_right(d, 60)
        rest += 60
    }
    if rest < 0 {
        shift_right(d, -rest)
    }
}

fn rounds_up(d: *Decimal, at: i64) -> bool {
    if at < 0 || at >= d.count {
        return false
    }
    if d.digits[at] == 5 && at + 1 == d.count {
        if d.truncated {
            return true
        }
        return at > 0 && d.digits[at - 1] % 2 == 1
    }
    d.digits[at] >= 5
}

fn rounded_integer(d: *Decimal) -> u64 {
    if d.point > 20 {
        return 0xFFFFFFFFFFFFFFFF
    }
    var n: u64 = 0
    var i = 0
    for i < d.point && i < d.count {
        n = n * 10 + u64(d.digits[i])
        i += 1
    }
    for i < d.point {
        n = n * 10
        i += 1
    }
    if rounds_up(d, d.point) {
        n += 1
    }
    n
}

fn power_step(point: i64) -> i64 {
    let table: []i64 = [1, 3, 6, 9, 13, 16, 19, 23, 26]
    if point >= table.len { 27 } else { table[point] }
}

fn decimal_bits(d: *Decimal) -> u64 {
    if d.count == 0 || d.point < -330 {
        return 0
    }
    if d.point > 310 {
        return 0x7FF0000000000000
    }
    var exp = 0
    for d.point > 0 {
        let n = power_step(d.point)
        shift_decimal(d, -n)
        exp += n
    }
    for d.point < 0 || d.point == 0 && d.digits[0] < 5 {
        let n = power_step(-d.point)
        shift_decimal(d, n)
        exp -= n
    }
    exp -= 1
    if exp < -1022 {
        let n = -1022 - exp
        shift_decimal(d, -n)
        exp += n
    }
    if exp + 1023 >= 2047 {
        return 0x7FF0000000000000
    }
    shift_decimal(d, 53)
    var mantissa = rounded_integer(d)
    if mantissa == 1 << 53 {
        mantissa = mantissa >> 1
        exp += 1
        if exp + 1023 >= 2047 {
            return 0x7FF0000000000000
        }
    }
    if mantissa & (1 << 52) == 0 {
        exp = -1023
    }
    mantissa & ((1 << 52) - 1) | u64(exp + 1023) & 0x7FF << 52
}

fn exact_power(e: i64) -> f64 {
    var p = 1.0
    for _ in 0..e {
        p = p * 10.0
    }
    p
}

fn special_float(s: str) -> f64? {
    let lowered = lower(s)
    if lowered == "inf" || lowered == "infinity" {
        return float_from_bits(0x7FF0000000000000)
    }
    if lowered == "nan" {
        return float_from_bits(0x7FF8000000000000)
    }
    none
}

pub fn parse_float(text: str) -> f64 ! ParseError {
    if text.len == 0 {
        fail Empty
    }
    var i = 0
    var negative = false
    if text[0] == '+' || text[0] == '-' {
        negative = text[0] == '-'
        i = 1
    }
    match special_float(text[i..]) {
        some(v) => return if negative { -v } else { v }
        none => {}
    }
    let d = new(Decimal { digits: __make(decimal_capacity()), count: 0, point: 0, truncated: false })
    var mantissa: u64 = 0
    var significant = 0
    var dropped = false
    var seen_digit = false
    var seen_point = false
    var fraction = 0
    for i < text.len {
        let c = text[i]
        if c == '.' {
            if seen_point {
                fail BadDigit(i)
            }
            seen_point = true
            d.point = d.count
        } else if c >= '0' && c <= '9' {
            seen_digit = true
            if seen_point {
                fraction += 1
            }
            if c == '0' && d.count == 0 {
                d.point -= 1
            } else if d.count < decimal_capacity() {
                d.digits[d.count] = c - '0'
                d.count += 1
            } else if c != '0' {
                d.truncated = true
            }
            if significant < 19 {
                mantissa = mantissa * 10 + u64(c - '0')
                if mantissa != 0 {
                    significant += 1
                }
            } else {
                dropped = true
            }
        } else {
            break
        }
        i += 1
    }
    if !seen_digit {
        fail BadDigit(i)
    }
    if !seen_point {
        d.point = d.count
    }
    var exponent = 0
    if i < text.len {
        if text[i] != 'e' && text[i] != 'E' {
            fail BadDigit(i)
        }
        i += 1
        var negative_exponent = false
        if i < text.len && (text[i] == '+' || text[i] == '-') {
            negative_exponent = text[i] == '-'
            i += 1
        }
        if i == text.len {
            fail BadDigit(i)
        }
        for i < text.len {
            let c = text[i]
            if c < '0' || c > '9' {
                fail BadDigit(i)
            }
            if exponent < 100000 {
                exponent = exponent * 10 + i64(c - '0')
            }
            i += 1
        }
        if negative_exponent {
            exponent = -exponent
        }
    }
    d.point += exponent
    let scale = exponent - fraction
    var value = 0.0
    if !dropped && mantissa < 1 << 53 && scale >= -22 && scale <= 22 {
        value = f64(mantissa)
        if scale >= 0 {
            value = value * exact_power(scale)
        } else {
            value = value / exact_power(-scale)
        }
    } else {
        trim_decimal(d)
        value = float_from_bits(decimal_bits(d))
    }
    if negative { -value } else { value }
}
