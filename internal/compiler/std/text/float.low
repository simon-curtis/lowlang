struct Decimal {
    digits: []u8
    count: i64
    point: i64
    truncated: bool
}

fn decimal_capacity() -> i64 {
    800
}

pub fn float_bits(v: f64) -> u64 {
    u64(__bits(v))
}

pub fn float_from_bits(bits: u64) -> f64 {
    let cell: []u64 = [bits]
    let raw: ptr = __slice_ptr(cell)
    let typed: ptr[f64] = raw
    load(typed)
}

fn trim_decimal(d: *Decimal) {
    for d.count > 0 && d.digits[d.count - 1] == 0 {
        d.count -= 1
    }
    if d.count == 0 {
        d.point = 0
    }
}

fn shift_right(d: *Decimal, k: i64) {
    var read = 0
    var write = 0
    var n: u64 = 0
    for n >> k == 0 {
        if read >= d.count {
            if n == 0 {
                d.count = 0
                return
            }
            for n >> k == 0 {
                n = n * 10
                read += 1
            }
            break
        }
        n = n * 10 + u64(d.digits[read])
        read += 1
    }
    d.point -= read - 1
    let mask: u64 = (1 << k) - 1
    for read < d.count {
        let c = d.digits[read]
        d.digits[write] = u8(n >> k)
        write += 1
        n = (n & mask) * 10 + u64(c)
        read += 1
    }
    for n > 0 {
        let digit = u8(n >> k)
        n = n & mask
        if write < decimal_capacity() {
            d.digits[write] = digit
            write += 1
        } else if digit > 0 {
            d.truncated = true
        }
        n = n * 10
    }
    d.count = write
    trim_decimal(d)
}

fn shift_left(d: *Decimal, k: i64) {
    var reversed: []u8 = []
    var carry: u64 = 0
    var i = d.count - 1
    for i >= 0 {
        let v = u64(d.digits[i]) << k + carry
        push(mut reversed, u8(v % 10))
        carry = v / 10
        i -= 1
    }
    for carry > 0 {
        push(mut reversed, u8(carry % 10))
        carry = carry / 10
    }
    d.point += reversed.len - d.count
    var kept = reversed.len
    if kept > decimal_capacity() {
        kept = decimal_capacity()
    }
    for j in 0..reversed.len {
        let digit = reversed[reversed.len - 1 - j]
        if j < kept {
            d.digits[j] = digit
        } else if digit != 0 {
            d.truncated = true
        }
    }
    d.count = kept
    trim_decimal(d)
}

fn shift_decimal(d: *Decimal, k: i64) {
    if d.count == 0 {
        return
    }
    var rest = k
    for rest > 60 {
        shift_left(d, 60)
        rest -= 60
    }
    if rest > 0 {
        shift_left(d, rest)
    }
    for rest < -60 {
        shift_right(d, 60)
        rest += 60
    }
    if rest < 0 {
        shift_right(d, -rest)
    }
}

fn rounds_up(d: *Decimal, at: i64) -> bool {
    if at < 0 || at >= d.count {
        return false
    }
    if d.digits[at] == 5 && at + 1 == d.count {
        if d.truncated {
            return true
        }
        return at > 0 && d.digits[at - 1] % 2 == 1
    }
    d.digits[at] >= 5
}

fn rounded_integer(d: *Decimal) -> u64 {
    if d.point > 20 {
        return 0xFFFFFFFFFFFFFFFF
    }
    var n: u64 = 0
    var i = 0
    for i < d.point && i < d.count {
        n = n * 10 + u64(d.digits[i])
        i += 1
    }
    for i < d.point {
        n = n * 10
        i += 1
    }
    if rounds_up(d, d.point) {
        n += 1
    }
    n
}

fn power_step(point: i64) -> i64 {
    let table: []i64 = [1, 3, 6, 9, 13, 16, 19, 23, 26]
    if point >= table.len { 27 } else { table[point] }
}

fn decimal_bits(d: *Decimal) -> u64 {
    if d.count == 0 || d.point < -330 {
        return 0
    }
    if d.point > 310 {
        return 0x7FF0000000000000
    }
    var exp = 0
    for d.point > 0 {
        let n = power_step(d.point)
        shift_decimal(d, -n)
        exp += n
    }
    for d.point < 0 || d.point == 0 && d.digits[0] < 5 {
        let n = power_step(-d.point)
        shift_decimal(d, n)
        exp -= n
    }
    exp -= 1
    if exp < -1022 {
        let n = -1022 - exp
        shift_decimal(d, -n)
        exp += n
    }
    if exp + 1023 >= 2047 {
        return 0x7FF0000000000000
    }
    shift_decimal(d, 53)
    var mantissa = rounded_integer(d)
    if mantissa == 1 << 53 {
        mantissa = mantissa >> 1
        exp += 1
        if exp + 1023 >= 2047 {
            return 0x7FF0000000000000
        }
    }
    if mantissa & (1 << 52) == 0 {
        exp = -1023
    }
    mantissa & ((1 << 52) - 1) | u64(exp + 1023) & 0x7FF << 52
}

fn exact_power(e: i64) -> f64 {
    match e {
        0 => 1.0
        1 => 1e1
        2 => 1e2
        3 => 1e3
        4 => 1e4
        5 => 1e5
        6 => 1e6
        7 => 1e7
        8 => 1e8
        9 => 1e9
        10 => 1e10
        11 => 1e11
        12 => 1e12
        13 => 1e13
        14 => 1e14
        15 => 1e15
        16 => 1e16
        17 => 1e17
        18 => 1e18
        19 => 1e19
        20 => 1e20
        21 => 1e21
        _ => 1e22
    }
}

fn two_power_step() -> i64 {
    62
}

fn scaled_by_two(x: f64, e: i64) -> f64 {
    let step = f64(i64(1) << two_power_step())
    var v = x
    var k = e
    for k > two_power_step() {
        v = v * step
        k -= two_power_step()
    }
    for k < -two_power_step() {
        v = v / step
        k += two_power_step()
    }
    if k > 0 {
        return v * f64(i64(1) << k)
    }
    if k < 0 {
        return v / f64(i64(1) << -k)
    }
    v
}

fn infinity() -> f64 {
    let step = exact_power(22)
    let wide = step * step
    let wider = wide * wide
    let widest = wider * wider
    widest * widest
}

fn pow10_table() -> []u64 {
    let raw: ptr = __slice_ptr(embed("pow10.bin"))
    let typed: ptr[u64] = raw
    view(typed, 1392)
}

fn bit_length(x: u64) -> i64 {
    var n = 0
    var v = x
    if v >> 32 != 0 {
        v = v >> 32
        n += 32
    }
    if v >> 16 != 0 {
        v = v >> 16
        n += 16
    }
    if v >> 8 != 0 {
        v = v >> 8
        n += 8
    }
    if v >> 4 != 0 {
        v = v >> 4
        n += 4
    }
    if v >> 2 != 0 {
        v = v >> 2
        n += 2
    }
    if v >> 1 != 0 {
        v = v >> 1
        n += 1
    }
    n + i64(v)
}

fn unrounded_product(x: u64, hi: u64, lo: u64, s: i64) -> u64 {
    let high = __mulhi(x, hi)
    let mid = x * hi
    let shift = s & 63
    if (high >> shift) << shift != high {
        return high >> shift | 1
    }
    let mid2 = __mulhi(x, lo)
    var top = high
    if mid < mid2 {
        top -= 1
    }
    var sticky: u64 = 0
    if mid - mid2 > 1 {
        sticky = 1
    }
    top >> shift | sticky
}

fn nearest_float(d: u64, p: i64) -> f64 {
    let width = bit_length(d)
    let log = (p * 108853) >> 15
    var e = 53 - width - log
    if e > 1074 {
        e = 1074
    }
    let s = 0 - (e - (64 - width) + log + 3)
    if s >= 64 {
        return 0.0
    }
    let table = pow10_table()
    let at = 2 * (p + 348)
    var u = unrounded_product(d << (64 - width), table[at], table[at + 1], s)
    let overflow: u64 = 0x7FFFFFFFFFFFFE
    if u >= overflow {
        u = (u >> 1) | (u & 1)
        e -= 1
    }
    let m = (u + 1 + ((u >> 2) & 1)) >> 2
    if m >> 52 != 0 && e <= -972 {
        return infinity()
    }
    scaled_by_two(f64(m), -e)
}

fn convert_decimal(text: str, from: i64, mantissa: u64, p: i64, point: i64, dropped: bool) -> f64 {
    if mantissa == 0 || p < -345 {
        return 0.0
    }
    if p > 310 {
        return infinity()
    }
    if !dropped && mantissa < 1 << 53 && p >= -22 && p <= 22 {
        if p >= 0 {
            return f64(mantissa) * exact_power(p)
        }
        return f64(mantissa) / exact_power(-p)
    }
    let value = nearest_float(mantissa, p)
    if !dropped || value == nearest_float(mantissa + 1, p) {
        return value
    }
    let d = digits_decimal(text, from, point)
    trim_decimal(d)
    float_from_bits(decimal_bits(d))
}

fn digits_decimal(text: str, from: i64, point: i64) -> *Decimal {
    let d = new(Decimal { digits: __make(decimal_capacity()), count: 0, point, truncated: false })
    var i = from
    for i < text.len {
        let c = text[i]
        if c != '.' {
            if c < '0' || c > '9' {
                break
            }
            if d.count > 0 || c != '0' {
                keep_digit(d, c)
            }
        }
        i += 1
    }
    d
}

fn keep_digit(d: *Decimal, c: u8) {
    if d.count < decimal_capacity() {
        d.digits[d.count] = c - '0'
        d.count += 1
    } else if c != '0' {
        d.truncated = true
    }
}

fn special_float(s: str) -> f64? {
    if equal_fold(s, "inf") || equal_fold(s, "infinity") {
        return float_from_bits(0x7FF0000000000000)
    }
    if equal_fold(s, "nan") {
        return float_from_bits(0x7FF8000000000000)
    }
    none
}

pub fn parse_float(text: str) -> f64 ! ParseError {
    if text.len == 0 {
        fail Empty
    }
    var i = 0
    var negative = false
    if text[0] == '+' || text[0] == '-' {
        negative = text[0] == '-'
        i = 1
    }
    match special_float(text[i..]) {
        some(v) => return if negative { -v } else { v }
        none => {}
    }
    let digits_from = i
    var mantissa: u64 = 0
    var kept = 0
    var count = 0
    var point = 0
    var dropped = false
    var seen_digit = false
    var seen_point = false
    for i < text.len {
        let c = text[i]
        if c == '.' {
            if seen_point {
                fail BadDigit(i)
            }
            seen_point = true
            point = count
        } else if c >= '0' && c <= '9' {
            seen_digit = true
            if c == '0' && count == 0 {
                point -= 1
            } else {
                count += 1
                if kept < 19 {
                    mantissa = mantissa * 10 + u64(c - '0')
                    kept += 1
                } else if c != '0' {
                    dropped = true
                }
            }
        } else {
            break
        }
        i += 1
    }
    if !seen_digit {
        fail BadDigit(i)
    }
    if !seen_point {
        point = count
    }
    var exponent = 0
    if i < text.len {
        if text[i] != 'e' && text[i] != 'E' {
            fail BadDigit(i)
        }
        i += 1
        var negative_exponent = false
        if i < text.len && (text[i] == '+' || text[i] == '-') {
            negative_exponent = text[i] == '-'
            i += 1
        }
        if i == text.len {
            fail BadDigit(i)
        }
        for i < text.len {
            let c = text[i]
            if c < '0' || c > '9' {
                fail BadDigit(i)
            }
            if exponent < 100000 {
                exponent = exponent * 10 + i64(c - '0')
            }
            i += 1
        }
        if negative_exponent {
            exponent = -exponent
        }
    }
    let value = convert_decimal(text, digits_from, mantissa, exponent + point - kept, point + exponent, dropped)
    if negative { -value } else { value }
}

fn assign_decimal(d: *Decimal, value: u64) {
    var reversed: []u8 = []
    var n = value
    for n > 0 {
        push(mut reversed, u8(n % 10))
        n = n / 10
    }
    for i in 0..reversed.len {
        d.digits[i] = reversed[reversed.len - 1 - i]
    }
    d.count = reversed.len
    d.point = reversed.len
    trim_decimal(d)
}

fn round_decimal(d: *Decimal, keep: i64) {
    if keep < 0 {
        d.count = 0
        d.point = 0
        return
    }
    if keep >= d.count {
        return
    }
    if !rounds_up(d, keep) {
        d.count = keep
        trim_decimal(d)
        return
    }
    var i = keep - 1
    for i >= 0 && d.digits[i] == 9 {
        i -= 1
    }
    if i < 0 {
        d.digits[0] = 1
        d.count = 1
        d.point += 1
        return
    }
    d.digits[i] += 1
    d.count = i + 1
}

fn digit_at(d: *Decimal, at: i64) -> u8 {
    if at >= 0 && at < d.count {
        return d.digits[at] + '0'
    }
    '0'
}

pub fn fixed(x: f64, places: i64) -> str {
    if x != x {
        return "NaN"
    }
    let bits = float_bits(x)
    let negative = bits >> 63 == 1
    let exponent = i64(bits >> 52 & 0x7FF)
    if exponent == 0x7FF {
        if negative {
            return "-inf"
        }
        return "inf"
    }
    var mantissa = bits & 0xFFFFFFFFFFFFF
    var shift = exponent - 1075
    if exponent == 0 {
        shift = -1074
    } else {
        mantissa = mantissa | 0x10000000000000
    }
    let d = new(Decimal { digits: __make(decimal_capacity()), count: 0, point: 0, truncated: false })
    assign_decimal(d, mantissa)
    shift_decimal(d, shift)
    round_decimal(d, d.point + places)
    var out: []u8 = []
    if negative {
        push(mut out, '-')
    }
    if d.point <= 0 {
        push(mut out, '0')
    }
    for i in 0..d.point {
        push(mut out, digit_at(d, i))
    }
    if places > 0 {
        push(mut out, '.')
        for i in 0..places {
            push(mut out, digit_at(d, d.point + i))
        }
    }
    __str_view(out)
}

