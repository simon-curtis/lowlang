import std/text
import std/unicode

/// How a cell's text is positioned within a wider column.
pub enum Align {
    /// The text starts at the left edge and the padding follows it.
    Left
    /// The text is centred. When the padding is odd, the extra blank goes after the text.
    Center
    /// The text ends at the right edge and the padding precedes it.
    Right
}

struct Piece {
    text: str
    width: i64
    style: bool
}

struct Word {
    pieces: []Piece
    width: i64
}

struct Attribute {
    class: i64
    seq: str
}

struct Layout {
    limit: i64
    lines: []str
    line: []u8
    used: i64
    active: []Attribute
}

fn escape_byte() -> u8 {
    27
}

fn reset_sequence() -> str {
    "{text.from_char(27)}[0m"
}

fn skip_csi(s: str, from: i64) -> i64 {
    var i = from
    for i < s.len {
        let c = s[i]
        i += 1
        if c >= 64 && c <= 126 {
            break
        }
    }
    i
}

fn skip_string(s: str, from: i64) -> i64 {
    var i = from
    for i < s.len {
        if s[i] == 7 {
            return i + 1
        }
        if s[i] == 27 && i + 1 < s.len && s[i + 1] == '\\' {
            return i + 2
        }
        i += 1
    }
    i
}

fn skip_other(s: str, from: i64) -> i64 {
    var i = from
    for i < s.len && s[i] >= 32 && s[i] <= 47 {
        i += 1
    }
    if i < s.len { i + 1 } else { i }
}

fn escape_end(s: str, from: i64) -> i64 {
    if from >= s.len {
        return from
    }
    match s[from] {
        == '[' => skip_csi(s, from + 1)
        == ']' => skip_string(s, from + 1)
        == 'P' => skip_string(s, from + 1)
        == '_' => skip_string(s, from + 1)
        == '^' => skip_string(s, from + 1)
        _ => skip_other(s, from)
    }
}

fn cluster_width(g: str) -> i64 {
    let w = unicode.text_width(g)
    if w > 2 { 2 } else { w }
}

fn plain(s: str) -> bool {
    for i in 0..s.len {
        if s[i] < 32 || s[i] > 126 {
            return false
        }
    }
    true
}

fn pieces(s: str) -> []Piece {
    var out: []Piece = []
    var i = 0
    for i < s.len {
        if s[i] == escape_byte() {
            let end = escape_end(s, i + 1)
            push(mut out, Piece { text: s[i..end], width: 0, style: true })
            i = end
        } else if s[i] == '\\' && i + 1 < s.len && s[i + 1] == '|' {
            push(mut out, Piece { text: s[i..i + 2], width: 2, style: false })
            i += 2
        } else {
            let end = unicode.grapheme_end(s, i)
            push(mut out, Piece { text: s[i..end], width: cluster_width(s[i..end]), style: false })
            i = end
        }
    }
    out
}

/// Returns the display width of `s` in terminal columns.
/// Printable ASCII counts one column per byte. Otherwise each grapheme cluster counts its `unicode.text_width`, at most 2, and ANSI escape sequences count 0.
pub fn width(s: str) -> i64 {
    if plain(s) {
        return s.len
    }
    var total = 0
    for p in pieces(s) {
        total += p.width
    }
    total
}

fn has_style(ps: []Piece) -> bool {
    for p in ps {
        if p.style {
            return true
        }
    }
    false
}

fn truncate(s: str, limit: i64, ellipsis: str) -> str {
    if width(s) <= limit {
        return s
    }
    var mark = ""
    if width(ellipsis) <= limit {
        mark = ellipsis
    }
    let budget = limit - width(mark)
    let ps = pieces(s)
    var out: []u8 = []
    var used = 0
    for p in ps {
        if p.style {
            text.append(mut out, p.text)
        } else if used + p.width <= budget {
            text.append(mut out, p.text)
            used += p.width
        } else {
            break
        }
    }
    text.append(mut out, mark)
    if has_style(ps) {
        text.append(mut out, reset_sequence())
    }
    __str_view(out)
}

fn is_blank(p: Piece) -> bool {
    !p.style && (p.text == " " || p.text == "\t")
}

fn words_of(ps: []Piece) -> []Word {
    var out: []Word = []
    var current: []Piece = []
    var used = 0
    for p in ps {
        if is_blank(p) {
            if current.len > 0 {
                push(mut out, Word { pieces: current, width: used })
                current = []
                used = 0
            }
        } else {
            push(mut current, p)
            used += p.width
        }
    }
    if current.len > 0 {
        push(mut out, Word { pieces: current, width: used })
    }
    out
}

fn is_sgr(p: Piece) -> bool {
    p.style && p.text.len >= 3 && p.text[1] == '[' && p.text[p.text.len - 1] == 'm'
}

fn sgr_code(seq: str) -> i64 {
    var n = 0
    var i = 2
    for i < seq.len && seq[i] >= '0' && seq[i] <= '9' {
        n = n * 10 + i64(seq[i] - '0')
        i += 1
    }
    n
}

fn attribute_class(code: i64) -> i64 {
    if code >= 30 && code <= 38 || code >= 90 && code <= 97 {
        return 1
    }
    if code >= 40 && code <= 48 || code >= 100 && code <= 107 {
        return 2
    }
    match code {
        == 1 => 3
        == 2 => 3
        == 3 => 4
        == 4 => 5
        == 5 => 6
        == 6 => 6
        == 7 => 7
        == 8 => 8
        == 9 => 9
        _ => 0
    }
}

fn cleared_class(code: i64) -> i64 {
    match code {
        == 39 => 1
        == 49 => 2
        == 22 => 3
        == 23 => 4
        == 24 => 5
        == 25 => 6
        == 27 => 7
        == 28 => 8
        == 29 => 9
        _ => 0
    }
}

fn without_class(active: []Attribute, class: i64) -> []Attribute {
    var out: []Attribute = []
    for a in active {
        if a.class != class {
            push(mut out, a)
        }
    }
    out
}

fn track(l: *Layout, p: Piece) {
    if !is_sgr(p) {
        return
    }
    let code = sgr_code(p.text)
    if code == 0 {
        l.active = []
        return
    }
    let cleared = cleared_class(code)
    if cleared > 0 {
        l.active = without_class(l.active, cleared)
        return
    }
    let class = attribute_class(code)
    if class > 0 {
        l.active = without_class(l.active, class)
    }
    push(mut l.active, Attribute { class, seq: p.text })
}

fn close_line(l: *Layout) {
    if l.active.len > 0 {
        text.append(mut l.line, reset_sequence())
    }
    push(mut l.lines, __str_view(l.line))
    var next: []u8 = []
    for a in l.active {
        text.append(mut next, a.seq)
    }
    l.line = next
    l.used = 0
}

fn place(l: *Layout, ps: []Piece) {
    for p in ps {
        if !p.style && l.used > 0 && l.used + p.width > l.limit {
            close_line(l)
        }
        text.append(mut l.line, p.text)
        l.used += p.width
        track(l, p)
    }
}

fn wrap_line(s: str, limit: i64) -> []str {
    let l = new(Layout { limit, lines: [], line: [], used: 0, active: [] })
    for w in words_of(pieces(s)) {
        if l.used == 0 {
            place(l, w.pieces)
        } else if l.used + 1 + w.width <= limit {
            text.append(mut l.line, " ")
            l.used += 1
            place(l, w.pieces)
        } else {
            close_line(l)
            place(l, w.pieces)
        }
    }
    if l.used > 0 || l.lines.len == 0 {
        push(mut l.lines, __str_view(l.line))
    }
    l.lines
}

fn spaced(s: str) -> str {
    text.replace(text.replace(s, "\r", ""), "\t", "    ")
}

fn fit_line(s: str, limit: i64, wrap: bool, ellipsis: str) -> []str {
    if width(s) <= limit {
        return [s]
    }
    if wrap {
        return wrap_line(s, limit)
    }
    [truncate(s, limit, ellipsis)]
}

/// Fits `cell` to a column `limit` columns wide and returns its lines.
/// `cell` is split at `\n`, carriage returns are removed and tabs become four spaces. A line within `limit` is returned unchanged. A longer line is wrapped at spaces and tabs when `wrap` is `true`, with each run of them becoming one space and breaking inside a word only when the word alone is wider than `limit`, and is cut and ended with `ellipsis` when `wrap` is `false`. The ellipsis is left out when it is itself wider than `limit`. ANSI colour and style sequences take no width, are carried onto each following line and are closed with a reset at the end of every line they are active on.
pub fn fit(cell: str, limit: i64, wrap: bool, ellipsis: str) -> []str {
    var out: []str = []
    for line in text.split(spaced(cell), '\n') {
        for part in fit_line(line, limit, wrap, ellipsis) {
            push(mut out, part)
        }
    }
    out
}

/// Returns `n` spaces.
pub fn blanks(n: i64) -> str {
    text.repeat(" ", n)
}

/// Returns `s` padded with spaces to `limit` columns, positioned by `a`.
/// The width is measured by `width`. A string already `limit` columns or wider is returned unchanged.
pub fn pad(s: str, limit: i64, a: Align) -> str {
    let extra = limit - width(s)
    if extra <= 0 {
        return s
    }
    let before = match a {
        Left => 0
        Right => extra
        Center => extra / 2
    }
    "{blanks(before)}{s}{blanks(extra - before)}"
}

/// Returns the width in columns of the widest line of `cell` once tabs are expanded to four spaces and carriage returns removed.
/// This is the width at which `fit` leaves `cell` unchanged.
pub fn natural(cell: str) -> i64 {
    var most = 0
    for line in text.split(spaced(cell), '\n') {
        let w = width(line)
        if w > most {
            most = w
        }
    }
    most
}
