import std/text

pub enum Border {
    None
    Ascii
    Unicode
    Markdown
    Tabs
}

pub struct Column {
    pub align: Align = Left
    pub min_width: i64 = 0
    pub max_width: i64 = 0
}

pub struct Table {
    pub header: []str = []
    pub rows: [][]str = []
    pub columns: []Column = []
    pub border: Border = Ascii
    pub padding: i64 = 1
    pub wrap: bool = false
    pub ellipsis: str = "…"
}

struct Frame {
    horizontal: str
    vertical: str
    top: []str
    middle: []str
    bottom: []str
}

pub fn add_row(mut t: Table, row: []str) {
    push(mut t.rows, row)
}

fn grow_columns(mut t: Table, count: i64) {
    for t.columns.len < count {
        push(mut t.columns, Column {})
    }
}

pub fn set_column(mut t: Table, index: i64, c: Column) {
    grow_columns(mut t, index + 1)
    t.columns[index] = c
}

pub fn set_align(mut t: Table, index: i64, a: Align) {
    grow_columns(mut t, index + 1)
    t.columns[index].align = a
}

pub fn set_limits(mut t: Table, index: i64, min_width: i64, max_width: i64) {
    grow_columns(mut t, index + 1)
    t.columns[index].min_width = min_width
    t.columns[index].max_width = max_width
}

fn column_at(t: Table, index: i64) -> Column {
    if index < t.columns.len {
        return t.columns[index]
    }
    Column {}
}

fn column_count(t: Table) -> i64 {
    var count = t.header.len
    for row in t.rows {
        if row.len > count {
            count = row.len
        }
    }
    count
}

fn markdown_cell(s: str) -> str {
    let escaped = text.replace(text.replace(s, "\\", "\\\\"), "|", "\\|")
    text.replace(text.replace(escaped, "\r", ""), "\n", "<br>")
}

fn tab_cell(s: str) -> str {
    let escaped = text.replace(s, "\\", "\\\\")
    text.replace(text.replace(text.replace(escaped, "\t", "\\t"), "\n", "\\n"), "\r", "\\r")
}

fn prepared(t: Table, row: []str, count: i64) -> []str {
    var out: []str = []
    for k in 0..count {
        var cell = ""
        if k < row.len {
            cell = row[k]
        }
        if t.border == Markdown {
            cell = markdown_cell(cell)
        } else if t.border == Tabs {
            cell = tab_cell(cell)
        }
        push(mut out, cell)
    }
    out
}

fn prepared_rows(t: Table, count: i64) -> [][]str {
    var out: [][]str = []
    if t.header.len > 0 || t.border == Markdown {
        push(mut out, prepared(t, t.header, count))
    }
    for row in t.rows {
        push(mut out, prepared(t, row, count))
    }
    out
}

fn column_width(t: Table, index: i64, rows: [][]str) -> i64 {
    let c = column_at(t, index)
    var w = 0
    for row in rows {
        let n = natural(row[index])
        if n > w {
            w = n
        }
    }
    if c.max_width > 0 && w > c.max_width {
        w = c.max_width
    }
    if w < c.min_width {
        w = c.min_width
    }
    if t.border == Markdown && w < 3 {
        w = 3
    }
    w
}

fn widths_of(t: Table, rows: [][]str, count: i64) -> []i64 {
    var out: []i64 = []
    for k in 0..count {
        push(mut out, column_width(t, k, rows))
    }
    out
}

fn physical(t: Table, cells: []str, widths: []i64) -> [][]str {
    var fitted: [][]str = []
    var height = 1
    for k, cell in cells {
        let lines = fit(cell, widths[k], t.wrap, t.ellipsis)
        push(mut fitted, lines)
        if lines.len > height {
            height = lines.len
        }
    }
    var out: [][]str = []
    for h in 0..height {
        var line: []str = []
        for k, lines in fitted {
            var piece = ""
            if h < lines.len {
                piece = lines[h]
            }
            push(mut line, pad(piece, widths[k], column_at(t, k).align))
        }
        push(mut out, line)
    }
    out
}

fn compose(cells: []str, left: str, sep: str, right: str, inner: i64) -> str {
    var out: []u8 = []
    text.append(mut out, left)
    let margin = blanks(inner)
    for k, cell in cells {
        if k > 0 {
            text.append(mut out, sep)
        }
        text.append(mut out, margin)
        text.append(mut out, cell)
        text.append(mut out, margin)
    }
    text.append(mut out, right)
    __str_view(out)
}

fn trim_blanks(s: str) -> str {
    var end = s.len
    for end > 0 && s[end - 1] == ' ' {
        end -= 1
    }
    s[..end]
}

fn rule(widths: []i64, inner: i64, fill: str, left: str, mid: str, right: str) -> str {
    var parts: []str = []
    for w in widths {
        push(mut parts, text.repeat(fill, w + 2 * inner))
    }
    "{left}{text.join(parts, mid)}{right}"
}

fn frame_of(b: Border) -> Frame {
    if b == Unicode {
        return Frame {
            horizontal: "─", vertical: "│",
            top: ["┌", "┬", "┐"], middle: ["├", "┼", "┤"], bottom: ["└", "┴", "┘"]
        }
    }
    Frame {
        horizontal: "-", vertical: "|",
        top: ["+", "+", "+"], middle: ["+", "+", "+"], bottom: ["+", "+", "+"]
    }
}

fn render_plain(t: Table, rows: [][]str, widths: []i64) -> str {
    var out: []str = []
    let gap = blanks(2 * t.padding)
    for row in rows {
        for cells in physical(t, row, widths) {
            push(mut out, trim_blanks(compose(cells, "", gap, "", 0)))
        }
    }
    text.join(out, "\n")
}

fn render_boxed(t: Table, rows: [][]str, widths: []i64) -> str {
    let f = frame_of(t.border)
    var out: []str = []
    push(mut out, rule(widths, t.padding, f.horizontal, f.top[0], f.top[1], f.top[2]))
    for i, row in rows {
        for cells in physical(t, row, widths) {
            push(mut out, compose(cells, f.vertical, f.vertical, f.vertical, t.padding))
        }
        if i == 0 && t.header.len > 0 {
            push(mut out, rule(widths, t.padding, f.horizontal, f.middle[0], f.middle[1], f.middle[2]))
        }
    }
    push(mut out, rule(widths, t.padding, f.horizontal, f.bottom[0], f.bottom[1], f.bottom[2]))
    text.join(out, "\n")
}

fn dashes(n: i64) -> str {
    text.repeat("-", n)
}

fn marker(a: Align, w: i64) -> str {
    match a {
        Left => dashes(w)
        Right => "{dashes(w - 1)}:"
        Center => ":{dashes(w - 2)}:"
    }
}

fn render_markdown(t: Table, rows: [][]str, widths: []i64) -> str {
    var out: []str = []
    var markers: []str = []
    for k, w in widths {
        push(mut markers, marker(column_at(t, k).align, w))
    }
    for i, row in rows {
        var cells: []str = []
        for k, cell in row {
            let lines = fit(cell, widths[k], t.wrap, t.ellipsis)
            push(mut cells, pad(text.join(lines, "<br>"), widths[k], column_at(t, k).align))
        }
        push(mut out, compose(cells, "|", "|", "|", 1))
        if i == 0 {
            push(mut out, compose(markers, "|", "|", "|", 1))
        }
    }
    text.join(out, "\n")
}

fn render_tabs(t: Table, rows: [][]str) -> str {
    var out: []str = []
    for row in rows {
        push(mut out, text.join(row, "\t"))
    }
    text.join(out, "\n")
}

pub fn render(t: Table) -> str {
    let count = column_count(t)
    if count == 0 {
        return ""
    }
    let rows = prepared_rows(t, count)
    if t.border == Tabs {
        return render_tabs(t, rows)
    }
    let widths = widths_of(t, rows, count)
    match t.border {
        Ascii => render_boxed(t, rows, widths)
        Unicode => render_boxed(t, rows, widths)
        Markdown => render_markdown(t, rows, widths)
        _ => render_plain(t, rows, widths)
    }
}
