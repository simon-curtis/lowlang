import std/text

fn nearest(word: str, known: []str) -> str? {
    var best: str? = none
    var best_distance = 3
    for candidate in known {
        let d = text.edit_distance(text.lower(word), candidate)
        if d < best_distance {
            best_distance = d
            best = some(candidate)
        }
    }
    best
}

fn describe(input: str, known: []str) -> str {
    for candidate in known {
        if text.equal_fold(input, candidate) {
            return "{candidate} (exact)"
        }
    }
    let guess = nearest(input, known) ?? return "{text.quote(input)}: unknown command"
    "{text.quote(input)}: did you mean {guess}?"
}

/// Resolves mistyped commands by edit distance, then wraps a help text, quotes and unquotes a value with escapes, and round-trips bytes through hex.
fn main() {
    let known = ["build", "check", "format", "install", "run", "test"]
    for input in ["BUILD", "biuld", "instal", "tset", "deploy"] {
        print(describe(input, known))
    }

    let help = "build compiles the package in the current directory and writes the executable next to the sources. Use  check  to type-check without writing output."
    print(text.wrap(help, 40))
    print(text.title("getting started: o'neil's low-level notes"))

    let quoted = text.quote("tab\there \"quoted\" é")
    print(quoted)
    print(text.unquote(quoted) or "invalid")
    print(text.unquote("no quotes") catch { NotQuoted => "not quoted", e => "{e}" })
    print(text.quote_ascii("é→✓"))

    let packet = bytes("low")
    let encoded = text.encode_hex(packet)
    print("{encoded} {text.hex(255)} {text.radix(255, 2)}")
    print(str(text.decode_hex(encoded) or []))
    print("{text.strip_prefix("--verbose", "--") ?? "-"} {text.strip_suffix("main.low", ".c") ?? "-"}")
}
