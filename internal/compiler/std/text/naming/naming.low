import std/text
import std/unicode

struct Scan {
    cps: []u32
    classes: []i64
}

fn class_of(c: u32) -> i64 {
    if c == '\'' || c == 0x2018 || c == 0x2019 {
        return 5
    }
    if unicode.is_mark(c) {
        return 4
    }
    if unicode.is_upper(c) || unicode.is_title(c) {
        return 1
    }
    if unicode.is_letter(c) {
        return 2
    }
    if unicode.is_number(c) {
        return 3
    }
    0
}

fn scan(s: str) -> Scan {
    var cps: []u32 = []
    var classes: []i64 = []
    for c in s {
        push(mut cps, c)
        push(mut classes, class_of(c))
    }
    Scan { cps, classes }
}

fn upcoming_index(sc: Scan, at: i64) -> i64 {
    var i = at + 1
    for i < sc.classes.len {
        let k = sc.classes[i]
        if k != 4 && k != 5 {
            return i
        }
        i += 1
    }
    -1
}

fn upcoming(sc: Scan, at: i64) -> i64 {
    let i = upcoming_index(sc, at)
    if i < 0 {
        return 0
    }
    sc.classes[i]
}

fn plural_suffix(sc: Scan, at: i64) -> bool {
    let i = upcoming_index(sc, at)
    if i < 0 || sc.cps[i] != 's' {
        return false
    }
    upcoming(sc, i) != 2
}

fn boundary(prev: i64, cur: i64, next: i64, plural: bool) -> bool {
    if prev == 0 {
        return false
    }
    if cur == 3 {
        return prev != 3
    }
    if prev == 3 {
        return true
    }
    if cur == 1 {
        return prev == 2 || (prev == 1 && next == 2 && !plural)
    }
    false
}

fn flush(mut out: []str, mut word: []u8) {
    if word.len > 0 {
        push(mut out, __str_view(word))
        word = []
    }
}

pub fn parts(s: str) -> []str {
    let sc = scan(s)
    var out: []str = []
    var word: []u8 = []
    var prev = 0
    for i, c in sc.cps {
        let k = sc.classes[i]
        if k == 0 {
            flush(mut out, mut word)
            prev = 0
        } else if k == 4 {
            if word.len > 0 {
                text.append_char(mut word, c)
            }
        } else if k != 5 {
            if boundary(prev, k, upcoming(sc, i), plural_suffix(sc, i)) {
                flush(mut out, mut word)
            }
            text.append_char(mut word, c)
            prev = k
        }
    }
    flush(mut out, mut word)
    out
}

pub fn words(s: str) -> []str {
    var out: []str = []
    for part in parts(s) {
        push(mut out, unicode.lower(part))
    }
    out
}

fn capitalised(word: str) -> str {
    for c in word {
        let first = text.from_char(unicode.to_title(c))
        let rest = unicode.lower(word[unicode.rune_len(c)..])
        return "{first}{rest}"
    }
    word
}

fn capitalised_all(ws: []str) -> []str {
    var out: []str = []
    for w in ws {
        push(mut out, capitalised(w))
    }
    out
}

pub fn delimited(s: str, sep: str) -> str {
    text.join(words(s), sep)
}

pub fn snake(s: str) -> str {
    delimited(s, "_")
}

pub fn kebab(s: str) -> str {
    delimited(s, "-")
}

pub fn dotted(s: str) -> str {
    delimited(s, ".")
}

pub fn screaming_snake(s: str) -> str {
    unicode.upper(snake(s))
}

pub fn screaming_kebab(s: str) -> str {
    unicode.upper(kebab(s))
}

pub fn pascal(s: str) -> str {
    text.join(capitalised_all(words(s)), "")
}

pub fn camel(s: str) -> str {
    let ws = words(s)
    if ws.len == 0 {
        return ""
    }
    let tail = text.join(capitalised_all(ws[1..]), "")
    "{ws[0]}{tail}"
}

pub fn title(s: str) -> str {
    text.join(capitalised_all(words(s)), " ")
}

pub fn sentence(s: str) -> str {
    let ws = words(s)
    if ws.len == 0 {
        return ""
    }
    if ws.len == 1 {
        return capitalised(ws[0])
    }
    let tail = text.join(ws[1..], " ")
    "{capitalised(ws[0])} {tail}"
}

fn cased_upper(c: u32) -> bool {
    unicode.is_upper(c) || unicode.is_title(c)
}

fn alnum(c: u32) -> bool {
    unicode.is_letter(c) || unicode.is_number(c) || unicode.is_mark(c)
}

fn delimited_by(s: str, sep: u32, allow: fn(u32) -> bool) -> bool {
    if s.len == 0 {
        return false
    }
    var last: u32 = sep
    for c in s {
        if c == sep {
            if last == sep {
                return false
            }
        } else if !allow(c) {
            return false
        }
        last = c
    }
    last != sep
}

fn lower_or_digit(c: u32) -> bool {
    alnum(c) && !cased_upper(c)
}

fn upper_or_digit(c: u32) -> bool {
    alnum(c) && !unicode.is_lower(c)
}

pub fn is_snake(s: str) -> bool {
    delimited_by(s, '_', lower_or_digit)
}

pub fn is_kebab(s: str) -> bool {
    delimited_by(s, '-', lower_or_digit)
}

pub fn is_screaming_snake(s: str) -> bool {
    delimited_by(s, '_', upper_or_digit)
}

fn humped(s: str, first_upper: bool) -> bool {
    if s.len == 0 {
        return false
    }
    var last_upper = false
    var at = 0
    for c in s {
        if !alnum(c) {
            return false
        }
        let up = cased_upper(c)
        if at == 0 && (up != first_upper || !unicode.is_letter(c)) {
            return false
        }
        if up && last_upper {
            return false
        }
        last_upper = up
        at += 1
    }
    true
}

pub fn is_camel(s: str) -> bool {
    humped(s, false)
}

pub fn is_pascal(s: str) -> bool {
    humped(s, true)
}

pub fn is_title(s: str) -> bool {
    s.len > 0 && title(s) == s
}
