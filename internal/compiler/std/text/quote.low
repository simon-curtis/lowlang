pub enum QuoteError {
    NotQuoted
    BadEscape(at: i64)
    BadCodePoint(at: i64)
}

fn append_escaped_byte(mut out: []u8, c: u8) {
    let digits = "0123456789abcdef"
    append(mut out, "\\x")
    push(mut out, digits[c >> 4])
    push(mut out, digits[c & 0xF])
}

fn append_quoted_byte(mut out: []u8, c: u8) {
    match c {
        == '"' => append(mut out, "\\\"")
        == '\\' => append(mut out, "\\\\")
        == '\n' => append(mut out, "\\n")
        == '\t' => append(mut out, "\\t")
        == '\r' => append(mut out, "\\r")
        < 0x20 => append_escaped_byte(mut out, c)
        == 0x7F => append_escaped_byte(mut out, c)
        _ => push(mut out, c)
    }
}

pub fn quote(s: str) -> str {
    var out: []u8 = []
    push(mut out, '"')
    for piece in chars(s) {
        if piece.len > 1 {
            append(mut out, piece)
        } else if piece[0] >= 0x80 {
            append_escaped_byte(mut out, piece[0])
        } else {
            append_quoted_byte(mut out, piece[0])
        }
    }
    push(mut out, '"')
    __str_view(out)
}

fn simple_escape(c: u8) -> i64 {
    match c {
        == 'n' => 10
        == 't' => 9
        == 'r' => 13
        == 'a' => 7
        == 'b' => 8
        == 'f' => 12
        == 'v' => 11
        == '\\' => 92
        == '"' => 34
        == '\'' => 39
        _ => -1
    }
}

fn hex_value(s: str, at: i64, width: i64) -> i64 ! QuoteError {
    if at + width > s.len {
        fail BadEscape(at)
    }
    var n = 0
    for i in at..at + width {
        let d = digit(s[i], 16)
        if d < 0 {
            fail BadEscape(i)
        }
        n = n << 4 | d
    }
    n
}

fn valid_code_point(n: i64) -> bool {
    n < 0x110000 && (n < 0xD800 || n > 0xDFFF)
}

pub fn unquote(s: str) -> str ! QuoteError {
    if s.len < 2 || s[0] != '"' || s[s.len - 1] != '"' {
        fail NotQuoted
    }
    let end = s.len - 1
    var out: []u8 = []
    var i = 1
    for i < end {
        let c = s[i]
        if c == '"' {
            fail NotQuoted
        }
        if c != '\\' {
            push(mut out, c)
            i += 1
            continue
        }
        if i + 1 >= end {
            fail BadEscape(i)
        }
        let kind = s[i + 1]
        let simple = simple_escape(kind)
        if simple >= 0 {
            push(mut out, u8(simple))
            i += 2
        } else if kind == 'x' {
            push(mut out, u8(hex_value(s[..end], i + 2, 2)?))
            i += 4
        } else if kind == 'u' || kind == 'U' {
            let width = if kind == 'u' { 4 } else { 8 }
            let code = hex_value(s[..end], i + 2, width)?
            if !valid_code_point(code) {
                fail BadCodePoint(i)
            }
            append_char(mut out, u32(code))
            i += 2 + width
        } else {
            fail BadEscape(i)
        }
    }
    __str_view(out)
}
