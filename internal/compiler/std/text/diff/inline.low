import std/text
import std/unicode

pub struct Span {
    pub op: Op
    pub text: str
}

fn word_code(c: u32) -> bool {
    unicode.is_alphanumeric(c) || unicode.is_mark(c) || c == '_'
}

fn class_of(c: u32) -> i64 {
    if word_code(c) {
        return 1
    }
    if unicode.is_space(c) {
        return 2
    }
    0
}

pub fn words(s: str) -> []str {
    var out: []str = []
    var start = 0
    var last = -1
    for i, c in s {
        let class = class_of(c)
        if i > 0 && (class == 0 || class != last) {
            push(mut out, s[start..i])
            start = i
        }
        last = class
    }
    if start < s.len {
        push(mut out, s[start..])
    }
    out
}

fn spans_of(before: []str, after: []str) -> []Span {
    let edits = diff_rows(before, after)
    var out: []Span = []
    for e in edits {
        let piece = if e.op == Insert { after[e.new_at] } else { before[e.old_at] }
        if out.len > 0 && out[out.len - 1].op == e.op {
            out[out.len - 1].text = "{out[out.len - 1].text}{piece}"
        } else {
            push(mut out, Span { op: e.op, text: piece })
        }
    }
    out
}

pub fn inline(before: str, after: str) -> []Span {
    spans_of(words(before), words(after))
}

pub fn inline_chars(before: str, after: str) -> []Span {
    spans_of(unicode.graphemes(before), unicode.graphemes(after))
}

pub fn inline_with(spans: []Span, delete_open: str, delete_close: str, insert_open: str, insert_close: str) -> str {
    var out: []u8 = []
    for span in spans {
        match span.op {
            Equal => text.append(mut out, span.text)
            Delete => {
                text.append(mut out, delete_open)
                text.append(mut out, span.text)
                text.append(mut out, delete_close)
            }
            Insert => {
                text.append(mut out, insert_open)
                text.append(mut out, span.text)
                text.append(mut out, insert_close)
            }
        }
    }
    __str_view(out)
}

pub fn inline_markup(spans: []Span) -> str {
    inline_with(spans, "[-", "-]", "{{+", "+}}")
}
