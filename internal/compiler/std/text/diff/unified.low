import std/text

pub struct Hunk {
    pub old_start: i64
    pub old_count: i64
    pub new_start: i64
    pub new_count: i64
    pub edits: []Edit
}

struct Run {
    from: i64
    to: i64
}

fn change_runs(edits: []Edit) -> []Run {
    var runs: []Run = []
    var i = 0
    for i < edits.len {
        if edits[i].op == Equal {
            i += 1
            continue
        }
        let from = i
        for i < edits.len && edits[i].op != Equal {
            i += 1
        }
        push(mut runs, Run { from, to: i })
    }
    runs
}

fn merged_runs(runs: []Run, context: i64) -> []Run {
    var out: []Run = []
    for run in runs {
        if out.len > 0 && run.from - out[out.len - 1].to <= 2 * context {
            out[out.len - 1].to = run.to
        } else {
            push(mut out, run)
        }
    }
    out
}

fn hunk_of(edits: []Edit, run: Run, context: i64) -> Hunk {
    var from = run.from - context
    if from < 0 {
        from = 0
    }
    var to = run.to + context
    if to > edits.len {
        to = edits.len
    }
    let part = edits[from..to]
    var old_count = 0
    var new_count = 0
    for e in part {
        if e.op != Insert {
            old_count += 1
        }
        if e.op != Delete {
            new_count += 1
        }
    }
    Hunk { old_start: part[0].old_at, old_count, new_start: part[0].new_at, new_count, edits: part }
}

pub fn hunks(edits: []Edit, context: i64) -> []Hunk {
    var keep = context
    if keep < 0 {
        keep = 0
    }
    var out: []Hunk = []
    for run in merged_runs(change_runs(edits), keep) {
        push(mut out, hunk_of(edits, run, keep))
    }
    out
}

fn range_text(start: i64, count: i64) -> str {
    if count == 0 {
        return "{start},0"
    }
    if count == 1 {
        return "{start + 1}"
    }
    "{start + 1},{count}"
}

pub fn hunk_header(h: Hunk) -> str {
    let old = range_text(h.old_start, h.old_count)
    let current = range_text(h.new_start, h.new_count)
    "@@ -{old} +{current} @@"
}

fn append_line(mut out: []u8, mark: u8, line: str) {
    push(mut out, mark)
    text.append(mut out, line)
    if line.len == 0 || line[line.len - 1] != '\n' {
        text.append(mut out, "\n\\ No newline at end of file\n")
    }
}

fn append_hunk(mut out: []u8, before: []str, after: []str, h: Hunk) {
    text.append(mut out, hunk_header(h))
    text.append(mut out, "\n")
    for e in h.edits {
        match e.op {
            Equal => append_line(mut out, ' ', before[e.old_at])
            Delete => append_line(mut out, '-', before[e.old_at])
            Insert => append_line(mut out, '+', after[e.new_at])
        }
    }
}

pub fn render(before: []str, after: []str, edits: []Edit, context: i64, before_name: str, after_name: str) -> str {
    let parts = hunks(edits, context)
    if parts.len == 0 {
        return ""
    }
    var out: []u8 = []
    text.append(mut out, "--- {before_name}\n+++ {after_name}\n")
    for h in parts {
        append_hunk(mut out, before, after, h)
    }
    __str_view(out)
}

pub fn unified(before: str, after: str, context: i64, before_name: str, after_name: str) -> str {
    let x = lines(before)
    let y = lines(after)
    let edits = diff_rows(x, y)
    render(x, y, edits, context, before_name, after_name)
}
