import std/text

/// Why a patch could not be applied.
pub enum PatchError {
    /// The patch is not a valid unified diff. `line` is the line of the patch where the problem was found, counting from 1.
    Malformed(line: i64)
    /// A hunk's context and removed lines were not found in the text. `hunk` is the number of the hunk, counting from 1.
    Mismatch(hunk: i64)
}

struct Spec {
    start: i64
    count: i64
}

struct Specs {
    old: Spec
    current: Spec
}

struct Chunk {
    start: i64
    old_lines: []str
    new_lines: []str
}

struct Parsed {
    chunk: Chunk
    next: i64
}

fn default_window() -> i64 {
    1000
}

fn number(s: str, line: i64) -> i64 ! PatchError {
    text.parse_int(s) or fail Malformed(line)
}

fn parse_spec(s: str, line: i64) -> Spec ! PatchError {
    let c = text.cut(s, ",")
    let start = number(c.before, line)?
    if !c.found {
        return Spec { start, count: 1 }
    }
    let count = number(c.after, line)?
    Spec { start, count }
}

fn is_header(row: str) -> bool {
    text.starts_with(row, "@@")
}

fn header_specs(row: str, line: i64) -> Specs ! PatchError {
    if !text.starts_with(row, "@@ -") {
        fail Malformed(line)
    }
    let body = text.trim_end(row[4..])
    let plus = text.index(body, " +")
    let close = text.index(body, " @@")
    if plus < 0 || close < plus + 2 {
        fail Malformed(line)
    }
    let old = parse_spec(body[..plus], line)?
    let current = parse_spec(body[plus + 2..close], line)?
    Specs { old, current }
}

fn body_of(row: str) -> str {
    if row.len == 0 {
        return "\n"
    }
    if row[0] == '\n' {
        return "\n"
    }
    let rest = row[1..]
    if rest.len > 0 && rest[rest.len - 1] == '\n' {
        return rest
    }
    "{rest}\n"
}

fn drop_newline(mut rows: []str) {
    if rows.len == 0 {
        return
    }
    let last = rows[rows.len - 1]
    rows[rows.len - 1] = text.trim_suffix(last, "\n")
}

fn apply_marker(kind: u8, mut old_lines: []str, mut new_lines: []str) {
    if kind == ' ' || kind == '-' {
        drop_newline(mut old_lines)
    }
    if kind == ' ' || kind == '+' {
        drop_newline(mut new_lines)
    }
}

fn parse_hunk(rows: []str, at: i64) -> Parsed ! PatchError {
    let specs = header_specs(rows[at], at + 1)?
    let { old, current } = specs
    var old_lines: []str = []
    var new_lines: []str = []
    var kind: u8 = ' '
    var i = at + 1
    for old_lines.len < old.count || new_lines.len < current.count {
        if i >= rows.len {
            fail Malformed(i)
        }
        let row = rows[i]
        let mark: u8 = if row.len == 0 || row[0] == '\n' { ' ' } else { row[0] }
        if mark == '\\' {
            apply_marker(kind, mut old_lines, mut new_lines)
        } else if mark == ' ' {
            push(mut old_lines, body_of(row))
            push(mut new_lines, body_of(row))
            kind = mark
        } else if mark == '-' {
            push(mut old_lines, body_of(row))
            kind = mark
        } else if mark == '+' {
            push(mut new_lines, body_of(row))
            kind = mark
        } else {
            fail Malformed(i + 1)
        }
        i += 1
    }
    if old_lines.len != old.count || new_lines.len != current.count {
        fail Malformed(i)
    }
    for i < rows.len && text.starts_with(rows[i], "\\") {
        apply_marker(kind, mut old_lines, mut new_lines)
        i += 1
    }
    var start = old.start - 1
    if old.count == 0 {
        start = old.start
    }
    if start < 0 {
        fail Malformed(at + 1)
    }
    Parsed { chunk: Chunk { start, old_lines, new_lines }, next: i }
}

fn parse(patch_text: str) -> []Chunk ! PatchError {
    let rows = lines(patch_text)
    var chunks: []Chunk = []
    var i = 0
    for i < rows.len && !is_header(rows[i]) {
        i += 1
    }
    for i < rows.len && is_header(rows[i]) {
        let parsed = parse_hunk(rows, i)?
        push(mut chunks, parsed.chunk)
        i = parsed.next
    }
    chunks
}

fn matches_at(src: []str, c: Chunk, pos: i64) -> bool {
    if pos < 0 || pos + c.old_lines.len > src.len {
        return false
    }
    for i, row in c.old_lines {
        if src[pos + i] != row {
            return false
        }
    }
    true
}

fn locate(src: []str, c: Chunk, cursor: i64, expected: i64, window: i64) -> i64? {
    for step in 0..window + 1 {
        let later = expected + step
        if later >= cursor && matches_at(src, c, later) {
            return later
        }
        let earlier = expected - step
        if step > 0 && earlier >= cursor && matches_at(src, c, earlier) {
            return earlier
        }
    }
    none
}

fn append_rows(mut out: []u8, rows: []str) {
    for row in rows {
        text.append(mut out, row)
    }
}

/// Applies a unified diff to `before` and returns the result, searching up to `window` lines from where each hunk is expected.
/// Lines before the first `@@` header, such as `---` and `+++`, are ignored. A hunk is expected where the previous hunk's shift leaves its stated start and is searched for outward in both directions, never before the end of the previous hunk, and its context and removed lines must match exactly. `\ No newline at end of file` markers are honoured.
///
/// Fails with `Malformed` when a header or hunk line cannot be read or a hunk has fewer lines than it declares, and with `Mismatch` when a hunk is not found within `window` lines.
pub fn patch_within(before: str, patch_text: str, window: i64) -> str ! PatchError {
    let src = lines(before)
    let chunks = parse(patch_text)?
    var out: []u8 = []
    var cursor = 0
    var drift = 0
    for k, c in chunks {
        let pos = locate(src, c, cursor, c.start + drift, window) ?? fail Mismatch(k + 1)
        append_rows(mut out, src[cursor..pos])
        append_rows(mut out, c.new_lines)
        cursor = pos + c.old_lines.len
        drift = pos - c.start
    }
    append_rows(mut out, src[cursor..])
    __str_view(out)
}

/// Applies a unified diff to `before` and returns the result.
/// Behaves as `patch_within` with a window of 1000 lines.
pub fn patch(before: str, patch_text: str) -> str ! PatchError {
    patch_within(before, patch_text, default_window())?
}
