/// What an `Edit` does to turn the old sequence into the new one.
pub enum Op {
    /// The element is in both sequences and is kept.
    Equal
    /// The element is in the new sequence only and is added.
    Insert
    /// The element is in the old sequence only and is removed.
    Delete
}

/// One step of an edit script.
pub struct Edit {
    /// What the step does.
    pub op: Op
    /// The index in the old sequence: of the element for `Equal` and `Delete`, and the position where an `Insert` happens.
    pub old_at: i64
    /// The index in the new sequence: of the element for `Equal` and `Insert`, and the position where a `Delete` happens.
    pub new_at: i64
}

/// Counts of the edits in a script, as `stats_of` returns them.
pub struct Stats {
    /// The number of `Insert` edits.
    pub added: i64
    /// The number of `Delete` edits.
    pub removed: i64
    /// The number of `Equal` edits.
    pub unchanged: i64
}

struct Search {
    same: fn(i64, i64) -> bool
    removed: []bool
    added: []bool
}

struct Window {
    alo: i64
    ahi: i64
    blo: i64
    bhi: i64
}

struct Split {
    found: bool
    x: i64
    y: i64
}

struct Bisect {
    n: i64
    m: i64
    alo: i64
    blo: i64
    offset: i64
    delta: i64
    odd: bool
    forward: []i64
    reverse: []i64
    f_start: i64
    f_end: i64
    r_start: i64
    r_end: i64
}

fn filled(n: i64, value: i64) -> []i64 {
    var out: []i64 = []
    for i in 0..n {
        push(mut out, value)
    }
    out
}

fn mark_removed(s: *Search, from: i64, to: i64) {
    for i in from..to {
        s.removed[i] = true
    }
}

fn mark_added(s: *Search, from: i64, to: i64) {
    for j in from..to {
        s.added[j] = true
    }
}

fn trimmed(s: *Search, w: Window) -> Window {
    var alo = w.alo
    var ahi = w.ahi
    var blo = w.blo
    var bhi = w.bhi
    for alo < ahi && blo < bhi && s.same(alo, blo) {
        alo += 1
        blo += 1
    }
    for alo < ahi && blo < bhi && s.same(ahi - 1, bhi - 1) {
        ahi -= 1
        bhi -= 1
    }
    Window { alo, ahi, blo, bhi }
}

fn forward_pass(s: *Search, b: *Bisect, d: i64) -> Split {
    var k = -d + b.f_start
    for k < d + 1 - b.f_end {
        let at = b.offset + k
        var x = b.forward[at - 1] + 1
        if k == -d || (k != d && b.forward[at - 1] < b.forward[at + 1]) {
            x = b.forward[at + 1]
        }
        var y = x - k
        for x < b.n && y < b.m && s.same(b.alo + x, b.blo + y) {
            x += 1
            y += 1
        }
        b.forward[at] = x
        if x > b.n {
            b.f_end += 2
        } else if y > b.m {
            b.f_start += 2
        } else if b.odd {
            let other = b.offset + b.delta - k
            if other >= 0 && other < b.reverse.len && b.reverse[other] != -1 && x >= b.n - b.reverse[other] {
                return Split { found: true, x, y }
            }
        }
        k += 2
    }
    Split { found: false, x: 0, y: 0 }
}

fn reverse_pass(s: *Search, b: *Bisect, d: i64) -> Split {
    var k = -d + b.r_start
    for k < d + 1 - b.r_end {
        let at = b.offset + k
        var x = b.reverse[at - 1] + 1
        if k == -d || (k != d && b.reverse[at - 1] < b.reverse[at + 1]) {
            x = b.reverse[at + 1]
        }
        var y = x - k
        for x < b.n && y < b.m && s.same(b.alo + b.n - x - 1, b.blo + b.m - y - 1) {
            x += 1
            y += 1
        }
        b.reverse[at] = x
        if x > b.n {
            b.r_end += 2
        } else if y > b.m {
            b.r_start += 2
        } else if !b.odd {
            let other = b.offset + b.delta - k
            if other >= 0 && other < b.forward.len && b.forward[other] != -1 {
                let fx = b.forward[other]
                if fx >= b.n - x {
                    return Split { found: true, x: fx, y: fx - (b.delta - k) }
                }
            }
        }
        k += 2
    }
    Split { found: false, x: 0, y: 0 }
}

fn bisect(s: *Search, w: Window) -> Split {
    let n = w.ahi - w.alo
    let m = w.bhi - w.blo
    let max_d = (n + m + 1) / 2
    let b = new(Bisect {
        n, m, alo: w.alo, blo: w.blo,
        offset: max_d, delta: n - m, odd: (n - m) % 2 != 0,
        forward: filled(2 * max_d + 2, -1), reverse: filled(2 * max_d + 2, -1),
        f_start: 0, f_end: 0, r_start: 0, r_end: 0
    })
    b.forward[max_d + 1] = 0
    b.reverse[max_d + 1] = 0
    for d in 0..max_d {
        let front = forward_pass(s, b, d)
        if front.found {
            return front
        }
        let back = reverse_pass(s, b, d)
        if back.found {
            return back
        }
    }
    Split { found: false, x: 0, y: 0 }
}

fn compare(s: *Search, outer: Window) {
    let w = trimmed(s, outer)
    if w.alo == w.ahi {
        mark_added(s, w.blo, w.bhi)
        return
    }
    if w.blo == w.bhi {
        mark_removed(s, w.alo, w.ahi)
        return
    }
    let split = bisect(s, w)
    if !split.found {
        mark_removed(s, w.alo, w.ahi)
        mark_added(s, w.blo, w.bhi)
        return
    }
    compare(s, Window { alo: w.alo, ahi: w.alo + split.x, blo: w.blo, bhi: w.blo + split.y })
    compare(s, Window { alo: w.alo + split.x, ahi: w.ahi, blo: w.blo + split.y, bhi: w.bhi })
}

fn script(removed: []bool, added: []bool) -> []Edit {
    var out: []Edit = []
    var i = 0
    var j = 0
    for i < removed.len || j < added.len {
        if i < removed.len && removed[i] {
            push(mut out, Edit { op: Delete, old_at: i, new_at: j })
            i += 1
        } else if j < added.len && added[j] {
            push(mut out, Edit { op: Insert, old_at: i, new_at: j })
            j += 1
        } else {
            push(mut out, Edit { op: Equal, old_at: i, new_at: j })
            i += 1
            j += 1
        }
    }
    out
}

/// Returns the edit script that turns `before` into `after`, with elements compared by `same`.
/// The script is minimal in the number of insertions and deletions, found by Myers' algorithm in linear space. It walks both sequences in order and has one `Equal`, `Insert` or `Delete` for every element, with the deletions of a changed region before its insertions. Two empty sequences give an empty script.
pub fn diff_by[T](before: []T, after: []T, same: fn(T, T) -> bool) -> []Edit {
    let removed: []bool = __make(before.len)
    let added: []bool = __make(after.len)
    let matches = fn(i: i64, j: i64) -> bool { same(before[i], after[j]) }
    let s = new(Search { same: matches, removed, added })
    compare(s, Window { alo: 0, ahi: before.len, blo: 0, bhi: after.len })
    script(removed, added)
}

/// Returns the edit script that turns `before` into `after`, with elements compared by `==`.
/// The script has the properties described for `diff_by`.
pub fn diff[T: Eq](before: []T, after: []T) -> []Edit {
    diff_by(before, after, fn(x: T, y: T) -> bool { x == y })
}

/// Splits `s` into lines that keep their `\n` terminators.
/// The last line has no terminator when `s` does not end in a newline, and an empty `s` gives no lines. Joining the lines gives `s` back.
pub fn lines(s: str) -> []str {
    var out: []str = []
    var start = 0
    for i in 0..s.len {
        if s[i] == '\n' {
            push(mut out, s[start..i + 1])
            start = i + 1
        }
    }
    if start < s.len {
        push(mut out, s[start..])
    }
    out
}

fn intern(table: [str: i64], rows: []str) -> []i64 {
    var out: []i64 = []
    for row in rows {
        let known = table[row] ?? -1
        if known >= 0 {
            push(mut out, known)
        } else {
            let id = table.len
            table[row] = id
            push(mut out, id)
        }
    }
    out
}

/// Returns the edit script that turns the rows `before` into the rows `after`.
/// Rows are compared as whole strings.
pub fn diff_rows(before: []str, after: []str) -> []Edit {
    let table: [str: i64] = [:]
    let x = intern(table, before)
    let y = intern(table, after)
    diff(x, y)
}

/// Returns the line-level edit script that turns `before` into `after`.
/// Lines are split with `lines`, so a line that differs only in its missing final newline counts as changed.
pub fn diff_lines(before: str, after: str) -> []Edit {
    diff_rows(lines(before), lines(after))
}

/// Returns the number of `Insert`, `Delete` and `Equal` edits in `edits`.
pub fn stats_of(edits: []Edit) -> Stats {
    var s = Stats { added: 0, removed: 0, unchanged: 0 }
    for e in edits {
        if e.op == Equal {
            s.unchanged += 1
        } else if e.op == Insert {
            s.added += 1
        } else {
            s.removed += 1
        }
    }
    s
}

/// Returns the line-level `Stats` of changing `before` into `after`.
pub fn stats(before: str, after: str) -> Stats {
    stats_of(diff_lines(before, after))
}

/// Returns the number of insertions and deletions in `edits`.
pub fn distance(edits: []Edit) -> i64 {
    let s = stats_of(edits)
    s.added + s.removed
}

/// Returns how alike `before` and `after` are by lines, from `0.0` to `1.0`.
/// The value is twice the number of unchanged lines divided by the total number of lines in both texts. Two empty texts give `1.0`.
pub fn similarity(before: str, after: str) -> f64 {
    let edits = diff_lines(before, after)
    let s = stats_of(edits)
    let total = 2 * s.unchanged + s.added + s.removed
    if total == 0 {
        return 1.0
    }
    f64(2 * s.unchanged) / f64(total)
}
