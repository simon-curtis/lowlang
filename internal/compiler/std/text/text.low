import std/simd

pub enum ParseError {
    Empty
    BadDigit(at: i64)
    Overflow
}

fn digit(c: u8, base: i64) -> i64 {
    var d = 99
    if c >= '0' && c <= '9' {
        d = i64(c - '0')
    } else if c >= 'a' && c <= 'z' {
        d = i64(c - 'a') + 10
    } else if c >= 'A' && c <= 'Z' {
        d = i64(c - 'A') + 10
    }
    if d < base { d } else { -1 }
}

pub fn parse_uint(s: str, base: i64) -> i64 ! ParseError {
    if s.len == 0 {
        fail Empty
    }
    var n = 0
    for i in 0..s.len {
        let d = digit(s[i], base)
        if d < 0 {
            fail BadDigit(i)
        }
        if n > (0x7FFFFFFFFFFFFFFF - d) / base {
            fail Overflow
        }
        n = n * base + d
    }
    n
}

pub fn parse_radix(s: str, base: i64) -> i64 ! ParseError {
    if s.len == 0 {
        fail Empty
    }
    let negative = s[0] == '-'
    var start = 0
    if negative || s[0] == '+' {
        start = 1
    }
    if start == s.len {
        fail BadDigit(start)
    }
    let min = -9223372036854775807 - 1
    var n = 0
    for i in start..s.len {
        let d = digit(s[i], base)
        if d < 0 {
            fail BadDigit(i)
        }
        if n < (min + d) / base {
            fail Overflow
        }
        n = n * base - d
    }
    if negative {
        return n
    }
    if n == min {
        fail Overflow
    }
    -n
}

pub fn parse_int(s: str) -> i64 ! ParseError {
    parse_radix(s, 10)?
}

pub fn parse_bool(s: str) -> bool ! ParseError {
    match s {
        == "true" => true
        == "false" => false
        == "" => fail Empty
        _ => fail BadDigit(0)
    }
}

pub fn radix(n: i64, base: i64) -> str {
    if n == 0 {
        return "0"
    }
    let symbols = "0123456789abcdefghijklmnopqrstuvwxyz"
    var out: []u8 = []
    var rest = n
    for rest != 0 {
        var d = rest % base
        if d < 0 {
            d = -d
        }
        push(mut out, symbols[d])
        rest /= base
    }
    if n < 0 {
        push(mut out, '-')
    }
    for i in 0..out.len / 2 {
        let j = out.len - 1 - i
        let swap = out[i]
        out[i] = out[j]
        out[j] = swap
    }
    __str_view(out)
}

pub fn hex(n: i64) -> str {
    let digits = "0123456789abcdef"
    var out: []u8 = []
    var shift = 60
    var started = false
    for shift >= 0 {
        let d = n >> shift & 0xF
        if d != 0 || started || shift == 0 {
            push(mut out, digits[d])
            started = true
        }
        shift -= 4
    }
    __str_view(out)
}

pub fn lower_byte(c: u8) -> u8 {
    if c >= 'A' && c <= 'Z' { c + 32 } else { c }
}

pub fn upper_byte(c: u8) -> u8 {
    if c >= 'a' && c <= 'z' { c - 32 } else { c }
}

pub fn upper(s: str) -> str {
    var out: []u8 = []
    for i in 0..s.len {
        push(mut out, upper_byte(s[i]))
    }
    __str_view(out)
}

pub fn lower(s: str) -> str {
    var out: []u8 = []
    for i in 0..s.len {
        push(mut out, lower_byte(s[i]))
    }
    __str_view(out)
}

pub fn equal_fold(a: str, b: str) -> bool {
    if a.len != b.len {
        return false
    }
    for i in 0..a.len {
        if lower_byte(a[i]) != lower_byte(b[i]) {
            return false
        }
    }
    true
}

pub fn space(c: u8) -> bool {
    c == ' ' || c == '\t' || c == '\r' || c == '\n'
}

pub fn trim(s: str) -> str {
    trim_end(trim_start(s))
}

pub fn trim_start(s: str) -> str {
    var start = 0
    for start < s.len && space(s[start]) {
        start += 1
    }
    s[start..]
}

pub fn trim_end(s: str) -> str {
    var end = s.len
    for end > 0 && space(s[end - 1]) {
        end -= 1
    }
    s[..end]
}

pub fn trim_prefix(s: str, prefix: str) -> str {
    if starts_with(s, prefix) {
        return s[prefix.len..]
    }
    s
}

pub fn trim_suffix(s: str, suffix: str) -> str {
    if ends_with(s, suffix) {
        return s[..s.len - suffix.len]
    }
    s
}

pub fn index_byte(s: str, c: u8) -> i64 {
    simd.find_byte_str(s, 0, s.len, c)
}

pub fn last_index_byte(s: str, c: u8) -> i64 {
    var i = s.len - 1
    for i >= 0 {
        if s[i] == c {
            return i
        }
        i -= 1
    }
    -1
}

pub fn index(s: str, sub: str) -> i64 {
    if sub.len == 0 {
        return 0
    }
    var i = 0
    let last = s.len - sub.len + 1
    for i < last {
        let at = simd.find_byte_str(s, i, last, sub[0])
        if at < 0 {
            return -1
        }
        if s[at..at + sub.len] == sub {
            return at
        }
        i = at + 1
    }
    -1
}

pub fn last_index(s: str, sub: str) -> i64 {
    var i = s.len - sub.len
    for i >= 0 {
        if s[i..i + sub.len] == sub {
            return i
        }
        i -= 1
    }
    -1
}

pub fn contains(s: str, sub: str) -> bool {
    index(s, sub) >= 0
}

pub fn count(s: str, sub: str) -> i64 {
    if sub.len == 0 {
        return char_count(s) + 1
    }
    var n = 0
    var from = 0
    for {
        let at = index(s[from..], sub)
        if at < 0 {
            return n
        }
        n += 1
        from += at + sub.len
    }
}

pub fn starts_with(s: str, prefix: str) -> bool {
    s.len >= prefix.len && s[..prefix.len] == prefix
}

pub fn ends_with(s: str, suffix: str) -> bool {
    s.len >= suffix.len && s[s.len - suffix.len..] == suffix
}

pub fn split(s: str, sep: u8) -> []str {
    var parts: []str = []
    var start = 0
    for i in 0..s.len {
        if s[i] == sep {
            push(mut parts, s[start..i])
            start = i + 1
        }
    }
    push(mut parts, s[start..])
    parts
}

pub fn split_str(s: str, sep: str) -> []str {
    if sep.len == 0 {
        return chars(s)
    }
    var parts: []str = []
    var from = 0
    for {
        let at = index(s[from..], sep)
        if at < 0 {
            push(mut parts, s[from..])
            return parts
        }
        push(mut parts, s[from..from + at])
        from += at + sep.len
    }
}

pub fn chars(s: str) -> []str {
    var starts: []i64 = []
    for i, c in s {
        push(mut starts, i)
    }
    var out: []str = []
    for k, start in starts {
        var end = s.len
        if k + 1 < starts.len {
            end = starts[k + 1]
        }
        push(mut out, s[start..end])
    }
    out
}

pub fn fields(s: str) -> []str {
    var out: []str = []
    var i = 0
    for i < s.len {
        for i < s.len && space(s[i]) {
            i += 1
        }
        let start = i
        for i < s.len && !space(s[i]) {
            i += 1
        }
        if i > start {
            push(mut out, s[start..i])
        }
    }
    out
}

pub fn lines(s: str) -> []str {
    var out: []str = []
    var start = 0
    for i in 0..s.len {
        if s[i] == '\n' {
            push(mut out, trim_suffix(s[start..i], "\r"))
            start = i + 1
        }
    }
    if start < s.len {
        push(mut out, trim_suffix(s[start..], "\r"))
    }
    out
}

pub fn repeat(s: str, n: i64) -> str {
    var out: []u8 = []
    for i in 0..n {
        append(mut out, s)
    }
    __str_view(out)
}

pub fn replace(s: str, old: str, new: str) -> str {
    if old.len == 0 {
        return s
    }
    split_str(s, old) |> join(new)
}

pub fn char_count(s: str) -> i64 {
    var n = 0
    for c in s {
        n += 1
    }
    n
}

pub fn from_char(c: u32) -> str {
    var out: []u8 = []
    append_char(mut out, c)
    __str_view(out)
}

pub fn pad_left(s: str, width: i64, fill: u32) -> str {
    var out: []u8 = []
    for i in char_count(s)..width {
        append_char(mut out, fill)
    }
    append(mut out, s)
    __str_view(out)
}

pub fn pad_right(s: str, width: i64, fill: u32) -> str {
    var out: []u8 = []
    append(mut out, s)
    for i in char_count(s)..width {
        append_char(mut out, fill)
    }
    __str_view(out)
}

pub fn join(parts: []str, sep: str) -> str {
    var out: []u8 = []
    for i, p in parts {
        if i > 0 {
            append(mut out, sep)
        }
        append(mut out, p)
    }
    __str_view(out)
}

pub fn append(mut out: []u8, s: str) {
    __extend(mut out, s)
}

pub fn append_char(mut out: []u8, c: u32) {
    if c < 0x80 {
        push(mut out, u8(c))
        return
    }
    if c < 0x800 {
        push(mut out, u8(0xC0 | (c >> 6)))
        push(mut out, u8(0x80 | (c & 0x3F)))
        return
    }
    if c < 0x10000 {
        push(mut out, u8(0xE0 | (c >> 12)))
        push(mut out, u8(0x80 | ((c >> 6) & 0x3F)))
        push(mut out, u8(0x80 | (c & 0x3F)))
        return
    }
    push(mut out, u8(0xF0 | (c >> 18)))
    push(mut out, u8(0x80 | ((c >> 12) & 0x3F)))
    push(mut out, u8(0x80 | ((c >> 6) & 0x3F)))
    push(mut out, u8(0x80 | (c & 0x3F)))
}

pub fn has_token(list: str, token: str) -> bool {
    for part in split(list, ',') {
        if equal_fold(trim(part), token) {
            return true
        }
    }
    false
}

pub fn encode_hex(data: []u8) -> str {
    let digits = "0123456789abcdef"
    let out: []u8 = __make(2 * data.len)
    for i, b in data {
        out[2 * i] = digits[b >> 4]
        out[2 * i + 1] = digits[b & 0xF]
    }
    __str_view(out)
}

pub fn decode_hex(s: str) -> []u8 ! ParseError {
    if s.len % 2 != 0 {
        fail BadDigit(s.len)
    }
    let out: []u8 = __make(s.len / 2)
    for i in 0..out.len {
        let high = digit(s[2 * i], 16)
        let low = digit(s[2 * i + 1], 16)
        if high < 0 || low < 0 {
            fail BadDigit(2 * i)
        }
        out[i] = u8(high << 4 | low)
    }
    out
}
