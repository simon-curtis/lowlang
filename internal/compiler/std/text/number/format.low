import std/text

struct Prefixed {
    text: str
    k: i64
}

fn clamp_places(digits: i64) -> i64 {
    if digits < 0 { 0 } else { digits }
}

pub fn grouped(n: i64, sep: str) -> str {
    let digits = "{magnitude(n)}"
    var out: []u8 = []
    text.append(mut out, sign_of(n))
    for i in 0..digits.len {
        if i > 0 && (digits.len - i) % 3 == 0 {
            text.append(mut out, sep)
        }
        push(mut out, digits[i])
    }
    str(out)
}

fn ordinal_suffix(mag: u64) -> str {
    let tens = mag % 100
    if tens >= 11 && tens <= 13 {
        return "th"
    }
    let last = mag % 10
    if last == 1 {
        return "st"
    }
    if last == 2 {
        return "nd"
    }
    if last == 3 {
        return "rd"
    }
    "th"
}

pub fn ordinal(n: i64) -> str {
    let suffix = ordinal_suffix(magnitude(n))
    "{n}{suffix}"
}

pub fn percent(ratio: f64, digits: i64) -> str {
    let places = clamp_places(digits)
    let value = text.fixed(ratio * 100.0, places)
    "{value}%"
}

pub fn percent_of(part: i64, whole: i64, digits: i64) -> str {
    let ratio = f64(part) / f64(whole)
    percent(ratio, digits)
}

pub fn compact(n: i64) -> str {
    let suffixes = ["", "K", "M", "B", "T", "Qa", "Qi"]
    let scaled = scale(magnitude(n), 1000, 6)
    let sign = sign_of(n)
    let suffix = suffixes[scaled.unit]
    "{sign}{scaled.text}{suffix}"
}

fn floor_third(e: i64) -> i64 {
    if e >= 0 {
        return e / 3
    }
    0 - (0 - e + 2) / 3
}

fn clamp_prefix(k: i64) -> i64 {
    if k < -8 {
        return -8
    }
    if k > 8 {
        return 8
    }
    k
}

fn integer_digits(point: i64) -> i64 {
    if point >= 3 {
        return 3
    }
    if point == 2 {
        return 2
    }
    1
}

fn prefixed(a: f64, digits: i64) -> Prefixed {
    let d = digits_of(a)
    var k = clamp_prefix(floor_third(d.point - 1))
    for {
        let shift = 3 * k
        let point = d.point - shift
        let keep = point + clamp_places(digits - integer_digits(point))
        let r = round_to(d, keep)
        let rounded_point = r.point - shift
        if r.digits.len > 0 && rounded_point > 3 && k < 8 {
            k += 1
        } else {
            return Prefixed { text: render(r, rounded_point), k }
        }
    }
}

fn si_prefix(k: i64) -> str {
    let names = ["y", "z", "a", "f", "p", "n", "µ", "m", "", "k", "M", "G", "T", "P", "E", "Z", "Y"]
    names[k + 8]
}

fn with_unit(number: str, prefix: str, unit: str) -> str {
    if prefix == "" && unit == "" {
        return number
    }
    "{number} {prefix}{unit}"
}

pub fn si_digits(v: f64, unit: str, digits: i64) -> str {
    if v != v {
        return with_unit("NaN", "", unit)
    }
    if v == 0.0 {
        return with_unit("0", "", unit)
    }
    var sign = ""
    var a = v
    if v < 0.0 {
        sign = "-"
        a = -v
    }
    if a > 1.7976931348623157e308 {
        return with_unit("{sign}inf", "", unit)
    }
    let p = prefixed(a, digits)
    with_unit("{sign}{p.text}", si_prefix(p.k), unit)
}

pub fn si(v: f64, unit: str) -> str {
    si_digits(v, unit, 3)
}
