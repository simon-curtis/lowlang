import std/text

fn small_word(n: u64) -> str {
    let names = [
        "zero", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine", "ten", "eleven", "twelve",
        "thirteen", "fourteen", "fifteen", "sixteen", "seventeen", "eighteen", "nineteen"
    ]
    names[i64(n)]
}

fn tens_word(n: u64) -> str {
    let names = ["", "", "twenty", "thirty", "forty", "fifty", "sixty", "seventy", "eighty", "ninety"]
    names[i64(n)]
}

fn below_hundred(n: u64) -> str {
    if n < 20 {
        return small_word(n)
    }
    let tens = tens_word(n / 10)
    if n % 10 == 0 {
        return tens
    }
    let unit = small_word(n % 10)
    "{tens}-{unit}"
}

fn below_thousand(n: u64) -> str {
    if n < 100 {
        return below_hundred(n)
    }
    let hundreds = small_word(n / 100)
    if n % 100 == 0 {
        return "{hundreds} hundred"
    }
    let rest = below_hundred(n % 100)
    "{hundreds} hundred {rest}"
}

fn group_name(index: i64) -> str {
    let names = ["", "thousand", "million", "billion", "trillion", "quadrillion", "quintillion"]
    names[index]
}

fn group_words(mag: u64) -> []str {
    var parts: []str = []
    var rest = mag
    var index = 0
    for rest > 0 {
        let chunk = rest % 1000
        if chunk > 0 {
            let name = group_name(index)
            let chunk_words = below_thousand(chunk)
            if name == "" {
                push(mut parts, chunk_words)
            } else {
                push(mut parts, "{chunk_words} {name}")
            }
        }
        rest = rest / 1000
        index += 1
    }
    var ordered: []str = []
    for i in 0..parts.len {
        push(mut ordered, parts[parts.len - 1 - i])
    }
    ordered
}

/// Returns `n` spelled out in English, such as `forty-two` or `one thousand two hundred`.
/// Tens and units are joined by a hyphen, no `and` is used, a negative `n` starts with `minus`, and `0` is `zero`. Every `i64` is supported.
pub fn words(n: i64) -> str {
    if n == 0 {
        return "zero"
    }
    let body = text.join(group_words(magnitude(n)), " ")
    if n < 0 {
        return "minus {body}"
    }
    body
}
