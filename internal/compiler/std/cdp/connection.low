import std/http/websocket
import std/io
import std/json

/// The error type of the DevTools protocol modules.
pub enum Error {
    /// The browser could not be started or connected to. `cause` is the underlying I/O error.
    Launch(cause: io.Error)
    /// The browser answered a command with an error, or a navigation failed. `message` is the text reported by the browser.
    Protocol(message: str)
    /// The connection to the browser is closed.
    Closed
    /// The browser did not answer in time.
    Timeout
}

/// A DevTools event sent by the browser.
pub struct Event {
    /// The event name, for example `Network.responseReceived`.
    pub method: str
    /// The id of the session the event belongs to, or an empty string for browser-level events.
    pub session: str
    /// The event parameters. `Null` when the event carries none.
    pub params: json.Value
}

/// A WebSocket connection to the DevTools endpoint of a browser.
///
/// A background task reads every message, delivers command replies to the waiting `call` and queues events for `events`. When the socket closes, pending calls fail with `Closed` and the event channel is closed.
pub struct Connection {
    socket: *websocket.SocketHandle
    writing: chan[bool]
    lock: chan[bool]
    next: i64
    waiting: [i64: chan[Reply]]
    events: chan[Event]
    closed: bool
}

struct Reply {
    result: json.Value
    error: str
}

/// Returns a JSON member holding the string `value`.
pub fn text(name: str, value: str) -> json.Member {
    json.Member { name, value: json.Value.Str(value) }
}

/// Returns a JSON member holding the integer `value`.
pub fn integer(name: str, value: i64) -> json.Member {
    json.Member { name, value: json.Value.Int(value) }
}

/// Returns a JSON member holding the boolean `value`.
pub fn flag(name: str, value: bool) -> json.Member {
    json.Member { name, value: json.Value.Bool(value) }
}

/// Returns a JSON member holding an object made of `members`.
pub fn object(name: str, members: []json.Member) -> json.Member {
    json.Member { name, value: json.Value.Object(members) }
}

/// Returns a JSON member holding an array of `items`.
pub fn list(name: str, items: []json.Value) -> json.Member {
    json.Member { name, value: json.Value.Array(items) }
}

/// Returns the string member `name` of the object `v`.
///
/// Returns an empty string when `v` is not an object or has no such member, or the member is not a string. The first member with that name is used.
pub fn field_text(v: json.Value, name: str) -> str {
    match json.get(v, name) {
        some(found) => match found {
            Str(s) => s
            _ => ""
        }
        none => ""
    }
}

/// Returns the integer member `name` of the object `v`.
///
/// A floating point member is truncated. Returns `0` when `v` is not an object or has no such member, or the member is neither an integer nor a float.
pub fn field_int(v: json.Value, name: str) -> i64 {
    match json.get(v, name) {
        some(found) => match found {
            Int(n) => n
            Float(x) => i64(x)
            _ => 0
        }
        none => 0
    }
}

/// Returns the member `name` of the object `v`, or `Null` when `v` is not an object or has no such member.
pub fn field(v: json.Value, name: str) -> json.Value {
    json.get(v, name) ?? json.Value.Null
}

fn connect(url: str) -> *Connection ! io.Error {
    using var dialed = websocket.dial(url)?
    let socket = websocket.detach(mut dialed)
    let c = new(Connection { socket, writing: chan[bool](1), lock: chan[bool](1), next: 1, waiting: [:], events: chan[Event](1024), closed: false })
    spawn pump(c)
    c
}

fn pump(c: *Connection) {
    using ws = websocket.adopt(c.socket)
    for {
        let m = websocket.receive(ws) catch {
            _ => break
        }
        let v = json.parse(m.data) catch {
            _ => continue
        }
        route(c, v)
    }
    shut(c)
}

fn route(c: *Connection, v: json.Value) {
    let id = field_int(v, "id")
    if id == 0 {
        c.events <- Event { method: field_text(v, "method"), session: field_text(v, "sessionId"), params: field(v, "params") }
        return
    }
    c.lock <- true
    let waiter = c.waiting[id]
    delete(mut c.waiting, id)
    <-c.lock
    match waiter {
        some(w) => {
            w <- Reply { result: field(v, "result"), error: field_text(field(v, "error"), "message") }
        }
        none => {}
    }
}

fn shut(c: *Connection) {
    c.lock <- true
    c.closed = true
    let pending = c.waiting
    c.waiting = [:]
    <-c.lock
    for _, w in pending {
        close(w)
    }
    close(c.events)
}

/// Returns the channel that receives the events of every session on the connection.
///
/// The channel holds up to `1024` queued events; while it is full, reading of further replies and events waits. It is closed when the connection closes. Each event is received once, by whichever task reads it.
pub fn events(c: *Connection) -> chan[Event] {
    c.events
}

/// Sends the command `method` with `params` and waits for the reply, returning its `result`.
///
/// An empty `session` addresses the browser itself; otherwise the command goes to that session. A reply without a result gives `Null`. Fails with `Closed` when the connection is closed before or while the command is sent or while waiting, `Protocol(message)` when the browser reports an error, and `Timeout` when there is no reply within `30000` milliseconds. Blocks the calling task until then. Safe to call from several tasks.
pub fn call(c: *Connection, session: str, method: str, params: []json.Member) -> json.Value ! Error {
    let w = chan[Reply](1)
    c.lock <- true
    if c.closed {
        <-c.lock
        fail Closed
    }
    let id = c.next
    c.next += 1
    c.waiting[id] = w
    <-c.lock
    var members = [integer("id", id), text("method", method), object("params", params)]
    if session.len > 0 {
        push(mut members, text("sessionId", session))
    }
    let message = json.stringify(json.Value.Object(members), 0)
    c.writing <- true
    let sent = send(c, message)
    <-c.writing
    if !sent {
        fail Closed
    }
    let reply = select {
        r = <-w => r
        after(30000) => {
            forget(c, id)
            fail Timeout
        }
    }
    match reply {
        some(r) => {
            if r.error.len > 0 {
                fail Protocol(r.error)
            }
            r.result
        }
        none => fail Closed
    }
}

fn send(c: *Connection, message: str) -> bool {
    websocket.send_text_on(c.socket, message) catch {
        _ => return false
    }
    true
}

fn forget(c: *Connection, id: i64) {
    c.lock <- true
    delete(mut c.waiting, id)
    <-c.lock
}

fn disconnect(c: *Connection) {
    websocket.close_on(c.socket, 1000) catch {
        _ => {}
    }
}
