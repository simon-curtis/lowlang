import std/http/websocket
import std/io
import std/json

/// The error type of the DevTools protocol modules.
pub enum Error {
    /// The browser could not be started or connected to. `cause` is the underlying I/O error.
    Launch(cause: io.Error)
    /// The browser answered a command with an error, or a navigation failed. `message` is the text reported by the browser.
    Protocol(message: str)
    /// The connection to the browser is closed.
    Closed
    /// The browser did not answer in time.
    Timeout
}

/// A DevTools event sent by the browser.
pub struct Event {
    /// The event name, for example `Network.responseReceived`.
    pub method: str
    /// The id of the session the event belongs to, or an empty string for browser-level events.
    pub session: str
    /// The event parameters. `Null` when the event carries none.
    pub params: json.Value
}

/// A WebSocket connection to the DevTools endpoint of a browser.
///
/// A background task reads every message, delivers command replies to the waiting `call` and sends every event to each `Subscription`. When the socket closes, pending calls fail with `Closed` and the event channels are closed. A message that is not JSON fails every pending call with `Protocol`.
pub struct Connection {
    socket: *websocket.SocketHandle
    writing: chan[bool]
    lock: chan[bool]
    next: i64
    waiting: [i64: chan[Reply]]
    subscribers: []*Subscription
    closed: bool
}

struct Reply {
    result: json.Value
    error: str
}

fn connect(url: str) -> *Connection ! io.Error {
    using var dialed = websocket.dial(url)?
    let socket = websocket.detach(mut dialed)
    let c = new(Connection { socket, writing: chan[bool](1), lock: chan[bool](1), next: 1, waiting: [:], subscribers: [], closed: false })
    spawn pump(c)
    c
}

fn pump(c: *Connection) {
    using ws = websocket.adopt(c.socket)
    for {
        let m = websocket.receive(ws) or break
        let v = json.parse(m.data) or {
            refuse(c, "unparsable message")
            continue
        }
        route(c, v)
    }
    shut(c)
}

fn refuse(c: *Connection, message: str) {
    c.lock <- true
    let pending = c.waiting
    c.waiting = [:]
    <-c.lock
    for _, w in pending {
        w <- Reply { result: json.Value.Null, error: message }
    }
}

fn deliver(c: *Connection, e: Event) {
    c.lock <- true
    let subscribers = c.subscribers
    <-c.lock
    for s in subscribers {
        select {
            s.events <- e => {}
            <-s.done => {}
        }
    }
}

fn route(c: *Connection, v: json.Value) {
    let id = json.int_of(v, "id")
    if id == 0 {
        deliver(c, Event { method: json.text_of(v, "method"), session: json.text_of(v, "sessionId"), params: json.field(v, "params") })
        return
    }
    c.lock <- true
    let waiter = c.waiting[id]
    delete(mut c.waiting, id)
    <-c.lock
    match waiter {
        some(w) => {
            w <- Reply { result: json.field(v, "result"), error: json.text_of(json.field(v, "error"), "message") }
        }
        none => {}
    }
}

fn shut(c: *Connection) {
    c.lock <- true
    c.closed = true
    let pending = c.waiting
    c.waiting = [:]
    let subscribers = c.subscribers
    c.subscribers = []
    <-c.lock
    for _, w in pending {
        close(w)
    }
    for s in subscribers {
        close(s.events)
    }
}

/// A stream of the events of a connection, made by `subscribe`.
pub struct Subscription {
    /// Receives every event of every session on the connection from the moment of the subscription, in the order the browser sent them. It holds up to `1024` queued events; while it is full, reading of further replies and events waits. It is closed when the connection closes.
    pub events: chan[Event]
    done: chan[bool]
}

/// Returns a new `Subscription` to the events of `c`.
///
/// Every subscription receives every event, so tasks that read different subscriptions do not take events from each other. A subscription made on a closed connection has a closed channel. End it with `unsubscribe` when no longer read.
pub fn subscribe(c: *Connection) -> *Subscription {
    let s = new(Subscription { events: chan[Event](1024), done: chan[bool](1) })
    c.lock <- true
    let open = !c.closed
    if open {
        push(mut c.subscribers, s)
    }
    <-c.lock
    if !open {
        close(s.events)
    }
    s
}

/// Ends the subscription `s`: no further events are sent to it and the channel of `ended` is closed. Safe to call more than once.
pub fn unsubscribe(c: *Connection, s: *Subscription) {
    c.lock <- true
    var kept: []*Subscription = []
    var found = false
    for x in c.subscribers {
        if x == s {
            found = true
        } else {
            push(mut kept, x)
        }
    }
    c.subscribers = kept
    <-c.lock
    if found {
        close(s.done)
    }
}

/// Returns a channel that is closed once `s` has been ended with `unsubscribe`.
pub fn ended(s: *Subscription) -> chan[bool] {
    s.done
}

/// Sends the command `method` with `params` and waits for the reply, returning its `result`.
///
/// An empty `session` addresses the browser itself; otherwise the command goes to that session. A reply without a result gives `Null`. Fails with `Closed` when the connection is closed before or while the command is sent or while waiting, `Protocol(message)` when the browser reports an error, and `Timeout` when there is no reply within `30000` milliseconds. Blocks the calling task until then. Safe to call from several tasks.
pub fn call(c: *Connection, session: str, method: str, params: []json.Member) -> json.Value ! Error {
    let w = chan[Reply](1)
    c.lock <- true
    if c.closed {
        <-c.lock
        fail Closed
    }
    let id = c.next
    c.next += 1
    c.waiting[id] = w
    <-c.lock
    var members = [json.int_member("id", id), json.text_member("method", method), json.object_member("params", params)]
    if session.len > 0 {
        push(mut members, json.text_member("sessionId", session))
    }
    let message = json.stringify(json.object_value(members), 0)
    c.writing <- true
    let sent = send(c, message)
    <-c.writing
    if !sent {
        fail Closed
    }
    let reply = select {
        r = <-w => r
        after(30000) => {
            forget(c, id)
            fail Timeout
        }
    }
    match reply {
        some(r) => {
            if r.error.len > 0 {
                fail Protocol(r.error)
            }
            r.result
        }
        none => fail Closed
    }
}

fn send(c: *Connection, message: str) -> bool {
    websocket.send_text_on(c.socket, message) or return false
    true
}

fn forget(c: *Connection, id: i64) {
    c.lock <- true
    delete(mut c.waiting, id)
    <-c.lock
}

fn disconnect(c: *Connection) {
    websocket.close_on(c.socket, 1000) or {}
}
