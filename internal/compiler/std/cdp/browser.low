import std/file
import std/io
import std/process
import std/text

/// Settings for launching a headless Chromium-based browser.
pub struct Options {
    /// Path of the browser binary. When empty, `launch` searches `PATH` for `chromium`, `chromium-browser`, `google-chrome-stable` and `google-chrome`, in that order.
    pub executable: str = ""
    /// Proxy server passed to the browser as `--proxy-server`. Empty means no proxy.
    pub proxy: str = ""
    /// Extra command line arguments, appended after the built-in headless flags and before the initial `about:blank` page.
    pub args: []str = []
    /// Milliseconds to wait for the browser to announce its DevTools endpoint. Defaults to `20000`.
    pub startup: i64 = 20000
}

/// A shared reference to a running browser, for use from several tasks.
///
/// Owns the browser process and its temporary profile directory. `shutdown_on` stops the process and removes the directory.
pub struct BrowserHandle {
    /// The DevTools connection to the browser.
    pub connection: *Connection
    child: *process.ChildHandle
    profile: str
    lock: chan[bool]
    down: bool
}

/// An owned running browser.
///
/// Dropping a `Browser` calls `shutdown_on` on its handle.
pub struct Browser {
    /// The shared handle of the browser.
    pub handle: *BrowserHandle
    drop shutdown_on(handle)
}

struct Starting {
    child: *process.ChildHandle
    profile: str
    handed: bool = false
    drop {
        if !handed {
            discard(child, profile)
        }
    }
}

fn executable(o: Options) -> str {
    if o.executable.len > 0 {
        return o.executable
    }
    for name in ["chromium", "chromium-browser", "google-chrome-stable", "google-chrome"] {
        match process.find(name) {
            some(path) => return path
            none => {}
        }
    }
    ""
}

fn arguments(o: Options, profile: str) -> []str {
    var args = [
        "--headless", "--remote-debugging-port=0", "--user-data-dir={profile}", "--no-first-run",
        "--no-default-browser-check", "--disable-extensions", "--disable-sync", "--mute-audio",
        "--password-store=basic", "--use-mock-keychain",
    ]
    if o.proxy.len > 0 {
        push(mut args, "--proxy-server={o.proxy}")
    }
    for a in o.args {
        push(mut args, a)
    }
    push(mut args, "about:blank")
    args
}

fn announce(errors: io.Stream, found: chan[str]) {
    let r = io.reader(errors)
    var announced = false
    let marker = "DevTools listening on "
    for {
        let line = io.read_line(r) catch {
            _ => break
        }
        let at = text.index(line, marker)
        if !announced && at >= 0 {
            announced = true
            found <- line[at + marker.len..]
        }
    }
    errors.close()
    if !announced {
        close(found)
    }
}

/// Starts a headless browser and connects to it.
///
/// Returns once the browser has announced its DevTools endpoint and the connection is open. Fails with `Launch(NotFound)` when no executable is found, `Launch(TimedOut)` when the endpoint is not announced within `Options.startup` or the browser exits first, and `Launch(error)` for any other failure to create the profile directory, start the process or connect. A failed launch kills the process and removes the profile directory.
pub fn launch(o: Options) -> Browser ! Error {
    let h = launch_handle(o)?
    adopt(h)
}

/// Starts a headless browser like `launch` and returns its handle.
///
/// The caller is responsible for calling `shutdown_on`. Fails with the same errors as `launch`.
pub fn launch_handle(o: Options) -> *BrowserHandle ! Error {
    let path = executable(o)
    if path.len == 0 {
        fail Launch(NotFound)
    }
    let profile = file.temp_dir("low-cdp-") catch {
        e => fail Launch(e)
    }
    let child = process.start_handle(process.Command { program: path, args: arguments(o, profile), stdin: Null, stdout: Null, stderr: Piped, group: true }) catch {
        e => {
            file.remove_all(profile) catch {
                _ => {}
            }
            fail Launch(e)
        }
    }
    using var starting = Starting { child, profile }
    let found = chan[str](1)
    match child.stderr {
        some(s) => {
            spawn announce(s, found)
        }
        none => close(found)
    }
    let url = select {
        u = <-found => u ?? ""
        after(o.startup) => ""
    }
    if url.len == 0 {
        fail Launch(TimedOut)
    }
    let c = connect(url) catch {
        e => fail Launch(e)
    }
    starting.handed = true
    new(BrowserHandle { connection: c, child, profile, lock: chan[bool](1), down: false })
}

/// Wraps a handle in a `Browser` that shuts the browser down when dropped.
pub fn adopt(h: *BrowserHandle) -> Browser {
    Browser { handle: h }
}

fn discard(child: *process.ChildHandle, profile: str) {
    process.kill_on(child, 9) catch {
        _ => {}
    }
    process.wait_on(child) catch {
        _ => process.Exit.Signaled(9)
    }
    file.remove_all(profile) catch {
        _ => {}
    }
}

/// Shuts the browser down. See `shutdown_on`.
pub fn shutdown(b: Browser) {
    shutdown_on(b.handle)
}

/// Closes the DevTools connection, kills the browser process, waits for it to exit and removes the profile directory.
///
/// Safe to call more than once and from several tasks; only the first call has an effect. Errors while stopping the process or removing files are ignored.
pub fn shutdown_on(h: *BrowserHandle) {
    h.lock <- true
    let first = !h.down
    h.down = true
    <-h.lock
    if !first {
        return
    }
    disconnect(h.connection)
    discard(h.child, h.profile)
}
