import std/io

/// The layout of one pixel in an `Image`.
///
/// Samples are interleaved. Eight-bit formats use one byte per channel; 16-bit formats store each sample big-endian.
pub enum Format {
    /// One 8-bit gray channel.
    Gray8
    /// 8-bit gray followed by 8-bit alpha.
    GrayAlpha8
    /// 8-bit red, green and blue.
    Rgb8
    /// 8-bit red, green, blue and alpha.
    Rgba8
    /// One 16-bit gray channel.
    Gray16
    /// 16-bit red, green, blue and alpha.
    Rgba16
}

/// An 8-bit red, green, blue and alpha color, with alpha `255` fully opaque and not premultiplied.
pub struct Rgba {
    /// The red channel.
    pub r: u8
    /// The green channel.
    pub g: u8
    /// The blue channel.
    pub b: u8
    /// The alpha channel, `0` fully transparent and `255` fully opaque.
    pub a: u8
}

/// A raster of pixels in row-major order from the top-left.
///
/// Operations return new images and leave their argument unchanged, except `set`, `fill_rect` and `blend`, which write into the pixels they are given.
pub struct Image {
    /// The width in pixels.
    pub width: i64
    /// The height in pixels.
    pub height: i64
    /// The pixel layout of `pixels`.
    pub format: Format
    /// The number of bytes from the start of one row to the start of the next.
    pub stride: i64
    /// The pixel bytes, `stride * height` of them.
    pub pixels: []u8
}

struct Wide {
    r: i64
    g: i64
    b: i64
    a: i64
}

/// Returns the number of channels in `f`: `1` for gray, `2` for gray with alpha, `3` for `Rgb8` and `4` for `Rgba8` and `Rgba16`.
pub fn channels(f: Format) -> i64 {
    match f {
        Gray8 => 1
        GrayAlpha8 => 2
        Rgb8 => 3
        Rgba8 => 4
        Gray16 => 1
        Rgba16 => 4
    }
}

/// Returns the number of bytes one pixel of `f` takes: the channel count, doubled for the 16-bit formats.
pub fn bytes_per_pixel(f: Format) -> i64 {
    match f {
        Gray16 => 2
        Rgba16 => 8
        _ => channels(f)
    }
}

/// Returns `true` when `f` has an alpha channel: `GrayAlpha8`, `Rgba8` and `Rgba16`.
pub fn has_alpha(f: Format) -> bool {
    match f {
        GrayAlpha8 => true
        Rgba8 => true
        Rgba16 => true
        _ => false
    }
}

fn is_gray(f: Format) -> bool {
    match f {
        Gray8 => true
        GrayAlpha8 => true
        Gray16 => true
        _ => false
    }
}

fn is_wide(f: Format) -> bool {
    match f {
        Gray16 => true
        Rgba16 => true
        _ => false
    }
}

/// Returns a zeroed image of `width` by `height` pixels in `format`, with `stride` equal to `width` times `bytes_per_pixel(format)`.
///
/// A negative size is treated as `0`. A zeroed pixel is black, and transparent when the format has alpha.
pub fn create(width: i64, height: i64, format: Format) -> Image {
    let w = if width < 0 { 0 } else { width }
    let h = if height < 0 { 0 } else { height }
    let stride = w * bytes_per_pixel(format)
    let pixels: []u8 = __make(stride * h)
    Image { width: w, height: h, format, stride, pixels }
}

/// Returns an image that uses `pixels` directly, without copying.
///
/// Fails with `Invalid` when a size is negative or `pixels.len` is not `width * bytes_per_pixel(format) * height`.
pub fn from_pixels(width: i64, height: i64, format: Format, pixels: []u8) -> Image ! io.Error {
    let stride = width * bytes_per_pixel(format)
    if width < 0 || height < 0 || pixels.len != stride * height {
        fail Invalid
    }
    Image { width, height, format, stride, pixels }
}

fn default_max_pixels() -> i64 {
    1 << 26
}

fn checked_create(width: i64, height: i64, format: Format, max_pixels: i64) -> Image ! io.Error {
    if width <= 0 || height <= 0 || width > 1 << 24 || height > 1 << 24 || width * height > max_pixels {
        fail TooLarge
    }
    create(width, height, format)
}

fn luma(r: i64, g: i64, b: i64) -> i64 {
    (r * 19595 + g * 38470 + b * 7471 + 32768) >> 16
}

fn read_wide(img: Image, at: i64) -> Wide {
    let p = img.pixels
    match img.format {
        Gray8 => {
            let v = i64(p[at]) * 257
            Wide { r: v, g: v, b: v, a: 65535 }
        }
        GrayAlpha8 => {
            let v = i64(p[at]) * 257
            Wide { r: v, g: v, b: v, a: i64(p[at + 1]) * 257 }
        }
        Rgb8 => Wide { r: i64(p[at]) * 257, g: i64(p[at + 1]) * 257, b: i64(p[at + 2]) * 257, a: 65535 }
        Rgba8 => Wide { r: i64(p[at]) * 257, g: i64(p[at + 1]) * 257, b: i64(p[at + 2]) * 257, a: i64(p[at + 3]) * 257 }
        Gray16 => {
            let v = i64(p[at]) << 8 | i64(p[at + 1])
            Wide { r: v, g: v, b: v, a: 65535 }
        }
        Rgba16 => Wide {
            r: i64(p[at]) << 8 | i64(p[at + 1])
            g: i64(p[at + 2]) << 8 | i64(p[at + 3])
            b: i64(p[at + 4]) << 8 | i64(p[at + 5])
            a: i64(p[at + 6]) << 8 | i64(p[at + 7])
        }
    }
}

fn narrow(v: i64) -> u8 {
    u8((v * 255 + 32767) / 65535)
}

fn write_wide(img: Image, at: i64, c: Wide) {
    let p = img.pixels
    match img.format {
        Gray8 => {
            p[at] = narrow(luma(c.r, c.g, c.b))
        }
        GrayAlpha8 => {
            p[at] = narrow(luma(c.r, c.g, c.b))
            p[at + 1] = narrow(c.a)
        }
        Rgb8 => {
            p[at] = narrow(c.r)
            p[at + 1] = narrow(c.g)
            p[at + 2] = narrow(c.b)
        }
        Rgba8 => {
            p[at] = narrow(c.r)
            p[at + 1] = narrow(c.g)
            p[at + 2] = narrow(c.b)
            p[at + 3] = narrow(c.a)
        }
        Gray16 => {
            let v = luma(c.r, c.g, c.b)
            p[at] = u8(v >> 8)
            p[at + 1] = u8(v)
        }
        Rgba16 => {
            p[at] = u8(c.r >> 8)
            p[at + 1] = u8(c.r)
            p[at + 2] = u8(c.g >> 8)
            p[at + 3] = u8(c.g)
            p[at + 4] = u8(c.b >> 8)
            p[at + 5] = u8(c.b)
            p[at + 6] = u8(c.a >> 8)
            p[at + 7] = u8(c.a)
        }
    }
}

fn offset(img: Image, x: i64, y: i64) -> i64 {
    y * img.stride + x * bytes_per_pixel(img.format)
}

/// Returns the pixel at `x`, `y` as an 8-bit `Rgba`.
///
/// Gray formats give equal red, green and blue, and formats without alpha give alpha `255`. 16-bit samples are rounded to 8 bits. A position outside the image gives transparent black.
pub fn get(img: Image, x: i64, y: i64) -> Rgba {
    if x < 0 || y < 0 || x >= img.width || y >= img.height {
        return Rgba { r: 0, g: 0, b: 0, a: 0 }
    }
    let c = read_wide(img, offset(img, x, y))
    Rgba { r: narrow(c.r), g: narrow(c.g), b: narrow(c.b), a: narrow(c.a) }
}

/// Writes `c` at `x`, `y`, converting it to the image's format.
///
/// Formats without alpha drop it, and gray formats store the luma of the color. A position outside the image is ignored.
pub fn set(img: Image, x: i64, y: i64, c: Rgba) {
    if x < 0 || y < 0 || x >= img.width || y >= img.height {
        return
    }
    let w = Wide { r: i64(c.r) * 257, g: i64(c.g) * 257, b: i64(c.b) * 257, a: i64(c.a) * 257 }
    write_wide(img, offset(img, x, y), w)
}

/// Returns a copy of `img` in `format`.
///
/// Gray is expanded to equal red, green and blue, color to gray takes the luma, a missing alpha becomes fully opaque and alpha is dropped when the target has none (it is not composited). Converting to the same format returns a plain copy.
pub fn convert(img: Image, format: Format) -> Image {
    if img.format == format {
        return crop(img, 0, 0, img.width, img.height)
    }
    let out = create(img.width, img.height, format)
    let sb = bytes_per_pixel(img.format)
    let db = bytes_per_pixel(format)
    if img.format == Rgba8 && format == Rgb8 || img.format == Rgb8 && format == Rgba8 {
        convert_rgb(img, out)
        return out
    }
    for y in 0..img.height {
        var s = y * img.stride
        var d = y * out.stride
        for _ in 0..img.width {
            write_wide(out, d, read_wide(img, s))
            s += sb
            d += db
        }
    }
    out
}

fn convert_rgb(img: Image, out: Image) {
    let src = img.pixels
    let dst = out.pixels
    let sb = bytes_per_pixel(img.format)
    let db = bytes_per_pixel(out.format)
    for y in 0..img.height {
        var s = y * img.stride
        var d = y * out.stride
        for _ in 0..img.width {
            dst[d] = src[s]
            dst[d + 1] = src[s + 1]
            dst[d + 2] = src[s + 2]
            if db == 4 {
                dst[d + 3] = 255
            }
            s += sb
            d += db
        }
    }
}

/// Returns the `width` by `height` region of `img` whose top-left corner is `x`, `y`.
///
/// The region is clipped to the image, so the result can be smaller than requested, and is empty when nothing remains.
pub fn crop(img: Image, x: i64, y: i64, width: i64, height: i64) -> Image {
    let x0 = clamp(x, 0, img.width)
    let y0 = clamp(y, 0, img.height)
    let x1 = clamp(x + width, x0, img.width)
    let y1 = clamp(y + height, y0, img.height)
    let out = create(x1 - x0, y1 - y0, img.format)
    let bpp = bytes_per_pixel(img.format)
    for row in 0..out.height {
        let s = (y0 + row) * img.stride + x0 * bpp
        __memmove(out.pixels[row * out.stride..(row + 1) * out.stride], img.pixels[s..s + out.stride])
    }
    out
}

fn clamp(v: i64, lo: i64, hi: i64) -> i64 {
    if v < lo { lo } else if v > hi { hi } else { v }
}

fn copy_pixel(dst: []u8, d: i64, src: []u8, s: i64, bpp: i64) {
    for k in 0..bpp {
        dst[d + k] = src[s + k]
    }
}

/// Returns `img` mirrored left to right.
pub fn flip_horizontal(img: Image) -> Image {
    let out = create(img.width, img.height, img.format)
    let bpp = bytes_per_pixel(img.format)
    for y in 0..img.height {
        let row = y * img.stride
        for x in 0..img.width {
            copy_pixel(out.pixels, row + x * bpp, img.pixels, row + (img.width - 1 - x) * bpp, bpp)
        }
    }
    out
}

/// Returns `img` mirrored top to bottom.
pub fn flip_vertical(img: Image) -> Image {
    let out = create(img.width, img.height, img.format)
    for y in 0..img.height {
        let s = (img.height - 1 - y) * img.stride
        __memmove(out.pixels[y * out.stride..(y + 1) * out.stride], img.pixels[s..s + img.stride])
    }
    out
}

/// Returns `img` rotated 90 degrees clockwise, with width and height swapped.
pub fn rotate90(img: Image) -> Image {
    let out = create(img.height, img.width, img.format)
    let bpp = bytes_per_pixel(img.format)
    for y in 0..img.height {
        for x in 0..img.width {
            copy_pixel(out.pixels, x * out.stride + (img.height - 1 - y) * bpp, img.pixels, y * img.stride + x * bpp, bpp)
        }
    }
    out
}

/// Returns `img` rotated 180 degrees.
pub fn rotate180(img: Image) -> Image {
    flip_vertical(flip_horizontal(img))
}

/// Returns `img` rotated 270 degrees clockwise (90 degrees counterclockwise), with width and height swapped.
pub fn rotate270(img: Image) -> Image {
    let out = create(img.height, img.width, img.format)
    let bpp = bytes_per_pixel(img.format)
    for y in 0..img.height {
        for x in 0..img.width {
            copy_pixel(out.pixels, (img.width - 1 - x) * out.stride + y * bpp, img.pixels, y * img.stride + x * bpp, bpp)
        }
    }
    out
}

/// Returns `img` reflected across its main diagonal, so pixel `x`, `y` moves to `y`, `x`, with width and height swapped.
pub fn transpose(img: Image) -> Image {
    let out = create(img.height, img.width, img.format)
    let bpp = bytes_per_pixel(img.format)
    for y in 0..img.height {
        for x in 0..img.width {
            copy_pixel(out.pixels, x * out.stride + y * bpp, img.pixels, y * img.stride + x * bpp, bpp)
        }
    }
    out
}

/// Returns `img` transformed so that it displays upright for the EXIF `orientation` value `1` to `8`.
///
/// `exif_orientation` reads that value from a JPEG. `1` and any value outside `1` to `8` return `img` itself.
pub fn orient(img: Image, orientation: i64) -> Image {
    if orientation == 2 {
        flip_horizontal(img)
    } else if orientation == 3 {
        rotate180(img)
    } else if orientation == 4 {
        flip_vertical(img)
    } else if orientation == 5 {
        transpose(img)
    } else if orientation == 6 {
        rotate90(img)
    } else if orientation == 7 {
        rotate180(transpose(img))
    } else if orientation == 8 {
        rotate270(img)
    } else {
        img
    }
}

/// Sets every pixel in the `width` by `height` rectangle at `x`, `y` to `c`, in place.
///
/// The rectangle is clipped to the image. Alpha is written, not blended.
pub fn fill_rect(img: Image, x: i64, y: i64, width: i64, height: i64, c: Rgba) {
    let x0 = clamp(x, 0, img.width)
    let y0 = clamp(y, 0, img.height)
    let x1 = clamp(x + width, x0, img.width)
    let y1 = clamp(y + height, y0, img.height)
    if x1 == x0 || y1 == y0 {
        return
    }
    let bpp = bytes_per_pixel(img.format)
    let first = offset(img, x0, y0)
    set(img, x0, y0, c)
    for px in x0 + 1..x1 {
        copy_pixel(img.pixels, offset(img, px, y0), img.pixels, first, bpp)
    }
    let span = (x1 - x0) * bpp
    for py in y0 + 1..y1 {
        let d = offset(img, x0, py)
        __memmove(img.pixels[d..d + span], img.pixels[first..first + span])
    }
}

fn over(s: Wide, d: Wide) -> Wide {
    if s.a == 65535 || d.a == 0 {
        return s
    }
    if s.a == 0 {
        return d
    }
    let inv = 65535 - s.a
    let da = (d.a * inv + 32767) / 65535
    let a = s.a + da
    Wide {
        r: (s.r * s.a + d.r * da + a / 2) / a
        g: (s.g * s.a + d.g * da + a / 2) / a
        b: (s.b * s.a + d.b * da + a / 2) / a
        a
    }
}

/// Composites `src` over `dst` with its top-left corner at `x`, `y`, in place.
///
/// Alpha is straight, not premultiplied. The part of `src` outside `dst` is ignored, and `src` and `dst` can have different formats. Where `src` is opaque it replaces the pixel, and where it is transparent `dst` is unchanged.
pub fn blend(dst: Image, src: Image, x: i64, y: i64) {
    let x0 = clamp(x, 0, dst.width)
    let y0 = clamp(y, 0, dst.height)
    let x1 = clamp(x + src.width, x0, dst.width)
    let y1 = clamp(y + src.height, y0, dst.height)
    if dst.format == Rgba8 && src.format == Rgba8 {
        blend_rgba8(dst, src, x, y, x0, y0, x1, y1)
        return
    }
    let sb = bytes_per_pixel(src.format)
    let db = bytes_per_pixel(dst.format)
    for py in y0..y1 {
        var s = (py - y) * src.stride + (x0 - x) * sb
        var d = py * dst.stride + x0 * db
        for _ in x0..x1 {
            write_wide(dst, d, over(read_wide(src, s), read_wide(dst, d)))
            s += sb
            d += db
        }
    }
}

fn blend_rgba8(dst: Image, src: Image, x: i64, y: i64, x0: i64, y0: i64, x1: i64, y1: i64) {
    let sp = src.pixels
    let dp = dst.pixels
    for py in y0..y1 {
        var s = (py - y) * src.stride + (x0 - x) * 4
        var d = py * dst.stride + x0 * 4
        for _ in x0..x1 {
            let sa = i64(sp[s + 3])
            if sa == 255 {
                dp[d] = sp[s]
                dp[d + 1] = sp[s + 1]
                dp[d + 2] = sp[s + 2]
                dp[d + 3] = 255
            } else if sa != 0 {
                let da = (i64(dp[d + 3]) * (255 - sa) + 127) / 255
                let a = sa + da
                for k in 0..3 {
                    dp[d + k] = u8((i64(sp[s + k]) * sa + i64(dp[d + k]) * da + a / 2) / a)
                }
                dp[d + 3] = u8(a)
            }
            s += 4
            d += 4
        }
    }
}

/// Returns a copy of `img` with the color channels multiplied by alpha.
///
/// An image without an alpha channel is returned as a plain copy.
pub fn premultiply(img: Image) -> Image {
    let out = crop(img, 0, 0, img.width, img.height)
    if !has_alpha(img.format) {
        return out
    }
    let bpp = bytes_per_pixel(img.format)
    for y in 0..img.height {
        var at = y * img.stride
        for _ in 0..img.width {
            let c = read_wide(img, at)
            let a = c.a
            write_wide(out, at, Wide { r: (c.r * a + 32767) / 65535, g: (c.g * a + 32767) / 65535, b: (c.b * a + 32767) / 65535, a })
            at += bpp
        }
    }
    out
}

/// Returns a copy of `img` with the color channels divided by alpha, the inverse of `premultiply`.
///
/// Pixels with alpha `0` or full alpha are left as they are. An image without an alpha channel is returned as a plain copy.
pub fn unpremultiply(img: Image) -> Image {
    let out = crop(img, 0, 0, img.width, img.height)
    if !has_alpha(img.format) {
        return out
    }
    let bpp = bytes_per_pixel(img.format)
    for y in 0..img.height {
        var at = y * img.stride
        for _ in 0..img.width {
            let c = read_wide(img, at)
            let a = c.a
            if a > 0 && a < 65535 {
                let r = clamp((c.r * 65535 + a / 2) / a, 0, 65535)
                let g = clamp((c.g * 65535 + a / 2) / a, 0, 65535)
                let b = clamp((c.b * 65535 + a / 2) / a, 0, 65535)
                write_wide(out, at, Wide { r, g, b, a })
            }
            at += bpp
        }
    }
    out
}
