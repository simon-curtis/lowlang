import std/compress/deflate
import std/hash
import std/io

struct PngHeader {
    width: i64
    height: i64
    depth: i64
    color: i64
    interlace: i64
    channels: i64
    palette: []u8
    transparent: bool
    key_r: i64
    key_g: i64
    key_b: i64
}

struct PngPass {
    x0: i64
    y0: i64
    dx: i64
    dy: i64
    width: i64
    height: i64
}

fn png_signature(data: []u8) -> bool {
    data.len >= 8 && data[0] == 0x89 && data[1] == 'P' && data[2] == 'N' && data[3] == 'G' && data[4] == 0x0D && data[5] == 0x0A && data[6] == 0x1A && data[7] == 0x0A
}

fn png_channels(color: i64) -> i64 {
    if color == 2 {
        3
    } else if color == 4 {
        2
    } else if color == 6 {
        4
    } else {
        1
    }
}

fn png_valid_depth(color: i64, depth: i64) -> bool {
    if color == 0 {
        depth == 1 || depth == 2 || depth == 4 || depth == 8 || depth == 16
    } else if color == 3 {
        depth == 1 || depth == 2 || depth == 4 || depth == 8
    } else if color == 2 || color == 4 || color == 6 {
        depth == 8 || depth == 16
    } else {
        false
    }
}

fn png_format(h: PngHeader) -> Format {
    if h.depth == 16 {
        if h.color == 0 && !h.transparent { Format.Gray16 } else { Format.Rgba16 }
    } else if h.color == 0 {
        if h.transparent { Format.GrayAlpha8 } else { Format.Gray8 }
    } else if h.color == 4 {
        Format.GrayAlpha8
    } else if h.color == 6 {
        Format.Rgba8
    } else if h.transparent {
        Format.Rgba8
    } else {
        Format.Rgb8
    }
}

fn png_row_bytes(h: PngHeader, width: i64) -> i64 {
    (width * h.channels * h.depth + 7) / 8
}

fn png_passes(h: PngHeader) -> []PngPass {
    if h.interlace == 0 {
        return [PngPass { x0: 0, y0: 0, dx: 1, dy: 1, width: h.width, height: h.height }]
    }
    let xs = [0, 4, 0, 2, 0, 1, 0]
    let ys = [0, 0, 4, 0, 2, 0, 1]
    let dxs = [8, 8, 4, 4, 2, 2, 1]
    let dys = [8, 8, 8, 4, 4, 2, 2]
    var passes: []PngPass = []
    for i in 0..7 {
        let w = (h.width - xs[i] + dxs[i] - 1) / dxs[i]
        let hh = (h.height - ys[i] + dys[i] - 1) / dys[i]
        push(mut passes, PngPass { x0: xs[i], y0: ys[i], dx: dxs[i], dy: dys[i], width: if w < 0 { 0 } else { w }, height: if hh < 0 { 0 } else { hh } })
    }
    passes
}

fn png_paeth(a: u8, b: u8, c: u8) -> u8 {
    let p = i64(a) + i64(b) - i64(c)
    let pa = if p > i64(a) { p - i64(a) } else { i64(a) - p }
    let pb = if p > i64(b) { p - i64(b) } else { i64(b) - p }
    let pc = if p > i64(c) { p - i64(c) } else { i64(c) - p }
    if pa <= pb && pa <= pc { a } else if pb <= pc { b } else { c }
}

fn png_unfilter(raw: []u8, at: i64, prior: i64, length: i64, bpp: i64) ! io.Error {
    let kind = raw[at]
    let row = at + 1
    let up = prior + 1
    let has_prior = prior >= 0
    if kind == 0 {
        return
    }
    if kind == 1 {
        for i in bpp..length {
            raw[row + i] += raw[row + i - bpp]
        }
    } else if kind == 2 {
        if has_prior {
            for i in 0..length {
                raw[row + i] += raw[up + i]
            }
        }
    } else if kind == 3 {
        for i in 0..length {
            let left = if i >= bpp { i64(raw[row + i - bpp]) } else { 0 }
            let above = if has_prior { i64(raw[up + i]) } else { 0 }
            raw[row + i] += u8((left + above) >> 1)
        }
    } else if kind == 4 {
        for i in 0..length {
            let left: u8 = if i >= bpp { raw[row + i - bpp] } else { 0 }
            let above: u8 = if has_prior { raw[up + i] } else { 0 }
            let corner: u8 = if has_prior && i >= bpp { raw[up + i - bpp] } else { 0 }
            raw[row + i] += png_paeth(left, above, corner)
        }
    } else {
        fail Malformed
    }
}

fn png_emit(h: PngHeader, img: Image, raw: []u8, row: i64, count: i64, y: i64, pass: PngPass) {
    let out = img.pixels
    let bpp = bytes_per_pixel(img.format)
    let step = pass.dx * bpp
    var d = y * img.stride + pass.x0 * bpp
    if pass.dx == 1 && h.channels * h.depth == bpp * 8 && !h.transparent && h.color != 3 {
        __memmove(out[d..d + count * bpp], raw[row..row + count * bpp])
        return
    }
    if h.depth < 8 {
        let mask = (1 << h.depth) - 1
        let scale = 255 / mask
        for x in 0..count {
            let bit = x * h.depth
            let v = i64(raw[row + (bit >> 3)]) >> (8 - h.depth - (bit & 7)) & mask
            if h.color == 3 {
                png_put_palette(h, out, d, v, bpp)
            } else {
                out[d] = u8(v * scale)
                if h.transparent {
                    out[d + 1] = if v == h.key_r { 0 } else { 255 }
                }
            }
            d += step
        }
        return
    }
    if h.depth == 8 {
        var s = row
        for _ in 0..count {
            if h.color == 3 {
                png_put_palette(h, out, d, i64(raw[s]), bpp)
            } else if h.color == 0 {
                out[d] = raw[s]
                if h.transparent {
                    out[d + 1] = if i64(raw[s]) == h.key_r { 0 } else { 255 }
                }
            } else if h.color == 2 {
                out[d] = raw[s]
                out[d + 1] = raw[s + 1]
                out[d + 2] = raw[s + 2]
                if h.transparent {
                    let hit = i64(raw[s]) == h.key_r && i64(raw[s + 1]) == h.key_g && i64(raw[s + 2]) == h.key_b
                    out[d + 3] = if hit { 0 } else { 255 }
                }
            } else {
                for k in 0..h.channels {
                    out[d + k] = raw[s + k]
                }
            }
            s += h.channels
            d += step
        }
        return
    }
    var s = row
    for _ in 0..count {
        if h.color == 0 {
            out[d] = raw[s]
            out[d + 1] = raw[s + 1]
            if h.transparent {
                out[d + 2] = raw[s]
                out[d + 3] = raw[s + 1]
                out[d + 4] = raw[s]
                out[d + 5] = raw[s + 1]
                let a: u8 = if io.be16(raw, s) == h.key_r { 0 } else { 255 }
                out[d + 6] = a
                out[d + 7] = a
            }
        } else if h.color == 2 {
            for k in 0..6 {
                out[d + k] = raw[s + k]
            }
            let hit = h.transparent && io.be16(raw, s) == h.key_r && io.be16(raw, s + 2) == h.key_g && io.be16(raw, s + 4) == h.key_b
            let a: u8 = if hit { 0 } else { 255 }
            out[d + 6] = a
            out[d + 7] = a
        } else if h.color == 4 {
            out[d] = raw[s]
            out[d + 1] = raw[s + 1]
            out[d + 2] = raw[s]
            out[d + 3] = raw[s + 1]
            out[d + 4] = raw[s]
            out[d + 5] = raw[s + 1]
            out[d + 6] = raw[s + 2]
            out[d + 7] = raw[s + 3]
        } else {
            for k in 0..8 {
                out[d + k] = raw[s + k]
            }
        }
        s += h.channels * 2
        d += step
    }
}

fn png_put_palette(h: PngHeader, out: []u8, d: i64, index: i64, bpp: i64) {
    let p = index * 4
    out[d] = h.palette[p]
    out[d + 1] = h.palette[p + 1]
    out[d + 2] = h.palette[p + 2]
    if bpp == 4 {
        out[d + 3] = h.palette[p + 3]
    }
}

fn png_header(data: []u8, at: i64) -> PngHeader ! io.Error {
    let width = io.be32(data, at)
    let height = io.be32(data, at + 4)
    let depth = i64(data[at + 8])
    let color = i64(data[at + 9])
    let interlace = i64(data[at + 12])
    if width == 0 || height == 0 || width > 0x7FFFFFFF || height > 0x7FFFFFFF {
        fail Malformed
    }
    if data[at + 10] != 0 || data[at + 11] != 0 || interlace > 1 || !png_valid_depth(color, depth) {
        fail Malformed
    }
    let palette: []u8 = __make(1024)
    for i in 0..256 {
        palette[i * 4 + 3] = 255
    }
    PngHeader { width, height, depth, color, interlace, channels: png_channels(color), palette, transparent: false, key_r: 0, key_g: 0, key_b: 0 }
}

fn png_transparency(mut h: PngHeader, data: []u8, at: i64, length: i64) ! io.Error {
    if h.color == 3 {
        if length > 256 {
            fail Malformed
        }
        for i in 0..length {
            h.palette[i * 4 + 3] = data[at + i]
        }
        h.transparent = true
    } else if h.color == 0 {
        if length != 2 {
            fail Malformed
        }
        h.key_r = io.be16(data, at)
        h.transparent = true
    } else if h.color == 2 {
        if length != 6 {
            fail Malformed
        }
        h.key_r = io.be16(data, at)
        h.key_g = io.be16(data, at + 2)
        h.key_b = io.be16(data, at + 4)
        h.transparent = true
    } else {
        fail Malformed
    }
}

pub fn decode_png(data: []u8) -> Image ! io.Error {
    png_decode(data, default_max_pixels())
}

fn png_decode(data: []u8, max_pixels: i64) -> Image ! io.Error {
    if !png_signature(data) {
        fail Malformed
    }
    var p = 8
    var seen_header = false
    var h = PngHeader { width: 0, height: 0, depth: 0, color: 0, interlace: 0, channels: 0, palette: [], transparent: false, key_r: 0, key_g: 0, key_b: 0 }
    var parts: []i64 = []
    var total = 0
    var ended = false
    for !ended {
        if p + 12 > data.len {
            fail Malformed
        }
        let length = io.be32(data, p)
        if length > data.len - p - 12 {
            fail Malformed
        }
        let body = p + 8
        let crc = hash.crc32(data[p + 4..body + length])
        if i64(crc) != io.be32(data, body + length) {
            fail Malformed
        }
        let a = data[p + 4]
        let b = data[p + 5]
        let c = data[p + 6]
        let d = data[p + 7]
        if a == 'I' && b == 'H' && c == 'D' && d == 'R' {
            if seen_header || length != 13 {
                fail Malformed
            }
            h = png_header(data, body)?
            seen_header = true
        } else if !seen_header {
            fail Malformed
        } else if a == 'P' && b == 'L' && c == 'T' && d == 'E' {
            if length % 3 != 0 || length > 768 {
                fail Malformed
            }
            for i in 0..length / 3 {
                h.palette[i * 4] = data[body + i * 3]
                h.palette[i * 4 + 1] = data[body + i * 3 + 1]
                h.palette[i * 4 + 2] = data[body + i * 3 + 2]
            }
        } else if a == 't' && b == 'R' && c == 'N' && d == 'S' {
            png_transparency(mut h, data, body, length)?
        } else if a == 'I' && b == 'D' && c == 'A' && d == 'T' {
            push(mut parts, body)
            push(mut parts, length)
            total += length
        } else if a == 'I' && b == 'E' && c == 'N' && d == 'D' {
            ended = true
        } else if a & 0x20 == 0 {
            fail Unsupported
        }
        p = body + length + 4
    }
    if parts.len == 0 {
        fail Malformed
    }
    let img = checked_create(h.width, h.height, png_format(h), max_pixels)?
    let packed: []u8 = __make(total)
    var at = 0
    for i in 0..parts.len / 2 {
        let start = parts[i * 2]
        let length = parts[i * 2 + 1]
        __memmove(packed[at..at + length], data[start..start + length])
        at += length
    }
    let passes = png_passes(h)
    var expected = 0
    for pass in passes {
        if pass.width > 0 && pass.height > 0 {
            expected += pass.height * (1 + png_row_bytes(h, pass.width))
        }
    }
    let raw = deflate.zlib_decompress(packed, expected)?
    if raw.len < expected {
        fail Malformed
    }
    let bpp = if h.channels * h.depth < 8 { 1 } else { h.channels * h.depth / 8 }
    var offset = 0
    for pass in passes {
        if pass.width == 0 || pass.height == 0 {
            continue
        }
        let length = png_row_bytes(h, pass.width)
        var prior = -1
        for y in 0..pass.height {
            png_unfilter(raw, offset, prior, length, bpp)?
            png_emit(h, img, raw, offset + 1, pass.width, pass.y0 + y * pass.dy, pass)
            prior = offset
            offset += length + 1
        }
    }
    img
}

fn png_put_chunk(out: []u8, at: i64, kind: str, body: []u8) -> i64 {
    set_be32(out, at, body.len)
    for i in 0..4 {
        out[at + 4 + i] = kind[i]
    }
    __memmove(out[at + 8..at + 8 + body.len], body)
    let end = at + 8 + body.len
    set_be32(out, end, i64(hash.crc32(out[at + 4..end])))
    end + 4
}

fn png_filter_score(row: []u8) -> i64 {
    var sum = 0
    for b in row {
        sum += if b < 128 { i64(b) } else { 256 - i64(b) }
    }
    sum
}

fn png_filter_row(kind: i64, cur: []u8, prior: []u8, has_prior: bool, bpp: i64, dst: []u8) {
    let n = cur.len
    for i in 0..n {
        let left: u8 = if i >= bpp { cur[i - bpp] } else { 0 }
        let above: u8 = if has_prior { prior[i] } else { 0 }
        let corner: u8 = if has_prior && i >= bpp { prior[i - bpp] } else { 0 }
        let predict: u8 = if kind == 0 {
            0
        } else if kind == 1 {
            left
        } else if kind == 2 {
            above
        } else if kind == 3 {
            u8((i64(left) + i64(above)) >> 1)
        } else {
            png_paeth(left, above, corner)
        }
        dst[i] = cur[i] - predict
    }
}

pub fn encode_png(img: Image) -> []u8 {
    let color = match img.format {
        Gray8 => 0
        Gray16 => 0
        GrayAlpha8 => 4
        Rgb8 => 2
        Rgba8 => 6
        Rgba16 => 6
    }
    let depth = if is_wide(img.format) { 16 } else { 8 }
    let bpp = bytes_per_pixel(img.format)
    let length = img.width * bpp
    let raw: []u8 = __make(img.height * (length + 1))
    let trial: []u8 = __make(length)
    for y in 0..img.height {
        let cur = img.pixels[y * img.stride..y * img.stride + length]
        let prior = if y > 0 { img.pixels[(y - 1) * img.stride..(y - 1) * img.stride + length] } else { cur }
        let dst = raw[y * (length + 1) + 1..(y + 1) * (length + 1)]
        var best = -1
        var best_kind = 0
        for kind in 0..5 {
            png_filter_row(kind, cur, prior, y > 0, bpp, trial)
            let score = png_filter_score(trial)
            if best < 0 || score < best {
                best = score
                best_kind = kind
                __memmove(dst, trial)
            }
        }
        raw[y * (length + 1)] = u8(best_kind)
    }
    let packed = deflate.zlib_compress(raw, 6)
    let header: []u8 = __make(13)
    set_be32(header, 0, img.width)
    set_be32(header, 4, img.height)
    header[8] = u8(depth)
    header[9] = u8(color)
    let out: []u8 = __make(8 + 25 + 12 + packed.len + 12)
    let signature = [0x89, 'P', 'N', 'G', 0x0D, 0x0A, 0x1A, 0x0A]
    for i in 0..8 {
        out[i] = u8(signature[i])
    }
    var at = png_put_chunk(out, 8, "IHDR", header)
    at = png_put_chunk(out, at, "IDAT", packed)
    let empty: []u8 = []
    png_put_chunk(out, at, "IEND", empty)
    out
}
