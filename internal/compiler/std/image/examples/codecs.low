import std/image
import std/io
import std/slices

fn badge() -> image.Image {
    let img = image.create(24, 16, Rgba8)
    image.fill_rect(img, 0, 0, 24, 16, image.Rgba { r: 20, g: 60, b: 160, a: 255 })
    image.fill_rect(img, 4, 4, 16, 8, image.Rgba { r: 250, g: 200, b: 40, a: 255 })
    image.fill_rect(img, 10, 6, 4, 4, image.Rgba { r: 200, g: 30, b: 30, a: 255 })
    img
}

fn same(a: image.Image, b: image.Image) -> bool {
    a.width == b.width && a.height == b.height && slices.equal(a.pixels, b.pixels)
}

fn check(name: str, original: image.Image, data: []u8) {
    let decoded = image.decode(data) or {
        print("{name}: decode failed")
        return
    }
    print("{name}: {decoded.width}x{decoded.height} lossless={same(original, image.convert(decoded, Rgba8))}")
}

/// Encodes one image with every writer in the module and decodes each result back through `image.decode`, which picks the codec from the signature.
fn main() ! io.Error {
    let original = badge()
    check("png", original, image.encode_png(original))
    check("qoi", original, image.encode_qoi(original))
    check("bmp", original, image.encode_bmp(original))

    let palette = image.median_cut(original, 16)
    print("palette colours: {palette.len}")
    check("gif", original, image.encode_gif(original, palette))

    let jpeg = image.decode(image.encode_jpeg(original, 90))?
    let centre = image.get(jpeg, 12, 8)
    print("jpeg: {jpeg.width}x{jpeg.height} centre is reddish={centre.r > 150 && centre.g < 100}")

    check("garbage", original, [1, 2, 3])
}
