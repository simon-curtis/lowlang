/// The resampling filter for `resize`.
pub enum Filter {
    /// Picks the nearest source pixel without interpolation.
    Nearest
    /// Linear interpolation between the two nearest pixels on each axis.
    Bilinear
    /// Catmull-Rom cubic interpolation.
    Bicubic
    /// A Lanczos window of radius 3, the sharpest and slowest filter.
    Lanczos3
}

struct Weights {
    first: []i64
    taps: i64
    values: []f64
}

fn sine(v: f64) -> f64 {
    let tau = 6.283185307179586
    var x = v - tau * floor(v / tau + 0.5)
    let x2 = x * x
    var term = x
    var sum = x
    for n in 1..12 {
        term = -term * x2 / f64((2 * n) * (2 * n + 1))
        sum += term
    }
    sum
}

fn sinc(x: f64) -> f64 {
    if x == 0.0 {
        return 1.0
    }
    let px = 3.141592653589793 * x
    sine(px) / px
}

fn kernel(filter: Filter, t: f64) -> f64 {
    let x = if t < 0.0 { -t } else { t }
    match filter {
        Bilinear => if x < 1.0 { 1.0 - x } else { 0.0 }
        Bicubic => {
            if x < 1.0 {
                (1.5 * x - 2.5) * x * x + 1.0
            } else if x < 2.0 {
                ((-0.5 * x + 2.5) * x - 4.0) * x + 2.0
            } else {
                0.0
            }
        }
        Lanczos3 => if x < 3.0 { sinc(x) * sinc(x / 3.0) } else { 0.0 }
        Nearest => 0.0
    }
}

fn radius(filter: Filter) -> f64 {
    match filter {
        Bilinear => 1.0
        Bicubic => 2.0
        Lanczos3 => 3.0
        Nearest => 0.5
    }
}

fn weights(filter: Filter, from: i64, to: i64) -> Weights {
    let scale = f64(from) / f64(to)
    let stretch = if scale > 1.0 { scale } else { 1.0 }
    let support = radius(filter) * stretch
    let taps = i64(floor(support * 2.0)) + 2
    let first: []i64 = __make(to)
    let values: []f64 = __make(to * taps)
    for o in 0..to {
        let center = (f64(o) + 0.5) * scale - 0.5
        let start = i64(floor(center - support)) + 1
        var total = 0.0
        for k in 0..taps {
            let w = kernel(filter, (f64(start + k) - center) / stretch)
            values[o * taps + k] = w
            total += w
        }
        if total != 0.0 {
            for k in 0..taps {
                values[o * taps + k] = values[o * taps + k] / total
            }
        }
        first[o] = start
    }
    Weights { first, taps, values }
}

fn to_planes(img: Image) -> []f64 {
    let n = img.width * img.height
    let planes: []f64 = __make(n * 4)
    let bpp = bytes_per_pixel(img.format)
    var i = 0
    for y in 0..img.height {
        var at = y * img.stride
        for _ in 0..img.width {
            let c = read_wide(img, at)
            let a = f64(c.a) / 65535.0
            planes[i] = f64(c.r) * a
            planes[i + 1] = f64(c.g) * a
            planes[i + 2] = f64(c.b) * a
            planes[i + 3] = f64(c.a)
            i += 4
            at += bpp
        }
    }
    planes
}

fn rounded(v: f64, hi: f64) -> i64 {
    if v <= 0.0 {
        0
    } else if v >= hi {
        i64(hi)
    } else {
        i64(v + 0.5)
    }
}

fn from_planes(planes: []f64, width: i64, height: i64, format: Format) -> Image {
    let out = create(width, height, format)
    let bpp = bytes_per_pixel(format)
    var i = 0
    for y in 0..height {
        var at = y * out.stride
        for _ in 0..width {
            let a = rounded(planes[i + 3], 65535.0)
            var c = Wide { r: 0, g: 0, b: 0, a }
            if a > 0 {
                let inv = 65535.0 / planes[i + 3]
                c.r = rounded(planes[i] * inv, 65535.0)
                c.g = rounded(planes[i + 1] * inv, 65535.0)
                c.b = rounded(planes[i + 2] * inv, 65535.0)
            }
            write_wide(out, at, c)
            i += 4
            at += bpp
        }
    }
    out
}

fn resample(src: []f64, count: i64, length: i64, out_length: i64, w: Weights) -> []f64 {
    let out: []f64 = __make(count * out_length * 4)
    for line in 0..count {
        let base = line * length * 4
        for o in 0..out_length {
            var r = 0.0
            var g = 0.0
            var b = 0.0
            var a = 0.0
            let start = w.first[o]
            for k in 0..w.taps {
                let weight = w.values[o * w.taps + k]
                if weight != 0.0 {
                    let at = base + clamp(start + k, 0, length - 1) * 4
                    r += src[at] * weight
                    g += src[at + 1] * weight
                    b += src[at + 2] * weight
                    a += src[at + 3] * weight
                }
            }
            let d = (line * out_length + o) * 4
            out[d] = r
            out[d + 1] = g
            out[d + 2] = b
            out[d + 3] = a
        }
    }
    out
}

fn transpose_planes(src: []f64, width: i64, height: i64) -> []f64 {
    let out: []f64 = __make(src.len)
    for y in 0..height {
        for x in 0..width {
            let s = (y * width + x) * 4
            let d = (x * height + y) * 4
            out[d] = src[s]
            out[d + 1] = src[s + 1]
            out[d + 2] = src[s + 2]
            out[d + 3] = src[s + 3]
        }
    }
    out
}

/// Returns `img` scaled to `width` by `height` pixels using `filter`.
///
/// Non-nearest filters resample each axis separately on premultiplied values, so transparent pixels do not bleed color. The format is kept. When `width` or `height` is not positive, or `img` is empty, the result is a zeroed image of the requested size.
pub fn resize(img: Image, width: i64, height: i64, filter: Filter) -> Image {
    if width <= 0 || height <= 0 || img.width == 0 || img.height == 0 {
        return create(width, height, img.format)
    }
    if filter == Nearest {
        return resize_nearest(img, width, height)
    }
    let planes = to_planes(img)
    let across = weights(filter, img.width, width)
    let wide = resample(planes, img.height, img.width, width, across)
    let turned = transpose_planes(wide, width, img.height)
    let down = weights(filter, img.height, height)
    let tall = resample(turned, width, img.height, height, down)
    let upright = transpose_planes(tall, height, width)
    from_planes(upright, width, height, img.format)
}

fn resize_nearest(img: Image, width: i64, height: i64) -> Image {
    let out = create(width, height, img.format)
    let bpp = bytes_per_pixel(img.format)
    let columns: []i64 = __make(width)
    for x in 0..width {
        columns[x] = ((2 * x + 1) * img.width / (2 * width)) * bpp
    }
    for y in 0..height {
        let sy = (2 * y + 1) * img.height / (2 * height)
        let row = sy * img.stride
        var d = y * out.stride
        for x in 0..width {
            copy_pixel(out.pixels, d, img.pixels, row + columns[x], bpp)
            d += bpp
        }
    }
    out
}
