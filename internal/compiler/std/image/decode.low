import std/io

fn starts_with(data: []u8, at: i64, sig: str) -> bool {
    if data.len < at + sig.len {
        return false
    }
    for i in 0..sig.len {
        if data[at + i] != sig[i] {
            return false
        }
    }
    true
}

pub fn decode(data: []u8) -> Image ! io.Error {
    decode_limited(data, default_max_pixels())
}

pub fn decode_limited(data: []u8, max_pixels: i64) -> Image ! io.Error {
    if png_signature(data) {
        return png_decode(data, max_pixels)
    }
    if gif_signature(data) {
        let frames = gif_decode(data, max_pixels, true)?
        return frames[0].image
    }
    if jpeg_signature(data) {
        return jpeg_decode(data, max_pixels)
    }
    if webp_signature(data) {
        return webp_decode(data, max_pixels)
    }
    if starts_with(data, 0, "BM") {
        return bmp_decode(data, max_pixels)
    }
    if starts_with(data, 0, "qoif") {
        return qoi_decode(data, max_pixels)
    }
    fail Unsupported
}
