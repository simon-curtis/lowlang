pub struct DateTime {
    pub year: i64 = 0
    pub month: i64 = 0
    pub day: i64 = 0
    pub hour: i64 = 0
    pub minute: i64 = 0
    pub second: i64 = 0
    pub nanosecond: i64 = 0
    pub offset: i64 = 0
}

pub enum Value {
    Str(str)
    Int(i64)
    Float(f64)
    Bool(bool)
    OffsetDateTime(DateTime)
    LocalDateTime(DateTime)
    LocalDate(DateTime)
    LocalTime(DateTime)
    Array([]Value)
    Table(*Table)
}

pub struct Table {
    pub keys: []str
    pub values: [str: Value]
}

pub enum Error {
    Syntax(line: i64, column: i64, message: str)
}

pub fn new_table() -> *Table {
    new(Table { keys: [], values: [:] })
}

pub fn insert(t: *Table, key: str, v: Value) {
    match t.values[key] {
        some(_) => {}
        none => push(mut t.keys, key)
    }
    t.values[key] = v
}

pub fn get(t: *Table, path: str) -> Value? {
    let parts = match key_path(path) {
        some(found) => found
        none => return none
    }
    var current = t
    for i, part in parts {
        let v = match current.values[part] {
            some(found) => found
            none => return none
        }
        if i == parts.len - 1 {
            return v
        }
        match v {
            Table(inner) => {
                current = inner
            }
            _ => return none
        }
    }
    none
}

pub fn table(t: *Table, path: str) -> *Table? {
    match get(t, path) {
        some(v) => match v {
            Table(inner) => inner
            _ => none
        }
        none => none
    }
}

pub fn text(t: *Table, path: str) -> str? {
    match get(t, path) {
        some(v) => match v {
            Str(s) => s
            _ => none
        }
        none => none
    }
}

pub fn integer(t: *Table, path: str) -> i64? {
    match get(t, path) {
        some(v) => match v {
            Int(n) => n
            _ => none
        }
        none => none
    }
}

pub fn float(t: *Table, path: str) -> f64? {
    match get(t, path) {
        some(v) => match v {
            Float(x) => x
            _ => none
        }
        none => none
    }
}

pub fn boolean(t: *Table, path: str) -> bool? {
    match get(t, path) {
        some(v) => match v {
            Bool(b) => b
            _ => none
        }
        none => none
    }
}

pub fn array(t: *Table, path: str) -> []Value? {
    match get(t, path) {
        some(v) => match v {
            Array(items) => items
            _ => none
        }
        none => none
    }
}

pub fn datetime(t: *Table, path: str) -> DateTime? {
    match get(t, path) {
        some(v) => match v {
            OffsetDateTime(d) => d
            LocalDateTime(d) => d
            LocalDate(d) => d
            LocalTime(d) => d
            _ => none
        }
        none => none
    }
}

pub fn datetime_text(v: Value) -> str? {
    var out: []u8 = []
    match v {
        OffsetDateTime(d) => {
            write_date(mut out, d)
            push(mut out, 'T')
            write_time(mut out, d)
            write_offset(mut out, d.offset)
        }
        LocalDateTime(d) => {
            write_date(mut out, d)
            push(mut out, 'T')
            write_time(mut out, d)
        }
        LocalDate(d) => write_date(mut out, d)
        LocalTime(d) => write_time(mut out, d)
        _ => return none
    }
    __str_view(out)
}

fn write_padded(mut out: []u8, n: i64, width: i64) {
    var digits: []u8 = __make(width)
    var rest = n
    var i = width - 1
    for i >= 0 {
        digits[i] = u8(rest % 10) + '0'
        rest = rest / 10
        i -= 1
    }
    __extend(mut out, __str_view(digits))
}

fn write_date(mut out: []u8, d: DateTime) {
    write_padded(mut out, d.year, 4)
    push(mut out, '-')
    write_padded(mut out, d.month, 2)
    push(mut out, '-')
    write_padded(mut out, d.day, 2)
}

fn write_time(mut out: []u8, d: DateTime) {
    write_padded(mut out, d.hour, 2)
    push(mut out, ':')
    write_padded(mut out, d.minute, 2)
    push(mut out, ':')
    write_padded(mut out, d.second, 2)
    if d.nanosecond == 0 {
        return
    }
    var width = 9
    var fraction = d.nanosecond
    for fraction % 10 == 0 {
        fraction = fraction / 10
        width -= 1
    }
    push(mut out, '.')
    write_padded(mut out, fraction, width)
}

fn write_offset(mut out: []u8, offset: i64) {
    if offset == 0 {
        push(mut out, 'Z')
        return
    }
    var magnitude = offset
    if offset < 0 {
        push(mut out, '-')
        magnitude = -offset
    } else {
        push(mut out, '+')
    }
    write_padded(mut out, magnitude / 60, 2)
    push(mut out, ':')
    write_padded(mut out, magnitude % 60, 2)
}
