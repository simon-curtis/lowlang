import std/serde
import std/toml

struct Database {
    host: str
    port: i64 = 5432
}

struct Settings {
    name: str
    workers: i64
    debug: bool = false
    database: Database
    allowed: []str
    timeout: f64?
}

fn problem(e: serde.Error) -> str {
    match e {
        Syntax(at, message) => "syntax: {message}"
        Mismatch(expected, at) => "expected {expected}"
        Missing(field) => "missing {field}"
        UnknownVariant(name) => "unknown variant {name}"
        Range(at) => "out of range"
        TooDeep => "nested too deeply"
        TooLarge => "too large"
    }
}

fn read(label: str, source: str) {
    let settings = toml.deserialize[Settings](source) catch {
        e => {
            print("{label}: {problem(e)}")
            return
        }
    }
    print("{label}: {settings.name} workers={settings.workers} debug={settings.debug} db={settings.database.host}:{settings.database.port} allowed={settings.allowed.len}")
}

/// Reads typed settings from TOML, writes them back out and reports the errors of bad input.
fn main() {
    read("full", "name = \"svc\"\nworkers = 4\nallowed = [\"a\", \"b\"]\ntimeout = 1.5\n\n[database]\nhost = \"db1\"\nport = 6000\n")
    read("defaults", "name = \"svc\"\nworkers = 1\nallowed = []\n\n[database]\nhost = \"db2\"\n")
    read("missing", "name = \"svc\"\n[database]\nhost = \"db\"\n")
    read("wrong type", "name = \"svc\"\nworkers = \"many\"\nallowed = []\n[database]\nhost = \"db\"\n")
    read("bad text", "name = \n")

    let settings = Settings {
        name: "rendered",
        workers: 2,
        debug: true,
        database: Database { host: "db3" },
        allowed: ["x.example", "y.example"],
        timeout: none,
    }
    let rendered = toml.serialize(settings) catch {
        e => {
            print("serialize: {problem(e)}")
            return
        }
    }
    print(rendered)
}
