import std/toml

/// Reads a manifest with typed accessors, walks an array of tables and writes an edited document back out.
fn main() {
    let source = "title = \"demo\"\nversion = \"1.2.0\"\nreleased = 2025-03-01T09:30:00Z\n\n[server]\nhost = \"localhost\"\nports = [8080, 8081]\nlimits.requests = 100\nlimits.timeout = 2.5\n\n[[plugin]]\nname = \"auth\"\nenabled = true\n\n[[plugin]]\nname = \"cache\"\nenabled = false\n"
    let doc = toml.parse(source) catch {
        Syntax(line, column, message) => {
            print("line {line}, column {column}: {message}")
            return
        }
    }

    print("title {toml.text(doc, "title") ?? "-"}")
    print("host {toml.text(doc, "server.host") ?? "-"}")
    print("requests {toml.integer(doc, "server.limits.requests") ?? -1}")
    print("timeout {toml.float(doc, "server.limits.timeout") ?? -1.0}")
    print("missing {toml.text(doc, "server.user") ?? "-"}")

    let release = toml.get(doc, "released") ?? toml.Value.Bool(false)
    print("released {toml.datetime_text(release) ?? "not a date"}")
    match toml.datetime(doc, "released") {
        some(stamp) => print("year {stamp.year}, offset {stamp.offset} minutes")
        none => print("no date")
    }

    for port in toml.array(doc, "server.ports") ?? [] {
        match port {
            Int(n) => print("port {n}")
            _ => {}
        }
    }
    for plugin in toml.array(doc, "plugin") ?? [] {
        match plugin {
            Table(t) => print("plugin {toml.text(t, "name") ?? "-"} enabled={toml.boolean(t, "enabled") ?? false}")
            _ => {}
        }
    }

    let extra = toml.new_table()
    toml.insert(extra, "name", toml.Value.Str("a \"quoted\" name"))
    toml.insert(extra, "tags", toml.Value.Array([toml.Value.Str("x"), toml.Value.Int(2)]))
    toml.insert(doc, "extra", toml.Value.Table(extra))
    print(toml.encode(doc))

    let bad = toml.parse("a = 1\na = 2\n") catch {
        Syntax(line, column, message) => {
            print("line {line}, column {column}: {message}")
            return
        }
    }
    print("{bad.keys.len} keys")
}
