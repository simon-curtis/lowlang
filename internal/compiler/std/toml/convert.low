import std/base64
import std/serde

fn scalar(v: Value) -> serde.Tree {
    match v {
        Str(s) => serde.Tree.Text(s)
        Int(n) => serde.Tree.Int(n)
        Float(x) => serde.Tree.Float(x)
        Bool(b) => serde.Tree.Bool(b)
        _ => match datetime_text(v) {
            some(s) => serde.Tree.Text(s)
            none => serde.Tree.Opaque
        }
    }
}

fn node_of(v: Value) -> serde.Node {
    match v {
        Array(items) => {
            var out: []serde.Node = []
            for item in items {
                push(mut out, node_of(item))
            }
            serde.Node { tree: serde.Tree.Seq(out) }
        }
        Table(t) => {
            var out: []serde.Member = []
            for k in t.keys {
                match t.values[k] {
                    some(value) => {
                        let key = serde.Node { tree: serde.Tree.Text(k) }
                        push(mut out, serde.Member { key, value: node_of(value) })
                    }
                    none => {}
                }
            }
            serde.Node { tree: serde.Tree.Map(out) }
        }
        _ => serde.Node { tree: scalar(v) }
    }
}

/// Converts the table `t` into a `T` through `std/serde`.
///
/// A struct is read from the table's keys: unknown keys are skipped, a missing key takes the field's default or `none` for an optional, and any other missing key fails with `Missing`. Integers are read from `Int`, floats from `Float` or `Int`, a `[]u8` from a base64 string, and a `str` from a string or from a date or time, which becomes its RFC 3339 text. An enum variant is a string, or a table with one key that names the variant. Fails with `serde.Error.Mismatch` when a value has another type and with `Range` for a negative integer read as unsigned. In errors, `at` counts the values consumed so far.
pub fn from_table[T](t: *Table) -> T ! serde.Error {
    let root = node_of(Table(t))
    serde.read(serde.tree_reader(root, true))
}

/// Parses the TOML text `source` into a `T`.
///
/// Equivalent to `parse` followed by `from_table`. A syntax error becomes `serde.Error.Syntax` whose line is the line of the error and whose message includes the line and column.
pub fn deserialize[T](source: str) -> T ! serde.Error {
    let t = parse(source) catch {
        Syntax(line, column, message) => fail serde.Error.Syntax(line, "{message} at line {line}, column {column}")
    }
    from_table(t)
}

fn element_of(node: serde.Node) -> Value ! serde.Error {
    match value_of(node)? {
        some(v) => v
        none => fail serde.Error.Mismatch("a value in an array, which cannot hold none", 0)
    }
}

fn value_of(node: serde.Node) -> Value? ! serde.Error {
    match node.tree {
        Null => none
        Bool(b) => Value.Bool(b)
        Int(n) => Value.Int(n)
        Uint(_) => fail serde.Error.Range(0)
        Float(x) => Value.Float(x)
        Text(s) => Str(s)
        Binary(data) => Str(base64.encode(data))
        Seq(items) => {
            var out: []Value = []
            for item in items {
                push(mut out, element_of(item)?)
            }
            Value.Array(out)
        }
        Map(members) => {
            let t = new_table()
            for m in members {
                let key = serde.key_text(m.key, 0)?
                match value_of(m.value)? {
                    some(v) => insert(t, key, v)
                    none => {}
                }
            }
            Value.Table(t)
        }
        _ => fail serde.Error.Mismatch("a value that TOML holds", 0)
    }
}

/// Converts `v` into a table through `std/serde`.
///
/// `v` must be a struct or a map, which becomes the table, since TOML documents are tables. A `none` field is left out. A `[]u8` becomes a base64 string and a `u64` above `9223372036854775807` fails with `serde.Error.Range`. Fails with `Mismatch` when `v` is not a table, or an array holds `none`. An enum variant without fields is a string and a variant with fields a table with one key, the variant's name.
pub fn to_table[T](v: T) -> *Table ! serde.Error {
    let root = serde.to_tree(v)
    match value_of(root)? {
        some(top) => match top {
            Table(t) => t
            _ => fail serde.Error.Mismatch("a table at the top level", 0)
        }
        none => fail serde.Error.Mismatch("a table at the top level", 0)
    }
}

/// Returns `v` as TOML text.
///
/// Equivalent to `to_table` followed by `encode`; fails like `to_table`.
pub fn serialize[T](v: T) -> str ! serde.Error {
    let t = to_table(v)?
    encode(t)
}
