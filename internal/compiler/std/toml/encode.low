import std/text

/// Returns the TOML text for the table `t`.
///
/// Keys that hold plain values are written first, as `key = value`, then each sub-table as a `[table]` section and each non-empty array whose elements are all tables as repeated `[[array]]` sections, all in key order and separated by blank lines. Other arrays are written inline as `[1, 2]`, and tables inside them as `{ a = 1 }`. Keys are bare when they hold only letters, digits, `_` and `-`, and quoted otherwise. Strings are written as basic strings with the escapes `\"`, `\\`, `\n`, `\t` and `\r`, and other control characters as `\u00XX`; other characters are written as they are. A float always shows a `.` or exponent, so it reads back as a float, and NaN is written as `nan`. Dates and times use `datetime_text`.
pub fn encode(t: *Table) -> str {
    var out: []u8 = []
    var path: []str = []
    write_body(mut out, t, mut path)
    __str_view(out)
}

fn table_array(v: Value) -> bool {
    match v {
        Array(items) => {
            if items.len == 0 {
                return false
            }
            for item in items {
                match item {
                    Table(_) => {}
                    _ => return false
                }
            }
            true
        }
        _ => false
    }
}

fn section(v: Value) -> bool {
    match v {
        Table(_) => true
        _ => table_array(v)
    }
}

fn write_body(mut out: []u8, t: *Table, mut path: []str) {
    for k in t.keys {
        let v = t.values[k] ?? Bool(false)
        if section(v) {
            continue
        }
        write_key(mut out, k)
        text.append(mut out, " = ")
        write_value(mut out, v)
        push(mut out, '\n')
    }
    for k in t.keys {
        let v = t.values[k] ?? Bool(false)
        push(mut path, k)
        match v {
            Table(inner) => write_section(mut out, inner, mut path, "[", "]")
            Array(items) => {
                if table_array(v) {
                    for item in items {
                        match item {
                            Table(inner) => write_section(mut out, inner, mut path, "[[", "]]")
                            _ => {}
                        }
                    }
                }
            }
            _ => {}
        }
        path = path[..path.len - 1]
    }
}

fn write_section(mut out: []u8, t: *Table, mut path: []str, open: str, close: str) {
    if out.len > 0 {
        push(mut out, '\n')
    }
    text.append(mut out, open)
    for i, part in path {
        if i > 0 {
            push(mut out, '.')
        }
        write_key(mut out, part)
    }
    text.append(mut out, close)
    push(mut out, '\n')
    write_body(mut out, t, mut path)
}

fn write_key(mut out: []u8, k: str) {
    if k.len == 0 {
        text.append(mut out, "\"\"")
        return
    }
    for i in 0..k.len {
        if !bare_key_char(k[i]) {
            write_string(mut out, k)
            return
        }
    }
    text.append(mut out, k)
}

fn write_string(mut out: []u8, s: str) {
    let digits = "0123456789ABCDEF"
    push(mut out, '"')
    for i in 0..s.len {
        let c = s[i]
        if c == '"' {
            text.append(mut out, "\\\"")
        } else if c == '\\' {
            text.append(mut out, "\\\\")
        } else if c == '\n' {
            text.append(mut out, "\\n")
        } else if c == '\t' {
            text.append(mut out, "\\t")
        } else if c == '\r' {
            text.append(mut out, "\\r")
        } else if control(c) {
            text.append(mut out, "\\u00")
            push(mut out, digits[i64(c >> 4)])
            push(mut out, digits[i64(c & 15)])
        } else {
            push(mut out, c)
        }
    }
    push(mut out, '"')
}

fn write_float(mut out: []u8, x: f64) {
    if x != x {
        text.append(mut out, "nan")
        return
    }
    let formatted = "{x}"
    text.append(mut out, formatted)
    for i in 0..formatted.len {
        let c = formatted[i]
        if c == '.' || c == 'e' || c == 'n' {
            return
        }
    }
    text.append(mut out, ".0")
}

fn write_value(mut out: []u8, v: Value) {
    match v {
        Str(s) => write_string(mut out, s)
        Int(n) => text.append(mut out, "{n}")
        Float(x) => write_float(mut out, x)
        Bool(b) => text.append(mut out, if b { "true" } else { "false" })
        Array(items) => {
            push(mut out, '[')
            for i, item in items {
                if i > 0 {
                    text.append(mut out, ", ")
                }
                write_value(mut out, item)
            }
            push(mut out, ']')
        }
        Table(inner) => {
            push(mut out, '{')
            for i, k in inner.keys {
                if i > 0 {
                    push(mut out, ',')
                }
                push(mut out, ' ')
                write_key(mut out, k)
                text.append(mut out, " = ")
                write_value(mut out, inner.values[k] ?? Bool(false))
            }
            if inner.keys.len > 0 {
                push(mut out, ' ')
            }
            push(mut out, '}')
        }
        _ => text.append(mut out, datetime_text(v) ?? "")
    }
}
