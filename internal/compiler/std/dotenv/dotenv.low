import std/file
import std/io
import std/text

/// The error returned when reading or parsing a `.env` file.
pub enum Error {
    /// The file could not be read; `cause` is the I/O error from `std/file`.
    Read(cause: io.Error)
    /// A line that is neither blank, a comment nor a `NAME=value` assignment has no `=`.
    ///
    /// `line` is that line, counting from `1`.
    MissingEquals(line: i64)
    /// The name before `=` is empty or contains a character other than ASCII letters, digits, `_`, `.` and `-`, or starts with a digit, `.` or `-`.
    ///
    /// `line` is that line, counting from `1`.
    BadName(line: i64)
    /// A quoted value is not closed before the end of the input.
    ///
    /// `line` is the line on which the opening quote appears, counting from `1`.
    UnterminatedQuote(line: i64)
}

fn name_char(c: u8, first: bool) -> bool {
    c == '_' || c >= 'A' && c <= 'Z' || c >= 'a' && c <= 'z' || !first && (c >= '0' && c <= '9' || c == '.' || c == '-')
}

fn unescape(c: u8) -> u8 {
    match c {
        == 'n' => '\n'
        == 't' => '\t'
        == 'r' => '\r'
        _ => c
    }
}

struct Cursor {
    src: str
    at: i64
    line: i64
}

fn quoted(c: *Cursor, quote: u8) -> str ! Error {
    let start_line = c.line
    c.at += 1
    var out: []u8 = []
    for c.at < c.src.len {
        let b = c.src[c.at]
        if b == quote {
            c.at += 1
            return str(out)
        }
        if b == '\n' {
            c.line += 1
        }
        if b == '\\' && quote == '"' && c.at + 1 < c.src.len {
            push(mut out, unescape(c.src[c.at + 1]))
            c.at += 2
            continue
        }
        push(mut out, b)
        c.at += 1
    }
    fail UnterminatedQuote(start_line)
}

fn rest_of_line(c: *Cursor) -> str {
    let start = c.at
    for c.at < c.src.len && c.src[c.at] != '\n' {
        c.at += 1
    }
    c.src[start..c.at]
}

fn unquoted(c: *Cursor) -> str {
    let raw = rest_of_line(c)
    var end = raw.len
    for i in 0..raw.len {
        if raw[i] == '#' && (i == 0 || raw[i - 1] == ' ' || raw[i - 1] == '\t') {
            end = i
            break
        }
    }
    text.trim(raw[..end])
}

/// Parses `.env` text into a map from variable name to value.
///
/// Each line is blank, a `#` comment, or `NAME=value` with an optional leading `export `. Whitespace around the name and before the value is ignored. An unquoted value runs to the end of the line, stops at a `#` that starts the value or follows a space or tab, and is trimmed. A value in single quotes is taken literally. A value in double quotes processes `\n`, `\t` and `\r`; any other backslash pair becomes the character after the backslash. Quoted values may span lines, and text after the closing quote on its line is ignored. A name defined twice keeps its last value. Variables are not expanded.
///
/// Fails with `MissingEquals`, `BadName` or `UnterminatedQuote`, each carrying a line number.
pub fn parse(src: str) -> [str: str] ! Error {
    var vars: [str: str] = [:]
    let c = new(Cursor { src: src, at: 0, line: 1 })
    for c.at < src.len {
        let raw = rest_of_line(c)
        let line_start = c.at - raw.len
        let line = text.trim(raw)
        if line.len == 0 || line[0] == '#' {
            if c.at < src.len {
                c.at += 1
                c.line += 1
            }
            continue
        }
        let body = text.trim_start(text.trim_prefix(line, "export "))
        let eq = text.index_byte(body, '=')
        if eq < 0 {
            fail MissingEquals(c.line)
        }
        let name = text.trim(body[..eq])
        if name.len == 0 {
            fail BadName(c.line)
        }
        for i in 0..name.len {
            if !name_char(name[i], i == 0) {
                fail BadName(c.line)
            }
        }
        let offset = text.index_byte(raw, '=') + 1
        c.at = line_start + offset
        for c.at < src.len && (src[c.at] == ' ' || src[c.at] == '\t') {
            c.at += 1
        }
        var value = ""
        if c.at < src.len && (src[c.at] == '"' || src[c.at] == '\'') {
            value = quoted(c, src[c.at])?
            rest_of_line(c)
        } else {
            value = unquoted(c)
        }
        vars[name] = value
        if c.at < src.len {
            c.at += 1
            c.line += 1
        }
    }
    vars
}

/// Reads the file at `path` and parses it as `.env` text.
///
/// Fails with `Read` when the file cannot be read as text, and otherwise with the errors of `parse`.
pub fn read(path: str) -> [str: str] ! Error {
    let src = file.read_text(path) catch {
        e => fail Read(e)
    }
    parse(src)?
}
