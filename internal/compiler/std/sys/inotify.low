import std/io

/// Creates an inotify instance and returns its descriptor, which is non-blocking and closed on `exec`.
pub fn inotify_init() -> i64 ! io.Error {
    io.syscall_result(__syscall(294, 0x80800))
}

/// Adds `path` to the inotify instance `fd` for the events in the bit set `mask` and returns the watch number.
///
/// Watching a path that is already watched replaces its mask and returns the same watch number. Fails with `NotFound` when `path` does not exist.
pub fn inotify_add(fd: i64, path: str, mask: i64) -> i64 ! io.Error {
    io.syscall_result(__syscall(254, fd, cstr(path), mask))
}

/// Removes the watch `wd` from the inotify instance `fd`.
pub fn inotify_remove(fd: i64, wd: i64) ! io.Error {
    io.syscall_result(__syscall(255, fd, wd))?
}
