import std/io

extern "kernel32" {
    fn ExitProcess(code: u32)
    fn SwitchToThread() -> i32
    fn GetCurrentDirectoryW(size: u32, buf: ptr) -> u32
    fn SetCurrentDirectoryW(path: ptr) -> i32
    fn GetComputerNameExW(kind: i32, buf: ptr, mut size: u32) -> i32
    fn GetTickCount64() -> u64
    fn GetProcessAffinityMask(process: i64, mut mask: u64, mut system: u64) -> i32
    fn VirtualQuery(address: i64, info: ptr, size: i64) -> i64
    fn VirtualAlloc(address: i64, size: i64, kind: u32, protect: u32) -> i64
    fn VirtualFree(address: i64, size: i64, kind: u32) -> i32
    fn CreateToolhelp32Snapshot(flags: u32, pid: u32) -> i64
    fn Process32FirstW(snapshot: i64, entry: ptr) -> i32
    fn Process32NextW(snapshot: i64, entry: ptr) -> i32
    fn OpenProcess(access: u32, inherit: i32, pid: u32) -> i64
    fn TerminateProcess(process: i64, code: u32) -> i32
    fn GetExitCodeProcess(process: i64, mut code: u32) -> i32
    fn InitializeProcThreadAttributeList(list: ptr, count: u32, flags: u32, mut size: i64) -> i32
    fn UpdateProcThreadAttribute(list: ptr, flags: u32, attribute: i64, value: ptr, size: i64, previous: ptr, returned: ptr) -> i32
    fn DeleteProcThreadAttributeList(list: ptr)
    fn GetCommandLineW() -> i64
    fn LocalFree(memory: i64) -> i64
    fn lstrlenW(s: i64) -> i32
    fn GetEnvironmentStringsW() -> i64
    fn FreeEnvironmentStringsW(block: i64) -> i32
    fn GetModuleFileNameW(module: i64, buf: ptr, size: u32) -> u32
    fn CreateProcessW(application: ptr, command: ptr, process_attributes: ptr, thread_attributes: ptr, inherit: i32, flags: u32, environment: ptr, dir: ptr, mut startup: StartupInfo, mut info: ProcessInformation) -> i32
}

extern "shell32" {
    fn CommandLineToArgvW(line: i64, mut count: i32) -> i64
}

extern struct StartupInfo {
    size: u32
    reserved: ptr
    desktop: ptr
    title: ptr
    x: u32
    y: u32
    width: u32
    height: u32
    columns: u32
    rows: u32
    fill: u32
    flags: u32
    show: u16
    reserved_size: u16
    reserved_data: ptr
    input: i64
    output: i64
    error: i64
    attributes: ptr
}

extern struct ProcessInformation {
    process: i64
    thread: i64
    pid: u32
    tid: u32
}

fn infinite() -> u32 {
    0xFFFFFFFF
}

fn terminated_code() -> u32 {
    1
}

fn wait_access() -> u32 {
    0x101000
}

fn terminate_access() -> u32 {
    0x1001
}

fn memory(address: i64, size: i64) -> ptr {
    __slice_ptr(__str_raw(address, size))
}

fn words(address: i64, count: i64) -> []i64 {
    let any = memory(address, count * 8)
    let typed: ptr[i64] = any
    view(typed, count)
}

/// Returns the command-line arguments the program started with, the program name first.
pub fn arguments() -> []str {
    var count: i32 = 0
    let table = CommandLineToArgvW(GetCommandLineW(), mut count)
    if table == 0 {
        return []
    }
    var out: []str = []
    for address in words(table, i64(count)) {
        let chars = i64(lstrlenW(address))
        push(mut out, narrow(memory(address, chars * 2), chars))
    }
    LocalFree(table)
    out
}

/// Returns the environment the program started with, as `name=value` entries.
pub fn environment() -> []str {
    let block = GetEnvironmentStringsW()
    if block == 0 {
        return []
    }
    var out: []str = []
    var at = block
    for {
        let chars = i64(lstrlenW(at))
        if chars == 0 {
            break
        }
        let entry = narrow(memory(at, chars * 2), chars)
        if entry[0] != '=' {
            push(mut out, entry)
        }
        at += (chars + 1) * 2
    }
    FreeEnvironmentStringsW(block)
    out
}

/// Returns the path of the running executable.
///
/// Reads `/proc/self/exe` on Linux, which fails with `NotFound` when `/proc` is not mounted.
pub fn executable_path() -> str ! io.Error {
    var size: u32 = 260
    for size <= 32768 {
        let buf = io.buffer(2 * i64(size))
        let n = GetModuleFileNameW(0, __slice_ptr(buf), size)
        if n == 0 {
            fail last_error()
        }
        if n < size {
            return narrow_buffer(buf, i64(n))
        }
        size *= 2
    }
    fail TooLarge
}

/// Returns the process id.
pub fn pid() -> i64 {
    i64(GetCurrentProcessId())
}

fn entry_size() -> i64 {
    568
}

/// Returns the process id of the parent.
pub fn ppid() -> i64 {
    let snapshot = CreateToolhelp32Snapshot(2, 0)
    if snapshot == invalid_handle() {
        return -1
    }
    let own = i64(GetCurrentProcessId())
    let entry = io.buffer(entry_size())
    io.set_le32(entry, 0, entry_size())
    var parent = -1
    var more = Process32FirstW(snapshot, __slice_ptr(entry)) != 0
    for more {
        if io.le32(entry, 8) == own {
            parent = io.le32(entry, 32)
            break
        }
        more = Process32NextW(snapshot, __slice_ptr(entry)) != 0
    }
    CloseHandle(snapshot)
    parent
}

/// Returns the real user id.
pub fn uid() -> i64 {
    -1
}

/// Returns the real group id.
pub fn gid() -> i64 {
    -1
}

/// Returns the effective user id.
pub fn euid() -> i64 {
    -1
}

/// Returns the effective group id.
pub fn egid() -> i64 {
    -1
}

/// Sets the file creation mask to `mask & 0o777` and returns the previous mask.
pub fn umask(mask: i64) -> i64 {
    0
}

/// Ends the process at once with the status `code`, stopping every thread.
pub fn exit_process(code: i64) {
    ExitProcess(u32(code))
}

/// Lets another thread run.
pub fn yield_thread() {
    SwitchToThread()
}

/// Returns the absolute path of the current working directory.
///
/// Fails with `NotFound` if the directory has been removed and with `TooLarge` if the path exceeds 1 MiB.
pub fn getcwd() -> str ! io.Error {
    var size: u32 = 260
    for size <= 524288 {
        let buf = io.buffer(2 * i64(size))
        let n = GetCurrentDirectoryW(size, __slice_ptr(buf))
        if n == 0 {
            fail last_error()
        }
        if n < size {
            return narrow_buffer(buf, i64(n))
        }
        size = n
    }
    fail TooLarge
}

/// Changes the working directory of the whole process to `path`.
pub fn chdir(path: str) ! io.Error {
    checked(SetCurrentDirectoryW(__slice_ptr(wide(path))))?
}

/// Returns the host name of the machine.
pub fn hostname() -> str ! io.Error {
    var size: u32 = 256
    let buf = io.buffer(2 * i64(size))
    checked(GetComputerNameExW(1, __slice_ptr(buf), mut size))?
    narrow_buffer(buf, i64(size))
}

/// Returns the number of seconds the machine has been running.
pub fn uptime() -> i64 ! io.Error {
    i64(GetTickCount64() / 1000)
}

/// Returns the number of CPUs the process may run on, according to its affinity mask.
///
/// Fails with `Invalid` when the mask is empty and with the system error when it cannot be read.
pub fn cpu_count() -> i64 ! io.Error {
    var mask: u64 = 0
    var system: u64 = 0
    checked(GetProcessAffinityMask(GetCurrentProcess(), mut mask, mut system))?
    var n = 0
    var rest = mask
    for rest != 0 {
        n += i64(rest & 1)
        rest >>= 1
    }
    if n == 0 {
        fail Invalid
    }
    n
}

/// Returns whether the page at `address` is mapped.
pub fn is_mapped(address: i64) -> bool {
    let info = io.buffer(48)
    if VirtualQuery(address, __slice_ptr(info), info.len) == 0 {
        return false
    }
    io.le32(info, 32) == 0x1000
}

/// Maps `size` bytes of zeroed, readable and writable memory at exactly `address` and returns the address of the mapping.
///
/// Fails with `Exists` when something is already mapped there. A kernel that ignores the placement can return another address, which the caller must check and `unmap`.
pub fn map_anonymous_at(address: i64, size: i64) -> i64 ! io.Error {
    let mapped = VirtualAlloc(address, size, 0x3000, 4)
    if mapped != 0 {
        return mapped
    }
    let code = i64(GetLastError())
    if code == 487 {
        fail Exists
    }
    fail win_error(code)
}

/// Maps `size` bytes of zeroed memory that can be read, written and executed, and returns its address.
pub fn map_executable(size: i64) -> i64 ! io.Error {
    let mapped = VirtualAlloc(0, size, 0x3000, 0x40)
    if mapped == 0 {
        fail last_error()
    }
    mapped
}

/// Unmaps `size` bytes at `address`.
pub fn unmap(address: i64, size: i64) {
    VirtualFree(address, 0, 0x8000)
}

/// Sets the disposition of signal number `n` to `how`.
pub fn set_disposition(n: i64, how: Disposition) ! io.Error {
    fail Unsupported
}

/// Installs the handler at `handler` for signal number `n`, which returns through `restorer`, and returns the action it replaces.
///
/// The handler runs on the alternate signal stack and interrupted calls restart.
pub fn catch_signal(n: i64, handler: i64, restorer: i64) -> Action ! io.Error {
    fail Unsupported
}

/// Sets the action of signal number `n` to `saved`.
pub fn restore_action(n: i64, saved: Action) ! io.Error {
    fail Unsupported
}

/// Returns x86-64 machine code for a signal handler that writes the signal number as one byte to the descriptor `fd`.
///
/// The code ends with a restorer at `restorer_offset` that returns from the handler. A negative `fd` makes the write fail, which turns the handler into a no-op.
pub fn handler_code(fd: i64) -> []u8 {
    [0xC3]
}

/// Returns the offset in `handler_code` of the code that returns from the handler.
pub fn restorer_offset() -> i64 {
    0
}

/// Returns the address of the handler installed for signal number `n`.
pub fn handler_of(n: i64) -> i64 ! io.Error {
    fail Unsupported
}

fn terminate(process: i64, signal: i64) ! io.Error {
    if signal == 0 {
        return
    }
    checked(TerminateProcess(process, terminated_code()))?
}

/// Sends signal number `signal` to the process `pid`, or to the process group `-pid` when `pid` is negative.
pub fn kill(pid: i64, signal: i64) ! io.Error {
    let target = if pid < 0 { -pid } else { pid }
    let process = opened(OpenProcess(terminate_access(), 0, u32(target)))?
    terminate(process, signal) catch {
        e => {
            CloseHandle(process)
            fail e
        }
    }
    CloseHandle(process)
}

/// Sends signal number `signal` to the calling thread.
pub fn raise(signal: i64) ! io.Error {
    fail Unsupported
}

/// Sends signal number `signal` to the process behind the process descriptor `pidfd`.
pub fn pidfd_send_signal(pidfd: i64, signal: i64) ! io.Error {
    terminate(pidfd, signal)?
}

fn exit_code(process: i64) -> Reaped ! io.Error {
    if WaitForSingleObject(process, infinite()) != 0 {
        fail last_error()
    }
    var code: u32 = 0
    checked(GetExitCodeProcess(process, mut code))?
    Reaped { exited: true, value: i64(code) }
}

/// Waits for the child `pid` to end, reaps it and returns how it ended.
///
/// A `pidfd` of `0` or more is the child's process descriptor, which identifies it without the process id. Blocks the OS thread, so wait for the descriptor to become readable first.
pub fn reap(pidfd: i64, pid: i64) -> Reaped ! io.Error {
    if pidfd >= 0 {
        return exit_code(pidfd)?
    }
    let process = opened(OpenProcess(wait_access(), 0, u32(pid)))?
    let reaped = exit_code(process) catch {
        e => {
            CloseHandle(process)
            fail e
        }
    }
    CloseHandle(process)
    reaped
}

/// Waits for the child `pid` to end without reaping it.
///
/// Blocks the OS thread until the child has ended.
pub fn wait_exit(pid: i64) ! io.Error {
    let process = opened(OpenProcess(wait_access(), 0, u32(pid)))?
    WaitForSingleObject(process, infinite())
    CloseHandle(process)
}

fn quoted(arg: str, mut out: []u8) {
    var special = arg.len == 0
    for c in bytes(arg) {
        if c == ' ' || c == '\t' || c == '"' {
            special = true
        }
    }
    if !special {
        io.append(mut out, bytes(arg))
        return
    }
    push(mut out, '"')
    var slashes = 0
    for c in bytes(arg) {
        if c == '\\' {
            slashes += 1
        } else {
            if c == '"' {
                for _ in 0..slashes + 1 {
                    push(mut out, '\\')
                }
            }
            slashes = 0
        }
        push(mut out, c)
    }
    for _ in 0..slashes {
        push(mut out, '\\')
    }
    push(mut out, '"')
}

fn command_line(argv: []str) -> []u8 {
    var out: []u8 = []
    for i, arg in argv {
        if i > 0 {
            push(mut out, ' ')
        }
        quoted(arg, mut out)
    }
    wide(str(out))
}

fn environment_block(envp: []str) -> []u8 {
    var out: []u8 = []
    for entry in envp {
        let units = wide(entry)
        io.append(mut out, units[..units.len - 2])
    }
    if envp.len == 0 {
        push(mut out, 0)
        push(mut out, 0)
    }
    push(mut out, 0)
    push(mut out, 0)
    out
}

fn inheritable(fd: i64, fallback: i64) -> i64 ! io.Error {
    let source = if fd >= 0 { handle(fd) } else { handle(fallback) }
    if source == 0 || source == invalid_handle() {
        return 0
    }
    var copy: i64 = 0
    let process = GetCurrentProcess()
    checked(DuplicateHandle(process, source, process, mut copy, 0, 1, 2))?
    copy
}

fn close_all(handles: []i64) {
    for h in handles {
        if h != 0 {
            CloseHandle(h)
        }
    }
}

fn attribute_list(handles: []i64) -> []u8 ! io.Error {
    var size: i64 = 0
    InitializeProcThreadAttributeList(null, 1, 0, mut size)
    let list = io.buffer(size)
    checked(InitializeProcThreadAttributeList(__slice_ptr(list), 1, 0, mut size))?
    if UpdateProcThreadAttribute(__slice_ptr(list), 0, 0x20002, __slice_ptr(handles), handles.len * 8, null, null) == 0 {
        let e = last_error()
        DeleteProcThreadAttributeList(__slice_ptr(list))
        fail e
    }
    list
}

fn nonzero(handles: []i64) -> []i64 {
    var out: []i64 = []
    for h in handles {
        if h != 0 && !contains(out, h) {
            push(mut out, h)
        }
    }
    out
}

fn contains(handles: []i64, h: i64) -> bool {
    for other in handles {
        if other == h {
            return true
        }
    }
    false
}

fn create_process(path: str, argv: []str, envp: []str, dir: str, group: bool, handles: []i64) -> ProcessInformation ! io.Error {
    let application = wide(path)
    let command = command_line(argv)
    let environment = environment_block(envp)
    let directory = wide(dir)
    let directory_ptr: ptr = if dir.len > 0 { __slice_ptr(directory) } else { null }
    let inherited = nonzero(handles)
    let list = attribute_list(inherited)?
    var startup = StartupInfo {
        size: 112, reserved: null, desktop: null, title: null,
        x: 0, y: 0, width: 0, height: 0, columns: 0, rows: 0, fill: 0,
        flags: 0x100, show: 0, reserved_size: 0, reserved_data: null,
        input: handles[0], output: handles[1], error: handles[2], attributes: __slice_ptr(list),
    }
    var info = ProcessInformation { process: 0, thread: 0, pid: 0, tid: 0 }
    let flags: u32 = if group { 0x80600 } else { 0x80400 }
    let ok = CreateProcessW(__slice_ptr(application), __slice_ptr(command), null, null, 1, flags, __slice_ptr(environment), directory_ptr, mut startup, mut info)
    let code = GetLastError()
    DeleteProcThreadAttributeList(__slice_ptr(list))
    if ok == 0 {
        fail win_error(i64(code))
    }
    CloseHandle(info.thread)
    info
}

/// Starts the program at `path` in a new process and returns once the program has been executed.
///
/// `argv` is the whole argument vector, program name first, and `envp` is the complete environment as `name=value` entries. A `dir` that is not empty becomes the working directory of the child. With `group` the child starts its own process group. `stdin`, `stdout` and `stderr` are descriptors the child receives as standard streams, and a negative one leaves that stream as the parent's. The parent waits for the child to report on a pipe that closes when the program is executed, so the call parks the green thread until then.
///
/// Fails with the system error when the pipe or the fork fails. An error of `chdir` or `execve` in the child comes back in `Spawned.failure`.
pub fn fork_exec(path: str, argv: []str, envp: []str, dir: str, group: bool, stdin: i64, stdout: i64, stderr: i64) -> Spawned ! io.Error {
    var handles: []i64 = []
    for stream, fd in [stdin, stdout, stderr] {
        let h = inheritable(fd, stream) catch {
            e => {
                close_all(handles)
                fail e
            }
        }
        push(mut handles, h)
    }
    let info = create_process(path, argv, envp, dir, group, handles) catch {
        e => {
            close_all(handles)
            fail e
        }
    }
    close_all(handles)
    Spawned { pid: i64(info.pid), pidfd: info.process, failure: none }
}
