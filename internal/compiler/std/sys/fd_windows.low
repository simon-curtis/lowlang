import std/io

extern "kernel32" {
    fn CreatePipe(mut read_end: i64, mut write_end: i64, attributes: ptr, size: u32) -> i32
    fn PeekNamedPipe(h: i64, buf: ptr, size: u32, read: ptr, mut available: u32, left: ptr) -> i32
    fn WaitForSingleObject(h: i64, millis: u32) -> u32
}

extern "ws2_32" {
    fn closesocket(s: i64) -> i32
    fn ioctlsocket(s: i64, command: i32, mut value: u32) -> i32
    fn getsockopt(s: i64, level: i32, option: i32, value: ptr, mut size: i32) -> i32
}

fn file_type_char() -> u32 {
    2
}

fn file_type_pipe() -> u32 {
    3
}

fn largest_transfer() -> i64 {
    1073741824
}

fn is_socket(fd: i64) -> bool {
    event_of(fd) != 0
}

/// Closes the descriptor number `fd`.
///
/// A negative number stands for no descriptor and is ignored. Errors from the kernel are ignored, because nothing can be done about a descriptor that failed to close.
pub fn close_fd(fd: i64) {
    if fd < 0 {
        return
    }
    if is_socket(fd) {
        discard_input(socket_of(fd))
        closesocket(socket_of(fd))
        CloseHandle(event_of(fd))
        return
    }
    CloseHandle(fd)
}

fn discard_input(s: i64) {
    let buf = io.buffer(4096)
    for win_recv(s, __slice_ptr(buf), i32(buf.len), 0) > 0 {}
}

/// Reads once from the descriptor number `fd` without waiting.
///
/// Fails with `WouldBlock` when `fd` is non-blocking and has no data. An interrupted read is repeated.
pub fn try_read(fd: i64, buf: []u8) -> i64 ! io.Error {
    if buf.len == 0 {
        return 0
    }
    let size = if buf.len < largest_transfer() { buf.len } else { largest_transfer() }
    var done: u32 = 0
    if ReadFile(handle(fd), __slice_ptr(buf), u32(size), mut done, null) != 0 {
        return i64(done)
    }
    let code = i64(GetLastError())
    if code == 109 || code == 38 {
        return 0
    }
    fail win_error(code)
}

/// Writes once to the descriptor number `fd` without waiting.
///
/// Fails with `WouldBlock` when `fd` is non-blocking and cannot take output. An interrupted write is repeated.
pub fn try_write(fd: i64, data: []u8) -> i64 ! io.Error {
    if data.len == 0 {
        return 0
    }
    let size = if data.len < largest_transfer() { data.len } else { largest_transfer() }
    var done: u32 = 0
    checked(WriteFile(handle(fd), __slice_ptr(data), u32(size), mut done, null))?
    i64(done)
}

/// Makes the descriptor number `fd` non-blocking.
///
/// On Windows only a socket becomes non-blocking; a pipe or file stays blocking, and a read from it holds an OS thread until it returns.
pub fn set_nonblocking(fd: i64) ! io.Error {
    if !is_socket(fd) {
        return
    }
    socket_nonblocking(socket_of(fd))?
}

fn socket_nonblocking(s: i64) ! io.Error {
    var on: u32 = 1
    if ioctlsocket(s, -2147195266, mut on) != 0 {
        fail last_error()
    }
}

/// Returns the read end and the write end of a new pipe, both closed on `exec`.
///
/// On Linux the ends are non-blocking when `nonblocking` is `true` and blocking otherwise. On Windows they are always blocking.
pub fn pipe(nonblocking: bool) -> Pair ! io.Error {
    var first: i64 = 0
    var second: i64 = 0
    checked(CreatePipe(mut first, mut second, null, 0))?
    Pair { first, second }
}

/// Returns whether the descriptor number `fd` has data to read or has reached end of input, without waiting.
pub fn readable_now(fd: i64) -> bool {
    let h = handle(fd)
    let kind = GetFileType(h)
    if kind == file_type_char() {
        return WaitForSingleObject(h, 0) == 0
    }
    if kind != file_type_pipe() {
        return true
    }
    var available: u32 = 0
    if PeekNamedPipe(h, null, 0, null, mut available, null) == 0 {
        return true
    }
    available > 0
}

/// Parks the green thread until the descriptor number `fd` may have input or has reached end of input.
///
/// Can return before input arrives, so the caller reads and waits again.
pub fn wait_input(fd: i64) {
    if is_socket(fd) {
        wait_socket(fd, false)
        return
    }
    let h = handle(fd)
    if GetFileType(h) == file_type_char() {
        wait_readable(h)
        return
    }
    sleep(1)
}

fn wait_output(fd: i64) {
    wait_socket(fd, true)
}
