import std/io

/// The kind of socket `socket` makes.
pub enum SocketKind {
    /// A reliable byte stream, as TCP and Unix stream sockets provide.
    Streaming
    /// Unreliable datagrams, as UDP provides.
    Datagrams
}

/// Which direction `shutdown` closes.
pub enum Shutdown {
    /// The sending direction; the peer reads end of input once it has the data sent so far.
    Sending
    /// Both directions; operations waiting on the socket return.
    Both
}

/// A socket option with an integer value, for `set_option` and `get_option`.
pub enum SocketOption {
    /// Lets a restarted program bind a port still in `TIME_WAIT`.
    ReuseAddr
    /// Lets several sockets bind the same port.
    ReusePort
    /// Whether keep-alive probes are sent on a TCP connection.
    KeepAlive
    /// The receive buffer size in bytes.
    ReceiveBuffer
    /// The send buffer size in bytes.
    SendBuffer
    /// Whether a TCP connection sends small writes at once.
    NoDelay
    /// The idle seconds before the first keep-alive probe.
    KeepIdle
    /// The seconds between keep-alive probes.
    KeepInterval
    /// The number of unanswered probes after which a connection is dropped.
    KeepCount
    /// The time to live of outgoing IPv4 multicast datagrams.
    MulticastTtl4
    /// Whether outgoing IPv4 multicast datagrams are delivered to this host too.
    MulticastLoop4
    /// The hop limit of outgoing IPv6 multicast datagrams.
    MulticastTtl6
    /// Whether outgoing IPv6 multicast datagrams are delivered to this host too.
    MulticastLoop6
    /// The interface index outgoing IPv6 multicast datagrams leave through.
    MulticastInterface6
}

/// A connection taken from a listening socket by `accept`.
pub struct Accepted {
    /// The descriptor of the connection, non-blocking and closed on `exec`.
    pub fd: i64
    /// The address of the peer in the system's socket address layout.
    pub address: []u8
}

/// A datagram received by `recv_from`.
pub struct Received {
    /// The number of bytes written into the buffer.
    pub size: i64
    /// The address of the sender in the system's socket address layout.
    pub address: []u8
}

/// The identity of the process at the other end of a Unix socket.
pub struct Credentials {
    /// The process id.
    pub pid: i64
    /// The user id.
    pub uid: i64
    /// The group id.
    pub gid: i64
}

fn level_of(option: SocketOption) -> i64 {
    match option {
        ReuseAddr => 1
        ReusePort => 1
        KeepAlive => 1
        ReceiveBuffer => 1
        SendBuffer => 1
        NoDelay => 6
        KeepIdle => 6
        KeepInterval => 6
        KeepCount => 6
        MulticastTtl4 => 0
        MulticastLoop4 => 0
        MulticastTtl6 => 41
        MulticastLoop6 => 41
        MulticastInterface6 => 41
    }
}

fn number_of(option: SocketOption) -> i64 {
    match option {
        ReuseAddr => 2
        ReusePort => 15
        KeepAlive => 9
        ReceiveBuffer => 8
        SendBuffer => 7
        NoDelay => 1
        KeepIdle => 4
        KeepInterval => 5
        KeepCount => 6
        MulticastTtl4 => 33
        MulticastLoop4 => 34
        MulticastTtl6 => 18
        MulticastLoop6 => 19
        MulticastInterface6 => 17
    }
}

fn address_of(buf: []u8, size: i64) -> []u8 {
    let length = if size < buf.len { size } else { buf.len }
    buf[..length]
}

fn membership_request(group: []u8, index: i64) -> []u8 {
    var request: []u8 = []
    io.append(mut request, group)
    if group.len == 4 {
        io.put_be32(mut request, 0)
    }
    let tail = io.buffer(4)
    io.set_le32(tail, 0, index)
    io.append(mut request, tail)
    request
}

fn set_bytes(fd: i64, level: i64, option: i64, value: []u8) ! io.Error {
    io.syscall_result(__syscall(54, fd, level, option, __slice_ptr(value), value.len))?
}

/// Makes a non-blocking socket closed on `exec` and returns its descriptor.
///
/// `family` is the address family number of the addresses the socket will use.
pub fn socket(family: i64, kind: SocketKind) -> i64 ! io.Error {
    let type_code = match kind {
        Streaming => 1
        Datagrams => 2
    }
    io.syscall_result(__syscall(41, family, type_code | 0x80800, 0))
}

/// Returns two connected, unnamed Unix stream sockets, non-blocking and closed on `exec`.
pub fn socketpair() -> Pair ! io.Error {
    let fds = io.buffer(8)
    io.syscall_result(__syscall(53, 1, 0x80801, 0, __slice_ptr(fds)))?
    Pair { first: io.le32(fds, 0), second: io.le32(fds, 4) }
}

/// Sets the integer socket option `option` of the socket `fd` to `value`.
pub fn set_option(fd: i64, option: SocketOption, value: i64) ! io.Error {
    let v = io.buffer(4)
    io.set_le32(v, 0, value)
    set_bytes(fd, level_of(option), number_of(option), v)?
}

/// Returns the integer socket option `option` of the socket `fd`.
pub fn get_option(fd: i64, option: SocketOption) -> i64 ! io.Error {
    let v = io.buffer(4)
    let size = io.buffer(4)
    io.set_le32(size, 0, 4)
    io.syscall_result(__syscall(55, fd, level_of(option), number_of(option), __slice_ptr(v), __slice_ptr(size)))?
    io.le32(v, 0)
}

/// Binds the socket `fd` to the network interface `device`.
pub fn bind_device(fd: i64, device: str) ! io.Error {
    let name = bytes(device)
    set_bytes(fd, 1, 25, name)?
}

/// Binds the socket `fd` to `address`, given in the system's socket address layout.
pub fn bind(fd: i64, address: []u8) ! io.Error {
    io.syscall_result(__syscall(49, fd, __slice_ptr(address), address.len))?
}

/// Marks the socket `fd` as listening with a queue of `backlog` waiting connections.
pub fn listen(fd: i64, backlog: i64) ! io.Error {
    io.syscall_result(__syscall(50, fd, backlog))?
}

/// Returns the address the socket `fd` is bound to, in the system's socket address layout.
pub fn local_address(fd: i64) -> []u8 ! io.Error {
    let buf = io.buffer(128)
    let size = io.buffer(4)
    io.set_le32(size, 0, 128)
    io.syscall_result(__syscall(51, fd, __slice_ptr(buf), __slice_ptr(size)))?
    address_of(buf, io.le32(size, 0))
}

/// Takes the next waiting connection from the listening socket `fd`.
///
/// Fails with `WouldBlock` when none is waiting. An interrupted call and a connection reset before it was accepted are skipped.
pub fn accept(fd: i64) -> Accepted ! io.Error {
    let buf = io.buffer(128)
    let size = io.buffer(4)
    for {
        io.set_le32(size, 0, 128)
        let r = __syscall(288, fd, __slice_ptr(buf), __slice_ptr(size), 0x80800)
        if r != -4 && r != -103 {
            let accepted = io.syscall_result(r)?
            return Accepted { fd: accepted, address: address_of(buf, io.le32(size, 0)) }
        }
    }
}

/// Starts connecting the socket `fd` to `address` and returns whether the connection is complete.
///
/// Returns `false` while the connection is in progress; wait for `fd` to become writable and call `finish_connect`. Fails with `WouldBlock` when a Unix socket's listener has a full queue, which no later event announces, so the caller tries again.
pub fn connect(fd: i64, address: []u8) -> bool ! io.Error {
    for {
        let r = __syscall(42, fd, __slice_ptr(address), address.len)
        if r == -115 {
            return false
        }
        if r != -4 {
            io.syscall_result(r)?
            return true
        }
    }
}

/// Reports how a connection started by `connect` ended.
///
/// Fails with the error the connection met, such as `Refused`.
pub fn finish_connect(fd: i64) ! io.Error {
    let code = get_option_error(fd)
    if code != 0 {
        fail io.errno(code)
    }
}

fn get_option_error(fd: i64) -> i64 {
    let v = io.buffer(4)
    let size = io.buffer(4)
    io.set_le32(size, 0, 4)
    let r = __syscall(55, fd, 1, 4, __slice_ptr(v), __slice_ptr(size))
    if r < 0 { -r } else { io.le32(v, 0) }
}

/// Shuts down the socket `fd` in the direction `how`.
pub fn shutdown(fd: i64, how: Shutdown) ! io.Error {
    let direction = match how {
        Sending => 1
        Both => 2
    }
    io.syscall_result(__syscall(48, fd, direction))?
}

/// Receives up to `buf.len` bytes from the socket `fd` and returns the count, or `0` at end of input.
///
/// Fails with `WouldBlock` when nothing has arrived. An interrupted call is repeated.
pub fn recv(fd: i64, buf: []u8) -> i64 ! io.Error {
    for {
        let r = __syscall(45, fd, __slice_ptr(buf), buf.len, 0, 0, 0)
        if r != -4 {
            return io.syscall_result(r)
        }
    }
}

/// Receives one datagram into `buf` from the socket `fd`.
///
/// A datagram longer than `buf` is truncated. Fails with `WouldBlock` when nothing has arrived. An interrupted call is repeated.
pub fn recv_from(fd: i64, buf: []u8) -> Received ! io.Error {
    let address = io.buffer(28)
    let size = io.buffer(4)
    for {
        io.set_le32(size, 0, 28)
        let r = __syscall(45, fd, __slice_ptr(buf), buf.len, 0, __slice_ptr(address), __slice_ptr(size))
        if r != -4 {
            let n = io.syscall_result(r)?
            return Received { size: n, address: address_of(address, io.le32(size, 0)) }
        }
    }
}

/// Sends a prefix of `data` on the connected socket `fd` and returns how many bytes were sent.
///
/// A peer that has closed the connection gives `BrokenPipe` or `Reset` and never raises `SIGPIPE`. Fails with `WouldBlock` when the send buffer is full. An interrupted call is repeated.
pub fn send(fd: i64, data: []u8) -> i64 ! io.Error {
    for {
        let r = __syscall(44, fd, __slice_ptr(data), data.len, 0x4000, 0, 0)
        if r != -4 {
            return io.syscall_result(r)
        }
    }
}

/// Sends `data` as one datagram from the socket `fd` to `address` and returns the number of bytes sent.
///
/// Fails with `WouldBlock` when the send buffer is full. An interrupted call is repeated.
pub fn send_to(fd: i64, data: []u8, address: []u8) -> i64 ! io.Error {
    for {
        let r = __syscall(44, fd, __slice_ptr(data), data.len, 0x4000, __slice_ptr(address), address.len)
        if r != -4 {
            return io.syscall_result(r)
        }
    }
}

/// Returns the process id, user id and group id of the peer of the Unix socket `fd`, as recorded when the connection was made.
pub fn peer_credentials(fd: i64) -> Credentials ! io.Error {
    let v = io.buffer(12)
    let size = io.buffer(4)
    io.set_le32(size, 0, 12)
    io.syscall_result(__syscall(55, fd, 1, 17, __slice_ptr(v), __slice_ptr(size)))?
    Credentials { pid: io.le32(v, 0), uid: io.le32(v, 4), gid: io.le32(v, 8) }
}

/// Returns the kernel index of the network interface `name`.
///
/// Fails with `Invalid` if `name` is empty or longer than 15 bytes, and with `NotFound` if there is no such interface.
pub fn interface_index(name: str) -> i64 ! io.Error {
    if name.len == 0 || name.len > 15 {
        fail Invalid
    }
    let probe_fd = socket(2, Datagrams)?
    using probe = own(probe_fd)
    let request = io.buffer(40)
    let label = bytes(name)
    io.copy(request, label)
    let r = __syscall(16, probe.handle.fd, 0x8933, __slice_ptr(request))
    if r == -19 {
        fail NotFound
    }
    io.syscall_result(r)?
    io.le32(request, 16)
}

/// Joins or leaves the multicast `group` on the UDP socket `fd`.
///
/// `group` is 4 bytes for IPv4 or 16 for IPv6. `index` is the interface index, or `0` to let the system choose.
pub fn change_membership(fd: i64, group: []u8, index: i64, join: bool) ! io.Error {
    let request = membership_request(group, index)
    if group.len == 4 {
        set_bytes(fd, 0, if join { 35 } else { 36 }, request)?
        return
    }
    set_bytes(fd, 41, if join { 20 } else { 21 }, request)?
}

/// Sets the interface IPv4 multicast datagrams from the socket `fd` leave through to the interface with kernel index `index`, or to the system's choice when `index` is `0`.
pub fn set_multicast_interface4(fd: i64, index: i64) ! io.Error {
    let request = membership_request([0, 0, 0, 0], index)
    set_bytes(fd, 0, 32, request)?
}
