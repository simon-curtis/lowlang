import std/io

/// The disposition of a signal that `set_disposition` installs.
pub enum Disposition {
    /// The system default for the signal.
    Default
    /// The signal is ignored.
    Ignore
}

/// A signal action, as the kernel stores it for each signal.
pub struct Action {
    /// The address of the handler, or `0` for the default and `1` for ignore.
    pub handler: i64
    /// The action flags.
    pub flags: i64
    /// The address of the code that returns from the handler.
    pub restorer: i64
    /// The set of signals blocked while the handler runs.
    pub mask: i64
}

/// How a child process ended, as `reap` reports it.
pub struct Reaped {
    /// Whether the process ended by itself, as opposed to by a signal.
    pub exited: bool
    /// The exit status when `exited` is `true`, and the signal number otherwise.
    pub value: i64
}

/// The outcome of `fork_exec`.
pub struct Spawned {
    /// The process id of the child.
    pub pid: i64
    /// A descriptor that becomes readable when the child ends, which the caller closes, or `-1` when the system cannot make one.
    pub pidfd: i64
    /// The error the child met while changing directory or executing the program, or `none` when the program started.
    ///
    /// The child has exited with status 127 when this is set, and the caller must still reap it.
    pub failure: io.Error?
}
