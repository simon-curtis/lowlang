import std/io

/// The disposition of a signal that `set_disposition` installs.
pub enum Disposition {
    /// The system default for the signal.
    Default
    /// The signal is ignored.
    Ignore
}

/// A signal action, as the kernel stores it for each signal.
pub struct Action {
    /// The address of the handler, or `0` for the default and `1` for ignore.
    pub handler: i64
    /// The action flags.
    pub flags: i64
    /// The address of the code that returns from the handler.
    pub restorer: i64
    /// The set of signals blocked while the handler runs.
    pub mask: i64
}

/// How a child process ended, as `reap` reports it.
pub struct Reaped {
    /// Whether the process ended by itself, as opposed to by a signal.
    pub exited: bool
    /// The exit status when `exited` is `true`, and the signal number otherwise.
    pub value: i64
}

/// The outcome of `fork_exec`.
pub struct Spawned {
    /// The process id of the child.
    pub pid: i64
    /// The error the child met while changing directory or executing the program, or `none` when the program started.
    ///
    /// The child has exited with status 127 when this is set, and the caller must still reap it.
    pub failure: io.Error?
}

fn action_size() -> i64 {
    32
}

fn catch_flags() -> i64 {
    0x1C000000
}

fn encode_action(a: Action) -> []u8 {
    let buf = io.buffer(action_size())
    io.set_le64(buf, 0, a.handler)
    io.set_le64(buf, 8, a.flags)
    io.set_le64(buf, 16, a.restorer)
    io.set_le64(buf, 24, a.mask)
    buf
}

fn decode_action(buf: []u8) -> Action {
    Action { handler: io.le64(buf, 0), flags: io.le64(buf, 8), restorer: io.le64(buf, 16), mask: io.le64(buf, 24) }
}

fn change_action(n: i64, act: Action) -> Action ! io.Error {
    let request = encode_action(act)
    let old = io.buffer(action_size())
    io.syscall_result(__syscall(13, n, __slice_ptr(request), __slice_ptr(old), 8))?
    decode_action(old)
}

/// Returns the process id.
pub fn pid() -> i64 {
    __syscall(39)
}

/// Returns the process id of the parent.
pub fn ppid() -> i64 {
    __syscall(110)
}

/// Returns the real user id.
pub fn uid() -> i64 {
    __syscall(102)
}

/// Returns the real group id.
pub fn gid() -> i64 {
    __syscall(104)
}

/// Returns the effective user id.
pub fn euid() -> i64 {
    __syscall(107)
}

/// Returns the effective group id.
pub fn egid() -> i64 {
    __syscall(108)
}

/// Sets the file creation mask to `mask & 0o777` and returns the previous mask.
pub fn umask(mask: i64) -> i64 {
    __syscall(95, mask & 0o777)
}

/// Ends the process at once with the status `code`, stopping every thread.
pub fn exit_process(code: i64) {
    __syscall(231, code)
}

/// Lets another thread run.
pub fn yield_thread() {
    __syscall(24)
}

/// Returns the absolute path of the current working directory.
///
/// Fails with `NotFound` if the directory has been removed and with `TooLarge` if the path exceeds 1 MiB.
pub fn getcwd() -> str ! io.Error {
    var size = 256
    for size <= 1048576 {
        let buf = io.buffer(size)
        let r = __syscall(79, __slice_ptr(buf), size)
        if r == -34 {
            size *= 4
            continue
        }
        let n = io.syscall_result(r)?
        return str(buf[..n - 1])
    }
    fail TooLarge
}

/// Changes the working directory of the whole process to `path`.
pub fn chdir(path: str) ! io.Error {
    io.syscall_result(__syscall(80, cstr(path)))?
}

/// Returns the host name of the machine.
pub fn hostname() -> str ! io.Error {
    let buf = io.buffer(390)
    io.syscall_result(__syscall(63, __slice_ptr(buf)))?
    var end = 65
    for end < buf.len && buf[end] != 0 {
        end += 1
    }
    str(buf[65..end])
}

/// Returns the number of seconds the machine has been running.
pub fn uptime() -> i64 ! io.Error {
    let buf = io.buffer(112)
    io.syscall_result(__syscall(99, __slice_ptr(buf)))?
    io.le64(buf, 0)
}

fn bit_count(b: u8) -> i64 {
    var n = 0
    var rest = b
    for rest != 0 {
        n += i64(rest & 1)
        rest >>= 1
    }
    n
}

/// Returns the number of CPUs the process may run on, according to its affinity mask.
///
/// Fails with `Invalid` when the mask is empty and with the system error when it cannot be read.
pub fn cpu_count() -> i64 ! io.Error {
    let buf = io.buffer(1024)
    let r = io.syscall_result(__syscall(204, 0, buf.len, __slice_ptr(buf)))?
    if r == 0 {
        fail Invalid
    }
    var n = 0
    for i in 0..r {
        n += bit_count(buf[i])
    }
    n
}

/// Returns whether the page at `address` is mapped.
pub fn is_mapped(address: i64) -> bool {
    __syscall(28, address, 4096, 0) == 0
}

/// Maps `size` bytes of zeroed, readable and writable memory at exactly `address` and returns the address of the mapping.
///
/// Fails with `Exists` when something is already mapped there. A kernel that ignores the placement can return another address, which the caller must check and `unmap`.
pub fn map_anonymous_at(address: i64, size: i64) -> i64 ! io.Error {
    io.syscall_result(__syscall(9, address, size, 3, 0x104022, -1, 0))
}

/// Maps `size` bytes of zeroed memory that can be read, written and executed, and returns its address.
pub fn map_executable(size: i64) -> i64 ! io.Error {
    io.syscall_result(__syscall(9, 0, size, 7, 0x22, -1, 0))
}

/// Unmaps `size` bytes at `address`.
pub fn unmap(address: i64, size: i64) {
    __syscall(11, address, size)
}

/// Sets the disposition of signal number `n` to `how`.
pub fn set_disposition(n: i64, how: Disposition) ! io.Error {
    let handler = match how {
        Default => 0
        Ignore => 1
    }
    change_action(n, Action { handler, flags: 0, restorer: 0, mask: 0 })?
}

/// Installs the handler at `handler` for signal number `n`, which returns through `restorer`, and returns the action it replaces.
///
/// The handler runs on the alternate signal stack and interrupted calls restart.
pub fn catch_signal(n: i64, handler: i64, restorer: i64) -> Action ! io.Error {
    change_action(n, Action { handler, flags: catch_flags(), restorer, mask: 0 })?
}

/// Sets the action of signal number `n` to `saved`.
pub fn restore_action(n: i64, saved: Action) ! io.Error {
    change_action(n, saved)?
}

fn handler_fd_offset() -> i64 {
    9
}

/// Returns x86-64 machine code for a signal handler that writes the signal number as one byte to the descriptor `fd`.
///
/// The code ends with a restorer at `restorer_offset` that returns from the handler. A negative `fd` makes the write fail, which turns the handler into a no-op.
pub fn handler_code(fd: i64) -> []u8 {
    let code: []u8 = [
        0x48, 0x83, 0xEC, 0x08,
        0x40, 0x88, 0x3C, 0x24,
        0xBF, 0, 0, 0, 0,
        0x48, 0x89, 0xE6,
        0xBA, 0x01, 0, 0, 0,
        0xB8, 0x01, 0, 0, 0,
        0x0F, 0x05,
        0x48, 0x83, 0xC4, 0x08,
        0xC3,
        0xB8, 0x0F, 0, 0, 0,
        0x0F, 0x05,
    ]
    io.set_le32(code, handler_fd_offset(), fd)
    code
}

/// Returns the offset in `handler_code` of the code that returns from the handler.
pub fn restorer_offset() -> i64 {
    33
}

/// Returns the address of the handler installed for signal number `n`.
pub fn handler_of(n: i64) -> i64 ! io.Error {
    let old = io.buffer(action_size())
    io.syscall_result(__syscall(13, n, 0, __slice_ptr(old), 8))?
    io.le64(old, 0)
}

/// Sends signal number `signal` to the process `pid`, or to the process group `-pid` when `pid` is negative.
pub fn kill(pid: i64, signal: i64) ! io.Error {
    io.syscall_result(__syscall(62, pid, signal))?
}

/// Sends signal number `signal` to the calling thread.
pub fn raise(signal: i64) ! io.Error {
    io.syscall_result(__syscall(234, __syscall(39), __syscall(186), signal))?
}

/// Returns a descriptor that becomes readable when the process `pid` ends.
pub fn pidfd_open(pid: i64) -> i64 ! io.Error {
    io.syscall_result(__syscall(434, pid, 0))
}

/// Sends signal number `signal` to the process behind the process descriptor `pidfd`.
pub fn pidfd_send_signal(pidfd: i64, signal: i64) ! io.Error {
    io.syscall_result(__syscall(424, pidfd, signal, 0, 0))?
}

fn status_of(info: []u8) -> Reaped {
    Reaped { exited: io.le32(info, 8) == 1, value: io.le32(info, 24) }
}

/// Waits for the child `pid` to end, reaps it and returns how it ended.
///
/// A `pidfd` of `0` or more is the child's process descriptor, which identifies it without the process id. Blocks the OS thread, so wait for the descriptor to become readable first.
pub fn reap(pidfd: i64, pid: i64) -> Reaped ! io.Error {
    let info = io.buffer(128)
    for {
        let r = if pidfd >= 0 {
            __syscall(247, 3, pidfd, __slice_ptr(info), 4, 0)
        } else {
            __syscall(247, 1, pid, __slice_ptr(info), 4, 0)
        }
        if r != -4 {
            io.syscall_result(r)?
            return status_of(info)
        }
    }
}

/// Waits for the child `pid` to end without reaping it.
///
/// Blocks the OS thread until the child has ended.
pub fn wait_exit(pid: i64) ! io.Error {
    let info = io.buffer(128)
    for {
        let r = __syscall(247, 1, pid, __slice_ptr(info), 0x01000004, 0)
        if r != -4 {
            io.syscall_result(r)?
            return
        }
    }
}

fn c_string(s: str) -> []u8 {
    var b = bytes(s)
    push(mut b, 0)
    b
}

fn c_strings(strings: []str) -> [][]u8 {
    var out: [][]u8 = []
    for s in strings {
        push(mut out, c_string(s))
    }
    out
}

fn pointers(strings: [][]u8) -> []ptr {
    var out: []ptr = []
    for s in strings {
        push(mut out, __slice_ptr(s))
    }
    push(mut out, null)
    out
}

fn redirect(fd: i64, target: i64) {
    if fd >= 0 {
        __syscall(33, fd, target)
    }
}

fn report_failure(report: i64, code: []u8, r: i64) {
    io.set_le32(code, 0, -r)
    __syscall(1, report, __slice_ptr(code), 4)
    __syscall(231, 127)
}

fn abandon(pid: i64) {
    __syscall(62, pid, 9)
    let info = io.buffer(128)
    for {
        if __syscall(247, 1, pid, __slice_ptr(info), 4, 0) != -4 {
            return
        }
    }
}

/// Starts the program at `path` in a new process and returns once the program has been executed.
///
/// `argv` is the whole argument vector, program name first, and `envp` is the complete environment as `name=value` entries. A `dir` that is not empty becomes the working directory of the child. With `group` the child starts its own process group. `stdin`, `stdout` and `stderr` are descriptors the child receives as standard streams, and a negative one leaves that stream as the parent's. The parent waits for the child to report on a pipe that closes when the program is executed, so the call parks the green thread until then.
///
/// Fails with the system error when the pipe or the fork fails. An error of `chdir` or `execve` in the child comes back in `Spawned.failure`.
pub fn fork_exec(path: str, argv: []str, envp: []str, dir: str, group: bool, stdin: i64, stdout: i64, stderr: i64) -> Spawned ! io.Error {
    let path_c = cstr(path)
    let dir_c = cstr(dir)
    let argv_strings = c_strings(argv)
    let envp_strings = c_strings(envp)
    let argv_c = pointers(argv_strings)
    let envp_c = pointers(envp_strings)
    let ends = pipe(false)?
    using reader = own(ends.first)
    using writer = own(ends.second)
    set_nonblocking(ends.first)?
    let code = io.buffer(4)
    let has_dir = dir.len > 0
    let report = ends.second
    let pid = __syscall(57)
    if pid == 0 {
        if group {
            __syscall(109, 0, 0)
        }
        redirect(stdin, 0)
        redirect(stdout, 1)
        redirect(stderr, 2)
        var r = 0
        if has_dir {
            r = __syscall(80, dir_c)
        }
        if r == 0 {
            r = __syscall(59, path_c, __slice_ptr(argv_c), __slice_ptr(envp_c))
        }
        report_failure(report, code, r)
    }
    close(writer)
    if pid < 0 {
        fail io.errno(-pid)
    }
    let n = read(ends.first, code) catch {
        e => {
            abandon(pid)
            fail e
        }
    }
    if n == 4 {
        return Spawned { pid, failure: some(io.errno(io.le32(code, 0))) }
    }
    Spawned { pid, failure: none }
}
