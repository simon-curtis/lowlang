import std/io

fn termios_size() -> i64 {
    64
}

fn input_flags() -> i64 {
    0
}

fn output_flags() -> i64 {
    4
}

fn control_flags() -> i64 {
    8
}

fn local_flags() -> i64 {
    12
}

fn control_chars() -> i64 {
    17
}

fn vtime() -> i64 {
    5
}

fn vmin() -> i64 {
    6
}

fn canonical_and_echo() -> i64 {
    0x0A
}

fn ioctl(fd: i64, request: i64, arg: []u8) ! io.Error {
    for {
        let r = __syscall(16, fd, request, __slice_ptr(arg))
        if r == -25 {
            fail Unsupported
        }
        if r != -4 {
            io.syscall_result(r)?
            return
        }
    }
}

/// Returns whether the descriptor `fd` refers to a terminal.
pub fn is_terminal(fd: i64) -> bool {
    let t = io.buffer(termios_size())
    __syscall(16, fd, 0x5401, __slice_ptr(t)) == 0
}

/// Returns the settings of the terminal on `fd`.
///
/// Fails with `Unsupported` if `fd` is not a terminal.
pub fn termios(fd: i64) -> Termios ! io.Error {
    let t = io.buffer(termios_size())
    ioctl(fd, 0x5401, t)?
    Termios { settings: t }
}

/// Applies `t` to the terminal on `fd`.
///
/// With `drain` set the change waits until pending output has been sent. Fails with `Unsupported` if `fd` is not a terminal.
pub fn set_termios(fd: i64, t: Termios, drain: bool) ! io.Error {
    let request = if drain { 0x5403 } else { 0x5402 }
    ioctl(fd, request, t.settings)?
}

/// Returns whether `t` has line buffering and echo both turned off.
pub fn is_raw(t: Termios) -> bool {
    io.le32(t.settings, local_flags()) & canonical_and_echo() == 0
}

/// Returns a copy of `t` in raw mode.
///
/// Raw mode turns off line buffering, echo, signal-generating keys, flow control and input and output translation, uses 8-bit characters, and makes reads return after one byte.
pub fn raw_mode(t: Termios) -> Termios {
    let raw = io.buffer(termios_size())
    io.copy(raw, t.settings)
    let input = io.le32(raw, input_flags()) & ~0x5EB
    let output = io.le32(raw, output_flags()) & ~0x1
    let control = io.le32(raw, control_flags()) & ~0x130 | 0x30
    let local = io.le32(raw, local_flags()) & ~0x804B
    io.set_le32(raw, input_flags(), input)
    io.set_le32(raw, output_flags(), output)
    io.set_le32(raw, control_flags(), control)
    io.set_le32(raw, local_flags(), local)
    raw[control_chars() + vmin()] = 1
    raw[control_chars() + vtime()] = 0
    Termios { settings: raw }
}

/// Returns the size of the terminal on `fd`.
///
/// Fails with `Unsupported` if `fd` is not a terminal.
pub fn window_size(fd: i64) -> WindowSize ! io.Error {
    let w = io.buffer(8)
    ioctl(fd, 0x5413, w)?
    WindowSize { columns: io.le16(w, 2), rows: io.le16(w, 0) }
}

/// Sets the size of the terminal on `fd` to `size`.
///
/// Fails with `Unsupported` if `fd` is not a terminal.
pub fn set_window_size(fd: i64, size: WindowSize) ! io.Error {
    let w = io.buffer(8)
    io.set_le16(w, 0, size.rows)
    io.set_le16(w, 2, size.columns)
    ioctl(fd, 0x5414, w)?
}

fn slave_number(master: i64) -> i64 ! io.Error {
    let unlock = io.buffer(4)
    ioctl(master, 0x40045431, unlock)?
    let n = io.buffer(4)
    ioctl(master, 0x80045430, n)?
    io.le32(n, 0)
}

/// Opens a new pseudoterminal and returns its master and slave sides.
///
/// The caller closes both descriptors. Fails with the system error if `/dev/ptmx` or the slave device cannot be opened.
pub fn open_pty() -> PtyPair ! io.Error {
    let master_view = open("/dev/ptmx", Terminal, 0)?
    using var master = adopt(master_view)
    let number = slave_number(master.handle.fd)?
    let path = "/dev/pts/{number}"
    let slave_view = open(path, Terminal, 0)?
    let kept = detach(mut master)
    PtyPair { master: kept.fd, slave: slave_view.fd, path }
}
