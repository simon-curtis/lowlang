import std/io
import std/sys

fn produce(h: sys.FdHandle, lines: i64) {
    for i in 1..lines + 1 {
        sys.write_all_on(h, bytes("line {i}\n")) or return
    }
    sys.close_on(h)
}

/// Connects two green threads with a pipe: one writes lines and closes its end, the other reads them until end of input.
fn main() ! io.Error {
    let ends = sys.pipe(true)?
    using reading = sys.own(ends.first)
    let writing = sys.wrap(ends.second)
    spawn produce(writing, 3)

    let source = io.reader(sys.stream_on(reading.handle))
    for {
        let line = io.read_line(source) catch {
            Eof => break
            e => fail e
        }
        print("received {line}")
    }

    sys.close_on(reading.handle)
    let late = sys.read_on(reading.handle, io.buffer(8)) catch {
        NotConnected => -1
        e => fail e
    }
    print("read after close: {late}")
}
