pub fn contains[T: Eq](xs: []T, x: T) -> bool {
    for item in xs {
        if item == x {
            return true
        }
    }
    false
}

pub fn index[T: Eq](xs: []T, x: T) -> i64? {
    for i, item in xs {
        if item == x {
            return i
        }
    }
    none
}

pub fn clone[T](xs: []T) -> []T {
    var out: []T = []
    for x in xs {
        push(mut out, x)
    }
    out
}

pub fn concat[T](xs: []T, ys: []T) -> []T {
    var out = clone(xs)
    for y in ys {
        push(mut out, y)
    }
    out
}

pub fn reverse[T](mut xs: []T) {
    for i in 0..xs.len / 2 {
        let j = xs.len - 1 - i
        let swap = xs[i]
        xs[i] = xs[j]
        xs[j] = swap
    }
}

pub fn map[T, U](xs: []T, f: fn(T) -> U) -> []U {
    var out: []U = []
    for x in xs {
        push(mut out, f(x))
    }
    out
}

pub fn filter[T](xs: []T, keep: fn(T) -> bool) -> []T {
    var out: []T = []
    for x in xs {
        if keep(x) {
            push(mut out, x)
        }
    }
    out
}

pub fn fold[T, A](xs: []T, initial: A, f: fn(A, T) -> A) -> A {
    var acc = initial
    for x in xs {
        acc = f(acc, x)
    }
    acc
}

pub fn any[T](xs: []T, test: fn(T) -> bool) -> bool {
    for x in xs {
        if test(x) {
            return true
        }
    }
    false
}

pub fn all[T](xs: []T, test: fn(T) -> bool) -> bool {
    for x in xs {
        if !test(x) {
            return false
        }
    }
    true
}

pub fn sum[T: Number](xs: []T) -> T {
    var total: T = 0
    for x in xs {
        total += x
    }
    total
}

pub fn min[T: Ord](xs: []T) -> T? {
    if xs.len == 0 {
        return none
    }
    var best = xs[0]
    for x in xs {
        if x < best {
            best = x
        }
    }
    best
}

pub fn max[T: Ord](xs: []T) -> T? {
    if xs.len == 0 {
        return none
    }
    var best = xs[0]
    for x in xs {
        if x > best {
            best = x
        }
    }
    best
}

pub fn sort[T: Ord](mut xs: []T) {
    sort_by(mut xs, fn(a: T, b: T) -> bool { a < b })
}

pub fn sort_by[T](mut xs: []T, less: fn(T, T) -> bool) {
    quicksort(mut xs, 0, xs.len, less)
}

pub fn sorted[T: Ord](xs: []T) -> bool {
    for i in 1..xs.len {
        if xs[i] < xs[i - 1] {
            return false
        }
    }
    true
}

fn swap[T](mut xs: []T, i: i64, j: i64) {
    let t = xs[i]
    xs[i] = xs[j]
    xs[j] = t
}

fn insertion[T](mut xs: []T, lo: i64, hi: i64, less: fn(T, T) -> bool) {
    for i in lo + 1..hi {
        var j = i
        for j > lo && less(xs[j], xs[j - 1]) {
            swap(mut xs, j, j - 1)
            j -= 1
        }
    }
}

fn median[T](mut xs: []T, lo: i64, hi: i64, less: fn(T, T) -> bool) {
    let mid = lo + (hi - lo) / 2
    let last = hi - 1
    if less(xs[mid], xs[lo]) {
        swap(mut xs, mid, lo)
    }
    if less(xs[last], xs[lo]) {
        swap(mut xs, last, lo)
    }
    if less(xs[last], xs[mid]) {
        swap(mut xs, last, mid)
    }
    swap(mut xs, mid, lo)
}

fn quicksort[T](mut xs: []T, start: i64, end: i64, less: fn(T, T) -> bool) {
    var lo = start
    var hi = end
    for hi - lo > 16 {
        median(mut xs, lo, hi, less)
        let pivot = xs[lo]
        var i = lo + 1
        var j = hi - 1
        for {
            for i <= j && less(xs[i], pivot) {
                i += 1
            }
            for i <= j && less(pivot, xs[j]) {
                j -= 1
            }
            if i >= j {
                break
            }
            swap(mut xs, i, j)
            i += 1
            j -= 1
        }
        swap(mut xs, lo, j)
        if j - lo < hi - j - 1 {
            quicksort(mut xs, lo, j, less)
            lo = j + 1
        } else {
            quicksort(mut xs, j + 1, hi, less)
            hi = j
        }
    }
    insertion(mut xs, lo, hi, less)
}
