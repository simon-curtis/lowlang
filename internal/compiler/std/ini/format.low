import std/text

/// Formats the document as INI text.
///
/// The unnamed section is written first without a header and is skipped when it is empty; each named section follows as `[name]`, with a blank line between sections. An entry is written as `key = value`, or `key =` for an empty value. A value is quoted, with `\"`, `\\`, `\n`, `\r`, `\t` and `\uXXXX` escapes, when it starts with a space, tab or `"`, ends with a space, tab or `\`, or holds a control character; other values are written as they are. Keys and section names are not escaped. Every line ends with `\n`.
pub fn format(d: Document) -> str {
    var out: []u8 = []
    var first = true
    for s in d.sections {
        if s.name == "" && s.entries.len == 0 {
            continue
        }
        if !first {
            push(mut out, '\n')
        }
        first = false
        if s.name != "" {
            text.append(mut out, "[{s.name}]\n")
        }
        for e in s.entries {
            text.append(mut out, line_of(e))
        }
    }
    __str_view(out)
}

fn line_of(e: Entry) -> str {
    if e.value.len == 0 {
        return "{e.key} =\n"
    }
    "{e.key} = {render(e.value)}\n"
}

fn needs_quotes(value: str) -> bool {
    if value.len == 0 {
        return false
    }
    if value[0] == ' ' || value[0] == '\t' || value[0] == '"' {
        return true
    }
    let last = value[value.len - 1]
    if last == ' ' || last == '\t' || last == '\\' {
        return true
    }
    for c in value {
        if c < 0x20 || c == 0x7F {
            return true
        }
    }
    false
}

fn render(value: str) -> str {
    if !needs_quotes(value) {
        return value
    }
    var out: []u8 = []
    push(mut out, '"')
    for c in value {
        if c == '"' || c == '\\' {
            push(mut out, '\\')
            push(mut out, u8(c))
        } else if c == '\n' {
            text.append(mut out, "\\n")
        } else if c == '\r' {
            text.append(mut out, "\\r")
        } else if c == '\t' {
            text.append(mut out, "\\t")
        } else if c < 0x20 || c == 0x7F {
            text.append(mut out, "\\u{text.pad_left(text.radix(i64(c), 16), 4, '0')}")
        } else {
            text.append_char(mut out, c)
        }
    }
    push(mut out, '"')
    __str_view(out)
}
