pub enum Error {
    Syntax(line: i64, message: str)
}

pub struct Entry {
    pub key: str
    pub value: str
    pub line: i64
}

pub struct Section {
    pub name: str
    pub entries: []Entry
}

pub struct Document {
    pub sections: []*Section
}

pub fn document() -> Document {
    Document { sections: [new(Section { name: "", entries: [] })] }
}

pub fn find(d: Document, name: str) -> *Section? {
    for s in d.sections {
        if s.name == name {
            return s
        }
    }
    none
}

fn ensure(mut d: Document, name: str) -> *Section {
    match find(d, name) {
        some(s) => return s
        none => {}
    }
    let s = new(Section { name, entries: [] })
    push(mut d.sections, s)
    s
}

pub fn sections(d: Document) -> []str {
    var names: []str = []
    for s in d.sections {
        if s.name != "" {
            push(mut names, s.name)
        }
    }
    names
}

pub fn keys(d: Document, section: str) -> []str {
    var out: []str = []
    let s = find(d, section) ?? return out
    var seen: [str: bool] = [:]
    for e in s.entries {
        if !(seen[e.key] ?? false) {
            seen[e.key] = true
            push(mut out, e.key)
        }
    }
    out
}

pub fn get(d: Document, section: str, key: str) -> str? {
    let s = find(d, section) ?? return none
    var i = s.entries.len - 1
    for i >= 0 {
        if s.entries[i].key == key {
            return s.entries[i].value
        }
        i -= 1
    }
    none
}

pub fn get_all(d: Document, section: str, key: str) -> []str {
    var out: []str = []
    let s = find(d, section) ?? return out
    for e in s.entries {
        if e.key == key {
            push(mut out, e.value)
        }
    }
    out
}

pub fn has_section(d: Document, name: str) -> bool {
    find(d, name) != none
}

pub fn add(mut d: Document, section: str, key: str, value: str) {
    let s = ensure(mut d, section)
    push(mut s.entries, Entry { key, value, line: 0 })
}

pub fn set(mut d: Document, section: str, key: str, value: str) {
    let s = ensure(mut d, section)
    var i = s.entries.len - 1
    for i >= 0 {
        if s.entries[i].key == key {
            s.entries[i] = Entry { key, value, line: s.entries[i].line }
            return
        }
        i -= 1
    }
    push(mut s.entries, Entry { key, value, line: 0 })
}
