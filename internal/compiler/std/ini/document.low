/// The error returned when INI text is malformed.
pub enum Error {
    /// The input breaks the INI syntax at `line`, counting from `1`.
    ///
    /// `message` names the problem: an unterminated or empty section header, text after a header or quoted value, a line without `=` or `:`, an empty key, or a bad escape or unterminated string in a quoted value.
    Syntax(line: i64, message: str)
}

/// One `key = value` line of a section.
pub struct Entry {
    /// The key, trimmed of surrounding whitespace.
    pub key: str
    /// The value after escape processing when it was quoted, otherwise trimmed of surrounding whitespace.
    pub value: str
    /// The line on which the entry starts, counting from `1`, or `0` for an entry made by `add` or `set`.
    pub line: i64
}

/// A named group of entries, kept in file order.
pub struct Section {
    /// The name between the brackets, or the empty string for the entries that come before the first header.
    pub name: str
    /// The entries of the section in the order they were read or added, including repeated keys when the document was parsed with `collect`.
    pub entries: []Entry
}

/// An ordered list of sections.
///
/// The first section is the unnamed one for entries before any header; it is always present. Sections are shared pointers, so a `Section` found with `find` reflects later changes to the document.
pub struct Document {
    /// The sections in order of first appearance, starting with the unnamed section.
    pub sections: []*Section
}

/// Returns an empty document: one unnamed section with no entries.
pub fn document() -> Document {
    Document { sections: [new(Section { name: "", entries: [] })] }
}

/// Returns the section called `name`, or `none` when the document has no such section.
///
/// The empty name finds the unnamed section.
pub fn find(d: Document, name: str) -> *Section? {
    for s in d.sections {
        if s.name == name {
            return s
        }
    }
    none
}

fn ensure(mut d: Document, name: str) -> *Section {
    match find(d, name) {
        some(s) => return s
        none => {}
    }
    let s = new(Section { name, entries: [] })
    push(mut d.sections, s)
    s
}

/// Returns the names of the named sections in order of first appearance.
///
/// The unnamed section is not listed.
pub fn sections(d: Document) -> []str {
    var names: []str = []
    for s in d.sections {
        if s.name != "" {
            push(mut names, s.name)
        }
    }
    names
}

/// Returns the distinct keys of `section` in order of first appearance.
///
/// Returns an empty slice when the section does not exist.
pub fn keys(d: Document, section: str) -> []str {
    var out: []str = []
    let s = find(d, section) ?? return out
    var seen: [str: bool] = [:]
    for e in s.entries {
        if !(seen[e.key] ?? false) {
            seen[e.key] = true
            push(mut out, e.key)
        }
    }
    out
}

/// Returns the value of `key` in `section`, or `none` when the section or the key does not exist.
///
/// When the key occurs more than once the last value is returned.
pub fn get(d: Document, section: str, key: str) -> str? {
    let s = find(d, section) ?? return none
    var i = s.entries.len - 1
    for i >= 0 {
        if s.entries[i].key == key {
            return s.entries[i].value
        }
        i -= 1
    }
    none
}

/// Returns every value of `key` in `section`, in order.
///
/// Returns an empty slice when the section or the key does not exist. A document parsed without `collect` holds at most one value per key.
pub fn get_all(d: Document, section: str, key: str) -> []str {
    var out: []str = []
    let s = find(d, section) ?? return out
    for e in s.entries {
        if e.key == key {
            push(mut out, e.value)
        }
    }
    out
}

/// Returns whether the document has a section called `name`.
pub fn has_section(d: Document, name: str) -> bool {
    find(d, name) != none
}

/// Appends the entry `key` and `value` to `section`, even when the key is already present.
///
/// The section is created at the end of the document when it does not exist. The entry's `line` is `0`.
pub fn add(mut d: Document, section: str, key: str, value: str) {
    let s = ensure(mut d, section)
    push(mut s.entries, Entry { key, value, line: 0 })
}

/// Sets `key` to `value` in `section`.
///
/// Replaces the value of the last entry with that key, keeping its position and `line`, or appends a new entry with `line` `0` when there is none. The section is created at the end of the document when it does not exist.
pub fn set(mut d: Document, section: str, key: str, value: str) {
    let s = ensure(mut d, section)
    var i = s.entries.len - 1
    for i >= 0 {
        if s.entries[i].key == key {
            s.entries[i] = Entry { key, value, line: s.entries[i].line }
            return
        }
        i -= 1
    }
    push(mut s.entries, Entry { key, value, line: 0 })
}
