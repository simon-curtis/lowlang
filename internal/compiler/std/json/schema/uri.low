import std/text

fn alpha(c: u8) -> bool {
    c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z'
}

fn numeric(c: u8) -> bool {
    c >= '0' && c <= '9'
}

fn has_scheme(s: str) -> bool {
    if s.len == 0 || !alpha(s[0]) {
        return false
    }
    for i in 1..s.len {
        let c = s[i]
        if c == ':' {
            return true
        }
        if !(alpha(c) || numeric(c) || c == '+' || c == '-' || c == '.') {
            return false
        }
    }
    false
}

fn strip_fragment(uri: str) -> str {
    let i = text.index_byte(uri, '#')
    if i < 0 {
        return uri
    }
    uri[..i]
}

struct Parts {
    scheme: str
    authority: str
    path: str
    rest: str
}

fn decompose(uri: str) -> Parts {
    var scheme = ""
    var remainder = uri
    if has_scheme(uri) {
        let colon = text.index_byte(uri, ':')
        scheme = uri[..colon + 1]
        remainder = uri[colon + 1..]
    }
    var authority = ""
    if text.starts_with(remainder, "//") {
        var end = 2
        for end < remainder.len && remainder[end] != '/' && remainder[end] != '?' && remainder[end] != '#' {
            end += 1
        }
        authority = remainder[..end]
        remainder = remainder[end..]
    }
    var end = 0
    for end < remainder.len && remainder[end] != '?' && remainder[end] != '#' {
        end += 1
    }
    Parts { scheme, authority, path: remainder[..end], rest: remainder[end..] }
}

fn directory(path: str) -> str {
    let i = text.last_index_byte(path, '/')
    if i < 0 {
        return ""
    }
    path[..i + 1]
}

fn remove_dots(path: str) -> str {
    if !text.contains(path, ".") {
        return path
    }
    let segments = text.split(path, '/')
    var out: []str = []
    for i, segment in segments {
        let last = i == segments.len - 1
        if segment == "." {
            if last {
                push(mut out, "")
            }
        } else if segment == ".." {
            if out.len > 1 || (out.len == 1 && out[0] != "") {
                out = out[..out.len - 1]
            }
            if last {
                push(mut out, "")
            }
        } else {
            push(mut out, segment)
        }
    }
    text.join(out, "/")
}

fn resolve(base: str, reference: str) -> str {
    if has_scheme(reference) {
        return reference
    }
    let b = decompose(strip_fragment(base))
    let target = decompose(reference)
    if text.starts_with(reference, "//") {
        return "{b.scheme}{reference}"
    }
    if reference.len == 0 {
        return "{b.scheme}{b.authority}{b.path}{b.rest}"
    }
    if reference[0] == '#' {
        return "{b.scheme}{b.authority}{b.path}{b.rest}{reference}"
    }
    if reference[0] == '?' {
        return "{b.scheme}{b.authority}{b.path}{reference}"
    }
    if reference[0] == '/' {
        return "{b.scheme}{b.authority}{remove_dots(target.path)}{target.rest}"
    }
    let merged = "{directory(b.path)}{target.path}"
    "{b.scheme}{b.authority}{remove_dots(merged)}{target.rest}"
}

fn percent_decode(s: str) -> str {
    if !text.contains(s, "%") {
        return s
    }
    var out: []u8 = []
    var i = 0
    for i < s.len {
        if s[i] == '%' && i + 2 < s.len && text.hex_digit(s[i + 1]) >= 0 && text.hex_digit(s[i + 2]) >= 0 {
            push(mut out, u8(text.hex_digit(s[i + 1]) * 16 + text.hex_digit(s[i + 2])))
            i += 3
        } else {
            push(mut out, s[i])
            i += 1
        }
    }
    str(out)
}
