import std/json
import std/regex

/// The error returned when a schema cannot be compiled.
pub enum Error {
    /// The schema is not valid. `at` is the JSON Pointer to the offending keyword in the schema and `message` says what is wrong, for example a keyword of the wrong type, an unknown `type`, a duplicate in a list, an invalid `pattern` or an `$id` with a fragment.
    Malformed(at: str, message: str)
    /// A `$ref` or `$dynamicRef` names a schema that is not in the schema document or among `Options.resources`. `reference` is the reference resolved against its base URI. References are never fetched.
    Unresolved(reference: str)
}

/// How the `format` keyword is treated.
pub enum Formats {
    /// `format` is only an annotation and never makes an instance invalid. This is the default.
    Annotate
    /// `format` is checked for the formats `date-time`, `date`, `time`, `email`, `uuid`, `uri`, `hostname`, `json-pointer` and `regex`; a string that does not match is a violation. Other format names are not checked.
    Assert
}

/// Settings for `compile_with`.
pub struct Options {
    /// Whether `format` is asserted; defaults to `Annotate`.
    pub formats: Formats = Formats.Annotate
    /// Further schema documents that references may resolve to. Each one must have an `$id`; `compile_with` fails with `Malformed` when one does not.
    pub resources: []json.Value = []
}

/// One way in which an instance fails a schema.
pub struct Violation {
    /// The JSON Pointer to the part of the instance that failed, `""` for the instance itself.
    pub instance: str
    /// The JSON Pointer to the keyword in the schema that failed, such as `/properties/age/minimum`. A keyword reached through a reference has the `$ref` or `$dynamicRef` keyword in its path.
    pub keyword: str
    /// A description of the failure.
    pub message: str
}

/// A compiled JSON Schema (draft 2020-12), made by `compile` or `compile_with`.
///
/// A `Schema` can validate any number of instances.
pub struct Schema {
    root: json.Value
    context: Context
}

struct Entry {
    schema: json.Value
    base: str
}

/// Compiles `schema` with default `Options`.
///
/// See `compile_with`.
pub fn compile(schema: json.Value) -> Schema ! Error {
    compile_with(schema, Options {})?
}

/// Compiles the JSON Schema 2020-12 document `schema`.
///
/// It checks the schema, resolves `$ref`, `$anchor`, `$dynamicRef` and the schemas in `options.resources` by their `$id`, and precompiles every `pattern` and `patternProperties` expression. A schema is an object or a boolean. Fails with `Malformed` for an invalid schema and `Unresolved` for a reference that resolves to nothing.
pub fn compile_with(schema: json.Value, options: Options) -> Schema ! Error {
    var b = Builder { index: [:], patterns: [:], references: [] }
    b.index[""] = Entry { schema, base: "" }
    visit(mut b, schema, "", "")?
    for extra in options.resources {
        declared_id(extra) ?? fail Malformed("", "an additional schema needs an $id")
        visit(mut b, extra, "", "")?
    }
    resolve_references(b)?
    let assert_formats = options.formats == Formats.Assert
    let context = Context { index: b.index, patterns: b.patterns, assert_formats }
    Schema { root: schema, context }
}

/// Returns every way in which `instance` fails `s`; the result is empty when it is valid.
///
/// Annotations from the branches of `allOf`, `anyOf`, `oneOf`, `if` and the other applicators that passed decide what `unevaluatedProperties` and `unevaluatedItems` cover. Validation does not stop at the first failure.
pub fn validate(s: Schema, instance: json.Value) -> []Violation {
    let start = Frame { base: "", ipath: "", kpath: "", stack: [], scope: [""] }
    let out = run(s.context, s.root, instance, start)
    out.errors
}

/// Returns whether `instance` is valid against `s`; equivalent to `validate(s, instance).len == 0`.
pub fn is_valid(s: Schema, instance: json.Value) -> bool {
    validate(s, instance).len == 0
}
