import std/json
import std/regex

pub enum Error {
    Malformed(at: str, message: str)
    Unresolved(reference: str)
}

pub enum Formats {
    Annotate
    Assert
}

pub struct Options {
    pub formats: Formats = Formats.Annotate
    pub resources: []json.Value = []
}

pub struct Violation {
    pub instance: str
    pub keyword: str
    pub message: str
}

pub struct Schema {
    root: json.Value
    context: Context
}

struct Entry {
    schema: json.Value
    base: str
}

pub fn compile(schema: json.Value) -> Schema ! Error {
    compile_with(schema, Options {})?
}

pub fn compile_with(schema: json.Value, options: Options) -> Schema ! Error {
    var b = Builder { index: [:], patterns: [:], references: [] }
    b.index[""] = Entry { schema, base: "" }
    visit(mut b, schema, "", "")?
    for extra in options.resources {
        declared_id(extra) ?? fail Malformed("", "an additional schema needs an $id")
        visit(mut b, extra, "", "")?
    }
    resolve_references(b)?
    let assert_formats = options.formats == Formats.Assert
    let context = Context { index: b.index, patterns: b.patterns, assert_formats }
    Schema { root: schema, context }
}

pub fn validate(s: Schema, instance: json.Value) -> []Violation {
    let start = Frame { base: "", ipath: "", kpath: "", stack: [], scope: [""] }
    let out = run(s.context, s.root, instance, start)
    out.errors
}

pub fn is_valid(s: Schema, instance: json.Value) -> bool {
    validate(s, instance).len == 0
}
