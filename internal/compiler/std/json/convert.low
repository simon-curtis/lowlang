import std/base64
import std/serde

/// How struct field names and enum variant names are spelled in JSON.
///
/// Low field names are conventionally `snake_case` and variant names `PascalCase`. `serialize_with` converts them to this spelling, and `deserialize_with` converts JSON names back: struct field names to `snake_case`, and variant names to `PascalCase` unless the naming is `Unchanged`.
pub enum Naming {
    /// Names are written as they are in Low and matched exactly.
    Unchanged
    /// Names are `camelCase`: underscores are dropped and the next letter is capitalised, and a leading capital becomes lowercase. When reading, an uppercase letter in a JSON name becomes `_` and the lowercase letter.
    CamelCase
    /// Names are `snake_case`: an uppercase letter becomes an underscore and its lowercase letter, with none at the start. When reading, JSON names are used as they are.
    SnakeCase
    /// Names are `PascalCase`: as `CamelCase` with the first letter uppercase. When reading, an uppercase letter in a JSON name becomes `_` and the lowercase letter.
    PascalCase
}

/// Settings for `serialize_with` and `deserialize_with`.
pub struct Options {
    /// The spaces per nesting level when writing; `0`, the default, writes compact text.
    pub indent: i64 = 0
    /// How field and variant names are spelled; defaults to `Unchanged`. It applies to struct field names and variant names, not to the keys of a map.
    pub naming: Naming = Unchanged
    /// The deepest nesting accepted when reading; defaults to `64`. Deeper input fails with `serde.Error.TooDeep`.
    pub max_depth: i64 = 64
    /// Leaves out struct fields whose value is `none` when writing, instead of writing `null`. Defaults to `false`. Map entries are not affected.
    pub omit_none: bool = false
}

/// Returns `name` spelled as `naming` says, the conversion that `serialize_with` applies to field names and variant names.
pub fn rename(name: str, naming: Naming) -> str {
    match naming {
        Unchanged => name
        CamelCase => camel(name)
        SnakeCase => snake(name)
        PascalCase => pascal(name)
    }
}

fn pascal(name: str) -> str {
    let lowered = camel(name)
    if lowered.len == 0 || lowered[0] < 'a' || lowered[0] > 'z' {
        return lowered
    }
    var out = bytes(lowered)
    out[0] = out[0] - 32
    __str_view(out)
}

fn variant_name(name: str, naming: Naming) -> str {
    match naming {
        Unchanged => name
        _ => pascal(name)
    }
}

fn camel(name: str) -> str {
    var out: []u8 = []
    var upper = false
    for i in 0..name.len {
        let c = name[i]
        if c == '_' && out.len > 0 {
            upper = true
            continue
        }
        if upper && c >= 'a' && c <= 'z' {
            push(mut out, c - 32)
        } else if out.len == 0 && c >= 'A' && c <= 'Z' {
            push(mut out, c + 32)
        } else {
            push(mut out, c)
        }
        upper = false
    }
    __str_view(out)
}

fn snake(name: str) -> str {
    var out: []u8 = []
    for i in 0..name.len {
        let c = name[i]
        if c >= 'A' && c <= 'Z' {
            if i > 0 {
                push(mut out, '_')
            }
            push(mut out, c + 32)
        } else {
            push(mut out, c)
        }
    }
    __str_view(out)
}

struct Pending {
    key: str
    waiting: bool
}

fn flush(w: *Writer, p: *Pending) {
    if p.waiting {
        p.waiting = false
        property(w, p.key)
    }
}

/// Returns a `serde.Writer` that writes derived values as JSON through the `Writer` `w`, with field and variant names spelled as `naming` says.
///
/// `[]u8` is written as a base64 string. A `none` is written as `null`. Maps are written as objects with their keys as they are. An enum variant without fields is its name as a string, and one with fields an object with a single member named by the variant. Use it to write a value with `serde.write` into a writer that already holds other output.
pub fn events(w: *Writer, naming: Naming) -> serde.Writer {
    events_with(w, Options { naming })
}

fn events_with(w: *Writer, options: Options) -> serde.Writer {
    let naming = options.naming
    let p = new(Pending { key: "", waiting: false })
    serde.Writer {
        null: fn() {
            if p.waiting && options.omit_none {
                p.waiting = false
                return
            }
            flush(w, p)
            null(w)
        }
        boolean: fn(v) {
            flush(w, p)
            boolean(w, v)
        }
        integer: fn(n) {
            flush(w, p)
            integer(w, n)
        }
        unsigned: fn(n) {
            flush(w, p)
            unsigned(w, n)
        }
        float: fn(x) {
            flush(w, p)
            float(w, x)
        }
        text: fn(s) {
            flush(w, p)
            string_value(w, s)
        }
        binary: fn(b) {
            flush(w, p)
            string_value(w, base64.encode(b))
        }
        begin_seq: fn() {
            flush(w, p)
            start_array(w)
        }
        end_seq: fn() { end_array(w) }
        begin_map: fn() {
            flush(w, p)
            start_object(w)
        }
        key: fn(k) { property(w, k) }
        end_map: fn() { end_object(w) }
        begin_struct: fn() {
            flush(w, p)
            start_object(w)
        }
        field: fn(name) {
            p.key = rename(name, naming)
            p.waiting = true
        }
        end_struct: fn() { end_object(w) }
        unit_variant: fn(v) {
            flush(w, p)
            string_value(w, rename(v, naming))
        }
        begin_variant: fn(v) {
            flush(w, p)
            start_object(w)
            property(w, rename(v, naming))
        }
        end_variant: fn() { end_object(w) }
    }
}

/// Returns `v` as JSON text, as `options` says.
///
/// A struct becomes an object of its fields, a map an object, a slice an array, an optional `null` or its value, and `[]u8` a base64 string. An enum variant without fields becomes a string, and a variant with fields an object with one member named by the variant, holding an object of its labelled fields or an array of its positional ones. Non-finite floats become `null`.
pub fn serialize_with[T](v: T, options: Options) -> str {
    let w = writer(options.indent)
    serde.write(v, events_with(w, options))
    written_text(w)
}

/// Returns `v` as compact JSON text, with default `Options`.
pub fn serialize[T](v: T) -> str {
    serialize_with(v, Options {})
}

struct Cursor {
    reader: *Reader
    pending: bool
    variants: []bool
}

fn advance(c: *Cursor) ! serde.Error {
    if c.pending {
        c.pending = false
        return
    }
    if !read(c.reader)? {
        fail serde.Error.Syntax(position(c.reader), "unexpected end of data")
    }
}

fn expect(c: *Cursor, t: Token, what: str) ! serde.Error {
    advance(c)?
    if token(c.reader) != t {
        fail serde.Error.Mismatch(what, c.reader.start)
    }
}

fn next_name(c: *Cursor) -> str? ! serde.Error {
    advance(c)?
    if token(c.reader) == EndObject {
        return none
    }
    get_string(c.reader)?
}

fn serde_reader(c: *Cursor) -> serde.Reader {
    let r = c.reader
    serde.Reader {
        null: fn() -> bool ! serde.Error {
            advance(c)?
            if token(r) == Null {
                return true
            }
            c.pending = true
            false
        }
        boolean: fn() -> bool ! serde.Error {
            advance(c)?
            get_bool(r)
        }
        integer: fn() -> i64 ! serde.Error {
            advance(c)?
            get_i64(r)
        }
        unsigned: fn() -> u64 ! serde.Error {
            advance(c)?
            get_u64(r)
        }
        float: fn() -> f64 ! serde.Error {
            advance(c)?
            get_f64(r)
        }
        text: fn() -> str ! serde.Error {
            advance(c)?
            get_string(r)
        }
        binary: fn() -> []u8 ! serde.Error {
            advance(c)?
            let s = get_string(r)?
            base64.decode(s) catch {
                _ => fail serde.Error.Mismatch("base64", r.start)
            }
        }
        begin_seq: fn() ! serde.Error {
            expect(c, StartArray, "array")?
        }
        next_element: fn() -> bool ! serde.Error {
            advance(c)?
            if token(r) == EndArray {
                return false
            }
            c.pending = true
            true
        }
        begin_map: fn() ! serde.Error {
            expect(c, StartObject, "object")?
        }
        next_field: fn() -> str? ! serde.Error { next_name(c) }
        next_key: fn() -> str? ! serde.Error { next_name(c) }
        begin_variant: fn() -> str ! serde.Error {
            advance(c)?
            if token(r) == String {
                push(mut c.variants, false)
                return get_string(r)
            }
            if token(r) != StartObject {
                fail serde.Error.Mismatch("variant", r.start)
            }
            advance(c)?
            if token(r) != PropertyName {
                fail serde.Error.Mismatch("variant name", r.start)
            }
            push(mut c.variants, true)
            get_string(r)
        }
        end_variant: fn() ! serde.Error {
            let wrapped = c.variants[c.variants.len - 1]
            truncate(mut c.variants, c.variants.len - 1)
            if wrapped {
                expect(c, EndObject, "end of variant")?
            }
        }
        skip: fn() ! serde.Error {
            advance(c)?
            skip(r)?
        }
        position: fn() -> i64 { position(r) }
    }
}

fn renaming(inner: serde.Reader, naming: Naming) -> serde.Reader {
    var out = inner
    out.next_field = fn() -> str? ! serde.Error {
        let name = inner.next_field()?
        match name {
            some(k) => unrename(k, naming)
            none => none
        }
    }
    out.begin_variant = fn() -> str ! serde.Error {
        let name = inner.begin_variant()?
        variant_name(name, naming)
    }
    out
}

fn unrename(key: str, naming: Naming) -> str {
    match naming {
        Unchanged => key
        CamelCase => snake(key)
        SnakeCase => key
        PascalCase => snake(key)
    }
}

/// Returns a `serde.Reader` over the JSON text `data`, to pass to `serde.read`.
///
/// Names are matched as they are, the nesting limit is `64`, and data after the first value is not checked. Failures are reported as `serde.Error`s.
pub fn source(data: []u8) -> serde.Reader {
    let c = new(Cursor { reader: reader(data), pending: false, variants: [] })
    serde_reader(c)
}

/// Decodes the JSON text `data` into a `T`, as `options` says.
///
/// The text must be one complete JSON value; data after it fails with `serde.Error.Syntax`. A struct is read from an object: unknown members are skipped, a missing member takes the field's default or `none` for an optional, and any other missing member fails with `Missing`. `null` reads as `none`. Integers must be written without a fraction or exponent, and a `[]u8` is read from a base64 string. An enum variant is read from a string or an object with one member. Failures are `serde.Error`: `Syntax` for malformed JSON, `Mismatch` for a value of the wrong type, `Range` for a number that does not fit, `TooDeep` and `UnknownVariant`.
pub fn deserialize_with[T](data: []u8, options: Options) -> T ! serde.Error {
    let r = reader(data)
    r.max_depth = options.max_depth
    let c = new(Cursor { reader: r, pending: false, variants: [] })
    let value: T = serde.read(renaming(serde_reader(c), options.naming))?
    if read(r)? {
        fail serde.Error.Syntax(position(r), "data after the top-level value")
    }
    value
}

/// Decodes the JSON text `data` into a `T` with default `Options`.
///
/// See `deserialize_with`.
pub fn deserialize[T](data: []u8) -> T ! serde.Error {
    deserialize_with(data, Options {})
}
