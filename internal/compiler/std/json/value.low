import std/serde

pub enum Value {
    Null
    Bool(value: bool)
    Int(value: i64)
    Float(value: f64)
    Str(value: str)
    Array(items: []Value)
    Object(members: []Member)
}

pub struct Member {
    pub name: str
    pub value: Value
}

pub fn parse(data: []u8) -> Value ! serde.Error {
    let r = reader(data)
    read(r)?
    let v = parse_value(r)?
    if read(r)? {
        fail serde.Error.Syntax(position(r), "data after the top-level value")
    }
    v
}

fn parse_value(r: *Reader) -> Value ! serde.Error {
    let t = token(r)
    if t == StartObject {
        var members: []Member = []
        for {
            read(r)?
            if token(r) == EndObject {
                return Object(members)
            }
            let name = get_string(r)?
            read(r)?
            push(mut members, Member { name, value: parse_value(r)? })
        }
    }
    if t == StartArray {
        var items: []Value = []
        for {
            read(r)?
            if token(r) == EndArray {
                return Array(items)
            }
            push(mut items, parse_value(r)?)
        }
    }
    if t == String {
        return Str(get_string(r)?)
    }
    if t == Number {
        let raw = value_bytes(r)
        for c in raw {
            if c == '.' || c == 'e' || c == 'E' {
                return Float(get_f64(r)?)
            }
        }
        let n = get_i64(r) catch {
            _ => return Float(get_f64(r)?)
        }
        return Int(n)
    }
    if t == True || t == False {
        return Bool(t == True)
    }
    Null
}

pub fn get(v: Value, name: str) -> Value? {
    match v {
        Object(members) => {
            for m in members {
                if m.name == name {
                    return m.value
                }
            }
            none
        }
        _ => none
    }
}

pub fn at(v: Value, index: i64) -> Value? {
    match v {
        Array(items) => {
            if index >= 0 && index < items.len {
                return items[index]
            }
            none
        }
        _ => none
    }
}

pub fn equal(a: Value, b: Value) -> bool {
    match a {
        Null => match b {
            Null => true
            _ => false
        }
        Bool(x) => match b {
            Bool(y) => x == y
            _ => false
        }
        Int(x) => match b {
            Int(y) => x == y
            Float(y) => f64(x) == y
            _ => false
        }
        Float(x) => match b {
            Int(y) => x == f64(y)
            Float(y) => x == y
            _ => false
        }
        Str(x) => match b {
            Str(y) => x == y
            _ => false
        }
        Array(x) => match b {
            Array(y) => equal_items(x, y)
            _ => false
        }
        Object(x) => match b {
            Object(y) => equal_members(x, y)
            _ => false
        }
    }
}

fn equal_items(a: []Value, b: []Value) -> bool {
    if a.len != b.len {
        return false
    }
    for i, item in a {
        if !equal(item, b[i]) {
            return false
        }
    }
    true
}

fn equal_members(a: []Member, b: []Member) -> bool {
    if a.len != b.len {
        return false
    }
    for m in a {
        let other = get(Object(b), m.name) ?? return false
        if !equal(m.value, other) {
            return false
        }
    }
    true
}

fn write_value(w: *Writer, v: Value) {
    match v {
        Null => null(w)
        Bool(b) => boolean(w, b)
        Int(n) => integer(w, n)
        Float(x) => float(w, x)
        Str(s) => string_value(w, s)
        Array(items) => {
            start_array(w)
            for item in items {
                write_value(w, item)
            }
            end_array(w)
        }
        Object(members) => {
            start_object(w)
            for m in members {
                property(w, m.name)
                write_value(w, m.value)
            }
            end_object(w)
        }
    }
}

pub fn stringify(v: Value, indent: i64) -> str {
    let w = writer(indent)
    write_value(w, v)
    written_text(w)
}
