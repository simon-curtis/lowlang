import std/serde

/// A JSON value (RFC 8259) held in memory.
///
/// `parse` builds one and `stringify` writes one.
pub enum Value {
    /// The literal `null`.
    Null
    /// The literal `true` or `false`.
    Bool(value: bool)
    /// A number written without a fraction or exponent that fits an `i64`.
    Int(value: i64)
    /// Any other number: one with a fraction or an exponent, or an integer outside the `i64` range.
    Float(value: f64)
    /// A string, with its escapes decoded.
    Str(value: str)
    /// An array, in order.
    Array(items: []Value)
    /// An object, as members in the order they appear. Names may repeat; the lookup functions use the first.
    Object(members: []Member)
}

/// A name and value pair of an `Object`.
pub struct Member {
    /// The member name, with its escapes decoded.
    pub name: str
    /// The member value.
    pub value: Value
}

/// Parses `data` as one JSON text into a `Value`.
///
/// The input is UTF-8 and follows RFC 8259 strictly: no comments, no trailing commas, no leading zeros, no control characters in strings, and invalid UTF-8 is rejected. A leading byte order mark and whitespace around the value are accepted. A number without a fraction or exponent that fits an `i64` becomes `Int`, any other number `Float`. A lone surrogate escape in a string becomes `U+FFFD`. Duplicate member names are kept. Nesting deeper than `64` fails with `serde.Error.TooDeep`. Other failures, including empty input and data after the value, are `serde.Error.Syntax` at the byte offset of the problem.
pub fn parse(data: []u8) -> Value ! serde.Error {
    let r = reader(data)
    read(r)?
    let v = parse_value(r)?
    if read(r)? {
        fail serde.Error.Syntax(position(r), "data after the top-level value")
    }
    v
}

fn parse_value(r: *Reader) -> Value ! serde.Error {
    let t = token(r)
    if t == StartObject {
        var members: []Member = []
        for {
            read(r)?
            if token(r) == EndObject {
                return Object(members)
            }
            let name = get_string(r)?
            read(r)?
            push(mut members, Member { name, value: parse_value(r)? })
        }
    }
    if t == StartArray {
        var items: []Value = []
        for {
            read(r)?
            if token(r) == EndArray {
                return Array(items)
            }
            push(mut items, parse_value(r)?)
        }
    }
    if t == String {
        return Str(get_string(r)?)
    }
    if t == Number {
        let n = get_i64(r) catch {
            _ => return Float(get_f64(r)?)
        }
        return Int(n)
    }
    if t == True || t == False {
        return Bool(t == True)
    }
    Null
}

/// Returns the value of the first member of the object `v` called `name`, or `none` when `v` is not an object or has no such member.
pub fn get(v: Value, name: str) -> Value? {
    match v {
        Object(members) => {
            for m in members {
                if m.name == name {
                    return m.value
                }
            }
            none
        }
        _ => none
    }
}

/// Returns the element of the array `v` at `index`, or `none` when `v` is not an array or `index` is out of range, including a negative `index`.
pub fn at(v: Value, index: i64) -> Value? {
    match v {
        Array(items) => {
            if index >= 0 && index < items.len {
                return items[index]
            }
            none
        }
        _ => none
    }
}

/// Returns whether `a` and `b` are equal as JSON values.
///
/// An `Int` equals a `Float` of the same numeric value. Objects are equal when they have the same members regardless of order, and arrays when they have equal elements in the same order. Values of different kinds are not equal, so `Null` equals only `Null`. A `Float` NaN equals nothing.
pub fn equal(a: Value, b: Value) -> bool {
    match a {
        Null => match b {
            Null => true
            _ => false
        }
        Bool(x) => match b {
            Bool(y) => x == y
            _ => false
        }
        Int(x) => match b {
            Int(y) => x == y
            Float(y) => f64(x) == y
            _ => false
        }
        Float(x) => match b {
            Int(y) => x == f64(y)
            Float(y) => x == y
            _ => false
        }
        Str(x) => match b {
            Str(y) => x == y
            _ => false
        }
        Array(x) => match b {
            Array(y) => equal_items(x, y)
            _ => false
        }
        Object(x) => match b {
            Object(y) => equal_members(x, y)
            _ => false
        }
    }
}

fn equal_items(a: []Value, b: []Value) -> bool {
    if a.len != b.len {
        return false
    }
    for i, item in a {
        if !equal(item, b[i]) {
            return false
        }
    }
    true
}

fn equal_members(a: []Member, b: []Member) -> bool {
    if a.len != b.len {
        return false
    }
    for m in a {
        let other = get(Object(b), m.name) ?? return false
        if !equal(m.value, other) {
            return false
        }
    }
    true
}

fn write_value(w: *Writer, v: Value) {
    match v {
        Null => null(w)
        Bool(b) => boolean(w, b)
        Int(n) => integer(w, n)
        Float(x) => float(w, x)
        Str(s) => string_value(w, s)
        Array(items) => {
            start_array(w)
            for item in items {
                write_value(w, item)
            }
            end_array(w)
        }
        Object(members) => {
            start_object(w)
            for m in members {
                property(w, m.name)
                write_value(w, m.value)
            }
            end_object(w)
        }
    }
}

/// Returns `v` as JSON text.
///
/// `indent` is the number of spaces per nesting level; `0` writes compact text with no whitespace, and a positive value puts each member and element on its own line. A non-finite `Float` is written as `null`, since JSON has no representation for it. See `Writer` for the escaping of strings.
pub fn stringify(v: Value, indent: i64) -> str {
    let w = writer(indent)
    write_value(w, v)
    written_text(w)
}
