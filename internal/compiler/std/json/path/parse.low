import std/json
import std/text
import std/unicode/utf16

struct Parser {
    src: str
    pos: i64
}

fn peek(p: Parser) -> u8 {
    peek_at(p, 0)
}

fn peek_at(p: Parser, n: i64) -> u8 {
    if p.pos + n < p.src.len {
        p.src[p.pos + n]
    } else {
        0
    }
}

fn blank(c: u8) -> bool {
    c == ' ' || c == '\t' || c == '\n' || c == '\r'
}

fn digit(c: u8) -> bool {
    c >= '0' && c <= '9'
}

fn lower(c: u8) -> bool {
    c >= 'a' && c <= 'z'
}

fn name_first(c: u8) -> bool {
    c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c == '_' || c >= 0x80
}

fn skip_blank(mut p: Parser) {
    for blank(peek(p)) {
        p.pos += 1
    }
}

fn parse_path(source: str) -> Query ! Error {
    var p = Parser { src: source, pos: 0 }
    if peek(p) != '$' {
        fail Syntax(0, "a query starts with $")
    }
    p.pos += 1
    let segments = parse_segments(mut p)?
    if p.pos < source.len {
        fail Syntax(p.pos, "unexpected character")
    }
    Query { root: true, segments }
}

fn parse_segments(mut p: Parser) -> []Segment ! Error {
    var segments: []Segment = []
    for {
        let save = p.pos
        skip_blank(mut p)
        let c = peek(p)
        if c == '[' {
            let selectors = parse_bracket(mut p)?
            push(mut segments, Segment { descendant: false, selectors })
        } else if c == '.' {
            let segment = parse_dot(mut p)?
            push(mut segments, segment)
        } else {
            p.pos = save
            break
        }
    }
    segments
}

fn parse_dot(mut p: Parser) -> Segment ! Error {
    var descendant = false
    p.pos += 1
    if peek(p) == '.' {
        descendant = true
        p.pos += 1
        if peek(p) == '[' {
            let selectors = parse_bracket(mut p)?
            return Segment { descendant, selectors }
        }
    }
    if peek(p) == '*' {
        p.pos += 1
        return Segment { descendant, selectors: [Selector.Wildcard] }
    }
    let name = parse_shorthand(mut p)?
    Segment { descendant, selectors: [Selector.Name(name)] }
}

fn parse_shorthand(mut p: Parser) -> str ! Error {
    let begin = p.pos
    if !name_first(peek(p)) {
        fail Syntax(p.pos, "expected a member name")
    }
    for name_first(peek(p)) || digit(peek(p)) {
        p.pos += 1
    }
    p.src[begin..p.pos]
}

fn parse_bracket(mut p: Parser) -> []Selector ! Error {
    p.pos += 1
    var selectors: []Selector = []
    for {
        skip_blank(mut p)
        let selector = parse_selector(mut p)?
        push(mut selectors, selector)
        skip_blank(mut p)
        let c = peek(p)
        if c == ']' {
            p.pos += 1
            break
        }
        if c != ',' {
            fail Syntax(p.pos, "expected , or ]")
        }
        p.pos += 1
    }
    selectors
}

fn parse_selector(mut p: Parser) -> Selector ! Error {
    let c = peek(p)
    if c == '\'' || c == '"' {
        let name = parse_string(mut p)?
        return Selector.Name(name)
    }
    if c == '*' {
        p.pos += 1
        return Selector.Wildcard
    }
    if c == '?' {
        p.pos += 1
        skip_blank(mut p)
        let expr = parse_or(mut p)?
        return Selector.Filter(new(expr))
    }
    parse_index_or_slice(mut p)?
}

fn at_int(p: Parser) -> bool {
    peek(p) == '-' || digit(peek(p))
}

fn parse_index_or_slice(mut p: Parser) -> Selector ! Error {
    var start: i64? = none
    if at_int(p) {
        start = parse_int(mut p)?
    }
    skip_blank(mut p)
    if peek(p) != ':' {
        let index = start ?? fail Syntax(p.pos, "expected a selector")
        return Selector.Index(index)
    }
    p.pos += 1
    skip_blank(mut p)
    var end: i64? = none
    if at_int(p) {
        end = parse_int(mut p)?
    }
    skip_blank(mut p)
    var step = 1
    if peek(p) == ':' {
        p.pos += 1
        skip_blank(mut p)
        if at_int(p) {
            step = parse_int(mut p)?
        }
    }
    Selector.Slice(start, end, step)
}

fn parse_int(mut p: Parser) -> i64 ! Error {
    let begin = p.pos
    if peek(p) == '-' {
        p.pos += 1
    }
    let first = p.pos
    for digit(peek(p)) {
        p.pos += 1
    }
    let count = p.pos - first
    if count == 0 {
        fail Syntax(begin, "expected digits")
    }
    if count > 1 && p.src[first] == '0' {
        fail Syntax(begin, "leading zeros are not allowed")
    }
    if count > 16 {
        fail Syntax(begin, "integer outside the exact range")
    }
    let n = text.parse_int(p.src[begin..p.pos]) catch 0
    if n == 0 && first > begin {
        fail Syntax(begin, "-0 is not allowed")
    }
    if n > 9007199254740991 || n < -9007199254740991 {
        fail Syntax(begin, "integer outside the exact range")
    }
    n
}

fn parse_string(mut p: Parser) -> str ! Error {
    let quote = peek(p)
    p.pos += 1
    var out: []u8 = []
    for {
        if p.pos >= p.src.len {
            fail Syntax(p.pos, "unterminated string")
        }
        let c = p.src[p.pos]
        if c == quote {
            p.pos += 1
            break
        }
        if c < 0x20 {
            fail Syntax(p.pos, "control character in string")
        }
        p.pos += 1
        if c != '\\' {
            push(mut out, c)
            continue
        }
        parse_escape(mut p, quote, mut out)?
    }
    str(out)
}

fn parse_escape(mut p: Parser, quote: u8, mut out: []u8) ! Error {
    let at = p.pos - 1
    let c = peek(p)
    p.pos += 1
    if c == 'b' {
        push(mut out, 8)
    } else if c == 'f' {
        push(mut out, 12)
    } else if c == 'n' {
        push(mut out, 10)
    } else if c == 'r' {
        push(mut out, 13)
    } else if c == 't' {
        push(mut out, 9)
    } else if c == '/' || c == '\\' || c == quote {
        push(mut out, c)
    } else if c == 'u' {
        let code = parse_unicode(mut p, at)?
        text.append_char(mut out, code)
    } else {
        fail Syntax(at, "invalid escape")
    }
}

fn hex4(mut p: Parser) -> u16 ! Error {
    var n: u16 = 0
    for _ in 0..4 {
        let d = text.hex_digit(peek(p))
        if d < 0 {
            fail Syntax(p.pos, "expected four hex digits")
        }
        n = n * 16 + u16(d)
        p.pos += 1
    }
    n
}

fn parse_unicode(mut p: Parser, at: i64) -> u32 ! Error {
    let high = hex4(mut p)?
    if utf16.is_low_surrogate(high) {
        fail Syntax(at, "unpaired surrogate")
    }
    if !utf16.is_high_surrogate(high) {
        return u32(high)
    }
    if peek(p) != '\\' || peek_at(p, 1) != 'u' {
        fail Syntax(at, "unpaired surrogate")
    }
    p.pos += 2
    let low = hex4(mut p)?
    if !utf16.is_low_surrogate(low) {
        fail Syntax(at, "unpaired surrogate")
    }
    utf16.join(high, low)
}

fn parse_or(mut p: Parser) -> Expr ! Error {
    var left = parse_and(mut p)?
    for {
        let save = p.pos
        skip_blank(mut p)
        if peek(p) != '|' || peek_at(p, 1) != '|' {
            p.pos = save
            break
        }
        p.pos += 2
        let right = parse_and(mut p)?
        let l = new(left)
        let r = new(right)
        left = Expr.Or(l, r)
    }
    left
}

fn parse_and(mut p: Parser) -> Expr ! Error {
    var left = parse_basic(mut p)?
    for {
        let save = p.pos
        skip_blank(mut p)
        if peek(p) != '&' || peek_at(p, 1) != '&' {
            p.pos = save
            break
        }
        p.pos += 2
        let right = parse_basic(mut p)?
        let l = new(left)
        let r = new(right)
        left = Expr.And(l, r)
    }
    left
}

fn parse_basic(mut p: Parser) -> Expr ! Error {
    skip_blank(mut p)
    if peek(p) == '!' {
        p.pos += 1
        skip_blank(mut p)
        let inner = parse_test(mut p)?
        return Expr.Not(new(inner))
    }
    if peek(p) == '(' {
        return parse_paren(mut p)?
    }
    let start = p.pos
    let left = parse_operand(mut p)?
    let after = p.pos
    skip_blank(mut p)
    let op = parse_compare(mut p) ?? {
        p.pos = after
        return test_expression(left, start)?
    }
    check_comparable(left, start)?
    skip_blank(mut p)
    let rstart = p.pos
    let right = parse_operand(mut p)?
    check_comparable(right, rstart)?
    Expr.Compare(left, op, right)
}

fn parse_test(mut p: Parser) -> Expr ! Error {
    if peek(p) == '(' {
        return parse_paren(mut p)?
    }
    let start = p.pos
    let operand = parse_operand(mut p)?
    test_expression(operand, start)?
}

fn parse_paren(mut p: Parser) -> Expr ! Error {
    p.pos += 1
    skip_blank(mut p)
    let inner = parse_or(mut p)?
    skip_blank(mut p)
    if peek(p) != ')' {
        fail Syntax(p.pos, "expected )")
    }
    p.pos += 1
    inner
}

fn parse_compare(mut p: Parser) -> Cmp? {
    let c = peek(p)
    let next = peek_at(p, 1)
    if next == '=' {
        var found: Cmp? = none
        if c == '=' {
            found = Cmp.Eq
        } else if c == '!' {
            found = Cmp.Ne
        } else if c == '<' {
            found = Cmp.Le
        } else if c == '>' {
            found = Cmp.Ge
        }
        if found != none {
            p.pos += 2
        }
        return found
    }
    if c == '<' {
        p.pos += 1
        return Cmp.Lt
    }
    if c == '>' {
        p.pos += 1
        return Cmp.Gt
    }
    none
}

fn singular(q: Query) -> bool {
    for s in q.segments {
        if s.descendant || s.selectors.len != 1 {
            return false
        }
        match s.selectors[0] {
            Name(_) => {}
            Index(_) => {}
            _ => return false
        }
    }
    true
}

fn yields_value(f: Function) -> bool {
    f == Length || f == Count || f == Value
}

fn check_comparable(o: Operand, at: i64) ! Error {
    match o {
        Literal(_) => {}
        Query(q) => {
            if !singular(q) {
                fail Syntax(at, "a query in a comparison must be singular")
            }
        }
        Call(c) => {
            if !yields_value(c.function) {
                fail Syntax(at, "a boolean function cannot be compared")
            }
        }
    }
}

fn test_expression(o: Operand, at: i64) -> Expr ! Error {
    match o {
        Literal(_) => fail Syntax(at, "a literal is not a test")
        Query(q) => Expr.Exists(q)
        Call(c) => {
            if yields_value(c.function) {
                fail Syntax(at, "a function that yields a value must be compared")
            }
            Expr.Test(c)
        }
    }
}

fn parse_operand(mut p: Parser) -> Operand ! Error {
    let c = peek(p)
    if c == '@' || c == '$' {
        let q = parse_filter_query(mut p)?
        return Operand.Query(q)
    }
    if c == '\'' || c == '"' {
        let s = parse_string(mut p)?
        return Operand.Literal(json.Value.Str(s))
    }
    if c == '-' || digit(c) {
        let n = parse_number(mut p)?
        return Operand.Literal(n)
    }
    if !lower(c) {
        fail Syntax(p.pos, "expected an expression")
    }
    let begin = p.pos
    for lower(peek(p)) || digit(peek(p)) || peek(p) == '_' {
        p.pos += 1
    }
    let name = p.src[begin..p.pos]
    if peek(p) == '(' {
        let call = parse_call(mut p, name, begin)?
        return Operand.Call(call)
    }
    if name == "true" {
        return Operand.Literal(json.Value.Bool(true))
    }
    if name == "false" {
        return Operand.Literal(json.Value.Bool(false))
    }
    if name == "null" {
        return Operand.Literal(json.Value.Null)
    }
    fail Syntax(begin, "unknown literal {name}")
}

fn parse_filter_query(mut p: Parser) -> Query ! Error {
    let root = peek(p) == '$'
    p.pos += 1
    let segments = parse_segments(mut p)?
    Query { root, segments }
}

fn parse_number(mut p: Parser) -> json.Value ! Error {
    let begin = p.pos
    if peek(p) == '-' {
        p.pos += 1
    }
    let first = p.pos
    for digit(peek(p)) {
        p.pos += 1
    }
    if p.pos == first {
        fail Syntax(begin, "expected digits")
    }
    if p.pos - first > 1 && p.src[first] == '0' {
        fail Syntax(begin, "leading zeros are not allowed")
    }
    var real = false
    if peek(p) == '.' {
        real = true
        p.pos += 1
        let fraction = p.pos
        for digit(peek(p)) {
            p.pos += 1
        }
        if p.pos == fraction {
            fail Syntax(fraction, "expected digits after the decimal point")
        }
    }
    if peek(p) == 'e' || peek(p) == 'E' {
        real = true
        p.pos += 1
        if peek(p) == '+' || peek(p) == '-' {
            p.pos += 1
        }
        let exponent = p.pos
        for digit(peek(p)) {
            p.pos += 1
        }
        if p.pos == exponent {
            fail Syntax(exponent, "expected exponent digits")
        }
    }
    let literal = p.src[begin..p.pos]
    if !real {
        let n = text.parse_int(literal) catch {
            _ => return json.Value.Float(text.parse_float(literal) catch 0.0)
        }
        return json.Value.Int(n)
    }
    json.Value.Float(text.parse_float(literal) catch 0.0)
}

fn function_named(name: str) -> Function? {
    if name == "length" {
        return Function.Length
    }
    if name == "count" {
        return Function.Count
    }
    if name == "match" {
        return Function.Match
    }
    if name == "search" {
        return Function.Search
    }
    if name == "value" {
        return Function.Value
    }
    none
}

fn parse_call(mut p: Parser, name: str, at: i64) -> Call ! Error {
    let function = function_named(name) ?? fail Syntax(at, "unknown function {name}")
    p.pos += 1
    var args: []Operand = []
    skip_blank(mut p)
    if peek(p) == ')' {
        p.pos += 1
    } else {
        for {
            skip_blank(mut p)
            let arg = parse_operand(mut p)?
            push(mut args, arg)
            skip_blank(mut p)
            let c = peek(p)
            p.pos += 1
            if c == ')' {
                break
            }
            if c != ',' {
                fail Syntax(p.pos - 1, "expected , or )")
            }
        }
    }
    let call = Call { function, args }
    check_call(call, at)?
    call
}

fn arity(f: Function) -> i64 {
    if f == Match || f == Search { 2 } else { 1 }
}

fn wants_nodes(f: Function) -> bool {
    f == Count || f == Value
}

fn check_call(call: Call, at: i64) ! Error {
    if call.args.len != arity(call.function) {
        fail Syntax(at, "wrong number of arguments")
    }
    for arg in call.args {
        if wants_nodes(call.function) {
            match arg {
                Query(_) => {}
                _ => fail Syntax(at, "the argument must be a query")
            }
        } else {
            check_value_argument(arg, at)?
        }
    }
}

fn check_value_argument(o: Operand, at: i64) ! Error {
    match o {
        Literal(_) => {}
        Query(q) => {
            if !singular(q) {
                fail Syntax(at, "the argument must be a singular query or a value")
            }
        }
        Call(c) => {
            if !yields_value(c.function) {
                fail Syntax(at, "the argument must be a value")
            }
        }
    }
}
