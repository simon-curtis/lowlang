import std/json

pub enum Error {
    Syntax(at: i64, message: str)
}

pub struct Node {
    pub value: json.Value
    pub path: str
}

pub struct Path {
    body: Query
}

struct Query {
    root: bool
    segments: []Segment
}

struct Segment {
    descendant: bool
    selectors: []Selector
}

enum Selector {
    Name(name: str)
    Wildcard
    Index(index: i64)
    Slice(start: i64?, end: i64?, step: i64)
    Filter(expr: *Expr)
}

enum Cmp {
    Eq
    Ne
    Lt
    Le
    Gt
    Ge
}

enum Function {
    Length
    Count
    Match
    Search
    Value
}

struct Call {
    function: Function
    args: []Operand
}

enum Operand {
    Literal(value: json.Value)
    Query(query: Query)
    Call(call: Call)
}

enum Expr {
    Or(left: *Expr, right: *Expr)
    And(left: *Expr, right: *Expr)
    Not(inner: *Expr)
    Compare(left: Operand, op: Cmp, right: Operand)
    Exists(query: Query)
    Test(call: Call)
}
