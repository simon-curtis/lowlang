import std/json

/// The error returned when a JSONPath query is invalid (RFC 9535).
pub enum Error {
    /// The query text is not a valid JSONPath query. `at` is the byte offset in the query where the problem is and `message` describes it, for example an unknown function, a comparison of a query that is not singular, or a literal outside the exact integer range.
    Syntax(at: i64, message: str)
}

/// A value selected by a query, with its location.
pub struct Node {
    /// The selected value.
    pub value: json.Value
    /// The normalised path of the value in the queried document, such as `$['store']['book'][0]`. Member names are single-quoted with `\'`, `\\` and control characters escaped, and array elements are written by index.
    pub path: str
}

/// A compiled JSONPath query, made by `compile`.
///
/// A `Path` can be used with `query` on any number of documents.
pub struct Path {
    body: Query
}

struct Query {
    root: bool
    segments: []Segment
}

struct Segment {
    descendant: bool
    selectors: []Selector
}

enum Selector {
    Name(name: str)
    Wildcard
    Index(index: i64)
    Slice(start: i64?, end: i64?, step: i64)
    Filter(expr: *Expr)
}

enum Cmp {
    Eq
    Ne
    Lt
    Le
    Gt
    Ge
}

enum Function {
    Length
    Count
    Match
    Search
    Value
}

struct Call {
    function: Function
    args: []Operand
}

enum Operand {
    Literal(value: json.Value)
    Query(query: Query)
    Call(call: Call)
}

enum Expr {
    Or(left: *Expr, right: *Expr)
    And(left: *Expr, right: *Expr)
    Not(inner: *Expr)
    Compare(left: Operand, op: Cmp, right: Operand)
    Exists(query: Query)
    Test(call: Call)
}
