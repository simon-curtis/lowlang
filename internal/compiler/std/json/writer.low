import std/text

pub struct Writer {
    out: []u8
    counts: []i64
    indent: i64
    pending_name: bool
}

pub fn writer(indent: i64) -> *Writer {
    new(Writer { out: [], counts: [], indent, pending_name: false })
}

pub fn written_bytes(w: *Writer) -> []u8 {
    w.out
}

pub fn written_text(w: *Writer) -> str {
    __str_view(w.out)
}

fn newline(w: *Writer) {
    if w.indent == 0 {
        return
    }
    push(mut w.out, '\n')
    for _ in 0..w.counts.len * w.indent {
        push(mut w.out, ' ')
    }
}

fn separate(w: *Writer) {
    if w.pending_name {
        w.pending_name = false
        return
    }
    if w.counts.len == 0 {
        return
    }
    let last = w.counts.len - 1
    if w.counts[last] > 0 {
        push(mut w.out, ',')
    }
    w.counts[last] += 1
    newline(w)
}

fn open_container(w: *Writer, c: u8) {
    separate(w)
    push(mut w.out, c)
    push(mut w.counts, 0)
}

fn close_container(w: *Writer, c: u8) {
    let had = w.counts[w.counts.len - 1] > 0
    truncate(mut w.counts, w.counts.len - 1)
    if had {
        newline(w)
    }
    push(mut w.out, c)
}

pub fn start_object(w: *Writer) {
    open_container(w, '{')
}

pub fn end_object(w: *Writer) {
    close_container(w, '}')
}

pub fn start_array(w: *Writer) {
    open_container(w, '[')
}

pub fn end_array(w: *Writer) {
    close_container(w, ']')
}

pub fn property(w: *Writer, name: str) {
    separate(w)
    quote(w, name)
    push(mut w.out, ':')
    if w.indent > 0 {
        push(mut w.out, ' ')
    }
    w.pending_name = true
}

pub fn string_value(w: *Writer, s: str) {
    separate(w)
    quote(w, s)
}

pub fn integer(w: *Writer, n: i64) {
    separate(w)
    text.append(mut w.out, "{n}")
}

pub fn unsigned(w: *Writer, n: u64) {
    separate(w)
    text.append(mut w.out, "{n}")
}

pub fn float(w: *Writer, x: f64) {
    separate(w)
    let bits = text.float_bits(x)
    if bits & 0x7FF0000000000000 == 0x7FF0000000000000 {
        text.append(mut w.out, "null")
        return
    }
    text.append(mut w.out, "{x}")
}

pub fn boolean(w: *Writer, v: bool) {
    separate(w)
    text.append(mut w.out, if v { "true" } else { "false" })
}

pub fn null(w: *Writer) {
    separate(w)
    text.append(mut w.out, "null")
}

pub fn raw(w: *Writer, json: str) {
    separate(w)
    text.append(mut w.out, json)
}

fn quote(w: *Writer, s: str) {
    let digits = "0123456789abcdef"
    push(mut w.out, '"')
    for i in 0..s.len {
        let c = s[i]
        if c == '"' || c == '\\' {
            push(mut w.out, '\\')
            push(mut w.out, c)
        } else if c == '\n' {
            text.append(mut w.out, "\\n")
        } else if c == '\r' {
            text.append(mut w.out, "\\r")
        } else if c == '\t' {
            text.append(mut w.out, "\\t")
        } else if c < 0x20 {
            text.append(mut w.out, "\\u00")
            push(mut w.out, digits[c >> 4])
            push(mut w.out, digits[c & 0xF])
        } else {
            push(mut w.out, c)
        }
    }
    push(mut w.out, '"')
}
