import std/serde
import std/simd
import std/text

pub enum Token {
    None
    StartObject
    EndObject
    StartArray
    EndArray
    PropertyName
    String
    Number
    True
    False
    Null
}

pub struct Reader {
    data: []u8
    pos: i64
    token: Token
    start: i64
    end: i64
    escaped: bool
    containers: []u8
    expect_value: bool
    after_name: bool
    first: bool
    done: bool
    max_depth: i64
}

pub fn reader(data: []u8) -> *Reader {
    var start = 0
    if data.len >= 3 && data[0] == 0xEF && data[1] == 0xBB && data[2] == 0xBF {
        start = 3
    }
    new(Reader {
        data
        pos: start
        token: None
        start: 0
        end: 0
        escaped: false
        containers: []
        expect_value: true
        after_name: false
        first: true
        done: false
        max_depth: 64
    })
}

fn syntax(r: *Reader, message: str) -> serde.Error {
    serde.Error.Syntax(r.pos, message)
}

fn whitespace(c: u8) -> bool {
    c == ' ' || c == '\t' || c == '\n' || c == '\r'
}

fn skip_space(r: *Reader) {
    for r.pos < r.data.len && whitespace(r.data[r.pos]) {
        r.pos += 1
    }
}

pub fn token(r: *Reader) -> Token {
    r.token
}

pub fn depth(r: *Reader) -> i64 {
    r.containers.len
}

pub fn position(r: *Reader) -> i64 {
    r.pos
}

pub fn value_bytes(r: *Reader) -> []u8 {
    r.data[r.start..r.end]
}

fn in_object(r: *Reader) -> bool {
    r.containers.len > 0 && r.containers[r.containers.len - 1] == '{'
}

fn open(r: *Reader, kind: u8, t: Token) -> bool ! serde.Error {
    if r.containers.len >= r.max_depth {
        fail serde.Error.TooDeep
    }
    push(mut r.containers, kind)
    r.token = t
    r.start = r.pos
    r.pos += 1
    r.end = r.pos
    r.first = true
    r.after_name = false
    r.expect_value = kind == '['
    true
}

fn close(r: *Reader, kind: u8, t: Token) -> bool ! serde.Error {
    if r.containers.len == 0 || r.containers[r.containers.len - 1] != kind || r.after_name {
        fail syntax(r, "unexpected closing bracket")
    }
    if r.expect_value && !r.first {
        fail syntax(r, "trailing comma")
    }
    r.containers = r.containers[..r.containers.len - 1]
    r.token = t
    r.start = r.pos
    r.pos += 1
    r.end = r.pos
    finish_value(r)
    true
}

fn finish_value(r: *Reader) {
    r.first = false
    r.after_name = false
    r.expect_value = false
    if r.containers.len == 0 {
        r.done = true
    }
}

pub fn read(r: *Reader) -> bool ! serde.Error {
    skip_space(r)
    if r.done {
        if r.pos < r.data.len {
            fail syntax(r, "data after the top-level value")
        }
        r.token = None
        return false
    }
    if r.pos >= r.data.len {
        fail syntax(r, "unexpected end of data")
    }
    let c = r.data[r.pos]
    if c == '}' {
        return close(r, '{', EndObject)
    }
    if c == ']' {
        return close(r, '[', EndArray)
    }
    if r.containers.len > 0 && !r.first && !r.expect_value && !r.after_name {
        if c != ',' {
            fail syntax(r, "expected ',' or a closing bracket")
        }
        r.pos += 1
        skip_space(r)
        r.expect_value = !in_object(r)
        if r.pos >= r.data.len {
            fail syntax(r, "unexpected end of data")
        }
    }
    if in_object(r) && !r.after_name {
        return read_property(r)
    }
    read_value(r)
}

fn read_property(r: *Reader) -> bool ! serde.Error {
    if r.data[r.pos] != '"' {
        fail syntax(r, "expected a property name")
    }
    scan_string(r)?
    r.token = PropertyName
    skip_space(r)
    if r.pos >= r.data.len || r.data[r.pos] != ':' {
        fail syntax(r, "expected ':'")
    }
    r.pos += 1
    r.after_name = true
    r.expect_value = true
    true
}

fn read_value(r: *Reader) -> bool ! serde.Error {
    let c = r.data[r.pos]
    if c == '{' {
        return open(r, '{', StartObject)
    }
    if c == '[' {
        return open(r, '[', StartArray)
    }
    if c == '"' {
        scan_string(r)?
        r.token = String
    } else if c == '-' || c >= '0' && c <= '9' {
        scan_number(r)?
        r.token = Number
    } else if read_literal(r, "true") {
        r.token = True
    } else if read_literal(r, "false") {
        r.token = False
    } else if read_literal(r, "null") {
        r.token = Null
    } else {
        fail syntax(r, "expected a value")
    }
    finish_value(r)
    true
}

fn read_literal(r: *Reader, word: str) -> bool {
    if r.pos + word.len > r.data.len {
        return false
    }
    for i in 0..word.len {
        if r.data[r.pos + i] != word[i] {
            return false
        }
    }
    r.start = r.pos
    r.pos += word.len
    r.end = r.pos
    true
}

fn scan_string(r: *Reader) ! serde.Error {
    r.pos += 1
    r.start = r.pos
    r.escaped = false
    let quote: u8x32 = simd.splat[u8x32, u8]('"')
    let backslash: u8x32 = simd.splat[u8x32, u8]('\\')
    let control: u8x32 = simd.splat[u8x32, u8](0x20)
    let ascii: u8x32 = simd.splat[u8x32, u8](0x7F)
    for r.pos < r.data.len {
        if r.pos + 32 <= r.data.len {
            let chunk: u8x32 = simd.read(r.data, r.pos)
            let special = simd.mask((chunk == quote) | (chunk == backslash) | (chunk < control) | (chunk > ascii))
            if special == 0 {
                r.pos += 32
                continue
            }
            r.pos += simd.trailing_zeros(special)
        }
        let c = r.data[r.pos]
        if c == '"' {
            r.end = r.pos
            r.pos += 1
            return
        }
        if c < 0x20 {
            fail syntax(r, "control character in string")
        }
        if c == '\\' {
            r.escaped = true
            r.pos += 1
            if r.pos >= r.data.len {
                break
            }
            let e = r.data[r.pos]
            if e == 'u' {
                for k in 1..5 {
                    if r.pos + k >= r.data.len || hex_value(r.data[r.pos + k]) < 0 {
                        fail syntax(r, "bad \\u escape")
                    }
                }
                r.pos += 4
            } else if text.index_byte("\"\\/bfnrt", e) < 0 {
                fail syntax(r, "bad escape")
            }
        } else if c >= 0x80 {
            let size = utf8_size(r.data, r.pos)
            if size == 0 {
                fail syntax(r, "invalid UTF-8")
            }
            r.pos += size - 1
        }
        r.pos += 1
    }
    fail syntax(r, "unterminated string")
}

fn utf8_size(b: []u8, at: i64) -> i64 {
    let c = b[at]
    var size = 0
    var min: u32 = 0
    var code: u32 = 0
    if c & 0xE0 == 0xC0 {
        size = 2
        min = 0x80
        code = u32(c & 0x1F)
    } else if c & 0xF0 == 0xE0 {
        size = 3
        min = 0x800
        code = u32(c & 0x0F)
    } else if c & 0xF8 == 0xF0 {
        size = 4
        min = 0x10000
        code = u32(c & 0x07)
    } else {
        return 0
    }
    if at + size > b.len {
        return 0
    }
    for k in 1..size {
        let next = b[at + k]
        if next & 0xC0 != 0x80 {
            return 0
        }
        code = code << 6 | u32(next & 0x3F)
    }
    if code < min || code > 0x10FFFF || code >= 0xD800 && code < 0xE000 {
        return 0
    }
    size
}

fn hex_value(c: u8) -> i64 {
    if c >= '0' && c <= '9' {
        return i64(c - '0')
    }
    if c >= 'a' && c <= 'f' {
        return i64(c - 'a') + 10
    }
    if c >= 'A' && c <= 'F' {
        return i64(c - 'A') + 10
    }
    -1
}

fn digits(r: *Reader) -> i64 {
    let from = r.pos
    for r.pos < r.data.len && r.data[r.pos] >= '0' && r.data[r.pos] <= '9' {
        r.pos += 1
    }
    r.pos - from
}

fn scan_number(r: *Reader) ! serde.Error {
    r.start = r.pos
    if r.data[r.pos] == '-' {
        r.pos += 1
    }
    if r.pos < r.data.len && r.data[r.pos] == '0' {
        r.pos += 1
    } else if digits(r) == 0 {
        fail syntax(r, "expected a digit")
    }
    if r.pos < r.data.len && r.data[r.pos] == '.' {
        r.pos += 1
        if digits(r) == 0 {
            fail syntax(r, "expected a digit after '.'")
        }
    }
    if r.pos < r.data.len && (r.data[r.pos] == 'e' || r.data[r.pos] == 'E') {
        r.pos += 1
        if r.pos < r.data.len && (r.data[r.pos] == '+' || r.data[r.pos] == '-') {
            r.pos += 1
        }
        if digits(r) == 0 {
            fail syntax(r, "expected an exponent")
        }
    }
    r.end = r.pos
}

fn append_code(mut out: []u8, code: u32) {
    if code < 0x80 {
        push(mut out, u8(code))
    } else if code < 0x800 {
        push(mut out, u8(0xC0 | code >> 6))
        push(mut out, u8(0x80 | code & 0x3F))
    } else if code < 0x10000 {
        push(mut out, u8(0xE0 | code >> 12))
        push(mut out, u8(0x80 | code >> 6 & 0x3F))
        push(mut out, u8(0x80 | code & 0x3F))
    } else {
        push(mut out, u8(0xF0 | code >> 18))
        push(mut out, u8(0x80 | code >> 12 & 0x3F))
        push(mut out, u8(0x80 | code >> 6 & 0x3F))
        push(mut out, u8(0x80 | code & 0x3F))
    }
}

fn hex4(b: []u8, at: i64) -> u32 {
    var v: u32 = 0
    for k in 0..4 {
        v = v << 4 | u32(hex_value(b[at + k]))
    }
    v
}

pub fn get_string(r: *Reader) -> str ! serde.Error {
    if r.token != String && r.token != PropertyName {
        fail serde.Error.Mismatch("string", r.start)
    }
    let raw = r.data[r.start..r.end]
    if !r.escaped {
        return __str_view(raw)
    }
    var out: []u8 = []
    var i = 0
    for i < raw.len {
        let c = raw[i]
        if c != '\\' {
            push(mut out, c)
            i += 1
            continue
        }
        let e = raw[i + 1]
        i += 2
        if e == 'u' {
            var code = hex4(raw, i)
            i += 4
            if code >= 0xD800 && code < 0xDC00 && i + 6 <= raw.len && raw[i] == '\\' && raw[i + 1] == 'u' {
                let low = hex4(raw, i + 2)
                if low >= 0xDC00 && low < 0xE000 {
                    code = 0x10000 + ((code - 0xD800) << 10 | (low - 0xDC00))
                    i += 6
                }
            }
            if code >= 0xD800 && code < 0xE000 {
                code = 0xFFFD
            }
            append_code(mut out, code)
        } else if e == 'n' {
            push(mut out, '\n')
        } else if e == 't' {
            push(mut out, '\t')
        } else if e == 'r' {
            push(mut out, '\r')
        } else if e == 'b' {
            push(mut out, 8)
        } else if e == 'f' {
            push(mut out, 12)
        } else {
            push(mut out, e)
        }
    }
    __str_view(out)
}

fn number_text(r: *Reader) -> str ! serde.Error {
    if r.token != Number {
        fail serde.Error.Mismatch("number", r.start)
    }
    __str_view(r.data[r.start..r.end])
}

pub fn get_i64(r: *Reader) -> i64 ! serde.Error {
    let s = number_text(r)?
    let negative = s[0] == '-'
    var n: u64 = 0
    for i in (if negative { 1 } else { 0 })..s.len {
        let c = s[i]
        if c < '0' || c > '9' {
            fail serde.Error.Mismatch("integer", r.start)
        }
        let d = u64(c - '0')
        if n > (0xFFFFFFFFFFFFFFFF - d) / 10 {
            fail serde.Error.Range(r.start)
        }
        n = n * 10 + d
    }
    if negative {
        if n > 0x8000000000000000 {
            fail serde.Error.Range(r.start)
        }
        return i64(0 - n)
    }
    if n > 0x7FFFFFFFFFFFFFFF {
        fail serde.Error.Range(r.start)
    }
    i64(n)
}

pub fn get_u64(r: *Reader) -> u64 ! serde.Error {
    let s = number_text(r)?
    var n: u64 = 0
    for i in 0..s.len {
        let c = s[i]
        if c < '0' || c > '9' {
            fail serde.Error.Mismatch("unsigned integer", r.start)
        }
        let d = u64(c - '0')
        if n > (0xFFFFFFFFFFFFFFFF - d) / 10 {
            fail serde.Error.Range(r.start)
        }
        n = n * 10 + d
    }
    n
}

pub fn get_f64(r: *Reader) -> f64 ! serde.Error {
    let s = number_text(r)?
    text.parse_float(s) catch {
        _ => fail serde.Error.Mismatch("number", r.start)
    }
}

pub fn get_bool(r: *Reader) -> bool ! serde.Error {
    if r.token == True {
        return true
    }
    if r.token != False {
        fail serde.Error.Mismatch("boolean", r.start)
    }
    false
}

pub fn skip(r: *Reader) ! serde.Error {
    if r.token == PropertyName {
        read(r)?
    }
    if r.token != StartObject && r.token != StartArray {
        return
    }
    let target = r.containers.len - 1
    for r.containers.len > target {
        read(r)?
    }
}
