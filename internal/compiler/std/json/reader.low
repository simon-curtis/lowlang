import std/bits
import std/serde
import std/simd
import std/text
import std/unicode
import std/unicode/utf16

/// The kind of the token a `Reader` is at.
pub enum Token {
    /// No token: the reader has not read yet, or has reached the end of the document.
    None
    /// `{`.
    StartObject
    /// `}`.
    EndObject
    /// `[`.
    StartArray
    /// `]`.
    EndArray
    /// An object member name, which `get_string` reads.
    PropertyName
    /// A string value, which `get_string` reads.
    String
    /// A number, which `get_i64`, `get_u64` and `get_f64` read.
    Number
    /// The literal `true`.
    True
    /// The literal `false`.
    False
    /// The literal `null`.
    Null
}

/// A pull tokenizer over one JSON text, made by `reader`.
///
/// `read` advances to the next token and the `get_` functions read the value of the current one. The reader checks the whole of RFC 8259 syntax, the validity of UTF-8 and the order of commas, colons and brackets, so a successful token sequence is a well-formed document. Strings, names and numbers are views of the input until a `get_` function converts them.
pub struct Reader {
    data: []u8
    pos: i64
    token: Token
    start: i64
    end: i64
    escaped: bool
    containers: []u8
    expect_value: bool
    after_name: bool
    first: bool
    done: bool
    max_depth: i64
}

/// Returns a reader over `data`, which is not copied.
///
/// A leading UTF-8 byte order mark is skipped. Nesting deeper than `64` containers fails with `serde.Error.TooDeep`.
pub fn reader(data: []u8) -> *Reader {
    var start = 0
    if data.len >= 3 && data[0] == 0xEF && data[1] == 0xBB && data[2] == 0xBF {
        start = 3
    }
    new(Reader {
        data
        pos: start
        token: None
        start: 0
        end: 0
        escaped: false
        containers: []
        expect_value: true
        after_name: false
        first: true
        done: false
        max_depth: 64
    })
}

fn syntax(r: *Reader, message: str) -> serde.Error {
    serde.Error.Syntax(r.pos, message)
}

fn whitespace(c: u8) -> bool {
    c == ' ' || c == '\t' || c == '\n' || c == '\r'
}

fn skip_space(r: *Reader) {
    for r.pos < r.data.len && whitespace(r.data[r.pos]) {
        r.pos += 1
    }
}

/// Returns the kind of the current token, or `None` before the first `read` and at the end of the document.
pub fn token(r: *Reader) -> Token {
    r.token
}

/// Returns the number of containers that are open at the current token.
///
/// After a `StartObject` or `StartArray` it counts that container, and after the matching end token it does not. It is `0` at the top level.
pub fn depth(r: *Reader) -> i64 {
    r.containers.len
}

/// Returns the byte offset in the input that the reader has reached, just past the current token, or past the colon for a `PropertyName`. Errors report it.
pub fn position(r: *Reader) -> i64 {
    r.pos
}

/// Returns the raw bytes of the current token as a view of the input: the text of a number or literal, the bracket of a container token, and, for a string or name, the characters between the quotes with any escapes still undecoded.
pub fn value_bytes(r: *Reader) -> []u8 {
    r.data[r.start..r.end]
}

fn in_object(r: *Reader) -> bool {
    r.containers.len > 0 && r.containers[r.containers.len - 1] == '{'
}

fn open(r: *Reader, kind: u8, t: Token) -> bool ! serde.Error {
    if r.containers.len >= r.max_depth {
        fail serde.Error.TooDeep
    }
    push(mut r.containers, kind)
    r.token = t
    r.start = r.pos
    r.pos += 1
    r.end = r.pos
    r.first = true
    r.after_name = false
    r.expect_value = kind == '['
    true
}

fn close(r: *Reader, kind: u8, t: Token) -> bool ! serde.Error {
    if r.containers.len == 0 || r.containers[r.containers.len - 1] != kind || r.after_name {
        fail syntax(r, "unexpected closing bracket")
    }
    if r.expect_value && !r.first {
        fail syntax(r, "trailing comma")
    }
    truncate(mut r.containers, r.containers.len - 1)
    r.token = t
    r.start = r.pos
    r.pos += 1
    r.end = r.pos
    finish_value(r)
    true
}

fn finish_value(r: *Reader) {
    r.first = false
    r.after_name = false
    r.expect_value = false
    if r.containers.len == 0 {
        r.done = true
    }
}

/// Advances to the next token and returns `true`, or returns `false` once the top-level value has been read completely and only whitespace remains, leaving the token as `None`.
///
/// An object member is two tokens, `PropertyName` and then the value. Fails with `serde.Error.Syntax` at the byte offset of malformed input, for example an unexpected character, a trailing comma, a bad escape, a control character or invalid UTF-8 in a string, an unterminated string, a number with a leading zero, an unexpected end of data or data after the top-level value, and with `TooDeep` when containers nest deeper than the reader allows.
pub fn read(r: *Reader) -> bool ! serde.Error {
    skip_space(r)
    if r.done {
        if r.pos < r.data.len {
            fail syntax(r, "data after the top-level value")
        }
        r.token = None
        return false
    }
    if r.pos >= r.data.len {
        fail syntax(r, "unexpected end of data")
    }
    let c = r.data[r.pos]
    if c == '}' {
        return close(r, '{', EndObject)
    }
    if c == ']' {
        return close(r, '[', EndArray)
    }
    if r.containers.len > 0 && !r.first && !r.expect_value && !r.after_name {
        if c != ',' {
            fail syntax(r, "expected ',' or a closing bracket")
        }
        r.pos += 1
        skip_space(r)
        r.expect_value = !in_object(r)
        if r.pos >= r.data.len {
            fail syntax(r, "unexpected end of data")
        }
    }
    if in_object(r) && !r.after_name {
        return read_property(r)
    }
    read_value(r)
}

fn read_property(r: *Reader) -> bool ! serde.Error {
    if r.data[r.pos] != '"' {
        fail syntax(r, "expected a property name")
    }
    scan_string(r)?
    r.token = PropertyName
    skip_space(r)
    if r.pos >= r.data.len || r.data[r.pos] != ':' {
        fail syntax(r, "expected ':'")
    }
    r.pos += 1
    r.after_name = true
    r.expect_value = true
    true
}

fn read_value(r: *Reader) -> bool ! serde.Error {
    let c = r.data[r.pos]
    if c == '{' {
        return open(r, '{', StartObject)
    }
    if c == '[' {
        return open(r, '[', StartArray)
    }
    if c == '"' {
        scan_string(r)?
        r.token = String
    } else if c == '-' || c >= '0' && c <= '9' {
        scan_number(r)?
        r.token = Number
    } else if read_literal(r, "true") {
        r.token = True
    } else if read_literal(r, "false") {
        r.token = False
    } else if read_literal(r, "null") {
        r.token = Null
    } else {
        fail syntax(r, "expected a value")
    }
    finish_value(r)
    true
}

fn read_literal(r: *Reader, word: str) -> bool {
    if r.pos + word.len > r.data.len {
        return false
    }
    for i in 0..word.len {
        if r.data[r.pos + i] != word[i] {
            return false
        }
    }
    r.start = r.pos
    r.pos += word.len
    r.end = r.pos
    true
}

fn scan_string(r: *Reader) ! serde.Error {
    r.pos += 1
    r.start = r.pos
    r.escaped = false
    let quote: u8x32 = simd.splat[u8x32, u8]('"')
    let backslash: u8x32 = simd.splat[u8x32, u8]('\\')
    let control: u8x32 = simd.splat[u8x32, u8](0x20)
    let ascii: u8x32 = simd.splat[u8x32, u8](0x7F)
    for r.pos < r.data.len {
        if r.pos + 32 <= r.data.len {
            let chunk: u8x32 = simd.read(r.data, r.pos)
            let special = simd.mask((chunk == quote) | (chunk == backslash) | (chunk < control) | (chunk > ascii))
            if special == 0 {
                r.pos += 32
                continue
            }
            r.pos += bits.trailing_zeros(special)
        }
        let c = r.data[r.pos]
        if c == '"' {
            r.end = r.pos
            r.pos += 1
            return
        }
        if c < 0x20 {
            fail syntax(r, "control character in string")
        }
        if c == '\\' {
            r.escaped = true
            r.pos += 1
            if r.pos >= r.data.len {
                break
            }
            let e = r.data[r.pos]
            if e == 'u' {
                for k in 1..5 {
                    if r.pos + k >= r.data.len || text.hex_digit(r.data[r.pos + k]) < 0 {
                        fail syntax(r, "bad \\u escape")
                    }
                }
                r.pos += 4
            } else if text.index_byte("\"\\/bfnrt", e) < 0 {
                fail syntax(r, "bad escape")
            }
        } else if c >= 0x80 {
            let size = utf8_size(r.data, r.pos)
            if size == 0 {
                fail syntax(r, "invalid UTF-8")
            }
            r.pos += size - 1
        }
        r.pos += 1
    }
    fail syntax(r, "unterminated string")
}

fn utf8_size(b: []u8, at: i64) -> i64 {
    let view = __str_view(b)
    let r = unicode.decode_rune(view, at)
    if r.size == 1 && r.code == 0xFFFD {
        return 0
    }
    r.size
}

fn digits(r: *Reader) -> i64 {
    let from = r.pos
    for r.pos < r.data.len && r.data[r.pos] >= '0' && r.data[r.pos] <= '9' {
        r.pos += 1
    }
    r.pos - from
}

fn scan_number(r: *Reader) ! serde.Error {
    r.start = r.pos
    if r.data[r.pos] == '-' {
        r.pos += 1
    }
    if r.pos < r.data.len && r.data[r.pos] == '0' {
        r.pos += 1
    } else if digits(r) == 0 {
        fail syntax(r, "expected a digit")
    }
    if r.pos < r.data.len && r.data[r.pos] == '.' {
        r.pos += 1
        if digits(r) == 0 {
            fail syntax(r, "expected a digit after '.'")
        }
    }
    if r.pos < r.data.len && (r.data[r.pos] == 'e' || r.data[r.pos] == 'E') {
        r.pos += 1
        if r.pos < r.data.len && (r.data[r.pos] == '+' || r.data[r.pos] == '-') {
            r.pos += 1
        }
        if digits(r) == 0 {
            fail syntax(r, "expected an exponent")
        }
    }
    r.end = r.pos
}

fn hex4(b: []u8, at: i64) -> u32 {
    var v: u32 = 0
    for k in 0..4 {
        v = v << 4 | u32(text.hex_digit(b[at + k]))
    }
    v
}

/// Returns the string of the current `String` or `PropertyName` token with its escapes decoded.
///
/// A `\u` surrogate pair becomes one character and a lone surrogate becomes `U+FFFD`. Fails with `serde.Error.Mismatch` when the token is neither. The string views the input when it has no escapes.
pub fn get_string(r: *Reader) -> str ! serde.Error {
    if r.token != String && r.token != PropertyName {
        fail serde.Error.Mismatch("string", r.start)
    }
    let raw = r.data[r.start..r.end]
    if !r.escaped {
        return __str_view(raw)
    }
    var out: []u8 = []
    var i = 0
    for i < raw.len {
        let c = raw[i]
        if c != '\\' {
            push(mut out, c)
            i += 1
            continue
        }
        let e = raw[i + 1]
        i += 2
        if e == 'u' {
            var code = hex4(raw, i)
            i += 4
            if utf16.is_high_surrogate(u16(code)) && i + 6 <= raw.len && raw[i] == '\\' && raw[i + 1] == 'u' {
                let low = hex4(raw, i + 2)
                if utf16.is_low_surrogate(u16(low)) {
                    code = utf16.join(u16(code), u16(low))
                    i += 6
                }
            }
            if utf16.is_surrogate(u16(code)) {
                code = 0xFFFD
            }
            text.append_char(mut out, code)
        } else if e == 'n' {
            push(mut out, '\n')
        } else if e == 't' {
            push(mut out, '\t')
        } else if e == 'r' {
            push(mut out, '\r')
        } else if e == 'b' {
            push(mut out, 8)
        } else if e == 'f' {
            push(mut out, 12)
        } else {
            push(mut out, e)
        }
    }
    __str_view(out)
}

fn number_text(r: *Reader) -> str ! serde.Error {
    if r.token != Number {
        fail serde.Error.Mismatch("number", r.start)
    }
    __str_view(r.data[r.start..r.end])
}

/// Returns the current `Number` token as an `i64`.
///
/// Fails with `serde.Error.Mismatch` when the token is not a number, or the number has a fraction or exponent, and with `Range` when it does not fit an `i64`.
pub fn get_i64(r: *Reader) -> i64 ! serde.Error {
    let s = number_text(r)?
    serde.parse_integer(s, "integer", r.start)
}

/// Returns the current `Number` token as a `u64`.
///
/// Fails with `serde.Error.Mismatch` when the token is not a number, or the number is negative or has a fraction or exponent, and with `Range` when it does not fit a `u64`.
pub fn get_u64(r: *Reader) -> u64 ! serde.Error {
    let s = number_text(r)?
    serde.parse_unsigned(s, "unsigned integer", r.start)
}

/// Returns the current `Number` token as an `f64`.
///
/// Fails with `serde.Error.Mismatch` when the token is not a number.
pub fn get_f64(r: *Reader) -> f64 ! serde.Error {
    let s = number_text(r)?
    text.parse_float(s) catch {
        _ => fail serde.Error.Mismatch("number", r.start)
    }
}

/// Returns the value of the current `True` or `False` token.
///
/// Fails with `serde.Error.Mismatch` when the token is neither.
pub fn get_bool(r: *Reader) -> bool ! serde.Error {
    if r.token == True {
        return true
    }
    if r.token != False {
        fail serde.Error.Mismatch("boolean", r.start)
    }
    false
}

/// Skips the current value.
///
/// When the token is a `PropertyName` it skips the member's value; when the value is an object or array it reads through to the matching end token, and the end token becomes current. For other tokens it does nothing. Fails like `read`.
pub fn skip(r: *Reader) ! serde.Error {
    if r.token == PropertyName {
        read(r)?
    }
    if r.token != StartObject && r.token != StartArray {
        return
    }
    let target = r.containers.len - 1
    for r.containers.len > target {
        read(r)?
    }
}
