import std/base64

/// Returns the `Member` called `name` holding `value`.
pub fn member(name: str, value: Value) -> Member {
    Member { name, value }
}

/// Returns a `Member` called `name` holding the string `value`.
pub fn text_member(name: str, value: str) -> Member {
    member(name, Value.Str(value))
}

/// Returns a `Member` called `name` holding the integer `value`.
pub fn int_member(name: str, value: i64) -> Member {
    member(name, Value.Int(value))
}

/// Returns a `Member` called `name` holding the boolean `value`.
pub fn bool_member(name: str, value: bool) -> Member {
    member(name, Value.Bool(value))
}

/// Returns a `Member` called `name` holding `data` as a Base64url string without padding.
pub fn base64url_member(name: str, data: []u8) -> Member {
    text_member(name, base64.encode_url(data))
}

/// Returns a `Member` called `name` holding an object made of `members`.
pub fn object_member(name: str, members: []Member) -> Member {
    member(name, Value.Object(members))
}

/// Returns a `Member` called `name` holding an array of `items`.
pub fn array_member(name: str, items: []Value) -> Member {
    member(name, Value.Array(items))
}

/// Returns the string `value` as a `Value`.
pub fn text_value(value: str) -> Value {
    Value.Str(value)
}

/// Returns an object made of `members` as a `Value`.
pub fn object_value(members: []Member) -> Value {
    Value.Object(members)
}

/// Returns the member `name` of the object `v`, or `Null` when `v` is not an object or has no such member.
///
/// The first member with that name is used.
pub fn field(v: Value, name: str) -> Value {
    get(v, name) ?? Value.Null
}

/// Returns the string member `name` of the object `v`, or `none` when `v` is not an object, has no such member, or the member is not a string.
pub fn field_text(v: Value, name: str) -> str? {
    match field(v, name) {
        Str(s) => s
        _ => none
    }
}

/// Returns the integer member `name` of the object `v`, or `none` when `v` is not an object, has no such member, or the member is neither an integer nor a float.
///
/// A floating point member is truncated.
pub fn field_int(v: Value, name: str) -> i64? {
    match field(v, name) {
        Int(n) => n
        Float(x) => i64(x)
        _ => none
    }
}

/// Returns the string member `name` of the object `v`, or an empty string where `field_text` gives `none`.
pub fn text_of(v: Value, name: str) -> str {
    field_text(v, name) ?? ""
}

/// Returns the integer member `name` of the object `v`, or `0` where `field_int` gives `none`.
pub fn int_of(v: Value, name: str) -> i64 {
    field_int(v, name) ?? 0
}
