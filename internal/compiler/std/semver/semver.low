import std/math
import std/text

/// Why a version string was rejected.
pub enum ParseError {
    /// The string is empty.
    Empty
    /// The string is not a valid semantic version. `at` is the index of the offending byte in a pre-release or build identifier, and the index where the numeric core starts (`0`, or `1` after a leading `v`) for a malformed core.
    Malformed(at: i64)
}

/// A semantic version (semver.org 2.0.0): a numeric core with optional pre-release and build identifiers.
pub struct Version {
    /// The major version.
    pub major: i64
    /// The minor version.
    pub minor: i64
    /// The patch version.
    pub patch: i64
    /// The dot-separated pre-release identifiers after `-`, empty for a release.
    pub pre: []str = []
    /// The dot-separated build identifiers after `+`, empty when there are none. `compare` ignores them.
    pub build: []str = []
}

fn number(s: str, at: i64) -> i64 ! ParseError {
    if s.len == 0 || (s.len > 1 && s[0] == '0') {
        fail Malformed(at)
    }
    text.parse_int(s) or fail Malformed(at)
}

fn identifiers(s: str, at: i64) -> []str ! ParseError {
    let parts = text.split(s, '.')
    for part in parts {
        if part.len == 0 {
            fail Malformed(at)
        }
        for i in 0..part.len {
            let c = part[i]
            if !(c >= '0' && c <= '9' || c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c == '-') {
                fail Malformed(at + i)
            }
        }
    }
    parts
}

fn prerelease(s: str, at: i64) -> []str ! ParseError {
    let parts = identifiers(s, at)?
    var start = at
    for part in parts {
        if part.len > 1 && part[0] == '0' && numeric(part) {
            fail Malformed(start)
        }
        start += part.len + 1
    }
    parts
}

/// Parses a version such as `1.2.3`, `v1.2.3-rc.1` or `1.2.3+build.5`.
/// A single leading `v` is accepted. The text after the first `+` is the build metadata and the text after the first `-` in the rest is the pre-release. The core must be exactly three dot-separated decimal numbers without leading zeros that fit in an `i64`. Pre-release and build identifiers must be non-empty and made of `0-9`, `a-z`, `A-Z` and `-`, and a numeric pre-release identifier has no leading zero.
///
/// Fails with `Empty` for an empty string and with `Malformed` for any other violation.
pub fn parse(s: str) -> Version ! ParseError {
    if s.len == 0 {
        fail Empty
    }
    var body = text.trim_prefix(s, "v")
    let offset = s.len - body.len
    var build: []str = []
    let plus = text.index_byte(body, '+')
    if plus >= 0 {
        build = identifiers(body[plus + 1..], offset + plus + 1)?
        body = body[..plus]
    }
    var pre: []str = []
    let dash = text.index_byte(body, '-')
    if dash >= 0 {
        pre = prerelease(body[dash + 1..], offset + dash + 1)?
        body = body[..dash]
    }
    let core = text.split(body, '.')
    if core.len != 3 {
        fail Malformed(offset)
    }
    Version {
        major: number(core[0], offset)?,
        minor: number(core[1], offset)?,
        patch: number(core[2], offset)?,
        pre: pre,
        build: build,
    }
}

/// Returns `v` as `major.minor.patch`, followed by `-` and the pre-release identifiers and `+` and the build identifiers when they are not empty.
pub fn format(v: Version) -> str {
    var out = "{v.major}.{v.minor}.{v.patch}"
    if v.pre.len > 0 {
        out = "{out}-{text.join(v.pre, ".")}"
    }
    if v.build.len > 0 {
        out = "{out}+{text.join(v.build, ".")}"
    }
    out
}

fn numeric(s: str) -> bool {
    for i in 0..s.len {
        if s[i] < '0' || s[i] > '9' {
            return false
        }
    }
    true
}

fn compare_identifier(a: str, b: str) -> i64 {
    let na = numeric(a)
    let nb = numeric(b)
    if na && nb {
        let by_length = math.compare(a.len, b.len)
        if by_length != 0 {
            return by_length
        }
        return math.compare(a, b)
    }
    if na != nb {
        return if na { -1 } else { 1 }
    }
    math.compare(a, b)
}

/// Orders two versions by semver precedence and returns `-1`, `0` or `1` when `a` is lower than, equal to or higher than `b`.
/// Major, minor and patch compare numerically. A version with a pre-release is lower than the same core without one. Pre-release identifiers compare left to right: numeric identifiers numerically at any size, others by byte value, numeric lower than non-numeric, and a shorter list lower when it is a prefix of the other. Build identifiers are ignored.
pub fn compare(a: Version, b: Version) -> i64 {
    for pair in [[a.major, b.major], [a.minor, b.minor], [a.patch, b.patch]] {
        if pair[0] != pair[1] {
            return math.compare(pair[0], pair[1])
        }
    }
    if a.pre.len == 0 || b.pre.len == 0 {
        return math.compare(b.pre.len, a.pre.len)
    }
    for i in 0..a.pre.len {
        if i >= b.pre.len {
            return 1
        }
        let c = compare_identifier(a.pre[i], b.pre[i])
        if c != 0 {
            return c
        }
    }
    if a.pre.len < b.pre.len { -1 } else { 0 }
}

/// Returns whether `a` has lower precedence than `b`, as ordered by `compare`.
pub fn less(a: Version, b: Version) -> bool {
    compare(a, b) < 0
}
