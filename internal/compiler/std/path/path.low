import std/text

pub fn is_absolute(p: str) -> bool {
    p.len > 0 && p[0] == '/'
}

pub fn clean(p: str) -> str {
    if p.len == 0 {
        return "."
    }
    let rooted = is_absolute(p)
    var kept: []str = []
    for part in text.split(p, '/') {
        if part.len == 0 || part == "." {
            continue
        }
        if part == ".." {
            if kept.len > 0 && kept[kept.len - 1] != ".." {
                var shorter: []str = []
                for i in 0..kept.len - 1 {
                    push(mut shorter, kept[i])
                }
                kept = shorter
                continue
            }
            if rooted {
                continue
            }
        }
        push(mut kept, part)
    }
    let body = text.join(kept, "/")
    if rooted {
        return "/{body}"
    }
    if body.len == 0 {
        return "."
    }
    body
}

pub fn join(parts: []str) -> str {
    var present: []str = []
    for part in parts {
        if part.len > 0 {
            push(mut present, part)
        }
    }
    if present.len == 0 {
        return ""
    }
    clean(text.join(present, "/"))
}

pub fn base(p: str) -> str {
    if p.len == 0 {
        return "."
    }
    var end = p.len
    for end > 0 && p[end - 1] == '/' {
        end -= 1
    }
    if end == 0 {
        return "/"
    }
    let trimmed = p[..end]
    let slash = text.last_index_byte(trimmed, '/')
    trimmed[slash + 1..]
}

pub fn dir(p: str) -> str {
    let slash = text.last_index_byte(p, '/')
    if slash < 0 {
        return "."
    }
    clean(p[..slash + 1])
}

pub fn ext(p: str) -> str {
    var i = p.len - 1
    for i >= 0 && p[i] != '/' {
        if p[i] == '.' {
            return p[i..]
        }
        i -= 1
    }
    ""
}

pub fn stem(p: str) -> str {
    let name = base(p)
    text.trim_suffix(name, ext(name))
}

fn class_matches(pattern: str, at: i64, c: u8) -> i64 {
    var i = at + 1
    var negated = false
    if i < pattern.len && (pattern[i] == '!' || pattern[i] == '^') {
        negated = true
        i += 1
    }
    var matched = false
    var first = true
    for i < pattern.len && (pattern[i] != ']' || first) {
        first = false
        var lo = pattern[i]
        var hi = lo
        if i + 2 < pattern.len && pattern[i + 1] == '-' && pattern[i + 2] != ']' {
            hi = pattern[i + 2]
            i += 2
        }
        if c >= lo && c <= hi {
            matched = true
        }
        i += 1
    }
    if i >= pattern.len {
        return -1
    }
    if matched != negated {
        return i + 1
    }
    -1
}

pub fn matches(pattern: str, name: str) -> bool {
    var p = 0
    var n = 0
    var star_p = -1
    var star_n = 0
    for n < name.len {
        if p < pattern.len && pattern[p] == '*' {
            star_p = p
            star_n = n
            p += 1
            continue
        }
        if p < pattern.len && name[n] != '/' {
            let c = pattern[p]
            if c == '?' {
                p += 1
                n += 1
                continue
            }
            if c == '[' {
                let next = class_matches(pattern, p, name[n])
                if next >= 0 {
                    p = next
                    n += 1
                    continue
                }
            } else if c == '\\' && p + 1 < pattern.len && pattern[p + 1] == name[n] {
                p += 2
                n += 1
                continue
            } else if c == name[n] {
                p += 1
                n += 1
                continue
            }
        } else if p < pattern.len && pattern[p] == '/' && name[n] == '/' {
            p += 1
            n += 1
            continue
        }
        if star_p >= 0 && name[star_n] != '/' {
            star_n += 1
            n = star_n
            p = star_p + 1
            continue
        }
        return false
    }
    for p < pattern.len && pattern[p] == '*' {
        p += 1
    }
    p == pattern.len
}

