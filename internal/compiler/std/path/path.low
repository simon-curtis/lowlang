import std/text

pub fn is_absolute(p: str) -> bool {
    p.len > 0 && p[0] == '/'
}

pub fn clean(p: str) -> str {
    if p.len == 0 {
        return "."
    }
    let rooted = is_absolute(p)
    var kept: []str = []
    for part in text.split(p, '/') {
        if part.len == 0 || part == "." {
            continue
        }
        if part == ".." {
            if kept.len > 0 && kept[kept.len - 1] != ".." {
                var shorter: []str = []
                for i in 0..kept.len - 1 {
                    push(mut shorter, kept[i])
                }
                kept = shorter
                continue
            }
            if rooted {
                continue
            }
        }
        push(mut kept, part)
    }
    let body = text.join(kept, "/")
    if rooted {
        return "/{body}"
    }
    if body.len == 0 {
        return "."
    }
    body
}

pub fn join(parts: []str) -> str {
    var present: []str = []
    for part in parts {
        if part.len > 0 {
            push(mut present, part)
        }
    }
    if present.len == 0 {
        return ""
    }
    clean(text.join(present, "/"))
}

pub fn base(p: str) -> str {
    if p.len == 0 {
        return "."
    }
    var end = p.len
    for end > 0 && p[end - 1] == '/' {
        end -= 1
    }
    if end == 0 {
        return "/"
    }
    let trimmed = p[..end]
    let slash = text.last_index_byte(trimmed, '/')
    trimmed[slash + 1..]
}

pub fn dir(p: str) -> str {
    let slash = text.last_index_byte(p, '/')
    if slash < 0 {
        return "."
    }
    clean(p[..slash + 1])
}

pub fn ext(p: str) -> str {
    var i = p.len - 1
    for i >= 0 && p[i] != '/' {
        if p[i] == '.' {
            return p[i..]
        }
        i -= 1
    }
    ""
}

pub fn stem(p: str) -> str {
    let name = base(p)
    text.trim_suffix(name, ext(name))
}
