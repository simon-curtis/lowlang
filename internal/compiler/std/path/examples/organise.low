import std/path

fn destination(source: str) -> str {
    let kind = if path.matches("*.[ch]", path.base(source)) {
        "native"
    } else if path.matches("*.png", path.base(source)) {
        "images"
    } else {
        "other"
    }
    path.join(["out", kind, path.base(source)])
}

/// Plans where files go by matching their names against globs, then breaks each path into its parts and cleans messy ones.
fn main() {
    let sources = ["src/main.c", "src/util/list.h", "assets//logo.png", "./docs/../README.md", "/var/log/syslog.1.gz", ".profile"]
    for source in sources {
        print("{path.clean(source)} -> {destination(source)}")
    }

    for p in ["/var/log/syslog.1.gz", "notes.txt", "archive/", "plain"] {
        print("{p}: dir={path.dir(p)} base={path.base(p)} stem={path.stem(p)} ext={path.ext(p)}")
    }

    print(path.clean("a/./b/../../../c//d/"))
    print(path.clean("/../etc/"))
    print(path.join(["a", "", "/b", "c/.."]))
    print("absolute: {path.is_absolute("/tmp")} {path.is_absolute("tmp")}")
    print("class match: {path.matches("report-[0-9][0-9].txt", "report-07.txt")} {path.matches("report-[!0-9]*", "report-07.txt")}")
    print("no slash crossing: {path.matches("*.txt", "docs/a.txt")} {path.matches("*/*.txt", "docs/a.txt")}")
}
