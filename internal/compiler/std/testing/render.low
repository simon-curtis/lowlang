import std/serde
import std/text

struct Render {
    out: []u8
    counts: []i64
    tails: []str
    named: bool
    payload: bool
}

/// Returns a readable rendering of `v` for test messages, for a value of any type.
/// ///
/// /// Structs print as `Name{field: value}`, sequences as `[a, b]`, maps as `{key: value}`, a variant with a payload as `Name(payload)` and a variant without one as its name. Text is quoted with `"`, `\`, newline and tab escaped, binary data is `0x` and hex digits, and an absent optional is `none`. Integers and floats use their default text.
pub fn format[V](v: V) -> str {
    let r = new(Render { out: [], counts: [], tails: [], named: false, payload: false })
    serde.write(v, events(r))
    str(r.out)
}

fn separate(r: *Render) {
    if r.named {
        r.named = false
        return
    }
    if r.counts.len == 0 {
        return
    }
    let last = r.counts.len - 1
    if r.counts[last] > 0 {
        text.append(mut r.out, ", ")
    }
    r.counts[last] += 1
}

fn open(r: *Render, head: str, tail: str) {
    if r.payload {
        r.payload = false
        push(mut r.counts, 0)
        push(mut r.tails, "")
        return
    }
    separate(r)
    text.append(mut r.out, head)
    push(mut r.counts, 0)
    push(mut r.tails, tail)
}

fn open_variant(r: *Render, name: str) {
    open(r, "{name}(", ")")
    r.payload = true
}

fn close(r: *Render) {
    let last = r.counts.len - 1
    text.append(mut r.out, r.tails[last])
    r.counts = r.counts[..last]
    r.tails = r.tails[..last]
}

fn name_entry(r: *Render, name: str) {
    r.named = false
    separate(r)
    text.append(mut r.out, name)
    text.append(mut r.out, ": ")
    r.named = true
}

fn quote(r: *Render, s: str) {
    push(mut r.out, '"')
    for i in 0..s.len {
        let c = s[i]
        if c == '"' {
            text.append(mut r.out, "\\\"")
        } else if c == '\\' {
            text.append(mut r.out, "\\\\")
        } else if c == '\n' {
            text.append(mut r.out, "\\n")
        } else if c == '\t' {
            text.append(mut r.out, "\\t")
        } else {
            push(mut r.out, c)
        }
    }
    push(mut r.out, '"')
}

fn scalar(r: *Render, s: str) {
    separate(r)
    text.append(mut r.out, s)
}

fn events(r: *Render) -> serde.Writer {
    serde.Writer {
        null: fn() { scalar(r, "none") }
        boolean: fn(v) { scalar(r, "{v}") }
        integer: fn(n) { scalar(r, "{n}") }
        unsigned: fn(n) { scalar(r, "{n}") }
        float: fn(x) { scalar(r, "{x}") }
        text: fn(s) {
            separate(r)
            quote(r, s)
        }
        binary: fn(b) { scalar(r, "0x{text.encode_hex(b)}") }
        begin_seq: fn(n) { open(r, "[", "]") }
        end_seq: fn() { close(r) }
        begin_map: fn(n) { open(r, "{{", "}}") }
        key: fn(k) { name_entry(r, k) }
        end_map: fn() { close(r) }
        begin_struct: fn(name, n) { open(r, "{name}{{", "}}") }
        field: fn(name) { name_entry(r, name) }
        end_struct: fn() { close(r) }
        unit_variant: fn(e, v) { scalar(r, v) }
        begin_variant: fn(e, v, n) { open_variant(r, v) }
        end_variant: fn() { close(r) }
    }
}
