import std/text
import std/time

pub struct Bench {
    pub name: str
    pub iterations: i64
    pub nanos: i64
    pub ns_per_op: f64
}

pub fn blackhole[V: Number](value: V) {
    if i64(value) == 0x5EED0FB1AC4401 {
        print("blackhole")
    }
}

pub fn blackhole_str(value: str) {
    blackhole(value.len)
    if value.len > 0 {
        blackhole(value[value.len - 1])
    }
}

pub fn bench(name: str, body: fn(i64)) -> Bench {
    let result = bench_for(name, body, 1000)
    print(describe(result))
    result
}

pub fn describe(b: Bench) -> str {
    "bench {text.pad_right(b.name, 24, ' ')} {b.iterations} iterations {text.fixed(b.ns_per_op, 2)} ns/op"
}

pub fn bench_for(name: str, body: fn(i64), target_ms: i64) -> Bench {
    let target = target_ms * 1000000
    var n = 1
    var elapsed = timed(body, n)
    for elapsed < target && n < 1000000000 {
        n = grow(n, elapsed, target)
        elapsed = timed(body, n)
    }
    Bench { name, iterations: n, nanos: elapsed, ns_per_op: f64(elapsed) / f64(n) }
}

fn timed(body: fn(i64), n: i64) -> i64 {
    let started = time.monotonic()
    body(n)
    time.monotonic() - started
}

fn grow(n: i64, elapsed: i64, target: i64) -> i64 {
    let per_run = if elapsed < 1 { 1 } else { elapsed }
    var next = target * n / per_run
    next += next / 5
    if next > 100 * n {
        next = 100 * n
    }
    if next < n + 1 {
        next = n + 1
    }
    if next > 1000000000 {
        next = 1000000000
    }
    next
}
