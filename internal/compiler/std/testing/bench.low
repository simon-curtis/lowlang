import std/text
import std/time

/// The result of a benchmark.
pub struct Bench {
    /// The benchmark name.
    pub name: str
    /// The number of iterations the measured run made.
    pub iterations: i64
    /// The time the measured run took, in nanoseconds.
    pub nanos: i64
    /// The mean time of one iteration, in nanoseconds: `nanos` divided by `iterations`.
    pub ns_per_op: f64
}

/// Consumes `value` so a benchmarked computation is not optimised away.
///
/// It does nothing observable, apart from printing a fixed word when `value` converts to one specific unlikely integer.
pub fn blackhole[V: Number](value: V) {
    if i64(value) == 0x5EED0FB1AC4401 {
        print("blackhole")
    }
}

/// Consumes `value` so a benchmarked computation is not optimised away.
///
/// It uses the length of `value` and its last byte.
pub fn blackhole_str(value: str) {
    blackhole(value.len)
    if value.len > 0 {
        blackhole(value[value.len - 1])
    }
}

/// Benchmarks `body` for about one second, prints the result line and returns it.
///
/// This is `bench_for` with a target of 1000 milliseconds followed by printing `describe` of the result.
pub fn bench(name: str, body: fn(i64)) -> Bench {
    let result = bench_for(name, body, 1000)
    print(describe(result))
    result
}

/// Returns a one-line report of `b`: its name, its iteration count and its time per iteration in nanoseconds with two decimals.
pub fn describe(b: Bench) -> str {
    "bench {text.pad_right(b.name, 24, ' ')} {b.iterations} iterations {text.fixed(b.ns_per_op, 2)} ns/op"
}

/// Benchmarks `body` until one run takes at least `target_ms` milliseconds, and returns that run.
///
/// `body(n)` must do the measured work `n` times. It is first called with `1`, then with a larger `n` estimated from the previous run, growing at most 100 times per step, until a run reaches the target or `n` reaches one billion. Only the last run is reported. Nothing is printed.
pub fn bench_for(name: str, body: fn(i64), target_ms: i64) -> Bench {
    let target = target_ms * 1000000
    var n = 1
    var elapsed = timed(body, n)
    for elapsed < target && n < max_iterations() {
        n = grow(n, elapsed, target)
        elapsed = timed(body, n)
    }
    Bench { name, iterations: n, nanos: elapsed, ns_per_op: f64(elapsed) / f64(n) }
}

fn max_iterations() -> i64 {
    1000000000
}

fn timed(body: fn(i64), n: i64) -> i64 {
    let started = time.monotonic()
    body(n)
    time.monotonic() - started
}

fn grow(n: i64, elapsed: i64, target: i64) -> i64 {
    let per_run = if elapsed < 1 { 1 } else { elapsed }
    var next = target * n / per_run
    next += next / 5
    if next > 100 * n {
        next = 100 * n
    }
    if next < n + 1 {
        next = n + 1
    }
    if next > max_iterations() {
        next = max_iterations()
    }
    next
}
