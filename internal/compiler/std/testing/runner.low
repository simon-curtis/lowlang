import std/flag
import std/os
import std/text
import std/time

struct Tally {
    passed: i64
    failed: i64
    skipped: i64
}

fn specs() -> []flag.Spec {
    [
        flag.Spec { name: "run", help: "run only tests whose name contains this text; separate subtest levels with /" }
        flag.Spec { name: "v", help: "print every test", boolean: true }
        flag.Spec { name: "notime", help: "leave timings out of the report", boolean: true }
        flag.Spec { name: "timeout", help: "milliseconds before a test counts as hung", fallback: "30000" }
    ]
}

/// Builds `Settings` from command-line flag arguments.
///
/// Reads `-run` for the filter, `-v` for verbose output, `-notime` to leave timings out and `-timeout` for the milliseconds a test may take. Fails with the `flag.Error` for an unknown flag, a flag without its value, or a `-timeout` that is not an integer.
pub fn settings_from(args: []str) -> Settings ! flag.Error {
    let parsed = flag.parse(specs(), args)?
    let timeout = flag.number(parsed, "timeout")?
    Settings {
        filter: flag.get(parsed, "run")
        verbose: flag.enabled(parsed, "v")
        timing: !flag.enabled(parsed, "notime")
        timeout_ms: timeout
    }
}

fn flag_message(e: flag.Error) -> str {
    match e {
        Unknown(name) => "unknown flag -{name}"
        Missing(name) => "flag -{name} needs a value"
        Invalid(name, value) => "flag -{name} cannot take {value}"
    }
}

fn exit_usage(e: flag.Error) -> Settings {
    print("testing: {flag_message(e)}")
    print(flag.usage(specs()))
    os.exit(2)
    Settings {}
}

/// Runs `tests` using the flags in the process arguments and returns the number of failed tests.
///
/// Reads the flags with `settings_from` after the program name. A bad flag prints the usage and exits with status `2`. Otherwise it runs the tests as `run_with` does and exits with status `1` when any test failed; it returns only when none did.
pub fn run(tests: []Test) -> i64 {
    let args = os.args()
    let rest = if args.len > 0 { args[1..] } else { args }
    let settings = settings_from(rest) catch { e => exit_usage(e) }
    let failed = run_with(tests, settings)
    if failed > 0 {
        os.exit(1)
    }
    failed
}

/// Runs each test of `tests` selected by `settings.filter` and returns the number of failed tests.
///
/// Each test runs on its own green thread and is failed when it exceeds `settings.timeout_ms`. It prints a report for each failed test, or each test with `settings.verbose`, then a final line with the verdict and the counts of failed, passed and skipped tests. It does not exit the process.
pub fn run_with(tests: []Test, settings: Settings) -> i64 {
    let tally = new(Tally { passed: 0, failed: 0, skipped: 0 })
    let started = time.monotonic()
    for test in tests {
        if selected(settings.filter, test.name) {
            run_top(tally, test, settings)
        }
    }
    print(summary(tally, settings, time.monotonic() - started))
    tally.failed
}

fn run_top(tally: *Tally, test: Test, settings: Settings) {
    let t = make_t(test.name, settings)
    run_case(t, test.run)
    if t.failures > 0 {
        tally.failed += 1
    } else if t.skipped {
        tally.skipped += 1
    } else {
        tally.passed += 1
    }
}

fn summary(tally: *Tally, settings: Settings, nanos: i64) -> str {
    var parts: []str = []
    if tally.failed > 0 {
        push(mut parts, "{tally.failed} failed")
    }
    push(mut parts, "{tally.passed} passed")
    if tally.skipped > 0 {
        push(mut parts, "{tally.skipped} skipped")
    }
    let verdict = if tally.failed > 0 { "FAIL" } else { "PASS" }
    "{verdict}  {text.join(parts, ", ")}{timing(settings, nanos)}"
}

fn timing(settings: Settings, nanos: i64) -> str {
    if !settings.timing {
        return ""
    }
    " ({milliseconds(nanos)})"
}

fn milliseconds(nanos: i64) -> str {
    "{text.fixed(f64(nanos) / 1000000.0, 2)}ms"
}

/// Returns `true` when the test `name` is selected by `filter`.
///
/// An empty `filter` selects every name. Otherwise the filter and the name are split at `/`, and each level of the name must contain the filter's text at the same level. Levels of the name beyond the filter's depth match anything, and so does a name with fewer levels than the filter, so a top-level test is selected while its first level matches and its subtests are then filtered by the remaining levels.
pub fn selected(filter: str, name: str) -> bool {
    if filter.len == 0 {
        return true
    }
    let wanted = text.split(filter, '/')
    let levels = text.split(name, '/')
    for i, level in levels {
        if i < wanted.len && !text.contains(level, wanted[i]) {
            return false
        }
    }
    true
}

fn announce(t: *T) {
    let broken = failed(t)
    if !broken && !t.settings.verbose {
        return
    }
    let status = if broken { "FAIL" } else if t.skipped { "SKIP" } else { "PASS" }
    print("--- {status}: {t.name}{timing(t.settings, t.elapsed)}")
    for note in recorded(t) {
        for line in text.split(note, '\n') {
            print("    {line}")
        }
    }
}
