import std/time

pub struct Test {
    pub name: str
    pub run: fn(*T)
}

pub struct Settings {
    pub filter: str = ""
    pub verbose: bool = false
    pub timing: bool = true
    pub timeout_ms: i64 = 30000
    pub golden_dir: str = "testdata"
}

pub struct T {
    pub name: str
    settings: Settings
    lock: i64
    failures: i64
    skipped: bool
    finished: bool
    notes: []str
    done: chan[bool]
    elapsed: i64
}

fn make_t(name: str, settings: Settings) -> *T {
    new(T { name, settings, lock: 0, failures: 0, skipped: false, finished: false, notes: [], done: chan[bool](1), elapsed: 0 })
}

pub fn log(t: *T, message: str) {
    __lock(mut t.lock)
    push(mut t.notes, message)
    __unlock(mut t.lock)
}

pub fn error(t: *T, message: str) {
    __lock(mut t.lock)
    push(mut t.notes, message)
    t.failures += 1
    __unlock(mut t.lock)
}

pub fn fatal(t: *T, message: str) {
    error(t, message)
    halt(t)
}

pub fn error_if(t: *T, condition: bool, message: str) -> bool {
    if condition {
        error(t, message)
    }
    condition
}

pub fn fatal_if(t: *T, condition: bool, message: str) {
    if condition {
        fatal(t, message)
    }
}

pub fn require(t: *T, ok: bool) {
    if !ok {
        halt(t)
    }
}

pub fn skip(t: *T, reason: str) {
    __lock(mut t.lock)
    push(mut t.notes, reason)
    t.skipped = true
    __unlock(mut t.lock)
    halt(t)
}

pub fn failed(t: *T) -> bool {
    __lock(mut t.lock)
    let any = t.failures > 0
    __unlock(mut t.lock)
    any
}

fn recorded(t: *T) -> []str {
    __lock(mut t.lock)
    let notes = t.notes
    __unlock(mut t.lock)
    notes
}

fn finish(t: *T) {
    __lock(mut t.lock)
    let first = !t.finished
    t.finished = true
    __unlock(mut t.lock)
    if first {
        t.done <- true
    }
}

fn halt(t: *T) {
    finish(t)
    let forever = chan[bool]()
    let never = <-forever
}

fn execute(t: *T, body: fn(*T)) {
    body(t)
    finish(t)
}

fn run_case(t: *T, body: fn(*T)) {
    if t.settings.verbose {
        print("=== RUN   {t.name}")
    }
    let started = time.monotonic()
    spawn execute(t, body)
    await(t)
    t.elapsed = time.monotonic() - started
    announce(t)
}

fn await(t: *T) {
    let limit = t.settings.timeout_ms
    select {
        <-t.done => {}
        after(limit) => expire(t, limit)
    }
}

fn expire(t: *T, limit: i64) {
    __lock(mut t.lock)
    t.finished = true
    t.skipped = false
    t.failures += 1
    push(mut t.notes, "timed out after {limit}ms")
    __unlock(mut t.lock)
}

fn child(t: *T, name: str) -> *T {
    make_t("{t.name}/{name}", t.settings)
}

pub fn sub(t: *T, name: str, body: fn(*T)) -> bool {
    let full = "{t.name}/{name}"
    if !selected(t.settings.filter, full) {
        return true
    }
    let c = child(t, name)
    run_case(c, body)
    if c.failures > 0 {
        mark_failed(t)
    }
    c.failures == 0
}

fn mark_failed(t: *T) {
    __lock(mut t.lock)
    t.failures += 1
    __unlock(mut t.lock)
}

pub fn table[C](t: *T, cases: [str: C], body: fn(*T, C)) -> bool {
    var ok = true
    for name, c in cases {
        if !sub(t, name, fn(st) { body(st, c) }) {
            ok = false
        }
    }
    ok
}

pub fn table_of[C](t: *T, cases: []C, name: fn(C) -> str, body: fn(*T, C)) -> bool {
    var ok = true
    for c in cases {
        if !sub(t, name(c), fn(st) { body(st, c) }) {
            ok = false
        }
    }
    ok
}
