import std/time

/// A named test for `run` and `run_with`.
pub struct Test {
    /// The test name, which `-run` filters on.
    pub name: str
    /// The test body. It runs on its own green thread and receives the `T` that records its result.
    pub run: fn(*T)
}

/// Options for a test run.
/// ///
/// /// `settings_from` builds one from command-line flags. Every field has a default, so `Settings {}` is valid.
pub struct Settings {
    /// Selects the tests to run through `selected`: the text a test name must contain, with `/` separating the levels of subtest names. The empty default selects every test.
    pub filter: str = ""
    /// Whether to report every test, passing and skipped included, instead of only the failures. The default is `false`.
    pub verbose: bool = false
    /// Whether the reports carry elapsed times. The default is `true`.
    pub timing: bool = true
    /// The number of milliseconds a test, or a subtest, may run before it is failed as hung. The default is `30000`.
    pub timeout_ms: i64 = 30000
    /// The directory that `golden` reads and writes its files in. The default is `testdata`.
    pub golden_dir: str = "testdata"
}

/// The state of one running test or subtest, passed to its body as a `*T`.
/// ///
/// /// Records, assertions and subtests all go through it. The recording functions are safe to call from several green threads at once.
pub struct T {
    /// The test's full name: the name of a top-level test, or its parent's name and the subtest names joined with `/`.
    pub name: str
    settings: Settings
    lock: i64
    failures: i64
    skipped: bool
    finished: bool
    notes: []str
    done: chan[bool]
    elapsed: i64
}

fn make_t(name: str, settings: Settings) -> *T {
    new(T { name, settings, lock: 0, failures: 0, skipped: false, finished: false, notes: [], done: chan[bool](1), elapsed: 0 })
}

/// Records `message` on `t` without failing the test.
/// ///
/// /// The run prints the notes of a test that fails, or of every test with `-v`.
pub fn log(t: *T, message: str) {
    __lock(mut t.lock)
    push(mut t.notes, message)
    __unlock(mut t.lock)
}

/// Records `message` on `t` and marks the test failed.
/// ///
/// /// The test body keeps running, so later checks still report.
pub fn error(t: *T, message: str) {
    __lock(mut t.lock)
    push(mut t.notes, message)
    t.failures += 1
    __unlock(mut t.lock)
}

/// Records `message` on `t`, marks the test failed and ends it.
/// ///
/// /// The calling green thread never continues after this call.
pub fn fatal(t: *T, message: str) {
    error(t, message)
    halt(t)
}

/// Calls `error` with `message` when `condition` is `true`.
/// ///
/// /// Returns `condition`, so the result is `true` when a failure was recorded.
pub fn error_if(t: *T, condition: bool, message: str) -> bool {
    if condition {
        error(t, message)
    }
    condition
}

/// Calls `fatal` with `message` when `condition` is `true`.
pub fn fatal_if(t: *T, condition: bool, message: str) {
    if condition {
        fatal(t, message)
    }
}

/// Ends the test when `ok` is `false`, without recording a failure.
/// ///
/// /// The calling green thread never continues in that case. Use it to stop after a check that already reported through `error` or an assertion, when the rest of the test cannot run.
pub fn require(t: *T, ok: bool) {
    if !ok {
        halt(t)
    }
}

/// Records `reason` on `t`, marks the test skipped and ends it.
/// ///
/// /// The calling green thread never continues after this call. A skipped test is reported as `SKIP` with `-v` and is counted apart from passes and failures, unless it also recorded a failure.
pub fn skip(t: *T, reason: str) {
    __lock(mut t.lock)
    push(mut t.notes, reason)
    t.skipped = true
    __unlock(mut t.lock)
    halt(t)
}

/// Returns `true` when `t` has recorded a failure.
/// ///
/// /// A failed subtest also fails its parent, and a timeout counts as a failure.
pub fn failed(t: *T) -> bool {
    __lock(mut t.lock)
    let any = t.failures > 0
    __unlock(mut t.lock)
    any
}

fn recorded(t: *T) -> []str {
    __lock(mut t.lock)
    let notes = t.notes
    __unlock(mut t.lock)
    notes
}

fn finish(t: *T) {
    __lock(mut t.lock)
    let first = !t.finished
    t.finished = true
    __unlock(mut t.lock)
    if first {
        t.done <- true
    }
}

fn halt(t: *T) {
    finish(t)
    let forever = chan[bool]()
    let never = <-forever
}

fn execute(t: *T, body: fn(*T)) {
    body(t)
    finish(t)
}

fn run_case(t: *T, body: fn(*T)) {
    if t.settings.verbose {
        print("=== RUN   {t.name}")
    }
    let started = time.monotonic()
    spawn execute(t, body)
    await(t)
    t.elapsed = time.monotonic() - started
    announce(t)
}

fn await(t: *T) {
    let limit = t.settings.timeout_ms
    select {
        <-t.done => {}
        after(limit) => expire(t, limit)
    }
}

fn expire(t: *T, limit: i64) {
    __lock(mut t.lock)
    t.finished = true
    t.skipped = false
    t.failures += 1
    push(mut t.notes, "timed out after {limit}ms")
    __unlock(mut t.lock)
}

fn child(t: *T, name: str) -> *T {
    make_t("{t.name}/{name}", t.settings)
}

/// Runs `body` as a subtest of `t` named `name`, and waits for it to finish.
/// ///
/// /// The subtest's full name is `t.name` and `name` joined with `/`. It has its own green thread and timeout. It is not run when the run's filter does not select its full name, which counts as a pass. A subtest that fails also fails `t`. Returns `true` when the subtest recorded no failure.
pub fn sub(t: *T, name: str, body: fn(*T)) -> bool {
    let full = "{t.name}/{name}"
    if !selected(t.settings.filter, full) {
        return true
    }
    let c = child(t, name)
    run_case(c, body)
    if c.failures > 0 {
        mark_failed(t)
    }
    c.failures == 0
}

fn mark_failed(t: *T) {
    __lock(mut t.lock)
    t.failures += 1
    __unlock(mut t.lock)
}

/// Runs `body` as a subtest of `t` for each entry of `cases`, named by its key.
/// ///
/// /// Cases run in the map's insertion order. Returns `true` when every subtest passed. See `sub`.
pub fn table[C](t: *T, cases: [str: C], body: fn(*T, C)) -> bool {
    var ok = true
    for name, c in cases {
        if !sub(t, name, fn(st) { body(st, c) }) {
            ok = false
        }
    }
    ok
}

/// Runs `body` as a subtest of `t` for each element of `cases`, named by `name` applied to the element.
/// ///
/// /// Cases run in order. Returns `true` when every subtest passed. See `sub`.
pub fn table_of[C](t: *T, cases: []C, name: fn(C) -> str, body: fn(*T, C)) -> bool {
    var ok = true
    for c in cases {
        if !sub(t, name(c), fn(st) { body(st, c) }) {
            ok = false
        }
    }
    ok
}
