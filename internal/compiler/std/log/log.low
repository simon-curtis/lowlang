import std/io
import std/json
import std/os
import std/sys
import std/text
import std/time
import std/time/datetime
import std/time/timestamp

/// The severity of a log record.
pub enum Level {
    /// Detailed diagnostic output, shown only when the logger level is `Debug`.
    Debug
    /// Routine progress and state changes; the default logger level.
    Info
    /// A condition that is unexpected but does not stop the operation.
    Warn
    /// A failure of an operation.
    Error
}

/// The line layout a `Logger` renders records in.
pub enum Format {
    /// `[time ]level[ prefix]: message key=value ...`. Values that are empty or contain a space, control byte, `"` or `=` are quoted.
    Text
    /// One JSON object per line with `time` (when timestamps are on), `level`, `msg`, `prefix` (when set) and one property per attribute.
    Json
}

/// The error returned by `parse_level`.
pub enum ParseError {
    /// The text is not a level name.
    Unknown
}

/// A key and a typed value attached to a log record.
pub enum Attr {
    /// A string value.
    Str(key: str, value: str)
    /// An integer value.
    Int(key: str, value: i64)
    /// A floating-point value.
    Float(key: str, value: f64)
    /// A boolean value.
    Bool(key: str, value: bool)
}

/// A log event as it reaches a `Handler` sink, before any formatting.
pub struct Record {
    /// The record's severity.
    pub level: Level
    /// The message text.
    pub message: str
    /// The logger's prefix, or an empty string when none is set.
    pub prefix: str
    /// The attributes bound to the logger followed by those passed to the call.
    pub attrs: []Attr
    /// The timestamp in nanoseconds since the Unix epoch, or `none` when the logger has timestamps off.
    pub time: i64?
}

/// Where a `Logger` delivers each record.
pub enum Sink {
    /// Writes the formatted line to the descriptor. Short writes and `EINTR` are retried and `EAGAIN` waits until the descriptor is writable; any other error is passed to `Logger.on_error`.
    Fd(fd: i64)
    /// Writes the formatted line, with a trailing newline, to an `io.Stream`. A write error is passed to `Logger.on_error`.
    Stream(io.Stream)
    /// Passes the formatted line, without a trailing newline, to the function.
    Lines(fn(str))
    /// Passes the unformatted `Record` to the function, ignoring `Logger.format`.
    Handler(fn(Record))
}

/// A leveled logger. A `Logger` is a value; the `with_` functions return a modified copy and leave the original unchanged.
pub struct Logger {
    /// The minimum level that is delivered; lower levels are discarded. Defaults to `Info`.
    pub level: Level = Info
    /// The text shown before the message. `with_prefix` nests prefixes with `.`. Defaults to empty.
    pub prefix: str = ""
    /// The line layout. Defaults to `Text`.
    pub format: Format = Text
    /// Where records go. Defaults to `Fd(2)`, standard error.
    pub sink: Sink = Fd(2)
    /// Attributes added to every record. Defaults to none.
    pub attrs: []Attr = []
    /// Whether records carry a timestamp taken from `clock`. Defaults to `false`.
    pub timestamps: bool = false
    /// Returns the current time in nanoseconds since the Unix epoch for timestamps. Defaults to `time.now_nanos`.
    pub clock: fn() -> i64 = fn() -> i64 { time.now_nanos() }
    /// Receives the error of a failed write to the `Fd` or `Stream` sink, after which the line is lost. Defaults to a function that does nothing.
    pub on_error: fn(io.Error) = fn(e: io.Error) {}
}

fn rank(l: Level) -> i64 {
    match l {
        Debug => 0
        Info => 1
        Warn => 2
        Error => 3
    }
}

fn label(l: Level) -> str {
    match l {
        Debug => "debug"
        Info => "info"
        Warn => "warn"
        Error => "error"
    }
}

/// Parses a level name, ignoring case and surrounding whitespace.
/// Accepts `debug`, `info`, `warn`, `warning` and `error`; any other text fails with `Unknown`.
pub fn parse_level(s: str) -> Level ! ParseError {
    let name = text.lower(text.trim(s))
    match name {
        == "debug" => Debug
        == "info" => Info
        == "warn" => Warn
        == "warning" => Warn
        == "error" => Error
        _ => fail Unknown
    }
}

/// Returns the level named by the `LOG_LEVEL` environment variable, or `fallback` when the variable is unset or not a level name.
pub fn level_from_env(fallback: Level) -> Level {
    let value = os.env("LOG_LEVEL") ?? return fallback
    parse_level(value) catch fallback
}

/// Returns a string attribute.
pub fn str_attr(key: str, value: str) -> Attr {
    Str(key, value)
}

/// Returns an integer attribute.
pub fn int_attr(key: str, value: i64) -> Attr {
    Int(key, value)
}

/// Returns a floating-point attribute.
pub fn float_attr(key: str, value: f64) -> Attr {
    Float(key, value)
}

/// Returns a boolean attribute.
pub fn bool_attr(key: str, value: bool) -> Attr {
    Bool(key, value)
}

/// Reports whether a record at `level` would be delivered by this logger, which is when `level` is at least `l.level`.
pub fn enabled(l: Logger, level: Level) -> bool {
    rank(level) >= rank(l.level)
}

fn bare_value(value: str) -> bool {
    if value.len == 0 {
        return false
    }
    for i in 0..value.len {
        let c = value[i]
        if c <= ' ' || c == '"' || c == '=' || c == 0x7F {
            return false
        }
    }
    true
}

fn text_value(value: str) -> str {
    if bare_value(value) { value } else { text.quote(value) }
}

fn append_text_attr(mut out: []u8, a: Attr) {
    match a {
        Str(key, value) => text.append(mut out, " {key}={text_value(value)}")
        Int(key, value) => text.append(mut out, " {key}={value}")
        Float(key, value) => text.append(mut out, " {key}={value}")
        Bool(key, value) => text.append(mut out, " {key}={value}")
    }
}

fn stamp(nanos: i64) -> str {
    let ts = timestamp.from_unix_nanos(nanos)
    let millis = timestamp.subsec_nanos(ts) / 1000000 * 1000000
    let local = datetime.from_civil_seconds(timestamp.unix_seconds(ts), millis) catch {
        _ => return timestamp.to_string(ts)
    }
    "{datetime.to_string(local)}Z"
}

fn render_text(r: Record) -> str {
    var out: []u8 = []
    match r.time {
        some(t) => text.append(mut out, "{stamp(t)} ")
        none => {}
    }
    text.append(mut out, label(r.level))
    if r.prefix.len > 0 {
        text.append(mut out, " {r.prefix}: {r.message}")
    } else {
        text.append(mut out, " {r.message}")
    }
    for a in r.attrs {
        append_text_attr(mut out, a)
    }
    __str_view(out)
}

fn write_json_attr(w: *json.Writer, a: Attr) {
    match a {
        Str(key, value) => {
            json.property(w, key)
            json.string_value(w, value)
        }
        Int(key, value) => {
            json.property(w, key)
            json.integer(w, value)
        }
        Float(key, value) => {
            json.property(w, key)
            json.float(w, value)
        }
        Bool(key, value) => {
            json.property(w, key)
            json.boolean(w, value)
        }
    }
}

fn render_json(r: Record) -> str {
    let w = json.writer(0)
    json.start_object(w)
    match r.time {
        some(t) => {
            json.property(w, "time")
            json.string_value(w, stamp(t))
        }
        none => {}
    }
    json.property(w, "level")
    json.string_value(w, label(r.level))
    json.property(w, "msg")
    json.string_value(w, r.message)
    if r.prefix.len > 0 {
        json.property(w, "prefix")
        json.string_value(w, r.prefix)
    }
    for a in r.attrs {
        write_json_attr(w, a)
    }
    json.end_object(w)
    json.written_text(w)
}

fn render(format: Format, r: Record) -> str {
    match format {
        Text => render_text(r)
        Json => render_json(r)
    }
}

fn write_stream(l: Logger, s: io.Stream, line: str) {
    let data = bytes(line)
    io.write_all(s, data) catch {
        e => l.on_error(e)
    }
}

fn deliver(l: Logger, r: Record) {
    match l.sink {
        Fd(fd) => write_stream(l, sys.stream(fd), "{render(l.format, r)}\n")
        Stream(s) => write_stream(l, s, "{render(l.format, r)}\n")
        Lines(f) => f(render(l.format, r))
        Handler(h) => h(r)
    }
}

fn joined(bound: []Attr, extra: []Attr) -> []Attr {
    if extra.len == 0 {
        return bound
    }
    if bound.len == 0 {
        return extra
    }
    var out: []Attr = []
    for a in bound {
        push(mut out, a)
    }
    for a in extra {
        push(mut out, a)
    }
    out
}

fn record(l: Logger, level: Level, message: str, attrs: []Attr) -> Record {
    let at: i64? = if l.timestamps { l.clock() } else { none }
    Record { level, message, prefix: l.prefix, attrs: joined(l.attrs, attrs), time: at }
}

/// Logs `message` with `attrs` at `level`.
/// Nothing is formatted or delivered when the level is below the logger's. Attributes bound to the logger come first, then `attrs`.
pub fn log(l: Logger, level: Level, message: str, attrs: []Attr) {
    if !enabled(l, level) {
        return
    }
    deliver(l, record(l, level, message, attrs))
}

/// Logs `message` at `level` with no attributes beyond those bound to the logger.
pub fn emit(l: Logger, level: Level, message: str) {
    log(l, level, message, [])
}

/// Logs `message` at `Debug`.
pub fn debug(l: Logger, message: str) {
    emit(l, Debug, message)
}

/// Logs `message` at `Info`.
pub fn info(l: Logger, message: str) {
    emit(l, Info, message)
}

/// Logs `message` at `Warn`.
pub fn warn(l: Logger, message: str) {
    emit(l, Warn, message)
}

/// Logs `message` at `Error`.
pub fn error(l: Logger, message: str) {
    emit(l, Error, message)
}

/// Logs `message` at `Debug` with `attrs`.
pub fn debug_with(l: Logger, message: str, attrs: []Attr) {
    log(l, Debug, message, attrs)
}

/// Logs `message` at `Info` with `attrs`.
pub fn info_with(l: Logger, message: str, attrs: []Attr) {
    log(l, Info, message, attrs)
}

/// Logs `message` at `Warn` with `attrs`.
pub fn warn_with(l: Logger, message: str, attrs: []Attr) {
    log(l, Warn, message, attrs)
}

/// Logs `message` at `Error` with `attrs`.
pub fn error_with(l: Logger, message: str, attrs: []Attr) {
    log(l, Error, message, attrs)
}

/// Returns a copy of the logger that shows `prefix` before each message.
/// When the logger already has a prefix, the result is the old prefix, `.` and `prefix`.
pub fn with_prefix(l: Logger, prefix: str) -> Logger {
    var out = l
    out.prefix = if l.prefix.len > 0 { "{l.prefix}.{prefix}" } else { prefix }
    out
}

/// Returns a copy of the logger whose records also carry `attrs`, after the attributes it already has.
pub fn with_attrs(l: Logger, attrs: []Attr) -> Logger {
    var out = l
    out.attrs = joined(l.attrs, attrs)
    out
}

/// Returns a copy of the logger with its minimum level set to `level`.
pub fn with_level(l: Logger, level: Level) -> Logger {
    var out = l
    out.level = level
    out
}

/// Returns a copy of the logger whose level comes from the `LOG_LEVEL` environment variable, keeping the current level when the variable is unset or invalid.
pub fn with_env_level(l: Logger) -> Logger {
    with_level(l, level_from_env(l.level))
}

/// Returns a copy of the logger that renders records in `format`.
pub fn with_format(l: Logger, format: Format) -> Logger {
    var out = l
    out.format = format
    out
}

/// Returns a copy of the logger that stamps records with the time when `on` is `true`, and omits it when `false`.
/// Timestamps are UTC, RFC 3339 with millisecond precision, taken from the logger's `clock`.
pub fn with_timestamps(l: Logger, on: bool) -> Logger {
    var out = l
    out.timestamps = on
    out
}

/// Returns a copy of the logger that reads the time for timestamps from `clock`, which returns nanoseconds since the Unix epoch.
pub fn with_clock(l: Logger, clock: fn() -> i64) -> Logger {
    var out = l
    out.clock = clock
    out
}

/// Returns a copy of the logger that passes the error of a failed `Fd` or `Stream` write to `f`.
pub fn with_error_handler(l: Logger, f: fn(io.Error)) -> Logger {
    var out = l
    out.on_error = f
    out
}

/// Returns a copy of the logger that writes to the descriptor `fd`, replacing any other sink.
pub fn with_fd(l: Logger, fd: i64) -> Logger {
    var out = l
    out.sink = Fd(fd)
    out
}

/// Returns a copy of the logger that writes lines to the stream `s`, replacing any other sink.
pub fn with_stream(l: Logger, s: io.Stream) -> Logger {
    var out = l
    out.sink = Stream(s)
    out
}

/// Returns a copy of the logger that passes each formatted line, without a newline, to `f`, replacing any other sink.
pub fn with_lines(l: Logger, f: fn(str)) -> Logger {
    var out = l
    out.sink = Lines(f)
    out
}

/// Returns a copy of the logger that passes each `Record` to `f`, replacing any other sink. The `format` is not applied.
pub fn with_handler(l: Logger, f: fn(Record)) -> Logger {
    var out = l
    out.sink = Handler(f)
    out
}
