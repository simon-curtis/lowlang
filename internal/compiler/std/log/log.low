pub enum Level {
    Debug
    Info
    Warn
    Error
}

pub struct Logger {
    pub level: Level = Info
    pub fd: i64 = 2
    pub prefix: str = ""
}

fn rank(l: Level) -> i64 {
    match l {
        Debug => 0
        Info => 1
        Warn => 2
        Error => 3
    }
}

fn label(l: Level) -> str {
    match l {
        Debug => "debug"
        Info => "info"
        Warn => "warn"
        Error => "error"
    }
}

pub fn enabled(l: Logger, level: Level) -> bool {
    rank(level) >= rank(l.level)
}

pub fn emit(l: Logger, level: Level, message: str) {
    if !enabled(l, level) {
        return
    }
    let line = if l.prefix.len > 0 { "{label(level)} {l.prefix}: {message}\n" } else { "{label(level)} {message}\n" }
    var done = 0
    for done < line.len {
        let n = __syscall(1, l.fd, __slice_ptr(line[done..]), line.len - done)
        if n <= 0 {
            return
        }
        done += n
    }
}

pub fn debug(l: Logger, message: str) {
    emit(l, Debug, message)
}

pub fn info(l: Logger, message: str) {
    emit(l, Info, message)
}

pub fn warn(l: Logger, message: str) {
    emit(l, Warn, message)
}

pub fn error(l: Logger, message: str) {
    emit(l, Error, message)
}

pub fn with_prefix(l: Logger, prefix: str) -> Logger {
    let joined = if l.prefix.len > 0 { "{l.prefix}.{prefix}" } else { prefix }
    Logger { level: l.level, fd: l.fd, prefix: joined }
}
