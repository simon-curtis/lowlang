import std/io

/// The two pipe ends that serve one bidirectional stream.
pub struct Duplex {
    /// Reads the bytes the stream delivers.
    pub input: Reader
    /// Writes the bytes to send on the stream.
    pub output: Writer
}

fn fill(s: io.Stream, handle: WriterHandle) {
    using w = adopt_writer(handle)
    for {
        let memory = get_memory(w, 2048)
        let n = s.read(memory) catch {
            _ => {
                fail_writer(w, Reset)
                return
            }
        }
        if n == 0 {
            return
        }
        advance(w, n)
        if flush(w).completed {
            return
        }
    }
}

fn pump(r: Reader, s: io.Stream) {
    for {
        let result = read(r) catch {
            _ => return
        }
        for part in spans(result.buffer) {
            io.write_all(s, part) catch {
                _ => return
            }
        }
        advance_to_end(r, result)
        if result.completed {
            return
        }
    }
}

fn drain(handle: ReaderHandle, s: io.Stream) {
    using r = adopt_reader(handle)
    pump(r, s)
    s.close()
}

/// Returns a `Reader` that delivers the bytes read from `s`.
///
/// Starts a green thread that reads `s` into the pipe and flushes after every read. At end of input the pipe's writer completes, and a read error fails the reader's `read` with `Reset`. The green thread stops once a flush reports that the reader has completed. It never closes `s`.
pub fn from_stream(s: io.Stream, options: Options) -> Reader {
    let e = ends(options)
    spawn fill(s, e.writer)
    adopt_reader(e.reader)
}

/// Returns a `Writer` whose flushed bytes are written to `s`.
///
/// Starts a green thread that writes the flushed bytes to `s`. It closes `s` when the writer completes or fails, or when a write to `s` fails, and then completes the reading end so the writer's flush reports `completed`.
pub fn to_stream(s: io.Stream, options: Options) -> Writer {
    let e = ends(options)
    spawn drain(e.reader, s)
    adopt_writer(e.writer)
}

/// Returns a `Duplex` that reads from and writes to `s`.
///
/// Combines `from_stream` and `to_stream` on the same stream, so `s` is closed once the output is completed.
pub fn duplex(s: io.Stream, options: Options) -> Duplex {
    Duplex { input: from_stream(s, options), output: to_stream(s, options) }
}
