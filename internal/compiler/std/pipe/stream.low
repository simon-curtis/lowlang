import std/io

pub struct Duplex {
    pub input: Reader
    pub output: Writer
}

fn fill(s: io.Stream, handle: WriterHandle) {
    using w = adopt_writer(handle)
    for {
        let memory = get_memory(w, 2048)
        let n = s.read(memory) catch {
            _ => {
                fail_writer(w, Reset)
                return
            }
        }
        if n == 0 {
            return
        }
        advance(w, n)
        if flush(w).completed {
            return
        }
    }
}

fn pump(r: Reader, s: io.Stream) {
    for {
        let result = read(r) catch {
            _ => return
        }
        for part in spans(result.buffer) {
            io.write_all(s, part) catch {
                _ => return
            }
        }
        advance_to_end(r, result)
        if result.completed {
            return
        }
    }
}

fn drain(handle: ReaderHandle, s: io.Stream) {
    using r = adopt_reader(handle)
    pump(r, s)
    s.close()
}

pub fn from_stream(s: io.Stream, options: Options) -> Reader {
    let e = ends(options)
    spawn fill(s, e.writer)
    adopt_reader(e.reader)
}

pub fn to_stream(s: io.Stream, options: Options) -> Writer {
    let e = ends(options)
    spawn drain(e.reader, s)
    adopt_writer(e.writer)
}

pub fn duplex(s: io.Stream, options: Options) -> Duplex {
    Duplex { input: from_stream(s, options), output: to_stream(s, options) }
}
