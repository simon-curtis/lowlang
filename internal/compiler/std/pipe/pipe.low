import std/io

struct Segment {
    data: []u8
    offset: i64
    filled: i64
}

struct State {
    lock: chan[bool]
    segments: []*Segment
    tail: *Segment?
    consumed: i64
    examined: i64
    committed: i64
    written: i64
    writer_done: bool
    reader_done: bool
    read_canceled: bool
    flush_canceled: bool
    reader_waiting: bool
    failure: io.Error?
    reader_wake: chan[bool]
    writer_wake: chan[bool]
    pause: i64
    resume: i64
    segment_size: i64
}

/// Tuning for a pipe: when a writer is held back and how large the buffer segments are.
pub struct Options {
    /// The number of committed, unconsumed bytes at which `flush` starts to park the writer.
    pub pause: i64 = 65536
    /// The number of unconsumed bytes below which the reader's `advance_to` wakes a parked writer.
    pub resume: i64 = 32768
    /// The smallest size, in bytes, of each buffer segment the writer allocates.
    pub segment_size: i64 = 4096
}

/// A copyable view of the reading end of a pipe, for use from a green thread that does not own the reader.
///
/// Releasing a handle does not complete the reader; `complete_reader_on` or the owning `Reader` does.
pub struct ReaderHandle {
    state: *State
}

/// The owner of the reading end of a pipe.
///
/// Dropping it completes the reader, so a writer never waits for an abandoned reader.
pub struct Reader {
    /// The copyable view of the reading end.
    pub handle: ReaderHandle
    drop complete_reader_on(handle)
}

/// A copyable view of the writing end of a pipe, for use from a green thread that does not own the writer.
///
/// Releasing a handle does not complete the writer; `complete_writer_on` or the owning `Writer` does.
pub struct WriterHandle {
    state: *State
}

/// The owner of the writing end of a pipe.
///
/// Dropping it completes the writer, so a reader never waits for an abandoned writer.
pub struct Writer {
    /// The copyable view of the writing end.
    pub handle: WriterHandle
    drop complete_writer_on(handle)
}

/// The two ends of a pipe.
///
/// Use one green thread for the writer and one for the reader.
pub struct Pipe {
    /// The end that reads.
    pub reader: Reader
    /// The end that writes.
    pub writer: Writer
}

struct Ends {
    reader: ReaderHandle
    writer: WriterHandle
}

/// A read-only view of a range of the bytes that have gone through a pipe, which can span several buffer segments.
///
/// Offsets are positions in the whole stream, counted from the first byte written. A sequence shares the pipe's buffer segments and does not copy them, and it keeps them alive after the reader has consumed past them.
pub struct Sequence {
    segments: []*Segment
    /// The stream offset of the first byte of the sequence.
    pub start: i64
    /// The stream offset just past the last byte of the sequence.
    pub end: i64
}

/// The outcome of a read: the bytes available, and whether the writer has finished or the read was cancelled.
pub struct ReadResult {
    /// All bytes that were flushed and not yet consumed, including bytes that earlier reads examined but did not consume.
    pub buffer: Sequence
    /// Whether the writer has finished, so that no data follows `buffer`.
    pub completed: bool
    /// Whether `cancel_pending_read` ended the read. `buffer` can be empty.
    pub canceled: bool
}

/// The outcome of a flush.
pub struct FlushResult {
    /// Whether the reader or the writer has finished, so there is no point in writing more.
    pub completed: bool
    /// Whether `cancel_pending_flush` ended the flush early.
    pub canceled: bool
}

fn ends(options: Options) -> Ends {
    let s = new(State {
        lock: chan[bool](1)
        segments: []
        tail: none
        consumed: 0
        examined: 0
        committed: 0
        written: 0
        writer_done: false
        reader_done: false
        read_canceled: false
        flush_canceled: false
        reader_waiting: false
        failure: none
        reader_wake: chan[bool](1)
        writer_wake: chan[bool](1)
        pause: options.pause
        resume: options.resume
        segment_size: options.segment_size
    })
    Ends { reader: ReaderHandle { state: s }, writer: WriterHandle { state: s } }
}

/// Returns a new pipe with the given options.
///
/// Bytes written to the `Writer` become readable from the `Reader` after `flush`.
pub fn pipe(options: Options) -> Pipe {
    let e = ends(options)
    Pipe { reader: adopt_reader(e.reader), writer: adopt_writer(e.writer) }
}

/// Returns the `Reader` that owns the reading end behind `h`, which completes it when dropped.
pub fn adopt_reader(h: ReaderHandle) -> Reader {
    Reader { handle: h }
}

/// Returns the `Writer` that owns the writing end behind `h`, which completes it when dropped.
pub fn adopt_writer(h: WriterHandle) -> Writer {
    Writer { handle: h }
}

fn lock(s: *State) {
    s.lock <- true
}

fn unlock(s: *State) {
    <-s.lock
}

fn signal(c: chan[bool]) {
    select {
        c <- true => {}
        else => {}
    }
}

fn sequence(s: *State, start: i64, end: i64) -> Sequence {
    var segments: []*Segment = []
    for seg in s.segments {
        push(mut segments, seg)
    }
    Sequence { segments, start, end }
}

/// Returns writable memory at the end of the pipe's buffer.
///
/// Does the same as `get_memory_on` on the writer's handle.
pub fn get_memory(w: Writer, hint: i64) -> []u8 {
    get_memory_on(w.handle, hint)
}

/// Returns a slice of at least `hint` bytes, or at least one when `hint` is less than 1, to write into.
///
/// Reuses the free space of the last segment when it is large enough and otherwise allocates a segment of `hint` bytes or `segment_size`, whichever is larger. The slice may be longer than `hint`. Call `advance_on` with the number of bytes filled; the bytes are visible to the reader only after `flush_on`. Does not park.
pub fn get_memory_on(h: WriterHandle, hint: i64) -> []u8 {
    let s = h.state
    let want = if hint < 1 { 1 } else { hint }
    match s.tail {
        some(tail) => {
            if tail.data.len - tail.filled >= want {
                return tail.data[tail.filled..]
            }
        }
        none => {}
    }
    let size = if want > s.segment_size { want } else { s.segment_size }
    let seg = new(Segment { data: __make(size), offset: s.written, filled: 0 })
    lock(s)
    push(mut s.segments, seg)
    unlock(s)
    s.tail = seg
    seg.data
}

/// Records that `n` bytes of the memory from `get_memory` were filled.
///
/// Does the same as `advance_on` on the writer's handle.
pub fn advance(w: Writer, n: i64) {
    advance_on(w.handle, n)
}

/// Records that `n` bytes of the memory from `get_memory_on` were filled.
///
/// Does nothing once the writer has finished. The bytes are not visible to the reader until `flush_on`.
pub fn advance_on(h: WriterHandle, n: i64) {
    let s = h.state
    if s.writer_done {
        return
    }
    match s.tail {
        some(tail) => {
            tail.filled += n
            s.written += n
        }
        none => {}
    }
}

/// Copies `data` into the pipe's buffer without flushing it.
///
/// Does the same as `write_on` on the writer's handle.
pub fn write(w: Writer, data: []u8) {
    write_on(w.handle, data)
}

/// Copies `data` into the pipe's buffer without flushing it.
///
/// Does not park, however much has been written. Call `flush_on` to make the bytes readable and to apply backpressure.
pub fn write_on(h: WriterHandle, data: []u8) {
    var rest = data
    for rest.len > 0 {
        let memory = get_memory_on(h, 1)
        let n = __memmove(memory, rest)
        advance_on(h, n)
        rest = rest[n..]
    }
}

/// Makes the written bytes readable and applies backpressure.
///
/// Does the same as `flush_on` on the writer's handle.
pub fn flush(w: Writer) -> FlushResult {
    flush_on(w.handle)
}

/// Makes every byte written so far readable, wakes a waiting reader, and parks the green thread while the reader is too far behind.
///
/// The writer parks while the reader has `pause` or more unconsumed bytes, until the reader consumes down to `resume`, completes, starts waiting for data or the flush is cancelled. The result reports whether the reader or the writer has completed, and whether `cancel_pending_flush_on` ended the flush.
pub fn flush_on(h: WriterHandle) -> FlushResult {
    let s = h.state
    lock(s)
    s.committed = s.written
    signal(s.reader_wake)
    for !s.reader_done && !s.writer_done && !s.flush_canceled && !s.reader_waiting && s.committed - s.consumed >= s.pause {
        unlock(s)
        <-s.writer_wake
        lock(s)
    }
    let result = FlushResult { completed: s.reader_done || s.writer_done, canceled: s.flush_canceled }
    s.flush_canceled = false
    unlock(s)
    result
}

/// Writes `data` and flushes the pipe.
///
/// Does the same as `write_and_flush_on` on the writer's handle.
pub fn write_and_flush(w: Writer, data: []u8) -> FlushResult {
    write_and_flush_on(w.handle, data)
}

/// Writes `data` with `write_on` and then flushes with `flush_on`, returning the flush result.
pub fn write_and_flush_on(h: WriterHandle, data: []u8) -> FlushResult {
    write_on(h, data)
    flush_on(h)
}

/// Finishes the writing end.
///
/// Does the same as `complete_writer_on` on the writer's handle.
pub fn complete_writer(w: Writer) {
    complete_writer_on(w.handle)
}

/// Finishes the writing end of the pipe.
///
/// Makes the bytes written so far readable and wakes the reader. The reader consumes what remains and then sees `completed`. Later calls do nothing.
pub fn complete_writer_on(h: WriterHandle) {
    let s = h.state
    lock(s)
    s.committed = s.written
    s.writer_done = true
    signal(s.reader_wake)
    signal(s.writer_wake)
    unlock(s)
}

/// Finishes the writing end with the error `e`.
///
/// Does the same as `fail_writer_on` on the writer's handle.
pub fn fail_writer(w: Writer, e: io.Error) {
    fail_writer_on(w.handle, e)
}

/// Finishes the writing end of the pipe with the error `e`.
///
/// Bytes written but not yet flushed are discarded. The reader consumes the bytes already flushed, and then its `read` fails with `e`. Does nothing if the writer has already finished.
pub fn fail_writer_on(h: WriterHandle, e: io.Error) {
    let s = h.state
    lock(s)
    if !s.writer_done {
        s.failure = e
        s.writer_done = true
        signal(s.reader_wake)
    }
    unlock(s)
}

/// Makes the writer's current or next flush return early.
///
/// Does the same as `cancel_pending_flush_on` on the writer's handle.
pub fn cancel_pending_flush(w: Writer) {
    cancel_pending_flush_on(w.handle)
}

/// Makes the current or next flush of the pipe return early with `canceled` set.
///
/// The request lasts until a flush returns.
pub fn cancel_pending_flush_on(h: WriterHandle) {
    let s = h.state
    lock(s)
    s.flush_canceled = true
    signal(s.writer_wake)
    unlock(s)
}

/// Waits for data and returns the bytes available.
///
/// Does the same as `read_on` on the reader's handle.
pub fn read(r: Reader) -> ReadResult ! io.Error {
    read_on(r.handle)
}

/// Waits until the writer has flushed bytes beyond the examined position, finished, or the read is cancelled, and returns everything not yet consumed.
///
/// Parks the green thread while it waits. Call `advance_to_on` afterwards to say how much was consumed and examined, otherwise the next call returns the same bytes at once. Fails with `NotConnected` after the reader has completed, and with the writer's error from `fail_writer_on` once no flushed bytes remain.
pub fn read_on(h: ReaderHandle) -> ReadResult ! io.Error {
    let s = h.state
    lock(s)
    for s.committed <= s.examined && !s.writer_done && !s.read_canceled && !s.reader_done {
        s.reader_waiting = true
        signal(s.writer_wake)
        unlock(s)
        <-s.reader_wake
        lock(s)
    }
    s.reader_waiting = false
    if s.reader_done {
        unlock(s)
        fail NotConnected
    }
    let canceled = s.read_canceled
    s.read_canceled = false
    let result = ReadResult { buffer: sequence(s, s.consumed, s.committed), completed: s.writer_done, canceled }
    let failure = s.failure
    unlock(s)
    match failure {
        some(e) => {
            if result.buffer.end == result.buffer.start {
                fail e
            }
        }
        none => {}
    }
    result
}

/// Returns the available bytes without waiting.
///
/// Does the same as `try_read_on` on the reader's handle.
pub fn try_read(r: Reader) -> ReadResult? {
    try_read_on(r.handle)
}

/// Returns the bytes not yet consumed if there are bytes beyond the examined position or the writer has finished, and `none` otherwise.
///
/// Does not park. Returns `none` after the reader has completed.
pub fn try_read_on(h: ReaderHandle) -> ReadResult? {
    let s = h.state
    lock(s)
    var out: ReadResult? = none
    if !s.reader_done && (s.committed > s.examined || s.writer_done) {
        out = ReadResult { buffer: sequence(s, s.consumed, s.committed), completed: s.writer_done, canceled: false }
    }
    unlock(s)
    out
}

/// Reports how much of the last read was consumed and examined.
///
/// Does the same as `advance_to_on` on the reader's handle.
pub fn advance_to(r: Reader, consumed: i64, examined: i64) {
    advance_to_on(r.handle, consumed, examined)
}

/// Reports how much of the data returned by reading was consumed and how much was examined.
///
/// Both arguments are stream offsets, the same as `Sequence.start` and `Sequence.end`. Bytes before `consumed` are released. The next `read_on` parks until data beyond `examined` arrives, so a parser that needs more data than it has passes the end of the buffer as `examined`. `consumed` cannot go backwards or past the flushed data, and `examined` is at least `consumed`. Wakes a parked writer when fewer than `resume` bytes remain unconsumed.
pub fn advance_to_on(h: ReaderHandle, consumed: i64, examined: i64) {
    let s = h.state
    lock(s)
    let keep_from = if consumed < s.consumed { s.consumed } else { consumed }
    s.consumed = if keep_from > s.committed { s.committed } else { keep_from }
    s.examined = if examined < s.consumed { s.consumed } else { examined }
    var first = 0
    for first < s.segments.len - 1 && s.segments[first].offset + s.segments[first].filled <= s.consumed {
        first += 1
    }
    if first > 0 {
        s.segments = s.segments[first..]
    }
    if s.committed - s.consumed < s.resume {
        signal(s.writer_wake)
    }
    unlock(s)
}

/// Consumes and examines everything in `result`.
pub fn advance_to_end(r: Reader, result: ReadResult) {
    advance_to_on(r.handle, result.buffer.end, result.buffer.end)
}

/// Finishes the reading end.
///
/// Does the same as `complete_reader_on` on the reader's handle.
pub fn complete_reader(r: Reader) {
    complete_reader_on(r.handle)
}

/// Finishes the reading end of the pipe.
///
/// Wakes a parked writer, whose flush reports `completed`, and a waiting `read_on`, which fails with `NotConnected`. Later calls do nothing.
pub fn complete_reader_on(h: ReaderHandle) {
    let s = h.state
    lock(s)
    s.reader_done = true
    signal(s.writer_wake)
    signal(s.reader_wake)
    unlock(s)
}

/// Makes the reader's current or next read return early.
///
/// Does the same as `cancel_pending_read_on` on the reader's handle.
pub fn cancel_pending_read(r: Reader) {
    cancel_pending_read_on(r.handle)
}

/// Makes the current or next read of the pipe return early with `canceled` set, possibly with an empty buffer.
///
/// The request lasts until a read returns.
pub fn cancel_pending_read_on(h: ReaderHandle) {
    let s = h.state
    lock(s)
    s.read_canceled = true
    signal(s.reader_wake)
    unlock(s)
}
