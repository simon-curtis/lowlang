import std/io

struct Segment {
    data: []u8
    offset: i64
    filled: i64
}

struct State {
    lock: chan[bool]
    segments: []*Segment
    tail: *Segment?
    consumed: i64
    examined: i64
    committed: i64
    written: i64
    writer_done: bool
    reader_done: bool
    read_canceled: bool
    flush_canceled: bool
    reader_waiting: bool
    failure: io.Error?
    reader_wake: chan[bool]
    writer_wake: chan[bool]
    pause: i64
    resume: i64
    segment_size: i64
}

pub struct Options {
    pub pause: i64 = 65536
    pub resume: i64 = 32768
    pub segment_size: i64 = 4096
}

pub struct ReaderHandle {
    state: *State
}

pub struct Reader {
    pub handle: ReaderHandle
    drop complete_reader_on(handle)
}

pub struct WriterHandle {
    state: *State
}

pub struct Writer {
    pub handle: WriterHandle
    drop complete_writer_on(handle)
}

pub struct Pipe {
    pub reader: Reader
    pub writer: Writer
}

struct Ends {
    reader: ReaderHandle
    writer: WriterHandle
}

pub struct Sequence {
    segments: []*Segment
    pub start: i64
    pub end: i64
}

pub struct ReadResult {
    pub buffer: Sequence
    pub completed: bool
    pub canceled: bool
}

pub struct FlushResult {
    pub completed: bool
    pub canceled: bool
}

fn ends(options: Options) -> Ends {
    let s = new(State {
        lock: chan[bool](1)
        segments: []
        tail: none
        consumed: 0
        examined: 0
        committed: 0
        written: 0
        writer_done: false
        reader_done: false
        read_canceled: false
        flush_canceled: false
        reader_waiting: false
        failure: none
        reader_wake: chan[bool](1)
        writer_wake: chan[bool](1)
        pause: options.pause
        resume: options.resume
        segment_size: options.segment_size
    })
    Ends { reader: ReaderHandle { state: s }, writer: WriterHandle { state: s } }
}

pub fn pipe(options: Options) -> Pipe {
    let e = ends(options)
    Pipe { reader: adopt_reader(e.reader), writer: adopt_writer(e.writer) }
}

pub fn adopt_reader(h: ReaderHandle) -> Reader {
    Reader { handle: h }
}

pub fn adopt_writer(h: WriterHandle) -> Writer {
    Writer { handle: h }
}

fn lock(s: *State) {
    s.lock <- true
}

fn unlock(s: *State) {
    <-s.lock
}

fn signal(c: chan[bool]) {
    select {
        c <- true => {}
        else => {}
    }
}

fn sequence(s: *State, start: i64, end: i64) -> Sequence {
    var segments: []*Segment = []
    for seg in s.segments {
        push(mut segments, seg)
    }
    Sequence { segments, start, end }
}

pub fn get_memory(w: Writer, hint: i64) -> []u8 {
    get_memory_on(w.handle, hint)
}

pub fn get_memory_on(h: WriterHandle, hint: i64) -> []u8 {
    let s = h.state
    let want = if hint < 1 { 1 } else { hint }
    match s.tail {
        some(tail) => {
            if tail.data.len - tail.filled >= want {
                return tail.data[tail.filled..]
            }
        }
        none => {}
    }
    let size = if want > s.segment_size { want } else { s.segment_size }
    let seg = new(Segment { data: __make(size), offset: s.written, filled: 0 })
    lock(s)
    push(mut s.segments, seg)
    unlock(s)
    s.tail = seg
    seg.data
}

pub fn advance(w: Writer, n: i64) {
    advance_on(w.handle, n)
}

pub fn advance_on(h: WriterHandle, n: i64) {
    let s = h.state
    if s.writer_done {
        return
    }
    match s.tail {
        some(tail) => {
            tail.filled += n
            s.written += n
        }
        none => {}
    }
}

pub fn write(w: Writer, data: []u8) {
    write_on(w.handle, data)
}

pub fn write_on(h: WriterHandle, data: []u8) {
    var rest = data
    for rest.len > 0 {
        let memory = get_memory_on(h, 1)
        let n = __memmove(memory, rest)
        advance_on(h, n)
        rest = rest[n..]
    }
}

pub fn flush(w: Writer) -> FlushResult {
    flush_on(w.handle)
}

pub fn flush_on(h: WriterHandle) -> FlushResult {
    let s = h.state
    lock(s)
    s.committed = s.written
    signal(s.reader_wake)
    for !s.reader_done && !s.writer_done && !s.flush_canceled && !s.reader_waiting && s.committed - s.consumed >= s.pause {
        unlock(s)
        <-s.writer_wake
        lock(s)
    }
    let result = FlushResult { completed: s.reader_done || s.writer_done, canceled: s.flush_canceled }
    s.flush_canceled = false
    unlock(s)
    result
}

pub fn write_and_flush(w: Writer, data: []u8) -> FlushResult {
    write_and_flush_on(w.handle, data)
}

pub fn write_and_flush_on(h: WriterHandle, data: []u8) -> FlushResult {
    write_on(h, data)
    flush_on(h)
}

pub fn complete_writer(w: Writer) {
    complete_writer_on(w.handle)
}

pub fn complete_writer_on(h: WriterHandle) {
    let s = h.state
    lock(s)
    s.committed = s.written
    s.writer_done = true
    signal(s.reader_wake)
    signal(s.writer_wake)
    unlock(s)
}

pub fn fail_writer(w: Writer, e: io.Error) {
    fail_writer_on(w.handle, e)
}

pub fn fail_writer_on(h: WriterHandle, e: io.Error) {
    let s = h.state
    lock(s)
    if !s.writer_done {
        s.failure = e
        s.writer_done = true
        signal(s.reader_wake)
    }
    unlock(s)
}

pub fn cancel_pending_flush(w: Writer) {
    cancel_pending_flush_on(w.handle)
}

pub fn cancel_pending_flush_on(h: WriterHandle) {
    let s = h.state
    lock(s)
    s.flush_canceled = true
    signal(s.writer_wake)
    unlock(s)
}

pub fn read(r: Reader) -> ReadResult ! io.Error {
    read_on(r.handle)
}

pub fn read_on(h: ReaderHandle) -> ReadResult ! io.Error {
    let s = h.state
    lock(s)
    for s.committed <= s.examined && !s.writer_done && !s.read_canceled && !s.reader_done {
        s.reader_waiting = true
        signal(s.writer_wake)
        unlock(s)
        <-s.reader_wake
        lock(s)
    }
    s.reader_waiting = false
    if s.reader_done {
        unlock(s)
        fail NotConnected
    }
    let canceled = s.read_canceled
    s.read_canceled = false
    let result = ReadResult { buffer: sequence(s, s.consumed, s.committed), completed: s.writer_done, canceled }
    let failure = s.failure
    unlock(s)
    match failure {
        some(e) => {
            if result.buffer.end == result.buffer.start {
                fail e
            }
        }
        none => {}
    }
    result
}

pub fn try_read(r: Reader) -> ReadResult? {
    try_read_on(r.handle)
}

pub fn try_read_on(h: ReaderHandle) -> ReadResult? {
    let s = h.state
    lock(s)
    var out: ReadResult? = none
    if !s.reader_done && (s.committed > s.examined || s.writer_done) {
        out = ReadResult { buffer: sequence(s, s.consumed, s.committed), completed: s.writer_done, canceled: false }
    }
    unlock(s)
    out
}

pub fn advance_to(r: Reader, consumed: i64, examined: i64) {
    advance_to_on(r.handle, consumed, examined)
}

pub fn advance_to_on(h: ReaderHandle, consumed: i64, examined: i64) {
    let s = h.state
    lock(s)
    let keep_from = if consumed < s.consumed { s.consumed } else { consumed }
    s.consumed = if keep_from > s.committed { s.committed } else { keep_from }
    s.examined = if examined < s.consumed { s.consumed } else { examined }
    var first = 0
    for first < s.segments.len - 1 && s.segments[first].offset + s.segments[first].filled <= s.consumed {
        first += 1
    }
    if first > 0 {
        s.segments = s.segments[first..]
    }
    if s.committed - s.consumed < s.resume {
        signal(s.writer_wake)
    }
    unlock(s)
}

pub fn advance_to_end(r: Reader, result: ReadResult) {
    advance_to_on(r.handle, result.buffer.end, result.buffer.end)
}

pub fn complete_reader(r: Reader) {
    complete_reader_on(r.handle)
}

pub fn complete_reader_on(h: ReaderHandle) {
    let s = h.state
    lock(s)
    s.reader_done = true
    signal(s.writer_wake)
    signal(s.reader_wake)
    unlock(s)
}

pub fn cancel_pending_read(r: Reader) {
    cancel_pending_read_on(r.handle)
}

pub fn cancel_pending_read_on(h: ReaderHandle) {
    let s = h.state
    lock(s)
    s.read_canceled = true
    signal(s.reader_wake)
    unlock(s)
}
