import std/io
import std/pipe

fn produce(handle: pipe.WriterHandle) {
    using w = pipe.adopt_writer(handle)
    for chunk in ["GET /ind", "ex\nPOST /sub", "mit\r\nGET /", "about\nPUT /a", "\nDELE", "TE /tmp"] {
        pipe.write_and_flush(w, bytes(chunk))
    }
}

fn consume(r: pipe.Reader) ! io.Error {
    var commands = 0
    for {
        let result = pipe.read(r)?
        let lines = pipe.sequence_reader(result.buffer)
        for {
            let line = pipe.read_line(lines) ?? break
            commands += 1
            print("command {commands}: {str(pipe.to_bytes(line))}")
        }
        if result.completed {
            let rest = pipe.unread(lines)
            if !pipe.is_empty(rest) {
                print("unterminated at end of input: {str(pipe.to_bytes(rest))}")
            }
            break
        }
        pipe.advance_to(r, pipe.consumed(lines), result.buffer.end)
    }
}

/// Reassembles request lines that arrive split across writes, and reports text left over when the writer finishes.
fn main() ! io.Error {
    using requests = pipe.pipe(pipe.Options {})
    spawn produce(requests.writer.handle)
    consume(requests.reader)?
}
