pub fn length(q: Sequence) -> i64 {
    q.end - q.start
}

pub fn is_empty(q: Sequence) -> bool {
    q.end == q.start
}

pub fn slice(q: Sequence, from: i64, to: i64) -> Sequence {
    let start = if from < q.start { q.start } else { from }
    let end = if to > q.end { q.end } else { to }
    Sequence { segments: q.segments, start, end: if end < start { start } else { end } }
}

pub fn spans(q: Sequence) -> [][]u8 {
    var out: [][]u8 = []
    for seg in q.segments {
        let lo = if q.start > seg.offset { q.start - seg.offset } else { 0 }
        let top = seg.offset + seg.filled
        let hi = if q.end < top { q.end - seg.offset } else { seg.filled }
        if lo < hi {
            push(mut out, seg.data[lo..hi])
        }
    }
    out
}

pub fn first(q: Sequence) -> []u8 {
    let parts = spans(q)
    if parts.len == 0 {
        let empty: []u8 = []
        return empty
    }
    parts[0]
}

pub fn to_bytes(q: Sequence) -> []u8 {
    let out: []u8 = __make(length(q))
    var at = 0
    for part in spans(q) {
        __memmove(out[at..], part)
        at += part.len
    }
    out
}

pub fn byte_at(q: Sequence, position: i64) -> u8 {
    for seg in q.segments {
        if position >= seg.offset && position < seg.offset + seg.filled {
            return seg.data[position - seg.offset]
        }
    }
    0
}

pub fn index_of(q: Sequence, b: u8) -> i64 {
    var at = q.start
    for part in spans(q) {
        for i, x in part {
            if x == b {
                return at + i
            }
        }
        at += part.len
    }
    -1
}

pub struct SequenceReader {
    sequence: Sequence
    position: i64
}

pub fn sequence_reader(q: Sequence) -> *SequenceReader {
    new(SequenceReader { sequence: q, position: q.start })
}

pub fn consumed(r: *SequenceReader) -> i64 {
    r.position
}

pub fn remaining(r: *SequenceReader) -> i64 {
    r.sequence.end - r.position
}

pub fn unread(r: *SequenceReader) -> Sequence {
    slice(r.sequence, r.position, r.sequence.end)
}

pub fn skip(r: *SequenceReader, n: i64) -> bool {
    if remaining(r) < n {
        return false
    }
    r.position += n
    true
}

pub fn next_byte(r: *SequenceReader) -> u8? {
    if r.position >= r.sequence.end {
        return none
    }
    let b = byte_at(r.sequence, r.position)
    r.position += 1
    b
}

pub fn peek_byte(r: *SequenceReader) -> u8? {
    if r.position >= r.sequence.end {
        return none
    }
    byte_at(r.sequence, r.position)
}

pub fn read_exact(r: *SequenceReader, n: i64) -> Sequence? {
    if remaining(r) < n {
        return none
    }
    let out = slice(r.sequence, r.position, r.position + n)
    r.position += n
    out
}

pub fn read_to(r: *SequenceReader, delimiter: u8) -> Sequence? {
    let rest = unread(r)
    let at = index_of(rest, delimiter)
    if at < 0 {
        return none
    }
    let out = slice(r.sequence, r.position, at)
    r.position = at + 1
    out
}

pub fn read_line(r: *SequenceReader) -> Sequence? {
    let line = read_to(r, '\n')
    match line {
        some(l) => {
            if length(l) > 0 && byte_at(l, l.end - 1) == '\r' {
                return slice(l, l.start, l.end - 1)
            }
            l
        }
        none => none
    }
}

pub fn is_next(r: *SequenceReader, expected: []u8) -> bool {
    if remaining(r) < expected.len {
        return false
    }
    for i, b in expected {
        if byte_at(r.sequence, r.position + i) != b {
            return false
        }
    }
    true
}

pub fn read_be(r: *SequenceReader, size: i64) -> u64? {
    if remaining(r) < size {
        return none
    }
    var v: u64 = 0
    for i in 0..size {
        v = v << 8 | u64(byte_at(r.sequence, r.position + i))
    }
    r.position += size
    v
}

pub fn read_le(r: *SequenceReader, size: i64) -> u64? {
    if remaining(r) < size {
        return none
    }
    var v: u64 = 0
    var i = size - 1
    for i >= 0 {
        v = v << 8 | u64(byte_at(r.sequence, r.position + i))
        i -= 1
    }
    r.position += size
    v
}
