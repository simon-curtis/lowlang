import std/math
import std/time/calendar
import std/time/fault
import std/time/offset

struct Kind {
    offset: offset.Offset
    dst: bool
    abbreviation: str
}

enum Day {
    Julian(n: i64)
    Ordinal(n: i64)
    Nth(month: i64, week: i64, weekday: i64)
}

struct Change {
    day: Day
    time: i64
}

struct Daylight {
    kind: Kind
    start: Change
    end: Change
}

struct Footer {
    standard: Kind
    daylight: Daylight?
}

struct Flip {
    at: i64
    before: Kind
    after: Kind
}

fn secs(k: Kind) -> i64 {
    offset.seconds_of(k.offset)
}

fn changed(a: Kind, b: Kind) -> bool {
    secs(a) != secs(b) || a.dst != b.dst || a.abbreviation != b.abbreviation
}

struct Scan {
    s: str
    at: i64
}

fn at_digit(p: Scan) -> bool {
    p.at < p.s.len && p.s[p.at] >= '0' && p.s[p.at] <= '9'
}

fn accept(mut p: Scan, c: u8) -> bool {
    if p.at < p.s.len && p.s[p.at] == c {
        p.at += 1
        return true
    }
    false
}

fn expect(mut p: Scan, c: u8) ! fault.Fault {
    if !accept(mut p, c) {
        fail Syntax(p.at)
    }
}

fn digits(mut p: Scan, least: i64, most: i64) -> i64 ! fault.Fault {
    var n = 0
    var count = 0
    for count < most && at_digit(p) {
        n = n * 10 + i64(p.s[p.at] - '0')
        p.at += 1
        count += 1
    }
    if count < least {
        fail Syntax(p.at)
    }
    n
}

fn name_byte(c: u8) -> bool {
    c >= 'A' && c <= 'Z' || c >= 'a' && c <= 'z'
}

fn rule_name(mut p: Scan) -> str ! fault.Fault {
    let quoted = accept(mut p, '<')
    let start = p.at
    for p.at < p.s.len && (if quoted { p.s[p.at] != '>' } else { name_byte(p.s[p.at]) }) {
        p.at += 1
    }
    let name = p.s[start..p.at]
    if quoted {
        expect(mut p, '>')?
    }
    if name.len < 3 {
        fail Syntax(start)
    }
    name
}

fn clock_part(mut p: Scan) -> i64 ! fault.Fault {
    let start = p.at
    let n = digits(mut p, 2, 2)?
    if n > 59 {
        fail Syntax(start)
    }
    n
}

fn rule_seconds(mut p: Scan) -> i64 ! fault.Fault {
    let negative = accept(mut p, '-')
    if !negative {
        accept(mut p, '+')
    }
    var total = digits(mut p, 1, 3)? * 3600
    if accept(mut p, ':') {
        total += clock_part(mut p)? * 60
        if accept(mut p, ':') {
            total += clock_part(mut p)?
        }
    }
    if negative { -total } else { total }
}

fn rule_day(mut p: Scan) -> Day ! fault.Fault {
    let start = p.at
    if accept(mut p, 'J') {
        let n = digits(mut p, 1, 3)?
        if n < 1 || n > 365 {
            fail Syntax(start)
        }
        return Julian(n)
    }
    if accept(mut p, 'M') {
        let month = digits(mut p, 1, 2)?
        expect(mut p, '.')?
        let week = digits(mut p, 1, 1)?
        expect(mut p, '.')?
        let weekday = digits(mut p, 1, 1)?
        if month < 1 || month > 12 || week < 1 || week > 5 || weekday > 6 {
            fail Syntax(start)
        }
        return Nth(month, week, weekday)
    }
    let n = digits(mut p, 1, 3)?
    if n > 365 {
        fail Syntax(start)
    }
    Ordinal(n)
}

fn rule_change(mut p: Scan) -> Change ! fault.Fault {
    let day = rule_day(mut p)?
    let time = if accept(mut p, '/') { rule_seconds(mut p)? } else { 7200 }
    Change { day, time }
}

fn parse_rule(s: str) -> Footer ! fault.Fault {
    var p = Scan { s, at: 0 }
    let standard_name = rule_name(mut p)?
    let standard_offset = offset.of_seconds(-rule_seconds(mut p)?)?
    let standard = Kind { offset: standard_offset, dst: false, abbreviation: standard_name }
    if p.at == s.len {
        return Footer { standard, daylight: none }
    }
    let daylight_name = rule_name(mut p)?
    var summer_seconds = secs(standard) + 3600
    if p.at < s.len && s[p.at] != ',' {
        summer_seconds = -rule_seconds(mut p)?
    }
    let summer_offset = offset.of_seconds(summer_seconds)?
    expect(mut p, ',')?
    let start = rule_change(mut p)?
    expect(mut p, ',')?
    let end = rule_change(mut p)?
    if p.at < s.len {
        fail Syntax(p.at)
    }
    let summer = Kind { offset: summer_offset, dst: true, abbreviation: daylight_name }
    Footer { standard, daylight: Daylight { kind: summer, start, end } }
}

fn year_of(secs: i64) -> i64 {
    calendar.civil_from_days(math.floor_div(secs, 86400)).year
}

fn day_number(d: Day, year: i64) -> i64 {
    let first = calendar.days_from_civil(year, 1, 1)
    match d {
        Julian(n) => first + n - 1 + if calendar.leap_year(year) && n >= 60 { 1 } else { 0 }
        Ordinal(n) => first + n
        Nth(month, week, weekday) => {
            let start = calendar.days_from_civil(year, month, 1)
            var day = math.floor_mod(weekday - math.floor_mod(start + 4, 7), 7) + (week - 1) * 7
            if day >= calendar.days_in_month(year, month) {
                day -= 7
            }
            start + day
        }
    }
}

fn change_at(c: Change, year: i64, wall_offset: i64) -> i64 {
    day_number(c.day, year) * 86400 + c.time - wall_offset
}

fn flip_in(f: Footer, d: Daylight, year: i64, entering: bool) -> Flip {
    if entering {
        return Flip { at: change_at(d.start, year, secs(f.standard)), before: f.standard, after: d.kind }
    }
    Flip { at: change_at(d.end, year, secs(d.kind)), before: d.kind, after: f.standard }
}

fn degenerate(f: Footer, d: Daylight, year: i64) -> bool {
    flip_in(f, d, year, true).at == flip_in(f, d, year, false).at
}

fn footer_next(f: Footer, after: i64) -> Flip? {
    let d = f.daylight ?? return none
    let year = year_of(after)
    var best = flip_in(f, d, year, true)
    var found = false
    for y in year - 1..year + 3 {
        if degenerate(f, d, y) {
            continue
        }
        for k in 0..2 {
            let flip = flip_in(f, d, y, k == 0)
            if flip.at > after && (!found || flip.at < best.at) {
                best = flip
                found = true
            }
        }
    }
    if !found {
        return none
    }
    best
}

fn footer_previous(f: Footer, bound: i64) -> Flip? {
    let d = f.daylight ?? return none
    let year = year_of(bound)
    var best = flip_in(f, d, year, true)
    var found = false
    for y in year - 2..year + 2 {
        if degenerate(f, d, y) {
            continue
        }
        for k in 0..2 {
            let flip = flip_in(f, d, y, k == 0)
            if flip.at < bound && (!found || flip.at > best.at) {
                best = flip
                found = true
            }
        }
    }
    if !found {
        return none
    }
    best
}

fn footer_kind(f: Footer, at: i64) -> Kind {
    let flip = footer_previous(f, at + 1) ?? return f.standard
    flip.after
}
