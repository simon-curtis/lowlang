import std/io
import std/time/fault
import std/time/offset

struct Rules {
    times: []i64
    segments: []Kind
    before: Kind
    last: Kind
    footer: Footer?
}

struct Header {
    utc_count: i64
    standard_count: i64
    leap_count: i64
    time_count: i64
    type_count: i64
    char_count: i64
}

struct Record {
    offset: i64
    dst: bool
    name_at: i64
}

fn signed32(b: []u8, at: i64) -> i64 {
    let v = io.be32(b, at)
    if v >= 0x80000000 { v - 0x100000000 } else { v }
}

fn read_header(data: []u8, at: i64) -> Header ! fault.Fault {
    if data.len < at + 44 || data[at] != 'T' || data[at + 1] != 'Z' || data[at + 2] != 'i' || data[at + 3] != 'f' {
        fail Malformed("zone data")
    }
    let h = Header {
        utc_count: io.be32(data, at + 20)
        standard_count: io.be32(data, at + 24)
        leap_count: io.be32(data, at + 28)
        time_count: io.be32(data, at + 32)
        type_count: io.be32(data, at + 36)
        char_count: io.be32(data, at + 40)
    }
    if h.type_count == 0 || h.type_count > 256 || data.len < at + 44 + body_size(h, 4) {
        fail Malformed("zone data")
    }
    h
}

fn body_size(h: Header, width: i64) -> i64 {
    h.time_count * (width + 1) + h.type_count * 6 + h.char_count + h.leap_count * (width + 4) + h.standard_count + h.utc_count
}

pub fn decode(name: str, data: []u8) -> Zone ! fault.Fault {
    let first = read_header(data, 0)?
    if data[4] == 0 {
        return body(name, data, first, 44, 4, none)
    }
    let at = 44 + body_size(first, 4)
    let h = read_header(data, at)?
    let end = at + 44 + body_size(h, 8)
    if data.len < end {
        fail Malformed("zone data")
    }
    let rule = read_footer(data, end)?
    body(name, data, h, at + 44, 8, rule)
}

fn transition_time(data: []u8, at: i64, width: i64, i: i64) -> i64 {
    if width == 8 { io.be64(data, at + i * 8) } else { signed32(data, at + i * 4) }
}

fn read_footer(data: []u8, at: i64) -> Footer? ! fault.Fault {
    if at >= data.len || data[at] != '\n' {
        fail Malformed("zone footer")
    }
    var end = at + 1
    for end < data.len && data[end] != '\n' {
        end += 1
    }
    if end >= data.len {
        fail Malformed("zone footer")
    }
    if end == at + 1 {
        return none
    }
    let rule = str(data[at + 1..end])
    parse_rule(rule) catch {
        e => fail Malformed("zone footer")
    }
}

fn abbreviation_at(chars: []u8, at: i64) -> str ! fault.Fault {
    if at >= chars.len {
        fail Malformed("zone abbreviation")
    }
    var end = at
    for end < chars.len && chars[end] != 0 {
        end += 1
    }
    str(chars[at..end])
}

fn read_records(data: []u8, at: i64, count: i64) -> []Record {
    var records: []Record = []
    for i in 0..count {
        let p = at + i * 6
        push(mut records, Record { offset: signed32(data, p), dst: data[p + 4] != 0, name_at: i64(data[p + 5]) })
    }
    records
}

fn first_standard(kinds: []Kind, fallback: Kind) -> Kind {
    for k in kinds {
        if !k.dst {
            return k
        }
    }
    fallback
}

fn body(name: str, data: []u8, h: Header, at: i64, width: i64, footer: Footer?) -> Zone ! fault.Fault {
    var times: []i64 = []
    var types: []i64 = []
    let index_at = at + h.time_count * width
    for i in 0..h.time_count {
        push(mut times, transition_time(data, at, width, i))
        let t = i64(data[index_at + i])
        if t >= h.type_count {
            fail Malformed("zone transition type")
        }
        push(mut types, t)
    }
    let records_at = index_at + h.time_count
    let chars_at = records_at + h.type_count * 6
    let chars = data[chars_at..chars_at + h.char_count]
    let records = read_records(data, records_at, h.type_count)
    var kinds: []Kind = []
    for r in records {
        let o = offset.of_seconds(r.offset) catch {
            e => fail Malformed("zone offset")
        }
        let abbreviation = abbreviation_at(chars, r.name_at)?
        push(mut kinds, Kind { offset: o, dst: r.dst, abbreviation })
    }
    var segments: []Kind = []
    for t in types {
        push(mut segments, kinds[t])
    }
    let last = if segments.len > 0 { segments[segments.len - 1] } else { kinds[0] }
    let fallback = if segments.len > 0 { segments[0] } else { kinds[0] }
    let before = first_standard(kinds, fallback)
    Zone { name, rules: new(Rules { times, segments, before, last, footer }) }
}
