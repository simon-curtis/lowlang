import std/io

pub struct Date {
    pub year: i64
    pub month: i64
    pub day: i64
}

pub struct DateTime {
    pub date: Date
    pub hour: i64 = 0
    pub minute: i64 = 0
    pub second: i64 = 0
    pub nanosecond: i64 = 0
}

pub struct Instant {
    pub local: DateTime
    pub offset: i64
}

pub enum Weekday {
    Monday
    Tuesday
    Wednesday
    Thursday
    Friday
    Saturday
    Sunday
}

fn floor_div(a: i64, b: i64) -> i64 {
    let q = a / b
    if a % b != 0 && (a < 0) != (b < 0) { q - 1 } else { q }
}

fn floor_mod(a: i64, b: i64) -> i64 {
    a - floor_div(a, b) * b
}

fn seconds_per_day() -> i64 {
    86400
}

fn epoch_ordinal() -> i64 {
    719163
}

pub fn leap_year(year: i64) -> bool {
    year % 4 == 0 && (year % 100 != 0 || year % 400 == 0)
}

pub fn days_in_month(year: i64, month: i64) -> i64 {
    if month == 2 {
        return if leap_year(year) { 29 } else { 28 }
    }
    if month == 4 || month == 6 || month == 9 || month == 11 { 30 } else { 31 }
}

pub fn days_from_civil(year: i64, month: i64, day: i64) -> i64 {
    let y = if month <= 2 { year - 1 } else { year }
    let era = floor_div(y, 400)
    let yoe = y - era * 400
    let doy = (153 * ((month + 9) % 12) + 2) / 5 + day - 1
    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
    era * 146097 + doe - 719468
}

pub fn civil_from_days(days: i64) -> Date {
    let z = days + 719468
    let era = floor_div(z, 146097)
    let doe = z - era * 146097
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
    let mp = (5 * doy + 2) / 153
    let day = doy - (153 * mp + 2) / 5 + 1
    let month = if mp < 10 { mp + 3 } else { mp - 9 }
    Date { year: yoe + era * 400 + if month <= 2 { 1 } else { 0 }, month, day }
}

pub fn date(year: i64, month: i64, day: i64) -> Date ! io.Error {
    if month < 1 || month > 12 || day < 1 || day > days_in_month(year, month) {
        fail Invalid
    }
    Date { year, month, day }
}

pub fn days(d: Date) -> i64 {
    days_from_civil(d.year, d.month, d.day)
}

pub fn ordinal(d: Date) -> i64 {
    days(d) + epoch_ordinal()
}

pub fn from_ordinal(n: i64) -> Date {
    civil_from_days(n - epoch_ordinal())
}

pub fn add_days(d: Date, n: i64) -> Date {
    civil_from_days(days(d) + n)
}

fn sign(a: i64, b: i64) -> i64 {
    if a < b { -1 } else if a > b { 1 } else { 0 }
}

pub fn compare(a: Date, b: Date) -> i64 {
    if a.year != b.year {
        return sign(a.year, b.year)
    }
    if a.month != b.month {
        return sign(a.month, b.month)
    }
    sign(a.day, b.day)
}

pub fn weekday(d: Date) -> Weekday {
    let all: []Weekday = [Monday, Tuesday, Wednesday, Thursday, Friday, Saturday, Sunday]
    all[floor_mod(days(d) + 3, 7)]
}

pub fn weekday_name(w: Weekday) -> str {
    match w {
        Monday => "Monday"
        Tuesday => "Tuesday"
        Wednesday => "Wednesday"
        Thursday => "Thursday"
        Friday => "Friday"
        Saturday => "Saturday"
        Sunday => "Sunday"
    }
}

pub fn from_unix(seconds: i64) -> DateTime {
    let d = floor_div(seconds, seconds_per_day())
    let rest = seconds - d * seconds_per_day()
    DateTime { date: civil_from_days(d), hour: rest / 3600, minute: rest / 60 % 60, second: rest % 60 }
}

pub fn to_unix(dt: DateTime) -> i64 {
    days(dt.date) * seconds_per_day() + dt.hour * 3600 + dt.minute * 60 + dt.second
}

pub fn at_offset(seconds: i64, offset: i64) -> Instant {
    Instant { local: from_unix(seconds + offset), offset }
}

pub fn timestamp(i: Instant) -> i64 {
    to_unix(i.local) - i.offset
}
