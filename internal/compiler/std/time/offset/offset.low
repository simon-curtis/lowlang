import std/text
import std/time/fault

/// A fixed difference from UTC in whole seconds, positive to the east, from `-25:59:59` to `+25:59:59`.
pub struct Offset {
    secs: i64
}

fn limit() -> i64 {
    93599
}

/// Returns the zero offset.
pub fn utc() -> Offset {
    Offset { secs: 0 }
}

/// Returns the offset of `n` seconds from UTC.
///
/// Fails with `OutOfRange` when `n` is beyond `25:59:59` in either direction.
pub fn of_seconds(n: i64) -> Offset ! fault.Fault {
    if n < -limit() || n > limit() {
        fail OutOfRange("offset")
    }
    Offset { secs: n }
}

/// Returns the offset of `h` whole hours.
///
/// Fails with `OutOfRange` when `h` is below `-25` or above `25`.
pub fn hours(h: i64) -> Offset ! fault.Fault {
    if h < -26 || h > 26 {
        fail OutOfRange("offset")
    }
    of_seconds(h * 3600)?
}

/// Returns the offset of `h` hours and `m` minutes.
///
/// The sign of `h` applies to the minutes as well, so `hm(-3, 30)` is `-03:30`. Fails with `OutOfRange` when the result is beyond `25:59:59` and with `Invalid` when `m` is not from `0` to `59`.
pub fn hm(h: i64, m: i64) -> Offset ! fault.Fault {
    if h < -26 || h > 26 {
        fail OutOfRange("offset")
    }
    if m < 0 || m > 59 {
        fail Invalid("offset minutes")
    }
    let magnitude = (if h < 0 { -h } else { h }) * 3600 + m * 60
    of_seconds(if h < 0 { -magnitude } else { magnitude })?
}

/// Returns the offset as signed seconds from UTC.
pub fn seconds_of(o: Offset) -> i64 {
    o.secs
}

/// Returns whether the offset is zero.
pub fn is_utc(o: Offset) -> bool {
    o.secs == 0
}

/// Returns the offset with its sign reversed.
pub fn negate(o: Offset) -> Offset {
    Offset { secs: -o.secs }
}

/// Returns `-1`, `0` or `1` as `a` is west of, equal to or east of `b`.
pub fn compare(a: Offset, b: Offset) -> i64 {
    if a.secs < b.secs {
        return -1
    }
    if a.secs > b.secs { 1 } else { 0 }
}

/// Returns whether the two offsets are the same.
pub fn equal(a: Offset, b: Offset) -> bool {
    a.secs == b.secs
}

/// Returns whether `a` is west of `b`.
pub fn before(a: Offset, b: Offset) -> bool {
    a.secs < b.secs
}

/// Returns whether `a` is east of `b`.
pub fn after(a: Offset, b: Offset) -> bool {
    a.secs > b.secs
}

/// Returns the more western of the two offsets.
pub fn min(a: Offset, b: Offset) -> Offset {
    if b.secs < a.secs { b } else { a }
}

/// Returns the more eastern of the two offsets.
pub fn max(a: Offset, b: Offset) -> Offset {
    if b.secs > a.secs { b } else { a }
}

fn pad(n: i64) -> str {
    text.pad_left("{n}", 2, '0')
}

/// Returns the offset as `+hh:mm`, or `+hh:mm:ss` when it has a seconds part.
///
/// Zero renders as `+00:00`.
pub fn to_string(o: Offset) -> str {
    let sign = if o.secs < 0 { "-" } else { "+" }
    let magnitude = if o.secs < 0 { -o.secs } else { o.secs }
    let hours = pad(magnitude / 3600)
    let minutes = pad(magnitude % 3600 / 60)
    let seconds = magnitude % 60
    let tail = if seconds == 0 { "" } else { ":{pad(seconds)}" }
    "{sign}{hours}:{minutes}{tail}"
}

/// Returns `Z` for a zero offset and the `to_string` form otherwise.
pub fn to_string_z(o: Offset) -> str {
    if o.secs == 0 { "Z" } else { to_string(o) }
}

struct Scan {
    s: str
    at: i64
}

fn at_digit(p: Scan) -> bool {
    p.at < p.s.len && p.s[p.at] >= '0' && p.s[p.at] <= '9'
}

fn at_byte(p: Scan, c: u8) -> bool {
    p.at < p.s.len && p.s[p.at] == c
}

fn digits(mut p: Scan) -> i64 ! fault.Fault {
    var n = 0
    for _ in 0..2 {
        if !at_digit(p) {
            fail Syntax(p.at)
        }
        n = n * 10 + i64(p.s[p.at] - '0')
        p.at += 1
    }
    n
}

/// Parses an offset written as `Z`, `z`, `+hh`, `+hhmm`, `+hh:mm`, `+hhmmss` or `+hh:mm:ss`, with `-` accepted for the sign.
///
/// `Z` must stand alone. Fails with `Syntax` at the offset of the first byte that does not fit, and with `OutOfRange` when an hour is above `25`, a minute or second is above `59` or the result is out of range.
pub fn parse(s: str) -> Offset ! fault.Fault {
    var p = Scan { s, at: 0 }
    if at_byte(p, 'Z') || at_byte(p, 'z') {
        if s.len > 1 {
            fail Syntax(1)
        }
        return utc()
    }
    if !at_byte(p, '+') && !at_byte(p, '-') {
        fail Syntax(0)
    }
    let sign = if s[0] == '-' { -1 } else { 1 }
    p.at = 1
    let hours = digits(mut p)?
    var minutes = 0
    var seconds = 0
    if at_byte(p, ':') {
        p.at += 1
        minutes = digits(mut p)?
        if at_byte(p, ':') {
            p.at += 1
            seconds = digits(mut p)?
        }
    } else if at_digit(p) {
        minutes = digits(mut p)?
        if at_digit(p) {
            seconds = digits(mut p)?
        }
    }
    if p.at < s.len {
        fail Syntax(p.at)
    }
    if hours > 25 || minutes > 59 || seconds > 59 {
        fail OutOfRange("offset")
    }
    of_seconds(sign * (hours * 3600 + minutes * 60 + seconds))?
}
