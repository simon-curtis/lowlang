import std/math
import std/text
import std/time/date
import std/time/duration
import std/time/fault
import std/time/pattern
import std/time/rounding
import std/time/span
import std/time/timeofday

/// A date and a time of day on a wall clock, with no offset or zone.
///
/// It names a local time, not an instant. Arithmetic treats every day as exactly 24 hours, so it never accounts for daylight saving changes. Use `zoned` for that. A `DateTime` is a `date.Date` from `-9999-01-01` to `9999-12-31` with a `timeofday.TimeOfDay`.
pub struct DateTime {
    day: date.Date
    clock: timeofday.TimeOfDay
}

fn day_nanos() -> i64 {
    86400000000000
}

fn day_length() -> duration.Duration {
    duration.seconds(86400)
}

/// Returns the date-time with the given year `y`, month number `mo`, day `d`, hour `h`, minute `mi`, second `s` and nanosecond `ns`.
///
/// Fails with `OutOfRange` or `Invalid` as `date.of` and `timeofday.of` do.
pub fn of(y: i64, mo: i64, d: i64, h: i64, mi: i64, s: i64, ns: i64) -> DateTime ! fault.Fault {
    let day = date.of(y, mo, d)?
    let clock = timeofday.of(h, mi, s, ns)?
    DateTime { day, clock }
}

/// Returns the date-time made of the date `d` and the time of day `t`.
pub fn from_parts(d: date.Date, t: timeofday.TimeOfDay) -> DateTime {
    DateTime { day: d, clock: t }
}

/// Returns the date-time at `00:00` on `d`.
pub fn start_of_day(d: date.Date) -> DateTime {
    DateTime { day: d, clock: timeofday.midnight() }
}

/// Returns the date-time at `23:59:59.999999999` on `d`.
pub fn end_of_day(d: date.Date) -> DateTime {
    DateTime { day: d, clock: timeofday.last() }
}

/// Returns `1970-01-01T00:00:00`.
pub fn epoch() -> DateTime {
    start_of_day(date.epoch())
}

/// Returns the date part of `dt`.
pub fn date(dt: DateTime) -> date.Date {
    dt.day
}

/// Returns the time-of-day part of `dt`.
pub fn time(dt: DateTime) -> timeofday.TimeOfDay {
    dt.clock
}

/// Returns the year of `dt`.
pub fn year(dt: DateTime) -> i64 {
    date.year(dt.day)
}

/// Returns the month of `dt`.
pub fn month(dt: DateTime) -> date.Month {
    date.month(dt.day)
}

/// Returns the month of `dt` as a number from `1` to `12`.
pub fn month_number(dt: DateTime) -> i64 {
    date.month_number(dt.day)
}

/// Returns the day of the month of `dt`.
pub fn day(dt: DateTime) -> i64 {
    date.day(dt.day)
}

/// Returns the day of the week of `dt`.
pub fn weekday(dt: DateTime) -> date.Weekday {
    date.weekday(dt.day)
}

/// Returns the day of the year of `dt`, from `1`.
pub fn day_of_year(dt: DateTime) -> i64 {
    date.day_of_year(dt.day)
}

/// Returns the hour of `dt`, from `0` to `23`.
pub fn hour(dt: DateTime) -> i64 {
    timeofday.hour(dt.clock)
}

/// Returns the minute of `dt`, from `0` to `59`.
pub fn minute(dt: DateTime) -> i64 {
    timeofday.minute(dt.clock)
}

/// Returns the second of `dt`, from `0` to `59`.
pub fn second(dt: DateTime) -> i64 {
    timeofday.second(dt.clock)
}

/// Returns the nanosecond within the second of `dt`, from `0` to `999999999`.
pub fn nanosecond(dt: DateTime) -> i64 {
    timeofday.nanosecond(dt.clock)
}

/// Returns `dt` with its date replaced by `d`.
pub fn with_date(dt: DateTime, d: date.Date) -> DateTime {
    DateTime { day: d, clock: dt.clock }
}

/// Returns `dt` with its time of day replaced by `t`.
pub fn with_time(dt: DateTime, t: timeofday.TimeOfDay) -> DateTime {
    DateTime { day: dt.day, clock: t }
}

/// Returns the whole seconds from `1970-01-01T00:00:00` to `dt`, counting the local time as if it were UTC.
///
/// The fraction of a second is dropped, and the result is negative before the epoch.
pub fn civil_seconds(dt: DateTime) -> i64 {
    date.epoch_days(dt.day) * 86400 + timeofday.nanos_of_day(dt.clock) / 1000000000
}

/// Returns the date-time `secs` seconds and `nanos` nanoseconds after `1970-01-01T00:00:00`, counting as if the local time were UTC.
///
/// Fails with `OutOfRange` when `nanos` is outside `0` to `999999999` or the date-time is outside the supported years.
pub fn from_civil_seconds(secs: i64, nanos: i64) -> DateTime ! fault.Fault {
    if nanos < 0 || nanos >= 1000000000 {
        fail OutOfRange("nanosecond")
    }
    let days = math.floor_div(secs, 86400)
    let d = date.from_epoch_days(days)?
    let clock = timeofday.from_nanos_of_day((secs - days * 86400) * 1000000000 + nanos)?
    DateTime { day: d, clock }
}

fn place(d: date.Date, offset: duration.Duration) -> DateTime ! fault.Fault {
    let secs = duration.floor_seconds(offset)
    let carry = math.floor_div(secs, 86400)
    let moved = date.plus_days(d, carry)?
    let nanos = (secs - carry * 86400) * 1000000000 + duration.floor_nanos(offset)
    let clock = timeofday.from_nanos_of_day(nanos)?
    DateTime { day: moved, clock }
}

fn clock_offset(dt: DateTime) -> duration.Duration {
    duration.nanoseconds(timeofday.nanos_of_day(dt.clock))
}

/// Returns the date-time `d` after `dt`, counting every day as 24 hours.
///
/// A negative `d` moves backwards. Fails with `Overflow` when the sum does not fit in a `Duration` and with `OutOfRange` when the result is outside the supported years.
pub fn plus_duration(dt: DateTime, d: duration.Duration) -> DateTime ! fault.Fault {
    let offset = duration.try_plus(clock_offset(dt), d) ?? fail Overflow
    place(dt.day, offset)?
}

/// Returns the date-time `d` before `dt`.
///
/// Fails as `plus_duration` does.
pub fn minus_duration(dt: DateTime, d: duration.Duration) -> DateTime ! fault.Fault {
    plus_duration(dt, duration.negate(d))?
}

/// Returns `dt` moved forward by the span `s`.
///
/// The years, months, weeks and days are added to the date as `date.plus` does, with the day moved back to the last day of a shorter month. The time units are then added as an exact duration, carrying into the date. A negative span moves backwards. Fails with `OutOfRange` when the result is outside the supported years and with `Overflow` when the time units do not fit in a `Duration`.
pub fn plus(dt: DateTime, s: span.Span) -> DateTime ! fault.Fault {
    let moved = date.plus(dt.day, span.calendar_part(s))?
    let offset = duration.try_plus(clock_offset(dt), span.time_duration(s)) ?? fail Overflow
    place(moved, offset)?
}

/// Returns `dt` moved back by the span `s`.
///
/// Fails as `plus` does.
pub fn minus(dt: DateTime, s: span.Span) -> DateTime ! fault.Fault {
    plus(dt, span.negate(s))?
}

/// Returns the exact length of time from `a` to `b`, counting every day as 24 hours, which is negative when `b` is earlier.
pub fn duration_until(a: DateTime, b: DateTime) -> duration.Duration {
    let days = date.days_until(a.day, b.day)
    let nanos = timeofday.nanos_of_day(b.clock) - timeofday.nanos_of_day(a.clock)
    duration.from_parts(days * 86400, nanos)
}

fn calendar_until(a: DateTime, b: DateTime, diff: span.Diff) -> span.Span ! fault.Fault {
    let days = date.days_until(a.day, b.day)
    let gap = duration.nanoseconds(timeofday.nanos_of_day(b.clock) - timeofday.nanos_of_day(a.clock))
    if days > 0 && duration.is_negative(gap) {
        let end = date.plus_days(b.day, -1)?
        return date.until_with_time(a.day, end, duration.plus(gap, day_length()), diff)?
    }
    if days < 0 && !duration.is_negative(gap) && !duration.is_zero(gap) {
        let end = date.plus_days(b.day, 1)?
        return date.until_with_time(a.day, end, duration.minus(gap, day_length()), diff)?
    }
    date.until_with_time(a.day, b.day, gap, diff)?
}

/// Returns the span from `a` to `b`, measured and rounded as `diff` says.
///
/// The span is negative when `b` is earlier. When `diff.largest` is a calendar unit, years and months are counted on the calendar from `a` and the remainder is split into weeks, days and time units. Otherwise the span is the exact duration split into time units from `largest` down. Fails with `Invalid` when the options are inconsistent as `span.check_diff` and `span.check_time_increment` state, and with `OutOfRange` or `Overflow` where the result cannot be represented.
pub fn until(a: DateTime, b: DateTime, diff: span.Diff) -> span.Span ! fault.Fault {
    span.check_diff(diff)?
    span.check_time_increment(diff.smallest, diff.increment, diff.largest)?
    if span.is_calendar(diff.largest) {
        return calendar_until(a, b, diff)?
    }
    span.of_elapsed(duration_until(a, b), diff)?
}

/// Returns the span from `b` to `a`, measured and rounded as `diff` says.
///
/// Fails as `until` does.
pub fn since(a: DateTime, b: DateTime, diff: span.Diff) -> span.Span ! fault.Fault {
    until(b, a, diff)?
}

fn rounded_clock(dt: DateTime, unit: span.Unit, increment: i64, mode: rounding.Rounding) -> i64 ! fault.Fault {
    if unit != span.Unit.Days {
        return timeofday.rounded_nanos(dt.clock, unit, increment, mode)?
    }
    if increment != 1 {
        fail Invalid("rounding increment")
    }
    rounding.apply(0, timeofday.nanos_of_day(dt.clock), day_nanos(), mode) * day_nanos()
}

/// Returns `dt` with its time of day rounded to a multiple of `increment` `unit`s since midnight using `mode`.
///
/// `unit` can be `Days`, which needs an increment of `1` and rounds to a midnight. A result that reaches the end of the day becomes `00:00` on the next day. Fails with `Invalid` when `unit` is a larger calendar unit or the increment does not divide the next larger unit as `timeofday.rounded_nanos` states, and with `OutOfRange` when rounding up passes the last supported date.
pub fn round(dt: DateTime, unit: span.Unit, increment: i64, mode: rounding.Rounding) -> DateTime ! fault.Fault {
    let nanos = rounded_clock(dt, unit, increment, mode)?
    if nanos >= day_nanos() {
        let next = date.plus_days(dt.day, 1)?
        return start_of_day(next)
    }
    let clock = timeofday.from_nanos_of_day(nanos)?
    DateTime { day: dt.day, clock }
}

/// Returns `dt` with everything below `unit` set to zero.
///
/// Fails as `round` does.
pub fn truncate(dt: DateTime, unit: span.Unit) -> DateTime ! fault.Fault {
    round(dt, unit, 1, rounding.Rounding.Trunc)?
}

/// Returns `-1`, `0` or `1` as `a` is earlier than, the same as or later than `b`.
pub fn compare(a: DateTime, b: DateTime) -> i64 {
    let c = date.compare(a.day, b.day)
    if c != 0 {
        return c
    }
    timeofday.compare(a.clock, b.clock)
}

/// Returns whether `a` and `b` are the same date and time of day.
pub fn equal(a: DateTime, b: DateTime) -> bool {
    compare(a, b) == 0
}

/// Returns whether `a` is earlier than `b`.
pub fn before(a: DateTime, b: DateTime) -> bool {
    compare(a, b) < 0
}

/// Returns whether `a` is later than `b`.
pub fn after(a: DateTime, b: DateTime) -> bool {
    compare(a, b) > 0
}

/// Returns the earlier of the two date-times, or `a` when they are equal.
pub fn min(a: DateTime, b: DateTime) -> DateTime {
    if compare(b, a) < 0 { b } else { a }
}

/// Returns the later of the two date-times, or `a` when they are equal.
pub fn max(a: DateTime, b: DateTime) -> DateTime {
    if compare(b, a) > 0 { b } else { a }
}

/// Returns `dt` as `YYYY-MM-DDThh:mm:ss`, with a fraction after the seconds when the nanosecond is not zero.
pub fn to_string(dt: DateTime) -> str {
    "{date.to_string(dt.day)}T{timeofday.to_string_seconds(dt.clock)}"
}

fn is_separator(c: u8) -> bool {
    c == 'T' || c == 't' || c == ' '
}

fn shift(e: fault.Fault, by: i64) -> fault.Fault {
    match e {
        Syntax(at) => fault.Fault.Syntax(at + by)
        _ => e
    }
}

fn separator_at(s: str) -> i64 {
    for i in 0..s.len {
        if is_separator(s[i]) {
            return i
        }
    }
    -1
}

/// Parses a date and a time of day separated by `T`, `t` or a space, such as `2024-03-01T12:30:00`.
///
/// The date accepts the forms of `date.parse` and the time the forms of `timeofday.parse`. Fails with `Syntax` at the offset of the first bad byte, including when there is no separator, and otherwise as those do.
pub fn parse(s: str) -> DateTime ! fault.Fault {
    let at = separator_at(s)
    if at < 0 {
        fail Syntax(s.len)
    }
    let rest = s[at + 1..]
    if rest.len > 0 && (rest[0] == 'T' || rest[0] == 't') {
        fail Syntax(at + 1)
    }
    let day = date.parse(s[..at])?
    let clock = timeofday.parse(rest) catch {
        e => fail shift(e, at + 1)
    }
    DateTime { day, clock }
}

/// Returns the date and time of `dt` as pattern `Fields`.
pub fn to_fields(dt: DateTime) -> pattern.Fields {
    let d = date.to_fields(dt.day)
    let t = timeofday.to_fields(dt.clock)
    pattern.Fields {
        year: d.year,
        month: d.month,
        day: d.day,
        day_of_year: d.day_of_year,
        weekday: d.weekday,
        iso_year: d.iso_year,
        iso_week: d.iso_week,
        hour: t.hour,
        minute: t.minute,
        second: t.second,
        nanosecond: t.nanosecond
    }
}

/// Returns the date-time in `f`.
///
/// Fails as `date.from_fields` and `timeofday.from_fields` do.
pub fn from_fields(f: pattern.Fields) -> DateTime ! fault.Fault {
    let day = date.from_fields(f)?
    let clock = timeofday.from_fields(f)?
    DateTime { day, clock }
}

/// Returns `dt` printed through the compiled pattern `p` with the month, weekday and period words of `names`.
///
/// Fails with `Invalid` when `p` needs a value a date-time does not have, such as an offset or a zone name.
pub fn format_names(dt: DateTime, p: pattern.Pattern, names: pattern.Names) -> str ! fault.Fault {
    pattern.render(p, to_fields(dt), names)?
}

/// Returns `dt` printed through the compiled pattern `p` with English names.
///
/// Fails as `format_names` does.
pub fn format_with(dt: DateTime, p: pattern.Pattern) -> str ! fault.Fault {
    format_names(dt, p, pattern.english())?
}

/// Returns `dt` printed through the layout `layout`, such as `%Y-%m-%d %H:%M`.
///
/// Fails with `Syntax` or `Unsupported` for a bad layout, as `pattern.compile` does, and otherwise as `format_names` does.
pub fn format(dt: DateTime, layout: str) -> str ! fault.Fault {
    let p = pattern.compile(layout)?
    format_with(dt, p)?
}

/// Parses `s` with the compiled pattern `p` and the words of `names`.
///
/// Fails with `Invalid` when `p` uses an offset, zone or Unix-time verb, with `Syntax` or `OutOfRange` when `s` does not match, and with `Invalid` when the fields do not give a date and a time or conflict.
pub fn parse_names(s: str, p: pattern.Pattern, names: pattern.Names) -> DateTime ! fault.Fault {
    pattern.restrict(p, true, true)?
    let f = pattern.scan(p, s, names)?
    from_fields(f)?
}

/// Parses `s` with the compiled pattern `p` and English names.
///
/// Fails as `parse_names` does.
pub fn parse_pattern(s: str, p: pattern.Pattern) -> DateTime ! fault.Fault {
    parse_names(s, p, pattern.english())?
}

/// Parses `s` with the layout `layout` and English names.
///
/// Fails as `parse_names` does and with `Syntax` or `Unsupported` for a bad layout.
pub fn parse_with(s: str, layout: str) -> DateTime ! fault.Fault {
    let p = pattern.compile(layout)?
    parse_pattern(s, p)?
}
