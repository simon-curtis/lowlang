import std/io
import std/text

struct Fields {
    year: i64 = 1970
    month: i64 = 1
    day: i64 = 1
    day_at: i64 = 0
    ordinal: i64 = 0
    ordinal_at: i64 = 0
    hour: i64 = 0
    clock12: i64 = 0
    twelve: bool = false
    pm: bool = false
    minute: i64 = 0
    second: i64 = 0
    nanosecond: i64 = 0
    offset: i64 = 0
    zoned: bool = false
}

fn month_names() -> []str {
    ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"]
}

fn weekday_names() -> []str {
    ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"]
}

fn format_year(year: i64) -> str {
    if year < 0 { "-{pad(-year, 4)}" } else { pad(year, 4) }
}

fn hour12(hour: i64) -> i64 {
    let n = hour % 12
    if n == 0 { 12 } else { n }
}

fn format_numeric_offset(offset: i64) -> str {
    let sign = if offset < 0 { "-" } else { "+" }
    let size = if offset < 0 { -offset } else { offset }
    "{sign}{pad(size / 3600, 2)}{pad(size / 60 % 60, 2)}"
}

fn offset_label(offset: i64) -> str {
    if offset == 0 { "UTC" } else { format_offset(offset) }
}

fn render_verb(mut out: []u8, verb: u8, dt: DateTime, offset: i64, zone: str) {
    let d = dt.date
    match verb {
        == 'Y' => text.append(mut out, format_year(d.year))
        == 'y' => text.append(mut out, pad(floor_mod(d.year, 100), 2))
        == 'm' => text.append(mut out, pad(d.month, 2))
        == 'd' => text.append(mut out, pad(d.day, 2))
        == 'e' => text.append(mut out, text.pad_left("{d.day}", 2, ' '))
        == 'j' => text.append(mut out, pad(days(d) - days_from_civil(d.year, 1, 1) + 1, 3))
        == 'H' => text.append(mut out, pad(dt.hour, 2))
        == 'I' => text.append(mut out, pad(hour12(dt.hour), 2))
        == 'M' => text.append(mut out, pad(dt.minute, 2))
        == 'S' => text.append(mut out, pad(dt.second, 2))
        == 'f' => text.append(mut out, pad(dt.nanosecond / 1000, 6))
        == 'N' => text.append(mut out, pad(dt.nanosecond, 9))
        == 'p' => text.append(mut out, if dt.hour < 12 { "AM" } else { "PM" })
        == 'a' => text.append(mut out, weekday_names()[floor_mod(days(d) + 3, 7)][..3])
        == 'A' => text.append(mut out, weekday_names()[floor_mod(days(d) + 3, 7)])
        == 'b' => text.append(mut out, month_names()[d.month - 1][..3])
        == 'B' => text.append(mut out, month_names()[d.month - 1])
        == 'z' => text.append(mut out, format_numeric_offset(offset))
        == 'Z' => text.append(mut out, zone)
        == '%' => push(mut out, '%')
        _ => {
            push(mut out, '%')
            push(mut out, verb)
        }
    }
}

fn render(dt: DateTime, offset: i64, zone: str, layout: str) -> str {
    var out: []u8 = []
    var i = 0
    for i < layout.len {
        let c = layout[i]
        if c == '%' && i + 1 < layout.len {
            render_verb(mut out, layout[i + 1], dt, offset, zone)
            i += 2
        } else {
            push(mut out, c)
            i += 1
        }
    }
    __str_view(out)
}

pub fn format(dt: DateTime, layout: str) -> str {
    render(dt, 0, "UTC", layout)
}

pub fn format_at(i: Instant, layout: str) -> str {
    render(i.local, i.offset, offset_label(i.offset), layout)
}

pub fn format_zoned(z: Zoned, layout: str) -> str {
    render(z.instant.local, z.instant.offset, z.abbreviation, layout)
}

pub fn format_rfc2822(i: Instant) -> str {
    format_at(i, "%a, %d %b %Y %H:%M:%S %z")
}

pub fn parse_rfc3339(s: str) -> Instant ! io.Error {
    match parse_datetime(s)? {
        Aware(i) => i
        Naive(dt) => fail Invalid
    }
}

fn take_number(mut p: Input, least: i64, most: i64) -> i64 ! Error {
    var n = 0
    var count = 0
    for count < most && at_digit(p) {
        n = n * 10 + take_digit(mut p)
        count += 1
    }
    if count < least {
        fail Invalid(p.at)
    }
    n
}

fn take_ranged(mut p: Input, least: i64, most: i64, low: i64, high: i64) -> i64 ! Error {
    let start = p.at
    let n = take_number(mut p, least, most)?
    if n < low || n > high {
        fail OutOfRange(start)
    }
    n
}

fn name_matches(s: str, at: i64, name: str) -> bool {
    if at + name.len > s.len {
        return false
    }
    for i in 0..name.len {
        if text.lower_byte(s[at + i]) != text.lower_byte(name[i]) {
            return false
        }
    }
    true
}

fn take_name(mut p: Input, names: []str) -> i64 ! Error {
    for i, name in names {
        if name_matches(p.s, p.at, name) {
            p.at += name.len
            return i
        }
    }
    for i, name in names {
        if name_matches(p.s, p.at, name[..3]) {
            p.at += 3
            return i
        }
    }
    fail Invalid(p.at)
}

fn take_fraction_digits(mut p: Input) -> i64 ! Error {
    let start = p.at
    let n = take_number(mut p, 1, 9)?
    n * pow10(9 - (p.at - start))
}

fn take_offset(mut p: Input) -> i64 ! Error {
    if p.at < p.s.len && (p.s[p.at] == 'Z' || p.s[p.at] == 'z') {
        p.at += 1
        return 0
    }
    if p.at >= p.s.len || (p.s[p.at] != '+' && p.s[p.at] != '-') {
        fail Invalid(p.at)
    }
    let negative = p.s[p.at] == '-'
    p.at += 1
    let hours = take_ranged(mut p, 2, 2, 0, 23)?
    if p.at < p.s.len && p.s[p.at] == ':' {
        p.at += 1
    }
    var minutes = 0
    if at_digit(p) {
        minutes = take_ranged(mut p, 2, 2, 0, 59)?
    }
    let seconds = hours * 3600 + minutes * 60
    if negative { -seconds } else { seconds }
}

fn take_zone_name(mut p: Input) ! Error {
    let start = p.at
    for p.at < p.s.len && (p.s[p.at] >= 'A' && p.s[p.at] <= 'Z' || p.s[p.at] >= 'a' && p.s[p.at] <= 'z') {
        p.at += 1
    }
    if p.at == start {
        fail Invalid(start)
    }
}

fn take_period(mut p: Input) -> bool ! Error {
    if name_matches(p.s, p.at, "AM") {
        p.at += 2
        return false
    }
    if name_matches(p.s, p.at, "PM") {
        p.at += 2
        return true
    }
    fail Invalid(p.at)
}

fn take_day(mut p: Input, mut f: Fields) ! Error {
    f.day_at = p.at
    f.day = take_ranged(mut p, 1, 2, 1, 31)?
}

fn parse_verb(mut p: Input, mut f: Fields, verb: u8) ! Error {
    match verb {
        == 'Y' => { f.year = take_number(mut p, 4, 4)? }
        == 'y' => {
            let yy = take_number(mut p, 2, 2)?
            f.year = if yy < 69 { 2000 + yy } else { 1900 + yy }
        }
        == 'm' => { f.month = take_ranged(mut p, 1, 2, 1, 12)? }
        == 'd' => { take_day(mut p, mut f)? }
        == 'e' => {
            if p.at < p.s.len && p.s[p.at] == ' ' {
                p.at += 1
            }
            take_day(mut p, mut f)?
        }
        == 'j' => {
            f.ordinal_at = p.at
            f.ordinal = take_ranged(mut p, 1, 3, 1, 366)?
        }
        == 'H' => { f.hour = take_ranged(mut p, 1, 2, 0, 23)? }
        == 'I' => {
            f.clock12 = take_ranged(mut p, 1, 2, 1, 12)?
            f.twelve = true
        }
        == 'M' => { f.minute = take_ranged(mut p, 1, 2, 0, 59)? }
        == 'S' => { f.second = take_ranged(mut p, 1, 2, 0, 59)? }
        == 'f' => { f.nanosecond = take_fraction_digits(mut p)? }
        == 'N' => { f.nanosecond = take_fraction_digits(mut p)? }
        == 'p' => { f.pm = take_period(mut p)? }
        == 'a' => { let name = take_name(mut p, weekday_names())? }
        == 'A' => { let name = take_name(mut p, weekday_names())? }
        == 'b' => { f.month = take_name(mut p, month_names())? + 1 }
        == 'B' => { f.month = take_name(mut p, month_names())? + 1 }
        == 'z' => {
            f.offset = take_offset(mut p)?
            f.zoned = true
        }
        == 'Z' => { take_zone_name(mut p)? }
        == '%' => { take_literal(mut p, '%')? }
        _ => { fail Invalid(p.at) }
    }
}

fn take_literal(mut p: Input, c: u8) ! Error {
    if p.at >= p.s.len || p.s[p.at] != c {
        fail Invalid(p.at)
    }
    p.at += 1
}

fn resolve(f: Fields) -> Date ! Error {
    if f.ordinal > 0 {
        if f.ordinal > 365 + if leap_year(f.year) { 1 } else { 0 } {
            fail OutOfRange(f.ordinal_at)
        }
        return civil_from_days(days_from_civil(f.year, 1, 1) + f.ordinal - 1)
    }
    if f.day > days_in_month(f.year, f.month) {
        fail OutOfRange(f.day_at)
    }
    Date { year: f.year, month: f.month, day: f.day }
}

fn resolve_hour(f: Fields) -> i64 {
    if !f.twelve {
        return f.hour
    }
    f.clock12 % 12 + if f.pm { 12 } else { 0 }
}

pub fn parse(s: str, layout: str) -> Parsed ! Error {
    var p = Input { s, at: 0 }
    var f = Fields {}
    var i = 0
    for i < layout.len {
        let c = layout[i]
        if c == '%' && i + 1 < layout.len {
            parse_verb(mut p, mut f, layout[i + 1])?
            i += 2
        } else {
            take_literal(mut p, c)?
            i += 1
        }
    }
    if p.at != s.len {
        fail Invalid(p.at)
    }
    let day = resolve(f)?
    let local = DateTime { date: day, hour: resolve_hour(f), minute: f.minute, second: f.second, nanosecond: f.nanosecond }
    if f.zoned {
        return Aware(Instant { local, offset: f.offset })
    }
    Naive(local)
}
