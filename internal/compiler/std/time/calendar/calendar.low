import std/math

/// A year, month and day of the proleptic Gregorian calendar.
pub struct Civil {
    /// The year, which can be zero or negative.
    pub year: i64
    /// The month, from `1` for January to `12` for December.
    pub month: i64
    /// The day of the month, from `1`.
    pub day: i64
}

/// Returns whether `year` is a leap year in the proleptic Gregorian calendar.
pub fn leap_year(year: i64) -> bool {
    year % 4 == 0 && (year % 100 != 0 || year % 400 == 0)
}

/// Returns the number of days in month `month`, from `1` for January, of `year`.
pub fn days_in_month(year: i64, month: i64) -> i64 {
    if month == 2 {
        return if leap_year(year) { 29 } else { 28 }
    }
    if month == 4 || month == 6 || month == 9 || month == 11 { 30 } else { 31 }
}

/// Returns the number of days from 1970-01-01 to the given date, negative before it.
///
/// The month and day are not range checked.
pub fn days_from_civil(year: i64, month: i64, day: i64) -> i64 {
    let y = if month <= 2 { year - 1 } else { year }
    let era = math.floor_div(y, 400)
    let yoe = y - era * 400
    let doy = (153 * ((month + 9) % 12) + 2) / 5 + day - 1
    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
    era * 146097 + doe - 719468
}

/// Returns the date that is `days` days after 1970-01-01, or before it when `days` is negative.
pub fn civil_from_days(days: i64) -> Civil {
    let z = days + 719468
    let era = math.floor_div(z, 146097)
    let doe = z - era * 146097
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
    let mp = (5 * doy + 2) / 153
    let day = doy - (153 * mp + 2) / 5 + 1
    let month = if mp < 10 { mp + 3 } else { mp - 9 }
    Civil { year: yoe + era * 400 + if month <= 2 { 1 } else { 0 }, month, day }
}

/// Returns the English month names, from January.
pub fn month_names() -> []str {
    ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"]
}

/// Returns the three-letter English month names, from January.
pub fn short_month_names() -> []str {
    ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
}

/// Returns the English weekday names, from Monday.
pub fn weekday_names() -> []str {
    ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"]
}

/// Returns the three-letter English weekday names, from Monday.
pub fn short_weekday_names() -> []str {
    ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
}

/// Returns the position of the weekday of day number `days` counted from 1970-01-01, from `0` for Monday to `6` for Sunday.
pub fn weekday_index(days: i64) -> i64 {
    math.floor_mod(days + 3, 7)
}
