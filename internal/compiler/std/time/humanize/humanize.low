import std/text
import std/time/duration
import std/time/fault
import std/time/rounding
import std/time/timestamp

/// The wording that `ago`, `in_words` and `compact` use, so that a program can print another language.
///
/// A template marks where its text goes with `%s`, and `quantity` also uses `%d` for the count. The unit lists have six entries in order: second, minute, hour, day, month and year. A month counts as 30 days and a year as 365 days. The `_with` functions fail with `Invalid` when a unit list does not have six entries.
pub struct Words {
    /// The text for an elapsed time under five seconds.
    pub just_now: str
    /// The text for `in_words` of a nonzero duration under one second.
    pub under_second: str
    /// The template for a time in the past, with the quantity at `%s`.
    pub past: str
    /// The template for a time in the future, with the quantity at `%s`.
    pub future: str
    /// The template that marks a quantity as approximate, with the quantity at `%s`.
    pub about: str
    /// The template that joins a count and a unit name, with the count at `%d` and the name at `%s`.
    pub quantity: str
    /// The unit names used for a count of exactly one, from second to year.
    pub singular: []str
    /// The unit names used for any other count, from second to year.
    pub plural: []str
    /// The abbreviated unit names that `compact` uses, from second to year.
    pub short: []str
}

/// Returns the English `Words`: `just now`, `less than a second`, `%s ago`, `in %s`, `about %s`, `%d %s`, and the names `second` to `year`, with `s`, `m`, `h`, `d`, `mo` and `y` as the short forms.
pub fn english() -> Words {
    Words {
        just_now: "just now",
        under_second: "less than a second",
        past: "%s ago",
        future: "in %s",
        about: "about %s",
        quantity: "%d %s",
        singular: ["second", "minute", "hour", "day", "month", "year"],
        plural: ["seconds", "minutes", "hours", "days", "months", "years"],
        short: ["s", "m", "h", "d", "mo", "y"]
    }
}

fn unit_count() -> i64 {
    6
}

fn unit_seconds(unit: i64) -> i64 {
    let lengths: []i64 = [1, 60, 3600, 86400, 2592000, 31536000]
    lengths[unit]
}

fn leading_unit(secs: i64) -> i64 {
    var unit = unit_count() - 1
    for unit > 0 && unit_seconds(unit) > secs {
        unit -= 1
    }
    unit
}

fn check(w: Words) ! fault.Fault {
    if w.singular.len != unit_count() || w.plural.len != unit_count() || w.short.len != unit_count() {
        fail Invalid("words")
    }
}

fn quantity(w: Words, count: i64, unit: i64) -> str {
    let name = if count == 1 { w.singular[unit] } else { w.plural[unit] }
    let counted = text.replace(w.quantity, "%d", "{count}")
    text.replace(counted, "%s", name)
}

fn fill(template: str, value: str) -> str {
    text.replace(template, "%s", value)
}

struct Scaled {
    unit: i64
    count: i64
    exact: bool
}

fn scaled(secs: i64, nanos: i64, unit: i64) -> Scaled {
    let length = unit_seconds(unit)
    let rest = secs % length
    let twice = 2 * rest
    let up = twice >= length || (twice == length - 1 && nanos >= 500000000)
    let count = secs / length + if up { 1 } else { 0 }
    Scaled { unit, count, exact: rest == 0 && nanos == 0 }
}

fn nearest(secs: i64, nanos: i64) -> Scaled {
    var unit = leading_unit(secs)
    var s = scaled(secs, nanos, unit)
    for unit + 1 < unit_count() && s.count * unit_seconds(unit) >= unit_seconds(unit + 1) {
        unit += 1
        s = scaled(secs, nanos, unit)
    }
    s
}

fn ago_text(d: duration.Duration, w: Words) -> str {
    let secs = duration.whole_seconds(duration.abs(d))
    if secs < 5 {
        return w.just_now
    }
    let unit = leading_unit(secs)
    let amount = quantity(w, secs / unit_seconds(unit), unit)
    fill(if duration.is_negative(d) { w.future } else { w.past }, amount)
}

fn in_words_text(d: duration.Duration, w: Words) -> str {
    let magnitude = duration.abs(d)
    let secs = duration.whole_seconds(magnitude)
    let nanos = duration.subsec_nanos(magnitude)
    if secs == 0 && nanos != 0 {
        return w.under_second
    }
    if secs == 0 {
        return quantity(w, 0, 0)
    }
    let s = nearest(secs, nanos)
    let amount = quantity(w, s.count, s.unit)
    if s.exact { amount } else { fill(w.about, amount) }
}

fn compact_text(d: duration.Duration, w: Words) -> str {
    let secs = duration.whole_seconds(duration.abs(d))
    if secs == 0 {
        return "0{w.short[0]}"
    }
    let unit = leading_unit(secs)
    let sign = if duration.is_negative(d) { "-" } else { "" }
    "{sign}{secs / unit_seconds(unit)}{w.short[unit]}"
}

/// Returns how long ago `d` was in English, such as `3 hours ago`.
///
/// `d` is the time elapsed since the event. It is counted in its largest whole unit, rounded down, so `90 minutes` reads `1 hour ago`. Under five seconds the result is `just now`. A negative `d` reads as a future time, such as `in 2 days`.
pub fn ago(d: duration.Duration) -> str {
    ago_text(d, english())
}

/// Returns how long ago `d` was, worded by `w`.
///
/// Fails with `Invalid` when `w` does not have six names in each unit list. Otherwise it is `ago` with different words.
pub fn ago_with(d: duration.Duration, w: Words) -> str ! fault.Fault {
    check(w)?
    ago_text(d, w)
}

/// Returns when `ts` is compared with `now` in English, such as `2 days ago` or `in 3 hours`.
///
/// It is `ago` of the time from `ts` to `now`, so a `ts` before `now` reads as the past.
pub fn relative(ts: timestamp.Timestamp, now: timestamp.Timestamp) -> str {
    ago_text(timestamp.since(now, ts), english())
}

/// Returns when `ts` is compared with `now`, worded by `w`.
///
/// Fails as `ago_with` does.
pub fn relative_with(ts: timestamp.Timestamp, now: timestamp.Timestamp, w: Words) -> str ! fault.Fault {
    check(w)?
    ago_text(timestamp.since(now, ts), w)
}

/// Returns an approximate English description of the length of `d`, such as `about 2 hours` or `3 days`.
///
/// The sign is ignored. The duration is rounded to the nearest whole unit of the largest unit that fits, and the result is prefixed `about` unless it is exact. A nonzero duration under one second is `less than a second` and zero is `0 seconds`.
pub fn in_words(d: duration.Duration) -> str {
    in_words_text(d, english())
}

/// Returns an approximate description of the length of `d`, worded by `w`.
///
/// Fails as `ago_with` does.
pub fn in_words_with(d: duration.Duration, w: Words) -> str ! fault.Fault {
    check(w)?
    in_words_text(d, w)
}

/// Returns `d` as a single count in its largest whole unit, such as `5m` or `-3d`.
///
/// The count is rounded down, a negative duration has a leading `-`, and a duration under one second is `0s`.
pub fn compact(d: duration.Duration) -> str {
    compact_text(d, english())
}

/// Returns `d` as a single count in its largest whole unit, using the short names of `w`.
///
/// Fails as `ago_with` does.
pub fn compact_with(d: duration.Duration, w: Words) -> str ! fault.Fault {
    check(w)?
    compact_text(d, w)
}

fn steps() -> []duration.Duration {
    [
        duration.seconds(31536000),
        duration.seconds(2592000),
        duration.seconds(86400),
        duration.seconds(3600),
        duration.seconds(60),
        duration.seconds(1),
        duration.milliseconds(1),
        duration.microseconds(1),
        duration.nanoseconds(1)
    ]
}

/// Returns `d` rounded to its `units` most significant units.
///
/// The units are years, 30-day months, days, hours, minutes, seconds, milliseconds, microseconds and nanoseconds, so `1h 30m 20s` rounded to two units is `1h 30m` and to one unit is `2h`. A half rounds away from zero. Fails with `Invalid` when `units` is below `1` and with `OutOfRange` or `Overflow` where `duration.round` does. More units than the ladder has keep full precision.
pub fn round_to(d: duration.Duration, units: i64) -> duration.Duration ! fault.Fault {
    if units < 1 {
        fail Invalid("units")
    }
    let ladder = steps()
    let magnitude = duration.abs(d)
    var lead = 0
    for lead + 1 < ladder.len && duration.compare(ladder[lead], magnitude) > 0 {
        lead += 1
    }
    let cut = if units >= ladder.len - lead { ladder.len - 1 } else { lead + units - 1 }
    duration.round(d, ladder[cut], rounding.Rounding.HalfExpand)?
}
