import std/time/duration
import std/time/fault
import std/time/rounding

struct Setting {
    name: str
    value: str
}

fn read_setting(setting: Setting) -> duration.Duration {
    let d = duration.parse(setting.value) catch {
        Syntax(at) => {
            print("{setting.name}: bad character at byte {at} of {setting.value}")
            return duration.zero()
        }
        _ => return duration.zero()
    }
    d
}

/// Reads timeouts written in ISO 8601 and friendly form, combines them and prints them for people and for machines.
fn main() ! fault.Fault {
    let settings = [
        Setting { name: "connect", value: "PT2.5S" },
        Setting { name: "read", value: "1m 30s" },
        Setting { name: "idle", value: "PT1H" },
        Setting { name: "grace", value: "250ms" },
        Setting { name: "typo", value: "10 parsecs" }
    ]

    var total = duration.zero()
    for setting in settings {
        let d = read_setting(setting)
        total = duration.plus(total, d)
        print("{setting.name}: {duration.friendly(d)} = {duration.to_string(d)}")
    }
    print("total: {duration.friendly(total)}")

    let read = duration.parse("1m 30s")?
    let attempts = 3
    let budget = duration.times(read, attempts)
    print("budget for {attempts} attempts: {duration.to_string(budget)}")
    print("per attempt again: {duration.friendly(duration.divide(budget, attempts))}")
    print("ratio of budget to idle: {duration.ratio(budget, duration.hours(1))}")

    let elapsed = duration.parse("PT1H2M3.456789S")?
    let minute = duration.minutes(1)
    for mode in [rounding.Rounding.Trunc, rounding.Rounding.Ceil, rounding.Rounding.HalfExpand] {
        let rounded = duration.round(elapsed, minute, mode)?
        print("{mode} to the minute: {duration.friendly(rounded)}")
    }
    print("truncated to the second: {duration.friendly(duration.truncate(elapsed, duration.seconds(1))?)}")

    let skew = duration.minus(duration.seconds(2), duration.seconds(5))
    print("skew {duration.friendly(skew)} magnitude {duration.friendly(duration.abs(skew))}")
    let huge = duration.try_times(duration.hours(1), 9223372036854775807)
    print("overflow detected: {huge == none}")
    print("longest: {duration.friendly(duration.max(read, duration.seconds(45)))}")
}
