import std/text
import std/time/fault
import std/time/rounding

/// An exact signed length of time with nanosecond precision.
///
/// It is held as whole seconds and a nanosecond part that always share a sign, with at most `999999999` nanoseconds. The seconds can be any `i64` except the minimum. The plain arithmetic functions panic with `duration: overflow` when the result does not fit, and the `try_` forms return `none` instead.
pub struct Duration {
    secs: i64
    nanos: i64
}

fn max_i64() -> i64 {
    9223372036854775807
}

fn min_i64() -> i64 {
    -9223372036854775807 - 1
}

fn billion() -> i64 {
    1000000000
}

fn add_checked(a: i64, b: i64) -> i64? {
    if b > 0 && a > max_i64() - b {
        return none
    }
    if b < 0 && a < min_i64() - b {
        return none
    }
    a + b
}

fn mul_checked(a: i64, b: i64) -> i64? {
    if a == 0 || b == 0 {
        return 0
    }
    if a > 0 && b > 0 && a > max_i64() / b {
        return none
    }
    if a > 0 && b < 0 && b < min_i64() / a {
        return none
    }
    if a < 0 && b > 0 && a < min_i64() / b {
        return none
    }
    if a < 0 && b < 0 && a < max_i64() / b {
        return none
    }
    a * b
}

fn normalise(secs: i64, nanos: i64) -> Duration? {
    var s = add_checked(secs, nanos / billion()) ?? return none
    var n = nanos % billion()
    if s > 0 && n < 0 {
        s -= 1
        n += billion()
    }
    if s < 0 && n > 0 {
        s += 1
        n -= billion()
    }
    if s == min_i64() {
        return none
    }
    Duration { secs: s, nanos: n }
}

fn or_overflow(d: Duration?) -> Duration {
    d ?? __panic("duration: overflow")
}

fn count_or_overflow(n: i64?) -> i64 {
    n ?? __panic("duration: overflow")
}

/// Returns the duration of zero length.
pub fn zero() -> Duration {
    Duration { secs: 0, nanos: 0 }
}

/// Returns a duration of `n` nanoseconds.
///
/// `n` can be any `i64`; this never overflows.
pub fn nanoseconds(n: i64) -> Duration {
    Duration { secs: n / billion(), nanos: n % billion() }
}

/// Returns a duration of `n` microseconds.
///
/// `n` can be any `i64`; this never overflows.
pub fn microseconds(n: i64) -> Duration {
    Duration { secs: n / 1000000, nanos: n % 1000000 * 1000 }
}

/// Returns a duration of `n` milliseconds.
///
/// `n` can be any `i64`; this never overflows.
pub fn milliseconds(n: i64) -> Duration {
    Duration { secs: n / 1000, nanos: n % 1000 * 1000000 }
}

/// Returns a duration of `n` seconds.
///
/// Panics with `duration: overflow` when `n` is the minimum `i64`.
pub fn seconds(n: i64) -> Duration {
    or_overflow(normalise(n, 0))
}

fn scaled_seconds(n: i64, per: i64) -> Duration {
    let secs = count_or_overflow(mul_checked(n, per))
    or_overflow(normalise(secs, 0))
}

/// Returns a duration of `n` minutes.
///
/// Panics with `duration: overflow` when the count of seconds does not fit in an `i64`.
pub fn minutes(n: i64) -> Duration {
    scaled_seconds(n, 60)
}

/// Returns a duration of `n` hours.
///
/// Panics with `duration: overflow` when the count of seconds does not fit in an `i64`.
pub fn hours(n: i64) -> Duration {
    scaled_seconds(n, 3600)
}

/// Returns the duration of `secs` seconds plus `nanos` nanoseconds, or `none` on overflow.
///
/// `nanos` can be any value and can differ in sign from `secs`; whole seconds in it carry into `secs`.
pub fn try_from_parts(secs: i64, nanos: i64) -> Duration? {
    normalise(secs, nanos)
}

/// Returns the duration of `secs` seconds plus `nanos` nanoseconds.
///
/// Panics with `duration: overflow` where `try_from_parts` returns `none`.
pub fn from_parts(secs: i64, nanos: i64) -> Duration {
    or_overflow(normalise(secs, nanos))
}

/// Returns the duration nearest to `f` seconds.
///
/// The fraction is rounded to the nearest nanosecond, with a half rounded away from zero. Fails with `Invalid` for NaN or an infinity and with `Overflow` when `f` is about `9.2e18` seconds or more in magnitude.
pub fn from_seconds_f64(f: f64) -> Duration ! fault.Fault {
    if f != f {
        fail Invalid("duration of NaN seconds")
    }
    if f - f != 0.0 {
        fail Invalid("duration of infinite seconds")
    }
    if f >= 9223372036854775000.0 || f <= -9223372036854775000.0 {
        fail Overflow
    }
    let negative = f < 0.0
    let magnitude = if negative { -f } else { f }
    let whole = floor(magnitude)
    let nanos = i64(floor((magnitude - whole) * 1000000000.0 + 0.5))
    let d = normalise(i64(whole), nanos) ?? fail Overflow
    if negative { negate(d) } else { d }
}

/// Returns the whole seconds in `d`, truncated toward zero.
pub fn whole_seconds(d: Duration) -> i64 {
    d.secs
}

/// Returns the nanoseconds left after the whole seconds of `d`.
///
/// The result has the sign of `d` and is under one second in magnitude.
pub fn subsec_nanos(d: Duration) -> i64 {
    d.nanos
}

fn whole_in(d: Duration, per_second: i64, nanos_per: i64) -> i64 {
    let secs = count_or_overflow(mul_checked(d.secs, per_second))
    count_or_overflow(add_checked(secs, d.nanos / nanos_per))
}

/// Returns the whole milliseconds in `d`, truncated toward zero.
///
/// Panics with `duration: overflow` when the count does not fit in an `i64`.
pub fn whole_millis(d: Duration) -> i64 {
    whole_in(d, 1000, 1000000)
}

/// Returns the whole microseconds in `d`, truncated toward zero.
///
/// Panics with `duration: overflow` when the count does not fit in an `i64`.
pub fn whole_micros(d: Duration) -> i64 {
    whole_in(d, 1000000, 1000)
}

/// Returns the whole minutes in `d`, truncated toward zero.
pub fn whole_minutes(d: Duration) -> i64 {
    d.secs / 60
}

/// Returns the whole hours in `d`, truncated toward zero.
pub fn whole_hours(d: Duration) -> i64 {
    d.secs / 3600
}

/// Returns `d` as a count of nanoseconds, or `none` when it does not fit in an `i64`.
///
/// An `i64` holds about 292 years of nanoseconds.
pub fn as_nanos(d: Duration) -> i64? {
    let secs = mul_checked(d.secs, billion()) ?? return none
    add_checked(secs, d.nanos)
}

/// Returns `d` as a count of nanoseconds, clamped to the range of an `i64`.
///
/// A duration beyond about 292 years in either direction returns the largest count, or its negation. The minimum `i64` is never returned, so the result can be negated.
pub fn saturating_nanos(d: Duration) -> i64 {
    as_nanos(d) ?? if is_negative(d) { -max_i64() } else { max_i64() }
}

/// Returns `d` as a count of milliseconds, rounded up.
///
/// A zero or negative duration returns `0`, and a duration beyond the range of `i64` nanoseconds returns the count for that maximum.
pub fn ceil_millis(d: Duration) -> i64 {
    let nanos = saturating_nanos(d)
    if nanos <= 0 {
        return 0
    }
    let whole = nanos / 1000000
    if nanos % 1000000 != 0 { whole + 1 } else { whole }
}

/// Returns the seconds of `d` rounded toward negative infinity.
///
/// Together with `floor_nanos`, it splits `d` into whole seconds and a nanosecond part that is never negative.
pub fn floor_seconds(d: Duration) -> i64 {
    if d.nanos < 0 { d.secs - 1 } else { d.secs }
}

/// Returns the nanoseconds that remain after `floor_seconds`, from `0` to `999999999`.
pub fn floor_nanos(d: Duration) -> i64 {
    if d.nanos < 0 { d.nanos + billion() } else { d.nanos }
}

/// Returns `d` as fractional seconds.
///
/// The result is the nearest `f64`, so a long duration can lose nanosecond precision.
pub fn as_seconds_f64(d: Duration) -> f64 {
    f64(d.secs) + f64(d.nanos) / 1000000000.0
}

/// Returns whether `d` has no length.
pub fn is_zero(d: Duration) -> bool {
    d.secs == 0 && d.nanos == 0
}

/// Returns whether `d` is below zero.
pub fn is_negative(d: Duration) -> bool {
    d.secs < 0 || d.nanos < 0
}

/// Returns `d` with its sign reversed.
///
/// This never overflows.
pub fn negate(d: Duration) -> Duration {
    Duration { secs: -d.secs, nanos: -d.nanos }
}

/// Returns the length of `d` without its sign.
pub fn abs(d: Duration) -> Duration {
    if is_negative(d) { negate(d) } else { d }
}

/// Returns the sum of `a` and `b`, or `none` on overflow.
pub fn try_plus(a: Duration, b: Duration) -> Duration? {
    let secs = add_checked(a.secs, b.secs) ?? return none
    normalise(secs, a.nanos + b.nanos)
}

/// Returns `a` less `b`, or `none` on overflow.
pub fn try_minus(a: Duration, b: Duration) -> Duration? {
    try_plus(a, negate(b))
}

/// Returns `d` multiplied by `n`, or `none` on overflow.
pub fn try_times(d: Duration, n: i64) -> Duration? {
    let whole = mul_checked(d.secs, n) ?? return none
    let high = d.nanos * (n / billion())
    let low = d.nanos * (n % billion())
    let extra = add_checked(high, low / billion()) ?? return none
    let secs = add_checked(whole, extra) ?? return none
    normalise(secs, low % billion())
}

/// Returns the sum of `a` and `b`.
///
/// Panics with `duration: overflow` on overflow.
pub fn plus(a: Duration, b: Duration) -> Duration {
    or_overflow(try_plus(a, b))
}

/// Returns `a` less `b`.
///
/// Panics with `duration: overflow` on overflow.
pub fn minus(a: Duration, b: Duration) -> Duration {
    or_overflow(try_minus(a, b))
}

/// Returns `d` multiplied by `n`.
///
/// Panics with `duration: overflow` on overflow.
pub fn times(d: Duration, n: i64) -> Duration {
    or_overflow(try_times(d, n))
}

struct Step {
    q: i64
    rem: i64
}

fn step(rem: i64, digit: i64, m: i64) -> Step {
    var q = digit / m
    var acc = digit % m
    for _ in 0..10 {
        if acc >= m - rem {
            acc -= m - rem
            q += 1
        } else {
            acc += rem
        }
    }
    Step { q, rem: acc }
}

fn divide_magnitude(a: Duration, m: i64) -> Duration {
    var rem = a.secs % m
    var nanos = 0
    var scale = 100000000
    for scale > 0 {
        let digit = a.nanos / scale % 10
        let s = step(rem, digit, m)
        nanos = nanos * 10 + s.q
        rem = s.rem
        scale /= 10
    }
    Duration { secs: a.secs / m, nanos }
}

/// Returns `d` divided by `n`, truncated toward zero to a whole nanosecond.
///
/// Panics with `duration: divide by zero` when `n` is `0`. The result is negative when exactly one of `d` and `n` is.
pub fn divide(d: Duration, n: i64) -> Duration {
    if n == 0 {
        __panic("duration: divide by zero")
    }
    if n == min_i64() {
        return negate(divide(divide(d, 2), 4611686018427387904))
    }
    let m = if n < 0 { -n } else { n }
    let q = divide_magnitude(abs(d), m)
    if is_negative(d) != (n < 0) { negate(q) } else { q }
}

/// Returns how many times `b` fits in `a` as an `f64`.
///
/// A zero `b` follows floating-point division and gives an infinity or NaN.
pub fn ratio(a: Duration, b: Duration) -> f64 {
    as_seconds_f64(a) / as_seconds_f64(b)
}

/// Returns `-1`, `0` or `1` as `a` is shorter than, equal to or longer than `b`.
///
/// Negative durations are shorter than positive ones.
pub fn compare(a: Duration, b: Duration) -> i64 {
    if a.secs != b.secs {
        return if a.secs < b.secs { -1 } else { 1 }
    }
    if a.nanos < b.nanos {
        return -1
    }
    if a.nanos > b.nanos { 1 } else { 0 }
}

/// Returns whether `a` and `b` are the same length.
pub fn equal(a: Duration, b: Duration) -> bool {
    compare(a, b) == 0
}

/// Returns whether `a` is shorter than `b`.
pub fn before(a: Duration, b: Duration) -> bool {
    compare(a, b) < 0
}

/// Returns whether `a` is longer than `b`.
pub fn after(a: Duration, b: Duration) -> bool {
    compare(a, b) > 0
}

/// Returns the shorter of the two durations, or `a` when they are equal.
pub fn min(a: Duration, b: Duration) -> Duration {
    if compare(b, a) < 0 { b } else { a }
}

/// Returns the longer of the two durations, or `a` when they are equal.
pub fn max(a: Duration, b: Duration) -> Duration {
    if compare(b, a) > 0 { b } else { a }
}

fn unit_nanos(unit: Duration) -> i64 ! fault.Fault {
    let u = as_nanos(unit) ?? fail OutOfRange("rounding unit")
    if u <= 0 {
        fail Invalid("rounding unit")
    }
    if u > 4611686018427387903 {
        fail OutOfRange("rounding unit")
    }
    u
}

/// Returns `d` rounded to a multiple of `unit` using `mode`.
///
/// Multiples are counted from zero. Fails with `Invalid` when `unit` is zero or negative, with `OutOfRange` when `unit` is longer than about 146 years (`2^62 - 1` nanoseconds), and with `Overflow` when the rounded result does not fit.
pub fn round(d: Duration, unit: Duration, mode: rounding.Rounding) -> Duration ! fault.Fault {
    let u = unit_nanos(unit)?
    let r2 = rounding.remainder(floor_seconds(d), floor_nanos(d), 2 * u)
    let even = r2 < u
    let r = if even { r2 } else { r2 - u }
    let up = rounding.up(mode, is_negative(d), even, r, u)
    let delta = if up { u - r } else { -r }
    try_plus(d, nanoseconds(delta)) ?? fail Overflow
}

/// Returns `d` rounded toward zero to a multiple of `unit`.
///
/// Fails in the same cases as `round`.
pub fn truncate(d: Duration, unit: Duration) -> Duration ! fault.Fault {
    round(d, unit, rounding.Rounding.Trunc)
}

fn fraction_text(value: i64, width: i64) -> str {
    if value == 0 {
        return ""
    }
    let digits = text.pad_left("{value}", width, '0')
    var end = width
    for digits[end - 1] == '0' {
        end -= 1
    }
    ".{digits[..end]}"
}

fn sign_text(d: Duration) -> str {
    if is_negative(d) { "-" } else { "" }
}

/// Returns `d` in the ISO 8601 time form, such as `PT1H30M` or `PT0.25S`.
///
/// Zero is `PT0S` and a negative duration starts with `-`. Hours are not folded into days, and the seconds carry up to nine fraction digits with trailing zeros removed. `parse` reads the result back.
pub fn to_string(d: Duration) -> str {
    if is_zero(d) {
        return "PT0S"
    }
    let a = abs(d)
    let hours = a.secs / 3600
    let minutes = a.secs % 3600 / 60
    let seconds = a.secs % 60
    let h = if hours > 0 { "{hours}H" } else { "" }
    let m = if minutes > 0 { "{minutes}M" } else { "" }
    let s = if seconds > 0 || a.nanos > 0 { "{seconds}{fraction_text(a.nanos, 9)}S" } else { "" }
    "{sign_text(d)}PT{h}{m}{s}"
}

fn sub_second_text(nanos: i64) -> str {
    if nanos >= 1000000 {
        return "{nanos / 1000000}{fraction_text(nanos % 1000000, 6)}ms"
    }
    if nanos >= 1000 {
        return "{nanos / 1000}{fraction_text(nanos % 1000, 3)}us"
    }
    "{nanos}ns"
}

/// Returns `d` in a short readable form, such as `1h 30m`, `2.5s` or `250us`.
///
/// Zero is `0s` and a negative duration starts with `-`. A duration under one second uses a single unit of `ns`, `us` or `ms`. Longer ones list `h`, `m` and `s` parts separated by spaces and omit a part that is zero. `parse` reads the result back.
pub fn friendly(d: Duration) -> str {
    if is_zero(d) {
        return "0s"
    }
    let a = abs(d)
    if a.secs == 0 {
        return "{sign_text(d)}{sub_second_text(a.nanos)}"
    }
    var parts: []str = []
    let hours = a.secs / 3600
    let minutes = a.secs % 3600 / 60
    let seconds = a.secs % 60
    if hours > 0 {
        push(mut parts, "{hours}h")
    }
    if minutes > 0 {
        push(mut parts, "{minutes}m")
    }
    if seconds > 0 || a.nanos > 0 {
        push(mut parts, "{seconds}{fraction_text(a.nanos, 9)}s")
    }
    "{sign_text(d)}{text.join(parts, " ")}"
}

struct Scan {
    s: str
    at: i64
}

fn more(p: Scan) -> bool {
    p.at < p.s.len
}

fn at_digit(p: Scan) -> bool {
    p.at < p.s.len && p.s[p.at] >= '0' && p.s[p.at] <= '9'
}

fn at_byte(p: Scan, c: u8) -> bool {
    p.at < p.s.len && p.s[p.at] == c
}

fn skip_spaces(mut p: Scan) {
    for at_byte(p, ' ') {
        p.at += 1
    }
}

fn take_whole(mut p: Scan) -> i64 ! fault.Fault {
    if !at_digit(p) {
        fail Syntax(p.at)
    }
    var n = 0
    for at_digit(p) {
        let digit = i64(p.s[p.at] - '0')
        if n > (max_i64() - digit) / 10 {
            fail Overflow
        }
        n = n * 10 + digit
        p.at += 1
    }
    n
}

fn take_fraction(mut p: Scan, unit: i64) -> i64 ! fault.Fault {
    p.at += 1
    if !at_digit(p) {
        fail Syntax(p.at)
    }
    var scale = unit
    var exact = true
    var total = 0
    var count = 0
    for at_digit(p) {
        if count == 9 {
            fail Syntax(p.at)
        }
        let digit = i64(p.s[p.at] - '0')
        if exact && scale % 10 == 0 {
            scale /= 10
            total += digit * scale
        } else {
            exact = false
            if digit != 0 {
                fail Syntax(p.at)
            }
        }
        count += 1
        p.at += 1
    }
    total
}

fn fraction_end(p: Scan) -> i64 {
    var at = p.at + 1
    for at < p.s.len && p.s[at] >= '0' && p.s[at] <= '9' {
        at += 1
    }
    at
}

fn add_component(total: Duration, unit: Duration, whole: i64, fraction: i64) -> Duration ! fault.Fault {
    let scaled = try_times(unit, whole) ?? fail Overflow
    let sum = try_plus(total, scaled) ?? fail Overflow
    try_plus(sum, nanoseconds(fraction)) ?? fail Overflow
}

fn iso_rank(c: u8) -> i64 {
    match c {
        == 'H' => 1
        == 'M' => 2
        == 'S' => 3
        _ => 0
    }
}

fn iso_seconds(rank: i64) -> i64 {
    match rank {
        == 1 => 3600
        == 2 => 60
        _ => 1
    }
}

fn parse_iso(mut p: Scan) -> Duration ! fault.Fault {
    p.at += 1
    if !at_byte(p, 'T') && !at_byte(p, 't') {
        fail Syntax(p.at)
    }
    p.at += 1
    var total = zero()
    var stage = 0
    var components = 0
    for more(p) {
        let whole = take_whole(mut p)?
        var fraction = 0
        var fraction_at = -1
        if at_byte(p, '.') {
            fraction_at = p.at
            fraction = take_fraction(mut p, billion())?
        }
        if !more(p) {
            fail Syntax(p.at)
        }
        let rank = iso_rank(text.upper_byte(p.s[p.at]))
        if rank == 0 || rank <= stage {
            fail Syntax(p.at)
        }
        if fraction_at >= 0 && rank != 3 {
            fail Syntax(fraction_at)
        }
        p.at += 1
        let unit = seconds(iso_seconds(rank))
        total = add_component(total, unit, whole, fraction)?
        stage = rank
        components += 1
    }
    if components == 0 {
        fail Syntax(p.at)
    }
    total
}

struct Unit {
    size: i64
    nanos: i64
}

fn unit_at(p: Scan) -> Unit? {
    let rest = p.s[p.at..]
    if text.starts_with(rest, "ns") {
        return Unit { size: 2, nanos: 1 }
    }
    if text.starts_with(rest, "us") {
        return Unit { size: 2, nanos: 1000 }
    }
    if text.starts_with(rest, "µs") || text.starts_with(rest, "μs") {
        return Unit { size: 3, nanos: 1000 }
    }
    if text.starts_with(rest, "ms") {
        return Unit { size: 2, nanos: 1000000 }
    }
    if text.starts_with(rest, "s") {
        return Unit { size: 1, nanos: billion() }
    }
    if text.starts_with(rest, "m") {
        return Unit { size: 1, nanos: 60000000000 }
    }
    if text.starts_with(rest, "h") {
        return Unit { size: 1, nanos: 3600000000000 }
    }
    none
}

fn parse_friendly(mut p: Scan) -> Duration ! fault.Fault {
    var total = zero()
    for {
        let whole = take_whole(mut p)?
        let number_end = p.at
        var fraction_at = -1
        if at_byte(p, '.') {
            fraction_at = p.at
            p.at = fraction_end(p)
        }
        skip_spaces(mut p)
        let unit = unit_at(p) ?? fail Syntax(p.at)
        var fraction = 0
        if fraction_at >= 0 {
            var scan = Scan { s: p.s, at: fraction_at }
            fraction = take_fraction(mut scan, unit.nanos)?
        }
        p.at += unit.size
        total = add_component(total, nanoseconds(unit.nanos), whole, fraction)?
        let resume = p.at
        skip_spaces(mut p)
        if !at_digit(p) {
            p.at = resume
            break
        }
    }
    total
}

/// Parses a duration written in either the ISO 8601 form or the friendly form.
///
/// Both forms can start with `+` or `-`. The ISO form is `PT` followed by `nH`, `nM` and `nS` in that order, in either case, with a fraction allowed on the seconds only and at least one part present. The friendly form is one or more numbers each followed by a unit, `ns`, `us`, `µs`, `ms`, `s`, `m` or `h`, with optional spaces, such as `1h 30m` or `1.5s`. A fraction must be exactly representable in nanoseconds and have at most nine digits. Fails with `Syntax` at the offset of the first bad byte and with `Overflow` when the total does not fit.
pub fn parse(s: str) -> Duration ! fault.Fault {
    var p = Scan { s, at: 0 }
    var negative = false
    if at_byte(p, '-') || at_byte(p, '+') {
        negative = s[0] == '-'
        p.at = 1
    }
    let magnitude = if at_byte(p, 'P') || at_byte(p, 'p') { parse_iso(mut p)? } else { parse_friendly(mut p)? }
    if more(p) {
        fail Syntax(p.at)
    }
    if negative { negate(magnitude) } else { magnitude }
}
