import std/text
import std/time/fault

/// A read position in a string, shared by the time parsers.
///
/// The `take_` and `expect` functions advance `at` as they read and fail with `Syntax` at the position of the first byte that does not fit.
pub struct Scan {
    /// The string being read.
    pub s: str
    /// The byte position of the next byte to read.
    pub at: i64
}

/// Returns whether any bytes remain.
pub fn more(p: Scan) -> bool {
    p.at < p.s.len
}

/// Returns whether the next byte is an ASCII digit.
pub fn at_digit(p: Scan) -> bool {
    p.at < p.s.len && p.s[p.at] >= '0' && p.s[p.at] <= '9'
}

/// Returns whether the next byte is `c`.
pub fn at_byte(p: Scan, c: u8) -> bool {
    p.at < p.s.len && p.s[p.at] == c
}

/// Reads `c` and returns `true`, or returns `false` and reads nothing.
pub fn accept(mut p: Scan, c: u8) -> bool {
    if at_byte(p, c) {
        p.at += 1
        return true
    }
    false
}

/// Reads `c`. Fails with `Syntax` when the next byte is another one.
pub fn expect(mut p: Scan, c: u8) ! fault.Fault {
    if !accept(mut p, c) {
        fail Syntax(p.at)
    }
}

/// Reads exactly the bytes of `word`. Fails with `Syntax` at the first byte that differs.
pub fn expect_text(mut p: Scan, word: str) ! fault.Fault {
    for i in 0..word.len {
        expect(mut p, word[i])?
    }
}

/// Skips any run of spaces.
pub fn skip_spaces(mut p: Scan) {
    for at_byte(p, ' ') {
        p.at += 1
    }
}

/// Returns the number of digits that start at the read position, without reading them.
pub fn digit_run(p: Scan) -> i64 {
    var n = 0
    for p.at + n < p.s.len && p.s[p.at + n] >= '0' && p.s[p.at + n] <= '9' {
        n += 1
    }
    n
}

/// Reads between `least` and `most` digits as one number. Fails with `Syntax` when fewer than `least` are there.
pub fn digits_between(mut p: Scan, least: i64, most: i64) -> i64 ! fault.Fault {
    var n = 0
    var count = 0
    for count < most && at_digit(p) {
        n = n * 10 + i64(p.s[p.at] - '0')
        p.at += 1
        count += 1
    }
    if count < least {
        fail Syntax(p.at)
    }
    n
}

/// Reads exactly `count` digits as one number. Fails with `Syntax` when fewer are there.
pub fn digits(mut p: Scan, count: i64) -> i64 ! fault.Fault {
    digits_between(mut p, count, count)?
}

/// Reads a run of digits as one number. Fails with `Syntax` when there is none and with `overflow` when the number does not fit in an `i64`.
pub fn take_whole(mut p: Scan, overflow: fault.Fault) -> i64 ! fault.Fault {
    if !at_digit(p) {
        fail Syntax(p.at)
    }
    var n = 0
    for at_digit(p) {
        let digit = i64(p.s[p.at] - '0')
        if n > (9223372036854775807 - digit) / 10 {
            fail overflow
        }
        n = n * 10 + digit
        p.at += 1
    }
    n
}

/// Reads a `.` and the fraction digits after it, and returns the fraction as a count of nanoseconds when the whole number before it was counted in units of `unit_nanos` nanoseconds.
///
/// At most nine digits are read, and the fraction must be exactly representable in nanoseconds. Fails with `Syntax` when no digit follows the dot, when a tenth digit follows, or when a digit that cannot be represented is not zero.
pub fn take_fraction(mut p: Scan, unit_nanos: i64) -> i64 ! fault.Fault {
    p.at += 1
    if !at_digit(p) {
        fail Syntax(p.at)
    }
    var scale = unit_nanos
    var exact = true
    var total = 0
    var count = 0
    for at_digit(p) {
        if count == 9 {
            fail Syntax(p.at)
        }
        let digit = i64(p.s[p.at] - '0')
        if exact && scale % 10 == 0 {
            scale /= 10
            total += digit * scale
        } else {
            exact = false
            if digit != 0 {
                fail Syntax(p.at)
            }
        }
        count += 1
        p.at += 1
    }
    total
}

/// Returns the position after a `.` at the read position and the digits that follow it, without reading them.
pub fn fraction_end(p: Scan) -> i64 {
    var at = p.at + 1
    for at < p.s.len && p.s[at] >= '0' && p.s[at] <= '9' {
        at += 1
    }
    at
}

/// Returns `value` as a `.` and `width` digits with trailing zeros removed, or an empty string for zero.
pub fn fraction_text(value: i64, width: i64) -> str {
    if value == 0 {
        return ""
    }
    let digits = text.pad_left("{value}", width, '0')
    var end = width
    for digits[end - 1] == '0' {
        end -= 1
    }
    ".{digits[..end]}"
}

/// Returns a count of nanoseconds below a second in the largest of `ms`, `us` and `ns` that keeps the number whole, with a trimmed fraction.
pub fn sub_second_text(nanos: i64) -> str {
    if nanos >= 1000000 {
        return "{nanos / 1000000}{fraction_text(nanos % 1000000, 6)}ms"
    }
    if nanos >= 1000 {
        return "{nanos / 1000}{fraction_text(nanos % 1000, 3)}us"
    }
    "{nanos}ns"
}
