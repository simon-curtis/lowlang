pub enum Rounding {
    Trunc
    Ceil
    Floor
    Expand
    HalfExpand
    HalfEven
    HalfTrunc
    HalfCeil
    HalfFloor
}

fn billion() -> i64 {
    1000000000
}

fn floor_mod(a: i64, b: i64) -> i64 {
    let r = a % b
    if r < 0 { r + b } else { r }
}

fn add_mod(x: i64, y: i64, m: i64) -> i64 {
    if x >= m - y { x - (m - y) } else { x + y }
}

pub fn up(mode: Rounding, negative: bool, even: bool, r: i64, divisor: i64) -> bool {
    if r == 0 {
        return false
    }
    let below = r < divisor - r
    let tie = r == divisor - r
    match mode {
        Trunc => negative
        Ceil => true
        Floor => false
        Expand => !negative
        HalfExpand => !below && !(tie && negative)
        HalfEven => !below && !(tie && even)
        HalfTrunc => !below && !(tie && !negative)
        HalfCeil => !below
        HalfFloor => !below && !tie
    }
}

pub fn apply(q: i64, r: i64, divisor: i64, mode: Rounding) -> i64 {
    let even = floor_mod(q, 2) == 0
    if up(mode, q < 0, even, r, divisor) { q + 1 } else { q }
}

pub fn remainder(secs: i64, nanos: i64, m: i64) -> i64 {
    var base = floor_mod(secs, m)
    var scale = billion()
    var acc = 0
    for scale > 0 {
        if scale % 2 == 1 {
            acc = add_mod(acc, base, m)
        }
        base = add_mod(base, base, m)
        scale /= 2
    }
    add_mod(acc, nanos % m, m)
}
