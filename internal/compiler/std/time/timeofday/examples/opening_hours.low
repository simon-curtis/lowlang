import std/time/duration
import std/time/fault
import std/time/rounding
import std/time/span
import std/time/timeofday

struct Hours {
    opens: timeofday.TimeOfDay
    closes: timeofday.TimeOfDay
}

fn parse_hours(text: str) -> Hours ! fault.Fault {
    let opens = timeofday.parse_with(text[0..5], "%H:%M")?
    let closes = timeofday.parse_with(text[6..11], "%H:%M")?
    Hours { opens: opens, closes: closes }
}

fn is_open(h: Hours, now: timeofday.TimeOfDay) -> bool {
    if timeofday.before(h.opens, h.closes) {
        return !timeofday.before(now, h.opens) && timeofday.before(now, h.closes)
    }
    !timeofday.before(now, h.opens) || timeofday.before(now, h.closes)
}

/// Checks opening hours against times of day, including a venue that stays open past midnight.
fn main() ! fault.Fault {
    let shop = parse_hours("09:00-17:30")?
    let bar = parse_hours("18:00-02:00")?

    let probes = [timeofday.hm(8, 59)?, timeofday.noon(), timeofday.hm(17, 30)?, timeofday.hm(23, 15)?, timeofday.hm(1, 30)?]
    for now in probes {
        print("{timeofday.to_string(now)}  shop {is_open(shop, now)}  bar {is_open(bar, now)}")
    }

    let open_for = timeofday.until(shop.opens, shop.closes)
    print("shop is open {duration.friendly(open_for)}")
    let bar_open = timeofday.until(bar.opens, bar.closes)
    print("until is negative when closing is the next morning: {duration.friendly(bar_open)}")
    let bar_wrapped = duration.plus(bar_open, duration.hours(24))
    print("bar is open {duration.friendly(bar_wrapped)}")

    let last_orders = timeofday.minus(shop.closes, duration.minutes(20))?
    print("last orders {timeofday.to_string(last_orders)}")
    let closing_time = timeofday.plus_wrapping(bar.opens, bar_wrapped)
    print("bar closes {timeofday.to_string(closing_time)}")
    let past_midnight = timeofday.plus(timeofday.hm(23, 50)?, duration.minutes(20)) catch {
        _ => {
            print("plus fails past midnight")
            timeofday.midnight()
        }
    }
    print(timeofday.to_string(past_midnight))

    let delivery = timeofday.of(14, 37, 52, 400000000)?
    print("delivery {timeofday.to_string_full(delivery)}")
    print("window starts {timeofday.to_string(timeofday.round(delivery, span.Unit.Minutes, 30, rounding.Rounding.Floor)?)}")
    print("window ends {timeofday.to_string(timeofday.round(delivery, span.Unit.Minutes, 30, rounding.Rounding.Ceil)?)}")
    print("to the second {timeofday.to_string_seconds(timeofday.truncate(delivery, span.Unit.Seconds)?)}")
    print("12 hour clock {timeofday.format(delivery, "%I:%M %p")?}")
}
