import std/text
import std/time/duration
import std/time/fault
import std/time/pattern
import std/time/rounding
import std/time/scan
import std/time/span

/// A time on a 24-hour clock with nanosecond precision, from `00:00` to `23:59:59.999999999`.
///
/// It has no date, offset or zone and is held as nanoseconds since midnight.
pub struct TimeOfDay {
    nanos: i64
}

const day_nanos = 86400000000000
const billion = 1000000000

/// Returns the time of day with the hour `h`, minute `m`, second `s` and nanosecond `ns`.
///
/// Fails with `OutOfRange` naming the field when `h` is outside `0` to `23`, `m` or `s` is outside `0` to `59`, or `ns` is outside `0` to `999999999`. There is no leap second.
pub fn of(h: i64, m: i64, s: i64, ns: i64) -> TimeOfDay ! fault.Fault {
    if h < 0 || h > 23 {
        fail OutOfRange("hour")
    }
    if m < 0 || m > 59 {
        fail OutOfRange("minute")
    }
    if s < 0 || s > 59 {
        fail OutOfRange("second")
    }
    if ns < 0 || ns >= billion {
        fail OutOfRange("nanosecond")
    }
    TimeOfDay { nanos: ((h * 60 + m) * 60 + s) * billion + ns }
}

/// Returns the time of day at hour `h` and minute `m`.
///
/// Fails with `OutOfRange` as `of` does.
pub fn hm(h: i64, m: i64) -> TimeOfDay ! fault.Fault {
    of(h, m, 0, 0)?
}

/// Returns `00:00`.
pub fn midnight() -> TimeOfDay {
    TimeOfDay { nanos: 0 }
}

/// Returns `12:00`.
pub fn noon() -> TimeOfDay {
    TimeOfDay { nanos: 43200 * billion }
}

/// Returns the last instant of the day, `23:59:59.999999999`.
pub fn last() -> TimeOfDay {
    TimeOfDay { nanos: day_nanos - 1 }
}

/// Returns the time of day `n` nanoseconds after midnight.
///
/// Fails with `OutOfRange` when `n` is negative or at least one day.
pub fn from_nanos_of_day(n: i64) -> TimeOfDay ! fault.Fault {
    if n < 0 || n >= day_nanos {
        fail OutOfRange("nanosecond of day")
    }
    TimeOfDay { nanos: n }
}

/// Returns the nanoseconds since midnight.
pub fn nanos_of_day(t: TimeOfDay) -> i64 {
    t.nanos
}

/// Returns the hour, from `0` to `23`.
pub fn hour(t: TimeOfDay) -> i64 {
    t.nanos / 3600000000000
}

/// Returns the minute, from `0` to `59`.
pub fn minute(t: TimeOfDay) -> i64 {
    t.nanos / 60000000000 % 60
}

/// Returns the second, from `0` to `59`.
pub fn second(t: TimeOfDay) -> i64 {
    t.nanos / billion % 60
}

/// Returns the nanosecond within the second, from `0` to `999999999`.
pub fn nanosecond(t: TimeOfDay) -> i64 {
    t.nanos % billion
}

/// Returns the whole milliseconds within the second, from `0` to `999`.
pub fn millisecond(t: TimeOfDay) -> i64 {
    t.nanos % billion / 1000000
}

/// Returns the whole microseconds within the second, from `0` to `999999`.
pub fn microsecond(t: TimeOfDay) -> i64 {
    t.nanos % billion / 1000
}

/// Returns `t` with the hour replaced by `h`.
///
/// Fails with `OutOfRange` as `of` does.
pub fn with_hour(t: TimeOfDay, h: i64) -> TimeOfDay ! fault.Fault {
    of(h, minute(t), second(t), nanosecond(t))?
}

/// Returns `t` with the minute replaced by `m`.
///
/// Fails with `OutOfRange` as `of` does.
pub fn with_minute(t: TimeOfDay, m: i64) -> TimeOfDay ! fault.Fault {
    of(hour(t), m, second(t), nanosecond(t))?
}

/// Returns `t` with the second replaced by `s`.
///
/// Fails with `OutOfRange` as `of` does.
pub fn with_second(t: TimeOfDay, s: i64) -> TimeOfDay ! fault.Fault {
    of(hour(t), minute(t), s, nanosecond(t))?
}

/// Returns `t` with the nanosecond replaced by `ns`.
///
/// Fails with `OutOfRange` as `of` does.
pub fn with_nanosecond(t: TimeOfDay, ns: i64) -> TimeOfDay ! fault.Fault {
    of(hour(t), minute(t), second(t), ns)?
}

/// Returns the time `d` after `t`.
///
/// Fails with `Overflow` when the result is before midnight or on a later day. Use `plus_wrapping` to wrap around midnight instead.
pub fn plus(t: TimeOfDay, d: duration.Duration) -> TimeOfDay ! fault.Fault {
    let sum = duration.try_plus(duration.nanoseconds(t.nanos), d) ?? fail Overflow
    let n = duration.as_nanos(sum) ?? fail Overflow
    if n < 0 || n >= day_nanos {
        fail Overflow
    }
    TimeOfDay { nanos: n }
}

/// Returns the time `d` before `t`.
///
/// Fails with `Overflow` when the result is before midnight or on a later day. Use `minus_wrapping` to wrap around midnight instead.
pub fn minus(t: TimeOfDay, d: duration.Duration) -> TimeOfDay ! fault.Fault {
    plus(t, duration.negate(d))?
}

/// Returns the time `d` after `t`, wrapping around midnight in either direction.
///
/// This never fails and discards whole days.
pub fn plus_wrapping(t: TimeOfDay, d: duration.Duration) -> TimeOfDay {
    let r = rounding.remainder(duration.floor_seconds(d), duration.floor_nanos(d), day_nanos)
    TimeOfDay { nanos: (t.nanos + r) % day_nanos }
}

/// Returns the time `d` before `t`, wrapping around midnight in either direction.
///
/// This never fails and discards whole days.
pub fn minus_wrapping(t: TimeOfDay, d: duration.Duration) -> TimeOfDay {
    plus_wrapping(t, duration.negate(d))
}

/// Returns the duration from `a` to `b`, which is negative when `b` is earlier in the day.
///
/// It does not wrap around midnight.
pub fn until(a: TimeOfDay, b: TimeOfDay) -> duration.Duration {
    duration.nanoseconds(b.nanos - a.nanos)
}

/// Returns the duration from `b` to `a`, which is negative when `a` is earlier in the day.
///
/// It does not wrap around midnight.
pub fn since(a: TimeOfDay, b: TimeOfDay) -> duration.Duration {
    until(b, a)
}

/// Returns `t` rounded to a multiple of `increment` `unit`s since midnight, as nanoseconds since midnight.
///
/// The result can equal a full day when `t` rounds up past the end of the day. Fails with `Invalid` when `unit` is a calendar unit or `increment` is below `1` or does not divide the next larger unit evenly (`24` for hours, `60` for minutes and seconds, `1000` for the smaller units), as `span.check_time_increment` states.
pub fn rounded_nanos(t: TimeOfDay, unit: span.Unit, increment: i64, mode: rounding.Rounding) -> i64 ! fault.Fault {
    if increment < 1 {
        fail Invalid("rounding increment")
    }
    span.check_time_increment(unit, increment, span.Unit.Days)?
    let step = span.nanos_per(unit)? * increment
    let q = t.nanos / step
    let r = t.nanos % step
    rounding.apply(q, r, step, mode) * step
}

/// Returns `t` rounded to a multiple of `increment` `unit`s since midnight using `mode`.
///
/// Fails with `Overflow` when the result is a full day, and otherwise as `rounded_nanos` does. Use `round_wrapping` to get midnight in that case.
pub fn round(t: TimeOfDay, unit: span.Unit, increment: i64, mode: rounding.Rounding) -> TimeOfDay ! fault.Fault {
    let n = rounded_nanos(t, unit, increment, mode)?
    if n >= day_nanos {
        fail Overflow
    }
    TimeOfDay { nanos: n }
}

/// Returns `t` rounded like `round`, with a result of a full day wrapping to `00:00`.
///
/// Fails as `rounded_nanos` does.
pub fn round_wrapping(t: TimeOfDay, unit: span.Unit, increment: i64, mode: rounding.Rounding) -> TimeOfDay ! fault.Fault {
    let n = rounded_nanos(t, unit, increment, mode)?
    TimeOfDay { nanos: n % day_nanos }
}

/// Returns `t` with everything below `unit` set to zero.
///
/// Fails as `round` does.
pub fn truncate(t: TimeOfDay, unit: span.Unit) -> TimeOfDay ! fault.Fault {
    round(t, unit, 1, rounding.Rounding.Trunc)?
}

/// Returns `-1`, `0` or `1` as `a` is earlier than, the same as or later than `b` in the day.
pub fn compare(a: TimeOfDay, b: TimeOfDay) -> i64 {
    if a.nanos < b.nanos {
        return -1
    }
    if a.nanos > b.nanos { 1 } else { 0 }
}

/// Returns whether `a` and `b` are the same time of day.
pub fn equal(a: TimeOfDay, b: TimeOfDay) -> bool {
    compare(a, b) == 0
}

/// Returns whether `a` is earlier in the day than `b`.
pub fn before(a: TimeOfDay, b: TimeOfDay) -> bool {
    compare(a, b) < 0
}

/// Returns whether `a` is later in the day than `b`.
pub fn after(a: TimeOfDay, b: TimeOfDay) -> bool {
    compare(a, b) > 0
}

/// Returns the earlier of the two times, or `a` when they are equal.
pub fn min(a: TimeOfDay, b: TimeOfDay) -> TimeOfDay {
    if compare(b, a) < 0 { b } else { a }
}

/// Returns the later of the two times, or `a` when they are equal.
pub fn max(a: TimeOfDay, b: TimeOfDay) -> TimeOfDay {
    if compare(b, a) > 0 { b } else { a }
}

fn pad(n: i64, width: i64) -> str {
    text.pad_left("{n}", width, '0')
}

fn hour_minute_text(t: TimeOfDay) -> str {
    "{pad(hour(t), 2)}:{pad(minute(t), 2)}"
}

/// Returns `t` as `hh:mm` when the seconds and nanoseconds are zero and otherwise as `hh:mm:ss` with the fraction as `to_string_seconds` writes it.
pub fn to_string(t: TimeOfDay) -> str {
    if second(t) == 0 && nanosecond(t) == 0 {
        return hour_minute_text(t)
    }
    to_string_seconds(t)
}

/// Returns `t` as `hh:mm:ss`, followed by a fraction with trailing zeros removed when the nanosecond is not zero.
pub fn to_string_seconds(t: TimeOfDay) -> str {
    "{hour_minute_text(t)}:{pad(second(t), 2)}{scan.fraction_text(nanosecond(t), 9)}"
}

/// Returns `t` as `hh:mm:ss.nnnnnnnnn` with all nine fraction digits.
pub fn to_string_full(t: TimeOfDay) -> str {
    "{hour_minute_text(t)}:{pad(second(t), 2)}.{pad(nanosecond(t), 9)}"
}

struct Clock {
    hour: i64
    minute: i64
    second: i64
    nanos: i64
}

fn take_seconds(mut p: scan.Scan, c: Clock) -> Clock ! fault.Fault {
    let second = scan.digits(mut p, 2)?
    var nanos = 0
    if scan.at_byte(p, '.') {
        nanos = scan.take_fraction(mut p, 1000000000)?
    }
    Clock { hour: c.hour, minute: c.minute, second, nanos }
}

fn take_clock(mut p: scan.Scan) -> Clock ! fault.Fault {
    let hour = scan.digits(mut p, 2)?
    var c = Clock { hour, minute: 0, second: 0, nanos: 0 }
    if scan.at_byte(p, ':') {
        p.at += 1
        let minute = scan.digits(mut p, 2)?
        c = Clock { hour, minute, second: 0, nanos: 0 }
        if scan.at_byte(p, ':') {
            p.at += 1
            c = take_seconds(mut p, c)?
        }
        return c
    }
    if scan.at_digit(p) {
        let minute = scan.digits(mut p, 2)?
        c = Clock { hour, minute, second: 0, nanos: 0 }
        if scan.at_digit(p) {
            c = take_seconds(mut p, c)?
        }
    }
    c
}

/// Parses a time written as `hh`, `hh:mm`, `hh:mm:ss`, `hhmm` or `hhmmss`, with an optional fraction of at most nine digits after the seconds.
///
/// The text can start with `T` or `t`. A second of `60` is read as `59`. Fails with `Syntax` at the offset of the first bad byte and with `OutOfRange` when a field is out of range.
pub fn parse(s: str) -> TimeOfDay ! fault.Fault {
    var p = scan.Scan { s, at: 0 }
    if scan.at_byte(p, 'T') || scan.at_byte(p, 't') {
        p.at += 1
    }
    let c = take_clock(mut p)?
    if scan.more(p) {
        fail Syntax(p.at)
    }
    if c.second > 60 {
        fail OutOfRange("second")
    }
    let second = if c.second == 60 { 59 } else { c.second }
    of(c.hour, c.minute, second, c.nanos)?
}

/// Returns the hour, minute, second and nanosecond of `t` as pattern `Fields`.
pub fn to_fields(t: TimeOfDay) -> pattern.Fields {
    pattern.Fields {
        hour: hour(t),
        minute: minute(t),
        second: second(t),
        nanosecond: nanosecond(t)
    }
}

/// Returns the time of day in `f`.
///
/// The hour comes from `hour` or from `hour12` with `period`, and the minute, second and nanosecond default to `0`. Fails with `Invalid` when the fields do not give an hour or contradict each other, and with `OutOfRange` when a value is out of range.
pub fn from_fields(f: pattern.Fields) -> TimeOfDay ! fault.Fault {
    let w = pattern.wall(f)?
    of(w.hour, w.minute, w.second, w.nanosecond)?
}

/// Returns `t` printed through the compiled pattern `p` with the month, weekday and period words of `names`.
///
/// Fails with `Invalid` when `p` needs a value a time of day does not have, such as a date or an offset.
pub fn format_names(t: TimeOfDay, p: pattern.Pattern, names: pattern.Names) -> str ! fault.Fault {
    pattern.render(p, to_fields(t), names)?
}

/// Returns `t` printed through the compiled pattern `p` with English names.
///
/// Fails as `format_names` does.
pub fn format_with(t: TimeOfDay, p: pattern.Pattern) -> str ! fault.Fault {
    format_names(t, p, pattern.english())?
}

/// Returns `t` printed through the layout `layout`, such as `%H:%M` or `%I:%M %p`.
///
/// Fails with `Syntax` or `Unsupported` for a bad layout, as `pattern.compile` does, and otherwise as `format_names` does.
pub fn format(t: TimeOfDay, layout: str) -> str ! fault.Fault {
    let p = pattern.compile(layout)?
    format_with(t, p)?
}

/// Parses `s` with the compiled pattern `p` and the words of `names`.
///
/// Fails with `Invalid` when `p` uses a date, offset, zone or Unix-time verb, with `Syntax` or `OutOfRange` when `s` does not match, and with `Invalid` when the fields conflict or give no hour.
pub fn parse_names(s: str, p: pattern.Pattern, names: pattern.Names) -> TimeOfDay ! fault.Fault {
    pattern.restrict(p, false, true)?
    let f = pattern.scan(p, s, names)?
    from_fields(f)?
}

/// Parses `s` with the compiled pattern `p` and English names.
///
/// Fails as `parse_names` does.
pub fn parse_pattern(s: str, p: pattern.Pattern) -> TimeOfDay ! fault.Fault {
    parse_names(s, p, pattern.english())?
}

/// Parses `s` with the layout `layout` and English names.
///
/// Fails as `parse_names` does and with `Syntax` or `Unsupported` for a bad layout.
pub fn parse_with(s: str, layout: str) -> TimeOfDay ! fault.Fault {
    let p = pattern.compile(layout)?
    parse_pattern(s, p)?
}
