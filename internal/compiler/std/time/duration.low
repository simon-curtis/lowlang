import std/atomic
import std/text

pub struct Duration {
    pub nanos: i64
}

pub enum Error {
    Invalid(at: i64)
    OutOfRange(at: i64)
    Overflow
}

struct Unit {
    size: i64
    nanos: i64
}

fn max_i64() -> i64 {
    9223372036854775807
}

pub fn nanoseconds(n: i64) -> Duration {
    Duration { nanos: n }
}

pub fn microseconds(n: i64) -> Duration {
    Duration { nanos: n * 1000 }
}

pub fn milliseconds(n: i64) -> Duration {
    Duration { nanos: n * 1000000 }
}

pub fn seconds(n: i64) -> Duration {
    Duration { nanos: n * 1000000000 }
}

pub fn minutes(n: i64) -> Duration {
    Duration { nanos: n * 60000000000 }
}

pub fn hours(n: i64) -> Duration {
    Duration { nanos: n * 3600000000000 }
}

pub fn as_nanos(d: Duration) -> i64 {
    d.nanos
}

pub fn as_micros(d: Duration) -> i64 {
    d.nanos / 1000
}

pub fn as_millis(d: Duration) -> i64 {
    d.nanos / 1000000
}

pub fn as_seconds(d: Duration) -> f64 {
    f64(d.nanos) / 1000000000.0
}

pub fn as_minutes(d: Duration) -> f64 {
    f64(d.nanos) / 60000000000.0
}

pub fn as_hours(d: Duration) -> f64 {
    f64(d.nanos) / 3600000000000.0
}

pub fn add(a: Duration, b: Duration) -> Duration {
    Duration { nanos: a.nanos + b.nanos }
}

pub fn sub(a: Duration, b: Duration) -> Duration {
    Duration { nanos: a.nanos - b.nanos }
}

pub fn since(start: i64) -> Duration {
    Duration { nanos: monotonic() - start }
}

fn unit_at(s: str, at: i64) -> Unit? {
    let rest = s[at..]
    if text.starts_with(rest, "ns") {
        return Unit { size: 2, nanos: 1 }
    }
    if text.starts_with(rest, "us") {
        return Unit { size: 2, nanos: 1000 }
    }
    if text.starts_with(rest, "µs") || text.starts_with(rest, "μs") {
        return Unit { size: 3, nanos: 1000 }
    }
    if text.starts_with(rest, "ms") {
        return Unit { size: 2, nanos: 1000000 }
    }
    if text.starts_with(rest, "s") {
        return Unit { size: 1, nanos: 1000000000 }
    }
    if text.starts_with(rest, "m") {
        return Unit { size: 1, nanos: 60000000000 }
    }
    if text.starts_with(rest, "h") {
        return Unit { size: 1, nanos: 3600000000000 }
    }
    none
}

struct Input {
    s: str
    at: i64
}

fn at_digit(p: Input) -> bool {
    p.at < p.s.len && p.s[p.at] >= '0' && p.s[p.at] <= '9'
}

fn take_digit(mut p: Input) -> i64 {
    let d = i64(p.s[p.at] - '0')
    p.at += 1
    d
}

fn take_whole(mut p: Input) -> i64 ! Error {
    var whole = 0
    for at_digit(p) {
        let d = i64(p.s[p.at] - '0')
        if whole > (max_i64() - d) / 10 {
            fail Overflow
        }
        whole = whole * 10 + d
        p.at += 1
    }
    whole
}

fn take_fraction(mut p: Input, unit: i64) -> i64 {
    var scale = unit
    var total = 0
    for at_digit(p) {
        scale /= 10
        total += take_digit(mut p) * scale
    }
    total
}

fn take_component(mut p: Input) -> i64 ! Error {
    let start = p.at
    let whole = take_whole(mut p)?
    var fraction_at = p.at
    let had_whole = p.at > start
    var had_fraction = false
    if p.at < p.s.len && p.s[p.at] == '.' {
        p.at += 1
        fraction_at = p.at
        for at_digit(p) {
            p.at += 1
            had_fraction = true
        }
    }
    if !had_whole && !had_fraction {
        fail Invalid(start)
    }
    let unit_start = p.at
    let unit = unit_at(p.s, unit_start) ?? fail Invalid(unit_start)
    if whole > max_i64() / unit.nanos {
        fail Overflow
    }
    var fraction = Input { s: p.s, at: fraction_at }
    let part = whole * unit.nanos
    let extra = take_fraction(mut fraction, unit.nanos)
    if part > max_i64() - extra {
        fail Overflow
    }
    p.at = unit_start + unit.size
    part + extra
}

pub fn parse_duration(s: str) -> Duration ! Error {
    var p = Input { s, at: 0 }
    var negative = false
    if s.len > 0 && (s[0] == '-' || s[0] == '+') {
        negative = s[0] == '-'
        p.at = 1
    }
    if p.at == s.len {
        fail Invalid(p.at)
    }
    if s[p.at..] == "0" {
        return Duration { nanos: 0 }
    }
    var total = 0
    for p.at < s.len {
        let part = take_component(mut p)?
        if part > max_i64() - total {
            fail Overflow
        }
        total += part
    }
    Duration { nanos: if negative { -total } else { total } }
}

fn pow10(digits: i64) -> i64 {
    var n = 1
    for i in 0..digits {
        n *= 10
    }
    n
}

fn scaled(v: i64, digits: i64) -> str {
    let unit = pow10(digits)
    "{v / unit}{format_fraction(v % unit * pow10(9 - digits))}"
}

fn format_magnitude(u: i64) -> str {
    if u == 0 {
        return "0s"
    }
    if u < 1000 {
        return "{u}ns"
    }
    if u < 1000000 {
        return "{scaled(u, 3)}µs"
    }
    if u < 1000000000 {
        return "{scaled(u, 6)}ms"
    }
    let whole_minutes = u / 60000000000
    let seconds_text = "{scaled(u % 60000000000, 9)}s"
    if whole_minutes == 0 {
        return seconds_text
    }
    if whole_minutes < 60 {
        return "{whole_minutes}m{seconds_text}"
    }
    "{whole_minutes / 60}h{whole_minutes % 60}m{seconds_text}"
}

pub fn format_duration(d: Duration) -> str {
    if d.nanos == -max_i64() - 1 {
        return "-2562047h47m16.854775808s"
    }
    if d.nanos < 0 {
        return "-{format_magnitude(-d.nanos)}"
    }
    format_magnitude(d.nanos)
}

fn millis_up(nanos: i64) -> i64 {
    (nanos + 999999) / 1000000
}

pub fn sleep_for(d: Duration) {
    if d.nanos > 0 {
        sleep(millis_up(d.nanos))
    }
}

pub struct Timer {
    pub fired: chan[bool]
    armed: atomic.Int
    serial: atomic.Int
}

fn fire(fired: chan[bool], armed: atomic.Int, token: i64, millis: i64) {
    sleep(millis)
    if armed.compare_and_swap_int(token, 0) {
        select {
            fired <- true => {}
            else => {}
        }
    }
}

fn arm(t: Timer, d: Duration) {
    let token = t.serial.add_int(1)
    t.armed.store_int(token)
    spawn fire(t.fired, t.armed, token, millis_up(d.nanos))
}

pub fn timer(d: Duration) -> Timer {
    let t = Timer { fired: chan[bool](1), armed: atomic.int(0), serial: atomic.int(0) }
    arm(t, d)
    t
}

pub fn after(d: Duration) -> chan[bool] {
    timer(d).fired
}

pub fn stop_timer(t: Timer) -> bool {
    var seen = t.armed.load_int()
    for seen != 0 {
        if t.armed.compare_and_swap_int(seen, 0) {
            return true
        }
        seen = t.armed.load_int()
    }
    false
}

pub fn reset_timer(t: Timer, d: Duration) {
    stop_timer(t)
    select {
        <-t.fired => {}
        else => {}
    }
    arm(t, d)
}

pub struct Ticker {
    pub ticks: chan[bool]
    stopped: atomic.Flag
}

fn run_ticker(ticks: chan[bool], stopped: atomic.Flag, period: i64, begin: i64) {
    var next = begin
    for {
        next += period
        let wait = next - monotonic()
        if wait > 0 {
            sleep(millis_up(wait))
        }
        if stopped.is_set() {
            return
        }
        select {
            ticks <- true => {}
            else => {}
        }
        let late = monotonic() - next
        if late > period {
            next += late / period * period
        }
    }
}

pub fn ticker(d: Duration) -> Ticker {
    let t = Ticker { ticks: chan[bool](1), stopped: atomic.flag() }
    let period = if d.nanos < 1000000 { 1000000 } else { d.nanos }
    spawn run_ticker(t.ticks, t.stopped, period, monotonic())
    t
}

pub fn stop_ticker(t: Ticker) {
    t.stopped.set()
}

pub struct Stopwatch {
    began: i64
}

pub fn start() -> Stopwatch {
    Stopwatch { began: monotonic() }
}

pub fn elapsed(w: Stopwatch) -> Duration {
    since(w.began)
}
