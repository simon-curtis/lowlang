import std/time
import std/time/duration
import std/time/timestamp

/// A source of the current time made of a wall reading and a monotonic reading, which lets code that asks for the time be tested without sleeping.
///
/// `system` reads the operating system, `fixed` never moves and `manual` is moved by the caller.
pub struct Clock {
    /// Returns the current wall-clock time.
    pub read: fn() -> timestamp.Timestamp
    /// Returns the monotonic reading as a duration from an origin the clock chooses.
    ///
    /// Only differences between readings of the same clock are meaningful.
    pub monotonic: fn() -> duration.Duration
}

struct State {
    lock: i64
    now: timestamp.Timestamp
    elapsed: duration.Duration
}

/// A clock under the caller's control, made by `manual` and turned into a `Clock` by `clock`.
///
/// Copies of a `Manual` and the clocks made from it share one state, so `advance` and `set` are seen by all of them.
pub struct Manual {
    state: *State
}

/// Returns a clock that reads the operating system's wall and monotonic clocks.
pub fn system() -> Clock {
    Clock {
        read: fn() -> timestamp.Timestamp { timestamp.now() },
        monotonic: fn() -> duration.Duration { duration.nanoseconds(time.monotonic()) }
    }
}

/// Returns a clock whose wall reading is always `ts` and whose monotonic reading is always zero.
pub fn fixed(ts: timestamp.Timestamp) -> Clock {
    Clock {
        read: fn() -> timestamp.Timestamp { ts },
        monotonic: fn() -> duration.Duration { duration.zero() }
    }
}

/// Returns a `Manual` clock whose wall reading starts at `start` and whose monotonic reading starts at zero.
pub fn manual(start: timestamp.Timestamp) -> Manual {
    Manual { state: new(State { lock: 0, now: start, elapsed: duration.zero() }) }
}

fn read_now(s: *State) -> timestamp.Timestamp {
    __lock(mut s.lock)
    let ts = s.now
    __unlock(mut s.lock)
    ts
}

fn read_elapsed(s: *State) -> duration.Duration {
    __lock(mut s.lock)
    let d = s.elapsed
    __unlock(mut s.lock)
    d
}

/// Returns a `Clock` that reads the current state of `m`.
pub fn clock(m: Manual) -> Clock {
    let s = m.state
    Clock {
        read: fn() -> timestamp.Timestamp { read_now(s) },
        monotonic: fn() -> duration.Duration { read_elapsed(s) }
    }
}

/// Moves the wall and monotonic readings of `m` forward by `d`.
///
/// A negative `d` moves both backwards. Panics with `clock: advance overflows` when either reading would leave its range, and leaves the clock unchanged.
pub fn advance(m: Manual, d: duration.Duration) {
    let s = m.state
    __lock(mut s.lock)
    let moved = timestamp.try_plus(s.now, d)
    let total = duration.try_plus(s.elapsed, d)
    if moved == none || total == none {
        __unlock(mut s.lock)
        __panic("clock: advance overflows")
    }
    s.now = moved ?? s.now
    s.elapsed = total ?? s.elapsed
    __unlock(mut s.lock)
}

/// Replaces the wall reading of `m` with `ts`.
///
/// The monotonic reading is unchanged.
pub fn set(m: Manual, ts: timestamp.Timestamp) {
    let s = m.state
    __lock(mut s.lock)
    s.now = ts
    __unlock(mut s.lock)
}

/// Returns the wall-clock time of `c`.
pub fn now(c: Clock) -> timestamp.Timestamp {
    c.read()
}

/// Returns the monotonic time that has passed on `c` since `start`.
///
/// `start` is an earlier reading of `c.monotonic`.
pub fn elapsed_since(c: Clock, start: duration.Duration) -> duration.Duration {
    duration.minus(c.monotonic(), start)
}
