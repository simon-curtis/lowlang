import std/time
import std/time/duration
import std/time/timestamp

pub struct Clock {
    pub read: fn() -> timestamp.Timestamp
    pub monotonic: fn() -> duration.Duration
}

struct State {
    lock: i64
    now: timestamp.Timestamp
    elapsed: duration.Duration
}

pub struct Manual {
    state: *State
}

pub fn system() -> Clock {
    Clock {
        read: fn() -> timestamp.Timestamp { timestamp.now() },
        monotonic: fn() -> duration.Duration { duration.nanoseconds(time.monotonic()) }
    }
}

pub fn fixed(ts: timestamp.Timestamp) -> Clock {
    Clock {
        read: fn() -> timestamp.Timestamp { ts },
        monotonic: fn() -> duration.Duration { duration.zero() }
    }
}

pub fn manual(start: timestamp.Timestamp) -> Manual {
    Manual { state: new(State { lock: 0, now: start, elapsed: duration.zero() }) }
}

fn read_now(s: *State) -> timestamp.Timestamp {
    __lock(mut s.lock)
    let ts = s.now
    __unlock(mut s.lock)
    ts
}

fn read_elapsed(s: *State) -> duration.Duration {
    __lock(mut s.lock)
    let d = s.elapsed
    __unlock(mut s.lock)
    d
}

pub fn clock(m: Manual) -> Clock {
    let s = m.state
    Clock {
        read: fn() -> timestamp.Timestamp { read_now(s) },
        monotonic: fn() -> duration.Duration { read_elapsed(s) }
    }
}

pub fn advance(m: Manual, d: duration.Duration) {
    let s = m.state
    __lock(mut s.lock)
    let moved = timestamp.try_plus(s.now, d)
    let total = duration.try_plus(s.elapsed, d)
    if moved == none || total == none {
        __unlock(mut s.lock)
        __panic("clock: advance overflows")
    }
    s.now = moved ?? s.now
    s.elapsed = total ?? s.elapsed
    __unlock(mut s.lock)
}

pub fn set(m: Manual, ts: timestamp.Timestamp) {
    let s = m.state
    __lock(mut s.lock)
    s.now = ts
    __unlock(mut s.lock)
}

pub fn now(c: Clock) -> timestamp.Timestamp {
    c.read()
}

pub fn elapsed_since(c: Clock, start: duration.Duration) -> duration.Duration {
    duration.minus(c.monotonic(), start)
}
