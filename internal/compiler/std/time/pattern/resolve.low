import std/time/fault

pub enum Plan {
    Calendar(year: i64, month: i64, day: i64)
    Ordinal(year: i64, day_of_year: i64)
    IsoWeek(year: i64, week: i64, weekday: i64)
}

pub struct Wall {
    pub hour: i64
    pub minute: i64
    pub second: i64
    pub nanosecond: i64
}

fn year_of(f: Fields) -> i64? {
    if f.year != none {
        return f.year
    }
    let yy = f.year_of_century ?? return none
    let century = f.century ?? if yy < 69 { 20 } else { 19 }
    century * 100 + yy
}

fn calendar_plan(f: Fields) -> Plan? {
    let year = year_of(f) ?? return none
    let month = f.month ?? return none
    let day = f.day ?? return none
    Plan.Calendar(year, month, day)
}

fn ordinal_plan(f: Fields) -> Plan? {
    let year = year_of(f) ?? return none
    let day = f.day_of_year ?? return none
    Plan.Ordinal(year, day)
}

fn iso_plan(f: Fields) -> Plan? {
    let year = f.iso_year ?? return none
    let week = f.iso_week ?? return none
    let weekday = f.weekday ?? return none
    Plan.IsoWeek(year, week, weekday)
}

pub fn date_plan(f: Fields) -> Plan ! fault.Fault {
    calendar_plan(f) ?? ordinal_plan(f) ?? iso_plan(f) ?? fail Invalid("pattern needs a full date")
}

fn clock_hour(f: Fields) -> i64 ! fault.Fault {
    if f.hour != none {
        let hour = f.hour ?? 0
        let twelve = f.hour12 ?? hour
        if twelve % 12 != hour % 12 {
            fail Invalid("pattern fields conflict")
        }
        let period = f.period ?? if hour >= 12 { 1 } else { 0 }
        if (period == 1) != (hour >= 12) {
            fail Invalid("pattern fields conflict")
        }
        return hour
    }
    let twelve = f.hour12 ?? fail Invalid("pattern needs time of day")
    let period = f.period ?? fail Invalid("pattern needs am or pm with the 12-hour clock")
    twelve % 12 + period * 12
}

pub fn wall(f: Fields) -> Wall ! fault.Fault {
    let hour = clock_hour(f)?
    Wall {
        hour,
        minute: f.minute ?? 0,
        second: f.second ?? 0,
        nanosecond: f.nanosecond ?? 0
    }
}

fn same(parsed: i64?, actual: i64?) -> bool {
    let a = parsed ?? return true
    let b = actual ?? return true
    a == b
}

fn floor_div(a: i64, b: i64) -> i64 {
    let q = a / b
    if a % b != 0 && (a < 0) != (b < 0) { q - 1 } else { q }
}

fn sunday_week(actual: Fields) -> i64? {
    let doy = actual.day_of_year ?? return none
    let weekday = actual.weekday ?? return none
    (doy + 6 - weekday % 7) / 7
}

fn monday_week(actual: Fields) -> i64? {
    let doy = actual.day_of_year ?? return none
    let weekday = actual.weekday ?? return none
    (doy + 7 - weekday) / 7
}

fn century_of(actual: Fields) -> i64? {
    let year = actual.year ?? return none
    floor_div(year, 100)
}

fn year_in_century_of(actual: Fields) -> i64? {
    let year = actual.year ?? return none
    year - floor_div(year, 100) * 100
}

pub fn check_date(parsed: Fields, actual: Fields) ! fault.Fault {
    let agrees = same(parsed.year, actual.year) && same(parsed.month, actual.month) && same(parsed.day, actual.day) &&
        same(parsed.day_of_year, actual.day_of_year) && same(parsed.weekday, actual.weekday) &&
        same(parsed.iso_year, actual.iso_year) && same(parsed.iso_week, actual.iso_week) &&
        same(parsed.week_sunday, sunday_week(actual)) && same(parsed.week_monday, monday_week(actual)) &&
        same(parsed.century, century_of(actual)) && same(parsed.year_of_century, year_in_century_of(actual))
    if !agrees {
        fail Invalid("pattern fields conflict")
    }
}
