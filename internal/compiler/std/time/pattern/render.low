import std/builder
import std/text
import std/time/fault

fn need_date(v: i64?) -> i64 ! fault.Fault {
    v ?? fail Invalid("pattern needs date")
}

fn need_time(v: i64?) -> i64 ! fault.Fault {
    v ?? fail Invalid("pattern needs time of day")
}

fn need_offset(v: i64?) -> i64 ! fault.Fault {
    v ?? fail Invalid("pattern needs offset")
}

fn need_unix(v: i64?) -> i64 ! fault.Fault {
    v ?? fail Invalid("pattern needs unix time")
}

fn need_zone(v: str?) -> str ! fault.Fault {
    v ?? fail Invalid("pattern needs zone name")
}

fn pick(list: []str, index: i64) -> str ! fault.Fault {
    if index < 0 || index >= list.len {
        fail Invalid("pattern field")
    }
    list[index]
}

fn width_of(verb: u8) -> i64 {
    if verb == 'Y' || verb == 'G' {
        return 4
    }
    if verb == 'j' {
        return 3
    }
    if verb == 'u' || verb == 'w' || verb == 's' { 1 } else { 2 }
}

fn padded(digits: str, width: i64, pad: Pad) -> str {
    match pad {
        Tight => digits
        Space => text.pad_left(digits, width, ' ')
        Zero => text.pad_left(digits, width, '0')
    }
}

fn signed(s: Spec, value: i64) -> str {
    let magnitude = if value < 0 { -value } else { value }
    let sign = if value < 0 { "-" } else { "" }
    let digits = padded("{magnitude}", width_of(s.verb), s.pad)
    "{sign}{digits}"
}

fn hour12(hour: i64) -> i64 {
    let n = hour % 12
    if n == 0 { 12 } else { n }
}

fn year_digits(year: i64) -> i64 ! fault.Fault {
    if year < 0 {
        fail Invalid("two-digit year needs year 0 to 9999")
    }
    year
}

fn number_text(s: Spec, f: Fields) -> str ! fault.Fault {
    match s.verb {
        == 'Y' => signed(s, need_date(f.year)?)
        == 'G' => signed(s, need_date(f.iso_year)?)
        == 'y' => signed(s, year_digits(need_date(f.year)?)? % 100)
        == 'C' => signed(s, year_digits(need_date(f.year)?)? / 100)
        == 'm' => signed(s, need_date(f.month)?)
        == 'd' => signed(s, need_date(f.day)?)
        == 'e' => signed(s, need_date(f.day)?)
        == 'j' => signed(s, need_date(f.day_of_year)?)
        == 'u' => signed(s, need_date(f.weekday)?)
        == 'w' => signed(s, need_date(f.weekday)? % 7)
        == 'V' => signed(s, need_date(f.iso_week)?)
        == 'U' => signed(s, (need_date(f.day_of_year)? + 6 - need_date(f.weekday)? % 7) / 7)
        == 'W' => signed(s, (need_date(f.day_of_year)? + 7 - need_date(f.weekday)?) / 7)
        == 'H' => signed(s, need_time(f.hour)?)
        == 'I' => signed(s, hour12(need_time(f.hour)?))
        == 'M' => signed(s, need_time(f.minute)?)
        == 'S' => signed(s, need_time(f.second)?)
        _ => signed(s, need_unix(f.unix_seconds)?)
    }
}

fn cased(s: Spec, value: str) -> str {
    if s.upper { text.upper(value) } else { value }
}

fn name_text(s: Spec, f: Fields, n: Names) -> str ! fault.Fault {
    match s.verb {
        == 'a' => cased(s, pick(n.short_weekdays, need_date(f.weekday)? - 1)?)
        == 'A' => cased(s, pick(n.weekdays, need_date(f.weekday)? - 1)?)
        == 'b' => cased(s, pick(n.short_months, need_date(f.month)? - 1)?)
        == 'B' => cased(s, pick(n.months, need_date(f.month)? - 1)?)
        == 'p' => cased(s, if need_time(f.hour)? < 12 { n.am } else { n.pm })
        == 'P' => cased(s, text.lower(if need_time(f.hour)? < 12 { n.am } else { n.pm }))
        _ => cased(s, need_zone(f.zone_abbreviation)?)
    }
}

fn two(n: i64) -> str {
    text.pad_left("{n}", 2, '0')
}

fn offset_text(seconds: i64, colons: i64) -> str {
    let sign = if seconds < 0 { "-" } else { "+" }
    let magnitude = if seconds < 0 { -seconds } else { seconds }
    let hours = two(magnitude / 3600)
    let minutes = two(magnitude % 3600 / 60)
    let rest = magnitude % 60
    let colon = if colons == 0 { "" } else { ":" }
    let tail = if colons == 2 || rest != 0 { "{colon}{two(rest)}" } else { "" }
    "{sign}{hours}{colon}{minutes}{tail}"
}

fn fraction_text(s: Spec, nanos: i64) -> str {
    let digits = text.pad_left("{nanos}", 9, '0')
    digits[..if s.arg == 0 { 6 } else { s.arg }]
}

fn field_text(s: Spec, f: Fields, n: Names) -> str ! fault.Fault {
    match s.verb {
        == 'a' || == 'A' || == 'b' || == 'B' || == 'p' || == 'P' || == 'Z' => name_text(s, f, n)?
        == 'z' => offset_text(need_offset(f.offset_seconds)?, s.arg)
        == 'f' => fraction_text(s, need_time(f.nanosecond)?)
        _ => number_text(s, f)?
    }
}

/// Returns `f` printed through `p` using `names`.
///
/// Fails with `Invalid` when `names` has the wrong number of entries, when a value that `p` needs is missing from `f` and when a two-digit year is asked of a negative year.
pub fn render(p: Pattern, f: Fields, names: Names) -> str ! fault.Fault {
    check_names(names)?
    var out = builder.builder()
    for item in p.items {
        match item {
            Text(t) => builder.write(mut out, t)
            Blank(count) => builder.write_repeat(mut out, " ", count)
            Field(spec) => {
                let piece = field_text(spec, f, names)?
                builder.write(mut out, piece)
            }
        }
    }
    builder.to_str(out)
}
