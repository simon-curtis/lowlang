import std/text
import std/time/fault

struct Cursor {
    s: str
    at: i64
}

fn at_digit(c: Cursor) -> bool {
    c.at < c.s.len && c.s[c.at] >= '0' && c.s[c.at] <= '9'
}

fn at_byte(c: Cursor, b: u8) -> bool {
    c.at < c.s.len && c.s[c.at] == b
}

fn at_letter(c: Cursor) -> bool {
    c.at < c.s.len && (c.s[c.at] >= 'A' && c.s[c.at] <= 'Z' || c.s[c.at] >= 'a' && c.s[c.at] <= 'z')
}

fn merged(old: i64?, value: i64) -> i64 ! fault.Fault {
    let had = old ?? value
    if had != value {
        fail Invalid("pattern fields conflict")
    }
    value
}

fn take_text(mut c: Cursor, t: str) ! fault.Fault {
    for i in 0..t.len {
        if c.at + i >= c.s.len || c.s[c.at + i] != t[i] {
            fail Syntax(c.at + i)
        }
    }
    c.at += t.len
}

fn take_blanks(mut c: Cursor, count: i64) ! fault.Fault {
    var seen = 0
    for at_byte(c, ' ') {
        seen += 1
        c.at += 1
    }
    if seen < count {
        fail Syntax(c.at)
    }
}

fn take_digits(mut c: Cursor, most: i64) -> i64 ! fault.Fault {
    if !at_digit(c) {
        fail Syntax(c.at)
    }
    var n = 0
    var count = 0
    for count < most && at_digit(c) {
        n = n * 10 + i64(c.s[c.at] - '0')
        count += 1
        c.at += 1
    }
    n
}

fn take_exact(mut c: Cursor, count: i64) -> i64 ! fault.Fault {
    var n = 0
    for _ in 0..count {
        if !at_digit(c) {
            fail Syntax(c.at)
        }
        n = n * 10 + i64(c.s[c.at] - '0')
        c.at += 1
    }
    n
}

fn take_number(mut c: Cursor, s: Spec, most: i64) -> i64 ! fault.Fault {
    if s.pad == Pad.Space {
        var skipped = 0
        for skipped < most - 1 && at_byte(c, ' ') {
            skipped += 1
            c.at += 1
        }
    }
    take_digits(mut c, most)?
}

fn ranged(v: i64, low: i64, high: i64, what: str) -> i64 ! fault.Fault {
    if v < low || v > high {
        fail OutOfRange(what)
    }
    v
}

fn take_ranged(mut c: Cursor, s: Spec, low: i64, high: i64, what: str) -> i64 ! fault.Fault {
    let v = take_number(mut c, s, width_of(s.verb))?
    ranged(v, low, high, what)?
}

fn take_year(mut c: Cursor) -> i64 ! fault.Fault {
    let start = c.at
    let negative = at_byte(c, '-')
    if negative {
        c.at += 1
    }
    let magnitude = take_digits(mut c, 4)?
    if negative && magnitude == 0 {
        fail Syntax(start)
    }
    if negative { -magnitude } else { magnitude }
}

fn take_unix(mut c: Cursor) -> i64 ! fault.Fault {
    let negative = at_byte(c, '-')
    if negative {
        c.at += 1
    }
    let magnitude = take_digits(mut c, 18)?
    if negative { -magnitude } else { magnitude }
}

fn name_at(c: Cursor, name: str) -> bool {
    if c.at + name.len > c.s.len {
        return false
    }
    for i in 0..name.len {
        if text.lower_byte(c.s[c.at + i]) != text.lower_byte(name[i]) {
            return false
        }
    }
    true
}

fn take_name(mut c: Cursor, list: []str) -> i64 ! fault.Fault {
    var best = -1
    var size = 0
    for i, name in list {
        if name.len > size && name_at(c, name) {
            best = i
            size = name.len
        }
    }
    if best < 0 {
        fail Syntax(c.at)
    }
    c.at += size
    best
}

fn take_zone_name(mut c: Cursor) -> str ! fault.Fault {
    let start = c.at
    for at_letter(c) {
        c.at += 1
    }
    if c.at == start {
        fail Syntax(c.at)
    }
    c.s[start..c.at]
}

fn take_fraction(mut c: Cursor, s: Spec) -> i64 ! fault.Fault {
    let start = c.at
    let n = if s.arg == 0 { take_digits(mut c, 9)? } else { take_exact(mut c, s.arg)? }
    let digits = c.at - start
    var scale = 1
    for _ in digits..9 {
        scale *= 10
    }
    n * scale
}

fn take_offset(mut c: Cursor) -> i64 ! fault.Fault {
    if at_byte(c, 'Z') || at_byte(c, 'z') {
        c.at += 1
        return 0
    }
    if !at_byte(c, '+') && !at_byte(c, '-') {
        fail Syntax(c.at)
    }
    let sign = if c.s[c.at] == '-' { -1 } else { 1 }
    c.at += 1
    let hours = take_exact(mut c, 2)?
    var minutes = 0
    var seconds = 0
    if at_byte(c, ':') {
        c.at += 1
        minutes = take_exact(mut c, 2)?
        if at_byte(c, ':') {
            c.at += 1
            seconds = take_exact(mut c, 2)?
        }
    } else if at_digit(c) {
        minutes = take_exact(mut c, 2)?
        if at_digit(c) {
            seconds = take_exact(mut c, 2)?
        }
    }
    if hours > 25 || minutes > 59 || seconds > 59 {
        fail OutOfRange("offset")
    }
    sign * (hours * 3600 + minutes * 60 + seconds)
}

fn take_date_field(mut c: Cursor, mut f: Fields, s: Spec, n: Names) ! fault.Fault {
    match s.verb {
        == 'Y' => {
            let v = take_year(mut c)?
            f.year = merged(f.year, v)?
        }
        == 'G' => {
            let v = take_year(mut c)?
            f.iso_year = merged(f.iso_year, v)?
        }
        == 'y' => {
            let v = take_ranged(mut c, s, 0, 99, "year")?
            f.year_of_century = merged(f.year_of_century, v)?
        }
        == 'C' => {
            let v = take_ranged(mut c, s, 0, 99, "century")?
            f.century = merged(f.century, v)?
        }
        == 'm' => {
            let v = take_ranged(mut c, s, 1, 12, "month")?
            f.month = merged(f.month, v)?
        }
        == 'd' || == 'e' => {
            let v = take_ranged(mut c, s, 1, 31, "day")?
            f.day = merged(f.day, v)?
        }
        == 'j' => {
            let v = take_ranged(mut c, s, 1, 366, "day of year")?
            f.day_of_year = merged(f.day_of_year, v)?
        }
        == 'u' => {
            let v = take_ranged(mut c, s, 1, 7, "weekday")?
            f.weekday = merged(f.weekday, v)?
        }
        == 'w' => {
            let v = take_ranged(mut c, s, 0, 6, "weekday")?
            f.weekday = merged(f.weekday, if v == 0 { 7 } else { v })?
        }
        == 'U' => {
            let v = take_ranged(mut c, s, 0, 53, "week")?
            f.week_sunday = merged(f.week_sunday, v)?
        }
        == 'W' => {
            let v = take_ranged(mut c, s, 0, 53, "week")?
            f.week_monday = merged(f.week_monday, v)?
        }
        == 'V' => {
            let v = take_ranged(mut c, s, 1, 53, "week")?
            f.iso_week = merged(f.iso_week, v)?
        }
        == 'b' => {
            let v = take_name(mut c, n.short_months)?
            f.month = merged(f.month, v + 1)?
        }
        == 'B' => {
            let v = take_name(mut c, n.months)?
            f.month = merged(f.month, v + 1)?
        }
        == 'a' => {
            let v = take_name(mut c, n.short_weekdays)?
            f.weekday = merged(f.weekday, v + 1)?
        }
        _ => {
            let v = take_name(mut c, n.weekdays)?
            f.weekday = merged(f.weekday, v + 1)?
        }
    }
}

fn take_time_field(mut c: Cursor, mut f: Fields, s: Spec, n: Names) ! fault.Fault {
    match s.verb {
        == 'H' => {
            let v = take_ranged(mut c, s, 0, 23, "hour")?
            f.hour = merged(f.hour, v)?
        }
        == 'I' => {
            let v = take_ranged(mut c, s, 1, 12, "hour")?
            f.hour12 = merged(f.hour12, v)?
        }
        == 'M' => {
            let v = take_ranged(mut c, s, 0, 59, "minute")?
            f.minute = merged(f.minute, v)?
        }
        == 'S' => {
            let v = take_ranged(mut c, s, 0, 60, "second")?
            f.second = merged(f.second, if v == 60 { 59 } else { v })?
        }
        == 'f' => {
            let v = take_fraction(mut c, s)?
            f.nanosecond = merged(f.nanosecond, v)?
        }
        _ => {
            let v = take_name(mut c, [n.am, n.pm])?
            f.period = merged(f.period, v)?
        }
    }
}

fn take_field(mut c: Cursor, mut f: Fields, s: Spec, n: Names) ! fault.Fault {
    if is_date_verb(s.verb) {
        take_date_field(mut c, mut f, s, n)?
    } else if is_time_verb(s.verb) {
        take_time_field(mut c, mut f, s, n)?
    } else if s.verb == 'z' {
        let v = take_offset(mut c)?
        f.offset_seconds = merged(f.offset_seconds, v)?
    } else if s.verb == 'Z' {
        let v = take_zone_name(mut c)?
        let had = f.zone_abbreviation ?? v
        if had != v {
            fail Invalid("pattern fields conflict")
        }
        f.zone_abbreviation = v
    } else {
        let v = take_unix(mut c)?
        f.unix_seconds = merged(f.unix_seconds, v)?
    }
}

pub fn scan(p: Pattern, input: str, names: Names) -> Fields ! fault.Fault {
    check_names(names)?
    var c = Cursor { s: input, at: 0 }
    var f = Fields {}
    for item in p.items {
        match item {
            Text(t) => take_text(mut c, t)?
            Blank(count) => take_blanks(mut c, count)?
            Field(spec) => take_field(mut c, mut f, spec, names)?
        }
    }
    if c.at < input.len {
        fail Syntax(c.at)
    }
    f
}
