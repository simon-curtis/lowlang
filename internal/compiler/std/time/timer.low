import std/atomic
import std/time/duration

pub struct Timer {
    pub fired: chan[bool]
    armed: atomic.Int
    serial: atomic.Int
}

fn fire(fired: chan[bool], armed: atomic.Int, token: i64, millis: i64) {
    sleep(millis)
    if armed.compare_and_swap_int(token, 0) {
        select {
            fired <- true => {}
            else => {}
        }
    }
}

fn arm(t: Timer, d: duration.Duration) {
    let token = t.serial.add_int(1)
    t.armed.store_int(token)
    spawn fire(t.fired, t.armed, token, millis_up(d))
}

pub fn timer(d: duration.Duration) -> Timer {
    let t = Timer { fired: chan[bool](1), armed: atomic.int(0), serial: atomic.int(0) }
    arm(t, d)
    t
}

pub fn after(d: duration.Duration) -> chan[bool] {
    timer(d).fired
}

pub fn stop_timer(t: Timer) -> bool {
    var seen = t.armed.load_int()
    for seen != 0 {
        if t.armed.compare_and_swap_int(seen, 0) {
            return true
        }
        seen = t.armed.load_int()
    }
    false
}

pub fn reset_timer(t: Timer, d: duration.Duration) {
    stop_timer(t)
    select {
        <-t.fired => {}
        else => {}
    }
    arm(t, d)
}

pub struct Ticker {
    pub ticks: chan[bool]
    stopped: atomic.Flag
}

fn run_ticker(ticks: chan[bool], stopped: atomic.Flag, period: i64, begin: i64) {
    var next = begin
    for {
        next += period
        let wait = next - monotonic()
        if wait > 0 {
            sleep(ceil_millis(wait))
        }
        if stopped.is_set() {
            return
        }
        select {
            ticks <- true => {}
            else => {}
        }
        let late = monotonic() - next
        if late > period {
            next += late / period * period
        }
    }
}

pub fn ticker(d: duration.Duration) -> Ticker {
    let t = Ticker { ticks: chan[bool](1), stopped: atomic.flag() }
    let nanos = nanos_of(d)
    let period = if nanos < 1000000 { 1000000 } else { nanos }
    spawn run_ticker(t.ticks, t.stopped, period, monotonic())
    t
}

pub fn stop_ticker(t: Ticker) {
    t.stopped.set()
}
