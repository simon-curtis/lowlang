import std/text
import std/time/date
import std/time/datetime
import std/time/fault
import std/time/offset
import std/time/zone

pub enum OffsetPolicy {
    Reject
    PreferOffset
    PreferZone
    UseZone
}

enum Marker {
    Absent
    Designator
    Numeric(shift: offset.Offset)
}

struct Head {
    civil: datetime.DateTime
    marker: Marker
    tail: i64
}

struct Notes {
    name: str?
    name_at: i64
    at: i64
    keyed: bool
    calendars: i64
    critical_calendar: bool
}

fn pad(n: i64, width: i64) -> str {
    text.pad_left("{n}", width, '0')
}

fn is_utc_zone(z: Zoned) -> bool {
    zone.is_fixed(z.tz) && zone.name(z.tz) == "UTC"
}

fn is_bare_offset(z: Zoned) -> bool {
    zone.is_fixed(z.tz) && zone.name(z.tz) == offset.to_string(z.shift)
}

pub fn to_rfc3339(z: Zoned) -> str {
    let civil = datetime.to_string(z.civil)
    if is_utc_zone(z) {
        return "{civil}Z"
    }
    "{civil}{offset.to_string(z.shift)}"
}

pub fn to_string(z: Zoned) -> str {
    let rfc = to_rfc3339(z)
    if is_utc_zone(z) {
        return "{rfc}[UTC]"
    }
    if is_bare_offset(z) {
        return rfc
    }
    "{rfc}[{zone.name(z.tz)}]"
}

fn rfc2822_offset(o: offset.Offset) -> str {
    let secs = offset.seconds_of(o)
    let sign = if secs < 0 { "-" } else { "+" }
    let magnitude = if secs < 0 { -secs } else { secs }
    "{sign}{pad(magnitude / 3600, 2)}{pad(magnitude % 3600 / 60, 2)}"
}

pub fn to_rfc2822(z: Zoned) -> str {
    let weekday = date.weekday_short_name(datetime.weekday(z.civil))
    let month = date.month_short_name(datetime.month(z.civil))
    let day_text = "{weekday}, {pad(day(z), 2)} {month} {pad(year(z), 4)}"
    let clock = "{pad(hour(z), 2)}:{pad(minute(z), 2)}:{pad(second(z), 2)}"
    "{day_text} {clock} {rfc2822_offset(z.shift)}"
}

fn is_separator(c: u8) -> bool {
    c == 'T' || c == 't' || c == ' '
}

fn is_offset_start(c: u8) -> bool {
    c == 'Z' || c == 'z' || c == '+' || c == '-' || c == '['
}

fn civil_end(s: str) -> i64 ! fault.Fault {
    var sep = 0
    for sep < s.len && !is_separator(s[sep]) {
        sep += 1
    }
    if sep >= s.len {
        fail Syntax(s.len)
    }
    var at = sep + 1
    for at < s.len && !is_offset_start(s[at]) {
        at += 1
    }
    at
}

fn shifted(e: fault.Fault, by: i64) -> fault.Fault {
    match e {
        Syntax(at) => fault.Fault.Syntax(at + by)
        _ => e
    }
}

fn read_marker(s: str, from: i64) -> Head ! fault.Fault {
    let civil = datetime.parse(s[..from])?
    var stop = from
    for stop < s.len && s[stop] != '[' {
        stop += 1
    }
    let token = s[from..stop]
    if token.len == 0 {
        return Head { civil, marker: Marker.Absent, tail: stop }
    }
    if token == "Z" || token == "z" {
        return Head { civil, marker: Marker.Designator, tail: stop }
    }
    let shift = offset.parse(token) catch {
        e => fail shifted(e, from)
    }
    Head { civil, marker: Marker.Numeric(shift), tail: stop }
}

fn is_key_byte(c: u8) -> bool {
    c >= 'a' && c <= 'z' || c >= '0' && c <= '9' || c == '-' || c == '_'
}

fn check_key(key: str, at: i64) ! fault.Fault {
    if key.len == 0 || !(key[0] >= 'a' && key[0] <= 'z' || key[0] == '_') {
        fail Syntax(at)
    }
    for i in 0..key.len {
        if !is_key_byte(key[i]) {
            fail Syntax(at + i)
        }
    }
}

fn read_key_note(mut notes: Notes, key: str, value: str, critical: bool, at: i64) ! fault.Fault {
    check_key(key, at)?
    notes.keyed = true
    if value.len == 0 {
        fail Syntax(at + key.len + 1)
    }
    if key == "u-ca" {
        if !text.equal_fold(value, "iso8601") {
            fail Unsupported("calendar {value}")
        }
        notes.calendars += 1
        if critical {
            notes.critical_calendar = true
        }
        return
    }
    if critical {
        fail Unsupported("annotation {key}")
    }
}

fn read_zone_note(mut notes: Notes, content: str, open: i64, content_at: i64) ! fault.Fault {
    if notes.name != none || notes.keyed {
        fail Syntax(open)
    }
    notes.name = content
    notes.name_at = content_at
}

fn read_note(s: str, mut notes: Notes) ! fault.Fault {
    let open = notes.at
    if s[open] != '[' {
        fail Syntax(open)
    }
    let close = text.index_byte(s[open..], ']')
    if close < 0 {
        fail Syntax(s.len)
    }
    let end = open + close
    var body_at = open + 1
    var critical = false
    if body_at < end && s[body_at] == '!' {
        critical = true
        body_at += 1
    }
    let content = s[body_at..end]
    if content.len == 0 {
        fail Syntax(body_at)
    }
    let eq = text.index_byte(content, '=')
    if eq < 0 {
        read_zone_note(mut notes, content, open, body_at)?
    } else {
        read_key_note(mut notes, content[..eq], content[eq + 1..], critical, body_at)?
    }
    notes.at = end + 1
}

fn read_notes(s: str, from: i64) -> Notes ! fault.Fault {
    var notes = Notes { name: none, name_at: 0, at: from, keyed: false, calendars: 0, critical_calendar: false }
    for notes.at < s.len {
        read_note(s, mut notes)?
    }
    if notes.calendars > 1 && notes.critical_calendar {
        fail Invalid("calendar annotations")
    }
    notes
}

fn note_zone(name: str, at: i64, loader: fn(str) -> zone.Zone ! fault.Fault) -> zone.Zone ! fault.Fault {
    if name[0] == '+' || name[0] == '-' {
        let shift = offset.parse(name) catch {
            e => fail shifted(e, at)
        }
        return zone.fixed(shift)
    }
    loader(name)?
}

fn offset_valid(c: zone.Candidates, written: offset.Offset) -> bool {
    match c {
        One(only) => only == written
        Overlap(earlier, later) => earlier == written || later == written
        Gap(before, after) => false
    }
}

fn from_written(dt: datetime.DateTime, tz: zone.Zone, written: offset.Offset) -> Zoned ! fault.Fault {
    let ts = instant_at(dt, written)?
    of(ts, tz)?
}

fn with_offset(dt: datetime.DateTime, tz: zone.Zone, written: offset.Offset, policy: OffsetPolicy) -> Zoned ! fault.Fault {
    let candidates = zone.candidates(tz, datetime.civil_seconds(dt))
    if offset_valid(candidates, written) {
        return from_written(dt, tz, written)?
    }
    match policy {
        Reject => fail OffsetConflict
        PreferZone => from_written(dt, tz, written)?
        _ => from_civil(dt, tz, Disambiguation.Compatible)?
    }
}

fn with_zone(head: Head, tz: zone.Zone, policy: OffsetPolicy) -> Zoned ! fault.Fault {
    match head.marker {
        Absent => from_civil(head.civil, tz, Disambiguation.Compatible)?
        Designator => from_written(head.civil, tz, offset.utc())?
        Numeric(shift) => with_offset(head.civil, tz, shift, policy)?
    }
}

fn without_zone(head: Head, length: i64) -> Zoned ! fault.Fault {
    match head.marker {
        Absent => fail Syntax(length)
        Designator => from_written(head.civil, zone.utc(), offset.utc())?
        Numeric(shift) => from_written(head.civil, zone.fixed(shift), shift)?
    }
}

pub fn parse_using_options(s: str, policy: OffsetPolicy, loader: fn(str) -> zone.Zone ! fault.Fault) -> Zoned ! fault.Fault {
    let end = civil_end(s)?
    let head = read_marker(s, end)?
    let notes = read_notes(s, head.tail)?
    let name = notes.name ?? return without_zone(head, s.len)?
    let tz = note_zone(name, notes.name_at, loader)?
    with_zone(head, tz, policy)?
}

pub fn parse_using(s: str, loader: fn(str) -> zone.Zone ! fault.Fault) -> Zoned ! fault.Fault {
    parse_using_options(s, OffsetPolicy.Reject, loader)?
}

pub fn parse_with_options(s: str, policy: OffsetPolicy) -> Zoned ! fault.Fault {
    parse_using_options(s, policy, zone.named)?
}

pub fn parse(s: str) -> Zoned ! fault.Fault {
    parse_using_options(s, OffsetPolicy.Reject, zone.named)?
}
