import std/time/clock
import std/time/date
import std/time/datetime
import std/time/duration
import std/time/fault
import std/time/offset
import std/time/span
import std/time/timeofday
import std/time/timestamp
import std/time/zone

pub enum Disambiguation {
    Compatible
    Earlier
    Later
    Reject
}

pub struct Zoned {
    ts: timestamp.Timestamp
    tz: zone.Zone
    shift: offset.Offset
    civil: datetime.DateTime
}

fn series_limit() -> i64 {
    1000000
}

fn civil_of(ts: timestamp.Timestamp, shift: offset.Offset) -> datetime.DateTime ! fault.Fault {
    let secs = timestamp.unix_seconds(ts) + offset.seconds_of(shift)
    datetime.from_civil_seconds(secs, timestamp.subsec_nanos(ts))?
}

pub fn of(ts: timestamp.Timestamp, tz: zone.Zone) -> Zoned ! fault.Fault {
    let shift = zone.offset_at(tz, ts)
    let civil = civil_of(ts, shift)?
    Zoned { ts, tz, shift, civil }
}

pub fn now(tz: zone.Zone) -> Zoned ! fault.Fault {
    of(timestamp.now(), tz)?
}

pub fn now_in(c: clock.Clock, tz: zone.Zone) -> Zoned ! fault.Fault {
    let ts = clock.now(c)
    of(ts, tz)?
}

fn pick(c: zone.Candidates, how: Disambiguation) -> offset.Offset ! fault.Fault {
    match c {
        One(only) => only
        Overlap(earlier, later) => match how {
            Later => later
            Reject => fail Ambiguous
            _ => earlier
        }
        Gap(before, after) => match how {
            Earlier => after
            Reject => fail Skipped
            _ => before
        }
    }
}

fn instant_at(dt: datetime.DateTime, o: offset.Offset) -> timestamp.Timestamp ! fault.Fault {
    let secs = datetime.civil_seconds(dt) - offset.seconds_of(o)
    timestamp.from_parts(secs, timeofday.nanosecond(datetime.time(dt)))?
}

fn instant_for(tz: zone.Zone, dt: datetime.DateTime, how: Disambiguation) -> timestamp.Timestamp ! fault.Fault {
    let candidates = zone.candidates(tz, datetime.civil_seconds(dt))
    let chosen = pick(candidates, how)?
    instant_at(dt, chosen)?
}

fn instant_preferring(tz: zone.Zone, dt: datetime.DateTime, preferred: offset.Offset) -> timestamp.Timestamp ! fault.Fault {
    let candidates = zone.candidates(tz, datetime.civil_seconds(dt))
    let chosen = match candidates {
        One(only) => only
        Overlap(earlier, later) => if preferred == later { later } else { earlier }
        Gap(before, after) => before
    }
    instant_at(dt, chosen)?
}

pub fn from_civil(dt: datetime.DateTime, tz: zone.Zone, how: Disambiguation) -> Zoned ! fault.Fault {
    let ts = instant_for(tz, dt, how)?
    of(ts, tz)?
}

pub fn strict(dt: datetime.DateTime, tz: zone.Zone) -> Zoned ! fault.Fault {
    from_civil(dt, tz, Disambiguation.Reject)?
}

pub fn from_parts(d: date.Date, t: timeofday.TimeOfDay, tz: zone.Zone, how: Disambiguation) -> Zoned ! fault.Fault {
    let dt = datetime.from_parts(d, t)
    from_civil(dt, tz, how)?
}

pub fn timestamp(z: Zoned) -> timestamp.Timestamp {
    z.ts
}

pub fn zone(z: Zoned) -> zone.Zone {
    z.tz
}

pub fn offset(z: Zoned) -> offset.Offset {
    z.shift
}

pub fn datetime(z: Zoned) -> datetime.DateTime {
    z.civil
}

pub fn date(z: Zoned) -> date.Date {
    datetime.date(z.civil)
}

pub fn time(z: Zoned) -> timeofday.TimeOfDay {
    datetime.time(z.civil)
}

pub fn year(z: Zoned) -> i64 {
    datetime.year(z.civil)
}

pub fn month(z: Zoned) -> date.Month {
    datetime.month(z.civil)
}

pub fn month_number(z: Zoned) -> i64 {
    datetime.month_number(z.civil)
}

pub fn day(z: Zoned) -> i64 {
    datetime.day(z.civil)
}

pub fn weekday(z: Zoned) -> date.Weekday {
    datetime.weekday(z.civil)
}

pub fn day_of_year(z: Zoned) -> i64 {
    datetime.day_of_year(z.civil)
}

pub fn hour(z: Zoned) -> i64 {
    datetime.hour(z.civil)
}

pub fn minute(z: Zoned) -> i64 {
    datetime.minute(z.civil)
}

pub fn second(z: Zoned) -> i64 {
    datetime.second(z.civil)
}

pub fn nanosecond(z: Zoned) -> i64 {
    datetime.nanosecond(z.civil)
}

pub fn info(z: Zoned) -> zone.Info {
    zone.info_at(z.tz, z.ts)
}

pub fn abbreviation(z: Zoned) -> str {
    info(z).abbreviation
}

pub fn is_dst(z: Zoned) -> bool {
    info(z).dst
}

pub fn in_zone(z: Zoned, other: zone.Zone) -> Zoned ! fault.Fault {
    of(z.ts, other)?
}

pub fn with_date(z: Zoned, d: date.Date, how: Disambiguation) -> Zoned ! fault.Fault {
    from_civil(datetime.with_date(z.civil, d), z.tz, how)?
}

pub fn with_time(z: Zoned, t: timeofday.TimeOfDay, how: Disambiguation) -> Zoned ! fault.Fault {
    from_civil(datetime.with_time(z.civil, t), z.tz, how)?
}

pub fn with_datetime(z: Zoned, dt: datetime.DateTime, how: Disambiguation) -> Zoned ! fault.Fault {
    from_civil(dt, z.tz, how)?
}

fn gap_start(tz: zone.Zone, midnight: i64, before: offset.Offset, after: offset.Offset) -> timestamp.Timestamp ! fault.Fault {
    let probe = timestamp.from_unix(midnight - offset.seconds_of(after))?
    match zone.next_transition(tz, probe) {
        some(t) => t.at
        none => timestamp.from_unix(midnight - offset.seconds_of(before))?
    }
}

fn day_start(tz: zone.Zone, d: date.Date) -> timestamp.Timestamp ! fault.Fault {
    let midnight = date.epoch_days(d) * 86400
    match zone.candidates(tz, midnight) {
        One(only) => timestamp.from_unix(midnight - offset.seconds_of(only))?
        Overlap(earlier, later) => timestamp.from_unix(midnight - offset.seconds_of(earlier))?
        Gap(before, after) => gap_start(tz, midnight, before, after)?
    }
}

fn day_end(tz: zone.Zone, d: date.Date) -> timestamp.Timestamp ! fault.Fault {
    let next = date.plus_days(d, 1) catch {
        e => return instant_for(tz, datetime.end_of_day(d), Disambiguation.Later)?
    }
    let upcoming = day_start(tz, next)?
    timestamp.minus(upcoming, duration.nanoseconds(1))?
}

pub fn start_of_day(z: Zoned) -> Zoned ! fault.Fault {
    let ts = day_start(z.tz, date(z))?
    of(ts, z.tz)?
}

pub fn end_of_day(z: Zoned) -> Zoned ! fault.Fault {
    let ts = day_end(z.tz, date(z))?
    of(ts, z.tz)?
}

pub fn hours_in_day(z: Zoned) -> duration.Duration ! fault.Fault {
    let first = day_start(z.tz, date(z))?
    let last = day_end(z.tz, date(z))?
    duration.plus(timestamp.until(first, last), duration.nanoseconds(1))
}

pub fn next_transition(z: Zoned) -> zone.Transition? {
    zone.next_transition(z.tz, z.ts)
}

pub fn previous_transition(z: Zoned) -> zone.Transition? {
    zone.previous_transition(z.tz, z.ts)
}

pub fn plus_duration(z: Zoned, d: duration.Duration) -> Zoned ! fault.Fault {
    let moved = timestamp.plus(z.ts, d)?
    of(moved, z.tz)?
}

pub fn minus_duration(z: Zoned, d: duration.Duration) -> Zoned ! fault.Fault {
    plus_duration(z, duration.negate(d))?
}

pub fn plus(z: Zoned, s: span.Span, how: Disambiguation) -> Zoned ! fault.Fault {
    let calendar = span.calendar_part(s)
    var moved = z
    if span.has_calendar_units(calendar) {
        let day_moved = date.plus(date(z), calendar)?
        moved = with_date(z, day_moved, how)?
    }
    plus_duration(moved, span.time_duration(s))?
}

pub fn minus(z: Zoned, s: span.Span, how: Disambiguation) -> Zoned ! fault.Fault {
    plus(z, span.negate(s), how)?
}

pub fn series(start: Zoned, step: span.Span, count: i64, how: Disambiguation) -> []Zoned ! fault.Fault {
    if count < 0 {
        fail Invalid("series count")
    }
    if count > series_limit() {
        fail OutOfRange("series count")
    }
    var out: []Zoned = []
    var offset_by = span.zero()
    for _ in 0..count {
        let item = plus(start, offset_by, how)?
        push(mut out, item)
        offset_by = span.plus(offset_by, step)?
    }
    out
}

pub fn duration_until(a: Zoned, b: Zoned) -> duration.Duration {
    timestamp.until(a.ts, b.ts)
}

pub fn compare(a: Zoned, b: Zoned) -> i64 {
    timestamp.compare(a.ts, b.ts)
}

pub fn equal(a: Zoned, b: Zoned) -> bool {
    timestamp.equal(a.ts, b.ts)
}

pub fn before(a: Zoned, b: Zoned) -> bool {
    timestamp.before(a.ts, b.ts)
}

pub fn after(a: Zoned, b: Zoned) -> bool {
    timestamp.after(a.ts, b.ts)
}

pub fn min(a: Zoned, b: Zoned) -> Zoned {
    if compare(b, a) < 0 { b } else { a }
}

pub fn max(a: Zoned, b: Zoned) -> Zoned {
    if compare(b, a) > 0 { b } else { a }
}

pub fn same_instant_and_zone(a: Zoned, b: Zoned) -> bool {
    timestamp.equal(a.ts, b.ts) && zone.name(a.tz) == zone.name(b.tz)
}
