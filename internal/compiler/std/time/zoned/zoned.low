import std/time/clock
import std/time/date
import std/time/datetime
import std/time/duration
import std/time/fault
import std/time/offset
import std/time/span
import std/time/timeofday
import std/time/timestamp
import std/time/zone

/// How a local date-time that a zone's daylight saving change makes ambiguous or nonexistent is turned into an instant.
///
/// A local time occurs twice when the clocks go back, an overlap, and not at all when they go forward, a gap.
pub enum Disambiguation {
    /// Takes the first occurrence in an overlap and, in a gap, moves the time forward by the length of the gap. A local `02:30` that does not exist becomes `03:30`.
    Compatible
    /// Takes the first occurrence in an overlap and, in a gap, moves the time back by the length of the gap. A local `02:30` that does not exist becomes `01:30`.
    Earlier
    /// Takes the second occurrence in an overlap and, in a gap, moves the time forward as `Compatible` does.
    Later
    /// Fails with `Ambiguous` in an overlap and with `Skipped` in a gap.
    Reject
}

/// An instant in a time zone: the moment, the zone, and the local date-time and offset the zone has at that moment.
///
/// It is the type for human-facing times. Arithmetic on the calendar fields follows the zone's wall clock, so adding a day keeps the local time across a daylight saving change, while adding a duration adds exact elapsed time. Comparison looks at the instant only. Copies share the zone's rules.
pub struct Zoned {
    ts: timestamp.Timestamp
    tz: zone.Zone
    shift: offset.Offset
    civil: datetime.DateTime
}

fn series_limit() -> i64 {
    1000000
}

fn civil_of(ts: timestamp.Timestamp, shift: offset.Offset) -> datetime.DateTime ! fault.Fault {
    let secs = timestamp.unix_seconds(ts) + offset.seconds_of(shift)
    datetime.from_civil_seconds(secs, timestamp.subsec_nanos(ts))?
}

/// Returns the instant `ts` seen in the zone `tz`.
///
/// Fails with `OutOfRange` when the local date-time in the zone falls outside the supported years.
pub fn of(ts: timestamp.Timestamp, tz: zone.Zone) -> Zoned ! fault.Fault {
    let shift = zone.offset_at(tz, ts)
    let civil = civil_of(ts, shift)?
    Zoned { ts, tz, shift, civil }
}

/// Returns the current time in the zone `tz`.
///
/// Fails with `OutOfRange` as `of` does.
pub fn now(tz: zone.Zone) -> Zoned ! fault.Fault {
    of(timestamp.now(), tz)?
}

/// Returns the time shown by the clock `c` in the zone `tz`.
///
/// Fails with `OutOfRange` as `of` does.
pub fn now_in(c: clock.Clock, tz: zone.Zone) -> Zoned ! fault.Fault {
    let ts = clock.now(c)
    of(ts, tz)?
}

fn pick(c: zone.Candidates, how: Disambiguation) -> offset.Offset ! fault.Fault {
    match c {
        One(only) => only
        Overlap(earlier, later) => match how {
            Later => later
            Reject => fail Ambiguous
            _ => earlier
        }
        Gap(before, after) => match how {
            Earlier => after
            Reject => fail Skipped
            _ => before
        }
    }
}

fn instant_at(dt: datetime.DateTime, o: offset.Offset) -> timestamp.Timestamp ! fault.Fault {
    let secs = datetime.civil_seconds(dt) - offset.seconds_of(o)
    timestamp.from_parts(secs, timeofday.nanosecond(datetime.time(dt)))?
}

fn instant_for(tz: zone.Zone, dt: datetime.DateTime, how: Disambiguation) -> timestamp.Timestamp ! fault.Fault {
    let candidates = zone.candidates(tz, datetime.civil_seconds(dt))
    let chosen = pick(candidates, how)?
    instant_at(dt, chosen)?
}

fn instant_preferring(tz: zone.Zone, dt: datetime.DateTime, preferred: offset.Offset) -> timestamp.Timestamp ! fault.Fault {
    let candidates = zone.candidates(tz, datetime.civil_seconds(dt))
    let chosen = match candidates {
        One(only) => only
        Overlap(earlier, later) => if preferred == later { later } else { earlier }
        Gap(before, after) => before
    }
    instant_at(dt, chosen)?
}

/// Returns the instant at which the zone `tz` shows the local date-time `dt`, with `how` deciding what happens in an overlap or a gap.
///
/// Fails with `Ambiguous` or `Skipped` when `how` is `Reject` and the time is an overlap or a gap, and with `OutOfRange` when the instant is outside the supported years.
pub fn from_civil(dt: datetime.DateTime, tz: zone.Zone, how: Disambiguation) -> Zoned ! fault.Fault {
    let ts = instant_for(tz, dt, how)?
    of(ts, tz)?
}

/// Returns the instant at which the zone `tz` shows `dt`, failing when `dt` is not exactly one instant.
///
/// It is `from_civil` with `Reject`.
pub fn strict(dt: datetime.DateTime, tz: zone.Zone) -> Zoned ! fault.Fault {
    from_civil(dt, tz, Disambiguation.Reject)?
}

/// Returns the instant at which the zone `tz` shows the date `d` and the time of day `t`, with `how` deciding what happens in an overlap or a gap.
///
/// Fails as `from_civil` does.
pub fn from_parts(d: date.Date, t: timeofday.TimeOfDay, tz: zone.Zone, how: Disambiguation) -> Zoned ! fault.Fault {
    let dt = datetime.from_parts(d, t)
    from_civil(dt, tz, how)?
}

/// Returns the instant of `z`.
pub fn timestamp(z: Zoned) -> timestamp.Timestamp {
    z.ts
}

/// Returns the zone of `z`.
pub fn zone(z: Zoned) -> zone.Zone {
    z.tz
}

/// Returns the UTC offset of `z` at its instant.
pub fn offset(z: Zoned) -> offset.Offset {
    z.shift
}

/// Returns the local date and time of `z`.
pub fn datetime(z: Zoned) -> datetime.DateTime {
    z.civil
}

/// Returns the local date of `z`.
pub fn date(z: Zoned) -> date.Date {
    datetime.date(z.civil)
}

/// Returns the local time of day of `z`.
pub fn time(z: Zoned) -> timeofday.TimeOfDay {
    datetime.time(z.civil)
}

/// Returns the local year of `z`.
pub fn year(z: Zoned) -> i64 {
    datetime.year(z.civil)
}

/// Returns the local month of `z`.
pub fn month(z: Zoned) -> date.Month {
    datetime.month(z.civil)
}

/// Returns the local month of `z` as a number from `1` to `12`.
pub fn month_number(z: Zoned) -> i64 {
    datetime.month_number(z.civil)
}

/// Returns the local day of the month of `z`.
pub fn day(z: Zoned) -> i64 {
    datetime.day(z.civil)
}

/// Returns the local day of the week of `z`.
pub fn weekday(z: Zoned) -> date.Weekday {
    datetime.weekday(z.civil)
}

/// Returns the local day of the year of `z`, from `1`.
pub fn day_of_year(z: Zoned) -> i64 {
    datetime.day_of_year(z.civil)
}

/// Returns the local hour of `z`, from `0` to `23`.
pub fn hour(z: Zoned) -> i64 {
    datetime.hour(z.civil)
}

/// Returns the local minute of `z`, from `0` to `59`.
pub fn minute(z: Zoned) -> i64 {
    datetime.minute(z.civil)
}

/// Returns the local second of `z`, from `0` to `59`.
pub fn second(z: Zoned) -> i64 {
    datetime.second(z.civil)
}

/// Returns the local nanosecond within the second of `z`.
pub fn nanosecond(z: Zoned) -> i64 {
    datetime.nanosecond(z.civil)
}

/// Returns the offset, abbreviation and daylight saving flag of the zone at the instant of `z`.
pub fn info(z: Zoned) -> zone.Info {
    zone.info_at(z.tz, z.ts)
}

/// Returns the zone abbreviation at the instant of `z`, such as `CEST`.
pub fn abbreviation(z: Zoned) -> str {
    info(z).abbreviation
}

/// Returns whether daylight saving time is in effect at the instant of `z`.
pub fn is_dst(z: Zoned) -> bool {
    info(z).dst
}

/// Returns the same instant of `z` shown in the zone `other`.
///
/// Fails with `OutOfRange` when the local date-time in `other` falls outside the supported years.
pub fn in_zone(z: Zoned, other: zone.Zone) -> Zoned ! fault.Fault {
    of(z.ts, other)?
}

/// Returns `z` with its local date replaced by `d` and its local time of day kept, with `how` deciding what happens in an overlap or a gap.
///
/// The instant changes. Fails as `from_civil` does.
pub fn with_date(z: Zoned, d: date.Date, how: Disambiguation) -> Zoned ! fault.Fault {
    from_civil(datetime.with_date(z.civil, d), z.tz, how)?
}

/// Returns `z` with its local time of day replaced by `t` and its local date kept, with `how` deciding what happens in an overlap or a gap.
///
/// The instant changes. Fails as `from_civil` does.
pub fn with_time(z: Zoned, t: timeofday.TimeOfDay, how: Disambiguation) -> Zoned ! fault.Fault {
    from_civil(datetime.with_time(z.civil, t), z.tz, how)?
}

/// Returns the instant at which the zone of `z` shows `dt`, with `how` deciding what happens in an overlap or a gap.
///
/// Fails as `from_civil` does.
pub fn with_datetime(z: Zoned, dt: datetime.DateTime, how: Disambiguation) -> Zoned ! fault.Fault {
    from_civil(dt, z.tz, how)?
}

fn gap_start(tz: zone.Zone, midnight: i64, before: offset.Offset, after: offset.Offset) -> timestamp.Timestamp ! fault.Fault {
    let probe = timestamp.from_unix(midnight - offset.seconds_of(after))?
    match zone.next_transition(tz, probe) {
        some(t) => t.at
        none => timestamp.from_unix(midnight - offset.seconds_of(before))?
    }
}

fn day_start(tz: zone.Zone, d: date.Date) -> timestamp.Timestamp ! fault.Fault {
    let midnight = date.epoch_days(d) * 86400
    match zone.candidates(tz, midnight) {
        One(only) => timestamp.from_unix(midnight - offset.seconds_of(only))?
        Overlap(earlier, later) => timestamp.from_unix(midnight - offset.seconds_of(earlier))?
        Gap(before, after) => gap_start(tz, midnight, before, after)?
    }
}

fn day_end(tz: zone.Zone, d: date.Date) -> timestamp.Timestamp ! fault.Fault {
    let next = date.plus_days(d, 1) catch {
        e => return instant_for(tz, datetime.end_of_day(d), Disambiguation.Later)?
    }
    let upcoming = day_start(tz, next)?
    timestamp.minus(upcoming, duration.nanoseconds(1))?
}

/// Returns the first instant of the local date of `z`.
///
/// It is usually midnight, but when a gap skips midnight it is the first instant after the gap. Fails with `OutOfRange` when that instant is outside the supported years.
pub fn start_of_day(z: Zoned) -> Zoned ! fault.Fault {
    let ts = day_start(z.tz, date(z))?
    of(ts, z.tz)?
}

/// Returns the last nanosecond of the local date of `z`, one nanosecond before the start of the next day.
///
/// Fails with `OutOfRange` when that instant is outside the supported years.
pub fn end_of_day(z: Zoned) -> Zoned ! fault.Fault {
    let ts = day_end(z.tz, date(z))?
    of(ts, z.tz)?
}

/// Returns the length of the local date of `z` as a duration.
///
/// It is 24 hours except on a day that a daylight saving change shortens or lengthens.
pub fn hours_in_day(z: Zoned) -> duration.Duration ! fault.Fault {
    let first = day_start(z.tz, date(z))?
    let last = day_end(z.tz, date(z))?
    duration.plus(timestamp.until(first, last), duration.nanoseconds(1))
}

/// Returns the zone's next change of offset after the instant of `z`, or `none` when there is none.
pub fn next_transition(z: Zoned) -> zone.Transition? {
    zone.next_transition(z.tz, z.ts)
}

/// Returns the zone's latest change of offset before the instant of `z`, or `none` when there is none.
pub fn previous_transition(z: Zoned) -> zone.Transition? {
    zone.previous_transition(z.tz, z.ts)
}

/// Returns the instant `d` of elapsed time after `z`, in the same zone.
///
/// The local time can jump across a daylight saving change. Fails with `Overflow` when the result is outside the supported years.
pub fn plus_duration(z: Zoned, d: duration.Duration) -> Zoned ! fault.Fault {
    let moved = timestamp.plus(z.ts, d)?
    of(moved, z.tz)?
}

/// Returns the instant `d` of elapsed time before `z`, in the same zone.
///
/// Fails as `plus_duration` does.
pub fn minus_duration(z: Zoned, d: duration.Duration) -> Zoned ! fault.Fault {
    plus_duration(z, duration.negate(d))?
}

/// Returns `z` moved forward by the span `s`.
///
/// The years, months, weeks and days move the local date as `date.plus` does and keep the local time, with `how` deciding what happens when that time is an overlap or a gap. The time units are then added as exact elapsed time. A negative span moves backwards. Fails with `Ambiguous` or `Skipped` when `how` is `Reject`, with `Overflow` or `OutOfRange` when the result is outside the supported years.
pub fn plus(z: Zoned, s: span.Span, how: Disambiguation) -> Zoned ! fault.Fault {
    let calendar = span.calendar_part(s)
    var moved = z
    if span.has_calendar_units(calendar) {
        let day_moved = date.plus(date(z), calendar)?
        moved = with_date(z, day_moved, how)?
    }
    plus_duration(moved, span.time_duration(s))?
}

/// Returns `z` moved back by the span `s`.
///
/// Fails as `plus` does.
pub fn minus(z: Zoned, s: span.Span, how: Disambiguation) -> Zoned ! fault.Fault {
    plus(z, span.negate(s), how)?
}

/// Returns `count` instants starting at `start`, each one `step` after the one before, with `how` deciding what happens in an overlap or a gap.
///
/// Item `k` is `start` plus `k` steps in one move, so a month-end clamp in one item does not carry into the next. Fails with `Invalid` when `count` is negative, with `OutOfRange` when it is above a million, and otherwise as `plus` does.
pub fn series(start: Zoned, step: span.Span, count: i64, how: Disambiguation) -> []Zoned ! fault.Fault {
    if count < 0 {
        fail Invalid("series count")
    }
    if count > series_limit() {
        fail OutOfRange("series count")
    }
    var out: []Zoned = []
    var offset_by = span.zero()
    for _ in 0..count {
        let item = plus(start, offset_by, how)?
        push(mut out, item)
        offset_by = span.plus(offset_by, step)?
    }
    out
}

/// Returns the exact elapsed time from `a` to `b`, which is negative when `b` is earlier.
pub fn duration_until(a: Zoned, b: Zoned) -> duration.Duration {
    timestamp.until(a.ts, b.ts)
}

/// Returns `-1`, `0` or `1` as the instant of `a` is earlier than, the same as or later than that of `b`.
///
/// The zones are ignored.
pub fn compare(a: Zoned, b: Zoned) -> i64 {
    timestamp.compare(a.ts, b.ts)
}

/// Returns whether `a` and `b` are the same instant, whatever their zones.
pub fn equal(a: Zoned, b: Zoned) -> bool {
    timestamp.equal(a.ts, b.ts)
}

/// Returns whether the instant of `a` is earlier than that of `b`.
pub fn before(a: Zoned, b: Zoned) -> bool {
    timestamp.before(a.ts, b.ts)
}

/// Returns whether the instant of `a` is later than that of `b`.
pub fn after(a: Zoned, b: Zoned) -> bool {
    timestamp.after(a.ts, b.ts)
}

/// Returns the earlier of the two, or `a` when they are the same instant.
pub fn min(a: Zoned, b: Zoned) -> Zoned {
    if compare(b, a) < 0 { b } else { a }
}

/// Returns the later of the two, or `a` when they are the same instant.
pub fn max(a: Zoned, b: Zoned) -> Zoned {
    if compare(b, a) > 0 { b } else { a }
}

/// Returns whether `a` and `b` are the same instant in zones with the same name.
pub fn same_instant_and_zone(a: Zoned, b: Zoned) -> bool {
    timestamp.equal(a.ts, b.ts) && zone.name(a.tz) == zone.name(b.tz)
}
