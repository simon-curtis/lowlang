import std/time/date
import std/time/datetime
import std/time/fault
import std/time/offset
import std/time/pattern
import std/time/timeofday
import std/time/timestamp
import std/time/zone

/// Returns the local date and time, the offset, the zone abbreviation and the Unix seconds of `z` as pattern `Fields`.
pub fn to_fields(z: Zoned) -> pattern.Fields {
    var f = datetime.to_fields(z.civil)
    f.offset_seconds = offset.seconds_of(z.shift)
    f.zone_abbreviation = abbreviation(z)
    f.unix_seconds = timestamp.unix_seconds(z.ts)
    f
}

/// Returns `z` printed through the compiled pattern `p` with the month, weekday and period words of `names`.
///
/// All verbs are available, including `%z`, `%Z` and `%s`.
pub fn format_names(z: Zoned, p: pattern.Pattern, names: pattern.Names) -> str ! fault.Fault {
    pattern.render(p, to_fields(z), names)?
}

/// Returns `z` printed through the compiled pattern `p` with English names.
///
/// Fails as `format_names` does.
pub fn format_with(z: Zoned, p: pattern.Pattern) -> str ! fault.Fault {
    format_names(z, p, pattern.english())?
}

/// Returns `z` printed through the layout `layout`, such as `%Y-%m-%d %H:%M %Z`.
///
/// Fails with `Syntax` or `Unsupported` for a bad layout, as `pattern.compile` does.
pub fn format(z: Zoned, layout: str) -> str ! fault.Fault {
    let p = pattern.compile(layout)?
    format_with(z, p)?
}

fn has_clock(f: pattern.Fields) -> bool {
    f.hour != none || f.hour12 != none
}

fn check_clock(f: pattern.Fields, z: Zoned) ! fault.Fault {
    if !has_clock(f) {
        return
    }
    let w = pattern.wall(f)?
    let t = timeofday.of(w.hour, w.minute, w.second, w.nanosecond)?
    if !timeofday.equal(t, time(z)) {
        fail Invalid("pattern fields conflict")
    }
}

fn check_fields(f: pattern.Fields, z: Zoned) ! fault.Fault {
    pattern.check_date(f, date.to_fields(date(z)))?
    check_clock(f, z)?
}

fn check_abbreviation(f: pattern.Fields, z: Zoned) ! fault.Fault {
    let written = f.zone_abbreviation ?? return
    if written != abbreviation(z) {
        fail Invalid("pattern fields conflict")
    }
}

fn check_offset(f: pattern.Fields, z: Zoned) ! fault.Fault {
    let written = f.offset_seconds ?? return
    if written != offset.seconds_of(z.shift) {
        fail OffsetConflict
    }
}

fn from_unix_fields(f: pattern.Fields, tz: zone.Zone) -> Zoned ! fault.Fault {
    let secs = f.unix_seconds ?? fail Invalid("pattern needs unix time")
    let ts = timestamp.from_parts(secs, f.nanosecond ?? 0)?
    let z = of(ts, tz)?
    check_fields(f, z)?
    z
}

fn from_written_offset(f: pattern.Fields) -> Zoned ! fault.Fault {
    let seconds = f.offset_seconds ?? fail Invalid("pattern needs offset")
    let shift = offset.of_seconds(seconds)?
    let dt = datetime.from_fields(f)?
    from_written(dt, zone.fixed(shift), shift)?
}

fn fixed_zone_of(f: pattern.Fields) -> zone.Zone ! fault.Fault {
    let seconds = f.offset_seconds ?? return zone.utc()
    let shift = offset.of_seconds(seconds)?
    zone.fixed(shift)
}

/// Parses `s` with the compiled pattern `p` and the words of `names` into a time in a fixed-offset zone.
///
/// The pattern must either give the Unix time with `%s`, or give a full date, a time of day and an offset with `%z`. A `Z` or `z` is read as a zero offset. The zone is a fixed zone of the written offset, or UTC when only `%s` is given. Other fields that are present must agree with the instant. Fails with `Invalid` when the fields do not give an instant or conflict, with `Syntax` or `OutOfRange` when `s` does not match, and with `OutOfRange` for an offset that is too large.
pub fn parse_names(s: str, p: pattern.Pattern, names: pattern.Names) -> Zoned ! fault.Fault {
    let f = pattern.scan(p, s, names)?
    if f.unix_seconds != none {
        let tz = fixed_zone_of(f)?
        return from_unix_fields(f, tz)?
    }
    from_written_offset(f)?
}

/// Parses `s` with the compiled pattern `p` and English names.
///
/// Fails as `parse_names` does.
pub fn parse_pattern(s: str, p: pattern.Pattern) -> Zoned ! fault.Fault {
    parse_names(s, p, pattern.english())?
}

/// Parses `s` with the layout `layout` and English names.
///
/// Fails as `parse_names` does and with `Syntax` or `Unsupported` for a bad layout.
pub fn parse_with(s: str, layout: str) -> Zoned ! fault.Fault {
    let p = pattern.compile(layout)?
    parse_pattern(s, p)?
}

fn from_civil_fields(f: pattern.Fields, tz: zone.Zone, how: Disambiguation) -> Zoned ! fault.Fault {
    let dt = datetime.from_fields(f)?
    let seconds = f.offset_seconds ?? return from_civil(dt, tz, how)?
    let shift = offset.of_seconds(seconds)?
    with_offset(dt, tz, shift, OffsetPolicy.Reject)?
}

fn resolve_in_zone(f: pattern.Fields, tz: zone.Zone, how: Disambiguation) -> Zoned ! fault.Fault {
    if f.unix_seconds == none {
        return from_civil_fields(f, tz, how)?
    }
    let z = from_unix_fields(f, tz)?
    check_offset(f, z)?
    z
}

/// Parses `s` with the compiled pattern `p` and the words of `names` into a time in the zone `tz`, with `how` deciding what happens when the local time is an overlap or a gap.
///
/// The pattern gives either a date and a time of day or the Unix time with `%s`. An offset written with `%z` must be one that `tz` has at that local time or the parse fails with `OffsetConflict`. A zone abbreviation written with `%Z` must match the one the zone has at that instant or the parse fails with `Invalid`. Also fails as `from_civil` does.
pub fn parse_names_zone(s: str, p: pattern.Pattern, names: pattern.Names, tz: zone.Zone, how: Disambiguation) -> Zoned ! fault.Fault {
    let f = pattern.scan(p, s, names)?
    let z = resolve_in_zone(f, tz, how)?
    check_abbreviation(f, z)?
    z
}

/// Parses `s` with the compiled pattern `p` and English names into a time in the zone `tz`.
///
/// Fails as `parse_names_zone` does.
pub fn parse_pattern_zone(s: str, p: pattern.Pattern, tz: zone.Zone, how: Disambiguation) -> Zoned ! fault.Fault {
    parse_names_zone(s, p, pattern.english(), tz, how)?
}

/// Parses `s` with the layout `layout` and English names into a time in the zone `tz`.
///
/// Fails as `parse_names_zone` does and with `Syntax` or `Unsupported` for a bad layout.
pub fn parse_with_zone(s: str, layout: str, tz: zone.Zone, how: Disambiguation) -> Zoned ! fault.Fault {
    let p = pattern.compile(layout)?
    parse_pattern_zone(s, p, tz, how)?
}
