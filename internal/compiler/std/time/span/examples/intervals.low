import std/time/date
import std/time/duration
import std/time/fault
import std/time/rounding
import std/time/span

/// Reads ISO 8601 periods, shifts dates by them and breaks elapsed time into hours and smaller units.
fn main() ! fault.Fault {
    let renewal = span.parse("P1Y2M10DT4H30M")?
    print("renewal {span.friendly(renewal)} = {span.to_string(renewal)}")
    print("calendar part {span.to_string(span.calendar_part(renewal))}, time part {span.to_string(span.time_part(renewal))}")
    print("years {span.year_count(renewal)}, months {span.month_count(renewal)}, minutes {span.minute_count(renewal)}")

    let combined = span.plus(span.months(1), span.days(45))?
    print("counts stay separate: {span.friendly(combined)}")
    print("negated: {span.friendly(span.negate(combined))}")

    let start = date.of(2026, 1, 31)?
    print("{date.to_string(start)} plus {span.friendly(span.months(1))} is {date.to_string(date.plus(start, span.months(1))?)}")
    print("{date.to_string(start)} plus {span.friendly(span.days(30))} is {date.to_string(date.plus(start, span.days(30))?)}")

    let shift = span.parse("PT36H")?
    print("{span.friendly(shift)} has calendar units {span.has_calendar_units(shift)}")
    print("as an exact duration {duration.friendly(span.to_duration(shift)?)}")

    let uptime = duration.parse("PT1000000S")?
    let breakdown = span.from_duration(uptime, span.Unit.Hours)?
    print("uptime {span.friendly(breakdown)}")
    let minutes_only = span.from_duration(uptime, span.Unit.Minutes)?
    print("uptime in minutes {span.friendly(minutes_only)}")

    let rounded = span.round_time(span.parse("PT1H29M31S")?, span.Unit.Minutes, 15, rounding.Rounding.HalfExpand)?
    print("rounded to a quarter hour {span.friendly(rounded)}")
    let measured = span.of_elapsed(duration.seconds(5400), span.Diff { largest: span.Unit.Hours })?
    print("5400 seconds is {span.friendly(measured)}")

    let over = span.parse("P1.5D") catch {
        Syntax(at) => {
            print("fractional days rejected at byte {at}")
            return
        }
        _ => return
    }
    print(span.to_string(over))
}
