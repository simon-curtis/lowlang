import std/io
import std/text

pub enum Parsed {
    Naive(DateTime)
    Aware(Instant)
}

struct Scan {
    s: str
    at: i64
}

fn digit(p: Scan) -> bool {
    p.at < p.s.len && p.s[p.at] >= '0' && p.s[p.at] <= '9'
}

fn digits(mut p: Scan, least: i64, most: i64) -> i64 ! io.Error {
    var n = 0
    var count = 0
    for count < most && digit(p) {
        n = n * 10 + i64(p.s[p.at] - '0')
        p.at += 1
        count += 1
    }
    if count < least {
        fail Invalid
    }
    n
}

fn accept(mut p: Scan, c: u8) -> bool {
    if p.at < p.s.len && p.s[p.at] == c {
        p.at += 1
        return true
    }
    false
}

fn expect(mut p: Scan, c: u8) ! io.Error {
    if !accept(mut p, c) {
        fail Invalid
    }
}

fn finish(p: Scan) ! io.Error {
    if p.at != p.s.len {
        fail Invalid
    }
}

fn scan_date(mut p: Scan) -> Date ! io.Error {
    let year = digits(mut p, 4, 4)?
    expect(mut p, '-')?
    let month = digits(mut p, 2, 2)?
    expect(mut p, '-')?
    let day = digits(mut p, 2, 2)?
    date(year, month, day)
}

fn scan_fraction(mut p: Scan) -> i64 ! io.Error {
    if !digit(p) {
        fail Invalid
    }
    var n = 0
    var scale = 100000000
    for digit(p) {
        n += i64(p.s[p.at] - '0') * scale
        scale /= 10
        p.at += 1
    }
    n
}

fn scan_clock(mut p: Scan, day: Date) -> DateTime ! io.Error {
    let hour = digits(mut p, 2, 2)?
    expect(mut p, ':')?
    let minute = digits(mut p, 2, 2)?
    var second = 0
    var nanosecond = 0
    if accept(mut p, ':') {
        second = digits(mut p, 2, 2)?
        if accept(mut p, '.') {
            nanosecond = scan_fraction(mut p)?
        }
    }
    if hour > 23 || minute > 59 || second > 59 {
        fail Invalid
    }
    DateTime { date: day, hour, minute, second, nanosecond }
}

fn scan_offset(mut p: Scan) -> i64 ! io.Error {
    if accept(mut p, 'Z') || accept(mut p, 'z') {
        return 0
    }
    let negative = accept(mut p, '-')
    if !negative {
        expect(mut p, '+')?
    }
    let hours = digits(mut p, 2, 2)?
    expect(mut p, ':')?
    let minutes = digits(mut p, 2, 2)?
    if hours > 23 || minutes > 59 {
        fail Invalid
    }
    let seconds = hours * 3600 + minutes * 60
    if negative { -seconds } else { seconds }
}

pub fn parse_date(s: str) -> Date ! io.Error {
    var p = Scan { s, at: 0 }
    let d = scan_date(mut p)?
    finish(p)?
    d
}

pub fn parse_datetime(s: str) -> Parsed ! io.Error {
    var p = Scan { s, at: 0 }
    let day = scan_date(mut p)?
    if !accept(mut p, 'T') && !accept(mut p, 't') && !accept(mut p, ' ') {
        fail Invalid
    }
    let local = scan_clock(mut p, day)?
    if p.at == s.len {
        return Naive(local)
    }
    let offset = scan_offset(mut p)?
    finish(p)?
    Aware(Instant { local, offset })
}

fn pad(n: i64, width: i64) -> str {
    text.pad_left("{n}", width, '0')
}

pub fn format_date(d: Date) -> str {
    let year = if d.year < 0 { "-{pad(-d.year, 4)}" } else { pad(d.year, 4) }
    "{year}-{pad(d.month, 2)}-{pad(d.day, 2)}"
}

fn format_fraction(nanosecond: i64) -> str {
    if nanosecond == 0 {
        return ""
    }
    let all = pad(nanosecond, 9)
    var end = all.len
    for all[end - 1] == '0' {
        end -= 1
    }
    ".{all[..end]}"
}

pub fn format_datetime(dt: DateTime) -> str {
    "{format_date(dt.date)}T{pad(dt.hour, 2)}:{pad(dt.minute, 2)}:{pad(dt.second, 2)}{format_fraction(dt.nanosecond)}"
}

fn format_offset(offset: i64) -> str {
    if offset == 0 {
        return "Z"
    }
    let sign = if offset < 0 { "-" } else { "+" }
    let size = if offset < 0 { -offset } else { offset }
    let seconds = if size % 60 == 0 { "" } else { ":{pad(size % 60, 2)}" }
    "{sign}{pad(size / 3600, 2)}:{pad(size / 60 % 60, 2)}{seconds}"
}

pub fn format_instant(i: Instant) -> str {
    "{format_datetime(i.local)}{format_offset(i.offset)}"
}
