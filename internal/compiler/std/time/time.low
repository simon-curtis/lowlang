pub fn now() -> i64 {
    let spec: []i64 = __make(2)
    let status = __syscall(228, 0, __slice_ptr(spec))
    if status != 0 {
        return 0
    }
    spec[0]
}

pub fn now_nanos() -> i64 {
    __clock_nanos(0)
}

pub fn now_millis() -> i64 {
    __clock_nanos(0) / 1000000
}

pub fn monotonic() -> i64 {
    let spec: []i64 = __make(2)
    let status = __syscall(228, 1, __slice_ptr(spec))
    if status != 0 {
        return 0
    }
    spec[0] * 1000000000 + spec[1]
}
