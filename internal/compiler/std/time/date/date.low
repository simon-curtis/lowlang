import std/text
import std/time/clock
import std/time/duration
import std/time/fault
import std/time/pattern
import std/time/rounding
import std/time/span
import std/time/timestamp

pub struct Date {
    year: i64
    month: i64
    day: i64
}

pub enum Month {
    January
    February
    March
    April
    May
    June
    July
    August
    September
    October
    November
    December
}

pub enum Weekday {
    Monday
    Tuesday
    Wednesday
    Thursday
    Friday
    Saturday
    Sunday
}

pub struct IsoWeek {
    pub year: i64
    pub week: i64
}

struct Civil {
    year: i64
    month: i64
    day: i64
}

fn floor_div(a: i64, b: i64) -> i64 {
    let q = a / b
    if a % b != 0 && (a < 0) != (b < 0) { q - 1 } else { q }
}

fn floor_mod(a: i64, b: i64) -> i64 {
    a - floor_div(a, b) * b
}

fn first_year() -> i64 {
    -9999
}

fn last_year() -> i64 {
    9999
}

fn leap_year(year: i64) -> bool {
    year % 4 == 0 && (year % 100 != 0 || year % 400 == 0)
}

fn month_length(year: i64, month: i64) -> i64 {
    if month == 2 {
        return if leap_year(year) { 29 } else { 28 }
    }
    if month == 4 || month == 6 || month == 9 || month == 11 { 30 } else { 31 }
}

fn days_from_civil(year: i64, month: i64, day: i64) -> i64 {
    let y = if month <= 2 { year - 1 } else { year }
    let era = floor_div(y, 400)
    let yoe = y - era * 400
    let doy = (153 * ((month + 9) % 12) + 2) / 5 + day - 1
    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
    era * 146097 + doe - 719468
}

fn civil_from_days(days: i64) -> Civil {
    let z = days + 719468
    let era = floor_div(z, 146097)
    let doe = z - era * 146097
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
    let mp = (5 * doy + 2) / 153
    let day = doy - (153 * mp + 2) / 5 + 1
    let month = if mp < 10 { mp + 3 } else { mp - 9 }
    Civil { year: yoe + era * 400 + if month <= 2 { 1 } else { 0 }, month, day }
}

fn first_days() -> i64 {
    days_from_civil(first_year(), 1, 1)
}

fn last_days() -> i64 {
    days_from_civil(last_year(), 12, 31)
}

fn of_civil(c: Civil) -> Date {
    Date { year: c.year, month: c.month, day: c.day }
}

fn all_months() -> []Month {
    [
        Month.January,
        Month.February,
        Month.March,
        Month.April,
        Month.May,
        Month.June,
        Month.July,
        Month.August,
        Month.September,
        Month.October,
        Month.November,
        Month.December
    ]
}

fn all_weekdays() -> []Weekday {
    [
        Weekday.Monday,
        Weekday.Tuesday,
        Weekday.Wednesday,
        Weekday.Thursday,
        Weekday.Friday,
        Weekday.Saturday,
        Weekday.Sunday
    ]
}

pub fn month_to_number(m: Month) -> i64 {
    match m {
        January => 1
        February => 2
        March => 3
        April => 4
        May => 5
        June => 6
        July => 7
        August => 8
        September => 9
        October => 10
        November => 11
        December => 12
    }
}

pub fn month_from_number(n: i64) -> Month ! fault.Fault {
    if n < 1 || n > 12 {
        fail OutOfRange("month")
    }
    all_months()[n - 1]
}

pub fn month_name(m: Month) -> str {
    let names: []str = [
        "January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"
    ]
    names[month_to_number(m) - 1]
}

pub fn month_short_name(m: Month) -> str {
    let names: []str = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
    names[month_to_number(m) - 1]
}

pub fn month_days(m: Month, year: i64) -> i64 {
    month_length(year, month_to_number(m))
}

pub fn month_next(m: Month) -> Month {
    all_months()[month_to_number(m) % 12]
}

pub fn month_previous(m: Month) -> Month {
    all_months()[(month_to_number(m) + 10) % 12]
}

pub fn weekday_to_number(w: Weekday) -> i64 {
    match w {
        Monday => 1
        Tuesday => 2
        Wednesday => 3
        Thursday => 4
        Friday => 5
        Saturday => 6
        Sunday => 7
    }
}

pub fn weekday_from_number(n: i64) -> Weekday ! fault.Fault {
    if n < 1 || n > 7 {
        fail OutOfRange("weekday")
    }
    all_weekdays()[n - 1]
}

pub fn weekday_name(w: Weekday) -> str {
    let names: []str = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"]
    names[weekday_to_number(w) - 1]
}

pub fn weekday_short_name(w: Weekday) -> str {
    let names: []str = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
    names[weekday_to_number(w) - 1]
}

pub fn weekday_next(w: Weekday) -> Weekday {
    all_weekdays()[weekday_to_number(w) % 7]
}

pub fn weekday_previous(w: Weekday) -> Weekday {
    all_weekdays()[(weekday_to_number(w) + 5) % 7]
}

pub fn weekday_days_until(a: Weekday, b: Weekday) -> i64 {
    floor_mod(weekday_to_number(b) - weekday_to_number(a), 7)
}

fn check_year(year: i64) -> i64 ! fault.Fault {
    if year < first_year() || year > last_year() {
        fail OutOfRange("year")
    }
    year
}

fn check_month(month: i64) -> i64 ! fault.Fault {
    if month < 1 || month > 12 {
        fail OutOfRange("month")
    }
    month
}

fn check_day(day: i64) -> i64 ! fault.Fault {
    if day < 1 || day > 31 {
        fail OutOfRange("day")
    }
    day
}

pub fn of(year: i64, month: i64, day: i64) -> Date ! fault.Fault {
    check_year(year)?
    check_month(month)?
    check_day(day)?
    if day > month_length(year, month) {
        fail Invalid("day of month")
    }
    Date { year, month, day }
}

pub fn clamped(year: i64, month: i64, day: i64) -> Date ! fault.Fault {
    check_year(year)?
    check_month(month)?
    if day < 1 {
        fail OutOfRange("day")
    }
    let last = month_length(year, month)
    Date { year, month, day: if day > last { last } else { day } }
}

pub fn from_month(year: i64, month: Month, day: i64) -> Date ! fault.Fault {
    of(year, month_to_number(month), day)?
}

pub fn from_epoch_days(n: i64) -> Date ! fault.Fault {
    if n < first_days() || n > last_days() {
        fail OutOfRange("date")
    }
    of_civil(civil_from_days(n))
}

pub fn from_ordinal(year: i64, doy: i64) -> Date ! fault.Fault {
    check_year(year)?
    if doy < 1 || doy > 366 {
        fail OutOfRange("day of year")
    }
    let length = if leap_year(year) { 366 } else { 365 }
    if doy > length {
        fail Invalid("day of year")
    }
    of_civil(civil_from_days(days_from_civil(year, 1, 1) + doy - 1))
}

fn iso_first_monday(year: i64) -> i64 {
    let jan4 = days_from_civil(year, 1, 4)
    jan4 - floor_mod(jan4 + 3, 7)
}

pub fn weeks_in_iso_year(year: i64) -> i64 {
    (iso_first_monday(year + 1) - iso_first_monday(year)) / 7
}

pub fn from_iso_week(year: i64, week: i64, day: Weekday) -> Date ! fault.Fault {
    if year < first_year() - 1 || year > last_year() + 1 {
        fail OutOfRange("year")
    }
    if week < 1 || week > 53 {
        fail OutOfRange("week")
    }
    if week > weeks_in_iso_year(year) {
        fail Invalid("week")
    }
    from_epoch_days(iso_first_monday(year) + (week - 1) * 7 + weekday_to_number(day) - 1)?
}

pub fn from_weekday_in_month(year: i64, month: Month, day: Weekday, n: i64) -> Date ! fault.Fault {
    check_year(year)?
    if n == 0 || n > 5 || n < -1 {
        fail OutOfRange("occurrence")
    }
    let length = month_length(year, month_to_number(month))
    let first = days_from_civil(year, month_to_number(month), 1)
    let first_weekday = floor_mod(first + 3, 7)
    var of_month = 0
    if n > 0 {
        of_month = 1 + floor_mod(weekday_to_number(day) - 1 - first_weekday, 7) + (n - 1) * 7
    } else {
        let last_weekday = floor_mod(first + length - 1 + 3, 7)
        of_month = length - floor_mod(last_weekday - (weekday_to_number(day) - 1), 7)
    }
    if of_month > length {
        fail Invalid("weekday in month")
    }
    Date { year, month: month_to_number(month), day: of_month }
}

pub fn epoch() -> Date {
    Date { year: 1970, month: 1, day: 1 }
}

pub fn earliest() -> Date {
    Date { year: first_year(), month: 1, day: 1 }
}

pub fn latest() -> Date {
    Date { year: last_year(), month: 12, day: 31 }
}

pub fn today(c: clock.Clock) -> Date {
    let ts = clock.now(c)
    of_civil(civil_from_days(floor_div(timestamp.unix_seconds(ts), 86400)))
}

pub fn year(d: Date) -> i64 {
    d.year
}

pub fn month(d: Date) -> Month {
    all_months()[d.month - 1]
}

pub fn month_number(d: Date) -> i64 {
    d.month
}

pub fn day(d: Date) -> i64 {
    d.day
}

pub fn epoch_days(d: Date) -> i64 {
    days_from_civil(d.year, d.month, d.day)
}

pub fn weekday(d: Date) -> Weekday {
    all_weekdays()[floor_mod(epoch_days(d) + 3, 7)]
}

pub fn day_of_year(d: Date) -> i64 {
    epoch_days(d) - days_from_civil(d.year, 1, 1) + 1
}

pub fn days_in_month(d: Date) -> i64 {
    month_length(d.year, d.month)
}

pub fn days_in_year(d: Date) -> i64 {
    if leap_year(d.year) { 366 } else { 365 }
}

pub fn is_leap_year(d: Date) -> bool {
    leap_year(d.year)
}

pub fn iso_week(d: Date) -> IsoWeek {
    let thursday = epoch_days(d) + 4 - weekday_to_number(weekday(d))
    let c = civil_from_days(thursday)
    let doy = thursday - days_from_civil(c.year, 1, 1)
    IsoWeek { year: c.year, week: doy / 7 + 1 }
}

pub fn quarter(d: Date) -> i64 {
    (d.month - 1) / 3 + 1
}

pub fn first_of_month(d: Date) -> Date {
    Date { year: d.year, month: d.month, day: 1 }
}

pub fn last_of_month(d: Date) -> Date {
    Date { year: d.year, month: d.month, day: month_length(d.year, d.month) }
}

pub fn first_of_year(d: Date) -> Date {
    Date { year: d.year, month: 1, day: 1 }
}

pub fn last_of_year(d: Date) -> Date {
    Date { year: d.year, month: 12, day: 31 }
}

pub fn with_day(d: Date, n: i64) -> Date ! fault.Fault {
    of(d.year, d.month, n)?
}

pub fn with_month(d: Date, m: Month) -> Date {
    let last = month_length(d.year, month_to_number(m))
    Date { year: d.year, month: month_to_number(m), day: if d.day > last { last } else { d.day } }
}

pub fn with_year(d: Date, y: i64) -> Date ! fault.Fault {
    clamped(y, d.month, d.day)?
}

fn too_far(n: i64, limit: i64) -> bool {
    n > limit || n < -limit
}

fn month_index(year: i64, month: i64) -> i64 {
    year * 12 + month - 1
}

fn clamp_day(day: i64, year: i64, month: i64) -> i64 {
    let last = month_length(year, month)
    if day > last { last } else { day }
}

fn shifted_days(d: Date, months: i64) -> i64 {
    let index = month_index(d.year, d.month) + months
    let year = floor_div(index, 12)
    let month = floor_mod(index, 12) + 1
    days_from_civil(year, month, clamp_day(d.day, year, month))
}

pub fn plus_months(d: Date, n: i64) -> Date ! fault.Fault {
    if too_far(n, 1000000000000) {
        fail OutOfRange("months")
    }
    let index = month_index(d.year, d.month) + n
    let year = floor_div(index, 12)
    check_year(year)?
    let month = floor_mod(index, 12) + 1
    Date { year, month, day: clamp_day(d.day, year, month) }
}

pub fn plus_years(d: Date, n: i64) -> Date ! fault.Fault {
    if too_far(n, 1000000000) {
        fail OutOfRange("years")
    }
    plus_months(d, n * 12)?
}

pub fn plus_days(d: Date, n: i64) -> Date ! fault.Fault {
    if too_far(n, 100000000) {
        fail OutOfRange("date")
    }
    from_epoch_days(epoch_days(d) + n)?
}

pub fn plus_weeks(d: Date, n: i64) -> Date ! fault.Fault {
    if too_far(n, 10000000) {
        fail OutOfRange("date")
    }
    plus_days(d, n * 7)?
}

pub fn plus(d: Date, s: span.Span) -> Date ! fault.Fault {
    if span.has_time_units(s) {
        fail Invalid("span with time units")
    }
    let months = span.year_count(s) * 12 + span.month_count(s)
    let moved = plus_months(d, months)?
    plus_days(moved, span.week_count(s) * 7 + span.day_count(s))?
}

pub fn minus(d: Date, s: span.Span) -> Date ! fault.Fault {
    plus(d, span.negate(s))?
}

pub fn days_until(a: Date, b: Date) -> i64 {
    epoch_days(b) - epoch_days(a)
}

pub fn next_weekday(d: Date, w: Weekday) -> Date ! fault.Fault {
    let ahead = weekday_days_until(weekday(d), w)
    let distance = if ahead == 0 { 7 } else { ahead }
    plus_days(d, distance)?
}

pub fn previous_weekday(d: Date, w: Weekday) -> Date ! fault.Fault {
    let back = weekday_days_until(w, weekday(d))
    let distance = if back == 0 { 7 } else { back }
    plus_days(d, -distance)?
}

pub fn on_or_next(d: Date, w: Weekday) -> Date ! fault.Fault {
    plus_days(d, weekday_days_until(weekday(d), w))?
}

pub fn on_or_previous(d: Date, w: Weekday) -> Date ! fault.Fault {
    plus_days(d, -weekday_days_until(w, weekday(d)))?
}

pub fn compare(a: Date, b: Date) -> i64 {
    if a.year != b.year {
        return if a.year < b.year { -1 } else { 1 }
    }
    if a.month != b.month {
        return if a.month < b.month { -1 } else { 1 }
    }
    if a.day < b.day {
        return -1
    }
    if a.day > b.day { 1 } else { 0 }
}

pub fn equal(a: Date, b: Date) -> bool {
    compare(a, b) == 0
}

pub fn before(a: Date, b: Date) -> bool {
    compare(a, b) < 0
}

pub fn after(a: Date, b: Date) -> bool {
    compare(a, b) > 0
}

pub fn min(a: Date, b: Date) -> Date {
    if compare(b, a) < 0 { b } else { a }
}

pub fn max(a: Date, b: Date) -> Date {
    if compare(b, a) > 0 { b } else { a }
}

fn sign_of(n: i64) -> i64 {
    if n < 0 {
        return -1
    }
    if n > 0 { 1 } else { 0 }
}

fn whole_months(a: Date, b: Date, sign: i64) -> i64 {
    let spread = month_index(b.year, b.month) - month_index(a.year, a.month)
    let candidate = shifted_days(a, spread)
    let target = epoch_days(b)
    if sign > 0 && candidate > target {
        return spread - 1
    }
    if sign < 0 && candidate < target { spread + 1 } else { spread }
}

fn day_length(days: i64) -> duration.Duration {
    duration.seconds(days * 86400)
}

struct Parts {
    months: i64
    weeks: i64
    days: i64
    time: duration.Duration
}

struct Frame {
    a: Date
    sign: i64
    base: i64
    months: i64
    target: i64
    extra: duration.Duration
    diff: span.Diff
}

fn magnitude_days(f: Frame) -> i64 {
    f.sign * (f.target - f.base)
}

fn weeks_taken(f: Frame) -> i64 {
    if span.rank(f.diff.largest) == 2 { magnitude_days(f) / 7 } else { 0 }
}

fn round_months(f: Frame) -> Parts {
    let per = if span.rank(f.diff.smallest) == 0 { 12 } else { 1 }
    let units = f.sign * f.months / per
    let q = units / f.diff.increment
    let low = f.sign * q * f.diff.increment * per
    let high = f.sign * (q + 1) * f.diff.increment * per
    let start = shifted_days(f.a, low)
    let end = shifted_days(f.a, high)
    let num = duration.plus(day_length(f.sign * (f.target - start)), duration.abs(f.extra))
    let den = day_length(f.sign * (end - start))
    let class = span.half_class(num, den)
    let r = span.round_count(q, class, f.sign < 0, f.diff.mode)
    Parts { months: f.sign * r * f.diff.increment * per, weeks: 0, days: 0, time: duration.zero() }
}

fn bubble_months(f: Frame, parts: Parts, covered: i64) -> Parts {
    if span.rank(f.diff.largest) > 1 {
        return parts
    }
    let reached = f.base + f.sign * covered
    let boundary = shifted_days(f.a, f.months + f.sign)
    if f.sign * (reached - boundary) >= 0 {
        return Parts { months: parts.months + f.sign, weeks: 0, days: 0, time: duration.zero() }
    }
    parts
}

fn round_weeks(f: Frame) -> Parts {
    let incr = f.diff.increment
    let q = magnitude_days(f) / 7 / incr
    let num = duration.plus(day_length(magnitude_days(f) - q * incr * 7), duration.abs(f.extra))
    let den = day_length(incr * 7)
    let class = span.half_class(num, den)
    let r = span.round_count(q, class, f.sign < 0, f.diff.mode)
    let rounded = Parts { months: f.months, weeks: f.sign * r * incr, days: 0, time: duration.zero() }
    bubble_months(f, rounded, r * incr * 7)
}

fn round_days(f: Frame) -> Parts {
    let incr = f.diff.increment
    let whole = weeks_taken(f)
    let left = magnitude_days(f) - whole * 7
    let q = left / incr
    let num = duration.plus(day_length(left - q * incr), duration.abs(f.extra))
    let den = day_length(incr)
    let class = span.half_class(num, den)
    let r = span.round_count(q, class, f.sign < 0, f.diff.mode)
    let days = r * incr
    if span.rank(f.diff.largest) == 2 && days >= 7 {
        return Parts { months: f.months, weeks: f.sign * (whole + 1), days: 0, time: duration.zero() }
    }
    let rounded = Parts { months: f.months, weeks: f.sign * whole, days: f.sign * days, time: duration.zero() }
    bubble_months(f, rounded, days)
}

fn round_clock(f: Frame) -> Parts ! fault.Fault {
    let whole = weeks_taken(f)
    let left = magnitude_days(f) - whole * 7
    let total = duration.plus(day_length(left), duration.abs(f.extra))
    let signed = if f.sign < 0 { duration.negate(total) } else { total }
    let per = span.nanos_per(f.diff.smallest)?
    let step = duration.try_times(duration.nanoseconds(per), f.diff.increment) ?? fail OutOfRange("rounding increment")
    let rounded = duration.abs(duration.round(signed, step, f.diff.mode)?)
    let days = duration.whole_seconds(rounded) / 86400
    let time = duration.minus(rounded, day_length(days))
    if span.rank(f.diff.largest) == 2 && days >= 7 {
        return Parts { months: f.months, weeks: f.sign * (whole + 1), days: 0, time: duration.zero() }
    }
    let parts = Parts {
        months: f.months,
        weeks: f.sign * whole,
        days: f.sign * days,
        time: if f.sign < 0 { duration.negate(time) } else { time }
    }
    bubble_months(f, parts, days)
}

fn nudge(f: Frame) -> Parts ! fault.Fault {
    let smallest = span.rank(f.diff.smallest)
    if smallest <= 1 {
        return round_months(f)
    }
    if smallest == 2 {
        return round_weeks(f)
    }
    if smallest == 3 {
        return round_days(f)
    }
    round_clock(f)?
}

fn assemble(parts: Parts, largest: span.Unit) -> span.Span ! fault.Fault {
    let years = if span.rank(largest) == 0 { parts.months / 12 } else { 0 }
    let months = parts.months - years * 12
    let clocked = span.from_duration(parts.time, span.Unit.Hours)?
    var c = span.counts(clocked)
    c[0] = years
    c[1] = months
    c[2] = parts.weeks
    c[3] = parts.days
    span.from_counts(c)?
}

fn direction(days: i64, extra: duration.Duration) -> i64 ! fault.Fault {
    let sign = if days != 0 { sign_of(days) } else if duration.is_negative(extra) { -1 } else if duration.is_zero(extra) { 0 } else { 1 }
    if days != 0 && !duration.is_zero(extra) && duration.is_negative(extra) != (days < 0) {
        fail Invalid("time of day")
    }
    sign
}

pub fn until_with_time(a: Date, b: Date, extra: duration.Duration, diff: span.Diff) -> span.Span ! fault.Fault {
    span.check_diff(diff)?
    if !span.is_calendar(diff.largest) {
        fail Invalid("largest unit {span.unit_name(diff.largest)}")
    }
    span.check_time_increment(diff.smallest, diff.increment, diff.largest)?
    if duration.compare(duration.abs(extra), day_length(1)) >= 0 {
        fail Invalid("time of day")
    }
    let days = days_until(a, b)
    let sign = direction(days, extra)?
    if sign == 0 {
        return span.zero()
    }
    let months = if span.rank(diff.largest) <= 1 { whole_months(a, b, sign) } else { 0 }
    let frame = Frame {
        a,
        sign,
        base: shifted_days(a, months),
        months,
        target: epoch_days(b),
        extra,
        diff
    }
    let parts = nudge(frame)?
    assemble(parts, diff.largest)?
}

pub fn until(a: Date, b: Date, diff: span.Diff) -> span.Span ! fault.Fault {
    var effective = diff
    if span.rank(diff.smallest) > 3 {
        if diff.increment != 1 {
            fail Invalid("rounding increment")
        }
        effective = span.Diff { largest: diff.largest, smallest: span.Unit.Days, increment: 1, mode: diff.mode }
    }
    until_with_time(a, b, duration.zero(), effective)?
}

pub fn since(a: Date, b: Date, diff: span.Diff) -> span.Span ! fault.Fault {
    until(b, a, diff)?
}

fn between(a: Date, b: Date, extra: i64) -> []Date ! fault.Fault {
    let first = epoch_days(a)
    let last = epoch_days(b) + extra
    if last - first > 1000000 {
        fail OutOfRange("range")
    }
    var out: []Date = []
    for n in first..last {
        push(mut out, of_civil(civil_from_days(n)))
    }
    out
}

pub fn range(a: Date, b: Date) -> []Date ! fault.Fault {
    between(a, b, 0)?
}

pub fn range_inclusive(a: Date, b: Date) -> []Date ! fault.Fault {
    between(a, b, 1)?
}

fn pad(n: i64, width: i64) -> str {
    text.pad_left("{n}", width, '0')
}

fn year_text(year: i64) -> str {
    if year < 0 { "-{pad(-year, 4)}" } else { pad(year, 4) }
}

pub fn to_string(d: Date) -> str {
    "{year_text(d.year)}-{pad(d.month, 2)}-{pad(d.day, 2)}"
}

struct Scan {
    s: str
    at: i64
}

fn more(p: Scan) -> bool {
    p.at < p.s.len
}

fn at_digit(p: Scan) -> bool {
    p.at < p.s.len && p.s[p.at] >= '0' && p.s[p.at] <= '9'
}

fn at_byte(p: Scan, c: u8) -> bool {
    p.at < p.s.len && p.s[p.at] == c
}

fn digit_run(p: Scan) -> i64 {
    var n = 0
    for p.at + n < p.s.len && p.s[p.at + n] >= '0' && p.s[p.at + n] <= '9' {
        n += 1
    }
    n
}

fn digits(mut p: Scan, count: i64) -> i64 ! fault.Fault {
    var n = 0
    for _ in 0..count {
        if !at_digit(p) {
            fail Syntax(p.at)
        }
        n = n * 10 + i64(p.s[p.at] - '0')
        p.at += 1
    }
    n
}


fn week_date(mut p: Scan, year: i64, separated: bool) -> Date ! fault.Fault {
    p.at += 1
    let week = digits(mut p, 2)?
    if separated {
        if !at_byte(p, '-') {
            fail Syntax(p.at)
        }
        p.at += 1
    }
    let number = digits(mut p, 1)?
    from_iso_week(year, week, weekday_from_number(number)?)?
}

fn extended(mut p: Scan, year: i64) -> Date ! fault.Fault {
    p.at += 1
    if at_byte(p, 'W') {
        return week_date(mut p, year, true)?
    }
    if digit_run(p) >= 3 {
        let doy = digits(mut p, 3)?
        return from_ordinal(year, doy)?
    }
    let month = digits(mut p, 2)?
    if !at_byte(p, '-') {
        fail Syntax(p.at)
    }
    p.at += 1
    let day = digits(mut p, 2)?
    of(year, month, day)?
}

fn basic(mut p: Scan, year: i64) -> Date ! fault.Fault {
    if at_byte(p, 'W') {
        return week_date(mut p, year, false)?
    }
    let run = digit_run(p)
    if run >= 4 {
        let month = digits(mut p, 2)?
        let day = digits(mut p, 2)?
        return of(year, month, day)?
    }
    if run == 3 {
        let doy = digits(mut p, 3)?
        return from_ordinal(year, doy)?
    }
    fail Syntax(p.at + run)
}

pub fn parse(s: str) -> Date ! fault.Fault {
    var p = Scan { s, at: 0 }
    var negative = false
    if at_byte(p, '-') {
        negative = true
        p.at = 1
    }
    let magnitude = digits(mut p, 4)?
    if negative && magnitude == 0 {
        fail Syntax(0)
    }
    let year = if negative { -magnitude } else { magnitude }
    let result = if at_byte(p, '-') { extended(mut p, year)? } else { basic(mut p, year)? }
    if more(p) {
        fail Syntax(p.at)
    }
    result
}

pub fn to_fields(d: Date) -> pattern.Fields {
    let week = iso_week(d)
    pattern.Fields {
        year: d.year,
        month: d.month,
        day: d.day,
        day_of_year: day_of_year(d),
        weekday: weekday_to_number(weekday(d)),
        iso_year: week.year,
        iso_week: week.week
    }
}

fn from_plan(plan: pattern.Plan) -> Date ! fault.Fault {
    match plan {
        Calendar(y, m, d) => of(y, m, d)?
        Ordinal(y, n) => from_ordinal(y, n)?
        IsoWeek(y, w, n) => from_iso_week(y, w, weekday_from_number(n)?)?
    }
}

pub fn from_fields(f: pattern.Fields) -> Date ! fault.Fault {
    let plan = pattern.date_plan(f)?
    let d = from_plan(plan)?
    pattern.check_date(f, to_fields(d))?
    d
}

pub fn format_names(d: Date, p: pattern.Pattern, names: pattern.Names) -> str ! fault.Fault {
    pattern.render(p, to_fields(d), names)?
}

pub fn format_with(d: Date, p: pattern.Pattern) -> str ! fault.Fault {
    format_names(d, p, pattern.english())?
}

pub fn format(d: Date, layout: str) -> str ! fault.Fault {
    let p = pattern.compile(layout)?
    format_with(d, p)?
}

pub fn parse_names(s: str, p: pattern.Pattern, names: pattern.Names) -> Date ! fault.Fault {
    pattern.restrict(p, true, false)?
    let f = pattern.scan(p, s, names)?
    from_fields(f)?
}

pub fn parse_pattern(s: str, p: pattern.Pattern) -> Date ! fault.Fault {
    parse_names(s, p, pattern.english())?
}

pub fn parse_with(s: str, layout: str) -> Date ! fault.Fault {
    let p = pattern.compile(layout)?
    parse_pattern(s, p)?
}
