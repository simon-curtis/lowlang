import std/math
import std/slices
import std/text
import std/time
import std/time/calendar
import std/time/duration
import std/time/fault
import std/time/rounding

/// A point on the UTC timeline with nanosecond precision, from `0001-01-01T00:00:00Z` to `9999-12-31T23:59:59.999999999Z`.
///
/// It is held as seconds since the Unix epoch and a nanosecond part that is never negative, so instants before the epoch also have a nanosecond part counted forward.
pub struct Timestamp {
    secs: i64
    nanos: i64
}

fn first_secs() -> i64 {
    -62135596800
}

fn last_secs() -> i64 {
    253402300799
}

fn billion() -> i64 {
    1000000000
}

fn in_range(secs: i64) -> bool {
    secs >= first_secs() && secs <= last_secs()
}

fn checked(secs: i64, nanos: i64) -> Timestamp ! fault.Fault {
    if !in_range(secs) {
        fail OutOfRange("timestamp")
    }
    Timestamp { secs, nanos }
}

/// Returns the Unix epoch, `1970-01-01T00:00:00Z`.
pub fn epoch() -> Timestamp {
    Timestamp { secs: 0, nanos: 0 }
}

/// Returns the first representable instant, `0001-01-01T00:00:00Z`.
pub fn earliest() -> Timestamp {
    Timestamp { secs: first_secs(), nanos: 0 }
}

/// Returns the last representable instant, `9999-12-31T23:59:59.999999999Z`.
pub fn latest() -> Timestamp {
    Timestamp { secs: last_secs(), nanos: 999999999 }
}

/// Returns the timestamp `secs` seconds after the Unix epoch.
///
/// Fails with `OutOfRange` when the result is outside the supported years.
pub fn from_unix(secs: i64) -> Timestamp ! fault.Fault {
    checked(secs, 0)?
}

/// Returns the timestamp `ms` milliseconds after the Unix epoch.
///
/// Fails with `OutOfRange` when the result is outside the supported years.
pub fn from_unix_millis(ms: i64) -> Timestamp ! fault.Fault {
    checked(math.floor_div(ms, 1000), math.floor_mod(ms, 1000) * 1000000)?
}

/// Returns the timestamp `n` nanoseconds after the Unix epoch.
///
/// This never fails, because an `i64` of nanoseconds covers only the years 1677 to 2262.
pub fn from_unix_nanos(n: i64) -> Timestamp {
    Timestamp { secs: math.floor_div(n, billion()), nanos: math.floor_mod(n, billion()) }
}

/// Returns the timestamp `secs` seconds and `nanos` nanoseconds after the Unix epoch.
///
/// `nanos` can be any value, including a negative one or one beyond a second, and is carried into the seconds. Fails with `OutOfRange` when the result is outside the supported years.
pub fn from_parts(secs: i64, nanos: i64) -> Timestamp ! fault.Fault {
    if secs < -4000000000000000000 || secs > 4000000000000000000 {
        fail OutOfRange("timestamp")
    }
    checked(secs + math.floor_div(nanos, billion()), math.floor_mod(nanos, billion()))?
}

/// Returns the current wall-clock time.
pub fn now() -> Timestamp {
    from_unix_nanos(time.now_nanos())
}

/// Returns the whole seconds since the Unix epoch, rounded toward negative infinity.
pub fn unix_seconds(ts: Timestamp) -> i64 {
    ts.secs
}

/// Returns the whole milliseconds since the Unix epoch, rounded toward negative infinity.
pub fn unix_millis(ts: Timestamp) -> i64 {
    ts.secs * 1000 + ts.nanos / 1000000
}

fn since_epoch(ts: Timestamp) -> duration.Duration {
    duration.from_parts(ts.secs, ts.nanos)
}

/// Returns the nanoseconds since the Unix epoch, or `none` when the count does not fit in an `i64`.
pub fn unix_nanos(ts: Timestamp) -> i64? {
    duration.as_nanos(since_epoch(ts))
}

/// Returns the nanoseconds after the whole second, from `0` to `999999999`.
pub fn subsec_nanos(ts: Timestamp) -> i64 {
    ts.nanos
}

fn from_epoch(d: duration.Duration) -> Timestamp? {
    let secs = duration.floor_seconds(d)
    if !in_range(secs) {
        return none
    }
    Timestamp { secs, nanos: duration.floor_nanos(d) }
}

/// Returns the instant `d` after `ts`, or `none` when the result overflows or leaves the supported years.
///
/// A negative `d` moves backwards.
pub fn try_plus(ts: Timestamp, d: duration.Duration) -> Timestamp? {
    let sum = duration.try_plus(since_epoch(ts), d) ?? return none
    from_epoch(sum)
}

/// Returns the instant `d` before `ts`, or `none` when the result overflows or leaves the supported years.
pub fn try_minus(ts: Timestamp, d: duration.Duration) -> Timestamp? {
    try_plus(ts, duration.negate(d))
}

/// Returns the instant `d` after `ts`.
///
/// Fails with `Overflow` where `try_plus` returns `none`.
pub fn plus(ts: Timestamp, d: duration.Duration) -> Timestamp ! fault.Fault {
    try_plus(ts, d) ?? fail Overflow
}

/// Returns the instant `d` before `ts`.
///
/// Fails with `Overflow` where `try_minus` returns `none`.
pub fn minus(ts: Timestamp, d: duration.Duration) -> Timestamp ! fault.Fault {
    try_minus(ts, d) ?? fail Overflow
}

/// Returns the duration from `a` to `b`, which is negative when `b` is earlier.
pub fn until(a: Timestamp, b: Timestamp) -> duration.Duration {
    duration.minus(since_epoch(b), since_epoch(a))
}

/// Returns the duration from `b` to `a`, which is negative when `a` is earlier.
pub fn since(a: Timestamp, b: Timestamp) -> duration.Duration {
    until(b, a)
}

/// Returns `-1`, `0` or `1` as `a` is earlier than, the same as or later than `b`.
pub fn compare(a: Timestamp, b: Timestamp) -> i64 {
    if a.secs != b.secs {
        return if a.secs < b.secs { -1 } else { 1 }
    }
    if a.nanos < b.nanos {
        return -1
    }
    if a.nanos > b.nanos { 1 } else { 0 }
}

/// Returns whether `a` and `b` are the same instant.
pub fn equal(a: Timestamp, b: Timestamp) -> bool {
    compare(a, b) == 0
}

/// Returns whether `a` is earlier than `b`.
pub fn before(a: Timestamp, b: Timestamp) -> bool {
    compare(a, b) < 0
}

/// Returns whether `a` is later than `b`.
pub fn after(a: Timestamp, b: Timestamp) -> bool {
    compare(a, b) > 0
}

/// Returns the earlier of the two instants, or `a` when they are equal.
pub fn min(a: Timestamp, b: Timestamp) -> Timestamp {
    if compare(b, a) < 0 { b } else { a }
}

/// Returns the later of the two instants, or `a` when they are equal.
pub fn max(a: Timestamp, b: Timestamp) -> Timestamp {
    if compare(b, a) > 0 { b } else { a }
}

/// Returns `ts` rounded to a multiple of `unit` counted from the Unix epoch, using `mode`.
///
/// Fails with `Invalid` when `unit` is zero or negative, with `OutOfRange` when `unit` is longer than about 146 years, and with `Overflow` when the rounded result leaves the supported years.
pub fn round(ts: Timestamp, unit: duration.Duration, mode: rounding.Rounding) -> Timestamp ! fault.Fault {
    let rounded = duration.round(since_epoch(ts), unit, mode)?
    from_epoch(rounded) ?? fail Overflow
}

/// Returns `ts` rounded toward zero to a multiple of `unit` counted from the Unix epoch.
///
/// For an instant before the epoch this rounds toward the epoch, which is later. Fails in the same cases as `round`.
pub fn truncate(ts: Timestamp, unit: duration.Duration) -> Timestamp ! fault.Fault {
    round(ts, unit, rounding.Rounding.Trunc)
}

fn pad(n: i64, width: i64) -> str {
    text.pad_left("{n}", width, '0')
}

fn fraction_text(nanos: i64) -> str {
    if nanos == 0 {
        return ""
    }
    if nanos % 1000000 == 0 {
        return ".{pad(nanos / 1000000, 3)}"
    }
    if nanos % 1000 == 0 {
        return ".{pad(nanos / 1000, 6)}"
    }
    ".{pad(nanos, 9)}"
}

/// Returns `ts` in RFC 3339 form in UTC, such as `2024-03-01T12:30:00Z`.
///
/// The fraction is left out when it is zero and otherwise has 3, 6 or 9 digits, whichever is the fewest that is exact.
pub fn to_string(ts: Timestamp) -> str {
    let days = math.floor_div(ts.secs, 86400)
    let second_of_day = ts.secs - days * 86400
    let c = calendar.civil_from_days(days)
    let date = "{pad(c.year, 4)}-{pad(c.month, 2)}-{pad(c.day, 2)}"
    let clock = "{pad(second_of_day / 3600, 2)}:{pad(second_of_day % 3600 / 60, 2)}:{pad(second_of_day % 60, 2)}"
    "{date}T{clock}{fraction_text(ts.nanos)}Z"
}

struct Scan {
    s: str
    at: i64
}

fn more(p: Scan) -> bool {
    p.at < p.s.len
}

fn at_digit(p: Scan) -> bool {
    p.at < p.s.len && p.s[p.at] >= '0' && p.s[p.at] <= '9'
}

fn at_byte(p: Scan, c: u8) -> bool {
    p.at < p.s.len && p.s[p.at] == c
}

fn digits(mut p: Scan, count: i64) -> i64 ! fault.Fault {
    var n = 0
    for _ in 0..count {
        if !at_digit(p) {
            fail Syntax(p.at)
        }
        n = n * 10 + i64(p.s[p.at] - '0')
        p.at += 1
    }
    n
}

fn expect(mut p: Scan, c: u8) ! fault.Fault {
    if !at_byte(p, c) {
        fail Syntax(p.at)
    }
    p.at += 1
}

fn expect_text(mut p: Scan, word: str) ! fault.Fault {
    for i in 0..word.len {
        expect(mut p, word[i])?
    }
}

fn take_fraction(mut p: Scan) -> i64 ! fault.Fault {
    p.at += 1
    if !at_digit(p) {
        fail Syntax(p.at)
    }
    var scale = 100000000
    var total = 0
    for at_digit(p) {
        if scale == 0 {
            fail Syntax(p.at)
        }
        total += i64(p.s[p.at] - '0') * scale
        scale /= 10
        p.at += 1
    }
    total
}

fn take_offset(mut p: Scan) -> i64 ! fault.Fault {
    if at_byte(p, 'Z') || at_byte(p, 'z') {
        p.at += 1
        return 0
    }
    if !at_byte(p, '+') && !at_byte(p, '-') {
        fail Syntax(p.at)
    }
    let sign = if p.s[p.at] == '-' { -1 } else { 1 }
    p.at += 1
    let hours = digits(mut p, 2)?
    var minutes = 0
    var seconds = 0
    if at_byte(p, ':') {
        p.at += 1
        minutes = digits(mut p, 2)?
        if at_byte(p, ':') {
            p.at += 1
            seconds = digits(mut p, 2)?
        }
    } else if at_digit(p) {
        minutes = digits(mut p, 2)?
        if at_digit(p) {
            seconds = digits(mut p, 2)?
        }
    }
    if hours > 25 || minutes > 59 || seconds > 59 {
        fail OutOfRange("offset")
    }
    sign * (hours * 3600 + minutes * 60 + seconds)
}

struct Hms {
    hour: i64
    minute: i64
    second: i64
}

fn take_clock(mut p: Scan) -> Hms ! fault.Fault {
    let hour = digits(mut p, 2)?
    expect(mut p, ':')?
    let minute = digits(mut p, 2)?
    expect(mut p, ':')?
    let second = digits(mut p, 2)?
    Hms { hour, minute, second }
}

fn civil_seconds(year: i64, month: i64, day: i64, c: Hms) -> i64 ! fault.Fault {
    if month < 1 || month > 12 {
        fail OutOfRange("month")
    }
    if day < 1 || day > 31 {
        fail OutOfRange("day")
    }
    if day > calendar.days_in_month(year, month) {
        fail Invalid("day of month")
    }
    if c.hour > 23 {
        fail OutOfRange("hour")
    }
    if c.minute > 59 {
        fail OutOfRange("minute")
    }
    if c.second > 60 {
        fail OutOfRange("second")
    }
    let second = if c.second == 60 { 59 } else { c.second }
    calendar.days_from_civil(year, month, day) * 86400 + c.hour * 3600 + c.minute * 60 + second
}

/// Parses an RFC 3339 date and time into a `Timestamp`.
///
/// The form is `YYYY-MM-DDThh:mm:ss`, an optional fraction of at most nine digits, and a required offset that is `Z`, `z` or a sign followed by `hh`, `hh:mm` or `hh:mm:ss`. The `T` can also be `t` or a space. A second of `60` is read as `59`. The result is converted to UTC. Fails with `Syntax` at the offset of the first bad byte, with `OutOfRange` when a field or the offset is out of range or the result is outside the supported years, and with `Invalid` when the day does not exist in the month.
pub fn parse(s: str) -> Timestamp ! fault.Fault {
    var p = Scan { s, at: 0 }
    let year = digits(mut p, 4)?
    expect(mut p, '-')?
    let month = digits(mut p, 2)?
    expect(mut p, '-')?
    let day = digits(mut p, 2)?
    if !at_byte(p, 'T') && !at_byte(p, 't') && !at_byte(p, ' ') {
        fail Syntax(p.at)
    }
    p.at += 1
    let c = take_clock(mut p)?
    var nanos = 0
    if at_byte(p, '.') {
        nanos = take_fraction(mut p)?
    }
    let offset = take_offset(mut p)?
    if more(p) {
        fail Syntax(p.at)
    }
    let local = civil_seconds(year, month, day, c)?
    from_parts(local - offset, nanos)?
}

/// Returns `ts` in the HTTP date form, such as `Fri, 01 Mar 2024 12:30:00 GMT`.
///
/// A fraction of a second is dropped.
pub fn to_http_date(ts: Timestamp) -> str {
    let days = math.floor_div(ts.secs, 86400)
    let second_of_day = ts.secs - days * 86400
    let c = calendar.civil_from_days(days)
    let weekday = calendar.short_weekday_names()[calendar.weekday_index(days)]
    let month = calendar.short_month_names()[c.month - 1]
    let date = "{weekday}, {pad(c.day, 2)} {month} {pad(c.year, 4)}"
    let clock = "{pad(second_of_day / 3600, 2)}:{pad(second_of_day % 3600 / 60, 2)}:{pad(second_of_day % 60, 2)}"
    "{date} {clock} GMT"
}

fn take_word(mut p: Scan) -> str {
    let start = p.at
    for p.at < p.s.len && (p.s[p.at] >= 'A' && p.s[p.at] <= 'Z' || p.s[p.at] >= 'a' && p.s[p.at] <= 'z') {
        p.at += 1
    }
    p.s[start..p.at]
}

fn take_month(mut p: Scan) -> i64 ! fault.Fault {
    let start = p.at
    let word = take_word(mut p)
    let index = slices.index(calendar.short_month_names(), word) ?? -1
    if index < 0 {
        fail Syntax(start)
    }
    index + 1
}

fn http_instant(year: i64, month: i64, day: i64, c: Hms, weekday: i64) -> Timestamp ! fault.Fault {
    let local = civil_seconds(year, month, day, c)?
    let actual = calendar.weekday_index(math.floor_div(local, 86400))
    if actual != weekday {
        fail Invalid("weekday")
    }
    from_unix(local)?
}

fn parse_imf(mut p: Scan, weekday: i64) -> Timestamp ! fault.Fault {
    let day = digits(mut p, 2)?
    expect(mut p, ' ')?
    let month = take_month(mut p)?
    expect(mut p, ' ')?
    let year = digits(mut p, 4)?
    expect(mut p, ' ')?
    let c = take_clock(mut p)?
    expect(mut p, ' ')?
    expect_text(mut p, "GMT")?
    http_instant(year, month, day, c, weekday)?
}

fn parse_rfc850(mut p: Scan, weekday: i64) -> Timestamp ! fault.Fault {
    let day = digits(mut p, 2)?
    expect(mut p, '-')?
    let month = take_month(mut p)?
    expect(mut p, '-')?
    let short_year = digits(mut p, 2)?
    expect(mut p, ' ')?
    let c = take_clock(mut p)?
    expect(mut p, ' ')?
    expect_text(mut p, "GMT")?
    let year = if short_year >= 69 { 1900 + short_year } else { 2000 + short_year }
    http_instant(year, month, day, c, weekday)?
}

fn parse_asctime(mut p: Scan, weekday: i64) -> Timestamp ! fault.Fault {
    expect(mut p, ' ')?
    let month = take_month(mut p)?
    expect(mut p, ' ')?
    var day = 0
    if at_byte(p, ' ') {
        p.at += 1
        day = digits(mut p, 1)?
    } else {
        day = digits(mut p, 2)?
    }
    expect(mut p, ' ')?
    let c = take_clock(mut p)?
    expect(mut p, ' ')?
    let year = digits(mut p, 4)?
    http_instant(year, month, day, c, weekday)?
}

/// Parses an HTTP date in the IMF-fixdate form (`Fri, 01 Mar 2024 12:30:00 GMT`), the RFC 850 form (`Friday, 01-Mar-24 12:30:00 GMT`) or the asctime form (`Fri Mar  1 12:30:00 2024`).
///
/// The zone must be `GMT` where the form has one. A two-digit RFC 850 year of `69` to `99` is in the 1900s and any other is in the 2000s. Fails with `Invalid` when the weekday does not match the date, with `Syntax` at the offset of the first bad byte, and with `OutOfRange` when a field is out of range.
pub fn parse_http_date(s: str) -> Timestamp ! fault.Fault {
    var p = Scan { s, at: 0 }
    let word = take_word(mut p)
    let short = slices.index(calendar.short_weekday_names(), word) ?? -1
    let long = slices.index(calendar.weekday_names(), word) ?? -1
    if short < 0 && long < 0 {
        fail Syntax(0)
    }
    var result = epoch()
    if at_byte(p, ',') {
        p.at += 1
        expect(mut p, ' ')?
        result = if long >= 0 { parse_rfc850(mut p, long)? } else { parse_imf(mut p, short)? }
    } else if short >= 0 {
        result = parse_asctime(mut p, short)?
    } else {
        fail Syntax(p.at)
    }
    if more(p) {
        fail Syntax(p.at)
    }
    result
}
