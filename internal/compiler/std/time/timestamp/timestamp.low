import std/text
import std/time
import std/time/duration
import std/time/fault
import std/time/rounding

pub struct Timestamp {
    secs: i64
    nanos: i64
}

fn first_secs() -> i64 {
    -62135596800
}

fn last_secs() -> i64 {
    253402300799
}

fn billion() -> i64 {
    1000000000
}

fn floor_div(a: i64, b: i64) -> i64 {
    let q = a / b
    if a % b != 0 && (a < 0) != (b < 0) { q - 1 } else { q }
}

fn floor_mod(a: i64, b: i64) -> i64 {
    a - floor_div(a, b) * b
}

fn in_range(secs: i64) -> bool {
    secs >= first_secs() && secs <= last_secs()
}

fn checked(secs: i64, nanos: i64) -> Timestamp ! fault.Fault {
    if !in_range(secs) {
        fail OutOfRange("timestamp")
    }
    Timestamp { secs, nanos }
}

pub fn epoch() -> Timestamp {
    Timestamp { secs: 0, nanos: 0 }
}

pub fn earliest() -> Timestamp {
    Timestamp { secs: first_secs(), nanos: 0 }
}

pub fn latest() -> Timestamp {
    Timestamp { secs: last_secs(), nanos: 999999999 }
}

pub fn from_unix(secs: i64) -> Timestamp ! fault.Fault {
    checked(secs, 0)?
}

pub fn from_unix_millis(ms: i64) -> Timestamp ! fault.Fault {
    checked(floor_div(ms, 1000), floor_mod(ms, 1000) * 1000000)?
}

pub fn from_unix_nanos(n: i64) -> Timestamp {
    Timestamp { secs: floor_div(n, billion()), nanos: floor_mod(n, billion()) }
}

pub fn from_parts(secs: i64, nanos: i64) -> Timestamp ! fault.Fault {
    if secs < -4000000000000000000 || secs > 4000000000000000000 {
        fail OutOfRange("timestamp")
    }
    checked(secs + floor_div(nanos, billion()), floor_mod(nanos, billion()))?
}

pub fn now() -> Timestamp {
    from_unix_nanos(time.now_nanos())
}

pub fn unix_seconds(ts: Timestamp) -> i64 {
    ts.secs
}

pub fn unix_millis(ts: Timestamp) -> i64 {
    ts.secs * 1000 + ts.nanos / 1000000
}

fn since_epoch(ts: Timestamp) -> duration.Duration {
    duration.from_parts(ts.secs, ts.nanos)
}

pub fn unix_nanos(ts: Timestamp) -> i64? {
    duration.as_nanos(since_epoch(ts))
}

pub fn subsec_nanos(ts: Timestamp) -> i64 {
    ts.nanos
}

fn from_epoch(d: duration.Duration) -> Timestamp? {
    let secs = duration.floor_seconds(d)
    if !in_range(secs) {
        return none
    }
    Timestamp { secs, nanos: duration.floor_nanos(d) }
}

pub fn try_plus(ts: Timestamp, d: duration.Duration) -> Timestamp? {
    let sum = duration.try_plus(since_epoch(ts), d) ?? return none
    from_epoch(sum)
}

pub fn try_minus(ts: Timestamp, d: duration.Duration) -> Timestamp? {
    try_plus(ts, duration.negate(d))
}

pub fn plus(ts: Timestamp, d: duration.Duration) -> Timestamp ! fault.Fault {
    try_plus(ts, d) ?? fail Overflow
}

pub fn minus(ts: Timestamp, d: duration.Duration) -> Timestamp ! fault.Fault {
    try_minus(ts, d) ?? fail Overflow
}

pub fn until(a: Timestamp, b: Timestamp) -> duration.Duration {
    duration.minus(since_epoch(b), since_epoch(a))
}

pub fn since(a: Timestamp, b: Timestamp) -> duration.Duration {
    until(b, a)
}

pub fn compare(a: Timestamp, b: Timestamp) -> i64 {
    if a.secs != b.secs {
        return if a.secs < b.secs { -1 } else { 1 }
    }
    if a.nanos < b.nanos {
        return -1
    }
    if a.nanos > b.nanos { 1 } else { 0 }
}

pub fn equal(a: Timestamp, b: Timestamp) -> bool {
    compare(a, b) == 0
}

pub fn before(a: Timestamp, b: Timestamp) -> bool {
    compare(a, b) < 0
}

pub fn after(a: Timestamp, b: Timestamp) -> bool {
    compare(a, b) > 0
}

pub fn min(a: Timestamp, b: Timestamp) -> Timestamp {
    if compare(b, a) < 0 { b } else { a }
}

pub fn max(a: Timestamp, b: Timestamp) -> Timestamp {
    if compare(b, a) > 0 { b } else { a }
}

pub fn round(ts: Timestamp, unit: duration.Duration, mode: rounding.Rounding) -> Timestamp ! fault.Fault {
    let rounded = duration.round(since_epoch(ts), unit, mode)?
    from_epoch(rounded) ?? fail Overflow
}

pub fn truncate(ts: Timestamp, unit: duration.Duration) -> Timestamp ! fault.Fault {
    round(ts, unit, rounding.Rounding.Trunc)
}

struct Civil {
    year: i64
    month: i64
    day: i64
}

fn leap_year(year: i64) -> bool {
    year % 4 == 0 && (year % 100 != 0 || year % 400 == 0)
}

fn days_in_month(year: i64, month: i64) -> i64 {
    if month == 2 {
        return if leap_year(year) { 29 } else { 28 }
    }
    if month == 4 || month == 6 || month == 9 || month == 11 { 30 } else { 31 }
}

fn days_from_civil(year: i64, month: i64, day: i64) -> i64 {
    let y = if month <= 2 { year - 1 } else { year }
    let era = floor_div(y, 400)
    let yoe = y - era * 400
    let doy = (153 * ((month + 9) % 12) + 2) / 5 + day - 1
    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
    era * 146097 + doe - 719468
}

fn civil_from_days(days: i64) -> Civil {
    let z = days + 719468
    let era = floor_div(z, 146097)
    let doe = z - era * 146097
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
    let mp = (5 * doy + 2) / 153
    let day = doy - (153 * mp + 2) / 5 + 1
    let month = if mp < 10 { mp + 3 } else { mp - 9 }
    Civil { year: yoe + era * 400 + if month <= 2 { 1 } else { 0 }, month, day }
}

fn pad(n: i64, width: i64) -> str {
    text.pad_left("{n}", width, '0')
}

fn fraction_text(nanos: i64) -> str {
    if nanos == 0 {
        return ""
    }
    if nanos % 1000000 == 0 {
        return ".{pad(nanos / 1000000, 3)}"
    }
    if nanos % 1000 == 0 {
        return ".{pad(nanos / 1000, 6)}"
    }
    ".{pad(nanos, 9)}"
}

pub fn to_string(ts: Timestamp) -> str {
    let days = floor_div(ts.secs, 86400)
    let second_of_day = ts.secs - days * 86400
    let c = civil_from_days(days)
    let date = "{pad(c.year, 4)}-{pad(c.month, 2)}-{pad(c.day, 2)}"
    let clock = "{pad(second_of_day / 3600, 2)}:{pad(second_of_day % 3600 / 60, 2)}:{pad(second_of_day % 60, 2)}"
    "{date}T{clock}{fraction_text(ts.nanos)}Z"
}

struct Scan {
    s: str
    at: i64
}

fn more(p: Scan) -> bool {
    p.at < p.s.len
}

fn at_digit(p: Scan) -> bool {
    p.at < p.s.len && p.s[p.at] >= '0' && p.s[p.at] <= '9'
}

fn at_byte(p: Scan, c: u8) -> bool {
    p.at < p.s.len && p.s[p.at] == c
}

fn digits(mut p: Scan, count: i64) -> i64 ! fault.Fault {
    var n = 0
    for _ in 0..count {
        if !at_digit(p) {
            fail Syntax(p.at)
        }
        n = n * 10 + i64(p.s[p.at] - '0')
        p.at += 1
    }
    n
}

fn expect(mut p: Scan, c: u8) ! fault.Fault {
    if !at_byte(p, c) {
        fail Syntax(p.at)
    }
    p.at += 1
}

fn expect_text(mut p: Scan, word: str) ! fault.Fault {
    for i in 0..word.len {
        expect(mut p, word[i])?
    }
}

fn take_fraction(mut p: Scan) -> i64 ! fault.Fault {
    p.at += 1
    if !at_digit(p) {
        fail Syntax(p.at)
    }
    var scale = 100000000
    var total = 0
    for at_digit(p) {
        if scale == 0 {
            fail Syntax(p.at)
        }
        total += i64(p.s[p.at] - '0') * scale
        scale /= 10
        p.at += 1
    }
    total
}

fn take_offset(mut p: Scan) -> i64 ! fault.Fault {
    if at_byte(p, 'Z') || at_byte(p, 'z') {
        p.at += 1
        return 0
    }
    if !at_byte(p, '+') && !at_byte(p, '-') {
        fail Syntax(p.at)
    }
    let sign = if p.s[p.at] == '-' { -1 } else { 1 }
    p.at += 1
    let hours = digits(mut p, 2)?
    var minutes = 0
    var seconds = 0
    if at_byte(p, ':') {
        p.at += 1
        minutes = digits(mut p, 2)?
        if at_byte(p, ':') {
            p.at += 1
            seconds = digits(mut p, 2)?
        }
    } else if at_digit(p) {
        minutes = digits(mut p, 2)?
        if at_digit(p) {
            seconds = digits(mut p, 2)?
        }
    }
    if hours > 25 || minutes > 59 || seconds > 59 {
        fail OutOfRange("offset")
    }
    sign * (hours * 3600 + minutes * 60 + seconds)
}

struct Hms {
    hour: i64
    minute: i64
    second: i64
}

fn take_clock(mut p: Scan) -> Hms ! fault.Fault {
    let hour = digits(mut p, 2)?
    expect(mut p, ':')?
    let minute = digits(mut p, 2)?
    expect(mut p, ':')?
    let second = digits(mut p, 2)?
    Hms { hour, minute, second }
}

fn civil_seconds(year: i64, month: i64, day: i64, c: Hms) -> i64 ! fault.Fault {
    if month < 1 || month > 12 {
        fail OutOfRange("month")
    }
    if day < 1 || day > 31 {
        fail OutOfRange("day")
    }
    if day > days_in_month(year, month) {
        fail Invalid("day of month")
    }
    if c.hour > 23 {
        fail OutOfRange("hour")
    }
    if c.minute > 59 {
        fail OutOfRange("minute")
    }
    if c.second > 60 {
        fail OutOfRange("second")
    }
    let second = if c.second == 60 { 59 } else { c.second }
    days_from_civil(year, month, day) * 86400 + c.hour * 3600 + c.minute * 60 + second
}

pub fn parse(s: str) -> Timestamp ! fault.Fault {
    var p = Scan { s, at: 0 }
    let year = digits(mut p, 4)?
    expect(mut p, '-')?
    let month = digits(mut p, 2)?
    expect(mut p, '-')?
    let day = digits(mut p, 2)?
    if !at_byte(p, 'T') && !at_byte(p, 't') && !at_byte(p, ' ') {
        fail Syntax(p.at)
    }
    p.at += 1
    let c = take_clock(mut p)?
    var nanos = 0
    if at_byte(p, '.') {
        nanos = take_fraction(mut p)?
    }
    let offset = take_offset(mut p)?
    if more(p) {
        fail Syntax(p.at)
    }
    let local = civil_seconds(year, month, day, c)?
    from_parts(local - offset, nanos)?
}

fn short_weekdays() -> []str {
    ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
}

fn long_weekdays() -> []str {
    ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"]
}

fn short_months() -> []str {
    ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
}

pub fn to_http_date(ts: Timestamp) -> str {
    let days = floor_div(ts.secs, 86400)
    let second_of_day = ts.secs - days * 86400
    let c = civil_from_days(days)
    let weekday = short_weekdays()[floor_mod(days + 3, 7)]
    let month = short_months()[c.month - 1]
    let date = "{weekday}, {pad(c.day, 2)} {month} {pad(c.year, 4)}"
    let clock = "{pad(second_of_day / 3600, 2)}:{pad(second_of_day % 3600 / 60, 2)}:{pad(second_of_day % 60, 2)}"
    "{date} {clock} GMT"
}

fn index_of(names: []str, name: str) -> i64 {
    for i, candidate in names {
        if candidate == name {
            return i
        }
    }
    -1
}

fn take_word(mut p: Scan) -> str {
    let start = p.at
    for p.at < p.s.len && (p.s[p.at] >= 'A' && p.s[p.at] <= 'Z' || p.s[p.at] >= 'a' && p.s[p.at] <= 'z') {
        p.at += 1
    }
    p.s[start..p.at]
}

fn take_month(mut p: Scan) -> i64 ! fault.Fault {
    let start = p.at
    let word = take_word(mut p)
    let index = index_of(short_months(), word)
    if index < 0 {
        fail Syntax(start)
    }
    index + 1
}

fn http_instant(year: i64, month: i64, day: i64, c: Hms, weekday: i64) -> Timestamp ! fault.Fault {
    let local = civil_seconds(year, month, day, c)?
    let actual = floor_mod(floor_div(local, 86400) + 3, 7)
    if actual != weekday {
        fail Invalid("weekday")
    }
    from_unix(local)?
}

fn parse_imf(mut p: Scan, weekday: i64) -> Timestamp ! fault.Fault {
    let day = digits(mut p, 2)?
    expect(mut p, ' ')?
    let month = take_month(mut p)?
    expect(mut p, ' ')?
    let year = digits(mut p, 4)?
    expect(mut p, ' ')?
    let c = take_clock(mut p)?
    expect(mut p, ' ')?
    expect_text(mut p, "GMT")?
    http_instant(year, month, day, c, weekday)?
}

fn parse_rfc850(mut p: Scan, weekday: i64) -> Timestamp ! fault.Fault {
    let day = digits(mut p, 2)?
    expect(mut p, '-')?
    let month = take_month(mut p)?
    expect(mut p, '-')?
    let short_year = digits(mut p, 2)?
    expect(mut p, ' ')?
    let c = take_clock(mut p)?
    expect(mut p, ' ')?
    expect_text(mut p, "GMT")?
    let year = if short_year >= 69 { 1900 + short_year } else { 2000 + short_year }
    http_instant(year, month, day, c, weekday)?
}

fn parse_asctime(mut p: Scan, weekday: i64) -> Timestamp ! fault.Fault {
    expect(mut p, ' ')?
    let month = take_month(mut p)?
    expect(mut p, ' ')?
    var day = 0
    if at_byte(p, ' ') {
        p.at += 1
        day = digits(mut p, 1)?
    } else {
        day = digits(mut p, 2)?
    }
    expect(mut p, ' ')?
    let c = take_clock(mut p)?
    expect(mut p, ' ')?
    let year = digits(mut p, 4)?
    http_instant(year, month, day, c, weekday)?
}

pub fn parse_http_date(s: str) -> Timestamp ! fault.Fault {
    var p = Scan { s, at: 0 }
    let word = take_word(mut p)
    let short = index_of(short_weekdays(), word)
    let long = index_of(long_weekdays(), word)
    if short < 0 && long < 0 {
        fail Syntax(0)
    }
    var result = epoch()
    if at_byte(p, ',') {
        p.at += 1
        expect(mut p, ' ')?
        result = if long >= 0 { parse_rfc850(mut p, long)? } else { parse_imf(mut p, short)? }
    } else if short >= 0 {
        result = parse_asctime(mut p, short)?
    } else {
        fail Syntax(p.at)
    }
    if more(p) {
        fail Syntax(p.at)
    }
    result
}
