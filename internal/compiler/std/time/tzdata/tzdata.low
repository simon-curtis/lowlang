import std/text

struct Entry {
    offset: i64
    length: i64
}

pub fn version() -> str {
    text.trim(embed("version.txt"))
}

pub fn names() -> []str {
    var found: []str = []
    for line in text.lines(embed("index.txt")) {
        let name = text.cut(line, " ").before
        if name.len > 0 {
            push(mut found, name)
        }
    }
    found
}

fn find(name: str) -> Entry? {
    let index = embed("index.txt")
    let key = "\n{name} "
    let at = text.index(index, key)
    if at < 0 {
        return none
    }
    let rest = index[at + key.len..]
    let line = text.cut(rest, "\n").before
    let fields = text.fields(line)
    if fields.len != 2 {
        return none
    }
    let offset = text.parse_int(fields[0]) catch {
        e => return none
    }
    let length = text.parse_int(fields[1]) catch {
        e => return none
    }
    Entry { offset, length }
}

fn lookup(name: str) -> []u8? {
    let entry = find(name) ?? return none
    let data = embed("zones.bin")
    bytes(data[entry.offset..entry.offset + entry.length])
}

pub fn source() -> fn(str) -> []u8? {
    fn(name: str) -> []u8? { lookup(name) }
}
