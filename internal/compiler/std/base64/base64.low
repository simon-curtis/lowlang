/// Why a Base64 decode failed.
pub enum DecodeError {
    /// The input length is not valid for the padding: not a multiple of 4 when padding is required, or 1 modulo 4 once any optional padding is removed.
    BadLength
    /// A byte is not in the alphabet, `=` is misplaced or not allowed, or the bits left over in the last character are not zero. `at` is the index in the input.
    BadByte(at: i64)
}

/// Whether the `=` padding to a multiple of 4 characters is written and read.
pub enum Padding {
    /// The input is a multiple of 4 characters, ending in zero, one or two `=`.
    Required
    /// The input has no `=`.
    Forbidden
    /// The input ends in at most two `=`, or in none.
    Optional
}

/// The standard alphabet of RFC 4648 section 4, whose last two characters are `+` and `/`.
pub const standard = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

/// The URL-safe alphabet of RFC 4648 section 5, whose last two characters are `-` and `_`.
pub const url_safe = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"

/// Returns `data` encoded with the 64 characters of `alphabet`, padded with `=` to a multiple of 4 characters when `padded` is `true`.
pub fn encode_with(data: []u8, alphabet: str, padded: bool) -> str {
    let full = data.len / 3
    let rest = data.len - full * 3
    var size = full * 4
    if rest > 0 {
        size += if padded { 4 } else { rest + 1 }
    }
    let out: []u8 = __make(size)
    var o = 0
    for i in 0..full {
        let n = u32(data[3 * i]) << 16 | u32(data[3 * i + 1]) << 8 | u32(data[3 * i + 2])
        out[o] = alphabet[i64(n >> 18 & 63)]
        out[o + 1] = alphabet[i64(n >> 12 & 63)]
        out[o + 2] = alphabet[i64(n >> 6 & 63)]
        out[o + 3] = alphabet[i64(n & 63)]
        o += 4
    }
    if rest > 0 {
        var n = u32(data[3 * full]) << 16
        if rest == 2 {
            n |= u32(data[3 * full + 1]) << 8
        }
        out[o] = alphabet[i64(n >> 18 & 63)]
        out[o + 1] = alphabet[i64(n >> 12 & 63)]
        if rest == 2 {
            out[o + 2] = alphabet[i64(n >> 6 & 63)]
        }
        if padded {
            for k in rest + 1..4 {
                out[o + k] = '='
            }
        }
    }
    __str_view(out)
}

fn lookup(alphabet: str) -> []u8 {
    let table: []u8 = __make(256)
    for i in 0..256 {
        table[i] = 0xFF
    }
    for i in 0..alphabet.len {
        table[i64(alphabet[i])] = u8(i)
    }
    table
}

fn data_length(s: str, padding: Padding) -> i64 {
    var end = s.len
    if padding == Optional {
        for end > 0 && s.len - end < 2 && s[end - 1] == '=' {
            end -= 1
        }
    }
    end
}

/// Decodes `s` written with the 64 characters of `alphabet` and the given `padding`.
/// Fails with `BadLength` when the length does not suit the padding, and with `BadByte` at the index of the first byte outside the alphabet, of a misplaced or disallowed `=`, or, at the final index, when the bits left over in the last character are not zero. Empty input gives empty data.
pub fn decode_with(s: str, alphabet: str, padding: Padding) -> []u8 ! DecodeError {
    let length = data_length(s, padding)
    if padding == Required && s.len % 4 != 0 || padding != Required && length % 4 == 1 {
        fail BadLength
    }
    let table = lookup(alphabet)
    let out: []u8 = __make(length / 4 * 3 + (length % 4 + 1) / 2)
    var o = 0
    var buffer: u32 = 0
    var bits = 0
    var padded_from = -1
    for i in 0..s.len {
        let c = s[i]
        if c == '=' {
            if padding == Forbidden || i < s.len - 2 {
                fail BadByte(i)
            }
            if padded_from < 0 {
                padded_from = i
            }
            continue
        }
        let v = table[i64(c)]
        if padded_from >= 0 || v == 0xFF {
            fail BadByte(i)
        }
        buffer = buffer << 6 | u32(v)
        bits += 6
        if bits >= 8 {
            bits -= 8
            out[o] = u8(buffer >> bits)
            o += 1
            buffer &= (1 << bits) - 1
        }
    }
    if buffer != 0 {
        fail BadByte(s.len - 1)
    }
    out[..o]
}

/// Returns `data` encoded as standard Base64 (RFC 4648 section 4), padded with `=` to a multiple of 4 characters.
pub fn encode(data: []u8) -> str {
    encode_with(data, standard, true)
}

/// Returns `data` encoded as standard Base64 without padding.
pub fn encode_unpadded(data: []u8) -> str {
    encode_with(data, standard, false)
}

/// Returns `data` encoded as URL-safe Base64 (RFC 4648 section 5) without padding.
/// The alphabet uses `-` and `_` in place of `+` and `/`.
pub fn encode_url(data: []u8) -> str {
    encode_with(data, url_safe, false)
}

/// Decodes padded standard Base64.
/// The length must be a multiple of 4, so unpadded input fails with `BadLength`. `=` is accepted only as the last one or two characters. Fails as `decode_with` does.
pub fn decode(s: str) -> []u8 ! DecodeError {
    decode_with(s, standard, Required)?
}

/// Decodes unpadded standard Base64.
/// `=` is rejected. Fails as `decode_with` does.
pub fn decode_unpadded(s: str) -> []u8 ! DecodeError {
    decode_with(s, standard, Forbidden)?
}

/// Decodes unpadded URL-safe Base64.
/// `=`, `+` and `/` are rejected. Fails as `decode_with` does.
pub fn decode_url(s: str) -> []u8 ! DecodeError {
    decode_with(s, url_safe, Forbidden)?
}
