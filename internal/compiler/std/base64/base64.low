pub enum DecodeError {
    BadLength
    BadByte(at: i64)
}

fn alphabet() -> str {
    "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
}

pub fn encode(data: []u8) -> str {
    let table = alphabet()
    var out: []u8 = []
    var i = 0
    for i + 2 < data.len {
        let n = i64(data[i]) << 16 | i64(data[i + 1]) << 8 | i64(data[i + 2])
        push(mut out, table[n >> 18 & 63])
        push(mut out, table[n >> 12 & 63])
        push(mut out, table[n >> 6 & 63])
        push(mut out, table[n & 63])
        i += 3
    }
    let rest = data.len - i
    if rest > 0 {
        var n = i64(data[i]) << 16
        if rest == 2 {
            n = n | i64(data[i + 1]) << 8
        }
        push(mut out, table[n >> 18 & 63])
        push(mut out, table[n >> 12 & 63])
        push(mut out, if rest == 2 { table[n >> 6 & 63] } else { '=' })
        push(mut out, '=')
    }
    __str_view(out)
}

fn value(c: u8) -> i64 {
    if c >= 'A' && c <= 'Z' {
        return i64(c - 'A')
    }
    if c >= 'a' && c <= 'z' {
        return i64(c - 'a') + 26
    }
    if c >= '0' && c <= '9' {
        return i64(c - '0') + 52
    }
    if c == '+' {
        return 62
    }
    if c == '/' {
        return 63
    }
    -1
}

pub fn decode(s: str) -> []u8 ! DecodeError {
    if s.len % 4 != 0 {
        fail BadLength
    }
    var out: []u8 = []
    var i = 0
    for i < s.len {
        var n = 0
        var pad = 0
        for j in 0..4 {
            let c = s[i + j]
            var v = 0
            if c == '=' && i + 4 == s.len && j >= 2 {
                pad += 1
            } else {
                v = value(c)
                if v < 0 || pad > 0 {
                    fail BadByte(i + j)
                }
            }
            n = n << 6 | v
        }
        push(mut out, u8(n >> 16))
        if pad < 2 {
            push(mut out, u8(n >> 8))
        }
        if pad < 1 {
            push(mut out, u8(n))
        }
        i += 4
    }
    out
}
