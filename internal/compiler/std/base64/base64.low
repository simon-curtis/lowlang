/// Why a Base64 decode failed.
pub enum DecodeError {
    /// The input length is not valid for the variant: not a multiple of 4 for `decode`, or 1 modulo 4 for `decode_url`.
    BadLength
    /// A byte is not in the alphabet or `=` is misplaced. `at` is its index in the input.
    BadByte(at: i64)
}

fn alphabet() -> str {
    "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
}

/// Returns `data` encoded as URL-safe Base64 (RFC 4648 section 5) without padding.
/// The alphabet uses `-` and `_` in place of `+` and `/`.
pub fn encode_url(data: []u8) -> str {
    let table = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"
    let out: []u8 = __make((data.len * 4 + 2) / 3)
    var i = 0
    var o = 0
    for i + 2 < data.len {
        let n = i64(data[i]) << 16 | i64(data[i + 1]) << 8 | i64(data[i + 2])
        out[o] = table[n >> 18 & 63]
        out[o + 1] = table[n >> 12 & 63]
        out[o + 2] = table[n >> 6 & 63]
        out[o + 3] = table[n & 63]
        i += 3
        o += 4
    }
    let rest = data.len - i
    if rest > 0 {
        var n = i64(data[i]) << 16
        if rest == 2 {
            n = n | i64(data[i + 1]) << 8
            out[o + 2] = table[n >> 6 & 63]
        }
        out[o] = table[n >> 18 & 63]
        out[o + 1] = table[n >> 12 & 63]
    }
    __str_view(out)
}

fn url_value(c: u8) -> i64 {
    if c == '-' {
        return 62
    }
    if c == '_' {
        return 63
    }
    if c == '+' || c == '/' {
        return -1
    }
    value(c)
}

/// Decodes unpadded URL-safe Base64.
/// `=`, `+` and `/` are rejected. Fails with `BadLength` when the length is 1 modulo 4, and with `BadByte` at the index of the first byte outside the alphabet. Non-zero bits left over in the last character fail with `BadByte` at the final index.
pub fn decode_url(s: str) -> []u8 ! DecodeError {
    let rest = s.len % 4
    if rest == 1 {
        fail BadLength
    }
    let tail = if rest == 0 { 0 } else { rest - 1 }
    let out: []u8 = __make(s.len / 4 * 3 + tail)
    var n = 0
    var bits = 0
    var o = 0
    for i in 0..s.len {
        let v = url_value(s[i])
        if v < 0 {
            fail BadByte(i)
        }
        n = n << 6 | v
        bits += 6
        if bits >= 8 {
            bits -= 8
            out[o] = u8(n >> bits)
            n = n & ((1 << bits) - 1)
            o += 1
        }
    }
    if n != 0 {
        fail BadByte(s.len - 1)
    }
    out
}

/// Returns `data` encoded as standard Base64 (RFC 4648 section 4), padded with `=` to a multiple of 4 characters.
pub fn encode(data: []u8) -> str {
    let table = alphabet()
    var out: []u8 = []
    var i = 0
    for i + 2 < data.len {
        let n = i64(data[i]) << 16 | i64(data[i + 1]) << 8 | i64(data[i + 2])
        push(mut out, table[n >> 18 & 63])
        push(mut out, table[n >> 12 & 63])
        push(mut out, table[n >> 6 & 63])
        push(mut out, table[n & 63])
        i += 3
    }
    let rest = data.len - i
    if rest > 0 {
        var n = i64(data[i]) << 16
        if rest == 2 {
            n = n | i64(data[i + 1]) << 8
        }
        push(mut out, table[n >> 18 & 63])
        push(mut out, table[n >> 12 & 63])
        push(mut out, if rest == 2 { table[n >> 6 & 63] } else { '=' })
        push(mut out, '=')
    }
    __str_view(out)
}

fn value(c: u8) -> i64 {
    if c >= 'A' && c <= 'Z' {
        return i64(c - 'A')
    }
    if c >= 'a' && c <= 'z' {
        return i64(c - 'a') + 26
    }
    if c >= '0' && c <= '9' {
        return i64(c - '0') + 52
    }
    if c == '+' {
        return 62
    }
    if c == '/' {
        return 63
    }
    -1
}

/// Decodes padded standard Base64.
/// The length must be a multiple of 4, so unpadded input fails with `BadLength`. `=` is accepted only as the last one or two characters. Fails with `BadByte` at the index of the first byte outside the alphabet or of a misplaced `=`. Bits left over in the last character are ignored. Empty input gives empty data.
pub fn decode(s: str) -> []u8 ! DecodeError {
    if s.len % 4 != 0 {
        fail BadLength
    }
    var out: []u8 = []
    var i = 0
    for i < s.len {
        var n = 0
        var pad = 0
        for j in 0..4 {
            let c = s[i + j]
            var v = 0
            if c == '=' && i + 4 == s.len && j >= 2 {
                pad += 1
            } else {
                v = value(c)
                if v < 0 || pad > 0 {
                    fail BadByte(i + j)
                }
            }
            n = n << 6 | v
        }
        push(mut out, u8(n >> 16))
        if pad < 2 {
            push(mut out, u8(n >> 8))
        }
        if pad < 1 {
            push(mut out, u8(n))
        }
        i += 4
    }
    out
}
