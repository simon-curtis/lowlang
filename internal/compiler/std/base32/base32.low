pub enum Error {
    BadCharacter(at: i64)
    BadLength
}

fn standard() -> str {
    "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567"
}

fn extended() -> str {
    "0123456789ABCDEFGHIJKLMNOPQRSTUV"
}

fn encode_with(data: []u8, alphabet: str, padded: bool) -> str {
    var out: []u8 = []
    var buffer: u64 = 0
    var bits = 0
    for b in data {
        buffer = buffer << 8 | u64(b)
        bits += 8
        for bits >= 5 {
            bits -= 5
            push(mut out, alphabet[i64(buffer >> u64(bits) & 31)])
        }
    }
    if bits > 0 {
        push(mut out, alphabet[i64(buffer << u64(5 - bits) & 31)])
    }
    if padded {
        for out.len % 8 != 0 {
            push(mut out, '=')
        }
    }
    __str_view(out)
}

fn value(alphabet: str, c: u8) -> i64 {
    var upper = c
    if c >= 'a' && c <= 'z' {
        upper = c - 32
    }
    for i in 0..alphabet.len {
        if alphabet[i] == upper {
            return i
        }
    }
    -1
}

fn decode_with(s: str, alphabet: str) -> []u8 ! Error {
    var end = s.len
    for end > 0 && s[end - 1] == '=' {
        end -= 1
    }
    let tail = end % 8
    if tail == 1 || tail == 3 || tail == 6 {
        fail BadLength
    }
    var out: []u8 = []
    var buffer: u64 = 0
    var bits = 0
    for i in 0..end {
        let v = value(alphabet, s[i])
        if v < 0 {
            fail BadCharacter(i)
        }
        buffer = buffer << 5 | u64(v)
        bits += 5
        if bits >= 8 {
            bits -= 8
            push(mut out, u8(buffer >> u64(bits) & 0xFF))
        }
    }
    out
}

pub fn encode(data: []u8) -> str {
    encode_with(data, standard(), true)
}

pub fn encode_unpadded(data: []u8) -> str {
    encode_with(data, standard(), false)
}

pub fn decode(s: str) -> []u8 ! Error {
    decode_with(s, standard())?
}

pub fn encode_hex(data: []u8) -> str {
    encode_with(data, extended(), true)
}

pub fn decode_hex(s: str) -> []u8 ! Error {
    decode_with(s, extended())?
}
