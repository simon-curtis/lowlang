import std/text

pub enum Value {
    Unsigned(value: u64)
    Negative(value: u64)
    Bytes(data: []u8)
    Text(value: str)
    Array(items: []Value)
    Map(entries: []Entry)
    Tag(number: u64, content: *Value)
    Simple(value: u8)
    Bool(value: bool)
    Null
    Undefined
    Float(value: f64)
}

pub struct Entry {
    pub key: Value
    pub value: Value
}

pub fn integer(n: i64) -> Value {
    if n < 0 {
        return Negative(u64(-1 - n))
    }
    Unsigned(u64(n))
}

pub fn as_integer(v: Value) -> i64? {
    match v {
        Unsigned(n) => if n > 0x7FFFFFFFFFFFFFFF { none } else { i64(n) }
        Negative(n) => if n > 0x7FFFFFFFFFFFFFFF { none } else { -1 - i64(n) }
        _ => none
    }
}

pub fn get(v: Value, key: Value) -> Value? {
    let wanted = __str_view(encode(key))
    match v {
        Map(entries) => {
            for e in entries {
                if __str_view(encode(e.key)) == wanted {
                    return e.value
                }
            }
            none
        }
        _ => none
    }
}

pub fn diagnostic(v: Value) -> str {
    var out: []u8 = []
    describe(mut out, v)
    __str_view(out)
}

fn describe(mut out: []u8, v: Value) {
    match v {
        Unsigned(n) => text.append(mut out, "{n}")
        Negative(n) => text.append(mut out, negative_text(n))
        Bytes(data) => text.append(mut out, "h'{text.encode_hex(data)}'")
        Text(s) => quote(mut out, s)
        Array(items) => {
            push(mut out, '[')
            for i, item in items {
                if i > 0 {
                    text.append(mut out, ", ")
                }
                describe(mut out, item)
            }
            push(mut out, ']')
        }
        Map(entries) => {
            push(mut out, '{')
            for i, e in entries {
                if i > 0 {
                    text.append(mut out, ", ")
                }
                describe(mut out, e.key)
                text.append(mut out, ": ")
                describe(mut out, e.value)
            }
            push(mut out, '}')
        }
        Tag(number, content) => {
            text.append(mut out, "{number}(")
            describe(mut out, *content)
            push(mut out, ')')
        }
        Simple(n) => text.append(mut out, "simple({n})")
        Bool(b) => text.append(mut out, if b { "true" } else { "false" })
        Null => text.append(mut out, "null")
        Undefined => text.append(mut out, "undefined")
        Float(x) => text.append(mut out, float_text(x))
    }
}

fn negative_text(n: u64) -> str {
    if n == 0xFFFFFFFFFFFFFFFF {
        return "-18446744073709551616"
    }
    "-{n + 1}"
}

fn float_text(x: f64) -> str {
    if x != x {
        return "NaN"
    }
    let bits = text.float_bits(x)
    if bits & 0x7FFFFFFFFFFFFFFF == 0x7FF0000000000000 {
        return if bits >> 63 == 1 { "-Infinity" } else { "Infinity" }
    }
    let plain = "{x}"
    if text.contains(plain, ".") {
        return plain
    }
    let e = text.index_byte(plain, 'e')
    if e < 0 {
        return "{plain}.0"
    }
    "{plain[..e]}.0{plain[e..]}"
}

fn quote(mut out: []u8, s: str) {
    push(mut out, '"')
    for c in s {
        if c == '"' || c == '\\' {
            push(mut out, '\\')
            push(mut out, u8(c))
        } else if c >= 0x20 && c < 0x7F {
            push(mut out, u8(c))
        } else if c >= 0x10000 {
            let v = c - 0x10000
            escape(mut out, 0xD800 + (v >> 10))
            escape(mut out, 0xDC00 + (v & 0x3FF))
        } else {
            escape(mut out, c)
        }
    }
    push(mut out, '"')
}

fn escape(mut out: []u8, unit: u32) {
    text.append(mut out, "\\u{text.pad_left(text.radix(i64(unit), 16), 4, '0')}")
}
