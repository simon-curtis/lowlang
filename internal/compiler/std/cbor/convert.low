import std/io
import std/serde

fn value_of(node: serde.Node) -> Value {
    match node.tree {
        Null => Value.Null
        Bool(b) => Value.Bool(b)
        Int(n) => integer(n)
        Uint(n) => Value.Unsigned(n)
        Float(x) => Value.Float(x)
        Text(s) => Value.Text(s)
        Binary(data) => Value.Bytes(data)
        Seq(items) => {
            var out: []Value = []
            for item in items {
                push(mut out, value_of(item))
            }
            Value.Array(out)
        }
        Map(members) => {
            var out: []Entry = []
            for m in members {
                let key = value_of(m.key)
                let value = value_of(m.value)
                push(mut out, Entry { key, value })
            }
            Value.Map(out)
        }
        _ => __panic("serde: a tree read from a format has no CBOR form")
    }
}

/// Encodes `v` as CBOR bytes through `std/serde`.
///
/// Structs and maps become maps with text keys, slices become arrays, `[]u8` becomes a byte string, optionals become `null` or the value, floats become floats of the shortest exact precision, and integers become `Unsigned` or `Negative`. An enum variant without fields becomes text and a variant with fields a one-entry map from its name to a map of its labelled fields or an array of its positional ones. The output is deterministic, as `encode` makes it.
pub fn serialize[T](v: T) -> []u8 {
    let root = serde.to_tree(v)
    encode(value_of(root))
}

fn untagged(v: Value) -> Value {
    match v {
        Tag(_, content) => untagged(*content)
        _ => v
    }
}

fn scalar(v: Value) -> serde.Tree {
    match v {
        Unsigned(n) => serde.unsigned_tree(n)
        Negative(_) => match as_integer(v) {
            some(n) => serde.Tree.Int(n)
            none => serde.Tree.Overflow
        }
        Bytes(data) => serde.Tree.Binary(data)
        Text(s) => serde.Tree.Text(s)
        Bool(b) => serde.Tree.Bool(b)
        Null => serde.Tree.Null
        Undefined => serde.Tree.Null
        Float(x) => serde.Tree.Float(x)
        _ => serde.Tree.Opaque
    }
}

fn node_of(v: Value) -> serde.Node {
    let value = untagged(v)
    match value {
        Array(items) => {
            var out: []serde.Node = []
            for item in items {
                push(mut out, node_of(item))
            }
            serde.Node { tree: serde.Tree.Seq(out) }
        }
        Map(entries) => {
            var out: []serde.Member = []
            for e in entries {
                let key = node_of(e.key)
                let member = serde.Member { key, value: node_of(e.value) }
                push(mut out, member)
            }
            serde.Node { tree: serde.Tree.Map(out) }
        }
        _ => serde.Node { tree: scalar(value) }
    }
}

/// Decodes CBOR `data` into a `T` through `std/serde`.
///
/// Decoding uses the default `Options`. A tag is ignored and its content is read in its place. `null` and `undefined` both read as an absent optional. A float is read from a float or an integer, and an integer from `Unsigned` or `Negative` when it fits, failing with `serde.Error.Range` when it does not. Map keys may be text, integers or booleans, the latter two read as text. A decoding failure becomes `serde.Error.Syntax` with position `0`, except that `TooLarge` stays `serde.Error.TooLarge`. Fails with `Mismatch` when a value has another type and with `Missing` and `UnknownVariant` as `serde.read` describes. In errors, `at` counts the values consumed so far.
pub fn deserialize[T](data: []u8) -> T ! serde.Error {
    let v = decode(data) catch {
        e => fail decode_error(e)
    }
    let root = node_of(v)
    serde.read(serde.tree_reader(root, false))
}

fn decode_error(e: io.Error) -> serde.Error {
    match e {
        TooLarge => serde.Error.TooLarge
        _ => serde.Error.Syntax(0, "malformed CBOR")
    }
}
