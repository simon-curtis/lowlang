import std/slices
import std/text

struct Encoded {
    key: str
    value: []u8
}

/// Encodes `v` as deterministic CBOR (RFC 8949, section 4.2).
///
/// Integers, lengths and tag numbers use the shortest head. Strings, arrays and maps have definite lengths. Map entries are sorted by the bytes of their encoded keys, so the same map encodes to the same bytes whatever its order; entries with the same key are not removed. A float is written in the shortest of half, single and double precision that holds its value exactly, and every NaN is written as the half precision quiet NaN `0xF97E00`. A `Simple` value is written with its number as the argument. It cannot fail.
pub fn encode(v: Value) -> []u8 {
    var out: []u8 = []
    write(mut out, v)
    out
}

fn head(mut out: []u8, major: u8, n: u64) {
    let m = major << 5
    if n < 24 {
        push(mut out, m | u8(n))
        return
    }
    var size = 8
    var info: u8 = 27
    if n <= 0xFF {
        size = 1
        info = 24
    } else if n <= 0xFFFF {
        size = 2
        info = 25
    } else if n <= 0xFFFFFFFF {
        size = 4
        info = 26
    }
    push(mut out, m | info)
    big_endian(mut out, n, size)
}

fn big_endian(mut out: []u8, n: u64, size: i64) {
    for i in 0..size {
        push(mut out, u8(n >> u64(8 * (size - 1 - i))))
    }
}

fn append_bytes(mut out: []u8, data: []u8) {
    __extend(mut out, __str_view(data))
}

fn write(mut out: []u8, v: Value) {
    match v {
        Unsigned(n) => head(mut out, 0, n)
        Negative(n) => head(mut out, 1, n)
        Bytes(data) => {
            head(mut out, 2, u64(data.len))
            append_bytes(mut out, data)
        }
        Text(s) => {
            head(mut out, 3, u64(s.len))
            text.append(mut out, s)
        }
        Array(items) => {
            head(mut out, 4, u64(items.len))
            for item in items {
                write(mut out, item)
            }
        }
        Map(entries) => write_map(mut out, entries)
        Tag(number, content) => {
            head(mut out, 6, number)
            write(mut out, *content)
        }
        Simple(n) => head(mut out, 7, u64(n))
        Bool(b) => push(mut out, if b { 0xF5 } else { 0xF4 })
        Null => push(mut out, 0xF6)
        Undefined => push(mut out, 0xF7)
        Float(x) => write_float(mut out, x)
    }
}

fn write_map(mut out: []u8, entries: []Entry) {
    var sorted: []Encoded = []
    for e in entries {
        push(mut sorted, Encoded { key: __str_view(encode(e.key)), value: encode(e.value) })
    }
    sorted |> slices.sort_by(fn(a: Encoded, b: Encoded) -> bool { a.key < b.key })
    head(mut out, 5, u64(sorted.len))
    for e in sorted {
        text.append(mut out, e.key)
        append_bytes(mut out, e.value)
    }
}

fn write_float(mut out: []u8, x: f64) {
    let bits = if x != x { 0x7FF8000000000000 } else { text.float_bits(x) }
    let half = half_bits(bits)
    if half >= 0 {
        push(mut out, 0xF9)
        big_endian(mut out, u64(half), 2)
        return
    }
    let single = single_bits(bits)
    if single >= 0 {
        push(mut out, 0xFA)
        big_endian(mut out, u64(single), 4)
        return
    }
    push(mut out, 0xFB)
    big_endian(mut out, bits, 8)
}

fn low_bits_clear(n: u64, count: i64) -> bool {
    n & ((u64(1) << u64(count)) - 1) == 0
}

fn narrow(bits: u64, exponent_bits: i64, mantissa_bits: i64) -> i64 {
    let sign = i64(bits >> 63) << (exponent_bits + mantissa_bits)
    let exponent = i64(bits >> 52 & 0x7FF)
    let mantissa = bits & 0xFFFFFFFFFFFFF
    let bias = (i64(1) << (exponent_bits - 1)) - 1
    let top = (i64(1) << exponent_bits) - 1
    if exponent == 0x7FF {
        let quiet = if mantissa == 0 { 0 } else { i64(1) << (mantissa_bits - 1) }
        return sign | top << mantissa_bits | quiet
    }
    if exponent == 0 {
        return if mantissa == 0 { sign } else { -1 }
    }
    let e = exponent - 1023
    let dropped = 52 - mantissa_bits
    if e >= 1 - bias && e <= bias {
        if !low_bits_clear(mantissa, dropped) {
            return -1
        }
        return sign | (e + bias) << mantissa_bits | i64(mantissa >> u64(dropped))
    }
    let shift = dropped + 1 - bias - e
    if e < 1 - bias && shift <= 52 {
        let full = mantissa | u64(1) << 52
        if !low_bits_clear(full, shift) {
            return -1
        }
        return sign | i64(full >> u64(shift))
    }
    -1
}

fn half_bits(bits: u64) -> i64 {
    narrow(bits, 5, 10)
}

fn single_bits(bits: u64) -> i64 {
    narrow(bits, 8, 23)
}
