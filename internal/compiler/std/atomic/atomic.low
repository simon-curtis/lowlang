struct Cell {
    word: i64
}

pub struct Int {
    cell: *Cell
}

pub struct Bool {
    word: Int
}

pub struct Flag {
    word: Int
}

struct Slot[T] {
    lock: i64
    current: *T
}

pub struct Value[T] {
    slot: *Slot[T]
}

pub fn int(initial: i64) -> Int {
    Int { cell: new(Cell { word: initial }) }
}

pub fn load_int(i: Int) -> i64 {
    var seen = i.cell.word
    for !__cas(mut i.cell.word, seen, seen) {
        seen = i.cell.word
    }
    seen
}

pub fn store_int(i: Int, n: i64) {
    let previous = swap_int(i, n)
}

pub fn add_int(i: Int, n: i64) -> i64 {
    var seen = i.cell.word
    for !__cas(mut i.cell.word, seen, seen + n) {
        seen = i.cell.word
    }
    seen + n
}

pub fn swap_int(i: Int, n: i64) -> i64 {
    var seen = i.cell.word
    for !__cas(mut i.cell.word, seen, n) {
        seen = i.cell.word
    }
    seen
}

pub fn compare_and_swap_int(i: Int, old: i64, n: i64) -> bool {
    __cas(mut i.cell.word, old, n)
}

pub fn update_int(i: Int, f: fn(i64) -> i64) -> i64 {
    var seen = i.cell.word
    var next = f(seen)
    for !__cas(mut i.cell.word, seen, next) {
        seen = i.cell.word
        next = f(seen)
    }
    next
}

fn word_of(b: bool) -> i64 {
    if b { 1 } else { 0 }
}

pub fn boolean(initial: bool) -> Bool {
    Bool { word: int(word_of(initial)) }
}

pub fn load_bool(b: Bool) -> bool {
    load_int(b.word) != 0
}

pub fn store_bool(b: Bool, v: bool) {
    store_int(b.word, word_of(v))
}

pub fn swap_bool(b: Bool, v: bool) -> bool {
    swap_int(b.word, word_of(v)) != 0
}

pub fn compare_and_swap_bool(b: Bool, old: bool, v: bool) -> bool {
    compare_and_swap_int(b.word, word_of(old), word_of(v))
}

pub fn flag() -> Flag {
    Flag { word: int(0) }
}

pub fn is_set(f: Flag) -> bool {
    load_int(f.word) != 0
}

pub fn set(f: Flag) -> bool {
    compare_and_swap_int(f.word, 0, 1)
}

pub fn clear(f: Flag) -> bool {
    compare_and_swap_int(f.word, 1, 0)
}

pub fn value[T](initial: T) -> Value[T] {
    Value { slot: new(Slot { lock: 0, current: new(initial) }) }
}

pub fn snapshot_value[T](v: Value[T]) -> *T {
    let s = v.slot
    __lock(mut s.lock)
    let held = s.current
    __unlock(mut s.lock)
    held
}

pub fn load_value[T](v: Value[T]) -> T {
    *snapshot_value(v)
}

pub fn store_value[T](v: Value[T], next: T) {
    let previous = swap_value(v, next)
}

pub fn swap_value[T](v: Value[T], next: T) -> T {
    let s = v.slot
    let fresh = new(next)
    __lock(mut s.lock)
    let held = s.current
    s.current = fresh
    __unlock(mut s.lock)
    *held
}

pub fn compare_and_swap_value[T](v: Value[T], seen: *T, next: T) -> bool {
    let s = v.slot
    let fresh = new(next)
    __lock(mut s.lock)
    let matches = s.current == seen
    if matches {
        s.current = fresh
    }
    __unlock(mut s.lock)
    matches
}

pub fn update_value[T](v: Value[T], f: fn(T) -> T) -> T {
    for {
        let seen = snapshot_value(v)
        let next = f(*seen)
        if compare_and_swap_value(v, seen, next) {
            return next
        }
    }
}
