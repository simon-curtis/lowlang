struct Cell {
    word: i64
}

/// A 64-bit integer cell that is read and updated atomically.
///
/// Copies of an `Int` refer to the same cell. No operation parks the green thread.
pub struct Int {
    cell: *Cell
}

/// An atomic boolean, stored in an `Int`.
///
/// Copies of a `Bool` refer to the same cell.
pub struct Bool {
    word: Int
}

/// An atomic boolean that starts cleared and is switched with `set` and `clear`.
///
/// Copies of a `Flag` refer to the same cell.
pub struct Flag {
    word: Int
}

struct Slot[T] {
    lock: i64
    current: *T
}

/// An atomic cell holding a value of any type `T`.
///
/// Each `store_value` and `swap_value` allocates a copy of the new value and replaces a pointer to it, so a pointer from `snapshot_value` stays valid and unchanged while the cell moves on. Copies of a `Value` refer to the same cell. An internal lock is held only for the pointer exchange, so no operation parks the green thread.
pub struct Value[T] {
    slot: *Slot[T]
}

/// Returns an `Int` holding `initial`.
pub fn int(initial: i64) -> Int {
    Int { cell: new(Cell { word: initial }) }
}

/// Returns the current value of `i`.
pub fn load_int(i: Int) -> i64 {
    var seen = i.cell.word
    for !__cas(mut i.cell.word, seen, seen) {
        seen = i.cell.word
    }
    seen
}

/// Sets `i` to `n`.
pub fn store_int(i: Int, n: i64) {
    let previous = swap_int(i, n)
}

/// Adds `n` to `i` and returns the new value.
///
/// `n` can be negative.
pub fn add_int(i: Int, n: i64) -> i64 {
    var seen = i.cell.word
    for !__cas(mut i.cell.word, seen, seen + n) {
        seen = i.cell.word
    }
    seen + n
}

/// Sets `i` to `n` and returns the value it held before.
pub fn swap_int(i: Int, n: i64) -> i64 {
    var seen = i.cell.word
    for !__cas(mut i.cell.word, seen, n) {
        seen = i.cell.word
    }
    seen
}

/// Sets `i` to `n` if it currently equals `old`, and returns whether it did.
pub fn compare_and_swap_int(i: Int, old: i64, n: i64) -> bool {
    __cas(mut i.cell.word, old, n)
}

/// Replaces the value of `i` with `f` applied to it, and returns the stored result.
///
/// If another green thread changes `i` while `f` runs, `f` runs again on the new value, so `f` can run more than once and should not have side effects.
pub fn update_int(i: Int, f: fn(i64) -> i64) -> i64 {
    var seen = i.cell.word
    var next = f(seen)
    for !__cas(mut i.cell.word, seen, next) {
        seen = i.cell.word
        next = f(seen)
    }
    next
}

fn word_of(b: bool) -> i64 {
    if b { 1 } else { 0 }
}

/// Returns a `Bool` holding `initial`.
pub fn boolean(initial: bool) -> Bool {
    Bool { word: int(word_of(initial)) }
}

/// Returns the current value of `b`.
pub fn load_bool(b: Bool) -> bool {
    load_int(b.word) != 0
}

/// Sets `b` to `v`.
pub fn store_bool(b: Bool, v: bool) {
    store_int(b.word, word_of(v))
}

/// Sets `b` to `v` and returns the value it held before.
pub fn swap_bool(b: Bool, v: bool) -> bool {
    swap_int(b.word, word_of(v)) != 0
}

/// Sets `b` to `v` if it currently equals `old`, and returns whether it did.
pub fn compare_and_swap_bool(b: Bool, old: bool, v: bool) -> bool {
    compare_and_swap_int(b.word, word_of(old), word_of(v))
}

/// Returns a cleared `Flag`.
pub fn flag() -> Flag {
    Flag { word: int(0) }
}

/// Returns whether `f` is set.
pub fn is_set(f: Flag) -> bool {
    load_int(f.word) != 0
}

/// Sets `f` and returns whether this call was the one that changed it from cleared to set.
///
/// Exactly one of several concurrent callers sees `true`, which makes `set` suitable for running something once.
pub fn set(f: Flag) -> bool {
    compare_and_swap_int(f.word, 0, 1)
}

/// Clears `f` and returns whether this call was the one that changed it from set to cleared.
pub fn clear(f: Flag) -> bool {
    compare_and_swap_int(f.word, 1, 0)
}

/// Returns a `Value` holding a copy of `initial`.
pub fn value[T](initial: T) -> Value[T] {
    Value { slot: new(Slot { lock: 0, current: new(initial) }) }
}

/// Returns a pointer to the value currently stored in `v`, without copying it.
///
/// The pointed-to value is never modified; later stores make the cell point elsewhere. The pointer identifies a version of the cell for `compare_and_swap_value`.
pub fn snapshot_value[T](v: Value[T]) -> *T {
    let s = v.slot
    __lock(mut s.lock)
    let held = s.current
    __unlock(mut s.lock)
    held
}

/// Returns a copy of the value currently stored in `v`.
pub fn load_value[T](v: Value[T]) -> T {
    *snapshot_value(v)
}

/// Replaces the value of `v` with `next`.
pub fn store_value[T](v: Value[T], next: T) {
    let previous = swap_value(v, next)
}

/// Replaces the value of `v` with `next` and returns the value it held before.
pub fn swap_value[T](v: Value[T], next: T) -> T {
    let s = v.slot
    let fresh = new(next)
    __lock(mut s.lock)
    let held = s.current
    s.current = fresh
    __unlock(mut s.lock)
    *held
}

/// Replaces the value of `v` with `next` if it still holds the version `seen`, and returns whether it did.
///
/// `seen` is a pointer from `snapshot_value`. The comparison is by pointer identity, not by equality of the values, so a cell that was stored with an equal value since the snapshot does not match.
pub fn compare_and_swap_value[T](v: Value[T], seen: *T, next: T) -> bool {
    let s = v.slot
    let fresh = new(next)
    __lock(mut s.lock)
    let matches = s.current == seen
    if matches {
        s.current = fresh
    }
    __unlock(mut s.lock)
    matches
}

/// Replaces the value of `v` with `f` applied to it, and returns the stored result.
///
/// If another green thread stores to `v` while `f` runs, `f` runs again on the new value, so `f` can run more than once and should not have side effects.
pub fn update_value[T](v: Value[T], f: fn(T) -> T) -> T {
    for {
        let seen = snapshot_value(v)
        let next = f(*seen)
        if compare_and_swap_value(v, seen, next) {
            return next
        }
    }
}
