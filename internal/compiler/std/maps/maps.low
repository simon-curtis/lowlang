import std/slices

pub fn keys[K: Hash, V](m: [K: V]) -> []K {
    var out: []K = []
    for k in m {
        push(mut out, k)
    }
    out
}

pub fn values[K: Hash, V](m: [K: V]) -> []V {
    var out: []V = []
    for _, v in m {
        push(mut out, v)
    }
    out
}

pub fn sorted_keys[K: Hash + Ord, V](m: [K: V]) -> []K {
    var out = keys(m)
    out |> slices.sort()
    out
}

pub fn entries[K: Hash, V](m: [K: V]) -> []slices.Pair[K, V] {
    var out: []slices.Pair[K, V] = []
    for k, v in m {
        push(mut out, slices.Pair[K, V] { first: k, second: v })
    }
    out
}

pub fn from_pairs[K: Hash, V](pairs: []slices.Pair[K, V]) -> [K: V] {
    var out: [K: V] = [:]
    for p in pairs {
        out[p.first] = p.second
    }
    out
}

pub fn clone[K: Hash, V](m: [K: V]) -> [K: V] {
    var out: [K: V] = [:]
    for k, v in m {
        out[k] = v
    }
    out
}

pub fn merge[K: Hash, V](base: [K: V], over: [K: V]) -> [K: V] {
    var out = clone(base)
    for k, v in over {
        out[k] = v
    }
    out
}

pub fn filter[K: Hash, V](m: [K: V], keep: fn(K, V) -> bool) -> [K: V] {
    var out: [K: V] = [:]
    for k, v in m {
        if keep(k, v) {
            out[k] = v
        }
    }
    out
}

pub fn map_values[K: Hash, V, U](m: [K: V], f: fn(V) -> U) -> [K: U] {
    var out: [K: U] = [:]
    for k, v in m {
        out[k] = f(v)
    }
    out
}

pub fn has[K: Hash, V](m: [K: V], key: K) -> bool {
    match m[key] {
        some(_) => true
        none => false
    }
}

pub fn get_or[K: Hash, V](m: [K: V], key: K, fallback: V) -> V {
    m[key] ?? fallback
}

pub fn invert[K: Hash, V: Hash](m: [K: V]) -> [V: K] {
    var out: [V: K] = [:]
    for k, v in m {
        out[v] = k
    }
    out
}

pub fn count_by[T, K: Hash](xs: []T, key: fn(T) -> K) -> [K: i64] {
    var out: [K: i64] = [:]
    for x in xs {
        out[key(x)] += 1
    }
    out
}

pub fn group_by[T, K: Hash](xs: []T, key: fn(T) -> K) -> [K: []T] {
    var out: [K: []T] = [:]
    for x in xs {
        let k = key(x)
        var group: []T = out[k] ?? []
        push(mut group, x)
        out[k] = group
    }
    out
}
