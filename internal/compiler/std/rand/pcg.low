fn pcg32_step(mut r: Rng) {
    r.s0 = r.s0 * 6364136223846793005 + r.s1
}

/// Returns a PCG-XSH-RR 32-bit generator with a 64-bit state, started from `seed` on the sequence selected by `stream`.
///
/// Generators with different `stream` values produce independent sequences from the same `seed`. `next32` returns one native 32-bit output and `next` joins two of them.
pub fn pcg32(seed: u64, stream: u64) -> Rng {
    var r = Rng { engine: Pcg32, s1: stream << 1 | 1 }
    pcg32_step(mut r)
    r.s0 += seed
    pcg32_step(mut r)
    r
}

fn pcg32_next(mut r: Rng) -> u32 {
    let old = r.s0
    pcg32_step(mut r)
    let xorshifted = u32((old >> 18 ^ old) >> 27)
    let rot = u32(old >> 59)
    xorshifted >> rot | xorshifted << (32 - rot)
}

fn pcg64_step(mut r: Rng) {
    let low_multiplier: u64 = 0x4385DF649FCCF645
    let high_multiplier: u64 = 0x2360ED051FC65DA4
    let hi = r.s0
    let lo = r.s1
    let product_lo = lo * low_multiplier
    let product_hi = __mulhi(lo, low_multiplier) + lo * high_multiplier + hi * low_multiplier
    let sum = product_lo + r.s3
    let carry: u64 = if sum < product_lo { 1 } else { 0 }
    r.s1 = sum
    r.s0 = product_hi + r.s2 + carry
}

/// Returns a PCG-XSL-RR 128-bit generator (`pcg64`) with a 128-bit state, started from `seed` on the sequence selected by `stream`.
///
/// Generators with different `stream` values produce independent sequences from the same `seed`. The `seed` is added to the low 64 bits of the 128-bit state and the `stream` selects the odd 128-bit increment `stream << 1 | 1`. `next` returns one native 64-bit output.
pub fn pcg64(seed: u64, stream: u64) -> Rng {
    var r = Rng { engine: Pcg64, s2: stream >> 63, s3: stream << 1 | 1 }
    pcg64_step(mut r)
    let sum = r.s1 + seed
    let carry: u64 = if sum < r.s1 { 1 } else { 0 }
    r.s1 = sum
    r.s0 += carry
    pcg64_step(mut r)
    r
}

fn pcg64_next(mut r: Rng) -> u64 {
    pcg64_step(mut r)
    let x = r.s0 ^ r.s1
    let rot = r.s0 >> 58
    x >> rot | x << (64 - rot)
}
