import std/crypto

fn quarter(x: []u32, a: i64, b: i64, c: i64, d: i64) {
    x[a] += x[b]
    x[d] ^= x[a]
    x[d] = x[d] << 16 | x[d] >> 16
    x[c] += x[d]
    x[b] ^= x[c]
    x[b] = x[b] << 12 | x[b] >> 20
    x[a] += x[b]
    x[d] ^= x[a]
    x[d] = x[d] << 8 | x[d] >> 24
    x[c] += x[d]
    x[b] ^= x[c]
    x[b] = x[b] << 7 | x[b] >> 25
}

fn chacha_state(r: Rng) -> []u32 {
    let x: []u32 = __make(16)
    x[0] = 0x61707865
    x[1] = 0x3320646E
    x[2] = 0x79622D32
    x[3] = 0x6B206574
    let key: []u64 = [r.s0, r.s1, r.s2, r.s3]
    for i in 0..4 {
        x[4 + 2 * i] = u32(key[i])
        x[5 + 2 * i] = u32(key[i] >> 32)
    }
    x[12] = u32(r.counter)
    x[13] = u32(r.counter >> 32)
    x[14] = 0
    x[15] = 0
    x
}

fn chacha_block(r: Rng) -> []u64 {
    let initial = chacha_state(r)
    let x: []u32 = __make(16)
    __memmove(x, initial)
    for _ in 0..10 {
        quarter(x, 0, 4, 8, 12)
        quarter(x, 1, 5, 9, 13)
        quarter(x, 2, 6, 10, 14)
        quarter(x, 3, 7, 11, 15)
        quarter(x, 0, 5, 10, 15)
        quarter(x, 1, 6, 11, 12)
        quarter(x, 2, 7, 8, 13)
        quarter(x, 3, 4, 9, 14)
    }
    let out: []u64 = __make(8)
    for i in 0..8 {
        let low = x[2 * i] + initial[2 * i]
        let high = x[2 * i + 1] + initial[2 * i + 1]
        out[i] = u64(low) | u64(high) << 32
    }
    out
}

fn word_le(b: []u8, at: i64) -> u64 {
    var w: u64 = 0
    for i in 0..8 {
        w |= u64(b[at + i]) << u64(8 * i)
    }
    w
}

fn chacha_from(seed: []u8) -> Rng {
    Rng {
        engine: ChaCha
        s0: word_le(seed, 0)
        s1: word_le(seed, 8)
        s2: word_le(seed, 16)
        s3: word_le(seed, 24)
        pos: 8
    }
}

pub fn chacha(seed: []u8) -> Rng ! Error {
    if seed.len != 32 {
        fail BadSeed
    }
    chacha_from(seed)
}

pub fn chacha_rng() -> Rng {
    let seed = crypto.random(32)
    chacha_from(seed)
}

fn chacha_next(mut r: Rng) -> u64 {
    if r.pos >= 8 {
        r.block = chacha_block(r)
        r.counter += 1
        r.pos = 0
    }
    let result = r.block[r.pos]
    r.pos += 1
    result
}
