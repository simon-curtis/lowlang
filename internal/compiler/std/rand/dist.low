import std/math

fn positive(mut r: Rng) -> f64 {
    1.0 - float(mut r)
}

fn magnitude(x: f64) -> f64 {
    if x < 0.0 { -x } else { x }
}

fn ln(x: f64) -> f64 {
    var m = x
    var e = 0
    for m > 1.4142135623730951 {
        m *= 0.5
        e += 1
    }
    for m < 0.7071067811865476 {
        m *= 2.0
        e -= 1
    }
    let s = (m - 1.0) / (m + 1.0)
    let s2 = s * s
    var sum = 0.0
    var k = 23
    for k >= 1 {
        sum = sum * s2 + 2.0 / f64(k)
        k -= 2
    }
    f64(e) * 0.6931471805599453 + s * sum
}

fn standard_normal(mut r: Rng) -> f64 {
    if r.has_spare {
        r.has_spare = false
        return r.spare
    }
    for {
        let u = 2.0 * float(mut r) - 1.0
        let v = 2.0 * float(mut r) - 1.0
        let s = u * u + v * v
        if s >= 1.0 || s == 0.0 {
            continue
        }
        let factor = sqrt(-2.0 * ln(s) / s)
        r.spare = v * factor
        r.has_spare = true
        return u * factor
    }
}

/// Returns a normally distributed `f64` with the given `mean` and standard deviation `sd`.
///
/// Uses the Marsaglia polar method, which produces values in pairs; the second value is kept in the generator for the next call.
pub fn normal(mut r: Rng, mean: f64, sd: f64) -> f64 {
    mean + sd * standard_normal(mut r)
}

/// Returns an exponentially distributed `f64` with the given `rate`, so the mean is `1 / rate`.
///
/// Uses inversion. Panics when `rate` is not positive.
pub fn exponential(mut r: Rng, rate: f64) -> f64 {
    if rate <= 0.0 {
        __panic("rand: exponential needs a positive rate")
    }
    -ln(positive(mut r)) / rate
}

/// Returns a gamma distributed `f64` with the given `shape` and `scale`.
///
/// Uses the Marsaglia and Tsang method; a `shape` below `1.0` is boosted by one and corrected with a power of a uniform draw. The mean is `shape * scale`. Panics when `shape` or `scale` is not positive.
pub fn gamma(mut r: Rng, shape: f64, scale: f64) -> f64 {
    if shape <= 0.0 || scale <= 0.0 {
        __panic("rand: gamma needs a positive shape and scale")
    }
    if shape < 1.0 {
        let boosted = gamma_unit(mut r, shape + 1.0)
        return scale * boosted * exp(ln(positive(mut r)) / shape)
    }
    scale * gamma_unit(mut r, shape)
}

fn gamma_unit(mut r: Rng, shape: f64) -> f64 {
    let d = shape - 1.0 / 3.0
    let c = 1.0 / sqrt(9.0 * d)
    for {
        let x = standard_normal(mut r)
        let t = 1.0 + c * x
        if t <= 0.0 {
            continue
        }
        let v = t * t * t
        let u = positive(mut r)
        let x2 = x * x
        if u < 1.0 - 0.0331 * x2 * x2 {
            return d * v
        }
        if ln(u) < 0.5 * x2 + d * (1.0 - v + ln(v)) {
            return d * v
        }
    }
}

/// Returns a beta distributed `f64` in `[0, 1]` with shape parameters `a` and `b`.
///
/// Computed as `x / (x + y)` for two gamma draws. Panics when `a` or `b` is not positive.
pub fn beta(mut r: Rng, a: f64, b: f64) -> f64 {
    let x = gamma(mut r, a, 1.0)
    let y = gamma(mut r, b, 1.0)
    x / (x + y)
}

fn log_factorial(k: i64) -> f64 {
    if k < 20 {
        var total = 0.0
        for i in 2..k + 1 {
            total += ln(f64(i))
        }
        return total
    }
    let x = f64(k)
    let inverse = 1.0 / x
    let inverse2 = inverse * inverse
    x * ln(x) - x + 0.5 * ln(math.tau() * x) + inverse * (1.0 / 12.0 - inverse2 * (1.0 / 360.0 - inverse2 / 1260.0))
}

/// Returns a Poisson distributed count with mean `lambda`.
///
/// Returns `0` for a `lambda` of `0.0`. Uses Knuth's multiplication method below `10.0` and the PTRS transformed rejection method (Hormann) from there. Panics when `lambda` is negative.
pub fn poisson(mut r: Rng, lambda: f64) -> i64 {
    if lambda < 0.0 {
        __panic("rand: poisson needs a non-negative mean")
    }
    if lambda == 0.0 {
        return 0
    }
    if lambda < 10.0 {
        return poisson_knuth(mut r, lambda)
    }
    poisson_ptrs(mut r, lambda)
}

fn poisson_knuth(mut r: Rng, lambda: f64) -> i64 {
    let limit = exp(-lambda)
    var k = 0
    var p = float(mut r)
    for p > limit {
        k += 1
        p *= float(mut r)
    }
    k
}

fn poisson_ptrs(mut r: Rng, lambda: f64) -> i64 {
    let slam = sqrt(lambda)
    let loglam = ln(lambda)
    let b = 0.931 + 2.53 * slam
    let a = -0.059 + 0.02483 * b
    let log_inverse_alpha = ln(1.1239 + 1.1328 / (b - 3.4))
    let vr = 0.9277 - 3.6224 / (b - 2.0)
    for {
        let u = float(mut r) - 0.5
        let v = positive(mut r)
        let us = 0.5 - magnitude(u)
        let k = i64(floor((2.0 * a / us + b) * u + lambda + 0.43))
        if us >= 0.07 && v <= vr {
            return k
        }
        if k < 0 || us < 0.013 && v > us {
            continue
        }
        let lhs = ln(v) + log_inverse_alpha - ln(a / (us * us) + b)
        if lhs <= -lambda + f64(k) * loglam - log_factorial(k) {
            return k
        }
    }
}

/// Returns the number of successes in `n` independent trials that each succeed with probability `p`.
///
/// The result is in `0..=n`. Uses sequential inversion when `n` times the smaller of `p` and `1 - p` is below `10.0`, and the BTRS transformed rejection method (Hormann) otherwise. Panics when `n` is negative or `p` is outside `[0, 1]`.
pub fn binomial(mut r: Rng, n: i64, p: f64) -> i64 {
    if n < 0 || p < 0.0 || p > 1.0 {
        __panic("rand: binomial needs n >= 0 and p between 0 and 1")
    }
    if n == 0 || p == 0.0 {
        return 0
    }
    if p == 1.0 {
        return n
    }
    let flip = p > 0.5
    let q = if flip { 1.0 - p } else { p }
    let k = if f64(n) * q < 10.0 { binomial_inversion(mut r, n, q) } else { binomial_btrs(mut r, n, q) }
    if flip {
        return n - k
    }
    k
}

fn binomial_inversion(mut r: Rng, n: i64, p: f64) -> i64 {
    let q = 1.0 - p
    let s = p / q
    let a = f64(n + 1) * s
    var weight = exp(f64(n) * ln(q))
    var u = float(mut r)
    var k = 0
    for u > weight && k < n {
        u -= weight
        k += 1
        weight *= a / f64(k) - s
    }
    k
}

fn binomial_btrs(mut r: Rng, n: i64, p: f64) -> i64 {
    let q = 1.0 - p
    let spq = sqrt(f64(n) * p * q)
    let b = 1.15 + 2.53 * spq
    let a = -0.0873 + 0.0248 * b + 0.01 * p
    let c = f64(n) * p + 0.5
    let vr = 0.92 - 4.2 / b
    let alpha = (2.83 + 5.1 / b) * spq
    let lpq = ln(p / q)
    let m = i64(floor(f64(n + 1) * p))
    let h = log_factorial(m) + log_factorial(n - m)
    for {
        let u = float(mut r) - 0.5
        let us = 0.5 - magnitude(u)
        let k = i64(floor((2.0 * a / us + b) * u + c))
        if k < 0 || k > n {
            continue
        }
        let v = positive(mut r)
        if us >= 0.07 && v <= vr {
            return k
        }
        let lhs = ln(v * alpha / (a / (us * us) + b))
        if lhs <= h - log_factorial(k) - log_factorial(n - k) + f64(k - m) * lpq {
            return k
        }
    }
}

/// Returns the number of trials up to and including the first success when each trial succeeds with probability `p`.
///
/// The result is at least `1`, and is always `1` when `p` is `1.0`. Panics when `p` is not in `(0, 1]`.
pub fn geometric(mut r: Rng, p: f64) -> i64 {
    if p <= 0.0 || p > 1.0 {
        __panic("rand: geometric needs p in (0, 1]")
    }
    if p == 1.0 {
        return 1
    }
    i64(floor(ln(positive(mut r)) / ln(1.0 - p))) + 1
}

fn series_expm1(x: f64) -> f64 {
    if magnitude(x) < 0.01 {
        return 1.0 + x * (1.0 / 2.0 + x * (1.0 / 6.0 + x * (1.0 / 24.0 + x * (1.0 / 120.0 + x / 720.0))))
    }
    (exp(x) - 1.0) / x
}

fn series_log1p(x: f64) -> f64 {
    if magnitude(x) < 0.01 {
        return 1.0 - x * (1.0 / 2.0 - x * (1.0 / 3.0 - x * (1.0 / 4.0 - x * (1.0 / 5.0 - x / 6.0))))
    }
    ln(1.0 + x) / x
}

fn zipf_integral(x: f64, s: f64) -> f64 {
    let l = ln(x)
    series_expm1((1.0 - s) * l) * l
}

fn zipf_inverse(x: f64, s: f64) -> f64 {
    let t = x * (1.0 - s)
    exp(series_log1p(t) * x)
}

fn zipf_weight(x: f64, s: f64) -> f64 {
    exp(-s * ln(x))
}

/// Returns a Zipf distributed rank in `1..=n` where rank `k` has probability proportional to `k` raised to the power `-s`.
///
/// Uses rejection-inversion sampling (Hormann and Derflinger), so it takes constant time for any `n`. Returns `1` when `n` is `1`. Panics when `n` is less than `1` or `s` is not positive.
pub fn zipf(mut r: Rng, n: i64, s: f64) -> i64 {
    if n < 1 || s <= 0.0 {
        __panic("rand: zipf needs n >= 1 and a positive exponent")
    }
    if n == 1 {
        return 1
    }
    let top = zipf_integral(f64(n) + 0.5, s)
    let bottom = zipf_integral(1.5, s) - 1.0
    let shortcut = 2.0 - zipf_inverse(zipf_integral(2.5, s) - zipf_weight(2.0, s), s)
    for {
        let u = top + float(mut r) * (bottom - top)
        let x = zipf_inverse(u, s)
        var k = i64(x + 0.5)
        if k < 1 {
            k = 1
        } else if k > n {
            k = n
        }
        let fk = f64(k)
        if fk - x <= shortcut || u >= zipf_integral(fk + 0.5, s) - zipf_weight(fk, s) {
            return k
        }
    }
}

/// Returns the running sums of `weights`.
///
/// The result has the same length as `weights`. Pass it to `pick_cumulative` to draw many times from the same weights without recomputing it. An empty input gives an empty result.
pub fn cumulative(weights: []f64) -> []f64 {
    let out: []f64 = __make(weights.len)
    var total = 0.0
    for i, w in weights {
        total += w
        out[i] = total
    }
    out
}

/// Returns the index drawn with probability proportional to its weight, given the running sums from `cumulative`, or `none` when the slice is empty or its total is not positive.
///
/// Finds the index by binary search, so each draw takes `O(log n)` time. An index whose weight is `0` is never returned.
pub fn pick_cumulative(mut r: Rng, cumulative_weights: []f64) -> i64? {
    if cumulative_weights.len == 0 {
        return none
    }
    let total = cumulative_weights[cumulative_weights.len - 1]
    if total <= 0.0 {
        return none
    }
    let target = float(mut r) * total
    var low = 0
    var high = cumulative_weights.len - 1
    for low < high {
        let mid = (low + high) / 2
        if cumulative_weights[mid] > target {
            high = mid
        } else {
            low = mid + 1
        }
    }
    low
}

/// Returns an index drawn with probability proportional to its entry in `weights`, or `none` when `weights` is empty or sums to zero or less.
///
/// Builds the running sums on every call; use `cumulative` and `pick_cumulative` for repeated draws.
pub fn weighted_pick(mut r: Rng, weights: []f64) -> i64? {
    let cumulative_weights = cumulative(weights)
    pick_cumulative(mut r, cumulative_weights)
}

/// Returns the integers `0` up to `n - 1` in a random order.
///
/// Every permutation is equally likely. Returns an empty slice for `n` of `0`. Panics when `n` is negative.
pub fn permutation(mut r: Rng, n: i64) -> []i64 {
    if n < 0 {
        __panic("rand: permutation needs a non-negative length")
    }
    var out: []i64 = __make(n)
    for i in 0..n {
        out[i] = i
    }
    shuffle(mut r, mut out)
    out
}

/// Returns `k` distinct integers from `0..n` in a random order.
///
/// Uses Floyd's algorithm, so it does not allocate an `n`-sized slice. Panics unless `0 <= k <= n`.
pub fn sample(mut r: Rng, n: i64, k: i64) -> []i64 {
    if k < 0 || k > n {
        __panic("rand: sample needs 0 <= k <= n")
    }
    var chosen: [i64: bool] = [:]
    var out: []i64 = []
    for j in n - k..n {
        let t = below(mut r, j + 1)
        let item = if chosen[t] ?? false { j } else { t }
        chosen[item] = true
        push(mut out, item)
    }
    shuffle(mut r, mut out)
    out
}
