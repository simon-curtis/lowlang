import std/crypto

pub struct Rng {
    s0: u64 = 0
    s1: u64 = 0
    s2: u64 = 0
    s3: u64 = 0
}

fn rotl(x: u64, k: u64) -> u64 {
    x << k | x >> (64 - k)
}

fn splitmix(mut state: u64) -> u64 {
    state += 0x9E3779B97F4A7C15
    var z = state
    z = (z ^ z >> 30) * 0xBF58476D1CE4E5B9
    z = (z ^ z >> 27) * 0x94D049BB133111EB
    z ^ z >> 31
}

pub fn seeded(seed: u64) -> Rng {
    var state = seed
    Rng { s0: splitmix(mut state), s1: splitmix(mut state), s2: splitmix(mut state), s3: splitmix(mut state) }
}

pub fn rng() -> Rng {
    let entropy = crypto.random(8)
    var seed: u64 = 0
    for b in entropy {
        seed = seed << 8 | u64(b)
    }
    seeded(seed)
}

pub fn next(mut r: Rng) -> u64 {
    let result = rotl(r.s1 * 5, 7) * 9
    let t = r.s1 << 17
    r.s2 ^= r.s0
    r.s3 ^= r.s1
    r.s1 ^= r.s2
    r.s0 ^= r.s3
    r.s2 ^= t
    r.s3 = rotl(r.s3, 45)
    result
}

pub fn below(mut r: Rng, n: i64) -> i64 {
    if n <= 0 {
        __panic("rand: below needs a positive bound")
    }
    let bound = u64(n)
    let threshold = (0 - bound) % bound
    for {
        let x = next(mut r)
        if x * bound >= threshold {
            return i64(__mulhi(x, bound))
        }
    }
}

pub fn between(mut r: Rng, lo: i64, hi: i64) -> i64 {
    lo + below(mut r, hi - lo + 1)
}

pub fn float(mut r: Rng) -> f64 {
    f64(next(mut r) >> 11) / 9007199254740992.0
}

pub fn chance(mut r: Rng, p: f64) -> bool {
    float(mut r) < p
}

pub fn shuffle[T](mut r: Rng, mut xs: []T) {
    var i = xs.len - 1
    for i > 0 {
        let j = below(mut r, i + 1)
        let swap = xs[i]
        xs[i] = xs[j]
        xs[j] = swap
        i -= 1
    }
}

pub fn pick[T](mut r: Rng, xs: []T) -> T? {
    if xs.len == 0 {
        return none
    }
    xs[below(mut r, xs.len)]
}
