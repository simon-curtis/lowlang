import std/otel
import std/serde
import std/sql

fn unit_enum(s: serde.Schema) -> bool {
    for v in s.variants {
        if v.fields.len > 0 {
            return false
        }
    }
    true
}

fn column_type(d: sql.Dialect, s: serde.Schema) -> str {
    let postgres = d == Postgres
    match s.kind {
        Bool => if postgres { "boolean" } else { "bit" }
        Int => if s.bits > 32 { "bigint" } else if s.bits > 16 { "integer" } else { "smallint" }
        Uint => if s.bits == 64 { "numeric(20, 0)" } else if s.bits > 16 { "bigint" } else { "integer" }
        Float => if s.bits == 32 { "real" } else if postgres { "double precision" } else { "float" }
        Text => if postgres { "text" } else { "nvarchar(max)" }
        Binary => if postgres { "bytea" } else { "varbinary(max)" }
        Optional => column_type(d, s.items[0])
        Enum => {
            if unit_enum(s) {
                if postgres { "text" } else { "nvarchar(200)" }
            } else if postgres {
                "jsonb"
            } else {
                "nvarchar(max)"
            }
        }
        _ => if postgres { "jsonb" } else { "nvarchar(max)" }
    }
}

fn nullable(s: serde.Schema) -> bool {
    match s.kind {
        Optional => true
        _ => false
    }
}

pub fn create_table_sql[T](d: sql.Dialect, t: Table[T]) -> str {
    let s = statement(d)
    emit(s, "CREATE TABLE ")
    name(s, t.name)
    emit(s, " (")
    for i, p in serde.schema[T]().fields {
        if i > 0 {
            emit(s, ", ")
        }
        name(s, p.name)
        emit(s, " ")
        let key = p.name == t.key
        let integer_key = key && p.schema.kind == Int
        if integer_key && d == SqlServer {
            emit(s, "bigint IDENTITY(1, 1) PRIMARY KEY")
            continue
        }
        if integer_key {
            emit(s, "bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY")
            continue
        }
        if key && d == SqlServer && p.schema.kind == Text {
            emit(s, "nvarchar(450) PRIMARY KEY")
            continue
        }
        emit(s, column_type(d, p.schema))
        if key {
            emit(s, " PRIMARY KEY")
        } else if !nullable(p.schema) {
            emit(s, " NOT NULL")
        }
    }
    emit(s, ")")
    __str_view(s.text)
}

pub fn create_table[T](db: sql.Connection, t: Table[T]) ! sql.Error {
    otel.sql_execute(db, "std/orm", "CREATE TABLE", t.name, create_table_sql(db.dialect, t), [])?
}

pub fn drop_table[T](db: sql.Connection, t: Table[T]) ! sql.Error {
    let s = statement(db.dialect)
    emit(s, "DROP TABLE IF EXISTS ")
    name(s, t.name)
    otel.sql_execute(db, "std/orm", "DROP TABLE", t.name, __str_view(s.text), [])?
}
