import std/serde
import std/sql

pub struct Table[T] {
    pub name: str
    pub key: str = "id"
}

pub fn table[T](name: str) -> Table[T] {
    Table { name }
}

pub enum Op {
    Eq
    Ne
    Lt
    Le
    Gt
    Ge
    Like
}

pub enum Condition[T] {
    Compare(column: str, op: Op, value: sql.Value)
    IsNull(column: str)
    NotNull(column: str)
    OneOf(column: str, values: []sql.Value)
    All(parts: []Condition[T])
    Any(parts: []Condition[T])
    Not(inner: *Condition[T])
    Raw(text: str, values: []sql.Value)
}

fn compare[T, F](f: serde.Field[T, F], op: Op, v: F) -> Condition[T] {
    Compare(f.name, op, value_of(v))
}

pub fn eq[T, F: Eq](f: serde.Field[T, F], v: F) -> Condition[T] {
    compare(f, Eq, v)
}

pub fn ne[T, F: Eq](f: serde.Field[T, F], v: F) -> Condition[T] {
    compare(f, Ne, v)
}

pub fn lt[T, F: Ord](f: serde.Field[T, F], v: F) -> Condition[T] {
    compare(f, Lt, v)
}

pub fn le[T, F: Ord](f: serde.Field[T, F], v: F) -> Condition[T] {
    compare(f, Le, v)
}

pub fn gt[T, F: Ord](f: serde.Field[T, F], v: F) -> Condition[T] {
    compare(f, Gt, v)
}

pub fn ge[T, F: Ord](f: serde.Field[T, F], v: F) -> Condition[T] {
    compare(f, Ge, v)
}

pub fn like[T](f: serde.Field[T, str], pattern: str) -> Condition[T] {
    Compare(f.name, Like, sql.Value.Text(pattern))
}

pub fn is_null[T, F](f: serde.Field[T, F?]) -> Condition[T] {
    IsNull(f.name)
}

pub fn not_null[T, F](f: serde.Field[T, F?]) -> Condition[T] {
    NotNull(f.name)
}

pub fn one_of[T, F](f: serde.Field[T, F], values: []F) -> Condition[T] {
    var out: []sql.Value = []
    for v in values {
        push(mut out, value_of(v))
    }
    OneOf(f.name, out)
}

pub fn all[T](parts: []Condition[T]) -> Condition[T] {
    All(parts)
}

pub fn any[T](parts: []Condition[T]) -> Condition[T] {
    Any(parts)
}

pub fn not[T](c: Condition[T]) -> Condition[T] {
    Not(new(c))
}

pub fn raw[T](text: str, values: []sql.Value) -> Condition[T] {
    Raw(text, values)
}

struct Order {
    column: str
    descending: bool
}

pub struct Query[T] {
    table: Table[T]
    filters: []Condition[T]
    orders: []Order
    count: i64
    offset: i64
}

pub fn from[T](t: Table[T]) -> Query[T] {
    Query { table: t, filters: [], orders: [], count: -1, offset: 0 }
}

pub fn filter[T](q: Query[T], c: Condition[T]) -> Query[T] {
    var out = q
    var filters: []Condition[T] = []
    for f in q.filters {
        push(mut filters, f)
    }
    push(mut filters, c)
    out.filters = filters
    out
}

fn ordered[T](q: Query[T], column: str, descending: bool) -> Query[T] {
    var out = q
    var orders: []Order = []
    for o in q.orders {
        push(mut orders, o)
    }
    push(mut orders, Order { column, descending })
    out.orders = orders
    out
}

pub fn order_by[T, F](q: Query[T], f: serde.Field[T, F]) -> Query[T] {
    ordered(q, f.name, false)
}

pub fn order_by_desc[T, F](q: Query[T], f: serde.Field[T, F]) -> Query[T] {
    ordered(q, f.name, true)
}

pub fn take[T](q: Query[T], n: i64) -> Query[T] {
    var out = q
    out.count = n
    out
}

pub fn skip[T](q: Query[T], n: i64) -> Query[T] {
    var out = q
    out.offset = n
    out
}

struct Statement {
    text: []u8
    values: []sql.Value
    dialect: sql.Dialect
}

fn statement(d: sql.Dialect) -> *Statement {
    new(Statement { text: [], values: [], dialect: d })
}

fn emit(s: *Statement, part: str) {
    for i in 0..part.len {
        push(mut s.text, part[i])
    }
}

fn bind(s: *Statement, v: sql.Value) {
    emit(s, sql.placeholder(s.dialect, s.values.len))
    push(mut s.values, v)
}

fn name(s: *Statement, identifier: str) {
    emit(s, sql.quote_identifier(s.dialect, identifier))
}

fn op_text(op: Op) -> str {
    match op {
        Eq => " = "
        Ne => " <> "
        Lt => " < "
        Le => " <= "
        Gt => " > "
        Ge => " >= "
        Like => " LIKE "
    }
}

fn render[T](s: *Statement, c: Condition[T]) {
    match c {
        Compare(column, op, value) => {
            name(s, column)
            emit(s, op_text(op))
            bind(s, value)
        }
        IsNull(column) => {
            name(s, column)
            emit(s, " IS NULL")
        }
        NotNull(column) => {
            name(s, column)
            emit(s, " IS NOT NULL")
        }
        OneOf(column, values) => {
            if values.len == 0 {
                emit(s, "1 = 0")
                return
            }
            name(s, column)
            emit(s, " IN (")
            for i, v in values {
                if i > 0 {
                    emit(s, ", ")
                }
                bind(s, v)
            }
            emit(s, ")")
        }
        All(parts) => join_conditions(s, parts, " AND ", "1 = 1")
        Any(parts) => join_conditions(s, parts, " OR ", "1 = 0")
        Not(inner) => {
            emit(s, "NOT (")
            render(s, *inner)
            emit(s, ")")
        }
        Raw(text, values) => {
            var at = 0
            var next = 0
            for i in 0..text.len {
                if text[i] == '?' && next < values.len {
                    emit(s, text[at..i])
                    bind(s, values[next])
                    next += 1
                    at = i + 1
                }
            }
            emit(s, text[at..])
        }
    }
}

fn join_conditions[T](s: *Statement, parts: []Condition[T], separator: str, empty: str) {
    if parts.len == 0 {
        emit(s, empty)
        return
    }
    for i, p in parts {
        if i > 0 {
            emit(s, separator)
        }
        emit(s, "(")
        render(s, p)
        emit(s, ")")
    }
}

fn column_names[T]() -> []str {
    var out: []str = []
    for p in serde.schema[T]().fields {
        push(mut out, p.name)
    }
    out
}

fn where_clause[T](s: *Statement, q: Query[T]) {
    if q.filters.len > 0 {
        emit(s, " WHERE ")
        render(s, all(q.filters))
    }
}

fn select_sql[T](d: sql.Dialect, q: Query[T], projection: str) -> *Statement {
    let s = statement(d)
    emit(s, "SELECT ")
    if projection.len > 0 {
        emit(s, projection)
    } else {
        for i, c in column_names[T]() {
            if i > 0 {
                emit(s, ", ")
            }
            name(s, c)
        }
    }
    emit(s, " FROM ")
    name(s, q.table.name)
    where_clause(s, q)
    if projection.len > 0 {
        return s
    }
    if q.orders.len > 0 {
        emit(s, " ORDER BY ")
        for i, o in q.orders {
            if i > 0 {
                emit(s, ", ")
            }
            name(s, o.column)
            if o.descending {
                emit(s, " DESC")
            }
        }
    }
    let paged = q.count >= 0 || q.offset > 0
    match d {
        Postgres => {
            if q.count >= 0 {
                emit(s, " LIMIT {q.count}")
            }
            if q.offset > 0 {
                emit(s, " OFFSET {q.offset}")
            }
        }
        Sqlite => {
            if paged {
                emit(s, " LIMIT {q.count} OFFSET {q.offset}")
            }
        }
        SqlServer => {
            if paged {
                if q.orders.len == 0 {
                    emit(s, " ORDER BY (SELECT NULL)")
                }
                emit(s, " OFFSET {q.offset} ROWS")
                if q.count >= 0 {
                    emit(s, " FETCH NEXT {q.count} ROWS ONLY")
                }
            }
        }
    }
    s
}

pub fn to_sql[T](d: sql.Dialect, q: Query[T]) -> str {
    __str_view(select_sql(d, q, "").text)
}
