import std/text
import std/unicode/utf16

/// The error returned when `.properties` text is malformed.
pub enum Error {
    /// A `\u` escape on `line` is malformed, or holds a surrogate that is not part of a valid pair.
    ///
    /// `line` counts from `1` and is the line on which the entry starts. `message` is `malformed unicode escape` or `unpaired surrogate`.
    Syntax(line: i64, message: str)
}

/// The entries of a Java `.properties` file: a map of keys to values plus the order in which the keys were first set.
pub struct Properties {
    /// The keys in the order they were first set. A key appears once.
    pub keys: []str
    /// The value of each key in `keys`.
    pub values: [str: str]
}

struct Reader {
    lines: []str
    next: i64
}

/// Returns an empty `Properties`.
pub fn empty() -> Properties {
    Properties { keys: [], values: [:] }
}

/// Returns the value of `key`, or `none` when it is not set.
pub fn get(p: Properties, key: str) -> str? {
    p.values[key]
}

/// Sets `key` to `value`.
///
/// A new key is appended to `keys`; an existing key keeps its position and takes the new value.
pub fn set(mut p: Properties, key: str, value: str) {
    if p.values[key] == none {
        push(mut p.keys, key)
    }
    p.values[key] = value
}

/// Parses `.properties` text into a `Properties`.
///
/// Lines end at `\n`, `\r\n` or `\r`. A line whose first non-blank character is `#` or `!` is a comment, and blank lines are skipped; blank means space, tab or form feed. The key ends at the first unescaped `=`, `:` or blank, and a single `=` or `:` with surrounding blanks separates it from the value, which runs to the end of the logical line and is not trimmed at the end. A line ending in an odd number of backslashes continues on the next line, whose leading blanks are dropped; a comment marker on a continuation line is part of the value. In keys and values `\t`, `\n`, `\r` and `\f` are control characters, `\uXXXX` is a UTF-16 code unit with a high and low surrogate escape combining into one character, and `\` before any other character yields that character. A trailing lone backslash at the end of the input is dropped. A key set twice keeps its first position and last value.
///
/// Fails with `Syntax`, which carries the line, for a malformed `\u` escape.
pub fn parse(source: str) -> Properties ! Error {
    var p = empty()
    let unified = text.replace(text.replace(source, "\r\n", "\n"), "\r", "\n")
    let r = new(Reader { lines: text.split(unified, '\n'), next: 0 })
    for r.next < r.lines.len {
        let number = r.next + 1
        let line = skip_space(r.lines[r.next])
        r.next += 1
        if line.len == 0 || line[0] == '#' || line[0] == '!' {
            continue
        }
        let logical = join_continuations(r, line)
        let at = key_end(logical)
        let key = unescape(logical[..at], number)?
        let value = unescape(value_start(logical, at), number)?
        set(mut p, key, value)
    }
    p
}

fn blank(c: u8) -> bool {
    c == ' ' || c == '\t' || c == 0x0C
}

fn skip_space(s: str) -> str {
    var start = 0
    for start < s.len && blank(s[start]) {
        start += 1
    }
    s[start..]
}

fn trailing_backslashes(s: str) -> i64 {
    var n = 0
    for n < s.len && s[s.len - 1 - n] == '\\' {
        n += 1
    }
    n
}

fn join_continuations(r: *Reader, first: str) -> str {
    var out: []u8 = []
    var physical = first
    for {
        if trailing_backslashes(physical) % 2 == 0 {
            text.append(mut out, physical)
            break
        }
        text.append(mut out, physical[..physical.len - 1])
        if r.next >= r.lines.len {
            break
        }
        physical = skip_space(r.lines[r.next])
        r.next += 1
    }
    __str_view(out)
}

fn key_end(s: str) -> i64 {
    var i = 0
    for i < s.len {
        let c = s[i]
        if c == '\\' {
            i += 2
            continue
        }
        if c == '=' || c == ':' || blank(c) {
            return i
        }
        i += 1
    }
    s.len
}

fn value_start(s: str, key_stop: i64) -> str {
    if key_stop >= s.len {
        return ""
    }
    var rest = skip_space(s[key_stop..])
    if rest.len > 0 && (rest[0] == '=' || rest[0] == ':') {
        rest = skip_space(rest[1..])
    }
    rest
}

fn unescape(s: str, number: i64) -> str ! Error {
    var out: []u8 = []
    var i = 0
    for i < s.len {
        let c = s[i]
        if c != '\\' {
            push(mut out, c)
            i += 1
            continue
        }
        if i + 1 >= s.len {
            break
        }
        let e = s[i + 1]
        if e == 'u' {
            i += unicode(mut out, s, i, number)?
            continue
        }
        push(mut out, simple_escape(e))
        i += 2
    }
    __str_view(out)
}

fn simple_escape(e: u8) -> u8 {
    match e {
        == 't' => '\t'
        == 'n' => '\n'
        == 'r' => '\r'
        == 'f' => 0x0C
        _ => e
    }
}

fn hex4(s: str, at: i64, number: i64) -> u16 ! Error {
    if at + 6 > s.len || s[at] != '\\' || s[at + 1] != 'u' {
        fail Syntax(number, "malformed unicode escape")
    }
    let n = text.parse_uint(s[at + 2..at + 6], 16) catch {
        _ => fail Syntax(number, "malformed unicode escape")
    }
    u16(n)
}

fn unicode(mut out: []u8, s: str, at: i64, number: i64) -> i64 ! Error {
    let first = hex4(s, at, number)?
    if utf16.is_low_surrogate(first) {
        fail Syntax(number, "unpaired surrogate")
    }
    if !utf16.is_high_surrogate(first) {
        text.append_char(mut out, u32(first))
        return 6
    }
    let second = hex4(s, at + 6, number) catch {
        _ => fail Syntax(number, "unpaired surrogate")
    }
    if !utf16.is_low_surrogate(second) {
        fail Syntax(number, "unpaired surrogate")
    }
    text.append_char(mut out, utf16.join(first, second))
    12
}

/// Formats `p` as `.properties` text, one `key=value` line per entry in `keys` order, each ending in `\n`.
///
/// Backslash, tab, newline, carriage return and form feed are written as `\\`, `\t`, `\n`, `\r` and `\f`, and `=`, `:`, `#` and `!` are backslash-escaped. Every space in a key and a leading space in a value is written as `\ `. Control characters and non-ASCII characters are written as `\uXXXX`, using a surrogate pair above `U+FFFF`. The output parses back to the same entries.
pub fn format(p: Properties) -> str {
    var out: []u8 = []
    for key in p.keys {
        let value = p.values[key] ?? ""
        text.append(mut out, "{escaped(key, true)}={escaped(value, false)}\n")
    }
    __str_view(out)
}

fn unit(mut out: []u8, n: u16) {
    text.append(mut out, "\\u{text.pad_left(text.radix(i64(n), 16), 4, '0')}")
}

fn escaped(s: str, is_key: bool) -> str {
    var out: []u8 = []
    var first = true
    for c in s {
        if c == '\\' {
            text.append(mut out, "\\\\")
        } else if c == ' ' {
            if first || is_key {
                text.append(mut out, "\\ ")
            } else {
                push(mut out, ' ')
            }
        } else if c == '\t' {
            text.append(mut out, "\\t")
        } else if c == '\n' {
            text.append(mut out, "\\n")
        } else if c == '\r' {
            text.append(mut out, "\\r")
        } else if c == 0x0C {
            text.append(mut out, "\\f")
        } else if c == '=' || c == ':' || c == '#' || c == '!' {
            push(mut out, '\\')
            push(mut out, u8(c))
        } else if c < 0x20 || c > 0x7E {
            var units: []u16 = []
            utf16.encode_rune(mut units, c)
            for u in units {
                unit(mut out, u)
            }
        } else {
            push(mut out, u8(c))
        }
        first = false
    }
    __str_view(out)
}
