/// A database value, used both as a statement parameter and as a cell in a result row.
///
/// Which variants a driver returns depends on the database: SQLite only produces `Null`, `Int`, `Float`, `Text` and `Bytes`, and stores the other variants as integers, text or blobs when they are bound. A driver fails with `Error.Conversion` when it cannot represent a parameter.
pub enum Value {
    /// SQL `NULL`.
    Null
    /// A boolean.
    Bool(value: bool)
    /// A 64-bit signed integer.
    Int(value: i64)
    /// A 64-bit floating point number.
    Float(value: f64)
    /// An exact decimal number as its decimal digits in text form, for example `"12.50"`.
    Decimal(digits: str)
    /// A text string.
    Text(value: str)
    /// A binary string.
    Bytes(value: []u8)
    /// A UUID as its 16 raw bytes.
    Uuid(value: []u8)
    /// A calendar date as the number of days since 1970-01-01.
    Date(days: i64)
    /// A time of day as the number of microseconds since midnight.
    Time(micros: i64)
    /// A date and time without a zone as the number of microseconds since 1970-01-01 00:00:00.
    Timestamp(micros: i64)
    /// A date and time in UTC as the number of microseconds since 1970-01-01 00:00:00 UTC.
    TimestampTz(micros: i64)
}

/// The error the SQL drivers return, which `std/sql/pool` wraps in `pool.Error.Sql`.
pub enum Error {
    /// The connection could not be established.
    Connect
    /// The server rejected the login or the authentication exchange failed.
    Authentication
    /// The connection is closed.
    Closed
    /// Connecting, reading or writing did not finish within `Options.timeout`.
    Timeout
    /// The server sent data the driver does not understand. The driver abandons the connection.
    Protocol
    /// The server or the statement needs a feature the driver does not support, such as an unsupported authentication method or TLS negotiation.
    Unsupported
    /// A value cannot be converted to or from its database representation, or the parameter count does not match the statement.
    Conversion
    /// The connection is in use by another call, or the SQLite database is locked.
    Busy
    /// The server reported an error. `code` is the SQLSTATE on PostgreSQL, the error number on SQL Server and the extended result code on SQLite; `message` is the server's text.
    Server(code: str, message: str)
}

/// A column of a result set.
pub struct Column {
    /// The column name or alias as the database reports it.
    pub name: str
    /// The database's name for the column type, empty when the database reports none.
    pub kind: str
}

/// A fully buffered result set.
pub struct Rows {
    /// The columns of the result. A query that returns no rows still reports them.
    pub columns: []Column
    /// The rows in the order the database returned them; each row has one `Value` per column.
    pub rows: [][]Value
}

/// A copyable view of a database connection, made of closures.
///
/// Copies refer to the same connection and none of them owns it: `close` closes the connection for all of them. `std/orm` and `std/sql/pool` work in terms of this view. The `handle` field of a `Connection` is one.
pub struct ConnectionHandle {
    /// The dialect the connection speaks.
    pub dialect: Dialect
    /// Runs the statement with the parameters and returns all rows.
    pub query: fn(str, []Value) -> Rows ! Error
    /// Runs the statement with the parameters and calls the callback for each row in turn, with the columns and the row. The callback returns `false` to stop early.
    pub each: fn(str, []Value, fn([]Column, []Value) -> bool) ! Error
    /// Runs the statement with the parameters, discards any rows and returns the number of rows affected.
    pub execute: fn(str, []Value) -> i64 ! Error
    /// Starts a transaction.
    pub begin: fn() ! Error
    /// Commits the current transaction.
    pub commit: fn() ! Error
    /// Rolls back the current transaction.
    pub rollback: fn() ! Error
    /// Closes the connection. A second call has no effect.
    pub close: fn()
}

/// An owned database connection that closes the underlying connection when dropped.
///
/// Its `handle` is the copyable view that `std/orm` and `std/sql/pool` work in terms of; `adopt` builds a `Connection` from one.
pub struct Connection {
    /// The copyable view of the connection.
    pub handle: ConnectionHandle
    drop {
        handle.close()
    }
}

/// Returns a `Connection` that owns the connection behind the handle, so that dropping it calls the handle's `close`.
pub fn adopt(h: ConnectionHandle) -> Connection {
    Connection { handle: h }
}

/// Rolls back the current transaction of `h` after `cause` and returns the error to report.
///
/// That is `cause` when the rollback succeeds and the rollback's own error when it fails, because the transaction may then still be open.
pub fn rolled_back(h: ConnectionHandle, cause: Error) -> Error {
    h.rollback() catch {
        e => return e
    }
    cause
}

/// The settings a driver's `connect` function takes.
pub struct Options {
    /// The server host name or address. Defaults to `"localhost"`.
    pub host: str = "localhost"
    /// The server port. `0`, the default, selects the dialect's `default_port`: `5432` for PostgreSQL and `1433` for SQL Server.
    pub port: i64 = 0
    /// The user name. Defaults to empty.
    pub user: str = ""
    /// The password. Defaults to empty.
    pub password: str = ""
    /// The database to use. Defaults to empty, which leaves the choice to the server. `std/sql/sqlite` reads it as the file path and ignores the other fields.
    pub database: str = ""
    /// The application name reported to the server. Defaults to `"lowlang"`.
    pub application: str = "lowlang"
    /// The timeout in milliseconds for connecting and for socket reads and writes. Defaults to `15000`. A timeout fails with `Error.Timeout`.
    pub timeout: i64 = 15000
}
