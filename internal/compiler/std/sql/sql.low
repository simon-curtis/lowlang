pub enum Dialect {
    Postgres
    SqlServer
    Sqlite
}

pub enum Value {
    Null
    Bool(value: bool)
    Int(value: i64)
    Float(value: f64)
    Decimal(digits: str)
    Text(value: str)
    Bytes(value: []u8)
    Uuid(value: []u8)
    Date(days: i64)
    Time(micros: i64)
    Timestamp(micros: i64)
    TimestampTz(micros: i64)
}

pub enum Error {
    Connect
    Authentication
    Closed
    Timeout
    Protocol
    Unsupported
    Conversion
    Busy
    Server(code: str, message: str)
}

pub struct Column {
    pub name: str
    pub kind: str
}

pub struct Rows {
    pub columns: []Column
    pub rows: [][]Value
}

pub struct ConnectionHandle {
    pub dialect: Dialect
    pub query: fn(str, []Value) -> Rows ! Error
    pub each: fn(str, []Value, fn([]Column, []Value) -> bool) ! Error
    pub execute: fn(str, []Value) -> i64 ! Error
    pub begin: fn() ! Error
    pub commit: fn() ! Error
    pub rollback: fn() ! Error
    pub close: fn()
}

pub struct Connection {
    pub dialect: Dialect
    pub query: fn(str, []Value) -> Rows ! Error
    pub each: fn(str, []Value, fn([]Column, []Value) -> bool) ! Error
    pub execute: fn(str, []Value) -> i64 ! Error
    pub begin: fn() ! Error
    pub commit: fn() ! Error
    pub rollback: fn() ! Error
    pub close: fn()
    drop release(close)
}

fn release(finish: fn()) {
    finish()
}

pub fn adopt(h: ConnectionHandle) -> Connection {
    Connection {
        dialect: h.dialect
        query: h.query
        each: h.each
        execute: h.execute
        begin: h.begin
        commit: h.commit
        rollback: h.rollback
        close: h.close
    }
}

pub fn handle(c: Connection) -> ConnectionHandle {
    ConnectionHandle {
        dialect: c.dialect
        query: c.query
        each: c.each
        execute: c.execute
        begin: c.begin
        commit: c.commit
        rollback: c.rollback
        close: c.close
    }
}

pub struct Options {
    pub host: str = "localhost"
    pub port: i64 = 0
    pub user: str = ""
    pub password: str = ""
    pub database: str = ""
    pub application: str = "lowlang"
    pub timeout: i64 = 15000
}

pub fn placeholder(d: Dialect, index: i64) -> str {
    match d {
        Postgres => "${index + 1}"
        SqlServer => "@p{index + 1}"
        Sqlite => "?{index + 1}"
    }
}

pub fn quote_identifier(d: Dialect, name: str) -> str {
    var out: []u8 = []
    let open: u8 = match d {
        SqlServer => '['
        _ => '"'
    }
    let shut: u8 = match d {
        SqlServer => ']'
        _ => '"'
    }
    push(mut out, open)
    for i in 0..name.len {
        if name[i] == shut {
            push(mut out, shut)
        }
        push(mut out, name[i])
    }
    push(mut out, shut)
    __str_view(out)
}

pub fn column_index(columns: []Column, name: str) -> i64 {
    for i, c in columns {
        if c.name == name {
            return i
        }
    }
    -1
}
