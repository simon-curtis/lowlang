import std/io
import std/text

fn md5_table() -> []u32 {
    [
        0xd76aa478, 0xe8c7b756, 0x242070db, 0xc1bdceee, 0xf57c0faf, 0x4787c62a, 0xa8304613, 0xfd469501,
        0x698098d8, 0x8b44f7af, 0xffff5bb1, 0x895cd7be, 0x6b901122, 0xfd987193, 0xa679438e, 0x49b40821,
        0xf61e2562, 0xc040b340, 0x265e5a51, 0xe9b6c7aa, 0xd62f105d, 0x02441453, 0xd8a1e681, 0xe7d3fbc8,
        0x21e1cde6, 0xc33707d6, 0xf4d50d87, 0x455a14ed, 0xa9e3e905, 0xfcefa3f8, 0x676f02d9, 0x8d2a4c8a,
        0xfffa3942, 0x8771f681, 0x6d9d6122, 0xfde5380c, 0xa4beea44, 0x4bdecfa9, 0xf6bb4b60, 0xbebfbc70,
        0x289b7ec6, 0xeaa127fa, 0xd4ef3085, 0x04881d05, 0xd9d4d039, 0xe6db99e5, 0x1fa27cf8, 0xc4ac5665,
        0xf4292244, 0x432aff97, 0xab9423a7, 0xfc93a039, 0x655b59c3, 0x8f0ccc92, 0xffeff47d, 0x85845dd1,
        0x6fa87e4f, 0xfe2ce6e0, 0xa3014314, 0x4e0811a1, 0xf7537e82, 0xbd3af235, 0x2ad7d2bb, 0xeb86d391,
    ]
}

fn md5_shifts() -> []u8 {
    [
        7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22,
        5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20,
        4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23,
        6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21,
    ]
}

fn md5_block(h: []u32, m: []u32, k: []u32, shifts: []u8) {
    var a = h[0]
    var b = h[1]
    var c = h[2]
    var d = h[3]
    for i in 0..64 {
        var f: u32 = 0
        var g = 0
        if i < 16 {
            f = b & c | ~b & d
            g = i
        } else if i < 32 {
            f = d & b | ~d & c
            g = (5 * i + 1) % 16
        } else if i < 48 {
            f = b ^ c ^ d
            g = (3 * i + 5) % 16
        } else {
            f = c ^ (b | ~d)
            g = 7 * i % 16
        }
        let sum = f + a + k[i] + m[g]
        let s = shifts[i]
        a = d
        d = c
        c = b
        b = b + (sum << s | sum >> (32 - s))
    }
    h[0] += a
    h[1] += b
    h[2] += c
    h[3] += d
}

/// Returns the 16-byte MD5 digest of `data`.
///
/// MD5 is broken as a hash; the driver needs it only for PostgreSQL's `md5` password authentication.
pub fn md5(data: []u8) -> []u8 {
    let size = (data.len + 8) / 64 * 64 + 64
    let message: []u8 = __make(size)
    __memmove(message, data)
    message[data.len] = 0x80
    io.set_le64(message, size - 8, data.len * 8)
    let h: []u32 = [0x67452301, 0xefcdab89, 0x98badcfe, 0x10325476]
    let m: []u32 = __make(16)
    let k = md5_table()
    let shifts = md5_shifts()
    for block in 0..size / 64 {
        for j in 0..16 {
            m[j] = u32(io.le32(message, block * 64 + 4 * j))
        }
        md5_block(h, m, k, shifts)
    }
    let out: []u8 = __make(16)
    for j in 0..4 {
        io.set_le32(out, 4 * j, i64(h[j]))
    }
    out
}

fn md5_password(user: str, password: str, salt: []u8) -> str {
    let inner = text.encode_hex(md5(bytes("{password}{user}")))
    var salted = bytes(inner)
    io.append(mut salted, salt)
    "md5{text.encode_hex(md5(salted))}"
}
