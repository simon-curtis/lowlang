import std/base64
import std/crypto/hash
import std/crypto/password
import std/io
import std/sql
import std/text

/// The state of one SCRAM-SHA-256 authentication exchange: the password, the client nonce, the client-first-message body and the server signature `scram_final` computes for `scram_verify`.
pub struct Scram {
    password: str
    nonce: str
    first_bare: str
    server_signature: []u8
}

/// Starts a SCRAM-SHA-256 exchange for `user` and `password` with the client `nonce`. The `,` and `=` characters in `user` are escaped as `=2C` and `=3D`.
pub fn scram(user: str, password: str, nonce: str) -> *Scram {
    var name: []u8 = []
    for i in 0..user.len {
        if user[i] == ',' {
            text.append(mut name, "=2C")
        } else if user[i] == '=' {
            text.append(mut name, "=3D")
        } else {
            push(mut name, user[i])
        }
    }
    let first_bare = "n={__str_view(name)},r={nonce}"
    new(Scram { password, nonce, first_bare, server_signature: [] })
}

/// Returns the client-first-message to send to the server, `n,,n=<user>,r=<nonce>`.
pub fn scram_first(s: *Scram) -> str {
    "n,,{s.first_bare}"
}

fn attribute(message: str, key: u8) -> str ! sql.Error {
    for part in text.split(message, ',') {
        if part.len >= 2 && part[0] == key && part[1] == '=' {
            return part[2..]
        }
    }
    fail Protocol
}

/// Computes the client-final-message, with the proof, from the server-first-message `server_first`.
///
/// Returns `sql.Error.Protocol` when `server_first` lacks the `r`, `s` or `i` attribute, when the server nonce does not extend the client nonce, or when the salt or iteration count is invalid, and `sql.Error.Unsupported` when the server demands an extension. It records the signature `scram_verify` expects.
pub fn scram_final(s: *Scram, server_first: str) -> str ! sql.Error {
    if server_first.len > 0 && server_first[0] == 'm' {
        fail Unsupported
    }
    let combined = attribute(server_first, 'r')?
    let encoded_salt = attribute(server_first, 's')?
    let count = attribute(server_first, 'i')?
    if combined.len <= s.nonce.len || !text.starts_with(combined, s.nonce) {
        fail Protocol
    }
    let iterations = text.parse_uint(count, 10) or fail Protocol
    if iterations < 1 {
        fail Protocol
    }
    let salt = base64.decode(encoded_salt) or fail Protocol
    let a = hash.sha256()
    let salted = password.pbkdf2(a, bytes(s.password), salt, iterations, a.size)
    let client_key = hash.hmac(a, salted, bytes("Client Key"))
    let stored_key = hash.sum(a, client_key)
    let without_proof = "c=biws,r={combined}"
    let auth = bytes("{s.first_bare},{server_first},{without_proof}")
    let proof = hash.hmac(a, stored_key, auth)
    for i in 0..proof.len {
        proof[i] ^= client_key[i]
    }
    let server_key = hash.hmac(a, salted, bytes("Server Key"))
    s.server_signature = hash.hmac(a, server_key, auth)
    "{without_proof},p={base64.encode(proof)}"
}

/// Checks the server-final-message `server_final` against the signature `scram_final` computed.
///
/// Returns `sql.Error.Authentication` when the server reports an `e=` error or the signature differs, and `sql.Error.Protocol` when the message has no `v` attribute or it is not valid base64.
pub fn scram_verify(s: *Scram, server_final: str) ! sql.Error {
    if text.starts_with(server_final, "e=") {
        fail Authentication
    }
    let encoded = attribute(server_final, 'v')?
    let signature = base64.decode(encoded) or fail Protocol
    if s.server_signature.len == 0 || !hash.equal(signature, s.server_signature) {
        fail Authentication
    }
}
