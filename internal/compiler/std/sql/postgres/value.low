import std/io
import std/sql
import std/text
import std/time/date

enum Kind {
    Boolean
    Integer
    Real
    Numeric
    Bytea
    Uuid
    Day
    Clock
    Stamp
    StampZone
    Textual
}

struct TypeInfo {
    name: str
    kind: Kind
}

fn type_table() -> [i64: TypeInfo] {
    [
        16: TypeInfo { name: "bool", kind: Boolean },
        17: TypeInfo { name: "bytea", kind: Bytea },
        18: TypeInfo { name: "char", kind: Textual },
        19: TypeInfo { name: "name", kind: Textual },
        20: TypeInfo { name: "int8", kind: Integer },
        21: TypeInfo { name: "int2", kind: Integer },
        23: TypeInfo { name: "int4", kind: Integer },
        25: TypeInfo { name: "text", kind: Textual },
        26: TypeInfo { name: "oid", kind: Integer },
        114: TypeInfo { name: "json", kind: Textual },
        700: TypeInfo { name: "float4", kind: Real },
        701: TypeInfo { name: "float8", kind: Real },
        705: TypeInfo { name: "unknown", kind: Textual },
        1042: TypeInfo { name: "bpchar", kind: Textual },
        1043: TypeInfo { name: "varchar", kind: Textual },
        1082: TypeInfo { name: "date", kind: Day },
        1083: TypeInfo { name: "time", kind: Clock },
        1114: TypeInfo { name: "timestamp", kind: Stamp },
        1184: TypeInfo { name: "timestamptz", kind: StampZone },
        1186: TypeInfo { name: "interval", kind: Textual },
        1266: TypeInfo { name: "timetz", kind: Textual },
        1700: TypeInfo { name: "numeric", kind: Numeric },
        2950: TypeInfo { name: "uuid", kind: Uuid },
        3802: TypeInfo { name: "jsonb", kind: Textual },
    ]
}

fn parameter_oid(v: sql.Value) -> i64 {
    match v {
        Null => 0
        Bool(_) => 16
        Int(_) => 20
        Float(_) => 701
        Decimal(_) => 1700
        Text(_) => 0
        Bytes(_) => 17
        Uuid(_) => 2950
        Date(_) => 1082
        Time(_) => 1083
        Timestamp(_) => 1114
        TimestampTz(_) => 1184
    }
}

fn micros_per_day() -> i64 {
    86400000000
}

fn infinite() -> i64 {
    0x7FFFFFFFFFFFFFFF
}

fn neg_infinite() -> i64 {
    -0x7FFFFFFFFFFFFFFF - 1
}

fn floor_div(a: i64, b: i64) -> i64 {
    let q = a / b
    if a % b != 0 && (a < 0) != (b < 0) { q - 1 } else { q }
}

fn put_number(mut out: []u8, n: i64, width: i64) {
    var digits = 1
    var scale = 1
    for n / scale >= 10 {
        scale *= 10
        digits += 1
    }
    for _ in digits..width {
        push(mut out, '0')
    }
    for scale > 0 {
        push(mut out, u8('0' + n / scale % 10))
        scale /= 10
    }
}

fn put_date(mut out: []u8, days: i64) -> bool ! sql.Error {
    let d = date.from_epoch_days(days) catch {
        _ => fail Conversion
    }
    let year = date.year(d)
    let bc = year <= 0
    put_number(mut out, if bc { 1 - year } else { year }, 4)
    push(mut out, '-')
    put_number(mut out, date.month_number(d), 2)
    push(mut out, '-')
    put_number(mut out, date.day(d), 2)
    bc
}

fn put_clock(mut out: []u8, micros: i64) {
    let seconds = micros / 1000000
    put_number(mut out, seconds / 3600, 2)
    push(mut out, ':')
    put_number(mut out, seconds / 60 % 60, 2)
    push(mut out, ':')
    put_number(mut out, seconds % 60, 2)
    push(mut out, '.')
    put_number(mut out, micros % 1000000, 6)
}

fn date_text(days: i64) -> str ! sql.Error {
    if days == infinite() {
        return "infinity"
    }
    if days == neg_infinite() {
        return "-infinity"
    }
    var out: []u8 = []
    if put_date(mut out, days)? {
        io.append_str(mut out, " BC")
    }
    __str_view(out)
}

fn stamp_text(micros: i64, zone: bool) -> str ! sql.Error {
    if micros == infinite() {
        return "infinity"
    }
    if micros == neg_infinite() {
        return "-infinity"
    }
    let days = floor_div(micros, micros_per_day())
    var out: []u8 = []
    let bc = put_date(mut out, days)?
    push(mut out, ' ')
    put_clock(mut out, micros - days * micros_per_day())
    if zone {
        io.append_str(mut out, "+00")
    }
    if bc {
        io.append_str(mut out, " BC")
    }
    __str_view(out)
}

fn bytea_text(data: []u8) -> str {
    "\\x{text.encode_hex(data)}"
}

fn uuid_text(data: []u8) -> str ! sql.Error {
    if data.len != 16 {
        fail Conversion
    }
    let h = text.encode_hex(data)
    "{h[..8]}-{h[8..12]}-{h[12..16]}-{h[16..20]}-{h[20..]}"
}

fn float_text(x: f64) -> str {
    if x != x {
        return "NaN"
    }
    if x > 1.7976931348623157e308 {
        return "Infinity"
    }
    if x < -1.7976931348623157e308 {
        return "-Infinity"
    }
    "{x}"
}

fn parameter_text(v: sql.Value) -> str? ! sql.Error {
    match v {
        Null => none
        Bool(b) => if b { "t" } else { "f" }
        Int(n) => "{n}"
        Float(x) => float_text(x)
        Decimal(d) => d
        Text(s) => s
        Bytes(b) => bytea_text(b)
        Uuid(b) => uuid_text(b)?
        Date(d) => date_text(d)?
        Time(t) => {
            if t < 0 || t > micros_per_day() {
                fail Conversion
            }
            var out: []u8 = []
            put_clock(mut out, t)
            __str_view(out)
        }
        Timestamp(t) => stamp_text(t, false)?
        TimestampTz(t) => stamp_text(t, true)?
    }
}

struct Scan {
    s: str
    at: i64
}

fn digits(mut p: Scan, least: i64, most: i64) -> i64 ! sql.Error {
    var n = 0
    var count = 0
    for p.at < p.s.len && count < most && p.s[p.at] >= '0' && p.s[p.at] <= '9' {
        n = n * 10 + i64(p.s[p.at] - '0')
        p.at += 1
        count += 1
    }
    if count < least {
        fail Conversion
    }
    n
}

fn accept(mut p: Scan, c: u8) -> bool {
    if p.at < p.s.len && p.s[p.at] == c {
        p.at += 1
        return true
    }
    false
}

fn expect(mut p: Scan, c: u8) ! sql.Error {
    if !accept(mut p, c) {
        fail Conversion
    }
}

fn scan_date(mut p: Scan, bc: bool) -> i64 ! sql.Error {
    let year = digits(mut p, 4, 9)?
    expect(mut p, '-')?
    let month = digits(mut p, 2, 2)?
    expect(mut p, '-')?
    let day = digits(mut p, 2, 2)?
    if bc && year == 0 {
        fail Conversion
    }
    let d = date.of(if bc { 1 - year } else { year }, month, day) catch {
        _ => fail Conversion
    }
    date.epoch_days(d)
}

fn scan_clock(mut p: Scan) -> i64 ! sql.Error {
    let hours = digits(mut p, 2, 2)?
    expect(mut p, ':')?
    let minutes = digits(mut p, 2, 2)?
    expect(mut p, ':')?
    let seconds = digits(mut p, 2, 2)?
    var micros = 0
    if accept(mut p, '.') {
        let start = p.at
        micros = digits(mut p, 1, 6)?
        for _ in p.at - start..6 {
            micros *= 10
        }
    }
    if hours > 24 || minutes > 59 || seconds > 60 {
        fail Conversion
    }
    ((hours * 60 + minutes) * 60 + seconds) * 1000000 + micros
}

fn scan_offset(mut p: Scan) -> i64 ! sql.Error {
    var sign = 1
    if accept(mut p, '-') {
        sign = -1
    } else {
        expect(mut p, '+')?
    }
    var seconds = digits(mut p, 2, 2)? * 3600
    if accept(mut p, ':') {
        seconds += digits(mut p, 2, 2)? * 60
        if accept(mut p, ':') {
            seconds += digits(mut p, 2, 2)?
        }
    }
    sign * seconds * 1000000
}

fn finish(p: Scan) ! sql.Error {
    if p.at != p.s.len {
        fail Conversion
    }
}

fn era_stripped(s: str) -> str {
    if text.ends_with(s, " BC") { s[..s.len - 3] } else { s }
}

fn infinity_of(s: str) -> i64? {
    if s == "infinity" {
        return infinite()
    }
    if s == "-infinity" {
        return neg_infinite()
    }
    none
}

fn parse_date(s: str) -> i64 ! sql.Error {
    match infinity_of(s) {
        some(v) => return v
        none => {}
    }
    let body = era_stripped(s)
    var p = Scan { s: body, at: 0 }
    let days = scan_date(mut p, body.len != s.len)?
    finish(p)?
    days
}

fn parse_clock(s: str) -> i64 ! sql.Error {
    var p = Scan { s, at: 0 }
    let micros = scan_clock(mut p)?
    finish(p)?
    micros
}

fn parse_stamp(s: str, zone: bool) -> i64 ! sql.Error {
    match infinity_of(s) {
        some(v) => return v
        none => {}
    }
    let body = era_stripped(s)
    var p = Scan { s: body, at: 0 }
    let days = scan_date(mut p, body.len != s.len)?
    expect(mut p, ' ')?
    var micros = days * micros_per_day() + scan_clock(mut p)?
    if zone {
        micros -= scan_offset(mut p)?
    }
    finish(p)?
    micros
}

fn parse_integer(s: str) -> i64 ! sql.Error {
    let negative = s.len > 0 && s[0] == '-'
    let start = if negative { 1 } else { 0 }
    if s.len == start || s.len - start > 19 {
        fail Conversion
    }
    var n = 0
    for i in start..s.len {
        let c = s[i]
        if c < '0' || c > '9' {
            fail Conversion
        }
        let d = i64(c - '0')
        if n < (neg_infinite() + d) / 10 {
            fail Conversion
        }
        n = n * 10 - d
    }
    if negative {
        return n
    }
    if n == neg_infinite() {
        fail Conversion
    }
    -n
}

fn parse_bytea(s: str) -> []u8 ! sql.Error {
    if s.len < 2 || s[0] != '\\' || s[1] != 'x' {
        fail Conversion
    }
    text.decode_hex(s[2..]) catch {
        _ => fail Conversion
    }
}

fn parse_uuid(s: str) -> []u8 ! sql.Error {
    if s.len != 36 || s[8] != '-' || s[13] != '-' || s[18] != '-' || s[23] != '-' {
        fail Conversion
    }
    let digits = "{s[..8]}{s[9..13]}{s[14..18]}{s[19..23]}{s[24..]}"
    text.decode_hex(digits) catch {
        _ => fail Conversion
    }
}

fn decode(kind: Kind, s: str) -> sql.Value ! sql.Error {
    match kind {
        Boolean => {
            if s == "t" {
                return sql.Value.Bool(true)
            }
            if s != "f" {
                fail Conversion
            }
            sql.Value.Bool(false)
        }
        Integer => sql.Value.Int(parse_integer(s)?)
        Real => {
            let x = text.parse_float(s) catch {
                _ => fail Conversion
            }
            sql.Value.Float(x)
        }
        Numeric => sql.Value.Decimal(s)
        Bytea => sql.Value.Bytes(parse_bytea(s)?)
        Uuid => sql.Value.Uuid(parse_uuid(s)?)
        Day => sql.Value.Date(parse_date(s)?)
        Clock => sql.Value.Time(parse_clock(s)?)
        Stamp => sql.Value.Timestamp(parse_stamp(s, false)?)
        StampZone => sql.Value.TimestampTz(parse_stamp(s, true)?)
        Textual => sql.Value.Text(s)
    }
}
