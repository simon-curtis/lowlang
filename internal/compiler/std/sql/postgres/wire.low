import std/io
import std/sql
import std/text

struct Message {
    kind: u8
    body: []u8
    at: i64
}

const max_message = 0x40000000

fn take(mut m: Message, n: i64) -> []u8 ! sql.Error {
    if n < 0 || m.body.len - m.at < n {
        fail Protocol
    }
    let out = m.body[m.at..m.at + n]
    m.at += n
    out
}

fn byte_of(mut m: Message) -> u8 ! sql.Error {
    take(mut m, 1)?[0]
}

fn int16(mut m: Message) -> i64 ! sql.Error {
    let b = take(mut m, 2)?
    i64(u16(io.be16(b, 0)))
}

fn int32(mut m: Message) -> i64 ! sql.Error {
    let b = take(mut m, 4)?
    i64(i32(io.be32(b, 0)))
}

fn cstring(mut m: Message) -> str ! sql.Error {
    for i in m.at..m.body.len {
        if m.body[i] == 0 {
            let s = __str_view(m.body[m.at..i])
            m.at = i + 1
            return s
        }
    }
    fail Protocol
}

fn rest(mut m: Message) -> []u8 {
    let out = m.body[m.at..]
    m.at = m.body.len
    out
}

fn open_message(mut b: []u8, kind: u8) -> i64 {
    push(mut b, kind)
    let at = b.len
    io.put_be32(mut b, 0)
    at
}

fn close_message(b: []u8, at: i64) {
    io.set_be32(b, at, b.len - at)
}

fn put_cstring(mut b: []u8, s: str) {
    text.append(mut b, s)
    push(mut b, 0)
}

fn startup_message(o: sql.Options) -> []u8 {
    var b: []u8 = []
    io.put_be32(mut b, 0)
    io.put_be32(mut b, 196608)
    put_cstring(mut b, "user")
    put_cstring(mut b, o.user)
    if o.database.len > 0 {
        put_cstring(mut b, "database")
        put_cstring(mut b, o.database)
    }
    if o.application.len > 0 {
        put_cstring(mut b, "application_name")
        put_cstring(mut b, o.application)
    }
    put_cstring(mut b, "client_encoding")
    put_cstring(mut b, "UTF8")
    put_cstring(mut b, "DateStyle")
    put_cstring(mut b, "ISO, YMD")
    put_cstring(mut b, "extra_float_digits")
    put_cstring(mut b, "3")
    put_cstring(mut b, "bytea_output")
    put_cstring(mut b, "hex")
    push(mut b, 0)
    io.set_be32(b, 0, b.len)
    b
}

fn ssl_request() -> []u8 {
    [0, 0, 0, 8, 0x04, 0xD2, 0x16, 0x2F]
}

fn cancel_request(process: i64, secret: []u8) -> []u8 {
    var b: []u8 = []
    io.put_be32(mut b, 12 + secret.len)
    io.put_be32(mut b, 80877102)
    io.put_be32(mut b, process)
    io.append(mut b, secret)
    b
}

fn password_message(password: str) -> []u8 {
    var b: []u8 = []
    let at = open_message(mut b, 'p')
    put_cstring(mut b, password)
    close_message(b, at)
    b
}

fn sasl_initial(mechanism: str, first: str) -> []u8 {
    var b: []u8 = []
    let at = open_message(mut b, 'p')
    put_cstring(mut b, mechanism)
    io.put_be32(mut b, first.len)
    text.append(mut b, first)
    close_message(b, at)
    b
}

fn sasl_response(data: str) -> []u8 {
    var b: []u8 = []
    let at = open_message(mut b, 'p')
    text.append(mut b, data)
    close_message(b, at)
    b
}

fn put_query(mut b: []u8, text: str) {
    let at = open_message(mut b, 'Q')
    put_cstring(mut b, text)
    close_message(b, at)
}

fn put_parse(mut b: []u8, name: str, text: str, oids: []i64) {
    let at = open_message(mut b, 'P')
    put_cstring(mut b, name)
    put_cstring(mut b, text)
    io.put_be16(mut b, oids.len)
    for oid in oids {
        io.put_be32(mut b, oid)
    }
    close_message(b, at)
}

struct Parameters {
    oids: []i64
    texts: []str
    present: []bool
}

fn parameters(values: []sql.Value) -> Parameters ! sql.Error {
    let oids: []i64 = __make(values.len)
    let texts: []str = __make(values.len)
    let present: []bool = __make(values.len)
    for i, v in values {
        oids[i] = parameter_oid(v)
        match parameter_text(v)? {
            some(s) => {
                texts[i] = s
                present[i] = true
            }
            none => {}
        }
    }
    Parameters { oids, texts, present }
}

fn put_bind(mut b: []u8, name: str, p: Parameters) {
    let at = open_message(mut b, 'B')
    push(mut b, 0)
    put_cstring(mut b, name)
    io.put_be16(mut b, 0)
    io.put_be16(mut b, p.texts.len)
    for i, s in p.texts {
        if p.present[i] {
            io.put_be32(mut b, s.len)
            text.append(mut b, s)
        } else {
            io.put_be32(mut b, -1)
        }
    }
    io.put_be16(mut b, 0)
    close_message(b, at)
}

fn put_describe_portal(mut b: []u8) {
    let at = open_message(mut b, 'D')
    push(mut b, 'P')
    push(mut b, 0)
    close_message(b, at)
}

fn put_execute(mut b: []u8, limit: i64) {
    let at = open_message(mut b, 'E')
    push(mut b, 0)
    io.put_be32(mut b, limit)
    close_message(b, at)
}

fn put_close_statement(mut b: []u8, name: str) {
    let at = open_message(mut b, 'C')
    push(mut b, 'S')
    put_cstring(mut b, name)
    close_message(b, at)
}

fn put_empty(mut b: []u8, kind: u8) {
    let at = open_message(mut b, kind)
    close_message(b, at)
}

fn put_copy_fail(mut b: []u8, reason: str) {
    let at = open_message(mut b, 'f')
    put_cstring(mut b, reason)
    close_message(b, at)
}

struct Notice {
    severity: str
    code: str
    message: str
    detail: str
}

fn notice(mut m: Message) -> Notice ! sql.Error {
    var n = Notice { severity: "", code: "", message: "", detail: "" }
    for {
        let field = byte_of(mut m)?
        if field == 0 {
            return n
        }
        let value = cstring(mut m)?
        if field == 'V' || field == 'S' && n.severity.len == 0 {
            n.severity = value
        } else if field == 'C' {
            n.code = value
        } else if field == 'M' {
            n.message = value
        } else if field == 'D' {
            n.detail = value
        }
    }
}

fn server_error(n: Notice) -> sql.Error {
    if n.detail.len > 0 {
        return sql.Error.Server(n.code, "{n.message}: {n.detail}")
    }
    sql.Error.Server(n.code, n.message)
}

fn command_count(tag: str) -> i64 {
    var start = tag.len
    for start > 0 && tag[start - 1] >= '0' && tag[start - 1] <= '9' {
        start -= 1
    }
    if start == tag.len || start == 0 || tag[start - 1] != ' ' || tag.len - start > 18 {
        return 0
    }
    var n = 0
    for i in start..tag.len {
        n = n * 10 + i64(tag[i] - '0')
    }
    n
}
