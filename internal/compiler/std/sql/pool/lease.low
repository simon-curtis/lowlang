import std/sql
import std/text

/// The copyable state of a lease: the pool, the leased connection and whether the lease is released, broken or inside a transaction.
///
/// `release_on` and `discard_on` act on it. Every copy refers to the same lease.
pub struct LeaseHandle {
    pool: *State
    slot: Slot
    broken: bool
    released: bool
    in_transaction: bool
    view: sql.ConnectionHandle
}

/// A connection leased from a pool, returned to the pool when dropped.
///
/// Use `conn` or `connection` to run statements on it. Dropping the lease rolls back an open transaction and returns the connection, or closes it when the lease was discarded or a call failed with a connection-level error.
pub struct Lease {
    /// The copyable `LeaseHandle` for the lease.
    pub handle: *LeaseHandle
    drop release_on(handle)
}

fn lease_of(s: *State, slot: Slot) -> Lease {
    let h = new(LeaseHandle {
        pool: s
        slot
        broken: false
        released: false
        in_transaction: false
        view: slot.handle
    })
    h.view = guarded(h)
    Lease { handle: h }
}

fn fatal(e: sql.Error) -> bool {
    match e {
        Connect => true
        Authentication => true
        Closed => true
        Timeout => true
        Protocol => true
        Server(code, message) => text.starts_with(code, "08") || text.starts_with(code, "57P")
        _ => false
    }
}

fn observe(h: *LeaseHandle, e: sql.Error) {
    if fatal(e) {
        h.broken = true
    }
}

fn usable(h: *LeaseHandle) ! sql.Error {
    if h.released || h.broken {
        fail Closed
    }
}

fn run_query(h: *LeaseHandle, text: str, values: []sql.Value) -> sql.Rows ! sql.Error {
    usable(h)?
    h.slot.handle.query(text, values) catch {
        e => {
            observe(h, e)
            fail e
        }
    }
}

fn run_each(h: *LeaseHandle, text: str, values: []sql.Value, visit: fn([]sql.Column, []sql.Value) -> bool) ! sql.Error {
    usable(h)?
    h.slot.handle.each(text, values, visit) catch {
        e => {
            observe(h, e)
            fail e
        }
    }
}

fn run_execute(h: *LeaseHandle, text: str, values: []sql.Value) -> i64 ! sql.Error {
    usable(h)?
    h.slot.handle.execute(text, values) catch {
        e => {
            observe(h, e)
            fail e
        }
    }
}

fn run_begin(h: *LeaseHandle) ! sql.Error {
    usable(h)?
    h.slot.handle.begin() catch {
        e => {
            observe(h, e)
            fail e
        }
    }
    h.in_transaction = true
}

fn run_commit(h: *LeaseHandle) ! sql.Error {
    usable(h)?
    h.slot.handle.commit() catch {
        e => {
            observe(h, e)
            fail e
        }
    }
    h.in_transaction = false
}

fn run_rollback(h: *LeaseHandle) ! sql.Error {
    usable(h)?
    h.slot.handle.rollback() catch {
        e => {
            observe(h, e)
            fail e
        }
    }
    h.in_transaction = false
}

fn guarded(h: *LeaseHandle) -> sql.ConnectionHandle {
    sql.ConnectionHandle {
        dialect: h.slot.handle.dialect
        query: fn(text, values) -> sql.Rows ! sql.Error { run_query(h, text, values) }
        each: fn(text, values, visit) ! sql.Error { run_each(h, text, values, visit)? }
        execute: fn(text, values) -> i64 ! sql.Error { run_execute(h, text, values) }
        begin: fn() ! sql.Error { run_begin(h)? }
        commit: fn() ! sql.Error { run_commit(h)? }
        rollback: fn() ! sql.Error { run_rollback(h)? }
        close: fn() { discard_on(h) }
    }
}

/// Returns the leased connection as an `sql.ConnectionHandle`.
///
/// Its calls fail with `sql.Error.Closed` once the lease is released or broken, and calling its `close` discards the lease instead of closing the connection directly. A call that fails with `Connect`, `Authentication`, `Closed`, `Timeout` or `Protocol`, or with a `Server` error whose code starts with `08` or `57P`, marks the connection broken so that the pool closes it on release.
pub fn conn(l: Lease) -> sql.ConnectionHandle {
    conn_on(l.handle)
}

/// Returns the connection view for the lease behind the handle; see `conn`.
pub fn conn_on(h: *LeaseHandle) -> sql.ConnectionHandle {
    h.view
}

/// Returns the leased connection as an `sql.Connection` whose `close` does nothing, so that dropping it leaves the connection with the lease.
///
/// Its calls behave as those of `conn`.
pub fn connection(l: Lease) -> sql.Connection {
    connection_on(l.handle)
}

/// Returns the connection for the lease behind the handle; see `connection`.
pub fn connection_on(h: *LeaseHandle) -> sql.Connection {
    var view = h.view
    view.close = fn() {}
    sql.adopt(view)
}

/// Marks the connection broken so that the pool closes it instead of reusing it when the lease is released. Statements on the lease then fail with `sql.Error.Closed`.
pub fn discard(l: Lease) {
    discard_on(l.handle)
}

/// Marks the connection behind the handle broken; see `discard`.
pub fn discard_on(h: *LeaseHandle) {
    h.broken = true
}

/// Returns the connection to the pool. Releasing a released lease has no effect.
///
/// An open transaction is rolled back first, and the connection is closed instead of reused when the rollback fails or the lease was discarded. Dropping the `Lease` calls it.
pub fn release(l: Lease) {
    release_on(l.handle)
}

/// Returns the connection behind the handle to the pool; see `release`.
pub fn release_on(h: *LeaseHandle) {
    if h.released {
        return
    }
    h.released = true
    var broken = h.broken
    if !broken && h.in_transaction {
        h.slot.handle.rollback() catch {
            _ => {
                broken = true
            }
        }
    }
    give_back(h.pool, h.slot, broken)
}
