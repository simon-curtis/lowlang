import std/cancel
import std/sql
import std/sync
import std/time/clock
import std/time/duration

/// The error `acquire`, `acquire_until` and `with` return.
pub enum Error {
    /// The pool has been shut down, including while the call was waiting for a connection.
    Closed
    /// No connection became available within the wait time.
    Timeout
    /// The cancel token was cancelled before or while the call waited for a connection.
    Cancelled
    /// The opener failed to make a connection, or the callback of `with` returned an error. `cause` is the underlying `sql.Error`.
    Sql(cause: sql.Error)
}

/// How a pool sizes itself and how it keeps its connections healthy. A duration of zero turns the matching limit off.
pub struct Config {
    /// The most connections the pool keeps open at once, idle and leased together. Defaults to `4`; a value below `1` becomes `1`.
    pub max: i64 = 4
    /// The most connections kept idle for reuse. Defaults to `-1`, and a negative value or one above `max` means `max`. A connection returned while this many are idle is closed.
    pub max_idle: i64 = -1
    /// How long a connection may sit idle before the pool closes it instead of handing it out. Defaults to zero, which keeps idle connections indefinitely.
    pub idle_timeout: duration.Duration = duration.zero()
    /// How long after it was opened a connection may be reused. An older connection is closed when it is returned or found idle. Defaults to zero, which has no limit.
    pub max_lifetime: duration.Duration = duration.zero()
    /// How long `acquire` waits for a connection when all of them are in use before it fails with `Error.Timeout`. Defaults to zero, which waits until a connection or the cancel token ends the wait.
    pub wait_timeout: duration.Duration = duration.zero()
    /// How long a connection must have been idle before `ping` checks it as it leaves the pool. Defaults to zero, which never pings.
    pub ping_after: duration.Duration = duration.zero()
    /// Checks an idle connection that has passed `ping_after`; a connection for which it fails is closed and replaced by another. Defaults to running `SELECT 1`.
    pub ping: fn(sql.ConnectionHandle) ! sql.Error = default_ping
    /// The source of the monotonic time behind the lifetime, idle and ping limits. Defaults to the system clock.
    pub clock: clock.Clock = clock.system()
}

/// A snapshot of the counters and sizes of a pool.
pub struct Stats {
    /// The connections open, idle and leased together, counting those being opened.
    pub open: i64
    /// The idle connections kept in the pool.
    pub idle: i64
    /// The connections currently leased.
    pub in_use: i64
    /// The calls waiting for a connection.
    pub waiting: i64
    /// The leases handed out in total.
    pub acquires: i64
    /// The calls that had to queue because every connection was in use.
    pub waits: i64
    /// The waits that ended in `Error.Timeout`.
    pub timeouts: i64
    /// The calls that ended in `Error.Cancelled`.
    pub cancelled: i64
    /// The connections the pool closed because they were broken, past their lifetime or idle for too long.
    pub discarded: i64
    /// The connections the opener has made successfully in total.
    pub opened: i64
}

struct Slot {
    handle: sql.ConnectionHandle
    born: duration.Duration
    used: duration.Duration
}

enum Grant {
    Conn(slot: Slot)
    Open
    Closed
}

enum Wake {
    Granted(grant: Grant)
    Aborted
    Expired
}

struct Waiter {
    id: i64
    wake: chan[Grant]
}

struct State {
    guard: sync.Mutex
    opener: fn() -> sql.Connection ! sql.Error
    config: Config
    idle: []Slot
    open: i64
    in_use: i64
    waiters: []Waiter
    next_waiter: i64
    closed: bool
    drained: []chan[bool]
    acquires: i64
    waits: i64
    timeouts: i64
    cancelled: i64
    discarded: i64
    opened: i64
}

/// A pool of connections made on demand by an opener.
///
/// A `Pool` is a copyable handle; copies share one pool. It opens a connection when none is idle and `max` is not reached, and otherwise queues the caller in first-in first-out order. It is safe to use from several green threads.
pub struct Pool {
    state: *State
}

fn default_ping(h: sql.ConnectionHandle) ! sql.Error {
    let rows = h.query("SELECT 1", [])?
}

/// Returns the copyable view of an owned connection and turns the connection's own `close` into a no-op, so that dropping `c` no longer closes it. An opener uses it to give a connection to the pool.
pub fn detach(mut c: sql.Connection) -> sql.ConnectionHandle {
    let h = c.handle
    c.handle.close = fn() {}
    h
}

/// Returns a pool that calls `opener` to make connections as callers need them. No connection is opened until the first `acquire`.
///
/// The `config` is normalized: `max` below `1` becomes `1` and `max_idle` below `0` or above `max` becomes `max`.
pub fn open(opener: fn() -> sql.Connection ! sql.Error, config: Config) -> Pool {
    var chosen = config
    if chosen.max < 1 {
        chosen.max = 1
    }
    if chosen.max_idle < 0 || chosen.max_idle > chosen.max {
        chosen.max_idle = chosen.max
    }
    let state = State {
        guard: sync.mutex()
        opener
        config: chosen
        idle: []
        open: 0
        in_use: 0
        waiters: []
        next_waiter: 0
        closed: false
        drained: []
        acquires: 0
        waits: 0
        timeouts: 0
        cancelled: 0
        discarded: 0
        opened: 0
    }
    Pool { state: new(state) }
}

/// Returns a snapshot of the pool's sizes and counters.
pub fn stats(p: Pool) -> Stats {
    let s = p.state
    sync.lock(s.guard)
    let out = Stats {
        open: s.open
        idle: s.idle.len
        in_use: s.in_use
        waiting: s.waiters.len
        acquires: s.acquires
        waits: s.waits
        timeouts: s.timeouts
        cancelled: s.cancelled
        discarded: s.discarded
        opened: s.opened
    }
    sync.unlock(s.guard)
    out
}

/// Leases a connection, waiting up to `Config.wait_timeout` when every connection is in use. It is `acquire_until` with a token that is never cancelled.
pub fn acquire(p: Pool) -> Lease ! Error {
    acquire_until(p, cancel.token(), p.state.config.wait_timeout)?
}

/// Leases a connection, waiting at most `wait` for one; a zero `wait` waits without a time limit.
///
/// An idle connection is reused first, failing that a new one is opened while fewer than `max` are open, and failing that the call queues in first-in first-out order. Idle connections past their limits are closed first, and one idle longer than `ping_after` is pinged and replaced when the ping fails.
///
/// Returns `Error.Closed` when the pool is shut down, `Error.Cancelled` when `t` is cancelled, `Error.Timeout` when `wait` runs out and `Error.Sql` when the opener fails. Dropping the returned `Lease` returns the connection.
pub fn acquire_until(p: Pool, t: *cancel.Token, wait: duration.Duration) -> Lease ! Error {
    let s = p.state
    let slot = checkout(s, t, wait)?
    sync.lock(s.guard)
    s.acquires += 1
    sync.unlock(s.guard)
    lease_of(s, slot)
}

/// Leases a connection, passes it to `work` and returns it to the pool when `work` finishes.
///
/// Fails like `acquire`; an error from `work` is returned as `Error.Sql`.
pub fn with(p: Pool, work: fn(sql.ConnectionHandle) ! sql.Error) ! Error {
    using lease = acquire(p)?
    work(conn(lease)) catch Sql
}

/// Closes the idle connections that are past `max_lifetime` or `idle_timeout` and returns how many it closed. Leased connections are not touched.
pub fn prune(p: Pool) -> i64 {
    let s = p.state
    var dead: []sql.ConnectionHandle = []
    sync.lock(s.guard)
    sweep(s, now_of(s), mut dead)
    sync.unlock(s.guard)
    close_all(dead)
    dead.len
}

/// Shuts the pool down: closes every idle connection, fails the queued callers with `Error.Closed` and refuses later calls to `acquire`.
///
/// Blocks the calling green thread until every outstanding lease is returned; each connection returned after the shutdown is closed.
pub fn shutdown(p: Pool) {
    let s = p.state
    var dead: []sql.ConnectionHandle = []
    sync.lock(s.guard)
    s.closed = true
    for slot in s.idle {
        push(mut dead, slot.handle)
    }
    s.open -= s.idle.len
    s.idle = []
    let queued = s.waiters
    s.waiters = []
    for w in queued {
        w.wake <- Closed
    }
    if s.in_use == 0 {
        sync.unlock(s.guard)
        close_all(dead)
        return
    }
    let finished = chan[bool]()
    push(mut s.drained, finished)
    sync.unlock(s.guard)
    close_all(dead)
    let waited = <-finished
}

fn now_of(s: *State) -> duration.Duration {
    s.config.clock.monotonic()
}

fn close_all(handles: []sql.ConnectionHandle) {
    for h in handles {
        h.close()
    }
}

fn elapsed_over(now: duration.Duration, since: duration.Duration, limit: duration.Duration) -> bool {
    !duration.is_zero(limit) && duration.after(duration.minus(now, since), limit)
}

fn expired(s: *State, slot: Slot, now: duration.Duration) -> bool {
    elapsed_over(now, slot.born, s.config.max_lifetime) || elapsed_over(now, slot.used, s.config.idle_timeout)
}

fn sweep(s: *State, now: duration.Duration, mut dead: []sql.ConnectionHandle) {
    var live: []Slot = []
    for slot in s.idle {
        if expired(s, slot, now) {
            push(mut dead, slot.handle)
            s.open -= 1
            s.discarded += 1
        } else {
            push(mut live, slot)
        }
    }
    s.idle = live
}

fn pop_idle(s: *State, now: duration.Duration, mut dead: []sql.ConnectionHandle) -> Slot? {
    sweep(s, now, mut dead)
    if s.idle.len == 0 {
        return none
    }
    let slot = s.idle[s.idle.len - 1]
    truncate(mut s.idle, s.idle.len - 1)
    slot
}

fn settle(s: *State) {
    if !s.closed || s.in_use != 0 {
        return
    }
    for finished in s.drained {
        close(finished)
    }
    s.drained = []
}

fn next_waiter(s: *State) -> Waiter? {
    if s.waiters.len == 0 {
        return none
    }
    let w = s.waiters[0]
    s.waiters = s.waiters[1..]
    w
}

fn pass_on(s: *State, grant: Grant) -> bool {
    match next_waiter(s) {
        some(w) => {
            w.wake <- grant
            true
        }
        none => false
    }
}

fn retire(s: *State) {
    s.open -= 1
    s.in_use -= 1
    settle(s)
}

fn give_back(s: *State, slot: Slot, broken: bool) {
    let now = now_of(s)
    var dead: []sql.ConnectionHandle = []
    sync.lock(s.guard)
    if s.closed {
        push(mut dead, slot.handle)
        retire(s)
    } else if broken || expired(s, slot, now) {
        push(mut dead, slot.handle)
        s.discarded += 1
        if !pass_on(s, Open) {
            retire(s)
        }
    } else {
        let renewed = Slot { handle: slot.handle, born: slot.born, used: now }
        if !pass_on(s, Conn(renewed)) {
            if s.idle.len >= s.config.max_idle {
                push(mut dead, slot.handle)
                retire(s)
            } else {
                push(mut s.idle, renewed)
                s.in_use -= 1
            }
        }
    }
    sync.unlock(s.guard)
    close_all(dead)
}

fn forfeit(s: *State) {
    sync.lock(s.guard)
    if !pass_on(s, Open) {
        retire(s)
    }
    sync.unlock(s.guard)
}

fn open_slot(s: *State) -> Slot ! sql.Error {
    using var c = s.opener()?
    let h = detach(mut c)
    let now = now_of(s)
    sync.lock(s.guard)
    s.opened += 1
    sync.unlock(s.guard)
    Slot { handle: h, born: now, used: now }
}

fn open_reserved(s: *State) -> Slot ! Error {
    let slot = open_slot(s) catch {
        e => {
            forfeit(s)
            fail Sql(e)
        }
    }
    slot
}

fn healthy(s: *State, slot: Slot, now: duration.Duration) -> bool {
    if !elapsed_over(now, slot.used, s.config.ping_after) {
        return true
    }
    var ok = true
    let ping = s.config.ping
    ping(slot.handle) or {
        ok = false
    }
    ok
}

fn checkout(s: *State, t: *cancel.Token, wait: duration.Duration) -> Slot ! Error {
    for {
        sync.lock(s.guard)
        if s.closed {
            sync.unlock(s.guard)
            fail Closed
        }
        if cancel.cancelled(t) {
            s.cancelled += 1
            sync.unlock(s.guard)
            fail Cancelled
        }
        let now = now_of(s)
        var dead: []sql.ConnectionHandle = []
        let found = pop_idle(s, now, mut dead)
        match found {
            some(slot) => {
                s.in_use += 1
                sync.unlock(s.guard)
                close_all(dead)
                if healthy(s, slot, now) {
                    return slot
                }
                give_back(s, slot, true)
                continue
            }
            none => {}
        }
        if s.open < s.config.max {
            s.open += 1
            s.in_use += 1
            sync.unlock(s.guard)
            close_all(dead)
            return open_reserved(s)?
        }
        let w = Waiter { id: s.next_waiter, wake: chan[Grant](1) }
        s.next_waiter += 1
        s.waits += 1
        push(mut s.waiters, w)
        sync.unlock(s.guard)
        close_all(dead)
        let grant = await_grant(s, w, t, wait)?
        match grant {
            Conn(slot) => return slot
            Open => return open_reserved(s)?
            Closed => fail Closed
        }
    }
}

fn wait_for(w: Waiter, t: *cancel.Token, wait: duration.Duration) -> Wake {
    if duration.is_zero(wait) {
        return select {
            g = <-w.wake => Granted(g ?? Closed)
            <-cancel.done(t) => Aborted
        }
    }
    var ms = duration.whole_millis(wait)
    if ms < 1 {
        ms = 1
    }
    select {
        g = <-w.wake => Granted(g ?? Closed)
        <-cancel.done(t) => Aborted
        after(ms) => Expired
    }
}

fn withdraw(s: *State, id: i64) -> bool {
    var kept: []Waiter = []
    var found = false
    for w in s.waiters {
        if w.id == id {
            found = true
        } else {
            push(mut kept, w)
        }
    }
    s.waiters = kept
    found
}

fn surrender(s: *State, grant: Grant) {
    match grant {
        Conn(slot) => give_back(s, slot, false)
        Open => forfeit(s)
        Closed => {}
    }
}

fn await_grant(s: *State, w: Waiter, t: *cancel.Token, wait: duration.Duration) -> Grant ! Error {
    let woke = wait_for(w, t, wait)
    var timed_out = false
    match woke {
        Granted(grant) => return grant
        Expired => {
            timed_out = true
        }
        Aborted => {}
    }
    sync.lock(s.guard)
    let removed = withdraw(s, w.id)
    if timed_out {
        s.timeouts += 1
    } else {
        s.cancelled += 1
    }
    sync.unlock(s.guard)
    if !removed {
        let late = (<-w.wake) ?? Closed
        surrender(s, late)
    }
    if timed_out {
        fail Timeout
    }
    fail Cancelled
}
