import std/io

struct Wrap {
    raw: io.Stream
    reader: *io.Reader
    handshaking: bool
    packet_left: i64
    more_packets: bool
    record_left: i64
    pending: []u8
}

fn wrap(raw: io.Stream, reader: *io.Reader) -> *Wrap {
    new(Wrap { raw, reader, handshaking: true, packet_left: 0, more_packets: false, record_left: 0, pending: [] })
}

fn packet_header(w: *Wrap) ! io.Error {
    let rest = io.read_exact(w.reader, 7)?
    let length = io.be16(rest, 1)
    if length < 8 {
        fail Malformed
    }
    w.packet_left = length - 8
    w.more_packets = rest[0] & 1 == 0
}

fn source_byte(w: *Wrap, boundary: bool) -> u8 ! io.Error {
    for w.packet_left == 0 {
        if w.more_packets {
            io.read_byte(w.reader)?
            packet_header(w)?
        } else {
            let b = io.read_byte(w.reader)?
            if !boundary || b != packet_prelogin() {
                return b
            }
            packet_header(w)?
        }
    }
    w.packet_left -= 1
    io.read_byte(w.reader)
}

fn source_some(w: *Wrap, dst: []u8) -> i64 ! io.Error {
    for w.packet_left == 0 && w.more_packets {
        io.read_byte(w.reader)?
        packet_header(w)?
    }
    if w.packet_left == 0 {
        return io.read_some(w.reader, dst)
    }
    let room = if dst.len < w.packet_left { dst.len } else { w.packet_left }
    let n = io.read_some(w.reader, dst[..room])?
    w.packet_left -= n
    n
}

fn wrapped_read(w: *Wrap, buf: []u8) -> i64 ! io.Error {
    if w.pending.len > 0 {
        let n = io.copy(buf, w.pending)
        w.pending = w.pending[n..]
        return n
    }
    if w.record_left == 0 {
        let header: []u8 = __make(5)
        for i in 0..5 {
            header[i] = source_byte(w, i == 0)?
        }
        w.record_left = io.be16(header, 3)
        let n = io.copy(buf, header)
        w.pending = header[n..]
        return n
    }
    let room = if buf.len < w.record_left { buf.len } else { w.record_left }
    let n = source_some(w, buf[..room])?
    w.record_left -= n
    n
}

fn wrapped_stream(w: *Wrap) -> io.Stream {
    io.Stream {
        read: fn(buf) -> i64 ! io.Error { wrapped_read(w, buf) }
        write: fn(data) -> i64 ! io.Error {
            if w.handshaking {
                for p in packets(packet_prelogin(), data, initial_packet_size()) {
                    io.write_all(w.raw, p)?
                }
            } else {
                io.write_all(w.raw, data)?
            }
            data.len
        }
        close: fn() { w.raw.close() }
    }
}
