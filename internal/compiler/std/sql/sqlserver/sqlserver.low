import std/io
import std/net
import std/sql
import std/sql/driver
import std/text
import std/time
import std/tls

struct Conn {
    stream: io.Stream
    reader: *io.Reader
    payload: []u8
    at: i64
    last: bool
    packet_size: i64
    transaction: []u8
    timeout: i64
    reading: bool
    read_started: i64
    timed_out: bool
    attention: bool
    logged_in: bool
    session: *driver.Session
}

fn abandon(c: *Conn) -> sql.Error {
    if !c.session.closed {
        c.session.closed = true
        c.stream.close()
    }
    if c.timed_out { sql.Error.Timeout } else { sql.Error.Closed }
}

fn send(c: *Conn, data: []u8) ! sql.Error {
    io.write_all(c.stream, data) catch {
        TimedOut => {
            c.timed_out = true
            fail abandon(c)
        }
        _ => fail abandon(c)
    }
}

fn send_message(c: *Conn, kind: u8, payload: []u8) ! sql.Error {
    for p in packets(kind, payload, c.packet_size) {
        send(c, p)?
    }
}

fn read_packet(c: *Conn) -> []u8 ! io.Error {
    c.read_started = time.monotonic()
    c.reading = true
    defer c.reading = false
    let header = io.read_exact(c.reader, 8)?
    let length = io.be16(header, 2)
    if header[0] != 0x04 || length < 8 {
        fail Malformed
    }
    c.last = header[1] & 1 == 1
    io.read_exact(c.reader, length - 8)
}

fn next_packet(c: *Conn) ! sql.Error {
    let payload = read_packet(c) catch {
        Malformed => {
            abandon(c)
            fail Protocol
        }
        _ => fail abandon(c)
    }
    c.payload = payload
    c.at = 0
}

fn take(c: *Conn, n: i64) -> []u8 ! sql.Error {
    if n >= 0 && n <= c.payload.len - c.at {
        let out = c.payload[c.at..c.at + n]
        c.at += n
        return out
    }
    if n < 0 || n > max_value {
        fail Protocol
    }
    let out: []u8 = __make(n)
    var got = 0
    for got < n {
        if c.at == c.payload.len {
            if c.last {
                fail Protocol
            }
            next_packet(c)?
            continue
        }
        let k = __memmove(out[got..], c.payload[c.at..])
        c.at += k
        got += k
    }
    out
}

fn byte_of(c: *Conn) -> u8 ! sql.Error {
    if c.at < c.payload.len {
        let b = c.payload[c.at]
        c.at += 1
        return b
    }
    take(c, 1)?[0]
}

fn u16_of(c: *Conn) -> i64 ! sql.Error {
    io.le16(take(c, 2)?, 0)
}

fn u32_of(c: *Conn) -> i64 ! sql.Error {
    io.le32(take(c, 4)?, 0)
}

fn u64_of(c: *Conn) -> i64 ! sql.Error {
    io.le64(take(c, 8)?, 0)
}

fn rest_of_message(c: *Conn) -> []u8 ! sql.Error {
    var out: []u8 = []
    for {
        io.append(mut out, c.payload[c.at..])
        c.at = c.payload.len
        if c.last {
            return out
        }
        next_packet(c)?
    }
}

struct Exchange {
    columns: []sql.Column
    types: []Type
    failure: sql.Error?
    fatal: bool
    stopped: bool
    count: i64
}

fn stop(c: *Conn, x: *Exchange) ! sql.Error {
    if x.stopped {
        return
    }
    x.stopped = true
    if !c.last {
        c.attention = true
        send_message(c, packet_attention, [])?
    }
}

fn metadata(c: *Conn, x: *Exchange) ! sql.Error {
    let n = u16_of(c)?
    if n == 0xFFFF {
        x.columns = []
        x.types = []
        return
    }
    let columns: []sql.Column = __make(n)
    let types: []Type = __make(n)
    for i in 0..n {
        take(c, 6)?
        let t = type_info(c)?
        if t.shape == Long {
            let parts = byte_of(c)?
            for _ in 0..parts {
                us_varchar(c)?
            }
        }
        columns[i] = sql.Column { name: b_varchar(c)?, kind: t.name }
        types[i] = t
    }
    x.columns = columns
    x.types = types
}

fn decoded(c: *Conn, x: *Exchange, t: Type) -> sql.Value ! sql.Error {
    let raw = raw_value(c, t)?
    if x.stopped {
        return sql.Value.Null
    }
    match raw {
        some(data) => convert(t, data) catch {
            Conversion => {
                if x.failure == none {
                    x.failure = sql.Error.Conversion
                }
                stop(c, x)?
                sql.Value.Null
            }
            Unsupported => fail Unsupported
            _ => fail Protocol
        }
        none => sql.Value.Null
    }
}

fn row(c: *Conn, x: *Exchange, compressed: bool, visit: fn([]sql.Column, []sql.Value) -> bool) ! sql.Error {
    let n = x.types.len
    let bitmap: []u8 = if compressed { take(c, (n + 7) / 8)? } else { [] }
    let values: []sql.Value = __make(n)
    for i, t in x.types {
        if compressed && (bitmap[i / 8] >> (i % 8) & 1) == 1 {
            values[i] = sql.Value.Null
        } else {
            values[i] = decoded(c, x, t)?
        }
    }
    if !x.stopped && !visit(x.columns, values) {
        stop(c, x)?
    }
}

fn done(c: *Conn, x: *Exchange, kind: u8) ! sql.Error {
    let status = u16_of(c)?
    take(c, 2)?
    let count = u64_of(c)?
    if status & 0x20 != 0 {
        c.attention = false
    }
    if status & 0x10 != 0 && kind != 0xFE {
        x.count += count
    }
}

fn server_error(c: *Conn, x: *Exchange) ! sql.Error {
    let body = take(c, u16_of(c)?)?
    if body.len < 8 {
        fail Protocol
    }
    let number = i64(i32(io.le32(body, 0)))
    let class = body[5]
    let size = 2 * io.le16(body, 6)
    if 8 + size > body.len {
        fail Protocol
    }
    if class >= 20 {
        x.fatal = true
    }
    if x.failure == none {
        x.failure = sql.Error.Server("{number}", from_utf16(body[8..8 + size]))
    }
}

fn env_change(c: *Conn) ! sql.Error {
    let body = take(c, u16_of(c)?)?
    if body.len < 2 {
        fail Protocol
    }
    let kind = body[0]
    let size = i64(body[1])
    if kind == 4 {
        if 2 + 2 * size > body.len {
            fail Protocol
        }
        let value = text.parse_int(from_utf16(body[2..2 + 2 * size])) or fail Protocol
        if value < 512 || value > 32767 {
            fail Protocol
        }
        c.packet_size = value
    } else if kind == 8 {
        if size != 8 || body.len < 10 {
            fail Protocol
        }
        let descriptor: []u8 = __make(8)
        __memmove(descriptor, body[2..10])
        c.transaction = descriptor
    } else if kind == 9 || kind == 10 || kind == 17 {
        c.transaction = __make(8)
    }
}

fn return_value(c: *Conn) ! sql.Error {
    take(c, 2)?
    b_varchar(c)?
    take(c, 7)?
    let t = type_info(c)?
    raw_value(c, t)?
}

fn feature_ack(c: *Conn) ! sql.Error {
    for {
        if byte_of(c)? == 0xFF {
            return
        }
        take(c, u32_of(c)?)?
    }
}

fn token(c: *Conn, x: *Exchange, describe: fn([]sql.Column), visit: fn([]sql.Column, []sql.Value) -> bool) ! sql.Error {
    let kind = byte_of(c)?
    if kind == 0xD1 || kind == 0xD2 {
        row(c, x, kind == 0xD2, visit)?
    } else if kind == 0xFD || kind == 0xFE || kind == 0xFF {
        done(c, x, kind)?
    } else if kind == 0x81 {
        metadata(c, x)?
        describe(x.columns)
    } else if kind == 0xAA {
        server_error(c, x)?
    } else if kind == 0xE3 {
        env_change(c)?
    } else if kind == 0xAD {
        take(c, u16_of(c)?)?
        c.logged_in = true
    } else if kind == 0xAB || kind == 0xA9 || kind == 0xA4 || kind == 0xA5 || kind == 0xED {
        take(c, u16_of(c)?)?
    } else if kind == 0x79 {
        take(c, 4)?
    } else if kind == 0xAC {
        return_value(c)?
    } else if kind == 0xAE {
        feature_ack(c)?
    } else if kind == 0xE4 {
        take(c, u32_of(c)?)?
    } else {
        fail Protocol
    }
}

fn drive(c: *Conn, describe: fn([]sql.Column), visit: fn([]sql.Column, []sql.Value) -> bool) -> i64 ! sql.Error {
    let x = new(Exchange { columns: [], types: [], failure: none, fatal: false, stopped: false, count: 0 })
    next_packet(c)?
    for {
        if c.at < c.payload.len {
            token(c, x, describe, visit)?
        } else if !c.last || c.attention {
            next_packet(c)?
        } else {
            break
        }
    }
    if x.fatal {
        abandon(c)
    }
    match x.failure {
        some(e) => fail e
        none => x.count
    }
}

fn request(c: *Conn, sql_text: str, values: []sql.Value) ! sql.Error {
    if values.len == 0 {
        send_message(c, packet_batch, batch_message(sql_text, c.transaction))?
        return
    }
    let message = rpc_message(sql_text, values, c.transaction)?
    send_message(c, packet_rpc, message)?
}

fn query(c: *Conn, sql_text: str, values: []sql.Value) -> sql.Rows ! sql.Error {
    request(c, sql_text, values)?
    driver.collect(fn(describe, visit) ! sql.Error { drive(c, describe, visit)? })
}

fn execute(c: *Conn, sql_text: str, values: []sql.Value) -> i64 ! sql.Error {
    request(c, sql_text, values)?
    drive(c, driver.ignore_columns, driver.ignore_row)
}

fn each(c: *Conn, sql_text: str, values: []sql.Value, visit: fn([]sql.Column, []sql.Value) -> bool) ! sql.Error {
    request(c, sql_text, values)?
    drive(c, driver.ignore_columns, visit)?
}

fn transact(c: *Conn, message: []u8) ! sql.Error {
    send_message(c, packet_transaction, message)?
    drive(c, driver.ignore_columns, driver.ignore_row)?
}

fn fatal(e: sql.Error) -> bool {
    match e {
        Protocol => true
        Unsupported => true
        _ => false
    }
}

fn terminate(c: *Conn) {
    if c.session.closed {
        return
    }
    c.session.closed = true
    c.stream.close()
}

fn expire(c: *Conn) {
    c.timed_out = true
    io.write_all(c.stream, packet(packet_attention, [], true, 1)) or {}
    c.stream.close()
}

fn watch(c: *Conn) {
    var wait = c.timeout
    for !c.session.closed {
        sleep(wait)
        wait = c.timeout
        if c.reading && !c.session.closed {
            let idle = (time.monotonic() - c.read_started) / 1000000
            if idle >= c.timeout {
                expire(c)
                return
            }
            wait = c.timeout - idle
        }
    }
}

fn handshake_failure(c: *Conn) -> sql.Error {
    if c.timed_out { sql.Error.Timeout } else { sql.Error.Connect }
}

fn secure(c: *Conn, o: sql.Options, config: tls.Config) ! sql.Error {
    let w = wrap(c.stream, c.reader)
    var named = config
    if named.server_name.len == 0 {
        named.server_name = o.host
    }
    c.read_started = time.monotonic()
    c.reading = true
    let lower = wrapped_stream(w)
    let session = tls.client_handle(lower, named) or {
        c.reading = false
        fail handshake_failure(c)
    }
    c.reading = false
    w.handshaking = false
    let s = tls.stream_on(session)
    c.stream = s
    c.reader = io.reader(s)
}

fn establish(c: *Conn, o: sql.Options, config: tls.Config?) ! sql.Error {
    let offer = match config {
        some(_) => encrypt_on
        none => encrypt_not_supported
    }
    send_message(c, packet_prelogin, prelogin_message(offer))?
    next_packet(c)?
    let answer = prelogin_encryption(rest_of_message(c)?)?
    let encrypted = answer == encrypt_on || answer == encrypt_required
    match config {
        some(settings) => {
            if !encrypted {
                fail Unsupported
            }
            secure(c, o, settings)?
        }
        none => {
            if encrypted || answer != encrypt_not_supported && answer != encrypt_off {
                fail Unsupported
            }
        }
    }
    send_message(c, packet_login, login_message(o, o.host))?
    drive(c, driver.ignore_columns, driver.ignore_row)?
    if !c.logged_in {
        fail Authentication
    }
}

fn open(s: io.Stream, o: sql.Options, config: tls.Config?) -> sql.Connection ! sql.Error {
    let c = new(Conn {
        stream: s
        reader: io.reader(s)
        payload: []
        at: 0
        last: true
        packet_size: initial_packet_size
        transaction: __make(8)
        timeout: o.timeout
        reading: false
        read_started: 0
        timed_out: false
        attention: false
        logged_in: false
        session: driver.session()
    })
    if c.timeout > 0 {
        spawn watch(c)
    }
    let abandoned = fn() { abandon(c) }
    let closed = fn() { terminate(c) }
    driver.establish(c.session, fatal, abandoned, closed, fn() ! sql.Error { establish(c, o, config)? })?
    let raw = sql.ConnectionHandle {
        dialect: sql.sqlserver()
        query: fn(sql_text, values) -> sql.Rows ! sql.Error { query(c, sql_text, values) }
        each: fn(sql_text, values, visit) ! sql.Error { each(c, sql_text, values, visit)? }
        execute: fn(sql_text, values) -> i64 ! sql.Error { execute(c, sql_text, values) }
        begin: fn() ! sql.Error { transact(c, begin_message(c.transaction))? }
        commit: fn() ! sql.Error { transact(c, end_message(7, c.transaction))? }
        rollback: fn() ! sql.Error { transact(c, end_message(8, c.transaction))? }
        close: closed
    }
    driver.connection(c.session, fatal, abandoned, "std/sql/sqlserver", o, raw)
}

fn dial(o: sql.Options) -> net.Conn ! sql.Error {
    using conn = driver.dial(o, sql.sqlserver())?
    net.set_nodelay(conn, true) or {}
    net.set_write_timeout(conn, o.timeout)
    conn
}

/// Connects to a SQL Server over plain TCP, using `o.host` and `o.port` (`1433` by default), and logs in as `o.user` to `o.database`.
///
/// Returns `sql.Error.Connect` when the connection cannot be made, `sql.Error.Timeout` when it exceeds `o.timeout`, `sql.Error.Authentication` when the login fails and `sql.Error.Unsupported` when the server requires encryption, which needs `connect_tls`. Dropping the returned `sql.Connection` closes the socket.
pub fn connect(o: sql.Options) -> sql.Connection ! sql.Error {
    using var conn = dial(o)?
    let handle = net.detach(mut conn)
    open(net.stream_on(handle), o, none)
}

/// Connects over a stream that is already connected, without TLS, and logs in as `connect` does.
///
/// Fails like `connect` after the dial.
pub fn connect_stream(s: io.Stream, o: sql.Options) -> sql.Connection ! sql.Error {
    open(s, o, none)
}

/// Connects to a SQL Server and negotiates TLS during the TDS pre-login exchange using `config`, then logs in.
///
/// Returns `sql.Error.Unsupported` when the server does not offer encryption. Otherwise fails like `connect`.
pub fn connect_tls(o: sql.Options, config: tls.Config) -> sql.Connection ! sql.Error {
    using var conn = dial(o)?
    let handle = net.detach(mut conn)
    open(net.stream_on(handle), o, config)
}
