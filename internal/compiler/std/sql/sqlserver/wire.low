import std/io
import std/sql

fn packet_batch() -> u8 {
    0x01
}

fn packet_rpc() -> u8 {
    0x03
}

fn packet_attention() -> u8 {
    0x06
}

fn packet_transaction() -> u8 {
    0x0E
}

fn packet_login() -> u8 {
    0x10
}

fn packet_prelogin() -> u8 {
    0x12
}

fn initial_packet_size() -> i64 {
    4096
}

fn requested_packet_size() -> i64 {
    16384
}

fn max_value() -> i64 {
    0x40000000
}

fn encrypt_off() -> u8 {
    0
}

fn encrypt_on() -> u8 {
    1
}

fn encrypt_not_supported() -> u8 {
    2
}

fn encrypt_required() -> u8 {
    3
}

fn put_le16(mut b: []u8, v: i64) {
    push(mut b, u8(v))
    push(mut b, u8(v >> 8))
}

fn put_le32(mut b: []u8, v: i64) {
    put_le16(mut b, v)
    put_le16(mut b, v >> 16)
}

fn put_le64(mut b: []u8, v: i64) {
    put_le32(mut b, v)
    put_le32(mut b, v >> 32)
}

fn utf16(s: str) -> []u8 {
    let out: []u8 = __make(2 * s.len)
    var at = 0
    for c in s {
        if c < 0x10000 {
            out[at] = u8(c)
            out[at + 1] = u8(c >> 8)
            at += 2
        } else {
            let v = c - 0x10000
            let high = 0xD800 + (v >> 10)
            let low = 0xDC00 + (v & 0x3FF)
            out[at] = u8(high)
            out[at + 1] = u8(high >> 8)
            out[at + 2] = u8(low)
            out[at + 3] = u8(low >> 8)
            at += 4
        }
    }
    out[..at]
}

fn put_utf8(out: []u8, at: i64, c: i64) -> i64 {
    if c < 0x80 {
        out[at] = u8(c)
        return at + 1
    }
    if c < 0x800 {
        out[at] = u8(0xC0 | c >> 6)
        out[at + 1] = u8(0x80 | c & 0x3F)
        return at + 2
    }
    if c < 0x10000 {
        out[at] = u8(0xE0 | c >> 12)
        out[at + 1] = u8(0x80 | c >> 6 & 0x3F)
        out[at + 2] = u8(0x80 | c & 0x3F)
        return at + 3
    }
    out[at] = u8(0xF0 | c >> 18)
    out[at + 1] = u8(0x80 | c >> 12 & 0x3F)
    out[at + 2] = u8(0x80 | c >> 6 & 0x3F)
    out[at + 3] = u8(0x80 | c & 0x3F)
    at + 4
}

fn unit(data: []u8, i: i64) -> i64 {
    i64(data[2 * i]) | i64(data[2 * i + 1]) << 8
}

fn paired(data: []u8, units: i64, i: i64, c: i64) -> bool {
    if c < 0xD800 || c >= 0xDC00 || i >= units {
        return false
    }
    let low = unit(data, i)
    low >= 0xDC00 && low < 0xE000
}

fn utf8_size(data: []u8, units: i64) -> i64 {
    var size = 0
    var i = 0
    for i < units {
        let c = unit(data, i)
        i += 1
        if c < 0x80 {
            size += 1
        } else if c < 0x800 {
            size += 2
        } else if paired(data, units, i, c) {
            size += 4
            i += 1
        } else {
            size += 3
        }
    }
    size
}

fn from_utf16(data: []u8) -> str {
    let units = data.len / 2
    let out: []u8 = __make(utf8_size(data, units))
    var at = 0
    var i = 0
    for i < units {
        let c = unit(data, i)
        i += 1
        if c < 0x80 {
            out[at] = u8(c)
            at += 1
        } else if paired(data, units, i, c) {
            at = put_utf8(out, at, 0x10000 + ((c - 0xD800) << 10) + (unit(data, i) - 0xDC00))
            i += 1
        } else if c >= 0xD800 && c < 0xE000 {
            at = put_utf8(out, at, 0xFFFD)
        } else {
            at = put_utf8(out, at, c)
        }
    }
    __str_view(out)
}

fn put_b_varchar(mut b: []u8, s: str) ! sql.Error {
    let units = utf16(s)
    if units.len / 2 > 255 {
        fail Conversion
    }
    push(mut b, u8(units.len / 2))
    io.append(mut b, units)
}

fn packet(kind: u8, data: []u8, last: bool, id: i64) -> []u8 {
    let length = data.len + 8
    let out: []u8 = __make(length)
    out[0] = kind
    out[1] = if last { 1 } else { 0 }
    out[2] = u8(length >> 8)
    out[3] = u8(length)
    out[6] = u8(id)
    __memmove(out[8..], data)
    out
}

fn packets(kind: u8, payload: []u8, size: i64) -> [][]u8 {
    let room = size - 8
    var out: [][]u8 = []
    var start = 0
    for {
        let stop = if payload.len - start > room { start + room } else { payload.len }
        push(mut out, packet(kind, payload[start..stop], stop == payload.len, out.len + 1))
        if stop == payload.len {
            return out
        }
        start = stop
    }
}

fn all_headers(mut b: []u8, transaction: []u8) {
    put_le32(mut b, 22)
    put_le32(mut b, 18)
    put_le16(mut b, 2)
    io.append(mut b, transaction)
    put_le32(mut b, 1)
}

fn prelogin_message(encrypt: u8) -> []u8 {
    var b: []u8 = []
    let options = [0, 1, 3, 4]
    let sizes = [6, 1, 4, 1]
    var offset = 5 * options.len + 1
    for i, o in options {
        push(mut b, u8(o))
        io.put_be16(mut b, offset)
        io.put_be16(mut b, sizes[i])
        offset += sizes[i]
    }
    push(mut b, 0xFF)
    io.append(mut b, [1, 0, 0, 0, 0, 0])
    push(mut b, encrypt)
    put_le32(mut b, 0)
    push(mut b, 0)
    b
}

fn prelogin_encryption(payload: []u8) -> u8 ! sql.Error {
    var at = 0
    for {
        if at >= payload.len {
            fail Protocol
        }
        let option = payload[at]
        if option == 0xFF {
            fail Protocol
        }
        if at + 5 > payload.len {
            fail Protocol
        }
        let offset = io.be16(payload, at + 1)
        let size = io.be16(payload, at + 3)
        if offset + size > payload.len {
            fail Protocol
        }
        if option == 1 {
            if size != 1 {
                fail Protocol
            }
            return payload[offset]
        }
        at += 5
    }
}

fn scrambled(password: str) -> []u8 {
    let units = utf16(password)
    for i, b in units {
        units[i] = (b << 4 | b >> 4) ^ 0xA5
    }
    units
}

fn login_message(o: sql.Options, host: str) -> []u8 {
    let fields = [utf16(""), utf16(o.user), scrambled(o.password), utf16(o.application), utf16(host), utf16("lowlang"), utf16(""), utf16(o.database)]
    var extension = 94
    for f in fields {
        extension += f.len
    }
    var b: []u8 = []
    put_le32(mut b, 0)
    io.append(mut b, [4, 0, 0, 0x74])
    put_le32(mut b, requested_packet_size())
    put_le32(mut b, 0x01000000)
    put_le32(mut b, 0)
    put_le32(mut b, 0)
    push(mut b, 0xE0)
    push(mut b, 0x03)
    push(mut b, 0)
    push(mut b, 0x10)
    put_le32(mut b, 0)
    put_le32(mut b, 0x0409)
    var offset = 94
    for i, f in fields {
        if i == 5 {
            put_le16(mut b, extension)
            put_le16(mut b, 4)
        }
        put_le16(mut b, offset)
        put_le16(mut b, f.len / 2)
        offset += f.len
    }
    io.append(mut b, [0, 0, 0, 0, 0, 0])
    for _ in 0..3 {
        put_le16(mut b, extension + 4)
        put_le16(mut b, 0)
    }
    put_le32(mut b, 0)
    for f in fields {
        io.append(mut b, f)
    }
    put_le32(mut b, extension + 4)
    push(mut b, 0x0A)
    put_le32(mut b, 0)
    push(mut b, 0xFF)
    io.set_le32(b, 0, b.len)
    b
}

fn batch_message(text: str, transaction: []u8) -> []u8 {
    var b: []u8 = []
    all_headers(mut b, transaction)
    io.append(mut b, utf16(text))
    b
}

fn begin_message(transaction: []u8) -> []u8 {
    var b: []u8 = []
    all_headers(mut b, transaction)
    put_le16(mut b, 5)
    push(mut b, 0)
    push(mut b, 0)
    b
}

fn end_message(request: i64, transaction: []u8) -> []u8 {
    var b: []u8 = []
    all_headers(mut b, transaction)
    put_le16(mut b, request)
    push(mut b, 0)
    push(mut b, 0)
    b
}
