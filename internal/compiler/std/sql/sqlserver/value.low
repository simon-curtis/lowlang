import std/io
import std/sql
import std/text

enum Shape {
    Fixed
    Byte
    Short
    Partial
    Long
    Variant
}

enum Kind {
    Integer
    Bit
    Real
    Money
    Moment
    Numeric
    Guid
    Day
    Clock
    Stamp
    StampZone
    Textual
    Variant
    Binary
}

enum Charset {
    Wide
    Utf8
    Western
    Ascii
}

struct Type {
    id: u8
    kind: Kind
    shape: Shape
    size: i64
    precision: i64
    scale: i64
    charset: Charset
    name: str
}

fn kind_of(id: u8) -> Kind {
    if id == 0x30 || id == 0x34 || id == 0x38 || id == 0x7F || id == 0x26 {
        return Integer
    }
    if id == 0x32 || id == 0x68 {
        return Bit
    }
    if id == 0x3B || id == 0x3E || id == 0x6D {
        return Real
    }
    if id == 0x3C || id == 0x7A || id == 0x6E {
        return Money
    }
    if id == 0x3A || id == 0x3D || id == 0x6F {
        return Moment
    }
    if id == 0x37 || id == 0x3F || id == 0x6A || id == 0x6C {
        return Numeric
    }
    if id == 0x24 {
        return Guid
    }
    if id == 0x28 {
        return Day
    }
    if id == 0x29 {
        return Clock
    }
    if id == 0x2A {
        return Stamp
    }
    if id == 0x2B {
        return StampZone
    }
    if id == 0xA7 || id == 0xAF || id == 0xE7 || id == 0xEF || id == 0x23 || id == 0x63 || id == 0xF1 {
        return Textual
    }
    if id == 0x62 {
        return Variant
    }
    Binary
}

fn type_of(id: u8, shape: Shape, size: i64, name: str) -> Type {
    Type { id, kind: kind_of(id), shape, size, precision: 0, scale: 0, charset: Ascii, name }
}

fn days_to_epoch() -> i64 {
    719162
}

fn last_day() -> i64 {
    3652058
}

fn days_1900() -> i64 {
    -25567
}

fn micros_per_day() -> i64 {
    86400000000
}

fn fixed_type(id: u8) -> Type? {
    if id == 0x1F {
        return type_of(id, Fixed, 0, "null")
    }
    if id == 0x30 {
        return type_of(id, Fixed, 1, "tinyint")
    }
    if id == 0x32 {
        return type_of(id, Fixed, 1, "bit")
    }
    if id == 0x34 {
        return type_of(id, Fixed, 2, "smallint")
    }
    if id == 0x38 {
        return type_of(id, Fixed, 4, "int")
    }
    if id == 0x3A {
        return type_of(id, Fixed, 4, "smalldatetime")
    }
    if id == 0x3B {
        return type_of(id, Fixed, 4, "real")
    }
    if id == 0x3C {
        return type_of(id, Fixed, 8, "money")
    }
    if id == 0x3D {
        return type_of(id, Fixed, 8, "datetime")
    }
    if id == 0x3E {
        return type_of(id, Fixed, 8, "float")
    }
    if id == 0x7A {
        return type_of(id, Fixed, 4, "smallmoney")
    }
    if id == 0x7F {
        return type_of(id, Fixed, 8, "bigint")
    }
    none
}

fn sized_name(id: u8, size: i64) -> str ! sql.Error {
    if id == 0x24 {
        return "uniqueidentifier"
    }
    if id == 0x26 {
        return if size == 1 { "tinyint" } else if size == 2 { "smallint" } else if size == 4 { "int" } else { "bigint" }
    }
    if id == 0x68 {
        return "bit"
    }
    if id == 0x6D {
        return if size == 4 { "real" } else { "float" }
    }
    if id == 0x6E {
        return if size == 4 { "smallmoney" } else { "money" }
    }
    if id == 0x6F {
        return if size == 4 { "smalldatetime" } else { "datetime" }
    }
    fail Unsupported
}

fn western_language(lcid: i64) -> bool {
    let language = lcid & 0x3FF
    language == 0x03 || language == 0x06 || language == 0x07 || language == 0x09 || language == 0x0A || language == 0x0B ||
        language == 0x0C || language == 0x0F || language == 0x10 || language == 0x13 || language == 0x14 || language == 0x16 ||
        language == 0x1D || language == 0x21 || language == 0x2D || language == 0x36 || language == 0x38 || language == 0x3E ||
        language == 0x41 || language == 0x56
}

fn charset_of(collation: []u8) -> Charset {
    let info = io.le32(collation, 0)
    let sort = i64(collation[4])
    if info >> 26 & 1 == 1 {
        return Utf8
    }
    if sort == 0 && western_language(info & 0xFFFFF) || sort >= 50 && sort <= 61 || sort >= 183 && sort <= 186 {
        return Western
    }
    Ascii
}

fn wide(id: u8) -> bool {
    id == 0xE7 || id == 0xEF || id == 0x63 || id == 0xF1
}

fn b_varchar(c: *Conn) -> str ! sql.Error {
    let n = i64(byte_of(c)?)
    from_utf16(take(c, 2 * n)?)
}

fn us_varchar(c: *Conn) -> str ! sql.Error {
    let n = u16_of(c)?
    from_utf16(take(c, 2 * n)?)
}

fn type_info(c: *Conn) -> Type ! sql.Error {
    let id = byte_of(c)?
    match fixed_type(id) {
        some(t) => return t
        none => {}
    }
    if id == 0x24 || id == 0x26 || id == 0x68 || id == 0x6D || id == 0x6E || id == 0x6F {
        let size = i64(byte_of(c)?)
        return type_of(id, Byte, size, sized_name(id, size)?)
    }
    if id == 0x37 || id == 0x3F || id == 0x6A || id == 0x6C {
        let size = i64(byte_of(c)?)
        var t = type_of(id, Byte, size, if id == 0x37 || id == 0x6A { "decimal" } else { "numeric" })
        t.precision = i64(byte_of(c)?)
        t.scale = i64(byte_of(c)?)
        if t.scale > 38 {
            fail Protocol
        }
        return t
    }
    if id == 0x28 {
        return type_of(id, Byte, 3, "date")
    }
    if id == 0x29 || id == 0x2A || id == 0x2B {
        var t = type_of(id, Byte, 0, if id == 0x29 { "time" } else if id == 0x2A { "datetime2" } else { "datetimeoffset" })
        t.scale = i64(byte_of(c)?)
        if t.scale > 7 {
            fail Protocol
        }
        return t
    }
    if id == 0xA5 || id == 0xAD || id == 0xA7 || id == 0xAF || id == 0xE7 || id == 0xEF {
        let size = u16_of(c)?
        let name = if id == 0xA5 { "varbinary" } else if id == 0xAD { "binary" } else if id == 0xA7 { "varchar" } else if id == 0xAF { "char" } else if id == 0xE7 { "nvarchar" } else { "nchar" }
        var t = type_of(id, if size == 0xFFFF { Partial } else { Short }, size, name)
        if id == 0xA7 || id == 0xAF || id == 0xE7 || id == 0xEF {
            let collation = take(c, 5)?
            t.charset = if wide(id) { Wide } else { charset_of(collation) }
        }
        return t
    }
    if id == 0x22 || id == 0x23 || id == 0x63 {
        let size = u32_of(c)?
        var t = type_of(id, Long, size, if id == 0x22 { "image" } else if id == 0x23 { "text" } else { "ntext" })
        if id != 0x22 {
            let collation = take(c, 5)?
            t.charset = if wide(id) { Wide } else { charset_of(collation) }
        }
        return t
    }
    if id == 0x62 {
        return type_of(id, Variant, u32_of(c)?, "sql_variant")
    }
    if id == 0xF1 {
        if byte_of(c)? != 0 {
            b_varchar(c)?
            b_varchar(c)?
            us_varchar(c)?
        }
        var t = type_of(id, Partial, 0, "xml")
        t.charset = Wide
        return t
    }
    if id == 0xF0 {
        u16_of(c)?
        b_varchar(c)?
        b_varchar(c)?
        let name = b_varchar(c)?
        us_varchar(c)?
        return type_of(id, Partial, 0, name)
    }
    fail Unsupported
}

fn partial_value(c: *Conn) -> []u8? ! sql.Error {
    let total = u64_of(c)?
    if total == -1 {
        return none
    }
    let known = total != -2
    if known && (total < 0 || total > max_value()) {
        fail Protocol
    }
    var out: []u8 = if known { __make(total) } else { [] }
    var at = 0
    for {
        let n = u32_of(c)?
        if n == 0 {
            break
        }
        if known {
            if n > total - at {
                fail Protocol
            }
            __memmove(out[at..at + n], take(c, n)?)
        } else {
            if at + n > max_value() {
                fail Protocol
            }
            io.append(mut out, take(c, n)?)
        }
        at += n
    }
    if known && at != total {
        fail Protocol
    }
    out
}

fn raw_value(c: *Conn, t: Type) -> []u8? ! sql.Error {
    match t.shape {
        Fixed => {
            if t.size == 0 {
                return none
            }
            take(c, t.size)?
        }
        Byte => {
            let n = i64(byte_of(c)?)
            if n == 0 {
                return none
            }
            take(c, n)?
        }
        Short => {
            let n = u16_of(c)?
            if n == 0xFFFF {
                return none
            }
            take(c, n)?
        }
        Partial => partial_value(c)?
        Long => {
            let pointer = i64(byte_of(c)?)
            if pointer == 0 {
                return none
            }
            take(c, pointer + 8)?
            let n = u32_of(c)?
            if n > max_value() {
                fail Protocol
            }
            take(c, n)?
        }
        Variant => {
            let n = u32_of(c)?
            if n == 0 {
                return none
            }
            if n > max_value() {
                fail Protocol
            }
            take(c, n)?
        }
    }
}

fn unsigned(raw: []u8, from: i64, n: i64) -> i64 {
    var v = 0
    for i in 0..n {
        v |= i64(raw[from + i]) << (8 * i)
    }
    v
}

fn signed(raw: []u8) -> i64 ! sql.Error {
    let n = raw.len
    if n != 1 && n != 2 && n != 4 && n != 8 {
        fail Protocol
    }
    let v = unsigned(raw, 0, n)
    if n == 1 || n == 8 {
        return v
    }
    let shift = 64 - 8 * n
    v << shift >> shift
}

fn float_value(raw: []u8) -> f64 ! sql.Error {
    if raw.len == 8 {
        return text.float_from_bits(u64(unsigned(raw, 0, 8)))
    }
    if raw.len != 4 {
        fail Protocol
    }
    let cell: []u32 = [u32(unsigned(raw, 0, 4))]
    let raw_cell: ptr = __slice_ptr(cell)
    let typed: ptr[f32] = raw_cell
    f64(load(typed))
}

fn put_digits(mut out: []u8, n: u64, width: i64) {
    let start = out.len
    var v = n
    var count = 0
    for v > 0 || count < width {
        push(mut out, u8('0' + v % 10))
        v /= 10
        count += 1
    }
    var i = start
    var j = out.len - 1
    for i < j {
        let t = out[i]
        out[i] = out[j]
        out[j] = t
        i += 1
        j -= 1
    }
}

fn decimal_text(negative: bool, magnitude: []u8, scale: i64) -> str {
    var limbs: []u64 = [0, 0, 0, 0]
    for i in 0..magnitude.len {
        limbs[i / 4] |= u64(magnitude[i]) << u64(8 * (i % 4))
    }
    var chunks: []u64 = []
    var zero = false
    for !zero {
        var remainder: u64 = 0
        zero = true
        var i = 3
        for i >= 0 {
            let current = remainder << 32 | limbs[i]
            limbs[i] = current / 1000000000
            remainder = current % 1000000000
            if limbs[i] != 0 {
                zero = false
            }
            i -= 1
        }
        push(mut chunks, remainder)
    }
    var digits: []u8 = []
    put_digits(mut digits, chunks[chunks.len - 1], 1)
    var k = chunks.len - 2
    for k >= 0 {
        put_digits(mut digits, chunks[k], 9)
        k -= 1
    }
    var out: []u8 = []
    let nonzero = digits.len > 1 || digits[0] != '0'
    if negative && nonzero {
        push(mut out, '-')
    }
    if scale == 0 {
        io.append(mut out, digits)
        return __str_view(out)
    }
    if digits.len <= scale {
        push(mut out, '0')
        push(mut out, '.')
        for _ in digits.len..scale {
            push(mut out, '0')
        }
        io.append(mut out, digits)
        return __str_view(out)
    }
    io.append(mut out, digits[..digits.len - scale])
    push(mut out, '.')
    io.append(mut out, digits[digits.len - scale..])
    __str_view(out)
}

fn money_text(v: i64) -> str {
    let negative = v < 0
    let magnitude = if negative { u64(0) - u64(v) } else { u64(v) }
    let raw: []u8 = __make(8)
    for i in 0..8 {
        raw[i] = u8(magnitude >> u64(8 * i))
    }
    decimal_text(negative, raw, 4)
}

fn money_value(raw: []u8) -> str ! sql.Error {
    if raw.len == 4 {
        return money_text(signed(raw)?)
    }
    if raw.len != 8 {
        fail Protocol
    }
    money_text(unsigned(raw, 0, 4) << 32 | unsigned(raw, 4, 4))
}

fn guid_order(raw: []u8) -> []u8 {
    let out: []u8 = __make(16)
    __memmove(out, raw)
    out[0] = raw[3]
    out[1] = raw[2]
    out[2] = raw[1]
    out[3] = raw[0]
    out[4] = raw[5]
    out[5] = raw[4]
    out[6] = raw[7]
    out[7] = raw[6]
    out
}

fn clock_micros(raw: []u8, from: i64, n: i64, scale: i64) -> i64 {
    let units = unsigned(raw, from, n)
    if scale == 7 {
        return units / 10
    }
    var factor = 1
    for _ in scale..6 {
        factor *= 10
    }
    units * factor
}

fn clock_size(scale: i64) -> i64 {
    if scale <= 2 { 3 } else if scale <= 4 { 4 } else { 5 }
}

fn day_value(raw: []u8, from: i64) -> i64 {
    unsigned(raw, from, 3) - days_to_epoch()
}

fn stamp_value(t: Type, raw: []u8) -> i64 ! sql.Error {
    let clock = clock_size(t.scale)
    let expected = if t.kind == StampZone { clock + 5 } else { clock + 3 }
    if raw.len != expected {
        fail Protocol
    }
    day_value(raw, clock) * micros_per_day() + clock_micros(raw, 0, clock, t.scale)
}

fn moment_value(raw: []u8) -> i64 ! sql.Error {
    if raw.len == 4 {
        let days = unsigned(raw, 0, 2) + days_1900()
        return days * micros_per_day() + unsigned(raw, 2, 2) * 60000000
    }
    if raw.len != 8 {
        fail Protocol
    }
    let days = signed(raw[..4])? + days_1900()
    let ticks = unsigned(raw, 4, 4)
    days * micros_per_day() + (ticks * 10000 + 1) / 3
}

fn single_byte_text(c: *Conn, charset: Charset, raw: []u8) -> str ! sql.Error {
    if charset == Utf8 {
        return __str_view(raw)
    }
    var extra = 0
    for b in raw {
        if b >= 0x80 {
            extra += 2
        }
    }
    if extra == 0 {
        return __str_view(raw)
    }
    if charset != Western {
        fail Conversion
    }
    let out: []u8 = __make(raw.len + extra)
    var at = 0
    for b in raw {
        if b < 0x80 {
            out[at] = b
            at += 1
        } else if b < 0xA0 {
            at = put_utf8(out, at, i64(c.western[b - 0x80]))
        } else {
            at = put_utf8(out, at, i64(b))
        }
    }
    __str_view(out[..at])
}

fn text_value(c: *Conn, t: Type, raw: []u8) -> str ! sql.Error {
    if t.charset == Wide {
        let s = from_utf16(raw)
        if t.id == 0xF1 && s.len >= 3 && s[0] == 0xEF && s[1] == 0xBB && s[2] == 0xBF {
            return s[3..]
        }
        return s
    }
    single_byte_text(c, t.charset, raw)
}

fn variant_value(c: *Conn, raw: []u8) -> sql.Value ! sql.Error {
    if raw.len < 2 {
        fail Protocol
    }
    let id = raw[0]
    let extra = i64(raw[1])
    if 2 + extra > raw.len {
        fail Protocol
    }
    let props = raw[2..2 + extra]
    let data = raw[2 + extra..]
    match fixed_type(id) {
        some(t) => return convert(c, t, data)
        none => {}
    }
    if id == 0x24 || id == 0x26 || id == 0x68 || id == 0x6D || id == 0x6E || id == 0x6F {
        return convert(c, type_of(id, Byte, data.len, sized_name(id, data.len)?), data)
    }
    if id == 0x28 {
        return convert(c, type_of(id, Byte, 3, "date"), data)
    }
    if props.len < 1 {
        fail Protocol
    }
    if id == 0x37 || id == 0x3F || id == 0x6A || id == 0x6C || id == 0x29 || id == 0x2A || id == 0x2B {
        var t = type_of(id, Byte, data.len, "")
        if id == 0x29 || id == 0x2A || id == 0x2B {
            t.scale = i64(props[0])
            if t.scale > 7 {
                fail Protocol
            }
        } else {
            if props.len < 2 {
                fail Protocol
            }
            t.precision = i64(props[0])
            t.scale = i64(props[1])
            if t.scale > 38 {
                fail Protocol
            }
        }
        return convert(c, t, data)
    }
    if id == 0xA5 || id == 0xAD {
        return sql.Value.Bytes(data)
    }
    if id == 0xA7 || id == 0xAF || id == 0xE7 || id == 0xEF {
        if props.len < 7 {
            fail Protocol
        }
        var t = type_of(id, Short, data.len, "")
        t.charset = if wide(id) { Wide } else { charset_of(props[..5]) }
        return sql.Value.Text(text_value(c, t, data)?)
    }
    fail Unsupported
}

fn convert(c: *Conn, t: Type, raw: []u8) -> sql.Value ! sql.Error {
    match t.kind {
        Integer => {
            if raw.len == 1 {
                return sql.Value.Int(i64(raw[0]))
            }
            sql.Value.Int(signed(raw)?)
        }
        Bit => {
            if raw.len != 1 {
                fail Protocol
            }
            sql.Value.Bool(raw[0] != 0)
        }
        Real => sql.Value.Float(float_value(raw)?)
        Money => sql.Value.Decimal(money_value(raw)?)
        Moment => sql.Value.Timestamp(moment_value(raw)?)
        Numeric => {
            if raw.len < 1 || raw.len > 17 {
                fail Protocol
            }
            sql.Value.Decimal(decimal_text(raw[0] == 0, raw[1..], t.scale))
        }
        Guid => {
            if raw.len != 16 {
                fail Protocol
            }
            sql.Value.Uuid(guid_order(raw))
        }
        Day => {
            if raw.len != 3 {
                fail Protocol
            }
            sql.Value.Date(day_value(raw, 0))
        }
        Clock => {
            if raw.len != clock_size(t.scale) {
                fail Protocol
            }
            sql.Value.Time(clock_micros(raw, 0, raw.len, t.scale))
        }
        Stamp => sql.Value.Timestamp(stamp_value(t, raw)?)
        StampZone => sql.Value.TimestampTz(stamp_value(t, raw)?)
        Textual => sql.Value.Text(text_value(c, t, raw)?)
        Variant => variant_value(c, raw)?
        Binary => sql.Value.Bytes(raw)
    }
}

fn western_table() -> []u32 {
    [
        0x20AC, 0x81, 0x201A, 0x192, 0x201E, 0x2026, 0x2020, 0x2021, 0x2C6, 0x2030, 0x160, 0x2039, 0x152, 0x8D, 0x17D, 0x8F,
        0x90, 0x2018, 0x2019, 0x201C, 0x201D, 0x2022, 0x2013, 0x2014, 0x2DC, 0x2122, 0x161, 0x203A, 0x153, 0x9D, 0x17E, 0x178,
    ]
}
