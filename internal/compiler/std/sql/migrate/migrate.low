import std/crypto/hash
import std/io
import std/sql
import std/text
import std/time/clock
import std/time/timestamp

/// One schema change: statements that apply it and statements that revert it.
pub struct Migration {
    /// The position in the plan. Versions are at least `1` and ascending through the plan.
    pub version: i64
    /// A label for the migration, recorded when it is applied.
    pub name: str
    /// The statements that apply the migration, run in order inside one transaction.
    pub up: []str
    /// The statements that revert the migration, run in order inside one transaction. Empty when it cannot be reverted.
    pub down: []str
}

/// An ordered list of migrations and the table that records which have been applied.
///
/// Build one with `plan`. A `Plan` is a copyable value; `with_table` and `with_clock` return a changed copy.
pub struct Plan {
    /// The migrations, in ascending version order.
    pub migrations: []Migration
    /// The table that records applied versions. Defaults to `schema_migrations`.
    ///
    /// It is created on first use with `version`, `name`, `applied_at` (Unix milliseconds) and `checksum` columns.
    pub table: str = "schema_migrations"
    /// The clock that supplies `applied_at` for newly applied migrations. Defaults to the system clock.
    pub clock: clock.Clock = clock.system()
}

/// Where a migration stands against the migration table.
pub enum State {
    /// Recorded in the table, with a checksum that matches the plan.
    Applied
    /// In the plan but not recorded in the table.
    Pending
    /// Recorded in the table, but the plan's checksum differs, so the migration changed after it was applied.
    Drifted
    /// Recorded in the table but absent from the plan.
    Unknown
}

/// The state of one version, as reported by `status`.
pub struct Entry {
    /// The version.
    pub version: i64
    /// The name from the plan, or the recorded name for an `Unknown` entry.
    pub name: str
    /// Whether the version is applied, pending, drifted or unknown.
    pub state: State
    /// The checksum of the plan's migration, or an empty string for an `Unknown` entry.
    pub expected: str
    /// The checksum stored in the table, or an empty string for a `Pending` entry.
    pub recorded: str
    /// When the migration was applied, or `none` for a pending entry or a time that cannot be represented.
    pub applied_at: timestamp.Timestamp?
}

/// Why a migration operation failed.
pub enum Error {
    /// A statement outside any migration failed: creating or reading the migration table, or taking or releasing the lock.
    Sql(cause: sql.Error)
    /// The migration with this version failed, so its transaction was rolled back and earlier migrations stay applied. `cause` is the database error, or the rollback's error when the rollback failed too.
    Failed(version: i64, cause: sql.Error)
    /// Two migrations share this version.
    Duplicate(version: i64)
    /// This migration is below the previous one in the plan, or below a version that is already applied.
    OutOfOrder(version: i64)
    /// This migration has a version below `1`.
    Invalid(version: i64)
    /// The checksum recorded for this applied version differs from the plan's, so the migration was edited after it was applied.
    Drift(version: i64)
    /// This version is recorded as applied but is not in the plan, so it cannot be reverted.
    Unknown(version: i64)
    /// This version has no `down` statements, so it cannot be reverted.
    NoDown(version: i64)
    /// Another session holds the migration lock.
    Locked
    /// The migration text is malformed at this one-based line: a statement before `-- +up`, a missing `-- +up`, a `-- +begin` or `-- +end` out of place, or a block left open.
    Syntax(line: i64)
    /// This file name does not have the form `NNN_name.sql`.
    BadName(file: str)
    /// Reading the migration directory or a file failed.
    Io(cause: io.Error)
}

struct Record {
    version: i64
    name: str
    applied_at: i64
    checksum: str
}

fn max_version() -> i64 {
    9223372036854775807
}

/// Returns a plan of `migrations`, which must be in ascending version order, using the table `schema_migrations` and the system clock.
pub fn plan(migrations: []Migration) -> Plan {
    Plan { migrations }
}

/// Returns `p` recording applied versions in `table`.
///
/// The table name is quoted for the connection's dialect. The migration lock is derived from the name, so plans with different tables do not block each other.
pub fn with_table(p: Plan, table: str) -> Plan {
    Plan { migrations: p.migrations, table, clock: p.clock }
}

/// Returns `p` that stamps `applied_at` with `c`.
pub fn with_clock(p: Plan, c: clock.Clock) -> Plan {
    Plan { migrations: p.migrations, table: p.table, clock: c }
}

/// Returns the SHA-256 digest of the migration's `up` statements as lower-case hexadecimal.
///
/// Each statement is hashed with its length, so moving text between statements changes the result. The version, name and `down` statements are not covered.
pub fn checksum(m: Migration) -> str {
    var buf: []u8 = []
    for statement in m.up {
        text.append(mut buf, "{statement.len}:")
        text.append(mut buf, statement)
        text.append(mut buf, "\n")
    }
    text.encode_hex(hash.sum(hash.sha256(), buf))
}

/// Checks that the plan's versions are at least `1`, unique and ascending.
///
/// Fails with `Invalid` for a version below `1`, `Duplicate` for a repeated version, or `OutOfOrder` for a version below its predecessor. Every operation that takes a plan calls it first.
pub fn validate(p: Plan) ! Error {
    var seen: [i64: bool] = [:]
    for m in p.migrations {
        if m.version < 1 {
            fail Invalid(m.version)
        }
        if seen[m.version] != none {
            fail Duplicate(m.version)
        }
        seen[m.version] = true
    }
    var previous = 0
    for m in p.migrations {
        if m.version < previous {
            fail OutOfOrder(m.version)
        }
        previous = m.version
    }
}

fn table_of(d: sql.Dialect, p: Plan) -> str {
    sql.quote_identifier(d, p.table)
}

fn create_text(d: sql.Dialect, p: Plan) -> str {
    let types = d.types
    let columns = "version {types.large} NOT NULL PRIMARY KEY, name {types.short_text} NOT NULL, applied_at {types.large} NOT NULL, checksum {types.short_text} NOT NULL"
    sql.create_table_if_missing(d, p.table, columns)
}

fn lock_key(p: Plan) -> i64 {
    let digest = hash.sum(hash.sha256(), bytes("low.migrate:{p.table}"))
    var key: i64 = 0
    for i in 0..7 {
        key = key * 256 + i64(digest[i])
    }
    key
}

fn lock_value(d: sql.Dialect, p: Plan) -> sql.Value {
    match d.lock.key {
        Name => Text("low.migrate:{p.table}")
        _ => Int(lock_key(p))
    }
}

fn acquire_lock(h: sql.ConnectionHandle, p: Plan) ! Error {
    let statement = h.dialect.lock.acquire
    if statement.len == 0 {
        return
    }
    let values = [lock_value(h.dialect, p)]
    let rows = h.query(statement, values) catch Sql
    if rows.rows.len > 0 && rows.rows[0].len > 0 && int_at(rows.rows[0][0]) < 0 {
        fail Locked
    }
}

fn release_lock(h: sql.ConnectionHandle, p: Plan) -> Error? {
    let statement = h.dialect.lock.release
    if statement.len == 0 {
        return none
    }
    let values = [lock_value(h.dialect, p)]
    h.execute(statement, values) catch {
        e => return Sql(e)
    }
    none
}

fn released(h: sql.ConnectionHandle, p: Plan, failure: Error?) ! Error {
    let release = release_lock(h, p)
    match failure {
        some(e) => fail e
        none => {}
    }
    match release {
        some(e) => fail e
        none => {}
    }
}

fn ensure_table(h: sql.ConnectionHandle, p: Plan) ! Error {
    h.execute(create_text(h.dialect, p), []) catch Sql
}

fn int_at(v: sql.Value) -> i64 {
    match v {
        Int(n) => n
        Bool(b) => if b { 1 } else { 0 }
        Decimal(digits) => text.parse_int(digits) or 0
        _ => 0
    }
}

fn text_at(v: sql.Value) -> str {
    match v {
        Text(s) => s
        _ => ""
    }
}

fn read_records(h: sql.ConnectionHandle, p: Plan) -> []Record ! Error {
    let statement = "SELECT version, name, applied_at, checksum FROM {table_of(h.dialect, p)} ORDER BY version"
    let rows = h.query(statement, []) catch Sql
    var out: []Record = []
    for r in rows.rows {
        push(mut out, Record {
            version: int_at(r[0])
            name: text_at(r[1])
            applied_at: int_at(r[2])
            checksum: text_at(r[3])
        })
    }
    out
}

fn begin_transaction(h: sql.ConnectionHandle) ! sql.Error {
    let statement = h.dialect.begin_write
    if statement.len > 0 {
        h.execute(statement, [])?
        return
    }
    h.begin()?
}

fn transact(h: sql.ConnectionHandle, version: i64, work: fn() ! sql.Error) ! Error {
    begin_transaction(h) catch {
        e => fail Failed(version, e)
    }
    work() catch {
        e => fail Failed(version, sql.rolled_back(h, e))
    }
    h.commit() catch {
        e => fail Failed(version, sql.rolled_back(h, e))
    }
}

fn recorded(h: sql.ConnectionHandle, p: Plan, version: i64) -> bool ! sql.Error {
    let statement = "SELECT count(*) FROM {table_of(h.dialect, p)} WHERE version = {sql.placeholder(h.dialect, 0)}"
    let rows = h.query(statement, [Int(version)])?
    rows.rows.len > 0 && int_at(rows.rows[0][0]) > 0
}

fn run_all(h: sql.ConnectionHandle, statements: []str) ! sql.Error {
    for statement in statements {
        h.execute(statement, [])?
    }
}

fn insert_record(h: sql.ConnectionHandle, p: Plan, m: Migration) ! sql.Error {
    let d = h.dialect
    let t = table_of(d, p)
    let marks = [sql.placeholder(d, 0), sql.placeholder(d, 1), sql.placeholder(d, 2), sql.placeholder(d, 3)]
    let statement = "INSERT INTO {t} (version, name, applied_at, checksum) VALUES ({text.join(marks, ", ")})"
    let at = timestamp.unix_millis(p.clock.read())
    h.execute(statement, [Int(m.version), Text(m.name), Int(at), Text(checksum(m))])?
}

fn delete_record(h: sql.ConnectionHandle, p: Plan, version: i64) ! sql.Error {
    let statement = "DELETE FROM {table_of(h.dialect, p)} WHERE version = {sql.placeholder(h.dialect, 0)}"
    h.execute(statement, [Int(version)])?
}

fn apply_one(h: sql.ConnectionHandle, p: Plan, m: Migration) -> bool ! Error {
    var applied = false
    let work = fn() ! sql.Error {
        if recorded(h, p, m.version)? {
            return
        }
        run_all(h, m.up)?
        insert_record(h, p, m)?
        applied = true
    }
    transact(h, m.version, work)?
    applied
}

fn revert_one(h: sql.ConnectionHandle, p: Plan, m: Migration) -> bool ! Error {
    var reverted = false
    let work = fn() ! sql.Error {
        if !recorded(h, p, m.version)? {
            return
        }
        run_all(h, m.down)?
        delete_record(h, p, m.version)?
        reverted = true
    }
    transact(h, m.version, work)?
    reverted
}

fn find_record(records: []Record, version: i64) -> Record? {
    for r in records {
        if r.version == version {
            return r
        }
    }
    none
}

fn find_migration(p: Plan, version: i64) -> Migration? {
    for m in p.migrations {
        if m.version == version {
            return m
        }
    }
    none
}

fn highest(records: []Record) -> i64 {
    var top = 0
    for r in records {
        if r.version > top {
            top = r.version
        }
    }
    top
}

fn check_drift(p: Plan, records: []Record) ! Error {
    for r in records {
        match find_migration(p, r.version) {
            some(m) => {
                if checksum(m) != r.checksum {
                    fail Drift(r.version)
                }
            }
            none => {}
        }
    }
}

fn apply_pending(h: sql.ConnectionHandle, p: Plan, limit: i64, mut applied: []i64) ! Error {
    let records = read_records(h, p)?
    check_drift(p, records)?
    let top = highest(records)
    for m in p.migrations {
        if find_record(records, m.version) != none {
            continue
        }
        if m.version < top {
            fail OutOfOrder(m.version)
        }
        if m.version > limit {
            break
        }
        if apply_one(h, p, m)? {
            push(mut applied, m.version)
        }
    }
}

fn revert_latest(h: sql.ConnectionHandle, p: Plan, steps: i64, mut reverted: []i64) ! Error {
    let records = read_records(h, p)?
    var targets: []Migration = []
    var index = records.len - 1
    for index >= 0 && targets.len < steps {
        let r = records[index]
        match find_migration(p, r.version) {
            some(m) => {
                if m.down.len == 0 {
                    fail NoDown(m.version)
                }
                push(mut targets, m)
            }
            none => fail Unknown(r.version)
        }
        index -= 1
    }
    for m in targets {
        if revert_one(h, p, m)? {
            push(mut reverted, m.version)
        }
    }
}

fn locked(h: sql.ConnectionHandle, p: Plan, work: fn() ! Error) ! Error {
    validate(p)?
    acquire_lock(h, p)?
    var failure: Error? = none
    work() catch {
        e => {
            failure = e
        }
    }
    released(h, p, failure)?
}

/// Applies every pending migration of `p` through `h` and returns the versions it applied, in order.
///
/// Calls `up_to_on` with no upper limit.
pub fn up_on(h: sql.ConnectionHandle, p: Plan) -> []i64 ! Error {
    up_to_on(h, p, max_version())?
}

/// Applies the pending migrations of `p` up to and including `version` through `h` and returns the versions it applied, in order.
///
/// Validates the plan, takes the migration lock, creates the migration table if it is missing, and releases the lock before returning; a failed release fails with `Sql` unless an earlier error is returned instead. The lock is a session advisory lock on Postgres, an application lock on SQL Server that waits for the holder, and absent on SQLite. Fails with `Drift` if an applied migration's checksum no longer matches and `OutOfOrder` if a pending migration is below the highest applied version. Each migration runs in its own transaction with its record, and is skipped if another session recorded it first, so a failure leaves earlier migrations applied and returns `Failed` for the failing one. Returns an empty list when nothing is pending.
pub fn up_to_on(h: sql.ConnectionHandle, p: Plan, version: i64) -> []i64 ! Error {
    var applied: []i64 = []
    locked(h, p, fn() ! Error {
        ensure_table(h, p)?
        apply_pending(h, p, version, mut applied)?
    })?
    applied
}

/// Reverts the latest `steps` applied migrations of `p` through `h` and returns the versions it reverted, highest first.
///
/// Validates the plan, takes the migration lock and creates the migration table as `up_to_on` does. Before reverting anything it fails with `Unknown` for an applied version missing from the plan and `NoDown` for one without `down` statements. Each migration is reverted in its own transaction together with the removal of its record, so a failure returns `Failed` and leaves the earlier reversions in place. Reverts nothing when `steps` is `0` or less or nothing is applied.
pub fn down_on(h: sql.ConnectionHandle, p: Plan, steps: i64) -> []i64 ! Error {
    var reverted: []i64 = []
    locked(h, p, fn() ! Error {
        ensure_table(h, p)?
        revert_latest(h, p, steps, mut reverted)?
    })?
    reverted
}

fn entry_of(m: Migration, r: Record?) -> Entry {
    let expected = checksum(m)
    match r {
        some(found) => Entry {
            version: m.version
            name: m.name
            state: if found.checksum == expected { Applied } else { Drifted }
            expected
            recorded: found.checksum
            applied_at: stamp(found.applied_at)
        }
        none => Entry { version: m.version, name: m.name, state: Pending, expected, recorded: "", applied_at: none }
    }
}

fn stamp(millis: i64) -> timestamp.Timestamp? {
    let ts = timestamp.from_unix_millis(millis) or return none
    ts
}

fn unknown_entry(r: Record) -> Entry {
    Entry { version: r.version, name: r.name, state: Unknown, expected: "", recorded: r.checksum, applied_at: stamp(r.applied_at) }
}

/// Returns one `Entry` per version of the plan and per recorded version missing from it, in ascending version order, through `h`.
///
/// Creates the migration table if it is missing, takes no lock and changes no migration. Fails with the errors of `validate`, or `Sql` when the table cannot be read.
pub fn status_on(h: sql.ConnectionHandle, p: Plan) -> []Entry ! Error {
    validate(p)?
    ensure_table(h, p)?
    let records = read_records(h, p)?
    var out: []Entry = []
    var next = 0
    for m in p.migrations {
        for next < records.len && records[next].version < m.version {
            push(mut out, unknown_entry(records[next]))
            next += 1
        }
        push(mut out, entry_of(m, find_record(records, m.version)))
        if next < records.len && records[next].version == m.version {
            next += 1
        }
    }
    for next < records.len {
        push(mut out, unknown_entry(records[next]))
        next += 1
    }
    out
}

/// Reports the state of every migration on `c`.
///
/// See `status_on`.
pub fn status(c: sql.Connection, p: Plan) -> []Entry ! Error {
    status_on(c.handle, p)?
}

/// Applies every pending migration on `c` and returns the versions applied.
///
/// See `up_to_on`.
pub fn up(c: sql.Connection, p: Plan) -> []i64 ! Error {
    up_on(c.handle, p)?
}

/// Applies the pending migrations up to and including `version` on `c` and returns the versions applied.
///
/// See `up_to_on`.
pub fn up_to(c: sql.Connection, p: Plan, version: i64) -> []i64 ! Error {
    up_to_on(c.handle, p, version)?
}

/// Reverts the latest `steps` applied migrations on `c` and returns the versions reverted.
///
/// See `down_on`.
pub fn down(c: sql.Connection, p: Plan, steps: i64) -> []i64 ! Error {
    down_on(c.handle, p, steps)?
}
