import std/base64
import std/json
import std/protobuf
import std/text

struct Out {
    pb: *protobuf.Encoder
    js: *json.Writer
    json: bool
    marks: []i64
}

fn out(json_format: bool) -> *Out {
    new(Out { pb: protobuf.encoder_with(4096), js: json.writer(0), json: json_format, marks: [] })
}

fn finished(o: *Out) -> []u8 {
    if o.json {
        return json.written_bytes(o.js)
    }
    protobuf.encoded(o.pb)
}

fn begin_root(o: *Out) {
    if o.json {
        json.start_object(o.js)
    }
}

fn end_root(o: *Out) {
    if o.json {
        json.end_object(o.js)
    }
}

fn open_list(o: *Out, name: str) {
    if o.json {
        json.property(o.js, name)
        json.start_array(o.js)
    }
}

fn close_list(o: *Out) {
    if o.json {
        json.end_array(o.js)
    }
}

fn open_item(o: *Out, number: i64) {
    if o.json {
        json.start_object(o.js)
        return
    }
    push(mut o.marks, o.pb.begin_message(number))
}

fn close_item(o: *Out) {
    if o.json {
        json.end_object(o.js)
        return
    }
    let mark = o.marks[o.marks.len - 1]
    truncate(mut o.marks, o.marks.len - 1)
    o.pb.end_message(mark)
}

fn open_field(o: *Out, number: i64, name: str) {
    if o.json {
        json.property(o.js, name)
    }
    open_item(o, number)
}

fn put_string(o: *Out, number: i64, name: str, v: str) {
    if v.len > 0 {
        put_string_always(o, number, name, v)
    }
}

fn put_string_always(o: *Out, number: i64, name: str, v: str) {
    if o.json {
        json.property(o.js, name)
        json.string_value(o.js, v)
        return
    }
    o.pb.write_string(number, v)
}

fn put_varint(o: *Out, number: i64, name: str, v: i64) {
    if v == 0 {
        return
    }
    if o.json {
        json.property(o.js, name)
        json.integer(o.js, v)
        return
    }
    o.pb.write_int64(number, v)
}

fn put_bool(o: *Out, number: i64, name: str, v: bool) {
    if v {
        put_bool_always(o, number, name, v)
    }
}

fn put_bool_always(o: *Out, number: i64, name: str, v: bool) {
    if o.json {
        json.property(o.js, name)
        json.boolean(o.js, v)
        return
    }
    o.pb.write_bool(number, v)
}

fn put_time(o: *Out, number: i64, name: str, v: i64) {
    if v == 0 {
        return
    }
    if o.json {
        json.property(o.js, name)
        json.string_value(o.js, "{u64(v)}")
        return
    }
    o.pb.write_fixed64(number, u64(v))
}

fn put_count64(o: *Out, number: i64, name: str, v: u64) {
    if v == 0 {
        return
    }
    if o.json {
        json.property(o.js, name)
        json.string_value(o.js, "{v}")
        return
    }
    o.pb.write_fixed64(number, v)
}

fn put_int_always(o: *Out, number: i64, name: str, v: i64) {
    if o.json {
        json.property(o.js, name)
        json.string_value(o.js, "{v}")
        return
    }
    o.pb.write_sfixed64(number, v)
}

fn put_flags(o: *Out, number: i64, name: str, v: u32) {
    if v == 0 {
        return
    }
    if o.json {
        json.property(o.js, name)
        json.unsigned(o.js, u64(v))
        return
    }
    o.pb.write_fixed32(number, v)
}

fn json_double(o: *Out, v: f64) {
    let bits = text.float_bits(v)
    if bits & 0x7FF0000000000000 != 0x7FF0000000000000 {
        json.float(o.js, v)
    } else if bits & 0x000FFFFFFFFFFFFF != 0 {
        json.string_value(o.js, "NaN")
    } else if bits >> 63 != 0 {
        json.string_value(o.js, "-Infinity")
    } else {
        json.string_value(o.js, "Infinity")
    }
}

fn put_double_always(o: *Out, number: i64, name: str, v: f64) {
    if o.json {
        json.property(o.js, name)
        json_double(o, v)
        return
    }
    o.pb.write_double(number, v)
}

fn put_id(o: *Out, number: i64, name: str, id: []u8) {
    if o.json {
        json.property(o.js, name)
        json.string_value(o.js, text.encode_hex(id))
        return
    }
    o.pb.write_bytes(number, id)
}

fn put_bytes_always(o: *Out, number: i64, name: str, data: []u8) {
    if o.json {
        json.property(o.js, name)
        json.string_value(o.js, base64.encode(data))
        return
    }
    o.pb.write_bytes(number, data)
}

fn put_counts(o: *Out, number: i64, name: str, values: []u64) {
    if values.len == 0 {
        return
    }
    if o.json {
        json.property(o.js, name)
        json.start_array(o.js)
        for v in values {
            json.string_value(o.js, "{v}")
        }
        json.end_array(o.js)
        return
    }
    o.pb.write_packed_fixed64(number, values)
}

fn put_doubles(o: *Out, number: i64, name: str, values: []f64) {
    if values.len == 0 {
        return
    }
    if o.json {
        json.property(o.js, name)
        json.start_array(o.js)
        for v in values {
            json_double(o, v)
        }
        json.end_array(o.js)
        return
    }
    o.pb.write_packed_doubles(number, values)
}

fn put_any(o: *Out, v: Value) {
    match v {
        Empty => {}
        Str(s) => put_string_always(o, 1, "stringValue", s)
        Bool(b) => put_bool_always(o, 2, "boolValue", b)
        Int(n) => {
            if o.json {
                json.property(o.js, "intValue")
                json.string_value(o.js, "{n}")
            } else {
                o.pb.write_int64(3, n)
            }
        }
        Double(x) => put_double_always(o, 4, "doubleValue", x)
        Array(values) => {
            open_field(o, 5, "arrayValue")
            open_list(o, "values")
            for x in values {
                open_item(o, 1)
                put_any(o, x)
                close_item(o)
            }
            close_list(o)
            close_item(o)
        }
        Map(entries) => {
            open_field(o, 6, "kvlistValue")
            put_attributes(o, 1, "values", entries)
            close_item(o)
        }
        Bytes(b) => put_bytes_always(o, 7, "bytesValue", b)
    }
}

fn put_attributes(o: *Out, number: i64, name: str, attributes: []Attribute) {
    if attributes.len == 0 {
        return
    }
    open_list(o, name)
    for a in attributes {
        open_item(o, number)
        put_string_always(o, 1, "key", a.key)
        open_field(o, 2, "value")
        put_any(o, a.value)
        close_item(o)
        close_item(o)
    }
    close_list(o)
}

fn put_resource(o: *Out, r: *Resource) {
    open_field(o, 1, "resource")
    put_attributes(o, 1, "attributes", r.attributes)
    close_item(o)
}

fn put_scope(o: *Out, s: Scope) {
    open_field(o, 1, "scope")
    put_string(o, 1, "name", s.name)
    put_string(o, 2, "version", s.version)
    close_item(o)
}

fn scope_key(s: Scope) -> str {
    "{s.name.len}:{s.name}{s.version.len}:{s.version}{s.schema_url}"
}

struct Group[T] {
    resource: *Resource
    scopes: []Scope
    items: [][]T
}

fn grouped[T](items: []T, resource_of: fn(T) -> *Resource, scope_of: fn(T) -> Scope) -> []Group[T] {
    var groups: []Group[T] = []
    for item in items {
        let r = resource_of(item)
        var gi = -1
        for i, g in groups {
            if g.resource == r {
                gi = i
            }
        }
        if gi < 0 {
            push(mut groups, Group[T] { resource: r, scopes: [], items: [] })
            gi = groups.len - 1
        }
        let s = scope_of(item)
        let key = scope_key(s)
        var si = -1
        for i, existing in groups[gi].scopes {
            if scope_key(existing) == key {
                si = i
            }
        }
        if si < 0 {
            push(mut groups[gi].scopes, s)
            push(mut groups[gi].items, [])
            si = groups[gi].scopes.len - 1
        }
        push(mut groups[gi].items[si], item)
    }
    groups
}

fn kind_code(k: Kind) -> i64 {
    match k {
        Internal => 1
        Server => 2
        Client => 3
        Producer => 4
        Consumer => 5
    }
}

fn link_flags(sc: SpanContext) -> u32 {
    u32(sc.flags) | 0x100 | if sc.remote { 0x200 } else { 0 }
}

fn put_span(o: *Out, d: *SpanData) {
    open_item(o, 2)
    put_id(o, 1, "traceId", trace_id_bytes(d.context))
    put_id(o, 2, "spanId", span_id_bytes(d.context))
    put_string(o, 3, "traceState", d.context.state)
    if valid(d.parent) {
        put_id(o, 4, "parentSpanId", span_id_bytes(d.parent))
    }
    put_string_always(o, 5, "name", d.name)
    put_varint(o, 6, "kind", kind_code(d.kind))
    put_time(o, 7, "startTimeUnixNano", d.start)
    put_time(o, 8, "endTimeUnixNano", d.end)
    put_attributes(o, 9, "attributes", d.attributes)
    put_varint(o, 10, "droppedAttributesCount", d.dropped_attributes)
    if d.events.len > 0 {
        open_list(o, "events")
        for e in d.events {
            open_item(o, 11)
            put_time(o, 1, "timeUnixNano", e.time)
            put_string(o, 2, "name", e.name)
            put_attributes(o, 3, "attributes", e.attributes)
            put_varint(o, 4, "droppedAttributesCount", e.dropped)
            close_item(o)
        }
        close_list(o)
    }
    put_varint(o, 12, "droppedEventsCount", d.dropped_events)
    if d.links.len > 0 {
        open_list(o, "links")
        for l in d.links {
            open_item(o, 13)
            put_id(o, 1, "traceId", trace_id_bytes(l.context))
            put_id(o, 2, "spanId", span_id_bytes(l.context))
            put_string(o, 3, "traceState", l.context.state)
            put_attributes(o, 4, "attributes", l.attributes)
            put_varint(o, 5, "droppedAttributesCount", l.dropped)
            put_flags(o, 6, "flags", link_flags(l.context))
            close_item(o)
        }
        close_list(o)
    }
    put_varint(o, 14, "droppedLinksCount", d.dropped_links)
    match d.status {
        Unset => {}
        Ok => {
            open_field(o, 15, "status")
            put_varint(o, 3, "code", 1)
            close_item(o)
        }
        Failed(message) => {
            open_field(o, 15, "status")
            put_string(o, 2, "message", message)
            put_varint(o, 3, "code", 2)
            close_item(o)
        }
    }
    put_flags(o, 16, "flags", u32(d.context.flags) | 0x100 | if d.parent.remote { 0x200 } else { 0 })
    close_item(o)
}

pub fn encode_traces(spans: []*SpanData, json_format: bool) -> []u8 {
    let o = out(json_format)
    begin_root(o)
    let groups = grouped(spans, fn(d: *SpanData) -> *Resource { d.resource }, fn(d: *SpanData) -> Scope { d.scope })
    open_list(o, "resourceSpans")
    for g in groups {
        open_item(o, 1)
        put_resource(o, g.resource)
        open_list(o, "scopeSpans")
        for i, s in g.scopes {
            open_item(o, 2)
            put_scope(o, s)
            open_list(o, "spans")
            for d in g.items[i] {
                put_span(o, d)
            }
            close_list(o)
            put_string(o, 3, "schemaUrl", s.schema_url)
            close_item(o)
        }
        close_list(o)
        put_string(o, 3, "schemaUrl", g.resource.schema_url)
        close_item(o)
    }
    close_list(o)
    end_root(o)
    finished(o)
}

fn temporality_code(t: Temporality) -> i64 {
    match t {
        Delta => 1
        Cumulative => 2
    }
}

fn put_number_point(o: *Out, m: MetricData, p: PointData) {
    open_item(o, 1)
    put_attributes(o, 7, "attributes", p.attributes)
    put_time(o, 2, "startTimeUnixNano", p.start)
    put_time(o, 3, "timeUnixNano", p.time)
    if m.integer {
        put_int_always(o, 6, "asInt", p.int_value)
    } else {
        put_double_always(o, 4, "asDouble", p.double_value)
    }
    close_item(o)
}

fn put_histogram_point(o: *Out, p: PointData) {
    open_item(o, 1)
    put_attributes(o, 9, "attributes", p.attributes)
    put_time(o, 2, "startTimeUnixNano", p.start)
    put_time(o, 3, "timeUnixNano", p.time)
    put_count64(o, 4, "count", p.count)
    put_double_always(o, 5, "sum", p.sum)
    put_counts(o, 6, "bucketCounts", p.buckets)
    put_doubles(o, 7, "explicitBounds", p.bounds)
    if p.count > 0 {
        put_double_always(o, 11, "min", p.min)
        put_double_always(o, 12, "max", p.max)
    }
    close_item(o)
}

fn put_metric(o: *Out, m: MetricData) {
    open_item(o, 2)
    put_string(o, 1, "name", m.name)
    put_string(o, 2, "description", m.description)
    put_string(o, 3, "unit", m.unit)
    match m.kind {
        Gauge => {
            open_field(o, 5, "gauge")
            open_list(o, "dataPoints")
            for p in m.points {
                put_number_point(o, m, p)
            }
            close_list(o)
            close_item(o)
        }
        Sum => {
            open_field(o, 7, "sum")
            open_list(o, "dataPoints")
            for p in m.points {
                put_number_point(o, m, p)
            }
            close_list(o)
            put_varint(o, 2, "aggregationTemporality", temporality_code(m.temporality))
            put_bool(o, 3, "isMonotonic", m.monotonic)
            close_item(o)
        }
        Histogram => {
            open_field(o, 9, "histogram")
            open_list(o, "dataPoints")
            for p in m.points {
                put_histogram_point(o, p)
            }
            close_list(o)
            put_varint(o, 2, "aggregationTemporality", temporality_code(m.temporality))
            close_item(o)
        }
    }
    close_item(o)
}

pub fn encode_metrics(batch: MetricBatch, json_format: bool) -> []u8 {
    let o = out(json_format)
    begin_root(o)
    let r = batch.resource
    let groups = grouped(batch.metrics, fn(m: MetricData) -> *Resource { r }, fn(m: MetricData) -> Scope { m.scope })
    open_list(o, "resourceMetrics")
    for g in groups {
        open_item(o, 1)
        put_resource(o, g.resource)
        open_list(o, "scopeMetrics")
        for i, s in g.scopes {
            open_item(o, 2)
            put_scope(o, s)
            open_list(o, "metrics")
            for m in g.items[i] {
                put_metric(o, m)
            }
            close_list(o)
            put_string(o, 3, "schemaUrl", s.schema_url)
            close_item(o)
        }
        close_list(o)
        put_string(o, 3, "schemaUrl", g.resource.schema_url)
        close_item(o)
    }
    close_list(o)
    end_root(o)
    finished(o)
}

fn put_log(o: *Out, d: *LogData) {
    let r = d.record
    open_item(o, 2)
    put_time(o, 1, "timeUnixNano", r.time)
    put_varint(o, 2, "severityNumber", r.severity)
    put_string(o, 3, "severityText", r.severity_text)
    match r.body {
        Empty => {}
        _ => {
            open_field(o, 5, "body")
            put_any(o, r.body)
            close_item(o)
        }
    }
    put_attributes(o, 6, "attributes", r.attributes)
    put_varint(o, 7, "droppedAttributesCount", d.dropped)
    if valid(d.context) {
        put_flags(o, 8, "flags", u32(d.context.flags))
        put_id(o, 9, "traceId", trace_id_bytes(d.context))
        put_id(o, 10, "spanId", span_id_bytes(d.context))
    }
    put_time(o, 11, "observedTimeUnixNano", d.observed)
    put_string(o, 12, "eventName", r.event_name)
    close_item(o)
}

pub fn encode_logs(logs: []*LogData, json_format: bool) -> []u8 {
    let o = out(json_format)
    begin_root(o)
    let groups = grouped(logs, fn(d: *LogData) -> *Resource { d.resource }, fn(d: *LogData) -> Scope { d.scope })
    open_list(o, "resourceLogs")
    for g in groups {
        open_item(o, 1)
        put_resource(o, g.resource)
        open_list(o, "scopeLogs")
        for i, s in g.scopes {
            open_item(o, 2)
            put_scope(o, s)
            open_list(o, "logRecords")
            for d in g.items[i] {
                put_log(o, d)
            }
            close_list(o)
            put_string(o, 3, "schemaUrl", s.schema_url)
            close_item(o)
        }
        close_list(o)
        put_string(o, 3, "schemaUrl", g.resource.schema_url)
        close_item(o)
    }
    close_list(o)
    end_root(o)
    finished(o)
}
