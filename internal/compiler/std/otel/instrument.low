import std/header
import std/http
import std/sql
import std/text
import std/time

struct CallState {
    span: Span
    outer: *Context?
    begun: i64
    category: str
    scope: str
    method: str
    facts: []Attribute
    lock: i64
}

/// An instrumented operation in progress, returned by `server_span` and `db_span` and ended with `end_server` or `end_with`.
/// A call made while no SDK is active does nothing. A call made inside an operation of the same kind joins that operation and does not end it.
pub struct Call {
    state: *CallState?
    owned: bool
}

fn idle() -> Call {
    Call { state: none, owned: false }
}

/// Reports whether the call is tied to a span, which is false when no SDK was active when it began.
pub fn recording(c: Call) -> bool {
    match c.state {
        some(_) => true
        none => false
    }
}

fn known_method(m: str) -> bool {
    m == "GET" || m == "HEAD" || m == "POST" || m == "PUT" || m == "DELETE" || m == "CONNECT" || m == "OPTIONS" || m == "TRACE" || m == "PATCH"
}

fn span_method(m: str) -> str {
    if m == "_OTHER" { "HTTP" } else { m }
}

/// Sets the string attribute `key` on the call's span.
/// The attribute is also kept for use as a metric attribute when the call ends. Nothing happens when the call is not recording.
pub fn tag(c: Call, key: str, value: str) {
    let s = match c.state {
        some(x) => x
        none => return
    }
    let a = string(key, value)
    __lock(mut s.lock)
    upsert(mut s.facts, a, 1 << 20)
    __unlock(mut s.lock)
    set_attribute(s.span, a)
}

/// Sets the integer attribute `key` on the call's span, and keeps it for the metric as `tag` does.
pub fn tag_int(c: Call, key: str, value: i64) {
    let s = match c.state {
        some(x) => x
        none => return
    }
    let a = int(key, value)
    __lock(mut s.lock)
    upsert(mut s.facts, a, 1 << 20)
    __unlock(mut s.lock)
    set_attribute(s.span, a)
}

fn begin(sdk: *SdkHandle, parent: *Context, scope: str, category: str, name: str, kind: Kind, method: str, facts: []Attribute) -> Call {
    let s = start_with(Tracer { scope: Scope { name: scope } }, name, StartOptions { kind, parent: some(parent), attributes: facts })
    let state = new(CallState { span: s, outer: some(current()), begun: time.monotonic(), category, scope, method, facts, lock: 0 })
    if category.len > 0 {
        var next = *parent
        next.span = s
        next.call = some(state)
        __set_context(new(next))
    } else {
        __set_context(with_span(parent, s))
    }
    Call { state, owned: true }
}

fn selected(facts: []Attribute, keys: []str) -> []Attribute {
    var out: []Attribute = []
    for k in keys {
        match lookup(facts, k) {
            some(v) => push(mut out, Attribute { key: k, value: v })
            none => {}
        }
    }
    out
}

fn finish(c: Call, metric: str, description: str, keys: []str) {
    let s = match c.state {
        some(x) => x
        none => return
    }
    if !c.owned {
        return
    }
    let elapsed = f64(time.monotonic() - s.begun) / 1000000000.0
    end(s.span)
    match s.outer {
        some(o) => detach(o)
        none => {}
    }
    __lock(mut s.lock)
    let facts = selected(s.facts, keys)
    __unlock(mut s.lock)
    let h = histogram[f64](Meter { scope: Scope { name: s.scope } }, metric, "s", description, duration_bounds())
    h.record(elapsed, facts)
}

/// Starts a server span for the HTTP request `r` under `scope` and makes it the calling green thread's context.
/// The parent is extracted from the request's `traceparent`, `tracestate` and `baggage` headers. The span is named after the method, or `HTTP` for a method outside the standard set, and carries the request method, `url.path`, `url.query`, `server.address`, `client.address`, `user_agent.original` and `network.protocol.version` where known. Returns an idle call when no SDK is active, and a call that does not own the span when a server call is already in progress, so a framework can name and finish the span that `std/http` opened.
pub fn server_span(scope: str, r: http.Request) -> Call {
    let sdk = match active_sdk() {
        some(x) => x
        none => return idle()
    }
    let enclosing = current()
    match enclosing.call {
        some(outer) => {
            if outer.category == "http.server" {
                return Call { state: outer, owned: false }
            }
        }
        none => {}
    }
    let parent = extract_into(enclosing, r.headers)
    let method = if known_method(r.method) { r.method } else { "_OTHER" }
    var facts = [string("http.request.method", method), string("url.path", r.path)]
    if method != r.method {
        push(mut facts, string("http.request.method_original", r.method))
    }
    if r.query.len > 0 {
        push(mut facts, string("url.query", r.query))
    }
    let authority = if r.authority.len > 0 { r.authority } else { header.get(r.headers, "host") ?? "" }
    if authority.len > 0 {
        push(mut facts, string("server.address", http.authority_host(authority)))
    }
    if r.remote.len > 0 {
        push(mut facts, string("client.address", r.remote))
    }
    match header.get(r.headers, "user-agent") {
        some(agent) => push(mut facts, string("user_agent.original", agent))
        none => {}
    }
    push(mut facts, string("network.protocol.version", http.version_text(r.version)))
    begin(sdk, parent, scope, "http.server", span_method(method), Server, method, facts)
}

/// Finishes the server call `c` for a response with `status`.
/// A non-empty `route` renames the span to the method and route and sets `http.route`. `http.response.status_code` is set, and a status of 500 or more also sets `error.type` and a failed status. A call that owns the span then ends it, restores the context that was current when the call began and records the `http.server.request.duration` histogram, in seconds, with the method, route, status code, protocol version and error type.
pub fn end_server(c: Call, route: str, status: i64) {
    let s = match c.state {
        some(x) => x
        none => return
    }
    if route.len > 0 {
        update_name(s.span, "{span_method(s.method)} {route}")
        tag(c, "http.route", route)
    }
    tag_int(c, "http.response.status_code", status)
    if status >= 500 {
        tag(c, "error.type", "{status}")
        set_status(s.span, Failed(""))
    }
    finish(c, "http.server.request.duration", "Duration of HTTP server requests.", [
        "http.request.method", "http.route", "http.response.status_code", "network.protocol.version", "error.type",
    ])
}

fn serve_traced(r: http.Request, handler: fn(http.Request) -> http.Response) -> http.Response {
    let call = server_span("std/http", r)
    let resp = handler(r)
    end_server(call, "", resp.status)
    resp
}

fn client_attempt(s: http.Sending) -> http.Sent {
    let parent = current()
    let method = if known_method(s.method) { s.method } else { "_OTHER" }
    var facts = [
        string("http.request.method", method), string("server.address", s.url.host), int("server.port", s.url.port),
        string("url.full", http.format_url(s.url)),
    ]
    if method != s.method {
        push(mut facts, string("http.request.method_original", s.method))
    }
    if s.resend > 0 {
        push(mut facts, int("http.request.resend_count", s.resend))
    }
    let span = start_with(Tracer { scope: Scope { name: "std/http" } }, span_method(method), StartOptions { kind: Client, parent: some(parent), attributes: facts })
    var headers: []header.Header = []
    for h in s.headers {
        push(mut headers, h)
    }
    let carrier = with_span(parent, span)
    inject(carrier, mut headers)
    let state = new(CallState { span, outer: none, begun: time.monotonic(), category: "", scope: "std/http", method, facts, lock: 0 })
    let call = Call { state, owned: true }
    http.Sent { headers, done: fn(status: i64, version: str, error_type: str) { end_client(call, status, version, error_type) } }
}

fn end_client(c: Call, status: i64, version: str, error_type: str) {
    let s = match c.state {
        some(x) => x
        none => return
    }
    if version.len > 0 {
        tag(c, "network.protocol.version", version)
    }
    if status > 0 {
        tag_int(c, "http.response.status_code", status)
    }
    let failure = if error_type.len > 0 { error_type } else if status >= 400 { "{status}" } else { "" }
    if failure.len > 0 {
        tag(c, "error.type", failure)
        set_status(s.span, Failed(""))
    }
    finish(c, "http.client.request.duration", "Duration of HTTP client requests.", [
        "http.request.method", "server.address", "server.port", "network.protocol.version", "http.response.status_code", "error.type",
    ])
}

fn http_observer() -> *http.Observer {
    new(http.Observer { serve: serve_traced, send: client_attempt })
}

fn first_word(query: str) -> str {
    let trimmed = text.trim(query)
    var n = 0
    for n < trimmed.len && (trimmed[n] >= 'a' && trimmed[n] <= 'z' || trimmed[n] >= 'A' && trimmed[n] <= 'Z') {
        n += 1
    }
    var out: []u8 = []
    for i in 0..n {
        let c = trimmed[i]
        push(mut out, if c >= 'a' && c <= 'z' { c - 32 } else { c })
    }
    __str_view(out)
}

/// Starts a client span for a database call under `scope` and makes it the calling green thread's context.
/// `system` is the `db.system.name`. An empty `operation` is taken from the first word of `query`, in upper case. The span is named from the operation and `collection`, from the operation alone or from `system`, and carries the system, operation, collection and query text where present. Returns an idle call when no SDK is active, and a call that does not own the span when a database call is already in progress, so a nested call merges into the outer one.
pub fn db_span(scope: str, system: str, operation: str, collection: str, query: str) -> Call {
    let sdk = match active_sdk() {
        some(x) => x
        none => return idle()
    }
    let parent = current()
    match parent.call {
        some(outer) => {
            if outer.category == "db" {
                return Call { state: outer, owned: false }
            }
        }
        none => {}
    }
    let op = if operation.len > 0 { operation } else { first_word(query) }
    var facts = [string("db.system.name", system)]
    if op.len > 0 {
        push(mut facts, string("db.operation.name", op))
    }
    if collection.len > 0 {
        push(mut facts, string("db.collection.name", collection))
    }
    if query.len > 0 {
        push(mut facts, string("db.query.text", query))
    }
    let name = if op.len > 0 && collection.len > 0 { "{op} {collection}" } else if op.len > 0 { op } else { system }
    begin(sdk, parent, scope, "db", name, Client, op, facts)
}

/// Finishes the database call `c`.
/// A non-empty `error_type` sets `error.type` and a failed status carrying the same text. A call that owns the span then ends it, restores the context that was current when the call began and records the `db.client.operation.duration` histogram, in seconds, with the system, namespace, operation, collection, response code, server address, port and error type that were set.
pub fn end_with(c: Call, error_type: str) {
    let s = match c.state {
        some(x) => x
        none => return
    }
    if !c.owned {
        return
    }
    if error_type.len > 0 {
        tag(c, "error.type", error_type)
        set_status(s.span, Failed(error_type))
    }
    finish(c, "db.client.operation.duration", "Duration of database client operations.", [
        "db.system.name", "db.namespace", "db.operation.name", "db.collection.name", "db.response.status_code",
        "server.address", "server.port", "error.type",
    ])
}

fn end_failed(c: Call, e: sql.Error) {
    match e {
        Server(code, _) => {
            tag(c, "db.response.status_code", code)
            end_with(c, code)
        }
        _ => end_with(c, "{e}")
    }
}

fn traced_sql[T](c: Call, work: fn() -> T ! sql.Error) -> T ! sql.Error {
    let out = work() catch {
        e => {
            end_failed(c, e)
            fail e
        }
    }
    end_with(c, "")
    out
}

fn untagged(c: Call) {}

fn sql_call[T](db: sql.ConnectionHandle, scope: str, operation: str, collection: str, query: str, endpoint: fn(Call), work: fn() -> T ! sql.Error) -> T ! sql.Error {
    let c = db_span(scope, db.dialect.system, operation, collection, query)
    if !recording(c) {
        return work()
    }
    endpoint(c)
    traced_sql(c, work)
}

fn query_call(db: sql.ConnectionHandle, scope: str, operation: str, collection: str, query: str, values: []sql.Value, endpoint: fn(Call)) -> sql.Rows ! sql.Error {
    sql_call(db, scope, operation, collection, query, endpoint, fn() -> sql.Rows ! sql.Error { db.query(query, values) })
}

fn execute_call(db: sql.ConnectionHandle, scope: str, operation: str, collection: str, query: str, values: []sql.Value, endpoint: fn(Call)) -> i64 ! sql.Error {
    sql_call(db, scope, operation, collection, query, endpoint, fn() -> i64 ! sql.Error { db.execute(query, values) })
}

fn each_call(db: sql.ConnectionHandle, scope: str, operation: str, collection: str, query: str, values: []sql.Value, visit: fn([]sql.Column, []sql.Value) -> bool, endpoint: fn(Call)) ! sql.Error {
    sql_call(db, scope, operation, collection, query, endpoint, fn() -> bool ! sql.Error {
        db.each(query, values, visit)?
        true
    })?
}

/// Runs `db.query` inside a database call and returns its rows.
/// `operation` and `collection` name what the statement does and where; see `db_span`. An `sql.Error` is returned unchanged and its variant name becomes `error.type`; for a `Server` error the code is used and also set as `db.response.status_code`. With no SDK active the query runs directly.
pub fn sql_query(db: sql.ConnectionHandle, scope: str, operation: str, collection: str, query: str, values: []sql.Value) -> sql.Rows ! sql.Error {
    query_call(db, scope, operation, collection, query, values, untagged)
}

/// Runs `db.execute` inside a database call and returns the affected row count. The span and errors are handled as in `sql_query`.
pub fn sql_execute(db: sql.ConnectionHandle, scope: str, operation: str, collection: str, query: str, values: []sql.Value) -> i64 ! sql.Error {
    execute_call(db, scope, operation, collection, query, values, untagged)
}

/// Runs `db.each` inside a database call, passing each row to `visit`. The span and errors are handled as in `sql_query`.
pub fn sql_each(db: sql.ConnectionHandle, scope: str, operation: str, collection: str, query: str, values: []sql.Value, visit: fn([]sql.Column, []sql.Value) -> bool) ! sql.Error {
    each_call(db, scope, operation, collection, query, values, visit, untagged)?
}

/// Returns a connection handle whose `query`, `each` and `execute` run inside database calls and whose other functions are those of `db`.
/// `namespace` is set as `db.namespace` when it is not empty, and `server` and `port` as `server.address` and `server.port`. The operation comes from the first word of the statement and the collection is not set. The drivers apply it once, through `std/sql/driver`.
pub fn instrument_sql(db: sql.ConnectionHandle, scope: str, namespace: str, server: str, port: i64) -> sql.ConnectionHandle {
    let endpoint = fn(c: Call) {
        if namespace.len > 0 {
            tag(c, "db.namespace", namespace)
        }
        tag(c, "server.address", server)
        tag_int(c, "server.port", port)
    }
    var instrumented = db
    instrumented.query = fn(query, values) -> sql.Rows ! sql.Error { query_call(db, scope, "", "", query, values, endpoint) }
    instrumented.each = fn(query, values, visit) ! sql.Error { each_call(db, scope, "", "", query, values, visit, endpoint)? }
    instrumented.execute = fn(query, values) -> i64 ! sql.Error { execute_call(db, scope, "", "", query, values, endpoint) }
    instrumented
}
