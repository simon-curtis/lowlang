import std/otel

fn discard() -> otel.MetricExporter {
    otel.MetricExporter { export: fn(batch) -> bool { true }, shutdown: fn() {} }
}

fn handle(requests: otel.Measure[i64], latency: otel.Measure[f64], method: str, seconds: f64) {
    let attributes = [otel.string("method", method)]
    requests.add(1, attributes)
    latency.record(seconds, attributes)
}

/// Counts requests and records their latency, then collects the instruments by hand and prints each metric.
fn main() {
    let resource = new(otel.Resource { attributes: [otel.string("service.name", "shop")] })
    using sdk = otel.install(otel.Config {
        resource: some(resource)
        metric_readers: [otel.MetricReader { exporter: discard(), interval: 0 }]
    })

    let meter = otel.meter("shop.http")
    let requests = otel.counter[i64](meter, "http.requests", "{{request}}", "Requests served")
    let latency = otel.histogram[f64](meter, "http.latency", "s", "Time to respond", [0.1, 0.5, 1.0])
    handle(requests, latency, "GET", 0.02)
    handle(requests, latency, "GET", 0.7)
    handle(requests, latency, "POST", 0.2)
    handle(requests, latency, "GET", 0.04)

    let batch = otel.collect(sdk, 0)
    for m in batch.metrics {
        for line in otel.format_metric(m) {
            print(line)
        }
    }
}
