import std/file
import std/text
import std/uri

/// The entity that produces telemetry, described by attributes such as `service.name`.
pub struct Resource {
    /// The resource attributes.
    pub attributes: []Attribute
    /// The schema URL of the attribute conventions, or empty.
    pub schema_url: str = ""
}

/// Parses a comma-separated list of `key=value` pairs, as in `OTEL_RESOURCE_ATTRIBUTES` and `OTEL_EXPORTER_OTLP_HEADERS`.
/// Whitespace around keys and values is trimmed and `%XX` escapes are decoded. Members without a `=` or with an empty key are skipped, and a later member replaces an earlier one with the same key.
pub fn parse_pairs(s: str) -> []Attribute {
    var out: []Attribute = []
    for part in text.split(s, ',') {
        let eq = text.index_byte(part, '=')
        if eq <= 0 {
            continue
        }
        let key = text.trim(part[..eq])
        if key.len == 0 {
            continue
        }
        upsert(mut out, string(uri.unescape_lossy(key), uri.unescape_lossy(text.trim(part[eq + 1..]))), 1 << 20)
    }
    out
}

fn process_name() -> str {
    let comm = file.read_text("/proc/self/comm") or return ""
    text.trim(comm)
}

/// Returns the resource for a process, read from the environment map `env`.
/// It holds `telemetry.sdk.name` and `telemetry.sdk.language`, the pairs in `OTEL_RESOURCE_ATTRIBUTES`, and `service.name` from `OTEL_SERVICE_NAME`, which overrides the same key in the pairs. When no `service.name` results, it is `unknown_service:` followed by the process name from `/proc/self/comm`, or `unknown_service` when that cannot be read.
pub fn default_resource(env: [str: str]) -> *Resource {
    var attributes: []Attribute = [
        string("telemetry.sdk.name", "opentelemetry")
        string("telemetry.sdk.language", "lowlang")
    ]
    for a in parse_pairs(env["OTEL_RESOURCE_ATTRIBUTES"] ?? "") {
        upsert(mut attributes, a, 1 << 20)
    }
    let service = env["OTEL_SERVICE_NAME"] ?? ""
    if service.len > 0 {
        upsert(mut attributes, string("service.name", service), 1 << 20)
    }
    match lookup(attributes, "service.name") {
        some(_) => {}
        none => {
            let name = process_name()
            push(mut attributes, string("service.name", if name.len > 0 { "unknown_service:{name}" } else { "unknown_service" }))
        }
    }
    new(Resource { attributes })
}

/// Returns a new resource holding the attributes of `base` with `extra` added; an attribute in `extra` replaces one in `base` with the same key.
/// The schema URL of `base` is kept and `base` is not modified.
pub fn merge(base: *Resource, extra: []Attribute) -> *Resource {
    var copy: []Attribute = []
    for a in base.attributes {
        push(mut copy, a)
    }
    for a in extra {
        upsert(mut copy, a, 1 << 20)
    }
    new(Resource { attributes: copy, schema_url: base.schema_url })
}
