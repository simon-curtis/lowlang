import std/file
import std/text

pub struct Resource {
    pub attributes: []Attribute
    pub schema_url: str = ""
}

fn hex_digit(c: u8) -> i64 {
    if c >= '0' && c <= '9' {
        return i64(c - '0')
    }
    if c >= 'a' && c <= 'f' {
        return i64(c - 'a') + 10
    }
    if c >= 'A' && c <= 'F' {
        return i64(c - 'A') + 10
    }
    -1
}

fn percent_decode(s: str) -> str {
    if text.index_byte(s, '%') < 0 {
        return s
    }
    var out: []u8 = []
    var i = 0
    for i < s.len {
        if s[i] == '%' && i + 2 < s.len && hex_digit(s[i + 1]) >= 0 && hex_digit(s[i + 2]) >= 0 {
            push(mut out, u8(hex_digit(s[i + 1]) << 4 | hex_digit(s[i + 2])))
            i += 3
        } else {
            push(mut out, s[i])
            i += 1
        }
    }
    __str_view(out)
}

pub fn parse_pairs(s: str) -> []Attribute {
    var out: []Attribute = []
    for part in text.split(s, ',') {
        let eq = text.index_byte(part, '=')
        if eq <= 0 {
            continue
        }
        let key = text.trim(part[..eq])
        if key.len == 0 {
            continue
        }
        upsert(mut out, string(percent_decode(key), percent_decode(text.trim(part[eq + 1..]))), 1 << 20)
    }
    out
}

fn process_name() -> str {
    let comm = file.read_text("/proc/self/comm") catch {
        _ => return ""
    }
    text.trim(comm)
}

pub fn default_resource(env: [str: str]) -> *Resource {
    var attributes: []Attribute = [
        string("telemetry.sdk.name", "opentelemetry")
        string("telemetry.sdk.language", "lowlang")
    ]
    for a in parse_pairs(env["OTEL_RESOURCE_ATTRIBUTES"] ?? "") {
        upsert(mut attributes, a, 1 << 20)
    }
    let service = env["OTEL_SERVICE_NAME"] ?? ""
    if service.len > 0 {
        upsert(mut attributes, string("service.name", service), 1 << 20)
    }
    match lookup(attributes, "service.name") {
        some(_) => {}
        none => {
            let name = process_name()
            push(mut attributes, string("service.name", if name.len > 0 { "unknown_service:{name}" } else { "unknown_service" }))
        }
    }
    new(Resource { attributes })
}

pub fn merge(base: *Resource, extra: []Attribute) -> *Resource {
    var copy: []Attribute = []
    for a in base.attributes {
        push(mut copy, a)
    }
    for a in extra {
        upsert(mut copy, a, 1 << 20)
    }
    new(Resource { attributes: copy, schema_url: base.schema_url })
}
