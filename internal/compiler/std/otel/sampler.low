pub enum Sampler {
    AlwaysOn
    AlwaysOff
    TraceIdRatio(ratio: f64)
    ParentBased(config: *ParentSamplers)
}

pub struct ParentSamplers {
    pub root: Sampler
    pub remote_sampled: Sampler = AlwaysOn
    pub remote_not_sampled: Sampler = AlwaysOff
    pub local_sampled: Sampler = AlwaysOn
    pub local_not_sampled: Sampler = AlwaysOff
}

pub fn parent_based(root: Sampler) -> Sampler {
    ParentBased(new(ParentSamplers { root }))
}

fn ratio_bound(ratio: f64) -> u64 {
    u64(ratio * 9223372036854775808.0)
}

pub fn should_sample(s: Sampler, parent: SpanContext, trace_lo: u64) -> bool {
    match s {
        AlwaysOn => true
        AlwaysOff => false
        TraceIdRatio(ratio) => {
            if ratio >= 1.0 {
                return true
            }
            if ratio <= 0.0 {
                return false
            }
            trace_lo >> 1 < ratio_bound(ratio)
        }
        ParentBased(c) => {
            if !valid(parent) {
                return should_sample(c.root, parent, trace_lo)
            }
            let next = if parent.remote {
                if sampled(parent) { c.remote_sampled } else { c.remote_not_sampled }
            } else {
                if sampled(parent) { c.local_sampled } else { c.local_not_sampled }
            }
            should_sample(next, parent, trace_lo)
        }
    }
}

pub fn description(s: Sampler) -> str {
    match s {
        AlwaysOn => "AlwaysOnSampler"
        AlwaysOff => "AlwaysOffSampler"
        TraceIdRatio(ratio) => "TraceIdRatioBased{{{ratio}}}"
        ParentBased(c) => "ParentBased{{root:{description(c.root)},remoteParentSampled:{description(c.remote_sampled)},remoteParentNotSampled:{description(c.remote_not_sampled)},localParentSampled:{description(c.local_sampled)},localParentNotSampled:{description(c.local_not_sampled)}}}"
    }
}
