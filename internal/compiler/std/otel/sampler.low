/// The rule that decides whether a new span is recorded and exported.
pub enum Sampler {
    /// Records every span.
    AlwaysOn
    /// Records a fixed fraction of traces chosen from the trace id.
    /// `ratio` is the fraction from `0.0` to `1.0`; `1.0` or more records every trace and `0.0` or less records none. The decision depends only on the trace id, so every service in a trace that uses the same ratio agrees.
    AlwaysOff
    /// Records no span.
    TraceIdRatio(ratio: f64)
    /// Chooses a sampler from the span's parent, as set out in `ParentSamplers`.
    ParentBased(config: *ParentSamplers)
}

/// The samplers a `ParentBased` sampler uses for each kind of parent.
pub struct ParentSamplers {
    /// Used when the span has no valid parent.
    pub root: Sampler
    /// Used when the parent came from another process and was sampled. Defaults to `AlwaysOn`.
    pub remote_sampled: Sampler = AlwaysOn
    /// Used when the parent came from another process and was not sampled. Defaults to `AlwaysOff`.
    pub remote_not_sampled: Sampler = AlwaysOff
    /// Used when the parent is in this process and was sampled. Defaults to `AlwaysOn`.
    pub local_sampled: Sampler = AlwaysOn
    /// Used when the parent is in this process and was not sampled. Defaults to `AlwaysOff`.
    pub local_not_sampled: Sampler = AlwaysOff
}

/// Returns a `ParentBased` sampler that follows its parent's sampling decision and uses `root` for spans without a valid parent.
pub fn parent_based(root: Sampler) -> Sampler {
    ParentBased(new(ParentSamplers { root }))
}

fn ratio_bound(ratio: f64) -> u64 {
    u64(ratio * 9223372036854775808.0)
}

/// Reports whether a span is sampled.
/// `parent` is the parent span context, which is invalid for a root span, and `trace_lo` is the low 64 bits of the new span's trace id. `TraceIdRatio` compares the low 63 bits of the trace id with the ratio.
pub fn should_sample(s: Sampler, parent: SpanContext, trace_lo: u64) -> bool {
    match s {
        AlwaysOn => true
        AlwaysOff => false
        TraceIdRatio(ratio) => {
            if ratio >= 1.0 {
                return true
            }
            if ratio <= 0.0 {
                return false
            }
            trace_lo >> 1 < ratio_bound(ratio)
        }
        ParentBased(c) => {
            if !valid(parent) {
                return should_sample(c.root, parent, trace_lo)
            }
            let next = if parent.remote {
                if sampled(parent) { c.remote_sampled } else { c.remote_not_sampled }
            } else {
                if sampled(parent) { c.local_sampled } else { c.local_not_sampled }
            }
            should_sample(next, parent, trace_lo)
        }
    }
}

/// Returns the sampler's description in the form the OpenTelemetry specification uses, such as `AlwaysOnSampler` or `TraceIdRatioBased{0.25}`.
pub fn description(s: Sampler) -> str {
    match s {
        AlwaysOn => "AlwaysOnSampler"
        AlwaysOff => "AlwaysOffSampler"
        TraceIdRatio(ratio) => "TraceIdRatioBased{{{ratio}}}"
        ParentBased(c) => "ParentBased{{root:{description(c.root)},remoteParentSampled:{description(c.remote_sampled)},remoteParentNotSampled:{description(c.remote_not_sampled)},localParentSampled:{description(c.local_sampled)},localParentNotSampled:{description(c.local_not_sampled)}}}"
    }
}
