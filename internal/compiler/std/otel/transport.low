import std/base64
import std/compress/deflate
import std/header
import std/http
import std/io
import std/protobuf
import std/retry
import std/text
import std/time/duration

/// The OTLP wire protocol an exporter uses.
pub enum Protocol {
    /// OTLP over HTTP/1.1 with a protobuf body.
    HttpProtobuf
    /// OTLP over HTTP/1.1 with a JSON body.
    HttpJson
    /// OTLP over gRPC on HTTP/2, with prior knowledge for `http://` URLs.
    Grpc
}

/// Settings for the OTLP exporters.
pub struct OtlpOptions {
    /// The collector base URL. Empty uses `http://localhost:4318`, or `http://localhost:4317` for `Grpc`. Over HTTP the signal path `/v1/traces`, `/v1/metrics` or `/v1/logs` is appended; over gRPC only the scheme, host and port are used.
    pub endpoint: str = ""
    /// The full URL for traces, used instead of `endpoint` when not empty.
    pub traces_endpoint: str = ""
    /// The full URL for metrics, used instead of `endpoint` when not empty.
    pub metrics_endpoint: str = ""
    /// The full URL for logs, used instead of `endpoint` when not empty.
    pub logs_endpoint: str = ""
    /// Headers added to every request.
    pub headers: []header.Header = []
    /// The wire protocol. Defaults to `HttpProtobuf`.
    pub protocol: Protocol = HttpProtobuf
    /// Whether to compress the body with gzip. Defaults to `false`.
    pub gzip: bool = false
    /// The time in milliseconds one request may take. Defaults to `10000`.
    pub timeout: i64 = 10000
    /// The most attempts for one export, the first included. Defaults to `5`.
    pub attempts: i64 = 5
    /// The wait in milliseconds before the first retry. It doubles for each further retry up to `max_backoff`, with equal jitter, so each wait is between half and all of that delay. A wait the server asks for with `Retry-After` or `RetryInfo` raises the wait but does not lower it. Defaults to `1000`.
    pub backoff: i64 = 1000
    /// The longest wait between retries in milliseconds. Defaults to `30000`.
    pub max_backoff: i64 = 30000
}

fn grpc(o: OtlpOptions) -> bool {
    match o.protocol {
        Grpc => true
        _ => false
    }
}

/// Returns the collector base URL: `o.endpoint`, or the local default for the protocol when it is empty.
pub fn endpoint_of(o: OtlpOptions) -> str {
    if o.endpoint.len > 0 {
        return o.endpoint
    }
    if grpc(o) { "http://localhost:4317" } else { "http://localhost:4318" }
}

fn signal_url(o: OtlpOptions, specific: str, path: str, service: str) -> str {
    if grpc(o) {
        let target = if specific.len > 0 { specific } else { endpoint_of(o) }
        let u = http.parse_url(target) catch {
            _ => return target
        }
        return "{http.origin(u)}/opentelemetry.proto.collector.{service}/Export"
    }
    if specific.len > 0 {
        return specific
    }
    let endpoint = endpoint_of(o)
    let base = if text.ends_with(endpoint, "/") { endpoint[..endpoint.len - 1] } else { endpoint }
    "{base}{path}"
}

fn exporter_client(o: OtlpOptions) -> *http.Client {
    let base = http.client()
        .with_timeout(o.timeout)
        .with_retries(0)
        .with_decompression(false)
    if grpc(o) {
        return base.with_version(Http2).with_prior_knowledge(true).build()
    }
    base.with_version(Http1).build()
}

fn post(client: *http.Client, url: str, headers: []header.Header, content_type: str, payload: []u8) -> http.Response? {
    let base = http.request(client, "POST", url)
    var b = http.with_body(base, payload, content_type)
    for h in headers {
        b = http.with_header(b, h.name, h.value)
    }
    let resp = http.send(b) catch {
        _ => return none
    }
    resp
}

fn waiting(failure: i64, wait_ms: i64) -> retry.Step[bool, i64] {
    if wait_ms < 0 {
        return Retry(failure)
    }
    RetryAfter(failure, duration.milliseconds(wait_ms))
}

fn http_step(resp: http.Response) -> retry.Step[bool, i64] {
    if resp.status >= 200 && resp.status < 300 {
        return Done(true)
    }
    if !http.retry_status(resp.status) {
        return Fatal(resp.status)
    }
    waiting(resp.status, http.retry_after_ms(resp.headers))
}

fn grpc_frame(body: []u8, compressed: bool) -> []u8 {
    let out: []u8 = __make(5 + body.len)
    out[0] = if compressed { 1 } else { 0 }
    out[1] = u8(body.len >> 24)
    out[2] = u8(body.len >> 16)
    out[3] = u8(body.len >> 8)
    out[4] = u8(body.len)
    __memmove(out[5..], body)
    out
}

fn grpc_value(resp: http.Response, name: str) -> str? {
    match header.get(resp.trailers, name) {
        some(v) => some(v)
        none => header.get(resp.headers, name)
    }
}

fn padded(s: str) -> str {
    let missing = (4 - s.len % 4) % 4
    if missing == 2 { "{s}==" } else if missing == 1 { "{s}=" } else { s }
}

fn duration_ms(data: []u8) -> i64 ! io.Error {
    var seconds = 0
    var nanos = 0
    let d = protobuf.decoder(data)
    for {
        let f = match d.next()? {
            some(x) => x
            none => break
        }
        if f.number == 1 {
            seconds = f.as_int64()?
        } else if f.number == 2 {
            nanos = i64(f.as_int32()?)
        }
    }
    seconds * 1000 + nanos / 1000000
}

fn retry_info_delay(any: []u8) -> i64 ! io.Error {
    var type_url = ""
    var value: []u8 = []
    let d = protobuf.decoder(any)
    for {
        let f = match d.next()? {
            some(x) => x
            none => break
        }
        if f.number == 1 {
            type_url = f.as_string()?
        } else if f.number == 2 {
            value = f.as_bytes()?
        }
    }
    if type_url != "type.googleapis.com/google.rpc.RetryInfo" {
        return -1
    }
    let r = protobuf.decoder(value)
    for {
        let f = match r.next()? {
            some(x) => x
            none => break
        }
        if f.number == 1 {
            return duration_ms(f.as_bytes()?)
        }
    }
    0
}

fn retry_delay(resp: http.Response) -> i64 {
    let encoded = text.trim(grpc_value(resp, "grpc-status-details-bin") ?? "")
    if encoded.len == 0 {
        return -1
    }
    let status = base64.decode(padded(encoded)) catch {
        _ => return -1
    }
    let d = protobuf.decoder(status)
    for {
        let f = d.next() catch {
            _ => return -1
        }
        let field = match f {
            some(x) => x
            none => return -1
        }
        if field.number == 3 {
            let any = field.as_bytes() catch {
                _ => return -1
            }
            let delay = retry_info_delay(any) catch -1
            if delay >= 0 {
                return delay
            }
        }
    }
}

fn grpc_retryable(code: i64) -> bool {
    code == 1 || code == 4 || code == 10 || code == 11 || code == 14 || code == 15
}

fn grpc_step(resp: http.Response) -> retry.Step[bool, i64] {
    if resp.status != 200 {
        return http_step(resp)
    }
    let code = text.parse_uint(text.trim(grpc_value(resp, "grpc-status") ?? ""), 10) catch {
        _ => return Fatal(0)
    }
    if code == 0 {
        return Done(true)
    }
    if grpc_retryable(code) {
        return waiting(code, retry_delay(resp))
    }
    if code == 8 {
        let delay = retry_delay(resp)
        return if delay >= 0 { waiting(code, delay) } else { Fatal(code) }
    }
    Fatal(code)
}

fn exchange_policy(o: OtlpOptions) -> retry.Policy {
    var p = retry.policy()
    p = retry.with_attempts(p, o.attempts)
    p = retry.with_base(p, duration.milliseconds(o.backoff))
    p = retry.with_max_delay(p, duration.milliseconds(o.max_backoff))
    retry.with_jitter(p, retry.Jitter.Equal)
}

fn send(client: *http.Client, o: OtlpOptions, url: str, body: []u8) -> bool {
    var headers: []header.Header = []
    for h in o.headers {
        push(mut headers, h)
    }
    header.set(mut headers, "user-agent", "OTel-OTLP-Exporter-Low")
    let compressed = if o.gzip { deflate.gzip_compress(body, 6) } else { body }
    var content_type = "application/x-protobuf"
    var payload = compressed
    match o.protocol {
        Grpc => {
            content_type = "application/grpc"
            payload = grpc_frame(compressed, o.gzip)
            header.set(mut headers, "te", "trailers")
            header.set(mut headers, "grpc-timeout", "{o.timeout}m")
            if o.gzip {
                header.set(mut headers, "grpc-encoding", "gzip")
            }
        }
        HttpJson => {
            content_type = "application/json"
        }
        HttpProtobuf => {}
    }
    if o.gzip && !grpc(o) {
        header.set(mut headers, "content-encoding", "gzip")
    }
    let delivered = retry.run(exchange_policy(o), fn(attempt: i64) -> retry.Step[bool, i64] {
        let resp = match post(client, url, headers, content_type, payload) {
            some(r) => r
            none => return Retry(0)
        }
        if grpc(o) { grpc_step(resp) } else { http_step(resp) }
    })
    match delivered {
        Value(_) => true
        _ => false
    }
}

fn retire(open: *bool, client: *http.Client) {
    *open = false
    http.close_idle(client)
}

fn json_protocol(o: OtlpOptions) -> bool {
    match o.protocol {
        HttpJson => true
        _ => false
    }
}

/// Returns an exporter that sends spans to the collector.
/// `export` returns `true` once the collector accepts a batch and `false` when it rejects it or every attempt fails; an empty batch returns `true` without a request, and after `shutdown` every call returns `false`. HTTP statuses 429, 502, 503 and 504, and a failed connection, are retried after the backoff or the server's `Retry-After`. Over gRPC, the status codes CANCELLED, DEADLINE_EXCEEDED, ABORTED, OUT_OF_RANGE, UNAVAILABLE and DATA_LOSS are retried and RESOURCE_EXHAUSTED is retried when the response carries a `RetryInfo` delay. The processors and metric readers call `export` with telemetry suppressed. `shutdown` closes idle connections.
pub fn otlp_span_exporter(o: OtlpOptions) -> SpanExporter {
    let url = signal_url(o, o.traces_endpoint, "/v1/traces", "trace.v1.TraceService")
    let open = new(true)
    let client = exporter_client(o)
    SpanExporter {
        export: fn(spans) -> bool {
            if !*open || spans.len == 0 {
                return *open
            }
            send(client, o, url, encode_traces(spans, json_protocol(o)))
        }
        shutdown: fn() { retire(open, client) }
    }
}

/// Returns an exporter that sends metric batches to the collector. Delivery, retries and shutdown follow `otlp_span_exporter`; `export` returns `false` after `shutdown`.
pub fn otlp_metric_exporter(o: OtlpOptions) -> MetricExporter {
    let url = signal_url(o, o.metrics_endpoint, "/v1/metrics", "metrics.v1.MetricsService")
    let open = new(true)
    let client = exporter_client(o)
    MetricExporter {
        export: fn(batch) -> bool {
            if !*open {
                return false
            }
            send(client, o, url, encode_metrics(batch, json_protocol(o)))
        }
        shutdown: fn() { retire(open, client) }
    }
}

/// Returns an exporter that sends log records to the collector. Delivery, retries and shutdown follow `otlp_span_exporter`.
pub fn otlp_log_exporter(o: OtlpOptions) -> LogExporter {
    let url = signal_url(o, o.logs_endpoint, "/v1/logs", "logs.v1.LogsService")
    let open = new(true)
    let client = exporter_client(o)
    LogExporter {
        export: fn(logs) -> bool {
            if !*open || logs.len == 0 {
                return *open
            }
            send(client, o, url, encode_logs(logs, json_protocol(o)))
        }
        shutdown: fn() { retire(open, client) }
    }
}
