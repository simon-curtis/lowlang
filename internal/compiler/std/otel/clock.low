fn clock(id: i64) -> i64 {
    let spec: []i64 = __make(2)
    if __syscall(228, id, __slice_ptr(spec)) != 0 {
        return 0
    }
    spec[0] * 1000000000 + spec[1]
}

pub fn now_nanos() -> i64 {
    clock(0)
}

fn monotonic_nanos() -> i64 {
    clock(1)
}

fn monotonic_millis() -> i64 {
    clock(1) / 1000000
}
