import std/text

pub fn stderr_writer() -> fn(str) {
    fn(line: str) {
        let data = bytes("{line}\n")
        var at = 0
        for at < data.len {
            let n = __syscall(1, 2, __slice_ptr(data[at..]), data.len - at)
            if n <= 0 {
                return
            }
            at += n
        }
    }
}

fn kind_name(k: Kind) -> str {
    match k {
        Internal => "internal"
        Server => "server"
        Client => "client"
        Producer => "producer"
        Consumer => "consumer"
    }
}

fn status_name(s: Status) -> str {
    match s {
        Unset => "unset"
        Ok => "ok"
        Failed(m) => "error({m})"
    }
}

fn with_attributes(head: str, attributes: []Attribute) -> str {
    if attributes.len == 0 {
        return head
    }
    "{head} {format_attributes(attributes)}"
}

pub fn format_span(d: *SpanData) -> []str {
    let parent = if valid(d.parent) { span_id_hex(d.parent) } else { "-" }
    var lines: []str = [with_attributes("span {d.scope.name} \"{d.name}\" {kind_name(d.kind)} trace={trace_id_hex(d.context)} span={span_id_hex(d.context)} parent={parent} start={d.start} duration={d.end - d.start}ns status={status_name(d.status)}", d.attributes)]
    for e in d.events {
        push(mut lines, with_attributes("  event \"{e.name}\" at={e.time}", e.attributes))
    }
    for l in d.links {
        push(mut lines, with_attributes("  link trace={trace_id_hex(l.context)} span={span_id_hex(l.context)}", l.attributes))
    }
    lines
}

fn temporality_name(t: Temporality) -> str {
    match t {
        Cumulative => "cumulative"
        Delta => "delta"
    }
}

pub fn format_metric(m: MetricData) -> []str {
    let kind = match m.kind {
        Sum => if m.monotonic { "sum monotonic" } else { "sum" }
        Gauge => "gauge"
        Histogram => "histogram"
    }
    let temporality = match m.kind {
        Gauge => ""
        _ => " {temporality_name(m.temporality)}"
    }
    var lines: []str = ["metric {m.scope.name} {m.name} {kind}{temporality} unit={m.unit}"]
    for p in m.points {
        let value = match m.kind {
            Histogram => {
                var counts: []str = []
                for b in p.buckets {
                    push(mut counts, "{b}")
                }
                "count={p.count} sum={p.sum} min={p.min} max={p.max} buckets=[{text.join(counts, ",")}]"
            }
            _ => if m.integer { "value={p.int_value}" } else { "value={p.double_value}" }
        }
        push(mut lines, with_attributes("  {value}", p.attributes))
    }
    lines
}

pub fn format_log(d: *LogData) -> str {
    let correlation = if valid(d.context) { " trace={trace_id_hex(d.context)} span={span_id_hex(d.context)}" } else { "" }
    with_attributes("log {d.scope.name} {d.record.severity_text} \"{format_value(d.record.body)}\"{correlation}", d.record.attributes)
}

pub fn console_span_exporter(write: fn(str)) -> SpanExporter {
    SpanExporter {
        export: fn(spans) -> bool {
            for d in spans {
                for line in format_span(d) {
                    write(line)
                }
            }
            true
        }
        shutdown: fn() {}
    }
}

pub fn console_metric_exporter(write: fn(str)) -> MetricExporter {
    MetricExporter {
        export: fn(batch) -> bool {
            for m in batch.metrics {
                for line in format_metric(m) {
                    write(line)
                }
            }
            true
        }
        shutdown: fn() {}
    }
}

pub fn console_log_exporter(write: fn(str)) -> LogExporter {
    LogExporter {
        export: fn(logs) -> bool {
            for d in logs {
                write(format_log(d))
            }
            true
        }
        shutdown: fn() {}
    }
}
