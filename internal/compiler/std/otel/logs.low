import std/time
pub struct LogRecord {
    pub time: i64 = 0
    pub severity: i64 = 0
    pub severity_text: str = ""
    pub body: Value = Empty
    pub attributes: []Attribute = []
    pub event_name: str = ""
}

pub struct LogData {
    pub record: LogRecord
    pub observed: i64
    pub context: SpanContext
    pub scope: Scope
    pub resource: *Resource
    pub dropped: i64
}

pub struct LogExporter {
    pub export: fn([]*LogData) -> bool
    pub shutdown: fn()
}

pub struct LogProcessor {
    pub on_emit: fn(*LogData)
    pub force_flush: fn() -> bool
    pub shutdown: fn() -> bool
    pub dropped: fn() -> i64
}

pub struct Logger {
    pub scope: Scope
}

pub fn logger(name: str) -> Logger {
    Logger { scope: Scope { name } }
}

pub fn severity_name(n: i64) -> str {
    if n <= 0 || n > 24 {
        return ""
    }
    let names = ["TRACE", "DEBUG", "INFO", "WARN", "ERROR", "FATAL"]
    let base = names[(n - 1) / 4]
    let step = (n - 1) % 4
    if step == 0 { base } else { "{base}{step + 1}" }
}

pub fn emit(l: Logger, r: LogRecord) {
    let sdk = match active_sdk() {
        some(s) => s
        none => return
    }
    if sdk.log_processors.len == 0 || sdk.stopped {
        return
    }
    let c: *Context = __context()
    var record = r
    if record.severity_text.len == 0 {
        record.severity_text = severity_name(record.severity)
    }
    let kept = limited(r.attributes, sdk.limits.attributes)
    record.attributes = kept
    let data = new(LogData {
        record
        observed: time.now_nanos()
        context: if valid(c.span.context) { c.span.context } else { invalid_context() }
        scope: l.scope
        resource: sdk.resource
        dropped: r.attributes.len - kept.len
    })
    for p in sdk.log_processors {
        p.on_emit(data)
    }
}

fn emit_at(l: Logger, severity: i64, body: str, attributes: []Attribute) {
    match active_sdk() {
        some(_) => emit(l, LogRecord { time: time.now_nanos(), severity, body: Str(body), attributes })
        none => {}
    }
}

pub fn trace(l: Logger, body: str, attributes: []Attribute) {
    emit_at(l, 1, body, attributes)
}

pub fn debug(l: Logger, body: str, attributes: []Attribute) {
    emit_at(l, 5, body, attributes)
}

pub fn info(l: Logger, body: str, attributes: []Attribute) {
    emit_at(l, 9, body, attributes)
}

pub fn warn(l: Logger, body: str, attributes: []Attribute) {
    emit_at(l, 13, body, attributes)
}

pub fn error(l: Logger, body: str, attributes: []Attribute) {
    emit_at(l, 17, body, attributes)
}

pub fn fatal(l: Logger, body: str, attributes: []Attribute) {
    emit_at(l, 21, body, attributes)
}

pub fn batch_log_processor(exporter: LogExporter, options: BatchOptions) -> LogProcessor {
    let b = batcher(options, exporter.export, exporter.shutdown)
    LogProcessor {
        on_emit: fn(d) { offer(b, d) }
        force_flush: fn() -> bool { request(b, false) }
        shutdown: fn() -> bool { request(b, true) }
        dropped: fn() -> i64 { dropped_count(b) }
    }
}

pub fn simple_log_processor(exporter: LogExporter) -> LogProcessor {
    LogProcessor {
        on_emit: fn(d) { exporter.export([d]) }
        force_flush: fn() -> bool { true }
        shutdown: fn() -> bool {
            exporter.shutdown()
            true
        }
        dropped: fn() -> i64 { 0 }
    }
}
