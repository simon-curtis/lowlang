import std/time
/// A log record built by the caller.
pub struct LogRecord {
    /// The time of the event in nanoseconds since the Unix epoch, or `0` when unknown.
    pub time: i64 = 0
    /// The severity number from `1` to `24`, or `0` when unspecified. See `severity_name`.
    pub severity: i64 = 0
    /// The severity name. When empty, `emit` fills it from `severity`.
    pub severity_text: str = ""
    /// The log message or structured body.
    pub body: Value = Empty
    /// The record attributes.
    pub attributes: []Attribute = []
    /// The name of the event the record describes, or empty.
    pub event_name: str = ""
}

/// A log record as it reaches processors and exporters.
pub struct LogData {
    /// The record, with `severity_text` filled in and attributes trimmed to `Limits.attributes`.
    pub record: LogRecord
    /// The time `emit` ran, in nanoseconds since the Unix epoch.
    pub observed: i64
    /// The span context active when the record was emitted, or an invalid context when there was no active span.
    pub context: SpanContext
    /// The scope of the logger that emitted the record.
    pub scope: Scope
    /// The resource of the SDK that received the record.
    pub resource: *Resource
    /// The number of attributes discarded because they exceeded `Limits.attributes`.
    pub dropped: i64
}

/// Sends log records to a destination.
pub struct LogExporter {
    /// Sends a batch of records and returns whether it was delivered.
    pub export: fn([]*LogData) -> bool
    /// Releases the exporter's resources.
    pub shutdown: fn()
}

/// Receives log records as they are emitted.
pub struct LogProcessor {
    /// Called once for each emitted record.
    pub on_emit: fn(*LogData)
    /// Exports what is pending and returns whether it succeeded.
    pub force_flush: fn() -> bool
    /// Flushes, stops and returns whether it succeeded. It also shuts the exporter down.
    pub shutdown: fn() -> bool
    /// Returns the number of records discarded because the queue was full.
    pub dropped: fn() -> i64
}

/// A source of log records for one instrumentation scope.
pub struct Logger {
    /// The scope recorded on every record the logger emits.
    pub scope: Scope
}

/// Returns a logger whose records carry an instrumentation scope named `name`.
pub fn logger(name: str) -> Logger {
    Logger { scope: Scope { name } }
}

/// Returns the OpenTelemetry name for the severity number `n`.
/// Numbers 1 to 24 map to `TRACE`, `DEBUG`, `INFO`, `WARN`, `ERROR` and `FATAL` in groups of four, with `2` to `4` appended after the first, such as `INFO3`. Any other number returns an empty string.
pub fn severity_name(n: i64) -> str {
    if n <= 0 || n > 24 {
        return ""
    }
    let names = ["TRACE", "DEBUG", "INFO", "WARN", "ERROR", "FATAL"]
    let base = names[(n - 1) / 4]
    let step = (n - 1) % 4
    if step == 0 { base } else { "{base}{step + 1}" }
}

/// Emits the log record `r` to every log processor of the installed SDK.
/// Nothing happens when no SDK is installed, the context is suppressed, there are no log processors or the SDK has been shut down. The record's time is passed through as given. The span context of the calling green thread is attached when it has a valid one.
pub fn emit(l: Logger, r: LogRecord) {
    let sdk = match active_sdk() {
        some(s) => s
        none => return
    }
    if sdk.log_processors.len == 0 || sdk.stopped {
        return
    }
    let c: *Context = __context()
    var record = r
    if record.severity_text.len == 0 {
        record.severity_text = severity_name(record.severity)
    }
    let kept = limited(r.attributes, sdk.limits.attributes)
    record.attributes = kept
    let data = new(LogData {
        record
        observed: time.now_nanos()
        context: if valid(c.span.context) { c.span.context } else { invalid_context() }
        scope: l.scope
        resource: sdk.resource
        dropped: r.attributes.len - kept.len
    })
    for p in sdk.log_processors {
        p.on_emit(data)
    }
}

fn emit_at(l: Logger, severity: i64, body: str, attributes: []Attribute) {
    match active_sdk() {
        some(_) => emit(l, LogRecord { time: time.now_nanos(), severity, body: Str(body), attributes })
        none => {}
    }
}

/// Emits a record with severity `TRACE` (number 1), the string `body` and `attributes`, timestamped now.
pub fn trace(l: Logger, body: str, attributes: []Attribute) {
    emit_at(l, 1, body, attributes)
}

/// Emits a record with severity `DEBUG` (number 5), the string `body` and `attributes`, timestamped now.
pub fn debug(l: Logger, body: str, attributes: []Attribute) {
    emit_at(l, 5, body, attributes)
}

/// Emits a record with severity `INFO` (number 9), the string `body` and `attributes`, timestamped now.
pub fn info(l: Logger, body: str, attributes: []Attribute) {
    emit_at(l, 9, body, attributes)
}

/// Emits a record with severity `WARN` (number 13), the string `body` and `attributes`, timestamped now.
pub fn warn(l: Logger, body: str, attributes: []Attribute) {
    emit_at(l, 13, body, attributes)
}

/// Emits a record with severity `ERROR` (number 17), the string `body` and `attributes`, timestamped now.
pub fn error(l: Logger, body: str, attributes: []Attribute) {
    emit_at(l, 17, body, attributes)
}

/// Emits a record with severity `FATAL` (number 21), the string `body` and `attributes`, timestamped now.
pub fn fatal(l: Logger, body: str, attributes: []Attribute) {
    emit_at(l, 21, body, attributes)
}

/// Returns a processor that queues records and exports them in batches from a background green thread.
/// Queueing, flushing and the `dropped` count follow `batch_span_processor`.
pub fn batch_log_processor(exporter: LogExporter, options: BatchOptions) -> LogProcessor {
    let b = batcher(options, exporter.export, exporter.shutdown)
    LogProcessor {
        on_emit: fn(d) { offer(b, d) }
        force_flush: fn() -> bool { request(b, false) }
        shutdown: fn() -> bool { request(b, true) }
        dropped: fn() -> i64 { dropped_count(b) }
    }
}

/// Returns a processor that exports each record, alone, from the green thread that emitted it.
/// The result of `export` is ignored. `force_flush` returns `true`, `shutdown` shuts the exporter down and returns `true`, and `dropped` returns `0`.
pub fn simple_log_processor(exporter: LogExporter) -> LogProcessor {
    LogProcessor {
        on_emit: fn(d) {
            quietly(fn() -> bool { exporter.export([d]) })
        }
        force_flush: fn() -> bool { true }
        shutdown: fn() -> bool {
            exporter.shutdown()
            true
        }
        dropped: fn() -> i64 { 0 }
    }
}
