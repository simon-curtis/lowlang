import std/http

/// A baggage member: a key and value that travel with a request across services.
pub struct Entry {
    /// The member name, an HTTP token.
    pub key: str
    /// The member value, as decoded text.
    pub value: str
    /// The properties after the first `;` in the header, kept as unparsed text, or empty.
    pub metadata: str
}

/// The telemetry state of a green thread: the active span, the baggage, a flag that suppresses telemetry and the installed SDK.
/// A `Context` is never modified; the `with_` functions return an updated copy. A green thread holds one in its context slot, and `spawn` copies the slot to the new green thread.
pub struct Context {
    ambient: http.Ambient
    /// The active span, which is not recording when none was started.
    pub span: Span
    /// The baggage members in effect.
    pub baggage: []Entry
    /// Whether telemetry is switched off for work done in this context. `suppressed` sets it.
    pub suppressed: bool
    call: *CallState?
    sdk: *SdkHandle?
}

fn assemble_context(span: Span, baggage: []Entry, quiet: bool, call: *CallState?, sdk: *SdkHandle?) -> Context {
    var observer: *http.Observer? = none
    if !quiet && sdk != none {
        observer = some(http_observer())
    }
    Context { ambient: http.Ambient { observer }, span, baggage, suppressed: quiet, call, sdk }
}

fn root_context(sdk: *SdkHandle?) -> *Context {
    new(assemble_context(invalid_span(), [], false, none, sdk))
}

fn active_sdk() -> *SdkHandle? {
    if !__has_context() {
        return none
    }
    let c: *Context = __context()
    if c.suppressed {
        return none
    }
    c.sdk
}

/// Reports whether telemetry is on for the calling green thread, which is when an SDK is installed and the context is not suppressed.
pub fn enabled() -> bool {
    match active_sdk() {
        some(_) => true
        none => false
    }
}

/// Returns the calling green thread's context, or an empty root context with no SDK when none is set.
pub fn current() -> *Context {
    if __has_context() {
        return __context()
    }
    root_context(none)
}

/// Makes `c` the calling green thread's context and returns the context it replaces.
/// Pass the result to `detach` to restore it.
pub fn attach(c: *Context) -> *Context {
    let outer = current()
    __set_context(c)
    outer
}

/// Restores `outer`, a context returned by `attach`, as the calling green thread's context.
pub fn detach(outer: *Context) {
    __set_context(outer)
}

/// Returns a copy of `c` whose active span is `s`.
pub fn with_span(c: *Context, s: Span) -> *Context {
    var next = *c
    next.span = s
    next.call = none
    new(next)
}

/// Returns a copy of `c` carrying `entries` as its baggage in place of the existing members.
pub fn with_baggage(c: *Context, entries: []Entry) -> *Context {
    var next = *c
    next.baggage = entries
    new(next)
}

/// Returns a copy of `c` in which telemetry is suppressed: no spans, metrics or log records are produced and the HTTP hooks stay idle.
pub fn suppressed(c: *Context) -> *Context {
    new(assemble_context(c.span, c.baggage, true, c.call, c.sdk))
}

/// Runs `body` with telemetry suppressed for the calling green thread and returns its result. The previous context is restored when `body` returns.
/// Every exporter runs under it, so the exporter itself is not traced.
pub fn quietly[T](body: fn() -> T) -> T {
    in_context(suppressed(current()), body)
}

/// Returns the calling green thread's active span, or a non-recording span with an invalid context when none is set.
pub fn current_span() -> Span {
    if !__has_context() {
        return invalid_span()
    }
    let c: *Context = __context()
    c.span
}

/// Runs `body` with `c` as the calling green thread's context and returns its result. The previous context is restored when `body` returns.
pub fn in_context[T](c: *Context, body: fn() -> T) -> T {
    let outer = attach(c)
    defer detach(outer)
    body()
}

/// Returns the value of the baggage member `key` in `c`, or `none` when there is none.
pub fn baggage_value(c: *Context, key: str) -> str? {
    for e in c.baggage {
        if e.key == key {
            return e.value
        }
    }
    none
}

/// Returns a copy of `c` whose baggage has `key` set to `value` and an empty metadata.
/// An existing member with the same key is replaced, and the new member is placed last.
pub fn set_baggage(c: *Context, key: str, value: str) -> *Context {
    var entries: []Entry = []
    for e in c.baggage {
        if e.key != key {
            push(mut entries, e)
        }
    }
    push(mut entries, Entry { key, value, metadata: "" })
    with_baggage(c, entries)
}
