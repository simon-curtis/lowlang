import std/http

pub struct Entry {
    pub key: str
    pub value: str
    pub metadata: str
}

pub struct Context {
    ambient: http.Ambient
    pub span: Span
    pub baggage: []Entry
    pub suppressed: bool
    call: *CallState?
    sdk: *SdkHandle?
}

fn root_context(sdk: *SdkHandle?) -> *Context {
    new(Context { ambient: http.Ambient { observer: none }, span: invalid_span(), baggage: [], suppressed: false, call: none, sdk })
}

fn active_sdk() -> *SdkHandle? {
    if !__has_context() {
        return none
    }
    let c: *Context = __context()
    if c.suppressed {
        return none
    }
    c.sdk
}

pub fn enabled() -> bool {
    match active_sdk() {
        some(_) => true
        none => false
    }
}

pub fn current() -> *Context {
    if __has_context() {
        return __context()
    }
    root_context(none)
}

pub fn attach(c: *Context) -> *Context {
    let outer = current()
    __set_context(c)
    outer
}

pub fn detach(outer: *Context) {
    __set_context(outer)
}

pub fn with_span(c: *Context, s: Span) -> *Context {
    var next = *c
    next.span = s
    next.call = none
    new(next)
}

pub fn with_baggage(c: *Context, entries: []Entry) -> *Context {
    var next = *c
    next.baggage = entries
    new(next)
}

pub fn suppressed(c: *Context) -> *Context {
    var next = *c
    next.suppressed = true
    next.ambient = http.Ambient { observer: none }
    new(next)
}

pub fn current_span() -> Span {
    if !__has_context() {
        return invalid_span()
    }
    let c: *Context = __context()
    c.span
}

pub fn in_context[T](c: *Context, body: fn() -> T) -> T {
    let outer = attach(c)
    defer detach(outer)
    body()
}

pub fn baggage_value(c: *Context, key: str) -> str? {
    for e in c.baggage {
        if e.key == key {
            return e.value
        }
    }
    none
}

pub fn set_baggage(c: *Context, key: str, value: str) -> *Context {
    var entries: []Entry = []
    for e in c.baggage {
        if e.key != key {
            push(mut entries, e)
        }
    }
    push(mut entries, Entry { key, value, metadata: "" })
    with_baggage(c, entries)
}
