import std/http
import std/os

/// The most data a span or log record can hold. Data beyond a limit is discarded and counted in the matching `dropped` field.
pub struct Limits {
    /// The most attributes on a span or log record. Defaults to `128`.
    pub attributes: i64 = 128
    /// The most events on a span. Defaults to `128`.
    pub events: i64 = 128
    /// The most links on a span. Defaults to `128`.
    pub links: i64 = 128
    /// The most attributes on a span event. Defaults to `128`.
    pub attributes_per_event: i64 = 128
    /// The most attributes on a span link. Defaults to `128`.
    pub attributes_per_link: i64 = 128
}

/// Which context propagation formats `inject` and `extract` use.
pub struct Propagators {
    /// Whether the W3C `traceparent` and `tracestate` headers are used. Defaults to `true`.
    pub trace_context: bool = true
    /// Whether the W3C `baggage` header is used. Defaults to `true`.
    pub baggage: bool = true
}

/// The settings `install` builds an SDK from.
/// With no span processors no spans are recorded, with no metric readers no metric instruments record and with no log processors no log records are emitted.
pub struct Config {
    /// The resource attached to all telemetry. `none`, the default, uses `default_resource` over the process environment.
    pub resource: *Resource? = none
    /// The span sampler. Defaults to a parent-based sampler that records root spans.
    pub sampler: Sampler = parent_based(AlwaysOn)
    /// The data limits. Defaults to `Limits {}`.
    pub limits: Limits = Limits {}
    /// The propagation formats. Defaults to `Propagators {}`.
    pub propagators: Propagators = Propagators {}
    /// The processors that receive started and ended spans. Defaults to none.
    pub span_processors: []SpanProcessor = []
    /// The readers that collect metrics and pass them to an exporter. Defaults to none.
    pub metric_readers: []MetricReader = []
    /// The processors that receive log records. Defaults to none.
    pub log_processors: []LogProcessor = []
}

/// The state of an installed SDK, shared by the green threads that inherit it.
/// Obtained from `install_handle`, `provider` or `Sdk.handle`. The `_on` functions take a handle.
pub struct SdkHandle {
    /// The resource attached to all telemetry.
    pub resource: *Resource
    /// The span sampler.
    pub sampler: Sampler
    /// The data limits.
    pub limits: Limits
    /// The propagation formats.
    pub propagators: Propagators
    /// The span processors.
    pub span_processors: []SpanProcessor
    /// The log processors.
    pub log_processors: []LogProcessor
    readers: []*ReaderState
    random: *Random
    meters: *Meters
    stopped: bool
}

/// An owner of an `SdkHandle` that shuts the SDK down when it is dropped.
pub struct Sdk {
    /// The SDK state.
    pub handle: *SdkHandle
    drop shutdown_on(handle)
}

fn assemble(config: Config) -> *SdkHandle {
    let resource = match config.resource {
        some(r) => r
        none => default_resource(os.environment())
    }
    let sdk = new(SdkHandle {
        resource
        sampler: config.sampler
        limits: config.limits
        propagators: config.propagators
        span_processors: config.span_processors
        log_processors: config.log_processors
        readers: []
        random: seeded()
        meters: new(Meters { lock: 0, instruments: [], by_key: [:] })
        stopped: false
    })
    var readers: []*ReaderState = []
    for i, r in config.metric_readers {
        push(mut readers, reader_state(sdk, r, i))
    }
    sdk.readers = readers
    sdk
}

/// Returns an `Sdk` that owns `h`, so that dropping it shuts `h` down.
/// Nothing is installed.
pub fn adopt(h: *SdkHandle) -> Sdk {
    Sdk { handle: h }
}

/// Builds an SDK from `config`, installs it for the calling green thread and returns the `Sdk` that owns it.
/// Green threads spawned afterwards inherit it. Periodic metric readers start collecting in the background. Dropping the result shuts the SDK down, so a program keeps it for its lifetime, usually in `main`.
pub fn install(config: Config) -> Sdk {
    let h = install_handle(config)
    adopt(h)
}

/// Builds an SDK from `config` and installs it for the calling green thread, like `install`, but returns the bare handle.
/// The caller shuts it down with `shutdown_on`.
pub fn install_handle(config: Config) -> *SdkHandle {
    let sdk = assemble(config)
    let outer = current()
    __set_context(new(assemble_context(outer.span, outer.baggage, outer.suppressed, outer.call, some(sdk))))
    for r in sdk.readers {
        start_reader(r)
    }
    sdk
}

/// Returns the SDK installed for the calling green thread, or `none` when there is none.
pub fn provider() -> *SdkHandle? {
    if !__has_context() {
        return none
    }
    let c: *Context = __context()
    c.sdk
}

/// Exports everything pending. See `force_flush_on`.
pub fn force_flush(sdk: Sdk) -> bool {
    force_flush_on(sdk.handle)
}

/// Exports every span and log record waiting in a processor and collects and exports every metric reader, then returns whether all of them succeeded.
/// Each step waits up to the processor's or reader's timeout.
pub fn force_flush_on(sdk: *SdkHandle) -> bool {
    var ok = true
    for p in sdk.span_processors {
        ok = p.force_flush() && ok
    }
    for r in sdk.readers {
        ok = flush_reader(r) && ok
    }
    for p in sdk.log_processors {
        ok = p.force_flush() && ok
    }
    ok
}

/// Flushes and stops the SDK. See `shutdown_on`.
pub fn shutdown(sdk: Sdk) -> bool {
    shutdown_on(sdk.handle)
}

/// Flushes and stops the SDK and returns whether every processor and reader succeeded.
/// After the call no new spans or log records are recorded, and each exporter is shut down. Returns `false` when the SDK was already shut down.
pub fn shutdown_on(sdk: *SdkHandle) -> bool {
    if sdk.stopped {
        return false
    }
    sdk.stopped = true
    var ok = true
    for p in sdk.span_processors {
        ok = p.shutdown() && ok
    }
    for r in sdk.readers {
        ok = stop_reader(r) && ok
    }
    for p in sdk.log_processors {
        ok = p.shutdown() && ok
    }
    ok
}

/// Collects the metrics of the reader at index `reader` in `Config.metric_readers` without exporting them. See `collect_on`.
pub fn collect(sdk: Sdk, reader: i64) -> MetricBatch {
    collect_on(sdk.handle, reader)
}

/// Returns the number of spans the span processors discarded because their queue was full.
pub fn dropped_spans(sdk: Sdk) -> i64 {
    dropped_spans_on(sdk.handle)
}

/// Returns the number of spans the span processors of `sdk` discarded because their queue was full.
pub fn dropped_spans_on(sdk: *SdkHandle) -> i64 {
    var n = 0
    for p in sdk.span_processors {
        n += p.dropped()
    }
    n
}

/// Returns the number of log records the log processors discarded because their queue was full.
pub fn dropped_logs(sdk: Sdk) -> i64 {
    dropped_logs_on(sdk.handle)
}

/// Returns the number of log records the log processors of `sdk` discarded because their queue was full.
pub fn dropped_logs_on(sdk: *SdkHandle) -> i64 {
    var n = 0
    for p in sdk.log_processors {
        n += p.dropped()
    }
    n
}
