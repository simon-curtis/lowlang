import std/time
/// Settings for a batch processor.
pub struct BatchOptions {
    /// The capacity of the queue. A record offered while the queue is full is discarded and counted. Defaults to `2048`.
    pub max_queue: i64 = 2048
    /// The most items passed to one `export` call, and the queue length that triggers an export. Defaults to `512`.
    pub max_batch: i64 = 512
    /// The time in milliseconds between exports of a partial batch. Defaults to `5000`.
    pub delay: i64 = 5000
    /// The time in milliseconds a flush or shutdown waits for the processor. Defaults to `30000`.
    pub timeout: i64 = 30000
}

/// Sends finished spans to a destination.
pub struct SpanExporter {
    /// Sends a batch of ended spans and returns whether it was delivered.
    pub export: fn([]*SpanData) -> bool
    /// Releases the exporter's resources.
    pub shutdown: fn()
}

/// Receives spans as they start and end.
pub struct SpanProcessor {
    /// Called when a recording span starts, before `start` returns.
    pub on_start: fn(*SpanData)
    /// Called once when a recording span ends.
    pub on_end: fn(*SpanData)
    /// Exports what is pending and returns whether it succeeded.
    pub force_flush: fn() -> bool
    /// Flushes, stops and returns whether it succeeded. It also shuts the exporter down.
    pub shutdown: fn() -> bool
    /// Returns the number of spans discarded because the queue was full.
    pub dropped: fn() -> i64
}

struct Command {
    reply: chan[bool]
    stop: bool
}

struct Batcher[T] {
    queue: chan[T]
    control: chan[Command]
    options: BatchOptions
    export: fn([]T) -> bool
    finish: fn()
    lock: i64
    dropped: i64
    stopped: bool
}

fn batcher[T](options: BatchOptions, export: fn([]T) -> bool, finish: fn()) -> *Batcher[T] {
    let b = new(Batcher[T] {
        queue: chan[T](options.max_queue)
        control: chan[Command](1)
        options
        export
        finish
        lock: 0
        dropped: 0
        stopped: false
    })
    spawn work(b)
    b
}

fn offer[T](b: *Batcher[T], v: T) {
    if b.stopped {
        return
    }
    let sent = select {
        b.queue <- v => true
        else => false
    }
    if !sent {
        __lock(mut b.lock)
        b.dropped += 1
        __unlock(mut b.lock)
    }
}

fn dropped_count[T](b: *Batcher[T]) -> i64 {
    __lock(mut b.lock)
    let n = b.dropped
    __unlock(mut b.lock)
    n
}

fn ship[T](b: *Batcher[T], batch: []T) -> bool {
    var ok = true
    var at = 0
    for at < batch.len {
        let end = if at + b.options.max_batch < batch.len { at + b.options.max_batch } else { batch.len }
        ok = b.export(batch[at..end]) && ok
        at = end
    }
    ok
}

fn drain[T](b: *Batcher[T], mut batch: []T) {
    for {
        let more = select {
            v = <-b.queue => {
                match v {
                    some(x) => {
                        push(mut batch, x)
                        true
                    }
                    none => false
                }
            }
            else => false
        }
        if !more {
            return
        }
    }
}

fn work[T](b: *Batcher[T]) {
    var batch: []T = []
    var deadline = time.monotonic() / 1000000 + b.options.delay
    for {
        var wait = deadline - time.monotonic() / 1000000
        if wait < 0 {
            wait = 0
        }
        let command: Command? = select {
            v = <-b.queue => {
                match v {
                    some(x) => push(mut batch, x)
                    none => {}
                }
                if batch.len >= b.options.max_batch {
                    ship(b, batch)
                    batch = []
                    deadline = time.monotonic() / 1000000 + b.options.delay
                }
                none
            }
            c = <-b.control => c
            after(wait) => {
                if batch.len > 0 {
                    ship(b, batch)
                    batch = []
                }
                deadline = time.monotonic() / 1000000 + b.options.delay
                none
            }
        }
        match command {
            some(c) => {
                drain(b, mut batch)
                let ok = ship(b, batch)
                batch = []
                deadline = time.monotonic() / 1000000 + b.options.delay
                if c.stop {
                    b.finish()
                    c.reply <- ok
                    return
                }
                c.reply <- ok
            }
            none => {}
        }
    }
}

fn request[T](b: *Batcher[T], stop: bool) -> bool {
    if b.stopped {
        return false
    }
    if stop {
        b.stopped = true
    }
    let reply = chan[bool](1)
    let sent = select {
        b.control <- Command { reply, stop } => true
        after(b.options.timeout) => false
    }
    if !sent {
        return false
    }
    select {
        r = <-reply => r ?? false
        after(b.options.timeout) => false
    }
}

/// Returns a processor that queues sampled spans and exports them in batches from a background green thread.
/// `on_end` never blocks: a span offered while the queue holds `options.max_queue` spans is discarded and counted by `dropped`. The worker exports when `options.max_batch` spans have queued and when `options.delay` milliseconds pass with spans waiting. `force_flush` and `shutdown` wait up to `options.timeout` milliseconds for the worker and return `false` on a timeout; `shutdown` also shuts down the exporter, and spans ended afterwards are ignored. Spans that are not sampled are never queued.
pub fn batch_span_processor(exporter: SpanExporter, options: BatchOptions) -> SpanProcessor {
    let b = batcher(options, exporter.export, exporter.shutdown)
    SpanProcessor {
        on_start: fn(d) {}
        on_end: fn(d) {
            if sampled(d.context) {
                offer(b, d)
            }
        }
        force_flush: fn() -> bool { request(b, false) }
        shutdown: fn() -> bool { request(b, true) }
        dropped: fn() -> i64 { dropped_count(b) }
    }
}

/// Returns a processor that exports each sampled span, alone, from the green thread that ended it.
/// The result of `export` is ignored. `force_flush` returns `true`, `shutdown` shuts the exporter down and returns `true`, and `dropped` returns `0`.
pub fn simple_span_processor(exporter: SpanExporter) -> SpanProcessor {
    SpanProcessor {
        on_start: fn(d) {}
        on_end: fn(d) {
            if sampled(d.context) {
                exporter.export([d])
            }
        }
        force_flush: fn() -> bool { true }
        shutdown: fn() -> bool {
            exporter.shutdown()
            true
        }
        dropped: fn() -> i64 { 0 }
    }
}
