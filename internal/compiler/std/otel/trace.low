import std/http
import std/io
import std/rand
import std/time

/// Identifies a span for propagation: the W3C trace context of a trace id, a span id and flags.
pub struct SpanContext {
    /// The high 64 bits of the 128-bit trace id.
    pub trace_hi: u64
    /// The low 64 bits of the 128-bit trace id.
    pub trace_lo: u64
    /// The 64-bit span id.
    pub span_id: u64
    /// The W3C trace flags. Bit 0 is set when the trace is sampled.
    pub flags: u8
    /// The `tracestate` header value that travels with the context, or empty.
    pub state: str
    /// Whether the context was extracted from a request made by another process.
    pub remote: bool
}

/// The role a span plays in a trace.
pub enum Kind {
    /// Work inside the application that does not cross a process boundary.
    Internal
    /// Handling of a request from a remote caller.
    Server
    /// A request made to a remote service.
    Client
    /// The start of an asynchronous operation, such as putting a message on a queue.
    Producer
    /// Handling of an asynchronous operation started by a producer.
    Consumer
}

/// The outcome of the operation a span records.
pub enum Status {
    /// No outcome was recorded.
    Unset
    /// The operation succeeded. Once set, a later `Failed` does not replace it.
    Ok
    /// The operation failed, with a description in `message`.
    Failed(message: str)
}

/// A timestamped annotation on a span.
pub struct Event {
    /// The event name.
    pub name: str
    /// The time in nanoseconds since the Unix epoch.
    pub time: i64
    /// The event attributes.
    pub attributes: []Attribute
    /// The number of attributes discarded because they exceeded `Limits.attributes_per_event`.
    pub dropped: i64
}

/// A reference from a span to another span, usually in a different trace.
pub struct Link {
    /// The linked span.
    pub context: SpanContext
    /// The link attributes.
    pub attributes: []Attribute = []
    /// The number of attributes discarded because they exceeded `Limits.attributes_per_link`.
    pub dropped: i64 = 0
}

/// The instrumentation scope: the library or component that produces telemetry.
pub struct Scope {
    /// The scope name, such as the module path.
    pub name: str
    /// The scope version, or empty.
    pub version: str = ""
    /// The schema URL, or empty.
    pub schema_url: str = ""
}

/// A recording span as it reaches processors and exporters. Its fields are final once `end` has been called.
pub struct SpanData {
    /// The span name, which `update_name` can change while the span is recording.
    pub name: str
    /// The span's role.
    pub kind: Kind
    /// The span's own context.
    pub context: SpanContext
    /// The parent's context, or an invalid context for a root span.
    pub parent: SpanContext
    /// The instrumentation scope that started the span.
    pub scope: Scope
    /// The resource of the SDK that recorded the span.
    pub resource: *Resource
    /// The start time in nanoseconds since the Unix epoch.
    pub start: i64
    /// The end time in nanoseconds since the Unix epoch, or `0` while the span is recording.
    pub end: i64
    /// The span attributes, at most `Limits.attributes`.
    pub attributes: []Attribute
    /// The span events, at most `Limits.events`.
    pub events: []Event
    /// The span links, at most `Limits.links`.
    pub links: []Link
    /// The span outcome.
    pub status: Status
    /// The number of attributes discarded because they exceeded `Limits.attributes`.
    pub dropped_attributes: i64
    /// The number of events discarded because they exceeded `Limits.events`.
    pub dropped_events: i64
    /// The number of links discarded because they exceeded `Limits.links`.
    pub dropped_links: i64
    lock: i64
    ended: bool
    sdk: *SdkHandle
}

/// A handle to a span. Copies of a `Span` refer to the same underlying span.
/// A span that is not recording, such as one started without an SDK or one the sampler rejected, ignores every update and has no data.
pub struct Span {
    /// The span's context, also set on a span that is not recording.
    pub context: SpanContext
    data: *SpanData?
}

/// A source of spans for one instrumentation scope.
pub struct Tracer {
    /// The scope recorded on every span the tracer starts.
    pub scope: Scope
}

/// Optional settings for `start_with`.
pub struct StartOptions {
    /// The span's role. Defaults to `Internal`.
    pub kind: Kind = Internal
    /// The context to parent the span under. `none`, the default, uses the calling green thread's context.
    pub parent: *Context? = none
    /// Attributes the span starts with.
    pub attributes: []Attribute = []
    /// Links the span starts with.
    pub links: []Link = []
    /// The start time in nanoseconds since the Unix epoch. `0`, the default, uses the current time.
    pub start: i64 = 0
}

struct Random {
    lock: i64
    rng: rand.Rng
}

fn seeded() -> *Random {
    new(Random { lock: 0, rng: rand.rng() })
}

fn next_random(r: *Random) -> u64 {
    __lock(mut r.lock)
    let v = rand.next(mut r.rng)
    __unlock(mut r.lock)
    v
}

fn nonzero_random(r: *Random) -> u64 {
    for {
        let v = next_random(r)
        if v != 0 {
            return v
        }
    }
}

/// Returns the context that identifies no span: zero ids, no flags and no state.
pub fn invalid_context() -> SpanContext {
    SpanContext { trace_hi: 0, trace_lo: 0, span_id: 0, flags: 0, state: "", remote: false }
}

fn invalid_span() -> Span {
    Span { context: invalid_context(), data: none }
}

/// Returns a span that is not recording and carries `sc`.
/// Use it to make a context extracted from elsewhere the parent of new spans.
pub fn wrap_context(sc: SpanContext) -> Span {
    Span { context: sc, data: none }
}

/// Reports whether `sc` has a non-zero trace id and a non-zero span id.
pub fn valid(sc: SpanContext) -> bool {
    sc.trace_hi | sc.trace_lo != 0 && sc.span_id != 0
}

/// Reports whether the sampled flag is set in `sc`.
pub fn sampled(sc: SpanContext) -> bool {
    sc.flags & 1 != 0
}

fn hex64(v: u64) -> str {
    let digits = "0123456789abcdef"
    let out: []u8 = __make(16)
    for i in 0..16 {
        out[i] = digits[i64(v >> u64(60 - i * 4) & 0xF)]
    }
    __str_view(out)
}

/// Returns the trace id as 32 lowercase hexadecimal digits.
pub fn trace_id_hex(sc: SpanContext) -> str {
    "{hex64(sc.trace_hi)}{hex64(sc.trace_lo)}"
}

/// Returns the span id as 16 lowercase hexadecimal digits.
pub fn span_id_hex(sc: SpanContext) -> str {
    hex64(sc.span_id)
}

/// Returns the trace id as 16 bytes, most significant first.
pub fn trace_id_bytes(sc: SpanContext) -> []u8 {
    let out: []u8 = __make(16)
    io.set_be64(out, 0, i64(sc.trace_hi))
    io.set_be64(out, 8, i64(sc.trace_lo))
    out
}

/// Returns the span id as 8 bytes, most significant first.
pub fn span_id_bytes(sc: SpanContext) -> []u8 {
    let out: []u8 = __make(8)
    io.set_be64(out, 0, i64(sc.span_id))
    out
}

/// Returns a tracer whose spans carry an instrumentation scope named `name`.
pub fn tracer(name: str) -> Tracer {
    Tracer { scope: Scope { name } }
}

/// Starts a span named `name` with the default `StartOptions`.
pub fn start(t: Tracer, name: str) -> Span {
    start_with(t, name, StartOptions {})
}

fn parent_of(o: StartOptions) -> Context {
    match o.parent {
        some(p) => *p
        none => {
            if __has_context() {
                let c: *Context = __context()
                return *c
            }
            Context { ambient: http.Ambient { observer: none }, span: invalid_span(), baggage: [], suppressed: false, call: none, sdk: none }
        }
    }
}

/// Starts a span named `name` under the parent chosen by `o` and returns it.
/// The span is not made the calling green thread's current span; `in_span` does that. The span is not recording and carries its parent's context when there is no SDK, the parent context is suppressed, the SDK has no span processors or it has been shut down. Otherwise the span gets a new span id and inherits the parent's trace id and tracestate, or starts a new trace when the parent is not valid. The sampler then decides: a rejected span has the sampled flag clear and is not recorded, but its context can still be propagated. A recorded span has the sampled flag set, attributes and links trimmed to the SDK limits, and every span processor's `on_start` called with it. The caller ends the span with `end`.
pub fn start_with(t: Tracer, name: str, o: StartOptions) -> Span {
    let parent = parent_of(o)
    let parent_span = parent.span.context
    let sdk = match parent.sdk {
        some(s) => s
        none => return Span { context: parent_span, data: none }
    }
    if parent.suppressed || sdk.span_processors.len == 0 || sdk.stopped {
        return Span { context: parent_span, data: none }
    }
    var context = SpanContext {
        trace_hi: parent_span.trace_hi
        trace_lo: parent_span.trace_lo
        span_id: nonzero_random(sdk.random)
        flags: 0
        state: parent_span.state
        remote: false
    }
    if !valid(parent_span) {
        context.trace_hi = next_random(sdk.random)
        context.trace_lo = nonzero_random(sdk.random)
        context.state = ""
    }
    if !should_sample(sdk.sampler, parent_span, context.trace_lo) {
        return Span { context, data: none }
    }
    context.flags = 1
    let limits = sdk.limits
    let attributes = limited(o.attributes, limits.attributes)
    var links: []Link = []
    for l in o.links {
        if links.len < limits.links {
            push(mut links, Link { context: l.context, attributes: limited(l.attributes, limits.attributes_per_link), dropped: 0 })
        }
    }
    let data = new(SpanData {
        name
        kind: o.kind
        context
        parent: if valid(parent_span) { parent_span } else { invalid_context() }
        scope: t.scope
        resource: sdk.resource
        start: if o.start > 0 { o.start } else { time.now_nanos() }
        end: 0
        attributes
        events: []
        links
        status: Unset
        dropped_attributes: o.attributes.len - attributes.len
        dropped_events: 0
        dropped_links: o.links.len - links.len
        lock: 0
        ended: false
        sdk
    })
    for p in sdk.span_processors {
        p.on_start(data)
    }
    Span { context, data }
}

/// Reports whether the span is recording, which is true from the time it starts until `end` is called, and always false for a span that is not recording.
pub fn is_recording(s: Span) -> bool {
    match s.data {
        some(d) => !d.ended
        none => false
    }
}

/// Sets the attribute `a`, replacing an attribute with the same key.
/// A new key beyond `Limits.attributes` is discarded and counted in `SpanData.dropped_attributes`. Nothing happens on a span that is not recording or has ended.
pub fn set_attribute(s: Span, a: Attribute) {
    let d = match s.data {
        some(x) => x
        none => return
    }
    __lock(mut d.lock)
    if !d.ended && !upsert(mut d.attributes, a, d.sdk.limits.attributes) {
        d.dropped_attributes += 1
    }
    __unlock(mut d.lock)
}

/// Sets each attribute in `attributes` with `set_attribute`.
pub fn set_attributes(s: Span, attributes: []Attribute) {
    for a in attributes {
        set_attribute(s, a)
    }
}

/// Sets the string attribute `key` to `value`.
pub fn set_string(s: Span, key: str, value: str) {
    match s.data {
        some(_) => set_attribute(s, string(key, value))
        none => {}
    }
}

/// Sets the integer attribute `key` to `value`.
pub fn set_int(s: Span, key: str, value: i64) {
    match s.data {
        some(_) => set_attribute(s, int(key, value))
        none => {}
    }
}

/// Adds an event named `name` with `attributes`, timestamped with the current time.
pub fn add_event(s: Span, name: str, attributes: []Attribute) {
    add_event_at(s, name, attributes, 0)
}

/// Adds an event named `name` with `attributes` at the time `at`, in nanoseconds since the Unix epoch; `0` or less uses the current time.
/// Attributes beyond `Limits.attributes_per_event` are discarded and counted in the event. An event beyond `Limits.events` is discarded and counted in `SpanData.dropped_events`. Nothing happens on a span that is not recording or has ended.
pub fn add_event_at(s: Span, name: str, attributes: []Attribute, at: i64) {
    let d = match s.data {
        some(x) => x
        none => return
    }
    let limit = d.sdk.limits.attributes_per_event
    let kept = limited(attributes, limit)
    let e = Event { name, time: if at > 0 { at } else { time.now_nanos() }, attributes: kept, dropped: attributes.len - kept.len }
    __lock(mut d.lock)
    if !d.ended {
        if d.events.len < d.sdk.limits.events {
            push(mut d.events, e)
        } else {
            d.dropped_events += 1
        }
    }
    __unlock(mut d.lock)
}

/// Adds the link `l` to the span.
/// Attributes beyond `Limits.attributes_per_link` are discarded. A link beyond `Limits.links` is discarded and counted in `SpanData.dropped_links`. Nothing happens on a span that is not recording or has ended.
pub fn add_link(s: Span, l: Link) {
    let d = match s.data {
        some(x) => x
        none => return
    }
    let kept = Link { context: l.context, attributes: limited(l.attributes, d.sdk.limits.attributes_per_link), dropped: 0 }
    __lock(mut d.lock)
    if !d.ended {
        if d.links.len < d.sdk.limits.links {
            push(mut d.links, kept)
        } else {
            d.dropped_links += 1
        }
    }
    __unlock(mut d.lock)
}

/// Sets the span's status.
/// `Unset` changes nothing. `Ok` always takes effect and is final. `Failed` takes effect unless the status is already `Ok`, and a later `Failed` replaces an earlier one. Nothing happens on a span that is not recording or has ended.
pub fn set_status(s: Span, status: Status) {
    let d = match s.data {
        some(x) => x
        none => return
    }
    __lock(mut d.lock)
    if !d.ended {
        match status {
            Unset => {}
            Ok => {
                d.status = Ok
            }
            Failed(m) => {
                match d.status {
                    Ok => {}
                    _ => {
                        d.status = Failed(m)
                    }
                }
            }
        }
    }
    __unlock(mut d.lock)
}

/// Renames the span while it is recording. Nothing happens on a span that is not recording or has ended.
pub fn update_name(s: Span, name: str) {
    let d = match s.data {
        some(x) => x
        none => return
    }
    __lock(mut d.lock)
    if !d.ended {
        d.name = name
    }
    __unlock(mut d.lock)
}

/// Records an exception as an event named `exception` with the attributes `exception.type` set to `kind` and `exception.message` set to `message`.
/// The span's status is not changed.
pub fn record_exception(s: Span, kind: str, message: str) {
    match s.data {
        some(_) => add_event(s, "exception", [string("exception.type", kind), string("exception.message", message)])
        none => {}
    }
}

/// Ends the span at the current time. See `end_at`.
pub fn end(s: Span) {
    end_at(s, 0)
}

/// Ends the span at `at`, in nanoseconds since the Unix epoch; `0` or less uses the current time.
/// The span stops recording and each span processor's `on_end` is called with its data. Ending a span that is not recording or has already ended does nothing.
pub fn end_at(s: Span, at: i64) {
    let d = match s.data {
        some(x) => x
        none => return
    }
    __lock(mut d.lock)
    if d.ended {
        __unlock(mut d.lock)
        return
    }
    d.end = if at > 0 { at } else { time.now_nanos() }
    d.ended = true
    __unlock(mut d.lock)
    for p in d.sdk.span_processors {
        p.on_end(d)
    }
}


fn enter(s: Span) -> *Context? {
    match s.data {
        some(_) => attach(with_span(current(), s))
        none => none
    }
}

fn leave(s: Span, outer: *Context?) {
    match outer {
        some(p) => {
            detach(p)
            end(s)
        }
        none => {}
    }
}

/// Runs `body` inside a span named `name` from the tracer for the scope `std/otel`. See `in_span`.
pub fn span[T](name: str, body: fn(Span) -> T) -> T {
    in_span(tracer("std/otel"), name, body)
}

/// Runs `body` inside a new span named `name` and returns its result.
/// The span is the calling green thread's current span while `body` runs, so spans started in `body` become its children. It ends, and the previous context is restored, when `body` returns. When the span is not recording the context is left unchanged and `body` still runs.
pub fn in_span[T](t: Tracer, name: str, body: fn(Span) -> T) -> T {
    let s = start(t, name)
    let outer = enter(s)
    defer leave(s, outer)
    body(s)
}
