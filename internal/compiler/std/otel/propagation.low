import std/header
import std/http
import std/text
import std/uri

fn parse_hex(s: str) -> u64? {
    var v: u64 = 0
    for i in 0..s.len {
        let d = text.hex_digit(s[i])
        if d < 0 || s[i] >= 'A' && s[i] <= 'F' {
            return none
        }
        v = v << 4 | u64(d)
    }
    v
}

/// Parses a W3C `traceparent` header value.
/// Surrounding whitespace is trimmed. Returns `none` when the value is malformed: wrong length or separators, uppercase or non-hexadecimal digits, version `ff`, a version `00` value with extra bytes, or an all-zero trace id or span id. The result is marked `remote`, keeps only the sampled bit of the flags and has an empty state.
pub fn parse_traceparent(value: str) -> SpanContext? {
    let s = text.trim(value)
    if s.len < 55 || s[2] != '-' || s[35] != '-' || s[52] != '-' {
        return none
    }
    let version = match parse_hex(s[..2]) {
        some(x) => x
        none => return none
    }
    if version == 0xff || version == 0 && s.len != 55 || version > 0 && s.len > 55 && s[55] != '-' {
        return none
    }
    let hi = match parse_hex(s[3..19]) {
        some(x) => x
        none => return none
    }
    let lo = match parse_hex(s[19..35]) {
        some(x) => x
        none => return none
    }
    let span = match parse_hex(s[36..52]) {
        some(x) => x
        none => return none
    }
    let flags = match parse_hex(s[53..55]) {
        some(x) => x
        none => return none
    }
    if hi | lo == 0 || span == 0 {
        return none
    }
    SpanContext { trace_hi: hi, trace_lo: lo, span_id: span, flags: u8(flags) & 1, state: "", remote: true }
}

/// Returns `sc` as a `traceparent` header value of version `00`, with flag `01` when sampled and `00` otherwise.
pub fn format_traceparent(sc: SpanContext) -> str {
    let flags = if sampled(sc) { "01" } else { "00" }
    "00-{trace_id_hex(sc)}-{span_id_hex(sc)}-{flags}"
}

fn key_byte(c: u8) -> bool {
    c >= 'a' && c <= 'z' || c >= '0' && c <= '9' || c == '_' || c == '-' || c == '*' || c == '/'
}

fn valid_state_key(k: str) -> bool {
    if k.len == 0 || k.len > 256 {
        return false
    }
    let at = text.index_byte(k, '@')
    if at < 0 {
        if !(k[0] >= 'a' && k[0] <= 'z') {
            return false
        }
        for i in 0..k.len {
            if !key_byte(k[i]) {
                return false
            }
        }
        return true
    }
    let tenant = k[..at]
    let system = k[at + 1..]
    if tenant.len == 0 || tenant.len > 241 || system.len == 0 || system.len > 14 {
        return false
    }
    if !(tenant[0] >= 'a' && tenant[0] <= 'z' || tenant[0] >= '0' && tenant[0] <= '9') || !(system[0] >= 'a' && system[0] <= 'z') {
        return false
    }
    for i in 0..tenant.len {
        if !key_byte(tenant[i]) {
            return false
        }
    }
    for i in 0..system.len {
        if !key_byte(system[i]) {
            return false
        }
    }
    true
}

fn valid_state_value(v: str) -> bool {
    if v.len == 0 || v.len > 256 || v[v.len - 1] == ' ' {
        return false
    }
    for i in 0..v.len {
        let c = v[i]
        if c < 0x20 || c > 0x7e || c == ',' || c == '=' {
            return false
        }
    }
    true
}

/// Validates and canonicalises a W3C `tracestate` header value.
/// Members are trimmed and rejoined with `,`; empty members are dropped. Returns `none` when a key or value breaks the W3C syntax, a key repeats or there are more than 32 members. An empty value returns an empty string.
pub fn normalize_tracestate(value: str) -> str? {
    var members: []str = []
    var keys: [str: bool] = [:]
    for part in text.split(value, ',') {
        let member = text.trim(part)
        if member.len == 0 {
            continue
        }
        let eq = text.index_byte(member, '=')
        if eq <= 0 {
            return none
        }
        let key = member[..eq]
        if !valid_state_key(key) || !valid_state_value(member[eq + 1..]) || keys[key] ?? false {
            return none
        }
        keys[key] = true
        push(mut members, member)
    }
    if members.len > 32 {
        return none
    }
    text.join(members, ",")
}

fn baggage_byte(c: u8) -> bool {
    c > 0x20 && c < 0x7f && c != '"' && c != ',' && c != ';' && c != '\\' && c != '%'
}

fn baggage_decode(s: str) -> str? {
    for i in 0..s.len {
        if s[i] != '%' && !baggage_byte(s[i]) {
            return none
        }
    }
    uri.unescape(s)
}

fn baggage_encode(s: str) -> str {
    uri.escape_where(s, baggage_byte)
}

/// Parses a W3C `baggage` header value into members.
/// A member with a missing `=`, an invalid token key, a bad `%XX` escape or a forbidden byte in its value is skipped, and values are percent-decoded. Text after the first `;` of a member is kept in `metadata`. A repeated key keeps its last value in its original position. At most 180 members are returned, and none when the value is longer than 8192 bytes.
pub fn parse_baggage(value: str) -> []Entry {
    var out: []Entry = []
    if value.len > 8192 {
        return out
    }
    for part in text.split(value, ',') {
        let semi = text.index_byte(part, ';')
        let pair = if semi >= 0 { part[..semi] } else { part }
        let metadata = if semi >= 0 { text.trim(part[semi + 1..]) } else { "" }
        let eq = text.index_byte(pair, '=')
        if eq <= 0 {
            continue
        }
        let key = text.trim(pair[..eq])
        if !header.token(key) {
            continue
        }
        let decoded = match baggage_decode(text.trim(pair[eq + 1..])) {
            some(x) => x
            none => continue
        }
        var found = false
        for i, e in out {
            if e.key == key {
                out[i] = Entry { key, value: decoded, metadata }
                found = true
            }
        }
        if !found && out.len < 180 {
            push(mut out, Entry { key, value: decoded, metadata })
        }
    }
    out
}

/// Formats baggage members as a `baggage` header value.
/// Values are percent-encoded. Members whose key is not a token are skipped, and output stops at 180 members or 8192 bytes.
pub fn format_baggage(entries: []Entry) -> str {
    var parts: []str = []
    var size = 0
    for e in entries {
        if !header.token(e.key) {
            continue
        }
        let member = if e.metadata.len > 0 { "{e.key}={baggage_encode(e.value)};{e.metadata}" } else { "{e.key}={baggage_encode(e.value)}" }
        if parts.len >= 180 || size + member.len + 1 > 8192 {
            break
        }
        size += member.len + 1
        push(mut parts, member)
    }
    text.join(parts, ",")
}

fn propagators_of(c: *Context) -> Propagators {
    match c.sdk {
        some(s) => s.propagators
        none => Propagators {}
    }
}

/// Writes the trace and baggage headers for `c` into `headers`, replacing any of the same name.
/// `traceparent` is written when the SDK's trace-context propagator is on and `c` has a valid span, and `tracestate` with it when the state is not empty. `baggage` is written when the baggage propagator is on and the member list formats to something. Both propagators are on when `c` has no SDK.
pub fn inject(c: *Context, mut headers: []header.Header) {
    let p = propagators_of(c)
    let sc = c.span.context
    if p.trace_context && valid(sc) {
        header.set(mut headers, "traceparent", format_traceparent(sc))
        if sc.state.len > 0 {
            header.set(mut headers, "tracestate", sc.state)
        }
    }
    if p.baggage && c.baggage.len > 0 {
        let value = format_baggage(c.baggage)
        if value.len > 0 {
            header.set(mut headers, "baggage", value)
        }
    }
}

fn joined_header(headers: []header.Header, name: str) -> str {
    var parts: []str = []
    for h in headers {
        if text.equal_fold(h.name, name) {
            push(mut parts, h.value)
        }
    }
    text.join(parts, ",")
}

/// Returns a context with the span and baggage found in `headers`.
/// A valid `traceparent` header becomes the active span, a remote one with the joined `tracestate` headers as its state, and a non-empty `baggage` with at least one valid member replaces the baggage. Repeated headers are joined with commas. Each part is read only when its propagator is on. Returns `c` itself when nothing was found.
pub fn extract_into(c: *Context, headers: []header.Header) -> *Context {
    let p = propagators_of(c)
    var next = *c
    var changed = false
    if p.trace_context {
        match parse_traceparent(header.get(headers, "traceparent") ?? "") {
            some(sc) => {
                var remote = sc
                remote.state = normalize_tracestate(joined_header(headers, "tracestate")) ?? ""
                next.span = Span { context: remote, data: none }
                next.call = none
                changed = true
            }
            none => {}
        }
    }
    if p.baggage {
        let value = joined_header(headers, "baggage")
        if value.len > 0 {
            let entries = parse_baggage(value)
            if entries.len > 0 {
                next.baggage = entries
                changed = true
            }
        }
    }
    if !changed {
        return c
    }
    new(next)
}

/// Returns the current context updated with the span and baggage found in `headers`. See `extract_into`.
pub fn extract(headers: []header.Header) -> *Context {
    extract_into(current(), headers)
}
