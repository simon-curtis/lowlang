import std/io
import std/text
import std/unicode
import std/unicode/utf16
import std/unicode/utf32

/// Why a character set conversion failed.
pub enum Error {
    /// The label does not name a supported encoding.
    UnknownEncoding
    /// The input is not valid in the encoding. `at` is the byte offset in the input where the invalid data starts.
    Malformed(at: i64)
    /// A character has no representation in the target encoding.
    /// Carries the byte offset `at` of the character in the string being encoded and its code point `c`.
    Unmappable(at: i64, c: u32)
}

/// A byte order mark found at the start of data.
pub struct Bom {
    /// The canonical name of the encoding the mark selects, such as `UTF-16LE`.
    pub name: str
    /// The length of the mark in bytes, which a caller skips to reach the text.
    pub len: i64
}

fn table_size() -> i64 {
    768
}

enum Single {
    Latin1
    Table(index: i64)
}

enum Family {
    Utf8
    Utf16(order: unicode.Order)
    Utf32(order: unicode.Order)
    Single(single: Single)
}

/// Returns the canonical encoding name for `label`, or `none` when the label is unknown.
/// The label is trimmed and compared case-insensitively. Aliases such as `latin1`, `ascii`, `cp1252` and `utf8` resolve to a canonical name; the supported names are `UTF-8`, `UTF-16LE`, `UTF-16BE`, `UTF-32LE`, `UTF-32BE`, `ISO-8859-1`, `ISO-8859-2`, `ISO-8859-15`, `windows-1250`, `windows-1251`, `windows-1252`, `KOI8-R`, `IBM437` and `IBM850`. The labels `utf-16` and `utf-32` mean the little-endian forms, and `ascii` and `us-ascii` mean `windows-1252`.
pub fn canonical(label: str) -> str? {
    let wanted = text.trim(label) |> text.lower
    for line in text.lines(embed("labels.txt")) {
        let parts = text.split(line, ' ')
        if parts.len == 2 && parts[0] == wanted {
            return parts[1]
        }
    }
    none
}

fn table_index(name: str) -> i64 {
    for i, line in text.lines(embed("tables.txt")) {
        if line == name {
            return i
        }
    }
    -1
}

fn single_of(name: str) -> Single ! Error {
    if name == "ISO-8859-1" {
        return Single.Latin1
    }
    let index = table_index(name)
    if index < 0 {
        fail UnknownEncoding
    }
    Single.Table(index)
}

fn resolve(label: str) -> Family ! Error {
    let name = canonical(label) ?? fail UnknownEncoding
    if name == "UTF-8" {
        return Family.Utf8
    }
    if name == "UTF-16LE" {
        return Family.Utf16(unicode.Order.Little)
    }
    if name == "UTF-16BE" {
        return Family.Utf16(unicode.Order.Big)
    }
    if name == "UTF-32LE" {
        return Family.Utf32(unicode.Order.Little)
    }
    if name == "UTF-32BE" {
        return Family.Utf32(unicode.Order.Big)
    }
    let single = single_of(name)?
    Family.Single(single)
}

fn table_point(index: i64, b: u8) -> u32 {
    let tables = embed("tables.bin")
    let at = index * table_size() + i64(b - 0x80) * 2
    u32(io.u16_le_str(tables, at))
}

fn single_byte_point(single: Single, b: u8) -> u32 {
    if b < 0x80 {
        return u32(b)
    }
    match single {
        Latin1 => u32(b)
        Table(index) => table_point(index, b)
    }
}

fn table_byte(index: i64, c: u32) -> i64 {
    let tables = embed("tables.bin")
    let base = index * table_size() + 256
    var low = 0
    var high = 128
    for low < high {
        let middle = (low + high) / 2
        let entry = io.u32_le_str(tables, base + middle * 4)
        let probe = entry >> 8
        if probe == c {
            return i64(entry & 0xFF)
        }
        if probe < c {
            low = middle + 1
        } else {
            high = middle
        }
    }
    -1
}

fn single_byte_of(single: Single, c: u32) -> i64 {
    if c < 0x80 {
        return i64(c)
    }
    match single {
        Latin1 => if c < 0x100 { i64(c) } else { -1 }
        Table(index) => table_byte(index, c)
    }
}

fn decode_single(single: Single, data: []u8) -> str {
    var out: []u8 = []
    for b in data {
        text.append_char(mut out, single_byte_point(single, b))
    }
    __str_view(out)
}

/// Returns the code point that Windows-1252 assigns to the byte `b`.
/// Bytes below `0x80` and from `0xA0` map to themselves, and `0x80` to `0x9F` map through the Windows-1252 table, which leaves `0x81`, `0x8D`, `0x8F`, `0x90` and `0x9D` as the control characters of the same value.
pub fn windows_1252(b: u8) -> u32 {
    let index = table_index("windows-1252")
    single_byte_point(Single.Table(index), b)
}

fn has_utf8_bom(data: []u8) -> bool {
    data.len >= 3 && data[0] == 0xEF && data[1] == 0xBB && data[2] == 0xBF
}

fn utf8_payload(data: []u8) -> str {
    if has_utf8_bom(data) {
        return str(data[3..])
    }
    str(data)
}

fn decode_utf8(data: []u8) -> str ! Error {
    let s = utf8_payload(data)
    let at = unicode.utf8_invalid_at(s)
    if at >= 0 {
        fail Malformed(at)
    }
    s
}

fn decode_utf16(order: unicode.Order, data: []u8) -> str ! Error {
    utf16.decode_bytes(data, order) catch {
        LoneSurrogate(at) => fail Malformed(at * 2)
        OddLength => fail Malformed(data.len - 1)
    }
}

fn decode_utf32(order: unicode.Order, data: []u8) -> str ! Error {
    utf32.decode_bytes(data, order) catch {
        InvalidCodePoint(at) => fail Malformed(at * 4)
        BadLength => fail Malformed(data.len - data.len % 4)
    }
}

/// Decodes `data` written in the encoding named by `label` into a UTF-8 string.
/// A leading UTF-8 byte order mark is dropped. For UTF-16 and UTF-32 a leading byte order mark selects the byte order over the one the label names and is dropped. Single-byte encodings accept every byte: values below `0x80` map to themselves and the rest through the encoding's table.
///
/// Fails with `UnknownEncoding` when `label` is not recognised and with `Malformed` at the byte offset of the first invalid UTF-8 sequence, lone UTF-16 surrogate or invalid UTF-32 code point. An odd trailing byte in UTF-16, or one to three trailing bytes in UTF-32, fails at the start of the incomplete unit.
pub fn decode(label: str, data: []u8) -> str ! Error {
    let family = resolve(label)?
    match family {
        Utf8 => return decode_utf8(data)
        Utf16(order) => return decode_utf16(order, data)
        Utf32(order) => return decode_utf32(order, data)
        Single(single) => return decode_single(single, data)
    }
}

/// Decodes `data` written in the encoding named by `label` into a UTF-8 string, replacing invalid input with U+FFFD.
/// Byte order marks are handled as in `decode`. Fails only with `UnknownEncoding`.
pub fn decode_lossy(label: str, data: []u8) -> str ! Error {
    let family = resolve(label)?
    match family {
        Utf8 => return unicode.utf8_to_valid(utf8_payload(data))
        Utf16(order) => return utf16.decode_bytes_lossy(data, order)
        Utf32(order) => return utf32.decode_bytes_lossy(data, order)
        Single(single) => decode_single(single, data)
    }
}

fn encode_single(single: Single, s: str, replacement: str, strict: bool) -> []u8 ! Error {
    var out: []u8 = []
    for i, c in s {
        let b = single_byte_of(single, c)
        if b >= 0 {
            push(mut out, u8(b))
        } else if strict {
            fail Unmappable(i, c)
        } else {
            text.append(mut out, replacement)
        }
    }
    out
}

fn encode_with(label: str, s: str, replacement: str, strict: bool) -> []u8 ! Error {
    let family = resolve(label)?
    match family {
        Utf8 => return bytes(unicode.utf8_to_valid(s))
        Utf16(order) => return utf16.encode_bytes(s, order, false)
        Utf32(order) => return utf32.encode_bytes(s, order, false)
        Single(single) => return encode_single(single, s, replacement, strict)
    }
}

/// Encodes `s` in the encoding named by `label`.
/// UTF-16 and UTF-32 are written without a byte order mark. Invalid UTF-8 in `s` is written as U+FFFD. Fails with `UnknownEncoding` when `label` is not recognised and with `Unmappable` for the first character a single-byte encoding cannot represent.
pub fn encode(label: str, s: str) -> []u8 ! Error {
    encode_with(label, s, "", true)
}

/// Encodes `s` in the encoding named by `label`, writing `replacement` for each character a single-byte encoding cannot represent.
/// The UTF-8 bytes of `replacement` are written unchanged. Fails only with `UnknownEncoding`.
pub fn encode_replace(label: str, s: str, replacement: str) -> []u8 ! Error {
    encode_with(label, s, replacement, false)
}

fn wide_bom(data: []u8, width: i64, prefix: str) -> Bom? {
    let order = unicode.bom_order(data, width) ?? return none
    let suffix = match order {
        Little => "LE"
        Big => "BE"
    }
    Bom { name: "{prefix}{suffix}", len: width }
}

/// Returns the byte order mark at the start of `data`, or `none` when there is none.
/// `FF FE 00 00` is reported as `UTF-32LE` before `FF FE` is considered as `UTF-16LE`.
pub fn detect_bom(data: []u8) -> Bom? {
    if has_utf8_bom(data) {
        return Bom { name: "UTF-8", len: 3 }
    }
    let wide = wide_bom(data, 4, "UTF-32")
    if wide != none {
        return wide
    }
    wide_bom(data, 2, "UTF-16")
}
