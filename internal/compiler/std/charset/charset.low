import std/text
import std/unicode
import std/unicode/utf16
import std/unicode/utf32

pub enum Error {
    UnknownEncoding
    Malformed(at: i64)
    Unmappable(at: i64, c: u32)
}

pub struct Bom {
    pub name: str
    pub len: i64
}

fn table_size() -> i64 {
    768
}

pub fn canonical(label: str) -> str? {
    let wanted = text.trim(label) |> text.lower
    for line in text.lines(embed("labels.txt")) {
        let parts = text.split(line, ' ')
        if parts.len == 2 && parts[0] == wanted {
            return parts[1]
        }
    }
    none
}

fn resolve(label: str) -> str ! Error {
    canonical(label) ?? fail UnknownEncoding
}

fn table_index(name: str) -> i64 {
    for i, line in text.lines(embed("tables.txt")) {
        if line == name {
            return i
        }
    }
    -1
}

fn u32_word(data: str, at: i64) -> u32 {
    u32(data[at]) | u32(data[at + 1]) << 8 | u32(data[at + 2]) << 16 | u32(data[at + 3]) << 24
}

fn single_byte_point(table: i64, b: u8) -> u32 {
    if b < 0x80 {
        return u32(b)
    }
    if table < 0 {
        return u32(b)
    }
    let tables = embed("tables.bin")
    let at = table * table_size() + i64(b - 0x80) * 2
    u32(tables[at]) | u32(tables[at + 1]) << 8
}

fn single_byte_of(table: i64, c: u32) -> i64 {
    if c < 0x80 {
        return i64(c)
    }
    if table < 0 {
        return if c < 0x100 { i64(c) } else { -1 }
    }
    let tables = embed("tables.bin")
    let base = table * table_size() + 256
    var low = 0
    var high = 128
    for low < high {
        let middle = (low + high) / 2
        let entry = u32_word(tables, base + middle * 4)
        let probe = entry >> 8
        if probe == c {
            return i64(entry & 0xFF)
        }
        if probe < c {
            low = middle + 1
        } else {
            high = middle
        }
    }
    -1
}

fn decode_single(table: i64, data: []u8) -> str {
    var out: []u8 = []
    for b in data {
        text.append_char(mut out, single_byte_point(table, b))
    }
    __str_view(out)
}

fn utf8_payload(data: []u8) -> str {
    if data.len >= 3 && data[0] == 0xEF && data[1] == 0xBB && data[2] == 0xBF {
        return str(data[3..])
    }
    str(data)
}

fn utf16_order(name: str) -> utf16.Order {
    if name == "UTF-16BE" {
        return utf16.Order.Big
    }
    utf16.Order.Little
}

fn utf32_order(name: str) -> utf32.Order {
    if name == "UTF-32BE" {
        return utf32.Order.Big
    }
    utf32.Order.Little
}

fn decode_utf8(data: []u8) -> str ! Error {
    let s = utf8_payload(data)
    let at = unicode.utf8_invalid_at(s)
    if at >= 0 {
        fail Malformed(at)
    }
    s
}

fn decode_utf16(name: str, data: []u8) -> str ! Error {
    utf16.decode_bytes(data, utf16_order(name)) catch {
        LoneSurrogate(at) => fail Malformed(at * 2)
        OddLength => fail Malformed(data.len - 1)
    }
}

fn decode_utf32(name: str, data: []u8) -> str ! Error {
    utf32.decode_bytes(data, utf32_order(name)) catch {
        InvalidCodePoint(at) => fail Malformed(at * 4)
        BadLength => fail Malformed(data.len - data.len % 4)
    }
}

pub fn decode(label: str, data: []u8) -> str ! Error {
    let name = resolve(label)?
    if name == "UTF-8" {
        return decode_utf8(data)
    }
    if name == "UTF-16LE" || name == "UTF-16BE" {
        return decode_utf16(name, data)
    }
    if name == "UTF-32LE" || name == "UTF-32BE" {
        return decode_utf32(name, data)
    }
    decode_single(table_index(name), data)
}

pub fn decode_lossy(label: str, data: []u8) -> str ! Error {
    let name = resolve(label)?
    if name == "UTF-8" {
        return unicode.utf8_to_valid(utf8_payload(data))
    }
    if name == "UTF-16LE" || name == "UTF-16BE" {
        return utf16.decode_bytes_lossy(data, utf16_order(name))
    }
    if name == "UTF-32LE" || name == "UTF-32BE" {
        return utf32.decode_bytes_lossy(data, utf32_order(name))
    }
    decode_single(table_index(name), data)
}

fn encode_single(table: i64, s: str, replacement: str, strict: bool) -> []u8 ! Error {
    var out: []u8 = []
    for i, c in s {
        let b = single_byte_of(table, c)
        if b >= 0 {
            push(mut out, u8(b))
        } else if strict {
            fail Unmappable(i, c)
        } else {
            text.append(mut out, replacement)
        }
    }
    out
}

fn encode_with(label: str, s: str, replacement: str, strict: bool) -> []u8 ! Error {
    let name = resolve(label)?
    if name == "UTF-8" {
        return bytes(unicode.utf8_to_valid(s))
    }
    if name == "UTF-16LE" || name == "UTF-16BE" {
        return utf16.encode_bytes(s, utf16_order(name), false)
    }
    if name == "UTF-32LE" || name == "UTF-32BE" {
        return utf32.encode_bytes(s, utf32_order(name), false)
    }
    encode_single(table_index(name), s, replacement, strict)
}

pub fn encode(label: str, s: str) -> []u8 ! Error {
    encode_with(label, s, "", true)
}

pub fn encode_replace(label: str, s: str, replacement: str) -> []u8 ! Error {
    encode_with(label, s, replacement, false)
}

pub fn detect_bom(data: []u8) -> Bom? {
    if data.len >= 3 && data[0] == 0xEF && data[1] == 0xBB && data[2] == 0xBF {
        return Bom { name: "UTF-8", len: 3 }
    }
    if data.len >= 4 && data[0] == 0xFF && data[1] == 0xFE && data[2] == 0 && data[3] == 0 {
        return Bom { name: "UTF-32LE", len: 4 }
    }
    if data.len >= 4 && data[0] == 0 && data[1] == 0 && data[2] == 0xFE && data[3] == 0xFF {
        return Bom { name: "UTF-32BE", len: 4 }
    }
    if data.len >= 2 && data[0] == 0xFF && data[1] == 0xFE {
        return Bom { name: "UTF-16LE", len: 2 }
    }
    if data.len >= 2 && data[0] == 0xFE && data[1] == 0xFF {
        return Bom { name: "UTF-16BE", len: 2 }
    }
    none
}
