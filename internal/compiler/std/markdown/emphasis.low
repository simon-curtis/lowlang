import std/text

struct Chain {
    items: []Tok
    before: []i64
    after: []i64
}

fn run_matches(opener: Tok, closer: Tok) -> bool {
    if opener.ch != closer.ch || !opener.can_open {
        return false
    }
    if closer.ch == '~' {
        return opener.count == closer.count
    }
    let odd = (closer.can_open || opener.can_close) && closer.orig % 3 != 0 && (opener.orig + closer.orig) % 3 == 0
    !odd
}

fn closer_class(closer: Tok) -> i64 {
    let ch = if closer.ch == '*' { 0 } else if closer.ch == '_' { 1 } else { 2 }
    let opens = if closer.can_open { 1 } else { 0 }
    (ch * 2 + opens) * 3 + closer.orig % 3
}

fn chain_of(toks: []Tok) -> Chain {
    var chain = Chain { items: [Tok { kind: TokKind.Edge, node: Inline.SoftBreak }], before: [-1], after: [-1] }
    for tok in toks {
        let at = chain.items.len
        push(mut chain.items, tok)
        push(mut chain.before, at - 1)
        push(mut chain.after, -1)
        chain.after[at - 1] = at
    }
    chain
}

fn unlink(mut chain: Chain, at: i64) {
    let left = chain.before[at]
    let right = chain.after[at]
    chain.after[left] = right
    if right >= 0 {
        chain.before[right] = left
    }
}

fn live_tokens(chain: Chain, from: i64, stop: i64) -> []Tok {
    var out: []Tok = []
    var at = from
    for at >= 0 && at != stop {
        push(mut out, chain.items[at])
        at = chain.after[at]
    }
    out
}

fn wrapped(closer: Tok, used: i64, children: []Inline) -> Inline {
    if closer.ch == '~' {
        Inline.Strikethrough(children)
    } else if used == 2 {
        Inline.Strong(children)
    } else {
        Inline.Emphasis(children)
    }
}

fn resolve(toks: []Tok) -> []Inline {
    var chain = chain_of(toks)
    var floors: []i64 = []
    for i in 0..18 {
        push(mut floors, 1)
    }
    var ci = chain.after[0]
    for ci >= 0 {
        let closer = chain.items[ci]
        if closer.kind != TokKind.Run || !closer.can_close {
            ci = chain.after[ci]
            continue
        }
        let class = closer_class(closer)
        var oi = chain.before[ci]
        var found = false
        for oi >= floors[class] {
            if chain.items[oi].kind == TokKind.Run && run_matches(chain.items[oi], closer) {
                found = true
                break
            }
            oi = chain.before[oi]
        }
        if !found {
            floors[class] = ci
            ci = chain.after[ci]
            continue
        }
        var used = 1
        if closer.ch == '~' {
            used = closer.count
        } else if closer.count >= 2 && chain.items[oi].count >= 2 {
            used = 2
        }
        let children = finish(live_tokens(chain, chain.after[oi], ci))
        insert_node(mut chain, oi, ci, wrapped(closer, used, children))
        chain.items[oi].count -= used
        chain.items[ci].count -= used
        if chain.items[oi].count == 0 {
            unlink(mut chain, oi)
        }
        if chain.items[ci].count == 0 {
            let following = chain.after[ci]
            unlink(mut chain, ci)
            ci = following
        }
    }
    finish(live_tokens(chain, chain.after[0], -1))
}

fn insert_node(mut chain: Chain, opener: i64, closer: i64, node: Inline) {
    let at = chain.items.len
    push(mut chain.items, Tok { kind: TokKind.Done, node })
    push(mut chain.before, opener)
    push(mut chain.after, closer)
    chain.after[opener] = at
    chain.before[closer] = at
}

fn finish(toks: []Tok) -> []Inline {
    var out: []Inline = []
    var pending: []u8 = []
    for tok in toks {
        match tok.kind {
            Done => {
                match tok.node {
                    Text(value) => text.append(mut pending, value)
                    _ => {
                        flush_pending(mut out, mut pending)
                        push(mut out, tok.node)
                    }
                }
            }
            Run => {
                for i in 0..tok.count {
                    push(mut pending, tok.ch)
                }
            }
            Bracket => push(mut pending, '[')
            ImageBracket => text.append(mut pending, "![")
            Edge => {}
        }
    }
    flush_pending(mut out, mut pending)
    out
}

fn flush_pending(mut out: []Inline, mut pending: []u8) {
    if pending.len > 0 {
        push(mut out, Inline.Text(str(pending)))
        truncate(mut pending, 0)
    }
}
