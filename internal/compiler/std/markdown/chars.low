import std/unicode

fn is_blank(c: u8) -> bool {
    c == ' ' || c == '\t'
}

fn is_digit(c: u8) -> bool {
    c >= '0' && c <= '9'
}

fn is_alpha(c: u8) -> bool {
    (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
}

fn is_alnum(c: u8) -> bool {
    is_alpha(c) || is_digit(c)
}

fn is_word(c: u8) -> bool {
    is_alnum(c) || c == '_'
}

fn is_hex(c: u8) -> bool {
    is_digit(c) || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F')
}

fn is_ascii_punct(c: u8) -> bool {
    (c >= '!' && c <= '/') || (c >= ':' && c <= '@') || (c >= '[' && c <= '`') || (c >= '{' && c <= '~')
}

fn is_line_space(c: u8) -> bool {
    c == ' ' || c == '\t' || c == '\n' || c == 0x0B || c == 0x0C || c == '\r'
}

fn is_punct_code(code: u32) -> bool {
    if code < 0x80 {
        return is_ascii_punct(u8(code))
    }
    unicode.is_punct(code) || unicode.is_symbol(code)
}

fn is_space_code(code: u32) -> bool {
    if code < 0x80 {
        return is_line_space(u8(code))
    }
    unicode.is_space(code)
}

fn code_before(s: str, at: i64) -> u32 {
    if at <= 0 {
        return '\n'
    }
    var start = at - 1
    for start > 0 && at - start < 4 && s[start] & 0xC0 == 0x80 {
        start -= 1
    }
    unicode.decode_rune(s, start).code
}

fn code_after(s: str, at: i64) -> u32 {
    if at >= s.len {
        return '\n'
    }
    unicode.decode_rune(s, at).code
}

fn skip_blanks(s: str, from: i64) -> i64 {
    var i = from
    for i < s.len && is_blank(s[i]) {
        i += 1
    }
    i
}

fn skip_spaces(s: str, from: i64) -> i64 {
    var i = from
    for i < s.len && s[i] == ' ' {
        i += 1
    }
    i
}

fn is_blank_line(s: str) -> bool {
    skip_blanks(s, 0) >= s.len
}

fn trim_end_blanks(s: str) -> str {
    var end = s.len
    for end > 0 && is_blank(s[end - 1]) {
        end -= 1
    }
    s[..end]
}

fn trim_blanks(s: str) -> str {
    trim_end_blanks(s[skip_blanks(s, 0)..])
}

fn trim_space(s: str) -> str {
    var start = 0
    var end = s.len
    for start < end && is_line_space(s[start]) {
        start += 1
    }
    for end > start && is_line_space(s[end - 1]) {
        end -= 1
    }
    s[start..end]
}

fn lower_ascii(c: u8) -> u8 {
    if c >= 'A' && c <= 'Z' { c + 32 } else { c }
}

fn starts_with_fold_at(s: str, at: i64, prefix: str) -> bool {
    if at + prefix.len > s.len {
        return false
    }
    for i in 0..prefix.len {
        if lower_ascii(s[at + i]) != lower_ascii(prefix[i]) {
            return false
        }
    }
    true
}

fn find_from(s: str, from: i64, sub: str) -> i64 {
    var at = from
    for at + sub.len <= s.len {
        if s[at..at + sub.len] == sub {
            return at
        }
        at += 1
    }
    -1
}

fn find_byte_from(s: str, from: i64, c: u8) -> i64 {
    var at = from
    for at < s.len {
        if s[at] == c {
            return at
        }
        at += 1
    }
    -1
}

fn unescape_punct(s: str) -> str {
    if find_byte_from(s, 0, '\\') < 0 {
        return s
    }
    var out: []u8 = []
    var i = 0
    for i < s.len {
        if s[i] == '\\' && i + 1 < s.len && is_ascii_punct(s[i + 1]) {
            i += 1
        }
        push(mut out, s[i])
        i += 1
    }
    str(out)
}

fn entity_end(s: str, at: i64) -> i64 {
    if at >= s.len || s[at] != '&' {
        return -1
    }
    var i = at + 1
    if i < s.len && s[i] == '#' {
        i += 1
        var hex = false
        if i < s.len && (s[i] == 'x' || s[i] == 'X') {
            hex = true
            i += 1
        }
        let digits_start = i
        for i < s.len && (if hex { is_hex(s[i]) } else { is_digit(s[i]) }) {
            i += 1
        }
        let count = i - digits_start
        let limit = if hex { 6 } else { 7 }
        if count < 1 || count > limit || i >= s.len || s[i] != ';' {
            return -1
        }
        return i + 1
    }
    let name_start = i
    for i < s.len && is_word(s[i]) {
        i += 1
    }
    if i == name_start || i >= s.len || s[i] != ';' {
        return -1
    }
    i + 1
}
