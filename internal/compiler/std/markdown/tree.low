/// How the cells of a table column are aligned.
pub enum Align {
    /// The column has no alignment marker; its cells carry no `align` attribute.
    Default
    /// The delimiter row marks the column `:---`.
    Left
    /// The delimiter row marks the column `:---:`.
    Center
    /// The delimiter row marks the column `---:`.
    Right
}

/// A span of inline content.
///
/// Emphasis, strong, strikethrough, links and images hold further inline content, so a run of inline text is a tree of these values.
pub enum Inline {
    /// Literal text. Adjacent runs of text are one `Text`; escapes, entities and breaks are separate values.
    Text(value: str)
    /// A backslash escape. `value` is the punctuation character the backslash protects, such as `*`.
    Escape(value: str)
    /// A character reference such as `&amp;`, `&#65;` or `&#x41;`. `raw` is the source text and `value` the characters it stands for.
    ///
    /// A named reference that is not in the HTML table keeps its source text as its `value`.
    Entity(raw: str, value: str)
    /// A code span. `value` is the content with line endings turned into spaces and one space trimmed from each end when both ends have one.
    Code(value: str)
    /// Emphasis, written `*text*` or `_text_`.
    Emphasis(children: []Inline)
    /// Strong emphasis, written `**text**` or `__text__`.
    Strong(children: []Inline)
    /// Strikethrough, written `~text~` or `~~text~~`.
    Strikethrough(children: []Inline)
    /// A link. `href` is the destination with backslash escapes removed and `title` the optional title, empty when there is none.
    Link(href: str, title: str, children: []Inline)
    /// An image. `src` and `title` are read as for `Link`, and `alt` is the inline content of the description.
    Image(src: str, title: str, alt: []Inline)
    /// An autolink: `<https://example.com>`, `<name@example.com>`, or a bare `http://`, `https://`, `ftp://`, `www.` or email address. `href` is the destination, with `mailto:` or `http://` added where the source has none, and `label` is the text shown.
    Autolink(href: str, label: str)
    /// Raw inline HTML such as `<b>`, `</b>` or `<!-- note -->`, kept as written.
    Html(value: str)
    /// A line ending inside a paragraph that is not a hard break.
    SoftBreak
    /// A line ending written as two or more spaces or a backslash before it.
    HardBreak
}

/// A table cell.
pub struct Cell {
    /// The source text of the cell, trimmed, with `\|` read as `|`.
    pub raw: str
    /// The inline content of the cell.
    pub content: []Inline
    /// The alignment of the column the cell belongs to.
    pub align: Align
}

/// A GFM table.
pub struct Table {
    /// The cells of the header row.
    pub header: []Cell
    /// The body rows. Every row has as many cells as the header: short rows are padded with empty cells and extra cells are dropped.
    pub rows: [][]Cell
}

/// One item of a list.
pub struct Item {
    /// The blocks of the item.
    pub blocks: []Block
    /// For a task list item written `[ ]` or `[x]`, whether it is checked. `none` for an ordinary item. The marker is not part of the content.
    pub checked: bool?
}

/// A bullet or ordered list.
pub struct List {
    /// `true` for a list numbered with `1.` or `1)`, `false` for one marked with `-`, `*` or `+`.
    pub ordered: bool
    /// The number of the first item of an ordered list, `1` for a bullet list.
    pub start: i64
    /// `true` when no item is separated from the next by a blank line and no item holds blocks separated by one.
    ///
    /// The HTML renderer leaves the paragraphs of a tight list item without `<p>` tags.
    pub tight: bool
    /// The items in order.
    pub items: []Item
}

/// A block of a document.
pub enum Block {
    /// A heading. `level` is `1` to `6`. `raw` is the source text with the closing `#` run removed, and `content` is that text as inline content.
    Heading(level: i64, raw: str, content: []Inline)
    /// A paragraph.
    Paragraph(content: []Inline)
    /// A fenced or indented code block. `info` is the whole info string of a fence with backslash escapes removed and `lang` its first word. Both are empty for an indented block and for a fence with no info string. `text` is the literal content, without the line ending of its last line.
    Code(lang: str, info: str, text: str)
    /// A raw HTML block, kept as written. The text ends with a line ending only when the next block follows on the very next line, as in `marked`. A comment that spans several lines is one block.
    Html(text: str)
    /// A bullet or ordered list.
    List(list: List)
    /// A block quote.
    Quote(children: []Block)
    /// A GFM table.
    Table(table: Table)
    /// A thematic break: `---`, `***` or `___`.
    Rule
}
