import std/markdown

/// Renders a Markdown document with a heading, emphasis, a task list, a table and a fenced code block to HTML.
fn main() {
    let source = "# Release notes\n\nThe **parser** now reads `GFM` tables and ~~old~~ task lists, see [the guide](https://example.com/guide \"Guide\").\n\n- [x] tables\n- [ ] footnotes\n\n| Module | Status |\n|:-------|-------:|\n| markdown | new |\n| html | stable |\n\n```low\nlet html = markdown.to_html(\"*hi*\")\n```\n"
    print(markdown.to_html(source))
}
