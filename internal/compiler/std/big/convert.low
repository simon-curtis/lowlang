import std/text

struct Chunk {
    digits: i64
    value: u32
}

fn chunk_for(base: i64) -> Chunk {
    var digits = 1
    var value = base
    for value * base < 0x100000000 {
        value *= base
        digits += 1
    }
    Chunk { digits, value: u32(value) }
}

fn power_of_two_shift(base: i64) -> i64 {
    match base {
        == 2 => 1
        == 4 => 2
        == 8 => 3
        == 16 => 4
        == 32 => 5
        _ => 0
    }
}

fn digit_char(v: u32) -> u8 {
    if v < 10 {
        return u8(48 + v)
    }
    u8(87 + v)
}

struct WideChunk {
    digits: i64
    value: u64
    shift: i64
    inverse: u64
}

fn wide_chunk(base: i64) -> WideChunk {
    let b = u64(base)
    let limit = 0xFFFFFFFFFFFFFFFF / b
    var digits = 1
    var value = b
    for value <= limit {
        value *= b
        digits += 1
    }
    var shift = 0
    for value << u64(shift) & 0x8000000000000000 == 0 {
        shift += 1
    }
    let normal = value << u64(shift)
    let ones: []u32 = [0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF, 0xFFFFFFFF]
    let divisor: []u32 = [u32(normal), u32(normal >> 32)]
    let q = limbs_divmod(ones, divisor).q
    WideChunk { digits, value, shift, inverse: u64(q[0]) | u64(q[1]) << 32 }
}

fn divide_words(w: []u64, n: i64, c: WideChunk) -> u64 {
    let divisor = c.value << u64(c.shift)
    let back = u64(64 - c.shift)
    let up = u64(c.shift)
    var rem: u64 = w[n - 1] >> back
    var i = n - 1
    for i >= 0 {
        var low: u64 = w[i] << up
        if i > 0 {
            low |= w[i - 1] >> back
        }
        let product = c.inverse * rem
        let sum = product + low
        var q = __mulhi(c.inverse, rem) + rem + 1
        if sum < product {
            q += 1
        }
        var r = low - q * divisor
        if r > sum {
            q -= 1
            r += divisor
        }
        if r >= divisor {
            q += 1
            r -= divisor
        }
        w[i] = q
        rem = r
        i -= 1
    }
    rem >> up
}

fn pack_words(mag: []u32) -> []u64 {
    let w: []u64 = __make((mag.len + 1) / 2)
    for i in 0..mag.len {
        w[i / 2] |= u64(mag[i]) << u64(32 * (i % 2))
    }
    w
}

fn chunked_digits(mag: []u32, base: i64) -> []u8 {
    let c = wide_chunk(base)
    let w = pack_words(mag)
    var parts: []u64 = []
    var n = w.len
    for n > 0 {
        push(mut parts, divide_words(w, n, c))
        for n > 0 && w[n - 1] == 0 {
            n -= 1
        }
    }
    let out: []u8 = __make(parts.len * c.digits)
    let b = u64(base)
    for p, part in parts {
        var v = part
        let end = out.len - p * c.digits
        for d in 0..c.digits {
            let q = v / b
            out[end - 1 - d] = digit_char(u32(v - q * b))
            v = q
        }
    }
    out
}

fn power_of_two_digits(mag: []u32, shift: i64) -> []u8 {
    let count = (limbs_bit_len(mag) + shift - 1) / shift
    let out: []u8 = __make(count)
    let mask = (u64(1) << shift) - 1
    for i in 0..count {
        let pos = i * shift
        let limb = pos / 32
        let next = if limb + 1 < mag.len { u64(mag[limb + 1]) } else { 0 }
        let v = ((u64(mag[limb]) | next << 32) >> (pos % 32)) & mask
        out[count - 1 - i] = digit_char(u32(v))
    }
    out
}

/// Returns `a` written in `base` using lowercase digits `0-9a-z`, with a leading `-` for a negative number.
///
/// Zero is `"0"`. Panics when `base` is outside 2 to 36. Bases 2, 4, 8, 16 and 32 take time linear in the limb count; other bases take quadratic time.
pub fn to_str(a: Int, base: i64) -> str {
    if base < 2 || base > 36 {
        __panic("big: base must be between 2 and 36")
    }
    if a.mag.len == 0 {
        return "0"
    }
    let shift = power_of_two_shift(base)
    var digits = if shift > 0 { power_of_two_digits(a.mag, shift) } else { chunked_digits(a.mag, base) }
    var first = 0
    for digits[first] == '0' {
        first += 1
    }
    let body = str(digits[first..])
    if a.neg {
        return "-{body}"
    }
    body
}

fn prefix_base(s: str, at: i64) -> i64 {
    if s.len < at + 2 || s[at] != '0' {
        return 0
    }
    match s[at + 1] {
        == 'x' => 16
        == 'X' => 16
        == 'b' => 2
        == 'B' => 2
        == 'o' => 8
        == 'O' => 8
        _ => 0
    }
}

fn digit_values(s: str, start: i64, base: i64) -> []u8 ! Error {
    var vals: []u8 = []
    var after_digit = false
    for i in start..s.len {
        let c = s[i]
        if c == '_' {
            if !after_digit {
                fail BadDigit(i)
            }
            after_digit = false
            continue
        }
        let v = text.digit(c, base)
        if v < 0 {
            fail BadDigit(i)
        }
        push(mut vals, u8(v))
        after_digit = true
    }
    if vals.len == 0 {
        fail Empty
    }
    if !after_digit {
        fail BadDigit(s.len - 1)
    }
    vals
}

fn mul_add(mut w: []u32, m: u32, add: u32) {
    var carry = u64(add)
    let mm = u64(m)
    for i in 0..w.len {
        let t = u64(w[i]) * mm + carry
        w[i] = u32(t)
        carry = t >> 32
    }
    if carry > 0 {
        push(mut w, u32(carry))
    }
}

fn pack_power_of_two(vals: []u8, shift: i64) -> []u32 {
    let total = vals.len * shift
    let out: []u32 = __make((total + 31) / 32)
    for i in 0..vals.len {
        let pos = (vals.len - 1 - i) * shift
        let v = u64(vals[i]) << (pos % 32)
        out[pos / 32] |= u32(v)
        if pos / 32 + 1 < out.len {
            out[pos / 32 + 1] |= u32(v >> 32)
        }
    }
    out
}

fn pack_chunked(vals: []u8, base: i64) -> []u32 {
    let c = chunk_for(base)
    var w: []u32 = []
    var at = 0
    var size = vals.len % c.digits
    if size == 0 {
        size = c.digits
    }
    for at < vals.len {
        var v: u32 = 0
        var m: u32 = 1
        for i in at..at + size {
            v = v * u32(base) + u32(vals[i])
            m *= u32(base)
        }
        mul_add(mut w, m, v)
        at += size
        size = c.digits
    }
    w
}

/// Parses an integer written in `base`.
///
/// The text may start with `+` or `-`, and digits may be separated by single `_` characters. Letters are accepted in either case. With `base` `0` the base is taken from a `0x`, `0b` or `0o` prefix after the sign and is `10` without one; with any other base a prefix is not recognised. Fails with `Empty` when there are no digits, with `BadBase` when `base` is not `0` or in 2 to 36, and with `BadDigit` carrying the byte offset of a character that is not a digit of the base or of a `_` that does not follow a digit.
pub fn parse(s: str, base: i64) -> Int ! Error {
    if s.len == 0 {
        fail Empty
    }
    var start = 0
    var negative = false
    if s[0] == '-' || s[0] == '+' {
        negative = s[0] == '-'
        start = 1
    }
    var radix = base
    if base == 0 {
        radix = prefix_base(s, start)
        if radix == 0 {
            radix = 10
        } else {
            start += 2
        }
    }
    if radix < 2 || radix > 36 {
        fail BadBase
    }
    let vals = digit_values(s, start, radix)?
    let shift = power_of_two_shift(radix)
    let mag = if shift > 0 { pack_power_of_two(vals, shift) } else { pack_chunked(vals, radix) }
    make_int(negative, mag)
}
