import std/big
import std/big/decimal
import std/text

/// An exact rational number `num / den` over `big.Int`.
///
/// A `Rat` is always in lowest terms and its denominator is positive, so equal values have identical parts.
pub struct Rat {
    num: big.Int
    den: big.Int
}

fn exact(n: big.Int, d: big.Int) -> big.Int {
    big.quo(n, d) or big.zero()
}

fn reduced(n: big.Int, d: big.Int) -> Rat {
    let g = big.gcd(n, d)
    var num = exact(n, g)
    var den = exact(d, g)
    if big.sign(den) < 0 {
        num = big.neg(num)
        den = big.neg(den)
    }
    Rat { num, den }
}

/// Returns the rational `n / d` reduced to lowest terms with a positive denominator.
///
/// Fails with `DivideByZero` when `d` is zero.
pub fn ratio(n: big.Int, d: big.Int) -> Rat ! big.Error {
    if big.is_zero(d) {
        fail DivideByZero
    }
    reduced(n, d)
}

/// Returns the integer `n` as a rational with denominator `1`.
pub fn from_int(n: big.Int) -> Rat {
    Rat { num: n, den: big.one() }
}

/// Returns the integer `n` as a rational with denominator `1`.
pub fn from_i64(n: i64) -> Rat {
    from_int(big.from_i64(n))
}

/// Returns the numerator of `r`, which carries its sign.
pub fn numerator(r: Rat) -> big.Int {
    r.num
}

/// Returns the denominator of `r`, which is always positive.
pub fn denominator(r: Rat) -> big.Int {
    r.den
}

/// Returns `-1`, `0` or `1` for a negative, zero or positive `r`.
pub fn sign(r: Rat) -> i64 {
    big.sign(r.num)
}

/// Returns `true` when `r` is zero.
pub fn is_zero(r: Rat) -> bool {
    big.is_zero(r.num)
}

/// Returns `true` when the denominator of `r` is `1`.
pub fn is_int(r: Rat) -> bool {
    big.equal(r.den, big.one())
}

/// Returns `-r`.
pub fn neg(r: Rat) -> Rat {
    Rat { num: big.neg(r.num), den: r.den }
}

/// Returns the absolute value of `r`.
pub fn abs(r: Rat) -> Rat {
    Rat { num: big.abs(r.num), den: r.den }
}

/// Returns `a + b` in lowest terms.
pub fn add(a: Rat, b: Rat) -> Rat {
    let n = big.add(big.mul(a.num, b.den), big.mul(b.num, a.den))
    reduced(n, big.mul(a.den, b.den))
}

/// Returns `a - b` in lowest terms.
pub fn sub(a: Rat, b: Rat) -> Rat {
    add(a, neg(b))
}

/// Returns `a * b` in lowest terms.
pub fn mul(a: Rat, b: Rat) -> Rat {
    reduced(big.mul(a.num, b.num), big.mul(a.den, b.den))
}

/// Returns `1 / a`.
///
/// Fails with `DivideByZero` when `a` is zero.
pub fn inv(a: Rat) -> Rat ! big.Error {
    ratio(a.den, a.num)
}

/// Returns `a / b` in lowest terms.
///
/// Fails with `DivideByZero` when `b` is zero.
pub fn div(a: Rat, b: Rat) -> Rat ! big.Error {
    ratio(big.mul(a.num, b.den), big.mul(a.den, b.num))
}

/// Compares `a` with `b` and returns `-1` when `a < b`, `0` when they are equal and `1` when `a > b`.
pub fn cmp(a: Rat, b: Rat) -> i64 {
    big.cmp(big.mul(a.num, b.den), big.mul(b.num, a.den))
}

/// Returns `true` when `a` and `b` are the same rational.
pub fn equal(a: Rat, b: Rat) -> bool {
    cmp(a, b) == 0
}

/// Returns the exact rational value of `d`.
pub fn from_decimal(d: decimal.Decimal) -> Rat {
    let e = i64(decimal.exponent(d))
    let c = decimal.coefficient(d)
    let ten = big.from_i64(10)
    if e >= 0 {
        return from_int(big.mul(c, big.pow(ten, u64(e))))
    }
    reduced(c, big.pow(ten, u64(-e)))
}

/// Returns `r` as a decimal with the given `exponent`, rounded according to `mode`.
///
/// The result is `r` divided by `10^exponent` rounded to an integer coefficient, so an `exponent` of `-2` keeps two fractional digits.
pub fn to_decimal(r: Rat, exponent: i32, mode: decimal.Rounding) -> decimal.Decimal {
    let n = decimal.from_parts(r.num, 0)
    let d = decimal.from_parts(r.den, 0)
    decimal.div(n, d, exponent, mode) or decimal.from_i64(0, exponent)
}

/// Parses a rational written as `a/b` or as a decimal.
///
/// In the `a/b` form both sides are base 10 integers with an optional sign. Otherwise the text is a decimal with an optional sign, fraction and `e` exponent, as accepted by `decimal.parse`. Fails with `Empty` when a part has no digits, with `BadDigit` carrying the byte offset in `s` of the first offending character, with `DivideByZero` when the denominator is zero and with `Overflow` when a decimal exponent does not fit an `i32`.
pub fn parse(s: str) -> Rat ! big.Error {
    let slash = text.index_byte(s, '/')
    if slash < 0 {
        return from_decimal(decimal.parse(s)?)
    }
    let n = big.parse(s[..slash], 10)?
    let d = big.parse(s[slash + 1..], 10) catch {
        BadDigit(at) => fail BadDigit(at + slash + 1)
        e => fail e
    }
    ratio(n, d)
}

/// Returns `r` as `"n/d"`, or as `"n"` when `r` is an integer.
pub fn to_str(r: Rat) -> str {
    let n = big.to_str(r.num, 10)
    if is_int(r) {
        return n
    }
    let d = big.to_str(r.den, 10)
    "{n}/{d}"
}

/// Returns `r` as a decimal string with exactly `places` fractional digits, rounding half to even.
///
/// A negative `places` rounds to a power of ten and writes the zeros out.
pub fn to_fixed(r: Rat, places: i64) -> str {
    decimal.to_str(to_decimal(r, i32(-places), decimal.Rounding.HalfEven))
}

/// Returns the `f64` nearest to `r`, rounding ties to even.
///
/// Values beyond the `f64` range give an infinity of the same sign.
pub fn to_f64(r: Rat) -> f64 {
    if big.is_zero(r.num) {
        return 0.0
    }
    let magnitude = big.abs(r.num)
    let shift = 66 - (big.bit_len(magnitude) - big.bit_len(r.den))
    var n = magnitude
    var d = r.den
    if shift >= 0 {
        n = big.shl(n, shift)
    } else {
        d = big.shl(d, -shift)
    }
    let t = big.divmod(n, d) or return 0.0
    let v = big.to_f64_scaled(t.quotient, -shift, !big.is_zero(t.remainder))
    if big.sign(r.num) < 0 { -v } else { v }
}
