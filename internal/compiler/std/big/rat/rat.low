import std/big
import std/big/decimal
import std/text

pub struct Rat {
    num: big.Int
    den: big.Int
}

fn exact(n: big.Int, d: big.Int) -> big.Int {
    big.quo(n, d) catch big.zero()
}

fn reduced(n: big.Int, d: big.Int) -> Rat {
    let g = big.gcd(n, d)
    var num = exact(n, g)
    var den = exact(d, g)
    if big.sign(den) < 0 {
        num = big.neg(num)
        den = big.neg(den)
    }
    Rat { num, den }
}

pub fn ratio(n: big.Int, d: big.Int) -> Rat ! big.Error {
    if big.is_zero(d) {
        fail DivideByZero
    }
    reduced(n, d)
}

pub fn from_int(n: big.Int) -> Rat {
    Rat { num: n, den: big.one() }
}

pub fn from_i64(n: i64) -> Rat {
    from_int(big.from_i64(n))
}

pub fn numerator(r: Rat) -> big.Int {
    r.num
}

pub fn denominator(r: Rat) -> big.Int {
    r.den
}

pub fn sign(r: Rat) -> i64 {
    big.sign(r.num)
}

pub fn is_zero(r: Rat) -> bool {
    big.is_zero(r.num)
}

pub fn is_int(r: Rat) -> bool {
    big.equal(r.den, big.one())
}

pub fn neg(r: Rat) -> Rat {
    Rat { num: big.neg(r.num), den: r.den }
}

pub fn abs(r: Rat) -> Rat {
    Rat { num: big.abs(r.num), den: r.den }
}

pub fn add(a: Rat, b: Rat) -> Rat {
    let n = big.add(big.mul(a.num, b.den), big.mul(b.num, a.den))
    reduced(n, big.mul(a.den, b.den))
}

pub fn sub(a: Rat, b: Rat) -> Rat {
    add(a, neg(b))
}

pub fn mul(a: Rat, b: Rat) -> Rat {
    reduced(big.mul(a.num, b.num), big.mul(a.den, b.den))
}

pub fn inv(a: Rat) -> Rat ! big.Error {
    ratio(a.den, a.num)
}

pub fn div(a: Rat, b: Rat) -> Rat ! big.Error {
    ratio(big.mul(a.num, b.den), big.mul(a.den, b.num))
}

pub fn cmp(a: Rat, b: Rat) -> i64 {
    big.cmp(big.mul(a.num, b.den), big.mul(b.num, a.den))
}

pub fn equal(a: Rat, b: Rat) -> bool {
    cmp(a, b) == 0
}

pub fn from_decimal(d: decimal.Decimal) -> Rat {
    let e = i64(decimal.exponent(d))
    let c = decimal.coefficient(d)
    let ten = big.from_i64(10)
    if e >= 0 {
        return from_int(big.mul(c, big.pow(ten, u64(e))))
    }
    reduced(c, big.pow(ten, u64(-e)))
}

pub fn to_decimal(r: Rat, exponent: i32, mode: decimal.Rounding) -> decimal.Decimal {
    let n = decimal.from_parts(r.num, 0)
    let d = decimal.from_parts(r.den, 0)
    decimal.div(n, d, exponent, mode) catch decimal.from_i64(0, exponent)
}

pub fn parse(s: str) -> Rat ! big.Error {
    let slash = text.index_byte(s, '/')
    if slash < 0 {
        return from_decimal(decimal.parse(s)?)
    }
    let n = big.parse(s[..slash], 10)?
    let d = big.parse(s[slash + 1..], 10) catch {
        BadDigit(at) => fail BadDigit(at + slash + 1)
        e => fail e
    }
    ratio(n, d)
}

pub fn to_str(r: Rat) -> str {
    let n = big.to_str(r.num, 10)
    if is_int(r) {
        return n
    }
    let d = big.to_str(r.den, 10)
    "{n}/{d}"
}

pub fn to_fixed(r: Rat, places: i64) -> str {
    decimal.to_str(to_decimal(r, i32(-places), decimal.Rounding.HalfEven))
}

pub fn to_f64(r: Rat) -> f64 {
    if big.is_zero(r.num) {
        return 0.0
    }
    let magnitude = big.abs(r.num)
    let shift = 66 - (big.bit_len(magnitude) - big.bit_len(r.den))
    var n = magnitude
    var d = r.den
    if shift >= 0 {
        n = big.shl(n, shift)
    } else {
        d = big.shl(d, -shift)
    }
    let t = big.divmod(n, d) catch {
        _ => return 0.0
    }
    let v = big.to_f64_scaled(t.quotient, -shift, !big.is_zero(t.remainder))
    if big.sign(r.num) < 0 { -v } else { v }
}
