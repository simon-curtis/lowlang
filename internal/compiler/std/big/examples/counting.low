import std/big

fn digit_sum(n: big.Int) -> i64 {
    var total = 0
    for c in big.to_str(n, 10) {
        total += i64(c) - 48
    }
    total
}

fn fits_i64(n: big.Int) -> bool {
    let _ = big.to_i64(n) or return false
    true
}

/// Counts what overflows 64 bits: factorials, binomial coefficients and powers, with the checks that a result still fits an `i64`.
fn main() ! big.Error {
    let f20 = big.factorial(20)
    let f25 = big.factorial(25)
    print("20! = {big.to_str(f20, 10)}, fits an i64: {fits_i64(f20)}")
    print("25! = {big.to_str(f25, 10)}, fits an i64: {fits_i64(f25)}")
    print("digit sum of 100!: {digit_sum(big.factorial(100))}")
    print("C(100, 50) = {big.to_str(big.binomial(100, 50), 10)}")
    print("fib(150) = {big.to_str(big.fibonacci(150), 10)}")

    let power = big.shl(big.one(), 200)
    print("2^200 has {big.bit_len(power)} bits and {big.to_str(power, 10).len} digits")
    print("2^200 in hex: {big.to_str(power, 16)}")

    let split = big.divmod(f25, big.pow(big.from_i64(10), 12))?
    print("25! = {big.to_str(split.quotient, 10)} * 10^12 + {big.to_str(split.remainder, 10)}")
    print("floor sqrt of 25! = {big.to_str(big.isqrt(f25)?, 10)}")
    print("gcd(2^64, 6^40) = {big.to_str(big.gcd(big.shl(big.one(), 64), big.pow(big.from_i64(6), 40)), 10)}")
}
