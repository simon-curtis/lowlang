import std/big
import std/big/decimal

struct Line {
    name: str
    quantity: i64
    price: str
}

fn at_cents(d: decimal.Decimal, mode: decimal.Rounding) -> str {
    decimal.to_str(decimal.rescale(d, -2, mode))
}

/// Totals an invoice in exact decimals, applies an 8.25% tax rounded to cents, and shows how each rounding mode treats the same half cent.
fn main() ! big.Error {
    let lines = [
        Line { name: "cable", quantity: 3, price: "4.99" },
        Line { name: "adapter", quantity: 12, price: "0.10" },
        Line { name: "hub", quantity: 1, price: "19.995" },
    ]

    var subtotal = decimal.from_i64(0, 0)
    for line in lines {
        let amount = decimal.mul(decimal.from_i64(line.quantity, 0), decimal.parse(line.price)?)?
        print("{line.name}: {line.quantity} x {line.price} = {decimal.to_str(amount)}")
        subtotal = decimal.add(subtotal, amount)
    }
    print("subtotal: {decimal.to_str(subtotal)}")

    let rate = decimal.parse("0.0825")?
    let tax = decimal.mul(subtotal, rate)?
    print("tax before rounding: {decimal.to_str(tax)}")
    print("tax: {at_cents(tax, HalfEven)}")
    print("total: {at_cents(decimal.add(subtotal, decimal.rescale(tax, -2, HalfEven)), HalfEven)}")

    let tenth = decimal.parse("0.1")?
    let sum = decimal.add(decimal.add(tenth, tenth), tenth)
    print("0.1 + 0.1 + 0.1 equals 0.3: {decimal.equal(sum, decimal.parse("0.3")?)}")

    let half_cent = decimal.parse("2.345")?
    print("HalfEven: {at_cents(half_cent, HalfEven)}")
    print("HalfUp: {at_cents(half_cent, HalfUp)}")
    print("Down: {at_cents(half_cent, Down)}")
    print("Up: {at_cents(half_cent, Up)}")
    print("Floor: {at_cents(half_cent, Floor)}")
    print("Ceiling: {at_cents(half_cent, Ceiling)}")

    let share = decimal.div(decimal.parse("100")?, decimal.from_i64(3, 0), -4, HalfEven)?
    print("100 / 3 = {decimal.to_str(share)}")
    let _ = decimal.div(subtotal, decimal.from_i64(0, 0), -2, HalfEven) catch {
        DivideByZero => {
            print("division by zero refused")
            return
        }
        _ => return
    }
}
