import std/big
import std/text

/// The rule that picks a neighbour when a result has to be rounded to fewer digits.
pub enum Rounding {
    /// Rounds to the nearest value and, on a tie, to the one with an even last digit.
    HalfEven
    /// Rounds to the nearest value and, on a tie, away from zero.
    HalfUp
    /// Rounds toward zero, discarding the excess digits.
    Down
    /// Rounds away from zero whenever any discarded digit is non-zero.
    Up
    /// Rounds toward negative infinity.
    Floor
    /// Rounds toward positive infinity.
    Ceiling
}

/// An exact decimal number `coefficient * 10^exponent`, with an arbitrary-precision coefficient and an `i32` exponent.
/// ///
/// /// The representation is not normalised: `1.0` and `1.00` have different exponents and compare equal. `strip` removes the trailing zeros of the coefficient.
pub struct Decimal {
    coef: big.Int
    exp: i32
}

/// Returns the decimal `coefficient * 10^exponent`.
pub fn from_parts(coefficient: big.Int, exponent: i32) -> Decimal {
    Decimal { coef: coefficient, exp: exponent }
}

/// Returns the decimal `v * 10^exponent`.
pub fn from_i64(v: i64, exponent: i32) -> Decimal {
    Decimal { coef: big.from_i64(v), exp: exponent }
}

/// Returns the coefficient of `d`, which carries its sign.
pub fn coefficient(d: Decimal) -> big.Int {
    d.coef
}

/// Returns the exponent of `d`.
pub fn exponent(d: Decimal) -> i32 {
    d.exp
}

/// Returns `-1`, `0` or `1` for a negative, zero or positive `d`.
pub fn sign(d: Decimal) -> i64 {
    big.sign(d.coef)
}

/// Returns `true` when `d` is zero, whatever its exponent.
pub fn is_zero(d: Decimal) -> bool {
    big.is_zero(d.coef)
}

/// Returns `-d` with the same exponent.
pub fn neg(d: Decimal) -> Decimal {
    Decimal { coef: big.neg(d.coef), exp: d.exp }
}

/// Returns the absolute value of `d` with the same exponent.
pub fn abs(d: Decimal) -> Decimal {
    Decimal { coef: big.abs(d.coef), exp: d.exp }
}

fn pow10(n: i64) -> big.Int {
    big.pow(big.from_i64(10), u64(n))
}

fn narrow(exponent: i64) -> i32 ! big.Error {
    if exponent < -2147483648 || exponent > 2147483647 {
        fail Overflow
    }
    i32(exponent)
}

fn raised(coef: big.Int, from: i32, to: i32) -> big.Int {
    big.mul(coef, pow10(i64(from) - i64(to)))
}

fn align(a: Decimal, b: Decimal) -> i32 {
    if a.exp < b.exp { a.exp } else { b.exp }
}

/// Returns the exact sum of `a` and `b`.
/// ///
/// /// The result has the smaller of the two exponents.
pub fn add(a: Decimal, b: Decimal) -> Decimal {
    let e = align(a, b)
    Decimal { coef: big.add(raised(a.coef, a.exp, e), raised(b.coef, b.exp, e)), exp: e }
}

/// Returns the exact difference of `a` and `b`.
/// ///
/// /// The result has the smaller of the two exponents.
pub fn sub(a: Decimal, b: Decimal) -> Decimal {
    add(a, neg(b))
}

/// Returns the exact product of `a` and `b`.
/// ///
/// /// The result's exponent is the sum of the two exponents. Fails with `Overflow` when that sum does not fit an `i32`.
pub fn mul(a: Decimal, b: Decimal) -> Decimal ! big.Error {
    let e = narrow(i64(a.exp) + i64(b.exp))?
    Decimal { coef: big.mul(a.coef, b.coef), exp: e }
}

/// Compares the values of `a` and `b` and returns `-1` when `a < b`, `0` when they are equal and `1` when `a > b`.
/// ///
/// /// Exponents do not matter: `1.0` and `1.00` are equal.
pub fn cmp(a: Decimal, b: Decimal) -> i64 {
    let e = align(a, b)
    big.cmp(raised(a.coef, a.exp, e), raised(b.coef, b.exp, e))
}

/// Returns `true` when `a` and `b` have the same value, whatever their exponents.
pub fn equal(a: Decimal, b: Decimal) -> bool {
    cmp(a, b) == 0
}

fn rounds_away(mode: Rounding, negative: bool, remainder: big.Int, divisor: big.Int, quotient: big.Int) -> bool {
    match mode {
        Down => false
        Up => true
        Floor => negative
        Ceiling => !negative
        _ => {
            let twice = big.cmp(big.shl(big.abs(remainder), 1), big.abs(divisor))
            twice > 0 || (twice == 0 && (mode == HalfUp || big.is_odd(quotient)))
        }
    }
}

fn round_quotient(n: big.Int, d: big.Int, mode: Rounding) -> big.Int ! big.Error {
    let t = big.divmod(n, d)?
    if big.is_zero(t.remainder) {
        return t.quotient
    }
    let negative = big.sign(n) * big.sign(d) < 0
    if !rounds_away(mode, negative, t.remainder, d, t.quotient) {
        return t.quotient
    }
    if negative {
        return big.sub(t.quotient, big.one())
    }
    big.add(t.quotient, big.one())
}

/// Returns `d` expressed with the given `exponent`.
/// ///
/// /// When `exponent` is at most the exponent of `d` the result is exact. A larger `exponent` drops digits and rounds the result according to `mode`.
pub fn rescale(d: Decimal, exponent: i32, mode: Rounding) -> Decimal {
    if exponent <= d.exp {
        return Decimal { coef: raised(d.coef, d.exp, exponent), exp: exponent }
    }
    let divisor = pow10(i64(exponent) - i64(d.exp))
    let q = round_quotient(d.coef, divisor, mode) catch big.zero()
    Decimal { coef: q, exp: exponent }
}

/// Returns `a / b` with the given `exponent`, rounded according to `mode`.
/// ///
/// /// Fails with `DivideByZero` when `b` is zero.
pub fn div(a: Decimal, b: Decimal, exponent: i32, mode: Rounding) -> Decimal ! big.Error {
    if big.is_zero(b.coef) {
        fail DivideByZero
    }
    let shift = i64(a.exp) - i64(b.exp) - i64(exponent)
    var n = a.coef
    var d = b.coef
    if shift >= 0 {
        n = big.mul(n, pow10(shift))
    } else {
        d = big.mul(d, pow10(-shift))
    }
    Decimal { coef: round_quotient(n, d, mode)?, exp: exponent }
}

/// Returns `d` with the trailing zeros removed from its coefficient and added to its exponent.
/// ///
/// /// Zero becomes exponent `0`.
pub fn strip(d: Decimal) -> Decimal {
    if big.is_zero(d.coef) {
        return Decimal { coef: d.coef, exp: 0 }
    }
    var coef = d.coef
    var e = d.exp
    let ten = big.from_i64(10)
    for e < 2147483647 {
        let t = big.divmod(coef, ten) catch {
            _ => break
        }
        if !big.is_zero(t.remainder) {
            break
        }
        coef = t.quotient
        e += 1
    }
    Decimal { coef, exp: e }
}

fn digit_run(s: str, start: i64) -> i64 {
    var i = start
    for i < s.len && s[i] >= '0' && s[i] <= '9' {
        i += 1
    }
    i
}

fn exponent_part(s: str, at: i64) -> i64 ! big.Error {
    var i = at
    if i < s.len && (s[i] == '+' || s[i] == '-') {
        i += 1
    }
    let end = digit_run(s, i)
    if end == i {
        fail BadDigit(i)
    }
    if end != s.len {
        fail BadDigit(end)
    }
    text.parse_int(text.trim_prefix(s[at..], "+")) catch {
        _ => fail Overflow
    }
}

/// Parses a decimal number.
/// ///
/// /// The text is an optional `+` or `-`, digits with an optional `.` and fraction, and an optional `e` or `E` exponent with its own optional sign. Either the whole part or the fraction may be empty, but one of them needs a digit: `.5` and `5.` are valid. The exponent of the result is the parsed exponent minus the number of fractional digits, and trailing zeros are kept. Fails with `Empty` when there are no digits, with `BadDigit` carrying the byte offset of the first unexpected character, and with `Overflow` when the exponent does not fit an `i32`.
pub fn parse(s: str) -> Decimal ! big.Error {
    if s.len == 0 {
        fail Empty
    }
    var start = 0
    var negative = false
    if s[0] == '-' || s[0] == '+' {
        negative = s[0] == '-'
        start = 1
    }
    let whole_end = digit_run(s, start)
    var digits = s[start..whole_end]
    var fraction = 0
    var end = whole_end
    if end < s.len && s[end] == '.' {
        let fraction_end = digit_run(s, end + 1)
        digits = "{digits}{s[end + 1..fraction_end]}"
        fraction = fraction_end - end - 1
        end = fraction_end
    }
    if digits.len == 0 {
        if end < s.len {
            fail BadDigit(end)
        }
        fail Empty
    }
    var e = 0
    if end < s.len {
        if s[end] != 'e' && s[end] != 'E' {
            fail BadDigit(end)
        }
        e = exponent_part(s, end + 1)?
    }
    let magnitude = big.parse(digits, 10)?
    let coef = if negative { big.neg(magnitude) } else { magnitude }
    Decimal { coef, exp: narrow(e - fraction)? }
}

/// Returns `d` in plain notation, never in scientific notation.
/// ///
/// /// A negative exponent places the decimal point, so `from_i64(5, -2)` is `"0.05"`, and a positive exponent writes out trailing zeros. A zero with a non-negative exponent is `"0"`.
pub fn to_str(d: Decimal) -> str {
    let digits = big.to_str(big.abs(d.coef), 10)
    let sign = if big.sign(d.coef) < 0 { "-" } else { "" }
    if d.exp >= 0 {
        if big.is_zero(d.coef) {
            return "0"
        }
        let zeros = text.repeat("0", i64(d.exp))
        return "{sign}{digits}{zeros}"
    }
    let scale = -i64(d.exp)
    if digits.len <= scale {
        let zeros = text.repeat("0", scale - digits.len)
        return "{sign}0.{zeros}{digits}"
    }
    let point = digits.len - scale
    "{sign}{digits[..point]}.{digits[point..]}"
}
