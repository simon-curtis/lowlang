import std/text

fn top_bits(mag: []u32, bits: i64) -> u64 {
    if bits <= 64 {
        return limbs_to_u64(mag) << (64 - bits)
    }
    limbs_to_u64(limbs_shr(mag, bits - 64))
}

fn lower_bits_set(mag: []u32, bits: i64) -> bool {
    if bits <= 64 {
        return false
    }
    limbs_trailing_zeros(mag) < bits - 64
}

fn round_to(mag: []u32, bits: i64, sticky: bool, precision: i64) -> u64 {
    let top = top_bits(mag, bits)
    let lower = sticky || lower_bits_set(mag, bits)
    let discard = 64 - precision
    let m = top >> discard
    let tail = top & ((u64(1) << discard) - 1)
    let half = u64(1) << (discard - 1)
    if tail > half || (tail == half && (lower || m & 1 == 1)) {
        return m + 1
    }
    m
}

fn power_of_two(e: i64) -> f64 {
    text.float_from_bits(u64(e + 1023) << 52)
}

fn scale_float(m: u64, exponent: i64) -> f64 {
    var v = f64(m)
    var e = exponent
    for e > 0 {
        let step = if e > 1000 { 1000 } else { e }
        v *= power_of_two(step)
        e -= step
    }
    for e < 0 {
        let step = if e < -1000 { 1000 } else { -e }
        v /= power_of_two(step)
        e += step
    }
    v
}

fn precision_at(top: i64) -> i64 {
    if top >= -1022 {
        return 53
    }
    53 - (-1022 - top)
}

/// Returns `(a + e) * 2^exp2` as an `f64` rounded to nearest, ties to even, where `e` is a fraction below one unit of `a` that is non-zero exactly when `sticky` is `true`.
/// ///
/// /// `sticky` lets a caller that has already discarded low bits of an exact quotient keep rounding correct. Results below the normal range round to subnormals or to zero, and results beyond the `f64` range are infinite.
pub fn to_f64_scaled(a: Int, exp2: i64, sticky: bool) -> f64 {
    let bits = limbs_bit_len(a.mag)
    if bits == 0 {
        return 0.0
    }
    let top = bits - 1 + exp2
    let precision = precision_at(top)
    var magnitude = 0.0
    if top > 1023 {
        magnitude = 1.0 / 0.0
    } else if precision >= 0 {
        let m = round_to(a.mag, bits, sticky, precision)
        magnitude = scale_float(m, bits - precision + exp2)
    }
    if a.neg { -magnitude } else { magnitude }
}

/// Returns `a` as the nearest `f64`, rounding ties to even.
/// ///
/// /// Values beyond the `f64` range give an infinity of the same sign.
pub fn to_f64(a: Int) -> f64 {
    to_f64_scaled(a, 0, false)
}
