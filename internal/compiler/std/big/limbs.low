import std/bits

struct Quotient {
    q: []u32
    r: []u32
}

fn trim(x: []u32) -> []u32 {
    var n = x.len
    for n > 0 && x[n - 1] == 0 {
        n -= 1
    }
    x[..n]
}

fn limbs_bit_len(a: []u32) -> i64 {
    if a.len == 0 {
        return 0
    }
    32 * (a.len - 1) + bits.bit_length(u64(a[a.len - 1]))
}

fn limbs_cmp(a: []u32, b: []u32) -> i64 {
    if a.len != b.len {
        return if a.len < b.len { -1 } else { 1 }
    }
    var i = a.len - 1
    for i >= 0 {
        if a[i] != b[i] {
            return if a[i] < b[i] { -1 } else { 1 }
        }
        i -= 1
    }
    0
}

fn limbs_add(a: []u32, b: []u32) -> []u32 {
    if a.len < b.len {
        return limbs_add(b, a)
    }
    let out: []u32 = __make(a.len + 1)
    var carry: u64 = 0
    for i in 0..b.len {
        let s = u64(a[i]) + u64(b[i]) + carry
        out[i] = u32(s)
        carry = s >> 32
    }
    for i in b.len..a.len {
        let s = u64(a[i]) + carry
        out[i] = u32(s)
        carry = s >> 32
    }
    out[a.len] = u32(carry)
    trim(out)
}

fn limbs_sub(a: []u32, b: []u32) -> []u32 {
    let out: []u32 = __make(a.len)
    var borrow: u64 = 0
    for i in 0..b.len {
        let d = u64(a[i]) - u64(b[i]) - borrow
        out[i] = u32(d)
        borrow = d >> 63
    }
    for i in b.len..a.len {
        let d = u64(a[i]) - borrow
        out[i] = u32(d)
        borrow = d >> 63
    }
    trim(out)
}

fn limbs_shift_up(x: []u32, n: i64) -> []u32 {
    if x.len == 0 || n == 0 {
        return x
    }
    let out: []u32 = __make(x.len + n)
    __memmove(out[n..], x)
    out
}

fn limbs_school(a: []u32, b: []u32) -> []u32 {
    let out: []u32 = __make(a.len + b.len)
    for i in 0..a.len {
        let ai = u64(a[i])
        if ai == 0 {
            continue
        }
        var carry: u64 = 0
        for j in 0..b.len {
            let t = ai * u64(b[j]) + u64(out[i + j]) + carry
            out[i + j] = u32(t)
            carry = t >> 32
        }
        out[i + b.len] = u32(carry)
    }
    trim(out)
}

const karatsuba_threshold = 32

fn limbs_mul(a: []u32, b: []u32) -> []u32 {
    if a.len < b.len {
        return limbs_mul(b, a)
    }
    if b.len == 0 {
        let none: []u32 = []
        return none
    }
    if b.len < karatsuba_threshold {
        return limbs_school(a, b)
    }
    let h = (a.len + 1) / 2
    let a0 = trim(a[..h])
    let a1 = a[h..]
    if b.len <= h {
        let low = limbs_mul(a0, b)
        let high = limbs_mul(a1, b)
        return limbs_add(low, limbs_shift_up(high, h))
    }
    let b0 = trim(b[..h])
    let b1 = b[h..]
    let z0 = limbs_mul(a0, b0)
    let z2 = limbs_mul(a1, b1)
    let cross = limbs_mul(limbs_add(a0, a1), limbs_add(b0, b1))
    let z1 = limbs_sub(limbs_sub(cross, z0), z2)
    limbs_add(limbs_add(z0, limbs_shift_up(z1, h)), limbs_shift_up(z2, 2 * h))
}

fn limbs_shl(a: []u32, n: i64) -> []u32 {
    if a.len == 0 || n == 0 {
        return a
    }
    let whole = n / 32
    let bits = n % 32
    let out: []u32 = __make(a.len + whole + 1)
    for i in 0..a.len {
        let v = u64(a[i]) << bits
        out[i + whole] |= u32(v)
        out[i + whole + 1] |= u32(v >> 32)
    }
    trim(out)
}

fn limbs_shr(a: []u32, n: i64) -> []u32 {
    let whole = n / 32
    let bits = n % 32
    if whole >= a.len {
        let none: []u32 = []
        return none
    }
    let out: []u32 = __make(a.len - whole)
    for i in whole..a.len {
        let high = if i + 1 < a.len { u64(a[i + 1]) } else { 0 }
        out[i - whole] = u32((u64(a[i]) | high << 32) >> bits)
    }
    trim(out)
}

fn limbs_divmod_small(a: []u32, d: u32) -> Quotient {
    let q: []u32 = __make(a.len)
    var rem: u64 = 0
    let dd = u64(d)
    var i = a.len - 1
    for i >= 0 {
        let cur = rem << 32 | u64(a[i])
        let quotient = cur / dd
        q[i] = u32(quotient)
        rem = cur - quotient * dd
        i -= 1
    }
    let r: []u32 = [u32(rem)]
    Quotient { q: trim(q), r: trim(r) }
}

fn limbs_mod_small(a: []u32, d: u32) -> u32 {
    var rem: u64 = 0
    let dd = u64(d)
    var i = a.len - 1
    for i >= 0 {
        rem = (rem << 32 | u64(a[i])) % dd
        i -= 1
    }
    u32(rem)
}

fn limbs_divmod(a: []u32, b: []u32) -> Quotient {
    if limbs_cmp(a, b) < 0 {
        let none: []u32 = []
        return Quotient { q: none, r: a }
    }
    if b.len == 1 {
        return limbs_divmod_small(a, b[0])
    }
    let n = b.len
    let m = a.len - n
    let s = bits.leading_zeros(u64(b[n - 1])) - 32
    let v = limbs_shl(b, s)
    let u: []u32 = __make(a.len + 1)
    for i in 0..a.len {
        let w = u64(a[i]) << s
        u[i] |= u32(w)
        u[i + 1] |= u32(w >> 32)
    }
    let q: []u32 = __make(m + 1)
    let top = u64(v[n - 1])
    let second = u64(v[n - 2])
    var j = m
    for j >= 0 {
        let num = u64(u[j + n]) << 32 | u64(u[j + n - 1])
        var qhat = num / top
        var rhat = num % top
        for qhat >= 0x100000000 || qhat * second > (rhat << 32 | u64(u[j + n - 2])) {
            qhat -= 1
            rhat += top
            if rhat >= 0x100000000 {
                break
            }
        }
        var borrow: i64 = 0
        for i in 0..n {
            let p = qhat * u64(v[i])
            let t = i64(u[i + j]) - borrow - i64(p & 0xFFFFFFFF)
            u[i + j] = u32(t)
            borrow = i64(p >> 32) - (t >> 32)
        }
        let t = i64(u[j + n]) - borrow
        u[j + n] = u32(t)
        if t < 0 {
            qhat -= 1
            var carry: u64 = 0
            for i in 0..n {
                let w = u64(u[i + j]) + u64(v[i]) + carry
                u[i + j] = u32(w)
                carry = w >> 32
            }
            u[j + n] = u32(u64(u[j + n]) + carry)
        }
        q[j] = u32(qhat)
        j -= 1
    }
    Quotient { q: trim(q), r: limbs_shr(trim(u[..n]), s) }
}

fn limbs_from_u64(v: u64) -> []u32 {
    if v == 0 {
        let none: []u32 = []
        return none
    }
    if v >> 32 == 0 {
        return [u32(v)]
    }
    [u32(v), u32(v >> 32)]
}

fn limbs_to_u64(a: []u32) -> u64 {
    var v: u64 = 0
    if a.len > 0 {
        v = u64(a[0])
    }
    if a.len > 1 {
        v |= u64(a[1]) << 32
    }
    v
}

fn limbs_bit(a: []u32, i: i64) -> bool {
    let limb = i / 32
    if limb >= a.len {
        return false
    }
    (a[limb] >> (i % 32)) & 1 == 1
}

fn limbs_trailing_zeros(a: []u32) -> i64 {
    for i in 0..a.len {
        if a[i] != 0 {
            return 32 * i + bits.trailing_zeros(u64(a[i]))
        }
    }
    0
}

fn limbs_pad(a: []u32, k: i64) -> []u32 {
    let out: []u32 = __make(k)
    __memmove(out, a)
    out
}
