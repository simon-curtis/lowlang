import std/base64
import std/cbor
import std/crypto/hash
import std/json

/// The reasons a registration or authentication response is rejected.
pub enum Error {
    /// A member of the credential JSON is missing, has the wrong type or is not valid Base64url. `field` names it.
    MalformedCredential(field: str)
    /// The credential `id` is not the Base64url of `rawId`.
    IdMismatch
    /// The credential `type` is not `public-key`. `found` is the type received.
    WrongCredentialType(found: str)
    /// `clientDataJSON` is not a JSON object with string `type`, `challenge` and `origin` members, or its challenge is not Base64url.
    MalformedClientData
    /// The client data `type` is not `webauthn.create` for a registration or `webauthn.get` for an authentication. `found` is the type received.
    WrongClientDataType(found: str)
    /// The client data challenge differs from `Expected.challenge`.
    ChallengeMismatch
    /// The client data origin differs from `Expected.origin`. `found` is the origin received.
    OriginMismatch(found: str)
    /// The attestation object is not a CBOR map with a text `fmt` and a byte string `authData`.
    MalformedAttestationObject
    /// The attestation format is not `none`. `format` is the format received.
    UnsupportedAttestation(format: str)
    /// The attestation statement is not an empty map, as the `none` format requires.
    UnexpectedAttestationStatement
    /// The authenticator data is shorter than 37 bytes, has invalid attested credential data or extensions, or has trailing bytes.
    MalformedAuthenticatorData
    /// The authenticator data does not start with the SHA-256 of `Expected.rp_id`.
    RpIdHashMismatch
    /// The user present (`UP`) flag is not set.
    UserNotPresent
    /// `Expected.require_user_verification` is set and the user verified (`UV`) flag is not.
    UserNotVerified
    /// A registration response has no attested credential data or an empty credential id.
    MissingCredentialData
    /// The backup state (`BS`) flag is set while backup eligibility (`BE`) is not.
    InconsistentBackupFlags
    /// The credential public key is not a valid COSE_Key for a supported algorithm.
    MalformedPublicKey
    /// The credential public key uses a COSE algorithm other than `-7`, `-8` and `-257`. `alg` is the identifier received.
    UnsupportedAlgorithm(alg: i64)
    /// The assertion signature does not verify under the stored public key.
    BadSignature
    /// The signature counter did not increase, which can indicate a cloned authenticator. `received` is the counter in the response and `stored` the one the caller holds.
    SignCountRegression(received: i64, stored: i64)
}

/// What the relying party expects of a response.
pub struct Expected {
    /// The challenge that was sent in the options, as raw bytes. Compared in constant time.
    pub challenge: []u8
    /// The relying party identifier. The authenticator data must carry its SHA-256.
    pub rp_id: str
    /// The exact origin the client reports, such as `https://example.com`.
    pub origin: str
    /// Whether the `UV` flag must be set. Defaults to `false`; the `UP` flag is always required.
    pub require_user_verification: bool = false
}

/// A verified registration, ready to store.
pub struct Registration {
    /// The credential id, the key to look the credential up by.
    pub credential_id: []u8
    /// The credential public key as the CBOR encoded COSE_Key bytes, which `verify_authentication` and `parse_public_key` take.
    pub public_key: []u8
    /// The initial signature counter, `0` for authenticators that do not count.
    pub sign_count: i64
    /// The 16-byte authenticator attestation GUID identifying the authenticator model.
    pub aaguid: []u8
    /// Whether the `UV` flag was set.
    pub user_verified: bool
    /// Whether the credential is eligible for backup or sync across devices (the `BE` flag).
    pub multi_device: bool
    /// Whether the credential is currently backed up (the `BS` flag).
    pub backed_up: bool
}

/// A verified authentication.
pub struct Authentication {
    /// The id of the credential that signed, from `rawId`.
    pub credential_id: []u8
    /// The signature counter from the response, to store in place of the old one.
    pub new_sign_count: i64
    /// Whether the `UV` flag was set.
    pub user_verified: bool
    /// Whether the credential is eligible for backup or sync across devices (the `BE` flag).
    pub multi_device: bool
    /// Whether the credential is currently backed up (the `BS` flag).
    pub backed_up: bool
}

struct AuthenticatorData {
    rp_id_hash: []u8
    flags: u8
    sign_count: i64
    aaguid: []u8
    credential_id: []u8
    public_key: []u8
}

struct Credential {
    raw_id: []u8
    client_data: []u8
    response: json.Value
}

fn text_field(v: json.Value, name: str) -> str ! Error {
    json.field_text(v, name) ?? fail MalformedCredential(name)
}

fn url_data(s: str) -> []u8? {
    base64.decode_with(s, base64.url_safe(), base64.Padding.Optional) catch {
        _ => return none
    }
}

fn binary_field(v: json.Value, name: str) -> []u8 ! Error {
    let s = text_field(v, name)?
    url_data(s) ?? fail MalformedCredential(name)
}

fn credential(v: json.Value) -> Credential ! Error {
    let id = text_field(v, "id")?
    let raw_id = binary_field(v, "rawId")?
    let response = json.field(v, "response")
    match response {
        Object(_) => {}
        _ => fail MalformedCredential("response")
    }
    let client_data = binary_field(response, "clientDataJSON")?
    let kind = text_field(v, "type")?
    if base64.encode_url(raw_id) != id {
        fail IdMismatch
    }
    if kind != "public-key" {
        fail WrongCredentialType(kind)
    }
    Credential { raw_id, client_data, response }
}

fn client_text(v: json.Value, name: str) -> str ! Error {
    json.field_text(v, name) ?? fail MalformedClientData
}

fn check_client_data(data: []u8, kind: str, expected: Expected) ! Error {
    let v = json.parse(data) catch {
        _ => fail MalformedClientData
    }
    match v {
        Object(_) => {}
        _ => fail MalformedClientData
    }
    let found_kind = client_text(v, "type")?
    let challenge_text = client_text(v, "challenge")?
    let origin = client_text(v, "origin")?
    let challenge = url_data(challenge_text) ?? fail MalformedClientData
    if found_kind != kind {
        fail WrongClientDataType(found_kind)
    }
    if !hash.equal(challenge, expected.challenge) {
        fail ChallengeMismatch
    }
    if origin != expected.origin {
        fail OriginMismatch(origin)
    }
}

fn flag(flags: u8, bit: u8) -> bool {
    flags & bit != 0
}

fn parse_authenticator_data(data: []u8) -> AuthenticatorData ! Error {
    if data.len < 37 {
        fail MalformedAuthenticatorData
    }
    let flags = data[32]
    var sign_count = 0
    for b in data[33..37] {
        sign_count = sign_count << 8 | i64(b)
    }
    var out = AuthenticatorData { rp_id_hash: data[..32], flags, sign_count, aaguid: [], credential_id: [], public_key: [] }
    var at = 37
    let limits = cbor.Options { max_depth: 16, max_length: data.len }
    if flag(flags, 0x40) {
        if data.len < at + 18 {
            fail MalformedAuthenticatorData
        }
        out.aaguid = data[at..at + 16]
        let length = i64(data[at + 16]) << 8 | i64(data[at + 17])
        at += 18
        if data.len < at + length {
            fail MalformedAuthenticatorData
        }
        out.credential_id = data[at..at + length]
        at += length
        let key = cbor.decode_first(data[at..], limits) catch {
            _ => fail MalformedAuthenticatorData
        }
        out.public_key = data[at..at + key.length]
        at += key.length
    }
    if flag(flags, 0x80) {
        let extensions = cbor.decode_first(data[at..], limits) catch {
            _ => fail MalformedAuthenticatorData
        }
        at += extensions.length
    }
    if at != data.len {
        fail MalformedAuthenticatorData
    }
    out
}

fn check_authenticator_data(a: AuthenticatorData, expected: Expected) ! Error {
    let sha256 = hash.sha256()
    let rp_id_hash = hash.sum(sha256, bytes(expected.rp_id))
    if !hash.equal(a.rp_id_hash, rp_id_hash) {
        fail RpIdHashMismatch
    }
    if !flag(a.flags, 0x01) {
        fail UserNotPresent
    }
    if expected.require_user_verification && !flag(a.flags, 0x04) {
        fail UserNotVerified
    }
}

fn check_backup_flags(flags: u8) ! Error {
    if flag(flags, 0x10) && !flag(flags, 0x08) {
        fail InconsistentBackupFlags
    }
}

fn attestation_text(v: cbor.Value, name: str) -> str ! Error {
    match cbor.get(v, cbor.Value.Text(name)) ?? cbor.Value.Null {
        Text(s) => s
        _ => fail MalformedAttestationObject
    }
}

fn attestation_auth_data(v: cbor.Value) -> []u8 ! Error {
    match cbor.get(v, cbor.Value.Text("authData")) ?? cbor.Value.Null {
        Bytes(data) => data
        _ => fail MalformedAttestationObject
    }
}

fn check_statement(v: cbor.Value) ! Error {
    match cbor.get(v, cbor.Value.Text("attStmt")) ?? cbor.Value.Map([]) {
        Map(entries) => if entries.len > 0 { fail UnexpectedAttestationStatement }
        _ => fail UnexpectedAttestationStatement
    }
}

/// Verifies the JSON of a `navigator.credentials.create` response and returns the credential to store.
///
/// `credential_json` is the JSON form of a `PublicKeyCredential` (`id`, `rawId`, `type` and a `response` with `clientDataJSON` and `attestationObject`, Base64url encoded). The checks follow WebAuthn registration verification: the credential id and type, the client data type `webauthn.create`, `challenge` and `origin`, the `rpIdHash`, the `UP` flag (and `UV` when required), the attested credential data and its COSE public key, and the backup flags. Only the `none` attestation format with an empty statement is accepted; no attestation signature or certificate chain is verified.
///
/// Fails with the `Error` variant of the first check that fails.
pub fn verify_registration(credential_json: json.Value, expected: Expected) -> Registration ! Error {
    let c = credential(credential_json)?
    let attestation = binary_field(c.response, "attestationObject")?
    check_client_data(c.client_data, "webauthn.create", expected)?
    let limits = cbor.Options { max_depth: 16, max_length: attestation.len }
    let object = cbor.decode_with(attestation, limits) catch {
        _ => fail MalformedAttestationObject
    }
    match object {
        Map(_) => {}
        _ => fail MalformedAttestationObject
    }
    let format = attestation_text(object, "fmt")?
    let authenticator_data = attestation_auth_data(object)?
    let a = parse_authenticator_data(authenticator_data)?
    check_authenticator_data(a, expected)?
    if !flag(a.flags, 0x40) || a.credential_id.len == 0 {
        fail MissingCredentialData
    }
    parse_public_key(a.public_key)?
    if format != "none" {
        fail UnsupportedAttestation(format)
    }
    check_statement(object)?
    check_backup_flags(a.flags)?
    Registration {
        credential_id: a.credential_id
        public_key: a.public_key
        sign_count: a.sign_count
        aaguid: a.aaguid
        user_verified: flag(a.flags, 0x04)
        multi_device: flag(a.flags, 0x08)
        backed_up: flag(a.flags, 0x10)
    }
}

/// Verifies the JSON of a `navigator.credentials.get` response against the stored credential and returns the result.
///
/// `credential_json` is the JSON form of a `PublicKeyCredential` whose `response` has `clientDataJSON`, `authenticatorData` and `signature`, Base64url encoded. `public_key` and `sign_count` are the values saved from `Registration` or the last `Authentication`; the caller finds them from the credential `id` before calling. The checks are those of `verify_registration` with the client data type `webauthn.get`, then the signature counter, then the signature over the authenticator data followed by the SHA-256 of the client data.
///
/// The counter is checked only when either value is nonzero, and must then be strictly greater than `sign_count`, otherwise `SignCountRegression` is returned. Fails with `BadSignature` when the signature does not verify and otherwise with the `Error` variant of the first check that fails.
pub fn verify_authentication(credential_json: json.Value, expected: Expected, public_key: []u8, sign_count: i64) -> Authentication ! Error {
    let c = credential(credential_json)?
    let authenticator_data = binary_field(c.response, "authenticatorData")?
    let signature = binary_field(c.response, "signature")?
    check_client_data(c.client_data, "webauthn.get", expected)?
    let a = parse_authenticator_data(authenticator_data)?
    check_authenticator_data(a, expected)?
    if (a.sign_count > 0 || sign_count > 0) && a.sign_count <= sign_count {
        fail SignCountRegression(a.sign_count, sign_count)
    }
    let key = parse_public_key(public_key)?
    let sha256 = hash.sha256()
    let client_hash = hash.sum(sha256, c.client_data)
    let signed: []u8 = __make(authenticator_data.len + client_hash.len)
    __memmove(signed, authenticator_data)
    __memmove(signed[authenticator_data.len..], client_hash)
    if !verify_signature(key, signed, signature) {
        fail BadSignature
    }
    check_backup_flags(a.flags)?
    Authentication {
        credential_id: c.raw_id
        new_sign_count: a.sign_count
        user_verified: flag(a.flags, 0x04)
        multi_device: flag(a.flags, 0x08)
        backed_up: flag(a.flags, 0x10)
    }
}
