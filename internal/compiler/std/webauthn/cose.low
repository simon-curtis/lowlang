import std/cbor
import std/crypto/ecdsa
import std/crypto/ed25519
import std/crypto/hash
import std/crypto/rsa

/// A credential public key decoded from a COSE_Key (RFC 9052).
///
/// The supported algorithms are ES256 (COSE `-7`), EdDSA with Ed25519 (`-8`) and RS256 (`-257`).
pub enum PublicKey {
    /// A P-256 ECDSA key as the 65-byte uncompressed SEC 1 point: `0x04` followed by the 32-byte `x` and `y` coordinates.
    Es256(point: []u8)
    /// An Ed25519 key as its 32-byte public key (RFC 8032).
    EdDsa(public: []u8)
    /// An RSA key for RSASSA-PKCS1-v1_5 with SHA-256 (RFC 8017), with the modulus and exponent stripped of leading zero bytes.
    Rs256(key: rsa.PublicKey)
}

fn label(key: cbor.Value, n: i64) -> cbor.Value? {
    cbor.get(key, cbor.integer(n))
}

fn integer_label(key: cbor.Value, n: i64) -> i64 ! Error {
    let found = label(key, n) ?? fail MalformedPublicKey
    cbor.as_integer(found) ?? fail MalformedPublicKey
}

fn bytes_label(key: cbor.Value, n: i64) -> []u8 ! Error {
    match label(key, n) ?? cbor.Value.Null {
        Bytes(data) => data
        _ => fail MalformedPublicKey
    }
}

fn sized_label(key: cbor.Value, n: i64, size: i64) -> []u8 ! Error {
    let data = bytes_label(key, n)?
    if data.len != size {
        fail MalformedPublicKey
    }
    data
}

fn expect(key: cbor.Value, n: i64, want: i64) ! Error {
    if integer_label(key, n)? != want {
        fail MalformedPublicKey
    }
}

const es256 = -7
const eddsa = -8
const rs256 = -257

/// Returns the COSE algorithm identifiers `parse_public_key` supports, in order of preference: EdDSA (`-8`), ES256 (`-7`) and RS256 (`-257`).
pub fn supported_algorithms() -> []i64 {
    [eddsa, es256, rs256]
}

/// Decodes a CBOR encoded COSE_Key into a `PublicKey`.
///
/// The `alg` label (`3`) selects the type and must agree with the other labels: ES256 needs key type `2` (EC2), curve `1` (P-256) and 32-byte `x` and `y`; EdDSA needs key type `1` (OKP), curve `6` (Ed25519) and a 32-byte `x`; RS256 needs key type `3` (RSA) and a non-empty modulus `n` and exponent `e`. Fails with `MalformedPublicKey` when the CBOR is invalid, is not a map or a label is missing, has the wrong type or the wrong value, and with `UnsupportedAlgorithm` carrying the `alg` for any other algorithm.
pub fn parse_public_key(cose_key: []u8) -> PublicKey ! Error {
    let key = cbor.decode(cose_key) or fail MalformedPublicKey
    match key {
        Map(_) => {}
        _ => fail MalformedPublicKey
    }
    let alg = integer_label(key, 3)?
    if alg == es256 {
        expect(key, 1, 2)?
        expect(key, -1, 1)?
        let size = ecdsa.scalar_size(ecdsa.Curve.P256)
        let x = sized_label(key, -2, size)?
        let y = sized_label(key, -3, size)?
        let point = ecdsa.uncompressed(ecdsa.Curve.P256, x, y) ?? fail MalformedPublicKey
        return Es256(point)
    }
    if alg == eddsa {
        expect(key, 1, 1)?
        expect(key, -1, 6)?
        let public = sized_label(key, -2, 32)?
        return EdDsa(public)
    }
    if alg == rs256 {
        expect(key, 1, 3)?
        let n = bytes_label(key, -1)?
        let e = bytes_label(key, -2)?
        if n.len == 0 || e.len == 0 {
            fail MalformedPublicKey
        }
        let public = rsa.PublicKey { n: rsa.integer(n), e: rsa.integer(e) }
        return Rs256(public)
    }
    fail UnsupportedAlgorithm(alg)
}

/// Returns whether `signature` is a valid signature of `data` under `key`.
///
/// ES256 verifies a DER encoded ECDSA signature over the SHA-256 of `data`, RS256 a PKCS#1 v1.5 signature over the SHA-256 of `data` and EdDSA a signature over `data` itself. Returns `false`, not an error, for a signature that does not verify.
pub fn verify_signature(key: PublicKey, data: []u8, signature: []u8) -> bool {
    match key {
        Es256(point) => {
            let sha256 = hash.sha256()
            let digest = hash.sum(sha256, data)
            ecdsa.verify(P256, point, digest, signature)
        }
        EdDsa(public) => ed25519.verify(public, data, signature)
        Rs256(public) => {
            let sha256 = hash.sha256()
            let digest = hash.sum(sha256, data)
            rsa.verify_pkcs1v15(public, sha256, digest, signature)
        }
    }
}
