import std/base64
import std/crypto
import std/json

pub enum ResidentKey {
    Discouraged
    Preferred
    Required
}

pub enum UserVerification {
    Discouraged
    Preferred
    Required
}

pub struct Selection {
    pub resident_key: ResidentKey? = none
    pub user_verification: UserVerification = Preferred
}

pub struct RegistrationOptions {
    pub rp_id: str
    pub rp_name: str
    pub user_name: str
    pub user_id: []u8 = crypto.random(64)
    pub user_display_name: str = ""
    pub challenge: []u8 = crypto.random(64)
    pub timeout: i64 = 60000
    pub exclude_credentials: [][]u8 = []
    pub selection: Selection? = none
    pub algorithms: []i64 = [-8, -7, -257]
}

pub struct AuthenticationOptions {
    pub rp_id: str
    pub challenge: []u8 = crypto.random(64)
    pub timeout: i64 = 60000
    pub allow_credentials: [][]u8 = []
    pub user_verification: UserVerification = Preferred
}

fn text_member(name: str, value: str) -> json.Member {
    json.Member { name, value: json.Value.Str(value) }
}

fn binary_member(name: str, data: []u8) -> json.Member {
    json.Member { name, value: json.Value.Str(base64.encode_url(data)) }
}

fn integer_member(name: str, value: i64) -> json.Member {
    json.Member { name, value: json.Value.Int(value) }
}

fn object_member(name: str, members: []json.Member) -> json.Member {
    json.Member { name, value: json.Value.Object(members) }
}

fn array_member(name: str, items: []json.Value) -> json.Member {
    json.Member { name, value: json.Value.Array(items) }
}

fn descriptors(name: str, ids: [][]u8) -> json.Member {
    var items: []json.Value = []
    for id in ids {
        let descriptor = [binary_member("id", id), text_member("type", "public-key")]
        push(mut items, json.Value.Object(descriptor))
    }
    array_member(name, items)
}

fn resident_key_name(r: ResidentKey) -> str {
    match r {
        Discouraged => "discouraged"
        Preferred => "preferred"
        Required => "required"
    }
}

fn user_verification_name(u: UserVerification) -> str {
    match u {
        Discouraged => "discouraged"
        Preferred => "preferred"
        Required => "required"
    }
}

fn selection_member(s: Selection) -> json.Member {
    var members: []json.Member = []
    var required = false
    match s.resident_key {
        some(r) => {
            push(mut members, text_member("residentKey", resident_key_name(r)))
            required = r == Required
        }
        none => {}
    }
    push(mut members, json.Member { name: "requireResidentKey", value: json.Value.Bool(required) })
    push(mut members, text_member("userVerification", user_verification_name(s.user_verification)))
    object_member("authenticatorSelection", members)
}

pub fn registration_options(o: RegistrationOptions) -> json.Value {
    let display = if o.user_display_name == "" { o.user_name } else { o.user_display_name }
    var params: []json.Value = []
    for alg in o.algorithms {
        let param = [text_member("type", "public-key"), integer_member("alg", alg)]
        push(mut params, json.Value.Object(param))
    }
    let rp = [text_member("name", o.rp_name), text_member("id", o.rp_id)]
    let user = [binary_member("id", o.user_id), text_member("name", o.user_name), text_member("displayName", display)]
    var members = [
        object_member("rp", rp),
        object_member("user", user),
        binary_member("challenge", o.challenge),
        array_member("pubKeyCredParams", params),
        integer_member("timeout", o.timeout),
        descriptors("excludeCredentials", o.exclude_credentials),
    ]
    match o.selection {
        some(s) => push(mut members, selection_member(s))
        none => {}
    }
    push(mut members, text_member("attestation", "none"))
    json.Value.Object(members)
}

pub fn authentication_options(o: AuthenticationOptions) -> json.Value {
    json.Value.Object([
        binary_member("challenge", o.challenge),
        integer_member("timeout", o.timeout),
        text_member("rpId", o.rp_id),
        descriptors("allowCredentials", o.allow_credentials),
        text_member("userVerification", user_verification_name(o.user_verification)),
    ])
}
