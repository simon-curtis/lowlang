import std/serde

struct Build {
    is_map: bool
    entries: []Entry
    items: []Value
    key: str
}

struct Builder {
    frames: []*Build
    result: Value
}

fn deliver(b: *Builder, v: Value) {
    if b.frames.len == 0 {
        b.result = v
        return
    }
    let top = b.frames[b.frames.len - 1]
    if top.is_map {
        push(mut top.entries, Entry { key: Str(top.key), value: v })
    } else {
        push(mut top.items, v)
    }
}

fn open(b: *Builder, is_map: bool, key: str) {
    push(mut b.frames, new(Build { is_map, entries: [], items: [], key }))
}

fn close(b: *Builder) {
    let top = b.frames[b.frames.len - 1]
    truncate(mut b.frames, b.frames.len - 1)
    deliver(b, if top.is_map { Map(top.entries) } else { Array(top.items) })
}

fn set_key(b: *Builder, k: str) {
    b.frames[b.frames.len - 1].key = k
}

fn value_writer(b: *Builder) -> serde.Writer {
    serde.Writer {
        null: fn() { deliver(b, Nil) }
        boolean: fn(v) { deliver(b, Bool(v)) }
        integer: fn(n) { deliver(b, Int(n)) }
        unsigned: fn(n) { deliver(b, unsigned_value(n)) }
        float: fn(x) { deliver(b, Double(x)) }
        text: fn(s) { deliver(b, Str(s)) }
        binary: fn(data) { deliver(b, Bin(data)) }
        begin_seq: fn(n) { open(b, false, "") }
        end_seq: fn() { close(b) }
        begin_map: fn(n) { open(b, true, "") }
        key: fn(k) { set_key(b, k) }
        end_map: fn() { close(b) }
        begin_struct: fn(name, n) { open(b, true, "") }
        field: fn(name) { set_key(b, name) }
        end_struct: fn() { close(b) }
        unit_variant: fn(e, v) { deliver(b, Str(v)) }
        begin_variant: fn(e, v, n) { open(b, true, v) }
        end_variant: fn() { close(b) }
    }
}

/// Converts the `Value` `v` into a `T` through `std/serde`.
///
/// Struct fields are read from `Str` map keys, and `Int`, `Uint` and `Bool` keys are accepted as text for maps with integer or boolean keys. A float may be read from `Single`, `Double`, `Int` or `Uint`. An unsigned type may be read from a non-negative `Int`, while a `Uint` fails with `Range` when read as signed. A `[]u8` is read from `Bin` and a `str` from `Str`. An enum variant is a `Str` for a variant without fields, or a map with one entry that names the variant. Fails with `serde.Error.Mismatch` when a value has another type, with `Range`, `Missing` and `UnknownVariant` as `serde.read` describes, and with `Syntax` when the value has nothing to read. `Timestamp` and `Ext` values cannot be read into a type and fail with `Mismatch`. In errors, `at` counts the values consumed so far.
pub fn from_value[T](v: Value) -> T ! serde.Error {
    let c = new(Cursor { pending: v, frames: [], count: 0 })
    serde.read(value_reader(c))
}

/// Converts `v` into a `Value` through `std/serde`.
///
/// Structs and maps become `Map` with `Str` keys, slices become `Array`, `[]u8` becomes `Bin`, optionals become `Nil` or the value, and floats become `Double`. Integers become `Int`, except that a `u64` above `9223372036854775807` becomes `Uint`. An enum variant without fields becomes a `Str` and a variant with fields a one-entry `Map` from its name to a `Map` of its labelled fields or an `Array` of its positional ones.
pub fn to_value[T](v: T) -> Value {
    let b = new(Builder { frames: [], result: Nil })
    serde.write(v, value_writer(b))
    b.result
}

/// Encodes `v` as MessagePack bytes.
///
/// Equivalent to `encode(to_value(v))`.
pub fn serialize[T](v: T) -> []u8 {
    encode(to_value(v))
}

struct Frame {
    items: []Value
    entries: []Entry
    index: i64
}

struct Cursor {
    pending: Value?
    frames: []*Frame
    count: i64
}

fn take(c: *Cursor) -> Value ! serde.Error {
    match c.pending {
        some(v) => {
            c.pending = none
            c.count += 1
            v
        }
        none => fail serde.Error.Syntax(c.count, "no value to read")
    }
}

fn peek(c: *Cursor) -> Value ! serde.Error {
    match c.pending {
        some(v) => v
        none => fail serde.Error.Syntax(c.count, "no value to read")
    }
}

fn mismatch(c: *Cursor, what: str) -> serde.Error {
    serde.Error.Mismatch(what, c.count)
}

fn top_frame(c: *Cursor) -> *Frame ! serde.Error {
    if c.frames.len == 0 {
        fail serde.Error.Syntax(c.count, "no open array or map")
    }
    c.frames[c.frames.len - 1]
}

fn pop_frame(c: *Cursor) {
    truncate(mut c.frames, c.frames.len - 1)
}

fn key_text(c: *Cursor, key: Value) -> str ! serde.Error {
    match key {
        Str(s) => s
        Int(n) => "{n}"
        Uint(n) => "{n}"
        Bool(b) => if b { "true" } else { "false" }
        _ => fail mismatch(c, "text or integer map key")
    }
}

fn signed_value(c: *Cursor, v: Value) -> i64 ! serde.Error {
    match v {
        Int(n) => n
        Uint(_) => fail serde.Error.Range(c.count)
        _ => fail mismatch(c, "integer")
    }
}

fn value_reader(c: *Cursor) -> serde.Reader {
    serde.Reader {
        null: fn() -> bool ! serde.Error {
            match peek(c)? {
                Nil => {
                    take(c)?
                    true
                }
                _ => false
            }
        }
        boolean: fn() -> bool ! serde.Error {
            match take(c)? {
                Bool(b) => b
                _ => fail mismatch(c, "bool")
            }
        }
        integer: fn() -> i64 ! serde.Error {
            let v = take(c)?
            signed_value(c, v)
        }
        unsigned: fn() -> u64 ! serde.Error {
            match take(c)? {
                Int(n) => {
                    if n < 0 {
                        fail serde.Error.Range(c.count)
                    }
                    u64(n)
                }
                Uint(n) => n
                _ => fail mismatch(c, "unsigned integer")
            }
        }
        float: fn() -> f64 ! serde.Error {
            match take(c)? {
                Double(x) => x
                Single(x) => f64(x)
                Int(n) => f64(n)
                Uint(n) => f64(n)
                _ => fail mismatch(c, "float")
            }
        }
        text: fn() -> str ! serde.Error {
            match take(c)? {
                Str(s) => s
                _ => fail mismatch(c, "text")
            }
        }
        binary: fn() -> []u8 ! serde.Error {
            match take(c)? {
                Bin(data) => data
                _ => fail mismatch(c, "bytes")
            }
        }
        begin_seq: fn() ! serde.Error {
            match take(c)? {
                Array(items) => push(mut c.frames, new(Frame { items, entries: [], index: 0 }))
                _ => fail mismatch(c, "array")
            }
        }
        next_element: fn() -> bool ! serde.Error {
            let f = top_frame(c)?
            if f.index >= f.items.len {
                pop_frame(c)
                return false
            }
            c.pending = f.items[f.index]
            f.index += 1
            true
        }
        begin_map: fn() ! serde.Error {
            match take(c)? {
                Map(entries) => push(mut c.frames, new(Frame { items: [], entries, index: 0 }))
                _ => fail mismatch(c, "map")
            }
        }
        next_key: fn() -> str? ! serde.Error {
            let f = top_frame(c)?
            if f.index >= f.entries.len {
                pop_frame(c)
                return none
            }
            let e = f.entries[f.index]
            f.index += 1
            c.pending = e.value
            key_text(c, e.key)?
        }
        begin_variant: fn() -> str ! serde.Error {
            match take(c)? {
                Str(name) => name
                Map(entries) => {
                    if entries.len != 1 {
                        fail mismatch(c, "map with one key naming the variant")
                    }
                    c.pending = entries[0].value
                    key_text(c, entries[0].key)?
                }
                _ => fail mismatch(c, "variant")
            }
        }
        end_variant: fn() ! serde.Error {}
        skip: fn() ! serde.Error {
            take(c)?
        }
        position: fn() -> i64 { c.count }
    }
}

/// Decodes MessagePack `data` into a `T`.
///
/// Equivalent to `decode` followed by `from_value`, with the default `Options`. A decoding error becomes `serde.Error.Syntax` carrying the byte offset and message of the decoding error, except that `TooDeep` becomes `serde.Error.TooDeep`. Fails like `from_value` when the value does not fit `T`.
pub fn deserialize[T](data: []u8) -> T ! serde.Error {
    let v = decode(data) catch {
        TooDeep(_) => fail serde.Error.TooDeep
        e => fail serde.Error.Syntax(offset(e), message(e))
    }
    from_value(v)
}
