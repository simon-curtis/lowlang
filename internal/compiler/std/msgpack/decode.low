import std/text
import std/unicode

/// Limits for decoding.
pub struct Options {
    /// The deepest nesting of arrays and maps accepted, counting a top-level array or map as depth `1`. Defaults to `64`.
    pub max_depth: i64 = 64
    /// The largest length that any one string, binary, extension payload, array or map entry count may declare. Defaults to `16777216`. It bounds memory before anything is allocated.
    pub max_length: i64 = 16777216
}

/// A decoded value together with the number of bytes it occupied.
pub struct Item {
    /// The decoded value.
    pub value: Value
    /// The number of bytes of the input that the value used.
    pub length: i64
}

struct Decoder {
    data: []u8
    pos: i64
    options: Options
    depth: i64
}

/// Decodes `data`, which must hold exactly one value, with default `Options`.
///
/// Fails with `Trailing` when bytes follow the value. See `decode_with`.
pub fn decode(data: []u8) -> Value ! Error {
    decode_with(data, Options {})
}

/// Decodes `data`, which must hold exactly one MessagePack value.
///
/// Fails with `Truncated`, `Invalid`, `BadUtf8`, `BadTimestamp`, `TooDeep` or `TooLong` for malformed or over-limit input, and with `Trailing` when bytes follow the value. Strings and binary data are copied, so the result does not alias `data`. A timestamp extension becomes `Timestamp`, other extensions become `Ext`.
pub fn decode_with(data: []u8, options: Options) -> Value ! Error {
    let first = decode_first(data, options)?
    if first.length != data.len {
        fail Trailing(first.length)
    }
    first.value
}

/// Decodes the value at the start of `data` and reports its size, ignoring any bytes after it.
///
/// Use it to read a stream of back-to-back values by advancing `data` by `Item.length`. Fails like `decode_with` except that it never returns `Trailing`.
pub fn decode_first(data: []u8, options: Options) -> Item ! Error {
    let d = new(Decoder { data, pos: 0, options, depth: 0 })
    let value = item(d)?
    Item { value, length: d.pos }
}

fn remaining(d: *Decoder) -> i64 {
    d.data.len - d.pos
}

fn need(d: *Decoder, n: i64) ! Error {
    if n > remaining(d) {
        fail Truncated(d.pos)
    }
}

fn read_unsigned(d: *Decoder, size: i64) -> u64 ! Error {
    need(d, size)?
    var n: u64 = 0
    for i in 0..size {
        n = n << 8 | u64(d.data[d.pos + i])
    }
    d.pos += size
    n
}

fn sign_extend(n: u64, size: i64) -> i64 {
    let bits = u64(8 * size)
    if size == 8 || n < u64(1) << (bits - 1) {
        return i64(n)
    }
    i64(n) - (i64(1) << i64(bits))
}

fn count(d: *Decoder, at: i64, n: u64, width: i64) -> i64 ! Error {
    if n > u64(d.options.max_length) {
        fail TooLong(at)
    }
    if i64(n) > remaining(d) / width {
        fail Truncated(d.data.len)
    }
    i64(n)
}

fn enter(d: *Decoder, at: i64) ! Error {
    d.depth += 1
    if d.depth > d.options.max_depth {
        fail TooDeep(at)
    }
}

fn item(d: *Decoder) -> Value ! Error {
    let at = d.pos
    need(d, 1)?
    let b = d.data[d.pos]
    d.pos += 1
    if b < 0x80 {
        return Int(i64(b))
    }
    if b >= 0xE0 {
        return Int(i64(b) - 256)
    }
    if b <= 0x8F {
        return map(d, at, u64(b & 0x0F))
    }
    if b <= 0x9F {
        return array(d, at, u64(b & 0x0F))
    }
    if b <= 0xBF {
        return string(d, at, u64(b & 0x1F))
    }
    tagged(d, at, b)
}

fn sized(d: *Decoder, b: u8, first: u8) -> u64 ! Error {
    read_unsigned(d, i64(1) << i64(b - first))
}

fn tagged(d: *Decoder, at: i64, b: u8) -> Value ! Error {
    match b {
        == 0xC0 => Nil
        == 0xC1 => fail Invalid(at)
        == 0xC2 => Bool(false)
        == 0xC3 => Bool(true)
        <= 0xC6 => {
            let n = sized(d, b, 0xC4)?
            Bin(payload(d, at, n)?)
        }
        <= 0xC9 => {
            let n = sized(d, b, 0xC7)?
            extension(d, at, n)?
        }
        == 0xCA => {
            let bits = read_unsigned(d, 4)?
            Single(single_of(u32(bits)))
        }
        == 0xCB => {
            let bits = read_unsigned(d, 8)?
            Double(text.float_from_bits(bits))
        }
        <= 0xCF => unsigned_value(sized(d, b, 0xCC)?)
        <= 0xD3 => {
            let size = i64(1) << i64(b - 0xD0)
            let n = read_unsigned(d, size)?
            Int(sign_extend(n, size))
        }
        <= 0xD8 => extension(d, at, u64(1) << u64(b - 0xD4))?
        <= 0xDB => {
            let n = sized(d, b, 0xD9)?
            string(d, at, n)?
        }
        <= 0xDD => {
            let n = sized(d, b, 0xDB)?
            array(d, at, n)?
        }
        _ => {
            let n = sized(d, b, 0xDD)?
            map(d, at, n)?
        }
    }
}

fn unsigned_value(n: u64) -> Value {
    if n > 0x7FFFFFFFFFFFFFFF {
        return Uint(n)
    }
    Int(i64(n))
}

fn single_of(bits: u32) -> f32 {
    let cell: []u32 = [bits]
    let raw: ptr = __slice_ptr(cell)
    let typed: ptr[f32] = raw
    load(typed)
}

fn payload(d: *Decoder, at: i64, n: u64) -> []u8 ! Error {
    let size = count(d, at, n, 1)?
    let out: []u8 = __make(size)
    __memmove(out, d.data[d.pos..d.pos + size])
    d.pos += size
    out
}

fn string(d: *Decoder, at: i64, n: u64) -> Value ! Error {
    let raw = payload(d, at, n)?
    let value = __str_view(raw)
    if !unicode.utf8_valid(value) {
        fail BadUtf8(at)
    }
    Str(value)
}

fn extension(d: *Decoder, at: i64, n: u64) -> Value ! Error {
    let type_byte = read_unsigned(d, 1)?
    let kind = sign_extend(type_byte, 1)
    let data = payload(d, at, n)?
    if kind == -1 {
        return timestamp(data, at)?
    }
    Ext(kind, data)
}

fn word_at(data: []u8, from: i64, size: i64) -> u64 {
    var n: u64 = 0
    for i in 0..size {
        n = n << 8 | u64(data[from + i])
    }
    n
}

fn timestamp(data: []u8, at: i64) -> Value ! Error {
    if data.len == 4 {
        return Timestamp(i64(word_at(data, 0, 4)), 0)
    }
    if data.len == 8 {
        let packed = word_at(data, 0, 8)
        let nanoseconds = i64(packed >> 34)
        if nanoseconds > 999999999 {
            fail BadTimestamp(at)
        }
        return Timestamp(i64(packed & 0x3FFFFFFFF), nanoseconds)
    }
    if data.len != 12 {
        fail BadTimestamp(at)
    }
    let nanoseconds = i64(word_at(data, 0, 4))
    if nanoseconds > 999999999 {
        fail BadTimestamp(at)
    }
    Timestamp(i64(word_at(data, 4, 8)), nanoseconds)
}

fn array(d: *Decoder, at: i64, n: u64) -> Value ! Error {
    let size = count(d, at, n, 1)?
    enter(d, at)?
    var items: []Value = []
    for _ in 0..size {
        push(mut items, item(d)?)
    }
    d.depth -= 1
    Array(items)
}

fn map(d: *Decoder, at: i64, n: u64) -> Value ! Error {
    let size = count(d, at, n, 2)?
    enter(d, at)?
    var entries: []Entry = []
    for _ in 0..size {
        let key = item(d)?
        let value = item(d)?
        push(mut entries, Entry { key, value })
    }
    d.depth -= 1
    Map(entries)
}

