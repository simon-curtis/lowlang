import std/text

pub fn encode(v: Value) -> []u8 {
    var out: []u8 = []
    write(mut out, v)
    out
}

fn big_endian(mut out: []u8, n: u64, size: i64) {
    for i in 0..size {
        push(mut out, u8(n >> u64(8 * (size - 1 - i))))
    }
}

fn append_bytes(mut out: []u8, data: []u8) {
    for b in data {
        push(mut out, b)
    }
}

fn write_unsigned(mut out: []u8, n: u64) {
    if n < 128 {
        push(mut out, u8(n))
    } else if n <= 0xFF {
        push(mut out, 0xCC)
        big_endian(mut out, n, 1)
    } else if n <= 0xFFFF {
        push(mut out, 0xCD)
        big_endian(mut out, n, 2)
    } else if n <= 0xFFFFFFFF {
        push(mut out, 0xCE)
        big_endian(mut out, n, 4)
    } else {
        push(mut out, 0xCF)
        big_endian(mut out, n, 8)
    }
}

fn write_negative(mut out: []u8, n: i64) {
    if n >= -32 {
        push(mut out, u8(n))
    } else if n >= -128 {
        push(mut out, 0xD0)
        big_endian(mut out, u64(n), 1)
    } else if n >= -32768 {
        push(mut out, 0xD1)
        big_endian(mut out, u64(n), 2)
    } else if n >= -2147483648 {
        push(mut out, 0xD2)
        big_endian(mut out, u64(n), 4)
    } else {
        push(mut out, 0xD3)
        big_endian(mut out, u64(n), 8)
    }
}

fn write_integer(mut out: []u8, n: i64) {
    if n < 0 {
        write_negative(mut out, n)
    } else {
        write_unsigned(mut out, u64(n))
    }
}

fn write_length(mut out: []u8, n: i64, fix: u8, limit: i64, first: u8) {
    if n < limit {
        push(mut out, fix | u8(n))
    } else if n <= 0xFFFF {
        push(mut out, first)
        big_endian(mut out, u64(n), 2)
    } else {
        push(mut out, first + 1)
        big_endian(mut out, u64(n), 4)
    }
}

fn write_string(mut out: []u8, s: str) {
    if s.len < 32 {
        push(mut out, 0xA0 | u8(s.len))
    } else if s.len <= 0xFF {
        push(mut out, 0xD9)
        big_endian(mut out, u64(s.len), 1)
    } else if s.len <= 0xFFFF {
        push(mut out, 0xDA)
        big_endian(mut out, u64(s.len), 2)
    } else {
        push(mut out, 0xDB)
        big_endian(mut out, u64(s.len), 4)
    }
    text.append(mut out, s)
}

fn write_binary(mut out: []u8, data: []u8) {
    if data.len <= 0xFF {
        push(mut out, 0xC4)
        big_endian(mut out, u64(data.len), 1)
    } else if data.len <= 0xFFFF {
        push(mut out, 0xC5)
        big_endian(mut out, u64(data.len), 2)
    } else {
        push(mut out, 0xC6)
        big_endian(mut out, u64(data.len), 4)
    }
    append_bytes(mut out, data)
}

fn write_extension(mut out: []u8, kind: i64, data: []u8) {
    let n = data.len
    if n == 1 || n == 2 || n == 4 || n == 8 || n == 16 {
        var shift = 0
        for i64(1) << shift < n {
            shift += 1
        }
        push(mut out, u8(0xD4 + shift))
    } else if n <= 0xFF {
        push(mut out, 0xC7)
        big_endian(mut out, u64(n), 1)
    } else if n <= 0xFFFF {
        push(mut out, 0xC8)
        big_endian(mut out, u64(n), 2)
    } else {
        push(mut out, 0xC9)
        big_endian(mut out, u64(n), 4)
    }
    push(mut out, u8(kind))
    append_bytes(mut out, data)
}

fn write_timestamp(mut out: []u8, seconds: i64, nanoseconds: i64) {
    var s = seconds
    var n = nanoseconds
    if n < 0 || n > 999999999 {
        var carry = n / 1000000000
        n = n % 1000000000
        if n < 0 {
            n += 1000000000
            carry -= 1
        }
        s += carry
    }
    if n == 0 && s >= 0 && s <= 0xFFFFFFFF {
        push(mut out, 0xD6)
        push(mut out, 0xFF)
        big_endian(mut out, u64(s), 4)
    } else if s >= 0 && s < i64(1) << 34 {
        push(mut out, 0xD7)
        push(mut out, 0xFF)
        big_endian(mut out, u64(n) << 34 | u64(s), 8)
    } else {
        push(mut out, 0xC7)
        push(mut out, 12)
        push(mut out, 0xFF)
        big_endian(mut out, u64(n), 4)
        big_endian(mut out, u64(s), 8)
    }
}

fn write(mut out: []u8, v: Value) {
    match v {
        Nil => push(mut out, 0xC0)
        Bool(b) => push(mut out, if b { 0xC3 } else { 0xC2 })
        Int(n) => write_integer(mut out, n)
        Uint(n) => write_unsigned(mut out, n)
        Single(x) => {
            push(mut out, 0xCA)
            big_endian(mut out, u64(__bits(x)), 4)
        }
        Double(x) => {
            push(mut out, 0xCB)
            big_endian(mut out, text.float_bits(x), 8)
        }
        Str(s) => write_string(mut out, s)
        Bin(data) => write_binary(mut out, data)
        Array(items) => {
            write_length(mut out, items.len, 0x90, 16, 0xDC)
            for item in items {
                write(mut out, item)
            }
        }
        Map(entries) => {
            write_length(mut out, entries.len, 0x80, 16, 0xDE)
            for e in entries {
                write(mut out, e.key)
                write(mut out, e.value)
            }
        }
        Ext(kind, data) => write_extension(mut out, kind, data)
        Timestamp(seconds, nanoseconds) => write_timestamp(mut out, seconds, nanoseconds)
    }
}
