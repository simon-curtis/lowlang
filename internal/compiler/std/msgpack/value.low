import std/text

pub enum Value {
    Nil
    Bool(value: bool)
    Int(value: i64)
    Uint(value: u64)
    Single(value: f32)
    Double(value: f64)
    Str(value: str)
    Bin(data: []u8)
    Array(items: []Value)
    Map(entries: []Entry)
    Ext(kind: i64, data: []u8)
    Timestamp(seconds: i64, nanoseconds: i64)
}

pub struct Entry {
    pub key: Value
    pub value: Value
}

pub enum Error {
    Truncated(at: i64)
    Invalid(at: i64)
    BadUtf8(at: i64)
    BadTimestamp(at: i64)
    TooDeep(at: i64)
    TooLong(at: i64)
    Trailing(at: i64)
}

pub fn offset(e: Error) -> i64 {
    match e {
        Truncated(at) => at
        Invalid(at) => at
        BadUtf8(at) => at
        BadTimestamp(at) => at
        TooDeep(at) => at
        TooLong(at) => at
        Trailing(at) => at
    }
}

pub fn message(e: Error) -> str {
    let at = offset(e)
    match e {
        Truncated(_) => "truncated MessagePack at offset {at}"
        Invalid(_) => "invalid MessagePack format byte at offset {at}"
        BadUtf8(_) => "invalid UTF-8 in MessagePack string at offset {at}"
        BadTimestamp(_) => "invalid MessagePack timestamp at offset {at}"
        TooDeep(_) => "MessagePack nesting too deep at offset {at}"
        TooLong(_) => "MessagePack length over the limit at offset {at}"
        Trailing(_) => "trailing bytes after MessagePack value at offset {at}"
    }
}

pub fn as_integer(v: Value) -> i64? {
    match v {
        Int(n) => n
        Uint(n) => if n > 0x7FFFFFFFFFFFFFFF { none } else { i64(n) }
        _ => none
    }
}

pub fn get(v: Value, key: str) -> Value? {
    match v {
        Map(entries) => {
            var found: Value? = none
            for e in entries {
                match e.key {
                    Str(k) => if k == key { found = e.value }
                    _ => {}
                }
            }
            found
        }
        _ => none
    }
}

pub fn diagnostic(v: Value) -> str {
    var out: []u8 = []
    describe(mut out, v)
    __str_view(out)
}

fn describe(mut out: []u8, v: Value) {
    match v {
        Nil => text.append(mut out, "nil")
        Bool(b) => text.append(mut out, if b { "true" } else { "false" })
        Int(n) => text.append(mut out, "{n}")
        Uint(n) => text.append(mut out, "{n}")
        Single(x) => text.append(mut out, "{float_text(f64(x))}f")
        Double(x) => text.append(mut out, float_text(x))
        Str(s) => quote(mut out, s)
        Bin(data) => text.append(mut out, "h'{text.encode_hex(data)}'")
        Array(items) => {
            push(mut out, '[')
            for i, item in items {
                if i > 0 {
                    text.append(mut out, ", ")
                }
                describe(mut out, item)
            }
            push(mut out, ']')
        }
        Map(entries) => {
            push(mut out, '{')
            for i, e in entries {
                if i > 0 {
                    text.append(mut out, ", ")
                }
                describe(mut out, e.key)
                text.append(mut out, ": ")
                describe(mut out, e.value)
            }
            push(mut out, '}')
        }
        Ext(kind, data) => text.append(mut out, "ext({kind}, h'{text.encode_hex(data)}')")
        Timestamp(seconds, nanoseconds) => text.append(mut out, "timestamp({seconds}, {nanoseconds})")
    }
}

fn float_text(x: f64) -> str {
    if x != x {
        return "NaN"
    }
    let bits = text.float_bits(x)
    if bits & 0x7FFFFFFFFFFFFFFF == 0x7FF0000000000000 {
        return if bits >> 63 == 1 { "-Infinity" } else { "Infinity" }
    }
    let plain = "{x}"
    if text.contains(plain, ".") {
        return plain
    }
    let e = text.index_byte(plain, 'e')
    if e < 0 {
        return "{plain}.0"
    }
    "{plain[..e]}.0{plain[e..]}"
}

fn quote(mut out: []u8, s: str) {
    push(mut out, '"')
    for c in s {
        if c == '"' || c == '\\' {
            push(mut out, '\\')
            push(mut out, u8(c))
        } else if c >= 0x20 && c < 0x7F {
            push(mut out, u8(c))
        } else if c >= 0x10000 {
            let v = c - 0x10000
            escape(mut out, 0xD800 + (v >> 10))
            escape(mut out, 0xDC00 + (v & 0x3FF))
        } else {
            escape(mut out, c)
        }
    }
    push(mut out, '"')
}

fn escape(mut out: []u8, unit: u32) {
    text.append(mut out, "\\u{text.pad_left(text.radix(i64(unit), 16), 4, '0')}")
}
