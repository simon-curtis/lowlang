import std/text

/// A MessagePack value (the MessagePack specification).
///
/// `encode` writes each value in its smallest form and `decode` reads every format of the specification.
pub enum Value {
    /// The nil value (`0xC0`).
    Nil
    /// A boolean (`0xC2`, `0xC3`).
    Bool(value: bool)
    /// A signed integer. The decoder produces `Int` for every integer that fits an `i64`, whether it was stored as signed or unsigned.
    Int(value: i64)
    /// An unsigned integer too large for an `i64`. The decoder produces `Uint` only above `9223372036854775807`; `encode` writes any `Uint` in the unsigned formats.
    Uint(value: u64)
    /// A 32-bit float (`float 32`). `encode` writes it as `float 32` and the decoder returns it unchanged.
    Single(value: f32)
    /// A 64-bit float (`float 64`).
    Double(value: f64)
    /// A UTF-8 string (`fixstr`, `str 8`, `str 16`, `str 32`). The decoder rejects invalid UTF-8.
    Str(value: str)
    /// A byte string (`bin 8`, `bin 16`, `bin 32`).
    Bin(data: []u8)
    /// An array (`fixarray`, `array 16`, `array 32`).
    Array(items: []Value)
    /// A map (`fixmap`, `map 16`, `map 32`), kept as entries in order. Keys can be any value and may repeat.
    Map(entries: []Entry)
    /// An extension (`fixext`, `ext 8`, `ext 16`, `ext 32`) with an application `kind` from `-128` to `127` and its payload `data`.
    ///
    /// `kind` `-1` is the timestamp extension, which decodes to `Timestamp` and is never returned as `Ext`. `encode` writes only the low 8 bits of `kind`.
    Ext(kind: i64, data: []u8)
    /// A timestamp extension (type `-1`) as seconds and nanoseconds since the Unix epoch.
    ///
    /// `nanoseconds` is `0` to `999999999`; `encode` carries an out-of-range value into `seconds`. `encode` uses the 32-bit form when the nanoseconds are `0` and the seconds fit in `0` to `4294967295`, the 64-bit form when the seconds are non-negative and below `2^34`, and the 96-bit form otherwise.
    Timestamp(seconds: i64, nanoseconds: i64)
}

/// A key and value pair of a `Map`.
pub struct Entry {
    /// The key. It can be any `Value`.
    pub key: Value
    /// The value for the key.
    pub value: Value
}

/// The error returned when decoding MessagePack fails.
///
/// Every variant carries the byte offset from the start of the input; `offset` reads it back and `message` formats it.
pub enum Error {
    /// The input ends before a value is complete. `at` is the offset where bytes were missing; when a string, binary, array or map declares more elements than remain, it is the length of the input.
    Truncated(at: i64)
    /// The format byte `0xC1`, which the specification never uses, appears at `at`.
    Invalid(at: i64)
    /// A string is not valid UTF-8. `at` is the offset of its format byte.
    BadUtf8(at: i64)
    /// A timestamp extension has a payload that is not 4, 8 or 12 bytes, or holds nanoseconds above `999999999`. `at` is the offset of its format byte.
    BadTimestamp(at: i64)
    /// Arrays and maps nest deeper than `Options.max_depth`. `at` is the offset of the offending array or map.
    TooDeep(at: i64)
    /// A string, binary, extension payload, array or map declares a length over `Options.max_length`. `at` is the offset of its format byte.
    TooLong(at: i64)
    /// Bytes remain after the value. `at` is the offset where they start, which is the length of the value.
    Trailing(at: i64)
}

/// Returns the byte offset that the error refers to.
pub fn offset(e: Error) -> i64 {
    match e {
        Truncated(at) => at
        Invalid(at) => at
        BadUtf8(at) => at
        BadTimestamp(at) => at
        TooDeep(at) => at
        TooLong(at) => at
        Trailing(at) => at
    }
}

/// Returns a one-line description of the error, including the byte offset.
pub fn message(e: Error) -> str {
    let at = offset(e)
    match e {
        Truncated(_) => "truncated MessagePack at offset {at}"
        Invalid(_) => "invalid MessagePack format byte at offset {at}"
        BadUtf8(_) => "invalid UTF-8 in MessagePack string at offset {at}"
        BadTimestamp(_) => "invalid MessagePack timestamp at offset {at}"
        TooDeep(_) => "MessagePack nesting too deep at offset {at}"
        TooLong(_) => "MessagePack length over the limit at offset {at}"
        Trailing(_) => "trailing bytes after MessagePack value at offset {at}"
    }
}

/// Returns the value of an `Int`, or of a `Uint` that fits an `i64`, and `none` for any other value.
pub fn as_integer(v: Value) -> i64? {
    match v {
        Int(n) => n
        Uint(n) => if n > 0x7FFFFFFFFFFFFFFF { none } else { i64(n) }
        _ => none
    }
}

/// Returns the value of the entry whose key is the string `key`, or `none` when `v` is not a `Map` or has no such entry.
///
/// Only string keys are compared. When a key repeats, the last entry wins.
pub fn get(v: Value, key: str) -> Value? {
    match v {
        Map(entries) => {
            var found: Value? = none
            for e in entries {
                match e.key {
                    Str(k) => if k == key { found = e.value }
                    _ => {}
                }
            }
            found
        }
        _ => none
    }
}

/// Returns a one-line text description of `v`, in a notation like JSON that also shows the types JSON lacks.
///
/// Maps print as `{key: value}` with keys of any type, arrays as `[...]`. Strings are quoted, with `\"` and `\\` escaped and every character outside printable ASCII written as `\uXXXX`, using a surrogate pair above `U+FFFF`. Floats print as `NaN`, `Infinity`, `-Infinity` or a decimal that always contains a `.`; a `Single` has an `f` suffix. Other values print as `nil`, `true`, `false`, plain integers, `h'hex'` for `Bin`, `ext(kind, h'hex')` and `timestamp(seconds, nanoseconds)`.
pub fn diagnostic(v: Value) -> str {
    var out: []u8 = []
    describe(mut out, v)
    __str_view(out)
}

fn describe(mut out: []u8, v: Value) {
    match v {
        Nil => text.append(mut out, "nil")
        Bool(b) => text.append(mut out, if b { "true" } else { "false" })
        Int(n) => text.append(mut out, "{n}")
        Uint(n) => text.append(mut out, "{n}")
        Single(x) => text.append(mut out, "{float_text(f64(x))}f")
        Double(x) => text.append(mut out, float_text(x))
        Str(s) => quote(mut out, s)
        Bin(data) => text.append(mut out, "h'{text.encode_hex(data)}'")
        Array(items) => {
            push(mut out, '[')
            for i, item in items {
                if i > 0 {
                    text.append(mut out, ", ")
                }
                describe(mut out, item)
            }
            push(mut out, ']')
        }
        Map(entries) => {
            push(mut out, '{')
            for i, e in entries {
                if i > 0 {
                    text.append(mut out, ", ")
                }
                describe(mut out, e.key)
                text.append(mut out, ": ")
                describe(mut out, e.value)
            }
            push(mut out, '}')
        }
        Ext(kind, data) => text.append(mut out, "ext({kind}, h'{text.encode_hex(data)}')")
        Timestamp(seconds, nanoseconds) => text.append(mut out, "timestamp({seconds}, {nanoseconds})")
    }
}

fn float_text(x: f64) -> str {
    if x != x {
        return "NaN"
    }
    let bits = text.float_bits(x)
    if bits & 0x7FFFFFFFFFFFFFFF == 0x7FF0000000000000 {
        return if bits >> 63 == 1 { "-Infinity" } else { "Infinity" }
    }
    let plain = "{x}"
    if text.contains(plain, ".") {
        return plain
    }
    let e = text.index_byte(plain, 'e')
    if e < 0 {
        return "{plain}.0"
    }
    "{plain[..e]}.0{plain[e..]}"
}

fn quote(mut out: []u8, s: str) {
    push(mut out, '"')
    for c in s {
        if c == '"' || c == '\\' {
            push(mut out, '\\')
            push(mut out, u8(c))
        } else if c >= 0x20 && c < 0x7F {
            push(mut out, u8(c))
        } else if c >= 0x10000 {
            let v = c - 0x10000
            escape(mut out, 0xD800 + (v >> 10))
            escape(mut out, 0xDC00 + (v & 0x3FF))
        } else {
            escape(mut out, c)
        }
    }
    push(mut out, '"')
}

fn escape(mut out: []u8, unit: u32) {
    text.append(mut out, "\\u{text.pad_left(text.radix(i64(unit), 16), 4, '0')}")
}
