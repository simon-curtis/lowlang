import std/msgpack
import std/text

fn drain(buffer: []u8) -> []u8 {
    var rest = buffer
    for rest.len > 0 {
        let item = msgpack.decode_first(rest, msgpack.Options {}) catch {
            Truncated(at) => {
                print("incomplete value, waiting for more after offset {at}")
                return rest
            }
            e => {
                print(msgpack.message(e))
                return []
            }
        }
        print(msgpack.diagnostic(item.value))
        rest = rest[item.length..]
    }
    rest
}

/// Reads back-to-back values from a buffer that fills in two chunks, including a timestamp, an extension and a value split across the chunks.
fn main() {
    let stamp = msgpack.Value.Timestamp(1700000000, 500)
    let ext = msgpack.Value.Ext(7, [0xCA, 0xFE])
    let reading = msgpack.Value.Map([
        msgpack.Entry { key: msgpack.Value.Str("temp"), value: msgpack.Value.Single(21.5) },
        msgpack.Entry { key: msgpack.Value.Str("at"), value: stamp },
        msgpack.Entry { key: msgpack.Value.Str("blob"), value: msgpack.Value.Bin([1, 2, 3]) },
    ])

    var wire: []u8 = []
    for v in [msgpack.Value.Nil, msgpack.Value.Int(-33), ext, reading] {
        let part = msgpack.encode(v)
        for b in part {
            push(mut wire, b)
        }
    }
    print("{wire.len} bytes: {text.encode_hex(wire)}")

    let cut = wire.len - 6
    var pending: []u8 = []
    for b in wire[..cut] {
        push(mut pending, b)
    }
    pending = drain(pending)
    for b in wire[cut..] {
        push(mut pending, b)
    }
    pending = drain(pending)
    print("{pending.len} bytes left")

    let single = msgpack.decode(wire[..2]) catch {
        e => {
            print(msgpack.message(e))
            return
        }
    }
    print(msgpack.diagnostic(single))
}
