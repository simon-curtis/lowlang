import std/text

pub enum Error {
    Unknown(name: str)
    Missing(name: str)
    Invalid(name: str, value: str)
}

pub struct Spec {
    pub name: str
    pub help: str = ""
    pub boolean: bool = false
    pub fallback: str = ""
}

pub struct Parsed {
    values: [str: str] = [:]
    pub rest: []str = []
}

fn find(specs: []Spec, name: str) -> Spec? {
    for s in specs {
        if s.name == name {
            return s
        }
    }
    none
}

pub fn parse(specs: []Spec, args: []str) -> Parsed ! Error {
    var values: [str: str] = [:]
    for s in specs {
        values[s.name] = s.fallback
    }
    var rest: []str = []
    var i = 0
    for i < args.len {
        let arg = args[i]
        i += 1
        if arg == "--" {
            for j in i..args.len {
                push(mut rest, args[j])
            }
            break
        }
        if !text.starts_with(arg, "-") || arg == "-" {
            push(mut rest, arg)
            continue
        }
        var name = text.trim_prefix(text.trim_prefix(arg, "-"), "-")
        var value = ""
        var inline = false
        let eq = text.index_byte(name, '=')
        if eq >= 0 {
            value = name[eq + 1..]
            name = name[..eq]
            inline = true
        }
        let spec = find(specs, name) ?? fail Unknown(name)
        if spec.boolean {
            if !inline {
                value = "true"
            }
            if value != "true" && value != "false" {
                fail Invalid(name, value)
            }
        } else if !inline {
            if i >= args.len {
                fail Missing(name)
            }
            value = args[i]
            i += 1
        }
        values[name] = value
    }
    Parsed { values: values, rest: rest }
}

pub fn get(p: Parsed, name: str) -> str {
    p.values[name] ?? ""
}

pub fn enabled(p: Parsed, name: str) -> bool {
    get(p, name) == "true"
}

pub fn number(p: Parsed, name: str) -> i64 ! Error {
    let raw = get(p, name)
    text.parse_int(raw) catch {
        _ => fail Invalid(name, raw)
    }
}

pub fn usage(specs: []Spec) -> str {
    var out: []u8 = []
    for s in specs {
        text.append(mut out, "  --{s.name}")
        if !s.boolean {
            text.append(mut out, " value")
        }
        if s.help.len > 0 {
            text.append(mut out, "  {s.help}")
        }
        if s.fallback.len > 0 && !s.boolean {
            text.append(mut out, " (default {s.fallback})")
        }
        push(mut out, '\n')
    }
    str(out)
}
