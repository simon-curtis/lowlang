import std/flag

fn specs() -> []flag.Spec {
    [
        flag.Spec { name: "port", help: "port to listen on", fallback: "8080" }
        flag.Spec { name: "host", help: "address to bind", fallback: "localhost" }
        flag.Spec { name: "verbose", help: "log every request", boolean: true }
        flag.Spec { name: "workers", help: "number of workers", fallback: "1" }
    ]
}

fn summary(args: []str) -> str ! flag.Error {
    let parsed = flag.parse(specs(), args)?
    let port = flag.number(parsed, "port")?
    let workers = flag.number(parsed, "workers")?
    "{flag.get(parsed, "host")}:{port} workers={workers} verbose={flag.enabled(parsed, "verbose")} files={parsed.rest}"
}

fn run(args: []str) {
    let line = summary(args) catch {
        Unknown(name) => "error: unknown flag --{name}"
        Missing(name) => "error: --{name} needs a value"
        Invalid(name, value) => "error: --{name} does not accept \"{value}\""
    }
    print(line)
}

/// Parses fixed argument lists against a flag table, covering defaults, both value forms, switches, positional arguments, `--` and every error.
fn main() {
    print("usage:")
    print(flag.usage(specs()))

    run([])
    run(["--port", "9090", "--host=0.0.0.0", "--verbose", "a.txt", "b.txt"])
    run(["-workers=4", "serve", "--verbose=false", "--", "--port"])
    run(["--port=abc"])
    run(["--workers", "x"])
    run(["--tls"])
    run(["--host"])
    run(["--verbose=maybe"])
}
