import std/base64
import std/text

fn hex_digits() -> str {
    "0123456789ABCDEF"
}

fn utf8_length(lead: u8) -> i64 {
    if lead >= 0xF0 {
        return 4
    }
    if lead >= 0xE0 {
        return 3
    }
    if lead >= 0xC0 {
        return 2
    }
    1
}

fn word_capacity(available: i64) -> i64 {
    let raw = (available - 12) / 4 * 3
    if raw < 4 { 4 } else { raw }
}

fn encoded_word(chunk: str) -> str {
    "=?utf-8?b?{base64.encode(bytes(chunk))}?="
}

fn plain(s: str) -> bool {
    for c in s {
        if c < 32 && c != '\t' || c > 126 {
            return false
        }
    }
    true
}

pub fn encode_words(s: str, used: i64) -> str {
    var words: []str = []
    var capacity = word_capacity(76 - used)
    var start = 0
    var i = 0
    for i < s.len {
        var n = utf8_length(s[i])
        if i + n > s.len {
            n = s.len - i
        }
        if i + n - start > capacity && i > start {
            push(mut words, encoded_word(s[start..i]))
            start = i
            capacity = word_capacity(75)
        }
        i += n
    }
    if start < s.len {
        push(mut words, encoded_word(s[start..]))
    }
    text.join(words, "\r\n ")
}

fn fold(used: i64, value: str) -> str {
    var out: []u8 = []
    var column = used
    var first = true
    for word in text.split(value, ' ') {
        if first {
            text.append(mut out, word)
            column += word.len
            first = false
            continue
        }
        if column + 1 + word.len > 76 {
            text.append(mut out, "\r\n ")
            column = 1
        } else {
            push(mut out, ' ')
            column += 1
        }
        text.append(mut out, word)
        column += word.len
    }
    __str_view(out)
}

fn fold_list(used: i64, items: []str) -> str {
    var out: []u8 = []
    var column = used
    for i, item in items {
        let last = i == items.len - 1
        let width = if last { item.len } else { item.len + 1 }
        if i > 0 && column + 1 + width > 76 {
            text.append(mut out, "\r\n ")
            column = 1
        } else if i > 0 {
            push(mut out, ' ')
            column += 1
        }
        text.append(mut out, item)
        if !last {
            push(mut out, ',')
        }
        let breaks = text.last_index(item, "\r\n")
        column = if breaks >= 0 { width - breaks - 2 } else { column + width }
    }
    __str_view(out)
}

fn quote_byte(mut out: []u8, c: u8) {
    push(mut out, '=')
    push(mut out, hex_digits()[c >> 4])
    push(mut out, hex_digits()[c & 15])
}

fn literal(c: u8, at_end: bool) -> bool {
    if c == ' ' || c == '\t' {
        return !at_end
    }
    c >= 33 && c <= 126 && c != '='
}

fn encode_line(line: str) -> []u8 {
    var out: []u8 = []
    for i in 0..line.len {
        let c = line[i]
        if literal(c, i == line.len - 1) {
            push(mut out, c)
        } else {
            quote_byte(mut out, c)
        }
    }
    out
}

fn wrap_line(mut out: []u8, encoded: []u8) {
    var column = 0
    var i = 0
    for i < encoded.len {
        let width = if encoded[i] == '=' { 3 } else { 1 }
        let last = i + width == encoded.len
        let limit = if last { 76 } else { 75 }
        if column + width > limit {
            text.append(mut out, "=\r\n")
            column = 0
        }
        __extend(mut out, __str_view(encoded[i..i + width]))
        column += width
        i += width
    }
}

fn split_lines(s: str) -> []str {
    var lines: []str = []
    var start = 0
    var i = 0
    for i < s.len {
        if s[i] == '\n' {
            var stop = i
            if stop > start && s[stop - 1] == '\r' {
                stop -= 1
            }
            push(mut lines, s[start..stop])
            start = i + 1
        }
        i += 1
    }
    push(mut lines, s[start..])
    lines
}

pub fn quoted_printable(s: str) -> str {
    var out: []u8 = []
    let lines = split_lines(s)
    for i, line in lines {
        wrap_line(mut out, encode_line(line))
        if i < lines.len - 1 {
            text.append(mut out, "\r\n")
        }
    }
    __str_view(out)
}

pub fn wrap_base64(data: []u8) -> str {
    let encoded = base64.encode(data)
    var out: []u8 = []
    var at = 0
    for at < encoded.len {
        var stop = at + 76
        if stop > encoded.len {
            stop = encoded.len
        }
        if at > 0 {
            text.append(mut out, "\r\n")
        }
        text.append(mut out, encoded[at..stop])
        at = stop
    }
    __str_view(out)
}

fn normalise_newlines(s: str) -> str {
    text.join(split_lines(s), "\r\n")
}

fn percent_encode(s: str) -> str {
    var out: []u8 = []
    for c in bytes(s) {
        let unreserved = c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9' || c == '-' || c == '.' || c == '_' || c == '~'
        if unreserved {
            push(mut out, c)
        } else {
            push(mut out, '%')
            push(mut out, hex_digits()[c >> 4])
            push(mut out, hex_digits()[c & 15])
        }
    }
    __str_view(out)
}
