import std/crypto
import std/header
import std/text
import std/time/zone
import std/time/zoned
import std/uri

/// An email address with an optional display name.
pub struct Address {
    /// The address in `local@domain` form. `valid_email` defines what is accepted.
    pub email: str
    /// The display name. Empty for a bare address.
    pub name: str = ""
}

/// A file attached to a message.
pub struct Attachment {
    /// The file name offered to the recipient. Non-ASCII names are written with the RFC 2231 `filename*` form.
    pub filename: str
    /// The file content. It is sent base64 encoded.
    pub data: []u8
    /// The media type, which must contain a `/`. Defaults to `application/octet-stream`.
    pub content_type: str = "application/octet-stream"
}

/// An email message.
///
/// `render` turns it into RFC 5322 text and `std/smtp` sends it. A message with both `text` and `html` becomes `multipart/alternative`; any attachments wrap the body in `multipart/mixed`.
pub struct Message {
    /// The sender, shown in the `From` header and used as the SMTP envelope sender.
    pub from: Address
    /// The primary recipients.
    pub to: []Address = []
    /// The copied recipients.
    pub cc: []Address = []
    /// The blind copied recipients. They receive the message but are never written to the rendered headers.
    pub bcc: []Address = []
    /// The addresses replies should go to. The header is omitted when empty.
    pub reply_to: []Address = []
    /// The subject line. The header is omitted when empty.
    pub subject: str = ""
    /// The `Date` header value. When `none`, `render` uses the current time in UTC.
    pub date: zoned.Zoned? = none
    /// The `Message-ID` header value. When empty, `render` generates one from the domain of `from`. Angle brackets are added when missing. It must not contain a space.
    pub message_id: str = ""
    /// The plain text body. Omitted when empty.
    pub text: str = ""
    /// The HTML body. Omitted when empty.
    pub html: str = ""
    /// The files to attach.
    pub attachments: []Attachment = []
    /// Additional header fields, written after `MIME-Version`.
    pub headers: []header.Header = []
    /// The MIME multipart boundary. When empty, `render` generates a random one. It may contain only letters, digits and `-_=.+`. The nested alternative part of a message with attachments uses the boundary with `-alt` appended.
    pub boundary: str = ""
    /// Allows a body to be sent as `8bit` instead of quoted-printable when it is not 7-bit safe (it has non-ASCII text or a line over 78 bytes) but has no control characters and no line over 998 bytes. Set it only when the server advertises `8BITMIME`; `needs_8bit` reports when it applies.
    pub eight_bit: bool = false
}

/// The error type for building and validating messages.
pub enum Error {
    /// `address` is not a valid email address.
    InvalidAddress(address: str)
    /// A value written to the header `header` contains a control character other than tab, which could start a new header line.
    HeaderInjection(header: str)
    /// The header `header` has an invalid name or value: an empty or malformed header name, a boundary with disallowed characters, a content type without a `/` or a message ID containing a space.
    InvalidHeader(header: str)
    /// The message has no `to`, `cc` or `bcc` recipients.
    NoRecipients
    /// The current time could not be read for the `Date` header of a message without a `date`.
    ClockUnavailable
}

/// Returns an `Address` for `email` with no display name. The address is not validated.
pub fn address(email: str) -> Address {
    Address { email }
}

/// Returns an `Address` for `email` with the display name `name`. The address is not validated.
pub fn named(name: str, email: str) -> Address {
    Address { email, name }
}

fn specials() -> str {
    "()<>[]:;@\\,\"\t "
}

fn atom_valid(part: str, longest: i64) -> bool {
    if part.len == 0 || part.len > longest || part[0] == '.' || part[part.len - 1] == '.' {
        return false
    }
    if text.contains(part, "..") {
        return false
    }
    for c in bytes(part) {
        if c < 33 || c == 127 || text.index_byte(specials(), c) >= 0 {
            return false
        }
    }
    true
}

/// Returns whether `s` is a usable email address.
///
/// The text before the last `@` is the local part and must be 1 to 64 bytes; the text after it is the domain and must be 1 to 255 bytes. Neither may start or end with a `.` or contain `..`, spaces, control characters or any of `()<>[]:;@\,"`. Non-ASCII characters are accepted. Quoted local parts and domain literals are not.
pub fn valid_email(s: str) -> bool {
    let at = text.last_index_byte(s, '@')
    if at < 0 {
        return false
    }
    atom_valid(s[..at], 64) && atom_valid(s[at + 1..], 255)
}

fn unescape(s: str) -> str {
    var out: []u8 = []
    var i = 0
    for i < s.len {
        if s[i] == '\\' && i + 1 < s.len {
            i += 1
        }
        push(mut out, s[i])
        i += 1
    }
    __str_view(out)
}

fn display_name(raw: str) -> str {
    let t = text.trim(raw)
    if t.len >= 2 && t[0] == '"' && t[t.len - 1] == '"' {
        return unescape(t[1..t.len - 1])
    }
    t
}

/// Parses `s` as `local@domain` or `Name <local@domain>`.
///
/// Surrounding whitespace is ignored. A display name in double quotes has the quotes removed and backslash escapes resolved. Fails with `InvalidAddress(s)` when the angle brackets are unbalanced or the address is not valid. Comments and groups are not supported.
pub fn parse_address(s: str) -> Address ! Error {
    let t = text.trim(s)
    var email = t
    var name = ""
    if text.ends_with(t, ">") {
        let open = text.last_index_byte(t, '<')
        if open < 0 {
            fail InvalidAddress(s)
        }
        email = text.trim(t[open + 1..t.len - 1])
        name = display_name(t[..open])
    }
    if !valid_email(email) {
        fail InvalidAddress(s)
    }
    Address { email, name }
}

fn check_value(header: str, value: str) ! Error {
    for c in bytes(value) {
        if c < 32 && c != '\t' || c == 127 {
            fail HeaderInjection(header)
        }
    }
}

fn check_name(name: str) ! Error {
    if name.len == 0 {
        fail InvalidHeader(name)
    }
    check_value(name, name)?
    for c in bytes(name) {
        if c <= 32 || c >= 127 || c == ':' {
            fail InvalidHeader(name)
        }
    }
}

fn check_address(header: str, a: Address) ! Error {
    check_value(header, a.email)?
    check_value(header, a.name)?
    if !valid_email(a.email) {
        fail InvalidAddress(a.email)
    }
}

fn check_addresses(header: str, list: []Address) ! Error {
    for a in list {
        check_address(header, a)?
    }
}

fn atext(c: u8) -> bool {
    c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9' || text.index_byte("!#$%&'*+-/=?^_~ ", c) >= 0 || c == 96 || c == '{' || c == '|' || c == '}'
}

fn phrase(name: str) -> str {
    let t = text.trim(name)
    if !text.is_ascii(t) {
        return encoded_phrase(t)
    }
    var bare = true
    for c in bytes(t) {
        if !atext(c) {
            bare = false
        }
    }
    if bare {
        return t
    }
    var out: []u8 = []
    push(mut out, '"')
    for c in bytes(t) {
        if c == '"' || c == '\\' {
            push(mut out, '\\')
        }
        push(mut out, c)
    }
    push(mut out, '"')
    __str_view(out)
}

fn encoded_phrase(name: str) -> str {
    encode_words(name, 8)
}

/// Returns the address as written in a header: the bare email when there is no name, otherwise `name <email>`.
///
/// A name made of plain characters is written as is, one with specials such as commas or quotes is double quoted with backslash escapes, and one with non-ASCII characters becomes encoded words.
pub fn format_address(a: Address) -> str {
    if a.name.len == 0 {
        return a.email
    }
    "{phrase(a.name)} <{a.email}>"
}

fn address_header(name: str, list: []Address) -> str {
    var items: []str = []
    for a in list {
        push(mut items, format_address(a))
    }
    "{name}: {fold_list(name.len + 2, items)}"
}

fn unstructured(name: str, value: str) -> str {
    let used = name.len + 2
    if plain(value) {
        return "{name}: {fold(used, value)}"
    }
    "{name}: {encode_words(value, used)}"
}

fn all_addresses(m: Message) -> []Address {
    var out: []Address = [m.from]
    for a in m.to {
        push(mut out, a)
    }
    for a in m.cc {
        push(mut out, a)
    }
    for a in m.bcc {
        push(mut out, a)
    }
    for a in m.reply_to {
        push(mut out, a)
    }
    out
}

/// Returns whether any address of the message (`from`, `to`, `cc`, `bcc` or `reply_to`) contains non-ASCII characters, which requires the SMTP `SMTPUTF8` extension.
pub fn needs_utf8(m: Message) -> bool {
    for a in all_addresses(m) {
        if !text.is_ascii(a.email) {
            return true
        }
    }
    false
}

fn seven_bit(body: str) -> bool {
    for line in text.split_str(body, "\r\n") {
        if line.len > 78 || !plain(line) {
            return false
        }
    }
    true
}

fn eight_bit_safe(body: str) -> bool {
    for line in text.split_str(body, "\r\n") {
        if line.len > 998 {
            return false
        }
        for c in bytes(line) {
            if c < 32 && c != '\t' || c == 127 {
                return false
            }
        }
    }
    true
}

fn transfer(body: str, eight_bit: bool) -> str {
    let normal = normalise_newlines(body)
    if seven_bit(normal) {
        return "7bit"
    }
    if eight_bit && eight_bit_safe(normal) {
        return "8bit"
    }
    "quoted-printable"
}

fn encoded_body(body: str, encoding: str) -> str {
    if encoding == "quoted-printable" {
        return quoted_printable(body)
    }
    normalise_newlines(body)
}

/// Returns whether `render` would send the text or HTML body with the `8bit` transfer encoding, which requires the SMTP `8BITMIME` extension.
///
/// This is the case only when `eight_bit` is set and the body is not already 7-bit safe.
pub fn needs_8bit(m: Message) -> bool {
    if m.text.len > 0 && transfer(m.text, m.eight_bit) == "8bit" {
        return true
    }
    m.html.len > 0 && transfer(m.html, m.eight_bit) == "8bit"
}

/// Returns the envelope recipients of the message: the addresses of `to`, `cc` and `bcc` in that order, with duplicates removed ignoring case.
///
/// Fails with `InvalidAddress` or `HeaderInjection` for the first bad address and with `NoRecipients` when the list would be empty.
pub fn recipients(m: Message) -> []str ! Error {
    var out: []str = []
    var seen: [str: bool] = [:]
    var all: []Address = []
    for a in m.to {
        push(mut all, a)
    }
    for a in m.cc {
        push(mut all, a)
    }
    for a in m.bcc {
        push(mut all, a)
    }
    for a in all {
        check_address("Recipient", a)?
        let key = text.lower(a.email)
        match seen[key] {
            some(v) => {}
            none => {
                seen[key] = true
                push(mut out, a.email)
            }
        }
    }
    if out.len == 0 {
        fail NoRecipients
    }
    out
}

/// Returns a new `Message-ID` value of the form `<token@domain>`, where `token` is 24 hexadecimal digits from the system's random source.
pub fn new_message_id(domain: str) -> str {
    let token = text.encode_hex(crypto.random(12))
    "<{token}@{domain}>"
}

fn sender_domain(m: Message) -> str {
    let at = text.last_index_byte(m.from.email, '@')
    if at < 0 { "localhost" } else { m.from.email[at + 1..] }
}

fn bracketed(id: str) -> str {
    if text.starts_with(id, "<") {
        return id
    }
    "<{id}>"
}

fn leaf(subtype: str, body: str, eight_bit: bool) -> str {
    let encoding = transfer(body, eight_bit)
    let encoded = encoded_body(body, encoding)
    "Content-Type: text/{subtype}; charset=utf-8\r\nContent-Transfer-Encoding: {encoding}\r\n\r\n{encoded}"
}

fn disposition(filename: str) -> str {
    if plain(filename) {
        return "Content-Disposition: attachment; filename={header.quote(filename)}"
    }
    "Content-Disposition: attachment; filename*=utf-8''{uri.escape(filename)}"
}

fn attachment_part(a: Attachment) -> str {
    let head = "Content-Type: {a.content_type}\r\nContent-Transfer-Encoding: base64\r\n{disposition(a.filename)}"
    "{head}\r\n\r\n{wrap_base64(a.data)}"
}

fn alternative(m: Message, boundary: str) -> str {
    let plain_part = leaf("plain", m.text, m.eight_bit)
    let html_part = leaf("html", m.html, m.eight_bit)
    "Content-Type: multipart/alternative; boundary=\"{boundary}\"\r\n\r\n--{boundary}\r\n{plain_part}\r\n--{boundary}\r\n{html_part}\r\n--{boundary}--"
}

fn body_part(m: Message, boundary: str) -> str {
    if m.text.len > 0 && m.html.len > 0 {
        return alternative(m, boundary)
    }
    if m.html.len > 0 {
        return leaf("html", m.html, m.eight_bit)
    }
    leaf("plain", m.text, m.eight_bit)
}

fn mixed(m: Message, boundary: str) -> str {
    var parts: []str = []
    if m.text.len > 0 || m.html.len > 0 {
        push(mut parts, body_part(m, "{boundary}-alt"))
    }
    for a in m.attachments {
        push(mut parts, attachment_part(a))
    }
    var out: []u8 = []
    text.append(mut out, "Content-Type: multipart/mixed; boundary=\"{boundary}\"\r\n\r\n")
    for p in parts {
        text.append(mut out, "--{boundary}\r\n{p}\r\n")
    }
    text.append(mut out, "--{boundary}--")
    __str_view(out)
}

fn check_boundary(b: str) ! Error {
    for c in bytes(b) {
        let allowed = c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9' || c == '-' || c == '_' || c == '=' || c == '.' || c == '+'
        if !allowed {
            fail InvalidHeader("boundary")
        }
    }
}

fn validate(m: Message) ! Error {
    check_address("From", m.from)?
    check_addresses("To", m.to)?
    check_addresses("Cc", m.cc)?
    check_addresses("Bcc", m.bcc)?
    check_addresses("Reply-To", m.reply_to)?
    check_value("Subject", m.subject)?
    check_value("Message-ID", m.message_id)?
    check_boundary(m.boundary)?
    for h in m.headers {
        check_name(h.name)?
        check_value(h.name, h.value)?
    }
    for a in m.attachments {
        check_value("Content-Disposition", a.filename)?
        check_value("Content-Type", a.content_type)?
        if a.content_type.len == 0 || text.index_byte(a.content_type, '/') < 0 {
            fail InvalidHeader("Content-Type")
        }
    }
    if m.message_id.len > 0 && text.index_byte(m.message_id, ' ') >= 0 {
        fail InvalidHeader("Message-ID")
    }
}

fn current_date() -> zoned.Zoned ! Error {
    zoned.now(zone.utc()) or fail ClockUnavailable
}

fn date_of(m: Message) -> zoned.Zoned ! Error {
    match m.date {
        some(stamp) => stamp
        none => current_date()?
    }
}

/// Returns the message as RFC 5322 text with `\r\n` line endings, ready to send as SMTP data.
///
/// Headers are written in the order `Date`, `From`, `To`, `Cc`, `Reply-To`, `Subject`, `Message-ID`, `MIME-Version`, then `headers`; `Bcc` is never written. Header values are folded to 76 columns and non-ASCII values are encoded. Bodies use `7bit`, `8bit` or `quoted-printable` as needed, attachments `base64`.
///
/// Fails with `InvalidAddress`, `HeaderInjection` or `InvalidHeader` when a field is invalid. A message without a body or attachments renders an empty plain text body.
pub fn render(m: Message) -> str ! Error {
    validate(m)?
    let stamp = date_of(m)?
    let id = if m.message_id.len > 0 { bracketed(m.message_id) } else { new_message_id(sender_domain(m)) }
    let boundary = if m.boundary.len > 0 { m.boundary } else { "=_{text.encode_hex(crypto.random(12))}" }
    var lines: []str = ["Date: {zoned.to_rfc2822(stamp)}", address_header("From", [m.from])]
    if m.to.len > 0 {
        push(mut lines, address_header("To", m.to))
    }
    if m.cc.len > 0 {
        push(mut lines, address_header("Cc", m.cc))
    }
    if m.reply_to.len > 0 {
        push(mut lines, address_header("Reply-To", m.reply_to))
    }
    if m.subject.len > 0 {
        push(mut lines, unstructured("Subject", m.subject))
    }
    push(mut lines, "Message-ID: {id}")
    push(mut lines, "MIME-Version: 1.0")
    for h in m.headers {
        push(mut lines, unstructured(h.name, h.value))
    }
    let content = if m.attachments.len > 0 { mixed(m, boundary) } else { body_part(m, boundary) }
    let message = "{text.join(lines, "\r\n")}\r\n{content}"
    if text.ends_with(message, "\r\n") {
        return message
    }
    "{message}\r\n"
}
