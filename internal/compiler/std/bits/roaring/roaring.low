/// A compressed bitmap of `u32` values in the Roaring format.
///
/// Values are grouped by their high 16 bits into containers, each stored as a sorted array of up to 4096 values, a bitmap of 65536 bits or a list of runs. Create one with `roaring`. A `Roaring` is used through a pointer. Locating a container costs a binary search over the container keys, so single-value operations take time logarithmic in the number of containers plus the cost inside one container.
pub struct Roaring {
    keys: []u16
    containers: []*Container
    size: i64
    card: i64
}

/// Returns an empty bitmap.
pub fn roaring() -> *Roaring {
    with_capacity(0)
}

fn with_capacity(n: i64) -> *Roaring {
    let keys: []u16 = __make(n)
    let containers: []*Container = __make(n)
    new(Roaring { keys, containers, size: 0, card: 0 })
}

/// Returns a new bitmap with the same values as `r`, sharing no storage with it.
pub fn clone(r: *Roaring) -> *Roaring {
    let out = with_capacity(r.size)
    for i in 0..r.size {
        append(out, i64(r.keys[i]), clone_container(r.containers[i]))
    }
    out
}

fn reserve(r: *Roaring, n: i64) {
    if n <= r.keys.len {
        return
    }
    let size = if r.keys.len * 2 < n { n } else { r.keys.len * 2 }
    let keys: []u16 = __make(size)
    __memmove(keys, r.keys[..r.size])
    let containers: []*Container = __make(size)
    __memmove(containers, r.containers[..r.size])
    r.keys = keys
    r.containers = containers
}

fn append(r: *Roaring, key: i64, c: *Container) {
    reserve(r, r.size + 1)
    r.keys[r.size] = u16(key)
    r.containers[r.size] = c
    r.size += 1
    r.card += c.card
}

fn locate(r: *Roaring, key: i64) -> i64 {
    var lo = 0
    var hi = r.size
    for lo < hi {
        let mid = (lo + hi) >> 1
        let k = i64(r.keys[mid])
        if k < key {
            lo = mid + 1
        } else if k > key {
            hi = mid
        } else {
            return mid
        }
    }
    -lo - 1
}

fn insert_at(r: *Roaring, at: i64, key: i64, c: *Container) {
    reserve(r, r.size + 1)
    __memmove(r.keys[at + 1..r.size + 1], r.keys[at..r.size])
    __memmove(r.containers[at + 1..r.size + 1], r.containers[at..r.size])
    r.keys[at] = u16(key)
    r.containers[at] = c
    r.size += 1
    r.card += c.card
}

fn remove_at(r: *Roaring, at: i64) {
    r.card -= r.containers[at].card
    __memmove(r.keys[at..r.size - 1], r.keys[at + 1..r.size])
    __memmove(r.containers[at..r.size - 1], r.containers[at + 1..r.size])
    r.size -= 1
}

/// Adds `x` to `r`.
///
/// Adding a value that is present changes nothing.
pub fn add(r: *Roaring, x: u32) {
    let key = i64(x >> 16)
    let low = i64(x & 0xFFFF)
    let at = locate(r, key)
    if at < 0 {
        insert_at(r, -at - 1, key, single_container(low))
    } else if container_add(r.containers[at], low) {
        r.card += 1
    }
}

/// Removes `x` from `r`.
///
/// Does nothing when `x` is absent. A container that becomes empty is dropped.
pub fn remove(r: *Roaring, x: u32) {
    let at = locate(r, i64(x >> 16))
    if at < 0 {
        return
    }
    let c = r.containers[at]
    if !container_remove(c, i64(x & 0xFFFF)) {
        return
    }
    r.card -= 1
    if c.card == 0 {
        remove_at(r, at)
    }
}

/// Returns `true` when `x` is in `r`.
pub fn contains(r: *Roaring, x: u32) -> bool {
    let at = locate(r, i64(x >> 16))
    at >= 0 && container_contains(r.containers[at], i64(x & 0xFFFF))
}

/// Returns the number of values in `r` in constant time.
pub fn cardinality(r: *Roaring) -> i64 {
    r.card
}

/// Returns `true` when `r` holds no values.
pub fn is_empty(r: *Roaring) -> bool {
    r.card == 0
}

/// Removes every value from `r`.
pub fn clear(r: *Roaring) {
    *r = *roaring()
}

fn chunk_range(key: i64, first: i64, last: i64, start: i64, end: i64) -> *Container {
    let a = if key == first { start & 0xFFFF } else { 0 }
    let b = if key == last { (end - 1) & 0xFFFF } else { 0xFFFF }
    range_container(a, b)
}

fn merge_range(r: *Roaring, at: i64, range: *Container) {
    let old = r.containers[at]
    let before = old.card
    let merged = container_or(old, range, true)
    r.containers[at] = merged
    r.card += merged.card - before
}

/// Adds every value in the half-open range `lo` to `hi`, excluding `hi`, to `r`.
///
/// The range is clamped to `0` through `2^32`. Does nothing when the clamped range is empty. Whole containers inside the range are made from a single run, so the cost depends on the number of containers touched, not on the number of values.
pub fn add_range(r: *Roaring, lo: i64, hi: i64) {
    let start = if lo < 0 { 0 } else { lo }
    let end = if hi > 1 << 32 { 1 << 32 } else { hi }
    if start >= end {
        return
    }
    let first = start >> 16
    let last = (end - 1) >> 16
    let found = locate(r, first)
    let begin = if found < 0 { -found - 1 } else { found }
    if first == last {
        let range = chunk_range(first, first, last, start, end)
        if found < 0 {
            insert_at(r, begin, first, range)
        } else {
            merge_range(r, begin, range)
        }
        return
    }
    var stop = begin
    for stop < r.size && i64(r.keys[stop]) <= last {
        stop += 1
    }
    let out = with_capacity(r.size - (stop - begin) + last - first + 1)
    for i in 0..begin {
        append(out, i64(r.keys[i]), r.containers[i])
    }
    var j = begin
    for key in first..last + 1 {
        let range = chunk_range(key, first, last, start, end)
        if j < stop && i64(r.keys[j]) == key {
            append(out, key, container_or(r.containers[j], range, true))
            j += 1
        } else {
            append(out, key, range)
        }
    }
    for i in stop..r.size {
        append(out, i64(r.keys[i]), r.containers[i])
    }
    *r = *out
}

/// Removes every value in the half-open range `lo` to `hi`, excluding `hi`, from `r`.
///
/// The range is clamped to `0` through `2^32`. Does nothing when the clamped range is empty.
pub fn remove_range(r: *Roaring, lo: i64, hi: i64) {
    let start = if lo < 0 { 0 } else { lo }
    let end = if hi > 1 << 32 { 1 << 32 } else { hi }
    if start >= end {
        return
    }
    let first = start >> 16
    let last = (end - 1) >> 16
    let found = locate(r, first)
    let begin = if found < 0 { -found - 1 } else { found }
    var read = begin
    var write = begin
    for read < r.size && i64(r.keys[read]) <= last {
        let key = i64(r.keys[read])
        let c = r.containers[read]
        read += 1
        r.card -= c.card
        if key != first && key != last {
            continue
        }
        let rest = container_and_not(c, chunk_range(key, first, last, start, end), true)
        if rest.card > 0 {
            r.keys[write] = u16(key)
            r.containers[write] = rest
            r.card += rest.card
            write += 1
        }
    }
    __memmove(r.keys[write..r.size], r.keys[read..r.size])
    __memmove(r.containers[write..r.size], r.containers[read..r.size])
    r.size -= read - write
}

fn combine(a: *Roaring, b: *Roaring, op: Op, inplace: bool) -> *Roaring {
    let out = with_capacity(if op == And { a.size } else { a.size + b.size })
    var i = 0
    var j = 0
    for i < a.size || j < b.size {
        let ka = if i < a.size { i64(a.keys[i]) } else { 65536 }
        let kb = if j < b.size { i64(b.keys[j]) } else { 65536 }
        if ka == kb {
            let c = container_op(a.containers[i], b.containers[j], op, inplace)
            if c.card > 0 {
                append(out, ka, c)
            }
            i += 1
            j += 1
        } else if ka < kb {
            if op != And {
                append(out, ka, if inplace { a.containers[i] } else { clone_container(a.containers[i]) })
            }
            i += 1
        } else {
            if op == Or || op == Xor {
                append(out, kb, clone_container(b.containers[j]))
            }
            j += 1
        }
    }
    out
}

/// Returns a new bitmap of the values that are in both `a` and `b`.
///
/// Neither argument changes.
pub fn intersect(a: *Roaring, b: *Roaring) -> *Roaring {
    combine(a, b, And, false)
}

/// Returns a new bitmap of the values that are in `a` or `b`.
///
/// Neither argument changes.
pub fn union(a: *Roaring, b: *Roaring) -> *Roaring {
    combine(a, b, Or, false)
}

/// Returns a new bitmap of the values that are in exactly one of `a` and `b`.
///
/// Neither argument changes.
pub fn xor(a: *Roaring, b: *Roaring) -> *Roaring {
    combine(a, b, Xor, false)
}

/// Returns a new bitmap of the values of `a` that are not in `b`.
///
/// Neither argument changes.
pub fn difference(a: *Roaring, b: *Roaring) -> *Roaring {
    combine(a, b, AndNot, false)
}

/// Replaces `a` with the values that are in both `a` and `b`.
///
/// `b` does not change. Containers of `a` are reused where possible, which avoids copying them.
pub fn intersect_with(a: *Roaring, b: *Roaring) {
    *a = *combine(a, b, And, true)
}

/// Adds every value of `b` to `a`.
///
/// `b` does not change. Containers of `a` are reused where possible, which avoids copying them.
pub fn union_with(a: *Roaring, b: *Roaring) {
    *a = *combine(a, b, Or, true)
}

/// Replaces `a` with the values that are in exactly one of `a` and `b`.
///
/// `b` does not change. Containers of `a` are reused where possible, which avoids copying them.
pub fn xor_with(a: *Roaring, b: *Roaring) {
    *a = *combine(a, b, Xor, true)
}

/// Removes from `a` every value that is in `b`.
///
/// `b` does not change. Containers of `a` are reused where possible, which avoids copying them.
pub fn difference_with(a: *Roaring, b: *Roaring) {
    *a = *combine(a, b, AndNot, true)
}

/// Returns `true` when every value of `a` is also in `b`.
///
/// An empty bitmap is a subset of every bitmap.
pub fn is_subset(a: *Roaring, b: *Roaring) -> bool {
    if a.card > b.card {
        return false
    }
    var j = 0
    for i in 0..a.size {
        let key = a.keys[i]
        for j < b.size && b.keys[j] < key {
            j += 1
        }
        if j == b.size || b.keys[j] != key || !container_subset(a.containers[i], b.containers[j]) {
            return false
        }
    }
    true
}

/// Returns `true` when `a` and `b` hold the same values.
///
/// The container representations do not need to match.
pub fn equal(a: *Roaring, b: *Roaring) -> bool {
    if a.card != b.card || a.size != b.size {
        return false
    }
    for i in 0..a.size {
        if a.keys[i] != b.keys[i] || !container_equal(a.containers[i], b.containers[i]) {
            return false
        }
    }
    true
}

/// Returns the smallest value in `r`, or `none` when it is empty.
pub fn min(r: *Roaring) -> u32? {
    if r.size == 0 {
        return none
    }
    u32((i64(r.keys[0]) << 16) | container_min(r.containers[0]))
}

/// Returns the largest value in `r`, or `none` when it is empty.
pub fn max(r: *Roaring) -> u32? {
    if r.size == 0 {
        return none
    }
    let last = r.size - 1
    u32((i64(r.keys[last]) << 16) | container_max(r.containers[last]))
}

/// Returns the number of values in `r` that are at most `x`.
///
/// `x` does not need to be in `r`. Costs time linear in the number of containers before `x`.
pub fn rank(r: *Roaring, x: u32) -> i64 {
    let key = i64(x >> 16)
    var total = 0
    for i in 0..r.size {
        let k = i64(r.keys[i])
        if k > key {
            break
        }
        if k == key {
            return total + container_rank(r.containers[i], i64(x & 0xFFFF))
        }
        total += r.containers[i].card
    }
    total
}

/// Returns the value of `r` at zero-based position `k` in increasing order, or `none` when `k` is negative or at least `cardinality(r)`.
///
/// This is the inverse of `rank`.
pub fn select_at(r: *Roaring, k: i64) -> u32? {
    if k < 0 || k >= r.card {
        return none
    }
    var left = k
    for i in 0..r.size {
        let c = r.containers[i]
        if left < c.card {
            return u32((i64(r.keys[i]) << 16) | container_select(c, left))
        }
        left -= c.card
    }
    none
}

/// Returns the values of `r` in increasing order.
pub fn members(r: *Roaring) -> []u32 {
    let out: []u32 = __make(r.card)
    var at = 0
    for i in 0..r.size {
        let c = r.containers[i]
        container_emit(c, u32(r.keys[i]) << 16, out, at)
        at += c.card
    }
    out
}

/// Calls `f` with each value of `r` in increasing order.
///
/// Stops early when `f` returns `false`.
pub fn for_each(r: *Roaring, f: fn(u32) -> bool) {
    for i in 0..r.size {
        if !container_visit(r.containers[i], u32(r.keys[i]) << 16, f) {
            return
        }
    }
}

/// Converts every container of `r` to the representation that takes the least space, which can be a list of runs.
///
/// The values do not change. Runs shrink long consecutive ranges, and `serialize` writes the runs it finds.
pub fn run_optimize(r: *Roaring) {
    for i in 0..r.size {
        r.containers[i] = tidy(r.containers[i])
    }
}
