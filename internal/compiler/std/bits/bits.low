pub fn popcount(x: u64) -> i64 {
    var v = x - ((x >> 1) & 0x5555555555555555)
    v = (v & 0x3333333333333333) + ((v >> 2) & 0x3333333333333333)
    v = (v + (v >> 4)) & 0x0F0F0F0F0F0F0F0F
    i64((v * 0x0101010101010101) >> 56)
}

pub fn trailing_zeros(x: u64) -> i64 {
    popcount((x & (0 - x)) - 1)
}

pub fn leading_zeros(x: u64) -> i64 {
    var v = x | (x >> 1)
    v |= v >> 2
    v |= v >> 4
    v |= v >> 8
    v |= v >> 16
    v |= v >> 32
    64 - popcount(v)
}

pub fn select_in_word(x: u64, k: i64) -> i64 {
    var v = x
    for _ in 0..k {
        v &= v - 1
    }
    trailing_zeros(v)
}

pub struct Set {
    words: []u64
}

pub fn set(capacity: i64) -> *Set {
    let words: []u64 = __make((capacity + 63) >> 6)
    new(Set { words })
}

pub fn clone(s: *Set) -> *Set {
    let words: []u64 = __make(s.words.len)
    __memmove(words, s.words)
    new(Set { words })
}

fn reserve(s: *Set, words: i64) {
    if words <= s.words.len {
        return
    }
    let size = if s.words.len * 2 < words { words } else { s.words.len * 2 }
    let grown: []u64 = __make(size)
    __memmove(grown, s.words)
    s.words = grown
}

fn bit(x: i64) -> u64 {
    u64(1) << (x & 63)
}

pub fn add(s: *Set, x: i64) {
    reserve(s, (x >> 6) + 1)
    s.words[x >> 6] |= bit(x)
}

pub fn remove(s: *Set, x: i64) {
    if x >= 0 && x >> 6 < s.words.len {
        s.words[x >> 6] &= ~bit(x)
    }
}

pub fn toggle(s: *Set, x: i64) {
    reserve(s, (x >> 6) + 1)
    s.words[x >> 6] ^= bit(x)
}

pub fn contains(s: *Set, x: i64) -> bool {
    x >= 0 && x >> 6 < s.words.len && (s.words[x >> 6] & bit(x)) != 0
}

pub fn count(s: *Set) -> i64 {
    var total = 0
    for w in s.words {
        total += popcount(w)
    }
    total
}

pub fn clear(s: *Set) {
    let words = s.words
    for i in 0..words.len {
        words[i] = 0
    }
}

fn word_at(s: *Set, i: i64) -> u64 {
    if i < s.words.len { s.words[i] } else { 0 }
}

pub fn union_with(a: *Set, b: *Set) {
    reserve(a, b.words.len)
    let words = a.words
    for i, w in b.words {
        words[i] |= w
    }
}

pub fn intersect_with(a: *Set, b: *Set) {
    let words = a.words
    for i in 0..words.len {
        words[i] &= word_at(b, i)
    }
}

pub fn difference_with(a: *Set, b: *Set) {
    let words = a.words
    let shared = if words.len < b.words.len { words.len } else { b.words.len }
    for i in 0..shared {
        words[i] &= ~b.words[i]
    }
}

pub fn xor_with(a: *Set, b: *Set) {
    reserve(a, b.words.len)
    let words = a.words
    for i, w in b.words {
        words[i] ^= w
    }
}

pub fn union(a: *Set, b: *Set) -> *Set {
    let out = clone(a)
    union_with(out, b)
    out
}

pub fn intersect(a: *Set, b: *Set) -> *Set {
    let out = clone(a)
    intersect_with(out, b)
    out
}

pub fn difference(a: *Set, b: *Set) -> *Set {
    let out = clone(a)
    difference_with(out, b)
    out
}

pub fn xor(a: *Set, b: *Set) -> *Set {
    let out = clone(a)
    xor_with(out, b)
    out
}

pub fn equal(a: *Set, b: *Set) -> bool {
    let size = if a.words.len > b.words.len { a.words.len } else { b.words.len }
    for i in 0..size {
        if word_at(a, i) != word_at(b, i) {
            return false
        }
    }
    true
}

pub fn subset(a: *Set, b: *Set) -> bool {
    for i, w in a.words {
        if (w & ~word_at(b, i)) != 0 {
            return false
        }
    }
    true
}

pub fn next_set(s: *Set, from: i64) -> i64? {
    let start = if from < 0 { 0 } else { from }
    var i = start >> 6
    if i >= s.words.len {
        return none
    }
    var w = s.words[i] & (0xFFFFFFFFFFFFFFFF << (start & 63))
    for w == 0 {
        i += 1
        if i == s.words.len {
            return none
        }
        w = s.words[i]
    }
    (i << 6) | trailing_zeros(w)
}

pub fn next_clear(s: *Set, from: i64) -> i64 {
    let start = if from < 0 { 0 } else { from }
    var i = start >> 6
    if i >= s.words.len {
        return start
    }
    var w = ~s.words[i] & (0xFFFFFFFFFFFFFFFF << (start & 63))
    for w == 0 {
        i += 1
        if i == s.words.len {
            return i << 6
        }
        w = ~s.words[i]
    }
    (i << 6) | trailing_zeros(w)
}

pub fn for_each(s: *Set, f: fn(i64) -> bool) {
    for i, word in s.words {
        var w = word
        for w != 0 {
            if !f((i << 6) | trailing_zeros(w)) {
                return
            }
            w &= w - 1
        }
    }
}

pub fn members(s: *Set) -> []i64 {
    let out: []i64 = __make(count(s))
    var k = 0
    for i, word in s.words {
        var w = word
        for w != 0 {
            out[k] = (i << 6) | trailing_zeros(w)
            k += 1
            w &= w - 1
        }
    }
    out
}

pub fn min(s: *Set) -> i64? {
    next_set(s, 0)
}

pub fn max(s: *Set) -> i64? {
    var i = s.words.len - 1
    for i >= 0 {
        let w = s.words[i]
        if w != 0 {
            return (i << 6) | (63 - leading_zeros(w))
        }
        i -= 1
    }
    none
}

pub fn rank(s: *Set, x: i64) -> i64 {
    if x < 0 {
        return 0
    }
    let last = x >> 6
    let full = if last < s.words.len { last } else { s.words.len }
    var total = 0
    for i in 0..full {
        total += popcount(s.words[i])
    }
    if last < s.words.len {
        total += popcount(s.words[last] & (0xFFFFFFFFFFFFFFFF >> (63 - (x & 63))))
    }
    total
}

pub fn select_at(s: *Set, k: i64) -> i64? {
    if k < 0 {
        return none
    }
    var left = k
    for i, w in s.words {
        let c = popcount(w)
        if left < c {
            return (i << 6) | select_in_word(w, left)
        }
        left -= c
    }
    none
}
