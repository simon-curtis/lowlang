/// A position in a text where a line may end, as reported by `line_breaks`.
pub struct LineBreak {
    /// The byte index where the next line starts.
    pub at: i64
    /// Whether the line must end here: after a hard line break, or at the end of the text.
    pub mandatory: bool
}

enum Verdict {
    Join
    Allowed
    Required
}

struct Peek {
    at: i64
    record: u32
    end: bool
}

struct LineScan {
    sot: bool
    prev: u32
    prev_dotted: bool
    last_zwj: bool
    zw_space: bool
    open_space: bool
    close_space: bool
    b2_space: bool
    quote_start: bool
    quote_plain: bool
    hyphen_start: bool
    hebrew_hyphen: bool
    virama: bool
    numeric: i64
    regional: i64
}

fn dotted_circle() -> u32 {
    0x25CC
}

fn line_scan() -> LineScan {
    LineScan {
        sot: true, prev: 0, prev_dotted: false, last_zwj: false, zw_space: false, open_space: false,
        close_space: false, b2_space: false, quote_start: false, quote_plain: false, hyphen_start: false,
        hebrew_hyphen: false, virama: false, numeric: 0, regional: 0
    }
}

fn east_asian(record: u32) -> bool {
    break_flag(record, break_east_asian_shift())
}

fn initial_quote(record: u32) -> bool {
    break_flag(record, break_initial_quote_shift())
}

fn final_quote(record: u32) -> bool {
    break_flag(record, break_final_quote_shift())
}

fn is_hard_break(cls: i64) -> bool {
    cls == line_bk() || cls == line_cr() || cls == line_lf() || cls == line_nl()
}

fn is_mark_base_excluded(cls: i64) -> bool {
    is_hard_break(cls) || cls == line_sp() || cls == line_zw()
}

fn is_hyphen(cls: i64) -> bool {
    cls == line_hy() || cls == line_hh()
}

fn line_letter(cls: i64) -> bool {
    cls == line_al() || cls == line_hl()
}

fn is_brahmic(cls: i64, dotted: bool) -> bool {
    cls == line_ak() || cls == line_as() || dotted
}

fn is_hangul(cls: i64) -> bool {
    cls == line_jl() || cls == line_jv() || cls == line_jt() || cls == line_h2() || cls == line_h3()
}

fn is_numeric_affix(cls: i64) -> bool {
    cls == line_pr() || cls == line_po()
}

fn is_ideographic(cls: i64) -> bool {
    cls == line_id() || cls == line_eb() || cls == line_em()
}

fn attaches_mark(st: LineScan) -> bool {
    !st.sot && !is_mark_base_excluded(line_class(st.prev))
}

fn quote_start_context(st: LineScan) -> bool {
    let prev = line_class(st.prev)
    st.sot || is_hard_break(prev) || prev == line_op() || prev == line_qu() || prev == line_gl() || prev == line_sp() || prev == line_zw()
}

fn hyphen_start_context(st: LineScan) -> bool {
    let prev = line_class(st.prev)
    st.sot || is_mark_base_excluded(prev) || prev == line_cb() || prev == line_gl()
}

fn next_numeric(state: i64, cls: i64) -> i64 {
    if cls == line_nu() {
        return 1
    }
    if state == 1 && (cls == line_sy() || cls == line_is()) {
        return 1
    }
    if state == 1 && (cls == line_cl() || cls == line_cp()) {
        return 2
    }
    0
}

fn line_advance(mut st: LineScan, record: u32, dotted: bool) {
    let cls = line_class(record)
    let prev = line_class(st.prev)
    let space = cls == line_sp()
    st.quote_start = cls == line_qu() && initial_quote(record) && quote_start_context(st) || st.quote_start && space
    st.quote_plain = cls == line_qu() && (st.sot || !east_asian(st.prev))
    st.hyphen_start = is_hyphen(cls) && hyphen_start_context(st)
    st.hebrew_hyphen = is_hyphen(cls) && !st.sot && prev == line_hl()
    st.virama = cls == line_vi() && !st.sot && is_brahmic(prev, st.prev_dotted)
    st.numeric = next_numeric(st.numeric, cls)
    st.regional = if cls == line_ri() { st.regional + 1 } else { 0 }
    st.zw_space = cls == line_zw() || st.zw_space && space
    st.open_space = cls == line_op() || st.open_space && space
    st.close_space = cls == line_cl() || cls == line_cp() || st.close_space && space
    st.b2_space = cls == line_b2() || st.b2_space && space
    st.prev = record
    st.prev_dotted = dotted
    st.sot = false
}

fn line_after(s: str, at: i64) -> Peek {
    var pos = at + decode_rune(s, at).size
    for pos < s.len {
        let r = decode_rune(s, pos)
        let record = break_record(r.code)
        let cls = line_class(record)
        if cls != line_cm() && cls != line_zwj() {
            return Peek { at: pos, record, end: false }
        }
        pos += r.size
    }
    Peek { at: s.len, record: 0, end: true }
}

fn quote_closes(s: str, at: i64) -> bool {
    let ahead = line_after(s, at)
    if ahead.end {
        return true
    }
    let cls = line_class(ahead.record)
    cls == line_sp() || cls == line_gl() || cls == line_wj() || cls == line_cl() || cls == line_qu() || cls == line_cp() || cls == line_ex() || cls == line_is() || cls == line_sy() || is_hard_break(cls) || cls == line_zw()
}

fn decimal_follows(s: str, at: i64) -> bool {
    let ahead = line_after(s, at)
    !ahead.end && line_class(ahead.record) == line_nu()
}

fn number_follows(s: str, at: i64) -> bool {
    let ahead = line_after(s, at)
    if ahead.end {
        return false
    }
    let cls = line_class(ahead.record)
    if cls == line_nu() {
        return true
    }
    cls == line_is() && decimal_follows(s, ahead.at)
}

fn virama_ends_syllable(s: str, at: i64) -> bool {
    let ahead = line_after(s, at)
    !ahead.end && line_class(ahead.record) == line_vf()
}

fn line_joins_early(s: str, at: i64, st: LineScan, record: u32, prev: i64, cls: i64) -> bool {
    if cls == line_wj() || prev == line_wj() || prev == line_gl() {
        return true
    }
    if cls == line_gl() && prev != line_sp() && prev != line_ba() && !is_hyphen(prev) {
        return true
    }
    if cls == line_cl() || cls == line_cp() || cls == line_ex() || cls == line_sy() {
        return true
    }
    if st.open_space || st.quote_start {
        return true
    }
    cls == line_qu() && final_quote(record) && quote_closes(s, at)
}

fn line_joins_punctuation(st: LineScan, cls: i64) -> bool {
    cls == line_is() || st.close_space && cls == line_ns() || st.b2_space && cls == line_b2()
}

fn line_joins_quotes(s: str, at: i64, st: LineScan, record: u32, prev: i64, cls: i64) -> bool {
    if cls == line_qu() && !initial_quote(record) {
        return true
    }
    if prev == line_qu() && !final_quote(st.prev) {
        return true
    }
    if cls == line_qu() && (!east_asian(st.prev) || line_after(s, at).end || !east_asian(line_after(s, at).record)) {
        return true
    }
    prev == line_qu() && (!east_asian(record) || st.quote_plain)
}

fn line_joins_symbols(st: LineScan, prev: i64, cls: i64) -> bool {
    if st.hyphen_start && line_letter(cls) {
        return true
    }
    if cls == line_ba() || cls == line_hh() || cls == line_hy() || cls == line_ns() || prev == line_bb() {
        return true
    }
    if st.hebrew_hyphen && cls != line_hl() {
        return true
    }
    prev == line_sy() && cls == line_hl() || cls == line_in()
}

fn line_joins_numbers(s: str, at: i64, st: LineScan, prev: i64, cls: i64) -> bool {
    if line_letter(prev) && cls == line_nu() || prev == line_nu() && line_letter(cls) {
        return true
    }
    if prev == line_pr() && is_ideographic(cls) || is_ideographic(prev) && cls == line_po() {
        return true
    }
    if is_numeric_affix(prev) && line_letter(cls) || line_letter(prev) && is_numeric_affix(cls) {
        return true
    }
    if st.numeric > 0 && is_numeric_affix(cls) || st.numeric == 1 && cls == line_nu() {
        return true
    }
    if is_numeric_affix(prev) && cls == line_op() && number_follows(s, at) {
        return true
    }
    (is_numeric_affix(prev) || prev == line_hy() || prev == line_is()) && cls == line_nu()
}

fn line_joins_hangul(prev: i64, cls: i64) -> bool {
    if prev == line_jl() && (cls == line_jl() || cls == line_jv() || cls == line_h2() || cls == line_h3()) {
        return true
    }
    if (prev == line_jv() || prev == line_h2()) && (cls == line_jv() || cls == line_jt()) {
        return true
    }
    if (prev == line_jt() || prev == line_h3()) && cls == line_jt() {
        return true
    }
    is_hangul(prev) && cls == line_po() || prev == line_pr() && is_hangul(cls)
}

fn line_joins_brahmic(s: str, at: i64, st: LineScan, prev: i64, cls: i64, dotted: bool) -> bool {
    let base = is_brahmic(cls, dotted)
    let prev_base = is_brahmic(prev, st.prev_dotted)
    if prev == line_ap() && base {
        return true
    }
    if prev_base && (cls == line_vf() || cls == line_vi()) {
        return true
    }
    if st.virama && (cls == line_ak() || dotted) {
        return true
    }
    prev_base && base && virama_ends_syllable(s, at)
}

fn line_joins_words(st: LineScan, record: u32, prev: i64, cls: i64) -> bool {
    if line_letter(prev) && line_letter(cls) || prev == line_is() && line_letter(cls) {
        return true
    }
    if line_letter(prev) || prev == line_nu() {
        if cls == line_op() && !east_asian(record) {
            return true
        }
    }
    if prev == line_cp() && !east_asian(st.prev) && (line_letter(cls) || cls == line_nu()) {
        return true
    }
    if prev == line_ri() && cls == line_ri() && st.regional % 2 == 1 {
        return true
    }
    cls == line_em() && (prev == line_eb() || break_flag(st.prev, break_unassigned_pictographic_shift()))
}

fn line_joins_late(s: str, at: i64, st: LineScan, record: u32, dotted: bool, prev: i64, cls: i64) -> bool {
    line_joins_symbols(st, prev, cls) || line_joins_numbers(s, at, st, prev, cls) || line_joins_hangul(prev, cls) || line_joins_words(st, record, prev, cls) || line_joins_brahmic(s, at, st, prev, cls, dotted)
}

fn line_verdict(s: str, at: i64, st: LineScan, record: u32, dotted: bool) -> Verdict {
    let prev = line_class(st.prev)
    let cls = line_class(record)
    if prev == line_cr() && cls == line_lf() {
        return Join
    }
    if is_hard_break(prev) {
        return Required
    }
    if is_hard_break(cls) || cls == line_sp() || cls == line_zw() {
        return Join
    }
    if st.zw_space {
        return Allowed
    }
    if st.last_zwj || line_joins_early(s, at, st, record, prev, cls) {
        return Join
    }
    if prev == line_sp() && cls == line_is() && decimal_follows(s, at) {
        return Allowed
    }
    if line_joins_punctuation(st, cls) {
        return Join
    }
    if prev == line_sp() {
        return Allowed
    }
    if line_joins_quotes(s, at, st, record, prev, cls) {
        return Join
    }
    if prev == line_cb() || cls == line_cb() {
        return Allowed
    }
    if line_joins_late(s, at, st, record, dotted, prev, cls) {
        return Join
    }
    Allowed
}

/// Returns every position in `s` where a line may end, following the default line breaking rules of Unicode Standard Annex 14.
/// Each entry holds the byte index where the next line would start and whether the break is mandatory. Breaks are mandatory after a hard line break (line feed, carriage return, next line, vertical and form feeds, line and paragraph separators) and at the end of the text. The index `0` is never reported and an empty `s` has no breaks, so splitting `s` at the reported indices gives its lines. Unresolved classes take the algorithm's defaults: ambiguous, unknown and surrogate characters are alphabetic, complex-context characters are alphabetic unless they are marks, and conditional Japanese starters are non-starters.
pub fn line_breaks(s: str) -> []LineBreak {
    var out: []LineBreak = []
    var st = line_scan()
    for i, c in s {
        var record = break_record(c)
        let cls = line_class(record)
        let zwj = cls == line_zwj()
        let mark = cls == line_cm() || zwj
        if mark && attaches_mark(st) {
            st.last_zwj = zwj
            continue
        }
        if mark {
            record = 0
        }
        let dotted = c == dotted_circle()
        if !st.sot {
            let verdict = line_verdict(s, i, st, record, dotted)
            match verdict {
                Allowed => push(mut out, LineBreak { at: i, mandatory: false })
                Required => push(mut out, LineBreak { at: i, mandatory: true })
                Join => {}
            }
        }
        line_advance(mut st, record, dotted)
        st.last_zwj = zwj
    }
    if s.len > 0 {
        push(mut out, LineBreak { at: s.len, mandatory: true })
    }
    out
}
