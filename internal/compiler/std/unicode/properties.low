/// A Unicode general category.
///
/// The variants follow the Unicode categories, and `category_code` gives their two-letter codes.
pub enum Category {
    /// A code point with no assigned category, including the noncharacters.
    Unassigned
    /// An uppercase letter.
    UppercaseLetter
    /// A lowercase letter.
    LowercaseLetter
    /// A titlecase letter, such as the digraph `ǅ`.
    TitlecaseLetter
    /// A modifier letter.
    ModifierLetter
    /// A letter that has no case, such as an ideograph or a syllable.
    OtherLetter
    /// A combining mark that takes no space of its own.
    NonspacingMark
    /// A combining mark that takes space of its own.
    SpacingMark
    /// A combining mark that encloses its base character.
    EnclosingMark
    /// A decimal digit in any script.
    DecimalNumber
    /// A number written with a letter, such as a Roman numeral.
    LetterNumber
    /// A number that is neither a decimal digit nor a letter number, such as a fraction or a superscript.
    OtherNumber
    /// A punctuation mark that joins words, such as `_`.
    ConnectorPunctuation
    /// A dash or hyphen.
    DashPunctuation
    /// An opening bracket or similar mark.
    OpenPunctuation
    /// A closing bracket or similar mark.
    ClosePunctuation
    /// An opening quotation mark.
    InitialPunctuation
    /// A closing quotation mark.
    FinalPunctuation
    /// Any other punctuation mark.
    OtherPunctuation
    /// A mathematical symbol.
    MathSymbol
    /// A currency symbol.
    CurrencySymbol
    /// A modifier symbol.
    ModifierSymbol
    /// Any other symbol, such as an emoji.
    OtherSymbol
    /// A space character that is not a control.
    SpaceSeparator
    /// The line separator U+2028.
    LineSeparator
    /// The paragraph separator U+2029.
    ParagraphSeparator
    /// A C0 or C1 control code.
    Control
    /// An invisible formatting character, such as a zero-width joiner.
    Format
    /// A UTF-16 surrogate code point.
    Surrogate
    /// A private-use code point.
    PrivateUse
}

/// The East Asian Width property of a code point (UAX #11).
pub enum Width {
    /// Not East Asian, and treated as one column. The value for unassigned code points.
    Neutral
    /// Wide in East Asian contexts and narrow elsewhere.
    Ambiguous
    /// A fullwidth form, two columns wide.
    Fullwidth
    /// A halfwidth form, one column wide.
    Halfwidth
    /// A narrow East Asian character, one column wide.
    Narrow
    /// A wide East Asian character, two columns wide.
    Wide
}

/// A Unicode script, for the scripts listed and `Other` for any other.
///
/// Only a selection of scripts has a variant. A code point of a script without one has the script `Other`.
pub enum Script {
    /// Code points with no script assignment, including unassigned ones.
    Unknown
    /// Characters used with several scripts, such as punctuation, digits and symbols.
    Common
    /// Characters that take the script of the character before them, such as combining marks.
    Inherited
    /// The Latin script.
    Latin
    /// The Greek script.
    Greek
    /// The Cyrillic script.
    Cyrillic
    /// The Armenian script.
    Armenian
    /// The Hebrew script.
    Hebrew
    /// The Arabic script.
    Arabic
    /// The Syriac script.
    Syriac
    /// The Thaana script.
    Thaana
    /// The Devanagari script.
    Devanagari
    /// The Bengali script.
    Bengali
    /// The Gurmukhi script.
    Gurmukhi
    /// The Gujarati script.
    Gujarati
    /// The Tamil script.
    Tamil
    /// The Telugu script.
    Telugu
    /// The Kannada script.
    Kannada
    /// The Malayalam script.
    Malayalam
    /// The Sinhala script.
    Sinhala
    /// The Thai script.
    Thai
    /// The Lao script.
    Lao
    /// The Tibetan script.
    Tibetan
    /// The Myanmar script.
    Myanmar
    /// The Georgian script.
    Georgian
    /// The Hangul script.
    Hangul
    /// The Ethiopic script.
    Ethiopic
    /// The Khmer script.
    Khmer
    /// The Mongolian script.
    Mongolian
    /// The Hiragana script.
    Hiragana
    /// The Katakana script.
    Katakana
    /// The Bopomofo script.
    Bopomofo
    /// The Han script.
    Han
    /// A script that has no variant of its own.
    Other
}

fn props(c: u32) -> u32 {
    var point = c
    if point >= 0xE0000 {
        point -= 0xA0000
    } else if point >= 0x40000 {
        return 0
    }
    let index = embed("props_index.bin")
    let block = i64(point >> 7)
    if block * 2 >= index.len {
        return 0
    }
    let blocks = embed("props_blocks.bin")
    let start = u16_at(index, block * 2) << 7
    let id = u16_at(blocks, (start + i64(point & 127)) * 2)
    u32_at(embed("props_records.bin"), id * 4)
}

fn category_index(c: u32) -> u32 {
    props(c) & 31
}

fn flag(c: u32, bit: u32) -> bool {
    props(c) >> bit & 1 == 1
}

/// Returns the general category of the code point `c`.
/// Unassigned code points and values above `0x10FFFF` give `Unassigned`.
pub fn category(c: u32) -> Category {
    match category_index(c) {
        == 1 => UppercaseLetter
        == 2 => LowercaseLetter
        == 3 => TitlecaseLetter
        == 4 => ModifierLetter
        == 5 => OtherLetter
        == 6 => NonspacingMark
        == 7 => SpacingMark
        == 8 => EnclosingMark
        == 9 => DecimalNumber
        == 10 => LetterNumber
        == 11 => OtherNumber
        == 12 => ConnectorPunctuation
        == 13 => DashPunctuation
        == 14 => OpenPunctuation
        == 15 => ClosePunctuation
        == 16 => InitialPunctuation
        == 17 => FinalPunctuation
        == 18 => OtherPunctuation
        == 19 => MathSymbol
        == 20 => CurrencySymbol
        == 21 => ModifierSymbol
        == 22 => OtherSymbol
        == 23 => SpaceSeparator
        == 24 => LineSeparator
        == 25 => ParagraphSeparator
        == 26 => Control
        == 27 => Format
        == 28 => Surrogate
        == 29 => PrivateUse
        _ => Unassigned
    }
}

/// Returns the two-letter Unicode code of `k`, such as `Lu` for `UppercaseLetter` and `Nd` for `DecimalNumber`.
pub fn category_code(k: Category) -> str {
    match k {
        Unassigned => "Cn"
        UppercaseLetter => "Lu"
        LowercaseLetter => "Ll"
        TitlecaseLetter => "Lt"
        ModifierLetter => "Lm"
        OtherLetter => "Lo"
        NonspacingMark => "Mn"
        SpacingMark => "Mc"
        EnclosingMark => "Me"
        DecimalNumber => "Nd"
        LetterNumber => "Nl"
        OtherNumber => "No"
        ConnectorPunctuation => "Pc"
        DashPunctuation => "Pd"
        OpenPunctuation => "Ps"
        ClosePunctuation => "Pe"
        InitialPunctuation => "Pi"
        FinalPunctuation => "Pf"
        OtherPunctuation => "Po"
        MathSymbol => "Sm"
        CurrencySymbol => "Sc"
        ModifierSymbol => "Sk"
        OtherSymbol => "So"
        SpaceSeparator => "Zs"
        LineSeparator => "Zl"
        ParagraphSeparator => "Zp"
        Control => "Cc"
        Format => "Cf"
        Surrogate => "Cs"
        PrivateUse => "Co"
    }
}

/// Returns whether `c` is a letter: category `Lu`, `Ll`, `Lt`, `Lm` or `Lo`.
pub fn is_letter(c: u32) -> bool {
    let k = category_index(c)
    k >= 1 && k <= 5
}

/// Returns whether `c` is an uppercase letter, category `Lu`.
pub fn is_upper(c: u32) -> bool {
    category_index(c) == 1
}

/// Returns whether `c` is a lowercase letter, category `Ll`.
pub fn is_lower(c: u32) -> bool {
    category_index(c) == 2
}

/// Returns whether `c` is a titlecase letter, category `Lt`.
pub fn is_title(c: u32) -> bool {
    category_index(c) == 3
}

/// Returns whether `c` is a combining mark: category `Mn`, `Mc` or `Me`.
pub fn is_mark(c: u32) -> bool {
    let k = category_index(c)
    k >= 6 && k <= 8
}

/// Returns whether `c` is a decimal digit in any script, category `Nd`.
pub fn is_digit(c: u32) -> bool {
    category_index(c) == 9
}

/// Returns whether `c` is a number: category `Nd`, `Nl` or `No`.
pub fn is_number(c: u32) -> bool {
    let k = category_index(c)
    k >= 9 && k <= 11
}

/// Returns whether `c` is punctuation: category `Pc`, `Pd`, `Ps`, `Pe`, `Pi`, `Pf` or `Po`.
pub fn is_punct(c: u32) -> bool {
    let k = category_index(c)
    k >= 12 && k <= 18
}

/// Returns whether `c` is a symbol: category `Sm`, `Sc`, `Sk` or `So`.
pub fn is_symbol(c: u32) -> bool {
    let k = category_index(c)
    k >= 19 && k <= 22
}

/// Returns whether `c` is a control code, category `Cc`.
pub fn is_control(c: u32) -> bool {
    category_index(c) == 26
}

/// Returns whether `c` is a letter or a number.
/// Marks are not included.
pub fn is_alphanumeric(c: u32) -> bool {
    let k = category_index(c)
    k >= 1 && k <= 5 || k >= 9 && k <= 11
}

/// Returns whether `c` has the Unicode `White_Space` property.
/// This includes the ASCII whitespace characters, U+0085, U+00A0, U+2028, U+2029 and the `Zs` spaces.
pub fn is_space(c: u32) -> bool {
    flag(c, 21)
}

/// Returns whether `c` has the Unicode `XID_Start` property, so it can begin an identifier.
pub fn is_identifier_start(c: u32) -> bool {
    flag(c, 22)
}

/// Returns whether `c` has the Unicode `XID_Continue` property, so it can appear in an identifier after the first character.
pub fn is_identifier_continue(c: u32) -> bool {
    flag(c, 23)
}

/// Returns the East Asian Width property of `c`.
pub fn east_asian_width(c: u32) -> Width {
    match props(c) >> 5 & 7 {
        == 1 => Ambiguous
        == 2 => Fullwidth
        == 3 => Halfwidth
        == 4 => Narrow
        == 5 => Wide
        _ => Neutral
    }
}

/// Returns the script of `c`.
/// Code points of a script without a variant give `Other`, and unassigned ones give `Unknown`.
pub fn script(c: u32) -> Script {
    match props(c) >> 8 & 63 {
        == 1 => Common
        == 2 => Inherited
        == 3 => Latin
        == 4 => Greek
        == 5 => Cyrillic
        == 6 => Armenian
        == 7 => Hebrew
        == 8 => Arabic
        == 9 => Syriac
        == 10 => Thaana
        == 11 => Devanagari
        == 12 => Bengali
        == 13 => Gurmukhi
        == 14 => Gujarati
        == 15 => Tamil
        == 16 => Telugu
        == 17 => Kannada
        == 18 => Malayalam
        == 19 => Sinhala
        == 20 => Thai
        == 21 => Lao
        == 22 => Tibetan
        == 23 => Myanmar
        == 24 => Georgian
        == 25 => Hangul
        == 26 => Ethiopic
        == 27 => Khmer
        == 28 => Mongolian
        == 29 => Hiragana
        == 30 => Katakana
        == 31 => Bopomofo
        == 32 => Han
        == 33 => Other
        _ => Unknown
    }
}

fn zero_width(c: u32, p: u32) -> bool {
    let k = p & 31
    if c == 0xAD {
        return false
    }
    k == 6 || k == 8 || k == 26 || k == 27 || c >= 0x1160 && c <= 0x11FF || c >= 0xD7B0 && c <= 0xD7FF
}

/// Returns the number of terminal columns `c` takes: `0`, `1` or `2`.
/// Nonspacing and enclosing marks, control codes, format characters and the Hangul medial and final jamo (U+1160 to U+11FF and U+D7B0 to U+D7FF) take none. U+00AD takes one. Characters with the `Wide` or `Fullwidth` East Asian Width take two, and all others take one.
pub fn display_width(c: u32) -> i64 {
    let p = props(c)
    if zero_width(c, p) {
        return 0
    }
    let width = p >> 5 & 7
    if width == 2 || width == 5 {
        return 2
    }
    1
}

/// Returns the sum of `display_width` over the code points of `s`.
/// Code points are measured one at a time, so a grapheme cluster built from several of them adds their widths together.
pub fn text_width(s: str) -> i64 {
    var total = 0
    for c in s {
        total += display_width(c)
    }
    total
}
