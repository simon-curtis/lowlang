pub enum Category {
    Unassigned
    UppercaseLetter
    LowercaseLetter
    TitlecaseLetter
    ModifierLetter
    OtherLetter
    NonspacingMark
    SpacingMark
    EnclosingMark
    DecimalNumber
    LetterNumber
    OtherNumber
    ConnectorPunctuation
    DashPunctuation
    OpenPunctuation
    ClosePunctuation
    InitialPunctuation
    FinalPunctuation
    OtherPunctuation
    MathSymbol
    CurrencySymbol
    ModifierSymbol
    OtherSymbol
    SpaceSeparator
    LineSeparator
    ParagraphSeparator
    Control
    Format
    Surrogate
    PrivateUse
}

pub enum Width {
    Neutral
    Ambiguous
    Fullwidth
    Halfwidth
    Narrow
    Wide
}

pub enum Script {
    Unknown
    Common
    Inherited
    Latin
    Greek
    Cyrillic
    Armenian
    Hebrew
    Arabic
    Syriac
    Thaana
    Devanagari
    Bengali
    Gurmukhi
    Gujarati
    Tamil
    Telugu
    Kannada
    Malayalam
    Sinhala
    Thai
    Lao
    Tibetan
    Myanmar
    Georgian
    Hangul
    Ethiopic
    Khmer
    Mongolian
    Hiragana
    Katakana
    Bopomofo
    Han
    Other
}

fn props(c: u32) -> u32 {
    var point = c
    if point >= 0xE0000 {
        point -= 0xA0000
    } else if point >= 0x40000 {
        return 0
    }
    let index = embed("props_index.bin")
    let block = i64(point >> 7)
    if block * 2 >= index.len {
        return 0
    }
    let blocks = embed("props_blocks.bin")
    let start = u16_at(index, block * 2) << 7
    let id = u16_at(blocks, (start + i64(point & 127)) * 2)
    u32_at(embed("props_records.bin"), id * 4)
}

fn category_index(c: u32) -> u32 {
    props(c) & 31
}

fn flag(c: u32, bit: u32) -> bool {
    props(c) >> bit & 1 == 1
}

pub fn category(c: u32) -> Category {
    match category_index(c) {
        == 1 => UppercaseLetter
        == 2 => LowercaseLetter
        == 3 => TitlecaseLetter
        == 4 => ModifierLetter
        == 5 => OtherLetter
        == 6 => NonspacingMark
        == 7 => SpacingMark
        == 8 => EnclosingMark
        == 9 => DecimalNumber
        == 10 => LetterNumber
        == 11 => OtherNumber
        == 12 => ConnectorPunctuation
        == 13 => DashPunctuation
        == 14 => OpenPunctuation
        == 15 => ClosePunctuation
        == 16 => InitialPunctuation
        == 17 => FinalPunctuation
        == 18 => OtherPunctuation
        == 19 => MathSymbol
        == 20 => CurrencySymbol
        == 21 => ModifierSymbol
        == 22 => OtherSymbol
        == 23 => SpaceSeparator
        == 24 => LineSeparator
        == 25 => ParagraphSeparator
        == 26 => Control
        == 27 => Format
        == 28 => Surrogate
        == 29 => PrivateUse
        _ => Unassigned
    }
}

pub fn category_code(k: Category) -> str {
    match k {
        Unassigned => "Cn"
        UppercaseLetter => "Lu"
        LowercaseLetter => "Ll"
        TitlecaseLetter => "Lt"
        ModifierLetter => "Lm"
        OtherLetter => "Lo"
        NonspacingMark => "Mn"
        SpacingMark => "Mc"
        EnclosingMark => "Me"
        DecimalNumber => "Nd"
        LetterNumber => "Nl"
        OtherNumber => "No"
        ConnectorPunctuation => "Pc"
        DashPunctuation => "Pd"
        OpenPunctuation => "Ps"
        ClosePunctuation => "Pe"
        InitialPunctuation => "Pi"
        FinalPunctuation => "Pf"
        OtherPunctuation => "Po"
        MathSymbol => "Sm"
        CurrencySymbol => "Sc"
        ModifierSymbol => "Sk"
        OtherSymbol => "So"
        SpaceSeparator => "Zs"
        LineSeparator => "Zl"
        ParagraphSeparator => "Zp"
        Control => "Cc"
        Format => "Cf"
        Surrogate => "Cs"
        PrivateUse => "Co"
    }
}

pub fn is_letter(c: u32) -> bool {
    let k = category_index(c)
    k >= 1 && k <= 5
}

pub fn is_upper(c: u32) -> bool {
    category_index(c) == 1
}

pub fn is_lower(c: u32) -> bool {
    category_index(c) == 2
}

pub fn is_title(c: u32) -> bool {
    category_index(c) == 3
}

pub fn is_mark(c: u32) -> bool {
    let k = category_index(c)
    k >= 6 && k <= 8
}

pub fn is_digit(c: u32) -> bool {
    category_index(c) == 9
}

pub fn is_number(c: u32) -> bool {
    let k = category_index(c)
    k >= 9 && k <= 11
}

pub fn is_punct(c: u32) -> bool {
    let k = category_index(c)
    k >= 12 && k <= 18
}

pub fn is_symbol(c: u32) -> bool {
    let k = category_index(c)
    k >= 19 && k <= 22
}

pub fn is_control(c: u32) -> bool {
    category_index(c) == 26
}

pub fn is_alphanumeric(c: u32) -> bool {
    let k = category_index(c)
    k >= 1 && k <= 5 || k >= 9 && k <= 11
}

pub fn is_space(c: u32) -> bool {
    flag(c, 21)
}

pub fn is_identifier_start(c: u32) -> bool {
    flag(c, 22)
}

pub fn is_identifier_continue(c: u32) -> bool {
    flag(c, 23)
}

pub fn east_asian_width(c: u32) -> Width {
    match props(c) >> 5 & 7 {
        == 1 => Ambiguous
        == 2 => Fullwidth
        == 3 => Halfwidth
        == 4 => Narrow
        == 5 => Wide
        _ => Neutral
    }
}

pub fn script(c: u32) -> Script {
    match props(c) >> 8 & 63 {
        == 1 => Common
        == 2 => Inherited
        == 3 => Latin
        == 4 => Greek
        == 5 => Cyrillic
        == 6 => Armenian
        == 7 => Hebrew
        == 8 => Arabic
        == 9 => Syriac
        == 10 => Thaana
        == 11 => Devanagari
        == 12 => Bengali
        == 13 => Gurmukhi
        == 14 => Gujarati
        == 15 => Tamil
        == 16 => Telugu
        == 17 => Kannada
        == 18 => Malayalam
        == 19 => Sinhala
        == 20 => Thai
        == 21 => Lao
        == 22 => Tibetan
        == 23 => Myanmar
        == 24 => Georgian
        == 25 => Hangul
        == 26 => Ethiopic
        == 27 => Khmer
        == 28 => Mongolian
        == 29 => Hiragana
        == 30 => Katakana
        == 31 => Bopomofo
        == 32 => Han
        == 33 => Other
        _ => Unknown
    }
}

fn zero_width(c: u32, p: u32) -> bool {
    let k = p & 31
    if c == 0xAD {
        return false
    }
    k == 6 || k == 8 || k == 26 || k == 27 || c >= 0x1160 && c <= 0x11FF || c >= 0xD7B0 && c <= 0xD7FF
}

pub fn display_width(c: u32) -> i64 {
    let p = props(c)
    if zero_width(c, p) {
        return 0
    }
    let width = p >> 5 & 7
    if width == 2 || width == 5 {
        return 2
    }
    1
}

pub fn text_width(s: str) -> i64 {
    var total = 0
    for c in s {
        total += display_width(c)
    }
    total
}
