import std/io

fn break_record(c: u32) -> u32 {
    let id = folded_trie_record(breaks_index_table(), breaks_blocks_table(), breaks_block_shift(), breaks_block_mask(), c)
    u32(io.u16_le_str(breaks_records_table(), id * breaks_record_size()))
}

fn break_flag(record: u32, shift: i64) -> bool {
    record >> shift & 1 == 1
}

fn line_class(record: u32) -> i64 {
    i64(record >> break_line_shift() & break_line_mask())
}

fn word_class(record: u32) -> i64 {
    i64(record >> break_word_shift() & break_word_mask())
}
