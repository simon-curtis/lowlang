import std/text

fn case_delta(c: u32, field: i64) -> i64 {
    let index = embed("case_index.bin")
    let block = i64(c >> 7)
    if block * 2 >= index.len {
        return 0
    }
    let blocks = embed("case_blocks.bin")
    let start = u16_at(index, block * 2) << 7
    let id = u16_at(blocks, (start + i64(c & 127)) * 2)
    i64(i32(u32_at(embed("case_records.bin"), id * 12 + field * 4)))
}

fn mapped_case(c: u32, field: i64) -> u32 {
    u32(i64(c) + case_delta(c, field))
}

/// Returns the simple uppercase mapping of the code point `c`, or `c` when it has none.
/// The mapping is always a single code point, so `ß` is unchanged. Use `upper` for strings.
pub fn to_upper(c: u32) -> u32 {
    if c < 0x80 {
        return if c >= 'a' && c <= 'z' { c - 32 } else { c }
    }
    mapped_case(c, 0)
}

/// Returns the simple lowercase mapping of the code point `c`, or `c` when it has none.
pub fn to_lower(c: u32) -> u32 {
    if c < 0x80 {
        return if c >= 'A' && c <= 'Z' { c + 32 } else { c }
    }
    mapped_case(c, 1)
}

/// Returns the simple titlecase mapping of the code point `c`, or `c` when it has none.
/// For `ǆ` this is `ǅ` rather than the uppercase `Ǆ`.
pub fn to_title(c: u32) -> u32 {
    if c < 0x80 {
        return to_upper(c)
    }
    mapped_case(c, 2)
}

fn special_index(c: u32) -> i64 {
    let entries = embed("special.bin")
    var low = 0
    var high = entries.len / 16
    for low < high {
        let middle = (low + high) / 2
        let probe = u32_at(entries, middle * 16)
        if probe == c {
            return middle
        }
        if probe < c {
            low = middle + 1
        } else {
            high = middle
        }
    }
    -1
}

fn append_special(mut out: []u32, entry: i64, field: i64) {
    let entries = embed("special.bin")
    let pool = embed("special_pool.bin")
    let at = u16_at(entries, entry * 16 + 4 + field * 4)
    let len = u16_at(entries, entry * 16 + 6 + field * 4)
    for k in 0..len {
        push(mut out, u32_at(pool, (at + k) * 4))
    }
}

fn convert(s: str, field: i64) -> str {
    var out: []u32 = []
    for c in s {
        let entry = if c >= 0xDF { special_index(c) } else { -1 }
        if entry >= 0 {
            append_special(mut out, entry, field)
        } else {
            push(mut out, mapped_case(c, field))
        }
    }
    encode(out)
}

/// Returns `s` with every letter in its Unicode uppercase form.
/// Full mappings are applied, so one character can become several: `ß` becomes `SS`. Mappings do not depend on locale or context. An ASCII string is handled as `text.upper` does.
pub fn upper(s: str) -> str {
    if ascii(s) {
        return text.upper(s)
    }
    convert(s, 0)
}

/// Returns `s` with every letter in its Unicode lowercase form.
/// Full mappings are applied and do not depend on locale or context, so `Σ` always becomes `σ`. An ASCII string is handled as `text.lower` does.
pub fn lower(s: str) -> str {
    if ascii(s) {
        return text.lower(s)
    }
    convert(s, 1)
}
