import std/text

struct Mapping {
    at: i64
    len: i64
}

fn u16_at(s: str, at: i64) -> i64 {
    i64(s[at]) | i64(s[at + 1]) << 8
}

fn u32_at(s: str, at: i64) -> u32 {
    u32(s[at]) | u32(s[at + 1]) << 8 | u32(s[at + 2]) << 16 | u32(s[at + 3]) << 24
}

fn record(c: u32) -> i64 {
    let stage1 = embed("stage1.bin")
    let block = i64(c >> 6)
    if block * 2 >= stage1.len {
        return 0
    }
    let stage2 = embed("stage2.bin")
    let start = u16_at(stage1, block * 2) << 6
    u16_at(stage2, (start + i64(c & 63)) * 2)
}

fn mapping(c: u32, field: i64) -> Mapping {
    let records = embed("records.bin")
    let base = record(c) * 10
    Mapping { at: u16_at(records, base + 4 + field * 2), len: i64(records[base + 1 + field]) }
}

fn mapped(m: Mapping, k: i64) -> u32 {
    let pool = embed("mappings.bin")
    u32_at(pool, (m.at + k) * 4)
}

fn append_mapping(mut out: []u32, m: Mapping) {
    for k in 0..m.len {
        push(mut out, mapped(m, k))
    }
}

/// Returns the Unicode canonical combining class of `c`, from `0` to `254`.
/// `0` marks a starter, and is also the value for an unassigned code point and for one above `0x10FFFF`.
pub fn combining_class(c: u32) -> u8 {
    let records = embed("records.bin")
    records[record(c) * 10]
}

fn hangul(c: u32) -> bool {
    c >= 0xAC00 && c < 0xAC00 + 11172
}

fn decompose_hangul(mut out: []u32, c: u32) {
    let index = c - 0xAC00
    push(mut out, 0x1100 + index / 588)
    push(mut out, 0x1161 + index % 588 / 28)
    let trailing = index % 28
    if trailing != 0 {
        push(mut out, 0x11A7 + trailing)
    }
}

fn decompose_into(mut out: []u32, c: u32, compat: bool) {
    if c < 0xC0 && (!compat || c < 0xA0) {
        push(mut out, c)
        return
    }
    if hangul(c) {
        decompose_hangul(mut out, c)
        return
    }
    let m = mapping(c, if compat { 1 } else { 0 })
    if m.len == 0 {
        push(mut out, c)
        return
    }
    append_mapping(mut out, m)
}

fn fold_into(mut out: []u32, c: u32) {
    if c < 0x80 {
        push(mut out, u32(text.lower_byte(u8(c))))
        return
    }
    let m = mapping(c, 2)
    if m.len == 0 {
        push(mut out, c)
        return
    }
    append_mapping(mut out, m)
}

fn reorder(cs: []u32) {
    for i in 1..cs.len {
        let c = cs[i]
        let class = combining_class(c)
        if class == 0 {
            continue
        }
        var j = i
        for j > 0 && combining_class(cs[j - 1]) > class {
            cs[j] = cs[j - 1]
            j -= 1
        }
        cs[j] = c
    }
}

fn decomposed(s: str, compat: bool) -> []u32 {
    var out: []u32 = []
    for c in s {
        decompose_into(mut out, c, compat)
    }
    reorder(out)
    out
}

fn encode(cs: []u32) -> str {
    var out: []u8 = []
    for c in cs {
        text.append_char(mut out, c)
    }
    __str_view(out)
}

fn ascii(s: str) -> bool {
    for i in 0..s.len {
        if s[i] >= 0x80 {
            return false
        }
    }
    true
}

fn compose_pair(a: u32, b: u32) -> u32 {
    if a >= 0x1100 && a < 0x1113 && b >= 0x1161 && b < 0x1176 {
        return 0xAC00 + ((a - 0x1100) * 21 + b - 0x1161) * 28
    }
    if hangul(a) && (a - 0xAC00) % 28 == 0 && b > 0x11A7 && b < 0x11C3 {
        return a + b - 0x11A7
    }
    let pairs = embed("compositions.bin")
    let key = u64(a) << 32 | u64(b)
    var low = 0
    var high = pairs.len / 12
    for low < high {
        let middle = (low + high) / 2
        let at = middle * 12
        let probe = u64(u32_at(pairs, at)) << 32 | u64(u32_at(pairs, at + 4))
        if probe == key {
            return u32_at(pairs, at + 8)
        }
        if probe < key {
            low = middle + 1
        } else {
            high = middle
        }
    }
    0
}

fn compose(cs: []u32) -> []u32 {
    if cs.len == 0 {
        return cs
    }
    var starter = 0
    var last = i64(combining_class(cs[0]))
    if last != 0 {
        last = 256
    }
    var kept = 1
    for i in 1..cs.len {
        let c = cs[i]
        let class = i64(combining_class(c))
        let composite = compose_pair(cs[starter], c)
        if composite != 0 && (last < class || last == 0) {
            cs[starter] = composite
            continue
        }
        if class == 0 {
            starter = kept
        }
        last = class
        cs[kept] = c
        kept += 1
    }
    cs[..kept]
}

/// Returns `s` in Unicode normalisation form D: canonical decomposition with combining marks in canonical order.
/// Hangul syllables decompose into jamo. An ASCII string is returned as it is.
pub fn nfd(s: str) -> str {
    if ascii(s) {
        return s
    }
    decomposed(s, false) |> encode
}

/// Returns `s` in normalisation form KD: compatibility decomposition with combining marks in canonical order.
/// Compatibility forms such as `ﬁ` and `²` become their plain equivalents. An ASCII string is returned as it is.
pub fn nfkd(s: str) -> str {
    if ascii(s) {
        return s
    }
    decomposed(s, true) |> encode
}

/// Returns `s` in normalisation form C: canonical decomposition followed by canonical composition.
/// Jamo compose into Hangul syllables. An ASCII string is returned as it is.
pub fn nfc(s: str) -> str {
    if ascii(s) {
        return s
    }
    decomposed(s, false) |> compose |> encode
}

/// Returns `s` in normalisation form KC: compatibility decomposition followed by canonical composition.
/// An ASCII string is returned as it is.
pub fn nfkc(s: str) -> str {
    if ascii(s) {
        return s
    }
    decomposed(s, true) |> compose |> encode
}

fn folded(s: str) -> []u32 {
    var out: []u32 = []
    for c in s {
        fold_into(mut out, c)
    }
    out
}

/// Returns the Unicode full case folding of `s`, for caseless comparison.
/// Folded strings of two texts are equal when the texts match without regard to case, and one code point may fold to several, so `ß` becomes `ss`. An ASCII string is lowercased. Combining marks are kept, so apply `nfc` or `nfd` to both sides when canonically equivalent forms must match.
pub fn casefold(s: str) -> str {
    if ascii(s) {
        return text.lower(s)
    }
    folded(s) |> encode
}

/// Returns a key for accent- and case-insensitive searching of `s`.
/// `s` is case folded, decomposed with the compatibility mappings and stripped of every code point with a non-zero combining class, so `Café` and `cafe` give the same key. An ASCII string is lowercased.
pub fn search_key(s: str) -> str {
    if ascii(s) {
        return text.lower(s)
    }
    var parts: []u32 = []
    for c in folded(s) {
        decompose_into(mut parts, c, true)
    }
    var out: []u8 = []
    for c in parts {
        if combining_class(c) == 0 {
            text.append_char(mut out, c)
        }
    }
    __str_view(out)
}
