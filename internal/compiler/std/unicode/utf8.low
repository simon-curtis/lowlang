import std/text

pub struct Rune {
    pub code: u32
    pub size: i64
}

fn continuation(s: str, i: i64) -> bool {
    i < s.len && s[i] & 0xC0 == 0x80
}

fn decode_at(s: str, i: i64) -> Rune {
    let b0 = u32(s[i])
    if b0 < 0x80 {
        return Rune { code: b0, size: 1 }
    }
    if b0 >= 0xC2 && b0 < 0xE0 && continuation(s, i + 1) {
        let code = (b0 & 0x1F) << 6 | u32(s[i + 1]) & 0x3F
        return Rune { code, size: 2 }
    }
    if b0 >= 0xE0 && b0 < 0xF0 && continuation(s, i + 1) && continuation(s, i + 2) {
        let code = (b0 & 0x0F) << 12 | (u32(s[i + 1]) & 0x3F) << 6 | u32(s[i + 2]) & 0x3F
        if code >= 0x800 && valid_rune(code) {
            return Rune { code, size: 3 }
        }
    }
    if b0 >= 0xF0 && b0 < 0xF5 && continuation(s, i + 1) && continuation(s, i + 2) && continuation(s, i + 3) {
        let high = (b0 & 0x07) << 18 | (u32(s[i + 1]) & 0x3F) << 12
        let code = high | (u32(s[i + 2]) & 0x3F) << 6 | u32(s[i + 3]) & 0x3F
        if code >= 0x10000 && code <= 0x10FFFF {
            return Rune { code, size: 4 }
        }
    }
    Rune { code: 0xFFFD, size: 1 }
}

pub fn decode_rune(s: str, at: i64) -> Rune {
    if at < 0 || at >= s.len {
        return Rune { code: 0xFFFD, size: 0 }
    }
    decode_at(s, at)
}

pub fn valid_rune(c: u32) -> bool {
    c < 0xD800 || c >= 0xE000 && c <= 0x10FFFF
}

pub fn rune_len(c: u32) -> i64 {
    if !valid_rune(c) {
        return -1
    }
    if c < 0x80 {
        return 1
    }
    if c < 0x800 {
        return 2
    }
    if c < 0x10000 {
        return 3
    }
    4
}

pub fn encode_rune(c: u32) -> str {
    let point = if valid_rune(c) { c } else { 0xFFFD }
    text.from_char(point)
}

pub fn utf8_invalid_at(s: str) -> i64 {
    var at = 0
    for at < s.len {
        let r = decode_at(s, at)
        if r.size == 1 && r.code == 0xFFFD {
            return at
        }
        at += r.size
    }
    -1
}

pub fn utf8_valid(s: str) -> bool {
    utf8_invalid_at(s) < 0
}

pub fn utf8_to_valid(s: str) -> str {
    if utf8_valid(s) {
        return s
    }
    var out: []u8 = []
    for c in s {
        text.append_char(mut out, c)
    }
    __str_view(out)
}
