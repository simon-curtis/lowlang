import std/text

/// A code point decoded from UTF-8 together with the number of bytes it took.
pub struct Rune {
    /// The decoded code point, or `0xFFFD` when the bytes are not valid UTF-8.
    pub code: u32
    /// The number of bytes the code point occupies: `1` to `4`, `1` for an invalid byte, and `0` when the position is out of range.
    pub size: i64
}

fn continuation(s: str, i: i64) -> bool {
    i < s.len && s[i] & 0xC0 == 0x80
}

fn decode_at(s: str, i: i64) -> Rune {
    let b0 = u32(s[i])
    if b0 < 0x80 {
        return Rune { code: b0, size: 1 }
    }
    if b0 >= 0xC2 && b0 < 0xE0 && continuation(s, i + 1) {
        let code = (b0 & 0x1F) << 6 | u32(s[i + 1]) & 0x3F
        return Rune { code, size: 2 }
    }
    if b0 >= 0xE0 && b0 < 0xF0 && continuation(s, i + 1) && continuation(s, i + 2) {
        let code = (b0 & 0x0F) << 12 | (u32(s[i + 1]) & 0x3F) << 6 | u32(s[i + 2]) & 0x3F
        if code >= 0x800 && valid_rune(code) {
            return Rune { code, size: 3 }
        }
    }
    if b0 >= 0xF0 && b0 < 0xF5 && continuation(s, i + 1) && continuation(s, i + 2) && continuation(s, i + 3) {
        let high = (b0 & 0x07) << 18 | (u32(s[i + 1]) & 0x3F) << 12
        let code = high | (u32(s[i + 2]) & 0x3F) << 6 | u32(s[i + 3]) & 0x3F
        if code >= 0x10000 && code <= 0x10FFFF {
            return Rune { code, size: 4 }
        }
    }
    Rune { code: 0xFFFD, size: 1 }
}

/// Decodes the code point that starts at byte index `at` of `s`.
/// Overlong forms, surrogates and values above `0x10FFFF` are invalid. An invalid byte gives `0xFFFD` with size `1`, and an index outside `s` gives `0xFFFD` with size `0`.
pub fn decode_rune(s: str, at: i64) -> Rune {
    if at < 0 || at >= s.len {
        return Rune { code: 0xFFFD, size: 0 }
    }
    decode_at(s, at)
}

/// Returns whether `c` is a Unicode scalar value: not a surrogate and not above `0x10FFFF`.
pub fn valid_rune(c: u32) -> bool {
    c < 0xD800 || c >= 0xE000 && c <= 0x10FFFF
}

/// Returns the number of bytes `c` takes in UTF-8, from `1` to `4`, or `-1` when `c` is not a valid code point.
pub fn rune_len(c: u32) -> i64 {
    if !valid_rune(c) {
        return -1
    }
    if c < 0x80 {
        return 1
    }
    if c < 0x800 {
        return 2
    }
    if c < 0x10000 {
        return 3
    }
    4
}

/// Returns the UTF-8 encoding of `c` as a string, using U+FFFD when `c` is not a valid code point.
pub fn encode_rune(c: u32) -> str {
    let point = if valid_rune(c) { c } else { 0xFFFD }
    text.from_char(point)
}

/// Returns the byte index of the first invalid UTF-8 sequence in `s`, or `-1` when `s` is valid.
pub fn utf8_invalid_at(s: str) -> i64 {
    var at = 0
    for at < s.len {
        let r = decode_at(s, at)
        if r.size == 1 && r.code == 0xFFFD {
            return at
        }
        at += r.size
    }
    -1
}

/// Returns whether `s` is valid UTF-8.
pub fn utf8_valid(s: str) -> bool {
    utf8_invalid_at(s) < 0
}

/// Returns `s` with each invalid byte replaced by U+FFFD.
/// Returns `s` itself when it is already valid.
pub fn utf8_to_valid(s: str) -> str {
    if utf8_valid(s) {
        return s
    }
    var out: []u8 = []
    for c in s {
        text.append_char(mut out, c)
    }
    __str_view(out)
}
