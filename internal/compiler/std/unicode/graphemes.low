struct Cluster {
    last: i64
    regional: i64
    pictographic: i64
    conjunct: i64
}

fn break_class(p: u32) -> i64 {
    i64(p >> property_break_shift() & property_break_mask())
}

fn conjunct_class(p: u32) -> i64 {
    i64(p >> property_conjunct_shift() & property_conjunct_mask())
}

fn is_newline(class: i64) -> bool {
    class == break_cr() || class == break_lf() || class == break_control()
}

fn emoji_run() -> i64 {
    1
}

fn emoji_joined() -> i64 {
    2
}

fn pictographic(p: u32) -> bool {
    p >> property_pictographic_shift() & 1 == 1
}

fn hangul_joins(last: i64, next: i64) -> bool {
    if last == break_l() {
        return next == break_l() || next == break_v() || next == break_lv() || next == break_lvt()
    }
    if last == break_lv() || last == break_v() {
        return next == break_v() || next == break_t()
    }
    (last == break_lvt() || last == break_t()) && next == break_t()
}

fn joins(st: Cluster, p: u32) -> bool {
    let next = break_class(p)
    let last = st.last
    if last == break_cr() && next == break_lf() {
        return true
    }
    if is_newline(last) || is_newline(next) {
        return false
    }
    if hangul_joins(last, next) {
        return true
    }
    if next == break_extend() || next == break_zwj() || next == break_spacingmark() || last == break_prepend() {
        return true
    }
    if st.conjunct == conjunct_linker() && conjunct_class(p) == conjunct_consonant() {
        return true
    }
    if st.pictographic == emoji_joined() && pictographic(p) {
        return true
    }
    last == break_regional_indicator() && next == break_regional_indicator() && st.regional % 2 == 1
}

fn next_pictographic(st: Cluster, p: u32) -> i64 {
    let next = break_class(p)
    if pictographic(p) {
        return emoji_run()
    }
    if next == break_extend() && st.pictographic == emoji_run() {
        return emoji_run()
    }
    if next == break_zwj() && st.pictographic == emoji_run() {
        return emoji_joined()
    }
    0
}

fn next_conjunct(st: Cluster, p: u32) -> i64 {
    let class = conjunct_class(p)
    if class == conjunct_consonant() {
        return conjunct_consonant()
    }
    if st.conjunct == conjunct_none() {
        return conjunct_none()
    }
    if class == conjunct_linker() {
        return conjunct_linker()
    }
    if class == conjunct_extend() {
        return st.conjunct
    }
    conjunct_none()
}

fn advance(mut st: Cluster, p: u32) -> bool {
    let joined = joins(st, p)
    let next = break_class(p)
    st.pictographic = next_pictographic(st, p)
    st.conjunct = next_conjunct(st, p)
    st.regional = if next == break_regional_indicator() { st.regional + 1 } else { 0 }
    st.last = next
    joined
}

/// Returns the byte index where the extended grapheme cluster that starts at `at` in `s` ends.
/// Clusters follow Unicode Standard Annex 29: CR LF, combining marks, Hangul syllable sequences, emoji with variation selectors and zero-width-joiner sequences, regional-indicator pairs and Indic conjunct sequences stay together. `at` must be at the start of a character. The last cluster ends at `s.len`.
pub fn grapheme_end(s: str, at: i64) -> i64 {
    var st = Cluster { last: 0, regional: 0, pictographic: 0, conjunct: 0 }
    for i, c in s[at..] {
        let joined = advance(mut st, props(c))
        if i > 0 && !joined {
            return at + i
        }
    }
    s.len
}

/// Returns the extended grapheme clusters of `s` as substrings.
/// The pieces are slices of `s` and joining them gives `s` back.
pub fn graphemes(s: str) -> []str {
    var out: []str = []
    var at = 0
    for at < s.len {
        let end = grapheme_end(s, at)
        push(mut out, s[at..end])
        at = end
    }
    out
}

/// Returns the number of extended grapheme clusters in `s`.
pub fn grapheme_count(s: str) -> i64 {
    var count = 0
    var at = 0
    for at < s.len {
        at = grapheme_end(s, at)
        count += 1
    }
    count
}
