struct Cluster {
    last: i64
    regional: i64
    pictographic: i64
    conjunct: i64
}

fn break_class(p: u32) -> i64 {
    i64(p >> 14 & 15)
}

fn conjunct_class(p: u32) -> i64 {
    i64(p >> 18 & 3)
}

fn pictographic(p: u32) -> bool {
    p >> 20 & 1 == 1
}

fn hangul_joins(last: i64, next: i64) -> bool {
    if last == 9 {
        return next == 9 || next == 10 || next == 12 || next == 13
    }
    if last == 12 || last == 10 {
        return next == 10 || next == 11
    }
    (last == 13 || last == 11) && next == 11
}

fn joins(st: Cluster, p: u32) -> bool {
    let next = break_class(p)
    let last = st.last
    if last == 1 && next == 2 {
        return true
    }
    if last >= 1 && last <= 3 || next >= 1 && next <= 3 {
        return false
    }
    if hangul_joins(last, next) {
        return true
    }
    if next == 4 || next == 5 || next == 8 || last == 7 {
        return true
    }
    if st.conjunct == 2 && conjunct_class(p) == 1 {
        return true
    }
    if st.pictographic == 2 && pictographic(p) {
        return true
    }
    last == 6 && next == 6 && st.regional % 2 == 1
}

fn next_pictographic(st: Cluster, p: u32) -> i64 {
    let next = break_class(p)
    if pictographic(p) {
        return 1
    }
    if next == 4 && st.pictographic == 1 {
        return 1
    }
    if next == 5 && st.pictographic == 1 {
        return 2
    }
    0
}

fn next_conjunct(st: Cluster, p: u32) -> i64 {
    let class = conjunct_class(p)
    if class == 1 {
        return 1
    }
    if st.conjunct == 0 {
        return 0
    }
    if class == 2 {
        return 2
    }
    if class == 3 {
        return st.conjunct
    }
    0
}

fn advance(mut st: Cluster, p: u32) -> bool {
    let joined = joins(st, p)
    let next = break_class(p)
    st.pictographic = next_pictographic(st, p)
    st.conjunct = next_conjunct(st, p)
    st.regional = if next == 6 { st.regional + 1 } else { 0 }
    st.last = next
    joined
}

/// Returns the byte index where the extended grapheme cluster that starts at `at` in `s` ends.
/// Clusters follow Unicode Standard Annex 29: CR LF, combining marks, Hangul syllable sequences, emoji with variation selectors and zero-width-joiner sequences, regional-indicator pairs and Indic conjunct sequences stay together. `at` must be at the start of a character. The last cluster ends at `s.len`.
pub fn grapheme_end(s: str, at: i64) -> i64 {
    var st = Cluster { last: 0, regional: 0, pictographic: 0, conjunct: 0 }
    for i, c in s[at..] {
        let joined = advance(mut st, props(c))
        if i > 0 && !joined {
            return at + i
        }
    }
    s.len
}

/// Returns the extended grapheme clusters of `s` as substrings.
/// The pieces are slices of `s` and joining them gives `s` back.
pub fn graphemes(s: str) -> []str {
    var out: []str = []
    var at = 0
    for at < s.len {
        let end = grapheme_end(s, at)
        push(mut out, s[at..end])
        at = end
    }
    out
}

/// Returns the number of extended grapheme clusters in `s`.
pub fn grapheme_count(s: str) -> i64 {
    var count = 0
    var at = 0
    for at < s.len {
        at = grapheme_end(s, at)
        count += 1
    }
    count
}
