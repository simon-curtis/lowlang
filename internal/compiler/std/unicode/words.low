struct WordScan {
    last: i64
    prev: i64
    before: i64
    regional: i64
}

fn no_word_class() -> i64 {
    -1
}

fn letter_class(cls: i64) -> bool {
    cls == word_aletter() || cls == word_hebrew_letter()
}

fn mid_num_let_quote(cls: i64) -> bool {
    cls == word_midnumlet() || cls == word_single_quote()
}

fn letter_infix(cls: i64) -> bool {
    cls == word_midletter() || mid_num_let_quote(cls)
}

fn number_infix(cls: i64) -> bool {
    cls == word_midnum() || mid_num_let_quote(cls)
}

fn word_ignored(cls: i64) -> bool {
    cls == word_extend() || cls == word_format() || cls == word_zwj()
}

fn is_word_newline(cls: i64) -> bool {
    cls == word_newline() || cls == word_cr() || cls == word_lf()
}

fn word_after(s: str, at: i64) -> i64 {
    var pos = at + decode_rune(s, at).size
    for pos < s.len {
        let r = decode_rune(s, pos)
        let cls = word_class(break_record(r.code))
        if !word_ignored(cls) {
            return cls
        }
        pos += r.size
    }
    no_word_class()
}

fn word_joins_letters(s: str, at: i64, st: WordScan, cls: i64) -> bool {
    let prev = st.prev
    if letter_class(prev) && letter_class(cls) {
        return true
    }
    if letter_class(prev) && letter_infix(cls) && letter_class(word_after(s, at)) {
        return true
    }
    if letter_class(st.before) && letter_infix(prev) && letter_class(cls) {
        return true
    }
    if prev == word_hebrew_letter() && cls == word_single_quote() {
        return true
    }
    if prev == word_hebrew_letter() && cls == word_double_quote() && word_after(s, at) == word_hebrew_letter() {
        return true
    }
    st.before == word_hebrew_letter() && prev == word_double_quote() && cls == word_hebrew_letter()
}

fn word_joins_numbers(s: str, at: i64, st: WordScan, cls: i64) -> bool {
    let prev = st.prev
    if prev == word_numeric() && cls == word_numeric() {
        return true
    }
    if letter_class(prev) && cls == word_numeric() {
        return true
    }
    if prev == word_numeric() && letter_class(cls) {
        return true
    }
    if st.before == word_numeric() && number_infix(prev) && cls == word_numeric() {
        return true
    }
    prev == word_numeric() && number_infix(cls) && word_after(s, at) == word_numeric()
}

fn extends_word(cls: i64) -> bool {
    letter_class(cls) || cls == word_numeric() || cls == word_katakana()
}

fn word_joins_extenders(st: WordScan, cls: i64) -> bool {
    let prev = st.prev
    if prev == word_katakana() && cls == word_katakana() {
        return true
    }
    if (extends_word(prev) || prev == word_extendnumlet()) && cls == word_extendnumlet() {
        return true
    }
    if prev == word_extendnumlet() && extends_word(cls) {
        return true
    }
    prev == word_regional_indicator() && cls == word_regional_indicator() && st.regional % 2 == 1
}

fn word_joins(s: str, at: i64, st: WordScan, rec: u32) -> bool {
    let cls = word_class(rec)
    if st.last == word_cr() && cls == word_lf() {
        return true
    }
    if is_word_newline(st.last) || is_word_newline(cls) {
        return false
    }
    if st.last == word_zwj() && break_flag(rec, break_pictographic_shift()) {
        return true
    }
    if st.last == word_wsegspace() && cls == word_wsegspace() {
        return true
    }
    if word_ignored(cls) {
        return true
    }
    word_joins_letters(s, at, st, cls) || word_joins_numbers(s, at, st, cls) || word_joins_extenders(st, cls)
}

fn word_advance(mut st: WordScan, cls: i64, joined: bool) {
    st.last = cls
    if joined && word_ignored(cls) {
        return
    }
    st.before = st.prev
    st.prev = cls
    st.regional = if cls == word_regional_indicator() { st.regional + 1 } else { 0 }
}

/// Returns the byte index where the word segment that starts at `at` in `s` ends.
/// Segments follow the default word boundaries of Unicode Standard Annex 29: letters, numbers and the punctuation inside them such as `can't`, `3.14` and `example.com` stay together, katakana runs and `_` joins stay together, regional-indicator pairs stay together, and each ideograph, space run, punctuation mark and line break is its own segment. `at` must be at the start of a character. The last segment ends at `s.len`.
pub fn word_end(s: str, at: i64) -> i64 {
    var st = WordScan { last: no_word_class(), prev: no_word_class(), before: no_word_class(), regional: 0 }
    for i, c in s[at..] {
        let rec = break_record(c)
        let joined = i > 0 && word_joins(s, at + i, st, rec)
        if i > 0 && !joined {
            return at + i
        }
        word_advance(mut st, word_class(rec), joined)
    }
    s.len
}

/// Returns the word segments of `s` as substrings.
/// The segments cover all of `s`, spaces and punctuation included, so joining them gives `s` back.
pub fn words(s: str) -> []str {
    var out: []str = []
    var at = 0
    for at < s.len {
        let end = word_end(s, at)
        push(mut out, s[at..end])
        at = end
    }
    out
}
