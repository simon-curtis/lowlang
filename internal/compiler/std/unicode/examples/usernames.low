import std/text
import std/unicode

fn identity(name: str) -> str {
    unicode.nfc(unicode.casefold(unicode.nfc(name)))
}

/// Registers display names under a canonical identity so spellings that differ only in case or composition collide, and builds a search key that also ignores accents.
fn main() {
    let acute = unicode.encode_rune(0x301)
    let names = ["José", "Jose{acute}", "JOSÉ", "jose", "Straße", "STRASSE"]

    var taken: [str: str] = [:]
    for name in names {
        let key = identity(name)
        let owner = taken[key] ?? ""
        if owner == "" {
            taken[key] = name
            print("{name,-8} registered as {key}")
        } else {
            print("{name,-8} collides with {owner}")
        }
    }

    let composed = "José"
    let decomposed = "Jose{acute}"
    print("{composed.len} bytes, {decomposed.len} bytes, equal {composed == decomposed}")
    let nfd = unicode.nfd(composed)
    print("nfd {nfd.len} bytes, nfc of decomposed equals composed: {unicode.nfc(decomposed) == composed}")

    let catalogue = ["Crème brûlée", "Cafe au lait", "Éclair"]
    let query = unicode.search_key("CREME")
    for item in catalogue {
        let key = unicode.search_key(item)
        if text.starts_with(key, query) {
            print("match: {item}")
        }
    }

    print(unicode.upper("Straße"))
    print(unicode.lower("ΣΑΣ"))
    let compat = unicode.nfkc("ﬁnal ²")
    print(compat)
}
