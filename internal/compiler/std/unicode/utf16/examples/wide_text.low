import std/text
import std/unicode
import std/unicode/utf16

fn show_units(label: str, units: []u16) {
    var hex: []str = []
    for u in units {
        push(mut hex, "{u:X4}")
    }
    print("{label}: {text.join(hex, " ")}")
}

fn read_escapes(s: str) {
    var at = 0
    var out: []u32 = []
    for at < s.len {
        if s[at] != '\\' {
            at += 1
            continue
        }
        let escape = utf16.decode_escape(s, at + 2) catch {
            BadDigit(i) => {
                print("bad digit at {i}")
                return
            }
            e => {
                print("{e}")
                return
            }
        }
        push(mut out, escape.code)
        at += 2 + escape.length
    }
    var parts: []str = []
    for c in out {
        push(mut parts, "U+{c:X}")
    }
    print(text.join(parts, " "))
}

fn strict(units: []u16) -> str {
    let decoded = utf16.decode(units) catch {
        LoneSurrogate(at) => {
            return "lone surrogate at unit {at}"
        }
        OddLength => {
            return "odd length"
        }
    }
    decoded
}

/// Converts text to the UTF-16 forms that Windows APIs and JSON escapes use, and reads them back, including damaged input.
fn main() {
    let word = "Aé€😀"
    let units = utf16.encode(word)
    print("{word.len} bytes, {units.len} code units")
    show_units("units", units)

    let little = utf16.encode_bytes(word, unicode.Order.Little, true)
    let big = utf16.encode_bytes(word, unicode.Order.Big, false)
    print("little with mark: {text.encode_hex(little)}")
    print("big without mark: {text.encode_hex(big)}")

    let from_little = utf16.decode_bytes(little, unicode.Order.Big) or "?"
    let from_big = utf16.decode_bytes(big, unicode.Order.Big) or "?"
    print("mark overrides the given order: {from_little}; no mark: {from_big}")

    read_escapes("\\u0041\\u00e9\\u20ac\\ud83d\\ude00")
    read_escapes("\\u00e9\\u12g4")

    let broken = [u16(0x41), 0xD83D, 0x42, 0xDE00]
    print(strict(broken))
    print(utf16.decode_lossy(broken))
    let odd = utf16.decode_bytes(little[..5], unicode.Order.Little) catch {
        OddLength => {
            print("odd number of bytes")
            return
        }
        LoneSurrogate(at) => {
            print("lone surrogate at unit {at}")
            return
        }
    }
    print(odd)
}
