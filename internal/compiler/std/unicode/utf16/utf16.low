import std/text
import std/unicode

pub enum Error {
    LoneSurrogate(at: i64)
    OddLength
}

pub enum Order {
    Little
    Big
}

pub struct Unit {
    pub code: u32
    pub size: i64
}

pub fn is_surrogate(u: u16) -> bool {
    u >= 0xD800 && u < 0xE000
}

pub fn is_high_surrogate(u: u16) -> bool {
    u >= 0xD800 && u < 0xDC00
}

pub fn is_low_surrogate(u: u16) -> bool {
    u >= 0xDC00 && u < 0xE000
}

pub fn unit_count(c: u32) -> i64 {
    if c >= 0x10000 && c <= 0x10FFFF {
        return 2
    }
    1
}

pub fn decode_rune(units: []u16, at: i64) -> Unit {
    if at < 0 || at >= units.len {
        return Unit { code: 0xFFFD, size: 0 }
    }
    let first = units[at]
    if !is_surrogate(first) {
        return Unit { code: u32(first), size: 1 }
    }
    if is_high_surrogate(first) && at + 1 < units.len && is_low_surrogate(units[at + 1]) {
        let code = 0x10000 + ((u32(first) - 0xD800) << 10) + (u32(units[at + 1]) - 0xDC00)
        return Unit { code, size: 2 }
    }
    Unit { code: 0xFFFD, size: 1 }
}

pub fn encode_rune(mut out: []u16, c: u32) {
    if !unicode.valid_rune(c) {
        push(mut out, 0xFFFD)
        return
    }
    if c < 0x10000 {
        push(mut out, u16(c))
        return
    }
    let offset = c - 0x10000
    push(mut out, u16(0xD800 + (offset >> 10)))
    push(mut out, u16(0xDC00 + (offset & 0x3FF)))
}

pub fn encode(s: str) -> []u16 {
    var out: []u16 = []
    for c in s {
        encode_rune(mut out, c)
    }
    out
}

pub fn decode_lossy(units: []u16) -> str {
    var out: []u8 = []
    var at = 0
    for at < units.len {
        let r = decode_rune(units, at)
        text.append_char(mut out, r.code)
        at += r.size
    }
    __str_view(out)
}

pub fn decode(units: []u16) -> str ! Error {
    var out: []u8 = []
    var at = 0
    for at < units.len {
        let r = decode_rune(units, at)
        if is_surrogate(units[at]) && r.size == 1 {
            fail LoneSurrogate(at)
        }
        text.append_char(mut out, r.code)
        at += r.size
    }
    __str_view(out)
}

fn unit_at(data: []u8, at: i64, order: Order) -> u16 {
    let a = u16(data[at])
    let b = u16(data[at + 1])
    match order {
        Little => a | b << 8
        Big => a << 8 | b
    }
}

pub fn to_bytes(units: []u16, order: Order) -> []u8 {
    var out: []u8 = []
    for u in units {
        let high = u8(u >> 8)
        let low = u8(u & 0xFF)
        match order {
            Little => {
                push(mut out, low)
                push(mut out, high)
            }
            Big => {
                push(mut out, high)
                push(mut out, low)
            }
        }
    }
    out
}

fn units_of(data: []u8, order: Order) -> []u16 {
    var out: []u16 = []
    var at = 0
    for at + 1 < data.len {
        push(mut out, unit_at(data, at, order))
        at += 2
    }
    out
}

pub fn from_bytes(data: []u8, order: Order) -> []u16 ! Error {
    if data.len % 2 != 0 {
        fail OddLength
    }
    units_of(data, order)
}

pub fn encode_bytes(s: str, order: Order, bom: bool) -> []u8 {
    var units: []u16 = []
    if bom {
        push(mut units, 0xFEFF)
    }
    for c in s {
        encode_rune(mut units, c)
    }
    to_bytes(units, order)
}

fn has_bom(data: []u8) -> bool {
    data.len >= 2 && (data[0] == 0xFF && data[1] == 0xFE || data[0] == 0xFE && data[1] == 0xFF)
}

fn bom_order(data: []u8, order: Order) -> Order {
    if data.len >= 2 && data[0] == 0xFE && data[1] == 0xFF {
        return Big
    }
    if has_bom(data) {
        return Little
    }
    order
}

fn payload(data: []u8) -> []u8 {
    if has_bom(data) {
        return data[2..]
    }
    data
}

pub fn decode_bytes(data: []u8, order: Order) -> str ! Error {
    let body = payload(data)
    let units = from_bytes(body, bom_order(data, order))?
    decode(units)
}

pub fn decode_bytes_lossy(data: []u8, order: Order) -> str {
    let body = payload(data)
    let decoded = decode_lossy(units_of(body, bom_order(data, order)))
    if body.len % 2 == 1 {
        return "{decoded}{text.from_char(0xFFFD)}"
    }
    decoded
}
