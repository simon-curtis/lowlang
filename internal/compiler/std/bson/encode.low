import std/text

pub fn encode(fields: []Field) -> []u8 ! Error {
    var out: []u8 = []
    write_document(mut out, fields)?
    out
}

fn little_endian(mut out: []u8, n: u64, size: i64) {
    for i in 0..size {
        push(mut out, u8(n >> u64(8 * i)))
    }
}

fn append_bytes(mut out: []u8, data: []u8) {
    for b in data {
        push(mut out, b)
    }
}

fn write_cstring(mut out: []u8, s: str) ! Error {
    if text.index_byte(s, 0) >= 0 {
        fail BadName
    }
    text.append(mut out, s)
    push(mut out, 0)
}

fn write_string(mut out: []u8, s: str) {
    little_endian(mut out, u64(s.len + 1), 4)
    text.append(mut out, s)
    push(mut out, 0)
}

fn write_document(mut out: []u8, fields: []Field) ! Error {
    let start = out.len
    little_endian(mut out, 0, 4)
    for f in fields {
        write_field(mut out, f.name, f.value)?
    }
    push(mut out, 0)
    let size = u64(out.len - start)
    for i in 0..4 {
        out[start + i] = u8(size >> u64(8 * i))
    }
}

fn write_array(mut out: []u8, items: []Value) ! Error {
    var fields: []Field = []
    for i, item in items {
        push(mut fields, Field { name: "{i}", value: item })
    }
    write_document(mut out, fields)?
}

fn kind_of(v: Value) -> u8 {
    match v {
        Double(_) => 0x01
        Str(_) => 0x02
        Document(_) => 0x03
        Array(_) => 0x04
        Binary(_, _) => 0x05
        ObjectId(_) => 0x07
        Bool(_) => 0x08
        DateTime(_) => 0x09
        Null => 0x0A
        Regex(_, _) => 0x0B
        Int32(_) => 0x10
        Timestamp(_) => 0x11
        Int64(_) => 0x12
        Decimal128(_) => 0x13
        MaxKey => 0x7F
        MinKey => 0xFF
    }
}

fn write_field(mut out: []u8, name: str, v: Value) ! Error {
    push(mut out, kind_of(v))
    write_cstring(mut out, name)?
    write_value(mut out, v)?
}

fn write_value(mut out: []u8, v: Value) ! Error {
    match v {
        Double(x) => little_endian(mut out, text.float_bits(x), 8)
        Str(s) => write_string(mut out, s)
        Document(fields) => write_document(mut out, fields)?
        Array(items) => write_array(mut out, items)?
        Binary(subtype, data) => {
            little_endian(mut out, u64(data.len), 4)
            push(mut out, subtype)
            append_bytes(mut out, data)
        }
        ObjectId(bytes) => {
            if bytes.len != 12 {
                fail BadObjectId
            }
            append_bytes(mut out, bytes)
        }
        Bool(b) => push(mut out, if b { 1 } else { 0 })
        DateTime(millis) => little_endian(mut out, u64(millis), 8)
        Null => {}
        Regex(pattern, options) => {
            write_cstring(mut out, pattern)?
            write_cstring(mut out, options)?
        }
        Int32(n) => little_endian(mut out, u64(n), 4)
        Timestamp(n) => little_endian(mut out, n, 8)
        Int64(n) => little_endian(mut out, u64(n), 8)
        Decimal128(bytes) => {
            if bytes.len != 16 {
                fail BadDecimal
            }
            append_bytes(mut out, bytes)
        }
        MinKey => {}
        MaxKey => {}
    }
}
