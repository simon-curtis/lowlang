import std/crypto
import std/text

pub enum Value {
    Double(value: f64)
    Str(value: str)
    Document(fields: []Field)
    Array(items: []Value)
    Binary(subtype: u8, data: []u8)
    ObjectId(bytes: []u8)
    Bool(value: bool)
    DateTime(millis: i64)
    Null
    Regex(pattern: str, options: str)
    Int32(value: i32)
    Timestamp(value: u64)
    Int64(value: i64)
    Decimal128(bytes: []u8)
    MinKey
    MaxKey
}

pub struct Field {
    pub name: str
    pub value: Value
}

pub enum Error {
    Truncated(at: i64)
    BadLength(at: i64)
    BadType(at: i64, kind: u8)
    BadUtf8(at: i64)
    BadString(at: i64)
    BadBool(at: i64)
    TooDeep(at: i64)
    TooLong(at: i64)
    Trailing(at: i64)
    BadName
    BadObjectId
    BadDecimal
}

pub fn offset(e: Error) -> i64 {
    match e {
        Truncated(at) => at
        BadLength(at) => at
        BadType(at, _) => at
        BadUtf8(at) => at
        BadString(at) => at
        BadBool(at) => at
        TooDeep(at) => at
        TooLong(at) => at
        Trailing(at) => at
        _ => -1
    }
}

pub fn message(e: Error) -> str {
    let at = offset(e)
    match e {
        Truncated(_) => "truncated BSON at offset {at}"
        BadLength(_) => "inconsistent BSON length at offset {at}"
        BadType(_, kind) => "unsupported BSON type {kind} at offset {at}"
        BadUtf8(_) => "invalid UTF-8 in BSON at offset {at}"
        BadString(_) => "BSON string missing its terminator at offset {at}"
        BadBool(_) => "invalid BSON boolean at offset {at}"
        TooDeep(_) => "BSON nesting too deep at offset {at}"
        TooLong(_) => "BSON length over the limit at offset {at}"
        Trailing(_) => "trailing bytes after BSON document at offset {at}"
        BadName => "BSON field name contains a NUL byte"
        BadObjectId => "ObjectId must be 12 bytes or 24 hex digits"
        BadDecimal => "Decimal128 must be 16 bytes"
    }
}

pub fn get(fields: []Field, name: str) -> Value? {
    for f in fields {
        if f.name == name {
            return f.value
        }
    }
    none
}

pub fn new_object_id() -> Value {
    let seconds = __clock_nanos(0) / 1000000000
    var id: []u8 = crypto.random(12)
    for i in 0..4 {
        id[i] = u8(seconds >> (8 * (3 - i)) & 0xFF)
    }
    ObjectId(id)
}

pub fn object_id_hex(id: []u8) -> str {
    text.encode_hex(id)
}

pub fn parse_object_id(hex: str) -> Value ! Error {
    if hex.len != 24 {
        fail BadObjectId
    }
    let bytes = text.decode_hex(hex) catch {
        _ => fail BadObjectId
    }
    ObjectId(bytes)
}

pub fn object_id_seconds(id: []u8) -> i64 {
    var n = 0
    for i in 0..4 {
        n = n << 8 | i64(id[i])
    }
    n
}

pub fn diagnostic(fields: []Field) -> str {
    var out: []u8 = []
    describe_fields(mut out, fields)
    __str_view(out)
}

fn describe_fields(mut out: []u8, fields: []Field) {
    push(mut out, '{')
    for i, f in fields {
        if i > 0 {
            text.append(mut out, ", ")
        }
        quote(mut out, f.name)
        text.append(mut out, ": ")
        describe(mut out, f.value)
    }
    push(mut out, '}')
}

fn describe(mut out: []u8, v: Value) {
    match v {
        Double(x) => text.append(mut out, float_text(x))
        Str(s) => quote(mut out, s)
        Document(fields) => describe_fields(mut out, fields)
        Array(items) => {
            push(mut out, '[')
            for i, item in items {
                if i > 0 {
                    text.append(mut out, ", ")
                }
                describe(mut out, item)
            }
            push(mut out, ']')
        }
        Binary(subtype, data) => text.append(mut out, "bin({subtype}, h'{text.encode_hex(data)}')")
        ObjectId(bytes) => text.append(mut out, "oid(\"{text.encode_hex(bytes)}\")")
        Bool(b) => text.append(mut out, if b { "true" } else { "false" })
        DateTime(millis) => text.append(mut out, "date({millis})")
        Null => text.append(mut out, "null")
        Regex(pattern, options) => text.append(mut out, "/{pattern}/{options}")
        Int32(n) => text.append(mut out, "{n}")
        Timestamp(n) => text.append(mut out, "timestamp({n})")
        Int64(n) => text.append(mut out, "{n}L")
        Decimal128(bytes) => text.append(mut out, "decimal128(h'{text.encode_hex(bytes)}')")
        MinKey => text.append(mut out, "minkey")
        MaxKey => text.append(mut out, "maxkey")
    }
}

fn float_text(x: f64) -> str {
    if x != x {
        return "NaN"
    }
    let bits = text.float_bits(x)
    if bits & 0x7FFFFFFFFFFFFFFF == 0x7FF0000000000000 {
        return if bits >> 63 == 1 { "-Infinity" } else { "Infinity" }
    }
    let plain = "{x}"
    if text.contains(plain, ".") {
        return plain
    }
    let e = text.index_byte(plain, 'e')
    if e < 0 {
        return "{plain}.0"
    }
    "{plain[..e]}.0{plain[e..]}"
}

fn quote(mut out: []u8, s: str) {
    push(mut out, '"')
    for c in s {
        if c == '"' || c == '\\' {
            push(mut out, '\\')
            push(mut out, u8(c))
        } else if c >= 0x20 && c < 0x7F {
            push(mut out, u8(c))
        } else if c >= 0x10000 {
            let v = c - 0x10000
            escape(mut out, 0xD800 + (v >> 10))
            escape(mut out, 0xDC00 + (v & 0x3FF))
        } else {
            escape(mut out, c)
        }
    }
    push(mut out, '"')
}

fn escape(mut out: []u8, unit: u32) {
    text.append(mut out, "\\u{text.pad_left(text.radix(i64(unit), 16), 4, '0')}")
}
