import std/text

pub struct Options {
    pub max_depth: i64 = 64
    pub max_length: i64 = 16777216
}

pub struct Item {
    pub fields: []Field
    pub length: i64
}

struct Decoder {
    data: []u8
    pos: i64
    limit: i64
    options: Options
    depth: i64
}

pub fn decode(data: []u8) -> []Field ! Error {
    decode_with(data, Options {})
}

pub fn decode_with(data: []u8, options: Options) -> []Field ! Error {
    let first = decode_first(data, options)?
    if first.length != data.len {
        fail Trailing(first.length)
    }
    first.fields
}

pub fn decode_first(data: []u8, options: Options) -> Item ! Error {
    let d = new(Decoder { data, pos: 0, limit: data.len, options, depth: 0 })
    let fields = document(d)?
    Item { fields, length: d.pos }
}

fn need(d: *Decoder, n: i64) ! Error {
    if n > d.limit - d.pos {
        fail Truncated(d.pos)
    }
}

fn read_le(d: *Decoder, size: i64) -> u64 ! Error {
    need(d, size)?
    var n: u64 = 0
    for i in 0..size {
        n = n << 8 | u64(d.data[d.pos + size - 1 - i])
    }
    d.pos += size
    n
}

fn read_int32(d: *Decoder) -> i64 ! Error {
    let n = read_le(d, 4)?
    i64(i32(n))
}

fn read_byte(d: *Decoder) -> u8 ! Error {
    need(d, 1)?
    let b = d.data[d.pos]
    d.pos += 1
    b
}

fn copy(d: *Decoder, n: i64) -> []u8 {
    let out: []u8 = __make(n)
    __memmove(out, d.data[d.pos..d.pos + n])
    d.pos += n
    out
}

fn cstring(d: *Decoder) -> str ! Error {
    let start = d.pos
    var end = start
    for end < d.limit && d.data[end] != 0 {
        end += 1
    }
    if end >= d.limit {
        fail Truncated(d.limit)
    }
    let raw = copy(d, end - start)
    d.pos += 1
    if !valid_utf8(raw) {
        fail BadUtf8(start)
    }
    __str_view(raw)
}

fn string(d: *Decoder) -> str ! Error {
    let at = d.pos
    let n = read_int32(d)?
    if n < 1 {
        fail BadLength(at)
    }
    need(d, n)?
    if d.data[d.pos + n - 1] != 0 {
        fail BadString(at)
    }
    let raw = copy(d, n - 1)
    d.pos += 1
    if !valid_utf8(raw) {
        fail BadUtf8(at)
    }
    __str_view(raw)
}

fn enter(d: *Decoder, at: i64) ! Error {
    d.depth += 1
    if d.depth > d.options.max_depth {
        fail TooDeep(at)
    }
}

fn document(d: *Decoder) -> []Field ! Error {
    let start = d.pos
    let size = read_int32(d)?
    if size < 5 {
        fail BadLength(start)
    }
    if size > i64(d.options.max_length) {
        fail TooLong(start)
    }
    if size - 4 > d.limit - d.pos {
        if d.depth > 0 {
            fail BadLength(start)
        }
        fail Truncated(d.limit)
    }
    enter(d, start)?
    let outer = d.limit
    d.limit = start + size
    var fields: []Field = []
    for d.pos < d.limit - 1 {
        push(mut fields, field(d)?)
    }
    if d.pos != d.limit - 1 || d.data[d.pos] != 0 {
        fail BadLength(start)
    }
    d.pos += 1
    d.limit = outer
    d.depth -= 1
    fields
}

fn field(d: *Decoder) -> Field ! Error {
    let at = d.pos
    let kind = read_byte(d)?
    let name = cstring(d)?
    let value = element(d, kind, at)?
    Field { name, value }
}

fn element(d: *Decoder, kind: u8, at: i64) -> Value ! Error {
    match kind {
        == 0x01 => {
            let bits = read_le(d, 8)?
            Double(text.float_from_bits(bits))
        }
        == 0x02 => Str(string(d)?)
        == 0x03 => Document(document(d)?)
        == 0x04 => {
            let fields = document(d)?
            var items: []Value = []
            for f in fields {
                push(mut items, f.value)
            }
            Array(items)
        }
        == 0x05 => binary(d)?
        == 0x07 => {
            need(d, 12)?
            ObjectId(copy(d, 12))
        }
        == 0x08 => {
            let pos = d.pos
            let b = read_byte(d)?
            if b > 1 {
                fail BadBool(pos)
            }
            Bool(b == 1)
        }
        == 0x09 => {
            let n = read_le(d, 8)?
            DateTime(i64(n))
        }
        == 0x0A => Null
        == 0x0B => {
            let pattern = cstring(d)?
            let options = cstring(d)?
            Regex(pattern, options)
        }
        == 0x10 => {
            let n = read_le(d, 4)?
            Int32(i32(n))
        }
        == 0x11 => Timestamp(read_le(d, 8)?)
        == 0x12 => {
            let n = read_le(d, 8)?
            Int64(i64(n))
        }
        == 0x13 => {
            need(d, 16)?
            Decimal128(copy(d, 16))
        }
        == 0x7F => MaxKey
        == 0xFF => MinKey
        _ => fail BadType(at, kind)
    }
}

fn binary(d: *Decoder) -> Value ! Error {
    let at = d.pos
    let n = read_int32(d)?
    if n < 0 {
        fail BadLength(at)
    }
    let subtype = read_byte(d)?
    need(d, n)?
    Binary(subtype, copy(d, n))
}

fn valid_utf8(b: []u8) -> bool {
    var i = 0
    for i < b.len {
        let c = b[i]
        if c < 0x80 {
            i += 1
            continue
        }
        var extra = 0
        var low: u8 = 0x80
        var high: u8 = 0xBF
        if c >= 0xC2 && c <= 0xDF {
            extra = 1
        } else if c >= 0xE0 && c <= 0xEF {
            extra = 2
            if c == 0xE0 {
                low = 0xA0
            } else if c == 0xED {
                high = 0x9F
            }
        } else if c >= 0xF0 && c <= 0xF4 {
            extra = 3
            if c == 0xF0 {
                low = 0x90
            } else if c == 0xF4 {
                high = 0x8F
            }
        } else {
            return false
        }
        if i + extra >= b.len {
            return false
        }
        if b[i + 1] < low || b[i + 1] > high {
            return false
        }
        for j in 2..extra + 1 {
            if b[i + j] < 0x80 || b[i + j] > 0xBF {
                return false
            }
        }
        i += extra + 1
    }
    true
}
