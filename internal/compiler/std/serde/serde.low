pub enum Error {
    Syntax(at: i64, message: str)
    Mismatch(expected: str, at: i64)
    Missing(field: str)
    UnknownVariant(name: str)
    Range(at: i64)
    TooDeep
}

pub struct Field[T, F] {
    pub name: str
    pub index: i64
}

pub struct Writer {
    pub null: fn()
    pub boolean: fn(bool)
    pub integer: fn(i64)
    pub unsigned: fn(u64)
    pub float: fn(f64)
    pub text: fn(str)
    pub binary: fn([]u8)
    pub begin_seq: fn(i64)
    pub end_seq: fn()
    pub begin_map: fn(i64)
    pub key: fn(str)
    pub end_map: fn()
    pub begin_struct: fn(str, i64)
    pub field: fn(str)
    pub end_struct: fn()
    pub unit_variant: fn(str, str)
    pub begin_variant: fn(str, str, i64)
    pub end_variant: fn()
}

pub struct Reader {
    pub null: fn() -> bool ! Error
    pub boolean: fn() -> bool ! Error
    pub integer: fn() -> i64 ! Error
    pub unsigned: fn() -> u64 ! Error
    pub float: fn() -> f64 ! Error
    pub text: fn() -> str ! Error
    pub binary: fn() -> []u8 ! Error
    pub begin_seq: fn() ! Error
    pub next_element: fn() -> bool ! Error
    pub begin_map: fn() ! Error
    pub next_key: fn() -> str? ! Error
    pub begin_variant: fn() -> str ! Error
    pub end_variant: fn() ! Error
    pub skip: fn() ! Error
    pub position: fn() -> i64
}

pub enum Kind {
    Bool
    Int
    Uint
    Float
    Text
    Binary
    Seq
    Map
    Optional
    Struct
    Enum
    Ref
}

pub struct Schema {
    pub kind: Kind
    pub name: str = ""
    pub bits: i64 = 0
    pub items: []Schema = []
    pub fields: []Property = []
    pub variants: []Variant = []
}

pub struct Property {
    pub name: str
    pub schema: Schema
    pub required: bool
}

pub struct Variant {
    pub name: str
    pub labelled: bool
    pub fields: []Property
}

pub fn write[T](v: T, w: Writer) {
    __serialize(v, w)
}

pub fn read[T](r: Reader) -> T ! Error {
    __deserialize[T](r)
}

pub fn schema[T]() -> Schema {
    __schema[T]()
}

fn key_integer(key: str, at: i64) -> i64 ! Error {
    var start = 0
    var negative = false
    if key.len > 0 && key[0] == '-' {
        negative = true
        start = 1
    }
    if start == key.len {
        fail Mismatch("integer key", at)
    }
    var n = 0
    for i in start..key.len {
        let c = key[i]
        if c < '0' || c > '9' {
            fail Mismatch("integer key", at)
        }
        let d = i64(c - '0')
        if n > (0x7FFFFFFFFFFFFFFF - d) / 10 {
            fail Range(at)
        }
        n = n * 10 + d
    }
    if negative { -n } else { n }
}

fn key_boolean(key: str, at: i64) -> bool ! Error {
    if key == "true" {
        return true
    }
    if key != "false" {
        fail Mismatch("bool key", at)
    }
    false
}

fn checked(n: i64, low: i64, high: i64, at: i64) -> i64 ! Error {
    if n < low || n > high {
        fail Range(at)
    }
    n
}
