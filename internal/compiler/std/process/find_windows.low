import std/os
import std/text

fn has_directory(name: str) -> bool {
    text.index_byte(name, '/') >= 0 || text.index_byte(name, '\\') >= 0
}

fn default_path() -> str {
    ""
}

fn path_separator() -> u8 {
    ';'
}

fn has_extension(path: str) -> bool {
    var i = path.len - 1
    for i >= 0 {
        let c = path[i]
        if c == '.' {
            return true
        }
        if c == '/' || c == '\\' {
            return false
        }
        i -= 1
    }
    false
}

fn spellings(path: str) -> []str {
    if has_extension(path) {
        return [path]
    }
    var out: []str = []
    for extension in text.split(os.env("PATHEXT") ?? ".COM;.EXE;.BAT;.CMD", ';') {
        if extension.len > 0 {
            push(mut out, "{path}{extension}")
        }
    }
    out
}
