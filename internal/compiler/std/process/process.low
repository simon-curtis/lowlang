import std/io
import std/os
import signals = std/os/signal
import std/sys
import std/text

/// Where one of a child's standard streams is connected.
pub enum Stdio {
    /// The child uses the parent's descriptor.
    Inherit
    /// The child is connected to a pipe, and the parent's end is available as a stream on the child.
    Piped
    /// The child is connected to `/dev/null`: reads return end of input and writes are discarded.
    Null
}

/// A program to run, with its arguments, environment, working directory and standard stream setup.
///
/// Made with `command` and adjusted by setting fields. Starting it with `start`, `start_handle` or `run` does not modify the command.
pub struct Command {
    /// The program to run. A name without `/` is searched for in `PATH` as `find` does.
    pub program: str
    /// The arguments after the program name. The program name itself is passed as `argv[0]`.
    pub args: []str = []
    /// The complete environment of the child, or `none` to give it the current environment from `os.environment`.
    pub env: [str: str]? = none
    /// The working directory of the child. An empty string keeps the parent's.
    pub dir: str = ""
    /// How the child's standard input is connected.
    pub stdin: Stdio = Inherit
    /// How the child's standard output is connected.
    pub stdout: Stdio = Inherit
    /// How the child's standard error is connected.
    pub stderr: Stdio = Inherit
    /// Whether the child starts in a new process group. `kill` then signals the whole group.
    pub group: bool = false
}

/// How a child process ended.
pub enum Exit {
    /// The process ended by itself with this exit status.
    Exited(code: i64)
    /// This signal ended the process.
    Signaled(signal: signals.Signal)
}

/// A copyable view of a started child process.
///
/// The view holds the process id and the parent's ends of the pipes. It does not kill or reap the child when released; `wait_on` reaps it and `Child` does both when dropped.
pub struct ChildHandle {
    /// The process id of the child.
    pub pid: i64
    /// A stream that writes to the child's standard input, or `none` unless it was `Piped`.
    ///
    /// Closing it closes the pipe, which the child sees as end of input.
    pub stdin: io.Stream?
    /// A stream that reads the child's standard output, or `none` unless it was `Piped`.
    ///
    /// Reads return `0` at end of output.
    pub stdout: io.Stream?
    /// A stream that reads the child's standard error, or `none` unless it was `Piped`.
    ///
    /// Reads return `0` at end of output.
    pub stderr: io.Stream?
    pidfd: sys.FdHandle
    group: bool
    status: Exit?
}

/// The owner of a started child process.
///
/// Dropping a child that has not been waited for kills it with `Kill`, reaps it and closes its streams.
pub struct Child {
    /// The shared view of the child.
    pub handle: *ChildHandle
    drop dispose_on(handle)
}

/// The result of `run`: the exit and everything the child wrote.
pub struct Output {
    /// How the child ended.
    pub status: Exit
    /// Everything the child wrote to standard output.
    pub stdout: []u8
    /// Everything the child wrote to standard error.
    pub stderr: []u8
}

struct Ends {
    parent: sys.Fd
    child: sys.Fd
}

struct Collected {
    data: []u8
    failure: io.Error?
    done: chan[bool]
}

/// Returns a `Command` for `program` with `args` and the defaults for the other fields.
///
/// `args` does not include the program name.
pub fn command(program: str, args: []str) -> Command {
    Command { program, args }
}

/// Returns whether `e` is a normal exit with status `0`.
pub fn success(e: Exit) -> bool {
    e == Exited(0)
}

/// Returns the path of the executable that `name` refers to, or `none`.
///
/// A name containing `/` is checked as given. Any other name is looked for in each directory of `PATH`, taken from `os.env` so `os.set_env` applies, or `/usr/local/bin:/usr/bin:/bin` when it is unset; an empty entry stands for the current directory. A match must be executable and not a directory. On Windows a name containing `\` or `/` is checked as given, `PATH` entries are separated by `;`, and a name without an extension also matches with each extension in `PATHEXT`. Blocks the OS thread while it checks the candidates.
pub fn find(name: str) -> str? {
    if has_directory(name) {
        return first_executable(spellings(name))
    }
    for dir in text.split(os.env("PATH") ?? default_path(), path_separator()) {
        let base = if dir.len == 0 { "." } else { dir }
        match first_executable(spellings("{base}/{name}")) {
            some(found) => return found
            none => {}
        }
    }
    none
}

fn first_executable(candidates: []str) -> str? {
    for candidate in candidates {
        if executable(candidate) {
            return candidate
        }
    }
    none
}

fn executable(path: str) -> bool {
    if !sys.access(path, sys.Access.Executable) {
        return false
    }
    let found = sys.stat(path, true) catch {
        _ => return false
    }
    found.kind != sys.Kind.Dir
}

fn absent() -> Ends {
    Ends { parent: sys.own(-1), child: sys.own(-1) }
}

fn piped(input: bool) -> Ends ! io.Error {
    let pair = sys.pipe(false)?
    using e = if input {
        Ends { parent: sys.own(pair.second), child: sys.own(pair.first) }
    } else {
        Ends { parent: sys.own(pair.first), child: sys.own(pair.second) }
    }
    sys.set_nonblocking(e.parent.handle.fd)?
    e
}

fn ends(mode: Stdio, input: bool) -> Ends ! io.Error {
    match mode {
        Inherit => absent()
        Null => {
            let null_device = sys.open(sys.null_device(), sys.Open.ReadWrite, 0)?
            Ends { parent: sys.own(-1), child: sys.adopt(null_device) }
        }
        Piped => piped(input)?
    }
}

fn stream(h: sys.FdHandle) -> io.Stream? {
    if h.fd < 0 {
        return none
    }
    some(sys.stream_on(h))
}

fn environment(c: Command) -> []str {
    var out: []str = []
    for name, value in c.env ?? os.environment() {
        push(mut out, "{name}={value}")
    }
    out
}

fn arguments(c: Command) -> []str {
    var out: []str = [c.program]
    for a in c.args {
        push(mut out, a)
    }
    out
}

/// Returns the `Child` that owns the process behind `h`, which kills and reaps it when dropped.
pub fn adopt(h: *ChildHandle) -> Child {
    Child { handle: h }
}

/// Starts the command and returns the `Child` that owns the process.
///
/// Fails as `start_handle` does.
pub fn start(c: Command) -> Child ! io.Error {
    let h = start_handle(c)?
    adopt(h)
}

/// Starts the command and returns a view of the process.
///
/// Resolves the program with `find`, creates the requested pipes and forks. Returns after the child has executed the program, parking the green thread while it waits for that. Fails with `NotFound` if the program is not found, with the system error if a pipe or the fork fails or the child's report cannot be read, and with the error of a failing `chdir` or `execve` in the child, such as `Denied`, `NotDir` or `NotFound`, in which case the child has been reaped. The caller must wait for the child with `wait_on` or hand the view to `adopt`.
pub fn start_handle(c: Command) -> *ChildHandle ! io.Error {
    let path = find(c.program) ?? ""
    if path.len == 0 {
        fail NotFound
    }
    let argv = arguments(c)
    let envp = environment(c)
    using var input = ends(c.stdin, true)?
    using var output = ends(c.stdout, false)?
    using var errors = ends(c.stderr, false)?
    let spawned = sys.fork_exec(path, argv, envp, c.dir, c.group, input.child.handle.fd, output.child.handle.fd, errors.child.handle.fd)?
    sys.close(input.child)
    sys.close(output.child)
    sys.close(errors.child)
    let stdin = stream(sys.detach(mut input.parent))
    let stdout = stream(sys.detach(mut output.parent))
    let stderr = stream(sys.detach(mut errors.parent))
    let handle = new(ChildHandle { pid: spawned.pid, stdin, stdout, stderr, pidfd: spawned.pidfd, group: c.group, status: none })
    match spawned.failure {
        some(e) => {
            using failed = adopt(handle)
            fail e
        }
        none => {}
    }
    handle
}

fn dispose_on(c: *ChildHandle) {
    if c.status == none {
        kill_on(c, signals.Signal.Kill) catch {
            _ => {}
        }
        wait_on(c) catch {
            _ => Exited(127)
        }
    }
    close_streams(c)
}

fn close_streams(c: *ChildHandle) {
    for s in [c.stdin, c.stdout, c.stderr] {
        match s {
            some(st) => st.close()
            none => {}
        }
    }
}

fn exit_of(r: sys.Reaped) -> Exit {
    if r.exited {
        return Exited(r.value)
    }
    let signal = signals.from_number(r.value) ?? signals.Signal.Other(r.value)
    Signaled(signal)
}

/// Waits for the child owned by `c` to end and returns how it ended.
///
/// Does the same as `wait_on` on its handle.
pub fn wait(c: Child) -> Exit ! io.Error {
    wait_on(c.handle)
}

/// Waits for the child behind `c` to end, reaps it and returns how it ended.
///
/// Parks the green thread until the process ends. The result is remembered, so later calls return it at once. Fails with the system error if the child cannot be reaped, and can fail with `NotConnected` when a concurrent call reaps it first.
pub fn wait_on(c: *ChildHandle) -> Exit ! io.Error {
    match c.status {
        some(done) => return done
        none => {}
    }
    using lease = sys.enter(c.pidfd)?
    wait_readable(c.pidfd.fd)
    let reaped = sys.reap(c.pidfd.fd)?
    sys.close_on(c.pidfd)
    let status = exit_of(reaped)
    c.status = some(status)
    status
}

/// Waits for the child behind `c` to end without reaping it.
///
/// Parks the green thread until the process ends. `kill_on` still signals the child's process group afterwards, and `wait_on` then reaps the child and returns at once. Returns at once when the child has been waited for. Fails with `NotConnected` when a concurrent `wait_on` reaps the child first.
pub fn wait_exit_on(c: *ChildHandle) ! io.Error {
    if c.status != none {
        return
    }
    using lease = sys.enter(c.pidfd)?
    wait_readable(c.pidfd.fd)
}

/// Sends `signal` to the child owned by `c`.
///
/// Does the same as `kill_on` on its handle.
pub fn kill(c: Child, signal: signals.Signal) ! io.Error {
    kill_on(c.handle, signal)?
}

/// Sends `signal` to the child behind `c`.
///
/// Does nothing once the child has been waited for. Signals the whole process group for a command started with `group`. Does not wait for the child to end.
pub fn kill_on(c: *ChildHandle, signal: signals.Signal) ! io.Error {
    if c.status != none {
        return
    }
    let number = signals.number(signal)
    if c.group {
        sys.kill(-c.pid, number)?
        return
    }
    using lease = sys.enter(c.pidfd) catch {
        _ => return
    }
    sys.pidfd_send_signal(c.pidfd.fd, number)?
}

fn drain(s: io.Stream, into: *Collected) ! io.Error {
    let buf = io.buffer(65536)
    for {
        let n = s.read(buf)?
        if n == 0 {
            break
        }
        io.append(mut into.data, buf[..n])
    }
}

fn collect(s: io.Stream, into: *Collected) {
    drain(s, into) catch {
        e => {
            into.failure = some(e)
        }
    }
    s.close()
    into.done <- true
}

fn piped_stream(s: io.Stream?) -> io.Stream ! io.Error {
    match s {
        some(st) => st
        none => fail Invalid
    }
}

fn feed(s: io.Stream, data: []u8) {
    var rest = data
    for rest.len > 0 {
        let n = s.write(rest) catch 0
        if n == 0 {
            break
        }
        rest = rest[n..]
    }
    s.close()
}

/// Runs `c` to completion with all three standard streams piped, and returns its output.
///
/// Overrides the `stdin`, `stdout` and `stderr` modes of `c`. Writes `input` to the child's standard input in the background and then closes it, collects standard output and standard error completely in memory, and waits for the child to end. Parks the green thread while it waits. A non-zero exit is not an error: it is reported in `Output.status`. Fails if the child cannot be started or waited for, and with the error of a read of standard output or standard error that fails before the end of the output, in which case the child is killed and reaped. Errors from writing `input`, such as a child that exits without reading it, are ignored.
pub fn run(c: Command, input: []u8) -> Output ! io.Error {
    var piped_command = c
    piped_command.stdin = Piped
    piped_command.stdout = Piped
    piped_command.stderr = Piped
    using child = start(piped_command)?
    let stdin = piped_stream(child.handle.stdin)?
    let stdout = piped_stream(child.handle.stdout)?
    let stderr = piped_stream(child.handle.stderr)?
    let out = new(Collected { data: [], failure: none, done: chan[bool](1) })
    let err = new(Collected { data: [], failure: none, done: chan[bool](1) })
    spawn feed(stdin, input)
    spawn collect(stdout, out)
    spawn collect(stderr, err)
    <-out.done
    <-err.done
    match out.failure ?? err.failure {
        some(e) => fail e
        none => {}
    }
    Output { status: wait(child)?, stdout: out.data, stderr: err.data }
}
