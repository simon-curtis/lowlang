import std/file
import std/io
import std/os
import std/text

/// Where one of a child's standard streams is connected.
pub enum Stdio {
    /// The child uses the parent's descriptor.
    Inherit
    /// The child is connected to a pipe, and the parent's end is available as a stream on the child.
    Piped
    /// The child is connected to `/dev/null`: reads return end of input and writes are discarded.
    Null
}

/// A program to run, with its arguments, environment, working directory and standard stream setup.
///
/// Made with `command` and adjusted by setting fields. Starting it with `start`, `start_handle` or `run` does not modify the command.
pub struct Command {
    /// The program to run. A name without `/` is searched for in `PATH` as `find` does.
    pub program: str
    /// The arguments after the program name. The program name itself is passed as `argv[0]`.
    pub args: []str = []
    /// The complete environment of the child, or `none` to give it the current environment from `os.environment`.
    pub env: [str: str]? = none
    /// The working directory of the child. An empty string keeps the parent's.
    pub dir: str = ""
    /// How the child's standard input is connected.
    pub stdin: Stdio = Inherit
    /// How the child's standard output is connected.
    pub stdout: Stdio = Inherit
    /// How the child's standard error is connected.
    pub stderr: Stdio = Inherit
    /// Whether the child starts in a new process group. `kill` then signals the whole group.
    pub group: bool = false
}

/// How a child process ended.
pub enum Exit {
    /// The process ended by itself with this exit status.
    Exited(code: i64)
    /// A signal with this number ended the process.
    Signaled(signal: i64)
}

/// A copyable view of a started child process.
///
/// The view holds the process id and the parent's ends of the pipes. It does not kill or reap the child when released; `wait_on` reaps it and `Child` does both when dropped.
pub struct ChildHandle {
    /// The process id of the child.
    pub pid: i64
    /// A stream that writes to the child's standard input, or `none` unless it was `Piped`.
    ///
    /// Closing it closes the pipe, which the child sees as end of input.
    pub stdin: io.Stream?
    /// A stream that reads the child's standard output, or `none` unless it was `Piped`.
    ///
    /// Reads return `0` at end of output.
    pub stdout: io.Stream?
    /// A stream that reads the child's standard error, or `none` unless it was `Piped`.
    ///
    /// Reads return `0` at end of output.
    pub stderr: io.Stream?
    pidfd: i64
    pidfd_guard: *io.Guard
    group: bool
    status: Exit?
}

/// The owner of a started child process.
///
/// Dropping a child that has not been waited for kills it with signal 9, reaps it and closes its streams.
pub struct Child {
    /// The shared view of the child.
    pub handle: *ChildHandle
    drop dispose_on(handle)
}

/// The result of `run`: the exit and everything the child wrote.
pub struct Output {
    /// How the child ended.
    pub status: Exit
    /// Everything the child wrote to standard output.
    pub stdout: []u8
    /// Everything the child wrote to standard error.
    pub stderr: []u8
}

struct Fd {
    fd: i64
    open: bool = true
    drop {
        if open {
            close_fd(fd)
        }
    }
}

struct Ends {
    parent: Fd
    child: Fd
}

struct End {
    fd: i64
    guard: *io.Guard
}

struct Collected {
    data: []u8
    done: chan[bool]
}

/// Returns a `Command` for `program` with `args` and the defaults for the other fields.
///
/// `args` does not include the program name.
pub fn command(program: str, args: []str) -> Command {
    Command { program, args }
}

/// Returns whether `e` is a normal exit with status `0`.
pub fn success(e: Exit) -> bool {
    e == Exited(0)
}

/// Returns the path of the executable that `name` refers to, or `none`.
///
/// A name containing `/` is checked as given. Any other name is looked for in each directory of `PATH`, taken from `os.env` so `os.set_env` applies, or `/usr/local/bin:/usr/bin:/bin` when it is unset; an empty entry stands for the current directory. A match must be executable and not a directory. Blocks the OS thread while it checks the candidates.
pub fn find(name: str) -> str? {
    if text.index_byte(name, '/') >= 0 {
        return if executable(name) { some(name) } else { none }
    }
    for dir in text.split(os.env("PATH") ?? "/usr/local/bin:/usr/bin:/bin", ':') {
        let candidate = "{if dir.len == 0 { "." } else { dir }}/{name}"
        if executable(candidate) {
            return some(candidate)
        }
    }
    none
}

fn executable(path: str) -> bool {
    let c = c_string(path)
    if __syscall(21, __slice_ptr(c), 1) != 0 {
        return false
    }
    let found = file.stat(path) catch {
        _ => return false
    }
    !found.dir
}

fn c_string(s: str) -> []u8 {
    var b = bytes(s)
    push(mut b, 0)
    b
}

fn pointers(strings: [][]u8) -> []ptr {
    var out: []ptr = []
    for s in strings {
        push(mut out, __slice_ptr(s))
    }
    push(mut out, null)
    out
}

fn close_fd(fd: i64) {
    if fd >= 0 {
        __syscall(3, fd)
    }
}

fn shut(mut f: Fd) {
    close_fd(f.fd)
    f.open = false
}

fn keep(mut f: Fd) -> i64 {
    f.open = false
    f.fd
}

fn absent() -> Ends {
    Ends { parent: Fd { fd: -1 }, child: Fd { fd: -1 } }
}

fn piped(input: bool) -> Ends ! io.Error {
    let fds = io.buffer(8)
    io.syscall_result(__syscall(293, __slice_ptr(fds), 0x80000))?
    let read = io.le32(fds, 0)
    let write = io.le32(fds, 4)
    using e = if input {
        Ends { parent: Fd { fd: write }, child: Fd { fd: read } }
    } else {
        Ends { parent: Fd { fd: read }, child: Fd { fd: write } }
    }
    set_nonblocking(e.parent.fd)?
    e
}

fn set_nonblocking(fd: i64) ! io.Error {
    let flags = io.syscall_result(__syscall(72, fd, 3))?
    io.syscall_result(__syscall(72, fd, 4, flags | 0x800))?
}

fn ends(mode: Stdio, input: bool) -> Ends ! io.Error {
    match mode {
        Inherit => absent()
        Null => {
            let null_path = c_string("/dev/null")
            let fd = io.syscall_result(__syscall(257, -100, __slice_ptr(null_path), 0x80002, 0))?
            Ends { parent: Fd { fd: -1 }, child: Fd { fd } }
        }
        Piped => piped(input)?
    }
}

fn read_fd(fd: i64, buf: []u8) -> i64 ! io.Error {
    for {
        let r = __syscall(0, fd, __slice_ptr(buf), buf.len)
        if r == -11 {
            wait_readable(fd)
        } else if r != -4 {
            return io.syscall_result(r)
        }
    }
}

fn write_fd(fd: i64, data: []u8) -> i64 ! io.Error {
    for {
        let r = __syscall(1, fd, __slice_ptr(data), data.len)
        if r == -11 {
            wait_writable(fd)
        } else if r != -4 {
            return io.syscall_result(r)
        }
    }
}

fn read_end(e: End, buf: []u8) -> i64 ! io.Error {
    using lease = io.enter(e.guard)?
    read_fd(e.fd, buf)
}

fn write_end(e: End, data: []u8) -> i64 ! io.Error {
    using lease = io.enter(e.guard)?
    write_fd(e.fd, data)
}

fn stream(fd: i64) -> io.Stream? {
    if fd < 0 {
        return none
    }
    let e = End { fd, guard: io.guard(fn() {}, fn() { close_fd(fd) }) }
    some(io.Stream {
        read: fn(buf) { read_end(e, buf) }
        write: fn(data) { write_end(e, data) }
        close: fn() { io.retire(e.guard) }
    })
}

fn environment(c: Command) -> [][]u8 {
    var out: [][]u8 = []
    for name, value in c.env ?? os.environment() {
        push(mut out, c_string("{name}={value}"))
    }
    out
}

fn redirect(fd: i64, target: i64) {
    if fd >= 0 {
        __syscall(33, fd, target)
    }
}

/// Returns the `Child` that owns the process behind `h`, which kills and reaps it when dropped.
pub fn adopt(h: *ChildHandle) -> Child {
    Child { handle: h }
}

/// Starts the command and returns the `Child` that owns the process.
///
/// Fails as `start_handle` does.
pub fn start(c: Command) -> Child ! io.Error {
    let h = start_handle(c)?
    adopt(h)
}

/// Starts the command and returns a view of the process.
///
/// Resolves the program with `find`, creates the requested pipes and forks. Returns after the child has executed the program, parking the green thread while it waits for that. Fails with `NotFound` if the program is not found, with the system error if a pipe or the fork fails, and with the error of a failing `chdir` or `execve` in the child, such as `Denied`, `NotDir` or `NotFound`, in which case the child has been reaped. The caller must wait for the child with `wait_on` or hand the view to `adopt`.
pub fn start_handle(c: Command) -> *ChildHandle ! io.Error {
    let path = find(c.program) ?? ""
    if path.len == 0 {
        fail NotFound
    }
    let path_c = c_string(path)
    var arg_strings: [][]u8 = [c_string(c.program)]
    for a in c.args {
        push(mut arg_strings, c_string(a))
    }
    let env_strings = environment(c)
    let argv = pointers(arg_strings)
    let envp = pointers(env_strings)
    let dir_c = c_string(c.dir)
    using var input = ends(c.stdin, true)?
    using var output = ends(c.stdout, false)?
    using var errors = ends(c.stderr, false)?
    using var report = piped(false)?
    let code = io.buffer(4)
    let has_dir = c.dir.len > 0
    let group = c.group
    let pid = __syscall(57)
    if pid == 0 {
        if group {
            __syscall(109, 0, 0)
        }
        redirect(input.child.fd, 0)
        redirect(output.child.fd, 1)
        redirect(errors.child.fd, 2)
        var r = 0
        if has_dir {
            r = __syscall(80, __slice_ptr(dir_c))
        }
        if r == 0 {
            r = __syscall(59, __slice_ptr(path_c), __slice_ptr(argv), __slice_ptr(envp))
        }
        io.set_le32(code, 0, -r)
        __syscall(1, report.child.fd, __slice_ptr(code), 4)
        __syscall(231, 127)
    }
    shut(mut input.child)
    shut(mut output.child)
    shut(mut errors.child)
    shut(mut report.child)
    if pid < 0 {
        fail io.errno(-pid)
    }
    let n = read_fd(report.parent.fd, code) catch 0
    let pidfd = __syscall(434, pid, 0)
    let pidfd_guard = io.guard(fn() {}, fn() { close_fd(pidfd) })
    let stdin = stream(keep(mut input.parent))
    let stdout = stream(keep(mut output.parent))
    let stderr = stream(keep(mut errors.parent))
    let handle = new(ChildHandle { pid, stdin, stdout, stderr, pidfd, pidfd_guard, group, status: none })
    if n == 4 {
        using failed = adopt(handle)
        fail io.errno(io.le32(code, 0))
    }
    handle
}

fn dispose_on(c: *ChildHandle) {
    if c.status == none {
        kill_on(c, 9) catch {
            _ => {}
        }
        wait_on(c) catch {
            _ => Exited(127)
        }
    }
    close_streams(c)
}

fn close_streams(c: *ChildHandle) {
    for s in [c.stdin, c.stdout, c.stderr] {
        match s {
            some(st) => st.close()
            none => {}
        }
    }
}

/// Waits for the child owned by `c` to end and returns how it ended.
///
/// Does the same as `wait_on` on its handle.
pub fn wait(c: Child) -> Exit ! io.Error {
    wait_on(c.handle)
}

/// Waits for the child behind `c` to end, reaps it and returns how it ended.
///
/// Parks the green thread until the process ends. The result is remembered, so later calls return it at once. When no process descriptor could be obtained for the child, the wait blocks the OS thread instead. Fails with the system error if the child cannot be reaped, and can fail with `NotConnected` when a concurrent call reaps it first.
pub fn wait_on(c: *ChildHandle) -> Exit ! io.Error {
    match c.status {
        some(done) => return done
        none => {}
    }
    let info = io.buffer(128)
    using lease = io.enter(c.pidfd_guard)?
    if c.pidfd >= 0 {
        wait_readable(c.pidfd)
    }
    for {
        let r = if c.pidfd >= 0 { __syscall(247, 3, c.pidfd, __slice_ptr(info), 4, 0) } else { __syscall(247, 1, c.pid, __slice_ptr(info), 4, 0) }
        if r == 0 {
            break
        }
        if r != -4 {
            fail io.errno(-r)
        }
    }
    io.retire(c.pidfd_guard)
    let how = io.le32(info, 8)
    let value = io.le32(info, 24)
    let status: Exit = if how == 1 { Exited(value) } else { Signaled(value) }
    c.status = some(status)
    status
}

/// Sends the signal number `signal` to the child owned by `c`.
///
/// Does the same as `kill_on` on its handle.
pub fn kill(c: Child, signal: i64) ! io.Error {
    kill_on(c.handle, signal)?
}

/// Sends the signal number `signal` to the child behind `c`.
///
/// Does nothing once the child has been waited for. Signals the whole process group for a command started with `group`. Does not wait for the child to end.
pub fn kill_on(c: *ChildHandle, signal: i64) ! io.Error {
    if c.status != none {
        return
    }
    if c.group {
        io.syscall_result(__syscall(62, -c.pid, signal))?
        return
    }
    if c.pidfd >= 0 {
        using lease = io.enter(c.pidfd_guard) catch {
            _ => return
        }
        io.syscall_result(__syscall(424, c.pidfd, signal, 0, 0))?
        return
    }
    io.syscall_result(__syscall(62, c.pid, signal))?
}

fn collect(s: io.Stream, into: *Collected) {
    let buf = io.buffer(65536)
    for {
        let n = s.read(buf) catch 0
        if n == 0 {
            break
        }
        io.append(mut into.data, buf[..n])
    }
    s.close()
    into.done <- true
}

fn feed(s: io.Stream, data: []u8) {
    var rest = data
    for rest.len > 0 {
        let n = s.write(rest) catch 0
        if n == 0 {
            break
        }
        rest = rest[n..]
    }
    s.close()
}

/// Runs `c` to completion with all three standard streams piped, and returns its output.
///
/// Overrides the `stdin`, `stdout` and `stderr` modes of `c`. Writes `input` to the child's standard input in the background and then closes it, collects standard output and standard error completely in memory, and waits for the child to end. Parks the green thread while it waits. A non-zero exit is not an error: it is reported in `Output.status`. Fails only if the child cannot be started or waited for. Errors from writing `input`, such as a child that exits without reading it, are ignored.
pub fn run(c: Command, input: []u8) -> Output ! io.Error {
    var piped_command = c
    piped_command.stdin = Piped
    piped_command.stdout = Piped
    piped_command.stderr = Piped
    using child = start(piped_command)?
    let out = new(Collected { data: [], done: chan[bool](1) })
    let err = new(Collected { data: [], done: chan[bool](1) })
    match child.handle.stdin {
        some(s) => {
            spawn feed(s, input)
        }
        none => {}
    }
    match child.handle.stdout {
        some(s) => {
            spawn collect(s, out)
        }
        none => {
            out.done <- true
        }
    }
    match child.handle.stderr {
        some(s) => {
            spawn collect(s, err)
        }
        none => {
            err.done <- true
        }
    }
    <-out.done
    <-err.done
    Output { status: wait(child)?, stdout: out.data, stderr: err.data }
}
