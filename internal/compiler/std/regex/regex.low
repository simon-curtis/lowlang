/// Why a pattern failed to compile.
pub enum Error {
    /// The pattern is not valid or uses an unsupported feature.
    /// `at` is the byte offset in the pattern and `message` describes the problem, such as `nothing to repeat`, `missing ), unterminated subpattern`, `lookaround is not supported` or `repeat count too large`. Lookaround, backreferences, octal escapes and named groups are not supported. A repeat count above `10000` and a pattern that assembles to more than `100000` instructions are rejected.
    Invalid(at: i64, message: str)
}

/// Options that change how a pattern matches, set for the whole pattern by `compile_with`.
/// The pattern can also switch them on and off with `(?i)`, `(?m)`, `(?s)` and the scoped forms such as `(?i:...)` and `(?-s:...)`.
pub struct Flags {
    /// Whether letters match regardless of ASCII case. Defaults to `false`. Only `A-Z` and `a-z` are folded.
    pub ignore_case: bool = false
    /// Whether `^` and `$` also match at line boundaries rather than only at the start and end of the input. Defaults to `false`.
    pub multiline: bool = false
    /// Whether `.` also matches a newline. Defaults to `false`.
    pub dot_all: bool = false
}

/// A compiled regular expression.
/// Matching runs in time linear in the input and uses no backtracking, in the RE2 style, and the leftmost match is chosen with greedy and lazy repeats taking priority as in Perl. Patterns match code points of UTF-8 text, and all offsets are byte offsets. The syntax covers literals, `.`, classes `[a-z]` and `[^a-z]`, `\d \w \s` and their negations, `\x`, `\u` and `\U` escapes, groups `(...)` and `(?:...)`, alternation `|`, repeats `* + ? {n} {n,} {n,m}` with a lazy `?` suffix, and the anchors `^ $ \A \z \b \B`. A `Regex` may be used from several threads at once.
pub struct Regex {
    engine: Engine
    groups: i64
    quick: *Pool = new_pool()
    full: *Pool = new_pool()
}

/// The outcome of one successful match: the matched text and the byte spans of its capture groups.
/// Read it with `start`, `end`, `text`, `span` and `group`. It stays valid after further searches.
pub struct Match {
    input: str
    slots: []i64
}

/// A byte range `start..end` in the input, with `end` exclusive.
pub struct Span {
    /// The offset of the first byte of the range.
    pub start: i64
    /// The offset one past the last byte of the range.
    pub end: i64
}

/// Compiles `pattern` with default `Flags`.
/// Fails with `Invalid` when the pattern is malformed or unsupported.
pub fn compile(pattern: str) -> Regex ! Error {
    compile_with(pattern, Flags {})?
}

/// Compiles `pattern` with `flags`.
/// Fails with `Invalid` as `compile` does.
pub fn compile_with(pattern: str, flags: Flags) -> Regex ! Error {
    let parsed = parse(pattern, flags)?
    let program = assemble(parsed.root)?
    Regex { engine: interpreted(program), groups: parsed.groups }
}

/// Returns the number of capture groups in `re`, not counting group `0` for the whole match.
pub fn group_count(re: Regex) -> i64 {
    re.groups
}

/// Returns whether `input` contains a match anywhere.
/// It does not record capture groups and is the cheapest query.
pub fn is_match(re: Regex, input: str) -> bool {
    let m = borrow(re, re.quick, 0, input)
    let found = search(mut *m, Search { from: 0, first: true })
    release(re.quick, m)
    found
}

/// Returns the leftmost match in `input`, or `none` when there is none.
/// Group `0` of the result spans the match.
pub fn find(re: Regex, input: str) -> Match? {
    searched(re, input, Search { from: 0 })
}

/// Returns a match only when the pattern matches the whole of `input`, from its first byte to its last, and `none` otherwise.
pub fn full_match(re: Regex, input: str) -> Match? {
    searched(re, input, Search { from: 0, anchored: true, whole: true })
}

fn searched(re: Regex, input: str, s: Search) -> Match? {
    let m = borrow(re, re.full, slot_count(re), input)
    var found: Match? = none
    if search(mut *m, s) {
        found = captured(m)
    }
    release(re.full, m)
    found
}

/// Returns every non-overlapping match in `input`, from left to right.
/// After an empty match the next match may not be empty at the same offset, so the search always advances. Returns an empty slice when nothing matches.
pub fn find_all(re: Regex, input: str) -> []Match {
    var matches: []Match = []
    scan(re, input, -1, fn(found: Match) {
        push(mut matches, found)
    })
    matches
}

/// Returns `input` with every non-overlapping match replaced by the string `replacement` returns for it.
/// The closure's result is inserted as it stands, with no `$1` expansion. Input between matches is copied unchanged.
pub fn replace_all(re: Regex, input: str, replacement: fn(Match) -> str) -> str {
    var out: []u8 = []
    var last = 0
    scan(re, input, -1, fn(found: Match) {
        let bounds = found.slots
        __extend(mut out, input[last..bounds[0]])
        let replaced = replacement(found)
        __extend(mut out, replaced)
        last = bounds[1]
    })
    __extend(mut out, input[last..])
    __str_view(out)
}

/// Splits `input` around each non-overlapping match of `re` and returns the pieces between them.
/// Returns a single piece, `input`, when nothing matches. Adjacent matches and matches at either end produce empty pieces.
pub fn split(re: Regex, input: str) -> []str {
    split_n(re, input, -1)
}

/// Splits `input` as `split` does, using at most `max` matches.
/// The result has at most `max + 1` pieces and the last holds the unsplit rest. `0` returns `input` as the only piece, and a negative `max` splits at every match.
pub fn split_n(re: Regex, input: str, max: i64) -> []str {
    var parts: []str = []
    var last = 0
    scan(re, input, max, fn(found: Match) {
        push(mut parts, input[last..found.slots[0]])
        last = found.slots[1]
    })
    push(mut parts, input[last..])
    parts
}

/// Returns the byte offset where `m` begins.
pub fn start(m: Match) -> i64 {
    m.slots[0]
}

/// Returns the byte offset one past the end of `m`.
pub fn end(m: Match) -> i64 {
    m.slots[1]
}

/// Returns the text `m` matched, as a slice of the searched input.
pub fn text(m: Match) -> str {
    m.input[m.slots[0]..m.slots[1]]
}

/// Returns the byte span of capture group `group` in `m`, where `0` is the whole match.
/// Returns `none` when `group` is negative or beyond `group_count`, and when the group did not take part in the match.
pub fn span(m: Match, group: i64) -> Span? {
    if group < 0 || 2 * group + 1 >= m.slots.len {
        return none
    }
    let from = m.slots[2 * group]
    let to = m.slots[2 * group + 1]
    if from < 0 || to < 0 {
        return none
    }
    Span { start: from, end: to }
}

/// Returns the text of capture group `index` in `m`, where `0` is the whole match.
/// Returns `none` in the cases where `span` does.
pub fn group(m: Match, index: i64) -> str? {
    let s = span(m, index) ?? return none
    m.input[s.start..s.end]
}

fn slot_count(re: Regex) -> i64 {
    2 * (re.groups + 1)
}

fn captured(m: *Machine) -> Match {
    let slots: []i64 = __make(m.best.len)
    __memmove(slots, m.best)
    Match { input: m.core.input, slots }
}

fn scan(re: Regex, input: str, max: i64, visit: fn(Match)) {
    let m = borrow(re, re.full, slot_count(re), input)
    var from = 0
    var after_empty = false
    var count = 0
    for from <= input.len && count != max {
        if !search(mut *m, Search { from, reject_empty: after_empty }) {
            break
        }
        let found = captured(m)
        visit(found)
        count += 1
        after_empty = found.slots[0] == found.slots[1]
        from = found.slots[1]
    }
    release(re.full, m)
}
