struct Search {
    from: i64
    anchored: bool = false
    whole: bool = false
    reject_empty: bool = false
    first: bool = false
}

struct Frame {
    pc: i64
    slot: i64
    value: i64
}

struct Queue {
    sparse: []i64
    pcs: []i64
    slots: []i64
    len: i64
}

struct Core {
    program: []Inst
    width: i64
    input: str
    scratch: []i64
    stack: []Frame
}

struct Machine {
    core: Core
    run: Queue
    next: Queue
    best: []i64
    matched: bool
}

fn end_of_input() -> u32 {
    0xFFFFFFFF
}

fn queue(size: i64, width: i64) -> Queue {
    Queue { sparse: __make(size), pcs: __make(size), slots: __make(size * width), len: 0 }
}

fn machine(program: []Inst, width: i64, input: str) -> Machine {
    let core = Core { program, width, input, scratch: __make(width), stack: __make(2 * program.len + 2) }
    let run = queue(program.len, width)
    let next = queue(program.len, width)
    Machine { core, run, next, best: __make(width), matched: false }
}

fn search(mut m: Machine, s: Search) -> bool {
    let input = m.core.input
    m.matched = false
    m.run.len = 0
    var pos = s.from
    for {
        if m.run.len == 0 && (m.matched || s.anchored && pos > s.from) {
            break
        }
        if !m.matched && (!s.anchored || pos == s.from) {
            start_thread(m.core, mut m.run, pos)
        }
        var c = end_of_input()
        var width = 0
        if pos < input.len {
            let r = decode(input, pos)
            c = r.code
            width = r.size
        }
        m.next.len = 0
        step(mut m, s, pos, c, pos + width)
        if s.first && m.matched || pos >= input.len {
            break
        }
        pos += width
        let done = m.run
        m.run = m.next
        m.next = done
    }
    m.matched
}

fn start_thread(core: Core, mut q: Queue, pos: i64) {
    for i in 0..core.width {
        core.scratch[i] = -1
    }
    add(core, mut q, 0, pos)
}

fn step(mut m: Machine, s: Search, pos: i64, c: u32, next_pos: i64) {
    for j in 0..m.run.len {
        let pc = m.run.pcs[j]
        match m.core.program[pc] {
            Done => {
                if accepts(m.core, s, pos) {
                    keep(mut m, j)
                    return
                }
            }
            Char(want) => {
                if c == want {
                    advance(mut m, j, pc, next_pos)
                }
            }
            Class(ranges) => {
                if in_class(ranges, c) {
                    advance(mut m, j, pc, next_pos)
                }
            }
            _ => {}
        }
    }
}

fn accepts(core: Core, s: Search, pos: i64) -> bool {
    if s.whole && pos != core.input.len {
        return false
    }
    !(s.reject_empty && pos == s.from)
}

fn keep(mut m: Machine, j: i64) {
    let w = m.core.width
    for i in 0..w {
        m.best[i] = m.run.slots[j * w + i]
    }
    m.matched = true
}

fn advance(mut m: Machine, j: i64, pc: i64, next_pos: i64) {
    let w = m.core.width
    for i in 0..w {
        m.core.scratch[i] = m.run.slots[j * w + i]
    }
    add(m.core, mut m.next, pc + 1, next_pos)
}

fn add(core: Core, mut q: Queue, start: i64, pos: i64) {
    let stack = core.stack
    stack[0] = Frame { pc: start, slot: -1, value: 0 }
    var top = 1
    for top > 0 {
        top -= 1
        let f = stack[top]
        if f.slot >= 0 {
            core.scratch[f.slot] = f.value
            continue
        }
        let pc = f.pc
        let at = q.sparse[pc]
        if at < q.len && q.pcs[at] == pc {
            continue
        }
        let k = q.len
        q.sparse[pc] = k
        q.pcs[k] = pc
        q.len += 1
        match core.program[pc] {
            Jump(to) => {
                stack[top] = Frame { pc: to, slot: -1, value: 0 }
                top += 1
            }
            Split(first, second) => {
                stack[top] = Frame { pc: second, slot: -1, value: 0 }
                stack[top + 1] = Frame { pc: first, slot: -1, value: 0 }
                top += 2
            }
            Save(slot) => {
                if slot < core.width {
                    stack[top] = Frame { pc: -1, slot, value: core.scratch[slot] }
                    top += 1
                    core.scratch[slot] = pos
                }
                stack[top] = Frame { pc: pc + 1, slot: -1, value: 0 }
                top += 1
            }
            Check(look) => {
                if holds(look, core.input, pos) {
                    stack[top] = Frame { pc: pc + 1, slot: -1, value: 0 }
                    top += 1
                }
            }
            _ => {
                for i in 0..core.width {
                    q.slots[k * core.width + i] = core.scratch[i]
                }
            }
        }
    }
}

fn holds(look: Look, input: str, pos: i64) -> bool {
    match look {
        TextStart => pos == 0
        TextEnd => pos == input.len
        EndOrFinalNewline => pos == input.len || pos == input.len - 1 && input[pos] == '\n'
        LineStart => pos == 0 || input[pos - 1] == '\n'
        LineEnd => pos == input.len || input[pos] == '\n'
        WordBoundary => word_before(input, pos) != word_at(input, pos)
        NotWordBoundary => word_before(input, pos) == word_at(input, pos)
    }
}

fn word_before(input: str, pos: i64) -> bool {
    pos > 0 && word_byte(input[pos - 1])
}

fn word_at(input: str, pos: i64) -> bool {
    pos < input.len && word_byte(input[pos])
}

fn word_byte(c: u8) -> bool {
    c >= '0' && c <= '9' || c >= 'A' && c <= 'Z' || c >= 'a' && c <= 'z' || c == '_'
}

fn in_class(ranges: []Range, c: u32) -> bool {
    var lo = 0
    var hi = ranges.len
    for lo < hi {
        let mid = (lo + hi) / 2
        let r = ranges[mid]
        if c < r.lo {
            hi = mid
        } else if c > r.hi {
            lo = mid + 1
        } else {
            return true
        }
    }
    false
}

struct Rune {
    code: u32
    size: i64
}

fn continuation(s: str, i: i64) -> bool {
    i < s.len && s[i] & 0xC0 == 0x80
}

fn decode(s: str, i: i64) -> Rune {
    let b0 = u32(s[i])
    if b0 < 0x80 {
        return Rune { code: b0, size: 1 }
    }
    if b0 >= 0xC2 && b0 < 0xE0 && continuation(s, i + 1) {
        return Rune { code: (b0 & 0x1F) << 6 | u32(s[i + 1]) & 0x3F, size: 2 }
    }
    if b0 >= 0xE0 && b0 < 0xF0 && continuation(s, i + 1) && continuation(s, i + 2) {
        let code = (b0 & 0x0F) << 12 | (u32(s[i + 1]) & 0x3F) << 6 | u32(s[i + 2]) & 0x3F
        if code >= 0x800 && (code < 0xD800 || code >= 0xE000) {
            return Rune { code, size: 3 }
        }
    }
    if b0 >= 0xF0 && b0 < 0xF5 && continuation(s, i + 1) && continuation(s, i + 2) && continuation(s, i + 3) {
        let high = (b0 & 0x07) << 18 | (u32(s[i + 1]) & 0x3F) << 12
        let code = high | (u32(s[i + 2]) & 0x3F) << 6 | u32(s[i + 3]) & 0x3F
        if code >= 0x10000 && code <= 0x10FFFF {
            return Rune { code, size: 4 }
        }
    }
    Rune { code: 0xFFFD, size: 1 }
}
