enum Inst {
    Char(c: u32)
    Class(ranges: []Range)
    Split(first: i64, second: i64)
    Jump(to: i64)
    Save(slot: i64)
    Check(look: Look)
    Done
}

fn max_program() -> i64 {
    100000
}

fn assemble(root: Node) -> []Inst ! Error {
    var code: []Inst = [Save(0)]
    emit_node(mut code, root)?
    emit(mut code, Save(1))?
    emit(mut code, Done)?
    code
}

fn emit(mut code: []Inst, inst: Inst) -> i64 ! Error {
    if code.len >= max_program() {
        fail Invalid(0, "pattern too large")
    }
    push(mut code, inst)
    code.len - 1
}

fn emit_node(mut code: []Inst, node: Node) ! Error {
    match node {
        Empty => {}
        Literal(c) => {
            emit(mut code, Char(c))?
        }
        Set(ranges) => {
            emit(mut code, Class(ranges))?
        }
        Assert(look) => {
            emit(mut code, Check(look))?
        }
        Capture(index, body) => {
            emit(mut code, Save(2 * index))?
            emit_node(mut code, *body)?
            emit(mut code, Save(2 * index + 1))?
        }
        Concat(items) => {
            for item in items {
                emit_node(mut code, item)?
            }
        }
        Alternate(branches) => emit_alternate(mut code, branches)?
        Repeat(body, min, max, greedy) => emit_repeat(mut code, *body, min, max, greedy)?
    }
}

fn emit_alternate(mut code: []Inst, branches: []Node) ! Error {
    var exits: []i64 = []
    for i, branch in branches {
        if i == branches.len - 1 {
            emit_node(mut code, branch)?
        } else {
            let split = emit(mut code, Split(0, 0))?
            emit_node(mut code, branch)?
            let exit = emit(mut code, Jump(0))?
            push(mut exits, exit)
            code[split] = Split(split + 1, code.len)
        }
    }
    for exit in exits {
        code[exit] = Jump(code.len)
    }
}

fn emit_repeat(mut code: []Inst, body: Node, min: i64, max: i64, greedy: bool) ! Error {
    if max < 0 {
        emit_unbounded(mut code, body, min, greedy)?
        return
    }
    for i in 0..min {
        emit_node(mut code, body)?
    }
    var splits: []i64 = []
    for i in min..max {
        let split = emit(mut code, Split(0, 0))?
        push(mut splits, split)
        emit_node(mut code, body)?
    }
    for split in splits {
        code[split] = branch(split + 1, code.len, greedy)
    }
}

fn emit_unbounded(mut code: []Inst, body: Node, min: i64, greedy: bool) ! Error {
    for i in 1..min {
        emit_node(mut code, body)?
    }
    var skip = -1
    if min == 0 {
        skip = emit(mut code, Split(0, 0))?
    }
    let loop = code.len
    emit_node(mut code, body)?
    let back = emit(mut code, Split(0, 0))?
    code[back] = branch(loop, code.len, greedy)
    if skip >= 0 {
        code[skip] = branch(loop, code.len, greedy)
    }
}

fn branch(more: i64, out: i64, greedy: bool) -> Inst {
    if greedy {
        return Split(more, out)
    }
    Split(out, more)
}
