import std/io
import std/mail
import std/text

pub struct Reply {
    pub code: i64
    pub lines: []str
}

pub struct Limits {
    pub lines: i64 = 1024
}

pub struct Extensions {
    pub greeting: str = ""
    pub names: []str = []
    pub mechanisms: []str = []
    pub size: i64 = 0
    pub starttls: bool = false
    pub eight_bit_mime: bool = false
    pub smtputf8: bool = false
    pub pipelining: bool = false
    pub enhanced_codes: bool = false
}

pub enum Error {
    Connect
    Closed
    Timeout
    Protocol
    TooLarge
    Insecure
    MessageTooLarge
    Unsupported(feature: str)
    Transient(code: i64, message: str)
    Permanent(code: i64, message: str)
    Auth(message: str)
    Invalid(error: mail.Error)
}

pub fn transport(e: io.Error) -> Error {
    match e {
        TimedOut => Timeout
        TooLarge => TooLarge
        Malformed => Protocol
        _ => Closed
    }
}

pub fn text_of(r: Reply) -> str {
    text.join(r.lines, "\n")
}

pub fn family(r: Reply) -> i64 {
    r.code / 100
}

pub fn positive(r: Reply) -> bool {
    family(r) == 2
}

pub fn parse_reply(data: []u8) -> Reply ! Error {
    parse_reply_with(data, Limits {})
}

pub fn parse_reply_with(data: []u8, limits: Limits) -> Reply ! Error {
    let r = io.bytes_reader(data)
    read_reply(r, limits) catch {
        Closed => fail Protocol
        e => fail e
    }
}

fn digit(c: u8) -> bool {
    c >= '0' && c <= '9'
}

fn code_of(line: str) -> i64 ! Error {
    if line.len < 3 {
        fail Protocol
    }
    if !digit(line[0]) || !digit(line[1]) || !digit(line[2]) {
        fail Protocol
    }
    let code = i64(line[0] - '0') * 100 + i64(line[1] - '0') * 10 + i64(line[2] - '0')
    if code < 100 || code > 599 {
        fail Protocol
    }
    code
}

fn more_follows(line: str) -> bool ! Error {
    if line.len == 3 {
        return false
    }
    if line[3] == ' ' {
        return false
    }
    if line[3] == '-' {
        return true
    }
    fail Protocol
}

fn body_of(line: str) -> str {
    if line.len > 4 {
        return line[4..]
    }
    ""
}

fn next_line(r: *io.Reader) -> str ! Error {
    io.read_line(r) catch {
        e => fail transport(e)
    }
}

pub fn read_reply(r: *io.Reader, limits: Limits) -> Reply ! Error {
    var code = 0
    var lines: []str = []
    for {
        let line = next_line(r)?
        let this = code_of(line)?
        if lines.len == 0 {
            code = this
        } else if this != code {
            fail Protocol
        }
        if lines.len >= limits.lines {
            fail TooLarge
        }
        push(mut lines, body_of(line))
        let more = more_follows(line)?
        if !more {
            return Reply { code, lines }
        }
    }
}

fn keyword_of(line: str) -> str {
    let cut = text.cut(line, " ")
    text.upper(cut.before)
}

fn params_of(line: str) -> str {
    let cut = text.cut(line, " ")
    text.trim(cut.after)
}

fn size_of(param: str) -> i64 {
    let n = text.parse_int(param) catch {
        _ => return 0
    }
    if n < 0 { 0 } else { n }
}

fn add_mechanisms(mut e: Extensions, list: str) {
    for word in text.fields(list) {
        let name = text.upper(word)
        if !supports(e, name) {
            push(mut e.mechanisms, name)
        }
    }
}

fn apply_extension(mut e: Extensions, line: str) {
    let keyword = keyword_of(line)
    if keyword.len == 0 {
        return
    }
    push(mut e.names, keyword)
    if text.starts_with(keyword, "AUTH=") {
        add_mechanisms(mut e, keyword[5..])
        return
    }
    if keyword == "AUTH" {
        add_mechanisms(mut e, params_of(line))
    } else if keyword == "SIZE" {
        e.size = size_of(params_of(line))
    } else if keyword == "STARTTLS" {
        e.starttls = true
    } else if keyword == "8BITMIME" {
        e.eight_bit_mime = true
    } else if keyword == "SMTPUTF8" {
        e.smtputf8 = true
    } else if keyword == "PIPELINING" {
        e.pipelining = true
    } else if keyword == "ENHANCEDSTATUSCODES" {
        e.enhanced_codes = true
    }
}

pub fn parse_extensions(r: Reply) -> Extensions {
    var e = Extensions {}
    for i, line in r.lines {
        if i == 0 {
            e.greeting = line
            continue
        }
        apply_extension(mut e, line)
    }
    e
}

pub fn supports(e: Extensions, mechanism: str) -> bool {
    for m in e.mechanisms {
        if m == text.upper(mechanism) {
            return true
        }
    }
    false
}
