import std/base64
import std/crypto/hash
import std/crypto/md5
import std/text

/// An SMTP authentication mechanism.
pub enum Mechanism {
    /// Picks a mechanism the server advertises. `choose` defines the order, and `XOAuth2` is never picked.
    Auto
    /// `PLAIN`: sends the user name and password in one step.
    Plain
    /// `LOGIN`: sends the user name and the password in two steps.
    Login
    /// `XOAUTH2`: authenticates with an OAuth 2 bearer token passed as the password.
    XOAuth2
    /// `CRAM-MD5`: answers a server challenge with an HMAC-MD5 digest, so the password is not sent.
    CramMd5
}

/// Returns the name a server advertises for `m`: `AUTO`, `PLAIN`, `LOGIN`, `XOAUTH2` or `CRAM-MD5`.
pub fn mechanism_name(m: Mechanism) -> str {
    match m {
        Auto => "AUTO"
        Plain => "PLAIN"
        Login => "LOGIN"
        XOAuth2 => "XOAUTH2"
        CramMd5 => "CRAM-MD5"
    }
}

/// Returns the base64 initial response of `PLAIN`: an empty authorization identity, `user` and `password`, each preceded by a NUL byte.
pub fn plain_response(user: str, password: str) -> str {
    base64.encode(bytes("\0{user}\0{password}"))
}

/// Returns the base64 encoding of `value`, the response to each `LOGIN` prompt. Use it once for the user name and once for the password.
pub fn login_response(value: str) -> str {
    base64.encode(bytes(value))
}

/// Returns the base64 initial response of `XOAUTH2` for `user` and the bearer `token`.
pub fn xoauth2_response(user: str, token: str) -> str {
    var out: []u8 = []
    text.append(mut out, "user={user}")
    push(mut out, 1)
    text.append(mut out, "auth=Bearer {token}")
    push(mut out, 1)
    push(mut out, 1)
    base64.encode(out)
}

/// Returns the lowercase hexadecimal HMAC-MD5 of `challenge`, keyed with `password`.
///
/// `challenge` is the decoded server challenge.
pub fn cram_md5_digest(password: str, challenge: str) -> str {
    let mac = hash.hmac(md5.md5(), bytes(password), bytes(challenge))
    text.encode_hex(mac)
}

/// Returns the base64 `CRAM-MD5` response: `user`, a space and `cram_md5_digest(password, challenge)`.
///
/// `challenge` is the decoded server challenge.
pub fn cram_md5_response(user: str, password: str, challenge: str) -> str {
    let digest = cram_md5_digest(password, challenge)
    base64.encode(bytes("{user} {digest}"))
}

/// Decodes a base64 server challenge, ignoring surrounding whitespace.
///
/// Fails with `base64.DecodeError` when `encoded` is not valid base64.
pub fn decode_challenge(encoded: str) -> str ! base64.DecodeError {
    let raw = base64.decode(text.trim(encoded))?
    str(raw)
}

fn preference(encrypted: bool) -> []Mechanism {
    if encrypted {
        return [Plain, Login, CramMd5]
    }
    [CramMd5, Plain, Login]
}

/// Returns the preferred mechanism the server advertises, or `none` when it advertises none of them.
///
/// On an encrypted connection the order is `Plain`, `Login`, `CramMd5`. On an unencrypted one `CramMd5` comes first, because it does not send the password. `XOAuth2` and `Auto` are never returned.
pub fn choose(advertised: []str, encrypted: bool) -> Mechanism? {
    for m in preference(encrypted) {
        if supports(advertised, mechanism_name(m)) {
            return some(m)
        }
    }
    none
}
