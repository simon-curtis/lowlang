import std/text

pub fn dot_stuff(data: []u8) -> []u8 {
    var out: []u8 = []
    var line_start = true
    var i = 0
    for i < data.len {
        let c = data[i]
        if c == '\r' || c == '\n' {
            if c == '\r' && i + 1 < data.len && data[i + 1] == '\n' {
                i += 1
            }
            text.append(mut out, "\r\n")
            line_start = true
            i += 1
            continue
        }
        if line_start && c == '.' {
            push(mut out, '.')
        }
        push(mut out, c)
        line_start = false
        i += 1
    }
    if !line_start {
        text.append(mut out, "\r\n")
    }
    text.append(mut out, ".\r\n")
    out
}
