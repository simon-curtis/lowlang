import std/io
import std/mail
import std/net
import std/sync
import std/text
import std/tls

/// Settings for connecting to an SMTP server.
pub struct Options {
    /// The server host name or address. Also the TLS server name when the TLS configuration has none. Defaults to `127.0.0.1`.
    pub host: str = "127.0.0.1"
    /// The server port. Defaults to `25`; submission with `STARTTLS` usually uses `587` and implicit TLS `465`.
    pub port: i64 = 25
    /// The name sent in `EHLO`, or in `HELO` when the server rejects `EHLO`. Must not contain a line break or NUL; otherwise connecting fails with `Invalid`. Defaults to `localhost`.
    pub hello: str = "localhost"
    /// The user name. When non-empty, connecting also authenticates with `username` and `password`.
    pub username: str = ""
    /// The password, or the bearer token for `XOAuth2`.
    pub password: str = ""
    /// The authentication mechanism. Defaults to `Auto`.
    pub mechanism: Mechanism = Auto
    /// Allows `Plain`, `Login` and `XOAuth2` to send credentials over an unencrypted connection. Without it they fail with `Insecure`. Defaults to `false`.
    pub insecure_auth: bool = false
    /// Milliseconds a read or write on the established connection may take before it fails with `Timeout`. `0` means no limit.
    pub timeout: i64 = 0
    /// Milliseconds the TCP connection may take before `connect` fails with `Timeout`. `0` means no limit.
    pub connect_timeout: i64 = 0
    /// The bounds applied when reading replies.
    pub limits: Limits = Limits {}
}

/// A shared reference to an SMTP connection, for use from several tasks.
///
/// Commands on one handle are serialised, so only one runs at a time.
pub struct ClientHandle {
    stream: io.Stream
    reader: *io.Reader
    gate: sync.Mutex
    timeouts: *net.Timeouts
    limits: Limits
    host: str
    hello: str
    insecure_auth: bool
    lock: i64
    closed: bool
    /// The current read and write timeout in milliseconds. Change it with `set_timeout_on`.
    pub timeout: i64
    /// Whether the connection is encrypted with TLS.
    pub encrypted: bool
    /// The extensions the server announced in its most recent `EHLO` reply. After a `HELO` fallback only the greeting is set.
    pub extensions: Extensions
}

/// An owned SMTP connection.
///
/// Dropping a `Client` closes the connection without sending `QUIT`, unless it was passed to `detach`. Call `quit` for an orderly close.
pub struct Client {
    /// The shared handle of the connection.
    pub handle: *ClientHandle
    detached: bool = false
    drop {
        if !detached {
            close_client_on(handle)
        }
    }
}

/// The sender and recipients of one message as given to the SMTP commands, separate from the message headers.
pub struct Envelope {
    /// The reverse path sent in `MAIL FROM`. Empty sends the null sender `<>`, used for bounces.
    pub from: str
    /// The forward paths sent in `RCPT TO`. At least one is required.
    pub to: []str
    /// Declares the data as `8BITMIME`, which the server must advertise.
    pub eight_bit: bool = false
    /// Declares `SMTPUTF8` for internationalised addresses, which the server must advertise.
    pub utf8: bool = false
}

/// A recipient the server refused.
pub struct Refusal {
    /// The recipient address.
    pub address: str
    /// The reply code of the refusal.
    pub code: i64
    /// The text of the refusal.
    pub message: str
}

/// The outcome of a delivery the server accepted.
pub struct Receipt {
    /// The recipients the server accepted.
    pub accepted: []str
    /// The recipients the server refused. The message was still delivered to `accepted`.
    pub refused: []Refusal
    /// The reply code the server gave after the data.
    pub code: i64
    /// The text of the reply the server gave after the data, which commonly carries a queue identifier.
    pub message: str
}

struct Opened {
    sender: Reply
    recipients: []Reply
}

/// Wraps a handle in a `Client` that closes the connection when dropped.
pub fn adopt(h: *ClientHandle) -> Client {
    Client { handle: h }
}

/// Releases `c` from closing the connection when dropped and returns its handle.
///
/// The caller becomes responsible for calling `close_client_on` or `quit_on`.
pub fn detach(mut c: Client) -> *ClientHandle {
    c.detached = true
    c.handle
}

fn open(s: io.Stream, timeouts: *net.Timeouts, o: Options, encrypted: bool) -> *ClientHandle {
    new(ClientHandle {
        stream: s
        reader: io.reader(s)
        gate: sync.mutex()
        timeouts
        limits: o.limits
        host: o.host
        hello: o.hello
        insecure_auth: o.insecure_auth
        lock: 0
        closed: false
        timeout: o.timeout
        encrypted
        extensions: Extensions {}
    })
}

fn apply_timeout(t: *net.Timeouts, millis: i64) {
    t.read = millis
    t.write = millis
}

fn dial(o: Options) -> net.Conn ! Error {
    using conn = net.dial_within(o.host, o.port, o.connect_timeout) catch {
        TimedOut => fail Timeout
        _ => fail Connect
    }
    conn
}

fn named(config: tls.Config, host: str) -> tls.Config {
    var out = config
    if out.server_name.len == 0 {
        out.server_name = host
    }
    out
}

/// Connects to the server in plain text, reads the greeting, sends `EHLO` and authenticates when `o.username` is set.
///
/// If the server rejects `EHLO` with a `5xx` code, `HELO` is tried. Fails with `Connect` or `Timeout` while connecting, `Transient` or `Permanent` when the server refuses the greeting or the hello, and with the errors of `authenticate`, which includes `Insecure` for password mechanisms unless `o.insecure_auth` is set. A failure after the connection is made closes it.
pub fn connect(o: Options) -> Client ! Error {
    connect_plain(o, none)
}

fn connect_plain(o: Options, upgrade_to: tls.Config?) -> Client ! Error {
    using var conn = dial(o)?
    let wire = net.detach(mut conn)
    apply_timeout(wire.timeouts, o.timeout)
    let h = open(net.stream_on(wire), wire.timeouts, o, false)
    session(h, o, upgrade_to) catch {
        e => fail abandon(h, e)
    }
    Client { handle: h }
}

/// Connects like `connect` but upgrades to TLS with `STARTTLS` after the first `EHLO`, repeats `EHLO` over the encrypted channel and then authenticates.
///
/// Fails with `Unsupported("STARTTLS")` when the server does not offer it, and with the errors of `connect` otherwise. `config.server_name` defaults to `o.host`.
pub fn connect_starttls(o: Options, config: tls.Config) -> Client ! Error {
    connect_plain(o, some(config))
}

/// Connects with TLS from the first byte, as on port `465`, then reads the greeting, sends `EHLO` and authenticates when `o.username` is set.
///
/// Fails with `Connect` or `Timeout` when the connection or handshake fails, and with the errors of `connect` after that. `config.server_name` defaults to `o.host`.
pub fn connect_tls(o: Options, config: tls.Config) -> Client ! Error {
    using var conn = dial(o)?
    apply_timeout(conn.handle.timeouts, o.timeout)
    let session_config = named(config, o.host)
    let secure = tls.client_handle(net.stream(conn), session_config) catch {
        TimedOut => fail Timeout
        _ => fail Connect
    }
    let wire = net.detach(mut conn)
    let h = open(tls.stream_on(secure), wire.timeouts, o, true)
    session(h, o, none) catch {
        e => fail abandon(h, e)
    }
    Client { handle: h }
}

/// Runs the SMTP session over an already open stream instead of dialling.
///
/// The stream is treated as unencrypted, so password mechanisms need `o.insecure_auth`. `o.timeout` and `set_timeout` have no effect, because the client holds no socket of its own to apply them to. Fails like `connect`, and closes the stream on failure.
pub fn connect_stream(s: io.Stream, o: Options) -> Client ! Error {
    let h = open(s, new(net.Timeouts { read: 0, write: 0 }), o, false)
    session(h, o, none) catch {
        e => fail abandon(h, e)
    }
    Client { handle: h }
}

fn session(h: *ClientHandle, o: Options, upgrade_to: tls.Config?) ! Error {
    greet(h)?
    introduce(h)?
    match upgrade_to {
        some(config) => upgrade(h, config)?
        none => {}
    }
    credentials(h, o)?
}

fn credentials(h: *ClientHandle, o: Options) ! Error {
    if o.username.len == 0 {
        return
    }
    login(h, o.username, o.password, o.mechanism)?
}

/// Closes the connection. See `close_client_on`.
pub fn close_client(c: Client) {
    close_client_on(c.handle)
}

/// Closes the connection without sending `QUIT`. Later commands fail with `Closed`.
///
/// Safe to call more than once and from several tasks. Use `quit_on` for an orderly close.
pub fn close_client_on(h: *ClientHandle) {
    __lock(mut h.lock)
    if h.closed {
        __unlock(mut h.lock)
        return
    }
    h.closed = true
    __unlock(mut h.lock)
    h.stream.close()
}

/// Sets the read and write timeout of the connection. See `set_timeout_on`.
pub fn set_timeout(c: Client, millis: i64) {
    set_timeout_on(c.handle, millis)
}

/// Sets how many milliseconds each read and write on the connection may take before failing with `Timeout`. `0` removes the limit.
///
/// Applies to later operations.
pub fn set_timeout_on(h: *ClientHandle, millis: i64) {
    h.timeout = millis
    apply_timeout(h.timeouts, millis)
}

fn abandon(h: *ClientHandle, e: Error) -> Error {
    close_client_on(h)
    e
}

fn usable(h: *ClientHandle) ! Error {
    if h.closed {
        fail Closed
    }
}

fn family_error(r: Reply) -> Error {
    let message = text_of(r)
    let kind = family(r)
    if kind == 4 {
        return Transient(r.code, message)
    }
    if kind == 5 {
        return Permanent(r.code, message)
    }
    Protocol
}

fn transmit(h: *ClientHandle, payload: []u8) ! Error {
    io.write_all(h.stream, payload) catch {
        e => fail abandon(h, transport(e))
    }
}

fn receive(h: *ClientHandle) -> Reply ! Error {
    read_reply(h.reader, h.limits) catch {
        e => fail abandon(h, e)
    }
}

fn exchange(h: *ClientHandle, line: str) -> Reply ! Error {
    transmit(h, bytes("{line}\r\n"))?
    receive(h)
}

fn expect_positive(r: Reply) ! Error {
    if !positive(r) {
        fail family_error(r)
    }
}

fn clean(label: str, s: str) ! Error {
    for c in bytes(s) {
        if c == '\r' || c == '\n' || c == 0 {
            fail Invalid(mail.Error.HeaderInjection(label))
        }
    }
}

fn greet(h: *ClientHandle) ! Error {
    let r = receive(h)?
    expect_positive(r)?
}

fn first_line(r: Reply) -> str {
    if r.lines.len == 0 {
        return ""
    }
    r.lines[0]
}

fn introduce(h: *ClientHandle) ! Error {
    clean("EHLO", h.hello)?
    let r = exchange(h, "EHLO {h.hello}")?
    if positive(r) {
        h.extensions = parse_extensions(r)
        return
    }
    if family(r) != 5 {
        fail family_error(r)
    }
    let fallback = exchange(h, "HELO {h.hello}")?
    expect_positive(fallback)?
    h.extensions = Extensions { greeting: first_line(fallback) }
}

/// Upgrades the connection to TLS. See `start_tls_on`.
pub fn start_tls(c: Client, config: tls.Config) ! Error {
    start_tls_on(c.handle, config)
}

/// Sends `STARTTLS`, performs the TLS handshake and repeats `EHLO` over the encrypted channel, refreshing `extensions`.
///
/// Does nothing when the connection is already encrypted. Fails with `Unsupported("STARTTLS")` when the server does not advertise it, `Closed` when the client is closed, `Transient` or `Permanent` when the server refuses, and `Connect`, `Timeout` or `Protocol` when the handshake fails or the server sent data before it, which closes the connection. `config.server_name` defaults to the host of the connection. Waits for any command in progress.
pub fn start_tls_on(h: *ClientHandle, config: tls.Config) ! Error {
    sync.lock(h.gate)
    defer sync.unlock(h.gate)
    usable(h)?
    upgrade(h, config)?
}

fn upgrade(h: *ClientHandle, config: tls.Config) ! Error {
    if h.encrypted {
        return
    }
    if !h.extensions.starttls {
        fail Unsupported("STARTTLS")
    }
    let r = exchange(h, "STARTTLS")?
    expect_positive(r)?
    if io.buffered(h.reader) > 0 {
        fail abandon(h, Protocol)
    }
    let session_config = named(config, h.host)
    let secure = tls.client_handle(h.stream, session_config) catch {
        TimedOut => fail abandon(h, Timeout)
        _ => fail abandon(h, Connect)
    }
    h.stream = tls.stream_on(secure)
    h.reader = io.reader(h.stream)
    h.encrypted = true
    introduce(h)?
}

/// Authenticates with the server. See `authenticate_on`.
pub fn authenticate(c: Client, username: str, password: str, mechanism: Mechanism) ! Error {
    authenticate_on(c.handle, username, password, mechanism)
}

/// Authenticates with `username` and `password` using `mechanism`.
///
/// `Auto` picks the first of the mechanisms the server advertises that `choose` prefers. Fails with `Unsupported` when the server advertises no usable mechanism or not the requested one, `Insecure` when a password mechanism would run over an unencrypted connection without `insecure_auth`, `Auth(message)` when the server rejects the credentials, `Transient` for a `4xx` reply and `Protocol` for an unexpected reply. Waits for any command in progress.
pub fn authenticate_on(h: *ClientHandle, username: str, password: str, mechanism: Mechanism) ! Error {
    sync.lock(h.gate)
    defer sync.unlock(h.gate)
    usable(h)?
    login(h, username, password, mechanism)?
}

fn sends_password(m: Mechanism) -> bool {
    match m {
        CramMd5 => false
        _ => true
    }
}

fn select_mechanism(h: *ClientHandle, requested: Mechanism) -> Mechanism ! Error {
    let advertised = h.extensions.mechanisms
    match requested {
        Auto => {
            let found = choose(advertised, h.encrypted)
            match found {
                some(m) => return m
                none => fail Unsupported("AUTH")
            }
        }
        _ => {}
    }
    if !supports(advertised, mechanism_name(requested)) {
        fail Unsupported(mechanism_name(requested))
    }
    requested
}

fn login(h: *ClientHandle, username: str, password: str, requested: Mechanism) ! Error {
    let chosen = select_mechanism(h, requested)?
    if !h.encrypted && !h.insecure_auth && sends_password(chosen) {
        fail Insecure
    }
    match chosen {
        Plain => auth_plain(h, username, password)?
        Login => auth_login(h, username, password)?
        CramMd5 => auth_cram_md5(h, username, password)?
        XOAuth2 => auth_xoauth2(h, username, password)?
        Auto => fail Unsupported("AUTH")
    }
}

fn authenticated(r: Reply) ! Error {
    if positive(r) {
        return
    }
    if family(r) == 4 {
        fail family_error(r)
    }
    fail Auth(text_of(r))
}

fn challenged(r: Reply) ! Error {
    if r.code == 334 {
        return
    }
    authenticated(r)?
    fail Protocol
}

fn auth_plain(h: *ClientHandle, username: str, password: str) ! Error {
    let r = exchange(h, "AUTH PLAIN {plain_response(username, password)}")?
    authenticated(r)?
}

fn auth_login(h: *ClientHandle, username: str, password: str) ! Error {
    let start = exchange(h, "AUTH LOGIN")?
    challenged(start)?
    let user_step = exchange(h, login_response(username))?
    challenged(user_step)?
    let done = exchange(h, login_response(password))?
    authenticated(done)?
}

fn auth_cram_md5(h: *ClientHandle, username: str, password: str) ! Error {
    let start = exchange(h, "AUTH CRAM-MD5")?
    challenged(start)?
    let challenge = decode_challenge(first_line(start)) catch {
        _ => fail abandon(h, Protocol)
    }
    let response = cram_md5_response(username, password, challenge)
    let done = exchange(h, response)?
    authenticated(done)?
}

fn oauth_failure(first: Reply, last: Reply) -> Error {
    let detail = decode_challenge(first_line(first)) catch {
        _ => text_of(last)
    }
    Auth(detail)
}

fn auth_xoauth2(h: *ClientHandle, username: str, token: str) ! Error {
    let r = exchange(h, "AUTH XOAUTH2 {xoauth2_response(username, token)}")?
    if r.code != 334 {
        authenticated(r)?
        return
    }
    let last = exchange(h, "")?
    fail oauth_failure(r, last)
}

fn simple(h: *ClientHandle, line: str) ! Error {
    sync.lock(h.gate)
    defer sync.unlock(h.gate)
    usable(h)?
    let r = exchange(h, line)?
    expect_positive(r)?
}

/// Sends `NOOP`, which keeps the connection alive. See `noop_on`.
pub fn noop(c: Client) ! Error {
    simple(c.handle, "NOOP")?
}

/// Sends `NOOP` and waits for the reply. Fails with `Closed` when the client is closed, `Transient` or `Permanent` when the server refuses, and with a transport error that also closes the connection.
pub fn noop_on(h: *ClientHandle) ! Error {
    simple(h, "NOOP")?
}

/// Abandons the current mail transaction. See `reset_on`.
pub fn reset(c: Client) ! Error {
    simple(c.handle, "RSET")?
}

/// Sends `RSET`, which abandons any mail transaction in progress, and waits for the reply. Fails like `noop_on`.
pub fn reset_on(h: *ClientHandle) ! Error {
    simple(h, "RSET")?
}

/// Ends the session and closes the connection. See `quit_on`.
pub fn quit(c: Client) {
    quit_on(c.handle)
}

/// Sends `QUIT` and closes the connection.
///
/// Errors while sending are ignored, and the connection is closed in every case. Safe to call more than once.
pub fn quit_on(h: *ClientHandle) {
    sync.lock(h.gate)
    if !h.closed {
        attempt(h, "QUIT")
    }
    sync.unlock(h.gate)
    close_client_on(h)
}

/// Renders and sends a message. See `send_on`.
pub fn send(c: Client, m: mail.Message) -> Receipt ! Error {
    send_on(c.handle, m)
}

/// Renders `m` with `mail.render` and sends it to the recipients from `mail.recipients`, which include `bcc`.
///
/// The envelope sender is `m.from.email`, and `8BITMIME` and `SMTPUTF8` are requested when `mail.needs_8bit` and `mail.needs_utf8` report that the message needs them. Fails with `Invalid` when the message cannot be rendered or has no valid recipients, and with the errors of `send_raw_on`.
pub fn send_on(h: *ClientHandle, m: mail.Message) -> Receipt ! Error {
    let rendered = mail.render(m) catch {
        e => fail Invalid(e)
    }
    let to = mail.recipients(m) catch {
        e => fail Invalid(e)
    }
    let envelope = Envelope {
        from: m.from.email
        to
        eight_bit: mail.needs_8bit(m)
        utf8: mail.needs_utf8(m)
    }
    send_raw_on(h, envelope, bytes(rendered))
}

/// Sends already rendered message data. See `send_raw_on`.
pub fn send_raw(c: Client, e: Envelope, data: []u8) -> Receipt ! Error {
    send_raw_on(c.handle, e, data)
}

/// Sends `data`, a complete RFC 5322 message, with the given envelope.
///
/// The data is dot stuffed and terminated here. The transaction is `MAIL FROM`, one `RCPT TO` per recipient and `DATA`; when the server advertises `PIPELINING` the first two are sent together. `SIZE` is declared when the server announces a limit. A recipient the server refuses is listed in `Receipt.refused` and does not fail the call. The call fails with `Transient` or `Permanent` when the sender, every recipient, the `DATA` command or the final reply is refused; `RSET` is sent when every recipient or the `DATA` command is refused. It fails with `Invalid` for an invalid address or no recipients, `Unsupported` when the envelope needs `8BITMIME` or `SMTPUTF8` and the server lacks it, `MessageTooLarge` when the data exceeds the announced size, and `Closed`, `Timeout` or `Protocol` on transport failures, which close the connection. Waits for any command in progress.
pub fn send_raw_on(h: *ClientHandle, e: Envelope, data: []u8) -> Receipt ! Error {
    check_envelope(e)?
    let block = dot_stuff(data)
    let size = block.len - 3
    sync.lock(h.gate)
    defer sync.unlock(h.gate)
    usable(h)?
    check_capabilities(h, e, size)?
    let opened = open_envelope(h, e, size)?
    deliver(h, e, opened, block)?
}

fn check_path(address: str) ! Error {
    if !mail.valid_email(address) {
        fail Invalid(mail.Error.InvalidAddress(address))
    }
}

fn check_envelope(e: Envelope) ! Error {
    if e.from.len > 0 {
        check_path(e.from)?
    }
    if e.to.len == 0 {
        fail Invalid(mail.Error.NoRecipients)
    }
    for address in e.to {
        check_path(address)?
    }
}

fn check_capabilities(h: *ClientHandle, e: Envelope, size: i64) ! Error {
    if e.utf8 && !h.extensions.smtputf8 {
        fail Unsupported("SMTPUTF8")
    }
    if e.eight_bit && !h.extensions.eight_bit_mime {
        fail Unsupported("8BITMIME")
    }
    if h.extensions.size > 0 && size > h.extensions.size {
        fail MessageTooLarge
    }
}

fn sender_command(h: *ClientHandle, e: Envelope, size: i64) -> str {
    var out = "MAIL FROM:<{e.from}>"
    if h.extensions.size > 0 {
        out = "{out} SIZE={size}"
    }
    if e.eight_bit {
        out = "{out} BODY=8BITMIME"
    }
    if e.utf8 {
        out = "{out} SMTPUTF8"
    }
    out
}

fn envelope_lines(h: *ClientHandle, e: Envelope, size: i64) -> []str {
    var lines = [sender_command(h, e, size)]
    for address in e.to {
        push(mut lines, "RCPT TO:<{address}>")
    }
    lines
}

fn open_envelope(h: *ClientHandle, e: Envelope, size: i64) -> Opened ! Error {
    let lines = envelope_lines(h, e, size)
    if h.extensions.pipelining {
        return pipelined(h, lines)
    }
    stepwise(h, lines)
}

fn pipelined(h: *ClientHandle, lines: []str) -> Opened ! Error {
    var payload: []u8 = []
    for line in lines {
        text.append(mut payload, "{line}\r\n")
    }
    transmit(h, payload)?
    var replies: []Reply = []
    for _ in 0..lines.len {
        let r = receive(h)?
        push(mut replies, r)
    }
    opened_from(replies)
}

fn stepwise(h: *ClientHandle, lines: []str) -> Opened ! Error {
    var replies: []Reply = []
    for line in lines {
        let r = exchange(h, line)?
        push(mut replies, r)
        if replies.len == 1 && !positive(r) {
            break
        }
    }
    opened_from(replies)
}

fn opened_from(replies: []Reply) -> Opened {
    var rest: []Reply = []
    for i in 1..replies.len {
        push(mut rest, replies[i])
    }
    Opened { sender: replies[0], recipients: rest }
}

fn attempt(h: *ClientHandle, line: str) {
    let r = exchange(h, line) catch {
        _ => return
    }
}

fn deliver(h: *ClientHandle, e: Envelope, opened: Opened, block: []u8) -> Receipt ! Error {
    if !positive(opened.sender) {
        fail family_error(opened.sender)
    }
    var accepted: []str = []
    var refused: []Refusal = []
    for i, address in e.to {
        let r = opened.recipients[i]
        if positive(r) {
            push(mut accepted, address)
        } else {
            push(mut refused, Refusal { address, code: r.code, message: text_of(r) })
        }
    }
    if accepted.len == 0 {
        attempt(h, "RSET")
        fail family_error(opened.recipients[0])
    }
    let go_ahead = exchange(h, "DATA")?
    if go_ahead.code != 354 {
        attempt(h, "RSET")
        fail family_error(go_ahead)
    }
    transmit(h, block)?
    let done = receive(h)?
    expect_positive(done)?
    Receipt { accepted, refused, code: done.code, message: text_of(done) }
}
