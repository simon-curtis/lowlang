import std/crypto
import std/text
import std/time

/// Why a UUID string was rejected.
pub enum ParseError {
    /// The string is not 36 bytes long.
    Length
    /// A byte is not a hexadecimal digit, or a hyphen is missing where the format requires one. `at` is its index.
    BadDigit(at: i64)
}

/// A 128-bit universally unique identifier.
/// `bytes` holds the 16 bytes in network order.
pub struct Uuid {
    /// The 16 bytes of the identifier, most significant first.
    pub bytes: []u8
}

fn stamp(mut b: []u8, version: u8) -> Uuid {
    b[6] = b[6] & 0x0F | version << 4
    b[8] = b[8] & 0x3F | 0x80
    Uuid { bytes: b }
}

/// Returns a random version 4 UUID with the RFC 9562 variant bits.
/// The 122 free bits come from `std/crypto`'s random source.
pub fn v4() -> Uuid {
    var b = crypto.random(16)
    stamp(mut b, 4)
}

/// Returns a version 7 UUID that sorts by creation time.
/// The first 48 bits are the Unix time in milliseconds read from the real-time clock, the version and variant bits follow RFC 9562, and the remaining bits are random. UUIDs made within one millisecond are not ordered among themselves.
pub fn v7() -> Uuid {
    var b = crypto.random(16)
    let millis = time.now_millis()
    for i in 0..6 {
        b[i] = u8(millis >> (8 * (5 - i)) & 0xFF)
    }
    stamp(mut b, 7)
}

/// Returns the version number held in the high four bits of byte 6.
/// The variant bits are not checked.
pub fn version(u: Uuid) -> i64 {
    i64(u.bytes[6] >> 4)
}

/// Returns the nil UUID, whose 128 bits are all zero.
pub fn nil() -> Uuid {
    let zero: []u8 = __make(16)
    Uuid { bytes: zero }
}

/// Returns `u` as 36 lowercase characters in the `8-4-4-4-12` hyphenated form.
pub fn format(u: Uuid) -> str {
    let hex = text.encode_hex(u.bytes)
    "{hex[0..8]}-{hex[8..12]}-{hex[12..16]}-{hex[16..20]}-{hex[20..32]}"
}

/// Parses the 36-character hyphenated form, accepting upper- and lowercase digits.
/// Fails with `Length` when `s` is not 36 bytes, and with `BadDigit` at the index of the first byte that is not a hexadecimal digit or not a hyphen at index 8, 13, 18 or 23. The version and variant are not checked.
pub fn parse(s: str) -> Uuid ! ParseError {
    if s.len != 36 {
        fail Length
    }
    let decoded: []u8 = __make(16)
    var n = 0
    for i in 0..s.len {
        if i == 8 || i == 13 || i == 18 || i == 23 {
            if s[i] != '-' {
                fail BadDigit(i)
            }
            continue
        }
        let d = text.hex_digit(s[i])
        if d < 0 {
            fail BadDigit(i)
        }
        if n % 2 == 0 {
            decoded[n / 2] = u8(d << 4)
        } else {
            decoded[n / 2] = decoded[n / 2] | u8(d)
        }
        n += 1
    }
    Uuid { bytes: decoded }
}

/// Returns whether `a` and `b` hold the same 16 bytes.
pub fn equal(a: Uuid, b: Uuid) -> bool {
    for i in 0..16 {
        if a.bytes[i] != b.bytes[i] {
            return false
        }
    }
    true
}

/// Returns the creation time of a version 7 UUID as Unix milliseconds, or `none` for any other version.
pub fn timestamp(u: Uuid) -> i64? {
    if version(u) != 7 {
        return none
    }
    var millis = 0
    for i in 0..6 {
        millis = millis << 8 | i64(u.bytes[i])
    }
    millis
}
