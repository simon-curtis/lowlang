import std/crypto
import std/text

pub enum ParseError {
    Length
    BadDigit(at: i64)
}

pub struct Uuid {
    pub bytes: []u8
}

fn stamp(mut b: []u8, version: u8) -> Uuid {
    b[6] = b[6] & 0x0F | version << 4
    b[8] = b[8] & 0x3F | 0x80
    Uuid { bytes: b }
}

pub fn v4() -> Uuid {
    var b = crypto.random(16)
    stamp(mut b, 4)
}

pub fn v7() -> Uuid {
    var b = crypto.random(16)
    let millis = __clock_nanos(0) / 1000000
    for i in 0..6 {
        b[i] = u8(millis >> (8 * (5 - i)) & 0xFF)
    }
    stamp(mut b, 7)
}

pub fn version(u: Uuid) -> i64 {
    i64(u.bytes[6] >> 4)
}

pub fn nil() -> Uuid {
    let zero: []u8 = __make(16)
    Uuid { bytes: zero }
}

pub fn format(u: Uuid) -> str {
    let hex = text.encode_hex(u.bytes)
    "{hex[0..8]}-{hex[8..12]}-{hex[12..16]}-{hex[16..20]}-{hex[20..32]}"
}

pub fn parse(s: str) -> Uuid ! ParseError {
    if s.len != 36 {
        fail Length
    }
    var digits: []u8 = []
    for i in 0..s.len {
        if i == 8 || i == 13 || i == 18 || i == 23 {
            if s[i] != '-' {
                fail BadDigit(i)
            }
            continue
        }
        let c = s[i]
        if !(c >= '0' && c <= '9' || c >= 'a' && c <= 'f' || c >= 'A' && c <= 'F') {
            fail BadDigit(i)
        }
        push(mut digits, c)
    }
    let decoded = text.decode_hex(str(digits)) catch {
        _ => fail Length
    }
    Uuid { bytes: decoded }
}

pub fn equal(a: Uuid, b: Uuid) -> bool {
    for i in 0..16 {
        if a.bytes[i] != b.bytes[i] {
            return false
        }
    }
    true
}

pub fn timestamp(u: Uuid) -> i64? {
    if version(u) != 7 {
        return none
    }
    var millis = 0
    for i in 0..6 {
        millis = millis << 8 | i64(u.bytes[i])
    }
    millis
}
