/// The decryption key schedule and lookup tables derived from an `Aes` key, used to decrypt 16-byte blocks (FIPS 197).
pub struct AesInverse {
    dk: []u32
    rounds: i64
    d0: []u32
    d1: []u32
    d2: []u32
    d3: []u32
    isbox: []u8
}

fn gf_multiply(x: u32, y: u32) -> u32 {
    var product: u32 = 0
    var a = x
    var b = y
    for _ in 0..8 {
        product ^= a & (0 - (b & 1))
        a = xtime(a)
        b >>= 1
    }
    product
}

fn inverse_sbox(sbox: []u8) -> []u8 {
    let inverse: []u8 = __make(256)
    for x in 0..256 {
        inverse[sbox[x]] = u8(x)
    }
    inverse
}

fn mix_inverse_word(d0: []u32, d1: []u32, d2: []u32, d3: []u32, sbox: []u8, w: u32) -> u32 {
    d0[sbox[w >> 24]] ^ d1[sbox[w >> 16 & 0xff]] ^ d2[sbox[w >> 8 & 0xff]] ^ d3[sbox[w & 0xff]]
}

/// Returns the decryption schedule matching the encryption key `a`.
pub fn aes_inverse(a: *Aes) -> *AesInverse {
    let isbox = inverse_sbox(a.sbox)
    let d0: []u32 = __make(256)
    let d1: []u32 = __make(256)
    let d2: []u32 = __make(256)
    let d3: []u32 = __make(256)
    for x in 0..256 {
        let s = u32(isbox[x])
        let w = gf_multiply(s, 14) << 24 | gf_multiply(s, 9) << 16 | gf_multiply(s, 13) << 8 | gf_multiply(s, 11)
        d0[x] = w
        d1[x] = rotr(w, 8)
        d2[x] = rotr(w, 16)
        d3[x] = rotr(w, 24)
    }
    let rounds = a.rounds
    let dk: []u32 = __make(4 * (rounds + 1))
    for i in 0..rounds + 1 {
        for j in 0..4 {
            let w = a.rk[4 * (rounds - i) + j]
            dk[4 * i + j] = if i == 0 || i == rounds { w } else { mix_inverse_word(d0, d1, d2, d3, a.sbox, w) }
        }
    }
    new(AesInverse { dk, rounds, d0, d1, d2, d3, isbox })
}

fn decrypt_words(a: *AesInverse, x0: u32, x1: u32, x2: u32, x3: u32, dst: []u8, at: i64) {
    let dk = a.dk
    let d0 = a.d0
    let d1 = a.d1
    let d2 = a.d2
    let d3 = a.d3
    var s0 = x0 ^ dk[0]
    var s1 = x1 ^ dk[1]
    var s2 = x2 ^ dk[2]
    var s3 = x3 ^ dk[3]
    var k = 4
    for _ in 1..a.rounds {
        let n0 = d0[s0 >> 24] ^ d1[s3 >> 16 & 0xff] ^ d2[s2 >> 8 & 0xff] ^ d3[s1 & 0xff] ^ dk[k]
        let n1 = d0[s1 >> 24] ^ d1[s0 >> 16 & 0xff] ^ d2[s3 >> 8 & 0xff] ^ d3[s2 & 0xff] ^ dk[k + 1]
        let n2 = d0[s2 >> 24] ^ d1[s1 >> 16 & 0xff] ^ d2[s0 >> 8 & 0xff] ^ d3[s3 & 0xff] ^ dk[k + 2]
        let n3 = d0[s3 >> 24] ^ d1[s2 >> 16 & 0xff] ^ d2[s1 >> 8 & 0xff] ^ d3[s0 & 0xff] ^ dk[k + 3]
        s0 = n0
        s1 = n1
        s2 = n2
        s3 = n3
        k += 4
    }
    let sb = a.isbox
    let o0 = u32(sb[s0 >> 24]) << 24 | u32(sb[s3 >> 16 & 0xff]) << 16 | u32(sb[s2 >> 8 & 0xff]) << 8 | u32(sb[s1 & 0xff])
    let o1 = u32(sb[s1 >> 24]) << 24 | u32(sb[s0 >> 16 & 0xff]) << 16 | u32(sb[s3 >> 8 & 0xff]) << 8 | u32(sb[s2 & 0xff])
    let o2 = u32(sb[s2 >> 24]) << 24 | u32(sb[s1 >> 16 & 0xff]) << 16 | u32(sb[s0 >> 8 & 0xff]) << 8 | u32(sb[s3 & 0xff])
    let o3 = u32(sb[s3 >> 24]) << 24 | u32(sb[s2 >> 16 & 0xff]) << 16 | u32(sb[s1 >> 8 & 0xff]) << 8 | u32(sb[s0 & 0xff])
    put_be32(dst, at, o0 ^ dk[k])
    put_be32(dst, at + 4, o1 ^ dk[k + 1])
    put_be32(dst, at + 8, o2 ^ dk[k + 2])
    put_be32(dst, at + 12, o3 ^ dk[k + 3])
}

/// Decrypts the 16-byte block of `src` at offset `from` and writes the 16-byte result into `dst` at offset `to`.
///
/// Applies the raw block cipher with no chaining or padding. `src` and `dst` may be the same slice.
pub fn decrypt_block_into(a: *AesInverse, src: []u8, from: i64, dst: []u8, to: i64) {
    decrypt_words(a, be32(src, from), be32(src, from + 4), be32(src, from + 8), be32(src, from + 12), dst, to)
}

/// Returns the decryption of the 16-byte `block` as a new 16-byte slice, applying the raw block cipher with no chaining or padding.
pub fn decrypt_block(a: *AesInverse, block: []u8) -> []u8 {
    let out: []u8 = __make(16)
    decrypt_block_into(a, block, 0, out, 0)
    out
}
