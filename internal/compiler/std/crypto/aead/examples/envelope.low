import std/crypto/aead
import std/io
import std/text

fn describe(name: str, cipher: aead.Aead, nonce: []u8) ! io.Error {
    let header = bytes("v1;tenant=7")
    let sealed = cipher.seal(nonce, bytes("order 4411 shipped"), header)
    print("{name}: {sealed.len} bytes sealed")
    print("  tag {text.encode_hex(sealed[sealed.len - cipher.tag_size..])}")

    let opened = cipher.open(nonce, sealed, header)?
    print("  opened: {str(opened)}")

    let moved = cipher.open(nonce, sealed, bytes("v1;tenant=8")) or []
    print("  other header: {moved.len} bytes")

    sealed[0] ^= 1
    let damaged = cipher.open(nonce, sealed, header) or []
    print("  flipped bit: {damaged.len} bytes")
}

/// Seals one message under each AEAD with a fixed key and nonce, binds a header as additional data, and shows that a changed header or ciphertext is rejected.
fn main() ! io.Error {
    var key: []u8 = []
    for i in 0..32 {
        push(mut key, u8(0x80 + i))
    }
    let nonce: []u8 = [0x07, 0x00, 0x00, 0x00, 0x40, 0x41, 0x42, 0x43, 0x44, 0x45, 0x46, 0x47]
    var long_nonce: []u8 = []
    for i in 0..24 {
        push(mut long_nonce, u8(0x40 + i))
    }

    describe("aes-256-gcm", aead.aes_gcm(key)?, nonce)?
    describe("chacha20-poly1305", aead.chacha20_poly1305(key)?, nonce)?
    describe("xchacha20-poly1305", aead.xchacha20_poly1305(key)?, long_nonce)?

    let short = aead.aes_gcm(key[..10]) or {
        print("a 10 byte key is rejected")
        return
    }
    print("accepted a {short.key_size} byte key")
}
