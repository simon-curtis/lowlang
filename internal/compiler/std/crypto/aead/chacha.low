import std/io
import std/crypto/hash

struct Poly {
    r0: u64
    r1: u64
    r2: u64
    r3: u64
    r4: u64
    h0: u64
    h1: u64
    h2: u64
    h3: u64
    h4: u64
    pad: []u8
}

fn le32(b: []u8, at: i64) -> u32 {
    u32(b[at]) | u32(b[at + 1]) << 8 | u32(b[at + 2]) << 16 | u32(b[at + 3]) << 24
}

fn put_le32(b: []u8, at: i64, v: u32) {
    b[at] = u8(v)
    b[at + 1] = u8(v >> 8)
    b[at + 2] = u8(v >> 16)
    b[at + 3] = u8(v >> 24)
}

fn quarter(mut a: u32, mut b: u32, mut c: u32, mut d: u32) {
    a += b
    d ^= a
    d = d << 16 | d >> 16
    c += d
    b ^= c
    b = b << 12 | b >> 20
    a += b
    d ^= a
    d = d << 8 | d >> 24
    c += d
    b ^= c
    b = b << 7 | b >> 25
}

fn chacha_words(b: []u8, at: i64, count: i64) -> []u32 {
    let w: []u32 = __make(count)
    for i in 0..count {
        w[i] = le32(b, at + 4 * i)
    }
    w
}

fn chacha_core(k: []u32, counter: u32, n: []u32, out: []u8) {
    let c0: u32 = 0x61707865
    let c1: u32 = 0x3320646e
    let c2: u32 = 0x79622d32
    let c3: u32 = 0x6b206574
    var x0 = c0
    var x1 = c1
    var x2 = c2
    var x3 = c3
    var x4 = k[0]
    var x5 = k[1]
    var x6 = k[2]
    var x7 = k[3]
    var x8 = k[4]
    var x9 = k[5]
    var x10 = k[6]
    var x11 = k[7]
    var x12 = counter
    var x13 = n[0]
    var x14 = n[1]
    var x15 = n[2]
    for _ in 0..10 {
        quarter(mut x0, mut x4, mut x8, mut x12)
        quarter(mut x1, mut x5, mut x9, mut x13)
        quarter(mut x2, mut x6, mut x10, mut x14)
        quarter(mut x3, mut x7, mut x11, mut x15)
        quarter(mut x0, mut x5, mut x10, mut x15)
        quarter(mut x1, mut x6, mut x11, mut x12)
        quarter(mut x2, mut x7, mut x8, mut x13)
        quarter(mut x3, mut x4, mut x9, mut x14)
    }
    put_le32(out, 0, x0 + c0)
    put_le32(out, 4, x1 + c1)
    put_le32(out, 8, x2 + c2)
    put_le32(out, 12, x3 + c3)
    put_le32(out, 16, x4 + k[0])
    put_le32(out, 20, x5 + k[1])
    put_le32(out, 24, x6 + k[2])
    put_le32(out, 28, x7 + k[3])
    put_le32(out, 32, x8 + k[4])
    put_le32(out, 36, x9 + k[5])
    put_le32(out, 40, x10 + k[6])
    put_le32(out, 44, x11 + k[7])
    put_le32(out, 48, x12 + counter)
    put_le32(out, 52, x13 + n[0])
    put_le32(out, 56, x14 + n[1])
    put_le32(out, 60, x15 + n[2])
}

pub fn chacha20_block(key: []u8, counter: u32, nonce: []u8) -> []u8 {
    let out: []u8 = __make(64)
    let k = chacha_words(key, 0, 8)
    let n = chacha_words(nonce, 0, 3)
    chacha_core(k, counter, n, out)
    out
}

fn chacha_xor(k: []u32, first: u32, n: []u32, src: []u8, dst: []u8) {
    let stream: []u8 = __make(64)
    var counter = first
    var at = 0
    for at < src.len {
        chacha_core(k, counter, n, stream)
        let m = if src.len - at < 64 { src.len - at } else { 64 }
        for i in 0..m {
            dst[at + i] = src[at + i] ^ stream[i]
        }
        counter += 1
        at += 64
    }
}

fn poly(key: []u8) -> *Poly {
    let pad: []u8 = __make(16)
    __memmove(pad, key[16..32])
    new(Poly {
        r0: u64(le32(key, 0)) & 0x3ffffff
        r1: u64(le32(key, 3)) >> 2 & 0x3ffff03
        r2: u64(le32(key, 6)) >> 4 & 0x3ffc0ff
        r3: u64(le32(key, 9)) >> 6 & 0x3f03fff
        r4: u64(le32(key, 12)) >> 8 & 0x00fffff
        h0: 0
        h1: 0
        h2: 0
        h3: 0
        h4: 0
        pad
    })
}

fn poly_blocks(p: *Poly, m: []u8, hibit: u64) {
    let mask: u64 = 0x3ffffff
    let r0 = p.r0
    let r1 = p.r1
    let r2 = p.r2
    let r3 = p.r3
    let r4 = p.r4
    let s1 = r1 * 5
    let s2 = r2 * 5
    let s3 = r3 * 5
    let s4 = r4 * 5
    var h0 = p.h0
    var h1 = p.h1
    var h2 = p.h2
    var h3 = p.h3
    var h4 = p.h4
    var at = 0
    for at + 16 <= m.len {
        h0 += u64(le32(m, at)) & mask
        h1 += u64(le32(m, at + 3)) >> 2 & mask
        h2 += u64(le32(m, at + 6)) >> 4 & mask
        h3 += u64(le32(m, at + 9)) >> 6 & mask
        h4 += u64(le32(m, at + 12)) >> 8 | hibit
        let d0 = h0 * r0 + h1 * s4 + h2 * s3 + h3 * s2 + h4 * s1
        var d1 = h0 * r1 + h1 * r0 + h2 * s4 + h3 * s3 + h4 * s2
        var d2 = h0 * r2 + h1 * r1 + h2 * r0 + h3 * s4 + h4 * s3
        var d3 = h0 * r3 + h1 * r2 + h2 * r1 + h3 * r0 + h4 * s4
        var d4 = h0 * r4 + h1 * r3 + h2 * r2 + h3 * r1 + h4 * r0
        h0 = d0 & mask
        d1 += d0 >> 26
        h1 = d1 & mask
        d2 += d1 >> 26
        h2 = d2 & mask
        d3 += d2 >> 26
        h3 = d3 & mask
        d4 += d3 >> 26
        h4 = d4 & mask
        h0 += (d4 >> 26) * 5
        h1 += h0 >> 26
        h0 &= mask
        at += 16
    }
    p.h0 = h0
    p.h1 = h1
    p.h2 = h2
    p.h3 = h3
    p.h4 = h4
}

fn poly_padded(p: *Poly, data: []u8) {
    let full = data.len - data.len % 16
    poly_blocks(p, data[..full], 1 << 24)
    if full < data.len {
        let last: []u8 = __make(16)
        __memmove(last, data[full..])
        poly_blocks(p, last, 1 << 24)
    }
}

fn poly_finish(p: *Poly) -> []u8 {
    let mask: u64 = 0x3ffffff
    var h0 = p.h0
    var h1 = p.h1
    var h2 = p.h2
    var h3 = p.h3
    var h4 = p.h4
    h2 += h1 >> 26
    h1 &= mask
    h3 += h2 >> 26
    h2 &= mask
    h4 += h3 >> 26
    h3 &= mask
    h0 += (h4 >> 26) * 5
    h4 &= mask
    h1 += h0 >> 26
    h0 &= mask
    var g0 = h0 + 5
    var g1 = h1 + (g0 >> 26)
    g0 &= mask
    var g2 = h2 + (g1 >> 26)
    g1 &= mask
    var g3 = h3 + (g2 >> 26)
    g2 &= mask
    var g4 = h4 + (g3 >> 26) - (1 << 26)
    g3 &= mask
    let keep = 0 - (g4 >> 63)
    let take = ~keep
    h0 = h0 & keep | g0 & take
    h1 = h1 & keep | g1 & take
    h2 = h2 & keep | g2 & take
    h3 = h3 & keep | g3 & take
    h4 = h4 & keep | g4 & take
    let pad = p.pad
    let w0 = (h0 | h1 << 26) & 0xffffffff
    let w1 = (h1 >> 6 | h2 << 20) & 0xffffffff
    let w2 = (h2 >> 12 | h3 << 14) & 0xffffffff
    let w3 = (h3 >> 18 | h4 << 8) & 0xffffffff
    let out: []u8 = __make(16)
    let f0 = w0 + u64(le32(pad, 0))
    let f1 = w1 + u64(le32(pad, 4)) + (f0 >> 32)
    let f2 = w2 + u64(le32(pad, 8)) + (f1 >> 32)
    let f3 = w3 + u64(le32(pad, 12)) + (f2 >> 32)
    put_le32(out, 0, u32(f0))
    put_le32(out, 4, u32(f1))
    put_le32(out, 8, u32(f2))
    put_le32(out, 12, u32(f3))
    out
}

pub fn poly1305(key: []u8, message: []u8) -> []u8 ! io.Error {
    if key.len != 32 {
        fail io.Error.Invalid
    }
    let p = poly(key)
    let full = message.len - message.len % 16
    poly_blocks(p, message[..full], 1 << 24)
    if full < message.len {
        let last: []u8 = __make(16)
        let n = __memmove(last, message[full..])
        last[n] = 1
        poly_blocks(p, last, 0)
    }
    poly_finish(p)
}

fn chacha_tag(k: []u32, n: []u32, ciphertext: []u8, aad: []u8) -> []u8 {
    let block: []u8 = __make(64)
    chacha_core(k, 0, n, block)
    let p = poly(block[..32])
    poly_padded(p, aad)
    poly_padded(p, ciphertext)
    let lengths: []u8 = __make(16)
    put_le32(lengths, 0, u32(aad.len))
    put_le32(lengths, 4, u32(aad.len >> 32))
    put_le32(lengths, 8, u32(ciphertext.len))
    put_le32(lengths, 12, u32(ciphertext.len >> 32))
    poly_blocks(p, lengths, 1 << 24)
    poly_finish(p)
}

fn chacha_seal(k: []u32, nonce: []u8, plaintext: []u8, aad: []u8) -> []u8 {
    let n = chacha_words(nonce, 0, 3)
    let out: []u8 = __make(plaintext.len + 16)
    let body = out[..plaintext.len]
    chacha_xor(k, 1, n, plaintext, body)
    let tag = chacha_tag(k, n, body, aad)
    __memmove(out[plaintext.len..], tag)
    out
}

fn chacha_open(k: []u32, nonce: []u8, sealed: []u8, aad: []u8) -> []u8 ! io.Error {
    if nonce.len != 12 || sealed.len < 16 {
        fail io.Error.Invalid
    }
    let n = chacha_words(nonce, 0, 3)
    let size = sealed.len - 16
    let body = sealed[..size]
    let expected = chacha_tag(k, n, body, aad)
    if !hash.equal(expected, sealed[size..]) {
        fail io.Error.Invalid
    }
    let out: []u8 = __make(size)
    chacha_xor(k, 1, n, body, out)
    out
}

pub fn chacha20_poly1305(key: []u8) -> Aead ! io.Error {
    if key.len != 32 {
        fail io.Error.Invalid
    }
    let k = chacha_words(key, 0, 8)
    Aead {
        key_size: 32
        nonce_size: 12
        tag_size: 16
        seal: fn(nonce, plaintext, aad) { chacha_seal(k, nonce, plaintext, aad) }
        open: fn(nonce, sealed, aad) { chacha_open(k, nonce, sealed, aad) }
    }
}

pub fn chacha20_xor(key: []u8, counter: u32, nonce: []u8, data: []u8) -> []u8 ! io.Error {
    if key.len != 32 || nonce.len != 12 {
        fail io.Error.Invalid
    }
    let out: []u8 = __make(data.len)
    chacha_xor(chacha_words(key, 0, 8), counter, chacha_words(nonce, 0, 3), data, out)
    out
}

fn hchacha_core(k: []u32, n: []u32) -> []u8 {
    var x0: u32 = 0x61707865
    var x1: u32 = 0x3320646e
    var x2: u32 = 0x79622d32
    var x3: u32 = 0x6b206574
    var x4 = k[0]
    var x5 = k[1]
    var x6 = k[2]
    var x7 = k[3]
    var x8 = k[4]
    var x9 = k[5]
    var x10 = k[6]
    var x11 = k[7]
    var x12 = n[0]
    var x13 = n[1]
    var x14 = n[2]
    var x15 = n[3]
    for _ in 0..10 {
        quarter(mut x0, mut x4, mut x8, mut x12)
        quarter(mut x1, mut x5, mut x9, mut x13)
        quarter(mut x2, mut x6, mut x10, mut x14)
        quarter(mut x3, mut x7, mut x11, mut x15)
        quarter(mut x0, mut x5, mut x10, mut x15)
        quarter(mut x1, mut x6, mut x11, mut x12)
        quarter(mut x2, mut x7, mut x8, mut x13)
        quarter(mut x3, mut x4, mut x9, mut x14)
    }
    let out: []u8 = __make(32)
    put_le32(out, 0, x0)
    put_le32(out, 4, x1)
    put_le32(out, 8, x2)
    put_le32(out, 12, x3)
    put_le32(out, 16, x12)
    put_le32(out, 20, x13)
    put_le32(out, 24, x14)
    put_le32(out, 28, x15)
    out
}

pub fn hchacha20(key: []u8, nonce: []u8) -> []u8 ! io.Error {
    if key.len != 32 || nonce.len != 16 {
        fail io.Error.Invalid
    }
    hchacha_core(chacha_words(key, 0, 8), chacha_words(nonce, 0, 4))
}

fn xchacha_subkey(k: []u32, nonce: []u8) -> []u32 {
    chacha_words(hchacha_core(k, chacha_words(nonce, 0, 4)), 0, 8)
}

fn xchacha_tail(nonce: []u8) -> []u8 {
    let tail: []u8 = __make(12)
    __memmove(tail[4..], nonce[16..24])
    tail
}

fn xchacha_seal(k: []u32, nonce: []u8, plaintext: []u8, aad: []u8) -> []u8 {
    chacha_seal(xchacha_subkey(k, nonce), xchacha_tail(nonce), plaintext, aad)
}

fn xchacha_open(k: []u32, nonce: []u8, sealed: []u8, aad: []u8) -> []u8 ! io.Error {
    if nonce.len != 24 {
        fail io.Error.Invalid
    }
    chacha_open(xchacha_subkey(k, nonce), xchacha_tail(nonce), sealed, aad)?
}

pub fn xchacha20_poly1305(key: []u8) -> Aead ! io.Error {
    if key.len != 32 {
        fail io.Error.Invalid
    }
    let k = chacha_words(key, 0, 8)
    Aead {
        key_size: 32
        nonce_size: 24
        tag_size: 16
        seal: fn(nonce, plaintext, aad) { xchacha_seal(k, nonce, plaintext, aad) }
        open: fn(nonce, sealed, aad) { xchacha_open(k, nonce, sealed, aad) }
    }
}
