import std/io

/// An expanded AES encryption key with the lookup tables used to encrypt 16-byte blocks (FIPS 197).
pub struct Aes {
    rk: []u32
    rounds: i64
    t0: []u32
    t1: []u32
    t2: []u32
    t3: []u32
    sbox: []u8
}

fn forward_sbox() -> []u8 {
    [
        0x63, 0x7c, 0x77, 0x7b, 0xf2, 0x6b, 0x6f, 0xc5, 0x30, 0x01, 0x67, 0x2b, 0xfe, 0xd7, 0xab, 0x76,
        0xca, 0x82, 0xc9, 0x7d, 0xfa, 0x59, 0x47, 0xf0, 0xad, 0xd4, 0xa2, 0xaf, 0x9c, 0xa4, 0x72, 0xc0,
        0xb7, 0xfd, 0x93, 0x26, 0x36, 0x3f, 0xf7, 0xcc, 0x34, 0xa5, 0xe5, 0xf1, 0x71, 0xd8, 0x31, 0x15,
        0x04, 0xc7, 0x23, 0xc3, 0x18, 0x96, 0x05, 0x9a, 0x07, 0x12, 0x80, 0xe2, 0xeb, 0x27, 0xb2, 0x75,
        0x09, 0x83, 0x2c, 0x1a, 0x1b, 0x6e, 0x5a, 0xa0, 0x52, 0x3b, 0xd6, 0xb3, 0x29, 0xe3, 0x2f, 0x84,
        0x53, 0xd1, 0x00, 0xed, 0x20, 0xfc, 0xb1, 0x5b, 0x6a, 0xcb, 0xbe, 0x39, 0x4a, 0x4c, 0x58, 0xcf,
        0xd0, 0xef, 0xaa, 0xfb, 0x43, 0x4d, 0x33, 0x85, 0x45, 0xf9, 0x02, 0x7f, 0x50, 0x3c, 0x9f, 0xa8,
        0x51, 0xa3, 0x40, 0x8f, 0x92, 0x9d, 0x38, 0xf5, 0xbc, 0xb6, 0xda, 0x21, 0x10, 0xff, 0xf3, 0xd2,
        0xcd, 0x0c, 0x13, 0xec, 0x5f, 0x97, 0x44, 0x17, 0xc4, 0xa7, 0x7e, 0x3d, 0x64, 0x5d, 0x19, 0x73,
        0x60, 0x81, 0x4f, 0xdc, 0x22, 0x2a, 0x90, 0x88, 0x46, 0xee, 0xb8, 0x14, 0xde, 0x5e, 0x0b, 0xdb,
        0xe0, 0x32, 0x3a, 0x0a, 0x49, 0x06, 0x24, 0x5c, 0xc2, 0xd3, 0xac, 0x62, 0x91, 0x95, 0xe4, 0x79,
        0xe7, 0xc8, 0x37, 0x6d, 0x8d, 0xd5, 0x4e, 0xa9, 0x6c, 0x56, 0xf4, 0xea, 0x65, 0x7a, 0xae, 0x08,
        0xba, 0x78, 0x25, 0x2e, 0x1c, 0xa6, 0xb4, 0xc6, 0xe8, 0xdd, 0x74, 0x1f, 0x4b, 0xbd, 0x8b, 0x8a,
        0x70, 0x3e, 0xb5, 0x66, 0x48, 0x03, 0xf6, 0x0e, 0x61, 0x35, 0x57, 0xb9, 0x86, 0xc1, 0x1d, 0x9e,
        0xe1, 0xf8, 0x98, 0x11, 0x69, 0xd9, 0x8e, 0x94, 0x9b, 0x1e, 0x87, 0xe9, 0xce, 0x55, 0x28, 0xdf,
        0x8c, 0xa1, 0x89, 0x0d, 0xbf, 0xe6, 0x42, 0x68, 0x41, 0x99, 0x2d, 0x0f, 0xb0, 0x54, 0xbb, 0x16,
    ]
}

fn xtime(x: u32) -> u32 {
    (x << 1 ^ 0x1b & (0 - (x >> 7 & 1))) & 0xff
}

fn rotr(x: u32, n: i64) -> u32 {
    x >> n | x << (32 - n)
}

fn sub_word(sbox: []u8, w: u32) -> u32 {
    u32(sbox[w >> 24]) << 24 | u32(sbox[w >> 16 & 0xff]) << 16 | u32(sbox[w >> 8 & 0xff]) << 8 | u32(sbox[w & 0xff])
}

fn be32(b: []u8, at: i64) -> u32 {
    u32(b[at]) << 24 | u32(b[at + 1]) << 16 | u32(b[at + 2]) << 8 | u32(b[at + 3])
}

fn put_be32(b: []u8, at: i64, v: u32) {
    b[at] = u8(v >> 24)
    b[at + 1] = u8(v >> 16)
    b[at + 2] = u8(v >> 8)
    b[at + 3] = u8(v)
}

/// Builds an AES encryption key from `key`.
///
/// `key` is 16 bytes (AES-128) or 32 bytes (AES-256). Fails with `io.Error.Invalid` for any other length, including 24; `aes_key` accepts 24.
pub fn aes(key: []u8) -> *Aes ! io.Error {
    if key.len == 24 {
        fail io.Error.Invalid
    }
    aes_key(key)
}

/// Builds an AES encryption key from `key`.
///
/// `key` is 16, 24 or 32 bytes (AES-128, AES-192 or AES-256). Fails with `io.Error.Invalid` for any other length.
pub fn aes_key(key: []u8) -> *Aes ! io.Error {
    if key.len != 16 && key.len != 24 && key.len != 32 {
        fail io.Error.Invalid
    }
    let sbox = forward_sbox()
    let t0: []u32 = __make(256)
    let t1: []u32 = __make(256)
    let t2: []u32 = __make(256)
    let t3: []u32 = __make(256)
    for x in 0..256 {
        let s = u32(sbox[x])
        let s2 = xtime(s)
        let w = s2 << 24 | s << 16 | s << 8 | (s2 ^ s)
        t0[x] = w
        t1[x] = rotr(w, 8)
        t2[x] = rotr(w, 16)
        t3[x] = rotr(w, 24)
    }
    let nk = key.len / 4
    let rounds = nk + 6
    let total = 4 * (rounds + 1)
    let rk: []u32 = __make(total)
    for i in 0..nk {
        rk[i] = be32(key, 4 * i)
    }
    var rcon: u32 = 1
    for i in nk..total {
        var temp = rk[i - 1]
        if i % nk == 0 {
            temp = sub_word(sbox, rotr(temp, 24)) ^ rcon << 24
            rcon = xtime(rcon)
        } else if nk > 6 && i % nk == 4 {
            temp = sub_word(sbox, temp)
        }
        rk[i] = rk[i - nk] ^ temp
    }
    new(Aes { rk, rounds, t0, t1, t2, t3, sbox })
}

fn encrypt_words(a: *Aes, x0: u32, x1: u32, x2: u32, x3: u32, dst: []u8, at: i64) {
    let rk = a.rk
    let t0 = a.t0
    let t1 = a.t1
    let t2 = a.t2
    let t3 = a.t3
    var s0 = x0 ^ rk[0]
    var s1 = x1 ^ rk[1]
    var s2 = x2 ^ rk[2]
    var s3 = x3 ^ rk[3]
    var k = 4
    for _ in 1..a.rounds {
        let n0 = t0[s0 >> 24] ^ t1[s1 >> 16 & 0xff] ^ t2[s2 >> 8 & 0xff] ^ t3[s3 & 0xff] ^ rk[k]
        let n1 = t0[s1 >> 24] ^ t1[s2 >> 16 & 0xff] ^ t2[s3 >> 8 & 0xff] ^ t3[s0 & 0xff] ^ rk[k + 1]
        let n2 = t0[s2 >> 24] ^ t1[s3 >> 16 & 0xff] ^ t2[s0 >> 8 & 0xff] ^ t3[s1 & 0xff] ^ rk[k + 2]
        let n3 = t0[s3 >> 24] ^ t1[s0 >> 16 & 0xff] ^ t2[s1 >> 8 & 0xff] ^ t3[s2 & 0xff] ^ rk[k + 3]
        s0 = n0
        s1 = n1
        s2 = n2
        s3 = n3
        k += 4
    }
    let sb = a.sbox
    let o0 = u32(sb[s0 >> 24]) << 24 | u32(sb[s1 >> 16 & 0xff]) << 16 | u32(sb[s2 >> 8 & 0xff]) << 8 | u32(sb[s3 & 0xff])
    let o1 = u32(sb[s1 >> 24]) << 24 | u32(sb[s2 >> 16 & 0xff]) << 16 | u32(sb[s3 >> 8 & 0xff]) << 8 | u32(sb[s0 & 0xff])
    let o2 = u32(sb[s2 >> 24]) << 24 | u32(sb[s3 >> 16 & 0xff]) << 16 | u32(sb[s0 >> 8 & 0xff]) << 8 | u32(sb[s1 & 0xff])
    let o3 = u32(sb[s3 >> 24]) << 24 | u32(sb[s0 >> 16 & 0xff]) << 16 | u32(sb[s1 >> 8 & 0xff]) << 8 | u32(sb[s2 & 0xff])
    put_be32(dst, at, o0 ^ rk[k])
    put_be32(dst, at + 4, o1 ^ rk[k + 1])
    put_be32(dst, at + 8, o2 ^ rk[k + 2])
    put_be32(dst, at + 12, o3 ^ rk[k + 3])
}

/// Encrypts the 16-byte block of `src` at offset `from` and writes the 16-byte result into `dst` at offset `to`.
///
/// Applies the raw block cipher with no chaining or padding. `src` and `dst` may be the same slice.
pub fn encrypt_block_into(a: *Aes, src: []u8, from: i64, dst: []u8, to: i64) {
    encrypt_words(a, be32(src, from), be32(src, from + 4), be32(src, from + 8), be32(src, from + 12), dst, to)
}

/// Returns the encryption of the 16-byte `block` as a new 16-byte slice, applying the raw block cipher with no chaining or padding.
pub fn encrypt_block(a: *Aes, block: []u8) -> []u8 {
    let out: []u8 = __make(16)
    encrypt_words(a, be32(block, 0), be32(block, 4), be32(block, 8), be32(block, 12), out, 0)
    out
}
