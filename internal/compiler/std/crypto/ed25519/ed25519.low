import std/crypto
import std/crypto/hash
import field = std/crypto/curve25519

struct Expanded {
    scalar: []u8
    prefix: []u8
}

fn expand(seed: []u8) -> Expanded {
    let sha512 = hash.sha512()
    let h = hash.sum(sha512, seed)
    let scalar = field.clamp(h)
    Expanded { scalar, prefix: h[32..] }
}

fn challenge(r: []u8, public: []u8, message: []u8) -> []u8 {
    let d = hash.sha512().digest()
    d.update(r)
    d.update(public)
    d.update(message)
    let digest = d.finish()
    reduce(digest)
}

/// Returns a new 32-byte Ed25519 seed, the private key, from `random` in `std/crypto`.
pub fn generate() -> []u8 {
    crypto.random(32)
}

/// Returns the 32-byte Ed25519 public key for the 32-byte `seed` (RFC 8032).
///
/// The length of `seed` is not validated.
pub fn public_key(seed: []u8) -> []u8 {
    let e = expand(seed)
    let b = base()
    let table = multiples(b)
    let a = multiply(table, e.scalar)
    encode(a)
}

/// Returns the 64-byte Ed25519 signature of `message` under the 32-byte `seed` (RFC 8032 section 5.1).
///
/// The signature is the 32-byte encoded point `R` followed by the 32-byte scalar `S`. Signing is deterministic: the same `seed` and `message` give the same signature. The length of `seed` is not validated.
pub fn sign(seed: []u8, message: []u8) -> []u8 {
    let e = expand(seed)
    let b = base()
    let table = multiples(b)
    let a = multiply(table, e.scalar)
    let public = encode(a)
    let d = hash.sha512().digest()
    d.update(e.prefix)
    d.update(message)
    let nonce_digest = d.finish()
    let nonce = reduce(nonce_digest)
    let r_point = multiply(table, nonce)
    let r = encode(r_point)
    let k = challenge(r, public, message)
    let s = mul_add(k, e.scalar, nonce)
    let out: []u8 = __make(64)
    __memmove(out, r)
    __memmove(out[32..], s)
    out
}

/// Returns whether `signature` is a valid Ed25519 signature of `message` under the 32-byte `public` key (RFC 8032 section 5.1.7).
///
/// Returns `false` when `signature` is not 64 bytes, `S` is not below the group order, or `public` does not decode to a curve point. Otherwise it compares the encoding of `[S]B - [k]A` with `R`.
pub fn verify(public: []u8, message: []u8, signature: []u8) -> bool {
    if signature.len != 64 {
        return false
    }
    let r = signature[..32]
    let s = signature[32..]
    if !canonical(s) {
        return false
    }
    let a = match decode(public) {
        some(p) => p
        none => return false
    }
    let k = challenge(r, public, message)
    let b = base()
    let base_table = multiples(b)
    let sb = multiply(base_table, s)
    let minus_a = negate(a)
    let a_table = multiples(minus_a)
    let ka = multiply(a_table, k)
    let ka_cached = cached(ka)
    let check = add_cached(sb, ka_cached)
    let encoded = encode(check)
    hash.equal(encoded, r)
}
