import std/crypto/hash
import field = std/crypto/curve25519

struct Point {
    x: field.Fe
    y: field.Fe
    z: field.Fe
    t: field.Fe
}

struct Cached {
    sum: field.Fe
    diff: field.Fe
    z2: field.Fe
    t2d: field.Fe
}

fn curve_d() -> field.Fe {
    field.limbs(929955233495203, 466365720129213, 1662059464998953, 2033849074728123, 1442794654840575)
}

fn curve_d2() -> field.Fe {
    field.limbs(1859910466990425, 932731440258426, 1072319116312658, 1815898335770999, 633789495995903)
}

fn sqrt_minus_one() -> field.Fe {
    field.limbs(1718705420411056, 234908883556509, 2233514472574048, 2117202627021982, 765476049583133)
}

fn base() -> Point {
    Point {
        x: field.limbs(1738742601995546, 1146398526822698, 2070867633025821, 562264141797630, 587772402128613)
        y: field.limbs(1801439850948184, 1351079888211148, 450359962737049, 900719925474099, 1801439850948198)
        z: field.one()
        t: field.limbs(1841354044333475, 16398895984059, 755974180946558, 900171276175154, 1821297809914039)
    }
}

fn identity() -> Point {
    Point { x: field.zero(), y: field.one(), z: field.one(), t: field.zero() }
}

fn negate(p: Point) -> Point {
    Point { x: field.neg(p.x), y: p.y, z: p.z, t: field.neg(p.t) }
}

fn cached(p: Point) -> Cached {
    Cached {
        sum: field.add(p.y, p.x)
        diff: field.sub(p.y, p.x)
        z2: field.add(p.z, p.z)
        t2d: field.mul(p.t, curve_d2())
    }
}

fn add_cached(p: Point, q: Cached) -> Point {
    let diff = field.sub(p.y, p.x)
    let sum = field.add(p.y, p.x)
    let a = field.mul(diff, q.diff)
    let b = field.mul(sum, q.sum)
    let c = field.mul(p.t, q.t2d)
    let d = field.mul(p.z, q.z2)
    let e = field.sub(b, a)
    let f = field.sub(d, c)
    let g = field.add(d, c)
    let h = field.add(b, a)
    Point { x: field.mul(e, f), y: field.mul(g, h), z: field.mul(f, g), t: field.mul(e, h) }
}

fn double(p: Point) -> Point {
    let a = field.square(p.x)
    let b = field.square(p.y)
    let zz = field.square(p.z)
    let c = field.add(zz, zz)
    let h = field.add(a, b)
    let xy = field.add(p.x, p.y)
    let xy2 = field.square(xy)
    let e = field.sub(h, xy2)
    let g = field.sub(a, b)
    let f = field.add(c, g)
    Point { x: field.mul(e, f), y: field.mul(g, h), z: field.mul(f, g), t: field.mul(e, h) }
}

fn multiples(p: Point) -> []Cached {
    let step = cached(p)
    var table: []Cached = []
    var acc = identity()
    for _ in 0..16 {
        push(mut table, cached(acc))
        acc = add_cached(acc, step)
    }
    table
}

fn choose_cached(a: Cached, b: Cached, choice: u64) -> Cached {
    Cached {
        sum: field.choose(a.sum, b.sum, choice)
        diff: field.choose(a.diff, b.diff, choice)
        z2: field.choose(a.z2, b.z2, choice)
        t2d: field.choose(a.t2d, b.t2d, choice)
    }
}

fn lookup(table: []Cached, digit: u64) -> Cached {
    var out = table[0]
    for i in 1..16 {
        let x = u64(i) ^ digit
        let hit = ((x | (0 - x)) >> 63) ^ 1
        out = choose_cached(out, table[i], hit)
    }
    out
}

fn multiply(table: []Cached, scalar: []u8) -> Point {
    var q = identity()
    var i = 63
    for i >= 0 {
        for _ in 0..4 {
            q = double(q)
        }
        let digit = u64(scalar[i >> 1] >> u8(4 * (i & 1))) & 15
        let entry = lookup(table, digit)
        q = add_cached(q, entry)
        i -= 1
    }
    q
}

fn encode(p: Point) -> []u8 {
    let inverse = field.invert(p.z)
    let x = field.mul(p.x, inverse)
    let y = field.mul(p.y, inverse)
    let out = field.to_bytes(y)
    out[31] |= u8(field.is_negative(x) << 7)
    out
}

fn decode(b: []u8) -> Point? {
    if b.len != 32 {
        return none
    }
    let encoded: []u8 = __make(32)
    __memmove(encoded, b)
    let sign = u64(encoded[31] >> 7)
    encoded[31] &= 127
    let y = field.from_bytes(encoded)
    let canonical = field.to_bytes(y)
    if !hash.equal(canonical, encoded) {
        return none
    }
    let yy = field.square(y)
    let u = field.sub(yy, field.one())
    let d = curve_d()
    let dyy = field.mul(d, yy)
    let v = field.add(dyy, field.one())
    let v2 = field.square(v)
    let v3 = field.mul(v2, v)
    let v6 = field.square(v3)
    let v7 = field.mul(v6, v)
    let uv3 = field.mul(u, v3)
    let uv7 = field.mul(u, v7)
    let root = field.pow_p58(uv7)
    var x = field.mul(uv3, root)
    let xx = field.square(x)
    let vxx = field.mul(v, xx)
    if !field.equal(vxx, u) {
        let minus_u = field.neg(u)
        if !field.equal(vxx, minus_u) {
            return none
        }
        x = field.mul(x, sqrt_minus_one())
    }
    if sign == 1 && field.equal(x, field.zero()) {
        return none
    }
    if field.is_negative(x) != sign {
        x = field.neg(x)
    }
    Point { x, y, z: field.one(), t: field.mul(x, y) }
}
