fn order() -> []u64 {
    [0x5812631a5cf5d3ed, 0x14def9dea2f79cd6, 0, 0x1000000000000000]
}

fn carry_out(a: u64, b: u64, sum: u64) -> u64 {
    (a & b | (a | b) & ~sum) >> 63
}

fn borrow_out(a: u64, b: u64, diff: u64) -> u64 {
    (~a & b | ~(a ^ b) & diff) >> 63
}

fn words(b: []u8) -> []u64 {
    let out: []u64 = __make(b.len / 8)
    for i in 0..out.len {
        var w: u64 = 0
        for j in 0..8 {
            w |= u64(b[8 * i + j]) << (8 * j)
        }
        out[i] = w
    }
    out
}

fn scalar_bytes(w: []u64) -> []u8 {
    let out: []u8 = __make(32)
    for i in 0..32 {
        out[i] = u8(w[i >> 3] >> (8 * (i & 7)))
    }
    out
}

fn reduce_words(wide: []u64) -> []u8 {
    let l = order()
    let r: []u64 = __make(4)
    let t: []u64 = __make(4)
    var i = wide.len * 64 - 1
    for i >= 0 {
        let bit = wide[i >> 6] >> (i & 63) & 1
        r[3] = r[3] << 1 | r[2] >> 63
        r[2] = r[2] << 1 | r[1] >> 63
        r[1] = r[1] << 1 | r[0] >> 63
        r[0] = r[0] << 1 | bit
        var borrow: u64 = 0
        for j in 0..4 {
            let d = r[j] - l[j] - borrow
            borrow = borrow_out(r[j], l[j], d)
            t[j] = d
        }
        let keep = 0 - borrow
        for j in 0..4 {
            r[j] = r[j] & keep | t[j] & ~keep
        }
        i -= 1
    }
    scalar_bytes(r)
}

fn reduce(digest: []u8) -> []u8 {
    let wide = words(digest)
    reduce_words(wide)
}

fn mul_add(a: []u8, b: []u8, c: []u8) -> []u8 {
    let x = words(a)
    let y = words(b)
    let w: []u64 = __make(8)
    let addend = words(c)
    __memmove(w, addend)
    for i in 0..4 {
        var carry: u64 = 0
        for j in 0..4 {
            let lo = x[i] * y[j]
            let hi = __mulhi(x[i], y[j])
            let s1 = lo + w[i + j]
            let c1 = carry_out(lo, w[i + j], s1)
            let s2 = s1 + carry
            let c2 = carry_out(s1, carry, s2)
            w[i + j] = s2
            carry = hi + c1 + c2
        }
        w[i + 4] = carry
    }
    reduce_words(w)
}

fn canonical(s: []u8) -> bool {
    let l = order()
    let w = words(s)
    var i = 3
    for i >= 0 {
        if w[i] != l[i] {
            return w[i] < l[i]
        }
        i -= 1
    }
    false
}
