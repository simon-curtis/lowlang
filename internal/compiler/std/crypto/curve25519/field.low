import std/crypto/hash

/// An element of the prime field GF(2^255 - 19) in five 51-bit limbs, least significant limb first.
///
/// Operations return limbs below 2^52 and the type has no canonical form until `to_bytes`, so compare values with `equal` rather than field by field.
pub struct Fe {
    l0: u64
    l1: u64
    l2: u64
    l3: u64
    l4: u64
}

struct Split {
    low: u64
    high: u64
}

fn mask51() -> u64 {
    0x7FFFFFFFFFFFF
}

/// Returns the element whose limbs are `l0` (least significant) to `l4`.
///
/// The limbs are used as given and are not reduced.
pub fn limbs(l0: u64, l1: u64, l2: u64, l3: u64, l4: u64) -> Fe {
    Fe { l0, l1, l2, l3, l4 }
}

/// Returns the element `0`.
pub fn zero() -> Fe {
    Fe { l0: 0, l1: 0, l2: 0, l3: 0, l4: 0 }
}

/// Returns the element `1`.
pub fn one() -> Fe {
    Fe { l0: 1, l1: 0, l2: 0, l3: 0, l4: 0 }
}

fn le_word(b: []u8, at: i64) -> u64 {
    var w: u64 = 0
    for i in 0..8 {
        w |= u64(b[at + i]) << (8 * i)
    }
    w
}

fn put_le_word(out: []u8, at: i64, w: u64) {
    for i in 0..8 {
        out[at + i] = u8(w >> (8 * i))
    }
}

/// Decodes 32 little-endian bytes into an element.
///
/// Bit 255 is ignored, so the top bit of the last byte never contributes. A value in `[2^255 - 19, 2^255)` is accepted and reduces modulo `2^255 - 19`. The slice must hold at least 32 bytes.
pub fn from_bytes(b: []u8) -> Fe {
    let m = mask51()
    let w0 = le_word(b, 0)
    let w1 = le_word(b, 8)
    let w2 = le_word(b, 16)
    let w3 = le_word(b, 24)
    Fe {
        l0: w0 & m
        l1: (w0 >> 51 | w1 << 13) & m
        l2: (w1 >> 38 | w2 << 26) & m
        l3: (w2 >> 25 | w3 << 39) & m
        l4: w3 >> 12 & m
    }
}

/// Encodes the element as 32 little-endian bytes in canonical form, fully reduced below `2^255 - 19`.
pub fn to_bytes(f: Fe) -> []u8 {
    let m = mask51()
    var q = (f.l0 + 19) >> 51
    q = (f.l1 + q) >> 51
    q = (f.l2 + q) >> 51
    q = (f.l3 + q) >> 51
    q = (f.l4 + q) >> 51
    var h0 = f.l0 + 19 * q
    var h1 = f.l1 + (h0 >> 51)
    h0 &= m
    var h2 = f.l2 + (h1 >> 51)
    h1 &= m
    var h3 = f.l3 + (h2 >> 51)
    h2 &= m
    var h4 = f.l4 + (h3 >> 51)
    h3 &= m
    h4 &= m
    let out: []u8 = __make(32)
    put_le_word(out, 0, h0 | h1 << 51)
    put_le_word(out, 8, h1 >> 13 | h2 << 38)
    put_le_word(out, 16, h2 >> 26 | h3 << 25)
    put_le_word(out, 24, h3 >> 39 | h4 << 12)
    out
}

fn carry(t0: u64, t1: u64, t2: u64, t3: u64, t4: u64) -> Fe {
    let m = mask51()
    var c1 = t1 + (t0 >> 51)
    let c2 = t2 + (c1 >> 51)
    let c3 = t3 + (c2 >> 51)
    let c4 = t4 + (c3 >> 51)
    let c0 = (t0 & m) + 19 * (c4 >> 51)
    c1 = (c1 & m) + (c0 >> 51)
    Fe { l0: c0 & m, l1: c1, l2: c2 & m, l3: c3 & m, l4: c4 & m }
}

/// Returns the sum `a + b` modulo `2^255 - 19`.
pub fn add(a: Fe, b: Fe) -> Fe {
    carry(a.l0 + b.l0, a.l1 + b.l1, a.l2 + b.l2, a.l3 + b.l3, a.l4 + b.l4)
}

/// Returns the difference `a - b` modulo `2^255 - 19`.
pub fn sub(a: Fe, b: Fe) -> Fe {
    carry(
        a.l0 + 0xFFFFFFFFFFFDA - b.l0,
        a.l1 + 0xFFFFFFFFFFFFE - b.l1,
        a.l2 + 0xFFFFFFFFFFFFE - b.l2,
        a.l3 + 0xFFFFFFFFFFFFE - b.l3,
        a.l4 + 0xFFFFFFFFFFFFE - b.l4,
    )
}

/// Returns the additive inverse `-a` modulo `2^255 - 19`.
pub fn neg(a: Fe) -> Fe {
    let z = zero()
    sub(z, a)
}

fn product(a: u64, b: u64) -> Split {
    let lo = a * b
    let hi = __mulhi(a, b)
    Split { low: lo & mask51(), high: lo >> 51 | hi << 13 }
}

fn mac(s: Split, a: u64, b: u64) -> Split {
    let p = product(a, b)
    Split { low: s.low + p.low, high: s.high + p.high }
}

fn combine(c0: Split, c1: Split, c2: Split, c3: Split, c4: Split) -> Fe {
    carry(c0.low + 19 * c4.high, c1.low + c0.high, c2.low + c1.high, c3.low + c2.high, c4.low + c3.high)
}

/// Returns the product `f * g` modulo `2^255 - 19`.
pub fn mul(f: Fe, g: Fe) -> Fe {
    let g1 = g.l1 * 19
    let g2 = g.l2 * 19
    let g3 = g.l3 * 19
    let g4 = g.l4 * 19
    var c0 = product(f.l0, g.l0)
    c0 = mac(c0, f.l1, g4)
    c0 = mac(c0, f.l2, g3)
    c0 = mac(c0, f.l3, g2)
    c0 = mac(c0, f.l4, g1)
    var c1 = product(f.l0, g.l1)
    c1 = mac(c1, f.l1, g.l0)
    c1 = mac(c1, f.l2, g4)
    c1 = mac(c1, f.l3, g3)
    c1 = mac(c1, f.l4, g2)
    var c2 = product(f.l0, g.l2)
    c2 = mac(c2, f.l1, g.l1)
    c2 = mac(c2, f.l2, g.l0)
    c2 = mac(c2, f.l3, g4)
    c2 = mac(c2, f.l4, g3)
    var c3 = product(f.l0, g.l3)
    c3 = mac(c3, f.l1, g.l2)
    c3 = mac(c3, f.l2, g.l1)
    c3 = mac(c3, f.l3, g.l0)
    c3 = mac(c3, f.l4, g4)
    var c4 = product(f.l0, g.l4)
    c4 = mac(c4, f.l1, g.l3)
    c4 = mac(c4, f.l2, g.l2)
    c4 = mac(c4, f.l3, g.l1)
    c4 = mac(c4, f.l4, g.l0)
    combine(c0, c1, c2, c3, c4)
}

/// Returns the square `f * f` modulo `2^255 - 19`.
pub fn square(f: Fe) -> Fe {
    let d0 = f.l0 * 2
    let d1 = f.l1 * 2
    let d2 = f.l2 * 2
    let d3 = f.l3 * 2
    let s3 = f.l3 * 19
    let s4 = f.l4 * 19
    var c0 = product(f.l0, f.l0)
    c0 = mac(c0, d1, s4)
    c0 = mac(c0, d2, s3)
    var c1 = product(d0, f.l1)
    c1 = mac(c1, d2, s4)
    c1 = mac(c1, f.l3, s3)
    var c2 = product(d0, f.l2)
    c2 = mac(c2, f.l1, f.l1)
    c2 = mac(c2, d3, s4)
    var c3 = product(d0, f.l3)
    c3 = mac(c3, d1, f.l2)
    c3 = mac(c3, f.l4, s4)
    var c4 = product(d0, f.l4)
    c4 = mac(c4, d1, f.l3)
    c4 = mac(c4, f.l2, f.l2)
    combine(c0, c1, c2, c3, c4)
}

fn square_times(f: Fe, n: i64) -> Fe {
    var r = f
    for _ in 0..n {
        r = square(r)
    }
    r
}

fn square_times_mul(f: Fe, n: i64, g: Fe) -> Fe {
    let shifted = square_times(f, n)
    mul(shifted, g)
}

struct Chain {
    z11: Fe
    z_250_0: Fe
}

fn chain(z: Fe) -> Chain {
    let z2 = square(z)
    let z9 = square_times_mul(z2, 2, z)
    let z11 = mul(z9, z2)
    let z_5_0 = square_times_mul(z11, 1, z9)
    let z_10_0 = square_times_mul(z_5_0, 5, z_5_0)
    let z_20_0 = square_times_mul(z_10_0, 10, z_10_0)
    let z_40_0 = square_times_mul(z_20_0, 20, z_20_0)
    let z_50_0 = square_times_mul(z_40_0, 10, z_10_0)
    let z_100_0 = square_times_mul(z_50_0, 50, z_50_0)
    let z_200_0 = square_times_mul(z_100_0, 100, z_100_0)
    let z_250_0 = square_times_mul(z_200_0, 50, z_50_0)
    Chain { z11, z_250_0 }
}

/// Returns the multiplicative inverse `z^(p - 2)` modulo `p = 2^255 - 19`.
///
/// The inverse of zero is zero. The exponentiation is a fixed sequence of squarings and multiplications, independent of the value.
pub fn invert(z: Fe) -> Fe {
    let c = chain(z)
    square_times_mul(c.z_250_0, 5, c.z11)
}

/// Returns `z^((p - 5) / 8)` modulo `p = 2^255 - 19`, the exponentiation used to take square roots when decompressing Ed25519 points.
pub fn pow_p58(z: Fe) -> Fe {
    let c = chain(z)
    square_times_mul(c.z_250_0, 2, z)
}

/// Returns `b` when `choice` is `1` and `a` when it is `0`, without branching on `choice`.
///
/// `choice` must be `0` or `1`; any other value mixes the limbs of both inputs.
pub fn choose(a: Fe, b: Fe, choice: u64) -> Fe {
    let m = 0 - choice
    Fe {
        l0: a.l0 ^ (m & (a.l0 ^ b.l0))
        l1: a.l1 ^ (m & (a.l1 ^ b.l1))
        l2: a.l2 ^ (m & (a.l2 ^ b.l2))
        l3: a.l3 ^ (m & (a.l3 ^ b.l3))
        l4: a.l4 ^ (m & (a.l4 ^ b.l4))
    }
}

/// Exchanges `a` and `b` when `choice` is `1` and leaves them unchanged when it is `0`, without branching on `choice`.
///
/// `choice` must be `0` or `1`.
pub fn swap(mut a: Fe, mut b: Fe, choice: u64) {
    let x = choose(a, b, choice)
    b = choose(b, a, choice)
    a = x
}

/// Reports whether `a` and `b` encode the same field element.
///
/// Both are reduced to canonical bytes and compared without an early exit.
pub fn equal(a: Fe, b: Fe) -> bool {
    hash.equal(to_bytes(a), to_bytes(b))
}

/// Returns `1` when the canonical encoding of `f` has its low bit set and `0` otherwise.
pub fn is_negative(f: Fe) -> u64 {
    let b = to_bytes(f)
    u64(b[0] & 1)
}
