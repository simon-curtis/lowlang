import std/crypto
import std/crypto/hash
import std/io

/// A parsed SEC1 elliptic curve private key together with its public point.
pub struct Key {
    /// The curve the key belongs to.
    pub curve: Curve
    /// The private scalar as big-endian bytes, 32 for P-256 or 48 for P-384.
    pub private: []u8
    /// The public point in uncompressed SEC1 form, `0x04 || X || Y`, 65 bytes for P-256 or 97 for P-384.
    pub public: []u8
}

/// Returns a new private scalar for `curve` as big-endian bytes, 32 for P-256 or 48 for P-384.
///
/// The scalar is drawn from `crypto.random` and redrawn until it lies in `[1, n - 1]`, where `n` is the group order.
pub fn generate(curve: Curve) -> []u8 {
    let g = group(curve)
    var candidate = crypto.random(g.size)
    for !valid_scalar(g, decode(candidate, g.n.m.len)) {
        candidate = crypto.random(g.size)
    }
    candidate
}

/// Returns the public point for `private` in uncompressed SEC1 form, `0x04 || X || Y`, 65 bytes for P-256 or 97 for P-384.
///
/// Fails with `Invalid` when `private` is not exactly the curve's scalar size or is not in `[1, n - 1]`.
pub fn public_key(curve: Curve, private: []u8) -> []u8 ! io.Error {
    let g = group(curve)
    let d = private_scalar(g, private)?
    public_point(g, d)
}

/// Computes ECDH (the shared secret `Z` of SEC 1 and NIST SP 800-56A) between `private` and the peer point `peer`.
///
/// Returns the affine x coordinate of the shared point as big-endian bytes, 32 for P-256 or 48 for P-384. The bytes are not hashed.
///
/// `peer` must be an uncompressed SEC1 point, `0x04 || X || Y`, on the curve with both coordinates below the field prime. Fails with `Invalid` when `peer` does not meet that, when `private` is the wrong size or outside `[1, n - 1]`, or when the shared point is the point at infinity.
pub fn ecdh(curve: Curve, private: []u8, peer: []u8) -> []u8 ! io.Error {
    let g = group(curve)
    let d = private_scalar(g, private)?
    let q = match decode_point(g, peer) {
        some(point) => point
        none => fail Invalid
    }
    let shared = scalar_mul(g, q, encode(d))
    let a = match affine(g, shared) {
        some(point) => point
        none => fail Invalid
    }
    let x = element(g.p)
    from_mont(g.p, x, a.x)
    encode(x)
}

/// Signs `digest` with ECDSA (FIPS 186-4) and returns the raw signature `r || s`, each half big-endian and padded to the scalar size, 64 bytes for P-256 or 96 for P-384.
///
/// The nonce is deterministic (RFC 6979), with HMAC over SHA-512, SHA-384 or SHA-256 chosen by `digest.len` (64, 48, otherwise 32), so signing the same digest with the same key gives the same signature. `digest` is the hash of the message, not the message. A digest longer than the scalar size is truncated to its leftmost bytes.
///
/// Fails with `Invalid` when `private` is the wrong size or outside `[1, n - 1]`.
pub fn sign_raw(curve: Curve, private: []u8, digest: []u8) -> []u8 ! io.Error {
    let g = group(curve)
    let d = private_scalar(g, private)?
    deterministic_sign(g, d, digest)
}

/// Signs `digest` like `sign_raw` and returns the signature as an ASN.1 DER `Ecdsa-Sig-Value`, `SEQUENCE { r INTEGER, s INTEGER }`.
///
/// The length of the sequence is encoded in one byte, which holds for both curves. Fails with `Invalid` under the same conditions as `sign_raw`.
pub fn sign(curve: Curve, private: []u8, digest: []u8) -> []u8 ! io.Error {
    let raw = sign_raw(curve, private, digest)?
    let size = raw.len / 2
    let r = der_integer(raw[..size])
    let s = der_integer(raw[size..])
    let out: []u8 = __make(2 + r.len + s.len)
    out[0] = 0x30
    out[1] = u8(r.len + s.len)
    __memmove(out[2..], r)
    __memmove(out[2 + r.len..], s)
    out
}

/// Reports whether `signature` is a valid ECDSA signature of `digest` under the public point `public`.
///
/// `signature` is the raw form `r || s` produced by `sign_raw` and must be exactly twice the scalar size. `public` is an uncompressed SEC1 point. Returns `false`, never an error, for a wrong-sized or out-of-range signature, an invalid point, or a mismatch. A digest longer than the scalar size is truncated to its leftmost bytes.
pub fn verify_raw(curve: Curve, public: []u8, digest: []u8, signature: []u8) -> bool {
    let g = group(curve)
    if signature.len != 2 * g.size {
        return false
    }
    let l = g.n.m.len
    let r = decode(signature[..g.size], l)
    let s = decode(signature[g.size..], l)
    check(g, public, digest, r, s)
}

/// Reports whether the DER-encoded `signature` is a valid ECDSA signature of `digest` under the public point `public`.
///
/// `signature` is a `SEQUENCE` of two minimally encoded, non-negative `INTEGER`s with no trailing bytes; any other encoding returns `false`. `public` is an uncompressed SEC1 point. Returns `false`, never an error, for an invalid point or a mismatch.
pub fn verify(curve: Curve, public: []u8, digest: []u8, signature: []u8) -> bool {
    let g = group(curve)
    let outer = new(Der { data: signature, at: 0 })
    let body = match der_read(outer, 0x30) {
        some(content) => content
        none => return false
    }
    if outer.at != signature.len {
        return false
    }
    let inner = new(Der { data: body, at: 0 })
    let r = match der_scalar(g, inner) {
        some(value) => value
        none => return false
    }
    let s = match der_scalar(g, inner) {
        some(value) => value
        none => return false
    }
    if inner.at != body.len {
        return false
    }
    check(g, public, digest, r, s)
}

/// Parses a DER SEC1 `ECPrivateKey` (RFC 5915) into a `Key`.
///
/// The key must have version `1`. The curve comes from the optional `[0]` named-curve OID, `prime256v1` or `secp384r1`; when the OID is absent it is inferred from the private key length, 32 or 48 bytes. The optional `[1]` public key must be an uncompressed point and is checked against the point computed from the private scalar. `public` in the result is always the computed point.
///
/// Fails with `Malformed` for DER that does not follow this layout or has trailing bytes. Fails with `Invalid` for an unsupported curve, a private key that is not a valid scalar for the curve, or a public key that does not match.
pub fn parse_private(der: []u8) -> Key ! io.Error {
    let outer = new(Der { data: der, at: 0 })
    let body = match der_read(outer, 0x30) {
        some(content) => content
        none => fail Malformed
    }
    if outer.at != der.len {
        fail Malformed
    }
    let r = new(Der { data: body, at: 0 })
    let version = match der_read(r, 0x02) {
        some(content) => content
        none => fail Malformed
    }
    if version.len != 1 || version[0] != 1 {
        fail Malformed
    }
    let private = match der_read(r, 0x04) {
        some(content) => content
        none => fail Malformed
    }
    var curve: Curve? = curve_for_size(private.len)
    if r.at < body.len && body[r.at] == 0xa0 {
        let parameters = match der_read(r, 0xa0) {
            some(content) => new(Der { data: content, at: 0 })
            none => fail Malformed
        }
        let oid = match der_read(parameters, 0x06) {
            some(content) => content
            none => fail Malformed
        }
        curve = curve_for_oid(oid)
    }
    var public: []u8? = none
    if r.at < body.len && body[r.at] == 0xa1 {
        let wrapped = match der_read(r, 0xa1) {
            some(content) => new(Der { data: content, at: 0 })
            none => fail Malformed
        }
        let bits = match der_read(wrapped, 0x03) {
            some(content) => content
            none => fail Malformed
        }
        if bits.len < 1 || bits[0] != 0 {
            fail Malformed
        }
        public = bits[1..]
    }
    if r.at != body.len {
        fail Malformed
    }
    let chosen = match curve {
        some(c) => c
        none => fail Invalid
    }
    let computed = public_key(chosen, private)?
    match public {
        some(given) => {
            if !hash.equal(given, computed) {
                fail Invalid
            }
        }
        none => {}
    }
    Key { curve: chosen, private: copy_bytes(private), public: computed }
}

fn curve_for_size(size: i64) -> Curve? {
    if size == 32 {
        return Curve.P256
    }
    if size == 48 {
        return Curve.P384
    }
    none
}

fn curve_for_oid(oid: []u8) -> Curve? {
    if hash.equal(oid, [0x2a, 0x86, 0x48, 0xce, 0x3d, 0x03, 0x01, 0x07]) {
        return Curve.P256
    }
    if hash.equal(oid, [0x2b, 0x81, 0x04, 0x00, 0x22]) {
        return Curve.P384
    }
    none
}

fn copy_bytes(data: []u8) -> []u8 {
    let out: []u8 = __make(data.len)
    __memmove(out, data)
    out
}

fn valid_scalar(g: *Group, d: []u64) -> bool {
    !is_zero(d) && below(d, g.n.m)
}

fn private_scalar(g: *Group, private: []u8) -> []u64 ! io.Error {
    if private.len != g.size {
        fail Invalid
    }
    let d = decode(private, g.n.m.len)
    if !valid_scalar(g, d) {
        fail Invalid
    }
    d
}

fn public_point(g: *Group, d: []u64) -> []u8 ! io.Error {
    let point = scalar_mul(g, g.g, encode(d))
    match affine(g, point) {
        some(a) => encode_point(g, a)
        none => fail Invalid
    }
}

fn digest_scalar(g: *Group, digest: []u8) -> []u64 {
    let used = if digest.len > g.size { digest[..g.size] } else { digest }
    let e = decode(used, g.n.m.len)
    sub(g.n, e, e, g.n.m)
    e
}

fn hmac_algorithm(digest: []u8) -> hash.Algorithm {
    if digest.len == 64 {
        return hash.sha512()
    }
    if digest.len == 48 {
        return hash.sha384()
    }
    hash.sha256()
}

fn join(parts: [][]u8) -> []u8 {
    var size = 0
    for part in parts {
        size += part.len
    }
    let out: []u8 = __make(size)
    var at = 0
    for part in parts {
        __memmove(out[at..], part)
        at += part.len
    }
    out
}

fn deterministic_sign(g: *Group, d: []u64, digest: []u8) -> []u8 {
    let e = digest_scalar(g, digest)
    let x = encode(d)
    let h1 = encode(e)
    let alg = hmac_algorithm(digest)
    var key: []u8 = __make(alg.size)
    var v: []u8 = __make(alg.size)
    for i in 0..v.len {
        v[i] = 1
    }
    let zero: []u8 = [0]
    let one: []u8 = [1]
    key = hash.hmac(alg, key, join([v, zero, x, h1]))
    v = hash.hmac(alg, key, v)
    key = hash.hmac(alg, key, join([v, one, x, h1]))
    v = hash.hmac(alg, key, v)
    let t: []u8 = __make(g.size)
    for {
        var filled = 0
        for filled < g.size {
            v = hash.hmac(alg, key, v)
            __memmove(t[filled..], v)
            filled += v.len
        }
        let k = decode(t, g.n.m.len)
        if valid_scalar(g, k) {
            match attempt(g, d, e, k) {
                some(signature) => return signature
                none => {}
            }
        }
        key = hash.hmac(alg, key, join([v, zero]))
        v = hash.hmac(alg, key, v)
    }
}

fn attempt(g: *Group, d: []u64, e: []u64, k: []u64) -> []u8? {
    let point = scalar_mul(g, g.g, encode(k))
    let a = match affine(g, point) {
        some(value) => value
        none => return none
    }
    let n = g.n
    let r = element(n)
    from_mont(g.p, r, a.x)
    sub(n, r, r, n.m)
    if is_zero(r) {
        return none
    }
    let km = element(n)
    to_mont(n, km, k)
    let kinv = element(n)
    invert(n, kinv, km)
    let rm = element(n)
    to_mont(n, rm, r)
    let dm = element(n)
    to_mont(n, dm, d)
    let em = element(n)
    to_mont(n, em, e)
    let s = element(n)
    mul(n, s, rm, dm)
    add(n, s, s, em)
    mul(n, s, s, kinv)
    from_mont(n, s, s)
    if is_zero(s) {
        return none
    }
    join([encode(r), encode(s)])
}

fn check(g: *Group, public: []u8, digest: []u8, r: []u64, s: []u64) -> bool {
    if !valid_scalar(g, r) || !valid_scalar(g, s) {
        return false
    }
    let q = match decode_point(g, public) {
        some(point) => point
        none => return false
    }
    let n = g.n
    let e = digest_scalar(g, digest)
    let sm = element(n)
    to_mont(n, sm, s)
    let w = element(n)
    invert(n, w, sm)
    let em = element(n)
    to_mont(n, em, e)
    let rm = element(n)
    to_mont(n, rm, r)
    let u1 = element(n)
    mul(n, u1, em, w)
    from_mont(n, u1, u1)
    let u2 = element(n)
    mul(n, u2, rm, w)
    from_mont(n, u2, u2)
    let sum = scalar_mul(g, g.g, encode(u1))
    let other = scalar_mul(g, q, encode(u2))
    point_add(g, sum, sum, other)
    let a = match affine(g, sum) {
        some(value) => value
        none => return false
    }
    let x = element(n)
    from_mont(g.p, x, a.x)
    sub(n, x, x, n.m)
    same(x, r)
}

struct Der {
    data: []u8
    at: i64
}

fn der_read(r: *Der, tag: u8) -> []u8? {
    let data = r.data
    if r.at + 2 > data.len || data[r.at] != tag {
        return none
    }
    let first = data[r.at + 1]
    var at = r.at + 2
    var length = 0
    if first < 0x80 {
        length = i64(first)
    } else if first == 0x81 {
        if at + 1 > data.len || data[at] < 0x80 {
            return none
        }
        length = i64(data[at])
        at += 1
    } else if first == 0x82 {
        if at + 2 > data.len || data[at] == 0 {
            return none
        }
        length = i64(data[at]) << 8 | i64(data[at + 1])
        if length < 0x100 {
            return none
        }
        at += 2
    } else {
        return none
    }
    if length > data.len - at {
        return none
    }
    r.at = at + length
    data[at..at + length]
}

fn der_scalar(g: *Group, r: *Der) -> []u64? {
    let content = match der_read(r, 0x02) {
        some(value) => value
        none => return none
    }
    if content.len == 0 || content[0] >= 0x80 {
        return none
    }
    var digits = content
    if content.len > 1 && content[0] == 0 {
        if content[1] < 0x80 {
            return none
        }
        digits = content[1..]
    }
    if digits.len > g.size {
        return none
    }
    decode(digits, g.n.m.len)
}

fn der_integer(value: []u8) -> []u8 {
    var start = 0
    for start < value.len - 1 && value[start] == 0 {
        start += 1
    }
    let digits = value[start..]
    let pad = if digits[0] >= 0x80 { 1 } else { 0 }
    let out: []u8 = __make(2 + pad + digits.len)
    out[0] = 0x02
    out[1] = u8(pad + digits.len)
    __memmove(out[2 + pad..], digits)
    out
}
