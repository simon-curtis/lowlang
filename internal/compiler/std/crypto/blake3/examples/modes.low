import std/crypto/blake3
import std/text

/// Runs the three BLAKE3 modes (plain hash, keyed MAC, key derivation), then reads two slices of one extendable output.
fn main() {
    print("hash  {text.encode_hex(blake3.sum(bytes("abc")))}")

    let h = blake3.hasher()
    blake3.update(h, bytes("a"))
    blake3.update(h, bytes("bc"))
    print("split {text.encode_hex(blake3.finalize(h, 32))}")

    let key = bytes("whats the Elvish word for friend")
    let mac = blake3.keyed_hash(key, bytes("message")) catch {
        BadKey => {
            print("key must be 32 bytes")
            return
        }
    }
    print("mac   {text.encode_hex(mac)}")
    let rejected = blake3.keyed_hash(bytes("short"), bytes("message")) or []
    print("short key gives {rejected.len} bytes")

    let session = blake3.derive_key("example 2026 session keys", bytes("shared secret"), 64)
    let other = blake3.derive_key("example 2026 cookie keys", bytes("shared secret"), 64)
    print("session {text.encode_hex(session[..16])}")
    print("contexts differ: {text.encode_hex(session) != text.encode_hex(other)}")

    let stream = blake3.hasher()
    blake3.update(stream, bytes("abc"))
    let head = blake3.finalize_at(stream, 0, 48)
    let tail = blake3.finalize_at(stream, 32, 16)
    print("tail is the end of head: {text.encode_hex(head[32..]) == text.encode_hex(tail)}")
}
