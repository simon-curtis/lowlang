/// Returns the `OBJECT IDENTIFIER` of the named curve prime256v1 (NIST P-256) as dotted decimal text.
pub fn prime256v1() -> str {
    "1.2.840.10045.3.1.7"
}

/// Returns the `OBJECT IDENTIFIER` of the named curve secp384r1 (NIST P-384) as dotted decimal text.
pub fn secp384r1() -> str {
    "1.3.132.0.34"
}
