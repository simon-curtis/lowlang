import std/io
import std/sys

/// Returns `n` bytes from the operating system's cryptographically secure random generator.
///
/// Reads through the `getrandom` system call with no flags, so the call blocks until the kernel pool is initialised. A short or interrupted read is retried until `n` bytes are filled. An `n` of 0 returns an empty slice. Panics if the generator reports an error, because continuing without secure random bytes would be unsafe.
pub fn random(n: i64) -> []u8 {
    sys.random_bytes(n) catch {
        e => __panic("crypto: the random generator failed: {e}")
    }
}
