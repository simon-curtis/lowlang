import std/crypto/password
import std/text

fn report(label: str, stored: str) {
    let right = password.verify("correct horse", stored)
    let wrong = password.verify("battery staple", stored)
    print("{label}: {stored.len} chars, right password {right}, wrong password {wrong}")
}

fn run() ! password.Error {
    let argon = password.hash("correct horse")
    print("argon2id prefix {argon[..31]}")
    report("argon2id", argon)

    let pbkdf2 = password.hash_pbkdf2("correct horse", 1000)
    print("pbkdf2 prefix {pbkdf2[..22]}")
    report("pbkdf2", pbkdf2)

    let scrypt = password.hash_scrypt("correct horse", 10, 8, 1)?
    print("scrypt prefix {scrypt[..22]}")
    report("scrypt", scrypt)

    let bcrypt = password.hash_bcrypt("correct horse", 4)?
    print("bcrypt prefix {bcrypt[..7]}")
    report("bcrypt", bcrypt)

    let imported = "$2b$04$qVWBqxCLfSUX6XeUOTnJJu/ge6AbjDyIxQvkEK2DTfVQqOh5tW2yS"
    print("imported bcrypt hash accepts hunter2: {password.verify("hunter2", imported)}")
    print("unknown format accepted: {password.verify("hunter2", "$md5$abc$def")}")

    let long = text.repeat("x", 73)
    let refused = password.hash_bcrypt(long, 4) catch {
        PasswordTooLong => "bcrypt refuses a 73 byte password"
        _ => "other failure"
    }
    print(refused)
}

/// Stores and checks a login with each PHC hash format, imports an existing bcrypt hash, and shows the refusals.
fn main() {
    run() catch {
        e => print("failed: {e}")
    }
}
