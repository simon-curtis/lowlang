import std/crypto/hash

fn prf(keyed: hash.Keyed, message: []u8) -> []u8 {
    let d = keyed.inner.clone()
    d.update(message)
    let first = d.finish()
    let o = keyed.outer.clone()
    o.update(first)
    o.finish()
}

/// Derives `length` bytes from `password` and `salt` with PBKDF2 (RFC 8018) using HMAC over `algorithm`.
///
/// `iterations` is the iteration count; a value below `1` runs one iteration. Output longer than the digest size of `algorithm` is built from successive blocks, so `length` is not limited to one digest. A `length` of `0` returns an empty slice. The password may be any length; one longer than the block size of `algorithm` is hashed first, as HMAC specifies. No parameter limits are enforced.
pub fn pbkdf2(algorithm: hash.Algorithm, password: []u8, salt: []u8, iterations: i64, length: i64) -> []u8 {
    let keyed = hash.hmac_keyed(algorithm, password)
    let out: []u8 = __make(length)
    let first: []u8 = __make(salt.len + 4)
    __memmove(first, salt)
    var counter = 1
    var at = 0
    for at < length {
        first[salt.len] = u8(counter >> 24)
        first[salt.len + 1] = u8(counter >> 16)
        first[salt.len + 2] = u8(counter >> 8)
        first[salt.len + 3] = u8(counter)
        var u = prf(keyed, first)
        let sum: []u8 = __make(u.len)
        __memmove(sum, u)
        for round in 1..iterations {
            u = prf(keyed, u)
            for j in 0..sum.len {
                sum[j] ^= u[j]
            }
        }
        __memmove(out[at..], sum)
        at += algorithm.size
        counter += 1
    }
    out
}
