import std/crypto/hash

fn keyed_digest(algorithm: hash.Algorithm, key: []u8, pad: u8) -> hash.Digest {
    let block: []u8 = __make(algorithm.block)
    for i in 0..algorithm.block {
        block[i] = if i < key.len { key[i] ^ pad } else { pad }
    }
    let d = algorithm.digest()
    d.update(block)
    d
}

fn prf(inner: hash.Digest, outer: hash.Digest, message: []u8) -> []u8 {
    let d = inner.clone()
    d.update(message)
    let first = d.finish()
    let o = outer.clone()
    o.update(first)
    o.finish()
}

pub fn pbkdf2(algorithm: hash.Algorithm, password: []u8, salt: []u8, iterations: i64, length: i64) -> []u8 {
    let key = if password.len > algorithm.block { hash.sum(algorithm, password) } else { password }
    let inner = keyed_digest(algorithm, key, 0x36)
    let outer = keyed_digest(algorithm, key, 0x5C)
    let out: []u8 = __make(length)
    let first: []u8 = __make(salt.len + 4)
    __memmove(first, salt)
    var counter = 1
    var at = 0
    for at < length {
        first[salt.len] = u8(counter >> 24)
        first[salt.len + 1] = u8(counter >> 16)
        first[salt.len + 2] = u8(counter >> 8)
        first[salt.len + 3] = u8(counter)
        var u = prf(inner, outer, first)
        let sum: []u8 = __make(u.len)
        __memmove(sum, u)
        for round in 1..iterations {
            u = prf(inner, outer, u)
            for j in 0..sum.len {
                sum[j] ^= u[j]
            }
        }
        __memmove(out[at..], sum)
        at += algorithm.size
        counter += 1
    }
    out
}
