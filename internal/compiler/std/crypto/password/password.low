import std/base64
import std/crypto
import std/crypto/hash
import std/text

/// An error from the password hashing functions.
pub enum Error {
    /// A cost parameter is outside the range the algorithm accepts.
    InvalidParameters
    /// The memory an operation would need exceeds the given limit.
    MemoryLimit
    /// The bcrypt cost is not between 4 and 31.
    InvalidCost
    /// The bcrypt salt is not 16 bytes.
    InvalidSalt
    /// The bcrypt password is longer than 72 bytes.
    PasswordTooLong
}

fn parameters(field: str, names: []str) -> []i64? {
    let items = text.split(field, ',')
    if items.len != names.len {
        return none
    }
    var values: []i64 = []
    for i, item in items {
        let prefix = "{names[i]}="
        if !text.starts_with(item, prefix) {
            return none
        }
        let n = text.parse_uint(item[prefix.len..], 10) catch {
            _ => return none
        }
        push(mut values, n)
    }
    values
}

fn verify_argon2(password: str, field: str, salt_text: str, tag_text: str) -> bool {
    let values = match parameters(field, ["m", "t", "p"]) {
        some(v) => v
        none => return false
    }
    let m = values[0]
    let t = values[1]
    let p = values[2]
    if p < 1 || p > 255 || t < 1 || t > 100 || m < 8 * p || m > 1048576 {
        return false
    }
    let salt = base64.decode_unpadded(salt_text) catch { _ => [] }
    let tag = base64.decode_unpadded(tag_text) catch { _ => [] }
    if salt.len < 8 || salt.len > 256 || tag.len < 4 || tag.len > 256 {
        return false
    }
    let computed = argon2id(bytes(password), salt, t, m, p, tag.len)
    hash.equal(computed, tag)
}

fn verify_pbkdf2(password: str, field: str, salt_text: str, tag_text: str) -> bool {
    let values = match parameters(field, ["i"]) {
        some(v) => v
        none => return false
    }
    let iterations = values[0]
    if iterations < 1 || iterations > 10000000 {
        return false
    }
    let salt = base64.decode_unpadded(salt_text) catch { _ => [] }
    let tag = base64.decode_unpadded(tag_text) catch { _ => [] }
    if salt.len < 1 || salt.len > 256 || tag.len < 4 || tag.len > 64 {
        return false
    }
    let computed = pbkdf2(hash.sha256(), bytes(password), salt, iterations, tag.len)
    hash.equal(computed, tag)
}

/// Hashes `password` with Argon2id and returns a PHC string.
///
/// The parameters are fixed at 19456 KiB of memory, 2 passes, 1 lane, a random 16-byte salt from `crypto.random` and a 32-byte tag. The result has the form `$argon2id$v=19$m=19456,t=2,p=1$<salt>$<tag>`, with salt and tag in unpadded standard base64.
pub fn hash(password: str) -> str {
    let salt = crypto.random(16)
    let tag = argon2id(bytes(password), salt, 2, 19456, 1, 32)
    "$argon2id$v=19$m=19456,t=2,p=1${base64.encode_unpadded(salt)}${base64.encode_unpadded(tag)}"
}

/// Hashes `password` with PBKDF2-HMAC-SHA-256 (RFC 8018) and returns a PHC string.
///
/// `iterations` is clamped to `[1, 10000000]`. The salt is 16 random bytes from `crypto.random` and the tag is 32 bytes. The result has the form `$pbkdf2-sha256$i=<iterations>$<salt>$<tag>`, with salt and tag in unpadded standard base64.
pub fn hash_pbkdf2(password: str, iterations: i64) -> str {
    let rounds = if iterations < 1 { 1 } else if iterations > 10000000 { 10000000 } else { iterations }
    let salt = crypto.random(16)
    let tag = pbkdf2(hash.sha256(), bytes(password), salt, rounds, 32)
    "$pbkdf2-sha256$i={rounds}${base64.encode_unpadded(salt)}${base64.encode_unpadded(tag)}"
}

/// Reports whether `password` matches the hash string `encoded`.
///
/// Accepts `$argon2id$v=19$...`, `$pbkdf2-sha256$...`, `$scrypt$...` and bcrypt `$2a$`, `$2b$` and `$2y$` strings. The recomputed tag is compared without an early exit. Returns `false`, never an error, for an unrecognised format, malformed fields, parameters outside the limits below, a bcrypt password over 72 bytes, or a mismatch.
///
/// Argon2id requires `p` in `[1, 255]`, `t` in `[1, 100]`, `m` in `[8 * p, 1048576]` KiB, a salt of 8 to 256 bytes and a tag of 4 to 256 bytes. PBKDF2 requires `i` in `[1, 10000000]`, a salt of 1 to 256 bytes and a tag of 4 to 64 bytes. scrypt requires `ln` in `[1, 32]`, a salt of 8 to 256 bytes, a tag of 4 to 256 bytes and at most 512 MiB of memory.
pub fn verify(password: str, encoded: str) -> bool {
    let parts = text.split(encoded, '$')
    if parts.len == 6 && parts[0] == "" && parts[1] == "argon2id" && parts[2] == "v=19" {
        return verify_argon2(password, parts[3], parts[4], parts[5])
    }
    if parts.len == 5 && parts[0] == "" && parts[1] == "pbkdf2-sha256" {
        return verify_pbkdf2(password, parts[2], parts[3], parts[4])
    }
    if parts.len == 5 && parts[0] == "" && parts[1] == "scrypt" {
        return verify_scrypt(password, parts[2], parts[3], parts[4])
    }
    if parts.len == 4 && parts[0] == "" && (parts[1] == "2a" || parts[1] == "2b" || parts[1] == "2y") {
        return verify_bcrypt(password, parts[2], parts[3])
    }
    false
}
