import std/base64
import std/crypto
import std/crypto/hash
import std/text

struct Blowfish {
    p: []u32
    s: []u32
}

fn blowfish_state() -> *Blowfish {
    let words = pi_words()
    let p: []u32 = __make(18)
    let s: []u32 = __make(1024)
    __memmove(p, words[..18])
    __memmove(s, words[18..])
    new(Blowfish { p, s })
}

fn round(s: []u32, x: u32) -> u32 {
    (s[x >> 24] + s[256 + (x >> 16 & 0xff)] ^ s[512 + (x >> 8 & 0xff)]) + s[768 + (x & 0xff)]
}

fn encipher(b: *Blowfish, mut l: u32, mut r: u32) {
    let p = b.p
    let s = b.s
    var xl = l ^ p[0]
    var xr = r
    for i in 0..8 {
        xr ^= round(s, xl) ^ p[2 * i + 1]
        xl ^= round(s, xr) ^ p[2 * i + 2]
    }
    l = xr ^ p[17]
    r = xl
}

fn cyclic_word(data: []u8, mut at: i64) -> u32 {
    var w: u32 = 0
    for _ in 0..4 {
        w = w << 8 | u32(data[at])
        at = (at + 1) % data.len
    }
    w
}

fn expand_key(b: *Blowfish, salt: []u8, key: []u8) {
    var kat = 0
    for i in 0..18 {
        b.p[i] ^= cyclic_word(key, mut kat)
    }
    var sat = 0
    var l: u32 = 0
    var r: u32 = 0
    for i in 0..9 {
        if salt.len > 0 {
            l ^= cyclic_word(salt, mut sat)
            r ^= cyclic_word(salt, mut sat)
        }
        encipher(b, mut l, mut r)
        b.p[2 * i] = l
        b.p[2 * i + 1] = r
    }
    for i in 0..512 {
        if salt.len > 0 {
            l ^= cyclic_word(salt, mut sat)
            r ^= cyclic_word(salt, mut sat)
        }
        encipher(b, mut l, mut r)
        b.s[2 * i] = l
        b.s[2 * i + 1] = r
    }
}

fn eks_setup(cost: i64, salt: []u8, key: []u8) -> *Blowfish {
    let b = blowfish_state()
    expand_key(b, salt, key)
    let no_salt: []u8 = []
    let rounds = 1 << cost
    for _ in 0..rounds {
        expand_key(b, no_salt, key)
        expand_key(b, no_salt, salt)
    }
    b
}

fn magic_words() -> []u32 {
    [0x4f727068, 0x65616e42, 0x65686f6c, 0x64657253, 0x63727944, 0x6f756274]
}

fn encrypt_magic(b: *Blowfish) -> []u8 {
    let w = magic_words()
    for _ in 0..64 {
        for i in 0..3 {
            var l = w[2 * i]
            var r = w[2 * i + 1]
            encipher(b, mut l, mut r)
            w[2 * i] = l
            w[2 * i + 1] = r
        }
    }
    let out: []u8 = __make(23)
    for i in 0..23 {
        out[i] = u8(w[i / 4] >> (24 - 8 * (i % 4)))
    }
    out
}

fn alphabet() -> str {
    "./ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"
}

fn key_with_terminator(password: []u8) -> []u8 {
    let key: []u8 = __make(password.len + 1)
    __memmove(key, password)
    key
}

/// Computes the bcrypt hash of `password` and returns the 23 raw digest bytes.
///
/// `salt` must be exactly 16 bytes and `cost` is the base-2 logarithm of the number of rounds, from 4 to 31. The password is used with a trailing NUL byte, as in `$2b$`. The digest is not encoded and carries no cost or salt; see `hash_bcrypt` for the string form.
///
/// Fails with `InvalidCost` for a cost outside `[4, 31]`, with `InvalidSalt` for a salt that is not 16 bytes, and with `PasswordTooLong` for a password over 72 bytes.
pub fn bcrypt(password: []u8, salt: []u8, cost: i64) -> []u8 ! Error {
    if cost < 4 || cost > 31 {
        fail Error.InvalidCost
    }
    if salt.len != 16 {
        fail Error.InvalidSalt
    }
    if password.len > 72 {
        fail Error.PasswordTooLong
    }
    let b = eks_setup(cost, salt, key_with_terminator(password))
    encrypt_magic(b)
}

fn cost_text(cost: i64) -> str {
    if cost < 10 { "0{cost}" } else { "{cost}" }
}

/// Hashes `password` with bcrypt and returns a `$2b$` string.
///
/// The salt is 16 random bytes from `crypto.random`. The result has the form `$2b$<cost, two digits>$<salt, 22 characters><digest, 31 characters>`, using the bcrypt base64 alphabet. Fails with the errors of `bcrypt`: `InvalidCost`, or `PasswordTooLong` for a password over 72 bytes.
pub fn hash_bcrypt(password: str, cost: i64) -> str ! Error {
    let salt = crypto.random(16)
    let digest = bcrypt(bytes(password), salt, cost)?
    "$2b${cost_text(cost)}${base64.encode_with(salt, alphabet(), false)}{base64.encode_with(digest, alphabet(), false)}"
}

fn verify_bcrypt(password: str, cost_field: str, body: str) -> bool {
    if cost_field.len != 2 || body.len != 53 {
        return false
    }
    let cost = text.parse_uint(cost_field, 10) or return false
    let salt = base64.decode_with(body[..22], alphabet(), base64.Padding.Forbidden) or return false
    if salt.len != 16 {
        return false
    }
    let computed = bcrypt(bytes(password), salt, cost) or return false
    hash.equal(bytes(base64.encode_with(computed, alphabet(), false)), bytes(body[22..]))
}
