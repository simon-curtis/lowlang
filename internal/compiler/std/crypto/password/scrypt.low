import std/base64
import std/bits
import std/crypto
import std/crypto/hash
import std/io


fn salsa_quarter(mut a: u32, mut b: u32, mut c: u32, mut d: u32) {
    b ^= bits.rotl32(a + d, 7)
    c ^= bits.rotl32(b + a, 9)
    d ^= bits.rotl32(c + b, 13)
    a ^= bits.rotl32(d + c, 18)
}

fn salsa8(b: []u32) {
    var x0 = b[0]
    var x1 = b[1]
    var x2 = b[2]
    var x3 = b[3]
    var x4 = b[4]
    var x5 = b[5]
    var x6 = b[6]
    var x7 = b[7]
    var x8 = b[8]
    var x9 = b[9]
    var x10 = b[10]
    var x11 = b[11]
    var x12 = b[12]
    var x13 = b[13]
    var x14 = b[14]
    var x15 = b[15]
    for _ in 0..4 {
        salsa_quarter(mut x0, mut x4, mut x8, mut x12)
        salsa_quarter(mut x5, mut x9, mut x13, mut x1)
        salsa_quarter(mut x10, mut x14, mut x2, mut x6)
        salsa_quarter(mut x15, mut x3, mut x7, mut x11)
        salsa_quarter(mut x0, mut x1, mut x2, mut x3)
        salsa_quarter(mut x5, mut x6, mut x7, mut x4)
        salsa_quarter(mut x10, mut x11, mut x8, mut x9)
        salsa_quarter(mut x15, mut x12, mut x13, mut x14)
    }
    b[0] += x0
    b[1] += x1
    b[2] += x2
    b[3] += x3
    b[4] += x4
    b[5] += x5
    b[6] += x6
    b[7] += x7
    b[8] += x8
    b[9] += x9
    b[10] += x10
    b[11] += x11
    b[12] += x12
    b[13] += x13
    b[14] += x14
    b[15] += x15
}

fn block_mix(src: []u32, dst: []u32, r: i64, tmp: []u32) {
    let last = (2 * r - 1) * 16
    for i in 0..16 {
        tmp[i] = src[last + i]
    }
    for i in 0..2 * r {
        for j in 0..16 {
            tmp[j] ^= src[i * 16 + j]
        }
        salsa8(tmp)
        let slot = if i % 2 == 0 { i / 2 } else { r + i / 2 }
        for j in 0..16 {
            dst[slot * 16 + j] = tmp[j]
        }
    }
}

fn ro_mix(chunk: []u32, r: i64, n: i64) {
    let size = 32 * r
    let v: []u32 = __make(n * size)
    let scratch: []u32 = __make(size)
    let tmp: []u32 = __make(16)
    var x = chunk
    var y = scratch
    for i in 0..n {
        __memmove(v[i * size..], x)
        block_mix(x, y, r, tmp)
        let held = x
        x = y
        y = held
    }
    for _ in 0..n {
        let j = i64(x[size - 16] & u32(n - 1))
        for k in 0..size {
            x[k] ^= v[j * size + k]
        }
        block_mix(x, y, r, tmp)
        let held = x
        x = y
        y = held
    }
}

fn words_from_bytes(b: []u8) -> []u32 {
    let w: []u32 = __make(b.len / 4)
    for i in 0..w.len {
        w[i] = io.u32_le(b, 4 * i)
    }
    w
}

fn bytes_from_words(w: []u32) -> []u8 {
    let b: []u8 = __make(w.len * 4)
    for i in 0..w.len {
        b[4 * i] = u8(w[i])
        b[4 * i + 1] = u8(w[i] >> 8)
        b[4 * i + 2] = u8(w[i] >> 16)
        b[4 * i + 3] = u8(w[i] >> 24)
    }
    b
}

fn valid_scrypt(n: i64, r: i64, p: i64, length: i64) -> bool {
    n >= 2 && n & (n - 1) == 0 && n <= 4294967296 && r >= 1 && p >= 1 && r * p < 1073741824 && length >= 1 && length <= 137438953440
}

/// Returns the bytes of memory `scrypt` allocates for the cost parameters `n`, `r` and `p`, computed as `128 * r * (n + p + 1)`.
///
/// The result is not range-checked.
pub fn scrypt_memory(n: i64, r: i64, p: i64) -> i64 {
    128 * r * (n + p + 1)
}

/// Derives `length` bytes from `password` and `salt` with scrypt (RFC 7914).
///
/// `n` is the CPU and memory cost, a power of two from 2 to 2^32, `r` the block size and `p` the parallelism, both at least 1 with `r * p` below 2^30. `length` is from 1 to 137438953440 (`(2^32 - 1) * 32`). `max_memory` is the memory limit in bytes and is checked, with `scrypt_memory`, before anything is allocated.
///
/// Fails with `InvalidParameters` when a parameter is outside those ranges, and with `MemoryLimit` when `scrypt_memory(n, r, p)` exceeds `max_memory`.
pub fn scrypt(password: []u8, salt: []u8, n: i64, r: i64, p: i64, length: i64, max_memory: i64) -> []u8 ! Error {
    if !valid_scrypt(n, r, p, length) {
        fail Error.InvalidParameters
    }
    if scrypt_memory(n, r, p) > max_memory {
        fail Error.MemoryLimit
    }
    let sha = hash.sha256()
    let stretched = pbkdf2(sha, password, salt, 1, p * 128 * r)
    let b = words_from_bytes(stretched)
    let size = 32 * r
    for i in 0..p {
        ro_mix(b[i * size..(i + 1) * size], r, n)
    }
    pbkdf2(sha, password, bytes_from_words(b), 1, length)
}

fn verify_memory_limit() -> i64 {
    536870912
}

/// Hashes `password` with scrypt and returns a PHC string.
///
/// The cost is `N = 2^log_n` with `log_n` in `[1, 32]`. `r` and `p` follow the limits of `scrypt`, with a memory limit of 512 MiB. The salt is 16 random bytes from `crypto.random` and the tag is 32 bytes. The result has the form `$scrypt$ln=<log_n>,r=<r>,p=<p>$<salt>$<tag>`, with salt and tag in unpadded standard base64.
///
/// Fails with `InvalidParameters` for `log_n` outside `[1, 32]` or invalid `r` or `p`, and with `MemoryLimit` when the memory needed exceeds 512 MiB.
pub fn hash_scrypt(password: str, log_n: i64, r: i64, p: i64) -> str ! Error {
    if log_n < 1 || log_n > 32 {
        fail Error.InvalidParameters
    }
    let salt = crypto.random(16)
    let tag = scrypt(bytes(password), salt, 1 << log_n, r, p, 32, verify_memory_limit())?
    "$scrypt$ln={log_n},r={r},p={p}${base64.encode_unpadded(salt)}${base64.encode_unpadded(tag)}"
}

fn verify_scrypt(password: str, field: str, salt_text: str, tag_text: str) -> bool {
    let values = match parameters(field, ["ln", "r", "p"]) {
        some(v) => v
        none => return false
    }
    if values[0] < 1 || values[0] > 32 {
        return false
    }
    let c = match credential(salt_text, tag_text, 8, 256) {
        some(v) => v
        none => return false
    }
    let computed = scrypt(bytes(password), c.salt, 1 << values[0], values[1], values[2], c.tag.len, verify_memory_limit()) catch {
        _ => return false
    }
    hash.equal(computed, c.tag)
}
