import std/crypto
import field = std/crypto/curve25519
import std/io

fn clamp(k: []u8) -> []u8 {
    let out: []u8 = __make(32)
    __memmove(out, k)
    out[0] &= 248
    out[31] &= 127
    out[31] |= 64
    out
}

fn ladder(scalar: []u8, point: []u8) -> []u8 {
    let k = clamp(scalar)
    let u = field.from_bytes(point)
    let a24 = field.limbs(121665, 0, 0, 0, 0)
    var x2 = field.one()
    var z2 = field.zero()
    var x3 = u
    var z3 = field.one()
    var swapped: u64 = 0
    var t = 254
    for t >= 0 {
        let bit = u64(k[t >> 3] >> u8(t & 7)) & 1
        swapped ^= bit
        field.swap(mut x2, mut x3, swapped)
        field.swap(mut z2, mut z3, swapped)
        swapped = bit
        let a = field.add(x2, z2)
        let aa = field.square(a)
        let b = field.sub(x2, z2)
        let bb = field.square(b)
        let e = field.sub(aa, bb)
        let c = field.add(x3, z3)
        let d = field.sub(x3, z3)
        let da = field.mul(d, a)
        let cb = field.mul(c, b)
        let sum = field.add(da, cb)
        let difference = field.sub(da, cb)
        let difference2 = field.square(difference)
        let a24e = field.mul(a24, e)
        let aa_a24e = field.add(aa, a24e)
        x3 = field.square(sum)
        z3 = field.mul(u, difference2)
        x2 = field.mul(aa, bb)
        z2 = field.mul(e, aa_a24e)
        t -= 1
    }
    field.swap(mut x2, mut x3, swapped)
    field.swap(mut z2, mut z3, swapped)
    let inverse = field.invert(z2)
    let affine = field.mul(x2, inverse)
    field.to_bytes(affine)
}

fn base_point() -> []u8 {
    let b: []u8 = __make(32)
    b[0] = 9
    b
}

/// Returns a new 32-byte X25519 private key from `random` in `std/crypto`.
pub fn generate() -> []u8 {
    crypto.random(32)
}

/// Returns the 32-byte X25519 public key for the 32-byte `private` key (RFC 7748).
///
/// Multiplies the base point with `u` of 9 by the clamped private key. The length of `private` is not validated.
pub fn public_key(private: []u8) -> []u8 {
    let base = base_point()
    ladder(private, base)
}

/// Returns the 32-byte X25519 shared secret of `private` and the peer's public key `peer` (RFC 7748).
///
/// Fails with `io.Error.Invalid` when either argument is not 32 bytes or when the result is all zeros, which a low-order `peer` point produces. The secret is not uniformly random; derive keys from it with a KDF such as `hkdf_extract`.
pub fn shared(private: []u8, peer: []u8) -> []u8 ! io.Error {
    if private.len != 32 || peer.len != 32 {
        fail Invalid
    }
    let secret = ladder(private, peer)
    var any: u8 = 0
    for b in secret {
        any |= b
    }
    if any == 0 {
        fail Invalid
    }
    secret
}
