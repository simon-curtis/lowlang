import std/base64
import std/crypto/ecdsa
import std/crypto/rsa
import std/io
import std/json

/// The key material of a JSON Web Key.
pub enum Key {
    /// A shared secret for the HMAC algorithms (`kty` of `oct`).
    Hmac(secret: []u8)
    /// An RSA key (`kty` of `RSA`): the public key and, when the JWK carries all of `d`, `p`, `q`, `dp`, `dq` and `qi`, the private key.
    Rsa(public: rsa.PublicKey, private: rsa.PrivateKey?)
    /// An elliptic curve key (`kty` of `EC`, curve `P-256` or `P-384`): the public point as an uncompressed SEC 1 encoding (`0x04` followed by `x` and `y`) and, when present, the private scalar `d`.
    Ec(curve: ecdsa.Curve, public: []u8, private: []u8?)
    /// An Ed25519 key (`kty` of `OKP`, `crv` of `Ed25519`): the 32-byte public key and, when present, the 32-byte private seed.
    Ed(public: []u8, seed: []u8?)
}

/// A JSON Web Key (RFC 7517) with the metadata used to select it.
pub struct Jwk {
    /// The key identifier (`kid`), or the empty string when the key has none.
    pub kid: str = ""
    /// The key material.
    pub key: Key
    /// The algorithm the key is restricted to (`alg`), or the empty string when it may be used with any algorithm its type suits.
    pub alg: str = ""
}

fn text_member(v: json.Value, name: str) -> str? {
    let found = json.get(v, name) ?? json.Value.Null
    match found {
        Str(s) => s
        _ => none
    }
}

fn binary_member(v: json.Value, name: str) -> []u8? {
    match text_member(v, name) {
        some(s) => base64.decode_url(s) catch {
            _ => return none
        }
        none => none
    }
}

fn integer_member(v: json.Value, name: str) -> []u8? {
    let raw = binary_member(v, name) ?? []
    let magnitude = rsa.integer(raw)
    if magnitude.len == 0 {
        return none
    }
    magnitude
}

fn curve_name(curve: ecdsa.Curve) -> str {
    match curve {
        P256 => "P-256"
        P384 => "P-384"
    }
}

fn curve_by_name(name: str) -> ecdsa.Curve? {
    for curve in [ecdsa.Curve.P256, ecdsa.Curve.P384] {
        if curve_name(curve) == name {
            return curve
        }
    }
    none
}

fn rsa_key(v: json.Value) -> Key? {
    let n = match integer_member(v, "n") {
        some(b) => b
        none => return none
    }
    let e = match integer_member(v, "e") {
        some(b) => b
        none => return none
    }
    Rsa(rsa.PublicKey { n, e }, rsa_private(v, n, e))
}

fn rsa_private(v: json.Value, n: []u8, e: []u8) -> rsa.PrivateKey? {
    var parts: [][]u8 = []
    for name in ["d", "p", "q", "dp", "dq", "qi"] {
        match integer_member(v, name) {
            some(b) => push(mut parts, b)
            none => return none
        }
    }
    rsa.PrivateKey { n, e, d: parts[0], p: parts[1], q: parts[2], dp: parts[3], dq: parts[4], qinv: parts[5] }
}

fn ec_key(v: json.Value) -> Key? {
    let curve = match curve_by_name(text_member(v, "crv") ?? "") {
        some(c) => c
        none => return none
    }
    let x = binary_member(v, "x") ?? []
    let y = binary_member(v, "y") ?? []
    let public = match ecdsa.uncompressed(curve, x, y) {
        some(point) => point
        none => return none
    }
    match binary_member(v, "d") {
        some(d) => {
            if d.len != ecdsa.scalar_size(curve) {
                return none
            }
            Ec(curve, public, d)
        }
        none => Ec(curve, public, none)
    }
}

fn ed_key(v: json.Value) -> Key? {
    if text_member(v, "crv") != "Ed25519" {
        return none
    }
    let x = binary_member(v, "x") ?? []
    if x.len != 32 {
        return none
    }
    match binary_member(v, "d") {
        some(d) => {
            if d.len != 32 {
                return none
            }
            Ed(x, d)
        }
        none => Ed(x, none)
    }
}

fn parse_jwk(v: json.Value) -> Jwk? {
    let usage = text_member(v, "use") ?? "sig"
    if usage != "sig" {
        return none
    }
    let kty = text_member(v, "kty") ?? ""
    var key: Key? = none
    if kty == "oct" {
        key = match binary_member(v, "k") {
            some(k) => Hmac(k)
            none => none
        }
    } else if kty == "RSA" {
        key = rsa_key(v)
    } else if kty == "EC" {
        key = ec_key(v)
    } else if kty == "OKP" {
        key = ed_key(v)
    }
    match key {
        some(k) => Jwk { kid: text_member(v, "kid") ?? "", key: k, alg: text_member(v, "alg") ?? "" }
        none => none
    }
}

/// Parses a JWK Set (RFC 7517 section 5) or a single JWK from JSON text.
///
/// A top-level object with a `keys` member is read as a set; any other object is read as one key. Keys that cannot be used are skipped, not reported: an unsupported `kty` or curve, a `use` other than `sig`, a missing member, malformed Base64url or a coordinate of the wrong length. Leading zero bytes of RSA integers are stripped.
///
/// Fails with `Malformed` when the text is not JSON, is not an object, or has a `keys` member that is not an array.
pub fn parse_jwks(data: []u8) -> []Jwk ! io.Error {
    let v = json.parse(data) catch {
        _ => fail Malformed
    }
    let set = match v {
        Object(_) => json.get(v, "keys") ?? json.Value.Array([v])
        _ => fail Malformed
    }
    let items = match set {
        Array(entries) => entries
        _ => fail Malformed
    }
    var keys: []Jwk = []
    for item in items {
        match parse_jwk(item) {
            some(k) => push(mut keys, k)
            none => {}
        }
    }
    keys
}

fn string_member(name: str, value: str) -> json.Member {
    json.Member { name, value: Str(value) }
}

fn binary_json(name: str, value: []u8) -> json.Member {
    string_member(name, base64.encode_url(value))
}

fn jwk_value(k: Jwk) -> json.Value {
    var members: []json.Member = []
    match k.key {
        Hmac(secret) => {
            push(mut members, string_member("kty", "oct"))
            push(mut members, binary_json("k", secret))
        }
        Rsa(public, _) => {
            push(mut members, string_member("kty", "RSA"))
            push(mut members, binary_json("n", public.n))
            push(mut members, binary_json("e", public.e))
        }
        Ec(curve, public, _) => {
            let point = ecdsa.coordinates(curve, public) ?? ecdsa.Coordinates { x: [], y: [] }
            push(mut members, string_member("kty", "EC"))
            push(mut members, string_member("crv", curve_name(curve)))
            push(mut members, binary_json("x", point.x))
            push(mut members, binary_json("y", point.y))
        }
        Ed(public, _) => {
            push(mut members, string_member("kty", "OKP"))
            push(mut members, string_member("crv", "Ed25519"))
            push(mut members, binary_json("x", public))
        }
    }
    push(mut members, string_member("use", "sig"))
    if k.kid.len > 0 {
        push(mut members, string_member("kid", k.kid))
    }
    if k.alg.len > 0 {
        push(mut members, string_member("alg", k.alg))
    }
    Object(members)
}

/// Returns the JSON text of the public part of `k`.
///
/// Private members (`d` and the RSA primes) are never written. An HMAC key writes its secret `k`; use `jwks_json` to publish a set without symmetric keys. The `use` member is always `sig`, and `kid` and `alg` are written when not empty.
pub fn jwk_json(k: Jwk) -> str {
    json.stringify(jwk_value(k), 0)
}

/// Returns the JSON text of a JWK Set holding the public parts of `keys`.
///
/// HMAC keys are left out so a shared secret is never published. Private members are never written.
pub fn jwks_json(keys: []Jwk) -> str {
    var items: []json.Value = []
    for k in keys {
        match k.key {
            Hmac(_) => {}
            _ => push(mut items, jwk_value(k))
        }
    }
    let set: []json.Member = [json.Member { name: "keys", value: Array(items) }]
    json.stringify(json.Value.Object(set), 0)
}
