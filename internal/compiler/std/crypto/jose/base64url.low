fn encode(data: []u8) -> str {
    let table = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"
    let out: []u8 = __make((data.len * 4 + 2) / 3)
    var i = 0
    var o = 0
    for i + 2 < data.len {
        let n = i64(data[i]) << 16 | i64(data[i + 1]) << 8 | i64(data[i + 2])
        out[o] = table[n >> 18 & 63]
        out[o + 1] = table[n >> 12 & 63]
        out[o + 2] = table[n >> 6 & 63]
        out[o + 3] = table[n & 63]
        i += 3
        o += 4
    }
    let rest = data.len - i
    if rest > 0 {
        var n = i64(data[i]) << 16
        if rest == 2 {
            n = n | i64(data[i + 1]) << 8
            out[o + 2] = table[n >> 6 & 63]
        }
        out[o] = table[n >> 18 & 63]
        out[o + 1] = table[n >> 12 & 63]
    }
    __str_view(out)
}

fn sextet(c: u8) -> i64 {
    if c >= 'A' && c <= 'Z' {
        return i64(c - 'A')
    }
    if c >= 'a' && c <= 'z' {
        return i64(c - 'a') + 26
    }
    if c >= '0' && c <= '9' {
        return i64(c - '0') + 52
    }
    if c == '-' {
        return 62
    }
    if c == '_' {
        return 63
    }
    -1
}

fn decode(s: str) -> []u8? {
    let rest = s.len % 4
    if rest == 1 {
        return none
    }
    let tail = if rest == 0 { 0 } else { rest - 1 }
    let out: []u8 = __make(s.len / 4 * 3 + tail)
    var n = 0
    var bits = 0
    var o = 0
    for i in 0..s.len {
        let v = sextet(s[i])
        if v < 0 {
            return none
        }
        n = n << 6 | v
        bits += 6
        if bits >= 8 {
            bits -= 8
            out[o] = u8(n >> bits)
            n = n & ((1 << bits) - 1)
            o += 1
        }
    }
    if n != 0 {
        return none
    }
    out
}
