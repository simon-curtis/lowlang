import std/io
import std/json
import std/time

/// The registered claims of a JSON Web Token (RFC 7519), parsed from the payload.
pub struct Claims {
    /// The issuer (`iss`), or `none` when absent.
    pub iss: str?
    /// The subject (`sub`), or `none` when absent.
    pub sub: str?
    /// The audience (`aud`), as a list whether the token carried a string or an array. Empty when absent.
    pub aud: []str
    /// The expiry time (`exp`) in Unix seconds, or `none` when absent.
    pub exp: i64?
    /// The time before which the token is not valid (`nbf`) in Unix seconds, or `none` when absent.
    pub nbf: i64?
    /// The issue time (`iat`) in Unix seconds, or `none` when absent.
    pub iat: i64?
    /// The token identifier (`jti`), or `none` when absent.
    pub jti: str?
    /// The whole payload object, including the registered claims, for reading custom claims.
    pub extra: json.Value
}

/// The checks `verify` applies to a token.
pub struct Options {
    /// The `alg` values to accept, such as `["ES256"]`. An empty list accepts no token.
    pub algorithms: []str
    /// The required `iss`. The empty string, the default, skips the check.
    pub issuer: str = ""
    /// The value that must appear in `aud`. The empty string, the default, skips the check.
    pub audience: str = ""
    /// The clock skew in seconds tolerated on `exp` and `nbf`. Defaults to `60`.
    pub leeway: i64 = 60
    /// The current time in Unix seconds. `0`, the default, reads the system clock.
    pub now: i64 = 0
}

fn string_claim(payload: json.Value, name: str) -> str? ! io.Error {
    match json.get(payload, name) {
        some(v) => match v {
            Str(s) => s
            _ => fail Malformed
        }
        none => none
    }
}

fn date_claim(payload: json.Value, name: str) -> i64? ! io.Error {
    match json.get(payload, name) {
        some(v) => match v {
            Int(n) => n
            Float(x) => {
                if !(x > -9.0e18 && x < 9.0e18) {
                    fail Malformed
                }
                i64(x)
            }
            _ => fail Malformed
        }
        none => none
    }
}

fn audience_claim(payload: json.Value) -> []str ! io.Error {
    var out: []str = []
    match json.get(payload, "aud") {
        some(v) => match v {
            Str(s) => push(mut out, s)
            Array(items) => {
                for item in items {
                    match item {
                        Str(s) => push(mut out, s)
                        _ => fail Malformed
                    }
                }
            }
            _ => fail Malformed
        }
        none => {}
    }
    out
}

fn claims(payload: json.Value) -> Claims ! io.Error {
    Claims {
        iss: string_claim(payload, "iss")?, sub: string_claim(payload, "sub")?, aud: audience_claim(payload)?,
        exp: date_claim(payload, "exp")?, nbf: date_claim(payload, "nbf")?, iat: date_claim(payload, "iat")?,
        jti: string_claim(payload, "jti")?, extra: payload,
    }
}

/// Verifies a signed JWT and returns its claims.
///
/// The signature is checked with `verify_jws`. The payload must be a JSON object without repeated members. The token is rejected when `exp` is present and the time, less `leeway`, has reached it; when `nbf` is present and the time, plus `leeway`, is before it; when `options.issuer` is set and `iss` differs; or when `options.audience` is set and `aud` does not contain it. A token with no `exp` does not expire. `iat` is parsed but not checked.
///
/// Fails with `Malformed` when the token, payload or a registered claim has the wrong shape, and with `Invalid` when the signature or any check fails.
pub fn verify(token: str, keys: []Jwk, options: Options) -> Claims ! io.Error {
    let payload = verify_jws(token, keys, options.algorithms)?
    let object = unique_object(payload)?
    let c = claims(object)?
    let now = if options.now != 0 { options.now } else { time.now() }
    match c.exp {
        some(exp) => if now - options.leeway >= exp {
            fail Invalid
        }
        none => {}
    }
    match c.nbf {
        some(nbf) => if now + options.leeway < nbf {
            fail Invalid
        }
        none => {}
    }
    if options.issuer.len > 0 && (c.iss ?? "") != options.issuer {
        fail Invalid
    }
    if options.audience.len > 0 {
        var found = false
        for a in c.aud {
            if a == options.audience {
                found = true
            }
        }
        if !found {
            fail Invalid
        }
    }
    c
}
