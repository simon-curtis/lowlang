import std/io
import std/json
import std/time

pub struct Claims {
    pub iss: str?
    pub sub: str?
    pub aud: []str
    pub exp: i64?
    pub nbf: i64?
    pub iat: i64?
    pub jti: str?
    pub extra: json.Value
}

pub struct Options {
    pub algorithms: []str
    pub issuer: str = ""
    pub audience: str = ""
    pub leeway: i64 = 60
    pub now: i64 = 0
}

fn string_claim(payload: json.Value, name: str) -> str? ! io.Error {
    match json.get(payload, name) {
        some(v) => match v {
            Str(s) => s
            _ => fail Malformed
        }
        none => none
    }
}

fn date_claim(payload: json.Value, name: str) -> i64? ! io.Error {
    match json.get(payload, name) {
        some(v) => match v {
            Int(n) => n
            Float(x) => {
                if !(x > -9.0e18 && x < 9.0e18) {
                    fail Malformed
                }
                i64(x)
            }
            _ => fail Malformed
        }
        none => none
    }
}

fn audience_claim(payload: json.Value) -> []str ! io.Error {
    var out: []str = []
    match json.get(payload, "aud") {
        some(v) => match v {
            Str(s) => push(mut out, s)
            Array(items) => {
                for item in items {
                    match item {
                        Str(s) => push(mut out, s)
                        _ => fail Malformed
                    }
                }
            }
            _ => fail Malformed
        }
        none => {}
    }
    out
}

fn claims(payload: json.Value) -> Claims ! io.Error {
    Claims {
        iss: string_claim(payload, "iss")?, sub: string_claim(payload, "sub")?, aud: audience_claim(payload)?,
        exp: date_claim(payload, "exp")?, nbf: date_claim(payload, "nbf")?, iat: date_claim(payload, "iat")?,
        jti: string_claim(payload, "jti")?, extra: payload,
    }
}

pub fn verify(token: str, keys: []Jwk, options: Options) -> Claims ! io.Error {
    let payload = verify_jws(token, keys, options.algorithms)?
    let object = unique_object(payload)?
    let c = claims(object)?
    let now = if options.now != 0 { options.now } else { time.now() }
    match c.exp {
        some(exp) => if now - options.leeway >= exp {
            fail Invalid
        }
        none => {}
    }
    match c.nbf {
        some(nbf) => if now + options.leeway < nbf {
            fail Invalid
        }
        none => {}
    }
    if options.issuer.len > 0 && (c.iss ?? "") != options.issuer {
        fail Invalid
    }
    if options.audience.len > 0 {
        var found = false
        for a in c.aud {
            if a == options.audience {
                found = true
            }
        }
        if !found {
            fail Invalid
        }
    }
    c
}
