import std/base32
import std/builder
import std/text

pub enum Kind {
    Totp
    Hotp
}

pub struct Key {
    pub kind: Kind
    pub account: str
    pub issuer: str = ""
    pub secret: []u8
    pub algorithm: Algorithm = Sha1
    pub digits: i64 = 6
    pub period: i64 = 30
    pub counter: i64 = 0
}

fn unreserved(c: u8) -> bool {
    c >= 'A' && c <= 'Z' || c >= 'a' && c <= 'z' || c >= '0' && c <= '9' || c == '-' || c == '.' || c == '_' || c == '~'
}

fn percent_encode(mut out: builder.Builder, s: str) {
    let digits = "0123456789ABCDEF"
    for c in bytes(s) {
        if unreserved(c) {
            builder.write_byte(mut out, c)
        } else {
            builder.write_byte(mut out, '%')
            builder.write_byte(mut out, digits[c >> 4])
            builder.write_byte(mut out, digits[c & 0x0F])
        }
    }
}

fn hex_value(c: u8) -> i64 {
    if c >= '0' && c <= '9' {
        return i64(c - '0')
    }
    if c >= 'a' && c <= 'f' {
        return i64(c - 'a') + 10
    }
    if c >= 'A' && c <= 'F' {
        return i64(c - 'A') + 10
    }
    -1
}

fn percent_decode(s: str) -> str ! Error {
    var out: []u8 = []
    var i = 0
    for i < s.len {
        if s[i] != '%' {
            push(mut out, s[i])
            i += 1
            continue
        }
        if i + 2 >= s.len {
            fail BadUri
        }
        let high = hex_value(s[i + 1])
        let low = hex_value(s[i + 2])
        if high < 0 || low < 0 {
            fail BadUri
        }
        push(mut out, u8(high << 4 | low))
        i += 3
    }
    __str_view(out)
}

fn algorithm_name(algorithm: Algorithm) -> str {
    match algorithm {
        Sha1 => "SHA1"
        Sha256 => "SHA256"
        Sha512 => "SHA512"
    }
}

pub fn uri(key: Key) -> str {
    var out = builder.builder()
    builder.write(mut out, "otpauth://")
    builder.write(mut out, if key.kind == Kind.Totp { "totp/" } else { "hotp/" })
    if key.issuer.len > 0 {
        percent_encode(mut out, key.issuer)
        builder.write_byte(mut out, ':')
    }
    percent_encode(mut out, key.account)
    builder.write(mut out, "?secret=")
    builder.write(mut out, base32.encode_unpadded(key.secret))
    if key.issuer.len > 0 {
        builder.write(mut out, "&issuer=")
        percent_encode(mut out, key.issuer)
    }
    builder.write(mut out, "&algorithm=")
    builder.write(mut out, algorithm_name(key.algorithm))
    builder.write(mut out, "&digits=")
    builder.write_i64(mut out, key.digits)
    if key.kind == Kind.Totp {
        builder.write(mut out, "&period=")
        builder.write_i64(mut out, key.period)
    } else {
        builder.write(mut out, "&counter=")
        builder.write_i64(mut out, key.counter)
    }
    builder.to_str(out)
}

fn split_label(label: str) -> text.Cut {
    for separator in [":", "%3A", "%3a"] {
        let parts = text.cut(label, separator)
        if parts.found {
            return parts
        }
    }
    text.Cut { before: label, after: "", found: false }
}

fn parse_algorithm(value: str) -> Algorithm ! Error {
    let name = text.upper(value)
    if name == "SHA1" {
        return Sha1
    }
    if name == "SHA256" {
        return Sha256
    }
    if name == "SHA512" {
        return Sha512
    }
    fail BadAlgorithm
}

fn parse_kind(name: str) -> Kind ! Error {
    if name == "totp" {
        return Kind.Totp
    }
    if name == "hotp" {
        return Kind.Hotp
    }
    fail BadUri
}

fn apply(mut key: Key, name: str, value: str) ! Error {
    if name == "secret" {
        key.secret = secret_from_base32(value)?
    } else if name == "issuer" {
        key.issuer = value
    } else if name == "algorithm" {
        key.algorithm = parse_algorithm(value)?
    } else if name == "digits" {
        key.digits = text.parse_int(value) catch { _ => fail BadDigits }
    } else if name == "period" {
        key.period = text.parse_int(value) catch { _ => fail BadPeriod }
    } else if name == "counter" {
        key.counter = text.parse_int(value) catch { _ => fail BadUri }
    }
}

pub fn parse_uri(source: str) -> Key ! Error {
    let rest = text.strip_prefix(source, "otpauth://") ?? fail BadUri
    let query = text.cut(rest, "?")
    let target = text.cut(query.before, "/")
    let kind = parse_kind(target.before)?
    let parts = split_label(target.after)
    let head = percent_decode(parts.before)?
    let tail = percent_decode(parts.after)?
    var key = Key { kind, account: text.trim(head), secret: [] }
    if parts.found {
        key.issuer = text.trim(head)
        key.account = text.trim(tail)
    }
    var has_secret = false
    var has_counter = false
    for pair in text.split(query.after, '&') {
        let entry = text.cut(pair, "=")
        if !entry.found {
            continue
        }
        let name = percent_decode(entry.before)?
        let value = percent_decode(entry.after)?
        apply(mut key, name, value)?
        has_secret = has_secret || name == "secret"
        has_counter = has_counter || name == "counter"
    }
    if !has_secret {
        fail BadSecret
    }
    if key.kind == Kind.Hotp && !has_counter {
        fail BadUri
    }
    check_digits(key.digits)?
    if key.period <= 0 {
        fail BadPeriod
    }
    key
}
