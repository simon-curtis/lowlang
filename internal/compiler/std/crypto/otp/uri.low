import std/base32
import std/builder
import std/text
import percent = std/uri

/// The counter scheme of a key URI.
pub enum Kind {
    /// Time-based codes (RFC 6238) that advance every `period` seconds.
    Totp
    /// Counter-based codes (RFC 4226) that advance on each use.
    Hotp
}

/// The parameters of an authenticator key, as carried by an `otpauth://` URI.
///
/// `uri` writes one and `parse_uri` reads one, following the Google Authenticator Key URI format.
pub struct Key {
    /// Whether the key is time-based or counter-based.
    pub kind: Kind
    /// The account the key belongs to, such as an email address.
    pub account: str
    /// The service that issued the key, or the empty string when there is none.
    pub issuer: str = ""
    /// The shared secret as raw bytes.
    pub secret: []u8
    /// The HMAC hash function. Defaults to `Sha1`.
    pub algorithm: Algorithm = Sha1
    /// The number of digits in a code. Defaults to `6`.
    pub digits: i64 = 6
    /// The seconds each code is valid, used by `Totp` keys. Defaults to `30`.
    pub period: i64 = 30
    /// The initial counter, used by `Hotp` keys. Defaults to `0`.
    pub counter: i64 = 0
}

fn algorithm_name(algorithm: Algorithm) -> str {
    match algorithm {
        Sha1 => "SHA1"
        Sha256 => "SHA256"
        Sha512 => "SHA512"
    }
}

/// Returns the `otpauth://` URI for `key`, suitable for a QR code.
///
/// The label is `issuer:account` (or the account alone when the issuer is empty), percent-encoded, followed by the `secret` (unpadded Base32), `issuer`, `algorithm`, `digits` and either `period` for a `Totp` key or `counter` for a `Hotp` key.
pub fn uri(key: Key) -> str {
    var out = builder.builder()
    builder.write(mut out, "otpauth://")
    builder.write(mut out, if key.kind == Kind.Totp { "totp/" } else { "hotp/" })
    if key.issuer.len > 0 {
        builder.write(mut out, percent.escape(key.issuer))
        builder.write_byte(mut out, ':')
    }
    builder.write(mut out, percent.escape(key.account))
    builder.write(mut out, "?secret=")
    builder.write(mut out, base32.encode_unpadded(key.secret))
    if key.issuer.len > 0 {
        builder.write(mut out, "&issuer=")
        builder.write(mut out, percent.escape(key.issuer))
    }
    builder.write(mut out, "&algorithm=")
    builder.write(mut out, algorithm_name(key.algorithm))
    builder.write(mut out, "&digits=")
    builder.write_i64(mut out, key.digits)
    if key.kind == Kind.Totp {
        builder.write(mut out, "&period=")
        builder.write_i64(mut out, key.period)
    } else {
        builder.write(mut out, "&counter=")
        builder.write_i64(mut out, key.counter)
    }
    builder.to_str(out)
}

fn split_label(label: str) -> text.Cut {
    for separator in [":", "%3A", "%3a"] {
        let parts = text.cut(label, separator)
        if parts.found {
            return parts
        }
    }
    text.Cut { before: label, after: "", found: false }
}

fn parse_algorithm(value: str) -> Algorithm ! Error {
    let name = text.upper(value)
    if name == "SHA1" {
        return Sha1
    }
    if name == "SHA256" {
        return Sha256
    }
    if name == "SHA512" {
        return Sha512
    }
    fail BadAlgorithm
}

fn parse_kind(name: str) -> Kind ! Error {
    if name == "totp" {
        return Kind.Totp
    }
    if name == "hotp" {
        return Kind.Hotp
    }
    fail BadUri
}

fn apply(mut key: Key, name: str, value: str) ! Error {
    if name == "secret" {
        key.secret = secret_from_base32(value)?
    } else if name == "issuer" {
        key.issuer = value
    } else if name == "algorithm" {
        key.algorithm = parse_algorithm(value)?
    } else if name == "digits" {
        key.digits = text.parse_int(value) or fail BadDigits
    } else if name == "period" {
        key.period = text.parse_int(value) or fail BadPeriod
    } else if name == "counter" {
        key.counter = text.parse_int(value) or fail BadUri
    }
}

/// Parses an `otpauth://` URI into a `Key`.
///
/// The issuer is taken from the label prefix; the label separator may be `:` or its percent-encoded form. An `issuer` query parameter overrides the label prefix. Parameters other than `secret`, `issuer`, `algorithm`, `digits`, `period` and `counter` are ignored, and fields not given keep the defaults of `Key`.
///
/// Fails with `BadUri` when the scheme or type is not recognised, the percent-encoding is invalid or an `hotp` URI has no `counter`. Fails with `BadSecret` when `secret` is missing or not Base32, `BadAlgorithm` for an unknown algorithm, `BadDigits` when `digits` is not a number in `6..=8` and `BadPeriod` when `period` is not a positive number.
pub fn parse_uri(source: str) -> Key ! Error {
    let rest = text.strip_prefix(source, "otpauth://") ?? fail BadUri
    let query = text.cut(rest, "?")
    let target = text.cut(query.before, "/")
    let kind = parse_kind(target.before)?
    let parts = split_label(target.after)
    let head = percent.unescape(parts.before) ?? fail BadUri
    let tail = percent.unescape(parts.after) ?? fail BadUri
    var key = Key { kind, account: text.trim(head), secret: [] }
    if parts.found {
        key.issuer = text.trim(head)
        key.account = text.trim(tail)
    }
    var has_secret = false
    var has_counter = false
    for pair in text.split(query.after, '&') {
        let entry = text.cut(pair, "=")
        if !entry.found {
            continue
        }
        let name = percent.unescape(entry.before) ?? fail BadUri
        let value = percent.unescape(entry.after) ?? fail BadUri
        apply(mut key, name, value)?
        has_secret = has_secret || name == "secret"
        has_counter = has_counter || name == "counter"
    }
    if !has_secret {
        fail BadSecret
    }
    if key.kind == Kind.Hotp && !has_counter {
        fail BadUri
    }
    check_digits(key.digits)?
    if key.period <= 0 {
        fail BadPeriod
    }
    key
}
