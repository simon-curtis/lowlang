import std/base32
import std/crypto
import std/crypto/hash

pub enum Algorithm {
    Sha1
    Sha256
    Sha512
}

pub enum Error {
    BadDigits
    BadPeriod
    BadTime
    BadSecret
    BadAlgorithm
    BadUri
}

fn copy_bytes(src: []u8) -> []u8 {
    var out: []u8 = []
    for b in src {
        push(mut out, b)
    }
    out
}

fn sha1_digest(held: []u8) -> hash.Digest {
    var pending = held
    hash.Digest {
        update: fn(data) {
            for b in data {
                push(mut pending, b)
            }
        }
        finish: fn() -> []u8 { crypto.sha1(pending) }
        clone: fn() -> hash.Digest { sha1_digest(copy_bytes(pending)) }
    }
}

fn sha1_new() -> hash.Digest {
    sha1_digest([])
}

fn sha1() -> hash.Algorithm {
    hash.Algorithm { name: "sha1", size: 20, block: 64, digest: sha1_new }
}

fn hash_of(algorithm: Algorithm) -> hash.Algorithm {
    match algorithm {
        Sha1 => sha1()
        Sha256 => hash.sha256()
        Sha512 => hash.sha512()
    }
}

fn check_digits(digits: i64) ! Error {
    if digits < 6 || digits > 8 {
        fail BadDigits
    }
}

fn counter_bytes(counter: i64) -> []u8 {
    let out: []u8 = __make(8)
    for i in 0..8 {
        out[i] = u8(u64(counter) >> u64(56 - 8 * i))
    }
    out
}

fn power_of_ten(digits: i64) -> u32 {
    var out: u32 = 1
    for _ in 0..digits {
        out *= 10
    }
    out
}

fn pad(value: u32, digits: i64) -> str {
    let out: []u8 = __make(digits)
    var rest = value
    var i = digits - 1
    for i >= 0 {
        out[i] = u8('0') + u8(rest % 10)
        rest /= 10
        i -= 1
    }
    __str_view(out)
}

pub fn hotp(secret: []u8, counter: i64, digits: i64, algorithm: Algorithm) -> str ! Error {
    check_digits(digits)?
    let mac = hash.hmac(hash_of(algorithm), secret, counter_bytes(counter))
    let offset = i64(mac[mac.len - 1] & 0x0F)
    let truncated = u32(mac[offset] & 0x7F) << 24 | u32(mac[offset + 1]) << 16 | u32(mac[offset + 2]) << 8 | u32(mac[offset + 3])
    pad(truncated % power_of_ten(digits), digits)
}

fn time_step(time: i64, period: i64) -> i64 ! Error {
    if period <= 0 {
        fail BadPeriod
    }
    if time < 0 {
        fail BadTime
    }
    time / period
}

pub fn totp(secret: []u8, time: i64, period: i64, digits: i64, algorithm: Algorithm) -> str ! Error {
    let step = time_step(time, period)?
    hotp(secret, step, digits, algorithm)?
}

fn same_code(expected: str, given: str) -> bool {
    hash.equal(bytes(expected), bytes(given))
}

pub fn verify_hotp(secret: []u8, code: str, counter: i64, window: i64, digits: i64, algorithm: Algorithm) -> i64? ! Error {
    check_digits(digits)?
    var found = -1
    for offset in 0..window + 1 {
        let expected = hotp(secret, counter + offset, digits, algorithm)?
        if same_code(expected, code) && found < 0 {
            found = counter + offset + 1
        }
    }
    if found < 0 {
        return none
    }
    found
}

pub fn verify_totp(secret: []u8, code: str, time: i64, period: i64, digits: i64, algorithm: Algorithm, window: i64) -> bool ! Error {
    let step = time_step(time, period)?
    check_digits(digits)?
    var matched = false
    for offset in 0 - window..window + 1 {
        if step + offset < 0 {
            continue
        }
        let expected = hotp(secret, step + offset, digits, algorithm)?
        if same_code(expected, code) {
            matched = true
        }
    }
    matched
}

pub fn generate_secret(length: i64) -> []u8 {
    crypto.random(length)
}

pub fn secret_to_base32(secret: []u8) -> str {
    base32.encode_unpadded(secret)
}

pub fn secret_from_base32(text: str) -> []u8 ! Error {
    var cleaned: []u8 = []
    for c in bytes(text) {
        if c != ' ' && c != '-' {
            push(mut cleaned, c)
        }
    }
    base32.decode(__str_view(cleaned)) catch { _ => fail BadSecret }
}
