struct State32 {
    h: []u32
    w: []u32
    k: []u32
    buf: []u8
    total: i64
    size: i64
}

struct State64 {
    h: []u64
    w: []u64
    k: []u64
    buf: []u8
    total: i64
    size: i64
}

fn k256() -> []u32 {
    [
        0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
        0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
        0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
        0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
        0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
        0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
        0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
        0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
    ]
}

fn k512() -> []u64 {
    [
        0x428a2f98d728ae22, 0x7137449123ef65cd, 0xb5c0fbcfec4d3b2f, 0xe9b5dba58189dbbc, 0x3956c25bf348b538,
        0x59f111f1b605d019, 0x923f82a4af194f9b, 0xab1c5ed5da6d8118, 0xd807aa98a3030242, 0x12835b0145706fbe,
        0x243185be4ee4b28c, 0x550c7dc3d5ffb4e2, 0x72be5d74f27b896f, 0x80deb1fe3b1696b1, 0x9bdc06a725c71235,
        0xc19bf174cf692694, 0xe49b69c19ef14ad2, 0xefbe4786384f25e3, 0x0fc19dc68b8cd5b5, 0x240ca1cc77ac9c65,
        0x2de92c6f592b0275, 0x4a7484aa6ea6e483, 0x5cb0a9dcbd41fbd4, 0x76f988da831153b5, 0x983e5152ee66dfab,
        0xa831c66d2db43210, 0xb00327c898fb213f, 0xbf597fc7beef0ee4, 0xc6e00bf33da88fc2, 0xd5a79147930aa725,
        0x06ca6351e003826f, 0x142929670a0e6e70, 0x27b70a8546d22ffc, 0x2e1b21385c26c926, 0x4d2c6dfc5ac42aed,
        0x53380d139d95b3df, 0x650a73548baf63de, 0x766a0abb3c77b2a8, 0x81c2c92e47edaee6, 0x92722c851482353b,
        0xa2bfe8a14cf10364, 0xa81a664bbc423001, 0xc24b8b70d0f89791, 0xc76c51a30654be30, 0xd192e819d6ef5218,
        0xd69906245565a910, 0xf40e35855771202a, 0x106aa07032bbd1b8, 0x19a4c116b8d2d0c8, 0x1e376c085141ab53,
        0x2748774cdf8eeb99, 0x34b0bcb5e19b48a8, 0x391c0cb3c5c95a63, 0x4ed8aa4ae3418acb, 0x5b9cca4f7763e373,
        0x682e6ff3d6b2b8a3, 0x748f82ee5defb2fc, 0x78a5636f43172f60, 0x84c87814a1f0ab72, 0x8cc702081a6439ec,
        0x90befffa23631e28, 0xa4506cebde82bde9, 0xbef9a3f7b2c67915, 0xc67178f2e372532b, 0xca273eceea26619c,
        0xd186b8c721c0c207, 0xeada7dd6cde0eb1e, 0xf57d4f7fee6ed178, 0x06f067aa72176fba, 0x0a637dc5a2c898a6,
        0x113f9804bef90dae, 0x1b710b35131c471b, 0x28db77f523047d84, 0x32caab7b40c72493, 0x3c9ebe0a15c9bebc,
        0x431d67c49c100d4c, 0x4cc5d4becb3e42b6, 0x597f299cfc657e2a, 0x5fcb6fab3ad6faec, 0x6c44198c4a475817,
    ]
}

fn rotr32(x: u32, n: i64) -> u32 {
    x >> n | x << (32 - n)
}

fn rotr64(x: u64, n: i64) -> u64 {
    x >> n | x << (64 - n)
}

fn block32(s: *State32, data: []u8, at: i64) {
    let w = s.w
    let k = s.k
    for t in 0..16 {
        let i = at + 4 * t
        w[t] = u32(data[i]) << 24 | u32(data[i + 1]) << 16 | u32(data[i + 2]) << 8 | u32(data[i + 3])
    }
    for t in 16..64 {
        let s0 = rotr32(w[t - 15], 7) ^ rotr32(w[t - 15], 18) ^ w[t - 15] >> 3
        let s1 = rotr32(w[t - 2], 17) ^ rotr32(w[t - 2], 19) ^ w[t - 2] >> 10
        w[t] = w[t - 16] + s0 + w[t - 7] + s1
    }
    let h = s.h
    var a = h[0]
    var b = h[1]
    var c = h[2]
    var d = h[3]
    var e = h[4]
    var f = h[5]
    var g = h[6]
    var hh = h[7]
    for t in 0..64 {
        let s1 = rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25)
        let ch = e & f ^ ~e & g
        let t1 = hh + s1 + ch + k[t] + w[t]
        let s0 = rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22)
        let maj = a & b ^ a & c ^ b & c
        let t2 = s0 + maj
        hh = g
        g = f
        f = e
        e = d + t1
        d = c
        c = b
        b = a
        a = t1 + t2
    }
    h[0] += a
    h[1] += b
    h[2] += c
    h[3] += d
    h[4] += e
    h[5] += f
    h[6] += g
    h[7] += hh
}

fn block64(s: *State64, data: []u8, at: i64) {
    let w = s.w
    let k = s.k
    for t in 0..16 {
        var v: u64 = 0
        for j in 0..8 {
            v = v << 8 | u64(data[at + 8 * t + j])
        }
        w[t] = v
    }
    for t in 16..80 {
        let s0 = rotr64(w[t - 15], 1) ^ rotr64(w[t - 15], 8) ^ w[t - 15] >> 7
        let s1 = rotr64(w[t - 2], 19) ^ rotr64(w[t - 2], 61) ^ w[t - 2] >> 6
        w[t] = w[t - 16] + s0 + w[t - 7] + s1
    }
    let h = s.h
    var a = h[0]
    var b = h[1]
    var c = h[2]
    var d = h[3]
    var e = h[4]
    var f = h[5]
    var g = h[6]
    var hh = h[7]
    for t in 0..80 {
        let s1 = rotr64(e, 14) ^ rotr64(e, 18) ^ rotr64(e, 41)
        let ch = e & f ^ ~e & g
        let t1 = hh + s1 + ch + k[t] + w[t]
        let s0 = rotr64(a, 28) ^ rotr64(a, 34) ^ rotr64(a, 39)
        let maj = a & b ^ a & c ^ b & c
        let t2 = s0 + maj
        hh = g
        g = f
        f = e
        e = d + t1
        d = c
        c = b
        b = a
        a = t1 + t2
    }
    h[0] += a
    h[1] += b
    h[2] += c
    h[3] += d
    h[4] += e
    h[5] += f
    h[6] += g
    h[7] += hh
}

fn update32(s: *State32, data: []u8) {
    s.total += data.len
    var at = 0
    if s.buf.len > 0 {
        let room = 64 - s.buf.len
        at = if data.len < room { data.len } else { room }
        __extend(mut s.buf, __str_view(data[..at]))
        if s.buf.len < 64 {
            return
        }
        block32(s, s.buf, 0)
        s.buf = []
    }
    for at + 64 <= data.len {
        block32(s, data, at)
        at += 64
    }
    __extend(mut s.buf, __str_view(data[at..]))
}

fn update64(s: *State64, data: []u8) {
    s.total += data.len
    var at = 0
    if s.buf.len > 0 {
        let room = 128 - s.buf.len
        at = if data.len < room { data.len } else { room }
        __extend(mut s.buf, __str_view(data[..at]))
        if s.buf.len < 128 {
            return
        }
        block64(s, s.buf, 0)
        s.buf = []
    }
    for at + 128 <= data.len {
        block64(s, data, at)
        at += 128
    }
    __extend(mut s.buf, __str_view(data[at..]))
}

fn copy32(s: *State32) -> *State32 {
    var h: []u32 = []
    for x in s.h {
        push(mut h, x)
    }
    var buf: []u8 = []
    __extend(mut buf, __str_view(s.buf))
    new(State32 { h, w: __make(64), k: s.k, buf, total: s.total, size: s.size })
}

fn copy64(s: *State64) -> *State64 {
    var h: []u64 = []
    for x in s.h {
        push(mut h, x)
    }
    var buf: []u8 = []
    __extend(mut buf, __str_view(s.buf))
    new(State64 { h, w: __make(80), k: s.k, buf, total: s.total, size: s.size })
}

fn finish32(s: *State32) -> []u8 {
    let c = copy32(s)
    let bits = c.total * 8
    var pad: []u8 = [0x80]
    for (c.total + pad.len) % 64 != 56 {
        push(mut pad, 0)
    }
    var shift = 56
    for shift >= 0 {
        push(mut pad, u8(bits >> shift))
        shift -= 8
    }
    update32(c, pad)
    var out: []u8 = []
    for i in 0..c.size / 4 {
        let x = c.h[i]
        push(mut out, u8(x >> 24))
        push(mut out, u8(x >> 16))
        push(mut out, u8(x >> 8))
        push(mut out, u8(x))
    }
    out
}

fn finish64(s: *State64) -> []u8 {
    let c = copy64(s)
    let bits = c.total * 8
    var pad: []u8 = [0x80]
    for (c.total + pad.len) % 128 != 112 {
        push(mut pad, 0)
    }
    for _ in 0..8 {
        push(mut pad, 0)
    }
    var shift = 56
    for shift >= 0 {
        push(mut pad, u8(bits >> shift))
        shift -= 8
    }
    update64(c, pad)
    var out: []u8 = []
    for i in 0..c.size / 8 {
        let x = c.h[i]
        var shift_out = 56
        for shift_out >= 0 {
            push(mut out, u8(x >> shift_out))
            shift_out -= 8
        }
    }
    out
}

fn digest32(s: *State32) -> Digest {
    Digest {
        update: fn(data) { update32(s, data) }
        finish: fn() { finish32(s) }
        clone: fn() { digest32(copy32(s)) }
    }
}

fn digest64(s: *State64) -> Digest {
    Digest {
        update: fn(data) { update64(s, data) }
        finish: fn() { finish64(s) }
        clone: fn() { digest64(copy64(s)) }
    }
}

fn new256() -> Digest {
    let h: []u32 = [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19]
    digest32(new(State32 { h, w: __make(64), k: k256(), buf: [], total: 0, size: 32 }))
}

fn new384() -> Digest {
    let h: []u64 = [
        0xcbbb9d5dc1059ed8, 0x629a292a367cd507, 0x9159015a3070dd17, 0x152fecd8f70e5939,
        0x67332667ffc00b31, 0x8eb44a8768581511, 0xdb0c2e0d64f98fa7, 0x47b5481dbefa4fa4,
    ]
    digest64(new(State64 { h, w: __make(80), k: k512(), buf: [], total: 0, size: 48 }))
}

fn new512() -> Digest {
    let h: []u64 = [
        0x6a09e667f3bcc908, 0xbb67ae8584caa73b, 0x3c6ef372fe94f82b, 0xa54ff53a5f1d36f1,
        0x510e527fade682d1, 0x9b05688c2b3e6c1f, 0x1f83d9abfb41bd6b, 0x5be0cd19137e2179,
    ]
    digest64(new(State64 { h, w: __make(80), k: k512(), buf: [], total: 0, size: 64 }))
}

/// Returns the `Algorithm` for SHA-256 (FIPS 180-4). The name is `sha256`, the digest is 32 bytes and the block size is 64 bytes.
pub fn sha256() -> Algorithm {
    Algorithm { name: "sha256", size: 32, block: 64, digest: new256 }
}

/// Returns the `Algorithm` for SHA-384 (FIPS 180-4). The name is `sha384`, the digest is 48 bytes and the block size is 128 bytes.
pub fn sha384() -> Algorithm {
    Algorithm { name: "sha384", size: 48, block: 128, digest: new384 }
}

/// Returns the `Algorithm` for SHA-512 (FIPS 180-4). The name is `sha512`, the digest is 64 bytes and the block size is 128 bytes.
pub fn sha512() -> Algorithm {
    Algorithm { name: "sha512", size: 64, block: 128, digest: new512 }
}
