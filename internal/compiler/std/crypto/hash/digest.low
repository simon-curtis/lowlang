/// A running hash computation, a copyable struct of closures over the hash state.
pub struct Digest {
    /// Feeds bytes into the hash.
    pub update: fn([]u8)
    /// Returns the digest of the bytes fed so far. The state is not consumed, so more bytes can be fed afterwards.
    pub finish: fn() -> []u8
    /// Returns an independent `Digest` with the same state.
    pub clone: fn() -> Digest
}

/// A hash function: its name, sizes and a constructor for running computations.
pub struct Algorithm {
    /// The lowercase name of the algorithm, such as `sha256`.
    pub name: str
    /// The digest length in bytes.
    pub size: i64
    /// The internal block length in bytes that HMAC pads the key to. For SHA-3 it is the sponge rate.
    pub block: i64
    /// Starts a new `Digest` with empty input.
    pub digest: fn() -> Digest
}

/// Returns the digest of `data` under the algorithm `a`, `a.size` bytes long.
pub fn sum(a: Algorithm, data: []u8) -> []u8 {
    let d = a.digest()
    d.update(data)
    d.finish()
}

/// Computes the HMAC of `message` under `key` with the hash `a` (RFC 2104, FIPS 198-1).
///
/// Returns `a.size` bytes. A `key` longer than `a.block` is hashed first and a shorter one is padded with zeros. Any key length is accepted, including empty.
pub fn hmac(a: Algorithm, key: []u8, message: []u8) -> []u8 {
    var k = key
    if k.len > a.block {
        k = sum(a, key)
    }
    let inner: []u8 = __make(a.block)
    let outer: []u8 = __make(a.block)
    for i in 0..a.block {
        let b = if i < k.len { k[i] } else { 0 }
        inner[i] = b ^ 0x36
        outer[i] = b ^ 0x5C
    }
    let d = a.digest()
    d.update(inner)
    d.update(message)
    let first = d.finish()
    let o = a.digest()
    o.update(outer)
    o.update(first)
    o.finish()
}

/// Computes HKDF-Extract (RFC 5869 section 2.2) over the input keying material `ikm`.
///
/// Returns the `a.size`-byte pseudorandom key. An empty `salt` is replaced by `a.size` zero bytes.
pub fn hkdf_extract(a: Algorithm, salt: []u8, ikm: []u8) -> []u8 {
    if salt.len == 0 {
        let zeros: []u8 = __make(a.size)
        return hmac(a, zeros, ikm)
    }
    hmac(a, salt, ikm)
}

/// Computes HKDF-Expand (RFC 5869 section 2.3) from the pseudorandom key `prk` and context `info`.
///
/// Returns `length` bytes. `length` must not exceed `255 * a.size` because the block counter is one byte; this is not checked. A `length` of 0 or less returns an empty slice.
pub fn hkdf_expand(a: Algorithm, prk: []u8, info: []u8, length: i64) -> []u8 {
    var out: []u8 = []
    var previous: []u8 = []
    var counter = 1
    for out.len < length {
        var block: []u8 = []
        __extend(mut block, __str_view(previous))
        __extend(mut block, __str_view(info))
        push(mut block, u8(counter))
        previous = hmac(a, prk, block)
        let room = length - out.len
        let take = if previous.len < room { previous.len } else { room }
        __extend(mut out, __str_view(previous[..take]))
        counter += 1
    }
    out
}

/// Returns whether `a` and `b` hold the same bytes.
///
/// Slices of different lengths are unequal and return at once. For equal lengths the running time does not depend on the contents, so the call is suitable for comparing MACs and tags.
pub fn equal(a: []u8, b: []u8) -> bool {
    if a.len != b.len {
        return false
    }
    var diff: u8 = 0
    for i in 0..a.len {
        diff |= a[i] ^ b[i]
    }
    diff == 0
}
