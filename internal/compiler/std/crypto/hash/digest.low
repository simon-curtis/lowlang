pub struct Digest {
    pub update: fn([]u8)
    pub finish: fn() -> []u8
    pub clone: fn() -> Digest
}

pub struct Algorithm {
    pub name: str
    pub size: i64
    pub block: i64
    pub digest: fn() -> Digest
}

pub fn sum(a: Algorithm, data: []u8) -> []u8 {
    let d = a.digest()
    d.update(data)
    d.finish()
}

pub fn hmac(a: Algorithm, key: []u8, message: []u8) -> []u8 {
    var k = key
    if k.len > a.block {
        k = sum(a, key)
    }
    let inner: []u8 = __make(a.block)
    let outer: []u8 = __make(a.block)
    for i in 0..a.block {
        let b = if i < k.len { k[i] } else { 0 }
        inner[i] = b ^ 0x36
        outer[i] = b ^ 0x5C
    }
    let d = a.digest()
    d.update(inner)
    d.update(message)
    let first = d.finish()
    let o = a.digest()
    o.update(outer)
    o.update(first)
    o.finish()
}

pub fn hkdf_extract(a: Algorithm, salt: []u8, ikm: []u8) -> []u8 {
    if salt.len == 0 {
        let zeros: []u8 = __make(a.size)
        return hmac(a, zeros, ikm)
    }
    hmac(a, salt, ikm)
}

pub fn hkdf_expand(a: Algorithm, prk: []u8, info: []u8, length: i64) -> []u8 {
    var out: []u8 = []
    var previous: []u8 = []
    var counter = 1
    for out.len < length {
        var block: []u8 = []
        for b in previous {
            push(mut block, b)
        }
        for b in info {
            push(mut block, b)
        }
        push(mut block, u8(counter))
        previous = hmac(a, prk, block)
        for b in previous {
            if out.len < length {
                push(mut out, b)
            }
        }
        counter += 1
    }
    out
}

pub fn equal(a: []u8, b: []u8) -> bool {
    if a.len != b.len {
        return false
    }
    var diff: u8 = 0
    for i in 0..a.len {
        diff |= a[i] ^ b[i]
    }
    diff == 0
}
