struct Sha1State {
    h: []u32
    w: []u32
    buf: []u8
    total: i64
}

fn sha1_rotl(x: u32, n: i64) -> u32 {
    x << n | x >> (32 - n)
}

fn sha1_block(s: *Sha1State, data: []u8, at: i64) {
    let w = s.w
    for t in 0..16 {
        let i = at + 4 * t
        w[t] = u32(data[i]) << 24 | u32(data[i + 1]) << 16 | u32(data[i + 2]) << 8 | u32(data[i + 3])
    }
    for t in 16..80 {
        w[t] = sha1_rotl(w[t - 3] ^ w[t - 8] ^ w[t - 14] ^ w[t - 16], 1)
    }
    let h = s.h
    var a = h[0]
    var b = h[1]
    var c = h[2]
    var d = h[3]
    var e = h[4]
    for t in 0..80 {
        var f: u32 = 0
        var k: u32 = 0
        if t < 20 {
            f = b & c | ~b & d
            k = 0x5A827999
        } else if t < 40 {
            f = b ^ c ^ d
            k = 0x6ED9EBA1
        } else if t < 60 {
            f = b & c | b & d | c & d
            k = 0x8F1BBCDC
        } else {
            f = b ^ c ^ d
            k = 0xCA62C1D6
        }
        let next = sha1_rotl(a, 5) + f + e + k + w[t]
        e = d
        d = c
        c = sha1_rotl(b, 30)
        b = a
        a = next
    }
    h[0] += a
    h[1] += b
    h[2] += c
    h[3] += d
    h[4] += e
}

fn sha1_update(s: *Sha1State, data: []u8) {
    s.total += data.len
    var at = 0
    if s.buf.len > 0 {
        let room = 64 - s.buf.len
        at = if data.len < room { data.len } else { room }
        __extend(mut s.buf, __str_view(data[..at]))
        if s.buf.len < 64 {
            return
        }
        sha1_block(s, s.buf, 0)
        s.buf = []
    }
    for at + 64 <= data.len {
        sha1_block(s, data, at)
        at += 64
    }
    __extend(mut s.buf, __str_view(data[at..]))
}

fn sha1_copy(s: *Sha1State) -> *Sha1State {
    var h: []u32 = []
    for x in s.h {
        push(mut h, x)
    }
    var buf: []u8 = []
    __extend(mut buf, __str_view(s.buf))
    new(Sha1State { h, w: __make(80), buf, total: s.total })
}

fn sha1_finish(s: *Sha1State) -> []u8 {
    let c = sha1_copy(s)
    let bits = c.total * 8
    var pad: []u8 = [0x80]
    for (c.total + pad.len) % 64 != 56 {
        push(mut pad, 0)
    }
    var shift = 56
    for shift >= 0 {
        push(mut pad, u8(bits >> shift))
        shift -= 8
    }
    sha1_update(c, pad)
    var out: []u8 = []
    for x in c.h {
        push(mut out, u8(x >> 24))
        push(mut out, u8(x >> 16))
        push(mut out, u8(x >> 8))
        push(mut out, u8(x))
    }
    out
}

fn sha1_digest(s: *Sha1State) -> Digest {
    Digest {
        update: fn(data) { sha1_update(s, data) }
        finish: fn() { sha1_finish(s) }
        clone: fn() { sha1_digest(sha1_copy(s)) }
    }
}

fn sha1_new() -> Digest {
    let h: []u32 = [0x67452301, 0xEFCDAB89, 0x98BADCFE, 0x10325476, 0xC3D2E1F0]
    sha1_digest(new(Sha1State { h, w: __make(80), buf: [], total: 0 }))
}

/// Returns the `Algorithm` for SHA-1 (FIPS 180-4).
///
/// The name is `sha1`, the digest is 20 bytes and the block size is 64 bytes. SHA-1 is not collision resistant; use it only where a protocol requires it, such as HMAC-SHA-1 or the WebSocket handshake.
pub fn sha1() -> Algorithm {
    Algorithm { name: "sha1", size: 20, block: 64, digest: sha1_new }
}
