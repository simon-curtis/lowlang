fn rotl(x: u32, n: i64) -> u32 {
    x << n | x >> (32 - n)
}

fn word(b: []u8, at: i64) -> u32 {
    u32(b[at]) << 24 | u32(b[at + 1]) << 16 | u32(b[at + 2]) << 8 | u32(b[at + 3])
}

fn put_word(mut out: []u8, w: u32) {
    push(mut out, u8(w >> 24))
    push(mut out, u8(w >> 16))
    push(mut out, u8(w >> 8))
    push(mut out, u8(w))
}

pub fn sha1(data: []u8) -> []u8 {
    var msg: []u8 = []
    __extend(mut msg, __str_view(data))
    push(mut msg, 0x80)
    for msg.len % 64 != 56 {
        push(mut msg, 0)
    }
    let bits = data.len * 8
    var shift = 56
    for shift >= 0 {
        push(mut msg, u8(bits >> shift))
        shift -= 8
    }
    var h: []u32 = [0x67452301, 0xEFCDAB89, 0x98BADCFE, 0x10325476, 0xC3D2E1F0]
    var w: []u32 = []
    for _ in 0..80 {
        push(mut w, 0)
    }
    var block = 0
    for block < msg.len {
        for t in 0..16 {
            w[t] = word(msg, block + 4 * t)
        }
        for t in 16..80 {
            w[t] = rotl(w[t - 3] ^ w[t - 8] ^ w[t - 14] ^ w[t - 16], 1)
        }
        var a = h[0]
        var b = h[1]
        var c = h[2]
        var d = h[3]
        var e = h[4]
        for t in 0..80 {
            var f: u32 = 0
            var k: u32 = 0
            if t < 20 {
                f = b & c | ~b & d
                k = 0x5A827999
            } else if t < 40 {
                f = b ^ c ^ d
                k = 0x6ED9EBA1
            } else if t < 60 {
                f = b & c | b & d | c & d
                k = 0x8F1BBCDC
            } else {
                f = b ^ c ^ d
                k = 0xCA62C1D6
            }
            let next = rotl(a, 5) + f + e + k + w[t]
            e = d
            d = c
            c = rotl(b, 30)
            b = a
            a = next
        }
        h[0] += a
        h[1] += b
        h[2] += c
        h[3] += d
        h[4] += e
        block += 64
    }
    var out: []u8 = []
    for x in h {
        put_word(mut out, x)
    }
    out
}
