import std/crypto/aead

pub enum Error {
    InvalidKey
    InvalidIv
    InvalidLength
    InvalidPadding
}

pub struct Block {
    enc: *aead.Aes
    dec: *aead.AesInverse
}

pub struct Xts {
    data: Block
    tweak: Block
}

pub fn aes(key: []u8) -> *Block ! Error {
    let enc = aead.aes_key(key) catch {
        _ => fail Error.InvalidKey
    }
    new(Block { enc, dec: aead.aes_inverse(enc) })
}

pub fn pkcs7_pad(data: []u8, block_size: i64) -> []u8 {
    let fill = block_size - data.len % block_size
    let out: []u8 = __make(data.len + fill)
    __memmove(out, data)
    for i in data.len..out.len {
        out[i] = u8(fill)
    }
    out
}

pub fn pkcs7_unpad(data: []u8, block_size: i64) -> []u8 ! Error {
    if block_size < 1 || block_size > 255 || data.len == 0 || data.len % block_size != 0 {
        fail Error.InvalidPadding
    }
    let fill = i64(data[data.len - 1])
    var bad: i64 = 0
    if fill < 1 || fill > block_size {
        bad = 1
    }
    for i in 0..block_size {
        let inside = i < fill
        let differs = data[data.len - 1 - i] != u8(fill)
        if inside && differs {
            bad = 1
        }
    }
    if bad != 0 {
        fail Error.InvalidPadding
    }
    data[..data.len - fill]
}

fn xor_into(dst: []u8, at: i64, mask: []u8) {
    for i in 0..16 {
        dst[at + i] ^= mask[i]
    }
}

pub fn cbc_encrypt(b: *Block, iv: []u8, data: []u8) -> []u8 ! Error {
    if iv.len != 16 {
        fail Error.InvalidIv
    }
    if data.len % 16 != 0 {
        fail Error.InvalidLength
    }
    let out: []u8 = __make(data.len)
    let chained: []u8 = __make(16)
    var at = 0
    for at < data.len {
        let previous = if at == 0 { iv } else { out[at - 16..] }
        __memmove(chained, data[at..at + 16])
        xor_into(chained, 0, previous)
        aead.encrypt_block_into(b.enc, chained, 0, out, at)
        at += 16
    }
    out
}

pub fn cbc_decrypt(b: *Block, iv: []u8, data: []u8) -> []u8 ! Error {
    if iv.len != 16 {
        fail Error.InvalidIv
    }
    if data.len % 16 != 0 {
        fail Error.InvalidLength
    }
    let out: []u8 = __make(data.len)
    var at = 0
    for at < data.len {
        let previous = if at == 0 { iv } else { data[at - 16..] }
        aead.decrypt_block_into(b.dec, data, at, out, at)
        xor_into(out, at, previous)
        at += 16
    }
    out
}

pub fn cbc_seal(b: *Block, iv: []u8, plaintext: []u8) -> []u8 ! Error {
    cbc_encrypt(b, iv, pkcs7_pad(plaintext, 16))?
}

pub fn cbc_open(b: *Block, iv: []u8, ciphertext: []u8) -> []u8 ! Error {
    if ciphertext.len == 0 {
        fail Error.InvalidLength
    }
    let padded = cbc_decrypt(b, iv, ciphertext)?
    pkcs7_unpad(padded, 16)?
}

fn increment(counter: []u8) {
    var i = 15
    for i >= 0 {
        counter[i] += 1
        if counter[i] != 0 {
            return
        }
        i -= 1
    }
}

pub fn ctr(b: *Block, iv: []u8, data: []u8) -> []u8 ! Error {
    if iv.len != 16 {
        fail Error.InvalidIv
    }
    let out: []u8 = __make(data.len)
    let counter: []u8 = __make(16)
    __memmove(counter, iv)
    let stream: []u8 = __make(16)
    var at = 0
    for at < data.len {
        aead.encrypt_block_into(b.enc, counter, 0, stream, 0)
        let n = if data.len - at < 16 { data.len - at } else { 16 }
        for i in 0..n {
            out[at + i] = data[at + i] ^ stream[i]
        }
        increment(counter)
        at += 16
    }
    out
}

pub fn xts(key: []u8) -> *Xts ! Error {
    if key.len != 32 && key.len != 64 {
        fail Error.InvalidKey
    }
    let half = key.len / 2
    let data = aes(key[..half])?
    let tweak = aes(key[half..])?
    new(Xts { data: *data, tweak: *tweak })
}

fn double_tweak(t: []u8) {
    var carry: u8 = 0
    for i in 0..16 {
        let next = t[i] >> 7
        t[i] = t[i] << 1 | carry
        carry = next
    }
    if carry != 0 {
        t[0] ^= 0x87
    }
}

fn xts_block(encrypt: bool, x: *Xts, tweak: []u8, src: []u8, from: i64, dst: []u8, to: i64) {
    let masked: []u8 = __make(16)
    __memmove(masked, src[from..from + 16])
    xor_into(masked, 0, tweak)
    if encrypt {
        aead.encrypt_block_into(x.data.enc, masked, 0, dst, to)
    } else {
        aead.decrypt_block_into(x.data.dec, masked, 0, dst, to)
    }
    xor_into(dst, to, tweak)
}

fn xts_run(encrypt: bool, x: *Xts, tweak: []u8, data: []u8) -> []u8 ! Error {
    if tweak.len != 16 {
        fail Error.InvalidIv
    }
    if data.len < 16 {
        fail Error.InvalidLength
    }
    let out: []u8 = __make(data.len)
    let t: []u8 = __make(16)
    aead.encrypt_block_into(x.tweak.enc, tweak, 0, t, 0)
    let remainder = data.len % 16
    let whole = data.len / 16
    let plain_blocks = if remainder == 0 { whole } else { whole - 1 }
    for i in 0..plain_blocks {
        xts_block(encrypt, x, t, data, 16 * i, out, 16 * i)
        double_tweak(t)
    }
    if remainder == 0 {
        return out
    }
    let last = 16 * plain_blocks
    let next: []u8 = __make(16)
    __memmove(next, t)
    double_tweak(next)
    let first_tweak = if encrypt { t } else { next }
    let second_tweak = if encrypt { next } else { t }
    let stolen: []u8 = __make(16)
    xts_block(encrypt, x, first_tweak, data, last, stolen, 0)
    let merged: []u8 = __make(16)
    __memmove(merged, data[last + 16..])
    __memmove(merged[remainder..], stolen[remainder..])
    __memmove(out[last + 16..], stolen[..remainder])
    xts_block(encrypt, x, second_tweak, merged, 0, out, last)
    out
}

pub fn xts_encrypt(x: *Xts, tweak: []u8, data: []u8) -> []u8 ! Error {
    xts_run(true, x, tweak, data)?
}

pub fn xts_decrypt(x: *Xts, tweak: []u8, data: []u8) -> []u8 ! Error {
    xts_run(false, x, tweak, data)?
}
