import std/io

struct Reader {
    data: []u8
    at: i64
}

fn element(r: *Reader, tag: u8) -> []u8 ! io.Error {
    let data = r.data
    if r.at + 2 > data.len || data[r.at] != tag {
        fail Malformed
    }
    var size = i64(data[r.at + 1])
    var at = r.at + 2
    if size >= 0x80 {
        let count = size - 0x80
        if count == 0 || count > 4 || at + count > data.len || data[at] == 0 {
            fail Malformed
        }
        size = 0
        for i in 0..count {
            size = size << 8 | i64(data[at + i])
        }
        at += count
        if size < 0x80 {
            fail Malformed
        }
    }
    if size > data.len - at {
        fail Malformed
    }
    r.at = at + size
    data[at..at + size]
}

fn unsigned(r: *Reader) -> []u8 ! io.Error {
    let v = element(r, 0x02)?
    if v.len == 0 || v[0] >= 0x80 || v.len > 1 && v[0] == 0 && v[1] < 0x80 {
        fail Malformed
    }
    if v[0] == 0 { v[1..] } else { v }
}

fn sequence(data: []u8) -> *Reader ! io.Error {
    let outer = new(Reader { data, at: 0 })
    let body = element(outer, 0x30)?
    if outer.at != data.len {
        fail Malformed
    }
    new(Reader { data: body, at: 0 })
}
