import std/io
import std/crypto
import std/crypto/der
import std/crypto/hash

/// An RSA public key.
///
/// Both integers are big-endian with no leading zero byte.
pub struct PublicKey {
    /// The modulus, 2048 to 8192 bits.
    pub n: []u8
    /// The public exponent, odd and greater than 1.
    pub e: []u8
}

/// An RSA private key in the form of PKCS#1 `RSAPrivateKey` (RFC 8017), with the Chinese remainder theorem parameters.
///
/// All integers are big-endian with no leading zero byte.
pub struct PrivateKey {
    /// The modulus, 2048 to 8192 bits.
    pub n: []u8
    /// The public exponent, odd and greater than 1.
    pub e: []u8
    /// The private exponent.
    pub d: []u8
    /// The first prime factor of `n`.
    pub p: []u8
    /// The second prime factor of `n`.
    pub q: []u8
    /// The exponent `d mod (p - 1)`.
    pub dp: []u8
    /// The exponent `d mod (q - 1)`.
    pub dq: []u8
    /// The coefficient `q^-1 mod p`.
    pub qinv: []u8
}

/// Returns the public key of `key`, sharing its `n` and `e`.
pub fn public(key: PrivateKey) -> PublicKey {
    PublicKey { n: key.n, e: key.e }
}

/// Parses a DER PKCS#1 `RSAPublicKey` (RFC 8017), `SEQUENCE { n INTEGER, e INTEGER }`.
///
/// The DER must be minimal, with no trailing bytes; otherwise the call fails with `Malformed`. Fails with `Unsupported` when the modulus is not 2048 to 8192 bits and odd, when the exponent is even, 1 or longer than the modulus.
pub fn parse_public(encoded: []u8) -> PublicKey ! io.Error {
    let outer = der.whole(encoded, 0x30)?
    let r = der.reader(outer.content)
    let n = der.unsigned(r)?
    let e = der.unsigned(r)?
    der.finish(r)?
    let key = PublicKey { n, e }
    if !usable(key) {
        fail Unsupported
    }
    key
}

/// Parses a DER PKCS#1 `RSAPrivateKey` (RFC 8017) with eight integers after the version.
///
/// The version must be `0` (two-prime); otherwise the call fails with `Unsupported`, as it does when the modulus or exponent fails the limits of `parse_public`. Fails with `Malformed` for DER that is not minimal or has trailing bytes, and when the key is inconsistent: `p` or `q` is even, `qinv` is not below `p`, `p * q` is not `n`, or a test signature does not verify under the public key.
pub fn parse_private(encoded: []u8) -> PrivateKey ! io.Error {
    let outer = der.whole(encoded, 0x30)?
    let r = der.reader(outer.content)
    let version = der.unsigned(r)?
    if version.len != 0 {
        fail Unsupported
    }
    let key = PrivateKey {
        n: der.unsigned(r)?, e: der.unsigned(r)?, d: der.unsigned(r)?, p: der.unsigned(r)?, q: der.unsigned(r)?,
        dp: der.unsigned(r)?, dq: der.unsigned(r)?, qinv: der.unsigned(r)?,
    }
    der.finish(r)?
    if !usable(public(key)) {
        fail Unsupported
    }
    if !consistent(key) {
        fail Malformed
    }
    key
}

fn consistent(key: PrivateKey) -> bool {
    if key.p.len == 0 || key.q.len == 0 || key.dp.len == 0 || key.dq.len == 0 || key.qinv.len == 0 {
        return false
    }
    if (key.p[key.p.len - 1] & 1) == 0 || (key.q[key.q.len - 1] & 1) == 0 {
        return false
    }
    let kp = crt_limbs(key)
    if key.qinv.len > key.p.len || compare(limbs(key.qinv, kp), limbs(key.p, kp)) >= 0 {
        return false
    }
    let pq = product(limbs(key.p, kp), limbs(key.q, kp))
    let n = limbs(key.n, pq.len)
    if limb_count(key.n) > pq.len || compare(pq, n) != 0 {
        return false
    }
    let probe: []u8 = __make(key.n.len - 1)
    for i in 0..probe.len {
        probe[i] = u8(i * 37 + 11)
    }
    let s = private_op(key, probe)
    let back = public_op(public(key), s)
    back.len > 0 && hash.equal(back[1..], probe) && back[0] == 0
}

fn crt_limbs(key: PrivateKey) -> i64 {
    let kp = limb_count(key.p)
    let kq = limb_count(key.q)
    if kp > kq { kp } else { kq }
}

fn modulus_bits(n: []u8) -> i64 {
    var top = n[0]
    var bits = 8 * (n.len - 1)
    for top != 0 {
        bits += 1
        top >>= 1
    }
    bits
}

fn usable(key: PublicKey) -> bool {
    let n = key.n
    let e = key.e
    if n.len == 0 || e.len == 0 || e.len > n.len {
        return false
    }
    let bits = modulus_bits(n)
    let odd = (n[n.len - 1] & 1) == 1 && (e[e.len - 1] & 1) == 1
    bits >= 2048 && bits <= 8192 && odd && (e.len > 1 || e[0] > 1)
}

fn public_op(key: PublicKey, signature: []u8) -> []u8 {
    let k = limb_count(key.n)
    let m = mont(key.n, k)
    let s = limbs(signature, k)
    if signature.len != key.n.len || compare(s, m.n) >= 0 {
        let rejected: []u8 = []
        return rejected
    }
    let base: []u64 = __make(k)
    mul(m, s, m.rr, base)
    to_bytes(power(m, base, key.e), key.n.len)
}

fn private_op(key: PrivateKey, message: []u8) -> []u8 {
    let kp = crt_limbs(key)
    let c = limbs(message, limb_count(key.n))
    let mp = mont(key.p, kp)
    let mq = mont(key.q, kp)
    let cp = to_mont(mp, c)
    let cq = to_mont(mq, c)
    let sp = power(mp, cp, key.dp)
    let sq = power(mq, cq, key.dq)
    let sqp = reduce(mp, sq)
    let diff = sub_mod(mp, sp, sqp)
    let qinv = limbs(key.qinv, kp)
    let h: []u64 = __make(kp)
    mul(mp, diff, qinv, h)
    mul(mp, h, mp.rr, h)
    let q = limbs(key.q, kp)
    let s = product(q, h)
    add_into(s, sq)
    to_bytes(s, key.n.len)
}

fn digest_prefix(a: hash.Algorithm) -> []u8 {
    if a.name == "sha256" {
        return [0x30, 0x31, 0x30, 0x0d, 0x06, 0x09, 0x60, 0x86, 0x48, 0x01, 0x65, 0x03, 0x04, 0x02, 0x01, 0x05, 0x00, 0x04, 0x20]
    }
    if a.name == "sha384" {
        return [0x30, 0x41, 0x30, 0x0d, 0x06, 0x09, 0x60, 0x86, 0x48, 0x01, 0x65, 0x03, 0x04, 0x02, 0x02, 0x05, 0x00, 0x04, 0x30]
    }
    if a.name == "sha512" {
        return [0x30, 0x51, 0x30, 0x0d, 0x06, 0x09, 0x60, 0x86, 0x48, 0x01, 0x65, 0x03, 0x04, 0x02, 0x03, 0x05, 0x00, 0x04, 0x40]
    }
    let unknown: []u8 = []
    unknown
}

fn pkcs1_encode(a: hash.Algorithm, digest: []u8, size: i64) -> []u8 {
    let prefix = digest_prefix(a)
    let t_len = prefix.len + digest.len
    if prefix.len == 0 || digest.len != a.size || size < t_len + 11 {
        let rejected: []u8 = []
        return rejected
    }
    let em: []u8 = __make(size)
    em[1] = 0x01
    for i in 2..size - t_len - 1 {
        em[i] = 0xFF
    }
    __memmove(em[size - t_len..], prefix)
    __memmove(em[size - digest.len..], digest)
    em
}

fn mgf1(a: hash.Algorithm, seed: []u8, length: i64) -> []u8 {
    let out: []u8 = __make(length)
    let counter: []u8 = __make(4)
    var filled = 0
    var n = 0
    for filled < length {
        counter[0] = u8(n >> 24)
        counter[1] = u8(n >> 16)
        counter[2] = u8(n >> 8)
        counter[3] = u8(n)
        let d = a.digest()
        d.update(seed)
        d.update(counter)
        let block = d.finish()
        filled += __memmove(out[filled..], block)
        n += 1
    }
    out
}

fn pss_hash(a: hash.Algorithm, digest: []u8, salt: []u8) -> []u8 {
    let zeros: []u8 = __make(8)
    let d = a.digest()
    d.update(zeros)
    d.update(digest)
    d.update(salt)
    d.finish()
}

fn pss_encode(a: hash.Algorithm, digest: []u8, salt: []u8, em_bits: i64) -> []u8 {
    let h_len = a.size
    let em_len = (em_bits + 7) / 8
    if digest.len != h_len || em_len < 2 * h_len + 2 {
        let rejected: []u8 = []
        return rejected
    }
    let h = pss_hash(a, digest, salt)
    let db_len = em_len - h_len - 1
    let em: []u8 = __make(em_len)
    em[db_len - h_len - 1] = 0x01
    __memmove(em[db_len - h_len..db_len], salt)
    let mask = mgf1(a, h, db_len)
    for i in 0..db_len {
        em[i] ^= mask[i]
    }
    em[0] &= u8(0xFF >> (8 * em_len - em_bits))
    __memmove(em[db_len..], h)
    em[em_len - 1] = 0xbc
    em
}

fn sign_encoded(key: PrivateKey, em: []u8) -> []u8 ! io.Error {
    if em.len == 0 {
        fail Invalid
    }
    let padded: []u8 = __make(key.n.len)
    __memmove(padded[key.n.len - em.len..], em)
    let s = private_op(key, padded)
    let back = public_op(public(key), s)
    if !hash.equal(back, padded) {
        fail Invalid
    }
    s
}

/// Signs the hash `digest` with RSASSA-PKCS1-v1_5 (RFC 8017) and returns a signature as long as the modulus.
///
/// `a` must be `sha256`, `sha384` or `sha512` and `digest` must be exactly `a.size` bytes, the hash of the message. The result is checked with the public key before it is returned.
///
/// Fails with `Invalid` when `a` is another algorithm, when `digest` has the wrong length, when the modulus is too short for the encoded digest, or when the signature fails that check.
pub fn sign_pkcs1v15(key: PrivateKey, a: hash.Algorithm, digest: []u8) -> []u8 ! io.Error {
    let em = pkcs1_encode(a, digest, key.n.len)
    sign_encoded(key, em)
}

/// Signs the hash `digest` with RSASSA-PSS (RFC 8017) and returns a signature as long as the modulus.
///
/// MGF1 uses the same hash as `a`, and the salt is `a.size` random bytes from `crypto.random`, so signing the same digest twice gives different signatures. `digest` must be exactly `a.size` bytes, the hash of the message. The result is checked with the public key before it is returned.
///
/// Fails with `Invalid` when `digest` has the wrong length, when the modulus is too short for the hash and salt, or when the signature fails that check.
pub fn sign_pss(key: PrivateKey, a: hash.Algorithm, digest: []u8) -> []u8 ! io.Error {
    let salt = crypto.random(a.size)
    let em = pss_encode(a, digest, salt, modulus_bits(key.n) - 1)
    sign_encoded(key, em)
}

/// Reports whether `signature` is a valid RSASSA-PKCS1-v1_5 signature (RFC 8017) of the hash `digest` under `key`.
///
/// `a` must be `sha256`, `sha384` or `sha512`. Returns `false`, never an error, for an unusable key, an unsupported algorithm, a `digest` of the wrong length, a `signature` that is not exactly as long as the modulus or is not below it, and a mismatch. The padding comparison does not exit early.
pub fn verify_pkcs1v15(key: PublicKey, a: hash.Algorithm, digest: []u8, signature: []u8) -> bool {
    if !usable(key) {
        return false
    }
    let expected = pkcs1_encode(a, digest, key.n.len)
    let m = public_op(key, signature)
    expected.len > 0 && hash.equal(m, expected)
}

/// Reports whether `signature` is a valid RSASSA-PSS signature (RFC 8017) of the hash `digest` under `key`.
///
/// MGF1 uses the same hash as `a`, and the salt length is taken from the signature. Returns `false`, never an error, for an unusable key, a `digest` that is not `a.size` bytes, a `signature` that is not exactly as long as the modulus or is not below it, and any padding or hash mismatch.
pub fn verify_pss(key: PublicKey, a: hash.Algorithm, digest: []u8, signature: []u8) -> bool {
    if !usable(key) || digest.len != a.size {
        return false
    }
    let m = public_op(key, signature)
    if m.len == 0 {
        return false
    }
    let em_bits = modulus_bits(key.n) - 1
    let em_len = (em_bits + 7) / 8
    for i in 0..m.len - em_len {
        if m[i] != 0 {
            return false
        }
    }
    let em = m[m.len - em_len..]
    let h_len = a.size
    if em_len < 2 * h_len + 2 || em[em_len - 1] != 0xbc {
        return false
    }
    let db_len = em_len - h_len - 1
    let top = u8(0xFF >> (8 * em_len - em_bits))
    if (em[0] & ~top) != 0 {
        return false
    }
    let h = em[db_len..em_len - 1]
    let mask = mgf1(a, h, db_len)
    let db: []u8 = __make(db_len)
    for i in 0..db_len {
        db[i] = em[i] ^ mask[i]
    }
    db[0] &= top
    let ps = db_len - h_len - 1
    for i in 0..ps {
        if db[i] != 0 {
            return false
        }
    }
    db[ps] == 0x01 && hash.equal(pss_hash(a, digest, db[ps + 1..]), h)
}
