struct Mont {
    n: []u64
    k: i64
    inv: u64
    rr: []u64
    rrr: []u64
    one: []u64
    t: []u64
    d: []u64
    wide: []u64
}

fn limb_count(b: []u8) -> i64 {
    (b.len + 7) / 8
}

fn limbs(b: []u8, k: i64) -> []u64 {
    let out: []u64 = __make(k)
    for idx in 0..b.len {
        let limb = idx / 8
        if limb < k {
            out[limb] |= u64(b[b.len - 1 - idx]) << (8 * (idx % 8))
        }
    }
    out
}

fn to_bytes(x: []u64, size: i64) -> []u8 {
    let out: []u8 = __make(size)
    for idx in 0..size {
        let limb = idx / 8
        if limb < x.len {
            out[size - 1 - idx] = u8(x[limb] >> (8 * (idx % 8)))
        }
    }
    out
}

fn add_carry(a: u64, b: u64, s: u64) -> u64 {
    (a & b | (a | b) & ~s) >> 63
}

fn sub_borrow(a: u64, b: u64, d: u64) -> u64 {
    (~a & b | ~(a ^ b) & d) >> 63
}

fn compare(a: []u64, b: []u64) -> i64 {
    var i = a.len - 1
    for i >= 0 {
        if a[i] != b[i] {
            return if a[i] > b[i] { 1 } else { -1 }
        }
        i -= 1
    }
    0
}

fn mont(n: []u8, k: i64) -> *Mont {
    let nl = limbs(n, k)
    let n0 = nl[0]
    var x = n0
    for _ in 0..5 {
        x = x * (2 - n0 * x)
    }
    let m = new(Mont {
        n: nl, k, inv: 0 - x, rr: __make(k), rrr: __make(k), one: __make(k),
        t: __make(k + 2), d: __make(k), wide: __make(2 * k + 1),
    })
    m.one[0] = 1
    let rr = m.rr
    rr[0] = 1
    for _ in 0..128 * k {
        double(m, rr)
    }
    mul(m, rr, rr, m.rrr)
    m
}

fn double(m: *Mont, x: []u64) {
    let t = m.t
    var c: u64 = 0
    for j in 0..m.k {
        t[j] = x[j] << 1 | c
        c = x[j] >> 63
    }
    t[m.k] = c
    finish(m, x)
}

fn finish(m: *Mont, out: []u64) {
    let k = m.k
    let t = m.t
    let n = m.n
    let d = m.d
    var borrow: u64 = 0
    for j in 0..k {
        let a = t[j]
        let b = n[j]
        let diff = a - b - borrow
        borrow = sub_borrow(a, b, diff)
        d[j] = diff
    }
    let keep = 0 - (~t[k] & borrow & 1)
    for j in 0..k {
        out[j] = t[j] & keep | d[j] & ~keep
    }
}

fn mul(m: *Mont, a: []u64, b: []u64, out: []u64) {
    let k = m.k
    let n = m.n
    let t = m.t
    let inv = m.inv
    for j in 0..k + 2 {
        t[j] = 0
    }
    for i in 0..k {
        let ai = a[i]
        var c: u64 = 0
        for j in 0..k {
            let bj = b[j]
            let lo = ai * bj
            let tj = t[j]
            let s = tj + lo
            let s2 = s + c
            c = __mulhi(ai, bj) + ((tj & lo | (tj | lo) & ~s) >> 63) + ((s & c | (s | c) & ~s2) >> 63)
            t[j] = s2
        }
        let top = t[k]
        let sum = top + c
        t[k + 1] = add_carry(top, c, sum)
        t[k] = sum
        let q = t[0] * inv
        let first = q * n[0]
        let t0 = t[0]
        let s0 = t0 + first
        c = __mulhi(q, n[0]) + add_carry(t0, first, s0)
        for j in 1..k {
            let nj = n[j]
            let lo = q * nj
            let tj = t[j]
            let s = tj + lo
            let s2 = s + c
            c = __mulhi(q, nj) + ((tj & lo | (tj | lo) & ~s) >> 63) + ((s & c | (s | c) & ~s2) >> 63)
            t[j - 1] = s2
        }
        let tk = t[k]
        let last = tk + c
        t[k - 1] = last
        t[k] = t[k + 1] + add_carry(tk, c, last)
    }
    finish(m, out)
}

fn redc(m: *Mont, x: []u64, out: []u64) {
    let k = m.k
    let n = m.n
    let w = m.wide
    for j in 0..w.len {
        w[j] = if j < x.len { x[j] } else { 0 }
    }
    for i in 0..k {
        let q = w[i] * m.inv
        var c: u64 = 0
        for j in 0..k {
            let nj = n[j]
            let lo = q * nj
            let wj = w[i + j]
            let s = wj + lo
            let s2 = s + c
            c = __mulhi(q, nj) + add_carry(wj, lo, s) + add_carry(s, c, s2)
            w[i + j] = s2
        }
        for j in i + k..w.len {
            let wj = w[j]
            let s = wj + c
            c = add_carry(wj, c, s)
            w[j] = s
        }
    }
    let t = m.t
    for j in 0..k + 1 {
        t[j] = w[k + j]
    }
    finish(m, out)
}

fn to_mont(m: *Mont, x: []u64) -> []u64 {
    let out: []u64 = __make(m.k)
    redc(m, x, out)
    mul(m, out, m.rrr, out)
    out
}

fn reduce(m: *Mont, x: []u64) -> []u64 {
    let out: []u64 = __make(m.k)
    redc(m, x, out)
    mul(m, out, m.rr, out)
    out
}

fn pick(table: []u64, k: i64, w: i64, out: []u64) {
    for j in 0..k {
        out[j] = 0
    }
    for i in 0..16 {
        let x = u64(i ^ w)
        let mask = ((x | (0 - x)) >> 63) - 1
        let base = i * k
        for j in 0..k {
            out[j] |= table[base + j] & mask
        }
    }
}

fn power(m: *Mont, base: []u64, e: []u8) -> []u64 {
    let k = m.k
    let table: []u64 = __make(16 * k)
    let one_m = table[0..k]
    mul(m, m.rr, m.one, one_m)
    __memmove(table[k..2 * k], base)
    for i in 2..16 {
        mul(m, table[(i - 1) * k..i * k], base, table[i * k..(i + 1) * k])
    }
    let acc: []u64 = __make(k)
    __memmove(acc, one_m)
    let picked: []u64 = __make(k)
    for byte in e {
        for half in 0..2 {
            for _ in 0..4 {
                mul(m, acc, acc, acc)
            }
            let w = if half == 0 { i64(byte >> 4) } else { i64(byte & 0xF) }
            pick(table, k, w, picked)
            mul(m, acc, picked, acc)
        }
    }
    mul(m, acc, m.one, acc)
    acc
}

fn product(a: []u64, b: []u64) -> []u64 {
    let out: []u64 = __make(a.len + b.len)
    for i in 0..a.len {
        let ai = a[i]
        var c: u64 = 0
        for j in 0..b.len {
            let bj = b[j]
            let lo = ai * bj
            let oj = out[i + j]
            let s = oj + lo
            let s2 = s + c
            c = __mulhi(ai, bj) + add_carry(oj, lo, s) + add_carry(s, c, s2)
            out[i + j] = s2
        }
        out[i + b.len] = c
    }
    out
}

fn add_into(acc: []u64, x: []u64) {
    var c: u64 = 0
    for j in 0..acc.len {
        let a = acc[j]
        let b = if j < x.len { x[j] } else { 0 }
        let s = a + b
        let s2 = s + c
        c = add_carry(a, b, s) | add_carry(s, c, s2)
        acc[j] = s2
    }
}

fn sub_mod(m: *Mont, a: []u64, b: []u64) -> []u64 {
    let k = m.k
    let out: []u64 = __make(k)
    var borrow: u64 = 0
    for j in 0..k {
        let x = a[j]
        let y = b[j]
        let diff = x - y - borrow
        borrow = sub_borrow(x, y, diff)
        out[j] = diff
    }
    let mask = 0 - borrow
    var c: u64 = 0
    for j in 0..k {
        let x = out[j]
        let y = m.n[j] & mask
        let s = x + y
        let s2 = s + c
        c = add_carry(x, y, s) | add_carry(s, c, s2)
        out[j] = s2
    }
    out
}
