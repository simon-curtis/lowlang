import std/crypto/hash

pub struct Shake {
    lanes: []u64
    rc: []u64
    rate: i64
    pad: u64
    fill: i64
    squeezing: bool
}

fn round_constants() -> []u64 {
    [
        0x0000000000000001, 0x0000000000008082, 0x800000000000808a, 0x8000000080008000,
        0x000000000000808b, 0x0000000080000001, 0x8000000080008081, 0x8000000000008009,
        0x000000000000008a, 0x0000000000000088, 0x0000000080008009, 0x000000008000000a,
        0x000000008000808b, 0x800000000000008b, 0x8000000000008089, 0x8000000000008003,
        0x8000000000008002, 0x8000000000000080, 0x000000000000800a, 0x800000008000000a,
        0x8000000080008081, 0x8000000000008080, 0x0000000080000001, 0x8000000080008008,
    ]
}

fn sponge(rate: i64, pad: u64) -> *Shake {
    new(Shake { lanes: __make(25), rc: round_constants(), rate, pad, fill: 0, squeezing: false })
}

fn permute(s: *Shake) {
    let lanes = s.lanes
    let rc = s.rc
    var a0 = lanes[0]
    var a1 = lanes[1]
    var a2 = lanes[2]
    var a3 = lanes[3]
    var a4 = lanes[4]
    var a5 = lanes[5]
    var a6 = lanes[6]
    var a7 = lanes[7]
    var a8 = lanes[8]
    var a9 = lanes[9]
    var a10 = lanes[10]
    var a11 = lanes[11]
    var a12 = lanes[12]
    var a13 = lanes[13]
    var a14 = lanes[14]
    var a15 = lanes[15]
    var a16 = lanes[16]
    var a17 = lanes[17]
    var a18 = lanes[18]
    var a19 = lanes[19]
    var a20 = lanes[20]
    var a21 = lanes[21]
    var a22 = lanes[22]
    var a23 = lanes[23]
    var a24 = lanes[24]
    for round in 0..24 {
        let c0 = a0 ^ a5 ^ a10 ^ a15 ^ a20
        let c1 = a1 ^ a6 ^ a11 ^ a16 ^ a21
        let c2 = a2 ^ a7 ^ a12 ^ a17 ^ a22
        let c3 = a3 ^ a8 ^ a13 ^ a18 ^ a23
        let c4 = a4 ^ a9 ^ a14 ^ a19 ^ a24
        let d0 = c4 ^ (c1 << 1 | c1 >> 63)
        let d1 = c0 ^ (c2 << 1 | c2 >> 63)
        let d2 = c1 ^ (c3 << 1 | c3 >> 63)
        let d3 = c2 ^ (c4 << 1 | c4 >> 63)
        let d4 = c3 ^ (c0 << 1 | c0 >> 63)
        let b0 = a0 ^ d0
        let t1 = a1 ^ d1
        let b10 = t1 << 1 | t1 >> 63
        let t2 = a2 ^ d2
        let b20 = t2 << 62 | t2 >> 2
        let t3 = a3 ^ d3
        let b5 = t3 << 28 | t3 >> 36
        let t4 = a4 ^ d4
        let b15 = t4 << 27 | t4 >> 37
        let t5 = a5 ^ d0
        let b16 = t5 << 36 | t5 >> 28
        let t6 = a6 ^ d1
        let b1 = t6 << 44 | t6 >> 20
        let t7 = a7 ^ d2
        let b11 = t7 << 6 | t7 >> 58
        let t8 = a8 ^ d3
        let b21 = t8 << 55 | t8 >> 9
        let t9 = a9 ^ d4
        let b6 = t9 << 20 | t9 >> 44
        let t10 = a10 ^ d0
        let b7 = t10 << 3 | t10 >> 61
        let t11 = a11 ^ d1
        let b17 = t11 << 10 | t11 >> 54
        let t12 = a12 ^ d2
        let b2 = t12 << 43 | t12 >> 21
        let t13 = a13 ^ d3
        let b12 = t13 << 25 | t13 >> 39
        let t14 = a14 ^ d4
        let b22 = t14 << 39 | t14 >> 25
        let t15 = a15 ^ d0
        let b23 = t15 << 41 | t15 >> 23
        let t16 = a16 ^ d1
        let b8 = t16 << 45 | t16 >> 19
        let t17 = a17 ^ d2
        let b18 = t17 << 15 | t17 >> 49
        let t18 = a18 ^ d3
        let b3 = t18 << 21 | t18 >> 43
        let t19 = a19 ^ d4
        let b13 = t19 << 8 | t19 >> 56
        let t20 = a20 ^ d0
        let b14 = t20 << 18 | t20 >> 46
        let t21 = a21 ^ d1
        let b24 = t21 << 2 | t21 >> 62
        let t22 = a22 ^ d2
        let b9 = t22 << 61 | t22 >> 3
        let t23 = a23 ^ d3
        let b19 = t23 << 56 | t23 >> 8
        let t24 = a24 ^ d4
        let b4 = t24 << 14 | t24 >> 50
        a0 = b0 ^ ~b1 & b2
        a1 = b1 ^ ~b2 & b3
        a2 = b2 ^ ~b3 & b4
        a3 = b3 ^ ~b4 & b0
        a4 = b4 ^ ~b0 & b1
        a5 = b5 ^ ~b6 & b7
        a6 = b6 ^ ~b7 & b8
        a7 = b7 ^ ~b8 & b9
        a8 = b8 ^ ~b9 & b5
        a9 = b9 ^ ~b5 & b6
        a10 = b10 ^ ~b11 & b12
        a11 = b11 ^ ~b12 & b13
        a12 = b12 ^ ~b13 & b14
        a13 = b13 ^ ~b14 & b10
        a14 = b14 ^ ~b10 & b11
        a15 = b15 ^ ~b16 & b17
        a16 = b16 ^ ~b17 & b18
        a17 = b17 ^ ~b18 & b19
        a18 = b18 ^ ~b19 & b15
        a19 = b19 ^ ~b15 & b16
        a20 = b20 ^ ~b21 & b22
        a21 = b21 ^ ~b22 & b23
        a22 = b22 ^ ~b23 & b24
        a23 = b23 ^ ~b24 & b20
        a24 = b24 ^ ~b20 & b21
        a0 ^= rc[round]
    }
    lanes[0] = a0
    lanes[1] = a1
    lanes[2] = a2
    lanes[3] = a3
    lanes[4] = a4
    lanes[5] = a5
    lanes[6] = a6
    lanes[7] = a7
    lanes[8] = a8
    lanes[9] = a9
    lanes[10] = a10
    lanes[11] = a11
    lanes[12] = a12
    lanes[13] = a13
    lanes[14] = a14
    lanes[15] = a15
    lanes[16] = a16
    lanes[17] = a17
    lanes[18] = a18
    lanes[19] = a19
    lanes[20] = a20
    lanes[21] = a21
    lanes[22] = a22
    lanes[23] = a23
    lanes[24] = a24
}

fn absorb_block(s: *Shake, data: []u8, at: i64) {
    let lanes = s.lanes
    for i in 0..s.rate / 8 {
        let p = at + 8 * i
        lanes[i] ^= u64(data[p]) | u64(data[p + 1]) << 8 | u64(data[p + 2]) << 16 | u64(data[p + 3]) << 24 | u64(data[p + 4]) << 32 | u64(data[p + 5]) << 40 | u64(data[p + 6]) << 48 | u64(data[p + 7]) << 56
    }
    permute(s)
}

pub fn absorb(s: *Shake, data: []u8) {
    if s.squeezing {
        return
    }
    let lanes = s.lanes
    var at = 0
    for at < data.len {
        if s.fill == 0 && data.len - at >= s.rate {
            absorb_block(s, data, at)
            at += s.rate
        } else {
            lanes[s.fill >> 3] ^= u64(data[at]) << ((s.fill & 7) * 8)
            s.fill += 1
            at += 1
            if s.fill == s.rate {
                permute(s)
                s.fill = 0
            }
        }
    }
}

fn finalize(s: *Shake) {
    s.lanes[s.fill >> 3] ^= s.pad << ((s.fill & 7) * 8)
    s.lanes[(s.rate - 1) >> 3] ^= 0x8000000000000000
    permute(s)
    s.fill = 0
    s.squeezing = true
}

pub fn squeeze(s: *Shake, n: i64) -> []u8 {
    if !s.squeezing {
        finalize(s)
    }
    let count = if n > 0 { n } else { 0 }
    let out: []u8 = __make(count)
    let lanes = s.lanes
    for i in 0..count {
        if s.fill == s.rate {
            permute(s)
            s.fill = 0
        }
        out[i] = u8(lanes[s.fill >> 3] >> ((s.fill & 7) * 8))
        s.fill += 1
    }
    out
}

fn copy(s: *Shake) -> *Shake {
    let lanes: []u64 = __make(25)
    __memmove(lanes, s.lanes)
    new(Shake { lanes, rc: s.rc, rate: s.rate, pad: s.pad, fill: s.fill, squeezing: s.squeezing })
}

pub fn shake128() -> *Shake {
    sponge(168, 0x1F)
}

pub fn shake256() -> *Shake {
    sponge(136, 0x1F)
}

fn digest(s: *Shake, size: i64) -> hash.Digest {
    hash.Digest {
        update: fn(data) { absorb(s, data) }
        finish: fn() { squeeze(copy(s), size) }
        clone: fn() { digest(copy(s), size) }
    }
}

fn algorithm(name: str, size: i64) -> hash.Algorithm {
    let rate = 200 - 2 * size
    hash.Algorithm { name, size, block: rate, digest: fn() { digest(sponge(rate, 0x06), size) } }
}

pub fn sha3_256() -> hash.Algorithm {
    algorithm("sha3-256", 32)
}

pub fn sha3_384() -> hash.Algorithm {
    algorithm("sha3-384", 48)
}

pub fn sha3_512() -> hash.Algorithm {
    algorithm("sha3-512", 64)
}
