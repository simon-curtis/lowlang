import std/crypto/hash
import std/io
import std/net
import std/text

struct Search {
    intermediates: []Certificate
    roots: []Certificate
    now: i64
}

fn max_intermediates() -> i64 {
    8
}

fn current(c: Certificate, now: i64) -> bool {
    c.not_before <= now && now <= c.not_after && c.unhandled_critical.len == 0
}

fn server_purpose(c: Certificate) -> bool {
    if c.ext_key_usage.len == 0 {
        return true
    }
    for purpose in c.ext_key_usage {
        if purpose == "1.3.6.1.5.5.7.3.1" || purpose == "2.5.29.37.0" {
            return true
        }
    }
    false
}

fn leaf_usable(c: Certificate, now: i64) -> bool {
    let usage = c.key_usage ?? 1
    current(c, now) && (usage & 1) != 0 && server_purpose(c)
}

fn authority_usable(c: Certificate, below: i64, anchor: bool, now: i64) -> bool {
    let usage = c.key_usage ?? 32
    let limit = c.path_length ?? below
    let authority = c.ca || anchor && c.version == 0
    authority && current(c, now) && (usage & 32) != 0 && below <= limit && server_purpose(c)
}

fn issued(issuer: Certificate, subject: Certificate) -> bool {
    hash.equal(issuer.subject, subject.issuer) && check_signature(issuer, subject)
}

fn listed(path: []Certificate, c: Certificate) -> bool {
    for p in path {
        if hash.equal(p.raw, c.raw) {
            return true
        }
    }
    false
}

fn appended(path: []Certificate, c: Certificate) -> []Certificate {
    let out: []Certificate = __make(path.len + 1)
    __memmove(out, path)
    out[path.len] = c
    out
}

fn extend(s: Search, path: []Certificate) -> []Certificate? {
    let last = path[path.len - 1]
    let below = path.len - 1
    for root in s.roots {
        if authority_usable(root, below, true, s.now) && issued(root, last) {
            return appended(path, root)
        }
    }
    if below >= max_intermediates() {
        return none
    }
    for c in s.intermediates {
        if !listed(path, c) && authority_usable(c, below, false, s.now) && issued(c, last) {
            match extend(s, appended(path, c)) {
                some(chain) => return chain
                none => {}
            }
        }
    }
    none
}

fn trimmed(host: str) -> str {
    if host.len > 0 && host[host.len - 1] == '.' { host[..host.len - 1] } else { host }
}

fn dns_match(pattern: str, name: str) -> bool {
    let p = text.lower(trimmed(pattern))
    if p.len == 0 {
        return false
    }
    if text.starts_with(p, "*.") {
        let suffix = p[1..]
        if text.index_byte(suffix[1..], '.') < 0 || text.index_byte(suffix, '*') >= 0 {
            return false
        }
        let dot = text.index_byte(name, '.')
        return dot > 0 && name[dot..] == suffix
    }
    p == name
}

fn ip_literal(host: str) -> []u8? {
    let ip = net.parse_ip(host) catch {
        _ => return none
    }
    ip
}

fn host_matches(c: Certificate, host: str) -> bool {
    match ip_literal(host) {
        some(ip) => {
            for address in c.ip_addresses {
                if hash.equal(address, ip) {
                    return true
                }
            }
            return false
        }
        none => {}
    }
    let name = text.lower(trimmed(host))
    if name.len == 0 || text.index_byte(name, '*') >= 0 {
        return false
    }
    for pattern in c.dns_names {
        if dns_match(pattern, name) {
            return true
        }
    }
    false
}

/// Builds and verifies a certification path from `leaf` to one of `roots` and returns it, leaf first and root last.
///
/// `now` is Unix seconds and `host` is a DNS name or IP address literal the leaf must be valid for; an empty `host` skips that check. A DNS name is matched case-insensitively against the `dns_names` of the leaf only, never its common name. A wildcard such as `*.example.com` stands for exactly one label in the leftmost position. An IP address is matched against `ip_addresses`.
///
/// Every certificate must be within its validity period and carry no unhandled critical extension. The leaf must allow `digitalSignature` (when it has key usage) and server authentication (when it has extended key usage; `anyExtendedKeyUsage` also counts). Each issuer must be a certificate authority (basic constraints, or a v1 root), allow `keyCertSign`, respect its `path_length`, allow server authentication, have a subject equal to the issuer of the certificate below it and verify that certificate's signature. At most 8 intermediates are used and none appears twice. Signature algorithms are those of `check_signature`. A leaf that is itself in `roots` returns a path of one certificate.
///
/// Fails with `Denied` when `host` does not match the leaf and with `Invalid` when the leaf is unusable or no path exists. Revocation is not checked.
pub fn verify_chain(leaf: Certificate, intermediates: []Certificate, roots: []Certificate, host: str, now: i64) -> []Certificate ! io.Error {
    if !leaf_usable(leaf, now) {
        fail Invalid
    }
    if host.len > 0 && !host_matches(leaf, host) {
        fail Denied
    }
    let path: []Certificate = [leaf]
    if listed(roots, leaf) {
        return path
    }
    let s = Search { intermediates, roots, now }
    match extend(s, path) {
        some(chain) => chain
        none => fail Invalid
    }
}
