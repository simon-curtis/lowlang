import std/base64
import std/file
import std/io
import std/text

fn pem_body(body: str) -> []u8? {
    let compact: []u8 = __make(body.len)
    var n = 0
    for i in 0..body.len {
        let c = body[i]
        if c == ':' {
            return none
        }
        if !text.space(c) {
            compact[n] = c
            n += 1
        }
    }
    let encoded = __str_view(compact[..n])
    let decoded = base64.decode(encoded) catch {
        _ => return none
    }
    decoded
}

/// Returns the decoded bodies of every PEM block (RFC 7468) in `pem` whose label is `label`, in order.
///
/// Text outside the `-----BEGIN label-----` and `-----END label-----` lines is ignored. A block whose body is not valid Base64, or that has header lines (contains a `:`), is skipped. An unterminated block ends the search. Returns an empty list when there is no match.
pub fn pem_blocks(pem: str, label: str) -> [][]u8 {
    let begin = "-----BEGIN {label}-----"
    let end = "-----END {label}-----"
    var out: [][]u8 = []
    var rest = pem
    for {
        let at = text.index(rest, begin)
        if at < 0 {
            break
        }
        let start = at + begin.len
        let stop = text.index(rest[start..], end)
        if stop < 0 {
            break
        }
        match pem_body(rest[start..start + stop]) {
            some(der) => push(mut out, der)
            none => {}
        }
        rest = rest[start + stop + end.len..]
    }
    out
}

/// Returns the DER encodings of every `CERTIFICATE` block in `pem`, in order, for `tls.Config.certificates`.
///
/// The leaf certificate must come first, followed by its intermediates. Blocks that are not valid Base64 are skipped.
pub fn pem_certificates(pem: str) -> [][]u8 {
    pem_blocks(pem, "CERTIFICATE")
}

/// Returns the private key in the first PEM block of `pem` labelled `PRIVATE KEY`, `EC PRIVATE KEY` or `RSA PRIVATE KEY`, tried in that order.
///
/// The block is parsed with `parse_private_key`, so PKCS#8, SEC 1 and PKCS#1 are accepted whatever the label. Fails with `Invalid` when `pem` has none of these blocks and with the parse error otherwise.
pub fn pem_private_key(pem: str) -> PrivateKey ! io.Error {
    for label in ["PRIVATE KEY", "EC PRIVATE KEY", "RSA PRIVATE KEY"] {
        let blocks = pem_blocks(pem, label)
        if blocks.len > 0 {
            return parse_private_key(blocks[0])
        }
    }
    fail Invalid
}

/// Returns the trusted root certificates of the system.
///
/// Reads the first file that exists among `/etc/ssl/certs/ca-certificates.crt`, `/etc/pki/tls/certs/ca-bundle.crt` and `/etc/ssl/cert.pem` as PEM. Entries that do not parse are skipped. Returns an empty list when none of the files exists or the file cannot be read.
pub fn system_roots() -> []Certificate {
    var out: []Certificate = []
    for path in ["/etc/ssl/certs/ca-certificates.crt", "/etc/pki/tls/certs/ca-bundle.crt", "/etc/ssl/cert.pem"] {
        if file.exists(path) {
            let pem = file.read_text(path) catch {
                _ => return out
            }
            for der in pem_certificates(pem) {
                let c = parse(der) catch {
                    _ => continue
                }
                push(mut out, c)
            }
            return out
        }
    }
    out
}
