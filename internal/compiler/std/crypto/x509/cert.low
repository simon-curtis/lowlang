import std/crypto/hash
import std/io

pub struct PublicKeyInfo {
    pub algorithm: str
    pub parameters: str
    pub key: []u8
}

pub struct Certificate {
    pub raw: []u8
    pub tbs: []u8
    pub version: i64
    pub serial: []u8
    pub issuer: []u8
    pub subject: []u8
    pub common_name: str
    pub not_before: i64
    pub not_after: i64
    pub signature_algorithm: str
    pub signature_parameters: []u8
    pub signature: []u8
    pub public_key: PublicKeyInfo
    pub dns_names: []str
    pub ip_addresses: [][]u8
    pub ca: bool
    pub path_length: i64?
    pub key_usage: i64?
    pub ext_key_usage: []str
    pub unhandled_critical: []str
}

struct AlgorithmId {
    raw: []u8
    oid: str
    parameters: []u8
}

fn algorithm_id(d: *Der) -> AlgorithmId ! io.Error {
    let e = expect(d, 0x30)?
    let inner = reader(e.content)
    let id = expect(inner, 0x06)?
    let name = oid(id.content)?
    var parameters: []u8 = []
    if !done(inner) {
        let p = read(inner)?
        parameters = p.raw
    }
    finish(inner)?
    AlgorithmId { raw: e.raw, oid: name, parameters }
}

fn public_key_info(d: *Der) -> PublicKeyInfo ! io.Error {
    let spki = enter(d, 0x30)?
    let algorithm = algorithm_id(spki)?
    let key_bits = expect(spki, 0x03)?
    finish(spki)?
    let key = bits(key_bits.content)?
    var parameters = ""
    if algorithm.parameters.len > 0 && algorithm.parameters[0] == 0x06 {
        let p = whole(algorithm.parameters, 0x06)?
        parameters = oid(p.content)?
    }
    PublicKeyInfo { algorithm: algorithm.oid, parameters, key }
}

fn wide_text(content: []u8, width: i64) -> str ! io.Error {
    if content.len % width != 0 {
        fail Malformed
    }
    var out: []u8 = []
    var i = 0
    for i < content.len {
        var c = 0
        for j in 0..width {
            c = c << 8 | i64(content[i + j])
        }
        i += width
        if c < 0x80 {
            push(mut out, u8(c))
        } else if c < 0x800 {
            push(mut out, u8(0xC0 | c >> 6))
            push(mut out, u8(0x80 | c & 0x3F))
        } else if c < 0x10000 {
            push(mut out, u8(0xE0 | c >> 12))
            push(mut out, u8(0x80 | c >> 6 & 0x3F))
            push(mut out, u8(0x80 | c & 0x3F))
        } else if c < 0x110000 {
            push(mut out, u8(0xF0 | c >> 18))
            push(mut out, u8(0x80 | c >> 12 & 0x3F))
            push(mut out, u8(0x80 | c >> 6 & 0x3F))
            push(mut out, u8(0x80 | c & 0x3F))
        } else {
            fail Malformed
        }
    }
    __str_view(out)
}

fn attribute_text(value: Element) -> str ! io.Error {
    if value.tag == 0x1E {
        return wide_text(value.content, 2)
    }
    if value.tag == 0x1C {
        return wide_text(value.content, 4)
    }
    __str_view(value.content)
}

fn common_name(name: Element) -> str ! io.Error {
    let d = reader(name.content)
    var found = ""
    for !done(d) {
        let set = enter(d, 0x31)?
        for !done(set) {
            let attribute = enter(set, 0x30)?
            let kind = expect(attribute, 0x06)?
            let value = read(attribute)?
            finish(attribute)?
            let id = oid(kind.content)?
            if found.len == 0 && id == "2.5.4.3" {
                found = attribute_text(value)?
            }
        }
    }
    found
}

fn alt_names(mut c: Certificate, value: []u8) ! io.Error {
    let outer = whole(value, 0x30)?
    let d = reader(outer.content)
    for !done(d) {
        let name = read(d)?
        if name.tag == 0x82 {
            push(mut c.dns_names, __str_view(name.content))
        } else if name.tag == 0x87 {
            if name.content.len != 4 && name.content.len != 16 {
                fail Malformed
            }
            push(mut c.ip_addresses, name.content)
        }
    }
}

fn basic_constraints(mut c: Certificate, value: []u8) ! io.Error {
    let outer = whole(value, 0x30)?
    let d = reader(outer.content)
    if peek(d) == 0x01 {
        let flag = expect(d, 0x01)?
        c.ca = boolean(flag.content)?
    }
    if peek(d) == 0x02 {
        let length = expect(d, 0x02)?
        c.path_length = small_int(length.content)?
    }
    finish(d)?
}

fn purposes(value: []u8) -> []str ! io.Error {
    let outer = whole(value, 0x30)?
    let d = reader(outer.content)
    var out: []str = []
    for !done(d) {
        let id = expect(d, 0x06)?
        let name = oid(id.content)?
        push(mut out, name)
    }
    out
}

fn extension(mut c: Certificate, d: *Der, mut seen: [str: bool]) ! io.Error {
    let ext = enter(d, 0x30)?
    let id = expect(ext, 0x06)?
    let name = oid(id.content)?
    var critical = false
    if peek(ext) == 0x01 {
        let flag = expect(ext, 0x01)?
        critical = boolean(flag.content)?
    }
    let wrapped = expect(ext, 0x04)?
    finish(ext)?
    if seen[name] != none {
        fail Malformed
    }
    seen[name] = true
    let value = wrapped.content
    if name == "2.5.29.17" {
        alt_names(mut c, value)?
    } else if name == "2.5.29.19" {
        basic_constraints(mut c, value)?
    } else if name == "2.5.29.15" {
        let usage = whole(value, 0x03)?
        c.key_usage = named_bits(usage.content)?
    } else if name == "2.5.29.37" {
        c.ext_key_usage = purposes(value)?
    } else if critical {
        push(mut c.unhandled_critical, name)
    }
}

fn validity(d: *Der) -> []i64 ! io.Error {
    let v = enter(d, 0x30)?
    let start = read(v)?
    let end = read(v)?
    finish(v)?
    let from = time(start)?
    let until = time(end)?
    [from, until]
}

pub fn parse(der: []u8) -> Certificate ! io.Error {
    let outer = whole(der, 0x30)?
    let body = reader(outer.content)
    let tbs = expect(body, 0x30)?
    let algorithm = algorithm_id(body)?
    let signature_bits = expect(body, 0x03)?
    finish(body)?
    let t = reader(tbs.content)
    var version = 0
    if peek(t) == 0xA0 {
        let wrapper = enter(t, 0xA0)?
        let v = expect(wrapper, 0x02)?
        finish(wrapper)?
        version = small_int(v.content)?
        if version > 2 {
            fail Unsupported
        }
    }
    let serial = expect(t, 0x02)?
    if serial.content.len == 0 {
        fail Malformed
    }
    let inner = algorithm_id(t)?
    if !hash.equal(inner.raw, algorithm.raw) {
        fail Malformed
    }
    let issuer = expect(t, 0x30)?
    let period = validity(t)?
    let subject = expect(t, 0x30)?
    let key = public_key_info(t)?
    let subject_name = common_name(subject)?
    let signature = bits(signature_bits.content)?
    var c = Certificate {
        raw: outer.raw, tbs: tbs.raw, version, serial: serial.content, issuer: issuer.raw,
        subject: subject.raw, common_name: subject_name, not_before: period[0], not_after: period[1],
        signature_algorithm: algorithm.oid, signature_parameters: algorithm.parameters, signature,
        public_key: key, dns_names: [], ip_addresses: [], ca: false, path_length: none,
        key_usage: none, ext_key_usage: [], unhandled_critical: [],
    }
    for tag in [0x81, 0x82] {
        if peek(t) == tag {
            if version == 0 {
                fail Malformed
            }
            let unique = read(t)?
            bits(unique.content)?
        }
    }
    if peek(t) == 0xA3 {
        if version != 2 {
            fail Malformed
        }
        let wrapper = enter(t, 0xA3)?
        let list = enter(wrapper, 0x30)?
        finish(wrapper)?
        var seen: [str: bool] = [:]
        for !done(list) {
            extension(mut c, list, mut seen)?
        }
    }
    finish(t)?
    c
}
