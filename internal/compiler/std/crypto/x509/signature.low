import std/crypto/der
import std/crypto/ecdsa
import std/crypto/ed25519
import std/crypto/hash
import std/crypto/rsa
import std/io

/// A private key for signing.
pub enum PrivateKey {
    /// An RSA private key.
    Rsa(key: rsa.PrivateKey)
    /// An ECDSA private key on P-256 or P-384.
    Ecdsa(key: ecdsa.Key)
    /// An Ed25519 private key as its 32-byte seed (RFC 8032).
    Ed25519(seed: []u8)
}

enum Scheme {
    Pkcs1(digest: hash.Algorithm)
    Pss(digest: hash.Algorithm)
    Ec(digest: hash.Algorithm, curve: ecdsa.Curve?)
    Ed
}

fn rsa_oid() -> str {
    "1.2.840.113549.1.1.1"
}

fn ec_oid() -> str {
    "1.2.840.10045.2.1"
}

fn ed25519_oid() -> str {
    "1.3.101.112"
}

fn curve_by_oid(name: str) -> ecdsa.Curve? {
    if name == "1.2.840.10045.3.1.7" {
        return ecdsa.Curve.P256
    }
    if name == "1.3.132.0.34" {
        return ecdsa.Curve.P384
    }
    none
}

fn hash_by_oid(name: str) -> hash.Algorithm? {
    if name == "2.16.840.1.101.3.4.2.1" {
        return hash.sha256()
    }
    if name == "2.16.840.1.101.3.4.2.2" {
        return hash.sha384()
    }
    if name == "2.16.840.1.101.3.4.2.3" {
        return hash.sha512()
    }
    none
}

fn scheme_by_code(code: i64) -> Scheme? {
    if code == 0x0401 {
        return Scheme.Pkcs1(hash.sha256())
    }
    if code == 0x0501 {
        return Scheme.Pkcs1(hash.sha384())
    }
    if code == 0x0601 {
        return Scheme.Pkcs1(hash.sha512())
    }
    if code == 0x0804 {
        return Scheme.Pss(hash.sha256())
    }
    if code == 0x0805 {
        return Scheme.Pss(hash.sha384())
    }
    if code == 0x0806 {
        return Scheme.Pss(hash.sha512())
    }
    if code == 0x0403 {
        return Scheme.Ec(hash.sha256(), ecdsa.Curve.P256)
    }
    if code == 0x0503 {
        return Scheme.Ec(hash.sha384(), ecdsa.Curve.P384)
    }
    if code == 0x0807 {
        return Scheme.Ed
    }
    none
}

fn hash_parameter(d: *der.Der, tag: u8) -> hash.Algorithm ! io.Error {
    let wrapper = der.enter(d, tag)?
    let algorithm = algorithm_id(wrapper)?
    der.finish(wrapper)?
    if algorithm.parameters.len > 0 {
        der.whole(algorithm.parameters, 0x05)?
    }
    match hash_by_oid(algorithm.oid) {
        some(a) => a
        none => fail Unsupported
    }
}

fn pss_parameters(parameters: []u8) -> hash.Algorithm ! io.Error {
    let outer = der.whole(parameters, 0x30)?
    let d = der.reader(outer.content)
    let digest = hash_parameter(d, 0xA0)?
    let mask = der.enter(d, 0xA1)?
    let mgf = der.expect(mask, 0x30)?
    der.finish(mask)?
    let m = der.reader(mgf.content)
    let mgf_id = der.expect(m, 0x06)?
    let mgf_name = der.oid(mgf_id.content)?
    let mgf_hash = algorithm_id(m)?
    der.finish(m)?
    let mgf_digest = match hash_by_oid(mgf_hash.oid) {
        some(a) => a
        none => fail Unsupported
    }
    if mgf_name != "1.2.840.113549.1.1.8" || mgf_digest.name != digest.name {
        fail Unsupported
    }
    let salt_wrapper = der.enter(d, 0xA2)?
    let salt = der.expect(salt_wrapper, 0x02)?
    der.finish(salt_wrapper)?
    let salt_length = der.small_int(salt.content)?
    if salt_length != digest.size {
        fail Unsupported
    }
    if !der.done(d) {
        let trailer_wrapper = der.enter(d, 0xA3)?
        let trailer = der.expect(trailer_wrapper, 0x02)?
        der.finish(trailer_wrapper)?
        let value = der.small_int(trailer.content)?
        if value != 1 {
            fail Malformed
        }
    }
    der.finish(d)?
    digest
}

fn rsa_parameters_valid(parameters: []u8) -> bool {
    parameters.len == 0 || parameters.len == 2 && parameters[0] == 0x05 && parameters[1] == 0
}

fn certificate_scheme(c: Certificate) -> Scheme? {
    let name = c.signature_algorithm
    let parameters = c.signature_parameters
    if name == "1.2.840.113549.1.1.11" && rsa_parameters_valid(parameters) {
        return Scheme.Pkcs1(hash.sha256())
    }
    if name == "1.2.840.113549.1.1.12" && rsa_parameters_valid(parameters) {
        return Scheme.Pkcs1(hash.sha384())
    }
    if name == "1.2.840.113549.1.1.13" && rsa_parameters_valid(parameters) {
        return Scheme.Pkcs1(hash.sha512())
    }
    if name == "1.2.840.113549.1.1.10" {
        let digest = pss_parameters(parameters) catch {
            _ => return none
        }
        return Scheme.Pss(digest)
    }
    if parameters.len > 0 {
        return none
    }
    if name == "1.2.840.10045.4.3.2" {
        return Scheme.Ec(hash.sha256(), none)
    }
    if name == "1.2.840.10045.4.3.3" {
        return Scheme.Ec(hash.sha384(), none)
    }
    if name == "1.2.840.10045.4.3.4" {
        return Scheme.Ec(hash.sha512(), none)
    }
    if name == ed25519_oid() {
        return Scheme.Ed
    }
    none
}

fn rsa_public(key: PublicKeyInfo) -> rsa.PublicKey? {
    if key.algorithm != rsa_oid() {
        return none
    }
    let parsed = rsa.parse_public(key.key) catch {
        _ => return none
    }
    parsed
}

fn verify_with(key: PublicKeyInfo, scheme: Scheme, message: []u8, signature: []u8) -> bool {
    match scheme {
        Pkcs1(a) => {
            let public = match rsa_public(key) {
                some(k) => k
                none => return false
            }
            let digest = hash.sum(a, message)
            rsa.verify_pkcs1v15(public, a, digest, signature)
        }
        Pss(a) => {
            let public = match rsa_public(key) {
                some(k) => k
                none => return false
            }
            let digest = hash.sum(a, message)
            rsa.verify_pss(public, a, digest, signature)
        }
        Ec(a, wanted) => {
            if key.algorithm != ec_oid() {
                return false
            }
            let curve = match curve_by_oid(key.parameters) {
                some(c) => c
                none => return false
            }
            if wanted != none && wanted != curve {
                return false
            }
            let digest = hash.sum(a, message)
            ecdsa.verify(curve, key.key, digest, signature)
        }
        Ed => key.algorithm == ed25519_oid() && key.key.len == 32 && ed25519.verify(key.key, message, signature)
    }
}

/// Returns whether `subject` carries a valid signature by the key of `issuer`.
///
/// The scheme comes from the signature algorithm of `subject`: RSA PKCS#1 v1.5 with SHA-256, SHA-384 or SHA-512, RSASSA-PSS with SHA-256, SHA-384 or SHA-512 (MGF1 with the same hash and a salt as long as the hash), ECDSA with SHA-256, SHA-384 or SHA-512, or Ed25519. Returns `false` for any other scheme, when the type of the issuer key does not fit, or when verification fails. Names and validity are not checked.
pub fn check_signature(issuer: Certificate, subject: Certificate) -> bool {
    match certificate_scheme(subject) {
        some(scheme) => verify_with(issuer.public_key, scheme, subject.tbs, subject.signature)
        none => false
    }
}

/// Returns whether `signature` is a valid signature of `message` under `key`, for the TLS `SignatureScheme` code `scheme`.
///
/// The supported codes are `0x0401`, `0x0501` and `0x0601` (RSA PKCS#1 v1.5 with SHA-256, SHA-384 and SHA-512), `0x0804`, `0x0805` and `0x0806` (RSASSA-PSS with SHA-256, SHA-384 and SHA-512), `0x0403` and `0x0503` (ECDSA P-256 with SHA-256 and P-384 with SHA-384) and `0x0807` (Ed25519). An ECDSA signature is DER encoded. Returns `false` for any other code or when the key does not fit the scheme.
pub fn verify_signature(key: PublicKeyInfo, scheme: i64, message: []u8, signature: []u8) -> bool {
    match scheme_by_code(scheme) {
        some(s) => verify_with(key, s, message, signature)
        none => false
    }
}

/// Returns the signature of `message` under `key` for the TLS `SignatureScheme` code `scheme`.
///
/// The supported codes are those of `verify_signature`. An ECDSA signature is DER encoded. Fails with `Unsupported` when `scheme` is not supported or the key type or curve does not fit it, and with the error of the signing function otherwise.
pub fn sign(key: PrivateKey, scheme: i64, message: []u8) -> []u8 ! io.Error {
    let s = match scheme_by_code(scheme) {
        some(value) => value
        none => fail Unsupported
    }
    match key {
        Rsa(k) => {
            match s {
                Pkcs1(a) => {
                    let digest = hash.sum(a, message)
                    return rsa.sign_pkcs1v15(k, a, digest)
                }
                Pss(a) => {
                    let digest = hash.sum(a, message)
                    return rsa.sign_pss(k, a, digest)
                }
                _ => {}
            }
        }
        Ecdsa(k) => {
            match s {
                Ec(a, curve) => {
                    if curve == k.curve {
                        let digest = hash.sum(a, message)
                        return ecdsa.sign(k.curve, k.private, digest)
                    }
                }
                _ => {}
            }
        }
        Ed25519(seed) => {
            match s {
                Ed => return ed25519.sign(seed, message)
                _ => {}
            }
        }
    }
    fail Unsupported
}

fn pkcs8(body: *der.Der) -> PrivateKey ! io.Error {
    let algorithm = algorithm_id(body)?
    let wrapped = der.expect(body, 0x04)?
    for !der.done(body) {
        let tag = der.peek(body)
        if tag != 0xA0 && tag != 0x81 && tag != 0xA1 {
            fail Malformed
        }
        der.read(body)?
    }
    let inner = wrapped.content
    if algorithm.oid == rsa_oid() {
        if !rsa_parameters_valid(algorithm.parameters) {
            fail Malformed
        }
        let k = rsa.parse_private(inner)?
        return PrivateKey.Rsa(k)
    }
    if algorithm.oid == ec_oid() {
        let p = der.whole(algorithm.parameters, 0x06)?
        let curve_name = der.oid(p.content)?
        let curve = match curve_by_oid(curve_name) {
            some(c) => c
            none => fail Unsupported
        }
        let k = ecdsa.parse_private(inner)?
        if k.curve != curve {
            fail Malformed
        }
        return PrivateKey.Ecdsa(k)
    }
    if algorithm.oid == ed25519_oid() {
        if algorithm.parameters.len != 0 {
            fail Malformed
        }
        let seed = der.whole(inner, 0x04)?
        if seed.content.len != 32 {
            fail Malformed
        }
        return PrivateKey.Ed25519(seed.content)
    }
    fail Unsupported
}

/// Parses a DER encoded private key.
///
/// Accepts PKCS#8 `PrivateKeyInfo` (RFC 5208) holding an RSA, a P-256 or P-384 ECDSA or an Ed25519 key (RFC 8410), a PKCS#1 `RSAPrivateKey` (RFC 8017) and a SEC 1 `ECPrivateKey` (RFC 5915). Use `pem_blocks` to extract the DER from a PEM file. Fails with `Malformed` for bad encodings and with `Unsupported` for an unknown algorithm, curve or PKCS#8 version.
pub fn parse_private_key(encoded: []u8) -> PrivateKey ! io.Error {
    let outer = der.whole(encoded, 0x30)?
    let body = der.reader(outer.content)
    let version = der.expect(body, 0x02)?
    let next = der.peek(body)
    if next == 0x30 {
        let v = der.small_int(version.content)?
        if v > 1 {
            fail Unsupported
        }
        return pkcs8(body)
    }
    if next == 0x02 {
        let k = rsa.parse_private(encoded)?
        return PrivateKey.Rsa(k)
    }
    if next == 0x04 {
        let k = ecdsa.parse_private(encoded)?
        return PrivateKey.Ecdsa(k)
    }
    fail Malformed
}
