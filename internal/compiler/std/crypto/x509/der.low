import std/io
import clock = std/time

pub struct Der {
    pub data: []u8
    pub at: i64
}

pub struct Element {
    pub tag: u8
    pub content: []u8
    pub raw: []u8
}

pub fn reader(data: []u8) -> *Der {
    new(Der { data, at: 0 })
}

pub fn done(d: *Der) -> bool {
    d.at >= d.data.len
}

pub fn peek(d: *Der) -> i64 {
    if d.at < d.data.len { i64(d.data[d.at]) } else { -1 }
}

pub fn read(d: *Der) -> Element ! io.Error {
    let data = d.data
    let start = d.at
    if start + 2 > data.len {
        fail Malformed
    }
    let tag = data[start]
    if (tag & 0x1F) == 0x1F {
        fail Unsupported
    }
    var size = i64(data[start + 1])
    var at = start + 2
    if size == 0x80 {
        fail Malformed
    }
    if size > 0x80 {
        let count = size - 0x80
        if count > 4 || at + count > data.len || data[at] == 0 {
            fail Malformed
        }
        size = 0
        for i in 0..count {
            size = size << 8 | i64(data[at + i])
        }
        at += count
        if size < 0x80 {
            fail Malformed
        }
    }
    if size > data.len - at {
        fail Malformed
    }
    d.at = at + size
    Element { tag, content: data[at..at + size], raw: data[start..at + size] }
}

pub fn expect(d: *Der, tag: u8) -> Element ! io.Error {
    let e = read(d)?
    if e.tag != tag {
        fail Malformed
    }
    e
}

pub fn enter(d: *Der, tag: u8) -> *Der ! io.Error {
    let e = expect(d, tag)?
    reader(e.content)
}

pub fn finish(d: *Der) ! io.Error {
    if d.at != d.data.len {
        fail Malformed
    }
}

pub fn whole(data: []u8, tag: u8) -> Element ! io.Error {
    let d = reader(data)
    let e = expect(d, tag)?
    finish(d)?
    e
}

pub fn small_int(content: []u8) -> i64 ! io.Error {
    if content.len == 0 || content.len > 7 || content[0] >= 0x80 {
        fail Malformed
    }
    if content.len > 1 && content[0] == 0 && content[1] < 0x80 {
        fail Malformed
    }
    var v = 0
    for b in content {
        v = v << 8 | i64(b)
    }
    v
}

pub fn boolean(content: []u8) -> bool ! io.Error {
    if content.len != 1 || content[0] != 0 && content[0] != 0xFF {
        fail Malformed
    }
    content[0] == 0xFF
}

pub fn bits(content: []u8) -> []u8 ! io.Error {
    if content.len == 0 || content[0] != 0 {
        fail Malformed
    }
    content[1..]
}

pub fn named_bits(content: []u8) -> i64 ! io.Error {
    if content.len == 0 || content[0] > 7 || content.len == 1 && content[0] != 0 || content.len > 9 {
        fail Malformed
    }
    let unused = content[0]
    if content.len > 1 && (content[content.len - 1] & u8((1 << unused) - 1)) != 0 {
        fail Malformed
    }
    var flags = 0
    for i in 1..content.len {
        let b = content[i]
        for bit in 0..8 {
            if (b & u8(0x80 >> bit)) != 0 {
                flags |= 1 << (8 * (i - 1) + bit)
            }
        }
    }
    flags
}

pub fn oid(content: []u8) -> str ! io.Error {
    if content.len == 0 || (content[content.len - 1] & 0x80) != 0 {
        fail Malformed
    }
    var out = ""
    var value = 0
    var fresh = true
    for b in content {
        if fresh && b == 0x80 {
            fail Malformed
        }
        if value > 0xFFFFFFFFFFFF {
            fail Unsupported
        }
        value = value << 7 | i64(b & 0x7F)
        fresh = (b & 0x80) == 0
        if fresh {
            if out.len == 0 {
                let arc = if value < 40 { 0 } else if value < 80 { 1 } else { 2 }
                out = "{arc}.{value - 40 * arc}"
            } else {
                out = "{out}.{value}"
            }
            value = 0
        }
    }
    out
}

fn digits(c: []u8, at: i64, n: i64) -> i64 ! io.Error {
    var v = 0
    for i in at..at + n {
        let b = c[i]
        if b < '0' || b > '9' {
            fail Malformed
        }
        v = v * 10 + i64(b - '0')
    }
    v
}

pub fn time(e: Element) -> i64 ! io.Error {
    let c = e.content
    var year = 0
    var at = 0
    if e.tag == 0x17 && c.len == 13 {
        let yy = digits(c, 0, 2)?
        year = if yy < 50 { 2000 + yy } else { 1900 + yy }
        at = 2
    } else if e.tag == 0x18 && c.len == 15 {
        year = digits(c, 0, 4)?
        at = 4
    } else {
        fail Malformed
    }
    if c[c.len - 1] != 'Z' || year == 0 {
        fail Malformed
    }
    let month = digits(c, at, 2)?
    let day = digits(c, at + 2, 2)?
    let hour = digits(c, at + 4, 2)?
    let minute = digits(c, at + 6, 2)?
    let second = digits(c, at + 8, 2)?
    if month < 1 || month > 12 || day < 1 || day > clock.days_in_month(year, month) || hour > 23 || minute > 59 || second > 59 {
        fail Malformed
    }
    clock.days_from_civil(year, month, day) * 86400 + hour * 3600 + minute * 60 + second
}
