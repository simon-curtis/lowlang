import std/crypto/hash

struct State {
    h: []u32
    w: []u32
    k: []u32
    shifts: []u8
    buf: []u8
    total: i64
}

fn constants() -> []u32 {
    [
        0xd76aa478, 0xe8c7b756, 0x242070db, 0xc1bdceee,
        0xf57c0faf, 0x4787c62a, 0xa8304613, 0xfd469501,
        0x698098d8, 0x8b44f7af, 0xffff5bb1, 0x895cd7be,
        0x6b901122, 0xfd987193, 0xa679438e, 0x49b40821,
        0xf61e2562, 0xc040b340, 0x265e5a51, 0xe9b6c7aa,
        0xd62f105d, 0x02441453, 0xd8a1e681, 0xe7d3fbc8,
        0x21e1cde6, 0xc33707d6, 0xf4d50d87, 0x455a14ed,
        0xa9e3e905, 0xfcefa3f8, 0x676f02d9, 0x8d2a4c8a,
        0xfffa3942, 0x8771f681, 0x6d9d6122, 0xfde5380c,
        0xa4beea44, 0x4bdecfa9, 0xf6bb4b60, 0xbebfbc70,
        0x289b7ec6, 0xeaa127fa, 0xd4ef3085, 0x04881d05,
        0xd9d4d039, 0xe6db99e5, 0x1fa27cf8, 0xc4ac5665,
        0xf4292244, 0x432aff97, 0xab9423a7, 0xfc93a039,
        0x655b59c3, 0x8f0ccc92, 0xffeff47d, 0x85845dd1,
        0x6fa87e4f, 0xfe2ce6e0, 0xa3014314, 0x4e0811a1,
        0xf7537e82, 0xbd3af235, 0x2ad7d2bb, 0xeb86d391,
    ]
}

fn rotations() -> []u8 {
    [
        7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22,
        5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20,
        4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23,
        6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21,
    ]
}

fn rotl(x: u32, n: u8) -> u32 {
    x << n | x >> (32 - n)
}

fn block(s: *State, data: []u8, at: i64) {
    let w = s.w
    let k = s.k
    let shifts = s.shifts
    for t in 0..16 {
        let i = at + 4 * t
        w[t] = u32(data[i]) | u32(data[i + 1]) << 8 | u32(data[i + 2]) << 16 | u32(data[i + 3]) << 24
    }
    let h = s.h
    var a = h[0]
    var b = h[1]
    var c = h[2]
    var d = h[3]
    for t in 0..64 {
        var f: u32 = 0
        var g = 0
        if t < 16 {
            f = b & c | ~b & d
            g = t
        } else if t < 32 {
            f = d & b | ~d & c
            g = (5 * t + 1) % 16
        } else if t < 48 {
            f = b ^ c ^ d
            g = (3 * t + 5) % 16
        } else {
            f = c ^ (b | ~d)
            g = 7 * t % 16
        }
        let next = b + rotl(a + f + k[t] + w[g], shifts[t])
        a = d
        d = c
        c = b
        b = next
    }
    h[0] += a
    h[1] += b
    h[2] += c
    h[3] += d
}

fn update(s: *State, data: []u8) {
    s.total += data.len
    var at = 0
    if s.buf.len > 0 {
        let room = 64 - s.buf.len
        at = if data.len < room { data.len } else { room }
        __extend(mut s.buf, __str_view(data[..at]))
        if s.buf.len < 64 {
            return
        }
        block(s, s.buf, 0)
        s.buf = []
    }
    for at + 64 <= data.len {
        block(s, data, at)
        at += 64
    }
    __extend(mut s.buf, __str_view(data[at..]))
}

fn copy(s: *State) -> *State {
    var h: []u32 = []
    for x in s.h {
        push(mut h, x)
    }
    var buf: []u8 = []
    __extend(mut buf, __str_view(s.buf))
    new(State { h, w: __make(16), k: s.k, shifts: s.shifts, buf, total: s.total })
}

fn finish(s: *State) -> []u8 {
    let c = copy(s)
    let bits = c.total * 8
    var pad: []u8 = [0x80]
    for (c.total + pad.len) % 64 != 56 {
        push(mut pad, 0)
    }
    for i in 0..8 {
        push(mut pad, u8(bits >> (8 * i)))
    }
    update(c, pad)
    var out: []u8 = []
    for x in c.h {
        for i in 0..4 {
            push(mut out, u8(x >> (8 * i)))
        }
    }
    out
}

fn digest(s: *State) -> hash.Digest {
    hash.Digest {
        update: fn(data) { update(s, data) }
        finish: fn() { finish(s) }
        clone: fn() { digest(copy(s)) }
    }
}

fn new_digest() -> hash.Digest {
    let h: []u32 = [0x67452301, 0xefcdab89, 0x98badcfe, 0x10325476]
    digest(new(State { h, w: __make(16), k: constants(), shifts: rotations(), buf: [], total: 0 }))
}

/// Returns the `hash.Algorithm` for MD5 (RFC 1321).
///
/// The name is `md5`, the digest is 16 bytes and the block size is 64 bytes. MD5 is not collision resistant; use it only where a protocol requires it.
pub fn md5() -> hash.Algorithm {
    hash.Algorithm { name: "md5", size: 16, block: 64, digest: new_digest }
}

/// Returns the 16-byte MD5 digest of `data` (RFC 1321).
pub fn sum(data: []u8) -> []u8 {
    hash.sum(md5(), data)
}
