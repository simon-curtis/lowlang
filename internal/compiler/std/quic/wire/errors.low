/// Returns the transport error code NO_ERROR, 0x00, which closes a connection without an error.
pub fn no_error() -> i64 {
    0x00
}

/// Returns the transport error code INTERNAL_ERROR, 0x01.
pub fn internal_error() -> i64 {
    0x01
}

/// Returns the transport error code CONNECTION_REFUSED, 0x02, which a server uses to refuse a connection.
pub fn connection_refused() -> i64 {
    0x02
}

/// Returns the transport error code FLOW_CONTROL_ERROR, 0x03, for data beyond a flow control limit.
pub fn flow_control_error() -> i64 {
    0x03
}

/// Returns the transport error code STREAM_LIMIT_ERROR, 0x04, for a stream ID beyond the limit.
pub fn stream_limit_error() -> i64 {
    0x04
}

/// Returns the transport error code STREAM_STATE_ERROR, 0x05, for a frame a stream's state does not allow.
pub fn stream_state_error() -> i64 {
    0x05
}

/// Returns the transport error code FINAL_SIZE_ERROR, 0x06, for data that contradicts a stream's final size.
pub fn final_size_error() -> i64 {
    0x06
}

/// Returns the transport error code FRAME_ENCODING_ERROR, 0x07, for a malformed frame.
pub fn frame_encoding_error() -> i64 {
    0x07
}

/// Returns the transport error code TRANSPORT_PARAMETER_ERROR, 0x08, for invalid transport parameters.
pub fn transport_parameter_error() -> i64 {
    0x08
}

/// Returns the transport error code CONNECTION_ID_LIMIT_ERROR, 0x09, for more connection IDs than the limit allows.
pub fn connection_id_limit_error() -> i64 {
    0x09
}

/// Returns the transport error code PROTOCOL_VIOLATION, 0x0a, for a violation no other code describes.
pub fn protocol_violation() -> i64 {
    0x0a
}

/// Returns the transport error code INVALID_TOKEN, 0x0b, for a token a server rejects.
pub fn invalid_token() -> i64 {
    0x0b
}

/// Returns the transport error code APPLICATION_ERROR, 0x0c, for an error the application caused.
pub fn application_error() -> i64 {
    0x0c
}

/// Returns the transport error code CRYPTO_BUFFER_EXCEEDED, 0x0d, for more buffered handshake data than the endpoint keeps.
pub fn crypto_buffer_exceeded() -> i64 {
    0x0d
}

/// Returns the transport error code KEY_UPDATE_ERROR, 0x0e, for a key update that violates the rules of RFC 9001 section 6.
pub fn key_update_error() -> i64 {
    0x0e
}

/// Returns the transport error code AEAD_LIMIT_REACHED, 0x0f, for a packet protection key that reached its usage limit.
pub fn aead_limit_reached() -> i64 {
    0x0f
}

/// Returns the transport error code NO_VIABLE_PATH, 0x10, for a path that cannot carry packets of the minimum size.
pub fn no_viable_path() -> i64 {
    0x10
}

/// Returns the transport error code CRYPTO_ERROR for the TLS alert `alert`, which is `0x100 + alert`.
pub fn crypto_error(alert: i64) -> i64 {
    0x100 + alert
}
