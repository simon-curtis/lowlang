import std/crypto
import std/io

/// The kind of a QUIC packet, from its header.
pub enum PacketKind {
    /// A long header packet of type Initial.
    Initial
    /// A long header packet of type 0-RTT.
    ZeroRtt
    /// A long header packet of type Handshake.
    Handshake
    /// A Retry packet.
    Retry
    /// A Version Negotiation packet, which has version 0.
    VersionNegotiation
    /// A short header packet, which carries 1-RTT data.
    Short
    /// A long header packet of a version other than 1 whose type bits have no known meaning.
    Unknown
}

/// The fields of a packet header that are readable while header protection is still applied.
pub struct Header {
    /// The kind of packet.
    pub kind: PacketKind
    /// The version of a long header packet, and 0 for a short header packet.
    pub version: i64
    /// The destination connection ID. A short header packet has the length given to `parse_header`.
    pub dcid: []u8
    /// The source connection ID of a long header packet, and empty for a short header packet.
    pub scid: []u8 = []
    /// The token of an Initial packet, or the retry token of a Retry packet, and empty for other packets.
    pub token: []u8 = []
    /// The offset of the packet number field from the start of the packet, as used by `open`. It is 0 for packets without a packet number: Retry, Version Negotiation and unknown versions.
    pub pn_offset: i64 = 0
    /// The length in bytes of the packet within the datagram, so that coalesced packets can be split. A packet that has no length field extends to the end of the datagram.
    pub size: i64
    /// The versions a Version Negotiation packet lists, and empty for other packets.
    pub versions: []i64 = []
    /// The 16-byte Retry Integrity Tag of a Retry packet, and empty for other packets.
    pub tag: []u8 = []
}

fn copied(b: []u8) -> []u8 {
    let out: []u8 = __make(b.len)
    io.copy(out, b)
    out
}

/// Returns the version 1 value, `0x00000001`.
pub fn version1() -> i64 {
    1
}

/// Parses the packet header that starts at offset `at` of `datagram`, with header protection still applied.
///
/// `short_dcid_len` is the length of the connection IDs this endpoint issues, which a short header does not carry. The connection IDs and token are copies. For version 1, long header connection IDs above 20 bytes, a clear fixed bit, a length field running past the datagram and a Retry packet shorter than its tag are `Malformed`, as is a Version Negotiation packet whose version list is empty or not a multiple of 4 bytes. Version Negotiation packets and long header packets of other versions are parsed by their invariant fields only: the kind is `VersionNegotiation` or `Unknown` and the packet extends to the end of the datagram.
pub fn parse_header(datagram: []u8, at: i64, short_dcid_len: i64) -> Header ! io.Error {
    if at < 0 || at >= datagram.len {
        fail Malformed
    }
    let c = cursor(datagram[at..])
    let first = byte(c)?
    if first & 0x80 == 0 {
        return parse_short(c, first, short_dcid_len)
    }
    let version = u32_of(c)?
    let dcid_len = byte(c)?
    if version == 1 && dcid_len > 20 {
        fail Malformed
    }
    let dcid = copied(take(c, dcid_len)?)
    let scid_len = byte(c)?
    if version == 1 && scid_len > 20 {
        fail Malformed
    }
    let scid = copied(take(c, scid_len)?)
    let total = c.data.len
    if version == 0 {
        let versions = version_list(c)?
        return Header { kind: VersionNegotiation, version, dcid, scid, size: total, versions }
    }
    if version != 1 {
        return Header { kind: Unknown, version, dcid, scid, size: total }
    }
    if first & 0x40 == 0 {
        fail Malformed
    }
    let type_bits = first >> 4 & 3
    if type_bits == 3 {
        return parse_retry(c, version, dcid, scid)
    }
    var kind = PacketKind.Initial
    var token: []u8 = []
    if type_bits == 0 {
        let token_len = varint(c)?
        token = copied(take(c, token_len)?)
    } else if type_bits == 1 {
        kind = ZeroRtt
    } else {
        kind = Handshake
    }
    let length = varint(c)?
    let pn_offset = position(c)
    if length > left(c) {
        fail Malformed
    }
    Header { kind, version, dcid, scid, token, pn_offset, size: pn_offset + length }
}

fn parse_short(c: *Cursor, first: i64, dcid_len: i64) -> Header ! io.Error {
    if first & 0x40 == 0 {
        fail Malformed
    }
    let dcid = copied(take(c, dcid_len)?)
    Header { kind: Short, version: 0, dcid, pn_offset: 1 + dcid_len, size: c.data.len }
}

fn parse_retry(c: *Cursor, version: i64, dcid: []u8, scid: []u8) -> Header ! io.Error {
    let remaining = left(c)
    if remaining < 16 {
        fail Malformed
    }
    let token = copied(take(c, remaining - 16)?)
    let tag = copied(take(c, 16)?)
    Header { kind: Retry, version, dcid, scid, token, size: c.data.len, tag }
}

fn version_list(c: *Cursor) -> []i64 ! io.Error {
    let remaining = left(c)
    if remaining == 0 || remaining % 4 != 0 {
        fail Malformed
    }
    var out: []i64 = []
    for left(c) > 0 {
        push(mut out, u32_of(c)?)
    }
    out
}

/// Returns a Version Negotiation packet (RFC 9000 section 17.2.1) listing `versions`.
///
/// `dcid` is the source connection ID of the packet being answered and `scid` its destination connection ID. The first byte has the long header bit set and its other seven bits random.
pub fn version_negotiation(dcid: []u8, scid: []u8, versions: []i64) -> []u8 {
    let noise = crypto.random(1)
    var out: []u8 = []
    push(mut out, 0x80 | noise[0] & 0x7f)
    io.put_be32(mut out, 0)
    push(mut out, u8(dcid.len))
    io.append(mut out, dcid)
    push(mut out, u8(scid.len))
    io.append(mut out, scid)
    for v in versions {
        io.put_be32(mut out, v)
    }
    out
}
