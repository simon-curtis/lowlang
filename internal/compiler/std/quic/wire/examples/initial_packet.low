import std/io
import std/quic/wire

fn describe(f: wire.Frame) -> str {
    match f {
        Crypto(offset, data) => "CRYPTO offset {offset} {str(data)}"
        Padding(count) => "PADDING x{count}"
        _ => "other frame"
    }
}

fn opens(keys: wire.Keys, packet: []u8, header: wire.Header) -> bool {
    let opened = wire.open(keys, packet, header, -1) or return false
    opened.number >= 0
}

/// Protects a client Initial packet with the keys derived from its destination connection ID, then parses and opens it as a server would.
fn main() ! io.Error {
    let dcid: []u8 = [0x83, 0x94, 0xc8, 0xf0, 0x3e, 0x51, 0x57, 0x08]
    let scid: []u8 = [0xc1, 0x01]

    var payload: []u8 = []
    wire.put_frame(mut payload, wire.Frame.Crypto(0, bytes("client hello")))
    wire.put_frame(mut payload, wire.Frame.Padding(1100))

    var head: []u8 = [0xc0]
    io.put_be32(mut head, wire.version1)
    push(mut head, u8(dcid.len))
    io.append(mut head, dcid)
    push(mut head, u8(scid.len))
    io.append(mut head, scid)
    wire.put_varint(mut head, 0)
    wire.put_varint_sized(mut head, 1 + payload.len + 16, 2)
    push(mut head, 0)

    let client = wire.initial_keys(dcid, false)
    let packet = wire.seal(client, head, 0, payload)
    print("datagram of {packet.len} bytes")

    let header = wire.parse_header(packet, 0, 8)?
    print("{header.kind} version {header.version} dcid {header.dcid.len} bytes scid {header.scid.len} bytes size {header.size}")
    let opened = wire.open(wire.initial_keys(header.dcid, false), packet, header, -1)?
    print("packet number {opened.number}")
    for f in wire.parse_frames(opened.payload)? {
        print(describe(f))
    }

    print("server keys open it: {opens(wire.initial_keys(header.dcid, true), packet, header)}")
}
