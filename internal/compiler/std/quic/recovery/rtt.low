fn update_rtt(r: *Recovery, space: Space, ack_delay: i64, now: i64) {
    if r.first_rtt_sample < 0 {
        r.min_rtt = r.latest_rtt
        r.smoothed_rtt = r.latest_rtt
        r.rttvar = r.latest_rtt / 2
        r.first_rtt_sample = now
        return
    }
    if r.reset_min_rtt {
        r.min_rtt = r.latest_rtt
        r.reset_min_rtt = false
    } else {
        r.min_rtt = smaller(r.min_rtt, r.latest_rtt)
    }
    var delay = larger(ack_delay, 0)
    if space == Initial {
        delay = 0
    }
    if r.handshake_confirmed {
        delay = smaller(delay, r.max_ack_delay)
    }
    delay = smaller(delay, r.latest_rtt)
    var adjusted = r.latest_rtt
    if r.latest_rtt >= r.min_rtt + delay {
        adjusted = r.latest_rtt - delay
    }
    r.rttvar = (3 * r.rttvar + distance(r.smoothed_rtt, adjusted)) / 4
    r.smoothed_rtt = (7 * r.smoothed_rtt + adjusted) / 8
}
