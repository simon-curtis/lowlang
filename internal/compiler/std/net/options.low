import std/io

/// The TCP keep-alive settings of a connection.
pub struct Keepalive {
    /// Whether keep-alive probes are sent.
    pub enabled: bool
    /// Seconds the connection is idle before the first probe.
    pub idle: i64
    /// Seconds between probes.
    pub interval: i64
    /// Number of unanswered probes after which the connection is dropped.
    pub count: i64
}

/// The kernel buffer sizes of a socket, in bytes, as the kernel reports them.
pub struct BufferSizes {
    /// The receive buffer size.
    pub receive: i64
    /// The send buffer size.
    pub send: i64
}

fn get_int(fd: i64, level: i64, option: i64) -> i64 ! io.Error {
    let v = io.buffer(4)
    let size = io.buffer(4)
    io.set_le32(size, 0, 4)
    io.syscall_result(__syscall(55, fd, level, option, __slice_ptr(v), __slice_ptr(size)))?
    io.le32(v, 0)
}

fn set_raw(fd: i64, level: i64, option: i64, value: []u8) ! io.Error {
    io.syscall_result(__syscall(54, fd, level, option, __slice_ptr(value), value.len))?
}

/// Configures TCP keep-alive on `c`.
///
/// An `idle` of 0 or less turns keep-alive off. Otherwise it sets the idle time in seconds, sets `interval` and `count` when they are greater than 0 and leaves the system default otherwise, and turns keep-alive on. Fails with `NotConnected` if `c` is closed.
pub fn set_keepalive(c: Conn, idle: i64, interval: i64, count: i64) ! io.Error {
    using lease = io.enter(c.handle.guard)?
    let fd = c.handle.fd
    if idle <= 0 {
        set_int(fd, 1, 9, 0)?
        return
    }
    set_int(fd, 6, 4, idle)?
    if interval > 0 {
        set_int(fd, 6, 5, interval)?
    }
    if count > 0 {
        set_int(fd, 6, 6, count)?
    }
    set_int(fd, 1, 9, 1)?
}

/// Returns the keep-alive settings of `c`.
///
/// Fails with `NotConnected` if `c` is closed.
pub fn keepalive(c: Conn) -> Keepalive ! io.Error {
    using lease = io.enter(c.handle.guard)?
    let fd = c.handle.fd
    Keepalive {
        enabled: get_int(fd, 1, 9)? != 0
        idle: get_int(fd, 6, 4)?
        interval: get_int(fd, 6, 5)?
        count: get_int(fd, 6, 6)?
    }
}

fn apply_buffers(fd: i64, receive: i64, send: i64) ! io.Error {
    if receive > 0 {
        set_int(fd, 1, 8, receive)?
    }
    if send > 0 {
        set_int(fd, 1, 7, send)?
    }
}

fn read_buffers(fd: i64) -> BufferSizes ! io.Error {
    BufferSizes { receive: get_int(fd, 1, 8)?, send: get_int(fd, 1, 7)? }
}

/// Sets the receive and send buffer sizes of `c` in bytes.
///
/// A value of 0 or less leaves that buffer unchanged. The kernel can adjust the requested size, so read it back with `buffer_sizes`. Fails with `NotConnected` if `c` is closed.
pub fn set_buffer_sizes(c: Conn, receive: i64, send: i64) ! io.Error {
    using lease = io.enter(c.handle.guard)?
    apply_buffers(c.handle.fd, receive, send)?
}

/// Returns the receive and send buffer sizes of `c`.
///
/// Fails with `NotConnected` if `c` is closed.
pub fn buffer_sizes(c: Conn) -> BufferSizes ! io.Error {
    using lease = io.enter(c.handle.guard)?
    read_buffers(c.handle.fd)?
}

/// Sets the receive and send buffer sizes of the UDP socket `s` in bytes.
///
/// A value of 0 or less leaves that buffer unchanged. Fails with `NotConnected` if `s` is closed.
pub fn set_socket_buffer_sizes(s: Socket, receive: i64, send: i64) ! io.Error {
    using lease = io.enter(s.handle.guard)?
    apply_buffers(s.handle.fd, receive, send)?
}

/// Returns the receive and send buffer sizes of the UDP socket `s`.
///
/// Fails with `NotConnected` if `s` is closed.
pub fn socket_buffer_sizes(s: Socket) -> BufferSizes ! io.Error {
    using lease = io.enter(s.handle.guard)?
    read_buffers(s.handle.fd)?
}

fn multicast_group(group: []u8) -> bool {
    if group.len == 4 {
        return group[0] >= 224 && group[0] <= 239
    }
    group.len == 16 && group[0] == 0xFF
}

fn interface_number(interface: str) -> i64 ! io.Error {
    if interface.len == 0 {
        return 0
    }
    interface_index(interface)?
}

fn membership_request(group: []u8, index: i64) -> []u8 {
    var request: []u8 = []
    io.append(mut request, group)
    if group.len == 4 {
        io.put_be32(mut request, 0)
    }
    let tail = io.buffer(4)
    io.set_le32(tail, 0, index)
    io.append(mut request, tail)
    request
}

fn change_membership(s: Socket, group: []u8, interface: str, join: bool) ! io.Error {
    using lease = io.enter(s.handle.guard)?
    let family = s.handle.addr.ip.len
    if !multicast_group(group) || group.len != family {
        fail Invalid
    }
    let request = membership_request(group, interface_number(interface)?)
    if family == 4 {
        set_raw(s.handle.fd, 0, if join { 35 } else { 36 }, request)?
        return
    }
    set_raw(s.handle.fd, 41, if join { 20 } else { 21 }, request)?
}

/// Joins the multicast `group` on the UDP socket `s`.
///
/// `group` is 4 bytes in 224.0.0.0 to 239.255.255.255 or 16 bytes starting with `0xFF`, and must be the same family as the socket's bound address. `interface` names the network interface to join on, or is empty to let the system choose. Fails with `Invalid` if `group` is not a multicast address of the socket's family, with `NotFound` for an unknown interface and with `NotConnected` if `s` is closed.
pub fn join_group(s: Socket, group: []u8, interface: str) ! io.Error {
    change_membership(s, group, interface, true)?
}

/// Leaves the multicast `group` on the UDP socket `s`.
///
/// Arguments and errors are as for `join_group`.
pub fn leave_group(s: Socket, group: []u8, interface: str) ! io.Error {
    change_membership(s, group, interface, false)?
}

/// Sets the time to live, or hop limit, of multicast datagrams sent from `s` to `ttl`.
pub fn set_multicast_ttl(s: Socket, ttl: i64) ! io.Error {
    using lease = io.enter(s.handle.guard)?
    if s.handle.addr.ip.len == 4 {
        set_int(s.handle.fd, 0, 33, ttl)?
        return
    }
    set_int(s.handle.fd, 41, 18, ttl)?
}

/// Sets whether multicast datagrams sent from `s` are also delivered to sockets on the same host.
pub fn set_multicast_loop(s: Socket, on: bool) ! io.Error {
    using lease = io.enter(s.handle.guard)?
    let value = if on { 1 } else { 0 }
    if s.handle.addr.ip.len == 4 {
        set_int(s.handle.fd, 0, 34, value)?
        return
    }
    set_int(s.handle.fd, 41, 19, value)?
}

/// Sets the network interface that multicast datagrams from `s` leave through.
///
/// An empty `interface` restores the system's choice. Fails with `NotFound` for an unknown interface.
pub fn set_multicast_interface(s: Socket, interface: str) ! io.Error {
    using lease = io.enter(s.handle.guard)?
    let index = interface_number(interface)?
    if s.handle.addr.ip.len == 4 {
        set_raw(s.handle.fd, 0, 32, membership_request([0, 0, 0, 0], index))?
        return
    }
    set_int(s.handle.fd, 41, 17, index)?
}
