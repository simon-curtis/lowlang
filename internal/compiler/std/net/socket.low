import std/io

pub struct Conn {
    pub fd: i64
    pub remote: Addr
}

pub struct Listener {
    pub fd: i64
    pub addr: Addr
}

pub struct Socket {
    pub fd: i64
    pub addr: Addr
}

pub struct Packet {
    pub size: i64
    pub from: Addr
}

fn interrupted(r: i64) -> bool {
    r == -4
}

fn socket(domain: i64, kind: i64) -> i64 ! io.Error {
    io.syscall_result(__syscall(41, domain, kind | 0x80000, 0))
}

fn set_int(fd: i64, level: i64, option: i64, value: i64) ! io.Error {
    let v = io.buffer(4)
    io.set_le32(v, 0, value)
    io.syscall_result(__syscall(54, fd, level, option, __slice_ptr(v), 4))?
}

fn local(fd: i64) -> Addr ! io.Error {
    let buf = io.buffer(28)
    let size = io.buffer(4)
    io.set_le32(size, 0, 28)
    io.syscall_result(__syscall(51, fd, __slice_ptr(buf), __slice_ptr(size)))?
    from_sockaddr(buf)
}

fn bound(a: Addr, kind: i64) -> i64 ! io.Error {
    let fd = socket(family(a), kind)?
    set_int(fd, 1, 2, 1) catch {
        _ => {
            __syscall(3, fd)
            fail Invalid
        }
    }
    let sa = sockaddr(a)
    let r = __syscall(49, fd, __slice_ptr(sa), sa.len)
    if r < 0 {
        __syscall(3, fd)
        fail io.errno(-r)
    }
    fd
}

pub fn listen(host: str, port: i64) -> Listener ! io.Error {
    let ip = if host.len == 0 { parse_ip("0.0.0.0")? } else { lookup(host)?[0] }
    let fd = bound(Addr { ip, port }, 1)?
    let r = __syscall(50, fd, 4096)
    if r < 0 {
        __syscall(3, fd)
        fail io.errno(-r)
    }
    Listener { fd, addr: local(fd)? }
}

pub fn accept(l: Listener) -> Conn ! io.Error {
    let buf = io.buffer(28)
    let size = io.buffer(4)
    for {
        io.set_le32(size, 0, 28)
        let r = __syscall(288, l.fd, __slice_ptr(buf), __slice_ptr(size), 0x80000)
        if !interrupted(r) && r != -103 {
            return Conn { fd: io.syscall_result(r)?, remote: from_sockaddr(buf) }
        }
    }
}

pub fn close_listener(l: Listener) {
    __syscall(3, l.fd)
}

fn open_stream(a: Addr) -> i64 ! io.Error {
    let fd = socket(family(a), 1)?
    let sa = sockaddr(a)
    var r = __syscall(42, fd, __slice_ptr(sa), sa.len)
    for interrupted(r) {
        r = __syscall(42, fd, __slice_ptr(sa), sa.len)
    }
    if r < 0 {
        __syscall(3, fd)
        fail io.errno(-r)
    }
    fd
}

pub fn connect(a: Addr) -> Conn ! io.Error {
    Conn { fd: open_stream(a)?, remote: a }
}

pub fn dial(host: str, port: i64) -> Conn ! io.Error {
    let ips = lookup(host)?
    for ip in ips[..ips.len - 1] {
        let a = Addr { ip, port }
        let fd = open_stream(a) catch -1
        if fd >= 0 {
            return Conn { fd, remote: a }
        }
    }
    connect(Addr { ip: ips[ips.len - 1], port })
}

pub fn read(c: Conn, buf: []u8) -> i64 ! io.Error {
    for {
        let r = __syscall(45, c.fd, __slice_ptr(buf), buf.len, 0, 0, 0)
        if !interrupted(r) {
            return io.syscall_result(r)
        }
    }
}

pub fn write(c: Conn, data: []u8) -> i64 ! io.Error {
    for {
        let r = __syscall(44, c.fd, __slice_ptr(data), data.len, 0x4000, 0, 0)
        if !interrupted(r) {
            return io.syscall_result(r)
        }
    }
}

pub fn write_all(c: Conn, data: []u8) ! io.Error {
    var rest = data
    for rest.len > 0 {
        let n = write(c, rest)?
        rest = rest[n..]
    }
}

pub fn close(c: Conn) {
    __syscall(3, c.fd)
}

pub fn shutdown_write(c: Conn) ! io.Error {
    io.syscall_result(__syscall(48, c.fd, 1))?
}

pub fn local_addr(c: Conn) -> Addr ! io.Error {
    local(c.fd)
}

pub fn set_nodelay(c: Conn, on: bool) ! io.Error {
    set_int(c.fd, 6, 1, if on { 1 } else { 0 })?
}

fn set_timeout(fd: i64, option: i64, millis: i64) ! io.Error {
    let tv = io.buffer(16)
    io.set_le64(tv, 0, millis / 1000)
    io.set_le64(tv, 8, millis % 1000 * 1000)
    io.syscall_result(__syscall(54, fd, 1, option, __slice_ptr(tv), 16))?
}

pub fn set_read_timeout(c: Conn, millis: i64) ! io.Error {
    set_timeout(c.fd, 20, millis)?
}

pub fn set_write_timeout(c: Conn, millis: i64) ! io.Error {
    set_timeout(c.fd, 21, millis)?
}

pub fn stream(c: Conn) -> io.Stream {
    io.Stream {
        read: fn(buf) { read(c, buf) }
        write: fn(data) { write(c, data) }
        close: fn() { close(c) }
    }
}

pub fn bind_udp(host: str, port: i64) -> Socket ! io.Error {
    let ip = if host.len == 0 { parse_ip("0.0.0.0")? } else { lookup(host)?[0] }
    let fd = bound(Addr { ip, port }, 2)?
    Socket { fd, addr: local(fd)? }
}

pub fn send_to(s: Socket, data: []u8, to: Addr) -> i64 ! io.Error {
    let sa = sockaddr(to)
    for {
        let r = __syscall(44, s.fd, __slice_ptr(data), data.len, 0x4000, __slice_ptr(sa), sa.len)
        if !interrupted(r) {
            return io.syscall_result(r)
        }
    }
}

pub fn receive_from(s: Socket, buf: []u8) -> Packet ! io.Error {
    let sa = io.buffer(28)
    let size = io.buffer(4)
    for {
        io.set_le32(size, 0, 28)
        let r = __syscall(45, s.fd, __slice_ptr(buf), buf.len, 0, __slice_ptr(sa), __slice_ptr(size))
        if !interrupted(r) {
            return Packet { size: io.syscall_result(r)?, from: from_sockaddr(sa) }
        }
    }
}

pub fn set_receive_timeout(s: Socket, millis: i64) ! io.Error {
    set_timeout(s.fd, 20, millis)?
}

pub fn close_socket(s: Socket) {
    __syscall(3, s.fd)
}
