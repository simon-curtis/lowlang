import std/io

pub struct Timeouts {
    pub read: i64
    pub write: i64
}

pub struct Conn {
    pub fd: i64
    pub out: i64
    pub remote: Addr
    pub timeouts: *Timeouts
    users: *Users
}

struct Users {
    lock: i64
    count: i64
    closed: bool
}

pub struct Listener {
    pub fd: i64
    pub addr: Addr
}

pub struct Socket {
    pub fd: i64
    pub addr: Addr
    pub timeouts: *Timeouts
}

pub struct Packet {
    pub size: i64
    pub from: Addr
}

struct Watch {
    done: bool
    fired: bool
}

fn conn(fd: i64, remote: Addr) -> Conn {
    let out = __syscall(72, fd, 1030, 0)
    Conn { fd, out: if out < 0 { fd } else { out }, remote, timeouts: no_timeouts(), users: new(Users { lock: 0, count: 0, closed: false }) }
}

fn no_timeouts() -> *Timeouts {
    new(Timeouts { read: 0, write: 0 })
}

fn expire(fd: i64, millis: i64, w: *Watch) {
    sleep(millis)
    if !w.done {
        w.fired = true
        __syscall(48, fd, 2)
    }
}

fn wait(fd: i64, writable: bool, millis: i64) ! io.Error {
    var w: *Watch? = none
    if millis > 0 {
        let watch = new(Watch { done: false, fired: false })
        spawn expire(fd, millis, watch)
        w = watch
    }
    if writable {
        wait_writable(fd)
    } else {
        wait_readable(fd)
    }
    match w {
        some(watch) => {
            watch.done = true
            if watch.fired {
                fail TimedOut
            }
        }
        none => {}
    }
}

fn retry(fd: i64, writable: bool, millis: i64, op: fn() -> i64) -> i64 ! io.Error {
    for {
        let r = op()
        if r == -11 {
            wait(fd, writable, millis)?
        } else if r != -4 {
            return io.syscall_result(r)
        }
    }
}

fn socket(domain: i64, kind: i64) -> i64 ! io.Error {
    io.syscall_result(__syscall(41, domain, kind | 0x80800, 0))
}

fn set_int(fd: i64, level: i64, option: i64, value: i64) ! io.Error {
    let v = io.buffer(4)
    io.set_le32(v, 0, value)
    io.syscall_result(__syscall(54, fd, level, option, __slice_ptr(v), 4))?
}

fn socket_error(fd: i64) -> i64 {
    let v = io.buffer(4)
    let size = io.buffer(4)
    io.set_le32(size, 0, 4)
    let r = __syscall(55, fd, 1, 4, __slice_ptr(v), __slice_ptr(size))
    if r < 0 { -r } else { io.le32(v, 0) }
}

fn local(fd: i64) -> Addr ! io.Error {
    let buf = io.buffer(28)
    let size = io.buffer(4)
    io.set_le32(size, 0, 28)
    io.syscall_result(__syscall(51, fd, __slice_ptr(buf), __slice_ptr(size)))?
    from_sockaddr(buf)
}

fn bound(a: Addr, kind: i64) -> i64 ! io.Error {
    let fd = socket(family(a), kind)?
    set_int(fd, 1, 2, 1) catch {
        _ => {
            __syscall(3, fd)
            fail Invalid
        }
    }
    let sa = sockaddr(a)
    let r = __syscall(49, fd, __slice_ptr(sa), sa.len)
    if r < 0 {
        __syscall(3, fd)
        fail io.errno(-r)
    }
    fd
}

fn resolve_local(host: str) -> []u8 ! io.Error {
    if host.len == 0 {
        return parse_ip("0.0.0.0")
    }
    lookup(host)?[0]
}

pub fn listen(host: str, port: i64) -> Listener ! io.Error {
    let fd = bound(Addr { ip: resolve_local(host)?, port }, 1)?
    let r = __syscall(50, fd, 4096)
    if r < 0 {
        __syscall(3, fd)
        fail io.errno(-r)
    }
    Listener { fd, addr: local(fd)? }
}

pub fn accept(l: Listener) -> Conn ! io.Error {
    let buf = io.buffer(28)
    let size = io.buffer(4)
    for {
        io.set_le32(size, 0, 28)
        let r = __syscall(288, l.fd, __slice_ptr(buf), __slice_ptr(size), 0x80800)
        if r == -11 {
            wait_readable(l.fd)
        } else if r >= 0 {
            return conn(r, from_sockaddr(buf))
        } else if r != -4 && r != -103 {
            fail io.errno(-r)
        }
    }
}

pub fn close_listener(l: Listener) {
    __syscall(3, l.fd)
}

fn open_stream(a: Addr, millis: i64) -> i64 ! io.Error {
    let fd = socket(family(a), 1)?
    let sa = sockaddr(a)
    var r = __syscall(42, fd, __slice_ptr(sa), sa.len)
    for r == -4 {
        r = __syscall(42, fd, __slice_ptr(sa), sa.len)
    }
    if r == -115 {
        wait(fd, true, millis) catch {
            _ => {
                __syscall(3, fd)
                fail TimedOut
            }
        }
        r = -socket_error(fd)
    }
    if r < 0 {
        __syscall(3, fd)
        fail io.errno(-r)
    }
    fd
}

pub fn connect(a: Addr) -> Conn ! io.Error {
    connect_within(a, 0)
}

pub fn connect_within(a: Addr, millis: i64) -> Conn ! io.Error {
    conn(open_stream(a, millis)?, a)
}

pub fn dial(host: str, port: i64) -> Conn ! io.Error {
    dial_within(host, port, 0)
}

pub fn dial_within(host: str, port: i64, millis: i64) -> Conn ! io.Error {
    let ips = lookup(host)?
    for ip in ips[..ips.len - 1] {
        let a = Addr { ip, port }
        let fd = open_stream(a, millis) catch -1
        if fd >= 0 {
            return conn(fd, a)
        }
    }
    connect_within(Addr { ip: ips[ips.len - 1], port }, millis)
}

fn enter(c: Conn) ! io.Error {
    let u = c.users
    __lock(mut u.lock)
    if u.closed {
        __unlock(mut u.lock)
        fail NotConnected
    }
    u.count += 1
    __unlock(mut u.lock)
}

fn leave(c: Conn) {
    let u = c.users
    __lock(mut u.lock)
    u.count -= 1
    let last = u.closed && u.count == 0
    __unlock(mut u.lock)
    if last {
        release(c)
    }
}

fn release(c: Conn) {
    if c.out != c.fd {
        __syscall(3, c.out)
    }
    __syscall(3, c.fd)
}

pub fn read(c: Conn, buf: []u8) -> i64 ! io.Error {
    enter(c)?
    defer leave(c)
    retry(c.fd, false, c.timeouts.read, fn() -> i64 { __syscall(45, c.fd, __slice_ptr(buf), buf.len, 0, 0, 0) })
}

pub fn write(c: Conn, data: []u8) -> i64 ! io.Error {
    enter(c)?
    defer leave(c)
    retry(c.out, true, c.timeouts.write, fn() -> i64 { __syscall(44, c.out, __slice_ptr(data), data.len, 0x4000, 0, 0) })
}

pub fn write_all(c: Conn, data: []u8) ! io.Error {
    var rest = data
    for rest.len > 0 {
        let n = write(c, rest)?
        rest = rest[n..]
    }
}

pub fn close(c: Conn) {
    let u = c.users
    __lock(mut u.lock)
    if u.closed {
        __unlock(mut u.lock)
        return
    }
    u.closed = true
    let idle = u.count == 0
    __unlock(mut u.lock)
    __syscall(48, c.fd, 2)
    if idle {
        release(c)
    }
}

pub fn shutdown_write(c: Conn) ! io.Error {
    io.syscall_result(__syscall(48, c.fd, 1))?
}

pub fn local_addr(c: Conn) -> Addr ! io.Error {
    local(c.fd)
}

pub fn set_nodelay(c: Conn, on: bool) ! io.Error {
    set_int(c.fd, 6, 1, if on { 1 } else { 0 })?
}

pub fn set_read_timeout(c: Conn, millis: i64) {
    c.timeouts.read = millis
}

pub fn set_write_timeout(c: Conn, millis: i64) {
    c.timeouts.write = millis
}

pub fn stream(c: Conn) -> io.Stream {
    io.Stream {
        read: fn(buf) { read(c, buf) }
        write: fn(data) { write(c, data) }
        close: fn() { close(c) }
    }
}

pub fn bind_udp(host: str, port: i64) -> Socket ! io.Error {
    let fd = bound(Addr { ip: resolve_local(host)?, port }, 2)?
    Socket { fd, addr: local(fd)?, timeouts: no_timeouts() }
}

pub fn send_to(s: Socket, data: []u8, to: Addr) -> i64 ! io.Error {
    let sa = sockaddr(to)
    retry(s.fd, true, s.timeouts.write, fn() -> i64 {
        __syscall(44, s.fd, __slice_ptr(data), data.len, 0x4000, __slice_ptr(sa), sa.len)
    })
}

pub fn receive_from(s: Socket, buf: []u8) -> Packet ! io.Error {
    let sa = io.buffer(28)
    let size = io.buffer(4)
    let n = retry(s.fd, false, s.timeouts.read, fn() -> i64 {
        io.set_le32(size, 0, 28)
        __syscall(45, s.fd, __slice_ptr(buf), buf.len, 0, __slice_ptr(sa), __slice_ptr(size))
    })?
    Packet { size: n, from: from_sockaddr(sa) }
}

pub fn set_receive_timeout(s: Socket, millis: i64) {
    s.timeouts.read = millis
}

pub fn close_socket(s: Socket) {
    __syscall(3, s.fd)
}
