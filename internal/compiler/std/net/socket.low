import std/io
import std/sys

/// The read and write timeouts of a connection or socket, in milliseconds.
///
/// A value of 0 or less means no timeout. All copies of a handle share one `Timeouts`.
pub struct Timeouts {
    /// The longest a read waits for data.
    pub read: i64
    /// The longest a write waits for buffer space.
    pub write: i64
}

/// A copyable view of a TCP or Unix stream connection.
///
/// Every copy shares the connection, its timeouts and its closed state, so one green thread can read while another writes. The view does not close the connection when released; `close_on` does, and `Conn` does when dropped.
pub struct ConnHandle {
    /// The descriptor used for reading.
    pub fd: i64
    /// The descriptor used for writing, from `sys.write_view`, which waits for buffer space independently of reads from `fd`.
    pub out: i64
    /// The address of the peer, as known when the connection was made.
    pub remote: Addr
    /// The read and write timeouts, shared by every copy of the handle.
    pub timeouts: *Timeouts
    guard: *io.Guard
}

/// The owner of a connection.
///
/// Dropping it closes the connection unless `detach` took the view.
pub struct Conn {
    /// The copyable view of the connection.
    pub handle: ConnHandle
    detached: bool = false
    drop {
        if !detached {
            close_on(handle)
        }
    }
}

/// A copyable view of a listening socket.
///
/// Every copy shares the socket and its closed state. The view does not close the socket when released; `close_listener_on` does, and `Listener` does when dropped.
pub struct ListenerHandle {
    /// The descriptor of the listening socket.
    pub fd: i64
    /// The address the socket is bound to, with the actual port when port 0 was requested.
    pub addr: Addr
    closing: *Watch
    guard: *io.Guard
}

/// The owner of a listening socket.
///
/// Dropping it closes the socket unless `detach_listener` took the view.
pub struct Listener {
    /// The copyable view of the listener.
    pub handle: ListenerHandle
    detached: bool = false
    drop {
        if !detached {
            close_listener_on(handle)
        }
    }
}

/// A copyable view of a UDP socket.
///
/// Every copy shares the socket, its timeouts and its closed state. The view does not close the socket when released; `close_socket_on` does, and `Socket` does when dropped.
pub struct SocketHandle {
    /// The descriptor of the socket.
    pub fd: i64
    /// The address the socket is bound to, with the actual port when port 0 was requested.
    pub addr: Addr
    /// The timeouts, shared by every copy of the handle.
    pub timeouts: *Timeouts
    guard: *io.Guard
}

/// The owner of a UDP socket.
///
/// Dropping it closes the socket.
pub struct Socket {
    /// The copyable view of the socket.
    pub handle: SocketHandle
    drop close_socket_on(handle)
}

/// A received datagram: its length and sender.
pub struct Packet {
    /// The number of bytes written into the receive buffer.
    ///
    /// A datagram longer than the buffer is truncated to the buffer's length.
    pub size: i64
    /// The address the datagram came from.
    pub from: Addr
}

struct Watch {
    done: bool
    fired: bool
}

fn shut_down(fd: i64) {
    sys.shutdown(fd, sys.Shutdown.Both) or {}
}

fn shut_down_conn(fd: i64, out: i64) {
    shut_down(fd)
    shut_down(out)
}

fn conn_guard(fd: i64, out: i64) -> *io.Guard {
    io.guard(fn() { shut_down_conn(fd, out) }, fn() {
        sys.close_fd(out)
        sys.close_fd(fd)
    })
}

fn conn(fd: i64, remote: Addr) -> ConnHandle ! io.Error {
    let out = sys.write_view(fd) catch {
        e => {
            sys.close_fd(fd)
            fail e
        }
    }
    ConnHandle { fd, out, remote, timeouts: no_timeouts(), guard: conn_guard(fd, out) }
}

fn no_timeouts() -> *Timeouts {
    new(Timeouts { read: 0, write: 0 })
}

fn expire(stop: fn(), millis: i64, w: *Watch) {
    sleep(millis)
    if !w.done {
        w.fired = true
        stop()
    }
}

fn wait(fd: i64, writable: bool, millis: i64, stop: fn()) ! io.Error {
    var w: *Watch? = none
    if millis > 0 {
        let watch = new(Watch { done: false, fired: false })
        spawn expire(stop, millis, watch)
        w = watch
    }
    sys.wait_socket(fd, writable)
    match w {
        some(watch) => {
            watch.done = true
            if watch.fired {
                fail TimedOut
            }
        }
        none => {}
    }
}

fn retry(fd: i64, writable: bool, millis: i64, stop: fn(), op: fn() -> i64 ! io.Error) -> i64 ! io.Error {
    for {
        let n = op() catch {
            WouldBlock => -1
            e => fail e
        }
        if n >= 0 {
            return n
        }
        wait(fd, writable, millis, stop)?
    }
}

fn local(fd: i64) -> Addr ! io.Error {
    let address = sys.local_address(fd)?
    from_sockaddr(address, address.len)
}

fn bound(a: Addr, kind: sys.SocketKind, o: ListenOptions) -> sys.Fd ! io.Error {
    let fd = sys.socket(family(a), kind)?
    using p = sys.own(fd)
    if o.reuse_addr {
        sys.set_option(fd, sys.SocketOption.ReuseAddr, 1) or fail Invalid
    }
    if o.reuse_port {
        sys.set_option(fd, sys.SocketOption.ReusePort, 1) or fail Invalid
    }
    let sa = sockaddr(a)
    sys.bind(fd, sa)?
    p
}

fn resolve_local(host: str) -> []u8 ! io.Error {
    if host.len == 0 {
        return parse_ip("0.0.0.0")
    }
    lookup(host)?[0]
}

fn socket_guard(fd: i64) -> *io.Guard {
    io.guard(fn() { shut_down(fd) }, fn() { sys.close_fd(fd) })
}

/// Options for `listen_with` and `bind_udp_with`.
pub struct ListenOptions {
    /// Whether to set `SO_REUSEADDR` before binding, which lets a restarted program bind a port still in `TIME_WAIT`.
    pub reuse_addr: bool = true
    /// Whether to set `SO_REUSEPORT` before binding, which lets several sockets bind the same port.
    pub reuse_port: bool = false
    /// The length of the queue of connections waiting to be accepted. UDP sockets ignore it.
    pub backlog: i64 = 4096
}

/// Listens for TCP connections on `host` and `port`.
///
/// Uses the default `ListenOptions`. An empty `host` listens on all IPv4 addresses, `::` on all IPv6 addresses, and any other name is resolved with `lookup` and its first address is used. Port 0 chooses a free port, which `handle.addr.port` reports. Fails with `AddrInUse` if the port is taken and `Denied` if the caller may not bind it.
pub fn listen(host: str, port: i64) -> Listener ! io.Error {
    listen_with(host, port, ListenOptions {})
}

/// Listens for TCP connections on `host` and `port` with the given options.
///
/// `host` and `port` are used as for `listen`. Fails with `Invalid` if the system rejects `reuse_addr` or `reuse_port`.
pub fn listen_with(host: str, port: i64, o: ListenOptions) -> Listener ! io.Error {
    let target = Addr { ip: resolve_local(host)?, port }
    using var p = bound(target, sys.SocketKind.Streaming, o)?
    open_listener(mut p, o.backlog, "")?
}

fn listener_guard(fd: i64, closing: *Watch, path: str) -> *io.Guard {
    io.guard(fn() {
        closing.done = true
        shut_down(fd)
    }, fn() {
        sys.close_fd(fd)
        if path.len > 0 && !abstract_path(path) {
            sys.unlink(path) or {}
        }
    })
}

fn open_listener(mut p: sys.Fd, backlog: i64, path: str) -> Listener ! io.Error {
    sys.listen(p.handle.fd, backlog)?
    let addr = local(p.handle.fd)?
    let fd = sys.detach(mut p).fd
    let closing = new(Watch { done: false, fired: false })
    Listener { handle: ListenerHandle { fd, addr, closing, guard: listener_guard(fd, closing, path) } }
}

/// Accepts the next connection on `l`.
///
/// Parks the green thread until a connection arrives. Fails with `NotConnected` once the listener is closed, including while the call is waiting.
pub fn accept(l: Listener) -> Conn ! io.Error {
    let h = accept_handle(l.handle)?
    adopt(h)
}

/// Accepts the next connection on the listener behind `h` and returns its view.
///
/// Parks the green thread until a connection arrives. The caller owns the connection, usually by passing the view to a green thread that binds it with `adopt`. Fails with `NotConnected` once the listener is closed, including while the call is waiting. A connection reset before it was accepted is skipped.
pub fn accept_handle(h: ListenerHandle) -> ConnHandle ! io.Error {
    using lease = io.enter(h.guard)?
    for {
        let accepted = sys.accept(h.fd) catch {
            WouldBlock => {
                sys.wait_socket(h.fd, false)
                if h.closing.done {
                    fail NotConnected
                }
                continue
            }
            e => fail e
        }
        let remote = from_sockaddr(accepted.address, accepted.address.len)
        return conn(accepted.fd, remote)
    }
}

/// Returns the `Conn` that owns the connection behind `h`, which closes it when dropped.
pub fn adopt(h: ConnHandle) -> Conn {
    Conn { handle: h }
}

/// Stops `c` from closing the connection when dropped, and returns its view.
///
/// The caller must close the connection with `close_on`.
pub fn detach(mut c: Conn) -> ConnHandle {
    c.detached = true
    c.handle
}

/// Stops `l` from closing the socket when dropped, and returns its view.
///
/// The caller must close the socket with `close_listener_on`.
pub fn detach_listener(mut l: Listener) -> ListenerHandle {
    l.detached = true
    l.handle
}

/// Closes the listener `l`.
///
/// Does the same as `close_listener_on` on its handle.
pub fn close_listener(l: Listener) {
    close_listener_on(l.handle)
}

/// Closes the listener behind `h`.
///
/// Wakes a green thread waiting in `accept`, which fails with `NotConnected`. The socket is released once no `accept` is in progress, and a Unix socket file is removed. Later calls do nothing.
pub fn close_listener_on(h: ListenerHandle) {
    io.retire(h.guard)
}

fn start_connect(fd: i64, address: []u8, unix: bool, millis: i64) -> bool ! io.Error {
    var waited = 0
    let limit = if millis > 0 { millis } else { 30000 }
    for {
        let complete = sys.connect(fd, address) catch {
            WouldBlock => {
                if !unix {
                    fail WouldBlock
                }
                if waited >= limit {
                    fail TimedOut
                }
                sleep(1)
                waited += 1
                continue
            }
            e => fail e
        }
        return complete
    }
}

/// Connects to the TCP or Unix address `a`.
///
/// Parks the green thread while the connection is in progress, with no time limit of its own. Does the same as `connect_within` with no timeout.
pub fn connect(a: Addr) -> Conn ! io.Error {
    connect_within(a, 0)
}

/// Connects to `a`, failing with `TimedOut` if the connection takes longer than `millis` milliseconds.
///
/// A `millis` of 0 or less means no limit. Parks the green thread while the connection is in progress. Fails with `Refused` or `Unreachable` as the system reports.
pub fn connect_within(a: Addr, millis: i64) -> Conn ! io.Error {
    connect_through(a, "", millis)
}

/// Connects to `a` through the network interface `device`.
///
/// Binds the socket to `device` before connecting, which usually needs privileges. An empty `device` leaves the choice to the system. `millis` is the timeout as for `connect_within`.
pub fn connect_through(a: Addr, device: str, millis: i64) -> Conn ! io.Error {
    let fd = sys.socket(family(a), sys.SocketKind.Streaming)?
    let handle = conn(fd, a)?
    using c = adopt(handle)
    if device.len > 0 {
        sys.bind_device(fd, device)?
    }
    let sa = sockaddr(a)
    let complete = start_connect(fd, sa, is_unix(a), millis)?
    if !complete {
        wait(fd, true, millis, fn() { shut_down_conn(handle.fd, handle.out) }) or fail TimedOut
        sys.finish_connect(fd)?
    }
    c
}

/// Connects to the first of the addresses `ips` that accepts a connection on `port`.
///
/// Tries the addresses in order, each with the timeout `millis` and through `device` as for `connect_through`, and moves on after a failure. The error of the last address is the one returned. Fails with `NotFound` if `ips` is empty.
pub fn connect_first(ips: [][]u8, port: i64, device: str, millis: i64) -> Conn ! io.Error {
    if ips.len == 0 {
        fail NotFound
    }
    for ip in ips[..ips.len - 1] {
        let a = Addr { ip, port }
        using c = connect_through(a, device, millis) or continue
        return c
    }
    connect_through(Addr { ip: ips[ips.len - 1], port }, device, millis)
}

/// Returns the kernel index of the network interface `name`.
///
/// Fails with `Invalid` if `name` is empty or, on Linux, longer than 15 bytes; Windows has no length limit. Fails with `NotFound` if there is no such interface.
pub fn interface_index(name: str) -> i64 ! io.Error {
    sys.interface_index(name)?
}

/// Resolves `host` with `lookup` and connects to `port` on the first address that accepts.
///
/// Parks the green thread while resolving and connecting, with no connect timeout.
pub fn dial(host: str, port: i64) -> Conn ! io.Error {
    dial_within(host, port, 0)
}

/// Resolves `host` with `lookup` and connects to `port`, with each connection attempt limited to `millis` milliseconds.
///
/// Parks the green thread while resolving and connecting. See `connect_first` for the order of attempts.
pub fn dial_within(host: str, port: i64, millis: i64) -> Conn ! io.Error {
    connect_first(lookup(host)?, port, "", millis)
}

/// Reads up to `buf.len` bytes from `c` into `buf` and returns the count, or `0` at end of input.
///
/// Parks the green thread until data arrives. If the read timeout elapses first, the connection is shut down and the call fails with `TimedOut`. Fails with `NotConnected` after the connection is closed, including while the call is waiting.
pub fn read(c: Conn, buf: []u8) -> i64 ! io.Error {
    read_on(c.handle, buf)
}

/// Reads up to `buf.len` bytes from the connection behind `h` into `buf` and returns the count, or `0` at end of input.
///
/// Parks the green thread until data arrives. If the read timeout elapses first, the connection is shut down and the call fails with `TimedOut`. Fails with `NotConnected` after the connection is closed, including while the call is waiting.
pub fn read_on(h: ConnHandle, buf: []u8) -> i64 ! io.Error {
    using lease = io.enter(h.guard)?
    retry(h.fd, false, h.timeouts.read, fn() { shut_down_conn(h.fd, h.out) }, fn() -> i64 ! io.Error { sys.recv(h.fd, buf)? })
}

/// Writes a prefix of `data` to `c` and returns how many bytes were written, which can be fewer than `data.len`.
///
/// Parks the green thread while the send buffer is full. If the write timeout elapses first, the connection is shut down and the call fails with `TimedOut`. A peer that has closed the connection gives `BrokenPipe` or `Reset` and never raises `SIGPIPE`. Fails with `NotConnected` after the connection is closed.
pub fn write(c: Conn, data: []u8) -> i64 ! io.Error {
    write_on(c.handle, data)
}

/// Writes a prefix of `data` to the connection behind `h` and returns how many bytes were written, which can be fewer than `data.len`.
///
/// Parks the green thread while the send buffer is full. If the write timeout elapses first, the connection is shut down and the call fails with `TimedOut`. A peer that has closed the connection gives `BrokenPipe` or `Reset` and never raises `SIGPIPE`. Fails with `NotConnected` after the connection is closed.
pub fn write_on(h: ConnHandle, data: []u8) -> i64 ! io.Error {
    using lease = io.enter(h.guard)?
    retry(h.out, true, h.timeouts.write, fn() { shut_down_conn(h.fd, h.out) }, fn() -> i64 ! io.Error { sys.send(h.out, data)? })
}

/// Writes all of `data` to `c`.
///
/// Repeats `write` until nothing is left and fails with its first error.
pub fn write_all(c: Conn, data: []u8) ! io.Error {
    write_all_on(c.handle, data)?
}

/// Writes all of `data` to the connection behind `h`.
///
/// Repeats `write_on` until nothing is left and fails with its first error.
pub fn write_all_on(h: ConnHandle, data: []u8) ! io.Error {
    var rest = data
    for rest.len > 0 {
        let n = write_on(h, rest)?
        rest = rest[n..]
    }
}

/// Closes the connection `c`.
///
/// Does the same as `close_on` on its handle.
pub fn close(c: Conn) {
    close_on(c.handle)
}

/// Closes the connection behind `h`.
///
/// Shuts the connection down so green threads waiting to read or write wake and fail, and releases the descriptors once the last operation in progress has finished. Later reads and writes fail with `NotConnected`. Later calls do nothing.
pub fn close_on(h: ConnHandle) {
    io.retire(h.guard)
}

/// Closes the sending side of `c` while leaving it open for reading.
///
/// Does the same as `shutdown_write_on` on its handle.
pub fn shutdown_write(c: Conn) ! io.Error {
    shutdown_write_on(c.handle)
}

/// Closes the sending side of the connection behind `h` while leaving it open for reading.
///
/// The peer then reads end of input after the data already sent. Fails with `NotConnected` if the connection is closed.
pub fn shutdown_write_on(h: ConnHandle) ! io.Error {
    using lease = io.enter(h.guard)?
    sys.shutdown(h.fd, sys.Shutdown.Sending)?
}

/// Returns the local address of `c`.
///
/// Fails with `NotConnected` if `c` is closed.
pub fn local_addr(c: Conn) -> Addr ! io.Error {
    using lease = io.enter(c.handle.guard)?
    local(c.handle.fd)
}

/// Sets `TCP_NODELAY` on `c`, which sends small writes at once instead of waiting to combine them.
///
/// Fails with `NotConnected` if `c` is closed.
pub fn set_nodelay(c: Conn, on: bool) ! io.Error {
    using lease = io.enter(c.handle.guard)?
    sys.set_option(c.handle.fd, sys.SocketOption.NoDelay, if on { 1 } else { 0 })?
}

/// Sets how long reads on `c` wait for data, in milliseconds, with 0 or less meaning no limit.
///
/// Applies to later reads on every copy of the handle. A read that times out shuts the connection down.
pub fn set_read_timeout(c: Conn, millis: i64) {
    c.handle.timeouts.read = millis
}

/// Sets how long writes on `c` wait for buffer space, in milliseconds, with 0 or less meaning no limit.
///
/// Applies to later writes on every copy of the handle. A write that times out shuts the connection down.
pub fn set_write_timeout(c: Conn, millis: i64) {
    c.handle.timeouts.write = millis
}

/// Returns an `io.Stream` over `c`.
///
/// Its `read`, `write` and `close` call `read`, `write` and `close` on the connection.
pub fn stream(c: Conn) -> io.Stream {
    stream_on(c.handle)
}

/// Returns an `io.Stream` over the connection behind `h`.
///
/// Its `read`, `write` and `close` call `read_on`, `write_on` and `close_on`.
pub fn stream_on(h: ConnHandle) -> io.Stream {
    io.Stream {
        read: fn(buf) { read_on(h, buf) }
        write: fn(data) { write_on(h, data) }
        close: fn() { close_on(h) }
    }
}

/// Binds a UDP socket to `host` and `port`.
///
/// Uses the default `ListenOptions`. `host` is resolved as for `listen`. Port 0 chooses a free port, which `handle.addr.port` reports.
pub fn bind_udp(host: str, port: i64) -> Socket ! io.Error {
    bind_udp_with(host, port, ListenOptions {})
}

/// Binds a UDP socket to `host` and `port` with the given options.
///
/// `host` and `port` are used as for `bind_udp`. Fails with `Invalid` if the system rejects `reuse_addr` or `reuse_port`.
pub fn bind_udp_with(host: str, port: i64, o: ListenOptions) -> Socket ! io.Error {
    let target = Addr { ip: resolve_local(host)?, port }
    using var p = bound(target, sys.SocketKind.Datagrams, o)?
    let addr = local(p.handle.fd)?
    let fd = sys.detach(mut p).fd
    Socket { handle: SocketHandle { fd, addr, timeouts: no_timeouts(), guard: socket_guard(fd) } }
}

/// Sends `data` as one datagram to `to` and returns the number of bytes sent.
///
/// Parks the green thread while the send buffer is full. `to` must be an address of the socket's family. Fails with `NotConnected` if the socket is closed.
pub fn send_to(s: Socket, data: []u8, to: Addr) -> i64 ! io.Error {
    using lease = io.enter(s.handle.guard)?
    let h = s.handle
    let sa = sockaddr(to)
    retry(h.fd, true, h.timeouts.write, fn() { shut_down(h.fd) }, fn() -> i64 ! io.Error { sys.send_to(h.fd, data, sa)? })
}

/// Receives one datagram into `buf` and returns its length and sender.
///
/// Parks the green thread until a datagram arrives. A datagram longer than `buf` is truncated. If the receive timeout elapses first, the socket is shut down and the call fails with `TimedOut`. Fails with `NotConnected` if the socket is closed.
pub fn receive_from(s: Socket, buf: []u8) -> Packet ! io.Error {
    using lease = io.enter(s.handle.guard)?
    let h = s.handle
    for {
        let received = sys.recv_from(h.fd, buf) catch {
            WouldBlock => {
                wait(h.fd, false, h.timeouts.read, fn() { shut_down(h.fd) })?
                continue
            }
            e => fail e
        }
        let from = from_sockaddr(received.address, received.address.len)
        return Packet { size: received.size, from }
    }
}

/// Sets how long `receive_from` waits on `s`, in milliseconds, with 0 or less meaning no limit.
///
/// A receive that times out shuts the socket down.
pub fn set_receive_timeout(s: Socket, millis: i64) {
    s.handle.timeouts.read = millis
}

/// Closes the UDP socket `s`.
///
/// Does the same as `close_socket_on` on its handle.
pub fn close_socket(s: Socket) {
    close_socket_on(s.handle)
}

/// Closes the UDP socket behind `h`.
///
/// Wakes green threads waiting to send or receive, which fail, and releases the descriptor once the last operation in progress has finished. Later calls do nothing.
pub fn close_socket_on(h: SocketHandle) {
    io.retire(h.guard)
}
