import std/io

pub struct Timeouts {
    pub read: i64
    pub write: i64
}

pub struct ConnHandle {
    pub fd: i64
    pub out: i64
    pub remote: Addr
    pub timeouts: *Timeouts
    guard: *io.Guard
}

pub struct Conn {
    pub handle: ConnHandle
    detached: bool = false
    drop {
        if !detached {
            close_on(handle)
        }
    }
}

pub struct ListenerHandle {
    pub fd: i64
    pub addr: Addr
    closing: *Watch
    guard: *io.Guard
}

pub struct Listener {
    pub handle: ListenerHandle
    detached: bool = false
    drop {
        if !detached {
            close_listener_on(handle)
        }
    }
}

pub struct SocketHandle {
    pub fd: i64
    pub addr: Addr
    pub timeouts: *Timeouts
    guard: *io.Guard
}

pub struct Socket {
    pub handle: SocketHandle
    drop close_socket_on(handle)
}

struct Pending {
    fd: i64
    kept: bool
    drop {
        if !kept {
            __syscall(3, fd)
        }
    }
}

pub struct Packet {
    pub size: i64
    pub from: Addr
}

struct Watch {
    done: bool
    fired: bool
}

fn keep(mut p: Pending) -> i64 {
    p.kept = true
    p.fd
}

fn conn_guard(fd: i64, out: i64) -> *io.Guard {
    io.guard(fn() { __syscall(48, fd, 2) }, fn() {
        if out != fd {
            __syscall(3, out)
        }
        __syscall(3, fd)
    })
}

fn conn(fd: i64, remote: Addr) -> ConnHandle {
    let dup = __syscall(72, fd, 1030, 0)
    let out = if dup < 0 { fd } else { dup }
    ConnHandle { fd, out, remote, timeouts: no_timeouts(), guard: conn_guard(fd, out) }
}

fn no_timeouts() -> *Timeouts {
    new(Timeouts { read: 0, write: 0 })
}

fn expire(fd: i64, millis: i64, w: *Watch) {
    sleep(millis)
    if !w.done {
        w.fired = true
        __syscall(48, fd, 2)
    }
}

fn wait(fd: i64, writable: bool, millis: i64) ! io.Error {
    var w: *Watch? = none
    if millis > 0 {
        let watch = new(Watch { done: false, fired: false })
        spawn expire(fd, millis, watch)
        w = watch
    }
    if writable {
        wait_writable(fd)
    } else {
        wait_readable(fd)
    }
    match w {
        some(watch) => {
            watch.done = true
            if watch.fired {
                fail TimedOut
            }
        }
        none => {}
    }
}

fn retry(fd: i64, writable: bool, millis: i64, op: fn() -> i64) -> i64 ! io.Error {
    for {
        let r = op()
        if r == -11 {
            wait(fd, writable, millis)?
        } else if r != -4 {
            return io.syscall_result(r)
        }
    }
}

fn socket(domain: i64, kind: i64) -> i64 ! io.Error {
    io.syscall_result(__syscall(41, domain, kind | 0x80800, 0))
}

fn set_int(fd: i64, level: i64, option: i64, value: i64) ! io.Error {
    let v = io.buffer(4)
    io.set_le32(v, 0, value)
    io.syscall_result(__syscall(54, fd, level, option, __slice_ptr(v), 4))?
}

fn bind_device(fd: i64, device: str) ! io.Error {
    let name = bytes(device)
    io.syscall_result(__syscall(54, fd, 1, 25, __slice_ptr(name), name.len))?
}

fn socket_error(fd: i64) -> i64 {
    let v = io.buffer(4)
    let size = io.buffer(4)
    io.set_le32(size, 0, 4)
    let r = __syscall(55, fd, 1, 4, __slice_ptr(v), __slice_ptr(size))
    if r < 0 { -r } else { io.le32(v, 0) }
}

fn local(fd: i64) -> Addr ! io.Error {
    let buf = io.buffer(128)
    let size = io.buffer(4)
    io.set_le32(size, 0, 128)
    io.syscall_result(__syscall(51, fd, __slice_ptr(buf), __slice_ptr(size)))?
    from_sockaddr(buf, io.le32(size, 0))
}

fn bound(a: Addr, kind: i64, o: ListenOptions) -> Pending ! io.Error {
    using p = Pending { fd: socket(family(a), kind)?, kept: false }
    if o.reuse_addr {
        set_int(p.fd, 1, 2, 1) catch {
            _ => fail Invalid
        }
    }
    if o.reuse_port {
        set_int(p.fd, 1, 15, 1) catch {
            _ => fail Invalid
        }
    }
    let sa = sockaddr(a)
    let r = __syscall(49, p.fd, __slice_ptr(sa), sa.len)
    if r < 0 {
        fail io.errno(-r)
    }
    p
}

fn resolve_local(host: str) -> []u8 ! io.Error {
    if host.len == 0 {
        return parse_ip("0.0.0.0")
    }
    lookup(host)?[0]
}

fn socket_guard(fd: i64) -> *io.Guard {
    io.guard(fn() { __syscall(48, fd, 2) }, fn() { __syscall(3, fd) })
}

pub struct ListenOptions {
    pub reuse_addr: bool = true
    pub reuse_port: bool = false
    pub backlog: i64 = 4096
}

pub fn listen(host: str, port: i64) -> Listener ! io.Error {
    listen_with(host, port, ListenOptions {})
}

pub fn listen_with(host: str, port: i64, o: ListenOptions) -> Listener ! io.Error {
    using var p = bound(Addr { ip: resolve_local(host)?, port }, 1, o)?
    open_listener(mut p, o.backlog, "")?
}

fn listener_guard(fd: i64, closing: *Watch, path: str) -> *io.Guard {
    io.guard(fn() {
        closing.done = true
        __syscall(48, fd, 2)
    }, fn() {
        __syscall(3, fd)
        if path.len > 0 && !abstract_path(path) {
            __syscall(87, cstr(path))
        }
    })
}

fn open_listener(mut p: Pending, backlog: i64, path: str) -> Listener ! io.Error {
    let r = __syscall(50, p.fd, backlog)
    if r < 0 {
        fail io.errno(-r)
    }
    let addr = local(p.fd)?
    let fd = keep(mut p)
    let closing = new(Watch { done: false, fired: false })
    Listener { handle: ListenerHandle { fd, addr, closing, guard: listener_guard(fd, closing, path) } }
}

pub fn accept(l: Listener) -> Conn ! io.Error {
    let h = accept_handle(l.handle)?
    adopt(h)
}

pub fn accept_handle(h: ListenerHandle) -> ConnHandle ! io.Error {
    using lease = io.enter(h.guard)?
    let buf = io.buffer(128)
    let size = io.buffer(4)
    for {
        io.set_le32(size, 0, 128)
        let r = __syscall(288, h.fd, __slice_ptr(buf), __slice_ptr(size), 0x80800)
        if r == -11 {
            wait_readable(h.fd)
            if h.closing.done {
                fail NotConnected
            }
        } else if r >= 0 {
            return conn(r, from_sockaddr(buf, io.le32(size, 0)))
        } else if r != -4 && r != -103 {
            fail io.errno(-r)
        }
    }
}

pub fn adopt(h: ConnHandle) -> Conn {
    Conn { handle: h }
}

pub fn detach(mut c: Conn) -> ConnHandle {
    c.detached = true
    c.handle
}

pub fn detach_listener(mut l: Listener) -> ListenerHandle {
    l.detached = true
    l.handle
}

pub fn close_listener(l: Listener) {
    close_listener_on(l.handle)
}

pub fn close_listener_on(h: ListenerHandle) {
    io.retire(h.guard)
}

fn open_stream(a: Addr, device: str, millis: i64) -> Conn ! io.Error {
    let fd = socket(family(a), 1)?
    using c = adopt(conn(fd, a))
    if device.len > 0 {
        bind_device(fd, device)?
    }
    let sa = sockaddr(a)
    var r = __syscall(42, fd, __slice_ptr(sa), sa.len)
    var queued = 0
    let queue_limit = if millis > 0 { millis } else { 30000 }
    for r == -4 || r == -11 && is_unix(a) {
        if r == -11 {
            if queued >= queue_limit {
                fail TimedOut
            }
            sleep(1)
            queued += 1
        }
        r = __syscall(42, fd, __slice_ptr(sa), sa.len)
    }
    if r == -115 {
        wait(fd, true, millis) catch {
            _ => fail TimedOut
        }
        r = -socket_error(fd)
    }
    if r < 0 {
        fail io.errno(-r)
    }
    c
}

pub fn connect(a: Addr) -> Conn ! io.Error {
    connect_within(a, 0)
}

pub fn connect_within(a: Addr, millis: i64) -> Conn ! io.Error {
    connect_through(a, "", millis)
}

pub fn connect_through(a: Addr, device: str, millis: i64) -> Conn ! io.Error {
    open_stream(a, device, millis)
}

pub fn connect_first(ips: [][]u8, port: i64, device: str, millis: i64) -> Conn ! io.Error {
    if ips.len == 0 {
        fail NotFound
    }
    for ip in ips[..ips.len - 1] {
        let a = Addr { ip, port }
        using c = open_stream(a, device, millis) catch {
            _ => continue
        }
        return c
    }
    connect_through(Addr { ip: ips[ips.len - 1], port }, device, millis)
}

pub fn interface_index(name: str) -> i64 ! io.Error {
    if name.len == 0 || name.len > 15 {
        fail Invalid
    }
    using probe = Pending { fd: socket(2, 2)?, kept: false }
    let request = io.buffer(40)
    io.copy(request, bytes(name))
    let r = __syscall(16, probe.fd, 0x8933, __slice_ptr(request))
    if r == -19 {
        fail NotFound
    }
    io.syscall_result(r)?
    io.le32(request, 16)
}

pub fn dial(host: str, port: i64) -> Conn ! io.Error {
    dial_within(host, port, 0)
}

pub fn dial_within(host: str, port: i64, millis: i64) -> Conn ! io.Error {
    connect_first(lookup(host)?, port, "", millis)
}

pub fn read(c: Conn, buf: []u8) -> i64 ! io.Error {
    read_on(c.handle, buf)
}

pub fn read_on(h: ConnHandle, buf: []u8) -> i64 ! io.Error {
    using lease = io.enter(h.guard)?
    retry(h.fd, false, h.timeouts.read, fn() -> i64 { __syscall(45, h.fd, __slice_ptr(buf), buf.len, 0, 0, 0) })
}

pub fn write(c: Conn, data: []u8) -> i64 ! io.Error {
    write_on(c.handle, data)
}

pub fn write_on(h: ConnHandle, data: []u8) -> i64 ! io.Error {
    using lease = io.enter(h.guard)?
    retry(h.out, true, h.timeouts.write, fn() -> i64 { __syscall(44, h.out, __slice_ptr(data), data.len, 0x4000, 0, 0) })
}

pub fn write_all(c: Conn, data: []u8) ! io.Error {
    write_all_on(c.handle, data)?
}

pub fn write_all_on(h: ConnHandle, data: []u8) ! io.Error {
    var rest = data
    for rest.len > 0 {
        let n = write_on(h, rest)?
        rest = rest[n..]
    }
}

pub fn close(c: Conn) {
    close_on(c.handle)
}

pub fn close_on(h: ConnHandle) {
    io.retire(h.guard)
}

pub fn shutdown_write(c: Conn) ! io.Error {
    shutdown_write_on(c.handle)
}

pub fn shutdown_write_on(h: ConnHandle) ! io.Error {
    using lease = io.enter(h.guard)?
    io.syscall_result(__syscall(48, h.fd, 1))?
}

pub fn local_addr(c: Conn) -> Addr ! io.Error {
    using lease = io.enter(c.handle.guard)?
    local(c.handle.fd)
}

pub fn set_nodelay(c: Conn, on: bool) ! io.Error {
    using lease = io.enter(c.handle.guard)?
    set_int(c.handle.fd, 6, 1, if on { 1 } else { 0 })?
}

pub fn set_read_timeout(c: Conn, millis: i64) {
    c.handle.timeouts.read = millis
}

pub fn set_write_timeout(c: Conn, millis: i64) {
    c.handle.timeouts.write = millis
}

pub fn stream(c: Conn) -> io.Stream {
    stream_on(c.handle)
}

pub fn stream_on(h: ConnHandle) -> io.Stream {
    io.Stream {
        read: fn(buf) { read_on(h, buf) }
        write: fn(data) { write_on(h, data) }
        close: fn() { close_on(h) }
    }
}

pub fn bind_udp(host: str, port: i64) -> Socket ! io.Error {
    bind_udp_with(host, port, ListenOptions {})
}

pub fn bind_udp_with(host: str, port: i64, o: ListenOptions) -> Socket ! io.Error {
    using var p = bound(Addr { ip: resolve_local(host)?, port }, 2, o)?
    let addr = local(p.fd)?
    let fd = keep(mut p)
    Socket { handle: SocketHandle { fd, addr, timeouts: no_timeouts(), guard: socket_guard(fd) } }
}

pub fn send_to(s: Socket, data: []u8, to: Addr) -> i64 ! io.Error {
    using lease = io.enter(s.handle.guard)?
    let h = s.handle
    let sa = sockaddr(to)
    retry(h.fd, true, h.timeouts.write, fn() -> i64 {
        __syscall(44, h.fd, __slice_ptr(data), data.len, 0x4000, __slice_ptr(sa), sa.len)
    })
}

pub fn receive_from(s: Socket, buf: []u8) -> Packet ! io.Error {
    using lease = io.enter(s.handle.guard)?
    let h = s.handle
    let sa = io.buffer(28)
    let size = io.buffer(4)
    let n = retry(h.fd, false, h.timeouts.read, fn() -> i64 {
        io.set_le32(size, 0, 28)
        __syscall(45, h.fd, __slice_ptr(buf), buf.len, 0, __slice_ptr(sa), __slice_ptr(size))
    })?
    Packet { size: n, from: from_sockaddr(sa, io.le32(size, 0)) }
}

pub fn set_receive_timeout(s: Socket, millis: i64) {
    s.handle.timeouts.read = millis
}

pub fn close_socket(s: Socket) {
    close_socket_on(s.handle)
}

pub fn close_socket_on(h: SocketHandle) {
    io.retire(h.guard)
}
