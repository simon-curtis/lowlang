import std/io
import std/text

/// A network address: an IP address and port, or a Unix socket path.
///
/// The `ip` field tells the kinds apart: 4 bytes for IPv4, 16 for IPv6 and empty for a Unix address, as `is_unix` reports.
pub struct Addr {
    /// The address bytes in network order: 4 for IPv4, 16 for IPv6, empty for a Unix address.
    pub ip: []u8
    /// The port number, `0` for a Unix address.
    pub port: i64
    /// The socket path of a Unix address, empty for an IP address.
    ///
    /// A name that starts with `@` or NUL is in the abstract namespace and is not a file.
    pub path: str = ""
}

/// Returns whether `ip` is an IPv6 address, meaning it has 16 bytes.
pub fn v6(ip: []u8) -> bool {
    ip.len == 16
}

/// Parses an IPv4 dotted-quad or an IPv6 literal and returns its 4 or 16 bytes.
///
/// An address containing `:` is read as IPv6, with `::` compression and an optional trailing dotted IPv4 part. Brackets, zone identifiers and host names are not accepted. Fails with `Invalid` if `s` is not an address.
pub fn parse_ip(s: str) -> []u8 ! io.Error {
    if text.index_byte(s, ':') >= 0 {
        return parse_v6(s)
    }
    parse_v4(s)
}

fn parse_v4(s: str) -> []u8 ! io.Error {
    let parts = text.split(s, '.')
    if parts.len != 4 {
        fail Invalid
    }
    var ip: []u8 = []
    for p in parts {
        if p.len == 0 || p.len > 3 {
            fail Invalid
        }
        let n = text.parse_uint(p, 10) catch -1
        if n < 0 || n > 255 {
            fail Invalid
        }
        push(mut ip, u8(n))
    }
    ip
}

fn parse_groups(s: str, mut out: []u8) -> bool {
    if s.len == 0 {
        return true
    }
    let parts = text.split(s, ':')
    for i, p in parts {
        if i == parts.len - 1 && text.index_byte(p, '.') >= 0 {
            let tail = parse_v4(p) catch {
                _ => return false
            }
            io.append(mut out, tail)
            return true
        }
        if p.len == 0 || p.len > 4 {
            return false
        }
        let n = text.parse_uint(p, 16) catch -1
        if n < 0 {
            return false
        }
        io.put_be16(mut out, n)
    }
    true
}

fn parse_v6(s: str) -> []u8 ! io.Error {
    let gap = text.index(s, "::")
    var head: []u8 = []
    var tail: []u8 = []
    if gap < 0 {
        if !parse_groups(s, mut head) || head.len != 16 {
            fail Invalid
        }
        return head
    }
    if !parse_groups(s[..gap], mut head) || !parse_groups(s[gap + 2..], mut tail) || head.len + tail.len > 14 {
        fail Invalid
    }
    for head.len + tail.len < 16 {
        push(mut head, 0)
    }
    io.append(mut head, tail)
    head
}

/// Returns the text form of `ip`: dotted decimal for 4 bytes and lowercase hexadecimal groups for 16.
///
/// The longest run of two or more zero groups in an IPv6 address is written as `::`. Returns an empty string for an empty `ip`.
pub fn format_ip(ip: []u8) -> str {
    if ip.len == 0 {
        return ""
    }
    if !v6(ip) {
        return "{ip[0]}.{ip[1]}.{ip[2]}.{ip[3]}"
    }
    var best = -1
    var best_len = 1
    var run = -1
    for g in 0..8 {
        if io.be16(ip, 2 * g) == 0 {
            if run < 0 {
                run = g
            }
            if g - run + 1 > best_len {
                best = run
                best_len = g - run + 1
            }
        } else {
            run = -1
        }
    }
    var out: []u8 = []
    var g = 0
    for g < 8 {
        if g == best {
            text.append(mut out, "::")
            g += best_len
            continue
        }
        if g > 0 && g != best + best_len {
            push(mut out, ':')
        }
        text.append(mut out, text.hex(io.be16(ip, 2 * g)))
        g += 1
    }
    __str_view(out)
}

/// Returns `a` as text: `host:port` for IPv4, `[host]:port` for IPv6 and `unix:path` for a Unix address.
pub fn format(a: Addr) -> str {
    if is_unix(a) {
        return "unix:{a.path}"
    }
    if v6(a.ip) {
        return "[{format_ip(a.ip)}]:{a.port}"
    }
    "{format_ip(a.ip)}:{a.port}"
}

/// Parses `host:port` into an `Addr`.
///
/// The text is split at its last `:`. The host must be an IP literal, in square brackets if desired, and the port a number from 0 to 65535. Host names are not resolved. Fails with `Invalid` for any other form.
pub fn parse_addr(s: str) -> Addr ! io.Error {
    let colon = text.last_index_byte(s, ':')
    if colon < 0 {
        fail Invalid
    }
    var host = s[..colon]
    if host.len >= 2 && host[0] == '[' && host[host.len - 1] == ']' {
        host = host[1..host.len - 1]
    }
    let port = text.parse_uint(s[colon + 1..], 10) catch -1
    if port < 0 || port > 65535 {
        fail Invalid
    }
    Addr { ip: parse_ip(host)?, port }
}

fn sockaddr(a: Addr) -> []u8 {
    var b: []u8 = []
    if is_unix(a) {
        return unix_sockaddr(a.path)
    }
    if v6(a.ip) {
        push(mut b, 10)
        push(mut b, 0)
        io.put_be16(mut b, a.port)
        io.put_be32(mut b, 0)
        io.append(mut b, a.ip)
        io.put_be32(mut b, 0)
        return b
    }
    push(mut b, 2)
    push(mut b, 0)
    io.put_be16(mut b, a.port)
    io.append(mut b, a.ip)
    io.put_be64(mut b, 0)
    b
}

fn from_sockaddr(b: []u8, size: i64) -> Addr {
    if io.le16(b, 0) == 1 {
        return Addr { ip: [], port: 0, path: unix_path(b, size) }
    }
    if io.le16(b, 0) == 10 {
        return Addr { ip: b[8..24], port: io.be16(b, 2) }
    }
    Addr { ip: b[4..8], port: io.be16(b, 2) }
}

fn family(a: Addr) -> i64 {
    if is_unix(a) {
        return 1
    }
    if v6(a.ip) { 10 } else { 2 }
}

/// Returns whether `a` is a Unix socket address, which has no IP address.
pub fn is_unix(a: Addr) -> bool {
    a.ip.len == 0
}

fn abstract_path(path: str) -> bool {
    path.len > 0 && (path[0] == '@' || path[0] == 0)
}

fn unix_sockaddr(path: str) -> []u8 {
    var b: []u8 = []
    push(mut b, 1)
    push(mut b, 0)
    if abstract_path(path) {
        push(mut b, 0)
        text.append(mut b, path[1..])
        return b
    }
    text.append(mut b, path)
    push(mut b, 0)
    b
}

fn unix_path(b: []u8, size: i64) -> str {
    if size <= 2 {
        return ""
    }
    if b[2] == 0 {
        return "@{str(b[3..size])}"
    }
    var end = size
    for end > 2 && b[end - 1] == 0 {
        end -= 1
    }
    str(b[2..end])
}

/// Returns the Unix address for the socket `path`.
///
/// A path that starts with `@` or NUL names an abstract socket and is returned as `@` followed by the rest of the name. Fails with `Invalid` if `path` is empty, longer than 107 bytes or, for a filesystem path, contains NUL.
pub fn unix_addr(path: str) -> Addr ! io.Error {
    if path.len == 0 || path.len > 107 {
        fail Invalid
    }
    if abstract_path(path) {
        return Addr { ip: [], port: 0, path: "@{path[1..]}" }
    }
    for i in 0..path.len {
        if path[i] == 0 {
            fail Invalid
        }
    }
    Addr { ip: [], port: 0, path }
}

/// Returns whether `ip` lies within the CIDR range `prefix`, written `address/bits` such as `10.0.0.0/8`.
///
/// Returns `false` if `prefix` has no valid address or bit count, or if its address family differs from `ip`.
pub fn in_network(ip: []u8, prefix: str) -> bool {
    let slash = text.index_byte(prefix, '/')
    let base: []u8 = parse_ip(prefix[..slash]) catch []
    let bits = text.parse_uint(prefix[slash + 1..], 10) catch -1
    if base.len != ip.len || bits < 0 {
        return false
    }
    var i = 0
    var left = bits
    for left >= 8 {
        if ip[i] != base[i] {
            return false
        }
        i += 1
        left -= 8
    }
    left == 0 || i64(ip[i]) >> (8 - left) == i64(base[i]) >> (8 - left)
}

fn within_any(ip: []u8, prefixes: []str) -> bool {
    for p in prefixes {
        if in_network(ip, p) {
            return true
        }
    }
    false
}

/// Returns whether `ip` is a globally reachable unicast address.
///
/// Returns `false` for the ranges the IANA special-purpose registries mark as not globally reachable, such as loopback, private, link-local, documentation and unique-local ranges, and for multicast and reserved ranges. The registries' globally reachable exceptions inside those ranges return `true`. An IPv4-mapped IPv6 address is judged by its IPv4 part, and an `ip` that is neither 4 nor 16 bytes returns `false`.
pub fn is_global(ip: []u8) -> bool {
    if v6(ip) {
        if in_network(ip, "::ffff:0:0/96") {
            return is_global(ip[12..])
        }
        let reserved = [
            "::/128", "::1/128", "64:ff9b:1::/48", "100::/64", "2001::/23", "2001:db8::/32", "2002::/16",
            "3fff::/20", "5f00::/16", "fc00::/7", "fe80::/10", "ff00::/8",
        ]
        let exempt = ["2001:1::1/128", "2001:1::2/128", "2001:1::3/128", "2001:3::/32", "2001:4:112::/48", "2001:20::/28", "2001:30::/28"]
        return !within_any(ip, reserved) || within_any(ip, exempt)
    }
    if ip.len != 4 {
        return false
    }
    let reserved = [
        "0.0.0.0/8", "10.0.0.0/8", "100.64.0.0/10", "127.0.0.0/8", "169.254.0.0/16", "172.16.0.0/12",
        "192.0.0.0/24", "192.0.2.0/24", "192.88.99.0/24", "192.168.0.0/16", "198.18.0.0/15",
        "198.51.100.0/24", "203.0.113.0/24", "224.0.0.0/3",
    ]
    !within_any(ip, reserved) || within_any(ip, ["192.0.0.9/32", "192.0.0.10/32"])
}
