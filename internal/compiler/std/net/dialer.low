import std/io

/// A function value that opens connections, so that code can connect directly or through a proxy.
pub struct Dialer {
    /// Opens a connection to the host name or address and port and returns its view, which the caller must close.
    pub dial: fn(str, i64) -> ConnHandle ! io.Error
}

/// Returns a `Dialer` that resolves the host with `lookup` and connects to it directly, as `dial_handle` does.
pub fn direct_dialer() -> Dialer {
    Dialer { dial: fn(host: str, port: i64) -> ConnHandle ! io.Error { dial_handle(host, port)? } }
}

/// Connects to `host` and `port` as `dial` does and returns the view of the connection.
///
/// The caller owns the connection and must close it with `close_on`.
pub fn dial_handle(host: str, port: i64) -> ConnHandle ! io.Error {
    using var c = dial(host, port)?
    detach(mut c)
}
