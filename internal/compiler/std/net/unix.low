import std/io

pub struct Credentials {
    pub pid: i64
    pub uid: i64
    pub gid: i64
}

pub struct ConnPair {
    pub first: Conn
    pub second: Conn
}

pub fn listen_unix(path: str) -> Listener ! io.Error {
    let a = unix_addr(path)?
    using var p = bound(a, 1, ListenOptions { reuse_addr: false })?
    open_listener(mut p, 4096, a.path)?
}

pub fn connect_unix(path: str) -> Conn ! io.Error {
    connect(unix_addr(path)?)
}

pub fn connect_unix_within(path: str, millis: i64) -> Conn ! io.Error {
    connect_within(unix_addr(path)?, millis)
}

pub fn socketpair() -> ConnPair ! io.Error {
    let fds = io.buffer(8)
    io.syscall_result(__syscall(53, 1, 0x80801, 0, __slice_ptr(fds)))?
    let unnamed = Addr { ip: [], port: 0 }
    ConnPair {
        first: adopt(conn(io.le32(fds, 0), unnamed))
        second: adopt(conn(io.le32(fds, 4), unnamed))
    }
}

pub fn peer_credentials(c: Conn) -> Credentials ! io.Error {
    peer_credentials_on(c.handle)
}

pub fn peer_credentials_on(h: ConnHandle) -> Credentials ! io.Error {
    using lease = io.enter(h.guard)?
    let v = io.buffer(12)
    let size = io.buffer(4)
    io.set_le32(size, 0, 12)
    io.syscall_result(__syscall(55, h.fd, 1, 17, __slice_ptr(v), __slice_ptr(size)))?
    Credentials { pid: io.le32(v, 0), uid: io.le32(v, 4), gid: io.le32(v, 8) }
}
