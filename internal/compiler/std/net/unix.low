import std/io
import std/sys

/// The identity of the process at the other end of a Unix socket.
pub struct Credentials {
    /// The process id.
    pub pid: i64
    /// The user id.
    pub uid: i64
    /// The group id.
    pub gid: i64
}

/// Two connected `Conn` values made by `socketpair`.
pub struct ConnPair {
    /// One end of the pair.
    pub first: Conn
    /// The other end of the pair. Data written to one end is read from the other.
    pub second: Conn
}

/// Listens for stream connections on the Unix socket `path`.
///
/// `path` is validated as `unix_addr` does and can name an abstract socket. The backlog is 4096. Fails with `AddrInUse` if a file already exists at `path`. Closing the listener removes the socket file, except for an abstract name.
pub fn listen_unix(path: str) -> Listener ! io.Error {
    let a = unix_addr(path)?
    using var p = bound(a, sys.SocketKind.Streaming, ListenOptions { reuse_addr: false })?
    open_listener(mut p, 4096, a.path)?
}

/// Connects to the Unix stream socket at `path`.
///
/// Parks the green thread while the connection is in progress. Fails as `connect_unix_within` does, with the default wait.
pub fn connect_unix(path: str) -> Conn ! io.Error {
    connect(unix_addr(path)?)
}

/// Connects to the Unix stream socket at `path`, waiting at most `millis` milliseconds.
///
/// When the listener's backlog is full it retries every millisecond for up to `millis`, or 30 seconds when `millis` is 0 or less, and then fails with `TimedOut`. Fails with `Invalid` for a bad `path`, `NotFound` if there is no socket and `Refused` if nothing listens.
pub fn connect_unix_within(path: str, millis: i64) -> Conn ! io.Error {
    connect_within(unix_addr(path)?, millis)
}

/// Returns two connected, unnamed Unix stream sockets.
pub fn socketpair() -> ConnPair ! io.Error {
    let pair = sys.socketpair()?
    let unnamed = Addr { ip: [], port: 0 }
    ConnPair {
        first: adopt(conn(pair.first, unnamed))
        second: adopt(conn(pair.second, unnamed))
    }
}

/// Returns the process id, user id and group id of the peer of `c`, as recorded when the connection was made.
///
/// Meaningful for Unix socket connections. Fails with `NotConnected` if `c` is closed.
pub fn peer_credentials(c: Conn) -> Credentials ! io.Error {
    peer_credentials_on(c.handle)
}

/// Returns the process id, user id and group id of the peer behind `h`.
///
/// Fails with `NotConnected` if the connection is closed.
pub fn peer_credentials_on(h: ConnHandle) -> Credentials ! io.Error {
    using lease = io.enter(h.guard)?
    let peer = sys.peer_credentials(h.fd)?
    Credentials { pid: peer.pid, uid: peer.uid, gid: peer.gid }
}
