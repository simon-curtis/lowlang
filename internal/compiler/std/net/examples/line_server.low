import std/io
import std/net
import std/text

fn shout(h: net.ConnHandle) {
    using c = net.adopt(h)
    let r = io.reader(net.stream(c))
    for {
        let line = io.read_line(r) or return
        net.write_all(c, bytes("{text.upper(line)}\n")) or return
    }
}

fn accept_loop(l: net.ListenerHandle) {
    for {
        let h = net.accept_handle(l) or return
        spawn shout(h)
    }
}

/// Serves upper-cased lines on an OS-assigned loopback port and talks to it over one connection.
fn main() ! io.Error {
    using l = net.listen("127.0.0.1", 0)?
    spawn accept_loop(l.handle)

    using c = net.connect(l.handle.addr)?
    let r = io.reader(net.stream(c))
    for word in ["hello", "low level", "net"] {
        net.write_all(c, bytes("{word}\n"))?
        print(io.read_line(r)?)
    }
    net.shutdown_write(c)?
    print(net.read(c, io.buffer(8))?)
    net.close_listener(l)
}
