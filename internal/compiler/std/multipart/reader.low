import std/header
import std/io
import std/text

/// The error of reading or writing a multipart body.
pub enum Error {
    /// The content type is missing or is not `multipart/*`.
    BadContentType
    /// The boundary is missing, empty, longer than 70 bytes, ends in a space or has a byte a boundary may not hold.
    BadBoundary
    /// The body breaks the multipart syntax. `at` is the approximate byte offset and `message` says what is wrong.
    Malformed(at: i64, message: str)
    /// The body ended before the closing boundary.
    Truncated
    /// The body has more parts than `Limits.max_parts`.
    TooManyParts
    /// The headers of a part are larger than `Limits.max_header_bytes`.
    HeaderTooLarge
    /// The body is larger than `Limits.max_total_bytes`, or a part held in memory is larger than `Limits.max_memory`.
    TooLarge
    /// A part written to a writer with a chosen boundary contains that boundary.
    BoundaryInData
    /// A header written to a writer has a name that is not a token, or a value with a carriage return, line feed or NUL.
    InvalidHeader
    /// A part was written to a writer after `finish`.
    Finished
    /// The underlying source or a `Spill` function failed with `cause`.
    Io(cause: io.Error)
}

/// Bounds on the size of a multipart body.
pub struct Limits {
    /// The most parts a body may have. Defaults to 1000.
    pub max_parts: i64 = 1000
    /// The most bytes the headers of one part may take. Defaults to 16 KiB.
    pub max_header_bytes: i64 = 16384
    /// The most bytes the whole body may take. Defaults to 64 MiB.
    pub max_total_bytes: i64 = 67108864
    /// The most bytes of one part that `read_bytes`, `read_text` and `read_form` hold in memory, and the point at which `read_spill` starts passing content to its sink. Defaults to 1 MiB.
    pub max_memory: i64 = 1048576
}

/// The headers of one part of a multipart body, as returned by `next_part`.
pub struct Part {
    /// The zero-based position of the part in the body.
    pub index: i64
    /// Every header of the part, in order.
    pub headers: []header.Header
    /// The `content-disposition` type in lower case, such as `form-data`, or an empty string when the header is absent.
    pub disposition: str
    /// The `name` parameter of the `content-disposition` header, or an empty string when it has none.
    pub name: str
    /// The `filename` parameter of the `content-disposition` header, or `none` when it has none.
    pub filename: str?
    /// The `content-type` header, or an empty string when it is absent.
    pub content_type: str
    /// Every parameter of the `content-disposition` header.
    pub params: []header.Header
}

/// The content of a part read by `read_spill`.
pub struct Body {
    /// The content when it fit in memory. Empty when `spilled` is `true`.
    pub data: []u8
    /// The size of the content in bytes.
    pub size: i64
    /// Whether the content was passed to the sink instead of being kept in `data`.
    pub spilled: bool
}

enum Mode {
    Preamble
    Delimited
    Inside
    Done
}

struct Scan {
    at: i64
    found: bool
    safe: i64
}

/// Reads a multipart body one part at a time.
///
/// Made by `reader` or `bytes_reader`. Call `next_part` to reach a part, then `read` or a helper for its content. It does not read from the source until it is used.
pub struct Reader {
    source: *io.Reader
    delimiter: str
    limits: Limits
    buf: []u8
    start: i64
    end: i64
    total: i64
    parts: i64
    mode: Mode
    eof: bool
    scan: Scan
    scanned: bool
}

fn boundary_byte(c: u8) -> bool {
    if c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9' {
        return true
    }
    text.index_byte("'()+_,-./:=? ", c) >= 0
}

/// Fails with `BadBoundary` unless `boundary` is 1 to 70 bytes of letters, digits and `'()+_,-./:=? `, and does not end in a space.
pub fn check_boundary(boundary: str) ! Error {
    if boundary.len == 0 || boundary.len > 70 || boundary[boundary.len - 1] == ' ' {
        fail Error.BadBoundary
    }
    for i in 0..boundary.len {
        if !boundary_byte(boundary[i]) {
            fail Error.BadBoundary
        }
    }
}

/// Returns the boundary of a `multipart/*` content type.
///
/// Fails with `BadContentType` for any other type, and with `BadBoundary` when the parameter is missing or invalid.
pub fn boundary_from_content_type(content_type: str) -> str ! Error {
    let v = header.parse_value(content_type)
    if !text.starts_with_fold(v.main, "multipart/") {
        fail Error.BadContentType
    }
    let boundary = header.param(v, "boundary") ?? fail Error.BadBoundary
    check_boundary(boundary)?
    boundary
}

/// Returns a reader for a multipart body read from `source` and delimited by `boundary`.
///
/// Fails with `BadBoundary` when the boundary is invalid. Reads from `source` block until data arrives.
pub fn reader(source: *io.Reader, boundary: str, limits: Limits) -> *Reader ! Error {
    check_boundary(boundary)?
    let buf = io.buffer(65536)
    buf[0] = '\r'
    buf[1] = '\n'
    new(Reader {
        source, delimiter: "\r\n--{boundary}", limits, buf, start: 0, end: 2, total: 0, parts: 0,
        mode: Preamble, eof: false, scan: Scan { at: -1, found: false, safe: 0 }, scanned: false,
    })
}

/// Returns a reader for the multipart body in `data`. See `reader`.
pub fn bytes_reader(data: []u8, boundary: str, limits: Limits) -> *Reader ! Error {
    reader(io.bytes_reader(data), boundary, limits)?
}

fn malformed(r: *Reader, message: str) -> Error {
    Error.Malformed(r.total - (r.end - r.start), message)
}

fn fill(r: *Reader) ! Error {
    if r.eof {
        return
    }
    r.scanned = false
    if r.start == r.end {
        r.start = 0
        r.end = 0
    }
    if r.end == r.buf.len {
        if r.start > 0 {
            io.copy(r.buf, r.buf[r.start..r.end])
            r.end -= r.start
            r.start = 0
        } else {
            let bigger = io.buffer(r.buf.len * 2)
            io.copy(bigger, r.buf[..r.end])
            r.buf = bigger
        }
    }
    let n = io.read_some(r.source, r.buf[r.end..]) catch {
        e => fail Error.Io(e)
    }
    if n == 0 {
        r.eof = true
        return
    }
    r.total += n
    if r.total > r.limits.max_total_bytes {
        fail Error.TooLarge
    }
    r.end += n
}

fn ensure(r: *Reader, n: i64) ! Error {
    for r.end - r.start < n {
        if r.eof {
            fail Error.Truncated
        }
        fill(r)?
    }
}

fn confirms(first: u8, second: u8) -> bool {
    if first == '-' {
        return second == '-'
    }
    if first == '\r' {
        return second == '\n'
    }
    first == ' ' || first == '\t'
}

fn find_delimiter(r: *Reader) -> Scan {
    let view = __str_view(r.buf[r.start..r.end])
    var from = 0
    for {
        let i = text.index(view[from..], r.delimiter)
        if i < 0 {
            var held = r.delimiter.len - 1
            if r.eof {
                held = 0
            }
            var safe = view.len - held
            if safe < 0 {
                safe = 0
            }
            return Scan { at: -1, found: false, safe }
        }
        let found = from + i
        let after = found + r.delimiter.len
        if view.len - after < 2 {
            if r.eof {
                return Scan { at: r.start + found, found: true, safe: found }
            }
            return Scan { at: -1, found: false, safe: found }
        }
        if confirms(view[after], view[after + 1]) {
            return Scan { at: r.start + found, found: true, safe: found }
        }
        from = found + 1
    }
}

fn current_scan(r: *Reader) -> Scan {
    if !r.scanned {
        r.scan = find_delimiter(r)
        r.scanned = true
    }
    r.scan
}

fn consume(r: *Reader, n: i64) {
    r.start += n
    r.scan.safe -= n
    if r.scan.safe < 0 {
        r.scan.safe = 0
    }
}

fn consume_delimiter(r: *Reader, s: Scan) {
    r.start = s.at + r.delimiter.len
    r.scanned = false
    r.mode = Delimited
}

/// Reads content of the current part into `dst` and returns the number of bytes.
///
/// Returns `0` at the end of the part, when no part is open, or when `dst` is empty. Fails with `Truncated` when the body ends inside the part, with `TooLarge` when it exceeds `Limits.max_total_bytes`, and with `Io` when the source fails.
pub fn read(r: *Reader, dst: []u8) -> i64 ! Error {
    if r.mode != Inside || dst.len == 0 {
        return 0
    }
    for {
        let s = current_scan(r)
        if s.safe > 0 {
            var n = s.safe
            if n > dst.len {
                n = dst.len
            }
            io.copy(dst, r.buf[r.start..r.start + n])
            consume(r, n)
            return n
        }
        if s.found {
            consume_delimiter(r, s)
            return 0
        }
        if r.eof {
            fail Error.Truncated
        }
        fill(r)?
    }
}

fn skip_preamble(r: *Reader) ! Error {
    for {
        let s = current_scan(r)
        if s.found {
            consume_delimiter(r, s)
            return
        }
        r.start += s.safe
        r.scanned = false
        if r.eof {
            fail Error.Truncated
        }
        fill(r)?
    }
}

fn drain(r: *Reader) ! Error {
    let sink = io.buffer(4096)
    for r.mode == Inside {
        read(r, sink)?
    }
}

fn header_line(r: *Reader, budget: i64) -> str ! Error {
    for {
        let view = __str_view(r.buf[r.start..r.end])
        let i = text.index(view, "\r\n")
        if i >= 0 {
            if i + 2 > budget {
                fail Error.HeaderTooLarge
            }
            let line = str(r.buf[r.start..r.start + i])
            for k in 0..line.len {
                if line[k] == '\n' || line[k] == '\r' {
                    fail malformed(r, "bare line break in a header")
                }
            }
            r.start += i + 2
            r.scanned = false
            return line
        }
        if view.len + 2 > budget {
            fail Error.HeaderTooLarge
        }
        if r.eof {
            fail Error.Truncated
        }
        fill(r)?
    }
}

fn read_headers(r: *Reader) -> []header.Header ! Error {
    var headers: []header.Header = []
    var used = 0
    for {
        let line = header_line(r, r.limits.max_header_bytes - used)?
        used += line.len + 2
        if line.len == 0 {
            return headers
        }
        if line[0] == ' ' || line[0] == '\t' {
            if headers.len == 0 {
                fail malformed(r, "header continuation without a header")
            }
            let last = headers.len - 1
            let previous = headers[last]
            headers[last] = header.Header { name: previous.name, value: "{previous.value} {text.trim(line)}" }
            continue
        }
        let colon = text.index_byte(line, ':')
        if colon < 0 || !header.token(line[..colon]) {
            fail malformed(r, "bad header line")
        }
        push(mut headers, header.Header { name: line[..colon], value: text.trim(line[colon + 1..]) })
    }
}

fn describe(index: i64, headers: []header.Header) -> Part {
    let disposition = header.get(headers, "content-disposition") ?? ""
    let parsed = header.parse_value(disposition)
    Part {
        index
        headers
        disposition: text.lower(parsed.main)
        name: header.param(parsed, "name") ?? ""
        filename: header.param(parsed, "filename")
        content_type: header.get(headers, "content-type") ?? ""
        params: parsed.params
    }
}

fn open_part(r: *Reader) -> Part? ! Error {
    ensure(r, 2)?
    if r.buf[r.start] == '-' && r.buf[r.start + 1] == '-' {
        r.start += 2
        r.mode = Done
        return none
    }
    for r.start < r.end && (r.buf[r.start] == ' ' || r.buf[r.start] == '\t') {
        r.start += 1
        ensure(r, 2)?
    }
    if r.buf[r.start] != '\r' || r.buf[r.start + 1] != '\n' {
        fail malformed(r, "boundary is not followed by a line break")
    }
    r.start += 2
    r.parts += 1
    if r.parts > r.limits.max_parts {
        fail Error.TooManyParts
    }
    let headers = read_headers(r)?
    r.mode = Inside
    r.scanned = false
    describe(r.parts - 1, headers)
}

/// Moves to the next part and returns its headers, or `none` after the closing boundary.
///
/// Content of the current part that was not read is skipped. Fails with `Malformed`, `Truncated`, `TooManyParts`, `HeaderTooLarge`, `TooLarge` or `Io`. Once it has returned `none` it keeps doing so.
pub fn next_part(r: *Reader) -> Part? ! Error {
    match r.mode {
        Done => return none
        Preamble => skip_preamble(r)?
        Inside => drain(r)?
        Delimited => {}
    }
    open_part(r)?
}

/// Reads the rest of the current part into memory.
///
/// Fails with `TooLarge` when it is longer than `Limits.max_memory`, and with the errors of `read`.
pub fn read_bytes(r: *Reader) -> []u8 ! Error {
    var out: []u8 = []
    let chunk = io.buffer(8192)
    for {
        let n = read(r, chunk)?
        if n == 0 {
            return out
        }
        if out.len + n > r.limits.max_memory {
            fail Error.TooLarge
        }
        io.append(mut out, chunk[..n])
    }
}

/// Reads the rest of the current part as text.
///
/// The bytes are not checked for UTF-8. Fails like `read_bytes`.
pub fn read_text(r: *Reader) -> str ! Error {
    let data = read_bytes(r)?
    __str_view(data)
}

/// Reads the rest of the current part, passing it to `sink` once it is longer than `Limits.max_memory`.
///
/// Shorter content is returned in `Body.data`. Longer content is passed to `sink` in chunks starting with everything read so far, and the body returns empty with `spilled` set. Fails with `Io` when `sink` fails, and with the errors of `read`.
pub fn read_spill(r: *Reader, sink: fn([]u8) ! io.Error) -> Body ! Error {
    var held: []u8 = []
    var size = 0
    var spilled = false
    let chunk = io.buffer(16384)
    for {
        let n = read(r, chunk)?
        if n == 0 {
            break
        }
        size += n
        if spilled {
            sink(chunk[..n]) catch {
                e => fail Error.Io(e)
            }
            continue
        }
        io.append(mut held, chunk[..n])
        if held.len > r.limits.max_memory {
            sink(held) catch {
                e => fail Error.Io(e)
            }
            held = []
            spilled = true
        }
    }
    Body { data: held, size, spilled }
}

/// Returns the media type of the part in lower case, without parameters.
///
/// A part with no `content-type` is `text/plain`.
pub fn media_type(p: Part) -> str {
    if p.content_type == "" {
        return "text/plain"
    }
    text.lower(header.parse_value(p.content_type).main)
}

/// Returns the value of the first header of the part called `name`, or `none` when it is absent.
///
/// The name is matched without regard to case.
pub fn header(p: Part, name: str) -> str? {
    header.get(p.headers, name)
}
