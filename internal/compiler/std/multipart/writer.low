import std/crypto
import std/http
import std/io
import std/text

pub struct Writer {
    boundary: str
    out: []u8
    generated: bool
    finished: bool
}

pub fn writer() -> *Writer {
    let boundary = text.encode_hex(crypto.random(24))
    new(Writer { boundary, out: [], generated: true, finished: false })
}

pub fn writer_with(boundary: str) -> *Writer ! Error {
    check_boundary(boundary)?
    new(Writer { boundary, out: [], generated: false, finished: false })
}

pub fn boundary(w: *Writer) -> str {
    w.boundary
}

pub fn content_type(w: *Writer) -> str {
    content_type_as(w, "form-data")
}

pub fn content_type_as(w: *Writer, subtype: str) -> str {
    for i in 0..w.boundary.len {
        if !token_byte(w.boundary[i]) {
            return "multipart/{subtype}; boundary={quote(w.boundary)}"
        }
    }
    "multipart/{subtype}; boundary={w.boundary}"
}

pub fn quote(value: str) -> str {
    var out: []u8 = []
    push(mut out, '"')
    for i in 0..value.len {
        let c = value[i]
        if c == '"' || c == '\\' {
            push(mut out, '\\')
            push(mut out, c)
        } else if c == '\r' {
            text.append(mut out, "%0D")
        } else if c == '\n' {
            text.append(mut out, "%0A")
        } else {
            push(mut out, c)
        }
    }
    push(mut out, '"')
    __str_view(out)
}

fn valid_header(h: http.Header) -> bool {
    if !valid_name(h.name) {
        return false
    }
    for i in 0..h.value.len {
        let c = h.value[i]
        if c == '\r' || c == '\n' || c == 0 {
            return false
        }
    }
    true
}

pub fn write_part(w: *Writer, headers: []http.Header, data: []u8) ! Error {
    if w.finished {
        fail Error.Finished
    }
    for h in headers {
        if !valid_header(h) {
            fail Error.InvalidHeader
        }
    }
    if !w.generated && text.contains(__str_view(data), "--{w.boundary}") {
        fail Error.BoundaryInData
    }
    text.append(mut w.out, "--{w.boundary}\r\n")
    for h in headers {
        text.append(mut w.out, "{h.name}: {h.value}\r\n")
    }
    text.append(mut w.out, "\r\n")
    io.append(mut w.out, data)
    text.append(mut w.out, "\r\n")
}

pub fn write_field(w: *Writer, name: str, value: str) ! Error {
    let disposition = http.Header { name: "Content-Disposition", value: "form-data; name={quote(name)}" }
    write_part(w, [disposition], bytes(value))?
}

pub fn write_file(w: *Writer, name: str, filename: str, content_type: str, data: []u8) ! Error {
    var kind = content_type
    if kind == "" {
        kind = "application/octet-stream"
    }
    let disposition = http.Header {
        name: "Content-Disposition"
        value: "form-data; name={quote(name)}; filename={quote(filename)}"
    }
    write_part(w, [disposition, http.Header { name: "Content-Type", value: kind }], data)?
}

pub fn finish(w: *Writer) -> []u8 {
    if !w.finished {
        text.append(mut w.out, "--{w.boundary}--\r\n")
        w.finished = true
    }
    w.out
}
