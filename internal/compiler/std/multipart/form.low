import std/io

/// A text field of a form.
pub struct Field {
    /// The field name from the `name` parameter of the part.
    pub name: str
    /// The text of the part.
    pub value: str
}

/// A file field of a form.
pub struct File {
    /// The field name from the `name` parameter of the part.
    pub name: str
    /// The file name the client sent. It is not checked, so do not use it as a path.
    pub filename: str
    /// The `content-type` header of the part, or an empty string when it has none.
    pub content_type: str
    /// The content when it was held in memory. Empty when `spilled` is `true`.
    pub data: []u8
    /// The size of the content in bytes, whether or not it was spilled.
    pub size: i64
    /// Whether the content was passed to the `Spill` sink instead of being held in `data`.
    pub spilled: bool
    /// The zero-based position of the part in the body.
    pub index: i64
}

/// The fields and files of a multipart form, each in the order it appeared in the body.
pub struct Form {
    /// The parts without a filename.
    pub fields: []Field
    /// The parts with a filename.
    pub files: []File
}

/// Receives file content that is too large to keep in memory.
pub struct Spill {
    /// Called with the part and a chunk of its content. The first call carries everything held so far, once it exceeds `Limits.max_memory`.
    pub write: fn(Part, []u8) ! io.Error
    /// Called with the part and its total size after its last chunk. It is not called for a file that stayed in memory.
    pub finish: fn(Part, i64) ! io.Error
}

/// Reads the remaining parts of the body into a `Form`.
///
/// Parts that are not `form-data` or have no name are skipped. A part with a filename is a file, and any other part is a field. Without `spill`, a file or field larger than `Limits.max_memory` fails with `TooLarge`. With `spill`, a file larger than that is passed to it. Fails with the errors of `next_part` and `read`, and with `Io` when a `Spill` function fails.
pub fn read_form(r: *Reader, spill: Spill?) -> Form ! Error {
    var form = Form { fields: [], files: [] }
    for {
        let part = next_part(r)? ?? break
        if part.disposition != "form-data" || part.name == "" {
            continue
        }
        match part.filename {
            some(filename) => {
                let file = read_file(r, part, filename, spill)?
                push(mut form.files, file)
            }
            none => {
                let value = read_text(r)?
                push(mut form.fields, Field { name: part.name, value })
            }
        }
    }
    form
}

fn read_file(r: *Reader, part: Part, filename: str, spill: Spill?) -> File ! Error {
    match spill {
        some(s) => {
            let body = read_spill(r, fn(chunk) ! io.Error { s.write(part, chunk) })?
            if body.spilled {
                s.finish(part, body.size) catch {
                    e => fail Error.Io(e)
                }
            }
            File {
                name: part.name, filename, content_type: part.content_type, data: body.data,
                size: body.size, spilled: body.spilled, index: part.index,
            }
        }
        none => {
            let data = read_bytes(r)?
            File {
                name: part.name, filename, content_type: part.content_type, data,
                size: data.len, spilled: false, index: part.index,
            }
        }
    }
}

/// Returns the value of the first field called `name`, or `none` when there is none.
pub fn value(f: Form, name: str) -> str? {
    for field in f.fields {
        if field.name == name {
            return field.value
        }
    }
    none
}

/// Returns the values of every field called `name`, in order.
pub fn values(f: Form, name: str) -> []str {
    var out: []str = []
    for field in f.fields {
        if field.name == name {
            push(mut out, field.value)
        }
    }
    out
}

/// Returns the first file called `name`, or `none` when there is none.
pub fn file(f: Form, name: str) -> File? {
    for item in f.files {
        if item.name == name {
            return item
        }
    }
    none
}

/// Returns every file called `name`, in order.
pub fn files_named(f: Form, name: str) -> []File {
    var out: []File = []
    for item in f.files {
        if item.name == name {
            push(mut out, item)
        }
    }
    out
}
