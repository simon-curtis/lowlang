import std/http
import std/io

/// Returns a reader for the multipart body of a request.
///
/// Fails with `BadContentType` when the request has no `content-type` header, and with the errors of `boundary_from_content_type`.
pub fn request_reader(req: http.Request, limits: Limits) -> *Reader ! Error {
    let content_type = http.header(req.headers, "content-type") ?? fail Error.BadContentType
    let boundary = boundary_from_content_type(content_type)?
    reader(io.bytes_reader(req.body), boundary, limits)?
}

/// Reads the whole multipart body of a request into a `Form`.
///
/// Fails with the errors of `request_reader` and `read_form`.
pub fn request_form(req: http.Request, limits: Limits, spill: Spill?) -> Form ! Error {
    let r = request_reader(req, limits)?
    read_form(r, spill)?
}

/// Sets the body and `content-type` of a request from a writer.
///
/// The writer is finished, so nothing can be added to it afterwards. An existing `content-type` header is replaced.
pub fn add_to_request(mut req: http.Request, w: *Writer) {
    http.set_header(mut req.headers, "Content-Type", content_type(w))
    req.body = finish(w)
}
