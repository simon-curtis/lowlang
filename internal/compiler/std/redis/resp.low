import std/io
import std/text

/// A decoded RESP reply.
///
/// RESP2 produces `Nil`, `Status`, `Failure`, `Integer`, `Bulk` and `Array`. RESP3 adds the remaining variants.
pub enum Reply {
    /// A null: a nil bulk string or nil array, or a RESP3 null.
    Nil
    /// A simple string such as `OK`, `QUEUED` or `PONG`, without the leading `+`.
    Status(text: str)
    /// An error reply, from a simple error or a RESP3 blob error. `text` is the message as sent, such as `ERR unknown command`.
    Failure(text: str)
    /// A signed 64-bit integer.
    Integer(value: i64)
    /// A binary-safe string as raw bytes.
    Bulk(data: []u8)
    /// An ordered list of replies.
    Array(items: []Reply)
    /// A RESP3 map: key and value replies in the order sent.
    Map(entries: []Pair)
    /// A RESP3 set, in the order sent.
    Set(items: []Reply)
    /// A RESP3 boolean.
    Boolean(value: bool)
    /// A RESP3 floating point number.
    Double(value: f64)
    /// A RESP3 big number as its decimal digits with an optional sign, left unconverted.
    BigNumber(digits: str)
    /// A RESP3 verbatim string. `format` is the three byte format tag such as `txt` or `mkd` and `text` is the content.
    Verbatim(format: str, text: str)
    /// A RESP3 out-of-band push frame. The client skips these outside a subscription.
    Push(items: []Reply)
}

/// A key and value reply of a `Map`.
pub struct Pair {
    /// The key reply.
    pub key: Reply
    /// The value reply.
    pub value: Reply
}

/// The error type of the redis module, returned by connecting, commands and decoding.
pub enum Error {
    /// The server could not be reached or the TLS handshake failed.
    Connect
    /// The client is closed or the connection ended.
    Closed
    /// A connect, read or write exceeded its time limit.
    Timeout
    /// The peer sent bytes that are not valid RESP, or a reply whose shape the call cannot accept.
    Protocol
    /// A reply exceeded a bound in `Limits`.
    TooLarge
    /// The server does not support `HELLO 3`, so RESP3 cannot be negotiated.
    Unsupported
    /// The connection is running a subscription and accepts no commands.
    Subscribed
    /// A transaction did not run: `EXEC` returned nil because a watched key changed.
    Aborted
    /// A reply had a type the call cannot convert, such as an array where an integer was expected.
    Type
    /// The server rejected the credentials. `message` is the server's text.
    Auth(message: str)
    /// The server answered a command with an error reply. `message` is the server's text.
    Server(message: str)
}

/// Bounds that stop a corrupt or hostile peer from forcing large allocations while decoding.
///
/// Defaults are `Limits {}`.
pub struct Limits {
    /// The largest bulk string, verbatim string or blob error payload in bytes. A larger one fails with `TooLarge`. Defaults to 64 MiB.
    pub bulk: i64 = 67108864
    /// The deepest nesting of arrays, maps, sets and pushes. Defaults to `32`.
    ///
    /// A deeper array or map fails with `TooLarge`; a deeper set or push fails with `Protocol`.
    pub depth: i64 = 32
    /// The largest number of elements an aggregate may declare. A larger one fails with `TooLarge`. Defaults to `1048576`.
    pub elements: i64 = 1048576
}

/// Returns the RESP encoding of a command as an array of bulk strings.
///
/// `args[0]` is the command name and the rest are its arguments. Arguments are length-prefixed, so any bytes are allowed.
pub fn encode(args: []str) -> []u8 {
    var out: []u8 = []
    encode_into(mut out, args)
    out
}

/// Appends the RESP encoding of a command to `out`, for batching several commands into one buffer. See `encode`.
pub fn encode_into(mut out: []u8, args: []str) {
    text.append(mut out, "*{args.len}\r\n")
    for arg in args {
        text.append(mut out, "${arg.len}\r\n")
        text.append(mut out, arg)
        text.append(mut out, "\r\n")
    }
}

/// Decodes the first reply in `data` using the default `Limits`.
///
/// Bytes after the first reply are ignored. Fails with `Protocol` when `data` is malformed or ends before the reply is complete.
pub fn decode(data: []u8) -> Reply ! Error {
    decode_with(data, Limits {})
}

/// Decodes the first reply in `data` using `limits`. Fails as `decode` does, and with `TooLarge` when a bound is exceeded.
pub fn decode_with(data: []u8, limits: Limits) -> Reply ! Error {
    let r = io.bytes_reader(data)
    read_reply(r, limits) catch {
        Closed => fail Protocol
        e => fail e
    }
}

/// Reads one reply from `r`, blocking until it is complete.
///
/// RESP3 attribute frames before the reply are read and discarded. Fails with `Closed` at end of input or on a read failure, `Timeout` when the read times out, `Protocol` when the bytes are not valid RESP, and `TooLarge` when a bound in `limits` is exceeded.
pub fn read_reply(r: *io.Reader, limits: Limits) -> Reply ! Error {
    read_value(r, limits, 0)
}

fn transport(e: io.Error) -> Error {
    match e {
        TimedOut => Timeout
        TooLarge => TooLarge
        Malformed => Protocol
        _ => Closed
    }
}

fn read_text(r: *io.Reader) -> str ! Error {
    io.read_line(r) catch {
        e => fail transport(e)
    }
}

fn read_bytes(r: *io.Reader, n: i64) -> []u8 ! Error {
    io.read_exact(r, n) catch {
        e => fail transport(e)
    }
}

fn number(s: str) -> i64 ! Error {
    text.parse_int(s) catch {
        _ => fail Protocol
    }
}

fn count(s: str, limits: Limits) -> i64 ! Error {
    let n = number(s)?
    if n < -1 {
        fail Protocol
    }
    if n > limits.elements {
        fail TooLarge
    }
    n
}

fn read_value(r: *io.Reader, limits: Limits, depth: i64) -> Reply ! Error {
    for {
        let line = read_text(r)?
        if line.len == 0 {
            fail Protocol
        }
        let body = line[1..]
        if line[0] == '|' {
            let skipped = count(body, limits)?
            if skipped < 0 {
                fail Protocol
            }
            read_pairs(r, limits, depth + 1, skipped)?
            continue
        }
        return read_body(r, limits, depth, line[0], body)
    }
}

fn read_body(r: *io.Reader, limits: Limits, depth: i64, kind: u8, body: str) -> Reply ! Error {
    match kind {
        == '+' => Status(body)
        == '-' => Failure(body)
        == ':' => Integer(number(body)?)
        == '$' => read_bulk(r, limits, body)?
        == '*' => read_array(r, limits, depth, body)?
        == '%' => read_map(r, limits, depth, body)?
        == '~' => read_set(r, limits, depth, body)?
        == '>' => read_push(r, limits, depth, body)?
        == '=' => read_verbatim(r, limits, body)?
        == '!' => read_blob_error(r, limits, body)?
        == '_' => read_null(body)?
        == '#' => read_boolean(body)?
        == ',' => read_double(body)?
        == '(' => read_big(body)?
        _ => fail Protocol
    }
}

fn read_null(body: str) -> Reply ! Error {
    if body.len != 0 {
        fail Protocol
    }
    Nil
}

fn read_boolean(body: str) -> Reply ! Error {
    if body == "t" {
        return Boolean(true)
    }
    if body == "f" {
        return Boolean(false)
    }
    fail Protocol
}

fn read_double(body: str) -> Reply ! Error {
    if body.len == 0 {
        fail Protocol
    }
    let v = text.parse_float(body) catch {
        _ => fail Protocol
    }
    Double(v)
}

fn read_big(body: str) -> Reply ! Error {
    var start = 0
    if body.len > 0 && (body[0] == '-' || body[0] == '+') {
        start = 1
    }
    if body.len == start {
        fail Protocol
    }
    for i in start..body.len {
        if body[i] < '0' || body[i] > '9' {
            fail Protocol
        }
    }
    BigNumber(body)
}

fn read_payload(r: *io.Reader, limits: Limits, body: str) -> []u8 ! Error {
    let n = number(body)?
    if n < 0 {
        fail Protocol
    }
    if n > limits.bulk {
        fail TooLarge
    }
    read_terminated(r, n)
}

fn read_terminated(r: *io.Reader, n: i64) -> []u8 ! Error {
    var data: []u8 = []
    if n <= 65536 {
        data = read_bytes(r, n)?
    } else {
        var rest = n
        for rest > 0 {
            let part = if rest > 65536 { 65536 } else { rest }
            io.append(mut data, read_bytes(r, part)?)
            rest -= part
        }
    }
    let end = read_bytes(r, 2)?
    if end[0] != '\r' || end[1] != '\n' {
        fail Protocol
    }
    data
}

fn read_bulk(r: *io.Reader, limits: Limits, body: str) -> Reply ! Error {
    if body == "-1" {
        return Nil
    }
    Bulk(read_payload(r, limits, body)?)
}

fn read_verbatim(r: *io.Reader, limits: Limits, body: str) -> Reply ! Error {
    let data = read_payload(r, limits, body)?
    if data.len < 4 || data[3] != ':' {
        fail Protocol
    }
    Verbatim(str(data[..3]), str(data[4..]))
}

fn read_blob_error(r: *io.Reader, limits: Limits, body: str) -> Reply ! Error {
    Failure(str(read_payload(r, limits, body)?))
}

fn read_items(r: *io.Reader, limits: Limits, depth: i64, n: i64) -> []Reply ! Error {
    var items: []Reply = []
    for _ in 0..n {
        push(mut items, read_value(r, limits, depth)?)
    }
    items
}

fn read_pairs(r: *io.Reader, limits: Limits, depth: i64, n: i64) -> []Pair ! Error {
    if depth > limits.depth {
        fail TooLarge
    }
    var entries: []Pair = []
    for _ in 0..n {
        let key = read_value(r, limits, depth)?
        let value = read_value(r, limits, depth)?
        push(mut entries, Pair { key, value })
    }
    entries
}

fn read_array(r: *io.Reader, limits: Limits, depth: i64, body: str) -> Reply ! Error {
    let n = count(body, limits)?
    if n < 0 {
        return Nil
    }
    if depth >= limits.depth {
        fail TooLarge
    }
    Array(read_items(r, limits, depth + 1, n)?)
}

fn read_set(r: *io.Reader, limits: Limits, depth: i64, body: str) -> Reply ! Error {
    let n = count(body, limits)?
    if n < 0 || depth >= limits.depth {
        fail Protocol
    }
    Set(read_items(r, limits, depth + 1, n)?)
}

fn read_push(r: *io.Reader, limits: Limits, depth: i64, body: str) -> Reply ! Error {
    let n = count(body, limits)?
    if n < 0 || depth >= limits.depth {
        fail Protocol
    }
    Push(read_items(r, limits, depth + 1, n)?)
}

fn read_map(r: *io.Reader, limits: Limits, depth: i64, body: str) -> Reply ! Error {
    let n = count(body, limits)?
    if n < 0 {
        fail Protocol
    }
    Map(read_pairs(r, limits, depth + 1, n)?)
}

/// Returns a single-line text form of `reply` for logs and tests.
///
/// `Nil` is `(nil)`, `Status` is `+text`, `Failure` is `-text`, `Integer` is `:n`, and `Bulk` is the quoted text. Arrays are `[a, b]`, maps `{k: v}`, sets `~[a, b]` and pushes `>[a, b]`, with elements formatted recursively.
pub fn format(reply: Reply) -> str {
    match reply {
        Nil => "(nil)"
        Status(t) => "+{t}"
        Failure(t) => "-{t}"
        Integer(v) => ":{v}"
        Bulk(d) => text.quote(str(d))
        Array(items) => "[{join(items)}]"
        Map(entries) => "{{{join_pairs(entries)}}}"
        Set(items) => "~[{join(items)}]"
        Boolean(v) => if v { "#t" } else { "#f" }
        Double(v) => ",{v}"
        BigNumber(d) => "({d}"
        Verbatim(f, t) => "={f}:{text.quote(t)}"
        Push(items) => ">[{join(items)}]"
    }
}

fn join(items: []Reply) -> str {
    var parts: []str = []
    for item in items {
        push(mut parts, format(item))
    }
    text.join(parts, ", ")
}

fn join_pairs(entries: []Pair) -> str {
    var parts: []str = []
    for e in entries {
        push(mut parts, "{format(e.key)}: {format(e.value)}")
    }
    text.join(parts, ", ")
}
