import std/io
import std/net
import std/sync
import std/text
import std/tls

/// Connection settings for `connect`, `connect_tls` and `connect_stream`.
///
/// Every field has a default, so `Options {}` connects to a local server over RESP2 without authentication.
pub struct Options {
    /// The server host name or IP literal. Defaults to `"127.0.0.1"`. `connect_tls` also uses it as the TLS server name when the config has none.
    pub host: str = "127.0.0.1"
    /// The server TCP port. Defaults to `6379`.
    pub port: i64 = 6379
    /// The ACL user name sent with `AUTH` or `HELLO`. Empty by default: `AUTH` then carries the password alone and `HELLO` authenticates `default`. Ignored when `password` is empty.
    pub username: str = ""
    /// The password sent when connecting. Empty, the default, sends no authentication.
    pub password: str = ""
    /// The database index chosen with `SELECT` after connecting. `0`, the default, sends no `SELECT`.
    pub database: i64 = 0
    /// The RESP version to negotiate. `3` sends `HELLO 3`; any other value stays on RESP2. Defaults to `2`.
    pub protocol: i64 = 2
    /// The read and write time limit in milliseconds for every operation on the connection. `0`, the default, waits indefinitely.
    ///
    /// An operation that exceeds it fails with `Timeout` and closes the client.
    pub timeout: i64 = 0
    /// The time limit in milliseconds for establishing the TCP connection, which fails with `Timeout` when exceeded. `0`, the default, leaves the limit to `std/net`. Not used by `connect_stream`.
    pub connect_timeout: i64 = 0
    /// The capacity of the `messages` channel of each `Subscription`. When it is full the connection stops reading until the consumer catches up. Defaults to `256`.
    pub buffer: i64 = 256
    /// The bounds applied when decoding every reply. Defaults to `Limits {}`.
    pub limits: Limits = Limits {}
}

/// A copyable reference to the state of one server connection.
///
/// Copies refer to the same connection. Commands on it are serialised by an internal lock, so green threads may share it. `detach` returns one from a `Client`, `adopt` turns it back into a `Client`, and the `_on` functions take it directly.
pub struct ClientHandle {
    stream: io.Stream
    reader: *io.Reader
    gate: sync.Mutex
    timeouts: *net.Timeouts
    timeout: i64
    limits: Limits
    stop: chan[bool]
    buffer: i64
    lock: i64
    closed: bool
    subscribed: bool
    /// The RESP version in use: `3` after a successful `HELLO 3`, otherwise `2`.
    pub protocol: i64
}

/// An owned connection to a Redis server, from `connect`, `connect_tls` or `connect_stream`.
///
/// Dropping a `Client` closes the connection, unless `detach` released it first.
pub struct Client {
    /// The shared state of the connection, for the `_on` functions.
    pub handle: *ClientHandle
    detached: bool = false
    drop {
        if !detached {
            close_client_on(handle)
        }
    }
}

/// Modifiers for `set_with`.
///
/// A zero or `false` field leaves its modifier off. Combinations the server rejects, such as `nx` with `xx`, fail with `Server`.
pub struct SetOptions {
    /// The expiry in seconds, sent as `EX`. `0`, the default, sends none.
    pub ex: i64 = 0
    /// The expiry in milliseconds, sent as `PX`. `0`, the default, sends none.
    pub px: i64 = 0
    /// Stores the value only when the key does not exist, sent as `NX`.
    pub nx: bool = false
    /// Stores the value only when the key already exists, sent as `XX`.
    pub xx: bool = false
    /// Keeps the time to live already on the key instead of clearing it, sent as `KEEPTTL`.
    pub keep_ttl: bool = false
}

/// A hash field name and its value.
pub struct Field {
    /// The field name.
    pub name: str
    /// The field value.
    pub value: str
}

/// A sorted set member and its score.
pub struct Scored {
    /// The member.
    pub member: str
    /// The score the set orders the member by.
    pub score: f64
}

/// A message delivered on a `Subscription`.
pub struct Message {
    /// The pattern that matched `channel` for a `psubscribe` subscription. Empty for a `subscribe` subscription.
    pub pattern: str
    /// The channel the message was published to.
    pub channel: str
    /// The message body.
    pub payload: str
}

/// A running subscription to channels or patterns, from `subscribe` or `psubscribe`.
///
/// While it runs the connection is dedicated to it: commands on the client fail with `Subscribed`, and no read time limit applies. A green thread reads the connection and sends each message to `messages`.
///
/// `messages` is closed when the subscription ends, which happens after `unsubscribe` is confirmed or when the connection fails or is closed. An unsubscribe leaves the client usable for commands; a failure closes it.
pub struct Subscription {
    /// Receives the messages in the order the server sent them. It is closed when the subscription ends.
    pub messages: chan[Message]
    handle: *ClientHandle
    patterns: bool
}

/// Wraps a connection handle in a `Client` that owns it.
///
/// Dropping the returned client closes the connection. Pairs with `detach`.
pub fn adopt(h: *ClientHandle) -> Client {
    Client { handle: h }
}

/// Releases the client's ownership of its connection and returns the `ClientHandle`.
///
/// Dropping `c` afterwards does not close the connection; close it with `close_client_on` or take it back with `adopt`. Use it to share the connection between green threads.
pub fn detach(mut c: Client) -> *ClientHandle {
    c.detached = true
    c.handle
}

fn open(s: io.Stream, timeouts: *net.Timeouts, o: Options) -> *ClientHandle {
    new(ClientHandle {
        stream: s
        reader: io.reader(s)
        gate: sync.mutex()
        timeouts
        timeout: o.timeout
        limits: o.limits
        stop: chan[bool]()
        buffer: o.buffer
        lock: 0
        closed: false
        subscribed: false
        protocol: 2
    })
}

fn apply_timeout(t: *net.Timeouts, millis: i64) {
    t.read = millis
    t.write = millis
}

fn established(h: *ClientHandle, o: Options) -> Client ! Error {
    handshake(h, o) catch {
        e => {
            close_client_on(h)
            fail e
        }
    }
    Client { handle: h }
}

fn dial(o: Options) -> net.Conn ! Error {
    using conn = net.dial_within(o.host, o.port, o.connect_timeout) catch {
        TimedOut => fail Timeout
        _ => fail Connect
    }
    conn
}

/// Opens a TCP connection to `o.host` and `o.port` and performs the handshake.
///
/// The handshake sends `HELLO 3` when `o.protocol` is `3`, otherwise `AUTH` when `o.password` is set, then `SELECT` when `o.database` is not `0`. Fails with `Connect` when the server cannot be reached, `Timeout` when `o.connect_timeout` expires, `Auth` when the credentials are rejected, `Unsupported` when `HELLO 3` is rejected and no password is set, `Server` when `SELECT` is rejected, or with a transport `Error` from the exchange. The connection is closed when the handshake fails.
pub fn connect(o: Options) -> Client ! Error {
    using var conn = dial(o)?
    let wire = net.detach(mut conn)
    apply_timeout(wire.timeouts, o.timeout)
    let h = open(net.stream_on(wire), wire.timeouts, o)
    established(h, o)
}

/// Opens a TCP connection and performs the handshake over TLS configured by `config`.
///
/// When `config.server_name` is empty, `o.host` is used. Behaves as `connect`, and a failed TLS handshake fails with `Connect`, or `Timeout` when it times out.
pub fn connect_tls(o: Options, config: tls.Config) -> Client ! Error {
    using var conn = dial(o)?
    apply_timeout(conn.handle.timeouts, o.timeout)
    var named = config
    if named.server_name.len == 0 {
        named.server_name = o.host
    }
    let session = tls.client_handle(net.stream(conn), named) catch {
        TimedOut => fail Timeout
        _ => fail Connect
    }
    let wire = net.detach(mut conn)
    let h = open(tls.stream_on(session), wire.timeouts, o)
    established(h, o)
}

/// Performs the handshake over an existing `io.Stream` instead of dialling.
///
/// `o.host`, `o.port`, `o.timeout` and `o.connect_timeout` are not used, and `set_timeout` has no effect because the stream carries no time limits. Closing the client closes the stream. Fails as `connect` does from the handshake onwards.
pub fn connect_stream(s: io.Stream, o: Options) -> Client ! Error {
    let h = open(s, new(net.Timeouts { read: 0, write: 0 }), o)
    established(h, o)
}

fn handshake(h: *ClientHandle, o: Options) ! Error {
    if o.protocol == 3 {
        hello(h, o)?
    } else if o.password.len > 0 {
        authenticate(h, o)?
    }
    if o.database != 0 {
        let reply = command_on(h, ["SELECT", "{o.database}"])?
        match failure_text(reply) {
            some(t) => fail Server(t)
            none => {}
        }
    }
}

fn hello(h: *ClientHandle, o: Options) ! Error {
    var args = ["HELLO", "3"]
    if o.password.len > 0 {
        let user = if o.username.len > 0 { o.username } else { "default" }
        args = ["HELLO", "3", "AUTH", user, o.password]
    }
    let reply = command_on(h, args)?
    match failure_text(reply) {
        some(t) => {
            if o.password.len > 0 {
                fail Auth(t)
            }
            fail Unsupported
        }
        none => {}
    }
    h.protocol = 3
}

fn authenticate(h: *ClientHandle, o: Options) ! Error {
    var args = ["AUTH", o.password]
    if o.username.len > 0 {
        args = ["AUTH", o.username, o.password]
    }
    let reply = command_on(h, args)?
    match failure_text(reply) {
        some(t) => fail Auth(t)
        none => {}
    }
}

fn failure_text(r: Reply) -> str? {
    match r {
        Failure(t) => some(t)
        _ => none
    }
}

/// Closes the connection.
///
/// Closing twice is harmless. Later commands fail with `Closed`, and the `messages` channel of a running subscription is closed.
pub fn close_client(c: Client) {
    close_client_on(c.handle)
}

/// Closes the connection behind `h`. Closing twice is harmless. See `close_client`.
pub fn close_client_on(h: *ClientHandle) {
    __lock(mut h.lock)
    if h.closed {
        __unlock(mut h.lock)
        return
    }
    h.closed = true
    __unlock(mut h.lock)
    close(h.stop)
    h.stream.close()
}

/// Sets the read and write time limit in milliseconds for later operations, replacing `Options.timeout`. `0` waits indefinitely.
///
/// A running subscription reads without a limit; the value applies again once it ends.
pub fn set_timeout(c: Client, millis: i64) {
    set_timeout_on(c.handle, millis)
}

/// Sets the read and write time limit in milliseconds on the connection behind `h`. See `set_timeout`.
pub fn set_timeout_on(h: *ClientHandle, millis: i64) {
    h.timeout = millis
    apply_timeout(h.timeouts, millis)
}

fn abandon(h: *ClientHandle, e: Error) -> Error {
    close_client_on(h)
    e
}

fn usable(h: *ClientHandle) ! Error {
    if h.closed {
        fail Closed
    }
    if h.subscribed {
        fail Subscribed
    }
}

fn send(h: *ClientHandle, payload: []u8) ! Error {
    io.write_all(h.stream, payload) catch {
        e => fail abandon(h, transport(e))
    }
}

fn receive(h: *ClientHandle) -> Reply ! Error {
    for {
        let reply = read_reply(h.reader, h.limits) catch {
            e => fail abandon(h, e)
        }
        match reply {
            Push(items) => continue
            _ => return reply
        }
    }
}

fn exchange(h: *ClientHandle, payload: []u8, expected: i64) -> []Reply ! Error {
    sync.lock(h.gate)
    defer sync.unlock(h.gate)
    usable(h)?
    send(h, payload)?
    var replies: []Reply = []
    for _ in 0..expected {
        let reply = receive(h)?
        push(mut replies, reply)
    }
    replies
}

/// Sends one command and returns its reply.
///
/// `args[0]` is the command name and the rest are its arguments, sent as binary-safe bulk strings. Every reply type is returned as is, including an error reply as `Failure`, which is not raised. RESP3 `Push` frames that arrive before the reply are skipped. Concurrent calls on one connection are serialised.
///
/// Fails with `Closed` after the client is closed and `Subscribed` while a subscription runs. A transport failure fails with `Timeout`, `Closed`, `TooLarge` or `Protocol` and closes the client.
pub fn command(c: Client, args: []str) -> Reply ! Error {
    command_on(c.handle, args)
}

/// Sends one command on the connection behind `h` and returns its reply. See `command`.
pub fn command_on(h: *ClientHandle, args: []str) -> Reply ! Error {
    let replies = exchange(h, encode(args), 1)?
    replies[0]
}

/// Sends `commands` in one write and returns the replies in the same order.
///
/// Each entry is a command name followed by its arguments. An empty list returns an empty list without using the connection. An error reply appears as a `Failure` element and does not stop the rest. Fails as `command` does, and a transport failure closes the client.
pub fn run_pipeline(c: Client, commands: [][]str) -> []Reply ! Error {
    run_pipeline_on(c.handle, commands)
}

/// Sends `commands` in one write on the connection behind `h`. See `run_pipeline`.
pub fn run_pipeline_on(h: *ClientHandle, commands: [][]str) -> []Reply ! Error {
    if commands.len == 0 {
        return []
    }
    exchange(h, encode_all(commands), commands.len)
}

fn encode_all(commands: [][]str) -> []u8 {
    var out: []u8 = []
    for args in commands {
        encode_into(mut out, args)
    }
    out
}

/// Runs `commands` atomically between `MULTI` and `EXEC`, sent in one write, and returns the result of each in order.
///
/// Fails with `Server` when the server rejects a command or `MULTI` while queueing, and with `Aborted` when `EXEC` returns nil because a key given to `watch` changed. A command that fails while `EXEC` runs appears as a `Failure` element.
pub fn transaction(c: Client, commands: [][]str) -> []Reply ! Error {
    transaction_on(c.handle, commands)
}

/// Runs `commands` in a transaction on the connection behind `h`. See `transaction`.
pub fn transaction_on(h: *ClientHandle, commands: [][]str) -> []Reply ! Error {
    var all: [][]str = [["MULTI"]]
    for args in commands {
        push(mut all, args)
    }
    push(mut all, ["EXEC"])
    let replies = exchange(h, encode_all(all), all.len)?
    for r in replies[..replies.len - 1] {
        match failure_text(r) {
            some(t) => fail Server(t)
            none => {}
        }
    }
    exec_items(replies[replies.len - 1])
}

fn exec_items(r: Reply) -> []Reply ! Error {
    match r {
        Array(items) => items
        Nil => fail Aborted
        Failure(t) => fail Server(t)
        _ => fail Type
    }
}

/// Starts a transaction with `MULTI`.
///
/// Commands sent with `command` are then queued by the server and answer `Status("QUEUED")`; the typed commands such as `get` fail with `Type` meanwhile. End it with `exec` or `discard`. Fails with `Server` on an error reply.
pub fn multi(c: Client) ! Error {
    multi_on(c.handle)?
}

/// Starts a transaction on the connection behind `h`. See `multi`.
pub fn multi_on(h: *ClientHandle) ! Error {
    let reply = call(h, ["MULTI"])?
    expect_ok(reply)?
}

/// Runs the commands queued since `multi` and returns the result of each in order.
///
/// Fails with `Aborted` when the server returns nil because a watched key changed, `Server` on an error reply such as `EXECABORT` or `EXEC without MULTI`, and `Type` on any other reply.
pub fn exec(c: Client) -> []Reply ! Error {
    exec_on(c.handle)
}

/// Runs the queued transaction on the connection behind `h`. See `exec`.
pub fn exec_on(h: *ClientHandle) -> []Reply ! Error {
    let reply = command_on(h, ["EXEC"])?
    exec_items(reply)
}

/// Drops the commands queued since `multi` and ends the transaction. Fails with `Server` when no transaction is open.
pub fn discard(c: Client) ! Error {
    discard_on(c.handle)?
}

/// Drops the queued transaction on the connection behind `h`. See `discard`.
pub fn discard_on(h: *ClientHandle) ! Error {
    let reply = call(h, ["DISCARD"])?
    expect_ok(reply)?
}

/// Watches `keys` so that the next `exec` returns `Aborted` if any of them changes first.
///
/// The watch ends with `exec`, `discard` or `unwatch`. Fails with `Server` on an error reply, including an empty `keys`.
pub fn watch(c: Client, keys: []str) ! Error {
    watch_on(c.handle, keys)?
}

/// Watches `keys` on the connection behind `h`. See `watch`.
pub fn watch_on(h: *ClientHandle, keys: []str) ! Error {
    let args = with(["WATCH"], keys)
    let reply = call(h, args)?
    expect_ok(reply)?
}

/// Forgets every key watched with `watch`.
pub fn unwatch(c: Client) ! Error {
    unwatch_on(c.handle)?
}

/// Forgets the watched keys on the connection behind `h`. See `unwatch`.
pub fn unwatch_on(h: *ClientHandle) ! Error {
    let reply = call(h, ["UNWATCH"])?
    expect_ok(reply)?
}

fn call(h: *ClientHandle, args: []str) -> Reply ! Error {
    let reply = command_on(h, args)?
    match failure_text(reply) {
        some(t) => fail Server(t)
        none => reply
    }
}

fn with(prefix: []str, rest: []str) -> []str {
    var out = prefix
    for item in rest {
        push(mut out, item)
    }
    out
}

fn expect_ok(r: Reply) ! Error {
    match r {
        Status(t) => {
            if t != "OK" && t != "QUEUED" {
                fail Type
            }
        }
        _ => fail Type
    }
}

fn integer(r: Reply) -> i64 ! Error {
    match r {
        Integer(v) => v
        _ => fail Type
    }
}

fn boolean(r: Reply) -> bool ! Error {
    match r {
        Integer(v) => v != 0
        Boolean(v) => v
        _ => fail Type
    }
}

fn text_of(r: Reply) -> str ! Error {
    match r {
        Bulk(d) => str(d)
        Status(t) => t
        Verbatim(f, t) => t
        Integer(v) => "{v}"
        BigNumber(d) => d
        _ => fail Type
    }
}

fn optional_text(r: Reply) -> str? ! Error {
    match r {
        Nil => none
        _ => {
            let value = text_of(r)?
            some(value)
        }
    }
}

fn items_of(r: Reply) -> []Reply ! Error {
    match r {
        Array(items) => items
        Set(items) => items
        Push(items) => items
        Nil => []
        _ => fail Type
    }
}

fn texts(r: Reply) -> []str ! Error {
    var out: []str = []
    let items = items_of(r)?
    for item in items {
        let value = text_of(item)?
        push(mut out, value)
    }
    out
}

fn score_of(r: Reply) -> f64 ! Error {
    match r {
        Double(v) => v
        Integer(v) => f64(v)
        Bulk(d) => parse_score(str(d))?
        _ => fail Type
    }
}

fn parse_score(s: str) -> f64 ! Error {
    text.parse_float(s) catch {
        _ => fail Protocol
    }
}

fn fields_of(r: Reply) -> []Field ! Error {
    var out: []Field = []
    match r {
        Map(entries) => {
            for e in entries {
                let name = text_of(e.key)?
                let value = text_of(e.value)?
                push(mut out, Field { name, value })
            }
        }
        _ => {
            let items = items_of(r)?
            if items.len % 2 != 0 {
                fail Protocol
            }
            var i = 0
            for i < items.len {
                let name = text_of(items[i])?
                let value = text_of(items[i + 1])?
                push(mut out, Field { name, value })
                i += 2
            }
        }
    }
    out
}

fn scored_of(r: Reply) -> []Scored ! Error {
    let items = items_of(r)?
    var out: []Scored = []
    if items.len > 0 && is_array(items[0]) {
        for pair in items {
            let two = items_of(pair)?
            if two.len != 2 {
                fail Protocol
            }
            let member = text_of(two[0])?
            let score = score_of(two[1])?
            push(mut out, Scored { member, score })
        }
        return out
    }
    if items.len % 2 != 0 {
        fail Protocol
    }
    var i = 0
    for i < items.len {
        let member = text_of(items[i])?
        let score = score_of(items[i + 1])?
        push(mut out, Scored { member, score })
        i += 2
    }
    out
}

fn is_array(r: Reply) -> bool {
    match r {
        Array(items) => true
        _ => false
    }
}

/// Sends `PING` and returns when the server answers.
///
/// Fails with `Type` on any reply other than `PONG` or a bulk string, so it also checks that the connection is alive.
pub fn ping(c: Client) ! Error {
    ping_on(c.handle)?
}

/// Pings the server on the connection behind `h`. See `ping`.
pub fn ping_on(h: *ClientHandle) ! Error {
    let reply = call(h, ["PING"])?
    match reply {
        Status(t) => {
            if t != "PONG" {
                fail Type
            }
        }
        Bulk(d) => {}
        _ => fail Type
    }
}

/// Returns the value of `key`, or `none` when the key does not exist.
///
/// Fails with `Server` on an error reply such as a key holding a different type.
pub fn get(c: Client, key: str) -> str? ! Error {
    get_on(c.handle, key)
}

/// Returns the value of `key` on the connection behind `h`. See `get`.
pub fn get_on(h: *ClientHandle, key: str) -> str? ! Error {
    let reply = call(h, ["GET", key])?
    optional_text(reply)
}

/// Stores `value` at `key`, replacing any existing value and clearing its time to live. Fails with `Server` on an error reply.
pub fn set(c: Client, key: str, value: str) ! Error {
    set_on(c.handle, key, value)?
}

/// Stores `value` at `key` on the connection behind `h`. See `set`.
pub fn set_on(h: *ClientHandle, key: str, value: str) ! Error {
    let reply = call(h, ["SET", key, value])?
    expect_ok(reply)?
}

/// Stores `value` at `key` subject to `o`.
///
/// Returns `true` when the value was stored and `false` when the `nx` or `xx` condition stopped it. Fails with `Server` on an error reply.
pub fn set_with(c: Client, key: str, value: str, o: SetOptions) -> bool ! Error {
    set_with_on(c.handle, key, value, o)
}

/// Stores `value` at `key` subject to `o` on the connection behind `h`. See `set_with`.
pub fn set_with_on(h: *ClientHandle, key: str, value: str, o: SetOptions) -> bool ! Error {
    var args = ["SET", key, value]
    if o.ex > 0 {
        args = with(args, ["EX", "{o.ex}"])
    }
    if o.px > 0 {
        args = with(args, ["PX", "{o.px}"])
    }
    if o.nx {
        push(mut args, "NX")
    }
    if o.xx {
        push(mut args, "XX")
    }
    if o.keep_ttl {
        push(mut args, "KEEPTTL")
    }
    let reply = call(h, args)?
    match reply {
        Nil => false
        _ => {
            expect_ok(reply)?
            true
        }
    }
}

/// Deletes `keys` and returns how many existed.
///
/// An empty `keys` fails with `Server`.
pub fn del(c: Client, keys: []str) -> i64 ! Error {
    del_on(c.handle, keys)
}

/// Deletes `keys` on the connection behind `h`. See `del`.
pub fn del_on(h: *ClientHandle, keys: []str) -> i64 ! Error {
    let args = with(["DEL"], keys)
    let reply = call(h, args)?
    integer(reply)
}

/// Returns how many of `keys` exist.
///
/// An empty `keys` fails with `Server`.
pub fn exists(c: Client, keys: []str) -> i64 ! Error {
    exists_on(c.handle, keys)
}

/// Counts the existing `keys` on the connection behind `h`. See `exists`.
pub fn exists_on(h: *ClientHandle, keys: []str) -> i64 ! Error {
    let args = with(["EXISTS"], keys)
    let reply = call(h, args)?
    integer(reply)
}

/// Sets a time to live of `seconds` on `key`. Returns `true` when it was set and `false` when the key does not exist.
pub fn expire(c: Client, key: str, seconds: i64) -> bool ! Error {
    expire_on(c.handle, key, seconds)
}

/// Sets a time to live on `key` on the connection behind `h`. See `expire`.
pub fn expire_on(h: *ClientHandle, key: str, seconds: i64) -> bool ! Error {
    let reply = call(h, ["EXPIRE", key, "{seconds}"])?
    boolean(reply)
}

/// Returns the remaining time to live of `key` in seconds: `-1` when it has none and `-2` when the key does not exist.
pub fn ttl(c: Client, key: str) -> i64 ! Error {
    ttl_on(c.handle, key)
}

/// Returns the remaining time to live of `key` on the connection behind `h`. See `ttl`.
pub fn ttl_on(h: *ClientHandle, key: str) -> i64 ! Error {
    let reply = call(h, ["TTL", key])?
    integer(reply)
}

/// Adds one to the integer at `key` and returns the new value.
///
/// A missing key counts as `0`. Fails with `Server` when the value is not an integer.
pub fn incr(c: Client, key: str) -> i64 ! Error {
    incr_on(c.handle, key)
}

/// Adds one to the integer at `key` on the connection behind `h`. See `incr`.
pub fn incr_on(h: *ClientHandle, key: str) -> i64 ! Error {
    let reply = call(h, ["INCR", key])?
    integer(reply)
}

/// Adds `n` to the integer at `key` and returns the new value.
///
/// A missing key counts as `0`. Fails with `Server` when the value is not an integer.
pub fn incrby(c: Client, key: str, n: i64) -> i64 ! Error {
    incrby_on(c.handle, key, n)
}

/// Adds `n` to the integer at `key` on the connection behind `h`. See `incrby`.
pub fn incrby_on(h: *ClientHandle, key: str, n: i64) -> i64 ! Error {
    let reply = call(h, ["INCRBY", key, "{n}"])?
    integer(reply)
}

/// Returns the value of `field` in the hash at `key`, or `none` when the field or the key does not exist.
pub fn hget(c: Client, key: str, field: str) -> str? ! Error {
    hget_on(c.handle, key, field)
}

/// Returns a hash field on the connection behind `h`. See `hget`.
pub fn hget_on(h: *ClientHandle, key: str, field: str) -> str? ! Error {
    let reply = call(h, ["HGET", key, field])?
    optional_text(reply)
}

/// Sets each of `fields` in the hash at `key` and returns how many were new.
///
/// Fields that already existed are updated and not counted. An empty `fields` fails with `Server`.
pub fn hset(c: Client, key: str, fields: []Field) -> i64 ! Error {
    hset_on(c.handle, key, fields)
}

/// Sets hash fields on the connection behind `h`. See `hset`.
pub fn hset_on(h: *ClientHandle, key: str, fields: []Field) -> i64 ! Error {
    var args = ["HSET", key]
    for f in fields {
        push(mut args, f.name)
        push(mut args, f.value)
    }
    let reply = call(h, args)?
    integer(reply)
}

/// Returns every field and value of the hash at `key`. A missing key gives an empty list.
///
/// Reads the RESP3 map form and the RESP2 flat list; a flat list of odd length fails with `Protocol`.
pub fn hgetall(c: Client, key: str) -> []Field ! Error {
    hgetall_on(c.handle, key)
}

/// Returns every field of the hash at `key` on the connection behind `h`. See `hgetall`.
pub fn hgetall_on(h: *ClientHandle, key: str) -> []Field ! Error {
    let reply = call(h, ["HGETALL", key])?
    fields_of(reply)
}

/// Pushes `values` onto the head of the list at `key` one after another, so the last value ends up first, and returns the new length.
///
/// An empty `values` fails with `Server`.
pub fn lpush(c: Client, key: str, values: []str) -> i64 ! Error {
    lpush_on(c.handle, key, values)
}

/// Pushes onto the head of a list on the connection behind `h`. See `lpush`.
pub fn lpush_on(h: *ClientHandle, key: str, values: []str) -> i64 ! Error {
    let args = with(["LPUSH", key], values)
    let reply = call(h, args)?
    integer(reply)
}

/// Appends `values` to the tail of the list at `key` in order and returns the new length.
///
/// An empty `values` fails with `Server`.
pub fn rpush(c: Client, key: str, values: []str) -> i64 ! Error {
    rpush_on(c.handle, key, values)
}

/// Appends to the tail of a list on the connection behind `h`. See `rpush`.
pub fn rpush_on(h: *ClientHandle, key: str, values: []str) -> i64 ! Error {
    let args = with(["RPUSH", key], values)
    let reply = call(h, args)?
    integer(reply)
}

/// Removes and returns the first element of the list at `key`, or `none` when the list is empty or missing.
pub fn lpop(c: Client, key: str) -> str? ! Error {
    lpop_on(c.handle, key)
}

/// Pops the head of a list on the connection behind `h`. See `lpop`.
pub fn lpop_on(h: *ClientHandle, key: str) -> str? ! Error {
    let reply = call(h, ["LPOP", key])?
    optional_text(reply)
}

/// Removes and returns the last element of the list at `key`, or `none` when the list is empty or missing.
pub fn rpop(c: Client, key: str) -> str? ! Error {
    rpop_on(c.handle, key)
}

/// Pops the tail of a list on the connection behind `h`. See `rpop`.
pub fn rpop_on(h: *ClientHandle, key: str) -> str? ! Error {
    let reply = call(h, ["RPOP", key])?
    optional_text(reply)
}

/// Returns the elements of the list at `key` from index `start` to `stop`, both inclusive.
///
/// Negative indexes count from the end, so `-1` is the last element. A missing key or an out of range slice gives an empty list.
pub fn lrange(c: Client, key: str, start: i64, stop: i64) -> []str ! Error {
    lrange_on(c.handle, key, start, stop)
}

/// Returns a slice of a list on the connection behind `h`. See `lrange`.
pub fn lrange_on(h: *ClientHandle, key: str, start: i64, stop: i64) -> []str ! Error {
    let reply = call(h, ["LRANGE", key, "{start}", "{stop}"])?
    texts(reply)
}

/// Adds `members` to the set at `key` and returns how many were new.
///
/// An empty `members` fails with `Server`.
pub fn sadd(c: Client, key: str, members: []str) -> i64 ! Error {
    sadd_on(c.handle, key, members)
}

/// Adds members to a set on the connection behind `h`. See `sadd`.
pub fn sadd_on(h: *ClientHandle, key: str, members: []str) -> i64 ! Error {
    let args = with(["SADD", key], members)
    let reply = call(h, args)?
    integer(reply)
}

/// Returns every member of the set at `key` in the order the server sends them, which is unspecified. A missing key gives an empty list.
pub fn smembers(c: Client, key: str) -> []str ! Error {
    smembers_on(c.handle, key)
}

/// Returns the members of a set on the connection behind `h`. See `smembers`.
pub fn smembers_on(h: *ClientHandle, key: str) -> []str ! Error {
    let reply = call(h, ["SMEMBERS", key])?
    texts(reply)
}

/// Adds `members` to the sorted set at `key`, updating the score of any that exist, and returns how many were new.
///
/// An empty `members` fails with `Server`.
pub fn zadd(c: Client, key: str, members: []Scored) -> i64 ! Error {
    zadd_on(c.handle, key, members)
}

/// Adds scored members to a sorted set on the connection behind `h`. See `zadd`.
pub fn zadd_on(h: *ClientHandle, key: str, members: []Scored) -> i64 ! Error {
    var args = ["ZADD", key]
    for m in members {
        push(mut args, "{m.score}")
        push(mut args, m.member)
    }
    let reply = call(h, args)?
    integer(reply)
}

/// Returns the members of the sorted set at `key` ranked `start` to `stop`, both inclusive, by ascending score.
///
/// Negative indexes count from the end. A missing key gives an empty list.
pub fn zrange(c: Client, key: str, start: i64, stop: i64) -> []str ! Error {
    zrange_on(c.handle, key, start, stop)
}

/// Returns a rank range of a sorted set on the connection behind `h`. See `zrange`.
pub fn zrange_on(h: *ClientHandle, key: str, start: i64, stop: i64) -> []str ! Error {
    let reply = call(h, ["ZRANGE", key, "{start}", "{stop}"])?
    texts(reply)
}

/// Returns the members of the sorted set at `key` ranked `start` to `stop`, both inclusive, each with its score.
///
/// Reads the RESP3 list of pairs and the RESP2 flat list. Ranking and negative indexes are as for `zrange`.
pub fn zrange_scores(c: Client, key: str, start: i64, stop: i64) -> []Scored ! Error {
    zrange_scores_on(c.handle, key, start, stop)
}

/// Returns a rank range with scores on the connection behind `h`. See `zrange_scores`.
pub fn zrange_scores_on(h: *ClientHandle, key: str, start: i64, stop: i64) -> []Scored ! Error {
    let reply = call(h, ["ZRANGE", key, "{start}", "{stop}", "WITHSCORES"])?
    scored_of(reply)
}

/// Sends `message` to `channel` and returns how many subscribers received it.
pub fn publish(c: Client, channel: str, message: str) -> i64 ! Error {
    publish_on(c.handle, channel, message)
}

/// Publishes `message` on the connection behind `h`. See `publish`.
pub fn publish_on(h: *ClientHandle, channel: str, message: str) -> i64 ! Error {
    let reply = call(h, ["PUBLISH", channel, message])?
    integer(reply)
}

/// Subscribes to `channels` and returns the running `Subscription`.
///
/// Returns once the server has confirmed every channel. The connection is dedicated to the subscription until it ends; other commands fail with `Subscribed`. Fails with `Protocol` when `channels` is empty, `Server` when the server rejects the subscription, `Subscribed` when one is already running, and `Closed` when the connection ends before the confirmation.
pub fn subscribe(c: Client, channels: []str) -> Subscription ! Error {
    subscribe_on(c.handle, channels)
}

/// Subscribes to `channels` on the connection behind `h`. See `subscribe`.
pub fn subscribe_on(h: *ClientHandle, channels: []str) -> Subscription ! Error {
    start_subscription(h, with(["SUBSCRIBE"], channels), channels.len, false)
}

/// Subscribes to the glob-style `patterns` and returns the running `Subscription`.
///
/// Each `Message` carries the matching pattern in `pattern`. Fails as `subscribe` does.
pub fn psubscribe(c: Client, patterns: []str) -> Subscription ! Error {
    psubscribe_on(c.handle, patterns)
}

/// Subscribes to `patterns` on the connection behind `h`. See `psubscribe`.
pub fn psubscribe_on(h: *ClientHandle, patterns: []str) -> Subscription ! Error {
    start_subscription(h, with(["PSUBSCRIBE"], patterns), patterns.len, true)
}

fn start_subscription(h: *ClientHandle, args: []str, expected: i64, patterns: bool) -> Subscription ! Error {
    if expected == 0 {
        fail Protocol
    }
    let messages = chan[Message](h.buffer)
    let ready = chan[str](1)
    begin_subscription(h, args)?
    spawn pump(h, messages, ready, expected)
    match <-ready {
        some(t) => {
            if t.len > 0 {
                fail Server(t)
            }
        }
        none => fail Closed
    }
    Subscription { messages, handle: h, patterns }
}

fn begin_subscription(h: *ClientHandle, args: []str) ! Error {
    sync.lock(h.gate)
    defer sync.unlock(h.gate)
    usable(h)?
    send(h, encode(args))?
    h.subscribed = true
    h.timeouts.read = 0
}

/// Asks the server to end the subscription.
///
/// Drops every channel, or every pattern for a `psubscribe` subscription, and returns once the request is sent. Messages already in flight may still arrive; `s.messages` is closed when the server confirms and the client can then run commands again. Fails with `Closed` when the connection is closed.
pub fn unsubscribe(s: Subscription) ! Error {
    let name = if s.patterns { "PUNSUBSCRIBE" } else { "UNSUBSCRIBE" }
    sync.lock(s.handle.gate)
    defer sync.unlock(s.handle.gate)
    if s.handle.closed {
        fail Closed
    }
    send(s.handle, encode([name]))?
}

fn pump(h: *ClientHandle, out: chan[Message], ready: chan[str], expected: i64) {
    var confirmed = 0
    var signalled = false
    var clean = false
    for {
        let reply = read_reply(h.reader, h.limits) catch {
            _ => break
        }
        match failure_text(reply) {
            some(t) => {
                if !signalled {
                    ready <- t
                    signalled = true
                }
                clean = true
                break
            }
            none => {}
        }
        let items = frame(reply)
        if items.len == 0 {
            continue
        }
        let kind = text_of(items[0]) catch ""
        if kind == "message" || kind == "pmessage" {
            let m = message_of(kind, items) catch {
                _ => break
            }
            select {
                out <- m => {}
                <-h.stop => break
            }
        } else if kind == "subscribe" || kind == "psubscribe" {
            confirmed += 1
            if confirmed == expected && !signalled {
                ready <- ""
                signalled = true
            }
        } else if kind == "unsubscribe" || kind == "punsubscribe" {
            let remaining = integer_at(items, 2) catch { _ => -1 }
            if remaining == 0 {
                clean = true
                break
            }
            if remaining < 0 {
                break
            }
        }
    }
    h.subscribed = false
    h.timeouts.read = h.timeout
    if !clean {
        close_client_on(h)
    }
    if !signalled {
        close(ready)
    }
    close(out)
}

fn frame(r: Reply) -> []Reply {
    match r {
        Array(items) => items
        Push(items) => items
        _ => []
    }
}

fn integer_at(items: []Reply, at: i64) -> i64 ! Error {
    if items.len <= at {
        fail Protocol
    }
    integer(items[at])?
}

fn message_of(kind: str, items: []Reply) -> Message ! Error {
    if kind == "message" {
        if items.len != 3 {
            fail Protocol
        }
        let channel = text_of(items[1])?
        let payload = text_of(items[2])?
        return Message { pattern: "", channel, payload }
    }
    if items.len != 4 {
        fail Protocol
    }
    let pattern = text_of(items[1])?
    let channel = text_of(items[2])?
    let payload = text_of(items[3])?
    Message { pattern, channel, payload }
}
