    zrange_scores_on(c.handle, key, start, stop)
}

pub fn zrange_scores_on(h: *ClientHandle, key: str, start: i64, stop: i64) -> []Scored ! Error {
    let reply = call(h, ["ZRANGE", key, "{start}", "{stop}", "WITHSCORES"])?
    scored_of(reply)
}

pub fn publish(c: Client, channel: str, message: str) -> i64 ! Error {
    publish_on(c.handle, channel, message)
}

pub fn publish_on(h: *ClientHandle, channel: str, message: str) -> i64 ! Error {
    let reply = call(h, ["PUBLISH", channel, message])?
    integer(reply)
}

pub fn subscribe(c: Client, channels: []str) -> Subscription ! Error {
    subscribe_on(c.handle, channels)
}

pub fn subscribe_on(h: *ClientHandle, channels: []str) -> Subscription ! Error {
    start_subscription(h, with(["SUBSCRIBE"], channels), channels.len, false)
}

pub fn psubscribe(c: Client, patterns: []str) -> Subscription ! Error {
    psubscribe_on(c.handle, patterns)
}

pub fn psubscribe_on(h: *ClientHandle, patterns: []str) -> Subscription ! Error {
    start_subscription(h, with(["PSUBSCRIBE"], patterns), patterns.len, true)
}

fn start_subscription(h: *ClientHandle, args: []str, expected: i64, patterns: bool) -> Subscription ! Error {
    if expected == 0 {
        fail Protocol
    }
    let messages = chan[Message](h.buffer)
    let ready = chan[str](1)
    begin_subscription(h, args)?
    spawn pump(h, messages, ready, expected)
    match <-ready {
        some(t) => {
            if t.len > 0 {
                fail Server(t)
            }
        }
        none => fail Closed
    }
    Subscription { messages, handle: h, patterns }
}

fn begin_subscription(h: *ClientHandle, args: []str) ! Error {
    sync.lock(h.gate)
    defer sync.unlock(h.gate)
    usable(h)?
    send(h, encode(args))?
    h.subscribed = true
    h.timeouts.read = 0
}

pub fn unsubscribe(s: Subscription) ! Error {
    let name = if s.patterns { "PUNSUBSCRIBE" } else { "UNSUBSCRIBE" }
    sync.lock(s.handle.gate)
    defer sync.unlock(s.handle.gate)
    if s.handle.closed {
        fail Closed
    }
    send(s.handle, encode([name]))?
}

fn pump(h: *ClientHandle, out: chan[Message], ready: chan[str], expected: i64) {
    var confirmed = 0
    var signalled = false
    var clean = false
    for {
        let reply = read_reply(h.reader, h.limits) catch {
            _ => break
        }
        match failure_text(reply) {
            some(t) => {
                if !signalled {
                    ready <- t
                    signalled = true
                }
                clean = true
                break
            }
            none => {}
        }
        let items = frame(reply)
        if items.len == 0 {
            continue
        }
        let kind = text_of(items[0]) catch ""
        if kind == "message" || kind == "pmessage" {
            let m = message_of(kind, items) catch {
                _ => break
            }
            select {
                out <- m => {}
                <-h.stop => break
            }
        } else if kind == "subscribe" || kind == "psubscribe" {
            confirmed += 1
            if confirmed == expected && !signalled {
                ready <- ""
                signalled = true
            }
        } else if kind == "unsubscribe" || kind == "punsubscribe" {
            let remaining = integer_at(items, 2) catch { _ => -1 }
            if remaining == 0 {
                clean = true
                break
            }
            if remaining < 0 {
                break
            }
        }
    }
    h.subscribed = false
    h.timeouts.read = h.timeout
    if !clean {
        close_client_on(h)
    }
    if !signalled {
        close(ready)
    }
    close(out)
}

fn frame(r: Reply) -> []Reply {
    match r {
        Array(items) => items
        Push(items) => items
        _ => []
    }
}

fn integer_at(items: []Reply, at: i64) -> i64 ! Error {
    if items.len <= at {
        fail Protocol
    }
    integer(items[at])?
}

fn message_of(kind: str, items: []Reply) -> Message ! Error {
    if kind == "message" {
        if items.len != 3 {
            fail Protocol
        }
        let channel = text_of(items[1])?
        let payload = text_of(items[2])?
        return Message { pattern: "", channel, payload }
    }
    if items.len != 4 {
        fail Protocol
    }
    let pattern = text_of(items[1])?
    let channel = text_of(items[2])?
    let payload = text_of(items[3])?
    Message { pattern, channel, payload }
}
