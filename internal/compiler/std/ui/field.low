import strings = std/text
import std/ui/geometry
import std/ui/platform
import std/ui/scene
import std/unicode
import uitext = std/ui/text

/// What a text field holds: its text, its selection and the input method's composition.
pub struct FieldValue {
    /// The text, one line.
    pub text: str = ""
    /// The selected bytes of `text`; an empty range is the caret.
    pub selection: platform.TextRange = platform.TextRange { start: 0, end: 0 }
    /// Whether the caret is at the selection's start, as after selecting leftward.
    pub reversed: bool = false
    /// The bytes of `text` the input method is composing, or `none`.
    pub marked: platform.TextRange? = none
}

struct FieldState {
    value: Signal[FieldValue]
    origin: geometry.Point = geometry.Point {}
    format: uitext.Format = uitext.Format {}
    selecting: bool = false
    blinking: bool = false
    blink_text: str = ""
    blink_at: i64 = 0
    blink_since: i64 = 0
    blink_wake: i64 = 0
}

/// The state of a single-line text field that `field` draws. Copies share the state.
pub struct TextField {
    state: *FieldState
}

/// Returns a text field owned by `cx` holding `text` with the caret at its end.
pub fn text_field(cx: Context, text: str) -> TextField {
    let line = one_line(text)
    let value = signal(cx, FieldValue { text: line, selection: platform.TextRange { start: line.len, end: line.len } })
    TextField { state: new(FieldState { value }) }
}

/// Returns what `f` holds.
pub fn field_value(f: TextField) -> FieldValue {
    f.state.value.get()
}

/// Makes `f` hold `text` with the caret at its end and no composition.
pub fn set_field_text(f: TextField, text: str) {
    let line = one_line(text)
    f.state.value.set(FieldValue { text: line, selection: platform.TextRange { start: line.len, end: line.len } })
}

/// Binds the keys a text field's actions take by default in the key context `TextField`: Backspace, Delete, Left, Right, Home and End, with Shift extending the selection and Ctrl acting on words, and Ctrl with A, C, X and V for select all, copy, cut and paste.
pub fn bind_field_keys(cx: Context) ! BindError {
    bind(cx, "backspace", "field.backspace", "TextField")?
    bind(cx, "delete", "field.delete", "TextField")?
    bind(cx, "left", "field.left", "TextField")?
    bind(cx, "right", "field.right", "TextField")?
    bind(cx, "shift-left", "field.select_left", "TextField")?
    bind(cx, "shift-right", "field.select_right", "TextField")?
    bind(cx, "home", "field.home", "TextField")?
    bind(cx, "end", "field.end", "TextField")?
    bind(cx, "shift-home", "field.select_home", "TextField")?
    bind(cx, "shift-end", "field.select_end", "TextField")?
    bind(cx, "ctrl-left", "field.word_left", "TextField")?
    bind(cx, "ctrl-right", "field.word_right", "TextField")?
    bind(cx, "ctrl-shift-left", "field.select_word_left", "TextField")?
    bind(cx, "ctrl-shift-right", "field.select_word_right", "TextField")?
    bind(cx, "ctrl-backspace", "field.backspace_word", "TextField")?
    bind(cx, "ctrl-delete", "field.delete_word", "TextField")?
    bind(cx, "ctrl-a", "field.select_all", "TextField")?
    bind(cx, "ctrl-c", "field.copy", "TextField")?
    bind(cx, "ctrl-x", "field.cut", "TextField")?
    bind(cx, "ctrl-v", "field.paste", "TextField")?
}

/// Returns the element that edits `f`, with the id `name`, with text `size` logical pixels high in the font it inherits.
///
/// It takes focus when pressed, selects a word on a double click and the whole text on a triple click, takes typed text and compositions through `on_input`, draws the selection, the composition underlined and, while focused, the caret, which blinks every 500 milliseconds once 500 milliseconds pass without the text or the caret changing, and selects with the pointer. Its actions, in the key context `TextField`, are `field.backspace`, `field.delete`, `field.left`, `field.right`, `field.select_left`, `field.select_right`, `field.home`, `field.end`, `field.select_home`, `field.select_end`, `field.word_left`, `field.word_right`, `field.select_word_left`, `field.select_word_right`, `field.backspace_word`, `field.delete_word`, `field.select_all`, `field.copy`, `field.cut` and `field.paste`; `bind_field_keys` binds their usual keys.
pub fn field(cx: Context, f: TextField, name: str, size: f32) -> Element {
    let st = f.state
    let v = st.value.get()
    let focused = cx.focused() == name
    let handler = InputHandler {
        insert: fn(s: str) f.edit(fn(w) w.inserted(one_line(s)))
        compose: fn(s: str, selected: platform.TextRange?) f.edit(fn(w) w.composed(one_line(s), selected))
        caret: fn(b: geometry.Rect) -> geometry.Rect { f.caret_rect(cx) }
    }
    div()
        .id(name)
        .key_context("TextField")
        .cursor(Text)
        .overflow_hidden()
        .text_size(size)
        .single_line()
        .on_input(handler)
        .on_action("field.backspace", fn() f.edit(fn(w) w.erased(false)))
        .on_action("field.delete", fn() f.edit(fn(w) w.erased(true)))
        .on_action("field.left", fn() f.edit(fn(w) w.stepped(false)))
        .on_action("field.right", fn() f.edit(fn(w) w.stepped(true)))
        .on_action("field.select_left", fn() f.edit(fn(w) w.selected_to(w.previous(w.caret()))))
        .on_action("field.select_right", fn() f.edit(fn(w) w.selected_to(w.following(w.caret()))))
        .on_action("field.home", fn() f.edit(fn(w) w.moved_to(0)))
        .on_action("field.end", fn() f.edit(fn(w) w.moved_to(w.text.len)))
        .on_action("field.select_home", fn() f.edit(fn(w) w.selected_to(0)))
        .on_action("field.select_end", fn() f.edit(fn(w) w.selected_to(w.text.len)))
        .on_action("field.word_left", fn() f.edit(fn(w) w.moved_to(w.word_before(w.caret()))))
        .on_action("field.word_right", fn() f.edit(fn(w) w.moved_to(w.word_after(w.caret()))))
        .on_action("field.select_word_left", fn() f.edit(fn(w) w.selected_to(w.word_before(w.caret()))))
        .on_action("field.select_word_right", fn() f.edit(fn(w) w.selected_to(w.word_after(w.caret()))))
        .on_action("field.backspace_word", fn() f.edit(fn(w) w.erased_word(false)))
        .on_action("field.delete_word", fn() f.edit(fn(w) w.erased_word(true)))
        .on_action("field.select_all", fn() f.edit(fn(w) FieldValue { text: w.text, selection: platform.TextRange { start: 0, end: w.text.len } }))
        .on_action("field.copy", fn() f.copy(cx))
        .on_action("field.cut", fn() {
            f.copy(cx)
            f.edit(fn(w) w.inserted(""))
        })
        .on_action("field.paste", fn() f.paste(cx))
        .on_mouse_down(Left, fn(e) {
            cx.set_focus(name)
            let at = f.index_at(cx, e.position.x)
            st.selecting = e.click_count == 1
            if e.click_count >= 3 {
                f.edit(fn(w) FieldValue { text: w.text, selection: platform.TextRange { start: 0, end: w.text.len } })
            } else if e.click_count == 2 {
                f.edit(fn(w) w.word_at(at))
            } else if e.modifiers.shift {
                f.edit(fn(w) w.selected_to(at))
            } else {
                f.edit(fn(w) w.moved_to(at))
            }
        })
        .on_mouse_move(fn(e) {
            if st.selecting && e.pressed == some(platform.Button.Left) {
                let at = f.index_at(cx, e.position.x)
                f.edit(fn(w) w.selected_to(at))
            }
        })
        .on_mouse_up(Left, fn(e) {
            st.selecting = false
        })
        .children() {
            div().relative().children() {
                text(v.text).highlights(v.looks())
                canvas(fn(mut p: Painter) {
                    st.origin = geometry.point(p.bounds.x, p.bounds.y)
                    st.format = p.format
                    if focused && v.selection.start == v.selection.end {
                        if f.caret_shown(cx, v) {
                            p.paint_quad(scene.Quad { bounds: f.caret_rect(cx), background: geometry.rgb(0x000000) })
                        }
                    } else {
                        st.blinking = false
                    }
                }).absolute().inset(0.0)
            }
        }
}

fn caret_shown(f: TextField, cx: Context, v: FieldValue) -> bool {
    let st = f.state
    let now = cx.state.clock()
    if !st.blinking || st.blink_text != v.text || st.blink_at != v.selection.end {
        st.blinking = true
        st.blink_text = v.text
        st.blink_at = v.selection.end
        st.blink_since = now
    }
    let half = blink_ms() * 1000000
    let phase = (now - st.blink_since) / half
    let next = st.blink_since + (phase + 1) * half
    if st.blink_wake != next {
        st.blink_wake = next
        after(cx, (next - now + 999999) / 1000000, fn() {})
    }
    phase % 2 == 0
}

fn edit(f: TextField, change: fn(FieldValue) -> FieldValue) {
    let before = f.state.value.get()
    f.state.value.set(change(before))
}

fn copy(f: TextField, cx: Context) {
    let v = f.state.value.get()
    if v.selection.start == v.selection.end {
        return
    }
    cx.write_to_clipboard(v.text[v.selection.start..v.selection.end]) or {}
}

fn paste(f: TextField, cx: Context) {
    let pasted = cx.read_from_clipboard() or none
    match pasted {
        some(s) => f.edit(fn(w) w.inserted(one_line(s)))
        none => {}
    }
}

fn shaped(f: TextField, cx: Context) -> uitext.Layout {
    shape_text(cx, f.state.value.get().text, f.state.format, unbounded())
}

fn caret_rect(f: TextField, cx: Context) -> geometry.Rect {
    let l = f.shaped(cx)
    let v = f.state.value.get()
    let x = x_of(l, v.text, v.caret())
    geometry.rect(f.state.origin.x + x, f.state.origin.y, caret_width(), l.height)
}

fn index_at(f: TextField, cx: Context, x: f32) -> i64 {
    let l = f.shaped(cx)
    let along = x - f.state.origin.x
    if l.lines.len == 0 {
        return 0
    }
    let text = f.state.value.get().text
    let glyphs = l.lines[0].glyphs
    var i = 0
    for i < glyphs.len {
        let g = glyphs[i]
        let starts = cluster_starts(text, g.at, g.end)
        let reach = unicode.grapheme_end(text, starts[starts.len - 1])
        var right = g.x + g.advance
        var j = i + 1
        for j < glyphs.len && glyphs[j].at < reach {
            let edge = glyphs[j].x + glyphs[j].advance
            if edge > right {
                right = edge
            }
            j += 1
        }
        let share = (right - g.x) / f32(starts.len)
        for p, start in starts {
            let middle = g.x + share * (f32(p) + 0.5)
            if along < middle {
                return start
            }
        }
        i = j
    }
    text.len
}

fn cluster_starts(text: str, from: i64, to: i64) -> []i64 {
    var starts: []i64 = [from]
    var next = unicode.grapheme_end(text, from)
    for next < to {
        starts.push(next)
        let after = unicode.grapheme_end(text, next)
        if after <= next {
            break
        }
        next = after
    }
    starts
}

fn x_of(l: uitext.Layout, text: str, at: i64) -> f32 {
    if l.lines.len == 0 {
        return 0.0
    }
    var end: f32 = 0.0
    for g in l.lines[0].glyphs {
        if g.at >= at {
            return g.x
        }
        if at < g.end {
            let starts = cluster_starts(text, g.at, g.end)
            var before = 0
            for start in starts {
                if start < at {
                    before += 1
                }
            }
            return g.x + g.advance * f32(before) / f32(starts.len)
        }
        if g.x + g.advance > end {
            end = g.x + g.advance
        }
    }
    end
}

fn unbounded() -> f32 {
    1000000000.0
}

fn blink_ms() -> i64 {
    500
}

fn caret_width() -> f32 {
    1.5
}

fn selection_color() -> geometry.Color {
    geometry.rgba(0x3390ff40)
}

fn single_line(e: Element) -> Element {
    var out = e
    out.visual.wrap = false
    out.visual.max_lines = 0
    out.visual.ellipsis = ""
    out
}

fn one_line(s: str) -> str {
    var out: []u8 = []
    for at, c in s {
        if c == '\n' && at > 0 && s[at - 1] == '\r' {
            continue
        }
        let kept = if uitext.is_newline(c) { ' ' } else { c }
        strings.append_char(mut out, kept)
    }
    str(out)
}

fn looks(v: FieldValue) -> []uitext.Highlight {
    var out: []uitext.Highlight = []
    if v.selection.start != v.selection.end {
        out.push(uitext.Highlight { start: v.selection.start, end: v.selection.end, background: selection_color() })
    }
    match v.marked {
        some(m) => out.push(uitext.Highlight { start: m.start, end: m.end, underline: uitext.Decoration {} })
        none => {}
    }
    out
}

fn caret(v: FieldValue) -> i64 {
    if v.reversed { v.selection.start } else { v.selection.end }
}

fn previous(v: FieldValue, at: i64) -> i64 {
    var start = 0
    for start < v.text.len {
        let end = unicode.grapheme_end(v.text, start)
        if end >= at {
            return start
        }
        start = end
    }
    start
}

fn following(v: FieldValue, at: i64) -> i64 {
    if at >= v.text.len {
        return v.text.len
    }
    unicode.grapheme_end(v.text, at)
}

fn word_before(v: FieldValue, at: i64) -> i64 {
    var start = 0
    var found = 0
    for start < at {
        let end = unicode.word_end(v.text, start)
        if !is_blank(v.text[start..end]) {
            found = start
        }
        start = end
    }
    found
}

fn word_after(v: FieldValue, at: i64) -> i64 {
    var start = 0
    for start < v.text.len {
        let end = unicode.word_end(v.text, start)
        if end > at && !is_blank(v.text[start..end]) {
            return end
        }
        start = end
    }
    v.text.len
}

fn word_at(v: FieldValue, at: i64) -> FieldValue {
    var start = 0
    for start < v.text.len {
        let end = unicode.word_end(v.text, start)
        if end > at {
            return FieldValue { text: v.text, selection: platform.TextRange { start, end } }
        }
        start = end
    }
    v.moved_to(v.text.len)
}

fn is_blank(segment: str) -> bool {
    strings.trim(segment) == ""
}

fn erased_word(v: FieldValue, forward: bool) -> FieldValue {
    if v.selection.start != v.selection.end {
        return v.inserted("")
    }
    let reach = if forward { v.word_after(v.caret()) } else { v.word_before(v.caret()) }
    v.selected_to(reach).inserted("")
}

fn moved_to(v: FieldValue, at: i64) -> FieldValue {
    FieldValue { text: v.text, selection: platform.TextRange { start: at, end: at } }
}

fn selected_to(v: FieldValue, at: i64) -> FieldValue {
    let anchor = if v.reversed { v.selection.end } else { v.selection.start }
    if at < anchor {
        return FieldValue { text: v.text, selection: platform.TextRange { start: at, end: anchor }, reversed: true }
    }
    FieldValue { text: v.text, selection: platform.TextRange { start: anchor, end: at } }
}

fn stepped(v: FieldValue, forward: bool) -> FieldValue {
    if v.selection.start != v.selection.end {
        return v.moved_to(if forward { v.selection.end } else { v.selection.start })
    }
    v.moved_to(if forward { v.following(v.caret()) } else { v.previous(v.caret()) })
}

fn erased(v: FieldValue, forward: bool) -> FieldValue {
    if v.selection.start != v.selection.end {
        return v.inserted("")
    }
    let reach = if forward { v.following(v.caret()) } else { v.previous(v.caret()) }
    v.selected_to(reach).inserted("")
}

fn target(v: FieldValue) -> platform.TextRange {
    v.marked ?? v.selection
}

fn spliced(v: FieldValue, r: platform.TextRange, s: str) -> str {
    "{v.text[..r.start]}{s}{v.text[r.end..]}"
}

fn inserted(v: FieldValue, s: str) -> FieldValue {
    let r = v.target()
    let at = r.start + s.len
    FieldValue { text: v.spliced(r, s), selection: platform.TextRange { start: at, end: at } }
}

fn composed(v: FieldValue, s: str, selected: platform.TextRange?) -> FieldValue {
    let r = v.target()
    let marked: platform.TextRange? = if s == "" { none } else { some(platform.TextRange { start: r.start, end: r.start + s.len }) }
    let chosen = selected ?? platform.TextRange { start: s.len, end: s.len }
    let selection = platform.TextRange { start: r.start + chosen.start, end: r.start + chosen.end }
    FieldValue { text: v.spliced(r, s), selection, marked }
}
