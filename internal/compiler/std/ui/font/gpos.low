import std/slices

fn feature_tag(name: str) -> i64 {
    be32(name, 0)
}

fn feature_lookups(d: Directory, table_tag: str, tags: []i64, kinds: []i64) -> []i64 {
    let table = find(d, table_tag) ?? return []
    if table.length < 10 {
        return []
    }
    let data = d.data
    let scripts = table.offset + be16(data, table.offset + 4)
    let features = table.offset + be16(data, table.offset + 6)
    let lookups = table.offset + be16(data, table.offset + 8)
    let script = pick_script(data, scripts)
    if script == 0 || be16(data, script) == 0 {
        return []
    }
    let lang = script + be16(data, script)
    var wanted: []i64 = []
    for i in 0..be16(data, lang + 4) {
        collect_feature(data, features, be16(data, lang + 6 + 2 * i), tags, mut wanted)
    }
    var out: []i64 = []
    for index in wanted {
        if index >= be16(data, lookups) {
            continue
        }
        let offset = be16(data, lookups + 2 + 2 * index)
        let at = lookups + offset
        if offset != 0 && slices.contains(kinds, be16(data, at)) {
            out.push(at)
        }
    }
    out
}

fn pick_script(data: str, scripts: i64) -> i64 {
    var default = 0
    var first = 0
    for i in 0..be16(data, scripts) {
        let record = scripts + 2 + 6 * i
        let at = scripts + be16(data, record + 4)
        if first == 0 {
            first = at
        }
        let tag = be32(data, record)
        if tag == feature_tag("latn") {
            return at
        }
        if tag == feature_tag("DFLT") {
            default = at
        }
    }
    if default != 0 {
        default
    } else {
        first
    }
}

fn collect_feature(data: str, features: i64, index: i64, tags: []i64, mut wanted: []i64) {
    if index >= be16(data, features) {
        return
    }
    let record = features + 2 + 6 * index
    if !slices.contains(tags, be32(data, record)) {
        return
    }
    let feature = features + be16(data, record + 4)
    for j in 0..be16(data, feature + 2) {
        insert_sorted(mut wanted, be16(data, feature + 4 + 2 * j))
    }
}

fn insert_sorted(mut values: []i64, v: i64) {
    var at = 0
    for at < values.len && values[at] < v {
        at += 1
    }
    if at < values.len && values[at] == v {
        return
    }
    values.push(v)
    var i = values.len - 1
    for i > at {
        values[i] = values[i - 1]
        i -= 1
    }
    values[at] = v
}

fn gpos_kern(data: str, lookups: []i64, left: i64, right: i64) -> i64 {
    var total = 0
    for lookup in lookups {
        total += lookup_kern(data, lookup, left, right)
    }
    total
}

fn lookup_kern(data: str, lookup: i64, left: i64, right: i64) -> i64 {
    for i in 0..be16(data, lookup + 4) {
        let s = resolve_subtable(data, lookup, i, 9)
        if s.kind != 2 {
            continue
        }
        match pair_adjustment(data, s.at, left, right) {
            some(v) => return v
            none => {}
        }
    }
    0
}

struct Subtable {
    kind: i64
    at: i64
}

fn resolve_subtable(data: str, lookup: i64, index: i64, extension: i64) -> Subtable {
    let offset = be16(data, lookup + 6 + 2 * index)
    if offset == 0 {
        return Subtable { kind: 0, at: 0 }
    }
    let at = lookup + offset
    let kind = be16(data, lookup)
    if kind != extension {
        return Subtable { kind, at }
    }
    if be16(data, at) != 1 {
        return Subtable { kind: 0, at: 0 }
    }
    Subtable { kind: be16(data, at + 2), at: at + be32(data, at + 4) }
}

/// An offset in font units, x to the right and y up.
pub struct Offset {
    /// The distance to the right.
    pub x: i64
    /// The distance up.
    pub y: i64
}

/// Returns whether `glyph` is a mark: in the `GDEF` glyph class definition as class 3 when the font has one, else covered as a mark by a lookup of the `mark` or `mkmk` feature.
pub fn is_mark(f: Font, glyph: i64) -> bool {
    if f.gdef != 0 {
        let offset = be16(f.data, f.gdef + 4)
        if offset != 0 {
            return class_of(f.data, f.gdef, offset, glyph) == 3
        }
    }
    covers_mark(f, f.mark_lookups, 4, glyph) || covers_mark(f, f.mkmk_lookups, 6, glyph)
}

fn covers_mark(f: Font, lookups: []i64, kind: i64, glyph: i64) -> bool {
    for lookup in lookups {
        for i in 0..be16(f.data, lookup + 4) {
            let s = resolve_subtable(f.data, lookup, i, 9)
            let coverage = be16(f.data, s.at + 2)
            if s.kind == kind && coverage != 0 && coverage_index(f.data, s.at + coverage, glyph) >= 0 {
                return true
            }
        }
    }
    false
}

/// Returns where the origin of the glyph `mark` sits relative to the origin of `base`, in font units, or `none` when the font does not attach it.
///
/// When `base` is a mark, the offset comes from the mark-to-mark lookups of the `mkmk` feature; otherwise it comes from the mark-to-base lookups of the `mark` feature. The features are chosen as `kern` is. A lookup's subtables are tried in order and the first that covers both glyphs decides, with the anchor of `base` for the mark's class minus the mark's own anchor. Anchor formats 1, 2 and 3 are read as their x and y. A malformed offset gives `none`.
pub fn mark_offset(f: Font, base: i64, mark: i64) -> Offset? {
    let on_mark = is_mark(f, base)
    let lookups = if on_mark { f.mkmk_lookups } else { f.mark_lookups }
    let kind = if on_mark { 6 } else { 4 }
    for lookup in lookups {
        for i in 0..be16(f.data, lookup + 4) {
            let s = resolve_subtable(f.data, lookup, i, 9)
            if s.kind != kind {
                continue
            }
            match attachment(f.data, s.at, base, mark) {
                some(v) => return some(v)
                none => {}
            }
        }
    }
    none
}

fn attachment(data: str, subtable: i64, base: i64, mark: i64) -> Offset? {
    if be16(data, subtable) != 1 {
        return none
    }
    let mark_coverage = be16(data, subtable + 2)
    let base_coverage = be16(data, subtable + 4)
    let classes = be16(data, subtable + 6)
    let mark_array = be16(data, subtable + 8)
    let base_array = be16(data, subtable + 10)
    if mark_coverage == 0 || base_coverage == 0 || mark_array == 0 || base_array == 0 {
        return none
    }
    let mark_index = coverage_index(data, subtable + mark_coverage, mark)
    let base_index = coverage_index(data, subtable + base_coverage, base)
    let marks = subtable + mark_array
    let bases = subtable + base_array
    if mark_index < 0 || base_index < 0 || mark_index >= be16(data, marks) || base_index >= be16(data, bases) {
        return none
    }
    let record = marks + 2 + 4 * mark_index
    let class = be16(data, record)
    let mark_anchor = be16(data, record + 2)
    if class >= classes || mark_anchor == 0 {
        return none
    }
    let base_anchor = be16(data, bases + 2 + 2 * (base_index * classes + class))
    if base_anchor == 0 {
        return none
    }
    let from = anchor_at(data, bases + base_anchor) ?? return none
    let to = anchor_at(data, marks + mark_anchor) ?? return none
    some(Offset { x: from.x - to.x, y: from.y - to.y })
}

fn anchor_at(data: str, at: i64) -> Offset? {
    let format = be16(data, at)
    if format < 1 || format > 3 {
        return none
    }
    some(Offset { x: be16_signed(data, at + 2), y: be16_signed(data, at + 4) })
}

fn pair_adjustment(data: str, subtable: i64, left: i64, right: i64) -> i64? {
    let format = be16(data, subtable)
    let coverage = be16(data, subtable + 2)
    if (format != 1 && format != 2) || coverage == 0 {
        return none
    }
    let index = coverage_index(data, subtable + coverage, left)
    if index < 0 {
        return none
    }
    let format1 = be16(data, subtable + 4)
    let size = value_size(format1) + value_size(be16(data, subtable + 6))
    if format == 1 {
        pair_set_adjustment(data, subtable, index, size, format1, right)
    } else {
        class_adjustment(data, subtable, size, format1, left, right)
    }
}

fn pair_set_adjustment(data: str, subtable: i64, index: i64, size: i64, format1: i64, right: i64) -> i64? {
    if index >= be16(data, subtable + 8) {
        return none
    }
    let offset = be16(data, subtable + 10 + 2 * index)
    if offset == 0 {
        return none
    }
    let set = subtable + offset
    let records = set + 2
    let stride = 2 + size
    let count = be16(data, set)
    var lo = 0
    var hi = count
    for lo < hi {
        let mid = (lo + hi) / 2
        if be16(data, records + stride * mid) < right {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    if lo < count && be16(data, records + stride * lo) == right {
        some(x_advance(data, records + stride * lo + 2, format1))
    } else {
        none
    }
}

fn class_adjustment(data: str, subtable: i64, size: i64, format1: i64, left: i64, right: i64) -> i64? {
    let first = class_of(data, subtable, be16(data, subtable + 8), left)
    let second = class_of(data, subtable, be16(data, subtable + 10), right)
    let second_count = be16(data, subtable + 14)
    if first >= be16(data, subtable + 12) || second >= second_count {
        return none
    }
    some(x_advance(data, subtable + 16 + size * (first * second_count + second), format1))
}

fn value_size(format: i64) -> i64 {
    var bits = 0
    for b in 0..8 {
        bits += (format >> b) & 1
    }
    2 * bits
}

fn x_advance(data: str, at: i64, format: i64) -> i64 {
    if format & 4 == 0 {
        return 0
    }
    be16_signed(data, at + 2 * ((format & 1) + ((format >> 1) & 1)))
}

fn coverage_index(data: str, coverage: i64, glyph: i64) -> i64 {
    let count = be16(data, coverage + 2)
    var lo = 0
    var hi = count
    if be16(data, coverage) == 1 {
        for lo < hi {
            let mid = (lo + hi) / 2
            if be16(data, coverage + 4 + 2 * mid) < glyph {
                lo = mid + 1
            } else {
                hi = mid
            }
        }
        if lo < count && be16(data, coverage + 4 + 2 * lo) == glyph {
            return lo
        }
        return -1
    }
    if be16(data, coverage) != 2 {
        return -1
    }
    for lo < hi {
        let mid = (lo + hi) / 2
        if be16(data, coverage + 6 + 6 * mid) < glyph {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    if lo == count {
        return -1
    }
    let record = coverage + 4 + 6 * lo
    let start = be16(data, record)
    if glyph < start {
        return -1
    }
    be16(data, record + 4) + glyph - start
}

fn class_of(data: str, subtable: i64, offset: i64, glyph: i64) -> i64 {
    if offset == 0 {
        return 0
    }
    let class_def = subtable + offset
    let format = be16(data, class_def)
    if format == 1 {
        let start = be16(data, class_def + 2)
        if glyph >= start && glyph - start < be16(data, class_def + 4) {
            return be16(data, class_def + 6 + 2 * (glyph - start))
        }
        return 0
    }
    if format != 2 {
        return 0
    }
    let count = be16(data, class_def + 2)
    var lo = 0
    var hi = count
    for lo < hi {
        let mid = (lo + hi) / 2
        if be16(data, class_def + 4 + 6 * mid + 2) < glyph {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    if lo == count || glyph < be16(data, class_def + 4 + 6 * lo) {
        return 0
    }
    be16(data, class_def + 4 + 6 * lo + 4)
}
