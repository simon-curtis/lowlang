const property_top = 1
const property_sub_top = 2
const property_neutral = 4
const property_x_height = 8
const property_long = 16
const property_capital_bottom = 32
const property_small_bottom = 64

const style_mask = 0x1FFF
const unscaled = 0x10000

struct BlueSample {
    y: i64
    round: bool
}

struct BlueScan {
    ascender: i64 = 0
    descender: i64 = 0
    flats: []i64 = []
    rounds: []i64 = []
}

struct SegmentWalk {
    first: i64
    last: i64
    on_first: i64
    on_last: i64
}

fn sort_positions(mut table: []i64) {
    for i in 1..table.len {
        var j = i
        for j > 0 {
            if table[j] >= table[j - 1] {
                break
            }
            let swap = table[j]
            table[j] = table[j - 1]
            table[j - 1] = swap
            j -= 1
        }
    }
}

fn sort_and_quantize_widths(table: []Width, threshold: i64) -> []Width {
    let count = table.len
    if count == 1 {
        return table
    }
    var sorted = table
    for i in 1..count {
        var j = i
        for j > 0 {
            if sorted[j].org >= sorted[j - 1].org {
                break
            }
            let swap = sorted[j]
            sorted[j] = sorted[j - 1]
            sorted[j - 1] = swap
            j -= 1
        }
    }
    var cur_idx = 0
    var cur_val = 0
    if count > 0 {
        cur_val = sorted[0].org
    }
    var i = 1
    for i < count {
        if sorted[i].org - cur_val > threshold || i == count - 1 {
            var sum = 0
            if sorted[i].org - cur_val <= threshold && i == count - 1 {
                i += 1
            }
            var j = cur_idx
            for j < i {
                sum += sorted[j].org
                sorted[j].org = 0
                j += 1
            }
            sorted[cur_idx].org = sum / j
            if i < count - 1 {
                cur_idx = i + 1
                cur_val = sorted[cur_idx].org
            }
        }
        i += 1
    }
    var kept: []Width = [Width {}]
    if count > 0 {
        kept = [sorted[0]]
    }
    for k in 1..count {
        if sorted[k].org != 0 {
            kept.push(sorted[k])
        }
    }
    kept
}

fn standard_glyph(f: Font, script: i64) -> i64 {
    for cp in script_standard_chars(script) {
        let glyph = glyph_index(f, u32(cp))
        if glyph != 0 {
            return glyph
        }
    }
    0
}

fn init_widths(f: Font, mut m: StyleMetrics) {
    let glyph = standard_glyph(f, m.script)
    if glyph != 0 {
        measure_standard_widths(f, glyph, mut m)
    }
    for dim in 0..2 {
        let known = m.axes[dim].widths.len > 0
        let stdw = if known { m.axes[dim].widths[0].org } else { latin_constant(m.units_per_em, 50) }
        m.axes[dim].edge_distance_threshold = stdw / 5
        m.axes[dim].standard_width = stdw
        m.axes[dim].extra_light = false
    }
}

fn measure_standard_widths(f: Font, glyph: i64, mut m: StyleMetrics) {
    let loaded = load_scaled(f, glyph, unscaled) ?? return
    if loaded.points.len == 0 {
        return
    }
    let probe = StyleMetrics { units_per_em: m.units_per_em, script: m.script }
    var h = new_hints(probe)
    reload(mut h, loaded)
    for dim in 0..2 {
        latin_compute_segments(mut h, dim)
        latin_link_segments(mut h, [], dim)
        var found: []Width = []
        for s in 0..h.axes[dim].segments.len {
            let seg = h.axes[dim].segments[s]
            if seg.link < 0 {
                continue
            }
            let link = h.axes[dim].segments[seg.link]
            if link.link == s && seg.link > s && found.len < max_widths {
                found.push(Width { org: magnitude(seg.pos - link.pos) })
            }
        }
        m.axes[dim].widths = sort_and_quantize_widths(found, m.units_per_em / 100)
    }
}

fn blue_is_top_like(properties: i64) -> bool {
    properties & (property_top | property_sub_top) != 0
}

fn on_curve(outline: ScaledOutline, point: i64) -> bool {
    outline.points[point].on_curve
}

fn scan_blue_char(f: Font, glyph: i64, properties: i64, units_per_em: i64, mut scan: BlueScan) -> BlueSample? {
    let outline = load_scaled(f, glyph, unscaled) ?? return none
    if outline.points.len <= 2 {
        return none
    }
    let points = outline.points
    let top_like = blue_is_top_like(properties)
    var best_point = -1
    var best_contour_first = -1
    var best_contour_last = -1
    var best_y = 0
    var first = 0
    for end in outline.ends {
        let last = end
        if last > first {
            for pp in first..(last + 1) {
                if top_like {
                    if best_point < 0 || points[pp].y > best_y {
                        best_point = pp
                        best_y = points[pp].y
                        scan.ascender = max_of(scan.ascender, best_y)
                    } else {
                        scan.descender = min_of(scan.descender, points[pp].y)
                    }
                } else {
                    if best_point < 0 || points[pp].y < best_y {
                        best_point = pp
                        best_y = points[pp].y
                        scan.descender = min_of(scan.descender, best_y)
                    } else {
                        scan.ascender = max_of(scan.ascender, points[pp].y)
                    }
                }
            }
            if best_point > best_contour_last {
                best_contour_first = first
                best_contour_last = last
            }
        }
        first = end + 1
    }
    var round = false
    if best_point >= 0 {
        let flat_threshold = units_per_em / 14
        let best_x = points[best_point].x
        var walk = SegmentWalk { first: best_point, last: best_point, on_first: -1, on_last: -1 }
        if on_curve(outline, best_point) {
            walk.on_first = best_point
            walk.on_last = best_point
        }
        var prev = best_point
        var next = prev
        for {
            if prev > best_contour_first {
                prev -= 1
            } else {
                prev = best_contour_last
            }
            let dist = magnitude(points[prev].y - best_y)
            if dist > 5 && magnitude(points[prev].x - best_x) <= 20 * dist {
                break
            }
            walk.first = prev
            if on_curve(outline, prev) {
                walk.on_first = prev
                if walk.on_last < 0 {
                    walk.on_last = prev
                }
            }
            if prev == best_point {
                break
            }
        }
        for {
            if next < best_contour_last {
                next += 1
            } else {
                next = best_contour_first
            }
            let dist = magnitude(points[next].y - best_y)
            if dist > 5 && magnitude(points[next].x - best_x) <= 20 * dist {
                break
            }
            walk.last = next
            if on_curve(outline, next) {
                walk.on_last = next
                if walk.on_first < 0 {
                    walk.on_first = next
                }
            }
            if next == best_point {
                break
            }
        }
        if properties & property_long != 0 {
            let refined = refine_long_blue(outline, best_point, best_x, best_y, best_contour_first, best_contour_last, next, walk, units_per_em)
            if !refined.keep {
                return none
            }
            best_y = refined.best_y
            walk = refined.walk
        }
        let both_on = walk.on_first >= 0 && walk.on_last >= 0
        if both_on && magnitude(points[walk.on_last].x - points[walk.on_first].x) > flat_threshold {
            round = false
        } else {
            round = !on_curve(outline, walk.first) || !on_curve(outline, walk.last)
        }
        if round && properties & property_neutral != 0 {
            return none
        }
    }
    BlueSample { y: best_y, round }
}

struct LongBlue {
    keep: bool
    best_y: i64
    walk: SegmentWalk
}

fn refine_long_blue(outline: ScaledOutline, best_point: i64, best_x: i64, best_y: i64, contour_first: i64, contour_last: i64, next: i64, walk: SegmentWalk, units_per_em: i64) -> LongBlue {
    let points = outline.points
    let length_threshold = units_per_em / 25
    let unchanged = LongBlue { keep: true, best_y, walk }
    var dist = magnitude(points[walk.last].x - points[walk.first].x)
    if dist >= length_threshold || walk.last - walk.first + 2 > contour_last - contour_first {
        return unchanged
    }
    let height_threshold = units_per_em / 4
    var prev = best_point
    for {
        if prev > contour_first {
            prev -= 1
        } else {
            prev = contour_last
        }
        if points[prev].x != best_x {
            break
        }
        if prev == best_point {
            break
        }
    }
    if prev == best_point {
        return LongBlue { keep: false, best_y, walk }
    }
    let left_to_right = points[prev].x < points[best_point].x
    var first = walk.last
    var last = first
    var hit = false
    var p_first = 0
    var p_last = 0
    for {
        if !hit {
            first = last
            if on_curve(outline, first) {
                p_first = first
                p_last = first
            } else {
                p_first = -1
                p_last = -1
            }
            hit = true
        }
        if last < contour_last {
            last += 1
        } else {
            last = contour_first
        }
        if magnitude(best_y - points[first].y) > height_threshold {
            hit = false
        } else {
            dist = magnitude(points[last].y - points[first].y)
            if dist > 5 && magnitude(points[last].x - points[first].x) <= 20 * dist {
                hit = false
            } else {
                if on_curve(outline, last) {
                    p_last = last
                    if p_first < 0 {
                        p_first = last
                    }
                }
                let l2r = points[first].x < points[last].x
                let d = magnitude(points[last].x - points[first].x)
                if l2r == left_to_right && d >= length_threshold {
                    for {
                        if last < contour_last {
                            last += 1
                        } else {
                            last = contour_first
                        }
                        let rise = magnitude(points[last].y - points[first].y)
                        if rise > 5 && magnitude(points[next].x - points[first].x) <= 20 * dist {
                            if last > contour_first {
                                last -= 1
                            } else {
                                last = contour_last
                            }
                            break
                        }
                        p_last = last
                        if on_curve(outline, last) {
                            p_last = last
                            if p_first < 0 {
                                p_first = last
                            }
                        }
                        if last == walk.first {
                            break
                        }
                    }
                    let found = SegmentWalk { first, last, on_first: p_first, on_last: p_last }
                    return LongBlue { keep: true, best_y: points[first].y, walk: found }
                }
            }
        }
        if last == walk.first {
            break
        }
    }
    unchanged
}

fn latin_init_blues(f: Font, mut m: StyleMetrics, mut styles: []i64) -> bool {
    let flat_blues = blue_stringset(style_classes()[m.style].blue_stringset)
    var blues: []Blue = []
    for bs in flat_blues {
        var scan = BlueScan {}
        for cp in bs.chars {
            let glyph = glyph_index(f, u32(cp))
            if glyph == 0 {
                continue
            }
            let sample = scan_blue_char(f, glyph, bs.properties, m.units_per_em, mut scan) ?? continue
            if sample.round {
                scan.rounds.push(sample.y)
            } else {
                scan.flats.push(sample.y)
            }
        }
        if scan.flats.len == 0 && scan.rounds.len == 0 {
            continue
        }
        sort_positions(mut scan.rounds)
        sort_positions(mut scan.flats)
        var blue = Blue { ascender: scan.ascender, descender: scan.descender }
        if scan.flats.len == 0 {
            blue.ref.org = scan.rounds[scan.rounds.len / 2]
            blue.shoot.org = blue.ref.org
        } else if scan.rounds.len == 0 {
            blue.ref.org = scan.flats[scan.flats.len / 2]
            blue.shoot.org = blue.ref.org
        } else {
            blue.ref.org = scan.flats[scan.flats.len / 2]
            blue.shoot.org = scan.rounds[scan.rounds.len / 2]
        }
        if blue.shoot.org != blue.ref.org {
            let over_ref = blue.shoot.org > blue.ref.org
            if blue_is_top_like(bs.properties) != over_ref {
                let mean = (blue.shoot.org + blue.ref.org) / 2
                blue.ref.org = mean
                blue.shoot.org = mean
            }
        }
        blue.flags = blue_flags(bs.properties)
        blues.push(blue)
    }
    m.axes[vertical].blues = blues
    if blues.len == 0 {
        for i in 0..styles.len {
            if styles[i] & style_mask == m.style {
                styles[i] = style_none_dflt
            }
        }
        return true
    }
    resolve_blue_overlaps(mut m.axes[vertical].blues)
    false
}

fn blue_flags(properties: i64) -> i64 {
    var flags = 0
    if properties & property_top != 0 {
        flags |= blue_top
    }
    if properties & property_sub_top != 0 {
        flags |= blue_sub_top
    }
    if properties & property_neutral != 0 {
        flags |= blue_neutral
    }
    if properties & property_capital_bottom != 0 {
        flags |= blue_bottom
    }
    if properties & property_small_bottom != 0 {
        flags |= blue_bottom_small
    }
    if properties & property_x_height != 0 {
        flags |= blue_adjustment
    }
    flags
}

fn blue_sort_key(b: Blue) -> i64 {
    if b.flags & (blue_top | blue_sub_top) != 0 { b.ref.org } else { b.shoot.org }
}

fn sorted_blue_order(blues: []Blue) -> []i64 {
    var order: []i64 = []
    for i in 0..blues.len {
        order.push(i)
    }
    for i in 1..order.len {
        var j = i
        for j > 0 {
            let a = blue_sort_key(blues[order[j - 1]])
            let b = blue_sort_key(blues[order[j]])
            if b >= a {
                break
            }
            let swap = order[j]
            order[j] = order[j - 1]
            order[j - 1] = swap
            j -= 1
        }
    }
    order
}

fn resolve_blue_overlaps(mut blues: []Blue) {
    let order = sorted_blue_order(blues)
    for i in 0..(order.len - 1) {
        let lower = order[i]
        let upper = order[i + 1]
        let lower_top = blues[lower].flags & (blue_top | blue_sub_top) != 0
        let upper_top = blues[upper].flags & (blue_top | blue_sub_top) != 0
        let a = if lower_top { blues[lower].shoot.org } else { blues[lower].ref.org }
        let b = if upper_top { blues[upper].shoot.org } else { blues[upper].ref.org }
        if a > b {
            if lower_top {
                blues[lower].shoot.org = b
            } else {
                blues[lower].ref.org = b
            }
        }
    }
}

fn latin_metrics_init(f: Font, style: i64, mut styles: []i64) -> StyleMetrics? {
    let class = style_classes()[style]
    var m = StyleMetrics { writing_system: class.writing_system, script: class.script, style, units_per_em: f.units_per_em }
    m.axes = [Axis {}, Axis {}]
    init_widths(f, mut m)
    if latin_init_blues(f, mut m, mut styles) {
        return none
    }
    m
}

fn latin_scale_dim(mut m: StyleMetrics, scaler: Scaler, dim: i64) {
    var scale = if dim == horizontal { scaler.x_scale } else { scaler.y_scale }
    let delta = if dim == horizontal { scaler.x_delta } else { scaler.y_delta }
    if m.axes[dim].org_scale == scale && m.axes[dim].org_delta == delta {
        return
    }
    m.axes[dim].org_scale = scale
    m.axes[dim].org_delta = delta
    if dim == vertical {
        scale = fit_x_height(m, scale)
    }
    m.axes[dim].scale = scale
    m.axes[dim].delta = delta
    if dim == horizontal {
        m.scaler.x_scale = scale
        m.scaler.x_delta = delta
    } else {
        m.scaler.y_scale = scale
        m.scaler.y_delta = delta
    }
    for n in 0..m.axes[dim].widths.len {
        let cur = mul_fix(m.axes[dim].widths[n].org, scale)
        m.axes[dim].widths[n].cur = cur
        m.axes[dim].widths[n].fit = cur
    }
    m.axes[dim].extra_light = mul_fix(m.axes[dim].standard_width, scale) < 32 + 8
    if dim == vertical {
        scale_blues(mut m, scale, delta)
    }
}

fn fit_x_height(m: StyleMetrics, scale: i64) -> i64 {
    var adjusted = -1
    for n in 0..m.axes[vertical].blues.len {
        if m.axes[vertical].blues[n].flags & blue_adjustment != 0 {
            adjusted = n
            break
        }
    }
    if adjusted < 0 {
        return scale
    }
    let scaled = mul_fix(m.axes[vertical].blues[adjusted].shoot.org, scale)
    let fitted = (scaled + 40) & ~63
    if scaled == fitted {
        return scale
    }
    let new_scale = mul_div(scale, fitted, scaled)
    var max_height = m.units_per_em
    for n in 0..m.axes[vertical].blues.len {
        max_height = max_of(max_height, m.axes[vertical].blues[n].ascender)
        max_height = max_of(max_height, -m.axes[vertical].blues[n].descender)
    }
    let dist = mul_fix(max_height, new_scale - scale)
    if -128 < dist && dist < 128 {
        return new_scale
    }
    scale
}

fn scale_blues(mut m: StyleMetrics, scale: i64, delta: i64) {
    let count = m.axes[vertical].blues.len
    for n in 0..count {
        let ref_org = m.axes[vertical].blues[n].ref.org
        let shoot_org = m.axes[vertical].blues[n].shoot.org
        let ref_cur = mul_fix(ref_org, scale) + delta
        let shoot_cur = mul_fix(shoot_org, scale) + delta
        m.axes[vertical].blues[n].ref.cur = ref_cur
        m.axes[vertical].blues[n].ref.fit = ref_cur
        m.axes[vertical].blues[n].shoot.cur = shoot_cur
        m.axes[vertical].blues[n].shoot.fit = shoot_cur
        m.axes[vertical].blues[n].flags &= ~blue_active
        let dist = mul_fix(ref_org - shoot_org, scale)
        if dist <= 48 && dist >= -48 {
            var delta2 = magnitude(dist)
            if delta2 < 32 {
                delta2 = 0
            } else if delta2 < 48 {
                delta2 = 32
            } else {
                delta2 = 64
            }
            if dist < 0 {
                delta2 = -delta2
            }
            let fitted_ref = pix_round(ref_cur)
            m.axes[vertical].blues[n].ref.fit = fitted_ref
            m.axes[vertical].blues[n].shoot.fit = fitted_ref - delta2
            m.axes[vertical].blues[n].flags |= blue_active
        }
    }
    for n in 0..count {
        let blue = m.axes[vertical].blues[n]
        if blue.flags & blue_sub_top == 0 || blue.flags & blue_active == 0 {
            continue
        }
        for i in 0..count {
            let other = m.axes[vertical].blues[i]
            if other.flags & blue_sub_top != 0 || other.flags & blue_active == 0 {
                continue
            }
            if other.ref.fit <= blue.shoot.fit && other.shoot.fit >= blue.ref.fit {
                m.axes[vertical].blues[n].flags &= ~blue_active
                break
            }
        }
    }
}

fn latin_metrics_scale(mut m: StyleMetrics, scaler: Scaler) {
    m.scaler.flags = scaler.flags
    latin_scale_dim(mut m, scaler, horizontal)
    latin_scale_dim(mut m, scaler, vertical)
}
