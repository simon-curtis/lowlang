struct ScaledPoint {
    x: i64
    y: i64
    on_curve: bool
}

struct ScaledOutline {
    points: []ScaledPoint
    ends: []i64
    overlap: bool
}

struct Request {
    scale: i64
    ppem: i64
}

const max_ppem = 65535
const one_pixel = 64

fn request_size(f: Font, size: i64) -> Request? {
    let ppem = (size + 32) >> 6
    if ppem > max_ppem {
        return none
    }
    let scale = div_fix(size, f.units_per_em)
    Request { scale, ppem }
}

fn scaled_outline(f: Font, glyph: i64, scale: i64) -> ScaledOutline? {
    if f.cff.charstrings.count > 0 {
        return scaled_cff(f, glyph, scale)
    }
    load_scaled(f, glyph, scale)
}

fn scaled_cff(f: Font, glyph: i64, scale: i64) -> ScaledOutline {
    let shape = outline(f, glyph)
    var points: []ScaledPoint = []
    var ends: []i64 = []
    for c in shape.contours {
        for p in c.points {
            let x = scaled_units(p.x, scale)
            let y = scaled_units(p.y, scale)
            points.push(ScaledPoint { x, y, on_curve: p.on_curve })
        }
        ends.push(points.len - 1)
    }
    ScaledOutline { points, ends, overlap: false }
}

fn scaled_units(units: f32, scale: i64) -> i64 {
    let sixty_fourths = i64(floor(units * 64.0 + 0.5))
    (mul_fix(sixty_fourths, scale) + 32) >> 6
}

fn inflated(shape: ScaledOutline, factor: i64) -> ScaledOutline {
    var points: []ScaledPoint = []
    for p in shape.points {
        points.push(ScaledPoint { x: p.x * factor, y: p.y * factor, on_curve: p.on_curve })
    }
    ScaledOutline { points, ends: shape.ends, overlap: shape.overlap }
}
