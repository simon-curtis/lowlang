fn min_of(a: i64, b: i64) -> i64 {
    if a < b { a } else { b }
}

fn max_of(a: i64, b: i64) -> i64 {
    if a > b { a } else { b }
}

fn magnitude(v: i64) -> i64 {
    if v < 0 { -v } else { v }
}

fn mul_fix(a: i64, b: i64) -> i64 {
    let product = a * b
    (product + 0x8000 + (product >> 63)) >> 16
}

fn div_fix(a: i64, b: i64) -> i64 {
    let dividend = magnitude(a)
    let divisor = magnitude(b)
    let quotient = if divisor > 0 { ((dividend << 16) + (divisor >> 1)) / divisor } else { 0x7FFFFFFF }
    if (a < 0) != (b < 0) { -quotient } else { quotient }
}

fn mul_div(a: i64, b: i64, c: i64) -> i64 {
    let divisor = magnitude(c)
    let quotient = if divisor > 0 { (magnitude(a) * magnitude(b) + (divisor >> 1)) / divisor } else { 0x7FFFFFFF }
    let negatives = (if a < 0 { 1 } else { 0 }) + (if b < 0 { 1 } else { 0 }) + (if c < 0 { 1 } else { 0 })
    if negatives % 2 == 1 { -quotient } else { quotient }
}

fn pix_floor(v: i64) -> i64 {
    v & ~63
}

fn pix_round(v: i64) -> i64 {
    (v + 32) & ~63
}

fn pix_ceil(v: i64) -> i64 {
    (v + 63) & ~63
}

fn truncate_short(v: i64) -> i64 {
    ((v & 0xFFFF) ^ 0x8000) - 0x8000
}

fn hypot_estimate(x: i64, y: i64) -> i64 {
    let ax = magnitude(x)
    let ay = magnitude(y)
    if ax > ay { ax + ((3 * ay) >> 3) } else { ay + ((3 * ax) >> 3) }
}

fn corner_is_flat(in_x: i64, in_y: i64, out_x: i64, out_y: i64) -> bool {
    let d_in = hypot_estimate(in_x, in_y)
    let d_out = hypot_estimate(out_x, out_y)
    let d_hypot = hypot_estimate(in_x + out_x, in_y + out_y)
    d_in + d_out - d_hypot < (d_hypot >> 4)
}

fn highest_bit(v: i64) -> i64 {
    var bit = 0
    var rest = v >> 1
    for rest > 0 {
        bit += 1
        rest = rest >> 1
    }
    bit
}

const cordic_safe_bit = 29
const cordic_gain = 0xDBD95B16
const cordic_rounds = 23

fn vector_length(x: i64, y: i64) -> i64 {
    if x == 0 {
        return magnitude(y)
    }
    if y == 0 {
        return magnitude(x)
    }
    var vx = x
    var vy = y
    var shift = highest_bit(magnitude(x) | magnitude(y))
    if shift <= cordic_safe_bit {
        shift = cordic_safe_bit - shift
        vx = vx << shift
        vy = vy << shift
    } else {
        shift -= cordic_safe_bit
        vx = vx >> shift
        vy = vy >> shift
        shift = -shift
    }
    if vy > vx {
        if vy > -vx {
            let rotated = vy
            vy = -vx
            vx = rotated
        } else {
            vx = -vx
            vy = -vy
        }
    } else if vy < -vx {
        let rotated = -vy
        vy = vx
        vx = rotated
    }
    for i in 1..cordic_rounds {
        let bias = 1 << (i - 1)
        let rotated = if vy > 0 { vx + ((vy + bias) >> i) } else { vx - ((vy + bias) >> i) }
        vy = if vy > 0 { vy - ((vx + bias) >> i) } else { vy + ((vx + bias) >> i) }
        vx = rotated
    }
    let negative = vx < 0
    let unsigned_x = u64(magnitude(vx))
    let gained = i64((unsigned_x * u64(cordic_gain) + 0x40000000) >> 32)
    let length = if negative { -gained } else { gained }
    if shift > 0 {
        (length + (1 << (shift - 1))) >> shift
    } else {
        length << -shift
    }
}
