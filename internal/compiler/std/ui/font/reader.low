fn byte(d: str, at: i64) -> i64 {
    if at >= 0 && at < d.len {
        i64(d[at])
    } else {
        0
    }
}

fn be16(d: str, at: i64) -> i64 {
    byte(d, at) << 8 | byte(d, at + 1)
}

fn be16_signed(d: str, at: i64) -> i64 {
    let v = be16(d, at)
    if v >= 32768 {
        v - 65536
    } else {
        v
    }
}

fn be32(d: str, at: i64) -> i64 {
    be16(d, at) << 16 | be16(d, at + 2)
}

fn be32_signed(d: str, at: i64) -> i64 {
    let v = be32(d, at)
    if v >= 2147483648 {
        v - 4294967296
    } else {
        v
    }
}

fn byte_signed(d: str, at: i64) -> i64 {
    let v = byte(d, at)
    if v >= 128 {
        v - 256
    } else {
        v
    }
}

fn fixed_2_14(d: str, at: i64) -> f32 {
    f32(be16_signed(d, at)) / 16384.0
}
