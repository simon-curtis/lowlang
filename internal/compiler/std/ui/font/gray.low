struct Gray {
    width: i64
    min_y: i64
    max_y: i64
    cover: []i32
    area: []i32
    x: i64
    y: i64
    at: i64
}

struct Vec {
    x: i64
    y: i64
}

struct Entry {
    fx: i64
    fy: i64
}

struct Run {
    at: i64
    closed: bool
}

const subpixel = 256
const subpixel_mask = 255
const upscale = 4
const flat_enough = 64
const band_cells = 1048576
const overlap_factor = 4
const reciprocal_one = 0xFFFFFFFF

fn render_coverage(shape: ScaledOutline, width: i64, height: i64, even_odd: bool) -> []u8 {
    let factor = if shape.overlap { overlap_factor } else { 1 }
    let grid = if shape.overlap { inflated(shape, factor) } else { shape }
    let grid_width = width * factor
    let grid_height = height * factor
    let rows_per_band = max_of(1, band_cells / (grid_width + 1))
    var out: []u8 = __make(width * height)
    var line: []u8 = __make(grid_width)
    var min_y = 0
    for min_y < grid_height {
        let max_y = min_of(min_y + rows_per_band, grid_height)
        var g = band(grid_width, min_y, max_y)
        trace(mut g, grid)
        for y in min_y..max_y {
            sweep_row(g, y, even_odd, mut line)
            if factor == 1 {
                copy_row(mut out, line, y, width, height)
            } else {
                add_row(mut out, line, y, width, height, factor)
            }
        }
        min_y = max_y
    }
    out
}

fn band(width: i64, min_y: i64, max_y: i64) -> Gray {
    let cells = (max_y - min_y) * (width + 1)
    var cover: []i32 = __make(cells)
    var area: []i32 = __make(cells)
    Gray { width, min_y, max_y, cover, area, x: 0, y: 0, at: -1 }
}

fn copy_row(mut out: []u8, line: []u8, y: i64, width: i64, height: i64) {
    let base = (height - 1 - y) * width
    for x in 0..width {
        out[base + x] = line[x]
    }
}

fn add_row(mut out: []u8, line: []u8, y: i64, width: i64, height: i64, factor: i64) {
    let base = (height - 1 - y / factor) * width
    let rounding = factor * factor / 2
    for x in 0..width * factor {
        let share = (i64(line[x]) + rounding) / (factor * factor)
        let at = base + x / factor
        let sum = i64(out[at]) + share
        out[at] = u8(sum - (sum >> 8))
    }
}

fn coverage_byte(area: i64, even_odd: bool) -> i64 {
    var coverage = area >> 9
    if even_odd {
        if coverage & 0x100 != 0 {
            coverage = ~coverage
        }
        return coverage & 255
    }
    if coverage < 0 {
        coverage = ~coverage
    }
    if coverage > 255 {
        coverage = 255
    }
    coverage
}

fn sweep_row(g: Gray, y: i64, even_odd: bool, mut line: []u8) {
    let base = (y - g.min_y) * (g.width + 1)
    var cover = 0
    for column in 0..g.width + 1 {
        let step = i64(g.cover[base + column]) * 512
        cover = i64(i32(cover + step))
        let cell_area = i64(g.area[base + column])
        let area = i64(i32(cover - cell_area))
        if column > 0 {
            line[column - 1] = u8(coverage_byte(area, even_odd))
        }
    }
}

fn set_cell(mut g: Gray, ex: i64, ey: i64) {
    if ey < g.min_y || ey >= g.max_y || ex >= g.width {
        g.at = -1
    } else {
        let column = max_of(ex, -1) + 1
        g.at = (ey - g.min_y) * (g.width + 1) + column
    }
}

fn integrate(mut g: Gray, cover: i64, span: i64) {
    if g.at >= 0 {
        g.cover[g.at] += i32(cover)
        g.area[g.at] += i32(cover * span)
    }
}

fn reciprocal(divisor: i64) -> i64 {
    reciprocal_one / divisor
}

fn quotient(numerator: i64, reciprocal_of_divisor: i64) -> i64 {
    let product = u64(numerator) * u64(reciprocal_of_divisor)
    i64(i32(product >> 32))
}

fn move_to(mut g: Gray, to: Vec) {
    let x = to.x * upscale
    let y = to.y * upscale
    set_cell(mut g, x >> 8, y >> 8)
    g.x = x
    g.y = y
}

fn line_to(mut g: Gray, to_x: i64, to_y: i64) {
    draw_line(mut g, to_x, to_y)
    g.x = to_x
    g.y = to_y
}

fn draw_line(mut g: Gray, to_x: i64, to_y: i64) {
    let ey1 = g.y >> 8
    let ey2 = to_y >> 8
    if (ey1 >= g.max_y && ey2 >= g.max_y) || (ey1 < g.min_y && ey2 < g.min_y) {
        return
    }
    let ex1 = g.x >> 8
    let ex2 = to_x >> 8
    var enter = Entry { fx: g.x & subpixel_mask, fy: g.y & subpixel_mask }
    let dx = to_x - g.x
    let dy = to_y - g.y
    if ex1 != ex2 || ey1 != ey2 {
        if dy == 0 {
            set_cell(mut g, ex2, ey2)
            return
        }
        if dx == 0 {
            walk_vertical(mut g, ex1, ey1, ey2, enter, dy > 0)
            enter.fy = if dy > 0 { 0 } else { subpixel }
        } else {
            enter = walk_slanted(mut g, ex1, ey1, ex2, ey2, enter, dx, dy)
        }
    }
    let exit_fx = to_x & subpixel_mask
    let exit_fy = to_y & subpixel_mask
    integrate(mut g, exit_fy - enter.fy, enter.fx + exit_fx)
}

fn walk_vertical(mut g: Gray, ex: i64, from_row: i64, to_row: i64, enter: Entry, up: bool) {
    var row = from_row
    var fy = enter.fy
    let exit_fy = if up { subpixel } else { 0 }
    let entry_fy = if up { 0 } else { subpixel }
    let step = if up { 1 } else { -1 }
    for {
        integrate(mut g, exit_fy - fy, enter.fx * 2)
        fy = entry_fy
        row += step
        set_cell(mut g, ex, row)
        if row == to_row {
            break
        }
    }
}

fn walk_slanted(mut g: Gray, from_column: i64, from_row: i64, to_column: i64, to_row: i64, enter: Entry, dx: i64, dy: i64) -> Entry {
    var ex1 = from_column
    var ey1 = from_row
    var fx1 = enter.fx
    var fy1 = enter.fy
    var prod = dx * fy1 - dy * fx1
    let dx_r = if ex1 != to_column { reciprocal(dx) } else { 0 }
    let dy_r = if ey1 != to_row { reciprocal(dy) } else { 0 }
    let dx_s = dx * subpixel
    let dy_s = dy * subpixel
    for {
        if prod - dx_s > 0 && prod <= 0 {
            let fy2 = quotient(-prod, -dx_r)
            prod -= dy_s
            integrate(mut g, fy2 - fy1, fx1)
            fx1 = subpixel
            fy1 = fy2
            ex1 -= 1
        } else if prod - dx_s + dy_s > 0 && prod - dx_s <= 0 {
            prod -= dx_s
            let fx2 = quotient(-prod, dy_r)
            integrate(mut g, subpixel - fy1, fx1 + fx2)
            fx1 = fx2
            fy1 = 0
            ey1 += 1
        } else if prod + dy_s >= 0 && prod - dx_s + dy_s <= 0 {
            prod += dy_s
            let fy2 = quotient(prod, dx_r)
            integrate(mut g, fy2 - fy1, fx1 + subpixel)
            fx1 = 0
            fy1 = fy2
            ex1 += 1
        } else {
            let fx2 = quotient(prod, -dy_r)
            prod += dx_s
            integrate(mut g, 0 - fy1, fx1 + fx2)
            fx1 = fx2
            fy1 = subpixel
            ey1 -= 1
        }
        set_cell(mut g, ex1, ey1)
        if ex1 == to_column && ey1 == to_row {
            break
        }
    }
    Entry { fx: fx1, fy: fy1 }
}

fn conic_to(mut g: Gray, control: Vec, to: Vec) {
    let p0x = g.x
    let p0y = g.y
    let p1x = control.x * upscale
    let p1y = control.y * upscale
    let p2x = to.x * upscale
    let p2y = to.y * upscale
    let all_above = p0y >> 8 >= g.max_y && p1y >> 8 >= g.max_y && p2y >> 8 >= g.max_y
    let all_below = p0y >> 8 < g.min_y && p1y >> 8 < g.min_y && p2y >> 8 < g.min_y
    if all_above || all_below {
        g.x = p2x
        g.y = p2y
        return
    }
    let bx = p1x - p0x
    let by = p1y - p0y
    let ax = p2x - p1x - bx
    let ay = p2y - p1y - by
    var deviation = max_of(magnitude(ax), magnitude(ay))
    if deviation <= flat_enough {
        line_to(mut g, p2x, p2y)
        return
    }
    var shift = 16
    for {
        deviation = deviation >> 2
        shift -= 1
        if deviation <= flat_enough {
            break
        }
    }
    var count = 0x10000 >> shift
    var rx = ax << (shift + shift)
    var ry = ay << (shift + shift)
    var qx = (bx << (shift + 17)) + rx
    var qy = (by << (shift + 17)) + ry
    rx = rx * 2
    ry = ry * 2
    var px = p0x << 32
    var py = p0y << 32
    for count > 0 {
        px += qx
        py += qy
        qx += rx
        qy += ry
        line_to(mut g, px >> 32, py >> 32)
        count -= 1
    }
}

fn trace(mut g: Gray, shape: ScaledOutline) {
    var first = 0
    for last in shape.ends {
        trace_contour(mut g, shape.points, first, last)
        first = last + 1
    }
}

fn vec_of(p: ScaledPoint) -> Vec {
    Vec { x: p.x, y: p.y }
}

fn midpoint(a: Vec, b: Vec) -> Vec {
    Vec { x: (a.x + b.x) / 2, y: (a.y + b.y) / 2 }
}

fn trace_contour(mut g: Gray, points: []ScaledPoint, first: i64, last: i64) {
    var start = vec_of(points[first])
    let end_point = vec_of(points[last])
    var at = first
    var limit = last
    if !points[first].on_curve {
        if points[last].on_curve {
            start = end_point
            limit -= 1
        } else {
            start = midpoint(start, end_point)
        }
        at -= 1
    }
    move_to(mut g, start)
    for at < limit {
        at += 1
        let p = points[at]
        if p.on_curve {
            line_to(mut g, p.x * upscale, p.y * upscale)
            continue
        }
        let run = trace_conics(mut g, points, at, limit, vec_of(p), start)
        if run.closed {
            return
        }
        at = run.at
    }
    line_to(mut g, start.x * upscale, start.y * upscale)
}

fn trace_conics(mut g: Gray, points: []ScaledPoint, from: i64, limit: i64, first_control: Vec, start: Vec) -> Run {
    var at = from
    var control = first_control
    for at < limit {
        at += 1
        let next = vec_of(points[at])
        if points[at].on_curve {
            conic_to(mut g, control, next)
            return Run { at, closed: false }
        }
        conic_to(mut g, control, midpoint(control, next))
        control = next
    }
    conic_to(mut g, control, start)
    Run { at, closed: true }
}
