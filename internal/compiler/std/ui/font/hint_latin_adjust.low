const adjust_up = 0x01
const adjust_down = 0x02
const adjust_up2 = 0x04
const adjust_down2 = 0x08
const adjust_tilde_top = 0x10
const adjust_tilde_bottom = 0x20
const adjust_tilde_top2 = 0x40
const adjust_tilde_bottom2 = 0x80
const ignore_capital_top = 0x100
const ignore_capital_bottom = 0x200
const ignore_small_top = 0x400
const ignore_small_bottom = 0x800
const adjust_no_height_check = 0x1000

fn adjustment_lookup(database: []i64, codepoint: i64) -> i64 {
    var low = 0
    var high = database.len / 2 - 1
    for high >= low {
        let mid = (low + high) / 2
        let mid_codepoint = database[2 * mid]
        if mid_codepoint < codepoint {
            low = mid + 1
        } else if mid_codepoint > codepoint {
            high = mid - 1
        } else {
            return database[2 * mid + 1]
        }
    }
    0
}

fn reverse_charmap(f: Font, database: []i64) -> []i64 {
    var owners: []i64 = []
    for _ in 0..f.glyph_count {
        owners.push(0)
    }
    for i in 0..(database.len / 2) {
        let codepoint = database[2 * i]
        let glyph = glyph_index(f, u32(codepoint))
        if glyph != 0 {
            owners[glyph] = codepoint
        }
    }
    owners
}

fn move_contour_vertically(mut h: GlyphHints, contour: i64, movement: i64) {
    let first = h.contours[contour]
    var point = first
    for {
        h.points[point].y += movement
        point = h.points[point].next
        if point == first {
            break
        }
    }
}

fn move_contours_up(mut h: GlyphHints, limit: i64, delta: i64) {
    for contour in 0..h.contours.len {
        let min_y = h.contour_y_minima[contour]
        let max_y = h.contour_y_maxima[contour]
        if min_y < max_y && min_y > limit {
            move_contour_vertically(mut h, contour, delta)
        }
    }
}

fn move_contours_down(mut h: GlyphHints, limit: i64, delta: i64) {
    for contour in 0..h.contours.len {
        let min_y = h.contour_y_minima[contour]
        let max_y = h.contour_y_maxima[contour]
        if min_y < max_y && max_y < limit {
            move_contour_vertically(mut h, contour, -delta)
        }
    }
}

fn compute_vertical_extrema(mut h: GlyphHints) {
    var minima: []i64 = []
    var maxima: []i64 = []
    for first in h.contours {
        var min_y = long_max
        var max_y = long_min
        if h.points[h.points[first].next].next != first {
            var point = first
            for {
                if h.points[point].y < min_y {
                    min_y = h.points[point].y
                }
                if h.points[point].y > max_y {
                    max_y = h.points[point].y
                }
                point = h.points[point].next
                if point == first {
                    break
                }
            }
        }
        minima.push(min_y)
        maxima.push(max_y)
    }
    h.contour_y_minima = minima
    h.contour_y_maxima = maxima
}

fn find_highest_contour(h: GlyphHints) -> i64 {
    var highest = 0
    var highest_min_y = long_max
    var highest_max_y = long_min
    for contour in 0..h.contours.len {
        let current_min_y = h.contour_y_minima[contour]
        let current_max_y = h.contour_y_maxima[contour]
        if current_max_y > highest_max_y || (current_max_y == highest_max_y && current_min_y > highest_min_y) {
            highest_min_y = current_min_y
            highest_max_y = current_max_y
            highest = contour
        }
    }
    highest
}

fn find_second_highest_contour(h: GlyphHints) -> i64 {
    if h.contours.len < 3 {
        return 0
    }
    let highest = find_highest_contour(h)
    let highest_min_y = h.contour_y_minima[highest]
    var second = 0
    var second_max_y = long_min
    for contour in 0..h.contours.len {
        if contour == highest {
            continue
        }
        let current_min_y = h.contour_y_minima[contour]
        let current_max_y = h.contour_y_maxima[contour]
        if current_max_y > second_max_y && current_min_y < highest_min_y {
            second_max_y = current_max_y
            second = contour
        }
    }
    second
}

fn find_lowest_contour(h: GlyphHints) -> i64 {
    var lowest = 0
    var lowest_min_y = long_max
    var lowest_max_y = long_min
    for contour in 0..h.contours.len {
        let current_min_y = h.contour_y_minima[contour]
        let current_max_y = h.contour_y_maxima[contour]
        if current_min_y < lowest_min_y || (current_min_y == lowest_min_y && current_max_y < lowest_max_y) {
            lowest_min_y = current_min_y
            lowest_max_y = current_max_y
            lowest = contour
        }
    }
    lowest
}

fn find_second_lowest_contour(h: GlyphHints) -> i64 {
    if h.contours.len < 3 {
        return 0
    }
    let lowest = find_lowest_contour(h)
    let lowest_max_y = h.contour_y_maxima[lowest]
    var second = 0
    var second_min_y = long_max
    for contour in 0..h.contours.len {
        if contour == lowest {
            continue
        }
        let current_min_y = h.contour_y_minima[contour]
        let current_max_y = h.contour_y_maxima[contour]
        if current_min_y < second_min_y && current_max_y > lowest_max_y {
            second_min_y = current_min_y
            second = contour
        }
    }
    second
}

fn prevent_top_blue_alignment(mut h: GlyphHints, pos: i64) {
    for e in 0..h.axes[vertical].edges.len {
        if h.axes[vertical].edges[e].pos > pos {
            h.axes[vertical].edges[e].flags |= edge_no_blue
        }
    }
}

fn prevent_bottom_blue_alignment(mut h: GlyphHints, pos: i64) {
    for e in 0..h.axes[vertical].edges.len {
        if h.axes[vertical].edges[e].pos < pos {
            h.axes[vertical].edges[e].flags |= edge_no_blue
        }
    }
}

fn base_glyph_blue(blues: []Blue, required: i64) -> i64 {
    for i in 0..blues.len {
        if blues[i].flags & required == required {
            return i
        }
    }
    -1
}

fn ignore_top(mut h: GlyphHints, top: Blue, bottom: Blue) {
    let base_glyph_height = top.shoot.cur - bottom.shoot.cur
    let limit = top.shoot.cur + base_glyph_height / 7 + 16
    prevent_top_blue_alignment(mut h, limit)
}

fn ignore_bottom(mut h: GlyphHints, top: Blue, bottom: Blue) {
    let base_glyph_height = top.shoot.cur - bottom.shoot.cur
    let limit = bottom.shoot.cur - base_glyph_height / 7 - 16
    prevent_bottom_blue_alignment(mut h, limit)
}

fn touch_contour(mut h: GlyphHints, contour: i64) {
    let first = h.contours[contour]
    var p = first
    for {
        p = h.points[p].next
        h.points[p].flags |= point_ignore
        if h.points[p].flags & point_control == 0 {
            h.points[p].flags |= point_touch_y
        }
        if p == first {
            break
        }
    }
}

fn touch_top_contours(mut h: GlyphHints, limit_contour: i64) {
    let limit = h.contour_y_minima[limit_contour]
    for contour in 0..h.contours.len {
        let min_y = h.contour_y_minima[contour]
        let max_y = h.contour_y_maxima[contour]
        if min_y < max_y && min_y >= limit {
            touch_contour(mut h, contour)
        }
    }
}

fn touch_bottom_contours(mut h: GlyphHints, limit_contour: i64) {
    let limit = h.contour_y_minima[limit_contour]
    for contour in 0..h.contours.len {
        let min_y = h.contour_y_minima[contour]
        let max_y = h.contour_y_maxima[contour]
        if min_y < max_y && max_y <= limit {
            touch_contour(mut h, contour)
        }
    }
}

fn tilde_measurement(h: GlyphHints, tilde_contour: i64) -> i64 {
    let min_y = h.contour_y_minima[tilde_contour]
    let max_y = h.contour_y_maxima[tilde_contour]
    let height = max_y - min_y
    let extremum_threshold = height / 8
    let first_point = h.contours[tilde_contour]
    var p = first_point
    var min_measurement = long_max
    var taken = false
    for {
        p = h.points[p].next
        let prev = h.points[p].prev
        let next = h.points[p].next
        let y = h.points[p].y
        let flat = h.points[p].flags & point_control == 0 && h.points[prev].y == y && h.points[next].y == y && y != min_y && y != max_y && h.points[prev].flags & point_control != 0 && h.points[next].flags & point_control != 0
        if flat {
            var prev_on = prev
            var next_on = next
            for h.points[prev_on].flags & point_control != 0 {
                prev_on = h.points[prev_on].prev
            }
            for h.points[next_on].flags & point_control != 0 {
                next_on = h.points[next_on].next
            }
            var measurement = 0
            var counted = true
            if h.points[next_on].y > y && h.points[prev_on].y > y {
                measurement = y - min_y
            } else if h.points[next_on].y < y && h.points[prev_on].y < y {
                measurement = max_y - y
            } else {
                counted = false
            }
            if counted && measurement >= extremum_threshold {
                if !taken || measurement < min_measurement {
                    taken = true
                    min_measurement = measurement
                }
            }
        }
        if p == first_point {
            break
        }
    }
    if !taken {
        return 0
    }
    min_measurement
}

fn stretch_top_tilde(mut h: GlyphHints, tilde_contour: i64) -> i64 {
    let min_y = h.contour_y_minima[tilde_contour]
    let max_y = h.contour_y_maxima[tilde_contour]
    if min_y == max_y {
        return 0
    }
    let height = max_y - min_y
    let min_measurement = tilde_measurement(h, tilde_contour)
    touch_top_contours(mut h, tilde_contour)
    let target_height = min_measurement + 64
    if height >= target_height {
        return 0
    }
    let first_point = h.contours[tilde_contour]
    var p = first_point
    for {
        p = h.points[p].next
        h.points[p].y = (h.points[p].y - min_y) * target_height / height + min_y
        if p == first_point {
            break
        }
    }
    target_height - height
}

fn stretch_bottom_tilde(mut h: GlyphHints, tilde_contour: i64) -> i64 {
    let min_y = h.contour_y_minima[tilde_contour]
    let max_y = h.contour_y_maxima[tilde_contour]
    if min_y == max_y {
        return 0
    }
    let height = max_y - min_y
    let min_measurement = tilde_measurement(h, tilde_contour)
    touch_bottom_contours(mut h, tilde_contour)
    let target_height = min_measurement + 64
    if height >= target_height {
        return 0
    }
    let first_point = h.contours[tilde_contour]
    var p = first_point
    for {
        p = h.points[p].next
        h.points[p].y = (h.points[p].y - max_y) * target_height / height + max_y
        if p == first_point {
            break
        }
    }
    target_height - height
}

fn contour_vertical_range(h: GlyphHints, tilde_contour: i64) -> Extent {
    let first_point = h.contours[tilde_contour]
    var p = first_point
    var min_y = h.points[p].y
    var max_y = min_y
    for {
        p = h.points[p].next
        if h.points[p].y < min_y {
            min_y = h.points[p].y
        }
        if h.points[p].y > max_y {
            max_y = h.points[p].y
        }
        if p == first_point {
            break
        }
    }
    Extent { low: min_y, high: max_y }
}

fn align_top_tilde(mut h: GlyphHints, tilde_contour: i64) -> i64 {
    let range = contour_vertical_range(h, tilde_contour)
    let min_y_rounded = pix_round(range.low)
    var delta = min_y_rounded - range.low
    let height = range.high - range.low
    if height < 64 * 3 {
        delta += (pix_round(height) - height) / 2
    }
    move_contour_vertically(mut h, tilde_contour, delta)
    delta
}

fn align_bottom_tilde(mut h: GlyphHints, tilde_contour: i64) -> i64 {
    let range = contour_vertical_range(h, tilde_contour)
    let max_y_rounded = pix_round(range.high)
    var delta = max_y_rounded - range.high
    let height = range.high - range.low
    if height < 64 * 3 {
        delta -= (pix_round(height) - height) / 2
    }
    move_contour_vertically(mut h, tilde_contour, delta)
    delta
}

fn check_contour_horizontal_overlap(h: GlyphHints, contour_index: i64) -> bool {
    var contour_max_x = long_min
    var contour_min_x = long_max
    var others_max_x = long_min
    var others_min_x = long_max
    for contour in 0..h.contours.len {
        let first_point = h.contours[contour]
        if h.points[h.points[first_point].next].next == first_point {
            continue
        }
        var p = first_point
        for {
            p = h.points[p].next
            let x = h.points[p].x
            if contour == contour_index {
                if x < contour_min_x {
                    contour_min_x = x
                }
                if x > contour_max_x {
                    contour_max_x = x
                }
            } else {
                if x < others_min_x {
                    others_min_x = x
                }
                if x > others_max_x {
                    others_max_x = x
                }
            }
            if p == first_point {
                break
            }
        }
    }
    (others_min_x <= contour_max_x && contour_max_x <= others_max_x) || (others_min_x <= contour_min_x && contour_min_x <= others_max_x) || (contour_max_x >= others_max_x && contour_min_x <= others_min_x)
}

fn apply_vertical_separation_adjustments(mut h: GlyphHints, adj_type: i64, accent_height_limit: i64) {
    let adjust_top = adj_type & adjust_up != 0
    let adjust_below_top = adj_type & adjust_up2 != 0
    let adjust_bottom = adj_type & adjust_down != 0
    let adjust_above_bottom = adj_type & adjust_down2 != 0
    let contour_count = h.contours.len
    if ((adjust_top || adjust_bottom) && contour_count >= 2) || ((adjust_below_top || adjust_above_bottom) && contour_count >= 3) {
        compute_vertical_extrema(mut h)
    }
    if (adjust_top && contour_count >= 2) || (adjust_below_top && contour_count >= 3) {
        let high_contour = if adjust_below_top { find_second_highest_contour(h) } else { find_highest_contour(h) }
        if !check_contour_horizontal_overlap(h, high_contour) {
            return
        }
        let high_min_y = h.contour_y_minima[high_contour]
        let high_max_y = h.contour_y_maxima[high_contour]
        let high_height = high_max_y - high_min_y
        if high_height > accent_height_limit {
            return
        }
        var min_distance = 64
        for contour in 0..contour_count {
            if contour == high_contour {
                continue
            }
            let min_y = h.contour_y_minima[contour]
            let max_y = h.contour_y_maxima[contour]
            let distance = high_min_y - max_y
            if distance < 64 && distance < min_distance && min_y < high_min_y {
                min_distance = distance
            }
        }
        let adjustment_amount = 64 - min_distance
        let is_top_tilde = adj_type & adjust_tilde_top != 0
        let is_below_top_tilde = adj_type & adjust_tilde_top2 != 0
        var centering_adjustment = 0
        if is_top_tilde || is_below_top_tilde {
            var tilde_contour = high_contour
            if !adjust_top && !is_below_top_tilde {
                tilde_contour = find_highest_contour(h)
            }
            let tilde_height = h.contour_y_maxima[tilde_contour] - h.contour_y_minima[tilde_contour]
            var pos = high_min_y + adjustment_amount
            if adjust_below_top && is_top_tilde {
                pos += high_height
            }
            if pos % 64 == 0 && tilde_height < 3 * 64 {
                centering_adjustment = (pix_round(tilde_height) - tilde_height) / 2
            }
        }
        var calculated_amount = adjustment_amount
        if (adjust_top && is_top_tilde) || (adjust_below_top && is_below_top_tilde) {
            calculated_amount = adjustment_amount + centering_adjustment
        }
        if calculated_amount != 0 && calculated_amount >= -2 && (calculated_amount <= 66 || adjustment_amount <= 66) {
            let height_delta = high_height / 8
            let min_y_limit = high_min_y - height_delta
            move_contours_up(mut h, min_y_limit, adjustment_amount)
            if adjust_below_top && is_top_tilde {
                move_contours_up(mut h, min_y_limit + high_height, centering_adjustment)
            }
        }
    }
    if (adjust_bottom && contour_count >= 2) || (adjust_above_bottom && contour_count >= 3) {
        let low_contour = if adjust_above_bottom { find_second_lowest_contour(h) } else { find_lowest_contour(h) }
        if !check_contour_horizontal_overlap(h, low_contour) {
            return
        }
        let low_min_y = h.contour_y_minima[low_contour]
        let low_max_y = h.contour_y_maxima[low_contour]
        let low_height = low_max_y - low_min_y
        if low_height > accent_height_limit {
            return
        }
        var min_distance = 64
        for contour in 0..contour_count {
            if contour == low_contour {
                continue
            }
            let min_y = h.contour_y_minima[contour]
            let max_y = h.contour_y_maxima[contour]
            let distance = min_y - low_max_y
            if distance < 64 && distance < min_distance && max_y > low_max_y {
                min_distance = distance
            }
        }
        let adjustment_amount = 64 - min_distance
        let is_bottom_tilde = adj_type & adjust_tilde_bottom != 0
        let is_above_bottom_tilde = adj_type & adjust_tilde_bottom2 != 0
        var centering_adjustment = 0
        if is_bottom_tilde || is_above_bottom_tilde {
            var tilde_contour = low_contour
            if !adjust_bottom && !is_above_bottom_tilde {
                tilde_contour = find_lowest_contour(h)
            }
            let tilde_height = h.contour_y_maxima[tilde_contour] - h.contour_y_minima[tilde_contour]
            var pos = low_max_y - adjustment_amount
            if adjust_above_bottom && is_bottom_tilde {
                pos -= low_height
            }
            if pos % 64 == 0 && tilde_height < 3 * 64 {
                centering_adjustment = (pix_round(tilde_height) - tilde_height) / 2
            }
        }
        var calculated_amount = adjustment_amount
        if (adjust_bottom && is_bottom_tilde) || (adjust_above_bottom && is_above_bottom_tilde) {
            calculated_amount = adjustment_amount + centering_adjustment
        }
        if calculated_amount != 0 && calculated_amount >= -2 && (calculated_amount <= 66 || adjustment_amount <= 66) {
            let height_delta = low_height / 8
            let max_y_limit = low_max_y + height_delta
            move_contours_down(mut h, max_y_limit, adjustment_amount)
            if adjust_above_bottom && is_bottom_tilde {
                move_contours_down(mut h, max_y_limit - low_height, centering_adjustment)
            }
        }
    }
}
