import std/os
import std/slices
import strings = std/text

/// Returns the directories `discover` searches, in order: the per-user and system font directories of the platform, each once.
pub fn font_directories() -> []str {
    var out: []str = []
    var windows = os.env("WINDIR") ?? ""
    if windows == "" {
        windows = "C:\\Windows"
    }
    add_directory(mut out, "{windows}\\Fonts")
    let local = os.env("LOCALAPPDATA") ?? ""
    if local != "" {
        add_directory(mut out, "{local}\\Microsoft\\Windows\\Fonts")
    }
    out
}

fn add_directory(mut out: []str, dir: str) {
    var end = dir.len
    for end > 3 && (dir[end - 1] == '\\' || dir[end - 1] == '/') {
        end -= 1
    }
    let trimmed = dir[0..end]
    let lower = strings.lower(trimmed)
    if !slices.contains(out.map(fn(d) strings.lower(d)), lower) {
        out.push(trimmed)
    }
}
