const horizontal = 0
const vertical = 1

const dir_none = 4
const dir_right = 1
const dir_left = -1
const dir_up = 2
const dir_down = -2

const point_conic = 1
const point_cubic = 2
const point_control = 3
const point_touch_x = 4
const point_touch_y = 8
const point_weak = 16
const point_near = 32
const point_ignore = 64

const edge_normal = 0
const edge_round = 1
const edge_serif = 2
const edge_done = 4
const edge_neutral = 8
const edge_no_blue = 16

const scaler_no_horizontal = 1
const scaler_no_advance = 4

const blue_active = 1
const blue_top = 2
const blue_sub_top = 4
const blue_neutral = 8
const blue_adjustment = 16
const blue_bottom = 32
const blue_bottom_small = 64

const writing_dummy = 0
const writing_latin = 1
const writing_cjk = 2
const writing_indic = 3

const max_widths = 16
const max_blues = 8

struct HintPoint {
    flags: i64 = 0
    in_dir: i64 = 4
    out_dir: i64 = 4
    ox: i64 = 0
    oy: i64 = 0
    fx: i64 = 0
    fy: i64 = 0
    x: i64 = 0
    y: i64 = 0
    u: i64 = 0
    v: i64 = 0
    next: i64 = 0
    prev: i64 = 0
}

struct Segment {
    flags: i64 = 0
    dir: i64 = 0
    pos: i64 = 0
    delta: i64 = 0
    min_coord: i64 = 0
    max_coord: i64 = 0
    height: i64 = 0
    edge: i64 = -1
    edge_next: i64 = -1
    link: i64 = -1
    serif: i64 = -1
    score: i64 = 0
    length: i64 = 0
    first: i64 = 0
    last: i64 = 0
}

struct Edge {
    fpos: i64 = 0
    opos: i64 = 0
    pos: i64 = 0
    flags: i64 = 0
    dir: i64 = 0
    scale: i64 = 0
    blue: i64 = -1
    link: i64 = -1
    serif: i64 = -1
    score: i64 = 0
    first: i64 = -1
    last: i64 = -1
}

struct AxisHints {
    segments: []Segment = []
    edges: []Edge = []
    major_dir: i64 = 0
}

struct Width {
    org: i64 = 0
    cur: i64 = 0
    fit: i64 = 0
}

struct Blue {
    ref: Width = Width {}
    shoot: Width = Width {}
    ascender: i64 = 0
    descender: i64 = 0
    flags: i64 = 0
}

struct Axis {
    scale: i64 = 0
    delta: i64 = 0
    org_scale: i64 = 0
    org_delta: i64 = 0
    widths: []Width = []
    blues: []Blue = []
    edge_distance_threshold: i64 = 0
    standard_width: i64 = 0
    extra_light: bool = false
}

struct Scaler {
    x_scale: i64 = 0
    x_delta: i64 = 0
    y_scale: i64 = 0
    y_delta: i64 = 0
    flags: i64 = 0
}

struct StyleMetrics {
    writing_system: i64 = 0
    script: i64 = 0
    style: i64 = 0
    units_per_em: i64 = 0
    scaler: Scaler = Scaler {}
    axes: []Axis = []
}

struct GlyphHints {
    points: []HintPoint = []
    contours: []i64 = []
    contour_y_minima: []i64 = []
    contour_y_maxima: []i64 = []
    axes: []AxisHints = []
    x_scale: i64 = 0
    x_delta: i64 = 0
    y_scale: i64 = 0
    y_delta: i64 = 0
    scaler_flags: i64 = 0
    other_flags: i64 = 0
    metrics: StyleMetrics = StyleMetrics {}
}

struct StyleClass {
    writing_system: i64
    script: i64
    blue_stringset: i64
}

struct BlueString {
    properties: i64
    chars: []i64
}

fn new_hints(metrics: StyleMetrics) -> GlyphHints {
    GlyphHints {
        axes: [AxisHints {}, AxisHints {}]
        scaler_flags: metrics.scaler.flags
        metrics
    }
}

fn is_hinted(h: GlyphHints, dim: i64) -> bool {
    let disabled = if dim == horizontal { scaler_no_horizontal } else { 0 }
    h.scaler_flags & disabled == 0
}
