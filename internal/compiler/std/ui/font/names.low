import std/builder
import std/unicode/utf16

/// The family, weight and slant a font's tables give it, which choose it among other fonts.
pub struct Description {
    /// The typographic family name, such as `Noto Sans`, from the `name` table: name 16, else name 1.
    pub family: str = ""
    /// The weight from 1 to 1000, with 400 regular and 700 bold: the `OS/2` table's, else 700 when `head` marks the font bold, else 400.
    pub weight: i64 = 400
    /// Whether the font is italic or oblique, by the `OS/2` selection flags, else by `head`.
    pub italic: bool = false
}

/// Returns what the tables of `f` say about its family, weight and slant.
pub fn describe(f: Font) -> Description {
    let dir = directory(f.data, f.at) or return Description {}
    described(table_bytes(dir, "name"), table_bytes(dir, "OS/2"), table_bytes(dir, "head"))
}

fn table_bytes(dir: Directory, tag: str) -> str {
    let t = find(dir, tag) ?? return ""
    dir.data[t.offset..t.offset + t.length]
}

fn described(name: str, os2: str, head: str) -> Description {
    let style = if head.len >= 46 { be16(head, 44) } else { 0 }
    var out = Description { family: family_name(name), weight: if style & 1 != 0 { 700 } else { 400 }, italic: style & 2 != 0 }
    if os2.len >= 64 {
        out.weight = weight_class(be16(os2, 4))
        out.italic = be16(os2, 62) & 0x201 != 0
    }
    out
}

fn weight_class(raw: i64) -> i64 {
    if raw >= 1 && raw <= 9 {
        return raw * 100
    }
    if raw < 1 || raw > 1000 {
        return 400
    }
    raw
}

fn family_name(name: str) -> str {
    if name.len < 6 {
        return ""
    }
    let count = be16(name, 2)
    let strings = be16(name, 4)
    var best = -1
    var best_score = 0
    for i in 0..count {
        let record = 6 + 12 * i
        if record + 12 > name.len {
            break
        }
        let score = name_score(name, record)
        if score > best_score {
            best = record
            best_score = score
        }
    }
    if best < 0 {
        return ""
    }
    let length = be16(name, best + 8)
    let start = strings + be16(name, best + 10)
    if start + length > name.len {
        return ""
    }
    let raw = name[start..start + length]
    if be16(name, best) == 1 {
        return mac_roman(raw)
    }
    big_endian_utf16(raw)
}

fn name_score(name: str, record: i64) -> i64 {
    let platform = be16(name, record)
    let encoding = be16(name, record + 2)
    let language = be16(name, record + 4)
    let id = be16(name, record + 6)
    let kind = if id == 16 { 100 } else if id == 1 { 0 } else { return 0 }
    if platform == 3 && (encoding == 0 || encoding == 1 || encoding == 10) {
        return kind + if language == 0x409 { 40 } else { 30 }
    }
    if platform == 0 {
        return kind + 20
    }
    if platform == 1 && encoding == 0 && language == 0 {
        return kind + 10
    }
    0
}

fn big_endian_utf16(raw: str) -> str {
    var units: []u16 = []
    var i = 0
    for i + 1 < raw.len {
        units.push(u16(be16(raw, i)))
        i += 2
    }
    utf16.decode_lossy(units)
}

fn mac_roman(raw: str) -> str {
    let high = mac_roman_high()
    var out = builder.with_capacity(raw.len)
    for i in 0..raw.len {
        let b = i64(raw[i])
        if b < 128 {
            out.write_byte(u8(b))
        } else {
            out.write_char(high[b - 128])
        }
    }
    out.to_str()
}

fn mac_roman_high() -> []u32 {
    [
        0x00C4, 0x00C5, 0x00C7, 0x00C9, 0x00D1, 0x00D6, 0x00DC, 0x00E1,
        0x00E0, 0x00E2, 0x00E4, 0x00E3, 0x00E5, 0x00E7, 0x00E9, 0x00E8,
        0x00EA, 0x00EB, 0x00ED, 0x00EC, 0x00EE, 0x00EF, 0x00F1, 0x00F3,
        0x00F2, 0x00F4, 0x00F6, 0x00F5, 0x00FA, 0x00F9, 0x00FB, 0x00FC,
        0x2020, 0x00B0, 0x00A2, 0x00A3, 0x00A7, 0x2022, 0x00B6, 0x00DF,
        0x00AE, 0x00A9, 0x2122, 0x00B4, 0x00A8, 0x2260, 0x00C6, 0x00D8,
        0x221E, 0x00B1, 0x2264, 0x2265, 0x00A5, 0x00B5, 0x2202, 0x2211,
        0x220F, 0x03C0, 0x222B, 0x00AA, 0x00BA, 0x03A9, 0x00E6, 0x00F8,
        0x00BF, 0x00A1, 0x00AC, 0x221A, 0x0192, 0x2248, 0x2206, 0x00AB,
        0x00BB, 0x2026, 0x00A0, 0x00C0, 0x00C3, 0x00D5, 0x0152, 0x0153,
        0x2013, 0x2014, 0x201C, 0x201D, 0x2018, 0x2019, 0x00F7, 0x25CA,
        0x00FF, 0x0178, 0x2044, 0x20AC, 0x2039, 0x203A, 0xFB01, 0xFB02,
        0x2021, 0x00B7, 0x201A, 0x201E, 0x2030, 0x00C2, 0x00CA, 0x00C1,
        0x00CB, 0x00C8, 0x00CD, 0x00CE, 0x00CF, 0x00CC, 0x00D3, 0x00D4,
        0xF8FF, 0x00D2, 0x00DA, 0x00DB, 0x00D9, 0x0131, 0x02C6, 0x02DC,
        0x00AF, 0x02D8, 0x02D9, 0x02DA, 0x00B8, 0x02DD, 0x02DB, 0x02C7
    ]
}
