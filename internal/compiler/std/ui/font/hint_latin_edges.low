struct Extent {
    low: i64
    high: i64
}

fn latin_align_linked_edge(edges: []Edge, base: i64, stem: i64) {
    let dist = edges[stem].opos - edges[base].opos
    edges[stem].pos = edges[base].pos + dist
}

fn latin_align_serif_edge(edges: []Edge, base: i64, serif: i64) {
    edges[serif].pos = edges[base].pos + (edges[serif].opos - edges[base].opos)
}

fn blue_fit(blues: []Blue, code: i64) -> i64 {
    if code % 2 == 1 { blues[code / 2].shoot.fit } else { blues[code / 2].ref.fit }
}

fn edge_extent(h: GlyphHints, edge: Edge) -> Extent {
    let first = h.axes[vertical].segments[edge.first]
    let last = h.axes[vertical].segments[edge.last]
    let a = h.points[first.first].v
    let b = h.points[first.last].v
    let c = h.points[last.first].v
    let d = h.points[last.last].v
    Extent { low: min_of(min_of(a, b), min_of(c, d)), high: max_of(max_of(a, b), max_of(c, d)) }
}

fn latin_hint_edges(mut h: GlyphHints) {
    let edges = h.axes[vertical].edges
    let blues = h.metrics.axes[vertical].blues
    let top_to_bottom = script_top_to_bottom(h.metrics.script)
    let count = edges.len
    var anchor = -1
    var has_non_stem_edges = false
    for e in 0..count {
        if edges[e].flags & edge_done != 0 {
            continue
        }
        var edge1 = -1
        var edge2 = edges[e].link
        if edges[e].blue >= 0 && edge2 >= 0 && edges[edge2].blue >= 0 {
            let neutral = edges[e].flags & edge_neutral
            let neutral2 = edges[edge2].flags & edge_neutral
            if neutral2 != 0 {
                edges[edge2].blue = -1
                edges[edge2].flags &= ~edge_neutral
            } else if neutral != 0 {
                edges[e].blue = -1
                edges[e].flags &= ~edge_neutral
            }
        }
        var blue = edges[e].blue
        if blue >= 0 {
            edge1 = e
        } else if edge2 >= 0 && edges[edge2].blue >= 0 {
            blue = edges[edge2].blue
            edge1 = edge2
            edge2 = e
        }
        if edge1 < 0 {
            continue
        }
        edges[edge1].pos = blue_fit(blues, blue)
        edges[edge1].flags |= edge_done
        if edge2 >= 0 && edges[edge2].blue < 0 {
            latin_align_linked_edge(edges, edge1, edge2)
            edges[edge2].flags |= edge_done
        }
        if anchor < 0 {
            anchor = e
        }
    }
    for e in 0..count {
        if edges[e].flags & edge_done != 0 {
            continue
        }
        let edge2 = edges[e].link
        if edge2 < 0 {
            has_non_stem_edges = true
            continue
        }
        if edges[edge2].blue >= 0 {
            latin_align_linked_edge(edges, edge2, e)
            edges[e].flags |= edge_done
            continue
        }
        if anchor < 0 {
            anchor = hint_first_stem(edges, e, edge2)
            continue
        }
        hint_stem(edges, anchor, e, edge2)
        if e > 0 {
            let out_of_order = if top_to_bottom { edges[e].pos > edges[e - 1].pos } else { edges[e].pos < edges[e - 1].pos }
            if out_of_order && magnitude(edges[edge2].pos - edges[e - 1].pos) > 16 {
                edges[e].pos = edges[e - 1].pos
            }
        }
    }
    if has_non_stem_edges || anchor < 0 {
        hint_remaining_edges(h, edges, anchor, top_to_bottom)
    }
}

fn hint_first_stem(edges: []Edge, e: i64, edge2: i64) -> i64 {
    let org_len = edges[edge2].opos - edges[e].opos
    let cur_len = org_len
    let u_off = if cur_len <= 64 { 32 } else { 38 }
    let d_off = if cur_len <= 64 { 32 } else { 26 }
    if cur_len < 96 {
        let org_center = edges[e].opos + (org_len >> 1)
        var cur_pos1 = pix_round(org_center)
        let error1 = magnitude(org_center - (cur_pos1 - u_off))
        let error2 = magnitude(org_center - (cur_pos1 + d_off))
        if error1 < error2 {
            cur_pos1 -= u_off
        } else {
            cur_pos1 += d_off
        }
        edges[e].pos = cur_pos1 - cur_len / 2
        edges[edge2].pos = edges[e].pos + cur_len
    } else {
        edges[e].pos = pix_round(edges[e].opos)
    }
    edges[e].flags |= edge_done
    latin_align_linked_edge(edges, e, edge2)
    e
}

fn hint_stem(edges: []Edge, anchor: i64, e: i64, edge2: i64) {
    var org_pos = edges[anchor].pos + (edges[e].opos - edges[anchor].opos)
    var org_len = edges[edge2].opos - edges[e].opos
    var org_center = org_pos + (org_len >> 1)
    let cur_len = org_len
    if edges[edge2].flags & edge_done != 0 {
        edges[e].pos = edges[edge2].pos - cur_len
    } else if cur_len < 96 {
        var cur_pos1 = pix_round(org_center)
        let u_off = if cur_len <= 64 { 32 } else { 38 }
        let d_off = if cur_len <= 64 { 32 } else { 26 }
        let delta1 = magnitude(org_center - (cur_pos1 - u_off))
        let delta2 = magnitude(org_center - (cur_pos1 + d_off))
        if delta1 < delta2 {
            cur_pos1 -= u_off
        } else {
            cur_pos1 += d_off
        }
        edges[e].pos = cur_pos1 - cur_len / 2
        edges[edge2].pos = cur_pos1 + cur_len / 2
    } else {
        org_pos = edges[anchor].pos + (edges[e].opos - edges[anchor].opos)
        org_len = edges[edge2].opos - edges[e].opos
        org_center = org_pos + (org_len >> 1)
        let cur_pos1 = pix_round(org_pos)
        let delta1 = magnitude(cur_pos1 + (cur_len >> 1) - org_center)
        let cur_pos2 = pix_round(org_pos + org_len) - cur_len
        let delta2 = magnitude(cur_pos2 + (cur_len >> 1) - org_center)
        edges[e].pos = if delta1 < delta2 { cur_pos1 } else { cur_pos2 }
        edges[edge2].pos = edges[e].pos + cur_len
    }
    edges[e].flags |= edge_done
    edges[edge2].flags |= edge_done
}

fn hint_remaining_edges(h: GlyphHints, edges: []Edge, first_anchor: i64, top_to_bottom: bool) {
    var anchor = first_anchor
    let count = edges.len
    for e in 0..count {
        if edges[e].flags & edge_done != 0 {
            continue
        }
        var delta = 1000
        let serif = edges[e].serif
        if serif >= 0 {
            delta = edges[serif].opos - edges[e].opos
            var top = serif
            var bottom = e
            if delta < 0 {
                delta = -delta
                top = e
                bottom = serif
            }
            if delta < 64 + 32 {
                let top_extent = edge_extent(h, edges[top])
                let bottom_extent = edge_extent(h, edges[bottom])
                let min_pos = min_of(top_extent.low, bottom_extent.low)
                let max_pos = max_of(top_extent.high, bottom_extent.high)
                for between in (bottom + 1)..top {
                    let extent = edge_extent(h, edges[between])
                    let clear = (extent.low < min_pos && extent.high < min_pos) || (extent.low > max_pos && extent.high > max_pos)
                    if !clear {
                        delta = 1000
                        break
                    }
                }
                if delta == 1000 {
                    continue
                }
            }
        }
        if delta < 64 + 16 {
            latin_align_serif_edge(edges, serif, e)
        } else if anchor < 0 {
            edges[e].pos = pix_round(edges[e].opos)
            anchor = e
        } else {
            var before = e - 1
            for before >= 0 {
                if edges[before].flags & edge_done != 0 {
                    break
                }
                before -= 1
            }
            var after = e + 1
            for after < count {
                if edges[after].flags & edge_done != 0 {
                    break
                }
                after += 1
            }
            if before >= 0 && after < count {
                if edges[after].opos == edges[before].opos {
                    edges[e].pos = edges[before].pos
                } else {
                    edges[e].pos = edges[before].pos + mul_div(edges[e].opos - edges[before].opos, edges[after].pos - edges[before].pos, edges[after].opos - edges[before].opos)
                }
            } else {
                edges[e].pos = edges[anchor].pos + ((edges[e].opos - edges[anchor].opos + 16) & ~31)
            }
        }
        edges[e].flags |= edge_done
    }
}
