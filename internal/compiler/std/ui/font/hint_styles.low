const style_has_cmap_entry = 0x2000
const last_code_point = 0x10FFFF
const last_bmp_code_point = 0xFFFE

struct CmapEntries {
    codes: []i64 = []
    glyphs: []i64 = []
}

fn cmap_entries(f: Font) -> CmapEntries {
    var entries = CmapEntries {}
    if f.cmap_format == 12 {
        let groups = f.cmap + 16
        for g in 0..be32(f.data, f.cmap + 12) {
            let start = be32(f.data, groups + 12 * g)
            let end = min_of(be32(f.data, groups + 12 * g + 4), last_code_point)
            add_cmap_range(f, start, end, mut entries)
        }
        return entries
    }
    let segments = be16(f.data, f.cmap + 6) / 2
    let ends = f.cmap + 14
    let starts = ends + 2 * segments + 2
    for s in 0..segments {
        let start = be16(f.data, starts + 2 * s)
        let end = min_of(be16(f.data, ends + 2 * s), last_bmp_code_point)
        add_cmap_range(f, start, end, mut entries)
    }
    entries
}

fn add_cmap_range(f: Font, start: i64, end: i64, mut entries: CmapEntries) {
    for code in start..(end + 1) {
        let glyph = glyph_index(f, u32(code))
        if glyph != 0 {
            entries.codes.push(code)
            entries.glyphs.push(glyph)
        }
    }
}

fn first_entry_at_or_after(entries: CmapEntries, code: i64) -> i64 {
    var low = 0
    var high = entries.codes.len
    for low < high {
        let mid = (low + high) / 2
        if entries.codes[mid] < code {
            low = mid + 1
        } else {
            high = mid
        }
    }
    low
}

fn assign_default_coverage(entries: CmapEntries, ranges: []i64, style: i64, mut styles: []i64) {
    for pair in 0..(ranges.len / 2) {
        let last = ranges[2 * pair + 1]
        var at = first_entry_at_or_after(entries, ranges[2 * pair])
        for at < entries.codes.len && entries.codes[at] <= last {
            let glyph = entries.glyphs[at]
            if styles[glyph] & style_mask == style_mask {
                styles[glyph] = style | style_has_cmap_entry
            }
            at += 1
        }
    }
}

fn mark_nonbase_coverage(entries: CmapEntries, ranges: []i64, style: i64, mut styles: []i64) {
    for pair in 0..(ranges.len / 2) {
        let last = ranges[2 * pair + 1]
        var at = first_entry_at_or_after(entries, ranges[2 * pair])
        for at < entries.codes.len && entries.codes[at] <= last {
            let glyph = entries.glyphs[at]
            if styles[glyph] & style_mask == style {
                styles[glyph] |= style_nonbase
            }
            at += 1
        }
    }
}

fn style_coverage(f: Font, entries: CmapEntries) -> []i64 {
    var styles: []i64 = []
    for _ in 0..f.glyph_count {
        styles.push(style_mask)
    }
    let classes = style_classes()
    for style in 0..classes.len {
        let script = classes[style].script
        let ranges = script_ranges(script)
        assign_default_coverage(entries, ranges, style, mut styles)
        let nonbase = script_nonbase_ranges(script)
        mark_nonbase_coverage(entries, nonbase, style, mut styles)
    }
    for glyph in 0..styles.len {
        if styles[glyph] & style_mask == style_mask {
            styles[glyph] = (styles[glyph] & ~style_mask) | style_hani_dflt
        }
    }
    styles
}
