fn direction_compute(dx: i64, dy: i64) -> i64 {
    var dir = dir_none
    var long_arm = 0
    var short_arm = 0
    if dy >= dx {
        if dy >= -dx {
            dir = dir_up
            long_arm = dy
            short_arm = dx
        } else {
            dir = dir_left
            long_arm = -dx
            short_arm = dy
        }
    } else {
        if dy >= -dx {
            dir = dir_right
            long_arm = dx
            short_arm = dy
        } else {
            dir = dir_down
            long_arm = -dy
            short_arm = dx
        }
    }
    if long_arm <= 14 * magnitude(short_arm) {
        dir = dir_none
    }
    dir
}

fn outline_is_postscript(outline: ScaledOutline) -> bool {
    var area = 0
    var first = 0
    for end in outline.ends {
        var prev_x = outline.points[end].x
        var prev_y = outline.points[end].y
        for n in first..(end + 1) {
            let cur = outline.points[n]
            area += (cur.y - prev_y) * (cur.x + prev_x)
            prev_x = cur.x
            prev_y = cur.y
        }
        first = end + 1
    }
    area > 0
}

fn reload(mut h: GlyphHints, outline: ScaledOutline) {
    for dim in 0..2 {
        h.axes[dim].segments = []
        h.axes[dim].edges = []
    }
    if outline_is_postscript(outline) {
        h.axes[horizontal].major_dir = dir_down
        h.axes[vertical].major_dir = dir_right
    } else {
        h.axes[horizontal].major_dir = dir_up
        h.axes[vertical].major_dir = dir_left
    }
    var points: []HintPoint = []
    var contours: []i64 = []
    h.points = points
    h.contours = contours
    if outline.points.len == 0 {
        return
    }
    let near_limit = 20 * h.metrics.units_per_em / 2048
    for p in outline.points {
        let x = mul_fix(p.x, h.x_scale) + h.x_delta
        let y = mul_fix(p.y, h.y_scale) + h.y_delta
        points.push(HintPoint { fx: truncate_short(p.x), fy: truncate_short(p.y), ox: x, oy: y, x, y })
    }
    var first = 0
    for end in outline.ends {
        contours.push(first)
        var prev = end
        for i in first..(end + 1) {
            points[i].flags = if outline.points[i].on_curve { 0 } else { point_conic }
            let out_x = points[i].fx - points[prev].fx
            let out_y = points[i].fy - points[prev].fy
            if magnitude(out_x) + magnitude(out_y) < near_limit {
                points[prev].flags |= point_near
            }
            points[i].prev = prev
            points[prev].next = i
            prev = i
        }
        first = end + 1
    }
    h.points = points
    h.contours = contours
    for start in contours {
        mark_directions(mut h, start, near_limit)
    }
    mark_weak_corners(mut h)
    mark_weak_points(mut h)
}

fn mark_directions(mut h: GlyphHints, start: i64, near_limit: i64) {
    let near_limit2 = 2 * near_limit - 1
    var point = start
    var prev = h.points[start].prev
    for prev != start {
        let out_x = h.points[point].fx - h.points[prev].fx
        let out_y = h.points[point].fy - h.points[prev].fy
        if magnitude(out_x) + magnitude(out_y) >= near_limit2 {
            break
        }
        point = prev
        prev = h.points[prev].prev
    }
    let first = point
    var curr = first
    h.points[curr].u = first - curr
    h.points[first].v = -h.points[curr].u
    var out_x = 0
    var out_y = 0
    var next = first
    for {
        let at = next
        next = h.points[at].next
        out_x += h.points[next].fx - h.points[at].fx
        out_y += h.points[next].fy - h.points[at].fy
        if magnitude(out_x) + magnitude(out_y) < near_limit {
            h.points[next].flags |= point_weak
        } else {
            h.points[curr].u = next - curr
            h.points[next].v = -h.points[curr].u
            let out_dir = direction_compute(out_x, out_y)
            h.points[curr].out_dir = out_dir
            curr = h.points[curr].next
            for curr != next {
                h.points[curr].in_dir = out_dir
                h.points[curr].out_dir = out_dir
                curr = h.points[curr].next
            }
            h.points[next].in_dir = out_dir
            h.points[curr].u = first - curr
            h.points[first].v = -h.points[curr].u
            out_x = 0
            out_y = 0
        }
        if next == first {
            break
        }
    }
}

fn mark_weak_corners(mut h: GlyphHints) {
    for i in 0..h.points.len {
        if h.points[i].flags & point_weak != 0 {
            continue
        }
        if h.points[i].in_dir == dir_none && h.points[i].out_dir == dir_none {
            let next_u = i + h.points[i].u
            let prev_v = i + h.points[i].v
            let in_x = h.points[i].fx - h.points[prev_v].fx
            let in_y = h.points[i].fy - h.points[prev_v].fy
            let out_x = h.points[next_u].fx - h.points[i].fx
            let out_y = h.points[next_u].fy - h.points[i].fy
            if (in_x ^ out_x) >= 0 && (in_y ^ out_y) >= 0 {
                h.points[i].flags |= point_weak
                h.points[prev_v].u = next_u - prev_v
                h.points[next_u].v = -h.points[prev_v].u
            }
        }
    }
}

fn mark_weak_points(mut h: GlyphHints) {
    for i in 0..h.points.len {
        if h.points[i].flags & point_weak != 0 {
            continue
        }
        var weak = false
        if h.points[i].flags & point_control != 0 {
            weak = true
        } else if h.points[i].out_dir == h.points[i].in_dir {
            if h.points[i].out_dir != dir_none {
                weak = true
            } else {
                let next_u = i + h.points[i].u
                let prev_v = i + h.points[i].v
                let in_x = h.points[i].fx - h.points[prev_v].fx
                let in_y = h.points[i].fy - h.points[prev_v].fy
                let out_x = h.points[next_u].fx - h.points[i].fx
                let out_y = h.points[next_u].fy - h.points[i].fy
                if corner_is_flat(in_x, in_y, out_x, out_y) {
                    h.points[prev_v].u = next_u - prev_v
                    h.points[next_u].v = -h.points[prev_v].u
                    weak = true
                }
            }
        } else if h.points[i].in_dir == -h.points[i].out_dir {
            weak = true
        }
        if weak {
            h.points[i].flags |= point_weak
        }
    }
}

fn save(h: GlyphHints, loaded: ScaledOutline) -> ScaledOutline {
    var points: []ScaledPoint = []
    for p in h.points {
        points.push(ScaledPoint { x: p.x, y: p.y, on_curve: p.flags & point_control == 0 })
    }
    ScaledOutline { points, ends: loaded.ends, overlap: loaded.overlap }
}

fn align_edge_points(mut h: GlyphHints, dim: i64) {
    let touch = if dim == horizontal { point_touch_x } else { point_touch_y }
    for seg in h.axes[dim].segments {
        if seg.edge < 0 {
            continue
        }
        let pos = h.axes[dim].edges[seg.edge].pos
        var point = seg.first
        for {
            if dim == horizontal {
                h.points[point].x = pos
            } else {
                h.points[point].y = pos
            }
            h.points[point].flags |= touch
            if point == seg.last {
                break
            }
            point = h.points[point].next
        }
    }
}

fn align_strong_points(mut h: GlyphHints, dim: i64) {
    let touch = if dim == horizontal { point_touch_x } else { point_touch_y }
    let edge_count = h.axes[dim].edges.len
    if edge_count == 0 {
        return
    }
    for i in 0..h.points.len {
        if h.points[i].flags & touch != 0 {
            continue
        }
        if h.points[i].flags & point_weak != 0 {
            continue
        }
        let fu = if dim == vertical { h.points[i].fy } else { h.points[i].fx }
        let ou = if dim == vertical { h.points[i].oy } else { h.points[i].ox }
        let u = strong_position(mut h, dim, fu, ou)
        if dim == horizontal {
            h.points[i].x = u
        } else {
            h.points[i].y = u
        }
        h.points[i].flags |= touch
    }
}

fn strong_position(mut h: GlyphHints, dim: i64, fu: i64, ou: i64) -> i64 {
    let count = h.axes[dim].edges.len
    let first = h.axes[dim].edges[0]
    if first.fpos - fu >= 0 {
        return first.pos - (first.opos - ou)
    }
    let last = h.axes[dim].edges[count - 1]
    if fu - last.fpos >= 0 {
        return last.pos + (ou - last.opos)
    }
    var low = 0
    var high = count
    if high <= 8 {
        var nn = 0
        for nn < high {
            if h.axes[dim].edges[nn].fpos >= fu {
                break
            }
            nn += 1
        }
        if h.axes[dim].edges[nn].fpos == fu {
            return h.axes[dim].edges[nn].pos
        }
        low = nn
    } else {
        for low < high {
            let mid = (high + low) >> 1
            let fpos = h.axes[dim].edges[mid].fpos
            if fu < fpos {
                high = mid
            } else if fu > fpos {
                low = mid + 1
            } else {
                return h.axes[dim].edges[mid].pos
            }
        }
    }
    let before = low - 1
    let after = low
    if h.axes[dim].edges[before].scale == 0 {
        let span = h.axes[dim].edges[after].pos - h.axes[dim].edges[before].pos
        let fspan = h.axes[dim].edges[after].fpos - h.axes[dim].edges[before].fpos
        h.axes[dim].edges[before].scale = div_fix(span, fspan)
    }
    h.axes[dim].edges[before].pos + mul_fix(fu - h.axes[dim].edges[before].fpos, h.axes[dim].edges[before].scale)
}

fn interpolate_shift(mut h: GlyphHints, first: i64, last: i64, anchor: i64) {
    let delta = h.points[anchor].u - h.points[anchor].v
    if delta == 0 {
        return
    }
    for p in first..anchor {
        h.points[p].u = h.points[p].v + delta
    }
    for p in (anchor + 1)..(last + 1) {
        h.points[p].u = h.points[p].v + delta
    }
}

fn interpolate_between(mut h: GlyphHints, first: i64, last: i64, anchor1: i64, anchor2: i64) {
    if first > last {
        return
    }
    var ref1 = anchor1
    var ref2 = anchor2
    if h.points[ref1].v > h.points[ref2].v {
        let swap = ref1
        ref1 = ref2
        ref2 = swap
    }
    let v1 = h.points[ref1].v
    let v2 = h.points[ref2].v
    let u1 = h.points[ref1].u
    let u2 = h.points[ref2].u
    let d1 = u1 - v1
    let d2 = u2 - v2
    if u1 == u2 || v1 == v2 {
        for p in first..(last + 1) {
            var u = h.points[p].v
            if u <= v1 {
                u += d1
            } else if u >= v2 {
                u += d2
            } else {
                u = u1
            }
            h.points[p].u = u
        }
    } else {
        let scale = div_fix(u2 - u1, v2 - v1)
        for p in first..(last + 1) {
            var u = h.points[p].v
            if u <= v1 {
                u += d1
            } else if u >= v2 {
                u += d2
            } else {
                u = u1 + mul_fix(u - v1, scale)
            }
            h.points[p].u = u
        }
    }
}

fn align_weak_points(mut h: GlyphHints, dim: i64) {
    let touch = if dim == horizontal { point_touch_x } else { point_touch_y }
    for i in 0..h.points.len {
        h.points[i].u = if dim == horizontal { h.points[i].x } else { h.points[i].y }
        h.points[i].v = if dim == horizontal { h.points[i].ox } else { h.points[i].oy }
    }
    for first_point in h.contours {
        align_weak_contour(mut h, first_point, touch)
    }
    for i in 0..h.points.len {
        if dim == horizontal {
            h.points[i].x = h.points[i].u
        } else {
            h.points[i].y = h.points[i].u
        }
    }
}

fn align_weak_contour(mut h: GlyphHints, first_point: i64, touch: i64) {
    let end_point = h.points[first_point].prev
    var point = first_point
    for {
        if point > end_point {
            return
        }
        if h.points[point].flags & touch != 0 {
            break
        }
        point += 1
    }
    let first_touched = point
    var last_touched = point
    for {
        for point < end_point && h.points[point + 1].flags & touch != 0 {
            point += 1
        }
        last_touched = point
        point += 1
        for {
            if point > end_point {
                finish_weak_contour(mut h, first_point, end_point, first_touched, last_touched)
                return
            }
            if h.points[point].flags & touch != 0 {
                break
            }
            point += 1
        }
        interpolate_between(mut h, last_touched + 1, point - 1, last_touched, point)
    }
}

fn finish_weak_contour(mut h: GlyphHints, first_point: i64, end_point: i64, first_touched: i64, last_touched: i64) {
    if last_touched == first_touched {
        interpolate_shift(mut h, first_point, end_point, first_touched)
        return
    }
    if last_touched < end_point {
        interpolate_between(mut h, last_touched + 1, end_point, last_touched, first_touched)
    }
    if first_touched > 0 {
        interpolate_between(mut h, first_point, first_touched - 1, last_touched, first_touched)
    }
}
