import std/ui/geometry

/// A glyph's coverage at one size, one byte per pixel from `0` to `255`, rows from the top.
pub struct Bitmap {
    /// The number of columns.
    pub width: i64
    /// The number of rows.
    pub height: i64
    /// The distance in pixels from the pen position to the left edge of the first column.
    pub left: i64
    /// The distance in pixels from the baseline down to the top edge of the first row, negative for rows above the baseline.
    pub top: i64
    /// The coverage of each pixel, `width * height` bytes.
    pub coverage: []u8
}

struct PixelBox {
    left: i64
    top: i64
    width: i64
    height: i64
}

const max_side = 2048
const reach_per_ppem = 16
const largest_size: f32 = 65536.0
const coordinate_limit: f32 = 1048576.0

/// Returns the coverage of `glyph` with the em square `pixel_size` pixels tall, the pen at the origin of an integer pixel grid.
///
/// The bitmap is the one FreeType 2.15 renders without hinting (`FT_LOAD_NO_HINTING`, `FT_RENDER_MODE_NORMAL`) at the character size `pixel_size` rounded to 1/64 pixel: the same `width`, `height`, `left`, `top` and coverage bytes for a TrueType glyph. The outline is scaled to 26.6 fixed point with FreeType's integer arithmetic, and its lines and quadratic curves are accumulated into 1/256 pixel cells that give the non-zero winding coverage, as FreeType's smooth rasteriser does. An outline that sets the overlap flag is drawn at four times the resolution and averaged.
///
/// A size below one pixel is drawn as one pixel. A glyph with no outline and a glyph the font does not have give a bitmap with no columns or rows. A `pixel_size` that is not positive or reaches 65536, a glyph wider or taller than 16 times the pixel size, and a glyph more than 2048 pixels wide or tall give an empty bitmap.
pub fn rasterize(f: Font, glyph: i64, pixel_size: f32) -> Bitmap {
    rasterize_at(f, glyph, pixel_size, 0.0)
}

/// Returns the coverage of `glyph` as `rasterize` does, with the pen `pen_x` pixels right of the origin of the pixel grid, rounded to 1/64 pixel, so a glyph placed at a fraction of a pixel keeps its shape and spacing. `left` counts from the grid's origin.
///
/// FreeType renders the same bitmap for an outline moved right by `pen_x` before it is drawn.
pub fn rasterize_at(f: Font, glyph: i64, pixel_size: f32, pen_x: f32) -> Bitmap {
    let sizes_fit = pixel_size > 0.0 && pixel_size < largest_size
    let pen_fits = pen_x > -coordinate_limit && pen_x < coordinate_limit
    if !sizes_fit || !pen_fits {
        return empty_bitmap()
    }
    let size = max_of(to_fixed(pixel_size), one_pixel)
    let phase = to_fixed(pen_x)
    let request = request_size(f, size) ?? return empty_bitmap()
    let shape = scaled_outline(f, glyph, request.scale) ?? return empty_bitmap()
    let reach = min_of(max_side, reach_per_ppem * request.ppem)
    draw(shape, phase, reach, false)
}

/// Returns the coverage of `polygons`, in pixels and each closed implicitly, filled by `rule`; `NonZero` fills as `rasterize` fills a glyph. `left` and `top` are the pixel position of the first column and row.
///
/// Each point is rounded to 1/64 pixel and its area is accumulated as FreeType's smooth rasteriser does, so a polygon's coverage is the coverage FreeType gives the same outline.
///
/// Polygons that cover nothing, or more than 2048 pixels wide or tall, or reach a point a million pixels from the origin, give an empty bitmap.
pub fn fill(polygons: [][]geometry.Point, rule: geometry.FillRule) -> Bitmap {
    let shape = polygon_outline(polygons) ?? return empty_bitmap()
    let even_odd = match rule {
        NonZero => false
        EvenOdd => true
    }
    let bitmap = draw(shape, 0, max_side, even_odd)
    if bitmap.width == 0 || bitmap.height == 0 {
        return empty_bitmap()
    }
    bitmap
}

fn empty_bitmap() -> Bitmap {
    Bitmap { width: 0, height: 0, left: 0, top: 0, coverage: [] }
}

fn to_fixed(v: f32) -> i64 {
    i64(floor(v * 64.0 + 0.5))
}

fn polygon_outline(polygons: [][]geometry.Point) -> ScaledOutline? {
    var points: []ScaledPoint = []
    var ends: []i64 = []
    for polygon in polygons {
        if polygon.len == 0 {
            continue
        }
        for p in polygon {
            let inside = p.x > -coordinate_limit && p.x < coordinate_limit && p.y > -coordinate_limit && p.y < coordinate_limit
            if !inside {
                return none
            }
            let x = to_fixed(p.x)
            let y = -to_fixed(p.y)
            points.push(ScaledPoint { x, y, on_curve: true })
        }
        ends.push(points.len - 1)
    }
    ScaledOutline { points, ends, overlap: false }
}

fn draw(shape: ScaledOutline, phase: i64, reach: i64, even_odd: bool) -> Bitmap {
    let placed = translated(shape, phase, 0)
    let box = pixel_box(placed)
    if box.width > reach || box.height > reach {
        return empty_bitmap()
    }
    let top = -box.top
    if box.width == 0 || box.height == 0 {
        return Bitmap { width: box.width, height: box.height, left: box.left, top, coverage: [] }
    }
    let bottom = box.top - box.height
    let grid = translated(placed, -box.left * one_pixel, -bottom * one_pixel)
    let coverage = render_coverage(grid, box.width, box.height, even_odd)
    Bitmap { width: box.width, height: box.height, left: box.left, top, coverage }
}

fn pixel_box(shape: ScaledOutline) -> PixelBox {
    if shape.points.len == 0 {
        return PixelBox { left: 0, top: 0, width: 0, height: 0 }
    }
    var x_min = shape.points[0].x
    var x_max = x_min
    var y_min = shape.points[0].y
    var y_max = y_min
    for p in shape.points {
        x_min = min_of(x_min, p.x)
        x_max = max_of(x_max, p.x)
        y_min = min_of(y_min, p.y)
        y_max = max_of(y_max, p.y)
    }
    let left = x_min >> 6
    let right = (x_max + 63) >> 6
    let bottom = y_min >> 6
    let top = (y_max + 63) >> 6
    PixelBox { left, top, width: right - left, height: top - bottom }
}
