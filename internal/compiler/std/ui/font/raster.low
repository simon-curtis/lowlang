import std/ui/geometry

/// A glyph's coverage at one size, one byte per pixel from `0` to `255`, rows from the top.
pub struct Bitmap {
    /// The number of columns.
    pub width: i64
    /// The number of rows.
    pub height: i64
    /// The distance in pixels from the pen position to the left edge of the first column.
    pub left: i64
    /// The distance in pixels from the baseline down to the top edge of the first row, negative for rows above the baseline.
    pub top: i64
    /// The coverage of each pixel, `width * height` bytes.
    pub coverage: []u8
}

struct Space {
    scale: f32
    left: f32
    top: f32
}

struct Canvas {
    width: i64
    height: i64
    cells: []f32
}

struct Walk {
    at: geometry.Point
    control: geometry.Point
    pending: bool
}

fn max_side() -> i64 {
    2048
}

fn flatness() -> f32 {
    0.05
}

/// Returns the coverage of `glyph` with the em square `pixel_size` pixels tall, the pen at the origin of an integer pixel grid.
///
/// The outline is flattened into lines, each of which adds its signed area and cover to the pixels it crosses; a running sum along each row then gives the winding coverage, clamped to full.
///
/// A glyph with no outline, a `pixel_size` that is not positive and a glyph more than 2048 pixels wide or tall give an empty bitmap.
pub fn rasterize(f: Font, glyph: i64, pixel_size: f32) -> Bitmap {
    if !(pixel_size > 0.0) {
        return empty_bitmap()
    }
    let shape = outline(f, glyph)
    let s = scale(f, pixel_size)
    let box = bounds(shape, s)
    let left = i64(floor(box.x))
    let top = i64(floor(box.y))
    let width = ceil_i(box.x + box.width) - left
    let height = ceil_i(box.y + box.height) - top
    if width <= 0 || height <= 0 || width > max_side() || height > max_side() {
        return empty_bitmap()
    }
    var canvas = Canvas { width, height, cells: __make(width * height + 4) }
    let space = Space { scale: s, left: f32(left), top: f32(top) }
    for c in shape.contours {
        trace(mut canvas, c, space)
    }
    Bitmap { width, height, left, top, coverage: resolve(canvas, NonZero) }
}

/// Returns the coverage of `polygons`, in pixels and each closed implicitly, filled by `rule`; `NonZero` fills as `rasterize` fills a glyph. `left` and `top` are the pixel position of the first column and row.
///
/// Polygons that cover nothing, or more than 2048 pixels wide or tall, give an empty bitmap.
pub fn fill(polygons: [][]geometry.Point, rule: geometry.FillRule) -> Bitmap {
    var box = geometry.Rect {}
    var seen = false
    for poly in polygons {
        for p in poly {
            let dot = geometry.rect(p.x, p.y, 0.0, 0.0)
            box = if seen { geometry.union(box, dot) } else { dot }
            seen = true
        }
    }
    let left = i64(floor(box.x))
    let top = i64(floor(box.y))
    let width = ceil_i(box.x + box.width) - left
    let height = ceil_i(box.y + box.height) - top
    if width <= 0 || height <= 0 || width > max_side() || height > max_side() {
        return empty_bitmap()
    }
    var canvas = Canvas { width, height, cells: __make(width * height + 4) }
    for poly in polygons {
        let n = poly.len
        for i, p in poly {
            let q = poly[(i + 1) % n]
            line(mut canvas, geometry.point(p.x - f32(left), p.y - f32(top)), geometry.point(q.x - f32(left), q.y - f32(top)))
        }
    }
    Bitmap { width, height, left, top, coverage: resolve(canvas, rule) }
}

fn empty_bitmap() -> Bitmap {
    Bitmap { width: 0, height: 0, left: 0, top: 0, coverage: [] }
}

fn bounds(shape: Outline, s: f32) -> geometry.Rect {
    var x0: f32 = 0.0
    var y0: f32 = 0.0
    var x1: f32 = 0.0
    var y1: f32 = 0.0
    var seen = false
    for c in shape.contours {
        for p in c.points {
            let x = p.x * s
            let y = -p.y * s
            if !seen || x < x0 {
                x0 = x
            }
            if !seen || x > x1 {
                x1 = x
            }
            if !seen || y < y0 {
                y0 = y
            }
            if !seen || y > y1 {
                y1 = y
            }
            seen = true
        }
    }
    geometry.rect(x0, y0, x1 - x0, y1 - y0)
}

fn ceil_i(v: f32) -> i64 {
    let whole = i64(floor(v))
    if f32(whole) < v {
        whole + 1
    } else {
        whole
    }
}

fn pixel(sp: Space, p: Point) -> geometry.Point {
    geometry.point(p.x * sp.scale - sp.left, -p.y * sp.scale - sp.top)
}

fn midpoint(a: geometry.Point, b: geometry.Point) -> geometry.Point {
    geometry.point((a.x + b.x) * 0.5, (a.y + b.y) * 0.5)
}

fn trace(mut cv: Canvas, c: Contour, sp: Space) {
    let n = c.points.len
    if n < 2 {
        return
    }
    var first = 0
    for first < n && !c.points[first].on_curve {
        first += 1
    }
    var walk = Walk { at: pixel(sp, c.points[0]), control: geometry.point(0.0, 0.0), pending: false }
    var from = 0
    var count = n
    if first < n {
        walk.at = pixel(sp, c.points[first])
        from = first + 1
        count = n - 1
    } else {
        let last = pixel(sp, c.points[n - 1])
        walk.at = midpoint(last, walk.at)
    }
    let start = walk.at
    for k in 0..count {
        let q = c.points[(from + k) % n]
        let target = pixel(sp, q)
        step(mut cv, mut walk, target, q.on_curve)
    }
    if walk.pending {
        curve(mut cv, walk.at, walk.control, start)
    } else {
        line(mut cv, walk.at, start)
    }
}

fn step(mut cv: Canvas, mut walk: Walk, q: geometry.Point, on_curve: bool) {
    if on_curve {
        if walk.pending {
            curve(mut cv, walk.at, walk.control, q)
        } else {
            line(mut cv, walk.at, q)
        }
        walk.at = q
        walk.pending = false
    } else if walk.pending {
        let mid = midpoint(walk.control, q)
        curve(mut cv, walk.at, walk.control, mid)
        walk.at = mid
        walk.control = q
    } else {
        walk.control = q
        walk.pending = true
    }
}

fn curve(mut cv: Canvas, p0: geometry.Point, c: geometry.Point, p2: geometry.Point) {
    let dx = p0.x - 2.0 * c.x + p2.x
    let dy = p0.y - 2.0 * c.y + p2.y
    var n = i64(sqrt(sqrt(dx * dx + dy * dy) / (4.0 * flatness()))) + 1
    if n > 64 {
        n = 64
    }
    var previous = p0
    for i in 1..n + 1 {
        let t = f32(i) / f32(n)
        let u = 1.0 - t
        let next = geometry.point(u * u * p0.x + 2.0 * u * t * c.x + t * t * p2.x, u * u * p0.y + 2.0 * u * t * c.y + t * t * p2.y)
        line(mut cv, previous, next)
        previous = next
    }
}

fn clamp(v: f32, hi: f32) -> f32 {
    if v < 0.0 {
        0.0
    } else if v > hi {
        hi
    } else {
        v
    }
}

fn line(mut cv: Canvas, a: geometry.Point, b: geometry.Point) {
    let w = f32(cv.width)
    let h = f32(cv.height)
    var x0 = clamp(a.x, w)
    var y0 = clamp(a.y, h)
    var x1 = clamp(b.x, w)
    var y1 = clamp(b.y, h)
    if y0 == y1 {
        return
    }
    var dir: f32 = 1.0
    if y0 > y1 {
        dir = -1.0
        let tx = x0
        let ty = y0
        x0 = x1
        y0 = y1
        x1 = tx
        y1 = ty
    }
    let dxdy = (x1 - x0) / (y1 - y0)
    var x = x0
    for row in i64(y0)..ceil_i(y1) {
        let top = if f32(row) > y0 { f32(row) } else { y0 }
        let bottom = if f32(row + 1) < y1 { f32(row + 1) } else { y1 }
        let dy = bottom - top
        let next = x + dxdy * dy
        cover(mut cv, row * cv.width, x, next, dy * dir)
        x = next
    }
}

fn cover(mut cv: Canvas, start: i64, xa: f32, xb: f32, d: f32) {
    let lo = if xa < xb { xa } else { xb }
    let hi = if xa < xb { xb } else { xa }
    let lo_floor = floor(lo)
    let lo_i = i64(lo_floor)
    let hi_i = ceil_i(hi)
    if hi_i <= lo_i + 1 {
        let mid = 0.5 * (xa + xb) - lo_floor
        cv.cells[start + lo_i] += d - d * mid
        cv.cells[start + lo_i + 1] += d * mid
        return
    }
    let inverse = 1.0 / (hi - lo)
    let lo_frac = lo - lo_floor
    let first = 0.5 * inverse * (1.0 - lo_frac) * (1.0 - lo_frac)
    let hi_frac = hi - f32(hi_i) + 1.0
    let last = 0.5 * inverse * hi_frac * hi_frac
    cv.cells[start + lo_i] += d * first
    if hi_i == lo_i + 2 {
        cv.cells[start + lo_i + 1] += d * (1.0 - first - last)
    } else {
        let second = inverse * (1.5 - lo_frac)
        cv.cells[start + lo_i + 1] += d * (second - first)
        for x in lo_i + 2..hi_i - 1 {
            cv.cells[start + x] += d * inverse
        }
        let before_last = second + f32(hi_i - lo_i - 3) * inverse
        cv.cells[start + hi_i - 1] += d * (1.0 - before_last - last)
    }
    cv.cells[start + hi_i] += d * last
}

fn resolve(cv: Canvas, rule: geometry.FillRule) -> []u8 {
    var out: []u8 = __make(cv.width * cv.height)
    var sum: f32 = 0.0
    for i in 0..out.len {
        sum += cv.cells[i]
        let winding = if sum < 0.0 { -sum } else { sum }
        let v = match rule {
            NonZero => winding
            EvenOdd => alternate(winding)
        }
        out[i] = u8((if v > 1.0 { 1.0 } else { v }) * 255.0 + 0.5)
    }
    out
}

fn alternate(winding: f32) -> f32 {
    let folded = winding - 2.0 * floor(winding * 0.5)
    if folded > 1.0 { 2.0 - folded } else { folded }
}
