const style_nonbase = 0x4000

fn latin_hints_init(m: StyleMetrics) -> GlyphHints {
    var h = new_hints(m)
    h.x_scale = m.axes[horizontal].scale
    h.x_delta = m.axes[horizontal].delta
    h.y_scale = m.axes[vertical].scale
    h.y_delta = m.axes[vertical].delta
    h.scaler_flags = m.scaler.flags | scaler_no_horizontal
    h.other_flags = 0
    h
}

fn latin_hints_apply(mut h: GlyphHints, loaded: ScaledOutline, glyph_style: i64, adj_type: i64) -> ScaledOutline {
    reload(mut h, loaded)
    let is_top_tilde = adj_type & adjust_tilde_top != 0
    let is_bottom_tilde = adj_type & adjust_tilde_bottom != 0
    let is_below_top_tilde = adj_type & adjust_tilde_top2 != 0
    let is_above_bottom_tilde = adj_type & adjust_tilde_bottom2 != 0
    if is_top_tilde || is_bottom_tilde || is_below_top_tilde || is_above_bottom_tilde {
        compute_vertical_extrema(mut h)
    }
    if is_below_top_tilde {
        let contour = find_second_highest_contour(h)
        var y_offset = stretch_top_tilde(mut h, contour)
        y_offset += align_top_tilde(mut h, contour)
        let limit = h.contour_y_minima[contour]
        move_contours_up(mut h, limit, y_offset)
    }
    if is_above_bottom_tilde {
        let contour = find_second_lowest_contour(h)
        var y_offset = stretch_bottom_tilde(mut h, contour)
        y_offset -= align_bottom_tilde(mut h, contour)
        let limit = h.contour_y_maxima[contour]
        move_contours_down(mut h, limit, y_offset)
    }
    if is_top_tilde {
        let contour = find_highest_contour(h)
        stretch_top_tilde(mut h, contour)
        align_top_tilde(mut h, contour)
    }
    if is_bottom_tilde {
        let contour = find_lowest_contour(h)
        stretch_bottom_tilde(mut h, contour)
        align_bottom_tilde(mut h, contour)
    }
    latin_detect_features(mut h, h.metrics.axes[vertical].widths)
    let blues = h.metrics.axes[vertical].blues
    let capital_top = base_glyph_blue(blues, blue_top | blue_active)
    let capital_bottom = base_glyph_blue(blues, blue_bottom | blue_active)
    let small_top = base_glyph_blue(blues, blue_adjustment | blue_active)
    let small_bottom = base_glyph_blue(blues, blue_bottom_small | blue_active)
    var accent_height_limit = 0
    if adj_type != 0 && adj_type & adjust_no_height_check == 0 {
        if small_top >= 0 && small_bottom >= 0 {
            accent_height_limit = 2 * (blues[small_top].shoot.cur - blues[small_bottom].shoot.cur) / 3
        } else if capital_top >= 0 && capital_bottom >= 0 {
            accent_height_limit = (blues[capital_top].shoot.cur - blues[capital_bottom].shoot.cur) / 2
        } else {
            accent_height_limit = mul_fix(h.metrics.units_per_em * 4 / 10, h.metrics.scaler.y_scale)
        }
    }
    let have_capital = adj_type != 0 && capital_top >= 0 && capital_bottom >= 0
    if have_capital {
        if adj_type & ignore_capital_top != 0 {
            ignore_top(mut h, blues[capital_top], blues[capital_bottom])
        }
        if adj_type & ignore_capital_bottom != 0 {
            ignore_bottom(mut h, blues[capital_top], blues[capital_bottom])
        }
    }
    let have_small = adj_type != 0 && small_top >= 0 && small_bottom >= 0
    if have_small {
        if adj_type & ignore_small_top != 0 {
            ignore_top(mut h, blues[small_top], blues[small_bottom])
        }
        if adj_type & ignore_small_bottom != 0 {
            ignore_bottom(mut h, blues[small_top], blues[small_bottom])
        }
    }
    if glyph_style & style_nonbase == 0 {
        latin_compute_blue_edges(mut h)
    }
    latin_hint_edges(mut h)
    align_edge_points(mut h, vertical)
    align_strong_points(mut h, vertical)
    align_weak_points(mut h, vertical)
    if adj_type != 0 {
        apply_vertical_separation_adjustments(mut h, adj_type, accent_height_limit)
    }
    save(h, loaded)
}
