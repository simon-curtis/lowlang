/// A glyph that substitution leaves, with the input glyphs it replaces.
pub struct Substituted {
    /// The glyph to draw.
    pub glyph: i64
    /// The index in the input of the first glyph it replaces.
    pub first: i64
    /// The index in the input just past the last glyph it replaces. A glyph that replaces one input glyph has `end` one more than `first`; a ligature of three has `end` three more.
    pub end: i64
}

struct Match {
    glyph: i64
    count: i64
}

fn no_match() -> Match {
    Match { glyph: 0, count: 0 }
}

/// Applies the glyph substitutions of the font's `GSUB` table to `glyphs`, which are adjacent glyphs of one run, and returns the glyphs left, each with the range of input glyphs it replaces. The ranges are in order, adjacent and cover every input glyph.
///
/// The features are chosen as for `kern`: the `latn` script, else `DFLT`, else the first, in its default language system. The lookups of `ccmp` run first, in lookup order, then those of `rlig`, `liga` and `clig` together in lookup order. Each lookup runs over the whole sequence, left to right, and replaces what it matches before the next lookup runs. Single substitutions (type 1), ligature substitutions (type 4) and extension lookups (type 7) holding either are applied; the other types and the lookup flags are ignored, so a ligature forms only from glyphs that are next to each other. A ligature or substitute outside the font's glyphs, and a subtable with a malformed offset, are skipped. A font with no such lookups returns each glyph unchanged.
pub fn substitute(f: Font, glyphs: []i64) -> []Substituted {
    var buffer: []Substituted = []
    for i, glyph in glyphs {
        buffer.push(Substituted { glyph, first: i, end: i + 1 })
    }
    for lookup in f.ccmp_lookups {
        buffer = substituted_by(f, lookup, buffer)
    }
    for lookup in f.liga_lookups {
        buffer = substituted_by(f, lookup, buffer)
    }
    buffer
}

fn substituted_by(f: Font, lookup: i64, buffer: []Substituted) -> []Substituted {
    var out: []Substituted = []
    var i = 0
    for i < buffer.len {
        let m = match_at(f.data, lookup, buffer, i)
        if m.count == 0 || m.glyph >= f.glyph_count {
            out.push(buffer[i])
            i += 1
            continue
        }
        let last = buffer[i + m.count - 1]
        out.push(Substituted { glyph: m.glyph, first: buffer[i].first, end: last.end })
        i += m.count
    }
    out
}

fn match_at(data: str, lookup: i64, buffer: []Substituted, i: i64) -> Match {
    for k in 0..be16(data, lookup + 4) {
        let s = resolve_subtable(data, lookup, k, 7)
        var m = no_match()
        if s.kind == 1 {
            m = single_match(data, s.at, buffer[i].glyph)
        } else if s.kind == 4 {
            m = ligature_match(data, s.at, buffer, i)
        }
        if m.count > 0 {
            return m
        }
    }
    no_match()
}

fn single_match(data: str, subtable: i64, glyph: i64) -> Match {
    let format = be16(data, subtable)
    let coverage = be16(data, subtable + 2)
    if (format != 1 && format != 2) || coverage == 0 {
        return no_match()
    }
    let index = coverage_index(data, subtable + coverage, glyph)
    if index < 0 {
        return no_match()
    }
    if format == 1 {
        return Match { glyph: (glyph + be16_signed(data, subtable + 4)) & 65535, count: 1 }
    }
    if index >= be16(data, subtable + 4) {
        return no_match()
    }
    Match { glyph: be16(data, subtable + 6 + 2 * index), count: 1 }
}

fn ligature_match(data: str, subtable: i64, buffer: []Substituted, i: i64) -> Match {
    let coverage = be16(data, subtable + 2)
    if be16(data, subtable) != 1 || coverage == 0 {
        return no_match()
    }
    let index = coverage_index(data, subtable + coverage, buffer[i].glyph)
    if index < 0 || index >= be16(data, subtable + 4) {
        return no_match()
    }
    let offset = be16(data, subtable + 6 + 2 * index)
    if offset == 0 {
        return no_match()
    }
    let set = subtable + offset
    for j in 0..be16(data, set) {
        let ligature = be16(data, set + 2 + 2 * j)
        if ligature == 0 {
            continue
        }
        let m = ligature_at(data, set + ligature, buffer, i)
        if m.count > 0 {
            return m
        }
    }
    no_match()
}

fn ligature_at(data: str, ligature: i64, buffer: []Substituted, i: i64) -> Match {
    let count = be16(data, ligature + 2)
    if count < 1 || i + count > buffer.len {
        return no_match()
    }
    for c in 1..count {
        if be16(data, ligature + 2 + 2 * c) != buffer[i + c].glyph {
            return no_match()
        }
    }
    Match { glyph: be16(data, ligature), count }
}
