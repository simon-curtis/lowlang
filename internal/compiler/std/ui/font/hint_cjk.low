const light_mode_max_horizontal_gap = 9
const light_mode_max_vertical_gap = 15
const light_mode_max_delta = 14

fn cjk_hints_init(m: StyleMetrics) -> GlyphHints {
    var h = new_hints(m)
    h.x_scale = m.axes[horizontal].scale
    h.x_delta = m.axes[horizontal].delta
    h.y_scale = m.axes[vertical].scale
    h.y_delta = m.axes[vertical].delta
    h.scaler_flags = m.scaler.flags | scaler_no_advance
    h.other_flags = 0
    h
}

fn cjk_link_segments(mut h: GlyphHints, dim: i64) {
    let segments = h.axes[dim].segments
    let major_dir = h.axes[dim].major_dir
    let count = segments.len
    let len_threshold = latin_constant(h.metrics.units_per_em, 8)
    let scale = if dim == horizontal { h.x_scale } else { h.y_scale }
    let dist_threshold = div_fix(64 * 3, scale)
    for s1 in 0..count {
        if segments[s1].dir != major_dir {
            continue
        }
        for s2 in 0..count {
            if s2 == s1 || segments[s1].dir + segments[s2].dir != 0 {
                continue
            }
            let dist = segments[s2].pos - segments[s1].pos
            if dist < 0 {
                continue
            }
            let low = max_of(segments[s1].min_coord, segments[s2].min_coord)
            let high = min_of(segments[s1].max_coord, segments[s2].max_coord)
            let length = high - low
            if length < len_threshold {
                continue
            }
            if dist * 8 < segments[s1].score * 9 && (dist * 8 < segments[s1].score * 7 || segments[s1].length < length) {
                segments[s1].score = dist
                segments[s1].length = length
                segments[s1].link = s2
            }
            if dist * 8 < segments[s2].score * 9 && (dist * 8 < segments[s2].score * 7 || segments[s2].length < length) {
                segments[s2].score = dist
                segments[s2].length = length
                segments[s2].link = s1
            }
        }
    }
    for s1 in 0..count {
        let link1 = segments[s1].link
        if link1 < 0 || segments[link1].link != s1 || segments[link1].pos <= segments[s1].pos {
            continue
        }
        if segments[s1].score >= dist_threshold {
            continue
        }
        for s2 in 0..count {
            if segments[s2].pos > segments[s1].pos || s1 == s2 {
                continue
            }
            let link2 = segments[s2].link
            if link2 < 0 || segments[link2].link != s2 || segments[link2].pos < segments[link1].pos {
                continue
            }
            if segments[s1].pos == segments[s2].pos && segments[link1].pos == segments[link2].pos {
                continue
            }
            if segments[s2].score <= segments[s1].score || segments[s1].score * 4 <= segments[s2].score {
                continue
            }
            if segments[s1].length >= segments[s2].length * 3 {
                for s in 0..count {
                    let link = segments[s].link
                    if link == s2 {
                        segments[s].link = -1
                        segments[s].serif = link1
                    } else if link == link2 {
                        segments[s].link = -1
                        segments[s].serif = s1
                    }
                }
            } else {
                segments[s1].link = -1
                segments[link1].link = -1
                break
            }
        }
    }
    for s1 in 0..count {
        let s2 = segments[s1].link
        if s2 < 0 || segments[s2].link == s1 {
            continue
        }
        segments[s1].link = -1
        if segments[s2].score < dist_threshold || segments[s1].score < segments[s2].score * 4 {
            segments[s1].serif = segments[s2].link
        }
    }
}

fn cjk_nearest_edge(h: GlyphHints, dim: i64, s: i64, threshold: i64) -> i64 {
    let segments = h.axes[dim].segments
    let edges = h.axes[dim].edges
    let seg = segments[s]
    var found = -1
    var best = 0xFFFF
    for ee in 0..edges.len {
        let edge = edges[ee]
        if edge.dir != seg.dir {
            continue
        }
        let dist = magnitude(seg.pos - edge.fpos)
        if dist >= threshold || dist >= best {
            continue
        }
        if seg.link >= 0 {
            var walk = edge.first
            var link_dist = 0
            for {
                let link1 = segments[walk].link
                if link1 >= 0 {
                    link_dist = magnitude(segments[seg.link].pos - segments[link1].pos)
                    if link_dist >= threshold {
                        break
                    }
                }
                walk = segments[walk].edge_next
                if walk == edge.first {
                    break
                }
            }
            if link_dist >= threshold {
                continue
            }
        }
        best = dist
        found = ee
    }
    found
}

fn cjk_compute_edges(mut h: GlyphHints, dim: i64) {
    let scale = if dim == horizontal { h.x_scale } else { h.y_scale }
    let axis_threshold = h.metrics.axes[dim].edge_distance_threshold
    var threshold = axis_threshold
    if mul_fix(axis_threshold, scale) > 64 / 4 {
        threshold = div_fix(64 / 4, scale)
    }
    h.axes[dim].edges = []
    for s in 0..h.axes[dim].segments.len {
        let seg = h.axes[dim].segments[s]
        let found = cjk_nearest_edge(h, dim, s, threshold)
        if found < 0 {
            let at = insert_edge(mut h, dim, seg.pos, seg.dir, false)
            let opos = mul_fix(seg.pos, scale)
            h.axes[dim].edges[at] = Edge { first: s, last: s, dir: seg.dir, fpos: seg.pos, opos, pos: opos }
            h.axes[dim].segments[s].edge_next = s
        } else {
            append_segment(mut h, dim, found, s)
        }
    }
    attach_segments_to_edges(mut h, dim)
    link_edges(mut h, dim)
}

fn cjk_detect_features(mut h: GlyphHints, dim: i64) {
    latin_compute_segments(mut h, dim)
    cjk_link_segments(mut h, dim)
    cjk_compute_edges(mut h, dim)
}

fn cjk_compute_blue_edges(mut h: GlyphHints, dim: i64) {
    let axis = h.metrics.axes[dim]
    let scale = axis.scale
    let major_dir = h.axes[dim].major_dir
    var initial_distance = mul_fix(h.metrics.units_per_em / 40, scale)
    if initial_distance > 64 / 2 {
        initial_distance = 64 / 2
    }
    for ee in 0..h.axes[dim].edges.len {
        let edge = h.axes[dim].edges[ee]
        var best_blue = -1
        var best_dist = initial_distance
        for bb in 0..axis.blues.len {
            let blue = axis.blues[bb]
            if blue.flags & blue_active == 0 {
                continue
            }
            let is_top_right = blue.flags & blue_top != 0
            let is_major_dir = edge.dir == major_dir
            if is_top_right == is_major_dir {
                continue
            }
            var code = 2 * bb
            var org = blue.ref.org
            if magnitude(edge.fpos - blue.ref.org) > magnitude(edge.fpos - blue.shoot.org) {
                code = 2 * bb + 1
                org = blue.shoot.org
            }
            let dist = mul_fix(magnitude(edge.fpos - org), scale)
            if dist < best_dist {
                best_dist = dist
                best_blue = code
            }
        }
        if best_blue >= 0 {
            h.axes[dim].edges[ee].blue = best_blue
        }
    }
}

fn cjk_align_linked_edge(edges: []Edge, base: i64, stem: i64) {
    let dist = edges[stem].opos - edges[base].opos
    edges[stem].pos = edges[base].pos + dist
}

fn cjk_align_serif_edge(edges: []Edge, base: i64, serif: i64) {
    edges[serif].pos = edges[base].pos + (edges[serif].opos - edges[base].opos)
}

fn normal_stem_threshold(rounded: bool, dim: i64) -> i64 {
    let gap = if dim == vertical { light_mode_max_horizontal_gap } else { light_mode_max_vertical_gap }
    if rounded {
        64 - gap
    } else {
        64 - gap / 3
    }
}

fn normal_stem_delta(cur_len: i64, cur_pos1: i64, threshold: i64) -> i64 {
    let cur_pos2 = cur_pos1 + cur_len
    var d_off1 = cur_pos1 - pix_floor(cur_pos1)
    var d_off2 = cur_pos2 - pix_floor(cur_pos2)
    var u_off1 = 64 - d_off1
    var u_off2 = 64 - d_off2
    if d_off1 == 0 || d_off2 == 0 {
        return 0
    }
    if cur_len <= threshold {
        if d_off2 < cur_len {
            if u_off1 <= d_off2 {
                return u_off1
            }
            return -d_off2
        }
        return 0
    }
    if threshold < 64 {
        if d_off1 >= threshold || u_off1 >= threshold || d_off2 >= threshold || u_off2 >= threshold {
            return 0
        }
    }
    var offset = cur_len & 63
    if offset < 32 {
        if u_off1 <= offset || d_off2 <= offset {
            return 0
        }
    } else {
        offset = 64 - threshold
    }
    d_off1 = threshold - u_off1
    u_off1 = u_off1 - offset
    u_off2 = threshold - d_off2
    d_off2 = d_off2 - offset
    if d_off1 <= u_off1 {
        u_off1 = -d_off1
    }
    if d_off2 <= u_off2 {
        u_off2 = -d_off2
    }
    if magnitude(u_off1) <= magnitude(u_off2) {
        return u_off1
    }
    u_off2
}

fn cjk_hint_normal_stem(edges: []Edge, e: i64, e2: i64, anchor: i64, dim: i64) -> i64 {
    let rounded = edges[e].flags & edge_round != 0 && edges[e2].flags & edge_round != 0
    let threshold = normal_stem_threshold(rounded, dim)
    let cur_len = edges[e2].opos - edges[e].opos
    let org_center = (edges[e].opos + edges[e2].opos) / 2 + anchor
    var cur_pos1 = org_center - cur_len / 2
    var delta = normal_stem_delta(cur_len, cur_pos1, threshold)
    if delta > light_mode_max_delta {
        delta = light_mode_max_delta
    } else if delta < -light_mode_max_delta {
        delta = -light_mode_max_delta
    }
    cur_pos1 += delta
    if edges[e].opos < edges[e2].opos {
        edges[e].pos = cur_pos1
        edges[e2].pos = cur_pos1 + cur_len
    } else {
        edges[e].pos = cur_pos1 + cur_len
        edges[e2].pos = cur_pos1
    }
    delta
}

fn cjk_hint_blue_edges(edges: []Edge, blues: []Blue) -> i64 {
    var anchor = -1
    for e in 0..edges.len {
        if edges[e].flags & edge_done != 0 {
            continue
        }
        var edge1 = -1
        var edge2 = edges[e].link
        var blue = edges[e].blue
        if blue >= 0 {
            edge1 = e
        } else if edge2 >= 0 && edges[edge2].blue >= 0 {
            blue = edges[edge2].blue
            edge1 = edge2
            edge2 = e
        }
        if edge1 < 0 {
            continue
        }
        edges[edge1].pos = blue_fit(blues, blue)
        edges[edge1].flags |= edge_done
        if edge2 >= 0 && edges[edge2].blue < 0 {
            cjk_align_linked_edge(edges, edge1, edge2)
            edges[edge2].flags |= edge_done
        }
        if anchor < 0 {
            anchor = e
        }
    }
    anchor
}

fn cjk_hint_stems(edges: []Edge, first_anchor: i64, dim: i64) -> i64 {
    var anchor = first_anchor
    var delta = 0
    var skipped = 0
    var has_last_stem = false
    var last_stem_pos = 0
    for e in 0..edges.len {
        if edges[e].flags & edge_done != 0 {
            continue
        }
        let edge2 = edges[e].link
        if edge2 < 0 {
            skipped += 1
            continue
        }
        if has_last_stem && (edges[e].pos < last_stem_pos + 64 || edges[edge2].pos < last_stem_pos + 64) {
            skipped += 1
            continue
        }
        if edges[edge2].blue >= 0 {
            cjk_align_linked_edge(edges, edge2, e)
            edges[e].flags |= edge_done
            continue
        }
        if edge2 < e {
            cjk_align_linked_edge(edges, edge2, e)
            edges[e].flags |= edge_done
            has_last_stem = true
            last_stem_pos = edges[e].pos
            continue
        }
        if dim != vertical && anchor < 0 {
            delta = cjk_hint_normal_stem(edges, e, edge2, 0, horizontal)
        } else {
            cjk_hint_normal_stem(edges, e, edge2, delta, dim)
        }
        anchor = e
        edges[e].flags |= edge_done
        edges[edge2].flags |= edge_done
        has_last_stem = true
        last_stem_pos = edges[edge2].pos
    }
    skipped
}

fn cjk_align_symmetric_stems(edges: []Edge) {
    let count = edges.len
    var edge1 = 0
    var edge2 = 0
    var edge3 = 0
    if count == 6 {
        edge1 = 0
        edge2 = 2
        edge3 = 4
    } else {
        edge1 = 1
        edge2 = 5
        edge3 = 9
    }
    let dist1 = edges[edge2].opos - edges[edge1].opos
    let dist2 = edges[edge3].opos - edges[edge2].opos
    let span = magnitude(dist1 - dist2)
    if edges[edge1].link == edge1 + 1 && edges[edge2].link == edge2 + 1 && edges[edge3].link == edge3 + 1 && span < 8 {
        let delta = edges[edge3].pos - (2 * edges[edge2].pos - edges[edge1].pos)
        edges[edge3].pos -= delta
        if edges[edge3].link >= 0 {
            edges[edges[edge3].link].pos -= delta
        }
        if count == 12 {
            edges[8].pos -= delta
            edges[11].pos -= delta
        }
        edges[edge3].flags |= edge_done
        if edges[edge3].link >= 0 {
            edges[edges[edge3].link].flags |= edge_done
        }
    }
}

fn cjk_hint_remaining_edges(edges: []Edge, first_skipped: i64) {
    var skipped = first_skipped
    let count = edges.len
    for e in 0..count {
        if edges[e].flags & edge_done != 0 {
            continue
        }
        if edges[e].serif >= 0 {
            cjk_align_serif_edge(edges, edges[e].serif, e)
            edges[e].flags |= edge_done
            skipped -= 1
        }
    }
    if skipped == 0 {
        return
    }
    for e in 0..count {
        if edges[e].flags & edge_done != 0 {
            continue
        }
        var before = e - 1
        for before >= 0 {
            if edges[before].flags & edge_done != 0 {
                break
            }
            before -= 1
        }
        var after = e + 1
        for after < count {
            if edges[after].flags & edge_done != 0 {
                break
            }
            after += 1
        }
        if before < 0 && after >= count {
            continue
        }
        if before < 0 {
            cjk_align_serif_edge(edges, after, e)
        } else if after >= count {
            cjk_align_serif_edge(edges, before, e)
        } else if edges[after].fpos == edges[before].fpos {
            edges[e].pos = edges[before].pos
        } else {
            edges[e].pos = edges[before].pos + mul_div(edges[e].fpos - edges[before].fpos, edges[after].pos - edges[before].pos, edges[after].fpos - edges[before].fpos)
        }
    }
}

fn cjk_hint_edges(mut h: GlyphHints, dim: i64) {
    let edges = h.axes[dim].edges
    let blues = h.metrics.axes[dim].blues
    let anchor = cjk_hint_blue_edges(edges, blues)
    let skipped = cjk_hint_stems(edges, anchor, dim)
    if dim == horizontal && (edges.len == 6 || edges.len == 12) {
        cjk_align_symmetric_stems(edges)
    }
    if skipped != 0 {
        cjk_hint_remaining_edges(edges, skipped)
    }
}

fn cjk_align_edge_points(mut h: GlyphHints, dim: i64) {
    let touch = if dim == horizontal { point_touch_x } else { point_touch_y }
    for ee in 0..h.axes[dim].edges.len {
        let edge = h.axes[dim].edges[ee]
        let delta = edge.pos - edge.opos
        var seg = edge.first
        for {
            let last = h.axes[dim].segments[seg].last
            var point = h.axes[dim].segments[seg].first
            for {
                if dim == horizontal {
                    h.points[point].x += delta
                } else {
                    h.points[point].y += delta
                }
                h.points[point].flags |= touch
                if point == last {
                    break
                }
                point = h.points[point].next
            }
            seg = h.axes[dim].segments[seg].edge_next
            if seg == edge.first {
                break
            }
        }
    }
}

fn cjk_hints_apply(mut h: GlyphHints, loaded: ScaledOutline) -> ScaledOutline {
    reload(mut h, loaded)
    for dim in 0..2 {
        if is_hinted(h, dim) {
            cjk_detect_features(mut h, dim)
            cjk_compute_blue_edges(mut h, dim)
        }
    }
    for dim in 0..2 {
        if is_hinted(h, dim) {
            cjk_hint_edges(mut h, dim)
            cjk_align_edge_points(mut h, dim)
            align_strong_points(mut h, dim)
            align_weak_points(mut h, dim)
        }
    }
    save(h, loaded)
}
