struct Index {
    count: i64 = 0
    offsets: i64 = 0
    off_size: i64 = 0
    base: i64 = 0
    end: i64 = 0
}

struct Cff {
    charstrings: Index = Index {}
    gsubrs: Index = Index {}
    locals: []Index = []
    fd_select: i64 = 0
}

struct Machine {
    data: str
    gsubrs: Index
    local: Index
    stack: []f32 = []
    contours: []Contour = []
    points: []Point = []
    x: f32 = 0.0
    y: f32 = 0.0
    stems: i64 = 0
    width_done: bool = false
    ended: bool = false
    broken: bool = false
    budget: i64 = 0
}

fn max_stack() -> i64 {
    96
}

fn max_subr_depth() -> i64 {
    10
}

fn max_operators() -> i64 {
    200000
}

fn max_pieces() -> i64 {
    8
}

fn cubic_error() -> f32 {
    0.0481125
}

fn cubic_tolerance() -> f32 {
    0.1
}

fn missing_outlines(d: Directory) -> Error {
    if find(d, "CFF2") != none {
        Unsupported("CFF2")
    } else {
        Malformed("glyf")
    }
}

fn read_cff(d: Directory) -> Cff ! Error {
    let table = find(d, "CFF ") ?? fail missing_outlines(d)
    let data = d.data
    let start = table.offset
    let end = start + table.length
    if table.length < 4 || byte(data, start) != 1 || byte(data, start + 2) < 4 {
        fail Malformed("CFF ")
    }
    let names = index_at(data, start + byte(data, start + 2), end) ?? fail Malformed("CFF ")
    let tops = index_at(data, names.end, end) ?? fail Malformed("CFF ")
    let strings = index_at(data, tops.end, end) ?? fail Malformed("CFF ")
    let gsubrs = index_at(data, strings.end, end) ?? fail Malformed("CFF ")
    let top = index_entry(data, tops, 0) ?? fail Malformed("CFF ")
    let charstrings_at = dict_operands(data, top, 17) ?? fail Malformed("CFF ")
    if charstrings_at.len < 1 {
        fail Malformed("CFF ")
    }
    let charstrings = index_at(data, start + charstrings_at[0], end) ?? fail Malformed("CFF ")
    var locals: []Index = []
    var fd_select = 0
    match dict_operands(data, top, 1236) {
        some(array) => {
            if array.len < 1 {
                fail Malformed("CFF ")
            }
            let fonts = index_at(data, start + array[0], end) ?? fail Malformed("CFF ")
            for i in 0..fonts.count {
                let font_dict = index_entry(data, fonts, i) ?? fail Malformed("CFF ")
                locals.push(local_subrs(data, font_dict, start, end))
            }
            fd_select = read_fd_select(data, top, start, end, charstrings.count)?
        }
        none => {
            locals.push(local_subrs(data, top, start, end))
        }
    }
    Cff { charstrings, gsubrs, locals, fd_select }
}

fn read_fd_select(data: str, top: Span, start: i64, end: i64, glyphs: i64) -> i64 ! Error {
    let operands = dict_operands(data, top, 1237) ?? return 0
    if operands.len < 1 {
        fail Malformed("CFF ")
    }
    let at = start + operands[0]
    let format = byte(data, at)
    if format == 0 && at + 1 + glyphs <= end {
        return at
    }
    if format == 3 && at + 5 <= end && at + 5 + 3 * be16(data, at + 1) <= end {
        return at
    }
    fail Malformed("CFF ")
}

fn index_at(data: str, at: i64, limit: i64) -> Index? {
    if at < 0 || at + 2 > limit {
        return none
    }
    let count = be16(data, at)
    if count == 0 {
        return Index { count: 0, offsets: at + 2, off_size: 0, base: at + 2, end: at + 2 }
    }
    let size = byte(data, at + 2)
    if size < 1 || size > 4 {
        return none
    }
    let offsets = at + 3
    let base = offsets + size * (count + 1) - 1
    if base + 1 > limit {
        return none
    }
    let probe = Index { count, offsets, off_size: size, base, end: base }
    let last = index_offset(data, probe, count)
    if last < 1 || base + last > limit {
        return none
    }
    Index { count, offsets, off_size: size, base, end: base + last }
}

fn index_offset(d: str, idx: Index, i: i64) -> i64 {
    var v = 0
    for k in 0..idx.off_size {
        v = v << 8 | byte(d, idx.offsets + idx.off_size * i + k)
    }
    v
}

fn index_entry(d: str, idx: Index, i: i64) -> Span? {
    if i < 0 || i >= idx.count {
        return none
    }
    let first = idx.base + index_offset(d, idx, i)
    let last = idx.base + index_offset(d, idx, i + 1)
    if first <= idx.base || last < first || last > idx.end {
        return none
    }
    Span { start: first, end: last }
}

fn dict_operands(d: str, dict: Span, op: i64) -> []i64? {
    var stack: []i64 = []
    var pos = dict.start
    for pos < dict.end {
        let b0 = byte(d, pos)
        if b0 <= 21 {
            var key = b0
            pos += 1
            if b0 == 12 {
                key = 1200 + byte(d, pos)
                pos += 1
            }
            if key == op {
                return stack
            }
            stack = []
        } else if b0 == 28 {
            stack.push(be16_signed(d, pos + 1))
            pos += 3
        } else if b0 == 29 {
            stack.push(be32_signed(d, pos + 1))
            pos += 5
        } else if b0 == 30 {
            pos += 1
            for pos < dict.end {
                let pair = byte(d, pos)
                pos += 1
                if pair & 15 == 15 || pair >> 4 == 15 {
                    break
                }
            }
            stack.push(0)
        } else if b0 >= 32 && b0 <= 246 {
            stack.push(b0 - 139)
            pos += 1
        } else if b0 >= 247 && b0 <= 250 {
            stack.push((b0 - 247) * 256 + byte(d, pos + 1) + 108)
            pos += 2
        } else if b0 >= 251 && b0 <= 254 {
            stack.push(-(b0 - 251) * 256 - byte(d, pos + 1) - 108)
            pos += 2
        } else {
            pos += 1
        }
    }
    none
}

fn local_subrs(data: str, dict: Span, start: i64, end: i64) -> Index {
    let private = dict_operands(data, dict, 18) ?? return Index {}
    if private.len < 2 {
        return Index {}
    }
    let at = start + private[1]
    if private[0] < 0 || private[1] < 0 || at + private[0] > end {
        return Index {}
    }
    let subrs = dict_operands(data, Span { start: at, end: at + private[0] }, 19) ?? return Index {}
    if subrs.len < 1 {
        return Index {}
    }
    index_at(data, at + subrs[0], end) ?? Index {}
}

fn font_dict_of(f: Font, glyph: i64) -> i64 {
    let at = f.cff.fd_select
    if at == 0 {
        return 0
    }
    if byte(f.data, at) == 0 {
        return byte(f.data, at + 1 + glyph)
    }
    let ranges = at + 3
    var lo = 0
    var hi = be16(f.data, at + 1)
    for lo < hi {
        let mid = (lo + hi) / 2
        if be16(f.data, ranges + 3 * mid) <= glyph {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    if lo == 0 {
        0
    } else {
        byte(f.data, ranges + 3 * (lo - 1) + 2)
    }
}

fn cff_contours(f: Font, glyph: i64) -> []Contour {
    let cff = f.cff
    let span = index_entry(f.data, cff.charstrings, glyph) ?? return none_found()
    let fd = font_dict_of(f, glyph)
    let local = if fd < cff.locals.len { cff.locals[fd] } else { Index {} }
    var st = Machine { data: f.data, gsubrs: cff.gsubrs, local, budget: max_operators() }
    run(mut st, span, 0)
    if st.broken {
        return none_found()
    }
    close_contour(mut st)
    st.contours
}

fn run(mut st: Machine, span: Span, depth: i64) {
    var pos = span.start
    for pos < span.end && !st.ended && !st.broken {
        let b0 = byte(st.data, pos)
        pos += 1
        if b0 >= 32 || b0 == 28 {
            pos = operand(mut st, b0, pos)
        } else {
            st.budget -= 1
            if st.budget < 0 {
                st.broken = true
            } else {
                pos = operator(mut st, b0, pos, span.end, depth)
            }
        }
    }
}

fn operand(mut st: Machine, b0: i64, at: i64) -> i64 {
    var v: f32 = 0.0
    var pos = at
    if b0 == 28 {
        v = f32(be16_signed(st.data, pos))
        pos += 2
    } else if b0 <= 246 {
        v = f32(b0 - 139)
    } else if b0 <= 250 {
        v = f32((b0 - 247) * 256 + byte(st.data, pos) + 108)
        pos += 1
    } else if b0 <= 254 {
        v = f32(-(b0 - 251) * 256 - byte(st.data, pos) - 108)
        pos += 1
    } else {
        v = f32(be32_signed(st.data, pos)) / 65536.0
        pos += 4
    }
    if st.stack.len >= max_stack() {
        st.broken = true
    } else {
        st.stack.push(v)
    }
    pos
}

fn operator(mut st: Machine, op: i64, at: i64, end: i64, depth: i64) -> i64 {
    var pos = at
    match op {
        1 => stems(mut st)
        3 => stems(mut st)
        18 => stems(mut st)
        23 => stems(mut st)
        19 => {
            pos += mask_bytes(mut st)
        }
        20 => {
            pos += mask_bytes(mut st)
        }
        4 => vmoveto(mut st)
        5 => rlineto(mut st)
        6 => alternating_lines(mut st, true)
        7 => alternating_lines(mut st, false)
        8 => rrcurveto(mut st)
        10 => {
            let subrs = st.local
            call(mut st, subrs, depth)
        }
        11 => {
            pos = end
        }
        14 => endchar(mut st)
        21 => rmoveto(mut st)
        22 => hmoveto(mut st)
        24 => rcurveline(mut st)
        25 => rlinecurve(mut st)
        26 => vvcurveto(mut st)
        27 => hhcurveto(mut st)
        29 => {
            let subrs = st.gsubrs
            call(mut st, subrs, depth)
        }
        30 => alternating_curves(mut st, false)
        31 => alternating_curves(mut st, true)
        12 => {
            let second = byte(st.data, at)
            pos += 1
            escape(mut st, second)
        }
        _ => {
            st.broken = true
        }
    }
    pos
}

fn escape(mut st: Machine, op: i64) {
    match op {
        0 => {
            st.stack = []
        }
        34 => hflex(mut st)
        35 => flex(mut st)
        36 => hflex1(mut st)
        37 => flex1(mut st)
        _ => {
            st.broken = true
        }
    }
}

fn bias(count: i64) -> i64 {
    if count < 1240 {
        107
    } else if count < 33900 {
        1131
    } else {
        32768
    }
}

fn call(mut st: Machine, subrs: Index, depth: i64) {
    if st.stack.len == 0 || depth >= max_subr_depth() {
        st.broken = true
        return
    }
    let top = st.stack[st.stack.len - 1]
    st.stack.pop()
    let number = i64(top) + bias(subrs.count)
    match index_entry(st.data, subrs, number) {
        some(span) => run(mut st, span, depth + 1)
        none => {
            st.broken = true
        }
    }
}

fn skip_width(mut st: Machine, expected: i64) -> i64 {
    if st.width_done {
        return 0
    }
    st.width_done = true
    if st.stack.len > expected {
        1
    } else {
        0
    }
}

fn stems(mut st: Machine) {
    st.width_done = true
    st.stems += st.stack.len / 2
    st.stack = []
}

fn mask_bytes(mut st: Machine) -> i64 {
    stems(mut st)
    (st.stems + 7) / 8
}

fn endchar(mut st: Machine) {
    close_contour(mut st)
    st.ended = true
    st.stack = []
}

fn rmoveto(mut st: Machine) {
    let a = st.stack
    let first = skip_width(mut st, 2)
    if a.len - first < 2 {
        st.broken = true
        return
    }
    move_by(mut st, a[first], a[first + 1])
    st.stack = []
}

fn hmoveto(mut st: Machine) {
    let a = st.stack
    let first = skip_width(mut st, 1)
    if a.len - first < 1 {
        st.broken = true
        return
    }
    move_by(mut st, a[first], 0.0)
    st.stack = []
}

fn vmoveto(mut st: Machine) {
    let a = st.stack
    let first = skip_width(mut st, 1)
    if a.len - first < 1 {
        st.broken = true
        return
    }
    move_by(mut st, 0.0, a[first])
    st.stack = []
}

fn rlineto(mut st: Machine) {
    let a = st.stack
    var i = 0
    for i + 2 <= a.len {
        line_by(mut st, a[i], a[i + 1])
        i += 2
    }
    st.stack = []
}

fn alternating_lines(mut st: Machine, horizontal: bool) {
    let a = st.stack
    var h = horizontal
    for v in a {
        if h {
            line_by(mut st, v, 0.0)
        } else {
            line_by(mut st, 0.0, v)
        }
        h = !h
    }
    st.stack = []
}

fn rrcurveto(mut st: Machine) {
    let a = st.stack
    var i = 0
    for i + 6 <= a.len {
        curve_by(mut st, a[i], a[i + 1], a[i + 2], a[i + 3], a[i + 4], a[i + 5])
        i += 6
    }
    st.stack = []
}

fn rcurveline(mut st: Machine) {
    let a = st.stack
    var i = 0
    for i + 8 <= a.len {
        curve_by(mut st, a[i], a[i + 1], a[i + 2], a[i + 3], a[i + 4], a[i + 5])
        i += 6
    }
    if i + 2 <= a.len {
        line_by(mut st, a[i], a[i + 1])
    }
    st.stack = []
}

fn rlinecurve(mut st: Machine) {
    let a = st.stack
    var i = 0
    for i + 8 <= a.len {
        line_by(mut st, a[i], a[i + 1])
        i += 2
    }
    if i + 6 <= a.len {
        curve_by(mut st, a[i], a[i + 1], a[i + 2], a[i + 3], a[i + 4], a[i + 5])
    }
    st.stack = []
}

fn hhcurveto(mut st: Machine) {
    let a = st.stack
    var i = 0
    var lift: f32 = 0.0
    if a.len % 2 == 1 {
        lift = a[0]
        i = 1
    }
    for i + 4 <= a.len {
        curve_by(mut st, a[i], lift, a[i + 1], a[i + 2], a[i + 3], 0.0)
        lift = 0.0
        i += 4
    }
    st.stack = []
}

fn vvcurveto(mut st: Machine) {
    let a = st.stack
    var i = 0
    var drift: f32 = 0.0
    if a.len % 2 == 1 {
        drift = a[0]
        i = 1
    }
    for i + 4 <= a.len {
        curve_by(mut st, drift, a[i], a[i + 1], a[i + 2], 0.0, a[i + 3])
        drift = 0.0
        i += 4
    }
    st.stack = []
}

fn alternating_curves(mut st: Machine, horizontal: bool) {
    let a = st.stack
    var h = horizontal
    var i = 0
    for i + 4 <= a.len {
        let tail = if a.len - i == 5 { a[i + 4] } else { 0.0 }
        if h {
            curve_by(mut st, a[i], 0.0, a[i + 1], a[i + 2], tail, a[i + 3])
        } else {
            curve_by(mut st, 0.0, a[i], a[i + 1], a[i + 2], a[i + 3], tail)
        }
        h = !h
        i += 4
    }
    st.stack = []
}

fn flex(mut st: Machine) {
    let a = st.stack
    if a.len < 12 {
        st.broken = true
        return
    }
    curve_by(mut st, a[0], a[1], a[2], a[3], a[4], a[5])
    curve_by(mut st, a[6], a[7], a[8], a[9], a[10], a[11])
    st.stack = []
}

fn hflex(mut st: Machine) {
    let a = st.stack
    if a.len < 7 {
        st.broken = true
        return
    }
    curve_by(mut st, a[0], 0.0, a[1], a[2], a[3], 0.0)
    curve_by(mut st, a[4], 0.0, a[5], -a[2], a[6], 0.0)
    st.stack = []
}

fn hflex1(mut st: Machine) {
    let a = st.stack
    if a.len < 9 {
        st.broken = true
        return
    }
    curve_by(mut st, a[0], a[1], a[2], a[3], a[4], 0.0)
    curve_by(mut st, a[5], 0.0, a[6], a[7], a[8], -(a[1] + a[3] + a[7]))
    st.stack = []
}

fn flex1(mut st: Machine) {
    let a = st.stack
    if a.len < 11 {
        st.broken = true
        return
    }
    let dx = a[0] + a[2] + a[4] + a[6] + a[8]
    let dy = a[1] + a[3] + a[5] + a[7] + a[9]
    var last_x = a[10]
    var last_y = -dy
    if abs_f(dx) <= abs_f(dy) {
        last_x = -dx
        last_y = a[10]
    }
    curve_by(mut st, a[0], a[1], a[2], a[3], a[4], a[5])
    curve_by(mut st, a[6], a[7], a[8], a[9], last_x, last_y)
    st.stack = []
}

fn abs_f(v: f32) -> f32 {
    if v < 0.0 {
        -v
    } else {
        v
    }
}

fn close_contour(mut st: Machine) {
    if st.points.len >= 2 {
        let first = st.points[0]
        let last = st.points[st.points.len - 1]
        if st.points.len > 2 && last.on_curve && last.x == first.x && last.y == first.y {
            st.points.pop()
        }
        st.contours.push(Contour { points: st.points })
    }
    st.points = []
}

fn move_by(mut st: Machine, dx: f32, dy: f32) {
    close_contour(mut st)
    st.x += dx
    st.y += dy
    st.points.push(Point { x: st.x, y: st.y, on_curve: true })
}

fn open_contour(mut st: Machine) {
    if st.points.len == 0 {
        st.points.push(Point { x: st.x, y: st.y, on_curve: true })
    }
}

fn line_by(mut st: Machine, dx: f32, dy: f32) {
    open_contour(mut st)
    st.x += dx
    st.y += dy
    st.points.push(Point { x: st.x, y: st.y, on_curve: true })
}

fn curve_by(mut st: Machine, dx1: f32, dy1: f32, dx2: f32, dy2: f32, dx3: f32, dy3: f32) {
    open_contour(mut st)
    let x1 = st.x + dx1
    let y1 = st.y + dy1
    let x2 = x1 + dx2
    let y2 = y1 + dy2
    let x3 = x2 + dx3
    let y3 = y2 + dy3
    cubic_to(mut st, x1, y1, x2, y2, x3, y3)
}

fn cubic_to(mut st: Machine, x1: f32, y1: f32, x2: f32, y2: f32, x3: f32, y3: f32) {
    let x0 = st.x
    let y0 = st.y
    let sx = x3 - 3.0 * x2 + 3.0 * x1 - x0
    let sy = y3 - 3.0 * y2 + 3.0 * y1 - y0
    let skew = sqrt(sx * sx + sy * sy) * cubic_error()
    var pieces = 1
    for pieces < max_pieces() && skew > cubic_tolerance() * f32(pieces * pieces * pieces) {
        pieces += 1
    }
    for i in 0..pieces {
        let a = f32(i) / f32(pieces)
        let b = f32(i + 1) / f32(pieces)
        let q1x = blossom(x0, x1, x2, x3, a, a, b)
        let q1y = blossom(y0, y1, y2, y3, a, a, b)
        let q2x = blossom(x0, x1, x2, x3, a, b, b)
        let q2y = blossom(y0, y1, y2, y3, a, b, b)
        let q0x = blossom(x0, x1, x2, x3, a, a, a)
        let q0y = blossom(y0, y1, y2, y3, a, a, a)
        var q3x = blossom(x0, x1, x2, x3, b, b, b)
        var q3y = blossom(y0, y1, y2, y3, b, b, b)
        if i + 1 == pieces {
            q3x = x3
            q3y = y3
        }
        let cx = (3.0 * (q1x + q2x) - q0x - q3x) * 0.25
        let cy = (3.0 * (q1y + q2y) - q0y - q3y) * 0.25
        st.points.push(Point { x: cx, y: cy, on_curve: false })
        st.points.push(Point { x: q3x, y: q3y, on_curve: true })
    }
    st.x = x3
    st.y = y3
}

fn blossom(p0: f32, p1: f32, p2: f32, p3: f32, u: f32, v: f32, w: f32) -> f32 {
    let a0 = p0 + (p1 - p0) * u
    let a1 = p1 + (p2 - p1) * u
    let a2 = p2 + (p3 - p2) * u
    let b0 = a0 + (a1 - a0) * v
    let b1 = a1 + (a2 - a1) * v
    b0 + (b1 - b0) * w
}
