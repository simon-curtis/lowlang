fn prepare_hinting(mut r: Rasterizer) {
    if r.prepared {
        return
    }
    let entries = cmap_entries(r.font)
    r.styles = style_coverage(r.font, entries)
    let class_count = style_classes().len
    for _ in 0..class_count {
        r.metrics.push(StyleMetrics {})
        r.ready.push(false)
    }
    r.adjustments = adjustment_database()
    r.reverse = reverse_charmap(r.font, r.adjustments)
    r.prepared = true
}

fn dummy_metrics(f: Font, style: i64) -> StyleMetrics {
    let class = style_classes()[style]
    StyleMetrics { writing_system: class.writing_system, script: class.script, style, units_per_em: f.units_per_em }
}

fn built_metrics(mut r: Rasterizer, style: i64) -> StyleMetrics? {
    let class = style_classes()[style]
    if class.writing_system == writing_latin {
        return latin_metrics_init(r.font, style, mut r.styles)
    }
    if class.writing_system == writing_dummy {
        return dummy_metrics(r.font, style)
    }
    cjk_metrics_init(r.font, style)
}

fn glyph_metrics(mut r: Rasterizer, glyph: i64) -> StyleMetrics {
    for {
        let style = r.styles[glyph] & style_mask
        if r.ready[style] {
            return r.metrics[style]
        }
        let built = built_metrics(mut r, style) ?? continue
        r.metrics[style] = built
        r.ready[style] = true
        return built
    }
    StyleMetrics {}
}

fn dummy_hints_apply(mut h: GlyphHints, loaded: ScaledOutline) -> ScaledOutline {
    reload(mut h, loaded)
    save(h, loaded)
}

fn hinted_outline(mut r: Rasterizer, glyph: i64, request: Request) -> ScaledOutline? {
    let loaded = load_scaled(r.font, glyph, unscaled) ?? return none
    if loaded.points.len == 0 {
        return loaded
    }
    prepare_hinting(mut r)
    var m = glyph_metrics(mut r, glyph)
    let scaler = Scaler { x_scale: request.scale, y_scale: request.scale }
    if m.writing_system == writing_latin {
        latin_metrics_scale(mut m, scaler)
        r.metrics[m.style] = m
        var h = latin_hints_init(m)
        let adj_type = adjustment_lookup(r.adjustments, r.reverse[glyph])
        return latin_hints_apply(mut h, loaded, r.styles[glyph], adj_type)
    }
    if m.writing_system == writing_dummy {
        m.scaler = scaler
        r.metrics[m.style] = m
        var h = new_hints(m)
        h.x_scale = scaler.x_scale
        h.y_scale = scaler.y_scale
        return dummy_hints_apply(mut h, loaded)
    }
    cjk_metrics_scale(mut m, scaler)
    r.metrics[m.style] = m
    var h = cjk_hints_init(m)
    cjk_hints_apply(mut h, loaded)
}
