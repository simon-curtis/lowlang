const long_max = 0x7FFFFFFFFFFFFFFF
const long_min = -0x7FFFFFFFFFFFFFFF - 1

fn latin_constant(units_per_em: i64, c: i64) -> i64 {
    c * units_per_em / 2048
}

fn load_segment_axes(mut h: GlyphHints, dim: i64) {
    for i in 0..h.points.len {
        if dim == horizontal {
            h.points[i].u = h.points[i].fx
            h.points[i].v = h.points[i].fy
        } else {
            h.points[i].u = h.points[i].fy
            h.points[i].v = h.points[i].fx
        }
    }
}

struct ContourRun {
    on_edge: bool = false
    min_pos: i64 = 32000
    max_pos: i64 = -32000
    min_coord: i64 = 32000
    max_coord: i64 = -32000
    min_flags: i64 = 0
    max_flags: i64 = 0
    min_on_coord: i64 = 32000
    max_on_coord: i64 = -32000
}

fn latin_compute_segments(mut h: GlyphHints, dim: i64) {
    let flat_threshold = h.metrics.units_per_em / 14
    let major_dir = magnitude(h.axes[dim].major_dir)
    var segment_dir = major_dir
    h.axes[dim].segments = []
    load_segment_axes(mut h, dim)
    for start in h.contours {
        var point = start
        var last = h.points[point].prev
        var run = ContourRun {}
        var prev_run = ContourRun {}
        var prev_segment = -1
        if h.points[point].flags & point_ignore == 0 && magnitude(h.points[last].out_dir) == major_dir && magnitude(h.points[point].out_dir) == major_dir {
            last = point
            for {
                point = h.points[point].prev
                if magnitude(h.points[point].out_dir) != major_dir {
                    point = h.points[point].next
                    break
                }
                if point == last {
                    break
                }
            }
        }
        last = point
        var passed = false
        for {
            if run.on_edge {
                let current = h.axes[dim].segments.len - 1
                let u = h.points[point].u
                if u < run.min_pos {
                    run.min_pos = u
                }
                if u > run.max_pos {
                    run.max_pos = u
                }
                let v = h.points[point].v
                if v < run.min_coord {
                    run.min_coord = v
                    run.min_flags = h.points[point].flags
                }
                if v > run.max_coord {
                    run.max_coord = v
                    run.max_flags = h.points[point].flags
                }
                if h.points[point].flags & point_control == 0 {
                    if v < run.min_on_coord {
                        run.min_on_coord = v
                    }
                    if v > run.max_on_coord {
                        run.max_on_coord = v
                    }
                }
                let ignored = h.points[point].flags & point_ignore != 0
                if ignored || h.points[point].out_dir != segment_dir || point == last {
                    let distinct = ignored || prev_segment < 0 || h.axes[dim].segments[current].first != h.axes[dim].segments[prev_segment].last
                    if distinct {
                        record_segment(mut h, dim, current, point, run, flat_threshold)
                        prev_segment = current
                        prev_run = run
                    } else {
                        merge_segment(mut h, dim, current, prev_segment, point, mut run, mut prev_run, flat_threshold)
                        truncate(mut h.axes[dim].segments, h.axes[dim].segments.len - 1)
                    }
                    run.on_edge = false
                }
            }
            if point == last {
                if passed {
                    break
                }
                passed = true
            }
            let starts_segment = h.points[point].flags & point_ignore == 0 && !run.on_edge && (magnitude(h.points[point].out_dir) == major_dir || point == h.points[point].prev)
            if starts_segment {
                if h.axes[dim].segments.len > 1000 {
                    h.axes[dim].segments = []
                    return
                }
                segment_dir = h.points[point].out_dir
                h.axes[dim].segments.push(Segment { dir: segment_dir, first: point, last: point, score: 32000 })
                let current = h.axes[dim].segments.len - 1
                if prev_segment >= 0 {
                    prev_segment = current - 1
                }
                let flags = h.points[point].flags
                run.min_pos = h.points[point].u
                run.max_pos = run.min_pos
                run.min_coord = h.points[point].v
                run.max_coord = run.min_coord
                run.min_flags = flags
                run.max_flags = flags
                if flags & point_control != 0 {
                    run.min_on_coord = 32000
                    run.max_on_coord = -32000
                } else {
                    run.min_on_coord = h.points[point].v
                    run.max_on_coord = run.min_on_coord
                }
                run.on_edge = true
                if point == h.points[point].prev {
                    h.axes[dim].segments[current].pos = truncate_short(run.min_pos)
                    if flags & point_control != 0 {
                        h.axes[dim].segments[current].flags |= edge_round
                    }
                    h.axes[dim].segments[current].min_coord = truncate_short(h.points[point].v)
                    h.axes[dim].segments[current].max_coord = truncate_short(h.points[point].v)
                    h.axes[dim].segments[current].height = 0
                    run.on_edge = false
                }
            }
            point = h.points[point].next
        }
    }
    extend_segment_heights(mut h, dim)
}

fn is_round_run(run: ContourRun, flat_threshold: i64) -> bool {
    (run.min_flags | run.max_flags) & point_control != 0 && run.max_on_coord - run.min_on_coord < flat_threshold
}

fn record_segment(mut h: GlyphHints, dim: i64, segment: i64, point: i64, run: ContourRun, flat_threshold: i64) {
    h.axes[dim].segments[segment].last = point
    h.axes[dim].segments[segment].pos = truncate_short((run.min_pos + run.max_pos) >> 1)
    h.axes[dim].segments[segment].delta = truncate_short((run.max_pos - run.min_pos) >> 1)
    if is_round_run(run, flat_threshold) {
        h.axes[dim].segments[segment].flags |= edge_round
    }
    h.axes[dim].segments[segment].min_coord = truncate_short(run.min_coord)
    h.axes[dim].segments[segment].max_coord = truncate_short(run.max_coord)
    h.axes[dim].segments[segment].height = truncate_short(h.axes[dim].segments[segment].max_coord - h.axes[dim].segments[segment].min_coord)
}

fn merge_segment(mut h: GlyphHints, dim: i64, segment: i64, prev_segment: i64, point: i64, mut run: ContourRun, mut prev_run: ContourRun, flat_threshold: i64) {
    let prev_last = h.axes[dim].segments[prev_segment].last
    if h.points[prev_last].in_dir == h.points[point].in_dir {
        if prev_run.min_pos < run.min_pos {
            run.min_pos = prev_run.min_pos
        }
        if prev_run.max_pos > run.max_pos {
            run.max_pos = prev_run.max_pos
        }
        if prev_run.min_coord < run.min_coord {
            run.min_coord = prev_run.min_coord
            run.min_flags = prev_run.min_flags
        }
        if prev_run.max_coord > run.max_coord {
            run.max_coord = prev_run.max_coord
            run.max_flags = prev_run.max_flags
        }
        if prev_run.min_on_coord < run.min_on_coord {
            run.min_on_coord = prev_run.min_on_coord
        }
        if prev_run.max_on_coord > run.max_on_coord {
            run.max_on_coord = prev_run.max_on_coord
        }
        h.axes[dim].segments[prev_segment].last = point
        h.axes[dim].segments[prev_segment].pos = truncate_short((run.min_pos + run.max_pos) >> 1)
        h.axes[dim].segments[prev_segment].delta = truncate_short((run.max_pos - run.min_pos) >> 1)
        if is_round_run(run, flat_threshold) {
            h.axes[dim].segments[prev_segment].flags |= edge_round
        } else {
            h.axes[dim].segments[prev_segment].flags &= ~edge_round
        }
        h.axes[dim].segments[prev_segment].min_coord = truncate_short(run.min_coord)
        h.axes[dim].segments[prev_segment].max_coord = truncate_short(run.max_coord)
        h.axes[dim].segments[prev_segment].height = truncate_short(h.axes[dim].segments[prev_segment].max_coord - h.axes[dim].segments[prev_segment].min_coord)
        return
    }
    if magnitude(prev_run.max_coord - prev_run.min_coord) > magnitude(run.max_coord - run.min_coord) {
        if run.min_pos < prev_run.min_pos {
            prev_run.min_pos = run.min_pos
        }
        if run.max_pos > prev_run.max_pos {
            prev_run.max_pos = run.max_pos
        }
        h.axes[dim].segments[prev_segment].last = point
        h.axes[dim].segments[prev_segment].pos = truncate_short((prev_run.min_pos + prev_run.max_pos) >> 1)
        h.axes[dim].segments[prev_segment].delta = truncate_short((prev_run.max_pos - prev_run.min_pos) >> 1)
        return
    }
    if prev_run.min_pos < run.min_pos {
        run.min_pos = prev_run.min_pos
    }
    if prev_run.max_pos > run.max_pos {
        run.max_pos = prev_run.max_pos
    }
    h.axes[dim].segments[segment].last = point
    h.axes[dim].segments[segment].pos = truncate_short((run.min_pos + run.max_pos) >> 1)
    h.axes[dim].segments[segment].delta = truncate_short((run.max_pos - run.min_pos) >> 1)
    if is_round_run(run, flat_threshold) {
        h.axes[dim].segments[segment].flags |= edge_round
    }
    h.axes[dim].segments[segment].min_coord = truncate_short(run.min_coord)
    h.axes[dim].segments[segment].max_coord = truncate_short(run.max_coord)
    h.axes[dim].segments[segment].height = truncate_short(h.axes[dim].segments[segment].max_coord - h.axes[dim].segments[segment].min_coord)
    h.axes[dim].segments[prev_segment] = h.axes[dim].segments[segment]
    prev_run = run
}

fn extend_segment_heights(mut h: GlyphHints, dim: i64) {
    for s in 0..h.axes[dim].segments.len {
        let first = h.axes[dim].segments[s].first
        let last = h.axes[dim].segments[s].last
        let first_v = h.points[first].v
        let last_v = h.points[last].v
        let before = h.points[h.points[first].prev].v
        let after = h.points[h.points[last].next].v
        var height = h.axes[dim].segments[s].height
        if first_v < last_v {
            if before < first_v {
                height = truncate_short(height + ((first_v - before) >> 1))
            }
            if after > last_v {
                height = truncate_short(height + ((after - last_v) >> 1))
            }
        } else {
            if before > first_v {
                height = truncate_short(height + ((before - first_v) >> 1))
            }
            if after < last_v {
                height = truncate_short(height + ((last_v - after) >> 1))
            }
        }
        h.axes[dim].segments[s].height = height
    }
}

fn latin_link_segments(mut h: GlyphHints, widths: []Width, dim: i64) {
    let units_per_em = h.metrics.units_per_em
    let axis = h.axes[dim]
    let max_width = if widths.len > 0 { widths[widths.len - 1].org } else { 0 }
    var len_threshold = latin_constant(units_per_em, 8)
    if len_threshold == 0 {
        len_threshold = 1
    }
    let len_score = latin_constant(units_per_em, 6000)
    let dist_score = 3000
    for s1 in 0..axis.segments.len {
        if axis.segments[s1].dir != axis.major_dir {
            continue
        }
        for s2 in 0..axis.segments.len {
            let pos1 = axis.segments[s1].pos
            let pos2 = axis.segments[s2].pos
            if axis.segments[s1].dir + axis.segments[s2].dir == 0 && pos2 > pos1 {
                let low = max_of(axis.segments[s1].min_coord, axis.segments[s2].min_coord)
                let high = min_of(axis.segments[s1].max_coord, axis.segments[s2].max_coord)
                let length = high - low
                if length >= len_threshold {
                    let dist = pos2 - pos1
                    var dist_demerit = dist
                    if max_width != 0 {
                        let delta = (dist << 10) / max_width - (1 << 10)
                        if delta > 10000 {
                            dist_demerit = 32000
                        } else if delta > 0 {
                            dist_demerit = delta * delta / dist_score
                        } else {
                            dist_demerit = 0
                        }
                    }
                    let score = dist_demerit + len_score / length
                    if score < axis.segments[s1].score {
                        axis.segments[s1].score = score
                        axis.segments[s1].link = s2
                    }
                    if score < axis.segments[s2].score {
                        axis.segments[s2].score = score
                        axis.segments[s2].link = s1
                    }
                }
            }
        }
    }
    for s1 in 0..axis.segments.len {
        let s2 = axis.segments[s1].link
        if s2 >= 0 {
            if axis.segments[s2].link != s1 {
                axis.segments[s1].link = -1
                axis.segments[s1].serif = axis.segments[s2].link
            }
        }
    }
}

fn insert_edge(mut h: GlyphHints, dim: i64, fpos: i64, dir: i64, top_to_bottom: bool) -> i64 {
    h.axes[dim].edges.push(Edge {})
    var at = h.axes[dim].edges.len - 1
    for at > 0 {
        let before = h.axes[dim].edges[at - 1]
        let ordered = if top_to_bottom { before.fpos > fpos } else { before.fpos < fpos }
        if ordered {
            break
        }
        if before.fpos == fpos && dir == h.axes[dim].major_dir {
            break
        }
        h.axes[dim].edges[at] = before
        at -= 1
    }
    at
}

fn latin_compute_edges(mut h: GlyphHints) {
    let top_to_bottom = script_top_to_bottom(h.metrics.script)
    let scale = h.y_scale
    h.axes[vertical].edges = []
    let segment_width_threshold = div_fix(32, scale)
    var edge_distance_threshold = mul_fix(h.metrics.axes[vertical].edge_distance_threshold, scale)
    if edge_distance_threshold > 64 / 4 {
        edge_distance_threshold = 64 / 4
    }
    edge_distance_threshold = div_fix(edge_distance_threshold, scale)
    let segment_count = h.axes[vertical].segments.len
    for s in 0..segment_count {
        let seg = h.axes[vertical].segments[s]
        if seg.delta > segment_width_threshold || seg.dir == dir_none {
            continue
        }
        let found = nearest_edge(h, seg, edge_distance_threshold, true)
        if found < 0 {
            let at = insert_edge(mut h, vertical, seg.pos, seg.dir, top_to_bottom)
            h.axes[vertical].edges[at] = Edge { first: s, last: s, dir: seg.dir, fpos: seg.pos, opos: mul_fix(seg.pos, scale), pos: mul_fix(seg.pos, scale) }
            h.axes[vertical].segments[s].edge_next = s
        } else {
            append_segment(mut h, vertical, found, s)
        }
    }
    for s in 0..segment_count {
        let seg = h.axes[vertical].segments[s]
        if seg.dir != dir_none {
            continue
        }
        let found = nearest_edge(h, seg, edge_distance_threshold, false)
        if found >= 0 {
            append_segment(mut h, vertical, found, s)
        }
    }
    attach_segments_to_edges(mut h, vertical)
    link_edges(mut h, vertical)
}

fn append_segment(mut h: GlyphHints, dim: i64, edge: i64, segment: i64) {
    let first = h.axes[dim].edges[edge].first
    let last = h.axes[dim].edges[edge].last
    h.axes[dim].segments[segment].edge_next = first
    h.axes[dim].segments[last].edge_next = segment
    h.axes[dim].edges[edge].last = segment
}

fn nearest_edge(h: GlyphHints, seg: Segment, threshold: i64, same_direction: bool) -> i64 {
    for ee in 0..h.axes[vertical].edges.len {
        let edge = h.axes[vertical].edges[ee]
        let dist = magnitude(seg.pos - edge.fpos)
        if dist < threshold && (!same_direction || edge.dir == seg.dir) {
            return ee
        }
    }
    -1
}

fn attach_segments_to_edges(mut h: GlyphHints, dim: i64) {
    for ee in 0..h.axes[dim].edges.len {
        let first = h.axes[dim].edges[ee].first
        if first < 0 {
            continue
        }
        var seg = first
        for {
            h.axes[dim].segments[seg].edge = ee
            seg = h.axes[dim].segments[seg].edge_next
            if seg == first {
                break
            }
        }
    }
}

fn link_edges(mut h: GlyphHints, dim: i64) {
    for ee in 0..h.axes[dim].edges.len {
        var round_count = 0
        var straight_count = 0
        let first = h.axes[dim].edges[ee].first
        var seg = first
        for {
            if h.axes[dim].segments[seg].flags & edge_round != 0 {
                round_count += 1
            } else {
                straight_count += 1
            }
            let serif_seg = h.axes[dim].segments[seg].serif
            let link_seg = h.axes[dim].segments[seg].link
            var is_serif = false
            if serif_seg >= 0 {
                let serif_edge = h.axes[dim].segments[serif_seg].edge
                is_serif = serif_edge >= 0 && serif_edge != ee
            }
            let links_to_edge = link_seg >= 0 && h.axes[dim].segments[link_seg].edge >= 0
            if links_to_edge || is_serif {
                var edge2 = h.axes[dim].edges[ee].link
                var seg2 = link_seg
                if is_serif {
                    seg2 = serif_seg
                    edge2 = h.axes[dim].edges[ee].serif
                }
                if edge2 >= 0 {
                    let edge_delta = magnitude(h.axes[dim].edges[ee].fpos - h.axes[dim].edges[edge2].fpos)
                    let seg_delta = magnitude(h.axes[dim].segments[seg].pos - h.axes[dim].segments[seg2].pos)
                    if seg_delta < edge_delta {
                        edge2 = h.axes[dim].segments[seg2].edge
                    }
                } else {
                    edge2 = h.axes[dim].segments[seg2].edge
                }
                if is_serif {
                    h.axes[dim].edges[ee].serif = edge2
                    h.axes[dim].edges[edge2].flags |= edge_serif
                } else {
                    h.axes[dim].edges[ee].link = edge2
                }
            }
            seg = h.axes[dim].segments[seg].edge_next
            if seg == first {
                break
            }
        }
        h.axes[dim].edges[ee].flags = edge_normal
        if round_count > 0 && round_count >= straight_count {
            h.axes[dim].edges[ee].flags |= edge_round
        }
        if h.axes[dim].edges[ee].serif >= 0 && h.axes[dim].edges[ee].link >= 0 {
            h.axes[dim].edges[ee].serif = -1
        }
    }
}

fn latin_detect_features(mut h: GlyphHints, widths: []Width) {
    latin_compute_segments(mut h, vertical)
    latin_link_segments(mut h, widths, vertical)
    latin_compute_edges(mut h)
}

fn latin_compute_blue_edges(mut h: GlyphHints) {
    let latin = h.metrics.axes[vertical]
    let scale = latin.scale
    let major_dir = h.axes[vertical].major_dir
    for ee in 0..h.axes[vertical].edges.len {
        let edge = h.axes[vertical].edges[ee]
        if edge.flags & edge_no_blue != 0 {
            continue
        }
        var best_blue = -1
        var best_is_neutral = false
        var best_dist = mul_fix(h.metrics.units_per_em / 40, scale)
        if best_dist > 64 / 2 {
            best_dist = 64 / 2
        }
        for bb in 0..latin.blues.len {
            let blue = latin.blues[bb]
            if blue.flags & blue_active == 0 {
                continue
            }
            let is_top = blue.flags & (blue_top | blue_sub_top) != 0
            let is_neutral = blue.flags & blue_neutral != 0
            let is_major_dir = edge.dir == major_dir
            if is_top != is_major_dir || is_neutral {
                var dist = mul_fix(magnitude(edge.fpos - blue.ref.org), scale)
                if dist < best_dist {
                    best_dist = dist
                    best_blue = 2 * bb
                    best_is_neutral = is_neutral
                }
                if edge.flags & edge_round != 0 && dist != 0 && !is_neutral {
                    let is_under_ref = edge.fpos < blue.ref.org
                    if is_top != is_under_ref {
                        dist = mul_fix(magnitude(edge.fpos - blue.shoot.org), scale)
                        if dist < best_dist {
                            best_dist = dist
                            best_blue = 2 * bb + 1
                            best_is_neutral = is_neutral
                        }
                    }
                }
            }
        }
        if best_blue >= 0 {
            h.axes[vertical].edges[ee].blue = best_blue
            if best_is_neutral {
                h.axes[vertical].edges[ee].flags |= edge_neutral
            }
        }
    }
}
