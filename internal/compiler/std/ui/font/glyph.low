/// A point of a glyph outline, in font units with y up.
pub struct Point {
    /// The distance right of the glyph's origin.
    pub x: f32
    /// The distance above the baseline.
    pub y: f32
    /// Whether the point is on the curve, or a control point of a quadratic curve.
    pub on_curve: bool
}

/// A closed loop of points: lines between consecutive on-curve points, and a quadratic curve through each run of off-curve points.
///
/// Between two consecutive off-curve points the curve passes through their midpoint, which the list leaves out. A cubic curve of an OpenType CFF glyph is stored as one to eight quadratic curves that stay within a tenth of a font unit of it, each ending on an on-curve point.
pub struct Contour {
    /// The points in file order.
    pub points: []Point
}

/// The shape of a glyph, in font units.
pub struct Outline {
    /// The closed loops, which fill by the non-zero winding rule.
    pub contours: []Contour
}

/// Returns the outline of `glyph`, with each component of a composite glyph placed as FreeType places it unscaled: transformed by its 2x2 matrix, then moved by its offset (scaled by the matrix too when the component sets `SCALED_COMPONENT_OFFSET`) or by matching one of its points to one of the points loaded before it. A TrueType glyph is moved left by the distance from its left side bearing to the left of its header's box.
///
/// A composite nests at most 6 deep and holds at most 64 components in all.
///
/// A CFF glyph is drawn from its Type 2 charstring, with subroutines up to 10 deep and at most 200000 operators. The deprecated arithmetic and storage operators and the accented form of `endchar` are not supported.
///
/// A space, a glyph the font does not have and a glyph whose data is truncated or inconsistent give an outline with no contours.
pub fn outline(f: Font, glyph: i64) -> Outline {
    if f.cff.charstrings.count > 0 {
        return Outline { contours: cff_contours(f, glyph) }
    }
    let shape = load_scaled(f, glyph, unit_scale) ?? return Outline { contours: [] }
    Outline { contours: contours_of(shape) }
}

fn contours_of(shape: ScaledOutline) -> []Contour {
    var out: []Contour = []
    var first = 0
    for end in shape.ends {
        var points: []Point = []
        for i in first..end + 1 {
            let p = shape.points[i]
            points.push(Point { x: f32(p.x), y: f32(p.y), on_curve: p.on_curve })
        }
        out.push(Contour { points })
        first = end + 1
    }
    out
}
