import std/os
import paths = std/path
import std/slices
import strings = std/text

/// Returns the directories `discover` searches, in order: the per-user and system font directories of the platform, each once.
pub fn font_directories() -> []str {
    var out: []str = []
    let home = os.home_dir() ?? ""
    let data_home = os.env("XDG_DATA_HOME") ?? ""
    if data_home != "" {
        add_directory(mut out, "{data_home}/fonts")
    } else if home != "" {
        add_directory(mut out, "{home}/.local/share/fonts")
    }
    if home != "" {
        add_directory(mut out, "{home}/.fonts")
    }
    var shared = os.env("XDG_DATA_DIRS") ?? ""
    if shared == "" {
        shared = "/usr/local/share:/usr/share"
    }
    for dir in strings.split(shared, ':') {
        if dir != "" {
            add_directory(mut out, "{dir}/fonts")
        }
    }
    out
}

fn add_directory(mut out: []str, dir: str) {
    let clean = paths.clean(dir)
    if !slices.contains(out, clean) {
        out.push(clean)
    }
}
