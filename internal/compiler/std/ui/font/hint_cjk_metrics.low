const property_cjk_horizontal = 2

fn extreme_coordinate(shape: ScaledOutline, along_x: bool, maximum: bool) -> i64 {
    var found = false
    var best = 0
    var first = 0
    for end in shape.ends {
        if end > first {
            for p in first..(end + 1) {
                let value = if along_x { shape.points[p].x } else { shape.points[p].y }
                let better = if maximum { value > best } else { value < best }
                if !found || better {
                    found = true
                    best = value
                }
            }
        }
        first = end + 1
    }
    best
}

fn cjk_init_blues(f: Font, mut m: StyleMetrics) {
    let strings = blue_stringset(style_classes()[m.style].blue_stringset)
    for bs in strings {
        let along_x = bs.properties & property_cjk_horizontal != 0
        let top_right = bs.properties & property_top != 0
        let dim = if along_x { horizontal } else { vertical }
        var fills: []i64 = []
        var flats: []i64 = []
        var fill = true
        for cp in bs.chars {
            if cp == 124 {
                fill = false
                continue
            }
            let glyph = glyph_index(f, u32(cp))
            if glyph == 0 {
                continue
            }
            let loaded = load_scaled(f, glyph, unscaled) ?? continue
            if loaded.points.len <= 2 {
                continue
            }
            let extreme = extreme_coordinate(loaded, along_x, top_right)
            if fill {
                fills.push(extreme)
            } else {
                flats.push(extreme)
            }
        }
        if fills.len == 0 && flats.len == 0 {
            continue
        }
        sort_positions(mut fills)
        sort_positions(mut flats)
        var blue = Blue {}
        if flats.len == 0 {
            blue.ref.org = fills[fills.len / 2]
            blue.shoot.org = blue.ref.org
        } else if fills.len == 0 {
            blue.ref.org = flats[flats.len / 2]
            blue.shoot.org = blue.ref.org
        } else {
            blue.ref.org = fills[fills.len / 2]
            blue.shoot.org = flats[flats.len / 2]
        }
        if blue.shoot.org != blue.ref.org {
            let under_ref = blue.shoot.org < blue.ref.org
            if top_right != under_ref {
                let mean = (blue.shoot.org + blue.ref.org) / 2
                blue.ref.org = mean
                blue.shoot.org = mean
            }
        }
        if top_right {
            blue.flags = blue_top
        }
        m.axes[dim].blues.push(blue)
    }
}

fn cjk_metrics_init(f: Font, style: i64) -> StyleMetrics {
    let class = style_classes()[style]
    var m = StyleMetrics { writing_system: class.writing_system, script: class.script, style, units_per_em: f.units_per_em }
    m.axes = [Axis {}, Axis {}]
    init_widths(f, mut m)
    if class.writing_system == writing_cjk {
        cjk_init_blues(f, mut m)
    }
    m
}

fn cjk_scale_dim(mut m: StyleMetrics, dim: i64, scale: i64, delta: i64) {
    if m.axes[dim].org_scale == scale && m.axes[dim].org_delta == delta {
        return
    }
    m.axes[dim].org_scale = scale
    m.axes[dim].org_delta = delta
    m.axes[dim].scale = scale
    m.axes[dim].delta = delta
    for n in 0..m.axes[dim].blues.len {
        let ref_org = m.axes[dim].blues[n].ref.org
        let shoot_org = m.axes[dim].blues[n].shoot.org
        let ref_cur = mul_fix(ref_org, scale) + delta
        let shoot_cur = mul_fix(shoot_org, scale) + delta
        m.axes[dim].blues[n].ref.cur = ref_cur
        m.axes[dim].blues[n].ref.fit = ref_cur
        m.axes[dim].blues[n].shoot.cur = shoot_cur
        m.axes[dim].blues[n].shoot.fit = shoot_cur
        m.axes[dim].blues[n].flags &= ~blue_active
        let dist = mul_fix(ref_org - shoot_org, scale)
        if dist <= 48 && dist >= -48 {
            let ref_fit = pix_round(ref_cur)
            let delta1 = div_fix(ref_fit, scale) - shoot_org
            var delta2 = mul_fix(magnitude(delta1), scale)
            if delta2 < 32 {
                delta2 = 0
            } else {
                delta2 = pix_round(delta2)
            }
            if delta1 < 0 {
                delta2 = -delta2
            }
            m.axes[dim].blues[n].ref.fit = ref_fit
            m.axes[dim].blues[n].shoot.fit = ref_fit - delta2
            m.axes[dim].blues[n].flags |= blue_active
        }
    }
}

fn cjk_metrics_scale(mut m: StyleMetrics, scaler: Scaler) {
    m.scaler = scaler
    cjk_scale_dim(mut m, horizontal, scaler.x_scale, scaler.x_delta)
    cjk_scale_dim(mut m, vertical, scaler.y_scale, scaler.y_delta)
}
