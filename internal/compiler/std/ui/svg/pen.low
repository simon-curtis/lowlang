import std/ui/geometry

struct Pen {
    path: geometry.Path
    matrix: Matrix
    x: f64
    y: f64
    start_x: f64
    start_y: f64
    open: bool
}

fn pen(matrix: Matrix) -> Pen {
    Pen { path: geometry.path(), matrix, x: 0.0, y: 0.0, start_x: 0.0, start_y: 0.0, open: false }
}

fn begin(mut p: Pen, x: f64, y: f64) {
    let at = place(p.matrix, x, y)
    p.path.move_to(at)
    p.x = x
    p.y = y
    p.start_x = x
    p.start_y = y
    p.open = true
}

fn resume(mut p: Pen) {
    if !p.open {
        p.begin(p.start_x, p.start_y)
    }
}

fn line(mut p: Pen, x: f64, y: f64) {
    p.resume()
    let at = place(p.matrix, x, y)
    p.path.line_to(at)
    p.x = x
    p.y = y
}

fn quad(mut p: Pen, cx: f64, cy: f64, x: f64, y: f64) {
    p.resume()
    let control = place(p.matrix, cx, cy)
    let at = place(p.matrix, x, y)
    p.path.quadratic_to(control, at)
    p.x = x
    p.y = y
}

fn cubic(mut p: Pen, x1: f64, y1: f64, x2: f64, y2: f64, x: f64, y: f64) {
    p.resume()
    let first = place(p.matrix, x1, y1)
    let second = place(p.matrix, x2, y2)
    let at = place(p.matrix, x, y)
    p.path.cubic_to(first, second, at)
    p.x = x
    p.y = y
}

fn shut(mut p: Pen) {
    if p.open {
        p.path.close()
    }
    p.open = false
    p.x = p.start_x
    p.y = p.start_y
}

fn arc(mut p: Pen, radius_x: f64, radius_y: f64, rotation: f64, large: bool, sweep: bool, x: f64, y: f64) {
    let x0 = p.x
    let y0 = p.y
    if x0 == x && y0 == y {
        return
    }
    var rx = absolute(radius_x)
    var ry = absolute(radius_y)
    if rx == 0.0 || ry == 0.0 {
        p.line(x, y)
        return
    }
    let phi = turn(rotation)
    let dx = (x0 - x) / 2.0
    let dy = (y0 - y) / 2.0
    let x1 = phi.cos * dx + phi.sin * dy
    let y1 = -phi.sin * dx + phi.cos * dy
    let lambda = x1 * x1 / (rx * rx) + y1 * y1 / (ry * ry)
    if lambda > 1.0 {
        let grow = sqrt(lambda)
        rx *= grow
        ry *= grow
    }
    let numerator = rx * rx * ry * ry - rx * rx * y1 * y1 - ry * ry * x1 * x1
    let denominator = rx * rx * y1 * y1 + ry * ry * x1 * x1
    var coefficient = if numerator > 0.0 { sqrt(numerator / denominator) } else { 0.0 }
    if large == sweep {
        coefficient = -coefficient
    }
    let cx1 = coefficient * rx * y1 / ry
    let cy1 = -coefficient * ry * x1 / rx
    let cx = phi.cos * cx1 - phi.sin * cy1 + (x0 + x) / 2.0
    let cy = phi.sin * cx1 + phi.cos * cy1 + (y0 + y) / 2.0
    let first = atan2_degrees((y1 - cy1) / ry, (x1 - cx1) / rx)
    let last = atan2_degrees((-y1 - cy1) / ry, (-x1 - cx1) / rx)
    var span = last - first
    if !sweep && span > 0.0 {
        span -= 360.0
    } else if sweep && span < 0.0 {
        span += 360.0
    }
    let pieces = i64(floor(absolute(span) / 90.0 - 0.000000001)) + 1
    let delta = span / f64(pieces)
    let quarter = turn(delta / 4.0)
    let k = 4.0 / 3.0 * quarter.sin / quarter.cos
    for i in 0..pieces {
        let from = turn(first + f64(i) * delta)
        let to = turn(first + f64(i + 1) * delta)
        let ux1 = from.cos - k * from.sin
        let uy1 = from.sin + k * from.cos
        let ux2 = to.cos + k * to.sin
        let uy2 = to.sin - k * to.cos
        let ex = if i + 1 == pieces { x } else { cx + rx * phi.cos * to.cos - ry * phi.sin * to.sin }
        let ey = if i + 1 == pieces { y } else { cy + rx * phi.sin * to.cos + ry * phi.cos * to.sin }
        let c1x = cx + rx * phi.cos * ux1 - ry * phi.sin * uy1
        let c1y = cy + rx * phi.sin * ux1 + ry * phi.cos * uy1
        let c2x = cx + rx * phi.cos * ux2 - ry * phi.sin * uy2
        let c2y = cy + rx * phi.sin * ux2 + ry * phi.cos * uy2
        p.cubic(c1x, c1y, c2x, c2y, ex, ey)
    }
}

fn kappa() -> f64 {
    0.5522847498307936
}

fn ellipse(mut p: Pen, cx: f64, cy: f64, rx: f64, ry: f64) {
    let k = kappa()
    p.begin(cx + rx, cy)
    p.cubic(cx + rx, cy + k * ry, cx + k * rx, cy + ry, cx, cy + ry)
    p.cubic(cx - k * rx, cy + ry, cx - rx, cy + k * ry, cx - rx, cy)
    p.cubic(cx - rx, cy - k * ry, cx - k * rx, cy - ry, cx, cy - ry)
    p.cubic(cx + k * rx, cy - ry, cx + rx, cy - k * ry, cx + rx, cy)
    p.shut()
}

fn rectangle(mut p: Pen, x: f64, y: f64, w: f64, h: f64, rx: f64, ry: f64) {
    if rx <= 0.0 || ry <= 0.0 {
        p.begin(x, y)
        p.line(x + w, y)
        p.line(x + w, y + h)
        p.line(x, y + h)
        p.shut()
        return
    }
    let k = kappa()
    p.begin(x + rx, y)
    p.line(x + w - rx, y)
    p.cubic(x + w - rx + k * rx, y, x + w, y + ry - k * ry, x + w, y + ry)
    p.line(x + w, y + h - ry)
    p.cubic(x + w, y + h - ry + k * ry, x + w - rx + k * rx, y + h, x + w - rx, y + h)
    p.line(x + rx, y + h)
    p.cubic(x + rx - k * rx, y + h, x, y + h - ry + k * ry, x, y + h - ry)
    p.line(x, y + ry)
    p.cubic(x, y + ry - k * ry, x + rx - k * rx, y, x + rx, y)
    p.shut()
}
