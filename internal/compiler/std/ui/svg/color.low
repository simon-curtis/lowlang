import std/ui/geometry
import strings = std/text

fn parse_paint(attribute: str, value: str) -> Paint ! Error {
    let text = strings.lower(strings.trim(value))
    if text == "none" {
        return Paint.None
    }
    if text == "currentcolor" {
        return Paint.Current
    }
    if strings.starts_with(text, "url(") {
        return Paint.None
    }
    let color = parse_color(text) ?? fail BadValue(attribute)
    Paint.Color(color)
}

fn parse_color(text: str) -> geometry.Color? {
    if strings.starts_with(text, "#") {
        return hex_color(text[1..])
    }
    if strings.starts_with(text, "rgb(") || strings.starts_with(text, "rgba(") {
        return functional_color(text)
    }
    named_color(text)
}

fn hex_color(digits: str) -> geometry.Color? {
    var values: []i64 = []
    for c in digits {
        if c > 127 {
            return none
        }
        let v = strings.digit(u8(c), 16)
        if v < 0 {
            return none
        }
        values.push(v)
    }
    match values.len {
        3 => channels(values[0] * 17, values[1] * 17, values[2] * 17, 255)
        4 => channels(values[0] * 17, values[1] * 17, values[2] * 17, values[3] * 17)
        6 => channels(values[0] * 16 + values[1], values[2] * 16 + values[3], values[4] * 16 + values[5], 255)
        8 => channels(values[0] * 16 + values[1], values[2] * 16 + values[3], values[4] * 16 + values[5], values[6] * 16 + values[7])
        _ => none
    }
}

fn channels(r: i64, g: i64, b: i64, a: i64) -> geometry.Color {
    geometry.Color { r: f32(r) / 255.0, g: f32(g) / 255.0, b: f32(b) / 255.0, a: f32(a) / 255.0 }
}

fn functional_color(text: str) -> geometry.Color? {
    let open = strings.index_byte(text, '(')
    if !strings.ends_with(text, ")") {
        return none
    }
    let inside = text[open + 1..text.len - 1]
    var parts: []f64 = []
    var s = scanner(inside)
    s.skip_space()
    for !s.done() {
        var v = s.number() ?? return none
        let percent = s.eat('%')
        if parts.len < 3 {
            v = if percent { v * 255.0 / 100.0 } else { v }
        } else {
            v = (if percent { v / 100.0 } else { v }) * 255.0
        }
        parts.push(v)
        s.skip_space()
        if s.peek() == ',' || s.peek() == '/' {
            s.pos += 1
        }
        s.skip_space()
    }
    if parts.len != 3 && parts.len != 4 {
        return none
    }
    let alpha = if parts.len == 4 { parts[3] } else { 255.0 }
    channels(clamp_channel(parts[0]), clamp_channel(parts[1]), clamp_channel(parts[2]), clamp_channel(alpha))
}

fn clamp_channel(v: f64) -> i64 {
    if v < 0.0 {
        return 0
    }
    if v > 255.0 {
        return 255
    }
    i64(floor(v + 0.5))
}

fn named_color(name: str) -> geometry.Color? {
    match name {
        "black" => geometry.rgb(0x000000)
        "silver" => geometry.rgb(0xc0c0c0)
        "gray" => geometry.rgb(0x808080)
        "grey" => geometry.rgb(0x808080)
        "white" => geometry.rgb(0xffffff)
        "maroon" => geometry.rgb(0x800000)
        "red" => geometry.rgb(0xff0000)
        "purple" => geometry.rgb(0x800080)
        "fuchsia" => geometry.rgb(0xff00ff)
        "green" => geometry.rgb(0x008000)
        "lime" => geometry.rgb(0x00ff00)
        "olive" => geometry.rgb(0x808000)
        "yellow" => geometry.rgb(0xffff00)
        "navy" => geometry.rgb(0x000080)
        "blue" => geometry.rgb(0x0000ff)
        "teal" => geometry.rgb(0x008080)
        "aqua" => geometry.rgb(0x00ffff)
        "orange" => geometry.rgb(0xffa500)
        "transparent" => geometry.rgba(0x00000000)
        _ => none
    }
}
