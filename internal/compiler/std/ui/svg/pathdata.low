import std/ui/geometry

struct Reflection {
    x: f64
    y: f64
    kind: u8
}

fn parameters(command: u8) -> i64 {
    match command {
        'M' => 2
        'L' => 2
        'T' => 2
        'H' => 1
        'V' => 1
        'C' => 6
        'S' => 4
        'Q' => 4
        'A' => 7
        _ => 0
    }
}

fn upper(c: u8) -> u8 {
    if c >= 'a' && c <= 'z' { c - 32 } else { c }
}

fn is_command(c: u8) -> bool {
    match upper(c) {
        'M' => true
        'L' => true
        'H' => true
        'V' => true
        'C' => true
        'S' => true
        'Q' => true
        'T' => true
        'A' => true
        'Z' => true
        _ => false
    }
}

fn parse_path(text: str, matrix: Matrix) -> geometry.Path ! Error {
    var p = pen(matrix)
    var s = scanner(text)
    var last: u8 = 0
    var reflect = Reflection { x: 0.0, y: 0.0, kind: 0 }
    for {
        s.skip_space()
        if s.done() {
            break
        }
        var command = s.peek()
        if is_command(command) {
            s.pos += 1
        } else if last == 0 || upper(last) == 'Z' || !(s.peek() == '-' || s.peek() == '+' || s.peek() == '.' || is_digit(s.peek())) {
            fail BadPath(s.pos)
        } else {
            command = last
        }
        if last == 0 && upper(command) != 'M' {
            fail BadPath(s.pos - 1)
        }
        let relative = command >= 'a'
        let kind = upper(command)
        var args: []f64 = []
        let wanted = parameters(kind)
        for args.len < wanted {
            s.skip_space()
            let large_or_sweep = kind == 'A' && (args.len == 3 || args.len == 4)
            if large_or_sweep {
                let on = s.flag() ?? fail BadPath(s.pos)
                args.push(if on { 1.0 } else { 0.0 })
            } else {
                let value = s.number() ?? fail BadPath(s.pos)
                args.push(value)
            }
            s.skip_separator()
        }
        let ox = if relative { p.x } else { 0.0 }
        let oy = if relative { p.y } else { 0.0 }
        var next = Reflection { x: 0.0, y: 0.0, kind: 0 }
        match kind {
            'M' => p.begin(args[0] + ox, args[1] + oy)
            'L' => p.line(args[0] + ox, args[1] + oy)
            'H' => p.line(args[0] + ox, p.y)
            'V' => p.line(p.x, args[0] + oy)
            'C' => {
                p.cubic(args[0] + ox, args[1] + oy, args[2] + ox, args[3] + oy, args[4] + ox, args[5] + oy)
                next = Reflection { x: args[2] + ox, y: args[3] + oy, kind: 'C' }
            }
            'S' => {
                let fx = if reflect.kind == 'C' { 2.0 * p.x - reflect.x } else { p.x }
                let fy = if reflect.kind == 'C' { 2.0 * p.y - reflect.y } else { p.y }
                p.cubic(fx, fy, args[0] + ox, args[1] + oy, args[2] + ox, args[3] + oy)
                next = Reflection { x: args[0] + ox, y: args[1] + oy, kind: 'C' }
            }
            'Q' => {
                p.quad(args[0] + ox, args[1] + oy, args[2] + ox, args[3] + oy)
                next = Reflection { x: args[0] + ox, y: args[1] + oy, kind: 'Q' }
            }
            'T' => {
                let qx = if reflect.kind == 'Q' { 2.0 * p.x - reflect.x } else { p.x }
                let qy = if reflect.kind == 'Q' { 2.0 * p.y - reflect.y } else { p.y }
                p.quad(qx, qy, args[0] + ox, args[1] + oy)
                next = Reflection { x: qx, y: qy, kind: 'Q' }
            }
            'A' => p.arc(args[0], args[1], args[2], args[3] != 0.0, args[4] != 0.0, args[5] + ox, args[6] + oy)
            _ => p.shut()
        }
        reflect = next
        last = if kind == 'M' && command == 'M' {
            'L'
        } else if kind == 'M' {
            'l'
        } else {
            command
        }
    }
    p.path
}
