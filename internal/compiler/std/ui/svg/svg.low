import std/ui/geometry
import std/xml
import strings = std/text

/// What a shape's fill or stroke is painted with.
pub enum Paint {
    /// Nothing is painted.
    None
    /// The colour, whose alpha is part of it.
    Color(geometry.Color)
    /// The current colour, which the user of the icon chooses.
    Current
}

/// Why `parse` failed.
pub enum Error {
    /// The document is not well-formed XML, or exceeds a limit or uses a feature `std/xml` does not support, at `line` and `column`, counted from `1`, which are `0` when the reader gave none; `message` says why.
    Syntax(line: i64, column: i64, message: str)
    /// The root element is `name` and not `svg`.
    NotSvg(name: str)
    /// The value of `attribute` has no number at byte `at`, or has text after it.
    BadNumber(attribute: str, at: i64)
    /// The path data in a `d` attribute is wrong at byte `at`: it does not start with a move command, has an unknown command, or has missing or malformed arguments.
    BadPath(at: i64)
    /// The value of `attribute` is not a colour, a `fill-rule`, a `transform` or a view box.
    BadValue(attribute: str)
}

/// One path of an icon with how it is painted, in view box units.
pub struct Shape {
    /// The outline, with every `transform` from the shape up to the root applied.
    pub path: geometry.Path
    /// What fills the inside. An open contour is filled as if closed.
    pub fill: Paint
    /// What traces the outline.
    pub stroke: Paint
    /// The width of the stroke in view box units, scaled by the mean scale of the shape's transform.
    pub stroke_width: f32
    /// The product of the `opacity` of the shape and of the groups around it, from `0.0` to `1.0`. Each shape is faded on its own, so shapes that overlap show through each other.
    pub opacity: f32
    /// The `fill-opacity`, from `0.0` to `1.0`, which multiplies `opacity` for the fill.
    pub fill_opacity: f32
    /// The `stroke-opacity`, from `0.0` to `1.0`, which multiplies `opacity` for the stroke.
    pub stroke_opacity: f32
    /// The rule the fill follows.
    pub rule: geometry.FillRule
}

/// A parsed SVG document: the view box and the shapes in paint order.
pub struct Icon {
    /// The region of the drawing's coordinates that the icon shows: from `viewBox`, else `0 0 width height` from `width` and `height` when both are plain or `px` lengths, else `0 0 24 24`.
    pub view_box: geometry.Rect
    /// The shapes in document order, each painted over the ones before it.
    pub shapes: []Shape
}

struct Style {
    fill: Paint
    stroke: Paint
    stroke_width: f64
    opacity: f64
    fill_opacity: f64
    stroke_opacity: f64
    rule: geometry.FillRule
    matrix: Matrix
    hidden: bool
}

/// Parses `source`, the text of an SVG document, into an `Icon`.
///
/// Reads `path`, `rect`, `circle`, `ellipse`, `line`, `polyline` and `polygon`, inside any number of `g` and nested `svg` elements. Every other element, with what is inside it, is skipped, so `defs`, `use`, `title`, `style` and the gradients draw nothing.
///
/// Presentation attributes and the declarations of a `style` attribute set `fill`, `stroke`, `stroke-width`, `opacity`, `fill-opacity`, `stroke-opacity`, `fill-rule` and `display`, and every other property is ignored. A declaration in `style` wins over an attribute of the same name, and a child takes what its parent has set except for `opacity`, which multiplies down the tree, and `transform`, which composes. Colours are `#rgb`, `#rgba`, `#rrggbb`, `#rrggbbaa`, `rgb()` and `rgba()` with numbers or percentages, the sixteen CSS basic colour names with `grey`, `orange` and `transparent`, `none` and `currentColor`; a `url(...)` paint server paints nothing. The default fill is black, as SVG specifies, and the default stroke is none. A stroke is always traced with a round pen, whatever `stroke-linecap`, `stroke-linejoin` and `stroke-dasharray` say.
///
/// `transform` takes `translate`, `scale`, `rotate`, `skewX`, `skewY` and `matrix`. An arc becomes cubic curves of at most a quarter turn each. A shape that has no outline, or whose fill and stroke are both none, is left out, and so is an element with `display` of `none`.
///
/// Fails with `Syntax` when `source` is not XML, with `NotSvg` when the root is not `svg`, with `BadNumber` or `BadPath` at the byte offset in the attribute's value that could not be read, and with `BadValue` naming an attribute whose value is not understood.
pub fn parse(source: str) -> Icon ! Error {
    let root = xml.parse(bytes(source)) catch {
        Malformed(line, column, message) => fail Syntax(line, column, message)
        Limit(line, column, message) => fail Syntax(line, column, message)
        Unsupported(message) => fail Syntax(0, 0, message)
    }
    if root.name.local != "svg" {
        fail NotSvg(root.name.local)
    }
    let view_box = view_box_of(root)?
    let base = Style {
        fill: Paint.Color(geometry.rgb(0x000000))
        stroke: Paint.None
        stroke_width: 1.0
        opacity: 1.0
        fill_opacity: 1.0
        stroke_opacity: 1.0
        rule: geometry.FillRule.NonZero
        matrix: identity()
        hidden: false
    }
    var shapes: []Shape = []
    visit(root, base, mut shapes)?
    Icon { view_box, shapes }
}

fn view_box_of(root: *xml.Element) -> geometry.Rect ! Error {
    match xml.attribute(root, "viewBox") {
        some(text) => {
            let values = numbers("viewBox", text)?
            if values.len != 4 || !(values[2] > 0.0) || !(values[3] > 0.0) {
                fail BadValue("viewBox")
            }
            return geometry.rect(f32(values[0]), f32(values[1]), f32(values[2]), f32(values[3]))
        }
        none => {}
    }
    let width = size_of(root, "width")?
    let height = size_of(root, "height")?
    if width > 0.0 && height > 0.0 {
        return geometry.rect(0.0, 0.0, f32(width), f32(height))
    }
    geometry.rect(0.0, 0.0, 24.0, 24.0)
}

fn size_of(root: *xml.Element, name: str) -> f64 ! Error {
    let text = xml.attribute(root, name) ?? return 0.0
    let trimmed = strings.trim(text)
    if trimmed.len > 0 && !is_digit(trimmed[trimmed.len - 1]) && !strings.ends_with(trimmed, "px") && !strings.ends_with(trimmed, ".") {
        return 0.0
    }
    length(name, text)
}

fn visit(e: *xml.Element, parent: Style, mut shapes: []Shape) ! Error {
    var style = parent
    for a in e.attributes {
        if a.name.namespace == "" {
            declare(mut style, a.name.local, a.value)?
        }
    }
    match xml.attribute(e, "style") {
        some(text) => declarations(mut style, text)?
        none => {}
    }
    match xml.attribute(e, "transform") {
        some(text) => {
            let local = parse_transform(text)?
            style.matrix = style.matrix.times(local)
        }
        none => {}
    }
    if style.hidden {
        return
    }
    match e.name.local {
        "g" => children(e, style, mut shapes)?
        "svg" => children(e, style, mut shapes)?
        _ => {
            let found = outline(e, style.matrix)?
            match found {
                some(path) => add(mut shapes, path, style)
                none => {}
            }
        }
    }
}

fn children(e: *xml.Element, style: Style, mut shapes: []Shape) ! Error {
    for node in e.children {
        match node {
            Element(child) => visit(child, style, mut shapes)?
            _ => {}
        }
    }
}

fn add(mut shapes: []Shape, path: geometry.Path, style: Style) {
    let paints = style.fill != Paint.None || style.stroke != Paint.None && style.stroke_width > 0.0
    if !paints || geometry.segments(path).len == 0 {
        return
    }
    shapes.push(Shape {
        path
        fill: style.fill
        stroke: style.stroke
        stroke_width: f32(style.stroke_width * mean_scale(style.matrix))
        opacity: f32(style.opacity)
        fill_opacity: f32(style.fill_opacity)
        stroke_opacity: f32(style.stroke_opacity)
        rule: style.rule
    })
}

fn declarations(mut style: Style, text: str) ! Error {
    for part in strings.split(text, ';') {
        let colon = strings.index_byte(part, ':')
        if colon < 0 {
            continue
        }
        let name = strings.trim(part[..colon])
        let value = strings.trim(part[colon + 1..])
        declare(mut style, name, value)?
    }
}

fn declare(mut style: Style, name: str, raw: str) ! Error {
    let value = strings.trim(raw)
    if value == "inherit" {
        return
    }
    match name {
        "fill" => {
            style.fill = parse_paint(name, value)?
        }
        "stroke" => {
            style.stroke = parse_paint(name, value)?
        }
        "stroke-width" => {
            let width = length(name, value)?
            style.stroke_width = if width < 0.0 { 0.0 } else { width }
        }
        "opacity" => {
            let opacity = fraction(name, value)?
            style.opacity = style.opacity * opacity
        }
        "fill-opacity" => {
            style.fill_opacity = fraction(name, value)?
        }
        "stroke-opacity" => {
            style.stroke_opacity = fraction(name, value)?
        }
        "fill-rule" => {
            style.rule = match value {
                "evenodd" => geometry.FillRule.EvenOdd
                "nonzero" => geometry.FillRule.NonZero
                _ => fail BadValue(name)
            }
        }
        "display" => {
            style.hidden = value == "none"
        }
        _ => {}
    }
}

fn number_of(e: *xml.Element, name: str) -> f64 ! Error {
    let text = xml.attribute(e, name) ?? return 0.0
    length(name, text)
}

fn outline(e: *xml.Element, matrix: Matrix) -> geometry.Path? ! Error {
    match e.name.local {
        "path" => {
            let d = xml.attribute(e, "d") ?? return none
            return parse_path(d, matrix)?
        }
        "rect" => return rect_outline(e, matrix)
        "circle" => {
            let r = number_of(e, "r")?
            if !(r > 0.0) {
                return none
            }
            let cx = number_of(e, "cx")?
            let cy = number_of(e, "cy")?
            var p = pen(matrix)
            p.ellipse(cx, cy, r, r)
            return p.path
        }
        "ellipse" => {
            let rx = number_of(e, "rx")?
            let ry = number_of(e, "ry")?
            if !(rx > 0.0) || !(ry > 0.0) {
                return none
            }
            let cx = number_of(e, "cx")?
            let cy = number_of(e, "cy")?
            var p = pen(matrix)
            p.ellipse(cx, cy, rx, ry)
            return p.path
        }
        "line" => {
            let x1 = number_of(e, "x1")?
            let y1 = number_of(e, "y1")?
            let x2 = number_of(e, "x2")?
            let y2 = number_of(e, "y2")?
            var p = pen(matrix)
            p.begin(x1, y1)
            p.line(x2, y2)
            return p.path
        }
        "polyline" => return poly_outline(e, matrix, false)
        "polygon" => return poly_outline(e, matrix, true)
        _ => return none
    }
}

fn rect_outline(e: *xml.Element, matrix: Matrix) -> geometry.Path? ! Error {
    let w = number_of(e, "width")?
    let h = number_of(e, "height")?
    if !(w > 0.0) || !(h > 0.0) {
        return none
    }
    var rx = -1.0
    var ry = -1.0
    if xml.attribute(e, "rx") != none {
        rx = number_of(e, "rx")?
    }
    if xml.attribute(e, "ry") != none {
        ry = number_of(e, "ry")?
    }
    if rx < 0.0 {
        rx = if ry < 0.0 { 0.0 } else { ry }
    }
    if ry < 0.0 {
        ry = rx
    }
    if rx > w / 2.0 {
        rx = w / 2.0
    }
    if ry > h / 2.0 {
        ry = h / 2.0
    }
    let x = number_of(e, "x")?
    let y = number_of(e, "y")?
    var p = pen(matrix)
    p.rectangle(x, y, w, h, rx, ry)
    p.path
}

fn poly_outline(e: *xml.Element, matrix: Matrix, closed: bool) -> geometry.Path? ! Error {
    let text = xml.attribute(e, "points") ?? return none
    let values = numbers("points", text)?
    var p = pen(matrix)
    var i = 0
    for i + 1 < values.len {
        if i == 0 {
            p.begin(values[0], values[1])
        } else {
            p.line(values[i], values[i + 1])
        }
        i += 2
    }
    if closed {
        p.shut()
    }
    p.path
}
