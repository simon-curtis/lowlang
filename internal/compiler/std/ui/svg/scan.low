import strings = std/text

struct Scanner {
    text: str
    pos: i64
}

fn scanner(text: str) -> Scanner {
    Scanner { text, pos: 0 }
}

fn done(s: Scanner) -> bool {
    s.pos >= s.text.len
}

fn peek(s: Scanner) -> u8 {
    if s.pos < s.text.len { s.text[s.pos] } else { 0 }
}

fn eat(mut s: Scanner, c: u8) -> bool {
    if s.peek() == c {
        s.pos += 1
        return true
    }
    false
}

fn skip_space(mut s: Scanner) {
    for s.pos < s.text.len && strings.space(s.text[s.pos]) {
        s.pos += 1
    }
}

fn skip_separator(mut s: Scanner) {
    s.skip_space()
    if s.peek() == ',' {
        s.pos += 1
    }
    s.skip_space()
}

fn is_digit(c: u8) -> bool {
    c >= '0' && c <= '9'
}

fn is_letter(c: u8) -> bool {
    c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z'
}

fn word(mut s: Scanner) -> str {
    let start = s.pos
    for s.pos < s.text.len && is_letter(s.text[s.pos]) {
        s.pos += 1
    }
    s.text[start..s.pos]
}

fn digits(s: Scanner, from: i64) -> i64 {
    var i = from
    for i < s.text.len && is_digit(s.text[i]) {
        i += 1
    }
    i
}

fn number(mut s: Scanner) -> f64? {
    let start = s.pos
    var i = start
    if i < s.text.len && (s.text[i] == '+' || s.text[i] == '-') {
        i += 1
    }
    let whole = digits(s, i)
    var end = whole
    var after_point = 0
    if whole < s.text.len && s.text[whole] == '.' {
        end = digits(s, whole + 1)
        after_point = end - whole - 1
    }
    if whole - i + after_point == 0 {
        return none
    }
    i = end
    if i < s.text.len && (s.text[i] == 'e' || s.text[i] == 'E') {
        var j = i + 1
        if j < s.text.len && (s.text[j] == '+' || s.text[j] == '-') {
            j += 1
        }
        let stop = digits(s, j)
        if stop > j {
            i = stop
        }
    }
    let value = strings.parse_float(s.text[start..i]) or return none
    s.pos = i
    value
}

fn flag(mut s: Scanner) -> bool? {
    let c = s.peek()
    if c == '0' || c == '1' {
        s.pos += 1
        return c == '1'
    }
    none
}

fn length(attribute: str, text: str) -> f64 ! Error {
    var s = scanner(text)
    s.skip_space()
    let value = s.number() ?? fail BadNumber(attribute, s.pos)
    if strings.starts_with(s.text[s.pos..], "px") {
        s.pos += 2
    }
    s.skip_space()
    if !s.done() {
        fail BadNumber(attribute, s.pos)
    }
    value
}

fn fraction(attribute: str, text: str) -> f64 ! Error {
    var s = scanner(text)
    s.skip_space()
    var value = s.number() ?? fail BadNumber(attribute, s.pos)
    if s.eat('%') {
        value /= 100.0
    }
    s.skip_space()
    if !s.done() {
        fail BadNumber(attribute, s.pos)
    }
    if value < 0.0 {
        return 0.0
    }
    if value > 1.0 {
        return 1.0
    }
    value
}

fn numbers(attribute: str, text: str) -> []f64 ! Error {
    var out: []f64 = []
    var s = scanner(text)
    s.skip_space()
    for !s.done() {
        let value = s.number() ?? fail BadNumber(attribute, s.pos)
        out.push(value)
        s.skip_separator()
    }
    out
}
