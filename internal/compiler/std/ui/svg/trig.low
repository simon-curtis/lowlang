struct Turn {
    sin: f64
    cos: f64
}

fn pi() -> f64 {
    3.141592653589793
}

fn absolute(v: f64) -> f64 {
    if v < 0.0 { -v } else { v }
}

fn turn(degrees: f64) -> Turn {
    let quarters = floor(degrees / 90.0 + 0.5)
    let r = (degrees - quarters * 90.0) * pi() / 180.0
    let r2 = r * r
    var s = r
    var c = 1.0
    var sine_term = r
    var cosine_term = 1.0
    for n in 0..12 {
        let k = f64(2 * n)
        cosine_term = -cosine_term * r2 / ((k + 1.0) * (k + 2.0))
        sine_term = -sine_term * r2 / ((k + 2.0) * (k + 3.0))
        c += cosine_term
        s += sine_term
    }
    match (i64(quarters) % 4 + 4) % 4 {
        0 => Turn { sin: s, cos: c }
        1 => Turn { sin: c, cos: -s }
        2 => Turn { sin: -s, cos: -c }
        _ => Turn { sin: -c, cos: s }
    }
}

fn atan_series(t: f64) -> f64 {
    let t2 = t * t
    var power = t
    var sum = t
    for n in 1..24 {
        power = -power * t2
        sum += power / f64(2 * n + 1)
    }
    sum
}

fn atan_unit(t: f64) -> f64 {
    if t > 0.2679491924311227 {
        let k = 0.5773502691896257
        return pi() / 6.0 + atan_series((t - k) / (1.0 + k * t))
    }
    atan_series(t)
}

fn atan2_degrees(y: f64, x: f64) -> f64 {
    let ax = absolute(x)
    let ay = absolute(y)
    if ax == 0.0 && ay == 0.0 {
        return 0.0
    }
    var a = if ax >= ay { atan_unit(ay / ax) } else { pi() / 2.0 - atan_unit(ax / ay) }
    if x < 0.0 {
        a = pi() - a
    }
    if y < 0.0 {
        a = -a
    }
    a * 180.0 / pi()
}
