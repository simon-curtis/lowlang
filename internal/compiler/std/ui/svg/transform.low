import std/ui/geometry

struct Matrix {
    a: f64
    b: f64
    c: f64
    d: f64
    e: f64
    f: f64
}

fn identity() -> Matrix {
    Matrix { a: 1.0, b: 0.0, c: 0.0, d: 1.0, e: 0.0, f: 0.0 }
}

fn times(m: Matrix, n: Matrix) -> Matrix {
    Matrix {
        a: m.a * n.a + m.c * n.b
        b: m.b * n.a + m.d * n.b
        c: m.a * n.c + m.c * n.d
        d: m.b * n.c + m.d * n.d
        e: m.a * n.e + m.c * n.f + m.e
        f: m.b * n.e + m.d * n.f + m.f
    }
}

fn place(m: Matrix, x: f64, y: f64) -> geometry.Point {
    geometry.point(f32(m.a * x + m.c * y + m.e), f32(m.b * x + m.d * y + m.f))
}

fn mean_scale(m: Matrix) -> f64 {
    sqrt(absolute(m.a * m.d - m.b * m.c))
}

fn translation(x: f64, y: f64) -> Matrix {
    Matrix { a: 1.0, b: 0.0, c: 0.0, d: 1.0, e: x, f: y }
}

fn parse_transform(text: str) -> Matrix ! Error {
    var total = identity()
    var s = scanner(text)
    s.skip_separator()
    for !s.done() {
        let name = s.word()
        s.skip_space()
        if !s.eat('(') {
            fail BadValue("transform")
        }
        var args: []f64 = []
        for {
            s.skip_space()
            if s.eat(')') {
                break
            }
            let value = s.number() ?? fail BadNumber("transform", s.pos)
            args.push(value)
            s.skip_separator()
        }
        let step = operation(name, args)?
        total = total.times(step)
        s.skip_separator()
    }
    total
}

fn operation(name: str, args: []f64) -> Matrix ! Error {
    match name {
        "translate" => {
            if args.len != 1 && args.len != 2 {
                fail BadValue("transform")
            }
            translation(args[0], if args.len == 2 { args[1] } else { 0.0 })
        }
        "scale" => {
            if args.len != 1 && args.len != 2 {
                fail BadValue("transform")
            }
            Matrix { a: args[0], b: 0.0, c: 0.0, d: if args.len == 2 { args[1] } else { args[0] }, e: 0.0, f: 0.0 }
        }
        "rotate" => {
            if args.len != 1 && args.len != 3 {
                fail BadValue("transform")
            }
            let t = turn(args[0])
            let spin = Matrix { a: t.cos, b: t.sin, c: -t.sin, d: t.cos, e: 0.0, f: 0.0 }
            if args.len == 1 {
                spin
            } else {
                translation(args[1], args[2]).times(spin).times(translation(-args[1], -args[2]))
            }
        }
        "skewX" => {
            if args.len != 1 {
                fail BadValue("transform")
            }
            let t = turn(args[0])
            Matrix { a: 1.0, b: 0.0, c: t.sin / t.cos, d: 1.0, e: 0.0, f: 0.0 }
        }
        "skewY" => {
            if args.len != 1 {
                fail BadValue("transform")
            }
            let t = turn(args[0])
            Matrix { a: 1.0, b: t.sin / t.cos, c: 0.0, d: 1.0, e: 0.0, f: 0.0 }
        }
        "matrix" => {
            if args.len != 6 {
                fail BadValue("transform")
            }
            Matrix { a: args[0], b: args[1], c: args[2], d: args[3], e: args[4], f: args[5] }
        }
        _ => fail BadValue("transform")
    }
}
