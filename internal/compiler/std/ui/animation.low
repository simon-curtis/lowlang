/// How an element built by `with_animation` changes over time.
pub struct Animation {
    /// How long one run lasts, in milliseconds.
    pub duration_ms: i64 = 250
    /// `true` to start again from the beginning at the end of each run, for ever.
    pub repeat: bool = false
    /// Maps the linear progress, from `0.0` to `1.0`, to the progress given to the element.
    pub easing: fn(f32) -> f32 = linear
}

/// Returns `t` unchanged.
pub fn linear(t: f32) -> f32 {
    t
}

/// Returns `t` squared: slow at the start, fast at the end.
pub fn quadratic(t: f32) -> f32 {
    t * t
}

/// Returns `t` eased quadratically in and out: slow at both ends.
pub fn ease_in_out(t: f32) -> f32 {
    if t < 0.5 {
        2.0 * t * t
    } else {
        let u = 2.0 - 2.0 * t
        1.0 - u * u / 2.0
    }
}

/// Returns `t` eased out by a fifth power: fast at the start, settling at the end.
pub fn ease_out_quint(t: f32) -> f32 {
    let u = 1.0 - t
    1.0 - u * u * u * u * u
}

/// Returns an easing that runs `easing` forward over the first half and back over the second.
pub fn bounce(easing: fn(f32) -> f32) -> fn(f32) -> f32 {
    fn(t: f32) -> f32 {
        if t < 0.5 { easing(t * 2.0) } else { easing((1.0 - t) * 2.0) }
    }
}

/// Returns an easing that breathes smoothly between `low` and `high` once a run, starting halfway.
pub fn pulsating_between(low: f32, high: f32) -> fn(f32) -> f32 {
    fn(t: f32) -> f32 {
        let s = sine(t)
        let breath = (s * s * s + s) / 2.0
        low + (high - low) * (breath + 1.0) / 2.0
    }
}

fn sine(turns: f32) -> f32 {
    let whole = f32(i64(turns))
    var x = (turns - whole) * 6.2831855
    if x > 3.1415927 {
        x -= 6.2831855
    } else if x < -3.1415927 {
        x += 6.2831855
    }
    let x2 = x * x
    var term = x
    var sum = x
    for n in 1..8 {
        term = -term * x2 / f32((2 * n) * (2 * n + 1))
        sum += term
    }
    sum
}
