import std/ui/font
import std/ui/geometry
import std/ui/gpu
import std/ui/platform
import std/ui/scene
import uitext = std/ui/text

/// What `open` needs to make an application window.
pub struct Options {
    /// The window title.
    pub title: str = "Low"
    /// The width of the window's content in logical pixels.
    pub width: i64 = 800
    /// The height of the window's content in logical pixels.
    pub height: i64 = 600
    /// Who should draw the title bar and borders; with `Client` the program draws them, as with `window_control_area`.
    pub decorations: platform.Decorations = platform.Decorations.Server
    /// The colour every frame is cleared to before the elements are drawn.
    pub background: geometry.Color = geometry.rgb(0xffffff)
}

/// Why an application could not open its window or draw into it.
pub enum Error {
    /// The window could not be opened or serviced.
    Platform(platform.Error)
    /// The GPU could not be opened or could not draw.
    Gpu(gpu.Error)
}

/// A window, the GPU that draws into it and the context of its user interface.
///
/// Releasing an `App` releases the GPU, then the window.
pub struct App {
    gpu: gpu.Gpu
    window: platform.Window
    faces: []font.Face
    /// The context the application's signals and frames belong to.
    pub cx: Context
}

/// Opens a window with `o`'s title and size and a GPU that draws into it.
pub fn open(o: Options) -> App ! Error {
    using window = platform.open(window_options(o)) catch Platform
    let native = platform.native(window)
    using g = gpu.open_for(gpu.Surface { display: native.display, window: native.window }) catch Gpu
    let faces = font.discover()
    let cx = window_context(window, faces, o.background)
    App { gpu: g, window, faces, cx }
}

/// A copyable view of an `App`'s GPU and fonts, from which `open_window` opens more windows on any green thread.
pub struct Shared {
    gpu: gpu.Shared
    faces: []font.Face
}

/// Returns the view of `app` that `open_window` takes.
pub fn shared(app: App) -> Shared {
    Shared { gpu: gpu.shared(app.gpu), faces: app.faces }
}

/// Opens another window with `o`'s title and size that draws with the GPU and fonts of the `App` behind `from`.
///
/// The window has its own context, so its signals belong to the green thread that runs it, and other windows reach it through its `Handle`. Open it on the green thread that runs it. The windows may be released in any order.
pub fn open_window(from: Shared, o: Options) -> App ! Error {
    using window = platform.open(window_options(o)) catch Platform
    let native = platform.native(window)
    using g = gpu.open_beside(from.gpu, gpu.Surface { display: native.display, window: native.window }) catch Gpu
    let cx = window_context(window, from.faces, o.background)
    App { gpu: g, window, faces: from.faces, cx }
}

fn window_options(o: Options) -> platform.Options {
    platform.Options { title: o.title, width: o.width, height: o.height, decorations: o.decorations }
}

fn window_context(window: platform.Window, faces: []font.Face, background: geometry.Color) -> Context {
    let cx = headless(background)
    cx.state.text = uitext.system_of(faces)
    cx.state.waker = platform.waker(window)
    let clipboard = platform.clipboard(window)
    cx.state.clipboard = SystemClipboard {
        write: fn(text: str) ! platform.Error { platform.write_clipboard(clipboard, text)? }
        read: fn() -> str? ! platform.Error { platform.read_clipboard(clipboard)? }
    }
    cx.state.launches_urls = true
    cx.state.decorations = platform.decorations(window)
    cx.state.status = platform.status(window)
    let controls = platform.controls(window)
    cx.state.controls = WindowControls {
        start_move: fn() platform.start_move(controls)
        start_resize: fn(edge: platform.ResizeEdge) platform.start_resize(controls, edge)
        show_menu: fn(x: f32, y: f32) platform.show_window_menu(controls, x, y)
        set_maximized: fn(maximized: bool) platform.set_maximized(controls, maximized)
        set_fullscreen: fn(fullscreen: bool) platform.set_fullscreen(controls, fullscreen)
        minimize: fn() platform.minimize(controls)
        set_title: fn(title: str) platform.set_title(controls, title)
    }
    cx
}

/// Runs the window until it is closed: waits for events, dispatches them, and when a frame is due builds the tree `render` returns, lays it out, paints it and presents it.
pub fn run(app: App, render: fn() -> Element) ! Error {
    let st = app.cx.state
    for !st.closed {
        let wait = if st.dirty && st.width > 0.0 && st.height > 0.0 { 0 } else { -1 }
        let events = platform.next(app.window, wait) catch Platform
        for e in events {
            dispatch(app.cx, e)
        }
        drain(st)
        flush_effects(st)
        if st.dirty && !st.closed && st.width > 0.0 && st.height > 0.0 {
            let size = geometry.size(st.width, st.height)
            let sc = frame(app.cx, render, size, st.scale)
            gpu.present(app.gpu, sc, mut st.text.atlas) catch Gpu
        }
        platform.set_cursor(app.window, current_cursor(app.cx))
        platform.set_text_input(app.window, input_caret(app.cx))
    }
}

/// Draws `s`, a scene that `frame` returned for `cx`, into the offscreen target `t`, uploading the glyphs it needs.
pub fn draw(cx: Context, g: gpu.Gpu, t: gpu.Target, s: scene.Scene) ! gpu.Error {
    gpu.render(g, t, s, mut cx.state.text.atlas)?
}

/// Returns the opaque colour written as `0xRRGGBB`.
pub fn rgb(hex: u32) -> geometry.Color {
    geometry.rgb(hex)
}

/// Returns the colour written as `0xRRGGBBAA`.
pub fn rgba(hex: u32) -> geometry.Color {
    geometry.rgba(hex)
}
