import std/ui
import std/ui/geometry
import std/ui/platform
import std/ui/svg
import strings = std/text

/// Returns the height of a window's title bar: 40 pixels.
pub fn title_height() -> f32 {
    40.0
}

/// Returns the height of a bar of controls: 40 pixels.
pub fn bar_height() -> f32 {
    40.0
}

/// Returns the height of a panel's header: 36 pixels.
pub fn header_height() -> f32 {
    36.0
}

/// Returns the height of a line of information: 38 pixels.
pub fn info_height() -> f32 {
    38.0
}

/// Returns the distance floating things keep from the edges of the window: 12 pixels.
pub fn float_inset() -> f32 {
    12.0
}

/// Returns the side of a rail button: 34 pixels.
pub fn rail_button_size() -> f32 {
    34.0
}

/// Returns the width of a rail: 48 pixels.
pub fn rail_width() -> f32 {
    48.0
}

/// Returns the side of the icon on a rail button: 16 pixels.
pub fn rail_icon_size() -> f32 {
    16.0
}

/// Returns the height of a tab: 30 pixels.
pub fn tab_height() -> f32 {
    30.0
}

/// Returns the height of a status strip: 28 pixels.
pub fn status_height() -> f32 {
    28.0
}

/// Returns the side of the brand mark: 24 pixels.
pub fn mark_size() -> f32 {
    24.0
}

fn is_key(k: platform.KeyEvent, name: platform.NamedKey) -> bool {
    k.key == platform.Key.Named(name)
}

fn fixed(e: ui.Element) -> ui.Element {
    e.shrink(0.0)
}

fn transparent() -> geometry.Color {
    geometry.Color {}
}

fn pointer(e: ui.Element) -> ui.Element {
    e.cursor(platform.Cursor.Pointer)
}

fn washed(e: ui.Element, wash: geometry.Color) -> ui.Element {
    e.hover(fn(v: ui.Visual) -> ui.Visual { v.with_background(wash) })
}

fn dimmed(e: ui.Element) -> ui.Element {
    e.hover(fn(v: ui.Visual) -> ui.Visual { v.with_opacity(0.9) })
}

fn brightened(e: ui.Element, ink: geometry.Color) -> ui.Element {
    e.hover(fn(v: ui.Visual) -> ui.Visual { v.with_text_color(ink) })
}

fn tooltip_text(label: str) -> ui.Element {
    ui.text(label).padding_x(8.0).padding_y(4.0).background(raised()).border(1.0, border_colour()).rounded(radius()).shadow(popover_shadow()).text_size(size_caption()).text_color(text_colour()).whitespace_nowrap()
}

fn tipped(e: ui.Element, label: str) -> ui.Element {
    e.tooltip(fn() -> ui.Element { tooltip_text(label) })
}

/// Returns `icon`, 14 pixels square, in `colour`.
pub fn small_icon(icon: svg.Icon, colour: geometry.Color) -> ui.Element {
    fixed(ui.svg_icon(icon).size(14.0, 14.0).text_color(colour))
}

/// Returns a square button of the muted `icon` with the tooltip `tip`.
pub fn icon_button(name: str, icon: svg.Icon, tip: str, clicked: fn(ui.ClickEvent)) -> ui.Element {
    tool_icon(name, icon, muted(), tip, clicked)
}

/// Returns a square button of `icon` in `colour` with the tooltip `tip`.
pub fn tool_icon(name: str, icon: svg.Icon, colour: geometry.Color, tip: str, clicked: fn(ui.ClickEvent)) -> ui.Element {
    let glyph = fixed(ui.svg_icon(icon).size(16.0, 16.0).text_color(colour))
    let button = fixed(ui.div().id(name).items_center().justify_center().size(control_height(), control_height()).rounded(radius()))
    pointer(washed(button, hovered())).on_click(clicked).child(glyph).tipped(tip)
}

/// Returns a square button of `icon` that is lit in the accent of `th` while `on`, with the tooltip `tip`.
pub fn toggle_button(th: Theme, name: str, icon: svg.Icon, on: bool, tip: str, clicked: fn(ui.ClickEvent)) -> ui.Element {
    let ink = if on { accent(th) } else { muted() }
    let glyph = fixed(ui.svg_icon(icon).size(16.0, 16.0).text_color(ink))
    var button = fixed(ui.div().id(name).items_center().justify_center().size(control_height(), control_height()).rounded(radius()))
    if on {
        button = button.background(accent_soft(th))
    }
    pointer(washed(button, hovered())).on_click(clicked).child(glyph).tipped(tip)
}

/// Returns the column of buttons down the side of a window, to which the caller adds `rail_button`s and `divider`s.
pub fn rail() -> ui.Element {
    fixed(ui.div().column().items_center().gap(6.0).padding_edges(geometry.Edges { top: 4.0 }).width(rail_width()))
}

/// Returns a button of `icon` for a rail that is `on` for the view it shows, with the tooltip `tip`.
pub fn rail_button(name: str, icon: svg.Icon, on: bool, tip: str, clicked: fn(ui.ClickEvent)) -> ui.Element {
    let ink = if on { text_colour() } else { muted() }
    let glyph = fixed(ui.svg_icon(icon).size(rail_icon_size(), rail_icon_size()).text_color(ink))
    let button = fixed(ui.div().id(name).items_center().justify_center().size(rail_button_size(), rail_button_size()).rounded(radius_lg())).cursor(platform.Cursor.Pointer)
    let lit = if on { button.background(rail_selected()) } else { washed(button, hovered()) }
    lit.on_click(clicked).child(glyph).tipped(tip)
}

/// Returns a thin vertical line between buttons.
pub fn divider() -> ui.Element {
    fixed(ui.div().width(1.0).height(16.0).margin_x(4.0).background(border_colour()))
}

fn tool(name: str, icon: svg.Icon, ink: geometry.Color, label: str, tip: str) -> ui.Element {
    let glyph = small_icon(icon, ink)
    let words = ui.text(label)
    fixed(ui.div().id(name).items_center().gap(6.0).height(control_height()).padding_x(8.0).rounded(radius()).whitespace_nowrap().text_size(size_small()).children([glyph, words])).tipped(tip)
}

/// Returns a button of `icon` and `label` in the accent of `th`, with the tooltip `tip`.
pub fn primary_tool(th: Theme, name: str, icon: svg.Icon, label: str, tip: str, clicked: fn(ui.ClickEvent)) -> ui.Element {
    let base = tool(name, icon, on_accent(), label, tip).padding_x(10.0).font_weight(500).background(accent(th)).text_color(on_accent())
    pointer(dimmed(base)).on_click(clicked)
}

/// Returns a button of `icon` in `icon_colour` and `label`, with the tooltip `tip`.
pub fn tool_button(name: str, icon: svg.Icon, icon_colour: geometry.Color, label: str, tip: str, clicked: fn(ui.ClickEvent)) -> ui.Element {
    let base = tool(name, icon, icon_colour, label, tip).text_color(text_colour())
    pointer(washed(base, hovered())).on_click(clicked)
}

/// How prominent a `button` is.
pub enum Kind {
    /// Filled with the accent.
    Primary
    /// Outlined.
    Secondary
}

/// Returns a button of `label`: filled with the accent of `th` for `Primary` and outlined for `Secondary`.
pub fn button(th: Theme, name: str, label: str, kind: Kind, clicked: fn(ui.ClickEvent)) -> ui.Element {
    let base = fixed(ui.div().id(name).items_center().justify_center().gap(8.0).height(control_height()).padding_x(12.0).rounded(radius()).whitespace_nowrap().text_size(size_text()).font_weight(500))
    let styled = match kind {
        Primary => dimmed(base.background(accent(th)).text_color(on_accent()))
        Secondary => washed(base.border(1.0, border_colour()).text_color(text_colour()), hovered())
    }
    pointer(styled).on_click(clicked).child(ui.text(label))
}

/// Returns `b`, a button, drawn as one that cannot be used.
pub fn unavailable(b: ui.Element) -> ui.Element {
    b.background(control()).text_color(faint()).cursor(platform.Cursor.Arrow)
}

/// Returns a row of a list with the id `name`, highlighted when `on`, to which the caller adds children and `on_click`.
pub fn list_row(name: str, on: bool) -> ui.Element {
    let base = fixed(ui.div().id(name).items_center().gap(8.0).height(control_height()).padding_x(8.0).rounded(radius()).text_size(size_text()).overflow_hidden())
    let pointed = pointer(base)
    if on {
        return pointed.background(selected()).text_color(text_colour())
    }
    let calm = pointed.text_color(muted())
    washed(brightened(calm, text_colour()), hovered())
}

/// Returns a group of `items`, made with `segment`, of which one is selected.
pub fn segmented(items: []ui.Element) -> ui.Element {
    fixed(ui.div().gap(2.0).padding(2.0).rounded(radius()).background(control()).children(items))
}

/// Returns a segment of a `segmented` group, selected when `on`.
pub fn segment(name: str, label: str, on: bool, clicked: fn(ui.ClickEvent)) -> ui.Element {
    let base = pointer(ui.div().id(name).items_center().justify_center().height(control_height() - 4.0).padding_x(10.0).rounded(radius()).text_size(size_small()).border(1.0, transparent()))
    let styled = if on {
        base.background(rail_selected()).border(1.0, border_colour()).text_color(text_colour()).font_weight(500)
    } else {
        brightened(base.text_color(muted()), text_colour())
    }
    styled.on_click(clicked).child(ui.text(label))
}

/// Returns a row of `items`, made with `tab`.
pub fn tabs(items: []ui.Element) -> ui.Element {
    fixed(ui.div().gap(16.0).height_full().min_height(tab_height()).children(items))
}

/// Returns a tab of `label` underlined in the accent of `th` when `on`.
pub fn tab(th: Theme, name: str, label: str, on: bool, clicked: fn(ui.ClickEvent)) -> ui.Element {
    let underline = geometry.Edges { bottom: 2.0 }
    let base = pointer(fixed(ui.div().id(name).items_center().height_full().padding_x(2.0).whitespace_nowrap().text_size(size_small())))
    let styled = if on {
        base.border_edges(underline, accent(th)).text_color(text_colour()).font_weight(500)
    } else {
        brightened(base.border_edges(underline, transparent()).text_color(muted()), text_colour())
    }
    styled.on_click(clicked).child(ui.text(label))
}

/// Returns a drop-down that shows `label`, or `placeholder` while `label` is `none`, behind `icon`, and calls `on_click` to open whatever it chooses from.
pub fn dropdown(name: str, icon: svg.Icon, label: str?, placeholder: str, clicked: fn(ui.ClickEvent)) -> ui.Element {
    let shown = label ?? placeholder
    let ink = if label == none { faint() } else { text_colour() }
    let words = ui.div().flex_1().min_width(0.0).overflow_hidden().text_ellipsis().whitespace_nowrap().text_color(ink).child(ui.text(shown))
    let base = fixed(ui.div().id(name).items_center().gap(8.0).min_width(150.0).max_width(260.0).height(control_height()).padding_edges(geometry.Edges { left: 8.0, right: 6.0 }).rounded(radius()).background(control()).border(1.0, border_colour()).text_size(size_small()))
    let parts = [small_icon(icon, muted()), words, small_icon(chevrons_up_down_icon(), faint())]
    pointer(washed(base, selected())).on_click(clicked).children(parts)
}

/// Returns a centred stack of a disc holding `icon`, the heading `title` and the paragraph `body`, for a view with nothing in it.
pub fn empty_state(icon: svg.Icon, title: str, body: str) -> ui.Element {
    let disc = fixed(ui.div().items_center().justify_center().size(48.0, 48.0).rounded(24.0).background(control()).child(ui.svg_icon(icon).size(22.0, 22.0).text_color(muted())))
    let heading = ui.text(title).text_size(size_title()).font_weight(600).text_color(text_colour())
    let paragraph = ui.text(body).max_width(420.0).text_size(size_small()).text_color(muted()).text_center()
    ui.div().column().items_center().justify_center().gap(8.0).size_full().padding(24.0).children([disc, heading, paragraph])
}

/// Returns a tick box beside `label`, ticked in the accent of `th` when `on`.
pub fn checkbox(th: Theme, name: str, label: str, on: bool, clicked: fn(ui.ClickEvent)) -> ui.Element {
    let box = fixed(ui.div().items_center().justify_center().size(15.0, 15.0).rounded(4.0))
    let drawn = if on {
        box.background(accent(th)).border(1.0, accent(th)).child(ui.svg_icon(check_icon()).size(11.0, 11.0).text_color(on_accent()))
    } else {
        box.background(control()).border(1.0, faint())
    }
    pointer(ui.div().id(name).items_center().gap(6.0).height(24.0).text_size(size_small())).on_click(clicked).children([drawn, ui.text(label)])
}

/// Returns a small rounded label of `label` in `colour` on a faint wash of it.
pub fn pill(label: str, colour: geometry.Color) -> ui.Element {
    fixed(ui.div().items_center().height(18.0).padding_x(7.0).rounded(9.0).background(faded(colour, 0.14)).text_size(size_caption()).font_weight(500).text_color(colour).child(ui.text(label)))
}

/// Returns the small bold heading of a field.
pub fn field_label(label: str) -> ui.Element {
    ui.text(label).text_size(size_caption()).font_weight(600).text_color(muted())
}

/// Returns a raised, bordered, rounded box with a shadow, to which the caller adds children.
pub fn popover() -> ui.Element {
    ui.div().background(raised()).border(1.0, border_colour()).rounded(radius_lg()).shadow(popover_shadow()).text_color(text_colour())
}

/// Returns a one-line text input editing `f` with the id `name`, which shows `placeholder` in faint text while empty and a ring in the accent of `th` while it has focus.
///
/// Its selection is drawn in the colour `std/ui` gives every text field.
pub fn input(th: Theme, cx: ui.Context, f: ui.TextField, name: str, placeholder: str) -> ui.Element {
    let ring = accent(th)
    let line = bare_input(cx, f, name, placeholder)
    ui.div().padding_x(8.0).height(control_height()).rounded(radius()).background(input_fill()).border(1.0, border_colour()).text_size(size_text()).text_color(text_colour())
        .in_focus(fn(v: ui.Visual) -> ui.Visual { v.with_border_color(ring) }).child(line)
}

fn bare_input(cx: ui.Context, f: ui.TextField, name: str, placeholder: str) -> ui.Element {
    let line = ui.field(cx, f, name, size_text()).width_full().height_full().items_center()
    var layers: []ui.Element = [line]
    if f.field_value().text == "" {
        let hint = ui.div().absolute().inset(0.0).items_center().child(ui.text(placeholder).text_color(faint()).whitespace_nowrap())
        layers.push(hint)
    }
    ui.div().relative().flex_1().min_width(0.0).children(layers)
}

/// Returns `input` under the heading `label`.
pub fn field(th: Theme, cx: ui.Context, label: str, f: ui.TextField, name: str, placeholder: str) -> ui.Element {
    ui.div().column().gap(6.0).children([field_label(label), input(th, cx, f, name, placeholder)])
}

/// Returns `dialog` centred over a dimming layer that covers its parent, which should be `relative`, and takes every pointer press.
pub fn scrim(dialog: ui.Element) -> ui.Element {
    ui.div().id("dialog-scrim").absolute().inset(0.0).occlude().items_center().justify_center().background(scrim_colour()).child(dialog)
}

/// Returns a key cap showing `label`.
pub fn kbd(label: str) -> ui.Element {
    fixed(ui.div().items_center().justify_center().min_width(24.0).height(20.0).padding_x(6.0).rounded(4.0).background(control()).border(1.0, border_colour()).text_size(size_caption()).text_color(muted()).child(ui.text(label)))
}

/// Returns key caps for `chord`: steps separated by spaces, each a group of keys joined by `+`, shown with `then` between the steps, so `ctrl+k ctrl+s` is two groups of two caps.
pub fn keys(chord: str) -> ui.Element {
    var parts: []ui.Element = []
    var first = true
    for step in strings.split(chord, ' ') {
        if !first {
            parts.push(ui.text("then").text_size(size_caption()).text_color(faint()))
        }
        first = false
        var caps: []ui.Element = []
        for key in strings.split(step, '+') {
            caps.push(kbd(key))
        }
        parts.push(ui.div().gap(3.0).children(caps))
    }
    fixed(ui.div().items_center().gap(8.0).children(parts))
}

/// Returns a line of faint `text` for a list with nothing in it.
pub fn empty(text: str) -> ui.Element {
    ui.text(text).padding_x(8.0).padding_y(6.0).text_size(size_text()).text_color(faint())
}

/// Returns a row along the bottom of a window, to which the caller adds children.
pub fn status_strip() -> ui.Element {
    fixed(ui.div().items_center().gap(16.0).height(status_height()).padding_x(12.0).border_edges(geometry.Edges { top: 1.0 }, border_colour()).text_size(size_small()).text_color(muted()))
}

/// Returns a surface for content: filled, bordered and rounded, to which the caller adds children.
pub fn card() -> ui.Element {
    ui.div().background(surface()).border(1.0, border_colour()).rounded(radius_lg())
}

fn development_badge() -> ui.Element {
    ui.text("dev").absolute().right(-7.0).bottom(-3.0).padding_x(3.0).rounded(100.0).background(text_colour()).text_color(on_accent()).text_size(9.0).line_height(11.0).font_weight(700)
}

/// Returns the application's mark, `image` drawn 24 pixels square in a slot as wide as a rail, with a `dev` badge on it while `development`.
pub fn brand(image: ui.RenderImage, development: bool) -> ui.Element {
    let picture = ui.img(image).size_full()
    let mark = fixed(ui.div().relative().size(mark_size(), mark_size()))
    let marked = if development { mark.children([picture, development_badge()]) } else { mark.child(picture) }
    fixed(ui.div().items_center().justify_center().width(rail_width()).child(marked))
}

/// Returns a flexible box that moves the window when dragged, for the empty part of a title bar.
pub fn drag_area() -> ui.Element {
    ui.div().flex_1().height_full().window_control_area(Drag)
}

fn caption(name: str, icon: svg.Icon, area: ui.WindowControlArea, wash: geometry.Color) -> ui.Element {
    washed(ui.div().id(name).items_center().justify_center().width(46.0).height_full().window_control_area(area), wash).child(ui.svg_icon(icon).size(14.0, 14.0).text_color(muted()))
}

/// Returns the minimize, maximize or restore, and close buttons of a window that draws its own decorations.
pub fn caption_controls(cx: ui.Context) -> ui.Element {
    let maximized = cx.window_status().maximized
    let size_icon = if maximized { window_restore_icon() } else { window_maximize_icon() }
    let minimize = caption("caption-min", window_minimize_icon(), Minimize, hovered())
    let maximize = caption("caption-max", size_icon, Maximize, hovered())
    let close = caption("caption-close", window_close_icon(), Close, ui.rgb(0xc42b1c))
    fixed(ui.div().height_full().children([minimize, maximize, close]))
}
