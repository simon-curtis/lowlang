/// An accent colour and the four colours that glow behind a window.
pub struct Scheme {
    /// The name `theme` looks a scheme up by, such as `pink`.
    pub name: str
    /// The name people see, such as `Pink`.
    pub label: str
    /// The accent, written `0xRRGGBB`.
    pub accent: u32
    /// The colours of the four glows, written `0xRRGGBB`.
    pub glows: []u32
}

fn scheme_of(name: str, label: str, accent: u32, first: u32, second: u32, third: u32, fourth: u32) -> Scheme {
    Scheme { name, label, accent, glows: [first, second, third, fourth] }
}

/// Returns the twelve schemes: violet, indigo, blue, cyan, teal, green, lime, amber, orange, rose, pink and slate.
pub fn schemes() -> []Scheme {
    [
        scheme_of("violet", "Violet", 0x9d8cf6, 0x7c5cff, 0x4863eb, 0xc456d6, 0x38bdf8)
        scheme_of("indigo", "Indigo", 0x8392ff, 0x4f5bff, 0x3b82f6, 0x8b5cf6, 0x22d3ee)
        scheme_of("blue", "Blue", 0x5ea4ff, 0x2f6fff, 0x1fb6ff, 0x6366f1, 0x2dd4bf)
        scheme_of("cyan", "Cyan", 0x41c9e6, 0x06b6d4, 0x3b82f6, 0x14b8a6, 0x818cf8)
        scheme_of("teal", "Teal", 0x34c6a8, 0x14b8a6, 0x0ea5e9, 0x10b981, 0x6366f1)
        scheme_of("green", "Green", 0x52c98e, 0x22c55e, 0x14b8a6, 0x84cc16, 0x0ea5e9)
        scheme_of("lime", "Lime", 0xa6d44a, 0x84cc16, 0x22c55e, 0xeab308, 0x14b8a6)
        scheme_of("amber", "Amber", 0xf5b84f, 0xf59e0b, 0xf97316, 0xeab308, 0xef4444)
        scheme_of("orange", "Orange", 0xf68d52, 0xf97316, 0xef4444, 0xf59e0b, 0xec4899)
        scheme_of("rose", "Rose", 0xf2687f, 0xf43f5e, 0xd946ef, 0xfb7185, 0xf97316)
        scheme_of("pink", "Pink", 0xe874d9, 0xec4899, 0xa855f7, 0xf472b6, 0x6366f1)
        scheme_of("slate", "Slate", 0xaab3c5, 0x64748b, 0x475569, 0x94a3b8, 0x334155)
    ]
}

/// Returns the scheme `theme` falls back to for a name it does not know: `pink`.
pub fn default_scheme() -> Scheme {
    schemes()[10]
}
