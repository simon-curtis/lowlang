import std/ui
import std/ui/geometry
import std/ui/platform
import strings = std/text
import std/unicode

/// One line a picker offers.
pub struct Choice {
    /// What `picker` hands to `chosen` when the line is chosen.
    pub key: str
    /// The line's main text.
    pub name: str
    /// A second, smaller line, or `""`.
    pub detail: str
    terms: str
}

/// Returns a choice that matches a query when every word of the query, lowercased, is somewhere in `name`, `detail` and `keywords` together, lowercased.
pub fn choice(key: str, name: str, detail: str, keywords: str) -> Choice {
    Choice { key, name, detail, terms: unicode.lower("{name} {detail} {keywords}") }
}

/// A search box over a list of choices, filled in by `load_choices`. Copies share its state.
pub struct Picker {
    cx: ui.Context
    id: str
    placeholder: str
    empty_text: str
    query: ui.TextField
    choices: ui.Signal[[]Choice]
    current: ui.Signal[str?]
    status: ui.Signal[str]
    selected: ui.Signal[i64]
    applied: ui.Signal[str]
}

const picker_width: f32 = 320.0

fn tall_row() -> f32 {
    control_height() + 12.0
}

fn short_row() -> f32 {
    control_height() + 2.0
}

const list_padding: f32 = 4.0

fn list_limit() -> f32 {
    tall_row() * 10.0 + 8.0
}

fn query_key(p: Picker) -> str {
    "{p.id}-query"
}

fn list_key(p: Picker) -> str {
    "{p.id}-list"
}

/// Returns a picker owned by `cx` whose elements have ids that start with `id`, that shows `placeholder` in its empty search box and `empty_text` when nothing matches, and that says `Loading…` until `load_choices` or `load_failed` is called. The search box has focus.
pub fn picker_state(cx: ui.Context, id: str, placeholder: str, empty_text: str) -> Picker {
    let none_yet: []Choice = []
    let no_current: str? = none
    let p = Picker {
        cx
        id
        placeholder
        empty_text
        query: cx.text_field("")
        choices: cx.signal(none_yet)
        current: cx.signal(no_current)
        status: cx.signal("Loading…")
        selected: cx.signal(0)
        applied: cx.signal("")
    }
    cx.set_focus(query_key(p))
    p
}

fn words_of(p: Picker) -> []str {
    strings.fields(unicode.lower(p.query.field_value().text))
}

fn matches(c: Choice, words: []str) -> bool {
    for word in words {
        if !strings.contains(c.terms, word) {
            return false
        }
    }
    true
}

fn shown_of(p: Picker) -> []Choice {
    let words = words_of(p)
    var out: []Choice = []
    for c in p.choices.get() {
        if matches(c, words) {
            out.push(c)
        }
    }
    out
}

fn row_height(c: Choice) -> f32 {
    if c.detail == "" { short_row() } else { tall_row() }
}

fn reveal(p: Picker, rows: []Choice, index: i64) {
    var top = list_padding
    var total = list_padding * 2.0
    var height: f32 = 0.0
    for i, c in rows {
        let h = row_height(c)
        if i < index {
            top += h
        }
        if i == index {
            height = h
        }
        total += h
    }
    let limit = list_limit()
    let view = if total < limit { total } else { limit }
    let at = p.cx.scroll_offset(list_key(p)).y
    var y = at
    if index == 0 {
        y = 0.0
    } else if top < at {
        y = top
    } else if top + height > at + view {
        y = top + height - view
    }
    p.cx.scroll_to(list_key(p), geometry.point(0.0, y))
}

fn reselect(p: Picker) {
    let rows = shown_of(p)
    let current = p.current.get()
    var at = 0
    for i, c in rows {
        if current == some(c.key) {
            at = i
        }
    }
    p.selected.set(at)
    reveal(p, rows, at)
}

fn settle(p: Picker) {
    let text = p.query.field_value().text
    if text == p.applied.get() {
        return
    }
    p.applied.set(text)
    reselect(p)
}

/// Fills `p` with `choices`, marks the one whose key is `current` and selects it, or the first when none is. Searching starts over from what is typed in the search box.
pub fn load_choices(p: Picker, choices: []Choice, current: str?) {
    p.choices.set(choices)
    p.current.set(current)
    p.status.set("")
    p.applied.set(p.query.field_value().text)
    reselect(p)
}

/// Empties `p` and shows `message` in its place, such as why the choices could not be read.
pub fn load_failed(p: Picker, message: str) {
    let none_yet: []Choice = []
    let no_current: str? = none
    p.choices.set(none_yet)
    p.current.set(no_current)
    p.status.set(message)
    p.applied.set(p.query.field_value().text)
    reselect(p)
}

/// Returns the keys of the choices that match what is typed in `p`, in order.
pub fn shown_keys(p: Picker) -> []str {
    settle(p)
    var keys: []str = []
    for c in shown_of(p) {
        keys.push(c.key)
    }
    keys
}

/// Returns the position among `shown_keys` of the selected choice.
pub fn selected_index(p: Picker) -> i64 {
    settle(p)
    p.selected.get()
}

fn pick_selected(p: Picker, chosen: fn(str)) {
    let rows = shown_of(p)
    let at = p.selected.get()
    if at >= 0 && at < rows.len {
        chosen(rows[at].key)
    }
}

fn move_selection(p: Picker, by: i64) {
    let rows = shown_of(p)
    let count = if rows.len > 0 { rows.len } else { 1 }
    let at = (p.selected.get() + by + count) % count
    p.selected.set(at)
    reveal(p, rows, at)
}

fn on_picker_key(p: Picker, k: platform.KeyEvent, chosen: fn(str), dismissed: fn()) {
    settle(p)
    if is_key(k, Up) {
        move_selection(p, -1)
    } else if is_key(k, Down) {
        move_selection(p, 1)
    } else if is_key(k, Enter) {
        pick_selected(p, chosen)
    } else if is_key(k, Escape) {
        dismissed()
    } else {
        return
    }
    p.cx.stop_propagation()
}

fn text_line(text: str) -> ui.Element {
    ui.div().whitespace_nowrap().text_ellipsis().overflow_hidden().child(ui.text(text))
}

fn choice_row(th: Theme, p: Picker, position: i64, c: Choice, chosen: fn(str)) -> ui.Element {
    let key = c.key
    var lines: []ui.Element = [text_line(c.name)]
    if c.detail != "" {
        lines.push(text_line(c.detail).text_size(size_caption()).text_color(faint()))
    }
    let label = ui.div().column().flex_1().min_width(0.0).children(lines)
    var parts: []ui.Element = [label]
    if p.current.get() == some(key) {
        parts.push(small_icon(check_icon(), accent(th)))
    }
    list_row("pick-{key}", position == p.selected.get()).width_full().height(row_height(c)).on_click(fn(e: ui.ClickEvent) chosen(key)).children(parts)
}

fn picker_lines(th: Theme, p: Picker, rows: []Choice, chosen: fn(str)) -> []ui.Element {
    let status = p.status.get()
    if status != "" {
        return [empty(status)]
    }
    if rows.len == 0 {
        return [empty(p.empty_text)]
    }
    var lines: []ui.Element = []
    for position, c in rows {
        lines.push(choice_row(th, p, position, c, chosen))
    }
    lines
}

/// Returns the search box and the choices that match it, in a popover for the caller to place.
///
/// Typing narrows the choices, and the selection goes to the current choice if it still shows, else the first. Up and Down move it, wrapping at the ends, and keep it in view. Enter or a click calls `chosen` with the key of a choice, Escape calls `dismissed`, and so does a press outside the popover. The accent of `th` marks the current choice.
pub fn picker(th: Theme, p: Picker, chosen: fn(str), dismissed: fn()) -> ui.Element {
    settle(p)
    let rows = shown_of(p)
    let lines = picker_lines(th, p, rows, chosen)
    let search = search_icon()
    let box = bare_input(p.cx, p.query, query_key(p), p.placeholder)
    let header = ui.div().items_center().gap(8.0).height(control_height() + 8.0).padding_x(10.0).border_edges(geometry.Edges { bottom: 1.0 }, border_colour()).children([small_icon(search, faint()), box])
    let list = ui.div().id(list_key(p)).column().max_height(list_limit()).overflow_y_scroll().padding(list_padding).children(lines)
    popover().id(p.id).occlude().column().width(picker_width)
        .on_key_down(fn(k: platform.KeyEvent) on_picker_key(p, k, chosen, dismissed))
        .on_mouse_down_out(fn(e: ui.MouseEvent) dismissed())
        .children([header, list])
}
