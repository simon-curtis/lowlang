import std/ui/geometry
import std/ui/scene

/// The direction a scrollbar runs in.
pub enum Axis {
    /// Down the right of the content.
    Vertical
    /// Along the bottom of the content.
    Horizontal
}

/// A thumb that is being dragged and where on it the pointer took hold.
pub struct Grab {
    /// The direction of the bar being dragged.
    pub axis: Axis
    offset: f32
}

struct Bar {
    axis: Axis
    track: geometry.Rect
    thumb: geometry.Rect
    max: f32
}

/// A vertical and a horizontal scrollbar, which are laid out from their tracks, the scroll offset and how far the content can scroll, and answer where the pointer is and where a drag scrolls to. Everything is in logical pixels.
pub struct Scrollbars {
    vertical: Bar
    horizontal: Bar
}

/// Returns the width of a scrollbar's track: 10 pixels.
pub fn scrollbar_width() -> f32 {
    10.0
}

const thumb_inset: f32 = 2.0
const hot_thumb_inset: f32 = 0.5
const reach: f32 = 6.0
const min_thumb: f32 = 24.0

fn along_point(p: geometry.Point, axis: Axis) -> f32 {
    match axis {
        Vertical => p.y
        Horizontal => p.x
    }
}

fn along_rect(r: geometry.Rect, axis: Axis) -> f32 {
    match axis {
        Vertical => r.height
        Horizontal => r.width
    }
}

fn origin_along(r: geometry.Rect, axis: Axis) -> f32 {
    match axis {
        Vertical => r.y
        Horizontal => r.x
    }
}

fn across_of(axis: Axis) -> Axis {
    match axis {
        Vertical => Horizontal
        Horizontal => Vertical
    }
}

fn resized_along(r: geometry.Rect, axis: Axis, start: f32, length: f32) -> geometry.Rect {
    match axis {
        Vertical => geometry.rect(r.x, start, r.width, length)
        Horizontal => geometry.rect(start, r.y, length, r.height)
    }
}

fn bar(axis: Axis, track: geometry.Rect, scroll: f32, max: f32) -> Bar {
    let length = along_rect(track, axis)
    var thumb_length = length * (length / (length + max))
    if thumb_length < min_thumb {
        thumb_length = min_thumb
    }
    if thumb_length > length {
        thumb_length = length
    }
    let progress = if max > 0.0 { scroll / max } else { 0.0 }
    let start = origin_along(track, axis) + (length - thumb_length) * progress
    Bar { axis, track, thumb: resized_along(track, axis, start, thumb_length), max }
}

fn is_near(b: Bar, position: geometry.Point) -> bool {
    let across = across_of(b.axis)
    let zone = resized_along(b.track, across, origin_along(b.track, across) - reach, along_rect(b.track, across) + reach)
    b.max > 0.0 && geometry.contains(zone, position)
}

fn grabbed(b: Bar, position: geometry.Point) -> Grab {
    let offset = if geometry.contains(b.thumb, position) {
        along_point(position, b.axis) - origin_along(b.thumb, b.axis)
    } else {
        along_rect(b.thumb, b.axis) / 2.0
    }
    Grab { axis: b.axis, offset }
}

fn scroll_for(b: Bar, position: geometry.Point, offset: f32) -> f32 {
    let travel = along_rect(b.track, b.axis) - along_rect(b.thumb, b.axis)
    if travel <= 0.0 {
        return 0.0
    }
    let start = along_point(position, b.axis) - offset - origin_along(b.track, b.axis)
    var share = start / travel
    if share < 0.0 {
        share = 0.0
    }
    if share > 1.0 {
        share = 1.0
    }
    b.max * share
}

fn thumb_quad(b: Bar, hot: bool) -> scene.Quad {
    let inset = if hot { hot_thumb_inset } else { thumb_inset }
    let colour = if hot { scrollbar_hot() } else { scrollbar() }
    let across = across_of(b.axis)
    let bounds = resized_along(b.thumb, across, origin_along(b.thumb, across) + inset, along_rect(b.thumb, across) - inset * 2.0)
    scene.Quad { bounds, background: colour, corner_radii: geometry.corners(scrollbar_width() / 2.0) }
}

/// Returns the scrollbars whose tracks are `vertical` and `horizontal`, for content scrolled to `scroll` that can scroll as far as `max` in each direction. A bar whose `max` is not above 0 has nothing to scroll.
pub fn scrollbars(vertical: geometry.Rect, horizontal: geometry.Rect, scroll: geometry.Point, max: geometry.Point) -> Scrollbars {
    Scrollbars { vertical: bar(Vertical, vertical, scroll.y, max.y), horizontal: bar(Horizontal, horizontal, scroll.x, max.x) }
}

/// Returns the bar whose track, or the six pixels of reach beside it, holds `position`, if any and it has something to scroll. The vertical bar is tried first.
pub fn near(s: Scrollbars, position: geometry.Point) -> Axis? {
    if is_near(s.vertical, position) {
        return Vertical
    }
    if is_near(s.horizontal, position) {
        return Horizontal
    }
    none
}

/// Returns the grab a press at `position` makes on the bar that is `near` it, or `none`. Pressing the thumb keeps the pointer where it is on the thumb; pressing the track beside it takes the thumb's middle.
pub fn grab(s: Scrollbars, position: geometry.Point) -> Grab? {
    if is_near(s.vertical, position) {
        return grabbed(s.vertical, position)
    }
    if is_near(s.horizontal, position) {
        return grabbed(s.horizontal, position)
    }
    none
}

/// Returns `scroll` with the offset along the dragged bar set to where the pointer at `position` puts the thumb, between 0 and the most the content can scroll. The other direction is left as it was.
pub fn drag(s: Scrollbars, g: Grab, position: geometry.Point, scroll: geometry.Point) -> geometry.Point {
    match g.axis {
        Vertical => geometry.point(scroll.x, scroll_for(s.vertical, position, g.offset))
        Horizontal => geometry.point(scroll_for(s.horizontal, position, g.offset), scroll.y)
    }
}

/// Returns the quads that draw the thumbs of the bars that have something to scroll, the one along `hot` drawn brighter and wider.
pub fn quads(s: Scrollbars, hot: Axis?) -> []scene.Quad {
    var out: []scene.Quad = []
    if s.vertical.max > 0.0 {
        out.push(thumb_quad(s.vertical, hot == some(Vertical)))
    }
    if s.horizontal.max > 0.0 {
        out.push(thumb_quad(s.horizontal, hot == some(Horizontal)))
    }
    out
}
