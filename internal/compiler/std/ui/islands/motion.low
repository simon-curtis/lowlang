/// A value that eases toward a target, such as how far a panel is open from `0.0` to `1.0`.
///
/// A slide takes 500 milliseconds to open from 0 to 1, 300 to close from 1 to 0, and a share of that for a shorter way.
pub struct Slide {
    /// Where the slide is now.
    pub value: f32 = 0.0
    from: f32 = 0.0
    target: f32 = 0.0
    began: i64 = 0
    length: f32 = 0.0
}

/// Returns a slide at rest at `value`.
pub fn slide(value: f32) -> Slide {
    Slide { value, from: value, target: value }
}

/// Starts `s` toward `target` at `now_ms` milliseconds on the caller's clock. A slide already headed there is left as it is.
pub fn set_slide(mut s: Slide, target: f32, now_ms: i64) {
    if target == s.target {
        return
    }
    let full: f32 = if target > s.value { 500.0 } else { 300.0 }
    let way = target - s.value
    s.length = full * (if way < 0.0 { -way } else { way })
    s.from = s.value
    s.target = target
    s.began = now_ms
}

/// Moves `s` to where it is at `now_ms`, or to its target when `still` is `true`, and returns whether it is still moving.
pub fn tick(mut s: Slide, still: bool, now_ms: i64) -> bool {
    let progress = if still || s.length <= 0.0 { 1.0 } else { f32(now_ms - s.began) / s.length }
    if progress >= 1.0 {
        s.value = s.target
        return false
    }
    s.value = s.from + (s.target - s.from) * ease(progress)
    true
}

/// Returns the progress, from 0 to 1, that the curve `cubic-bezier(0.4, 0, 0.2, 1)` has reached when `x`, from 0 to 1, of its time has passed, found by 24 bisections.
pub fn ease(x: f32) -> f32 {
    var low: f32 = 0.0
    var high: f32 = 1.0
    for _ in 0..24 {
        let middle = (low + high) / 2.0
        if bezier(middle, 0.4, 0.2) < x {
            low = middle
        } else {
            high = middle
        }
    }
    bezier((low + high) / 2.0, 0.0, 1.0)
}

fn bezier(t: f32, first: f32, second: f32) -> f32 {
    let rest = 1.0 - t
    3.0 * rest * rest * t * first + 3.0 * rest * t * t * second + t * t * t
}
