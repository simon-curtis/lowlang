import std/ui
import std/ui/platform

fn dialog_key() -> str {
    "confirm-dialog"
}

/// Gives focus to the dialog that `confirm_dialog` draws, so that Escape and Enter reach it. Call it when the dialog is first shown.
pub fn focus_confirm(cx: ui.Context) {
    cx.set_focus(dialog_key())
}

/// Returns a dialog centred over a scrim that covers its parent, which should be `relative`.
///
/// The dialog shows `title`, `detail` in the code font of `th` in a box that holds at most 240 pixels of it, and a `Cancel` button beside a button labelled `verb`. Escape and `Cancel` call `dismissed`; Enter and the `verb` button call `confirmed`. The keys go on to the elements outside the dialog as well, so a program that binds them there should check that the dialog is closed.
pub fn confirm_dialog(th: Theme, title: str, detail: str, verb: str, confirmed: fn(), dismissed: fn()) -> ui.Element {
    let heading = ui.text(title).text_size(size_heading()).font_weight(600)
    let body = ui.div().max_height(240.0).overflow_hidden().padding(8.0).rounded(radius()).background(control()).font_family(code_family(th)).text_size(size_small()).child(ui.text(detail))
    let cancel = button(th, "dialog-cancel", "Cancel", Secondary, fn(e: ui.ClickEvent) dismissed())
    let confirm = button(th, "dialog-confirm", verb, Primary, fn(e: ui.ClickEvent) confirmed())
    let actions = ui.div().justify_end().gap(8.0).children([cancel, confirm])
    let card = popover().id(dialog_key()).focusable().width(480.0).padding(20.0).column().gap(12.0)
        .on_key_down(fn(k: platform.KeyEvent) {
            if is_key(k, Escape) {
                dismissed()
            } else if is_key(k, Enter) {
                confirmed()
            }
        })
        .children([heading, body, actions])
    scrim(card)
}
