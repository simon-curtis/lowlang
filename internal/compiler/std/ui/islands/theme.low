import std/ui
import std/ui/geometry
import strings = std/text

/// The choices that change how Islands looks: the accent scheme, the face for code and its size. A function that takes a `Theme` first draws something that depends on them.
pub struct Theme {
    /// The accent and glow colours.
    pub scheme: Scheme
    /// The face code text is drawn in.
    pub code_face: Typeface
    /// The size of code text in pixels.
    pub code_size: i64
}

/// Returns the theme of the scheme named `scheme_name`, the code face named `code_face` and the code size `code_size`. A name or size that is not one of `schemes`, `code_faces` or `code_sizes` takes `pink`, `jetbrains` or 13.
pub fn theme(scheme_name: str, code_face: str, code_size: i64) -> Theme {
    var scheme = default_scheme()
    for s in schemes() {
        if s.name == scheme_name {
            scheme = s
        }
    }
    var face = jetbrains_face()
    for f in code_faces() {
        if f.name == code_face {
            face = f
        }
    }
    var size = default_code_size()
    for s in code_sizes() {
        if s == code_size {
            size = s
        }
    }
    Theme { scheme, code_face: face, code_size: size }
}

/// Returns `colour` moved `amount` of the way to `toward` on each of its red, green and blue channels, both written `0xRRGGBB`.
pub fn blend(colour: u32, toward: u32, amount: f32) -> u32 {
    blended(colour, toward, amount, 16) | blended(colour, toward, amount, 8) | blended(colour, toward, amount, 0)
}

fn blended(colour: u32, toward: u32, amount: f32, shift: u32) -> u32 {
    let from = f32((colour >> shift) & 0xff)
    let to = f32((toward >> shift) & 0xff)
    u32(floor(from + (to - from) * amount + 0.5)) << shift
}

fn tint(colour: u32, alpha: u32) -> geometry.Color {
    ui.rgba((colour << 8) | alpha)
}

/// Returns `c` with its alpha multiplied by `amount`.
pub fn faded(c: geometry.Color, amount: f32) -> geometry.Color {
    geometry.with_alpha(c, c.a * amount)
}

/// Returns the colour of a window's background.
pub fn canvas() -> geometry.Color {
    ui.rgb(0x0b0b0e)
}

/// Returns the colour of a card.
pub fn surface() -> geometry.Color {
    ui.rgb(0x131316)
}

/// Returns the colour of a popover.
pub fn raised() -> geometry.Color {
    ui.rgb(0x1c1c21)
}

/// Returns the wash over something the pointer is on.
pub fn hovered() -> geometry.Color {
    ui.rgba(0xffffff0b)
}

/// Returns the colour of borders and dividers.
pub fn border_colour() -> geometry.Color {
    ui.rgb(0x26262b)
}

/// Returns the colour of text.
pub fn text_colour() -> geometry.Color {
    ui.rgb(0xe7e7ea)
}

/// Returns the colour of secondary text and icons.
pub fn muted() -> geometry.Color {
    ui.rgb(0xa9a9b2)
}

/// Returns the colour of placeholders and unavailable things.
pub fn faint() -> geometry.Color {
    ui.rgb(0x8a8a94)
}

/// Returns the colour of the lines that join related things, `muted` at 70 percent.
pub fn connector() -> geometry.Color {
    faded(muted(), 0.7)
}

/// Returns the accent of `th`.
pub fn accent(th: Theme) -> geometry.Color {
    ui.rgb(th.scheme.accent)
}

/// Returns the wash behind a selected rail button.
pub fn rail_selected() -> geometry.Color {
    ui.rgba(0xffffff24)
}

/// Returns the colour of text and icons on the accent.
pub fn on_accent() -> geometry.Color {
    ui.rgb(0x16161a)
}

/// Returns the accent of `th` at 14 percent, behind a switched-on button.
pub fn accent_soft(th: Theme) -> geometry.Color {
    tint(th.scheme.accent, 0x24)
}

/// Returns the accent of `th` at 25 percent, behind selected text.
pub fn selection(th: Theme) -> geometry.Color {
    tint(th.scheme.accent, 0x40)
}

/// Returns the colour behind a found match.
pub fn find_match() -> geometry.Color {
    ui.rgba(0xf5c45140)
}

/// Returns the colour behind the current found match.
pub fn find_current() -> geometry.Color {
    ui.rgba(0xf5c45199)
}

/// Returns the colour of destructive actions and errors.
pub fn danger() -> geometry.Color {
    ui.rgb(0xef5f67)
}

/// Returns the colour of success.
pub fn ok() -> geometry.Color {
    ui.rgb(0x4cc38a)
}

/// Returns the colour of warnings.
pub fn warn() -> geometry.Color {
    ui.rgb(0xf2b35b)
}

/// Returns `danger` at 15 percent.
pub fn danger_soft() -> geometry.Color {
    ui.rgba(0xef5f6726)
}

/// Returns the fill of a control at rest.
pub fn control() -> geometry.Color {
    ui.rgba(0xffffff0f)
}

/// Returns the fill of a selected row.
pub fn selected() -> geometry.Color {
    ui.rgba(0xffffff14)
}

/// Returns the fill of a text input.
pub fn input_fill() -> geometry.Color {
    ui.rgba(0xffffff1c)
}

/// Returns the colour behind a dialog.
pub fn scrim_colour() -> geometry.Color {
    ui.rgba(0x000000a6)
}

/// Returns the wash behind the line of an editor that holds the caret.
pub fn current_line() -> geometry.Color {
    ui.rgba(0xffffff08)
}

/// Returns the colour of drawn whitespace.
pub fn whitespace() -> geometry.Color {
    ui.rgba(0xffffff2e)
}

/// Returns the colour of a scrollbar thumb.
pub fn scrollbar() -> geometry.Color {
    ui.rgba(0xffffff1f)
}

/// Returns the colour of a scrollbar thumb the pointer is near.
pub fn scrollbar_hot() -> geometry.Color {
    ui.rgba(0xffffff4d)
}

/// Returns the colour of code with no other colour.
pub fn syntax_plain() -> geometry.Color {
    text_colour()
}

/// Returns the colour of comments.
pub fn syntax_comment() -> geometry.Color {
    faint()
}

/// Returns the colour of keywords: the accent of `th` 30 percent of the way to white.
pub fn syntax_keyword(th: Theme) -> geometry.Color {
    ui.rgb(blend(th.scheme.accent, 0xffffff, 0.3))
}

/// Returns the colour of string literals.
pub fn syntax_string() -> geometry.Color {
    ui.rgb(0xa5d6a7)
}

/// Returns the colour of number literals.
pub fn syntax_number() -> geometry.Color {
    ui.rgb(0xf2b880)
}

/// Returns the colour of variables.
pub fn syntax_variable() -> geometry.Color {
    ui.rgb(0xe6cf8a)
}

/// Returns the colour written `hex`, a `#` and six hexadecimal digits, or a gray for anything else.
pub fn colour(hex: str) -> geometry.Color {
    let digits = strings.strip_prefix(hex, "#") ?? ""
    let parsed = if digits.len == 6 { strings.parse_uint(digits, 16) or 0x888888 } else { 0x888888 }
    ui.rgb(u32(parsed))
}

/// Returns the shadow under a popover.
pub fn popover_shadow() -> ui.BoxShadow {
    ui.BoxShadow { color: ui.rgba(0x00000073), x: 0.0, y: 12.0, blur: 32.0, spread: -8.0 }
}

/// Returns the families of code text in `th`: its code face, then JetBrains Mono, which `load_fonts` adds, then the system's `monospace`.
pub fn code_family(th: Theme) -> str {
    "{th.code_face.family}, JetBrains Mono, monospace"
}

/// Returns the size of code text in `th` in pixels.
pub fn code_pixels(th: Theme) -> f32 {
    f32(th.code_size)
}

/// Returns the families of interface text: Segoe UI Variable Text, then the system's `sans-serif`.
pub fn ui_font() -> str {
    "Segoe UI Variable Text, sans-serif"
}

/// Returns the height of a control: 28 pixels.
pub fn control_height() -> f32 {
    28.0
}

/// Returns the corner radius of controls: 6 pixels.
pub fn radius() -> f32 {
    6.0
}

/// Returns the corner radius of cards and popovers: 10 pixels.
pub fn radius_lg() -> f32 {
    10.0
}

/// Returns the size of body text: 13 pixels.
pub fn size_text() -> f32 {
    13.0
}

/// Returns the size of small text: 12 pixels.
pub fn size_small() -> f32 {
    12.0
}

/// Returns the size of captions: 11 pixels.
pub fn size_caption() -> f32 {
    11.0
}

/// Returns the size of titles: 14 pixels.
pub fn size_title() -> f32 {
    14.0
}

/// Returns the size of headings: 16 pixels.
pub fn size_heading() -> f32 {
    16.0
}
