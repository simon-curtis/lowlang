import std/image
import std/ui
import std/ui/geometry

/// The glow behind a window and the grain over it, made once and drawn many times. Copies share what has been made.
pub struct Backdrop {
    cx: ui.Context
    images: [str: ui.RenderImage]
}

struct Noise {
    state: u64
}

struct Spot {
    x: f32
    y: f32
    radius: f32
    strength: f32
    red: f32
    green: f32
    blue: f32
}

struct Glow {
    red: f32
    green: f32
    blue: f32
    alpha: f32
}

const glow_width = 1920
const glow_height = 420
const grain_size = 256

/// Returns the side of a tile of grain in logical pixels: 256.
pub fn grain_tile() -> f32 {
    256.0
}

fn next_noise(mut n: Noise) -> f32 {
    n.state = n.state ^ (n.state << 13)
    n.state = n.state ^ (n.state >> 7)
    n.state = n.state ^ (n.state << 17)
    f32(n.state >> 40) / 16777216.0
}

fn ln(x: f64) -> f64 {
    var scaled = x
    var halvings = 0.0
    for scaled < 0.5 {
        scaled = scaled * 2.0
        halvings += 1.0
    }
    let z = (scaled - 1.0) / (scaled + 1.0)
    let z2 = z * z
    var term = z
    var sum = 0.0
    for n in 0..16 {
        sum += term / f64(2 * n + 1)
        term = term * z2
    }
    2.0 * sum - halvings * 0.6931471805599453
}

fn power(base: f64, exponent: f64) -> f64 {
    if base <= 0.0 {
        return 0.0
    }
    exp(exponent * ln(base))
}

fn clamped(v: f32, low: f32, high: f32) -> f32 {
    if v < low {
        return low
    }
    if v > high {
        return high
    }
    v
}

fn channel_byte(v: f32) -> u8 {
    u8(floor(clamped(v, 0.0, 255.0)))
}

fn rounded_byte(v: f32) -> u8 {
    u8(floor(clamped(v, 0.0, 255.0) + 0.5))
}

fn put(px: []u8, at: i64, red: u8, green: u8, blue: u8, alpha: u8) {
    px[at] = red
    px[at + 1] = green
    px[at + 2] = blue
    px[at + 3] = alpha
}

/// Returns the tile of grain: 256 by 256 pixels of faint white and black speckle, the same on every run.
pub fn grain_pixels() -> image.Image {
    let side = grain_size
    let img = image.create(side, side, Rgba8)
    let px = img.pixels
    var noise = Noise { state: 0x2545f4914f6cdd1d }
    for i in 0..side * side {
        let first = next_noise(mut noise)
        let second = next_noise(mut noise)
        let third = next_noise(mut noise)
        let deviation = first + second + third - 1.5
        if deviation > 0.0 {
            put(px, i * 4, 255, 255, 255, rounded_byte(deviation * 3.0))
        } else {
            put(px, i * 4, 0, 0, 0, rounded_byte(-deviation * 8.0))
        }
    }
    img
}

fn spot(x: f32, y: f32, radius: f32, strength: f32, hex: u32) -> Spot {
    Spot { x, y, radius, strength, red: f32((hex >> 16) & 0xff), green: f32((hex >> 8) & 0xff), blue: f32(hex & 0xff) }
}

fn spots(glows: []u32) -> []Spot {
    [
        spot(0.30, -0.25, 0.34, 0.40, glows[0])
        spot(0.74, -0.15, 0.30, 0.34, glows[1])
        spot(0.52, -0.45, 0.22, 0.20, glows[2])
        spot(0.95, -0.35, 0.16, 0.16, glows[3])
    ]
}

fn glow_at(placed: []Spot, u: f32, v: f32, fade: f32) -> Glow {
    let aspect = f32(glow_width) / f32(glow_height)
    var weight: f32 = 0.0
    var red: f32 = 0.0
    var green: f32 = 0.0
    var blue: f32 = 0.0
    for s in placed {
        let dx = u - s.x
        let dy = (v - s.y) / aspect
        let distance = sqrt(dx * dx + dy * dy) / s.radius
        let intensity = s.strength * exp(-distance * distance * 1.6)
        weight += intensity
        red += s.red * intensity
        green += s.green * intensity
        blue += s.blue * intensity
    }
    if !(weight > 0.0) {
        return Glow { red: 0.0, green: 0.0, blue: 0.0, alpha: 0.0 }
    }
    let r = red / weight
    let g = green / weight
    let b = blue / weight
    let alpha = if weight < 0.24 { weight } else { 0.24 }
    Glow { red: r + (128.0 - r) * 0.3, green: g + (128.0 - g) * 0.3, blue: b + (128.0 - b) * 0.3, alpha: alpha * fade }
}

/// Returns the glow of `th`'s scheme: 1920 by 420 pixels of its four colours fading out downward from the top edge, with a little noise, the same on every run.
pub fn glow_pixels(th: Theme) -> image.Image {
    let width = glow_width
    let height = glow_height
    let img = image.create(width, height, Rgba8)
    let px = img.pixels
    let placed = spots(th.scheme.glows)
    var noise = Noise { state: 0x9e3779b97f4a7c15 }
    for y in 0..height {
        let v = f32(y) / f32(height)
        let rest = f64(1.0 - v)
        let fade = f32(power(rest, 2.6))
        let speckle = f32(power(rest, 1.3))
        for x in 0..width {
            let g = glow_at(placed, f32(x) / f32(width), v, fade)
            let alpha_noise = next_noise(mut noise)
            let red_noise = next_noise(mut noise)
            let green_noise = next_noise(mut noise)
            let blue_noise = next_noise(mut noise)
            let alpha = clamped(g.alpha + (alpha_noise - 0.5) * 0.035 * speckle, 0.0, 1.0)
            let red = channel_byte(g.red + (red_noise - 0.5) * 8.0)
            let green = channel_byte(g.green + (green_noise - 0.5) * 8.0)
            let blue = channel_byte(g.blue + (blue_noise - 0.5) * 8.0)
            put(px, (y * width + x) * 4, red, green, blue, rounded_byte(alpha * 255.0))
        }
    }
    img
}

/// Returns a backdrop for `cx` that has made nothing yet.
pub fn backdrop(cx: ui.Context) -> Backdrop {
    let images: [str: ui.RenderImage] = [:]
    Backdrop { cx, images }
}

fn grain_texture(b: Backdrop) -> ui.RenderImage {
    let made = b.images["grain"]
    match made {
        some(texture) => return texture
        none => {}
    }
    let texture = b.cx.render_image(grain_pixels())
    b.images["grain"] = texture
    texture
}

fn glow_texture(b: Backdrop, th: Theme) -> ui.RenderImage {
    let key = "glow-{th.scheme.name}"
    let made = b.images[key]
    match made {
        some(texture) => return texture
        none => {}
    }
    let texture = b.cx.render_image(glow_pixels(th))
    b.images[key] = texture
    texture
}

/// Returns the glow of `th`'s scheme for a window of `viewport`, made the first time a scheme is asked for: an absolutely placed box 420 pixels high across the top of the window, at least 1920 pixels wide and centred, drawn at half resolution.
pub fn glow_image(b: Backdrop, th: Theme, viewport: geometry.Size) -> ui.Element {
    let texture = glow_texture(b, th)
    let width = if viewport.width > 1920.0 { viewport.width } else { 1920.0 }
    let sharpness = if width > 2000.0 { 1000.0 / width } else { 0.5 }
    ui.img(texture).absolute().left((viewport.width - width) / 2.0).top(0.0).size(width, 420.0).object_fit(Fill).resolution(sharpness)
}

fn tiles_across(extent: f32, side: f32) -> i64 {
    let whole = floor(extent / side)
    let count = i64(whole)
    if whole * side < extent {
        return count + 1
    }
    count
}

/// Returns the grain for a window of `viewport`: tiles of the same speckle across all of it, over everything else.
pub fn grain_layer(b: Backdrop, viewport: geometry.Size) -> ui.Element {
    let texture = grain_texture(b)
    let side = grain_tile()
    let columns = tiles_across(viewport.width, side)
    let rows = tiles_across(viewport.height, side)
    var tiles: []ui.Element = []
    for row in 0..rows {
        for column in 0..columns {
            tiles.push(ui.img(texture).absolute().left(f32(column) * side).top(f32(row) * side).size(side, side).object_fit(Fill).resolution(1.0))
        }
    }
    ui.div().absolute().inset(0.0).children(tiles)
}
