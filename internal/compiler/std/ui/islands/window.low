import std/ui
import std/ui/geometry
import std/ui/platform

const caption_clearance: f32 = 140.0
const window_margin: f32 = 8.0

/// Returns a whole window: the glow of `th`'s scheme behind a title bar and a card that holds `content`, with the grain over all of it.
///
/// The title bar is `title_height` tall. It holds `mark`, normally made by `brand`, then an area that moves the window and, when the program draws the window's decorations, the caption buttons. `title` is centred in the bar in muted text, kept clear of the buttons. The card sits 8 pixels in from the window's edges below the bar, and `content` grows to fill it.
pub fn tool_window(th: Theme, cx: ui.Context, b: Backdrop, title: str, mark: ui.Element, content: ui.Element) -> ui.Element {
    let viewport = cx.window_size()
    let heading = ui.div().min_width(0.0).overflow_hidden().whitespace_nowrap().text_ellipsis().text_size(size_text()).font_weight(500).text_color(muted()).child(ui.text(title))
    let centre = ui.div().absolute().inset(0.0).padding_x(caption_clearance).items_center().justify_center().child(heading)
    var bar_parts: []ui.Element = [centre, mark, drag_area()]
    if cx.window_decorations() == platform.Decorations.Client {
        bar_parts.push(caption_controls(cx))
    }
    let title_bar = ui.div().relative().items_center().gap(8.0).height(title_height()).shrink(0.0).children(bar_parts)
    let sheet = card().flex_1().min_width(0.0).overflow_hidden().child(content.flex_1().min_width(0.0))
    let margin = window_margin
    let body = ui.div().flex_1().min_height(0.0).padding_edges(geometry.Edges { left: margin, right: margin, bottom: margin }).child(sheet)
    let column = ui.div().relative().column().size_full().children([title_bar, body])
    let glow = glow_image(b, th, viewport)
    let grain = grain_layer(b, viewport)
    ui.div().relative().size_full().background(canvas()).text_color(text_colour()).font_family(ui_font()).children([glow, column, grain])
}
