import std/ui
import std/ui/font

/// A face for code.
pub struct Typeface {
    /// The name `theme` looks a face up by, such as `jetbrains`.
    pub name: str
    /// The name people see.
    pub label: str
    /// The family `font_family` asks for.
    pub family: str
    /// A sentence about the face.
    pub summary: str
    files: []str = []
}

/// Why the bundled fonts could not be loaded.
pub enum FontError {
    /// The font file of `family` is not a font `std/ui/font` reads.
    Malformed(family: str, error: font.Error)
}

fn jetbrains_file() -> str {
    embed("fonts/jetbrains-mono/JetBrainsMono-Regular.ttf")
}

fn ia_mono_file() -> str {
    embed("fonts/ia-writer-mono/iAWriterMonoS-Regular.ttf")
}

/// Returns the four faces for code: `cascadia`, `jetbrains`, `ia-mono` and `consolas`. The first and last come from the system; the other two are bundled and `load_fonts` makes them available.
pub fn code_faces() -> []Typeface {
    [
        Typeface { name: "cascadia", label: "Cascadia Mono", family: "Cascadia Mono", summary: "The Windows Terminal face. Wide and even." }
        jetbrains_face()
        Typeface { name: "ia-mono", label: "iA Writer Mono", family: "iA Writer Mono S", summary: "The monospaced iA Writer face.", files: [ia_mono_file()] }
        Typeface { name: "consolas", label: "Consolas", family: "Consolas", summary: "The long-standing Windows code face." }
    ]
}

fn jetbrains_face() -> Typeface {
    Typeface { name: "jetbrains", label: "JetBrains Mono", family: "JetBrains Mono", summary: "Tall letters and clear shapes for code.", files: [jetbrains_file()] }
}

/// Returns the sizes of code text in pixels: 12, 13, 14, 15, 16 and 18.
pub fn code_sizes() -> []i64 {
    [12, 13, 14, 15, 16, 18]
}

/// Returns the code size `theme` falls back to: 13.
pub fn default_code_size() -> i64 {
    13
}

/// Returns the distance between lines of code text of `size` pixels, `size` times 20 over 13 rounded to a whole pixel.
pub fn code_line_height(size: i64) -> f32 {
    floor(f32(size) * 20.0 / 13.0 + 0.5)
}

/// Parses the bundled fonts and adds them to `cx`, ahead of the system's own. Call it once, before the first frame.
pub fn load_fonts(cx: ui.Context) ! FontError {
    var fonts: []font.Font = []
    for face in code_faces() {
        for file in face.files {
            let parsed = font.parse(file) catch {
                e => fail Malformed(face.family, e)
            }
            fonts.push(parsed)
        }
    }
    cx.add_fonts(fonts)
}
