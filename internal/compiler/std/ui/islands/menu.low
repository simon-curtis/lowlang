import std/ui
import std/ui/geometry
import std/ui/platform
import std/ui/svg

/// One line of a context menu.
pub struct MenuItem {
    /// The words of the line.
    pub label: str
    /// The icon at the start of the line.
    pub icon: svg.Icon
    /// What choosing the line does, after the menu has been dismissed.
    pub action: fn()
    /// The shortcut shown at the end of the line, or `""`.
    pub hint: str = ""
    /// Whether a divider is drawn above the line.
    pub separated: bool = false
    /// Whether the line is drawn in the colour of destructive actions.
    pub danger: bool = false
}

/// Returns a line of `label` with `icon` that runs `action` when chosen.
pub fn menu_item(label: str, icon: svg.Icon, action: fn()) -> MenuItem {
    MenuItem { label, icon, action }
}

/// Returns `item` with the shortcut `hint` shown at its end.
pub fn with_hint(item: MenuItem, hint: str) -> MenuItem {
    var out = item
    out.hint = hint
    out
}

/// Returns `item` with a divider above it.
pub fn separated(item: MenuItem) -> MenuItem {
    separated_when(item, true)
}

/// Returns `item` with a divider above it when `on`, and none when not.
pub fn separated_when(item: MenuItem, on: bool) -> MenuItem {
    var out = item
    out.separated = on
    out
}

/// Returns `item` drawn as a destructive action when `on`.
pub fn with_danger(item: MenuItem, on: bool) -> MenuItem {
    var out = item
    out.danger = on
    out
}

/// A context menu that can be shown at a point and dismissed. Copies share its state.
pub struct Menu {
    cx: ui.Context
    shown: ui.Signal[bool]
    at: ui.Signal[geometry.Point]
    items: ui.Signal[[]MenuItem]
    selected: ui.Signal[i64]
    restore: ui.Signal[str]
}

fn menu_key() -> str {
    "context-menu"
}

/// Returns a context menu owned by `cx` that is hidden.
pub fn menu_state(cx: ui.Context) -> Menu {
    let none_yet: []MenuItem = []
    Menu {
        cx
        shown: cx.signal(false)
        at: cx.signal(geometry.Point {})
        items: cx.signal(none_yet)
        selected: cx.signal(-1)
        restore: cx.signal("")
    }
}

/// Shows `m` with `items` at `at`, in logical pixels from the top left of the window. Focus moves to the menu, and goes back to where it was when the menu is dismissed.
pub fn show_menu(m: Menu, at: geometry.Point, items: []MenuItem) {
    if !m.shown.get() {
        let before = m.cx.focused()
        m.restore.set(before)
    }
    m.at.set(at)
    m.items.set(items)
    m.selected.set(-1)
    m.shown.set(true)
    m.cx.set_focus(menu_key())
}

/// Hides `m` and gives focus back to where it was when the menu was shown. A menu that is hidden is left as it is.
pub fn hide_menu(m: Menu) {
    if !m.shown.get() {
        return
    }
    m.shown.set(false)
    let before = m.restore.get()
    m.cx.set_focus(before)
}

fn choose_item(m: Menu, index: i64) {
    let items = m.items.get()
    if index < 0 || index >= items.len {
        return
    }
    let action = items[index].action
    hide_menu(m)
    action()
}

fn on_menu_key(m: Menu, k: platform.KeyEvent) {
    let items = m.items.get()
    let count = if items.len > 0 { items.len } else { 1 }
    let at = m.selected.get()
    if is_key(k, Down) {
        m.selected.set(if at < 0 { 0 } else { (at + 1) % count })
    } else if is_key(k, Up) {
        m.selected.set(if at < 0 { count - 1 } else { (at + count - 1) % count })
    } else if is_key(k, Enter) {
        choose_item(m, at)
    } else {
        hide_menu(m)
    }
    m.cx.stop_propagation()
}

fn menu_line(m: Menu, index: i64, item: MenuItem, on: bool) -> ui.Element {
    let ink = if item.danger { danger() } else { text_colour() }
    let glyph = if item.danger { danger() } else { muted() }
    var parts: []ui.Element = [small_icon(item.icon, glyph), ui.div().flex_1().child(ui.text(item.label))]
    if item.hint != "" {
        parts.push(ui.text(item.hint).shrink(0.0).padding_edges(geometry.Edges { left: 16.0 }).text_size(size_caption()).text_color(faint()))
    }
    list_row("menu-{index}", on).width_full().text_color(ink).on_click(fn(e: ui.ClickEvent) choose_item(m, index)).children(parts)
}

fn menu_separator() -> ui.Element {
    ui.div().height(1.0).shrink(0.0).margin_x(4.0).margin_y(4.0).background(border_colour())
}

fn menu_lines(m: Menu) -> []ui.Element {
    var lines: []ui.Element = []
    let at = m.selected.get()
    for index, item in m.items.get() {
        if item.separated && index > 0 {
            lines.push(menu_separator())
        }
        lines.push(menu_line(m, index, item, at == index))
    }
    lines
}

/// Returns the layer that draws `m`: a popover anchored at the point the menu was shown at, above everything else and taking the pointer from what is under it, or nothing while the menu is hidden.
///
/// Up and Down move the selection, wrapping at the ends, Enter chooses the selected line, and any other key dismisses the menu. So does a press outside it. Choosing a line dismisses the menu and then runs its action.
pub fn context_menu(m: Menu) -> ui.Element {
    if !m.shown.get() {
        return ui.div().hidden()
    }
    let shown_at = m.at.get()
    let lines = menu_lines(m)
    let body = popover().id(menu_key()).focusable().occlude().column().min_width(180.0).padding(4.0)
        .on_key_down(fn(k: platform.KeyEvent) on_menu_key(m, k))
        .on_mouse_down_out(fn(e: ui.MouseEvent) {
            if e.position != m.at.get() {
                hide_menu(m)
            }
        })
        .children(lines)
    let spec = ui.Anchor { position: shown_at, snap: true, margin: 4.0 }
    ui.deferred(ui.anchored(spec).child(body)).priority(1)
}
