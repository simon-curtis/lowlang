import std/bits
import std/image
import std/ui
import std/ui/geometry

/// A decoded photograph that `avatar` draws as a disc. Copies share the discs already made.
pub struct Picture {
    cx: ui.Context
    pixels: image.Image
    discs: [i64: ui.RenderImage]
}

/// Returns the photograph in `bytes`, a PNG, JPEG, GIF, BMP or QOI file, or `none` when `bytes` is not one of those.
pub fn picture(cx: ui.Context, bytes: []u8) -> Picture? {
    let decoded = image.decode(bytes) or return none
    let pixels = image.convert(decoded, Rgba8)
    let discs: [i64: ui.RenderImage] = [:]
    Picture { cx, pixels, discs }
}

fn disc_at(p: Picture, side: i64) -> ui.RenderImage {
    let cached = p.discs[side]
    match cached {
        some(made) => return made
        none => {}
    }
    let made = p.cx.render_image(disc(p.pixels, side))
    p.discs[side] = made
    made
}

fn disc(source: image.Image, side: i64) -> image.Image {
    let scaled = image.resize(source, side, side, Lanczos3)
    let radius = f32(side) / 2.0
    for y in 0..side {
        for x in 0..side {
            let dx = f32(x) + 0.5 - radius
            let dy = f32(y) + 0.5 - radius
            var cover = radius - sqrt(dx * dx + dy * dy) + 0.5
            if cover < 0.0 {
                cover = 0.0
            }
            if cover > 1.0 {
                cover = 1.0
            }
            let c = scaled.get(x, y)
            scaled.set(x, y, image.Rgba { r: c.r, g: c.g, b: c.b, a: u8(floor(f32(c.a) * cover + 0.5)) })
        }
    }
    scaled
}

/// Who an avatar stands for: a name, a colour, a pattern drawn from a seed and perhaps a photograph.
pub struct Face {
    /// The name.
    pub name: str
    /// The colour of the pattern and of the disc behind it.
    pub colour: geometry.Color
    pattern: i64
    picture: Picture?
}

/// Returns the pattern of 15 bits, a mirrored 5 by 5 grid of cells, that `seed` draws: the FNV-1a hash of its bytes with its high bits folded down, and its complement when fewer than four cells would be lit.
pub fn pattern(seed: str) -> i64 {
    var hash: u64 = 0xcbf29ce484222325
    for i in 0..seed.len {
        hash = (hash ^ u64(seed[i])) * 0x100000001b3
    }
    let folded = (hash ^ (hash >> 29)) & 0x7fff
    let chosen = if bits.popcount(folded) < 4 { ~folded & 0x7fff } else { folded }
    i64(chosen)
}

fn lit(pattern: i64, row: i64, column: i64) -> bool {
    let mirrored = if column < 4 - column { column } else { 4 - column }
    pattern & (1 << (row * 3 + mirrored)) != 0
}

/// Returns the face of `name` in the colour `colour_hex`, as `colour` reads it, with the pattern of `seed` and `picture` over it when there is one.
pub fn face(name: str, colour_hex: str, seed: str, picture: Picture?) -> Face {
    Face { name, colour: colour(colour_hex), pattern: pattern(seed), picture }
}

/// Returns an element `extent` pixels square drawing `f`: its photograph as a disc, else its pattern in a disc of its colour at 18 percent.
pub fn avatar(cx: ui.Context, f: Face, extent: f32) -> ui.Element {
    match f.picture {
        some(p) => {
            var side = i64(floor(extent * cx.window_scale() + 0.5))
            if side < 1 {
                side = 1
            }
            let shown = disc_at(p, side)
            return ui.img(shown).size(extent, extent).shrink(0.0)
        }
        none => {}
    }
    var cell = floor(extent * 0.6 / 5.0 + 0.5)
    if cell < 1.0 {
        cell = 1.0
    }
    var rows: []ui.Element = []
    for line in 0..5 {
        rows.push(pattern_row(f, line, cell))
    }
    let grid = ui.div().column().children(rows)
    ui.div().size(extent, extent).shrink(0.0).rounded(extent / 2.0).background(faded(f.colour, 0.18)).items_center().justify_center().child(grid)
}

fn pattern_row(f: Face, line: i64, cell: f32) -> ui.Element {
    var cells: []ui.Element = []
    for column in 0..5 {
        let fill = if lit(f.pattern, line, column) { f.colour } else { geometry.Color {} }
        cells.push(ui.div().size(cell, cell).background(fill))
    }
    ui.div().row().children(cells)
}
