import std/ui/geometry
import std/ui/svg

/// Returns the icon drawn by `body`, SVG shapes in a 24 by 24 view box that are traced with strokes 2 units wide in the colour of the text around the icon and not filled.
///
/// A body that is not SVG gives an icon that draws nothing.
pub fn stroke_icon(body: str) -> svg.Icon {
    let source = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'>{body}</svg>"
    svg.parse(source) or svg.Icon { view_box: geometry.rect(0.0, 0.0, 24.0, 24.0), shapes: [] }
}

/// Returns a tick.
pub fn check_icon() -> svg.Icon {
    stroke_icon("<path d='M5 12.5 L10 17.5 L19 7'/>")
}

/// Returns a chevron pointing up above one pointing down.
pub fn chevrons_up_down_icon() -> svg.Icon {
    stroke_icon("<path d='M7.5 9 L12 4.5 L16.5 9'/><path d='M7.5 15 L12 19.5 L16.5 15'/>")
}

/// Returns a magnifying glass.
pub fn search_icon() -> svg.Icon {
    stroke_icon("<circle cx='10.5' cy='10.5' r='6.5'/><path d='M15.5 15.5 L20.5 20.5'/>")
}

/// Returns a line along the bottom of a window, for the button that minimizes it.
pub fn window_minimize_icon() -> svg.Icon {
    stroke_icon("<path d='M5 12 L19 12'/>")
}

/// Returns a square, for the button that maximizes a window.
pub fn window_maximize_icon() -> svg.Icon {
    stroke_icon("<rect x='5' y='5' width='14' height='14'/>")
}

/// Returns a square in front of the corner of another, for the button that restores a maximized window.
pub fn window_restore_icon() -> svg.Icon {
    stroke_icon("<rect x='4' y='9' width='11' height='11'/><path d='M9 9 L9 4 L20 4 L20 15 L15 15'/>")
}

/// Returns a cross, for the button that closes a window.
pub fn window_close_icon() -> svg.Icon {
    stroke_icon("<path d='M6 6 L18 18'/><path d='M18 6 L6 18'/>")
}
