import std/ui/geometry
import std/ui/layout
import std/ui/platform
import uitext = std/ui/text

/// A shadow cast by an element's border box.
pub struct BoxShadow {
    /// The colour at full coverage.
    pub color: geometry.Color = geometry.rgba(0x00000040)
    /// How far right the shadow sits from the box, in logical pixels.
    pub x: f32 = 0.0
    /// How far down the shadow sits from the box, in logical pixels.
    pub y: f32 = 0.0
    /// The blur radius in logical pixels; the shadow fades over this distance beyond its edge.
    pub blur: f32 = 0.0
    /// How far the shadow grows on every side before blurring, in logical pixels.
    pub spread: f32 = 0.0
}

/// A colour and where it sits on a gradient line, from `0.0` at the line's start to `1.0` at its end.
pub struct ColorStop {
    /// The colour at the stop.
    pub color: geometry.Color
    /// The stop's place on the line.
    pub at: f32
}

/// What fills a box inside its border.
pub enum Fill {
    /// One colour.
    Solid(color: geometry.Color)
    /// A blend from `from` to `to` along a line through the box's centre `angle` degrees clockwise from straight up, as CSS's `linear-gradient` draws it.
    Linear(angle: f32, from: ColorStop, to: ColorStop)
}

/// How an element looks, apart from its layout.
pub struct Visual {
    /// The fill inside the border.
    pub background: Fill = Solid(geometry.Color {})
    /// The colour of the border, whose widths are part of the layout style.
    pub border_color: geometry.Color = geometry.Color {}
    /// The radius of each corner of the border box.
    pub corners: geometry.Corners = geometry.Corners {}
    /// The shadows drawn under the element, first lowest.
    pub shadows: []BoxShadow = []
    /// The colour of text in the element and its children, or `none` to inherit the parent's.
    pub text_color: geometry.Color? = none
    /// The em size of text in the element and its children in logical pixels, or `none` to inherit the parent's.
    pub text_size: f32? = none
    /// The line under text in the element and its children, or `none` to inherit the parent's.
    pub underline: uitext.Decoration? = none
    /// The line through text in the element and its children, or `none` to inherit the parent's.
    pub strikethrough: uitext.Decoration? = none
    /// The font family of text in the element and its children, or `none` to inherit the parent's.
    pub font_family: str? = none
    /// The font weight of text in the element and its children, from 1 to 1000, or `none` to inherit the parent's.
    pub font_weight: i64? = none
    /// Whether text in the element and its children is italic, or `none` to inherit the parent's.
    pub italic: bool? = none
    /// The distance between the tops of lines of text in the element and its children in logical pixels, or `none` to inherit the parent's.
    pub line_height: f32? = none
    /// Where lines of text in the element and its children sit across their width, or `none` to inherit the parent's.
    pub text_align: uitext.Align? = none
    /// Whether text in the element and its children wraps to its width, or `none` to inherit the parent's.
    pub wrap: bool? = none
    /// The most lines of text kept in the element and its children, 0 for any number, or `none` to inherit the parent's.
    pub max_lines: i64? = none
    /// The text that ends a line of text cut short in the element and its children, `""` for none, or `none` to inherit the parent's.
    pub ellipsis: str? = none
    /// How opaque the element and its children are, from `0.0` invisible to `1.0`.
    pub opacity: f32 = 1.0
    /// Whether an `img` element draws its image in gray.
    pub grayscale: bool = false
}

/// A node of the user interface: a box laid out by flexbox, or a run of text.
///
/// Elements are values built with `div` and `text` and changed with the builder functions, each of which returns a changed copy.
pub struct Element {
    style: layout.Style = layout.Style {}
    visual: Visual = Visual {}
    kind: Kind = Box
    content: str = ""
    highlights: []uitext.Highlight = []
    children: []Element = []
    id: str = ""
    group_name: str = ""
    focusable: bool = false
    occludes: bool = false
    context: str = ""
    listeners: []Listener = []
    conditionals: []Conditional = []
    animations: []Animated = []
    tip: Tooltip? = none
    drag: Drag? = none
    pointer: platform.Cursor? = none
    input: InputHandler? = none
    area: WindowControlArea? = none
}

/// The part of a window's title bar an element plays, for a window that draws its own decorations.
pub enum WindowControlArea {
    /// Moves the window when pressed, maximizes or restores it when double-clicked, and shows the window menu when right-clicked.
    Drag
    /// Closes the window when clicked.
    Close
    /// Maximizes the window when clicked, or restores it when it is maximized.
    Maximize
    /// Minimizes the window when clicked.
    Minimize
}

/// How an element that edits text takes typed text and the input method's compositions while it has focus.
pub struct InputHandler {
    /// Replaces the composition, else the selection, with `text`, ends the composition and puts the caret after the text.
    pub insert: fn(str)
    /// Replaces the composition, else the selection, with `text` and makes it the composition, selecting `selected`, byte offsets into `text`, or putting the caret after it for `none`. Empty text ends the composition and removes its text.
    pub compose: fn(str, platform.TextRange?)
    /// Returns the caret's rectangle, or the selection's, given the element's border box, both in logical pixels from the top left of the window.
    pub caret: fn(geometry.Rect) -> geometry.Rect
}

enum Kind {
    Box
    Text
    Deferred(priority: i64)
    Anchored(spec: Anchor)
    Uniform(count: i64, items: fn(i64, i64) -> []Element)
    Listed(state: ListState, item: fn(i64) -> Element)
    Canvas(paint: fn(mut Painter))
    Img(source: RenderImage, fit: ObjectFit)
    Cached(key: str)
}

/// A corner of a rectangle.
pub enum Corner {
    /// The top left corner.
    TopLeft
    /// The top right corner.
    TopRight
    /// The bottom left corner.
    BottomLeft
    /// The bottom right corner.
    BottomRight
}

/// Where `anchored` places its children.
pub struct Anchor {
    /// The point in logical pixels from the top left of the window, or `none` for where the layout put the anchored element.
    pub position: geometry.Point? = none
    /// The corner of the children's box that sits at the point.
    pub corner: Corner = TopLeft
    /// A distance added to the point.
    pub offset: geometry.Point = geometry.Point {}
    /// `true` to slide the box inside the window when it would cross an edge, `false` to flip it to the other side of the point on that axis.
    pub snap: bool = false
    /// How far from the window's edges a snapped box stays, in logical pixels.
    pub margin: f32 = 0.0
}

struct Tooltip {
    build: fn() -> Element
}

struct Drag {
    value: str
    preview: fn() -> Element
}

struct Animated {
    id: str
    animation: Animation
    apply: fn(Element, f32) -> Element
}

/// A press or release of a pointer button.
pub struct MouseEvent {
    /// Where the pointer was, in logical pixels from the top left of the window.
    pub position: geometry.Point
    /// The button.
    pub button: platform.Button
    /// The modifiers held.
    pub modifiers: platform.Modifiers
    /// `1` for a single press, `2` for the second of a double click and so on; a release carries the count of its press.
    pub click_count: i64
}

/// A move of the pointer.
pub struct MoveEvent {
    /// Where the pointer moved to, in logical pixels from the top left of the window.
    pub position: geometry.Point
    /// The button held while moving, if any.
    pub pressed: platform.Button?
    /// The modifiers held.
    pub modifiers: platform.Modifiers
}

/// A turn of the wheel or a swipe on a touchpad.
pub struct ScrollEvent {
    /// Where the pointer was, in logical pixels from the top left of the window.
    pub position: geometry.Point
    /// How far to scroll right, in logical pixels.
    pub dx: f32
    /// How far to scroll down, in logical pixels.
    pub dy: f32
    /// The modifiers held.
    pub modifiers: platform.Modifiers
}

/// A press and release of the primary button on the same element.
pub struct ClickEvent {
    /// Where the pointer was at the release, in logical pixels from the top left of the window.
    pub position: geometry.Point
    /// The modifiers held at the release.
    pub modifiers: platform.Modifiers
    /// `1` for a single click, `2` for a double click and so on.
    pub click_count: i64
}

enum Listener {
    Click(f: fn(ClickEvent))
    MouseDown(button: platform.Button, f: fn(MouseEvent))
    MouseUp(button: platform.Button, f: fn(MouseEvent))
    MouseDownOut(f: fn(MouseEvent))
    MouseMove(f: fn(MoveEvent))
    Scroll(f: fn(ScrollEvent))
    KeyDown(f: fn(platform.KeyEvent))
    KeyUp(f: fn(platform.KeyEvent))
    ModifiersChanged(f: fn(platform.Modifiers))
    Action(name: str, f: fn())
    Drop(f: fn(str))
}

enum Condition {
    Hovered
    Active
    Focused
    InFocus
    GroupHovered(name: str)
    GroupActive(name: str)
    DragOver
}

struct Conditional {
    when: Condition
    change: fn(Visual) -> Visual
}

fn listen(e: Element, l: Listener) -> Element {
    var out = e
    out.listeners = e.listeners[0..]
    out.listeners.push(l)
    out
}

fn when(e: Element, c: Condition, f: fn(Visual) -> Visual) -> Element {
    var out = e
    out.conditionals = e.conditionals[0..]
    out.conditionals.push(Conditional { when: c, change: f })
    out
}

/// Returns `e` running `f` when a press and a release of the primary button both land on it. A click reaches every element under the pointer that the press also reached, innermost first, until one calls `stop_propagation`.
pub fn on_click(e: Element, f: fn(ClickEvent)) -> Element {
    listen(e, Click(f))
}

/// Returns `e` running `f` when `button` is pressed over it. Presses bubble from the innermost element under the pointer outward until one calls `stop_propagation`.
pub fn on_mouse_down(e: Element, button: platform.Button, f: fn(MouseEvent)) -> Element {
    listen(e, MouseDown(button, f))
}

/// Returns `e` running `f` when `button` is released over it. Releases bubble like presses.
pub fn on_mouse_up(e: Element, button: platform.Button, f: fn(MouseEvent)) -> Element {
    listen(e, MouseUp(button, f))
}

/// Returns `e` running `f` when any button is pressed anywhere but over it, as a popup does to close.
pub fn on_mouse_down_out(e: Element, f: fn(MouseEvent)) -> Element {
    listen(e, MouseDownOut(f))
}

/// Returns `e` running `f` when the pointer moves over it. Moves bubble like presses.
pub fn on_mouse_move(e: Element, f: fn(MoveEvent)) -> Element {
    listen(e, MouseMove(f))
}

/// Returns `e` running `f` when the wheel turns with the pointer over it. Wheel events bubble like presses, and a scrolling element that moves stops them.
pub fn on_scroll_wheel(e: Element, f: fn(ScrollEvent)) -> Element {
    listen(e, Scroll(f))
}

/// Returns `e` running `f` when a key is pressed while it or an element inside it is focused. Key events bubble from the focused element outward until one calls `stop_propagation`. A key that completes or continues a binding with a handler reaches none.
pub fn on_key_down(e: Element, f: fn(platform.KeyEvent)) -> Element {
    listen(e, KeyDown(f))
}

/// Returns `e` running `f` when a key is released while it or an element inside it is focused.
pub fn on_key_up(e: Element, f: fn(platform.KeyEvent)) -> Element {
    listen(e, KeyUp(f))
}

/// Returns `e` running `f` with the modifiers held when they change while it or an element inside it is focused.
pub fn on_modifiers_changed(e: Element, f: fn(platform.Modifiers)) -> Element {
    listen(e, ModifiersChanged(f))
}

/// Returns `e` made focusable and taking typed text and the input method's compositions through `h` while it has focus. Text reaches `h` when a key press produces text that no binding or key listener consumed.
pub fn on_input(e: Element, h: InputHandler) -> Element {
    var out = e
    out.input = h
    out.focusable = true
    out
}

/// Returns `e` running `f` when the action `name` is dispatched while it or an element inside it is focused. Actions bubble from the focused element outward; the first handler stops them unless it calls `propagate`.
pub fn on_action(e: Element, name: str, f: fn()) -> Element {
    listen(e, Action(name, f))
}

/// Returns `e` drawn with `f` applied to its visual while the pointer is over it and no element above it occludes it.
pub fn hover(e: Element, f: fn(Visual) -> Visual) -> Element {
    when(e, Hovered, f)
}

/// Returns `e` drawn with `f` applied to its visual from a press of the primary button over it until the release.
pub fn active(e: Element, f: fn(Visual) -> Visual) -> Element {
    when(e, Active, f)
}

/// Returns `e` drawn with `f` applied to its visual while it is focused.
pub fn focus(e: Element, f: fn(Visual) -> Visual) -> Element {
    when(e, Focused, f)
}

/// Returns `e` drawn with `f` applied to its visual while it or an element inside it is focused.
pub fn in_focus(e: Element, f: fn(Visual) -> Visual) -> Element {
    when(e, InFocus, f)
}

/// Returns `e` naming a group that elements inside it can style themselves by with `group_hover` and `group_active`.
pub fn group(e: Element, name: str) -> Element {
    var out = e
    out.group_name = name
    out
}

/// Returns `e` drawn with `f` applied to its visual while the pointer is over its nearest enclosing group named `name`.
pub fn group_hover(e: Element, name: str, f: fn(Visual) -> Visual) -> Element {
    when(e, GroupHovered(name), f)
}

/// Returns `e` drawn with `f` applied to its visual while its nearest enclosing group named `name` is active.
pub fn group_active(e: Element, name: str, f: fn(Visual) -> Visual) -> Element {
    when(e, GroupActive(name), f)
}

/// Returns `e` hiding the elements drawn before it from the pointer where it covers them, so they are not hovered, pressed or scrolled through it.
pub fn occlude(e: Element) -> Element {
    var out = e
    out.occludes = true
    out
}

/// Returns `e` acting as the part `area` of the window's title bar. A press on a descendant that has listeners, takes focus or can be dragged acts on that descendant instead.
pub fn window_control_area(e: Element, area: WindowControlArea) -> Element {
    var out = e
    out.area = area
    out
}

/// Returns `e` showing the cursor `c` while the pointer is over it and over no element above it that sets its own.
pub fn cursor(e: Element, c: platform.Cursor) -> Element {
    var out = e
    out.pointer = c
    out
}

/// Returns `e` showing the element `f` makes beside the pointer once the pointer has rested on `e` for half a second, until it leaves or a button is pressed.
pub fn tooltip(e: Element, f: fn() -> Element) -> Element {
    var out = e
    out.tip = Tooltip { build: f }
    out
}

/// Returns `e` starting a drag of `value` when the primary button is pressed on it and the pointer then moves two logical pixels. The element `preview` makes follows the pointer, held where it was grabbed, until the release.
pub fn on_drag(e: Element, value: str, preview: fn() -> Element) -> Element {
    var out = e
    out.drag = Drag { value, preview }
    out
}

/// Returns `e` running `f` with the dragged value when a drag ends over it. Drops bubble like releases.
pub fn on_drop(e: Element, f: fn(str)) -> Element {
    listen(e, Drop(f))
}

/// Returns `e` drawn with `f` applied to its visual while a drag is over it.
pub fn drag_over(e: Element, f: fn(Visual) -> Visual) -> Element {
    when(e, DragOver, f)
}

/// Returns `e` built again each frame by `f` from itself and the eased progress of `animation`, from `0.0` at its start to `1.0` at its end.
///
/// The animation starts the first frame an element with this `id` is built and is forgotten the first frame none is. Frames are due while it runs.
pub fn with_animation(e: Element, id: str, animation: Animation, f: fn(Element, f32) -> Element) -> Element {
    var out = e
    out.animations = e.animations[0..]
    out.animations.push(Animated { id, animation, apply: f })
    out
}

/// Returns a box that lays `child` out where it stands but paints it, and records its hitboxes, after the rest of the frame, so it sits on top. Deferred boxes are painted by ascending `priority`, then in tree order.
pub fn deferred(child: Element) -> Element {
    Element { kind: Deferred(0), children: [child] }
}

/// Returns the deferred box `e` painted in the layer `level`.
pub fn priority(e: Element, level: i64) -> Element {
    var out = e
    out.kind = Deferred(level)
    out
}

/// Returns a box outside its parent's flow, sized by its children, and placed as `spec` says, ignoring its parent's scroll offsets when `spec` gives a position.
pub fn anchored(spec: Anchor) -> Element {
    var out = Element { kind: Anchored(spec) }
    out.style.position = Absolute
    out
}

/// Returns `e` clipping its children to its padding box.
pub fn overflow_hidden(e: Element) -> Element {
    var out = e
    out.style.overflow_x = Hidden
    out.style.overflow_y = Hidden
    out
}

/// Returns `e` clipping its children to the left and right sides of its padding box.
pub fn overflow_x_hidden(e: Element) -> Element {
    var out = e
    out.style.overflow_x = Hidden
    out
}

/// Returns `e` clipping its children to the top and bottom sides of its padding box.
pub fn overflow_y_hidden(e: Element) -> Element {
    var out = e
    out.style.overflow_y = Hidden
    out
}

/// Returns `e` clipping its children to its padding box and scrolling them with the wheel on both axes.
pub fn overflow_scroll(e: Element) -> Element {
    var out = e
    out.style.overflow_x = Scroll
    out.style.overflow_y = Scroll
    out
}

/// Returns `e` clipping its children to its padding box and scrolling them left and right.
pub fn overflow_x_scroll(e: Element) -> Element {
    var out = e
    out.style.overflow_x = Scroll
    out
}

/// Returns `e` clipping its children to its padding box and scrolling them up and down.
pub fn overflow_y_scroll(e: Element) -> Element {
    var out = e
    out.style.overflow_y = Scroll
    out
}

/// Returns an empty box: a flex row with no size, no children and nothing drawn.
pub fn div() -> Element {
    Element {}
}

/// Returns a text leaf that wraps `s` to the width it is given.
pub fn text(s: str) -> Element {
    Element { content: s, kind: Text }
}

/// Returns a vertically scrolling list named `id` of `count` items of one height, built only where they show.
///
/// Each frame calls `items(0, 1)` to measure the first item's height at the list's content width, then `items(first, end)` for the items from `first` up to but not including `end` that the list's content box shows at its scroll offset. Items fill the content width.
pub fn uniform_list(id: str, count: i64, items: fn(i64, i64) -> []Element) -> Element {
    var out = Element { id, kind: Uniform(count, items) }
    out.style.overflow_y = Scroll
    out
}

/// Returns a box sized like a `div` whose content `paint` draws each frame through a `Painter` holding the box's bounds.
pub fn canvas(paint: fn(mut Painter)) -> Element {
    Element { kind: Canvas(paint) }
}

/// Returns `e` laying its children out left to right.
pub fn row(e: Element) -> Element {
    var out = e
    out.style.direction = Row
    out
}

/// Returns `e` laying its children out top to bottom.
pub fn column(e: Element) -> Element {
    var out = e
    out.style.direction = Column
    out
}

/// Returns `e` with `px` logical pixels between consecutive children.
pub fn gap(e: Element, px: f32) -> Element {
    var out = e
    out.style.gap = px
    out
}

/// Returns `e` with `px` logical pixels of padding on every side.
pub fn padding(e: Element, px: f32) -> Element {
    var out = e
    out.style.padding = geometry.edges(px)
    out
}

/// Returns `e` with a border box of `width` by `height` logical pixels.
pub fn size(e: Element, width: f32, height: f32) -> Element {
    var out = e
    out.style.width = Px(width)
    out.style.height = Px(height)
    out
}

/// Returns `e` with a border box `px` logical pixels wide.
pub fn width(e: Element, px: f32) -> Element {
    var out = e
    out.style.width = Px(px)
    out
}

/// Returns `e` with a border box `px` logical pixels high.
pub fn height(e: Element, px: f32) -> Element {
    var out = e
    out.style.height = Px(px)
    out
}

/// Returns `e` taking a `share` of its parent's free space along the main axis.
pub fn grow(e: Element, share: f32) -> Element {
    var out = e
    out.style.grow = share
    out
}

/// Returns `e` centring its children on the cross axis.
pub fn items_center(e: Element) -> Element {
    var out = e
    out.style.align_items = Center
    out
}

/// Returns `e` centring its children on the main axis.
pub fn justify_center(e: Element) -> Element {
    var out = e
    out.style.justify = Center
    out
}

/// Returns `e` spreading its children along the main axis with the free space between them.
pub fn justify_between(e: Element) -> Element {
    var out = e
    out.style.justify = SpaceBetween
    out
}

/// Returns `e` filled with `c`.
pub fn background(e: Element, c: geometry.Color) -> Element {
    var out = e
    out.visual.background = Solid(c)
    out
}

/// Returns `e` filled with `f`, such as a `linear_gradient`.
pub fn fill(e: Element, f: Fill) -> Element {
    var out = e
    out.visual.background = f
    out
}

/// Returns the colour `color` at `at` on a gradient line, from `0.0` at its start to `1.0` at its end.
pub fn color_stop(color: geometry.Color, at: f32) -> ColorStop {
    ColorStop { color, at }
}

/// Returns a fill blending from `from` to `to` along a line `angle` degrees clockwise from straight up: `0.0` runs bottom to top and `90.0` left to right. Before `from` the fill is its colour, and after `to` the other's.
pub fn linear_gradient(angle: f32, from: ColorStop, to: ColorStop) -> Fill {
    Linear(angle, from, to)
}

/// Returns `e` with a border `px` logical pixels wide on every side, coloured `c`.
pub fn border(e: Element, px: f32, c: geometry.Color) -> Element {
    var out = e
    out.style.border = geometry.edges(px)
    out.visual.border_color = c
    out
}

/// Returns `e` with every corner rounded to a radius of `px` logical pixels.
pub fn rounded(e: Element, px: f32) -> Element {
    var out = e
    out.visual.corners = geometry.corners(px)
    out
}

/// Returns `e` with `s` added above its other shadows.
pub fn shadow(e: Element, s: BoxShadow) -> Element {
    var out = e
    out.visual.shadows = e.visual.shadows[0..]
    out.visual.shadows.push(s)
    out
}

/// Returns `e` drawing its text, and its children's unless they set their own, in `c`.
pub fn text_color(e: Element, c: geometry.Color) -> Element {
    var out = e
    out.visual.text_color = c
    out
}

/// Returns `e` drawing a line under its text, and its children's unless they set their own.
pub fn underline(e: Element, d: uitext.Decoration) -> Element {
    var out = e
    out.visual.underline = d
    out
}

/// Returns `e` drawing a line through its text, and its children's unless they set their own.
pub fn strikethrough(e: Element, d: uitext.Decoration) -> Element {
    var out = e
    out.visual.strikethrough = d
    out
}

/// Returns a `text` element `e` styling the byte ranges of its text that `hs` cover, each over the ones before it and over the element's own colour and decorations.
pub fn highlights(e: Element, hs: []uitext.Highlight) -> Element {
    var out = e
    out.highlights = hs
    out
}

/// Returns `e` drawing its text, and its children's unless they set their own, at `px` logical pixels to the em.
pub fn text_size(e: Element, px: f32) -> Element {
    var out = e
    out.visual.text_size = px
    out
}

/// Returns `e` drawing its text, and its children's unless they set their own, in the font family `name`, or in the system's usual family for `sans-serif`, `serif` or `monospace`.
pub fn font_family(e: Element, name: str) -> Element {
    var out = e
    out.visual.font_family = name
    out
}

/// Returns `e` drawing its text, and its children's unless they set their own, at the font weight `weight`, from 1 to 1000 with 400 regular and 700 bold.
pub fn font_weight(e: Element, weight: i64) -> Element {
    var out = e
    out.visual.font_weight = weight
    out
}

/// Returns `e` drawing its text, and its children's unless they set their own, in italic.
pub fn italic(e: Element) -> Element {
    var out = e
    out.visual.italic = true
    out
}

/// Returns `e` placing lines of its text, and its children's unless they set their own, `px` logical pixels apart.
pub fn line_height(e: Element, px: f32) -> Element {
    var out = e
    out.visual.line_height = px
    out
}

/// Returns `e` placing lines of its text, and its children's unless they set their own, at the left of their width.
pub fn text_left(e: Element) -> Element {
    var out = e
    out.visual.text_align = uitext.Align.Left
    out
}

/// Returns `e` centring lines of its text, and its children's unless they set their own, across their width.
pub fn text_center(e: Element) -> Element {
    var out = e
    out.visual.text_align = uitext.Align.Center
    out
}

/// Returns `e` placing lines of its text, and its children's unless they set their own, at the right of their width.
pub fn text_right(e: Element) -> Element {
    var out = e
    out.visual.text_align = uitext.Align.Right
    out
}

/// Returns `e` breaking lines of its text, and its children's unless they set their own, only where the text breaks them.
pub fn whitespace_nowrap(e: Element) -> Element {
    var out = e
    out.visual.wrap = false
    out
}

/// Returns `e` wrapping lines of its text, and its children's unless they set their own, to their width.
pub fn whitespace_normal(e: Element) -> Element {
    var out = e
    out.visual.wrap = true
    out
}

/// Returns `e` ending a line of its text, and its children's unless they set their own, that is cut short with `…`.
pub fn text_ellipsis(e: Element) -> Element {
    var out = e
    out.visual.ellipsis = "…"
    out
}

/// Returns `e` keeping at most `lines` lines of its text, and its children's unless they set their own, and clipping its content.
pub fn line_clamp(e: Element, lines: i64) -> Element {
    var out = e
    out.visual.max_lines = lines
    out.overflow_hidden()
}

/// Returns `e` showing its text, and its children's unless they set their own, on one line cut short with `…` to fit its width, clipping its content.
pub fn truncate(e: Element) -> Element {
    var out = e
    out.visual.wrap = false
    out.visual.max_lines = 1
    out.visual.ellipsis = "…"
    out.overflow_hidden()
}

/// Returns `e` drawn, with its children, at `alpha` times their opacity.
pub fn opacity(e: Element, alpha: f32) -> Element {
    var out = e
    out.visual.opacity = alpha
    out
}

/// Returns `e` named `name`, which keeps its focus and its pressed state across frames however the tree around it changes.
pub fn id(e: Element, name: str) -> Element {
    var out = e
    out.id = name
    out
}

/// Returns `e` able to take keyboard focus by a click or by Tab.
pub fn focusable(e: Element) -> Element {
    var out = e
    out.focusable = true
    out
}

/// Returns `e` adding the key context `context` while it or an element inside it is focused: space-separated names and `key=value` pairs, such as `"Editor mode=full"`, that binding predicates test.
pub fn key_context(e: Element, context: str) -> Element {
    var out = e
    out.context = context
    out
}

/// Returns `e` with `c` added after its other children.
pub fn child(e: Element, c: Element) -> Element {
    var out = e
    out.children = e.children[0..]
    out.children.push(c)
    out
}

/// Returns `e` with `cs` added after its other children, in order. `children()` takes a trailing block of elements.
pub fn children(e: Element, cs: []Element) -> Element {
    var out = e
    out.children = e.children[0..]
    for c in cs {
        out.children.push(c)
    }
    out
}

/// Returns `v` filled with `c`.
pub fn with_background(v: Visual, c: geometry.Color) -> Visual {
    var out = v
    out.background = Solid(c)
    out
}

/// Returns `v` filled with `f`.
pub fn with_fill(v: Visual, f: Fill) -> Visual {
    var out = v
    out.background = f
    out
}

/// Returns `v` with its border coloured `c`.
pub fn with_border_color(v: Visual, c: geometry.Color) -> Visual {
    var out = v
    out.border_color = c
    out
}

/// Returns `v` drawing a line under text.
pub fn with_underline(v: Visual, d: uitext.Decoration) -> Visual {
    var out = v
    out.underline = d
    out
}

/// Returns `v` drawing a line through text.
pub fn with_strikethrough(v: Visual, d: uitext.Decoration) -> Visual {
    var out = v
    out.strikethrough = d
    out
}

/// Returns `v` drawing text in `c`.
pub fn with_text_color(v: Visual, c: geometry.Color) -> Visual {
    var out = v
    out.text_color = c
    out
}

/// Returns `e` with the layout style `f` makes from its own, for settings no builder covers.
pub fn style(e: Element, f: fn(layout.Style) -> layout.Style) -> Element {
    var out = e
    out.style = f(e.style)
    out
}

/// Returns `e` with the visual `f` makes from its own, for settings no builder covers.
pub fn visual(e: Element, f: fn(Visual) -> Visual) -> Element {
    var out = e
    out.visual = f(e.visual)
    out
}

/// Returns `e` filling its parent's inner width and height.
pub fn size_full(e: Element) -> Element {
    var out = e
    out.style.width = Percent(100.0)
    out.style.height = Percent(100.0)
    out
}

/// Returns `e` as wide as its parent's inner width.
pub fn width_full(e: Element) -> Element {
    var out = e
    out.style.width = Percent(100.0)
    out
}

/// Returns `e` as high as its parent's inner height.
pub fn height_full(e: Element) -> Element {
    var out = e
    out.style.height = Percent(100.0)
    out
}

/// Returns `e` with a width of `percent` percent of its parent's inner width.
pub fn width_percent(e: Element, percent: f32) -> Element {
    var out = e
    out.style.width = Percent(percent)
    out
}

/// Returns `e` with a height of `percent` percent of its parent's inner height.
pub fn height_percent(e: Element, percent: f32) -> Element {
    var out = e
    out.style.height = Percent(percent)
    out
}

/// Returns `e` never narrower than `px` logical pixels.
pub fn min_width(e: Element, px: f32) -> Element {
    var out = e
    out.style.min_width = Px(px)
    out
}

/// Returns `e` never shorter than `px` logical pixels.
pub fn min_height(e: Element, px: f32) -> Element {
    var out = e
    out.style.min_height = Px(px)
    out
}

/// Returns `e` never wider than `px` logical pixels.
pub fn max_width(e: Element, px: f32) -> Element {
    var out = e
    out.style.max_width = Px(px)
    out
}

/// Returns `e` never taller than `px` logical pixels.
pub fn max_height(e: Element, px: f32) -> Element {
    var out = e
    out.style.max_height = Px(px)
    out
}

/// Returns `e` giving up a `share` of negative free space, weighted by its basis.
pub fn shrink(e: Element, share: f32) -> Element {
    var out = e
    out.style.shrink = share
    out
}

/// Returns `e` starting at `px` logical pixels along its parent's main axis before free space is shared.
pub fn basis(e: Element, px: f32) -> Element {
    var out = e
    out.style.basis = Px(px)
    out
}

/// Returns `e` growing and shrinking from a basis of zero, so siblings that all do share the main axis equally.
pub fn flex_1(e: Element) -> Element {
    var out = e
    out.style.grow = 1.0
    out.style.shrink = 1.0
    out.style.basis = Px(0.0)
    out
}

/// Returns `e` placing its children at the start of the cross axis.
pub fn items_start(e: Element) -> Element {
    var out = e
    out.style.align_items = Start
    out
}

/// Returns `e` placing its children at the end of the cross axis.
pub fn items_end(e: Element) -> Element {
    var out = e
    out.style.align_items = End
    out
}

/// Returns `e` stretching children without a cross size across its cross axis, the default.
pub fn items_stretch(e: Element) -> Element {
    var out = e
    out.style.align_items = Stretch
    out
}

/// Returns `e` placing its children at the start of the main axis, the default.
pub fn justify_start(e: Element) -> Element {
    var out = e
    out.style.justify = Start
    out
}

/// Returns `e` placing its children at the end of the main axis.
pub fn justify_end(e: Element) -> Element {
    var out = e
    out.style.justify = End
    out
}

/// Returns `e` spreading free space around each child, half a share at each end.
pub fn justify_around(e: Element) -> Element {
    var out = e
    out.style.justify = SpaceAround
    out
}

/// Returns `e` spreading free space in equal shares before, between and after its children.
pub fn justify_evenly(e: Element) -> Element {
    var out = e
    out.style.justify = SpaceEvenly
    out
}

/// Returns `e` placed at the start of its parent's cross axis whatever the parent's alignment.
pub fn self_start(e: Element) -> Element {
    var out = e
    out.style.align_self = Start
    out
}

/// Returns `e` placed at the end of its parent's cross axis.
pub fn self_end(e: Element) -> Element {
    var out = e
    out.style.align_self = End
    out
}

/// Returns `e` placed in the middle of its parent's cross axis.
pub fn self_center(e: Element) -> Element {
    var out = e
    out.style.align_self = Center
    out
}

/// Returns `e` stretched across its parent's cross axis.
pub fn self_stretch(e: Element) -> Element {
    var out = e
    out.style.align_self = Stretch
    out
}

/// Returns `e` with `px` logical pixels of padding on its left and right.
pub fn padding_x(e: Element, px: f32) -> Element {
    var out = e
    out.style.padding.left = px
    out.style.padding.right = px
    out
}

/// Returns `e` with `px` logical pixels of padding above and below.
pub fn padding_y(e: Element, px: f32) -> Element {
    var out = e
    out.style.padding.top = px
    out.style.padding.bottom = px
    out
}

/// Returns `e` with the padding of each side set from `edges`.
pub fn padding_edges(e: Element, edges: geometry.Edges) -> Element {
    var out = e
    out.style.padding = edges
    out
}

/// Returns `e` with `px` logical pixels of margin on every side.
pub fn margin(e: Element, px: f32) -> Element {
    var out = e
    out.style.margin = geometry.edges(px)
    out
}

/// Returns `e` with `px` logical pixels of margin on its left and right.
pub fn margin_x(e: Element, px: f32) -> Element {
    var out = e
    out.style.margin.left = px
    out.style.margin.right = px
    out
}

/// Returns `e` with `px` logical pixels of margin above and below.
pub fn margin_y(e: Element, px: f32) -> Element {
    var out = e
    out.style.margin.top = px
    out.style.margin.bottom = px
    out
}

/// Returns `e` with the margin of each side set from `edges`.
pub fn margin_edges(e: Element, edges: geometry.Edges) -> Element {
    var out = e
    out.style.margin = edges
    out
}

/// Returns `e` with the border width of each side set from `edges`, coloured `c`.
pub fn border_edges(e: Element, edges: geometry.Edges, c: geometry.Color) -> Element {
    var out = e
    out.style.border = edges
    out.visual.border_color = c
    out
}

/// Returns `e` with each corner rounded to its radius in `radii`.
pub fn rounded_corners(e: Element, radii: geometry.Corners) -> Element {
    var out = e
    out.visual.corners = radii
    out
}

/// Returns `e` taken out of its parent's flow and placed against the parent's padding box by `top`, `right`, `bottom` and `left`.
pub fn absolute(e: Element) -> Element {
    var out = e
    out.style.position = Absolute
    out
}

/// Returns `e` in its parent's flow, the default.
pub fn relative(e: Element) -> Element {
    var out = e
    out.style.position = Relative
    out
}

/// Returns `e`, when absolute, `px` logical pixels below the top of its parent's padding box.
pub fn top(e: Element, px: f32) -> Element {
    var out = e
    out.style.inset.top = Px(px)
    out
}

/// Returns `e`, when absolute, `px` logical pixels left of the right side of its parent's padding box.
pub fn right(e: Element, px: f32) -> Element {
    var out = e
    out.style.inset.right = Px(px)
    out
}

/// Returns `e`, when absolute, `px` logical pixels above the bottom of its parent's padding box.
pub fn bottom(e: Element, px: f32) -> Element {
    var out = e
    out.style.inset.bottom = Px(px)
    out
}

/// Returns `e`, when absolute, `px` logical pixels right of the left side of its parent's padding box.
pub fn left(e: Element, px: f32) -> Element {
    var out = e
    out.style.inset.left = Px(px)
    out
}

/// Returns `e`, when absolute, `px` logical pixels inside every side of its parent's padding box.
pub fn inset(e: Element, px: f32) -> Element {
    var out = e
    out.style.inset = layout.Inset { top: Px(px), right: Px(px), bottom: Px(px), left: Px(px) }
    out
}

/// Returns `e` taking no space and drawing nothing, with its children.
pub fn hidden(e: Element) -> Element {
    var out = e
    out.style.display = None
    out
}

/// Returns `v` at `alpha` times its opacity.
pub fn with_opacity(v: Visual, alpha: f32) -> Visual {
    var out = v
    out.opacity = v.opacity * alpha
    out
}
