/// A cell of state owned by a `Context`. Changing it requests a frame.
///
/// A signal is a handle: copies share the cell. It belongs to the green thread that runs the context; another green thread changes it through `post`.
pub struct Signal[T] {
    cell: *Cell[T]
}

struct Cell[T] {
    value: T
    owner: *State
    node: *Node
}

/// Returns a new signal holding `value`, owned by `cx`.
pub fn signal[T](cx: Context, value: T) -> Signal[T] {
    Signal { cell: new(Cell { value, owner: cx.state, node: new(Node {}) }) }
}

/// Returns the value `s` holds. A memo or effect that reads it depends on it.
pub fn get[T](s: Signal[T]) -> T {
    track(s.cell.owner, s.cell.node, false)
    s.cell.value
}

/// Replaces the value `s` holds with `value`, marks the memos and effects that read it, and requests a frame.
pub fn set[T](s: Signal[T], value: T) {
    s.cell.value = value
    s.cell.owner.dirty = true
    notify(s.cell.owner, s.cell.node)
}

/// Replaces the value `s` holds with `f` applied to it, as `set` does.
pub fn update[T](s: Signal[T], f: fn(T) -> T) {
    let next = f(s.cell.value)
    set(s, next)
}
