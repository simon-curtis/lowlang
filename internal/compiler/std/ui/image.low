import std/image
import std/ui/geometry
import std/ui/layout
import std/ui/scene
import uitext = std/ui/text

/// Decoded pixels an `img` element draws, named so the renderer resamples and uploads them once for each size they are drawn at. Copies share the name.
pub struct RenderImage {
    id: i64
    /// The pixels, in any `std/image` format.
    pub pixels: image.Image
}

/// How an `img` element fits its image into its content box.
pub enum ObjectFit {
    /// Stretches the image to the box.
    Fill
    /// Scales the image, keeping its shape, to the largest size that fits inside the box, centred.
    Contain
    /// Scales the image, keeping its shape, to the smallest size that covers the box, centred and clipped to it.
    Cover
    /// Draws the image as `Contain` would when it is larger than the box, and at its own size otherwise.
    ScaleDown
    /// Draws the image at its own size, centred and clipped to the box.
    Unscaled
}

/// Returns `pixels` named for drawing by `img` elements of `cx`.
pub fn render_image(cx: Context, pixels: image.Image) -> RenderImage {
    let st = cx.state
    st.images_made += 1
    RenderImage { id: st.images_made, pixels }
}

/// Returns an element drawing `source` in its content box, fitted by `Contain` unless `object_fit` says otherwise.
///
/// Its content size is the image's size, one logical pixel for each image pixel, scaled down to the width available while keeping its shape.
pub fn img(source: RenderImage) -> Element {
    Element { kind: Img(source, Contain) }
}

/// Returns `e`, an `img` element, fitting its image by `fit`. Other elements are returned unchanged.
pub fn object_fit(e: Element, fit: ObjectFit) -> Element {
    var out = e
    match e.kind {
        Img(source, _) => {
            out.kind = Img(source, fit)
        }
        _ => {}
    }
    out
}

/// Returns `e` drawing its images in gray, or in colour when `on` is `false`.
pub fn grayscale(e: Element, on: bool) -> Element {
    var out = e
    out.visual.grayscale = on
    out
}

/// Returns `v` drawing images in gray, or in colour when `on` is `false`.
pub fn with_grayscale(v: Visual, on: bool) -> Visual {
    var out = v
    out.grayscale = on
    out
}

fn image_size(source: RenderImage, available: f32) -> geometry.Size {
    let w = f32(source.pixels.width)
    let h = f32(source.pixels.height)
    if !layout.is_bounded(available) || available >= w || w <= 0.0 {
        return geometry.size(w, h)
    }
    geometry.size(available, h * available / w)
}

fn fitted(box: geometry.Rect, w: f32, h: f32, fit: ObjectFit) -> geometry.Rect {
    if fit == Fill {
        return box
    }
    let contain = smaller(box.width / w, box.height / h)
    let s = match fit {
        Contain => contain
        Cover => larger(box.width / w, box.height / h)
        ScaleDown => smaller(contain, 1.0)
        _ => 1.0
    }
    let width = w * s
    let height = h * s
    geometry.rect(box.x + (box.width - width) * 0.5, box.y + (box.height - height) * 0.5, width, height)
}

fn paint_image(mut sys: uitext.System, mut sc: scene.Scene, source: RenderImage, fit: ObjectFit, box: geometry.Rect, v: Visual, alpha: f32, scale: f32) {
    let w = f32(source.pixels.width)
    let h = f32(source.pixels.height)
    if !(w > 0.0 && h > 0.0 && box.width > 0.0 && box.height > 0.0 && alpha > 0.0) {
        return
    }
    let drawn = fitted(box, w, h, fit)
    let shown = geometry.intersect(drawn, box)
    if geometry.is_empty(shown) {
        return
    }
    let per_x = w / drawn.width
    let per_y = h / drawn.height
    let crop = geometry.rect((shown.x - drawn.x) * per_x, (shown.y - drawn.y) * per_y, shown.width * per_x, shown.height * per_y)
    let picture = scene.Picture {
        bounds: geometry.scale(shown, scale)
        corner_radii: geometry.scale_corners(v.corners, scale)
        opacity: alpha
        grayscale: if v.grayscale { 1.0 } else { 0.0 }
    }
    uitext.paint_image(mut sys, mut sc, "{source.id}", source.pixels, crop, picture)
}
