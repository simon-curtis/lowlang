import std/ui/geometry
import std/ui/svg

/// Returns a box that draws `icon` in the inherited text colour, scaled to fit the box as `preserveAspectRatio="xMidYMid meet"` does: the view box is made as large as the box allows without changing its shape and is centred.
///
/// The box has no size of its own, so the caller gives it one, as in `svg_icon(icon).size(16.0, 16.0)`. Every shape that paints a fill or a stroke is drawn in the text colour, whatever colour the document gives it or whether it says `currentColor`, and a colour's own alpha, `opacity`, `fill-opacity` and `stroke-opacity` fade it. Because an unspecified fill is black, an icon with no colours draws as a monochrome mask. A shape with an `evenodd` fill rule fills as `paint_path_evenodd` does.
pub fn svg_icon(icon: svg.Icon) -> Element {
    canvas(fn(mut p: Painter) {
        draw_icon(mut p, icon)
    })
}

fn draw_icon(mut p: Painter, icon: svg.Icon) {
    let view = icon.view_box
    let box = p.bounds
    if !(box.width > 0.0) || !(box.height > 0.0) || !(view.width > 0.0) || !(view.height > 0.0) {
        return
    }
    let across = box.width / view.width
    let down = box.height / view.height
    let scale = if across < down { across } else { down }
    let left = box.x + (box.width - view.width * scale) / 2.0 - view.x * scale
    let top = box.y + (box.height - view.height * scale) / 2.0 - view.y * scale
    for shape in icon.shapes {
        let placed = geometry.affine(shape.path, scale, 0.0, 0.0, scale, left, top)
        let fill = ink(shape.fill, p.color, shape.opacity * shape.fill_opacity)
        match fill {
            some(color) => {
                match shape.rule {
                    NonZero => p.paint_path(placed, color)
                    EvenOdd => p.paint_path_evenodd(placed, color)
                }
            }
            none => {}
        }
        let stroke = ink(shape.stroke, p.color, shape.opacity * shape.stroke_opacity)
        match stroke {
            some(color) => p.paint_stroke(placed, shape.stroke_width * scale, color)
            none => {}
        }
    }
}

fn ink(paint: svg.Paint, text: geometry.Color, opacity: f32) -> geometry.Color? {
    match paint {
        None => none
        Color(c) => geometry.with_alpha(text, text.a * c.a * opacity)
        Current => geometry.with_alpha(text, text.a * opacity)
    }
}
