import std/ui/geometry
import std/ui/scene
import uitext = std/ui/text

/// What a `canvas` draws in one frame, in logical pixels. The frame scales, clips and fades the marks like the element's own box, in the order they were made.
pub struct Painter {
    /// The canvas's border box, in logical pixels from the window's top left.
    pub bounds: geometry.Rect
    /// The text format the canvas inherits, which text drawn beside it is laid out with.
    pub format: uitext.Format = uitext.Format {}
    /// The text colour the canvas inherits, before the inherited opacity, which the frame applies to every mark.
    pub color: geometry.Color = geometry.Color {}
    marks: []Mark = []
}

enum Mark {
    Filled(q: scene.Quad)
    Cast(s: scene.Shadow)
    Shape(path: geometry.Path, rule: geometry.FillRule, color: geometry.Color)
    Traced(path: geometry.Path, width: f32, color: geometry.Color)
}

/// Adds the quad `q`, whose bounds, radii, border widths and gradient are in logical pixels; `scene.linear` makes a gradient from the logical bounds.
pub fn paint_quad(mut p: Painter, q: scene.Quad) {
    p.marks.push(Filled(q))
}

/// Adds the shadow `s`, whose bounds, radii and blur are in logical pixels.
pub fn paint_shadow(mut p: Painter, s: scene.Shadow) {
    p.marks.push(Cast(s))
}

/// Adds `path` filled with `color` by the nonzero rule.
pub fn paint_path(mut p: Painter, path: geometry.Path, color: geometry.Color) {
    p.marks.push(Shape(path, NonZero, color))
}

/// Adds `path` filled with `color` by the even-odd rule, so a contour inside another leaves a hole, one inside that fills again, and where contours cross the overlap is left empty.
pub fn paint_path_evenodd(mut p: Painter, path: geometry.Path, color: geometry.Color) {
    p.marks.push(Shape(path, EvenOdd, color))
}

/// Adds `path` traced in `color` by a round pen `width` logical pixels wide.
pub fn paint_stroke(mut p: Painter, path: geometry.Path, width: f32, color: geometry.Color) {
    p.marks.push(Traced(path, width, color))
}

/// Adds a line `width` long and `thickness` thick whose top left is `origin`, straight, or when `wavy` is set a wave of that thickness swinging `thickness` above and below the line's middle, a whole wave every six thicknesses.
pub fn paint_underline(mut p: Painter, origin: geometry.Point, width: f32, thickness: f32, color: geometry.Color, wavy: bool) {
    if !wavy {
        p.marks.push(Filled(scene.Quad { bounds: geometry.rect(origin.x, origin.y, width, thickness), background: color }))
        return
    }
    p.marks.push(Traced(geometry.wave(origin, width, thickness), thickness, color))
}

fn emit(p: Painter, mut sys: uitext.System, mut sc: scene.Scene, alpha: f32, scale: f32) {
    for m in p.marks {
        match m {
            Filled(q) => {
                var out = q
                out.bounds = geometry.scale(q.bounds, scale)
                out.background = faded(q.background, alpha)
                out.background_end = faded(q.background_end, alpha)
                out.gradient.dx = q.gradient.dx / scale
                out.gradient.dy = q.gradient.dy / scale
                out.border_color = faded(q.border_color, alpha)
                out.corner_radii = geometry.scale_corners(q.corner_radii, scale)
                out.border_widths = geometry.scale_edges(q.border_widths, scale)
                scene.push_quad(mut sc, out)
            }
            Cast(s) => {
                var out = s
                out.bounds = geometry.scale(s.bounds, scale)
                out.color = faded(s.color, alpha)
                out.corner_radii = geometry.scale_corners(s.corner_radii, scale)
                out.sigma = s.sigma * scale
                scene.push_shadow(mut sc, out)
            }
            Shape(path, rule, color) => uitext.paint_polygons(mut sys, mut sc, geometry.flatten(path, scale), rule, faded(color, alpha))
            Traced(path, width, color) => uitext.paint_polygons(mut sys, mut sc, geometry.stroke(path, width, scale), NonZero, faded(color, alpha))
        }
    }
}
