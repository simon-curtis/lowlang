/// A value computed from signals and other memos, recomputed only when one of them changes and read.
///
/// A memo is a handle: copies share it. When it recomputes to a value equal to the one it held, what depends on it does not run again.
pub struct Memo[T: Eq] {
    cell: *MemoCell[T]
}

struct MemoCell[T: Eq] {
    value: T?
    compute: fn() -> T
    owner: *State
    node: *Node
}

/// A function that runs again whenever a signal or memo it read during its last run changes, until it is disposed.
pub struct Effect {
    node: *Node
}

struct Node {
    dependents: []Link = []
    sources: []*Node = []
    rerun: fn() -> bool = fn() -> bool { false }
    state: Freshness = Clean
    generation: i64 = 0
    effect: bool = false
    queued: bool = false
    disposed: bool = false
}

struct Link {
    node: *Node
    generation: i64
}

enum Freshness {
    Clean
    Check
    Dirty
}

/// Returns a memo owned by `cx` that holds what `compute` returns, computed the first time it is read.
pub fn memo[T: Eq](cx: Context, compute: fn() -> T) -> Memo[T] {
    let node = new(Node { state: Dirty })
    let empty: T? = none
    let cell = new(MemoCell { value: empty, compute, owner: cx.state, node })
    node.rerun = fn() -> bool { recompute(cell) }
    Memo { cell }
}

/// Returns the value `m` holds, recomputing it first when a signal or memo it depends on has changed.
pub fn read[T: Eq](m: Memo[T]) -> T {
    let st = m.cell.owner
    refresh(st, m.cell.node)
    track(st, m.cell.node, true)
    m.cell.value ?? m.cell.compute()
}

/// Runs `f` once now, owned by `cx`, and again whenever a signal or memo it read changes, before the context's next frame or after the event that changed it.
pub fn effect(cx: Context, f: fn()) -> Effect {
    let node = new(Node { effect: true })
    node.rerun = fn() -> bool {
        f()
        true
    }
    run_node(cx.state, node)
    Effect { node }
}

/// Stops `e` from running again.
pub fn dispose(e: Effect) {
    e.node.disposed = true
    e.node.generation += 1
    e.node.sources = []
}

fn recompute[T: Eq](cell: *MemoCell[T]) -> bool {
    let next = cell.compute()
    let changed = match cell.value {
        some(v) => v != next
        none => true
    }
    cell.value = next
    changed
}

fn track(st: *State, source: *Node, memo: bool) {
    let reader = st.observer ?? return
    var kept: []Link = []
    for l in source.dependents {
        if l.node == reader && l.generation == reader.generation {
            return
        }
        if l.node != reader && l.generation == l.node.generation && !l.node.disposed {
            kept.push(l)
        }
    }
    kept.push(Link { node: reader, generation: reader.generation })
    source.dependents = kept
    if memo {
        reader.sources.push(source)
    }
}

fn notify(st: *State, source: *Node) {
    for l in live(source) {
        mark(st, l.node, Dirty)
    }
}

fn live(n: *Node) -> []Link {
    var kept: []Link = []
    for l in n.dependents {
        if l.generation == l.node.generation && !l.node.disposed {
            kept.push(l)
        }
    }
    n.dependents = kept
    kept
}

fn mark(st: *State, n: *Node, to: Freshness) {
    if level(n.state) >= level(to) {
        return
    }
    n.state = to
    if n.effect {
        if !n.queued {
            n.queued = true
            st.effects.push(n)
        }
        return
    }
    for l in live(n) {
        mark(st, l.node, Check)
    }
}

fn level(f: Freshness) -> i64 {
    match f {
        Clean => 0
        Check => 1
        Dirty => 2
    }
}

fn refresh(st: *State, n: *Node) {
    if n.state == Check {
        for s in n.sources {
            refresh(st, s)
            if n.state == Dirty {
                break
            }
        }
        if n.state == Check {
            n.state = Clean
        }
    }
    if n.state == Dirty {
        run_node(st, n)
    }
}

fn run_node(st: *State, n: *Node) {
    n.generation += 1
    n.sources = []
    n.state = Clean
    let outer = st.observer
    st.observer = some(n)
    let changed = n.rerun()
    st.observer = outer
    if changed && !n.effect {
        for l in live(n) {
            l.node.state = Dirty
        }
    }
}

fn flush_effects(st: *State) {
    var rounds = 0
    for st.effects.len > 0 {
        rounds += 1
        if rounds > effect_rounds() {
            __panic("ui: effects kept setting signals they read for {effect_rounds()} rounds")
        }
        let due = st.effects
        st.effects = []
        for n in due {
            n.queued = false
            if !n.disposed {
                refresh(st, n)
            }
        }
    }
}

fn effect_rounds() -> i64 {
    100
}
