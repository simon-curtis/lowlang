import std/ui/geometry
import std/ui/layout

/// Where a `list` shorter than its view sits, and which end it keeps in view.
pub enum ListAlignment {
    /// Items start at the top, and the list opens at its first item.
    Top
    /// Items end at the bottom, the list opens at its last item, and a list scrolled to its end stays there as items arrive, as a chat log does.
    Bottom
}

/// A place in a list: an item, and how far below the item's top edge the view's top edge is.
pub struct ListOffset {
    /// The index of the item at the top of the view.
    pub item: i64 = 0
    /// How far into that item the view starts, in logical pixels.
    pub offset: f32 = 0.0
}

struct ListData {
    owner: *State
    count: i64
    alignment: ListAlignment
    heights: []f32
    width: f32 = -1.0
    top: ListOffset = ListOffset {}
    reported: f32 = 0.0
    at_end: bool
    reveal: i64 = -1
}

/// The state of a `list`: its item count, the heights of the items it has laid out, and its scroll position. Copies share the state.
pub struct ListState {
    data: *ListData
}

struct Shown {
    laid: Laid
    y: f32
    height: f32
}

struct Pass {
    st: *State
    d: *ListData
    key: str
    ts: TextStyle
    item: fn(i64) -> Element
    view: f32
}

/// Returns the state of a list of `count` items owned by `cx`, whose changes request a frame.
pub fn list_state(cx: Context, count: i64, alignment: ListAlignment) -> ListState {
    let data = new(ListData { owner: cx.state, count, alignment, heights: unknown_heights(count), at_end: alignment == Bottom })
    ListState { data }
}

/// Returns a vertically scrolling list of the items of `state`, built by `item` only where they show. Items fill the list's content width and take the height they lay out to.
pub fn list(state: ListState, item: fn(i64) -> Element) -> Element {
    var out = Element { kind: Listed(state, item) }
    out.style.overflow_y = Scroll
    out
}

/// Returns the number of items.
pub fn item_count(s: ListState) -> i64 {
    s.data.count
}

/// Replaces every item with `count` new ones and scrolls to the start, or to the end of a `Bottom` list.
pub fn reset(s: ListState, count: i64) {
    let d = s.data
    d.count = count
    d.heights = unknown_heights(count)
    d.top = ListOffset {}
    d.at_end = d.alignment == Bottom
    d.reveal = -1
    d.owner.dirty = true
}

/// Replaces the items from `from` up to but not including `to` with `count` new ones, keeping the item at the top of the view in place.
pub fn splice(s: ListState, from: i64, to: i64, count: i64) {
    let d = s.data
    var heights: []f32 = []
    for i in 0..from {
        heights.push(d.heights[i])
    }
    for i in 0..count {
        heights.push(-1.0)
    }
    for i in to..d.count {
        heights.push(d.heights[i])
    }
    d.heights = heights
    d.count = heights.len
    if d.top.item >= to {
        d.top.item += count - (to - from)
    } else if d.top.item >= from {
        d.top = ListOffset { item: from }
    }
    if d.top.item >= d.count {
        d.top = ListOffset { item: d.count }
    }
    d.owner.dirty = true
}

/// Returns the item at the top of the view and how far into it the view starts.
pub fn logical_scroll_top(s: ListState) -> ListOffset {
    s.data.top
}

/// Scrolls so the view starts `position.offset` below the top of item `position.item`.
pub fn scroll_to_offset(s: ListState, position: ListOffset) {
    let d = s.data
    d.top = position
    d.at_end = false
    d.owner.dirty = true
}

/// Scrolls the least distance that shows all of item `index` in the next frame.
pub fn scroll_to_reveal_item(s: ListState, index: i64) {
    let d = s.data
    d.reveal = index
    d.owner.dirty = true
}

fn unknown_heights(count: i64) -> []f32 {
    var out: []f32 = []
    for i in 0..count {
        out.push(-1.0)
    }
    out
}

fn estimate(d: *ListData) -> f32 {
    var total: f32 = 0.0
    var known = 0
    for h in d.heights {
        if h >= 0.0 {
            total += h
            known += 1
        }
    }
    if known == 0 || total <= 0.0 { 1.0 } else { total / f32(known) }
}

fn height_of(d: *ListData, index: i64, guess: f32) -> f32 {
    let h = d.heights[index]
    if h >= 0.0 { h } else { guess }
}

fn shift_top(d: *ListData, delta: f32) {
    let guess = estimate(d)
    var top = d.top
    top.offset += delta
    for top.item < d.count && top.offset >= height_of(d, top.item, guess) {
        top.offset -= height_of(d, top.item, guess)
        top.item += 1
    }
    for top.offset < 0.0 && top.item > 0 {
        top.item -= 1
        top.offset += height_of(d, top.item, guess)
    }
    if top.offset < 0.0 {
        top.offset = 0.0
    }
    d.top = top
}

fn listed_items(st: *State, mut t: layout.Tree, laid: Laid, key: str, ts: TextStyle, s: ListState, item: fn(i64) -> Element) -> []Laid {
    let d = s.data
    let view = layout.content(t, laid.node)
    if view.width != d.width {
        d.width = view.width
        d.heights = unknown_heights(d.count)
    }
    let wanted = (st.scroll[key] ?? geometry.Point {}).y
    if wanted != d.reported {
        shift_top(d, wanted - d.reported)
        d.at_end = false
    }
    let p = Pass { st, d, key, ts, item, view: view.height }
    if d.reveal >= 0 && d.reveal < d.count {
        p.reveal(mut t, d.reveal)
    }
    d.reveal = -1
    if d.at_end {
        d.top = p.ending_at(mut t, d.count - 1)
    }
    var shown = p.show(mut t)
    let filled = shown.len > 0 && bottom_of(shown) >= view.height
    let starts = d.top.item == 0 && d.top.offset <= 0.0
    if !filled && !starts {
        d.top = p.ending_at(mut t, d.count - 1)
        shown = p.show(mut t)
    }
    d.at_end = d.alignment == Bottom && (shown.len == 0 || bottom_of(shown) <= view.height + 0.5 && d.top.item + shown.len >= d.count)
    let guess = estimate(d)
    var before: f32 = 0.0
    for i in 0..d.top.item {
        before += height_of(d, i, guess)
    }
    var total = before
    for i in d.top.item..d.count {
        total += height_of(d, i, guess)
    }
    let reported = if total <= view.height { 0.0 } else { before + d.top.offset }
    let lift = if d.alignment == Bottom && total < view.height { view.height - total } else { 0.0 }
    d.reported = reported
    st.scroll[key] = geometry.point(0.0, reported)
    st.extents[key] = total
    var out: []Laid = []
    for sh in shown {
        let origin = geometry.point(view.x, view.y + reported + sh.y + lift)
        layout.compute_at(mut t, sh.laid.node, origin, geometry.size(view.width, sh.height))
        out.push(expand(st, mut t, sh.laid, sh.laid.element.id, ts))
    }
    out
}

fn bottom_of(shown: []Shown) -> f32 {
    let last = shown[shown.len - 1]
    last.y + last.height
}

fn show(p: Pass, mut t: layout.Tree) -> []Shown {
    let d = p.d
    var out: []Shown = []
    var y = -d.top.offset
    var i = d.top.item
    for i < d.count && y < p.view {
        var sh = p.build_item(mut t, i)
        sh.y = y
        y += sh.height
        if y > 0.0 || sh.height <= 0.0 {
            out.push(sh)
        } else {
            d.top = ListOffset { item: i + 1, offset: -y }
        }
        i += 1
    }
    out
}

fn build_item(p: Pass, mut t: layout.Tree, index: i64) -> Shown {
    var e = p.item(index)
    if e.id == "" {
        e.id = "{p.key}/{index}"
    }
    let laid = build(p.st, mut t, e, p.ts)
    layout.compute_at(mut t, laid.node, geometry.Point {}, geometry.size(p.d.width, layout.unbounded()))
    let height = layout.rect(t, laid.node).height
    p.d.heights[index] = height
    Shown { laid, y: 0.0, height }
}

fn measured(p: Pass, mut t: layout.Tree, index: i64) -> f32 {
    let known = p.d.heights[index]
    if known >= 0.0 { known } else { p.build_item(mut t, index).height }
}

fn ending_at(p: Pass, mut t: layout.Tree, last: i64) -> ListOffset {
    var sum: f32 = 0.0
    var i = last + 1
    for i > 0 && sum < p.view {
        i -= 1
        sum += p.measured(mut t, i)
    }
    ListOffset { item: i, offset: larger(sum - p.view, 0.0) }
}

fn reveal(p: Pass, mut t: layout.Tree, target: i64) {
    let d = p.d
    d.at_end = false
    if target < d.top.item || target == d.top.item && d.top.offset > 0.0 {
        d.top = ListOffset { item: target }
        return
    }
    var bottom = -d.top.offset
    for i in d.top.item..target + 1 {
        bottom += p.measured(mut t, i)
    }
    if bottom > p.view {
        d.top = p.ending_at(mut t, target)
    }
}

