import std/ui/platform
import strings = std/text

/// Why `bind` rejected a binding.
pub enum BindError {
    /// The keystrokes are empty, or one names an unknown modifier or no key.
    Keys(text: str)
    /// The context predicate does not parse.
    Predicate(text: str)
}

struct Keystroke {
    key: str
    control: bool = false
    alt: bool = false
    shift: bool = false
    super: bool = false
    typed: str = ""
}

struct Binding {
    keys: []Keystroke
    action: str
    when: Expr?
}

enum Expr {
    Name(name: str)
    Equal(key: str, value: str)
    NotEqual(key: str, value: str)
    Not(inner: *Expr)
    And(left: *Expr, right: *Expr)
    Or(left: *Expr, right: *Expr)
    Child(parent: *Expr, child: *Expr)
}

struct KeyContext {
    names: []str
    pairs: [str: str]
}

struct Parser {
    tokens: []str
    at: i64 = 0
    failed: bool = false
}

fn parse_keys(text: str) -> []Keystroke ! BindError {
    var out: []Keystroke = []
    for word in strings.fields(text) {
        let stroke = parse_keystroke(word) ?? fail Keys(text)
        out.push(stroke)
    }
    if out.len == 0 {
        fail Keys(text)
    }
    out
}

fn parse_keystroke(word: str) -> Keystroke? {
    let cut = strings.last_index_byte(word[..word.len - 1], '-')
    let key = strings.lower(word[cut + 1..])
    if key.len > 1 && strings.ends_with(key, "-") {
        return none
    }
    var stroke = Keystroke { key }
    if cut < 0 {
        return stroke
    }
    for part in strings.split(word[..cut], '-') {
        match strings.lower(part) {
            == "ctrl" => { stroke.control = true }
            == "alt" => { stroke.alt = true }
            == "shift" => { stroke.shift = true }
            == "super" => { stroke.super = true }
            == "cmd" => { stroke.super = true }
            == "win" => { stroke.super = true }
            _ => return none
        }
    }
    stroke
}

fn stroke_of(k: platform.KeyEvent) -> Keystroke {
    let m = k.modifiers
    let key = match k.key {
        Named(n) => named(n)
        Character(c) => if c == " " { "space" } else { strings.lower(c) }
    }
    let typed = match k.key {
        Character(c) => c
        Named(n) => ""
    }
    Keystroke { key, control: m.control, alt: m.alt, shift: m.shift, super: m.super, typed }
}

fn named(n: platform.NamedKey) -> str {
    match n {
        Enter => "enter"
        Escape => "escape"
        Tab => "tab"
        Backspace => "backspace"
        Delete => "delete"
        Left => "left"
        Right => "right"
        Up => "up"
        Down => "down"
        Home => "home"
        End => "end"
        PageUp => "pageup"
        PageDown => "pagedown"
        Function(number) => "f{number}"
    }
}

fn stroke_matches(want: Keystroke, got: Keystroke) -> bool {
    if want.control != got.control || want.alt != got.alt || want.super != got.super {
        return false
    }
    if want.key == got.key && want.shift == got.shift {
        return true
    }
    !want.shift && got.shift && want.key == got.typed
}

fn starts(keys: []Keystroke, typed: []Keystroke) -> bool {
    if keys.len < typed.len {
        return false
    }
    for i, s in typed {
        if !stroke_matches(keys[i], s) {
            return false
        }
    }
    true
}

fn show_stroke(s: Keystroke) -> str {
    var out = ""
    if s.control {
        out += "ctrl-"
    }
    if s.alt {
        out += "alt-"
    }
    if s.shift {
        out += "shift-"
    }
    if s.super {
        out += "super-"
    }
    "{out}{s.key}"
}

fn show_keys(keys: []Keystroke) -> str {
    var parts: []str = []
    for s in keys {
        parts.push(show_stroke(s))
    }
    strings.join(parts, " ")
}

fn parse_context(text: str) -> KeyContext {
    var names: []str = []
    var pairs: [str: str] = [:]
    for word in strings.fields(text) {
        let at = strings.index_byte(word, '=')
        if at > 0 {
            pairs[word[..at]] = word[at + 1..]
        } else {
            names.push(word)
        }
    }
    KeyContext { names, pairs }
}

fn parse_when(text: str) -> Expr? ! BindError {
    let tokens = tokenize(text)
    if tokens.len == 0 {
        return none
    }
    var p = Parser { tokens }
    let out = parse_child(mut p)
    if p.failed || p.at != p.tokens.len {
        fail Predicate(text)
    }
    out
}

fn tokenize(text: str) -> []str {
    var out: []str = []
    var i = 0
    for i < text.len {
        let c = text[i]
        let pair = if i + 1 < text.len { text[i..i + 2] } else { "" }
        if c == ' ' || c == '\t' {
            i += 1
        } else if pair == "&&" || pair == "||" || pair == "==" || pair == "!=" {
            out.push(pair)
            i += 2
        } else if !word_byte(c) {
            out.push(text[i..i + 1])
            i += 1
        } else {
            let start = i
            for i < text.len && word_byte(text[i]) {
                i += 1
            }
            out.push(text[start..i])
        }
    }
    out
}

fn word_byte(c: u8) -> bool {
    (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_' || c == '-' || c == '.'
}

fn is_word(t: str) -> bool {
    t != "" && word_byte(t[0])
}

fn peek(p: Parser) -> str {
    if p.at < p.tokens.len { p.tokens[p.at] } else { "" }
}

fn take(mut p: Parser) -> str {
    let t = peek(p)
    p.at += 1
    t
}

fn parse_child(mut p: Parser) -> Expr {
    var left = parse_or(mut p)
    for peek(p) == ">" {
        p.at += 1
        let right = parse_or(mut p)
        left = Child(new(left), new(right))
    }
    left
}

fn parse_or(mut p: Parser) -> Expr {
    var left = parse_and(mut p)
    for peek(p) == "||" {
        p.at += 1
        let right = parse_and(mut p)
        left = Or(new(left), new(right))
    }
    left
}

fn parse_and(mut p: Parser) -> Expr {
    var left = parse_compare(mut p)
    for peek(p) == "&&" {
        p.at += 1
        let right = parse_compare(mut p)
        left = And(new(left), new(right))
    }
    left
}

fn parse_compare(mut p: Parser) -> Expr {
    let t = take(mut p)
    if t == "!" {
        let inner = parse_compare(mut p)
        return Not(new(inner))
    }
    if t == "(" {
        let inner = parse_child(mut p)
        if take(mut p) != ")" {
            p.failed = true
        }
        return inner
    }
    if !is_word(t) {
        p.failed = true
        return Name("")
    }
    let op = peek(p)
    if op != "==" && op != "!=" {
        return Name(t)
    }
    p.at += 1
    let value = take(mut p)
    if !is_word(value) {
        p.failed = true
    }
    if op == "==" { Equal(t, value) } else { NotEqual(t, value) }
}

fn satisfies(e: Expr, stack: []KeyContext) -> bool {
    if stack.len == 0 {
        return false
    }
    let last = stack[stack.len - 1]
    match e {
        Name(name) => named_in(last, name)
        Equal(key, value) => match last.pairs[key] {
            some(v) => v == value
            none => false
        }
        NotEqual(key, value) => match last.pairs[key] {
            some(v) => v != value
            none => true
        }
        Not(inner) => !satisfies(*inner, stack)
        And(left, right) => satisfies(*left, stack) && satisfies(*right, stack)
        Or(left, right) => satisfies(*left, stack) || satisfies(*right, stack)
        Child(parent, child) => satisfies(*child, stack) && satisfied_above(*parent, stack)
    }
}

fn named_in(c: KeyContext, name: str) -> bool {
    for n in c.names {
        if n == name {
            return true
        }
    }
    false
}

fn satisfied_above(e: Expr, stack: []KeyContext) -> bool {
    for i in 1..stack.len {
        if satisfies(e, stack[..i]) {
            return true
        }
    }
    false
}

fn depth(b: Binding, stack: []KeyContext) -> i64 {
    let e = b.when ?? return 0
    var d = stack.len
    for d > 0 {
        if satisfies(e, stack[..d]) {
            return d
        }
        d -= 1
    }
    -1
}
