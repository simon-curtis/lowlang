import std/cancel

/// Work started by `background_task`, `after` or `every`, delivering to a context's green thread until it is cancelled.
///
/// A task is a handle: copies share it. Closing the context cancels every task it started.
pub struct Task {
    token: *cancel.Token
}

/// Runs `work` on a green thread of its own, which the scheduler may run on another OS thread, then runs `done` with its result on the context's green thread before the next frame.
///
/// `work` receives the task's token, to stop early with `cancel.check` or `cancel.pause` once the task is cancelled. A cancelled task never runs `done`.
pub fn background_task[T](cx: Context, work: fn(*cancel.Token) -> T, done: fn(T)) -> Task {
    let token = cancel.child(cx.state.tasks)
    spawn run_background(handle(cx), token, work, done)
    Task { token }
}

/// Runs `f` on the context's green thread once `ms` milliseconds have passed, unless the task is cancelled first.
pub fn after(cx: Context, ms: i64, f: fn()) -> Task {
    let token = cancel.child(cx.state.tasks)
    spawn run_after(handle(cx), token, ms, f)
    Task { token }
}

/// Runs `f` on the context's green thread every `ms` milliseconds until the task is cancelled.
pub fn every(cx: Context, ms: i64, f: fn()) -> Task {
    let token = cancel.child(cx.state.tasks)
    spawn run_every(handle(cx), token, ms, f)
    Task { token }
}

/// Stops `t`: its result or callback is no longer delivered, and its token is cancelled for its work to see.
pub fn cancel_task(t: Task) {
    cancel.cancel(t.token)
}

fn run_background[T](h: Handle, token: *cancel.Token, work: fn(*cancel.Token) -> T, done: fn(T)) {
    let result = work(token)
    deliver(h, token, fn() done(result), true)
}

fn run_after(h: Handle, token: *cancel.Token, ms: i64, f: fn()) {
    if cancel.pause(token, ms) {
        deliver(h, token, f, true)
    }
}

fn run_every(h: Handle, token: *cancel.Token, ms: i64, f: fn()) {
    for cancel.pause(token, ms) {
        deliver(h, token, f, false)
    }
}

fn deliver(h: Handle, token: *cancel.Token, f: fn(), last: bool) {
    if cancel.cancelled(token) {
        return
    }
    post(h, fn() {
        if cancel.cancelled(token) {
            return
        }
        f()
        if last {
            cancel.cancel(token)
        }
    })
}
