fn generic_families(kind: str) -> []str {
    match kind {
        "sans-serif" => ["segoe ui", "arial"]
        "serif" => ["times new roman", "cambria"]
        "monospace" => ["cascadia mono", "consolas", "courier new"]
        _ => []
    }
}

fn fallback_families() -> []str {
    ["segoe ui", "segoe ui symbol", "segoe ui emoji", "microsoft yahei", "yu gothic", "malgun gothic", "nirmala ui", "ebrima", "arial"]
}
