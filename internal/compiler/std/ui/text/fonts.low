import std/slices
import std/ui/font
import strings = std/text

/// The font text asks for: a family, a weight and a slant.
pub struct Typeface {
    /// A family name such as `Noto Sans`, matched without regard to case, or `sans-serif`, `serif` or `monospace` for the first of the system's usual families of that kind that it has. Empty asks for `sans-serif` when the system has fonts to choose from, else for the system's first font.
    pub family: str = ""
    /// The weight from 1 to 1000, with 400 regular and 700 bold.
    pub weight: i64 = 400
    /// Whether the text is italic.
    pub italic: bool = false
}

struct Candidate {
    font: i64 = -1
    face: i64 = -1
    score: i64 = 0
}

fn font_for(mut sys: System, t: Typeface) -> i64 {
    let key = "{strings.lower(t.family)}|{t.weight}|{t.italic}"
    match sys.chosen[key] {
        some(known) => return known
        none => {}
    }
    var picked = 0
    for family in families_for(sys, t.family) {
        let found = best_in(mut sys, family, t)
        if found >= 0 {
            picked = found
            break
        }
    }
    sys.chosen[key] = picked
    picked
}

fn families_for(sys: System, family: str) -> []str {
    let asked = strings.lower(family)
    if asked == "" {
        return if sys.faces.len == 0 { [] } else { generic_families("sans-serif") }
    }
    let generic = generic_families(asked)
    if generic.len > 0 {
        return generic
    }
    [asked]
}

fn best_in(mut sys: System, family: str, t: Typeface) -> i64 {
    var ranked: []Candidate = []
    for i in sys.explicit {
        let d = sys.described[i]
        if strings.lower(d.family) == family {
            ranked.push(Candidate { font: i, score: match_score(d, t) })
        }
    }
    for i, face in sys.faces {
        if strings.lower(face.description.family) == family {
            ranked.push(Candidate { face: i, score: match_score(face.description, t) })
        }
    }
    slices.sort_by_key(mut ranked, fn(c) c.score)
    for c in ranked {
        if c.face < 0 {
            return c.font
        }
        let at = load_face(mut sys, c.face)
        if at >= 0 {
            return at
        }
    }
    -1
}

fn match_score(d: font.Description, t: Typeface) -> i64 {
    let slant = if d.italic == t.italic { 0 } else { 10000 }
    1 + slant + weight_rank(t.weight, d.weight)
}

fn weight_rank(desired: i64, w: i64) -> i64 {
    if w == desired {
        return 0
    }
    if desired >= 400 && desired <= 500 {
        if w > desired && w <= 500 {
            return w - desired
        }
        if w < desired {
            return 1000 + desired - w
        }
        return 2000 + w - desired
    }
    if desired < 400 {
        if w < desired {
            return desired - w
        }
        return 1000 + w - desired
    }
    if w > desired {
        return w - desired
    }
    1000 + desired - w
}

fn load_face(mut sys: System, index: i64) -> i64 {
    let face = sys.faces[index]
    let key = "{face.path}#{face.index}"
    match sys.loaded[key] {
        some(known) => return known
        none => {}
    }
    let f = font.open_face(face) ?? {
        sys.loaded[key] = -1
        return -1
    }
    sys.fonts.push(f)
    sys.described.push(face.description)
    let at = sys.fonts.len - 1
    sys.loaded[key] = at
    at
}

fn shape(mut sys: System, primary: i64, c: u32) -> Shaped {
    let own = font.glyph_index(sys.fonts[primary], c)
    if own != 0 {
        return Shaped { font: primary, glyph: own }
    }
    let known = sys.covering[primary << 21 | i64(c)] ?? fallback_for(mut sys, primary, c)
    if known < 0 {
        return Shaped { font: primary, glyph: 0 }
    }
    Shaped { font: known, glyph: font.glyph_index(sys.fonts[known], c) }
}

fn fallback_for(mut sys: System, primary: i64, c: u32) -> i64 {
    var found = covering_font(sys, primary, c)
    if found < 0 {
        found = scan_faces(mut sys, c)
    }
    sys.covering[primary << 21 | i64(c)] = found
    found
}

fn covering_font(sys: System, primary: i64, c: u32) -> i64 {
    let style = sys.described[primary]
    let wanted = Typeface { weight: style.weight, italic: style.italic }
    var best = Candidate {}
    for i, f in sys.fonts {
        if font.glyph_index(f, c) != 0 {
            let score = match_score(sys.described[i], wanted)
            if best.score == 0 || score < best.score {
                best = Candidate { font: i, score }
            }
        }
    }
    best.font
}

fn scan_faces(mut sys: System, c: u32) -> i64 {
    match sys.scanned[i64(c)] {
        some(known) => return known
        none => {}
    }
    if sys.order.len == 0 && sys.faces.len > 0 {
        sys.order = fallback_order(sys.faces)
    }
    var found = -1
    var probed = 0
    for index in sys.order {
        let face = sys.faces[index]
        let key = "{face.path}#{face.index}"
        if sys.loaded[key] != none {
            continue
        }
        if probed == scan_limit() {
            break
        }
        probed += 1
        if font.maps(face, c) {
            let at = load_face(mut sys, index)
            if at >= 0 {
                found = at
                break
            }
        }
    }
    sys.scanned[i64(c)] = found
    found
}

fn scan_limit() -> i64 {
    256
}

fn fallback_order(faces: []font.Face) -> []i64 {
    var out: []i64 = []
    for family in fallback_families() {
        for i, face in faces {
            if is_plain(face) && strings.lower(face.description.family) == family {
                out.push(i)
            }
        }
    }
    for i, face in faces {
        if is_plain(face) && !slices.contains(fallback_families(), strings.lower(face.description.family)) {
            out.push(i)
        }
    }
    out
}

fn is_plain(face: font.Face) -> bool {
    !face.description.italic && face.description.weight == 400
}
