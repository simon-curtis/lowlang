fn generic_families(kind: str) -> []str {
    match kind {
        "sans-serif" => ["noto sans", "dejavu sans", "liberation sans", "adwaita sans", "cantarell", "ubuntu", "roboto"]
        "serif" => ["noto serif", "dejavu serif", "liberation serif"]
        "monospace" => ["noto sans mono", "dejavu sans mono", "liberation mono", "adwaita mono", "ubuntu mono"]
        _ => []
    }
}

fn fallback_families() -> []str {
    ["noto sans", "dejavu sans", "noto sans cjk sc", "noto sans cjk jp", "noto sans symbols", "noto sans symbols 2", "noto sans math", "noto emoji"]
}
