import std/image
import std/ui/font
import std/ui/geometry
import std/ui/scene
import std/slices
import strings = std/text

fn atlas_size() -> i64 {
    1024
}

/// A glyph placed on a line.
pub struct Placed {
    /// The index in `System`'s fonts of the font that draws the glyph.
    pub font: i64
    /// The glyph in that font.
    pub glyph: i64
    /// The pen position of the glyph from the left edge of its line, in layout pixels.
    pub x: f32
    /// The distance of the glyph's origin below the line's baseline in layout pixels, positive down like the layout's y. It is 0 except for a mark the font positions with an anchor.
    pub y: f32
    /// The glyph's advance in layout pixels. A mark the font positions with an anchor has an advance of 0 and a pen position `x` from its base's, so the glyph after it follows the base.
    pub advance: f32
    /// The byte offset in the laid-out text of the first code point the glyph draws.
    pub at: i64
    /// The byte offset just past the last code point the glyph draws. A ligature draws several code points, and every other glyph one.
    pub end: i64
}

/// One line of a layout.
pub struct Line {
    /// The glyphs in order, spaces included.
    pub glyphs: []Placed
    /// The distance from the top of the layout to the line's baseline, in layout pixels.
    pub y: f32
    /// The distance from the line's start to the end of its last glyph that is not a space, in layout pixels.
    pub width: f32
    /// The distance from the layout's left edge to the line's start, which the format's alignment sets.
    pub x: f32 = 0.0
}

/// Text broken into lines at one size, in layout pixels.
pub struct Layout {
    /// The lines from the top.
    pub lines: []Line
    /// The em size in pixels the text was laid out at.
    pub size: f32
    /// The width of the widest line.
    pub width: f32
    /// The height of all lines: the line height times the line count.
    pub height: f32
    /// The distance from the top of one line to the top of the next.
    pub line_height: f32 = 0.0
    /// The distance from the top of a line to its baseline.
    pub baseline: f32 = 0.0
    /// The index in `System`'s fonts of the font the format chose, whose metrics place the lines and their decorations.
    pub font: i64 = 0
    /// Whether lines were dropped or cut short to fit `max_lines` or the width.
    pub truncated: bool = false
}

/// How a line under or through text is drawn.
pub struct Decoration {
    /// The line's colour, else the colour of the text it marks.
    pub color: geometry.Color? = none
    /// The line's thickness in layout pixels, else when 0 the underline or strikethrough thickness of the font the layout chose.
    pub thickness: f32 = 0.0
    /// Whether the line is a wave rather than straight.
    pub wavy: bool = false
}

/// A style for the glyphs drawn from the bytes `start` up to `end` of the laid-out text. A field left `none` keeps what the glyph had.
pub struct Highlight {
    /// The byte offset of the first code point styled.
    pub start: i64 = 0
    /// The byte offset just past the last code point styled.
    pub end: i64 = 0
    /// The glyphs' colour.
    pub color: geometry.Color? = none
    /// A colour filled behind the glyphs.
    pub background: geometry.Color? = none
    /// A line under the glyphs.
    pub underline: Decoration? = none
    /// A line through the glyphs.
    pub strikethrough: Decoration? = none
}

struct Look {
    color: geometry.Color
    background: geometry.Color? = none
    underline: Decoration? = none
    strikethrough: Decoration? = none
}

struct Run {
    first: i64
    start: f32
    end: f32
    color: geometry.Color
}

struct Metrics {
    ascent: f32
    height: f32
    underline_top: f32
    underline_thickness: f32
    strikeout_top: f32
    strikeout_thickness: f32
}

struct Tile {
    visible: bool
    left: f32
    top: f32
    width: f32
    height: f32
    uv: geometry.Rect
}

struct Shelf {
    y: i64
    height: i64
    next: i64
}

struct Spot {
    x: i64
    y: i64
}

struct Shaped {
    font: i64
    glyph: i64
}

/// The fonts, the atlas and the caches that text, shape and image drawing keep between calls.
pub struct System {
    fonts: []font.Font
    described: []font.Description
    explicit: []i64
    faces: []font.Face = []
    loaded: [str: i64] = [:]
    chosen: [str: i64] = [:]
    covering: [i64: i64] = [:]
    order: []i64 = []
    scanned: [i64: i64] = [:]
    /// The atlas the sprites and pictures this module pushes sample, for the renderer to upload.
    pub atlas: scene.Atlas
    coverage: Packer = Packer {}
    colors: Packer = Packer {}
    tiles: [i64: Tile] = [:]
    shapes: [str: Tile] = [:]
    images: [str: Tile] = [:]
    layouts: [str: Layout] = [:]
}

struct Packer {
    shelves: []Shelf = []
    next_shelf: i64 = 0
    full: bool = false
}

/// Returns a system that draws with `fonts`, or with `font.fallback()` when `fonts` is empty, and an atlas whose planes are 1024 pixels square. A typeface chooses among `fonts` by family, weight and slant, an empty family chooses the first, and a code point the chosen font lacks is drawn by the first of `fonts` that has it.
pub fn system(fonts: []font.Font) -> System {
    system_with_atlas(fonts, atlas_size())
}

/// Returns a system that chooses among the fonts `faces` describes, loading each the first time it is chosen, with `font.fallback()` for text when none of them can be loaded. A code point the chosen font lacks is drawn by a font already loaded that has it, else by the first regular face that has it, trying the system's usual fallback families first.
pub fn system_of(faces: []font.Face) -> System {
    var sys = system([])
    sys.faces = faces
    sys
}

/// Adds `f` to the fonts typefaces choose among by family, weight and slant, ahead of the system's own, and returns its index in `Layout.font` and `Placed.font`.
pub fn add_font(mut sys: System, f: font.Font) -> i64 {
    sys.fonts.push(f)
    sys.described.push(font.describe(f))
    let at = sys.fonts.len - 1
    sys.explicit.push(at)
    sys.chosen = [:]
    sys.covering = [:]
    sys.layouts = [:]
    at
}

/// Returns a system with `font.fallback()` as its only font.
pub fn default_system() -> System {
    system([])
}

/// Returns a system like `system` whose atlas is `size` pixels square, so a test can fill it with a few glyphs.
pub fn system_with_atlas(fonts: []font.Font, size: i64) -> System {
    let chosen = if fonts.len == 0 { [font.fallback()] } else { fonts }
    var sys = System { fonts: chosen, described: chosen.map(fn(f) font.describe(f)), explicit: [], atlas: scene.atlas(size) }
    for i in 0..chosen.len {
        sys.explicit.push(i)
    }
    sys
}

/// Returns the number of layouts `wrap` holds for the current frame.
pub fn cached(sys: System) -> i64 {
    sys.layouts.len
}

/// Ends a frame: forgets the measured layouts, and clears each atlas plane that ran out of room during the frame, with every tile packed in it, so the next frame packs its own glyphs, shapes or images from the start.
pub fn end_frame(mut sys: System) {
    sys.layouts = [:]
    if sys.coverage.full {
        scene.clear(mut sys.atlas.coverage)
        sys.tiles = [:]
        sys.shapes = [:]
        sys.coverage = Packer {}
    }
    if sys.colors.full {
        scene.clear(mut sys.atlas.colors)
        sys.images = [:]
        sys.colors = Packer {}
    }
}

/// Returns `s` laid out with format `f` in lines no wider than `width` pixels, or in lines that end only where the text breaks them when `width` is infinite or `f` does not wrap.
///
/// The typeface chooses a font. Each code point is drawn by that font, or when it lacks the code point by a fallback, else by its glyph 0, and advances the pen by the glyph's advance plus the `kern` adjustment to the glyph before it when both come from one font. Consecutive code points drawn by one font, with no line break opportunity between them, are substituted by `font.substitute`, so a ligature is one glyph whose `at` and `end` span its code points; a mark that the font anchors to its base or to the mark before it has no advance and is placed by `Placed.x` and `Placed.y`. A line may break after a space; spaces at the end of a line hang past its width, and a word wider than `width` breaks between extended grapheme clusters. `\n`, `\r`, `\r\n`, vertical tab, form feed, U+0085, U+2028 and U+2029 end a line, and a layout always has at least one line.
///
/// With `max_lines` the lines past it are dropped. With an ellipsis, the last line kept after dropping, and without wrapping each line wider than `width`, loses its glyphs from the first that does not fit beside the ellipsis, and its trailing spaces, and ends with the ellipsis. Each line is then placed by `align` within `width`, or within the widest line when `width` is infinite.
///
/// The result is kept until `end_frame`, so laying out the same `s`, format and width again returns it.
pub fn wrap(mut sys: System, s: str, f: Format, width: f32) -> Layout {
    let family = f.typeface.family
    let ellipsis = f.ellipsis ?? ""
    let key = "{f.size}|{width}|{family.len}:{family}|{f.typeface.weight}|{f.typeface.italic}|{f.line_height ?? -1.0}|{f.align}|{f.wrap}|{f.max_lines}|{ellipsis.len}:{ellipsis}|{f.ellipsis != none}|{s.len}:{s}"
    match sys.layouts[key] {
        some(cached_layout) => return cached_layout
        none => {}
    }
    let built = lay_out(mut sys, s, f, width)
    sys.layouts[key] = built
    built
}

/// Returns the size of `s` laid out by `wrap`.
pub fn measure(mut sys: System, s: str, f: Format, width: f32) -> geometry.Size {
    let l = wrap(mut sys, s, f, width)
    geometry.size(l.width, l.height)
}

/// Pushes the glyphs of `l` onto `sc` tinted `color`, with the layout's top left at `origin` and everything multiplied by `scale`, styled by `highlights`.
///
/// Each glyph takes, field by field, the last highlight that covers its code point and sets that field. Backgrounds go first, as one quad per run of glyphs on a line with the same background, from the first glyph's pen position to the last one's advance and from the top of the line to its bottom. One sprite per visible glyph follows, then the underlines and strikethroughs, one per run of glyphs with the same decoration. Runs stop at the line's width, so spaces hanging past it are not marked.
///
/// Glyphs are rasterised at `l.size * scale` pixels, rounded to 1/64 pixel, the first time they are drawn, and packed into the atlas with a one-pixel empty border. Each glyph's pen position and each run's ends are rounded to whole device pixels. A glyph that does not fit in the atlas is left out, and so is every glyph packed after it until `end_frame`.
pub fn paint(mut sys: System, mut sc: scene.Scene, l: Layout, origin: geometry.Point, color: geometry.Color, highlights: []Highlight, scale: f32) {
    let looks = l.lines.map(fn(line) line.glyphs.map(fn(g) look_at(g.at, color, highlights)))
    let m = metrics(sys.fonts[l.font], l.size)
    for i, line in l.lines {
        let start = geometry.point(origin.x + line.x, origin.y)
        for r in runs(line, looks[i], fn(a, b) a.background == b.background) {
            match looks[i][r.first].background {
                some(fill) => {
                    let top = snap((origin.y + line.y - l.baseline) * scale)
                    let bottom = snap((origin.y + line.y - l.baseline + l.line_height) * scale)
                    push_span(mut sc, r, start, scale, top, bottom - top, fill)
                }
                none => {}
            }
        }
    }
    let pixel_size = l.size * scale
    for i, line in l.lines {
        for j, g in line.glyphs {
            let tile = glyph_tile(mut sys, g, pixel_size) ?? continue
            if tile.visible {
                let x = snap((origin.x + line.x + g.x) * scale)
                let baseline = snap((origin.y + line.y + g.y) * scale)
                let bounds = geometry.rect(x + tile.left, baseline + tile.top, tile.width, tile.height)
                scene.push_sprite(mut sc, scene.Sprite { bounds, color: looks[i][j].color, tile: tile.uv })
            }
        }
    }
    for i, line in l.lines {
        let start = geometry.point(origin.x + line.x, origin.y)
        let baseline = (origin.y + line.y) * scale
        for r in runs(line, looks[i], fn(a, b) a.underline == b.underline) {
            match looks[i][r.first].underline {
                some(d) => decorate(mut sys, mut sc, r, start, scale, baseline - m.underline_top * scale, d, m.underline_thickness)
                none => {}
            }
        }
        for r in runs(line, looks[i], fn(a, b) a.strikethrough == b.strikethrough) {
            match looks[i][r.first].strikethrough {
                some(d) => decorate(mut sys, mut sc, r, start, scale, baseline - m.strikeout_top * scale, d, m.strikeout_thickness)
                none => {}
            }
        }
    }
}

fn metrics(f: font.Font, size: f32) -> Metrics {
    let k = font.scale(f, size)
    Metrics {
        ascent: f32(f.ascent) * k
        height: f32(f.ascent - f.descent + f.line_gap) * k
        underline_top: f32(f.underline_position) * k
        underline_thickness: f32(f.underline_thickness) * k
        strikeout_top: f32(f.strikeout_position) * k
        strikeout_thickness: f32(f.strikeout_size) * k
    }
}

fn look_at(at: i64, color: geometry.Color, highlights: []Highlight) -> Look {
    var out = Look { color }
    for h in highlights {
        if at >= h.start && at < h.end {
            out.color = h.color ?? out.color
            out.background = h.background ?? out.background
            out.underline = h.underline ?? out.underline
            out.strikethrough = h.strikethrough ?? out.strikethrough
        }
    }
    out
}

fn runs(line: Line, looks: []Look, same: fn(Look, Look) -> bool) -> []Run {
    var out: []Run = []
    var first = 0
    var reach: f32 = 0.0
    for j, g in line.glyphs {
        if g.x + g.advance > reach {
            reach = g.x + g.advance
        }
        let next = j + 1
        if next == line.glyphs.len || !same(looks[first], looks[next]) {
            let end = if reach < line.width { reach } else { line.width }
            let start = line.glyphs[first].x
            if end > start {
                out.push(Run { first, start, end, color: looks[first].color })
            }
            first = next
            reach = 0.0
        }
    }
    out
}

fn push_span(mut sc: scene.Scene, r: Run, origin: geometry.Point, scale: f32, top: f32, height: f32, color: geometry.Color) {
    let left = snap((origin.x + r.start) * scale)
    let right = snap((origin.x + r.end) * scale)
    if right > left && height > 0.0 {
        scene.push_quad(mut sc, scene.Quad { bounds: geometry.rect(left, top, right - left, height), background: color })
    }
}

fn decorate(mut sys: System, mut sc: scene.Scene, r: Run, origin: geometry.Point, scale: f32, top: f32, d: Decoration, fallback: f32) {
    let color = d.color ?? r.color
    let logical = if d.thickness > 0.0 { d.thickness } else { fallback }
    let thickness = if logical * scale > 1.0 { snap(logical * scale) } else { 1.0 }
    if !d.wavy {
        push_span(mut sc, r, origin, scale, snap(top), thickness, color)
        return
    }
    let left = snap((origin.x + r.start) * scale)
    let right = snap((origin.x + r.end) * scale)
    let wave = geometry.wave(geometry.point(left, top), right - left, thickness)
    let polygons = geometry.stroke(wave, thickness, 1.0)
    paint_polygons(mut sys, mut sc, polygons, NonZero, color)
}

/// Pushes a sprite onto `sc` covering `polygons`, in device pixels and filled by `rule`, tinted `color`.
///
/// The coverage is rasterised the first time a shape is drawn at its offset within a pixel, and packed into the atlas like a glyph, so a shape moved by whole pixels is drawn from the same tile.
pub fn paint_polygons(mut sys: System, mut sc: scene.Scene, polygons: [][]geometry.Point, rule: geometry.FillRule, color: geometry.Color) {
    if polygons.len == 0 || polygons[0].len == 0 {
        return
    }
    let origin = geometry.point(floor(polygons[0][0].x), floor(polygons[0][0].y))
    var parts: []str = [rule_key(rule)]
    var local: [][]geometry.Point = []
    for poly in polygons {
        var moved: []geometry.Point = []
        for p in poly {
            let q = geometry.point(p.x - origin.x, p.y - origin.y)
            moved.push(q)
            parts.push("{i64(q.x * 64.0)},{i64(q.y * 64.0)}")
        }
        local.push(moved)
        parts.push(";")
    }
    let key = strings.join(parts, " ")
    let tile = shape_tile(mut sys, key, local, rule) ?? return
    if tile.visible {
        let bounds = geometry.rect(origin.x + tile.left, origin.y + tile.top, tile.width, tile.height)
        scene.push_sprite(mut sc, scene.Sprite { bounds, color, tile: tile.uv })
    }
}

fn rule_key(rule: geometry.FillRule) -> str {
    match rule {
        NonZero => "n"
        EvenOdd => "e"
    }
}

fn shape_tile(mut sys: System, key: str, polygons: [][]geometry.Point, rule: geometry.FillRule) -> Tile? {
    match sys.shapes[key] {
        some(known) => return known
        none => {}
    }
    if sys.coverage.full {
        return none
    }
    let bitmap = font.fill(polygons, rule)
    let tile = pack(mut sys, bitmap) ?? return none
    sys.shapes[key] = tile
    tile
}

/// Pushes `p` onto `sc` showing the `source` rectangle of `img`, in image pixels, resampled to `p.bounds` snapped to whole device pixels.
///
/// The resampled pixels are packed into the atlas's colour plane, with a one-pixel empty border, the first time `key` is drawn with that source and size, so `key` must name one image's pixels. An image too large for the plane is left out, and so is every image that does not fit until `end_frame` clears the plane.
pub fn paint_image(mut sys: System, mut sc: scene.Scene, key: str, img: image.Image, source: geometry.Rect, p: scene.Picture) {
    let left = snap(p.bounds.x)
    let top = snap(p.bounds.y)
    let width = i64(snap(p.bounds.x + p.bounds.width) - left)
    let height = i64(snap(p.bounds.y + p.bounds.height) - top)
    let x = clamp_i(i64(floor(source.x)), 0, img.width)
    let y = clamp_i(i64(floor(source.y)), 0, img.height)
    let crop_width = clamp_i(i64(snap(source.x + source.width)), x, img.width) - x
    let crop_height = clamp_i(i64(snap(source.y + source.height)), y, img.height) - y
    if width <= 0 || height <= 0 || crop_width <= 0 || crop_height <= 0 || width + 2 > sys.atlas.size || height + 2 > sys.atlas.size {
        return
    }
    let name = "{key} {x} {y} {crop_width} {crop_height} {width} {height}"
    let uv = match sys.images[name] {
        some(known) => known.uv
        none => {
            if sys.colors.full {
                return
            }
            let spot = sys.colors.reserve(sys.atlas.size, width + 2, height + 2) ?? return
            let cropped = if x == 0 && y == 0 && crop_width == img.width && crop_height == img.height { img } else { image.crop(img, x, y, crop_width, crop_height) }
            let rgba = image.convert(cropped, Rgba8)
            let sized = image.resize(rgba, width, height, Bilinear)
            scene.write_colors(mut sys.atlas, spot.x + 1, spot.y + 1, width, height, packed_rows(sized))
            let fresh = scene.tile(sys.atlas, spot.x + 1, spot.y + 1, width, height)
            sys.images[name] = Tile { visible: true, left: 0.0, top: 0.0, width: f32(width), height: f32(height), uv: fresh }
            fresh
        }
    }
    var out = p
    out.bounds = geometry.rect(left, top, f32(width), f32(height))
    out.tile = uv
    scene.push_picture(mut sc, out)
}

fn packed_rows(img: image.Image) -> []u8 {
    let row = img.width * 4
    if img.stride == row {
        return img.pixels
    }
    var out: []u8 = __make(row * img.height)
    for y in 0..img.height {
        for i in 0..row {
            out[y * row + i] = img.pixels[y * img.stride + i]
        }
    }
    out
}

fn clamp_i(v: i64, lo: i64, hi: i64) -> i64 {
    if v < lo {
        lo
    } else if v > hi {
        hi
    } else {
        v
    }
}

fn pack(mut sys: System, bitmap: font.Bitmap) -> Tile? {
    if bitmap.width == 0 {
        return Tile { visible: false, left: 0.0, top: 0.0, width: 0.0, height: 0.0, uv: geometry.Rect {} }
    }
    let spot = sys.coverage.reserve(sys.atlas.size, bitmap.width + 2, bitmap.height + 2) ?? return none
    scene.write(mut sys.atlas, spot.x + 1, spot.y + 1, bitmap.width, bitmap.height, bitmap.coverage)
    let uv = scene.tile(sys.atlas, spot.x + 1, spot.y + 1, bitmap.width, bitmap.height)
    Tile { visible: true, left: f32(bitmap.left), top: f32(bitmap.top), width: f32(bitmap.width), height: f32(bitmap.height), uv }
}

fn snap(v: f32) -> f32 {
    floor(v + 0.5)
}

fn tile_key(g: Placed, size_64: i64) -> i64 {
    g.font << 40 | g.glyph << 24 | size_64
}

fn glyph_tile(mut sys: System, g: Placed, pixel_size: f32) -> Tile? {
    let size_64 = i64(pixel_size * 64.0 + 0.5)
    let key = tile_key(g, size_64)
    match sys.tiles[key] {
        some(known) => return known
        none => {}
    }
    if sys.coverage.full {
        return none
    }
    let bitmap = font.rasterize(sys.fonts[g.font], g.glyph, f32(size_64) / 64.0)
    let tile = pack(mut sys, bitmap) ?? return none
    sys.tiles[key] = tile
    tile
}

fn reserve(mut p: Packer, size: i64, width: i64, height: i64) -> Spot? {
    var best = -1
    for i, shelf in p.shelves {
        if shelf.height >= height && size - shelf.next >= width && (best < 0 || shelf.height < p.shelves[best].height) {
            best = i
        }
    }
    if best >= 0 {
        let x = p.shelves[best].next
        p.shelves[best].next += width
        return Spot { x, y: p.shelves[best].y }
    }
    if width > size || p.next_shelf + height > size {
        p.full = true
        return none
    }
    let y = p.next_shelf
    p.shelves.push(Shelf { y, height, next: width })
    p.next_shelf += height
    Spot { x: 0, y }
}
