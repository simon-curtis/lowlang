struct CachedView {
    node: *Node
    build: fn() -> Element
    element: Element? = none
    used: bool = false
}

/// Returns an element that stands for what `build` returns, built again only when a signal or memo it read during its last build has changed, or the focus, pending keys, drag, a scroll offset, or the window's status or decorations have.
///
/// `key` names the view across frames, and a view that a frame does not lay out is dropped. `build` reads the state it depends on through signals, memos and the context; a captured value that changes without them leaves the view as it was. The element's builders belong inside `build`, because the element returned here is replaced by the view's.
pub fn cached(cx: Context, key: str, build: fn() -> Element) -> Element {
    let st = cx.state
    let v = st.views[key] ?? add_view(st, key, build)
    v.build = build
    Element { kind: Cached(key) }
}

fn add_view(st: *State, key: str, build: fn() -> Element) -> *CachedView {
    let v = new(CachedView { node: new(Node { state: Dirty }), build })
    v.node.rerun = fn() -> bool {
        let built = v.build()
        v.element = built
        true
    }
    st.views[key] = v
    v
}

fn resolve_view(st: *State, key: str) -> Element {
    let v = st.views[key] ?? return Element {}
    v.used = true
    refresh(st, v.node)
    v.element ?? Element {}
}

fn drop_unused_views(st: *State) {
    var kept: [str: *CachedView] = [:]
    for key, v in st.views {
        if v.used {
            v.used = false
            kept[key] = v
        } else {
            v.node.disposed = true
        }
    }
    st.views = kept
}

fn read_ambient(st: *State) {
    track(st, st.ambient, false)
}

fn touch_ambient(st: *State) {
    notify(st, st.ambient)
}
