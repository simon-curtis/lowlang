import std/ui/scene

struct Attachment {
    view: VkImageView
    width: i64
    height: i64
}

struct Bound {
    quads: ptr[VkDescriptorSet]
    shadows: ptr[VkDescriptorSet]
    sprites: ptr[VkDescriptorSet]
}

fn quad_bytes() -> i64 {
    96
}

fn shadow_bytes() -> i64 {
    80
}

fn sprite_bytes() -> i64 {
    64
}

fn write_instances(s: *State, f: *Frame, sc: scene.Scene) ! Error {
    fill(s.device, f, slot(Quads), sc.quads, quad_bytes())?
    fill(s.device, f, slot(Shadows), sc.shadows, shadow_bytes())?
    fill(s.device, f, slot(Sprites), sc.sprites, sprite_bytes())?
}

fn fill[T](d: Device, f: *Frame, index: i64, items: []T, stride: i64) ! Error {
    let needed = items.len * stride
    let grown = ensure_buffer(d, mut f.instances[index], needed, VK_BUFFER_USAGE_STORAGE_BUFFER_BIT())?
    if grown {
        write_instances_binding(d, f.sets[index], f.instances[index])
    }
    if items.len == 0 {
        return
    }
    let at: ptr[T] = f.instances[index].mapped
    let dst = view(at, items.len)
    __memmove(dst, items)
}

fn record_pass(mut pins: Pins, cmd: VkCommandBuffer, s: *State, f: *Frame, p: Pipelines, a: Attachment, sc: scene.Scene) {
    let background = sc.background
    let color = VkClearColorValue { float32_0: background.r, float32_1: background.g, float32_2: background.b, float32_3: background.a }
    let clear = VkClearValue { color }
    let attachment = VkRenderingAttachmentInfo {
        imageView: a.view
        imageLayout: VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL()
        loadOp: VK_ATTACHMENT_LOAD_OP_CLEAR()
        storeOp: VK_ATTACHMENT_STORE_OP_STORE()
        clearValue: clear
    }
    let attachments = pins.hold(attachment)
    let extent = VkExtent2D { width: u32(a.width), height: u32(a.height) }
    let area = VkRect2D { extent }
    var rendering = VkRenderingInfo { renderArea: area, layerCount: 1, colorAttachmentCount: 1, pColorAttachments: attachments }
    vkCmdBeginRendering(cmd, mut rendering)

    let viewport = VkViewport { width: f32(a.width), height: f32(a.height), maxDepth: 1.0 }
    let viewports = pins.hold(viewport)
    vkCmdSetViewport(cmd, 0, 1, viewports)
    let scissors = pins.hold(area)
    vkCmdSetScissor(cmd, 0, 1, scissors)
    let size = TargetSize { width: f32(a.width), height: f32(a.height) }
    let constants = pins.hold(size)
    vkCmdPushConstants(cmd, s.pipeline_layout, both_stages(), 0, 8, constants)

    let quad_set = f.sets[slot(Quads)]
    let shadow_set = f.sets[slot(Shadows)]
    let sprite_set = f.sets[slot(Sprites)]
    let quads = pins.hold(quad_set)
    let shadows = pins.hold(shadow_set)
    let sprites = pins.hold(sprite_set)
    let bound = Bound { quads, shadows, sprites }
    for b in scene.batches(sc) {
        draw_batch(cmd, s, p, bound, b)
    }
    vkCmdEndRendering(cmd)
}

fn draw_batch(cmd: VkCommandBuffer, s: *State, p: Pipelines, bound: Bound, b: scene.Batch) {
    let pipeline = match b.kind {
        Quads => p.quad
        Shadows => p.shadow
        Sprites => p.sprite
    }
    let set = match b.kind {
        Quads => bound.quads
        Shadows => bound.shadows
        Sprites => bound.sprites
    }
    vkCmdBindPipeline(cmd, VK_PIPELINE_BIND_POINT_GRAPHICS(), pipeline)
    vkCmdBindDescriptorSets(cmd, VK_PIPELINE_BIND_POINT_GRAPHICS(), s.pipeline_layout, 0, 1, set, 0, null)
    vkCmdDraw(cmd, 6, u32(b.count), 0, u32(b.first))
}
