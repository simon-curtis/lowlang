struct Device {
    instance: VkInstance = VkInstance {}
    physical: VkPhysicalDevice = VkPhysicalDevice {}
    handle: VkDevice = VkDevice {}
    queue: VkQueue = VkQueue {}
    family: u32 = 0
    memory_types: []VkMemoryType = []
}

struct Chosen {
    physical: VkPhysicalDevice
    family: u32
}

fn create_instance(mut pins: Pins, extensions: []str) -> VkInstance ! Error {
    let version = vk_make_api_version(0, 1, 3, 0)
    let app_info = VkApplicationInfo { apiVersion: version }
    let app = pins.hold(app_info)
    let names = pins.hold_names(extensions)
    var info = VkInstanceCreateInfo { pApplicationInfo: app, enabledExtensionCount: u32(extensions.len), ppEnabledExtensionNames: names }
    var instance = VkInstance {}
    check(vkCreateInstance(mut info, null, mut instance), "vkCreateInstance")?
    instance
}

fn choose_device(instance: VkInstance, extensions: []str, surface: VkSurfaceKHR) -> Chosen ! Error {
    let physicals = list_devices(instance)?
    for physical in physicals {
        if !has_features(physical) {
            continue
        }
        let family = graphics_family(physical, surface)? ?? continue
        if !has_extensions(physical, extensions)? {
            continue
        }
        return Chosen { physical, family }
    }
    fail NoDevice
}

fn list_devices(instance: VkInstance) -> []VkPhysicalDevice ! Error {
    var count: u32 = 0
    check(vkEnumeratePhysicalDevices(instance, mut count, null), "vkEnumeratePhysicalDevices")?
    let devices: []VkPhysicalDevice = __make(count)
    using var pins = new_pins()
    let data = pins.hold_all(devices)
    check(vkEnumeratePhysicalDevices(instance, mut count, data), "vkEnumeratePhysicalDevices")?
    devices[..count]
}

fn has_features(physical: VkPhysicalDevice) -> bool {
    var props = VkPhysicalDeviceProperties {}
    vkGetPhysicalDeviceProperties(physical, mut props)
    if props.apiVersion < vk_make_api_version(0, 1, 3, 0) {
        return false
    }
    using var pins = new_pins()
    let features13 = pins.hold(VkPhysicalDeviceVulkan13Features {})
    var features = VkPhysicalDeviceFeatures2 { pNext: features13 }
    vkGetPhysicalDeviceFeatures2(physical, mut features)
    let found = load(features13)
    found.dynamicRendering != 0 && found.synchronization2 != 0
}

fn graphics_family(physical: VkPhysicalDevice, surface: VkSurfaceKHR) -> u32? ! Error {
    var count: u32 = 0
    vkGetPhysicalDeviceQueueFamilyProperties(physical, mut count, null)
    let families: []VkQueueFamilyProperties = __make(count)
    using var pins = new_pins()
    let data = pins.hold_all(families)
    vkGetPhysicalDeviceQueueFamilyProperties(physical, mut count, data)
    for i, family in families[..count] {
        if family.queueFlags & VK_QUEUE_GRAPHICS_BIT == 0 {
            continue
        }
        if surface.handle != 0 && !can_present(physical, u32(i), surface)? {
            continue
        }
        return u32(i)
    }
    none
}

fn can_present(physical: VkPhysicalDevice, family: u32, surface: VkSurfaceKHR) -> bool ! Error {
    var supported: u32 = 0
    check(vkGetPhysicalDeviceSurfaceSupportKHR(physical, family, surface, mut supported), "vkGetPhysicalDeviceSurfaceSupportKHR")?
    supported != 0
}

fn has_extensions(physical: VkPhysicalDevice, wanted: []str) -> bool ! Error {
    if wanted.len == 0 {
        return true
    }
    var count: u32 = 0
    check(vkEnumerateDeviceExtensionProperties(physical, null, mut count, null), "vkEnumerateDeviceExtensionProperties")?
    let found: []VkExtensionProperties = __make(count)
    using var pins = new_pins()
    let data = pins.hold_all(found)
    check(vkEnumerateDeviceExtensionProperties(physical, null, mut count, data), "vkEnumerateDeviceExtensionProperties")?
    for name in wanted {
        var present = false
        for extension in found[..count] {
            if VkExtensionProperties_extensionName(extension) == name {
                present = true
            }
        }
        if !present {
            return false
        }
    }
    true
}

fn create_device(chosen: Chosen, extensions: []str) -> VkDevice ! Error {
    using var pins = new_pins()
    let weights: []f32 = [1.0]
    let priorities = pins.hold_all(weights)
    let queue_info = VkDeviceQueueCreateInfo { queueFamilyIndex: chosen.family, queueCount: 1, pQueuePriorities: priorities }
    let queues = pins.hold(queue_info)
    let wanted = VkPhysicalDeviceVulkan13Features { synchronization2: 1, dynamicRendering: 1 }
    let features = pins.hold(wanted)
    let names = pins.hold_names(extensions)
    var info = VkDeviceCreateInfo {
        pNext: features
        queueCreateInfoCount: 1
        pQueueCreateInfos: queues
        enabledExtensionCount: u32(extensions.len)
        ppEnabledExtensionNames: names
    }
    var device = VkDevice {}
    check(vkCreateDevice(chosen.physical, mut info, null, mut device), "vkCreateDevice")?
    device
}

fn memory_types(physical: VkPhysicalDevice) -> []VkMemoryType {
    var props = VkPhysicalDeviceMemoryProperties {}
    vkGetPhysicalDeviceMemoryProperties(physical, mut props)
    let all = VkPhysicalDeviceMemoryProperties_memoryTypes(props)
    all[..props.memoryTypeCount]
}
