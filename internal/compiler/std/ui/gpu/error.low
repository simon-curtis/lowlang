/// The ways opening a GPU, drawing or reading back can fail.
pub enum Error {
    /// No Vulkan 1.3 device offers dynamic rendering, synchronization2 and a graphics queue, and when a surface is given, the swapchain extension and a graphics queue that can present to it.
    NoDevice
    /// A Vulkan call returned a failing result. `call` names the function and `result` is its `VkResult`.
    Vulkan(call: str, result: i32)
    /// No memory type of the device has the property flags a resource needs. `allowed` is the bit set of types the resource accepts and `flags` the property flags wanted.
    NoMemoryType(allowed: u32, flags: u32)
    /// A target was asked for with a width or height below one pixel.
    InvalidSize(width: i64, height: i64)
    /// `present` was called on a `Gpu` that `open` made, which has no window surface.
    NoSurface
}

/// Returns a one-line description of `e`, naming the Vulkan call and result when there is one.
pub fn describe(e: Error) -> str {
    match e {
        NoDevice => "no Vulkan 1.3 device with dynamic rendering, synchronization2 and a graphics queue"
        Vulkan(call, result) => "{call} failed with {result_name(result)} ({result})"
        NoMemoryType(allowed, flags) => "no memory type in {allowed:x} has the properties {flags:x}"
        InvalidSize(width, height) => "a target of {width} by {height} pixels is empty"
        NoSurface => "the Gpu was opened without a window surface, so it cannot present"
    }
}

fn result_name(result: i32) -> str {
    match result {
        == VK_TIMEOUT() => "VK_TIMEOUT"
        == VK_ERROR_OUT_OF_HOST_MEMORY() => "VK_ERROR_OUT_OF_HOST_MEMORY"
        == VK_ERROR_OUT_OF_DEVICE_MEMORY() => "VK_ERROR_OUT_OF_DEVICE_MEMORY"
        == VK_ERROR_INITIALIZATION_FAILED() => "VK_ERROR_INITIALIZATION_FAILED"
        == VK_ERROR_DEVICE_LOST() => "VK_ERROR_DEVICE_LOST"
        == VK_ERROR_MEMORY_MAP_FAILED() => "VK_ERROR_MEMORY_MAP_FAILED"
        == VK_ERROR_LAYER_NOT_PRESENT() => "VK_ERROR_LAYER_NOT_PRESENT"
        == VK_ERROR_EXTENSION_NOT_PRESENT() => "VK_ERROR_EXTENSION_NOT_PRESENT"
        == VK_ERROR_FEATURE_NOT_PRESENT() => "VK_ERROR_FEATURE_NOT_PRESENT"
        == VK_ERROR_INCOMPATIBLE_DRIVER() => "VK_ERROR_INCOMPATIBLE_DRIVER"
        == VK_ERROR_TOO_MANY_OBJECTS() => "VK_ERROR_TOO_MANY_OBJECTS"
        == VK_ERROR_FORMAT_NOT_SUPPORTED() => "VK_ERROR_FORMAT_NOT_SUPPORTED"
        == VK_ERROR_FRAGMENTED_POOL() => "VK_ERROR_FRAGMENTED_POOL"
        == VK_ERROR_OUT_OF_POOL_MEMORY() => "VK_ERROR_OUT_OF_POOL_MEMORY"
        == VK_ERROR_SURFACE_LOST_KHR() => "VK_ERROR_SURFACE_LOST_KHR"
        == VK_ERROR_OUT_OF_DATE_KHR() => "VK_ERROR_OUT_OF_DATE_KHR"
        _ => "an unnamed VkResult"
    }
}

fn check(result: i32, call: str) ! Error {
    if result != VK_SUCCESS() {
        fail Vulkan(call, result)
    }
}
