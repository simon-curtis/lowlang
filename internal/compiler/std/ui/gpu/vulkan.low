fn vk_make_api_version(variant: u32, major: u32, minor: u32, patch: u32) -> u32 {
    (variant << 29) | (major << 22) | (minor << 12) | patch
}

fn vk_string(bytes: []u8) -> str {
    var n = 0
    for n < bytes.len && bytes[n] != 0 {
        n += 1
    }
    str(bytes[0..n])
}

