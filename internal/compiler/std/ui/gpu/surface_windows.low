const surface_extension = "VK_KHR_win32_surface"

fn create_surface(instance: VkInstance, s: Surface) -> VkSurfaceKHR ! Error {
    var info = VkWin32SurfaceCreateInfoKHR { hinstance: s.display, hwnd: s.window }
    var surface = VkSurfaceKHR {}
    check(vkCreateWin32SurfaceKHR(instance, mut info, null, mut surface), "vkCreateWin32SurfaceKHR")?
    surface
}
