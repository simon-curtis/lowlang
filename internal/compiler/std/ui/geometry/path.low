/// A shape of contours made of lines and Bézier curves, in logical pixels.
pub struct Path {
    segments: []Segment = []
}

/// One step of a `Path`, in the order it was added.
pub enum Segment {
    /// Starts a new contour at `to`.
    Move(to: Point)
    /// A straight line to `to`.
    Line(to: Point)
    /// A quadratic Bézier curve to `to` pulled toward `control`.
    Quadratic(control: Point, to: Point)
    /// A cubic Bézier curve to `to` with the control points `first` and `second`.
    Cubic(first: Point, second: Point, to: Point)
    /// A line back to the start of the current contour, which ends there.
    Close
}

struct Polyline {
    points: []Point
    closed: bool
}

fn tolerance() -> f32 {
    0.05
}

/// Returns an empty path.
pub fn path() -> Path {
    Path {}
}

/// Starts a new contour at `to`.
pub fn move_to(mut p: Path, to: Point) {
    p.segments.push(Move(to))
}

/// Adds a straight line from the current point to `to`.
pub fn line_to(mut p: Path, to: Point) {
    p.segments.push(Line(to))
}

/// Adds a quadratic Bézier curve from the current point to `to` pulled toward `control`.
pub fn quadratic_to(mut p: Path, control: Point, to: Point) {
    p.segments.push(Quadratic(control, to))
}

/// Adds a cubic Bézier curve from the current point to `to` with the control points `first` and `second`.
pub fn cubic_to(mut p: Path, first: Point, second: Point, to: Point) {
    p.segments.push(Cubic(first, second, to))
}

/// Closes the current contour with a line back to its start.
pub fn close(mut p: Path) {
    p.segments.push(Close)
}

/// Returns the steps of `p` in the order they were added.
pub fn segments(p: Path) -> []Segment {
    p.segments
}

/// Returns `p` with every point `(x, y)` moved to `(a * x + c * y + e, b * x + d * y + f)`.
pub fn affine(p: Path, a: f32, b: f32, c: f32, d: f32, e: f32, f: f32) -> Path {
    var out = path()
    for s in p.segments {
        match s {
            Move(to) => out.segments.push(Move(mapped(to, a, b, c, d, e, f)))
            Line(to) => out.segments.push(Line(mapped(to, a, b, c, d, e, f)))
            Quadratic(control, to) => out.segments.push(Quadratic(mapped(control, a, b, c, d, e, f), mapped(to, a, b, c, d, e, f)))
            Cubic(first, second, to) => out.segments.push(Cubic(mapped(first, a, b, c, d, e, f), mapped(second, a, b, c, d, e, f), mapped(to, a, b, c, d, e, f)))
            Close => out.segments.push(Close)
        }
    }
    out
}

fn mapped(p: Point, a: f32, b: f32, c: f32, d: f32, e: f32, f: f32) -> Point {
    point(a * p.x + c * p.y + e, b * p.x + d * p.y + f)
}

/// Returns an open path of quadratic curves running `width` to the right from `origin`, swinging `thickness` either side of the line `thickness / 2` below it, one whole wave every six thicknesses: the centre line of a wavy underline `thickness` thick whose top is at `origin`.
pub fn wave(origin: Point, width: f32, thickness: f32) -> Path {
    let half = thickness * 3.0
    let middle = origin.y + thickness * 0.5
    let end = origin.x + width
    var out = path()
    out.move_to(Point { x: origin.x, y: middle })
    if !(half > 0.0) {
        return out
    }
    var x = origin.x
    var up = true
    for x < end {
        let reach = if x + half > end { end - x } else { half }
        let swing = if up { -thickness * 2.0 } else { thickness * 2.0 }
        out.quadratic_to(Point { x: x + reach * 0.5, y: middle + swing * reach / half }, Point { x: x + reach, y: middle })
        x += reach
        up = !up
    }
    out
}

/// Returns the contours of `p` multiplied by `scale` as polygons, each curve split into lines that stay within a twentieth of a pixel of it. Every polygon is closed implicitly.
pub fn flatten(p: Path, scale: f32) -> [][]Point {
    var out: [][]Point = []
    for l in polylines(p, scale) {
        if l.points.len > 2 {
            out.push(l.points)
        }
    }
    out
}

/// Returns polygons whose union by the nonzero rule covers the contours of `p`, multiplied by `scale`, traced by a pen `width` logical pixels wide with round joins and caps. Only closed contours join their last point to their first.
pub fn stroke(p: Path, width: f32, scale: f32) -> [][]Point {
    let half = width * scale * 0.5
    var out: [][]Point = []
    if !(half > 0.0) {
        return out
    }
    for l in polylines(p, scale) {
        let n = l.points.len
        for i, a in l.points {
            out.push(disc(a, half))
            if i + 1 < n {
                push_band(mut out, a, l.points[i + 1], half)
            } else if l.closed && n > 1 {
                push_band(mut out, a, l.points[0], half)
            }
        }
    }
    out
}

fn polylines(p: Path, scale: f32) -> []Polyline {
    var out: []Polyline = []
    var current = Polyline { points: [], closed: false }
    var at = Point {}
    for s in p.segments {
        match s {
            Move(to) => {
                finish(mut out, current)
                at = scaled(to, scale)
                current = Polyline { points: [at], closed: false }
            }
            Line(to) => {
                at = scaled(to, scale)
                current.points.push(at)
            }
            Quadratic(control, to) => {
                let c = scaled(control, scale)
                let end = scaled(to, scale)
                push_quadratic(mut current, at, c, end)
                at = end
            }
            Cubic(first, second, to) => {
                let c1 = scaled(first, scale)
                let c2 = scaled(second, scale)
                let end = scaled(to, scale)
                push_cubic(mut current, at, c1, c2, end)
                at = end
            }
            Close => {
                current.closed = true
                finish(mut out, current)
                at = if current.points.len > 0 { current.points[0] } else { at }
                current = Polyline { points: [at], closed: false }
            }
        }
    }
    finish(mut out, current)
    out
}

fn finish(mut out: []Polyline, l: Polyline) {
    if l.points.len > 1 || l.closed && l.points.len > 0 {
        out.push(l)
    }
}

fn scaled(p: Point, scale: f32) -> Point {
    point(p.x * scale, p.y * scale)
}

fn pieces(deviation: f32) -> i64 {
    let n = i64(sqrt(deviation / tolerance())) + 1
    if n > 128 { 128 } else { n }
}

fn push_quadratic(mut l: Polyline, p0: Point, c: Point, p2: Point) {
    let dx = p0.x - 2.0 * c.x + p2.x
    let dy = p0.y - 2.0 * c.y + p2.y
    let n = pieces(sqrt(dx * dx + dy * dy) * 0.25)
    for i in 1..n + 1 {
        let t = f32(i) / f32(n)
        let u = 1.0 - t
        l.points.push(point(u * u * p0.x + 2.0 * u * t * c.x + t * t * p2.x, u * u * p0.y + 2.0 * u * t * c.y + t * t * p2.y))
    }
}

fn push_cubic(mut l: Polyline, p0: Point, c1: Point, c2: Point, p3: Point) {
    let ax = p0.x - 2.0 * c1.x + c2.x
    let ay = p0.y - 2.0 * c1.y + c2.y
    let bx = c1.x - 2.0 * c2.x + p3.x
    let by = c1.y - 2.0 * c2.y + p3.y
    let a = sqrt(ax * ax + ay * ay)
    let b = sqrt(bx * bx + by * by)
    let n = pieces((if a > b { a } else { b }) * 0.75)
    for i in 1..n + 1 {
        let t = f32(i) / f32(n)
        let u = 1.0 - t
        let w0 = u * u * u
        let w1 = 3.0 * u * u * t
        let w2 = 3.0 * u * t * t
        let w3 = t * t * t
        l.points.push(point(w0 * p0.x + w1 * c1.x + w2 * c2.x + w3 * p3.x, w0 * p0.y + w1 * c1.y + w2 * c2.y + w3 * p3.y))
    }
}

fn push_band(mut out: [][]Point, a: Point, b: Point, half: f32) {
    let dx = b.x - a.x
    let dy = b.y - a.y
    let length = sqrt(dx * dx + dy * dy)
    if length <= 0.0 {
        return
    }
    let nx = -dy / length * half
    let ny = dx / length * half
    out.push(positive([point(a.x + nx, a.y + ny), point(b.x + nx, b.y + ny), point(b.x - nx, b.y - ny), point(a.x - nx, a.y - ny)]))
}

fn disc(c: Point, radius: f32) -> []Point {
    var sides = i64(radius * 2.0)
    if sides < 8 {
        sides = 8
    } else if sides > 64 {
        sides = 64
    }
    var out: []Point = []
    var x = radius
    var y: f32 = 0.0
    let step = 6.2831855 / f32(sides)
    let sq = step * step
    let cs = 1.0 - sq / 2.0 * (1.0 - sq / 12.0 * (1.0 - sq / 30.0 * (1.0 - sq / 56.0)))
    let sn = step * (1.0 - sq / 6.0 * (1.0 - sq / 20.0 * (1.0 - sq / 42.0 * (1.0 - sq / 72.0))))
    for i in 0..sides {
        out.push(point(c.x + x, c.y + y))
        let nx = x * cs - y * sn
        y = x * sn + y * cs
        x = nx
    }
    out
}

fn area(points: []Point) -> f32 {
    var sum: f32 = 0.0
    for i, p in points {
        let q = points[(i + 1) % points.len]
        sum += p.x * q.y - q.x * p.y
    }
    sum
}

fn positive(points: []Point) -> []Point {
    if area(points) >= 0.0 {
        return points
    }
    reversed(points)
}

fn reversed(points: []Point) -> []Point {
    var out: []Point = []
    var i = points.len - 1
    for i >= 0 {
        out.push(points[i])
        i -= 1
    }
    out
}

/// The rule that decides which points a shape's contours enclose.
pub enum FillRule {
    /// A point is inside when the contours wind around it a nonzero number of times.
    NonZero
    /// A point is inside when a ray from it crosses an odd number of contour edges.
    EvenOdd
}
