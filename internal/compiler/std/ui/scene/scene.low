import std/ui/geometry

/// A rounded rectangle with a fill and a border, as the quad shader reads it.
pub extern struct Quad {
    /// The outer edge of the border, in device pixels.
    pub bounds: geometry.Rect
    /// The visible area. `push_quad` replaces it with the scene's current clip.
    pub clip: geometry.Rect = geometry.Rect {}
    /// The colour inside the border.
    pub background: geometry.Color = geometry.Color {}
    /// The colour of the border.
    pub border_color: geometry.Color = geometry.Color {}
    /// The radius of each outer corner.
    pub corner_radii: geometry.Corners = geometry.Corners {}
    /// The width of the border on each side.
    pub border_widths: geometry.Edges = geometry.Edges {}
    /// The colour the fill changes to along `gradient`.
    pub background_end: geometry.Color = geometry.Color {}
    /// How the fill changes from `background` to `background_end`; the default keeps it `background`.
    pub gradient: Gradient = Gradient {}
}

/// A linear change across a quad's fill, as the quad shader reads it.
///
/// A pixel's place on the gradient line is `0.5` plus its offset from the quad's centre dotted with `(dx, dy)`. The fill is `background` up to `from`, `background_end` from `to`, and blended between.
pub extern struct Gradient {
    /// How far along the line one device pixel to the right moves, as a fraction of the line. With `dy` zero, the fill is solid.
    pub dx: f32 = 0.0
    /// How far along the line one device pixel down moves.
    pub dy: f32 = 0.0
    /// Where on the line the fill starts to change.
    pub from: f32 = 0.0
    /// Where on the line the fill reaches `background_end`.
    pub to: f32 = 1.0
}

/// Returns the gradient across `bounds` in the direction `degrees` clockwise from straight up, changing between `from` and `to` along a line as CSS draws it: through the centre, just long enough that the corners it starts and ends at sit on its ends.
pub fn linear(bounds: geometry.Rect, degrees: f32, from: f32, to: f32) -> Gradient {
    let d = geometry.direction(degrees)
    let across = abs(bounds.width * d.x) + abs(bounds.height * d.y)
    if !(across > 0.0) {
        return Gradient { from, to }
    }
    Gradient { dx: d.x / across, dy: d.y / across, from, to }
}

fn abs(v: f32) -> f32 {
    if v < 0.0 { -v } else { v }
}

/// A rounded rectangle blurred by a Gaussian, as the shadow shader reads it.
pub extern struct Shadow {
    /// The rectangle before blurring, in device pixels.
    pub bounds: geometry.Rect
    /// The visible area. `push_shadow` replaces it with the scene's current clip.
    pub clip: geometry.Rect = geometry.Rect {}
    /// The colour at full coverage.
    pub color: geometry.Color = geometry.Color {}
    /// The radius of each corner before blurring.
    pub corner_radii: geometry.Corners = geometry.Corners {}
    /// The standard deviation of the blur in device pixels; the shadow reaches three of them beyond `bounds`.
    pub sigma: f32 = 0.0
    spare_0: f32 = 0.0
    spare_1: f32 = 0.0
    spare_2: f32 = 0.0
}

/// A glyph drawn from the atlas as coverage tinted with a colour, as the sprite shader reads it.
pub extern struct Sprite {
    /// Where the glyph lands, in device pixels.
    pub bounds: geometry.Rect
    /// The visible area. `push_sprite` replaces it with the scene's current clip.
    pub clip: geometry.Rect = geometry.Rect {}
    /// The tint; the atlas gives the coverage.
    pub color: geometry.Color = geometry.Color {}
    /// The glyph's place in the atlas, as fractions of the atlas size.
    pub tile: geometry.Rect = geometry.Rect {}
}

/// An image drawn from the atlas's colour plane, as the picture shader reads it.
pub extern struct Picture {
    /// Where the image lands, in device pixels.
    pub bounds: geometry.Rect
    /// The visible area. `push_picture` replaces it with the scene's current clip.
    pub clip: geometry.Rect = geometry.Rect {}
    /// The radius of each corner the image is rounded to.
    pub corner_radii: geometry.Corners = geometry.Corners {}
    /// The image's place in the colour plane, as fractions of the atlas size.
    pub tile: geometry.Rect = geometry.Rect {}
    /// How opaque the image is drawn, from `0.0` to `1.0`.
    pub opacity: f32 = 1.0
    /// How far the colours are blended toward their luminance, from `0.0` to `1.0` for gray.
    pub grayscale: f32 = 0.0
    spare_0: f32 = 0.0
    spare_1: f32 = 0.0
}

/// The kind of primitive a `Batch` draws.
pub enum Kind {
    /// Entries of `Scene.quads`.
    Quads
    /// Entries of `Scene.shadows`.
    Shadows
    /// Entries of `Scene.sprites`.
    Sprites
    /// Entries of `Scene.pictures`.
    Pictures
}

/// A run of consecutive primitives of one kind, drawn with one call.
pub struct Batch {
    /// Which list the run comes from.
    pub kind: Kind
    /// The index of the run's first primitive in its list.
    pub first: i64
    /// The number of primitives in the run.
    pub count: i64
}

/// The primitives of one frame in device pixels, in the order they were pushed.
pub struct Scene {
    /// The width of the target in device pixels.
    pub width: i64
    /// The height of the target in device pixels.
    pub height: i64
    /// The colour the target is cleared to before drawing.
    pub background: geometry.Color
    /// The quads in draw order.
    pub quads: []Quad = []
    /// The shadows in draw order.
    pub shadows: []Shadow = []
    /// The sprites in draw order.
    pub sprites: []Sprite = []
    /// The pictures in draw order.
    pub pictures: []Picture = []
    quad_order: []i64 = []
    shadow_order: []i64 = []
    sprite_order: []i64 = []
    picture_order: []i64 = []
    clips: []geometry.Rect = []
    pushed: i64 = 0
}

/// Returns an empty scene for a target of `width` by `height` device pixels, cleared to `background`, whose clip is the whole target.
pub fn empty(width: i64, height: i64, background: geometry.Color) -> Scene {
    Scene { width, height, background, clips: [geometry.rect(0.0, 0.0, f32(width), f32(height))] }
}

/// Returns the rectangle primitives are currently clipped to: the intersection of every clip pushed and not popped, and the target.
pub fn clip(s: Scene) -> geometry.Rect {
    s.clips[s.clips.len - 1]
}

/// Narrows the clip to its intersection with `r` until the matching `pop_clip`.
pub fn push_clip(mut s: Scene, r: geometry.Rect) {
    let narrowed = geometry.intersect(clip(s), r)
    s.clips.push(narrowed)
}

/// Restores the clip in force before the last `push_clip`. The target's own clip is never removed.
pub fn pop_clip(mut s: Scene) {
    if s.clips.len > 1 {
        s.clips.pop()
    }
}

/// Adds `q` above everything pushed so far, clipped to the current clip.
pub fn push_quad(mut s: Scene, q: Quad) {
    var clipped = q
    clipped.clip = clip(s)
    s.quads.push(clipped)
    s.quad_order.push(s.pushed)
    s.pushed += 1
}

/// Adds `sh` above everything pushed so far, clipped to the current clip.
pub fn push_shadow(mut s: Scene, sh: Shadow) {
    var clipped = sh
    clipped.clip = clip(s)
    s.shadows.push(clipped)
    s.shadow_order.push(s.pushed)
    s.pushed += 1
}

/// Adds `sp` above everything pushed so far, clipped to the current clip.
pub fn push_sprite(mut s: Scene, sp: Sprite) {
    var clipped = sp
    clipped.clip = clip(s)
    s.sprites.push(clipped)
    s.sprite_order.push(s.pushed)
    s.pushed += 1
}

/// Adds `p` above everything pushed so far, clipped to the current clip.
pub fn push_picture(mut s: Scene, p: Picture) {
    var clipped = p
    clipped.clip = clip(s)
    s.pictures.push(clipped)
    s.picture_order.push(s.pushed)
    s.pushed += 1
}

/// Returns the runs to draw, in order, so that primitives of every kind draw in the order they were pushed.
///
/// Consecutive primitives of one kind share a run, so a scene of quads under text is two batches however many of each it holds.
pub fn batches(s: Scene) -> []Batch {
    let kinds: []Kind = [Quads, Shadows, Sprites, Pictures]
    let orders = [s.quad_order, s.shadow_order, s.sprite_order, s.picture_order]
    var next = [0, 0, 0, 0]
    var out: []Batch = []
    for {
        var chosen = -1
        var lowest = s.pushed
        for k, order in orders {
            if next[k] < order.len && order[next[k]] < lowest {
                lowest = order[next[k]]
                chosen = k
            }
        }
        if chosen < 0 {
            return out
        }
        out.extend_run(kinds[chosen], next[chosen])
        next[chosen] += 1
    }
    out
}

fn extend_run(mut out: []Batch, kind: Kind, index: i64) {
    if out.len > 0 && out[out.len - 1].kind == kind {
        out[out.len - 1].count += 1
        return
    }
    out.push(Batch { kind, first: index, count: 1 })
}


/// Two square images the GPU samples: glyph and shape coverage for sprites, and colours for pictures.
pub struct Atlas {
    /// The width and height of each plane in pixels.
    pub size: i64
    /// One coverage byte per pixel.
    pub coverage: Plane
    /// Four bytes per pixel: red, green, blue and alpha, not premultiplied.
    pub colors: Plane
}

/// One image of an atlas, rows from the top, with the band of rows changed since the GPU last copied it.
pub struct Plane {
    /// The width and height in pixels.
    pub size: i64
    /// The number of bytes per pixel.
    pub channels: i64
    /// The pixels, `channels` bytes each.
    pub pixels: []u8
    /// The first row changed since `clean`, or `size` when none has.
    pub dirty_top: i64
    /// One past the last row changed since `clean`, or `0` when none has.
    pub dirty_bottom: i64
}

/// Returns a clear atlas whose planes are `size` by `size` pixels, all of them marked changed.
pub fn atlas(size: i64) -> Atlas {
    Atlas { size, coverage: plane(size, 1), colors: plane(size, 4) }
}

fn plane(size: i64, channels: i64) -> Plane {
    Plane { size, channels, pixels: __make(size * size * channels), dirty_top: 0, dirty_bottom: size }
}

/// Copies `coverage`, `width` by `height` bytes in rows, into the coverage plane with its top-left pixel at `x`, `y`, and marks those rows changed.
pub fn write(mut a: Atlas, x: i64, y: i64, width: i64, height: i64, coverage: []u8) {
    a.coverage.put(x, y, width, height, coverage)
}

/// Copies `rgba`, `width` by `height` pixels of four bytes in rows, into the colour plane with its top-left pixel at `x`, `y`, and marks those rows changed.
pub fn write_colors(mut a: Atlas, x: i64, y: i64, width: i64, height: i64, rgba: []u8) {
    a.colors.put(x, y, width, height, rgba)
}

fn put(mut p: Plane, x: i64, y: i64, width: i64, height: i64, data: []u8) {
    let row_bytes = width * p.channels
    for row in 0..height {
        let from = row * row_bytes
        let to = ((y + row) * p.size + x) * p.channels
        for i in 0..row_bytes {
            p.pixels[to + i] = data[from + i]
        }
    }
    if y < p.dirty_top {
        p.dirty_top = y
    }
    if y + height > p.dirty_bottom {
        p.dirty_bottom = y + height
    }
}

/// Zeroes every pixel of `p` and marks all of it changed.
pub fn clear(mut p: Plane) {
    for i in 0..p.pixels.len {
        p.pixels[i] = 0
    }
    p.dirty_top = 0
    p.dirty_bottom = p.size
}

/// Returns `true` when rows of either plane have changed since the last `clean`.
pub fn dirty(a: Atlas) -> bool {
    a.coverage.dirty_top < a.coverage.dirty_bottom || a.colors.dirty_top < a.colors.dirty_bottom
}

/// Marks every row of both planes as copied.
pub fn clean(mut a: Atlas) {
    a.coverage.dirty_top = a.size
    a.coverage.dirty_bottom = 0
    a.colors.dirty_top = a.size
    a.colors.dirty_bottom = 0
}

/// Returns the fractions of a plane that a `width` by `height` pixel tile at `x`, `y` covers, for `Sprite.tile` and `Picture.tile`.
pub fn tile(a: Atlas, x: i64, y: i64, width: i64, height: i64) -> geometry.Rect {
    let size = f32(a.size)
    geometry.rect(f32(x) / size, f32(y) / size, f32(width) / size, f32(height) / size)
}
