import std/ui/geometry

/// A rounded rectangle with a fill and a border, as the quad shader reads it.
pub extern struct Quad {
    /// The outer edge of the border, in device pixels.
    pub bounds: geometry.Rect
    /// The visible area. `push_quad` replaces it with the scene's current clip.
    pub clip: geometry.Rect = geometry.Rect {}
    /// The colour inside the border.
    pub background: geometry.Color = geometry.Color {}
    /// The colour of the border.
    pub border_color: geometry.Color = geometry.Color {}
    /// The radius of each outer corner.
    pub corner_radii: geometry.Corners = geometry.Corners {}
    /// The width of the border on each side.
    pub border_widths: geometry.Edges = geometry.Edges {}
}

/// A rounded rectangle blurred by a Gaussian, as the shadow shader reads it.
pub extern struct Shadow {
    /// The rectangle before blurring, in device pixels.
    pub bounds: geometry.Rect
    /// The visible area. `push_shadow` replaces it with the scene's current clip.
    pub clip: geometry.Rect = geometry.Rect {}
    /// The colour at full coverage.
    pub color: geometry.Color = geometry.Color {}
    /// The radius of each corner before blurring.
    pub corner_radii: geometry.Corners = geometry.Corners {}
    /// The standard deviation of the blur in device pixels; the shadow reaches three of them beyond `bounds`.
    pub sigma: f32 = 0.0
    spare_0: f32 = 0.0
    spare_1: f32 = 0.0
    spare_2: f32 = 0.0
}

/// A glyph drawn from the atlas as coverage tinted with a colour, as the sprite shader reads it.
pub extern struct Sprite {
    /// Where the glyph lands, in device pixels.
    pub bounds: geometry.Rect
    /// The visible area. `push_sprite` replaces it with the scene's current clip.
    pub clip: geometry.Rect = geometry.Rect {}
    /// The tint; the atlas gives the coverage.
    pub color: geometry.Color = geometry.Color {}
    /// The glyph's place in the atlas, as fractions of the atlas size.
    pub tile: geometry.Rect = geometry.Rect {}
}

/// The kind of primitive a `Batch` draws.
pub enum Kind {
    /// Entries of `Scene.quads`.
    Quads
    /// Entries of `Scene.shadows`.
    Shadows
    /// Entries of `Scene.sprites`.
    Sprites
}

/// A run of consecutive primitives of one kind, drawn with one call.
pub struct Batch {
    /// Which list the run comes from.
    pub kind: Kind
    /// The index of the run's first primitive in its list.
    pub first: i64
    /// The number of primitives in the run.
    pub count: i64
}

/// The primitives of one frame in device pixels, in the order they were pushed.
pub struct Scene {
    /// The width of the target in device pixels.
    pub width: i64
    /// The height of the target in device pixels.
    pub height: i64
    /// The colour the target is cleared to before drawing.
    pub background: geometry.Color
    /// The quads in draw order.
    pub quads: []Quad = []
    /// The shadows in draw order.
    pub shadows: []Shadow = []
    /// The sprites in draw order.
    pub sprites: []Sprite = []
    quad_order: []i64 = []
    shadow_order: []i64 = []
    sprite_order: []i64 = []
    clips: []geometry.Rect = []
    pushed: i64 = 0
}

/// Returns an empty scene for a target of `width` by `height` device pixels, cleared to `background`, whose clip is the whole target.
pub fn empty(width: i64, height: i64, background: geometry.Color) -> Scene {
    Scene { width, height, background, clips: [geometry.rect(0.0, 0.0, f32(width), f32(height))] }
}

/// Returns the rectangle primitives are currently clipped to: the intersection of every clip pushed and not popped, and the target.
pub fn clip(s: Scene) -> geometry.Rect {
    s.clips[s.clips.len - 1]
}

/// Narrows the clip to its intersection with `r` until the matching `pop_clip`.
pub fn push_clip(mut s: Scene, r: geometry.Rect) {
    let narrowed = geometry.intersect(clip(s), r)
    s.clips.push(narrowed)
}

/// Restores the clip in force before the last `push_clip`. The target's own clip is never removed.
pub fn pop_clip(mut s: Scene) {
    if s.clips.len > 1 {
        s.clips.pop()
    }
}

/// Adds `q` above everything pushed so far, clipped to the current clip.
pub fn push_quad(mut s: Scene, q: Quad) {
    var clipped = q
    clipped.clip = clip(s)
    s.quads.push(clipped)
    s.quad_order.push(s.pushed)
    s.pushed += 1
}

/// Adds `sh` above everything pushed so far, clipped to the current clip.
pub fn push_shadow(mut s: Scene, sh: Shadow) {
    var clipped = sh
    clipped.clip = clip(s)
    s.shadows.push(clipped)
    s.shadow_order.push(s.pushed)
    s.pushed += 1
}

/// Adds `sp` above everything pushed so far, clipped to the current clip.
pub fn push_sprite(mut s: Scene, sp: Sprite) {
    var clipped = sp
    clipped.clip = clip(s)
    s.sprites.push(clipped)
    s.sprite_order.push(s.pushed)
    s.pushed += 1
}

/// Returns the runs to draw, in order, so that primitives of every kind draw in the order they were pushed.
///
/// Consecutive primitives of one kind share a run, so a scene of quads under text is two batches however many of each it holds.
pub fn batches(s: Scene) -> []Batch {
    var out: []Batch = []
    var q = 0
    var sh = 0
    var sp = 0
    for q < s.quads.len || sh < s.shadows.len || sp < s.sprites.len {
        let qo = if q < s.quads.len { s.quad_order[q] } else { s.pushed }
        let sho = if sh < s.shadows.len { s.shadow_order[sh] } else { s.pushed }
        let spo = if sp < s.sprites.len { s.sprite_order[sp] } else { s.pushed }
        if qo < sho && qo < spo {
            out.extend_run(Quads, q)
            q += 1
        } else if sho < spo {
            out.extend_run(Shadows, sh)
            sh += 1
        } else {
            out.extend_run(Sprites, sp)
            sp += 1
        }
    }
    out
}

fn extend_run(mut out: []Batch, kind: Kind, index: i64) {
    if out.len > 0 && out[out.len - 1].kind == kind {
        out[out.len - 1].count += 1
        return
    }
    out.push(Batch { kind, first: index, count: 1 })
}

/// A square single-channel image of glyph coverage that sprites sample, with the band of rows changed since the GPU last copied it.
pub struct Atlas {
    /// The width and height in pixels.
    pub size: i64
    /// One coverage byte per pixel, rows from the top.
    pub pixels: []u8
    /// The first row changed since `clean`, or `size` when none has.
    pub dirty_top: i64
    /// One past the last row changed since `clean`, or `0` when none has.
    pub dirty_bottom: i64
}

/// Returns a clear atlas of `size` by `size` pixels, all of it marked changed.
pub fn atlas(size: i64) -> Atlas {
    Atlas { size, pixels: __make(size * size), dirty_top: 0, dirty_bottom: size }
}

/// Copies `coverage`, `width` by `height` bytes in rows, into the atlas with its top-left pixel at `x`, `y`, and marks those rows changed.
pub fn write(mut a: Atlas, x: i64, y: i64, width: i64, height: i64, coverage: []u8) {
    for row in 0..height {
        let from = row * width
        let to = (y + row) * a.size + x
        for col in 0..width {
            a.pixels[to + col] = coverage[from + col]
        }
    }
    if y < a.dirty_top {
        a.dirty_top = y
    }
    if y + height > a.dirty_bottom {
        a.dirty_bottom = y + height
    }
}

/// Zeroes every pixel and marks the whole atlas changed.
pub fn clear(mut a: Atlas) {
    for i in 0..a.pixels.len {
        a.pixels[i] = 0
    }
    a.dirty_top = 0
    a.dirty_bottom = a.size
}

/// Returns `true` when rows have changed since the last `clean`.
pub fn dirty(a: Atlas) -> bool {
    a.dirty_top < a.dirty_bottom
}

/// Marks every row as copied.
pub fn clean(mut a: Atlas) {
    a.dirty_top = a.size
    a.dirty_bottom = 0
}

/// Returns the fractions of the atlas that a `width` by `height` pixel tile at `x`, `y` covers, for `Sprite.tile`.
pub fn tile(a: Atlas, x: i64, y: i64, width: i64, height: i64) -> geometry.Rect {
    let size = f32(a.size)
    geometry.rect(f32(x) / size, f32(y) / size, f32(width) / size, f32(height) / size)
}
