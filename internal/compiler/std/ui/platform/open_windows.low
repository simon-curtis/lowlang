extern "shell32" {
    fn ShellExecuteW(hwnd: ptr, operation: ptr, file: ptr, parameters: ptr, directory: ptr, show: i32) -> i64
}

extern "ole32" {
    fn CoInitializeEx(reserved: ptr, flags: u32) -> i32
    fn CoUninitialize()
}

fn sw_show_normal() -> i32 {
    1
}

fn coinit_apartment_no_dde() -> u32 {
    6
}

fn launch(url: str) ! Error {
    let operation = wide("open")
    let file = wide(url)
    let joined = CoInitializeEx(null, coinit_apartment_no_dde())
    let code = ShellExecuteW(null, __slice_ptr(operation), __slice_ptr(file), null, null, sw_show_normal())
    if joined >= 0 {
        CoUninitialize()
    }
    if code <= 32 {
        fail Failed("ShellExecuteW", code)
    }
}
