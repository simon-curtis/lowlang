fn cf_unicode_text() -> u32 {
    13
}

fn gmem_moveable() -> u32 {
    2
}

fn open_attempts() -> i64 {
    10
}

fn open_clipboard(s: *WindowState) ! Error {
    if s.hwnd == null {
        fail Disconnected
    }
    for _ in 0..open_attempts() {
        if OpenClipboard(s.hwnd) != 0 {
            return
        }
        sleep(1)
    }
    fail Failed("OpenClipboard", i64(GetLastError()))
}

fn write_window_clipboard(s: *WindowState, text: str) ! Error {
    let units = wide(text)
    let memory = GlobalAlloc(gmem_moveable(), units.len)
    if memory == null {
        fail Failed("GlobalAlloc", i64(GetLastError()))
    }
    let target = GlobalLock(memory)
    if target == null {
        GlobalFree(memory)
        fail Failed("GlobalLock", i64(GetLastError()))
    }
    RtlMoveMemory(target, __slice_ptr(units), units.len)
    GlobalUnlock(memory)
    open_clipboard(s) catch {
        e => {
            GlobalFree(memory)
            fail e
        }
    }
    EmptyClipboard()
    let placed = SetClipboardData(cf_unicode_text(), memory)
    let code = GetLastError()
    CloseClipboard()
    if placed == null {
        GlobalFree(memory)
        fail Failed("SetClipboardData", i64(code))
    }
}

fn read_window_clipboard(s: *WindowState) -> str? ! Error {
    open_clipboard(s)?
    let memory = GetClipboardData(cf_unicode_text())
    if memory == null {
        CloseClipboard()
        return none
    }
    let units = GlobalLock(memory)
    if units == null {
        CloseClipboard()
        return none
    }
    let text = narrow_terminated(units)
    GlobalUnlock(memory)
    CloseClipboard()
    text
}

fn narrow_terminated(units: ptr) -> str {
    let n = WideCharToMultiByte(utf8_page(), 0, units, -1, null, 0, null, null)
    if n <= 1 {
        return ""
    }
    let out: []u8 = __make(i64(n))
    WideCharToMultiByte(utf8_page(), 0, units, -1, __slice_ptr(out), n, null, null)
    str(out[..n - 1])
}
