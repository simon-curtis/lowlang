extern "wayland-client" {
    fn wl_display_connect(name: ptr[u8]) -> ptr
    fn wl_display_disconnect(display: ptr)
    fn wl_display_roundtrip(display: ptr) -> i32
    fn wl_display_dispatch(display: ptr) -> i32
    fn wl_display_dispatch_pending(display: ptr) -> i32
    fn wl_display_flush(display: ptr) -> i32
    fn wl_display_get_fd(display: ptr) -> i32
    fn wl_display_prepare_read(display: ptr) -> i32
    fn wl_display_read_events(display: ptr) -> i32
    fn wl_display_cancel_read(display: ptr)
    fn wl_display_get_error(display: ptr) -> i32
    fn wl_proxy_destroy(proxy: ptr)
    fn wl_proxy_get_version(proxy: ptr) -> u32
    fn wl_proxy_marshal_flags(proxy: ptr, opcode: u32, interface: ptr, version: u32, flags: u32, ...) -> ptr
    fn wl_proxy_add_listener(proxy: ptr, listener: ptr, data: ptr) -> i32
}

extern "c" {
    fn malloc(n: i64) -> ptr
    fn free(p: ptr)
}

extern struct WlInterface {
    name: ptr[u8]
    version: i32
    method_count: i32
    methods: ptr
    event_count: i32
    events: ptr
}

extern struct WlMessage {
    name: ptr[u8]
    signature: ptr[u8]
    types: ptr
}

struct WlMemory {
    blocks: []ptr
}

fn wl_alloc(m: *WlMemory, n: i64) -> ptr {
    let p = malloc(n)
    m.blocks.push(p)
    p
}

fn wl_c_string(m: *WlMemory, s: str) -> ptr[u8] {
    let p: ptr[u8] = wl_alloc(m, s.len + 1)
    let bytes = view(p, s.len + 1)
    for i in 0..s.len {
        bytes[i] = s[i]
    }
    bytes[s.len] = 0
    p
}

fn wl_types(m: *WlMemory, entries: []ptr) -> ptr {
    let p: ptr[ptr] = wl_alloc(m, 8 * entries.len + 8)
    let slots = view(p, entries.len)
    for i in 0..entries.len {
        slots[i] = entries[i]
    }
    p
}

fn wl_message(m: *WlMemory, name: str, signature: str, types: ptr) -> WlMessage {
    WlMessage { name: wl_c_string(m, name), signature: wl_c_string(m, signature), types }
}

struct Interfaces {
    memory: *WlMemory
    wl_display: ptr
    wl_registry: ptr
    wl_callback: ptr
    wl_compositor: ptr
    wl_shm_pool: ptr
    wl_shm: ptr
    wl_buffer: ptr
    wl_data_offer: ptr
    wl_data_source: ptr
    wl_data_device: ptr
    wl_data_device_manager: ptr
    wl_shell: ptr
    wl_shell_surface: ptr
    wl_surface: ptr
    wl_seat: ptr
    wl_pointer: ptr
    wl_keyboard: ptr
    wl_touch: ptr
    wl_output: ptr
    wl_region: ptr
    wl_subcompositor: ptr
    wl_subsurface: ptr
    wl_fixes: ptr
    xdg_wm_base: ptr
    xdg_positioner: ptr
    xdg_surface: ptr
    xdg_toplevel: ptr
    xdg_popup: ptr
}

fn interfaces() -> Interfaces {
    let memory = new(WlMemory { blocks: [] })
    let ifs = Interfaces {
        memory
        wl_display: wl_alloc(memory, 40)
        wl_registry: wl_alloc(memory, 40)
        wl_callback: wl_alloc(memory, 40)
        wl_compositor: wl_alloc(memory, 40)
        wl_shm_pool: wl_alloc(memory, 40)
        wl_shm: wl_alloc(memory, 40)
        wl_buffer: wl_alloc(memory, 40)
        wl_data_offer: wl_alloc(memory, 40)
        wl_data_source: wl_alloc(memory, 40)
        wl_data_device: wl_alloc(memory, 40)
        wl_data_device_manager: wl_alloc(memory, 40)
        wl_shell: wl_alloc(memory, 40)
        wl_shell_surface: wl_alloc(memory, 40)
        wl_surface: wl_alloc(memory, 40)
        wl_seat: wl_alloc(memory, 40)
        wl_pointer: wl_alloc(memory, 40)
        wl_keyboard: wl_alloc(memory, 40)
        wl_touch: wl_alloc(memory, 40)
        wl_output: wl_alloc(memory, 40)
        wl_region: wl_alloc(memory, 40)
        wl_subcompositor: wl_alloc(memory, 40)
        wl_subsurface: wl_alloc(memory, 40)
        wl_fixes: wl_alloc(memory, 40)
        xdg_wm_base: wl_alloc(memory, 40)
        xdg_positioner: wl_alloc(memory, 40)
        xdg_surface: wl_alloc(memory, 40)
        xdg_toplevel: wl_alloc(memory, 40)
        xdg_popup: wl_alloc(memory, 40)
    }
    wl_fill_wl_display(ifs)
    wl_fill_wl_registry(ifs)
    wl_fill_wl_callback(ifs)
    wl_fill_wl_compositor(ifs)
    wl_fill_wl_shm_pool(ifs)
    wl_fill_wl_shm(ifs)
    wl_fill_wl_buffer(ifs)
    wl_fill_wl_data_offer(ifs)
    wl_fill_wl_data_source(ifs)
    wl_fill_wl_data_device(ifs)
    wl_fill_wl_data_device_manager(ifs)
    wl_fill_wl_shell(ifs)
    wl_fill_wl_shell_surface(ifs)
    wl_fill_wl_surface(ifs)
    wl_fill_wl_seat(ifs)
    wl_fill_wl_pointer(ifs)
    wl_fill_wl_keyboard(ifs)
    wl_fill_wl_touch(ifs)
    wl_fill_wl_output(ifs)
    wl_fill_wl_region(ifs)
    wl_fill_wl_subcompositor(ifs)
    wl_fill_wl_subsurface(ifs)
    wl_fill_wl_fixes(ifs)
    wl_fill_xdg_wm_base(ifs)
    wl_fill_xdg_positioner(ifs)
    wl_fill_xdg_surface(ifs)
    wl_fill_xdg_toplevel(ifs)
    wl_fill_xdg_popup(ifs)
    ifs
}

fn release_interfaces(ifs: Interfaces) {
    for p in ifs.memory.blocks {
        free(p)
    }
    ifs.memory.blocks = []
}

fn wl_fill_wl_display(ifs: Interfaces) {
    let methods: ptr[WlMessage] = wl_alloc(ifs.memory, 48)
    let methods_view = view(methods, 2)
    let methods_types0: []ptr = [ifs.wl_callback]
    methods_view[0] = wl_message(ifs.memory, "sync", "n", wl_types(ifs.memory, methods_types0))
    let methods_types1: []ptr = [ifs.wl_registry]
    methods_view[1] = wl_message(ifs.memory, "get_registry", "n", wl_types(ifs.memory, methods_types1))
    let events: ptr[WlMessage] = wl_alloc(ifs.memory, 48)
    let events_view = view(events, 2)
    let events_types0: []ptr = [null, null, null]
    events_view[0] = wl_message(ifs.memory, "error", "ous", wl_types(ifs.memory, events_types0))
    let events_types1: []ptr = [null]
    events_view[1] = wl_message(ifs.memory, "delete_id", "u", wl_types(ifs.memory, events_types1))
    let target: ptr[WlInterface] = ifs.wl_display
    store(target, WlInterface { name: wl_c_string(ifs.memory, "wl_display"), version: 1, method_count: 2, methods, event_count: 2, events })
}

fn wl_display_sync(ifs: Interfaces, wl_display: ptr) -> ptr {
    let version = wl_proxy_get_version(wl_display)
    wl_proxy_marshal_flags(wl_display, 0, ifs.wl_callback, version, 0, null)
}

fn wl_display_get_registry(ifs: Interfaces, wl_display: ptr) -> ptr {
    let version = wl_proxy_get_version(wl_display)
    wl_proxy_marshal_flags(wl_display, 1, ifs.wl_registry, version, 0, null)
}

fn wl_display_error_invalid_object() -> u32 {
    0
}

fn wl_display_error_invalid_method() -> u32 {
    1
}

fn wl_display_error_no_memory() -> u32 {
    2
}

fn wl_display_error_implementation() -> u32 {
    3
}

fn wl_fill_wl_registry(ifs: Interfaces) {
    let methods: ptr[WlMessage] = wl_alloc(ifs.memory, 24)
    let methods_view = view(methods, 1)
    let methods_types0: []ptr = [null, null, null, null]
    methods_view[0] = wl_message(ifs.memory, "bind", "usun", wl_types(ifs.memory, methods_types0))
    let events: ptr[WlMessage] = wl_alloc(ifs.memory, 48)
    let events_view = view(events, 2)
    let events_types0: []ptr = [null, null, null]
    events_view[0] = wl_message(ifs.memory, "global", "usu", wl_types(ifs.memory, events_types0))
    let events_types1: []ptr = [null]
    events_view[1] = wl_message(ifs.memory, "global_remove", "u", wl_types(ifs.memory, events_types1))
    let target: ptr[WlInterface] = ifs.wl_registry
    store(target, WlInterface { name: wl_c_string(ifs.memory, "wl_registry"), version: 1, method_count: 1, methods, event_count: 2, events })
}

fn wl_registry_bind(wl_registry: ptr, name: u32, interface: ptr, version: u32) -> ptr {
    let described: ptr[WlInterface] = interface
    let description = load(described)
    wl_proxy_marshal_flags(wl_registry, 0, interface, version, 0, name, description.name, version, null)
}

fn wl_registry_destroy(wl_registry: ptr) {
    wl_proxy_destroy(wl_registry)
}

fn wl_registry_global_ignore(data: ptr, proxy: ptr, name: u32, interface: ptr[u8], version: u32) {
}

fn wl_registry_global_remove_ignore(data: ptr, proxy: ptr, name: u32) {
}

extern struct WlRegistryListener {
    global: extern fn(ptr, ptr, u32, ptr[u8], u32) = wl_registry_global_ignore
    global_remove: extern fn(ptr, ptr, u32) = wl_registry_global_remove_ignore
}

fn wl_registry_add_listener(ifs: Interfaces, wl_registry: ptr, listener: WlRegistryListener, data: ptr) -> i32 {
    let copy: ptr[WlRegistryListener] = wl_alloc(ifs.memory, 16)
    store(copy, listener)
    wl_proxy_add_listener(wl_registry, copy, data)
}

fn wl_fill_wl_callback(ifs: Interfaces) {
    let methods: ptr[WlMessage] = wl_alloc(ifs.memory, 24)
    let events: ptr[WlMessage] = wl_alloc(ifs.memory, 24)
    let events_view = view(events, 1)
    let events_types0: []ptr = [null]
    events_view[0] = wl_message(ifs.memory, "done", "u", wl_types(ifs.memory, events_types0))
    let target: ptr[WlInterface] = ifs.wl_callback
    store(target, WlInterface { name: wl_c_string(ifs.memory, "wl_callback"), version: 1, method_count: 0, methods, event_count: 1, events })
}

fn wl_callback_destroy(wl_callback: ptr) {
    wl_proxy_destroy(wl_callback)
}

fn wl_callback_done_ignore(data: ptr, proxy: ptr, callback_data: u32) {
}

extern struct WlCallbackListener {
    done: extern fn(ptr, ptr, u32) = wl_callback_done_ignore
}

fn wl_callback_add_listener(ifs: Interfaces, wl_callback: ptr, listener: WlCallbackListener, data: ptr) -> i32 {
    let copy: ptr[WlCallbackListener] = wl_alloc(ifs.memory, 8)
    store(copy, listener)
    wl_proxy_add_listener(wl_callback, copy, data)
}

fn wl_fill_wl_compositor(ifs: Interfaces) {
    let methods: ptr[WlMessage] = wl_alloc(ifs.memory, 72)
    let methods_view = view(methods, 3)
    let methods_types0: []ptr = [ifs.wl_surface]
    methods_view[0] = wl_message(ifs.memory, "create_surface", "n", wl_types(ifs.memory, methods_types0))
    let methods_types1: []ptr = [ifs.wl_region]
    methods_view[1] = wl_message(ifs.memory, "create_region", "n", wl_types(ifs.memory, methods_types1))
    let methods_types2: []ptr = []
    methods_view[2] = wl_message(ifs.memory, "release", "7", wl_types(ifs.memory, methods_types2))
    let events: ptr[WlMessage] = wl_alloc(ifs.memory, 24)
    let target: ptr[WlInterface] = ifs.wl_compositor
    store(target, WlInterface { name: wl_c_string(ifs.memory, "wl_compositor"), version: 7, method_count: 3, methods, event_count: 0, events })
}

fn wl_compositor_create_surface(ifs: Interfaces, wl_compositor: ptr) -> ptr {
    let version = wl_proxy_get_version(wl_compositor)
    wl_proxy_marshal_flags(wl_compositor, 0, ifs.wl_surface, version, 0, null)
