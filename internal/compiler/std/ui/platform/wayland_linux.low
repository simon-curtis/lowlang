}

fn wl_fill_wl_shm_pool(ifs: Interfaces) {
    let methods: ptr[WlMessage] = wl_alloc(ifs.memory, 72)
    let methods_view = view(methods, 3)
    let methods_types0: []ptr = [ifs.wl_buffer, null, null, null, null, null]
    methods_view[0] = wl_message(ifs.memory, "create_buffer", "niiiiu", wl_types(ifs.memory, methods_types0))
    let methods_types1: []ptr = []
    methods_view[1] = wl_message(ifs.memory, "destroy", "", wl_types(ifs.memory, methods_types1))
    let methods_types2: []ptr = [null]
    methods_view[2] = wl_message(ifs.memory, "resize", "i", wl_types(ifs.memory, methods_types2))
    let events: ptr[WlMessage] = wl_alloc(ifs.memory, 24)
    let target: ptr[WlInterface] = ifs.wl_shm_pool
    store(target, WlInterface { name: wl_c_string(ifs.memory, "wl_shm_pool"), version: 3, method_count: 3, methods, event_count: 0, events })
}

fn wl_shm_pool_create_buffer(ifs: Interfaces, wl_shm_pool: ptr, offset: i32, width: i32, height: i32, stride: i32, format: u32) -> ptr {
    let version = wl_proxy_get_version(wl_shm_pool)
    wl_proxy_marshal_flags(wl_shm_pool, 0, ifs.wl_buffer, version, 0, null, offset, width, height, stride, format)
}

fn wl_shm_pool_destroy(wl_shm_pool: ptr) {
    let version = wl_proxy_get_version(wl_shm_pool)
    wl_proxy_marshal_flags(wl_shm_pool, 1, null, version, 1)
}

fn wl_shm_pool_resize(wl_shm_pool: ptr, size: i32) {
    let version = wl_proxy_get_version(wl_shm_pool)
    wl_proxy_marshal_flags(wl_shm_pool, 2, null, version, 0, size)
}

