    events_view[1] = wl_message(ifs.memory, "popup_done", "", wl_types(ifs.memory, events_types1))
    let events_types2: []ptr = [null]
    events_view[2] = wl_message(ifs.memory, "repositioned", "3u", wl_types(ifs.memory, events_types2))
    let target: ptr[WlInterface] = ifs.xdg_popup
    store(target, WlInterface { name: wl_c_string(ifs.memory, "xdg_popup"), version: 7, method_count: 3, methods, event_count: 3, events })
}

fn xdg_popup_destroy(xdg_popup: ptr) {
    let version = wl_proxy_get_version(xdg_popup)
    wl_proxy_marshal_flags(xdg_popup, 0, null, version, 1)
}

fn xdg_popup_grab(xdg_popup: ptr, seat: ptr, serial: u32) {
    let version = wl_proxy_get_version(xdg_popup)
    wl_proxy_marshal_flags(xdg_popup, 1, null, version, 0, seat, serial)
}

fn xdg_popup_reposition(xdg_popup: ptr, positioner: ptr, token: u32) {
    let version = wl_proxy_get_version(xdg_popup)
    wl_proxy_marshal_flags(xdg_popup, 2, null, version, 0, positioner, token)
}

fn xdg_popup_configure_ignore(data: ptr, proxy: ptr, x: i32, y: i32, width: i32, height: i32) {
}

fn xdg_popup_popup_done_ignore(data: ptr, proxy: ptr) {
}

fn xdg_popup_repositioned_ignore(data: ptr, proxy: ptr, token: u32) {
}

extern struct XdgPopupListener {
    configure: extern fn(ptr, ptr, i32, i32, i32, i32) = xdg_popup_configure_ignore
    popup_done: extern fn(ptr, ptr) = xdg_popup_popup_done_ignore
    repositioned: extern fn(ptr, ptr, u32) = xdg_popup_repositioned_ignore
}

fn xdg_popup_add_listener(ifs: Interfaces, xdg_popup: ptr, listener: XdgPopupListener, data: ptr) -> i32 {
    let copy: ptr[XdgPopupListener] = wl_alloc(ifs.memory, 24)
    store(copy, listener)
    wl_proxy_add_listener(xdg_popup, copy, data)
}

fn xdg_popup_error_invalid_grab() -> u32 {
    0
}

