    let methods_types1: []ptr = []
    methods_view[1] = wl_message(ifs.memory, "release", "2", wl_types(ifs.memory, methods_types1))
    let events: ptr[WlMessage] = wl_alloc(ifs.memory, 24)
    let events_view = view(events, 1)
    let events_types0: []ptr = [null]
    events_view[0] = wl_message(ifs.memory, "format", "u", wl_types(ifs.memory, events_types0))
    let target: ptr[WlInterface] = ifs.wl_shm
    store(target, WlInterface { name: wl_c_string(ifs.memory, "wl_shm"), version: 3, method_count: 2, methods, event_count: 1, events })
}

