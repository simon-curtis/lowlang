import std/sys

extern "c" {
    fn errno_location() -> ptr[i32] = "__errno_location"
}

struct Handle {
    state: *WindowState
}

struct WakerState {
    signal: chan[bool]
}

struct WindowState {
    ifs: Interfaces
    arm: chan[bool]
    ready: chan[bool]
    done: chan[bool]
    waker: *WakerState
    display: ptr = null
    registry: ptr = null
    compositor: ptr = null
    wm_base: ptr = null
    seat: ptr = null
    surface: ptr = null
    xdg_surface: ptr = null
    toplevel: ptr = null
    pointer: ptr = null
    keyboard: ptr = null
    cursor_manager: ptr = null
    cursor_device: ptr = null
    decoration_manager: ptr = null
    decoration: ptr = null
    data_manager: ptr = null
    data_device: ptr = null
    incoming: ptr = null
    incoming_type: str = ""
    selection: ptr = null
    selection_type: str = ""
    source: ptr = null
    source_text: str = ""
    input_serial: u32 = 0
    press_serial: u32 = 0
    decorations: Decorations = Server
    status: WindowStatus = WindowStatus {}
    pending_status: WindowStatus = WindowStatus {}
    text_manager: ptr = null
    text_input: ptr = null
    text_entered: bool = false
    text_enabled: bool = false
    caret: Caret? = none
    preedit: str = ""
    pending_preedit: str = ""
    pending_cursor: TextRange? = none
    pending_commit: str = ""
    handle: ptr = null
    fd: i64 = -1
    pumping: bool = false
    armed: bool = false
    events: []Event = []
    fault: Error? = none
    requested_width: i64 = 0
    requested_height: i64 = 0
    pending_width: i64 = 0
    pending_height: i64 = 0
    width: i64 = 0
    height: i64 = 0
    scale: f32 = 1.0
    fraction_manager: ptr = null
    fraction: ptr = null
    viewporter: ptr = null
    viewport: ptr = null
    configured: bool = false
    pointer_x: f32 = 0.0
    pointer_y: f32 = 0.0
    pointer_inside: bool = false
    enter_serial: u32 = 0
    cursor: Cursor = Arrow
    modifiers: Modifiers = Modifiers {}
    keys: Keys = Keys {}
    repeat: Repeat = Repeat {}
}

enum Woke {
    Data
    Signalled
    Idle
}

fn configure_timeout_ms() -> i64 {
    5000
}

fn idle_wait_ms() -> i64 {
    60000
}

fn stop_timeout_ms() -> i64 {
    2000
}

fn flush_attempts() -> i64 {
    5000
}

fn errno_again() -> i64 {
    11
}

fn errno_pipe() -> i64 {
    32
}

fn errno_reset() -> i64 {
    104
}

fn open_window(o: Options) -> *WindowState ! Error {
    let ifs = interfaces()
    let waker = new(WakerState { signal: chan[bool](1) })
    let s = new(WindowState {
        ifs
        arm: chan[bool](1)
        ready: chan[bool](1)
        done: chan[bool](1)
        waker
        requested_width: o.width
        requested_height: o.height
        width: o.width
        height: o.height
    })
    connect(s, o) catch {
        e => {
            close_window(s)
            fail e
        }
    }
    s
}

fn connect(s: *WindowState, o: Options) ! Error {
    s.display = wl_display_connect(null)
    if s.display == null {
        fail NoDisplay("cannot connect to the Wayland compositor named by WAYLAND_DISPLAY")
    }
    s.fd = i64(wl_display_get_fd(s.display))
    s.handle = pin(new(Handle { state: s }))
    start_keys(s)?
    s.registry = wl_display_get_registry(s.ifs, s.display)
    wl_registry_add_listener(s.ifs, s.registry, WlRegistryListener { global: on_global }, s.handle)
    for round in 0..3 {
        roundtrip(s)?
    }
    if s.compositor == null {
        fail Unsupported("the compositor does not offer wl_compositor")
    }
    if s.wm_base == null {
        fail Unsupported("the compositor does not offer xdg_wm_base")
    }
    create_toplevel(s, o)
    s.pumping = true
    spawn pump(s.fd, s.arm, s.ready, s.done)
    await_configure(s)?
}

fn roundtrip(s: *WindowState) ! Error {
    if wl_display_roundtrip(s.display) < 0 {
        fail failure("wl_display_roundtrip", display_error(s))
    }
    raise_fault(s)?
}

fn create_toplevel(s: *WindowState, o: Options) {
    s.surface = wl_compositor_create_surface(s.ifs, s.compositor)
    wl_surface_add_listener(s.ifs, s.surface, WlSurfaceListener { preferred_buffer_scale: on_scale }, s.handle)
    if s.fraction_manager != null && s.viewporter != null {
        s.viewport = wp_viewporter_get_viewport(s.ifs, s.viewporter, s.surface)
        s.fraction = wp_fractional_scale_manager_v1_get_fractional_scale(s.ifs, s.fraction_manager, s.surface)
        wp_fractional_scale_v1_add_listener(s.ifs, s.fraction, WpFractionalScaleV1Listener { preferred_scale: on_fractional_scale }, s.handle)
    }
    s.xdg_surface = xdg_wm_base_get_xdg_surface(s.ifs, s.wm_base, s.surface)
    xdg_surface_add_listener(s.ifs, s.xdg_surface, XdgSurfaceListener { configure: on_surface_configure }, s.handle)
    s.toplevel = xdg_surface_get_toplevel(s.ifs, s.xdg_surface)
    xdg_toplevel_add_listener(s.ifs, s.toplevel, XdgToplevelListener { configure: on_toplevel_configure, close_: on_toplevel_close }, s.handle)
    xdg_toplevel_set_title(s.toplevel, cstr(o.title))
    if s.decoration_manager != null {
        s.decoration = zxdg_decoration_manager_v1_get_toplevel_decoration(s.ifs, s.decoration_manager, s.toplevel)
        zxdg_toplevel_decoration_v1_add_listener(s.ifs, s.decoration, ZxdgToplevelDecorationV1Listener { configure: on_decoration_configure }, s.handle)
        let mode = if o.decorations == Decorations.Client { zxdg_toplevel_decoration_v1_mode_client_side() } else { zxdg_toplevel_decoration_v1_mode_server_side() }
        zxdg_toplevel_decoration_v1_set_mode(s.decoration, mode)
    } else {
        set_decorations(s, Decorations.Client)
    }
    wl_surface_commit(s.surface)
}

fn await_configure(s: *WindowState) ! Error {
    let deadline = now_ms() + configure_timeout_ms()
    for {
        dispatch(s)?
        if s.configured {
            return
        }
        let remaining = deadline - now_ms()
        if remaining <= 0 {
            fail Unsupported("the compositor did not configure the window")
        }
        wait_input(s, remaining)?
    }
}

fn pump(fd: i64, arm: chan[bool], ready: chan[bool], done: chan[bool]) {
    for requested in arm {
        wait_readable(fd)
        ready <- true
    }
    done <- true
}

fn next_events(s: *WindowState, timeout_ms: i64) -> []Event ! Error {
    let deadline = now_ms() + timeout_ms
    for {
        dispatch(s)?
        collect_wake(s)
        emit_repeat(s)
        if s.events.len > 0 {
            return take_events(s)
        }
        let limit = if timeout_ms < 0 { idle_wait_ms() } else { deadline - now_ms() }
        let wait = repeat_wait(s, limit)
        let woke = wait_input(s, wait)?
        let expired = timeout_ms >= 0 && now_ms() >= deadline
        if woke == Woke.Idle && expired {
            return take_events(s)
        }
    }
}

fn take_events(s: *WindowState) -> []Event {
    let out = s.events
    s.events = []
    out
}

fn collect_wake(s: *WindowState) {
    select {
        <-s.waker.signal => {
            s.events.push(Event.Woken)
        }
        else => {}
    }
}

fn raise_fault(s: *WindowState) ! Error {
    match s.fault {
        some(e) => {
            s.fault = none
            fail e
        }
        none => {}
    }
}

fn dispatch(s: *WindowState) ! Error {
    if wl_display_dispatch_pending(s.display) < 0 {
        fail failure("wl_display_dispatch_pending", display_error(s))
    }
    raise_fault(s)?
}

fn flush(s: *WindowState) ! Error {
    for attempt in 0..flush_attempts() {
        if wl_display_flush(s.display) >= 0 {
            return
        }
        let code = last_errno()
        if code != errno_again() {
            fail failure("wl_display_flush", code)
        }
        sleep(1)
    }
    fail Failed("wl_display_flush", errno_again())
}

fn wait_input(s: *WindowState, wait_ms: i64) -> Woke ! Error {
    flush(s)?
    if wl_display_prepare_read(s.display) != 0 {
        return Woke.Data
    }
    if sys.readable_now(s.fd) {
        read_events(s)?
        return Woke.Data
    }
    if wait_ms <= 0 {
        wl_display_cancel_read(s.display)
        return Woke.Idle
    }
    if !s.armed {
        s.armed = true
        s.arm <- true
    }
    let woke = select {
        <-s.ready => Woke.Data
        <-s.waker.signal => Woke.Signalled
        after(wait_ms) => Woke.Idle
    }
    match woke {
        Data => {
            s.armed = false
            read_events(s)?
        }
        Signalled => {
            wl_display_cancel_read(s.display)
            s.events.push(Event.Woken)
        }
        Idle => {
            wl_display_cancel_read(s.display)
        }
    }
    woke
}

fn read_events(s: *WindowState) ! Error {
    if wl_display_read_events(s.display) < 0 {
        fail failure("wl_display_read_events", display_error(s))
    }
}

fn last_errno() -> i64 {
    i64(load(errno_location()))
}

fn display_error(s: *WindowState) -> i64 {
    let code = wl_display_get_error(s.display)
    if code != 0 {
        return i64(code)
    }
    last_errno()
}

fn failure(call: str, code: i64) -> Error {
    if code == errno_pipe() || code == errno_reset() {
        return Error.Disconnected
    }
    Error.Failed(call, code)
}

fn window_waker(s: *WindowState) -> *WakerState {
    s.waker
}

fn wake_window(k: *WakerState) {
    select {
        k.signal <- true => {}
        else => {}
    }
}

fn set_window_cursor(s: *WindowState, c: Cursor) {
    if c == s.cursor {
        return
    }
    s.cursor = c
    if show_cursor(s) {
        wl_display_flush(s.display)
    }
}

fn show_cursor(s: *WindowState) -> bool {
    if !s.pointer_inside || s.pointer == null {
        return false
    }
    if s.cursor == Cursor.Hidden {
        wl_pointer_set_cursor(s.pointer, s.enter_serial, null, 0, 0)
        return true
    }
    if s.cursor_device == null && s.cursor_manager != null {
        s.cursor_device = wp_cursor_shape_manager_v1_get_pointer(s.ifs, s.cursor_manager, s.pointer)
    }
    if s.cursor_device == null {
        return false
    }
    wp_cursor_shape_device_v1_set_shape(s.cursor_device, s.enter_serial, cursor_shape(s.cursor))
    true
}

fn cursor_shape(c: Cursor) -> u32 {
    match c {
        Arrow => wp_cursor_shape_device_v1_shape_default()
        Text => wp_cursor_shape_device_v1_shape_text()
        VerticalText => wp_cursor_shape_device_v1_shape_vertical_text()
        Pointer => wp_cursor_shape_device_v1_shape_pointer()
        Crosshair => wp_cursor_shape_device_v1_shape_crosshair()
        Grab => wp_cursor_shape_device_v1_shape_grab()
        Grabbing => wp_cursor_shape_device_v1_shape_grabbing()
        NotAllowed => wp_cursor_shape_device_v1_shape_not_allowed()
        Copy => wp_cursor_shape_device_v1_shape_copy()
        Alias => wp_cursor_shape_device_v1_shape_alias()
        ContextMenu => wp_cursor_shape_device_v1_shape_context_menu()
        Move => wp_cursor_shape_device_v1_shape_move()
        Wait => wp_cursor_shape_device_v1_shape_wait()
        Progress => wp_cursor_shape_device_v1_shape_progress()
        Help => wp_cursor_shape_device_v1_shape_help()
        ResizeLeft => wp_cursor_shape_device_v1_shape_w_resize()
        ResizeRight => wp_cursor_shape_device_v1_shape_e_resize()
        ResizeUp => wp_cursor_shape_device_v1_shape_n_resize()
        ResizeDown => wp_cursor_shape_device_v1_shape_s_resize()
        ResizeLeftRight => wp_cursor_shape_device_v1_shape_ew_resize()
        ResizeUpDown => wp_cursor_shape_device_v1_shape_ns_resize()
        ResizeUpLeftDownRight => wp_cursor_shape_device_v1_shape_nwse_resize()
        ResizeUpRightDownLeft => wp_cursor_shape_device_v1_shape_nesw_resize()
        ResizeColumn => wp_cursor_shape_device_v1_shape_col_resize()
        ResizeRow => wp_cursor_shape_device_v1_shape_row_resize()
        Hidden => wp_cursor_shape_device_v1_shape_default()
    }
}

fn window_native(s: *WindowState) -> Native {
    Native { display: s.display, window: s.surface }
}

fn close_window(s: *WindowState) {
    stop_pump(s)
    release_clipboard(s)
    release_text_input(s)
    if s.keyboard != null {
        release_keyboard(s.keyboard)
    }
    if s.cursor_device != null {
        wp_cursor_shape_device_v1_destroy(s.cursor_device)
    }
    if s.cursor_manager != null {
        wp_cursor_shape_manager_v1_destroy(s.cursor_manager)
    }
    if s.pointer != null {
        release_pointer(s.pointer)
    }
    if s.decoration != null {
        zxdg_toplevel_decoration_v1_destroy(s.decoration)
    }
    if s.fraction != null {
        wp_fractional_scale_v1_destroy(s.fraction)
    }
    if s.fraction_manager != null {
        wp_fractional_scale_manager_v1_destroy(s.fraction_manager)
    }
    if s.viewport != null {
        wp_viewport_destroy(s.viewport)
    }
    if s.viewporter != null {
        wp_viewporter_destroy(s.viewporter)
    }
    if s.decoration_manager != null {
        zxdg_decoration_manager_v1_destroy(s.decoration_manager)
    }
    if s.toplevel != null {
        xdg_toplevel_destroy(s.toplevel)
    }
    if s.xdg_surface != null {
        xdg_surface_destroy(s.xdg_surface)
    }
    if s.surface != null {
        wl_surface_destroy(s.surface)
    }
    if s.seat != null {
        release_seat(s.seat)
    }
    if s.wm_base != null {
        xdg_wm_base_destroy(s.wm_base)
    }
    if s.compositor != null {
        wl_compositor_destroy(s.compositor)
    }
    if s.registry != null {
        wl_registry_destroy(s.registry)
    }
    if s.display != null {
        wl_display_flush(s.display)
        wl_display_disconnect(s.display)
    }
    stop_keys(s)
    release_interfaces(s.ifs)
    if s.handle != null {
        unpin(s.handle)
    }
    s.keyboard = null
    s.cursor_device = null
    s.cursor_manager = null
    s.decoration = null
    s.decoration_manager = null
    s.pointer = null
    s.toplevel = null
    s.xdg_surface = null
    s.surface = null
    s.seat = null
    s.wm_base = null
    s.compositor = null
    s.registry = null
    s.display = null
    s.handle = null
}

fn stop_pump(s: *WindowState) {
    if !s.pumping {
        return
    }
    s.pumping = false
    close(s.arm)
    if s.armed {
        sys.shutdown(s.fd, sys.Shutdown.Both) or {}
    }
    select {
        <-s.done => {}
        after(stop_timeout_ms()) => {}
    }
}
