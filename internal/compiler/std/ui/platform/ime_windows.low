extern "imm32" {
    fn ImmGetContext(hwnd: ptr) -> ptr
    fn ImmReleaseContext(hwnd: ptr, himc: ptr) -> i32
    fn ImmGetCompositionStringW(himc: ptr, index: u32, buffer: ptr, length: u32) -> i32
    fn ImmSetCompositionWindow(himc: ptr, mut form: CompositionForm) -> i32
    fn ImmSetCandidateWindow(himc: ptr, mut form: CandidateForm) -> i32
    fn ImmAssociateContextEx(hwnd: ptr, himc: ptr, flags: u32) -> i32
}

extern struct Point {
    x: i32 = 0
    y: i32 = 0
}

extern struct CompositionForm {
    style: u32 = 0
    position: Point = Point {}
    area: Rect = Rect {}
}

extern struct CandidateForm {
    index: u32 = 0
    style: u32 = 0
    position: Point = Point {}
    area: Rect = Rect {}
}

fn wm_ime_startcomposition() -> u32 {
    0x10D
}

fn wm_ime_endcomposition() -> u32 {
    0x10E
}

fn wm_ime_composition() -> u32 {
    0x10F
}

fn gcs_compstr() -> i64 {
    0x8
}

fn gcs_cursorpos() -> i64 {
    0x80
}

fn gcs_resultstr() -> i64 {
    0x800
}

fn cfs_point() -> u32 {
    0x2
}

fn cfs_exclude() -> u32 {
    0x80
}

fn iace_default() -> u32 {
    0x10
}

fn set_window_text_input(s: *WindowState, caret: Caret?) {
    if s.hwnd == null {
        return
    }
    match caret {
        some(c) => {
            if s.text_input && s.caret == c {
                return
            }
            if !s.text_input {
                s.text_input = ImmAssociateContextEx(s.hwnd, null, iace_default()) != 0
            }
            s.caret = c
            place_caret(s)
        }
        none => {
            if s.text_input {
                ImmAssociateContextEx(s.hwnd, null, 0)
                s.text_input = false
                end_preedit(s)
            }
        }
    }
}

fn place_caret(s: *WindowState) {
    if !s.text_input || s.hwnd == null {
        return
    }
    let himc = ImmGetContext(s.hwnd)
    if himc == null {
        return
    }
    let left = i32(device_pixels(s.caret.x, s.scale))
    let top = i32(device_pixels(s.caret.y, s.scale))
    let right = i32(device_pixels(s.caret.x + s.caret.width, s.scale))
    let bottom = i32(device_pixels(s.caret.y + s.caret.height, s.scale))
    var composition = CompositionForm { style: cfs_point(), position: Point { x: left, y: bottom } }
    ImmSetCompositionWindow(himc, mut composition)
    var candidate = CandidateForm { style: cfs_exclude(), position: Point { x: left, y: bottom }, area: Rect { left, top, right, bottom } }
    ImmSetCandidateWindow(himc, mut candidate)
    ImmReleaseContext(s.hwnd, himc)
}

fn end_preedit(s: *WindowState) {
    if s.preedit.len > 0 {
        s.preedit = ""
        s.events.push(Event.Preedit("", none))
    }
}

fn composition_changed(s: *WindowState, hwnd: ptr, flags: i64) {
    let himc = ImmGetContext(hwnd)
    if himc == null {
        return
    }
    if flags & gcs_resultstr() != 0 {
        let text = narrow(composition_units(himc, gcs_resultstr()))
        if text.len > 0 {
            s.preedit = ""
            s.events.push(Event.Commit(text))
        }
    }
    if flags & gcs_compstr() != 0 {
        report_preedit(s, himc)
    }
    ImmReleaseContext(hwnd, himc)
}

fn report_preedit(s: *WindowState, himc: ptr) {
    let units = composition_units(himc, gcs_compstr())
    let text = narrow(units)
    if text.len == 0 {
        end_preedit(s)
        return
    }
    s.preedit = text
    let position = ImmGetCompositionStringW(himc, u32(gcs_cursorpos()), null, 0)
    if position < 0 || i64(position) > units.len {
        s.events.push(Event.Preedit(text, none))
        return
    }
    let offset = narrow(units[..unit_boundary(units, i64(position))]).len
    s.events.push(Event.Preedit(text, some(TextRange { start: offset, end: offset })))
}

fn unit_boundary(units: []u16, at: i64) -> i64 {
    if at > 0 && at < units.len && i64(units[at - 1]) >= 0xD800 && i64(units[at - 1]) <= 0xDBFF {
        return at - 1
    }
    at
}

fn composition_units(himc: ptr, index: i64) -> []u16 {
    let bytes = ImmGetCompositionStringW(himc, u32(index), null, 0)
    if bytes <= 0 {
        return []
    }
    let units: []u16 = __make(i64(bytes) / 2)
    let read = ImmGetCompositionStringW(himc, u32(index), __slice_ptr(units), u32(bytes))
    if read < 0 {
        return []
    }
    units[..min_of(i64(read) / 2, units.len)]
}
