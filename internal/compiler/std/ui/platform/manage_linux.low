extern struct WlArray {
    size: u64 = 0
    alloc: u64 = 0
    data: ptr = null
}

fn on_decoration_configure(data: ptr, decoration: ptr, mode: u32) {
    let s = window_of(data)
    let drawn = if mode == zxdg_toplevel_decoration_v1_mode_server_side() { Decorations.Server } else { Decorations.Client }
    set_decorations(s, drawn)
}

fn set_decorations(s: *WindowState, drawn: Decorations) {
    if drawn == s.decorations {
        return
    }
    s.decorations = drawn
    s.events.push(Event.DecorationsChanged(drawn))
}

fn status_of(states: ptr) -> WindowStatus {
    var out = WindowStatus {}
    if states == null {
        return out
    }
    let at: ptr[WlArray] = states
    let array = load(at)
    if array.data == null {
        return out
    }
    let words: ptr[u32] = array.data
    for state in view(words, i64(array.size) / 4) {
        if state == xdg_toplevel_state_maximized() {
            out.maximized = true
        } else if state == xdg_toplevel_state_fullscreen() {
            out.fullscreen = true
        } else if is_tiled(state) {
            out.tiled = true
        }
    }
    out
}

fn is_tiled(state: u32) -> bool {
    state == xdg_toplevel_state_tiled_left() || state == xdg_toplevel_state_tiled_right() || state == xdg_toplevel_state_tiled_top() || state == xdg_toplevel_state_tiled_bottom()
}

fn apply_status(s: *WindowState) {
    if s.pending_status == s.status {
        return
    }
    s.status = s.pending_status
    s.events.push(Event.StatusChanged(s.status))
}

fn window_decorations(s: *WindowState) -> Decorations {
    s.decorations
}

fn window_status(s: *WindowState) -> WindowStatus {
    s.status
}

fn start_window_move(s: *WindowState) {
    if s.toplevel == null || s.seat == null {
        return
    }
    xdg_toplevel_move(s.toplevel, s.seat, s.press_serial)
    flush(s) or {}
}

fn start_window_resize(s: *WindowState, edge: ResizeEdge) {
    if s.toplevel == null || s.seat == null {
        return
    }
    xdg_toplevel_resize(s.toplevel, s.seat, s.press_serial, resize_edge(edge))
    flush(s) or {}
}

fn resize_edge(edge: ResizeEdge) -> u32 {
    match edge {
        Top => xdg_toplevel_resize_edge_top()
        Bottom => xdg_toplevel_resize_edge_bottom()
        Left => xdg_toplevel_resize_edge_left()
        Right => xdg_toplevel_resize_edge_right()
        TopLeft => xdg_toplevel_resize_edge_top_left()
        TopRight => xdg_toplevel_resize_edge_top_right()
        BottomLeft => xdg_toplevel_resize_edge_bottom_left()
        BottomRight => xdg_toplevel_resize_edge_bottom_right()
    }
}

fn show_menu(s: *WindowState, x: f32, y: f32) {
    if s.toplevel == null || s.seat == null {
        return
    }
    xdg_toplevel_show_window_menu(s.toplevel, s.seat, s.press_serial, i32(x), i32(y))
    flush(s) or {}
}

fn set_window_maximized(s: *WindowState, maximized: bool) {
    if s.toplevel == null {
        return
    }
    if maximized {
        xdg_toplevel_set_maximized(s.toplevel)
    } else {
        xdg_toplevel_unset_maximized(s.toplevel)
    }
    flush(s) or {}
}

fn set_window_fullscreen(s: *WindowState, fullscreen: bool) {
    if s.toplevel == null {
        return
    }
    if fullscreen {
        xdg_toplevel_set_fullscreen(s.toplevel, null)
    } else {
        xdg_toplevel_unset_fullscreen(s.toplevel)
    }
    flush(s) or {}
}

fn minimize_window(s: *WindowState) {
    if s.toplevel == null {
        return
    }
    xdg_toplevel_set_minimized(s.toplevel)
    flush(s) or {}
}

fn set_window_title(s: *WindowState, title: str) {
    if s.toplevel == null {
        return
    }
    xdg_toplevel_set_title(s.toplevel, cstr(title))
    flush(s) or {}
}
