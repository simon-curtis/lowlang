fn wm_nclbuttondown() -> u32 {
    0xA1
}

fn wm_syscommand() -> u32 {
    0x112
}

fn size_restored() -> i64 {
    0
}

fn size_maximized() -> i64 {
    2
}

fn htcaption() -> i64 {
    2
}

fn gwl_style() -> i32 {
    -16
}

fn sw_maximize() -> i32 {
    3
}

fn sw_minimize() -> i32 {
    6
}

fn sw_restore() -> i32 {
    9
}

fn swp_framechanged() -> u32 {
    0x20
}

fn swp_noownerzorder() -> u32 {
    0x200
}

fn tpm_rightbutton() -> u32 {
    0x2
}

fn tpm_returncmd() -> u32 {
    0x100
}

fn monitor_defaulttonearest() -> u32 {
    2
}

fn wm_nccalcsize() -> u32 {
    0x83
}

fn wm_nchittest() -> u32 {
    0x84
}

fn sm_cxsizeframe() -> i32 {
    32
}

fn sm_cxpaddedborder() -> i32 {
    92
}

fn window_decorations(s: *WindowState) -> Decorations {
    if s.frameless { Decorations.Client } else { Decorations.Server }
}

fn frame_thickness(hwnd: ptr) -> i32 {
    let dpi = GetDpiForWindow(hwnd)
    GetSystemMetricsForDpi(sm_cxsizeframe(), dpi) + GetSystemMetricsForDpi(sm_cxpaddedborder(), dpi)
}

fn client_area(hwnd: ptr, msg: u32, wparam: i64, lparam: i64) -> i64 {
    if wparam == 0 {
        return DefWindowProcW(hwnd, msg, wparam, lparam)
    }
    if IsZoomed(hwnd) != 0 {
        let proposed: ptr[Rect] = ptr(lparam)
        let r = load(proposed)
        let edge = frame_thickness(hwnd)
        store(proposed, Rect { left: r.left + edge, top: r.top + edge, right: r.right - edge, bottom: r.bottom - edge })
    }
    0
}

fn frame_hit(hwnd: ptr, lparam: i64) -> i64 {
    if IsZoomed(hwnd) != 0 {
        return ht_client()
    }
    var r = Rect {}
    if GetWindowRect(hwnd, mut r) == 0 {
        return ht_client()
    }
    let x = signed_word(lparam)
    let y = signed_word(lparam >> 16)
    let edge = i64(frame_thickness(hwnd))
    let top = y < i64(r.top) + edge
    let bottom = y >= i64(r.bottom) - edge
    let left = x < i64(r.left) + edge
    let right = x >= i64(r.right) - edge
    if top && left {
        return edge_hit(TopLeft)
    }
    if top && right {
        return edge_hit(TopRight)
    }
    if bottom && left {
        return edge_hit(BottomLeft)
    }
    if bottom && right {
        return edge_hit(BottomRight)
    }
    if top {
        return edge_hit(Top)
    }
    if bottom {
        return edge_hit(Bottom)
    }
    if left {
        return edge_hit(Left)
    }
    if right {
        return edge_hit(Right)
    }
    ht_client()
}

fn window_status(s: *WindowState) -> WindowStatus {
    s.status
}

fn push_status(s: *WindowState, status: WindowStatus) {
    if status != s.status {
        s.status = status
        s.events.push(StatusChanged(status))
    }
}

fn size_changed(s: *WindowState, kind: i64) {
    if kind == size_maximized() {
        push_status(s, WindowStatus { maximized: true, fullscreen: s.status.fullscreen })
    } else if kind == size_restored() {
        push_status(s, WindowStatus { maximized: false, fullscreen: s.status.fullscreen })
    }
}

fn start_window_move(s: *WindowState) {
    drag_window(s, htcaption())
}

fn start_window_resize(s: *WindowState, edge: ResizeEdge) {
    drag_window(s, edge_hit(edge))
}

fn edge_hit(edge: ResizeEdge) -> i64 {
    match edge {
        Left => 10
        Right => 11
        Top => 12
        TopLeft => 13
        TopRight => 14
        Bottom => 15
        BottomLeft => 16
        BottomRight => 17
    }
}

fn drag_window(s: *WindowState, hit: i64) {
    if s.hwnd == null {
        return
    }
    var at = Point {}
    if GetCursorPos(mut at) == 0 {
        record_fault(s, "GetCursorPos")
        return
    }
    ReleaseCapture()
    s.buttons = 0
    let packed = ((i64(at.y) & 0xFFFF) << 16) | (i64(at.x) & 0xFFFF)
    SendMessageW(s.hwnd, wm_nclbuttondown(), hit, packed)
}

fn device_pixel(logical: f32, scale: f32) -> i32 {
    i32(floor(logical * scale + 0.5))
}

fn show_menu(s: *WindowState, x: f32, y: f32) {
    if s.hwnd == null {
        return
    }
    let menu = GetSystemMenu(s.hwnd, 0)
    if menu == null {
        record_fault(s, "GetSystemMenu")
        return
    }
    var at = Point { x: device_pixel(x, s.scale), y: device_pixel(y, s.scale) }
    if ClientToScreen(s.hwnd, mut at) == 0 {
        record_fault(s, "ClientToScreen")
        return
    }
    let command = TrackPopupMenu(menu, tpm_returncmd() | tpm_rightbutton(), at.x, at.y, 0, s.hwnd, null)
    if command != 0 {
        PostMessageW(s.hwnd, wm_syscommand(), i64(command), 0)
    }
}

fn set_window_maximized(s: *WindowState, maximized: bool) {
    if s.hwnd == null {
        return
    }
    let command = if maximized { sw_maximize() } else { sw_restore() }
    ShowWindow(s.hwnd, command)
}

fn minimize_window(s: *WindowState) {
    if s.hwnd == null {
        return
    }
    ShowWindow(s.hwnd, sw_minimize())
}

fn set_window_fullscreen(s: *WindowState, fullscreen: bool) {
    if s.hwnd == null || s.status.fullscreen == fullscreen {
        return
    }
    if fullscreen {
        enter_fullscreen(s)
    } else {
        leave_fullscreen(s)
    }
}

fn enter_fullscreen(s: *WindowState) {
    let style = GetWindowLongPtrW(s.hwnd, gwl_style())
    var saved = Rect {}
    if GetWindowRect(s.hwnd, mut saved) == 0 {
        record_fault(s, "GetWindowRect")
        return
    }
    let monitor = MonitorFromWindow(s.hwnd, monitor_defaulttonearest())
    var info = MonitorInfo {}
    if monitor == null || GetMonitorInfoW(monitor, mut info) == 0 {
        record_fault(s, "GetMonitorInfoW")
        return
    }
    s.saved_style = style
    s.saved_rect = saved
    SetWindowLongPtrW(s.hwnd, gwl_style(), ptr(i64(style) & ~i64(ws_overlappedwindow())))
    place_window(s, info.monitor)
    push_status(s, WindowStatus { maximized: s.status.maximized, fullscreen: true })
}

fn leave_fullscreen(s: *WindowState) {
    SetWindowLongPtrW(s.hwnd, gwl_style(), s.saved_style)
    place_window(s, s.saved_rect)
    push_status(s, WindowStatus { maximized: s.status.maximized, fullscreen: false })
}

fn place_window(s: *WindowState, area: Rect) {
    let flags = swp_framechanged() | swp_noownerzorder() | swp_nozorder()
    if SetWindowPos(s.hwnd, null, area.left, area.top, area.right - area.left, area.bottom - area.top, flags) == 0 {
        record_fault(s, "SetWindowPos")
    }
}

fn set_window_title(s: *WindowState, title: str) {
    if s.hwnd == null {
        return
    }
    let text = wide(title)
    if SetWindowTextW(s.hwnd, __slice_ptr(text)) == 0 {
        record_fault(s, "SetWindowTextW")
    }
}
