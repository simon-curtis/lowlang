import std/sys

fn clipboard_read_ms() -> i64 {
    1000
}

fn text_types() -> []str {
    ["text/plain;charset=utf-8", "UTF8_STRING", "text/plain", "TEXT", "STRING"]
}

fn text_rank(mime: str) -> i64 {
    for i, t in text_types() {
        if t == mime {
            return i
        }
    }
    -1
}

fn ensure_data_device(s: *WindowState) {
    if s.data_device != null || s.data_manager == null || s.seat == null {
        return
    }
    s.data_device = wl_data_device_manager_get_data_device(s.ifs, s.data_manager, s.seat)
    wl_data_device_add_listener(s.ifs, s.data_device, WlDataDeviceListener { data_offer: on_data_offer, selection: on_selection }, s.handle)
}

fn on_data_offer(data: ptr, device: ptr, offer: ptr) {
    let s = window_of(data)
    forget_incoming(s)
    s.incoming = offer
    s.incoming_type = ""
    wl_data_offer_add_listener(s.ifs, offer, WlDataOfferListener { offer: on_offer_type }, data)
}

fn on_offer_type(data: ptr, offer: ptr, mime: ptr[u8]) {
    let s = window_of(data)
    if offer != s.incoming {
        return
    }
    let rank = text_rank(str(mime))
    if rank >= 0 && (s.incoming_type == "" || rank < text_rank(s.incoming_type)) {
        s.incoming_type = str(mime)
    }
}

fn on_selection(data: ptr, device: ptr, offer: ptr) {
    let s = window_of(data)
    if s.selection != null && s.selection != offer {
        wl_data_offer_destroy(s.selection)
    }
    s.selection = offer
    s.selection_type = ""
    if offer != null && offer == s.incoming {
        s.selection_type = s.incoming_type
        s.incoming = null
    }
}

fn forget_incoming(s: *WindowState) {
    if s.incoming != null && s.incoming != s.selection {
        wl_data_offer_destroy(s.incoming)
    }
    s.incoming = null
}

fn on_source_send(data: ptr, source: ptr, mime: ptr[u8], fd: i32) {
    let s = window_of(data)
    if source == s.source {
        sys.write_all(i64(fd), bytes(s.source_text)) or {}
    }
    sys.close_fd(i64(fd))
}

fn on_source_cancelled(data: ptr, source: ptr) {
    let s = window_of(data)
    wl_data_source_destroy(source)
    if source == s.source {
        s.source = null
        s.source_text = ""
    }
}

fn write_window_clipboard(s: *WindowState, text: str) ! Error {
    if s.display == null {
        fail Disconnected
    }
    ensure_data_device(s)
    if s.data_device == null {
        fail Unsupported("the compositor offers no wl_data_device_manager or seat")
    }
    let source = wl_data_device_manager_create_data_source(s.ifs, s.data_manager)
    for t in text_types() {
        wl_data_source_offer(source, cstr(t))
    }
    wl_data_source_add_listener(s.ifs, source, WlDataSourceListener { send: on_source_send, cancelled: on_source_cancelled }, s.handle)
    wl_data_device_set_selection(s.data_device, source, s.input_serial)
    if s.source != null {
        wl_data_source_destroy(s.source)
    }
    s.source = source
    s.source_text = text
    flush(s)?
}

fn read_window_clipboard(s: *WindowState) -> str? ! Error {
    if s.display == null {
        fail Disconnected
    }
    if s.source != null {
        return s.source_text
    }
    if s.selection == null || s.selection_type == "" {
        return none
    }
    let ends = sys.pipe(true) catch {
        e => fail Failed("pipe", 0)
    }
    wl_data_offer_receive(s.selection, cstr(s.selection_type), i32(ends.second))
    sys.close_fd(ends.second)
    flush(s) catch {
        e => {
            sys.close_fd(ends.first)
            fail e
        }
    }
    let got = drain_pipe(ends.first)
    sys.close_fd(ends.first)
    got
}

fn drain_pipe(fd: i64) -> str {
    let deadline = now_ms() + clipboard_read_ms()
    var out: []u8 = []
    var buf: []u8 = []
    for _ in 0..4096 {
        buf.push(0)
    }
    for now_ms() < deadline {
        let n = sys.try_read(fd, buf) catch {
            WouldBlock => -1
            e => return str(out)
        }
        if n == 0 {
            return str(out)
        }
        if n < 0 {
            sleep(1)
            continue
        }
        for b in buf[..n] {
            out.push(b)
        }
    }
    str(out)
}

fn release_clipboard(s: *WindowState) {
    forget_incoming(s)
    if s.selection != null {
        wl_data_offer_destroy(s.selection)
    }
    if s.source != null {
        wl_data_source_destroy(s.source)
    }
    if s.data_device != null {
        if wl_proxy_get_version(s.data_device) >= 2 {
            wl_data_device_release(s.data_device)
        } else {
            wl_data_device_destroy(s.data_device)
        }
    }
    if s.data_manager != null {
        wl_data_device_manager_destroy(s.data_manager)
    }
    s.selection = null
    s.source = null
    s.data_device = null
    s.data_manager = null
}
