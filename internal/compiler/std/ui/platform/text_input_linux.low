fn ensure_text_input(s: *WindowState) {
    if s.text_input != null || s.text_manager == null || s.seat == null {
        return
    }
    s.text_input = zwp_text_input_manager_v3_get_text_input(s.ifs, s.text_manager, s.seat)
    let listener = ZwpTextInputV3Listener {
        enter: on_text_enter
        leave: on_text_leave
        preedit_string: on_preedit_string
        commit_string: on_commit_string
        done: on_text_done
    }
    zwp_text_input_v3_add_listener(s.ifs, s.text_input, listener, s.handle)
}

fn on_text_enter(data: ptr, text_input: ptr, surface: ptr) {
    let s = window_of(data)
    if surface != s.surface {
        return
    }
    s.text_entered = true
    s.text_enabled = false
    apply_text_input(s)
}

fn on_text_leave(data: ptr, text_input: ptr, surface: ptr) {
    let s = window_of(data)
    s.text_entered = false
    s.text_enabled = false
    if s.preedit != "" {
        s.preedit = ""
        s.events.push(Event.Preedit("", none))
    }
}

fn on_preedit_string(data: ptr, text_input: ptr, text: ptr[u8], cursor_begin: i32, cursor_end: i32) {
    let s = window_of(data)
    s.pending_preedit = if text == null { "" } else { str(text) }
    s.pending_cursor = if cursor_begin < 0 || cursor_end < 0 { none } else { TextRange { start: i64(cursor_begin), end: i64(cursor_end) } }
}

fn on_commit_string(data: ptr, text_input: ptr, text: ptr[u8]) {
    let s = window_of(data)
    s.pending_commit = if text == null { "" } else { str(text) }
}

fn on_text_done(data: ptr, text_input: ptr, serial: u32) {
    let s = window_of(data)
    if s.pending_commit != "" {
        s.events.push(Event.Commit(s.pending_commit))
    }
    if s.pending_preedit != "" || s.preedit != "" {
        s.events.push(Event.Preedit(s.pending_preedit, s.pending_cursor))
    }
    s.preedit = s.pending_preedit
    s.pending_preedit = ""
    s.pending_cursor = none
    s.pending_commit = ""
}

fn set_window_text_input(s: *WindowState, caret: Caret?) {
    if s.caret == caret {
        return
    }
    s.caret = caret
    apply_text_input(s)
}

fn apply_text_input(s: *WindowState) {
    if s.text_input == null || !s.text_entered {
        return
    }
    match s.caret {
        some(c) => {
            if !s.text_enabled {
                zwp_text_input_v3_enable(s.text_input)
                zwp_text_input_v3_set_content_type(s.text_input, zwp_text_input_v3_content_hint_none(), zwp_text_input_v3_content_purpose_normal())
                s.text_enabled = true
            }
            zwp_text_input_v3_set_cursor_rectangle(s.text_input, i32(c.x), i32(c.y), i32(c.width), i32(c.height))
            zwp_text_input_v3_commit(s.text_input)
        }
        none => {
            if s.text_enabled {
                zwp_text_input_v3_disable(s.text_input)
                zwp_text_input_v3_commit(s.text_input)
                s.text_enabled = false
            }
        }
    }
}

fn release_text_input(s: *WindowState) {
    if s.text_input != null {
        zwp_text_input_v3_destroy(s.text_input)
    }
    if s.text_manager != null {
        zwp_text_input_manager_v3_destroy(s.text_manager)
    }
    s.text_input = null
    s.text_manager = null
}
