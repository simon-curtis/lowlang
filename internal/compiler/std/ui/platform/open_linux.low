import std/io
import signals = std/os/signal
import std/process

fn launch(url: str) ! Error {
    if process.find("xdg-open") == none {
        fail Unsupported("xdg-open")
    }
    var c = process.command("sh", ["-c", "xdg-open \"$1\" &", "sh", url])
    c.stdin = Null
    c.stdout = Null
    c.stderr = Null
    let child = process.start_handle(c) catch {
        e => fail launch_failure(e)
    }
    let exit = process.wait_on(child) catch {
        e => fail launch_failure(e)
    }
    match exit {
        Exited(code) => {
            if code != 0 {
                fail Failed("sh", code)
            }
        }
        Signaled(signal) => fail Failed("sh", signals.number(signal))
    }
}

fn launch_failure(e: io.Error) -> Error {
    match e {
        NotFound => Unsupported("sh")
        Os(code) => Failed("fork", code)
        _ => Failed("fork", 0)
    }
}
