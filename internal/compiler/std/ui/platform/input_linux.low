import std/sys

fn window_of(data: ptr) -> *WindowState {
    let at: ptr[Handle] = data
    load(at).state
}

fn at_most(version: u32, limit: u32) -> u32 {
    if version < limit {
        return version
    }
    limit
}

fn fixed_to_f32(value: i32) -> f32 {
    f32(value) / 256.0
}

fn on_global(data: ptr, registry: ptr, name: u32, interface: ptr[u8], version: u32) {
    let s = window_of(data)
    let kind = str(interface)
    if kind == "wl_compositor" {
        s.compositor = wl_registry_bind(registry, name, s.ifs.wl_compositor, at_most(version, 6))
    } else if kind == "xdg_wm_base" {
        s.wm_base = wl_registry_bind(registry, name, s.ifs.xdg_wm_base, at_most(version, 6))
        xdg_wm_base_add_listener(s.ifs, s.wm_base, XdgWmBaseListener { ping: on_ping }, data)
    } else if kind == "wl_seat" && s.seat == null {
        s.seat = wl_registry_bind(registry, name, s.ifs.wl_seat, at_most(version, 9))
        wl_seat_add_listener(s.ifs, s.seat, WlSeatListener { capabilities: on_capabilities }, data)
    }
}

fn on_ping(data: ptr, wm_base: ptr, serial: u32) {
    let s = window_of(data)
    xdg_wm_base_pong(wm_base, serial)
    wl_display_flush(s.display)
}

fn on_capabilities(data: ptr, seat: ptr, capabilities: u32) {
    let s = window_of(data)
    let has_pointer = capabilities & wl_seat_capability_pointer() != 0
    let has_keyboard = capabilities & wl_seat_capability_keyboard() != 0
    if has_pointer && s.pointer == null {
        s.pointer = wl_seat_get_pointer(s.ifs, seat)
        let listener = WlPointerListener {
            enter: on_pointer_enter
            leave: on_pointer_leave
            motion: on_pointer_motion
            button: on_pointer_button
            axis: on_pointer_axis
        }
        wl_pointer_add_listener(s.ifs, s.pointer, listener, data)
    }
    if !has_pointer && s.pointer != null {
        release_pointer(s.pointer)
        s.pointer = null
    }
    if has_keyboard && s.keyboard == null {
        s.keyboard = wl_seat_get_keyboard(s.ifs, seat)
        let listener = WlKeyboardListener {
            keymap: on_keymap
            enter: on_keyboard_enter
            leave: on_keyboard_leave
            key: on_key
            modifiers: on_modifiers
            repeat_info: on_repeat_info
        }
        wl_keyboard_add_listener(s.ifs, s.keyboard, listener, data)
    }
    if !has_keyboard && s.keyboard != null {
        release_keyboard(s.keyboard)
        s.keyboard = null
        s.repeat.active = false
    }
}

fn release_pointer(pointer: ptr) {
    if wl_proxy_get_version(pointer) >= 3 {
        wl_pointer_release(pointer)
    } else {
        wl_pointer_destroy(pointer)
    }
}

fn release_keyboard(keyboard: ptr) {
    if wl_proxy_get_version(keyboard) >= 3 {
        wl_keyboard_release(keyboard)
    } else {
        wl_keyboard_destroy(keyboard)
    }
}

fn release_seat(seat: ptr) {
    if wl_proxy_get_version(seat) >= 5 {
        wl_seat_release(seat)
    } else {
        wl_seat_destroy(seat)
    }
}

fn on_scale(data: ptr, surface: ptr, factor: i32) {
    let s = window_of(data)
    if apply_scale(s, factor) {
        wl_surface_set_buffer_scale(s.surface, i32(s.scale))
    }
}

fn apply_scale(s: *WindowState, factor: i32) -> bool {
    let scale = if factor >= 1 { i64(factor) } else { 1 }
    if scale == s.scale {
        return false
    }
    s.scale = scale
    if s.configured {
        s.events.push(Event.Resized(s.width, s.height, s.scale))
    }
    true
}

fn on_toplevel_configure(data: ptr, toplevel: ptr, width: i32, height: i32, states: ptr) {
    let s = window_of(data)
    s.pending_width = i64(width)
    s.pending_height = i64(height)
}

fn on_toplevel_close(data: ptr, toplevel: ptr) {
    let s = window_of(data)
    s.events.push(Event.CloseRequested)
}

fn on_surface_configure(data: ptr, xdg_surface: ptr, serial: u32) {
    let s = window_of(data)
    xdg_surface_ack_configure(xdg_surface, serial)
    apply_configure(s)
}

fn apply_configure(s: *WindowState) {
    let width = if s.pending_width > 0 { s.pending_width } else { s.width }
    let height = if s.pending_height > 0 { s.pending_height } else { s.height }
    let changed = !s.configured || width != s.width || height != s.height
    s.width = width
    s.height = height
    s.configured = true
    if changed {
        s.events.push(Event.Resized(width, height, s.scale))
    }
}

fn on_pointer_enter(data: ptr, pointer: ptr, serial: u32, surface: ptr, x: i32, y: i32) {
    let s = window_of(data)
    s.pointer_x = fixed_to_f32(x)
    s.pointer_y = fixed_to_f32(y)
    s.events.push(Event.PointerMoved(s.pointer_x, s.pointer_y))
}

fn on_pointer_leave(data: ptr, pointer: ptr, serial: u32, surface: ptr) {
    let s = window_of(data)
    s.events.push(Event.PointerLeft)
}

fn on_pointer_motion(data: ptr, pointer: ptr, time: u32, x: i32, y: i32) {
    let s = window_of(data)
    s.pointer_x = fixed_to_f32(x)
    s.pointer_y = fixed_to_f32(y)
    s.events.push(Event.PointerMoved(s.pointer_x, s.pointer_y))
}

fn on_pointer_button(data: ptr, pointer: ptr, serial: u32, time: u32, button: u32, state: u32) {
    let s = window_of(data)
    let which = pointer_button(button)
    if state == wl_pointer_button_state_pressed() {
        s.events.push(Event.PointerDown(which, s.pointer_x, s.pointer_y))
    } else {
        s.events.push(Event.PointerUp(which, s.pointer_x, s.pointer_y))
    }
}

fn pointer_button(code: u32) -> Button {
    match code {
        0x110 => Button.Left
        0x111 => Button.Right
        0x112 => Button.Middle
        _ => Button.Other(i64(code))
    }
}

fn on_pointer_axis(data: ptr, pointer: ptr, time: u32, axis: u32, value: i32) {
    let s = window_of(data)
    let amount = fixed_to_f32(value)
    if axis == wl_pointer_axis_horizontal_scroll() {
        s.events.push(Event.Scrolled(amount, 0.0))
    } else {
        s.events.push(Event.Scrolled(0.0, amount))
    }
}

fn on_keymap(data: ptr, keyboard: ptr, format: u32, fd: i32, size: u32) {
    let s = window_of(data)
    if format != wl_keyboard_keymap_format_xkb_v1() {
        sys.close_fd(i64(fd))
        s.fault = Error.Unsupported("the compositor sent a keymap that is not xkb_v1")
        return
    }
    load_keymap(s, i64(fd), i64(size))
}

fn on_keyboard_enter(data: ptr, keyboard: ptr, serial: u32, surface: ptr, keys: ptr) {
    let s = window_of(data)
    s.events.push(Event.FocusChanged(true))
}

fn on_keyboard_leave(data: ptr, keyboard: ptr, serial: u32, surface: ptr) {
    let s = window_of(data)
    s.repeat.active = false
    s.events.push(Event.FocusChanged(false))
}

fn on_key(data: ptr, keyboard: ptr, serial: u32, time: u32, key: u32, state: u32) {
    let s = window_of(data)
    let pressed = state != wl_keyboard_key_state_released()
    let translated = translate_key(s, key, pressed) ?? return
    track_repeat(s, key, translated)
    s.events.push(Event.Key(translated))
}

fn on_modifiers(data: ptr, keyboard: ptr, serial: u32, depressed: u32, latched: u32, locked: u32, group: u32) {
    let s = window_of(data)
    update_modifiers(s, depressed, latched, locked, group)
}

fn on_repeat_info(data: ptr, keyboard: ptr, rate: i32, delay: i32) {
    let s = window_of(data)
    s.repeat.delay = i64(delay)
    s.repeat.interval = if rate > 0 { 1000 / i64(rate) } else { 0 }
    if s.repeat.interval == 0 {
        s.repeat.active = false
    }
}
