    fn GetWindowLongPtrW(hwnd: ptr, index: i32) -> ptr
    fn SetWindowLongPtrW(hwnd: ptr, index: i32, value: ptr) -> ptr
    fn PeekMessageW(mut msg: Msg, hwnd: ptr, first: u32, last: u32, remove: u32) -> i32
    fn TranslateMessage(mut msg: Msg) -> i32
    fn DispatchMessageW(mut msg: Msg) -> i64
    fn MsgWaitForMultipleObjectsEx(count: u32, handles: ptr, timeout: u32, mask: u32, flags: u32) -> u32
    fn PostMessageW(hwnd: ptr, message: u32, wparam: i64, lparam: i64) -> i32
    fn SetWindowPos(hwnd: ptr, after: ptr, x: i32, y: i32, width: i32, height: i32, flags: u32) -> i32
    fn GetClientRect(hwnd: ptr, mut rect: Rect) -> i32
    fn AdjustWindowRectExForDpi(mut rect: Rect, style: u32, menu: i32, ex_style: u32, dpi: u32) -> i32
    fn GetDpiForWindow(hwnd: ptr) -> u32
    fn SetProcessDpiAwarenessContext(context: i64) -> i32
    fn LoadCursorW(instance: ptr, name: i64) -> ptr
    fn TrackMouseEvent(mut track: TrackMouse) -> i32
    fn SetCapture(hwnd: ptr) -> ptr
    fn ReleaseCapture() -> i32
    fn GetKeyState(key: i32) -> u16
    fn ToUnicode(key: u32, scan: u32, state: ptr[u8], buffer: ptr[u16], size: i32, flags: u32) -> i32
    fn GetProcessWindowStation() -> ptr
}

extern struct WndClassEx {
    size: u32 = 80
    style: u32 = 0
    procedure: extern fn(ptr, u32, i64, i64) -> i64
    class_extra: i32 = 0
    window_extra: i32 = 0
    instance: ptr = null
    icon: ptr = null
    cursor: ptr = null
    background: ptr = null
    menu: ptr = null
    class_name: ptr = null
    small_icon: ptr = null
}

extern struct Msg {
    hwnd: ptr = null
    message: u32 = 0
    wparam: i64 = 0
    lparam: i64 = 0
    time: u32 = 0
    x: i32 = 0
    y: i32 = 0
}

extern struct Rect {
    left: i32 = 0
    top: i32 = 0
    right: i32 = 0
    bottom: i32 = 0
}

extern struct CreateStruct {
    params: ptr = null
}

extern struct TrackMouse {
    size: u32 = 24
    flags: u32 = 0
    hwnd: ptr = null
    hover_time: u32 = 0
}

