    fn RegisterClassExW(mut class: WndClassEx) -> u16
    fn UnregisterClassW(name: ptr, instance: ptr) -> i32
    fn CreateWindowExW(ex_style: u32, class: ptr, title: ptr, style: u32, x: i32, y: i32, width: i32, height: i32, parent: ptr, menu: ptr, instance: ptr, param: ptr) -> ptr
