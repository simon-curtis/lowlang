fn utf8_page() -> u32 {
    65001
}

fn class_name() -> []u8 {
    wide("LowWindow")
}

fn wide(s: str) -> []u8 {
    let text = cstr(s)
    let chars = MultiByteToWideChar(utf8_page(), 0, text, -1, null, 0)
    let out: []u8 = __make(2 * i64(chars) + 2)
    MultiByteToWideChar(utf8_page(), 0, text, -1, __slice_ptr(out), chars)
    out
}

fn narrow(units: []u16) -> str {
    if units.len == 0 {
        return ""
    }
    let chars = i32(units.len)
    let n = WideCharToMultiByte(utf8_page(), 0, __slice_ptr(units), chars, null, 0, null, null)
    let out: []u8 = __make(i64(n))
    WideCharToMultiByte(utf8_page(), 0, __slice_ptr(units), chars, __slice_ptr(out), n, null, null)
    str(out)
}

fn error_access_denied() -> u32 {
    5
}

fn creation_error(call: str, code: u32) -> Error {
    if code == 0 || code == error_access_denied() {
        return NoDisplay("the process has no desktop to create a window on")
    }
    Failed(call, i64(code))
}

fn call_failed(call: str) -> Error {
    Failed(call, i64(GetLastError()))
}
