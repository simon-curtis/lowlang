/// What `open` needs to make a window.
pub struct Options {
    /// The window title.
    pub title: str = "Low"
    /// The width of the window's content in logical pixels.
    pub width: i64 = 800
    /// The height of the window's content in logical pixels.
    pub height: i64 = 600
    /// Who should draw the title bar and borders. The windowing system may decide otherwise, which `decorations` reports.
    pub decorations: Decorations = Server
}

/// Why a window could not be opened or serviced.
pub enum Error {
    /// The windowing system could not be reached: no Wayland compositor, or no desktop on Windows.
    NoDisplay(detail: str)
    /// The windowing system lacks something the window needs, such as a global it did not advertise.
    Unsupported(detail: str)
    /// A call into the windowing system failed with the code it returned.
    Failed(call: str, code: i64)
    /// The connection to the windowing system was lost.
    Disconnected
}

/// A pointer button.
pub enum Button {
    /// The primary button.
    Left
    /// The secondary button.
    Right
    /// The wheel button.
    Middle
    /// Any other button, numbered as the windowing system numbers it.
    Other(code: i64)
}

/// A key that does not produce text.
pub enum NamedKey {
    /// Enter or Return.
    Enter
    /// Escape.
    Escape
    /// Tab.
    Tab
    /// Backspace.
    Backspace
    /// Delete, forward.
    Delete
    /// The left arrow.
    Left
    /// The right arrow.
    Right
    /// The up arrow.
    Up
    /// The down arrow.
    Down
    /// Home.
    Home
    /// End.
    End
    /// Page Up.
    PageUp
    /// Page Down.
    PageDown
    /// A function key, `Function(1)` for F1 up to `Function(12)` for F12.
    Function(number: i64)
}

/// The pointer's image over a window.
pub enum Cursor {
    /// The usual arrow.
    Arrow
    /// A text caret, for selecting text.
    Text
    /// A text caret on its side, for selecting vertical text.
    VerticalText
    /// A pointing hand, for links and other things that act when clicked.
    Pointer
    /// A crosshair.
    Crosshair
    /// An open hand, for something that can be dragged.
    Grab
    /// A closed hand, for something being dragged.
    Grabbing
    /// A sign that the action under the pointer is not allowed.
    NotAllowed
    /// A drop that copies what is dragged.
    Copy
    /// A drop that links to what is dragged.
    Alias
    /// A sign that a context menu is available.
    ContextMenu
    /// Arrows in four directions, for something that moves.
    Move
    /// A sign that the program is busy.
    Wait
    /// A sign that the program is busy but still responds.
    Progress
    /// A sign that help is available.
    Help
    /// Resizing by moving a left edge.
    ResizeLeft
    /// Resizing by moving a right edge.
    ResizeRight
    /// Resizing by moving a top edge.
    ResizeUp
    /// Resizing by moving a bottom edge.
    ResizeDown
    /// Resizing left or right.
    ResizeLeftRight
    /// Resizing up or down.
    ResizeUpDown
    /// Resizing along the diagonal from the top left to the bottom right.
    ResizeUpLeftDownRight
    /// Resizing along the diagonal from the top right to the bottom left.
    ResizeUpRightDownLeft
    /// Resizing a column.
    ResizeColumn
    /// Resizing a row.
    ResizeRow
    /// No image.
    Hidden
}

/// Who draws a window's title bar and borders.
pub enum Decorations {
    /// The windowing system draws them.
    Server
    /// The program draws them, and moves and resizes the window with `start_move` and `start_resize`.
    Client
}

/// How a window sits on the screen.
pub struct WindowStatus {
    /// Whether the window fills the work area.
    pub maximized: bool = false
    /// Whether the window covers the whole screen.
    pub fullscreen: bool = false
    /// Whether the window is tiled against an edge of the screen or another window, so client-side decorations draw no shadow or rounded corners there.
    pub tiled: bool = false
}

/// An edge or corner of a window to resize from.
pub enum ResizeEdge {
    /// The top edge.
    Top
    /// The bottom edge.
    Bottom
    /// The left edge.
    Left
    /// The right edge.
    Right
    /// The top left corner.
    TopLeft
    /// The top right corner.
    TopRight
    /// The bottom left corner.
    BottomLeft
    /// The bottom right corner.
    BottomRight
}

/// The identity of a pressed key.
pub enum Key {
    /// A key that does not produce text.
    Named(key: NamedKey)
    /// A key that produces text, named by the text it produces without modifiers other than Shift, such as `"a"`, `"A"` or `" "`.
    Character(text: str)
}

/// The modifier keys held during an event.
pub struct Modifiers {
    /// Either Shift key.
    pub shift: bool = false
    /// Either Control key.
    pub control: bool = false
    /// Either Alt key.
    pub alt: bool = false
    /// The Super, Windows or Command key.
    pub super: bool = false
}

/// A range of a string's bytes, from `start` up to `end`.
pub struct TextRange {
    /// The offset of the first byte.
    pub start: i64
    /// The offset after the last byte.
    pub end: i64
}

/// The caret of the text being edited, in logical pixels from the top left of the content area. The input method places its candidate window beside it.
pub struct Caret {
    /// The left edge.
    pub x: i64 = 0
    /// The top edge.
    pub y: i64 = 0
    /// The width, zero for a thin caret.
    pub width: i64 = 0
    /// The height.
    pub height: i64 = 0
}

/// A key press or release.
pub struct KeyEvent {
    /// The key.
    pub key: Key
    /// The text the key produces with the modifiers held, empty for a release and for keys that produce none.
    pub text: str = ""
    /// The modifiers held.
    pub modifiers: Modifiers = Modifiers {}
    /// `true` for a press, `false` for a release.
    pub pressed: bool = true
    /// `true` for a press repeated because the key is held.
    pub repeat: bool = false
}

/// Something that happened to a window.
///
/// Sizes and positions are logical pixels; multiplying by the scale gives device pixels.
pub enum Event {
    /// The content area is now `width` by `height` logical pixels at `scale` device pixels per logical pixel, which may be fractional; drawing fills `width` times `scale` by `height` times `scale` device pixels, each rounded to the nearest whole pixel. The first `next` after `open` returns one.
    Resized(width: f32, height: f32, scale: f32)
    /// The user asked to close the window.
    CloseRequested
    /// The pointer moved to `x`, `y` from the top left of the content area.
    PointerMoved(x: f32, y: f32)
    /// The pointer left the content area.
    PointerLeft
    /// A button was pressed with the pointer at `x`, `y`.
    PointerDown(button: Button, x: f32, y: f32)
    /// A button was released with the pointer at `x`, `y`.
    PointerUp(button: Button, x: f32, y: f32)
    /// The wheel or touchpad scrolled by `dx`, `dy` logical pixels, positive to the right and down.
    Scrolled(dx: f32, dy: f32)
    /// A key was pressed or released while the window had keyboard focus.
    Key(event: KeyEvent)
    /// The modifiers held changed. It can follow the `Key` event of the modifier key that changed them, and arrives when the window gains keyboard focus with modifiers held.
    ModifiersChanged(modifiers: Modifiers)
    /// The input method's composition changed to `text`, with its cursor over `cursor`, byte offsets into `text`, or hidden. Empty text ends the composition. Only arrives while text input is on.
    Preedit(text: str, cursor: TextRange?)
    /// The input method entered `text`, which replaces the composition. Only arrives while text input is on.
    Commit(text: str)
    /// Who draws the window's title bar and borders changed. The first `next` after `open` returns one when they are client-side.
    DecorationsChanged(decorations: Decorations)
    /// The window was maximized, made fullscreen or tiled, or stopped being so.
    StatusChanged(status: WindowStatus)
    /// The window gained keyboard focus, `true`, or lost it, `false`.
    FocusChanged(focused: bool)
    /// A `Waker` of the window fired.
    Woken
}

/// The handles a renderer needs to make a surface for a window.
///
/// On Linux `display` is the `wl_display` and `window` the `wl_surface`. On Windows `display` is the `HINSTANCE` and `window` the `HWND`.
pub struct Native {
    /// The connection or module handle.
    pub display: ptr
    /// The window's surface or handle.
    pub window: ptr
}

/// An open window. Releasing it destroys the window and closes the connection to the windowing system.
///
/// A window belongs to the green thread that opened it: `next` must be called from that green thread.
pub struct Window {
    state: *WindowState
    drop close_window(state)
}

/// A copyable handle to the system clipboard through a window, for code that does not own the window.
pub struct Clipboard {
    state: *WindowState
}

/// A copyable handle that moves, resizes and titles a window, for a window that draws its own title bar and for code that does not own the window.
pub struct Controls {
    state: *WindowState
}

/// A copyable handle that ends a window's `next` early from any green thread.
pub struct Waker {
    state: *WakerState
}

/// Opens a window with the title and logical content size of `o`, and returns once it can be drawn into.
pub fn open(o: Options) -> Window ! Error {
    let state = open_window(o)?
    Window { state }
}

/// Returns the events that arrived for `w`, waiting until at least one arrives, a `Waker` fires or `timeout_ms` milliseconds pass. A negative timeout waits without limit.
pub fn next(w: Window, timeout_ms: i64) -> []Event ! Error {
    next_events(w.state, timeout_ms)?
}

/// Returns a `Waker` for `w`.
pub fn waker(w: Window) -> Waker {
    Waker { state: window_waker(w.state) }
}

/// Makes the `next` call waiting on the waker's window return with a `Woken` event, or the next one when none is waiting.
pub fn wake(k: Waker) {
    wake_window(k.state)
}

/// Returns a `Clipboard` that reaches the system clipboard through `w`.
pub fn clipboard(w: Window) -> Clipboard {
    Clipboard { state: w.state }
}

/// Puts `text` on the system clipboard, where other programs can paste it. Fails with `Disconnected` once the window is released.
pub fn write_clipboard(c: Clipboard, text: str) ! Error {
    write_window_clipboard(c.state, text)?
}

/// Returns the text on the system clipboard, or `none` when it holds no text. Fails with `Disconnected` once the window is released.
pub fn read_clipboard(c: Clipboard) -> str? ! Error {
    read_window_clipboard(c.state)?
}

/// Turns text input through the system's input method on, with the caret at `caret`, or off for `none`. Text input starts off; while it is on, an input method can turn keys into `Preedit` and `Commit` events instead of `Key` events. Setting it again moves the caret.
pub fn set_text_input(w: Window, caret: Caret?) {
    set_window_text_input(w.state, caret)
}

/// Returns who draws `w`'s title bar and borders.
pub fn decorations(w: Window) -> Decorations {
    window_decorations(w.state)
}

/// Returns how `w` sits on the screen.
pub fn status(w: Window) -> WindowStatus {
    window_status(w.state)
}

/// Returns the `Controls` of `w`.
pub fn controls(w: Window) -> Controls {
    Controls { state: w.state }
}

/// Lets the user move `w` with the pointer, from a button press that has not been released. It does nothing without such a press.
pub fn start_move(w: Controls) {
    start_window_move(w.state)
}

/// Lets the user resize `w` from `edge` with the pointer, from a button press that has not been released. It does nothing without such a press.
pub fn start_resize(w: Controls, edge: ResizeEdge) {
    start_window_resize(w.state, edge)
}

/// Shows the windowing system's menu for `w` at `x`, `y` logical pixels from the top left of its content.
pub fn show_window_menu(w: Controls, x: f32, y: f32) {
    show_menu(w.state, x, y)
}

/// Maximizes `w`, or restores it from maximized for `false`.
pub fn set_maximized(w: Controls, maximized: bool) {
    set_window_maximized(w.state, maximized)
}

/// Makes `w` cover the whole screen, or restores it for `false`.
pub fn set_fullscreen(w: Controls, fullscreen: bool) {
    set_window_fullscreen(w.state, fullscreen)
}

/// Minimizes `w`.
pub fn minimize(w: Controls) {
    minimize_window(w.state)
}

/// Sets `w`'s title.
pub fn set_title(w: Controls, title: str) {
    set_window_title(w.state, title)
}

/// Shows `c` while the pointer is over `w`'s content.
pub fn set_cursor(w: Window, c: Cursor) {
    set_window_cursor(w.state, c)
}

/// Returns the handles a renderer needs to draw into `w`.
pub fn native(w: Window) -> Native {
    window_native(w.state)
}

/// Opens `url` in the application the desktop registers for its scheme, such as the web browser for `https`, without waiting for it.
///
/// `url` must pass `is_url`, so a path or an option is refused; any scheme passes, `file` among them, so a URL from an untrusted source needs its scheme checked first. Runs `xdg-open` on Linux and `ShellExecuteW` on Windows. Fails with `Unsupported` for a string without a scheme or when `xdg-open` is not installed, or `Failed` with the code the system returned.
pub fn open_url(url: str) ! Error {
    if !is_url(url) {
        fail Unsupported("not a URL")
    }
    launch(url)?
}

/// Returns whether `s` starts with a URL scheme of at least two characters, a letter then letters, digits, `+`, `-` or `.`, followed by a colon, as `open_url` requires.
pub fn is_url(s: str) -> bool {
    var i = 0
    for i < s.len && scheme_byte(s[i], i == 0) {
        i += 1
    }
    i >= 2 && i < s.len && s[i] == ':'
}

fn scheme_byte(c: u8, first: bool) -> bool {
    let letter = c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z'
    letter || !first && (c >= '0' && c <= '9' || c == '+' || c == '-' || c == '.')
}
