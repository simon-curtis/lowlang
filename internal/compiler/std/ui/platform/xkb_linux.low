import std/io
import std/sys
import std/time

extern "xkbcommon" {
    fn xkb_context_new(flags: i32) -> ptr
    fn xkb_context_unref(context: ptr)
    fn xkb_keymap_new_from_string(context: ptr, text: ptr[u8], format: i32, flags: i32) -> ptr
    fn xkb_keymap_unref(keymap: ptr)
    fn xkb_state_new(keymap: ptr) -> ptr
    fn xkb_state_unref(state: ptr)
    fn xkb_state_update_mask(state: ptr, depressed: u32, latched: u32, locked: u32, depressed_group: u32, latched_group: u32, locked_group: u32) -> i32
    fn xkb_state_key_get_one_sym(state: ptr, key: u32) -> u32
    fn xkb_state_key_get_utf8(state: ptr, key: u32, buffer: ptr[u8], size: i64) -> i32
    fn xkb_state_mod_name_is_active(state: ptr, name: ptr[u8], kind: i32) -> i32
    fn xkb_keysym_to_utf8(keysym: u32, buffer: ptr[u8], size: i64) -> i32
}

struct Keys {
    context: ptr = null
    keymap: ptr = null
    state: ptr = null
    text: ptr[u8] = null
}

struct Repeat {
    active: bool = false
    code: u32 = 0
    held: KeyEvent? = none
    at: i64 = 0
    delay: i64 = 600
    interval: i64 = 40
}

fn text_capacity() -> i64 {
    32
}

fn xkb_keycode_offset() -> u32 {
    8
}

fn xkb_keymap_format_text_v1() -> i32 {
    1
}

fn xkb_state_mods_effective() -> i32 {
    8
}

fn start_keys(s: *WindowState) ! Error {
    s.keys.context = xkb_context_new(0)
    if s.keys.context == null {
        fail Failed("xkb_context_new", 0)
    }
    s.keys.text = malloc(text_capacity())
    if s.keys.text == null {
        fail Failed("malloc", 0)
    }
}

fn stop_keys(s: *WindowState) {
    if s.keys.state != null {
        xkb_state_unref(s.keys.state)
    }
    if s.keys.keymap != null {
        xkb_keymap_unref(s.keys.keymap)
    }
    if s.keys.context != null {
        xkb_context_unref(s.keys.context)
    }
    free(s.keys.text)
    s.keys = Keys {}
}

fn read_keymap(fd: i64, text: []u8, size: i64) ! io.Error {
    sys.seek(fd, 0, sys.Seek.FromStart)?
    var filled = 0
    for filled < size {
        let got = sys.try_read(fd, text[filled..size])?
        if got == 0 {
            break
        }
        filled += got
    }
}

fn load_keymap(s: *WindowState, fd: i64, size: i64) {
    let memory: ptr[u8] = malloc(size + 1)
    if memory == null {
        sys.close_fd(fd)
        s.fault = Error.Failed("malloc", 0)
        return
    }
    let text = view(memory, size + 1)
    for i in 0..text.len {
        text[i] = 0
    }
    read_keymap(fd, text, size) or {
        sys.close_fd(fd)
        free(memory)
        s.fault = Error.Failed("read", 0)
        return
    }
    sys.close_fd(fd)
    let keymap = xkb_keymap_new_from_string(s.keys.context, memory, xkb_keymap_format_text_v1(), 0)
    free(memory)
    if keymap == null {
        s.fault = Error.Failed("xkb_keymap_new_from_string", 0)
        return
    }
    let state = xkb_state_new(keymap)
    if state == null {
        xkb_keymap_unref(keymap)
        s.fault = Error.Failed("xkb_state_new", 0)
        return
    }
    if s.keys.state != null {
        xkb_state_unref(s.keys.state)
    }
    if s.keys.keymap != null {
        xkb_keymap_unref(s.keys.keymap)
    }
    s.keys.keymap = keymap
    s.keys.state = state
}

fn update_modifiers(s: *WindowState, depressed: u32, latched: u32, locked: u32, group: u32) {
    if s.keys.state == null {
        return
    }
    xkb_state_update_mask(s.keys.state, depressed, latched, locked, 0, 0, group)
    let held = Modifiers {
        shift: modifier_active(s, "Shift")
        control: modifier_active(s, "Control")
        alt: modifier_active(s, "Mod1")
        super: modifier_active(s, "Mod4")
    }
    if held != s.modifiers {
        s.modifiers = held
        s.events.push(Event.ModifiersChanged(held))
    }
}

fn modifier_active(s: *WindowState, name: str) -> bool {
    xkb_state_mod_name_is_active(s.keys.state, cstr(name), xkb_state_mods_effective()) > 0
}

fn keysym_text(s: *WindowState, sym: u32) -> str {
    let length = xkb_keysym_to_utf8(sym, s.keys.text, text_capacity())
    if length <= 0 {
        return ""
    }
    str(s.keys.text)
}

fn pressed_text(s: *WindowState, code: u32) -> str {
    let length = xkb_state_key_get_utf8(s.keys.state, code, s.keys.text, text_capacity())
    if length <= 0 {
        return ""
    }
    let text = str(s.keys.text)
    for byte in bytes(text) {
        if byte < 0x20 || byte == 0x7f {
            return ""
        }
    }
    text
}

fn named_key(sym: u32) -> NamedKey? {
    if sym >= 0xffbe && sym <= 0xffc9 {
        return NamedKey.Function(i64(sym) - 0xffbd)
    }
    match sym {
        0xff0d => NamedKey.Enter
        0xff8d => NamedKey.Enter
        0xff1b => NamedKey.Escape
        0xff09 => NamedKey.Tab
        0xfe20 => NamedKey.Tab
        0xff08 => NamedKey.Backspace
        0xffff => NamedKey.Delete
        0xff9f => NamedKey.Delete
        0xff51 => NamedKey.Left
        0xff96 => NamedKey.Left
        0xff53 => NamedKey.Right
        0xff98 => NamedKey.Right
        0xff52 => NamedKey.Up
        0xff97 => NamedKey.Up
        0xff54 => NamedKey.Down
        0xff99 => NamedKey.Down
        0xff50 => NamedKey.Home
        0xff95 => NamedKey.Home
        0xff57 => NamedKey.End
        0xff9c => NamedKey.End
        0xff55 => NamedKey.PageUp
        0xff9a => NamedKey.PageUp
        0xff56 => NamedKey.PageDown
        0xff9b => NamedKey.PageDown
        _ => none
    }
}

fn translate_key(s: *WindowState, key: u32, pressed: bool) -> KeyEvent? {
    if s.keys.state == null {
        return none
    }
    let code = key + xkb_keycode_offset()
    let sym = xkb_state_key_get_one_sym(s.keys.state, code)
    let named = named_key(sym)
    let identity: Key? = match named {
        some(n) => Key.Named(n)
        none => {
            let text = keysym_text(s, sym)
            if text.len == 0 {
                none
            } else {
                Key.Character(text)
            }
        }
    }
    let found = identity ?? return none
    let text = if pressed { pressed_text(s, code) } else { "" }
    KeyEvent { key: found, text, modifiers: s.modifiers, pressed, repeat: false }
}

fn track_repeat(s: *WindowState, key: u32, event: KeyEvent) {
    if event.pressed {
        if s.repeat.interval > 0 {
            s.repeat = Repeat { active: true, code: key, held: event, at: now_ms() + s.repeat.delay, delay: s.repeat.delay, interval: s.repeat.interval }
        }
        return
    }
    if s.repeat.active && s.repeat.code == key {
        s.repeat.active = false
    }
}

fn emit_repeat(s: *WindowState) {
    if !s.repeat.active {
        return
    }
    let now = now_ms()
    if now < s.repeat.at {
        return
    }
    match s.repeat.held {
        some(held) => {
            let event = KeyEvent { key: held.key, text: held.text, modifiers: s.modifiers, pressed: true, repeat: true }
            s.events.push(Event.Key(event))
        }
        none => {}
    }
    s.repeat.at = now + s.repeat.interval
}

fn repeat_wait(s: *WindowState, limit: i64) -> i64 {
    if !s.repeat.active {
        return limit
    }
    let due = s.repeat.at - now_ms()
    if due < limit {
        return if due > 0 { due } else { 0 }
    }
    limit
}

fn now_ms() -> i64 {
    time.monotonic() / 1000000
}
