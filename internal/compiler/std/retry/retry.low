import std/cancel
import std/rand
import std/time/clock
import std/time/duration

/// How the wait before a retry is randomised.
pub enum Jitter {
    /// No randomisation: the wait is the policy's backoff delay.
    None
    /// A random wait from zero up to the backoff delay.
    Full
    /// Half the backoff delay plus a random share of the other half.
    Equal
    /// A random wait from the base delay up to three times the previous wait, capped at the maximum delay.
    ///
    /// It ignores the attempt number, so the growth follows the actual previous waits.
    Decorrelated
}

/// Why a `Retrier` stopped, or `Running` while it has not.
pub enum Stop {
    /// The loop may still make another attempt.
    Running
    /// The policy's attempts are used up.
    Exhausted
    /// The next wait would run past the policy's deadline.
    Deadline
    /// The policy's cancel token was cancelled.
    Cancelled
}

/// How a retry loop backs off, built from `policy` and the `with_` functions.
///
/// The wait before attempt `n + 1` is the backoff `delay(p, n)`, randomised by `jitter`. Every field has a default, so `Policy {}` is the same as `policy()`. A `Policy` is a copyable value; the `with_` functions return a changed copy.
pub struct Policy {
    /// The total number of attempts, including the first. Defaults to `5`.
    pub attempts: i64 = 5
    /// The delay before the first retry. Defaults to 100 milliseconds.
    pub base: duration.Duration = duration.milliseconds(100)
    /// The factor the delay grows by after each attempt. Defaults to `2.0`.
    pub multiplier: f64 = 2.0
    /// The largest delay between attempts. Defaults to 30 seconds.
    pub max_delay: duration.Duration = duration.seconds(30)
    /// How each delay is randomised. Defaults to `Full`.
    pub jitter: Jitter = Full
    /// The total time the loop may take, measured from `start`, or `none` for no limit.
    pub deadline: duration.Duration? = none
    /// The source of random numbers for jitter, or `none` to draw a fresh generator at `start`.
    pub rng: rand.Rng? = none
    /// A token that ends the loop and any wait when cancelled, or `none` for no cancellation.
    pub token: *cancel.Token? = none
    /// The clock that measures elapsed time against the deadline. Defaults to the system clock.
    pub clock: clock.Clock = clock.system()
    /// A function that performs each wait instead of sleeping, or `none` to sleep.
    ///
    /// A custom sleeper is not interrupted by the cancel token.
    pub sleeper: fn(duration.Duration)? = none
    /// A function called before each wait with the number of the attempt that just ended and the wait, or `none`.
    pub observer: fn(i64, duration.Duration)? = none
}

/// Returns the default policy: five attempts, a 100 millisecond base delay doubling up to 30 seconds, full jitter, no deadline and no cancel token.
pub fn policy() -> Policy {
    Policy {}
}

/// Returns `p` allowing `attempts` attempts in total, the first included.
///
/// Values below `1` become `1`, which makes one attempt and no retries.
pub fn with_attempts(p: Policy, attempts: i64) -> Policy {
    var q = p
    q.attempts = if attempts < 1 { 1 } else { attempts }
    q
}

/// Returns `p` with `base` as the delay before the first retry.
///
/// A negative `base` becomes zero.
pub fn with_base(p: Policy, base: duration.Duration) -> Policy {
    var q = p
    q.base = duration.max(base, duration.zero())
    q
}

/// Returns `p` with `multiplier` as the factor the delay grows by after each attempt.
///
/// Values below `1.0` become `1.0`, which keeps the delay constant.
pub fn with_multiplier(p: Policy, multiplier: f64) -> Policy {
    var q = p
    q.multiplier = if multiplier < 1.0 { 1.0 } else { multiplier }
    q
}

/// Returns `p` with `max_delay` as the largest delay between attempts.
///
/// A negative `max_delay` becomes zero.
pub fn with_max_delay(p: Policy, max_delay: duration.Duration) -> Policy {
    var q = p
    q.max_delay = duration.max(max_delay, duration.zero())
    q
}

/// Returns `p` using `jitter` to randomise each delay.
pub fn with_jitter(p: Policy, jitter: Jitter) -> Policy {
    var q = p
    q.jitter = jitter
    q
}

/// Returns `p` limited to `total` time from `start`.
///
/// A retry whose wait would end past `total` is not made and the loop stops with `Deadline`. The time already spent in an attempt counts.
pub fn with_deadline(p: Policy, total: duration.Duration) -> Policy {
    var q = p
    q.deadline = some(total)
    q
}

/// Returns `p` drawing jitter from `r`, which makes the waits reproducible for a seeded generator.
pub fn with_rng(p: Policy, r: rand.Rng) -> Policy {
    var q = p
    q.rng = some(r)
    q
}

/// Returns `p` that stops when `t` is cancelled.
///
/// The token is checked before each attempt and after each wait, and a wait ends early when it is cancelled.
pub fn with_cancel(p: Policy, t: *cancel.Token) -> Policy {
    var q = p
    q.token = some(t)
    q
}

/// Returns `p` measuring elapsed time on `c`, for the deadline.
pub fn with_clock(p: Policy, c: clock.Clock) -> Policy {
    var q = p
    q.clock = c
    q
}

/// Returns `p` that performs each wait by calling `f` with the wait instead of sleeping.
///
/// Meant for tests that skip or record waits. A zero wait does not call `f`.
pub fn with_sleeper(p: Policy, f: fn(duration.Duration)) -> Policy {
    var q = p
    q.sleeper = some(f)
    q
}

/// Returns `p` that calls `f` before each wait with the number of the attempt that just ended and the wait about to start.
///
/// It is not called for the first attempt or when the loop stops instead of waiting.
pub fn on_retry(p: Policy, f: fn(i64, duration.Duration)) -> Policy {
    var q = p
    q.observer = some(f)
    q
}

fn max_i64() -> i64 {
    9223372036854775807
}

fn nanos_of(d: duration.Duration) -> i64 {
    duration.as_nanos(d) ?? if duration.is_negative(d) { 0 } else { max_i64() }
}

fn millis_up(nanos: i64) -> i64 {
    if nanos <= 0 {
        return 0
    }
    let whole = nanos / 1000000
    if nanos % 1000000 != 0 { whole + 1 } else { whole }
}

fn grown(current: i64, multiplier: f64, cap: i64) -> i64 {
    let next = f64(current) * multiplier
    if next >= f64(cap) {
        return cap
    }
    i64(next)
}

/// Returns the backoff delay after attempt number `attempt`, before jitter.
///
/// The base delay is grown by `multiplier` once for every attempt after the first and capped at `max_delay`, so attempts `1` or lower return `base`, or `max_delay` when that is smaller.
pub fn delay(p: Policy, attempt: i64) -> duration.Duration {
    let cap = nanos_of(p.max_delay)
    var nanos = nanos_of(p.base)
    if nanos > cap {
        nanos = cap
    }
    var step = 1
    for step < attempt && nanos < cap {
        nanos = grown(nanos, p.multiplier, cap)
        step += 1
    }
    duration.nanoseconds(nanos)
}

fn decorrelated(p: Policy, previous: i64, mut r: rand.Rng) -> i64 {
    let cap = nanos_of(p.max_delay)
    let floor = nanos_of(p.base)
    let top = if previous > cap / 3 { cap } else { previous * 3 }
    if top <= floor {
        return if floor < cap { floor } else { cap }
    }
    rand.between(mut r, floor, top)
}

/// Returns the wait after attempt `attempt` with the policy's jitter applied, drawing from `r`.
///
/// `previous` is the last wait, which only `Decorrelated` uses. With `None` the result is `delay(p, attempt)`; with `Full` it is between zero and that delay; with `Equal` it is between half of it and all of it.
pub fn jittered(p: Policy, attempt: i64, previous: duration.Duration, mut r: rand.Rng) -> duration.Duration {
    let ceiling = nanos_of(delay(p, attempt))
    match p.jitter {
        None => duration.nanoseconds(ceiling)
        Full => duration.nanoseconds(rand.between(mut r, 0, ceiling))
        Equal => {
            let half = ceiling / 2
            duration.nanoseconds(half + rand.between(mut r, 0, ceiling - half))
        }
        Decorrelated => duration.nanoseconds(decorrelated(p, nanos_of(previous), mut r))
    }
}

/// The state of a retry loop, driven by `next`.
///
/// Read `attempt` inside the loop for the current attempt number. A `Retrier` is a pointer returned by `start`; it is not safe to share between green threads.
pub struct Retrier {
    /// The number of the current attempt, counting from `1`, or `0` before the first call to `next`.
    pub attempt: i64
    /// Why the loop ended, or `Running` while `next` can still return `true`.
    pub stop: Stop
    /// The wait before the current attempt, which starts as the policy's base delay.
    pub last_delay: duration.Duration
    policy: Policy
    started: duration.Duration
    rng: rand.Rng
    minimum: duration.Duration
    planned: duration.Duration
}

/// Returns a retry loop for `p` that has made no attempts yet.
///
/// Starts the deadline clock. Without a policy `rng`, the loop seeds its own random generator.
pub fn start(p: Policy) -> *Retrier {
    let source = p.rng ?? rand.rng()
    new(Retrier {
        attempt: 0,
        stop: Running,
        last_delay: p.base,
        policy: p,
        started: p.clock.monotonic(),
        rng: source,
        minimum: duration.zero(),
        planned: duration.zero()
    })
}

/// Raises the wait before the next attempt to at least `d`, for a server-requested delay such as `Retry-After`.
///
/// The floor applies to one wait only, and the jittered delay is used if it is longer. The deadline still applies to the raised wait.
pub fn at_least(r: *Retrier, d: duration.Duration) {
    r.minimum = duration.max(r.minimum, d)
}

/// Returns the time since `start`, on the policy's clock.
pub fn elapsed(r: *Retrier) -> duration.Duration {
    clock.elapsed_since(r.policy.clock, r.started)
}

fn is_cancelled(r: *Retrier) -> bool {
    match r.policy.token {
        some(t) => cancel.cancelled(t)
        none => false
    }
}

fn announce(r: *Retrier, wait: duration.Duration) {
    match r.policy.observer {
        some(f) => f(r.attempt, wait)
        none => {}
    }
}

fn over_budget(r: *Retrier, wait: duration.Duration) -> bool {
    match r.policy.deadline {
        some(total) => duration.after(duration.plus(elapsed(r), wait), total)
        none => false
    }
}

fn pause(r: *Retrier, wait: duration.Duration) {
    if duration.is_zero(wait) {
        return
    }
    match r.policy.sleeper {
        some(f) => f(wait)
        none => {
            let millis = millis_up(nanos_of(wait))
            match r.policy.token {
                some(t) => {
                    let finished = cancel.pause(t, millis)
                }
                none => sleep(millis)
            }
        }
    }
}

fn next_delay(r: *Retrier) -> duration.Duration {
    let drawn = jittered(r.policy, r.attempt, r.last_delay, mut r.rng)
    duration.max(drawn, r.minimum)
}

/// Decides whether another attempt may follow the current one and plans its wait, without waiting.
///
/// Returns `false` with `stop` set to `Cancelled` when the token is cancelled, `Exhausted` when the attempts are used up, or `Deadline` when the wait would pass the deadline. Otherwise it returns `true` and `commit` carries out the wait. Call `at_least` first to raise the planned wait. Before the first attempt `reserve` returns `true` and `commit` makes it; use it when the caller must check the plan, as for a deadline, before it discards work that the retry replaces.
pub fn reserve(r: *Retrier) -> bool {
    if r.stop != Running {
        return false
    }
    if is_cancelled(r) {
        r.stop = Cancelled
        return false
    }
    if r.attempt == 0 {
        r.planned = duration.zero()
        return true
    }
    if r.attempt >= r.policy.attempts {
        r.stop = Exhausted
        return false
    }
    let wait = next_delay(r)
    if over_budget(r, wait) {
        r.stop = Deadline
        return false
    }
    r.planned = wait
    true
}

/// Carries out the wait planned by the last successful `reserve` and starts the next attempt.
///
/// It calls the observer, blocks the green thread for the wait and returns `true`, or returns `false` with `stop` set to `Cancelled` when the token was cancelled during the wait. The first attempt starts at once without a wait or the observer.
pub fn commit(r: *Retrier) -> bool {
    if r.stop != Running {
        return false
    }
    if r.attempt == 0 {
        r.attempt = 1
        return true
    }
    let wait = r.planned
    announce(r, wait)
    pause(r, wait)
    r.last_delay = wait
    r.minimum = duration.zero()
    if is_cancelled(r) {
        r.stop = Cancelled
        return false
    }
    r.attempt += 1
    true
}

/// Waits and returns `true` when the caller should make the next attempt, or returns `false` once the loop has stopped.
///
/// It is `reserve` followed by `commit`. The first call returns `true` at once. Later calls return `false` with `stop` set to `Cancelled` when the token is cancelled, `Exhausted` when the attempts are used up, or `Deadline` when the wait would pass the deadline. Otherwise they call the observer, block the green thread for the wait and return `true`, or return `false` with `Cancelled` if the token was cancelled during the wait. Once `false` is returned, every later call returns `false`.
pub fn next(r: *Retrier) -> bool {
    reserve(r) && commit(r)
}

/// What one attempt asks `run` to do next.
pub enum Step[T, E] {
    /// The attempt succeeded with this value.
    Done(T)
    /// The attempt failed with this error; try again after the backoff delay.
    Retry(E)
    /// The attempt failed with this error; try again after at least `wait`, or the backoff delay if that is longer.
    RetryAfter(error: E, wait: duration.Duration)
    /// The attempt failed with this error and must not be retried.
    Fatal(E)
}

/// How `run` ended.
pub enum Outcome[T, E] {
    /// An attempt returned `Done` with this value.
    Value(T)
    /// An attempt returned `Fatal` with this error.
    Failed(E)
    /// The loop stopped with `reason` after attempts that returned `Retry` or `RetryAfter`; `error` is the last one.
    GaveUp(error: E, reason: Stop)
    /// The loop stopped with this reason before any attempt ran, because the token was already cancelled.
    Stopped(Stop)
}

/// Calls `op` with the attempt number until it returns `Done` or `Fatal` or the policy stops the loop.
///
/// Attempts count from `1`. `Retry` and `RetryAfter` wait as `next` does. Returns `Value` for `Done`, `Failed` for `Fatal`, `GaveUp` with the last error and the `Stop` reason when attempts, deadline or cancellation end the loop, and `Stopped` only when the loop stopped before the first attempt.
pub fn run[T, E](p: Policy, op: fn(i64) -> Step[T, E]) -> Outcome[T, E] {
    let r = start(p)
    var last: E? = none
    for next(r) {
        let step = op(r.attempt)
        match step {
            Done(v) => return Value(v)
            Fatal(e) => return Failed(e)
            Retry(e) => { last = some(e) }
            RetryAfter(e, wait) => {
                last = some(e)
                at_least(r, wait)
            }
        }
    }
    match last {
        some(e) => GaveUp(e, r.stop)
        none => Stopped(r.stop)
    }
}
