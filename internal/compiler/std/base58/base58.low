import std/crypto/hash
import std/text

/// Why a Base58 decode failed.
pub enum Error {
    /// A byte of the input is not in the alphabet. `at` is its index in the input.
    BadCharacter(at: i64)
    /// The four checksum bytes of `decode_check` do not match the payload.
    BadChecksum
    /// The decoded data of `decode_check` is shorter than the four checksum bytes.
    TooShort
}

fn bitcoin() -> str {
    "123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz"
}

fn flickr() -> str {
    "123456789abcdefghijkmnopqrstuvwxyzABCDEFGHJKLMNPQRSTUVWXYZ"
}

fn leading_zeros(data: []u8) -> i64 {
    var n = 0
    for n < data.len && data[n] == 0 {
        n += 1
    }
    n
}

fn encode_with(data: []u8, alphabet: str) -> str {
    let zeros = leading_zeros(data)
    var digits: []u8 = []
    for i in zeros..data.len {
        var carry = i64(data[i])
        for j in 0..digits.len {
            carry += i64(digits[j]) << 8
            digits[j] = u8(carry % 58)
            carry = carry / 58
        }
        for carry > 0 {
            push(mut digits, u8(carry % 58))
            carry = carry / 58
        }
    }
    var out: []u8 = []
    for _ in 0..zeros {
        push(mut out, alphabet[0])
    }
    var k = digits.len - 1
    for k >= 0 {
        push(mut out, alphabet[i64(digits[k])])
        k -= 1
    }
    __str_view(out)
}

fn decode_with(s: str, alphabet: str) -> []u8 ! Error {
    var zeros = 0
    for zeros < s.len && s[zeros] == alphabet[0] {
        zeros += 1
    }
    var low: []u8 = []
    for i in zeros..s.len {
        let v = text.index_byte(alphabet, s[i])
        if v < 0 {
            fail BadCharacter(i)
        }
        var carry = v
        for j in 0..low.len {
            carry += i64(low[j]) * 58
            low[j] = u8(carry & 0xFF)
            carry = carry >> 8
        }
        for carry > 0 {
            push(mut low, u8(carry & 0xFF))
            carry = carry >> 8
        }
    }
    var out: []u8 = []
    for _ in 0..zeros {
        push(mut out, 0)
    }
    var k = low.len - 1
    for k >= 0 {
        push(mut out, low[k])
        k -= 1
    }
    out
}

fn checksum(payload: []u8) -> []u8 {
    let algorithm = hash.sha256()
    let first = hash.sum(algorithm, payload)
    let second = hash.sum(algorithm, first)
    second[..4]
}

fn with_checksum(data: []u8) -> []u8 {
    var out: []u8 = []
    __extend(mut out, __str_view(data))
    __extend(mut out, __str_view(checksum(data)))
    out
}

fn verified(raw: []u8) -> []u8 ! Error {
    if raw.len < 4 {
        fail TooShort
    }
    let payload = raw[..raw.len - 4]
    if !hash.equal(raw[raw.len - 4..], checksum(payload)) {
        fail BadChecksum
    }
    payload
}

/// Returns `data` encoded as Base58 with the Bitcoin alphabet, which omits `0`, `O`, `I` and `l`.
/// Each leading zero byte becomes one leading `1`, and empty input gives an empty string. The cost is quadratic in the length of `data`.
pub fn encode(data: []u8) -> str {
    encode_with(data, bitcoin())
}

/// Decodes Base58 text written with the Bitcoin alphabet.
/// Each leading `1` becomes one leading zero byte, and an empty string gives empty data. Fails with `BadCharacter` at the index of the first byte outside the alphabet.
pub fn decode(s: str) -> []u8 ! Error {
    decode_with(s, bitcoin())?
}

/// Returns `data` encoded as Base58 with the Flickr alphabet, which is the Bitcoin alphabet with lowercase letters ordered before uppercase.
/// Leading zero bytes become leading `1` characters, as in `encode`.
pub fn encode_flickr(data: []u8) -> str {
    encode_with(data, flickr())
}

/// Decodes Base58 text written with the Flickr alphabet.
/// Failure cases and leading-character handling are those of `decode`.
pub fn decode_flickr(s: str) -> []u8 ! Error {
    decode_with(s, flickr())?
}

/// Returns `data` followed by the first four bytes of its double SHA-256, encoded as Base58 with the Bitcoin alphabet (Base58Check).
pub fn encode_check(data: []u8) -> str {
    encode_with(with_checksum(data), bitcoin())
}

/// Decodes Base58Check text and returns the payload without its checksum.
/// Fails with `BadCharacter` as `decode` does, with `TooShort` when fewer than four bytes decode, and with `BadChecksum` when the last four bytes are not the first four bytes of the double SHA-256 of the rest.
pub fn decode_check(s: str) -> []u8 ! Error {
    let raw = decode_with(s, bitcoin())?
    verified(raw)?
}
