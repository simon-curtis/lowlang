pub struct Writer {
    buf: []u8
    n: i64
    indent: bool
    open: []str
    depth: i64
    tag_open: bool
    mixed: []bool
    nested: []bool
}

pub fn writer(indent: bool) -> *Writer {
    new(Writer { buf: __make(256), n: 0, indent, open: [], depth: 0, tag_open: false, mixed: [], nested: [] })
}

fn reserve(w: *Writer, extra: i64) {
    if w.n + extra <= w.buf.len {
        return
    }
    var size = w.buf.len * 2
    if size < w.n + extra {
        size = w.n + extra
    }
    let grown: []u8 = __make(size)
    __memmove(grown, w.buf[..w.n])
    w.buf = grown
}

fn emit(w: *Writer, s: str) {
    reserve(w, s.len)
    let at = w.n
    for i in 0..s.len {
        w.buf[at + i] = s[i]
    }
    w.n += s.len
}

fn emit_byte(w: *Writer, c: u8) {
    reserve(w, 1)
    w.buf[w.n] = c
    w.n += 1
}

fn close_tag(w: *Writer) {
    if w.tag_open {
        emit_byte(w, '>')
        w.tag_open = false
    }
}

fn line_break(w: *Writer) {
    if w.depth > 0 && w.mixed[w.depth - 1] {
        return
    }
    indent_line(w)
}

fn indent_line(w: *Writer) {
    if !w.indent || w.n == 0 {
        return
    }
    emit_byte(w, '\n')
    for _ in 0..w.depth {
        emit(w, "  ")
    }
}

fn child_written(w: *Writer) {
    if w.depth > 0 {
        w.nested[w.depth - 1] = true
    }
}

fn mark_mixed(w: *Writer) {
    if w.depth > 0 {
        w.mixed[w.depth - 1] = true
    }
}

pub fn write_declaration(w: *Writer) {
    emit(w, "<?xml version=\"1.0\" encoding=\"UTF-8\"?>")
}

pub fn start_element(w: *Writer, name: str) {
    close_tag(w)
    line_break(w)
    child_written(w)
    emit_byte(w, '<')
    emit(w, name)
    let inherited = w.depth > 0 && w.mixed[w.depth - 1]
    if w.depth < w.open.len {
        w.open[w.depth] = name
        w.mixed[w.depth] = inherited
        w.nested[w.depth] = false
    } else {
        push(mut w.open, name)
        push(mut w.mixed, inherited)
        push(mut w.nested, false)
    }
    w.depth += 1
    w.tag_open = true
}

pub fn write_attribute(w: *Writer, name: str, value: str) {
    if !w.tag_open {
        return
    }
    emit_byte(w, ' ')
    emit(w, name)
    emit(w, "=\"")
    escape(w, value, true)
    emit_byte(w, '"')
}

pub fn write_namespace(w: *Writer, prefix: str, uri: str) {
    write_attribute(w, if prefix == "" { "xmlns" } else { "xmlns:{prefix}" }, uri)
}

pub fn end_element(w: *Writer) {
    if w.depth == 0 {
        return
    }
    if w.tag_open {
        emit(w, "/>")
        w.tag_open = false
        w.depth -= 1
        return
    }
    let nested = w.nested[w.depth - 1] && !w.mixed[w.depth - 1]
    w.depth -= 1
    if nested {
        indent_line(w)
    }
    emit(w, "</")
    emit(w, w.open[w.depth])
    emit_byte(w, '>')
}

pub fn write_text(w: *Writer, s: str) {
    close_tag(w)
    mark_mixed(w)
    escape(w, s, false)
}

pub fn write_cdata(w: *Writer, s: str) {
    close_tag(w)
    mark_mixed(w)
    emit(w, "<![CDATA[")
    var from = 0
    for i in 0..s.len {
        if i + 2 < s.len && s[i] == ']' && s[i + 1] == ']' && s[i + 2] == '>' {
            emit(w, s[from..i + 2])
            emit(w, "]]><![CDATA[")
            from = i + 2
        }
    }
    emit(w, s[from..])
    emit(w, "]]>")
}

pub fn write_comment(w: *Writer, s: str) {
    close_tag(w)
    line_break(w)
    child_written(w)
    emit(w, "<!--")
    for i in 0..s.len {
        emit_byte(w, s[i])
        if s[i] == '-' && (i + 1 == s.len || s[i + 1] == '-') {
            emit_byte(w, ' ')
        }
    }
    emit(w, "-->")
}

pub fn write_instruction(w: *Writer, target: str, data: str) {
    close_tag(w)
    line_break(w)
    child_written(w)
    emit(w, "<?")
    emit(w, target)
    if data.len > 0 {
        emit_byte(w, ' ')
        for i in 0..data.len {
            emit_byte(w, data[i])
            if data[i] == '?' && i + 1 < data.len && data[i + 1] == '>' {
                emit_byte(w, ' ')
            }
        }
    }
    emit(w, "?>")
}

pub fn finish(w: *Writer) -> str {
    for w.depth > 0 {
        end_element(w)
    }
    __str_view(w.buf[..w.n])
}

fn escape(w: *Writer, s: str, attribute: bool) {
    var from = 0
    for i in 0..s.len {
        let c = s[i]
        var replacement = ""
        if c == '&' {
            replacement = "&amp;"
        } else if c == '<' {
            replacement = "&lt;"
        } else if c == '>' && !attribute {
            replacement = "&gt;"
        } else if c == '"' && attribute {
            replacement = "&quot;"
        } else if c == '\r' {
            replacement = "&#xD;"
        } else if c == '\n' && attribute {
            replacement = "&#xA;"
        } else if c == '\t' && attribute {
            replacement = "&#x9;"
        } else {
            continue
        }
        emit(w, s[from..i])
        emit(w, replacement)
        from = i + 1
    }
    emit(w, s[from..])
}

pub fn serialize(e: *Element, indent: bool) -> str {
    let w = writer(indent)
    write_element(w, e)
    finish(w)
}

fn write_element(w: *Writer, e: *Element) {
    start_element(w, qualified(e.name))
    for a in e.attributes {
        write_attribute(w, qualified(a.name), a.value)
    }
    for n in e.children {
        match n {
            Text(_) => mark_mixed(w)
            CData(_) => mark_mixed(w)
            _ => {}
        }
    }
    for n in e.children {
        match n {
            Element(c) => write_element(w, c)
            Text(v) => write_text(w, v)
            CData(v) => write_cdata(w, v)
            Comment(v) => write_comment(w, v)
            Instruction(target, d) => write_instruction(w, target, d)
        }
    }
    end_element(w)
}
