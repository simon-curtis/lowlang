import strings = std/text

pub struct Element {
    pub name: Name
    pub attributes: []Attribute
    pub children: []Node
}

pub enum Node {
    Element(*Element)
    Text(str)
    CData(str)
    Comment(str)
    Instruction(target: str, data: str)
}

struct Builder {
    stack: []*Element
    depth: i64
    text: Buffer
    first: str
    pieces: i64
}

pub fn parse(data: []u8) -> *Element ! Error {
    let r = reader(data)
    let b = new(Builder { stack: [], depth: 0, text: buffer(0), first: "", pieces: 0 })
    var root = new(Element { name: Name { prefix: "", local: "", namespace: "" }, attributes: [], children: [] })
    for {
        let t = next(r)?
        match t {
            StartElement(name, attributes, empty) => {
                flush(b)
                let e = element(b, name, attributes)
                if b.depth == 0 {
                    root = e
                } else {
                    add(b, Node.Element(e))
                }
                if !empty {
                    if b.depth < b.stack.len {
                        b.stack[b.depth] = e
                    } else {
                        push(mut b.stack, e)
                    }
                    b.depth += 1
                }
            }
            EndElement(_) => {
                flush(b)
                b.depth -= 1
            }
            Text(v) => pending(b, v)
            CData(v) => add(b, Node.CData(detach(v)))
            Comment(v) => add(b, Node.Comment(detach(v)))
            Instruction(target, d) => add(b, Node.Instruction(target, detach(d)))
            Doctype(_) => {}
            End => return root
        }
    }
}

fn pending(b: *Builder, v: str) {
    if b.pieces == 0 {
        b.first = v
    } else {
        if b.pieces == 1 {
            b.text.n = 0
            put_str(mut b.text, b.first)
        }
        put_str(mut b.text, v)
    }
    b.pieces += 1
}

fn flush(b: *Builder) {
    if b.pieces == 0 {
        return
    }
    let value = if b.pieces == 1 { detach(b.first) } else { detach(__str_view(contents(b.text))) }
    b.pieces = 0
    b.first = ""
    let parent = b.stack[b.depth - 1]
    push(mut parent.children, Node.Text(value))
}

fn add(b: *Builder, n: Node) {
    flush(b)
    if b.depth > 0 {
        let parent = b.stack[b.depth - 1]
        push(mut parent.children, n)
    }
}

fn detach(s: str) -> str {
    var out = buffer(s.len)
    put_str(mut out, s)
    __str_view(out.data)
}

fn element(b: *Builder, name: Name, attributes: []Attribute) -> *Element {
    let owned: []Attribute = __make(attributes.len)
    for i, a in attributes {
        owned[i] = Attribute { name: a.name, value: detach(a.value) }
    }
    new(Element { name, attributes: owned, children: [] })
}

pub fn qualified(n: Name) -> str {
    if n.prefix == "" { n.local } else { "{n.prefix}:{n.local}" }
}

pub fn attribute(e: *Element, local: str) -> str? {
    for a in e.attributes {
        if a.name.local == local && a.name.namespace != xmlns_namespace() {
            return a.value
        }
    }
    none
}

pub fn child(e: *Element, local: str) -> *Element? {
    for n in e.children {
        match n {
            Element(c) => {
                if c.name.local == local {
                    return c
                }
            }
            _ => {}
        }
    }
    none
}

pub fn children(e: *Element, local: str) -> []*Element {
    var out: []*Element = []
    for n in e.children {
        match n {
            Element(c) => {
                if local == "*" || c.name.local == local {
                    push(mut out, c)
                }
            }
            _ => {}
        }
    }
    out
}

pub fn text(e: *Element) -> str {
    if e.children.len == 1 {
        match e.children[0] {
            Text(v) => return v
            CData(v) => return v
            _ => {}
        }
    }
    var out = buffer(64)
    collect_text(e, mut out)
    __str_view(contents(out))
}

fn collect_text(e: *Element, mut out: Buffer) {
    for n in e.children {
        match n {
            Element(c) => collect_text(c, mut out)
            Text(v) => put_str(mut out, v)
            CData(v) => put_str(mut out, v)
            _ => {}
        }
    }
}

pub fn find(e: *Element, path: str) -> *Element? {
    var current = e
    for step in strings.split(path, '/') {
        if step == "" {
            continue
        }
        let found = if step == "*" { first_child(current) } else { child(current, step) }
        match found {
            some(c) => {
                current = c
            }
            none => return none
        }
    }
    current
}

fn first_child(e: *Element) -> *Element? {
    for n in e.children {
        match n {
            Element(c) => return c
            _ => {}
        }
    }
    none
}
