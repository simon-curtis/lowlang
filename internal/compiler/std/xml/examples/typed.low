import std/serde
import std/xml

struct Item {
    sku: str
    quantity: i64
    price: f64
}

struct Order {
    id: i64
    customer: str
    gift: bool?
    item: []Item
}

fn problem(e: serde.Error) -> str {
    match e {
        Syntax(at, message) => message
        Mismatch(expected, at) => "expected {expected}"
        Missing(field) => "missing {field}"
        UnknownVariant(name) => "unknown variant {name}"
        Range(at) => "out of range"
        TooDeep => "nested too deeply"
        TooLarge => "too large"
    }
}

fn read(label: str, source: str) {
    let order = xml.deserialize[Order](bytes(source)) catch {
        e => {
            print("{label}: {problem(e)}")
            return
        }
    }
    var total = 0.0
    for item in order.item {
        total += f64(item.quantity) * item.price
    }
    print("{label}: order {order.id} for {order.customer}, {order.item.len} items, total {total}")
}

/// Binds XML to a struct, where attributes and child elements both fill fields, and writes a value back as XML.
fn main() {
    read("elements", "<order><id>7</id><customer>Ada</customer><item><sku>A-1</sku><quantity>2</quantity><price>9.5</price></item><item><sku>B-2</sku><quantity>1</quantity><price>4</price></item></order>")
    read("attributes", "<order id=\"8\" customer=\"Bob\" gift=\"true\"><item sku=\"C-3\" quantity=\"3\" price=\"1.5\"/></order>")
    read("missing", "<order id=\"9\"><item sku=\"C\" quantity=\"1\" price=\"1\"/></order>")
    read("wrong type", "<order id=\"x\" customer=\"Eve\"/>")
    read("malformed", "<order id=\"1\"")

    let order = Order {
        id: 10,
        customer: "Cy & Co",
        gift: none,
        item: [Item { sku: "D-4", quantity: 5, price: 0.25 }],
    }
    print(xml.serialize_value("order", order))
}
