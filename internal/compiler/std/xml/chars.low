import std/simd
import std/text
import std/unicode
import std/unicode/utf16

struct Decoded {
    code: u32
    size: i64
}

fn decode_utf8(b: []u8, at: i64) -> Decoded {
    let view = __str_view(b)
    let r = unicode.decode_rune(view, at)
    if r.size == 1 && r.code == 0xFFFD {
        return Decoded { code: 0, size: 0 }
    }
    Decoded { code: r.code, size: r.size }
}

fn legal_char(c: u32) -> bool {
    if c < 0x20 {
        return c == 0x9 || c == 0xA || c == 0xD
    }
    if c < 0xD800 {
        return true
    }
    if c < 0xE000 {
        return false
    }
    if c < 0x10000 {
        return c != 0xFFFE && c != 0xFFFF
    }
    c <= 0x10FFFF
}

fn name_start_code(c: u32) -> bool {
    (c >= 0xC0 && c <= 0xD6) || (c >= 0xD8 && c <= 0xF6) || (c >= 0xF8 && c <= 0x2FF) || (c >= 0x370 && c <= 0x37D) || (c >= 0x37F && c <= 0x1FFF) || (c >= 0x200C && c <= 0x200D) || (c >= 0x2070 && c <= 0x218F) || (c >= 0x2C00 && c <= 0x2FEF) || (c >= 0x3001 && c <= 0xD7FF) || (c >= 0xF900 && c <= 0xFDCF) || (c >= 0xFDF0 && c <= 0xFFFD) || (c >= 0x10000 && c <= 0xEFFFF)
}

fn name_code(c: u32) -> bool {
    name_start_code(c) || c == 0xB7 || (c >= 0x300 && c <= 0x36F) || (c >= 0x203F && c <= 0x2040)
}

fn name_table() -> []u8 {
    let t: []u8 = __make(256)
    for c in 0..256 {
        let b = u8(c)
        if (b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z') || b == '_' || b == ':' {
            t[c] = 2
        } else if (b >= '0' && b <= '9') || b == '-' || b == '.' {
            t[c] = 1
        }
    }
    t
}

fn space(c: u8) -> bool {
    c == ' ' || c == '\n' || c == '\t' || c == '\r'
}

struct Buffer {
    data: []u8
    n: i64
}

fn buffer(capacity: i64) -> Buffer {
    Buffer { data: __make(capacity), n: 0 }
}

fn room(mut b: Buffer, extra: i64) {
    if b.n + extra <= b.data.len {
        return
    }
    var size = b.data.len * 2 + 16
    if size < b.n + extra {
        size = b.n + extra
    }
    let grown: []u8 = __make(size)
    __memmove(grown, b.data[..b.n])
    b.data = grown
}

fn put(mut b: Buffer, c: u8) {
    room(mut b, 1)
    b.data[b.n] = c
    b.n += 1
}

fn put_bytes(mut b: Buffer, s: []u8) {
    room(mut b, s.len)
    __memmove(b.data[b.n..], s)
    b.n += s.len
}

fn put_str(mut b: Buffer, s: str) {
    room(mut b, s.len)
    let d = b.data
    let at = b.n
    for i in 0..s.len {
        d[at + i] = s[i]
    }
    b.n += s.len
}

fn put_code(mut b: Buffer, code: u32) {
    room(mut b, 4)
    text.put_char(b.data, b.n, code)
    b.n += text.char_len(code)
}

fn contents(b: Buffer) -> []u8 {
    b.data[..b.n]
}

fn from_utf16(data: []u8, start: i64, big: bool) -> []u8? {
    let order = if big { utf16.Order.Big } else { utf16.Order.Little }
    let units = utf16.from_bytes(data[start..], order) catch {
        _ => return none
    }
    let decoded = utf16.decode(units) catch {
        _ => return none
    }
    bytes(decoded)
}

fn from_latin1(data: []u8) -> []u8 {
    var out = buffer(data.len + data.len / 8)
    for c in data {
        put_code(mut out, u32(c))
    }
    contents(out)
}

fn normalize_newlines(data: []u8) -> []u8 {
    let first = simd.find_byte(data, 0, data.len, '\r')
    if first < 0 {
        return data
    }
    let out: []u8 = __make(data.len)
    __memmove(out, data[..first])
    var n = first
    var i = first
    for i < data.len {
        let next = simd.find_byte(data, i, data.len, '\r')
        if next < 0 {
            __memmove(out[n..], data[i..])
            n += data.len - i
            break
        }
        __memmove(out[n..], data[i..next])
        n += next - i
        out[n] = '\n'
        n += 1
        i = next + 1
        if i < data.len && data[i] == '\n' {
            i += 1
        }
    }
    out[..n]
}
