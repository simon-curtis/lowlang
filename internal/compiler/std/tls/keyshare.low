import std/crypto/ecdsa
import std/crypto/mlkem
import std/crypto/x25519
import std/io

pub fn x25519_mlkem768() -> i64 {
    0x11EC
}

pub fn group_x25519() -> i64 {
    0x001D
}

pub fn group_p256() -> i64 {
    0x0017
}

pub fn group_p384() -> i64 {
    0x0018
}

fn supported_group(g: i64) -> bool {
    g == x25519_mlkem768() || g == group_x25519() || g == group_p256() || g == group_p384()
}

struct Share {
    group: i64
    private: []u8
    decapsulation: []u8
    public: []u8
}

fn curve(g: i64) -> ecdsa.Curve {
    if g == group_p384() { P384 } else { P256 }
}

fn client_share(g: i64) -> Share ! io.Error {
    if g == x25519_mlkem768() {
        let keys = mlkem.generate(Kem768)
        let private = x25519.generate()
        var public: []u8 = []
        io.append(mut public, keys.encapsulation)
        io.append(mut public, x25519.public_key(private))
        return Share { group: g, private, decapsulation: keys.decapsulation, public }
    }
    if g == group_x25519() {
        let private = x25519.generate()
        return Share { group: g, private, decapsulation: [], public: x25519.public_key(private) }
    }
    let private = ecdsa.generate(curve(g))
    Share { group: g, private, decapsulation: [], public: ecdsa.public_key(curve(g), private)? }
}

fn client_secret(s: Share, server: []u8) -> []u8 ! io.Error {
    if s.group == x25519_mlkem768() {
        if server.len != 1088 + 32 {
            fail Invalid
        }
        var secret: []u8 = []
        io.append(mut secret, mlkem.decapsulate(Kem768, s.decapsulation, server[..1088])?)
        io.append(mut secret, x25519.shared(s.private, server[1088..])?)
        return secret
    }
    if s.group == group_x25519() {
        return x25519.shared(s.private, server)
    }
    ecdsa.ecdh(curve(s.group), s.private, server)
}

struct Exchanged {
    public: []u8
    secret: []u8
}

fn server_exchange(g: i64, client: []u8) -> Exchanged ! io.Error {
    if g == x25519_mlkem768() {
        if client.len != 1184 + 32 {
            fail Invalid
        }
        let sealed = mlkem.encapsulate(Kem768, client[..1184])?
        let private = x25519.generate()
        var public: []u8 = []
        io.append(mut public, sealed.ciphertext)
        io.append(mut public, x25519.public_key(private))
        var secret: []u8 = []
        io.append(mut secret, sealed.shared)
        io.append(mut secret, x25519.shared(private, client[1184..])?)
        return Exchanged { public, secret }
    }
    if g == group_x25519() {
        let private = x25519.generate()
        return Exchanged { public: x25519.public_key(private), secret: x25519.shared(private, client)? }
    }
    let private = ecdsa.generate(curve(g))
    Exchanged { public: ecdsa.public_key(curve(g), private)?, secret: ecdsa.ecdh(curve(g), private, client)? }
}
