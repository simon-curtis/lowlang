import std/io

struct Record {
    kind: i64
    data: []u8
}

struct Channel {
    stream: io.Stream
    reader: *io.Reader
    read_key: *Protection?
    write_key: *Protection?
    write_lock: chan[bool]
    pending: []u8
    plaintext_version: i64
    version: i64
    closed: bool
    failed: bool
    quic: QuicTransport?
    read_level: Level
    write_level: Level
}

fn channel(s: io.Stream) -> *Channel {
    new(Channel {
        stream: s
        reader: io.reader(s)
        read_key: none
        write_key: none
        write_lock: chan[bool](1)
        pending: []
        plaintext_version: 0x0303
        version: 0
        closed: false
        failed: false
        quic: none
        read_level: Level.Initial
        write_level: Level.Initial
    })
}

fn quic_channel(t: QuicTransport) -> *Channel {
    let empty = io.bytes_reader([])
    new(Channel {
        stream: io.reader_stream(empty)
        reader: empty
        read_key: none
        write_key: none
        write_lock: chan[bool](1)
        pending: []
        plaintext_version: 0x0303
        version: 0x0304
        closed: false
        failed: false
        quic: t
        read_level: Level.Initial
        write_level: Level.Initial
    })
}

fn is_quic(c: *Channel) -> bool {
    match c.quic {
        some(_) => true
        none => false
    }
}

fn next_level(l: Level) -> Level {
    match l {
        Initial => Level.Handshake
        _ => Level.Application
    }
}

fn set_read_key(c: *Channel, suite: Suite, secret: []u8) ! io.Error {
    match c.quic {
        some(t) => {
            if c.pending.len > 0 {
                send_alert(c, 10)
                fail Malformed
            }
            c.read_level = next_level(c.read_level)
            let installed = QuicSecret { level: c.read_level, writing: false, suite, secret }
            t.install(installed)?
        }
        none => {
            c.read_key = protection(suite, secret)?
        }
    }
}

fn set_write_key(c: *Channel, suite: Suite, secret: []u8) ! io.Error {
    match c.quic {
        some(t) => {
            c.write_level = next_level(c.write_level)
            let installed = QuicSecret { level: c.write_level, writing: true, suite, secret }
            t.install(installed)?
        }
        none => {
            c.write_key = protection(suite, secret)?
        }
    }
}

fn write_quic(c: *Channel, t: QuicTransport, kind: i64, payload: []u8) ! io.Error {
    if c.failed {
        fail Aborted
    }
    if kind == 22 {
        t.send(c.write_level, payload)?
    }
}

fn read_quic(c: *Channel, t: QuicTransport) -> Record ! io.Error {
    let received = t.receive()?
    if received.level != c.read_level {
        send_alert(c, 10)
        fail Malformed
    }
    Record { kind: 22, data: received.data }
}

fn write_record(c: *Channel, kind: i64, payload: []u8) ! io.Error {
    match c.quic {
        some(t) => {
            write_quic(c, t, kind, payload)?
            return
        }
        none => {}
    }
    c.write_lock <- true
    defer <-c.write_lock
    write_locked(c, kind, payload)?
}

fn write_locked(c: *Channel, kind: i64, payload: []u8) ! io.Error {
    if c.failed {
        fail Aborted
    }
    var out: []u8 = []
    append_records(c, mut out, kind, payload)
    io.write_all(c.stream, out)?
}

fn write_change_cipher(c: *Channel, flight: []u8, key: *Protection, finished: []u8) ! io.Error {
    c.write_lock <- true
    defer <-c.write_lock
    var out: []u8 = []
    if flight.len > 0 {
        append_records(c, mut out, 22, flight)
    }
    seal_into(c, mut out, 20, [1])
    c.write_key = key
    append_records(c, mut out, 22, finished)
    io.write_all(c.stream, out)?
}

fn append_records(c: *Channel, mut out: []u8, kind: i64, payload: []u8) {
    var at = 0
    for at == 0 || at < payload.len {
        let size = if payload.len - at > 16384 { 16384 } else { payload.len - at }
        seal_into(c, mut out, kind, payload[at..at + size])
        at += size
        if payload.len == 0 {
            break
        }
    }
}

fn seal_into(c: *Channel, mut out: []u8, kind: i64, fragment: []u8) {
    match c.write_key {
        some(key) => {
            if c.version == 0x0303 {
                seal12(key, mut out, kind, fragment)
                return
            }
            var inner: []u8 = []
            io.append(mut inner, fragment)
            push(mut inner, u8(kind))
            var header: []u8 = [23, 3, 3]
            io.put_be16(mut header, inner.len + key.cipher.tag_size)
            let sealed = key.cipher.seal(nonce(key), inner, header)
            io.append(mut out, header)
            io.append(mut out, sealed)
        }
        none => {
            push(mut out, u8(kind))
            io.put_be16(mut out, c.plaintext_version)
            io.put_be16(mut out, fragment.len)
            io.append(mut out, fragment)
        }
    }
}

fn additional_data(seq: u64, kind: i64, size: i64) -> []u8 {
    var aad: []u8 = []
    io.put_be64(mut aad, i64(seq))
    push(mut aad, u8(kind))
    io.put_be16(mut aad, 0x0303)
    io.put_be16(mut aad, size)
    aad
}

fn seal12(key: *Protection, mut out: []u8, kind: i64, fragment: []u8) {
    let aad = additional_data(key.seq, kind, fragment.len)
    let n = nonce(key)
    let sealed = key.cipher.seal(n, fragment, aad)
    let explicit = if key.explicit { 8 } else { 0 }
    push(mut out, u8(kind))
    io.put_be16(mut out, 0x0303)
    io.put_be16(mut out, explicit + sealed.len)
    if key.explicit {
        io.append(mut out, n[4..])
    }
    io.append(mut out, sealed)
}

fn open12(c: *Channel, key: *Protection, kind: i64, body: []u8) -> Record ! io.Error {
    let explicit = if key.explicit { 8 } else { 0 }
    let overhead = explicit + key.cipher.tag_size
    if body.len < overhead {
        send_alert(c, 20)
        fail Invalid
    }
    let aad = additional_data(key.seq, kind, body.len - overhead)
    let n = nonce(key)
    if key.explicit {
        io.copy(n[4..], body[..8])
    }
    let data = key.cipher.open(n, body[explicit..], aad) or {
        send_alert(c, 20)
        fail Invalid
    }
    if data.len > 16384 {
        send_alert(c, 22)
        fail Malformed
    }
    Record { kind, data }
}

fn read_record(c: *Channel) -> Record ! io.Error {
    if c.failed {
        fail Aborted
    }
    match c.quic {
        some(t) => {
            return read_quic(c, t)
        }
        none => {}
    }
    let tls12 = c.version == 0x0303
    let limit = if tls12 { 16384 + 2048 } else { 16384 + 256 }
    for {
        let header = io.read_exact(c.reader, 5)?
        let kind = i64(header[0])
        let size = io.be16(header, 3)
        if size > limit {
            send_alert(c, 22)
            fail Malformed
        }
        let body = io.read_exact(c.reader, size)?
        if kind == 20 && !tls12 {
            continue
        }
        match c.read_key {
            some(key) => {
                if tls12 {
                    return open12(c, key, kind, body)
                }
                if kind != 23 {
                    if kind == 21 {
                        return Record { kind, data: body }
                    }
                    send_alert(c, 10)
                    fail Malformed
                }
                let inner = key.cipher.open(nonce(key), body, header) or {
                    send_alert(c, 20)
                    fail Invalid
                }
                var end = inner.len
                for end > 0 && inner[end - 1] == 0 {
                    end -= 1
                }
                if end == 0 || end - 1 > 16384 {
                    send_alert(c, 22)
                    fail Malformed
                }
                return Record { kind: i64(inner[end - 1]), data: inner[..end - 1] }
            }
            none => {
                if size > 16384 {
                    send_alert(c, 22)
                    fail Malformed
                }
                return Record { kind, data: body }
            }
        }
    }
}

fn read_change_cipher(c: *Channel) ! io.Error {
    if c.pending.len > 0 {
        send_alert(c, 10)
        fail Malformed
    }
    let r = read_record(c)?
    if r.kind == 21 {
        fail alert(r.data)
    }
    if r.kind != 20 || r.data.len != 1 || r.data[0] != 1 {
        send_alert(c, 10)
        fail Malformed
    }
}

struct Message {
    kind: i64
    body: []u8
    raw: []u8
}

fn read_handshake(c: *Channel) -> Message ! io.Error {
    for c.pending.len < 4 || c.pending.len < 4 + io.be24(c.pending, 1) {
        let r = read_record(c)?
        if r.kind == 21 {
            fail alert(r.data)
        }
        if r.kind != 22 {
            send_alert(c, 10)
            fail Malformed
        }
        io.append(mut c.pending, r.data)
        if c.pending.len >= 4 && io.be24(c.pending, 1) > 65536 {
            send_alert(c, 22)
            fail TooLarge
        }
    }
    let size = 4 + io.be24(c.pending, 1)
    var raw: []u8 = []
    io.append(mut raw, c.pending[..size])
    var rest: []u8 = []
    io.append(mut rest, c.pending[size..])
    c.pending = rest
    Message { kind: i64(raw[0]), body: raw[4..], raw }
}

fn alert(data: []u8) -> io.Error {
    if data.len >= 2 && data[1] == 0 {
        return io.Error.Eof
    }
    io.Error.Refused
}

fn send_alert(c: *Channel, description: i64) {
    match c.quic {
        some(t) => {
            t.alert(description)
        }
        none => {
            write_record(c, 21, [2, u8(description)]) or {}
        }
    }
    c.failed = true
}

fn warn(c: *Channel, description: i64) {
    if is_quic(c) {
        return
    }
    write_record(c, 21, [1, u8(description)]) or {}
}

fn abort(c: *Channel, description: i64, e: io.Error) -> io.Error {
    send_alert(c, description)
    e
}

fn handshake_message(kind: i64, body: []u8) -> []u8 {
    var out: []u8 = []
    push(mut out, u8(kind))
    io.put_be24(mut out, body.len)
    io.append(mut out, body)
    out
}
