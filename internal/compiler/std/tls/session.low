import std/crypto/hash
import std/crypto/x509
import std/io

pub struct Config {
    pub server_name: str = ""
    pub alpn: []str = []
    pub roots: []x509.Certificate = []
    pub verify: bool = true
    pub groups: []i64 = [0x11EC, 0x001D, 0x0017, 0x0018]
    pub certificates: [][]u8 = []
    pub key: x509.PrivateKey? = none
}

pub struct Session {
    channel: *Channel
    pub protocol: str
    pub group: i64
    pub suite: Suite
    pub peer_certificates: []x509.Certificate
    buffered: []u8
    done: bool
}

fn session(c: *Channel, protocol: str, group: i64, suite: Suite, peers: []x509.Certificate) -> *Session {
    new(Session { channel: c, protocol, group, suite, peer_certificates: peers, buffered: [], done: false })
}

fn signature_schemes() -> []i64 {
    [0x0403, 0x0503, 0x0804, 0x0805, 0x0806, 0x0807, 0x0401, 0x0501, 0x0601]
}

fn retry_random() -> []u8 {
    [
        0xCF, 0x21, 0xAD, 0x74, 0xE5, 0x9A, 0x61, 0x11, 0xBE, 0x1D, 0x8C, 0x02, 0x1E, 0x65, 0xB8, 0x91,
        0xC2, 0xA2, 0x11, 0x16, 0x7A, 0xBB, 0x8C, 0x5E, 0x07, 0x9E, 0x09, 0xE2, 0xC8, 0xA8, 0x33, 0x9C,
    ]
}

fn message_hash(h: hash.Algorithm, first: []u8) -> []u8 {
    var out: []u8 = [254, 0, 0, u8(h.size)]
    io.append(mut out, hash.sum(h, first))
    out
}

fn verify_content(h: hash.Algorithm, transcript: []u8, server: bool) -> []u8 {
    var out: []u8 = []
    for _ in 0..64 {
        push(mut out, 0x20)
    }
    io.append_str(mut out, if server { "TLS 1.3, server CertificateVerify" } else { "TLS 1.3, client CertificateVerify" })
    push(mut out, 0)
    io.append(mut out, hash.sum(h, transcript))
    out
}

fn on_post_handshake(t: *Session, m: Message) ! io.Error {
    if m.kind == 4 {
        return
    }
    if m.kind != 24 || m.body.len != 1 || m.body[0] > 1 {
        fail Malformed
    }
    let c = t.channel
    match c.read_key {
        some(key) => {
            c.read_key = updated(key)?
        }
        none => fail Malformed
    }
    if m.body[0] == 1 {
        c.write_lock <- true
        defer <-c.write_lock
        write_locked(c, 22, handshake_message(24, [0]))?
        match c.write_key {
            some(key) => {
                c.write_key = updated(key)?
            }
            none => fail Malformed
        }
    }
}

pub fn read(t: *Session, buf: []u8) -> i64 ! io.Error {
    let c = t.channel
    for t.buffered.len == 0 {
        if t.done {
            return 0
        }
        let r = read_record(c)?
        if r.kind == 23 {
            t.buffered = r.data
        } else if r.kind == 22 {
            io.append(mut c.pending, r.data)
            for c.pending.len >= 4 && c.pending.len >= 4 + io.be24(c.pending, 1) {
                let m = read_handshake(c)?
                on_post_handshake(t, m)?
            }
        } else if r.kind == 21 {
            if r.data.len >= 2 && r.data[1] == 0 {
                t.done = true
                return 0
            }
            fail Refused
        } else {
            fail Malformed
        }
    }
    let n = io.copy(buf, t.buffered)
    t.buffered = t.buffered[n..]
    n
}

pub fn write(t: *Session, data: []u8) -> i64 ! io.Error {
    write_record(t.channel, 23, data)?
    data.len
}

pub fn update_keys(t: *Session, request_peer: bool) ! io.Error {
    let c = t.channel
    c.write_lock <- true
    defer <-c.write_lock
    write_locked(c, 22, handshake_message(24, [if request_peer { 1 } else { 0 }]))?
    match c.write_key {
        some(key) => {
            c.write_key = updated(key)?
        }
        none => fail Malformed
    }
}

pub fn close(t: *Session) {
    if !t.channel.closed {
        t.channel.closed = true
        send_alert(t.channel, 0)
        t.channel.stream.close()
    }
}

pub fn stream(t: *Session) -> io.Stream {
    io.Stream {
        read: fn(buf) { read(t, buf) }
        write: fn(data) { write(t, data) }
        close: fn() { close(t) }
    }
}

fn parse_certificates(body: []u8) -> []x509.Certificate ! io.Error {
    let c = cursor(body)
    vector8(c)?
    let list = cursor(vector24(c)?)
    end(c)?
    var out: []x509.Certificate = []
    for left(list) > 0 {
        let der = vector24(list)?
        vector16(list)?
        push(mut out, x509.parse(der)?)
    }
    out
}

fn certificate_message(context: []u8, chain: [][]u8) -> []u8 {
    var list: []u8 = []
    for der in chain {
        put_vector24(mut list, der)
        io.put_be16(mut list, 0)
    }
    var body: []u8 = []
    put_vector8(mut body, context)
    put_vector24(mut body, list)
    handshake_message(11, body)
}
