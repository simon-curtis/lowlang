import std/crypto/hash
import std/crypto/x509
import std/io
import std/text

/// The settings of a TLS client or server, shared by `client`, `server` and `dial`.
///
/// The defaults give a verifying client for TLS 1.2 and 1.3. A server also needs `certificates` and `key`.
pub struct Config {
    /// The host name the client sends as the SNI (RFC 6066) and verifies the certificate against. An IP address is not sent as SNI. The empty string, the default, sends no name and, with `verify` on, accepts any certificate name.
    pub server_name: str = ""
    /// The application protocols for ALPN (RFC 7301), such as `["h2", "http/1.1"]`. A client offers them and fails with `Malformed` when the server selects one not listed. A server selects the first of its own that the client offers, or none. Empty by default.
    pub alpn: []str = []
    /// The trust anchors a client verifies the server chain against. When empty, the default, the system roots from `x509.system_roots` are used.
    pub roots: []x509.Certificate = []
    /// Whether a client verifies the server certificate chain and name. Defaults to `true`; `false` accepts any certificate and removes the protection against an active attacker.
    pub verify: bool = true
    /// The named group codes for key exchange in order of preference, from `x25519_mlkem768`, `group_x25519`, `group_p256` and `group_p384`. The default is all four in that order. A client sends a key share for the first one, and also for X25519 when the first is the hybrid.
    pub groups: []i64 = [0x11EC, 0x001D, 0x0017, 0x0018]
    /// The cipher suite codes in order of preference. The default is `0x1301`, `0x1303` and `0x1302` for TLS 1.3 and for TLS 1.2 the ECDHE suites with AES-128-GCM, ChaCha20-Poly1305 and AES-256-GCM, for ECDSA (`0xC02B`, `0xCCA9`, `0xC02C`) and RSA (`0xC02F`, `0xCCA8`, `0xC030`) certificates.
    pub cipher_suites: []i64 = [0x1301, 0x1303, 0x1302, 0xC02B, 0xC02F, 0xCCA9, 0xCCA8, 0xC02C, 0xC030]
    /// The lowest protocol version accepted, as `tls12()` or `tls13()`. Defaults to TLS 1.2. A range outside TLS 1.2 to 1.3 makes the handshake fail with `Invalid`.
    pub min_version: i64 = 0x0303
    /// The highest protocol version accepted, as `tls12()` or `tls13()`. Defaults to TLS 1.3.
    pub max_version: i64 = 0x0304
    /// For a server, the DER encoded certificate chain it presents, leaf first; see `x509.pem_certificates`. Unused by a client.
    pub certificates: [][]u8 = []
    /// For a server, the private key of the leaf certificate; see `x509.pem_private_key`. Unused by a client.
    pub key: x509.PrivateKey? = none
}

/// An established TLS connection that closes itself when dropped.
///
/// Dropping it sends a `close_notify` alert and closes the underlying stream. `handle` is the copyable view used by `read_on`, `write_on`, `close_on` and `stream_on`.
pub struct Session {
    /// The copyable view of this connection.
    pub handle: *SessionHandle
    drop close_on(handle)
}

/// A copyable view of an established TLS connection.
///
/// Copies refer to the same connection. Closing through any copy closes it for all of them.
pub struct SessionHandle {
    channel: *Channel
    /// The ALPN protocol that was negotiated, or the empty string when none was.
    pub protocol: str
    /// The negotiated protocol version: `0x0303` for TLS 1.2 or `0x0304` for TLS 1.3.
    pub version: i64
    /// The named group code of the key exchange.
    pub group: i64
    /// The authenticated cipher in use.
    pub suite: Suite
    /// The negotiated cipher suite as its code on the wire.
    pub cipher_suite: i64
    /// The certificate chain the server presented, leaf first. Empty on the server side, which does not request client certificates.
    pub peer_certificates: []x509.Certificate
    buffered: []u8
    done: bool
}

fn session(c: *Channel, protocol: str, group: i64, suite: Suite, code: i64, peers: []x509.Certificate) -> *SessionHandle {
    new(SessionHandle {
        channel: c
        protocol
        version: c.version
        group
        suite
        cipher_suite: code
        peer_certificates: peers
        buffered: []
        done: false
    })
}

/// Returns the TLS 1.2 protocol version code, `0x0303`.
pub fn tls12() -> i64 {
    0x0303
}

/// Returns the TLS 1.3 protocol version code, `0x0304`.
pub fn tls13() -> i64 {
    0x0304
}

fn versions_valid(config: Config) -> bool {
    config.min_version >= 0x0303 && config.max_version <= 0x0304 && config.min_version <= config.max_version
}

fn offers12(config: Config) -> bool {
    config.min_version <= 0x0303
}

fn offers13(config: Config) -> bool {
    config.max_version >= 0x0304
}

fn retry_random() -> []u8 {
    [
        0xCF, 0x21, 0xAD, 0x74, 0xE5, 0x9A, 0x61, 0x11, 0xBE, 0x1D, 0x8C, 0x02, 0x1E, 0x65, 0xB8, 0x91,
        0xC2, 0xA2, 0x11, 0x16, 0x7A, 0xBB, 0x8C, 0x5E, 0x07, 0x9E, 0x09, 0xE2, 0xC8, 0xA8, 0x33, 0x9C,
    ]
}

fn message_hash(h: hash.Algorithm, first: []u8) -> []u8 {
    var out: []u8 = [254, 0, 0, u8(h.size)]
    io.append(mut out, hash.sum(h, first))
    out
}

fn verify_content(h: hash.Algorithm, transcript: []u8) -> []u8 {
    var out: []u8 = []
    for _ in 0..64 {
        push(mut out, 0x20)
    }
    text.append(mut out, "TLS 1.3, server CertificateVerify")
    push(mut out, 0)
    io.append(mut out, hash.sum(h, transcript))
    out
}

fn on_post_handshake(t: *SessionHandle, m: Message) ! io.Error {
    let c = t.channel
    if c.version == 0x0303 {
        if m.kind == 0 || m.kind == 1 {
            warn(c, 100)
            return
        }
        fail abort(c, 10, Malformed)
    }
    if m.kind == 4 {
        return
    }
    if m.kind != 24 || m.body.len != 1 || m.body[0] > 1 {
        fail Malformed
    }
    match c.read_key {
        some(key) => {
            c.read_key = updated(key)?
        }
        none => fail Malformed
    }
    if m.body[0] == 1 {
        send_key_update(c, false)?
    }
}

fn send_key_update(c: *Channel, request_peer: bool) ! io.Error {
    c.write_lock <- true
    defer <-c.write_lock
    write_locked(c, 22, handshake_message(24, [if request_peer { 1 } else { 0 }]))?
    match c.write_key {
        some(key) => {
            c.write_key = updated(key)?
        }
        none => fail Malformed
    }
}

/// Reads up to `buf.len` decrypted bytes into `buf` and returns the count, or `0` when the peer has sent `close_notify`.
///
/// Blocks the green thread until application data arrives. Handshake messages that arrive in between are handled: a TLS 1.3 key update is applied, session tickets are ignored, and a TLS 1.2 renegotiation request is refused with a `no_renegotiation` alert. Fails with `NotConnected` after `close`, with `Refused` when the peer sends a fatal alert and with `Malformed` for an unexpected record.
pub fn read(t: Session, buf: []u8) -> i64 ! io.Error {
    read_on(t.handle, buf)
}

/// Reads up to `buf.len` decrypted bytes through the view `t`. See `read`.
pub fn read_on(t: *SessionHandle, buf: []u8) -> i64 ! io.Error {
    let c = t.channel
    if c.closed {
        fail NotConnected
    }
    for t.buffered.len == 0 {
        if t.done {
            return 0
        }
        let r = read_record(c)?
        if r.kind == 23 {
            t.buffered = r.data
        } else if r.kind == 22 {
            io.append(mut c.pending, r.data)
            for c.pending.len >= 4 && c.pending.len >= 4 + io.be24(c.pending, 1) {
                let m = read_handshake(c)?
                on_post_handshake(t, m)?
            }
        } else if r.kind == 21 {
            if r.data.len >= 2 && r.data[1] == 0 {
                t.done = true
                return 0
            }
            if c.version == 0x0303 && r.data.len == 2 && r.data[0] == 1 {
                continue
            }
            c.failed = true
            fail Refused
        } else {
            fail abort(c, 10, Malformed)
        }
    }
    let n = io.copy(buf, t.buffered)
    t.buffered = t.buffered[n..]
    n
}

/// Encrypts and writes all of `data` and returns `data.len`.
///
/// Data is sent in records of at most 16384 bytes. Blocks the green thread until the bytes are handed to the underlying stream. Fails with `NotConnected` after `close`, with `Aborted` after a fatal error on the connection and otherwise with the stream's error.
pub fn write(t: Session, data: []u8) -> i64 ! io.Error {
    write_on(t.handle, data)
}

/// Encrypts and writes all of `data` through the view `t`. See `write`.
pub fn write_on(t: *SessionHandle, data: []u8) -> i64 ! io.Error {
    if t.channel.closed {
        fail NotConnected
    }
    write_record(t.channel, 23, data)?
    data.len
}

/// Rotates the sending keys with a TLS 1.3 `KeyUpdate` (RFC 8446 section 4.6.3).
///
/// With `request_peer` set, the peer is asked to rotate its sending keys too. Fails with `Unsupported` on a TLS 1.2 connection and with `NotConnected` after `close`.
pub fn update_keys(t: Session, request_peer: bool) ! io.Error {
    let c = t.handle.channel
    if c.closed {
        fail NotConnected
    }
    if c.version != 0x0304 {
        fail Unsupported
    }
    send_key_update(c, request_peer)?
}

/// Sends a `close_notify` alert and closes the underlying stream.
///
/// Closing an already closed session does nothing. The alert is best effort and its failure is ignored. Later reads and writes fail with `NotConnected`.
pub fn close(t: Session) {
    close_on(t.handle)
}

/// Sends a `close_notify` alert and closes the underlying stream through the view `t`. See `close`.
pub fn close_on(t: *SessionHandle) {
    if !t.channel.closed {
        t.channel.closed = true
        warn(t.channel, 0)
        t.channel.stream.close()
    }
}

/// Returns an `io.Stream` over `t` whose `read`, `write` and `close` are `read`, `write` and `close`.
pub fn stream(t: Session) -> io.Stream {
    stream_on(t.handle)
}

/// Returns an `io.Stream` over the view `t`.
///
/// Streams made from the same view share the connection, and closing one closes it for all.
pub fn stream_on(t: *SessionHandle) -> io.Stream {
    io.Stream {
        read: fn(buf) { read_on(t, buf) }
        write: fn(data) { write_on(t, data) }
        close: fn() { close_on(t) }
    }
}

fn parse_certificates(body: []u8) -> []x509.Certificate ! io.Error {
    let c = cursor(body)
    vector8(c)?
    let list = cursor(vector24(c)?)
    end(c)?
    var out: []x509.Certificate = []
    for left(list) > 0 {
        let der = vector24(list)?
        vector16(list)?
        push(mut out, x509.parse(der)?)
    }
    out
}

fn parse_certificates12(body: []u8) -> []x509.Certificate ! io.Error {
    let c = cursor(body)
    let list = cursor(vector24(c)?)
    end(c)?
    var out: []x509.Certificate = []
    for left(list) > 0 {
        let der = vector24(list)?
        push(mut out, x509.parse(der)?)
    }
    out
}

fn certificate_message12(chain: [][]u8) -> []u8 {
    var list: []u8 = []
    for der in chain {
        put_vector24(mut list, der)
    }
    var body: []u8 = []
    put_vector24(mut body, list)
    handshake_message(11, body)
}

fn certificate_message(context: []u8, chain: [][]u8) -> []u8 {
    var list: []u8 = []
    for der in chain {
        put_vector24(mut list, der)
        io.put_be16(mut list, 0)
    }
    var body: []u8 = []
    put_vector8(mut body, context)
    put_vector24(mut body, list)
    handshake_message(11, body)
}
