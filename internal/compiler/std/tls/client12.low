import std/crypto/hash
import std/crypto/x509
import std/io

struct ServerExchange {
    group: i64
    public: []u8
    params: []u8
    scheme: i64
    signature: []u8
}

fn parse_server_exchange(body: []u8) -> ServerExchange ! io.Error {
    let c = cursor(body)
    if u8_of(c)? != 3 {
        fail Unsupported
    }
    let group = u16_of(c)?
    let public = vector8(c)?
    let params = body[..c.at]
    let scheme = u16_of(c)?
    let signature = vector16(c)?
    end(c)?
    ServerExchange { group, public, params, scheme, signature }
}

fn uncompressed_points(c: *Channel, exts: []Extension) ! io.Error {
    let formats = match find(exts, 11) {
        some(found) => found
        none => return
    }
    let fc = cursor(formats)
    let list = vector8(fc) catch {
        _ => fail abort(c, 50, Malformed)
    }
    end(fc) catch {
        _ => fail abort(c, 50, Malformed)
    }
    for f in list {
        if f == 0 {
            return
        }
    }
    fail abort(c, 47, Unsupported)
}

fn check_server_extensions(c: *Channel, hello: ServerHello) ! io.Error {
    for e in hello.exts {
        if !contains([0, 11, 16, 23, 0xFF01], e.kind) {
            fail abort(c, 110, Unsupported)
        }
    }
    let renegotiation = find(hello.exts, 0xFF01) ?? []
    if renegotiation.len != 1 || renegotiation[0] != 0 {
        fail abort(c, 40, Unsupported)
    }
    let extended = find(hello.exts, 23) ?? [1]
    if extended.len != 0 {
        fail abort(c, 40, Unsupported)
    }
    uncompressed_points(c, hello.exts)?
}

fn client12(c: *Channel, config: Config, offer: Offer, handshake: []u8, hello: ServerHello) -> *SessionHandle ! io.Error {
    let suite = match suite12_of(hello.code) {
        some(found) => found
        none => fail abort(c, 47, Unsupported)
    }
    if !contains(offer.suites, hello.code) || hash.equal(hello.session_id, offer.session_id) {
        fail abort(c, 47, Unsupported)
    }
    check_server_extensions(c, hello)?
    let protocol = negotiated_protocol(c, config, hello.exts)?
    var transcript = handshake
    let certificate = expect_message(c, 11)?
    let chain = parse_certificates12(certificate.body) catch {
        _ => fail abort(c, 50, Malformed)
    }
    io.append(mut transcript, certificate.raw)
    checked_server(c, config, chain)?
    let exchange_message = expect_message(c, 12)?
    let exchange = parse_server_exchange(exchange_message.body) catch {
        _ => fail abort(c, 50, Malformed)
    }
    if !contains(offer.groups, exchange.group) || exchange.group == x25519_mlkem768() {
        fail abort(c, 47, Unsupported)
    }
    if !suite_scheme(hello.code, exchange.scheme) {
        fail abort(c, 47, Unsupported)
    }
    var signed: []u8 = []
    io.append(mut signed, offer.random)
    io.append(mut signed, hello.random)
    io.append(mut signed, exchange.params)
    if !x509.verify_signature(chain[0].public_key, exchange.scheme, signed, exchange.signature, x509.SignatureRules.Tls12) {
        fail abort(c, 51, Invalid)
    }
    io.append(mut transcript, exchange_message.raw)
    var next = read_handshake(c)?
    let requested = next.kind == 13
    if requested {
        io.append(mut transcript, next.raw)
        next = read_handshake(c)?
    }
    if next.kind != 14 || next.body.len != 0 {
        fail abort(c, 10, Malformed)
    }
    io.append(mut transcript, next.raw)
    let share = client_share(exchange.group)?
    let premaster = client_secret(share, exchange.public) catch {
        _ => fail abort(c, 47, Invalid)
    }
    var flight: []u8 = []
    if requested {
        io.append(mut flight, certificate_message12([]))
    }
    var key_exchange: []u8 = []
    put_vector8(mut key_exchange, share.public)
    io.append(mut flight, handshake_message(16, key_exchange))
    io.append(mut transcript, flight)
    let h = suite_hash(suite)
    let master = extended_master_secret(h, premaster, transcript)
    let keys = keys12(suite, master, offer.random, hello.random)?
    let client_finished = handshake_message(20, verify_data(h, master, "client finished", transcript))
    io.append(mut transcript, client_finished)
    write_change_cipher(c, flight, keys.client, client_finished)?
    read_change_cipher(c)?
    c.read_key = keys.server
    let fin = expect_message(c, 20)?
    let expected = verify_data(h, master, "server finished", transcript)
    if !hash.equal(fin.body, expected) {
        fail abort(c, 51, Invalid)
    }
    session(c, protocol, exchange.group, suite, hello.code, chain)
}
