import std/crypto/hash
import std/crypto/x509
import std/io

fn suite12_of(code: i64) -> Suite? {
    if code == 0xC02B || code == 0xC02F {
        return Aes128Gcm
    }
    if code == 0xC02C || code == 0xC030 {
        return Aes256Gcm
    }
    if code == 0xCCA9 || code == 0xCCA8 {
        return ChaCha20Poly1305
    }
    none
}

fn signs_with_ecdsa(code: i64) -> bool {
    code == 0xC02B || code == 0xC02C || code == 0xCCA9
}

fn suite_scheme(code: i64, scheme: i64) -> bool {
    let wanted = if signs_with_ecdsa(code) { x509.Authentication.ByEcdsa } else { x509.Authentication.ByRsa }
    x509.authentication(scheme) == wanted
}

fn prf(h: hash.Algorithm, secret: []u8, label: str, seed: []u8, length: i64) -> []u8 {
    var labelled: []u8 = bytes(label)
    io.append(mut labelled, seed)
    var out: []u8 = []
    var a = hash.hmac(h, secret, labelled)
    for out.len < length {
        var input: []u8 = []
        io.append(mut input, a)
        io.append(mut input, labelled)
        io.append(mut out, hash.hmac(h, secret, input))
        a = hash.hmac(h, secret, a)
    }
    out[..length]
}

fn extended_master_secret(h: hash.Algorithm, premaster: []u8, transcript: []u8) -> []u8 {
    let session_hash = hash.sum(h, transcript)
    prf(h, premaster, "extended master secret", session_hash, 48)
}

fn verify_data(h: hash.Algorithm, master: []u8, label: str, transcript: []u8) -> []u8 {
    let digest = hash.sum(h, transcript)
    prf(h, master, label, digest, 12)
}

struct Keys12 {
    client: *Protection
    server: *Protection
}

fn protection12(s: Suite, key: []u8, fixed: []u8) -> *Protection ! io.Error {
    let iv: []u8 = __make(12)
    io.copy(iv, fixed)
    let empty: []u8 = []
    new(Protection { cipher: cipher(s, key)?, iv, seq: 0, secret: empty, suite: s, explicit: fixed.len == 4 })
}

fn keys12(s: Suite, master: []u8, client_random: []u8, server_random: []u8) -> Keys12 ! io.Error {
    let h = suite_hash(s)
    let size = key_size(s)
    let fixed = match s {
        ChaCha20Poly1305 => 12
        _ => 4
    }
    var seed: []u8 = []
    io.append(mut seed, server_random)
    io.append(mut seed, client_random)
    let block = prf(h, master, "key expansion", seed, 2 * size + 2 * fixed)
    let ivs = 2 * size
    let client = protection12(s, block[..size], block[ivs..ivs + fixed])?
    let server = protection12(s, block[size..ivs], block[ivs + fixed..ivs + 2 * fixed])?
    Keys12 { client, server }
}
