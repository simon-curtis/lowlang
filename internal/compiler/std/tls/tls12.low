import std/crypto/ecdsa
import std/crypto/hash
import std/crypto/x509
import std/io

fn suite12_of(code: i64) -> Suite? {
    if code == 0xC02B || code == 0xC02F {
        return Aes128Gcm
    }
    if code == 0xC02C || code == 0xC030 {
        return Aes256Gcm
    }
    if code == 0xCCA9 || code == 0xCCA8 {
        return ChaCha20Poly1305
    }
    none
}

fn signs_with_ecdsa(code: i64) -> bool {
    code == 0xC02B || code == 0xC02C || code == 0xCCA9
}

fn suite_scheme(code: i64, scheme: i64) -> bool {
    if signs_with_ecdsa(code) {
        return scheme == 0x0403 || scheme == 0x0503 || scheme == 0x0807
    }
    scheme == 0x0804 || scheme == 0x0805 || scheme == 0x0806 || scheme == 0x0401 || scheme == 0x0501 || scheme == 0x0601
}

fn key_schemes12(key: x509.PrivateKey) -> []i64 {
    match key {
        Rsa(_) => [0x0804, 0x0805, 0x0806, 0x0401, 0x0501, 0x0601]
        Ecdsa(k) => match k.curve {
            P256 => [0x0403, 0x0503]
            P384 => [0x0503, 0x0403]
        }
        Ed25519(_) => [0x0807]
    }
}

fn ecdsa_digest(scheme: i64) -> hash.Algorithm? {
    if scheme == 0x0403 {
        return hash.sha256()
    }
    if scheme == 0x0503 {
        return hash.sha384()
    }
    none
}

fn ecdsa_curve(key: x509.PublicKeyInfo) -> ecdsa.Curve? {
    if key.algorithm != "1.2.840.10045.2.1" {
        return none
    }
    if key.parameters == "1.2.840.10045.3.1.7" {
        return ecdsa.Curve.P256
    }
    if key.parameters == "1.3.132.0.34" {
        return ecdsa.Curve.P384
    }
    none
}

fn verify12(key: x509.PublicKeyInfo, scheme: i64, message: []u8, signature: []u8) -> bool {
    let h = match ecdsa_digest(scheme) {
        some(found) => found
        none => return x509.verify_signature(key, scheme, message, signature)
    }
    match ecdsa_curve(key) {
        some(curve) => {
            let digest = hash.sum(h, message)
            ecdsa.verify(curve, key.key, digest, signature)
        }
        none => false
    }
}

fn sign12(key: x509.PrivateKey, scheme: i64, message: []u8) -> []u8 ! io.Error {
    match key {
        Ecdsa(k) => {
            let h = match ecdsa_digest(scheme) {
                some(found) => found
                none => fail Unsupported
            }
            let digest = hash.sum(h, message)
            ecdsa.sign(k.curve, k.private, digest)
        }
        _ => x509.sign(key, scheme, message)
    }
}

fn prf(h: hash.Algorithm, secret: []u8, label: str, seed: []u8, length: i64) -> []u8 {
    var labelled: []u8 = bytes(label)
    io.append(mut labelled, seed)
    var out: []u8 = []
    var a = hash.hmac(h, secret, labelled)
    for out.len < length {
        var input: []u8 = []
        io.append(mut input, a)
        io.append(mut input, labelled)
        io.append(mut out, hash.hmac(h, secret, input))
        a = hash.hmac(h, secret, a)
    }
    out[..length]
}

fn extended_master_secret(h: hash.Algorithm, premaster: []u8, transcript: []u8) -> []u8 {
    let session_hash = hash.sum(h, transcript)
    prf(h, premaster, "extended master secret", session_hash, 48)
}

fn verify_data(h: hash.Algorithm, master: []u8, label: str, transcript: []u8) -> []u8 {
    let digest = hash.sum(h, transcript)
    prf(h, master, label, digest, 12)
}

struct Keys12 {
    client: *Protection
    server: *Protection
}

fn protection12(s: Suite, key: []u8, fixed: []u8) -> *Protection ! io.Error {
    let iv: []u8 = __make(12)
    io.copy(iv, fixed)
    let empty: []u8 = []
    new(Protection { cipher: cipher(s, key)?, iv, seq: 0, secret: empty, suite: s, explicit: fixed.len == 4 })
}

fn keys12(s: Suite, master: []u8, client_random: []u8, server_random: []u8) -> Keys12 ! io.Error {
    let h = suite_hash(s)
    let size = key_size(s)
    let fixed = match s {
        ChaCha20Poly1305 => 12
        _ => 4
    }
    var seed: []u8 = []
    io.append(mut seed, server_random)
    io.append(mut seed, client_random)
    let block = prf(h, master, "key expansion", seed, 2 * size + 2 * fixed)
    let ivs = 2 * size
    let client = protection12(s, block[..size], block[ivs..ivs + fixed])?
    let server = protection12(s, block[size..ivs], block[ivs + fixed..ivs + 2 * fixed])?
    Keys12 { client, server }
}
