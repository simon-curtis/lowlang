import std/crypto/aead
import std/crypto/hash
import std/io

pub enum Suite {
    Aes128Gcm
    Aes256Gcm
    ChaCha20Poly1305
}

pub fn suite_code(s: Suite) -> i64 {
    match s {
        Aes128Gcm => 0x1301
        Aes256Gcm => 0x1302
        ChaCha20Poly1305 => 0x1303
    }
}

fn suite_of(code: i64) -> Suite? {
    if code == 0x1301 {
        return Aes128Gcm
    }
    if code == 0x1302 {
        return Aes256Gcm
    }
    if code == 0x1303 {
        return ChaCha20Poly1305
    }
    none
}

fn suite_hash(s: Suite) -> hash.Algorithm {
    match s {
        Aes256Gcm => hash.sha384()
        _ => hash.sha256()
    }
}

fn key_size(s: Suite) -> i64 {
    match s {
        Aes128Gcm => 16
        _ => 32
    }
}

fn cipher(s: Suite, key: []u8) -> aead.Aead ! io.Error {
    match s {
        ChaCha20Poly1305 => aead.chacha20_poly1305(key)
        _ => aead.aes_gcm(key)
    }
}

fn expand_label(h: hash.Algorithm, secret: []u8, label: str, context: []u8, length: i64) -> []u8 {
    var info: []u8 = []
    io.put_be16(mut info, length)
    push(mut info, u8(6 + label.len))
    io.append_str(mut info, "tls13 ")
    io.append_str(mut info, label)
    push(mut info, u8(context.len))
    io.append(mut info, context)
    hash.hkdf_expand(h, secret, info, length)
}

fn derive_secret(h: hash.Algorithm, secret: []u8, label: str, transcript: []u8) -> []u8 {
    expand_label(h, secret, label, hash.sum(h, transcript), h.size)
}

struct Protection {
    cipher: aead.Aead
    iv: []u8
    seq: u64
    secret: []u8
    suite: Suite
}

fn protection(s: Suite, secret: []u8) -> *Protection ! io.Error {
    let h = suite_hash(s)
    let key = expand_label(h, secret, "key", [], key_size(s))
    let iv = expand_label(h, secret, "iv", [], 12)
    new(Protection { cipher: cipher(s, key)?, iv, seq: 0, secret, suite: s })
}

fn updated(p: *Protection) -> *Protection ! io.Error {
    let h = suite_hash(p.suite)
    protection(p.suite, expand_label(h, p.secret, "traffic upd", [], h.size))
}

fn nonce(p: *Protection) -> []u8 {
    let out: []u8 = __make(12)
    io.copy(out, p.iv)
    for i in 0..8 {
        out[11 - i] = out[11 - i] ^ u8(p.seq >> (8 * i))
    }
    p.seq += 1
    out
}

struct Schedule {
    suite: Suite
    hash: hash.Algorithm
    handshake: []u8
    master: []u8
    client_handshake: []u8
    server_handshake: []u8
}

fn schedule(s: Suite, shared: []u8, transcript: []u8) -> *Schedule {
    let h = suite_hash(s)
    let zeros: []u8 = __make(h.size)
    let early = hash.hkdf_extract(h, zeros, zeros)
    let empty: []u8 = []
    let handshake = hash.hkdf_extract(h, derive_secret(h, early, "derived", empty), shared)
    let master = hash.hkdf_extract(h, derive_secret(h, handshake, "derived", empty), zeros)
    new(Schedule {
        suite: s
        hash: h
        handshake
        master
        client_handshake: derive_secret(h, handshake, "c hs traffic", transcript)
        server_handshake: derive_secret(h, handshake, "s hs traffic", transcript)
    })
}

fn finished(k: *Schedule, base: []u8, transcript: []u8) -> []u8 {
    let key = expand_label(k.hash, base, "finished", [], k.hash.size)
    hash.hmac(k.hash, key, hash.sum(k.hash, transcript))
}
