struct SemaphoreState {
    guard: Mutex
    available: i64
    waiters: []chan[bool]
}

pub struct Semaphore {
    state: *SemaphoreState
}

pub fn semaphore(permits: i64) -> Semaphore {
    Semaphore { state: new(SemaphoreState { guard: mutex(), available: permits, waiters: [] }) }
}

pub fn acquire(s: Semaphore) {
    let st = s.state
    lock(st.guard)
    if st.available > 0 {
        st.available -= 1
        unlock(st.guard)
        return
    }
    let wake = chan[bool](1)
    push(mut st.waiters, wake)
    unlock(st.guard)
    let granted = <-wake
}

pub fn try_acquire(s: Semaphore) -> bool {
    let st = s.state
    lock(st.guard)
    let free = st.available > 0
    if free {
        st.available -= 1
    }
    unlock(st.guard)
    free
}

pub fn release(s: Semaphore) {
    let st = s.state
    lock(st.guard)
    if st.waiters.len > 0 {
        let next = st.waiters[0]
        st.waiters = st.waiters[1..]
        next <- true
    } else {
        st.available += 1
    }
    unlock(st.guard)
}

pub fn available(s: Semaphore) -> i64 {
    let st = s.state
    lock(st.guard)
    let n = st.available
    unlock(st.guard)
    n
}

struct CondState {
    guard: Mutex
    waiters: []chan[bool]
}

pub struct Cond {
    owner: Mutex
    state: *CondState
}

pub fn cond(owner: Mutex) -> Cond {
    Cond { owner, state: new(CondState { guard: mutex(), waiters: [] }) }
}

pub fn wait_cond(c: Cond) {
    let st = c.state
    let wake = chan[bool](1)
    lock(st.guard)
    push(mut st.waiters, wake)
    unlock(st.guard)
    unlock(c.owner)
    let signalled = <-wake
    lock(c.owner)
}

pub fn signal(c: Cond) {
    let st = c.state
    lock(st.guard)
    if st.waiters.len > 0 {
        let next = st.waiters[0]
        st.waiters = st.waiters[1..]
        next <- true
    }
    unlock(st.guard)
}

pub fn broadcast(c: Cond) {
    let st = c.state
    lock(st.guard)
    let all = st.waiters
    st.waiters = []
    unlock(st.guard)
    for next in all {
        next <- true
    }
}

struct BarrierState {
    guard: Mutex
    parties: i64
    arrived: i64
    waiters: []chan[bool]
}

pub struct Barrier {
    state: *BarrierState
}

pub fn barrier(parties: i64) -> Barrier {
    Barrier { state: new(BarrierState { guard: mutex(), parties, arrived: 0, waiters: [] }) }
}

pub fn wait_barrier(b: Barrier) -> bool {
    let st = b.state
    lock(st.guard)
    st.arrived += 1
    if st.arrived >= st.parties {
        let all = st.waiters
        st.waiters = []
        st.arrived = 0
        unlock(st.guard)
        for next in all {
            next <- true
        }
        return true
    }
    let wake = chan[bool](1)
    push(mut st.waiters, wake)
    unlock(st.guard)
    let released = <-wake
    false
}
