pub struct Mutex {
    slot: chan[bool]
}

pub fn mutex() -> Mutex {
    Mutex { slot: chan[bool](1) }
}

pub fn lock(m: Mutex) {
    m.slot <- true
}

pub fn try_lock(m: Mutex) -> bool {
    select {
        m.slot <- true => true
        else => false
    }
}

pub fn unlock(m: Mutex) {
    let released = <-m.slot
}

pub fn locked[T](m: Mutex, f: fn() -> T) -> T {
    lock(m)
    let value = f()
    unlock(m)
    value
}

struct Group {
    count: i64
    guard: Mutex
    waiters: []chan[bool]
}

pub struct WaitGroup {
    group: *Group
}

pub fn wait_group() -> WaitGroup {
    WaitGroup { group: new(Group { count: 0, guard: mutex(), waiters: [] }) }
}

pub fn add(w: WaitGroup, n: i64) {
    let g = w.group
    lock(g.guard)
    g.count += n
    if g.count < 0 {
        unlock(g.guard)
        __panic("sync: negative wait group count")
    }
    if g.count == 0 {
        for waiter in g.waiters {
            close(waiter)
        }
        g.waiters = []
    }
    unlock(g.guard)
}

pub fn done(w: WaitGroup) {
    add(w, -1)
}

pub fn wait(w: WaitGroup) {
    let g = w.group
    lock(g.guard)
    if g.count == 0 {
        unlock(g.guard)
        return
    }
    let woken = chan[bool]()
    push(mut g.waiters, woken)
    unlock(g.guard)
    let released = <-woken
}

struct OnceState {
    finished: bool
    guard: Mutex
}

pub struct Once {
    state: *OnceState
}

pub fn once() -> Once {
    Once { state: new(OnceState { finished: false, guard: mutex() }) }
}

pub fn run(o: Once, f: fn()) {
    let s = o.state
    lock(s.guard)
    if !s.finished {
        f()
        s.finished = true
    }
    unlock(s.guard)
}
