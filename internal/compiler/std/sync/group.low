struct OnceCell[T] {
    guard: Mutex
    compute: fn() -> T
    result: T?
}

pub struct OnceValue[T] {
    cell: *OnceCell[T]
}

pub fn once_value[T](compute: fn() -> T) -> OnceValue[T] {
    OnceValue { cell: new(OnceCell { guard: mutex(), compute, result: none }) }
}

pub fn get_once[T](o: OnceValue[T]) -> T {
    let c = o.cell
    lock(c.guard)
    let held = c.result
    match held {
        some(v) => {
            unlock(c.guard)
            v
        }
        none => {
            let produce = c.compute
            let v = produce()
            c.result = some(v)
            unlock(c.guard)
            v
        }
    }
}

struct GroupState[E] {
    slots: Semaphore
    pending: WaitGroup
    guard: Mutex
    first: E?
}

pub struct ErrorGroup[E] {
    state: *GroupState[E]
}

pub fn group[E](limit: i64) -> ErrorGroup[E] {
    ErrorGroup { state: new(GroupState { slots: semaphore(limit), pending: wait_group(), guard: mutex(), first: none }) }
}

fn run_task[E](st: *GroupState[E], f: fn() -> E?) {
    let outcome = f()
    match outcome {
        some(e) => record(st, e)
        none => {}
    }
    release(st.slots)
    done(st.pending)
}

fn record[E](st: *GroupState[E], e: E) {
    lock(st.guard)
    let held = st.first
    match held {
        some(earlier) => {}
        none => { st.first = some(e) }
    }
    unlock(st.guard)
}

pub fn go[E](g: ErrorGroup[E], f: fn() -> E?) {
    let st = g.state
    acquire(st.slots)
    add(st.pending, 1)
    spawn run_task(st, f)
}

pub fn join[E](g: ErrorGroup[E]) -> E? {
    let st = g.state
    wait(st.pending)
    lock(st.guard)
    let first = st.first
    unlock(st.guard)
    first
}
