struct Waiter {
    writer: bool
    wake: chan[bool]
}

struct RwState {
    guard: Mutex
    readers: i64
    writing: bool
    queue: []Waiter
}

pub struct RwLock {
    state: *RwState
}

pub fn rw_lock() -> RwLock {
    RwLock { state: new(RwState { guard: mutex(), readers: 0, writing: false, queue: [] }) }
}

fn grant(s: *RwState) {
    for s.queue.len > 0 {
        let head = s.queue[0]
        if head.writer {
            if s.readers > 0 || s.writing {
                return
            }
            s.writing = true
        } else {
            if s.writing {
                return
            }
            s.readers += 1
        }
        s.queue = s.queue[1..]
        head.wake <- true
    }
}

fn park(s: *RwState, writer: bool) {
    let wake = chan[bool](1)
    push(mut s.queue, Waiter { writer, wake })
    unlock(s.guard)
    let granted = <-wake
}

pub fn read_lock(l: RwLock) {
    let s = l.state
    lock(s.guard)
    if s.writing || s.queue.len > 0 {
        park(s, false)
        return
    }
    s.readers += 1
    unlock(s.guard)
}

pub fn try_read_lock(l: RwLock) -> bool {
    let s = l.state
    lock(s.guard)
    let free = !s.writing && s.queue.len == 0
    if free {
        s.readers += 1
    }
    unlock(s.guard)
    free
}

pub fn read_unlock(l: RwLock) {
    let s = l.state
    lock(s.guard)
    if s.readers == 0 {
        unlock(s.guard)
        __panic("sync: read_unlock of an unlocked RwLock")
    }
    s.readers -= 1
    grant(s)
    unlock(s.guard)
}

pub fn write_lock(l: RwLock) {
    let s = l.state
    lock(s.guard)
    if s.writing || s.readers > 0 || s.queue.len > 0 {
        park(s, true)
        return
    }
    s.writing = true
    unlock(s.guard)
}

pub fn try_write_lock(l: RwLock) -> bool {
    let s = l.state
    lock(s.guard)
    let free = !s.writing && s.readers == 0 && s.queue.len == 0
    if free {
        s.writing = true
    }
    unlock(s.guard)
    free
}

pub fn write_unlock(l: RwLock) {
    let s = l.state
    lock(s.guard)
    if !s.writing {
        unlock(s.guard)
        __panic("sync: write_unlock of an unlocked RwLock")
    }
    s.writing = false
    grant(s)
    unlock(s.guard)
}

pub fn reading[T](l: RwLock, f: fn() -> T) -> T {
    read_lock(l)
    let value = f()
    read_unlock(l)
    value
}

pub fn writing[T](l: RwLock, f: fn() -> T) -> T {
    write_lock(l)
    let value = f()
    write_unlock(l)
    value
}
