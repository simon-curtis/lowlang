/// A double-ended queue stored in a ring buffer.
/// ///
/// /// Pushes and pops at either end take amortised constant time. The buffer starts at 8 slots and doubles when it is full. Mutating functions take the deque as `mut`.
pub struct Deque[T] {
    items: []T
    head: i64
    count: i64
}

/// Returns an empty deque.
pub fn deque[T]() -> Deque[T] {
    Deque[T] { items: [], head: 0, count: 0 }
}

/// Returns the number of items in `d`.
pub fn size[T](d: Deque[T]) -> i64 {
    d.count
}

fn grow[T](mut d: Deque[T], filler: T) {
    var larger: []T = []
    for i in 0..d.count {
        push(mut larger, d.items[(d.head + i) % d.items.len])
    }
    let target = if d.items.len == 0 { 8 } else { 2 * d.items.len }
    for larger.len < target {
        push(mut larger, filler)
    }
    d.items = larger
    d.head = 0
}

/// Adds `item` at the back of `d`.
/// ///
/// /// Takes amortised constant time; a full buffer is doubled and its items are copied.
pub fn push_back[T](mut d: Deque[T], item: T) {
    if d.count == d.items.len {
        grow(mut d, item)
    }
    d.items[(d.head + d.count) % d.items.len] = item
    d.count += 1
}

/// Adds `item` at the front of `d`.
/// ///
/// /// Takes amortised constant time; a full buffer is doubled and its items are copied.
pub fn push_front[T](mut d: Deque[T], item: T) {
    if d.count == d.items.len {
        grow(mut d, item)
    }
    d.head = (d.head - 1 + d.items.len) % d.items.len
    d.items[d.head] = item
    d.count += 1
}

/// Removes and returns the item at the front of `d`, or `none` when it is empty.
pub fn pop_front[T](mut d: Deque[T]) -> T? {
    if d.count == 0 {
        return none
    }
    let item = d.items[d.head]
    d.head = (d.head + 1) % d.items.len
    d.count -= 1
    item
}

/// Removes and returns the item at the back of `d`, or `none` when it is empty.
pub fn pop_back[T](mut d: Deque[T]) -> T? {
    if d.count == 0 {
        return none
    }
    d.count -= 1
    d.items[(d.head + d.count) % d.items.len]
}

/// Returns the item at the front of `d` without removing it, or `none` when it is empty.
pub fn front[T](d: Deque[T]) -> T? {
    if d.count == 0 {
        return none
    }
    d.items[d.head]
}

/// Returns the item at the back of `d` without removing it, or `none` when it is empty.
pub fn back[T](d: Deque[T]) -> T? {
    if d.count == 0 {
        return none
    }
    d.items[(d.head + d.count - 1) % d.items.len]
}

/// Returns the item `i` places from the front of `d`, where `0` is the front, or `none` when `i` is negative or at least `size(d)`.
pub fn at[T](d: Deque[T], i: i64) -> T? {
    if i < 0 || i >= d.count {
        return none
    }
    d.items[(d.head + i) % d.items.len]
}
