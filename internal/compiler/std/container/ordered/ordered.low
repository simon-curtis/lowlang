/// A key and its value in a `Tree`.
pub struct Entry[K, V] {
    /// The key.
    pub key: K
    /// The value stored under the key.
    pub value: V
}

struct Node[K, V] {
    key: K
    value: V
    left: *Node[K, V]?
    right: *Node[K, V]?
    height: i64
}

/// A map from keys to values kept in ascending key order, implemented as an AVL tree.
///
/// Create one with `tree`. Lookup, insertion, removal and the nearest-key queries take `O(log n)` time. Keys are compared with `<` and `>`. Nodes are shared between copies of a `Tree`, so keep a single copy and mutate it through `mut`.
pub struct Tree[K: Ord, V] {
    root: *Node[K, V]?
    count: i64
}

/// Returns an empty tree.
pub fn tree[K: Ord, V]() -> Tree[K, V] {
    Tree[K, V] { root: none, count: 0 }
}

/// Returns the number of keys in `t`.
pub fn size[K: Ord, V](t: Tree[K, V]) -> i64 {
    t.count
}

/// Returns the height of `t` in levels, which is `0` for an empty tree.
pub fn height[K: Ord, V](t: Tree[K, V]) -> i64 {
    node_height(t.root)
}

/// Returns `true` when `t` satisfies the AVL invariants.
///
/// Checks that keys are ordered, that subtree heights differ by at most one and are recorded correctly, and that the stored size matches the number of nodes. Visits every node.
pub fn is_valid[K: Ord, V](t: Tree[K, V]) -> bool {
    var counted = 0
    let levels = audit(t.root, mut counted)
    levels >= 0 && counted == t.count
}

fn audit[K: Ord, V](n: *Node[K, V]?, mut counted: i64) -> i64 {
    let p = n ?? return 0
    let lh = audit(p.left, mut counted)
    let rh = audit(p.right, mut counted)
    if lh < 0 || rh < 0 || lh - rh > 1 || rh - lh > 1 {
        return -1
    }
    let levels = 1 + (if lh > rh { lh } else { rh })
    if levels != p.height {
        return -1
    }
    if !child_ordered(p) {
        return -1
    }
    counted += 1
    levels
}

fn child_ordered[K: Ord, V](p: *Node[K, V]) -> bool {
    let below = match p.left {
        some(l) => l.key < p.key
        none => true
    }
    let above = match p.right {
        some(r) => r.key > p.key
        none => true
    }
    below && above
}

fn node_height[K, V](n: *Node[K, V]?) -> i64 {
    match n {
        some(p) => p.height
        none => 0
    }
}

fn refresh[K, V](n: *Node[K, V]) {
    let lh = node_height(n.left)
    let rh = node_height(n.right)
    n.height = 1 + (if lh > rh { lh } else { rh })
}

fn skew[K, V](n: *Node[K, V]) -> i64 {
    node_height(n.left) - node_height(n.right)
}

fn rotate_right[K, V](n: *Node[K, V]) -> *Node[K, V] {
    let pivot = n.left ?? return n
    n.left = pivot.right
    pivot.right = n
    refresh(n)
    refresh(pivot)
    pivot
}

fn rotate_left[K, V](n: *Node[K, V]) -> *Node[K, V] {
    let pivot = n.right ?? return n
    n.right = pivot.left
    pivot.left = n
    refresh(n)
    refresh(pivot)
    pivot
}

fn rebalance[K, V](n: *Node[K, V]) -> *Node[K, V] {
    refresh(n)
    let lean = skew(n)
    if lean > 1 {
        let left = n.left ?? return n
        if skew(left) < 0 {
            n.left = rotate_left(left)
        }
        return rotate_right(n)
    }
    if lean < -1 {
        let right = n.right ?? return n
        if skew(right) > 0 {
            n.right = rotate_right(right)
        }
        return rotate_left(n)
    }
    n
}

fn leftmost[K, V](n: *Node[K, V]) -> *Node[K, V] {
    var cur = n
    for {
        let next = cur.left ?? return cur
        cur = next
    }
}

fn rightmost[K, V](n: *Node[K, V]) -> *Node[K, V] {
    var cur = n
    for {
        let next = cur.right ?? return cur
        cur = next
    }
}

fn entry_of[K, V](n: *Node[K, V]) -> Entry[K, V] {
    Entry[K, V] { key: n.key, value: n.value }
}

fn insert_node[K: Ord, V](n: *Node[K, V]?, key: K, value: V, mut added: bool) -> *Node[K, V] {
    let p = n ?? {
        added = true
        return new(Node[K, V] { key: key, value: value, left: none, right: none, height: 1 })
    }
    if key < p.key {
        p.left = insert_node(p.left, key, value, mut added)
    } else if key > p.key {
        p.right = insert_node(p.right, key, value, mut added)
    } else {
        p.value = value
        return p
    }
    rebalance(p)
}

fn remove_min[K, V](n: *Node[K, V]) -> *Node[K, V]? {
    let left = n.left ?? return n.right
    n.left = remove_min(left)
    rebalance(n)
}

fn remove_node[K: Ord, V](n: *Node[K, V]?, key: K, mut removed: bool) -> *Node[K, V]? {
    let p = n ?? return none
    if key < p.key {
        p.left = remove_node(p.left, key, mut removed)
    } else if key > p.key {
        p.right = remove_node(p.right, key, mut removed)
    } else {
        removed = true
        let left = p.left ?? return p.right
        let right = p.right ?? return left
        let successor = leftmost(right)
        p.key = successor.key
        p.value = successor.value
        p.right = remove_min(right)
    }
    rebalance(p)
}

/// Stores `value` under `key`, replacing the value when the key is already present.
///
/// Returns `true` when `key` was new and `false` when an existing value was replaced.
pub fn put[K: Ord, V](mut t: Tree[K, V], key: K, value: V) -> bool {
    var added = false
    t.root = insert_node(t.root, key, value, mut added)
    if added {
        t.count += 1
    }
    added
}

/// Removes `key` from `t`.
///
/// Returns `true` when the key was present and `false` when `t` did not change.
pub fn remove[K: Ord, V](mut t: Tree[K, V], key: K) -> bool {
    var removed = false
    t.root = remove_node(t.root, key, mut removed)
    if removed {
        t.count -= 1
    }
    removed
}

/// Returns the value stored under `key`, or `none` when it is absent.
pub fn get[K: Ord, V](t: Tree[K, V], key: K) -> V? {
    var cur = t.root
    for {
        let p = cur ?? return none
        if key < p.key {
            cur = p.left
        } else if key > p.key {
            cur = p.right
        } else {
            return p.value
        }
    }
}

/// Returns `true` when `key` is in `t`.
pub fn contains[K: Ord, V](t: Tree[K, V], key: K) -> bool {
    match get(t, key) {
        some(_) => true
        none => false
    }
}

/// Returns the entry with the smallest key, or `none` when `t` is empty.
pub fn first[K: Ord, V](t: Tree[K, V]) -> Entry[K, V]? {
    let root = t.root ?? return none
    entry_of(leftmost(root))
}

/// Returns the entry with the largest key, or `none` when `t` is empty.
pub fn last[K: Ord, V](t: Tree[K, V]) -> Entry[K, V]? {
    let root = t.root ?? return none
    entry_of(rightmost(root))
}

/// Returns the entry with the largest key that is at most `key`, or `none` when every key is greater.
pub fn floor_entry[K: Ord, V](t: Tree[K, V], key: K) -> Entry[K, V]? {
    var best: *Node[K, V]? = none
    var cur = t.root
    for {
        let p = cur ?? break
        if p.key == key {
            return entry_of(p)
        }
        if p.key < key {
            best = p
            cur = p.right
        } else {
            cur = p.left
        }
    }
    let found = best ?? return none
    entry_of(found)
}

/// Returns the entry with the smallest key that is at least `key`, or `none` when every key is smaller.
pub fn ceiling_entry[K: Ord, V](t: Tree[K, V], key: K) -> Entry[K, V]? {
    var best: *Node[K, V]? = none
    var cur = t.root
    for {
        let p = cur ?? break
        if p.key == key {
            return entry_of(p)
        }
        if p.key > key {
            best = p
            cur = p.left
        } else {
            cur = p.right
        }
    }
    let found = best ?? return none
    entry_of(found)
}

fn walk[K, V](n: *Node[K, V]?, visit: fn(K, V)) {
    let p = n ?? return
    walk(p.left, visit)
    visit(p.key, p.value)
    walk(p.right, visit)
}

fn walk_range[K: Ord, V](n: *Node[K, V]?, lo: K, hi: K, visit: fn(K, V)) {
    let p = n ?? return
    if lo < p.key {
        walk_range(p.left, lo, hi, visit)
    }
    if p.key >= lo && p.key < hi {
        visit(p.key, p.value)
    }
    if p.key < hi {
        walk_range(p.right, lo, hi, visit)
    }
}

/// Calls `visit` with each key and value of `t` in ascending key order.
pub fn each[K: Ord, V](t: Tree[K, V], visit: fn(K, V)) {
    walk(t.root, visit)
}

/// Calls `visit` in ascending key order with each key and value whose key is at least `lo` and less than `hi`.
///
/// Skips subtrees outside the range, so it takes `O(log n + m)` time for `m` visited entries.
pub fn each_range[K: Ord, V](t: Tree[K, V], lo: K, hi: K, visit: fn(K, V)) {
    walk_range(t.root, lo, hi, visit)
}

/// Returns the keys of `t` in ascending order.
pub fn keys[K: Ord, V](t: Tree[K, V]) -> []K {
    var out: []K = []
    each(t, fn(k: K, v: V) { push(mut out, k) })
    out
}

/// Returns the values of `t` in ascending order of their keys.
pub fn values[K: Ord, V](t: Tree[K, V]) -> []V {
    var out: []V = []
    each(t, fn(k: K, v: V) { push(mut out, v) })
    out
}

/// Returns the entries of `t` in ascending key order.
pub fn entries[K: Ord, V](t: Tree[K, V]) -> []Entry[K, V] {
    var out: []Entry[K, V] = []
    each(t, fn(k: K, v: V) { push(mut out, Entry[K, V] { key: k, value: v }) })
    out
}

/// Returns the entries whose key is at least `lo` and less than `hi`, in ascending key order.
///
/// The range is half-open: `hi` is excluded. The result is empty when `lo` is not less than `hi`.
pub fn range[K: Ord, V](t: Tree[K, V], lo: K, hi: K) -> []Entry[K, V] {
    var out: []Entry[K, V] = []
    each_range(t, lo, hi, fn(k: K, v: V) { push(mut out, Entry[K, V] { key: k, value: v }) })
    out
}
