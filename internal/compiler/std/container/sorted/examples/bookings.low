import std/container/sorted

fn describe(label: str, hour: i64?) -> str {
    match hour {
        some(h) => "{label} {h}:00"
        none => "{label} none"
    }
}

/// Keeps booked start hours in order to find the nearest bookings around a request and the bookings inside a window.
fn main() {
    var booked = sorted.from_slice([14, 9, 11, 16, 9])
    print("booked {booked.items()}")

    for request in [10, 11, 17] {
        print("request {request}:00 -> {describe("before", booked.floor_item(request))}, {describe("after", booked.ceiling_item(request))}")
    }

    print("free at 10: {!booked.has(10)}")
    booked.add(10)
    booked.remove(14)
    print("from 10 up to 16: {booked.range(10, 16)}")
    print("{describe("first", booked.first())}, {describe("last", booked.last())}, count {booked.size()}")
}
