import std/container/ordered
import std/slices

/// A set of ordered values kept in ascending order, backed by an `ordered.Tree`.
///
/// Create one with `sorted` or `from_slice`. Membership, insertion, removal and the nearest-item queries take `O(log n)` time. Mutating functions take the set as `mut`. Nodes are shared between copies, so keep a single copy.
pub struct Sorted[T: Ord] {
    members: ordered.Tree[T, bool]
}

/// Returns an empty sorted set.
pub fn sorted[T: Ord]() -> Sorted[T] {
    Sorted[T] { members: ordered.tree[T, bool]() }
}

/// Returns a sorted set of the items of `xs`, ignoring duplicates.
pub fn from_slice[T: Ord](xs: []T) -> Sorted[T] {
    var s = sorted[T]()
    for x in xs {
        add(mut s, x)
    }
    s
}

/// Returns the number of items in `s`.
pub fn size[T: Ord](s: Sorted[T]) -> i64 {
    ordered.size(s.members)
}

/// Returns `true` when `item` is in `s`.
pub fn has[T: Ord](s: Sorted[T], item: T) -> bool {
    ordered.contains(s.members, item)
}

/// Adds `item` to `s`.
///
/// Returns `true` when the item was new and `false` when it was already present.
pub fn add[T: Ord](mut s: Sorted[T], item: T) -> bool {
    ordered.put(mut s.members, item, true)
}

/// Removes `item` from `s`.
///
/// Returns `true` when the item was present and `false` when `s` did not change.
pub fn remove[T: Ord](mut s: Sorted[T], item: T) -> bool {
    ordered.remove(mut s.members, item)
}

/// Returns the items of `s` in ascending order.
pub fn items[T: Ord](s: Sorted[T]) -> []T {
    ordered.keys(s.members)
}

/// Returns the smallest item, or `none` when `s` is empty.
pub fn first[T: Ord](s: Sorted[T]) -> T? {
    let entry = ordered.first(s.members) ?? return none
    entry.key
}

/// Returns the largest item, or `none` when `s` is empty.
pub fn last[T: Ord](s: Sorted[T]) -> T? {
    let entry = ordered.last(s.members) ?? return none
    entry.key
}

/// Returns the largest item that is at most `item`, or `none` when every item is greater.
pub fn floor_item[T: Ord](s: Sorted[T], item: T) -> T? {
    let entry = ordered.floor_entry(s.members, item) ?? return none
    entry.key
}

/// Returns the smallest item that is at least `item`, or `none` when every item is smaller.
pub fn ceiling_item[T: Ord](s: Sorted[T], item: T) -> T? {
    let entry = ordered.ceiling_entry(s.members, item) ?? return none
    entry.key
}

/// Returns the items that are at least `lo` and less than `hi`, in ascending order.
pub fn range[T: Ord](s: Sorted[T], lo: T, hi: T) -> []T {
    slices.map(ordered.range(s.members, lo, hi), fn(e: ordered.Entry[T, bool]) -> T { e.key })
}
