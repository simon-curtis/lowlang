import std/container/set

/// Compares the permissions of two roles and checks what a request needs against the roles a user holds.
fn main() {
    let editor = set.from_slice(["read", "write", "comment", "read"])
    let reviewer = set.from_slice(["read", "comment", "approve"])
    print("editor has {editor.size()} permissions: {editor.items()}")

    let everything = editor.union(reviewer)
    let shared = editor.intersection(reviewer)
    let only_editor = editor.difference(reviewer)
    print("union {everything.items()}")
    print("shared {shared.items()}")
    print("only editor {only_editor.items()}")

    let required = set.from_slice(["read", "write"])
    print("editor can handle the request: {required.is_subset(editor)}")
    print("reviewer can handle the request: {required.is_subset(reviewer)}")

    var granted = set.set[str]()
    for permission in ["read", "write", "read", "delete"] {
        let added = granted.add(permission)
        print("grant {permission}: {if added { "new" } else { "already held" }}")
    }
    print("revoke write: {granted.remove("write")}, revoke write again: {granted.remove("write")}")
    print("has delete: {granted.has("delete")}, has write: {granted.has("write")}")
    print("remaining {granted.items()}")
}
