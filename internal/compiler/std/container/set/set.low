pub struct Set[T: Hash] {
    members: [T: bool]
}

pub fn set[T: Hash]() -> Set[T] {
    Set[T] { members: [:] }
}

pub fn from_slice[T: Hash](xs: []T) -> Set[T] {
    var s = set[T]()
    for x in xs {
        add(mut s, x)
    }
    s
}

pub fn size[T: Hash](s: Set[T]) -> i64 {
    s.members.len
}

pub fn has[T: Hash](s: Set[T], item: T) -> bool {
    match s.members[item] {
        some(_) => true
        none => false
    }
}

pub fn add[T: Hash](mut s: Set[T], item: T) -> bool {
    if has(s, item) {
        return false
    }
    s.members[item] = true
    true
}

pub fn remove[T: Hash](mut s: Set[T], item: T) -> bool {
    if !has(s, item) {
        return false
    }
    delete(mut s.members, item)
    true
}

pub fn items[T: Hash](s: Set[T]) -> []T {
    var out: []T = []
    for item in s.members {
        push(mut out, item)
    }
    out
}

pub fn union[T: Hash](a: Set[T], b: Set[T]) -> Set[T] {
    var out = set[T]()
    for item in a.members {
        add(mut out, item)
    }
    for item in b.members {
        add(mut out, item)
    }
    out
}

pub fn intersection[T: Hash](a: Set[T], b: Set[T]) -> Set[T] {
    var out = set[T]()
    for item in a.members {
        if has(b, item) {
            add(mut out, item)
        }
    }
    out
}

pub fn difference[T: Hash](a: Set[T], b: Set[T]) -> Set[T] {
    var out = set[T]()
    for item in a.members {
        if !has(b, item) {
            add(mut out, item)
        }
    }
    out
}

pub fn is_subset[T: Hash](a: Set[T], b: Set[T]) -> bool {
    if a.members.len > b.members.len {
        return false
    }
    for item in a.members {
        if !has(b, item) {
            return false
        }
    }
    true
}
