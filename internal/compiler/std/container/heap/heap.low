/// A binary heap that yields its smallest item first, as decided by a `less` function.
/// ///
/// /// Create one with `heap`. Mutating functions take the heap as `mut`.
pub struct Heap[T] {
    items: []T
    less: fn(T, T) -> bool
}

/// Returns an empty heap ordered by `less`.
/// ///
/// /// `less(a, b)` returns `true` when `a` must leave the heap before `b`. It must be a strict weak ordering. For a max-heap, pass a function that compares in the opposite direction.
pub fn heap[T](less: fn(T, T) -> bool) -> Heap[T] {
    Heap[T] { items: [], less: less }
}

/// Returns the number of items in `h`.
pub fn size[T](h: Heap[T]) -> i64 {
    h.items.len
}

/// Returns the item that `pop` would return, or `none` when `h` is empty.
/// ///
/// /// Takes constant time.
pub fn peek[T](h: Heap[T]) -> T? {
    if h.items.len == 0 {
        return none
    }
    h.items[0]
}

/// Adds `item` to `h`.
/// ///
/// /// Sifts the item up with `O(log n)` calls to `less`.
pub fn insert[T](mut h: Heap[T], item: T) {
    push(mut h.items, item)
    var at = h.items.len - 1
    for at > 0 {
        let parent = (at - 1) / 2
        if !h.less(h.items[at], h.items[parent]) {
            return
        }
        let swap = h.items[at]
        h.items[at] = h.items[parent]
        h.items[parent] = swap
        at = parent
    }
}

/// Removes and returns the item that `less` ranks first, or `none` when `h` is empty.
/// ///
/// /// Items that compare equal leave in no defined order. Sifting down takes `O(log n)` calls to `less`, but the call also copies the remaining items into a new slice, so its time is linear in `size(h)`.
pub fn pop[T](mut h: Heap[T]) -> T? {
    if h.items.len == 0 {
        return none
    }
    let top = h.items[0]
    let last = h.items[h.items.len - 1]
    var kept: []T = []
    for i in 0..h.items.len - 1 {
        push(mut kept, h.items[i])
    }
    h.items = kept
    if h.items.len == 0 {
        return top
    }
    h.items[0] = last
    var at = 0
    for {
        let left = 2 * at + 1
        let right = left + 1
        var smallest = at
        if left < h.items.len && h.less(h.items[left], h.items[smallest]) {
            smallest = left
        }
        if right < h.items.len && h.less(h.items[right], h.items[smallest]) {
            smallest = right
        }
        if smallest == at {
            return top
        }
        let swap = h.items[at]
        h.items[at] = h.items[smallest]
        h.items[smallest] = swap
        at = smallest
    }
}
