struct Entry[K, V] {
    key: K
    value: V
    prev: i64
    next: i64
}

pub struct Cache[K: Hash, V] {
    capacity: i64
    slots: [K: i64]
    entries: []Entry[K, V]
    head: i64
    tail: i64
}

pub fn cache[K: Hash, V](capacity: i64) -> Cache[K, V] {
    if capacity < 1 {
        __panic("lru: capacity must be at least 1")
    }
    Cache[K, V] { capacity: capacity, slots: [:], entries: [], head: -1, tail: -1 }
}

pub fn size[K: Hash, V](c: Cache[K, V]) -> i64 {
    c.entries.len
}

fn unlink[K: Hash, V](mut c: Cache[K, V], at: i64) {
    let e = c.entries[at]
    if e.prev >= 0 {
        c.entries[e.prev].next = e.next
    } else {
        c.head = e.next
    }
    if e.next >= 0 {
        c.entries[e.next].prev = e.prev
    } else {
        c.tail = e.prev
    }
}

fn link_front[K: Hash, V](mut c: Cache[K, V], at: i64) {
    c.entries[at].prev = -1
    c.entries[at].next = c.head
    if c.head >= 0 {
        c.entries[c.head].prev = at
    }
    c.head = at
    if c.tail < 0 {
        c.tail = at
    }
}

pub fn get[K: Hash, V](mut c: Cache[K, V], key: K) -> V? {
    let at = c.slots[key] ?? return none
    if at != c.head {
        unlink(mut c, at)
        link_front(mut c, at)
    }
    c.entries[at].value
}

pub fn contains[K: Hash, V](c: Cache[K, V], key: K) -> bool {
    match c.slots[key] {
        some(at) => true
        none => false
    }
}

pub fn put[K: Hash, V](mut c: Cache[K, V], key: K, value: V) -> K? {
    match c.slots[key] {
        some(at) => {
            c.entries[at].value = value
            if at != c.head {
                unlink(mut c, at)
                link_front(mut c, at)
            }
            return none
        }
        none => {}
    }
    if c.entries.len < c.capacity {
        push(mut c.entries, Entry[K, V] { key: key, value: value, prev: -1, next: -1 })
        let at = c.entries.len - 1
        c.slots[key] = at
        link_front(mut c, at)
        return none
    }
    let at = c.tail
    let evicted = c.entries[at].key
    unlink(mut c, at)
    delete(mut c.slots, evicted)
    c.entries[at].key = key
    c.entries[at].value = value
    c.slots[key] = at
    link_front(mut c, at)
    evicted
}

pub fn keys[K: Hash, V](c: Cache[K, V]) -> []K {
    var out: []K = []
    var at = c.head
    for at >= 0 {
        push(mut out, c.entries[at].key)
        at = c.entries[at].next
    }
    out
}
