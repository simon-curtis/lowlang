import std/yaml

fn describe(n: *yaml.Node) -> str {
    match n.value {
        Null => "null"
        Bool(b) => "bool {b}"
        Int(v) => "int {v}"
        Float(x) => "float {x}"
        Str(s) => "text {s}"
        Binary(data) => "binary of {data.len} bytes"
        Seq(items) => "sequence of {items.len}"
        Map(pairs) => "mapping of {pairs.len}"
    }
}

fn field(n: *yaml.Node, key: str) -> *yaml.Node {
    yaml.get(n, key) ?? yaml.node(yaml.Value.Null)
}

fn report(e: yaml.Error) -> str {
    match e {
        Syntax(line, column, message) => "line {line}, column {column}: {message}"
        TooManyNodes(line, column) => "too many nodes at line {line}, column {column}"
    }
}

/// Reads a multi-document stream whose first document shares settings through an anchor, then writes it back with the sharing kept.
fn main() {
    let source = "defaults: &base\n  retries: 3\n  timeout: 2.5\nservices:\n  - name: web\n    options: *base\n    replicas: 2\n  - name: worker\n    options: *base\n    enabled: no\n    token: !!binary aGVsbG8=\n---\nkind: note\nbody: |\n  line one\n  line two\n"
    let documents = yaml.parse_all(source) catch {
        e => {
            print(report(e))
            return
        }
    }
    print("{documents.len} documents")

    let services = field(documents[0], "services")
    let defaults = field(documents[0], "defaults")
    let list: []*yaml.Node = match services.value {
        Seq(items) => items
        _ => []
    }
    for service in list {
        let name = field(service, "name")
        let options = field(service, "options")
        let retries = field(options, "retries")
        print("{yaml.text(name) ?? "-"}: retries {yaml.integer(retries) ?? 0}, shared {options == defaults}")
        for key in ["replicas", "enabled", "token", "missing"] {
            match yaml.get(service, key) {
                some(n) => print("  {key} is {describe(n)}")
                none => print("  {key} is absent")
            }
        }
    }

    let body = field(documents[1], "body")
    print("body {yaml.text(body) ?? ""}")
    print(yaml.encode_all(documents))

    let bad = yaml.parse("a: 1\nb: [2, 3\n") catch {
        e => {
            print(report(e))
            return
        }
    }
    print(describe(bad))
}
