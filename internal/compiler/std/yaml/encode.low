import std/base64
import std/math
import std/text

struct Encoder {
    out: []u8
    refs: [*Node: i64]
    names: [*Node: str]
    written: [*Node: bool]
    used: [str: bool]
    next: i64
}

/// Returns the node `n` as YAML text in block style, ending in a newline.
///
/// A sequence is written as `- item` lines and a mapping as `key: value` lines, indented by two spaces per level; an empty sequence is `[]` and an empty mapping `{}`. The `Style` of a node is ignored. A node reachable more than once through the same `*Node` is written once with an anchor and then as `*alias`: the anchor is the node's `anchor` when that is a valid name no other node uses and `a1`, `a2` and so on otherwise. A string is plain when it would read back as the same string, which rules out text that resolves to a null, boolean or number, the YAML 1.1 words such as `yes` and `off`, and text that starts or ends with a space or has indicators in a position that matters. Otherwise it is single quoted, or double quoted with escapes when it holds control or other non-printable characters. A string with a line break is a literal `|` block when that can carry it exactly. A float is written with a `.` or an exponent, as `.nan`, `.inf` or `-.inf` when not finite. A `Binary` is written as `!!binary` and base64. A tag is written unless it is one that the value already implies, such as `tag:yaml.org,2002:str`. A key that is a collection, contains a line break or is longer than `1000` bytes is written with the `?` form. The output is meant to read back to the same value through `parse`.
pub fn encode(n: *Node) -> str {
    let e = new(Encoder { out: [], refs: [:], names: [:], written: [:], used: [:], next: 1 })
    name_shared(e, n)
    root(e, n)
    __str_view(e.out)
}

/// Returns the nodes `documents` as a YAML stream, each document starting with a `---` line.
///
/// Each document is written as `encode` writes it, and anchors are named per document. No documents give the empty string.
pub fn encode_all(documents: []*Node) -> str {
    var out: []u8 = []
    for d in documents {
        text.append(mut out, "---\n")
        text.append(mut out, encode(d))
    }
    __str_view(out)
}

fn count_refs(e: *Encoder, n: *Node) {
    let seen = e.refs[n] ?? 0
    e.refs[n] = seen + 1
    if seen > 0 {
        return
    }
    match n.value {
        Seq(items) => {
            for item in items {
                count_refs(e, item)
            }
        }
        Map(pairs) => {
            for p in pairs {
                count_refs(e, p.key)
                count_refs(e, p.value)
            }
        }
        _ => {}
    }
}

fn name_shared(e: *Encoder, n: *Node) {
    count_refs(e, n)
    for node, count in e.refs {
        if count > 1 && e.names[node] == none {
            e.names[node] = fresh_name(e, node.anchor)
        }
    }
}

fn anchor_name(name: str) -> bool {
    if name.len == 0 {
        return false
    }
    for i in 0..name.len {
        let c = name[i]
        if !((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '-' || c == '_') {
            return false
        }
    }
    true
}

fn fresh_name(e: *Encoder, wanted: str) -> str {
    if anchor_name(wanted) && !(e.used[wanted] ?? false) {
        e.used[wanted] = true
        return wanted
    }
    for {
        let name = "a{e.next}"
        e.next += 1
        if !(e.used[name] ?? false) {
            e.used[name] = true
            return name
        }
    }
    ""
}

fn root(e: *Encoder, n: *Node) {
    if alias(e, n) {
        push(mut e.out, '\n')
        return
    }
    let props = properties(e, n)
    if props.len > 0 {
        text.append(mut e.out, props)
        if collection(n) {
            push(mut e.out, '\n')
        } else {
            push(mut e.out, ' ')
        }
    }
    body(e, n, -1, 0)
}

fn alias(e: *Encoder, n: *Node) -> bool {
    let name = match e.names[n] {
        some(found) => found
        none => return false
    }
    if !(e.written[n] ?? false) {
        e.written[n] = true
        return false
    }
    text.append(mut e.out, "*{name}")
    true
}

fn properties(e: *Encoder, n: *Node) -> str {
    let tag = tag_text(n)
    match e.names[n] {
        some(name) => if tag.len > 0 { "&{name} {tag}" } else { "&{name}" }
        none => tag
    }
}

fn tag_text(n: *Node) -> str {
    let tag = n.tag
    if text.starts_with(tag, "tag:yaml.org,2002:") {
        let name = tag[18..]
        if name == "str" || name == "null" || name == "bool" || name == "int" || name == "float" || name == "seq" || name == "map" {
            return ""
        }
        return "!!{name}"
    }
    match n.value {
        Binary(_) => {
            if tag.len == 0 {
                return "!!binary"
            }
        }
        _ => {}
    }
    if tag.len == 0 || tag == "!" {
        return ""
    }
    if tag[0] == '!' && tag_safe(tag[1..]) {
        return tag
    }
    "!<{tag}>"
}

fn tag_safe(s: str) -> bool {
    if s.len == 0 {
        return false
    }
    for i in 0..s.len {
        let c = s[i]
        if c <= ' ' || c >= 0x7F || c == '!' || c == ',' || c == '[' || c == ']' || c == '{' || c == '}' || c == '%' {
            return false
        }
    }
    true
}

fn collection(n: *Node) -> bool {
    match n.value {
        Seq(items) => items.len > 0
        Map(pairs) => pairs.len > 0
        _ => false
    }
}

fn spaces(e: *Encoder, n: i64) {
    for i in 0..n {
        push(mut e.out, ' ')
    }
}

fn body(e: *Encoder, n: *Node, parent: i64, indent: i64) {
    match n.value {
        Seq(items) => {
            if items.len == 0 {
                text.append(mut e.out, "[]\n")
                return
            }
            for i, item in items {
                if i > 0 {
                    spaces(e, indent)
                }
                text.append(mut e.out, "-")
                entry(e, item, indent)
            }
        }
        Map(pairs) => {
            if pairs.len == 0 {
                text.append(mut e.out, "{{}}\n")
                return
            }
            for i, p in pairs {
                if i > 0 {
                    spaces(e, indent)
                }
                pair(e, p, indent)
            }
        }
        _ => {
            scalar(e, n, parent, if parent < 0 { 2 } else { parent + 2 })
            push(mut e.out, '\n')
        }
    }
}

fn entry(e: *Encoder, n: *Node, indent: i64) {
    push(mut e.out, ' ')
    if alias(e, n) {
        push(mut e.out, '\n')
        return
    }
    let props = properties(e, n)
    if props.len > 0 {
        text.append(mut e.out, props)
        if collection(n) {
            push(mut e.out, '\n')
            spaces(e, indent + 2)
        } else {
            push(mut e.out, ' ')
        }
    }
    body(e, n, indent, indent + 2)
}

fn pair(e: *Encoder, p: Pair, indent: i64) {
    let inline = inline_key(e, p.key)
    match inline {
        some(k) => {
            text.append(mut e.out, k)
            push(mut e.out, ':')
        }
        none => {
            push(mut e.out, '?')
            entry(e, p.key, indent)
            spaces(e, indent)
            push(mut e.out, ':')
        }
    }
    value(e, p.value, indent)
}

fn inline_key(e: *Encoder, k: *Node) -> str? {
    match e.names[k] {
        some(name) => {
            if e.written[k] ?? false {
                return "*{name} "
            }
        }
        none => {}
    }
    if collection(k) {
        return none
    }
    match k.value {
        Seq(_) => return none
        Map(_) => return none
        Str(s) => {
            if s.len > 1000 || has_break(s) {
                return none
            }
        }
        _ => {}
    }
    let props = properties(e, k)
    if e.names[k] != none {
        e.written[k] = true
    }
    let rendered = inline_scalar(k)
    if props.len > 0 {
        return "{props} {rendered}"
    }
    rendered
}

fn value(e: *Encoder, n: *Node, indent: i64) {
    let repeated = e.names[n] != none && (e.written[n] ?? false)
    if repeated {
        push(mut e.out, ' ')
    }
    if alias(e, n) {
        push(mut e.out, '\n')
        return
    }
    let props = properties(e, n)
    if props.len > 0 {
        push(mut e.out, ' ')
        text.append(mut e.out, props)
    }
    if collection(n) {
        push(mut e.out, '\n')
        spaces(e, indent + 2)
        body(e, n, indent, indent + 2)
        return
    }
    push(mut e.out, ' ')
    body(e, n, indent, indent + 2)
}

fn has_break(s: str) -> bool {
    text.index_byte(s, '\n') >= 0
}

fn float_text_out(x: f64) -> str {
    if math.is_nan(x) {
        return ".nan"
    }
    if math.is_inf(x) {
        return if x > 0.0 { ".inf" } else { "-.inf" }
    }
    text.float_decimal(x)
}

fn yaml11_word(w: str) -> bool {
    w == "y" || w == "n" || w == "yes" || w == "no" || w == "on" || w == "off" || w == "=" || w == "<<"
}

fn ambiguous(s: str) -> bool {
    if s.len <= 3 && yaml11_word(text.lower(s)) {
        return true
    }
    let first = s[0]
    if !((first >= '0' && first <= '9') || first == '+' || first == '-' || first == '.') {
        return false
    }
    if s.len >= 5 && s[4] == '-' && digits(s[..4], 0, 10) {
        return true
    }
    let numeric = "0123456789_:.+-eEabcdefABCDEFxXoO"
    var digit = false
    for i in 0..s.len {
        let c = s[i]
        if text.index_byte(numeric, c) < 0 {
            return false
        }
        if c >= '0' && c <= '9' {
            digit = true
        }
    }
    digit
}

fn inline_scalar(n: *Node) -> str {
    match n.value {
        Null => "null"
        Bool(b) => if b { "true" } else { "false" }
        Int(v) => "{v}"
        Float(x) => float_text_out(x)
        Str(s) => {
            if plain_safe(s, tag_text(n).len > 0) {
                return s
            }
            if printable(s, false) {
                return single_quoted(s)
            }
            double_quoted(s)
        }
        Binary(data) => base64.encode(data)
        _ => ""
    }
}

fn scalar(e: *Encoder, n: *Node, parent: i64, content: i64) {
    match n.value {
        Str(s) => {
            if has_break(s) && literal_safe(s) && (parent >= 0 || !indented_start(s)) {
                literal(e, s, parent, content)
                return
            }
        }
        _ => {}
    }
    text.append(mut e.out, inline_scalar(n))
}

fn printable(s: str, allow_break: bool) -> bool {
    var i = 0
    for i < s.len {
        let c = s[i]
        if c < 0x80 {
            if (c < 0x20 && c != '\t' && !(allow_break && c == '\n')) || c == 0x7F {
                return false
            }
            i += 1
            continue
        }
        if c == 0xC2 && i + 1 < s.len && s[i + 1] < 0xA0 {
            return false
        }
        if c == 0xE2 && i + 2 < s.len && s[i + 1] == 0x80 && (s[i + 2] == 0xA8 || s[i + 2] == 0xA9) {
            return false
        }
        if c == 0xEF && i + 2 < s.len && s[i + 1] == 0xBB && s[i + 2] == 0xBF {
            return false
        }
        i += 1
    }
    true
}

fn plain_safe(s: str, tagged: bool) -> bool {
    if s.len == 0 || !printable(s, false) || text.index_byte(s, '\t') >= 0 {
        return false
    }
    if !tagged {
        match resolve(s) catch Null {
            Str(_) => {}
            _ => return false
        }
        if ambiguous(s) {
            return false
        }
    }
    let first = s[0]
    let last = s[s.len - 1]
    if first == ' ' || first == '\t' || last == ' ' || last == '\t' || last == ':' {
        return false
    }
    if indicator(first) {
        if !(first == '-' || first == '?' || first == ':') || s.len == 1 || blank(s[1]) {
            return false
        }
    }
    if text.starts_with(s, "---") || text.starts_with(s, "...") {
        return false
    }
    for i in 0..s.len - 1 {
        let c = s[i]
        let n = s[i + 1]
        if (c == ':' && blank(n)) || (blank(c) && n == '#') {
            return false
        }
    }
    true
}

fn single_quoted(s: str) -> str {
    var out: []u8 = ['\'']
    for i in 0..s.len {
        if s[i] == '\'' {
            push(mut out, '\'')
        }
        push(mut out, s[i])
    }
    push(mut out, '\'')
    __str_view(out)
}

fn double_quoted(s: str) -> str {
    let digits = "0123456789ABCDEF"
    var out: []u8 = ['"']
    var i = 0
    for i < s.len {
        let c = s[i]
        if c == '"' || c == '\\' {
            push(mut out, '\\')
            push(mut out, c)
        } else if c == '\n' {
            text.append(mut out, "\\n")
        } else if c == '\t' {
            text.append(mut out, "\\t")
        } else if c == '\r' {
            text.append(mut out, "\\r")
        } else if c == 0 {
            text.append(mut out, "\\0")
        } else if c < 0x20 || c == 0x7F {
            text.append(mut out, "\\x")
            push(mut out, digits[i64(c >> 4)])
            push(mut out, digits[i64(c & 15)])
        } else if c == 0xC2 && i + 1 < s.len && s[i + 1] < 0xA0 {
            let low = s[i + 1]
            if low == 0x85 {
                text.append(mut out, "\\N")
            } else {
                text.append(mut out, "\\x")
                push(mut out, digits[i64(low >> 4)])
                push(mut out, digits[i64(low & 15)])
            }
            i += 1
        } else if c == 0xE2 && i + 2 < s.len && s[i + 1] == 0x80 && (s[i + 2] == 0xA8 || s[i + 2] == 0xA9) {
            text.append(mut out, if s[i + 2] == 0xA8 { "\\L" } else { "\\P" })
            i += 2
        } else if c == 0xEF && i + 2 < s.len && s[i + 1] == 0xBB && s[i + 2] == 0xBF {
            text.append(mut out, "\\uFEFF")
            i += 2
        } else {
            push(mut out, c)
        }
        i += 1
    }
    push(mut out, '"')
    __str_view(out)
}

fn literal_safe(s: str) -> bool {
    if !printable(s, true) {
        return false
    }
    for i in 0..s.len {
        if s[i] == '\t' && (i == 0 || s[i - 1] == '\n') {
            return false
        }
    }
    true
}

fn indented_start(s: str) -> bool {
    var first = 0
    for first < s.len && s[first] == '\n' {
        first += 1
    }
    first < s.len && s[first] == ' '
}

fn literal(e: *Encoder, s: str, parent: i64, content: i64) {
    var trailing = 0
    for trailing < s.len && s[s.len - 1 - trailing] == '\n' {
        trailing += 1
    }
    push(mut e.out, '|')
    if indented_start(s) {
        text.append(mut e.out, "{content - parent}")
    }
    if trailing == 0 {
        push(mut e.out, '-')
    } else if trailing > 1 || trailing == s.len {
        push(mut e.out, '+')
    }
    let lines = text.split(s[..s.len - trailing], '\n')
    for line in lines {
        push(mut e.out, '\n')
        if line.len > 0 {
            spaces(e, content)
            text.append(mut e.out, line)
        }
    }
    for i in 1..trailing {
        push(mut e.out, '\n')
    }
}
