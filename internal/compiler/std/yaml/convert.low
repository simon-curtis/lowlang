import std/serde

fn tree_of(v: Value) -> serde.Tree {
    match v {
        Null => serde.Tree.Null
        Bool(b) => serde.Tree.Bool(b)
        Int(n) => serde.Tree.Int(n)
        Float(x) => serde.Tree.Float(x)
        Str(s) => serde.Tree.Text(s)
        Binary(data) => serde.Tree.Binary(data)
        _ => serde.Tree.Opaque
    }
}

fn node_of(n: *Node) -> serde.Node {
    match n.value {
        Seq(items) => {
            var out: []serde.Node = []
            for item in items {
                push(mut out, node_of(item))
            }
            serde.Node { tree: serde.Tree.Seq(out), at: n.line }
        }
        Map(pairs) => {
            var out: []serde.Member = []
            for p in pairs {
                let member = serde.Member { key: node_of(p.key), value: node_of(p.value) }
                push(mut out, member)
            }
            serde.Node { tree: serde.Tree.Map(out), at: n.line }
        }
        _ => serde.Node { tree: tree_of(n.value), at: n.line }
    }
}

/// Converts the node `n` into a `T` through `std/serde`.
///
/// A struct is read from a mapping by key: unknown keys are skipped, a missing key takes the field's default or `none` for an optional, and any other missing key fails with `Missing`. Mapping keys that are scalars are matched as their text, so `1`, `true` and `null` match the names `"1"`, `"true"` and `"null"`. Integers are read from `Int`, floats from `Float` or `Int`, text from `Str` and a `[]u8` from a `Binary` node, which a `!!binary` scalar gives. An enum variant is a string, or a mapping with one key that names the variant. Fails with `serde.Error.Mismatch` when a node has another type, with `Range` for a negative integer read as unsigned, and with `UnknownVariant` and `Missing` as `serde.read` describes. In errors, `at` is the source line of the node.
pub fn from_node[T](n: *Node) -> T ! serde.Error {
    serde.read(serde.tree_reader(node_of(n), false))
}

/// Parses the YAML text `source` into a `T`, with default `Options`.
///
/// See `deserialize_with`.
pub fn deserialize[T](source: str) -> T ! serde.Error {
    deserialize_with(source, Options {})
}

/// Parses the YAML text `source` that holds one document into a `T`, as `options` says.
///
/// Equivalent to `parse_with` followed by `from_node`. A `Syntax` or `TooManyNodes` error becomes `serde.Error.Syntax` whose line is the line of the problem and whose message includes the line and column. Other failures are those of `from_node`.
pub fn deserialize_with[T](source: str, options: Options) -> T ! serde.Error {
    let n = parse_with(source, options) catch {
        Syntax(line, column, message) => fail serde.Error.Syntax(line, "{message} at line {line}, column {column}")
        TooManyNodes(line, column) => fail serde.Error.Syntax(line, "alias expansion exceeds the node budget at line {line}, column {column}")
    }
    from_node(n)
}

fn value_of(node: serde.Node) -> Value ! serde.Error {
    match node.tree {
        Null => Value.Null
        Bool(b) => Value.Bool(b)
        Int(n) => Value.Int(n)
        Uint(_) => fail serde.Error.Range(0)
        Float(x) => Value.Float(x)
        Text(s) => Str(s)
        Binary(data) => Value.Binary(data)
        Seq(items) => {
            var out: []*Node = []
            for item in items {
                push(mut out, yaml_node(item)?)
            }
            Value.Seq(out)
        }
        Map(members) => {
            var out: []Pair = []
            for m in members {
                let key = yaml_node(m.key)?
                let value = yaml_node(m.value)?
                push(mut out, Pair { key, value })
            }
            Value.Map(out)
        }
        _ => fail serde.Error.Mismatch("a value that YAML holds", 0)
    }
}

fn yaml_node(tree: serde.Node) -> *Node ! serde.Error {
    let v = value_of(tree)?
    node(v)
}

/// Converts `v` into a node tree through `std/serde`.
///
/// A struct and a map become a mapping with string keys, a slice a sequence, an enum variant without fields a string and a variant with fields a mapping with one key, the variant's name. A `[]u8` becomes a `Binary` node and an optional that is `none` a `Null` node. The nodes have no tags or anchors, `Plain` style and no position. Fails with `serde.Error.Range` when a `u64` is above `9223372036854775807`.
pub fn to_node[T](v: T) -> *Node ! serde.Error {
    yaml_node(serde.to_tree(v))
}

/// Returns `v` as YAML text.
///
/// Equivalent to `to_node` followed by `encode`; fails like `to_node`.
pub fn serialize[T](v: T) -> str ! serde.Error {
    let n = to_node(v)?
    encode(n)
}
