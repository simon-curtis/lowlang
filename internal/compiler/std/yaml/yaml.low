pub enum Error {
    Syntax(line: i64, column: i64, message: str)
    TooManyNodes(line: i64, column: i64)
}

pub enum Style {
    Plain
    SingleQuoted
    DoubleQuoted
    Literal
    Folded
    Block
    Flow
}

pub enum EventKind {
    StreamStart
    StreamEnd
    DocumentStart
    DocumentEnd
    SequenceStart
    SequenceEnd
    MappingStart
    MappingEnd
    Scalar
    Alias
}

pub struct Event {
    pub kind: EventKind
    pub anchor: str = ""
    pub tag: str = ""
    pub value: str = ""
    pub style: Style = Plain
    pub explicit: bool = false
    pub line: i64
    pub column: i64
}

pub enum Value {
    Null
    Bool(bool)
    Int(i64)
    Float(f64)
    Str(str)
    Binary([]u8)
    Seq([]*Node)
    Map([]Pair)
}

pub struct Node {
    pub value: Value
    pub tag: str = ""
    pub anchor: str = ""
    pub style: Style = Plain
    pub line: i64 = 0
    pub column: i64 = 0
}

pub struct Pair {
    pub key: *Node
    pub value: *Node
}

pub struct Options {
    pub max_nodes: i64 = 1000000
    pub max_depth: i64 = 512
}

pub fn node(v: Value) -> *Node {
    new(Node { value: v })
}

pub fn get(n: *Node, key: str) -> *Node? {
    match n.value {
        Map(pairs) => {
            for p in pairs {
                match p.key.value {
                    Str(k) => {
                        if k == key {
                            return p.value
                        }
                    }
                    _ => {}
                }
            }
            none
        }
        _ => none
    }
}

pub fn at(n: *Node, index: i64) -> *Node? {
    match n.value {
        Seq(items) => {
            if index >= 0 && index < items.len {
                return items[index]
            }
            none
        }
        _ => none
    }
}

pub fn text(n: *Node) -> str? {
    match n.value {
        Str(s) => s
        _ => none
    }
}

pub fn integer(n: *Node) -> i64? {
    match n.value {
        Int(v) => v
        _ => none
    }
}

pub fn float(n: *Node) -> f64? {
    match n.value {
        Float(v) => v
        Int(v) => f64(v)
        _ => none
    }
}

pub fn boolean(n: *Node) -> bool? {
    match n.value {
        Bool(v) => v
        _ => none
    }
}

pub fn is_null(n: *Node) -> bool {
    match n.value {
        Null => true
        _ => false
    }
}
