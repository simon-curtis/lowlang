import std/charset
import std/text
import std/uri

/// A header field of an HTTP request or response, of a multipart part, or of a mail message.
pub struct Header {
    /// The field name. Names read from the network are lowercase; names set by a program are sent as written.
    pub name: str
    /// The field value. Values read from the network have surrounding whitespace removed. A value containing `\r`, `\n` or a zero byte is rejected when written.
    pub value: str
}

/// A header value with parameters, such as `form-data; name="a"`.
pub struct Value {
    /// The text before the first `;`, trimmed.
    pub main: str
    /// The parameters in order, with names in lower case and values decoded.
    pub params: []Header
}

/// Returns the value of the first header in `headers` whose name equals `name`, ignoring case, or `none` when there is none.
pub fn get(headers: []Header, name: str) -> str? {
    for h in headers {
        if text.equal_fold(h.name, name) {
            return h.value
        }
    }
    none
}

/// Returns the values of every header in `headers` whose name equals `name`, ignoring case, in order. The slice is empty when there are none.
pub fn values(headers: []Header, name: str) -> []str {
    var out: []str = []
    for h in headers {
        if text.equal_fold(h.name, name) {
            push(mut out, h.value)
        }
    }
    out
}

/// Returns the headers of `headers` whose name differs from `name`, ignoring case, in a new slice.
pub fn remove(headers: []Header, name: str) -> []Header {
    var out: []Header = []
    for h in headers {
        if !text.equal_fold(h.name, name) {
            push(mut out, h)
        }
    }
    out
}

/// Returns `true` when `headers` has a header named `name`, ignoring case.
pub fn has(headers: []Header, name: str) -> bool {
    match get(headers, name) {
        some(_) => true
        none => false
    }
}

/// Appends a header to `headers`, keeping any existing headers of the same name.
pub fn add(mut headers: []Header, name: str, value: str) {
    push(mut headers, Header { name, value })
}

/// Replaces the value of the first header in `headers` named `name`, ignoring case, using the spelling of `name` given here, or appends the header when there is none. Further headers of the same name are left alone.
pub fn set(mut headers: []Header, name: str, value: str) {
    for i, h in headers {
        if text.equal_fold(h.name, name) {
            headers[i] = Header { name, value }
            return
        }
    }
    push(mut headers, Header { name, value })
}

/// Returns `true` when `c` may appear in an RFC 9110 token: a letter, a digit, the grave accent or one of `!#$%&'*+-.^_|~`.
pub fn token_byte(c: u8) -> bool {
    if c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9' {
        return true
    }
    text.index_byte("!#$%&'*+-.^_`|~", c) >= 0
}

/// Returns `true` when `s` is not empty and every byte is a token byte.
pub fn token(s: str) -> bool {
    if s.len == 0 {
        return false
    }
    for i in 0..s.len {
        if !token_byte(s[i]) {
            return false
        }
    }
    true
}

/// Returns `true` when `value` has no `\r`, `\n` or zero byte.
pub fn valid_value(value: str) -> bool {
    for i in 0..value.len {
        let c = value[i]
        if c == '\r' || c == '\n' || c == 0 {
            return false
        }
    }
    true
}

/// Returns `true` when the name of `h` is a token and its value passes `valid_value`.
pub fn valid(h: Header) -> bool {
    token(h.name) && valid_value(h.value)
}

/// Returns `value` as a quoted string for a header parameter.
///
/// `"` and `\` are escaped with a backslash, and a carriage return, line feed or zero byte becomes `%0D`, `%0A` or `%00`, so the result always passes `valid_value`.
pub fn quote(value: str) -> str {
    var out: []u8 = []
    push(mut out, '"')
    for i in 0..value.len {
        let c = value[i]
        if c == '"' || c == '\\' {
            push(mut out, '\\')
            push(mut out, c)
        } else if c == '\r' {
            text.append(mut out, "%0D")
        } else if c == '\n' {
            text.append(mut out, "%0A")
        } else if c == 0 {
            text.append(mut out, "%00")
        } else {
            push(mut out, c)
        }
    }
    push(mut out, '"')
    __str_view(out)
}

/// Parses a header value into its main part and parameters.
///
/// A parameter value may be a quoted string, in which `\"` and `\\` are unescaped. Parameters in the RFC 2231 forms are resolved: `name*=charset'language'text` is percent-decoded, and the pieces `name*0`, `name*1` and so on are joined in order. A value in `ISO-8859-1`, `latin1` or `US-ASCII` is converted to UTF-8, and any other charset is taken as UTF-8. The extended form wins over the plain one, and when a name is repeated the first occurrence wins.
pub fn parse_value(s: str) -> Value {
    let semi = text.index_byte(s, ';')
    if semi < 0 {
        return Value { main: text.trim(s), params: [] }
    }
    Value { main: text.trim(s[..semi]), params: resolve(raw_params(s, semi + 1)) }
}

/// Returns the value of the parameter `name`, or `none` when it is absent.
///
/// The name is matched without regard to case.
pub fn param(v: Value, name: str) -> str? {
    get(v.params, name)
}

fn skip_blanks(s: str, from: i64) -> i64 {
    var i = from
    for i < s.len && (text.space(s[i]) || s[i] == ';') {
        i += 1
    }
    i
}

fn raw_params(s: str, from: i64) -> []Header {
    var out: []Header = []
    var i = skip_blanks(s, from)
    for i < s.len {
        let name_start = i
        for i < s.len && s[i] != '=' && s[i] != ';' {
            i += 1
        }
        let name = text.lower(text.trim(s[name_start..i]))
        if i >= s.len || s[i] == ';' {
            if name.len > 0 {
                push(mut out, Header { name, value: "" })
            }
            i = skip_blanks(s, i)
            continue
        }
        i += 1
        for i < s.len && text.space(s[i]) {
            i += 1
        }
        var value = ""
        if i < s.len && s[i] == '"' {
            var bytes_out: []u8 = []
            i += 1
            for i < s.len && s[i] != '"' {
                if s[i] == '\\' && i + 1 < s.len && (s[i + 1] == '"' || s[i + 1] == '\\') {
                    i += 1
                }
                push(mut bytes_out, s[i])
                i += 1
            }
            if i < s.len {
                i += 1
            }
            for i < s.len && s[i] != ';' {
                i += 1
            }
            value = __str_view(bytes_out)
        } else {
            let value_start = i
            for i < s.len && s[i] != ';' {
                i += 1
            }
            value = text.trim(s[value_start..i])
        }
        if name.len > 0 {
            push(mut out, Header { name, value })
        }
        i = skip_blanks(s, i)
    }
    out
}

struct Extended {
    charset: str
    data: str
}

struct Piece {
    base: str
    order: i64
    extended: bool
    value: str
}

fn charset_text(label: str, data: []u8) -> str {
    charset.decode_lossy(label, data) catch {
        _ => __str_view(data)
    }
}

fn split_extended(value: str) -> Extended? {
    let first = text.index_byte(value, '\'')
    if first < 0 {
        return none
    }
    let rest = value[first + 1..]
    let second = text.index_byte(rest, '\'')
    if second < 0 {
        return none
    }
    Extended { charset: value[..first], data: rest[second + 1..] }
}

fn decode_extended(value: str) -> str {
    match split_extended(value) {
        some(e) => {
            let decoded = uri.unescape_lossy(e.data)
            charset_text(e.charset, bytes(decoded))
        }
        none => value
    }
}

fn piece_of(h: Header) -> Piece {
    let star = text.index_byte(h.name, '*')
    if star < 0 {
        return Piece { base: h.name, order: -2, extended: false, value: h.value }
    }
    let rest = h.name[star + 1..]
    if rest.len == 0 {
        return Piece { base: h.name[..star], order: -1, extended: true, value: h.value }
    }
    var digits = rest
    var extended = false
    if rest[rest.len - 1] == '*' {
        digits = rest[..rest.len - 1]
        extended = true
    }
    let order = text.parse_int(digits) catch -3
    Piece { base: h.name[..star], order, extended, value: h.value }
}

fn joined(pieces: []Piece) -> str {
    var numbered: []Piece = []
    for p in pieces {
        if p.order >= 0 {
            push(mut numbered, p)
        }
    }
    var i = 1
    for i < numbered.len {
        var j = i
        for j > 0 && numbered[j - 1].order > numbered[j].order {
            let swap = numbered[j]
            numbered[j] = numbered[j - 1]
            numbered[j - 1] = swap
            j -= 1
        }
        i += 1
    }
    var charset = ""
    var data: []u8 = []
    var expect = 0
    for p in numbered {
        if p.order != expect {
            break
        }
        expect += 1
        var piece = p.value
        if p.order == 0 && p.extended {
            match split_extended(p.value) {
                some(e) => {
                    charset = e.charset
                    piece = e.data
                }
                none => {
                    piece = ""
                }
            }
        }
        if p.extended {
            text.append(mut data, uri.unescape_lossy(piece))
        } else {
            text.append(mut data, piece)
        }
    }
    charset_text(charset, data)
}

fn resolve(raw: []Header) -> []Header {
    var out: []Header = []
    var seen: [str: bool] = [:]
    for h in raw {
        let base = piece_of(h).base
        match seen[base] {
            some(_) => continue
            none => {}
        }
        seen[base] = true
        var pieces: []Piece = []
        for other in raw {
            let p = piece_of(other)
            if p.base == base {
                push(mut pieces, p)
            }
        }
        push(mut out, Header { name: base, value: resolved_value(pieces) })
    }
    out
}

fn resolved_value(pieces: []Piece) -> str {
    for p in pieces {
        if p.order == -1 {
            return decode_extended(p.value)
        }
    }
    for p in pieces {
        if p.order >= 0 {
            return joined(pieces)
        }
    }
    for p in pieces {
        if p.order == -2 {
            return p.value
        }
    }
    ""
}
