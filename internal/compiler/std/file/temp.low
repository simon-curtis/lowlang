import std/io
import std/os
import std/sys

/// A temporary file that is closed and removed when dropped, unless `keep` was called.
pub struct TempFile {
    /// The open file, readable and writable.
    pub file: File
    /// The path of the file.
    pub path: str
    kept: bool = false
    drop {
        if !kept {
            sys.unlink(path) or {}
        }
    }
}

const temp_attempts = 64
const temp_alphabet = "0123456789abcdefghijklmnopqrstuvwxyz"

fn temp_root(dir: str) -> str {
    if dir.len == 0 {
        return os.temp_dir_path()
    }
    dir
}

fn random_suffix(length: i64) -> str ! io.Error {
    let raw = sys.random_bytes(length)?
    let letters = io.buffer(length)
    let alphabet = temp_alphabet
    for i in 0..length {
        letters[i] = alphabet[i64(raw[i]) % alphabet.len]
    }
    str(letters)
}

fn last_star(pattern: str) -> i64 {
    var i = pattern.len
    for i > 0 {
        i -= 1
        if pattern[i] == '*' {
            return i
        }
    }
    -1
}

fn expand_pattern(pattern: str) -> str ! io.Error {
    let suffix = random_suffix(10)?
    let star = last_star(pattern)
    if star < 0 {
        return "{pattern}{suffix}"
    }
    "{pattern[..star]}{suffix}{pattern[star + 1..]}"
}

fn check_pattern(pattern: str) ! io.Error {
    for i in 0..pattern.len {
        if pattern[i] == '/' {
            fail Invalid
        }
    }
}

/// Creates a uniquely named temporary file and returns it.
///
/// The file is created in `dir`, or in `os.temp_dir_path()` when `dir` is empty; `dir` must already exist. `pattern` is the file name: its last `*` is replaced by ten random characters from `0-9a-z`, and the characters are appended when there is no `*`. The file is opened read-write with `O_EXCL` and mode `0o600`.
///
/// Fails with `Invalid` when `pattern` contains `/` and `Exists` after 64 name collisions.
pub fn temp_file(dir: str, pattern: str) -> TempFile ! io.Error {
    check_pattern(pattern)?
    let root = temp_root(dir)
    for _ in 0..temp_attempts {
        let name = expand_pattern(pattern)?
        let path = child_path(root, name)
        let opened = sys.open(path, sys.Open.Fresh, 0o600) catch {
            Exists => continue
            e => fail e
        }
        return TempFile { file: File { handle: handle(opened) }, path }
    }
    fail Exists
}

/// Stops `t` from removing its file when dropped and returns the file's path.
///
/// The file is still closed when `t` is dropped.
pub fn keep(mut t: TempFile) -> str {
    t.kept = true
    t.path
}

/// Creates a uniquely named temporary directory with mode `0o700` and returns its path.
///
/// `dir`, `pattern` and the failures are as for `temp_file`. The caller removes the directory.
pub fn temp_dir_pattern(dir: str, pattern: str) -> str ! io.Error {
    check_pattern(pattern)?
    let root = temp_root(dir)
    for _ in 0..temp_attempts {
        let name = expand_pattern(pattern)?
        let path = child_path(root, name)
        sys.mkdir(path, 0o700) catch {
            Exists => continue
            e => fail e
        }
        return path
    }
    fail Exists
}

/// Creates a private directory under `os.temp_dir_path()` and returns its path.
///
/// The name is `prefix` followed by ten random characters from `0-9a-z` and the mode is `0o700`. Fails with `Invalid` when `prefix` contains `/` and `Exists` after 64 name collisions. The caller removes the directory; see `temp_dir_pattern` to choose the parent.
pub fn temp_dir(prefix: str) -> str ! io.Error {
    temp_dir_pattern("", "{prefix}*")?
}
