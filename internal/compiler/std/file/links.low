import std/io

pub struct Usage {
    pub total: i64
    pub free: i64
    pub available: i64
    pub files: i64
    pub files_free: i64
}

pub fn lstat(path: str) -> Info ! io.Error {
    let buf = io.buffer(144)
    io.syscall_result(__syscall(262, at_cwd(), cstr(path), __slice_ptr(buf), 0x100))?
    decode_stat(buf)
}

pub fn is_dir(path: str) -> bool {
    let meta = stat(path) catch { _ => return false }
    meta.dir
}

pub fn is_file(path: str) -> bool {
    let meta = stat(path) catch { _ => return false }
    meta.regular
}

pub fn is_symlink(path: str) -> bool {
    let meta = lstat(path) catch { _ => return false }
    meta.link
}

fn lexists(path: str) -> bool {
    let buf = io.buffer(144)
    __syscall(262, at_cwd(), cstr(path), __slice_ptr(buf), 0x100) == 0
}

pub fn symlink(target: str, link_path: str) ! io.Error {
    io.syscall_result(__syscall(266, cstr(target), at_cwd(), cstr(link_path)))?
}

pub fn link(existing: str, new_path: str) ! io.Error {
    io.syscall_result(__syscall(265, at_cwd(), cstr(existing), at_cwd(), cstr(new_path), 0))?
}

pub fn readlink(path: str) -> str ! io.Error {
    var size = 256
    for size <= 1048576 {
        let buf = io.buffer(size)
        let n = io.syscall_result(__syscall(267, at_cwd(), cstr(path), __slice_ptr(buf), size))?
        if n < size {
            return str(buf[..n])
        }
        size *= 4
    }
    fail TooLarge
}

pub fn realpath(path: str) -> str ! io.Error {
    let fd = io.syscall_result(__syscall(257, at_cwd(), cstr(path), 0x280000, 0))?
    defer __syscall(3, fd)
    readlink("/proc/self/fd/{fd}")?
}

pub fn chown(path: str, uid: i64, gid: i64) ! io.Error {
    io.syscall_result(__syscall(260, at_cwd(), cstr(path), uid, gid, 0))?
}

pub fn lchown(path: str, uid: i64, gid: i64) ! io.Error {
    io.syscall_result(__syscall(260, at_cwd(), cstr(path), uid, gid, 0x100))?
}

pub fn set_times(path: str, accessed: i64, modified: i64) ! io.Error {
    let times = io.buffer(32)
    io.set_le64(times, 0, accessed)
    io.set_le64(times, 16, modified)
    io.syscall_result(__syscall(280, at_cwd(), cstr(path), __slice_ptr(times), 0))?
}

pub fn disk_usage(path: str) -> Usage ! io.Error {
    let buf = io.buffer(120)
    io.syscall_result(__syscall(137, cstr(path), __slice_ptr(buf)))?
    var unit = io.le64(buf, 72)
    if unit == 0 {
        unit = io.le64(buf, 8)
    }
    Usage {
        total: io.le64(buf, 16) * unit
        free: io.le64(buf, 24) * unit
        available: io.le64(buf, 32) * unit
        files: io.le64(buf, 40)
        files_free: io.le64(buf, 48)
    }
}
