import std/io
import paths = std/path
import std/text

fn copy_stream(source: File, dest: File) ! io.Error {
    let chunk = io.buffer(65536)
    for {
        let n = read(source, chunk)?
        if n == 0 {
            break
        }
        write_all(dest, chunk[..n])?
    }
}

pub fn copy(from: str, to: str) ! io.Error {
    using source = open(from)?
    let meta = info(source)?
    if meta.dir {
        fail IsDir
    }
    if exists(to) {
        let target = stat(to)?
        if target.device == meta.device && target.inode == meta.inode {
            fail Invalid
        }
    }
    {
        using dest = create_mode(to, meta.mode)?
        copy_stream(source, dest)?
    }
    chmod(to, meta.mode)?
}

fn real_target(to: str) -> str ! io.Error {
    if lexists(to) {
        return realpath(to)?
    }
    let parent = realpath(paths.dir(to))?
    "{parent}/{paths.base(to)}"
}

fn copy_link(from: str, to: str) ! io.Error {
    let target = readlink(from)?
    if lexists(to) {
        remove(to)?
    }
    symlink(target, to)?
}

fn copy_tree(from: str, to: str) ! io.Error {
    let meta = stat(from)?
    make_missing(to, 0o700)?
    for entry in read_dir_info(from)? {
        let source = child_path(from, entry.name)
        let dest = child_path(to, entry.name)
        if entry.link {
            copy_link(source, dest)?
        } else if entry.dir {
            copy_tree(source, dest)?
        } else if entry.regular {
            copy(source, dest)?
        } else {
            fail Unsupported
        }
    }
    chmod(to, meta.mode)?
}

pub fn copy_dir(from: str, to: str) ! io.Error {
    if !stat(from)?.dir {
        fail NotDir
    }
    let source = realpath(from)?
    let target = real_target(to)?
    if target == source || text.starts_with(target, "{source}/") {
        fail Invalid
    }
    copy_tree(from, to)?
}
