import std/io

pub struct File {
    pub fd: i64
}

pub struct Info {
    pub size: i64
    pub mode: i64
    pub dir: bool
    pub modified: i64
}

pub enum Whence {
    Start
    Current
    End
}

fn at_cwd() -> i64 {
    -100
}

fn retry(r: i64) -> bool {
    r == -4
}

fn open_with(path: str, flags: i64) -> File ! io.Error {
    for {
        let r = __syscall(257, at_cwd(), cstr(path), flags, 0x1A4)
        if !retry(r) {
            return File { fd: io.syscall_result(r)? }
        }
    }
}

pub fn open(path: str) -> File ! io.Error {
    open_with(path, 0x80000)
}

pub fn create(path: str) -> File ! io.Error {
    open_with(path, 0x80241)
}

pub fn append(path: str) -> File ! io.Error {
    open_with(path, 0x80441)
}

pub fn update(path: str) -> File ! io.Error {
    open_with(path, 0x80042)
}

pub fn close(f: File) {
    __syscall(3, f.fd)
}

pub fn try_lock(f: File, exclusive: bool) -> bool ! io.Error {
    let r = __syscall(73, f.fd, if exclusive { 6 } else { 5 })
    if r == -11 {
        return false
    }
    io.syscall_result(r)?
    true
}

pub fn unlock(f: File) ! io.Error {
    io.syscall_result(__syscall(73, f.fd, 8))?
}

pub fn read(f: File, buf: []u8) -> i64 ! io.Error {
    for {
        let r = __syscall(0, f.fd, __slice_ptr(buf), buf.len)
        if !retry(r) {
            return io.syscall_result(r)
        }
    }
}

pub fn write(f: File, data: []u8) -> i64 ! io.Error {
    for {
        let r = __syscall(1, f.fd, __slice_ptr(data), data.len)
        if !retry(r) {
            return io.syscall_result(r)
        }
    }
}

pub fn write_all(f: File, data: []u8) ! io.Error {
    var rest = data
    for rest.len > 0 {
        let n = write(f, rest)?
        rest = rest[n..]
    }
}

pub fn write_str(f: File, text: str) ! io.Error {
    write_all(f, bytes(text))?
}

pub fn seek(f: File, offset: i64, from: Whence) -> i64 ! io.Error {
    let whence = match from {
        Start => 0
        Current => 1
        End => 2
    }
    io.syscall_result(__syscall(8, f.fd, offset, whence))
}

pub fn sync(f: File) ! io.Error {
    io.syscall_result(__syscall(74, f.fd))?
}

pub fn truncate(f: File, size: i64) ! io.Error {
    io.syscall_result(__syscall(77, f.fd, size))?
}

fn decode_stat(buf: []u8) -> Info {
    let mode = io.le32(buf, 24)
    Info { size: io.le64(buf, 48), mode: mode & 0xFFF, dir: mode & 0xF000 == 0x4000, modified: io.le64(buf, 88) }
}

pub fn info(f: File) -> Info ! io.Error {
    let buf = io.buffer(144)
    io.syscall_result(__syscall(5, f.fd, __slice_ptr(buf)))?
    decode_stat(buf)
}

pub fn stat(path: str) -> Info ! io.Error {
    let buf = io.buffer(144)
    io.syscall_result(__syscall(262, at_cwd(), cstr(path), __slice_ptr(buf), 0))?
    decode_stat(buf)
}

pub fn exists(path: str) -> bool {
    __syscall(21, cstr(path), 0) == 0
}

pub fn read_file(path: str) -> []u8 ! io.Error {
    let f = open(path)?
    defer close(f)
    var out: []u8 = []
    let chunk = io.buffer(65536)
    for {
        let n = read(f, chunk)?
        if n == 0 {
            break
        }
        io.append(mut out, chunk[..n])
    }
    out
}

pub fn read_text(path: str) -> str ! io.Error {
    __str_view(read_file(path)?)
}

pub fn write_file(path: str, data: []u8) ! io.Error {
    let f = create(path)?
    defer close(f)
    write_all(f, data)?
}

pub fn write_text(path: str, text: str) ! io.Error {
    write_file(path, bytes(text))?
}

pub fn remove(path: str) ! io.Error {
    io.syscall_result(__syscall(263, at_cwd(), cstr(path), 0))?
}

pub fn remove_dir(path: str) ! io.Error {
    io.syscall_result(__syscall(263, at_cwd(), cstr(path), 0x200))?
}

pub fn rename(from: str, to: str) ! io.Error {
    io.syscall_result(__syscall(264, at_cwd(), cstr(from), at_cwd(), cstr(to)))?
}

pub fn mkdir(path: str) ! io.Error {
    io.syscall_result(__syscall(258, at_cwd(), cstr(path), 0x1ED))?
}

pub fn mkdir_all(path: str) ! io.Error {
    for i in 1..path.len {
        if path[i] == '/' {
            make_missing(path[..i])?
        }
    }
    make_missing(path)?
}

fn make_missing(path: str) ! io.Error {
    let r = __syscall(258, at_cwd(), cstr(path), 0x1ED)
    if r != -17 {
        io.syscall_result(r)?
    }
}

pub fn list(path: str) -> []str ! io.Error {
    let f = open_with(path, 0x90000)?
    defer close(f)
    var names: []str = []
    let buf = io.buffer(32768)
    for {
        let n = io.syscall_result(__syscall(217, f.fd, __slice_ptr(buf), buf.len))?
        if n == 0 {
            break
        }
        var at = 0
        for at < n {
            let name = entry_name(buf, at + 19)
            if name != "." && name != ".." {
                push(mut names, name)
            }
            at += io.le16(buf, at + 16)
        }
    }
    names
}

fn entry_name(buf: []u8, from: i64) -> str {
    var end = from
    for buf[end] != 0 {
        end += 1
    }
    str(buf[from..end])
}

pub fn stream(f: File) -> io.Stream {
    io.Stream {
        read: fn(buf) { read(f, buf) }
        write: fn(data) { write(f, data) }
        close: fn() { close(f) }
    }
}
