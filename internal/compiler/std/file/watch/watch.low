import std/file
import std/io
import std/sys
import std/text

/// The kind of change an `Event` reports.
pub enum Kind {
    /// An entry was created in a watched directory.
    Created
    /// The contents of a file were written.
    Modified
    /// An entry was removed from a watched directory.
    Deleted
    /// An entry was moved out of a watched directory; the matching `MovedTo` event has the same `cookie`.
    MovedFrom
    /// An entry was moved into a watched directory.
    MovedTo
    /// Metadata such as permissions, ownership or timestamps changed.
    Attrib
    /// A file that was open for writing was closed.
    Closed
    /// A file that was open only for reading was closed. Reported only with `Options.access`.
    ClosedUnmodified
    /// A file was opened. Reported only with `Options.access`.
    Opened
    /// A file was read. Reported only with `Options.access`.
    Accessed
    /// A path passed to `add` was deleted.
    SelfDeleted
    /// A path passed to `add` was moved.
    SelfMoved
    /// The kernel dropped events because its queue overflowed. `watched`, `name` and `path` are empty.
    Overflow
}

/// A change to a watched path.
pub struct Event {
    /// The watched path the event arose on, as it was passed to `add` or, for a recursive watch, the path of the watched subdirectory.
    pub watched: str
    /// The name of the affected entry inside the watched directory, empty when the event is about the watched path itself.
    pub name: str
    /// The path of the affected entry: `watched` joined with `name`, or `watched` when `name` is empty.
    pub path: str
    /// The kind of change.
    pub kind: Kind
    /// Whether the affected entry is a directory.
    pub dir: bool
    /// Links a `MovedFrom` event to its `MovedTo` event, which share a non-zero value; `0` for other kinds.
    pub cookie: i64
}

/// Settings for a `Watcher`.
pub struct Options {
    /// Whether to also watch every subdirectory, including those created or moved in later. Symbolic links are not followed. Defaults to `false`.
    pub recursive: bool = false
    /// Whether to also report `Opened`, `Accessed` and `ClosedUnmodified`. Defaults to `false`.
    pub access: bool = false
}

struct Target {
    path: str
    root: bool
}

struct State {
    lock: i64
    targets: [i64: Target]
    queue: []Event
    head: i64
    closed: bool
    done: chan[bool]
    recursive: bool
    mask: i64
}

/// A copyable view of a `Watcher`, made of its inotify descriptor and the state shared with the watcher.
///
/// Once the watcher is stopped, operations on the handle fail with `NotConnected`.
pub struct WatcherHandle {
    /// The inotify file descriptor.
    pub fd: i64
    state: *State
    descriptor: sys.FdHandle
}

/// Watches files and directories for changes through inotify.
///
/// Dropping a watcher stops it, unless `detach` was called.
pub struct Watcher {
    /// The copyable view of the watcher.
    pub handle: WatcherHandle
    detached: bool = false
    drop {
        if !detached {
            stop_on(handle)
        }
    }
}

fn in_access() -> i64 {
    0x1
}

fn in_modify() -> i64 {
    0x2
}

fn in_attrib() -> i64 {
    0x4
}

fn in_close_write() -> i64 {
    0x8
}

fn in_close_nowrite() -> i64 {
    0x10
}

fn in_open() -> i64 {
    0x20
}

fn in_moved_from() -> i64 {
    0x40
}

fn in_moved_to() -> i64 {
    0x80
}

fn in_create() -> i64 {
    0x100
}

fn in_delete() -> i64 {
    0x200
}

fn in_delete_self() -> i64 {
    0x400
}

fn in_move_self() -> i64 {
    0x800
}

fn in_overflow() -> i64 {
    0x4000
}

fn in_ignored() -> i64 {
    0x8000
}

fn in_isdir() -> i64 {
    0x40000000
}

fn change_mask() -> i64 {
    in_modify() | in_attrib() | in_close_write() | in_moved_from() | in_moved_to() | in_create() | in_delete() | in_delete_self() | in_move_self()
}

fn access_mask() -> i64 {
    in_access() | in_close_nowrite() | in_open()
}

fn watch_mask(options: Options) -> i64 {
    if options.access {
        return change_mask() | access_mask()
    }
    change_mask()
}

fn read_size() -> i64 {
    4096
}

fn header_size() -> i64 {
    16
}

fn has(mask: i64, bit: i64) -> bool {
    mask & bit != 0
}

fn lock(s: *State) {
    __lock(mut s.lock)
}

fn unlock(s: *State) {
    __unlock(mut s.lock)
}

fn poke(fd: i64) {
    let wd = sys.inotify_add(fd, "/", in_attrib()) or return
    sys.inotify_remove(fd, wd) or {}
}

fn wake_reader(fd: i64, s: *State) {
    lock(s)
    s.closed = true
    unlock(s)
    close(s.done)
    poke(fd)
}

/// Returns a watcher that watches nothing yet, configured by `options`.
///
/// Use `add` to choose the paths.
pub fn create(options: Options) -> Watcher ! io.Error {
    let fd = sys.inotify_init()?
    let s = new(State {
        lock: 0
        targets: [:]
        queue: []
        head: 0
        closed: false
        done: chan[bool](1)
        recursive: options.recursive
        mask: watch_mask(options)
    })
    let descriptor = sys.wrap_with(fd, fn() { wake_reader(fd, s) })
    let view = WatcherHandle { fd, state: s, descriptor }
    Watcher { handle: view }
}

/// Returns a watcher over `paths` with default `Options`.
///
/// Fails with the error of the first path that cannot be watched, such as `NotFound`; the watcher is stopped.
pub fn watch(paths: []str) -> Watcher ! io.Error {
    watch_with(paths, Options {})?
}

/// Returns a watcher over `paths` configured by `options`.
///
/// Fails with the error of the first path that cannot be watched, such as `NotFound`; the watcher is stopped.
pub fn watch_with(paths: []str, options: Options) -> Watcher ! io.Error {
    using var w = create(options)?
    for path in paths {
        add(w, path)?
    }
    adopt(detach(mut w))
}

/// Returns a `Watcher` that owns the watcher viewed by `h`, so that dropping it stops the watcher.
pub fn adopt(h: WatcherHandle) -> Watcher {
    Watcher { handle: h }
}

/// Returns the handle of `w` and releases `w`, so that dropping `w` no longer stops the watcher.
///
/// The caller stops it with `stop_on` or by adopting the handle.
pub fn detach(mut w: Watcher) -> WatcherHandle {
    w.detached = true
    w.handle
}

/// Stops the watcher.
///
/// A `next` call that is waiting fails with `NotConnected`, as do later calls, and a channel from `events` closes. Stopping twice does nothing.
pub fn stop(w: Watcher) {
    stop_on(w.handle)
}

/// Stops the watcher that `h` views, as `stop` does.
pub fn stop_on(h: WatcherHandle) {
    sys.close_on(h.descriptor)
}

/// Starts watching `path`.
///
/// With `Options.recursive` and a directory, every existing subdirectory is watched too. Fails with `NotFound` when `path` does not exist.
pub fn add(w: Watcher, path: str) ! io.Error {
    add_on(w.handle, path)?
}

/// Starts watching `path` through the handle `h`, as `add` does.
pub fn add_on(h: WatcherHandle, path: str) ! io.Error {
    using lease = sys.enter(h.descriptor)?
    track(h, path, true)?
}

/// Stops watching `path` and every watched path below it.
///
/// Fails with `NotFound` when `path` is not watched.
pub fn remove(w: Watcher, path: str) ! io.Error {
    remove_on(w.handle, path)?
}

/// Stops watching `path` and every watched path below it through the handle `h`, as `remove` does.
pub fn remove_on(h: WatcherHandle, path: str) ! io.Error {
    using lease = sys.enter(h.descriptor)?
    let wds = matching(h.state, path)
    if wds.len == 0 {
        fail NotFound
    }
    forget(h, wds)
}

fn matching(s: *State, path: str) -> []i64 {
    let prefix = "{path}/"
    var wds: []i64 = []
    lock(s)
    for wd, t in s.targets {
        if t.path == path || text.starts_with(t.path, prefix) {
            push(mut wds, wd)
        }
    }
    unlock(s)
    wds
}

fn forget(h: WatcherHandle, wds: []i64) {
    lock(h.state)
    for wd in wds {
        delete(mut h.state.targets, wd)
    }
    unlock(h.state)
    for wd in wds {
        sys.inotify_remove(h.fd, wd) or {}
    }
}

fn track(h: WatcherHandle, path: str, root: bool) ! io.Error {
    let wd = sys.inotify_add(h.fd, path, h.state.mask)?
    lock(h.state)
    h.state.targets[wd] = Target { path, root }
    unlock(h.state)
    if h.state.recursive && file.is_dir(path) {
        track_children(h, path)?
    }
}

fn track_children(h: WatcherHandle, path: str) ! io.Error {
    for entry in file.read_dir_info(path)? {
        if entry.dir && !entry.link {
            let child = file.child_path(path, entry.name)
            track(h, child, false) catch {
                NotFound => {}
                e => fail e
            }
        }
    }
}

fn kind_of(mask: i64) -> Kind? {
    if has(mask, in_create()) {
        return Created
    }
    if has(mask, in_modify()) {
        return Modified
    }
    if has(mask, in_delete()) {
        return Deleted
    }
    if has(mask, in_moved_from()) {
        return MovedFrom
    }
    if has(mask, in_moved_to()) {
        return MovedTo
    }
    if has(mask, in_attrib()) {
        return Attrib
    }
    if has(mask, in_close_write()) {
        return Closed
    }
    if has(mask, in_close_nowrite()) {
        return ClosedUnmodified
    }
    if has(mask, in_open()) {
        return Opened
    }
    if has(mask, in_access()) {
        return Accessed
    }
    if has(mask, in_delete_self()) {
        return SelfDeleted
    }
    if has(mask, in_move_self()) {
        return SelfMoved
    }
    none
}

fn is_self(kind: Kind) -> bool {
    kind == SelfDeleted || kind == SelfMoved
}

fn overflow_event() -> Event {
    Event { watched: "", name: "", path: "", kind: Overflow, dir: false, cookie: 0 }
}

fn event_of(t: Target, mask: i64, cookie: i64, name: str) -> Event? {
    let kind = kind_of(mask) ?? return none
    if is_self(kind) && !t.root {
        return none
    }
    some(Event {
        watched: t.path
        name
        path: file.child_path(t.path, name)
        kind
        dir: has(mask, in_isdir())
        cookie
    })
}

fn name_at(buf: []u8, from: i64, length: i64) -> str {
    var end = from
    for end < from + length && buf[end] != 0 {
        end += 1
    }
    str(buf[from..end])
}

fn target_of(s: *State, wd: i64) -> Target? {
    lock(s)
    let t = s.targets[wd]
    unlock(s)
    t
}

fn ignore(s: *State, wd: i64) {
    lock(s)
    delete(mut s.targets, wd)
    unlock(s)
}

fn decode(h: WatcherHandle, buf: []u8, n: i64) -> []Event {
    var events: []Event = []
    var at = 0
    for at + header_size() <= n {
        let wd = io.le32(buf, at)
        let mask = io.le32(buf, at + 4)
        let cookie = io.le32(buf, at + 8)
        let length = io.le32(buf, at + 12)
        let name = name_at(buf, at + header_size(), length)
        at += header_size() + length
        if has(mask, in_overflow()) {
            push(mut events, overflow_event())
        } else if has(mask, in_ignored()) {
            ignore(h.state, wd)
        } else {
            let t = target_of(h.state, wd) ?? continue
            let e = event_of(t, mask, cookie, name) ?? continue
            push(mut events, e)
        }
    }
    events
}

fn enqueue(s: *State, events: []Event) {
    lock(s)
    for e in events {
        push(mut s.queue, e)
    }
    unlock(s)
}

fn dequeue(s: *State) -> Event? {
    lock(s)
    var out: Event? = none
    if s.head < s.queue.len {
        out = some(s.queue[s.head])
        s.head += 1
        if s.head == s.queue.len {
            s.queue = []
            s.head = 0
        }
    }
    unlock(s)
    out
}

fn is_closed(s: *State) -> bool {
    lock(s)
    let closed = s.closed
    unlock(s)
    closed
}

fn follow(h: WatcherHandle, events: []Event) ! io.Error {
    if !h.state.recursive {
        return
    }
    for e in events {
        if !e.dir {
            continue
        }
        if e.kind == Created || e.kind == MovedTo {
            track(h, e.path, false) catch {
                err => match err {
                    NotFound => {}
                    _ => fail err
                }
            }
        } else if e.kind == MovedFrom {
            forget(h, matching(h.state, e.path))
        }
    }
}

fn refill(h: WatcherHandle) ! io.Error {
    if is_closed(h.state) {
        fail NotConnected
    }
    let buf = io.buffer(read_size())
    let n = sys.read(h.fd, buf)?
    let events = decode(h, buf, n)
    enqueue(h.state, events)
    follow(h, events)?
}

/// Returns the next event, waiting for one when none is queued.
///
/// The green thread parks while it waits. Events come in the order the kernel reports them. A change to a path that is no longer watched is dropped, and `SelfDeleted` and `SelfMoved` are reported only for paths given to `add`. Fails with `NotConnected` once the watcher is stopped.
pub fn next(w: Watcher) -> Event ! io.Error {
    next_on(w.handle)?
}

/// Returns the next event through the handle `h`, as `next` does.
pub fn next_on(h: WatcherHandle) -> Event ! io.Error {
    using lease = sys.enter(h.descriptor)?
    for {
        let ready = dequeue(h.state)
        match ready {
            some(e) => return e
            none => refill(h)?
        }
    }
}

/// Returns a channel that receives the watcher's events.
///
/// A green thread forwards events into a channel with capacity 64. The channel closes when the watcher stops or reading fails. Competing with `next` or another channel for events splits them between the readers.
pub fn events(w: Watcher) -> chan[Event] {
    events_on(w.handle)
}

/// Returns a channel that receives the events of the watcher that `h` views, as `events` does.
pub fn events_on(h: WatcherHandle) -> chan[Event] {
    let out = chan[Event](64)
    spawn pump(h, out)
    out
}

fn pump(h: WatcherHandle, out: chan[Event]) {
    for {
        let e = next_on(h) or break
        let sent = select {
            out <- e => true
            <-h.state.done => false
        }
        if !sent {
            break
        }
    }
    close(out)
}
