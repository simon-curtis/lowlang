import std/file
import std/file/watch
import std/io
import std/text

fn report(root: str, w: watch.Watcher) ! io.Error {
    for {
        let e = watch.next(w)?
        let name = text.trim_prefix(text.trim_prefix(e.path, root), "/")
        print("{e.kind} {name}")
        if e.kind == watch.Kind.Deleted {
            break
        }
    }
}

/// Watches a source tree recursively while it is edited, and prints each event until the last file is deleted.
fn main() ! io.Error {
    let root = file.temp_dir("watch-")?
    file.mkdir("{root}/src")?
    using w = watch.watch_with([root], watch.Options { recursive: true })?

    file.write_text("{root}/src/main.low", "main\n")?
    file.rename("{root}/src/main.low", "{root}/src/app.low")?
    file.remove("{root}/src/app.low")?

    report(root, w)?
    watch.stop(w)
    file.remove_all(root)?
}
