import std/csv
import std/text

/// Totals units per region from a CSV export, then writes the totals as CSV and as tab separated text.
fn main() {
    let source = "region,item,units\nnorth,\"widget, large\",12\nsouth,gadget,7\nnorth,\"say \"\"hi\"\" card\",3\nsouth,widget,5\n"
    let records = csv.parse(source) catch {
        UnterminatedQuote(line) => {
            print("quote opened on line {line} is never closed")
            return
        }
        BareQuote(line) => {
            print("stray quote on line {line}")
            return
        }
    }

    var regions: []str = []
    var totals: [str: i64] = [:]
    for record in records[1..] {
        let region = record[0]
        let units = text.parse_int(record[2]) or 0
        if totals[region] == none {
            push(mut regions, region)
        }
        totals[region] = (totals[region] ?? 0) + units
    }

    var summary: [][]str = [["region", "units"]]
    for region in regions {
        push(mut summary, [region, "{totals[region] ?? 0}"])
    }
    print(text.trim_end(csv.format(summary)))

    let tabs = csv.format_with([["item", "note"], ["gadget", "left\tright"], ["widget", "a \"b\""]], '\t')
    print(text.trim_end(tabs))

    let broken = csv.parse("a,b\n\"open,c\n") catch {
        UnterminatedQuote(line) => {
            print("quote opened on line {line} is never closed")
            return
        }
        BareQuote(line) => {
            print("stray quote on line {line}")
            return
        }
    }
    print("{broken.len} records")
}
