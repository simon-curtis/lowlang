import std/base64
import std/crypto
import std/crypto/hash
import std/crypto/jose
import std/http
import std/io
import std/json
import std/text
import std/time
import std/uri

/// Returns a bearer middleware that accepts JWTs verified against `keys` under `options`.
///
/// The signature, `exp`, `nbf`, and the issuer and audience when `options` names them, are checked. The full payload becomes `Context.claims`. Any verification failure gets a `401` problem.
pub fn jwt(keys: []jose.Jwk, options: jose.Options) -> Middleware {
    bearer(fn(token: str) -> json.Value? {
        let claims = jose.verify(token, keys, options) catch {
            _ => return none
        }
        claims.extra
    })
}

struct Discovery {
    issuer: str
    authorization_endpoint: str = ""
    token_endpoint: str = ""
    jwks_uri: str
}

struct Provider {
    issuer: str
    fetcher: *http.Client
    lock: chan[bool]
    discovery: Discovery?
    keys: []jose.Jwk
    fetched: i64
    forced: i64
}

fn trimmed(issuer: str) -> str {
    if text.ends_with(issuer, "/") { issuer[..issuer.len - 1] } else { issuer }
}

fn discover(p: *Provider) -> Discovery ! io.Error {
    match p.discovery {
        some(d) => return d
        none => {}
    }
    let resp = retrieved(http.request(p.fetcher, "GET", "{trimmed(p.issuer)}/.well-known/openid-configuration"))?
    if resp.status != 200 {
        fail Refused
    }
    let d = json.deserialize[Discovery](resp.body) catch {
        _ => fail Malformed
    }
    if trimmed(d.issuer) != trimmed(p.issuer) {
        fail Invalid
    }
    p.discovery = d
    d
}

fn refresh(p: *Provider, force: bool) -> []jose.Jwk ! io.Error {
    p.lock <- true
    defer <-p.lock
    let now = time.now()
    let stale = now - p.fetched >= 3600
    let allowed = force && now - p.forced >= 60
    if p.keys.len > 0 && !stale && !allowed {
        return p.keys
    }
    if allowed {
        p.forced = now
    }
    let d = discover(p)?
    let resp = retrieved(http.request(p.fetcher, "GET", d.jwks_uri))?
    if resp.status != 200 {
        fail Refused
    }
    p.keys = jose.parse_jwks(resp.body)?
    p.fetched = now
    p.keys
}

fn retrieved(b: http.Builder[http.Response]) -> http.Response ! io.Error {
    http.send(b) catch {
        Timeout => fail TimedOut
        _ => fail Refused
    }
}

fn provider(issuer: str) -> *Provider {
    new(Provider { issuer, fetcher: http.build(http.client()), lock: chan[bool](1), discovery: none, keys: [], fetched: 0, forced: 0 })
}

fn token_options(p: *Provider, audience: str) -> jose.Options {
    jose.Options { algorithms: ["RS256", "RS384", "RS512", "PS256", "PS384", "PS512", "ES256", "ES384", "EdDSA"], issuer: p.issuer, audience }
}

fn token_kid(token: str) -> str {
    let dot = text.index_byte(token, '.')
    if dot <= 0 {
        return ""
    }
    let header = base64.decode_url(token[..dot]) catch {
        _ => return ""
    }
    let parsed = json.parse(header) catch {
        _ => return ""
    }
    match json.get(parsed, "kid") {
        some(v) => match v {
            Str(s) => s
            _ => ""
        }
        none => ""
    }
}

fn known(keys: []jose.Jwk, kid: str) -> bool {
    for k in keys {
        if k.kid == kid {
            return true
        }
    }
    false
}

fn verify_with(p: *Provider, token: str, audience: str) -> jose.Claims? {
    var keys = refresh(p, false) catch {
        _ => return none
    }
    let kid = token_kid(token)
    if kid.len > 0 && !known(keys, kid) {
        keys = refresh(p, true) catch {
            _ => return none
        }
    }
    let claims = jose.verify(token, keys, token_options(p, audience)) catch {
        _ => return none
    }
    claims
}

/// Returns a bearer middleware that accepts JWTs issued by the OpenID Connect provider at `issuer` for `audience`.
///
/// The signing keys come from the `jwks_uri` of the provider's discovery document. They are cached for an hour and refetched when a token names an unknown `kid`, at most once a minute. Only asymmetric signature algorithms are accepted. A token that fails verification, or a provider that cannot be reached, gets a `401` problem. The scheme is listed in the OpenAPI document as `openIdConnect`.
pub fn oidc(issuer: str, audience: str) -> Middleware {
    let p = provider(issuer)
    var m = bearer(fn(token: str) -> json.Value? {
        match verify_with(p, token, audience) {
            some(claims) => claims.extra
            none => none
        }
    })
    m.security = Security {
        name: "oidc"
        scheme: json.Value.Object([
            json.Member { name: "type", value: json.Value.Str("openIdConnect") }
            json.Member { name: "openIdConnectUrl", value: json.Value.Str("{trimmed(issuer)}/.well-known/openid-configuration") }
        ])
    }
    m
}

/// The registration of this application with an OpenID Connect provider, used by `oidc_login`.
pub struct OidcClient {
    /// The provider's issuer URL, from which the discovery document is fetched.
    pub issuer: str
    /// The identifier the provider issued to the application. It is also the audience the ID token must carry.
    pub client_id: str
    /// The client secret. Left empty for a public client, in which case none is sent.
    pub client_secret: str = ""
    /// The callback URL registered with the provider.
    pub redirect_uri: str
    /// The space-separated scopes to request. Defaults to `openid profile email`.
    pub scopes: str = "openid profile email"
}

struct TokenResponse {
    id_token: str = ""
    access_token: str = ""
}

fn exchange(p: *Provider, client: OidcClient, code: str, verifier: str) -> jose.Claims ! io.Error {
    let d = discover(p)?
    var form: []uri.Field = [
        uri.Field { name: "grant_type", value: "authorization_code" }
        uri.Field { name: "code", value: code }
        uri.Field { name: "redirect_uri", value: client.redirect_uri }
        uri.Field { name: "client_id", value: client.client_id }
        uri.Field { name: "code_verifier", value: verifier }
    ]
    if client.client_secret.len > 0 {
        push(mut form, uri.Field { name: "client_secret", value: client.client_secret })
    }
    let body = uri.encode_form(form)
    let resp = retrieved(http.with_body(http.request(p.fetcher, "POST", d.token_endpoint), bytes(body), "application/x-www-form-urlencoded"))?
    if resp.status != 200 {
        fail Refused
    }
    let tokens = json.deserialize[TokenResponse](resp.body) catch {
        _ => fail Malformed
    }
    match verify_with(p, tokens.id_token, client.client_id) {
        some(claims) => claims
        none => fail Invalid
    }
}

fn claim_text(claims: jose.Claims, name: str) -> str {
    match json.get(claims.extra, name) {
        some(v) => match v {
            Str(s) => s
            _ => ""
        }
        none => ""
    }
}

/// Registers the two routes of an authorization-code sign-in with PKCE on `a`.
///
/// `login` redirects with `302` to the provider's authorization endpoint with a fresh `state`, `nonce` and code challenge, which it keeps in the session, and answers `502` when the provider cannot be reached. `callback` checks `state`, exchanges the code, verifies the ID token and its `nonce`, clears the stored values, and returns the response of `signed_in` called with the verified claims. A bad `state` or missing `code` gets a `400` problem, and a failed exchange or `nonce` mismatch a `401` problem. The `sessions` middleware must wrap both routes.
pub fn oidc_login(a: *App, login: str, callback: str, client: OidcClient, signed_in: fn(*Context, jose.Claims) -> http.Response) {
    let p = provider(client.issuer)
    get(a, login, fn(c: *Context) -> http.Response {
        let d = discover(p) catch {
            _ => return problem_response(Status(502, "Bad Gateway", "identity provider unavailable"))
        }
        let state = base64.encode_url(crypto.random(16))
        let nonce = base64.encode_url(crypto.random(16))
        let verifier = base64.encode_url(crypto.random(32))
        session_set(c, "oidc_state", state)
        session_set(c, "oidc_nonce", nonce)
        session_set(c, "oidc_verifier", verifier)
        let challenge = base64.encode_url(hash.sum(hash.sha256(), bytes(verifier)))
        let params = uri.encode_form([
            uri.Field { name: "response_type", value: "code" }
            uri.Field { name: "client_id", value: client.client_id }
            uri.Field { name: "redirect_uri", value: client.redirect_uri }
            uri.Field { name: "scope", value: client.scopes }
            uri.Field { name: "state", value: state }
            uri.Field { name: "nonce", value: nonce }
            uri.Field { name: "code_challenge", value: challenge }
            uri.Field { name: "code_challenge_method", value: "S256" }
        ])
        let separator = if text.index_byte(d.authorization_endpoint, '?') >= 0 { "&" } else { "?" }
        redirect("{d.authorization_endpoint}{separator}{params}", 302)
    })
    get(a, callback, fn(c: *Context) -> http.Response {
        let expected = session_get(c, "oidc_state") ?? ""
        let state = query(c, "state") ?? ""
        let code = query(c, "code") ?? ""
        if expected.len == 0 || !hash.equal(bytes(expected), bytes(state)) || code.len == 0 {
            return problem_response(BadRequest("invalid sign-in response"))
        }
        let verifier = session_get(c, "oidc_verifier") ?? ""
        let claims = exchange(p, client, code, verifier) catch {
            _ => return problem_response(Unauthorized("sign-in failed"))
        }
        let nonce = session_get(c, "oidc_nonce") ?? ""
        if nonce.len == 0 || claim_text(claims, "nonce") != nonce {
            return problem_response(Unauthorized("sign-in nonce mismatch"))
        }
        session_set(c, "oidc_state", "")
        session_set(c, "oidc_nonce", "")
        session_set(c, "oidc_verifier", "")
        signed_in(c, claims)
    })
}
