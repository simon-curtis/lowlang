import std/header
import std/http
import std/json
import std/otel
import std/serde
import std/text
import std/uri

/// Describes how a middleware authenticates, for the generated OpenAPI document.
pub struct Security {
    /// The key of the scheme in `components.securitySchemes`, such as `bearer`.
    pub name: str
    /// The OpenAPI security scheme object as JSON.
    pub scheme: json.Value
}

/// A step that wraps a handler.
///
/// Middleware registered on an app applies to the routes registered after it, in registration order, with the first registered running outermost.
pub struct Middleware {
    /// Runs the step with the request context and `next`, which calls the rest of the chain and returns its response.
    ///
    /// A step that returns without calling `next` short-circuits the chain.
    pub run: fn(*Context, fn() -> http.Response) -> http.Response
    /// The scheme the step enforces, listed in the OpenAPI document for every route it wraps, or `none` for a step that does not authenticate.
    pub security: Security?
}

/// The state of one request, passed to middleware and handlers.
pub struct Context {
    /// The request as received.
    pub request: http.Request
    /// The path parameters of the matched route, keyed by name without the leading `:`. A trailing `*` segment is stored under `"*"`.
    ///
    /// Values are percent-decoded.
    pub params: [str: str]
    /// The authenticated principal, or an empty string until an authentication middleware sets it.
    pub user: str
    /// The verified token claims set by `bearer`, `jwt` and `oidc`, or `Null` when none were set.
    pub claims: json.Value
    /// Per-request storage that middleware and handlers use to pass strings to each other.
    pub values: [str: str]
    /// Headers added to the response after the handler returns, in the order they were set.
    ///
    /// They are appended, so a header the handler also set appears twice.
    pub response_headers: []header.Header
    /// The session loaded by the `sessions` middleware, or `none` when the request has not been through it.
    pub session: *Session?
}

/// Describes a route for the OpenAPI document.
///
/// Returned by `route` and its method helpers so a caller can fill it in.
pub struct Operation {
    /// A one-line summary of the operation. Omitted from the document when empty.
    pub summary: str = ""
    /// A longer description of the operation. Omitted from the document when empty.
    pub description: str = ""
    /// Tags that group the operation in the document.
    pub tags: []str = []
    /// The schema of the JSON request body, or `none` when the operation takes no body.
    pub request: serde.Schema?
    /// The schema of the JSON response body, or `none` when the operation does not describe one.
    pub response: serde.Schema?
    /// The status code of the success response in the document. Defaults to `200`.
    pub status: i64 = 200
}

struct Route {
    method: str
    pattern: str
    segments: []str
    handler: fn(*Context) -> http.Response
    middleware: []Middleware
    operation: *Operation
}

/// A router: routes, the middleware applied to them and a path prefix.
///
/// Made by `app`. `group` makes a child app that is joined back with `mount`.
pub struct App {
    routes: []*Route
    middleware: []Middleware
    prefix: str
}

/// Returns an empty app with no routes, no middleware and no prefix.
pub fn app() -> *App {
    new(App { routes: [], middleware: [], prefix: "" })
}

/// Adds a middleware to the app.
///
/// It applies only to routes registered after this call, so call it before registering the routes it should wrap.
pub fn use(a: *App, m: Middleware) {
    push(mut a.middleware, m)
}

fn split_path(path: str) -> []str {
    var out: []str = []
    for part in text.split(path, '/') {
        if part.len > 0 {
            push(mut out, part)
        }
    }
    out
}

/// Registers a handler for `method` and `path` and returns the route's `Operation`.
///
/// The app's prefix is prepended to `path`. A segment starting with `:` captures one path segment into `Context.params`, and a final `*` segment captures the rest of the path under `"*"`. Routes are tried in registration order, and the first whose path and method match handles the request. A `GET` route also answers `HEAD`.
pub fn route(a: *App, method: str, path: str, handler: fn(*Context) -> http.Response) -> *Operation {
    let full = "{a.prefix}{path}"
    let op = new(Operation { request: none, response: none })
    var middleware: []Middleware = []
    for m in a.middleware {
        push(mut middleware, m)
    }
    push(mut a.routes, new(Route { method, pattern: full, segments: split_path(full), handler, middleware, operation: op }))
    op
}

/// Registers a `GET` route. See `route`.
pub fn get(a: *App, path: str, handler: fn(*Context) -> http.Response) -> *Operation {
    route(a, "GET", path, handler)
}

/// Registers a `POST` route. See `route`.
pub fn post(a: *App, path: str, handler: fn(*Context) -> http.Response) -> *Operation {
    route(a, "POST", path, handler)
}

/// Registers a `PUT` route. See `route`.
pub fn put(a: *App, path: str, handler: fn(*Context) -> http.Response) -> *Operation {
    route(a, "PUT", path, handler)
}

/// Registers a `PATCH` route. See `route`.
pub fn patch(a: *App, path: str, handler: fn(*Context) -> http.Response) -> *Operation {
    route(a, "PATCH", path, handler)
}

/// Registers a `DELETE` route. See `route`.
pub fn del(a: *App, path: str, handler: fn(*Context) -> http.Response) -> *Operation {
    route(a, "DELETE", path, handler)
}

/// Returns a child app whose routes carry `prefix` appended to the parent's prefix and the parent's middleware followed by `middleware`.
///
/// The child keeps its own routes. They reach the parent only through `mount`, and routes registered on the child after `mount` are not included.
pub fn group(a: *App, prefix: str, middleware: []Middleware) -> *App {
    var combined: []Middleware = []
    for m in a.middleware {
        push(mut combined, m)
    }
    for m in middleware {
        push(mut combined, m)
    }
    new(App { routes: [], middleware: combined, prefix: "{a.prefix}{prefix}" })
}

/// Adds the routes of `child` to the app.
///
/// Only the routes registered on `child` at the time of the call are added.
pub fn mount(a: *App, child: *App) {
    for r in child.routes {
        push(mut a.routes, r)
    }
}

/// Sets the summary and tags of an operation.
pub fn describe(op: *Operation, summary: str, tags: []str) {
    op.summary = summary
    op.tags = tags
}

fn matches(r: *Route, segments: []str) -> [str: str]? {
    var params: [str: str] = [:]
    let wildcard = r.segments.len > 0 && r.segments[r.segments.len - 1] == "*"
    if wildcard && segments.len < r.segments.len - 1 || !wildcard && segments.len != r.segments.len {
        return none
    }
    for i, s in r.segments {
        if s == "*" {
            var rest: []str = []
            for part in segments[i..] {
                push(mut rest, uri.unescape_lossy(part))
            }
            params["*"] = text.join(rest, "/")
            return params
        }
        if s.len > 0 && s[0] == ':' {
            params[s[1..]] = uri.unescape_lossy(segments[i])
        } else if s != segments[i] {
            return none
        }
    }
    params
}

fn chain(c: *Context, middleware: []Middleware, at: i64, handler: fn(*Context) -> http.Response) -> http.Response {
    if at == middleware.len {
        return handler(c)
    }
    middleware[at].run(c, fn() -> http.Response { chain(c, middleware, at + 1, handler) })
}

struct Dispatched {
    response: http.Response
    route: str
}

fn dispatch(a: *App, req: http.Request) -> Dispatched {
    let segments = split_path(req.path)
    var allowed: []str = []
    for r in a.routes {
        let params = match matches(r, segments) {
            some(p) => p
            none => continue
        }
        if r.method != req.method && !(req.method == "HEAD" && r.method == "GET") {
            push(mut allowed, r.method)
            continue
        }
        let c = new(Context { request: req, params, user: "", claims: json.Value.Null, values: [:], response_headers: [], session: none })
        var resp = chain(c, r.middleware, 0, r.handler)
        for h in c.response_headers {
            header.add(mut resp.headers, h.name, h.value)
        }
        return Dispatched { response: resp, route: r.pattern }
    }
    if allowed.len > 0 {
        var resp = problem_response(Status(405, "Method Not Allowed", ""))
        header.set(mut resp.headers, "allow", text.join(allowed, ", "))
        return Dispatched { response: resp, route: "" }
    }
    Dispatched { response: problem_response(NotFound), route: "" }
}

fn served(a: *App, req: http.Request) -> http.Response {
    let call = otel.server_span("std/web", req)
    let d = dispatch(a, req)
    call.end_server(d.route, d.response.status)
    d.response
}

/// Returns the app as a request handler for `http.serve`.
///
/// A request whose path matches a route of another method gets a `405` problem with an `allow` header, and a request that matches no route gets a `404` problem. Each request is recorded as a server span named after the matched route pattern.
pub fn handler(a: *App) -> fn(http.Request) -> http.Response {
    fn(req) { served(a, req) }
}

/// Returns the path parameter `name`, or an empty string when the route has no such parameter.
pub fn param(c: *Context, name: str) -> str {
    c.params[name] ?? ""
}

/// Returns the path parameter `name` as an integer.
///
/// Fails with `BadRequest` when it is empty or not an integer.
pub fn param_int(c: *Context, name: str) -> i64 ! Problem {
    text.parse_int(param(c, name)) catch {
        _ => fail BadRequest("path parameter {name} must be an integer")
    }
}

/// Returns the value of the first request header called `name`, or `none` when it is absent.
///
/// The name is matched without regard to case.
pub fn header(c: *Context, name: str) -> str? {
    header.get(c.request.headers, name)
}

/// Adds a header to the response.
///
/// The header is added after the handler returns and does not replace a header of the same name.
pub fn set_header(c: *Context, name: str, value: str) {
    push(mut c.response_headers, header.Header { name, value })
}

/// Returns the query parameter `name`, or `none` when the request has no such parameter.
///
/// The query string is parsed on each call.
pub fn query(c: *Context, name: str) -> str? {
    let params = uri.parse_query(c.request.query)
    params[name]
}
