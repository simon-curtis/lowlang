import std/header
import std/http
import std/json
import std/serde
import std/text

/// The `info` object of the OpenAPI document.
pub struct Info {
    /// The title of the API.
    pub title: str
    /// The version of the API, not of the OpenAPI specification.
    pub version: str
    /// A description of the API. Omitted from the document when empty.
    pub description: str = ""
}

struct Components {
    names: []str
    schemas: [str: json.Value]
}

fn component_name(name: str) -> str {
    var out: []u8 = []
    for i in 0..name.len {
        let c = name[i]
        if c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9' || c == '_' || c == '.' || c == '-' {
            push(mut out, c)
        } else {
            push(mut out, '_')
        }
    }
    __str_view(out)
}

fn present(m: [str: json.Value], key: str) -> bool {
    match m[key] {
        some(_) => true
        none => false
    }
}

fn reference(name: str) -> json.Value {
    json.object_value([json.text_member("$ref", "#/components/schemas/{component_name(name)}")])
}

fn properties(c: *Components, fields: []serde.Property) -> json.Value {
    var props: []json.Member = []
    var required: []json.Value = []
    for f in fields {
        push(mut props, json.member(f.name, schema_json(c, f.schema)))
        if f.required {
            push(mut required, json.text_value(f.name))
        }
    }
    var out: []json.Member = [json.text_member("type", "object"), json.object_member("properties", props)]
    if required.len > 0 {
        push(mut out, json.array_member("required", required))
    }
    json.object_value(out)
}

fn variant_schema(c: *Components, v: serde.Variant) -> json.Value {
    if v.fields.len == 0 {
        return json.object_value([json.text_member("const", v.name)])
    }
    var payload = properties(c, v.fields)
    if !v.labelled {
        var items: []json.Value = []
        for f in v.fields {
            push(mut items, schema_json(c, f.schema))
        }
        payload = json.object_value([json.text_member("type", "array"), json.array_member("prefixItems", items), json.bool_member("items", false)])
    }
    json.object_value([
        json.text_member("type", "object")
        json.object_member("properties", [json.member(v.name, payload)])
        json.array_member("required", [json.text_value(v.name)])
        json.bool_member("additionalProperties", false)
    ])
}

fn named(c: *Components, s: serde.Schema, build: fn() -> json.Value) -> json.Value {
    let key = component_name(s.name)
    if !present(c.schemas, key) {
        c.schemas[key] = json.Value.Null
        push(mut c.names, key)
        c.schemas[key] = build()
    }
    reference(s.name)
}

fn schema_json(c: *Components, s: serde.Schema) -> json.Value {
    match s.kind {
        Bool => json.object_value([json.text_member("type", "boolean")])
        Int => json.object_value([json.text_member("type", "integer"), json.text_member("format", if s.bits > 32 { "int64" } else { "int32" })])
        Uint => json.object_value([json.text_member("type", "integer"), json.int_member("minimum", 0)])
        Float => json.object_value([json.text_member("type", "number"), json.text_member("format", if s.bits == 32 { "float" } else { "double" })])
        Text => json.object_value([json.text_member("type", "string")])
        Binary => json.object_value([json.text_member("type", "string"), json.text_member("contentEncoding", "base64")])
        Seq => json.object_value([json.text_member("type", "array"), json.member("items", schema_json(c, s.items[0]))])
        Map => json.object_value([json.text_member("type", "object"), json.member("additionalProperties", schema_json(c, s.items[1]))])
        Optional => json.object_value([json.array_member("oneOf", [schema_json(c, s.items[0]), json.object_value([json.text_member("type", "null")])])])
        Struct => named(c, s, fn() -> json.Value { properties(c, s.fields) })
        Enum => named(c, s, fn() -> json.Value {
            var all_units = true
            for v in s.variants {
                if v.fields.len > 0 {
                    all_units = false
                }
            }
            if all_units {
                var names: []json.Value = []
                for v in s.variants {
                    push(mut names, json.text_value(v.name))
                }
                return json.object_value([json.text_member("type", "string"), json.array_member("enum", names)])
            }
            var options: []json.Value = []
            for v in s.variants {
                push(mut options, variant_schema(c, v))
            }
            json.object_value([json.array_member("oneOf", options)])
        })
        Ref => reference(s.name)
    }
}

fn path_template(segments: []Segment) -> str {
    var parts: []str = []
    for seg in segments {
        match seg {
            Literal(value) => push(mut parts, value)
            Param(name) => push(mut parts, "{{{name}}}")
            Rest => push(mut parts, "*")
        }
    }
    "/{text.join(parts, "/")}"
}

fn operation_json(c: *Components, r: *Route, schemes: []str) -> json.Value {
    let op = r.operation
    var members: []json.Member = []
    if op.summary.len > 0 {
        push(mut members, json.text_member("summary", op.summary))
    }
    if op.description.len > 0 {
        push(mut members, json.text_member("description", op.description))
    }
    if op.tags.len > 0 {
        var tags: []json.Value = []
        for t in op.tags {
            push(mut tags, json.text_value(t))
        }
        push(mut members, json.array_member("tags", tags))
    }
    var params: []json.Value = []
    for seg in r.segments {
        match seg {
            Param(name) => push(mut params, json.object_value([
                json.text_member("name", name)
                json.text_member("in", "path")
                json.bool_member("required", true)
                json.object_member("schema", [json.text_member("type", "string")])
            ]))
            _ => {}
        }
    }
    if params.len > 0 {
        push(mut members, json.array_member("parameters", params))
    }
    match op.request {
        some(s) => push(mut members, json.object_member("requestBody", [
            json.bool_member("required", true)
            json.object_member("content", [json.object_member("application/json", [json.member("schema", schema_json(c, s))])])
        ]))
        none => {}
    }
    var responses: []json.Member = []
    match op.response {
        some(s) => push(mut responses, json.object_member("{op.status}", [
            json.text_member("description", http.status_text(op.status))
            json.object_member("content", [json.object_member("application/json", [json.member("schema", schema_json(c, s))])])
        ]))
        none => push(mut responses, json.object_member("200", [json.text_member("description", "OK")]))
    }
    push(mut responses, json.object_member("default", [
        json.text_member("description", "Problem details")
        json.object_member("content", [json.object_member("application/problem+json", [json.member("schema", reference("Problem"))])])
    ]))
    push(mut members, json.object_member("responses", responses))
    if schemes.len > 0 {
        var alternatives: []json.Value = []
        for name in schemes {
            push(mut alternatives, json.object_value([json.array_member(name, [])]))
        }
        push(mut members, json.array_member("security", alternatives))
    }
    json.object_value(members)
}

/// Returns an OpenAPI 3.1 document for the routes of the app.
///
/// A `:name` segment becomes `{name}` with a path parameter. Operations list their summary, description, tags, request body and response from their `Operation`, a `default` response of the `Problem` schema, and the security schemes of their middleware. Struct and enum schemas are shared in `components.schemas`.
pub fn openapi_document(a: *App, info: Info) -> json.Value {
    let c = new(Components { names: [], schemas: [:] })
    c.schemas["Problem"] = properties(c, [
        serde.Property { name: "type", schema: serde.Schema { kind: Text }, required: true }
        serde.Property { name: "title", schema: serde.Schema { kind: Text }, required: true }
        serde.Property { name: "status", schema: serde.Schema { kind: Int, bits: 64 }, required: true }
        serde.Property { name: "detail", schema: serde.Schema { kind: Text }, required: false }
    ])
    push(mut c.names, "Problem")
    var paths: []str = []
    var path_items: [str: []json.Member] = [:]
    var security: [str: json.Value] = [:]
    var security_names: []str = []
    for r in a.routes {
        var schemes: []str = []
        for m in r.middleware {
            match m.security {
                some(sec) => {
                    push(mut schemes, sec.name)
                    if !present(security, sec.name) {
                        push(mut security_names, sec.name)
                    }
                    security[sec.name] = sec.scheme
                }
                none => {}
            }
        }
        let template = path_template(r.segments)
        var ops = match path_items[template] {
            some(existing) => existing
            none => {
                push(mut paths, template)
                let fresh: []json.Member = []
                fresh
            }
        }
        push(mut ops, json.member(text.lower(r.method), operation_json(c, r, schemes)))
        path_items[template] = ops
    }
    var path_members: []json.Member = []
    for p in paths {
        push(mut path_members, json.object_member(p, path_items[p] ?? []))
    }
    var component_members: []json.Member = []
    for n in c.names {
        push(mut component_members, json.member(n, c.schemas[n] ?? json.Value.Null))
    }
    var components: []json.Member = [json.object_member("schemas", component_members)]
    if security_names.len > 0 {
        var schemes: []json.Member = []
        for n in security_names {
            push(mut schemes, json.member(n, security[n] ?? json.Value.Null))
        }
        push(mut components, json.object_member("securitySchemes", schemes))
    }
    var info_members: []json.Member = [json.text_member("title", info.title), json.text_member("version", info.version)]
    if info.description.len > 0 {
        push(mut info_members, json.text_member("description", info.description))
    }
    json.object_value([
        json.text_member("openapi", "3.1.0")
        json.object_member("info", info_members)
        json.object_member("paths", path_members)
        json.object_member("components", components)
    ])
}

/// Registers a `GET` route at `path` that serves the document of `openapi_document` as JSON.
///
/// The document is built on each request, so it reflects the routes registered at that time.
pub fn openapi(a: *App, path: str, info: Info) {
    get(a, path, fn(c: *Context) -> http.Response {
        var resp = http.response(200, json.stringify(openapi_document(a, info), 2))
        header.set(mut resp.headers, "content-type", "application/json")
        resp
    })
}
