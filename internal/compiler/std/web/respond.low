import std/http
import std/json

/// An error that a handler returns to the client as an RFC 9457 problem response.
///
/// Each variant maps to a status code, and `problem_response` renders it. Handlers declared `! Problem` can fail with any variant.
pub enum Problem {
    /// The request is malformed. Status `400`; `detail` explains what is wrong.
    BadRequest(detail: str)
    /// Credentials are missing or invalid. Status `401`; `detail` explains why.
    Unauthorized(detail: str)
    /// The caller is not allowed to do this. Status `403`; `detail` explains why.
    Forbidden(detail: str)
    /// The resource does not exist. Status `404`.
    NotFound
    /// The request conflicts with the current state of the resource. Status `409`; `detail` explains the conflict.
    Conflict(detail: str)
    /// The request is well-formed but its content is not acceptable. Status `422`; `detail` explains why.
    Unprocessable(detail: str)
    /// The caller has sent too many requests. Status `429`.
    TooMany
    /// The server failed. Status `500`; `detail` is sent to the client, so it must not hold secrets.
    Internal(detail: str)
    /// A problem with any status `code` and `title`, for statuses the other variants do not cover.
    Status(code: i64, title: str, detail: str)
}

struct ProblemBody {
    type: str
    title: str
    status: i64
    detail: str
}

fn problem_status(p: Problem) -> i64 {
    match p {
        BadRequest(_) => 400
        Unauthorized(_) => 401
        Forbidden(_) => 403
        NotFound => 404
        Conflict(_) => 409
        Unprocessable(_) => 422
        TooMany => 429
        Internal(_) => 500
        Status(code, _, _) => code
    }
}

fn problem_detail(p: Problem) -> str {
    match p {
        BadRequest(d) => d
        Unauthorized(d) => d
        Forbidden(d) => d
        Conflict(d) => d
        Unprocessable(d) => d
        Internal(d) => d
        Status(_, _, d) => d
        _ => ""
    }
}

/// Returns the `application/problem+json` response for a problem.
///
/// The body holds `type` set to `about:blank`, `title`, `status` and `detail`. The title is the standard text of the status, or the title of a `Status` problem. A `401` response also carries `www-authenticate: Bearer`.
pub fn problem_response(p: Problem) -> http.Response {
    let status = problem_status(p)
    let title = match p {
        Status(_, t, _) => t
        _ => http.status_text(status)
    }
    let body = ProblemBody { type: "about:blank", title, status, detail: problem_detail(p) }
    var resp = http.Response { status, headers: [], body: bytes(json.serialize(body)) }
    http.set_header(mut resp.headers, "content-type", "application/problem+json")
    if status == 401 {
        http.set_header(mut resp.headers, "www-authenticate", "Bearer")
    }
    resp
}

/// Returns a response with `status` whose body is `v` serialised as JSON and whose `content-type` is `application/json`.
pub fn json_response[T](status: i64, v: T) -> http.Response {
    var resp = http.Response { status, headers: [], body: bytes(json.serialize(v)) }
    http.set_header(mut resp.headers, "content-type", "application/json")
    resp
}

/// Returns a response with `status` and `body` as `text/plain; charset=utf-8`.
pub fn text(status: i64, body: str) -> http.Response {
    var resp = http.response(status, body)
    http.set_header(mut resp.headers, "content-type", "text/plain; charset=utf-8")
    resp
}

/// Returns a response with `status` and `body` as `text/html; charset=utf-8`.
pub fn html(status: i64, body: str) -> http.Response {
    var resp = http.response(status, body)
    http.set_header(mut resp.headers, "content-type", "text/html; charset=utf-8")
    resp
}

/// Returns an empty response with `status`, such as `302` or `303`, and a `location` header of `location`.
pub fn redirect(location: str, status: i64) -> http.Response {
    var resp = http.response(status, "")
    http.set_header(mut resp.headers, "location", location)
    resp
}

/// Returns an empty `204` response.
pub fn no_content() -> http.Response {
    http.response(204, "")
}

/// Decodes the request body as JSON into `T`.
///
/// Fails with `BadRequest` for a syntax error or nesting that is too deep, and with `Unprocessable` for a value of the wrong type, a missing field, an unknown variant or a number out of range. The detail names the position or field.
pub fn body_json[T](c: *Context) -> T ! Problem {
    json.deserialize[T](c.request.body) catch {
        Syntax(at, message) => fail BadRequest("invalid JSON at {at}: {message}")
        Mismatch(expected, at) => fail Unprocessable("expected {expected} at {at}")
        Missing(field) => fail Unprocessable("missing field {field}")
        UnknownVariant(name) => fail Unprocessable("unknown variant {name}")
        Range(at) => fail Unprocessable("number out of range at {at}")
        TooDeep => fail BadRequest("JSON nested too deeply")
    }
}
