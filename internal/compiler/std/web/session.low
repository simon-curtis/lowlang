import std/base64
import std/crypto
import std/crypto/aead
import std/crypto/hash
import std/http
import std/io
import std/json
import std/text
import std/time

/// The key-value state of one visitor, kept in an encrypted cookie by `sessions`.
pub struct Session {
    /// The stored values. Writing to the map directly does not mark the session as changed, so use `session_set` and `session_clear` to change it.
    pub values: [str: str]
    changed: bool
    cleared: bool
}

/// Configures the `sessions` middleware.
pub struct SessionOptions {
    /// The AES-256-GCM key that seals the cookie. It must be exactly 32 bytes.
    pub key: []u8
    /// The name of the cookie. Defaults to `session`.
    pub cookie: str = "session"
    /// The lifetime in seconds, counted from the last write. Defaults to one day.
    pub max_age: i64 = 86400
    /// Whether the cookie is marked `Secure`. Defaults to `true`.
    pub secure: bool = true
    /// The `SameSite` attribute of the cookie. Defaults to `Lax`; `Unset` omits it.
    pub same_site: http.SameSite = http.SameSite.Lax
    /// The `Path` attribute of the cookie. Defaults to `/`.
    pub path: str = "/"
}

struct Stored {
    expires: i64
    values: [str: str]
}

/// Returns the cookies of the request as a map of names to values.
///
/// See `http.request_cookies`.
pub fn cookies(c: *Context) -> [str: str] {
    http.request_cookies(c.request.headers)
}

/// Adds a `set-cookie` header for `cookie` to the response.
///
/// It does not replace an earlier cookie of the same name. See `http.format_set_cookie` for how the cookie is written.
pub fn set_cookie(c: *Context, cookie: http.Cookie) {
    set_header(c, "set-cookie", http.format_set_cookie(cookie))
}

fn open_session(cipher: aead.Aead, name: str, raw: str) -> [str: str]? {
    let data = base64.decode_url(raw) or return none
    if data.len < 12 + 16 {
        return none
    }
    let plain = cipher.open(data[..12], data[12..], bytes(name)) or return none
    let stored = json.deserialize[Stored](plain) or return none
    if stored.expires < time.now() {
        return none
    }
    stored.values
}

fn seal_session(cipher: aead.Aead, name: str, values: [str: str], max_age: i64) -> str {
    let nonce = crypto.random(12)
    let plain = bytes(json.serialize(Stored { expires: time.now() + max_age, values }))
    var out: []u8 = []
    io.append(mut out, nonce)
    io.append(mut out, cipher.seal(nonce, plain, bytes(name)))
    base64.encode_url(out)
}

/// Returns a middleware that keeps a `Session` for each visitor in an encrypted cookie.
///
/// Fails with `Invalid` when `o.key` is not 32 bytes. The cookie holds the values and an expiry, sealed with AES-256-GCM and bound to the cookie name. A cookie that is missing, altered or expired gives an empty session. A cookie is sent only when the request changed the session, which restarts its lifetime, or cleared it, which deletes the cookie. A session that is cleared stays cleared even if values are set afterwards. The scheme is listed in the OpenAPI document as an `apiKey` in a cookie.
pub fn sessions(o: SessionOptions) -> Middleware ! io.Error {
    if o.key.len != 32 {
        fail Invalid
    }
    let cipher = aead.aes_gcm(o.key)?
    Middleware {
        run: fn(c: *Context, next: fn() -> http.Response) -> http.Response {
            var values: [str: str] = [:]
            match cookies(c)[o.cookie] {
                some(raw) => {
                    match open_session(cipher, o.cookie, raw) {
                        some(v) => {
                            values = v
                        }
                        none => {}
                    }
                }
                none => {}
            }
            let s = new(Session { values, changed: false, cleared: false })
            c.session = s
            let resp = next()
            if s.cleared {
                set_cookie(c, http.Cookie { name: o.cookie, value: "", path: o.path, max_age: 0, secure: o.secure, same_site: o.same_site })
            } else if s.changed {
                let sealed = seal_session(cipher, o.cookie, s.values, o.max_age)
                set_cookie(c, http.Cookie { name: o.cookie, value: sealed, path: o.path, max_age: o.max_age, secure: o.secure, same_site: o.same_site })
            }
            resp
        }
        security: Security {
            name: "session"
            scheme: json.object_value([
                json.text_member("type", "apiKey")
                json.text_member("in", "cookie")
                json.text_member("name", o.cookie)
            ])
        }
    }
}

fn current(c: *Context) -> *Session {
    match c.session {
        some(s) => s
        none => {
            let s = new(Session { values: [:], changed: false, cleared: false })
            c.session = s
            s
        }
    }
}

/// Returns the session value for `key`, or `none` when it is not set.
///
/// Without the `sessions` middleware the session is empty and lasts only for the request.
pub fn session_get(c: *Context, key: str) -> str? {
    current(c).values[key]
}

/// Sets the session value for `key`, so that the cookie is rewritten.
///
/// Without the `sessions` middleware the value is lost when the request ends.
pub fn session_set(c: *Context, key: str, value: str) {
    let s = current(c)
    s.values[key] = value
    s.changed = true
}

/// Removes every value from the session and deletes the cookie.
pub fn session_clear(c: *Context) {
    let s = current(c)
    s.values = [:]
    s.cleared = true
}

/// Returns the CSRF token of the session, creating and storing a random 64-character hex token if there is none.
///
/// Send it to the client for the `x-csrf-token` header that `csrf` checks.
pub fn csrf_token(c: *Context) -> str {
    match session_get(c, "csrf") {
        some(t) => t
        none => {
            let t = text.encode_hex(crypto.random(32))
            session_set(c, "csrf", t)
            t
        }
    }
}

fn unsafe_method(m: str) -> bool {
    m != "GET" && m != "HEAD" && m != "OPTIONS"
}

/// Returns a middleware that rejects unsafe requests without the session's CSRF token.
///
/// Requests other than `GET`, `HEAD` and `OPTIONS` must carry an `x-csrf-token` header equal to the session's token, compared in constant time. Otherwise the response is a `403` problem. It must run after `sessions`.
pub fn csrf() -> Middleware {
    Middleware {
        run: fn(c: *Context, next: fn() -> http.Response) -> http.Response {
            if unsafe_method(c.request.method) {
                let expected = session_get(c, "csrf") ?? ""
                let given = header(c, "x-csrf-token") ?? ""
                if expected.len == 0 || !hash.equal(bytes(expected), bytes(given)) {
                    return problem_response(Forbidden("missing or invalid CSRF token"))
                }
            }
            next()
        }
        security: none
    }
}

/// Returns a middleware that requires the session value `key` to be set.
///
/// The value is stored in `Context.user`. Otherwise the response is a `401` problem.
pub fn require_session(key: str) -> Middleware {
    Middleware {
        run: fn(c: *Context, next: fn() -> http.Response) -> http.Response {
            match session_get(c, key) {
                some(user) => {
                    c.user = user
                    next()
                }
                none => problem_response(Unauthorized("sign in required"))
            }
        }
        security: none
    }
}
