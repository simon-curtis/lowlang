import std/http
import std/io
import std/net
import std/web

fn site() -> *web.App ! io.Error {
    var key: []u8 = []
    for i in 0..32 {
        push(mut key, u8(i * 7))
    }
    let app = web.app()
    let pages = web.group(app, "/site", [web.sessions(web.SessionOptions { key, secure: false })?, web.csrf()])
    web.get(pages, "/token", fn(c) { web.text(200, web.csrf_token(c)) })
    web.post(pages, "/login", fn(c) {
        web.session_set(c, "user", "ada")
        web.text(200, "signed in")
    })
    let members = web.group(pages, "/members", [web.require_session("user")])
    web.get(members, "/me", fn(c) { web.text(200, "member {c.user}") })
    web.post(members, "/logout", fn(c) {
        web.session_clear(c)
        web.no_content()
    })
    app
}

fn show(label: str, resp: http.Response) {
    print("{label}: {resp.status} {http.text(resp)}")
}

/// Signs in through a session cookie and a CSRF token against an app on a loopback port.
fn main() ! io.Error {
    using l = net.listen("127.0.0.1", 0)?
    let listening = l.handle
    let handler = web.handler(site()?)
    spawn fn() { http.serve_on(listening, handler) or {} }()

    let browser = http.client().with_base_url("http://127.0.0.1:{l.handle.addr.port}").with_cookies().with_timeout(5000).build()
    show("anonymous", browser.get("/site/members/me") or return)
    show("login without token", browser.post("/site/login", "text/plain", []) or return)

    let token = http.text(browser.get("/site/token") or return)
    print("token length {token.len}")
    let login = browser.request("POST", "/site/login").with_header("x-csrf-token", token)
    show("login", login.send() or return)
    show("member", browser.get("/site/members/me") or return)

    let logout = browser.request("POST", "/site/members/logout").with_header("x-csrf-token", token)
    show("logout", logout.send() or return)
    show("after logout", browser.get("/site/members/me") or return)
    net.close_listener(l)
}
