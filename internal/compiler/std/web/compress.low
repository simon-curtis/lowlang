import std/header
import std/http
import std/text

fn compressible(content_type: str) -> bool {
    let t = text.lower(content_type)
    if text.starts_with(t, "text/event-stream") {
        return false
    }
    text.starts_with(t, "text/") || text.index(t, "json") >= 0 || text.index(t, "xml") >= 0 || text.index(t, "javascript") >= 0 || text.index(t, "svg") >= 0
}

/// Returns a middleware that compresses response bodies.
///
/// The coding is the first of `zstd`, `br` and `gzip` that the `accept-encoding` header accepts with a non-zero quality. A response is compressed only when its body has at least `minimum` bytes, is not streamed, has no `content-encoding`, and has a `content-type` that is `text/*` other than an event stream, or contains `json`, `xml`, `javascript` or `svg`. `level` is passed to the compressor. The response gets `content-encoding` and `vary: Accept-Encoding`, replacing any `vary` it had, and loses its `content-length`.
pub fn compress(minimum: i64, level: i64) -> Middleware {
    Middleware {
        run: fn(c: *Context, next: fn() -> http.Response) -> http.Response {
            let resp = next()
            let accepted = header(c, "accept-encoding") ?? ""
            let content_type = header.get(resp.headers, "content-type") ?? ""
            let coding = http.negotiate_coding(accepted)
            if http.streaming(resp) || resp.body.len < minimum || header.has(resp.headers, "content-encoding") || !compressible(content_type) || coding.len == 0 {
                return resp
            }
            let encoded = match http.encode_body(coding, resp.body, level) {
                some(body) => body
                none => return resp
            }
            var out = resp
            out.body = encoded
            header.set(mut out.headers, "content-encoding", coding)
            header.set(mut out.headers, "vary", "Accept-Encoding")
            out.headers = header.remove(out.headers, "content-length")
            out
        }
        security: none
    }
}
