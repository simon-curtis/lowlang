import std/compress/brotli
import std/compress/deflate
import std/compress/zstd
import std/http
import std/text

fn compressible(content_type: str) -> bool {
    let t = text.lower(content_type)
    text.starts_with(t, "text/") || text.index(t, "json") >= 0 || text.index(t, "xml") >= 0 || text.index(t, "javascript") >= 0 || text.index(t, "svg") >= 0
}

fn accepts(header_value: str, coding: str) -> bool {
    for part in text.split(header_value, ',') {
        let item = text.trim(part)
        let semi = text.index_byte(item, ';')
        let name = text.trim(if semi >= 0 { item[..semi] } else { item })
        if !text.equal_fold(name, coding) {
            continue
        }
        if semi < 0 {
            return true
        }
        let q = text.trim(item[semi + 1..])
        return !(q == "q=0" || q == "q=0.0" || q == "q=0.00" || q == "q=0.000")
    }
    false
}

fn chosen(accepted: str) -> str {
    for coding in ["zstd", "br", "gzip"] {
        if accepts(accepted, coding) {
            return coding
        }
    }
    ""
}

fn encoded(coding: str, body: []u8, level: i64) -> []u8 {
    if coding == "zstd" {
        zstd.compress(body, level)
    } else if coding == "br" {
        brotli.compress(body, level)
    } else {
        deflate.gzip_compress(body, level)
    }
}

pub fn compress(minimum: i64, level: i64) -> Middleware {
    Middleware {
        run: fn(c: *Context, next: fn() -> http.Response) -> http.Response {
            let resp = next()
            let accepted = header(c, "accept-encoding") ?? ""
            let content_type = http.header(resp.headers, "content-type") ?? ""
            let coding = chosen(accepted)
            if resp.body.len < minimum || http.has_header(resp.headers, "content-encoding") || !compressible(content_type) || coding.len == 0 {
                return resp
            }
            var out = resp
            out.body = encoded(coding, resp.body, level)
            http.set_header(mut out.headers, "content-encoding", coding)
            http.set_header(mut out.headers, "vary", "Accept-Encoding")
            var kept: []http.Header = []
            for h in out.headers {
                if !text.equal_fold(h.name, "content-length") {
                    push(mut kept, h)
                }
            }
            out.headers = kept
            out
        }
        security: none
    }
}
