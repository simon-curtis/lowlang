import std/base64
import std/header
import std/http
import std/json
import std/text

/// Returns a middleware that authenticates requests by the API key in the `header_name` header.
///
/// `check` maps a key to the principal it belongs to, or `none` to reject it. A principal is stored in `Context.user`. A missing, empty or rejected key gets a `401` problem. The scheme is listed in the OpenAPI document as an `apiKey` in a header.
pub fn api_key(header_name: str, check: fn(str) -> str?) -> Middleware {
    Middleware {
        run: fn(c: *Context, next: fn() -> http.Response) -> http.Response {
            let given = header(c, header_name) ?? ""
            if given.len == 0 {
                return problem_response(Unauthorized("missing API key"))
            }
            match check(given) {
                some(principal) => {
                    c.user = principal
                    next()
                }
                none => problem_response(Unauthorized("invalid API key"))
            }
        }
        security: Security {
            name: "apiKey"
            scheme: json.object_value([json.text_member("type", "apiKey"), json.text_member("in", "header"), json.text_member("name", header_name)])
        }
    }
}

fn scheme_credentials(c: *Context, scheme: str) -> str? {
    let auth = header(c, "authorization") ?? ""
    if auth.len > scheme.len && text.equal_fold(auth[..scheme.len], scheme) && auth[scheme.len] == ' ' {
        return text.trim(auth[scheme.len + 1..])
    }
    none
}

fn basic_challenge(realm: str) -> http.Response {
    var resp = problem_response(Unauthorized("credentials required"))
    header.set(mut resp.headers, "www-authenticate", "Basic realm=\"{realm}\", charset=\"UTF-8\"")
    resp
}

/// Returns a middleware that authenticates requests with HTTP Basic credentials.
///
/// `check` receives the user name and password and returns the principal, which is stored in `Context.user`, or `none` to reject them. The user name ends at the first colon of the decoded credentials. Missing, malformed or rejected credentials get a `401` problem with a `www-authenticate: Basic` challenge for `realm`.
pub fn basic(realm: str, check: fn(str, str) -> str?) -> Middleware {
    Middleware {
        run: fn(c: *Context, next: fn() -> http.Response) -> http.Response {
            let credentials = match scheme_credentials(c, "Basic") {
                some(given) => given
                none => return basic_challenge(realm)
            }
            let decoded = base64.decode(credentials) catch {
                _ => return basic_challenge(realm)
            }
            let pair = str(decoded)
            let colon = text.index_byte(pair, ':')
            if colon < 0 {
                return basic_challenge(realm)
            }
            match check(pair[..colon], pair[colon + 1..]) {
                some(principal) => {
                    c.user = principal
                    next()
                }
                none => basic_challenge(realm)
            }
        }
        security: Security { name: "basic", scheme: json.object_value([json.text_member("type", "http"), json.text_member("scheme", "basic")]) }
    }
}

/// Returns a middleware that authenticates requests with a bearer token from the `authorization` header.
///
/// `check` returns the token's claims, or `none` to reject it. Accepted claims are stored in `Context.claims`, and a string `sub` claim is stored in `Context.user`. A missing or rejected token gets a `401` problem. The scheme is listed in the OpenAPI document as HTTP bearer with the `JWT` format.
pub fn bearer(check: fn(str) -> json.Value?) -> Middleware {
    Middleware {
        run: fn(c: *Context, next: fn() -> http.Response) -> http.Response {
            let token = match scheme_credentials(c, "Bearer") {
                some(given) => given
                none => return problem_response(Unauthorized("bearer token required"))
            }
            match check(token) {
                some(claims) => {
                    c.claims = claims
                    match json.get(claims, "sub") {
                        some(sub) => {
                            match sub {
                                Str(s) => {
                                    c.user = s
                                }
                                _ => {}
                            }
                        }
                        none => {}
                    }
                    next()
                }
                none => problem_response(Unauthorized("invalid bearer token"))
            }
        }
        security: Security { name: "bearer", scheme: json.object_value([json.text_member("type", "http"), json.text_member("scheme", "bearer"), json.text_member("bearerFormat", "JWT")]) }
    }
}

/// Returns a middleware that prints `METHOD path status` to standard output after each request.
pub fn logger() -> Middleware {
    Middleware {
        run: fn(c: *Context, next: fn() -> http.Response) -> http.Response {
            let resp = next()
            print("{c.request.method} {c.request.path} {resp.status}")
            resp
        }
        security: none
    }
}

/// Returns a middleware that allows cross-origin requests from `origin` with the request headers `allow_headers`.
///
/// It sets `access-control-allow-origin` and `vary: Origin` on every response. A request with method `OPTIONS` is answered with `204`, the allowed methods and `allow_headers` joined by commas, without calling the rest of the chain. The middleware runs for a request whose path matches a route of another method, so a preflight for a route registered with `get` or `post` reaches it.
pub fn cors(origin: str, allow_headers: []str) -> Middleware {
    let listed = text.join(allow_headers, ", ")
    Middleware {
        run: fn(c: *Context, next: fn() -> http.Response) -> http.Response {
            set_header(c, "access-control-allow-origin", origin)
            set_header(c, "vary", "Origin")
            if c.request.method == "OPTIONS" {
                set_header(c, "access-control-allow-methods", "GET, POST, PUT, PATCH, DELETE, OPTIONS")
                set_header(c, "access-control-allow-headers", listed)
                return no_content()
            }
            next()
        }
        security: none
    }
}
