import std/http
import std/http/sse

pub fn events(c: *Context, ch: chan[sse.Event]) -> http.Response {
    sse.serve_events(c.request, ch)
}

pub fn events_with(c: *Context, o: sse.Options, ch: chan[sse.Event]) -> http.Response {
    sse.serve_events_with(c.request, o, ch)
}

pub fn event_stream(c: *Context, producer: fn(*sse.Emitter)) -> http.Response {
    sse.stream(c.request, producer)
}

pub fn event_stream_with(c: *Context, o: sse.Options, producer: fn(*sse.Emitter)) -> http.Response {
    sse.stream_with(c.request, o, producer)
}

pub fn last_event_id(c: *Context) -> str? {
    sse.last_event_id(c.request)
}
