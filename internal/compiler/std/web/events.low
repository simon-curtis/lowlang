import std/http
import std/http/sse

/// Returns a Server-Sent Events response that sends every event received on `ch`.
///
/// The stream ends when `ch` is closed or the client disconnects. A keepalive comment is sent when no event has arrived for the default keepalive interval.
pub fn events(c: *Context, ch: chan[sse.Event]) -> http.Response {
    sse.serve_events(c.request, ch)
}

/// Like `events`, with the keepalive interval and reconnection delay taken from `o`.
pub fn events_with(c: *Context, o: sse.Options, ch: chan[sse.Event]) -> http.Response {
    sse.serve_events_with(c.request, o, ch)
}

/// Returns a Server-Sent Events response fed by `producer`.
///
/// `producer` runs in its own task with an emitter, and the stream ends when it returns. `sse.send` on the emitter returns `false` once the client has disconnected.
pub fn event_stream(c: *Context, producer: fn(*sse.Emitter)) -> http.Response {
    sse.stream(c.request, producer)
}

/// Like `event_stream`, with the keepalive interval and reconnection delay taken from `o`.
pub fn event_stream_with(c: *Context, o: sse.Options, producer: fn(*sse.Emitter)) -> http.Response {
    sse.stream_with(c.request, o, producer)
}

/// Returns the `Last-Event-ID` header of the request, or `none` when it is absent or empty.
///
/// A reconnecting client sends the id of the last event it received.
pub fn last_event_id(c: *Context) -> str? {
    sse.last_event_id(c.request)
}
