import std/http
import std/serde

fn completed[Res](result: fn() -> Res ! Problem, status: i64) -> http.Response {
    let value = result() catch {
        BadRequest(d) => return problem_response(BadRequest(d))
        Unauthorized(d) => return problem_response(Unauthorized(d))
        Forbidden(d) => return problem_response(Forbidden(d))
        NotFound => return problem_response(NotFound)
        Conflict(d) => return problem_response(Conflict(d))
        Unprocessable(d) => return problem_response(Unprocessable(d))
        TooMany => return problem_response(TooMany)
        Internal(d) => return problem_response(Internal(d))
        Status(code, detail) => return problem_response(Status(code, detail))
    }
    json_response(status, value)
}

/// Registers a route whose handler takes a JSON body decoded as `Req` and returns a `Res` as JSON.
///
/// The response has `status` on success. A body that does not decode, or a `Problem` that `handle` fails with, becomes the problem response. The schemas of `Req` and `Res` and `status` are recorded in the returned `Operation` for the OpenAPI document.
pub fn endpoint[Req, Res](a: *App, method: str, path: str, status: i64, handle: fn(*Context, Req) -> Res ! Problem) -> *Operation {
    let op = route(a, method, path, fn(c: *Context) -> http.Response {
        completed(fn() -> Res ! Problem {
            let body = body_json[Req](c)?
            handle(c, body)
        }, status)
    })
    op.request = serde.schema[Req]()
    op.response = serde.schema[Res]()
    op.status = status
    op
}

/// Registers a route whose handler returns a `Res` as JSON with status `200`.
///
/// A `Problem` that `handle` fails with becomes the problem response. The schema of `Res` is recorded in the returned `Operation`.
pub fn query_endpoint[Res](a: *App, method: str, path: str, handle: fn(*Context) -> Res ! Problem) -> *Operation {
    let op = route(a, method, path, fn(c: *Context) -> http.Response {
        completed(fn() -> Res ! Problem { handle(c) }, 200)
    })
    op.response = serde.schema[Res]()
    op
}
