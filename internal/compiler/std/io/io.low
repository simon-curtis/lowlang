import std/simd

pub enum Error {
    NotFound
    Denied
    Exists
    NotDir
    IsDir
    NotEmpty
    Invalid
    NoSpace
    BrokenPipe
    AddrInUse
    AddrUnavailable
    Unreachable
    Refused
    Reset
    Aborted
    TimedOut
    NotConnected
    WouldBlock
    Eof
    Malformed
    TooLarge
    Unsupported
    Os(code: i64)
}

pub struct Stream {
    pub read: fn([]u8) -> i64 ! Error
    pub write: fn([]u8) -> i64 ! Error
    pub close: fn()
}

pub fn errno(code: i64) -> Error {
    let known: [i64: Error] = [
        1: Denied, 2: NotFound, 11: WouldBlock, 13: Denied, 17: Exists, 20: NotDir, 21: IsDir,
        22: Invalid, 28: NoSpace, 32: BrokenPipe, 39: NotEmpty, 98: AddrInUse, 99: AddrUnavailable,
        101: Unreachable, 103: Aborted, 104: Reset, 107: NotConnected, 110: TimedOut, 111: Refused,
        113: Unreachable,
    ]
    known[code] ?? Os(code)
}

pub fn syscall_result(r: i64) -> i64 ! Error {
    if r < 0 {
        fail errno(-r)
    }
    r
}

pub fn buffer(n: i64) -> []u8 {
    __make(n)
}

pub fn copy(dst: []u8, src: []u8) -> i64 {
    __memmove(dst, src)
}

pub fn append(mut dst: []u8, src: []u8) {
    for x in src {
        push(mut dst, x)
    }
}

pub fn append_str(mut dst: []u8, s: str) {
    for i in 0..s.len {
        push(mut dst, s[i])
    }
}

pub fn be16(b: []u8, at: i64) -> i64 {
    i64(b[at]) << 8 | i64(b[at + 1])
}

pub fn be24(b: []u8, at: i64) -> i64 {
    i64(b[at]) << 16 | be16(b, at + 1)
}

pub fn be32(b: []u8, at: i64) -> i64 {
    be16(b, at) << 16 | be16(b, at + 2)
}

pub fn be64(b: []u8, at: i64) -> i64 {
    be32(b, at) << 32 | be32(b, at + 4)
}

pub fn le16(b: []u8, at: i64) -> i64 {
    i64(b[at]) | i64(b[at + 1]) << 8
}

pub fn le32(b: []u8, at: i64) -> i64 {
    le16(b, at) | le16(b, at + 2) << 16
}

pub fn le64(b: []u8, at: i64) -> i64 {
    le32(b, at) | le32(b, at + 4) << 32
}

pub fn put_be16(mut b: []u8, v: i64) {
    push(mut b, u8(v >> 8))
    push(mut b, u8(v))
}

pub fn put_be24(mut b: []u8, v: i64) {
    push(mut b, u8(v >> 16))
    put_be16(mut b, v)
}

pub fn put_be32(mut b: []u8, v: i64) {
    put_be16(mut b, v >> 16)
    put_be16(mut b, v)
}

pub fn put_be64(mut b: []u8, v: i64) {
    put_be32(mut b, v >> 32)
    put_be32(mut b, v)
}

pub fn set_le16(b: []u8, at: i64, v: i64) {
    b[at] = u8(v)
    b[at + 1] = u8(v >> 8)
}

pub fn set_le32(b: []u8, at: i64, v: i64) {
    set_le16(b, at, v)
    set_le16(b, at + 2, v >> 16)
}

pub fn set_le64(b: []u8, at: i64, v: i64) {
    set_le32(b, at, v)
    set_le32(b, at + 4, v >> 32)
}

pub fn write_all(s: Stream, data: []u8) ! Error {
    var rest = data
    for rest.len > 0 {
        let n = s.write(rest)?
        rest = rest[n..]
    }
}

pub fn write_str(s: Stream, text: str) ! Error {
    write_all(s, bytes(text))?
}

pub fn read_all(s: Stream) -> []u8 ! Error {
    var out: []u8 = []
    let chunk = buffer(16384)
    for {
        let n = s.read(chunk)?
        if n == 0 {
            break
        }
        append(mut out, chunk[..n])
    }
    out
}

pub struct Reader {
    stream: Stream
    buf: []u8
    start: i64
    end: i64
    fixed: bool
}

pub fn reader(s: Stream) -> *Reader {
    new(Reader { stream: s, buf: buffer(16384), start: 0, end: 0, fixed: false })
}

pub fn bytes_reader(data: []u8) -> *Reader {
    let exhausted = Stream {
        read: fn(buf) { 0 }
        write: fn(buf) -> i64 ! Error { fail Unsupported }
        close: fn() {}
    }
    new(Reader { stream: exhausted, buf: data, start: 0, end: data.len, fixed: true })
}

pub fn reader_stream(r: *Reader) -> Stream {
    r.stream
}

pub fn buffered(r: *Reader) -> i64 {
    r.end - r.start
}

pub fn fill(r: *Reader) -> i64 ! Error {
    if r.fixed {
        return 0
    }
    if r.start == r.end {
        r.start = 0
        r.end = 0
    }
    if r.end == r.buf.len {
        if r.start == 0 {
            fail TooLarge
        }
        let kept = r.end - r.start
        copy(r.buf, r.buf[r.start..r.end])
        r.start = 0
        r.end = kept
    }
    let n = r.stream.read(r.buf[r.end..])?
    r.end += n
    n
}

pub fn read_line(r: *Reader) -> str ! Error {
    var scanned = r.start
    for {
        let i = simd.find_byte(r.buf, scanned, r.end, '\n')
        if i >= 0 {
            var stop = i
            if stop > r.start && r.buf[stop - 1] == '\r' {
                stop -= 1
            }
            let line = str(r.buf[r.start..stop])
            r.start = i + 1
            return line
        }
        scanned = r.end - r.start
        if fill(r)? == 0 {
            fail Eof
        }
        scanned += r.start
    }
}

pub fn read_some(r: *Reader, dst: []u8) -> i64 ! Error {
    if r.start == r.end {
        if dst.len >= r.buf.len {
            return r.stream.read(dst)
        }
        if fill(r)? == 0 {
            return 0
        }
    }
    let n = copy(dst, r.buf[r.start..r.end])
    r.start += n
    n
}

pub fn read_exact(r: *Reader, n: i64) -> []u8 ! Error {
    let out = buffer(n)
    var got = 0
    for got < n {
        let k = read_some(r, out[got..])?
        if k == 0 {
            fail Eof
        }
        got += k
    }
    out
}

pub fn read_byte(r: *Reader) -> u8 ! Error {
    if r.start == r.end && fill(r)? == 0 {
        fail Eof
    }
    let b = r.buf[r.start]
    r.start += 1
    b
}
