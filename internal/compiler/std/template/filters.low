import std/html
import std/json
import std/text
import std/time/fault
import std/time/timestamp
import std/time/zone
import std/time/zoned
import std/uri

fn apply_filter(c: *Ctx, name: str, v: Data, args: []Data, pos: Pos) -> Data ! Error {
    match c.set.filters[name] {
        some(f) => return call_user(c, name, f, v, args, pos)?
        none => {}
    }
    match name {
        == "upper" => keep(v, text.upper(subject_text(c, name, v, pos)?))
        == "lower" => keep(v, text.lower(subject_text(c, name, v, pos)?))
        == "trim" => keep(v, text.trim(subject_text(c, name, v, pos)?))
        == "len" => filter_len(c, v, pos)?
        == "default" => filter_default(c, v, args, pos)?
        == "join" => filter_join(c, v, args, pos)?
        == "escape" => filter_escape(c, v, pos)?
        == "raw" => Data.Safe(subject_text(c, name, v, pos)?)
        == "json" => filter_json(c, v, args, pos)?
        == "url" => Data.Str(uri.escape(subject_text(c, name, v, pos)?))
        == "date" => filter_date(c, v, args, pos)?
        == "truncate" => filter_truncate(c, v, args, pos)?
        == "pluralize" => filter_pluralize(c, v, args, pos)?
        == "replace" => filter_replace(c, v, args, pos)?
        == "first" => filter_first(c, v, pos)?
        == "last" => filter_last(c, v, pos)?
        == "keys" => filter_keys(c, v, pos)?
        _ => fail render_error(c, pos, "unknown filter {name}")
    }
}

fn call_user(c: *Ctx, name: str, f: fn(Data, []Data) -> Data ! FilterError, v: Data, args: []Data, pos: Pos) -> Data ! Error {
    f(v, args) catch {
        Invalid(message) => fail render_error(c, pos, "filter {name}: {message}")
    }
}

fn keep(v: Data, s: str) -> Data {
    match v {
        Safe(_) => Data.Safe(s)
        _ => Data.Str(s)
    }
}

fn subject_text(c: *Ctx, name: str, v: Data, pos: Pos) -> str ! Error {
    match v {
        List(_) => fail render_error(c, pos, "filter {name} needs a scalar, not a list")
        Map(_) => fail render_error(c, pos, "filter {name} needs a scalar, not a map")
        _ => plain(c, v, pos)?
    }
}

fn arity(c: *Ctx, name: str, args: []Data, least: i64, most: i64, pos: Pos) ! Error {
    if args.len < least || args.len > most {
        fail render_error(c, pos, "filter {name} takes {least} to {most} arguments, got {args.len}")
    }
}

fn text_arg(c: *Ctx, name: str, args: []Data, i: i64, pos: Pos) -> str ! Error {
    match as_text(args[i]) {
        some(s) => s
        none => fail render_error(c, pos, "filter {name} needs a string argument")
    }
}

fn int_arg(c: *Ctx, name: str, args: []Data, i: i64, pos: Pos) -> i64 ! Error {
    match args[i] {
        Int(n) => n
        _ => fail render_error(c, pos, "filter {name} needs an int argument")
    }
}

fn filter_len(c: *Ctx, v: Data, pos: Pos) -> Data ! Error {
    match v {
        Null => Data.Int(0)
        Str(s) => Data.Int(text.char_count(s))
        Safe(s) => Data.Int(text.char_count(s))
        List(items) => Data.Int(items.len)
        Map(entries) => Data.Int(entries.len)
        _ => fail render_error(c, pos, "filter len needs a string, list or map")
    }
}

fn filter_default(c: *Ctx, v: Data, args: []Data, pos: Pos) -> Data ! Error {
    arity(c, "default", args, 1, 2, pos)?
    let every = args.len == 2 && truthy(args[1])
    match v {
        Null => return args[0]
        Str(s) => {
            if s.len == 0 {
                return args[0]
            }
        }
        Safe(s) => {
            if s.len == 0 {
                return args[0]
            }
        }
        _ => {}
    }
    if every && !truthy(v) {
        return args[0]
    }
    v
}

fn escape_part(c: *Ctx, v: Data, pos: Pos) -> str ! Error {
    match v {
        Safe(s) => s
        Str(s) => escaped(c, s)
        _ => escaped(c, plain(c, v, pos)?)
    }
}

fn filter_join(c: *Ctx, v: Data, args: []Data, pos: Pos) -> Data ! Error {
    arity(c, "join", args, 0, 1, pos)?
    var sep = ""
    if args.len == 1 {
        sep = escape_part(c, args[0], pos)?
    }
    match v {
        List(items) => {
            var parts: []str = []
            for item in items {
                let part = escape_part(c, item, pos)?
                push(mut parts, part)
            }
            Data.Safe(text.join(parts, sep))
        }
        Null => Data.Safe("")
        _ => fail render_error(c, pos, "filter join needs a list")
    }
}

fn filter_escape(c: *Ctx, v: Data, pos: Pos) -> Data ! Error {
    match v {
        Safe(_) => v
        _ => Data.Safe(html.escape(subject_text(c, "escape", v, pos)?))
    }
}

fn write_json(w: *json.Writer, d: Data) {
    match d {
        Null => json.null(w)
        Bool(b) => json.boolean(w, b)
        Int(n) => json.integer(w, n)
        Float(x) => json.float(w, x)
        Str(s) => json.string_value(w, s)
        Safe(s) => json.string_value(w, s)
        List(items) => {
            json.start_array(w)
            for item in items {
                write_json(w, item)
            }
            json.end_array(w)
        }
        Map(entries) => {
            json.start_object(w)
            for k, value in entries {
                json.property(w, k)
                write_json(w, value)
            }
            json.end_object(w)
        }
    }
}

fn script_safe(s: str) -> str {
    var out: []u8 = []
    for i in 0..s.len {
        let ch = s[i]
        if ch == '<' {
            text.append(mut out, "\\u003c")
        } else if ch == '>' {
            text.append(mut out, "\\u003e")
        } else if ch == '&' {
            text.append(mut out, "\\u0026")
        } else if ch == '\'' {
            text.append(mut out, "\\u0027")
        } else {
            push(mut out, ch)
        }
    }
    __str_view(out)
}

fn filter_json(c: *Ctx, v: Data, args: []Data, pos: Pos) -> Data ! Error {
    arity(c, "json", args, 0, 1, pos)?
    var indent = 0
    if args.len == 1 {
        indent = int_arg(c, "json", args, 0, pos)?
    }
    let w = json.writer(indent)
    write_json(w, v)
    Data.Safe(script_safe(json.written_text(w)))
}

fn filter_date(c: *Ctx, v: Data, args: []Data, pos: Pos) -> Data ! Error {
    arity(c, "date", args, 0, 1, pos)?
    var layout = "%Y-%m-%d"
    if args.len == 1 {
        layout = text_arg(c, "date", args, 0, pos)?
    }
    match v {
        Int(n) => date_unix(c, n, layout, pos)?
        Float(x) => date_unix(c, i64(x), layout, pos)?
        Str(s) => date_text(c, s, layout, pos)?
        Safe(s) => date_text(c, s, layout, pos)?
        _ => fail render_error(c, pos, "filter date needs a unix time or an RFC 3339 string")
    }
}

fn unix_zoned(n: i64) -> zoned.Zoned ! fault.Fault {
    let ts = timestamp.from_unix(n)?
    zoned.of(ts, zone.utc())?
}

fn date_unix(c: *Ctx, n: i64, layout: str, pos: Pos) -> Data ! Error {
    let z = unix_zoned(n) catch {
        _ => fail render_error(c, pos, "filter date cannot represent {n}")
    }
    date_layout(c, z, layout, pos)?
}

fn date_text(c: *Ctx, s: str, layout: str, pos: Pos) -> Data ! Error {
    let z = zoned.parse(s) catch {
        _ => fail render_error(c, pos, "filter date cannot read {s}")
    }
    date_layout(c, z, layout, pos)?
}

fn date_layout(c: *Ctx, z: zoned.Zoned, layout: str, pos: Pos) -> Data ! Error {
    let rendered = zoned.format(z, layout) catch {
        _ => fail render_error(c, pos, "filter date cannot use layout {layout}")
    }
    Data.Str(rendered)
}

fn filter_truncate(c: *Ctx, v: Data, args: []Data, pos: Pos) -> Data ! Error {
    arity(c, "truncate", args, 1, 2, pos)?
    let limit = int_arg(c, "truncate", args, 0, pos)?
    var suffix = "..."
    if args.len == 2 {
        suffix = text_arg(c, "truncate", args, 1, pos)?
    }
    let s = subject_text(c, "truncate", v, pos)?
    var seen = 0
    for i, ch in s {
        if seen == limit {
            return Data.Str("{s[..i]}{suffix}")
        }
        seen += 1
    }
    Data.Str(s)
}

fn filter_pluralize(c: *Ctx, v: Data, args: []Data, pos: Pos) -> Data ! Error {
    arity(c, "pluralize", args, 0, 2, pos)?
    var singular = ""
    var plural = "s"
    if args.len == 1 {
        plural = text_arg(c, "pluralize", args, 0, pos)?
    }
    if args.len == 2 {
        singular = text_arg(c, "pluralize", args, 0, pos)?
        plural = text_arg(c, "pluralize", args, 1, pos)?
    }
    let one = match v {
        Int(n) => n == 1
        Float(x) => x == 1.0
        List(items) => items.len == 1
        _ => fail render_error(c, pos, "filter pluralize needs a number or a list")
    }
    Data.Str(if one { singular } else { plural })
}

fn filter_replace(c: *Ctx, v: Data, args: []Data, pos: Pos) -> Data ! Error {
    arity(c, "replace", args, 2, 2, pos)?
    let old = text_arg(c, "replace", args, 0, pos)?
    let by = text_arg(c, "replace", args, 1, pos)?
    let s = subject_text(c, "replace", v, pos)?
    Data.Str(text.replace(s, old, by))
}

fn filter_first(c: *Ctx, v: Data, pos: Pos) -> Data ! Error {
    match v {
        List(items) => if items.len > 0 { items[0] } else { Data.Null }
        Str(s) => first_char(s)
        Safe(s) => first_char(s)
        Null => Data.Null
        _ => fail render_error(c, pos, "filter first needs a list or a string")
    }
}

fn first_char(s: str) -> Data {
    for ch in s {
        return Data.Str(text.from_char(ch))
    }
    Data.Null
}

fn filter_last(c: *Ctx, v: Data, pos: Pos) -> Data ! Error {
    match v {
        List(items) => if items.len > 0 { items[items.len - 1] } else { Data.Null }
        Str(s) => last_char(s)
        Safe(s) => last_char(s)
        Null => Data.Null
        _ => fail render_error(c, pos, "filter last needs a list or a string")
    }
}

fn last_char(s: str) -> Data {
    var found: Data = Data.Null
    for ch in s {
        found = Data.Str(text.from_char(ch))
    }
    found
}

fn filter_keys(c: *Ctx, v: Data, pos: Pos) -> Data ! Error {
    match v {
        Map(entries) => {
            var keys: []Data = []
            for k in entries {
                push(mut keys, Data.Str(k))
            }
            Data.List(keys)
        }
        Null => Data.List([])
        _ => fail render_error(c, pos, "filter keys needs a map")
    }
}
