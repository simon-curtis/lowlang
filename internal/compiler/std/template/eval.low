import std/text

fn missing(c: *Ctx, pos: Pos, message: str) -> Data ! Error {
    if c.set.options.strict && c.lenient == 0 {
        fail render_error(c, pos, message)
    }
    Data.Null
}

fn eval(c: *Ctx, e: Expr) -> Data ! Error {
    match e {
        Literal(v) => v
        Variable(name, pos) => variable(c, name, pos)?
        LoopVar(name, pos) => {
            let slot = "@{name}"
            lookup(c, slot) ?? fail render_error(c, pos, "@{name} is only available inside a for loop")
        }
        Member(base, name, pos) => {
            let b = eval(c, *base)?
            member(c, b, name, pos)?
        }
        Index(base, key, pos) => {
            let b = eval(c, *base)?
            let k = eval(c, *key)?
            index(c, b, k, pos)?
        }
        Negate(operand, pos) => {
            let v = eval(c, *operand)?
            negate(c, v, pos)?
        }
        Not(operand) => {
            let v = eval(c, *operand)?
            Data.Bool(!truthy(v))
        }
        Binary(op, left, right, pos) => binary_op(c, op, *left, *right, pos)?
        Filter(subject, name, args, pos) => {
            let lenient = lenient_subject(c, name)
            if lenient {
                c.lenient += 1
            }
            let v = eval(c, *subject)?
            if lenient {
                c.lenient -= 1
            }
            var values: []Data = []
            for a in args {
                let arg = eval(c, a)?
                push(mut values, arg)
            }
            apply_filter(c, name, v, values, pos)?
        }
    }
}

fn variable(c: *Ctx, name: str, pos: Pos) -> Data ! Error {
    match lookup(c, name) {
        some(v) => return v
        none => {}
    }
    match c.root {
        Map(entries) => match entries[name] {
            some(v) => return v
            none => {}
        }
        _ => {}
    }
    missing(c, pos, "{name} is not defined")?
}

fn member(c: *Ctx, b: Data, name: str, pos: Pos) -> Data ! Error {
    match b {
        Map(entries) => match entries[name] {
            some(v) => v
            none => missing(c, pos, "no key {name}")?
        }
        List(items) => {
            if !text.is_digits(name) {
                fail render_error(c, pos, "cannot read {name} of list")
            }
            let n = text.parse_int(name) catch {
                _ => fail render_error(c, pos, "bad index {name}")
            }
            if n >= items.len {
                return missing(c, pos, "index {n} is out of range")?
            }
            items[n]
        }
        Null => missing(c, pos, "cannot read {name} of null")?
        _ => fail render_error(c, pos, "cannot read {name} of {kind_name(b)}")
    }
}

fn index(c: *Ctx, b: Data, k: Data, pos: Pos) -> Data ! Error {
    match b {
        List(items) => match k {
            Int(i) => {
                if i < 0 || i >= items.len {
                    return missing(c, pos, "index {i} is out of range")?
                }
                items[i]
            }
            _ => fail render_error(c, pos, "a list is indexed by an int")
        }
        Map(entries) => {
            let key = key_text(k) ?? fail render_error(c, pos, "a map is indexed by a string")
            match entries[key] {
                some(v) => v
                none => missing(c, pos, "no key {key}")?
            }
        }
        Null => missing(c, pos, "cannot index null")?
        _ => fail render_error(c, pos, "cannot index {kind_name(b)}")
    }
}

fn key_text(k: Data) -> str? {
    match k {
        Str(s) => s
        Safe(s) => s
        Int(n) => "{n}"
        _ => none
    }
}

fn negate(c: *Ctx, v: Data, pos: Pos) -> Data ! Error {
    match v {
        Int(n) => Data.Int(-n)
        Float(x) => Data.Float(-x)
        _ => fail render_error(c, pos, "cannot negate {kind_name(v)}")
    }
}

fn binary_op(c: *Ctx, op: Op, left: Expr, right: Expr, pos: Pos) -> Data ! Error {
    let a = eval(c, left)?
    match op {
        Or => {
            if truthy(a) {
                return a
            }
            return eval(c, right)?
        }
        And => {
            if !truthy(a) {
                return a
            }
            return eval(c, right)?
        }
        _ => {}
    }
    let b = eval(c, right)?
    match op {
        Equal => Data.Bool(equal(a, b))
        NotEqual => Data.Bool(!equal(a, b))
        Less => compare(c, a, b, pos, fn(n) { n < 0 })?
        LessEqual => compare(c, a, b, pos, fn(n) { n <= 0 })?
        Greater => compare(c, a, b, pos, fn(n) { n > 0 })?
        GreaterEqual => compare(c, a, b, pos, fn(n) { n >= 0 })?
        Contains => contains(c, a, b, pos)?
        _ => arithmetic(c, op, a, b, pos)?
    }
}

fn compare(c: *Ctx, a: Data, b: Data, pos: Pos, test: fn(i64) -> bool) -> Data ! Error {
    match order(a, b) {
        some(n) => Data.Bool(test(n))
        none => fail render_error(c, pos, "cannot compare {kind_name(a)} with {kind_name(b)}")
    }
}

fn contains(c: *Ctx, needle: Data, haystack: Data, pos: Pos) -> Data ! Error {
    match haystack {
        List(items) => {
            for item in items {
                if equal(item, needle) {
                    return Data.Bool(true)
                }
            }
            Data.Bool(false)
        }
        Map(entries) => match as_text(needle) {
            some(key) => match entries[key] {
                some(_) => Data.Bool(true)
                none => Data.Bool(false)
            }
            none => Data.Bool(false)
        }
        Str(s) => contains_text(c, needle, s, pos)?
        Safe(s) => contains_text(c, needle, s, pos)?
        Null => Data.Bool(false)
        _ => fail render_error(c, pos, "cannot test membership in {kind_name(haystack)}")
    }
}

fn contains_text(c: *Ctx, needle: Data, s: str, pos: Pos) -> Data ! Error {
    match as_text(needle) {
        some(part) => Data.Bool(text.contains(s, part))
        none => fail render_error(c, pos, "a string contains only strings")
    }
}

fn arithmetic(c: *Ctx, op: Op, a: Data, b: Data, pos: Pos) -> Data ! Error {
    match a {
        Int(x) => match b {
            Int(y) => return int_arithmetic(c, op, x, y, pos)?
            _ => {}
        }
        _ => {}
    }
    match as_float(a) {
        some(x) => match as_float(b) {
            some(y) => return float_arithmetic(c, op, x, y, pos)?
            none => {}
        }
        none => {}
    }
    if op == Op.Add {
        match as_text(a) {
            some(x) => match as_text(b) {
                some(y) => return Data.Str("{x}{y}")
                none => {}
            }
            none => {}
        }
    }
    fail render_error(c, pos, "cannot combine {kind_name(a)} with {kind_name(b)}")
}

fn int_arithmetic(c: *Ctx, op: Op, x: i64, y: i64, pos: Pos) -> Data ! Error {
    match op {
        Add => Data.Int(x + y)
        Subtract => Data.Int(x - y)
        Multiply => Data.Int(x * y)
        Divide => {
            if y == 0 {
                fail render_error(c, pos, "division by zero")
            }
            Data.Int(x / y)
        }
        _ => {
            if y == 0 {
                fail render_error(c, pos, "division by zero")
            }
            Data.Int(x % y)
        }
    }
}

fn float_arithmetic(c: *Ctx, op: Op, x: f64, y: f64, pos: Pos) -> Data ! Error {
    match op {
        Add => Data.Float(x + y)
        Subtract => Data.Float(x - y)
        Multiply => Data.Float(x * y)
        Divide => Data.Float(x / y)
        _ => fail render_error(c, pos, "remainder needs ints")
    }
}
