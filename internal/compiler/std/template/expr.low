import std/text

fn peek(p: *Parser) -> u8 {
    if p.at < p.limit {
        return p.src[p.at]
    }
    0
}

fn peek_at(p: *Parser, k: i64) -> u8 {
    if p.at + k < p.limit {
        return p.src[p.at + k]
    }
    0
}

fn skip_space(p: *Parser) {
    for p.at < p.limit && text.space(p.src[p.at]) {
        p.at += 1
    }
}

fn name_start(c: u8) -> bool {
    c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c == '_'
}

fn name_byte(c: u8) -> bool {
    name_start(c) || c >= '0' && c <= '9'
}

fn digit(c: u8) -> bool {
    c >= '0' && c <= '9'
}

fn take_word(p: *Parser) -> str {
    let start = p.at
    if !name_start(peek(p)) {
        return ""
    }
    for p.at < p.limit && name_byte(p.src[p.at]) {
        p.at += 1
    }
    p.src[start..p.at]
}

fn take_keyword(p: *Parser, word: str) -> bool {
    let start = p.at
    if take_word(p) == word {
        return true
    }
    p.at = start
    false
}

fn expect_name(p: *Parser) -> str ! Error {
    skip_space(p)
    let start = p.at
    let word = take_word(p)
    if word == "" {
        fail error_at(p, start, "expected a name")
    }
    word
}

fn accept(p: *Parser, token: str) -> bool {
    skip_space(p)
    if p.at + token.len > p.limit {
        return false
    }
    if p.src[p.at..p.at + token.len] != token {
        return false
    }
    p.at += token.len
    true
}

fn grow(p: *Parser) ! Error {
    p.nodes += 1
    if p.nodes > 128 {
        fail error_at(p, p.at, "expression is too long")
    }
}

fn parse_expr(p: *Parser) -> Expr ! Error {
    parse_or(p)?
}

fn binary(op: Op, left: Expr, right: Expr, pos: Pos) -> Expr {
    let l = new(left)
    let r = new(right)
    Expr.Binary(op, l, r, pos)
}

fn parse_or(p: *Parser) -> Expr ! Error {
    var left = parse_and(p)?
    for {
        skip_space(p)
        let pos = locate(p, p.at)
        if !accept(p, "||") {
            return left
        }
        grow(p)?
        let right = parse_and(p)?
        left = binary(Or, left, right, pos)
    }
}

fn parse_and(p: *Parser) -> Expr ! Error {
    var left = parse_comparison(p)?
    for {
        skip_space(p)
        let pos = locate(p, p.at)
        if !accept(p, "&&") {
            return left
        }
        grow(p)?
        let right = parse_comparison(p)?
        left = binary(And, left, right, pos)
    }
}

fn comparison_op(p: *Parser) -> Op? {
    skip_space(p)
    if accept(p, "==") {
        return Op.Equal
    }
    if accept(p, "!=") {
        return Op.NotEqual
    }
    if accept(p, "<=") {
        return Op.LessEqual
    }
    if accept(p, ">=") {
        return Op.GreaterEqual
    }
    if accept(p, "<") {
        return Op.Less
    }
    if accept(p, ">") {
        return Op.Greater
    }
    if take_keyword(p, "in") {
        return Op.Contains
    }
    none
}

fn parse_comparison(p: *Parser) -> Expr ! Error {
    let left = parse_additive(p)?
    skip_space(p)
    let pos = locate(p, p.at)
    match comparison_op(p) {
        some(op) => {
            grow(p)?
            let right = parse_additive(p)?
            binary(op, left, right, pos)
        }
        none => left
    }
}

fn parse_additive(p: *Parser) -> Expr ! Error {
    var left = parse_multiplicative(p)?
    for {
        skip_space(p)
        let pos = locate(p, p.at)
        var op = Op.Add
        if accept(p, "+") {
            op = Op.Add
        } else if peek(p) == '-' {
            p.at += 1
            op = Op.Subtract
        } else {
            return left
        }
        grow(p)?
        let right = parse_multiplicative(p)?
        left = binary(op, left, right, pos)
    }
}

fn parse_multiplicative(p: *Parser) -> Expr ! Error {
    var left = parse_unary(p)?
    for {
        skip_space(p)
        let pos = locate(p, p.at)
        var op = Op.Multiply
        if accept(p, "*") {
            op = Op.Multiply
        } else if accept(p, "/") {
            op = Op.Divide
        } else if accept(p, "%") {
            op = Op.Remainder
        } else {
            return left
        }
        grow(p)?
        let right = parse_unary(p)?
        left = binary(op, left, right, pos)
    }
}

fn parse_unary(p: *Parser) -> Expr ! Error {
    skip_space(p)
    let pos = locate(p, p.at)
    if peek(p) == '!' && peek_at(p, 1) != '=' {
        grow(p)?
        p.at += 1
        let operand = parse_unary(p)?
        let boxed = new(operand)
        return Expr.Not(boxed)
    }
    if peek(p) == '-' {
        grow(p)?
        p.at += 1
        let operand = parse_unary(p)?
        let boxed = new(operand)
        return Expr.Negate(boxed, pos)
    }
    parse_postfix(p)?
}

fn parse_postfix(p: *Parser) -> Expr ! Error {
    var e = parse_primary(p)?
    for {
        let pos = locate(p, p.at)
        if peek(p) == '.' && name_byte(peek_at(p, 1)) {
            grow(p)?
            p.at += 1
            let start = p.at
            for p.at < p.limit && name_byte(p.src[p.at]) {
                p.at += 1
            }
            let base = new(e)
            e = Expr.Member(base, p.src[start..p.at], pos)
        } else if peek(p) == '[' {
            grow(p)?
            p.at += 1
            let index = parse_expr(p)?
            if !accept(p, "]") {
                fail error_at(p, p.at, "expected ]")
            }
            let base = new(e)
            let key = new(index)
            e = Expr.Index(base, key, pos)
        } else {
            break
        }
    }
    for {
        skip_space(p)
        if peek(p) != '|' || peek_at(p, 1) == '|' {
            return e
        }
        let pos = locate(p, p.at)
        grow(p)?
        p.at += 1
        let name = expect_name(p)?
        var args: []Expr = []
        if peek(p) == '(' {
            p.at += 1
            skip_space(p)
            if !accept(p, ")") {
                for {
                    let arg = parse_expr(p)?
                    push(mut args, arg)
                    if accept(p, ",") {
                        continue
                    }
                    if !accept(p, ")") {
                        fail error_at(p, p.at, "expected , or )")
                    }
                    break
                }
            }
        }
        let subject = new(e)
        e = Expr.Filter(subject, name, args, pos)
    }
}

fn parse_primary(p: *Parser) -> Expr ! Error {
    skip_space(p)
    let c = peek(p)
    let pos = locate(p, p.at)
    if c == '(' {
        grow(p)?
        p.at += 1
        let inner = parse_expr(p)?
        if !accept(p, ")") {
            fail error_at(p, p.at, "expected )")
        }
        return inner
    }
    if c == '"' || c == '\'' {
        let s = parse_string(p)?
        return Expr.Literal(Data.Str(s))
    }
    if digit(c) {
        return parse_number(p)?
    }
    if c == '@' {
        p.at += 1
        let name = expect_name(p)?
        return Expr.LoopVar(name, pos)
    }
    if name_start(c) {
        let word = take_word(p)
        if word == "true" {
            return Expr.Literal(Data.Bool(true))
        }
        if word == "false" {
            return Expr.Literal(Data.Bool(false))
        }
        if word == "none" || word == "null" {
            return Expr.Literal(Data.Null)
        }
        return Expr.Variable(word, pos)
    }
    if p.at >= p.limit {
        fail error_at(p, p.at, "expected an expression")
    }
    fail error_at(p, p.at, "unexpected {text.from_char(u32(c))}")
}

fn parse_number(p: *Parser) -> Expr ! Error {
    let start = p.at
    for p.at < p.limit && digit(p.src[p.at]) {
        p.at += 1
    }
    var is_float = false
    if peek(p) == '.' && digit(peek_at(p, 1)) {
        is_float = true
        p.at += 1
        for p.at < p.limit && digit(p.src[p.at]) {
            p.at += 1
        }
    }
    let digits = p.src[start..p.at]
    if is_float {
        let x = text.parse_float(digits) catch {
            _ => fail error_at(p, start, "bad number")
        }
        return Expr.Literal(Data.Float(x))
    }
    let n = text.parse_int(digits) catch {
        _ => fail error_at(p, start, "number out of range")
    }
    Expr.Literal(Data.Int(n))
}

fn parse_string(p: *Parser) -> str ! Error {
    let start = p.at
    let quote = p.src[p.at]
    p.at += 1
    var out: []u8 = []
    for p.at < p.limit {
        let c = p.src[p.at]
        if c == quote {
            p.at += 1
            return __str_view(out)
        }
        if c == '\\' && p.at + 1 < p.limit {
            let e = p.src[p.at + 1]
            p.at += 2
            if e == 'n' {
                push(mut out, '\n')
            } else if e == 't' {
                push(mut out, '\t')
            } else if e == 'r' {
                push(mut out, '\r')
            } else {
                push(mut out, e)
            }
            continue
        }
        push(mut out, c)
        p.at += 1
    }
    fail error_at(p, start, "unclosed string")
}
