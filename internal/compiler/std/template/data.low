import std/base64
import std/json
import std/serde

/// A value that a template reads: `null`, a scalar, a list or a map with string keys.
/// Build one with the variants, with `list` and `map`, from JSON with `from_json`, or from any serialisable value with `to_data`.
pub enum Data {
    /// No value. Outputs nothing, is false in conditions and is what a missing name gives when `strict` is off.
    Null
    /// A boolean. Output as `true` or `false`.
    Bool(bool)
    /// A 64-bit integer.
    Int(i64)
    /// A 64-bit float.
    Float(f64)
    /// Text that is escaped on output according to `Options.escape`.
    Str(str)
    /// Text that is already safe and is written unescaped.
    /// The `raw` filter produces it, and `upper`, `lower` and `trim` keep it.
    Safe(str)
    /// A list of values, indexed from 0.
    List([]Data)
    /// A map from string keys to values.
    Map([str: Data])
}

enum FrameKind {
    Items
    Entries
    Wrapper
}

struct Frame {
    kind: FrameKind
    items: []Data
    entries: [str: Data]
    key: str
}

struct Build {
    frames: []*Frame
    result: Data
}

fn open_frame(b: *Build, kind: FrameKind, key: str) {
    let entries: [str: Data] = [:]
    push(mut b.frames, new(Frame { kind, items: [], entries, key }))
}

fn close_frame(b: *Build) -> Frame {
    let last = b.frames.len - 1
    let f = b.frames[last]
    b.frames = b.frames[..last]
    *f
}

fn deliver(b: *Build, v: Data) {
    if b.frames.len == 0 {
        b.result = v
        return
    }
    let f = b.frames[b.frames.len - 1]
    match f.kind {
        Entries => {
            f.entries[f.key] = v
        }
        _ => push(mut f.items, v)
    }
}

fn close_list(b: *Build) {
    let f = close_frame(b)
    deliver(b, List(f.items))
}

fn close_map(b: *Build) {
    let f = close_frame(b)
    deliver(b, Map(f.entries))
}

fn close_wrapper(b: *Build) {
    let f = close_frame(b)
    var payload: Data = Null
    if f.items.len > 0 {
        payload = f.items[0]
    }
    let entries: [str: Data] = [f.key: payload]
    deliver(b, Map(entries))
}

fn set_key(b: *Build, key: str) {
    b.frames[b.frames.len - 1].key = key
}

fn events(b: *Build) -> serde.Writer {
    serde.Writer {
        null: fn() { deliver(b, Null) }
        boolean: fn(v) { deliver(b, Bool(v)) }
        integer: fn(n) { deliver(b, Int(n)) }
        unsigned: fn(n) {
            if n > 0x7FFFFFFFFFFFFFFF {
                deliver(b, Float(f64(n)))
            } else {
                deliver(b, Int(i64(n)))
            }
        }
        float: fn(x) { deliver(b, Float(x)) }
        text: fn(s) { deliver(b, Str(s)) }
        binary: fn(data) { deliver(b, Str(base64.encode(data))) }
        begin_seq: fn(n) { open_frame(b, Items, "") }
        end_seq: fn() { close_list(b) }
        begin_map: fn(n) { open_frame(b, Entries, "") }
        key: fn(k) { set_key(b, k) }
        end_map: fn() { close_map(b) }
        begin_struct: fn(name, n) { open_frame(b, Entries, "") }
        field: fn(name) { set_key(b, name) }
        end_struct: fn() { close_map(b) }
        unit_variant: fn(e, v) { deliver(b, Str(v)) }
        begin_variant: fn(e, v, n) { open_frame(b, Wrapper, v) }
        end_variant: fn() { close_wrapper(b) }
    }
}

/// Converts any serialisable value `v` into `Data`.
/// Structs and maps become `Map`, sequences become `List`, an enum variant without a payload becomes the `Str` of its name and one with a payload becomes a `Map` with the variant name as its only key. Byte strings become base64 `Str` and an unsigned integer above the `i64` range becomes a `Float`.
pub fn to_data[T](v: T) -> Data {
    let b = new(Build { frames: [], result: Null })
    serde.write(v, events(b))
    b.result
}

/// Parses the JSON text `source` into `Data`.
/// Objects become `Map`, arrays `List` and numbers `Int` or `Float`. Fails with a `serde.Error` when `source` is not valid JSON.
pub fn from_json(source: str) -> Data ! serde.Error {
    let value = json.parse(bytes(source))?
    convert(value)
}

fn convert(v: json.Value) -> Data {
    match v {
        Null => Null
        Bool(b) => Bool(b)
        Int(n) => Int(n)
        Float(x) => Float(x)
        Str(s) => Str(s)
        Array(items) => {
            var out: []Data = []
            for item in items {
                push(mut out, convert(item))
            }
            List(out)
        }
        Object(members) => {
            let entries: [str: Data] = [:]
            for m in members {
                entries[m.name] = convert(m.value)
            }
            Map(entries)
        }
    }
}

/// Returns the `Data` list of `items`.
pub fn list(items: []Data) -> Data {
    List(items)
}

/// Returns the `Data` map of `entries`.
pub fn map(entries: [str: Data]) -> Data {
    Map(entries)
}

fn kind_name(d: Data) -> str {
    match d {
        Null => "null"
        Bool(_) => "bool"
        Int(_) => "int"
        Float(_) => "float"
        Str(_) => "string"
        Safe(_) => "string"
        List(_) => "list"
        Map(_) => "map"
    }
}

fn truthy(d: Data) -> bool {
    match d {
        Null => false
        Bool(b) => b
        Int(n) => n != 0
        Float(x) => x != 0.0
        Str(s) => s.len > 0
        Safe(s) => s.len > 0
        List(items) => items.len > 0
        Map(entries) => entries.len > 0
    }
}

fn as_float(d: Data) -> f64? {
    match d {
        Int(n) => f64(n)
        Float(x) => x
        _ => none
    }
}

fn as_text(d: Data) -> str? {
    match d {
        Str(s) => s
        Safe(s) => s
        _ => none
    }
}

fn equal(a: Data, b: Data) -> bool {
    match a {
        Null => match b {
            Null => true
            _ => false
        }
        Bool(x) => match b {
            Bool(y) => x == y
            _ => false
        }
        Int(x) => match b {
            Int(y) => x == y
            Float(y) => f64(x) == y
            _ => false
        }
        Float(x) => match as_float(b) {
            some(y) => x == y
            none => false
        }
        Str(x) => match as_text(b) {
            some(y) => x == y
            none => false
        }
        Safe(x) => match as_text(b) {
            some(y) => x == y
            none => false
        }
        List(x) => match b {
            List(y) => equal_lists(x, y)
            _ => false
        }
        Map(x) => match b {
            Map(y) => equal_maps(x, y)
            _ => false
        }
    }
}

fn equal_lists(a: []Data, b: []Data) -> bool {
    if a.len != b.len {
        return false
    }
    for i, item in a {
        if !equal(item, b[i]) {
            return false
        }
    }
    true
}

fn equal_maps(a: [str: Data], b: [str: Data]) -> bool {
    if a.len != b.len {
        return false
    }
    for k, v in a {
        match b[k] {
            some(other) => {
                if !equal(v, other) {
                    return false
                }
            }
            none => return false
        }
    }
    true
}

fn rank[T: Ord](x: T, y: T) -> i64 {
    if x < y {
        return -1
    }
    if x > y {
        return 1
    }
    0
}

fn order(a: Data, b: Data) -> i64? {
    match as_text(a) {
        some(x) => match as_text(b) {
            some(y) => return rank(x, y)
            none => return none
        }
        none => {}
    }
    match a {
        Int(x) => match b {
            Int(y) => return rank(x, y)
            _ => {}
        }
        _ => {}
    }
    match as_float(a) {
        some(x) => match as_float(b) {
            some(y) => rank(x, y)
            none => none
        }
        none => none
    }
}
