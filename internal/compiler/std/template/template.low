import std/io

pub enum Escape {
    Html
    None
}

pub enum Error {
    Parse(template: str, line: i64, column: i64, message: str)
    Render(template: str, line: i64, column: i64, message: str)
    NotFound(template: str, line: i64, column: i64, name: str)
    TooDeep(template: str, line: i64, column: i64)
    TooLarge
    Write(cause: io.Error)
}

pub enum FilterError {
    Invalid(message: str)
}

pub struct Options {
    pub escape: Escape = Html
    pub strict: bool = false
    pub max_depth: i64 = 32
    pub max_output: i64 = 16777216
}

pub struct Set {
    options: Options
    templates: [str: *Template]
    filters: [str: fn(Data, []Data) -> Data ! FilterError]
}

pub fn set(options: Options) -> Set {
    let templates: [str: *Template] = [:]
    let filters: [str: fn(Data, []Data) -> Data ! FilterError] = [:]
    Set { options, templates, filters }
}

pub fn add(mut s: Set, name: str, source: str) ! Error {
    let t = compile(name, source)?
    s.templates[name] = new(t)
}

pub fn add_filter(mut s: Set, name: str, f: fn(Data, []Data) -> Data ! FilterError) {
    s.filters[name] = f
}

pub fn has(s: Set, name: str) -> bool {
    match s.templates[name] {
        some(_) => true
        none => false
    }
}

pub fn describe(e: Error) -> str {
    match e {
        Parse(template, line, column, message) => "{template}:{line}:{column}: {message}"
        Render(template, line, column, message) => "{template}:{line}:{column}: {message}"
        NotFound(template, line, column, name) => {
            if line == 0 {
                return "template {name} not found"
            }
            "{template}:{line}:{column}: template {name} not found"
        }
        TooDeep(template, line, column) => "{template}:{line}:{column}: templates are nested too deeply"
        TooLarge => "output is too large"
        Write(_) => "write failed"
    }
}

pub fn render(s: Set, name: str, data: Data) -> str ! Error {
    let c = start(s, data, none)
    render_named(c, name)?
    __str_view(c.out)
}

pub fn render_to(s: Set, name: str, data: Data, out: io.Stream) ! Error {
    let c = start(s, data, out)
    render_named(c, name)?
    flush(c)?
}

pub fn render_source(source: str, data: Data) -> str ! Error {
    var s = set(Options {})
    s.add("source", source)?
    s.render("source", data)?
}
