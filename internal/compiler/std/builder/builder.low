/// A growable byte buffer for assembling text and binary data without the cost of repeated string concatenation.
/// A `Builder` is passed as `mut`. The buffer doubles when it fills. Obtain one from `builder` or `with_capacity`.
pub struct Builder {
    buf: []u8
    used: i64
}

/// Returns an empty `Builder` with no storage allocated.
pub fn builder() -> Builder {
    Builder { buf: [], used: 0 }
}

/// Returns an empty `Builder` with room for `n` bytes allocated.
pub fn with_capacity(n: i64) -> Builder {
    Builder { buf: __make(n), used: 0 }
}

fn extend(mut b: Builder, n: i64) -> i64 {
    let start = b.used
    let needed = start + n
    if needed > b.buf.len {
        let doubled = 2 * b.buf.len + 8
        let grown: []u8 = __make(if doubled > needed { doubled } else { needed })
        __memmove(grown, b.buf[..start])
        b.buf = grown
    }
    b.used = needed
    start
}

/// Ensures `b` can take `n` more bytes without growing, leaving its length unchanged.
pub fn reserve(mut b: Builder, n: i64) {
    let used = b.used
    extend(mut b, n)
    b.used = used
}

/// Appends the bytes of `s`.
pub fn write(mut b: Builder, s: str) {
    let start = extend(mut b, s.len)
    __memmove(b.buf[start..], s)
}

/// Appends the bytes of `data`.
pub fn write_bytes(mut b: Builder, data: []u8) {
    let start = extend(mut b, data.len)
    __memmove(b.buf[start..], data)
}

/// Appends the single byte `c`.
pub fn write_byte(mut b: Builder, c: u8) {
    let start = extend(mut b, 1)
    b.buf[start] = c
}

fn encoded_size(c: u32) -> i64 {
    if c < 0x80 {
        1
    } else if c < 0x800 {
        2
    } else if c < 0x10000 {
        3
    } else {
        4
    }
}

/// Appends the UTF-8 encoding of the code point `c`, one to four bytes.
/// The value is not validated: surrogates are encoded as they stand and a value above `0x1FFFFF` gives a malformed byte sequence.
pub fn write_char(mut b: Builder, c: u32) {
    let size = encoded_size(c)
    let start = extend(mut b, size)
    if size == 1 {
        b.buf[start] = u8(c)
        return
    }
    let lead: u32 = 0xFF00 >> size & 0xFF
    b.buf[start] = u8(lead | (c >> (6 * (size - 1))))
    for k in 1..size {
        b.buf[start + k] = u8(0x80 | ((c >> (6 * (size - 1 - k))) & 0x3F))
    }
}

/// Appends `n` in decimal, with a leading `-` when negative.
pub fn write_i64(mut b: Builder, n: i64) {
    var magnitude = u64(n)
    var sign = 0
    if n < 0 {
        magnitude = 0 - magnitude
        sign = 1
    }
    var count = 1
    var rest = magnitude
    for rest >= 10 {
        rest /= 10
        count += 1
    }
    let start = extend(mut b, count + sign)
    if sign == 1 {
        b.buf[start] = '-'
    }
    var at = start + sign + count - 1
    rest = magnitude
    for at >= start + sign {
        let q = rest / 10
        b.buf[at] = u8(rest - q * 10) + '0'
        rest = q
        at -= 1
    }
}

/// Appends `x` in the text form string interpolation gives an `f64`.
pub fn write_f64(mut b: Builder, x: f64) {
    write(mut b, "{x}")
}

/// Appends `s` followed by a newline byte.
pub fn write_line(mut b: Builder, s: str) {
    write(mut b, s)
    write_byte(mut b, '\n')
}

/// Appends `s` `n` times. Nothing is appended when `n` is `0` or negative.
pub fn write_repeat(mut b: Builder, s: str, n: i64) {
    for _ in 0..n {
        write(mut b, s)
    }
}

/// Appends the strings in `parts` with `sep` between consecutive ones.
pub fn write_join(mut b: Builder, parts: []str, sep: str) {
    for i, part in parts {
        if i > 0 {
            write(mut b, sep)
        }
        write(mut b, part)
    }
}

/// Returns the number of bytes written.
pub fn len(b: Builder) -> i64 {
    b.used
}

/// Returns the number of bytes allocated, which is at least `len`.
pub fn capacity(b: Builder) -> i64 {
    b.buf.len
}

/// Shortens `b` to `n` bytes and keeps its allocation.
/// Nothing happens when `n` is negative or not below the current length.
pub fn truncate(mut b: Builder, n: i64) {
    if n >= 0 && n < b.used {
        b.used = n
    }
}

/// Empties `b` and keeps its allocation.
pub fn reset(mut b: Builder) {
    b.used = 0
}

/// Returns a copy of the written bytes as a `str`.
pub fn to_str(b: Builder) -> str {
    str(b.buf[..b.used])
}

/// Returns the written bytes as a `[]u8` that shares storage with `b`.
/// The slice is not a copy: writes made after `reset` or `truncate` overwrite the bytes it holds.
pub fn to_bytes(b: Builder) -> []u8 {
    b.buf[..b.used]
}
