struct Seen {
    globals: i64
    compositor: bool
    wm_base: bool
    shm: u32
    formats: i64
}

fn on_global(data: ptr, registry: ptr, name: u32, interface: ptr[u8], version: u32) {
    let p: ptr[Seen] = data
    var seen = load(p)
    seen.globals += 1
    let iface = str(interface)
    if iface == "wl_compositor" {
        seen.compositor = true
    }
    if iface == "xdg_wm_base" {
        seen.wm_base = true
    }
    if iface == "wl_shm" {
        seen.shm = name
    }
    store(p, seen)
}

fn on_format(data: ptr, shm: ptr, format: u32) {
    let p: ptr[Seen] = data
    var seen = load(p)
    seen.formats += 1
    store(p, seen)
}

fn main() {
    let ifs = interfaces()
    let display = wl_display_connect(null)
    if display == null {
        print("no display")
        release_interfaces(ifs)
        return
    }
    let registry = wl_display_get_registry(ifs, display)
    let data = pin(new(Seen { globals: 0, compositor: false, wm_base: false, shm: 0, formats: 0 }))
    let seen: ptr[Seen] = data
    wl_registry_add_listener(ifs, registry, WlRegistryListener { global: on_global }, data)
    wl_display_roundtrip(display)
    let found = load(seen)
    print(found.globals > 0)
    print(found.compositor)
    print(found.wm_base)
    let shm = wl_registry_bind(registry, found.shm, ifs.wl_shm, 1)
    wl_shm_add_listener(ifs, shm, WlShmListener { format: on_format }, data)
    wl_display_roundtrip(display)
    print(load(seen).formats > 0)
    print(wl_proxy_get_version(shm))
    wl_shm_destroy(shm)
    wl_registry_destroy(registry)
    wl_display_disconnect(display)
    release_interfaces(ifs)
    unpin(data)
}
