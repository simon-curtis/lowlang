import std/time

extern "xkbcommon" {
    fn xkb_keymap_new_from_names(context: ptr, names: ptr, flags: i32) -> ptr
}

fn named_name(k: NamedKey) -> str {
    match k {
        Enter => "Enter"
        Escape => "Escape"
        Tab => "Tab"
        Backspace => "Backspace"
        Delete => "Delete"
        Left => "Left"
        Right => "Right"
        Up => "Up"
        Down => "Down"
        Home => "Home"
        End => "End"
        PageUp => "PageUp"
        PageDown => "PageDown"
        Function(number) => "F{number}"
    }
}

fn key_name(k: Key) -> str {
    match k {
        Named(n) => named_name(n)
        Character(text) => "char:{text}"
    }
}

fn button_name(b: Button) -> str {
    match b {
        Left => "left"
        Right => "right"
        Middle => "middle"
        Other(code) => "other:{code}"
    }
}

fn modifier_flags(m: Modifiers) -> str {
    var flags = ""
    if m.shift {
        flags = "{flags}S"
    }
    if m.control {
        flags = "{flags}C"
    }
    if m.alt {
        flags = "{flags}A"
    }
    if m.super {
        flags = "{flags}U"
    }
    flags
}

fn show(e: Event) -> str {
    match e {
        Resized(width, height, scale) => "resized {width} {height} {scale}"
        CloseRequested => "close"
        PointerMoved(x, y) => "moved {x} {y}"
        PointerLeft => "left"
        PointerDown(button, x, y) => "down {button_name(button)} {x} {y}"
        PointerUp(button, x, y) => "up {button_name(button)} {x} {y}"
        Scrolled(dx, dy) => "scrolled {dx} {dy}"
        Key(k) => "key {key_name(k.key)} text=[{k.text}] mods=[{modifier_flags(k.modifiers)}] pressed={k.pressed} repeat={k.repeat}"
        ModifiersChanged(m) => "modifiers [{modifier_flags(m)}]"
        Preedit(text, cursor) => "preedit [{text}] {cursor_text(cursor)}"
        Commit(text) => "commit [{text}]"
        DecorationsChanged(drawn) => "decorations {drawn}"
        StatusChanged(st) => "status maximized {st.maximized} fullscreen {st.fullscreen} tiled {st.tiled}"
        FocusChanged(focused) => "focus {focused}"
        Woken => "woken"
    }
}

fn cursor_text(cursor: TextRange?) -> str {
    match cursor {
        some(c) => "{c.start}-{c.end}"
        none => "hidden"
    }
}

fn drain(label: str, s: *WindowState) {
    let events = take_events(s)
    if events.len == 0 {
        print("{label}: none")
    }
    for e in events {
        print("{label}: {show(e)}")
    }
}

fn press(s: *WindowState, label: str, code: u32) {
    on_key(s.handle, null, 0, 0, code, wl_keyboard_key_state_pressed())
    drain(label, s)
}

fn release(s: *WindowState, label: str, code: u32) {
    on_key(s.handle, null, 0, 0, code, wl_keyboard_key_state_released())
    drain(label, s)
}

fn hold(s: *WindowState, depressed: u32) {
    on_modifiers(s.handle, null, 0, depressed, 0, 0, 0)
    drain("hold {depressed}", s)
}

fn fixture() -> *WindowState ! Error {
    let ifs = interfaces()
    let waker = new(WakerState { signal: chan[bool](1) })
    let s = new(WindowState { ifs, arm: chan[bool](1), ready: chan[bool](1), done: chan[bool](1), waker, width: 320, height: 200 })
    s.handle = pin(new(Handle { state: s }))
    start_keys(s)?
    let keymap = xkb_keymap_new_from_names(s.keys.context, null, 0)
    if keymap == null {
        fail Failed("xkb_keymap_new_from_names", 0)
    }
    s.keys.keymap = keymap
    s.keys.state = xkb_state_new(keymap)
    s
}

fn keys(s: *WindowState) {
    press(s, "a", 30)
    release(s, "a", 30)
    hold(s, 1)
    press(s, "shift a", 30)
    press(s, "shift 1", 2)
    press(s, "shift tab", 15)
    hold(s, 4)
    press(s, "control a", 30)
    hold(s, 8)
    press(s, "alt a", 30)
    hold(s, 64)
    press(s, "super a", 30)
    hold(s, 0)
    press(s, "left shift", 42)
    press(s, "space", 57)
    press(s, "enter", 28)
    press(s, "keypad enter", 96)
    press(s, "escape", 1)
    press(s, "tab", 15)
    press(s, "backspace", 14)
    press(s, "delete", 111)
    press(s, "left", 105)
    press(s, "right", 106)
    press(s, "up", 103)
    press(s, "down", 108)
    press(s, "home", 102)
    press(s, "end", 107)
    press(s, "page up", 104)
    press(s, "page down", 109)
    press(s, "f1", 59)
    press(s, "f12", 88)
    press(s, "keypad 1 without numlock", 79)
    on_modifiers(s.handle, null, 0, 0, 0, 16, 0)
    drain("numlock", s)
    press(s, "keypad 1 with numlock", 79)
    hold(s, 0)
}

fn repeating(s: *WindowState) {
    on_repeat_info(s.handle, null, 50, 120)
    press(s, "held", 30)
    emit_repeat(s)
    drain("held early", s)
    sleep(160)
    emit_repeat(s)
    drain("held late", s)
    release(s, "held", 30)
    sleep(40)
    emit_repeat(s)
    drain("released", s)
    press(s, "modifier", 42)
    sleep(160)
    emit_repeat(s)
    drain("modifier held", s)
    on_repeat_info(s.handle, null, 0, 120)
    press(s, "disabled", 30)
    sleep(160)
    emit_repeat(s)
    drain("disabled held", s)
}

fn pointer(s: *WindowState) {
    on_pointer_enter(s.handle, null, 0, null, 2560, 5120)
    drain("enter", s)
    on_pointer_motion(s.handle, null, 0, 2688, 5248)
    drain("motion", s)
    on_pointer_button(s.handle, null, 0, 0, 272, wl_pointer_button_state_pressed())
    drain("press", s)
    on_pointer_button(s.handle, null, 0, 0, 273, wl_pointer_button_state_released())
    drain("release", s)
    on_pointer_button(s.handle, null, 0, 0, 274, wl_pointer_button_state_pressed())
    drain("middle", s)
    on_pointer_button(s.handle, null, 0, 0, 275, wl_pointer_button_state_pressed())
    drain("side", s)
    on_pointer_axis(s.handle, null, 0, wl_pointer_axis_vertical_scroll(), 2560)
    drain("vertical", s)
    on_pointer_axis(s.handle, null, 0, wl_pointer_axis_horizontal_scroll(), -1280)
    drain("horizontal", s)
    on_pointer_leave(s.handle, null, 0, null)
    drain("leave", s)
    on_keyboard_enter(s.handle, null, 0, null, null)
    drain("focus", s)
    on_keyboard_leave(s.handle, null, 0, null)
    drain("blur", s)
    on_toplevel_close(s.handle, null)
    drain("close", s)
}

fn composing(s: *WindowState) {
    on_preedit_string(s.handle, null, cstr("ka"), 2, 2)
    drain("preedit before done", s)
    on_text_done(s.handle, null, 1)
    drain("preedit", s)
    on_preedit_string(s.handle, null, cstr("かな"), 0, 6)
    on_text_done(s.handle, null, 2)
    drain("preedit selected", s)
    on_commit_string(s.handle, null, cstr("仮名"))
    on_text_done(s.handle, null, 3)
    drain("commit", s)
    on_commit_string(s.handle, null, cstr("x"))
    on_text_done(s.handle, null, 4)
    drain("commit alone", s)
    on_preedit_string(s.handle, null, null, -1, -1)
    on_text_done(s.handle, null, 5)
    drain("empty done", s)
    on_preedit_string(s.handle, null, cstr("a"), -1, -1)
    on_text_done(s.handle, null, 6)
    drain("hidden cursor", s)
    on_text_leave(s.handle, null, null)
    drain("leave", s)
    set_window_text_input(s, some(Caret { x: 1, y: 2, width: 0, height: 16 }))
    print("caret kept {s.caret == some(Caret { x: 1, y: 2, width: 0, height: 16 })} enabled {s.text_enabled}")
}

fn configure_with(s: *WindowState, label: str, states: []u32) {
    let words: ptr[u32] = malloc(4 * states.len + 4)
    let slots = view(words, states.len)
    for i, state in states {
        slots[i] = state
    }
    let array: ptr[WlArray] = malloc(24)
    store(array, WlArray { size: u64(4 * states.len), alloc: u64(4 * states.len), data: words })
    on_toplevel_configure(s.handle, null, 640, 480, array)
    apply_configure(s)
    drain(label, s)
    free(array)
    free(words)
}

fn managing(s: *WindowState) {
    on_decoration_configure(s.handle, null, zxdg_toplevel_decoration_v1_mode_client_side())
    drain("client side", s)
    on_decoration_configure(s.handle, null, zxdg_toplevel_decoration_v1_mode_client_side())
    drain("client side again", s)
    on_decoration_configure(s.handle, null, zxdg_toplevel_decoration_v1_mode_server_side())
    drain("server side", s)
    configure_with(s, "maximized", [xdg_toplevel_state_activated(), xdg_toplevel_state_maximized()])
    configure_with(s, "still maximized", [xdg_toplevel_state_maximized()])
    configure_with(s, "tiled", [xdg_toplevel_state_tiled_left(), xdg_toplevel_state_tiled_top()])
    configure_with(s, "fullscreen", [xdg_toplevel_state_fullscreen()])
    configure_with(s, "floating", [])
    print("status {s.status == WindowStatus {}} decorations {window_decorations(s)}")
    start_window_move(s)
    start_window_resize(s, BottomRight)
    show_menu(s, 3.0, 4.0)
    set_window_maximized(s, true)
    set_window_fullscreen(s, true)
    minimize_window(s)
    set_window_title(s, "t")
    drain("without a toplevel", s)
}

fn sizes(s: *WindowState) {
    s.requested_width = 320
    apply_configure(s)
    drain("first configure", s)
    s.pending_width = 640
    s.pending_height = 480
    apply_configure(s)
    drain("resized", s)
    apply_configure(s)
    drain("repeated", s)
    s.pending_width = 0
    s.pending_height = 0
    apply_configure(s)
    drain("zero keeps the size", s)
    print("scale changed {apply_scale(s, 2.0)}")
    drain("scale 2", s)
    print("scale changed {apply_scale(s, 2.0)}")
    drain("scale 2 again", s)
    print("scale changed {apply_scale(s, 0.0)}")
    drain("scale 0", s)
    on_fractional_scale(s.handle, null, 150)
    drain("fraction 150", s)
    on_fractional_scale(s.handle, null, 120)
    drain("fraction 120", s)
}

fn main() {
    let s = fixture() or {
        print("no keymap")
        return
    }
    keys(s)
    repeating(s)
    pointer(s)
    composing(s)
    sizes(s)
    managing(s)
    stop_keys(s)
    unpin(s.handle)
}
