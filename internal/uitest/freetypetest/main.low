import std/file
import std/os
import std/text
import std/ui/font

const offset: u64 = 14695981039346656037
const prime: u64 = 1099511628211

struct Case {
    mode: str
    size: str
    phase: str
    pixel_size: f32
    pen_x: f32
}

fn fold(h: u64, v: i64) -> u64 {
    (h ^ u64(v)) * prime
}

fn stop(message: str) {
    print(message)
    os.exit(2)
}

fn open(path: str) -> font.Font {
    let data = file.read_text(path) catch {
        e => {
            stop("unreadable {path}")
            return font.Font {}
        }
    }
    font.parse(data) catch {
        e => {
            stop("failed {path} {e}")
            return font.Font {}
        }
    }
}

fn number(s: str) -> i64 {
    text.parse_int(s) catch {
        e => {
            stop("bad number {s}")
            return 0
        }
    }
}

fn read_case(args: []str, at: i64) -> Case {
    let mode = args[at]
    if mode != "unhinted" {
        stop("unsupported mode {mode}")
    }
    let size = number(args[at + 1])
    let phase = number(args[at + 2])
    if size <= 0 || phase < 0 || phase > 3 {
        stop("bad case {args[at]} {args[at + 1]} {args[at + 2]}")
    }
    let pixel_size = f32(size) / 64.0
    let pen_x = f32(phase) / 4.0
    Case { mode, size: args[at + 1], phase: args[at + 2], pixel_size, pen_x }
}

fn render(f: font.Font, c: Case, detail: bool) {
    var h = offset
    for g in 0..f.glyph_count {
        let b = f.rasterize_at(g, c.pixel_size, c.pen_x)
        let header = [b.width, b.height, b.left, b.top]
        var own = offset
        for v in header {
            h = fold(h, v)
            own = fold(own, v)
        }
        for v in b.coverage {
            h = fold(h, i64(v))
            own = fold(own, i64(v))
        }
        if detail {
            print("{c.mode} {c.size} {c.phase} {g} {b.width} {b.height} {b.left} {b.top} {own:x16}")
        }
    }
    if !detail {
        print("{c.mode} {c.size} {c.phase} {h:x16}")
    }
}

fn main() {
    let args = os.args()
    var at = 1
    var detail = false
    if args.len > 1 && args[1] == "-glyphs" {
        detail = true
        at = 2
    }
    if args.len < at + 4 || (args.len - at - 1) % 3 != 0 {
        stop("usage: freetypetest [-glyphs] <font> (<mode> <size 26.6> <phase>)...")
    }
    let f = open(args[at])
    print("freetype 2.15.0")
    var i = at + 1
    for i + 2 < args.len {
        let c = read_case(args, i)
        render(f, c, detail)
        i += 3
    }
}
