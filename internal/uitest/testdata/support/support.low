import std/ui/gpu

pub fn show(name: str, image: []u8, width: i64) {
    let height = image.len / (width * 4)
    print("image {name} {width} {height}")
    for y in 0..height {
        let from = y * width * 4
        print(image[from..from + width * 4])
    }
}

pub fn snapshot(g: gpu.Gpu, t: gpu.Target, name: str) ! gpu.Error {
    let image = gpu.read(g, t)?
    show(name, image, t.width)
}

pub fn guard(body: fn() ! gpu.Error) ! gpu.Error {
    body() catch {
        NoDevice => {
            print("no device")
        }
        e => {
            print("error: {gpu.describe(e)}")
            fail e
        }
    }
}
