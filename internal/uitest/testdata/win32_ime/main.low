import std/ui/platform
import win32support

extern "imm32" {
    fn ImmGetContext(hwnd: ptr) -> ptr
    fn ImmReleaseContext(hwnd: ptr, himc: ptr) -> i32
    fn ImmSetCompositionStringW(himc: ptr, index: u32, composition: ptr, composition_length: u32, read: ptr, read_length: u32) -> i32
    fn ImmNotifyIME(himc: ptr, action: u32, index: u32, value: u32) -> i32
}

fn context_on(w: platform.Window) -> bool {
    let hwnd = platform.native(w).window
    let himc = ImmGetContext(hwnd)
    if himc == null {
        return false
    }
    ImmReleaseContext(hwnd, himc)
    true
}

fn compose(w: platform.Window, units: []u16) {
    let hwnd = platform.native(w).window
    let himc = ImmGetContext(hwnd)
    if himc == null {
        print("no context")
        return
    }
    let at: ptr[u16] = pin(units)
    ImmSetCompositionStringW(himc, 0x9, at, u32(2 * units.len), null, 0)
    unpin(at)
    ImmReleaseContext(hwnd, himc)
    win32support.send(w, 0x10D, 0, 0)
    win32support.send(w, 0x10F, 0, 0x88)
}

fn complete(w: platform.Window) {
    let hwnd = platform.native(w).window
    let himc = ImmGetContext(hwnd)
    if himc == null {
        print("no context")
        return
    }
    ImmNotifyIME(himc, 0x15, 0x1, 0)
    ImmReleaseContext(hwnd, himc)
}

fn once() ! platform.Error {
    using w = platform.open(platform.Options { title: "ime", width: 320, height: 200 })?
    win32support.ready(w)?
    print("start {context_on(w)}")

    platform.set_text_input(w, some(platform.Caret { x: 10, y: 20, width: 2, height: 16 }))
    print("on {context_on(w)}")
    platform.set_text_input(w, some(platform.Caret { x: 12, y: 40, width: 2, height: 16 }))
    print("moved {context_on(w)}")
    platform.set_text_input(w, none)
    print("off {context_on(w)}")
    platform.set_text_input(w, none)
    platform.set_text_input(w, some(platform.Caret { x: 1, y: 2, width: 3, height: 4 }))
    print("on again {context_on(w)}")
    win32support.show(platform.next(w, 100)?)

    win32support.send(w, 0x10E, 0, 0)
    win32support.show(platform.next(w, 100)?)

    win32support.send(w, 0x10D, 0, 0)
    win32support.send(w, 0x10F, 0, 0x8)
    win32support.send(w, 0x10F, 0, 0x800)
    win32support.send(w, 0x10E, 0, 0)
    win32support.show(platform.next(w, 100)?)

    compose(w, [0x61, 0xD83D, 0xDE00, 0xE9])
    win32support.show(platform.next(w, 100)?)
    win32support.send(w, 0x10E, 0, 0)
    win32support.send(w, 0x10E, 0, 0)
    win32support.show(platform.next(w, 100)?)

    compose(w, [0x62, 0x63])
    win32support.show(platform.next(w, 100)?)
    complete(w)
    win32support.send(w, 0x10F, 0, 0x808)
    win32support.send(w, 0x10E, 0, 0)
    win32support.show(platform.next(w, 100)?)

    compose(w, [0x64])
    win32support.show(platform.next(w, 100)?)
    platform.set_text_input(w, none)
    print("off {context_on(w)}")
    win32support.show(platform.next(w, 100)?)

    win32support.post(w, 0x100, 0xE5, 0x1E0001)
    win32support.post(w, 0x101, 0xE5, 0xC01E0001)
    win32support.show(platform.next(w, 100)?)
}

fn main() {
    win32support.guard(once)
}
