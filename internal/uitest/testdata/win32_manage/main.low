import std/ui/platform
import win32support

extern "user32" {
    fn GetClientRect(hwnd: ptr, mut rect: Rect) -> i32
    fn GetSystemMetrics(index: i32) -> i32
    fn GetWindowTextW(hwnd: ptr, text: ptr, size: i32) -> i32
    fn IsIconic(hwnd: ptr) -> i32
    fn GetWindowRect(hwnd: ptr, mut rect: Rect) -> i32
    fn SendMessageW(hwnd: ptr, msg: u32, wparam: i64, lparam: i64) -> i64
}

extern "kernel32" {
    fn WideCharToMultiByte(page: u32, flags: u32, wide: ptr, chars: i32, text: ptr, n: i32, fallback: ptr, used: ptr) -> i32
}

extern struct Rect {
    left: i32 = 0
    top: i32 = 0
    right: i32 = 0
    bottom: i32 = 0
}

fn client_width(w: platform.Window) -> i32 {
    var client = Rect {}
    GetClientRect(platform.native(w).window, mut client)
    client.right - client.left
}

fn statuses(events: []platform.Event) {
    var seen = 0
    for e in events {
        match e {
            StatusChanged(status) => {
                print(win32support.describe(e))
                seen += 1
            }
            _ => {}
        }
    }
    if seen == 0 {
        print("no status")
    }
}

fn agrees(w: platform.Window, maximized: bool, fullscreen: bool) -> bool {
    let status = platform.status(w)
    status.maximized == maximized && status.fullscreen == fullscreen && !status.tiled
}

fn title_of(w: platform.Window) -> str {
    var units: []u16 = []
    var bytes: []u8 = []
    for i in 0..64 {
        units.push(0)
        bytes.push(0)
    }
    let wide: ptr[u16] = pin(units)
    let text: ptr[u8] = pin(bytes)
    let n = GetWindowTextW(platform.native(w).window, wide, 64)
    let used = WideCharToMultiByte(65001, 0, wide, n, text, 64, null, null)
    unpin(wide)
    unpin(text)
    str(bytes[..i64(used)])
}

fn once() ! platform.Error {
    using w = platform.open(platform.Options { title: "manage", width: 320, height: 200 })?
    win32support.ready(w)?
    let base = client_width(w)
    let c = platform.controls(w)

    print("decorations {win32support.decorations_name(platform.decorations(w))}")
    print("initial {agrees(w, false, false)}")

    platform.set_maximized(c, true)
    statuses(platform.next(w, 1000)?)
    print("maximized agrees {agrees(w, true, false)}")
    print("maximized grew {client_width(w) > base}")

    platform.set_maximized(c, false)
    statuses(platform.next(w, 1000)?)
    print("restored agrees {agrees(w, false, false)}")
    print("restored size {client_width(w) == base}")

    platform.set_fullscreen(c, true)
    statuses(platform.next(w, 1000)?)
    print("fullscreen agrees {agrees(w, false, true)}")
    print("fullscreen width {client_width(w) == GetSystemMetrics(0)}")

    platform.set_fullscreen(c, true)
    statuses(platform.next(w, 300)?)

    platform.set_fullscreen(c, false)
    statuses(platform.next(w, 1000)?)
    print("windowed agrees {agrees(w, false, false)}")
    print("windowed size {client_width(w) == base}")

    platform.set_title(c, "名前")
    print("title {title_of(w)}")

    win32support.post(w, 0x202, 0, 0)
    platform.start_move(c)
    print("moved")
    win32support.post(w, 0x202, 0, 0)
    platform.start_resize(c, platform.ResizeEdge.BottomRight)
    print("resized")
    platform.next(w, 300)?

    platform.minimize(c)
    print("iconic {IsIconic(platform.native(w).window) != 0}")
}

fn hit(hwnd: ptr, x: i32, y: i32) -> i64 {
    SendMessageW(hwnd, 0x84, 0, (i64(y) << 16) | (i64(x) & 0xFFFF))
}

fn frameless() ! platform.Error {
    using w = platform.open(platform.Options { title: "frameless", width: 320, height: 200, decorations: Client })?
    win32support.ready(w)?
    print("frameless decorations {win32support.decorations_name(platform.decorations(w))}")
    let hwnd = platform.native(w).window
    var outer = Rect {}
    GetWindowRect(hwnd, mut outer)
    print("frameless fills {client_width(w) == outer.right - outer.left} width {client_width(w)}")
    print("corner {hit(hwnd, outer.right - 1, outer.bottom - 1)}")
    print("top {hit(hwnd, (outer.left + outer.right) / 2, outer.top)}")
    print("middle {hit(hwnd, (outer.left + outer.right) / 2, (outer.top + outer.bottom) / 2)}")
}

fn main() {
    win32support.guard(once)
    win32support.guard(frameless)
}
