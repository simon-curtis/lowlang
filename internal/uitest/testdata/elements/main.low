import std/ui
import std/ui/geometry
import std/ui/gpu
import support

fn tree() -> ui.Element {
    ui.div().column().padding(4.0).gap(4.0).background(ui.rgb(0x000000)).children() {
        ui.div().size(56.0, 12.0).background(ui.rgb(0xff0000)).border(2.0, ui.rgb(0x0000ff))
            .hover(fn(v: ui.Visual) -> ui.Visual { v.with_background(ui.rgb(0x00ff00)) })
        ui.div().size(16.0, 16.0).overflow_hidden().background(ui.rgb(0xffffff)).child(ui.div().size(40.0, 8.0).background(ui.rgb(0xff00ff)))
        ui.div().size(56.0, 20.0).background(ui.rgb(0x404040)).padding(2.0).child(ui.text("Hi").text_color(ui.rgb(0xffffff)).text_size(14.0))
    }
}

fn render() ! gpu.Error {
    using g = gpu.open()?
    using t = gpu.target(g, 64, 64)?
    let cx = ui.headless(ui.rgb(0x808080))
    let window = geometry.size(64.0, 64.0)
    let plain = cx.frame(tree, window, 1.0)
    cx.draw(g, t, plain)?
    support.snapshot(g, t, "plain")?
    cx.dispatch(PointerMoved(30.0, 10.0))
    let hovered = cx.frame(tree, window, 1.0)
    cx.draw(g, t, hovered)?
    support.snapshot(g, t, "hovered")?
}

fn main() ! gpu.Error {
    support.guard(render)?
}
