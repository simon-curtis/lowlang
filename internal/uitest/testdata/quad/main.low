import std/ui/gpu
import std/ui/scene
import std/ui/geometry
import support

fn render() ! gpu.Error {
    using g = gpu.open()?
    using t = gpu.target(g, 64, 64)?
    var atlas = scene.atlas(1024)

    var plain = scene.empty(64, 64, geometry.rgba(0x00000000))
    scene.push_quad(mut plain, scene.Quad { bounds: geometry.rect(8.0, 8.0, 20.0, 20.0), background: geometry.rgb(0xff0000) })
    let radii = geometry.Corners { top_left: 0.0, top_right: 12.0, bottom_right: 0.0, bottom_left: 12.0 }
    scene.push_quad(mut plain, scene.Quad { bounds: geometry.rect(32.0, 8.0, 24.0, 24.0), background: geometry.rgb(0x00ff00), corner_radii: radii })
    gpu.render(g, t, plain, mut atlas)?
    support.snapshot(g, t, "plain")?

    var bordered = scene.empty(64, 64, geometry.rgb(0x102030))
    let widths = geometry.Edges { top: 2.0, right: 4.0, bottom: 6.0, left: 8.0 }
    scene.push_quad(mut bordered, scene.Quad {
        bounds: geometry.rect(8.0, 8.0, 48.0, 40.0)
        background: geometry.rgb(0xffff00)
        border_color: geometry.rgb(0x0000ff)
        border_widths: widths
    })
    gpu.render(g, t, bordered, mut atlas)?
    support.snapshot(g, t, "bordered")?

    var rounded = scene.empty(64, 64, geometry.rgb(0xffffff))
    scene.push_quad(mut rounded, scene.Quad {
        bounds: geometry.rect(8.0, 8.0, 48.0, 48.0)
        background: geometry.rgb(0x00ff00)
        border_color: geometry.rgb(0x000000)
        corner_radii: geometry.corners(16.0)
        border_widths: geometry.edges(4.0)
    })
    gpu.render(g, t, rounded, mut atlas)?
    support.snapshot(g, t, "rounded")?

    var shaded = scene.empty(64, 64, geometry.rgb(0xffffff))
    let across = geometry.rect(0.0, 0.0, 64.0, 32.0)
    scene.push_quad(mut shaded, scene.Quad {
        bounds: across
        background: geometry.rgb(0xff0000)
        background_end: geometry.rgb(0x0000ff)
        gradient: scene.linear(across, 90.0, 0.0, 1.0)
    })
    let down = geometry.rect(0.0, 32.0, 64.0, 32.0)
    scene.push_quad(mut shaded, scene.Quad {
        bounds: down
        background: geometry.rgb(0x000000)
        background_end: geometry.rgb(0x00ff00)
        gradient: scene.linear(down, 180.0, 0.25, 0.75)
    })
    gpu.render(g, t, shaded, mut atlas)?
    support.snapshot(g, t, "shaded")?
}

fn main() ! gpu.Error {
    support.guard(render)?
}
