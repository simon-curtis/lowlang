import std/ui/geometry
import std/ui/gpu
import std/ui/platform
import std/ui/scene

enum Failure {
    Window(error: platform.Error)
    Graphics(error: gpu.Error)
}

fn frame(width: i64, height: i64, step: i64) -> scene.Scene {
    var s = scene.empty(width, height, geometry.rgb(0x203040))
    let shade = f32(step) / 8.0
    let color = geometry.Color { r: shade, g: 1.0 - shade, b: 0.5, a: 1.0 }
    scene.push_quad(mut s, scene.Quad { bounds: geometry.rect(4.0, 4.0, f32(width) - 8.0, f32(height) - 8.0), background: color, corner_radii: geometry.corners(8.0) })
    s
}

fn scale_of(events: []platform.Event, current: f32) -> f32 {
    var scale = current
    for e in events {
        match e {
            Resized(width, height, found) => {
                scale = found
            }
            _ => {}
        }
    }
    scale
}

fn device(logical: i64, scale: f32) -> i64 {
    i64(floor(f32(logical) * scale + 0.5))
}

fn show(g: gpu.Gpu, w: platform.Window, mut atlas: scene.Atlas, width: i64, height: i64, frames: i64) ! Failure {
    for step in 0..frames {
        let s = frame(width, height, step)
        gpu.present(g, s, mut atlas) catch Failure.Graphics
        platform.next(w, 0) catch Failure.Window
    }
}

fn offscreen(g: gpu.Gpu) ! gpu.Error {
    using t = gpu.target(g, 8, 8)?
    var atlas = scene.atlas(1024)
    var s = scene.empty(8, 8, geometry.rgb(0xff0000))
    gpu.render(g, t, s, mut atlas)?
    let pixels = gpu.read(g, t)?
    print("offscreen {pixels[0]} {pixels[1]} {pixels[2]} {pixels[3]}")
}

fn without_surface() ! gpu.Error {
    using g = gpu.open()?
    var atlas = scene.atlas(1024)
    let s = frame(16, 16, 0)
    gpu.present(g, s, mut atlas) catch {
        NoSurface => {
            print("no surface")
            return
        }
        e => fail e
    }
    print("presented without a surface")
}

fn run() ! Failure {
    using w = platform.open(platform.Options { title: "low wayland present", width: 320, height: 200 }) catch Failure.Window
    let first = platform.next(w, 5000) catch Failure.Window
    let scale = scale_of(first, 1.0)
    let width = device(320, scale)
    let height = device(200, scale)
    let native = platform.native(w)
    using g = gpu.open_for(gpu.Surface { display: native.display, window: native.window }) catch Failure.Graphics
    var atlas = scene.atlas(1024)
    show(g, w, mut atlas, width, height, 4)?
    print("first size")
    show(g, w, mut atlas, 400, 300, 3)?
    print("grown")
    show(g, w, mut atlas, 0, 0, 2)?
    show(g, w, mut atlas, 100, 0, 2)?
    print("empty")
    show(g, w, mut atlas, 200, 120, 3)?
    print("shrunk")
    show(g, w, mut atlas, width, height, 2)?
    print("restored")
    offscreen(g) catch Failure.Graphics
}

fn main() ! Failure {
    run() catch {
        Window(error) => {
            match error {
                NoDisplay(detail) => {
                    print("no display")
                    return
                }
                e => fail Failure.Window(e)
            }
        }
        Graphics(error) => {
            match error {
                NoDevice => {
                    print("no device")
                    return
                }
                e => fail Failure.Graphics(e)
            }
        }
    }
    without_surface() catch Failure.Graphics
}
