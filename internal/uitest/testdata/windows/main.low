import std/ui

struct Opened {
    cx: ui.Context
    count: ui.Signal[i64]
}

fn counter(count: ui.Signal[i64], color: u32) -> fn() -> ui.Element {
    fn() -> ui.Element {
        ui.div().padding(10.0).child(ui.div().size(40.0, 40.0).background(ui.rgb(color)).on_click(fn(e) count.set(count.get() + 1)))
    }
}

fn second(from: ui.Shared, opened: chan[Opened], finished: chan[str]) {
    let outcome = show_second(from, opened) catch {
        e => unavailable(e) ?? "right failed"
    }
    close(opened)
    finished <- outcome
}

fn show_second(from: ui.Shared, opened: chan[Opened]) -> str ! ui.Error {
    using window = ui.open_window(from, ui.Options { title: "right", width: 160, height: 100 })?
    let cx = window.cx
    let count = cx.signal(0)
    opened <- Opened { cx, count }
    window.run(counter(count, u32(0x0000ff)))?
    "right closed {cx.closed()} count {count.get()}"
}

fn click(o: Opened, times: i64) {
    let done: chan[bool] = chan[bool](1)
    o.cx.handle().post(fn() {
        for _ in 0..times {
            o.cx.dispatch(PointerDown(Left, 20.0, 20.0))
            o.cx.dispatch(PointerUp(Left, 20.0, 20.0))
        }
        done <- true
    })
    <-done
}

fn shut(o: Opened) {
    o.cx.handle().post(fn() o.cx.quit())
}

fn drive(left: Opened, opened: chan[Opened]) {
    let received = <-opened
    match received {
        some(right) => {
            sleep(200)
            click(left, 1)
            click(right, 2)
            shut(left)
            sleep(200)
            click(right, 1)
            shut(right)
        }
        none => shut(left)
    }
}

fn start() ! ui.Error {
    let finished: chan[str] = chan[str](1)
    let left = run_left(finished)?
    print("left closed {left.cx.closed()} count {left.count.get()}")
    let outcome = <-finished
    print(outcome ?? "right finished")
}

fn run_left(finished: chan[str]) -> Opened ! ui.Error {
    using app = ui.open(ui.Options { title: "left", width: 160, height: 100 })?
    let left = Opened { cx: app.cx, count: app.cx.signal(0) }
    let opened: chan[Opened] = chan[Opened](1)
    spawn second(app.shared(), opened, finished)
    spawn drive(left, opened)
    app.run(counter(left.count, u32(0x00ff00)))?
    left
}

fn unavailable(e: ui.Error) -> str? {
    match e {
        Platform(p) => match p {
            NoDisplay(detail) => "no display"
            _ => none
        }
        Gpu(g) => match g {
            NoDevice => "no device"
            _ => none
        }
    }
}

fn main() ! ui.Error {
    start() catch {
        e => {
            print(unavailable(e) ?? fail e)
        }
    }
}
