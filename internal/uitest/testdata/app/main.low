import std/ui
import std/ui/platform

fn drive(h: ui.Handle, cx: ui.Context, count: ui.Signal[i64]) {
    sleep(200)
    h.post(fn() {
        cx.dispatch(PointerDown(Left, 20.0, 20.0))
        cx.dispatch(PointerUp(Left, 20.0, 20.0))
    })
    sleep(200)
    h.post(fn() {
        print("count {count.get()}")
        cx.write_to_clipboard("from the app") or {
            print("write failed")
        }
        let pasted = cx.read_from_clipboard() or none
        print("pasted {pasted}")
        cx.quit()
    })
}

fn start() ! ui.Error {
    using app = ui.open(ui.Options { title: "low app", width: 200, height: 120 })?
    let cx = app.cx
    let count = cx.signal(0)
    var frames = 0
    spawn drive(cx.handle(), cx, count)
    app.run(fn() -> ui.Element {
        frames += 1
        ui.div().padding(10.0).child(ui.div().size(40.0, 40.0).background(ui.rgb(0x00ff00)).on_click(fn(e) count.set(count.get() + 1)))
    })?
    print("frames {frames >= 2}")
    print("closed {cx.closed()}")
}

fn unavailable(e: ui.Error) -> str? {
    match e {
        Platform(p) => match p {
            NoDisplay(detail) => "no display"
            _ => none
        }
        Gpu(g) => match g {
            NoDevice => "no device"
            _ => none
        }
    }
}

fn main() ! ui.Error {
    start() catch {
        e => {
            print(unavailable(e) ?? fail e)
        }
    }
}
