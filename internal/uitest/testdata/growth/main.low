import std/ui/gpu
import std/ui/scene
import std/ui/geometry
import support

fn channel(n: i64) -> f32 {
    f32(n % 256) / 255.0
}

fn cell_color(x: i64, y: i64) -> geometry.Color {
    geometry.Color { r: channel(x * 2), g: channel(y * 5), b: channel(x + y * 3), a: 1.0 }
}

fn grid(count: i64) -> scene.Scene {
    var s = scene.empty(100, 50, geometry.rgb(0x000000))
    for i in 0..count {
        let x = i % 100
        let y = i / 100
        scene.push_quad(mut s, scene.Quad { bounds: geometry.rect(f32(x), f32(y), 1.0, 1.0), background: cell_color(x, y) })
    }
    s
}

fn dots(atlas: scene.Atlas, count: i64) -> scene.Scene {
    var s = scene.empty(100, 50, geometry.rgb(0x000000))
    let tile = scene.tile(atlas, 3, 3, 1, 1)
    for i in 0..count {
        let x = i % 100
        let y = i / 100
        scene.push_sprite(mut s, scene.Sprite { bounds: geometry.rect(f32(x), f32(y), 1.0, 1.0), color: cell_color(x, y), tile })
    }
    s
}

fn halos(count: i64) -> scene.Scene {
    var s = scene.empty(160, 96, geometry.rgb(0xffffff))
    for i in 0..count {
        let x = (i % 20) * 8 + 2
        let y = (i / 20) * 8 + 2
        scene.push_shadow(mut s, scene.Shadow { bounds: geometry.rect(f32(x), f32(y), 4.0, 4.0), color: geometry.rgb(0x000000), sigma: 1.0 })
    }
    s
}

fn render() ! gpu.Error {
    using g = gpu.open()?
    using t = gpu.target(g, 100, 50)?
    using wide = gpu.target(g, 160, 96)?
    var atlas = scene.atlas(1024)
    let one: []u8 = [255]
    scene.write(mut atlas, 3, 3, 1, 1, one)

    let counts: []i64 = [10, 5000, 100, 5000]
    for i, count in counts {
        let s = grid(count)
        gpu.render(g, t, s, mut atlas)?
        support.snapshot(g, t, "quads{i}")?
    }

    let sprites = dots(atlas, 1500)
    gpu.render(g, t, sprites, mut atlas)?
    support.snapshot(g, t, "sprites")?

    let shadows = halos(240)
    gpu.render(g, wide, shadows, mut atlas)?
    support.snapshot(g, wide, "shadows")?
}

fn main() ! gpu.Error {
    support.guard(render)?
}
