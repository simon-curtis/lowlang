import std/ui/gpu
import std/ui/scene
import std/ui/geometry
import support

fn glyphs(atlas: scene.Atlas) -> scene.Scene {
    var s = scene.empty(32, 16, geometry.rgb(0x000000))
    let top = scene.tile(atlas, 0, 0, 4, 1)
    let deep = scene.tile(atlas, 10, 900, 4, 1)
    scene.push_sprite(mut s, scene.Sprite { bounds: geometry.rect(2.0, 2.0, 4.0, 1.0), color: geometry.rgb(0xffffff), tile: top })
    scene.push_sprite(mut s, scene.Sprite { bounds: geometry.rect(2.0, 6.0, 4.0, 1.0), color: geometry.rgb(0xffffff), tile: deep })
    s
}

fn render() ! gpu.Error {
    using g = gpu.open()?
    using t = gpu.target(g, 32, 16)?
    var atlas = scene.atlas(1024)

    let first: []u8 = [255, 200, 100, 50]
    scene.write(mut atlas, 0, 0, 4, 1, first)
    let drawn = glyphs(atlas)
    gpu.render(g, t, drawn, mut atlas)?
    support.snapshot(g, t, "first")?
    print("dirty {scene.dirty(atlas)}")

    let second: []u8 = [10, 20, 30, 40]
    scene.write(mut atlas, 0, 0, 4, 1, second)
    print("dirty {scene.dirty(atlas)} {atlas.dirty_top} {atlas.dirty_bottom}")
    gpu.render(g, t, drawn, mut atlas)?
    support.snapshot(g, t, "rewritten")?

    let deep: []u8 = [60, 120, 180, 240]
    scene.write(mut atlas, 10, 900, 4, 1, deep)
    print("dirty {scene.dirty(atlas)} {atlas.dirty_top} {atlas.dirty_bottom}")
    gpu.render(g, t, drawn, mut atlas)?
    support.snapshot(g, t, "deep")?

    gpu.render(g, t, drawn, mut atlas)?
    support.snapshot(g, t, "unchanged")?

    scene.clear(mut atlas)
    gpu.render(g, t, drawn, mut atlas)?
    support.snapshot(g, t, "cleared")?

    var small = scene.atlas(512)
    let corner: []u8 = [90, 91, 92, 93]
    scene.write(mut small, 0, 0, 4, 1, corner)
    var s = scene.empty(32, 16, geometry.rgb(0x000000))
    let tile = scene.tile(small, 0, 0, 4, 1)
    scene.push_sprite(mut s, scene.Sprite { bounds: geometry.rect(2.0, 2.0, 4.0, 1.0), color: geometry.rgb(0xffffff), tile })
    gpu.render(g, t, s, mut small)?
    support.snapshot(g, t, "resized")?
    gpu.render(g, t, s, mut small)?
    support.snapshot(g, t, "resized_again")?
}

fn main() ! gpu.Error {
    support.guard(render)?
}
