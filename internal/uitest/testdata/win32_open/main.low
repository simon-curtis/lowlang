import std/ui/platform
import win32support

fn once() ! platform.Error {
    using w = platform.open(platform.Options { title: "Low é", width: 320, height: 200 })?
    let native = platform.native(w)
    print("native {native.display != null} {native.window != null}")
    let opened = win32support.client_size(w)
    let events = platform.next(w, 1000)?
    print(win32support.describe(events[0]))
    print("scale {win32support.scale_of(events) >= 1}")
    for e in events {
        match e {
            Resized(width, height, scale) => {
                let device_width = i64(floor(width * scale + 0.5))
                let device_height = i64(floor(height * scale + 0.5))
                let wanted = "{device_width} {device_height}"
                print("client {opened == wanted}")
            }
            _ => {}
        }
    }
    win32support.show_stable(platform.next(w, 20)?)
}

fn main() {
    win32support.guard(once)
    win32support.guard(once)
}
