import std/ui/gpu
import std/ui/scene
import std/ui/geometry
import support

fn render() ! gpu.Error {
    using g = gpu.open()?
    using t = gpu.target(g, 32, 32)?
    var atlas = scene.atlas(1024)
    let coverage: []u8 = [
        255, 255, 128, 128, 0, 0, 64, 64,
        255, 255, 128, 128, 0, 0, 64, 64
    ]
    scene.write(mut atlas, 100, 40, 8, 2, coverage)
    let tile = scene.tile(atlas, 100, 40, 8, 2)

    var s = scene.empty(32, 32, geometry.rgb(0x000000))
    scene.push_sprite(mut s, scene.Sprite { bounds: geometry.rect(4.0, 4.0, 8.0, 2.0), color: geometry.rgb(0xff0000), tile })
    scene.push_sprite(mut s, scene.Sprite { bounds: geometry.rect(4.0, 10.0, 8.0, 2.0), color: geometry.rgba(0x00ff0080), tile })
    scene.push_sprite(mut s, scene.Sprite { bounds: geometry.rect(4.0, 16.0, 16.0, 4.0), color: geometry.rgb(0x0000ff), tile })
    gpu.render(g, t, s, mut atlas)?
    support.snapshot(g, t, "sprites")?
}

fn main() ! gpu.Error {
    support.guard(render)?
}
