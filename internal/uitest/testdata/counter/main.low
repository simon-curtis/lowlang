import std/ui
import std/ui/geometry
import std/ui/platform

struct State {
    cx: ui.Context
    count: ui.Signal[i64]
    note: ui.Signal[str]
}

fn button(label: str, pressed: fn(ui.ClickEvent)) -> ui.Element {
    ui.div().padding(8.0).rounded(6.0).background(ui.rgb(0x1a73e8))
        .hover(fn(v) v.with_background(ui.rgb(0x4285f4)))
        .active(fn(v) v.with_background(ui.rgb(0x1557b0)))
        .on_click(pressed)
        .child(ui.text(label))
}

fn edit(s: State, k: platform.KeyEvent) {
    match k.key {
        Named(Backspace) => {
            let text = s.note.get()
            if text.len > 0 {
                s.note.set(text[..text.len - 1])
            }
            s.cx.stop_propagation()
        }
        _ => {
            if k.text != "" {
                s.note.set(s.note.get() + k.text)
                s.cx.stop_propagation()
            }
        }
    }
}

fn note_field(s: State) -> ui.Element {
    ui.div().id("note").focusable().padding(8.0).rounded(6.0).border(1.0, ui.rgb(0x5f6368)).background(ui.rgb(0x303134))
        .focus(fn(v) v.with_border_color(ui.rgb(0x8ab4f8)))
        .on_key_down(fn(k) edit(s, k))
        .child(ui.text(if s.note.get() == "" { "Click here and type" } else { s.note.get() }))
}

fn control(label: str, area: ui.WindowControlArea) -> ui.Element {
    ui.div().width(32.0).height(28.0).items_center().justify_center()
        .hover(fn(v) v.with_background(ui.rgb(0x3c4043)))
        .window_control_area(area)
        .child(ui.text(label))
}

fn title_bar() -> ui.Element {
    ui.div().row().height(28.0).items_center().justify_between().background(ui.rgb(0x171717)).window_control_area(Drag).children() {
        ui.div().padding_x(12.0).child(ui.text("Counter"))
        ui.div().row().children() {
            control("_", Minimize)
            control("□", Maximize)
            control("×", Close)
        }
    }
}

fn content(s: State) -> ui.Element {
    ui.div().column().padding(16.0).gap(12.0).children() {
        ui.text("Clicked {s.count.get()} times")
        ui.div().row().gap(8.0).children() {
            button("Increment", fn(e) s.count.set(s.count.get() + 1))
            button("Reset", fn(e) s.count.set(0))
        }
        note_field(s)
    }
}

fn counter(s: State) -> ui.Element {
    var page = ui.div().column().size_full().background(ui.rgb(0x202124)).text_color(ui.rgb(0xe8eaed))
    if s.cx.window_decorations() == platform.Decorations.Client {
        page = page.child(title_bar())
    }
    page.child(content(s))
}

fn unavailable(e: ui.Error) -> str? {
    match e {
        Platform(p) => match p {
            NoDisplay(detail) => "no display"
            _ => none
        }
        Gpu(g) => match g {
            NoDevice => "no device"
            _ => none
        }
    }
}

fn start() ! ui.Error {
    using app = ui.open(ui.Options { title: "Counter", width: 360, height: 248, decorations: Client, background: geometry.rgb(0x202124) })?
    let s = State { cx: app.cx, count: app.cx.signal(0), note: app.cx.signal("") }
    app.run(fn() -> ui.Element { counter(s) })?
}

fn main() ! ui.Error {
    start() catch {
        e => {
            print(unavailable(e) ?? fail e)
        }
    }
}
