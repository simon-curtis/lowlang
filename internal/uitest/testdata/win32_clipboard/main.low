import std/ui/platform
import win32support

fn once() ! platform.Error {
    using w = platform.open(platform.Options { title: "clipboard", width: 320, height: 200 })?
    let c = platform.clipboard(w)
    platform.write_clipboard(c, "héllo 😀\nline")?
    print("read {platform.read_clipboard(c)?}")
    platform.write_clipboard(c, "")?
    print("empty [{platform.read_clipboard(c)?}]")
}

fn main() {
    win32support.guard(once)
}
