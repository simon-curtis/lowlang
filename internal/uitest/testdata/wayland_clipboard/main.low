import std/ui/platform

fn once() ! platform.Error {
    using w = platform.open(platform.Options { title: "low wayland clipboard", width: 160, height: 120 })?
    let c = platform.clipboard(w)
    platform.write_clipboard(c, "héllo 😀\nline")?
    print("read {platform.read_clipboard(c)?}")
    platform.next(w, 20)?
    print("kept {platform.read_clipboard(c)?}")
}

fn main() ! platform.Error {
    once() catch {
        NoDisplay(detail) => print("no display")
        e => fail e
    }
}
