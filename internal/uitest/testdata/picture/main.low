import std/ui/gpu
import std/ui/scene
import std/ui/geometry
import support

fn render() ! gpu.Error {
    using g = gpu.open()?
    using t = gpu.target(g, 32, 32)?
    var atlas = scene.atlas(1024)
    let rgba: []u8 = [
        255, 0, 0, 255, 0, 255, 0, 255,
        0, 0, 255, 255, 255, 255, 255, 128
    ]
    scene.write_colors(mut atlas, 200, 10, 2, 2, rgba)
    let tile = scene.tile(atlas, 200, 10, 2, 2)
    let red = scene.tile(atlas, 200, 10, 1, 1)

    var s = scene.empty(32, 32, geometry.rgb(0x000000))
    scene.push_picture(mut s, scene.Picture { bounds: geometry.rect(2.0, 2.0, 8.0, 8.0), tile })
    scene.push_picture(mut s, scene.Picture { bounds: geometry.rect(12.0, 2.0, 8.0, 8.0), tile, opacity: 0.5 })
    scene.push_picture(mut s, scene.Picture { bounds: geometry.rect(22.0, 2.0, 8.0, 8.0), tile, grayscale: 1.0 })
    scene.push_picture(mut s, scene.Picture { bounds: geometry.rect(2.0, 14.0, 16.0, 16.0), tile: red, corner_radii: geometry.corners(8.0) })
    gpu.render(g, t, s, mut atlas)?
    support.snapshot(g, t, "pictures")?
}

fn main() ! gpu.Error {
    support.guard(render)?
}
