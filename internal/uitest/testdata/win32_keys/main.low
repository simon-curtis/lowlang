import std/ui/platform
import win32support

fn tap(w: platform.Window, vk: i64, scan: i64) {
    win32support.post(w, 0x100, vk, 1 | (scan << 16))
    win32support.post(w, 0x101, vk, 0xC0000001 | (scan << 16))
}

fn once() ! platform.Error {
    using w = platform.open(platform.Options { title: "keys", width: 320, height: 200 })?
    win32support.ready(w)?

    tap(w, 0x0D, 0x1C)
    tap(w, 0x1B, 0x01)
    tap(w, 0x09, 0x0F)
    tap(w, 0x08, 0x0E)
    tap(w, 0x2E, 0x53)
    tap(w, 0x25, 0x4B)
    tap(w, 0x27, 0x4D)
    tap(w, 0x26, 0x48)
    tap(w, 0x28, 0x50)
    tap(w, 0x24, 0x47)
    tap(w, 0x23, 0x4F)
    tap(w, 0x21, 0x49)
    tap(w, 0x22, 0x51)
    tap(w, 0x70, 0x3B)
    tap(w, 0x7B, 0x58)
    win32support.show(platform.next(w, 1000)?)

    win32support.post(w, 0x100, 0x41, 0x1E0001)
    win32support.post(w, 0x102, 0x61, 0x1E0001)
    win32support.post(w, 0x100, 0x41, 0x401E0001)
    win32support.post(w, 0x102, 0x61, 0x401E0001)
    win32support.post(w, 0x101, 0x41, 0xC01E0001)
    win32support.post(w, 0x100, 0x20, 0x390001)
    win32support.post(w, 0x102, 0x20, 0x390001)
    win32support.post(w, 0x101, 0x20, 0xC0390001)
    win32support.post(w, 0x100, 0x10, 0x2A0001)
    win32support.post(w, 0x101, 0x10, 0xC02A0001)
    win32support.show(platform.next(w, 1000)?)

    win32support.hold(true, false, false)
    win32support.post(w, 0x100, 0x41, 0x1E0001)
    win32support.post(w, 0x102, 0x41, 0x1E0001)
    win32support.post(w, 0x101, 0x41, 0xC01E0001)
    win32support.show(platform.next(w, 1000)?)

    win32support.hold(false, true, false)
    win32support.post(w, 0x100, 0x41, 0x1E0001)
    win32support.post(w, 0x102, 0x01, 0x1E0001)
    win32support.post(w, 0x101, 0x41, 0xC01E0001)
    win32support.post(w, 0x100, 0x0D, 0x1C0001)
    win32support.post(w, 0x102, 0x0D, 0x1C0001)
    win32support.show(platform.next(w, 1000)?)

    win32support.hold(true, true, true)
    win32support.post(w, 0x100, 0x25, 0x4B0001)
    win32support.show(platform.next(w, 1000)?)

    win32support.hold(false, false, true)
    win32support.post(w, 0x104, 0x58, 0x20 << 24 | 0x2D0001)
    win32support.post(w, 0x106, 0x78, 0x20 << 24 | 0x2D0001)
    win32support.post(w, 0x105, 0x58, 0xE02D0001)
    win32support.show(platform.next(w, 1000)?)

    win32support.hold(false, false, false)
    win32support.post(w, 0x100, 0x41, 0x1E0001)
    win32support.post(w, 0x102, 0xD83D, 0x1E0001)
    win32support.post(w, 0x102, 0xDE00, 0x1E0001)
    win32support.post(w, 0x101, 0x41, 0xC01E0001)
    win32support.post(w, 0x100, 0x41, 0x1E0001)
    win32support.post(w, 0x102, 0xE9, 0x1E0001)
    win32support.post(w, 0x101, 0x41, 0xC01E0001)
    win32support.show(platform.next(w, 1000)?)
}

fn main() {
    win32support.guard(once)
}
