import std/ui/platform

fn cycle(round: i64) ! platform.Error {
    using w = platform.open(platform.Options { title: "low wayland reopen {round}", width: 160 + round, height: 120 })?
    if round % 3 == 1 {
        platform.next(w, 20)?
    }
    if round % 3 == 2 {
        platform.next(w, 0)?
        platform.next(w, 20)?
    }
    print("cycle {round}")
}

fn main() ! platform.Error {
    for round in 0..6 {
        cycle(round) catch {
            NoDisplay(detail) => {
                print("no display")
                return
            }
            e => fail e
        }
    }
}
