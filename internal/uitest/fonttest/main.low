import std/file
import std/os
import std/ui/font

struct Box {
    x0: f32
    y0: f32
    x1: f32
    y1: f32
}

fn bounds(o: font.Outline) -> Box {
    var b = Box { x0: 100000.0, y0: 100000.0, x1: -100000.0, y1: -100000.0 }
    for c in o.contours {
        for p in c.points {
            if p.x < b.x0 {
                b.x0 = p.x
            }
            if p.y < b.y0 {
                b.y0 = p.y
            }
            if p.x > b.x1 {
                b.x1 = p.x
            }
            if p.y > b.y1 {
                b.y1 = p.y
            }
        }
    }
    b
}

fn open(data: str) -> font.Font ! font.Error {
    if data.len > 4 && data[0..4] == "ttcf" {
        return font.parse_collection(data, 0)
    }
    font.parse(data)
}

fn report(path: str) {
    let data = file.read_text(path) catch {
        e => {
            print("unreadable {path}")
            return
        }
    }
    let f = open(data) catch {
        e => {
            print("failed {path} {e}")
            return
        }
    }
    var empty = 0
    var points = 0
    for g in 0..f.glyph_count {
        let o = f.outline(g)
        if o.contours.len == 0 {
            empty += 1
        }
        for c in o.contours {
            points += c.points.len
        }
    }
    print("font {path} em {f.units_per_em} glyphs {f.glyph_count} empty {empty} points {points}")
    for ch in ['A', 'o', 'g'] {
        let g = f.glyph_index(u32(ch))
        let b = bounds(f.outline(g))
        print("glyph {g} {b.x0} {b.y0} {b.x1} {b.y1} advance {f.advance(g)}")
    }
}

fn main() {
    let args = os.args()
    for i in 1..args.len {
        report(args[i])
    }
}
