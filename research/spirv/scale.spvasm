OpCapability Shader
OpMemoryModel Logical GLSL450
OpEntryPoint GLCompute %main "main" %gid %pc %b0 %b1
OpExecutionMode %main LocalSize 64 1 1
OpDecorate %gid BuiltIn GlobalInvocationId
OpDecorate %words ArrayStride 4
OpDecorate %Buf Block
OpMemberDecorate %Buf 0 Offset 0
OpDecorate %PC Block
OpDecorate %b0 DescriptorSet 0
OpDecorate %b0 Binding 0
OpDecorate %b1 DescriptorSet 0
OpDecorate %b1 Binding 1
OpMemberDecorate %PC 0 Offset 0
OpMemberDecorate %PC 1 Offset 4
OpMemberDecorate %PC 2 Offset 8
OpDecorate %m NoContraction
%void = OpTypeVoid
%fnty = OpTypeFunction %void
%bool = OpTypeBool
%u32 = OpTypeInt 32 0
%f32 = OpTypeFloat 32
%v3u = OpTypeVector %u32 3
%p_in_v3u = OpTypePointer Input %v3u
%gid = OpVariable %p_in_v3u Input
%p_in_u32 = OpTypePointer Input %u32
%words = OpTypeRuntimeArray %u32
%Buf = OpTypeStruct %words
%p_buf = OpTypePointer StorageBuffer %Buf
%p_sb_u32 = OpTypePointer StorageBuffer %u32
%b0 = OpVariable %p_buf StorageBuffer
%b1 = OpVariable %p_buf StorageBuffer
%PC = OpTypeStruct %u32 %f32 %u32
%p_pc = OpTypePointer PushConstant %PC
%pc = OpVariable %p_pc PushConstant
%p_pc_u32 = OpTypePointer PushConstant %u32
%p_pc_f32 = OpTypePointer PushConstant %f32
%c0 = OpConstant %u32 0
%c1 = OpConstant %u32 1
%c2 = OpConstant %u32 2
%c4 = OpConstant %u32 4
%c24 = OpConstant %u32 24
%f0 = OpConstant %f32 0
%f1 = OpConstant %f32 1
%ix_count = OpConstant %u32 0
%ix_k = OpConstant %u32 1
%ix_pslen = OpConstant %u32 2
%main = OpFunction %void None %fnty
%entry = OpLabel
%gp = OpAccessChain %p_in_u32 %gid %c0
%id = OpLoad %u32 %gp
%pp_count = OpAccessChain %p_pc_u32 %pc %ix_count
%count = OpLoad %u32 %pp_count
%pp_k = OpAccessChain %p_pc_f32 %pc %ix_k
%k = OpLoad %f32 %pp_k
%pp_pslen = OpAccessChain %p_pc_u32 %pc %ix_pslen
%pslen = OpLoad %u32 %pp_pslen
%inrange = OpULessThan %bool %id %count
OpSelectionMerge %start None
OpBranchConditional %inrange %start %skip
%skip = OpLabel
OpReturn
%start = OpLabel
%ok3 = OpULessThan %bool %id %pslen
OpSelectionMerge %cm3 None
OpBranchConditional %ok3 %cm3 %cf3
%cf3 = OpLabel
%fp3 = OpAccessChain %p_sb_u32 %b0 %c0 %c0
OpStore %fp3 %c1
OpReturn
%cm3 = OpLabel
%off = OpIMul %u32 %id %c24
%x_w = OpShiftRightLogical %u32 %off %c2
%x_p = OpAccessChain %p_sb_u32 %b1 %c0 %x_w
%x_u = OpLoad %u32 %x_p
%x = OpBitcast %f32 %x_u
%m = OpFMul %f32 %x %k
%sx_w = OpShiftRightLogical %u32 %off %c2
%sx_p = OpAccessChain %p_sb_u32 %b1 %c0 %sx_w
%sx_u = OpBitcast %u32 %m
OpStore %sx_p %sx_u
%ok4 = OpULessThan %bool %id %pslen
OpSelectionMerge %cm4 None
OpBranchConditional %ok4 %cm4 %cf4
%cf4 = OpLabel
%fp4 = OpAccessChain %p_sb_u32 %b0 %c0 %c0
OpStore %fp4 %c1
OpReturn
%cm4 = OpLabel
%n_w = OpShiftRightLogical %u32 %off %c2
%n_w2 = OpIAdd %u32 %n_w %c4
%n_p = OpAccessChain %p_sb_u32 %b1 %c0 %n_w2
%n = OpLoad %u32 %n_p
%n1 = OpIAdd %u32 %n %c1
%sn_w = OpShiftRightLogical %u32 %off %c2
%sn_w2 = OpIAdd %u32 %sn_w %c4
%sn_p = OpAccessChain %p_sb_u32 %b1 %c0 %sn_w2
OpStore %sn_p %n1
OpReturn
OpFunctionEnd
