OpCapability Shader
OpMemoryModel Logical GLSL450
OpEntryPoint GLCompute %main "main" %gid %pc %b0 %b1 %b2
OpExecutionMode %main LocalSize 64 1 1
OpDecorate %gid BuiltIn GlobalInvocationId
OpDecorate %words ArrayStride 4
OpDecorate %Buf Block
OpMemberDecorate %Buf 0 Offset 0
OpDecorate %PC Block
OpDecorate %b0 DescriptorSet 0
OpDecorate %b0 Binding 0
OpDecorate %b1 DescriptorSet 0
OpDecorate %b1 Binding 1
OpDecorate %b2 DescriptorSet 0
OpDecorate %b2 Binding 2
OpMemberDecorate %PC 0 Offset 0
OpMemberDecorate %PC 1 Offset 4
OpMemberDecorate %PC 2 Offset 8
OpMemberDecorate %PC 3 Offset 12
OpMemberDecorate %PC 4 Offset 16
OpMemberDecorate %PC 5 Offset 20
OpDecorate %sum2 NoContraction
OpDecorate %n2 NoContraction
OpDecorate %avg NoContraction
%void = OpTypeVoid
%fnty = OpTypeFunction %void
%bool = OpTypeBool
%u32 = OpTypeInt 32 0
%f32 = OpTypeFloat 32
%v3u = OpTypeVector %u32 3
%p_in_v3u = OpTypePointer Input %v3u
%gid = OpVariable %p_in_v3u Input
%p_in_u32 = OpTypePointer Input %u32
%words = OpTypeRuntimeArray %u32
%Buf = OpTypeStruct %words
%p_buf = OpTypePointer StorageBuffer %Buf
%p_sb_u32 = OpTypePointer StorageBuffer %u32
%b0 = OpVariable %p_buf StorageBuffer
%b1 = OpVariable %p_buf StorageBuffer
%b2 = OpVariable %p_buf StorageBuffer
%PC = OpTypeStruct %u32 %u32 %u32 %u32 %u32 %u32
%p_pc = OpTypePointer PushConstant %PC
%pc = OpVariable %p_pc PushConstant
%p_pc_u32 = OpTypePointer PushConstant %u32
%p_pc_f32 = OpTypePointer PushConstant %f32
%c0 = OpConstant %u32 0
%c1 = OpConstant %u32 1
%c2 = OpConstant %u32 2
%c4 = OpConstant %u32 4
%c24 = OpConstant %u32 24
%f0 = OpConstant %f32 0
%f1 = OpConstant %f32 1
%ix_count = OpConstant %u32 0
%ix_w = OpConstant %u32 1
%ix_h = OpConstant %u32 2
%ix_r = OpConstant %u32 3
%ix_srclen = OpConstant %u32 4
%ix_dstlen = OpConstant %u32 5
%main = OpFunction %void None %fnty
%entry = OpLabel
%gp = OpAccessChain %p_in_u32 %gid %c0
%id = OpLoad %u32 %gp
%pp_count = OpAccessChain %p_pc_u32 %pc %ix_count
%count = OpLoad %u32 %pp_count
%pp_w = OpAccessChain %p_pc_u32 %pc %ix_w
%w = OpLoad %u32 %pp_w
%pp_h = OpAccessChain %p_pc_u32 %pc %ix_h
%h = OpLoad %u32 %pp_h
%pp_r = OpAccessChain %p_pc_u32 %pc %ix_r
%r = OpLoad %u32 %pp_r
%pp_srclen = OpAccessChain %p_pc_u32 %pc %ix_srclen
%srclen = OpLoad %u32 %pp_srclen
%pp_dstlen = OpAccessChain %p_pc_u32 %pc %ix_dstlen
%dstlen = OpLoad %u32 %pp_dstlen
%inrange = OpULessThan %bool %id %count
OpSelectionMerge %start None
OpBranchConditional %inrange %start %skip
%skip = OpLabel
OpReturn
%start = OpLabel
%x = OpUMod %u32 %id %w
%y = OpUDiv %u32 %id %w
%r2 = OpShiftLeftLogical %u32 %r %c1
OpBranch %L1
%L1 = OpLabel
%n = OpPhi %f32 %f0 %start %n5 %L1c
%sum = OpPhi %f32 %f0 %start %sum5 %L1c
%dy = OpPhi %u32 %c0 %start %dy1 %L1c
OpLoopMerge %L1m %L1c None
OpBranch %L1t
%L1t = OpLabel
%t1 = OpULessThanEqual %bool %dy %r2
OpBranchConditional %t1 %B2 %L1m
%B2 = OpLabel
%sy = OpIAdd %u32 %y %dy
%syr = OpISub %u32 %sy %r
OpBranch %L5
%L5 = OpLabel
%n5 = OpPhi %f32 %n %B2 %n6 %L5c
%sum5 = OpPhi %f32 %sum %B2 %sum6 %L5c
%dx = OpPhi %u32 %c0 %B2 %dx1 %L5c
OpLoopMerge %L5m %L5c None
OpBranch %L5t
%L5t = OpLabel
%t5 = OpULessThanEqual %bool %dx %r2
OpBranchConditional %t5 %B6 %L5m
%B6 = OpLabel
%sx = OpIAdd %u32 %x %dx
%q1 = OpUGreaterThanEqual %bool %sx %r
OpSelectionMerge %M6 None
OpBranchConditional %q1 %B16 %M6
%B16 = OpLabel
%q2 = OpUGreaterThanEqual %bool %sy %r
OpSelectionMerge %M16 None
OpBranchConditional %q2 %B14 %M16
%B14 = OpLabel
%sxr = OpISub %u32 %sx %r
%q3 = OpULessThan %bool %sxr %w
OpSelectionMerge %M14 None
OpBranchConditional %q3 %B12 %M14
%B12 = OpLabel
%q4 = OpULessThan %bool %syr %h
OpSelectionMerge %M12 None
OpBranchConditional %q4 %B9 %M12
%B9 = OpLabel
%row = OpIMul %u32 %syr %w
%ti = OpIAdd %u32 %row %sxr
%ok7 = OpULessThan %bool %ti %srclen
OpSelectionMerge %cm7 None
OpBranchConditional %ok7 %cm7 %cf7
%cf7 = OpLabel
%fp7 = OpAccessChain %p_sb_u32 %b0 %c0 %c0
OpStore %fp7 %c1
OpReturn
%cm7 = OpLabel
%toff = OpShiftLeftLogical %u32 %ti %c2
%tv_w = OpShiftRightLogical %u32 %toff %c2
%tv_p = OpAccessChain %p_sb_u32 %b1 %c0 %tv_w
%tv_u = OpLoad %u32 %tv_p
%tv = OpBitcast %f32 %tv_u
%sum2 = OpFAdd %f32 %sum5 %tv
%n2 = OpFAdd %f32 %n5 %f1
OpBranch %M12
%M12 = OpLabel
%sA = OpPhi %f32 %sum2 %cm7 %sum5 %B12
%nA = OpPhi %f32 %n2 %cm7 %n5 %B12
OpBranch %M14
%M14 = OpLabel
%sB = OpPhi %f32 %sA %M12 %sum5 %B14
%nB = OpPhi %f32 %nA %M12 %n5 %B14
OpBranch %M16
%M16 = OpLabel
%sC = OpPhi %f32 %sB %M14 %sum5 %B16
%nC = OpPhi %f32 %nB %M14 %n5 %B16
OpBranch %M6
%M6 = OpLabel
%sum6 = OpPhi %f32 %sC %M16 %sum5 %B6
%n6 = OpPhi %f32 %nC %M16 %n5 %B6
OpBranch %L5c
%L5c = OpLabel
%dx1 = OpIAdd %u32 %dx %c1
OpBranch %L5
%L5m = OpLabel
OpBranch %L1c
%L1c = OpLabel
%dy1 = OpIAdd %u32 %dy %c1
OpBranch %L1
%L1m = OpLabel
%avg = OpFDiv %f32 %sum %n
%ok8 = OpULessThan %bool %id %dstlen
OpSelectionMerge %cm8 None
OpBranchConditional %ok8 %cm8 %cf8
%cf8 = OpLabel
%fp8 = OpAccessChain %p_sb_u32 %b0 %c0 %c0
OpStore %fp8 %c1
OpReturn
%cm8 = OpLabel
%doff = OpShiftLeftLogical %u32 %id %c2
%sd_w = OpShiftRightLogical %u32 %doff %c2
%sd_p = OpAccessChain %p_sb_u32 %b2 %c0 %sd_w
%sd_u = OpBitcast %u32 %avg
OpStore %sd_p %sd_u
OpReturn
OpFunctionEnd
