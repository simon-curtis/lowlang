OpCapability Shader
OpMemoryModel Logical GLSL450
OpEntryPoint GLCompute %main "main" %gid %pc %b0 %b1 %b2
OpExecutionMode %main LocalSize 64 1 1
OpDecorate %gid BuiltIn GlobalInvocationId
OpDecorate %words ArrayStride 4
OpDecorate %Buf Block
OpMemberDecorate %Buf 0 Offset 0
OpDecorate %PC Block
OpDecorate %b0 DescriptorSet 0
OpDecorate %b0 Binding 0
OpDecorate %b1 DescriptorSet 0
OpDecorate %b1 Binding 1
OpDecorate %b2 DescriptorSet 0
OpDecorate %b2 Binding 2
OpMemberDecorate %PC 0 Offset 0
OpMemberDecorate %PC 1 Offset 4
OpMemberDecorate %PC 2 Offset 8
OpMemberDecorate %PC 3 Offset 12
OpMemberDecorate %PC 4 Offset 16
%void = OpTypeVoid
%fnty = OpTypeFunction %void
%bool = OpTypeBool
%u32 = OpTypeInt 32 0
%f32 = OpTypeFloat 32
%v3u = OpTypeVector %u32 3
%p_in_v3u = OpTypePointer Input %v3u
%gid = OpVariable %p_in_v3u Input
%p_in_u32 = OpTypePointer Input %u32
%words = OpTypeRuntimeArray %u32
%Buf = OpTypeStruct %words
%p_buf = OpTypePointer StorageBuffer %Buf
%p_sb_u32 = OpTypePointer StorageBuffer %u32
%b0 = OpVariable %p_buf StorageBuffer
%b1 = OpVariable %p_buf StorageBuffer
%b2 = OpVariable %p_buf StorageBuffer
%PC = OpTypeStruct %u32 %u32 %u32 %u32 %u32
%p_pc = OpTypePointer PushConstant %PC
%pc = OpVariable %p_pc PushConstant
%p_pc_u32 = OpTypePointer PushConstant %u32
%p_pc_f32 = OpTypePointer PushConstant %f32
%c0 = OpConstant %u32 0
%c1 = OpConstant %u32 1
%c2 = OpConstant %u32 2
%c4 = OpConstant %u32 4
%c24 = OpConstant %u32 24
%f0 = OpConstant %f32 0
%f1 = OpConstant %f32 1
%ix_count = OpConstant %u32 0
%ix_a = OpConstant %u32 1
%ix_b = OpConstant %u32 2
%ix_srclen = OpConstant %u32 3
%ix_dstlen = OpConstant %u32 4
%true = OpConstantTrue %bool
%false = OpConstantFalse %bool
%main = OpFunction %void None %fnty
%entry = OpLabel
%gp = OpAccessChain %p_in_u32 %gid %c0
%id = OpLoad %u32 %gp
%pp_count = OpAccessChain %p_pc_u32 %pc %ix_count
%count = OpLoad %u32 %pp_count
%pp_a = OpAccessChain %p_pc_u32 %pc %ix_a
%a = OpLoad %u32 %pp_a
%pp_b = OpAccessChain %p_pc_u32 %pc %ix_b
%b = OpLoad %u32 %pp_b
%pp_srclen = OpAccessChain %p_pc_u32 %pc %ix_srclen
%srclen = OpLoad %u32 %pp_srclen
%pp_dstlen = OpAccessChain %p_pc_u32 %pc %ix_dstlen
%dstlen = OpLoad %u32 %pp_dstlen
%inrange = OpULessThan %bool %id %count
OpSelectionMerge %start None
OpBranchConditional %inrange %start %skip
%skip = OpLabel
OpReturn
%start = OpLabel
%q1 = OpULessThan %bool %id %a
OpSelectionMerge %M0 None
OpBranchConditional %q1 %B4 %M0
%B4 = OpLabel
%q2 = OpULessThan %bool %id %b
OpSelectionMerge %M4 None
OpBranchConditional %q2 %B1 %M4
%B1 = OpLabel
%ok13 = OpULessThan %bool %id %srclen
OpSelectionMerge %cm13 None
OpBranchConditional %ok13 %cm13 %cf13
%cf13 = OpLabel
%fp13 = OpAccessChain %p_sb_u32 %b0 %c0 %c0
OpStore %fp13 %c1
OpReturn
%cm13 = OpLabel
%offt = OpShiftLeftLogical %u32 %id %c2
%vt_w = OpShiftRightLogical %u32 %offt %c2
%vt_p = OpAccessChain %p_sb_u32 %b1 %c0 %vt_w
%vt_u = OpLoad %u32 %vt_p
%vt = OpBitcast %f32 %vt_u
%rt = OpFMul %f32 %vt %f1
%ok14 = OpULessThan %bool %id %dstlen
OpSelectionMerge %cm14 None
OpBranchConditional %ok14 %cm14 %cf14
%cf14 = OpLabel
%fp14 = OpAccessChain %p_sb_u32 %b0 %c0 %c0
OpStore %fp14 %c1
OpReturn
%cm14 = OpLabel
%st_w = OpShiftRightLogical %u32 %offt %c2
%st_p = OpAccessChain %p_sb_u32 %b2 %c0 %st_w
%st_u = OpBitcast %u32 %rt
OpStore %st_p %st_u
OpBranch %M4
%M4 = OpLabel
%d1 = OpPhi %bool %true %cm14 %false %B4
OpBranch %M0
%M0 = OpLabel
%d = OpPhi %bool %d1 %M4 %false %start
OpSelectionMerge %B3 None
OpBranchConditional %d %B3 %B2
%B2 = OpLabel
%ok15 = OpULessThan %bool %id %srclen
OpSelectionMerge %cm15 None
OpBranchConditional %ok15 %cm15 %cf15
%cf15 = OpLabel
%fp15 = OpAccessChain %p_sb_u32 %b0 %c0 %c0
OpStore %fp15 %c1
OpReturn
%cm15 = OpLabel
%offe = OpShiftLeftLogical %u32 %id %c2
%ve_w = OpShiftRightLogical %u32 %offe %c2
%ve_p = OpAccessChain %p_sb_u32 %b1 %c0 %ve_w
%ve_u = OpLoad %u32 %ve_p
%ve = OpBitcast %f32 %ve_u
%re = OpFAdd %f32 %ve %f1
%ok16 = OpULessThan %bool %id %dstlen
OpSelectionMerge %cm16 None
OpBranchConditional %ok16 %cm16 %cf16
%cf16 = OpLabel
%fp16 = OpAccessChain %p_sb_u32 %b0 %c0 %c0
OpStore %fp16 %c1
OpReturn
%cm16 = OpLabel
%se_w = OpShiftRightLogical %u32 %offe %c2
%se_p = OpAccessChain %p_sb_u32 %b2 %c0 %se_w
%se_u = OpBitcast %u32 %re
OpStore %se_p %se_u
OpBranch %B3
%B3 = OpLabel
OpReturn
OpFunctionEnd
