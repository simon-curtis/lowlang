import std/os

struct P {
    x: f32
    y: f32
    n: u32
}

fn saxpy(id: u32, a: f32, x: f32[], mut y: f32[]) {
    y[id] = a * x[id] + y[id]
}

fn scale(id: u32, k: f32, mut ps: P[]) {
    ps[id].x = ps[id].x * k
    ps[id].n = ps[id].n + 1
}

fn tap(src: f32[], w: u32, x: u32, y: u32) -> f32 {
    src[y * w + x]
}

fn blur(id: u32, w: u32, h: u32, r: u32, src: f32[], mut dst: f32[]) {
    let x = id % w
    let y = id / w
    var sum: f32 = 0.0
    var n: f32 = 0.0
    var dy: u32 = 0
    for dy <= 2 * r {
        var dx: u32 = 0
        for dx <= 2 * r {
            let sx = x + dx
            let sy = y + dy
            if sx >= r && sy >= r && sx - r < w && sy - r < h {
                sum = sum + tap(src, w, sx - r, sy - r)
                n = n + 1.0
            }
            dx = dx + 1
        }
        dy = dy + 1
    }
    dst[id] = sum / n
}

fn pick(id: u32, flag: u32, a: f32[], b: f32[], mut out: f32[]) {
    let s = if flag == 0 { a } else { b }
    out[id] = s[id]
}

fn both(id: u32, a: u32, b: u32, src: f32[], mut dst: f32[]) {
    if id < a && id < b {
        dst[id] = src[id] * 2.0
    } else {
        dst[id] = src[id] + 1.0
    }
}

fn either(id: u32, a: u32, b: u32, src: f32[], mut dst: f32[]) {
    if id < a || id > b {
        dst[id] = src[id] * 2.0
    } else {
        dst[id] = src[id] + 1.0
    }
}

fn scan(id: u32, n: u32, src: f32[], mut dst: f32[]) {
    var sum: f32 = 0.0
    var i: u32 = 0
    for i < n {
        var j: u32 = 0
        for j < n {
            j = j + 1
            if src[j] < 0.0 {
                continue
            }
            if src[j] > 100.0 {
                break
            }
            sum = sum + src[j]
        }
        i = i + 1
    }
    dst[id] = sum
}

fn main() {
    let n = u32(os.args().len)
    var ys: f32[] = [1.0, 2.0]
    let xs: f32[] = [3.0, 4.0]
    saxpy(n, 2.0, xs, mut ys)
    var ps: P[] = [P{x: 1.0, y: 2.0, n: 3}]
    scale(n, 2.0, mut ps)
    var ds: f32[] = [0.0, 0.0, 0.0, 0.0]
    blur(n, 2, 2, n, xs, mut ds)
    pick(n, n, xs, ys, mut ds)
    print(ys[1])
    print(ps[0].n)
    print(ds[0])
}
