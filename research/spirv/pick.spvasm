OpCapability Shader
OpMemoryModel Logical GLSL450
OpEntryPoint GLCompute %main "main" %gid %pc %b0 %b1 %b2 %b3
OpExecutionMode %main LocalSize 64 1 1
OpDecorate %gid BuiltIn GlobalInvocationId
OpDecorate %words ArrayStride 4
OpDecorate %Buf Block
OpMemberDecorate %Buf 0 Offset 0
OpDecorate %PC Block
OpDecorate %b0 DescriptorSet 0
OpDecorate %b0 Binding 0
OpDecorate %b1 DescriptorSet 0
OpDecorate %b1 Binding 1
OpDecorate %b2 DescriptorSet 0
OpDecorate %b2 Binding 2
OpDecorate %b3 DescriptorSet 0
OpDecorate %b3 Binding 3
OpMemberDecorate %PC 0 Offset 0
OpMemberDecorate %PC 1 Offset 4
OpMemberDecorate %PC 2 Offset 8
OpMemberDecorate %PC 3 Offset 12
OpMemberDecorate %PC 4 Offset 16
%void = OpTypeVoid
%fnty = OpTypeFunction %void
%bool = OpTypeBool
%u32 = OpTypeInt 32 0
%f32 = OpTypeFloat 32
%v3u = OpTypeVector %u32 3
%p_in_v3u = OpTypePointer Input %v3u
%gid = OpVariable %p_in_v3u Input
%p_in_u32 = OpTypePointer Input %u32
%words = OpTypeRuntimeArray %u32
%Buf = OpTypeStruct %words
%p_buf = OpTypePointer StorageBuffer %Buf
%p_sb_u32 = OpTypePointer StorageBuffer %u32
%b0 = OpVariable %p_buf StorageBuffer
%b1 = OpVariable %p_buf StorageBuffer
%b2 = OpVariable %p_buf StorageBuffer
%b3 = OpVariable %p_buf StorageBuffer
%PC = OpTypeStruct %u32 %u32 %u32 %u32 %u32
%p_pc = OpTypePointer PushConstant %PC
%pc = OpVariable %p_pc PushConstant
%p_pc_u32 = OpTypePointer PushConstant %u32
%p_pc_f32 = OpTypePointer PushConstant %f32
%c0 = OpConstant %u32 0
%c1 = OpConstant %u32 1
%c2 = OpConstant %u32 2
%c4 = OpConstant %u32 4
%c24 = OpConstant %u32 24
%f0 = OpConstant %f32 0
%f1 = OpConstant %f32 1
%ix_count = OpConstant %u32 0
%ix_flag = OpConstant %u32 1
%ix_alen = OpConstant %u32 2
%ix_blen = OpConstant %u32 3
%ix_outlen = OpConstant %u32 4
%main = OpFunction %void None %fnty
%entry = OpLabel
%gp = OpAccessChain %p_in_u32 %gid %c0
%id = OpLoad %u32 %gp
%pp_count = OpAccessChain %p_pc_u32 %pc %ix_count
%count = OpLoad %u32 %pp_count
%pp_flag = OpAccessChain %p_pc_u32 %pc %ix_flag
%flag = OpLoad %u32 %pp_flag
%pp_alen = OpAccessChain %p_pc_u32 %pc %ix_alen
%alen = OpLoad %u32 %pp_alen
%pp_blen = OpAccessChain %p_pc_u32 %pc %ix_blen
%blen = OpLoad %u32 %pp_blen
%pp_outlen = OpAccessChain %p_pc_u32 %pc %ix_outlen
%outlen = OpLoad %u32 %pp_outlen
%inrange = OpULessThan %bool %id %count
OpSelectionMerge %start None
OpBranchConditional %inrange %start %skip
%skip = OpLabel
OpReturn
%start = OpLabel
%z = OpIEqual %bool %flag %c0
OpSelectionMerge %j None
OpBranchConditional %z %ta %tb
%ta = OpLabel
OpBranch %j
%tb = OpLabel
OpBranch %j
%j = OpLabel
%sel = OpPhi %u32 %c1 %ta %c2 %tb
%len = OpPhi %u32 %alen %ta %blen %tb
%ok5 = OpULessThan %bool %id %len
OpSelectionMerge %cm5 None
OpBranchConditional %ok5 %cm5 %cf5
%cf5 = OpLabel
%fp5 = OpAccessChain %p_sb_u32 %b0 %c0 %c0
OpStore %fp5 %c1
OpReturn
%cm5 = OpLabel
%off = OpShiftLeftLogical %u32 %id %c2
OpSelectionMerge %lm None
OpSwitch %sel %lb 1 %la
%la = OpLabel
%va_w = OpShiftRightLogical %u32 %off %c2
%va_p = OpAccessChain %p_sb_u32 %b1 %c0 %va_w
%va_u = OpLoad %u32 %va_p
%va = OpBitcast %f32 %va_u
OpBranch %lm
%lb = OpLabel
%vb_w = OpShiftRightLogical %u32 %off %c2
%vb_p = OpAccessChain %p_sb_u32 %b2 %c0 %vb_w
%vb_u = OpLoad %u32 %vb_p
%vb = OpBitcast %f32 %vb_u
OpBranch %lm
%lm = OpLabel
%v = OpPhi %f32 %va %la %vb %lb
%ok6 = OpULessThan %bool %id %outlen
OpSelectionMerge %cm6 None
OpBranchConditional %ok6 %cm6 %cf6
%cf6 = OpLabel
%fp6 = OpAccessChain %p_sb_u32 %b0 %c0 %c0
OpStore %fp6 %c1
OpReturn
%cm6 = OpLabel
%so_w = OpShiftRightLogical %u32 %off %c2
%so_p = OpAccessChain %p_sb_u32 %b3 %c0 %so_w
%so_u = OpBitcast %u32 %v
OpStore %so_p %so_u
OpReturn
OpFunctionEnd
