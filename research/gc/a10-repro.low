import std/os
import std/slices
import std/sync
import std/time
import std/time/duration

struct Token {
    kind: i64
    text: str
}

fn lex(line: str) -> Token[] {
    var tokens: Token[] = []
    var start = 0
    for i in 0..line.len + 1 {
        if i == line.len || line[i] == 32 {
            if i > start {
                tokens.push(Token { kind: i64(line[start]), text: line[start..i] })
            }
            start = i + 1
        }
    }
    tokens
}

fn parse(src: str[], done: chan[Token[][]]) {
    var lines: Token[][] = []
    for line in src {
        lines.push(lex(line))
    }
    done <- lines
}

fn spin(done: chan[Token[][]]) {
    let started = time.monotonic()
    var acc = 1
    for time.monotonic() - started < 100000000 {
        acc = (acc * 33 + 7) % 1000003
    }
    done <- [[Token { kind: acc, text: "" }]]
}

fn main() {
    let args = os.args()
    let cpu_only = args.len > 1 && args[1] == "cpu"
    var src: str[] = []
    for i in 0..180000 {
        src.push("let value_{i} = compute(alpha_{i % 97}, beta, {i * 7}) + gamma[{i % 13}] // note {i}")
    }
    let done = chan[Token[][]](1)
    if args.len > 1 && args[1] == "warm" {
        for w in 0..24 {
            spawn spin(done)
        }
        for w in 0..24 {
            let _ = <-done
        }
    }
    var kept: Token[][] = []
    var work: i64[] = []
    var running = false
    sync.lock_thread()
    var deadline = time.monotonic()
    for frame in 0..600 {
        deadline += 16000000
        let wait = deadline - time.monotonic()
        if wait > 0 {
            time.sleep_for(duration.nanoseconds(wait))
        }
        let started = time.monotonic()
        select {
            r = <-done => {
                kept = r ?? []
                running = false
            }
            else => {}
        }
        if !running {
            running = true
            if cpu_only {
                spawn spin(done)
            } else {
                spawn parse(src, done)
            }
        }
        var acc = frame
        for time.monotonic() - started < 2000000 {
            acc = (acc * 33 + 7) % 1000003
        }
        work.push((time.monotonic() - started) / 1000)
    }
    sync.unlock_thread()
    slices.sort(mut work)
    print("kept {kept.len} lines; frame work p50 {work[300]} us, p99 {work[594]} us, max {work[599]} us (budget 2000 us)")
}
