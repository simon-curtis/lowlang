new file mode 100644
index 00000000..7d285795
--- /dev/null
+++ b/bench/spike/main.low
@@ -0,0 +1,75 @@
+struct Node {
+    next: *Node?
+    value: i64
+}
+
+struct Pair {
+    a: i64
+    b: i64
+}
+
+fn chain(n: i64) -> *Node? {
+    var head: *Node? = none
+    for i in 0..n {
+        head = new(Node { next: head, value: i })
+    }
+    head
+}
+
+fn total(head: *Node?) -> i64 {
+    var sum = 0
+    var cur = head
+    for {
+        match cur {
+            some(n) => {
+                sum += n.value
+                cur = n.next
+            }
+            none => break
+        }
+    }
+    sum
+}
+
+fn filled(n: i64, seed: i64) -> i64[] {
+    var xs: i64[] = []
+    for i in 0..n {
+        xs.push(i + seed)
+    }
+    xs
+}
+
+fn spike() -> i64 {
+    let list = chain(3000000)
+    var blocks: i64[][] = []
+    for k in 0..48 {
+        blocks.push(filled(500000, k))
+    }
+    var sum = total(list)
+    for b in blocks {
+        sum += b[499999]
+    }
+    sum
+}
+
+fn churn(rounds: i64, keep: *Node?) -> i64 {
+    var sum = 0
+    for i in 0..rounds {
+        let p = new(Pair { a: i, b: 1 })
+        sum += p.a + p.b
+        if i % 64 == 0 {
+            var scratch: i64[] = []
+            for k in 0..48 {
+                scratch.push(k + i)
+            }
+            sum += scratch[47]
+        }
+    }
+    sum + total(keep)
+}
+
+fn main() {
+    print(spike())
+    let keep = chain(60000)
+    print(churn(150000000, keep))
+}
