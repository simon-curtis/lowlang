diff --git a/testdata/run/gc_mark_threads.low b/testdata/run/gc_mark_threads.low
new file mode 100644
index 00000000..a23c047b
--- /dev/null
+++ b/testdata/run/gc_mark_threads.low
@@ -0,0 +1,30 @@
+import std/file
+import std/os
+import std/text
+
+fn os_threads() -> i64 {
+    let status = file.read_text("/proc/self/status") or return 0
+    for line in text.split(status, 10) {
+        let c = text.cut(line, ":")
+        if c.found && c.before == "Threads" {
+            return text.parse_int(text.trim(c.after)) or 0
+        }
+    }
+    0
+}
+
+fn main() {
+    var kept: i64[][] = []
+    for i in 0..300000 {
+        kept.push([i, i, i, i, i, i, i, i])
+    }
+    var sum = 0
+    for i in 0..3000000 {
+        let garbage = [i, i + 1, i + 2, i + 3]
+        sum += garbage[i % 4]
+    }
+    let wanted = if os.cpu_count() < 16 { os.cpu_count() } else { 16 }
+    let threads = os_threads()
+    print("kept {kept.len} {sum > 0}")
+    print("mark threads: {threads == 0 || threads >= wanted}")
+}
