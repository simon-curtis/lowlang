--- /dev/null
+++ b/bench/shuffle/main.low
@@ -0,0 +1,67 @@
+struct Node {
+    a: *Node?
+    b: *Node?
+    extra: *Node?
+    value: i64
+}
+
+struct Rng {
+    state: u64
+}
+
+fn next(r: *Rng, n: i64) -> i64 {
+    var x = r.state
+    x = x ^ (x << 13)
+    x = x ^ (x >> 7)
+    x = x ^ (x << 17)
+    r.state = x
+    i64(x % u64(n))
+}
+
+fn leaf(v: i64) -> *Node {
+    new(Node { a: none, b: none, extra: none, value: v })
+}
+
+fn sum(n: *Node?, depth: i64) -> i64 {
+    if depth == 0 {
+        return 0
+    }
+    match n {
+        some(x) => x.value + sum(x.a, depth - 1) + sum(x.b, depth - 1)
+        none => 0
+    }
+}
+
+fn main() {
+    let count = 1000000
+    let r = new(Rng { state: 88172645463325252 })
+    var nodes: *Node[] = []
+    for i in 0..count {
+        nodes.push(leaf(i))
+    }
+    for i in 0..count {
+        let j = count - 1 - i
+        let k = next(r, j + 1)
+        let t = nodes[j]
+        nodes[j] = nodes[k]
+        nodes[k] = t
+    }
+    for i in 0..count {
+        let x = nodes[i]
+        x.a = nodes[next(r, count)]
+        x.b = nodes[next(r, count)]
+    }
+    var total = 0
+    for round in 0..400 {
+        var garbage: *Node? = none
+        for g in 0..20000 {
+            garbage = new(Node { a: garbage, b: none, extra: none, value: g })
+        }
+        for m in 0..200 {
+            let x = nodes[next(r, count)]
+            x.extra = leaf(round)
+        }
+        total += sum(nodes[next(r, count)], 12)
+    }
+    print("total {total}")
+}
