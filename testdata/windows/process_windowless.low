import std/io
import std/os
import std/process
import std/text

extern "kernel32" {
    fn FreeConsole() -> i32
    fn GetConsoleWindow() -> ptr
}

fn window(c: process.Command) -> str ! io.Error {
    let output = process.run(c, [])?
    text.trim(str(output.stdout))
}

fn main() ! io.Error {
    let args = os.args()
    if args.len > 1 {
        print(GetConsoleWindow() != null)
        return
    }
    let program = os.executable()?
    FreeConsole()
    print("default: {window(process.Command { program, args: ["report"], stdout: Piped })?}")
    print("windowless: {window(process.Command { program, args: ["report"], stdout: Piped, windowless: true })?}")
    print("windowless group: {window(process.Command { program, args: ["report"], stdin: Null, stdout: Piped, stderr: Null, group: true, windowless: true })?}")
    let quiet = process.run(process.Command { program, args: ["report"], stdin: Null, stdout: Null, stderr: Null, windowless: true }, [])?
    print("windowless null: {process.success(quiet.status)}")
}
