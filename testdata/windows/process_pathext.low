import std/file
import std/io
import std/os
import std/process
import std/text

fn child() {
    print("helper ran with {(os.args().len)} arguments")
}

fn suffix(found: str?) -> str {
    match found {
        some(path) => text.upper(path[path.len - 4..])
        none => "none"
    }
}

fn touch(path: str) ! io.Error {
    file.write_text(path, "x")?
}

fn main() ! io.Error {
    if os.args().len > 1 {
        child()
        return
    }
    let own = os.executable()?
    let root = file.temp_dir("low-pathext-")?
    let first = "{root}/first"
    let second = "{root}/second"
    file.mkdir_all(first)?
    file.mkdir_all(second)?
    file.mkdir_all("{first}/folder.exe")?
    touch("{first}/alpha.bat")?
    touch("{first}/alpha.cmd")?
    touch("{first}/beta.xyz")?
    touch("{first}/bare")?
    touch("{second}/alpha.exe")?
    touch("{second}/only_second.com")?

    os.set_env("PATH", first)?
    os.set_env("PATHEXT", ".COM;.EXE;.BAT;.CMD")?
    print("alpha: {suffix(process.find("alpha"))}")
    os.set_env("PATHEXT", ".CMD;.BAT")?
    print("alpha reordered: {suffix(process.find("alpha"))}")
    os.set_env("PATHEXT", ".XYZ")?
    print("beta custom: {suffix(process.find("beta"))}")
    os.set_env("PATHEXT", ".COM;.EXE;.BAT;.CMD")?
    print("beta default: {suffix(process.find("beta"))}")
    print("bare without extension: {suffix(process.find("bare"))}")
    print("directory skipped: {suffix(process.find("folder"))}")
    print("explicit extension: {suffix(process.find("alpha.cmd"))}")
    print("explicit missing extension: {suffix(process.find("alpha.zzz"))}")
    print("with directory: {suffix(process.find("{first}\\alpha"))}")
    print("with slash: {suffix(process.find("{first}/alpha"))}")
    os.unset_env("PATHEXT")?
    print("unset PATHEXT: {suffix(process.find("alpha"))}")

    os.set_env("PATH", "{first};{second}")?
    print("first directory wins: {suffix(process.find("alpha"))}")
    print("later directory: {suffix(process.find("only_second"))}")
    os.set_env("PATH", "{second};{first}")?
    print("order of directories: {suffix(process.find("alpha"))}")
    os.set_env("PATH", "")?
    print("empty PATH: {suffix(process.find("alpha"))}")

    file.copy(own, "{second}/helper.exe")?
    os.set_env("PATH", second)?
    let ran = process.run(process.command("helper", ["go"]), [])?
    print(text.trim(str(ran.stdout)))
    file.remove_all(root)?
}
