import std/io
import std/os
import std/process
import std/sys
import std/text

extern "kernel32" {
    fn CreateJobObjectW(attributes: ptr, name: ptr) -> i64
    fn AssignProcessToJobObject(job: i64, process: i64) -> i32
    fn GetCurrentProcess() -> i64
}

fn child(mode: str) {
    match mode {
        "spawner" => {
            let program = os.executable() or return
            let grandchild = process.start_handle(process.command(program, ["sleep"])) or return
            print(grandchild.pid)
            sleep(60000)
        }
        _ => sleep(60000)
    }
}

fn alive(pid: i64) -> bool {
    sys.kill(pid, 0) or return false
    true
}

fn settled(pid: i64) -> bool {
    for _ in 0..300 {
        if !alive(pid) {
            return true
        }
        sleep(20)
    }
    false
}

fn first_line(output: io.Stream) -> i64 ! io.Error {
    let buf = io.buffer(32)
    var seen: u8[] = []
    for text.index_byte(str(seen), '\n') < 0 {
        let n = output.read(buf)?
        if n == 0 {
            break
        }
        io.append(mut seen, buf[..n])
    }
    text.parse_int(text.trim(str(seen))) or 0
}

fn spawner(program: str, group: bool) -> process.Child ! io.Error {
    process.start(process.Command { program, args: ["spawner"], stdout: Piped, group })?
}

fn grandchild_of(child: process.Child) -> i64 ! io.Error {
    let output = child.handle.stdout ?? fail NotConnected
    first_line(output)?
}

fn killed_group(program: str) ! io.Error {
    using child = spawner(program, true)?
    let pid = grandchild_of(child)?
    print("grandchild alive: {alive(pid)}")
    process.kill(child, Kill)?
    print("group killed: {!process.success(process.wait(child)?)}")
    print("grandchild gone: {settled(pid)}")
}

fn killed_single(program: str) ! io.Error {
    using child = spawner(program, false)?
    let pid = grandchild_of(child)?
    process.kill(child, Kill)?
    print("child killed: {!process.success(process.wait(child)?)}")
    sleep(300)
    print("grandchild survives without a group: {alive(pid)}")
    sys.kill(pid, 15)?
    print("grandchild gone: {settled(pid)}")
}

fn dropped_group(program: str) -> i64 ! io.Error {
    using child = spawner(program, true)?
    grandchild_of(child)?
}

fn kill_after_wait(program: str) ! io.Error {
    using child = process.start(process.Command { program, args: ["sleep"], group: true })?
    process.kill(child, Terminate)?
    process.wait(child)?
    process.kill(child, Kill)?
    print("kill after wait: ok")
}

fn inside_job(program: str) ! io.Error {
    let job = CreateJobObjectW(null, null)
    print("job created: {job != 0}")
    print("assigned: {AssignProcessToJobObject(job, GetCurrentProcess()) != 0}")
    using child = spawner(program, true)?
    let pid = grandchild_of(child)?
    process.kill(child, Kill)?
    process.wait(child)?
    print("nested group gone: {settled(pid)}")
}

fn main() ! io.Error {
    let args = os.args()
    if args.len > 1 {
        child(args[1])
        return
    }
    let program = os.executable()?
    killed_group(program)?
    killed_single(program)?
    let dropped = dropped_group(program)?
    print("grandchild gone after drop: {settled(dropped)}")
    kill_after_wait(program)?
    inside_job(program)?
}
