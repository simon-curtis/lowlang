import std/io
import std/sys

extern "kernel32" {
    fn CreateThread(attributes: ptr, stack: i64, start: i64, parameter: i64, flags: u32, mut id: u32) -> i64
    fn WaitForSingleObject(handle: i64, milliseconds: u32) -> u32
    fn GetExitCodeThread(thread: i64, mut code: u32) -> i32
    fn CloseHandle(handle: i64) -> i32
}

struct Event {
    name: str
    number: i64
}

fn events() -> Event[] {
    [
        Event { name: "ctrl+c", number: 0 }
        Event { name: "ctrl+break", number: 1 }
        Event { name: "close", number: 2 }
        Event { name: "logoff", number: 5 }
        Event { name: "shutdown", number: 6 }
        Event { name: "unknown", number: 7 }
    ]
}

fn install(page: i64, fd: i64) {
    let code = sys.handler_code(fd)
    let raw: ptr[u8] = ptr(page)
    let target = view(raw, code.len)
    for i in 0..code.len {
        target[i] = code[i]
    }
}

fn run_handler(page: i64, event: i64) -> i64 ! io.Error {
    var id: u32 = 0
    let thread = CreateThread(null, 0, page, event, 0, mut id)
    if thread == 0 {
        fail Invalid
    }
    WaitForSingleObject(thread, 10000)
    var code: u32 = 0
    GetExitCodeThread(thread, mut code)
    CloseHandle(thread)
    i64(code)
}

fn read_signal(fd: i64) -> i64 ! io.Error {
    let buf = io.buffer(1)
    let n = sys.read(fd, buf)?
    if n != 1 {
        fail Eof
    }
    i64(buf[0])
}

fn main() ! io.Error {
    let ends = sys.pipe(true)?
    let page = sys.map_executable(4096)?
    install(page, ends.second)
    print("restorer offset: {sys.restorer_offset}")
    for e in events() {
        let handled = run_handler(page, e.number)?
        if handled == 1 {
            let signal = read_signal(ends.first)?
            print("{e.name}: handled, signal {signal}")
        } else {
            print("{e.name}: not handled")
        }
    }
    sys.unmap(page, 4096)
    sys.close_fd(ends.first)
    sys.close_fd(ends.second)
}
