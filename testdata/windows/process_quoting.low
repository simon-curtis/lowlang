import std/file
import std/io
import std/os
import std/process
import std/text

fn cases() -> str[] {
    [
        "plain"
        "two words"
        ""
        "say \"hi\""
        "ends with slash\\"
        "slash space \\ "
        "quote after slashes \\\\\"x"
        "tab\there"
        "ünïcode ☃ 日本語"
        "a\\b"
        "\""
        "\\\\"
        "C:\\Program Files\\x y\\"
        "%PATH% ^& | < >"
        "trailing quote\""
        "a  b"
        "--flag=\"v w\""
    ]
}

fn child(rest: str[]) {
    for i, arg in rest {
        print("{i}: {arg.len} <{arg}>")
    }
}

fn report() {
    print("name {text.ends_with(os.args()[0], "my prog.exe")}")
    print("greeting {os.env("GREETING") ?? "unset"}")
    print("dir {text.ends_with(os.getcwd() or "", "dír ☃")}")
}

fn main() ! io.Error {
    let args = os.args()
    if args.len > 1 {
        match args[1] {
            "argv" => child(args[2..])
            _ => report()
        }
        return
    }
    let own = os.executable()?
    var arguments: str[] = ["argv"]
    for arg in cases() {
        arguments.push(arg)
    }
    let spawned = process.run(process.Command { program: own, args: arguments }, [])?
    print(text.trim(str(spawned.stdout)))

    let root = file.temp_dir("low-quoting-")?
    let folder = "{root}/dir with space"
    let place = "{folder}/dír ☃"
    file.mkdir_all(place)?
    let program = "{folder}/my prog.exe"
    file.copy(own, program)?
    let env = ["GREETING": "héllo ☃ \"quoted\"", "SystemRoot": os.env("SystemRoot") ?? ""]
    let described = process.run(process.Command { program, args: ["report"], env: some(env), dir: place }, [])?
    print(text.trim(str(described.stdout)))
    file.remove_all(root)?
}
