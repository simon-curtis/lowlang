import std/sync

extern "kernel32" {
    fn GetCurrentThreadId() -> u32
}

fn spin(rounds: i64, done: chan[i64]) {
    var total = 0
    for i in 0..rounds {
        total += i % 7
    }
    done <- total
}

fn locked(results: chan[bool]) {
    sync.lock_thread()
    let home = GetCurrentThreadId()
    var stayed = true
    for round in 0..100 {
        let done = chan[i64]()
        for k in 0..4 {
            spawn spin(20000, done)
        }
        for k in 0..4 {
            let v = (<-done) ?? 0
        }
        sleep(0)
        if GetCurrentThreadId() != home {
            stayed = false
        }
    }
    sync.unlock_thread()
    results <- stayed
}

fn main() {
    let results = chan[bool]()
    for i in 0..3 {
        spawn locked(results)
    }
    for i in 0..3 {
        print((<-results) ?? false)
    }
}
