extern "c" {
    fn malloc(n: i64) -> ptr
    fn free(p: ptr)
    fn qsort(base: ptr, n: i64, size: i64, compare: extern fn(ptr[f64], ptr[f64]) -> i32)
}

extern "m" {
    fn pow(x: f64, y: f64) -> f64
    fn fmod(x: f64, y: f64) -> f64
    fn ldexp(x: f64, exponent: i32) -> f64
    fn atan2(y: f64, x: f64) -> f64
    fn cos(x: f64) -> f64
}

fn weigh(a: f64, b: f64, c: f64, d: f64, e: f64, f: f64, g: f64, h: f64) -> f64 {
    a + b * 2.0 + c * 3.0 + d * 4.0 + e * 5.0 + f * 6.0 + g * 7.0 + h * 8.0
}

fn crossed(x: f64, y: f64, p: f64, q: f64) -> f64 {
    let weigh_fn: extern fn(f64, f64, f64, f64, f64, f64, f64, f64) -> f64 = weigh
    let u = x + 0.25
    let v = y + 0.5
    let s = p * 1.5
    let t = q - 0.75
    let a = weigh_fn(u, v, t, s, v, u, s, t)
    let b = weigh_fn(v, u, s, t, u, v, t, s)
    a * 1000.0 + b
}

fn swapped_four(x: f64, y: f64) -> f64 {
    let weigh_fn: extern fn(f64, f64, f64, f64, f64, f64, f64, f64) -> f64 = weigh
    let u = x * 1.25
    let v = y * 1.5
    weigh_fn(v, u, v, u, u, v, u, v)
}

fn swapped_pair(x: f64, y: f64) -> f64 {
    let u = x * 1.25
    let v = y * 1.5
    pow(v, u)
}

fn swapped_quad(x: f64, y: f64, p: f64, q: f64) -> f64 {
    let u = x + 0.25
    let v = y + 0.5
    let s = p * 1.5
    let t = q - 0.75
    let a = atan2(u, v)
    let b = atan2(v, u)
    let c = fmod(s, t)
    let d = fmod(t, s)
    a + b * 10.0 + c * 100.0 + d * 1000.0
}

fn across_calls(x: f64, y: f64) -> f64 {
    let first = pow(x, y)
    let second = cos(first * 1.5 + x) + first
    let third = fmod(second, y)
    let fourth = ldexp(third, 2)
    first + second + third + fourth + x * y
}

fn by_distance(a: ptr[f64], b: ptr[f64]) -> i32 {
    let x = load(a)
    let y = load(b)
    let p = x * 1.5
    let q = y * 1.5
    let r = x + y
    let s = x - y
    let scale = pow(2.0, 3.0)
    let left = p * scale + r
    let right = q * scale + r
    let tie = s * scale
    if left < right {
        return -1
    }
    if left > right {
        return 1
    }
    if tie < 0.0 {
        return -1
    }
    0
}

fn sorted() -> str {
    let values: ptr[f64] = malloc(40)
    let five = view(values, 5)
    five[0] = 4.5
    five[1] = 0.5
    five[2] = 3.25
    five[3] = 2.0
    five[4] = 1.75
    qsort(values, 5, 8, by_distance)
    let text = "{five[0]} {five[1]} {five[2]} {five[3]} {five[4]}"
    free(values)
    text
}

fn main() {
    print(crossed(1.5, 2.5, 3.5, 4.5))
    print(swapped_four(1.5, 2.5))
    print(swapped_pair(1.5, 2.5))
    print(swapped_quad(1.5, 2.5, 3.5, 4.5))
    print(across_calls(2.0, 3.0))
    print(sorted())
}
