import std/file
import std/os

fn main() {
    let base = os.env("TEMP") ?? "C:\\Windows\\Temp"
    let outer = "{base}\\mkdir-all-repro"
    let target = "{outer}\\inner"
    file.mkdir_all(target) catch {
        cause => print("mkdir_all failed: {cause}")
    }
    print("inner exists: {file.exists(target)}")
    print("outer exists: {file.exists(outer)}")
    file.remove_all(outer) catch {
        _ => {}
    }
    print("removed: {!file.exists(outer)}")
}
