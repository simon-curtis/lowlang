import std/os
import std/process
import std/text

const workers = 8
const runs = 15

fn churn() {
    var kept: []str = []
    for round in 0..2000000 {
        push(mut kept, "{round} of the garbage that makes the collector run")
        if kept.len > 512 {
            kept = []
        }
    }
}

fn run_child(program: str) -> str {
    let command = process.Command { program, args: ["child"] }
    let output = process.run(command, []) catch {
        cause => return "{cause}"
    }
    text.trim(str(output.stdout))
}

fn run_children(program: str, results: chan[str]) {
    for _ in 0..runs {
        results <- run_child(program)
    }
}

fn main() {
    if os.args().len > 1 {
        print("child")
        return
    }
    let program = os.executable() catch {
        cause => {
            print("executable: {cause}")
            return
        }
    }
    let results = chan[str](0)
    spawn churn()
    for _ in 0..workers {
        spawn run_children(program, results)
    }
    var tally: [str: i64] = [:]
    for _ in 0..workers * runs {
        let outcome = (<-results) ?? "closed"
        tally[outcome] = (tally[outcome] ?? 0) + 1
    }
    for outcome, count in tally {
        print("{outcome}: {count}")
    }
}
