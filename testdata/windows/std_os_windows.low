import std/io
import std/os

extern "kernel32" {
    fn CreateJobObjectW(security: ptr, name: ptr) -> i64
    fn SetInformationJobObject(job: i64, class: i32, info: ptr, size: u32) -> i32
    fn AssignProcessToJobObject(job: i64, process: i64) -> i32
    fn GetCurrentProcess() -> i64
    fn QueryInformationJobObject(job: i64, class: i32, info: ptr, size: u32, returned: ptr) -> i32
}

fn get_outcome() -> str {
    let current = os.getrlimit(os.Resource.OpenFiles) catch {
        Unsupported => return "Unsupported"
        _ => return "other"
    }
    "ok {current.soft == none}"
}

fn set_outcome() -> str {
    os.setrlimit(os.Resource.OpenFiles, os.Rlimit { soft: some(100), hard: some(100) }) catch {
        Unsupported => return "Unsupported"
        _ => return "other"
    }
    "ok"
}

fn limits_out() {
    print("getrlimit {get_outcome()}")
    print("setrlimit {set_outcome()}")
}

fn absent(g: os.Group?) -> bool {
    match g {
        some(_) => false
        none => true
    }
}

fn accounts() {
    print("user by id {os.lookup_user(0) == none}")
    print("user by name {os.lookup_user_name("Administrator") == none}")
    print("group by id {absent(os.lookup_group(0))}")
    print("group by name {absent(os.lookup_group_name("Administrators"))}")
    print("supplementary {os.supplementary_groups("Administrator").len}")
    print("ids {os.uid()} {os.gid()} {os.euid()} {os.egid()}")
}

fn reported_memory() -> i64? {
    let info = io.buffer(144)
    if QueryInformationJobObject(0, 9, pin(info), 144, null) == 0 {
        return none
    }
    if io.le32(info, 16) & 0x200 == 0 {
        return none
    }
    io.le64(info, 120)
}

fn job() {
    let job = CreateJobObjectW(null, null)
    print("job created {job != 0}")
    let info = io.buffer(144)
    io.set_le32(info, 16, 0x200)
    io.set_le64(info, 120, 1073741824)
    print("job limited {SetInformationJobObject(job, 9, pin(info), 144) != 0}")
    print("job assigned {AssignProcessToJobObject(job, GetCurrentProcess()) != 0}")
    let limits = os.cgroup_limits() catch {
        e => return print("job limits {e}")
    }
    let expected = reported_memory()
    let consistent = expected == none || limits.memory_max == expected
    print("job memory consistent {consistent}")
    print("job cpu {limits.cpu == none} high {limits.memory_high == none} current {limits.memory_current == none}")
}

fn main() {
    limits_out()
    accounts()
    job()
}
