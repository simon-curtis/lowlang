import std/file
import std/os

fn main() {
    let here = os.getcwd() catch {
        cause => {
            print("getcwd: {cause}")
            return
        }
    }
    for letter in "CDEFGHIJKLMNOPQRSTUVWXYZ" {
        let drive = "{letter}:"
        if drive[0] == here[0] || !file.is_dir("{drive}/") {
            continue
        }
        file.mkdir_all(drive) catch {
            cause => print("{drive} {cause}")
        }
    }
    file.mkdir_all("{here[..2]}/") catch {
        cause => print("{here[..2]}/ {cause}")
    }
    print("roots exist")
}
