import std/filepath

fn main() {
    let p = "C:\\data\\scripts\\query.sql"
    print("base: {filepath.base(p)}")
    print("dir: {filepath.dir(p)}")
    print("ext: {filepath.ext(p)}")
    print("absolute: {filepath.is_absolute(p)}")
    print("join: {filepath.join(["C:\\data", "query.sql"])}")
    print("clean: {filepath.clean("C:\\data\\..\\scripts")}")
    print("unc absolute: {filepath.is_absolute("\\\\server\\share\\x.sql")}")
    print("drive relative: {filepath.is_absolute("C:x")} {filepath.is_absolute("\\x")}")
}
