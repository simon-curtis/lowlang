extern "c" {
    fn strlen(s: ptr[u8]) -> i64
    fn abs(n: i32) -> i32
    fn malloc(n: i64) -> ptr
    fn free(p: ptr)
    fn sprintf(buf: ptr[u8], format: ptr[u8], ...) -> i32
    fn strtol(s: ptr[u8], mut end: ptr, base: i32) -> i32
    fn div(a: i32, b: i32) -> DivT
    fn toupper(c: i32) -> i32
    fn qsort(base: ptr, n: i64, size: i64, compare: extern fn(ptr[i64], ptr[i64]) -> i32)
}

extern "m" {
    fn cos(x: f64) -> f64
    fn pow(x: f64, y: f64) -> f64
    fn ldexp(x: f64, exponent: i32) -> f64
    fn frexp(x: f64, mut exponent: i32) -> f64
    fn modf(x: f64, mut whole: f64) -> f64
}

extern "kernel32" {
    fn GetCurrentProcessId() -> u32
    fn lstrlenA(s: ptr[u8]) -> i32
    fn MulDiv(number: i32, numerator: i32, denominator: i32) -> i32
}

extern struct DivT {
    quot: i32
    rem: i32
}

fn ascending(a: ptr[i64], b: ptr[i64]) -> i32 {
    let x = load(a)
    let y = load(b)
    if x < y {
        return -1
    }
    if x > y {
        return 1
    }
    0
}

fn main() {
    print(strlen(cstr("hello")))
    print(abs(-42))
    let d = div(17, 5)
    print("{d.quot} {d.rem}")

    print(cos(0.0))
    print(pow(2.0, 10.0))
    print(ldexp(1.5, 3))
    var e: i32 = 0
    let m = frexp(48.0, mut e)
    print("{m} {e}")
    var whole = 0.0
    let frac = modf(3.25, mut whole)
    print("{frac} {whole}")

    var end: ptr = null
    print(strtol(cstr("123abc"), mut end, 10))
    print(str(end))

    let buf: ptr[u8] = malloc(64)
    print(sprintf(buf, cstr("%d %.1f %d %.2f %s %d"), 1, 2.5, 3, 4.25, cstr("x"), 6))
    print(str(buf))
    free(buf)

    print(toupper('a'))
    print(MulDiv(10, 20, 4))
    print(lstrlenA(cstr("hello")))
    print(GetCurrentProcessId() != 0)

    let numbers: ptr[i64] = malloc(24)
    let three = view(numbers, 3)
    three[0] = 3
    three[1] = 1
    three[2] = 2
    qsort(numbers, 3, 8, ascending)
    print("{three[0]} {three[1]} {three[2]}")
    free(numbers)
}
