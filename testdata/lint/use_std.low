import strs = std/text

fn clamp(amount: i64, lo: i64, hi: i64) -> i64 {
    if amount < lo {
        return lo
    }
    if amount > hi {
        return hi
    }
    amount
}

fn bound(input: f64, low: f64, high: f64) -> f64 {
    match input {
        < low => low,
        > high => high,
        _ => input
    }
}

fn pinned(number: u8, left: u8, right: u8) -> u8 {
    if number < left {
        left
    } else if right < number {
        right
    } else {
        number
    }
}

fn width(code: u32) -> i64 {
    match code {
        < 0x80 => 1,
        < 0x800 => 2,
        < 0x10000 => 3,
        _ => 4
    }
}

fn kept(input: i64, low: i64, high: i64) -> i64 {
    match input {
        < low => low,
        > high => high,
        other => other
    }
}

fn wide(code: i64) -> i64 {
    match code {
        < 0x80 => 1,
        < 0x800 => 2,
        < 0x10000 => 3,
        _ => 4
    }
}

fn smaller(left: f64, right: f64) -> f64 {
    if left < right {
        left
    } else {
        right
    }
}

fn above(number: i64, right: i64) -> bool {
    number > right
}

fn limited(number: i64, left: i64, right: i64) -> i64 {
    if number < left {
        left
    } else if above(number, right) {
        right
    } else {
        number
    }
}

fn main() {
    print(clamp(5, 0, 3) + kept(5, 0, 3) + width(0x41) + wide(0x41) + limited(1, 2, 3) + i64(pinned(1, 2, 3)))
    print(bound(1.0, 2.0, 3.0) + smaller(1.0, 2.0))
    print(strs.upper("ok"))
}
