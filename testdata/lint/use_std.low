import strs = std/text

fn clamp(v: i64, lo: i64, hi: i64) -> i64 {
    if v < lo {
        return lo
    }
    if v > hi {
        return hi
    }
    v
}

fn bound(x: f64, low: f64, high: f64) -> f64 {
    match x {
        < low => low,
        > high => high,
        _ => x
    }
}

fn pinned(n: u8, a: u8, b: u8) -> u8 {
    if n < a {
        a
    } else if b < n {
        b
    } else {
        n
    }
}

fn width(c: u32) -> i64 {
    match c {
        < 0x80 => 1,
        < 0x800 => 2,
        < 0x10000 => 3,
        _ => 4
    }
}

fn kept(x: i64, low: i64, high: i64) -> i64 {
    match x {
        < low => low,
        > high => high,
        other => other
    }
}

fn wide(c: i64) -> i64 {
    match c {
        < 0x80 => 1,
        < 0x800 => 2,
        < 0x10000 => 3,
        _ => 4
    }
}

fn smaller(a: f64, b: f64) -> f64 {
    if a < b {
        a
    } else {
        b
    }
}

fn above(n: i64, b: i64) -> bool {
    n > b
}

fn limited(n: i64, a: i64, b: i64) -> i64 {
    if n < a {
        a
    } else if above(n, b) {
        b
    } else {
        n
    }
}

fn main() {
    print(clamp(5, 0, 3) + kept(5, 0, 3) + width(0x41) + wide(0x41) + limited(1, 2, 3) + i64(pinned(1, 2, 3)))
    print(bound(1.0, 2.0, 3.0) + smaller(1.0, 2.0))
    print(strs.upper("ok"))
}
