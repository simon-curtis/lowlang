struct Point {
    x: i64
    y: i64
}

enum Bad {
    Empty(str)
}

enum Shape {
    Dot(Point)
    Line(Point, Point)
}

fn first(l: i64[]) -> i64? {
    for v in l {
        return v
    }
    none
}

fn parse(s: str) -> i64 ! Bad {
    if s == "" {
        fail Empty("empty")
    }
    s.len
}

fn span(shape: Shape) -> i64 {
    match shape {
        Dot(p) => p.x
        Line(a, b) => b.x - a.x
    }
}

fn main() {
    let p = Point { x: 1, y: 2 }
    var n = 0
    for i in 0..3 {
        n += i
    }
    let scores: [str: i64] = ["a": 1]
    for k, v in scores {
        n += k.len + v
    }
    for name, v in scores {
        n += name.len + v
    }
    let { x: w, y: height } = p
    let add = fn(a: i64, total: i64) -> i64 { a + total }
    let size = parse("") catch {
        Empty(e) => e.len
    }
    let length = parse("ab") catch {
        e => 0
    }
    let ticks = chan[i64](1)
    ticks <- 1
    n += select {
        t = <-ticks => t ?? 0
    }
    print(add(w, height) + n + size + length + span(Shape.Dot(p)) + (first([1]) ?? 0))
}
