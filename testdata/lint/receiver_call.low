struct Stream {
    items: i64[] = []
    sent: i64 = 0
}

fn send(stream: *Stream, item: i64) {
    stream.items.push(item)
}

fn send_twice(stream: *Stream, item: i64) {
    send(stream, item)
    stream.send(item)
}

fn reset(stream: *Stream) {
    stream.sent = 0
}

fn double(mut values: i64[]) {
    for index in 0..values.len {
        values[index] *= 2
    }
}

fn run(stream: *Stream, action: fn(*Stream)) {
    action(stream)
}

fn main() {
    let stream = new(Stream {})
    send(stream, 1)
    send_twice(stream, 2)
    reset(stream)
    run(stream, reset)
    var values = [1, 2]
    double(mut values)
    print(stream.items.len + values[0])
}
