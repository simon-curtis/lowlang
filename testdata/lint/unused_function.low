const limit = 10

const spare = 20

struct Pair {
    left: i64
    right: i64
}

struct Spare {
    value: i64
}

enum Spin {
    Up
    Down
}

fn helper(pair: Pair) -> i64 {
    pair.left + pair.right
}

fn chained(value: i64) -> i64 {
    leftover(value)
}

fn leftover(value: i64) -> i64 {
    value + spare
}

fn main() {
    print(helper(Pair { left: limit, right: 2 }))
}
