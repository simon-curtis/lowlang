struct Stream {
    items: i64[] = []
    sent: i64 = 0
    flush: fn(i64) -> i64
}

enum Holder {
    Held(*Stream)
}

fn held(stream: *Stream) -> Holder {
    Held(stream)
}

fn send(stream: *Stream, item: i64) {
    stream.items.push(item)
}

fn count(stream: *Stream) -> i64 {
    stream.items.len
}

fn total(stream: *Stream) -> i64 {
    count(stream) + stream.sent
}

fn flush(stream: *Stream, extra: i64) -> i64 {
    stream.sent += extra
    stream.sent
}

fn double(mut values: i64[]) {
    for index in 0..values.len {
        values[index] *= 2
    }
}

fn main() {
    let stream = new(Stream { flush: fn(extra: i64) -> i64 { extra } })
    stream.send(3)
    var values = [1, 2]
    values.double()
    match held(stream) {
        Held(inner) => inner.send(4)
    }
    print(count(stream) + total(stream) + flush(stream, 1) + values[0])
}
