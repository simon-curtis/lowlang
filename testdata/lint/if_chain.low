fn width(number: i64) -> i64 {
    var out = 0
    if number == 4 {
        out = 1
    } else if number == 16 {
        out = 4
    } else {
        out = 3
    }
    out
}

fn tag(name: str) -> i64 {
    if name == "a" {
        1
    } else if "b" == name {
        2
    } else if name == "c" {
        3
    } else {
        0
    }
}

fn byte_class(bytes: u8[], index: i64) -> i64 {
    if bytes[index] == 'x' {
        1
    } else if bytes[index] == 'y' {
        2
    } else {
        0
    }
}

fn sign(number: i64) -> i64 {
    if number == -1 {
        1
    } else if number == -2 {
        2
    } else {
        0
    }
}

enum Mode {
    Fast
    Slow
    Idle
}

fn speed(mode: Mode) -> i64 {
    if mode == Fast {
        2
    } else if mode == Slow {
        1
    } else {
        0
    }
}

fn mixed_tests(number: i64) -> i64 {
    if number == 4 {
        1
    } else if number > 16 {
        2
    } else {
        0
    }
}

fn bucket(number: i64) -> i64 {
    if number < 0 {
        0
    } else if 10 > number {
        1
    } else if number != 10 {
        2
    } else {
        3
    }
}

fn two_variables(left: i64, right: i64, code: i64) -> i64 {
    if left == right {
        1
    } else if left == code {
        2
    } else {
        0
    }
}

fn main() {
    print(two_variables(1, 1, 2))
    print(mixed_tests(5))
    print(bucket(10))
    print(sign(-1))
    print(speed(Fast))
    print(width(4))
    print(tag("b"))
    print(byte_class([120], 0))
}
