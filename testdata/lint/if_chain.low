fn width(n: i64) -> i64 {
    var out = 0
    if n == 4 {
        out = 1
    } else if n == 16 {
        out = 4
    } else {
        out = 3
    }
    out
}

fn tag(name: str) -> i64 {
    if name == "a" {
        1
    } else if "b" == name {
        2
    } else if name == "c" {
        3
    } else {
        0
    }
}

fn byte_class(bytes: []u8, i: i64) -> i64 {
    if bytes[i] == 'x' {
        1
    } else if bytes[i] == 'y' {
        2
    } else {
        0
    }
}

fn sign(n: i64) -> i64 {
    if n == -1 {
        1
    } else if n == -2 {
        2
    } else {
        0
    }
}

enum Mode {
    Fast
    Slow
    Idle
}

fn speed(m: Mode) -> i64 {
    if m == Fast {
        2
    } else if m == Slow {
        1
    } else {
        0
    }
}

fn main() {
    print(sign(-1))
    print(speed(Fast))
    print(width(4))
    print(tag("b"))
    print(byte_class([120], 0))
}
