fn one_guard(n: i64) -> i64 {
    if n < 0 {
        return 0
    }
    n
}

fn more_than_return(n: i64, mut out: i64) -> i64 {
    if n < 0 {
        out = 1
        return 0
    }
    if n < 10 {
        return 1
    }
    2
}

fn statements_after(n: i64) -> i64 {
    if n < 0 {
        return 0
    }
    if n < 10 {
        return 1
    }
    let doubled = n * 2
    doubled
}

fn mixed_subjects(a: i64, b: i64) -> i64 {
    if a < 0 {
        return 0
    }
    if b < 0 {
        return 1
    }
    2
}

fn computed_test(n: i64) -> i64 {
    if n % 3 == 0 {
        return 0
    }
    if n % 5 == 0 {
        return 1
    }
    2
}

fn two_variables(a: i64, b: i64, c: i64) -> i64 {
    if a < b {
        return 0
    }
    if a < c {
        return 1
    }
    2
}

fn no_value(n: i64, mut out: i64) {
    if n < 0 {
        return
    }
    if n < 10 {
        return
    }
    out = n
}

fn main() {
    var out = 0
    no_value(20, mut out)
    print(one_guard(1) + more_than_return(1, mut out) + statements_after(1) + mixed_subjects(1, 2))
    print(computed_test(4) + two_variables(1, 2, 3) + out)
}
