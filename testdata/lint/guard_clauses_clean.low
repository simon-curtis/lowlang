fn one_guard(number: i64) -> i64 {
    if number < 0 {
        return 0
    }
    number
}

fn more_than_return(number: i64, mut out: i64) -> i64 {
    if number < 0 {
        out = 1
        return 0
    }
    if number < 10 {
        return 1
    }
    2
}

fn statements_after(number: i64) -> i64 {
    if number < 0 {
        return 0
    }
    if number < 10 {
        return 1
    }
    let doubled = number * 2
    doubled
}

fn mixed_subjects(left: i64, right: i64) -> i64 {
    if left < 0 {
        return 0
    }
    if right < 0 {
        return 1
    }
    2
}

fn computed_test(number: i64) -> i64 {
    if number % 3 == 0 {
        return 0
    }
    if number % 5 == 0 {
        return 1
    }
    2
}

fn not_a_number(left: f64, right: f64) -> f64 {
    if right != right {
        return left
    }
    if right < left {
        return left - right
    }
    left
}

fn no_value(number: i64, mut out: i64) {
    if number < 0 {
        return
    }
    if number < 10 {
        return
    }
    out = number
}

fn main() {
    var out = 0
    no_value(20, mut out)
    print(one_guard(1) + more_than_return(1, mut out) + statements_after(1) + mixed_subjects(1, 2))
    print(computed_test(4) + out)
    print(not_a_number(1.0, 2.0))
}
