const base = 8

fn unbounded() -> f32 {
    1_000_000_000.0
}

fn mask() -> u32 {
    ~(1 << 4) & 0xff
}

fn window() -> i64 {
    base * 1024
}

fn narrow() -> f32 {
    f32(base) / 2.0
}

fn label() -> str {
    "low"
}

fn verbose() -> bool {
    !true
}

fn computed() -> i64 {
    let n = 4
    n * 2
}

fn called() -> i64 {
    window() + 1
}

fn interpolated() -> str {
    "{base}"
}

fn scaled(n: i64) -> i64 {
    n * 2
}

fn passed() -> i64 {
    3
}

fn apply(f: fn() -> i64) -> i64 {
    f()
}

fn optional() -> i64? {
    4
}

fn noop() {}

fn main() {
    print(unbounded())
    print(mask())
    print(narrow())
    print(label())
    print(verbose())
    print(computed())
    print(called())
    print(interpolated())
    print(scaled(1))
    print(apply(passed))
    print(optional() ?? 0)
    noop()
}
