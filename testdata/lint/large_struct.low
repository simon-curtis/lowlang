struct Quad {
    a: i64 = 0
    b: i64 = 0
    c: i64 = 0
    d: i64 = 0
}

struct Sixteen {
    q0: Quad = Quad {}
    q1: Quad = Quad {}
    q2: Quad = Quad {}
    q3: Quad = Quad {}
}

struct Wide {
    s0: Sixteen = Sixteen {}
    s1: Sixteen = Sixteen {}
    s2: Sixteen = Sixteen {}
    s3: Sixteen = Sixteen {}
}

struct Narrow {
    s0: Sixteen = Sixteen {}
    s1: Sixteen = Sixteen {}
    s2: Sixteen = Sixteen {}
    q0: Quad = Quad {}
    q1: Quad = Quad {}
    q2: Quad = Quad {}
    a: i64 = 0
    b: i64 = 0
    c: i64 = 0
}

struct Split {
    head: Sixteen
    rest: *Wide
}

struct Holder[T] {
    item: T
    wide: Wide
}

