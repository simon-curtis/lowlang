fn first_even(grid: [][]i64) -> i64 {
    var found = -1
    for i, row in grid {
        var done = false
        for cell in row {
            if (i + cell) % 2 == 0 {
                found = cell
                done = true
                break
            }
        }
        if done {
            break
        }
    }
    found
}

fn clean_rows(grid: [][]i64) -> i64 {
    var count = 0
    for row in grid {
        var clean = true
        for cell in row {
            if cell < 0 {
                clean = false
                break
            }
        }
        if !clean {
            continue
        }
        count += 1
    }
    count
}

fn labelled(grid: [][]i64, want: i64) -> bool {
    var hit = false
    rows: for row in grid {
        cells: for cell in row {
            if cell == want {
                hit = true
                break cells
            }
            if cell > want {
                break rows
            }
        }
        if hit {
            break rows
        }
    }
    hit
}

fn main() {
    let grid = [[1, 3], [-2, 4]]
    print(first_even(grid))
    print(clean_rows(grid))
    print(labelled(grid, 4))
}
