fn main() {
    var count = 1
    var total = 0
    total += count
    var xs: i64[] = []
    xs.push(total)
    var ys: i64[] = [1]
    print(xs.len + ys.len + forked())
}

fn forked() -> i64 {
    var left, right = fork { 1, 2 }
    var count, step = fork { 3, 4 }
    count += step
    left + right + count
}
