fn one_test(number: i64) -> i64 {
    if number == 4 {
        1
    } else {
        0
    }
}

fn no_else(number: i64, mut out: i64) {
    if number == 4 {
        out = 1
    } else if number == 16 {
        out = 2
    }
}

fn mixed_subjects(left: i64, right: i64) -> i64 {
    if left == 4 {
        1
    } else if right == 16 {
        2
    } else {
        0
    }
}

fn computed_test(number: i64) -> i64 {
    if number % 3 == 0 {
        1
    } else if number > 16 {
        2
    } else {
        0
    }
}

fn already_match(number: i64) -> i64 {
    match number {
        4 => 1,
        16 => 2,
        _ => 0
    }
}

fn main() {
    var out = 0
    no_else(4, mut out)
    print(one_test(4) + out + mixed_subjects(1, 2) + computed_test(5) + already_match(4))
}
