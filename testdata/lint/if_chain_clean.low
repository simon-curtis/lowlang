fn one_test(n: i64) -> i64 {
    if n == 4 {
        1
    } else {
        0
    }
}

fn no_else(n: i64, mut out: i64) {
    if n == 4 {
        out = 1
    } else if n == 16 {
        out = 2
    }
}

fn mixed_subjects(a: i64, b: i64) -> i64 {
    if a == 4 {
        1
    } else if b == 16 {
        2
    } else {
        0
    }
}

fn computed_test(n: i64) -> i64 {
    if n % 3 == 0 {
        1
    } else if n > 16 {
        2
    } else {
        0
    }
}

fn two_variables(a: i64, b: i64, c: i64) -> i64 {
    if a == b {
        1
    } else if a == c {
        2
    } else {
        0
    }
}

fn already_match(n: i64) -> i64 {
    match n {
        4 => 1,
        16 => 2,
        _ => 0
    }
}

fn main() {
    var out = 0
    no_else(4, mut out)
    print(one_test(4) + out + mixed_subjects(1, 2) + computed_test(5) + two_variables(1, 1, 1) + already_match(4))
}
