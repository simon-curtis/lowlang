fn band(code: u32) -> i64 {
    if code < 0x80 {
        return 1
    }
    if code < 0x800 {
        return 2
    }
    if code < 0x10000 {
        return 3
    }
    0
}

fn after_other_guard(empty: bool, number: i64) -> str {
    if empty {
        return ""
    }
    if number == 0 {
        return "none"
    }
    if number != 1 {
        return "many"
    }
    "one"
}

fn constant_first(number: i64) -> i64 {
    if 10 <= number {
        return 2
    }
    if 0 > number {
        return 0
    }
    return 1
}

enum Mode {
    Fast
    Slow
    Idle
}

fn speed(mode: Mode) -> i64 {
    if mode == Fast {
        return 2
    }
    if mode == Slow {
        return 1
    }
    0
}

fn two_variables(left: i64, right: i64, code: i64) -> i64 {
    if left < right {
        return 0
    }
    if left < code {
        return 1
    }
    2
}

fn subject_on_right(item: i64, lo: i64, hi: i64) -> i64 {
    if lo > item {
        return -1
    }
    if hi < item {
        return 1
    }
    0
}

fn main() {
    print(two_variables(1, 2, 3) + subject_on_right(1, 2, 3))
    print(band(0x1F600))
    print(after_other_guard(false, 2))
    print(constant_first(5))
    print(speed(Idle))
}
