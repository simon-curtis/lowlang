fn band(c: u32) -> i64 {
    if c < 0x80 {
        return 1
    }
    if c < 0x800 {
        return 2
    }
    if c < 0x10000 {
        return 3
    }
    0
}

fn after_other_guard(empty: bool, n: i64) -> str {
    if empty {
        return ""
    }
    if n == 0 {
        return "none"
    }
    if n != 1 {
        return "many"
    }
    "one"
}

fn constant_first(n: i64) -> i64 {
    if 10 <= n {
        return 2
    }
    if 0 > n {
        return 0
    }
    return 1
}

enum Mode {
    Fast
    Slow
    Idle
}

fn speed(m: Mode) -> i64 {
    if m == Fast {
        return 2
    }
    if m == Slow {
        return 1
    }
    0
}

fn two_variables(a: i64, b: i64, c: i64) -> i64 {
    if a < b {
        return 0
    }
    if a < c {
        return 1
    }
    2
}

fn subject_on_right(v: i64, lo: i64, hi: i64) -> i64 {
    if lo > v {
        return -1
    }
    if hi < v {
        return 1
    }
    0
}

fn main() {
    print(two_variables(1, 2, 3) + subject_on_right(1, 2, 3))
    print(band(0x1F600))
    print(after_other_guard(false, 2))
    print(constant_first(5))
    print(speed(Idle))
}
