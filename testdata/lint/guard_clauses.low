fn char_len(c: u32) -> i64 {
    if c < 0x80 {
        return 1
    }
    if c < 0x800 {
        return 2
    }
    if c < 0x10000 {
        return 3
    }
    4
}

fn after_other_guard(empty: bool, n: i64) -> str {
    if empty {
        return ""
    }
    if n == 0 {
        return "none"
    }
    if n != 1 {
        return "many"
    }
    "one"
}

fn constant_first(n: i64) -> i64 {
    if 10 <= n {
        return 2
    }
    if 0 > n {
        return 0
    }
    return 1
}

enum Mode {
    Fast
    Slow
    Idle
}

fn speed(m: Mode) -> i64 {
    if m == Fast {
        return 2
    }
    if m == Slow {
        return 1
    }
    0
}

fn main() {
    print(char_len(0x1F600))
    print(after_other_guard(false, 2))
    print(constant_first(5))
    print(speed(Idle))
}
