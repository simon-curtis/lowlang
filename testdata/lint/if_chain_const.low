const small = 4
const large = 16
const label = "b"

fn width(n: i64) -> i64 {
    if n == small {
        1
    } else if large == n {
        4
    } else {
        3
    }
}

fn mixed(n: i64) -> i64 {
    if n == small {
        1
    } else if n == 7 {
        2
    } else if n == large {
        3
    } else {
        0
    }
}

fn tag(name: str) -> i64 {
    if name == "a" {
        1
    } else if name == label {
        2
    } else {
        0
    }
}

fn shadowed(small: i64, n: i64) -> i64 {
    if n == small {
        1
    } else if n == large {
        2
    } else {
        0
    }
}

fn ordered(n: i64) -> i64 {
    if n == small {
        1
    } else if n < large {
        2
    } else {
        0
    }
}

fn main() {
    print(width(4))
    print(mixed(7))
    print(tag("b"))
    print(shadowed(1, 1))
    print(ordered(1))
}
