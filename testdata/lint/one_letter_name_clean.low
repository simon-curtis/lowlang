struct Point {
    x: i64
    y: i64
}

fn first[T](list: T[], _: i64) -> T? {
    for item in list {
        return item
    }
    none
}

fn main() {
    let point = Point { x: 1, y: 2 }
    let { x, y } = point
    var total = 0
    for _ in 0..2 {
        total += 1
    }
    for _, score in ["a": 1] {
        total += score
    }
    print(x + y + total + (first([1], 0) ?? 0))
}
