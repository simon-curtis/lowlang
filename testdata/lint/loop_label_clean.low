fn work_between(grid: [][]i64) -> i64 {
    var seen = 0
    for row in grid {
        var done = false
        for cell in row {
            if cell == 0 {
                done = true
                break
            }
        }
        seen += 1
        if done {
            break
        }
    }
    seen
}

fn opposite_value(grid: [][]i64) -> i64 {
    var seen = 0
    for row in grid {
        var done = false
        for cell in row {
            if cell == 0 {
                done = false
                break
            }
            done = true
        }
        if done {
            break
        }
        seen += 1
    }
    seen
}

fn deeper_loop(grid: [][]i64) -> i64 {
    var seen = 0
    for row in grid {
        var done = false
        for cell in row {
            for k in 0..cell {
                done = true
                break
            }
        }
        if done {
            break
        }
        seen += 1
    }
    seen
}

fn with_else(grid: [][]i64) -> i64 {
    var seen = 0
    for row in grid {
        var done = false
        for cell in row {
            if cell == 0 {
                done = true
                break
            }
        }
        if done {
            break
        } else {
            seen += 1
        }
    }
    seen
}

fn other_flag(grid: [][]i64) -> i64 {
    var seen = 0
    var stop = false
    for row in grid {
        var done = false
        for cell in row {
            if cell == 0 {
                done = true
                break
            }
            if cell < 0 {
                stop = true
            }
        }
        if stop {
            break
        }
        if done {
            seen += 1
        }
    }
    seen
}

fn already_labelled(grid: [][]i64) -> i64 {
    var found = -1
    rows: for row in grid {
        for cell in row {
            if cell % 2 == 0 {
                found = cell
                break rows
            }
        }
    }
    found
}

fn main() {
    let grid = [[1, 3], [0, 4]]
    print(work_between(grid) + opposite_value(grid) + deeper_loop(grid) + with_else(grid) + other_flag(grid) + already_labelled(grid))
}
