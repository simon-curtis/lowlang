import std/container/set
import std/slices
import std/text

fn show(s: set.Set[i64]) -> str {
    text.join(slices.map(set.items(s), fn(x: i64) -> str { "{x}" }), ",")
}

fn main() {
    var s = set.set[i64]()
    print("{set.add(mut s, 3)} {set.add(mut s, 1)} {set.add(mut s, 3)} {set.add(mut s, 2)}")
    print("{set.size(s)} {show(s)}")
    print("{set.has(s, 1)} {set.has(s, 9)}")
    print("{set.remove(mut s, 1)} {set.remove(mut s, 1)} {show(s)}")
    set.add(mut s, 1)
    print(show(s))

    let a = set.from_slice([1, 2, 3, 4, 2, 1])
    let b = set.from_slice([3, 4, 5, 6])
    print("{set.size(a)} {show(a)}")
    print(show(set.union(a, b)))
    print(show(set.intersection(a, b)))
    print(show(set.difference(a, b)))
    print(show(set.difference(b, a)))
    print("{set.is_subset(set.from_slice([2, 3]), a)} {set.is_subset(b, a)} {set.is_subset(a, a)}")

    let empty = set.set[i64]()
    print("{set.is_subset(empty, a)} {set.is_subset(a, empty)} {set.size(empty)}")
    print(show(set.union(empty, empty)).len)

    var names = set.from_slice(["ada", "alan", "ada"])
    set.add(mut names, "grace")
    print(text.join(set.items(names), " "))
    print("{set.has(names, "alan")} {set.size(names)}")

    var many = set.set[i64]()
    for i in 0..1000 {
        set.add(mut many, (i * 7) % 300)
    }
    print(set.size(many))
    for i in 0..300 {
        if i % 3 != 0 {
            set.remove(mut many, i)
        }
    }
    print("{set.size(many)} {set.has(many, 0)} {set.has(many, 1)} {set.has(many, 299)} {set.has(many, 297)}")
}
