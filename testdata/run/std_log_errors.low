import std/io
import std/log

fn closed_descriptor() {
    var failures: []str = []
    let l = log.Logger { fd: 987654 }.with_error_handler(fn(e: io.Error) { push(mut failures, "{e}") })
    l.info("lost")
    l.info("lost again")
    print("descriptor failures {failures.len}")
    print(failures[0])
}

fn failing_stream() {
    var failures = 0
    let stream = io.Stream {
        read: fn(buf) -> i64 ! io.Error { 0 }
        write: fn(data) -> i64 ! io.Error { fail BrokenPipe }
        close: fn() {}
    }
    let l = log.Logger {}.with_stream(stream).with_error_handler(fn(e: io.Error) { failures += 1 })
    l.info("lost")
    print("stream failures {failures}")
}

fn healthy() {
    var failures = 0
    let l = log.Logger { fd: 1, prefix: "ok" }.with_error_handler(fn(e: io.Error) { failures += 1 })
    l.info("delivered")
    print("healthy failures {failures}")
}

fn main() {
    closed_descriptor()
    failing_stream()
    healthy()
}
