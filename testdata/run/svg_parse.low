import std/ui/geometry
import std/ui/svg

fn pt(p: geometry.Point) -> str {
    "{p.x:f2},{p.y:f2}"
}

fn describe(p: geometry.Path) -> str {
    var parts: []str = []
    for s in geometry.segments(p) {
        match s {
            Move(to) => parts.push("M {pt(to)}")
            Line(to) => parts.push("L {pt(to)}")
            Quadratic(c, to) => parts.push("Q {pt(c)} {pt(to)}")
            Cubic(a, b, to) => parts.push("C {pt(a)} {pt(b)} {pt(to)}")
            Close => parts.push("Z")
        }
    }
    var out = ""
    for i, x in parts {
        out += if i == 0 { x } else { " {x}" }
    }
    out
}

fn byte(v: f32) -> i64 {
    i64(v * 255.0 + 0.5)
}

fn paint(p: svg.Paint) -> str {
    match p {
        None => "none"
        Color(c) => "rgba({byte(c.r)},{byte(c.g)},{byte(c.b)},{byte(c.a)})"
        Current => "current"
    }
}

fn rule(r: geometry.FillRule) -> str {
    match r {
        NonZero => "nonzero"
        EvenOdd => "evenodd"
    }
}

fn wrap(body: str) -> str {
    "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'>{body}</svg>"
}

fn paths(label: str, source: str) {
    let icon = svg.parse(source) or {
        print("{label}: failed")
        return
    }
    if icon.shapes.len == 0 {
        print("{label}: no shapes")
    }
    for s in icon.shapes {
        print("{label}: {describe(s.path)}")
    }
}

fn path(label: str, d: str) {
    paths(label, wrap("<path d='{d}'/>"))
}

fn styles(label: str, body: str) {
    let icon = svg.parse(wrap(body)) or {
        print("{label}: failed")
        return
    }
    if icon.shapes.len == 0 {
        print("{label}: no shapes")
    }
    for s in icon.shapes {
        print("{label}: fill={paint(s.fill)} stroke={paint(s.stroke)} width={s.stroke_width:f2} opacity={s.opacity:f2} fill_opacity={s.fill_opacity:f2} stroke_opacity={s.stroke_opacity:f2} rule={rule(s.rule)}")
    }
}

fn viewbox(label: str, attributes: str) {
    let icon = svg.parse("<svg {attributes}><rect width='1' height='1'/></svg>") or {
        print("{label}: failed")
        return
    }
    let v = icon.view_box
    print("{label}: {v.x:f2} {v.y:f2} {v.width:f2} {v.height:f2}")
}

fn attempt(label: str, source: str) {
    let icon = svg.parse(source) catch {
        Syntax(line, column, _) => {
            print("{label}: syntax {line}:{column}")
            return
        }
        NotSvg(name) => {
            print("{label}: not svg {name}")
            return
        }
        BadNumber(attribute, at) => {
            print("{label}: bad number {attribute} at {at}")
            return
        }
        BadPath(at) => {
            print("{label}: bad path at {at}")
            return
        }
        BadValue(attribute) => {
            print("{label}: bad value {attribute}")
            return
        }
    }
    print("{label}: ok {icon.shapes.len}")
}

