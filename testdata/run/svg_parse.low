fn transforms() {
    print("transforms")
    paths("translate", wrap("<path d='M0 0 L1 1' transform='translate(10 20)'/>"))
    paths("translate x", wrap("<path d='M0 0 L1 1' transform='translate(10)'/>"))
    paths("scale", wrap("<path d='M1 1 L2 3' transform='scale(2)'/>"))
    paths("scale xy", wrap("<path d='M1 1 L2 3' transform='scale(2, 3)'/>"))
    paths("rotate", wrap("<path d='M1 0 L2 0' transform='rotate(90)'/>"))
    paths("rotate about", wrap("<path d='M6 5 L7 5' transform='rotate(90 5 5)'/>"))
    paths("rotate half", wrap("<path d='M1 0' transform='rotate(180)'/>"))
    paths("rotate 45", wrap("<path d='M1 0' transform='rotate(45)'/>"))
    paths("skew x", wrap("<path d='M0 1' transform='skewX(45)'/>"))
    paths("skew y", wrap("<path d='M1 0' transform='skewY(45)'/>"))
    paths("matrix", wrap("<path d='M1 1' transform='matrix(1 2 3 4 5 6)'/>"))
    paths("list order", wrap("<path d='M1 1' transform='translate(10 0) scale(2)'/>"))
    paths("list separators", wrap("<path d='M1 1' transform='translate(10,0),scale(2)'/>"))
    paths("group", wrap("<g transform='translate(10 20)'><path d='M0 0 L1 1' transform='scale(2)'/></g>"))
    paths("nested groups", wrap("<g transform='scale(2)'><g transform='translate(1 1)'><path d='M0 0'/></g></g>"))
    paths("curve", wrap("<path d='M0 0 C 1 2 3 4 5 6' transform='translate(1 1)'/>"))
    paths("circle", wrap("<circle cx='0' cy='0' r='1' transform='translate(5 5) scale(2)'/>"))
    paths("rect", wrap("<rect width='2' height='1' transform='rotate(90)'/>"))
    paths("root", "<svg viewBox='0 0 4 4' transform='translate(1 1)'><path d='M0 0 L1 1'/></svg>")
    let uniform = svg.parse(wrap("<path d='M0 0 L1 1' stroke='red' stroke-width='3' transform='scale(2)'/>")) or return
    print("stroke width scaled {uniform.shapes[0].stroke_width:f2}")
    let stretched = svg.parse(wrap("<path d='M0 0 L1 1' stroke='red' transform='scale(2 8)'/>")) or return
    print("stroke width stretched {stretched.shapes[0].stroke_width:f2}")
}

