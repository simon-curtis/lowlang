    paths("rect", wrap("<rect x='1' y='2' width='3' height='4'/>"))
    paths("rounded", wrap("<rect width='4' height='4' rx='1'/>"))
    paths("rounded ry", wrap("<rect width='4' height='2' ry='5'/>"))
    paths("circle", wrap("<circle cx='5' cy='5' r='2'/>"))
    paths("ellipse", wrap("<ellipse cx='0' cy='0' rx='4' ry='2'/>"))
    paths("line", wrap("<line x1='1' y1='2' x2='3' y2='4' stroke='red'/>"))
    paths("polyline", wrap("<polyline points='1,2 3,4 5,0'/>"))
    paths("polygon", wrap("<polygon points='1 2, 3 4, 5 0'/>"))
    paths("empty rect", wrap("<rect width='0' height='4'/>"))
    paths("empty circle", wrap("<circle r='0'/>"))
    paths("skipped", wrap("<defs><path d='M0 0 L1 1'/></defs><title>t</title><desc>d</desc><text>x</text><use href='#a'/><path d='M0 0 L9 9'/>"))
    paths("nested", wrap("<g><g><path d='M0 0 L1 1'/></g><path d='M2 2 L3 3'/></g>"))
    paths("empty data", wrap("<path d=''/><path/>"))
    paths("hidden", wrap("<g display='none'><path d='M0 0 L1 1'/></g><path style='display:none' d='M0 0 L2 2'/><path d='M0 0 L3 3'/>"))
    paths("paints nothing", wrap("<path d='M0 0 L1 1' fill='none'/>"))
}

fn inheritance() {
    print("inheritance")
    styles("default", "<path d='M0 0 L1 1'/>")
    styles("attributes", "<path d='M0 0 L1 1' fill='red' stroke='#00f' stroke-width='3' opacity='0.5' fill-opacity='0.25' stroke-opacity='0.75' fill-rule='evenodd'/>")
    styles("group", "<g fill='green' stroke='blue' stroke-width='2' fill-rule='evenodd'><path d='M0 0 L1 1'/></g>")
    styles("override", "<g fill='green' stroke='blue'><path d='M0 0 L1 1' fill='none'/><path d='M0 0 L2 2' stroke='currentColor'/></g>")
    styles("nested", "<g fill='green' stroke='red'><g stroke='blue'><path d='M0 0 L1 1'/></g></g>")
    styles("style wins", "<path d='M0 0 L1 1' fill='red' style='fill: blue; stroke:#fff ; stroke-width:4'/>")
    styles("opacity multiplies", "<g opacity='0.5'><g opacity='50%'><path d='M0 0 L1 1' opacity='0.4'/></g></g>")
    styles("opacity does not leak", "<g opacity='0.5'><path d='M0 0 L1 1'/></g><path d='M0 0 L2 2'/>")
    styles("fill opacity inherits", "<g fill-opacity='0.5'><path d='M0 0 L1 1'/></g>")
    styles("inherit keyword", "<g fill='red'><path d='M0 0 L1 1' fill='inherit'/></g>")
    let root = svg.parse("<svg viewBox='0 0 4 4' fill='red' stroke='black'><path d='M0 0 L1 1'/></svg>") or return
    print("root: fill={paint(root.shapes[0].fill)} stroke={paint(root.shapes[0].stroke)}")
    styles("stroke only none width", "<path d='M0 0 L1 1' fill='none' stroke='red' stroke-width='0'/>")
    styles("url paint", "<path d='M0 0 L1 1' fill='url(#g)'/>")
}

