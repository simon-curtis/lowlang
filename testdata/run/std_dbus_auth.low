import std/dbus
import std/io
import std/net
import std/os
import std/text

const guid = "00112233445566778899aabbccddeeff"

struct Step {
    send: []str
    lines: i64
}

struct ServerCase {
    name: str
    auth: dbus.ServerAuth
    nul: bool
    steps: []Step
}

struct Reply {
    line: str
    reads: i64
}

struct ClientCase {
    name: str
    replies: []Reply
}

fn uid_hex(delta: i64) -> str {
    text.encode_hex(bytes("{os.euid() + delta}"))
}

fn mask(s: str) -> str {
    let other = text.replace(s, uid_hex(1), "<other uid hex>")
    text.replace(other, uid_hex(0), "<uid hex>")
}

fn external(delta: i64) -> str {
    "AUTH EXTERNAL {uid_hex(delta)}\r\n"
}

fn step(send: []str, lines: i64) -> Step {
    Step { send, lines }
}

fn server_auth() -> dbus.ServerAuth {
    dbus.ServerAuth { guid }
}

fn server_cases() -> []ServerCase {
    let anonymous = dbus.ServerAuth { guid, anonymous: true }
    let no_fds = dbus.ServerAuth { guid, unix_fds: false }
    [
        ServerCase { name: "EXTERNAL, file descriptors, BEGIN", auth: server_auth(), nul: true, steps: [
            step([external(0)], 1),
            step(["NEGOTIATE_UNIX_FD\r\n"], 1),
            step(["BEGIN\r\n"], 0),
        ] },
        ServerCase { name: "EXTERNAL without file descriptors", auth: no_fds, nul: true, steps: [
            step([external(0)], 1),
            step(["NEGOTIATE_UNIX_FD\r\n"], 1),
            step(["BEGIN\r\n"], 0),
        ] },
        ServerCase { name: "EXTERNAL with another uid", auth: server_auth(), nul: true, steps: [
            step([external(1)], 1),
            step(["AUTH ANONYMOUS 78\r\n"], 1),
            step(["CANCEL\r\n"], 1),
            step([external(0)], 1),
            step(["BEGIN\r\n"], 0),
        ] },
        ServerCase { name: "EXTERNAL for an explicit uid", auth: dbus.ServerAuth { guid, uid: os.euid() }, nul: true, steps: [
            step([external(0)], 1),
            step(["BEGIN\r\n"], 0),
        ] },
        ServerCase { name: "EXTERNAL for a uid other than the caller", auth: dbus.ServerAuth { guid, uid: os.euid() + 1 }, nul: true, steps: [
            step([external(0)], 1),
            step([external(1)], 1),
            step(["BEGIN\r\n"], 0),
        ] },
        ServerCase { name: "ANONYMOUS accepted", auth: anonymous, nul: true, steps: [
            step(["AUTH ANONYMOUS 6c6f77\r\n"], 1),
            step(["BEGIN\r\n"], 0),
        ] },
        ServerCase { name: "EXTERNAL answered with DATA", auth: server_auth(), nul: true, steps: [
            step(["AUTH EXTERNAL\r\n"], 1),
            step(["DATA {uid_hex(0)}\r\n"], 1),
            step(["BEGIN\r\n"], 0),
        ] },
        ServerCase { name: "DATA with another uid", auth: server_auth(), nul: true, steps: [
            step(["AUTH EXTERNAL\r\n"], 1),
            step(["DATA {uid_hex(1)}\r\n"], 1),
            step([external(0)], 1),
            step(["BEGIN\r\n"], 0),
        ] },
        ServerCase { name: "DATA without AUTH", auth: server_auth(), nul: true, steps: [
            step(["DATA {uid_hex(0)}\r\n"], 1),
            step([external(0)], 1),
            step(["BEGIN\r\n"], 0),
        ] },
        ServerCase { name: "CANCEL after OK", auth: server_auth(), nul: true, steps: [
            step([external(0)], 1),
            step(["CANCEL\r\n"], 1),
            step(["NEGOTIATE_UNIX_FD\r\n"], 1),
            step([external(0)], 1),
            step(["BEGIN\r\n"], 0),
        ] },
        ServerCase { name: "unknown mechanism", auth: server_auth(), nul: true, steps: [
            step(["AUTH DBUS_COOKIE_SHA1 6c6f77\r\n"], 1),
            step([external(0)], 1),
            step(["BEGIN\r\n"], 0),
        ] },
        ServerCase { name: "unknown command", auth: server_auth(), nul: true, steps: [
            step(["HELLO\r\n"], 1),
            step([external(0)], 1),
            step(["BEGIN\r\n"], 0),
        ] },
        ServerCase { name: "lines split across writes", auth: server_auth(), nul: true, steps: [
            step(["AUTH EXT", "ERNAL {uid_hex(0)}\r", "\n"], 1),
            step(["BEGIN\r\n"], 0),
        ] },
        ServerCase { name: "commands in one write", auth: server_auth(), nul: true, steps: [
            step(["{external(0)}NEGOTIATE_UNIX_FD\r\nBEGIN\r\n"], 2),
        ] },
        ServerCase { name: "BEGIN before authenticating", auth: server_auth(), nul: true, steps: [
            step(["BEGIN\r\n"], 0),
        ] },
        ServerCase { name: "no initial NUL", auth: server_auth(), nul: false, steps: [
            step([external(0)], 0),
        ] },
        ServerCase { name: "invalid hexadecimal", auth: server_auth(), nul: true, steps: [
            step(["AUTH EXTERNAL zz\r\n"], 0),
        ] },
        ServerCase { name: "line without an end", auth: server_auth(), nul: true, steps: [
            step([text.repeat("A", 20000)], 0),
        ] },
        ServerCase { name: "closed before BEGIN", auth: server_auth(), nul: true, steps: [
            step([external(0)], 1),
        ] },
        ServerCase { name: "closed before anything", auth: server_auth(), nul: true, steps: [] },
    ]
}

fn client_cases() -> []ClientCase {
    [
        ClientCase { name: "EXTERNAL accepted, file descriptors agreed", replies: [
            Reply { line: "OK {guid}", reads: 1 },
            Reply { line: "AGREE_UNIX_FD", reads: 1 },
        ] },
        ClientCase { name: "file descriptors refused", replies: [
            Reply { line: "OK {guid}", reads: 1 },
            Reply { line: "ERROR", reads: 1 },
        ] },
        ClientCase { name: "ANONYMOUS after a rejection", replies: [
            Reply { line: "REJECTED EXTERNAL ANONYMOUS", reads: 1 },
            Reply { line: "OK {guid}", reads: 1 },
            Reply { line: "AGREE_UNIX_FD", reads: 1 },
        ] },
        ClientCase { name: "ANONYMOUS rejected too", replies: [
            Reply { line: "REJECTED EXTERNAL ANONYMOUS", reads: 1 },
            Reply { line: "REJECTED EXTERNAL ANONYMOUS", reads: 0 },
        ] },
        ClientCase { name: "EXTERNAL rejected, no ANONYMOUS", replies: [
            Reply { line: "REJECTED EXTERNAL", reads: 0 },
        ] },
        ClientCase { name: "EXTERNAL answered through DATA", replies: [
            Reply { line: "DATA", reads: 1 },
            Reply { line: "OK {guid}", reads: 1 },
            Reply { line: "AGREE_UNIX_FD", reads: 1 },
        ] },
        ClientCase { name: "unexpected answer", replies: [
            Reply { line: "HELLO", reads: 0 },
        ] },
        ClientCase { name: "server closes during authentication", replies: [] },
    ]
}

struct Raw {
    handle: net.ConnHandle
    pending: []u8
}

fn line_end(b: []u8) -> i64 {
    var i = 0
    for i + 1 < b.len {
        if b[i] == '\r' && b[i + 1] == '\n' {
            return i
        }
        i += 1
    }
    -1
}

fn read_line_from(r: *Raw) -> str {
    let chunk = io.buffer(4096)
    for {
        let end = line_end(r.pending)
        if end >= 0 {
            let line = str(r.pending[..end])
            var kept = io.buffer(0)
            io.append(mut kept, r.pending[end + 2..])
            r.pending = kept
            return line
        }
        let n = net.read_on(r.handle, chunk) or 0
        if n == 0 {
            return "<closed>"
        }
        io.append(mut r.pending, chunk[..n])
    }
    ""
}

fn accept_task(h: net.ConnHandle, auth: dbus.ServerAuth, result: chan[str]) {
    let c = dbus.accept_over_handle(h, auth) catch {
        e => {
            result <- "{e}"
            return
        }
    }
    let fds = dbus.passes_fds_on(c)
    dbus.shutdown_on(c)
    result <- "accepted, file descriptors {fds}"
}

fn run_server_case(c: ServerCase) {
    print("server: {c.name}")
    using var pair = net.socketpair() or panic("pair")
    let raw = net.detach(mut pair.first)
    let served = net.detach(mut pair.second)
    raw.timeouts.read = 5000
    let result = chan[str](1)
    spawn accept_task(served, c.auth, result)
    let peer = new(Raw { handle: raw, pending: [] })
    var first = true
    for s in c.steps {
        for part in s.send {
            var data = io.buffer(0)
            if first && c.nul {
                push(mut data, 0)
            }
            first = false
            io.append(mut data, bytes(part))
            let shown = if part.len > 200 { "{part[..20]}... ({part.len} bytes)" } else { text.quote(mask(part)) }
            print("  > {shown}")
            net.write_all_on(raw, data) or {}
        }
        for _ in 0..s.lines {
            let line = read_line_from(peer)
            print("  < {mask(line)}")
        }
    }
    net.close_on(raw)
    let outcome = <-result
    match outcome {
        some(text) => print("  {text}")
        none => print("  no result")
    }
}

fn connect_task(h: net.ConnHandle, result: chan[str]) {
    let c = dbus.connect_over_handle(h, false) catch {
        e => {
            result <- "{e}"
            return
        }
    }
    let line = "connected, guid {dbus.server_guid_on(c)}, file descriptors {dbus.passes_fds_on(c)}"
    dbus.shutdown_on(c)
    result <- line
}

fn run_client_case(c: ClientCase) {
    print("client: {c.name}")
    using var pair = net.socketpair() or panic("pair")
    let raw = net.detach(mut pair.first)
    let client = net.detach(mut pair.second)
    raw.timeouts.read = 5000
    let result = chan[str](1)
    spawn connect_task(client, result)
    let peer = new(Raw { handle: raw, pending: [] })
    let opening = read_line_from(peer)
    var shown = opening
    var nul = false
    if opening.len > 0 && opening[0] == 0 {
        nul = true
        shown = opening[1..]
    }
    print("  < nul {nul}, {mask(shown)}")
    for r in c.replies {
        print("  > {r.line}")
        net.write_all_on(raw, bytes("{r.line}\r\n")) or {}
        for _ in 0..r.reads {
            print("  < {mask(read_line_from(peer))}")
        }
    }
    net.close_on(raw)
    let outcome = <-result
    match outcome {
        some(text) => print("  {text}")
        none => print("  no result")
    }
}

fn main() {
    for c in server_cases() {
        run_server_case(c)
    }
    for c in client_cases() {
        run_client_case(c)
    }
}
