fn suite_dst() -> u8[] {
    bytes("QUUX-V01-CS02-with-P256_XMD:SHA-256_SSWU_RO_")
}

fn hex_of(f: *nistec.Field, a: u64[]) -> str {
    let plain = nistec.element(f)
    nistec.from_mont(f, plain, a)
    text.encode_hex(nistec.encode(plain))
}

fn plain_hex(a: u64[]) -> str {
    text.encode_hex(nistec.encode(a))
}

fn verdict(label: str, got: str, want: str) -> str {
    if got == want { "{label} ok" } else { "{label} MISMATCH {got}" }
}

fn coordinates(g: *nistec.Group, p: nistec.Point) -> str[] {
    let a = match nistec.affine(g, p) {
        some(found) => found
        none => return ["infinity", "infinity"]
    }
    [hex_of(g.p, a.x), hex_of(g.p, a.y)]
}

fn check(g: *nistec.Group, index: i64, v: Vector) {
    let dst = suite_dst()
    let u = hashtocurve.hash_to_field(g.p, hash.sha256(), bytes(v.msg), dst, 2) catch {
        Length => {
            print("{index}: length error")
            return
        }
    }
    let q0 = hashtocurve.map_to_curve_p256(g, u[0])
    let q1 = hashtocurve.map_to_curve_p256(g, u[1])
    let p = hashtocurve.hash_to_curve_p256(g, bytes(v.msg), dst)
    let c0 = coordinates(g, q0)
    let c1 = coordinates(g, q1)
    let cp = coordinates(g, p)
    var parts: str[] = []
    parts.push(verdict("u0", plain_hex(u[0]), v.u0))
    parts.push(verdict("u1", plain_hex(u[1]), v.u1))
    parts.push(verdict("Q0.x", c0[0], v.q0x))
    parts.push(verdict("Q0.y", c0[1], v.q0y))
    parts.push(verdict("Q1.x", c1[0], v.q1x))
    parts.push(verdict("Q1.y", c1[1], v.q1y))
    parts.push(verdict("P.x", cp[0], v.px))
    parts.push(verdict("P.y", cp[1], v.py))
    print("vector {index}: {parts.join(", ")}")
}

fn main() {
    let g = nistec.p256()
    for i, v in vectors() {
        check(g, i, v)
    }
}
