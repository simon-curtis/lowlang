enum List {
    Cons(i64, *List)
    Nil
}

struct Counter {
    hits: i64
}

struct Pair {
    a: i64
    b: i64
}

fn build(n: i64) -> List {
    var list = List.Nil
    var i = 0
    for i < n {
        i += 1
        list = Cons(i, new(list))
    }
    list
}

fn sum(l: List) -> i64 {
    var total = 0
    var cur = l
    for {
        match cur {
            Cons(v, rest) => {
                total += v
                cur = *rest
            }
            Nil => break
        }
    }
    total
}

fn bump(mut c: Counter) {
    c.hits += 1
}

fn churn(n: i64) {
    var i = 0
    for i < n {
        let junk = new(Pair { a: 7, b: 7 })
        i += 1
    }
}

fn hold(mut x: i64) {
    churn(2000000)
    x += 1
    print(x)
}

fn main() {
    var round = 0
    var total = 0
    for round < 1000 {
        total += sum(build(10000))
        round += 1
    }
    print(total)

    let keep = build(1000)
    churn(1000000)
    print(sum(keep))

    let c = new(Counter { hits: 0 })
    bump(mut *c)
    c.hits += 10
    print(c.hits)
    let alias = c
    alias.hits = 99
    print(c.hits)
    print(c == alias)
    print(c == new(Counter { hits: 99 }))

    hold(mut new(Pair { a: 1, b: 2 }).b)
}
