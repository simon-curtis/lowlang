import std/http
import std/io
import std/net
import std/text

struct Asked {
    hosts: []str
}

fn answer(req: http.Request) -> http.Response {
    let host = http.header(req.headers, "host") ?? ""
    http.response(200, "{text.starts_with(host, "video.example:")} {req.path}")
}

fn serve(l: net.Listener) {
    let handler = fn(req: http.Request) -> http.Response { answer(req) }
    for {
        let c = net.accept(l) catch {
            _ => return
        }
        spawn http.serve_conn(c, handler)
    }
}

fn main() ! io.Error {
    let l = net.listen("127.0.0.1", 0)?
    spawn serve(l)
    let asked = new(Asked { hosts: [] })
    let pinned = fn(host: str) -> [][]u8 ! io.Error {
        push(mut asked.hosts, host)
        [net.parse_ip("127.0.0.1")?]
    }
    let c = http.client().with_version(Http1).with_interface("lo").with_resolver(pinned).build()
    let r = c.get("http://video.example:{l.addr.port}/segment") catch {
        _ => {
            print("request failed")
            return
        }
    }
    print(r.status)
    print(http.text(r))
    for h in asked.hosts {
        print(h)
    }

    let unbound = http.client().with_version(Http1).with_interface("nosuchif0").with_resolver(pinned).build()
    let failed = unbound.get("http://video.example:{l.addr.port}/") catch {
        Connect(_) => {
            print("connect error")
            net.close_listener(l)
            return
        }
        _ => {
            print("other error")
            return
        }
    }
    print(failed.status)
}
