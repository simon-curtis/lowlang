import std/io
import std/net

struct Pair {
    client: net.ConnHandle
    server: net.ConnHandle
}

fn chunk_size() -> i64 {
    65536
}

fn chunks() -> i64 {
    512
}

fn connected(l: net.Listener) -> Pair ! io.Error {
    let listening = l.handle
    let accepted = chan[net.ConnHandle](1)
    spawn fn() {
        let peer = net.accept_handle(listening) catch {
            _ => return
        }
        accepted <- peer
    }()
    let address = net.Addr { ip: net.parse_ip("127.0.0.1")?, port: l.handle.addr.port }
    using var c = net.connect(address)?
    let server = match <-accepted {
        some(p) => p
        none => fail NotConnected
    }
    Pair { client: net.detach(mut c), server }
}

fn start_reader(view: net.ConnHandle) -> chan[str] {
    let got = chan[str](1)
    spawn fn() {
        let buf = io.buffer(16)
        let n = net.read_on(view, buf) catch {
            e => {
                got <- "reader failed: {e}"
                return
            }
        }
        got <- "reader got {n} bytes: \"{str(buf[..n])}\""
    }()
    got
}

fn send_chunks(view: net.ConnHandle) ! io.Error {
    let chunk = io.buffer(chunk_size())
    for i in 0..chunks() {
        net.write_all_on(view, chunk)?
    }
}

fn start_writer(view: net.ConnHandle) -> chan[str] {
    let wrote = chan[str](1)
    spawn fn() {
        send_chunks(view) catch {
            e => {
                wrote <- "writer failed: {e}"
                return
            }
        }
        wrote <- "writer sent {chunk_size() * chunks()} bytes"
    }()
    wrote
}

fn within(c: chan[str], millis: i64) -> str {
    select {
        v = <-c => v ?? "closed"
        after(millis) => "still waiting after {millis} ms"
    }
}

fn pending(c: chan[str]) -> str {
    select {
        v = <-c => v ?? "closed"
        else => "writer still waiting"
    }
}

fn drain(server: net.Conn) -> i64 ! io.Error {
    let buf = io.buffer(chunk_size())
    var total = 0
    for total < chunk_size() * chunks() {
        let n = net.read(server, buf)?
        if n == 0 {
            break
        }
        total += n
    }
    total
}

fn both_complete(l: net.Listener) ! io.Error {
    let pair = connected(l)?
    using client = net.adopt(pair.client)
    using server = net.adopt(pair.server)
    let wrote = start_writer(client.handle)
    let got = start_reader(client.handle)
    sleep(100)
    print(pending(wrote))
    net.write_all(server, bytes("pong"))?
    print(within(got, 5000))
    print(pending(wrote))
    let total = drain(server)?
    print("server read {total} bytes")
    print(within(wrote, 5000))
}

fn timeout_wakes_reader(l: net.Listener) ! io.Error {
    let pair = connected(l)?
    using client = net.adopt(pair.client)
    using server = net.adopt(pair.server)
    net.set_write_timeout(client, 200)
    let got = start_reader(client.handle)
    let wrote = start_writer(client.handle)
    print(within(wrote, 5000))
    print(within(got, 5000))
}

fn main() ! io.Error {
    using l = net.listen("127.0.0.1", 0)?
    both_complete(l)?
    timeout_wakes_reader(l)?
}
