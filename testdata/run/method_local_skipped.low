struct Box {
    w: f32
}

fn width(b: Box, px: f32) -> Box {
    Box { w: px }
}

fn sized(width: f32) -> Box {
    Box { w: 0.0 }.width(width)
}

fn tripled(n: i64) -> i64 {
    n * 3
}

fn scaled(tripled: str, n: i64) -> i64 {
    n.tripled() + tripled.len
}

fn scaled_by_pipe(tripled: str, n: i64) -> i64 {
    (n |> tripled()) + tripled.len
}

fn stored(width: fn(Box, f32) -> Box) -> Box {
    Box { w: 0.0 }.width(7.0)
}

fn closure_wins() -> f32 {
    let width = fn(b: Box, px: f32) -> Box { Box { w: px * 2.0 } }
    Box { w: 0.0 }.width(5.0).w
}

fn nap(sleep: i64) -> i64 {
    sleep.sleep()
    sleep + 1
}

fn main() {
    print("{sized(3.0).w}")
    print(nap(0))
    print(scaled("ab", 4))
    print(scaled_by_pipe("ab", 4))
    print("{stored(fn(b: Box, px: f32) -> Box { Box { w: px + 100.0 } }).w}")
    print("{closure_wins()}")
}
