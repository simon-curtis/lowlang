fn generate(out: chan[i64], count: i64) {
    for i in 0..count {
        out <- i
    }
    close(out)
}

fn square(input: chan[i64], out: chan[i64], done: chan[bool]) {
    for v in input {
        out <- v * v % 1009
    }
    done <- true
}

fn close_after(done: chan[bool], parts: i64, out: chan[i64]) {
    for p in 0..parts {
        let finished = <-done
    }
    close(out)
}

fn total(input: chan[i64], result: chan[i64]) {
    var sum = 0
    var seen = 0
    for v in input {
        sum += v
        seen += 1
    }
    result <- sum
    result <- seen
}

fn pipeline(first: i64, second: i64, third: i64, width: i64, count: i64) {
    let raw = chan[i64](first)
    let squared = chan[i64](second)
    let done = chan[bool](width)
    let result = chan[i64](2)
    spawn generate(raw, count)
    for w in 0..width {
        spawn square(raw, squared, done)
    }
    spawn close_after(done, width, squared)
    let tail = chan[i64](third)
    spawn fn() {
        for v in squared {
            tail <- v + 1
        }
        close(tail)
    }()
    spawn total(tail, result)
    let sum = (<-result) ?? -1
    let seen = (<-result) ?? -1
    var expected = 0
    for i in 0..count {
        expected += i * i % 1009 + 1
    }
    print("{first} {second} {third} {width} {seen} {sum == expected}")
}

fn main() {
    let capacities = [0, 1, 7, 64]
    for a in capacities {
        for b in capacities {
            pipeline(a, b, 3, 3, 3000)
        }
    }
    pipeline(0, 0, 0, 1, 5000)
    pipeline(64, 64, 64, 16, 20000)
    pipeline(0, 64, 0, 8, 10000)
}
