struct P {
    a: i64
    b: i64
}
struct F {
    a: f64
    b: f64
}
struct T {
    a: i64
    b: f64
    c: i64
}
fn pair(a: i64, b: i64) -> P { P { a: b - a, b: a * b } }
fn pairf(a: f64, b: f64) -> F { F { a: b - a, b: a * b } }
fn tri(a: i64, b: f64) -> T { T { a: a / 3, b: b * 2.0, c: a % 3 } }
fn main() {
    let p = pair(3, 4)
    print(p.a)
    print(p.b)
    let f = pairf(1.5, 2.0)
    print(f.a)
    print(f.b)
    let t = tri(-10, 0.25)
    print(t.a)
    print(t.b)
    print(t.c)
}
