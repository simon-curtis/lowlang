import std/io
import std/text

fn hex(b: []u8) -> str {
    text.encode_hex(b)
}

fn main() {
    var b: []u8 = []
    io.put_be16(mut b, 0x0102)
    io.put_be24(mut b, 0x030405)
    io.put_be32(mut b, 0x06070809)
    io.put_be64(mut b, 0x0A0B0C0D0E0F1011)
    print(hex(b))
    print("{io.be16(b, 0)} {io.be24(b, 2)} {io.be32(b, 5)} {io.be64(b, 9)}")
    print("{io.u16_be(b, 0)} {io.u32_be(b, 5)} {io.u64_be(b, 9)}")

    var l: []u8 = []
    io.put_le16(mut l, 0x0102)
    io.put_le24(mut l, 0x030405)
    io.put_le32(mut l, 0x06070809)
    io.put_le64(mut l, 0x0A0B0C0D0E0F1011)
    print(hex(l))
    print("{io.le16(l, 0)} {io.le24(l, 2)} {io.le32(l, 5)} {io.le64(l, 9)}")
    print("{io.u16_le(l, 0)} {io.u32_le(l, 5)} {io.u64_le(l, 9)}")

    let s: []u8 = io.buffer(17)
    io.set_be16(s, 0, 0x0102)
    io.set_be24(s, 2, 0x030405)
    io.set_be32(s, 5, 0x06070809)
    io.set_be64(s, 9, 0x0A0B0C0D0E0F1011)
    print(hex(s) == hex(b))

    let t: []u8 = io.buffer(17)
    io.set_le16(t, 0, 0x0102)
    io.set_le24(t, 2, 0x030405)
    io.set_le32(t, 5, 0x06070809)
    io.set_le64(t, 9, 0x0A0B0C0D0E0F1011)
    print(hex(t) == hex(l))

    var wide: []u8 = []
    io.put_be(mut wide, 0x1122334455667788, 8)
    io.put_be(mut wide, 0x1122334455667788, 3)
    io.put_be(mut wide, 0x1122334455667788, 0)
    print(hex(wide))
    var narrow: []u8 = []
    io.put_le(mut narrow, 0x1122334455667788, 8)
    io.put_le(mut narrow, 0x1122334455667788, 3)
    print(hex(narrow))

    var negative: []u8 = []
    io.put_be64(mut negative, -2)
    io.put_le64(mut negative, -2)
    print(hex(negative))
    print("{io.be64(negative, 0)} {io.le64(negative, 8)} {io.u64_be(negative, 0)} {io.u64_le(negative, 8)}")
    print("{io.be32(negative, 4)} {io.u32_be(negative, 4)} {io.u16_le(negative, 8)}")
}
