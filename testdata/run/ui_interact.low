import std/ui
import std/ui/geometry
import std/ui/platform
import std/ui/scene

struct Log {
    lines: ui.Signal[[]str]
}

fn note(l: Log, line: str) {
    var out = l.lines.get()[0..]
    out.push(line)
    l.lines.set(out)
}

fn flush(l: Log) {
    for line in l.lines.get() {
        print(line)
    }
    let empty: []str = []
    l.lines.set(empty)
}

fn name(c: geometry.Color) -> str {
    if c == ui.rgb(0xff0000) {
        "red"
    } else if c == ui.rgb(0x00ff00) {
        "green"
    } else if c == ui.rgb(0x0000ff) {
        "blue"
    } else if c == ui.rgb(0xffffff) {
        "white"
    } else if c == ui.rgb(0x000000) {
        "black"
    } else if c == ui.rgb(0x808080) {
        "gray"
    } else {
        "other"
    }
}

fn colours(s: scene.Scene) -> str {
    var out = ""
    for q in s.quads {
        out += "{name(geometry.with_alpha(q.background, 1.0))}/{name(q.border_color)}@{q.background.a} "
    }
    out
}

fn click(cx: ui.Context, button: platform.Button, x: f32, y: f32) {
    cx.dispatch(PointerDown(button, x, y))
    cx.dispatch(PointerUp(button, x, y))
}

fn render_frame(cx: ui.Context, render: fn() -> ui.Element) -> scene.Scene {
    cx.frame(render, geometry.size(200.0, 100.0), 1.0)
}

fn bubbling(cx: ui.Context, log: Log) {
    print("bubbling")
    let stop = cx.signal(false)
    let view = fn() -> ui.Element {
        ui.div().size(200.0, 100.0).children() {
            ui.div().id("outer").size(100.0, 100.0)
                .on_mouse_down(Left, fn(e) note(log, "outer down {e.click_count}"))
                .on_click(fn(e) note(log, "outer click {e.click_count}"))
                .on_mouse_move(fn(e) note(log, "outer move {e.position.x} held {e.pressed != none}"))
                .child(ui.div().id("inner").size(50.0, 50.0)
                    .on_mouse_down(Left, fn(e) note(log, "inner down"))
                    .on_mouse_up(Right, fn(e) note(log, "inner right up"))
                    .on_click(fn(e) {
                        note(log, "inner click")
                        if stop.get() {
                            cx.stop_propagation()
                        }
                    }))
            ui.div().id("popup").absolute().left(150.0).top(0.0).size(40.0, 40.0)
                .on_mouse_down_out(fn(e) note(log, "outside popup"))
                .on_click(fn(e) note(log, "popup click"))
        }
    }
    render_frame(cx, view)
    click(cx, Left, 10.0, 10.0)
    click(cx, Left, 10.0, 10.0)
    flush(log)
    stop.set(true)
    render_frame(cx, view)
    click(cx, Left, 60.0, 60.0)
    click(cx, Left, 10.0, 10.0)
    flush(log)
    click(cx, Right, 10.0, 10.0)
    click(cx, Left, 160.0, 10.0)
    flush(log)
    cx.dispatch(PointerDown(Left, 70.0, 70.0))
    cx.dispatch(PointerMoved(80.0, 70.0))
    cx.dispatch(PointerUp(Left, 10.0, 10.0))
    cx.dispatch(PointerMoved(90.0, 70.0))
    flush(log)
}

fn states(cx: ui.Context) {
    print("states")
    let view = fn() -> ui.Element {
        ui.div().size(200.0, 100.0).children() {
            ui.div().id("card").group("card").size(100.0, 50.0).focusable().row().gap(10.0)
                .border(1.0, ui.rgb(0x000000)).background(ui.rgb(0x808080))
                .active(fn(v) v.with_background(ui.rgb(0xff0000)))
                .in_focus(fn(v) v.with_border_color(ui.rgb(0x0000ff)))
                .children() {
                    ui.div().size(20.0, 20.0).background(ui.rgb(0x000000))
                        .group_hover("card", fn(v) v.with_background(ui.rgb(0xffffff)))
                        .group_active("card", fn(v) v.with_opacity(0.5))
                    ui.div().id("field").size(20.0, 20.0).focusable().background(ui.rgb(0x000000))
                        .focus(fn(v) v.with_background(ui.rgb(0x00ff00)))
                        .hover(fn(v) v.with_border_color(ui.rgb(0xff0000)))
                }
        }
    }
    print(colours(render_frame(cx, view)))
    cx.dispatch(PointerMoved(60.0, 40.0))
    print(colours(render_frame(cx, view)))
    cx.dispatch(PointerDown(Left, 60.0, 40.0))
    print("focus {cx.focused()}")
    print(colours(render_frame(cx, view)))
    cx.dispatch(PointerUp(Left, 60.0, 40.0))
    print(colours(render_frame(cx, view)))
    click(cx, Left, 35.0, 10.0)
    print("focus {cx.focused()}")
    print(colours(render_frame(cx, view)))
    cx.blur()
    cx.dispatch(PointerLeft)
    print("focus {cx.focused()}")
    print(colours(render_frame(cx, view)))
}

fn occluding(cx: ui.Context, log: Log) {
    print("occlusion")
    let view = fn() -> ui.Element {
        ui.div().size(200.0, 100.0).children() {
            ui.div().id("base").size(100.0, 50.0).background(ui.rgb(0x808080))
                .hover(fn(v) v.with_background(ui.rgb(0xff0000)))
                .on_click(fn(e) note(log, "base click"))
            ui.div().absolute().left(0.0).top(0.0).size(50.0, 50.0).occlude()
        }
    }
    render_frame(cx, view)
    cx.dispatch(PointerMoved(10.0, 10.0))
    print(colours(render_frame(cx, view)))
    click(cx, Left, 10.0, 10.0)
    cx.dispatch(PointerMoved(70.0, 10.0))
    print(colours(render_frame(cx, view)))
    click(cx, Left, 70.0, 10.0)
    flush(log)
}

fn item(c: u32) -> ui.Element {
    ui.div().height(20.0).shrink(0.0).background(ui.rgb(c))
}

fn tops(s: scene.Scene) -> str {
    var out = ""
    for q in s.quads {
        out += "{q.bounds.y} "
    }
    out
}

fn scrolling(cx: ui.Context, log: Log) {
    print("scrolling")
    let view = fn() -> ui.Element {
        ui.div().id("page").column().size(100.0, 100.0).overflow_y_scroll().children() {
            ui.div().id("list").column().height(50.0).shrink(0.0).overflow_y_scroll()
                .on_scroll_wheel(fn(e) note(log, "wheel {e.dy} at {e.position.y}"))
                .children() {
                    item(0xff0000)
                    item(0x00ff00)
                    item(0x0000ff)
                    item(0xffffff)
                    item(0x000000)
                }
            ui.div().height(100.0).shrink(0.0).background(ui.rgb(0x808080))
        }
    }
    let first = render_frame(cx, view)
    print(tops(first))
    print("clip {first.quads[0].clip.y} {first.quads[0].clip.height}")
    cx.dispatch(PointerMoved(10.0, 10.0))
    cx.dispatch(Scrolled(0.0, 30.0))
    print("list {cx.scroll_offset("list").y} page {cx.scroll_offset("page").y} due {cx.frame_due()}")
    print(tops(render_frame(cx, view)))
    cx.dispatch(Scrolled(0.0, 30.0))
    cx.dispatch(Scrolled(0.0, 30.0))
    print("list {cx.scroll_offset("list").y} page {cx.scroll_offset("page").y}")
    print(tops(render_frame(cx, view)))
    cx.dispatch(Scrolled(0.0, -100.0))
    print("list {cx.scroll_offset("list").y} page {cx.scroll_offset("page").y}")
    cx.scroll_to("page", geometry.point(0.0, 500.0))
    render_frame(cx, view)
    print("page {cx.scroll_offset("page").y}")
    flush(log)
}

fn keys(cx: ui.Context, log: Log) {
    print("keys")
    let view = fn() -> ui.Element {
        ui.div().size(200.0, 100.0).on_key_down(fn(k) note(log, "root down {k.text}")).children() {
            ui.div().id("box").size(20.0, 20.0).focusable()
                .on_key_down(fn(k) note(log, "box down {k.text}"))
                .on_key_up(fn(k) note(log, "box up {k.text}"))
        }
    }
    render_frame(cx, view)
    cx.set_focus("box")
    print("focus {cx.focused()}")
    cx.dispatch(Key(platform.KeyEvent { key: Character("a"), text: "a" }))
    cx.dispatch(Key(platform.KeyEvent { key: Character("a"), pressed: false }))
    flush(log)
}

fn held(m: platform.Modifiers) -> str {
    "shift {m.shift} control {m.control}"
}

fn modifiers(cx: ui.Context, log: Log) {
    print("modifiers")
    let view = fn() -> ui.Element {
        ui.div().size(200.0, 100.0).on_modifiers_changed(fn(m) note(log, "root {held(m)}")).children() {
            ui.div().id("field").size(20.0, 20.0).focusable()
                .on_modifiers_changed(fn(m) note(log, "field {held(m)}"))
                .on_click(fn(e) note(log, "click {held(e.modifiers)}"))
        }
    }
    render_frame(cx, view)
    cx.set_focus("field")
    cx.dispatch(ModifiersChanged(platform.Modifiers { shift: true }))
    click(cx, Left, 5.0, 5.0)
    cx.dispatch(ModifiersChanged(platform.Modifiers { shift: true, control: true }))
    cx.dispatch(Key(platform.KeyEvent { key: Character("a"), modifiers: platform.Modifiers { shift: true, control: true } }))
    cx.dispatch(ModifiersChanged(platform.Modifiers {}))
    click(cx, Left, 5.0, 5.0)
    flush(log)
}

fn cursors(cx: ui.Context) {
    print("cursors")
    let view = fn() -> ui.Element {
        ui.div().size(200.0, 100.0).cursor(Crosshair).children() {
            ui.div().id("link").size(40.0, 40.0).cursor(Pointer).children() {
                ui.div().id("plain").size(10.0, 10.0)
                ui.div().id("field").size(10.0, 10.0).cursor(Text)
            }
            ui.div().id("bare").size(20.0, 20.0)
            ui.div().id("cover").absolute().left(150.0).top(0.0).size(50.0, 50.0).occlude()
        }
    }
    render_frame(cx, view)
    let spots = [geometry.point(5.0, 5.0), geometry.point(15.0, 5.0), geometry.point(30.0, 30.0), geometry.point(5.0, 50.0), geometry.point(100.0, 90.0), geometry.point(160.0, 10.0)]
    for p in spots {
        cx.dispatch(PointerMoved(p.x, p.y))
        print("{p.x},{p.y} {cx.current_cursor()}")
    }
    cx.dispatch(PointerLeft)
    print("outside {cx.current_cursor()}")
}

fn caret_text(c: platform.Caret?) -> str {
    match c {
        some(r) => "{r.x},{r.y} {r.width}x{r.height}"
        none => "none"
    }
}

fn input(cx: ui.Context, log: Log) {
    print("input")
    let handler = ui.InputHandler {
        insert: fn(text: str) note(log, "insert [{text}]")
        compose: fn(text: str, selected: platform.TextRange?) {
            let at = match selected {
                some(r) => "{r.start}-{r.end}"
                none => "end"
            }
            note(log, "compose [{text}] {at}")
        }
        caret: fn(b: geometry.Rect) -> geometry.Rect { geometry.rect(b.x + 3.25, b.y + 1.5, 0.0, 16.0) }
    }
    let view = fn() -> ui.Element {
        ui.div().size(200.0, 100.0).on_action("quit", fn() note(log, "quit")).children() {
            ui.div().id("plain").size(20.0, 20.0).focusable()
            ui.div().id("edit").size(50.0, 20.0).on_input(handler)
                .on_key_down(fn(k) {
                    if k.text == "!" {
                        note(log, "listener took !")
                        cx.stop_propagation()
                    }
                })
        }
    }
    ui.bind(cx, "q", "quit", "") or {}
    render_frame(cx, view)
    cx.set_focus("plain")
    print("caret {caret_text(cx.input_caret())}")
    cx.dispatch(Key(platform.KeyEvent { key: Character("a"), text: "a" }))
    cx.dispatch(Commit("lost"))
    flush(log)
    cx.set_focus("edit")
    print("caret {caret_text(cx.input_caret())}")
    cx.dispatch(Key(platform.KeyEvent { key: Character("a"), text: "a" }))
    cx.dispatch(Key(platform.KeyEvent { key: Character("a"), pressed: false }))
    cx.dispatch(Key(platform.KeyEvent { key: Character("q"), text: "q" }))
    cx.dispatch(Key(platform.KeyEvent { key: Character("1"), text: "!", modifiers: platform.Modifiers { shift: true } }))
    cx.dispatch(Key(platform.KeyEvent { key: Named(Enter) }))
    cx.dispatch(Key(platform.KeyEvent { key: Character("é"), text: "é" }))
    cx.dispatch(Preedit("かな", platform.TextRange { start: 0, end: 6 }))
    cx.dispatch(Preedit("か", none))
    cx.dispatch(Commit("仮名"))
    cx.dispatch(Preedit("", none))
    flush(log)
}

fn clipboard(cx: ui.Context) ! platform.Error {
    print("clipboard")
    print("empty {cx.read_from_clipboard()?}")
    cx.write_to_clipboard("copied")?
    print("read {cx.read_from_clipboard()?}")
}

fn window_line(cx: ui.Context, what: str) {
    let s = cx.window_status()
    print("{what}: {cx.window_decorations()} maximized {s.maximized} fullscreen {s.fullscreen} tiled {s.tiled} closed {cx.closed()}")
}

fn window_controls() {
    print("window")
    let cx = ui.headless(ui.rgb(0xffffff))
    let clicks = cx.signal(0)
    let render = fn() -> ui.Element {
        ui.div().size(200.0, 100.0).children() {
            ui.div().id("bar").size(200.0, 20.0).window_control_area(Drag).children() {
                ui.div().id("button").size(20.0, 20.0).on_click(fn(e) clicks.update(fn(n) n + 1))
                ui.div().id("min").size(20.0, 20.0).window_control_area(Minimize)
                ui.div().id("max").size(20.0, 20.0).window_control_area(Maximize)
                ui.div().id("close").size(20.0, 20.0).window_control_area(Close)
            }
        }
    }
    render_frame(cx, render)
    window_line(cx, "opened")
    click(cx, Left, 100.0, 10.0)
    window_line(cx, "pressed")
    click(cx, Left, 100.0, 10.0)
    window_line(cx, "double clicked")
    click(cx, Right, 100.0, 10.0)
    click(cx, Left, 10.0, 10.0)
    window_line(cx, "button {clicks.get()}")
    click(cx, Left, 50.0, 10.0)
    window_line(cx, "maximize")
    click(cx, Left, 30.0, 10.0)
    window_line(cx, "minimize")
    cx.set_window_fullscreen(true)
    window_line(cx, "fullscreen")
    cx.dispatch(DecorationsChanged(Client))
    cx.dispatch(StatusChanged(platform.WindowStatus { tiled: true }))
    window_line(cx, "changed")
    cx.dispatch(PointerDown(Left, 70.0, 10.0))
    cx.dispatch(PointerUp(Left, 150.0, 10.0))
    window_line(cx, "close left")
    click(cx, Left, 70.0, 10.0)
    window_line(cx, "close")
}

fn main() {
    let cx = ui.headless(ui.rgb(0xffffff))
    let empty: []str = []
    let log = Log { lines: cx.signal(empty) }
    bubbling(cx, log)
    states(cx)
    occluding(cx, log)
    scrolling(cx, log)
    keys(cx, log)
    modifiers(cx, log)
    cursors(cx)
    input(cx, log)
    clipboard(cx) catch {
        e => print("clipboard failed")
    }
    window_controls()
}
