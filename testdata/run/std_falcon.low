import std/crypto/falcon
import std/slices
import std/text

fn unhex(s: str) -> []u8 {
    if s == "-" {
        return []
    }
    text.decode_hex(s) or []
}

fn level_of(s: str) -> falcon.Level {
    match s {
        "falcon512" => Falcon512
        _ => Falcon1024
    }
}

fn name_of(lv: falcon.Level) -> str {
    match lv {
        Falcon512 => "Falcon-512"
        Falcon1024 => "Falcon-1024"
    }
}

fn verdict(label: str, ok: bool) {
    let word = if ok { "ok" } else { "FAIL" }
    print("{label}: {word}")
}

fn flipped(b: []u8, bit: i64) -> []u8 {
    let c = slices.clone(b)
    c[bit >> 3] ^= u8(1 << (bit & 7))
    c
}

fn padded(sig: []u8, length: i64) -> []u8 {
    var out = slices.clone(sig)
    for out.len < length {
        push(mut out, 0)
    }
    out
}

fn shapes(lv: falcon.Level, pk: []u8, message: []u8, sig: []u8) {
    let name = name_of(lv)
    let full = falcon.signature_size(lv)
    verdict("{name} padded to the full length", falcon.verify(lv, pk, message, padded(sig, full)))
    var dirty = padded(sig, full)
    dirty[full - 1] = 1
    verdict("{name} padding with a non-zero byte", !falcon.verify(lv, pk, message, dirty))
    verdict("{name} partial padding", !falcon.verify(lv, pk, message, padded(sig, sig.len + 1)))
    verdict("{name} partial padding of one byte short", !falcon.verify(lv, pk, message, padded(sig, full - 1)))
    verdict("{name} truncated signature", !falcon.verify(lv, pk, message, sig[..sig.len - 1]))
    verdict("{name} signature of header length", !falcon.verify(lv, pk, message, sig[..41]))
    verdict("{name} empty signature", !falcon.verify(lv, pk, message, []))
    verdict("{name} empty public key", !falcon.verify(lv, [], message, sig))
    verdict("{name} truncated public key", !falcon.verify(lv, pk[..pk.len - 1], message, sig))
    var extended = slices.clone(pk)
    push(mut extended, 0)
    verdict("{name} extended public key", !falcon.verify(lv, extended, message, sig))
    verdict("{name} other message", !falcon.verify(lv, pk, flipped(message, 0), sig))
    verdict("{name} empty message", !falcon.verify(lv, pk, [], sig))
    var wrong_header = slices.clone(sig)
    wrong_header[0] = sig[0] - 0x10
    verdict("{name} NIST-wrapper signature header", !falcon.verify(lv, pk, message, wrong_header))
    wrong_header[0] = sig[0] + 0x20
    verdict("{name} uncompressed signature header", !falcon.verify(lv, pk, message, wrong_header))
    var wrong_key_header = slices.clone(pk)
    wrong_key_header[0] = pk[0] + 0x10
    verdict("{name} public key header", !falcon.verify(lv, wrong_key_header, message, sig))
    var large = slices.clone(pk)
    large[1] = 0xff
    large[2] |= 0xfc
    verdict("{name} public key coefficient of 16383", !falcon.verify(lv, large, message, sig))
    let other = match lv {
        Falcon512 => falcon.Level.Falcon1024
        Falcon1024 => falcon.Level.Falcon512
    }
    verdict("{name} other level", !falcon.verify(other, pk, message, sig))
}

fn corrupted(lv: falcon.Level, pk: []u8, message: []u8, sig: []u8) {
    let name = name_of(lv)
    var accepted = 0
    for bit in 0..sig.len * 8 {
        if falcon.verify(lv, pk, message, flipped(sig, bit)) {
            accepted += 1
        }
    }
    print("{name} signature single-bit corruptions accepted: {accepted} of {sig.len * 8}")
    accepted = 0
    for bit in 0..pk.len * 8 {
        if falcon.verify(lv, flipped(pk, bit), message, sig) {
            accepted += 1
        }
    }
    print("{name} public key single-bit corruptions accepted: {accepted} of {pk.len * 8}")
}

fn main() {
    var n = 0
    var first: [str: bool] = [:]
    for line in text.lines(embed("std_falcon_vectors.txt")) {
        let f = text.fields(line)
        n += 1
        let lv = level_of(f[1])
        let pk = unhex(f[3])
        let message = unhex(f[4])
        let sig = unhex(f[5])
        verdict("kat {f[1]} {f[2]}", falcon.verify(lv, pk, message, sig))
        if !(first[f[1]] ?? false) {
            first[f[1]] = true
            shapes(lv, pk, message, sig)
            corrupted(lv, pk, message, sig)
        }
    }
    print("sizes {falcon.public_key_size(Falcon512)} {falcon.signature_size(Falcon512)} {falcon.public_key_size(Falcon1024)} {falcon.signature_size(Falcon1024)}")
}
