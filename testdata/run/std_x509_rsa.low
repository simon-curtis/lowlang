import std/crypto/hash
import std/crypto/rsa
import std/io

fn algorithm(name: str) -> hash.Algorithm {
    if name == "sha384" {
        return hash.sha384()
    }
    if name == "sha512" {
        return hash.sha512()
    }
    hash.sha256()
}


fn exercise(bits: str, der: str, v15_hash: str, v15: str, pss_hash: str, pss: str) ! io.Error {
    let msg = bytes(embed("std_x509/rsa/msg.bin"))
    let key = rsa.parse_private(bytes(der))?
    let public = rsa.public(key)
    let v15_algorithm = algorithm(v15_hash)
    let v15_digest = hash.sum(v15_algorithm, msg)
    let theirs_v15 = bytes(v15)
    let pss_algorithm = algorithm(pss_hash)
    let pss_digest = hash.sum(pss_algorithm, msg)
    let theirs_pss = bytes(pss)
    print("{bits} openssl pkcs1 {v15_hash} {rsa.verify_pkcs1v15(public, v15_algorithm, v15_digest, theirs_v15)}")
    print("{bits} openssl pss {pss_hash} {rsa.verify_pss(public, pss_algorithm, pss_digest, theirs_pss)}")
    print("{bits} pss as pkcs1 {rsa.verify_pkcs1v15(public, pss_algorithm, pss_digest, theirs_pss)} pkcs1 as pss {rsa.verify_pss(public, v15_algorithm, v15_digest, theirs_v15)}")
    print("{bits} wrong digest {rsa.verify_pkcs1v15(public, v15_algorithm, pss_digest, theirs_v15)} {rsa.verify_pss(public, pss_algorithm, v15_digest, theirs_pss)}")
    let ours_v15 = rsa.sign_pkcs1v15(key, v15_algorithm, v15_digest)?
    print("{bits} our pkcs1 matches openssl {hash.equal(ours_v15, theirs_v15)}")
    let ours_pss = rsa.sign_pss(key, pss_algorithm, pss_digest)?
    let again = rsa.sign_pss(key, pss_algorithm, pss_digest)?
    print("{bits} our pss verifies {rsa.verify_pss(public, pss_algorithm, pss_digest, ours_pss)} randomised {!hash.equal(ours_pss, again)}")
    theirs_pss[10] ^= 1
    print("{bits} tampered {rsa.verify_pss(public, pss_algorithm, pss_digest, theirs_pss)}")
    print("{bits} short signature {rsa.verify_pkcs1v15(public, v15_algorithm, v15_digest, theirs_v15[1..])}")
    print("{bits} signature equal to modulus {rsa.verify_pkcs1v15(public, v15_algorithm, v15_digest, public.n)}")
}

fn outcome(der: []u8) -> str {
    let key = rsa.parse_private(der) catch {
        Malformed => return "Malformed"
        Unsupported => return "Unsupported"
        _ => return "other"
    }
    "parsed {key.n.len}"
}

fn main() ! io.Error {
    exercise("2048", embed("std_x509/rsa/k2048.der"), "sha256", embed("std_x509/rsa/s2048_sha256_v15.sig"), "sha384", embed("std_x509/rsa/s2048_sha384_pss.sig"))?
    exercise("3072", embed("std_x509/rsa/k3072.der"), "sha512", embed("std_x509/rsa/s3072_sha512_v15.sig"), "sha256", embed("std_x509/rsa/s3072_sha256_pss.sig"))?
    exercise("4096", embed("std_x509/rsa/k4096.der"), "sha384", embed("std_x509/rsa/s4096_sha384_v15.sig"), "sha512", embed("std_x509/rsa/s4096_sha512_pss.sig"))?
    let public = rsa.parse_public(bytes(embed("std_x509/rsa/p2048.der")))?
    let key = rsa.parse_private(bytes(embed("std_x509/rsa/k2048.der")))?
    print("public matches private {hash.equal(public.n, key.n) && hash.equal(public.e, key.e)} e={public.e.len} bytes")
    let good = bytes(embed("std_x509/rsa/k2048.der"))
    print("1024-bit key {outcome(bytes(embed("std_x509/rsa/k1024.der")))}")
    print("truncated {outcome(good[..good.len - 1])}")
    print("empty {outcome(good[..0])}")
    good[20] ^= 1
    print("altered modulus {outcome(good)}")
}
