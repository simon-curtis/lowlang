import std/io

struct Node {
    left: *Node?
    right: *Node?
    value: i64
}

struct Kept {
    trees: []*Node
    slices: [][]i64
    names: []str
    table: [str: i64]
    views: []str
}

fn tree(depth: i64, seed: i64) -> *Node? {
    if depth == 0 {
        return none
    }
    new(Node { left: tree(depth - 1, seed * 2), right: tree(depth - 1, seed * 2 + 1), value: seed })
}

fn root(seed: i64) -> *Node {
    new(Node { left: tree(4, seed * 2), right: tree(4, seed * 2 + 1), value: seed })
}

fn sum(n: *Node?) -> i64 {
    match n {
        some(x) => x.value + sum(x.left) + sum(x.right)
        none => 0
    }
}

fn name(i: i64) -> str {
    var b: []u8 = []
    for k in 0..(6 + i % 9) {
        push(mut b, u8(97 + (i * 7 + k) % 26))
    }
    str(b)
}

fn build(rounds: i64) -> Kept {
    var trees: []*Node = []
    var slices: [][]i64 = []
    var names: []str = []
    var views: []str = []
    var table: [str: i64] = [:]
    var holes: [][]u8 = []
    for i in 0..rounds {
        let hole = io.buffer(1048576 + (i % 5) * 262144)
        hole[0] = 1
        push(mut holes, hole)
        push(mut trees, root(i + 1))
        var xs: []i64 = []
        for k in 0..(40 + i % 30) {
            push(mut xs, i * 1000 + k)
        }
        push(mut slices, xs[3..xs.len - 2])
        let n = name(i)
        push(mut names, n)
        push(mut views, n[1..n.len - 1])
        table[n] = i
    }
    Kept { trees: trees, slices: slices, names: names, table: table, views: views }
}

fn churn(n: i64) -> i64 {
    var total = 0
    for i in 0..n {
        let b = io.buffer(2048 + i % 4096)
        b[0] = 1
        total += i64(b[0])
        var xs: []i64 = []
        for k in 0..(i % 50) {
            push(mut xs, k)
        }
        total += xs.len
    }
    total
}

fn verify(kept: Kept, rounds: i64) -> i64 {
    var bad = 0
    for i in 0..rounds {
        if sum(kept.trees[i]) != tree_sum(5, i + 1) {
            bad += 1
        }
        let xs = kept.slices[i]
        let count = 40 + i % 30 - 5
        if xs.len != count {
            bad += 1
        }
        for k in 0..xs.len {
            if xs[k] != i * 1000 + k + 3 {
                bad += 1
            }
        }
        let nm = name(i)
        if kept.names[i] != nm {
            bad += 1
        }
        if kept.views[i] != nm[1..nm.len - 1] {
            bad += 1
        }
        if (kept.table[nm] ?? -1) != i {
            bad += 1
        }
    }
    if kept.table.len != rounds {
        bad += 1
    }
    bad
}

fn tree_sum(depth: i64, seed: i64) -> i64 {
    if depth == 0 {
        return 0
    }
    seed + tree_sum(depth - 1, seed * 2) + tree_sum(depth - 1, seed * 2 + 1)
}

fn main() {
    let rounds = 120
    let kept = build(rounds)
    var churned = 0
    for pass in 0..4 {
        churned += churn(20000)
        print("pass {pass} bad {verify(kept, rounds)}")
    }
    print(churned)
}
