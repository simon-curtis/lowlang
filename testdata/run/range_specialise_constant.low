fn sieve(limit: i64) -> i64 {
    var composite: []u8 = []
    for i in 0..limit {
        push(mut composite, u8(0))
    }
    var count = 0
    for i in 2..limit {
        if composite[i] == 0 {
            count += 1
            var j = i * i
            for j < limit {
                composite[j] = 1
                j += i
            }
        }
    }
    count
}

fn main() {
    var total = 0
    for round in 0..3 {
        total += sieve(1000)
    }
    print(total)
}
