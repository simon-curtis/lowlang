import std/base64
import std/crypto/hash
import std/crypto/jose
import std/io
import std/json
import std/text

fn b64url(data: []u8) -> str {
    let standard = base64.encode(data)
    var out: []u8 = []
    for i in 0..standard.len {
        let c = standard[i]
        if c == '+' {
            push(mut out, '-')
        } else if c == '/' {
            push(mut out, '_')
        } else if c != '=' {
            push(mut out, c)
        }
    }
    str(out)
}

fn forge(header: str, payload: str, secret: []u8) -> str {
    let input = "{b64url(bytes(header))}.{b64url(bytes(payload))}"
    let mac = hash.hmac(hash.sha256(), secret, bytes(input))
    "{input}.{b64url(mac)}"
}

fn outcome(token: str, keys: []jose.Jwk, options: jose.Options) -> str {
    let c = jose.verify(token, keys, options) catch {
        Invalid => return "Invalid"
        Malformed => return "Malformed"
        _ => return "other"
    }
    "ok {c.sub ?? "-"}"
}

fn sign_outcome(alg: str, key: jose.Key, payload: json.Value) -> str {
    let t = jose.sign(alg, "", key, payload) catch {
        Invalid => return "Invalid"
        _ => return "other"
    }
    "signed {t.len}"
}

fn jwks_outcome(data: str) -> str {
    let keys = jose.parse_jwks(bytes(data)) catch {
        Malformed => return "Malformed"
        _ => return "other"
    }
    "{keys.len} keys"
}

fn replace_at(s: str, at: i64) -> str {
    let b = bytes(s)
    b[at] = if b[at] == 'A' { 'B' } else { 'A' }
    str(b)
}

fn with_kid(k: jose.Jwk, kid: str, alg: str) -> jose.Jwk {
    jose.Jwk { kid, key: k.key, alg }
}

fn algorithms() -> []str {
    ["HS256", "HS384", "HS512", "RS256", "RS384", "RS512", "PS256", "PS384", "PS512", "ES256", "ES384", "EdDSA"]
}

fn rfc(all: []str) ! io.Error {
    let keys = jose.parse_jwks(bytes(embed("std_jose_rfc.jwks")))?
    let tokens = text.split(text.trim(embed("std_jose_rfc.tokens")), '\n')
    for i in 0..3 {
        let c = jose.verify(tokens[i], keys, jose.Options { algorithms: all, now: 1300819370 })?
        let root = json.get(c.extra, "http://example.com/is_root") ?? json.Value.Null
        print("rfc7515 {i + 1} {c.iss ?? "-"} {c.exp ?? 0} {json.stringify(root, 0)}")
        print("rfc7515 {i + 1} expired {outcome(tokens[i], keys, jose.Options { algorithms: all, now: 1300819441 })}")
    }
    let message = jose.verify_jws(tokens[3], keys, ["EdDSA"])?
    print("rfc8037 {str(message)}")
    print("rfc8037 as jwt {outcome(tokens[3], keys, jose.Options { algorithms: all })}")
    for k in keys {
        print(jose.jwk_json(k))
    }
}

fn interop(all: []str) ! io.Error {
    let keys = jose.parse_jwks(bytes(embed("std_jose_openssl.jwks")))?
    let tokens = text.split(text.trim(embed("std_jose_openssl.tokens")), '\n')
    let at = jose.Options { algorithms: all, now: 1500000000 }
    for i, t in tokens {
        print("openssl {all[i]} {outcome(t, keys, at)}")
    }
    let c = jose.verify(tokens[0], keys, at)?
    let role = json.get(c.extra, "role") ?? json.Value.Null
    print("claims {c.iss ?? "-"} {c.sub ?? "-"} {text.join(c.aud, ",")} {c.exp ?? 0} {c.nbf ?? 0} {c.iat ?? 0} {c.jti ?? "-"} {json.stringify(role, 0)}")
    let published = jose.parse_jwks(bytes(jose.jwks_json(keys)))?
    print("published {published.len}")
    for i, t in tokens {
        print("published {all[i]} {outcome(t, published, at)}")
    }
    print(jose.jwks_json(keys))

    let hs = tokens[0]
    let rs = tokens[3]
    print("hs256 to rs256 allow-list {outcome(hs, keys, jose.Options { algorithms: ["RS256"], now: 1500000000 })}")
    print("rs256 with only oct key {outcome(rs, [keys[0]], at)}")
    print("kid mismatch {outcome(rs, [with_kid(keys[1], "other", "")], at)}")
    print("jwk alg mismatch {outcome(rs, [with_kid(keys[1], "rsa", "PS256")], at)}")
    print("jwk alg match {outcome(rs, [with_kid(keys[1], "rsa", "RS256")], at)}")
    let dot = text.index_byte(hs, '.')
    print("tampered payload {outcome(replace_at(hs, dot + 10), keys, at)}")
    print("tampered signature {outcome(replace_at(rs, rs.len - 20), keys, at)}")
    print("tampered header {outcome(replace_at(hs, 5), keys, at)}")
    print("exp within leeway {outcome(hs, keys, jose.Options { algorithms: all, now: 2000000059 })}")
    print("exp beyond leeway {outcome(hs, keys, jose.Options { algorithms: all, now: 2000000060 })}")
    print("exp no leeway {outcome(hs, keys, jose.Options { algorithms: all, now: 2000000000, leeway: 0 })}")
    print("exp last second {outcome(hs, keys, jose.Options { algorithms: all, now: 1999999999, leeway: 0 })}")
    print("nbf within leeway {outcome(hs, keys, jose.Options { algorithms: all, now: 999999940 })}")
    print("nbf beyond leeway {outcome(hs, keys, jose.Options { algorithms: all, now: 999999939 })}")
    print("issuer {outcome(hs, keys, jose.Options { algorithms: all, now: 1500000000, issuer: "openssl" })}")
    print("wrong issuer {outcome(hs, keys, jose.Options { algorithms: all, now: 1500000000, issuer: "other" })}")
    print("audience {outcome(hs, keys, jose.Options { algorithms: all, now: 1500000000, audience: "admin" })}")
    print("wrong audience {outcome(hs, keys, jose.Options { algorithms: all, now: 1500000000, audience: "web" })}")
    print("empty allow-list {outcome(hs, keys, jose.Options { algorithms: [], now: 1500000000 })}")
    print("current time {outcome(hs, keys, jose.Options { algorithms: all })}")

    let secret: []u8 = match keys[0].key {
        Hmac(s) => s
        _ => []
    }
    let modulus: []u8 = match keys[1].key {
        Rsa(public, _) => public.n
        _ => []
    }
    let body = "{{\"sub\":\"mallory\"}}"
    let none_token = "{b64url(bytes("{{\"alg\":\"none\"}}"))}.{b64url(bytes(body))}."
    print("alg none {outcome(none_token, keys, jose.Options { algorithms: ["none", "HS256"] })}")
    let confused = forge("{{\"alg\":\"HS256\"}}", body, modulus)
    print("rsa modulus as hmac secret {outcome(confused, [keys[1]], jose.Options { algorithms: ["HS256", "RS256"] })}")
    print("forged hs256 {outcome(forge("{{\"alg\":\"HS256\"}}", body, secret), keys, at)}")
    print("crit {outcome(forge("{{\"alg\":\"HS256\",\"crit\":[\"exp\"]}}", body, secret), keys, at)}")
    print("duplicate header {outcome(forge("{{\"alg\":\"HS256\",\"alg\":\"none\"}}", body, secret), keys, at)}")
    print("duplicate claim {outcome(forge("{{\"alg\":\"HS256\"}}", "{{\"sub\":\"a\",\"sub\":\"b\"}}", secret), keys, at)}")
    print("payload array {outcome(forge("{{\"alg\":\"HS256\"}}", "[1]", secret), keys, at)}")
    print("exp string {outcome(forge("{{\"alg\":\"HS256\"}}", "{{\"exp\":\"soon\"}}", secret), keys, at)}")
    print("aud string {outcome(forge("{{\"alg\":\"HS256\"}}", "{{\"sub\":\"s\",\"aud\":\"web\"}}", secret), keys, jose.Options { algorithms: all, audience: "web" })}")
    print("exp fractional {outcome(forge("{{\"alg\":\"HS256\"}}", "{{\"sub\":\"f\",\"exp\":1500000000.5}}", secret), keys, jose.Options { algorithms: all, now: 1500000000, leeway: 0 })}")
    print("header not json {outcome("{b64url(bytes("alg"))}.{b64url(bytes(body))}.AAAA", keys, at)}")
    print("two segments {outcome("abc.def", keys, at)}")
    print("four segments {outcome("a.b.c.d", keys, at)}")
    print("bad base64 {outcome("e!.e.e", keys, at)}")
    print("padded signature {outcome("{hs}=", keys, at)}")
    print("non-canonical signature {outcome("{hs[..hs.len - 1]}9", keys, at)}")
}

fn signing(all: []str) ! io.Error {
    let keys = jose.parse_jwks(bytes(embed("std_jose_openssl.jwks")))?
    let payload = json.Value.Object([
        json.Member { name: "sub", value: Str("ada") },
        json.Member { name: "aud", value: Str("api") },
        json.Member { name: "exp", value: Int(2000000000) },
    ])
    for alg in all {
        var index = 0
        if alg[0] == 'R' || alg[0] == 'P' {
            index = 1
        } else if alg == "ES256" {
            index = 2
        } else if alg == "ES384" {
            index = 3
        } else if alg == "EdDSA" {
            index = 4
        }
        let k = keys[index]
        let t = jose.sign(alg, k.kid, k.key, payload)?
        let c = jose.verify(t, keys, jose.Options { algorithms: [alg], audience: "api", now: 1500000000 })?
        let again = jose.sign(alg, k.kid, k.key, payload)?
        if alg[0] == 'P' {
            print("{alg} {c.sub ?? "-"} randomised {t != again}")
        } else {
            print("{alg} {c.sub ?? "-"} deterministic {t == again}")
            print(t)
        }
    }
    let public_ed = match keys[4].key {
        Ed(public, _) => jose.Key.Ed(public, none)
        _ => keys[4].key
    }
    print("sign public only {sign_outcome("EdDSA", public_ed, payload)}")
    print("sign short secret {sign_outcome("HS256", jose.Key.Hmac(bytes("short")), payload)}")
    print("sign curve mismatch {sign_outcome("ES384", keys[2].key, payload)}")
    print("sign unknown alg {sign_outcome("ES512", keys[2].key, payload)}")
    print("sign none {sign_outcome("none", keys[0].key, payload)}")
    print("sign family mismatch {sign_outcome("RS256", keys[2].key, payload)}")
}

fn jwks() {
    print("jwks not json {jwks_outcome("{{")}")
    print("jwks not object {jwks_outcome("[1]")}")
    print("jwks keys not array {jwks_outcome("{{\"keys\":5}}")}")
    print("jwks single {jwks_outcome("{{\"kty\":\"oct\",\"k\":\"c2VjcmV0\"}}")}")
    let mixed = "{{\"keys\":[{{\"kty\":\"foo\"}},{{\"kty\":\"oct\",\"k\":\"AAAA\",\"use\":\"enc\"}},{{\"kty\":\"EC\",\"crv\":\"P-521\",\"x\":\"AA\",\"y\":\"AA\"}},{{\"kty\":\"OKP\",\"crv\":\"X25519\",\"x\":\"AA\"}},{{\"kty\":\"RSA\",\"n\":\"AA\"}},{{\"kty\":\"EC\",\"crv\":\"P-256\",\"x\":\"AA\",\"y\":\"AA\"}},{{\"kty\":\"oct\",\"k\":\"c2VjcmV0\"}}]}}"
    print("jwks unusable skipped {jwks_outcome(mixed)}")
}

fn main() ! io.Error {
    let all = algorithms()
    rfc(all)?
    interop(all)?
    signing(all)?
    jwks()
}
