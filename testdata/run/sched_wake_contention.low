fn send_range(out: chan[i64], first: i64, count: i64, done: chan[bool]) {
    for i in 0..count {
        out <- first + i
    }
    done <- true
}

fn drain(input: chan[i64], sums: chan[i64]) {
    var sum = 0
    var received = 0
    for v in input {
        sum += v
        received += 1
    }
    sums <- sum * 1000 + received % 1000
}

fn contend(pairs: i64, capacity: i64, per_sender: i64) {
    let channel = chan[i64](capacity)
    let done = chan[bool](pairs)
    let sums = chan[i64](pairs)
    for p in 0..pairs {
        spawn drain(channel, sums)
    }
    for p in 0..pairs {
        spawn send_range(channel, p * per_sender, per_sender, done)
    }
    for p in 0..pairs {
        let finished = <-done
    }
    close(channel)
    var total = 0
    for p in 0..pairs {
        total += ((<-sums) ?? 0) / 1000
    }
    let expected = (pairs * per_sender) * (pairs * per_sender - 1) / 2
    print("{pairs} {capacity} {total == expected}")
}

fn relay(input: chan[i64], output: chan[i64]) {
    for v in input {
        output <- v + 1
    }
    close(output)
}

fn chain(links: i64, rounds: i64) {
    let head = chan[i64]()
    var tail = head
    for l in 0..links {
        let next = chan[i64]()
        spawn relay(tail, next)
        tail = next
    }
    var last = 0
    for r in 0..rounds {
        head <- r
        last = (<-tail) ?? -1
    }
    close(head)
    print("chain {links} {last}")
}

fn main() {
    contend(1, 0, 20000)
    contend(2, 1, 20000)
    contend(8, 16, 5000)
    contend(16, 16, 2500)
    contend(64, 4, 500)
    chain(1, 20000)
    chain(8, 3000)
}
