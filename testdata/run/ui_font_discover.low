import std/file
import std/io
import std/os
import std/slices
import std/ui/font
import std/ui/text
import strings = std/text

struct Table {
    tag: str
    data: []u8
}

struct NameRecord {
    platform: i64
    encoding: i64
    language: i64
    id: i64
    data: []u8
}

fn u16s(values: []i64) -> []u8 {
    var b: []u8 = []
    for v in values {
        io.put_be16(mut b, v)
    }
    b
}

fn zeros(n: i64) -> []u8 {
    var b: []u8 = []
    for _ in 0..n {
        b.push(0)
    }
    b
}

fn assemble(tables: []Table) -> []u8 {
    var out: []u8 = []
    io.put_be32(mut out, 65536)
    io.put_be16(mut out, tables.len)
    for _ in 0..6 {
        out.push(0)
    }
    var offset = 12 + 16 * tables.len
    for t in tables {
        for i in 0..4 {
            out.push(t.tag[i])
        }
        io.put_be32(mut out, 0)
        io.put_be32(mut out, offset)
        io.put_be32(mut out, t.data.len)
        offset += (t.data.len + 3) / 4 * 4
    }
    for t in tables {
        for b in t.data {
            out.push(b)
        }
        for _ in 0..(4 - t.data.len % 4) % 4 {
            out.push(0)
        }
    }
    out
}

fn box() -> []u8 {
    var b = u16s([1, 0, 0, 0, 0, 3, 0])
    for _ in 0..4 {
        b.push(1)
    }
    for dx in [64, 448, 0, -448] {
        io.put_be16(mut b, dx)
    }
    for dy in [0, 0, 512, 0] {
        io.put_be16(mut b, dy)
    }
    b
}

fn cmap4(segments: []i64) -> []u8 {
    let n = segments.len / 3 + 1
    var b = u16s([0, 1, 3, 1, 0, 12, 4, 16 + 8 * n, 0, 2 * n, 0, 0, 0])
    for i in 0..n - 1 {
        io.put_be16(mut b, segments[3 * i + 1])
    }
    io.put_be16(mut b, 65535)
    io.put_be16(mut b, 0)
    for i in 0..n - 1 {
        io.put_be16(mut b, segments[3 * i])
    }
    io.put_be16(mut b, 65535)
    for i in 0..n - 1 {
        io.put_be16(mut b, segments[3 * i + 2] - segments[3 * i])
    }
    io.put_be16(mut b, 1)
    for _ in 0..n {
        io.put_be16(mut b, 0)
    }
    b
}

fn utf16be(s: str) -> []u8 {
    var b: []u8 = []
    for i in 0..s.len {
        io.put_be16(mut b, i64(s[i]))
    }
    b
}

fn name_record(platform: i64, encoding: i64, language: i64, id: i64, data: []u8) -> NameRecord {
    NameRecord { platform, encoding, language, id, data }
}

fn name_table(records: []NameRecord) -> []u8 {
    var strings_start = 6 + 12 * records.len
    var b = u16s([0, records.len, strings_start])
    var offset = 0
    for r in records {
        for v in [r.platform, r.encoding, r.language, r.id, r.data.len, offset] {
            io.put_be16(mut b, v)
        }
        offset += r.data.len
    }
    for r in records {
        for byte in r.data {
            b.push(byte)
        }
    }
    b
}

fn font_bytes(names: []NameRecord, segments: []i64, weight: i64) -> []u8 {
    var head = zeros(54)
    io.set_be16(head, 18, 1024)
    var hhea = zeros(36)
    io.set_be16(hhea, 4, 1024)
    io.set_be16(hhea, 6, -256)
    io.set_be16(hhea, 34, 4)
    var maxp = zeros(6)
    io.set_be16(maxp, 4, 4)
    var os2 = zeros(78)
    io.set_be16(os2, 4, weight)
    var glyf: []u8 = []
    var loca: []u8 = []
    io.put_be16(mut loca, 0)
    let empty: []u8 = []
    for g in [empty, empty, box(), box()] {
        for x in g {
            glyf.push(x)
        }
        io.put_be16(mut loca, glyf.len / 2)
    }
    assemble([
        Table { tag: "head", data: head }
        Table { tag: "hhea", data: hhea }
        Table { tag: "maxp", data: maxp }
        Table { tag: "cmap", data: cmap4(segments) }
        Table { tag: "hmtx", data: u16s([512, 0, 256, 0, 640, 0, 640, 0]) }
        Table { tag: "loca", data: loca }
        Table { tag: "glyf", data: glyf }
        Table { tag: "name", data: name_table(names) }
        Table { tag: "OS/2", data: os2 }
    ])
}

fn english(family: str) -> []NameRecord {
    [name_record(3, 1, 0x409, 1, utf16be(family))]
}

fn write_font(path: str, family: str, segments: []i64, weight: i64) {
    file.write_file(path, font_bytes(english(family), segments, weight)) or print("write failed {path}")
}

fn family_of(names: []NameRecord) -> str {
    let data = str(font_bytes(names, [65, 65, 2], 400))
    let f = font.parse(data) or return "unparsed"
    font.describe(f).family
}

fn names() {
    let roman: []u8 = [0x43, 0x61, 0x66, 0x8E, 0x20, 0xA5, 0xD0, 0xDB, 0xF0]
    print("mac roman [{family_of([name_record(1, 0, 0, 1, roman)])}]")
    print("mac ascii [{family_of([name_record(1, 0, 0, 1, [0x41, 0x7A])])}]")
    print("symbol [{family_of([name_record(3, 0, 0x409, 1, utf16be("Wingdings"))])}]")
    print("windows over mac [{family_of([name_record(1, 0, 0, 1, roman), name_record(3, 1, 0x409, 1, utf16be("Win"))])}]")
    print("typographic over mac [{family_of([name_record(1, 0, 0, 16, roman), name_record(1, 0, 0, 1, [0x41])])}]")
}

fn directories() {
    os.set_env("HOME", "/home/u") or print("set failed")
    os.set_env("XDG_DATA_HOME", "") or print("set failed")
    os.set_env("XDG_DATA_DIRS", "/a/share/:/a/share:/b/share//::/usr/share/") or print("set failed")
    print("listed {font.font_directories()}")
    os.set_env("XDG_DATA_DIRS", "") or print("set failed")
    print("empty dirs {font.font_directories()}")
    os.set_env("XDG_DATA_HOME", "/data/") or print("set failed")
    os.unset_env("XDG_DATA_DIRS") or print("unset failed")
    print("home set {font.font_directories()}")
}


fn list(label: str, dir: str) {
    var parts: []str = []
    for f in font.discover_in(dir) {
        let shown = strings.trim_prefix(f.path, dir)
        if !strings.contains(shown, "/locked/") {
            parts.push("{shown}={f.description.family}")
        }
    }
    print("{label}: {parts}")
}

fn shaped(label: str, l: text.Layout) {
    var parts: []str = []
    for g in l.lines[0].glyphs {
        parts.push("{g.font}/{g.glyph}")
    }
    print("{label}: font {l.font} {parts}")
}

fn tree(root: str) ! io.Error {
    let fonts = "{root}/fonts"
    let store = "{root}/store"
    file.mkdir_all("{fonts}/locked")?
    file.mkdir_all("{store}/cc")?
    let latin = [65, 65, 2]
    let han = [0x4E2D, 0x4E2D, 2]
    write_font("{fonts}/aa.ttf", "Aa", latin, 400)
    write_font("{store}/bb.ttf", "Bb", latin, 400)
    write_font("{store}/cc/cc.otf", "Cc", han, 400)
    write_font("{fonts}/zz.ttf", "Zz", latin, 400)
    write_font("{fonts}/locked/locked.ttf", "Locked", latin, 400)
    write_font("{root}/dd.ttf", "Dd", latin, 400)
    file.write_text("{fonts}/notes.txt", "not a font")?
    file.symlink("{store}/bb.ttf", "{fonts}/bb.ttf")?
    file.symlink("{store}/cc", "{fonts}/cc")?
    file.symlink(".", "{fonts}/loop")?
    file.symlink("missing.ttf", "{fonts}/dangling.ttf")?
    file.symlink(fonts, "{root}/rootlink")?
    file.chmod("{fonts}/locked", 0)?
    list("direct", fonts)
    list("trailing slash", "{fonts}/")
    list("linked root", "{root}/rootlink")
    list("missing", "{root}/missing")
    let faces = font.discover_in(fonts)
    for f in faces {
        if f.description.family == "Aa" {
            print("aa maps A {font.maps(f, 65)} maps han {font.maps(f, 0x4E2D)}")
        }
        if f.description.family == "Cc" {
            print("cc maps A {font.maps(f, 65)} maps han {font.maps(f, 0x4E2D)} maps U+10FFFD {font.maps(f, 0x10FFFD)}")
        }
    }
    let gone = font.Face { path: "{root}/gone.ttf" }
    let truncated = "{root}/truncated.ttf"
    file.write_file(truncated, [0, 1, 0, 0, 0, 20])?
    print("unreadable maps {font.maps(gone, 65)} {font.maps(font.Face { path: truncated }, 65)} {font.maps(font.Face { path: "{fonts}/aa.ttf", index: 1 }, 65)}")
    let usable = slices.filter(faces, fn(f: font.Face) -> bool { !strings.contains(f.path, "/locked/") })
    var sys = text.system_of(usable)
    let latin_only = text.Typeface { family: "Aa" }
    let f = text.Format { typeface: latin_only }
    shaped("fallback", sys.wrap("A中", f, 1000.0))
    shaped("unmapped", sys.wrap("A{strings.from_char(0x10FFFD)}", f, 1000.0))
    shaped("unmapped again", sys.wrap("{strings.from_char(0x10FFFD)}A", f, 1000.0))
    let extra = font.parse(str(font_bytes(english("Extra"), latin, 400))) or font.Font {}
    print("loaded fonts {text.add_font(mut sys, extra)}")
    let missing = font.Face { path: "{root}/missing.ttf", description: font.Description { family: "Dd", weight: 700 } }
    let present = font.Face { path: "{root}/dd.ttf", description: font.Description { family: "Dd", weight: 400 } }
    var retry = text.system_of([missing, present])
    shaped("retry", retry.wrap("A", text.Format { typeface: text.Typeface { family: "Dd", weight: 700 } }, 1000.0))
}

fn main() {
    names()
    directories()
    let root = file.temp_dir("low-ui-font-") or {
        print("no temp dir")
        return
    }
    tree(root) or print("tree failed")
    file.chmod("{root}/fonts/locked", 0o755) or {}
    file.remove_all(root) or print("cleanup failed")
}
