import std/crypto/limb
import std/crypto/nistec
import std/crypto/pairing
import std/zk/groth16

struct Case {
    name: str
    curve: *pairing.Curve
    order: str
}

struct Tally {
    failed: i64
}

fn check(t: *Tally, label: str, ok: bool) {
    if ok {
        print("ok   {label}")
    } else {
        t.failed += 1
        print("FAIL {label}")
    }
}

fn error_name(e: groth16.Error) -> str {
    match e {
        TooLarge => "TooLarge"
        Assignment => "Assignment"
        Unsatisfied => "Unsatisfied"
        Key => "Key"
        Malformed => "Malformed"
        Curve => "Curve"
        Point => "Point"
        Unsupported => "Unsupported"
    }
}

fn file(files: [str: str], path: str) -> str {
    files[path] ?? ""
}

fn same_values(a: u64[][], b: u64[][]) -> bool {
    if a.len != b.len {
        return false
    }
    for i in 0..a.len {
        if !limb.equal(a[i], b[i]) {
            return false
        }
    }
    true
}

fn r1cs_outcome(c: *pairing.Curve, data: u8[]) -> str {
    groth16.read_r1cs(c, data) catch { e => return error_name(e) }
    "read"
}

fn witness_outcome(c: *pairing.Curve, data: u8[]) -> str {
    groth16.read_witness(c, data) catch { e => return error_name(e) }
    "read"
}

fn proof_outcome(c: *pairing.Curve, text: str) -> str {
    groth16.proof_from_json(c, text) catch { e => return error_name(e) }
    "read"
}

fn key_outcome(c: *pairing.Curve, text: str) -> str {
    groth16.verifying_key_from_json(c, text) catch { e => return error_name(e) }
    "read"
}

fn public_outcome(c: *pairing.Curve, text: str) -> str {
    groth16.public_from_json(c, text) catch { e => return error_name(e) }
    "read"
}

fn prove_outcome(c: *pairing.Curve, s: groth16.System, assignment: u64[][]) -> str {
    let pk = groth16.setup(c, s) catch { e => return error_name(e) }
    groth16.prove(c, pk, s, assignment) catch { e => return error_name(e) }
    "proved"
}

fn plus_one(c: *pairing.Curve, a: u64[]) -> u64[] {
    let out = nistec.element(c.fp)
    nistec.add(c.fp, out, a, c.fp.one)
    out
}

fn off_curve(c: *pairing.Curve, p: pairing.Point) -> pairing.Point {
    let a = pairing.affine(c, p) ?? return p
    pairing.from_affine(c, a.x, plus_one(c, a.y))
}

fn replaced(values: u64[][], at: i64, value: u64[]) -> u64[][] {
    var out: u64[][] = []
    for x in values {
        out.push(x)
    }
    out[at] = value
    out
}

fn incremented(a: u64[]) -> u64[] {
    [a[0] + 1, a[1], a[2], a[3]]
}

fn prefixes_rejected(read: fn(u8[]) -> str, data: u8[]) -> bool {
    for n in 0..data.len {
        if read(data[..n]) != "Malformed" {
            return false
        }
    }
    true
}

fn snarkjs_vector(t: *Tally, k: Case, files: [str: str]) ! groth16.Error {
    let c = k.curve
    let name = k.name
    let vk = groth16.verifying_key_from_json(c, file(files, "{name}/verification_key.json"))?
    let proof = groth16.proof_from_json(c, file(files, "{name}/proof.json"))?
    let public = groth16.public_from_json(c, file(files, "{name}/public.json"))?
    check(t, "{name}: the snarkjs proof verifies under the snarkjs key", groth16.verify(c, vk, public, proof))

    check(t, "{name}: a changed public input is rejected", !groth16.verify(c, vk, replaced(public, 0, incremented(public[0])), proof))
    check(t, "{name}: a missing public input is rejected", !groth16.verify(c, vk, public[1..], proof))
    check(t, "{name}: a public input equal to the group order is rejected", !groth16.verify(c, vk, replaced(public, 0, c.fr.m), proof))

    let tampered = groth16.Proof { a: proof.a, b: proof.b, c: pairing.add(c, proof.c, c.g1) }
    check(t, "{name}: a changed C is rejected", !groth16.verify(c, vk, public, tampered))
    let swapped = groth16.Proof { a: proof.c, b: proof.b, c: proof.a }
    check(t, "{name}: swapping A and C is rejected", !groth16.verify(c, vk, public, swapped))
    check(t, "{name}: a proof point off the curve is rejected", !groth16.verify(c, vk, public, groth16.Proof { a: off_curve(c, proof.a), b: proof.b, c: proof.c }))

    let again = groth16.proof_from_json(c, groth16.proof_to_json(c, proof))?
    check(t, "{name}: the proof survives a JSON round trip", groth16.verify(c, vk, public, again))
    let key_again = groth16.verifying_key_from_json(c, groth16.verifying_key_to_json(c, vk))?
    check(t, "{name}: the verifying key survives a JSON round trip", groth16.verify(c, key_again, public, proof))
    check(t, "{name}: the public inputs survive a JSON round trip", same_values(public, groth16.public_from_json(c, groth16.public_to_json(public))?))
}

fn circom_files(t: *Tally, k: Case, files: [str: str]) ! groth16.Error {
    let c = k.curve
    let name = k.name
    let public = groth16.public_from_json(c, file(files, "{name}/public.json"))?
    let vk = groth16.verifying_key_from_json(c, file(files, "{name}/verification_key.json"))?
    let r1cs = bytes(file(files, "{name}/circuit.r1cs"))
    let wtns = bytes(file(files, "{name}/witness.wtns"))
    let s = groth16.read_r1cs(c, r1cs)?
    let w = groth16.read_witness(c, wtns)?
    check(t, "{name}: the witness has a value for every wire", w.len == s.variables)
    check(t, "{name}: the public wires of the witness are public.json", same_values(w[1..s.inputs + 1], public))
    check(t, "{name}: the verifying key has an element for every public wire", vk.ic.len == s.inputs + 1)

    let pk = groth16.setup(c, s)?
    let proof = groth16.prove(c, pk, s, w)?
    check(t, "{name}: our proof for the circom system verifies under our key", groth16.verify(c, pk.verifying, public, proof))
    check(t, "{name}: our proof is not accepted under the snarkjs key", !groth16.verify(c, vk, public, proof))
    let broken = replaced(w, w.len - 1, incremented(w[w.len - 1]))
    check(t, "{name}: a witness that breaks a constraint is refused", prove_outcome(c, s, broken) == "Unsatisfied")

    check(t, "{name}: write_r1cs and read_r1cs give a system that proves the same witness", prove_outcome(c, groth16.read_r1cs(c, groth16.write_r1cs(c, s))?, w) == "proved")
    check(t, "{name}: write_witness and read_witness round trip", same_values(w, groth16.read_witness(c, groth16.write_witness(c, w))?))
    check(t, "{name}: every prefix of the .r1cs is rejected", prefixes_rejected(fn(d) r1cs_outcome(c, d), r1cs))
    check(t, "{name}: every prefix of the .wtns is rejected", prefixes_rejected(fn(d) witness_outcome(c, d), wtns))
}

fn rejected_inputs(t: *Tally, bn: Case, bls: Case, files: [str: str]) {
    let c = bn.curve
    let other = bls.curve
    let proof_text = file(files, "cube_bn128/proof.json")
    let key_text = file(files, "cube_bn128/verification_key.json")
    check(t, "a bn128 proof is not read as bls12381", proof_outcome(other, proof_text) == "Curve")
    check(t, "a bn128 verifying key is not read as bls12381", key_outcome(other, key_text) == "Curve")
    check(t, "a bn128 .r1cs is not read as bls12381", r1cs_outcome(other, bytes(file(files, "cube_bn128/circuit.r1cs"))) == "Curve")
    check(t, "a bn128 .wtns is not read as bls12381", witness_outcome(other, bytes(file(files, "cube_bn128/witness.wtns"))) == "Curve")
    check(t, "a proof that is not JSON is malformed", proof_outcome(c, "pi_a") == "Malformed")
    check(t, "a proof without pi_c is malformed", proof_outcome(c, "{{\"pi_a\": [\"1\", \"2\", \"1\"], \"protocol\": \"groth16\", \"curve\": \"bn128\"}}") == "Malformed")
    check(t, "a proof for another protocol is malformed", proof_outcome(c, "{{\"protocol\": \"plonk\", \"curve\": \"bn128\"}}") == "Malformed")
    check(t, "a public input equal to the group order is malformed", public_outcome(c, "[\"{bn.order}\"]") == "Malformed")
    check(t, "a public input below the group order is read", public_outcome(c, "[\"21888242871839275222246405745257275088548364400416034343698204186575808495616\"]") == "read")
    check(t, "a public input with a sign is malformed", public_outcome(c, "[\"+5\"]") == "Malformed")
    check(t, "a public input with an underscore is malformed", public_outcome(c, "[\"1_0\"]") == "Malformed")
    check(t, "a public input that is a number is malformed", public_outcome(c, "[5]") == "Malformed")
    check(t, "the BLS12-381 group order is malformed as an input", public_outcome(other, "[\"{bls.order}\"]") == "Malformed")

    let vk = groth16.verifying_key_from_json(c, key_text) catch { _ => return }
    let proof = groth16.proof_from_json(c, proof_text) catch { _ => return }
    let off = groth16.Proof { a: off_curve(c, proof.a), b: proof.b, c: proof.c }
    check(t, "a proof point off the curve is refused when read", proof_outcome(c, groth16.proof_to_json(c, off)) == "Point")
    let bad_key = groth16.VerifyingKey { alpha: off_curve(c, vk.alpha), beta: vk.beta, gamma: vk.gamma, delta: vk.delta, ic: vk.ic }
    check(t, "a verifying key point off the curve is refused when read", key_outcome(c, groth16.verifying_key_to_json(c, bad_key)) == "Point")
}

fn main() {
    let t = new(Tally { failed: 0 })
    let bn = pairing.bn254()
    let bls = pairing.bls12_381()
    let orders = ["21888242871839275222246405745257275088548364400416034343698204186575808495617", "52435875175126190479447740508185965837690552500527637822603658699938581184513"]
    let files = embed_dir("vectors")
    var all: Case[] = []
    for circuit in ["cube", "mix"] {
        all.push(Case { name: "{circuit}_bn128", curve: bn, order: orders[0] })
        all.push(Case { name: "{circuit}_bls12381", curve: bls, order: orders[1] })
    }
    for k in all {
        snarkjs_vector(t, k, files) catch { e => check(t, "{k.name}: snarkjs vector ({error_name(e)})", false) }
        circom_files(t, k, files) catch { e => check(t, "{k.name}: circom files ({error_name(e)})", false) }
    }
    rejected_inputs(t, all[0], all[1], files)
    if t.failed != 0 {
        panic("{t.failed} checks failed")
    }
}
