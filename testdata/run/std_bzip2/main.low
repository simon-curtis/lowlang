import std/compress/bzip2
import std/hash
import std/io
import std/text

fn generated(n: i64, start: u64) -> []u8 {
    let words = ["alpha ", "beta ", "gamma ", "delta ", "stream ", "window ", "huffman ", "\n"]
    var out: []u8 = []
    var seed = start
    for out.len < n {
        seed = seed * 6364136223846793005 + 1442695040888963407
        text.append(mut out, words[i64(seed >> 61)])
    }
    out[..n]
}

fn noise(n: i64, start: u64) -> []u8 {
    let out = io.buffer(n)
    var seed = start
    for i in 0..n {
        seed = seed * 6364136223846793005 + 1442695040888963407
        out[i] = u8(seed >> 56)
    }
    out
}

fn repeated(n: i64, v: u8) -> []u8 {
    let out = io.buffer(n)
    for i in 0..n {
        out[i] = v
    }
    out
}

fn periodic(n: i64) -> []u8 {
    let out = io.buffer(n)
    for i in 0..n {
        out[i] = u8(97 + i % 2)
    }
    out
}

fn joined(parts: [][]u8) -> []u8 {
    var out: []u8 = []
    for p in parts {
        io.append(mut out, p)
    }
    out
}

fn same(a: []u8, b: []u8) -> bool {
    a.len == b.len && hash.crc32(a) == hash.crc32(b)
}

fn outcome(packed: []u8, limit: i64, want: []u8) -> str {
    let got = bzip2.decompress(packed, limit) catch {
        Malformed => return "Malformed"
        TooLarge => return "TooLarge"
        Unsupported => return "Unsupported"
        _ => return "other"
    }
    if same(got, want) { "ok" } else { "mismatch" }
}

fn summary(label: str, packed: []u8) {
    let got = bzip2.decompress(packed, 1 << 24) catch {
        _ => {
            print("{label} failed")
            return
        }
    }
    print("{label} {got.len} crc {hash.crc32(got)}")
}

fn references() {
    summary("empty", bytes(embed("empty.bz2")))
    summary("one", bytes(embed("one.bz2")))
    summary("run", bytes(embed("run.bz2")))
    summary("random", bytes(embed("random.bz2")))
    summary("text", bytes(embed("text.bz2")))
    summary("text block 100k", bytes(embed("text1.bz2")))
    summary("two blocks", bytes(embed("big.bz2")))
    summary("two streams", bytes(embed("multi.bz2")))
}

fn round_trips() {
    let empty: []u8 = []
    let names = ["empty", "byte", "hello", "text", "noise", "run", "period"]
    let inputs = [empty, bytes("a"), bytes("hello world"), generated(300000, 9), noise(150000, 10), repeated(500000, 7), periodic(250000)]
    for level in [1, 5, 9] {
        for i, data in inputs {
            let packed = bzip2.compress(data, level)
            print("level {level} {names[i]} {outcome(packed, 1 << 24, data)} smaller {packed.len < data.len}")
        }
    }
    let text = generated(60000, 11)
    for level in [0, 10, 100] {
        let packed = bzip2.compress(text, level)
        print("level {level} text {outcome(packed, 1 << 24, text)}")
    }
    var all: []u8 = []
    for _ in 0..3 {
        for v in 0..256 {
            push(mut all, u8(v))
        }
    }
    print("all bytes {outcome(bzip2.compress(all, 9), 1 << 24, all)}")
}

fn trickle(data: []u8) -> *io.Reader {
    var at = 0
    let stream = io.Stream {
        read: fn(buf) {
            if at >= data.len {
                0
            } else {
                buf[0] = data[at]
                at += 1
                1
            }
        }
        write: fn(buf) -> i64 ! io.Error { fail Unsupported }
        close: fn() {}
    }
    io.reader(stream)
}

fn streaming() ! io.Error {
    let data = joined([generated(250000, 12), noise(30000, 13), repeated(100000, 1), generated(100000, 12)])
    var packed: []u8 = []
    let sink: fn([]u8) ! io.Error = fn(b) { io.append(mut packed, b) }
    let e = bzip2.encoder(1, sink)
    var at = 0
    for at < data.len {
        let n = if at + 777 > data.len { data.len - at } else { 777 }
        bzip2.encode(e, data[at..at + n])?
        at += n
    }
    bzip2.finish(e)?
    var out: []u8 = []
    var chunks = 0
    var largest = 0
    let collect: fn([]u8) ! io.Error = fn(b) {
        chunks += 1
        if b.len > largest {
            largest = b.len
        }
        io.append(mut out, b)
    }
    bzip2.decode(trickle(packed), collect, 1 << 24)?
    print("stream {same(out, data)} chunked {chunks > 4 && largest <= 65536}")
    print("stream buffered {outcome(packed, 1 << 24, data)} smaller {packed.len < data.len / 3}")
}

fn errors() {
    let data = generated(20000, 14)
    let packed = bzip2.compress(data, 9)
    let empty: []u8 = []
    print("truncated {outcome(packed[..packed.len - 5], 1 << 24, data)}")
    print("truncated header {outcome(packed[..3], 1 << 24, data)}")
    print("truncated half {outcome(packed[..packed.len / 2], 1 << 24, data)}")
    let flipped = joined([packed])
    flipped[flipped.len / 2] ^= 4
    print("flipped {outcome(flipped, 1 << 24, data)}")
    let combined = joined([packed])
    combined[combined.len - 6] ^= 1
    print("combined crc {outcome(combined, 1 << 24, data)}")
    let block_crc = joined([packed])
    block_crc[10] ^= 1
    print("block crc {outcome(block_crc, 1 << 24, data)}")
    let random = joined([packed])
    random[14] ^= 0x80
    print("randomised {outcome(random, 1 << 24, data)}")
    print("limit {outcome(packed, data.len - 1, data)}")
    print("exact {outcome(packed, data.len, data)}")
    print("empty {outcome(empty, 1 << 24, empty)}")
    print("garbage {outcome(bytes("hello, world"), 1 << 24, empty)}")
    print("level 0 {outcome(bytes("BZh0"), 1 << 24, empty)}")
    print("trailing {outcome(joined([packed, bytes("junk")]), 1 << 24, data)}")
    let bomb = bzip2.compress(repeated(3000000, 0), 9)
    print("bomb {bomb.len < 100} {outcome(bomb, 1 << 20, empty)}")
    print("bomb exact {outcome(bomb, 3000000, repeated(3000000, 0))}")
    print("two streams {outcome(joined([packed, packed]), 1 << 24, joined([data, data]))}")
    print("two streams limit {outcome(joined([packed, packed]), 30000, empty)}")
}

fn verdict(step: fn() ! io.Error) -> str {
    step() catch {
        Invalid => return "Invalid"
        _ => return "other"
    }
    "accepted"
}

fn after_finish() ! io.Error {
    let e = bzip2.encoder(1, fn(chunk) {})
    bzip2.finish(e)?
    print("encode after finish {verdict(fn() ! io.Error { bzip2.encode(e, bytes("a"))? })}")
    print("finish after finish {verdict(fn() ! io.Error { bzip2.finish(e)? })}")
}

fn main() ! io.Error {
    references()
    round_trips()
    streaming()?
    errors()
    after_finish()?
}
