extern "c" {
    fn strlen(s: ptr[u8]) -> i64
    fn abs(n: i32) -> i32
    fn labs(n: i64) -> i64
    fn malloc(n: i64) -> ptr
    fn free(p: ptr)
    fn memset(p: ptr, c: i32, n: i64) -> ptr
    fn snprintf(buf: ptr[u8], n: i64, format: ptr[u8], ...) -> i32
    fn getenv(name: ptr[u8]) -> ptr[u8]
    fn strtol(s: ptr[u8], mut end: ptr, base: i32) -> i64
    fn div(a: i32, b: i32) -> DivT
    fn ldiv(a: i64, b: i64) -> LDivT
    fn toupper(c: i32) -> i32
    fn isdigit(c: i32) -> i32
}

extern "m" {
    fn cos(x: f64) -> f64
    fn pow(x: f64, y: f64) -> f64
    fn sqrtf(x: f32) -> f32
    fn fmaf(a: f32, b: f32, c: f32) -> f32
    fn frexp(x: f64, mut exponent: i32) -> f64
    fn modf(x: f64, mut whole: f64) -> f64
    fn cexp(z: Complex) -> Complex
}

extern struct DivT {
    quot: i32
    rem: i32
}

extern struct LDivT {
    quot: i64
    rem: i64
}

extern struct Complex {
    re: f64
    im: f64
}

extern struct Pixel {
    r: u8
    g: u8
    b: u8
    a: u8
}

fn main() {
    print(strlen(cstr("hello")))
    print(abs(-42))
    print(labs(-9000000000))
    let d = div(17, 5)
    print("{d.quot} {d.rem}")
    let l = ldiv(-17, 5)
    print("{l.quot} {l.rem}")

    print(cos(0.0))
    print(pow(2.0, 10.0))
    print(sqrtf(16.0))
    print(fmaf(2.0, 3.0, 1.0))
    var e: i32 = 0
    let m = frexp(48.0, mut e)
    print("{m} {e}")
    var whole = 0.0
    let frac = modf(3.25, mut whole)
    print("{frac} {whole}")
    let z = cexp(Complex { re: 0.0, im: 0.0 })
    print("{z.re} {z.im}")

    var end: ptr = null
    let text = cstr("123abc")
    print(strtol(text, mut end, 10))
    print(str(end))

    let buf: ptr[u8] = malloc(64)
    let n = snprintf(buf, 64, cstr("%d-%s-%.2f"), 42, cstr("x"), 3.14159)
    print(n)
    print(str(buf))
    free(buf)

    let raw: ptr[u8] = malloc(16)
    defer free(raw)
    memset(raw, 65, 16)
    let bytes = view(raw, 16)
    print(bytes[15])
    bytes[0] = 'Z'
    print(load(raw))
    store(raw, 'Y')
    print(str(bytes[0..2]))

    let missing = getenv(cstr("LOW_TEST_MISSING_VARIABLE"))
    print(missing == null)
    print(toupper('a'))
    print(isdigit('7') != 0)

    var px = Pixel { r: 1, g: 2, b: 3, a: 4 }
    px.g += 10
    print("{px.r} {px.g} {px.b} {px.a}")
    let pixels: ptr[Pixel] = malloc(16)
    defer free(pixels)
    let row = view(pixels, 4)
    row[2] = px
    print(row[2].g)
    let untyped: ptr = pixels
    let flat: ptr[u8] = untyped
    print(view(flat, 16)[9])
}
