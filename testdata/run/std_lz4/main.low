import std/compress/lz4
import std/hash
import std/io
import std/text

fn generated(n: i64, start: u64) -> []u8 {
    let words = ["alpha ", "beta ", "gamma ", "delta ", "stream ", "window ", "huffman ", "\n"]
    var out: []u8 = []
    var seed = start
    for out.len < n {
        seed = seed * 6364136223846793005 + 1442695040888963407
        text.append(mut out, words[i64(seed >> 61)])
    }
    out[..n]
}

fn noise(n: i64, start: u64) -> []u8 {
    let out = io.buffer(n)
    var seed = start
    for i in 0..n {
        seed = seed * 6364136223846793005 + 1442695040888963407
        out[i] = u8(seed >> 56)
    }
    out
}

fn repeated(n: i64, v: u8) -> []u8 {
    let out = io.buffer(n)
    for i in 0..n {
        out[i] = v
    }
    out
}

fn joined(parts: [][]u8) -> []u8 {
    var out: []u8 = []
    for p in parts {
        io.append(mut out, p)
    }
    out
}

fn same(a: []u8, b: []u8) -> bool {
    a.len == b.len && hash.crc32(a) == hash.crc32(b)
}

fn outcome(packed: []u8, limit: i64, want: []u8) -> str {
    let got = lz4.decompress(packed, limit) catch {
        Malformed => return "Malformed"
        TooLarge => return "TooLarge"
        Unsupported => return "Unsupported"
        _ => return "other"
    }
    if same(got, want) { "ok" } else { "mismatch" }
}

fn references() {
    print("linked {outcome(bytes(embed("linked.lz4")), 1 << 24, generated(70000, 5))}")
    print("checked {outcome(bytes(embed("checked.lz4")), 1 << 24, generated(70000, 6))}")
    print("noise {outcome(bytes(embed("noise.lz4")), 1 << 24, noise(3000, 7))}")
    let empty: []u8 = []
    let multi = joined([generated(500, 8), empty, repeated(300000, 'z')])
    print("multi {outcome(bytes(embed("multi.lz4")), 1 << 24, multi)}")
    let corrupt = bytes(embed("checked.lz4"))
    corrupt[corrupt.len / 2] ^= 4
    print("block checksum {outcome(corrupt, 1 << 24, empty)}")
}

fn round_trips() {
    let empty: []u8 = []
    let names = ["empty", "byte", "hello", "text", "noise", "run"]
    let inputs = [empty, bytes("a"), bytes("hello world"), generated(300000, 9), noise(200000, 10), repeated(500000, 7)]
    for level in [1, 3, 9] {
        for i, data in inputs {
            let packed = lz4.compress(data, level)
            print("level {level} {names[i]} {outcome(packed, 1 << 24, data)} smaller {packed.len < data.len}")
        }
    }
    let text = generated(60000, 11)
    for level in [0, 12, 30] {
        let packed = lz4.compress(text, level)
        print("level {level} text {outcome(packed, 1 << 24, text)} smaller {packed.len < text.len / 2}")
    }
}

fn streaming() ! io.Error {
    let data = joined([generated(400000, 12), noise(50000, 13), repeated(100000, 1), generated(100000, 12)])
    var packed: []u8 = []
    let sink: fn([]u8) ! io.Error = fn(b) { io.append(mut packed, b) }
    let e = lz4.encoder(3, sink)
    var at = 0
    var pieces = 0
    for at < data.len {
        let n = if at + 777 > data.len { data.len - at } else { 777 }
        lz4.encode(e, data[at..at + n])?
        at += n
        pieces += 1
        if pieces % 97 == 0 {
            lz4.flush(e)?
        }
    }
    lz4.finish(e)?
    var out: []u8 = []
    var chunks = 0
    var largest = 0
    let collect: fn([]u8) ! io.Error = fn(b) {
        chunks += 1
        if b.len > largest {
            largest = b.len
        }
        io.append(mut out, b)
    }
    lz4.decode(io.bytes_reader(packed), collect, 1 << 24)?
    print("stream {same(out, data)} chunked {chunks > 4 && largest <= 65536}")
    print("stream buffered {outcome(packed, 1 << 24, data)}")
}

fn errors() {
    let data = generated(20000, 14)
    let packed = lz4.compress(data, 3)
    print("truncated {outcome(packed[..packed.len - 5], 1 << 24, data)}")
    let flipped = joined([packed])
    flipped[flipped.len - 1] ^= 1
    print("checksum {outcome(flipped, 1 << 24, data)}")
    print("limit {outcome(packed, data.len - 1, data)}")
    print("exact {outcome(packed, data.len, data)}")
    let empty: []u8 = []
    print("empty {outcome(empty, 1 << 24, empty)}")
    var dictionary: []u8 = [0x04, 0x22, 0x4D, 0x18, 0x41, 0x40, 1, 0, 0, 0]
    push(mut dictionary, u8(hash.xxh32(dictionary[4..], 0) >> 8))
    io.append(mut dictionary, [0, 0, 0, 0])
    print("dictionary {outcome(dictionary, 1 << 24, empty)}")
    let legacy: []u8 = [0x02, 0x21, 0x4C, 0x18, 0, 0, 0, 0]
    print("legacy {outcome(legacy, 1 << 24, empty)}")
    let garbage: []u8 = [1, 2, 3, 4, 5, 6, 7, 8]
    print("garbage {outcome(garbage, 1 << 24, empty)}")
}

fn verdict(step: fn() ! io.Error) -> str {
    step() catch {
        Invalid => return "Invalid"
        _ => return "other"
    }
    "accepted"
}

fn after_finish() ! io.Error {
    let e = lz4.encoder(3, fn(chunk) {})
    lz4.finish(e)?
    print("encode after finish {verdict(fn() ! io.Error { lz4.encode(e, bytes("a"))? })}")
    print("flush after finish {verdict(fn() ! io.Error { lz4.flush(e)? })}")
    print("finish after finish {verdict(fn() ! io.Error { lz4.finish(e)? })}")
}

fn main() ! io.Error {
    references()
    round_trips()
    streaming()?
    errors()
    after_finish()?
}
