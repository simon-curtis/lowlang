fn scaled(a: i64, b: i64, n: i64) -> i64 {
    var total = 0
    for i in 0..n {
        total += a * b + i
    }
    total
}

fn last_product(a: i64, b: i64, n: i64) -> i64 {
    var last = -1
    for i in 0..n {
        last = a * b + 1
    }
    last
}

fn after_loop(a: i64, n: i64) -> i64 {
    var scaled = 0
    var i = 0
    for i < n {
        scaled = a * 1000003 + i * 0
        i += 1
    }
    scaled + i
}

fn float_scale(x: f64, n: i64) -> f64 {
    var total = 0.0
    for i in 0..n {
        total += sqrt(x) * 2.5 + f64(i)
    }
    total
}

fn shifts(x: i64, n: i64) -> i64 {
    var total = 7
    for i in 0..n {
        total += (x << 3) ^ (x >> 2) | 1
    }
    total
}

fn main() {
    print(scaled(3, 4, 0))
    print(scaled(3, 4, 5))
    print(last_product(3, 4, 0))
    print(last_product(3, 4, 2))
    print(after_loop(5, 0))
    print(after_loop(5, 3))
    print(float_scale(16.0, 0))
    print(float_scale(16.0, 3))
    print(shifts(9, 0))
    print(shifts(9, 4))
}
