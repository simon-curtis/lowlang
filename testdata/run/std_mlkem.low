import std/crypto/hash
import std/crypto/mlkem
import std/crypto/sha3
import std/text

fn accumulated(n: i64) -> str {
    let s = sha3.shake128()
    let o = sha3.shake128()
    for _ in 0..n {
        let seed = sha3.squeeze(s, 64)
        let keys = mlkem.generate_seeded(Kem768, seed[..32], seed[32..])
        sha3.absorb(o, keys.encapsulation)
        let msg = sha3.squeeze(s, 32)
        let e = mlkem.encapsulate_seeded(Kem768, keys.encapsulation, msg) or return "encapsulate failed"
        sha3.absorb(o, e.ciphertext)
        sha3.absorb(o, e.shared)
        let back = mlkem.decapsulate(Kem768, keys.decapsulation, e.ciphertext) or return "decapsulate failed"
        if !hash.equal(back, e.shared) {
            return "shared secret mismatch"
        }
        let random = sha3.squeeze(s, 1088)
        let rejected = mlkem.decapsulate(Kem768, keys.decapsulation, random) or return "decapsulate failed"
        sha3.absorb(o, rejected)
    }
    text.encode_hex(sha3.squeeze(o, 32))
}

fn seq(from: i64, n: i64) -> []u8 {
    var out: []u8 = []
    for i in 0..n {
        push(mut out, u8(from + i))
    }
    out
}

fn encapsulate_status(level: mlkem.Level, ek: []u8) -> str {
    let e = mlkem.encapsulate(level, ek) catch {
        Invalid => return "rejected"
        _ => return "other error"
    }
    "accepted {e.ciphertext.len}"
}

fn decapsulate_status(level: mlkem.Level, dk: []u8, ct: []u8, expected: []u8) -> str {
    let shared = mlkem.decapsulate(level, dk, ct) catch {
        Invalid => return "rejected"
        _ => return "other error"
    }
    "accepted {hash.equal(shared, expected)}"
}

fn levels(level: mlkem.Level) {
    let keys = mlkem.generate_seeded(level, seq(0, 32), seq(32, 32))
    let e = mlkem.encapsulate_seeded(level, keys.encapsulation, seq(100, 32)) or return
    print("{keys.encapsulation.len} {keys.decapsulation.len} {e.ciphertext.len}")
    let d = sha3.sha3_256().digest()
    d.update(keys.encapsulation)
    d.update(keys.decapsulation)
    d.update(e.ciphertext)
    print(text.encode_hex(d.finish()))
    print(text.encode_hex(e.shared))
    e.ciphertext[0] ^= 1
    let rejected = mlkem.decapsulate(level, keys.decapsulation, e.ciphertext) or return
    let z = keys.decapsulation[keys.decapsulation.len - 32..]
    let j = sha3.shake256()
    sha3.absorb(j, z)
    sha3.absorb(j, e.ciphertext)
    print("implicit rejection {hash.equal(rejected, sha3.squeeze(j, 32))}")
}

fn main() {
    print(accumulated(100))
    levels(Kem512)
    levels(Kem768)
    levels(Kem1024)
    let keys = mlkem.generate_seeded(Kem768, seq(0, 32), seq(32, 32))
    let ek = keys.encapsulation
    let dk = keys.decapsulation
    print(encapsulate_status(Kem768, ek))
    print(encapsulate_status(Kem768, ek[..100]))
    print(encapsulate_status(Kem1024, ek))
    let low = ek[0]
    let high = ek[1]
    ek[0] = 0xFF
    ek[1] |= 0x0F
    print(encapsulate_status(Kem768, ek))
    ek[0] = low
    ek[1] = high
    let e = mlkem.encapsulate(Kem768, ek) or return
    print(decapsulate_status(Kem768, dk, e.ciphertext, e.shared))
    print(decapsulate_status(Kem768, dk, e.ciphertext[1..], e.shared))
    print(decapsulate_status(Kem768, dk[1..], e.ciphertext, e.shared))
    dk[1200] ^= 1
    print(decapsulate_status(Kem768, dk, e.ciphertext, e.shared))
    let fresh = mlkem.generate(Kem512)
    let f = mlkem.encapsulate(Kem512, fresh.encapsulation) or return
    print(decapsulate_status(Kem512, fresh.decapsulation, f.ciphertext, f.shared))
}
