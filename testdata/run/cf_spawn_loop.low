struct Report {
    id: i64
    total: i64
    scale: f64
}

fn produce(id: i64, rounds: i64, out: chan[Report]) {
    var total = 0
    var scale = 1.0
    for r in 0..rounds {
        total += (id + 1) * (r + 1)
        scale = scale * 1.5 + f64(r)
        if r % 7 == 0 {
            scale = scale / 3.0
        }
    }
    out <- Report { id: id, total: total, scale: scale }
}

fn spin(rounds: i64, done: chan[i64]) {
    var n = 0
    var acc = 1
    for i in 0..rounds {
        n += 1
        acc = (acc * 33 + i) % 100003
    }
    done <- acc + n
}

fn collect(workers: i64, rounds: i64) -> i64 {
    let out = chan[Report](4)
    for id in 0..workers {
        spawn produce(id, rounds, out)
    }
    var total = 0
    var weighted = 0
    var seen = 0
    for i in 0..workers {
        let report = (<-out) ?? Report { id: -1, total: 0, scale: 0.0 }
        total += report.total
        weighted += i64(report.scale) * (report.id + 1)
        seen += 1
    }
    total * 1000 + seen + weighted % 1000
}

fn polling(workers: i64) -> i64 {
    let done = chan[i64](workers)
    for w in 0..workers {
        spawn spin(2000000 + w, done)
    }
    var sum = 0
    var received = 0
    for received < workers {
        sum += (<-done) ?? 0
        received += 1
    }
    sum
}

fn pipeline(n: i64) -> i64 {
    let stage1 = chan[i64](3)
    let stage2 = chan[i64](3)
    spawn fn() {
        for i in 0..n {
            stage1 <- i * i
        }
        close(stage1)
    }()
    spawn fn() {
        for v in stage1 {
            stage2 <- v + 1
        }
        close(stage2)
    }()
    var sum = 0
    var count = 0
    for v in stage2 {
        sum += v
        count += 1
    }
    sum * 100 + count
}

fn main() {
    print(collect(1, 10))
    print(collect(8, 50))
    print(collect(20, 5))
    print(polling(6))
    print(pipeline(0))
    print(pipeline(100))
}
