extern "c" {
    fn labs(n: i64) -> i64
}

struct Point {
    x: i64
    y: i64
}

fn label(i: i64) -> str {
    "p{i}:{i * i}"
}

fn boxed(a: i64, b: i64) -> i64 {
    let p = new(Point { x: a, y: b })
    p.x * 31 + p.y
}

fn magnitude(n: i64) -> i64 {
    labs(n - 50)
}

fn take(c: chan[i64], fallback: i64) -> i64 {
    select {
        v = <-c => v ?? fallback
        after(1) => fallback
    }
}

fn rotate(mut a: u8, mut b: u8) {
    let t = a
    a = b
    b = t + 1
}

fn nested(i: i64) -> i64 {
    let s = label(i)
    boxed(s.len, i) + magnitude(i)
}

fn main() {
    var total = 0
    var text = 0
    var last = ""
    let c = chan[i64](16)
    for i in 0..100 {
        let s = label(i)
        text += s.len
        last = s
        total += boxed(i, i + 1) + magnitude(i) + nested(i)
        if i % 10 == 0 {
            c <- i
        }
    }
    var drained = 0
    for i in 0..12 {
        drained += take(c, -1)
    }
    var bytes: []u8 = [1, 2, 3, 4]
    for i in 0..6 {
        rotate(mut bytes[0], mut bytes[3])
    }
    print(total)
    print(text)
    print(last)
    print(drained)
    print(bytes[0])
    print(bytes[3])
}
