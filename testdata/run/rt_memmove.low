import std/io

fn pattern(n: i64, seed: i64) -> u8[] {
    var out: u8[] = []
    for i in 0..n {
        out.push(u8((i * 31 + seed * 7) % 251))
    }
    out
}

fn main() {
    var bad = 0
    var checked = 0
    for n in 0..201 {
        for shift in -80..81 {
            let total = n + 170
            let buf = pattern(total, n + shift)
            let ref = pattern(total, n + shift)
            let src = 85
            let dst = 85 + shift
            var tmp: u8[] = []
            for i in 0..n {
                tmp.push(ref[src + i])
            }
            for i in 0..n {
                ref[dst + i] = tmp[i]
            }
            let moved = io.copy(buf[dst..dst + n], buf[src..src + n])
            if moved != n {
                bad += 1
            }
            for i in 0..total {
                if buf[i] != ref[i] {
                    bad += 1
                }
            }
            checked += 1
        }
    }
    print(checked)
    print(bad)
}
