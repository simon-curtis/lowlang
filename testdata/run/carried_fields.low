struct Scanner {
    text: str
    pos: i64
}

struct Counter {
    count: i64
    scale: f64
}

struct Box {
    value: i64
}

fn skip_spaces(s: *Scanner, depth: i64) {
    if depth > 0 {
        skip_spaces(s, depth - 1)
        return
    }
    for s.pos < s.text.len && s.text[s.pos] == ' ' {
        s.pos += 1
    }
}

fn scaled_sum(c: *Counter, n: i64, depth: i64) -> f64 {
    if depth > 0 {
        return scaled_sum(c, n, depth - 1)
    }
    var total = 0.0
    for i in 0..n {
        total += c.scale * f64(i)
    }
    total
}

fn count_below(c: *Counter, depth: i64) -> i64 {
    if depth > 0 {
        return count_below(c, depth - 1)
    }
    var i = 0
    for i < c.count {
        i += 1
    }
    i
}

fn first_of(xs: i64[], n: i64, depth: i64) -> i64 {
    if depth > 0 {
        return first_of(xs, n, depth - 1)
    }
    var total = 0
    for i in 0..n {
        total += xs[0]
    }
    total
}

fn guarded(b: *Box?, n: i64, depth: i64) -> i64 {
    if depth > 0 {
        return guarded(b, n, depth - 1)
    }
    var total = 0
    for i in 0..n {
        match b {
            some(p) => { total += p.value }
            none => { total += 1 }
        }
    }
    total
}

fn twin(a: *Counter, b: *Counter, n: i64, depth: i64) -> i64 {
    if depth > 0 {
        return twin(a, b, n, depth - 1)
    }
    var total = 0
    for i in 0..n {
        total += a.count
        b.count = total
    }
    total
}

fn stop_after_store(c: *Counter, limit: i64, depth: i64) -> i64 {
    if depth > 0 {
        return stop_after_store(c, limit, depth - 1)
    }
    for c.count < 100 {
        c.count += 7
        if c.count > limit {
            break
        }
    }
    c.count
}

fn nested(c: *Counter, n: i64, depth: i64) -> i64 {
    if depth > 0 {
        return nested(c, n, depth - 1)
    }
    for i in 0..n {
        for j in 0..n {
            c.count += i * j
        }
        c.count += 1
    }
    c.count
}

fn bump(c: *Counter, depth: i64) {
    if depth > 0 {
        bump(c, depth - 1)
        return
    }
    c.count += 1000
}

fn with_call(c: *Counter, n: i64, depth: i64) -> i64 {
    if depth > 0 {
        return with_call(c, n, depth - 1)
    }
    var total = 0
    for i in 0..n {
        total += c.count
        bump(c, 1)
    }
    total
}

fn main() {
    let s = new(Scanner { text: "   abc", pos: 0 })
    skip_spaces(s, 1)
    print("skip_spaces {s.pos}")
    let blank = new(Scanner { text: "", pos: 0 })
    skip_spaces(blank, 1)
    print("skip_spaces empty {blank.pos}")
    let c = new(Counter { count: 0, scale: 0.5 })
    print("scaled_sum {scaled_sum(c, 4, 1)}")
    let limit = new(Counter { count: 5, scale: 0.0 })
    print("count_below {count_below(limit, 1)}")
    let none_yet: i64[] = []
    print("first_of empty {first_of(none_yet, 0, 1)}")
    print("first_of {first_of([5, 6], 3, 1)}")
    print("guarded none {guarded(none, 3, 1)}")
    print("guarded some {guarded(new(Box { value: 4 }), 3, 1)}")
    let shared = new(Counter { count: 1, scale: 0.0 })
    print("twin shared {twin(shared, shared, 4, 1)} {shared.count}")
    let other = new(Counter { count: 1, scale: 0.0 })
    let target = new(Counter { count: 0, scale: 0.0 })
    print("twin apart {twin(other, target, 4, 1)} {target.count}")
    let stopped = new(Counter { count: 0, scale: 0.0 })
    print("stop_after_store {stop_after_store(stopped, 20, 1)} {stopped.count}")
    let grid = new(Counter { count: 0, scale: 0.0 })
    print("nested {nested(grid, 3, 1)}")
    let called = new(Counter { count: 1, scale: 0.0 })
    print("with_call {with_call(called, 3, 1)} {called.count}")
}
