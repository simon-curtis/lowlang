import std/locale
import std/locale/numfmt
import std/text
import std/text/number

fn clean(s: str) -> str {
    let a = text.replace(s, text.from_char(0x202f), " ")
    text.replace(a, text.from_char(0xa0), " ")
}

fn render(l: locale.Locale, kind: str, value: str) -> str {
    let n = text.parse_int(value) or 0
    let x = text.parse_float(value) or 0.0
    if kind == "grouped" {
        return number.grouped_in(l, n)
    }
    if kind == "compact-short" {
        return number.compact_in(l, n, numfmt.CompactDisplay.Short)
    }
    if kind == "compact-long" {
        return number.compact_in(l, n, numfmt.CompactDisplay.Long)
    }
    if text.starts_with(kind, "percent-") {
        return number.percent_in(l, x, text.parse_int(kind[8..]) or 0)
    }
    number.currency_in(l, x, kind[9..]) or "error"
}

fn main() {
    var checked = 0
    var failed = 0
    var current = ""
    var l = locale.root()
    for line in text.lines(embed("number.tsv")) {
        let f = text.split(line, '\t')
        if f.len != 4 {
            continue
        }
        if f[0] != current {
            current = f[0]
            l = locale.parse(current) or locale.root()
        }
        let got = clean(render(l, f[1], f[2]))
        checked += 1
        if got != f[3] {
            failed += 1
            if failed <= 30 {
                print("{f[0]} {f[1]} {f[2]}: want {f[3]}, got {got}")
            }
        }
    }
    print("number: {checked} checked, {failed} wrong")

    print(number.grouped(1234567, ","))
    print(number.percent(0.256, 1))
    print(number.compact(1500))
    print(number.currency_in(locale.root(), 1.0, "ZZZ") catch {
        UnknownCurrency(code) => "unknown currency {code}"
        e => "other"
    })
}
