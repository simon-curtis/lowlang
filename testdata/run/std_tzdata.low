import std/time/fault
import std/time/offset
import std/time/timestamp
import std/time/tzdata
import std/time/zone

fn describe(f: fault.Fault) -> str {
    match f {
        Invalid(what) => "Invalid({what})"
        UnknownZone(name) => "UnknownZone({name})"
        Malformed(what) => "Malformed({what})"
        _ => fault.to_string(f)
    }
}

fn at(secs: i64) -> timestamp.Timestamp {
    timestamp.from_unix(secs) catch { e => timestamp.epoch() }
}

fn secs_of(iso: str) -> i64 {
    let ts = timestamp.parse(iso) catch { e => timestamp.epoch() }
    timestamp.unix_seconds(ts)
}

fn show_info(i: zone.Info) -> str {
    "{offset.to_string(i.offset)} {i.abbreviation} {i.dst}"
}

fn show_candidates(c: zone.Candidates) -> str {
    match c {
        One(o) => "One({offset.to_string(o)})"
        Overlap(a, b) => "Overlap({offset.to_string(a)},{offset.to_string(b)})"
        Gap(a, b) => "Gap({offset.to_string(a)},{offset.to_string(b)})"
    }
}

fn show_transition(t: zone.Transition?) -> str {
    match t {
        some(x) => "{timestamp.to_string(x.at)} {show_info(x.before)} > {show_info(x.after)}"
        none => "none"
    }
}

fn embedded(name: str) -> zone.Zone ! fault.Fault {
    zone.load_from(name, tzdata.source())?
}

fn fold(h: i64, line: str) -> i64 {
    var next = h
    for i in 0..line.len {
        next = (next * 131 + i64(line[i])) % 2147483647
    }
    (next * 131 + 10) % 2147483647
}

fn fingerprint(z: zone.Zone, start: str, count: i64, step: i64) -> i64 {
    let first = secs_of(start)
    var h = 7
    for i in 0..count {
        let s = first + i * step
        let ts = at(s)
        h = fold(h, show_info(zone.info_at(z, ts)))
        h = fold(h, offset.to_string(zone.offset_at(z, ts)))
        h = fold(h, show_candidates(zone.candidates(z, s)))
        h = fold(h, show_transition(zone.next_transition(z, ts)))
        h = fold(h, show_transition(zone.previous_transition(z, ts)))
    }
    h
}

fn fingerprint_named(name: str, start: str, count: i64, step: i64) {
    let z = embedded(name) catch {
        e => return print("{name} {describe(e)}")
    }
    let h = fingerprint(z, start, count, step)
    print("{name} {zone.name(z)} from {start} count {count} hash {h}")
}

fn sample() {
    let names = ["UTC", "Etc/GMT+5", "America/New_York", "Europe/London", "Europe/Dublin", "Australia/Lord_Howe", "Asia/Kolkata", "Asia/Kathmandu", "America/St_Johns", "Pacific/Apia", "Pacific/Kiritimati", "America/Sao_Paulo", "Africa/Casablanca", "Antarctica/Troll", "Asia/Tehran", "Asia/Tokyo", "Europe/Paris", "Europe/Moscow", "Australia/Sydney", "America/Los_Angeles", "Pacific/Chatham", "America/Santiago", "Asia/Beirut", "America/Nuuk", "Africa/Cairo", "Pacific/Auckland", "America/Caracas", "US/Eastern", "Asia/Calcutta", "Africa/Asmera", "Europe/Kyiv", "America/Argentina/Buenos_Aires"]
    for name in names {
        fingerprint_named(name, "1850-01-01T00:00:00Z", 365 * 35, 86400 * 10)
    }
    for name in names {
        fingerprint_named(name, "2026-01-01T00:00:00Z", 4 * 366, 6 * 3600)
    }
    for name in names {
        fingerprint_named(name, "2500-01-01T00:00:00Z", 4 * 366, 6 * 3600)
    }
    for name in names {
        fingerprint_named(name, "9000-01-01T00:00:00Z", 4 * 366, 6 * 3600)
    }
}

fn every_name() {
    let all = tzdata.names()
    var sorted = true
    for i in 1..all.len {
        if all[i - 1] >= all[i] {
            sorted = false
        }
    }
    var loaded = 0
    var failed = 0
    var h = 7
    for name in all {
        let z = embedded(name) catch {
            e => {
                failed += 1
                print("embedded {name} {describe(e)}")
                continue
            }
        }
        loaded += 1
        let zone_hash = fingerprint(z, "1900-01-01T00:00:00Z", 240, 86400 * 300)
        h = fold(h, "{name} {zone_hash}")
    }
    print("names {all.len} sorted {sorted} loaded {loaded} failed {failed} hash {h}")
}

fn expectations() {
    print("version {tzdata.version()}")
    let all = tzdata.names()
    var has_utc = false
    var has_ny = false
    var has_link = false
    for name in all {
        if name == "UTC" {
            has_utc = true
        }
        if name == "America/New_York" {
            has_ny = true
        }
        if name == "US/Eastern" {
            has_link = true
        }
    }
    print("names include {has_utc} {has_ny} {has_link} first {all[0]} last {all[all.len - 1]}")
    let ny = embedded("America/New_York") catch { e => zone.utc() }
    print("ny {zone.name(ny)} {show_info(zone.info_at(ny, at(secs_of("2026-07-01T12:00:00Z"))))}")
    print("ny {show_info(zone.info_at(ny, at(secs_of("2026-01-01T12:00:00Z"))))}")
    print("ny next {show_transition(zone.next_transition(ny, at(secs_of("2026-11-11T00:00:00Z"))))}")
    let source = tzdata.source()
    for name in ["America/New_York", "UTC", "Nowhere/Land", "", "america/new_york", "America", "../etc/passwd", "America/New_York "] {
        let data = source(name)
        match data {
            some(bytes) => print("source [{name}] {bytes.len} {bytes[0]} {bytes[1]} {bytes[2]} {bytes[3]}")
            none => print("source [{name}] none")
        }
    }
    let a = source("UTC") ?? []
    a[0] = 0
    let b = source("UTC") ?? []
    print("source copies {a[0]} {b[0]} {a.len == b.len}")
    for name in ["Nowhere/Land", "", "../x", "america/new_york"] {
        let z = embedded(name) catch {
            e => {
                print("load_from [{name}] {describe(e)}")
                continue
            }
        }
        print("load_from [{name}] {zone.name(z)}")
    }
    let again = tzdata.source()
    let first = again("Europe/Paris") ?? []
    let second = source("Europe/Paris") ?? []
    var same = first.len == second.len
    for i in 0..first.len {
        if first[i] != second[i] {
            same = false
        }
    }
    print("sources agree {same}")
}

fn main() {
    expectations()
    every_name()
    sample()
}
