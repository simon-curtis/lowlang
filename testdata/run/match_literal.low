fn width(n: i64) -> i64 {
    match n {
        4 => 1,
        16 => 4,
        _ => 3
    }
}

fn tag(name: str) -> i64 {
    match name {
        "a" => 1,
        "b" => 2,
        _ => 0
    }
}

fn letter(c: u8) -> i64 {
    match c {
        'x' => 10
        'y' => 20
        _ => 0
    }
}

fn mixed(n: i64) -> str {
    match n {
        0 => "zero",
        % 2 == 0 => "even",
        _ => "odd"
    }
}

enum Mode {
    Fast
    Slow
}

fn sign(n: i64) -> str {
    match n {
        -1 => "minus one",
        (width(16) + 1) => "five",
        0 => "zero",
        _ => "other"
    }
}

fn mode(m: Mode) -> i64 {
    match m {
        Mode.Fast => 1,
        _ => 2
    }
}

fn flag(b: bool) -> i64 {
    match b {
        true => 1,
        _ => 0
    }
}

fn main() {
    print(sign(-1))
    print(sign(5))
    print(sign(0))
    print(sign(9))
    print(mode(Fast))
    print(mode(Slow))
    print(flag(true))
    print(flag(false))
    print(width(4))
    print(width(16))
    print(width(7))
    print(tag("a"))
    print(tag("b"))
    print(tag("c"))
    print(letter('x'))
    print(letter('y'))
    print(letter('z'))
    print(mixed(0))
    print(mixed(2))
    print(mixed(3))
}
