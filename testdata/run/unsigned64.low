fn main() {
    let max: u64 = 0xFFFFFFFFFFFFFFFF
    print(max)
    let big: u64 = 18446744073709551000
    print(big / 1000)
    print(big % 1000)
    print(max > 1)
    print(max >> 60)
    var x: u64 = 1 << 63
    print(x)
    x += x
    print(x)
    print(u64(-1) == max)
    print(i64(max))
    print(f64(max))
    print(u64(1.5e19))
    print(u64(3.0))
    let h: u64 = 0x8000000000000001
    print("{h} {h * 3}")
    let m = [h, max, 7]
    print(m[1] - m[2])
    var words: [u64: str] = [:]
    words[max] = "top"
    print(words[max] ?? "missing")
}
