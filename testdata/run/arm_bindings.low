enum Shape {
    Circle(f64)
    Square(f64)
    Dot
}

enum Oops {
    Bad(i64)
    Worse
}

fn risky(n: i64) -> i64 ! Oops {
    if n > 2 {
        fail Bad(n)
    }
    if n < 0 {
        fail Worse
    }
    n
}

fn describe(e: Oops) -> str {
    match e {
        Bad(n) => "bad {n}"
        Worse => "worse"
    }
}

fn name(s: Shape) -> str {
    match s {
        Dot => "dot"
        other => "shape, circle of 1: {other == Circle(1.0)}"
    }
}

fn main() {
    print(risky(5) catch {
        e => {
            print(describe(e))
            0
        }
    })
    print(risky(-1) catch {
        Bad(n) => n
        problem => {
            print(describe(problem))
            -1
        }
    })
    print(name(Circle(1.0)))
    print(name(Square(2.0)))
    print(name(Dot))
    match 7 {
        % 2 == 0 => print("even")
        odd => print("odd {odd}")
    }
    let maybe: i64? = none
    match maybe {
        some(v) => print(v)
        missing => print("missing {missing == none}")
    }
}
