import std/base64
import std/cbor
import std/crypto/hash
import std/json
import std/text
import std/webauthn

struct Vector {
    name: str
    kind: str
    credential: str
    challenge: str
    public_key: str
    sign_count: i64
    require_uv: bool
}

fn digest(label: str, size: i64) -> []u8 {
    let full = hash.sum(hash.sha256(), bytes(label))
    full[..size]
}

fn error_text(e: webauthn.Error) -> str {
    match e {
        MalformedCredential(field) => "MalformedCredential({field})"
        IdMismatch => "IdMismatch"
        WrongCredentialType(found) => "WrongCredentialType({found})"
        MalformedClientData => "MalformedClientData"
        WrongClientDataType(found) => "WrongClientDataType({found})"
        ChallengeMismatch => "ChallengeMismatch"
        OriginMismatch(found) => "OriginMismatch({found})"
        MalformedAttestationObject => "MalformedAttestationObject"
        UnsupportedAttestation(format) => "UnsupportedAttestation({format})"
        UnexpectedAttestationStatement => "UnexpectedAttestationStatement"
        MalformedAuthenticatorData => "MalformedAuthenticatorData"
        RpIdHashMismatch => "RpIdHashMismatch"
        UserNotPresent => "UserNotPresent"
        UserNotVerified => "UserNotVerified"
        MissingCredentialData => "MissingCredentialData"
        InconsistentBackupFlags => "InconsistentBackupFlags"
        MalformedPublicKey => "MalformedPublicKey"
        UnsupportedAlgorithm(alg) => "UnsupportedAlgorithm({alg})"
        BadSignature => "BadSignature"
        SignCountRegression(received, stored) => "SignCountRegression({received}, {stored})"
    }
}

fn decoded(s: str) -> []u8 {
    base64.decode_url(s) catch []
}

fn stored_record(r: webauthn.Registration) -> str {
    let record = json.Value.Object([
        json.Member { name: "id", value: json.Value.Str(base64.encode_url(r.credential_id)) },
        json.Member { name: "publicKey", value: json.Value.Str(base64.encode_url(r.public_key)) },
        json.Member { name: "signCount", value: json.Value.Int(r.sign_count) },
    ])
    json.stringify(record, 0)
}

fn register(name: str, credential: json.Value, expected: webauthn.Expected) {
    let r = webauthn.verify_registration(credential, expected) catch {
        e => {
            print("{name}: {error_text(e)}")
            return
        }
    }
    print("{name}: ok {stored_record(r)} aaguid={text.encode_hex(r.aaguid)} uv={r.user_verified} multi_device={r.multi_device} backed_up={r.backed_up}")
}

fn login(name: str, credential: json.Value, expected: webauthn.Expected, public_key: []u8, sign_count: i64) {
    let a = webauthn.verify_authentication(credential, expected, public_key, sign_count) catch {
        e => {
            print("{name}: {error_text(e)}")
            return
        }
    }
    print("{name}: ok id={base64.encode_url(a.credential_id)} count={a.new_sign_count} uv={a.user_verified} multi_device={a.multi_device} backed_up={a.backed_up}")
}

fn run(v: Vector) {
    let credential = json.parse(decoded(v.credential)) catch {
        _ => json.Value.Null
    }
    let expected = webauthn.Expected {
        challenge: decoded(v.challenge)
        rp_id: "tv.example.com"
        origin: "https://tv.example.com:5443"
        require_user_verification: v.require_uv
    }
    if v.kind == "register" {
        register(v.name, credential, expected)
    } else {
        login(v.name, credential, expected, decoded(v.public_key), v.sign_count)
    }
}

fn options() {
    let preferred = webauthn.Selection { resident_key: webauthn.ResidentKey.Preferred, user_verification: Required }
    print(json.stringify(webauthn.registration_options(webauthn.RegistrationOptions {
        rp_id: "tv.example.com"
        rp_name: "Clearplay"
        user_name: "simon"
        user_id: bytes("simon")
        user_display_name: "Simon"
        challenge: digest("register-es256", 32)
        exclude_credentials: [digest("credential-es256", 20), digest("credential-ed25519", 20)]
        selection: preferred
    }), 0))
    print(json.stringify(webauthn.registration_options(webauthn.RegistrationOptions {
        rp_id: "tv.example.com"
        rp_name: "Clearplay"
        user_name: "annabelle"
        user_id: bytes("annabelle")
        challenge: digest("x", 16)
        timeout: 30000
        selection: webauthn.Selection { resident_key: webauthn.ResidentKey.Required }
    }), 0))
    print(json.stringify(webauthn.registration_options(webauthn.RegistrationOptions {
        rp_id: "tv.example.com"
        rp_name: "Clearplay"
        user_name: "annabelle"
        user_id: bytes("annabelle")
        challenge: digest("x", 16)
        algorithms: [-7]
    }), 0))
    print(json.stringify(webauthn.authentication_options(webauthn.AuthenticationOptions {
        rp_id: "tv.example.com"
        challenge: digest("login-es256", 32)
        allow_credentials: [digest("credential-es256", 20)]
        user_verification: Required
    }), 0))
    print(json.stringify(webauthn.authentication_options(webauthn.AuthenticationOptions {
        rp_id: "tv.example.com"
        challenge: digest("x", 16)
    }), 0))
    let random = webauthn.AuthenticationOptions { rp_id: "tv.example.com" }
    print("default challenge bytes {random.challenge.len}")
}

fn url_encoding() {
    for s in ["", "f", "fo", "foo", "foob", "+/"] {
        let encoded = base64.encode_url(bytes(s))
        let back = str(decoded(encoded))
        print("'{s}' -> '{encoded}' -> '{back}'")
    }
    for s in ["Zg==", "Zm8=", "_-8", "Zg=", "Z", "Zh", "Zm9v!", "Zg==="] {
        let b = base64.decode_url(s) catch {
            _ => {
                print("decode '{s}' rejected")
                continue
            }
        }
        print("decode '{s}' = {text.encode_hex(b)}")
    }
}

fn tampered_json() {
    let expected = webauthn.Expected { challenge: digest("x", 16), rp_id: "tv.example.com", origin: "https://tv.example.com:5443" }
    let cases = [
        "[]",
        "{{\"id\":\"AA\",\"rawId\":\"AA\",\"type\":\"public-key\"}}",
        "{{\"id\":\"AA\",\"rawId\":\"A*\",\"type\":\"public-key\",\"response\":{{}}}}",
        "{{\"id\":\"AA\",\"rawId\":\"AA\",\"type\":\"public-key\",\"response\":{{\"clientDataJSON\":\"e30\",\"attestationObject\":\"oA\"}}}}",
        "{{\"id\":\"AA\",\"rawId\":\"AA\",\"type\":\"other\",\"response\":{{\"clientDataJSON\":\"e30\",\"attestationObject\":\"oA\"}}}}",
        "{{\"id\":\"AB\",\"rawId\":\"AA\",\"type\":\"public-key\",\"response\":{{\"clientDataJSON\":\"e30\",\"attestationObject\":\"oA\"}}}}",
        "{{\"id\":\"AA\",\"rawId\":\"AA\",\"type\":\"public-key\",\"response\":{{\"clientDataJSON\":\"e30\"}}}}",
    ]
    for c in cases {
        let v = json.parse(bytes(c)) catch {
            _ => json.Value.Null
        }
        register("json {c}", v, expected)
    }
    cose("garbage", bytes("x"))
    cose("es256 short x", cbor.encode(cbor.Value.Map([entry(1, cbor.integer(2)), entry(3, cbor.integer(-7)), entry(-1, cbor.integer(1)), entry(-2, cbor.Value.Bytes([1])), entry(-3, cbor.Value.Bytes([1]))])))
    cose("es384", cbor.encode(cbor.Value.Map([entry(1, cbor.integer(2)), entry(3, cbor.integer(-35))])))
    cose("ed25519 wrong curve", cbor.encode(cbor.Value.Map([entry(1, cbor.integer(1)), entry(3, cbor.integer(-8)), entry(-1, cbor.integer(7)), entry(-2, cbor.Value.Bytes(digest("k", 32)))])))
    cose("ed25519", cbor.encode(cbor.Value.Map([entry(1, cbor.integer(1)), entry(3, cbor.integer(-8)), entry(-1, cbor.integer(6)), entry(-2, cbor.Value.Bytes(digest("k", 32)))])))
}

fn entry(label: i64, value: cbor.Value) -> cbor.Entry {
    cbor.Entry { key: cbor.integer(label), value }
}

fn cose(name: str, data: []u8) {
    let key = webauthn.parse_public_key(data) catch {
        e => {
            print("cose {name}: {error_text(e)}")
            return
        }
    }
    let kind = match key {
        Es256(_) => "ES256"
        EdDsa(_) => "EdDSA"
        Rs256(_) => "RS256"
    }
    print("cose {name}: {kind}")
}

fn main() {
    options()
    url_encoding()
    tampered_json()
    for v in vectors() {
        run(v)
    }
}

