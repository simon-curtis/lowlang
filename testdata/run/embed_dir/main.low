fn main() {
    let tree = embed_dir("tree")
    print(tree.len)
    for name, text in tree {
        print("{name}: {text.len}")
    }
    print(tree["a/one.txt"] ?? "missing")
    print(tree["a/deep/three.txt"] ?? "missing")
    print(tree["a"] ?? "missing")
    print((tree["b.txt"] ?? "") == embed("tree/b.txt"))
}
