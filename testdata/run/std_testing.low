import std/file
import std/os
import std/rand
import std/testing
import std/text

struct Point {
    x: i64
    y: i64
}

enum Shape {
    Circle(r: f64)
    Rect(w: i64, h: i64)
    Dot
}

fn parse(s: str) -> i64 ! text.ParseError {
    text.parse_int(s)?
}

fn test_equal(t: *testing.T) {
    t.equal(1 + 2, 3)
    t.equal("go" + "lang", "golang")
    t.equal(0.5 + 0.25, 0.75)
    t.equal(true, 1 < 2)
    t.equal(Point { x: 1, y: 2 }, Point { x: 1, y: 2 })
    t.equal(Shape.Rect(2, 3), Shape.Rect(2, 3))
    t.not_equal(Shape.Dot, Shape.Circle(1.0))
    t.not_equal(1, 2)
}

fn test_truth(t: *testing.T) {
    t.is_true(3 > 2)
    t.is_false(3 < 2)
    let some_value: i64? = 4
    let no_value: i64? = none
    t.is_some(some_value)
    t.is_none(no_value)
}

fn test_collections(t: *testing.T) {
    t.equal_slice([1, 2, 3], [1, 2, 3])
    t.equal_slice(["a", "b"], ["a", "b"])
    t.contains_item([1.5, 2.5], 2.5)
    t.contains("hello world", "o w")
    t.equal(testing.format([1, 2, 3]), "[1, 2, 3]")
    t.equal(testing.format(["a\"b", "c"]), "[\"a\\\"b\", \"c\"]")
    t.equal(testing.format(Point { x: 1, y: -2 }), "Point{{x: 1, y: -2}}")
    t.equal(testing.format(Shape.Circle(1.5)), "Circle{{r: 1.5}}")
    t.equal(testing.format("top"), "\"top\"")
    t.equal(testing.format([1: "x"]), "{{1: \"x\"}}")
    t.equal(testing.format(Shape.Dot), "Dot")
    let none_value: i64? = none
    t.equal(testing.format(none_value), "none")
}

fn test_floats(t: *testing.T) {
    t.close_to(0.1 + 0.2, 0.3, 0.000001)
    t.close_to(100.0, 100.5, 1.0)
    t.equal(testing.format(1.0 / 3.0), "0.3333333333333333")
}

fn test_errors(t: *testing.T) {
    let n = parse("42") catch { e => t.unexpected(e, -1) }
    t.equal(n, 42)
    let bad = parse("") catch { e => t.expect_error(e, text.ParseError.Empty, -1) }
    t.equal(bad, -1)
}

fn test_subtests(t: *testing.T) {
    let ok = t.sub("first", fn(st) {
        st.equal(st.name, "subtests/first")
        st.log("runs inside the parent")
    })
    t.is_true(ok)
    t.sub("second", fn(st) {
        t.log("closures can reach the parent")
        st.is_true(true)
    })
}

struct Case {
    input: str
    want: i64
}

fn test_table(t: *testing.T) {
    let cases = ["small": Case { input: "7", want: 7 }, "negative": Case { input: "-3", want: -3 }]
    t.table(cases, fn(st, c) {
        let got = parse(c.input) catch { e => st.unexpected(e, 0) }
        st.equal(got, c.want)
    })
    let listed = [Case { input: "10", want: 10 }, Case { input: "20", want: 20 }]
    t.table_of(listed, fn(c) { "parse_{c.input}" }, fn(st, c) {
        let got = parse(c.input) catch { e => st.unexpected(e, 0) }
        st.equal(got, c.want)
    })
}

fn test_skip(t: *testing.T) {
    t.skip("not applicable on this machine")
    t.error("unreachable")
}

fn test_halting(t: *testing.T) {
    t.sub("stops", fn(st) {
        st.log("before the stop")
        st.skip("stopped here")
        st.error("never recorded")
    })
}

fn test_filter(t: *testing.T) {
    t.is_true(testing.selected("", "anything"))
    t.is_true(testing.selected("add", "test_add"))
    t.is_false(testing.selected("add", "test_sub"))
    t.is_true(testing.selected("add/neg", "test_add/negative"))
    t.is_false(testing.selected("add/neg", "test_add/positive"))
    t.is_true(testing.selected("add/neg", "test_add"))
}

fn test_settings(t: *testing.T) {
    let parsed = testing.settings_from(["-run", "add", "-v", "-notime", "-timeout", "250"]) catch { e => testing.Settings {} }
    t.equal(parsed.filter, "add")
    t.is_true(parsed.verbose)
    t.is_false(parsed.timing)
    t.equal(parsed.timeout_ms, 250)
    let defaults = testing.settings_from([]) catch { e => testing.Settings { filter: "broken" } }
    t.equal(defaults.filter, "")
    t.is_false(defaults.verbose)
    t.is_true(defaults.timing)
    t.equal(defaults.timeout_ms, 30000)
    let rejected = testing.settings_from(["-missing"]) catch { e => testing.Settings { filter: "rejected" } }
    t.equal(rejected.filter, "rejected")
}

fn test_golden(t: *testing.T) {
    let dir = file.temp_dir("lowtesting") catch { e => t.must(e, "") }
    t.golden_in(dir, "report", "line one\nline two\n", true)
    t.equal(file.read_text("{dir}/report.golden") catch "", "line one\nline two\n")
    t.is_true(t.golden_in(dir, "report", "line one\nline two\n", false))
    t.golden_in(dir, "nested/deeper", "x", true)
    t.is_true(t.golden_in(dir, "nested/deeper", "x", false))
    file.remove_all(dir) catch { e => t.error("cleanup failed: {testing.format(e)}") }
}

fn test_properties(t: *testing.T) {
    t.check_ints(200, 7, -1000, 1000, fn(n) { n + 0 == n })
    t.check_ints(200, 7, 1, 50, fn(n) { n * 2 > n })
    t.check_property(100, 3, fn(mut r: rand.Rng) -> []i64 {
        var xs: []i64 = []
        for _ in 0..rand.below(mut r, 8) {
            push(mut xs, rand.between(mut r, 0, 9))
        }
        xs
    }, fn(xs) { xs.len < 8 })
    t.equal_slice(testing.shrink_int(0), [])
    t.equal_slice(testing.shrink_int(9), [0, 4, 8])
    t.equal_slice(testing.shrink_int(-9), [0, 9, -4, -8])
}

fn test_bench(t: *testing.T) {
    let result = testing.bench_for("sum", fn(n) {
        var total = 0
        for i in 0..n {
            total += i
        }
        testing.blackhole(total)
    }, 20)
    t.is_true(result.iterations >= 1)
    t.is_true(result.nanos > 0)
    t.is_true(result.ns_per_op > 0.0)
    t.equal(result.name, "sum")
    testing.blackhole(1.5)
    testing.blackhole_str("kept")
}

fn main() {
    let tests = [
        testing.Test { name: "equal", run: test_equal }
        testing.Test { name: "truth", run: test_truth }
        testing.Test { name: "collections", run: test_collections }
        testing.Test { name: "floats", run: test_floats }
        testing.Test { name: "errors", run: test_errors }
        testing.Test { name: "subtests", run: test_subtests }
        testing.Test { name: "table", run: test_table }
        testing.Test { name: "skip", run: test_skip }
        testing.Test { name: "halting", run: test_halting }
        testing.Test { name: "filter", run: test_filter }
        testing.Test { name: "settings", run: test_settings }
        testing.Test { name: "golden", run: test_golden }
        testing.Test { name: "properties", run: test_properties }
        testing.Test { name: "bench", run: test_bench }
    ]
    let failed = testing.run_with(tests, testing.Settings { verbose: true, timing: false })
    if failed > 0 {
        os.exit(1)
    }
}
