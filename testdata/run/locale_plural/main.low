import std/locale
import std/locale/plural
import std/text

struct Tally {
    checked: i64
    failed: i64
}

fn check_lines(table: str, ordinal: bool) -> Tally {
    var tally = Tally { checked: 0, failed: 0 }
    var current = ""
    var l = locale.root()
    for line in text.lines(table) {
        let f = text.fields(line)
        if f.len != 3 {
            continue
        }
        if f[0] != current {
            current = f[0]
            l = locale.parse(current) or locale.root()
        }
        let o = plural.operands_of_text(f[2]) or plural.operands_of_int(0)
        let got = if ordinal { plural.ordinal(l, o) } else { plural.cardinal(l, o) }
        tally.checked += 1
        if plural.name(got) != f[1] {
            tally.failed += 1
            if tally.failed <= 10 {
                print("{current} {f[2]}: want {f[1]}, got {plural.name(got)}")
            }
        }
    }
    tally
}

fn main() {
    let cardinal = check_lines(embed("cardinal.txt"), false)
    print("cardinal: {cardinal.checked} samples, {cardinal.failed} wrong")
    let ordinal = check_lines(embed("ordinal.txt"), true)
    print("ordinal: {ordinal.checked} samples, {ordinal.failed} wrong")
}
