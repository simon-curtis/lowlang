import std/cancel
import std/io
import std/net
import std/net/sntp
import std/text
import std/time
import std/time/duration

const second = 1000000000
const base = 1700000000 * second
const server_flags = 0x24

struct Observed {
    requests: sntp.Stamp[]
    lengths: i64[]
    firsts: i64[]
    failure: str
}

struct Clock {
    first: i64
    second: i64
    calls: i64
}

fn describe(e: sntp.Error) -> str {
    match e {
        Short => "Short"
        Mode(value) => "Mode({value})"
        Version(value) => "Version({value})"
        Originate => "Originate"
        KissOfDeath(code) => "KissOfDeath({code})"
        Unsynchronized => "Unsynchronized"
        Stratum(value) => "Stratum({value})"
        NoTransmit => "NoTransmit"
        Io(cause) => "Io({cause})"
    }
}

fn hex(b: u8[]) -> str {
    let digits = "0123456789abcdef"
    var out: u8[] = []
    for c in b {
        out.push(digits[i64(c) >> 4])
        out.push(digits[i64(c) & 15])
    }
    str(out)
}

fn at(nanos: i64) -> sntp.Stamp {
    sntp.to_stamp(nanos)
}

fn packet(flags: i64, stratum: i64, originate: sntp.Stamp, t2: sntp.Stamp, t3: sntp.Stamp) -> u8[] {
    var b = io.buffer(48)
    b[0] = u8(flags)
    b[1] = u8(stratum)
    io.set_be32(b, 24, originate.seconds)
    io.set_be32(b, 28, originate.fraction)
    io.set_be32(b, 32, t2.seconds)
    io.set_be32(b, 36, t2.fraction)
    io.set_be32(b, 40, t3.seconds)
    io.set_be32(b, 44, t3.fraction)
    b
}

fn good(sent: sntp.Stamp) -> u8[] {
    packet(server_flags, 2, sent, at(base + 1), at(base + 2))
}

fn show(name: str, r: sntp.Reply) {
    print("{name}: stratum {r.stratum} offset {r.offset} delay {r.delay}")
}

fn parsed(name: str, p: u8[], sent: sntp.Stamp, received: i64) {
    let r = sntp.parse(p, sent, received) catch {
        e => {
            print("{name}: {describe(e)}")
            return
        }
    }
    show(name, r)
}

fn queried(name: str, host: str, o: sntp.Options) {
    let r = sntp.query(host, o) catch {
        e => {
            print("{name}: {describe(e)}")
            return
        }
    }
    show(name, r)
}

fn stamps() {
    let samples = [0, 2085978496, 2085978495, 2208988800, 1700000000, -61505152, 4233462143, 946684800, 2147483648]
    for u in samples {
        let s = at(u * second)
        print("unix {u}: seconds {s.seconds} fraction {s.fraction} back {sntp.to_unix_nanos(s) == u * second}")
    }
    for n in [500000000, 250000000, 1, 999999999, -1] {
        let s = at(base + n)
        print("1700000000s + {n}ns: seconds {s.seconds} fraction {s.fraction} back {sntp.to_unix_nanos(s) - base}")
    }
    var exact = 0
    for i in 0..2000 {
        if sntp.to_unix_nanos(at(base + i)) == base + i {
            exact += 1
        }
    }
    print("round trips {exact} of 2000")
    let wrapped = at(4233462144 * second)
    print("past 2104-02-26T09:42:23Z: seconds {wrapped.seconds} reads as {sntp.to_unix_nanos(wrapped) / second}")
    let top = sntp.Stamp { seconds: 4294967295, fraction: 4294967295 }
    print("largest stamp: {sntp.to_unix_nanos(top)}")
}

fn requests() {
    let req = sntp.request(sntp.Stamp { seconds: 0x83AA7E80, fraction: 0x80000000 })
    print("request length {req.len}")
    print("request {hex(req)}")
    print("request layout {hex(req) == "23{text.repeat("00", 39)}83aa7e8080000000"}")
}

fn offsets() {
    let t = base
    let sent = at(t)
    parsed("ahead by 2.25 s", packet(server_flags, 2, sent, at(t + 2750000000), at(t + 3000000000)), sent, t + 1250000000)
    parsed("behind by 1.5 s", packet(server_flags, 2, sent, at(t - 1000000000), at(t - 750000000)), sent, t + 1250000000)
    parsed("odd nanoseconds, positive", packet(server_flags, 2, sent, at(t + 2), at(t + 3)), sent, t + 2)
    parsed("odd nanoseconds, negative", packet(server_flags, 2, sent, at(t - 2), at(t - 1)), sent, t)

    let era = (2085978496 + 10) * second
    let era_sent = at(era)
    print("era 1 seconds on the wire {era_sent.seconds}")
    parsed("era 1, ahead by 1 s", packet(server_flags, 2, era_sent, at(era + 1250000000), at(era + 1250000000)), era_sent, era + 500000000)

    let edge = 2085978495500000000
    let edge_sent = at(edge)
    print("edge sent {edge_sent.seconds} {edge_sent.fraction}")
    let t2 = at(2085978496250000000)
    let t3 = at(2085978496500000000)
    print("edge server {t2.seconds} {t2.fraction} {t3.seconds} {t3.fraction}")
    parsed("across the era boundary", packet(server_flags, 2, edge_sent, t2, t3), edge_sent, 2085978496000000000)
}

fn fields() {
    let sent = at(base)
    var b = packet(0x64, 3, sent, at(base), at(base + 5 * second))
    b[2] = 0xFA
    b[3] = 0xEC
    io.set_be32(b, 4, 0x00018000)
    io.set_be32(b, 8, 0x00000100)
    b[12] = 'G'
    b[13] = 'P'
    b[14] = 'S'
    let r = sntp.parse(b, sent, base + 5 * second) or {
        print("fields: failed")
        return
    }
    print("leap {r.leap} version {r.version} stratum {r.stratum} poll {r.poll} precision {r.precision}")
    print("root delay {r.root_delay} root dispersion {r.root_dispersion} reference {hex(r.reference_id)} time {r.time - base}")
    io.set_be32(b, 4, 0xFFFF0000)
    let negative = sntp.parse(b, sent, base + 5 * second) or {
        print("negative root delay: failed")
        return
    }
    print("negative root delay {negative.root_delay}")
    for v in 1..5 {
        let p = packet(v << 3 | 4, 2, sent, at(base), at(base + 1))
        let got = sntp.parse(p, sent, base) or {
            print("version {v}: failed")
            continue
        }
        print("version {v}: accepted as {got.version}")
    }
    var long = good(sent)
    for i in 0..68 {
        long.push(u8(i))
    }
    parsed("extension fields after 48 bytes", long, sent, base)
    for s in [1, 15] {
        parsed("stratum {s}", packet(server_flags, s, sent, at(base), at(base + 1)), sent, base)
    }
}

fn rejections() {
    let sent = at(base)
    let ok = good(sent)
    parsed("47 bytes", ok[..47], sent, base)
    parsed("empty", [], sent, base)

    var mode3 = good(sent)
    mode3[0] = 0x23
    parsed("mode 3", mode3, sent, base)
    var mode5 = good(sent)
    mode5[0] = 0x25
    parsed("mode 5", mode5, sent, base)
    var mode0 = good(sent)
    mode0[0] = 0x20
    parsed("mode 0", mode0, sent, base)

    var version0 = good(sent)
    version0[0] = 0x04
    parsed("version 0", version0, sent, base)
    var version5 = good(sent)
    version5[0] = 0x2C
    parsed("version 5", version5, sent, base)
    var version7 = good(sent)
    version7[0] = 0x3C
    parsed("version 7", version7, sent, base)

    let off_fraction = sntp.Stamp { seconds: sent.seconds, fraction: sent.fraction ^ 1 }
    let off_seconds = sntp.Stamp { seconds: sent.seconds + 1, fraction: sent.fraction }
    parsed("originate fraction differs", packet(server_flags, 2, off_fraction, at(base), at(base + 1)), sent, base)
    parsed("originate seconds differ", packet(server_flags, 2, off_seconds, at(base), at(base + 1)), sent, base)
    parsed("originate zero", packet(server_flags, 2, sntp.Stamp { seconds: 0, fraction: 0 }, at(base), at(base + 1)), sent, base)

    var rate = packet(0xE4, 0, sent, at(base), at(base + 1))
    rate[12] = 'R'
    rate[13] = 'A'
    rate[14] = 'T'
    rate[15] = 'E'
    parsed("kiss of death RATE with LI 3", rate, sent, base)
    var deny = packet(server_flags, 0, sent, at(base), at(base + 1))
    deny[12] = 'D'
    deny[13] = 'E'
    deny[14] = 'N'
    deny[15] = 'Y'
    parsed("kiss of death DENY with LI 0", deny, sent, base)
    var short_code = packet(server_flags, 0, sent, at(base), at(base + 1))
    short_code[12] = 'X'
    parsed("kiss code ended by NUL", short_code, sent, base)
    parsed("kiss code empty", packet(server_flags, 0, sent, at(base), at(base + 1)), sent, base)
    var binary_code = packet(server_flags, 0, sent, at(base), at(base + 1))
    binary_code[12] = 'A'
    binary_code[13] = 1
    binary_code[14] = 0xFF
    binary_code[15] = 'B'
    parsed("kiss code with unprintable bytes", binary_code, sent, base)
    var forged = packet(0xE4, 0, off_fraction, at(base), at(base + 1))
    forged[12] = 'R'
    parsed("kiss of death with a wrong originate", forged, sent, base)

    parsed("leap indicator 3", packet(0xE4, 2, sent, at(base), at(base + 1)), sent, base)
    parsed("stratum 16", packet(server_flags, 16, sent, at(base), at(base + 1)), sent, base)
    parsed("stratum 255", packet(server_flags, 255, sent, at(base), at(base + 1)), sent, base)
    parsed("leap indicator 3 before stratum 16", packet(0xE4, 16, sent, at(base), at(base + 1)), sent, base)
    parsed("transmit zero", packet(server_flags, 2, sent, at(base), sntp.Stamp { seconds: 0, fraction: 0 }), sent, base)
}

fn serve(server: net.SocketHandle, decoy: net.SocketHandle, kind: str, seen: *Observed) {
    let buf = io.buffer(128)
    let p = net.receive_from_on(server, buf) or return
    let originate = sntp.Stamp { seconds: io.be32(buf, 40), fraction: io.be32(buf, 44) }
    seen.requests.push(originate)
    seen.lengths.push(p.size)
    seen.firsts.push(i64(buf[0]))
    let o = sntp.to_unix_nanos(originate)
    match kind {
        "good" => {
            net.send_to_on(server, packet(server_flags, 2, originate, at(o + 2750000000), at(o + 3000000000)), p.from) or 0
        }
        "decoy" => {
            net.send_to_on(decoy, packet(server_flags, 9, originate, at(o), at(o + 1)), p.from) or 0
            net.send_to_on(decoy, bytes("noise"), p.from) or 0
            net.send_to_on(server, packet(server_flags, 2, originate, at(o + 2750000000), at(o + 3000000000)), p.from) or 0
        }
        "wrong" => {
            let other = sntp.Stamp { seconds: originate.seconds, fraction: originate.fraction ^ 1 }
            net.send_to_on(server, packet(server_flags, 2, other, at(o), at(o + 1)), p.from) or 0
        }
        "short" => {
            net.send_to_on(server, bytes("short"), p.from) or 0
        }
        "kiss" => {
            var b = packet(0xE4, 0, originate, at(o), at(o + 1))
            b[12] = 'R'
            b[13] = 'A'
            b[14] = 'T'
            b[15] = 'E'
            net.send_to_on(server, b, p.from) or 0
        }
        _ => {}
    }
}

fn clock_of(c: *Clock) -> fn() -> i64 {
    fn() -> i64 {
        c.calls += 1
        if c.calls == 1 { c.first } else { c.second }
    }
}

fn attempt(o: sntp.Options, seen: *Observed) -> sntp.Reply? {
    let r = sntp.query("127.0.0.1", o) catch {
        e => {
            seen.failure = describe(e)
            return none
        }
    }
    some(r)
}

fn run_query(kind: str, timeout_ms: i64) ! io.Error {
    using server = net.bind_udp("127.0.0.1", 0)?
    using decoy = net.bind_udp("127.0.0.1", 0)?
    let seen = new(Observed { requests: [], lengths: [], firsts: [], failure: "" })
    let ticks = new(Clock { first: base, second: base + 1250000000, calls: 0 })
    spawn serve(server.handle, decoy.handle, kind, seen)
    let options = sntp.Options { port: server.handle.addr.port, timeout_ms, clock: clock_of(ticks) }
    let got = attempt(options, seen)
    if seen.requests.len == 0 {
        print("{kind}: no request seen")
        return
    }
    let sent = seen.requests[0]
    let expected = at(base)
    print("{kind}: request length {seen.lengths[0]} first byte {seen.firsts[0]} clock reads {ticks.calls}")
    print("{kind}: seconds kept {sent.seconds == expected.seconds} upper fraction kept {sent.fraction >> 8 == expected.fraction >> 8}")
    let r = got ?? {
        print("{kind}: {seen.failure}")
        return
    }
    let t1 = sntp.to_unix_nanos(sent)
    let t4 = base + 1250000000
    let offset = ((2750000000) + (t1 + 3000000000 - t4)) / 2
    print("{kind}: stratum {r.stratum} offset exact {r.offset == offset} delay exact {r.delay == t4 - t1 - 250000000}")
    print("{kind}: offset within 100 ns of 2.25 s {r.offset - 2250000000 <= 100 && 2250000000 - r.offset <= 100}")
    print("{kind}: time {r.time == t1 + 3000000000}")
}

fn queries() ! io.Error {
    run_query("good", 2000)?
    run_query("decoy", 2000)?
    run_query("wrong", 2000)?
    run_query("short", 2000)?
    run_query("kiss", 2000)?
}

fn cancel_later(t: *cancel.Token) {
    time.sleep_for(duration.milliseconds(100))
    cancel.cancel(t)
}

fn waits() ! io.Error {
    using server = net.bind_udp("127.0.0.1", 0)?
    let port = server.handle.addr.port
    let start = time.monotonic()
    queried("no reply", "127.0.0.1", sntp.Options { port, timeout_ms: 150 })
    let waited = (time.monotonic() - start) / 1000000
    print("waited between 100 ms and 3 s: {waited >= 100 && waited < 3000}")

    let token = cancel.token()
    spawn cancel_later(token)
    queried("cancelled while waiting", "127.0.0.1", sntp.Options { port, timeout_ms: 0, token })

    let early = cancel.token()
    cancel.cancel(early)
    queried("cancelled before the query", "127.0.0.1", sntp.Options { port, token: early })
}

fn main() ! io.Error {
    stamps()
    requests()
    offsets()
    fields()
    rejections()
    queries()?
    waits()?
}
