import std/locale
import std/locale/list
import std/text

fn kind_of(name: str) -> list.Kind {
    match name {
        "disjunction" => list.Kind.Or
        "unit" => list.Kind.Unit
        _ => list.Kind.And
    }
}

fn width_of(name: str) -> list.Width {
    match name {
        "short" => list.Width.Short
        "narrow" => list.Width.Narrow
        _ => list.Width.Wide
    }
}

fn split_items(joined: str) -> str[] {
    var items: str[] = []
    if joined != "" {
        items = text.split(joined, '|')
    }
    items
}

fn main() {
    var checked = 0
    var failed = 0
    var current = ""
    var l = locale.root()
    for line in text.lines(embed("lists.tsv")) {
        let f = text.split(line, '\t')
        if f.len != 5 {
            continue
        }
        if f[0] != current {
            current = f[0]
            l = locale.parse(current) or locale.root()
        }
        let items = split_items(f[3])
        let got = list.format(l, items, kind_of(f[1]), width_of(f[2]))
        checked += 1
        if got != f[4] {
            failed += 1
            if failed <= 40 {
                print("{f[0]} {f[1]} {f[2]} [{f[3]}]: want {f[4]}, got {got}")
            }
        }
    }
    print("list: {checked} checked, {failed} wrong")
}
