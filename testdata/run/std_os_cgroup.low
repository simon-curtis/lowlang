import std/file
import std/io
import std/os

fn put(dir: str, name: str, content: str) ! io.Error {
    file.write_text("{dir}/{name}", content)?
}

fn build(root: str) ! io.Error {
    file.mkdir_all("{root}/a/b/c/d")?
    put(root, "a/cpu.max", "200000 100000\n")?
    put(root, "a/memory.max", "max\n")?
    put(root, "a/memory.high", "max\n")?
    put(root, "a/b/memory.max", "536870912\n")?
    put(root, "a/b/memory.current", "12345\n")?
    put(root, "a/b/c/cpu.max", "max 100000\n")?
    put(root, "a/b/c/memory.max", "max\n")?
    put(root, "a/b/c/memory.high", "1000\n")?
    put(root, "a/b/c/memory.current", "777\n")?
}

fn text_of(n: i64?) -> str {
    match n {
        some(v) => "{v}"
        none => "none"
    }
}

fn limits(root: str, path: str) -> str {
    let l = os.cgroup_limits_of(os.Cgroup { mount: root, path }) catch {
        Malformed => return "malformed"
        _ => return "error"
    }
    var cpu = "none"
    match l.cpu {
        some(c) => {
            cpu = "{c.quota}/{c.period}={c.cpus}"
        }
        none => {}
    }
    "cpu {cpu} max {text_of(l.memory_max)} high {text_of(l.memory_high)} current {text_of(l.memory_current)}"
}

fn show(root: str) {
    print("d {limits(root, "/a/b/c/d")}")
    print("c {limits(root, "/a/b/c")}")
    print("b {limits(root, "/a/b")}")
    print("a {limits(root, "/a")}")
    print("top {limits(root, "/")}")
    print("trailing {limits(root, "/a/b/c/")}")
    print("missing {limits(root, "/nowhere/below")}")
    print("no mount {limits("{root}/absent", "/a")}")
}

fn malformed(root: str) ! io.Error {
    file.mkdir_all("{root}/m/n")?
    put(root, "m/memory.max", "bogus\n")?
    print("bad memory {limits(root, "/m/n")}")
    put(root, "m/memory.max", "max\n")?
    put(root, "m/n/cpu.max", "0 100000\n")?
    print("bad cpu {limits(root, "/m/n")}")
    put(root, "m/n/cpu.max", "max 100000\n")?
    put(root, "m/n/memory.current", "x\n")?
    print("bad current {limits(root, "/m/n")}")
}

fn main() ! io.Error {
    let root = file.temp_dir("low-std-os-cgroup-")?
    build(root)?
    show(root)
    malformed(root)?
    file.remove_all(root)?
}
