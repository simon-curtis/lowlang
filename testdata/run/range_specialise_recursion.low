fn depth(n: i64, limit: i64) -> i64 {
    if n >= limit {
        return 0
    }
    1 + depth(n + 1, limit)
}

fn climb(n: i64, step: i64, limit: i64) -> i64 {
    if n >= limit {
        return n
    }
    climb(n + step, step + 1, limit)
}

fn marks(limit: i64) -> i64 {
    var composite: []u8 = []
    for i in 0..limit {
        push(mut composite, u8(0))
    }
    var count = 0
    for i in 2..limit {
        if composite[i] == 0 {
            count += 1
            var j = i * i
            for j < limit {
                composite[j] = 1
                j += i
            }
        }
    }
    if limit > 50 {
        return count + marks(limit - 50)
    }
    count
}

fn main() {
    print(depth(0, 10))
    print(climb(0, 1, 100))
    print(marks(100))
}
