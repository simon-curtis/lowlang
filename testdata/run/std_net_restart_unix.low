import std/file
import std/io
import std/net
import std/net/restart
import std/os
import std/text

fn answer(h: net.ConnHandle) {
    using c = net.adopt(h)
    let line = io.read_line(io.reader(net.stream(c))) or return
    if line == "crash" {
        os.exit(3)
    }
    if line == "stop" {
        os.exit(0)
    }
    net.write_all(c, bytes("{os.pid()}\n")) or return
}

fn accept_loop(kept: restart.Kept) ! io.Error {
    for {
        spawn answer(net.accept_handle(kept.listeners[0])?)
    }
}

fn ask(path: str, line: str) -> str {
    using c = net.connect_unix(path) or return "no connection"
    net.write_all(c, bytes("{line}\n")) or return "no connection"
    text.trim(str(io.read_all(net.stream(c)) or []))
}

fn talk(path: str, done: chan[bool]) {
    let first = ask(path, "who")
    print("answered on the Unix socket: {first.len > 0}")
    print("the crash closed the connection: {ask(path, "crash").len == 0}")
    let second = ask(path, "who")
    print("answered on the same path by a new process: {second.len > 0 && second != first}")
    print("the server left the socket file in place: {file.exists(path)}")
    let _ = ask(path, "stop")
    done <- true
}

/// Serves on a Unix socket from a server that is started again after it exits with status 3. The path carries the process id of the watching process, which the server reads as its parent's.
fn main() ! io.Error {
    let watcher = if restart.worker() { os.ppid() } else { os.pid() }
    let path = "{os.temp_dir_path()}/std_net_restart_unix_{watcher}.sock"
    using l = restart.listen_unix(path)?
    let done = chan[bool](1)
    if !restart.worker() {
        spawn talk(path, done)
    }
    restart.serve(restart.Kept { listeners: [l.handle] }, accept_loop)?
    <-done
    net.close_listener(l)
    print("the watching process removed the socket file: {!file.exists(path)}")
}
