import std/crypto/x509
import std/file
import std/io
import std/log
import std/log/syslog
import std/net
import std/text
import std/tls

fn invalid(prefix: str) -> str {
    "{prefix}{str(raw_byte(0xFF))}utf8"
}

fn replacement(prefix: str) -> str {
    "{prefix}{text.from_char(0xFFFD)}utf8"
}

fn size_prefix(r: *io.Reader) -> str ! io.Error {
    var digits: u8[] = []
    for {
        let c = io.read_byte(r)?
        if c == ' ' {
            break
        }
        digits.push(c)
    }
    str(digits)
}

fn raw_byte(b: u8) -> u8[] {
    var out: u8[] = []
    out.push(b)
    out
}

fn raw_bytes(a: u8, b: u8, c: u8) -> u8[] {
    var out: u8[] = []
    out.push(a)
    out.push(b)
    out.push(c)
    out
}

struct Collected {
    items: str[]
}

fn bom() -> str {
    str(raw_bytes(0xEF, 0xBB, 0xBF))
}

fn expect(name: str, got: str, want: str) {
    if got == want {
        print("{name}: ok")
    } else {
        print("{name}: MISMATCH\n  got  {text.quote(got)}\n  want {text.quote(want)}")
    }
}

fn rfc_examples() {
    let first = syslog.Message {
        facility: Auth
        severity: Critical
        timestamp: some(1065910455003000000)
        hostname: "mymachine.example.com"
        app_name: "su"
        msgid: "ID47"
        text: "'su root' failed for lonvick on /dev/pts/8"
        bom: true
    }
    expect("rfc5424 6.5 example 1", str(syslog.format(first)), "<34>1 2003-10-11T22:14:15.003Z mymachine.example.com su - ID47 - {bom()}'su root' failed for lonvick on /dev/pts/8")

    let second = syslog.Message {
        facility: Local4
        severity: Notice
        timestamp: some(1061727255000003000)
        hostname: "192.0.2.1"
        app_name: "myproc"
        procid: "8710"
        text: "%% It's time to make the do-nuts."
    }
    expect("rfc5424 6.5 example 2", str(syslog.format(second)), "<165>1 2003-08-24T12:14:15.000003Z 192.0.2.1 myproc 8710 - - %% It's time to make the do-nuts.")

    let event = syslog.Element {
        id: "exampleSDID@32473"
        params: [
            syslog.Param { name: "iut", value: "3" },
            syslog.Param { name: "eventSource", value: "Application" },
            syslog.Param { name: "eventID", value: "1011" },
        ]
    }
    let third = syslog.Message {
        facility: Local4
        severity: Notice
        timestamp: some(1065910455003000000)
        hostname: "mymachine.example.com"
        app_name: "evntslog"
        msgid: "ID47"
        data: [event]
        text: "An application event log entry..."
        bom: true
    }
    expect("rfc5424 6.5 example 3", str(syslog.format(third)), "<165>1 2003-10-11T22:14:15.003Z mymachine.example.com evntslog - ID47 [exampleSDID@32473 iut=\"3\" eventSource=\"Application\" eventID=\"1011\"] {bom()}An application event log entry...")

    let priority = syslog.Element { id: "examplePriority@32473", params: [syslog.Param { name: "class", value: "high" }] }
    var fourth = third
    fourth.data = [event, priority]
    fourth.text = ""
    fourth.bom = false
    expect("rfc5424 6.5 example 4", str(syslog.format(fourth)), "<165>1 2003-10-11T22:14:15.003Z mymachine.example.com evntslog - ID47 [exampleSDID@32473 iut=\"3\" eventSource=\"Application\" eventID=\"1011\"][examplePriority@32473 class=\"high\"]")
}

fn util_linux_vectors() {
    let su = syslog.Message {
        facility: Auth
        severity: Critical
        hostname: "DellP330"
        app_name: "su"
        procid: "8710"
        msgid: "ID47"
        text: "'su root' failed for lonvick on /dev/pts/8"
    }
    expect("logger 2.42 auth.crit", str(syslog.format(su)), "<34>1 - DellP330 su 8710 ID47 - 'su root' failed for lonvick on /dev/pts/8")

    let entry = syslog.Message {
        facility: Local4
        severity: Notice
        timestamp: some(1794657600123456000)
        hostname: "DellP330"
        app_name: "evntslog"
        data: [syslog.Element {
            id: "exampleSDID@32473"
            params: [syslog.Param { name: "iut", value: "3" }, syslog.Param { name: "eventSource", value: "Application" }]
        }]
        text: "An application event log entry..."
    }
    expect("logger 2.42 local4.notice", str(syslog.format(entry)), "<165>1 2026-11-14T12:00:00.123456Z DellP330 evntslog - - [exampleSDID@32473 iut=\"3\" eventSource=\"Application\"] An application event log entry...")

    let captured = "<14>1 2026-11-14T20:27:45.432260+00:00 DellP330 oc 1372856 - [timeQuality tzKnown=\"1\" isSynced=\"1\" syncAccuracy=\"651000\"] octet counted"
    expect("logger 2.42 octet count", str(syslog.octet_counted(bytes(captured))), "135 {captured}")
}

fn sanitising() {
    let tricky = syslog.Message {
        severity: Debug
        timestamp: some(0)
        hostname: "bad host"
        app_name: text.repeat("a", 60)
        procid: "p\tid"
        msgid: "{text.repeat("m", 31)}éz"
        data: [syslog.Element {
            id: "bad id]"
            params: [
                syslog.Param { name: "a=b", value: "q\"b\\s]e" },
                syslog.Param { name: "", value: "empty" },
                syslog.Param { name: text.repeat("n", 40), value: invalid("bad") },
            ]
        }]
    }
    expect("sanitised fields", str(syslog.format(tricky)), "<15>1 1970-01-01T00:00:00Z bad_host {text.repeat("a", 48)} p_id {text.repeat("m", 31)}_ [bad_id_ a_b=\"q\\\"b\\\\s\\]e\" _=\"empty\" {text.repeat("n", 32)}=\"{replacement("bad")}\"]")

    let plain = syslog.Message { timestamp: some(-1000), text: "x" }
    expect("before the epoch", str(syslog.format(plain)), "<14>1 1969-12-31T23:59:59.999999Z - - - - - x")
    expect("empty message", str(syslog.format(syslog.Message {})), "<14>1 - - - - - -")
    let codes = [syslog.Facility.Kernel.index, syslog.Facility.Local7.index, syslog.Severity.Emergency.index, syslog.Severity.Debug.index]
    expect("codes", "{codes}", "[0, 23, 0, 7]")
}

fn record(level: log.Level, message: str, prefix: str, attrs: log.Attr[], at: i64?) -> log.Record {
    log.Record { level, message, prefix, attrs, time: at }
}

fn mapping() {
    let config = syslog.Config { facility: Daemon, hostname: "h", app_name: "app", procid: "7", msgid: "M", sd_id: "x@32473" }
    var out = ""
    for level in [log.Level.Debug, log.Level.Info, log.Level.Warn, log.Level.Error] {
        out = "{out}{syslog.format(syslog.message(config, record(level, "m", "", [], none))).len} "
        let line = str(syslog.format(syslog.message(config, record(level, "m", "", [], none))))
        out = "{out}{text.cut(line, " ").before} "
    }
    expect("levels", out, "21 <31>1 21 <30>1 21 <28>1 21 <27>1 ")

    let attrs = [log.str_attr("user", "ann"), log.int_attr("n", -3), log.float_attr("ratio", 1.5), log.bool_attr("ok", true)]
    let full = syslog.message(config, record(Warn, "héllo", "db", attrs, some(1065910455003000000)))
    expect("record", str(syslog.format(full)), "<28>1 2003-10-11T22:14:15.003Z h app 7 M [x@32473 user=\"ann\" n=\"-3\" ratio=\"1.5\" ok=\"true\"] {bom()}db: héllo")
    expect("ascii record has no byte order mark", str(syslog.format(syslog.message(config, record(Info, "plain", "", [], none)))), "<30>1 - h app 7 M - plain")
    let invalid = syslog.message(config, record(Info, invalid("bad"), "", [], none))
    expect("invalid utf-8 has no byte order mark", "{invalid.bom}", "false")
}

fn receive_text(s: net.Socket) -> str {
    let buf = io.buffer(2048)
    let p = net.receive_from(s, buf) or return "receive failed"
    str(buf[..p.size])
}

fn fixed_clock() -> fn() -> i64 {
    fn() -> i64 { 1065910455003000000 }
}

fn base_logger(errors: *Collected) -> log.Logger {
    let l = log.Logger { level: Debug, prefix: "svc", timestamps: true }
    log.with_error_handler(log.with_clock(l, fixed_clock()), fn(e: io.Error) { errors.items.push("{e}") })
}

fn unix_datagram(dir: str) ! io.Error {
    let path = "{dir}/dev-log.sock"
    using server = net.bind_unix_datagram(path)?
    net.set_receive_timeout(server, 2000)
    let errors = new(Collected { items: [] })
    let config = syslog.Config {
        transport: syslog.Transport.UnixDatagram(path)
        facility: Local3
        hostname: "web1"
        app_name: "api"
        procid: "42"
        msgid: "REQ"
    }
    using s = syslog.open(config)
    let l = syslog.attach(base_logger(errors), s)
    log.info_with(l, "started", [log.str_attr("addr", "[::1]:80"), log.int_attr("workers", 4)])
    expect("unix datagram", receive_text(server), "<158>1 2003-10-11T22:14:15.003Z web1 api 42 REQ [fields@32473 addr=\"[::1\\]:80\" workers=\"4\"] svc: started")
    log.error(l, "failed")
    expect("unix datagram error", receive_text(server), "<155>1 2003-10-11T22:14:15.003Z web1 api 42 REQ - svc: failed")
    log.debug(log.with_level(l, Warn), "dropped below the level")
    print("errors {errors.items.len}")
}

fn missing_then_present(dir: str) ! io.Error {
    let path = "{dir}/late.sock"
    let errors = new(Collected { items: [] })
    using s = syslog.open(syslog.Config { transport: syslog.Transport.UnixDatagram(path), hostname: "h", procid: "1" })
    let l = syslog.attach(base_logger(errors), s)
    log.info(l, "lost")
    print("errors while the socket is missing {errors.items}")
    using server = net.bind_unix_datagram(path)?
    net.set_receive_timeout(server, 2000)
    log.info(l, "found")
    expect("delivery once the socket exists", receive_text(server), "<14>1 2003-10-11T22:14:15.003Z h - 1 - - svc: found")
    print("errors after {errors.items.len}")
    syslog.close(s)
    log.info(l, "after close")
    print("errors after close {errors.items}")
}

fn udp() ! io.Error {
    using server = net.bind_udp("127.0.0.1", 0)?
    net.set_receive_timeout(server, 2000)
    let errors = new(Collected { items: [] })
    using s = syslog.open(syslog.Config { transport: syslog.Transport.Udp("127.0.0.1", server.handle.addr.port), hostname: "h", app_name: "udp", procid: "9" })
    let l = syslog.attach(base_logger(errors), s)
    log.warn(l, "over udp")
    expect("udp", receive_text(server), "<12>1 2003-10-11T22:14:15.003Z h udp 9 - - svc: over udp")
}

fn read_frames(c: net.Conn, count: i64) -> str {
    let r = io.reader(net.stream(c))
    var out = ""
    for _ in 0..count {
        let size = size_prefix(r) or return "{out}|size failed"
        let n = text.parse_uint(size, 10) or return "{out}|bad size"
        let body = io.read_exact(r, n) or return "{out}|short body"
        out = "{out}[{size}]{str(body)}"
    }
    out
}

fn tcp() ! io.Error {
    using l = net.listen("127.0.0.1", 0)?
    let errors = new(Collected { items: [] })
    using s = syslog.open(syslog.Config { transport: syslog.Transport.Tcp("127.0.0.1", l.handle.addr.port), hostname: "h", app_name: "tcp", procid: "9" })
    let logger = syslog.attach(base_logger(errors), s)
    log.info(logger, "one")
    log.info(logger, "two")
    using c = net.accept(l)?
    net.set_read_timeout(c, 2000)
    expect("tcp octet counting", read_frames(c, 2), "[51]<14>1 2003-10-11T22:14:15.003Z h tcp 9 - - svc: one[51]<14>1 2003-10-11T22:14:15.003Z h tcp 9 - - svc: two")

    net.close(c)
    var tries = 0
    for errors.items.len == 0 && tries < 200 {
        log.info(logger, "into the void")
        sleep(10)
        tries += 1
    }
    print("failed send reported {errors.items.len > 0}")
    log.info(logger, "again")
    using second = net.accept(l)?
    net.set_read_timeout(second, 2000)
    expect("tcp reconnect", read_frames(second, 1), "[53]<14>1 2003-10-11T22:14:15.003Z h tcp 9 - - svc: again")
}

fn unix_stream(dir: str) ! io.Error {
    let path = "{dir}/stream.sock"
    using l = net.listen_unix(path)?
    let errors = new(Collected { items: [] })
    using s = syslog.open(syslog.Config { transport: syslog.Transport.UnixStream(path), hostname: "h", app_name: "ux", procid: "3" })
    let logger = syslog.attach(base_logger(errors), s)
    log.error(logger, "stream")
    using c = net.accept(l)?
    net.set_read_timeout(c, 2000)
    expect("unix stream", read_frames(c, 1), "[53]<11>1 2003-10-11T22:14:15.003Z h ux 3 - - svc: stream")
}

fn roots() -> x509.Certificate[] {
    var out: x509.Certificate[] = []
    for der in x509.pem_certificates(embed("std_tls_ca.pem")) {
        out.push(x509.parse(der) or return out)
    }
    out
}

fn serve_tls(l: net.ListenerHandle, config: tls.Config, done: chan[str]) {
    let h = net.accept_handle(l) or {
        done <- "accept failed"
        return
    }
    using c = net.adopt(h)
    using t = tls.server(net.stream(c), config) or {
        done <- "handshake failed"
        return
    }
    let r = io.reader(tls.stream(t))
    let size = size_prefix(r) or {
        done <- "size failed"
        return
    }
    let body = io.read_exact(r, text.parse_uint(size, 10) or 0) or {
        done <- "body failed"
        return
    }
    done <- "[{size}]{str(body)}"
}

fn tls_transport() ! io.Error {
    let pem = embed("std_tls_ec.pem")
    let server = tls.Config { certificates: x509.pem_certificates(pem), key: x509.pem_private_key(pem)? }
    using l = net.listen("127.0.0.1", 0)?
    let done = chan[str](1)
    spawn serve_tls(l.handle, server, done)
    let errors = new(Collected { items: [] })
    let transport = syslog.Transport.Tls("localhost", l.handle.addr.port, tls.Config { roots: roots() })
    using s = syslog.open(syslog.Config { transport, hostname: "h", app_name: "tls", procid: "5" })
    let logger = syslog.attach(base_logger(errors), s)
    log.info(logger, "secure")
    expect("tls octet counting", (<-done) ?? "", "[54]<14>1 2003-10-11T22:14:15.003Z h tls 5 - - svc: secure")
    print("errors {errors.items.len}")
}

fn tls_untrusted() ! io.Error {
    let pem = embed("std_tls_ec.pem")
    let server = tls.Config { certificates: x509.pem_certificates(pem), key: x509.pem_private_key(pem)? }
    using l = net.listen("127.0.0.1", 0)?
    let done = chan[str](1)
    spawn serve_tls(l.handle, server, done)
    let errors = new(Collected { items: [] })
    let transport = syslog.Transport.Tls("localhost", l.handle.addr.port, tls.Config { roots: [] , groups: [0x001D] })
    using s = syslog.open(syslog.Config { transport, hostname: "h", procid: "5", timeout_ms: 2000 })
    let logger = syslog.attach(base_logger(errors), s)
    log.info(logger, "secure")
    print("untrusted server reported {errors.items.len == 1}")
    net.close_listener(l)
}

fn main() ! io.Error {
    rfc_examples()
    util_linux_vectors()
    sanitising()
    mapping()
    let dir = file.temp_dir("lowsyslog")?
    unix_datagram(dir)?
    missing_then_present(dir)?
    udp()?
    tcp()?
    unix_stream(dir)?
    tls_transport()?
    tls_untrusted()?
    file.remove_all(dir)?
}
