struct Cell {
    a: i64
    b: i64
    next: *Cell?
}

fn main() {
    var kept: []*Cell = []
    var sum = 0
    for i in 0..10000000 {
        let c = new(Cell { a: i, b: i * 3, next: none })
        sum += c.b % 7
        if i % 64 == 0 {
            push(mut kept, c)
            if kept.len > 200000 {
                truncate(mut kept, 0)
            }
        }
    }
    print(sum + kept.len)
}
