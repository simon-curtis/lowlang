struct Source {
    next: fn(i64) -> i64 ! Failure
}

enum Failure {
    Stopped
    Code(value: i64, detail: i64)
}

fn take(s: Source, n: i64) -> i64 ! Failure {
    s.next(n)? + 1
}

fn main() {
    let s = Source {
        next: fn(n) {
            if n > 2 {
                fail Code(n, n * 10)
            }
            n * 2
        }
    }
    print(take(s, 2) catch -1)
    let code = take(s, 3) catch {
        Stopped => 0
        Code(value, detail) => value + detail
    }
    print(code)
}
