import std/net/publicsuffix
import std/text

struct Counts {
    plain: i64
    wildcard: i64
    exception: i64
    failed: i64
}

fn section_of(private: bool) -> publicsuffix.Section {
    if private { publicsuffix.Section.Private } else { publicsuffix.Section.Icann }
}

fn same_section(a: publicsuffix.Section, b: publicsuffix.Section) -> bool {
    a == b
}

fn expect(mut counts: Counts, rule: str, what: str, ok: bool) {
    if !ok {
        counts.failed += 1
        if counts.failed <= 20 {
            print("failed: {rule} {what}")
        }
    }
}

fn plain_rule(mut counts: Counts, rule: str, private: bool) {
    counts.plain += 1
    let all = publicsuffix.Rules.All
    let found = publicsuffix.public_suffix(rule, all)
    expect(mut counts, rule, "suffix", found != none)
    let suffix = found ?? publicsuffix.Suffix { name: "", section: publicsuffix.Section.Unlisted }
    expect(mut counts, rule, "name", suffix.name == rule)
    expect(mut counts, rule, "section", same_section(suffix.section, section_of(private)))
    expect(mut counts, rule, "is_public_suffix", publicsuffix.is_public_suffix(rule, all))
    expect(mut counts, rule, "registrable", publicsuffix.registrable_domain(rule, all) == none)
    expect(mut counts, rule, "registrable below", publicsuffix.registrable_domain("label.{rule}", all) != none)
}

fn wildcard_rule(mut counts: Counts, rule: str, private: bool) {
    counts.wildcard += 1
    let base = text.trim_prefix(rule, "*.")
    let probe = "probe-label.{base}"
    let found = publicsuffix.public_suffix(probe, publicsuffix.Rules.All)
    expect(mut counts, rule, "suffix", found != none)
    let suffix = found ?? publicsuffix.Suffix { name: "", section: publicsuffix.Section.Unlisted }
    expect(mut counts, rule, "name", suffix.name == probe)
    expect(mut counts, rule, "section", same_section(suffix.section, section_of(private)))
}

fn exception_rule(mut counts: Counts, rule: str, private: bool) {
    counts.exception += 1
    let name = text.trim_prefix(rule, "!")
    let found = publicsuffix.public_suffix(name, publicsuffix.Rules.All)
    expect(mut counts, rule, "suffix", found != none)
    let suffix = found ?? publicsuffix.Suffix { name: "", section: publicsuffix.Section.Unlisted }
    let parent = text.cut(name, ".").after
    expect(mut counts, rule, "name", suffix.name == parent)
    expect(mut counts, rule, "section", same_section(suffix.section, section_of(private)))
    expect(mut counts, rule, "registrable", publicsuffix.registrable_domain(name, publicsuffix.Rules.All) == name)
}

fn main() {
    var counts = Counts { plain: 0, wildcard: 0, exception: 0, failed: 0 }
    var private = false
    for line in text.lines(embed("std_publicsuffix_rules.txt")) {
        if text.starts_with(line, "//") {
            private = text.contains(line, "BEGIN PRIVATE")
            continue
        }
        if text.starts_with(line, "!") {
            exception_rule(mut counts, line, private)
        } else if text.starts_with(line, "*.") {
            wildcard_rule(mut counts, line, private)
        } else {
            plain_rule(mut counts, line, private)
        }
    }
    print("plain {counts.plain} wildcard {counts.wildcard} exception {counts.exception} failed {counts.failed}")
}
