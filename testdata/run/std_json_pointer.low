import std/json
import std/json/pointer
import std/text

fn parse(s: str) -> json.Value {
    json.parse(bytes(s)) catch {
        _ => json.Value.Null
    }
}

fn problem(e: pointer.Error) -> str {
    match e {
        Syntax(at, message) => "syntax error at {at}: {message}"
        NotFound(p) => "not found: {p}"
        Mismatch(p) => "mismatch: {p}"
        CannotRemoveRoot => "cannot remove the root"
    }
}

fn show(v: json.Value) -> str {
    json.stringify(v, 0)
}

fn get(doc: json.Value, p: str) {
    let v = pointer.get(doc, p) catch {
        e => {
            print("get [{p}] -> {problem(e)}")
            return
        }
    }
    print("get [{p}] -> {show(v)}")
}

fn change(label: str, doc: json.Value, p: str, value: str) {
    let v = parse(value)
    let out = apply(label, doc, p, v) catch {
        e => {
            print("{label} [{p}] -> {problem(e)}")
            return
        }
    }
    print("{label} [{p}] -> {show(out)}")
}

fn apply(label: str, doc: json.Value, p: str, v: json.Value) -> json.Value ! pointer.Error {
    if label == "set" {
        return pointer.set(doc, p, v)
    }
    if label == "add" {
        return pointer.add(doc, p, v)
    }
    pointer.replace(doc, p, v)
}

fn remove(doc: json.Value, p: str) {
    let out = pointer.remove(doc, p) catch {
        e => {
            print("remove [{p}] -> {problem(e)}")
            return
        }
    }
    print("remove [{p}] -> {show(out)}")
}

fn relative(doc: json.Value, current: str, r: str) {
    let v = pointer.relative(doc, current, r) catch {
        e => {
            print("relative [{current}] [{r}] -> {problem(e)}")
            return
        }
    }
    print("relative [{current}] [{r}] -> {show(v)}")
}

fn tokens(p: str) {
    let parts = pointer.parse(p) catch {
        e => {
            print("parse [{p}] -> {problem(e)}")
            return
        }
    }
    print("parse [{p}] -> {parts.len} [{text.join(parts, "|")}] {pointer.format(parts)}")
}

fn main() {
    let rfc = parse("{{\"foo\": [\"bar\", \"baz\"], \"\": 0, \"a/b\": 1, \"c%d\": 2, \"e^f\": 3, \"g|h\": 4, \"i\\\\j\": 5, \"k\\\"l\": 6, \" \": 7, \"m~n\": 8}}")
    for p in ["", "/foo", "/foo/0", "/", "/a~1b", "/c%d", "/e^f", "/g|h", "/i\\j", "/k\"l", "/ ", "/m~0n", "/foo/2", "/foo/-", "/foo/01", "/foo/x", "/missing", "/foo/0/x", "foo", "/a~2b", "/a~"] {
        get(rfc, p)
    }

    print(pointer.escape("a/b~c"))
    print(pointer.escape("~1"))
    print(pointer.unescape("a~1b~0c") catch "error")
    print(pointer.unescape("~01") catch "error")
    print(pointer.unescape("~") catch "error")
    print(pointer.has(rfc, "/foo/1"))
    print(pointer.has(rfc, "/foo/9"))

    tokens("")
    tokens("/")
    tokens("//")
    tokens("/a~1b/c~0d/0")
    tokens("a")
    tokens("/a/~x")

    let doc = parse("{{\"a\": {{\"b\": [1, 2, 3]}}, \"c\": null}}")
    change("set", doc, "/a/b/1", "20")
    change("set", doc, "/a/b/3", "4")
    change("set", doc, "/a/b/-", "4")
    change("set", doc, "/a/b/5", "4")
    change("set", doc, "/a/d", "{{\"x\": true}}")
    change("set", doc, "/c", "1")
    change("set", doc, "", "[]")
    change("set", doc, "/c/d", "1")
    change("set", doc, "/a/b/x", "1")
    change("set", doc, "/z/y", "1")
    change("add", doc, "/a/b/1", "9")
    change("add", doc, "/a/b/3", "9")
    change("add", doc, "/a/b/4", "9")
    change("add", doc, "/a/b/-", "9")
    change("add", doc, "/a/e", "\"new\"")
    change("replace", doc, "/a/b/0", "0")
    change("replace", doc, "/a/b/3", "0")
    change("replace", doc, "/a/b/-", "0")
    change("replace", doc, "/a/zz", "0")
    change("replace", doc, "/c", "false")
    remove(doc, "/a/b/0")
    remove(doc, "/a/b/2")
    remove(doc, "/a/b/3")
    remove(doc, "/a/b")
    remove(doc, "/c")
    remove(doc, "/missing")
    remove(doc, "")
    remove(doc, "/a/b/-")
    print(show(doc))

    let nested = parse("{{\"foo\": [\"bar\", {{\"baz\": 7}}], \"k\": \"v\"}}")
    relative(nested, "/foo/1/baz", "0")
    relative(nested, "/foo/1/baz", "1")
    relative(nested, "/foo/1/baz", "1/0")
    relative(nested, "/foo/1/baz", "2/0")
    relative(nested, "/foo/1/baz", "3/k")
    relative(nested, "/foo/1/baz", "2/k")
    relative(nested, "/foo/1/baz", "0#")
    relative(nested, "/foo/1/baz", "1#")
    relative(nested, "/foo/1/baz", "2#")
    relative(nested, "/foo/1/baz", "4")
    relative(nested, "/foo/1/baz", "x")
    relative(nested, "/foo/1/baz", "01")
}
