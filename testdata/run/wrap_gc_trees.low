struct Node {
    value: i64
    left: *Node?
    right: *Node?
}

fn make(depth: i64, seed: i64) -> *Node {
    if depth == 0 {
        return new(Node { value: seed, left: none, right: none })
    }
    let l = make(depth - 1, seed * 2)
    let r = make(depth - 1, seed * 2 + 1)
    new(Node { value: seed, left: l, right: r })
}

fn pick(n: *Node, k: i64, fallback: *Node) -> *Node {
    if k < 0 {
        return fallback
    }
    if k == 0 {
        return n
    }
    let fresh = make(3, k)
    match n.left {
        some(l) => {
            if fresh.value > 0 { pick(l, k - 1, fresh) } else { l }
        }
        none => fresh
    }
}

fn check(n: *Node?) -> i64 {
    match n {
        some(x) => x.value + check(x.left) + check(x.right)
        none => 0
    }
}

fn worker(id: i64, out: chan[i64]) {
    var keep = make(6, id)
    var total = 0
    var other = make(2, id + 100)
    for i in 0..200000 {
        let p = pick(keep, i % 7 - 1, other)
        total += check(p) % 1000
        if i % 50 == 0 {
            keep = make(6, id + i)
        }
        other = pick(other, -1, keep)
    }
    out <- total
}

fn main() {
    let out = chan[i64](8)
    for w in 0..8 {
        spawn worker(w, out)
    }
    var sum = 0
    for w in 0..8 {
        sum += (<-out) ?? 0
    }
    print(sum)
}
