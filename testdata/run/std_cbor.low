import std/cbor
import std/io
import std/serde
import std/text

enum Shape {
    Circle(radius: f64)
    Rect(f64, f64)
    Empty
}

struct Sample {
    id: i64
    name: str
    tags: []str
    scores: [str: i64]
    blob: []u8
    ratio: f32
    shape: Shape
    note: str?
    big: u64
}

fn vectors() -> []str {
    [
        "00", "01", "0a", "17", "1818", "1819", "1864", "1903e8", "1a000f4240", "1b000000e8d4a51000",
        "1bffffffffffffffff", "c249010000000000000000", "3bffffffffffffffff", "c349010000000000000000",
        "20", "29", "3863", "3903e7",
        "f90000", "f98000", "f93c00", "fb3ff199999999999a", "f93e00", "f97bff", "fa47c35000", "fa7f7fffff",
        "fb7e37e43c8800759c", "f90001", "f90400", "f9c400", "fbc010666666666666",
        "f97c00", "f97e00", "f9fc00", "fa7f800000", "fa7fc00000", "faff800000",
        "fb7ff0000000000000", "fb7ff8000000000000", "fbfff0000000000000",
        "f4", "f5", "f6", "f7", "f0", "f8ff",
        "c074323031332d30332d32315432303a30343a30305a", "c11a514b67b0", "c1fb41d452d9ec200000",
        "d74401020304", "d818456449455446", "d82076687474703a2f2f7777772e6578616d706c652e636f6d",
        "40", "4401020304", "60", "6161", "6449455446", "62225c", "62c3bc", "63e6b0b4", "64f0908591",
        "80", "83010203", "8301820203820405",
        "98190102030405060708090a0b0c0d0e0f101112131415161718181819",
        "a0", "a201020304", "a26161016162820203", "826161a161626163",
        "a56161614161626142616361436164614461656145",
        "5f42010243030405ff", "7f657374726561646d696e67ff", "9fff", "9f018202039f0405ffff",
        "9f01820203820405ff", "83018202039f0405ff", "83019f0203ff820405",
        "9f0102030405060708090a0b0c0d0e0f101112131415161718181819ff",
        "bf61610161629f0203ffff", "826161bf61626163ff", "bf6346756ef563416d7421ff",
    ]
}

fn hex(s: str) -> []u8 {
    text.decode_hex(s) or []
}

fn error_name(e: io.Error) -> str {
    match e {
        Malformed => "Malformed"
        TooLarge => "TooLarge"
        _ => "other"
    }
}

fn check(label: str, data: []u8, options: cbor.Options) {
    let v = cbor.decode_with(data, options) catch {
        e => {
            print("{label}: {error_name(e)}")
            return
        }
    }
    print("{label}: {cbor.diagnostic(v)}")
}

fn appendix() {
    for s in vectors() {
        let v = cbor.decode(hex(s)) catch {
            e => {
                print("{s} failed {error_name(e)}")
                continue
            }
        }
        let again = text.encode_hex(cbor.encode(v))
        let mark = if again == s { "" } else { " -> {again}" }
        print("{s} {cbor.diagnostic(v)}{mark}")
    }
}

fn errors() {
    let o = cbor.Options {}
    check("truncated head", hex("19ff"), o)
    check("truncated string", hex("4401"), o)
    check("reserved info", hex("1c"), o)
    check("lone break", hex("ff"), o)
    check("indefinite integer", hex("1f"), o)
    check("indefinite tag", hex("df00"), o)
    check("mixed chunks", hex("5f6161ff"), o)
    check("nested indefinite chunk", hex("5f5f4100ffff"), o)
    check("simple below 32", hex("f818"), o)
    check("bad utf-8", hex("62c328"), o)
    check("surrogate", hex("63eda080"), o)
    check("duplicate key", hex("a201020103"), o)
    check("trailing data", hex("0000"), o)
    check("unterminated", hex("9f01"), o)
    check("huge count", hex("9b00000000ffffffff"), o)
    check("length past input", hex("5a00010000"), o)
    check("deep", hex("818181818100"), cbor.Options { max_depth: 4 })
    check("depth ok", hex("818181818100"), cbor.Options { max_depth: 5 })
    check("long", hex("4401020304"), cbor.Options { max_length: 3 })
    check("long indefinite", hex("5f420102420304ff"), cbor.Options { max_length: 3 })
    let first = cbor.decode_first(hex("a10102ff"), o) or return
    print("prefix: {cbor.diagnostic(first.value)} in {first.length} bytes")
}

fn build() {
    let entries: []cbor.Entry = [
        cbor.Entry { key: cbor.integer(-1), value: cbor.Value.Unsigned(1) },
        cbor.Entry { key: cbor.Value.Text("b"), value: cbor.Value.Float(0.5) },
        cbor.Entry { key: cbor.Value.Text("a"), value: cbor.Value.Float(1.1) },
        cbor.Entry { key: cbor.integer(3), value: cbor.integer(-7) },
        cbor.Entry { key: cbor.integer(1000), value: cbor.Value.Float(-0.0) },
        cbor.Entry { key: cbor.integer(1), value: cbor.Value.Bytes([1, 2]) },
    ]
    let m = cbor.Value.Map(entries)
    print("deterministic {text.encode_hex(cbor.encode(m))}")
    let found = cbor.get(m, cbor.integer(3)) ?? cbor.Value.Null
    print("get 3 = {cbor.diagnostic(found)}, as integer {cbor.as_integer(found) ?? 0}")
    let floats = [100000.0, 1.0e-7, 5.0e-324, 3.0e38, 65504.0, 65520.0, 1.0 / 3.0]
    for x in floats {
        print("{x} {text.encode_hex(cbor.encode(cbor.Value.Float(x)))}")
    }
}

fn round_trip() ! serde.Error {
    let s = Sample {
        id: -42
        name: "lowlang"
        tags: ["a", "b"]
        scores: ["x": 1, "y": -2]
        blob: [0, 255]
        ratio: 0.25
        shape: Rect(2.0, 3.5)
        note: none
        big: 0xFFFFFFFFFFFFFFFF
    }
    let data = cbor.serialize(s)
    print("serialized {text.encode_hex(data)}")
    let v = cbor.decode(data) or return
    print("diagnostic {cbor.diagnostic(v)}")
    let back: Sample = cbor.deserialize(data)?
    print("back {back.id} {back.name} {back.tags.len} {back.scores["y"] ?? 0} {back.blob[1]} {back.ratio} {back.big}")
    match back.shape {
        Rect(w, h) => print("rect {w} {h}")
        _ => print("wrong shape")
    }
    print("note is none: {back.note == none}")
    let shapes: []Shape = [Circle(1.0), Empty]
    let encoded = cbor.serialize(shapes)
    print("shapes {cbor.diagnostic(cbor.decode(encoded) or cbor.Value.Null)}")
    let shapes_back: []Shape = cbor.deserialize(encoded)?
    print("shapes back {shapes_back.len}")
    let wrong: i64 = cbor.deserialize(hex("6161")) catch {
        Mismatch(expected, at) => {
            print("mismatch {expected}")
            0
        }
        _ => 0
    }
    print("wrong {wrong}")
}

fn main() ! serde.Error {
    appendix()
    errors()
    build()
    round_trip()?
}
