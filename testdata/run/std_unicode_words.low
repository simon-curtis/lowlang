import std/text
import std/unicode

fn code(token: str) -> u32 {
    u32(text.parse_uint(token, 16) or 0)
}

fn flush(mut segments: []str, mut current: []u8) {
    push(mut segments, str(current))
    current = []
}

fn check(line: str) -> bool {
    var expected: []str = []
    var current: []u8 = []
    var whole: []u8 = []
    for token in text.fields(line) {
        if token == "÷" {
            flush(mut expected, mut current)
        } else if token != "×" {
            let c = code(token)
            text.append_char(mut current, c)
            text.append_char(mut whole, c)
        }
    }
    flush(mut expected, mut current)
    let input = str(whole)
    let got = unicode.words(input)
    if got.len != expected.len {
        return false
    }
    var at = 0
    for i, w in got {
        if w != expected[i] || unicode.word_end(input, at) != at + w.len {
            return false
        }
        at += w.len
    }
    true
}

fn build(cs: []u32) -> str {
    var out: []u8 = []
    for c in cs {
        text.append_char(mut out, c)
    }
    str(out)
}

fn show(s: str) {
    var parts: []str = []
    for w in unicode.words(s) {
        push(mut parts, "[{w}]")
    }
    print("{unicode.words(s).len}: {text.join(parts, " ")}")
}

fn main() {
    var total = 0
    var failed = 0
    for line in text.lines(embed("std_unicode_words.txt")) {
        if line == "" {
            continue
        }
        total += 1
        if !check(line) {
            failed += 1
            print("failed: {line}")
        }
    }
    print("cases {total} failed {failed}")

    show("")
    show("hello")
    show("hello, world!")
    show("can't stop e.g. example.com")
    show("3.14 and 1,000,000 and 3a")
    show("snake_case  two  spaces")
    show("a\r\nb\nc")
    show("x .5 y.")
    show("日本語です")
    show(build([0x30AB, 0x30BF, 0x30AB, 0x30CA, 'a']))
    show(build([0x1F1EF, 0x1F1F5, 0x1F1FA, 0x1F1F8, 0x1F1EB]))
    show(build([0x1F468, 0x200D, 0x1F469, ' ', 0x1F44D, 0x1F3FD]))
    show(build(['e', 0x301, 'x', ' ', 0x301, 'y']))
    show(build([0x5D0, '"', 0x5D1, ' ', 0x5D2, '\'']))
    show(build(['a', 0xAD, 'b', 0x200D, ' ']))
    print(unicode.word_end("hello world", 0))
    print(unicode.word_end("hello world", 5))
    print(unicode.word_end("hello world", 6))
}
