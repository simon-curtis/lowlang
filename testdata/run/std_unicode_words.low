import std/text
import std/unicode

fn code(token: str) -> u32 {
    u32(text.parse_uint(token, 16) or 0)
}

fn flush(mut pieces: []str, mut current: []u8) {
    push(mut pieces, str(current))
    current = []
}

fn check(line: str) -> bool {
    var expected: []str = []
    var current: []u8 = []
    var whole: []u8 = []
    for token in text.fields(line) {
        if token == "÷" {
            flush(mut expected, mut current)
        } else if token != "×" {
            let c = code(token)
            text.append_char(mut current, c)
            text.append_char(mut whole, c)
        }
    }
    flush(mut expected, mut current)
    let input = str(whole)
    let got = unicode.words(input)
    if got.len != expected.len || unicode.word_count(input) != expected.len {
        return false
    }
    var at = 0
    for i, w in got {
        if w != expected[i] {
            return false
        }
        let end = unicode.word_end(input, at)
        if end != at + w.len {
            return false
        }
        at = end
    }
    true
}

fn build(cs: []u32) -> str {
    var out: []u8 = []
    for c in cs {
        text.append_char(mut out, c)
    }
    str(out)
}

fn show(s: str) {
    print("{unicode.word_count(s)}: {text.join(unicode.words(s), "|")}")
}

fn main() {
    var total = 0
    var failed = 0
    for line in text.lines(embed("std_unicode_words.txt")) {
        if line == "" {
            continue
        }
        total += 1
        if !check(line) {
            failed += 1
            print("failed: {line}")
        }
    }
    print("cases {total} failed {failed}")

    show("")
    show("Hello, world!")
    show("It's 3.14 o'clock, e.g. example.com")
    show("1,234.56 and 7:30")
    show("snake_case  two  spaces")
    show("a\r\nb\nc")
    show("カタカナ カナ")
    show("שלום ש\"ב")
    show(build([0x1F1EF, 0x1F1F5, 0x1F1FA, 0x1F1F8, 0x1F1EB]))
    show(build([0x1F468, 0x200D, 0x1F469, 0x200D, 0x1F467, 'x']))
    show(build(['a', 0x301, 'b']))
    print(unicode.word_end("ab cd", 0))
    print(unicode.word_end("ab cd", 2))
    print(unicode.word_end("ab cd", 3))
}
