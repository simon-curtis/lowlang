== listing
doctype html
text "\n"
start html lang="en-GB"
start head
start title
text "Football on TV & Streaming"
end title
text "\n"
start script type="text/javascript"
text "if (a < b && c > d) { document.write('</div><p>'); }"
end script
text "\n"
start style
text ".fixture > div { color: red }"
end style
end head
text "\n"
start body
start div class="fixture-date"
text "Saturday 14th November 2026"
end div
text "\n"
start div class="fixture"
start div class="fixture__time"
text "12:30"
end div
text "\n"
start div class="fixture__teams"
text "Brighton & Hove Albion v Nott'm Forest"
end div
text "\n"
start div class="fixture__competition"
text "Women's Champions League League Phase"
end div
text "\n"
start div class="fixture__channel"
start div class="span3 channels"
start span class="channel-pill" style="background-color: #020e41;border: 0;"
text "TNT Sports 1"
end span
start span class="channel-pill"
text "discovery+"
end span
end div
end div
end div
text "\n"
end body
end html
end of input
== attributes
start a href="/match?id=1&tab=2" data-x="single "q"" title="x < y" checked="" data-ref="a&copy=b"
text "link"
end a
end of input
== uppercase
start div class="Box" id="Main"
start p
text "Text"
end p
end div
start br /
end of input
== script
start script
text "var s = '</div>'; if (x < 1) { y = '<b>'; }"
end script
start p
text "after"
end p
end of input
== comments
comment " a -- b "
comment ""
comment ""
text "x"
comment " c "
text "y"
comment "?xml version="1.0"?"
comment "[CDATA[raw]]"
comment " bogus"
end of input
== entities
text "& ' '  | ¬it; © 2026 &unknown; € � � � &# &#x; &"
end of input
== attribute entities
start p a="&notit;" b="&copy=1" c="© 2" d="&amp"
end of input
== escapable
start title
text "A <b> title <i>not a tag</i>"
end title
start textarea
text "x"
end textarea
end of input
== doctype
doctype html public="-//W3C//DTD HTML 4.01//EN" system="http://www.w3.org/TR/html4/strict.dtd"
end of input
== malformed
start div class="a" =x=""
end div
start p <a"b="c"
text "1 < 2 <3"
end of input
== unterminated attribute
text "text"
end of input
== unterminated comment
comment " open "
end of input
== lone markup
text "a < b <"
end of input
== unterminated script
start script
text "never closed </scrip"
end of input
== unterminated bang comment
comment "<!"
end of input
== empty
end of input
