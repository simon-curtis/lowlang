import std/builder
import std/io
import std/protobuf/proto
import std/text

struct Case {
    name: str
    source: str
}

fn scalar_text(s: proto.Scalar) -> str {
    match s {
        Double => "double"
        Float => "float"
        Int32 => "int32"
        Int64 => "int64"
        Uint32 => "uint32"
        Uint64 => "uint64"
        Sint32 => "sint32"
        Sint64 => "sint64"
        Fixed32 => "fixed32"
        Fixed64 => "fixed64"
        Sfixed32 => "sfixed32"
        Sfixed64 => "sfixed64"
        Bool => "bool"
        String => "string"
        Bytes => "bytes"
    }
}

fn ref_text(r: proto.TypeRef) -> str {
    match r {
        Builtin(kind) => scalar_text(kind)
        Named(name) => name
        Message(name) => "message {name}"
        Enum(name) => "enum {name}"
    }
}

fn constant_text(c: proto.Constant) -> str {
    match c {
        Ident(name) => name
        Int(value) => "{value}"
        Uint(value) => "{value}"
        Float(value) => "{value}"
        Text(value) => text.quote(value)
        Bool(value) => "{value}"
        Aggregate(body) => "{{{body}}}"
    }
}

fn label_text(l: proto.Label) -> str {
    match l {
        Implicit => ""
        Optional => "optional "
        Required => "required "
        Repeated => "repeated "
    }
}

fn options_text(options: proto.Option[]) -> str {
    var out = builder.builder()
    for o in options {
        builder.write(mut out, " [{o.name} = {constant_text(o.value)}]")
    }
    builder.to_str(out)
}

fn field_text(f: *proto.Field) -> str {
    var type = ""
    match f.type {
        Single(of) => { type = ref_text(of) }
        Map(key, value) => { type = "map<{scalar_text(key)}, {ref_text(value)}>" }
    }
    var tail = options_text(f.options)
    let given = f.default
    match given {
        some(value) => { tail = "{tail} default {constant_text(value)}" }
        none => {}
    }
    if f.json_name != "" {
        tail = "{tail} json {f.json_name}"
    }
    let group = if f.oneof == "" { "" } else { " in {f.oneof}" }
    "{label_text(f.label)}{type} {f.name} = {f.number}{tail}{group}"
}

fn ranges_text(ranges: proto.Range[]) -> str {
    var parts: str[] = []
    for r in ranges {
        parts.push("{r.first}..{r.last}")
    }
    text.join(parts, ",")
}

fn reserved_text(r: proto.Reserved) -> str {
    var parts: str[] = []
    if r.ranges.len > 0 {
        parts.push("numbers {ranges_text(r.ranges)}")
    }
    if r.names.len > 0 {
        parts.push("names {text.join(r.names, ",")}")
    }
    text.join(parts, " ")
}

fn dump_enum(e: *proto.Enum, indent: str) {
    let alias = if e.allow_alias { " allow_alias" } else { "" }
    print("{indent}enum {e.name}{alias}{options_text(e.options)}")
    for v in e.values {
        print("{indent}  {v.name} = {v.number}{options_text(v.options)}")
    }
    let reserved = reserved_text(e.reserved)
    if reserved != "" {
        print("{indent}  reserved {reserved}")
    }
}

fn dump_message(m: *proto.Message, indent: str) {
    print("{indent}message {m.name}{options_text(m.options)}")
    for f in m.fields {
        print("{indent}  {field_text(f)}")
    }
    for g in m.oneofs {
        print("{indent}  oneof {g.name}{options_text(g.options)}")
    }
    if m.extensions.len > 0 {
        print("{indent}  extensions {ranges_text(m.extensions)}")
    }
    let reserved = reserved_text(m.reserved)
    if reserved != "" {
        print("{indent}  reserved {reserved}")
    }
    for x in m.extends {
        dump_extend(x, "{indent}  ")
    }
    for e in m.enums {
        dump_enum(e, "{indent}  ")
    }
    for n in m.messages {
        dump_message(n, "{indent}  ")
    }
}

fn dump_extend(x: *proto.Extend, indent: str) {
    print("{indent}extend {x.target}")
    for f in x.fields {
        print("{indent}  {field_text(f)}")
    }
}

fn dump_service(s: *proto.Service) {
    print("service {s.name}{options_text(s.options)}")
    for m in s.methods {
        let client = if m.client_streaming { "stream " } else { "" }
        let server = if m.server_streaming { "stream " } else { "" }
        print("  rpc {m.name}({client}{m.input}) returns ({server}{m.output}){options_text(m.options)}")
    }
}

fn dump_file(f: *proto.File) {
    let syntax = match f.syntax {
        Proto2 => "proto2"
        Proto3 => "proto3"
    }
    print("file {f.path} {syntax} package {f.package}")
    for i in f.imports {
        let kind = if i.public { "public " } else if i.weak { "weak " } else { "" }
        print("import {kind}{i.path}")
    }
    for o in f.options {
        print("option {o.name} = {constant_text(o.value)}")
    }
    for e in f.enums {
        dump_enum(e, "")
    }
    for m in f.messages {
        dump_message(m, "")
    }
    for x in f.extends {
        dump_extend(x, "")
    }
    for s in f.services {
        dump_service(s)
    }
}

fn show(path: str, source: str) {
    let file = proto.parse(path, source) catch {
        e => {
            print("{path}: {proto.message(e)}")
            return
        }
    }
    dump_file(file)
}

fn nested(depth: i64) -> str {
    var open = ""
    var close = ""
    for i in 0..depth {
        open = "{open}message M{i} {{ "
        close = "{close} }}"
    }
    "syntax = \"proto3\"; {open}{close}"
}

fn parse_failures() -> Case[] {
    [
        Case { name: "message without a name", source: "syntax = \"proto3\"; message {{" }
        Case { name: "missing semicolon", source: "syntax = \"proto3\"\nmessage M {{}}" }
        Case { name: "stray symbol", source: "syntax = \"proto3\"; message M {{ int32 a = 1; }} @" }
        Case { name: "bare definition", source: "syntax = \"proto3\"; 7" }
        Case { name: "unterminated string", source: "syntax = \"proto3;" }
        Case { name: "string ends at newline", source: "syntax = \"proto3\n\";" }
        Case { name: "unterminated comment", source: "syntax = \"proto3\"; /* never ends" }
        Case { name: "bad escape", source: "syntax = \"pr\\q\";" }
        Case { name: "bad hex escape", source: "syntax = \"pr\\xg\";" }
        Case { name: "octal escape out of range", source: "syntax = \"pr\\777\";" }
        Case { name: "bad unicode escape", source: "syntax = \"pr\\ud800\";" }
        Case { name: "letters after a number", source: "syntax = \"proto3\"; message M {{ int32 a = 12abc; }}" }
        Case { name: "number too large", source: "syntax = \"proto3\"; message M {{ int32 a = 99999999999999999999; }}" }
        Case { name: "enum number too large", source: "syntax = \"proto3\"; enum E {{ A = 0; B = 2147483648; }}" }
        Case { name: "unknown syntax", source: "syntax = \"proto4\";" }
        Case { name: "edition", source: "edition = \"2023\";" }
        Case { name: "group", source: "syntax = \"proto2\"; message M {{ optional group G = 1 {{ optional int32 a = 2; }} }}" }
        Case { name: "proto2 field without label", source: "syntax = \"proto2\"; message M {{ int32 a = 1; }}" }
        Case { name: "proto3 required", source: "syntax = \"proto3\"; message M {{ required int32 a = 1; }}" }
        Case { name: "proto3 default", source: "syntax = \"proto3\"; message M {{ optional int32 a = 1 [default = 1]; }}" }
        Case { name: "proto3 first enum value", source: "syntax = \"proto3\"; enum E {{ A = 1; }}" }
        Case { name: "proto3 extensions", source: "syntax = \"proto3\"; message M {{ extensions 100 to 199; }}" }
        Case { name: "field number zero", source: "syntax = \"proto3\"; message M {{ int32 a = 0; }}" }
        Case { name: "field number in the implementation range", source: "syntax = \"proto3\"; message M {{ int32 a = 19500; }}" }
        Case { name: "field number too large", source: "syntax = \"proto3\"; message M {{ int32 a = 536870912; }}" }
        Case { name: "duplicate field number", source: "syntax = \"proto3\"; message M {{ int32 a = 1; int32 b = 1; }}" }
        Case { name: "duplicate field name", source: "syntax = \"proto3\"; message M {{ int32 a = 1; int32 a = 2; }}" }
        Case { name: "duplicate oneof member", source: "syntax = \"proto3\"; message M {{ int32 a = 1; oneof g {{ int32 a = 2; }} }}" }
        Case { name: "duplicate oneof", source: "syntax = \"proto3\"; message M {{ oneof g {{ int32 a = 1; }} oneof g {{ int32 b = 2; }} }}" }
        Case { name: "duplicate enum number", source: "syntax = \"proto3\"; enum E {{ A = 0; B = 0; }}" }
        Case { name: "duplicate enum name", source: "syntax = \"proto3\"; enum E {{ A = 0; A = 1; }}" }
        Case { name: "duplicate message", source: "syntax = \"proto3\"; message M {{}} message M {{}}" }
        Case { name: "duplicate nested type", source: "syntax = \"proto3\"; message M {{ message N {{}} enum N {{ A = 0; }} }}" }
        Case { name: "duplicate method", source: "syntax = \"proto3\"; service S {{ rpc A(M) returns (M); rpc A(M) returns (M); }}" }
        Case { name: "duplicate package", source: "syntax = \"proto3\"; package a; package b;" }
        Case { name: "reserved number", source: "syntax = \"proto3\"; message M {{ reserved 2 to 4; int32 a = 3; }}" }
        Case { name: "reserved name", source: "syntax = \"proto3\"; message M {{ reserved \"a\"; int32 a = 3; }}" }
        Case { name: "reserved enum number", source: "syntax = \"proto3\"; enum E {{ reserved 5; A = 0; B = 5; }}" }
        Case { name: "reserved enum name", source: "syntax = \"proto3\"; enum E {{ reserved \"B\"; A = 0; B = 5; }}" }
        Case { name: "extension range", source: "syntax = \"proto2\"; message M {{ extensions 10 to 20; optional int32 a = 12; }}" }
        Case { name: "map with a float key", source: "syntax = \"proto3\"; message M {{ map<float, int32> a = 1; }}" }
        Case { name: "map with a message key", source: "syntax = \"proto3\"; message M {{ map<N, int32> a = 1; }}" }
        Case { name: "map with a label", source: "syntax = \"proto3\"; message M {{ repeated map<string, int32> a = 1; }}" }
        Case { name: "map in a oneof", source: "syntax = \"proto3\"; message M {{ oneof g {{ map<string, int32> a = 1; }} }}" }
        Case { name: "empty oneof", source: "syntax = \"proto3\"; message M {{ oneof g {{}} }}" }
        Case { name: "label in a oneof", source: "syntax = \"proto3\"; message M {{ oneof g {{ repeated int32 a = 1; }} }}" }
        Case { name: "empty enum", source: "syntax = \"proto3\"; enum E {{}}" }
        Case { name: "json_name not a string", source: "syntax = \"proto3\"; message M {{ int32 a = 1 [json_name = 1]; }}" }
        Case { name: "unclosed message", source: "syntax = \"proto3\"; message M {{ int32 a = 1;" }
        Case { name: "unclosed aggregate", source: "syntax = \"proto3\"; option (x) = {{ a: 1" }
        Case { name: "nesting 32 deep", source: nested(32) }
        Case { name: "nesting 33 deep", source: nested(33) }
    ]
}

fn show_failures() {
    for c in parse_failures() {
        proto.parse("case.proto", c.source) catch {
            e => {
                print("{c.name}: {proto.message(e)}")
                continue
            }
        }
        print("{c.name}: parsed")
    }
}

fn reader(files: [str: str]) -> fn(str) -> str ! io.Error {
    fn(name: str) -> str ! io.Error {
        if name == "locked.proto" {
            fail io.Error.Denied
        }
        files[name] ?? fail io.Error.NotFound
    }
}

fn read_set(paths: str[], files: [str: str]) -> proto.Set ! proto.Error {
    proto.read_files(paths, ["", "lib"], reader(files))?
}

fn show_load(name: str, paths: str[], files: [str: str]) {
    let set = read_set(paths, files) catch {
        e => {
            print("{name}: {proto.message(e)}")
            return
        }
    }
    var order: str[] = []
    for f in set.files {
        order.push(f.path)
    }
    print("{name}: {text.join(order, " ")}")
    for f in set.files {
        for m in f.messages {
            for field in m.fields {
                print("  {m.full_name}.{field.name}: {field_type(field)}")
            }
        }
        for s in f.services {
            for m in s.methods {
                print("  {s.full_name}.{m.name}: {m.input} -> {m.output}")
            }
        }
    }
}

fn field_type(f: *proto.Field) -> str {
    match f.type {
        Single(of) => ref_text(of)
        Map(key, value) => "map<{scalar_text(key)}, {ref_text(value)}>"
    }
}

fn load_cases() {
    let files: [str: str] = [
        "a.proto": "syntax = \"proto3\"; package p.q; import \"b.proto\"; import \"r.proto\"; message A {{ B b = 1; r.R r = 2; .p.q.A.In in = 3; In in2 = 4; message In {{ A back = 1; }} }}",
        "lib/b.proto": "syntax = \"proto3\"; package p.q; import public \"c.proto\"; message B {{ C c = 1; }}",
        "lib/c.proto": "syntax = \"proto3\"; package p.q; enum C {{ C_ZERO = 0; }}",
        "r.proto": "syntax = \"proto3\"; package p.q.r; message R {{ string s = 1; }}",
        "loop1.proto": "syntax = \"proto3\"; import \"loop2.proto\";",
        "loop2.proto": "syntax = \"proto3\"; import \"loop1.proto\";",
        "self.proto": "syntax = \"proto3\"; import \"self.proto\";",
        "missing.proto": "syntax = \"proto3\"; import \"nowhere.proto\";",
        "locked.proto": "syntax = \"proto3\";",
        "bad.proto": "syntax = \"proto3\"; message M {{ Unknown u = 1; }}",
        "unimported.proto": "syntax = \"proto3\"; message M {{ q.C c = 1; }}",
        "twice.proto": "syntax = \"proto3\"; package p.q; message B {{}}",
        "enum_call.proto": "syntax = \"proto3\"; enum E {{ Z = 0; }} message M {{}} service S {{ rpc Go(E) returns (M); }}",
        "unknown_call.proto": "syntax = \"proto3\"; message M {{}} service S {{ rpc Go(M) returns (Nope); }}",
        "extend.proto": "syntax = \"proto2\"; message M {{ extensions 10 to 20; }} extend M {{ optional int32 x = 10; }} extend Nothing {{ optional int32 y = 10; }}",
        "parse_error.proto": "syntax = \"proto3\"; message {{",
    ]
    show_load("resolution", ["a.proto"], files)
    show_load("two roots", ["lib/b.proto"], files)
    show_load("import cycle", ["loop1.proto"], files)
    show_load("self import", ["self.proto"], files)
    show_load("missing import", ["missing.proto"], files)
    show_load("unreadable", ["locked.proto"], files)
    show_load("unknown type", ["bad.proto"], files)
    show_load("not imported", ["unimported.proto", "r.proto"], files)
    show_load("duplicate type", ["lib/b.proto", "twice.proto"], files)
    show_load("enum as request", ["enum_call.proto"], files)
    show_load("unknown response", ["unknown_call.proto"], files)
    show_load("unknown extension target", ["extend.proto"], files)
    show_load("parse error in an import", ["a.proto", "parse_error.proto"], files)
}

fn generate_cases() {
    let files: [str: str] = [
        "inf.proto": "syntax = \"proto2\"; message M {{ optional float a = 1 [default = inf]; }}",
        "mismatch.proto": "syntax = \"proto2\"; message M {{ optional int32 a = 1 [default = \"x\"]; }}",
        "enum_default.proto": "syntax = \"proto2\"; enum E {{ A = 0; }} message M {{ optional E a = 1 [default = B]; }}",
        "required_cycle.proto": "syntax = \"proto2\"; message M {{ required N n = 1; }} message N {{ optional M m = 1; }}",
        "fine.proto": "syntax = \"proto3\"; message M {{ string s = 1; }}",
    ]
    for name in ["inf.proto", "mismatch.proto", "enum_default.proto", "required_cycle.proto", "fine.proto"] {
        let set = read_set([name], files) or panic("load {name}")
        let outputs = proto.generate(set, proto.Options {}) catch {
            e => {
                print("{name}: {proto.message(e)}")
                continue
            }
        }
        print("{name}: {outputs.len} output {outputs[0].path}")
    }
}

fn main() {
    show("timestamp.proto", embed("timestamp.proto"))
    show("duration.proto", embed("duration.proto"))
    show("any.proto", embed("any.proto"))
    show("service.proto", embed("service.proto"))
    show("proto2.proto", embed("proto2.proto"))
    show_failures()
    load_cases()
    generate_cases()
}
