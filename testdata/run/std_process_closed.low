import std/file
import std/io
import std/os
import std/process
import std/sys

fn describe(e: process.Exit) -> str {
    match e {
        Exited(code) => "exited {code}"
        Signaled(_) => "ended by kill"
    }
}

fn ended(e: process.Exit) -> str {
    if process.success(e) { "exited 0" } else { "ended by kill" }
}

fn child(mode: str) ! io.Error {
    match mode {
        "cat" => {
            let input = io.read_all(sys.stream(0))?
            sys.write_all(1, input)?
        }
        _ => sleep(30000)
    }
}

fn must(s: io.Stream?) -> io.Stream ! io.Error {
    match s {
        some(x) => x
        none => fail NotConnected
    }
}

fn write_outcome(s: io.Stream, data: str) -> str {
    let n = s.write(bytes(data)) catch {
        NotConnected => return "not connected"
        _ => return "other error"
    }
    "wrote {n}"
}

fn read_outcome(s: io.Stream) -> str {
    let n = s.read(io.buffer(8)) catch {
        NotConnected => return "not connected"
        _ => return "other error"
    }
    "read {n}"
}

fn pipes_after_close(program: str) ! io.Error {
    using child = process.start(process.Command { program, args: ["cat"], stdin: Piped, stdout: Piped })?
    let input = must(child.handle.stdin)?
    let output = must(child.handle.stdout)?
    io.write_all(input, bytes("ping"))?
    input.close()
    input.close()
    print("write after close: {write_outcome(input, "again")}")
    print("stdout: {str(io.read_all(output)?)}")
    output.close()
    output.close()
    print("read after close: {read_outcome(output)}")
    print(describe(process.wait(child)?))
    process.kill(child, Kill)?
    print(describe(process.wait(child)?))
}

fn closed_descriptor_is_not_reused(program: str, dir: str) ! io.Error {
    using child = process.start(process.Command { program, args: ["cat"], stdin: Piped, stdout: Null })?
    let input = must(child.handle.stdin)?
    input.close()
    let path = "{dir}/reuse"
    using reused = file.create(path)?
    print("write to closed pipe: {write_outcome(input, "leak")}")
    print("reused file size {file.info(reused)?.size}")
    file.remove(path)?
    print(describe(process.wait(child)?))
}

fn read_until_released(output: io.Stream, results: chan[str]) {
    let buf = io.buffer(8)
    let n = output.read(buf) or -1
    results <- "reader returned {n}"
}

fn spawn_reader(program: str, results: chan[str]) ! io.Error {
    using child = process.start(process.Command { program, args: ["sleep"], stdout: Piped })?
    let output = must(child.handle.stdout)?
    spawn read_until_released(output, results)
    sleep(20)
}

fn drop_releases_blocked_reader(program: str) ! io.Error {
    let results = chan[str](1)
    spawn_reader(program, results)?
    print((<-results) ?? "")
}

fn handle_lifecycle(program: str) ! io.Error {
    let h = process.start_handle(process.Command { program, args: ["sleep"], stdout: Piped })?
    process.kill_on(h, Terminate)?
    print(ended(process.wait_on(h)?))
    print(ended(process.wait_on(h)?))
    using adopted = process.adopt(h)
    print(ended(process.wait(adopted)?))
}

fn main() ! io.Error {
    let args = os.args()
    if args.len > 1 {
        child(args[1])?
        return
    }
    let program = os.executable()?
    let dir = file.temp_dir("low-std-process-closed-")?
    pipes_after_close(program)?
    closed_descriptor_is_not_reused(program, dir)?
    drop_releases_blocked_reader(program)?
    handle_lifecycle(program)?
    file.remove_all(dir)?
}
