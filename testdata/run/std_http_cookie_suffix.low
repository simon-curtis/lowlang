import std/http
import std/text

fn stored(jar: http.CookieJar, url: str, line: str) {
    print("  {line} from {url}: {http.jar_set(jar, url, line)}")
}

fn sent(jar: http.CookieJar, url: str) {
    let header = http.jar_header(jar, url)
    print("  {url} sends {if header.len == 0 { "(none)" } else { header }}")
}

fn cookie_text(c: http.Cookie) -> str {
    "{c.name}={c.value} domain {c.domain} host_only {c.host_only}"
}

fn listed(jar: http.CookieJar) {
    for c in http.jar_cookies(jar) {
        print("  holds {cookie_text(c)}")
    }
}

fn main() {
    print("icann suffixes")
    let icann = http.cookie_jar()
    stored(icann, "http://shop.example.com/", "a=1; Domain=com")
    stored(icann, "http://shop.example.co.uk/", "b=1; Domain=co.uk")
    stored(icann, "http://shop.example.co.uk/", "c=1; Domain=.CO.UK")
    stored(icann, "http://shop.example.co.uk/", "d=1; Domain=example.co.uk")
    sent(icann, "http://shop.example.co.uk/")
    sent(icann, "http://other.example.co.uk/")
    sent(icann, "http://example.com/")

    print("a suffix equal to the host is host-only")
    let own = http.cookie_jar()
    stored(own, "http://com/", "a=1; Domain=com")
    stored(own, "http://co.uk/", "b=1; Domain=co.uk")
    stored(own, "http://localhost/", "c=1; Domain=localhost")
    listed(own)
    sent(own, "http://sub.co.uk/")
    sent(own, "http://co.uk/")

    print("private section")
    let private = http.cookie_jar()
    stored(private, "http://alice.github.io/", "a=1; Domain=github.io")
    stored(private, "http://github.io/", "b=1; Domain=github.io")
    stored(private, "http://alice.github.io/", "c=1; Domain=alice.github.io")
    listed(private)
    sent(private, "http://alice.github.io/")
    sent(private, "http://bob.github.io/")

    print("wildcard and exception rules")
    let rules = http.cookie_jar()
    stored(rules, "http://a.b.ck/", "w=1; Domain=b.ck")
    stored(rules, "http://a.b.ck/", "x=1; Domain=a.b.ck")
    stored(rules, "http://www.ck/", "y=1; Domain=www.ck")
    stored(rules, "http://www.ck/", "z=1; Domain=ck")
    stored(rules, "http://x.sub.www.ck/", "v=1; Domain=sub.www.ck")
    sent(rules, "http://a.b.ck/")
    sent(rules, "http://www.ck/")
    sent(rules, "http://x.sub.www.ck/")

    print("internationalised names")
    let intl = http.cookie_jar()
    stored(intl, "http://shop.食狮.中国/", "a=1; Domain=中国")
    stored(intl, "http://shop.食狮.中国/", "b=1; Domain=xn--fiqs8s")
    stored(intl, "http://shop.食狮.中国/", "c=1; Domain=食狮.中国")
    stored(intl, "http://shop.食狮.中国/", "d=1; Domain=.XN--85X722F.XN--FIQS8S")
    stored(intl, "http://shop.xn--85x722f.xn--fiqs8s/", "e=1; Domain=食狮.公司.cn")
    stored(intl, "http://www.食狮.公司.cn/", "f=1; Domain=公司.cn")
    stored(intl, "http://www.食狮.公司.cn/", "g=1; Domain=食狮.公司.cn")
    sent(intl, "http://shop.xn--85x722f.xn--fiqs8s/")
    sent(intl, "http://www.xn--85x722f.xn--55qx5d.cn/")
    listed(intl)

    print("addresses are not suffixes")
    let ips = http.cookie_jar()
    stored(ips, "http://127.0.0.1/", "a=1; Domain=127.0.0.1")
    listed(ips)
}
