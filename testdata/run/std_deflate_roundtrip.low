import std/compress/deflate
import std/hash
import std/io

fn generated(n: i64) -> []u8 {
    let words = ["alpha ", "beta ", "gamma ", "delta ", "stream ", "window ", "huffman ", "\n"]
    var out: []u8 = []
    var seed: u64 = 12345
    for out.len < n {
        seed = seed * 6364136223846793005 + 1442695040888963407
        io.append(mut out, bytes(words[i64(seed >> 61)]))
    }
    out[..n]
}

fn noise(n: i64) -> []u8 {
    var out: []u8 = []
    var seed: u64 = 99
    for _ in 0..n {
        seed = seed * 6364136223846793005 + 1442695040888963407
        push(mut out, u8(seed >> 56))
    }
    out
}

fn repeated(n: i64) -> []u8 {
    var out: []u8 = []
    for i in 0..n {
        push(mut out, u8(97 + i % 2))
    }
    out
}

fn same(a: []u8, b: []u8) -> bool {
    a.len == b.len && hash.crc32(a) == hash.crc32(b)
}

fn buffered(data: []u8, format: deflate.Format, level: i64) -> []u8 {
    match format {
        Raw => deflate.compress(data, level)
        Zlib => deflate.zlib_compress(data, level)
        Gzip => deflate.gzip_compress(data, level)
    }
}

fn unbuffered(data: []u8, format: deflate.Format) -> []u8 ! io.Error {
    match format {
        Raw => deflate.decompress(data, 1 << 30)
        Zlib => deflate.zlib_decompress(data, 1 << 30)
        Gzip => deflate.gzip_decompress(data, 1 << 30)
    }
}

fn streamed(data: []u8, format: deflate.Format) -> []u8 ! io.Error {
    var out: []u8 = []
    let r = io.bytes_reader(data)
    let sink: fn([]u8) ! io.Error = fn(chunk) { io.append(mut out, chunk) }
    match format {
        Raw => deflate.decode(r, sink, 1 << 30)?
        Zlib => deflate.zlib_decode(r, sink, 1 << 30)?
        Gzip => deflate.gzip_decode(r, sink, 1 << 30)?
    }
    out
}

fn piecewise(data: []u8, format: deflate.Format, level: i64) -> []u8 ! io.Error {
    var out: []u8 = []
    let e = deflate.encoder(format, level, fn(chunk) { io.append(mut out, chunk) })
    let sizes = [1, 7, 1000, 40000, 3, 70000]
    var at = 0
    var k = 0
    for at < data.len {
        let n = if sizes[k % sizes.len] > data.len - at { data.len - at } else { sizes[k % sizes.len] }
        deflate.encode(e, data[at..at + n])?
        at += n
        k += 1
        if k % 4 == 0 {
            deflate.flush(e)?
        }
    }
    deflate.finish(e)?
    out
}

fn check(name: str, data: []u8) ! io.Error {
    var ok = true
    var sizes = ""
    let formats: []deflate.Format = [Raw, Zlib, Gzip]
    for format in formats {
        for level in 0..10 {
            let packed = buffered(data, format, level)
            ok = ok && same(unbuffered(packed, format)?, data) && same(streamed(packed, format)?, data)
            if format == Raw && (level == 0 || level == 1 || level == 6 || level == 9) {
                sizes = "{sizes} {level}:{packed.len}"
            }
        }
        for level in [0, 6] {
            ok = ok && same(unbuffered(piecewise(data, format, level)?, format)?, data)
        }
    }
    print("{name} {data.len} ok {ok}{sizes}")
}

fn main() ! io.Error {
    check("empty", [])?
    check("one", bytes("a"))?
    check("tiny", bytes("hello, hello, hello"))?
    check("repeated", repeated(100000))?
    check("noise", noise(70000))?
    check("text", generated(150000))?
}
