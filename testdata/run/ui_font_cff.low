import std/io
import std/ui/font

struct Table {
    tag: str
    data: []u8
}

fn pad(mut b: []u8, n: i64) {
    for _ in 0..n {
        b.push(0)
    }
}

fn zeros(n: i64) -> []u8 {
    var b: []u8 = []
    pad(mut b, n)
    b
}

fn sfnt(tables: []Table, base: i64) -> []u8 {
    var out: []u8 = []
    for i in 0..4 {
        out.push("OTTO"[i])
    }
    io.put_be16(mut out, tables.len)
    pad(mut out, 6)
    var offset = base + 12 + 16 * tables.len
    for t in tables {
        for i in 0..4 {
            out.push(t.tag[i])
        }
        io.put_be32(mut out, 0)
        io.put_be32(mut out, offset)
        io.put_be32(mut out, t.data.len)
        offset += (t.data.len + 3) / 4 * 4
    }
    for t in tables {
        for b in t.data {
            out.push(b)
        }
        for _ in 0..(4 - t.data.len % 4) % 4 {
            out.push(0)
        }
    }
    out
}

fn head() -> []u8 {
    var b = zeros(54)
    io.set_be16(b, 18, 1000)
    b
}

fn hhea(ascent: i64, metrics: i64) -> []u8 {
    var b = zeros(36)
    io.set_be16(b, 4, ascent)
    io.set_be16(b, 6, 65336)
    io.set_be16(b, 34, metrics)
    b
}

fn maxp(glyphs: i64) -> []u8 {
    var b = zeros(6)
    io.set_be16(b, 4, glyphs)
    b
}

fn hmtx(advances: []i64) -> []u8 {
    var b: []u8 = []
    for a in advances {
        io.put_be16(mut b, a)
        io.put_be16(mut b, 0)
    }
    b
}

fn cmap12(groups: []i64) -> []u8 {
    var b: []u8 = []
    io.put_be16(mut b, 0)
    io.put_be16(mut b, 1)
    io.put_be16(mut b, 3)
    io.put_be16(mut b, 10)
    io.put_be32(mut b, 12)
    io.put_be16(mut b, 12)
    io.put_be16(mut b, 0)
    io.put_be32(mut b, 16 + 4 * groups.len)
    io.put_be32(mut b, 0)
    io.put_be32(mut b, groups.len / 3)
    for v in groups {
        io.put_be32(mut b, v)
    }
    b
}

fn hex_digit(c: i64) -> i64 {
    if c >= 65 {
        c - 55
    } else {
        c - 48
    }
}

fn put_number(mut out: []u8, v: i64) {
    if v >= -107 && v <= 107 {
        out.push(u8(v + 139))
    } else if v >= 108 && v <= 1131 {
        let w = v - 108
        out.push(u8(247 + w / 256))
        out.push(u8(w % 256))
    } else if v >= -1131 && v <= -108 {
        let w = -v - 108
        out.push(u8(251 + w / 256))
        out.push(u8(w % 256))
    } else {
        out.push(28)
        io.put_be16(mut out, v & 65535)
    }
}

fn parse_number(word: str) -> i64 {
    var v = 0
    var negative = false
    for i in 0..word.len {
        let c = i64(word[i])
        if c == 45 {
            negative = true
        } else {
            v = v * 10 + c - 48
        }
    }
    if negative {
        -v
    } else {
        v
    }
}

fn put_operator(mut out: []u8, word: str) {
    match word {
        "hstem" => out.push(1)
        "vstem" => out.push(3)
        "vmoveto" => out.push(4)
        "rlineto" => out.push(5)
        "hlineto" => out.push(6)
        "vlineto" => out.push(7)
        "rrcurveto" => out.push(8)
        "callsubr" => out.push(10)
        "return" => out.push(11)
        "endchar" => out.push(14)
        "hstemhm" => out.push(18)
        "hintmask" => out.push(19)
        "cntrmask" => out.push(20)
        "rmoveto" => out.push(21)
        "hmoveto" => out.push(22)
        "vstemhm" => out.push(23)
        "rcurveline" => out.push(24)
        "rlinecurve" => out.push(25)
        "vvcurveto" => out.push(26)
        "hhcurveto" => out.push(27)
        "callgsubr" => out.push(29)
        "vhcurveto" => out.push(30)
        "hvcurveto" => out.push(31)
        "hflex" => {
            out.push(12)
            out.push(34)
        }
        "flex" => {
            out.push(12)
            out.push(35)
        }
        "hflex1" => {
            out.push(12)
            out.push(36)
        }
        "flex1" => {
            out.push(12)
            out.push(37)
        }
        _ => print("unknown operator {word}")
    }
}

fn put_word(mut out: []u8, word: str) {
    let first = i64(word[0])
    if first == 120 {
        out.push(u8(hex_digit(i64(word[1])) * 16 + hex_digit(i64(word[2]))))
    } else if first == 45 || (first >= 48 && first <= 57) {
        put_number(mut out, parse_number(word))
    } else {
        put_operator(mut out, word)
    }
}

fn asm(source: str) -> []u8 {
    var out: []u8 = []
    var start = 0
    for i in 0..source.len + 1 {
        if i == source.len || source[i] == 32 {
            if i > start {
                put_word(mut out, source[start..i])
            }
            start = i + 1
        }
    }
    out
}

fn index(size: i64, items: [][]u8) -> []u8 {
    var b: []u8 = []
    io.put_be16(mut b, items.len)
    if items.len == 0 {
        return b
    }
    b.push(u8(size))
    var at = 1
    put_offset(mut b, at, size)
    for item in items {
        at += item.len
        put_offset(mut b, at, size)
    }
    for item in items {
        for x in item {
            b.push(x)
        }
    }
    b
}

fn put_offset(mut b: []u8, v: i64, size: i64) {
    for k in 0..size {
        b.push(u8((v >> (8 * (size - 1 - k))) & 255))
    }
}

fn dict_int(mut b: []u8, v: i64) {
    b.push(29)
    io.put_be32(mut b, v)
}

fn top_dict(cid: bool, charstrings: i64, second: i64, third: i64) -> []u8 {
    var b = asm("x1E x0A x00 x1F")
    b.push(12)
    b.push(7)
    dict_int(mut b, charstrings)
    b.push(17)
    if cid {
        dict_int(mut b, second)
        b.push(12)
        b.push(36)
        dict_int(mut b, third)
        b.push(12)
        b.push(37)
    } else {
        dict_int(mut b, 10)
        dict_int(mut b, second)
        b.push(18)
    }
    b
}

fn private_dict() -> []u8 {
    var b = asm("1500")
    b.push(21)
    dict_int(mut b, 10)
    b.push(19)
    b
}

fn font_dict(at: i64) -> []u8 {
    var b: []u8 = []
    dict_int(mut b, 10)
    dict_int(mut b, at)
    b.push(18)
    b
}

fn append(mut b: []u8, more: []u8) {
    for x in more {
        b.push(x)
    }
}

fn charstrings() -> [][]u8 {
    [
        asm("endchar")
        asm("100 0 100 hstemhm 200 100 hintmask xC0 100 0 rmoveto -107 callsubr 100 -300 rmoveto -107 callgsubr endchar")
        asm("300 100 rmoveto 110 90 90 110 110 -90 90 -110 -110 -90 -90 -110 -110 90 -90 110 hvcurveto endchar")
        asm("450 10 hmoveto 20 0 10 10 0 20 rrcurveto 10 20 30 5 40 10 20 0 30 hhcurveto -10 20 -5 30 40 vvcurveto -20 -15 -10 -20 -10 hvcurveto -20 -15 -10 -30 -10 -20 -10 -20 -30 vhcurveto -10 10 -10 0 -10 -10 5 -15 rcurveline 10 -10 20 0 20 10 20 20 rlinecurve endchar")
        asm("0 10 20 10 hstem 0 10 20 10 40 10 vstemhm 0 10 20 10 30 10 40 10 50 10 vstem cntrmask x15 x0E hintmask x0E x15 10 0 rmoveto 20 0 10 10 0 20 30 0 20 5 10 10 50 flex -45 vmoveto 20 10 10 20 20 10 20 hflex 20 hmoveto 10 5 10 10 20 20 10 -5 10 hflex1 30 vmoveto 10 5 10 5 10 5 10 5 10 5 12 flex1 18 hmoveto 5 10 5 10 5 10 5 10 5 10 7 flex1 endchar")
        asm("10 10 rmoveto 20 0 rlineto -106 callsubr endchar")
        asm("100 0 rmoveto -107 callsubr endchar")
        []
        asm("x00")
        asm("xFF x00 x0A x80 x00 hmoveto 1500 0 rlineto -750 1200 rlineto endchar")
    ]
}

fn cff(cid: bool) -> []u8 {
    let name = index(1, [asm("x54 x65 x73 x74")])
    let top_length = top_dict(cid, 0, 0, 0).len
    let gsubrs = index(3, [asm("200 200 -200 vlineto return")])
    let strings = zeros(2)
    let glyphs = index(2, charstrings())
    let at_charstrings = 4 + name.len + 5 + top_length + strings.len + gsubrs.len
    let after_charstrings = at_charstrings + glyphs.len
    var tail: []u8 = []
    var top = top_dict(false, at_charstrings, after_charstrings, 0)
    if cid {
        let ranges = asm("x03 x00 x02 x00 x00 x00 x00 x06 x01 x00 x09")
        let at_first = after_charstrings + ranges.len
        var first = private_dict()
        append(mut first, index(1, [asm("400 400 -400 hlineto return"), asm("-106 callsubr")]))
        let at_second = at_first + first.len
        var second = private_dict()
        append(mut second, index(1, [asm("300 300 -300 hlineto return")]))
        let at_array = at_second + second.len
        append(mut tail, ranges)
        append(mut tail, first)
        append(mut tail, second)
        append(mut tail, index(1, [font_dict(at_first), font_dict(at_second)]))
        top = top_dict(true, at_charstrings, at_array, after_charstrings)
    } else {
        append(mut tail, private_dict())
        append(mut tail, index(1, [asm("400 400 -400 hlineto return"), asm("-106 callsubr")]))
    }
    var out = asm("x01 x00 x04 x01")
    append(mut out, name)
    append(mut out, index(1, [top]))
    append(mut out, strings)
    append(mut out, gsubrs)
    append(mut out, glyphs)
    append(mut out, tail)
    out
}

fn tables(table: Table, ascent: i64) -> []Table {
    [
        Table { tag: "head", data: head() }
        Table { tag: "hhea", data: hhea(ascent, 10) }
        Table { tag: "maxp", data: maxp(10) }
        Table { tag: "cmap", data: cmap12([32, 32, 7, 65, 73, 1]) }
        Table { tag: "hmtx", data: hmtx([500, 600, 700, 800, 900, 500, 500, 500, 500, 550]) }
        table
    ]
}

fn plain(cid: bool) -> []u8 {
    sfnt(tables(Table { tag: "CFF ", data: cff(cid) }, 800), 0)
}

fn collection() -> []u8 {
    let first = sfnt(tables(Table { tag: "CFF ", data: cff(false) }, 800), 20)
    let second = sfnt(tables(Table { tag: "CFF ", data: cff(true) }, 900), 20 + first.len)
    var out: []u8 = []
    for i in 0..4 {
        out.push("ttcf"[i])
    }
    io.put_be32(mut out, 65536)
    io.put_be32(mut out, 2)
    io.put_be32(mut out, 20)
    io.put_be32(mut out, 20 + first.len)
    append(mut out, first)
    append(mut out, second)
    out
}

fn open_font(data: []u8) -> font.Font {
    font.parse(str(data)) or font.Font {}
}

fn describe(data: str) -> str {
    let f = font.parse(data) catch {
        e => return "{e}"
    }
    "ok {f.glyph_count}"
}

fn describe_member(data: str, index: i64) -> str {
    let f = font.parse_collection(data, index) catch {
        e => return "{e}"
    }
    "ok {f.glyph_count} ascent {f.ascent} glyph A {f.glyph_index('A')} points {points(f.outline(1))}"
}

fn points(o: font.Outline) -> i64 {
    var n = 0
    for c in o.contours {
        n += c.points.len
    }
    n
}

fn mark(p: font.Point) -> str {
    if p.on_curve {
        "{p.x},{p.y}"
    } else {
        "{p.x},{p.y}~"
    }
}

fn dump(o: font.Outline) {
    for c in o.contours {
        var line = ""
        for p in c.points {
            line = line + "{mark(p)} "
        }
        print(line)
    }
}

fn shape(o: font.Outline) -> str {
    "{o.contours.len} contours {points(o)} points"
}

fn has(c: font.Contour, x: f32, y: f32) -> bool {
    for p in c.points {
        if p.on_curve && p.x == x && p.y == y {
            return true
        }
    }
    false
}

fn flex_summary(o: font.Outline, junctions: [][]f32) {
    for k, c in o.contours {
        let last = c.points[c.points.len - 1]
        print("flex {k}: first {mark(c.points[0])} last {mark(last)} junction {has(c, junctions[k][0], junctions[k][1])}")
    }
}

fn rows(b: font.Bitmap) {
    print("bitmap {b.width}x{b.height} at {b.left},{b.top}")
    for r in 0..b.height {
        var line = ""
        for c in 0..b.width {
            line = line + "{b.coverage[r * b.width + c],4}"
        }
        print(line)
    }
}

fn total(b: font.Bitmap) -> f64 {
    var sum = 0
    for v in b.coverage {
        sum += i64(v)
    }
    f64(sum) / 255.0
}

fn summary(f: font.Font) {
    print("em {f.units_per_em} ascent {f.ascent} descent {f.descent} glyphs {f.glyph_count}")
    print("index {f.glyph_index('A')} {f.glyph_index('D')} {f.glyph_index('I')} {f.glyph_index(' ')} {f.glyph_index('J')}")
    print("advance {f.advance(1)} {f.advance(2)} {f.advance(9)} {f.advance(10)}")
    for g in 0..10 {
        print("glyph {g}: {shape(f.outline(g))}")
    }
    print("past the end: {shape(f.outline(10))} {shape(f.outline(-1))}")
}

fn main() {
    let f = open_font(plain(false))
    summary(f)

    print("glyph 1 points")
    dump(f.outline(1))
    print("glyph 3 points")
    dump(f.outline(3))
    print("glyph 4 points")
    flex_summary(f.outline(4), [[40.0, 30.0], [150.0, 10.0], [260.0, 15.0], [330.0, 45.0], [395.0, 60.0]])
    print("glyph 6 points")
    dump(f.outline(6))
    print("glyph 9 points")
    dump(f.outline(9))

    rows(f.rasterize(1, 10.0))
    let ring = f.rasterize(2, 10.0)
    print("circle {points(f.outline(2))} points")
    rows(ring)
    print("circle area {total(ring) > 12.1 && total(ring) < 12.6}")
    print("empty {f.rasterize(5, 10.0).width} {f.rasterize(7, 10.0).width} {f.rasterize(8, 10.0).width}")

    let cid = open_font(plain(true))
    print("cid")
    summary(cid)
    print("cid glyph 1")
    dump(cid.outline(1))
    print("cid glyph 6")
    dump(cid.outline(6))
    print("cid glyph 6 coverage {total(cid.rasterize(6, 10.0))} against {total(f.rasterize(6, 10.0))}")

    let pair = collection()
    print(describe_member(str(pair), 0))
    print(describe_member(str(pair), 1))
    print(describe_member(str(pair), 2))
    print(describe_member(str(pair), -1))
    print(describe_member(str(plain(false)), 0))
    print(describe_member("ttcf", 0))
    print(describe_member(str(pair[0..14]), 0))
    print(describe_member(str(pair[0..19]), 0))
    print(describe(str(pair)))
    print(describe(str(plain(false))))
    print(describe(str(plain(true))))

    var cff2 = tables(Table { tag: "CFF2", data: zeros(8) }, 800)
    print(describe(str(sfnt(cff2, 0))))
    var broken = tables(Table { tag: "CFF ", data: zeros(8) }, 800)
    print(describe(str(sfnt(broken, 0))))
    var cut = tables(Table { tag: "CFF ", data: cff(false)[0..40] }, 800)
    print(describe(str(sfnt(cut, 0))))
    var unrelated = tables(Table { tag: "zzzz", data: zeros(8) }, 800)
    print(describe(str(sfnt(unrelated, 0))))
    var versioned = cff(false)
    versioned[0] = 2
    print(describe(str(sfnt(tables(Table { tag: "CFF ", data: versioned }, 800), 0))))
}
