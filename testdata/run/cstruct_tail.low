extern "c" {
    fn malloc(n: i64) -> ptr
    fn free(p: ptr)
}

struct Block[T] {
    data: ptr[T]
    drop free(data)
}

extern struct Offset {
    x: i32 = 0
    y: i32 = 0
    z: i32 = 0
}

extern struct Extent {
    w: u32 = 0
    h: u32 = 0
    d: u32 = 0
}

extern struct Copy {
    offset: Offset = Offset {}
    extent: Extent = Extent {}
}

extern struct Tiny {
    a: u8 = 0
    b: u16 = 0
    c: u8 = 0
}

fn main() {
    let copy = Copy { extent: Extent { w: 64, h: 32, d: 1 } }
    print("{copy.extent.w} {copy.extent.h} {copy.extent.d}")

    var local = Copy { offset: Offset { x: 1, y: 2, z: 3 }, extent: Extent { w: 4, h: 5, d: 6 } }
    local.offset = Offset { x: -1, y: -2, z: -3 }
    print("{local.offset.z} {local.extent.w}")

    using block = Block[Offset] { data: malloc(36) }
    let memory = block.data
    let row = view(memory, 3)
    row[0] = Offset { x: 1, y: 1, z: 1 }
    row[1] = Offset { x: 2, y: 2, z: 2 }
    row[2] = Offset { x: 3, y: 3, z: 3 }
    row[1] = Offset { x: 9, y: 9, z: 9 }
    print("{row[0].z} {row[1].x} {row[2].x}")
    store(memory, Offset { x: 7, y: 7, z: 7 })
    print("{row[0].x} {row[1].x}")

    using tiny_block = Block[Tiny] { data: malloc(18) }
    let tiny = view(tiny_block.data, 3)
    tiny[0] = Tiny { a: 1, b: 2, c: 3 }
    tiny[1] = Tiny { a: 4, b: 5, c: 6 }
    tiny[2] = Tiny { a: 7, b: 8, c: 9 }
    tiny[1] = Tiny { a: 40, b: 50, c: 60 }
    print("{tiny[0].c} {tiny[1].b} {tiny[2].a}")
}
