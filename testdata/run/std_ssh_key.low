import std/crypto/x509
import std/file
import std/ssh/key
import std/text

const vectors = "testdata/ssh"

fn read(name: str) -> str {
    file.read_text("{vectors}/{name}") or panic("read {name}")
}

fn public_of_file(name: str) -> key.PublicKey {
    let parsed = key.parse_line(read("{name}.pub")) or panic("parse {name}.pub")
    parsed.key
}

fn failure_name(e: key.Error) -> str {
    match e {
        Malformed => "Malformed"
        Unsupported => "Unsupported"
        Invalid => "Invalid"
        Encrypted => "Encrypted"
        WrongPassphrase => "WrongPassphrase"
        Io(_) => "Io"
        Untrusted => "Untrusted"
        Expired => "Expired"
        Principal => "Principal"
    }
}

fn line_failure(line: str) -> str {
    let parsed = key.parse_line(line) catch {
        e => return failure_name(e)
    }
    "accepted"
}

fn load_failure(path: str, passphrase: str) -> str {
    let private = key.load_private_key(path, passphrase) catch {
        e => return failure_name(e)
    }
    "accepted"
}

fn parse_failure(data: str) -> str {
    let private = key.parse_private_key(bytes(data), "") catch {
        e => return failure_name(e)
    }
    "accepted"
}

fn material_name(m: key.Material) -> str {
    match m {
        Ed25519(public) => "ed25519 {public.len}"
        Ecdsa(curve, point) => "ecdsa {point.len}"
        Rsa(k) => "rsa"
    }
}

fn fingerprints() {
    for name in ["ed25519", "ecdsa256", "ecdsa384", "rsa2048", "ed25519_encrypted", "rsa_encrypted", "ca", "host"] {
        let k = public_of_file(name)
        let reported = text.fields(read("{name}.fingerprint"))[1]
        print("fingerprint {name}: {key.fingerprint(k) == reported} {k.kind} {material_name(k.material)}")
    }
}

fn lines() {
    for name in ["ed25519", "ecdsa256", "ecdsa384", "rsa2048"] {
        let line = read("{name}.pub")
        let parsed = key.parse_line(line) or panic("parse")
        let again = key.parse_blob(parsed.key.blob) or panic("blob")
        print("line {name}: {key.format_line(parsed.key, parsed.comment) == text.trim(line)} {key.equal(parsed.key, again)} {parsed.comment}")
    }
    let a = public_of_file("ed25519")
    let b = public_of_file("ecdsa256")
    print("equal across kinds: {key.equal(a, b)}")
    for bad in ["", "ssh-ed25519", "ssh-ed25519 !!!!", "ssh-dss AAAA", "ssh-ed25519 AAAA"] {
        print("bad line {bad.len}: {line_failure(bad)}")
    }
}

fn kinds() {
    print("certificate kind: {key.is_certificate_kind("ssh-ed25519-cert-v01@openssh.com")} {key.is_certificate_kind("ssh-ed25519")}")
    print("base kind: {key.base_kind("ssh-ed25519-cert-v01@openssh.com")} {key.base_kind("ecdsa-sha2-nistp256")}")
    print("kind of material: {key.kind_of(public_of_file("rsa2048").material)} {key.kind_of(public_of_file("ecdsa384").material)}")
}

fn signing() {
    let cases = [
        ["ed25519", "ssh-ed25519"]
        ["ecdsa256", "ecdsa-sha2-nistp256"]
        ["ecdsa384", "ecdsa-sha2-nistp384"]
        ["rsa2048", "rsa-sha2-256"]
        ["rsa2048", "rsa-sha2-512"]
        ["rsa_pem", "rsa-sha2-256"]
        ["ecdsa_pem", "ecdsa-sha2-nistp256"]
    ]
    for c in cases {
        let private = key.load_private_key("{vectors}/{c[0]}", "") or panic("load {c[0]}")
        let public = public_of_file(c[0])
        let derived = key.public_of(private) or panic("public_of")
        let data = bytes("signed by {c[0]}")
        let blob = key.sign(private, c[1], data) or panic("sign")
        let good = key.verify(public, c[1], data, blob)
        let forged = key.verify(public, c[1], bytes("other"), blob)
        print("sign {c[0]} {c[1]}: matches {key.equal(derived, public)} verifies {good} other {forged}")
    }
    let signer = key.signer(key.load_private_key("{vectors}/rsa2048", "") or panic("load")) or panic("signer")
    let algorithms = key.signature_algorithms(signer.public.material)
    print("rsa algorithms: {text.join(algorithms, ",")}")
    print("ed25519 algorithms: {text.join(key.signature_algorithms(public_of_file("ed25519").material), ",")}")
    let viaSigner = signer.sign("rsa-sha2-512", bytes("x")) or panic("signer sign")
    print("signer verifies: {key.verify(signer.public, "rsa-sha2-512", bytes("x"), viaSigner)}")
}

fn encrypted() {
    for name in ["ed25519_encrypted", "rsa_encrypted"] {
        let private = key.load_private_key("{vectors}/{name}", "correct horse") or panic("load {name}")
        let public = public_of_file(name)
        let derived = key.public_of(private) or panic("public_of")
        print("encrypted {name}: {key.equal(derived, public)}")
        print("encrypted {name} wrong passphrase: {load_failure("{vectors}/{name}", "wrong")}")
        print("encrypted {name} without passphrase: {load_failure("{vectors}/{name}", "")}")
    }
}

fn parsing_private() {
    let text_form = read("ed25519")
    let private = key.parse_private_key(bytes(text_form), "") or panic("parse")
    let derived = key.public_of(private) or panic("public_of")
    print("parse private: {key.equal(derived, public_of_file("ed25519"))}")
    print("missing file: {load_failure("{vectors}/absent", "")}")
    print("garbage: {parse_failure("not a key")}")
}

fn certificate_failure(k: key.PublicKey, authorities: key.PublicKey[], principal: str, cert_type: i64, now: i64) -> str {
    key.check_certificate(k, authorities, principal, cert_type, now) catch {
        e => return failure_name(e)
    }
    "ok"
}

fn mismatch_failure(private: x509.PrivateKey, certificate: key.PublicKey) -> str {
    let signer = key.certified_signer(private, certificate) catch {
        e => return failure_name(e)
    }
    "accepted"
}

fn certificates() {
    let k = public_of_file("ed25519-cert")
    let ca = public_of_file("ca")
    let c = match k.certificate {
        some(found) => found
        none => panic("no certificate")
    }
    print("certificate: {c.key_id} serial {c.serial} type {c.cert_type} principals {text.join(c.principals, ",")}")
    print("window: {c.valid_after} {c.valid_before} options {c.critical_options.len} {c.critical_options[0].name} extensions {c.extensions.len}")
    print("signed by ca: {key.certificate_signed_by(k, ca)} by other: {key.certificate_signed_by(k, public_of_file("ed25519"))}")
    let now = 1800000000
    print("check valid: {certificate_failure(k, [ca], "alice", key.user_certificate, now)}")
    print("check principal: {certificate_failure(k, [ca], "carol", key.user_certificate, now)}")
    print("check type: {certificate_failure(k, [ca], "alice", key.host_certificate, now)}")
    print("check authority: {certificate_failure(k, [public_of_file("host")], "alice", key.user_certificate, now)}")
    print("check early: {certificate_failure(k, [ca], "alice", key.user_certificate, 1700000000)}")
    print("check late: {certificate_failure(k, [ca], "alice", key.user_certificate, 2200000000)}")
    let rsa = public_of_file("rsa2048-cert")
    print("rsa certificate: {key.certificate_signed_by(rsa, ca)} {rsa.kind}")
    let expired = public_of_file("ecdsa256_expired-cert")
    print("expired: {certificate_failure(expired, [ca], "alice", key.user_certificate, now)}")
    let host = public_of_file("host-cert")
    print("host certificate: {certificate_failure(host, [ca], "example.test", key.host_certificate, now)} {host.kind}")
    let parsed = key.parse_certificate(k.blob) or panic("parse_certificate")
    print("parse_certificate: {key.equal(parsed, k)}")
    let private = key.load_private_key("{vectors}/ed25519", "") or panic("load")
    let certified = key.certified_signer(private, k) or panic("certified_signer")
    let blob = certified.sign("ssh-ed25519", bytes("data")) or panic("sign")
    print("certified signer: {certified.public.kind} {key.verify(k, "ssh-ed25519", bytes("data"), blob)}")
    let other = key.load_private_key("{vectors}/ecdsa256", "") or panic("load")
    print("mismatched certified signer: {mismatch_failure(other, k)}")
}

fn names() {
    let k = public_of_file("rsa2048")
    print("offered: {key.offered_name(k, "rsa-sha2-256")} {key.signature_name("rsa-sha2-256")}")
    let cert = public_of_file("rsa2048-cert")
    print("offered certificate: {key.offered_name(cert, "rsa-sha2-512")} {key.signature_name("rsa-sha2-512-cert-v01@openssh.com")}")
    print("public_key: {key.public_key(k.material).kind}")
}

fn main() {
    fingerprints()
    lines()
    kinds()
    signing()
    encrypted()
    parsing_private()
    certificates()
    names()
}
