struct Point {
    x: i64
    y: i64
}

fn first(xs: []str) -> str? {
    xs[0] when xs.len > 0
}

fn positive(n: i64) -> i64? {
    return n when n > 0
}

fn narrow(n: i64) -> u8? {
    200 when n > 0
}

fn chained(xs: []i64, n: i64) -> i64? {
    positive(xs[0]) when xs.len > 0 && n > 0
}

fn origin(p: Point) -> Point? {
    Point { x: p.x, y: p.y } when p.x + p.y != 0
}

fn loud(label: str, n: i64) -> i64 {
    print("evaluated {label}")
    n
}

fn when(n: i64) -> i64 {
    n + 1
}

fn show(label: str, n: i64?) {
    match n {
        some(v) => print("{label}: {v}")
        none => print("{label}: none")
    }
}

fn main() {
    print(first(["a", "b"]) ?? "empty")
    print(first([]) ?? "empty")
    show("positive", positive(3))
    show("negative", positive(-3))
    show("narrow", i64(narrow(1) ?? 0) when true)
    show("chained", chained([4], 1))
    show("chained inner none", chained([-4], 1))
    show("chained outer none", chained([4], 0))
    show("point", (origin(Point { x: 1, y: 2 }) ?? Point { x: 0, y: 0 }).y when true)
    show("no point", origin(Point { x: 0, y: 0 }) |> fn(p: Point?) -> i64? { 1 when false })

    let inferred = 1 + 2 when first([]) ?? "" == ""
    show("inferred", inferred)
    show("skipped", loud("value", 1) when loud("condition", 0) == 1)
    show("taken", loud("value", 2) when loud("condition", 1) == 1)
    show("fallback", (5 when false) ?? 6)

    show("piped", 3 |> when() when true)
    let when = when(1)
    show("identifier", when when when == 2)
    let pick = fn(n: i64) n * 2 when n > 1
    show("closure", pick(2))
    show("closure none", pick(1))
    show("arm", match positive(7) {
        some(v) => v when v > 5
        none => none
    })
}
