struct Node {
    next: *Node?
    weight: i64
    label: str
}

fn churn(round: i64) -> i64 {
    var total = 0
    for i in 0..64 {
        var buf: []i64 = []
        for j in 0..600 {
            push(mut buf, round * 100 + i * j)
        }
        total += buf[599] % 1000
    }
    total
}

fn scalars(n: i64, scale: i64) -> i64 {
    var xs: []i64 = []
    var a = 1
    var b = 2
    var c = 3
    var d = 4
    var e = 5
    var f = 6
    var g = 7
    var flag = true
    var ratio = 0.5
    for i in 0..n {
        push(mut xs, a + b * 2 + c * 3 + d * 5 + e * 7 + f * 11 + g * 13 + i)
        a = (a * 3 + i) % 1009
        b = (b + a * scale) % 1013
        c = (c ^ b) + 1
        d = d + c % 17
        e = (e * 5 + d) % 1019
        f = f + e % 19
        g = (g + f) % 1021
        flag = !flag
        if flag {
            ratio = ratio * 1.0001 + 0.25
        } else {
            ratio = ratio - 0.125
        }
    }
    var sum = 0
    for x in xs {
        sum = (sum + x) % 1000000007
    }
    sum + i64(ratio) + (if flag { 1 } else { 0 }) + a + b + c + d + e + f + g
}

fn pointers(n: i64) -> i64 {
    var head: *Node? = none
    var names: []str = []
    var keep: [][]i64 = []
    for i in 0..n {
        let node = new(Node { next: head, weight: i * 3, label: "node" })
        head = some(node)
        push(mut names, "item")
        var copy: []i64 = []
        for j in 0..(i % 7 + 1) {
            push(mut copy, i + j)
        }
        push(mut keep, copy)
        if i % 50 == 0 {
            churn(i)
        }
    }
    var sum = 0
    var cur = head
    for {
        match cur {
            some(node) => {
                sum = (sum + node.weight) % 1000000007
                cur = node.next
            }
            none => break
        }
    }
    for inner in keep {
        for v in inner {
            sum = (sum + v) % 1000000007
        }
    }
    sum + names.len
}

fn strings(n: i64) -> i64 {
    var parts: []str = []
    var total = 0
    for i in 0..n {
        push(mut parts, "{i}-{i * 2}")
        if i % 97 == 0 {
            total += churn(i)
        }
    }
    for p in parts {
        total += p.len
    }
    total
}

fn main() {
    print(scalars(5000, 7))
    print(scalars(3, 11))
    print(pointers(2000))
    print(strings(3000))
}
