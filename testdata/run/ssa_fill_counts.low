struct Point {
    x: i64
    y: i64
}

struct Node {
    id: i64
}

fn zeros(from: i64, to: i64) -> []i64 {
    var xs: []i64 = []
    for i in from..to {
        push(mut xs, 0)
    }
    xs
}

fn sevens(n: i64) -> []i64 {
    var xs: []i64 = []
    for i in 0..n {
        push(mut xs, 7)
    }
    xs
}

fn total(xs: []i64) -> i64 {
    var t = 0
    for x in xs {
        t += x
    }
    t
}

fn describe(name: str, xs: []i64) {
    print("{name}: len {xs.len} sum {total(xs)}")
}

fn after_existing() -> []i64 {
    var xs = [1, 2, 3]
    for i in 0..4 {
        push(mut xs, 0)
    }
    xs
}

fn after_pushes() -> []i64 {
    var xs: []i64 = []
    for i in 0..5 {
        push(mut xs, i + 1)
    }
    for i in 0..3 {
        push(mut xs, 0)
    }
    for i in 0..40 {
        push(mut xs, 2)
    }
    xs
}

fn offset_start(n: i64) -> []i64 {
    var xs: []i64 = []
    for i in 5..n {
        push(mut xs, 3)
    }
    xs
}

fn floats(n: i64) -> []f64 {
    var xs: []f64 = []
    for i in 0..n {
        push(mut xs, 1.5)
    }
    for i in 0..n {
        push(mut xs, 0.0)
    }
    xs
}

fn flags(n: i64) -> []bool {
    var xs: []bool = []
    for i in 0..n {
        push(mut xs, true)
    }
    for i in 0..n {
        push(mut xs, false)
    }
    xs
}

fn bytes_of(n: i64) -> []u8 {
    var xs: []u8 = []
    for i in 0..n {
        push(mut xs, u8(255))
    }
    for i in 0..n {
        push(mut xs, u8(0))
    }
    xs
}

fn points(n: i64, at: Point) -> []Point {
    var xs: []Point = []
    for i in 0..n {
        push(mut xs, at)
    }
    xs
}

fn nodes(n: i64) -> []*Node {
    var xs: []*Node = []
    let shared = new(Node { id: 42 })
    for i in 0..n {
        push(mut xs, shared)
    }
    xs
}

fn captured_value(n: i64, base: i64) -> []i64 {
    var xs: []i64 = []
    for i in 0..n {
        push(mut xs, base * 2 + 1)
    }
    xs
}

fn narrow_range() -> []i64 {
    var xs: []i64 = []
    for i in u8(10)..u8(250) {
        push(mut xs, 1)
    }
    xs
}

fn main() {
    describe("zero count", zeros(0, 0))
    describe("negative count", zeros(0, -5))
    describe("reversed", zeros(9, 3))
    describe("one", zeros(0, 1))
    describe("negative start", zeros(-3, 4))
    describe("large", zeros(0, 5000000))
    describe("sevens zero", sevens(0))
    describe("sevens negative", sevens(-2))
    describe("sevens one", sevens(1))
    describe("sevens large", sevens(1000000))
    describe("after existing", after_existing())
    describe("after pushes", after_pushes())
    describe("offset start", offset_start(12))
    describe("offset start empty", offset_start(5))
    describe("captured value", captured_value(9, 4))
    describe("narrow range", narrow_range())
    let fs = floats(6)
    print("floats: len {fs.len} first {fs[0]} last {fs[11]}")
    let bs = flags(4)
    print("flags: len {bs.len} first {bs[0]} last {bs[7]}")
    let ys = bytes_of(5)
    print("bytes: len {ys.len} first {ys[0]} last {ys[9]}")
    let ps = points(3, Point { x: 4, y: 5 })
    print("points: len {ps.len} last {ps[2].x},{ps[2].y}")
    let ns = nodes(4)
    print("nodes: len {ns.len} ids {ns[0].id} {ns[3].id}")
    var xs = zeros(0, 100)
    xs[99] = 5
    xs[0] = 1
    print("write after fill: {total(xs)}")
}
