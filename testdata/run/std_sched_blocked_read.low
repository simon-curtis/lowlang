import std/file

enum List {
    Cons(i64, *List)
    Nil
}

fn build(n: i64) -> List {
    var list = List.Nil
    var i = 0
    for i < n {
        i += 1
        list = Cons(i, new(list))
    }
    list
}

fn head(l: List) -> i64 {
    match l {
        Cons(v, rest) => v
        Nil => 0
    }
}

fn churn(rounds: i64, out: chan[i64]) {
    var total = 0
    for r in 0..rounds {
        total += head(build(2000))
    }
    out <- total
}

fn reader(done: chan[i64]) {
    using f = file.open("/dev/stdin") or {
        done <- -1
        return
    }
    var buf: []u8 = []
    for i in 0..16 {
        push(mut buf, 0)
    }
    let n = file.read(f, buf) or -2
    done <- n
}

fn main() {
    let done = chan[i64]()
    let results = chan[i64](5)
    spawn reader(done)
    sleep(20)
    for w in 0..4 {
        spawn churn(500, results)
    }
    churn(1500, results)
    var total = 0
    for w in 0..5 {
        total += (<-results) ?? 0
    }
    print("allocated {total}")
    print("reader {(<-done) ?? -3}")
}
