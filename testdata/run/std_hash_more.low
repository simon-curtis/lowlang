import checksum = std/hash
import std/text

fn hex32(v: u32) -> str {
    var b: []u8 = []
    for i in 0..4 {
        push(mut b, u8(v >> u32(24 - 8 * i)))
    }
    text.encode_hex(b)
}

fn hex64(v: u64) -> str {
    var b: []u8 = []
    for i in 0..8 {
        push(mut b, u8(v >> u64(56 - 8 * i)))
    }
    text.encode_hex(b)
}

fn hex128(h: checksum.Hash128) -> str {
    text.encode_hex(checksum.hash128_bytes(h))
}

fn sequence(n: i64) -> []u8 {
    var out: []u8 = []
    for i in 0..n {
        push(mut out, u8(i))
    }
    out
}

fn filled(n: i64) -> []u8 {
    var out: []u8 = []
    for i in 0..n {
        push(mut out, u8(i * 7 + 3))
    }
    out
}

fn lengths() -> []i64 {
    [0, 1, 2, 3, 4, 5, 7, 8, 9, 15, 16, 17, 31, 32, 33, 48, 49, 63, 64, 65, 100, 199]
}

fn chunked(data: []u8, step: i64, feed: fn([]u8)) {
    var at = 0
    for at < data.len {
        let end = if at + step < data.len { at + step } else { data.len }
        feed(data[at..end])
        at = end
    }
}

fn fnv_section() {
    print("-- fnv")
    for word in ["", "a", "foobar", "hello world"] {
        let data = bytes(word)
        print("{hex32(checksum.fnv1_32(data))} {hex32(checksum.fnv1a_32(data))} {hex64(checksum.fnv1_64(data))} {hex64(checksum.fnv1a_64(data))}")
    }
    print("-- data len fnv1_32 fnv1a_32 fnv1_64 fnv1a_64")
    for n in lengths() {
        let data = filled(n)
        print("{n} {hex32(checksum.fnv1_32(data))} {hex32(checksum.fnv1a_32(data))} {hex64(checksum.fnv1_64(data))} {hex64(checksum.fnv1a_64(data))}")
    }
}

fn sip_section() ! checksum.Error {
    let key = sequence(16)
    print("-- paper siphash24 vectors (n=0,1,15)")
    for n in [0, 1, 15] {
        print("{n} {hex64(checksum.siphash24(key, sequence(n))?)}")
    }
    print("-- sip24 sip13 sip24_128 sip13_128")
    for n in lengths() {
        let data = filled(n)
        let a = checksum.siphash24(key, data)?
        let b = checksum.siphash13(key, data)?
        let c = checksum.siphash24_128(key, data)?
        let d = checksum.siphash13_128(key, data)?
        print("{n} {hex64(a)} {hex64(b)} {hex128(c)} {hex128(d)}")
    }
}

fn murmur_section() {
    print("-- murmur32(seed 0, 0x9747b28c) murmur128(seed 0, 42)")
    for n in lengths() {
        let data = filled(n)
        let a = checksum.murmur3_128(data, 0)
        let b = checksum.murmur3_128(data, 42)
        print("{n} {hex32(checksum.murmur3_32(data, 0))} {hex32(checksum.murmur3_32(data, 0x9747B28C))} {hex128(a)} {hex128(b)}")
    }
    print("-- murmur known")
    let t1 = hex32(checksum.murmur3_32(bytes(""), 1))
    let t2 = hex32(checksum.murmur3_32(bytes("test"), 0))
    let t3 = hex32(checksum.murmur3_32(bytes("Hello, world!"), 0x9747B28C))
    let t4 = hex32(checksum.murmur3_32(bytes("The quick brown fox jumps over the lazy dog"), 0x9747B28C))
    print("{t1} {t2} {t3} {t4}")
    print(hex128(checksum.murmur3_128(bytes("hello"), 0)))
}

fn wyhash_section() {
    print("-- wyhash official")
    var seed: u64 = 0
    let words = [
        "", "a", "abc", "message digest", "abcdefghijklmnopqrstuvwxyz",
        "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789",
        "12345678901234567890123456789012345678901234567890123456789012345678901234567890",
    ]
    for word in words {
        print(hex64(checksum.wyhash(bytes(word), seed)))
        seed += 1
    }
    print("-- wyhash data len seed0 seed12345")
    for n in lengths() {
        let data = filled(n)
        print("{n} {hex64(checksum.wyhash(data, 0))} {hex64(checksum.wyhash(data, 12345))}")
    }
}

fn jump_section() {
    print("-- jump")
    let keys: []u64 = [0, 1, 2, 42, 1000, 0xDEADBEEFCAFEBABE, 0xFFFFFFFFFFFFFFFF]
    for key in keys {
        var line = "{key}"
        for buckets in [1, 2, 10, 100, 1000] {
            line = "{line} {checksum.jump(key, buckets)}"
        }
        print(line)
    }
}

fn incremental_section() ! checksum.Error {
    print("-- incremental")
    let data = filled(199)
    let key = sequence(16)
    let sip_expected = checksum.siphash24(key, data)?
    let wide_expected = checksum.siphash13_128(key, data)?
    var agree = true
    for step in [1, 3, 5, 7, 13, 16, 17, 64, 100] {
        let f32 = checksum.fnv32a_new()
        chunked(data, step, fn(part) { checksum.fnv32_update(f32, part) })
        let f64 = checksum.fnv64_new()
        chunked(data, step, fn(part) { checksum.fnv64_update(f64, part) })
        let s24 = checksum.siphash24_new(key)?
        chunked(data, step, fn(part) { checksum.siphash_update(s24, part) })
        let s13w = checksum.siphash13_128_new(key)?
        chunked(data, step, fn(part) { checksum.siphash_update(s13w, part) })
        let m32 = checksum.murmur32_new(0x9747B28C)
        chunked(data, step, fn(part) { checksum.murmur32_update(m32, part) })
        let m128 = checksum.murmur128_new(42)
        chunked(data, step, fn(part) { checksum.murmur128_update(m128, part) })
        let results = [
            checksum.fnv32_sum(f32) == checksum.fnv1a_32(data),
            checksum.fnv64_sum(f64) == checksum.fnv1_64(data),
            checksum.siphash_sum(s24) == sip_expected,
            checksum.siphash_sum128(s13w) == wide_expected,
            checksum.murmur32_sum(m32) == checksum.murmur3_32(data, 0x9747B28C),
            checksum.murmur128_sum(m128) == checksum.murmur3_128(data, 42),
        ]
        for ok in results {
            if !ok {
                agree = false
            }
        }
    }
    print("chunked agrees with one-shot: {agree}")
    let short = checksum.siphash24(sequence(15), data) catch {
        BadKey => 1
    }
    print("short key rejected: {short == 1}")
}

fn rendezvous_section() {
    print("-- rendezvous")
    let nodes: []u64 = [11, 22, 33, 44, 55]
    let fewer: []u64 = [11, 22, 44, 55]
    var moved = 0
    var wrong = 0
    var counts: []i64 = [0, 0, 0, 0, 0]
    for key in 0..1000 {
        let before = checksum.rendezvous(u64(key), nodes) ?? -1
        let after = checksum.rendezvous(u64(key), fewer) ?? -1
        counts[before] += 1
        if before == 2 {
            moved += 1
        } else if nodes[before] != fewer[after] {
            wrong += 1
        }
    }
    print("keys on the removed node moved: {moved > 100}")
    print("other keys stayed: {wrong == 0}")
    print("every node used: {counts[0] > 100 && counts[1] > 100 && counts[2] > 100 && counts[3] > 100 && counts[4] > 100}")
    print("empty: {checksum.rendezvous(1, []) == none}")
    let names = ["alpha", "beta", "gamma", "delta"]
    let rest = ["alpha", "gamma", "delta"]
    var named_wrong = 0
    for key in ["a", "b", "c", "d", "e", "f", "g", "h", "i", "j", "k", "l"] {
        let before = checksum.rendezvous_str(key, names) ?? -1
        let after = checksum.rendezvous_str(key, rest) ?? -1
        if before != 1 && names[before] != rest[after] {
            named_wrong += 1
        }
    }
    print("named nodes stable: {named_wrong == 0}")
}

fn jump_balance() {
    var counts: []i64 = [0, 0, 0, 0]
    for key in 0..4000 {
        counts[checksum.jump(checksum.wyhash(bytes("key{key}"), 7), 4)] += 1
    }
    print("jump balanced: {counts[0] > 800 && counts[1] > 800 && counts[2] > 800 && counts[3] > 800}")
    var stays = 0
    for key in 0..4000 {
        let h = checksum.wyhash(bytes("key{key}"), 7)
        let small = checksum.jump(h, 4)
        let large = checksum.jump(h, 5)
        if large == small || large == 4 {
            stays += 1
        }
    }
    print("jump only moves to the new bucket: {stays == 4000}")
}

fn main() ! checksum.Error {
    fnv_section()
    sip_section()?
    murmur_section()
    wyhash_section()
    jump_section()
    incremental_section()?
    rendezvous_section()
    jump_balance()
}
