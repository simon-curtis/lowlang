extern struct Color {
    r: f32 = 0.0
    g: f32 = 0.0
    b: f32 = 0.0
    a: f32 = 0.0
}

struct Visual {
    background: Color = Color {}
    weight: i64 = 0
}

struct Element {
    visual: Visual = Visual {}
    name: str = ""
}

fn show(c: Color) -> str {
    "{c.r} {c.g} {c.b} {c.a}"
}

fn param(e: Element) -> str {
    "{e.visual.background.g} {e.visual.background.a}"
}

fn main() {
    let v = Visual { background: Color { r: 1.0, g: 2.0, b: 3.0, a: 4.0 }, weight: 7 }
    print("{v.background.r} {v.background.g} {v.background.b} {v.background.a} {v.weight}")

    var w = v
    w.background.g = 20.0
    w.background.a = 40.0
    print("{show(w.background)} {show(v.background)}")

    let e = Element { visual: v, name: "e" }
    print(param(e))
    let read = fn() -> f32 { e.visual.background.a }
    print(read())

    for x in [v, w] {
        print("{x.background.g} {x.background.a}")
    }
}
