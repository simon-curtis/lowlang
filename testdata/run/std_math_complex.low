import std/math
import std/math/complex
import std/text

fn num(x: f64) -> str {
    let s = text.fixed(x, 6)
    if s == "-0.000000" {
        return "0.000000"
    }
    s
}

fn show(z: complex.Complex) -> str {
    "{num(z.re)} {num(z.im)}"
}

fn z(re: f64, im: f64) -> complex.Complex {
    complex.complex(re, im)
}

fn arithmetic() {
    let pairs = [
        [z(3.0, 4.0), z(1.0, -2.0)],
        [z(1.5, -2.5), z(-0.5, 0.25)],
        [z(2.0, 3.0), z(0.001, 10.0)],
        [z(-7.0, 0.5), z(-3.0, -3.0)],
        [z(0.0, 0.0), z(2.0, 5.0)],
        [z(1.0, 1.0), z(0.0, 0.0)],
        [z(0.0, 0.0), z(0.0, 0.0)],
        [z(-4.0, 2.0), z(0.0, 0.0)],
    ]
    for p in pairs {
        let a = p[0]
        let b = p[1]
        print("{show(a)} {show(b)}")
        print("  add {show(complex.add(a, b))}")
        print("  sub {show(complex.sub(a, b))}")
        print("  mul {show(complex.mul(a, b))}")
        print("  div {show(complex.div(a, b))}")
    }
    let huge = z(1e300, 1e300)
    print("huge div {show(complex.div(huge, huge))}")
    print("huge div mixed {show(complex.div(z(1e300, 2e300), z(2e300, -1e300)))}")
    let tiny = z(1e-300, 1e-300)
    print("tiny div {show(complex.div(tiny, tiny))}")
    print("tiny div mixed {show(complex.div(z(3e-300, 1e-300), z(1e-300, 2e-300)))}")
    print("huge abs {num(complex.abs(z(1e200, 1e200)) / 1e200)}")
    print("tiny abs {num(complex.abs(z(3e-200, 4e-200)) / 1e-200)}")
}

fn unary() {
    let values = [z(3.0, 4.0), z(-1.0, 2.0), z(0.0, 0.0), z(1.5, -2.5), z(-2.0, -3.0), z(0.0, 1.0), z(2.0, 0.0), z(-4.0, 0.0), z(0.0, -1.0), z(-0.5, 0.75)]
    for v in values {
        print(show(v))
        print("  neg {show(complex.neg(v))}")
        print("  conj {show(complex.conj(v))}")
        print("  scale {show(complex.scale(v, -2.5))}")
        print("  abs {num(complex.abs(v))}")
        print("  arg {num(complex.arg(v))}")
        let p = complex.polar(v)
        print("  polar {num(p.radius)} {num(p.angle)}")
        print("  exp {show(complex.cexp(v))}")
        print("  sqrt {show(complex.csqrt(v))}")
    }
    for v in values {
        if v.re == 0.0 && v.im == 0.0 {
            let l = complex.clog(v)
            print("log zero {l.re} {num(l.im)}")
        } else {
            print("log {show(v)} {show(complex.clog(v))}")
        }
    }
}

fn branch_cuts() {
    print("arg negative axis {num(complex.arg(z(-1.0, 0.0)))}")
    print("arg below negative axis {num(complex.arg(z(-1.0, -0.0)))}")
    print("sqrt above axis {show(complex.csqrt(z(-4.0, 0.0)))}")
    print("sqrt below axis {show(complex.csqrt(z(-4.0, -0.0)))}")
    print("sqrt negative zero {show(complex.csqrt(z(0.0, -0.0)))}")
    print("sqrt large {show(complex.scale(complex.csqrt(z(1e300, 1e300)), 1e-150))}")
    print("sqrt small {show(complex.scale(complex.csqrt(z(3e-300, 4e-300)), 1e150))}")
    print("log negative axis {show(complex.clog(z(-2.0, 0.0)))}")
    print("log below axis {show(complex.clog(z(-2.0, -0.0)))}")
}

fn polar_rect() {
    let polars = [[2.0, math.pi / 3.0], [1.0, -math.pi], [0.0, 1.0], [3.5, 0.0], [5.0, 2.5], [0.25, -2.0]]
    for p in polars {
        let c = complex.rect(p[0], p[1])
        let back = complex.polar(c)
        print("rect {num(p[0])} {num(p[1])} {show(c)} polar {num(back.radius)} {num(back.angle)}")
    }
}

fn powers() {
    let pairs = [
        [z(1.0, 1.0), z(2.0, 0.0)],
        [z(1.0, 1.0), z(0.5, 0.0)],
        [z(2.0, 0.0), z(0.0, 1.0)],
        [z(-1.0, 0.0), z(0.5, 0.0)],
        [z(3.0, 4.0), z(1.0, -1.0)],
        [z(0.0, 0.0), z(2.0, 0.0)],
        [z(0.0, 0.0), z(0.0, 0.0)],
        [z(5.0, 2.0), z(0.0, 0.0)],
        [z(0.5, -0.25), z(-1.5, 0.75)],
    ]
    for p in pairs {
        print("pow {show(p[0])} {show(p[1])} {show(complex.cpow(p[0], p[1]))}")
    }
    for n in [0, 1, 2, 3, 5, 8, -1, -3, -6] {
        print("pow_int (1,1) {n} {show(complex.pow_int(z(1.0, 1.0), n))}")
    }
    for n in [4, -2, 7] {
        print("pow_int (2,-1) {n} {show(complex.pow_int(z(2.0, -1.0), n))}")
    }
    print("pow_int zero {show(complex.pow_int(z(0.0, 0.0), 3))}")
    print("pow_int unit {show(complex.pow_int(z(0.0, 1.0), 10))}")
}

fn formatting() {
    let inf = math.infinity
    let values = [z(1.5, 2.0), z(-3.0, -0.25), z(0.1, 0.2), z(0.0, 0.0), z(1.0, -0.0), z(math.nan, 1.0), z(1.0, math.nan), z(inf, -inf), z(123456.5, -0.001953125)]
    for v in values {
        print("format {complex.format(v)}")
    }
    print("fixed {complex.format_fixed(z(1.5, -2.25), 2)}")
    print("fixed {complex.format_fixed(z(1.0 / 3.0, 2.0 / 3.0), 4)}")
    print("fixed {complex.format_fixed(z(2.7, -3.2), 0)}")
    print("fixed {complex.format_fixed(z(2.7, -3.2), -3)}")
    print("fixed {complex.format_fixed(z(-0.0, -0.0), 1)}")
    print("fixed {complex.format_fixed(z(math.nan, inf), 2)}")
}

fn equality() {
    print(z(1.0, 2.0) == z(1.0, 2.0))
    print(z(1.0, 2.0) == z(1.0, 3.0))
    let sum = complex.add(z(0.5, 0.25), z(0.5, 0.75))
    print(sum == z(1.0, 1.0))
}

fn main() {
    arithmetic()
    unary()
    branch_cuts()
    polar_rect()
    powers()
    formatting()
    equality()
}
