import std/text
import std/yaml

fn kind(n: *yaml.Node) -> str {
    match n.value {
        Null => "null"
        Bool(b) => "bool {b}"
        Int(v) => "int {v}"
        Float(x) => "float {x}"
        Str(s) => "str {s.len} [{text.join(text.split(s, '\n'), "|")}]"
        Binary(data) => "binary {data.len}"
        Seq(items) => "seq {items.len}"
        Map(pairs) => "map {pairs.len}"
    }
}

fn dump(n: *yaml.Node, depth: i64) {
    var pad = ""
    for i in 0..depth {
        pad = "{pad}  "
    }
    let tag = if n.tag.len > 0 { " <{n.tag}>" } else { "" }
    let anchor = if n.anchor.len > 0 { " &{n.anchor}" } else { "" }
    print("{pad}{n.line}:{n.column} {kind(n)}{tag}{anchor}")
    match n.value {
        Seq(items) => {
            for item in items {
                dump(item, depth + 1)
            }
        }
        Map(pairs) => {
            for p in pairs {
                dump(p.key, depth + 1)
                dump(p.value, depth + 2)
            }
        }
        _ => {}
    }
}

fn report(source: str) {
    let docs = yaml.parse_all(source) catch {
        Syntax(line, column, message) => {
            print("error {line}:{column} {message}")
            return
        }
        TooManyNodes(line, column) => {
            print("too many nodes at {line}:{column}")
            return
        }
    }
    print("{docs.len} documents")
}

fn document() -> str {
    let lines = [
        "%YAML 1.2"
        "%TAG !e! tag:example.com,2000:"
        "--- # first"
        "plain: multi word"
        "  folded continuation"
        "single: 'it''s'"
        "double: \"tab\\there \\u00e9 \\x41\\N\""
        "literal: |"
        "  line one"
        "    indented"
        ""
        "folded: >-"
        "  folded"
        "  text"
        ""
        "  para"
        "keep: |+"
        "  kept"
        ""
        "explicit: |2"
        "    two extra"
        "anchored: &base {{a: 1, b: [x, y]}}"
        "again: *base"
        "? [complex, key]"
        ": !e!thing local"
        "tagged: !!str 42"
        "bin: !!binary aGVsbG8gd29ybGQ="
        "flow: [a: b, {{c: d}}, \"e\":f]"
        "..."
        "---"
        "- ~"
        "- -12"
        "- 0x1F"
        "- 0o17"
        "- +3.5e2"
        "- .inf"
        "- -.Inf"
        "- True"
        "- FALSE"
        "- 1_000"
        "- '7'"
    ]
    text.join(lines, "\n")
}

fn laughs(depth: i64) -> str {
    var out = "a0: &a0 [x, x, x, x, x, x, x, x, x, x]\n"
    for i in 1..depth {
        let j = i - 1
        out = "{out}a{i}: &a{i} [*a{j}, *a{j}, *a{j}, *a{j}, *a{j}, *a{j}, *a{j}, *a{j}, *a{j}, *a{j}]\n"
    }
    out
}

fn main() {
    let docs = yaml.parse_all(document()) catch {
        Syntax(line, column, message) => {
            print("error {line}:{column} {message}")
            return
        }
        TooManyNodes(line, column) => {
            print("too many nodes")
            return
        }
    }
    for d in docs {
        dump(d, 0)
    }
    let first = docs[0]
    print(yaml.text(yaml.get(first, "single") ?? first) ?? "missing")
    let again = yaml.get(first, "again") ?? first
    print(again == (yaml.get(first, "anchored") ?? first))
    print(yaml.integer(yaml.at(docs[1], 2) ?? first) ?? -1)
    print(yaml.float(yaml.at(docs[1], 1) ?? first) ?? 0.0)
    print(yaml.boolean(yaml.at(docs[1], 7) ?? first) ?? false)
    print(yaml.is_null(yaml.at(docs[1], 0) ?? first))

    let events = yaml.events("- &x [1, 'two']\n- *x\n") catch {
        _ => []
    }
    for e in events {
        print("{e.line}:{e.column} {e.kind == yaml.EventKind.Scalar} {e.value} {e.anchor}")
    }

    report("a: 1\nb: 2\n  c: 3\n")
    report("key: [1, 2\n")
    report("a: 'unterminated\n")
    report("- a\nb: c\n")
    report("x: *missing\n")
    report("a: 1\na: 2\n")
    report("\tkey: value\n")
    report("a: \"\\q\"\n")
    report("--- |0\n x\n")
    report("!!int nope\n")
    report("a: 1\n--- b\n...\n--- c\n")
    report(laughs(5))
    report(laughs(7))
    let small = yaml.parse_with(laughs(3), yaml.Options { max_nodes: 500 }) catch {
        TooManyNodes(line, column) => {
            print("budget {line}:{column}")
            yaml.node(yaml.Value.Null)
        }
        _ => yaml.node(yaml.Value.Null)
    }
    let deep = yaml.parse_with("[[[[[[x]]]]]]", yaml.Options { max_depth: 4 }) catch {
        Syntax(line, column, message) => {
            print("{line}:{column} {message}")
            yaml.node(yaml.Value.Null)
        }
        _ => yaml.node(yaml.Value.Null)
    }
}
