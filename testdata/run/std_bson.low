import std/bson
import std/text

fn hex(s: str) -> []u8 {
    text.decode_hex(s) catch {
        _ => []
    }
}

fn field(name: str, v: bson.Value) -> bson.Field {
    bson.Field { name, value: v }
}

fn sixteen() -> []u8 {
    hex("000102030405060708090a0b0c0d0e0f")
}

fn documents() -> [][]bson.Field {
    let empty: []bson.Field = []
    let hello = [field("hello", bson.Value.Str("world"))]
    let awesome = [
        field("BSON", bson.Value.Array([bson.Value.Str("awesome"), bson.Value.Double(5.05), bson.Value.Int32(1986)])),
    ]
    let numbers = [
        field("i32", bson.Value.Int32(-2)),
        field("i64", bson.Value.Int64(5000000000)),
        field("d", bson.Value.Double(-0.5)),
        field("max32", bson.Value.Int32(2147483647)),
        field("min32", bson.Value.Int32(-2147483648)),
        field("min64", bson.Value.Int64(-9223372036854775807 - 1)),
        field("inf", bson.Value.Double(1.0 / 0.0)),
    ]
    let misc = [
        field("t", bson.Value.Bool(true)),
        field("f", bson.Value.Bool(false)),
        field("n", bson.Value.Null),
        field("min", bson.Value.MinKey),
        field("max", bson.Value.MaxKey),
        field("ts", bson.Value.Timestamp(1099511627783)),
        field("re", bson.Value.Regex("^a.*b$", "i")),
    ]
    let binary = [
        field("b", bson.Value.Binary(0, [1, 2, 3])),
        field("u", bson.Value.Binary(4, sixteen())),
        field("e", bson.Value.Binary(128, [])),
        field("id", bson.Value.ObjectId(hex("507f1f77bcf86cd799439011"))),
        field("dt", bson.Value.DateTime(1700000000123)),
        field("neg", bson.Value.DateTime(-1)),
        field("dec", bson.Value.Decimal128(sixteen())),
    ]
    let inner = [
        field("x", bson.Value.Int32(1)),
        field("list", bson.Value.Array([
            bson.Value.Int32(1),
            bson.Value.Str("two"),
            bson.Value.Document([field("k", bson.Value.Null)]),
            bson.Value.Array([]),
        ])),
        field("empty", bson.Value.Document([])),
    ]
    let nested = [
        field("doc", bson.Value.Document(inner)),
        field("ünï", bson.Value.Str("çödé ✓ \"q\" \\ 😀")),
    ]
    [empty, hello, awesome, numbers, misc, binary, nested]
}

fn failure(e: bson.Error) -> str {
    "{bson.offset(e)} {bson.message(e)}"
}

fn round_trip() {
    for i, doc in documents() {
        let data = bson.encode(doc) catch {
            e => {
                print("{i} encode failed {failure(e)}")
                continue
            }
        }
        let h = text.encode_hex(data)
        print("{i} {h}")
        let back = bson.decode(data) catch {
            e => {
                print("{i} decode failed {failure(e)}")
                continue
            }
        }
        print(bson.diagnostic(back))
        let again = bson.encode(back) catch { _ => [] }
        print(text.encode_hex(again) == h)
    }
}

fn decoded(label: str, h: str) {
    let fields = bson.decode(hex(h)) catch {
        e => {
            print("{label}: {failure(e)}")
            return
        }
    }
    print("{label}: {bson.diagnostic(fields)}")
}

fn errors() {
    decoded("empty input", "")
    decoded("short size", "05")
    decoded("size under five", "04000000")
    decoded("bad terminator", "0500000001")
    decoded("empty document", "0500000000")
    decoded("trailing byte", "050000000000")
    decoded("declared past data", "0600000000")
    decoded("declared 255", "ff00000000")
    decoded("type zero", "060000000000")
    decoded("undefined type", "0800000006610000")
    decoded("bad bool", "090000000874000200")
    decoded("good bool", "090000000874000100")
    decoded("string without terminator", "0f00000002610003000000787a7900")
    decoded("empty string length", "0c0000000261000000000000")
    decoded("invalid utf-8 value", "0e00000002610002000000ff0000")
    decoded("invalid utf-8 name", "080000000aff0000")
    decoded("string past document end", "0b00000002610001000000" + "00")
    decoded("nested past parent", "0d0000000361006400000000" + "00")
    decoded("nested empty", "0d000000036100050000000000")
    decoded("int32 cut short", "0a000000106100010000")
    decoded("name swallows terminator", "08000000" + "0a" + "6162" + "00")
    decoded("object id cut short", "0b00000007610000112200")
    decoded("negative binary length", "0c000000056100ffffffff00")
    decoded("binary past document end", "0d0000000561000500000000" + "00")
    decoded("regex swallows terminator", "0a0000000b61007800" + "00")
    decoded("regex", "0c0000000b61007800690000")
    decoded("min and max", "0b0000007f6100ff620000")
}

fn limits() {
    let shallow = bson.Options { max_depth: 1 }
    let r = bson.decode_with(hex("0d000000036100050000000000"), shallow) catch {
        e => {
            print("depth 1: {failure(e)}")
            []
        }
    }
    let ok = bson.Options { max_depth: 2 }
    let w = bson.decode_with(hex("0d000000036100050000000000"), ok) catch {
        e => {
            print("depth 2: {failure(e)}")
            []
        }
    }
    print("depth 2 {bson.diagnostic(w)}")
    let tight = bson.Options { max_length: 12 }
    for h in ["0c0000001061000100000000", "0d000000036100050000000000"] {
        let t = bson.decode_with(hex(h), tight) catch {
            e => {
                print("{h} {failure(e)}")
                continue
            }
        }
        print("{h} {bson.diagnostic(t)}")
    }
}

fn streams() {
    let data = hex("0500000000" + "0c0000001061000100000000" + "0500000000")
    var at = 0
    for at < data.len {
        let item = bson.decode_first(data[at..], bson.Options {}) catch {
            e => {
                print("stream failed at {at + bson.offset(e)}")
                return
            }
        }
        print("document at {at} length {item.length} {bson.diagnostic(item.fields)}")
        at += item.length
    }
}

fn lookups() {
    let doc = documents()[1]
    match bson.get(doc, "hello") {
        some(v) => print(bson.diagnostic([field("hello", v)]))
        none => print("missing")
    }
    match bson.get(doc, "other") {
        some(v) => print("found")
        none => print("missing")
    }
}

fn object_ids() {
    let id = bson.parse_object_id("507f1f77bcf86cd799439011") catch { _ => bson.Value.Null }
    match id {
        ObjectId(bytes) => {
            print(bson.object_id_hex(bytes))
            print(bson.object_id_seconds(bytes))
        }
        _ => print("not an object id")
    }
    let short = bson.parse_object_id("507f1f77") catch {
        e => {
            print(bson.message(e))
            bson.Value.Null
        }
    }
    let bad = bson.parse_object_id("507f1f77bcf86cd79943901g") catch {
        e => {
            print(bson.message(e))
            bson.Value.Null
        }
    }
    let fresh = bson.new_object_id()
    match fresh {
        ObjectId(bytes) => {
            print(bytes.len)
            print(bson.object_id_seconds(bytes) > 1700000000)
        }
        _ => print("not an object id")
    }
}

fn encode_errors() {
    let cases = [
        [field("id", bson.Value.ObjectId([1, 2, 3]))],
        [field("d", bson.Value.Decimal128([1]))],
        [field("a{text.from_char(0)}b", bson.Value.Null)],
        [field("re", bson.Value.Regex("a{text.from_char(0)}", ""))],
        [field("nested", bson.Value.Array([bson.Value.Document([field("id", bson.Value.ObjectId([]))])]))],
    ]
    for c in cases {
        let data = bson.encode(c) catch {
            e => {
                print(bson.message(e))
                continue
            }
        }
        print(text.encode_hex(data))
    }
}

fn main() {
    round_trip()
    errors()
    limits()
    streams()
    lookups()
    object_ids()
    encode_errors()
}
