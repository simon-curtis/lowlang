fn left32(x: u32, k: u32) -> u32 {
    (x << k) | (x >> (32 - k))
}

fn rol7(x: u32) -> u32 {
    (x << 7) | (x >> 25)
}

fn rol7_swapped(x: u32) -> u32 {
    (x >> 25) | (x << 7)
}

fn ror13(x: u32) -> u32 {
    (x >> 13) | (x << 19)
}

fn rol1(x: u32) -> u32 {
    (x << 1) | (x >> 31)
}

fn rol31(x: u32) -> u32 {
    (x << 31) | (x >> 1)
}

fn rol13_64(x: u64) -> u64 {
    (x << 13) | (x >> 51)
}

fn ror19_64(x: u64) -> u64 {
    (x >> 19) | (x << 45)
}

fn ror32_64(x: u64) -> u64 {
    (x >> 32) | (x << 32)
}

fn gap32(x: u32) -> u32 {
    (x << 7) | (x >> 24)
}

fn overlap32(x: u32) -> u32 {
    (x << 7) | (x >> 26)
}

fn mixed(x: u32, y: u32) -> u32 {
    (x << 7) | (y >> 25)
}

fn shared(x: u32) -> u32 {
    let hi = x << 9
    let lo = x >> 23
    (hi | lo) + hi
}

fn signed32(x: i32) -> i32 {
    (x << 7) | (x >> 25)
}

fn wide_into_narrow(x: u64) -> u32 {
    u32((x << 7) | (x >> 57))
}

fn checksum(x: u32, y: u64) -> u64 {
    u64(rol7(x)) + u64(rol7_swapped(x)) * 3 + u64(ror13(x)) * 5 + u64(rol1(x)) * 7 + u64(rol31(x)) * 11 + rol13_64(y) * 13 + ror19_64(y) * 17 + ror32_64(y) * 19 + u64(gap32(x)) * 23 + u64(overlap32(x)) * 29 + u64(mixed(x, u32(y))) * 31 + u64(shared(x)) * 37 + u64(wide_into_narrow(y)) * 41
}

fn main() {
    let words: []u32 = [0, 1, 2, 255, 65535, 65536, 2147483647, 2147483648, 2147483649, 4294967294, 4294967295, 305419896, 2596069104]
    let longs: []u64 = [0, 1, 4294967295, 4294967296, 9223372036854775807, 9223372036854775808, 18446744073709551615, 1311768467463790320]
    for x in words {
        var line = 0
        for y in longs {
            line += i64(checksum(x, y) % 1000003)
        }
        print(line)
        print(i64(left32(x, 7)))
        print(i64(left32(x, 25)))
        print(i64(signed32(i32(x))))
    }
}
