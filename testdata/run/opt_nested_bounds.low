fn next(mut state: u64) -> u64 {
    state ^= state << 13
    state ^= state >> 7
    state ^= state << 17
    state
}

fn nested(s: []i64, t: []i64, i: i64, x: i64, y: i64, c: bool, d: i64) -> i64 {
    if d > 0 {
        return nested(s, t, i, x, y, c, d - 1)
    }
    if x <= s.len {
        if x <= t.len {
            if y <= s.len {
                if y <= t.len {
                    if i < x {
                        if i < y {
                            let a = if c { s } else { t }
                            return a[i]
                        }
                    }
                }
            }
        }
    }
    -1
}

fn swapped(s: []i64, t: []i64, i: i64, x: i64, y: i64, c: bool, d: i64) -> i64 {
    if d > 0 {
        return swapped(s, t, i, x, y, c, d - 1)
    }
    if y <= s.len {
        if y <= t.len {
            if x <= s.len {
                if x <= t.len {
                    if i < y {
                        if i < x {
                            let a = if c { t } else { s }
                            return a[i]
                        }
                    }
                }
            }
        }
    }
    -1
}

fn triple(s: []i64, t: []i64, i: i64, x: i64, y: i64, z: i64, c: bool, d: i64) -> i64 {
    if d > 0 {
        return triple(s, t, i, x, y, z, c, d - 1)
    }
    if x <= s.len {
        if x <= t.len {
            if y <= s.len {
                if y <= t.len {
                    if z <= s.len {
                        if z <= t.len {
                            if i < x {
                                if i < y {
                                    if i < z {
                                        let a = if c { s } else { t }
                                        return a[i]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    -1
}

fn twice(s: []i64, t: []i64, i: i64, x: i64, y: i64, c: bool, d: i64) -> i64 {
    if d > 0 {
        return twice(s, t, i, x, y, c, d - 1)
    }
    if x <= s.len {
        if x <= t.len {
            if y <= s.len {
                if y <= t.len {
                    if i < x {
                        if i < y {
                            let a = if c { s } else { t }
                            let b = if c { t } else { s }
                            return a[i] + b[i]
                        }
                    }
                }
            }
        }
    }
    -1
}

fn main() {
    var s: []i64 = []
    for k in 0..6 {
        push(mut s, 10 * (k + 1))
    }
    var t: []i64 = []
    for k in 0..8 {
        push(mut t, k + 1)
    }
    var state: u64 = 88172645463325252
    var total = 0
    for round in 0..200 {
        let i = i64(next(mut state) % 9)
        let x = i64(next(mut state) % 4) + 3
        let y = i64(next(mut state) % 4) + 3
        let z = i64(next(mut state) % 4) + 3
        let c = next(mut state) % 2 == 0
        total += nested(s, t, i, x, y, c, 1)
        total += swapped(s, t, i, x, y, c, 1)
        total += triple(s, t, i, x, y, z, c, 1)
        total += twice(s, t, i, x, y, c, 1)
    }
    print(total)
}
