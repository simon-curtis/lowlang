import std/gpu

struct launch {
    kernels: i64
}

kernel fn fill(id: u32, mut out: u32[]) {
    out[id] = id + 7
}

fn started(l: launch) -> i64 {
    l.kernels
}

fn main() {
    print(started(launch { kernels: 2 }))
    var out: u32[] = [0, 0]
    let job = launch(fill, 2, mut out)
    gpu.run_on_cpu(job)
    print(out[1])
}
