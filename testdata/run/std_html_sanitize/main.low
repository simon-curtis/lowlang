import std/builder
import std/html
import std/json
import std/text

fn rich() -> html.Policy {
    let element_attributes: [str: str[]] = [:]
    for name, attributes in html.default_policy().element_attributes {
        element_attributes[name] = attributes
    }
    element_attributes["form"] = ["action", "method"]
    element_attributes["input"] = ["type", "name", "value", "formaction"]
    element_attributes["button"] = ["formaction", "type"]
    element_attributes["video"] = ["src", "poster", "controls"]
    element_attributes["font"] = ["color"]
    let base = html.default_policy()
    var elements: str[] = []
    for name in base.elements {
        elements.push(name)
    }
    for name in ["form", "input", "button", "video", "font"] {
        elements.push(name)
    }
    var discard: str[] = []
    for name in base.drop_content {
        if name != "button" && name != "video" {
            discard.push(name)
        }
    }
    html.Policy {
        elements,
        attributes: ["class", "id", "dir", "lang", "title", "d", "fill", "viewbox", "href", "xlink:href", "xmlns", "xmlns:xlink", "width", "height"],
        element_attributes,
        url_schemes: ["http", "https", "mailto", "tel"],
        relative_urls: false,
        drop_content: discard,
        svg_elements: ["svg", "g", "path", "a", "text", "title", "desc", "linearGradient", "circle", "rect"],
        mathml_elements: ["math", "mi", "mo", "mn", "mrow", "mtext", "mglyph", "annotation-xml", "maction"]
    }
}

fn script_url(value: str) -> bool {
    var kept = builder.builder()
    for i in 0..value.len {
        let c = value[i]
        if c != 9 && c != 10 && c != 13 && (c > 32 || builder.len(kept) > 0) {
            builder.write_byte(mut kept, c)
        }
    }
    let lowered = text.lower(builder.to_str(kept))
    text.starts_with(lowered, "javascript:") || text.starts_with(lowered, "vbscript:")
}

fn unsafe_parts(output: str, everything: html.Selector) -> str[] {
    var found: str[] = []
    let parsed = html.parse_body(output)
    for n in html.query_all(parsed.root, everything) {
        let e = html.element(n) ?? continue
        if e.name == "script" {
            found.push("script element")
        }
        for a in e.attributes {
            let name = text.lower(a.name)
            if text.starts_with(name, "on") || name == "srcdoc" {
                found.push("attribute {name}")
            }
            if name != "srcset" && name != "ping" && script_url(a.value) {
                found.push("script URL in {name}")
            }
        }
    }
    found
}

fn keeps_text(input: str, expected: str, policy: html.Policy) {
    let out = html.sanitize(input, policy)
    let parsed = html.parse_body(out)
    let pre = html.query(parsed.root, html.compile("pre") or return) ?? return
    let got = html.text_content(pre)
    let verdict = if got == expected { "kept" } else { "changed" }
    print("{verdict} {text.quote(input)} -> {text.quote(out)} text {text.quote(got)}")
}

fn main() {
    let doc = json.parse(bytes(embed("cases.json"))) or json.Value.Null
    let everything = html.compile("*") or return
    let policies = [html.default_policy(), rich()]
    var passed = 0
    var failed = 0
    var index = 0
    for {
        let entry = json.at(json.field(doc, "cases"), index) ?? break
        index += 1
        let input = json.field_text(entry, "input") ?? ""
        let expected = json.field_text(entry, "expected") ?? ""
        let which = json.field_text(entry, "policy") ?? ""
        let policy = if which == "rich" { policies[1] } else { policies[0] }
        let got = html.sanitize(input, policy)
        var ok = true
        if got != expected {
            ok = false
            print("FAIL {which} {text.quote(input)}: expected {text.quote(expected)} got {text.quote(got)}")
        }
        let reserialized = html.reparsable_html(html.parse_body(got).root)
        if reserialized != got {
            ok = false
            print("FAIL {which} {text.quote(input)}: output changes when parsed and serialized: {text.quote(reserialized)}")
        }
        let again = html.sanitize(got, policy)
        if again != got {
            ok = false
            print("FAIL {which} {text.quote(input)}: sanitizing the output again gives {text.quote(again)}")
        }
        for part in unsafe_parts(got, everything) {
            ok = false
            print("FAIL {which} {text.quote(input)}: output holds {part}")
        }
        if ok {
            passed += 1
        } else {
            failed += 1
        }
    }
    print("sanitized passed {passed} failed {failed}")
    keeps_text("<pre>\n\nx</pre>", "\nx", policies[0])
    keeps_text("<pre>{text.repeat("\n", 12)}x</pre>", "{text.repeat("\n", 11)}x", policies[0])
    keeps_text("<pre><font>\nx</font></pre>", "\nx", policies[0])
    keeps_text("<pre><font>\n\nx</font></pre>", "\n\nx", policies[0])
    keeps_text("<pre>\nx</pre>", "x", policies[0])
    keeps_text("<pre>x\n\n</pre>", "x\n\n", policies[0])
}
