struct Entry {
    key: str
    count: i64
}

fn counter(start: i64) -> fn() -> i64 {
    var n = start
    fn() -> i64 {
        n += 1
        n
    }
}

fn slices() -> i64 {
    region {
        var xs: []i64 = []
        for i in 0..200000 {
            push(mut xs, i)
        }
        var sum = 0
        for x in xs {
            sum += x
        }
        sum
    }
}

fn maps() -> i64 {
    region {
        var m: [str: i64] = [:]
        for i in 0..20000 {
            m["key{i % 5000}"] += i
        }
        var best = 0
        for k, v in m {
            if v > best {
                best = v
            }
        }
        best + m.len
    }
}

fn strings() -> str {
    region {
        var s = ""
        for i in 0..2000 {
            s = "{s}{i % 10}"
        }
        "{s.len}:{s[0..10]}"
    }
}

fn closures() -> i64 {
    region {
        let next = counter(10)
        var fns: []fn() -> i64 = []
        for i in 0..100 {
            let c = counter(i)
            push(mut fns, c)
        }
        var total = 0
        for f in fns {
            total += f() + f()
        }
        next() + next() + total
    }
}

fn structs() -> []Entry {
    region {
        var out: []Entry = []
        for i in 0..50 {
            push(mut out, Entry { key: "k{i}", count: i * i })
        }
        out
    }
}

fn main() {
    print(slices())
    print(maps())
    print(strings())
    print(closures())
    let entries = structs()
    print(entries.len)
    print("{entries[7].key} {entries[7].count} {entries[49].key} {entries[49].count}")
    var total = 0
    for round in 0..50 {
        total += slices() % 1000 + round
    }
    print(total)
}
