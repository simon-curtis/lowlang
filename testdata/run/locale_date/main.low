import std/locale
import std/locale/datefmt
import std/text
import std/time/datetime

fn length_of(name: str) -> datefmt.Length {
    match name {
        "full" => datefmt.Length.Full
        "long" => datefmt.Length.Long
        "medium" => datefmt.Length.Medium
        _ => datefmt.Length.Short
    }
}

fn options_of(label: str) -> datefmt.Options {
    var o = datefmt.options()
    if text.starts_with(label, "skeleton:") {
        o.skeleton = label[9..]
        return o
    }
    for part in text.split(label[6..], ',') {
        if text.starts_with(part, "date=") {
            o.date_style = length_of(part[5..])
        } else {
            o.time_style = length_of(part[5..])
        }
    }
    o
}

fn moment_of(value: str, offset: i64) -> datefmt.Moment {
    let n = text.split(value, ',')
    let year = text.parse_int(n[0]) or 0
    let month = text.parse_int(n[1]) or 1
    let day = text.parse_int(n[2]) or 1
    let hour = text.parse_int(n[3]) or 0
    let minute = text.parse_int(n[4]) or 0
    let second = text.parse_int(n[5]) or 0
    let milli = text.parse_int(n[6]) or 0
    let dt = datetime.of(year, month, day, hour, minute, second, milli * 1000000) or datetime.epoch()
    var m = datefmt.from_datetime(dt)
    m.has_zone = true
    m.offset = offset
    m
}

fn main() {
    var checked = 0
    var failed = 0
    var current = ""
    var l = locale.root()
    for line in text.lines(embed("dates.tsv")) {
        let f = text.split(line, '\t')
        if f.len != 5 {
            continue
        }
        if f[0] != current {
            current = f[0]
            l = locale.parse(current) or locale.root()
        }
        let offset = text.parse_int(f[3]) or 0
        let m = moment_of(f[2], offset)
        let raw = datefmt.format(l, m, options_of(f[1])) or "error"
        let got = text.replace(raw, text.from_char(0x202f), " ")
        checked += 1
        if got != f[4] {
            failed += 1
            if failed <= 40 {
                print("{f[0]} {f[1]} {f[2]} {f[3]}: want {f[4]}, got {got}")
            }
        }
    }
    print("date: {checked} checked, {failed} wrong")
}
