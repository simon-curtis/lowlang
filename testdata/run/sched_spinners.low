fn spin(id: i64, started: chan[i64], stop: chan[bool]) {
    started <- id
    var acc = 1
    for {
        for i in 0..2000 {
            acc = (acc * 33 + i) % 100003
        }
        let halted = select {
            <-stop => true
            else => false
        }
        if halted {
            return
        }
    }
}

fn spin_unchecked(id: i64, started: chan[i64]) {
    started <- id
    var acc = 1
    for {
        acc = (acc * 33 + 7) % 100003
    }
}

fn run_checked(count: i64) {
    let started = chan[i64](count)
    let stop = chan[bool]()
    for id in 0..count {
        spawn spin(id, started, stop)
    }
    var seen: []bool = []
    for id in 0..count {
        push(mut seen, false)
    }
    for i in 0..count {
        let id = (<-started) ?? 0
        seen[id] = true
    }
    close(stop)
    var missing = 0
    for id in 0..count {
        if !seen[id] {
            missing += 1
        }
    }
    print("checked {count} missing {missing}")
}

fn run_unchecked(count: i64) {
    let started = chan[i64](count)
    for id in 0..count {
        spawn spin_unchecked(id, started)
    }
    var seen: []bool = []
    for id in 0..count {
        push(mut seen, false)
    }
    for i in 0..count {
        let id = (<-started) ?? 0
        seen[id] = true
    }
    var missing = 0
    for id in 0..count {
        if !seen[id] {
            missing += 1
        }
    }
    print("unchecked {count} missing {missing}")
}

fn main() {
    run_checked(24)
    run_unchecked(24)
}
