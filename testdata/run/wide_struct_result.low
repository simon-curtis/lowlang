struct Pad8 {
    a: i64 = 0
    b: i64 = 0
    c: i64 = 0
    d: i64 = 0
    e: i64 = 0
    f: i64 = 0
    g: i64 = 0
    h: i64 = 0
}

struct Pad64 {
    a: Pad8 = Pad8 {}
    b: Pad8 = Pad8 {}
    c: Pad8 = Pad8 {}
    d: Pad8 = Pad8 {}
    e: Pad8 = Pad8 {}
    f: Pad8 = Pad8 {}
    g: Pad8 = Pad8 {}
    h: Pad8 = Pad8 {}
}

struct Pad512 {
    a: Pad64 = Pad64 {}
    b: Pad64 = Pad64 {}
    c: Pad64 = Pad64 {}
    d: Pad64 = Pad64 {}
    e: Pad64 = Pad64 {}
    f: Pad64 = Pad64 {}
    g: Pad64 = Pad64 {}
    h: Pad64 = Pad64 {}
}

struct Pad4096 {
    a: Pad512 = Pad512 {}
    b: Pad512 = Pad512 {}
    c: Pad512 = Pad512 {}
    d: Pad512 = Pad512 {}
    e: Pad512 = Pad512 {}
    f: Pad512 = Pad512 {}
    g: Pad512 = Pad512 {}
    h: Pad512 = Pad512 {}
}

fn make(seed: i64, depth: i64) -> Pad4096 {
    if depth > 0 {
        return make(seed, depth - 1)
    }
    var pad = Pad4096 {}
    pad.a.a.a.a = seed
    pad.d.e.f.g = seed * 2
    pad.h.h.h.h = seed * 3
    pad
}

fn bump(pad: Pad4096, by: i64, depth: i64) -> Pad4096 {
    if depth > 0 {
        return bump(pad, by, depth - 1)
    }
    var next = pad
    next.a.a.a.a += by
    next.h.h.h.h += by
    next
}

fn checksum(pad: Pad4096, depth: i64) -> i64 {
    if depth > 0 {
        return checksum(pad, depth - 1)
    }
    pad.a.a.a.a + pad.d.e.f.g + pad.h.h.h.h
}

struct Tagged {
    pad: Pad4096 = Pad4096 {}
    tag: i64 = 0
}

enum Refusal {
    Negative
}

fn tagged(seed: i64) -> Tagged {
    Tagged { pad: make(seed, 2), tag: seed + 100 }
}

fn checked(seed: i64, depth: i64) -> Pad4096 ! Refusal {
    if depth > 0 {
        return checked(seed, depth - 1)
    }
    if seed < 0 {
        fail Negative
    }
    make(seed, 1)
}

fn total(seed: i64) -> i64 ! Refusal {
    let pad = checked(seed, 2)?
    checksum(pad, 1)
}

fn main() {
    let first = make(5, 2)
    print(checksum(first, 2))
    let second = bump(first, 10, 2)
    print(checksum(second, 2))
    print(checksum(first, 2))
    print(checksum(bump(bump(make(1, 2), 1, 2), 2, 2), 2))
    let t = tagged(7)
    print(checksum(t.pad, 2))
    print(t.tag)
    print(total(3) or -1)
    print(total(-3) or -1)
}

