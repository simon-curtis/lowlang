struct Node {
    value: i64
    next: *Node?
}

fn main() {
    let chain = region {
        let tail = new(Node { value: 2, next: none })
        let head = new(Node { value: 1, next: tail })
        head
    }
    let tail = chain.next ?? chain
    print("{chain.value} {tail.value}")
    let ring = region {
        let first = new(Node { value: 1, next: none })
        let second = new(Node { value: 2, next: first })
        first.next = second
        first
    }
    print(ring.value)
}
