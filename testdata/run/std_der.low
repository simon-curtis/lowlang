import std/crypto/der
import std/text

fn hex(data: []u8) -> str {
    text.encode_hex(data)
}

fn outcome(label: str, data: []u8) {
    let d = der.reader(data)
    let value = der.unsigned(d) catch {
        e => {
            print("{label}: {e}")
            return
        }
    }
    print("{label}: {hex(value)}")
}

fn main() {
    print(hex(der.integer([])))
    print(hex(der.integer([0, 0])))
    print(hex(der.integer([1])))
    print(hex(der.integer([0, 0, 0x7f])))
    print(hex(der.integer([0x80])))
    print(hex(der.integer([0, 0xff, 1])))
    var big: []u8 = []
    for i in 0..200 {
        push(mut big, u8(i + 1))
    }
    let long = der.encode(0x04, big)
    print(hex(long[..6]))
    print(long.len)
    var huge: []u8 = []
    for i in 0..300 {
        push(mut huge, u8(i))
    }
    let wide = der.encode(0x04, huge)
    print(hex(wide[..5]))
    print(wide.len)
    let back = der.whole(wide, 0x04) catch {
        _ => return
    }
    print(back.content.len)
    let pair = der.sequence([der.integer([1, 2]), der.integer([0xff])])
    print(hex(pair))
    let outer = der.whole(pair, 0x30) catch {
        _ => return
    }
    let d = der.reader(outer.content)
    outcome("first", der.encode(0x02, [1, 2]))
    outcome("negative", der.encode(0x02, [0x80]))
    outcome("padded", der.encode(0x02, [0, 1]))
    outcome("needed", der.encode(0x02, [0, 0x80]))
    outcome("zero", der.encode(0x02, [0]))
    outcome("empty", der.encode(0x02, []))
    outcome("wrong tag", der.encode(0x04, [1]))
    let a = der.unsigned(d) catch { _ => [] }
    let b = der.unsigned(d) catch { _ => [] }
    print("{hex(a)} {hex(b)} {der.done(d)}")
    let nonminimal: []u8 = [0x04, 0x81, 0x05, 1, 2, 3, 4, 5]
    let reader = der.reader(nonminimal)
    let bad = der.read(reader) catch {
        e => {
            print("nonminimal length: {e}")
            return
        }
    }
    print(bad.content.len)
}
