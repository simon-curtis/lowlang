import std/crypto/hash
import std/crypto/hpke
import std/text

struct Seal {
    seq: i64
    aad: str
    ct: str
}

struct Export {
    context: str
    length: i64
    value: str
    digest: str
}

struct Case {
    label: str
    kem: i64
    aead: i64
    info: str
    ikm_r: str
    sk_r: str
    pk_r: str
    ikm_e: str
    enc: str
    psk: str
    psk_id: str
    ikm_s: str
    sk_s: str
    pk_s: str
    pt: str
    count: i64
    seals: Seal[]
    exports: Export[]
}

fn hex(s: str) -> u8[] {
    text.decode_hex(s) or []
}

fn same(a: u8[], s: str) -> bool {
    text.encode_hex(a) == s
}

fn kem_of(id: i64) -> hpke.Kem {
    match id {
        0x20 => hpke.Kem.DhkemX25519
        _ => hpke.Kem.Mlkem768X25519
    }
}

fn aead_of(id: i64) -> hpke.AeadId {
    match id {
        2 => hpke.AeadId.Aes256Gcm
        3 => hpke.AeadId.ChaCha20Poly1305
        _ => hpke.AeadId.ExportOnly
    }
}

fn report(c: Case, name: str, ok: bool) {
    let verdict = if ok { "ok" } else { "FAIL" }
    print("{c.label} {name}: {verdict}")
}

fn listed(c: Case, seq: i64) -> Seal? {
    for s in c.seals {
        if s.seq == seq {
            return s
        }
    }
    none
}

fn aad_of(c: Case, seq: i64) -> u8[] {
    let s = listed(c, seq) ?? return bytes("Count-{seq}")
    hex(s.aad)
}

fn export_ok(e: Export, got: u8[]) -> bool {
    if e.digest == "" {
        return same(got, e.value)
    }
    let digest = hash.sum(hash.sha256(), got)
    same(digest, e.digest)
}

fn check_seal(c: Case, seq: i64, ct: u8[]) {
    let published = listed(c, seq) ?? return
    report(c, "seal {seq}", same(ct, published.ct))
}

fn ciphertext_of(c: Case, seq: i64, sealed: u8[][]) -> u8[] {
    let published = listed(c, seq) ?? return sealed[seq]
    hex(published.ct)
}

fn check_single(c: Case, suite: hpke.Suite, recipient: hpke.KeyPair, credentials: hpke.Credentials) ! hpke.Error {
    let first = listed(c, 0) ?? return
    let single = hpke.open_single(suite, hex(c.enc), recipient.private, hex(c.info), credentials, hex(first.aad), hex(first.ct))?
    report(c, "open single", same(single, c.pt))
}

fn send(c: Case, suite: hpke.Suite, recipient: hpke.KeyPair, credentials: hpke.Credentials) -> u8[][] ! hpke.Error {
    let setup = hpke.setup_sender_seeded(suite, recipient.public, hex(c.info), credentials, hex(c.ikm_e))?
    report(c, "sender enc", same(setup.enc, c.enc))
    var sealed: u8[][] = []
    let pt = hex(c.pt)
    for i in 0..c.count {
        let ct = hpke.seal(setup.context, aad_of(c, i), pt)?
        sealed.push(ct)
        check_seal(c, i, ct)
    }
    var k = 0
    for e in c.exports {
        let got = hpke.export(setup.context, hex(e.context), e.length)?
        report(c, "export {k} sender", export_ok(e, got))
        k += 1
    }
    sealed
}

fn receive(c: Case, suite: hpke.Suite, recipient: hpke.KeyPair, credentials: hpke.Credentials, sealed: u8[][]) ! hpke.Error {
    let enc = hex(c.enc)
    let info = hex(c.info)
    let context = hpke.setup_recipient(suite, enc, recipient.private, info, credentials)?
    let _ = hex(c.pt)
    var all = c.count > 0
    for i in 0..c.count {
        let ct = ciphertext_of(c, i, sealed)
        let opened = hpke.open(context, aad_of(c, i), ct)?
        all = all && same(opened, c.pt)
    }
    if c.count > 0 {
        report(c, "open all", all)
    }
    check_single(c, suite, recipient, credentials)?
    var k = 0
    for e in c.exports {
        let got = hpke.export(context, hex(e.context), e.length)?
        report(c, "export {k} recipient", export_ok(e, got))
        k += 1
    }
}

fn run(c: Case) ! hpke.Error {
    let suite = hpke.Suite { kem: kem_of(c.kem), aead: aead_of(c.aead) }
    let recipient = hpke.derive_key_pair(suite.kem, hex(c.ikm_r))?
    report(c, "derive recipient", same(recipient.private, c.sk_r) && same(recipient.public, c.pk_r))
    var sender_private: u8[] = []
    var sender_public: u8[] = []
    if c.ikm_s != "" {
        let sender = hpke.derive_key_pair(suite.kem, hex(c.ikm_s))?
        sender_private = sender.private
        sender_public = sender.public
        report(c, "derive sender", same(sender.private, c.sk_s) && same(sender.public, c.pk_s))
    }
    let psk = hex(c.psk)
    let psk_id = hex(c.psk_id)
    var sealed: u8[][] = []
    if c.ikm_e != "" {
        sealed = send(c, suite, recipient, hpke.auth_psk(sender_private, psk, psk_id))?
    }
    receive(c, suite, recipient, hpke.auth_psk(sender_public, psk, psk_id), sealed)?
}

fn main() {
    for c in cases() {
        run(c) catch {
            _ => print("{c.label}: error")
        }
    }
}

