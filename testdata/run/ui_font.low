import std/io
import std/ui/font

struct Table {
    tag: str
    data: []u8
}

fn pad(mut b: []u8, n: i64) {
    for _ in 0..n {
        b.push(0)
    }
}

fn zeros(n: i64) -> []u8 {
    var b: []u8 = []
    pad(mut b, n)
    b
}

fn assemble(tables: []Table) -> []u8 {
    var out: []u8 = []
    io.put_be32(mut out, 65536)
    io.put_be16(mut out, tables.len)
    pad(mut out, 6)
    var offset = 12 + 16 * tables.len
    for t in tables {
        for i in 0..4 {
            out.push(t.tag[i])
        }
        io.put_be32(mut out, 0)
        io.put_be32(mut out, offset)
        io.put_be32(mut out, t.data.len)
        offset += (t.data.len + 3) / 4 * 4
    }
    for t in tables {
        for b in t.data {
            out.push(b)
        }
        for _ in 0..(4 - t.data.len % 4) % 4 {
            out.push(0)
        }
    }
    out
}

fn head(upem: i64, long_loca: bool) -> []u8 {
    var b = zeros(54)
    io.set_be16(b, 18, upem)
    io.set_be16(b, 50, if long_loca { 1 } else { 0 })
    b
}

fn hhea(ascent: i64, descent: i64, gap: i64, metrics: i64) -> []u8 {
    var b = zeros(36)
    io.set_be16(b, 4, ascent)
    io.set_be16(b, 6, descent)
    io.set_be16(b, 8, gap)
    io.set_be16(b, 34, metrics)
    b
}

fn maxp(glyphs: i64) -> []u8 {
    var b = zeros(6)
    io.set_be16(b, 4, glyphs)
    b
}

fn hmtx(advances: []i64) -> []u8 {
    var b: []u8 = []
    for a in advances {
        io.put_be16(mut b, a)
        io.put_be16(mut b, 0)
    }
    b
}

fn glyf(glyphs: [][]u8) -> []u8 {
    var b: []u8 = []
    for g in glyphs {
        for x in g {
            b.push(x)
        }
        if g.len % 2 == 1 {
            b.push(0)
        }
    }
    b
}

fn loca(glyphs: [][]u8) -> []u8 {
    var b: []u8 = []
    var at = 0
    io.put_be16(mut b, 0)
    for g in glyphs {
        at += (g.len + 1) / 2 * 2
        io.put_be16(mut b, at / 2)
    }
    b
}

fn cmap12(groups: []i64) -> []u8 {
    var b: []u8 = []
    io.put_be16(mut b, 0)
    io.put_be16(mut b, 1)
    io.put_be16(mut b, 3)
    io.put_be16(mut b, 10)
    io.put_be32(mut b, 12)
    io.put_be16(mut b, 12)
    io.put_be16(mut b, 0)
    io.put_be32(mut b, 16 + 4 * groups.len)
    io.put_be32(mut b, 0)
    io.put_be32(mut b, groups.len / 3)
    for v in groups {
        io.put_be32(mut b, v)
    }
    b
}

fn kern0(pairs: []i64) -> []u8 {
    var b: []u8 = []
    io.put_be16(mut b, 0)
    io.put_be16(mut b, 1)
    io.put_be16(mut b, 0)
    io.put_be16(mut b, 14 + 2 * pairs.len)
    io.put_be16(mut b, 1)
    io.put_be16(mut b, pairs.len / 3)
    pad(mut b, 6)
    for i in 0..pairs.len / 3 {
        io.put_be16(mut b, pairs[3 * i])
        io.put_be16(mut b, pairs[3 * i + 1])
        io.put_be16(mut b, pairs[3 * i + 2])
    }
    b
}

fn polygon(xs: []i64, ys: []i64, on: bool) -> []u8 {
    var b: []u8 = []
    io.put_be16(mut b, 1)
    pad(mut b, 8)
    io.put_be16(mut b, xs.len - 1)
    io.put_be16(mut b, 0)
    for _ in xs {
        b.push(if on { 1 } else { 0 })
    }
    var x = 0
    for v in xs {
        io.put_be16(mut b, v - x)
        x = v
    }
    var y = 0
    for v in ys {
        io.put_be16(mut b, v - y)
        y = v
    }
    b
}

fn component(flags: i64, glyph: i64, a: i64, b: i64, scale: i64) -> []u8 {
    var out: []u8 = []
    io.put_be16(mut out, flags)
    io.put_be16(mut out, glyph)
    out.push(u8(a))
    out.push(u8(b))
    if flags & 8 != 0 {
        io.put_be16(mut out, scale)
    }
    out
}

fn composite(parts: [][]u8) -> []u8 {
    var b: []u8 = []
    io.put_be16(mut b, 65535)
    pad(mut b, 8)
    for p in parts {
        for x in p {
            b.push(x)
        }
    }
    b
}

fn tables(glyphs: [][]u8, groups: []i64, pairs: []i64) -> []Table {
    var out = [
        Table { tag: "head", data: head(16, false) }
        Table { tag: "hhea", data: hhea(14, -4, 2, 3) }
        Table { tag: "maxp", data: maxp(glyphs.len) }
        Table { tag: "cmap", data: cmap12(groups) }
        Table { tag: "hmtx", data: hmtx([8, 10, 16, 10, 12, 0, 0, 0, 9]) }
        Table { tag: "loca", data: loca(glyphs) }
        Table { tag: "glyf", data: glyf(glyphs) }
    ]
    if pairs.len > 0 {
        out.push(Table { tag: "kern", data: kern0(pairs) })
    }
    out
}

fn square() -> []u8 {
    polygon([2, 10, 10, 2], [0, 0, 12, 12], true)
}

fn forward(to: i64) -> []u8 {
    composite([component(2, to, 0, 0, 0)])
}

fn many(count: i64) -> []u8 {
    var parts: [][]u8 = []
    for i in 0..count {
        parts.push(component(if i + 1 < count { 34 } else { 2 }, 1, 0, 0, 0))
    }
    composite(parts)
}

fn glyphs() -> [][]u8 {
    var out: [][]u8 = [
        []
        square()
        polygon([0, 16, 16, 0], [0, 0, 16, 16], false)
        composite([component(10, 1, 4, 2, 8192)])
        composite([component(34, 1, 0, 0, 0), component(0, 1, 2, 0, 0)])
        [0, 1, 0, 0]
        forward(6)
        forward(99)
        polygon([0, 8, 0], [0, 0, 8], true)
    ]
    for k in 9..15 {
        out.push(forward(k + 1))
    }
    out.push(square())
    for k in 16..23 {
        out.push(forward(k + 1))
    }
    out.push(square())
    out.push(many(65))
    out.push(many(64))
    out
}

fn groups() -> []i64 {
    [65, 66, 1, 67, 71, 3, 0x1F600, 0x1F600, 8]
}

fn pairs() -> []i64 {
    [1, 2, -2, 2, 1, 1, 8, 1, -1]
}

fn synthetic() -> []u8 {
    assemble(tables(glyphs(), groups(), pairs()))
}

fn open_font(data: []u8) -> font.Font {
    font.parse(str(data)) catch font.Font {}
}

fn describe(data: str) -> str {
    let f = font.parse(data) catch {
        e => return "{e}"
    }
    "ok {f.glyph_count}"
}

fn shape(o: font.Outline) -> str {
    var points = 0
    for c in o.contours {
        points += c.points.len
    }
    "{o.contours.len} contours {points} points"
}

fn rows(b: font.Bitmap) {
    print("bitmap {b.width}x{b.height} at {b.left},{b.top}")
    for r in 0..b.height {
        var line = ""
        for c in 0..b.width {
            line = line + "{b.coverage[r * b.width + c],4}"
        }
        print(line)
    }
}

fn total(b: font.Bitmap) -> f64 {
    var sum = 0
    for v in b.coverage {
        sum += i64(v)
    }
    f64(sum) / 255.0
}

fn area(o: font.Outline, scale: f32) -> f64 {
    var twice: f64 = 0.0
    for c in o.contours {
        for i in 0..c.points.len {
            let a = c.points[i]
            let b = c.points[(i + 1) % c.points.len]
            twice += f64(a.x * b.y - b.x * a.y)
        }
    }
    let s = f64(scale)
    (if twice < 0.0 { -twice } else { twice }) / 2.0 * s * s
}

fn near(got: f64, want: f64, tolerance: f64) -> bool {
    got >= want * (1.0 - tolerance) && got <= want * (1.0 + tolerance)
}

fn main() {
    let f = open_font(synthetic())
    print("em {f.units_per_em} ascent {f.ascent} descent {f.descent} gap {f.line_gap} glyphs {f.glyph_count}")
    print("index {f.glyph_index('A')} {f.glyph_index('B')} {f.glyph_index('C')} {f.glyph_index('G')} {f.glyph_index('H')} {f.glyph_index('Z')} {f.glyph_index(0x1F600)} {f.glyph_index(0x1F601)}")
    print("advance {f.advance(0)} {f.advance(1)} {f.advance(8)} {f.advance(9)} {f.advance(-1)}")
    print("kern {f.kern(1, 2)} {f.kern(2, 1)} {f.kern(8, 1)} {f.kern(1, 1)} {f.kern(0, 0)} {f.kern(9, 9)}")
    print("scale {f.scale(8.0)}")
    for g in 0..10 {
        print("glyph {g}: {shape(f.outline(g))}")
    }
    print("nested 6 deep: {shape(f.outline(9))}")
    print("nested 7 deep: {shape(f.outline(16))}")
    print("65 components: {shape(f.outline(24))}")
    print("64 components: {shape(f.outline(25))}")
    print("past the end: {shape(f.outline(26))} {shape(f.outline(-1))}")
    let c = f.outline(3)
    print("composite scaled and offset: {c.contours[0].points[0].x} {c.contours[0].points[0].y} {c.contours[0].points[2].x} {c.contours[0].points[2].y}")
    let d = f.outline(4)
    print("composite matched: {d.contours[1].points[0].x} {d.contours[1].points[0].y} {d.contours[1].points[2].x} {d.contours[1].points[2].y}")

    rows(f.rasterize(1, 16.0))
    rows(f.rasterize(1, 8.0))
    rows(f.rasterize(1, 12.0))
    rows(f.rasterize(8, 16.0))
    let round = f.rasterize(2, 16.0)
    print("rounded {round.width}x{round.height} {round.left},{round.top} corner {round.coverage[0]} edge {round.coverage[8]} centre {round.coverage[8 * 16 + 8]}")
    print(near(total(round), 213.33, 0.01))
    let moved = f.rasterize(3, 16.0)
    print("composite bitmap {moved.width}x{moved.height} {moved.left},{moved.top} {total(moved)}")
    print("empty {f.rasterize(0, 16.0).width} {f.rasterize(5, 16.0).width} {f.rasterize(99, 16.0).width} {f.rasterize(1, 0.0).width} {f.rasterize(1, -3.0).width} {f.rasterize(1, 100000.0).width}")

    let go = font.fallback()
    print("go em {go.units_per_em} ascent {go.ascent} descent {go.descent} gap {go.line_gap} glyphs {go.glyph_count}")
    let upper_a = go.glyph_index('A')
    let lower_a = go.glyph_index('a')
    print("go index {upper_a} {lower_a} {go.glyph_index(0x1F600)} {go.glyph_index(0x20AC)} {go.glyph_index(0xE9)} {go.glyph_index(0x10FFFF)}")
    print("go advance {go.advance(upper_a)} {go.advance(lower_a)} {go.advance(go.glyph_index(' '))} {go.advance(0)}")
    print("go kern {go.kern(upper_a, go.glyph_index('V'))}")
    print("go outline A {shape(go.outline(upper_a))}")
    print("go outline I {shape(go.outline(go.glyph_index('I')))}")
    print("go outline e {shape(go.outline(go.glyph_index('e')))}")
    print("go outline space {shape(go.outline(go.glyph_index(' ')))}")
    let accented = go.outline(go.glyph_index(0xE9))
    print("go outline e acute {shape(accented)}")
    print("go outline Aring {shape(go.outline(go.glyph_index(0xC5)))}")

    let stem = go.glyph_index('l')
    let sm = go.rasterize(stem, 32.0)
    rows(sm)
    let i32px = go.rasterize(go.glyph_index('I'), 32.0)
    let i_area = area(go.outline(go.glyph_index('I')), go.scale(32.0))
    print("I {i32px.width}x{i32px.height} {i32px.left},{i32px.top} {near(total(i32px), i_area, 0.01)}")
    let middle = i32px.height / 2
    var left_edge = 0
    var run = 0
    for x in 0..i32px.width {
        if i32px.coverage[middle * i32px.width + x] == 255 {
            run += 1
        }
        if i32px.coverage[middle * i32px.width + x] == 0 && run == 0 {
            left_edge += 1
        }
    }
    print("I stem: {left_edge} empty columns before, {run} full columns, {i32px.width - left_edge - run} after")
    let small = go.rasterize(go.glyph_index('I'), 16.0)
    let big = go.rasterize(go.glyph_index('I'), 64.0)
    print("I sizes {small.width}x{small.height} {big.width}x{big.height}")
    print(near(total(small), area(go.outline(go.glyph_index('I')), go.scale(16.0)), 0.02))
    print(near(total(big), area(go.outline(go.glyph_index('I')), go.scale(64.0)), 0.01))
    let o = go.rasterize(go.glyph_index('O'), 48.0)
    print("O {o.width}x{o.height} {o.left},{o.top} hole {o.coverage[(o.height / 2) * o.width + o.width / 2]} ring {o.coverage[(o.height / 2) * o.width + 4]}")
    let acute = go.rasterize(go.glyph_index(0xE9), 32.0)
    print("e acute {acute.width}x{acute.height} {acute.left},{acute.top}")

    let good = synthetic()
    print(describe(str(good)))
    print(describe(""))
    print(describe("OTTO"))
    print(describe("ttcf0000000000"))
    print(describe(str(zeros(2))))
    print(describe(str(good[0..11])))
    print(describe(str(good[0..40])))
    print(describe(str(good[0..good.len - 1])))
    print(describe(str(zeros(64))))

    var cff = tables(glyphs(), groups(), pairs())
    cff[6] = Table { tag: "CFF ", data: zeros(8) }
    print(describe(str(assemble(cff))))
    var no_head = tables(glyphs(), groups(), pairs())
    no_head[0] = Table { tag: "zzzz", data: zeros(8) }
    print(describe(str(assemble(no_head))))
    var short_head = tables(glyphs(), groups(), pairs())
    short_head[0] = Table { tag: "head", data: zeros(53) }
    print(describe(str(assemble(short_head))))

    var dir_past_end = good
    io.set_be32(dir_past_end, 12 + 16 * 3 + 8, good.len - 2)
    print(describe(str(dir_past_end)))
    var dir_count = good
    io.set_be16(dir_count, 4, 200)
    print(describe(str(dir_count)))

    var zero_em = tables(glyphs(), groups(), pairs())
    zero_em[0] = Table { tag: "head", data: head(0, false) }
    print(describe(str(assemble(zero_em))))
    var long_head = tables(glyphs(), groups(), pairs())
    long_head[0] = Table { tag: "head", data: head(16, true) }
    print(describe(str(assemble(long_head))))
    var no_glyphs = tables(glyphs(), groups(), pairs())
    no_glyphs[2] = Table { tag: "maxp", data: maxp(0) }
    print(describe(str(assemble(no_glyphs))))
    var many_metrics = tables(glyphs(), groups(), pairs())
    many_metrics[1] = Table { tag: "hhea", data: hhea(14, -4, 2, 30) }
    print(describe(str(assemble(many_metrics))))
    var no_metrics = tables(glyphs(), groups(), pairs())
    no_metrics[1] = Table { tag: "hhea", data: hhea(14, -4, 2, 0) }
    print(describe(str(assemble(no_metrics))))
    var short_hmtx = tables(glyphs(), groups(), pairs())
    short_hmtx[4] = Table { tag: "hmtx", data: zeros(8) }
    print(describe(str(assemble(short_hmtx))))
    var short_loca = tables(glyphs(), groups(), pairs())
    short_loca[5] = Table { tag: "loca", data: zeros(8) }
    print(describe(str(assemble(short_loca))))
    var backwards = tables(glyphs(), groups(), pairs())
    var backwards_loca = loca(glyphs())
    io.set_be16(backwards_loca, 10, 0)
    backwards[5] = Table { tag: "loca", data: backwards_loca }
    print(describe(str(assemble(backwards))))
    var beyond = tables(glyphs(), groups(), pairs())
    var beyond_loca = loca(glyphs())
    io.set_be16(beyond_loca, 18, 30000)
    beyond[5] = Table { tag: "loca", data: beyond_loca }
    print(describe(str(assemble(beyond))))
    var no_cmap = tables(glyphs(), groups(), pairs())
    no_cmap[3] = Table { tag: "zzzz", data: zeros(8) }
    print(describe(str(assemble(no_cmap))))
    var other_cmap = tables(glyphs(), groups(), pairs())
    var format6 = cmap12(groups())
    io.set_be16(format6, 12, 6)
    other_cmap[3] = Table { tag: "cmap", data: format6 }
    print(describe(str(assemble(other_cmap))))
    var long_cmap = tables(glyphs(), groups(), pairs())
    var long = cmap12(groups())
    io.set_be32(long, 24, 1000)
    long_cmap[3] = Table { tag: "cmap", data: long }
    print(describe(str(assemble(long_cmap))))
    var long_kern = tables(glyphs(), groups(), pairs())
    var kern_data = kern0(pairs())
    io.set_be16(kern_data, 10, 1000)
    long_kern[7] = Table { tag: "kern", data: kern_data }
    print(describe(str(assemble(long_kern))))
    print(describe(str(assemble(tables(glyphs(), groups(), [])))))

    let gobytes = embed("../../internal/compiler/std/ui/font/GoRegular.ttf")
    var cuts = 0
    var survived = 0
    var cut = 0
    for cut < gobytes.len {
        cuts += 1
        if describe(gobytes[0..cut]) != "ok 712" {
            survived += 1
        }
        cut += gobytes.len / 97 + 1
    }
    print("truncated copies rejected: {survived} of {cuts}")

    var seed: u64 = 12345
    var parsed = 0
    var drawn = 0
    for _ in 0..6 {
        var damaged = bytes(gobytes)
        for _ in 0..300 {
            seed = seed * 6364136223846793005 + 1442695040888963407
            let at = 1676 + i64((seed >> 33) % 126000)
            damaged[at] = u8(seed >> 24)
        }
        let g = open_font(damaged)
        if g.glyph_count == 712 {
            parsed += 1
            for glyph in 0..g.glyph_count {
                drawn += g.outline(glyph).contours.len
                drawn += g.rasterize(glyph, 12.0).height
            }
        }
    }
    print("damaged fonts parsed {parsed}, drawn {drawn > 0}")
}
