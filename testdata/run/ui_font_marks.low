import std/io
import std/ui/font

struct Table {
    tag: str
    data: []u8
}

struct Script {
    tag: str
    features: []i64
}

struct Feature {
    tag: str
    lookups: []i64
}

fn pad(mut b: []u8, n: i64) {
    for _ in 0..n {
        b.push(0)
    }
}

fn zeros(n: i64) -> []u8 {
    var b: []u8 = []
    pad(mut b, n)
    b
}

fn append(mut b: []u8, more: []u8) {
    for x in more {
        b.push(x)
    }
}

fn words(mut b: []u8, w: []i64) {
    for v in w {
        io.put_be16(mut b, v)
    }
}

fn tag(mut b: []u8, t: str) {
    for i in 0..4 {
        b.push(t[i])
    }
}

fn assemble(tables: []Table) -> []u8 {
    var out: []u8 = []
    io.put_be32(mut out, 65536)
    io.put_be16(mut out, tables.len)
    pad(mut out, 6)
    var offset = 12 + 16 * tables.len
    for t in tables {
        tag(mut out, t.tag)
        io.put_be32(mut out, 0)
        io.put_be32(mut out, offset)
        io.put_be32(mut out, t.data.len)
        offset += (t.data.len + 3) / 4 * 4
    }
    for t in tables {
        append(mut out, t.data)
        pad(mut out, (4 - t.data.len % 4) % 4)
    }
    out
}

fn head() -> []u8 {
    var b = zeros(54)
    io.set_be16(b, 18, 16)
    b
}

fn hhea() -> []u8 {
    var b = zeros(36)
    io.set_be16(b, 4, 14)
    io.set_be16(b, 6, -4)
    io.set_be16(b, 34, 1)
    b
}

fn maxp(glyphs: i64) -> []u8 {
    var b = zeros(6)
    io.set_be16(b, 4, glyphs)
    b
}

fn hmtx() -> []u8 {
    var b: []u8 = []
    words(mut b, [8, 0])
    b
}

fn cmap12() -> []u8 {
    var b: []u8 = []
    words(mut b, [0, 1, 3, 10])
    io.put_be32(mut b, 12)
    words(mut b, [12, 0])
    io.put_be32(mut b, 28)
    io.put_be32(mut b, 0)
    io.put_be32(mut b, 1)
    for v in [65, 66, 1] {
        io.put_be32(mut b, v)
    }
    b
}

fn coverage1(glyphs: []i64) -> []u8 {
    var b: []u8 = []
    words(mut b, [1, glyphs.len])
    words(mut b, glyphs)
    b
}

fn coverage2(ranges: []i64) -> []u8 {
    var b: []u8 = []
    words(mut b, [2, ranges.len / 3])
    words(mut b, ranges)
    b
}

fn class1(start: i64, classes: []i64) -> []u8 {
    var b: []u8 = []
    words(mut b, [1, start, classes.len])
    words(mut b, classes)
    b
}

fn anchor1(x: i64, y: i64) -> []i64 {
    [1, x, y]
}

fn anchor2(x: i64, y: i64, point: i64) -> []i64 {
    [2, x, y, point]
}

fn anchor3(x: i64, y: i64) -> []i64 {
    [3, x, y, 0, 0]
}

fn record(class: i64, anchor: []i64) -> []i64 {
    var r = [class]
    for v in anchor {
        r.push(v)
    }
    r
}

fn mark_array(records: [][]i64) -> []u8 {
    var b: []u8 = []
    io.put_be16(mut b, records.len)
    var at = 2 + 4 * records.len
    for r in records {
        io.put_be16(mut b, r[0])
        io.put_be16(mut b, at)
        at += 2 * (r.len - 1)
    }
    for r in records {
        words(mut b, r[1..])
    }
    b
}

fn base_array(classes: i64, rows: [][][]i64) -> []u8 {
    var b: []u8 = []
    io.put_be16(mut b, rows.len)
    var at = 2 + 2 * classes * rows.len
    for row in rows {
        for anchor in row {
            if anchor.len == 0 {
                io.put_be16(mut b, 0)
            } else {
                io.put_be16(mut b, at)
                at += 2 * anchor.len
            }
        }
    }
    for row in rows {
        for anchor in row {
            words(mut b, anchor)
        }
    }
    b
}

fn attach_sub(first: []u8, second: []u8, classes: i64, marks: []u8, bases: []u8) -> []u8 {
    var b: []u8 = []
    let at = 12
    words(mut b, [1, at, at + first.len, classes, at + first.len + second.len, at + first.len + second.len + marks.len])
    append(mut b, first)
    append(mut b, second)
    append(mut b, marks)
    append(mut b, bases)
    b
}

fn lookup(kind: i64, subtables: [][]u8) -> []u8 {
    var b: []u8 = []
    words(mut b, [kind, 0, subtables.len])
    var at = 6 + 2 * subtables.len
    for s in subtables {
        io.put_be16(mut b, at)
        at += s.len
    }
    for s in subtables {
        append(mut b, s)
    }
    b
}

fn extension(kind: i64, inner: []u8) -> []u8 {
    var b: []u8 = []
    words(mut b, [1, kind])
    io.put_be32(mut b, 8)
    append(mut b, inner)
    b
}

fn list(tags: []str, items: [][]u8) -> []u8 {
    let record = if tags.len > 0 { 6 } else { 2 }
    var b: []u8 = []
    io.put_be16(mut b, items.len)
    var at = 2 + record * items.len
    for i in 0..items.len {
        if tags.len > 0 {
            tag(mut b, tags[i])
        }
        io.put_be16(mut b, at)
        at += items[i].len
    }
    for item in items {
        append(mut b, item)
    }
    b
}

fn script_table(s: Script) -> []u8 {
    var b: []u8 = []
    words(mut b, [4, 0, 0, 65535, s.features.len])
    words(mut b, s.features)
    b
}

fn feature_table(f: Feature) -> []u8 {
    var b: []u8 = []
    words(mut b, [0, f.lookups.len])
    words(mut b, f.lookups)
    b
}

fn layout(scripts: []Script, features: []Feature, lookups: [][]u8) -> []u8 {
    var script_tags: []str = []
    var script_tables: [][]u8 = []
    for s in scripts {
        script_tags.push(s.tag)
        script_tables.push(script_table(s))
    }
    var feature_tags: []str = []
    var feature_tables: [][]u8 = []
    for f in features {
        feature_tags.push(f.tag)
        feature_tables.push(feature_table(f))
    }
    let script_list = list(script_tags, script_tables)
    let feature_list = list(feature_tags, feature_tables)
    var b: []u8 = []
    io.put_be32(mut b, 65536)
    words(mut b, [10, 10 + script_list.len, 10 + script_list.len + feature_list.len])
    append(mut b, script_list)
    append(mut b, feature_list)
    append(mut b, list([], lookups))
    b
}

fn gdef() -> []u8 {
    var b: []u8 = []
    words(mut b, [1, 0, 12, 0, 0, 0])
    append(mut b, class1(5, [3, 3]))
    b
}

fn open(gpos_data: []u8, gdef_data: []u8) -> font.Font {
    var tables = [
        Table { tag: "head", data: head() }
        Table { tag: "hhea", data: hhea() }
        Table { tag: "maxp", data: maxp(30) }
        Table { tag: "cmap", data: cmap12() }
        Table { tag: "hmtx", data: hmtx() }
        Table { tag: "loca", data: zeros(62) }
        Table { tag: "glyf", data: zeros(0) }
    ]
    if gpos_data.len > 0 {
        tables.push(Table { tag: "GPOS", data: gpos_data })
    }
    if gdef_data.len > 0 {
        tables.push(Table { tag: "GDEF", data: gdef_data })
    }
    font.parse(str(assemble(tables))) or font.Font {}
}

fn mark_base_sub() -> []u8 {
    let marks = mark_array([record(0, anchor1(100, 0)), record(0, anchor1(150, 10)), record(1, anchor1(80, 200))])
    let bases = base_array(2, [[anchor1(300, 700), anchor1(300, -50)], [anchor2(310, 720, 3), []]])
    attach_sub(coverage1([5, 6, 7]), coverage2([1, 2, 0]), 2, marks, bases)
}

fn mark_mark_sub() -> []u8 {
    let marks = mark_array([record(0, anchor1(50, 0))])
    let bases = base_array(1, [[anchor3(120, 400)]])
    attach_sub(coverage1([6]), coverage1([5]), 1, marks, bases)
}

fn positioning(mark_lookups: [][]u8, mark_mark_lookups: [][]u8) -> []u8 {
    var lookups: [][]u8 = []
    var mark_indices: []i64 = []
    var mark_mark_indices: []i64 = []
    for l in mark_lookups {
        mark_indices.push(lookups.len)
        lookups.push(l)
    }
    for l in mark_mark_lookups {
        mark_mark_indices.push(lookups.len)
        lookups.push(l)
    }
    let features = [Feature { tag: "mark", lookups: mark_indices }, Feature { tag: "mkmk", lookups: mark_mark_indices }]
    layout([Script { tag: "latn", features: [0, 1] }], features, lookups)
}

fn standard() -> []u8 {
    positioning([lookup(4, [mark_base_sub()])], [lookup(6, [mark_mark_sub()])])
}

fn offset_text(f: font.Font, base: i64, mark: i64) -> str {
    match f.mark_offset(base, mark) {
        some(o) => "{o.x},{o.y}"
        none => "none"
    }
}

fn offsets(label: str, f: font.Font, pairs: []i64) {
    var line = label
    for i in 0..pairs.len / 2 {
        line = "{line} {pairs[2 * i]}+{pairs[2 * i + 1]}={offset_text(f, pairs[2 * i], pairs[2 * i + 1])}"
    }
    print(line)
}

fn marks(label: str, f: font.Font) {
    var line = label
    for g in 0..9 {
        line = "{line} {g}={f.is_mark(g)}"
    }
    print(line)
}

fn broken(what: str) -> str {
    var sub = mark_base_sub()
    if what == "mark coverage" {
        io.set_be16(sub, 2, 65535)
    } else if what == "base coverage" {
        io.set_be16(sub, 4, 65535)
    } else if what == "class count" {
        io.set_be16(sub, 6, 0)
    } else if what == "mark array" {
        io.set_be16(sub, 8, 65535)
    } else if what == "base array" {
        io.set_be16(sub, 10, 65535)
    } else if what == "format" {
        io.set_be16(sub, 0, 2)
    } else if what == "anchor offset" {
        io.set_be16(sub, 36, 65535)
    } else if what == "anchor format" {
        io.set_be16(sub, 46, 4)
    }
    var direct = lookup(4, [sub])
    if what == "subtable" {
        io.set_be16(direct, 6, 65535)
    }
    var ext = extension(4, sub)
    if what == "extension" {
        io.set_be32(ext, 4, 2147483647)
    } else if what == "extension type" {
        io.set_be16(ext, 2, 6)
    }
    let wrapped = lookup(9, [ext])
    let chosen = if what.len >= 9 && what[0..9] == "extension" { wrapped } else { direct }
    var data = positioning([chosen], [])
    if what == "script list" {
        io.set_be16(data, 4, 65535)
    } else if what == "feature list" {
        io.set_be16(data, 6, 65535)
    } else if what == "lookup list" {
        io.set_be16(data, 8, 65535)
    }
    offset_text(open(data, []), 1, 5)
}

fn truncated() {
    let data = standard()
    var none_count = 0
    var full = 0
    var other = 0
    for cut in 0..data.len + 1 {
        var part: []u8 = []
        for i in 0..cut {
            part.push(data[i])
        }
        let f = open(part, [])
        let mark = offset_text(f, 1, 5)
        let chain = offset_text(f, 5, 6)
        if mark == "none" && chain == "none" {
            none_count += 1
        } else if mark == "200,700" && chain == "70,400" {
            full += 1
        } else {
            other += 1
        }
    }
    print("truncated {data.len + 1}: none {none_count} full {full} other {other}")
}

fn main() {
    let f = open(standard(), gdef())
    offsets("mark to base", f, [1, 5, 1, 6, 1, 7, 2, 5, 2, 6, 2, 7])
    offsets("mark to mark", f, [5, 6, 5, 7, 6, 5, 6, 6])
    offsets("not covered", f, [3, 5, 1, 8, 9, 5, 0, 0, -1, 5, 1, 70000, 5, 5])
    marks("gdef", f)
    marks("coverage", open(standard(), []))
    marks("none", open([], []))
    marks("short gdef", open(standard(), [0, 1, 0, 0]))

    let wrapped = positioning([lookup(9, [extension(4, mark_base_sub())])], [lookup(9, [extension(6, mark_mark_sub())])])
    offsets("extension", open(wrapped, gdef()), [1, 5, 2, 5, 5, 6])

    let ordered = positioning([lookup(4, [mark_base_sub()]), lookup(4, [mark_base_sub()])], [])
    offsets("no mkmk", open(ordered, gdef()), [1, 5, 5, 6])

    let other = mark_array([record(0, anchor1(0, 0))])
    let first = attach_sub(coverage1([9]), coverage1([1]), 1, other, base_array(1, [[anchor1(10, 20)]]))
    let two = positioning([lookup(4, [first, mark_base_sub()])], [])
    offsets("subtables", open(two, gdef()), [1, 9, 1, 5, 2, 5])

    var line = "malformed"
    for what in ["intact", "script list", "feature list", "lookup list", "subtable", "mark coverage", "base coverage", "class count", "mark array", "base array", "format", "anchor offset", "anchor format", "extension", "extension type"] {
        line = "{line} {what}={broken(what)}"
    }
    print(line)
    truncated()
}
