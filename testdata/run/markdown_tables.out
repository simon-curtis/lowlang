--- alignment
<table>
<thead>
<tr>
<th align="left">L</th>
<th align="center">C</th>
<th align="right">R</th>
<th>D</th>
</tr>
</thead>
<tbody><tr>
<td align="left">a</td>
<td align="center">b</td>
<td align="right">c</td>
<td>d</td>
</tr>
<tr>
<td align="left">e</td>
<td align="center">f</td>
<td align="right">g</td>
<td>h</td>
</tr>
</tbody></table>

--- escaped pipes
<table>
<thead>
<tr>
<th>a</th>
<th>b</th>
</tr>
</thead>
<tbody><tr>
<td>x | y</td>
<td><code>p | q</code></td>
</tr>
</tbody></table>

--- code with pipe
<table>
<thead>
<tr>
<th>code</th>
<th>text</th>
</tr>
</thead>
<tbody><tr>
<td>`a</td>
<td>b`</td>
</tr>
</tbody></table>

--- inline content
<table>
<thead>
<tr>
<th><em>em</em></th>
<th><a href="/u">l</a></th>
</tr>
</thead>
<tbody><tr>
<td><strong>b</strong></td>
<td><del>s</del></td>
</tr>
</tbody></table>

--- short and long rows
<table>
<thead>
<tr>
<th>a</th>
<th>b</th>
</tr>
</thead>
<tbody><tr>
<td>only</td>
<td></td>
</tr>
<tr>
<td>1</td>
<td>2</td>
</tr>
</tbody></table>

--- no outer pipes
<table>
<thead>
<tr>
<th>a</th>
<th>b</th>
</tr>
</thead>
<tbody><tr>
<td>1</td>
<td>2</td>
</tr>
</tbody></table>

--- table ends at blank
<table>
<thead>
<tr>
<th>a</th>
</tr>
</thead>
<tbody><tr>
<td>1</td>
</tr>
</tbody></table>
<p>paragraph</p>

--- table ends at quote
<table>
<thead>
<tr>
<th>a</th>
</tr>
</thead>
<tbody><tr>
<td>1</td>
</tr>
</tbody></table>
<blockquote>
<p>quote</p>
</blockquote>

--- not a table
<p>| a | b |
|---|
| 1 | 2 |</p>

header h1 h1
header h2 h2
cell *a* a
cell b b
