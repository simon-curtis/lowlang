extern "c" {
    fn malloc(n: i64) -> ptr
    fn free(p: ptr)
    fn snprintf(buf: ptr[u8], n: i64, format: ptr[u8], ...) -> i32
}

extern "m" {
    fn fma(a: f64, b: f64, c: f64) -> f64
    fn pow(x: f64, y: f64) -> f64
    fn hypot(x: f64, y: f64) -> f64
    fn copysign(x: f64, y: f64) -> f64
    fn fmaf(a: f32, b: f32, c: f32) -> f32
    fn sqrtf(x: f32) -> f32
    fn ldexp(x: f64, exponent: i32) -> f64
}

fn weigh(a: f64, b: f64, c: f64, d: f64, e: f64, f: f64, g: f64, h: f64) -> f64 {
    a + b * 2.0 + c * 3.0 + d * 4.0 + e * 5.0 + f * 6.0 + g * 7.0 + h * 8.0
}

fn crossed(x: f64, y: f64, p: f64, q: f64) -> f64 {
    let weigh_fn: extern fn(f64, f64, f64, f64, f64, f64, f64, f64) -> f64 = weigh
    let u = x + 0.25
    let v = y + 0.5
    let s = p * 1.5
    let t = q - 0.75
    let a = weigh_fn(u, v, t, s, v, u, s, t)
    let b = weigh_fn(v, u, s, t, u, v, t, s)
    a * 1000.0 + b
}

fn swapped(x: f64, y: f64, p: f64, q: f64) -> f64 {
    let u = x + 0.25
    let v = y + 0.5
    let s = p * 1.5
    let t = q - 0.75
    let a = fma(u, v, s)
    let b = fma(v, u, t)
    let c = fma(s, t, u)
    let d = fma(t, s, v)
    a + b * 10.0 + c * 100.0 + d * 1000.0
}

fn swapped_four(x: f64, y: f64) -> f64 {
    let weigh_fn: extern fn(f64, f64, f64, f64, f64, f64, f64, f64) -> f64 = weigh
    let u = x * 1.25
    let v = y * 1.5
    weigh_fn(v, u, v, u, u, v, u, v)
}

fn swapped_pair(x: f64, y: f64) -> f64 {
    let u = x * 1.25
    let v = y * 1.5
    pow(v, u)
}

fn across_calls(x: f64, y: f64) -> f64 {
    let first = pow(x, y)
    let second = hypot(first, x)
    let third = copysign(second, 0.0 - y)
    let fourth = ldexp(third, 2)
    first + second + third + fourth + x * y
}

fn single(a: f32, b: f32, c: f32) -> f32 {
    let r = fmaf(a, b, c)
    let s = sqrtf(r)
    r + s + fmaf(s, a, b)
}

fn formatted(x: f64, y: f64, z: f32) -> str {
    let buf: ptr[u8] = malloc(128)
    let n = snprintf(buf, 128, cstr("%.3f|%.3f|%.3f|%d"), x * 2.0, y + 1.0, f64(z) * 4.0, 7)
    let text = str(buf)
    free(buf)
    text
}

fn main() {
    print(crossed(1.5, 2.5, 3.5, 4.5))
    print(swapped(1.5, 2.5, 3.5, 4.5))
    print(swapped_four(1.5, 2.5))
    print(swapped_pair(1.5, 2.5))
    print(across_calls(2.0, 3.0))
    print(single(2.0, 3.0, 1.0))
    print(formatted(1.5, 2.5, 0.25))
}
