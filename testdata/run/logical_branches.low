fn kind(c: u8, depth: i64) -> i64 {
    if depth > 0 {
        return kind(c, depth - 1)
    }
    if c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c == '_' {
        return 1
    }
    if !(c >= '0' && c <= '9') && c != '.' {
        return 2
    }
    3
}

fn main() {
    let samples = "aZ_9.-q"
    for i in 0..samples.len {
        print("{samples[i..i + 1]} {kind(samples[i], i % 2)}")
    }
}
