import assets

fn checksum(s: str) -> i64 {
    var total = 0
    for i in 0..s.len {
        total = (total * 31 + i64(s[i])) % 1000000007
    }
    total
}

fn main() {
    let greeting = embed("greeting.txt")
    print(greeting)
    print(greeting.len)
    let blob = embed("data/blob.bin")
    print(blob.len)
    print(blob[0])
    print(blob[255])
    print(blob[blob.len - 1])
    print(checksum(blob))
    print(assets.banner())
    print(embed("greeting.txt") == greeting)
}
