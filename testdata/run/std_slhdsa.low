import std/crypto/hash
import std/crypto/prehash
import std/crypto/slhdsa
import std/io
import std/slices
import std/text

fn unhex(s: str) -> u8[] {
    if s == "-" {
        return []
    }
    text.decode_hex(s) or []
}

fn level_of(s: str) -> slhdsa.Level {
    match s {
        "sha2_128s" => Sha2_128s
        "sha2_128f" => Sha2_128f
        "sha2_192s" => Sha2_192s
        "sha2_192f" => Sha2_192f
        "sha2_256s" => Sha2_256s
        "sha2_256f" => Sha2_256f
        "shake_128s" => Shake_128s
        "shake_128f" => Shake_128f
        "shake_192s" => Shake_192s
        "shake_192f" => Shake_192f
        "shake_256s" => Shake_256s
        _ => Shake_256f
    }
}

fn name_of(lv: slhdsa.Level) -> str {
    match lv {
        Sha2_128s => "SLH-DSA-SHA2-128s"
        Sha2_128f => "SLH-DSA-SHA2-128f"
        Sha2_192s => "SLH-DSA-SHA2-192s"
        Sha2_192f => "SLH-DSA-SHA2-192f"
        Sha2_256s => "SLH-DSA-SHA2-256s"
        Sha2_256f => "SLH-DSA-SHA2-256f"
        Shake_128s => "SLH-DSA-SHAKE-128s"
        Shake_128f => "SLH-DSA-SHAKE-128f"
        Shake_192s => "SLH-DSA-SHAKE-192s"
        Shake_192f => "SLH-DSA-SHAKE-192f"
        Shake_256s => "SLH-DSA-SHAKE-256s"
        Shake_256f => "SLH-DSA-SHAKE-256f"
    }
}

fn has_shapes(lv: slhdsa.Level) -> bool {
    match lv {
        Sha2_128f => true
        Shake_192f => true
        _ => false
    }
}

fn verify_only(lv: slhdsa.Level) -> bool {
    match lv {
        Shake_128s => true
        Sha2_192s => true
        Shake_256s => true
        _ => false
    }
}

fn hash_of(s: str) -> prehash.Hash {
    match s {
        "sha224" => Sha224
        "sha256" => Sha256
        "sha384" => Sha384
        "sha512" => Sha512
        "sha512_224" => Sha512_224
        "sha512_256" => Sha512_256
        "sha3_224" => Sha3_224
        "sha3_256" => Sha3_256
        "sha3_384" => Sha3_384
        "sha3_512" => Sha3_512
        "shake128" => Shake128
        _ => Shake256
    }
}

fn digest_hex(b: u8[]) -> str {
    text.encode_hex(hash.sum(hash.sha256(), b))
}

fn randomness_of(s: str) -> slhdsa.Randomness {
    if s == "-" {
        return Deterministic
    }
    Given(unhex(s))
}

fn verdict(label: str, ok: bool) {
    let word = if ok { "ok" } else { "FAIL" }
    print("{label}: {word}")
}

fn keygen(f: str[], n: i64) {
    let keys = slhdsa.generate_seeded(level_of(f[1]), unhex(f[2])) or return
    let ok = hash.equal(keys.public, unhex(f[3])) && hash.equal(keys.private, unhex(f[4])) && hash.equal(keys.seed, unhex(f[2]))
    verdict("keygen {f[1]} {n}", ok)
}

fn sign_vector(f: str[]) -> u8[] ! io.Error {
    let lv = level_of(f[2])
    let rnd = randomness_of(f[3])
    let sk = unhex(f[4])
    match f[1] {
        "pure" => slhdsa.sign(lv, sk, unhex(f[5]), unhex(f[6]), rnd)
        "prehash" => slhdsa.sign_prehash(lv, sk, unhex(f[5]), unhex(f[6]), hash_of(f[7]), rnd)
        _ => slhdsa.sign_internal(lv, sk, unhex(f[5]), rnd)
    }
}

fn verify_vector(kind: str, lv: slhdsa.Level, pk: u8[], message: u8[], context: u8[], h: str, sig: u8[]) -> bool {
    match kind {
        "pure" => slhdsa.verify(lv, pk, message, context, sig)
        "prehash" => slhdsa.verify_prehash(lv, pk, message, context, hash_of(h), sig)
        _ => slhdsa.verify_internal(lv, pk, message, sig)
    }
}

fn flipped(b: u8[], at: i64) -> u8[] {
    let c = slices.clone(b)
    c[at] ^= u8(1 << (at & 7))
    c
}

fn corrupted(kind: str, lv: slhdsa.Level, pk: u8[], message: u8[], context: u8[], h: str, sig: u8[]) {
    let name = name_of(lv)
    var accepted = 0
    var tried = 0
    let step = sig.len / 64
    var at = 0
    for at < sig.len {
        tried += 1
        if verify_vector(kind, lv, pk, message, context, h, flipped(sig, at)) {
            accepted += 1
        }
        at += step
    }
    print("{name} signature single-bit corruptions accepted: {accepted} of {tried}")
    accepted = 0
    for i in 0..pk.len {
        if verify_vector(kind, lv, flipped(pk, i), message, context, h, sig) {
            accepted += 1
        }
    }
    print("{name} public key single-bit corruptions accepted: {accepted} of {pk.len}")
    verdict("{name} truncated signature", !verify_vector(kind, lv, pk, message, context, h, sig[..sig.len - 1]))
    verdict("{name} empty signature", !verify_vector(kind, lv, pk, message, context, h, []))
    var extended = slices.clone(sig)
    extended.push(0)
    verdict("{name} extended signature", !verify_vector(kind, lv, pk, message, context, h, extended))
    verdict("{name} truncated public key", !verify_vector(kind, lv, pk[..pk.len - 1], message, context, h, sig))
    verdict("{name} other message", !verify_vector(kind, lv, pk, flipped(message, 0), context, h, sig))
}

fn siggen(f: str[], n: i64) {
    let sig = sign_vector(f) or return
    let lv = level_of(f[2])
    let pk = unhex(f[4])[slhdsa.public_key_size(lv)..]
    verdict("siggen {f[1]} {f[2]} {f[7]} {n}", digest_hex(sig) == f[8])
    verdict("siggen {f[1]} {f[2]} {f[7]} {n} verifies", verify_vector(f[1], lv, pk, unhex(f[5]), unhex(f[6]), f[7], sig))
    if f[1] == "pure" {
        corrupted("pure", lv, pk, unhex(f[5]), unhex(f[6]), f[7], sig)
    }
}

fn sigver(f: str[], n: i64, mut corrupted_levels: [str: bool]) {
    let expected = f[8] == "1"
    let lv = level_of(f[2])
    let sig = unhex(f[7])
    let got = verify_vector(f[1], lv, unhex(f[3]), unhex(f[4]), unhex(f[5]), f[6], sig)
    verdict("sigver {f[1]} {f[2]} expect {expected} {n}", got == expected)
    if expected && got && verify_only(lv) && !(corrupted_levels[f[2]] ?? false) {
        corrupted_levels[f[2]] = true
        corrupted(f[1], lv, unhex(f[3]), unhex(f[4]), unhex(f[5]), f[6], sig)
    }
}

fn seeded(f: str[], n: i64) {
    let lv = level_of(f[1])
    let keys = slhdsa.generate_seeded(lv, unhex(f[2])) or return
    let sig = slhdsa.sign(lv, keys.private, unhex(f[3]), unhex(f[4]), Deterministic) or return
    let ok = digest_hex(keys.public) == f[5] && digest_hex(sig) == f[6]
    verdict("openssl {f[1]} {n}", ok)
}

fn vectors() {
    var n = 0
    var corrupted_levels: [str: bool] = [:]
    for line in text.lines(embed("std_slhdsa_vectors.txt")) {
        let f = text.fields(line)
        n += 1
        match f[0] {
            "keygen" => keygen(f, n)
            "siggen" => siggen(f, n)
            "sigver" => sigver(f, n, mut corrupted_levels)
            _ => seeded(f, n)
        }
    }
}

fn seed_for(lv: slhdsa.Level) -> u8[] {
    var out: u8[] = []
    for i in 0..3 * slhdsa.public_key_size(lv) / 2 {
        out.push(u8(i * 7 + 3))
    }
    out
}

fn sign_fails(lv: slhdsa.Level, sk: u8[], message: u8[], context: u8[], rnd: slhdsa.Randomness) -> bool {
    slhdsa.sign(lv, sk, message, context, rnd) catch {
        Invalid => return true
        _ => return false
    }
    false
}

fn seed_fails(lv: slhdsa.Level, seed: u8[]) -> bool {
    slhdsa.generate_seeded(lv, seed) catch {
        Invalid => return true
        _ => return false
    }
    false
}

fn generated(lv: slhdsa.Level) {
    let name = name_of(lv)
    let keys = slhdsa.generate(lv)
    let n = slhdsa.public_key_size(lv) / 2
    verdict("{name} generated key sizes", keys.public.len == 2 * n && keys.private.len == 4 * n && keys.seed.len == 3 * n)
    if has_shapes(lv) {
        let again = slhdsa.generate_seeded(lv, keys.seed) or return
        verdict("{name} generated key is reproducible from its seed", hash.equal(keys.public, again.public) && hash.equal(keys.private, again.private))
    }
    verdict("{name} public key is the tail of the private key", hash.equal(keys.public, keys.private[2 * n..]))
    verdict("{name} short seed", seed_fails(lv, keys.seed[..keys.seed.len - 1]))
    print("{name} sizes {slhdsa.public_key_size(lv)} {slhdsa.private_key_size(lv)} {slhdsa.signature_size(lv)}")
}

fn shapes(lv: slhdsa.Level) {
    let name = name_of(lv)
    let keys = slhdsa.generate_seeded(lv, seed_for(lv)) or return
    let message = bytes("message")
    let a = slhdsa.sign(lv, keys.private, message, [], Deterministic) or return
    let b = slhdsa.sign(lv, keys.private, message, [], Deterministic) or return
    verdict("{name} deterministic signing repeats", hash.equal(a, b))
    verdict("{name} signature length", a.len == slhdsa.signature_size(lv))
    verdict("{name} deterministic signature verifies", slhdsa.verify(lv, keys.public, message, [], a))
    let c = slhdsa.sign(lv, keys.private, message, [], Hedged) or return
    let d = slhdsa.sign(lv, keys.private, message, [], Hedged) or return
    verdict("{name} hedged signing differs", !hash.equal(c, d) && !hash.equal(c, a))
    verdict("{name} hedged signatures verify", slhdsa.verify(lv, keys.public, message, [], c) && slhdsa.verify(lv, keys.public, message, [], d))
    let long = slices.repeat([u8(7)], 255)
    let longer = slices.repeat([u8(7)], 256)
    let at_limit = slhdsa.sign(lv, keys.private, message, long, Deterministic) or return
    verdict("{name} context of 255 bytes", slhdsa.verify(lv, keys.public, message, long, at_limit))
    verdict("{name} context of 256 bytes cannot be signed", sign_fails(lv, keys.private, message, longer, Deterministic))
    verdict("{name} context of 256 bytes does not verify", !slhdsa.verify(lv, keys.public, message, longer, at_limit))
    let short = slices.repeat([u8(1)], keys.public.len / 2 - 1)
    verdict("{name} short randomness", sign_fails(lv, keys.private, message, [], Given(short)))
    verdict("{name} short private key", sign_fails(lv, keys.private[..10], message, [], Deterministic))
    let ph = slhdsa.sign_prehash(lv, keys.private, message, [], Sha256, Hedged) or return
    verdict("{name} pre-hash signature", slhdsa.verify_prehash(lv, keys.public, message, [], Sha256, ph))
    verdict("{name} pre-hash with another hash", !slhdsa.verify_prehash(lv, keys.public, message, [], Sha512, ph))
    verdict("{name} pre-hash signature is not a pure signature", !slhdsa.verify(lv, keys.public, message, [], ph))
    verdict("{name} pure signature is not a pre-hash signature", !slhdsa.verify_prehash(lv, keys.public, message, [], Sha256, a))
    verdict("{name} other context", !slhdsa.verify(lv, keys.public, message, bytes("c"), a))
}

fn main() {
    vectors()
    for lv in [
        slhdsa.Level.Sha2_128s, Sha2_128f, Sha2_192s, Sha2_192f, Sha2_256s, Sha2_256f,
        Shake_128s, Shake_128f, Shake_192s, Shake_192f, Shake_256s, Shake_256f,
    ] {
        generated(lv)
        if has_shapes(lv) {
            shapes(lv)
        }
    }
}
