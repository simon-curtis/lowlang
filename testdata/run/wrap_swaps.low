fn ident(x: f64) -> f64 {
    x
}

fn run(n: i64) -> f64 {
    var a = 1.5
    var b = 2.25
    var c = -0.5
    var d = 4.0
    var s = 0.0
    for i in 0..n {
        let t = a
        a = b
        b = c
        c = d
        d = t
        if i % 3 == 0 {
            s = s + a * 0.5
        } else {
            let u = c
            c = d
            d = u
        }
    }
    s + a * 1000.0 + b * 100.0 + c * 10.0 + ident(d)
}

fn mix(n: i64) -> i64 {
    var x = 1
    var f = 0.5
    var g = 3.0
    for i in 0..n {
        let ox = x
        x = i64(f) + i
        f = g
        g = f64(ox) + 0.25
    }
    x + i64(f * 4.0) + i64(g * 8.0)
}

fn main() {
    print(run(10))
    print(run(1001))
    print(mix(17))
    print(mix(1000))
}
