fn flood(out: chan[i64], id: i64, stop: chan[bool]) {
    for {
        out <- id
        let halted = select {
            <-stop => true
            else => false
        }
        if halted {
            return
        }
    }
}

fn tally(producers: i64, capacity: i64, receives: i64) {
    let out = chan[i64](capacity)
    let stop = chan[bool]()
    var seen: []i64 = []
    for p in 0..producers {
        push(mut seen, 0)
        spawn flood(out, p, stop)
    }
    for i in 0..receives {
        let id = (<-out) ?? 0
        seen[id] += 1
    }
    close(stop)
    var starved = 0
    for p in 0..producers {
        if seen[p] == 0 {
            starved += 1
        }
    }
    print("{producers} {capacity} starved {starved}")
}

fn main() {
    tally(2, 0, 20000)
    tally(8, 0, 40000)
    tally(8, 4, 40000)
    tally(32, 0, 40000)
    tally(32, 16, 40000)
    tally(64, 8, 40000)
}
