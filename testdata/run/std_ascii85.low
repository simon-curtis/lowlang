import std/ascii85
import std/text

fn hex(s: str) -> []u8 {
    text.decode_hex(s) catch {
        _ => []
    }
}

fn describe(e: ascii85.Error) -> str {
    match e {
        BadCharacter(at) => "bad character at {at}"
        BadLength => "bad length"
        BadFrame => "bad frame"
        Overflow(at) => "overflow at {at}"
    }
}

fn decoded(s: str) {
    let out = ascii85.decode(s) catch {
        e => {
            print("[{s}] {describe(e)}")
            return
        }
    }
    print("[{s}] {text.encode_hex(out)}")
}

fn z85_decoded(s: str) {
    let out = ascii85.decode_z85(s) catch {
        e => {
            print("[{s}] {describe(e)}")
            return
        }
    }
    print("[{s}] {text.encode_hex(out)}")
}

fn z85_encoded(h: str) {
    let out = ascii85.encode_z85(hex(h)) catch {
        e => {
            print("{h} {describe(e)}")
            return
        }
    }
    print("{h} {out}")
}

fn main() {
    for h in [
        "", "61", "6162", "616263", "61626364", "6162636465", "00000000", "0000000000", "000000", "000000000000",
        "4d616e2069732064697374696e67756973686564", "ffffffff", "ffffff", "00000001", "68656c6c6f2c20776f726c64",
        "000102030405060708090a0b0c0d0e0f10111213",
    ] {
        let data = hex(h)
        let plain = ascii85.encode(data)
        let framed = ascii85.encode_adobe(data)
        let back = ascii85.decode(plain) catch { _ => [0xEE] }
        let back_framed = ascii85.decode(framed) catch { _ => [0xEE] }
        let same = text.encode_hex(back) == h && text.encode_hex(back_framed) == h
        print("{h} {plain} {framed} {same}")
    }

    decoded("<~87cURD]i,\"Ebo80~>")
    decoded("87cUR D]i,\"E bo80")
    decoded("  <~\n87cURD]i,\"Ebo80\n~>\n")
    decoded("zz")
    decoded("!!!!!z")
    decoded("s8W-!")
    decoded("s8W-\"")
    decoded("uuuuu")
    decoded("s8W")
    decoded("s8W-")
    decoded("!")
    decoded("@:E^~")
    decoded("<~@:E^")
    decoded("@:E^~>")
    decoded("<~~>")
    decoded("<~>")
    decoded("@:Ev")
    decoded("@:E\n")
    decoded("@z:E")

    z85_encoded("864fd26fb559f75b")
    z85_encoded("00000000")
    z85_encoded("ffffffff")
    z85_encoded("")
    z85_encoded("8645")
    z85_decoded("HelloWorld")
    z85_decoded("00000")
    z85_decoded("#####")
    z85_decoded("%nSc0")
    z85_decoded("Hello")
    z85_decoded("Hell")
    z85_decoded("Hel~o")
    z85_decoded("")
    z85_decoded("{{{{{{{{{{")
}
