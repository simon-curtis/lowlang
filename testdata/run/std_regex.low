import std/regex
import std/text

fn esc(s: str) -> str {
    if s.len > 64 {
        return "{esc(s[..32])}...({s.len} bytes)"
    }
    s |> text.replace("\n", "\\n") |> text.replace("\r", "\\r") |> text.replace("\t", "\\t")
}

fn flags(spec: str) -> regex.Flags {
    regex.Flags { ignore_case: text.contains(spec, "i"), multiline: text.contains(spec, "m"), dot_all: text.contains(spec, "s") }
}

fn compiled(pattern: str, spec: str) -> regex.Regex? {
    let re = regex.compile_with(pattern, flags(spec)) catch {
        Invalid(at, message) => {
            print("  error at {at}: {message}")
            return none
        }
    }
    re
}

fn show(m: regex.Match, groups: i64) -> str {
    var out = "{m.start()}..{m.end()} [{esc(m.text())}]"
    for g in 1..groups + 1 {
        let part = match m.span(g) {
            some(s) => "{g}={s.start}..{s.end}"
            none => "{g}=-"
        }
        out = "{out} {part}"
    }
    out
}

fn show_found(found: regex.Match?, groups: i64) -> str {
    match found {
        some(m) => show(m, groups)
        none => "none"
    }
}

fn case_find(pattern: str, spec: str, input: str) {
    print("find /{esc(pattern)}/{spec} [{esc(input)}]")
    let re = compiled(pattern, spec) ?? return
    print("  {show_found(re.find(input), re.group_count())}")
}

fn case_full(pattern: str, spec: str, input: str) {
    print("full /{esc(pattern)}/{spec} [{esc(input)}]")
    let re = compiled(pattern, spec) ?? return
    print("  {show_found(re.full_match(input), re.group_count())}")
}

fn case_test(pattern: str, spec: str, input: str) {
    print("test /{esc(pattern)}/{spec} [{esc(input)}]")
    let re = compiled(pattern, spec) ?? return
    print("  {re.is_match(input)}")
}

fn case_all(pattern: str, spec: str, input: str) {
    print("all /{esc(pattern)}/{spec} [{esc(input)}]")
    let re = compiled(pattern, spec) ?? return
    for m in re.find_all(input) {
        print("  {show(m, re.group_count())}")
    }
}

fn case_sub(pattern: str, spec: str, input: str, with: str) {
    print("sub /{esc(pattern)}/{spec} [{esc(input)}] [{esc(with)}]")
    let re = compiled(pattern, spec) ?? return
    let out = re.replace_all(input, fn(m: regex.Match) -> str { with })
    print("  [{esc(out)}]")
}

fn case_wrap(pattern: str, spec: str, input: str) {
    print("wrap /{esc(pattern)}/{spec} [{esc(input)}]")
    let re = compiled(pattern, spec) ?? return
    let out = re.replace_all(input, fn(m: regex.Match) -> str { "<{m.text()}:{m.start()}>" })
    print("  [{esc(out)}]")
}

fn case_split(pattern: str, spec: str, input: str, max: i64) {
    print("split /{esc(pattern)}/{spec} [{esc(input)}] {max}")
    let re = compiled(pattern, spec) ?? return
    let parts = if max < 0 { re.split(input) } else { re.split_n(input, max) }
    for p in parts {
        print("  [{esc(p)}]")
    }
}

fn main() {
    case_find("(a+)(b)?", "", "xxaab")
    case_find("(a+)(b)?", "", "xxaac")
    case_find("(a)|(b)", "", "b")
    case_find("(a)?b", "", "b")
    case_find("(a*)+", "", "b")
    case_find("(a*)*", "", "b")
    case_find("(a|b)*", "", "abc")
    case_find("((a)|b)+", "", "ab")
    case_find("(a|ab)(c|bcd)(d*)", "", "abcd")
    case_find("(?:(a)|(b)|(c))+", "", "abcab")
    case_find("()", "", "x")
    case_full("(a)(?:x(b))?(c)?", "", "a")
    case_full("(a+)(a*)", "", "aaaa")
    case_full("(a+?)(a*)", "", "aaaa")
    case_full("(a|ab)(c|bcd)(d*)", "", "abcd")
    case_full("a|ab", "", "ab")
    case_find("a|ab", "", "ab")
    case_find("ab|a", "", "ab")
    case_find("(?:a|ab)c", "", "abc")
    case_find("a+", "", "baaa")
    case_find("a+?", "", "baaa")
    case_find("a*?b", "", "aaab")
    case_find("<.+>", "", "<a><b>")
    case_find("<.+?>", "", "<a><b>")
    case_find("a{{2,4}}", "", "aaaaa")
    case_find("a{{2,4}}?", "", "aaaaa")
    case_find("a{{2,}}?", "", "aaaaa")
    case_find("a??b", "", "ab")
    case_find("(a??)(a*)", "", "aa")
    case_find("(a*?)(a*?)$", "", "aa")
    case_all("a{{3}}", "", "aaaaaaa")
    case_all("a{{,2}}", "", "aaaaa")
    case_all("a{{2,}}", "", "a aa aaa")
    case_all("a{{,}}", "", "baab")
    case_all("a{{", "", "a{{ a{{x}} a{{1,2x}}")
    case_all("x{{1, 2}}", "", "x{{1, 2}}")
    case_all("{{", "", "a{{b}}")
    case_all("\\d+|[a-z]+", "", "abc123def45")
    case_all("a*", "", "baaac")
    case_all("", "", "ab")
    case_all("\\b", "", "hi there")
    case_all("x*", "", "axxb")
    case_all("|a", "", "aa")
    case_all("a|", "", "aba")
    case_all("", "", "hé😀")
    case_sub("x*", "", "abxd", "-")
    case_sub("", "", "abc", "-")
    case_sub("a|", "", "baac", "-")
    case_wrap("\\d+", "", "a1b22c333")
    case_wrap("a*", "", "baac")
    case_split("x*", "", "axbc", -1)
    case_split("\\b", "", "a b", -1)
    case_split(",", "", "a,b,,c,", -1)
    case_split(",", "", "a,b,,c,", 2)
    case_split("\\s*", "", "a b  c", -1)
    case_split("", "", "abc", -1)
    case_split("", "", "abc", 2)
    case_split("z", "", "abc", -1)
    case_split("[,;]\\s*", "", "", -1)
    case_all(".", "", "hé😀\n!")
    case_all(".", "s", "a\nb")
    case_find("h.llo", "", "héllo")
    case_find("a.b", "", "a😀b")
    case_all("[à-ÿ]+", "", "naïve café über")
    case_all("[^a-z]", "", "aéb中c")
    case_all("[\\U0001F600-\\U0001F602]", "", "x😀😁😃")
    case_all("[é中]", "", "é中文")
    case_all("\\w+", "", "héllo wörld_1")
    case_all("\\W", "", "aé-")
    case_find("\\x41é\\t", "", "zAé\tz")
    case_find("é+", "i", "Ééé")
    case_all("^a", "m", "a\nb\na")
    case_all("^a", "", "a\nb\na")
    case_all("$", "", "a\nb\n")
    case_all("$", "m", "a\nb\n")
    case_all("^", "m", "a\n\nb\n")
    case_find("a$", "", "a\n")
    case_find("a$", "", "a\n\n")
    case_find("a\\Z", "", "a\n")
    case_find("\\Aa", "m", "b\na")
    case_find("^b", "m", "a\nb")
    case_all("\\Bb\\B", "", "abc b bbb")
    case_all("\\bfoo\\b", "", "foo foobar barfoo (foo)")
    case_find("(?i)hello", "", "say HeLLo")
    case_find("hello", "i", "say HeLLo")
    case_find("(?i:a)b", "", "AB Ab")
    case_find("a(?i)b", "", "aB")
    case_find("(?i)a(?-i)b", "", "AB Ab")
    case_find("(?i)[^a]", "", "Ab")
    case_all("[a-c]+", "i", "xABCabcD")
    case_all("[^\\W\\d_]+", "", "ab12_cd")
    case_all("[\\d\\s]+", "", "a1 2\tb")
    case_find("(?s)a.b", "", "a\nb")
    case_find("a.b", "", "a\nb")
    case_find("(?m)^b$", "", "a\nb\nc")
    case_find("(?ms)^a.b$", "", "x\na\nb\ny")
    case_all("[]a]", "", "a]b")
    case_all("[a-]", "", "a-b")
    case_all("[-a]", "", "a-b")
    case_all("[.]|\\.", "", "a.b")
    case_all("[^]]", "", "a]b")
    case_all("\\(\\)\\[\\]\\{{\\}}\\*\\+\\?\\|\\^\\$\\\\", "", "x()[]{{}}*+?|^$\\x")
    case_test("needle", "", "haystack with needle inside")
    case_test("needle", "", "haystack")
    case_test("^$", "", "")
    case_find("(a+)+$", "", "{text.repeat("a", 30)}!")
    case_find("(x+x+)+y", "", text.repeat("x", 5000))
    case_find("(a|aa)*c", "", "{text.repeat("a", 5000)}b")
    case_find("(a*)*b", "", text.repeat("a", 5000))
    case_find("(a+)+$", "", text.repeat("a", 10000))
    case_all("(?:a?){{30}}a{{30}}", "", text.repeat("a", 30))
}
