import std/io
import std/protobuf
import std/text

fn reference() -> str {
    ""
}

fn inner(e: *protobuf.Encoder, field: i64, name: str, id: i32) {
    let mark = e.begin_message(field)
    if name.len > 0 {
        e.write_string(1, name)
    }
    if id != 0 {
        e.write_int32(2, id)
    }
    e.end_message(mark)
}

fn encode_all() -> []u8 {
    let e = protobuf.encoder_with(8)
    e.write_uint64(1, 18446744073709551615)
    e.write_int64(2, -2)
    e.write_int32(3, -1)
    e.write_sint64(4, -64)
    e.write_bool(5, true)
    e.write_fixed64(6, 81985529216486895)
    e.write_sfixed64(7, -3)
    e.write_fixed32(8, 3735928559)
    e.write_sfixed32(9, -5)
    e.write_double(10, 3.14159)
    e.write_float(11, -2.5)
    e.write_string(12, "héllo")
    e.write_bytes(13, [0, 1, 255])
    inner(e, 14, "in", 300)
    e.write_packed_varints(15, [0, 1, 127, 128, 16384])
    e.write_packed_sint64(16, [-1, 1, -9223372036854775807 - 1, 9223372036854775807])
    e.write_packed_fixed64(17, [1, 18446744073709551615])
    e.write_packed_doubles(18, [0.5, -1e300])
    e.write_packed_fixed32(19, [7, 4294967295])
    inner(e, 20, "a", 0)
    inner(e, 20, "", 1)
    e.write_uint64(536870911, 150)
    e.encoded()
}

fn describe(f: protobuf.Field) -> str ! io.Error {
    let n = f.number
    if n == 1 { return "u64 {f.as_uint64()?}" }
    if n == 2 { return "i64 {f.as_int64()?}" }
    if n == 3 { return "i32 {f.as_int32()?}" }
    if n == 4 { return "s64 {f.as_sint64()?}" }
    if n == 5 { return "b {f.as_bool()?}" }
    if n == 6 { return "f64 {f.as_fixed64()?}" }
    if n == 7 { return "sf64 {i64(f.as_fixed64()?)}" }
    if n == 8 { return "f32 {f.as_fixed32()?}" }
    if n == 9 { return "sf32 {i32(f.as_fixed32()?)}" }
    if n == 10 { return "d {f.as_double()?}" }
    if n == 11 { return "fl {f64(f.as_float()?)}" }
    if n == 12 { return "s {f.as_string()?}" }
    if n == 13 { return "by {text.encode_hex(f.as_bytes()?)}" }
    if n == 14 || n == 20 {
        let d = f.as_message()?
        var parts: []str = []
        for {
            let g = match d.next()? {
                some(x) => x
                none => break
            }
            if g.number == 1 {
                push(mut parts, "name={g.as_string()?}")
            } else {
                push(mut parts, "id={g.as_int32()?}")
            }
        }
        return "msg {n} {text.join(parts, " ")}"
    }
    if n == 15 { return "pv {join_u64(f.unpack_varints()?)}" }
    if n == 16 {
        var parts: []str = []
        for v in f.unpack_varints()? {
            push(mut parts, "{protobuf.unzigzag(v)}")
        }
        return "ps {text.join(parts, ",")}"
    }
    if n == 17 { return "pf {join_u64(f.unpack_fixed64()?)}" }
    if n == 18 {
        var parts: []str = []
        for v in f.unpack_doubles()? {
            push(mut parts, "{v}")
        }
        return "pd {text.join(parts, ",")}"
    }
    if n == 19 {
        var parts: []str = []
        for v in f.unpack_fixed32()? {
            push(mut parts, "{v}")
        }
        return "pf32 {text.join(parts, ",")}"
    }
    "field {n} {f.value}"
}

fn join_u64(values: []u64) -> str {
    var parts: []str = []
    for v in values {
        push(mut parts, "{v}")
    }
    text.join(parts, ",")
}

fn decode_all(data: []u8) ! io.Error {
    let d = protobuf.decoder(data)
    for {
        let f = match d.next()? {
            some(x) => x
            none => break
        }
        print(describe(f)?)
    }
}

fn outcome(data: []u8) -> str {
    let d = protobuf.decoder(data)
    for {
        let f = d.next() catch {
            Malformed => return "malformed"
            Unsupported => return "unsupported"
            _ => return "other"
        }
        match f {
            some(_) => {}
            none => return "ok"
        }
    }
}

fn varints() {
    let samples: []u64 = [0, 1, 127, 128, 300, 16383, 16384, 4294967295, 18446744073709551615]
    for v in samples {
        let e = protobuf.encoder()
        e.put_varint(v)
        var at = 0
        let back = protobuf.read_varint(e.encoded(), mut at) or 0
        print("varint {v} {text.encode_hex(e.encoded())} size {protobuf.varint_size(v)} back {back} at {at}")
    }
    for v in [0, -1, 1, -2, 2147483647, -2147483648, 9223372036854775807, -9223372036854775807 - 1] {
        print("zigzag {v} {protobuf.zigzag(v)} {protobuf.unzigzag(protobuf.zigzag(v))}")
    }
}

fn large_nested() {
    let e = protobuf.encoder_with(4)
    let outer = e.begin_message(1)
    var body: []u8 = []
    for i in 0..20000 {
        push(mut body, u8(i % 251))
    }
    e.write_bytes(2, body)
    e.end_message(outer)
    let d = protobuf.decoder(e.encoded())
    let f = d.next() or none
    match f {
        some(m) => {
            let inner_d = m.as_message() or protobuf.decoder([])
            let g = inner_d.next() or none
            match g {
                some(b) => {
                    var same = b.data.len == body.len
                    for i in 0..body.len {
                        same = same && b.data[i] == body[i]
                    }
                    print("nested {e.size()} {m.data.len} {same}")
                }
                none => print("nested missing")
            }
        }
        none => print("missing")
    }
}

fn main() ! io.Error {
    let mine = encode_all()
    let want = reference()
    print("encode matches protoc {text.encode_hex(mine) == want}")
    decode_all(text.decode_hex(want) or fail Malformed)?
    varints()
    large_nested()
    print("truncated varint {outcome([0x08, 0x80])}")
    print("overlong varint {outcome([0x08, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0x02])}")
    print("length past end {outcome([0x0a, 0x05, 1, 2])}")
    print("short fixed64 {outcome([0x09, 1, 2, 3])}")
    print("short fixed32 {outcome([0x0d, 1])}")
    print("field zero {outcome([0x00, 0x01])}")
    print("group {outcome([0x0b])}")
    print("wire 6 {outcome([0x0e])}")
    print("empty {outcome([])}")
    let wrong = protobuf.Field { number: 1, wire: Varint, value: 1, data: [] }
    print("wrong wire {wrong.as_string() or "rejected"}")
    let odd = protobuf.Field { number: 1, wire: Bytes, value: 3, data: [1, 2, 3] }
    print("odd packed {(odd.unpack_fixed64() or []).len}")
}
