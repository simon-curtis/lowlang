fn main() {
    let max: u64 = 18446744073709551615
    let min: i64 = -9223372036854775807 - 1
    print("{-5:d3}|{5:d3}|{0:d3}|{12345:d3}|{7:d}|{-5:d}")
    print("{max:d}|{max:d25}|{max:x}|{max:X}|{max:b}|{max:n}|{max:f1}|{max:e3}")
    print("{min:d}|{min:d21}|{min:x}|{min:n}|{min:e2}|{min:f0}")
    print("{u8(255):x}|{u8(5):x4}|{u8(255):b}|{u16(65535):X}|{u16(300):x}|{u32(4000000000):x}")
    print("{i32(-1):x}|{i32(-1):b}|{-1:x}|{-1:X}|{i32(-2147483648):x}|{i32(-2147483648):n}|{i32(-2):d5}")
    print("{255:x}|{255:X6}|{255:b10}|{0:x}|{0:b}|{0:d}|{36:b3}")
    print("{1234567:n}|{-1234567:n}|{999:n}|{1000:n}|{-999:n}|{1234567:n2}|{0:n}")
    print("{12345:e2}|{5:e0}|{0:e2}|{-12345:e1}|{999999:e2}|{995:e1}|{985:e1}|{5:e}")
    print("{1000000:f2}|{7:f1}|{7:f}|{-7:f0}|{3:f10}")
    print("{36:##}|{0:##}|{5:000}|{1234567:#,##0}|{1234567:#,##0.00}|{-42:0000}|{42:#.##}|{42:0.0#}")
}
