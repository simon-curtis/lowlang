import std/io
import std/net

fn main() ! io.Error {
    let addresses = [
        "1.1.1.1", "8.8.8.8", "10.1.2.3", "100.64.0.1", "127.0.0.1", "169.254.1.1", "172.16.0.1", "172.32.0.1",
        "192.0.0.9", "192.0.0.8", "192.0.2.1", "192.168.1.1", "198.18.0.1", "203.0.113.5", "224.0.0.1", "255.255.255.255",
        "0.0.0.0", "2606:4700:4700::1111", "::1", "::", "fe80::1", "fd00::1", "ff02::1", "2001:db8::1", "2001:4:112::1",
        "2001:2::1", "::ffff:8.8.8.8", "::ffff:10.0.0.1", "64:ff9b::808:808", "2002::1",
    ]
    for a in addresses {
        print("{a} {net.is_global(net.parse_ip(a)?)}")
    }
}
