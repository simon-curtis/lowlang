import std/file
import std/io
import std/os
import std/slices
import std/text

fn relative(root: str, p: str) -> str {
    let rest = text.trim_prefix(p, root)
    text.trim_prefix(rest, "/")
}

fn kind(v: file.Visit) -> str {
    if v.link {
        return "l"
    }
    if v.dir {
        return "d"
    }
    if v.regular {
        return "f"
    }
    "o"
}

fn survey(root: str, skip: str, stop: str) -> []str ! io.Error {
    var seen: []str = []
    file.walk(root, fn(v: file.Visit) -> file.Step {
        let rel = relative(root, v.path)
        let line = "{kind(v)}{v.depth} {rel}"
        push(mut seen, text.trim_end(line))
        if rel == stop {
            return Stop
        }
        if rel == skip {
            return Skip
        }
        Continue
    })?
    seen
}

fn show(root: str, found: []str) {
    var rels: []str = []
    for p in found {
        push(mut rels, relative(root, p))
    }
    print("[{text.join(rels, ", ")}]")
}

fn put(root: str, rel: str, content: str) ! io.Error {
    file.write_text("{root}/{rel}", content)?
}

fn failure(op: fn() ! io.Error) -> str {
    op() catch {
        NotFound => return "NotFound"
        Exists => return "Exists"
        IsDir => return "IsDir"
        NotDir => return "NotDir"
        Invalid => return "Invalid"
        _ => return "other"
    }
    "ok"
}

fn main() ! io.Error {
    let made = file.temp_dir("low-std-walk-")?
    let root = file.realpath(made)?
    file.mkdir_all("{root}/src/util")?
    file.mkdir_all("{root}/docs/guide")?
    file.mkdir_all("{root}/.hidden")?
    file.mkdir_all("{root}/empty")?
    put(root, "a.txt", "alpha")?
    put(root, "b.low", "beta")?
    put(root, "src/main.low", "main")?
    put(root, "src/util/helper.low", "helper")?
    put(root, "src/util/data.txt", "data")?
    put(root, "docs/readme.md", "readme")?
    put(root, "docs/guide/intro.md", "intro")?
    put(root, ".hidden/secret.txt", "secret")?
    file.symlink("src", "{root}/link_to_src")?
    file.symlink("missing", "{root}/dangling")?

    for line in survey(root, "-", "-")? {
        print(line)
    }
    print("--")
    for line in survey(root, "docs", "-")? {
        print(line)
    }
    print("--")
    for line in survey(root, "-", "docs/guide/intro.md")? {
        print(line)
    }
    print("--")
    for line in survey("{root}/a.txt", "-", "-")? {
        print(line)
    }
    for line in survey("{root}/link_to_src", "-", "-")? {
        print(line.len > 0)
    }
    print(failure(fn() ! io.Error { file.walk("{root}/missing", fn(v: file.Visit) -> file.Step { Continue })? }))
    var total = 0
    file.walk(root, fn(v: file.Visit) -> file.Step {
        if v.regular {
            total += 1
        }
        Continue
    })?
    print(total)

    show(root, file.glob("{root}/*.txt"))
    show(root, file.glob("{root}/*.low"))
    show(root, file.glob("{root}/[ab].*"))
    show(root, file.glob("{root}/s?c/*.low"))
    show(root, file.glob("{root}/**/*.low"))
    show(root, file.glob("{root}/**/main.low"))
    show(root, file.glob("{root}/**/intro.md"))
    show(root, file.glob("{root}/docs/**"))
    show(root, file.glob("{root}/src/**/util"))
    show(root, file.glob("{root}/link_to_src/*.low"))
    show(root, file.glob("{root}/*/*/*.md"))
    show(root, file.glob("{root}/.hidden/*"))
    show(root, file.glob("{root}/nothing/*"))
    show(root, file.glob("{root}/a.txt"))
    show(root, file.glob("{root}/missing"))
    show(root, file.glob("{root}/dangling"))
    show(root, file.glob("{root}/**/**/*.txt"))
    show(root, file.glob("{root}/[!a]*.txt"))

    let before = os.getcwd()?
    os.chdir(root)?
    print(text.join(file.glob("*.txt"), ","))
    print(text.join(file.glob("src/**/*.low"), ","))
    print(text.join(file.glob("./docs/*.md"), ","))
    print(file.glob("").len)
    os.chdir(before)?

    print(file.readlink("{root}/link_to_src")?)
    print(file.readlink("{root}/dangling")?)
    print(failure(fn() ! io.Error { file.readlink("{root}/a.txt")? }))
    print(file.realpath("{root}/link_to_src/util")? == "{root}/src/util")
    print(file.realpath("{root}/src/../docs/./guide")? == "{root}/docs/guide")
    print(failure(fn() ! io.Error { file.realpath("{root}/dangling")? }))
    print(failure(fn() ! io.Error { file.symlink("x", "{root}/dangling")? }))

    print(file.is_dir("{root}/src"))
    print(file.is_dir("{root}/link_to_src"))
    print(file.is_dir("{root}/a.txt"))
    print(file.is_dir("{root}/missing"))
    print(file.is_file("{root}/a.txt"))
    print(file.is_file("{root}/link_to_src"))
    print(file.is_file("{root}/src"))
    print(file.is_symlink("{root}/link_to_src"))
    print(file.is_symlink("{root}/dangling"))
    print(file.is_symlink("{root}/a.txt"))
    let linked = file.lstat("{root}/link_to_src")?
    print("{linked.link} {linked.dir} {linked.regular}")
    let followed = file.stat("{root}/link_to_src")?
    print("{followed.link} {followed.dir} {followed.regular}")

    file.link("{root}/a.txt", "{root}/hard.txt")?
    let original = file.stat("{root}/a.txt")?
    let hard = file.stat("{root}/hard.txt")?
    print(original.inode == hard.inode && original.device == hard.device)
    print(file.read_text("{root}/hard.txt")?)
    print(failure(fn() ! io.Error { file.link("{root}/a.txt", "{root}/hard.txt")? }))

    file.chmod("{root}/a.txt", 0o751)?
    file.copy("{root}/a.txt", "{root}/a_copy.txt")?
    print(file.read_text("{root}/a_copy.txt")?)
    print(file.stat("{root}/a_copy.txt")?.mode == 0o751)
    file.write_text("{root}/victim.txt", "old contents that are long")?
    file.chmod("{root}/victim.txt", 0o600)?
    file.copy("{root}/b.low", "{root}/victim.txt")?
    print(file.read_text("{root}/victim.txt")?)
    print(file.stat("{root}/victim.txt")?.mode == 0o644)
    print(failure(fn() ! io.Error { file.copy("{root}/a.txt", "{root}/a.txt")? }))
    print(failure(fn() ! io.Error { file.copy("{root}/hard.txt", "{root}/a.txt")? }))
    print(failure(fn() ! io.Error { file.copy("{root}/src", "{root}/nope")? }))
    print(failure(fn() ! io.Error { file.copy("{root}/missing", "{root}/nope")? }))

    file.chmod("{root}/src/util", 0o500)?
    file.copy_dir("{root}/src", "{root}/dup")?
    var original_tree: []str = []
    var copied_tree: []str = []
    for line in survey("{root}/src", "-", "-")? {
        push(mut original_tree, line)
    }
    for line in survey("{root}/dup", "-", "-")? {
        push(mut copied_tree, line)
    }
    print(text.join(original_tree, "|") == text.join(copied_tree, "|"))
    print(file.stat("{root}/dup/util")?.mode == 0o500)
    file.chmod("{root}/src/util", 0o755)?
    file.chmod("{root}/dup/util", 0o755)?
    print(file.read_text("{root}/dup/util/helper.low")?)

    file.copy_dir("{root}/link_to_src", "{root}/dup2")?
    print(file.is_file("{root}/dup2/main.low"))
    file.symlink("../a.txt", "{root}/src/up")?
    file.copy_dir("{root}/src", "{root}/dup")?
    print(file.readlink("{root}/dup/up")?)
    print(file.is_symlink("{root}/dup/up"))
    print(failure(fn() ! io.Error { file.copy_dir("{root}/src", "{root}/src/inner")? }))
    print(failure(fn() ! io.Error { file.copy_dir("{root}/src", "{root}/src")? }))
    print(failure(fn() ! io.Error { file.copy_dir("{root}/a.txt", "{root}/zzz")? }))
    print(failure(fn() ! io.Error { file.copy_dir("{root}/src", "{root}/missing/deeper")? }))
    print(file.exists("{root}/src/inner"))

    file.chown("{root}/a.txt", os.uid(), os.gid())?
    file.chown("{root}/a.txt", -1, -1)?
    file.lchown("{root}/link_to_src", -1, -1)?
    let owned = file.stat("{root}/a.txt")?
    print(owned.uid == os.uid() && owned.gid == os.gid())
    print(failure(fn() ! io.Error { file.chown("{root}/missing", -1, -1)? }))

    file.set_times("{root}/b.low", 1000000000, 1500000000)?
    let timed = file.stat("{root}/b.low")?
    print("{timed.accessed} {timed.modified}")
    print(failure(fn() ! io.Error { file.set_times("{root}/missing", 1, 2)? }))

    let usage = file.disk_usage(root)?
    print(usage.total > 0 && usage.available <= usage.free && usage.free <= usage.total)
    print(usage.files_free <= usage.files)
    print(failure(fn() ! io.Error { file.disk_usage("{root}/missing")? }))

    var names: []str = []
    var kinds: []str = []
    for entry in file.read_dir_info(root)? {
        push(mut names, entry.name)
        if entry.link {
            push(mut kinds, "{entry.name}:link")
        } else if entry.dir {
            push(mut kinds, "{entry.name}:dir")
        }
    }
    slices.sort(mut names)
    slices.sort(mut kinds)
    print(text.join(names, " "))
    print(text.join(kinds, " "))
    var listed = file.list(root)?
    slices.sort(mut listed)
    print(text.join(names, "|") == text.join(listed, "|"))

    file.remove_all(root)?
    print(file.exists(root))
}
