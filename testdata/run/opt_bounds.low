fn sum_range(xs: []i64) -> i64 {
    var total = 0
    for i in 0..xs.len {
        total += xs[i]
    }
    total
}

fn sum_pairs(xs: []i64) -> i64 {
    let n = xs.len
    var total = 0
    for i in 0..n {
        for j in i + 1..n {
            total += xs[i] * xs[j]
            xs[i] += 1
            xs[j] -= 1
        }
    }
    total
}

fn sum_shifted(xs: []i64) -> i64 {
    var total = 0
    for i in 1..xs.len {
        total += xs[i - 1] * 10 + xs[i]
    }
    total
}

fn sum_ahead(xs: []i64) -> i64 {
    var total = 0
    for i in 0..xs.len - 1 {
        total += xs[i + 1] - xs[i]
    }
    total
}

fn sum_limit(xs: []i64, limit: i64) -> i64 {
    var total = 0
    for i in 0..limit {
        total += xs[i]
    }
    total
}

fn sum_step(xs: []i64, step: i64) -> i64 {
    var total = 0
    var i = 0
    for i < xs.len {
        total += xs[i]
        i += step
    }
    total
}

fn sum_stride_two(xs: []i64) -> i64 {
    var total = 0
    var i = 0
    for i < xs.len {
        total += xs[i]
        i += 2
    }
    total
}

fn sum_countdown(xs: []i64) -> i64 {
    var total = 0
    var i = xs.len - 1
    for i >= 0 {
        total = total * 3 + xs[i]
        i -= 1
    }
    total
}

fn grow(xs: []i64) -> i64 {
    var ys = xs
    var total = 0
    for i in 0..ys.len {
        push(mut ys, i * 100)
        total += ys[i] + ys[ys.len - 1]
    }
    total + ys.len
}

fn guarded(xs: []i64, i: i64) -> i64 {
    if i >= 0 && i < xs.len {
        return xs[i]
    }
    0 - 1
}

fn weigh_text(text: str) -> i64 {
    let b = bytes(text)
    var total = 0
    for i in 0..b.len {
        total += i64(b[i]) * (i + 1)
    }
    total
}

fn narrow(xs: []i64) -> i64 {
    var total = 0
    for i in 0..xs.len {
        let k = u8(i)
        total += xs[k]
    }
    total
}

fn nested_inner_bound(xs: []i64, ys: []i64) -> i64 {
    var total = 0
    for i in 0..xs.len {
        for j in 0..ys.len {
            total += xs[i] * ys[j]
        }
    }
    total
}

fn main() {
    let xs = [3, 1, 4, 1, 5, 9, 2, 6]
    print(sum_range(xs))
    print(sum_pairs([1, 2, 3, 4]))
    print(sum_shifted(xs))
    print(sum_ahead(xs))
    print(sum_limit(xs, 5))
    print(sum_step(xs, 3))
    print(sum_stride_two(xs))
    print(sum_countdown(xs))
    print(grow([7, 8, 9]))
    print(guarded(xs, 3))
    print(guarded(xs, 0 - 1))
    print(guarded(xs, 8))
    print(weigh_text("hello"))
    print(narrow(xs))
    print(nested_inner_bound(xs, [1, 2, 3]))
}
