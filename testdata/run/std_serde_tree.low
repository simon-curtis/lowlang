import std/cbor
import std/json
import std/msgpack
import std/serde
import std/template
import std/toml
import std/yaml

enum Shape {
    Circle(radius: f64)
    Rect(f64, f64)
    Empty
}

struct Wide {
    big: u64
}

struct Narrow {
    big: i64
}

struct Counts {
    by_id: [i64: str]
    by_byte: [u8: str]
    by_flag: [bool: i64]
    by_wide: [u64: str]
}

struct Labels {
    names: [str: i64]
}

fn describe(e: serde.Error) -> str {
    match e {
        Syntax(at, message) => "syntax {at}: {message}"
        Mismatch(expected, at) => "mismatch {expected} at {at}"
        Missing(field) => "missing {field}"
        UnknownVariant(name) => "unknown variant {name}"
        Range(at) => "range at {at}"
        TooDeep => "too deep"
        TooLarge => "too large"
    }
}

fn join(parts: []str) -> str {
    var out = ""
    for i, p in parts {
        if i > 0 {
            out = "{out}, "
        }
        out = "{out}{p}"
    }
    out
}

fn tree_text(n: serde.Node) -> str {
    match n.tree {
        Null => "null"
        Bool(b) => "{b}"
        Int(v) => "{v}"
        Uint(v) => "{v}u"
        Float(x) => "{x}"
        Text(s) => "\"{s}\""
        Binary(data) => "bytes{data.len}"
        Seq(items) => {
            var parts: []str = []
            for item in items {
                push(mut parts, tree_text(item))
            }
            "[{join(parts)}]"
        }
        Map(members) => {
            var parts: []str = []
            for m in members {
                push(mut parts, "{tree_text(m.key)}: {tree_text(m.value)}")
            }
            "<{join(parts)}>"
        }
        Overflow => "overflow"
        Opaque => "opaque"
    }
}

fn counts_text(c: Counts) -> str {
    var parts: []str = []
    for k, v in c.by_id {
        push(mut parts, "id {k}={v}")
    }
    for k, v in c.by_byte {
        push(mut parts, "byte {k}={v}")
    }
    for k, v in c.by_flag {
        push(mut parts, "flag {k}={v}")
    }
    for k, v in c.by_wide {
        push(mut parts, "wide {k}={v}")
    }
    join(parts)
}

fn nested(depth: i64) -> []u8 {
    var out: []u8 = []
    for _ in 0..depth {
        push(mut out, 0x81)
    }
    push(mut out, 0x00)
    out
}

fn cbor_narrow(data: []u8) -> str {
    let v: Narrow = cbor.deserialize(data) catch {
        e => return describe(e)
    }
    "ok {v.big}"
}

fn msgpack_narrow(data: []u8) -> str {
    let v: Narrow = msgpack.deserialize(data) catch {
        e => return describe(e)
    }
    "ok {v.big}"
}

fn cbor_wide(data: []u8) -> str {
    let v: Wide = cbor.deserialize(data) catch {
        e => return describe(e)
    }
    "ok {v.big}"
}

fn msgpack_wide(data: []u8) -> str {
    let v: Wide = msgpack.deserialize(data) catch {
        e => return describe(e)
    }
    "ok {v.big}"
}

fn yaml_text[T](v: T) -> str {
    yaml.serialize(v) catch {
        e => return describe(e)
    }
}

fn toml_text[T](v: T) -> str {
    toml.serialize(v) catch {
        e => return describe(e)
    }
}

fn yaml_counts(source: str) -> str {
    let c: Counts = yaml.deserialize(source) catch {
        e => return describe(e)
    }
    counts_text(c)
}

fn toml_counts(source: str) -> str {
    let c: Counts = toml.deserialize(source) catch {
        e => return describe(e)
    }
    counts_text(c)
}

fn json_labels(data: str, naming: json.Naming) -> str {
    let l: Labels = json.deserialize_with(bytes(data), json.Options { naming }) catch {
        e => return describe(e)
    }
    var parts: []str = []
    for k, v in l.names {
        push(mut parts, "{k}={v}")
    }
    join(parts)
}

fn json_counts(data: str) -> str {
    let c: Counts = json.deserialize(bytes(data)) catch {
        e => return describe(e)
    }
    counts_text(c)
}

fn main() {
    let big = Wide { big: 0xFFFFFFFFFFFFFFFF }
    print(tree_text(serde.to_tree(Wide { big: 5 })))
    print(tree_text(serde.to_tree(big)))
    print(tree_text(serde.to_tree([Shape.Circle(1.5), Shape.Rect(2.0, 3.0), Shape.Empty])))
    let counts = Counts { by_id: [-7: "x"], by_byte: [200: "y"], by_flag: [true: 1], by_wide: [0xFFFFFFFFFFFFFFFF: "z"] }
    print(tree_text(serde.to_tree(counts)))

    print("cbor wide {cbor_wide(cbor.serialize(big))}")
    print("msgpack wide {msgpack_wide(msgpack.serialize(big))}")
    print("cbor narrow {cbor_narrow(cbor.serialize(big))}")
    print("msgpack narrow {msgpack_narrow(msgpack.serialize(big))}")
    print("cbor small {cbor_narrow(cbor.serialize(Wide { big: 5 }))}")
    print("msgpack small {msgpack_narrow(msgpack.serialize(Wide { big: 5 }))}")
    print("yaml wide {yaml_text(big)}")
    print("toml wide {toml_text(big)}")
    print("data wide {template.to_data(big)}")

    print("cbor keys {cbor_keys(counts)}")
    print("msgpack keys {msgpack_keys(counts)}")

    let yaml_keys = "by_id: {{-7: x}}\nby_byte: {{200: y}}\nby_flag: {{true: 1}}\nby_wide: {{9: z}}"
    print("yaml keys {yaml_counts(yaml_keys)}")
    let yaml_range = "by_id: {{}}\nby_byte: {{300: y}}\nby_flag: {{}}\nby_wide: {{}}"
    print("yaml byte range {yaml_counts(yaml_range)}")
    let yaml_line = "by_id: {{}}\nby_byte: {{}}\nby_flag: 3\nby_wide: {{}}"
    print("yaml line {yaml_counts(yaml_line)}")
    let toml_keys = "[by_id]\n\"-7\" = \"x\"\n[by_byte]\n\"200\" = \"y\"\n[by_flag]\ntrue = 1\n[by_wide]\n\"18446744073709551615\" = \"z\""
    print("toml keys {toml_counts(toml_keys)}")

    let json_keys = "{{\"by_id\":{{\"-7\":\"x\"}},\"by_byte\":{{\"200\":\"y\"}},\"by_flag\":{{\"true\":1}},\"by_wide\":{{\"18446744073709551615\":\"z\"}}}}"
    print("json keys {json_counts(json_keys)}")
    let json_range = "{{\"by_id\":{{}},\"by_byte\":{{\"256\":\"y\"}},\"by_flag\":{{}},\"by_wide\":{{}}}}"
    print("json byte range {json_counts(json_range)}")
    let json_bad = "{{\"by_id\":{{\"x\":\"y\"}},\"by_byte\":{{}},\"by_flag\":{{}},\"by_wide\":{{}}}}"
    print("json bad key {json_counts(json_bad)}")
    let json_wide = "{{\"by_id\":{{}},\"by_byte\":{{}},\"by_flag\":{{}},\"by_wide\":{{\"18446744073709551616\":\"z\"}}}}"
    print("json wide overflow {json_counts(json_wide)}")

    let camel = "{{\"names\":{{\"myKey\":1}}}}"
    print("camel keys {json_labels(camel, json.Naming.CamelCase)}")
    let snake = "{{\"names\":{{\"my_key\":1}}}}"
    print("snake keys {json_labels(snake, json.Naming.SnakeCase)}")

    print("deep {cbor_narrow(nested(100))}")
    print("cbor missing {cbor_narrow(cbor.serialize(Labels { names: [:] }))}")
}

fn cbor_keys(c: Counts) -> str {
    let back: Counts = cbor.deserialize(cbor.serialize(c)) catch {
        e => return describe(e)
    }
    counts_text(back)
}

fn msgpack_keys(c: Counts) -> str {
    let back: Counts = msgpack.deserialize(msgpack.serialize(c)) catch {
        e => return describe(e)
    }
    counts_text(back)
}
