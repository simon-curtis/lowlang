struct Pair {
    a: i64
    b: i64
}

struct Box {
    lo: Pair
    hi: Pair
    tag: i64
}

fn swap(mut p: Pair) {
    let t = p.a
    p.a = p.b
    p.b = t
}

fn exchange(mut b: Box) {
    let t = b.lo
    b.lo = b.hi
    b.hi = t
    b.tag += 1
}

fn grow(mut p: Pair, by: i64) {
    p.a += by
    p.b += by * 2
}

fn main() {
    var p = Pair { a: 1, b: 2 }
    for i in 0..3 {
        swap(mut p)
    }
    print(p.a)
    print(p.b)

    var b = Box { lo: Pair { a: 1, b: 2 }, hi: Pair { a: 3, b: 4 }, tag: 0 }
    for i in 0..5 {
        exchange(mut b)
    }
    print(b.lo.a)
    print(b.lo.b)
    print(b.hi.a)
    print(b.hi.b)
    print(b.tag)

    var g = Pair { a: 0, b: 0 }
    for i in 0..10 {
        grow(mut g, i)
    }
    print(g.a)
    print(g.b)
}
