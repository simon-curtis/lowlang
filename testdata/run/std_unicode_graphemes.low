import std/text
import std/unicode

fn code(token: str) -> u32 {
    u32(text.parse_uint(token, 16) catch 0)
}

fn flush(mut clusters: []str, mut current: []u8) {
    push(mut clusters, str(current))
    current = []
}

fn check(line: str) -> bool {
    var expected: []str = []
    var current: []u8 = []
    var whole: []u8 = []
    for token in text.fields(line) {
        if token == "÷" {
            flush(mut expected, mut current)
        } else if token != "×" {
            let c = code(token)
            text.append_char(mut current, c)
            text.append_char(mut whole, c)
        }
    }
    flush(mut expected, mut current)
    let input = str(whole)
    let got = unicode.graphemes(input)
    if got.len != expected.len || unicode.grapheme_count(input) != expected.len {
        return false
    }
    for i, g in got {
        if g != expected[i] {
            return false
        }
    }
    true
}

fn build(cs: []u32) -> str {
    var out: []u8 = []
    for c in cs {
        text.append_char(mut out, c)
    }
    str(out)
}

fn hex_codes(s: str) -> str {
    var parts: []str = []
    for c in s {
        push(mut parts, text.hex(i64(c)))
    }
    text.join(parts, " ")
}

fn show(cs: []u32) {
    let s = build(cs)
    var clusters: []str = []
    for g in unicode.graphemes(s) {
        push(mut clusters, hex_codes(g))
    }
    print("{unicode.grapheme_count(s)}: {text.join(clusters, " | ")}")
}

fn main() {
    var total = 0
    var failed = 0
    for line in text.lines(embed("std_unicode_graphemes.txt")) {
        if line == "" {
            continue
        }
        total += 1
        if !check(line) {
            failed += 1
            print("failed: {line}")
        }
    }
    print("cases {total} failed {failed}")

    show([])
    show(['a', 'b', 'c'])
    show(['e', 0x301, 'x'])
    show(['a', '\r', '\n', 'b'])
    show([0x1F1EF, 0x1F1F5, 0x1F1FA, 0x1F1F8, 0x1F1EB, 0x1F1F7, 0x1F1E9])
    show([0x1F468, 0x200D, 0x1F469, 0x200D, 0x1F467, 0x200D, 0x1F466, '!'])
    show([0x1F44D, 0x1F3FD, 'x'])
    show([0x1100, 0x1161, 0x11A8, 0x1112, 0x1161, 0x11AB])
    show([0xAC01, 0xD55C])
    show([0x915, 0x94D, 0x937, 0x93F, 0x915])
    show([0x1F3F3, 0xFE0F, 0x200D, 0x1F308])
    show([0x600, 'a', 0x308, 0x20])
    show([0x0E01, 0x0E33, 0x0E01])
    show(['a', 0x200D, 'b'])
    print(unicode.grapheme_end("ab", 0))
    print(unicode.grapheme_end("a\r\nb", 1))
}
