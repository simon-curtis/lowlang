struct Point {
    x: i64
    y: i64
}

struct Rect {
    min: Point
    max: Point
    label: str
}

struct Pair {
    left: f64
    right: []i64
    name: str
}

fn origin() -> Point {
    print("origin called")
    Point { x: 3, y: 4 }
}

fn rect() -> Rect {
    print("rect called")
    Rect { min: Point { x: 1, y: 2 }, max: Point { x: 8, y: 9 }, label: "box" }
}

fn main() {
    let p = Point { x: 10, y: 20 }
    let { x, y } = p
    print("{x} {y}")

    let { y: only } = p
    print(only)

    let { x: a, y: b } = origin()
    print("{a} {b}")

    var { x: m, y: n } = p
    m += 1
    n -= 1
    print("{m} {n} {p.x} {p.y}")

    let { min: { x: lo_x, y }, max, label } = rect()
    print("{lo_x} {y} {max.x} {max.y} {label}")

    let {
        left
        right: items
        name: who,
    } = Pair { left: 1.5, right: [1, 2, 3], name: "pair" }
    print("{left} {items.len} {who}")

    let points = [Point { x: 1, y: 2 }, Point { x: 3, y: 4 }, Point { x: 5, y: 6 }]
    var total = 0
    for { x, y } in points {
        total += x * y
    }
    print(total)

    for i, { x: px } in points {
        print("{i}: {px}")
    }

    let first = points[0]
    var { x: min_x, y: min_y } = first
    var { x: max_x, y: max_y } = first
    for { x, y } in points {
        if x < min_x { min_x = x }
        if y < min_y { min_y = y }
        if x > max_x { max_x = x }
        if y > max_y { max_y = y }
    }
    print("{min_x} {min_y} {max_x} {max_y}")

    let by_name = ["a": Point { x: 7, y: 8 }]
    for k, { x: vx, y: vy } in by_name {
        print("{k} {vx} {vy}")
    }

    let grabs = [fn() -> i64 { x }, fn() -> i64 { y }]
    print(grabs[0]() + grabs[1]())

    var count = 0
    for {
        count += 1
        if count > 2 { break }
    }
    print(count)
    for { break }

    let q = {
        let { x, y } = p
        x + y
    }
    print(q)
}
