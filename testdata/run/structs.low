struct Point {
    x: i64
    y: i64
}

struct Rect {
    min: Point
    max: Point
    label: str
}

struct Meters {
    value: i64
}

enum Shape {
    Box(Rect)
    Dot(Point)
}

fn origin() -> Point {
    Point { x: 0, y: 0 }
}

fn add(a: Point, b: Point) -> Point {
    Point { x: a.x + b.x, y: a.y + b.y }
}

fn manhattan(p: Point) -> i64 {
    abs(p.x) + abs(p.y)
}

fn width(r: Rect) -> i64 {
    r.max.x - r.min.x
}

fn rectArea(r: Rect) -> i64 {
    width(r) * (r.max.y - r.min.y)
}

fn double(m: Meters) -> Meters {
    Meters { value: m.value * 2 }
}

fn shapeArea(s: Shape) -> i64 {
    match s {
        Box(r) => rectArea(r)
        Dot(_) => 0
    }
}

fn abs(n: i64) -> i64 {
    if n < 0 { -n } else { n }
}

fn corner(r: Rect) -> Point {
    r.max
}

fn main() {
    let p = Point { x: 3, y: -4 }
    print(p.x)
    print(manhattan(p))

    let q = add(p, Point { x: 1, y: 1 })
    print(q.x)
    print(q.y)
    print(manhattan(origin()))

    var r = Rect {
        min: origin()
        max: Point { x: 4, y: 5 }
        label: "box"
    }
    print(r.label)
    print(rectArea(r))
    print(corner(r).y)

    let snapshot = r
    r.max.x += 6
    r.label = "wide"
    print(width(r))
    print(width(snapshot))
    print(r.label)
    print(snapshot.label)

    let x = 7
    let y = 8
    let short = Point { x, y }
    print(manhattan(add(short, p)))

    let m = Meters { value: 21 }
    print(double(m).value)

    let shapes: Shape = Box(r)
    print(shapeArea(shapes))
    print(shapeArea(Shape.Dot(p)))

    if r.max.x > 5 {
        print("struct in condition")
    }
}
