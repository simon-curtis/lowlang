fn swap_floats(n: i64) -> f64 {
    var x = 1.5
    var y = 2.5
    var z = 4.5
    for i in 0..n {
        let t = x
        x = y
        y = z
        z = t
    }
    x * 100.0 + y * 10.0 + z
}

fn mixed_cycle(n: i64) -> f64 {
    var f = 0.5
    var k = 3
    var g = 1.25
    var m = 7
    for i in 0..n {
        let tf = f
        let tk = k
        f = g + f64(m)
        k = i64(tf * 4.0) + 1
        g = tf
        m = tk * 2 - m
    }
    f + g + f64(k) + f64(m)
}

fn rotate(n: i64) -> f64 {
    var a = 1.0
    var b = 2.0
    var c = 3.0
    var d = 4.0
    var i = 0
    var j = 10
    for i < n {
        let t = a
        a = b
        b = c
        c = d
        d = t + 0.5
        let u = i
        i = i + 1
        j = j + i - u
    }
    a + b * 10.0 + c * 100.0 + d * 1000.0 + f64(j)
}

fn branches(flag: i64, x: f64, k: i64) -> f64 {
    var f = x
    var n = k
    for i in 0..6 {
        if (flag + i) % 3 == 0 {
            let t = f
            f = f64(n)
            n = i64(t)
        } else {
            f = f * 1.5
            n += 1
        }
    }
    f + f64(n)
}

fn selected(a: f64, b: f64, pick: bool) -> f64 {
    let v = if pick { a * 2.0 } else { b + 1.0 }
    let w = if pick { b } else { a }
    v - w
}

fn main() {
    print(swap_floats(0))
    print(swap_floats(1))
    print(swap_floats(2))
    print(swap_floats(3))
    print(swap_floats(100))
    print(mixed_cycle(0))
    print(mixed_cycle(1))
    print(mixed_cycle(5))
    print(mixed_cycle(20))
    print(rotate(0))
    print(rotate(7))
    print(rotate(1000))
    for flag in 0..3 {
        print(branches(flag, 2.5, 4))
    }
    print(selected(1.5, 2.5, true))
    print(selected(1.5, 2.5, false))
}
