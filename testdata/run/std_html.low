import std/html
import std/text

fn quoted(s: str) -> str {
    let escaped = text.replace(s, "\n", "\\n")
    "\"{escaped}\""
}

fn optional(label: str, value: str?) -> str {
    match value {
        some(v) => " {label}={quoted(v)}"
        none => ""
    }
}

fn start_tag(name: str, attributes: []html.Attribute, self_closing: bool) -> str {
    var line = "start {name}"
    for a in attributes {
        line = "{line} {a.name}={quoted(a.value)}"
    }
    if self_closing { "{line} /" } else { line }
}

fn describe(token: html.Token) -> str {
    match token {
        StartTag(name, attributes, self_closing) => start_tag(name, attributes, self_closing)
        EndTag(name) => "end {name}"
        Text(content) => "text {quoted(content)}"
        Comment(content) => "comment {quoted(content)}"
        Doctype(name, public_id, system_id) => "doctype {name}{optional("public", public_id)}{optional("system", system_id)}"
        End => "end of input"
    }
}

fn dump(label: str, input: str) {
    print("== {label}")
    let tokens = html.tokenizer(input)
    for {
        let token = tokens.next()
        print(describe(token))
        match token {
            End => break
            _ => {}
        }
    }
}

fn listing() -> str {
    let lines = [
        "<!DOCTYPE html>",
        "<html lang=en-GB><head><title>Football on TV &amp; Streaming</title>",
        "<script type=\"text/javascript\">if (a < b && c > d) {{ document.write('</div><p>'); }}</script>",
        "<style>.fixture > div {{ color: red }}</style></head>",
        "<body><div class=\"fixture-date\">Saturday 14th November 2026</div>",
        "<div class=\"fixture\"><div class=\"fixture__time\">12:30</div>",
        "<div class=\"fixture__teams\">Brighton &amp; Hove Albion v Nott&#39;m Forest</div>",
        "<div class=\"fixture__competition\">Women&#x27;s Champions League&nbsp;League Phase</div>",
        "<div class=\"fixture__channel\"><div class=\"span3 channels\"><span class=\"channel-pill\" style=\"background-color: #020e41;border: 0;\">TNT Sports 1</span><span class=channel-pill>discovery+</span></div></div></div>",
        "</body></html>",
    ]
    lines |> text.join("\n")
}

fn main() {
    dump("listing", listing())
    dump("attributes", "<a href=/match?id=1&amp;tab=2 data-x='single &quot;q&quot;' title=\"x &lt; y\" checked data-ref=a&copy=b>link</a>")
    dump("uppercase", "<DIV CLASS=Box ID='Main'><P>Text</P></DIV><BR/>")
    dump("script", "<script>var s = '</div>'; if (x < 1) {{ y = '<b>'; }}</SCRIPT ><p>after</p>")
    dump("comments", "<!-- a -- b --><!----><!--->x<!-- c --!>y<?xml version=\"1.0\"?><![CDATA[raw]]></ bogus>")
    dump("entities", "&amp; &#39; &#x27; &nbsp;| &notit; &copy 2026 &unknown; &#128; &#0; &#xD800; &#1114112; &# &#x; &amp")
    dump("attribute entities", "<p a=\"&notit;\" b=\"&copy=1\" c=\"&copy 2\" d=\"&amp;amp\">")
    dump("escapable", "<title>A &lt;b&gt; title <i>not a tag</i></title><textarea>x</textarea>")
    dump("doctype", "<!doctype HTML PUBLIC \"-//W3C//DTD HTML 4.01//EN\" \"http://www.w3.org/TR/html4/strict.dtd\">")
    dump("malformed", "<div class=\"a\" class=\"b\" =x></div </><p <a\"b=c>1 < 2 <3</p")
    dump("unterminated attribute", "text<img src=\"x")
    dump("unterminated comment", "<!-- open --")
    dump("lone markup", "a < b <")
    dump("unterminated script", "<script>never closed </scrip")
    dump("unterminated bang comment", "<!--<!--!")
    dump("empty", "")
    lookup()
}

fn lookup() {
    print("== lookup")
    let tokens = html.tokenizer("<A HREF=\"/fixtures?team=arsenal&amp;page=2\" Class=btn>")
    match tokens.next() {
        StartTag(name, attributes, _) => {
            let href = html.attribute(attributes, "href") ?? "missing"
            let rel = html.attribute(attributes, "rel") ?? "missing"
            print("{name} href={href} rel={rel}")
        }
        _ => print("not a start tag")
    }
    print(html.unescape("Tom &amp; Jerry &lt;3 &#x1F600;"))
    print(html.escape("<a href=\"x\">Tom & 'Jerry'</a>"))
    print(html.escape("plain text"))
    print(html.escape(html.escape("a & b")))
    print(html.unescape(html.escape("<&>\"'")) == "<&>\"'")
}
