import std/locale
import std/locale/decimal
import std/locale/plural
import std/text

fn decimal_of(s: str) -> decimal.Decimal {
    decimal.parse(s) or decimal.zero()
}

fn main() {
    var checked = 0
    var range_wrong = 0
    var select_wrong = 0
    var current = ""
    var l = locale.root()
    for line in text.lines(embed("ranges.tsv")) {
        let f = text.split(line, '\t')
        if f.len != 6 {
            continue
        }
        if f[0] != current {
            current = f[0]
            l = locale.parse(current) or locale.root()
        }
        let a = plural.category_of(l, decimal_of(f[1]))
        let b = plural.category_of(l, decimal_of(f[2]))
        checked += 1
        if plural.name(a) != f[4] || plural.name(b) != f[5] {
            select_wrong += 1
        }
        let got = plural.name(plural.range(l, a, b))
        if got != f[3] {
            range_wrong += 1
            if range_wrong <= 20 {
                print("{f[0]} {f[1]} {f[2]}: want {f[3]}, got {got}")
            }
        }
    }
    print("plural range: {checked} checked, {range_wrong} wrong ranges, {select_wrong} wrong categories")
}
