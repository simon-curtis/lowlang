import std/file
import std/io
import std/os
import std/term
import std/text

fn show(s: str) -> str {
    text.replace(s, text.from_char(27), "<ESC>")
}

fn describe(k: term.Key) -> str {
    match k {
        Char(c) => "Char({text.from_char(c)})"
        Ctrl(c) => "Ctrl({text.from_char(c)})"
        Alt(c) => "Alt({text.from_char(c)})"
        Function(n) => "F{n}"
        Enter => "Enter"
        Tab => "Tab"
        BackTab => "BackTab"
        Backspace => "Backspace"
        Escape => "Escape"
        Up => "Up"
        Down => "Down"
        Left => "Left"
        Right => "Right"
        Home => "Home"
        End => "End"
        PageUp => "PageUp"
        PageDown => "PageDown"
        Insert => "Insert"
        Delete => "Delete"
        Unknown => "Unknown"
    }
}

fn describe_all(keys: []term.Key) -> str {
    var parts: []str = []
    for k in keys {
        push(mut parts, describe(k))
    }
    text.join(parts, " ")
}

fn esc() -> str {
    text.from_char(27)
}

fn styles() {
    print(show(term.reset()))
    print(show(term.bold("b")))
    print(show(term.dim("d")))
    print(show(term.underline("u")))
    print(show(term.fg(Red, "r")))
    print(show(term.bg(Green, "g")))
    print(show(term.fg(BrightBlue, "bb")))
    print(show(term.bg(BrightWhite, "bw")))
    print(show(term.fg(term.Colour.Indexed(208), "i")))
    print(show(term.bg(term.Colour.Indexed(17), "i")))
    print(show(term.fg(term.Colour.Rgb(255, 128, 0), "t")))
    print(show(term.bg(term.Colour.Rgb(1, 2, 3), "t")))
    print(show(term.bold(term.fg(Cyan, "nested"))))
}

fn cursor() {
    print(show(term.cursor_up(3)))
    print(show(term.cursor_down(1)))
    print(show(term.cursor_forward(12)))
    print(show(term.cursor_back(2)))
    print(show(term.cursor_up(0)))
    print(show(term.cursor_column(5)))
    print(show(term.cursor_to(4, 9)))
    print(show(term.cursor_home()))
    print(show(term.save_cursor()))
    print(show(term.restore_cursor()))
    print(show(term.hide_cursor()))
    print(show(term.show_cursor()))
    print(show(term.clear_line()))
    print(show(term.clear_to_end_of_line()))
    print(show(term.clear_screen()))
    print(show(term.enter_alternate_screen()))
    print(show(term.leave_alternate_screen()))
}

fn stripping() {
    let styled = term.bold(term.fg(Red, "héllo")) + " " + term.underline("wörld")
    print(term.strip(styled))
    print(term.visible_width(styled))
    print(term.visible_width("plain"))
    print(term.visible_width(""))
    print(term.visible_width("日本語"))
    print(term.strip("{term.cursor_to(1, 1)}{term.clear_screen()}x{term.show_cursor()}y"))
    print(term.strip("{esc()}]0;title{text.from_char(7)}after"))
    print(term.strip("{esc()}]8;;http://x{esc()}\\link{esc()}]8;;{esc()}\\"))
    print(term.strip("{esc()}(Bplain"))
    print(term.strip("trailing{esc()}"))
    print(term.strip("cut{esc()}[31"))
    print(term.strip("{esc()}[38;2;1;2;3mtrue{esc()}[0m"))
}

fn keys() {
    let e = esc()
    let stream = "a{e}[A{e}[B{e}[C{e}[D{e}[H{e}[F{e}[5~{e}[6~{e}[2~{e}[3~{e}OP{e}OQ{e}OR{e}OS{e}[15~{e}[17~{e}[24~{e}[1;5C{e}[Z"
    print(describe_all(term.parse_keys(bytes(stream))))
    let more = "{text.from_char(1)}{text.from_char(26)}{text.from_char(13)}{text.from_char(10)}{text.from_char(9)}{text.from_char(127)}{text.from_char(0)}{e}x{e}"
    print(describe_all(term.parse_keys(bytes(more))))
    print(describe_all(term.parse_keys(bytes("é€😀 x"))))
    print(describe_all(term.parse_keys([])))
    print(describe_all(term.parse_keys(bytes("{e}[99~{e}[1;2Q"))))
}

fn pipe_is_not_a_tty() ! io.Error {
    let dir = file.temp_dir("termt")?
    defer file.remove_all(dir) or {}
    using f = file.create("{dir}/plain")?
    print(term.is_tty(f.handle.fd))
    print(term.is_tty(-1))
    let s = term.size(f.handle.fd) or term.Size { columns: -1, rows: -1 }
    print("{s.columns} {s.rows}")
    print(raw_fails(f.handle.fd))
}

fn raw_fails(fd: i64) -> bool {
    using raw = term.enter_raw(fd) or return true
    false
}

fn colours(pty: term.PtyHandle) {
    os.unset_env("NO_COLOR") or {}
    os.unset_env("CLICOLOR_FORCE") or {}
    os.set_env("TERM", "xterm") or {}
    print(term.colour_enabled(pty.slave))
    print(term.colour_enabled(-1))
    os.set_env("NO_COLOR", "1") or {}
    print(term.colour_enabled(pty.slave))
    os.set_env("CLICOLOR_FORCE", "1") or {}
    print(term.colour_enabled(-1))
    os.set_env("NO_COLOR", "") or {}
    print(term.colour_enabled(-1))
    os.set_env("CLICOLOR_FORCE", "0") or {}
    print(term.colour_enabled(-1))
    os.unset_env("CLICOLOR_FORCE") or {}
    os.unset_env("NO_COLOR") or {}
    os.set_env("TERM", "dumb") or {}
    print(term.colour_enabled(pty.slave))
    os.set_env("TERM", "xterm") or {}
    print(term.colour_enabled(pty.slave))
}

fn sizes(pty: term.PtyHandle) ! io.Error {
    print(term.is_tty(pty.master))
    print(term.is_tty(pty.slave))
    term.set_size(pty.master, term.Size { columns: 132, rows: 43 })?
    let s = term.size(pty.slave)?
    print("{s.columns}x{s.rows}")
    let m = term.size(pty.master)?
    print("{m.columns}x{m.rows}")
}

fn raw_mode(pty: term.PtyHandle) ! io.Error {
    print(term.is_raw(pty.slave)?)
    explicit(pty)?
    print(term.is_raw(pty.slave)?)
    scoped(pty)?
    print(term.is_raw(pty.slave)?)
}

fn explicit(pty: term.PtyHandle) ! io.Error {
    using raw = term.enter_raw(pty.slave)?
    print(term.is_raw(pty.slave)?)
    term.restore(raw)
    print(term.is_raw(pty.slave)?)
    term.restore(raw)
}

fn scoped(pty: term.PtyHandle) ! io.Error {
    using raw = term.enter_raw(pty.slave)?
    print(term.is_raw(pty.slave)?)
}

fn key_for(pty: term.PtyHandle, input: str) -> str ! io.Error {
    term.write_all(pty.master, input)?
    describe(term.read_key(pty.slave)?)
}

fn read_keys(pty: term.PtyHandle) ! io.Error {
    using raw = term.enter_raw(pty.slave)?
    let e = esc()
    print(key_for(pty, "q")?)
    print(key_for(pty, "{e}[A")?)
    print(key_for(pty, "{e}[1;5D")?)
    print(key_for(pty, "{e}OP")?)
    print(key_for(pty, "{e}[24~")?)
    print(key_for(pty, "{e}[3~")?)
    print(key_for(pty, text.from_char(3))?)
    print(key_for(pty, text.from_char(13))?)
    print(key_for(pty, "{e}b")?)
    print(key_for(pty, "é")?)
    print(key_for(pty, e)?)
    print(key_for(pty, "{e}[")?)
    term.write_all(pty.master, "xy{e}[Bz")?
    var seen: []str = []
    for _ in 0..4 {
        push(mut seen, describe(term.read_key(pty.slave)?))
    }
    print(text.join(seen, " "))
    let waiter = chan[i64]()
    spawn delayed_write(pty.master, waiter)
    print(describe(term.read_key(pty.slave)?))
    let _ = <-waiter
}

fn delayed_write(master: i64, done: chan[i64]) {
    sleep(30)
    term.write_all(master, "{esc()}[D") or {}
    done <- 1
}

fn pty_session() ! io.Error {
    using pty = term.open_pty()?
    print(text.starts_with(pty.handle.path, "/dev/pts/"))
    colours(pty.handle)
    sizes(pty.handle)?
    raw_mode(pty.handle)?
    read_keys(pty.handle)?
    term.close_pty(pty)
    term.close_pty(pty)
}

fn main() {
    styles()
    cursor()
    stripping()
    keys()
    pipe_is_not_a_tty() or print("pipe failed")
    pty_session() or print("pty failed")
}
