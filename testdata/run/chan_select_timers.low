fn feed(c: chan[i64], base: i64, count: i64, pause: i64) {
    for i in 0..count {
        c <- base + i
        if pause > 0 && i % 25 == 0 {
            sleep(pause)
        }
    }
    close(c)
}

fn gather(a: chan[i64], b: chan[i64], c: chan[i64], d: chan[i64], e: chan[i64], f: chan[i64], g: chan[i64], h: chan[i64], out: chan[i64]) {
    let never = chan[i64]()
    var ca = a
    var cb = b
    var cc = c
    var cd = d
    var ce = e
    var cf = f
    var cg = g
    var ch = h
    var open = 8
    var total = 0
    var ticks = 0
    for open > 0 {
        let r = select {
            v = <-ca => v ?? -1
            v = <-cb => v ?? -2
            v = <-cc => v ?? -3
            v = <-cd => v ?? -4
            v = <-ce => v ?? -5
            v = <-cf => v ?? -6
            v = <-cg => v ?? -7
            v = <-ch => v ?? -8
            after(2) => -100
        }
        if r >= 0 {
            total += r
        } else if r == -100 {
            ticks += 1
        } else {
            open -= 1
            if r == -1 {
                ca = never
            } else if r == -2 {
                cb = never
            } else if r == -3 {
                cc = never
            } else if r == -4 {
                cd = never
            } else if r == -5 {
                ce = never
            } else if r == -6 {
                cf = never
            } else if r == -7 {
                cg = never
            } else {
                ch = never
            }
        }
    }
    out <- total
    out <- ticks
}

fn round(per: i64) {
    let chans = [chan[i64](4), chan[i64](), chan[i64](1), chan[i64](16), chan[i64](), chan[i64](2), chan[i64](8), chan[i64]()]
    let out = chan[i64](2)
    spawn gather(chans[0], chans[1], chans[2], chans[3], chans[4], chans[5], chans[6], chans[7], out)
    var expected = 0
    for k in 0..8 {
        let base = k * 100000
        for i in 0..per {
            expected += base + i
        }
        var pause = 0
        if k % 3 == 0 {
            pause = 4
        }
        spawn feed(chans[k], base, per, pause)
    }
    let total = (<-out) ?? -1
    let ticks = (<-out) ?? -1
    print("{per} {total} {total == expected} timers {ticks > 0}")
}

fn main() {
    round(100)
    round(1000)
    let quiet = chan[i64]()
    var fired = 0
    for i in 0..10 {
        let r = select {
            <-quiet => -1
            after(1) => 1
        }
        fired += r
    }
    print(fired)
}
