fn filled(length: i64, seed: i64) -> []i64 {
    var out: []i64 = []
    for i in 0..length {
        push(mut out, seed + i)
    }
    out
}

fn abandon(c: chan[[]i64], seed: i64) -> i64 {
    let payload = filled(1000000, seed)
    select {
        c <- payload => 1
        after(1) => 0
    }
}

fn main() {
    var channels: []chan[[]i64] = []
    for i in 0..16 {
        push(mut channels, chan[[]i64]())
    }
    var sent = 0
    for i in 0..16 {
        sent += abandon(channels[i], i)
    }
    var total = 0
    for i in 0..16 {
        let fresh = filled(1000000, i)
        total += fresh[fresh.len - 1]
    }
    print("{sent} {total} {channels.len}")
}
