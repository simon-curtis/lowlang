import std/hash
import std/image
import std/io

fn transparent_cleared(pixels: []u8) -> []u8 {
    var out: []u8 = []
    io.append(mut out, pixels)
    var i = 0
    for i < out.len {
        if out[i + 3] == 0 {
            out[i] = 0
            out[i + 1] = 0
            out[i + 2] = 0
        }
        i += 4
    }
    out
}

fn frames_crc(data: []u8) -> u32 ! io.Error {
    var all: []u8 = []
    for f in image.decode_gif_frames(data)? {
        io.append(mut all, f.image.pixels)
    }
    hash.crc32(transparent_cleared(all))
}

fn crc(data: []u8, kind: str) -> u32 ! io.Error {
    if kind == "frames" {
        return frames_crc(data)
    }
    let img = image.decode(data)?
    if kind == "16" {
        return hash.crc32(image.convert(img, Rgba16).pixels)
    }
    if kind == "orient" {
        let turned = image.orient(img, image.exif_orientation(data))
        return hash.crc32(image.convert(turned, Rgba8).pixels)
    }
    hash.crc32(image.convert(img, Rgba8).pixels)
}

fn check(name: str, contents: str, kind: str) {
    let value = crc(bytes(contents), kind) catch {
        Malformed => {
            print("{name} malformed")
            return
        }
        Unsupported => {
            print("{name} unsupported")
            return
        }
        _ => {
            print("{name} failed")
            return
        }
    }
    print("{name} {value}")
}

fn main() ! io.Error {
    check("gray1.png", embed("gray1.png"), "8")
    check("gray2.png", embed("gray2.png"), "8")
    check("gray4.png", embed("gray4.png"), "8")
