    check("topdown.bmp", embed("topdown.bmp"), "8")
    check("static.gif", embed("static.gif"), "8")
    check("interlaced.gif", embed("interlaced.gif"), "8")
    check("transparent.gif", embed("transparent.gif"), "8")
    check("animated.gif", embed("animated.gif"), "frames")
