    var delays = "delays"
    for f in image.decode_gif_frames(bytes(embed("animated.gif")))? {
        delays = "{delays} {f.delay_ms}"
    }
    print(delays)
    let six = image.exif_orientation(bytes(embed("orient6.jpg")))
    let eight = image.exif_orientation(bytes(embed("orient8.jpg")))
    let five = image.exif_orientation(bytes(embed("orient5.jpg")))
    let three = image.exif_orientation(bytes(embed("orient3.jpg")))
    print("orientation {six} {eight} {five} {three}")
