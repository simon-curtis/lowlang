import std/time/duration
import std/time/fault
import std/time/rounding
import std/time/span
import std/time/timeofday

fn describe(e: fault.Fault) -> str {
    match e {
        Syntax(at) => "syntax {at}"
        Overflow => "overflow"
        Invalid(what) => "invalid {what}"
        OutOfRange(what) => "range {what}"
        _ => "other"
    }
}

fn mode_name(m: rounding.Rounding) -> str {
    match m {
        Trunc => "trunc"
        Ceil => "ceil"
        Floor => "floor"
        Expand => "expand"
        HalfExpand => "half_expand"
        HalfEven => "half_even"
        HalfTrunc => "half_trunc"
        HalfCeil => "half_ceil"
        HalfFloor => "half_floor"
    }
}

fn all_modes() -> []rounding.Rounding {
    [
        rounding.Rounding.Trunc,
        rounding.Rounding.Ceil,
        rounding.Rounding.Floor,
        rounding.Rounding.Expand,
        rounding.Rounding.HalfExpand,
        rounding.Rounding.HalfEven,
        rounding.Rounding.HalfTrunc,
        rounding.Rounding.HalfCeil,
        rounding.Rounding.HalfFloor
    ]
}

fn tm(h: i64, m: i64, s: i64, ns: i64) -> timeofday.TimeOfDay {
    timeofday.of(h, m, s, ns) catch {
        e => timeofday.midnight()
    }
}

fn at_nanos(n: i64) -> timeofday.TimeOfDay {
    timeofday.from_nanos_of_day(n) catch {
        e => timeofday.midnight()
    }
}

fn shown(t: timeofday.TimeOfDay) -> str {
    "{timeofday.to_string(t)}|{timeofday.to_string_seconds(t)}|{timeofday.to_string_full(t)}"
}

fn full(t: timeofday.TimeOfDay) -> str {
    timeofday.to_string_full(t)
}

fn unit_at(n: i64) -> span.Unit {
    span.unit_of(n)
}

fn unit_label(n: i64) -> str {
    span.unit_name(span.unit_of(n))
}

fn parts(t: timeofday.TimeOfDay) -> str {
    "{timeofday.hour(t)} {timeofday.minute(t)} {timeofday.second(t)} {timeofday.nanosecond(t)} {timeofday.millisecond(t)} {timeofday.microsecond(t)} {timeofday.nanos_of_day(t)}"
}

fn of_text(h: i64, m: i64, s: i64, ns: i64) -> str {
    let t = timeofday.of(h, m, s, ns) catch {
        e => return describe(e)
    }
    "{shown(t)} {parts(t)}"
}

fn from_nanos_text(n: i64) -> str {
    let t = timeofday.from_nanos_of_day(n) catch {
        e => return describe(e)
    }
    shown(t)
}

fn hm_text(h: i64, m: i64) -> str {
    let t = timeofday.hm(h, m) catch {
        e => return describe(e)
    }
    shown(t)
}

fn constructors() {
    print("-- of")
    let table = [
        0, 0, 0, 0, 23, 59, 59, 999999999, 12, 30, 45, 123456789,
        1, 2, 3, 4, 24, 0, 0, 0, -1, 0, 0, 0,
        0, 60, 0, 0, 0, -1, 0, 0, 0, 0, 60, 0,
        0, 0, -1, 0, 0, 0, 0, 1000000000, 0, 0, 0, -1,
        23, 59, 59, 1000000000, 100, 100, 100, 100, 9223372036854775807, 0, 0, 0,
        0, 0, 0, 9223372036854775807, 5, 0, 0, 0, 5, 59, 59, 0,
        0, 0, 0, 999999999, 0, 0, 0, 500, 0, 0, 0, 1,
        9, 5, 0, 0, 9, 0, 5, 0, 9, 0, 0, 5000000,
        9, 0, 0, 5000, 9, 0, 0, 120, 24, 60, 60, 1000000000,
        0, 60, 60, 0, -9223372036854775807, 0, 0, 0, 12, 0, 0, 0,
        0, 0, 59, 0, 0, 59, 0, 0
    ]
    var i = 0
    for i + 3 < table.len {
        print("of {table[i]} {table[i + 1]} {table[i + 2]} {table[i + 3]} {of_text(table[i], table[i + 1], table[i + 2], table[i + 3])}")
        i += 4
    }
    let pairs = [
        0, 0, 23, 59, 24, 0, 0, 60, 12, 30, -1, 0,
        5, -1, 9, 9, 7, 0, 23, 0
    ]
    i = 0
    for i + 1 < pairs.len {
        print("hm {pairs[i]} {pairs[i + 1]} {hm_text(pairs[i], pairs[i + 1])}")
        i += 2
    }
    print("midnight {shown(timeofday.midnight())} {parts(timeofday.midnight())}")
    print("noon {shown(timeofday.noon())} {parts(timeofday.noon())}")
    print("last {shown(timeofday.last())} {parts(timeofday.last())}")
    for n in [
        0, 1, 86399999999999, 86400000000000, -1, 43200000000000,
        3600000000000, 86400000000001, 9223372036854775807, -9223372036854775807, 59999999999, 60000000000
    ] {
        print("from_nanos_of_day {n} {from_nanos_text(n)}")
    }
}

fn with_hour_text(t: timeofday.TimeOfDay, n: i64) -> str {
    let r = timeofday.with_hour(t, n) catch {
        e => return describe(e)
    }
    full(r)
}

fn with_minute_text(t: timeofday.TimeOfDay, n: i64) -> str {
    let r = timeofday.with_minute(t, n) catch {
        e => return describe(e)
    }
    full(r)
}

fn with_second_text(t: timeofday.TimeOfDay, n: i64) -> str {
    let r = timeofday.with_second(t, n) catch {
        e => return describe(e)
    }
    full(r)
}

fn with_nanosecond_text(t: timeofday.TimeOfDay, n: i64) -> str {
    let r = timeofday.with_nanosecond(t, n) catch {
        e => return describe(e)
    }
    full(r)
}

fn with_fields() {
    print("-- with")
    let bases = [
        13, 45, 30, 123456789, 0, 0, 0, 0, 23, 59, 59, 999999999
    ]
    var i = 0
    for i + 3 < bases.len {
        let t = tm(bases[i], bases[i + 1], bases[i + 2], bases[i + 3])
        for n in [
        0, 1, 12, 23, 24, 30, 59, 60, 999999999, 1000000000, -1, 100
    ] {
            print("with {full(t)} {n} hour {with_hour_text(t, n)} minute {with_minute_text(t, n)} second {with_second_text(t, n)} nanosecond {with_nanosecond_text(t, n)}")
        }
        i += 4
    }
}

fn plus_text(t: timeofday.TimeOfDay, d: duration.Duration) -> str {
    let r = timeofday.plus(t, d) catch {
        e => return describe(e)
    }
    full(r)
}

fn minus_text(t: timeofday.TimeOfDay, d: duration.Duration) -> str {
    let r = timeofday.minus(t, d) catch {
        e => return describe(e)
    }
    full(r)
}

fn arithmetic() {
    print("-- plus")
    let bases = [
        0, 0, 0, 0, 23, 59, 59, 999999999, 12, 0, 0, 0,
        0, 0, 0, 1, 23, 59, 59, 0, 6, 30, 15, 250000000
    ]
    let deltas = [
        0, 0, 0, 1, 0, -1, 1, 0,
        -1, 0, 0, 999999999, 0, -999999999, 60, 0,
        3600, 0, -3600, 0, 43200, 0, -43200, 0,
        86399, 999999999, -86399, -999999999, 86400, 0, -86400, 0,
        86401, 0, -86401, 0, 172800, 5, -172800, -5,
        1000000, 500000000, -1000000, -500000000, 8640000, 0, 9223372036854775807, 999999999,
        -9223372036854775807, -999999999, 3, 500000000, -3, -500000000, 86399, 0,
        0, 500000000
    ]
    var i = 0
    for i + 3 < bases.len {
        let t = tm(bases[i], bases[i + 1], bases[i + 2], bases[i + 3])
        var k = 0
        for k + 1 < deltas.len {
            let d = duration.from_parts(deltas[k], deltas[k + 1])
            print("plus {full(t)} {deltas[k]} {deltas[k + 1]} {plus_text(t, d)} | {minus_text(t, d)} | {full(timeofday.plus_wrapping(t, d))} | {full(timeofday.minus_wrapping(t, d))}")
            k += 2
        }
        i += 4
    }
    print("-- until")
    let times = [
        0, 0, 0, 0, 23, 59, 59, 999999999, 12, 0, 0, 0,
        0, 0, 0, 1, 6, 30, 15, 250000000, 12, 0, 0, 1,
        1, 0, 0, 0, 0, 1, 0, 0
    ]
    i = 0
    for i + 3 < times.len {
        let a = tm(times[i], times[i + 1], times[i + 2], times[i + 3])
        var k = 0
        for k + 3 < times.len {
            let b = tm(times[k], times[k + 1], times[k + 2], times[k + 3])
            print("until {full(a)} {full(b)} {duration.to_string(timeofday.until(a, b))} {duration.to_string(timeofday.since(a, b))} {duration.as_nanos(timeofday.until(a, b)) ?? 0}")
            k += 4
        }
        i += 4
    }
}

fn round_text(t: timeofday.TimeOfDay, unit: i64, inc: i64, m: rounding.Rounding) -> str {
    let r = timeofday.round(t, unit_at(unit), inc, m) catch {
        e => return describe(e)
    }
    full(r)
}

fn wrap_text(t: timeofday.TimeOfDay, unit: i64, inc: i64, m: rounding.Rounding) -> str {
    let r = timeofday.round_wrapping(t, unit_at(unit), inc, m) catch {
        e => return describe(e)
    }
    full(r)
}

fn truncate_text(t: timeofday.TimeOfDay, unit: i64) -> str {
    let r = timeofday.truncate(t, unit_at(unit)) catch {
        e => return describe(e)
    }
    full(r)
}

fn rounding_section() {
    print("-- round")
    let times = [
        0, 0, 0, 0, 1, 30, 0, 0, 2, 30, 0, 0,
        3, 30, 0, 0, 12, 30, 0, 0, 23, 30, 0, 0,
        10, 15, 30, 500000000, 10, 15, 30, 0, 23, 59, 30, 0,
        23, 59, 59, 500000000, 23, 59, 59, 999999999, 11, 59, 30, 0,
        0, 0, 0, 500000000, 6, 0, 0, 0, 5, 7, 30, 0,
        5, 7, 22, 500000000, 15, 2, 30, 0, 7, 45, 0, 0,
        18, 0, 0, 0, 13, 13, 13, 123456500, 9, 9, 9, 123500000,
        8, 0, 0, 1500000, 4, 0, 0, 250, 22, 30, 0, 0,
        21, 0, 0, 500, 23, 59, 59, 999999500, 23, 59, 59, 999500000,
        0, 0, 0, 500, 0, 0, 0, 250
    ]
    let combos = [
        4, 1, 4, 2, 4, 3, 4, 4, 4, 6, 4, 8,
        4, 12, 5, 1, 5, 5, 5, 10, 5, 15, 5, 30,
        6, 1, 6, 15, 6, 30, 7, 1, 7, 250, 7, 500,
        8, 1, 8, 500, 9, 1, 9, 500
    ]
    var i = 0
    for i + 3 < times.len {
        let t = tm(times[i], times[i + 1], times[i + 2], times[i + 3])
        var k = 0
        for k + 1 < combos.len {
            for m in all_modes() {
                print("round {full(t)} {unit_label(combos[k])} {combos[k + 1]} {mode_name(m)} {round_text(t, combos[k], combos[k + 1], m)} | {wrap_text(t, combos[k], combos[k + 1], m)}")
            }
            k += 2
        }
        for u in 4..10 {
            print("truncate {full(t)} {unit_label(u)} {truncate_text(t, u)}")
        }
        i += 4
    }
    print("-- round errors")
    let bad = [
        0, 1, 3, 1, 2, 5, 1, 0, 4, 0, 4, -1,
        4, 24, 4, 5, 4, 7, 4, 25, 4, 12, 5, 60,
        5, 7, 5, 45, 6, 60, 6, 7, 7, 1000, 7, 3,
        8, 1000, 8, 3, 9, 1000, 9, 2000, 9, 3, 9, 0,
        0, 0, 3, 24
    ]
    var k = 0
    for k + 1 < bad.len {
        let t = tm(10, 15, 30, 500000000)
        print("round_bad {unit_label(bad[k])} {bad[k + 1]} {round_text(t, bad[k], bad[k + 1], rounding.Rounding.HalfExpand)} | {wrap_text(t, bad[k], bad[k + 1], rounding.Rounding.HalfExpand)}")
        k += 2
    }
    for u in 0..4 {
        print("truncate_bad {unit_label(u)} {truncate_text(tm(10, 15, 30, 500000000), u)}")
    }
}

fn round_overflows(t: timeofday.TimeOfDay) -> bool {
    let r = timeofday.round(t, span.Unit.Minutes, 15, rounding.Rounding.HalfEven) catch {
        e => return true
    }
    timeofday.nanos_of_day(r) < 0
}

fn quarter_hour(t: timeofday.TimeOfDay) -> timeofday.TimeOfDay {
    timeofday.round(t, span.Unit.Minutes, 15, rounding.Rounding.HalfEven) catch {
        e => t
    }
}

struct Random {
    state: i64
}

fn next_value(mut r: Random) -> i64 {
    r.state = (r.state * 1103515245 + 12345) % 2147483648
    r.state
}

fn property() {
    print("-- property")
    var r = Random { state: 20261111 }
    var total = 0
    var roundtrips = 0
    var plus_ok = 0
    var plus_sum = 0
    var wrap_plus_sum = 0
    var wrap_minus_sum = 0
    var round_sum = 0
    var wrap_round_sum = 0
    var overflow_rounds = 0
    for _ in 0..2000 {
        let high = next_value(mut r)
        let low = next_value(mut r)
        let spread = next_value(mut r)
        let n = (high * 2147483648 + low) % 86400000000000
        let delta = spread * 1000000 - 1073741824000000
        let t = at_nanos(n)
        let d = duration.nanoseconds(delta)
        total += 1
        let a = timeofday.parse(timeofday.to_string(t)) catch {
            e => timeofday.midnight()
        }
        let b = timeofday.parse(timeofday.to_string_full(t)) catch {
            e => timeofday.midnight()
        }
        let c = timeofday.parse("T{timeofday.to_string_seconds(t)}") catch {
            e => timeofday.midnight()
        }
        if timeofday.equal(a, t) && timeofday.equal(b, t) && timeofday.equal(c, t) {
            roundtrips += 1
        }
        let p = timeofday.plus(t, d) catch {
            e => t
        }
        if n + delta >= 0 && n + delta < 86400000000000 {
            plus_ok += 1
            plus_sum += timeofday.nanos_of_day(p)
        }
        wrap_plus_sum += timeofday.nanos_of_day(timeofday.plus_wrapping(t, d))
        wrap_minus_sum += timeofday.nanos_of_day(timeofday.minus_wrapping(t, d))
        if round_overflows(t) {
            overflow_rounds += 1
        } else {
            round_sum += timeofday.nanos_of_day(quarter_hour(t))
        }
        let wrapped = timeofday.round_wrapping(t, span.Unit.Minutes, 15, rounding.Rounding.HalfEven) catch {
            e => t
        }
        wrap_round_sum += timeofday.nanos_of_day(wrapped)
    }
    print("property total {total} roundtrips {roundtrips} plus_ok {plus_ok} plus_sum {plus_sum} wrap_plus_sum {wrap_plus_sum} wrap_minus_sum {wrap_minus_sum} round_sum {round_sum} wrap_round_sum {wrap_round_sum} overflow_rounds {overflow_rounds}")
}

fn parsed(s: str) -> str {
    let r = timeofday.parse(s) catch {
        e => return "{s} -> {describe(e)}"
    }
    "{s} -> {full(r)}"
}

fn parsing() {
    print("-- parse")
    let valid = [
        "00:00:00", "000000", "T00:00:00", "t000000",
        "00:00", "0000", "T00:00", "00",
        "T00", "t00", "12:00:00", "120000",
        "T12:00:00", "t120000", "12:00", "1200",
        "T12:00", "12", "T12", "t12",
        "23:59:59.999999999", "235959.999999999", "T23:59:59.999999999", "t235959.999999999",
        "09:05:03", "090503", "T09:05:03", "t090503",
        "09:05:03.000000004", "090503.000000004", "T09:05:03.000000004", "t090503.000000004",
        "09:05:03.0000123", "090503.0000123", "T09:05:03.0000123", "t090503.0000123",
        "09:05:03.000012300", "090503.000012300", "T09:05:03.000012300", "t090503.000012300",
        "13:45:00", "134500", "T13:45:00", "t134500",
        "13:45", "1345", "T13:45", "13:45:30.1",
        "134530.1", "T13:45:30.1", "t134530.1", "13:45:30.100000000",
        "134530.100000000", "T13:45:30.100000000", "t134530.100000000", "01:02:03.123456789",
        "010203.123456789", "T01:02:03.123456789", "t010203.123456789", "07:00:00",
        "070000", "T07:00:00", "t070000", "07:00",
        "0700", "T07:00", "07", "T07",
        "t07", "23:00:00", "230000", "T23:00:00",
        "t230000", "23:00", "2300", "T23:00",
        "23", "T23", "t23", "00:59:00",
        "005900", "T00:59:00", "t005900", "00:59",
        "0059", "T00:59", "20:20:20.2002002", "202020.2002002",
        "T20:20:20.2002002", "t202020.2002002", "20:20:20.200200200", "202020.200200200",
        "T20:20:20.200200200", "t202020.200200200", "00:00:01", "000001",
        "T00:00:01", "t000001", "00:01:00", "000100",
        "T00:01:00", "t000100", "00:01", "0001",
        "T00:01", "10:00:00.5", "100000.5", "T10:00:00.5",
        "t100000.5", "10:00:00.500000000", "100000.500000000", "T10:00:00.500000000",
        "t100000.500000000", "23:59:60", "23:59:60.5", "12:00:60.25",
        "00:00:60", "235960", "T00:00:60.999999999", "12:34:56.1",
        "12:34:56.12", "12:34:56.123", "12:34:56.1234", "12:34:56.12345",
        "12:34:56.123456", "12:34:56.1234567", "12:34:56.12345678", "12:34:56.123456789",
        "12:34:56.000000001", "12:34:56.0", "12:34:56.000", "123456.5",
        "00"
    ]
    for s in valid {
        print("parse {parsed(s)}")
    }
    let invalid = [
        "", "T", "t", "1",
        "12:", "12:3", "12:34:", "12:34:5",
        "12:34:56.", "12:34:56.1234567890", "12:34:56.5x", "12:34x",
        "12x", "1234x", "123", "12345",
        "123456.", "1234.5", "12:34.5", "24:00",
        "12:60", "12:34:61", "25:61:61", "24:61",
        "99", "12:34:56 ", " 12:34", "12:34:56Z",
        "12:34:56+01", "TT12", "12-34", "12:3a",
        "1a", "a1", "12::34", "12:34:56,5",
        "12:34:56.5.5", "-12:00", "+12:00", "12:34:5a",
        "123a", "1234567", "12345678", "12:34:56.1234567891",
        "00:00:62", "00:60:00", "23:59:59.9999999999", "T12:",
        "tT", "12:34:60.", "12:34:99", "2400",
        "1260", "126060", "126061", "T24",
        "12:00:00:00", "12:00:00.5:1"
    ]
    for s in invalid {
        print("parse {parsed(s)}")
    }
}

fn ordering() {
    print("-- compare")
    let all = [
        0, 0, 0, 0, 0, 0, 0, 1, 12, 0, 0, 0,
        12, 0, 0, 1, 23, 59, 59, 999999999, 6, 30, 15, 250000000
    ]
    var i = 0
    var ts: []timeofday.TimeOfDay = []
    for i + 3 < all.len {
        push(mut ts, tm(all[i], all[i + 1], all[i + 2], all[i + 3]))
        i += 4
    }
    for a in ts {
        var row = ""
        for b in ts {
            row = "{row}{timeofday.compare(a, b)} "
        }
        print("compare {full(a)} {row}")
    }
    for a in ts {
        for b in ts {
            print("order {full(a)} {full(b)} {timeofday.equal(a, b)} {timeofday.before(a, b)} {timeofday.after(a, b)} {full(timeofday.min(a, b))} {full(timeofday.max(a, b))} {a == b}")
        }
    }
}

fn main() {
    constructors()
    with_fields()
    arithmetic()
    rounding_section()
    property()
    parsing()
    ordering()
}
