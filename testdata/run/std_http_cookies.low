import std/header
import std/http
import std/io
import std/net
import std/sync
import std/text

fn quoted(s: str) -> str {
    if s.len == 0 { "(none)" } else { s }
}

fn sent(jar: http.CookieJar, url: str) {
    print("  {url} sends {quoted(http.jar_header(jar, url))}")
}

fn stored(jar: http.CookieJar, url: str, line: str) {
    print("  {line} from {url}: {http.jar_set(jar, url, line)}")
}

fn parsing() {
    print("default path")
    let jar = http.cookie_jar()
    stored(jar, "http://www.example.com/a/b/c", "x=1")
    sent(jar, "http://www.example.com/a/b")
    sent(jar, "http://www.example.com/a/b/deeper?q=1")
    sent(jar, "http://www.example.com/a/bc")
    sent(jar, "http://www.example.com/a")
    sent(jar, "http://www.example.com/")
    stored(jar, "http://www.example.com/", "y=2")
    stored(jar, "http://www.example.com/only", "z=3; Path=relative")
    sent(jar, "http://www.example.com/")
    sent(jar, "http://www.example.com/only")

    print("host-only and domain cookies")
    let domains = http.cookie_jar()
    stored(domains, "http://www.example.com/", "host=1")
    stored(domains, "http://www.example.com/", "wide=2; Domain=example.com")
    stored(domains, "http://www.example.com/", "dotted=3; Domain=.Example.COM")
    for url in ["http://www.example.com/", "http://example.com/", "http://api.example.com/", "http://notexample.com/", "http://example.org/", "http://deep.api.example.com/"] {
        sent(domains, url)
    }
    stored(domains, "http://a.example.com/", "bad=1; Domain=b.example.com")
    stored(domains, "http://a.example.com/", "up=1; Domain=com")
    stored(domains, "http://example.com/", "child=1; Domain=sub.example.com")
    stored(domains, "http://a.example.com/", "empty=1; Domain=.")
    print("  cookies kept {http.jar_cookies(domains).len}")

    print("ip hosts")
    let ips = http.cookie_jar()
    stored(ips, "http://127.0.0.1/", "a=1; Domain=127.0.0.1")
    stored(ips, "http://127.0.0.1/", "b=1; Domain=0.0.1")
    stored(ips, "http://127.0.0.1/", "c=1")
    sent(ips, "http://127.0.0.1/")
    sent(ips, "http://localhost/")

    print("secure cookies")
    let secure = http.cookie_jar()
    stored(secure, "https://shop.example/", "s=1; Secure")
    stored(secure, "http://shop.example/", "insecure=1; Secure")
    stored(secure, "http://shop.example/", "plain=1")
    sent(secure, "https://shop.example/")
    sent(secure, "http://shop.example/")
    stored(secure, "http://shop.example/", "s=overwritten")
    stored(secure, "https://shop.example/", "s=replaced; Secure")
    sent(secure, "https://shop.example/")
    stored(secure, "https://shop.example/", "__Host-id=1; Secure; Path=/")
    stored(secure, "https://shop.example/", "__Host-wide=1; Secure; Path=/; Domain=shop.example")
    stored(secure, "https://shop.example/", "__Host-deep=1; Secure; Path=/a")
    stored(secure, "https://shop.example/", "__Secure-t=1")
    stored(secure, "https://shop.example/", "__Secure-t=1; Secure")
    sent(secure, "https://shop.example/")

    print("lifetimes")
    let life = http.cookie_jar()
    stored(life, "http://t.example/", "fresh=1; Max-Age=3600")
    stored(life, "http://t.example/", "far=1; Expires=Thu, 01 Jan 2099 00:00:00 GMT")
    stored(life, "http://t.example/", "weekday=1; Expires=Fri, 31-Dec-2099 23:59:59 GMT")
    stored(life, "http://t.example/", "ancient=1; Expires=Sun, 06 Nov 1994 08:49:37 GMT")
    stored(life, "http://t.example/", "rfc850=1; Expires=Sunday, 06-Nov-94 08:49:37 GMT")
    stored(life, "http://t.example/", "precedence=1; Expires=Thu, 01 Jan 2099 00:00:00 GMT; Max-Age=0")
    stored(life, "http://t.example/", "negative=1; Max-Age=-5")
    stored(life, "http://t.example/", "garbled=1; Max-Age=abc; Expires=Thu, 01 Jan 2099 00:00:00 GMT")
    stored(life, "http://t.example/", "badtime=1; Expires=Thu, 01 Jan 2099 25:00:00 GMT")
    stored(life, "http://t.example/", "session=1")
    for c in http.jar_cookies(life) {
        let seconds = c.expires / 1000
        print("  {c.name} expires {if c.expires == 0x7FFFFFFFFFFFFFFF { "never" } else if c.name == "fresh" { "in an hour" } else { "{seconds}" }}")
    }
    stored(life, "http://t.example/", "far=gone; Max-Age=0")
    stored(life, "http://t.example/", "session=gone; Expires=Sun, 06 Nov 1994 08:49:37 GMT")
    print("  after deletion {http.jar_cookies(life).len} cookies")
    stored(life, "http://t.example/", "short=1; Max-Age=1")
    print("  before expiry: {quoted(http.jar_header(life, "http://t.example/"))}")
    sleep(1300)
    print("  after expiry: {quoted(http.jar_header(life, "http://t.example/"))}")
    var names: []str = []
    for c in http.jar_cookies(life) {
        push(mut names, c.name)
    }
    print("  jar holds {text.join(names, " ")}")

    print("attributes")
    let attrs = http.cookie_jar()
    stored(attrs, "http://attr.example/", "a=1; HttpOnly; SameSite=Strict")
    stored(attrs, "http://attr.example/", "B=2; SAMESITE=lax; PATH=/x")
    stored(attrs, "http://attr.example/", "c=3; SameSite=None")
    stored(attrs, "http://attr.example/", "d=4; SameSite=sideways; unknown=1; flag")
    stored(attrs, "http://attr.example/", "e=a=b=c ; Path=/")
    stored(attrs, "http://attr.example/", "novalue")
    stored(attrs, "http://attr.example/", "=anonymous")
    stored(attrs, "http://attr.example/", "quoted=\"hello world\"")
    for c in http.jar_cookies(attrs) {
        let same_site = match c.same_site {
            Unset => "unset"
            NoRestriction => "none"
            Lax => "lax"
            Strict => "strict"
        }
        print("  {c.name}={c.value} path={c.path} http_only={c.http_only} same_site={same_site} host_only={c.host_only}")
    }
    print("  sends {http.jar_header(attrs, "http://attr.example/x/y")}")

    print("ordering")
    let order = http.cookie_jar()
    stored(order, "http://o.example/a/b/c", "first=1; Path=/")
    stored(order, "http://o.example/a/b/c", "second=2; Path=/a/b")
    stored(order, "http://o.example/a/b/c", "third=3; Path=/a")
    stored(order, "http://o.example/a/b/c", "fourth=4; Path=/")
    sent(order, "http://o.example/a/b/c")
    stored(order, "http://o.example/a/b/c", "first=changed; Path=/")
    sent(order, "http://o.example/a/b/c")
    http.jar_clear(order)
    sent(order, "http://o.example/a/b/c")
}

fn limits() {
    print("capacity")
    let jar = http.cookie_jar()
    for i in 0..60 {
        http.jar_set(jar, "http://full.example/", "c{i}={i}")
    }
    let header = http.jar_header(jar, "http://full.example/")
    print("  cookies kept for one domain {http.jar_cookies(jar).len}")
    print("  oldest evicted {!text.contains(header, "c0=0;") && !text.contains(header, "c9=9;")}")
    print("  newest kept {text.contains(header, "c59=59")}")
    let busy = http.cookie_jar()
    for i in 0..25 {
        http.jar_set(busy, "http://busy.example/", "deep{i}={i}; Path=/a")
        http.jar_set(busy, "http://busy.example/", "root{i}={i}; Path=/")
    }
    http.jar_header(busy, "http://busy.example/")
    http.jar_set(busy, "http://busy.example/", "extra=1")
    let after = http.jar_header(busy, "http://busy.example/a")
    print("  least recently sent is evicted: {!text.contains(after, "deep0=0;")} {text.contains(after, "root0=0;")} {text.contains(after, "extra=1")}")

    let oversize = http.cookie_jar()
    print("  oversize value {http.jar_set(oversize, "http://big.example/", "big={text.repeat("x", 5000)}")}")
    print("  long attribute ignored {http.jar_set(oversize, "http://big.example/", "ok=1; Path=/{text.repeat("p", 2000)}")}")
    print("  long attribute path {http.jar_cookies(oversize)[0].path}")
}

fn writer(jar: http.CookieJar, id: i64, group: sync.WaitGroup) {
    for k in 0..20 {
        http.jar_set(jar, "http://h{id}.example.com/", "t{k}={id}")
        http.jar_header(jar, "http://h{id}.example.com/")
    }
    sync.done(group)
}

fn concurrency() {
    print("threads")
    let jar = http.cookie_jar()
    let group = sync.wait_group()
    sync.add(group, 8)
    for id in 0..8 {
        spawn writer(jar, id, group)
    }
    sync.wait(group)
    print("  cookies after 8 writers {http.jar_cookies(jar).len}")
    var each = true
    for id in 0..8 {
        let header = http.jar_header(jar, "http://h{id}.example.com/")
        each = each && text.split(header, ';').len == 20 && text.contains(header, "t19={id}")
    }
    print("  every writer's cookies intact {each}")
}

fn answer(req: http.Request) -> http.Response {
    let cookie = header.get(req.headers, "cookie") ?? "-"
    let p = req.path
    if p == "/login" {
        return http.Response {
            status: 200
            headers: [
                header.Header { name: "set-cookie", value: "sid=abc123; Path=/; HttpOnly; SameSite=Lax" }
                header.Header { name: "set-cookie", value: "pref=dark; Path=/app; Max-Age=3600" }
                header.Header { name: "set-cookie", value: "wide=1; Domain=site.test; Path=/" }
            ]
            body: bytes("logged in")
        }
    }
    if p == "/bounce" {
        return http.Response {
            status: 302
            headers: [
                header.Header { name: "set-cookie", value: "hop=1; Path=/" }
                header.Header { name: "location", value: "/echo" }
            ]
            body: []
        }
    }
    if p == "/to-other" {
        return http.Response {
            status: 302
            headers: [header.Header { name: "location", value: "http://other.test:{req.authority[text.last_index_byte(req.authority, ':') + 1..]}/echo" }]
            body: []
        }
    }
    if p == "/logout" {
        return http.Response {
            status: 200
            headers: [
                header.Header { name: "set-cookie", value: "sid=; Path=/; Max-Age=0" }
                header.Header { name: "set-cookie", value: "wide=; Path=/; Expires=Thu, 01 Jan 1970 00:00:00 GMT; Domain=site.test" }
            ]
            body: bytes("logged out")
        }
    }
    if p == "/secure-set" {
        return http.Response {
            status: 200
            headers: [header.Header { name: "set-cookie", value: "tls_only=1; Secure; Path=/" }]
            body: bytes("tried")
        }
    }
    http.response(200, "{text.split(req.authority, ':')[0]} {p} cookie={cookie}")
}

fn run(l: net.ListenerHandle) {
    let handler = fn(req: http.Request) -> http.Response { answer(req) }
    http.serve_on(l, handler) catch {
        _ => {}
    }
}

fn through(c: *http.Client, url: str, port: i64) -> str {
    let r = c.get(url) catch {
        _ => return "request failed"
    }
    "{r.status} {text.replace(http.text(r), "{port}", "PORT")}"
}

fn exchange() ! io.Error {
    using l = net.listen("127.0.0.1", 0)?
    spawn run(l.handle)
    let port = l.handle.addr.port
    let resolver = fn(host: str) -> [][]u8 ! io.Error { [net.parse_ip("127.0.0.1")?] }
    let jar = http.cookie_jar()
    let c = http.client().with_cookie_jar(jar).with_resolver(resolver).build()
    let site = "http://site.test:{port}"

    print("network")
    print(through(c, "{site}/echo", port))
    print(through(c, "{site}/login", port))
    print(through(c, "{site}/echo", port))
    print(through(c, "{site}/app/echo", port))
    print(through(c, "http://api.site.test:{port}/app/echo", port))
    print(through(c, "http://other.test:{port}/echo", port))
    print("stored by redirect response:")
    print(through(c, "{site}/bounce", port))
    print("no cookie of site.test reaches another host:")
    print(through(c, "{site}/to-other", port))
    print("secure cookie from a plain response is dropped:")
    print(through(c, "{site}/secure-set", port))
    print(through(c, "{site}/echo", port))
    print("a second client shares the jar:")
    let twin = http.client().with_cookie_jar(jar).with_resolver(resolver).build()
    print(through(twin, "{site}/echo", port))
    print("a request header joins the jar's cookies:")
    let merged = c.request("GET", "{site}/echo").with_header("cookie", "manual=1").send() catch {
        _ => return
    }
    print(text.replace(http.text(merged), "{port}", "PORT"))
    print("logout deletes:")
    print(through(c, "{site}/logout", port))
    print(through(c, "{site}/echo", port))
    print("client without a jar:")
    let bare = http.client().with_resolver(resolver).build()
    print(through(bare, "{site}/login", port))
    print(through(bare, "{site}/echo", port))
    print("cookies_for sees the jar: {c.cookies_for("{site}/echo")}")
    print("jar after the session {http.jar_cookies(jar).len}")
}

fn main() ! io.Error {
    parsing()
    limits()
    concurrency()
    exchange()?
}
