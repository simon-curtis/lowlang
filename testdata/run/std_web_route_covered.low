import std/web

fn main() {
    let app = web.app()
    let _ = web.get(app, "/files/:name", fn(c) { web.text(200, "file") })
    let _ = web.post(app, "/files/new", fn(c) { web.text(200, "create") })
    let _ = web.get(app, "/files/:name/versions", fn(c) { web.text(200, "versions") })
    let _ = web.get(app, "/assets/*", fn(c) { web.text(200, "asset") })
    let _ = web.route(app, "HEAD", "/health", fn(c) { web.text(200, "") })
    let _ = web.get(app, "/health", fn(c) { web.text(200, "ok") })
    let _ = web.get(app, "/users/me", fn(c) { web.text(200, "me") })
    let _ = web.get(app, "/users/:id", fn(c) { web.text(200, "user") })
    let api = web.group(app, "/api", [])
    let _ = web.get(api, "/*", fn(c) { web.text(200, "api") })
    print("registered")
    let _ = web.route(app, "HEAD", "/files/new", fn(c) { web.text(200, "") })
}
