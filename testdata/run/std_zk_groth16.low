import std/crypto/zk/groth16
import std/crypto/zk/pairing
import std/text

struct Counts {
    pass: i64
    bad: i64
}

struct Circuit {
    name: str
    curve: *pairing.Curve
    r1cs: str
    wtns: str
    vkey: str
    proof: str
    public: str
    ours_vkey: str
    ours_proof: str
}

fn record(counts: *Counts, ok: bool, label: str) {
    if ok {
        counts.pass += 1
    } else {
        counts.bad += 1
        print("FAIL {label}")
    }
}

fn error_name(e: groth16.Error) -> str {
    match e {
        Truncated => "Truncated"
        Magic => "Magic"
        Unsupported => "Unsupported"
        Prime => "Prime"
        Malformed => "Malformed"
        Point(p) => match p {
            Length => "Point(Length)"
            NotCanonical => "Point(NotCanonical)"
            NotOnCurve => "Point(NotOnCurve)"
            NotInSubgroup => "Point(NotInSubgroup)"
            Flags => "Point(Flags)"
            Unsupported => "Point(Unsupported)"
            Size => "Point(Size)"
        }
        Unsatisfied => "Unsatisfied"
        Size => "Size"
        Inputs => "Inputs"
    }
}

fn proof_outcome(c: *pairing.Curve, text: str) -> str {
    let p = groth16.proof_from_json(c, text) catch { e => return error_name(e) }
    if pairing.is_identity(p.a) { "identity" } else { "ok" }
}

fn key_outcome(c: *pairing.Curve, text: str) -> str {
    let k = groth16.verifying_key_from_json(c, text) catch { e => return error_name(e) }
    if k.ic.len == 0 { "empty" } else { "ok" }
}

fn public_outcome(c: *pairing.Curve, text: str) -> str {
    let p = groth16.public_from_json(c, text) catch { e => return error_name(e) }
    "{p.len}"
}

fn r1cs_outcome(c: *pairing.Curve, data: []u8) -> str {
    let r = groth16.r1cs_from_bytes(c, data) catch { e => return error_name(e) }
    "{r.constraints.len}"
}

fn witness_outcome(c: *pairing.Curve, data: []u8) -> str {
    let w = groth16.witness_from_bytes(c, data) catch { e => return error_name(e) }
    "{w.len}"
}

fn prove_outcome(key: groth16.ProvingKey, r: *groth16.R1cs, w: [][]u64) -> str {
    let one = pairing.fr_one(r.curve)
    let p = groth16.prove_with(key, r, w, one, one) catch { e => return error_name(e) }
    if pairing.is_identity(p.a) { "identity" } else { "ok" }
}

fn proof_bytes_outcome(c: *pairing.Curve, data: []u8) -> str {
    let p = groth16.proof_from_bytes(c, data) catch { e => return error_name(e) }
    if pairing.is_identity(p.a) { "identity" } else { "ok" }
}

fn key_bytes_outcome(c: *pairing.Curve, data: []u8) -> str {
    let k = groth16.verifying_key_from_bytes(c, data) catch { e => return error_name(e) }
    if k.ic.len == 0 { "empty" } else { "ok" }
}

fn toxic(c: *pairing.Curve) -> groth16.Toxic {
    groth16.Toxic {
        tau: pairing.fr_from_u64(c, 0x7a11ce0e5cafe001)
        alpha: pairing.fr_from_u64(c, 0x00c0ffee12345678)
        beta: pairing.fr_from_u64(c, 0x0badcafe87654321)
        gamma: pairing.fr_from_u64(c, 0x5eed5eed0f0f0f0f)
        delta: pairing.fr_from_u64(c, 0x1badb002deadbeef)
    }
}

fn incremented(c: *pairing.Curve, values: [][]u64, index: i64) -> [][]u64 {
    var out: [][]u64 = []
    for i in 0..values.len {
        let v = values[i]
        push(mut out, if i == index { pairing.fr_add(c, v, pairing.fr_one(c)) } else { v })
    }
    out
}

fn same_point(g: *pairing.Group, a: pairing.Point, b: pairing.Point) -> bool {
    pairing.equal(g, a, b)
}

fn same_proof(c: *pairing.Curve, a: groth16.Proof, b: groth16.Proof) -> bool {
    let g1 = pairing.g1(c)
    let g2 = pairing.g2(c)
    same_point(g1, a.a, b.a) && same_point(g2, a.b, b.b) && same_point(g1, a.c, b.c)
}

fn snarkjs_artifacts(counts: *Counts, k: Circuit) {
    let c = k.curve
    let key = groth16.verifying_key_from_json(c, k.vkey) or return
    let proof = groth16.proof_from_json(c, k.proof) or return
    let public = groth16.public_from_json(c, k.public) or return
    record(counts, groth16.verify(key, public, proof), "{k.name} snarkjs proof verifies")

    let altered = incremented(c, public, 0)
    record(counts, !groth16.verify(key, altered, proof), "{k.name} altered public input")
    record(counts, !groth16.verify(key, public[1..], proof), "{k.name} too few public inputs")
    record(counts, !groth16.verify(key, [public[0], public[0]], proof), "{k.name} too many public inputs")

    let g1 = pairing.g1(c)
    let g2 = pairing.g2(c)
    let negated = groth16.Proof { a: pairing.negate(g1, proof.a), b: proof.b, c: proof.c }
    record(counts, !groth16.verify(key, public, negated), "{k.name} negated A")
    let swapped = groth16.Proof { a: proof.a, b: g2.generator, c: proof.c }
    record(counts, !groth16.verify(key, public, swapped), "{k.name} replaced B")
    let doubled = groth16.Proof { a: proof.a, b: proof.b, c: pairing.double(g1, proof.c) }
    record(counts, !groth16.verify(key, public, doubled), "{k.name} doubled C")
    let from_other_setup = groth16.verifying_key_from_json(c, k.ours_vkey) or return
    record(counts, !groth16.verify(from_other_setup, public, proof), "{k.name} proof under another setup")

    let again = groth16.proof_from_json(c, groth16.proof_to_json(c, proof)) or return
    record(counts, same_proof(c, again, proof), "{k.name} proof json round trip")
    let key_again = groth16.verifying_key_from_json(c, groth16.verifying_key_to_json(key)) or return
    record(counts, groth16.verify(key_again, public, proof), "{k.name} key json round trip")
    let public_text = groth16.public_to_json(c, public)
    let public_again = groth16.public_from_json(c, public_text) or return
    record(counts, public_again.len == public.len && pairing.fr_equal(public_again[0], public[0]), "{k.name} public json round trip")

    let proof_data = groth16.proof_to_bytes(c, proof)
    let from_bytes = groth16.proof_from_bytes(c, proof_data) or return
    record(counts, same_proof(c, from_bytes, proof), "{k.name} proof bytes round trip")
    record(counts, proof_bytes_outcome(c, proof_data[1..]) == "Truncated", "{k.name} proof bytes truncated")
    var extended = proof_data
    push(mut extended, 0)
    record(counts, proof_bytes_outcome(c, extended) == "Truncated", "{k.name} proof bytes extended")
    let key_data = groth16.verifying_key_to_bytes(key)
    let key_from_bytes = groth16.verifying_key_from_bytes(c, key_data) or return
    record(counts, groth16.verify(key_from_bytes, public, proof), "{k.name} key bytes round trip")
    record(counts, key_bytes_outcome(c, key_data[..key_data.len - 1]) == "Truncated", "{k.name} key bytes truncated")
}

fn circom_files(counts: *Counts, k: Circuit) {
    let c = k.curve
    let r = groth16.r1cs_from_bytes(c, bytes(k.r1cs)) or return
    let w = groth16.witness_from_bytes(c, bytes(k.wtns)) or return
    record(counts, groth16.satisfied(r, w), "{k.name} witness satisfies")
    record(counts, w.len == r.wires, "{k.name} witness length")
    let rewritten = groth16.witness_to_bytes(c, w)
    record(counts, text.encode_hex(rewritten) == text.encode_hex(bytes(k.wtns)), "{k.name} witness bytes round trip")
    let rebuilt = groth16.r1cs_from_bytes(c, groth16.r1cs_to_bytes(r)) or return
    record(counts, rebuilt.wires == r.wires && rebuilt.public == r.public && rebuilt.constraints.len == r.constraints.len, "{k.name} r1cs round trip shape")
    record(counts, groth16.satisfied(rebuilt, w), "{k.name} r1cs round trip satisfied")

    let wrong = incremented(c, w, w.len - 1)
    record(counts, !groth16.satisfied(r, wrong), "{k.name} altered witness")
    let short = w[..w.len - 1]
    record(counts, !groth16.satisfied(r, short), "{k.name} short witness")

    let data = bytes(k.r1cs)
    let file = bytes(k.wtns)
    record(counts, r1cs_outcome(c, data[..data.len - 1]) == "Truncated", "{k.name} r1cs truncated by one")
    record(counts, r1cs_outcome(c, data[..12]) == "Truncated", "{k.name} r1cs without sections")
    record(counts, r1cs_outcome(c, []) == "Truncated", "{k.name} r1cs empty")
    var bad_magic = bytes(k.r1cs)
    bad_magic[0] = 0x73
    record(counts, r1cs_outcome(c, bad_magic) == "Magic", "{k.name} r1cs magic")
    var bad_version = bytes(k.r1cs)
    bad_version[4] = 2
    record(counts, r1cs_outcome(c, bad_version) == "Unsupported", "{k.name} r1cs version")
    record(counts, witness_outcome(c, file[..file.len - 1]) == "Truncated", "{k.name} wtns truncated by one")
    var wtns_magic = bytes(k.wtns)
    wtns_magic[1] = 0
    record(counts, witness_outcome(c, wtns_magic) == "Magic", "{k.name} wtns magic")
    var cuts = 0
    for length in 0..data.len {
        let outcome = r1cs_outcome(c, data[..length])
        if outcome == "Truncated" || outcome == "Malformed" {
            cuts += 1
        }
    }
    record(counts, cuts == data.len, "{k.name} every r1cs prefix is rejected")
    cuts = 0
    for length in 0..file.len {
        let outcome = witness_outcome(c, file[..length])
        if outcome == "Truncated" || outcome == "Malformed" {
            cuts += 1
        }
    }
    record(counts, cuts == file.len, "{k.name} every wtns prefix is rejected")

    let other = match c.kind {
        Bn254 => pairing.bls12_381()
        Bls12381 => pairing.bn254()
    }
    record(counts, r1cs_outcome(other, data) == "Prime", "{k.name} r1cs for the other curve")
    record(counts, witness_outcome(other, file) == "Prime", "{k.name} wtns for the other curve")
}

fn own_setup(counts: *Counts, k: Circuit) {
    let c = k.curve
    let r = groth16.r1cs_from_bytes(c, bytes(k.r1cs)) or return
    let w = groth16.witness_from_bytes(c, bytes(k.wtns)) or return
    let public = w[1..r.public + 1]
    let keys = groth16.setup_with(r, toxic(c)) or return
    let a = pairing.fr_from_u64(c, 0x1111222233334444)
    let b = pairing.fr_from_u64(c, 0x5555666677778888)
    let proof = groth16.prove_with(keys.proving, r, w, a, b) or return
    record(counts, groth16.verify(keys.verifying, public, proof), "{k.name} own proof verifies")
    record(counts, text.trim(groth16.verifying_key_to_json(keys.verifying)) == text.trim(k.ours_vkey), "{k.name} own verifying key matches the one snarkjs accepted")
    record(counts, text.trim(groth16.proof_to_json(c, proof)) == text.trim(k.ours_proof), "{k.name} own proof matches the one snarkjs accepted")

    let random_keys = groth16.setup(r) or return
    let random_proof = groth16.prove(random_keys.proving, r, w) or return
    record(counts, groth16.verify(random_keys.verifying, public, random_proof), "{k.name} random setup and blinding")
    record(counts, !groth16.verify(keys.verifying, public, random_proof), "{k.name} proof under the wrong key")
    let other_blinding = groth16.prove_with(keys.proving, r, w, b, a) or return
    record(counts, groth16.verify(keys.verifying, public, other_blinding), "{k.name} other blinding verifies")
    record(counts, !same_proof(c, proof, other_blinding), "{k.name} blinding changes the proof")

    let wrong = incremented(c, w, w.len - 1)
    record(counts, prove_outcome(keys.proving, r, wrong) == "Unsatisfied", "{k.name} unsatisfied witness")
    let shorter = groth16.r1cs(c, r.public)
    record(counts, prove_outcome(keys.proving, shorter, w) == "Inputs", "{k.name} circuit and key disagree")
}

fn rejections(counts: *Counts) {
    let bn = pairing.bn254()
    let bls = pairing.bls12_381()
    let tail = "\"pi_b\": [[\"0\", \"0\"], [\"1\", \"0\"], [\"0\", \"0\"]], \"pi_c\": [\"0\", \"1\", \"0\"], \"protocol\": \"groth16\", \"curve\": \"bn128\"}}"
    let bn_q = "21888242871839275222246405745257275088696311157297823662689037894645226208583"
    record(counts, proof_outcome(bn, "{{\"pi_a\": [\"0\", \"1\", \"0\"], {tail}") == "identity", "identity proof element")
    record(counts, proof_outcome(bn, "{{\"pi_a\": [\"1\", \"3\", \"1\"], {tail}") == "Point(NotOnCurve)", "pi_a off the curve")
    record(counts, proof_outcome(bn, "{{\"pi_a\": [\"{bn_q}\", \"2\", \"1\"], {tail}") == "Point(NotCanonical)", "pi_a not canonical")
    record(counts, proof_outcome(bn, "{{\"pi_a\": [\"1\", \"2\", \"2\"], {tail}") == "Malformed", "pi_a not normalised")
    record(counts, proof_outcome(bn, text.replace("{{\"pi_a\": [\"0\", \"1\", \"0\"], {tail}", "bn128", "bls12381")) == "Prime", "wrong curve name")
    record(counts, proof_outcome(bls, "{{\"pi_a\": [\"0\", \"1\", \"0\"], {tail}") == "Prime", "bn128 proof for BLS12-381")
    record(counts, proof_outcome(bn, text.replace("{{\"pi_a\": [\"0\", \"1\", \"0\"], {tail}", "groth16", "plonk")) == "Unsupported", "other protocol")
    record(counts, proof_outcome(bn, "{{\"pi_a\": [\"-1\", \"2\", \"1\"], {tail}") == "Malformed", "negative coordinate")
    record(counts, proof_outcome(bn, "{{\"pi_a\": [\"x\", \"2\", \"1\"], {tail}") == "Malformed", "non-numeric coordinate")
    record(counts, proof_outcome(bn, "{{\"pi_a\": [\"0\", \"1\"], {tail}") == "Malformed", "short coordinate list")
    record(counts, proof_outcome(bn, "{{\"pi_c\": [\"0\", \"1\", \"0\"]}}") == "Malformed", "missing members")
    record(counts, proof_outcome(bn, "not json") == "Malformed", "not json")
    record(counts, proof_outcome(bn, "") == "Malformed", "empty document")
    record(counts, key_outcome(bn, "[]") == "Malformed", "key that is an array")
    record(counts, public_outcome(bn, "[\"1\", \"2\"]") == "2", "two public inputs")
    record(counts, public_outcome(bn, "[\"21888242871839275222246405745257275088548364400416034343698204186575808495617\"]") == "Point(NotCanonical)", "public input equal to r")
    record(counts, public_outcome(bn, "[\"21888242871839275222246405745257275088548364400416034343698204186575808495616\"]") == "1", "public input r minus 1")
    record(counts, public_outcome(bn, "[1]") == "Malformed", "public input that is not a string")
    record(counts, public_outcome(bn, "[\"\"]") == "Malformed", "empty public input")
}

fn builder(counts: *Counts) {
    for name in ["bn128", "bls12381"] {
        let c = if name == "bn128" { pairing.bn254() } else { pairing.bls12_381() }
        let r = groth16.r1cs(c, 1)
        let x = groth16.allocate(r)
        let sq = groth16.product(r, groth16.wire(c, x), groth16.wire(c, x))
        let cube = groth16.product(r, groth16.wire(c, sq), groth16.wire(c, x))
        let parts = groth16.sum(groth16.sum(groth16.wire(c, cube), groth16.wire(c, x)), groth16.constant(c, 5))
        groth16.enforce(r, parts, groth16.constant(c, 1), groth16.wire(c, 1))
        let xv = pairing.fr_from_u64(c, 3)
        let sqv = pairing.fr_mul(c, xv, xv)
        let cubev = pairing.fr_mul(c, sqv, xv)
        let y = pairing.fr_add(c, pairing.fr_add(c, cubev, xv), pairing.fr_from_u64(c, 5))
        let w = [pairing.fr_one(c), y, xv, sqv, cubev]
        record(counts, r.wires == 5 && r.constraints.len == 3, "builder shape {name}")
        record(counts, groth16.satisfied(r, w), "builder witness satisfies {name}")
        record(counts, pairing.fr_equal(y, pairing.fr_from_u64(c, 35)), "builder cubic of 3 is 35 {name}")
        let keys = groth16.setup(r) or return
        let proof = groth16.prove(keys.proving, r, w) or return
        record(counts, groth16.verify(keys.verifying, [y], proof), "builder proof {name}")
        record(counts, !groth16.verify(keys.verifying, [pairing.fr_from_u64(c, 36)], proof), "builder proof of another statement {name}")
        let file = groth16.r1cs_to_bytes(r)
        let back = groth16.r1cs_from_bytes(c, file) or return
        record(counts, groth16.satisfied(back, w), "builder r1cs file round trip {name}")
    }
}

fn main() {
    let counts = new(Counts { pass: 0, bad: 0 })
    let bn = pairing.bn254()
    let bls = pairing.bls12_381()
    let circuits = [
        Circuit { name: "cubic bn128", curve: bn, r1cs: embed("std_zk_groth16_cubic_bn128.r1cs"), wtns: embed("std_zk_groth16_cubic_bn128.wtns"), vkey: embed("std_zk_groth16_cubic_bn128.vkey.json"), proof: embed("std_zk_groth16_cubic_bn128.proof.json"), public: embed("std_zk_groth16_cubic_bn128.public.json"), ours_vkey: embed("std_zk_groth16_cubic_bn128.ours_vkey.json"), ours_proof: embed("std_zk_groth16_cubic_bn128.ours_proof.json") }
        Circuit { name: "cubic bls12381", curve: bls, r1cs: embed("std_zk_groth16_cubic_bls12381.r1cs"), wtns: embed("std_zk_groth16_cubic_bls12381.wtns"), vkey: embed("std_zk_groth16_cubic_bls12381.vkey.json"), proof: embed("std_zk_groth16_cubic_bls12381.proof.json"), public: embed("std_zk_groth16_cubic_bls12381.public.json"), ours_vkey: embed("std_zk_groth16_cubic_bls12381.ours_vkey.json"), ours_proof: embed("std_zk_groth16_cubic_bls12381.ours_proof.json") }
        Circuit { name: "range bn128", curve: bn, r1cs: embed("std_zk_groth16_range_bn128.r1cs"), wtns: embed("std_zk_groth16_range_bn128.wtns"), vkey: embed("std_zk_groth16_range_bn128.vkey.json"), proof: embed("std_zk_groth16_range_bn128.proof.json"), public: embed("std_zk_groth16_range_bn128.public.json"), ours_vkey: embed("std_zk_groth16_range_bn128.ours_vkey.json"), ours_proof: embed("std_zk_groth16_range_bn128.ours_proof.json") }
        Circuit { name: "range bls12381", curve: bls, r1cs: embed("std_zk_groth16_range_bls12381.r1cs"), wtns: embed("std_zk_groth16_range_bls12381.wtns"), vkey: embed("std_zk_groth16_range_bls12381.vkey.json"), proof: embed("std_zk_groth16_range_bls12381.proof.json"), public: embed("std_zk_groth16_range_bls12381.public.json"), ours_vkey: embed("std_zk_groth16_range_bls12381.ours_vkey.json"), ours_proof: embed("std_zk_groth16_range_bls12381.ours_proof.json") }
    ]
    for k in circuits {
        snarkjs_artifacts(counts, k)
        circom_files(counts, k)
        own_setup(counts, k)
    }
    rejections(counts)
    builder(counts)
    print("pass {counts.pass} bad {counts.bad}")
}
