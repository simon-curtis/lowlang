import std/locale
import std/locale/decimal
import std/locale/reltime
import std/text

fn unit_of(name: str) -> reltime.Unit {
    match name {
        "second" => reltime.Unit.Second
        "minute" => reltime.Unit.Minute
        "hour" => reltime.Unit.Hour
        "day" => reltime.Unit.Day
        "week" => reltime.Unit.Week
        "month" => reltime.Unit.Month
        "quarter" => reltime.Unit.Quarter
        _ => reltime.Unit.Year
    }
}

fn width_of(name: str) -> reltime.Width {
    match name {
        "short" => reltime.Width.Short
        "narrow" => reltime.Width.Narrow
        _ => reltime.Width.Long
    }
}

fn main() {
    var checked = 0
    var failed = 0
    var current = ""
    var l = locale.root()
    for line in text.lines(embed("reltime.tsv")) {
        let f = text.split(line, '\t')
        if f.len != 6 {
            continue
        }
        if f[0] != current {
            current = f[0]
            l = locale.parse(current) or locale.root()
        }
        let numeric = if f[1] == "auto" { reltime.Numeric.Auto } else { reltime.Numeric.Always }
        let value = decimal.parse(f[4]) or decimal.zero()
        let got = reltime.format(l, value, unit_of(f[3]), numeric, width_of(f[2])) or "error"
        checked += 1
        if got != f[5] {
            failed += 1
            if failed <= 40 {
                print("{f[0]} {f[1]} {f[2]} {f[3]} {f[4]}: want {f[5]}, got {got}")
            }
        }
    }
    print("reltime: {checked} checked, {failed} wrong")
}
