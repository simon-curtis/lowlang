fn pick(flag: bool, a: f32, b: f32) -> f32 {
    f32(sqrt((if flag { a } else { b })))
}

fn main() {
    let w: f32 = 4.0
    let on = true
    let off = false
    print(i64(pick(on, w, 9.0) * 10.0))
    print(i64(pick(off, w, 9.0) * 10.0))
    print(i64(f32(floor((if on { w * 0.75 } else { w })) * 10.0)))
    print(sqrt(1 + 3) > 1.0)
    print(floor(-2) < 1.0)
    print(sqrt((if on { 4 } else { 9 })) > 1.0)
}
