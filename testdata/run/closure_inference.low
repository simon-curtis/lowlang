import std/slices
import std/text

fn apply(f: fn(i64) -> i64, x: i64) -> i64 {
    f(x)
}

fn pair_up[A, B](a: A, b: B, join: fn(A, B) -> str) -> str {
    join(a, b)
}

fn main() {
    let rows = text.lines("a\n  bb \n\nccc\n")
        |> slices.map(fn(line) text.trim(line))
        |> slices.filter(fn(row) row.len > 0)
    print(rows)
    print(rows |> slices.map(fn(row) row.len) |> slices.sum())
    print(slices.scan([3, 1, 4], 10, fn(total, x) total + x))
    print(slices.fold(rows, "", fn(joined, row) { "{joined}{row}" }))
    print(slices.map([1, 5, 2], fn(x) {
        if x > 2 {
            return "big"
        }
        "small"
    }))
    print(pair_up(7, "x", fn(n, s) "{n}{s}"))
    print(apply(fn(x) x * 3, 5))
    let twice = fn(x: i64) x * 2
    print(twice(21))
    let quiet = fn(x: i64) { twice(x) }
    quiet(1)
    let nested = slices.map([[1, 2], [3]], fn(xs) xs |> slices.map(fn(x) x * 10))
    print(nested)
}
