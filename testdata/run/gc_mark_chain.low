import std/file
import std/os
import std/process
import std/text
import std/time

struct Node {
    next: *Node?
    value: i64
}

struct Marks {
    collections: i64
    parallel: i64
    late_parallel: i64
}

fn os_threads() -> i64 {
    let status = file.read_text("/proc/self/status") or return 0
    for line in text.split(status, 10) {
        let c = text.cut(line, ":")
        if c.found && c.before == "Threads" {
            return text.parse_int(text.trim(c.after)) or 0
        }
    }
    0
}

fn spin(done: chan[bool]) {
    let started = time.monotonic()
    var acc = 1
    for time.monotonic() - started < 50000000 {
        acc = (acc * 33 + 7) % 1000003
    }
    done <- acc > 0
}

fn warm() {
    let done = chan[bool](1)
    for w in 0..24 {
        spawn spin(done)
    }
    for w in 0..24 {
        let _ = <-done
    }
}

fn build(warmed: bool) {
    if warmed {
        warm()
    }
    let before = os_threads()
    var head: *Node? = none
    for i in 0..1200000 {
        head = new(Node { next: head, value: i })
    }
    var sum = 0
    for i in 0..6000000 {
        let garbage = [i, i + 1, i + 2, i + 3]
        sum += garbage[i % 4]
    }
    var cur = head
    var length = 0
    for {
        match cur {
            some(n) => {
                length += 1
                cur = n.next
            }
            none => break
        }
    }
    print("chain {length} {sum > 0}")
    if !warmed {
        print("no threads started: {os_threads() == before}")
    }
}

fn marks(mode: str) -> Marks {
    let env = os.environment()
    env["LOW_GCTRACE"] = "1"
    let program = os.executable() or return Marks { collections: 0, parallel: 0, late_parallel: 0 }
    let out = process.run(process.Command { program, args: [mode], env: some(env) }, []) or return Marks { collections: 0, parallel: 0, late_parallel: 0 }
    for line in text.split(text.trim(str(out.stdout)), 10) {
        print("{mode}: {line}")
    }
    var m = Marks { collections: 0, parallel: 0, late_parallel: 0 }
    var workers: i64[] = []
    for line in text.split(str(out.stderr), 10) {
        let c = text.cut(line, "workers=")
        if c.found && text.starts_with(line, "gc ") {
            workers.push(text.parse_int(text.trim(c.after)) or 1)
        }
    }
    for i in 0..workers.len {
        if workers[i] > 1 {
            m.parallel += 1
            if i >= workers.len - 8 {
                m.late_parallel += 1
            }
        }
    }
    m.collections = workers.len
    m
}

fn main() {
    let args = os.args()
    if args.len > 1 {
        build(args[1] == "warm")
        return
    }
    let solo = marks("solo")
    print("solo collections: {solo.collections >= 8}")
    print("solo parallel marks: {solo.parallel == 0}")
    let warmed = marks("warm")
    print("warm collections: {warmed.collections >= 8}")
    print("warm parallel marks once the chain stops growing: {warmed.late_parallel == 0}")
}
