struct Item {
    id: i64
    payload: []i64
}

fn make(id: i64, size: i64) -> *Item {
    var payload: []i64 = []
    for k in 0..size {
        push(mut payload, id + k)
    }
    new(Item { id, payload })
}

fn produce(out: chan[*Item], first: i64, count: i64, done: chan[bool]) {
    for i in 0..count {
        out <- make(first + i, 16 + i % 48)
    }
    done <- true
}

fn consume(input: chan[*Item], sums: chan[i64]) {
    var sum = 0
    for item in input {
        var inner = 0
        for v in item.payload {
            inner += v
        }
        sum += inner - item.id * item.payload.len
    }
    sums <- sum
}

fn run(producers: i64, consumers: i64, capacity: i64, per: i64) {
    let items = chan[*Item](capacity)
    let done = chan[bool]()
    let sums = chan[i64]()
    for c in 0..consumers {
        spawn consume(items, sums)
    }
    for p in 0..producers {
        spawn produce(items, p * per, per, done)
    }
    for p in 0..producers {
        let finished = <-done
    }
    close(items)
    var total = 0
    for c in 0..consumers {
        total += (<-sums) ?? 0
    }
    var expected = 0
    for i in 0..per {
        let size = 16 + i % 48
        expected += size * (size - 1) / 2
    }
    print("{producers} {consumers} {capacity} {total == expected * producers}")
}

fn main() {
    run(4, 4, 8, 20000)
    run(8, 8, 0, 10000)
    run(16, 2, 64, 5000)
    run(2, 16, 1, 10000)
}
