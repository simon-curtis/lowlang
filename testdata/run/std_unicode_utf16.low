import std/text
import std/unicode
import std/unicode/utf16
import std/unicode/utf32

fn hex_units(units: []u16) -> str {
    var parts: []str = []
    for u in units {
        push(mut parts, text.hex(i64(u)))
    }
    text.join(parts, " ")
}

fn hex_words(words: []u32) -> str {
    var parts: []str = []
    for w in words {
        push(mut parts, text.hex(i64(w)))
    }
    text.join(parts, " ")
}

fn hex_bytes(data: []u8) -> str {
    var parts: []str = []
    for b in data {
        push(mut parts, text.hex(i64(b)))
    }
    text.join(parts, " ")
}

fn codes(s: str) -> str {
    var parts: []str = []
    for c in s {
        push(mut parts, text.hex(i64(c)))
    }
    text.join(parts, " ")
}

fn utf16_error(e: utf16.Error) -> str {
    match e {
        LoneSurrogate(at) => "lone surrogate at {at}"
        OddLength => "odd length"
    }
}

fn utf32_error(e: utf32.Error) -> str {
    match e {
        InvalidCodePoint(at) => "invalid code point at {at}"
        BadLength => "bad length"
    }
}

fn show_units(units: []u16) {
    print(utf16.decode(units) catch { e => utf16_error(e) })
}

fn show_bytes16(data: []u8, order: unicode.Order) {
    print(utf16.decode_bytes(data, order) catch { e => utf16_error(e) })
}

fn show_words(words: []u32) {
    print(utf32.decode(words) catch { e => utf32_error(e) })
}

fn show_bytes32(data: []u8, order: unicode.Order) {
    print(utf32.decode_bytes(data, order) catch { e => utf32_error(e) })
}

fn main() {
    let sample = "a😀é中"
    let units = utf16.encode(sample)
    print(hex_units(units))
    print(utf16.decode(units) or "failed")
    print(units.len)
    print(utf16.is_high_surrogate(0xD83D))
    print(utf16.is_low_surrogate(0xD83D))
    print(utf16.is_surrogate(0xDE00))

    var appended: []u16 = []
    utf16.encode_rune(mut appended, 0x10FFFF)
    utf16.encode_rune(mut appended, 0xD800)
    utf16.encode_rune(mut appended, 0x110000)
    utf16.encode_rune(mut appended, 0x10000)
    print(hex_units(appended))

    let pair: []u16 = [0xD83D, 0xDE00, 0x41]
    let first = utf16.decode_rune(pair, 0)
    print("{text.hex(i64(first.code))} {first.size}")
    let second = utf16.decode_rune(pair, 2)
    print("{text.hex(i64(second.code))} {second.size}")
    let lone = utf16.decode_rune([0xDE00, 0x41], 0)
    print("{text.hex(i64(lone.code))} {lone.size}")
    let past = utf16.decode_rune(pair, 3)
    print("{text.hex(i64(past.code))} {past.size}")

    show_units([0x61, 0xD83D])
    show_units([0xDE00, 0x61])
    show_units([0xD83D, 0x61])
    show_units([0x61, 0xD83D, 0xD83D, 0xDE00])
    print(codes(utf16.decode_lossy([0x61, 0xD83D, 0x62, 0xDE00, 0xD83D, 0xDE00])))

    print(hex_bytes(utf16.encode_bytes("a😀", unicode.Order.Little, false)))
    print(hex_bytes(utf16.encode_bytes("a😀", unicode.Order.Big, false)))
    print(hex_bytes(utf16.encode_bytes("a", unicode.Order.Little, true)))
    print(hex_bytes(utf16.encode_bytes("a", unicode.Order.Big, true)))
    print(hex_bytes(utf16.to_bytes([0x1234, 0xABCD], unicode.Order.Big)))
    let words16 = utf16.from_bytes([0x34, 0x12, 0xCD, 0xAB], unicode.Order.Little) or [0]
    print(hex_units(words16))
    print(hex_units(utf16.from_bytes([0x12, 0x34], unicode.Order.Big) or [0]))
    print(hex_units(utf16.from_bytes([0x12, 0x34, 0x56], unicode.Order.Big) or [0xFFFF]))
    print(hex_units(utf16.units([0x34, 0x12, 0x56], unicode.Order.Little)))
    print(utf16.join(0xD83D, 0xDE00))

    show_bytes16([0x61, 0x00, 0x3D, 0xD8, 0x00, 0xDE], unicode.Order.Little)
    show_bytes16([0x00, 0x61, 0xD8, 0x3D, 0xDE, 0x00], unicode.Order.Big)
    show_bytes16([0xFF, 0xFE, 0x61, 0x00], unicode.Order.Big)
    show_bytes16([0xFE, 0xFF, 0x00, 0x61], unicode.Order.Little)
    show_bytes16([0x61, 0x00, 0x62], unicode.Order.Little)
    show_bytes16([0x00, 0xD8], unicode.Order.Little)
    print(codes(utf16.decode_bytes_lossy([0x61, 0x00, 0x62], unicode.Order.Little)))
    print(codes(utf16.decode_bytes_lossy([0xFE, 0xFF, 0x00, 0x61, 0xD8, 0x00], unicode.Order.Little)))

    let words = utf32.encode(sample)
    print(hex_words(words))
    show_words(words)
    show_words([0x61, 0xD800])
    show_words([0x61, 0x110000, 0x62])
    print(codes(utf32.decode_lossy([0x61, 0xD800, 0x62, 0x110000])))
    print(hex_bytes(utf32.encode_bytes("a😀", unicode.Order.Little, false)))
    print(hex_bytes(utf32.encode_bytes("a😀", unicode.Order.Big, false)))
    print(hex_bytes(utf32.encode_bytes("a", unicode.Order.Little, true)))
    print(hex_bytes(utf32.encode_bytes("a", unicode.Order.Big, true)))
    print(hex_bytes(utf32.to_bytes([0x11223344], unicode.Order.Big)))
    print(hex_words(utf32.from_bytes([0x44, 0x33, 0x22, 0x11], unicode.Order.Little) or [0]))
    print(hex_words(utf32.from_bytes([1, 2, 3], unicode.Order.Little) or [0xFFFF]))
    show_bytes32([0x61, 0, 0, 0, 0x00, 0xF6, 0x01, 0x00], unicode.Order.Little)
    show_bytes32([0, 0, 0x00, 0x61], unicode.Order.Little)
    show_bytes32([0xFF, 0xFE, 0, 0, 0x61, 0, 0, 0], unicode.Order.Big)
    show_bytes32([0, 0, 0xFE, 0xFF, 0, 0, 0, 0x61], unicode.Order.Little)
    show_bytes32([0x61, 0, 0, 0, 0x00, 0xD8, 0, 0], unicode.Order.Little)
    show_bytes32([0x61, 0, 0, 0, 0x62], unicode.Order.Little)
    print(codes(utf32.decode_bytes_lossy([0x61, 0, 0, 0, 0x62], unicode.Order.Little)))
}
