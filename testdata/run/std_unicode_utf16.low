import std/text
import std/unicode
import std/unicode/utf16
import std/unicode/utf32

fn hex_units(units: []u16) -> str {
    var parts: []str = []
    for u in units {
        push(mut parts, text.hex(i64(u)))
    }
    text.join(parts, " ")
}

fn hex_words(words: []u32) -> str {
    var parts: []str = []
    for w in words {
        push(mut parts, text.hex(i64(w)))
    }
    text.join(parts, " ")
}

fn hex_bytes(data: []u8) -> str {
    var parts: []str = []
    for b in data {
        push(mut parts, text.hex(i64(b)))
    }
    text.join(parts, " ")
}

fn codes(s: str) -> str {
    var parts: []str = []
    for c in s {
        push(mut parts, text.hex(i64(c)))
    }
    text.join(parts, " ")
}

fn utf16_error(e: utf16.Error) -> str {
    match e {
        LoneSurrogate(at) => "lone surrogate at {at}"
        OddLength => "odd length"
    }
}

fn utf32_error(e: utf32.Error) -> str {
    match e {
        InvalidCodePoint(at) => "invalid code point at {at}"
        BadLength => "bad length"
    }
}

fn show_units(units: []u16) {
    print(utf16.decode(units) catch { e => utf16_error(e) })
}

fn show_bytes16(data: []u8, order: utf16.Order) {
    print(utf16.decode_bytes(data, order) catch { e => utf16_error(e) })
}

fn show_words(words: []u32) {
    print(utf32.decode(words) catch { e => utf32_error(e) })
}

fn show_bytes32(data: []u8, order: utf32.Order) {
    print(utf32.decode_bytes(data, order) catch { e => utf32_error(e) })
}

fn bytes_of(parts: []u8) -> str {
    str(parts)
}

fn next(state: u64) -> u64 {
    state * 6364136223846793005 + 1442695040888963407
}

fn fuzz_byte(state: u64) -> u8 {
    let alphabet: []u8 = [0x00, 0x41, 0x7F, 0x80, 0xBF, 0xC0, 0xC1, 0xC2, 0xDF, 0xE0, 0xE1, 0xED, 0xEF, 0xF0, 0xF4, 0xF5, 0xFF, 0x9F, 0xA0, 0x8F, 0x90, 0xBD]
    alphabet[i64(state >> 33) % alphabet.len]
}

fn rebuilt(s: str) -> str {
    var out: []u8 = []
    for c in s {
        text.append_char(mut out, c)
    }
    str(out)
}

fn main() {
    let sample = "a😀é中"
    let units = utf16.encode(sample)
    print(hex_units(units))
    print(utf16.decode(units) catch "failed")
    print(units.len)
    print(utf16.unit_count(0x1F600))
    print(utf16.unit_count(0x41))
    print(utf16.is_high_surrogate(0xD83D))
    print(utf16.is_low_surrogate(0xD83D))
    print(utf16.is_surrogate(0xDE00))

    var appended: []u16 = []
    utf16.encode_rune(mut appended, 0x10FFFF)
    utf16.encode_rune(mut appended, 0xD800)
    utf16.encode_rune(mut appended, 0x110000)
    utf16.encode_rune(mut appended, 0x10000)
    print(hex_units(appended))

    let pair: []u16 = [0xD83D, 0xDE00, 0x41]
    let first = utf16.decode_rune(pair, 0)
    print("{text.hex(i64(first.code))} {first.size}")
    let second = utf16.decode_rune(pair, 2)
    print("{text.hex(i64(second.code))} {second.size}")
    let lone = utf16.decode_rune([0xDE00, 0x41], 0)
    print("{text.hex(i64(lone.code))} {lone.size}")
    let past = utf16.decode_rune(pair, 3)
    print("{text.hex(i64(past.code))} {past.size}")

    show_units([0x61, 0xD83D])
    show_units([0xDE00, 0x61])
    show_units([0xD83D, 0x61])
    show_units([0x61, 0xD83D, 0xD83D, 0xDE00])
    print(codes(utf16.decode_lossy([0x61, 0xD83D, 0x62, 0xDE00, 0xD83D, 0xDE00])))

    print(hex_bytes(utf16.encode_bytes("a😀", utf16.Order.Little, false)))
    print(hex_bytes(utf16.encode_bytes("a😀", utf16.Order.Big, false)))
    print(hex_bytes(utf16.encode_bytes("a", utf16.Order.Little, true)))
    print(hex_bytes(utf16.encode_bytes("a", utf16.Order.Big, true)))
    print(hex_bytes(utf16.to_bytes([0x1234, 0xABCD], utf16.Order.Big)))
    let words16 = utf16.from_bytes([0x34, 0x12, 0xCD, 0xAB], utf16.Order.Little) catch { e => [0] }
    print(hex_units(words16))
    print(hex_units(utf16.from_bytes([0x12, 0x34], utf16.Order.Big) catch { e => [0] }))
    print(hex_units(utf16.from_bytes([0x12, 0x34, 0x56], utf16.Order.Big) catch { e => [0xFFFF] }))

    show_bytes16([0x61, 0x00, 0x3D, 0xD8, 0x00, 0xDE], utf16.Order.Little)
    show_bytes16([0x00, 0x61, 0xD8, 0x3D, 0xDE, 0x00], utf16.Order.Big)
    show_bytes16([0xFF, 0xFE, 0x61, 0x00], utf16.Order.Big)
    show_bytes16([0xFE, 0xFF, 0x00, 0x61], utf16.Order.Little)
    show_bytes16([0x61, 0x00, 0x62], utf16.Order.Little)
    show_bytes16([0x00, 0xD8], utf16.Order.Little)
    print(codes(utf16.decode_bytes_lossy([0x61, 0x00, 0x62], utf16.Order.Little)))
    print(codes(utf16.decode_bytes_lossy([0xFE, 0xFF, 0x00, 0x61, 0xD8, 0x00], utf16.Order.Little)))

    let words = utf32.encode(sample)
    print(hex_words(words))
    show_words(words)
    show_words([0x61, 0xD800])
    show_words([0x61, 0x110000, 0x62])
    print(codes(utf32.decode_lossy([0x61, 0xD800, 0x62, 0x110000])))
    print(hex_bytes(utf32.encode_bytes("a😀", utf32.Order.Little, false)))
    print(hex_bytes(utf32.encode_bytes("a😀", utf32.Order.Big, false)))
    print(hex_bytes(utf32.encode_bytes("a", utf32.Order.Little, true)))
    print(hex_bytes(utf32.encode_bytes("a", utf32.Order.Big, true)))
    print(hex_bytes(utf32.to_bytes([0x11223344], utf32.Order.Big)))
    print(hex_words(utf32.from_bytes([0x44, 0x33, 0x22, 0x11], utf32.Order.Little) catch { e => [0] }))
    print(hex_words(utf32.from_bytes([1, 2, 3], utf32.Order.Little) catch { e => [0xFFFF] }))
    show_bytes32([0x61, 0, 0, 0, 0x00, 0xF6, 0x01, 0x00], utf32.Order.Little)
    show_bytes32([0, 0, 0x00, 0x61], utf32.Order.Little)
    show_bytes32([0xFF, 0xFE, 0, 0, 0x61, 0, 0, 0], utf32.Order.Big)
    show_bytes32([0, 0, 0xFE, 0xFF, 0, 0, 0, 0x61], utf32.Order.Little)
    show_bytes32([0x61, 0, 0, 0, 0x00, 0xD8, 0, 0], utf32.Order.Little)
    show_bytes32([0x61, 0, 0, 0, 0x62], utf32.Order.Little)
    print(codes(utf32.decode_bytes_lossy([0x61, 0, 0, 0, 0x62], utf32.Order.Little)))

    print(unicode.utf8_valid(""))
    print(unicode.utf8_valid("héllo 😀"))
    print(unicode.utf8_valid(bytes_of([0xC0, 0x80])))
    print(unicode.utf8_valid(bytes_of([0xED, 0xA0, 0x80])))
    print(unicode.utf8_valid(bytes_of([0xF4, 0x90, 0x80, 0x80])))
    print(unicode.utf8_valid(bytes_of([0xE2, 0x82])))
    print(unicode.utf8_valid(bytes_of([0xEF, 0xBF, 0xBD])))
    print(unicode.utf8_invalid_at(bytes_of([0x61, 0x62, 0xFF, 0x63])))
    print(unicode.utf8_invalid_at("ok"))
    print(codes(unicode.utf8_to_valid(bytes_of([0x61, 0xC0, 0x80, 0xE2, 0x82, 0x41, 0xFF]))))
    print(codes(unicode.utf8_to_valid(bytes_of([0xED, 0xA0, 0x80, 0xF0, 0x9F, 0x98, 0x80]))))
    print(unicode.utf8_to_valid("fine") == "fine")

    print(unicode.rune_len(0x41))
    print(unicode.rune_len(0xE9))
    print(unicode.rune_len(0x20AC))
    print(unicode.rune_len(0x1F600))
    print(unicode.rune_len(0xD800))
    print(unicode.rune_len(0x110000))
    print(codes(unicode.encode_rune(0x20AC)))
    print(codes(unicode.encode_rune(0xD800)))
    print(codes(unicode.encode_rune(0x10FFFF)))

    let text_bytes = bytes_of([0x61, 0xC3, 0xA9, 0xE2, 0x82, 0xAC, 0xF0, 0x9F, 0x98, 0x80, 0xFF, 0xC3])
    var at = 0
    for at <= text_bytes.len {
        let r = unicode.decode_rune(text_bytes, at)
        print("{at}: {text.hex(i64(r.code))} {r.size}")
        if r.size == 0 {
            break
        }
        at += r.size
    }
    print(unicode.decode_rune(text_bytes, -1).size)

    var state: u64 = 12345
    var valid = 0
    var mismatches = 0
    for round in 0..3000 {
        var raw: []u8 = []
        for k in 0..(round % 9) {
            state = next(state)
            push(mut raw, fuzz_byte(state))
        }
        let input = str(raw)
        let ok = unicode.utf8_valid(input)
        let fixed = unicode.utf8_to_valid(input)
        if ok {
            valid += 1
        }
        if fixed != rebuilt(input) || !unicode.utf8_valid(fixed) || (ok && fixed != input) {
            mismatches += 1
        }
    }
    print("fuzz valid {valid} mismatches {mismatches}")
}
