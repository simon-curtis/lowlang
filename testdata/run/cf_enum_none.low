struct Chain {
    value: i64
    next: *Chain?
}

struct Cell {
    left: *Cell?
    right: *Cell?
}

enum Slot {
    Empty
    Pair(i64, *Chain?)
    Triple(i64, i64, *Chain?)
}

struct Holder {
    slot: Slot
    tag: i64
}

fn chain(n: i64) -> *Chain? {
    var head: *Chain? = none
    for i in 0..n {
        head = new(Chain { value: i, next: head })
    }
    head
}

fn total(list: *Chain?) -> i64 {
    var sum = 0
    var at = list
    for {
        match at {
            some(node) => {
                sum += node.value
                at = node.next
            }
            none => return sum
        }
    }
}

fn tree(depth: i64) -> *Cell {
    if depth == 0 {
        new(Cell { left: none, right: none })
    } else {
        new(Cell { left: tree(depth - 1), right: tree(depth - 1) })
    }
}

fn count(cell: *Cell) -> i64 {
    let l = match cell.left {
        some(c) => count(c)
        none => 0
    }
    let r = match cell.right {
        some(c) => count(c)
        none => 0
    }
    1 + l + r
}

fn slot(kind: i64, value: i64, rest: *Chain?) -> Slot {
    let k = kind % 3
    if k == 0 {
        Slot.Empty
    } else if k == 1 {
        Slot.Pair(value, rest)
    } else {
        Slot.Triple(value, value * 2, rest)
    }
}

fn weigh(s: Slot) -> i64 {
    match s {
        Empty => 1
        Pair(a, rest) => a + total(rest)
        Triple(a, b, rest) => a + b + total(rest)
    }
}

fn round(n: i64, seed: i64) -> i64 {
    let big = chain(n)
    let before = total(big)
    let small = tree(6)
    let holders = chain(3)
    var weight = 0
    for k in 0..30 {
        let h = Holder { slot: slot(k + seed, k, holders), tag: k }
        weight += weigh(h.slot) + h.tag
    }
    before + count(small) + weight
}

fn main() {
    var sum = 0
    for r in 0..40 {
        sum += round(80000, r)
    }
    print(sum)
    var cells = 0
    for r in 0..2000 {
        cells += count(tree(5))
    }
    print(cells)
}
