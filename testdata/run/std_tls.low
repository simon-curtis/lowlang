import std/crypto/x509
import std/io
import std/net
import std/tls

fn roots() -> []x509.Certificate {
    var out: []x509.Certificate = []
    for der in x509.pem_certificates(embed("std_tls_ca.pem")) {
        push(mut out, x509.parse(der) catch {
            _ => return out
        })
    }
    out
}

fn server_config(pem: str, groups: []i64) -> tls.Config ! io.Error {
    tls.Config { certificates: x509.pem_certificates(pem), key: x509.pem_private_key(pem)?, alpn: ["h2", "http/1.1"], groups }
}

fn serve(l: net.ListenerHandle, config: tls.Config, done: chan[str]) {
    let h = net.accept_handle(l) catch {
        _ => {
            done <- "accept failed"
            return
        }
    }
    using c = net.adopt(h)
    using t = tls.server(net.stream(c), config) catch {
        _ => {
            done <- "server handshake failed"
            return
        }
    }
    let s = tls.stream(t)
    let r = io.reader(s)
    let header = io.read_line(r) catch "?"
    let size = io.read_line(r) catch "0"
    var total = 0
    let n = if size == "100000" { 100000 } else { 0 }
    let body = io.read_exact(r, n) catch []
    for b in body {
        total += i64(b)
    }
    io.write_str(s, "{header} {body.len} {total}\n") catch {
        _ => {}
    }
    tls.close(t)
    done <- "server ok group={t.handle.group} alpn={t.handle.protocol}"
}

fn exchange(server_pem: str, server_groups: []i64, client: tls.Config) -> str ! io.Error {
    using l = net.listen("127.0.0.1", 0)?
    let done = chan[str](1)
    spawn serve(l.handle, server_config(server_pem, server_groups)?, done)
    using conn = net.connect(l.handle.addr)?
    using t = tls.client(net.stream(conn), client) catch {
        Invalid => {
            net.close(conn)
            net.close_listener(l)
            let server = (<-done) ?? ""
            return "client rejected the server ({server})"
        }
        _ => {
            net.close(conn)
            net.close_listener(l)
            return "client failed"
        }
    }
    let s = tls.stream(t)
    var payload: []u8 = []
    for i in 0..100000 {
        push(mut payload, u8(i % 251))
    }
    io.write_str(s, "suite test\n100000\n")?
    tls.update_keys(t, true)?
    io.write_all(s, payload)?
    let reply = io.read_line(io.reader(s))?
    tls.close(t)
    net.close_listener(l)
    let server = (<-done) ?? ""
    "client group={t.handle.group} alpn={t.handle.protocol} reply=[{reply}] {server}"
}

fn main() ! io.Error {
    let ec = embed("std_tls_ec.pem")
    let rsa = embed("std_tls_rsa.pem")
    let ed = embed("std_tls_ed25519.pem")
    let defaults = [0x11EC, 0x001D, 0x0017, 0x0018]
    let trusted = roots()
    print(exchange(ec, defaults, tls.Config { server_name: "localhost", roots: trusted, alpn: ["h2"] })?)
    print(exchange(rsa, defaults, tls.Config { server_name: "localhost", roots: trusted, groups: [0x001D] })?)
    print(exchange(ed, defaults, tls.Config { server_name: "127.0.0.1", roots: trusted, groups: [0x0017, 0x0018] })?)
    print(exchange(ec, [0x0018], tls.Config { server_name: "localhost", roots: trusted })?)
    print(exchange(ec, defaults, tls.Config { server_name: "localhost", roots: trusted, groups: [0x001D, 0x11EC] })?)
    print(exchange(ec, defaults, tls.Config { server_name: "example.com", roots: trusted })?)
    print(exchange(ec, defaults, tls.Config { server_name: "localhost", roots: [] , groups: [0x001D] })?)
}
