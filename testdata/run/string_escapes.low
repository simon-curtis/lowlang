fn main() {
    print("hex \x41\x42")
    print("snow ☃ \U0001F600")
    let s = "\xff\x00é"
    print(s.len)
    print(s[0])
    print(s[1])
    print(s[2])
    print(s[3])
    print('\x41')
    print('é')
    print('\U0001F600')
    print('\xe9')
    print("a{1}\x42")
    print("{"\x41"}")
    print("\x1b[0m".len)
    print("﻿".len)
    print("  ".len)
    print("\x7B\x7d")
}
