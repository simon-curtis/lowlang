import std/file
import std/io
import std/os
import std/sys
import std/text

struct Entry {
    resource: os.Resource
    label: str
}

fn entries() -> []Entry {
    [
        Entry { resource: os.Resource.Cpu, label: "Max cpu time" }
        Entry { resource: os.Resource.FileSize, label: "Max file size" }
        Entry { resource: os.Resource.Data, label: "Max data size" }
        Entry { resource: os.Resource.Stack, label: "Max stack size" }
        Entry { resource: os.Resource.Core, label: "Max core file size" }
        Entry { resource: os.Resource.ResidentSet, label: "Max resident set" }
        Entry { resource: os.Resource.Processes, label: "Max processes" }
        Entry { resource: os.Resource.OpenFiles, label: "Max open files" }
        Entry { resource: os.Resource.LockedMemory, label: "Max locked memory" }
        Entry { resource: os.Resource.AddressSpace, label: "Max address space" }
        Entry { resource: os.Resource.FileLocks, label: "Max file locks" }
        Entry { resource: os.Resource.PendingSignals, label: "Max pending signals" }
        Entry { resource: os.Resource.MessageQueue, label: "Max msgqueue size" }
        Entry { resource: os.Resource.Nice, label: "Max nice priority" }
        Entry { resource: os.Resource.RealtimePriority, label: "Max realtime priority" }
        Entry { resource: os.Resource.RealtimeTime, label: "Max realtime timeout" }
    ]
}

fn value_of(word: str) -> i64? {
    if word == "unlimited" {
        return none
    }
    text.parse_int(word) or none
}

fn from_proc(label: str) -> os.Rlimit? {
    let content = file.read_text("/proc/self/limits") or return none
    for line in text.lines(content) {
        if line.len > 26 && text.trim(line[..26]) == label {
            let fields = text.fields(line[26..])
            return os.Rlimit { soft: value_of(fields[0]), hard: value_of(fields[1]) }
        }
    }
    none
}

fn same(a: os.Rlimit, b: os.Rlimit) -> bool {
    a.soft == b.soft && a.hard == b.hard
}

fn lowered(current: i64?, ceiling: i64) -> i64 {
    let value = current ?? ceiling
    if value < ceiling { value } else { ceiling }
}

fn read_all() {
    var agree = 0
    var total = 0
    for entry in entries() {
        total += 1
        let live = os.getrlimit(entry.resource) or continue
        let proc = from_proc(entry.label) ?? continue
        if same(live, proc) {
            agree += 1
        } else {
            print("{entry.label} differs: {live} {proc}")
        }
    }
    print("resources {total} agree {agree}")
}

fn lower_core() ! io.Error {
    let before = os.getrlimit(os.Resource.Core)?
    let soft = lowered(before.soft, 0)
    os.setrlimit(os.Resource.Core, os.Rlimit { soft: some(soft), hard: before.hard })?
    let after = os.getrlimit(os.Resource.Core)?
    print("core soft {after.soft == some(soft)} hard {after.hard == before.hard}")
    let proc = from_proc("Max core file size") ?? after
    print("core proc {same(after, proc)}")
}

fn lower_both() ! io.Error {
    let before = os.getrlimit(os.Resource.Cpu)?
    let soft = lowered(before.soft, 100000)
    let hard = lowered(before.hard, 100000)
    os.setrlimit(os.Resource.Cpu, os.Rlimit { soft: some(soft), hard: some(hard) })?
    let after = os.getrlimit(os.Resource.Cpu)?
    print("cpu {after.soft == some(soft)} {after.hard == some(hard)}")
    let lower_hard = hard - 1
    let lower_soft = if soft < lower_hard { soft } else { lower_hard }
    os.setrlimit(os.Resource.Cpu, os.Rlimit { soft: some(lower_soft), hard: some(lower_hard) })?
    let last = os.getrlimit(os.Resource.Cpu)?
    print("cpu lowered {last.soft == some(lower_soft)} {last.hard == some(lower_hard)}")
}

fn rejected() ! io.Error {
    let before = os.getrlimit(os.Resource.Core)?
    os.setrlimit(os.Resource.Core, os.Rlimit { soft: some(10), hard: some(5) }) catch {
        Invalid => print("soft above hard Invalid")
        e => print("soft above hard {e}")
    }
    let after = os.getrlimit(os.Resource.Core)?
    print("unchanged {same(before, after)}")
    os.setrlimit(os.Resource.Core, os.Rlimit { soft: none, hard: some(5) }) catch {
        Invalid => print("unlimited soft Invalid")
        e => print("unlimited soft {e}")
    }
    print("unchanged {same(before, os.getrlimit(os.Resource.Core)?)}")
}

fn enforced() ! io.Error {
    let before = os.getrlimit(os.Resource.OpenFiles)?
    let target = 24
    let soft = lowered(before.soft, target)
    os.setrlimit(os.Resource.OpenFiles, os.Rlimit { soft: some(soft), hard: before.hard })?
    var held: []sys.FdHandle = []
    var failure = "none"
    for _ in 0..64 {
        let opened = sys.open("/proc/self/status", sys.Open.Read, 0) catch {
            e => {
                failure = "{e}"
                break
            }
        }
        push(mut held, opened)
    }
    let count = held.len
    for h in held {
        sys.close_on(h)
    }
    print("open stopped {failure} {count < 24} {count > 10}")
    let again = sys.open("/proc/self/status", sys.Open.Read, 0)?
    sys.close_on(again)
    print("open after close ok")
}

fn main() ! io.Error {
    read_all()
    lower_core()?
    lower_both()?
    rejected()?
    enforced()?
}
