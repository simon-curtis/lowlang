import std/locale
import std/locale/collate
import std/text

fn options_of(label: str) -> collate.Options {
    var o = collate.options()
    if label.len == 0 {
        return o
    }
    for part in text.split(label, ',') {
        match part {
            "numeric=true" => { o.numeric = true }
            "caseFirst=upper" => { o.case_first = collate.CaseFirst.Upper }
            "caseFirst=lower" => { o.case_first = collate.CaseFirst.Lower }
            "ignorePunctuation=true" => { o.alternate = collate.Alternate.Shifted }
            "sensitivity=base" => { o.strength = collate.Strength.Primary }
            "sensitivity=accent" => { o.strength = collate.Strength.Secondary }
            _ => {}
        }
    }
    o
}

fn compare_keys(a: []u8, b: []u8) -> i64 {
    let n = if a.len < b.len { a.len } else { b.len }
    for i in 0..n {
        if a[i] != b[i] {
            return if a[i] < b[i] { -1 } else { 1 }
        }
    }
    if a.len == b.len {
        return 0
    }
    if a.len < b.len { -1 } else { 1 }
}

fn main() {
    var seen: [str: collate.Collator] = [:]
    var rows = 0
    var wrong = 0
    var key_wrong = 0
    var equal_wrong = 0
    var shown = 0
    for line in text.lines(embed("collate.tsv")) {
        let f = text.split(line, '\t')
        if f.len != 5 {
            continue
        }
        let id = "{f[0]} {f[1]}"
        var c = collate.root(collate.options())
        match seen[id] {
            some(found) => { c = found }
            none => {
                let l = locale.parse(f[0]) or locale.root()
                c = collate.for_locale(l, options_of(f[1]))
                seen[id] = c
            }
        }
        let want = text.parse_int(f[4]) or 0
        let got = collate.compare(c, f[2], f[3])
        rows += 1
        if got != want {
            wrong += 1
            if shown < 20 {
                print("{id}: [{f[2]}] vs [{f[3]}] want {want} got {got}")
                shown += 1
            }
        }
        if compare_keys(collate.sort_key(c, f[2]), collate.sort_key(c, f[3])) != got {
            key_wrong += 1
        }
        if collate.equal(c, f[2], f[3]) != (got == 0) {
            equal_wrong += 1
        }
    }
    print("collate: {rows} rows, {wrong} wrong, {key_wrong} keys wrong, {equal_wrong} equal wrong")
}
