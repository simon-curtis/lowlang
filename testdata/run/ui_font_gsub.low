import std/io
import std/ui/font

struct Table {
    tag: str
    data: []u8
}

struct Script {
    tag: str
    features: []i64
}

struct Feature {
    tag: str
    lookups: []i64
}

fn pad(mut b: []u8, n: i64) {
    for _ in 0..n {
        b.push(0)
    }
}

fn zeros(n: i64) -> []u8 {
    var b: []u8 = []
    pad(mut b, n)
    b
}

fn append(mut b: []u8, more: []u8) {
    for x in more {
        b.push(x)
    }
}

fn words(mut b: []u8, w: []i64) {
    for v in w {
        io.put_be16(mut b, v)
    }
}

fn tag(mut b: []u8, t: str) {
    for i in 0..4 {
        b.push(t[i])
    }
}

fn assemble(tables: []Table) -> []u8 {
    var out: []u8 = []
    io.put_be32(mut out, 65536)
    io.put_be16(mut out, tables.len)
    pad(mut out, 6)
    var offset = 12 + 16 * tables.len
    for t in tables {
        tag(mut out, t.tag)
        io.put_be32(mut out, 0)
        io.put_be32(mut out, offset)
        io.put_be32(mut out, t.data.len)
        offset += (t.data.len + 3) / 4 * 4
    }
    for t in tables {
        append(mut out, t.data)
        pad(mut out, (4 - t.data.len % 4) % 4)
    }
    out
}

fn head() -> []u8 {
    var b = zeros(54)
    io.set_be16(b, 18, 16)
    b
}

fn hhea() -> []u8 {
    var b = zeros(36)
    io.set_be16(b, 4, 14)
    io.set_be16(b, 6, -4)
    io.set_be16(b, 34, 1)
    b
}

fn maxp(glyphs: i64) -> []u8 {
    var b = zeros(6)
    io.set_be16(b, 4, glyphs)
    b
}

fn hmtx() -> []u8 {
    var b: []u8 = []
    words(mut b, [8, 0])
    b
}

fn cmap12() -> []u8 {
    var b: []u8 = []
    words(mut b, [0, 1, 3, 10])
    io.put_be32(mut b, 12)
    words(mut b, [12, 0])
    io.put_be32(mut b, 28)
    io.put_be32(mut b, 0)
    io.put_be32(mut b, 1)
    for v in [65, 66, 1] {
        io.put_be32(mut b, v)
    }
    b
}

fn coverage1(glyphs: []i64) -> []u8 {
    var b: []u8 = []
    words(mut b, [1, glyphs.len])
    words(mut b, glyphs)
    b
}

fn coverage2(ranges: []i64) -> []u8 {
    var b: []u8 = []
    words(mut b, [2, ranges.len / 3])
    words(mut b, ranges)
    b
}

fn ligature_sub(coverage: []u8, sets: [][][]i64) -> []u8 {
    let header = 6 + 2 * sets.len
    var b: []u8 = []
    words(mut b, [1, header, sets.len])
    var at = header + coverage.len
    var bodies: [][]u8 = []
    for set in sets {
        var body: []u8 = []
        io.put_be16(mut body, set.len)
        var inner = 2 + 2 * set.len
        for lig in set {
            io.put_be16(mut body, inner)
            inner += 2 * (lig.len + 1)
        }
        for lig in set {
            io.put_be16(mut body, lig[0])
            io.put_be16(mut body, lig.len)
            words(mut body, lig[1..])
        }
        bodies.push(body)
        io.put_be16(mut b, at)
        at += body.len
    }
    append(mut b, coverage)
    for body in bodies {
        append(mut b, body)
    }
    b
}

fn single1(coverage: []u8, delta: i64) -> []u8 {
    var b: []u8 = []
    words(mut b, [1, 6, delta])
    append(mut b, coverage)
    b
}

fn single2(coverage: []u8, glyphs: []i64) -> []u8 {
    var b: []u8 = []
    words(mut b, [2, 6 + 2 * glyphs.len, glyphs.len])
    words(mut b, glyphs)
    append(mut b, coverage)
    b
}

fn lookup(kind: i64, subtables: [][]u8) -> []u8 {
    var b: []u8 = []
    words(mut b, [kind, 0, subtables.len])
    var at = 6 + 2 * subtables.len
    for s in subtables {
        io.put_be16(mut b, at)
        at += s.len
    }
    for s in subtables {
        append(mut b, s)
    }
    b
}

fn extension(kind: i64, inner: []u8) -> []u8 {
    var b: []u8 = []
    words(mut b, [1, kind])
    io.put_be32(mut b, 8)
    append(mut b, inner)
    b
}

fn list(tags: []str, items: [][]u8) -> []u8 {
    let record = if tags.len > 0 { 6 } else { 2 }
    var b: []u8 = []
    io.put_be16(mut b, items.len)
    var at = 2 + record * items.len
    for i in 0..items.len {
        if tags.len > 0 {
            tag(mut b, tags[i])
        }
        io.put_be16(mut b, at)
        at += items[i].len
    }
    for item in items {
        append(mut b, item)
    }
    b
}

fn script_table(s: Script) -> []u8 {
    var b: []u8 = []
    words(mut b, [4, 0, 0, 65535, s.features.len])
    words(mut b, s.features)
    b
}

fn feature_table(f: Feature) -> []u8 {
    var b: []u8 = []
    words(mut b, [0, f.lookups.len])
    words(mut b, f.lookups)
    b
}

fn layout(scripts: []Script, features: []Feature, lookups: [][]u8) -> []u8 {
    var script_tags: []str = []
    var script_tables: [][]u8 = []
    for s in scripts {
        script_tags.push(s.tag)
        script_tables.push(script_table(s))
    }
    var feature_tags: []str = []
    var feature_tables: [][]u8 = []
    for f in features {
        feature_tags.push(f.tag)
        feature_tables.push(feature_table(f))
    }
    let script_list = list(script_tags, script_tables)
    let feature_list = list(feature_tags, feature_tables)
    var b: []u8 = []
    io.put_be32(mut b, 65536)
    words(mut b, [10, 10 + script_list.len, 10 + script_list.len + feature_list.len])
    append(mut b, script_list)
    append(mut b, feature_list)
    append(mut b, list([], lookups))
    b
}

fn feature_gsub(feature_tag: str, lookups: [][]u8) -> []u8 {
    var indices: []i64 = []
    for i in 0..lookups.len {
        indices.push(i)
    }
    layout([Script { tag: "DFLT", features: [0] }], [Feature { tag: feature_tag, lookups: indices }], lookups)
}

fn open(gsub_data: []u8) -> font.Font {
    var tables = [
        Table { tag: "head", data: head() }
        Table { tag: "hhea", data: hhea() }
        Table { tag: "maxp", data: maxp(40) }
        Table { tag: "cmap", data: cmap12() }
        Table { tag: "hmtx", data: hmtx() }
        Table { tag: "loca", data: zeros(82) }
        Table { tag: "glyf", data: zeros(0) }
    ]
    if gsub_data.len > 0 {
        tables.push(Table { tag: "GSUB", data: gsub_data })
    }
    font.parse(str(assemble(tables))) or font.Font {}
}

fn render(f: font.Font, glyphs: []i64) -> str {
    var line = ""
    for s in f.substitute(glyphs) {
        line = "{line} {s.glyph}[{s.first}-{s.end}]"
    }
    if line == "" {
        "empty"
    } else {
        line[1..]
    }
}

fn runs(label: str, f: font.Font, inputs: [][]i64) {
    for input in inputs {
        print("{label} {input}: {render(f, input)}")
    }
}

fn fi_lookup() -> []u8 {
    lookup(4, [ligature_sub(coverage1([10]), [[[20, 11]]])])
}

fn ligatures() -> font.Font {
    let set = [[21, 10, 11], [20, 11], [22, 12]]
    open(feature_gsub("liga", [lookup(4, [ligature_sub(coverage1([10]), [set])])]))
}

fn ranges() -> font.Font {
    let first = ligature_sub(coverage1([14]), [[[24, 15]]])
    let second = ligature_sub(coverage2([10, 12, 0]), [[[20, 11]], [[23, 11]], []])
    open(feature_gsub("liga", [lookup(4, [first, second])]))
}

fn wrapped() -> font.Font {
    open(feature_gsub("liga", [lookup(7, [extension(4, ligature_sub(coverage1([10]), [[[20, 11]]]))])]))
}

fn staged() -> font.Font {
    let ligature = lookup(4, [ligature_sub(coverage1([10]), [[[20, 11]]])])
    let singles = lookup(1, [single2(coverage1([2]), [10]), single1(coverage1([1]), 10)])
    let features = [Feature { tag: "ccmp", lookups: [1] }, Feature { tag: "liga", lookups: [0] }]
    open(layout([Script { tag: "DFLT", features: [0, 1] }], features, [ligature, singles]))
}

fn merged() -> font.Font {
    let lookups = [
        lookup(4, [ligature_sub(coverage1([10]), [[[20, 11]]])])
        lookup(4, [ligature_sub(coverage1([10]), [[[22, 12]]])])
        lookup(4, [ligature_sub(coverage1([12]), [[[25, 12]]])])
        lookup(4, [ligature_sub(coverage1([11]), [[[26, 11]]])])
    ]
    let features = [
        Feature { tag: "rlig", lookups: [0] }
        Feature { tag: "clig", lookups: [1] }
        Feature { tag: "dlig", lookups: [2] }
        Feature { tag: "liga", lookups: [3] }
    ]
    open(layout([Script { tag: "DFLT", features: [0, 1, 2, 3] }], features, lookups))
}

fn ordered() -> font.Font {
    let lookups = [
        lookup(4, [ligature_sub(coverage1([10]), [[[20, 11]]])])
        lookup(4, [ligature_sub(coverage1([20]), [[[27, 12]]])])
    ]
    open(feature_gsub("liga", lookups))
}

fn unsupported() -> font.Font {
    let lookups = [lookup(2, [single1(coverage1([10]), 1)]), lookup(1, [single1(coverage1([14]), 3)])]
    open(feature_gsub("liga", lookups))
}

fn script_font(scripts: []str) -> font.Font {
    var lookups: [][]u8 = []
    var features: []Feature = []
    var tables: []Script = []
    for i in 0..scripts.len {
        lookups.push(lookup(4, [ligature_sub(coverage1([10]), [[[20 + i, 11]]])]))
        features.push(Feature { tag: "liga", lookups: [i] })
        tables.push(Script { tag: scripts[i], features: [i] })
    }
    open(layout(tables, features, lookups))
}

fn broken(what: str) -> str {
    var sub = ligature_sub(coverage1([10]), [[[20, 11]]])
    if what == "coverage" {
        io.set_be16(sub, 2, 65535)
    } else if what == "set" {
        io.set_be16(sub, 6, 65535)
    } else if what == "ligature" {
        io.set_be16(sub, 16, 65535)
    } else if what == "glyph" {
        io.set_be16(sub, 18, 500)
    } else if what == "count" {
        io.set_be16(sub, 20, 9)
    } else if what == "no components" {
        io.set_be16(sub, 20, 0)
    } else if what == "format" {
        io.set_be16(sub, 0, 2)
    }
    var direct = lookup(4, [sub])
    if what == "subtable" {
        io.set_be16(direct, 6, 65535)
    }
    var ext = extension(4, sub)
    if what == "extension" {
        io.set_be32(ext, 4, 2147483647)
    } else if what == "extension type" {
        io.set_be16(ext, 2, 7)
    } else if what == "extension format" {
        io.set_be16(ext, 0, 2)
    }
    let wrapped = lookup(7, [ext])
    let chosen = if what.len >= 9 && what[0..9] == "extension" { wrapped } else { direct }
    var data = feature_gsub("liga", [chosen])
    if what == "script list" {
        io.set_be16(data, 4, 65535)
    } else if what == "feature list" {
        io.set_be16(data, 6, 65535)
    } else if what == "lookup list" {
        io.set_be16(data, 8, 65535)
    }
    render(open(data), [10, 11])
}

fn truncated() {
    let data = feature_gsub("liga", [fi_lookup()])
    var plain = 0
    var full = 0
    var other = 0
    for cut in 0..data.len + 1 {
        var part: []u8 = []
        for i in 0..cut {
            part.push(data[i])
        }
        match render(open(part), [10, 11]) {
            "10[0-1] 11[1-2]" => {
                plain += 1
            }
            "20[0-2]" => {
                full += 1
            }
            _ => {
                other += 1
            }
        }
    }
    print("truncated {data.len + 1}: plain {plain} full {full} other {other}")
}

fn main() {
    runs("ligatures", ligatures(), [[10, 11], [10, 10, 11], [10, 12], [10, 10, 12], [11, 10, 11, 5], [10], [], [10, 11, 10, 11], [10, 13], [10, 10]])
    runs("ranges", ranges(), [[11, 11], [14, 15], [10, 11], [12, 11], [12, 12], [15, 14]])
    runs("extension", wrapped(), [[10, 11], [11, 10, 11]])
    runs("staged", staged(), [[2, 1], [10, 11], [1, 2], [2, 2]])
    runs("merged", merged(), [[10, 11, 10, 12], [12, 12], [11, 11], [10, 11, 11]])
    runs("ordered", ordered(), [[10, 11, 12], [10, 11]])
    runs("unsupported", unsupported(), [[10, 11], [14]])
    runs("no table", open([]), [[10, 11]])

    var line = "scripts"
    for scripts in [["DFLT", "latn"], ["latn", "DFLT"], ["arab", "latn", "DFLT"], ["arab", "DFLT"], ["cyrl", "grek"]] {
        line = "{line} {render(script_font(scripts), [10, 11])}"
    }
    print(line)

    var bad = "malformed"
    for what in ["intact", "script list", "feature list", "lookup list", "subtable", "coverage", "set", "ligature", "glyph", "count", "no components", "format", "extension", "extension type", "extension format"] {
        bad = "{bad} {what}={broken(what)}"
    }
    print(bad)
    truncated()
}
