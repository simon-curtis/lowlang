struct Pair {
    name: str
    items: i64[]
}

fn fib(n: i64) -> i64 {
    if n < 2 {
        return n
    }
    fib(n - 1) + fib(n - 2)
}

fn forked_fib(n: i64) -> i64 {
    if n < 15 {
        return fib(n)
    }
    let a, b = fork { forked_fib(n - 1), forked_fib(n - 2) }
    a + b
}

fn total[T](xs: T[], weigh: fn(T) -> i64) -> i64 {
    if xs.len == 1 {
        return weigh(xs[0])
    }
    let mid = xs.len / 2
    let left, right = fork { total(xs[..mid], weigh), total(xs[mid..], weigh) }
    left + right
}

fn build(n: i64) -> Pair {
    var items: i64[] = []
    for i in 0..n {
        items.push(i * i)
    }
    Pair { name: "p{n}", items }
}

fn main() {
    let seed = 20
    let x, y = fork { fib(10), fib(seed) }
    print("{x} {y}")
    print(forked_fib(25))
    var count, _, name = fork { fib(10), print("side"), "low" }
    count += 1
    print("{count} {name}")
    let p, q, r = fork {
        build(3)
        build(4)
        {
            let inner, tail = fork { build(2), "tail" }
            "{inner.name}{tail}"
        }
    }
    print("{p.name} {p.items} {q.name} {q.items} {r}")
    print(total([1, 2, 3, 4, 5, 6, 7], fn(n: i64) -> i64 { n * 2 }))
    print(total(["a", "bcd", "ef"], fn(s: str) -> i64 { s.len }))
    for i in 0..3 {
        let a, b = fork { i, i * 10 }
        print(a + b)
    }
    let scale = fn(n: i64) -> i64 {
        let a, b = fork { n + 1, n + 2 }
        a * b
    }
    print(scale(1))
    for _ in 0..1 {
        let x, _ = fork { x + 1, sleep(1) }
        print(x)
    }
}
