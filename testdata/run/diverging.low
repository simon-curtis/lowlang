enum Oops {
    Bad(i64)
    Worse
}

fn halve(x: i64) -> i64? {
    if x % 2 == 0 {
        return x / 2
    }
    none
}

fn first_even_half(xs: []i64) -> i64 {
    for x in xs {
        let half = halve(x) ?? continue
        return half
    }
    -1
}

fn lookup(n: i64) -> str {
    let v = halve(n) ?? return "odd"
    "half {v}"
}

fn strict(n: i64) -> i64 ! Oops {
    let v = halve(n) ?? fail Bad(n)
    v
}

fn main() {
    print(first_even_half([3, 5, 8, 10]))
    print(lookup(7))
    print(lookup(8))
    print(strict(6) or -1)
    print(strict(5) catch {
        Bad(n) => n * 100
        Worse => 0
    })

    var n = 0
    for {
        n += 2
        let half = halve(n) ?? break
        if half > 3 {
            break
        }
        print(half)
    }

    var found = -1
    rows: for row in 0..3 {
        for col in 0..3 {
            found = halve(row * 3 + col + 1) ?? continue rows
        }
    }
    print(found)
}
