import std/file
import std/http
import std/io
import std/os
import std/text
import std/uri

struct Cookies {
    cookies: [str: str]
}

struct Auth {
    authenticated: bool
}

struct Anything {
    method: str
    url: str
    form: [str: []str] = [:]
    files: [str: []str] = [:]
    headers: [str: []str] = [:]
}

struct Gzipped {
    gzipped: bool
}

struct Deflated {
    deflated: bool
}

struct Failures {
    count: i64
}

fn check(f: *Failures, label: str, ok: bool, detail: str) {
    if !ok {
        f.count += 1
        print("FAIL {label}: {detail}")
    }
}

fn describe(op: fn() -> http.Response ! http.Error) -> str {
    let r = op() catch {
        InvalidUrl(u) => return "invalid url {u}"
        Connect(_) => return "connect error"
        Tls(_) => return "tls error"
        Timeout => return "timeout"
        TooManyRedirects(n) => return "too many redirects {n}"
        Protocol(_) => return "protocol error"
        Decode(_) => return "decode error"
        Json(_) => return "json error"
        Status(code) => return "status {code}"
        Io(cause) => return if cause == Aborted { "cancelled" } else { "io error" }
    }
    "{r.status} {r.url}"
}

fn path_of(r: http.Response) -> str {
    let u = http.parse_url(r.url) catch {
        _ => return r.url
    }
    u.target
}

fn redirects(f: *Failures, c: *http.Client) ! http.Error {
    let r = c.get("/redirect/3")?
    check(f, "redirect/3", r.status == 200 && path_of(r) == "/get", "{r.status} {r.url}")
    let a = c.get("/absolute-redirect/2")?
    check(f, "absolute-redirect/2", a.status == 200 && path_of(a) == "/get", "{a.status} {a.url}")
    let rel = c.get("/relative-redirect/2")?
    check(f, "relative-redirect/2", rel.status == 200 && path_of(rel) == "/get", "{rel.status} {rel.url}")
    let kept = c.request("POST", "/redirect-to").with_query("url", "/anything").with_query("status_code", "307").with_text("body").send()?
    let k = http.json[Anything](kept)?
    check(f, "redirect-to 307", k.method == "POST", k.method)
    let switched = c.request("POST", "/redirect-to").with_query("url", "/anything").with_query("status_code", "302").with_text("body").send()?
    let s = http.json[Anything](switched)?
    check(f, "redirect-to 302", s.method == "GET", s.method)
    let many = describe(fn() -> http.Response ! http.Error { c.get("/redirect/12") })
    check(f, "redirect/12", many == "too many redirects 10", many)
    let off = c.request("GET", "/redirect/1").with_redirects(0).send()?
    check(f, "redirects off", off.status == 302, "{off.status}")
}

fn cookies(f: *Failures, base: str) ! http.Error {
    let c = http.client().with_base_url(base).with_cookies().build()
    let set = http.json[Cookies](c.get("/cookies/set?a=1&b=2")?)?
    check(f, "cookies/set", (set.cookies["a"] ?? "") == "1" && (set.cookies["b"] ?? "") == "2", "{set.cookies.len}")
    let deleted = http.json[Cookies](c.get("/cookies/delete?a")?)?
    check(f, "cookies/delete", deleted.cookies["a"] == none && (deleted.cookies["b"] ?? "") == "2", "{deleted.cookies.len}")
}

fn auth(f: *Failures, c: *http.Client) ! http.Error {
    let ok = c.request("GET", "/basic-auth/user/pass").with_basic_auth("user", "pass").send()?
    check(f, "basic-auth", ok.status == 200 && http.json[Auth](ok)?.authenticated, "{ok.status}")
    let wrong = c.request("GET", "/basic-auth/user/pass").with_basic_auth("user", "nope").send()?
    check(f, "basic-auth wrong", wrong.status == 401, "{wrong.status}")
    let bearer = c.request("GET", "/bearer").with_bearer_token("token").send()?
    check(f, "bearer", bearer.status == 200 && http.json[Auth](bearer)?.authenticated, "{bearer.status}")
    let none_given = describe(fn() -> http.Response ! http.Error { c.get("/bearer")?.ensure_success() })
    check(f, "bearer missing", none_given == "status 401", none_given)
}

fn encodings(f: *Failures, c: *http.Client) ! http.Error {
    let g = c.get("/gzip")?
    check(f, "gzip", http.json[Gzipped](g)?.gzipped && g.header_value("content-encoding") == none, g.text())
    let d = c.get("/deflate")?
    check(f, "deflate", http.json[Deflated](d)?.deflated, d.text())
    var lines = 0
    var chunks = 0
    let streamed = c.request("GET", "/stream/5").stream_to(fn(chunk: []u8) ! io.Error {
        chunks += 1
        for b in chunk {
            if b == '\n' {
                lines += 1
            }
        }
    })?
    check(f, "stream/5", streamed.status == 200 && lines == 5, "{lines} lines in {chunks} chunks")
    let path = "/tmp/std_http_client_live.bin"
    let saved = c.request("GET", "/bytes/50000").download(path)?
    let size = (file.stat(path) catch {
        _ => file.Info { size: -1, mode: 0, dir: false, modified: 0 }
    }).size
    check(f, "download", saved.status == 200 && size == 50000, "{size}")
    file.remove(path) catch {
        _ => {}
    }
}

fn delays(f: *Failures, c: *http.Client) {
    let quick = describe(fn() -> http.Response ! http.Error { c.request("GET", "/delay/1").with_timeout(300).send() })
    check(f, "delay timeout", quick == "timeout", quick)
    let patient = describe(fn() -> http.Response ! http.Error { c.request("GET", "/delay/1").with_timeout(5000).send() })
    check(f, "delay ok", text.starts_with(patient, "200 "), patient)
}

fn bodies(f: *Failures, c: *http.Client) ! http.Error {
    let form = http.json[Anything](c.request("POST", "/anything").with_form([uri.Field { name: "k", value: "a b&c" }]).send()?)?
    let k = form.form["k"] ?? []
    check(f, "anything form", k.len == 1 && k[0] == "a b&c", "{k.len}")
    let parts = [http.text_part("field", "value"), http.file_part("upload", "data.txt", "text/plain", bytes("file body"))]
    let multi = http.json[Anything](c.request("PUT", "/anything").with_multipart(parts).send()?)?
    let field = multi.form["field"] ?? []
    let upload = multi.files["upload"] ?? []
    check(f, "anything multipart", multi.method == "PUT" && field.len == 1 && field[0] == "value" && upload.len == 1 && upload[0] == "file body", "{field.len} {upload.len}")
    let chunked = http.json[Anything](c.request("POST", "/anything").with_body_reader(io.bytes_reader(bytes("x=1")), "application/x-www-form-urlencoded").send()?)?
    let x = chunked.form["x"] ?? []
    check(f, "anything chunked", x.len == 1 && x[0] == "1", "{x.len}")
    let teapot = describe(fn() -> http.Response ! http.Error { c.get("/status/418")?.ensure_success() })
    check(f, "status/418", teapot == "status 418", teapot)
}

fn sites(f: *Failures) {
    let c = http.client().with_timeout(15000).build()
    for url in ["https://www.google.com/", "https://www.cloudflare.com/", "https://github.com/", "https://example.com/"] {
        let r = c.get(url) catch {
            _ => {
                check(f, url, false, "request failed")
                continue
            }
        }
        check(f, url, r.status == 200 && r.version == http.Version.Http2 && r.body.len > 0, "{r.status} {r.body.len}")
    }
    let zstd_site = "https://www.facebook.com/"
    let raw = c.request("GET", zstd_site).with_header("accept-encoding", "zstd").with_decompression(false).send() catch {
        _ => http.response(0, "")
    }
    let decoded = c.request("GET", zstd_site).with_header("accept-encoding", "zstd").send() catch {
        _ => http.response(0, "")
    }
    let page = text.lower(decoded.text())
    check(f, "zstd", raw.header_value("content-encoding") == "zstd" && text.index(page, "<html") >= 0, "{raw.header_value("content-encoding") ?? "-"} {decoded.status} {decoded.body.len}")
    let h1 = http.client().with_timeout(15000).with_version(Http1).build()
    for url in ["https://www.google.com/", "https://example.com/", "http://example.com/"] {
        let r = h1.get(url) catch {
            _ => {
                check(f, url, false, "http/1.1 request failed")
                continue
            }
        }
        check(f, url, r.status == 200 && r.version == http.Version.Http1 && r.body.len > 0, "{r.status} {r.body.len}")
    }
}

fn main() ! http.Error {
    let f = new(Failures { count: 0 })
    var ran = false
    match os.env("LOW_HTTPBIN") {
        some(base) => {
            let c = http.client().with_base_url(base).build()
            redirects(f, c)?
            cookies(f, base)?
            auth(f, c)?
            encodings(f, c)?
            delays(f, c)
            bodies(f, c)?
            ran = true
        }
        none => {}
    }
    match os.env("LOW_HTTP_INTERNET") {
        some(_) => {
            sites(f)
            ran = true
        }
        none => {}
    }
    if !ran {
        print("live skipped")
        return
    }
    if f.count > 0 {
        print("live failed {f.count}")
        return
    }
    print("live done")
}
