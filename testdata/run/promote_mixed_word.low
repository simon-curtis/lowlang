enum Length {
    Auto
    Px(f32)
    Count(i64)
}

struct Style {
    width: Length = Auto
    height: Length = Auto
    gap: f32 = 0.0
}

extern struct Tint {
    r: f32 = 1.0
    a: f32 = 0.5
}

struct Element {
    style: Style = Style {}
    tint: Tint = Tint {}
    depth: i64 = 0
}

fn with_px(e: Element, px: f32) -> Element {
    var out = e
    out.style.width = Px(px)
    out
}

fn with_count(e: Element, n: i64) -> Element {
    var out = e
    out.style.width = Count(n)
    out
}

fn doubled_width(e: Element) -> f32 {
    var out = e
    out.depth += 1
    match out.style.width {
        Px(p) => p * 2.0 + f32(out.depth)
        _ => -1.0
    }
}

fn describe(l: Length) -> str {
    match l {
        Auto => "auto"
        Px(p) => "{p * 2.0}px"
        Count(n) => "{n + 1} items"
    }
}

fn main() {
    var s = Element { style: Style { height: Px(1.5), gap: 0.25 }, depth: 2 }
    print(describe(s.style.width))
    var px: f32 = 0.5
    for i in 0..4 {
        if i % 2 == 0 {
            s = with_px(s, px)
            px += 1.0
        } else {
            s = with_count(s, i * 1000)
        }
        print(describe(s.style.width))
    }
    print(doubled_width(s))
    print(doubled_width(with_px(s, 4.25)))
    print(describe(s.style.height))
    print(s.style.gap)
    print(s.depth)
    print("{s.tint.r} {s.tint.a}")
}
