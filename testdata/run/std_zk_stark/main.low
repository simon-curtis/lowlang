import std/text
import std/zk/airs
import std/zk/goldilocks
import std/zk/stark

struct Tally {
    failed: i64
}

fn check(t: *Tally, label: str, ok: bool) {
    if ok {
        print("ok   {label}")
    } else {
        t.failed += 1
        print("FAIL {label}")
    }
}

fn error_name(e: stark.Error) -> str {
    match e {
        Params => "Params"
        Air => "Air"
        Trace => "Trace"
        Unsatisfied => "Unsatisfied"
        TooLarge => "TooLarge"
        Malformed => "Malformed"
        Mismatch => "Mismatch"
    }
}

fn numbers(files: [str: str], name: str) -> u64[] {
    var out: u64[] = []
    for line in text.lines(files["vectors.txt"] ?? "") {
        let c = text.cut(line, ": ")
        if c.found && c.before == name {
            for word in text.fields(c.after) {
                out.push(text.parse_u64(word, 10) or 0)
            }
        }
    }
    out
}

fn elements(values: u64[]) -> goldilocks.Ext[] {
    var out: goldilocks.Ext[] = []
    for i in 0..values.len / 3 {
        out.push(goldilocks.Ext { c0: values[3 * i], c1: values[3 * i + 1], c2: values[3 * i + 2] })
    }
    out
}

fn flat(values: goldilocks.Ext[]) -> u64[] {
    var out: u64[] = []
    for v in values {
        out.push(v.c0)
        out.push(v.c1)
        out.push(v.c2)
    }
    out
}

fn same(a: u64[], b: u64[]) -> bool {
    if a.len != b.len {
        return false
    }
    for i in 0..a.len {
        if a[i] != b[i] {
            return false
        }
    }
    true
}

fn padded(values: u64[], size: i64) -> u64[] {
    var out: u64[] = []
    for v in values {
        out.push(v)
    }
    for _ in values.len..size {
        out.push(0)
    }
    out
}

fn padded_ext(values: goldilocks.Ext[], size: i64) -> goldilocks.Ext[] {
    var out: goldilocks.Ext[] = []
    for v in values {
        out.push(v)
    }
    for _ in values.len..size {
        out.push(goldilocks.ext(0))
    }
    out
}

fn edge_values() -> u64[] {
    var out: u64[] = []
    for v in [0, 1, 2] {
        out.push(u64(v))
    }
    out.push(goldilocks.modulus - 1)
    out.push(goldilocks.modulus - 2)
    out.push(0xFFFF_FFFF)
    out.push(1 << 32)
    out.push((1 << 32) + 1)
    out.push(1 << 63)
    out.push(0xFFFF_FFFE_0000_0001)
    out
}

fn field_vectors(t: *Tally, files: [str: str]) {
    let edges = edge_values()
    var sum: u64[] = []
    var difference: u64[] = []
    var product: u64[] = []
    for a in edges {
        for b in edges {
            sum.push(goldilocks.add(a, b))
            difference.push(goldilocks.sub(a, b))
            product.push(goldilocks.mul(a, b))
        }
    }
    check(t, "field: 100 sums equal Winterfell's", same(sum, numbers(files, "add")))
    check(t, "field: 100 differences equal Winterfell's", same(difference, numbers(files, "sub")))
    check(t, "field: 100 products equal Winterfell's", same(product, numbers(files, "mul")))

    var inverses: u64[] = []
    for a in edges[1..] {
        inverses.push(goldilocks.inv(a))
    }
    check(t, "field: 9 inverses equal Winterfell's", same(inverses, numbers(files, "inv")))

    var powers: u64[] = []
    for k in [0, 1, 2, 63, 64, 1 << 32] {
        powers.push(goldilocks.pow(7, u64(k)))
    }
    powers.push(goldilocks.pow(7, goldilocks.modulus - 2))
    check(t, "field: 7 powers of the generator equal Winterfell's", same(powers, numbers(files, "pow7")))

    var roots: u64[] = []
    for log in 1..33 {
        roots.push(goldilocks.root_of_unity(log))
    }
    check(t, "field: the roots of unity of order 2 to 2^32 equal Winterfell's", same(roots, numbers(files, "roots")))
}

fn extension_vectors(t: *Tally, files: [str: str]) {
    let xs = elements(numbers(files, "ext_elements"))
    var products: goldilocks.Ext[] = []
    for a in xs {
        for b in xs {
            products.push(goldilocks.ext_mul(a, b))
        }
    }
    check(t, "extension: 36 products equal Winterfell's", same(flat(products), numbers(files, "ext_mul")))

    var inverses: goldilocks.Ext[] = []
    var conjugates: goldilocks.Ext[] = []
    for a in xs {
        inverses.push(goldilocks.ext_inv(a))
        conjugates.push(goldilocks.ext_pow(a, goldilocks.modulus))
    }
    check(t, "extension: 6 inverses equal Winterfell's", same(flat(inverses), numbers(files, "ext_inv")))
    check(t, "extension: 6 Frobenius images equal Winterfell's", same(flat(conjugates), numbers(files, "ext_frobenius")))
}

fn transform_vectors(t: *Tally, files: [str: str]) {
    let coefficients = numbers(files, "poly")
    let values = padded(coefficients, 32)
    goldilocks.ntt(goldilocks.twiddles(32), values)
    check(t, "ntt: 32 values on the subgroup equal Winterfell's", same(values, numbers(files, "ntt")))
    goldilocks.intt(goldilocks.twiddles(32), values)
    check(t, "ntt: the inverse returns the coefficients", same(values, coefficients))

    let extended = padded(coefficients, 128)
    goldilocks.coset_ntt(goldilocks.twiddles(128), extended, goldilocks.generator)
    check(t, "lde: 128 values on the coset of blowup 4 equal Winterfell's", same(extended, numbers(files, "lde4")))
    goldilocks.coset_intt(goldilocks.twiddles(128), extended, goldilocks.generator)
    check(t, "lde: the coset inverse returns the coefficients", same(extended, padded(coefficients, 128)))

    let ext_coefficients = elements(numbers(files, "ext_poly"))
    let ext_extended = padded_ext(ext_coefficients, 128)
    goldilocks.ext_coset_ntt(goldilocks.twiddles(128), ext_extended, goldilocks.generator)
    check(t, "lde: 128 extension values of blowup 8 equal Winterfell's", same(flat(ext_extended), numbers(files, "ext_lde8")))
    goldilocks.ext_coset_intt(goldilocks.twiddles(128), ext_extended, goldilocks.generator)
    check(t, "lde: the extension coset inverse returns the coefficients", same(flat(ext_extended), flat(padded_ext(ext_coefficients, 128))))
}

fn security_vectors(t: *Tally, files: [str: str]) {
    var seen = 0
    for line in text.lines(files["vectors.txt"] ?? "") {
        if !text.starts_with(line, "security ") {
            continue
        }
        let c = text.cut(line, ": ")
        let head = text.fields(c.before)
        let tail = text.fields(c.after)
        let queries = i64(text.parse_u64(head[1], 10) or 0)
        let blowup = i64(text.parse_u64(head[2], 10) or 0)
        let grinding = i64(text.parse_u64(head[3], 10) or 0)
        let steps = i64(text.parse_u64(head[4], 10) or 0)
        let params = stark.Params { blowup, queries, grinding_bits: grinding, zero_knowledge: false }
        let s = stark.security(airs.fibonacci(steps, 0), params) or stark.Security { conjectured: 0, proven_unique: 0, proven_list: 0 }
        let want = [i64(text.parse_u64(tail[0], 10) or 0), i64(text.parse_u64(tail[1], 10) or 0), i64(text.parse_u64(tail[2], 10) or 0)]
        let label = "security: {queries} queries, blowup {blowup}, {grinding} grinding bits, {steps} steps give {s.conjectured} conjectured, {s.proven_unique} proven unique and {s.proven_list} proven list bits"
        check(t, label, s.conjectured == want[0] && s.proven_unique == want[1] && s.proven_list == want[2])
        seen += 1
    }
    check(t, "security: 6 cases equal Winterfell's", seen == 6)
}

fn fibonacci_case(steps: i64) -> stark.Air {
    airs.fibonacci(steps, airs.fibonacci_result(steps))
}

fn hash_case(steps: i64) -> stark.Air {
    let trace = airs.hash_chain_trace(steps, 123, 456)
    airs.hash_chain(steps, trace[0][steps - 1], trace[1][steps - 1])
}

fn trace_of(air: stark.Air, steps: i64) -> u64[][] {
    if air.width == 2 && air.periodic.len == 0 {
        airs.fibonacci_trace(steps)
    } else {
        airs.hash_chain_trace(steps, 123, 456)
    }
}

fn proofs(t: *Tally, name: str, air: stark.Air, params: stark.Params) {
    let label = "{name}, {params.blowup}x blowup, {params.queries} queries, {params.grinding_bits} grinding bits, zero knowledge {params.zero_knowledge}"
    let trace = trace_of(air, air.steps)
    let proof = stark.prove(air, params, trace) catch { e => return check(t, "{label}: prove failed with {error_name(e)}", false) }
    let s = stark.security(air, params) or return check(t, "{label}: security", false)
    check(t, "{label}: accepted, {s.conjectured} conjectured, {s.proven_unique} proven unique, {s.proven_list} proven list bits", stark.verify(air, params, proof))
    let data = stark.write_proof(air, params, proof) or return check(t, "{label}: write", false)
    let back = stark.read_proof(air, params, data) or return check(t, "{label}: read", false)
    check(t, "{label}: accepted after a round trip through bytes", stark.verify(air, params, back))
}

fn changed_public_input(air: stark.Air) -> stark.Air {
    var boundaries: stark.Boundary[] = []
    for b in air.boundaries {
        boundaries.push(b)
    }
    let last = boundaries.len - 1
    boundaries[last] = stark.Boundary { column: boundaries[last].column, row: boundaries[last].row, value: boundaries[last].value + 1 }
    stark.Air { width: air.width, steps: air.steps, periodic: air.periodic, transitions: air.transitions, boundaries }
}

fn copy_layer(l: stark.Layer) -> stark.Layer {
    var leaves: u64[][] = []
    for leaf in l.leaves {
        var c: u64[] = []
        for v in leaf {
            c.push(v)
        }
        leaves.push(c)
    }
    var siblings: u8[][] = []
    for s in l.siblings {
        var c: u8[] = []
        for v in s {
            c.push(v)
        }
        siblings.push(c)
    }
    stark.Layer { leaves, siblings }
}

fn copy_bytes(values: u8[][]) -> u8[][] {
    var out: u8[][] = []
    for s in values {
        var c: u8[] = []
        for v in s {
            c.push(v)
        }
        out.push(c)
    }
    out
}

fn copy_proof(p: stark.Proof) -> stark.Proof {
    var fri: stark.Layer[] = []
    for l in p.fri {
        fri.push(copy_layer(l))
    }
    var ood: goldilocks.Ext[] = []
    for v in p.ood {
        ood.push(v)
    }
    var remainder: goldilocks.Ext[] = []
    for v in p.remainder {
        remainder.push(v)
    }
    stark.Proof {
        trace_root: copy_bytes([p.trace_root])[0]
        composition_root: copy_bytes([p.composition_root])[0]
        ood
        fri_roots: copy_bytes(p.fri_roots)
        remainder
        nonce: p.nonce
        trace: copy_layer(p.trace)
        composition: copy_layer(p.composition)
        fri
    }
}

struct Tampered {
    air: stark.Air
    proof: stark.Proof
}

fn kinds() -> str[] {
    [
        "a wrong public input"
        "a changed trace value"
        "a changed trace Merkle path"
        "a changed trace root"
        "a changed composition value"
        "a changed composition Merkle path"
        "a changed composition root"
        "a changed out-of-domain value"
        "a changed FRI layer value"
        "a changed FRI layer Merkle path"
        "a changed FRI layer root"
        "a changed remainder"
        "a changed nonce"
    ]
}

fn tampered(kind: i64, air: stark.Air, proof: stark.Proof) -> Tampered {
    var p = copy_proof(proof)
    var a = air
    match kind {
        0 => { a = changed_public_input(air) }
        1 => { p.trace.leaves[0][0] = goldilocks.add(p.trace.leaves[0][0], 1) }
        2 => { p.trace.siblings[0][0] ^= 1 }
        3 => { p.trace_root[0] ^= 1 }
        4 => { p.composition.leaves[0][0] = goldilocks.add(p.composition.leaves[0][0], 1) }
        5 => { p.composition.siblings[0][0] ^= 1 }
        6 => { p.composition_root[0] ^= 1 }
        7 => { p.ood[0].c0 = goldilocks.add(p.ood[0].c0, 1) }
        8 => { p.fri[0].leaves[0][0] = goldilocks.add(p.fri[0].leaves[0][0], 1) }
        9 => { p.fri[0].siblings[0][0] ^= 1 }
        10 => { p.fri_roots[0][0] ^= 1 }
        11 => { p.remainder[0].c0 = goldilocks.add(p.remainder[0].c0, 1) }
        _ => { p.nonce += 1 }
    }
    Tampered { air: a, proof: p }
}

fn tamper_cases(t: *Tally, name: str, air: stark.Air, params: stark.Params, proof: stark.Proof) {
    let names = kinds()
    for i in 0..names.len {
        let c = tampered(i, air, proof)
        check(t, "{name}: rejects {names[i]}", !stark.verify(c.air, params, c.proof))
    }
}

fn read_outcome(air: stark.Air, params: stark.Params, data: u8[]) -> str {
    stark.read_proof(air, params, data) catch { e => return error_name(e) }
    "read"
}

fn byte_cases(t: *Tally, name: str, air: stark.Air, params: stark.Params, data: u8[]) {
    var cut_short = true
    for n in 0..data.len {
        if read_outcome(air, params, data[..n]) != "Malformed" {
            cut_short = false
        }
    }
    check(t, "{name}: each of the {data.len} proper prefixes is Malformed", cut_short)

    var trailing: u8[] = []
    for b in data {
        trailing.push(b)
    }
    trailing.push(0)
    check(t, "{name}: a trailing byte is Malformed", read_outcome(air, params, trailing) == "Malformed")

    var accepted = 0
    for i in 0..data.len {
        if flipped_accepted(air, params, data, i) {
            accepted += 1
        }
    }
    check(t, "{name}: none of {data.len} proofs with one flipped bit is accepted", accepted == 0)
}

fn flipped_accepted(air: stark.Air, params: stark.Params, data: u8[], at: i64) -> bool {
    var c: u8[] = []
    for b in data {
        c.push(b)
    }
    c[at] ^= 0x10
    let p = stark.read_proof(air, params, c) or return false
    stark.verify(air, params, p)
}

fn parameter_cases(t: *Tally, name: str, air: stark.Air, params: stark.Params, other: stark.Air, shorter: stark.Air, data: u8[], proof: stark.Proof) {
    let wider = stark.Params { blowup: params.blowup * 2, queries: params.queries, grinding_bits: params.grinding_bits, zero_knowledge: params.zero_knowledge }
    let longer = stark.Params { blowup: params.blowup, queries: params.queries + 1, grinding_bits: params.grinding_bits, zero_knowledge: params.zero_knowledge }
    let harder = stark.Params { blowup: params.blowup, queries: params.queries, grinding_bits: params.grinding_bits + 1, zero_knowledge: params.zero_knowledge }
    let flipped = stark.Params { blowup: params.blowup, queries: params.queries, grinding_bits: params.grinding_bits, zero_knowledge: !params.zero_knowledge }
    let kinds = ["blowup", "queries", "grinding bits", "zero knowledge"]
    let variants = [wider, longer, harder, flipped]
    for i in 0..kinds.len {
        check(t, "{name}: bytes for other {kinds[i]} are Mismatch", read_outcome(air, variants[i], data) == "Mismatch")
        check(t, "{name}: the proof is rejected under other {kinds[i]}", !stark.verify(air, variants[i], proof))
    }
    check(t, "{name}: bytes for a trace of another length are Mismatch", read_outcome(shorter, params, data) == "Mismatch")
    check(t, "{name}: the proof is rejected for a trace of another length", !stark.verify(shorter, params, proof))
    check(t, "{name}: the proof is rejected for another computation of the same shape", !stark.verify(other, params, proof))
}

fn rejections(t: *Tally, name: str, air: stark.Air, other: stark.Air, shorter: stark.Air, params: stark.Params) {
    let proof = stark.prove(air, params, trace_of(air, air.steps)) or return check(t, "{name}: prove", false)
    let data = stark.write_proof(air, params, proof) or return check(t, "{name}: write", false)
    tamper_cases(t, name, air, params, proof)
    byte_cases(t, name, air, params, data)
    parameter_cases(t, name, air, params, other, shorter, data, proof)
}

fn prove_outcome(air: stark.Air, params: stark.Params, trace: u64[][]) -> str {
    stark.prove(air, params, trace) catch { e => return error_name(e) }
    "proved"
}

fn unsatisfied(t: *Tally) {
    let air = fibonacci_case(16)
    let params = stark.Params { blowup: 4, queries: 8, grinding_bits: 0, zero_knowledge: false }
    let broken = airs.fibonacci_trace(16)
    broken[0][5] = goldilocks.add(broken[0][5], 1)
    check(t, "a trace that breaks a transition is Unsatisfied", prove_outcome(air, params, broken) == "Unsatisfied")
    check(t, "a trace of the wrong shape is Trace", prove_outcome(air, params, [[1, 1], [1, 1]]) == "Trace")
    let slim = stark.Params { blowup: 1, queries: 8, grinding_bits: 0, zero_knowledge: false }
    check(t, "a blowup of 1 is Params", prove_outcome(air, slim, airs.fibonacci_trace(16)) == "Params")
}

fn main() {
    let t = new(Tally { failed: 0 })
    let files = embed_dir("winterfell")
    field_vectors(t, files)
    extension_vectors(t, files)
    transform_vectors(t, files)
    security_vectors(t, files)

    let fast = stark.Params { blowup: 4, queries: 16, grinding_bits: 8, zero_knowledge: false }
    let hiding = stark.Params { blowup: 8, queries: 12, grinding_bits: 8, zero_knowledge: true }
    for params in [fast, hiding] {
        proofs(t, "fibonacci of 64 rows", fibonacci_case(64), params)
        proofs(t, "hash chain of 32 rows", hash_case(32), params)
    }

    let small = stark.Params { blowup: 4, queries: 6, grinding_bits: 4, zero_knowledge: false }
    rejections(t, "fibonacci", fibonacci_case(64), hash_case(64), fibonacci_case(32), small)
    rejections(t, "hash chain", hash_case(64), fibonacci_case(64), hash_case(32), small)
    unsatisfied(t)
    if t.failed != 0 {
        panic("{t.failed} checks failed")
    }
}
