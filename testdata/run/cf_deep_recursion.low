struct Node {
    value: i64
    next: *Node?
}

fn churn(n: i64) -> i64 {
    var sum = 0
    for i in 0..n {
        let junk = new(Node { value: i, next: none })
        sum += junk.value
    }
    sum
}

fn descend(depth: i64, carry: *Node?) -> i64 {
    if depth <= 0 {
        return churn(5000)
    }
    let node = new(Node { value: depth, next: carry })
    let below = descend(depth - 1, node)
    below + node.value
}

fn fall(n: i64) -> i64 {
    if n < 2 {
        return n
    }
    fall(n - 1) + fall(n - 2)
}

fn collatz(n: i64, steps: i64) -> i64 {
    if n == 1 {
        return steps
    }
    if n % 2 == 0 {
        return collatz(n / 2, steps + 1)
    }
    collatz(3 * n + 1, steps + 1)
}

fn sum_to(n: i64, acc: i64) -> i64 {
    if n == 0 {
        return acc
    }
    sum_to(n - 1, acc + n)
}

fn main() {
    var total = 0
    for round in 0..20 {
        total += descend(2000 + round, none)
    }
    print(total)
    print(fall(24))
    var longest = 0
    for n in 1..3000 {
        let steps = collatz(n, 0)
        if steps > longest {
            longest = steps
        }
    }
    print(longest)
    print(sum_to(40000, 0))
}
