import std/ui
import std/ui/geometry
import std/ui/platform
import std/ui/scene

fn show(r: geometry.Rect) -> str {
    "{r.x} {r.y} {r.width} {r.height}"
}

fn dump(s: scene.Scene) {
    for q in s.quads {
        print("quad {show(q.bounds)} clip {show(q.clip)} alpha {q.background.a}")
    }
}

fn spacing() -> ui.Element {
    ui.div().column().padding_x(10.0).padding_y(4.0).children() {
        ui.div().height(10.0).margin_x(5.0).background(ui.rgb(0xff0000))
        ui.div().size(20.0, 10.0).self_end().background(ui.rgb(0x00ff00))
        ui.div().height(10.0).width_percent(50.0).background(ui.rgb(0x0000ff))
        ui.div().size(20.0, 10.0).hidden().background(ui.rgb(0xffffff))
        ui.div().size(8.0, 8.0).absolute().right(2.0).bottom(3.0).background(ui.rgb(0x00ffff))
    }
}

fn flex() -> ui.Element {
    ui.div().row().children() {
        ui.div().flex_1().height(10.0).background(ui.rgb(0xff0000))
        ui.div().flex_1().height(10.0).background(ui.rgb(0x00ff00))
        ui.div().width(30.0).min_width(40.0).height(10.0).background(ui.rgb(0x0000ff))
    }
}

fn clipping() -> ui.Element {
    ui.div().size(20.0, 20.0).overflow_x_hidden().child(ui.div().size(40.0, 40.0).opacity(0.5).background(ui.rgb(0xff0000)))
}

fn gradients() -> ui.Element {
    let red = ui.color_stop(ui.rgb(0xff0000), 0.0)
    let blue = ui.color_stop(ui.rgb(0x0000ff), 1.0)
    ui.div().row().children() {
        ui.div().size(40.0, 20.0).fill(ui.linear_gradient(90.0, red, blue))
        ui.div().size(40.0, 20.0).fill(ui.linear_gradient(180.0, ui.color_stop(ui.rgb(0xff0000), 0.25), ui.color_stop(ui.rgba(0x0000ff80), 0.75)))
        ui.div().size(20.0, 20.0).fill(ui.linear_gradient(45.0, red, blue))
        ui.div().size(20.0, 20.0).fill(ui.linear_gradient(0.0, ui.color_stop(ui.rgba(0x00000000), 0.0), ui.color_stop(ui.rgba(0x00000000), 1.0)))
        ui.div().size(20.0, 20.0).background(ui.rgb(0x00ff00)).hover(fn(v) v.with_fill(ui.linear_gradient(270.0, red, blue)))
    }
}

fn shade(s: scene.Scene) {
    for q in s.quads {
        let g = q.gradient
        print("quad {show(q.bounds)} from {q.background.r} {q.background.b} to {q.background_end.b} {q.background_end.a} line {g.dx} {g.dy} {g.from} {g.to}")
    }
}

fn main() {
    let cx = ui.headless(ui.rgb(0xffffff))
    let window = geometry.size(100.0, 60.0)
    print("spacing")
    dump(cx.frame(spacing, window, 1.0))
    print("flex")
    dump(cx.frame(flex, window, 1.0))
    print("clipping")
    dump(cx.frame(clipping, window, 1.0))
    print("gradients")
    let wide = geometry.size(140.0, 20.0)
    shade(cx.frame(gradients, wide, 2.0))
    cx.dispatch(PointerMoved(130.0, 5.0))
    shade(cx.frame(gradients, wide, 1.0))
    let d = geometry.direction(45.0)
    let e = geometry.direction(-120.0)
    print("directions {d.x} {d.y} {e.x} {e.y}")
}
