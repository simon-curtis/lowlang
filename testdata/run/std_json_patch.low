import std/json
import std/json/patch
import std/json/pointer

fn parse(s: str) -> json.Value {
    json.parse(bytes(s)) or json.Value.Null
}

fn show(v: json.Value) -> str {
    json.stringify(v, 0)
}

fn problem(e: patch.Error) -> str {
    match e {
        Malformed(index, message) => "malformed operation {index}: {message}"
        Pointer(index, cause) => "operation {index} failed: {cause_text(cause)}"
        TestFailed(index, path) => "operation {index}: test failed at {path}"
    }
}

fn cause_text(e: pointer.Error) -> str {
    match e {
        Syntax(at, message) => "syntax error at {at}: {message}"
        NotFound(p) => "not found {p}"
        Mismatch(p) => "mismatch {p}"
        CannotRemoveRoot => "cannot remove the root"
    }
}

fn run(label: str, doc: str, ops: str) {
    let original = parse(doc)
    let out = patch.apply(original, parse(ops)) catch {
        e => {
            print("{label}: {problem(e)}; document {show(original)}")
            return
        }
    }
    print("{label}: {show(out)}")
}

fn round_trip(a: str, b: str) {
    let left = parse(a)
    let right = parse(b)
    let ops = patch.diff(left, right)
    let out = patch.apply(left, ops) catch {
        e => {
            print("diff {a} -> {b}: {problem(e)}")
            return
        }
    }
    print("diff {show(ops)} applies={json.equal(out, right)}")
}

fn merge(doc: str, change: str) {
    print("merge {doc} {change} -> {show(patch.merge_patch(parse(doc), parse(change)))}")
}

fn merge_round_trip(a: str, b: str) {
    let left = parse(a)
    let right = parse(b)
    let change = patch.merge_diff(left, right)
    let out = patch.merge_patch(left, change)
    print("merge_diff {show(change)} applies={json.equal(out, right)}")
}

fn main() {
    run("A.1", "{{\"foo\": \"bar\"}}", "[{{\"op\": \"add\", \"path\": \"/baz\", \"value\": \"qux\"}}]")
    run("A.2", "{{\"foo\": [\"bar\", \"baz\"]}}", "[{{\"op\": \"add\", \"path\": \"/foo/1\", \"value\": \"qux\"}}]")
    run("A.3", "{{\"baz\": \"qux\", \"foo\": \"bar\"}}", "[{{\"op\": \"remove\", \"path\": \"/baz\"}}]")
    run("A.4", "{{\"foo\": [\"bar\", \"qux\", \"baz\"]}}", "[{{\"op\": \"remove\", \"path\": \"/foo/1\"}}]")
    run("A.5", "{{\"baz\": \"qux\", \"foo\": \"bar\"}}", "[{{\"op\": \"replace\", \"path\": \"/baz\", \"value\": \"boo\"}}]")
    run("A.6", "{{\"foo\": {{\"bar\": \"baz\", \"waldo\": \"fred\"}}, \"qux\": {{\"corge\": \"grault\"}}}}", "[{{\"op\": \"move\", \"from\": \"/foo/waldo\", \"path\": \"/qux/thud\"}}]")
    run("A.7", "{{\"foo\": [\"all\", \"grass\", \"cows\", \"eat\"]}}", "[{{\"op\": \"move\", \"from\": \"/foo/1\", \"path\": \"/foo/3\"}}]")
    run("A.8", "{{\"baz\": \"qux\", \"foo\": [\"a\", 2, \"c\"]}}", "[{{\"op\": \"test\", \"path\": \"/baz\", \"value\": \"qux\"}}, {{\"op\": \"test\", \"path\": \"/foo/1\", \"value\": 2}}]")
    run("A.9", "{{\"baz\": \"qux\"}}", "[{{\"op\": \"test\", \"path\": \"/baz\", \"value\": \"bar\"}}]")
    run("A.10", "{{\"foo\": \"bar\"}}", "[{{\"op\": \"add\", \"path\": \"/child\", \"value\": {{\"grandchild\": {{}}}}}}]")
    run("A.11", "{{\"foo\": \"bar\"}}", "[{{\"op\": \"add\", \"path\": \"/baz\", \"value\": \"qux\", \"xyz\": 123}}]")
    run("A.12", "{{\"foo\": \"bar\"}}", "[{{\"op\": \"add\", \"path\": \"/baz/bat\", \"value\": \"qux\"}}]")
    run("A.14", "{{\"/\": 9, \"~1\": 10}}", "[{{\"op\": \"test\", \"path\": \"/~01\", \"value\": 10}}]")
    run("A.15", "{{\"/\": 9, \"~1\": 10}}", "[{{\"op\": \"test\", \"path\": \"/~01\", \"value\": \"10\"}}]")
    run("A.16", "{{\"foo\": [\"bar\"]}}", "[{{\"op\": \"add\", \"path\": \"/foo/-\", \"value\": [\"abc\", \"def\"]}}]")

    run("copy", "{{\"a\": {{\"b\": [1]}}}}", "[{{\"op\": \"copy\", \"from\": \"/a/b\", \"path\": \"/c\"}}]")
    run("copy then change", "{{\"a\": [1]}}", "[{{\"op\": \"copy\", \"from\": \"/a\", \"path\": \"/b\"}}, {{\"op\": \"add\", \"path\": \"/b/-\", \"value\": 2}}]")
    run("move same path", "{{\"a\": 1}}", "[{{\"op\": \"move\", \"from\": \"/a\", \"path\": \"/a\"}}]")
    run("move missing", "{{\"a\": 1}}", "[{{\"op\": \"move\", \"from\": \"/b\", \"path\": \"/a\"}}]")
    run("move into itself", "{{\"a\": {{\"b\": 1}}}}", "[{{\"op\": \"move\", \"from\": \"/a\", \"path\": \"/a/b\"}}]")
    run("replace root", "{{\"a\": 1}}", "[{{\"op\": \"replace\", \"path\": \"\", \"value\": [1]}}]")
    run("remove root", "{{\"a\": 1}}", "[{{\"op\": \"remove\", \"path\": \"\"}}]")
    run("replace missing", "{{\"a\": 1}}", "[{{\"op\": \"replace\", \"path\": \"/b\", \"value\": 1}}]")
    run("remove missing", "{{\"a\": 1}}", "[{{\"op\": \"remove\", \"path\": \"/b\"}}]")
    run("test number forms", "{{\"a\": 1}}", "[{{\"op\": \"test\", \"path\": \"/a\", \"value\": 1.0}}]")
    run("test objects", "{{\"a\": {{\"x\": 1, \"y\": [true, null]}}}}", "[{{\"op\": \"test\", \"path\": \"/a\", \"value\": {{\"y\": [true, null], \"x\": 1}}}}]")
    run("test missing", "{{\"a\": 1}}", "[{{\"op\": \"test\", \"path\": \"/b\", \"value\": null}}]")
    run("empty patch", "{{\"a\": 1}}", "[]")

    run("atomic failure", "{{\"a\": 1}}", "[{{\"op\": \"add\", \"path\": \"/b\", \"value\": 2}}, {{\"op\": \"remove\", \"path\": \"/a\"}}, {{\"op\": \"test\", \"path\": \"/b\", \"value\": 3}}, {{\"op\": \"add\", \"path\": \"/c\", \"value\": 1}}]")
    run("atomic pointer failure", "[1, 2]", "[{{\"op\": \"add\", \"path\": \"/0\", \"value\": 0}}, {{\"op\": \"remove\", \"path\": \"/9\"}}]")
    run("unknown operation", "{{}}", "[{{\"op\": \"incr\", \"path\": \"/a\"}}]")
    run("missing value", "{{}}", "[{{\"op\": \"add\", \"path\": \"/a\"}}]")
    run("missing path", "{{}}", "[{{\"op\": \"remove\"}}]")
    run("missing op", "{{}}", "[{{\"path\": \"/a\"}}]")
    run("op not text", "{{}}", "[{{\"op\": 1, \"path\": \"/a\"}}]")
    run("operation not object", "{{}}", "[1]")
    run("patch not array", "{{}}", "{{\"op\": \"add\"}}")
    run("bad pointer", "{{}}", "[{{\"op\": \"add\", \"path\": \"a\", \"value\": 1}}]")

    let original = parse("{{\"a\": [1, 2], \"b\": {{\"c\": 3}}}}")
    let changed = patch.apply(original, parse("[{{\"op\": \"add\", \"path\": \"/a/0\", \"value\": 0}}, {{\"op\": \"remove\", \"path\": \"/b/c\"}}]")) or return
    print("{show(original)} {show(changed)}")

    round_trip("{{\"a\": 1, \"b\": 2}}", "{{\"a\": 1, \"b\": 2}}")
    round_trip("{{\"a\": 1, \"b\": 2}}", "{{\"a\": 2, \"c\": 3}}")
    round_trip("{{\"a\": {{\"x\": [1, 2, 3]}}}}", "{{\"a\": {{\"x\": [1, 5, 3, 4]}}}}")
    round_trip("[1, 2, 3, 4, 5]", "[1, 3]")
    round_trip("[1]", "[1, 2, 3]")
    round_trip("{{\"a/b\": 1, \"m~n\": 2}}", "{{\"a/b\": 2, \"m~n\": 3}}")
    round_trip("{{\"a\": [1]}}", "{{\"a\": {{\"b\": 1}}}}")
    round_trip("1", "\"one\"")
    round_trip("[]", "{{}}")
    round_trip("{{\"a\": null}}", "{{\"a\": 0}}")
    round_trip("[[1, 2], [3]]", "[[1], [3, 4], 5]")

    merge("{{\"a\": \"b\"}}", "{{\"a\": \"c\"}}")
    merge("{{\"a\": \"b\"}}", "{{\"b\": \"c\"}}")
    merge("{{\"a\": \"b\"}}", "{{\"a\": null}}")
    merge("{{\"a\": \"b\", \"b\": \"c\"}}", "{{\"a\": null}}")
    merge("{{\"a\": [\"b\"]}}", "{{\"a\": \"c\"}}")
    merge("{{\"a\": \"c\"}}", "{{\"a\": [\"b\"]}}")
    merge("{{\"a\": {{\"b\": \"c\"}}}}", "{{\"a\": {{\"b\": \"d\", \"c\": null}}}}")
    merge("{{\"a\": [{{\"b\": \"c\"}}]}}", "{{\"a\": [1]}}")
    merge("[\"a\", \"b\"]", "[\"c\", \"d\"]")
    merge("{{\"a\": \"b\"}}", "[\"c\"]")
    merge("{{\"a\": \"foo\"}}", "null")
    merge("{{\"a\": \"foo\"}}", "\"bar\"")
    merge("{{\"e\": null}}", "{{\"a\": 1}}")
    merge("[1, 2]", "{{\"a\": \"b\", \"c\": null}}")
    merge("{{}}", "{{\"a\": {{\"bb\": {{\"ccc\": null}}}}}}")

    merge_round_trip("{{\"a\": 1, \"b\": 2}}", "{{\"a\": 1, \"b\": 2}}")
    merge_round_trip("{{\"a\": 1, \"b\": 2}}", "{{\"a\": 3, \"c\": 4}}")
    merge_round_trip("{{\"a\": {{\"x\": 1, \"y\": 2}}}}", "{{\"a\": {{\"x\": 1, \"y\": 3}}, \"b\": [1]}}")
    merge_round_trip("{{\"a\": [1, 2]}}", "{{\"a\": [1]}}")
    merge_round_trip("[1]", "{{\"a\": 1}}")
    merge_round_trip("{{\"a\": {{\"b\": 1}}}}", "[]")
}
