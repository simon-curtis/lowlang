import std/fs
import std/io
import std/os
import std/slices
import std/strings
import std/time

fn run(dir: str) ! fs.FsError {
    let path = "{dir}/note.txt"
    fs.write_file(path, "first\n")?
    fs.append_file(path, "second\n")?
    print(fs.read_file(path)? |> strings.lines() |> strings.join(","))
    print(fs.exists(path))

    var big = strings.Builder {}
    for i in 0..20000 {
        big.write("line {i}\n")
    }
    fs.write_file("{dir}/big.txt", big.build())?
    print(fs.read_file("{dir}/big.txt")?.len)

    fs.make_dir("{dir}/sub")?
    var names = fs.list_dir(dir)?
    names |> slices.sort()
    print(names |> strings.join(" "))
    fs.rename_path("{dir}/big.txt", "{dir}/sub/big.txt")?
    fs.remove_dir("{dir}/sub") catch {
        NotEmpty => print("not empty")
        _ => print("other")
    }
    fs.remove("{dir}/sub/big.txt")?
    fs.remove_dir("{dir}/sub")?
    fs.remove(path)?
    let gone = fs.read_file(path) catch {
        NotFound => "not found"
        _ => "other"
    }
    print(gone)
}

fn main() {
    let start = time.now()
    let dir = "/tmp/low-std-system-{os.pid()}"
    fs.make_dir(dir) catch {
        _ => print("cannot make {dir}")
    }
    run(dir) catch {
        _ => print("failed")
    }
    fs.remove_dir(dir) catch {
        _ => print("cannot remove {dir}")
    }

    print(os.env("LOW_STD_MISSING") ?? "missing")
    os.set_env("LOW_STD_SET", "set")
    print(os.env("LOW_STD_SET") ?? "missing")
    os.unset_env("LOW_STD_SET")
    print(os.env("LOW_STD_SET") ?? "missing")
    print(os.args().len)

    var input = io.stdin()
    print(input.read_line() ?? "end of input")
    io.out("no newline ")
    io.out("until here\n")

    print(time.unix() > 1700000000)
    sleep(10)
    print(start.elapsed().millis() >= 10.0)
    io.err_line("to stderr")
    os.exit(3)
}
