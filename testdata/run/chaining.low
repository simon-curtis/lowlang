struct Op {
    apply: fn(i64) -> i64
}

struct Counter {
    count: i64
}

fn first(s: str) -> u8 {
    s[0]
}

fn shout(s: str, times: i64) -> str {
    var out = s
    for i in 1..times {
        out = "{out}{s}"
    }
    out
}

fn bump(mut c: Counter, by: i64) {
    c.count += by
}

fn count(c: Counter) -> i64 {
    c.count
}

fn biggest[T: Ord](a: T, b: T) -> T {
    if a > b {
        return a
    }
    b
}

fn apply(op: Op, v: i64) -> i64 {
    -1
}

fn main() {
    print("simon".first())
    print("ab".shout(3).first())
    print("ab".shout(3))

    var counter = Counter { count: 1 }
    counter.bump(4)
    counter.bump(5)
    print(counter.count())

    var xs: []i64 = []
    xs.push(7)
    xs.push(9)
    print(xs.len)

    print(3.biggest(8))
    print(16.0.sqrt())
    print(65.f64())

    let op = Op { apply: fn(v: i64) -> i64 { v * 2 } }
    print(op.apply(21))

    let twice = fn(v: i64) -> i64 { v * 2 }
    print(5.twice().twice())
}
