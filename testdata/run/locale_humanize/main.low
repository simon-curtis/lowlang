import std/locale
import std/locale/reltime
import std/text
import std/time/duration
import std/time/humanize
import std/time/timestamp

fn width_of(name: str) -> reltime.Width {
    match name {
        "short" => reltime.Width.Short
        "narrow" => reltime.Width.Narrow
        _ => reltime.Width.Long
    }
}

fn clean(s: str) -> str {
    text.replace(s, text.from_char(0x202f), " ")
}

fn main() {
    var checked = 0
    var failed = 0
    var current = ""
    var l = locale.root()
    for line in text.lines(embed("humanize.tsv")) {
        let f = text.split(line, '\t')
        if f.len != 4 {
            continue
        }
        if f[0] != current {
            current = f[0]
            l = locale.parse(current) or locale.root()
        }
        let d = duration.seconds(text.parse_int(f[2]) or 0)
        let got = clean(humanize.ago_in(l, d, width_of(f[1])) or "error")
        checked += 1
        if got != f[3] {
            failed += 1
            if failed <= 30 {
                print("{f[0]} {f[1]} {f[2]}: want {f[3]}, got {got}")
            }
        }
    }
    print("ago_in: {checked} checked, {failed} wrong")

    let en = locale.parse("en") or locale.root()
    let now = timestamp.from_unix(1700000000) or timestamp.epoch()
    let before = timestamp.from_unix(1700000000 - 7200) or timestamp.epoch()
    let after = timestamp.from_unix(1700000000 + 259200) or timestamp.epoch()
    print(humanize.relative_in(en, before, now, reltime.Width.Long) or "error")
    print(humanize.relative_in(en, after, now, reltime.Width.Long) or "error")
    print(humanize.relative_in(locale.parse("de") or locale.root(), before, now, reltime.Width.Short) or "error")
    print(humanize.relative(before, now))
}
