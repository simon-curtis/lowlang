fn append_pair(mut xs: []i64, a: i64, b: i64) {
    push(mut xs, a)
    push(mut xs, b)
}

fn clear(mut xs: []i64) {
    xs = []
}

fn mixed(n: i64) -> i64 {
    var xs: []i64 = []
    for i in 0..n {
        push(mut xs, i)
        if i % 4 == 0 {
            append_pair(mut xs, i * 10, i * 10 + 1)
        }
    }
    var total = xs.len
    for i in 0..xs.len {
        total += xs[i] * (i % 5 + 1)
    }
    total
}

fn restart(n: i64) -> i64 {
    var xs: []i64 = []
    for i in 0..n {
        push(mut xs, i + 1)
    }
    clear(mut xs)
    for i in 0..3 {
        push(mut xs, i * 100)
    }
    xs.len * 1000 + xs[0] + xs[1] + xs[2]
}

fn only_after(n: i64) -> i64 {
    var xs: []i64 = []
    append_pair(mut xs, 7, 8)
    for i in 0..n {
        push(mut xs, i)
    }
    var total = 0
    for i in 0..xs.len {
        total += xs[i]
    }
    total + xs.len
}

fn both(n: i64) -> i64 {
    var left: []i64 = []
    var right: []i64 = []
    for i in 0..n {
        push(mut left, i)
        push(mut right, n - i)
    }
    append_pair(mut right, 1, 2)
    var total = 0
    for i in 0..left.len {
        total += left[i] * right[i]
    }
    total + right.len
}

fn main() {
    print(mixed(37))
    print(restart(50))
    print(only_after(25))
    print(both(30))
}
