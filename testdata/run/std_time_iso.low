import std/io
import std/time

fn describe(p: time.Parsed) -> str {
    match p {
        Naive(dt) => "naive {time.format_datetime(dt)} ns {dt.nanosecond}"
        Aware(i) => "aware {time.format_instant(i)} offset {i.offset} unix {time.timestamp(i)} ns {i.local.nanosecond}"
    }
}

fn main() ! io.Error {
    let dates = ["2024-03-01", "2000-02-29", "0001-01-01", "9999-12-31", "1969-07-20", "2100-02-29", "2023-02-29", "2024-3-01", "24-03-01", "2024-03-01T00:00", "2024/03/01", "2024-03-01 ", "", "2024-00-10", "2024-12-32", "+2024-03-01"]
    for s in dates {
        let d = time.parse_date(s) catch {
            _ => {
                print("date '{s}' rejected")
                continue
            }
        }
        print("date '{s}' {time.format_date(d)} ordinal {time.ordinal(d)}")
    }
    let stamps = [
        "2024-03-01T19:45:12.1234567Z", "2025-11-10T19:45", "2025-11-10T19:45:30", "2025-11-10T19:45:30+05:30",
        "2025-11-10 19:45:30.5-08:00", "2025-11-10t07:05:09z", "1969-12-31T23:59:59.999999999999Z",
        "1970-01-01T00:00:00+00:00", "1970-01-01T00:00:00-00:00", "2024-02-29T23:59:59.000001+23:59",
        "1900-01-01T00:00Z", "2024-03-01T19:45Z", "2024-03-01T19:45:12.100", "2024-03-01T24:00",
        "2024-03-01T23:60", "2024-03-01T23:59:60", "2024-03-01T19:45:", "2024-03-01T19:45:12.",
        "2024-03-01T19:45.5", "2024-03-01T19:45:12+0100", "2024-03-01T19:45:12+01", "2024-03-01T19:45:12+24:00",
        "2024-03-01T19:45:12+01:60", "2024-03-01T19:45:12Zx", "2024-03-01", "2024-03-01T9:45", "2024-03-01X19:45",
        "2023-02-29T00:00", "2024-03-01T19:45:12.123 ",
    ]
    for s in stamps {
        let p = time.parse_datetime(s) catch {
            _ => {
                print("datetime '{s}' rejected")
                continue
            }
        }
        print("datetime '{s}' {describe(p)}")
    }
    let past = time.Date { year: -44, month: 3, day: 15 }
    let early = time.Date { year: 5, month: 6, day: 7 }
    print("{time.format_date(past)} {time.format_date(early)}")
    let lmt = time.at_offset(-2717650800, -17762)
    print(time.format_instant(lmt))
    print(time.format_instant(time.at_offset(1762803900, 19800)))
    print(time.format_datetime(time.DateTime { date: early, hour: 1, nanosecond: 50000000 }))
}
