struct Row {
    a: i64 = 0
    b: i64 = 0
    c: i64 = 0
    d: i64 = 0
    e: i64 = 0
    f: i64 = 0
    g: i64 = 0
    h: i64 = 0
    i: i64 = 0
    j: i64 = 0
    k: i64 = 0
    l: i64 = 0
    m: i64 = 0
    n: i64 = 0
    o: i64 = 0
    p: i64 = 0
}

struct Big {
    r0: Row = Row {}
    r1: Row = Row {}
    r2: Row = Row {}
    r3: Row = Row {}
    r4: Row = Row {}
    r5: Row = Row {}
    r6: Row = Row {}
    r7: Row = Row {}
    name: str = ""
    tag: i64 = 0
}

extern struct Tint {
    r: f32
    g: f32
    b: f32
    a: f32
}

struct Painted {
    big: Big
    tint: Tint
}

enum Fault {
    Negative
}

enum Held {
    Nothing
    Some(Big)
}

struct Holder {
    big: Big
    count: i64
}

fn sum_row(r: Row) -> i64 {
    r.a + r.b + r.c + r.d + r.e + r.f + r.g + r.h + r.i + r.j + r.k + r.l + r.m + r.n + r.o + r.p
}

fn total(b: Big) -> i64 {
    sum_row(b.r0) + sum_row(b.r1) + sum_row(b.r2) + sum_row(b.r3) + sum_row(b.r4) + sum_row(b.r5) + sum_row(b.r6) + sum_row(b.r7) + b.tag
}

fn filled(seed: i64, name: str) -> Big {
    var b = Big { name, tag: seed }
    b.r0.a = seed
    b.r3.h = seed * 2
    b.r7.p = seed * 3
    b
}

fn retagged(b: Big, tag: i64) -> Big {
    var out = b
    out.tag = tag
    out
}

fn renamed(b: Big, name: str) -> Big {
    var out = b
    out.name = name
    retagged(out, b.tag + 1)
}

fn forwarded(b: Big) -> Big {
    retagged(b, b.tag)
}

fn nested(b: Big) -> Big {
    forwarded(forwarded(renamed(b, "{b.name}!")))
}

fn second_row(b: Big) -> Row {
    b.r1
}

fn checked(b: Big) -> Big ! Fault {
    if b.tag < 0 {
        fail Negative
    }
    retagged(b, b.tag * 10)
}

fn maybe(b: Big, keep: bool) -> Big? {
    if keep {
        return b
    }
    none
}

fn swap_rows(b: Big) -> Big {
    var out = b
    out.r0 = b.r7
    out.r7 = b.r0
    out
}

fn depth(b: Big, n: i64) -> i64 {
    if n == 0 {
        return total(b)
    }
    depth(retagged(b, b.tag + 1), n - 1)
}

fn apply(b: Big, f: fn(Big) -> Big) -> Big {
    f(b)
}

fn first[T](xs: T[]) -> T {
    xs[0]
}

fn worker(b: Big, out: chan[i64]) {
    out <- total(b)
}

fn painter(p: Painted, label: str) -> fn() -> str {
    fn() -> str { "{label} {p.tint.g} {p.big.name} {total(p.big)}" }
}

fn painter_of(seed: i64, n: i64) -> fn() -> str {
    if n > 0 {
        return painter_of(seed, n - 1)
    }
    painter(Painted { big: filled(seed, "paint"), tint: Tint { r: 0.5, g: 0.25, b: 1.0, a: 1.0 } }, "late")
}

fn tinted(p: Painted, tint: Tint) -> Painted {
    var next = p
    next.tint = tint
    next
}

fn snapshot(from: *Big, into: *Big) -> Big {
    let old = *from
    into.tag = 99
    into.r0.a = 7
    old
}

fn grown(b: Big) -> Big {
    let row = b.r1
    var out = b
    out.r1.a = row.a + 1
    out.tag = row.a
    out
}

fn describe(b: Big) -> str {
    "{b.name} {b.tag} {b.r0.a} {b.r3.h} {b.r7.p} {total(b)}"
}

fn main() {
    let base = filled(5, "base")
    print(describe(base))
    print(describe(retagged(base, 9)))
    print(describe(nested(base)))
    print("{sum_row(second_row(retagged(base, 1)))} {total(swap_rows(base))} {swap_rows(base).r0.p}")
    let good = checked(base) catch {
        e => filled(0, "fault")
    }
    print(describe(good))
    let bad = checked(retagged(base, -1)) catch {
        e => filled(0, "fault")
    }
    print(describe(bad))
    match maybe(base, true) {
        some(b) => print("kept {b.name}")
        none => print("dropped")
    }
    print("{maybe(base, false) == none}")
    print("{depth(base, 50)}")
    let bump = 4
    let closure = fn(b: Big) -> Big { retagged(b, b.tag + bump) }
    print(describe(apply(base, closure)))
    print(describe(apply(base, forwarded)))
    var list: Big[] = []
    for i in 0..4 {
        list.push(filled(i, "item{i}"))
    }
    var acc = 0
    for b in list {
        acc += total(b)
    }
    print("{acc} {describe(first(list))}")
    let held = Held.Some(base)
    match held {
        Some(b) => print("held {b.name}")
        Nothing => print("nothing")
    }
    let holder = Holder { big: nested(base), count: 2 }
    print("{holder.big.name} {holder.count}")
    let names: [str: Big] = [:]
    names["x"] = retagged(base, 77)
    let found = names["x"] ?? base
    print(describe(found))
    let later = fn() -> i64 { total(base) + bump }
    print("{later()}")
    let out = chan[i64](1)
    spawn worker(nested(base), out)
    print("{(<-out) ?? -1}")
    var cur = base
    for i in 0..10 {
        cur = retagged(cur, cur.tag + i)
    }
    print(describe(cur))
    print("{base == retagged(base, base.tag)} {base == retagged(base, 0)}")
    let shown = painter_of(3, 2)
    print("{depth(base, 50)}")
    print(shown())
    let painted = tinted(Painted { big: filled(6, "tint"), tint: Tint { r: 0.0, g: 0.0, b: 0.0, a: 0.0 } }, Tint { r: 0.5, g: 0.75, b: 0.25, a: 1.0 })
    print("{painted.tint.g} {describe(painted.big)}")
    let shared = new(filled(2, "shared"))
    let old = snapshot(shared, shared)
    print("{describe(old)} {describe(*shared)}")
    var step = grown(base)
    for _ in 0..3 {
        step = grown(step)
    }
    print(describe(step))
}
