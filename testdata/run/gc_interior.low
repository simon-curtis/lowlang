struct View {
    s: []u8
}

fn main() {
    var data: []u8 = []
    for i in 0..32000000 {
        push(mut data, 'a')
    }
    var views: []*View = []
    var i = 0
    for i + 16 < data.len {
        push(mut views, new(View { s: data[i..i + 8] }))
        i += 50
    }
    var total = 0
    for v in views {
        total += v.s.len
    }
    print("{views.len} {total}")
}
