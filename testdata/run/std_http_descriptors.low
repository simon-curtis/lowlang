import std/file
import std/http
import std/http/websocket
import std/io
import std/net

fn handle(req: http.Request) -> http.Response {
    if req.path == "/ws" {
        using ws = websocket.accept(req) or return http.response(400, "")
        for {
            let m = websocket.receive(ws) or break
            websocket.send_text(ws, "echo: {str(m.data)}") or break
        }
        return http.upgraded()
    }
    http.response(200, "hello")
}

fn serve(l: net.ListenerHandle) {
    http.serve_on(l, handle) or {}
}

fn open_fds() -> i64 {
    let names = file.list("/proc/self/fd") or []
    names.len
}

fn dropped(url: str) ! io.Error {
    for i in 0..5 {
        using ws = websocket.dial(url)?
        websocket.send_text(ws, "n{i}")?
        let m = websocket.receive(ws)?
        print(str(m.data))
    }
}

fn connection(u: http.Url) ! io.Error {
    using c = http.connect(u, [])?
    let s = c.stream
    io.write_str(s, "GET /plain HTTP/1.1\r\nhost: x\r\nconnection: close\r\n\r\n")?
    let status = io.read_line(io.reader(s))?
    print(status)
    s.close()
}

fn handed_over(u: http.Url) -> io.Stream ! io.Error {
    using var c = http.connect(u, [])?
    http.detach(mut c)
}

fn detached(u: http.Url) ! io.Error {
    let s = handed_over(u)?
    io.write_str(s, "GET /plain HTTP/1.1\r\nhost: x\r\nconnection: close\r\n\r\n")?
    print("detached {io.read_line(io.reader(s))?}")
    s.close()
}

fn main() ! io.Error {
    using l = net.listen("127.0.0.1", 0)?
    spawn serve(l.handle)
    let port = l.handle.addr.port
    let url = "ws://127.0.0.1:{port}/ws"
    dropped(url)?
    sleep(100)
    let before = open_fds()
    dropped(url)?
    let u = http.parse_url("http://127.0.0.1:{port}/plain")?
    connection(u)?
    detached(u)?
    sleep(100)
    print("descriptors released: {open_fds() == before}")
}
