import std/uri

fn shown(s: str?) -> str {
    match s {
        some(v) => "[{v}]"
        none => "none"
    }
}

fn dots(c: u8) -> bool {
    c == '.'
}

fn main() {
    print(uri.escape("a b&c=d/é~-._"))
    print(uri.escape_form("a b&c=d/é~"))
    print(uri.escape_target("/a b/ü?x={{y}}&z=%41"))
    print(uri.escape_where("a.b.c d", dots))
    print(uri.escape("plain") == "plain")

    print(shown(uri.unescape("a%20b%2Fc+d")))
    print(shown(uri.unescape("%4")))
    print(shown(uri.unescape("%zz")))
    print(shown(uri.unescape("100%")))
    print(uri.unescape_lossy("a+b%20c%zz%4"))
    print(uri.unescape_form_lossy("a+b%20c%zz%4"))

    print(uri.encode_form([uri.Field { name: "a b", value: "x&y" }, uri.Field { name: "c", value: "1+1" }]))
    print(uri.encode_form([]) == "")

    let q = uri.parse_query("a=1&b=x+y&c&&a=2&d=%C3%A9&e=%zz")
    for name in ["a", "b", "c", "d", "e", "f"] {
        print("{name} = {shown(q[name])}")
    }

    print(uri.scheme_end("https://x"))
    print(uri.scheme_end("a+b-c.d:rest"))
    print(uri.scheme_end("1a:b"))
    print(uri.scheme_end(":x"))
    print(uri.scheme_end("/a:b"))
    print(uri.without_fragment("a#b#c"))
    print(uri.without_fragment("abc"))

    for path in ["/a/b/c/./../../g", "mid/content=5/../6", "/a/b/..", "/a/./", "/../x", "a/../../b"] {
        print("{path} -> {uri.remove_dots(path)}")
    }

    let base = "http://a/b/c/d;p?q"
    for r in ["g:h", "g", "./g", "g/", "/g", "//g", "?y", "g?y", "#s", "g#s", "g?y#s", ";x", "g;x", "", ".", "./", "..", "../", "../g", "../..", "../../", "../../g", "../../../g", "/./g", "/../g", "g.", ".g", "g..", "..g", "./../g", "g/./h", "g/../h", "g;x=1/./y", "g;x=1/../y"] {
        print("{r} -> {uri.resolve(base, r)}")
    }
    print(uri.resolve("http://example.com", "x"))
    print(uri.resolve("/a/b?c#d", "../e"))
    print(uri.resolve("urn:example:a", "#frag"))
}
