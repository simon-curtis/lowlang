        Column { name: "x", info: [0xF1, 0], value: joined([number(10, 8), sized(joined([[0xFF, 0xFE], wide("<a/>")]), 4), number(0, 4)]) },
        Column { name: "tx", info: joined([[0x23], number(0x7FFFFFFF, 4), cp1252(), table_name(["t"])]), value: text_pointer([0x6C, 0xE9, 0x67]) },
        Column { name: "nt", info: joined([[0x63], number(0x7FFFFFFE, 4), cp1252(), table_name(["dbo", "t"])]), value: text_pointer(wide("ok")) },
        Column { name: "im", info: joined([[0x22], number(0x7FFFFFFF, 4), table_name([])]), value: text_pointer([0x0A, 0x0B]) },
