        Column { name: "sv3", info: joined([[0x62], number(8016, 4)]), value: joined([number(9, 4), [0x6A, 2, 5, 2], [1, 0x7D, 0, 0, 0]]) },
        Column { name: "u", info: joined([[0xF0, 0x7C, 0x03, 0], [3], wide("sys"), [11], wide("hierarchyid"), [1, 0], wide("x")]), value: joined([number(2, 8), sized([0x5A, 0xC0], 4), number(0, 4)]) },
        Column { name: "nul", info: [0x1F], value: [] },
    ]
}

fn metadata(mut b: []u8, cols: []Column) {
    push(mut b, 0x81)
    le(mut b, cols.len, 2)
    for c in cols {
        le(mut b, 0, 4)
        le(mut b, 9, 2)
        io.append(mut b, c.info)
        b_varchar(mut b, c.name)
    }
}

fn row(mut b: []u8, cols: []Column) {
    push(mut b, 0xD1)
    for c in cols {
        io.append(mut b, c.value)
    }
}

fn null_row(mut b: []u8, n: i64) {
    push(mut b, 0xD2)
    for _ in 0..(n + 7) / 8 {
        push(mut b, 0xFF)
    }
}

fn nullable() -> []Column {
    [
        Column { name: "in", info: [0x26, 8], value: [0] },
        Column { name: "dec", info: [0x6A, 17, 38, 2], value: [0] },
        Column { name: "d", info: [0x28], value: [0] },
        Column { name: "nv", info: joined([[0xE7, 40, 0], cp1252()]), value: [0xFF, 0xFF] },
        Column { name: "nm", info: joined([[0xE7, 0xFF, 0xFF], cp1252()]), value: number(-1, 8) },
        Column { name: "tx", info: joined([[0x23], number(0x7FFFFFFF, 4), cp1252(), table_name(["t"])]), value: [0] },
        Column { name: "sv", info: joined([[0x62], number(8016, 4)]), value: number(0, 4) },
        Column { name: "x", info: [0xF1, 1, 0, 3, 'd', 0, 'b', 0, 'o', 0, 1, 0, 's', 0], value: number(-1, 8) },
    ]
}

fn int_column(name: str) -> []Column {
    [Column { name, info: [0x7F], value: [] }]
}

fn int_row(mut b: []u8, v: i64) {
    push(mut b, 0xD1)
    le(mut b, v, 8)
}

fn show(v: sql.Value) -> str {
    match v {
        Null => "NULL"
        Bool(b) => "Bool({b})"
        Int(n) => "Int({n})"
        Float(x) => "Float({x})"
        Decimal(d) => "Decimal({d})"
        Text(s) => "Text({s})"
        Bytes(b) => "Bytes({text.encode_hex(b)})"
        Uuid(b) => "Uuid({text.encode_hex(b)})"
        Date(d) => "Date({d})"
        Time(t) => "Time({t})"
        Timestamp(t) => "Timestamp({t})"
        TimestampTz(t) => "TimestampTz({t})"
    }
}

fn attempt(work: fn() ! sql.Error) -> str {
    work() catch {
        Connect => return "Connect"
        Authentication => return "Authentication"
        Closed => return "Closed"
        Timeout => return "Timeout"
        Protocol => return "Protocol"
        Unsupported => return "Unsupported"
        Conversion => return "Conversion"
        Busy => return "Busy"
        Server(code, message) => return "Server({code}, {message})"
    }
    "ok"
}

fn utf16_text(data: []u8) -> str {
    var out: []u8 = []
    var i = 0
    for i + 1 < data.len {
        let c = i64(data[i]) | i64(data[i + 1]) << 8
        i += 2
        if c >= 0xD800 && c < 0xDC00 {
            let low = i64(data[i]) | i64(data[i + 1]) << 8
            i += 2
            let v = 0x10000 + ((c - 0xD800) << 10) + (low - 0xDC00)
            push(mut out, u8(0xF0 | v >> 18))
            push(mut out, u8(0x80 | v >> 12 & 0x3F))
            push(mut out, u8(0x80 | v >> 6 & 0x3F))
            push(mut out, u8(0x80 | v & 0x3F))
        } else if c >= 0x800 {
            push(mut out, u8(0xE0 | c >> 12))
            push(mut out, u8(0x80 | c >> 6 & 0x3F))
            push(mut out, u8(0x80 | c & 0x3F))
        } else if c >= 0x80 {
            push(mut out, u8(0xC0 | c >> 6))
            push(mut out, u8(0x80 | c & 0x3F))
        } else {
            push(mut out, u8(c))
        }
    }
    str(out)
}

struct Cursor {
    data: []u8
    at: i64
}

fn next(mut c: Cursor, n: i64) -> []u8 {
    let out = c.data[c.at..c.at + n]
    c.at += n
    out
}

fn field(data: []u8, at: i64) -> str {
    let offset = io.le16(data, at)
    let count = io.le16(data, at + 2)
    utf16_text(data[offset..offset + 2 * count])
}

fn password(data: []u8, at: i64) -> str {
    let offset = io.le16(data, at)
    let count = io.le16(data, at + 2)
    let plain: []u8 = io.buffer(2 * count)
    for i in 0..2 * count {
        let b = data[offset + i] ^ 0xA5
        plain[i] = b << 4 | b >> 4
    }
    utf16_text(plain)
}

fn login_text(data: []u8) -> str {
    let extension = io.le32(data, io.le16(data, 56))
    let features = text.encode_hex(data[extension..])
    "login packet={io.le32(data, 8)} flags={text.encode_hex(data[24..28])} user={field(data, 40)} password={password(data, 44)} app={field(data, 48)} server={field(data, 52)} library={field(data, 60)} database={field(data, 68)} features={features}"
}

fn plain_value(mut c: Cursor, id: u8) -> str {
    if id == 0xE7 || id == 0xA5 {
        let max = io.le16(next(mut c, 2), 0)
        if id == 0xE7 {
            next(mut c, 5)
        }
        if max == 0xFFFF {
            let total = io.le64(next(mut c, 8), 0)
            var data: []u8 = []
            for {
                let n = io.le32(next(mut c, 4), 0)
                if n == 0 {
                    break
                }
                io.append(mut data, next(mut c, n))
            }
            let shown = if id == 0xE7 { utf16_text(data) } else { text.encode_hex(data) }
            return "max {total} {shown}"
        }
        let n = io.le16(next(mut c, 2), 0)
        if n == 0xFFFF {
            return "{max} null"
        }
        let data = next(mut c, n)
        let shown = if id == 0xE7 { utf16_text(data) } else { text.encode_hex(data) }
        return "{max} {shown}"
    }
    var head: []u8 = []
    if id == 0x6A {
        head = next(mut c, 3)
    } else if id == 0x29 || id == 0x2A || id == 0x2B || id == 0x26 || id == 0x68 || id == 0x6D || id == 0x24 {
        head = next(mut c, 1)
    }
    let n = i64(next(mut c, 1)[0])
    "{text.encode_hex(head)} {text.encode_hex(next(mut c, n))}"
}

fn rpc_text(data: []u8) -> str {
    var c = Cursor { data, at: 22 }
    let proc = io.le16(next(mut c, 4), 2)
    next(mut c, 2)
    var parts: []str = ["rpc tx={text.encode_hex(data[10..18])} proc={proc}"]
    for c.at < data.len {
        let name_units = i64(next(mut c, 1)[0])
        let name = utf16_text(next(mut c, 2 * name_units))
        next(mut c, 1)
        let id = next(mut c, 1)[0]
        push(mut parts, "{name}:{text.hex(i64(id))} {plain_value(mut c, id)}")
    }
    text.join(parts, "\n    ")
}

fn request_text(kind: u8, data: []u8) -> str {
    if kind == 0x12 {
        return "prelogin encrypt={data[data.len - 6]}"
    }
    if kind == 0x10 {
        return login_text(data)
    }
    if kind == 0x01 {
        return "batch tx={text.encode_hex(data[10..18])} {utf16_text(data[22..])}"
    }
    if kind == 0x03 {
        return rpc_text(data)
    }
    if kind == 0x0E {
        let request = io.le16(data, 22)
        let name = if request == 5 { "begin" } else if request == 7 { "commit" } else { "rollback" }
        return "transaction {name} tx={text.encode_hex(data[10..18])} {text.encode_hex(data[24..])}"
    }
    if kind == 0x06 {
        return "attention"
    }
    "unknown {kind}"
}

fn transcript(out: []u8) {
    var at = 0
    var data: []u8 = []
    var packets = 0
    for at < out.len {
        let kind = out[at]
        let length = io.be16(out, at + 2)
        io.append(mut data, out[at + 8..at + length])
        packets += 1
        if out[at + 1] & 1 == 1 {
            let suffix = if packets > 1 { " ({packets} packets)" } else { "" }
            print("> {request_text(kind, data)}{suffix}")
            data = []
            packets = 0
        }
        at += length
    }
}

fn opened(f: *Fake) -> sql.Connection ! sql.Error {
    sqlserver.connect_stream(fake_stream(f), sql.Options { host: "db.example", user: "alice", password: "sécret", database: "shop" })
}

fn script() -> []u8 {
    var b: []u8 = []
    prelogin_reply(mut b, 2)
    login_reply(mut b)

    let all = columns()
    var t: []u8 = []
    metadata(mut t, all)
    row(mut t, all)
    null_row(mut t, all.len)
    done(mut t, 0xFF, 0x11, 2)
    push(mut t, 0x79)
    le(mut t, 0, 4)
    done(mut t, 0xFE, 0, 0)
    message(mut b, t)

    t = []
    let nulls = nullable()
    metadata(mut t, nulls)
    row(mut t, nulls)
    done(mut t, 0xFD, 0x10, 1)
    message(mut b, t)

    t = []
    server_message(mut t, 0xAB, 0, 0, "just a notice")
    server_message(mut t, 0xAA, 208, 16, "Invalid object name 'nope'.")
    server_message(mut t, 0xAA, 8180, 16, "Statement(s) could not be prepared.")
    done(mut t, 0xFD, 0x02, 0)
    message(mut b, t)

    t = []
    done(mut t, 0xFD, 0x11, 3)
    done(mut t, 0xFF, 0x11, 2)
    done(mut t, 0xFE, 0x10, 5)
    push(mut t, 0xA9)
    le(mut t, 2, 2)
    le(mut t, 1, 2)
    push(mut t, 0xAC)
    le(mut t, 1, 2)
    b_varchar(mut t, "@out")
    push(mut t, 1)
    le(mut t, 0, 4)
    le(mut t, 9, 2)
    io.append(mut t, [0x26, 4, 4, 7, 0, 0, 0])
    done(mut t, 0xFD, 0x10, 0)
    message(mut b, t)

    t = []
    env_change(mut t, [8, 8, 1, 2, 3, 4, 5, 6, 7, 8, 0])
    done(mut t, 0xFD, 0, 0)
    message(mut b, t)
    t = []
    done(mut t, 0xFF, 0x11, 1)
    done(mut t, 0xFE, 0, 0)
    message(mut b, t)
    t = []
    env_change(mut t, [9, 0, 8, 1, 2, 3, 4, 5, 6, 7, 8])
    done(mut t, 0xFD, 0, 0)
    message(mut b, t)

    t = []
    metadata(mut t, int_column("g"))
    let first_rows = t.len + 18
    int_row(mut t, 1)
    int_row(mut t, 2)
    int_row(mut t, 3)
    done(mut t, 0xFD, 0x11, 3)
    message_cut(mut b, t, [first_rows])
    t = []
    done(mut t, 0xFD, 0x20, 0)
    message(mut b, t)

    t = []
    metadata(mut t, int_column("one"))
    int_row(mut t, 1)
    done(mut t, 0xFD, 0x10, 1)
    message(mut b, t)

    t = []
    metadata(mut t, int_column("g"))
    int_row(mut t, 1)
    int_row(mut t, 2)
    done(mut t, 0xFD, 0x11, 2)
    message(mut b, t)

    t = []
    let russian = [Column { name: "r", info: joined([[0xA7, 10, 0], cyrillic()]), value: [] }]
    metadata(mut t, russian)
    push(mut t, 0xD1)
    io.append(mut t, [2, 0, 'o', 'k'])
    push(mut t, 0xD1)
    io.append(mut t, [1, 0, 0xC0])
    done(mut t, 0xFD, 0x10, 2)
    message_cut(mut b, t, [])

    t = []
    metadata(mut t, int_column("two"))
    int_row(mut t, 2)
    done(mut t, 0xFD, 0x10, 1)
    message(mut b, t)

    t = []
    server_message(mut t, 0xAA, 50000, 20, "fatal")
    done(mut t, 0xFD, 0x102, 0)
    message(mut b, t)
    b
}

fn parameters() -> []sql.Value {
    [
        sql.Value.Null,
        sql.Value.Bool(true),
        sql.Value.Int(-5),
        sql.Value.Float(-0.25),
        sql.Value.Decimal("-12345.6789012345"),
        sql.Value.Decimal("0.0010"),
        sql.Value.Text("é😀"),
        sql.Value.Bytes([0, 255, 16]),
        sql.Value.Uuid([0x6f, 0x96, 0x19, 0xff, 0x8b, 0x86, 0xd0, 0x11, 0xb4, 0x2d, 0x00, 0xc0, 0x4f, 0xc9, 0x64, 0xff]),
        sql.Value.Date(-719162),
        sql.Value.Time(86399999999),
        sql.Value.Timestamp(-1),
        sql.Value.TimestampTz(1704144845500000),
    ]
}

fn session() ! sql.Error {
    let f = fake(script())
    using conn = opened(f)?
    let db = conn.handle
    let r = db.query("SELECT @p1, @p2, @p3, @p4, @p5, @p6, @p7, @p8, @p9, @p10, @p11, @p12, @p13", parameters())?
    for i, c in r.columns {
        print("{c.name} {c.kind} {show(r.rows[0][i])} {show(r.rows[1][i])}")
    }
    let n = db.query("SELECT nulls", [])?
    for i, c in n.columns {
        print("{c.name} {c.kind} {show(n.rows[0][i])}")
    }
    print("missing table {attempt(fn() ! sql.Error { db.execute("SELECT * FROM nope", [])? })}")
    print("counted {db.execute("UPDATE t SET x = 1", [])?}")
    db.begin()?
    db.execute("INSERT INTO t VALUES (@p1)", [sql.Value.Int(1)])?
    db.commit()?
    var seen: []str = []
    db.each("SELECT g FROM s", [], fn(cols, values) -> bool {
        push(mut seen, "{cols[0].name}={show(values[0])}")
        false
    })?
    print("stopped after {text.join(seen, " ")}")
    print("one {show(db.query("SELECT 1", [])?.rows[0][0])}")
    var inner = ""
    db.each("SELECT g FROM s", [], fn(cols, values) -> bool {
        inner = attempt(fn() ! sql.Error { db.query("SELECT 1", [])? })
        true
    })?
    print("nested call {inner}")
    print("cyrillic {attempt(fn() ! sql.Error { db.query("SELECT r", [])? })}")
    print("two {show(db.query("SELECT 2", [])?.rows[0][0])}")
    print("fatal {attempt(fn() ! sql.Error { db.execute("RAISERROR('fatal', 20, 1) WITH LOG", [])? })}")
    print("after fatal {attempt(fn() ! sql.Error { db.execute("SELECT 1", [])? })}")
    transcript(f.output)
}

fn large() ! sql.Error {
    var b: []u8 = []
    prelogin_reply(mut b, 2)
    login_reply(mut b)
    var t: []u8 = []
    done(mut t, 0xFD, 0x10, 1)
    message(mut b, t)
    let f = fake(b)
    using conn = opened(f)?
    let db = conn.handle
    var long_text: []u8 = []
    for _ in 0..2100 {
        text.append(mut long_text, "ab")
    }
    let blob = io.buffer(8001)
    db.execute("INSERT INTO t VALUES (@p1, @p2)", [sql.Value.Text(str(long_text)), sql.Value.Bytes(blob)])?
    let sent = f.output
    var at = 0
    var packets = 0
    var largest = 0
    for at < sent.len {
        let length = io.be16(sent, at + 2)
        if sent[at] == 0x03 {
            packets += 1
            if length > largest {
                largest = length
            }
        }
        at += length
    }
    print("large rpc packets {packets} largest {largest}")
}

fn handshake(label: str, input: []u8) {
    let f = fake(input)
    let outcome = attempt(fn() ! sql.Error {
        using conn = opened(f)?
        conn.handle.close()
    })
    print("{label} {outcome}")
}

fn handshakes() {
    var required: []u8 = []
    prelogin_reply(mut required, 3)
    handshake("encryption required", required)
    var malformed: []u8 = []
    message(mut malformed, [1, 0, 5])
    handshake("malformed prelogin", malformed)
    var refused: []u8 = []
    prelogin_reply(mut refused, 2)
    var t: []u8 = []
    server_message(mut t, 0xAA, 18456, 14, "Login failed for user 'alice'.")
    done(mut t, 0xFD, 0x02, 0)
    message(mut refused, t)
    handshake("refused", refused)
    var silent: []u8 = []
    prelogin_reply(mut silent, 2)
    t = []
    done(mut t, 0xFD, 0, 0)
    message(mut silent, t)
    handshake("no login ack", silent)
    var eof: []u8 = []
    prelogin_reply(mut eof, 2)
    handshake("eof", eof)
    var wrong_type: []u8 = []
    prelogin_reply(mut wrong_type, 2)
    io.append(mut wrong_type, [0x01, 1, 0, 9, 0, 0, 1, 0, 0xFD])
    handshake("wrong packet type", wrong_type)
    var huge: []u8 = []
    prelogin_reply(mut huge, 2)
    t = []
    push(mut t, 0x81)
    le(mut t, 1, 2)
    le(mut t, 0, 6)
    io.append(mut t, [0xA5, 0xFF, 0xFF])
    b_varchar(mut t, "x")
    push(mut t, 0xD1)
    le(mut t, 0x7FFFFFFFFFFFFFF0, 8)
    login_reply(mut huge)
    message(mut huge, t)
    twice("oversized value", huge)
    var unknown: []u8 = []
    prelogin_reply(mut unknown, 2)
    login_reply(mut unknown)
    t = []
    push(mut t, 0x81)
    le(mut t, 1, 2)
    le(mut t, 0, 6)
    io.append(mut t, [0x99])
    message(mut unknown, t)
    twice("unknown type", unknown)
    var token: []u8 = []
    prelogin_reply(mut token, 2)
    login_reply(mut token)
    message(mut token, [0x42])
    twice("unknown token", token)
}

fn twice(label: str, input: []u8) {
    let f = fake(input)
    using conn = opened(f) or {
        print("{label} did not connect")
        return
    }
    let db = conn.handle
    let first = attempt(fn() ! sql.Error { db.query("SELECT x", [])? })
    let then = attempt(fn() ! sql.Error { db.query("SELECT x", [])? })
    print("{label} {first} then {then}")
}

fn timeout() ! sql.Error {
    var b: []u8 = []
    prelogin_reply(mut b, 2)
    login_reply(mut b)
    let f = fake(b)
    f.stall = true
    using conn = sqlserver.connect_stream(fake_stream(f), sql.Options { user: "u", password: "p", timeout: 50 })?
    let db = conn.handle
    print("stalled {attempt(fn() ! sql.Error { db.execute("WAITFOR DELAY '00:00:05'", [])? })}")
    print("after timeout {attempt(fn() ! sql.Error { db.execute("SELECT 1", [])? })}")
    let sent = f.output
    var at = 0
    var kinds: []str = []
    for at < sent.len {
        push(mut kinds, text.hex(i64(sent[at])))
        at += io.be16(sent, at + 2)
    }
    print("timeout packets {text.join(kinds, " ")}")
}

fn closing_script() -> []u8 {
    var b: []u8 = []
    prelogin_reply(mut b, 0)
    login_reply(mut b)
    b
}

fn closed_operations(f: *Fake) ! sql.Error {
    using conn = opened(f)?
    let db = conn.handle
    conn.handle.close()
    db.close()
    print("query {attempt(fn() ! sql.Error { db.query("SELECT 1", [])? })}")
    print("query with values {attempt(fn() ! sql.Error { db.query("SELECT @p1", [sql.Value.Int(1)])? })}")
    print("execute {attempt(fn() ! sql.Error { db.execute("UPDATE t SET x = 1", [])? })}")
    print("each {attempt(fn() ! sql.Error { db.each("SELECT 1", [], fn(cols, values) -> bool { true })? })}")
    print("begin {attempt(fn() ! sql.Error { db.begin()? })}")
    print("commit {attempt(db.commit)}")
    print("rollback {attempt(db.rollback)}")
}

fn dropped(f: *Fake) ! sql.Error {
    using conn = opened(f)?
    print("open {f.closes}")
}

fn closing() ! sql.Error {
    let explicit = fake(closing_script())
    closed_operations(explicit)?
    print("explicit closed stream {explicit.closed} closes {explicit.closes}")
    let scoped = fake(closing_script())
    dropped(scoped)?
    print("scope exit closes {scoped.closes}")
}

fn main() ! sql.Error {
    session()?
    large()?
    handshakes()
    timeout()?
    closing()?
}
