import std/ui/geometry
import std/ui/layout

fn show(name: str, r: geometry.Rect) {
    print("{name} {r.x} {r.y} {r.width} {r.height}")
}

fn dump(t: layout.Tree, names: []str) {
    for i, name in names {
        show(name, layout.rect(t, i))
    }
}

fn win(w: f32, h: f32) -> geometry.Size {
    geometry.size(w, h)
}

fn wide(w: f32) -> layout.Style {
    layout.Style { width: Px(w) }
}

fn boxed(w: f32, h: f32) -> layout.Style {
    layout.Style { width: Px(w), height: Px(h) }
}

fn fixed(w: f32, h: f32) -> fn(f32) -> geometry.Size {
    fn(available: f32) -> geometry.Size { geometry.size(w, h) }
}

fn paragraph(width: f32) -> geometry.Size {
    if !layout.is_bounded(width) {
        return geometry.size(100.0, 10.0)
    }
    let columns = i64(width)
    let lines = (100 + columns - 1) / columns
    geometry.size(if width < 100.0 { width } else { 100.0 }, 10.0 * f32(lines))
}

fn content_sized() {
    for stretch in [false, true] {
        print("content sized parents, stretch {stretch}")
        var t = layout.tree()
        let l1 = t.leaf(layout.Style {}, fixed(20.0, 10.0))
        let l2 = t.leaf(layout.Style {}, fixed(30.0, 16.0))
        let inner = layout.Style { gap: 4.0, padding: geometry.edges(2.0), align_items: Start }
        let strip = t.node(inner, [l1, l2])
        let l3 = t.leaf(layout.Style {}, fixed(40.0, 12.0))
        let align = if stretch { layout.Align.Stretch } else { layout.Align.Start }
        let root = t.node(layout.Style { direction: Column, padding: geometry.edges(10.0), gap: 5.0, align_items: align }, [strip, l3])
        t.compute(root, win(300.0, layout.unbounded))
        dump(t, ["l1", "l2", "strip", "l3", "root"])
    }
}

fn wrapped(name: str, root_style: layout.Style, leaf_style: layout.Style, available: geometry.Size) {
    print(name)
    var t = layout.tree()
    let text = t.leaf(leaf_style, paragraph)
    let root = t.node(root_style, [text])
    t.compute(root, available)
    dump(t, ["text", "root"])
    show("text content", layout.content(t, text))
}

fn wrapping() {
    let column = layout.Style { direction: Column }
    wrapped("column stretch", column, layout.Style {}, win(60.0, layout.unbounded))
    wrapped("column stretch padded", layout.Style { direction: Column, padding: geometry.edges(5.0) }, layout.Style {}, win(40.0, layout.unbounded))
    wrapped("column start wide", layout.Style { direction: Column, align_items: Start }, layout.Style {}, win(200.0, layout.unbounded))
    wrapped("column start narrow", layout.Style { direction: Column, align_items: Start }, layout.Style {}, win(50.0, layout.unbounded))
    wrapped("row shrinks", layout.Style {}, layout.Style {}, win(70.0, layout.unbounded))
    wrapped("padded leaf", column, layout.Style { padding: geometry.edges(5.0) }, win(60.0, layout.unbounded))
    wrapped("column definite height", column, layout.Style {}, win(60.0, 100.0))

    print("row with a stiff sibling")
    var t = layout.tree()
    let text = t.leaf(layout.Style {}, paragraph)
    let side = t.node(layout.Style { width: Px(50.0), shrink: 0.0 }, [])
    let root = t.node(layout.Style {}, [text, side])
    t.compute(root, win(100.0, layout.unbounded))
    dump(t, ["text", "side", "root"])

    print("text in a nested column")
    var u = layout.tree()
    let words = u.leaf(layout.Style {}, paragraph)
    let panel = u.node(layout.Style { direction: Column, width: Px(60.0) }, [words])
    let gutter = u.node(wide(30.0), [])
    let top = u.node(layout.Style {}, [panel, gutter])
    u.compute(top, win(120.0, layout.unbounded))
    dump(u, ["words", "panel", "gutter", "top"])
}

fn floating_style(inset: layout.Inset, w: layout.Dimension, h: layout.Dimension) -> layout.Style {
    layout.Style { position: Absolute, inset, width: w, height: h }
}

fn absolutes() {
    print("absolute insets")
    var t = layout.tree()
    let a = t.node(floating_style(layout.Inset { left: Px(5.0), top: Px(7.0) }, Px(30.0), Px(20.0)), [])
    let b = t.node(floating_style(layout.Inset { right: Px(5.0), bottom: Px(5.0) }, Px(30.0), Px(20.0)), [])
    let c = t.node(floating_style(layout.Inset { left: Px(10.0), right: Px(10.0), top: Px(0.0) }, Auto, Px(15.0)), [])
    let d = t.node(floating_style(layout.Inset { left: Px(10.0), right: Px(10.0), top: Px(20.0) }, Px(50.0), Px(10.0)), [])
    let e = t.leaf(floating_style(layout.Inset { left: Px(4.0), top: Px(4.0) }, Auto, Auto), fixed(25.0, 6.0))
    let f = t.node(floating_style(layout.Inset {}, Px(30.0), Px(20.0)), [])
    let g = t.node(layout.Style { position: Absolute, inset: layout.Inset { left: Px(5.0), top: Px(0.0) }, margin: geometry.Edges { left: 3.0 }, width: Px(10.0), height: Px(10.0) }, [])
    let h = t.node(layout.Style { position: Absolute, inset: layout.Inset { left: Px(10.0), right: Px(10.0), top: Px(0.0) }, margin: geometry.Edges { left: 4.0, right: 6.0 }, height: Px(5.0) }, [])
    let i = t.node(floating_style(layout.Inset { top: Px(10.0), bottom: Px(10.0), left: Px(0.0) }, Px(5.0), Auto), [])
    let j = t.leaf(floating_style(layout.Inset { right: Px(0.0), bottom: Px(0.0) }, Auto, Auto), fixed(25.0, 6.0))
    let k = t.node(layout.Style { position: Absolute, inset: layout.Inset { left: Px(0.0), right: Px(0.0), top: Px(0.0) }, max_width: Px(100.0), height: Px(5.0) }, [])
    let root = t.node(layout.Style { padding: geometry.edges(10.0), border: geometry.edges(2.0) }, [a, b, c, d, e, f, g, h, i, j, k])
    t.compute(root, win(200.0, 100.0))
    dump(t, ["a", "b", "c", "d", "e", "f", "g", "h", "i", "j", "k", "root"])

    print("absolute percentages")
    var u = layout.tree()
    let p = u.node(floating_style(layout.Inset { left: Percent(10.0), top: Percent(50.0) }, Percent(50.0), Percent(25.0)), [])
    let top = u.node(layout.Style {}, [p])
    u.compute(top, win(200.0, 100.0))
    dump(u, ["p", "top"])

    print("absolute with children")
    var v = layout.tree()
    let kid = v.node(boxed(10.0, 10.0), [])
    let panel = v.node(layout.Style { position: Absolute, inset: layout.Inset { left: Px(10.0), top: Px(10.0) }, width: Px(40.0), height: Px(40.0), padding: geometry.edges(4.0) }, [kid])
    let frame = v.node(layout.Style { padding: geometry.edges(2.0) }, [panel])
    v.compute(frame, win(100.0, 100.0))
    dump(v, ["kid", "panel", "frame"])

    print("absolute leaves the flow")
    var w = layout.tree()
    let first = w.node(wide(30.0), [])
    let floating = w.node(floating_style(layout.Inset { left: Px(0.0) }, Px(50.0), Px(5.0)), [])
    let second = w.node(wide(30.0), [])
    let row = w.node(layout.Style { gap: 10.0 }, [first, floating, second])
    w.compute(row, win(100.0, 10.0))
    dump(w, ["first", "floating", "second", "row"])
}

fn resting(name: str, parent: layout.Style, child: layout.Style) {
    var t = layout.tree()
    let c = t.node(child, [])
    let root = t.node(parent, [c])
    t.compute(root, win(200.0, 100.0))
    show(name, layout.rect(t, c))
}

fn static_positions() {
    print("absolute without insets")
    let at = layout.Style { position: Absolute, width: Px(30.0), height: Px(20.0) }
    let frame = layout.Style { padding: geometry.edges(10.0), border: geometry.edges(2.0) }
    resting("start", frame, at)
    resting("center", layout.Style { padding: geometry.edges(10.0), border: geometry.edges(2.0), justify: Center, align_items: Center }, at)
    resting("end", layout.Style { padding: geometry.edges(10.0), border: geometry.edges(2.0), justify: End, align_items: End }, at)
    resting("column end center", layout.Style { direction: Column, padding: geometry.edges(10.0), border: geometry.edges(2.0), justify: End, align_items: Center }, at)
    resting("space around", layout.Style { padding: geometry.edges(10.0), border: geometry.edges(2.0), justify: SpaceAround }, at)
    resting("space between", layout.Style { padding: geometry.edges(10.0), border: geometry.edges(2.0), justify: SpaceBetween }, at)
    resting("align self", layout.Style { padding: geometry.edges(10.0), border: geometry.edges(2.0), align_items: Start }, layout.Style { position: Absolute, width: Px(30.0), height: Px(20.0), align_self: End })
    resting("margins", layout.Style { padding: geometry.edges(10.0), border: geometry.edges(2.0), justify: Center, align_items: Center }, layout.Style { position: Absolute, width: Px(30.0), height: Px(20.0), margin: geometry.Edges { left: 3.0, top: 4.0 } })
}

fn hidden() {
    print("display none in a row")
    var t = layout.tree()
    let a = t.node(wide(30.0), [])
    let kid = t.node(boxed(5.0, 5.0), [])
    let gone = t.node(layout.Style { display: None, width: Px(30.0), grow: 1.0 }, [kid])
    let c = t.node(wide(30.0), [])
    let root = t.node(layout.Style { gap: 10.0 }, [a, gone, c])
    t.compute(root, win(100.0, 10.0))
    dump(t, ["a", "kid", "gone", "c", "root"])

    print("display none and justify")
    var u = layout.tree()
    let d = u.node(wide(30.0), [])
    let hole = u.node(layout.Style { display: None, width: Px(30.0) }, [])
    let e = u.node(wide(30.0), [])
    let spread = u.node(layout.Style { justify: SpaceBetween }, [d, hole, e])
    u.compute(spread, win(100.0, 10.0))
    dump(u, ["d", "hole", "e", "spread"])

    print("display none absolute")
    var v = layout.tree()
    let f = v.node(layout.Style { display: None, position: Absolute, inset: layout.Inset { left: Px(5.0) }, width: Px(10.0), height: Px(10.0) }, [])
    let holder = v.node(layout.Style {}, [f])
    v.compute(holder, win(100.0, 50.0))
    dump(v, ["f", "holder"])

    print("display none root")
    var w = layout.tree()
    let g = w.node(boxed(10.0, 10.0), [])
    let off = w.node(layout.Style { display: None }, [g])
    w.compute(off, win(100.0, 50.0))
    dump(w, ["g", "off"])

    print("only hidden children")
    var x = layout.tree()
    let h = x.node(layout.Style { display: None, width: Px(10.0), height: Px(10.0) }, [])
    let outer = x.node(layout.Style { direction: Column, padding: geometry.edges(3.0) }, [h])
    x.compute(outer, win(100.0, layout.unbounded))
    dump(x, ["h", "outer"])
}

fn shell() {
    print("shell")
    var t = layout.tree()
    let header = t.node(layout.Style { height: Px(30.0) }, [])
    let sidebar = t.node(wide(80.0), [])
    let label = t.leaf(layout.Style { align_self: Start }, fixed(50.0, 10.0))
    let main = t.node(layout.Style { grow: 1.0, direction: Column, padding: geometry.edges(10.0) }, [label])
    let body = t.node(layout.Style { grow: 1.0 }, [sidebar, main])
    let footer = t.node(layout.Style { height: Px(20.0) }, [])
    let root = t.node(layout.Style { direction: Column }, [header, body, footer])
    t.compute(root, win(300.0, 200.0))
    dump(t, ["header", "sidebar", "label", "main", "body", "footer", "root"])
}

fn unknown_percent() {
    print("percent of an unknown height")
    var t = layout.tree()
    let text = t.leaf(layout.Style {}, fixed(10.0, 12.0))
    let half = t.node(layout.Style { height: Percent(50.0) }, [text])
    let root = t.node(layout.Style { direction: Column }, [half])
    t.compute(root, win(100.0, layout.unbounded))
    dump(t, ["text", "half", "root"])
    t.compute(root, win(100.0, 200.0))
    dump(t, ["text", "half", "root"])

    print("percent below an unknown height")
    var u = layout.tree()
    let item = u.leaf(layout.Style {}, fixed(10.0, 12.0))
    let inner = u.node(layout.Style { height: Percent(50.0) }, [item])
    let outer = u.node(layout.Style {}, [inner])
    let top = u.node(layout.Style { direction: Column }, [outer])
    u.compute(top, win(100.0, layout.unbounded))
    dump(u, ["item", "inner", "outer", "top"])
}

fn bounds() {
    print(layout.is_bounded(layout.unbounded))
    print(layout.is_bounded(1000000.0))
}

fn main() {
    content_sized()
    wrapping()
    absolutes()
    static_positions()
    hidden()
    shell()
    unknown_percent()
    bounds()
}
