import std/slices

fn main() {
    var xs: []i64 = []
    var seed = 12345
    for i in 0..5000 {
        seed = (seed * 1103515245 + 12345) % 2147483648
        push(mut xs, seed % 1000)
    }
    xs |> slices.sort()
    print(slices.sorted(xs))
    print("{xs[0]} {xs[xs.len - 1]}")

    var words = ["pear", "apple", "fig", "banana"]
    words |> slices.sort()
    print(words[0])
    words |> slices.sort_by(fn(a: str, b: str) -> bool { a.len < b.len })
    print(words[0])

    let doubled = [1, 2, 3] |> slices.map(fn(x: i64) -> i64 { x * 2 })
    print(slices.sum(doubled))
    print(slices.filter(doubled, fn(x: i64) -> bool { x > 2 }).len)
    print(slices.fold(["a", "b", "c"], "", fn(acc: str, x: str) -> str { "{acc}{x}" }))
    print(slices.any(doubled, fn(x: i64) -> bool { x == 4 }))
    print(slices.all(doubled, fn(x: i64) -> bool { x > 2 }))
    print(slices.max(xs) ?? -1)
    print(slices.min(words) ?? "none")
    print(slices.contains(words, "fig"))
    print(slices.index(words, "nope") ?? -1)
    print(slices.concat([1, 2], [3]).len)

    var ys = [1, 2, 3]
    ys |> slices.reverse()
    print(ys[0])
    let empty: []i64 = []
    print(slices.max(empty) ?? -1)
}
