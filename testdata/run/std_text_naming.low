import std/text
import std/text/naming

fn show(s: str) {
    let ws = text.join(naming.words(s), ",")
    print("[{s}] {ws} | {naming.snake(s)} | {naming.kebab(s)} | {naming.camel(s)} | {naming.pascal(s)} | {naming.screaming_snake(s)} | {naming.title(s)} | {naming.slug(s)}")
}

fn conversions() {
    let inputs = [
        "HTTPServerID2", "foo_bar-baz qux", "getHTTPResponseCode", "XMLHttpRequest", "parseURL", "userID", "IDs", "MyIDs",
        "ISsue", "base64sum", "utf8", "sha256Sum", "A", "a", "AB", "aB", "Ab", "ABC", "ABc", "2fa", "v2Beta3", "H264Codec",
        "UPPER_CASE_NAME", "kebab-case-name", "  padded  words  ", "dot.separated.name", "path/to/file", "snake_case_2go",
        "Hello, World!", "don't stop", "O'Neil", "", "___", "---", "a__b", "ALLCAPS", "mixedCASEWord", "iOS", "iPhone12Pro",
        "3D", "x", "X", "1", "12ab34", "ab12CD", "tab\tseparated", "new\nline"
    ]
    for s in inputs {
        show(s)
    }
}

fn unicode_conversions() {
    let inputs = ["Ünïcode Straße", "naïve café", "ÉCOLE normale", "日本語Server", "Ærø Øresund", "ünicodeNaïve", "ǅungla", "٣٤abc", "àb"]
    for s in inputs {
        show(s)
    }
}

fn extras() {
    print(naming.dotted("HTTPServerID2"))
    print(naming.screaming_kebab("fooBar baz"))
    print(naming.sentence("HTTPServer errorCode"))
    print(naming.sentence("single"))
    print("[{naming.sentence("")}]")
    print(naming.delimited("a b c", "::"))
    print(text.join(naming.parts("HTTPServerID2 foo_bar"), "|"))
    print(naming.camel(""))
    print(naming.pascal(""))
    print(naming.title(""))
}

fn flags(s: str) -> str {
    var out: []str = []
    if naming.is_snake(s) {
        push(mut out, "snake")
    }
    if naming.is_kebab(s) {
        push(mut out, "kebab")
    }
    if naming.is_screaming_snake(s) {
        push(mut out, "screaming")
    }
    if naming.is_camel(s) {
        push(mut out, "camel")
    }
    if naming.is_pascal(s) {
        push(mut out, "pascal")
    }
    if naming.is_title(s) {
        push(mut out, "title")
    }
    "[{s}] {text.join(out, " ")}"
}

fn predicates() {
    let inputs = [
        "snake_case", "snake_case_2", "base64", "kebab-case", "SCREAMING_SNAKE", "CONST_2", "camelCase", "PascalCase", "Title Case",
        "Http Server Id 2", "a", "A", "AB", "Ab", "aB", "_leading", "trailing_", "double__under", "-lead", "trail-", "a--b",
        "HTTPServer", "httpServer", "fooHTTPBar", "has space", "has.dot", "", "_", "1abc", "ünï_cödé", "ÜNÏ_CÖDÉ", "Ünï", "日本語", "mixed_Case"
    ]
    for s in inputs {
        print(flags(s))
    }
}

fn slugs() {
    let inputs = [
        "Hello, World!", "  Leading and trailing  ", "Crème Brûlée à la façon", "Straße Ærø Øresund Łódź Đà Nẵng", "ﬁne ﬂour ²", "Ａｂｃ１２３",
        "don't stop, won’t stop", "日本語 only", "mixed 日本語 and ascii", "foo___bar---baz", "---", "", "C++ & C# rock", "Ünïcödé", "ǅ Ǆ ǆ",
        "ТЕСТ test", "a.b.c", "Åsa Ångström", "ñandú", "İstanbul ı", "100% pure", "x"
    ]
    for s in inputs {
        print("[{s}] [{naming.slug(s)}]")
    }
}

fn limited(s: str, sep: str, max_len: i64) -> str {
    let o = naming.SlugOptions { separator: sep, max_len }
    naming.slug_with(s, o)
}

fn slug_options() {
    let s = "The quick brown fox jumps over the lazy dog"
    for n in [0, 1, 3, 4, 9, 10, 15, 16, 20, 25, 43, 100] {
        print("{n} [{limited(s, "-", n)}]")
    }
    print(limited(s, "_", 20))
    print(limited(s, "", 20))
    print(limited(s, "--", 20))
    print(limited(s, ".", 0))
    print("[{limited("supercalifragilistic word", "-", 5)}]")
    print("[{limited("ab cd", "-", 5)}] [{limited("ab cd", "-", 4)}] [{limited("ab cd", "-", 2)}] [{limited("ab cd", "-", 1)}]")
    print("[{limited("", "-", 5)}]")
    print("[{naming.slug_with("A B", naming.SlugOptions {})}]")
}

fn main() {
    conversions()
    unicode_conversions()
    extras()
    predicates()
    slugs()
    slug_options()
}
