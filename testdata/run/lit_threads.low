fn label(code: i64) -> str {
    let known: [i64: str] = [
        200: "OK", 201: "Created", 202: "Accepted", 204: "No Content", 301: "Moved",
        302: "Found", 400: "Bad Request", 401: "Unauthorized", 403: "Forbidden", 404: "Not Found",
        500: "Internal Server Error", 502: "Bad Gateway", 503: "Service Unavailable",
    ]
    known[code] ?? "?"
}

fn word(i: i64) -> str {
    let words = ["red", "green", "blue", "cyan", "magenta", "yellow"]
    words[i % words.len]
}

fn worker(id: i64, rounds: i64, done: chan[i64]) {
    var total = 0
    for r in 0..rounds {
        let junk = "worker {id} round {r} {r * id}"
        total += label(200 + (r % 5) * 100 + id % 2).len
        total += word(r + id).len
        total += junk.len - junk.len
    }
    done <- total
}

fn main() {
    let done = chan[i64](16)
    for id in 0..8 {
        spawn worker(id, 40000, done)
    }
    var grand = 0
    for id in 0..8 {
        grand += (<-done) ?? 0
    }
    print(grand)
    print(label(404))
    print(word(4))
}
