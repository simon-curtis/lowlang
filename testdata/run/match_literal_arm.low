enum Fit {
    Wide
    Contain
    Cover
}

fn ints(fit: Fit, a: i32) -> i32 {
    let s = match fit {
        Wide => 1
        Contain => a
        Cover => a * 2
    }
    s
}

fn floats(fit: Fit, a: f32) -> f32 {
    let s = match fit {
        Wide => { 0.5 }
        Contain => a
        _ => 1.5
    }
    s
}

fn small(n: i64, b: u8) -> u8 {
    let s = match n {
        0 => 200
        1 => b
        _ => 255
    }
    s
}

fn main() {
    print("{ints(Wide, 3)} {ints(Contain, 3)} {ints(Cover, 3)}")
    print("{floats(Wide, 2.25)} {floats(Contain, 2.25)} {floats(Cover, 2.25)}")
    print("{small(0, 7)} {small(1, 7)} {small(2, 7)}")
}
