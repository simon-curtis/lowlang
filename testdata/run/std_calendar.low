import std/time/calendar

fn main() {
    for year in [1900, 2000, 2023, 2024, 2100, -4, 0] {
        print("leap {year} {calendar.leap_year(year)} feb {calendar.days_in_month(year, 2)}")
    }
    print("months {calendar.days_in_month(2026, 1)} {calendar.days_in_month(2026, 4)} {calendar.days_in_month(2026, 12)}")
    for days in [-719528, -1, 0, 1, 59, 11016, 20403, 2932896] {
        let c = calendar.civil_from_days(days)
        let back = calendar.days_from_civil(c.year, c.month, c.day)
        print("days {days} {c.year}-{c.month}-{c.day} {back == days} weekday {calendar.weekday_index(days)}")
    }
    print("names {calendar.month_names()[2]} {calendar.short_month_names()[11]} {calendar.weekday_names()[6]} {calendar.short_weekday_names()[0]}")
}
