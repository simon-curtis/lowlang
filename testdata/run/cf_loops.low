fn find_pair(limit: i64, target: i64) -> i64 {
    outer: for a in 1..limit {
        for b in a..limit {
            if a * b > target { continue outer }
            if a * b == target { return a * 1000 + b }
        }
    }
    -1
}

fn grid_walk(rows: i64, cols: i64) -> i64 {
    var sum = 0
    scan: for r in 0..rows {
        for c in 0..cols {
            if c == r { continue }
            if (r + c) % 7 == 6 { continue scan }
            if r * c > 40 { break scan }
            sum += r * 100 + c
        }
        sum += 1
    }
    sum
}

fn count_until(xs: []i64, stop: i64) -> i64 {
    var n = 0
    for x in xs {
        if x < 0 { continue }
        if x == stop { break }
        n += x
    }
    n
}

fn first_over(xs: []i64, limit: i64) -> i64 {
    for i, x in xs {
        for j in 0..x {
            if j * j > limit { return i * 100 + j }
        }
    }
    -1
}

fn nested_while(n: i64) -> i64 {
    var i = 0
    var total = 0
    for i < n {
        var j = i
        for j > 0 {
            j -= 1
            if j % 3 == 0 { continue }
            total += j
            if total > 500 { break }
        }
        i += 1
        if total > 1000 { break }
    }
    total
}

fn triple(n: i64) -> i64 {
    var hits = 0
    a: for x in 0..n {
        b: for y in 0..n {
            for z in 0..n {
                if z > y { continue b }
                if x + y + z > n + 3 { continue a }
                if x == y && y == z { hits += 1 }
                if x * y * z > 60 { break a }
                hits += 2
            }
        }
    }
    hits
}

fn forever(limit: i64) -> i64 {
    var i = 0
    var acc = 7
    for {
        i += 1
        if i % 2 == 0 { continue }
        acc = (acc * 31 + i) % 1009
        if i > limit { break }
    }
    acc * 10000 + i
}

fn main() {
    print(find_pair(30, 36))
    print(find_pair(30, 997))
    print(find_pair(5, 1000))
    print(grid_walk(10, 10))
    print(grid_walk(4, 3))
    print(grid_walk(0, 5))
    print(count_until([3, -1, 4, 9, 5, 2], 5))
    print(count_until([3, -1, 4, 9, 5, 2], 99))
    print(count_until([], 1))
    print(first_over([2, 3, 9, 4], 20))
    print(first_over([2, 3, 4], 20))
    print(nested_while(5))
    print(nested_while(40))
    print(nested_while(0))
    print(triple(4))
    print(triple(9))
    print(forever(10))
    print(forever(1000))
}
