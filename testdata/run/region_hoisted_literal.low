fn total() -> i64 {
    var sum = 0
    for n in [2, 3, 5] {
        sum += n
    }
    sum
}

fn names() -> []str {
    ["a", "b"]
}

fn main() {
    let first = region { total() }
    let second = total()
    let listed = region { names().len }
    let again = names()
    print("{first} {second} {listed} {again[1]}")
}
