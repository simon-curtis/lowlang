[req]
distinguished_name = req_dn
prompt = no

[req_dn]
CN = unused

[ca]
default_ca = ca_default

[ca_default]
dir = $ENV::CA_DIR
database = $dir/index.txt
serial = $dir/serial
new_certs_dir = $dir/certs
certificate = $dir/cert.pem
private_key = $dir/key.pem
crlnumber = $dir/crlnumber
default_md = sha256
default_days = 36500
default_crl_days = 36500
policy = policy_any
unique_subject = no
crl_extensions = crl_v2

[ca_v1]
dir = $ENV::CA_DIR
database = $dir/index.txt
serial = $dir/serial
new_certs_dir = $dir/certs
certificate = $dir/cert.pem
private_key = $dir/key.pem
default_md = sha256
default_days = 36500
default_crl_days = 36500
policy = policy_any
unique_subject = no

[policy_any]
commonName = supplied

[root_ext]
basicConstraints = critical,CA:TRUE
keyUsage = critical,keyCertSign,cRLSign
subjectKeyIdentifier = hash

[inter_ext]
basicConstraints = critical,CA:TRUE
keyUsage = critical,keyCertSign,cRLSign
subjectKeyIdentifier = hash
authorityKeyIdentifier = keyid
authorityInfoAccess = OCSP;URI:http://ocsp.status.invalid/root,caIssuers;URI:http://ca.status.invalid/root.der
crlDistributionPoints = URI:http://crl.status.invalid/root.crl

[nocrlsign_ext]
basicConstraints = critical,CA:TRUE
keyUsage = critical,keyCertSign
subjectKeyIdentifier = hash
authorityKeyIdentifier = keyid

[leaf_ext]
basicConstraints = CA:FALSE
keyUsage = critical,digitalSignature
extendedKeyUsage = serverAuth
subjectAltName = DNS:localhost,IP:127.0.0.1
subjectKeyIdentifier = hash
authorityKeyIdentifier = keyid
authorityInfoAccess = OCSP;URI:http://ocsp.status.invalid/inter,caIssuers;URI:http://ca.status.invalid/inter.der
crlDistributionPoints = URI:http://crl.status.invalid/inter.crl

[staple_ext]
basicConstraints = CA:FALSE
keyUsage = critical,digitalSignature
extendedKeyUsage = serverAuth
subjectAltName = DNS:localhost,IP:127.0.0.1
subjectKeyIdentifier = hash
authorityKeyIdentifier = keyid
authorityInfoAccess = OCSP;URI:http://ocsp.status.invalid/inter
crlDistributionPoints = URI:http://crl.status.invalid/inter.crl
tlsfeature = status_request

[plain_ext]
basicConstraints = CA:FALSE
keyUsage = critical,digitalSignature
extendedKeyUsage = serverAuth
subjectAltName = DNS:localhost,IP:127.0.0.1

[nocheck_ext]
basicConstraints = CA:FALSE
keyUsage = critical,digitalSignature
extendedKeyUsage = serverAuth,OCSPSigning
subjectAltName = DNS:localhost,IP:127.0.0.1
1.3.6.1.5.5.7.48.1.5 = ASN1:NULL

[responder_ext]
basicConstraints = CA:FALSE
keyUsage = critical,digitalSignature
extendedKeyUsage = OCSPSigning
subjectKeyIdentifier = hash
authorityKeyIdentifier = keyid
1.3.6.1.5.5.7.48.1.5 = ASN1:NULL

[responder_checked_ext]
basicConstraints = CA:FALSE
keyUsage = critical,digitalSignature
extendedKeyUsage = OCSPSigning
subjectKeyIdentifier = hash

[responder_noeku_ext]
basicConstraints = CA:FALSE
keyUsage = critical,digitalSignature
subjectKeyIdentifier = hash

[crl_v2]
authorityKeyIdentifier = keyid:always

[crl_unknown]
authorityKeyIdentifier = keyid:always
1.3.6.1.4.1.99999.1 = critical,ASN1:NULL

[crl_idp_user]
authorityKeyIdentifier = keyid:always
issuingDistributionPoint = critical,@idp_user

[idp_user]
fullname = URI:http://crl.status.invalid/inter.crl
onlyuser = TRUE

[crl_idp_ca]
authorityKeyIdentifier = keyid:always
issuingDistributionPoint = critical,@idp_ca

[idp_ca]
fullname = URI:http://crl.status.invalid/inter.crl
onlyCA = TRUE

[crl_idp_other]
authorityKeyIdentifier = keyid:always
issuingDistributionPoint = critical,@idp_other

[idp_other]
fullname = URI:http://crl.status.invalid/elsewhere.crl

[crl_idp_indirect]
authorityKeyIdentifier = keyid:always
issuingDistributionPoint = critical,@idp_indirect

[idp_indirect]
indirectCRL = TRUE

[crl_idp_reasons]
authorityKeyIdentifier = keyid:always
issuingDistributionPoint = critical,@idp_reasons

[idp_reasons]
onlysomereasons = keyCompromise
