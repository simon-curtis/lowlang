fn copy(text: str, flip: i64, extra: i64) -> str {
    var buf: []u8 = []
    for i in 0..extra {
        push(mut buf, 'z')
    }
    let start = buf.len
    for i in 0..text.len {
        var b = text[i]
        if i == flip {
            b = b ^ 1
        }
        push(mut buf, b)
    }
    let whole = str(buf)
    whole[start..start + text.len]
}

fn grown(text: str, extra: i64) -> str {
    var buf: []u8 = []
    for i in 0..extra {
        push(mut buf, 'z')
    }
    let start = buf.len
    for i in 0..text.len {
        push(mut buf, text[i])
    }
    push(mut buf, 'q')
    let whole = str(buf)
    whole[start..start + text.len + 1]
}

fn shrunk(text: str, extra: i64) -> str {
    let whole = copy(text, -1, extra)
    if whole.len == 0 {
        return whole
    }
    whole[0..whole.len - 1]
}

fn right0(s: str) -> bool {
    s == ""
}

fn left0(s: str) -> bool {
    "" == s
}

fn differs0(s: str) -> bool {
    s != ""
}

fn probe0() -> i64 {
    let t = ""
    var score = 0
    for extra in 0..9 {
        let same = copy(t, -1, extra)
        if right0(same) {
            score += 1
        }
        if left0(same) {
            score += 2
        }
        if differs0(same) {
            score += 4
        }
        for at in 0..t.len {
            let bad = copy(t, at, extra)
            if right0(bad) || left0(bad) {
                score += 1000
            }
            if !differs0(bad) {
                score += 1000
            }
        }
        if right0(grown(t, extra)) || left0(grown(t, extra)) {
            score += 100000
        }
        if t.len > 0 && (right0(shrunk(t, extra)) || left0(shrunk(t, extra))) {
            score += 100000
        }
    }
    score
}

