extern "c" {
    fn qsort(base: ptr, n: i64, size: i64, compare: extern fn(ptr[i64], ptr[i64]) -> i32)
    fn malloc(n: i64) -> ptr
    fn free(p: ptr)
}

struct Block[T] {
    data: ptr[T]
    drop free(data)
}

struct Node {
    value: i64
    next: *Node?
}

fn ascending(a: ptr[i64], b: ptr[i64]) -> i32 {
    let x = load(a)
    let y = load(b)
    if x < y {
        return -1
    }
    if x > y {
        return 1
    }
    0
}

fn churning(a: ptr[i64], b: ptr[i64]) -> i32 {
    var junk: *Node? = none
    for i in 0..2000 {
        junk = new(Node { value: i, next: junk })
    }
    using inner = Block[i64] { data: malloc(24) }
    let three = view(inner.data, 3)
    three[0] = 3
    three[1] = 1
    three[2] = 2
    qsort(inner.data, 3, 8, ascending)
    ascending(b, a)
}

fn chain(n: i64) -> *Node {
    var head = new(Node { value: 0, next: none })
    for i in 1..n {
        head = new(Node { value: i, next: head })
    }
    head
}

fn total(list: *Node) -> i64 {
    var sum = 0
    var at: *Node? = list
    for {
        match at {
            some(node) => {
                sum += node.value
                at = node.next
            }
            none => return sum
        }
    }
}

fn halve(x: f64, scale: f32, flag: bool, small: i32) -> f64 {
    if flag {
        return x / 2.0 * f64(scale) + f64(small)
    }
    0.0
}

fn main() {
    let n = 64
    using block = Block[i64] { data: malloc(8 * n) }
    let data = block.data
    let values = view(data, n)
    for i in 0..n {
        values[i] = (i * 37) % n
    }
    qsort(data, n, 8, ascending)
    print("{values[0]} {values[1]} {values[63]}")

    let kept = chain(1000)
    qsort(data, n, 8, churning)
    print("{values[0]} {values[1]} {values[63]}")
    print(total(kept))

    let compare: extern fn(ptr[i64], ptr[i64]) -> i32 = ascending
    using cell = Block[i64] { data: malloc(8) }
    let low = cell.data
    store(low, -5)
    print(compare(low, data))
    print(compare(data, low))

    let scaled: extern fn(f64, f32, bool, i32) -> f64 = halve
    print(scaled(9.0, 2.0, true, -1))

    let release: extern fn(ptr) = free
    let spare = malloc(32)
    release(spare)
    print("done")
}
