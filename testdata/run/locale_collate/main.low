import std/locale/collate
import std/text

fn parse_line(line: str) -> u32[] {
    var out: u32[] = []
    for f in text.fields(line) {
        let v = text.parse_hex_at(f, 0, f.len) or 0
        out.push(u32(v))
    }
    out
}

fn compare_keys(a: u8[], b: u8[]) -> i64 {
    let n = if a.len < b.len { a.len } else { b.len }
    for i in 0..n {
        if a[i] != b[i] {
            return if a[i] < b[i] { -1 } else { 1 }
        }
    }
    if a.len == b.len {
        return 0
    }
    if a.len < b.len { -1 } else { 1 }
}

fn check(name: str, body: str, o: collate.Options) {
    let c = collate.root(o)
    var previous: u32[] = []
    var previous_key: u8[] = []
    var pairs = 0
    var wrong = 0
    var key_wrong = 0
    var have = false
    for line in text.lines(body) {
        if line.len == 0 || line[0] == '#' {
            continue
        }
        let cps = parse_line(line)
        let key = collate.sort_key_runes(c, cps)
        if have {
            pairs += 1
            if collate.compare_runes(c, previous, cps) > 0 {
                wrong += 1
            }
            if compare_keys(previous_key, key) > 0 {
                key_wrong += 1
            }
        }
        previous = cps
        previous_key = key
        have = true
    }
    print("{name}: {pairs} pairs, {wrong} out of order, {key_wrong} keys out of order")
}

fn main() {
    var o = collate.options()
    o.strength = collate.Strength.Identical
    check("non-ignorable", embed("CollationTest_CLDR_NON_IGNORABLE_SHORT.txt"), o)
    o.alternate = collate.Alternate.Shifted
    check("shifted", embed("CollationTest_CLDR_SHIFTED_SHORT.txt"), o)
}
