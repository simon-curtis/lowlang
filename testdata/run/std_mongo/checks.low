import std/bson
import std/mongo
import std/text

fn has(r: Request, name: str) -> bool {
    present(r.body, name)
}

fn want(w: *World, r: Request, condition: bool, what: str) {
    if !condition {
        note(w, "{r.name}: {what}")
    }
}

fn session_of(r: Request) -> str {
    let lsid = mongo.get_document(r.body, "lsid") ?? []
    let id = bson.get(lsid, "id") ?? bson.Value.Null
    match id {
        Binary(subtype, data) => "{subtype}:{text.encode_hex(data)}"
        _ => ""
    }
}

fn first_sequence(r: Request, ident: str) -> []bson.Field {
    for s in r.sequences {
        if s.ident == ident && s.documents.len > 0 {
            return s.documents[0]
        }
    }
    []
}

fn sequence_size(r: Request, ident: str) -> i64 {
    for s in r.sequences {
        if s.ident == ident {
            return s.documents.len
        }
    }
    0
}

fn plain(w: *World, r: Request, database: str) {
    want(w, r, r.db == database, "database {r.db}")
    want(w, r, session_of(r).len > 0 && text.starts_with(session_of(r), "4:"), "no uuid session id")
    want(w, r, !has(r, "$clusterTime"), "cluster time without a replica set")
    want(w, r, !has(r, "$readPreference"), "read preference on a primary read")
    want(w, r, !has(r, "txnNumber"), "transaction number outside a retryable topology")
}

fn same_session(w: *World, r: Request) {
    let id = session_of(r)
    if w.lsid.len == 0 {
        w.lsid = id
    } else {
        want(w, r, w.lsid == id, "session {id} where {w.lsid} was due")
    }
}

fn check_drop(w: *World, r: Request) {
    plain(w, r, "lowtest")
    want(w, r, mongo.get_text(r.body, "drop") == some("cap"), "collection")
    same_session(w, r)
}

fn check_insert_one(w: *World, r: Request) {
    plain(w, r, "lowtest")
    want(w, r, mongo.get_text(r.body, "insert") == some("cap"), "collection")
    want(w, r, mongo.get_bool(r.body, "ordered") == some(true), "ordered")
    want(w, r, !has(r, "documents"), "documents in the body")
    want(w, r, sequence_size(r, "documents") == 1, "one document in the sequence")
    want(w, r, mongo.get_int(first_sequence(r, "documents"), "_id") == some(1), "first _id")
    same_session(w, r)
}

fn check_insert_two(w: *World, r: Request) {
    plain(w, r, "lowtest")
    want(w, r, sequence_size(r, "documents") == 2, "two documents in the sequence")
    same_session(w, r)
}

fn check_find(w: *World, r: Request) {
    plain(w, r, "lowtest")
    want(w, r, mongo.get_int(r.body, "batchSize") == some(2), "batch size")
    want(w, r, present(r.body, "sort"), "sort")
    want(w, r, present(r.body, "filter"), "filter")
    same_session(w, r)
}

fn check_get_more(w: *World, r: Request) {
    plain(w, r, "lowtest")
    want(w, r, mongo.get_int(r.body, "getMore") == some(5590039840182862156), "cursor id")
    want(w, r, mongo.get_text(r.body, "collection") == some("cap"), "collection")
    want(w, r, mongo.get_int(r.body, "batchSize") == some(2), "batch size")
    same_session(w, r)
}

fn check_kill(w: *World, r: Request) {
    plain(w, r, "lowtest")
    let ids = mongo.get_array(r.body, "cursors") ?? []
    var first = -1
    if ids.len == 1 {
        first = mongo.number(ids[0]) ?? -1
    }
    want(w, r, first == 297452937041254174, "cursor id")
    same_session(w, r)
}

fn check_update(w: *World, r: Request) {
    plain(w, r, "lowtest")
    let u = first_sequence(r, "updates")
    want(w, r, present(u, "q"), "query")
    want(w, r, mongo.get_bool(u, "multi") == some(false), "multi")
    let change = mongo.get_document(u, "u") ?? []
    let set = mongo.get_document(change, "$set") ?? []
    want(w, r, mongo.get_int(set, "age") == some(37), "update value")
    same_session(w, r)
}

fn check_find_and_modify(w: *World, r: Request) {
    plain(w, r, "lowtest")
    want(w, r, mongo.get_bool(r.body, "new") == some(true), "new")
    want(w, r, present(r.body, "query"), "query")
    same_session(w, r)
}

fn check_aggregate(w: *World, r: Request) {
    plain(w, r, "lowtest")
    want(w, r, (mongo.get_array(r.body, "pipeline") ?? []).len == 2, "pipeline length")
    want(w, r, present(r.body, "cursor"), "cursor option")
    same_session(w, r)
}

fn check_delete(w: *World, r: Request) {
    plain(w, r, "lowtest")
    let d = first_sequence(r, "deletes")
    want(w, r, mongo.get_int(d, "limit") == some(1), "limit")
    same_session(w, r)
}

fn check_ping(w: *World, r: Request) {
    plain(w, r, "lowtest")
    same_session(w, r)
}

fn check_second_insert(w: *World, r: Request) {
    plain(w, r, "lowtest")
    want(w, r, sequence_size(r, "documents") == 1, "one document in the sequence")
    same_session(w, r)
}

fn check_unknown(w: *World, r: Request) {
    plain(w, r, "lowtest")
    same_session(w, r)
}

fn remember_write(w: *World, r: Request) {
    w.lsid = session_of(r)
    w.txn = mongo.get_int(r.body, "txnNumber") ?? -1
    want(w, r, w.txn >= 1, "transaction number")
    want(w, r, w.lsid.len > 0, "session")
}

fn repeat_write(w: *World, r: Request) {
    want(w, r, session_of(r) == w.lsid, "session changed on retry")
    want(w, r, (mongo.get_int(r.body, "txnNumber") ?? -2) == w.txn, "transaction number changed on retry")
}

fn step_down(w: *World, r: Request) {
    remember_write(w, r)
    w.primary = 2
    w.election = 6
}

fn preference_mode(r: Request) -> str {
    let p = mongo.get_document(r.body, "$readPreference") ?? []
    mongo.get_text(p, "mode") ?? "absent"
}

fn preference_tags(r: Request) -> i64 {
    let p = mongo.get_document(r.body, "$readPreference") ?? []
    (mongo.get_array(p, "tags") ?? []).len
}

fn check_east_read(w: *World, r: Request) {
    want(w, r, preference_mode(r) == "secondaryPreferred", "mode {preference_mode(r)}")
    want(w, r, preference_tags(r) == 1, "tag sets {preference_tags(r)}")
    want(w, r, !has(r, "txnNumber"), "transaction number on a read")
}

fn check_failover_write(w: *World, r: Request) {
    want(w, r, !has(r, "$readPreference"), "read preference on a write to a discovered primary")
    step_down(w, r)
}

fn check_direct_write(w: *World, r: Request) {
    want(w, r, preference_mode(r) == "primaryPreferred", "mode {preference_mode(r)}")
    remember_write(w, r)
}

fn check_direct_retry(w: *World, r: Request) {
    want(w, r, preference_mode(r) == "primaryPreferred", "mode {preference_mode(r)}")
    repeat_write(w, r)
}

fn check_direct_read(w: *World, r: Request) {
    want(w, r, preference_mode(r) == "primaryPreferred", "mode {preference_mode(r)}")
}

fn transaction_fields(w: *World, r: Request, starting: bool) {
    want(w, r, mongo.get_bool(r.body, "autocommit") == some(false), "autocommit")
    want(w, r, has(r, "startTransaction") == starting, "startTransaction {has(r, "startTransaction")}")
    want(w, r, !has(r, "readConcern") || starting, "read concern outside the first command")
}

fn check_transaction_insert(w: *World, r: Request) {
    transaction_fields(w, r, true)
    want(w, r, mongo.get_bool(r.body, "startTransaction") == some(true), "startTransaction true")
    w.lsid = session_of(r)
    w.txn = mongo.get_int(r.body, "txnNumber") ?? -1
    want(w, r, w.txn >= 1, "transaction number")
}

fn check_commit(w: *World, r: Request) {
    transaction_fields(w, r, false)
    want(w, r, session_of(r) == w.lsid, "session")
    want(w, r, (mongo.get_int(r.body, "txnNumber") ?? -2) == w.txn, "transaction number")
    want(w, r, r.db == "admin", "database {r.db}")
}

fn after_cluster_time(r: Request) -> u64 {
    let rc = mongo.get_document(r.body, "readConcern") ?? []
    match bson.get(rc, "afterClusterTime") ?? bson.Value.Null {
        Timestamp(n) => n
        _ => 0
    }
}

fn check_second_transaction(w: *World, r: Request) {
    transaction_fields(w, r, true)
    want(w, r, session_of(r) == w.lsid, "session")
    want(w, r, (mongo.get_int(r.body, "txnNumber") ?? -2) == w.txn + 1, "transaction number is the next one")
    want(w, r, after_cluster_time(r) == 7708170822514376708, "afterClusterTime {after_cluster_time(r)}")
    w.txn += 1
}

fn check_conflicting_transaction(w: *World, r: Request) {
    transaction_fields(w, r, true)
    want(w, r, session_of(r) != w.lsid, "second session")
}

fn check_abort(w: *World, r: Request) {
    transaction_fields(w, r, false)
    want(w, r, session_of(r) == w.lsid, "session")
    want(w, r, (mongo.get_int(r.body, "txnNumber") ?? -2) == w.txn, "transaction number")
}
