import std/locale
import std/locale/datefmt
import std/text
import std/time/datetime
import std/time/fault
import std/time/pattern

fn datetime_of(value: str) -> datetime.DateTime {
    let n = text.split(value, ',')
    let year = text.parse_int(n[0]) or 0
    let month = text.parse_int(n[1]) or 1
    let day = text.parse_int(n[2]) or 1
    let hour = text.parse_int(n[3]) or 0
    let minute = text.parse_int(n[4]) or 0
    let second = text.parse_int(n[5]) or 0
    datetime.of(year, month, day, hour, minute, second, 0) or datetime.epoch()
}

fn render_checked(l: locale.Locale, layout: str, layouts: pattern.Layouts, dt: datetime.DateTime) -> str ! fault.Fault {
    let p = pattern.compile_in(layout, layouts)?
    let raw = datetime.format_names(dt, p, datefmt.names(l))?
    text.replace(raw, text.from_char(0x202f), " ")
}

fn render_in(l: locale.Locale, layout: str, dt: datetime.DateTime) -> str {
    let layouts = datefmt.layouts(l) or pattern.Layouts { date: "", time: "", date_time: "" }
    render_checked(l, layout, layouts, dt) catch {
        e => "error"
    }
}

fn plain() -> str ! fault.Fault {
    let _ = pattern.compile("%c")?
    "compiled"
}

fn flexible_date() -> str ! datefmt.Error {
    let l = locale.parse("zh-Hant") or locale.root()
    let layouts = datefmt.layouts(l)?
    layouts.date
}

fn main() {
    var checked = 0
    var failed = 0
    for line in text.lines(embed("pattern.tsv")) {
        let f = text.split(line, '\t')
        if f.len != 4 {
            continue
        }
        let l = locale.parse(f[0]) or locale.root()
        let got = render_in(l, f[1], datetime_of(f[2]))
        checked += 1
        if got != f[3] {
            failed += 1
            if failed <= 20 {
                print("{f[0]} {f[1]} {f[2]}: want {f[3]}, got {got}")
            }
        }
    }
    print("locale verbs: {checked} checked, {failed} wrong")

    let en = locale.parse("en-GB") or locale.root()
    let dt = datetime_of("2024,3,5,15,45,30")
    print(render_in(en, "%x|%X|%c|%%x|%Y", dt))
    print(render_in(locale.parse("de") or locale.root(), "%A, %-d. %B", dt))

    print(plain() catch {
        Unsupported(what) => "plain compile rejects {what}"
        e => "other"
    })
    print(flexible_date() catch {
        NoLayout(shape) => "zh-Hant has no layout for {shape}"
        e => "other"
    })
}
