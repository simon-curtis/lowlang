enum ParseError {
    Empty
}

struct Counter {
    count: i64
}

struct Ops {
    scale: fn(i64) -> i64
    reset: fn(mut Counter)
}

fn first(s: str) -> u8 {
    s[0]
}

fn shout(s: str, times: i64) -> str {
    var out = s
    for i in 1..times {
        out = "{out}{s}"
    }
    out
}

fn bump(mut c: Counter, by: i64) {
    c.count += by
}

fn length(s: str) -> i64 ! ParseError {
    if s.len == 0 {
        fail Empty
    }
    s.len
}

fn biggest[T: Ord](a: T, b: T) -> T {
    if a > b {
        return a
    }
    b
}

fn measure(s: str) -> i64 ! ParseError {
    let n = s |> length()?
    n * 10
}

fn main() {
    print("simon" |> first())
    print("ab" |> shout(3) |> first)
    print(1 + 2 |> biggest(2))

    let total = "ab"
        |> shout(2)
        |> shout(2)
    print(total)

    let chained = "xy"
        .shout(2)
        .shout(2)
    print(chained)

    var counter = Counter { count: 1 }
    counter |> bump(4)
    print(counter.count)

    var xs: []i64 = []
    xs |> push(7)
    print(xs.len)

    let double = fn(v: i64) -> i64 { v * 2 }
    print(5 |> double |> double)
    print(3 |> fn(v: i64) -> i64 { v + 1 })
    print(16.0 |> sqrt)

    let ops = Ops {
        scale: fn(v: i64) -> i64 { v * 3 },
        reset: fn(mut c: Counter) { c.count = 0 },
    }
    print(7 |> ops.scale)
    print(7 |> ops.scale() |> ops.scale)
    counter |> ops.reset
    print(counter.count)

    let grow = fn(mut c: Counter) { c.count += 1 }
    counter |> grow
    counter.grow()
    print(counter.count)

    print(measure("abc") catch { _ => -1 })
    print(measure("") catch { _ => -1 })
}
