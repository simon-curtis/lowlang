import std/io
import std/net

fn main() ! io.Error {
    print(net.interface_index("lo")? > 0)
    let missing = net.interface_index("nosuchif0") catch {
        NotFound => -1
        _ => -2
    }
    print(missing)
    let invalid = net.interface_index("") catch {
        Invalid => -1
        _ => -2
    }
    print(invalid)

    let l = net.listen("127.0.0.1", 0)?
    let client = net.connect_through(l.addr, "lo", 1000)?
    let server = net.accept(l)?
    net.write_all(client, bytes("bound"))?
    let buf = io.buffer(16)
    let n = net.read(server, buf)?
    print(str(buf[..n]))
    net.close(client)
    net.close(server)

    let first = net.connect_first([l.addr.ip], l.addr.port, "lo", 1000)?
    print(net.format(first.remote) == net.format(l.addr))
    net.close(net.accept(l)?)
    net.close(first)
    let none_left = net.connect_first([], l.addr.port, "", 0) catch {
        NotFound => {
            print("no addresses")
            return
        }
        _ => return
    }
    net.close(none_left)
}
