import std/io
import std/net

fn main() ! io.Error {
    print(net.interface_index("lo")? > 0)
    let missing = net.interface_index("nosuchif0") catch {
        NotFound => -1
        _ => -2
    }
    print(missing)
    let invalid = net.interface_index("") catch {
        Invalid => -1
        _ => -2
    }
    print(invalid)

    using l = net.listen("127.0.0.1", 0)?
    using client = net.connect_through(l.handle.addr, "lo", 1000)?
    using server = net.accept(l)?
    net.write_all(client, bytes("bound"))?
    let buf = io.buffer(16)
    let n = net.read(server, buf)?
    print(str(buf[..n]))
    net.close(client)
    net.close(server)

    using first = net.connect_first([l.handle.addr.ip], l.handle.addr.port, "lo", 1000)?
    print(net.format(first.handle.remote) == net.format(l.handle.addr))
    using accepted = net.accept(l)?
    net.close(accepted)
    net.close(first)
    using none_left = net.connect_first([], l.handle.addr.port, "", 0) catch {
        NotFound => {
            print("no addresses")
            return
        }
        _ => return
    }
}
