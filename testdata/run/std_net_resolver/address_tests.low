import std/net
import std/net/dns

fn address_script(q: dns.Message, tcp: bool) -> []Reply {
    let name = asked(q)
    let kind = kind_of(q)
    match name {
        "host.test" => {
            if kind == dns.type_a {
                return say(q, [rec(name, a_data(192, 0, 2, 7))])
            }
            say(q, [rec(name, aaaa_data(7))])
        }
        "nodata.test" => say(q, [])
        "v6only.test" => {
            if kind == dns.type_aaaa {
                return say(q, [rec(name, aaaa_data(9))])
            }
            say(q, [])
        }
        "nx.test" => fail_with(q, dns.rcode_name)
        "servfail.test" => fail_with(q, dns.rcode_server)
        "refused.test" => fail_with(q, dns.rcode_refused)
        "notimp.test" => fail_with(q, dns.rcode_not_implemented)
        "formerr.test" => fail_with(q, dns.rcode_format)
        "ednsfail.test" => {
            if dns.payload_size(q) > 0 {
                return fail_with(q, dns.rcode_format)
            }
            say(q, [rec(name, a_data(192, 0, 2, 11))])
        }
        _ => fail_with(q, dns.rcode_name)
    }
}

fn address_case(s: *Server, c: net.ResolverConfig, name: str) {
    let r = net.resolver(c)
    print("{name}: {outcome(r, name)}")
    show_log(s)
    truncate(mut s.log, 0)
}

fn address_tests() {
    serving(address_script, fn(s: *Server) {
        let c = config_for(s.port)
        for name in ["host.test", "nodata.test", "v6only.test", "nx.test", "servfail.test", "refused.test", "notimp.test", "formerr.test", "ednsfail.test"] {
            address_case(s, c, name)
        }
        var plain = c
        plain.edns0 = false
        address_case(s, plain, "host.test")
        address_case(s, plain, "ednsfail.test")
    })
}

fn distinct(values: []i64) -> i64 {
    var seen: [i64: bool] = [:]
    for v in values {
        seen[v] = true
    }
    seen.len
}

fn randomness_tests() {
    serving(address_script, fn(s: *Server) {
        let r = net.resolver(config_for(s.port))
        for _ in 0..8 {
            outcome(r, "host.test")
        }
        print("queries: {s.ids.len}")
        print("identifiers vary: {distinct(s.ids) > 8}")
        print("source ports vary: {distinct(s.ports) > 8}")
    })
}
