import std/net
import std/net/dns

fn search_script(q: dns.Message, tcp: bool) -> []Reply {
    let name = asked(q)
    if !known(name) {
        return fail_with(q, 3)
    }
    if kind_of(q) == dns.type_a {
        return say(q, [rec(name, a_data(192, 0, 2, 10))])
    }
    say(q, [])
}

fn known(name: str) -> bool {
    name == "www.b.test" || name == "u.v.z.a.test" || name == "w.x.y" || name == "found"
}

fn search_case(s: *Server, label: str, c: net.ResolverConfig, name: str) {
    let r = net.resolver(c)
    print("{label}: {outcome(r, name)}")
    show_log(s)
    truncate(mut s.log, 0)
}

fn outcome(r: net.Resolver, name: str) -> str {
    let ips = net.resolve(r, name) catch {
        e => return "{e}"
    }
    render_all(ips)
}

fn search_tests() {
    serving(search_script, fn(s: *Server) {
        var c = config_for(s.port)
        c.edns0 = false
        c.search = ["a.test", "b.test."]
        c.ndots = 2
        search_case(s, "below ndots", c, "www")
        search_case(s, "one dot below ndots", c, "w.x")
        search_case(s, "at ndots, as written", c, "w.x.y")
        search_case(s, "at ndots, suffix", c, "u.v.z")
        search_case(s, "trailing dot", c, "www.")
        search_case(s, "trailing dot found", c, "found.")
        c.ndots = 0
        search_case(s, "ndots 0", c, "found")
        c.search = []
        search_case(s, "no search list", c, "found")
    })
}
