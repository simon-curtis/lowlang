import std/net

fn hosts_tests() {
    var c = net.resolver_config()
    c.servers = [net.Addr { ip: [127, 0, 0, 1], port: 9 }]
    c.timeout = 100
    var r = net.resolver(c)
    r.hosts = "# comment\n192.0.2.50 myhost alias\n2001:db8::50\tMYHOST # trailing\nnot-an-ip bad\n192.0.2.51 other\n"
    for name in ["myhost", "MyHost", "alias", "other", "10.1.2.3", "2001:db8::1", "localhost", "LOCALHOST", "bad"] {
        print("{name}: {outcome(r, name)}")
    }
    print("lookup of an address literal: {render_all(net.lookup("127.0.0.1") or [])}")
}
