import std/net

fn show_config(label: str, c: net.ResolverConfig) {
    var servers: []str = []
    for a in c.servers {
        push(mut servers, net.format(a))
    }
    print("{label}: servers={servers} search={c.search} ndots={c.ndots} timeout={c.timeout} attempts={c.attempts} rotate={c.rotate} edns0={c.edns0} use_tcp={c.use_tcp}")
}

fn config_tests() {
    show_config("empty", net.parse_resolv_conf("", "", ""))
    let conf = "# comment\n; also comment\nnameserver 192.0.2.1\nnameserver 2001:db8::53\nnameserver not-an-ip\nnameserver 192.0.2.3\nnameserver 192.0.2.4\nsearch a.example b.example\ndomain c.example\nsearch d.example e.example\noptions ndots:3 timeout:2 attempts:4 rotate\noptions edns0 use-vc ignored:5 timeout:99 attempts:0\n"
    show_config("file", net.parse_resolv_conf(conf, "", ""))
    show_config("environment", net.parse_resolv_conf(conf, "x.test y.test", "ndots:0 attempts:3"))
    show_config("domain", net.parse_resolv_conf("domain only.example\nsearch\n", "", ""))
    show_config("windows line endings", net.parse_resolv_conf("nameserver 192.0.2.9\r\nsearch lan.example\r\noptions ndots:2\r\n", "", ""))
    show_config("seven domains", net.parse_resolv_conf("search a b c d e f g\n", "", ""))
}
