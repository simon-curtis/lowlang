import std/net
import std/net/dns

fn link(name: str, target: str) -> dns.Record {
    rec(name, dns.Data.Cname(target))
}

fn chain_script(q: dns.Message, tcp: bool) -> []Reply {
    let name = asked(q)
    let kind = kind_of(q)
    if kind == dns.type_aaaa && name != "mixed.test" {
        return say(q, [])
    }
    match name {
        "alias1.test" => say(q, [link("alias1.test", "alias2.test"), link("alias2.test", "real.test"), rec("real.test", a_data(192, 0, 2, 20))])
        "hop1.test" => say(q, [link("hop1.test", "hop2.test")])
        "hop2.test" => say(q, [link("hop2.test", "end.test")])
        "end.test" => say(q, [rec("end.test", a_data(192, 0, 2, 21))])
        "loop1.test" => say(q, [link("loop1.test", "loop2.test")])
        "loop2.test" => say(q, [link("loop2.test", "loop1.test")])
        "inloop.test" => say(q, [link("inloop.test", "inloop2.test"), link("inloop2.test", "inloop.test")])
        "self.test" => say(q, [link("self.test", "SELF.test")])
        "dangling.test" => say(q, [link("dangling.test", "nowhere.test")])
        "mixed.test" => {
            if kind == dns.type_a {
                return say(q, [link("mixed.test", "mixed-target.test"), rec("mixed-target.test", a_data(192, 0, 2, 22))])
            }
            say(q, [link("mixed.test", "mixed-target.test"), rec("mixed-target.test", aaaa_data(22))])
        }
        _ => numbered(q, name)
    }
}

fn numbered(q: dns.Message, name: str) -> []Reply {
    let prefix = name[..1]
    let index = text_to_int(name[1..name.len - 5])
    let last = if prefix == "c" { 8 } else { 9 }
    if (prefix == "c" || prefix == "d") && index >= 0 {
        if index == last {
            return say(q, [rec(name, a_data(192, 0, 2, 23))])
        }
        return say(q, [link(name, "{prefix}{index + 1}.test")])
    }
    fail_with(q, dns.rcode_name)
}

fn text_to_int(s: str) -> i64 {
    var n = 0
    for c in s {
        if c < '0' || c > '9' {
            return -1
        }
        n = n * 10 + i64(c - '0')
    }
    n
}

fn chain_tests() {
    serving(chain_script, fn(s: *Server) {
        var c = config_for(s.port)
        c.edns0 = false
        for name in ["alias1.test", "hop1.test", "loop1.test", "inloop.test", "self.test", "dangling.test", "mixed.test", "c0.test", "d0.test"] {
            let r = net.resolver(c)
            print("{name}: {outcome(r, name)}")
            show_log(s)
            truncate(mut s.log, 0)
        }
    })
}
