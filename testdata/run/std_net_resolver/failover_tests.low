import std/net
import std/net/dns
import std/time

fn good_script(q: dns.Message, tcp: bool) -> Reply[] {
    if kind_of(q) == dns.type_aaaa {
        return say(q, [])
    }
    say(q, [rec(asked(q), a_data(192, 0, 2, 40))])
}

fn servfail_script(q: dns.Message, tcp: bool) -> Reply[] {
    fail_with(q, dns.rcode_server)
}

fn refused_script(q: dns.Message, tcp: bool) -> Reply[] {
    fail_with(q, dns.rcode_refused)
}

fn nxdomain_script(q: dns.Message, tcp: bool) -> Reply[] {
    fail_with(q, dns.rcode_name)
}

fn lame_script(q: dns.Message, tcp: bool) -> Reply[] {
    var m = reply_to(q, dns.rcode_name, [])
    m.recursion_available = false
    m.authoritative = false
    [Reply { bytes: wire(m), via: 0 }]
}

fn authoritative_script(q: dns.Message, tcp: bool) -> Reply[] {
    var m = reply_to(q, dns.rcode_name, [])
    m.recursion_available = false
    m.authoritative = true
    [Reply { bytes: wire(m), via: 0 }]
}

fn mute_script(q: dns.Message, tcp: bool) -> Reply[] {
    []
}

fn pair(first: fn(dns.Message, bool) -> Reply[], second: fn(dns.Message, bool) -> Reply[], label: str, waits: bool, tune: fn(net.ResolverConfig) -> net.ResolverConfig) {
    serving(first, fn(a: *Server) {
        serving(second, fn(b: *Server) {
            var c = net.resolver_config()
            c.servers = [net.Addr { ip: [127, 0, 0, 1], port: a.port }, net.Addr { ip: [127, 0, 0, 1], port: b.port }]
            c.timeout = 150
            c.attempts = 1
            c.edns0 = false
            var r = net.resolver(tune(c))
            r.pick = fn(n: i64) -> i64 { n - 1 }
            let started = time.monotonic()
            let result = outcome(r, "pair.test")
            let elapsed = (time.monotonic() - started) / 1000000
            print("{label}: {result}")
            print("  first server: {a.log.len} queries, second server: {b.log.len} queries")
            if waits {
                print("  waited for the timeout: {elapsed >= 150}")
            }
        })
    })
}

fn same_config(c: net.ResolverConfig) -> net.ResolverConfig {
    c
}

fn failover_tests() {
    pair(servfail_script, good_script, "servfail then answer", false, same_config)
    pair(refused_script, good_script, "refused then answer", false, same_config)
    pair(mute_script, good_script, "timeout then answer", true, same_config)
    pair(nxdomain_script, good_script, "nxdomain is final", false, same_config)
    pair(authoritative_script, good_script, "authoritative nxdomain is final", false, same_config)
    pair(lame_script, good_script, "lame nxdomain tries the next server", false, same_config)
    pair(good_script, mute_script, "first server answers", false, same_config)
    pair(mute_script, mute_script, "no server answers", true, same_config)
    pair(servfail_script, servfail_script, "every server fails", false, same_config)
    pair(good_script, good_script, "rotate starts at the second server", false, fn(c: net.ResolverConfig) -> net.ResolverConfig {
        var t = c
        t.rotate = true
        t
    })
    serving(mute_script, fn(s: *Server) {
        var c = config_for(s.port)
        c.timeout = 100
        c.attempts = 3
        c.edns0 = false
        let r = net.resolver(c)
        print("three attempts: {outcome(r, "mute.test")}")
        print("  {s.log.len} queries")
        var none = net.resolver_config()
        none.servers = []
        print("no servers: {outcome(net.resolver(none), "mute.test")}")
        let dead = silent_port() or return
        var two = config_for(dead.addr.port)
        two.timeout = 100
        print("dead port: {outcome(net.resolver(two), "mute.test")}")
        net.close_socket_on(dead)
    })
}
