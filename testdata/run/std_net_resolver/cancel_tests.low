import std/cancel
import std/net
import std/net/dns
import std/time

fn cancel_later(t: *cancel.Token, millis: i64) {
    sleep(millis)
    cancel.cancel(t)
}

fn cancel_tests() {
    serving(mute_script, fn(s: *Server) {
        var c = config_for(s.port)
        c.timeout = 10000
        c.attempts = 3
        let t = cancel.token()
        var r = net.resolver(c)
        r.token = t
        spawn cancel_later(t, 100)
        let started = time.monotonic()
        let result = outcome(r, "cancel.test")
        let elapsed = (time.monotonic() - started) / 1000000
        print("cancelled while waiting: {result}")
        print("  returned within 3 seconds: {elapsed < 3000}")
        print("  queries: {s.log.len}")
        let again = outcome(r, "cancel.test")
        print("token already cancelled: {again}")
        print("  queries: {s.log.len}")
    })
}
