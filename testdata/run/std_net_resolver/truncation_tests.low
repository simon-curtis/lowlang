import std/net
import std/net/dns

fn cut(q: dns.Message, from: i64) -> Reply[] {
    var m = reply_to(q, 0, [rec(asked(q), a_data(198, 51, 100, 1)), rec(asked(q), a_data(198, 51, 100, 2))])
    m.truncated = true
    let full = wire(m)
    [Reply { bytes: full[..full.len - from], via: 0 }]
}

fn truncation_script(q: dns.Message, tcp: bool) -> Reply[] {
    let name = asked(q)
    if name == "big.test" && kind_of(q) == dns.type_a {
        if !tcp {
            return cut(q, 5)
        }
        return say(q, [rec(name, a_data(192, 0, 2, 1)), rec(name, a_data(192, 0, 2, 2)), rec(name, a_data(192, 0, 2, 3))])
    }
    if name == "empty.test" && kind_of(q) == dns.type_a {
        if !tcp {
            var m = reply_to(q, 0, [])
            m.truncated = true
            return [Reply { bytes: wire(m), via: 0 }]
        }
        return say(q, [rec(name, a_data(192, 0, 2, 4))])
    }
    if kind_of(q) == dns.type_aaaa && name != "tcponly.test" {
        return say(q, [])
    }
    if name == "tcponly.test" {
        if !tcp {
            return []
        }
        return say(q, [rec(name, kind_data(q))])
    }
    fail_with(q, dns.rcode_name)
}

fn kind_data(q: dns.Message) -> dns.Data {
    if kind_of(q) == dns.type_a {
        return a_data(192, 0, 2, 5)
    }
    aaaa_data(5)
}

fn truncation_case(s: *Server, c: net.ResolverConfig, name: str) {
    let r = net.resolver(c)
    print("{name}: {outcome(r, name)}")
    show_log(s)
    s.log.truncate(0)
}

fn truncation_tests() {
    serving(truncation_script, fn(s: *Server) {
        var c = config_for(s.port)
        truncation_case(s, c, "big.test")
        truncation_case(s, c, "empty.test")
        c.use_tcp = true
        truncation_case(s, c, "tcponly.test")
    })
}
