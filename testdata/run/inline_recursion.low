fn fact(n: i64) -> i64 {
    if n <= 1 { 1 } else { n * fact(n - 1) }
}

fn even(n: i64) -> bool {
    if n == 0 { true } else { odd(n - 1) }
}

fn odd(n: i64) -> bool {
    if n == 0 { false } else { even(n - 1) }
}

fn digit_sum(n: i64) -> i64 {
    if n < 10 { n } else { n % 10 + digit_sum(n / 10) }
}

fn collatz(n: i64, steps: i64) -> i64 {
    if n == 1 {
        steps
    } else if n % 2 == 0 {
        collatz(n / 2, steps + 1)
    } else {
        collatz(n * 3 + 1, steps + 1)
    }
}

fn wrapper(n: i64) -> i64 {
    fact(n) + digit_sum(n * 1234567)
}

fn main() {
    print(fact(10))
    print(even(10))
    print(odd(10))
    print(even(7))
    print(digit_sum(987654321))
    print(collatz(27, 0))
    print(wrapper(5))
    print(wrapper(6))
}
