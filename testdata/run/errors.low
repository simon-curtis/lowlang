enum MathError {
    DivideByZero
    Negative(value: i64)
}

enum Pair {
    Of(i64, i64)
}

fn divide(a: i64, b: i64) -> i64 ! MathError {
    if b == 0 { fail DivideByZero }
    a / b
}

fn root(n: i64) -> i64 ! MathError {
    if n < 0 { fail Negative(n) }
    var r = 0
    for (r + 1) * (r + 1) <= n { r += 1 }
    r
}

fn rootOfQuotient(a: i64, b: i64) -> i64 ! MathError {
    root(divide(a, b)?)
}

fn check(n: i64) ! MathError {
    if n < 0 { fail Negative(n) }
}

fn describe(a: i64, b: i64) -> i64 {
    rootOfQuotient(a, b) catch {
        DivideByZero => -1
        Negative(v) => v
    }
}

fn pair(a: i64, b: i64) -> Pair ! MathError {
    if a > b { fail Negative(b - a) }
    Pair.Of(a, b)
}

fn sumPair(a: i64, b: i64) -> i64 ! MathError {
    let p = pair(a, b)?
    match p {
        Of(x, y) => x + y
    }
}

fn main() ! MathError {
    print(rootOfQuotient(100, 4)?)
    print(divide(7, 0) or -1)
    print(divide(9, 3) or -1)
    print(describe(1, 0))
    print(describe(-50, 2))
    print(describe(81, 1))

    check(5)?
    check(-1) or print("caught")

    let r = root(-3) catch {
        Negative(v) => v * 10
        DivideByZero => 0
    }
    print(r)

    print(sumPair(2, 3)?)
    print(sumPair(5, 1) catch {
        Negative(v) => v
        _ => 0
    })

    check(-2)?
    print("not reached")
}
