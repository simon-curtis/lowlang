import std/csv
import std/rand
import std/sync
import std/text

fn concurrency() {
    let guard = sync.mutex()
    let group = sync.wait_group()
    let total = new(Count { n: 0 })
    for w in 0..8 {
        sync.add(group, 1)
        spawn work(guard, group, total)
    }
    sync.wait(group)
    print("total {total.n}")
    print(sync.try_lock(guard))
    print(sync.try_lock(guard))
    sync.unlock(guard)
}

struct Count {
    n: i64
}

fn work(guard: sync.Mutex, group: sync.WaitGroup, total: *Count) {
    for i in 0..1000 {
        sync.lock(guard)
        let seen = total.n
        sleep(0)
        total.n = seen + 1
        sync.unlock(guard)
    }
    sync.done(group)
}

fn randomness() {
    var r = rand.seeded(42)
    var again = rand.seeded(42)
    print(r.next() == again.next())
    let counts = [0, 0, 0]
    for i in 0..3000 {
        counts[r.below(3)] += 1
    }
    print(counts[0] > 900 && counts[1] > 900 && counts[2] > 900)
    let x = r.float()
    print(x >= 0.0 && x < 1.0)
    var deck = [1, 2, 3, 4, 5]
    rand.shuffle(mut r, mut deck)
    var sum = 0
    for d in deck {
        sum += d
    }
    print(sum)
    print(rand.between(mut r, 5, 5))
    let empty: i64[] = []
    print(rand.pick(mut r, empty) ?? -1)
}

fn tables() {
    let src = "name,notes\r\nada,\"says \"\"hi\"\"\"\nbob,\"two\nlines\"\n\nlast,\n"
    let records = csv.parse(src) or []
    print(records.len)
    for r in records {
        print("{r.len}: {text.join(r, "|")}")
    }
    print(csv.format([["a", "b,c"], [" x", "say \"q\""]]))
    let _ = csv.parse("a,\"open\n") catch {
        UnterminatedQuote(line) => {
            print("unterminated quote from line {line}")
            []
        }
        BareQuote(line) => []
    }
}

fn main() {
    concurrency()
    randomness()
    tables()
}
