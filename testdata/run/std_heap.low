import std/container/heap
import std/text

fn ordering() {
    var h = heap.heap(fn(a: i64, b: i64) -> bool { a < b })
    for x in [5, 1, 4, 1, 3, 9, 2] {
        h.insert(x)
    }
    print("{h.size()} {h.peek() ?? -1}")
    var out: []str = []
    for h.size() > 0 {
        push(mut out, "{h.pop() ?? -1}")
    }
    print(text.join(out, " "))
    print(h.pop() ?? -1)
}

fn largest_first() {
    var h = heap.heap(fn(a: i64, b: i64) -> bool { a > b })
    for x in [3, 8, 1, 8, 5] {
        h.insert(x)
    }
    var out: []str = []
    for h.size() > 0 {
        push(mut out, "{h.pop() ?? -1}")
    }
    print(text.join(out, " "))
}

fn volume() {
    var h = heap.heap(fn(a: i64, b: i64) -> bool { a < b })
    var seed = 11
    for _ in 0..200000 {
        seed = (seed * 1103515245 + 12345) % 2147483648
        h.insert(seed % 100000)
    }
    var previous = -1
    var sorted = true
    var popped = 0
    for h.size() > 0 {
        let next = h.pop() ?? -1
        if next < previous {
            sorted = false
        }
        previous = next
        popped += 1
    }
    print("{popped} {sorted}")
}

fn main() {
    ordering()
    largest_first()
    volume()
}
