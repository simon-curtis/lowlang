struct Node {
    value: i64
    next: *Node?
}

fn push_front(head: *Node?, value: i64) -> *Node {
    new(Node { value: value, next: head })
}

fn depth(list: *Node?) -> i64 {
    match list {
        some(node) => 1 + depth(node.next)
        none => 0
    }
}

fn fib(n: i64) -> i64 {
    if n < 2 {
        return n
    }
    fib(n - 1) + fib(n - 2)
}

fn clamp_then_work(n: i64, limit: i64) -> i64 {
    if n <= 0 {
        return 0
    }
    if n > limit {
        return limit
    }
    var total = 0
    for i in 0..n {
        total += fib(i % 12) + i
    }
    total
}

fn guarded_sum(xs: []i64, from: i64) -> i64 {
    if from >= xs.len {
        return -1
    }
    var total = 0
    for i in from..xs.len {
        total += fib(xs[i] % 15)
    }
    total
}

fn search(list: *Node?, want: i64, hops: i64) -> i64 {
    match list {
        none => -1
        some(node) => {
            if node.value == want {
                return hops
            }
            search(node.next, want, hops + 1)
        }
    }
}

fn caller_keeps(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64) -> i64 {
    let one = clamp_then_work(0, 10)
    let two = clamp_then_work(50, 10)
    let three = clamp_then_work(9, 100)
    let four = guarded_sum([1, 2, 3], 7)
    let five = guarded_sum([4, 9, 13], 1)
    a * 1 + b * 2 + c * 3 + d * 4 + e * 5 + f * 6 + one + two + three + four + five
}

fn climb(n: i64, acc: i64) -> i64 {
    if n == 0 {
        return acc
    }
    let here = acc * 31 + n
    let rest = climb(n - 1, here % 1000003)
    rest + (here & 255)
}

fn even(n: i64) -> bool {
    if n == 0 {
        return true
    }
    odd(n - 1)
}

fn odd(n: i64) -> bool {
    if n == 0 {
        return false
    }
    even(n - 1)
}

fn main() {
    print(fib(0))
    print(fib(1))
    print(fib(24))
    print(clamp_then_work(0, 5))
    print(clamp_then_work(100, 5))
    print(clamp_then_work(40, 500))
    print(guarded_sum([1, 2, 3], 3))
    print(guarded_sum([7, 11, 13, 14], 1))
    var list: *Node? = none
    for i in 0..200 {
        list = push_front(list, i * 3)
    }
    print(depth(list))
    print(search(list, 597, 0))
    print(search(list, 598, 0))
    print(caller_keeps(1, 2, 3, 4, 5, 6))
    print(climb(0, 5))
    print(climb(20000, 1))
    print(even(10001))
    print(odd(10001))
    print(even(50000))
}
