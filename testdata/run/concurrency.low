struct Node {
    value: i64
    next: *Node?
}

fn build(n: i64) -> *Node {
    var head = new(Node { value: 0, next: none })
    for i in 1..n {
        head = new(Node { value: i, next: head })
    }
    head
}

fn total(list: *Node) -> i64 {
    var sum = 0
    var at: *Node? = list
    for {
        match at {
            some(node) => {
                sum += node.value
                at = node.next
            }
            none => return sum
        }
    }
}

fn worker(jobs: chan[i64], results: chan[i64]) {
    for j in jobs {
        results <- j * 2
    }
}

fn churn(out: chan[i64]) {
    let keep = build(1000)
    var junk = 0
    for i in 0..200 {
        junk += total(build(100)) - 4950
    }
    out <- total(keep) + junk
}

fn spin(stop: chan[bool]) {
    var n = 0
    for {
        n += 1
        if n % 1000000 == 0 {
            let done = select {
                <-stop => true
                else => false
            }
            if done {
                return
            }
        }
    }
}

fn main() {
    let jobs = chan[i64](10)
    let results = chan[i64](10)
    for w in 0..4 {
        spawn worker(jobs, results)
    }
    spawn fn() {
        for i in 0..100 {
            jobs <- i
        }
        close(jobs)
    }()
    var sum = 0
    for i in 0..100 {
        sum += (<-results) ?? 0
    }
    print(sum)

    let buffered = chan[str](2)
    buffered <- "x"
    buffered <- "y"
    close(buffered)
    print((<-buffered) ?? "none")
    print((<-buffered) ?? "none")
    print((<-buffered) ?? "none")

    let ping = chan[str]()
    let pong = chan[str]()
    spawn fn() {
        for m in ping {
            pong <- "{m}!"
        }
    }()
    ping <- "a"
    print((<-pong) ?? "")

    let quiet = chan[i64]()
    let timed = select {
        v = <-quiet => v ?? -1
        after(20) => 99
    }
    print(timed)
    let polled = select {
        <-quiet => 1
        else => 2
    }
    print(polled)

    let slot = chan[i64](1)
    let sent = select {
        slot <- 7 => "sent"
        after(1000) => "late"
    }
    print(sent)
    let back = select {
        v = <-slot => v ?? 0
        <-quiet => -1
    }
    print(back)

    let out = chan[i64]()
    for i in 0..200 {
        spawn churn(out)
    }
    var churned = 0
    for i in 0..200 {
        churned += (<-out) ?? 0
    }
    print(churned)

    let stop = chan[bool](64)
    for i in 0..32 {
        spawn spin(stop)
    }
    sleep(30)
    print("main ran")
    for i in 0..32 {
        stop <- true
    }

    let a = chan[i64]()
    let b = chan[i64]()
    spawn fn() {
        for v in a {
            b <- v + 1
        }
        close(b)
    }()
    var x = 0
    for i in 0..100000 {
        a <- x
        x = (<-b) ?? 0
    }
    close(a)
    print(x)
    print((<-b) ?? -1)
}
