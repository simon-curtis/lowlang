import std/builder
import std/html
import std/text

fn describe(n: *html.Node?) -> str {
    let node = n ?? return "none"
    let id = html.attr(node, "id") ?? ""
    "{html.local_name(node)}#{id}"
}

fn names(nodes: *html.Node[]) -> str {
    var parts: str[] = []
    for n in nodes {
        parts.push(describe(n))
    }
    text.join(parts, " ")
}

fn compile_or_exit(source: str) -> html.Selector {
    html.compile(source) or panic("cannot compile {source}")
}

fn report(source: str) {
    let shown = if source.len > 40 { "{source[..20]}... ({source.len} bytes)" } else { source }
    html.compile(source) catch {
        Invalid(at, message) => {
            print("{text.quote(shown)} -> {at}: {message}")
            return
        }
    }
    print("{text.quote(shown)} -> ok")
}

fn nested(depth: i64) -> str {
    var b = builder.builder()
    for i in 0..depth {
        builder.write(mut b, "<div id=d{i}>")
    }
    builder.write(mut b, "<span id=leaf></span>")
    builder.write_repeat(mut b, "</div>", depth)
    builder.to_str(b)
}

fn main() {
    let parsed = html.parse("<ul id=l><li id=a class=x>A<ul id=inner><li id=b>B</li></ul></li><li id=c>C</li></ul><template id=t><li id=in_template></li></template><p id=p>t</p>")
    let root = parsed.root

    let li = compile_or_exit("li")
    print("query_all li: {names(html.query_all(root, li))}")
    print("query li: {describe(html.query(root, li))}")

    let list = html.query(root, compile_or_exit("#l")) ?? return
    print("scoped: {names(html.query_all(list, compile_or_exit("ul")))}")
    print("scoped ancestors: {names(html.query_all(list, compile_or_exit("body > ul li")))}")
    print("root excluded: {describe(html.query(list, compile_or_exit("#l")))}")

    let b = html.query(root, compile_or_exit("#b")) ?? return
    print("closest self: {describe(html.closest(b, compile_or_exit("li")))}")
    print("closest ancestor: {describe(html.closest(b, compile_or_exit("li:not(#b)")))}")
    print("closest ul: {describe(html.closest(b, compile_or_exit("ul")))}")
    print("closest none: {describe(html.closest(b, compile_or_exit("table")))}")
    print("closest html: {describe(html.closest(b, compile_or_exit(":root")))}")

    let text_node = html.create_text("x")
    print("text matches: {html.matches(text_node, compile_or_exit("*"))}")
    print("document matches: {html.matches(root, compile_or_exit("*"))}")
    print("text closest: {describe(html.closest(text_node, compile_or_exit("*")))}")

    let template = html.query(root, compile_or_exit("#t")) ?? return
    let contents = html.template_contents(template) ?? return
    print("template skipped: {describe(html.query(root, compile_or_exit("#in_template")))}")
    print("template contents: {describe(html.query(contents, compile_or_exit("#in_template")))}")
    print("template parent: {html.matches(html.first_child(contents) ?? root, compile_or_exit("template > li"))}")

    let detached = html.create_element(html.Namespace.Html, "div", [])
    let child = html.create_element(html.Namespace.Html, "span", [])
    html.append_child(detached, child) or return
    html.set_attr(child, "class", "k")
    print("detached: {html.matches(child, compile_or_exit("div > span.k"))} {html.matches(child, compile_or_exit("DIV>SPAN.k"))}")
    print("detached root: {html.matches(detached, compile_or_exit(":root"))}")
    let fragment = html.create_fragment()
    html.append_child(fragment, detached) or return
    print("fragment child root: {html.matches(detached, compile_or_exit(":root"))}")

    let svg = html.parse_body("<svg><foreignObject><p>x</p></foreignObject></svg>")
    print("foreign case: {names(html.query_all(svg.root, compile_or_exit("foreignObject")))} {names(html.query_all(svg.root, compile_or_exit("foreignobject")))}")

    let deep = html.parse_body(nested(3000))
    print("deep descendants: {html.query_all(deep.root, compile_or_exit("div div")).len}")
    print("deep none: {html.query_all(deep.root, compile_or_exit("section div")).len}")
    print("deep child chain: {describe(html.query(deep.root, compile_or_exit("#d0 > #d1 > #d2 > #d3")))}")
    print("deep leaf: {describe(html.query(deep.root, compile_or_exit("div > span#leaf")))}")

    report("div p")
    report("a[")
    report("a[b")
    report("a[b=")
    report("a[b=\"c")
    report("a[b=c d]")
    report("a[b!=c]")
    report("a[1]")
    report("a b >")
    report("> a")
    report("a >> b")
    report("a,")
    report(",a")
    report("")
    report("  ")
    report("a$")
    report("a b$")
    report(".")
    report("#")
    report(".1")
    report("a#1")
    report(":")
    report("::before")
    report(":hover")
    report("a:Hover")
    report(":nth-child")
    report(":nth-child(")
    report(":nth-child()")
    report(":nth-child(n")
    report(":nth-child(2n+)")
    report(":nth-child(2 n)")
    report(":nth-child(1.5)")
    report(":nth-child(2n+1 of)")
    report(":nth-child(2n+1 ofp)")
    report(":nth-of-type(1 of p)")
    report(":not()")
    report(":not(")
    report(":not(p")
    report(":not(p,)")
    report(":has()")
    report(":has(> )")
    report(":has(:has(a))")
    report(":has(:not(:has(a)))")
    report(":first-child()")
    report("svg|a")
    report("*|a")
    report("a[ns|b]")
    report("a:is(p, !, span)")
    report("a:is()")
    report("a:is(")
    report("a:is(p")
    report("a /* x */ b")
    report("a/* x */b")
    report("/* x */")
    report("\\")
    report("a\\")
    report("\\41 b")
    report("é")
    report("😀")
    report("a{text.from_char(127)}")

    report(text.repeat("a ", 1001))
    report("{text.repeat("a > ", 500)}a")
    report("{text.repeat(":not(", 33)}a{text.repeat(")", 33)}")
    report("{text.repeat(":not(", 32)}a{text.repeat(")", 32)}")
}
