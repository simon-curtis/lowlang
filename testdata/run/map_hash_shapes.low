struct Point {
    x: i64
    y: i64
}

fn mix(state: i64, value: i64) -> i64 {
    (state * 1000003 + value) % 1000000007
}

fn text_of(length: i64, seed: i64, flip: bool) -> str {
    var b: []u8 = []
    for i in 0..length {
        var c = u8(seed * 31 + i * 17 + length)
        if flip && i == length - 1 {
            c = c ^ 1
        }
        push(mut b, c)
    }
    str(b)
}

fn order(m: [str: i64]) -> i64 {
    var digest = 0
    for k, v in m {
        digest = mix(mix(digest, k.len), v)
        for c in k {
            digest = mix(digest, i64(c))
        }
    }
    digest
}

fn check_length(length: i64, count: i64) -> i64 {
    var m: [str: i64] = [:]
    for seed in 0..count {
        m[text_of(length, seed, false)] = seed
    }
    let distinct = m.len
    var digest = mix(length, distinct)
    for seed in 0..count {
        let found = m[text_of(length, seed, false)] ?? -1
        if length > 0 && found != seed {
            return -1
        }
        digest = mix(digest, found)
    }
    if length > 0 && (m[text_of(length, 0, true)] ?? -1) != -1 {
        return -2
    }
    for seed in 0..count {
        if seed % 2 == 0 {
            delete(mut m, text_of(length, seed, false))
        }
    }
    delete(mut m, text_of(length, 0, true))
    var live = 0
    for seed in 0..count {
        let found = m[text_of(length, seed, false)] ?? -1
        if length > 0 && seed % 2 == 0 && found != -1 {
            return -3
        }
        if length > 0 && seed % 2 == 1 && found != seed {
            return -4
        }
        if found != -1 {
            live += 1
        }
    }
    for seed in 0..count {
        if seed % 2 == 0 {
            m[text_of(length, seed, false)] = seed + 100
        }
    }
    for seed in 0..count {
        let found = m[text_of(length, seed, false)] ?? -1
        let want = if seed % 2 == 0 { seed + 100 } else { seed }
        if length > 0 && found != want {
            return -5
        }
    }
    if length > 0 && m.len != count {
        return -6
    }
    mix(mix(digest, live), order(m))
}

fn strings() {
    var total = 0
    var bad = 0
    for length in 0..65 {
        let r = check_length(length, 24)
        if r < 0 {
            bad += 1
            print("length {length} failed {r}")
        }
        total = mix(total, r)
        if length % 8 == 0 {
            print("length {length} {r}")
        }
    }
    for length in [65, 79, 80, 81, 100, 127, 128, 129, 255, 256, 1000, 4097] {
        let r = check_length(length, 24)
        if r < 0 {
            bad += 1
            print("length {length} failed {r}")
        }
        total = mix(total, r)
        print("length {length} {r}")
    }
    print("strings bad={bad} total={total}")
}

fn check_integers(name: str, n: i64, key: fn(i64) -> i64) {
    var m: [i64: i64] = [:]
    for i in 0..n {
        m[key(i)] = i
    }
    var wrong = 0
    for i in 0..n {
        if (m[key(i)] ?? -1) != i {
            wrong += 1
        }
    }
    for i in 0..n {
        if i % 3 == 0 {
            delete(mut m, key(i))
        }
    }
    for i in 0..n {
        let found = m[key(i)] ?? -1
        if (i % 3 == 0 && found != -1) || (i % 3 != 0 && found != i) {
            wrong += 1
        }
    }
    for i in 0..n {
        if i % 6 == 0 {
            m[key(i)] = i + n
        }
    }
    var digest = 0
    var count = 0
    for k, v in m {
        digest = mix(mix(digest, k), v)
        count += 1
    }
    print("{name} len={m.len} count={count} wrong={wrong} digest={digest}")
}

fn times_4096(i: i64) -> i64 { i * 4096 }
fn shift_20(i: i64) -> i64 { i << 20 }
fn shift_32(i: i64) -> i64 { i << 32 }
fn shift_52(i: i64) -> i64 { i << 52 }
fn negative(i: i64) -> i64 { -i }
fn complement(i: i64) -> i64 { ~i }
fn bytes_repeat(i: i64) -> i64 { i * 0x0101010101010101 }
fn power_of_two(i: i64) -> i64 { 1 << (i % 63) }
fn stride_seven(i: i64) -> i64 { i * 7 }

fn integers() {
    check_integers("i*7", 5000, stride_seven)
    check_integers("i*4096", 5000, times_4096)
    check_integers("i<<20", 5000, shift_20)
    check_integers("i<<32", 5000, shift_32)
    check_integers("i<<52", 1500, shift_52)
    check_integers("-i", 5000, negative)
    check_integers("~i", 5000, complement)
    check_integers("i*0x0101..", 5000, bytes_repeat)
    check_integers("1<<(i%63)", 63, power_of_two)
}

fn others() {
    var flags: [bool: i64] = [:]
    flags[true] = 1
    flags[false] = 2
    flags[true] += 10
    print("bool {flags[true] ?? -1} {flags[false] ?? -1} {flags.len}")

    let a = new(Point { x: 1, y: 2 })
    let b = new(Point { x: 3, y: 4 })
    let c = new(Point { x: 5, y: 6 })
    var seen: [*Point: i64] = [:]
    seen[a] = 1
    seen[b] = 2
    seen[c] = 3
    seen[a] += 40
    delete(mut seen, b)
    seen[b] = 9
    var line = ""
    for p, v in seen {
        line = "{line} {p.x}:{v}"
    }
    print("pointers {seen.len}{line}")

    var words: [str: i64] = [:]
    for i in 0..300 {
        words["word{i % 97}"] += i
    }
    var out = ""
    var shown = 0
    for k, v in words {
        if shown < 5 {
            out = "{out} {k}={v}"
        }
        shown += 1
    }
    print("words {words.len}{out}")
}

fn main() {
    strings()
    integers()
    others()
}
