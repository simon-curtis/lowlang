struct Node {
    value: i64
    next: *Node?
}

enum Color {
    Red
    Green
}

fn find(xs: []i64, target: i64) -> i64? {
    for i, x in xs {
        if x == target {
            return i
        }
    }
    none
}

fn first(xs: []str) -> str? {
    if xs.len == 0 {
        return none
    }
    xs[0]
}

fn total(list: *Node?) -> i64 {
    match list {
        some(node) => node.value + total(node.next)
        none => 0
    }
}

fn describe(n: i64?) -> str {
    match n {
        some(v) => "found {v}"
        none => "missing"
    }
}

fn main() {
    let xs = [5, 7, 9]
    print(describe(find(xs, 7)))
    print(describe(find(xs, 4)))
    print(find(xs, 9) ?? -1)
    print(find(xs, 1) ?? -1)

    let maybe: i64? = none
    let fallback: i64? = 3
    print((maybe ?? fallback) ?? 0)
    print(maybe ?? fallback ?? 0)

    var list: *Node? = none
    for i in 1..5 {
        list = new(Node { value: i, next: list })
    }
    print(total(list))

    let names: []str = []
    print(first(names) ?? "nobody")
    print(first(["Ada"]) ?? "nobody")

    let c: Color? = Green
    match c {
        some(color) => match color {
            Red => print("red")
            Green => print("green")
        }
        none => print("no colour")
    }

    let empty: u8? = none
    let full: u8? = 200
    print(full ?? 0)
    print(empty ?? 1)

    let ys: []i64? = [1, 2]
    print((ys ?? []).len)

    let nested: i64? = if xs.len > 2 { find(xs, 5) } else { none }
    print(nested ?? -1)
    var counter: i64? = none
    counter = 41
    print((counter ?? 0) + 1)
}
