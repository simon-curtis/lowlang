import std/file
import std/io
import std/net
import std/sys

fn receive_text(s: net.Socket) -> str {
    let buf = io.buffer(64)
    let p = net.receive_from(s, buf) or return "receive failed"
    str(buf[..p.size])
}

fn bind_outcome(path: str) -> str {
    using s = net.bind_unix_datagram(path) catch {
        AddrInUse => return "in use"
        _ => return "other"
    }
    "bound"
}

fn send_outcome(from: net.Socket, to: net.Addr, size: i64) -> str {
    let n = net.send_to(from, io.buffer(size), to) catch {
        NotFound => return "not found"
        Refused => return "refused"
        TooLarge => return "too large"
        _ => return "other"
    }
    "sent {n}"
}

fn write_outcome(fd: i64) -> str {
    sys.write_all(fd, bytes("more")) catch {
        Denied => return "denied"
        _ => return "other"
    }
    "written"
}

fn truncate_outcome(fd: i64) -> str {
    sys.ftruncate(fd, 1) catch {
        Denied => return "denied"
        _ => return "other"
    }
    "truncated"
}

fn datagrams(dir: str) ! io.Error {
    let path = "{dir}/server.sock"
    using server = net.bind_unix_datagram(path)?
    net.set_receive_timeout(server, 2000)
    print("bound path {server.handle.addr.path == path}")
    print("socket file exists {file.exists(path)}")

    using client = net.unix_datagram()?
    print("client unbound {client.handle.addr.path.len == 0}")
    let target = net.unix_addr(path)?
    print("sent {net.send_to(client, bytes("one"), target)?}")
    let buf = io.buffer(64)
    let first = net.receive_from(server, buf)?
    print("received {str(buf[..first.size])} from unbound {first.from.path.len == 0}")

    let named = "{dir}/client.sock"
    using peer = net.bind_unix_datagram(named)?
    net.set_receive_timeout(peer, 2000)
    net.send_to(peer, bytes("two"), target)?
    let second = net.receive_from(server, buf)?
    print("received {str(buf[..second.size])} from named sender {second.from.path == named}")
    net.send_to(server, bytes("reply"), second.from)?
    print(receive_text(peer))

    net.send_to(client, [], target)?
    let empty = net.receive_from(server, buf)?
    print("empty datagram {empty.size}")

    print("second bind {bind_outcome(path)}")
    print("missing socket {send_outcome(client, net.unix_addr("{dir}/missing.sock")?, 1)}")

    net.close_socket(server)
    print("file after close {file.exists(path)}")
    print("closed socket {send_outcome(client, target, 1)}")
}

fn abstract_name() ! io.Error {
    let name = "@lowlang-net-datagram"
    using server = net.bind_unix_datagram(name)?
    net.set_receive_timeout(server, 2000)
    using client = net.unix_datagram()?
    net.send_to(client, bytes("abstract"), net.unix_addr(name)?)?
    print(receive_text(server))
}

fn shared_file(content: str) -> i64 ! io.Error {
    let fd = sys.memory_file("fixture")?
    sys.write_all(fd, bytes(content))?
    sys.seal(fd)?
    fd
}

fn read_all(fd: i64) -> str ! io.Error {
    sys.seek(fd, 0, sys.Seek.FromStart)?
    let buf = io.buffer(64)
    let n = sys.read(fd, buf)?
    str(buf[..n])
}

fn descriptors(dir: str) ! io.Error {
    let path = "{dir}/fd.sock"
    using server = net.bind_unix_datagram(path)?
    net.set_receive_timeout(server, 2000)
    using client = net.unix_datagram()?
    let target = net.unix_addr(path)?

    let memory = shared_file("memory contents")?
    print("sent with descriptor {net.send_to_with_fd(client, bytes("tag"), target, memory)?}")
    let buf = io.buffer(64)
    let p = net.receive_from_with_fd(server, buf)?
    print("payload {str(buf[..p.size])}")
    let got = p.descriptor ?? -1
    print("descriptor passed {got >= 0} different {got != memory}")
    print("contents {read_all(got)?}")
    print("sealed write {write_outcome(got)} truncate {truncate_outcome(got)}")
    sys.close_fd(got)

    net.send_to_with_fd(client, [], target, memory)?
    let bare = net.receive_from_with_fd(server, buf)?
    let again = bare.descriptor ?? -1
    print("empty payload {bare.size} descriptor {again >= 0}")
    print("contents {read_all(again)?}")
    sys.close_fd(again)

    net.send_to(client, bytes("plain"), target)?
    let plain = net.receive_from_with_fd(server, buf)?
    print("plain datagram {str(buf[..plain.size])} descriptor {plain.descriptor == none}")

    net.send_to_with_fd(client, bytes("plain"), target, memory)?
    let ignored = net.receive_from(server, buf)?
    print("receive without descriptor {str(buf[..ignored.size])}")
    sys.close_fd(memory)
}

fn oversize(dir: str) ! io.Error {
    let path = "{dir}/big.sock"
    using server = net.bind_unix_datagram(path)?
    using client = net.unix_datagram()?
    print("oversize datagram {send_outcome(client, net.unix_addr(path)?, 8388608)}")
}

fn main() ! io.Error {
    let dir = file.temp_dir("lowdgram")?
    datagrams(dir)?
    abstract_name()?
    descriptors(dir)?
    oversize(dir)?
    file.remove_all(dir)?
}
