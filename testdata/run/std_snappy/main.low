import std/compress/snappy
import std/hash
import std/io
import std/text

fn generated(n: i64, start: u64) -> []u8 {
    let words = ["alpha ", "beta ", "gamma ", "delta ", "stream ", "window ", "huffman ", "\n"]
    var out: []u8 = []
    var seed = start
    for out.len < n {
        seed = seed * 6364136223846793005 + 1442695040888963407
        text.append(mut out, words[i64(seed >> 61)])
    }
    out[..n]
}

fn noise(n: i64, start: u64) -> []u8 {
    let out = io.buffer(n)
    var seed = start
    for i in 0..n {
        seed = seed * 6364136223846793005 + 1442695040888963407
        out[i] = u8(seed >> 56)
    }
    out
}

fn repeated(n: i64, v: u8) -> []u8 {
    let out = io.buffer(n)
    for i in 0..n {
        out[i] = v
    }
    out
}

fn joined(parts: [][]u8) -> []u8 {
    var out: []u8 = []
    for p in parts {
        io.append(mut out, p)
    }
    out
}

fn unhex(s: str) -> []u8 {
    text.decode_hex(s) catch {
        _ => []
    }
}

fn same(a: []u8, b: []u8) -> bool {
    a.len == b.len && hash.crc32(a) == hash.crc32(b)
}

fn block_outcome(packed: []u8, limit: i64, want: []u8) -> str {
    let got = snappy.decompress_block(packed, limit) catch {
        Malformed => return "Malformed"
        TooLarge => return "TooLarge"
        _ => return "other"
    }
    if same(got, want) { "ok" } else { "mismatch" }
}

fn frame_outcome(packed: []u8, limit: i64, want: []u8) -> str {
    let got = snappy.decompress(packed, limit) catch {
        Malformed => return "Malformed"
        TooLarge => return "TooLarge"
        Unsupported => return "Unsupported"
        _ => return "other"
    }
    if same(got, want) { "ok" } else { "mismatch" }
}

fn block_summary(label: str, packed: []u8) {
    let got = snappy.decompress_block(packed, 1 << 24) catch {
        _ => {
            print("{label} failed")
            return
        }
    }
    print("{label} {got.len} crc {hash.crc32(got)}")
}

fn frame_summary(label: str, packed: []u8) {
    let got = snappy.decompress(packed, 1 << 24) catch {
        _ => {
            print("{label} failed")
            return
        }
    }
    print("{label} {got.len} crc {hash.crc32(got)}")
}

fn literal_vector(n: i64) -> []u8 {
    var size: []u8 = []
    var v = n
    for v >= 128 {
        push(mut size, u8(v | 128))
        v >>= 7
    }
    push(mut size, u8(v))
    let body = noise(n, 31)
    var tag: []u8 = []
    let width = if n - 1 < 256 { 1 } else if n - 1 < 65536 { 2 } else if n - 1 < 1 << 24 { 3 } else { 4 }
    push(mut tag, u8((59 + width) << 2))
    for k in 0..width {
        push(mut tag, u8((n - 1) >> (8 * k)))
    }
    joined([size, tag, body])
}

fn marked(units: i64, start: u64) -> []u8 {
    var out: []u8 = []
    for i in 0..units {
        io.append(mut out, noise(12, start + u64(i)))
        text.append(mut out, "MARK")
    }
    out
}

fn literals() {
    for n in [61, 256, 257, 300, 65536, 70000] {
        print("literal {n} {block_outcome(literal_vector(n), 1 << 24, noise(n, 31))}")
    }
    let wide = joined([unhex("05fc04000000"), bytes("hello")])
    print("literal four byte length {block_outcome(wide, 1 << 24, bytes("hello"))}")
}

fn vectors() {
    let empty: []u8 = []
    print("empty {block_outcome(unhex("00"), 100, empty)}")
    print("short literal {block_outcome(unhex("051068656c6c6f"), 100, bytes("hello"))}")
    print("copy 1 byte offset {block_outcome(unhex("080c6162636401" + "04"), 100, bytes("abcdabcd"))}")
    print("copy 2 byte offset {block_outcome(unhex("0a046162" + "1e0200"), 100, bytes("ababababab"))}")
    print("copy 4 byte offset {block_outcome(unhex("0808" + "78797a" + "13" + "03000000"), 100, bytes("xyzxyzxy"))}")
    print("overlap {block_outcome(unhex("0b0061" + "260100"), 100, repeated(11, 'a'))}")
    let far = noise(300, 32)
    let wanted = joined([far, far[..4]])
    let high = joined([unhex("b002" + "f42b01"), far, unhex("212c")])
    print("copy 1 byte offset with high bits {block_outcome(high, 1000, wanted)}")
    print("lengths {snappy.decoded_length(unhex("00")) catch -1} {snappy.decoded_length(unhex("40")) catch -1} {snappy.decoded_length(unhex("808001")) catch -1} {snappy.decoded_length(unhex("ffffffff0f")) catch -1}")
    print("length overflow {snappy.decoded_length(unhex("8080808010")) catch -1}")
    print("length unterminated {snappy.decoded_length(unhex("ffffffffff01")) catch -1}")
    print("length missing {snappy.decoded_length(unhex("")) catch -1}")
}

fn invalid() {
    let empty: []u8 = []
    print("offset zero {block_outcome(unhex("0800610d00"), 100, empty)}")
    print("offset before start {block_outcome(unhex("0800610d02"), 100, empty)}")
    print("too short {block_outcome(unhex("050c61626364"), 100, empty)}")
    print("too long {block_outcome(unhex("030c61626364"), 100, empty)}")
    print("truncated literal {block_outcome(unhex("051068656c6c"), 100, empty)}")
    print("truncated copy {block_outcome(unhex("0808" + "78797a" + "13" + "0300"), 100, empty)}")
    print("truncated literal length {block_outcome(unhex("05f4"), 100, empty)}")
    print("copy past end {block_outcome(unhex("0508" + "78797a" + "1e0300"), 100, empty)}")
    print("no header {block_outcome(empty, 100, empty)}")
    print("bomb small limit {block_outcome(unhex("ffffffff0f"), 1 << 20, empty)}")
    print("bomb large limit {block_outcome(unhex("ffffffff0f"), 1 << 40, empty)}")
    print("bomb with body {block_outcome(unhex("ffffffff0f0c61626364"), 1 << 40, empty)}")
}

fn references() {
    block_summary("block text", bytes(embed("text.snappy")))
    block_summary("block run", bytes(embed("run.snappy")))
    block_summary("block noise", bytes(embed("noise.snappy")))
    frame_summary("frame hello", bytes(embed("hello.sz")))
    frame_summary("frame text", bytes(embed("text.sz")))
    frame_summary("frame mixed", bytes(embed("mixed.sz")))
    let hello = bytes(embed("hello.sz"))
    print("hello chunk {hello[10]} size {hello[11]} checksum {text.encode_hex(hello[14..18])}")
    let long = bytes(embed("text.sz"))
    print("text chunk {long[10]}")
}

fn block_round_trips() {
    let empty: []u8 = []
    let names = ["empty", "byte", "hello", "text", "noise", "run", "repeat"]
    let far = marked(2000, 41)
    let apart = joined([far, repeated(40000, 0), far])
    let inputs = [empty, bytes("a"), bytes("hello world"), generated(300000, 9), noise(100000, 10), repeated(500000, 7), apart]
    for i, data in inputs {
        let packed = snappy.compress_block(data)
        let declared = snappy.decoded_length(packed) catch -1
        print("block {names[i]} {block_outcome(packed, 1 << 24, data)} smaller {packed.len < data.len} length {declared == data.len}")
    }
    print("long distance copy {snappy.compress_block(apart).len < far.len + 3000}")
    let sizes = [1, 3, 4, 5, 11, 12, 14, 15, 16, 59, 60, 61, 63, 64, 65, 67, 68, 69, 127, 128, 129]
    var good = 0
    for n in sizes {
        let data = joined([generated(n, 51), repeated(n, 3), generated(n, 51)])
        if block_outcome(snappy.compress_block(data), 1 << 24, data) == "ok" {
            good += 1
        }
    }
    print("small sizes {good == sizes.len}")
}

fn frame_round_trips() {
    let empty: []u8 = []
    let names = ["empty", "byte", "hello", "text", "noise", "run", "edge 65535", "edge 65536", "edge 65537"]
    let inputs = [empty, bytes("a"), bytes("hello world"), generated(300000, 9), noise(100000, 10), repeated(500000, 7), generated(65535, 12), generated(65536, 13), generated(65537, 14)]
    for i, data in inputs {
        let packed = snappy.compress(data)
        print("frame {names[i]} {frame_outcome(packed, 1 << 24, data)} smaller {packed.len < data.len}")
    }
    let small_noise = noise(1000, 15)
    let small_text = generated(1000, 16)
    print("small noise {frame_outcome(snappy.compress(small_noise), 1 << 24, small_noise)} text {frame_outcome(snappy.compress(small_text), 1 << 24, small_text)}")
}

fn trickle(data: []u8) -> *io.Reader {
    var at = 0
    let stream = io.Stream {
        read: fn(buf) {
            if at >= data.len {
                0
            } else {
                let want = if buf.len < 5 { buf.len } else { 5 }
                let n = if want < data.len - at { want } else { data.len - at }
                for i in 0..n {
                    buf[i] = data[at + i]
                }
                at += n
                n
            }
        }
        write: fn(buf) -> i64 ! io.Error { fail Unsupported }
        close: fn() {}
    }
    io.reader(stream)
}

fn streaming() ! io.Error {
    let data = joined([generated(200000, 12), noise(30000, 13), repeated(100000, 1), generated(100000, 12)])
    var packed: []u8 = []
    let sink: fn([]u8) ! io.Error = fn(b) { io.append(mut packed, b) }
    let e = snappy.encoder(sink)
    var at = 0
    var pieces = 0
    for at < data.len {
        let n = if at + 777 > data.len { data.len - at } else { 777 }
        snappy.encode(e, data[at..at + n])?
        at += n
        pieces += 1
        if pieces % 97 == 0 {
            snappy.flush(e)?
        }
    }
    snappy.finish(e)?
    var out: []u8 = []
    var chunks = 0
    var largest = 0
    let collect: fn([]u8) ! io.Error = fn(b) {
        chunks += 1
        if b.len > largest {
            largest = b.len
        }
        io.append(mut out, b)
    }
    snappy.decode(trickle(packed), collect, 1 << 24)?
    print("stream {same(out, data)} chunked {chunks > 8 && largest <= 65536}")
    print("stream buffered {frame_outcome(packed, 1 << 24, data)}")
    var idle: []u8 = []
    let quiet: fn([]u8) ! io.Error = fn(b) { io.append(mut idle, b) }
    let e2 = snappy.encoder(quiet)
    snappy.finish(e2)?
    print("stream empty {idle.len} {frame_outcome(idle, 100, [])}")
}

fn chunk(kind: u8, body: []u8) -> []u8 {
    joined([[kind, u8(body.len), u8(body.len >> 8), u8(body.len >> 16)], body])
}

fn frames() {
    let identifier = unhex("ff060000734e61507059")
    let hello = bytes("hello")
    let sum = unhex("bb1f1c19")
    let empty: []u8 = []
    print("identifier only {frame_outcome(identifier, 100, empty)}")
    print("hello by hand {frame_outcome(joined([identifier, chunk(1, joined([sum, hello]))]), 100, hello)}")
    print("hello compressed by hand {frame_outcome(joined([identifier, chunk(0, joined([sum, unhex("051068656c6c6f")]))]), 100, hello)}")
    print("padding and skippable {frame_outcome(joined([identifier, chunk(0xFE, repeated(10, 0)), chunk(1, joined([sum, hello])), chunk(0x80, bytes("x")), chunk(0xFD, empty)]), 100, hello)}")
    print("large padding {frame_outcome(joined([identifier, chunk(0xFE, repeated(200000, 0)), chunk(1, joined([sum, hello]))]), 100, hello)}")
    print("repeated identifier {frame_outcome(joined([identifier, chunk(1, joined([sum, hello])), identifier, chunk(1, joined([sum, hello]))]), 100, joined([hello, hello]))}")
    print("no input {frame_outcome(empty, 100, empty)}")
    print("no identifier {frame_outcome(chunk(1, joined([sum, hello])), 100, hello)}")
    print("wrong identifier {frame_outcome(unhex("ff060000734e61507058"), 100, empty)}")
    print("short identifier {frame_outcome(unhex("ff050000734e615070"), 100, empty)}")
    print("bad checksum {frame_outcome(joined([identifier, chunk(1, joined([unhex("bb1f1c18"), hello]))]), 100, hello)}")
    print("bad compressed checksum {frame_outcome(joined([identifier, chunk(0, joined([unhex("00000000"), unhex("051068656c6c6f")]))]), 100, hello)}")
    print("reserved chunk {frame_outcome(joined([identifier, chunk(2, empty)]), 100, empty)}")
    print("reserved chunk 0x7f {frame_outcome(joined([identifier, chunk(0x7F, hello)]), 100, empty)}")
    print("short chunk {frame_outcome(joined([identifier, chunk(1, unhex("010203"))]), 100, empty)}")
    print("truncated header {frame_outcome(joined([identifier, unhex("0105")]), 100, empty)}")
    print("truncated body {frame_outcome(joined([identifier, chunk(1, joined([sum, hello]))])[..16], 100, hello)}")
    print("oversized stored {frame_outcome(joined([identifier, unhex("01050001")]), 100, empty)}")
    let wide = snappy.compress_block(repeated(70000, 0))
    print("oversized compressed {frame_outcome(joined([identifier, chunk(0, joined([unhex("00000000"), wide]))]), 1 << 24, empty)}")
    print("limit {frame_outcome(joined([identifier, chunk(1, joined([sum, hello]))]), 4, empty)}")
    print("limit exact {frame_outcome(joined([identifier, chunk(1, joined([sum, hello]))]), 5, hello)}")
    let long = bytes(embed("text.sz"))
    print("flipped payload {flipped(long)}")
    print("long limit {frame_outcome(long, 199999, empty)}")
}

fn flipped(packed: []u8) -> str {
    let copy = joined([packed])
    copy[copy.len / 2] ^= 8
    let want: []u8 = []
    frame_outcome(copy, 1 << 24, want)
}

fn main() ! io.Error {
    literals()
    vectors()
    invalid()
    references()
    block_round_trips()
    frame_round_trips()
    streaming()?
    frames()
}
