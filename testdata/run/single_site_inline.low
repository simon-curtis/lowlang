fn stir(h: i64, k: i64) -> i64 {
    var x = h * 31 + k
    x = x ^ (x >> 7)
    x = x * 17 - k
    x = x ^ (x << 3)
    x = x + (x >> 11) * k
    x = x * 13 + (k ^ 5)
    x = x ^ (x >> 5)
    x = x * 7 - (x >> 2)
    x = x + (k << 4) ^ (x >> 9)
    x = x * 29 + (x >> 13)
    x = x ^ (k * 3 + 1)
    x = x * 11 - (x << 2)
    x = x + (x >> 3) * 5
    x = x ^ (x >> 17)
    x = x * 19 + k
    x = x ^ (x << 6)
    x = x - (x >> 4) * 3
    x = x * 23 + (k ^ 9)
    x = x ^ (x >> 15)
    x = x + (x << 1) - k
    x % 1000003
}

fn once(n: i64) -> i64 {
    var x = n * 7 + 3
    x = x ^ (x >> 7)
    x = x * 17 - n
    x = x ^ (x << 3)
    x = x + (x >> 11) * n
    x = x * 13 + (n ^ 5)
    x = x ^ (x >> 5)
    x = x * 7 - (x >> 2)
    x = x + (n << 4) ^ (x >> 9)
    x = x * 29 + (x >> 13)
    x = x ^ (n * 3 + 1)
    x = x * 11 - (x << 2)
    x = x + (x >> 3) * 5
    x = x ^ (x >> 17)
    x = x * 19 + n
    x = x ^ (x << 6)
    x = x - (x >> 4) * 3
    x = x * 23 + (n ^ 9)
    x = x ^ (x >> 15)
    x = x + (x << 1) - n
    x % 1000003
}

fn main() {
    var total = 0
    for i in 0..4 {
        total += once(i)
        total += stir(total, i)
    }
    print("first {total}")
    print("second {stir(total, 2)}")
}
