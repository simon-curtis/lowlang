import std/time/fault
import std/time/offset

fn describe(f: fault.Fault) -> str {
    match f {
        OutOfRange(what) => "OutOfRange({what})"
        Invalid(what) => "Invalid({what})"
        Syntax(at) => "Syntax({at})"
        _ => fault.to_string(f)
    }
}

fn text_of(o: offset.Offset) -> str {
    "{offset.to_string(o)} {offset.to_string_z(o)} {offset.seconds_of(o)}"
}

fn seconds(n: i64) {
    let o = offset.of_seconds(n) catch {
        e => return print("of_seconds {n} {describe(e)}")
    }
    print("of_seconds {n} {text_of(o)}")
}

fn whole_hours(h: i64) {
    let o = offset.hours(h) catch {
        e => return print("hours {h} {describe(e)}")
    }
    print("hours {h} {text_of(o)}")
}

fn hour_minutes(h: i64, m: i64) {
    let o = offset.hm(h, m) catch {
        e => return print("hm {h} {m} {describe(e)}")
    }
    print("hm {h} {m} {text_of(o)}")
}

fn parsed(s: str) {
    let o = offset.parse(s) catch {
        e => return print("parse [{s}] {describe(e)}")
    }
    print("parse [{s}] {text_of(o)}")
}

fn constructors() {
    print("utc {text_of(offset.utc())} {offset.is_utc(offset.utc())}")
    for n in [0, 1, -1, 3600, 19800, -12600, 20715, -12615, 45000, 93599, -93599, 93600, -93600, 100000] {
        seconds(n)
    }
    for h in [0, 5, -3, 14, -12, 25, -25, 26, -26, 27] {
        whole_hours(h)
    }
    hour_minutes(5, 30)
    hour_minutes(-3, 30)
    hour_minutes(-3, -30)
    hour_minutes(3, -30)
    hour_minutes(-3, 59)
    hour_minutes(0, -30)
    hour_minutes(0, 30)
    hour_minutes(0, 60)
    hour_minutes(0, -60)
    hour_minutes(5, 45)
    hour_minutes(25, 59)
    hour_minutes(-25, 59)
    hour_minutes(-25, -59)
    hour_minutes(-26, 0)
    hour_minutes(-5, 0)
    hour_minutes(26, 0)
    hour_minutes(5, 59)
}

fn parsing() {
    for s in ["Z", "z", "+00:00", "-00:00", "+00", "-00", "+0000", "+05", "-05", "+05:30", "-03:30", "+0530", "-0330", "+05:45", "+0545"] {
        parsed(s)
    }
    for s in ["+05:30:15", "-03:30:15", "+053015", "-033015", "+25:59:59", "-25:59:59", "+14:00", "-12:00", "+23:59", "+12:00:00"] {
        parsed(s)
    }
    for s in ["+26:00", "-26:00", "+25:60", "+05:60", "+05:30:60", "+99:99", "+25:59:60"] {
        parsed(s)
    }
    for s in ["", "+", "-", "5", "05:30", "+5", "+5:30", "+05:3", "+05:", "+05:30:", "+05:30:1", "+0", "+053", "+05301", "+05:30:15x", "+05:30x", "+05:30:15:", "Zx", "z0", "ZZ", " +05:30", "+05:30 ", "+05-30", "+05.30", "UTC", "GMT", "Europe/London", "+0a", "+a0", "-:", "+05;30", "−"] {
        parsed(s)
    }
}

fn comparisons() {
    let a = offset.hm(-3, 30) or offset.utc()
    let b = offset.utc()
    let c = offset.hm(5, 30) or offset.utc()
    let d = offset.of_seconds(19800) or offset.utc()
    print("compare {offset.compare(a, b)} {offset.compare(b, a)} {offset.compare(c, d)} {offset.compare(b, b)} {offset.compare(a, c)}")
    print("equal {offset.equal(c, d)} {offset.equal(a, b)} {c == d} {a == b} {a != c}")
    print("before {offset.before(a, b)} {offset.before(b, a)} {offset.before(c, d)}")
    print("after {offset.after(a, b)} {offset.after(c, a)} {offset.after(c, d)}")
    print("min {offset.to_string(offset.min(a, c))} {offset.to_string(offset.min(c, a))} {offset.to_string(offset.min(c, d))}")
    print("max {offset.to_string(offset.max(a, c))} {offset.to_string(offset.max(c, a))} {offset.to_string(offset.max(a, b))}")
    print("negate {offset.to_string(offset.negate(c))} {offset.to_string(offset.negate(a))} {offset.to_string(offset.negate(b))}")
    print("methods {c.to_string()} {c.seconds_of()} {b.is_utc()} {c.is_utc()}")
}

fn round_trips() {
    var checked = 0
    var failures = 0
    var n = -93599
    for n <= 93599 {
        let o = offset.of_seconds(n) or offset.utc()
        let back = offset.parse(offset.to_string(o)) or offset.utc()
        let again = offset.parse(offset.to_string_z(o)) or offset.utc()
        if back != o || again != o || offset.seconds_of(back) != n {
            failures += 1
            print("round trip failed {n}")
        }
        checked += 1
        n += 17
    }
    print("round trips {checked} failures {failures}")
}

fn reading() {
    for text in ["Z rest", "+05:30 rest", "-0800x", "+0530", "x", "+5", "+26:00", "+10:60"] {
        let found = offset.read(text, 0) catch {
            e => {
                print("read {text} => {describe(e)}")
                continue
            }
        }
        print("read {text} => {offset.to_string(found.offset)} end {found.end}")
    }
    let inner = offset.read("at +01:00 now", 3) or offset.Reading { offset: offset.utc(), end: -1 }
    print("read inside {offset.to_string(inner.offset)} end {inner.end}")
}

fn main() {
    reading()
    constructors()
    parsing()
    comparisons()
    round_trips()
}
