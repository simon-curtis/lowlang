pub enum Color {
    Unspecified = 0
    Red = 1
    Green = 2
    Neg = -3
}

pub struct Inner {
    pub a: i32 "1"
    pub b: str "2"
    pub c: i32[] "3"
}

pub struct Scalars {
    pub i32: i32 "1"
    pub i64: i64 "2"
    pub u32: u32 "3"
    pub u64: u64 "4"
    pub s32: i32 "5,sint"
    pub s64: i64 "6,sint"
    pub f32: u32 "7,fixed"
    pub f64: u64 "8,fixed"
    pub sf32: i32 "9,fixed"
    pub sf64: i64 "10,fixed"
    pub fl: f32 "11"
    pub db: f64 "12"
    pub flag: bool "13"
    pub str: str "14"
    pub raw: u8[] "15"
    pub color: Color "16"
    pub inner: Inner? "17"
    pub maybe: i32? "18"
    pub packed: i32[] "19"
    pub loose: i32[] "20,unpacked"
    pub names: str[] "21"
    pub inners: Inner[] "22"
    pub counts: [str: i32] "23"
    pub by_id: [i32: Inner] "24"
    pub zz: i64[] "25,sint"
    pub fx: u32[] "26,fixed"
    pub ds: f64[] "27"
    pub colors: Color[] "28"
    pub choice: ScalarsChoice? "oneof"
}

pub enum ScalarsChoice {
    Num(value: i32) = 30
    Word(value: str) = 31
    Node(value: Inner) = 32
}
