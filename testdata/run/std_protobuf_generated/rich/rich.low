import google/protobuf/timestamp
import google/protobuf/duration
import std/grpc

pub enum Status {
    Unknown = 0
    Ok = 1
    Fine = 1
    Status2Fast = 2
    /// Deprecated.
    Other = 3
}

pub enum EventKind {
    None = 0
    Start = 1
}

pub struct Event {
    pub kind: EventKind "1"
    pub detail: *EventDetail? "2"
    pub when: timestamp.Timestamp? "3"
    pub after: duration.Duration? "4"
    pub status: Status "5"
    pub history: []EventDetail "6"
    pub ids: [i32: u64] "7,key=sint,value=fixed"
    pub notes: [str: EventDetail] "8"
    pub fn_: str "9"
    pub in_: i32 "10"
    pub camel_case: str "11"
    /// Deprecated.
    pub type: bool "12"
    pub loose: []u64 "13,unpacked"
    pub payload: EventPayload? "oneof"
    pub maybe: str? "30"
    pub maybe_detail: *EventDetail? "31"
}

pub enum EventPayload {
    Delta(value: i64 "sint") = 20
    Child(value: *Event) = 21
    Label(value: str) = 22
    Info(value: *EventDetail) = 23
}

pub struct EventDetail {
    pub note: str "1"
    pub parent: *Event? "2"
}

pub struct Tree {
    pub leaf: *Leaf? "1"
    pub kids: []Tree "2"
}

pub struct Leaf {
    pub owner: *Tree? "1"
    pub branch: *Branch? "2"
}

pub struct Branch {
    pub leaf: *Leaf? "1"
}

pub struct Empty {
    pub empty: bool "536870911"
}

/// The client of the service `rich.v1.Events`.
pub struct EventsClient {
    pub channel: grpc.Channel
}

/// Returns a client of the service `rich.v1.Events` that calls through `channel`.
pub fn events_client(channel: grpc.Channel) -> EventsClient {
    EventsClient { channel }
}

/// Calls the unary method `Get`.
pub fn get(c: EventsClient, request: Event, opts: grpc.CallOptions) -> grpc.Reply[Event] ! grpc.Error {
    grpc.unary[Event, Event](c.channel, "/rich.v1.Events/Get", request, opts)?
}

/// Starts the server streaming method `Watch`; read the responses with `grpc.receive`.
pub fn watch(c: EventsClient, request: Event, opts: grpc.CallOptions) -> *grpc.Stream ! grpc.Error {
    grpc.server_streaming[Event](c.channel, "/rich.v1.Events/Watch", request, opts)?
}

/// Starts the client streaming method `Upload`; send with `grpc.send`, then read with `grpc.finish`.
pub fn upload(c: EventsClient, opts: grpc.CallOptions) -> *grpc.Stream ! grpc.Error {
    grpc.client_streaming(c.channel, "/rich.v1.Events/Upload", opts)?
}

/// Starts the bidirectional streaming method `Chat`; send with `grpc.send`, then read with `grpc.receive`.
pub fn chat(c: EventsClient, opts: grpc.CallOptions) -> *grpc.Stream ! grpc.Error {
    grpc.bidi_streaming(c.channel, "/rich.v1.Events/Chat", opts)?
}

/// The functions that serve the methods of the service `rich.v1.Events`, for `register_events`.
pub struct EventsHandlers {
    pub get: fn(*grpc.Context, Event) -> Event ! grpc.Error
    pub watch: fn(*grpc.Context, Event) ! grpc.Error
    pub upload: fn(*grpc.Context) -> Empty ! grpc.Error
    pub chat: fn(*grpc.Context) ! grpc.Error
}

/// Registers the methods of the service `rich.v1.Events` on `server`.
pub fn register_events(server: *grpc.Server, handlers: EventsHandlers) {
    grpc.handle_unary[Event, Event](server, "/rich.v1.Events/Get", handlers.get)
    grpc.handle_server_streaming[Event](server, "/rich.v1.Events/Watch", handlers.watch)
    grpc.handle_client_streaming[Empty](server, "/rich.v1.Events/Upload", handlers.upload)
    grpc.handle_bidi_streaming(server, "/rich.v1.Events/Chat", handlers.chat)
}
