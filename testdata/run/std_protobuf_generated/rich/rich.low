import google/protobuf/timestamp
import google/protobuf/duration

pub enum Status {
    Unknown = 0
    Ok = 1
    Fine = 1
    Status2Fast = 2
    /// Deprecated.
    Other = 3
}

pub enum EventKind {
    None = 0
    Start = 1
}

pub struct Event {
    pub kind: EventKind "1"
    pub detail: *EventDetail? "2"
    pub when: timestamp.Timestamp? "3"
    pub after: duration.Duration? "4"
    pub status: Status "5"
    pub history: []EventDetail "6"
    pub ids: [i32: u64] "7,key=sint,value=fixed"
    pub notes: [str: EventDetail] "8"
    pub fn_: str "9"
    pub in_: i32 "10"
    pub camel_case: str "11"
    /// Deprecated.
    pub type: bool "12"
    pub loose: []u64 "13,unpacked"
    pub payload: EventPayload? "oneof"
    pub maybe: str? "30"
    pub maybe_detail: *EventDetail? "31"
}

pub enum EventPayload {
    Delta(value: i64 "sint") = 20
    Child(value: *Event) = 21
    Label(value: str) = 22
    Info(value: *EventDetail) = 23
}

pub struct EventDetail {
    pub note: str "1"
    pub parent: *Event? "2"
}

pub struct Tree {
    pub leaf: *Leaf? "1"
    pub kids: []Tree "2"
}

pub struct Leaf {
    pub owner: *Tree? "1"
    pub branch: *Branch? "2"
}

pub struct Branch {
    pub leaf: *Leaf? "1"
}

pub struct Empty {
    pub empty: bool "536870911"
}
