import kinds

pub struct Item {
    pub name: str "1,required"
    pub count: i32 "2" = 5
    pub note: str "3" = "a\"{{b}}\n"
    pub blob: u8[] "4" = [0, 120]
    pub ratio: f32 "5" = 1.5
    pub delta: i64 "6" = -7
    pub kind: kinds.Kind "7" = kinds.Kind.B
    pub flag: bool "8" = true
    pub plain: str? "9"
    pub loose: i32[] "10,unpacked"
    pub tight: i32[] "11"
    pub kind_list: kinds.Kind[] "12,unpacked"
    pub next: *Item? "13"
    pub inner: ItemInner "14,required"
    pub wide: f64 "15" = 100.0
    pub small: u32 "16" = 4000000000
}

pub struct ItemInner {
    pub v: i32? "1"
}
