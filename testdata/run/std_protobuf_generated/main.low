import all
import items
import kinds
import rich
import google/protobuf/duration
import google/protobuf/timestamp
import std/io
import std/protobuf
import std/protobuf/proto
import std/text

struct Golden {
    path: str
    text: str
}

fn goldens() -> []Golden {
    [
        Golden { path: "all/all.low", text: embed("all/all.low") },
        Golden { path: "rich/rich.low", text: embed("rich/rich.low") },
        Golden { path: "items/items.low", text: embed("items/items.low") },
        Golden { path: "kinds/kinds.low", text: embed("kinds/kinds.low") },
        Golden { path: "google/protobuf/duration/duration.low", text: embed("google/protobuf/duration/duration.low") },
        Golden { path: "google/protobuf/timestamp/timestamp.low", text: embed("google/protobuf/timestamp/timestamp.low") },
    ]
}

fn source(name: str) -> str ! io.Error {
    match name {
        == "all.proto" => embed("protos/all.proto")
        == "rich.proto" => embed("protos/rich.proto")
        == "items.proto" => embed("protos/items.proto")
        == "kinds.proto" => embed("protos/kinds.proto")
        == "google/protobuf/duration.proto" => embed("protos/google/protobuf/duration.proto")
        == "google/protobuf/timestamp.proto" => embed("protos/google/protobuf/timestamp.proto")
        _ => fail io.Error.NotFound
    }
}

fn generated() -> []proto.Output {
    let set = proto.read_files(["all.proto", "rich.proto", "items.proto"], [""], source) or panic("read_files")
    proto.generate(set, proto.Options {}) or panic("generate")
}

fn check_generated() {
    let outputs = generated()
    print("outputs {outputs.len}")
    for o in outputs {
        var matched = false
        for g in goldens() {
            if g.path == o.path {
                matched = g.text == o.text
                print("{o.path}: {if matched { "matches" } else { "DIFFERS" }}")
            }
        }
    }
}

fn blank() -> all.Scalars {
    all.Scalars {
        i32: 0, i64: 0, u32: 0, u64: 0, s32: 0, s64: 0, f32: 0, f64: 0, sf32: 0, sf64: 0,
        fl: 0.0, db: 0.0, flag: false, str: "", raw: [], color: all.Color.Unspecified,
        inner: none, maybe: none, packed: [], loose: [], names: [], inners: [], counts: [:], by_id: [:],
        zz: [], fx: [], ds: [], colors: [], choice: none,
    }
}

fn check(name: str, got: []u8, want: str) {
    let have = text.encode_hex(got)
    if have == want {
        print("{name}: ok")
    } else {
        print("{name}: FAIL\n  got  {have}\n  want {want}")
    }
}

fn full() -> all.Scalars {
    var v = blank()
    v.i32 = -2
    v.i64 = -3
    v.u32 = 4294967295
    v.u64 = 18446744073709551615
    v.s32 = -5
    v.s64 = -6
    v.f32 = 7
    v.f64 = 8
    v.sf32 = -9
    v.sf64 = -10
    v.fl = 1.5
    v.db = 2.25
    v.flag = true
    v.str = "hé"
    v.raw = [1, 255]
    v.color = all.Color.Neg
    v.inner = all.Inner { a: 1, b: "x", c: [1, -1] }
    v.maybe = 0
    v.packed = [1, 300]
    v.loose = [1, 2]
    v.names = ["a", "b"]
    v.inners = [all.Inner { a: 5, b: "", c: [] }, all.Inner { a: 0, b: "q", c: [] }]
    v.zz = [-1, 2]
    v.fx = [1, 2]
    v.ds = [0.5]
    v.colors = [all.Color.Red, all.Color.Green]
    v.choice = all.ScalarsChoice.Num(0)
    v
}

fn scalars() {
    let message = full()
    let want = ""
    check("scalars encode", protobuf.serialize(message), want)
    let data = text.decode_hex(want) or panic("vector")
    let back = protobuf.deserialize[all.Scalars](data) or panic("scalars decode")
    check("scalars decode", protobuf.serialize(back), want)

    var map = blank()
    map.by_id = [-5: all.Inner { a: 1, b: "x", c: [] }]
    check("map message", protobuf.serialize(map), "c2011208fbffffffffffffffff0112050801120178")

    var node = blank()
    node.choice = all.ScalarsChoice.Node(all.Inner { a: 1, b: "", c: [] })
    check("oneof node", protobuf.serialize(node), "8202020801")

    var word = blank()
    word.choice = all.ScalarsChoice.Word("w")
    let word_data = protobuf.serialize(word)
    let word_back = protobuf.deserialize[all.Scalars](word_data) or panic("word decode")
    match word_back.choice ?? panic("oneof") {
        Word(w) => print("oneof word {w}")
        _ => print("oneof FAIL")
    }
}

fn detail() -> rich.EventDetail {
    rich.EventDetail { note: "n", parent: none }
}

fn event() -> rich.Event {
    let child = rich.Event {
        kind: rich.EventKind.Start, detail: none, when: none, after: none, status: rich.Status.Fine,
        history: [], ids: [:], notes: [:], fn_: "", in_: 0, camel_case: "", type: false, loose: [], payload: none,
        maybe: none, maybe_detail: none,
    }
    rich.Event {
        kind: rich.EventKind.Start,
        detail: new(detail()),
        when: timestamp.Timestamp { seconds: 100, nanos: 5 },
        after: duration.Duration { seconds: 1, nanos: 0 },
        status: rich.Status.Status2Fast,
        history: [detail()],
        ids: [-3: 9],
        notes: ["k": detail()],
        fn_: "f",
        in_: 4,
        camel_case: "c",
        type: true,
        loose: [1, 2],
        payload: rich.EventPayload.Child(new(child)),
        maybe: "m",
        maybe_detail: new(detail()),
    }
}

fn events() {
    let want = "080112030a016e1a040864100522020801280232030a016e3a0b080511090000000000000042080a016b12030a016e4a016650045a0163600168016802aa010408012801f201016dfa01030a016e"
    check("event encode", protobuf.serialize(event()), want)
    let data = text.decode_hex(want) or panic("vector")
    let back = protobuf.deserialize[rich.Event](data) or panic("event decode")
    check("event decode", protobuf.serialize(back), want)
    let payload = back.payload ?? panic("payload")
    match payload {
        Child(c) => print("child status {c.status} kind {c.kind}")
        _ => print("payload FAIL")
    }

    let leaf = rich.Leaf { owner: none, branch: new(rich.Branch { leaf: none }) }
    let tree = rich.Tree { leaf: new(leaf), kids: [rich.Tree { leaf: none, kids: [] }] }
    check("tree encode", protobuf.serialize(tree), "0a0212001200")
}

fn item(name: str) -> items.Item {
    items.Item {
        name: name, count: 5, note: "a\"{{b}}\n", blob: [0, 120], ratio: 1.5, delta: -7, kind: kinds.Kind.B, flag: true,
        plain: none, loose: [], tight: [], kind_list: [], next: none, inner: items.ItemInner { v: none }, wide: 100.0,
        small: 4000000000,
    }
}

fn proto2() {
    var set = item("n")
    set.count = 6
    set.note = "z"
    set.blob = [1]
    set.ratio = 2.5
    set.delta = 8
    set.kind = kinds.Kind.A
    set.flag = false
    set.plain = "p"
    set.loose = [1, 2]
    set.tight = [3, 4]
    set.kind_list = [kinds.Kind.A, kinds.Kind.B]
    set.inner = items.ItemInner { v: 1 }
    set.wide = 3.0
    set.small = 7
    var next = item("m")
    next.count = 0
    next.note = ""
    next.blob = []
    next.ratio = 0.0
    next.delta = 0
    next.kind = kinds.Kind.A
    next.flag = false
    next.wide = 0.0
    next.small = 0
    set.next = new(next)
    let want_set = "0a016e10061a017a2201012d000020403008380040004a0170500150025a020304600060016a220a016d10001a0022002d00000000300038004000720079000000000000000080010072020801790000000000000840800107"
    check("proto2 set encode", protobuf.serialize(set), want_set)
    let set_back = protobuf.deserialize[items.Item](text.decode_hex(want_set) or panic("vector")) or panic("proto2 set decode")
    check("proto2 set decode", protobuf.serialize(set_back), want_set)

    var zero = item("")
    zero.count = 0
    zero.note = ""
    zero.blob = []
    zero.ratio = 0.0
    zero.delta = 0
    zero.kind = kinds.Kind.A
    zero.flag = false
    zero.wide = 0.0
    zero.small = 0
    let want_zero = "0a0010001a0022002d000000003000380040007200790000000000000000800100"
    check("proto2 zero encode", protobuf.serialize(zero), want_zero)
    let zero_back = protobuf.deserialize[items.Item](text.decode_hex(want_zero) or panic("vector")) or panic("proto2 zero decode")
    check("proto2 zero decode", protobuf.serialize(zero_back), want_zero)
    print("zero decode: count {zero_back.count} note {zero_back.note.len} blob {zero_back.blob.len} flag {zero_back.flag} small {zero_back.small}")

    let want_minimal = "0a016e7200"
    let minimal = protobuf.deserialize[items.Item](text.decode_hex(want_minimal) or panic("vector")) or panic("proto2 minimal decode")
    print("minimal decode: {minimal.name} count {minimal.count} note {minimal.note} blob {minimal.blob} ratio {minimal.ratio} delta {minimal.delta} flag {minimal.flag} wide {minimal.wide} small {minimal.small}")
    match minimal.kind {
        B => print("minimal kind B")
        A => print("minimal kind A")
    }
    check("proto2 defaults encode", protobuf.serialize(item("n")), "0a016e10051a0661227b627d0a220200782d0000c03f30f9ffffffffffffffff01380140017200790000000000005940800180d0acf30e")
}

fn main() {
    check_generated()
    scalars()
    events()
    proto2()
}
