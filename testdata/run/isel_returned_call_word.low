struct Pair {
    a: i64
    b: i64
}

fn text(n: i64) -> str {
    if n > 1000 {
        return text(n - 1)
    }
    if n > 3 {
        return "longer"
    }
    "ab"
}

fn size(n: i64) -> i64 {
    if n == -5 {
        return size(n + 1)
    }
    text(n).len
}

fn pair(n: i64) -> Pair {
    if n <= 0 {
        return Pair { a: 1, b: 2 }
    }
    let q = pair(n - 1)
    Pair { a: q.a + n, b: q.b + 2 * n }
}

fn second(n: i64) -> i64 {
    if n == 99 {
        return second(n - 1)
    }
    let p = pair(n)
    p.b
}

fn swapped(n: i64) -> Pair {
    if n == 99 {
        return swapped(n - 1)
    }
    let p = pair(n)
    Pair { a: p.b, b: p.a }
}

fn main() {
    print(size(1))
    print(size(9))
    print(second(3))
    let s = swapped(3)
    print(s.a)
    print(s.b)
}
