fn bump(x: f64) -> f64 { x * 0.5 + 1.0 }
fn rot(n: i64, call: bool) -> f64 {
    var v0 = 0.25
    var v1 = 1.25
    var v2 = 2.25
    var v3 = 3.25
    var v4 = 4.25
    var v5 = 5.25
    var v6 = 6.25
    var v7 = 7.25
    var v8 = 8.25
    var v9 = 9.25
    var v10 = 10.25
    var v11 = 11.25
    var v12 = 12.25
    var v13 = 13.25
    var v14 = 14.25
    var v15 = 15.25
    var v16 = 16.25
    var v17 = 17.25
    var k = 0
    for i in 0..n {
        let t = v0
        v0 = v1
        v1 = v2
        v2 = v3
        v3 = v4
        v4 = v5
        v5 = v6
        v6 = v7
        v7 = v8
        v8 = v9
        v9 = v10
        v10 = v11
        v11 = v12
        v12 = v13
        v13 = v14
        v14 = v15
        v15 = v16
        v16 = v17
        v17 = t
        if call && i % 3 == 0 { v5 = bump(v5) }
        let tk = k
        k = i64(v3) + tk % 7
    }
    v0 * 1.0 + v1 * 2.0 + v2 * 3.0 + v3 * 4.0 + v4 * 5.0 + v5 * 6.0 + v6 * 7.0 + v7 * 8.0 + v8 * 9.0 + v9 * 10.0 + v10 * 11.0 + v11 * 12.0 + v12 * 13.0 + v13 * 14.0 + v14 * 15.0 + v15 * 16.0 + v16 * 17.0 + v17 * 18.0 + f64(k)
}
fn main() {
    print(i64(rot(0, false) * 1000.0))
    print(i64(rot(0, true) * 1000.0))
    print(i64(rot(1, false) * 1000.0))
    print(i64(rot(1, true) * 1000.0))
    print(i64(rot(2, false) * 1000.0))
    print(i64(rot(2, true) * 1000.0))
    print(i64(rot(7, false) * 1000.0))
    print(i64(rot(7, true) * 1000.0))
    print(i64(rot(18, false) * 1000.0))
    print(i64(rot(18, true) * 1000.0))
    print(i64(rot(19, false) * 1000.0))
    print(i64(rot(19, true) * 1000.0))
    print(i64(rot(100, false) * 1000.0))
    print(i64(rot(100, true) * 1000.0))
    print(i64(rot(1001, false) * 1000.0))
    print(i64(rot(1001, true) * 1000.0))
}
