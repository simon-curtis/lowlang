struct Observation[T] {
    value: T
}

fn first[T](read: fn() -> []Observation[T]) -> T {
    read()[0].value
}

fn count[T](read: fn() -> []Observation[T]) -> i64 {
    read().len
}

fn main() {
    let read = fn() -> []Observation[i64] { [Observation { value: 7 }, Observation { value: 8 }] }
    print(count(read))
    print(first(read))
}
