import std/ui
import std/ui/geometry

fn card() -> ui.Element {
    ui.column(ui.div()).width(60.0).shrink(0.0).text_size(12.0).child(ui.text("card").nowrap())
}

fn main() {
    let rows = 200
    var tree = card().id("innermost")
    for _ in 0..rows {
        tree = ui.row(ui.div()).items_center().shrink(0.0).child(card()).child(tree)
    }
    let cx = ui.headless(geometry.rgb(0xffffff))
    ui.frame(cx, fn() -> ui.Element { tree }, geometry.size(800.0, 600.0), 1.0)
    let r = ui.bounds_of(cx, "innermost") ?? geometry.Rect {}
    print("innermost card at x {r.x} width {r.width}")
}
