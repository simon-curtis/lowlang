import std/locale
import std/locale/collate
import std/text

fn words() -> str[] {
    ["zebra", "Zebra", "apple", "Äpfel", "Apfel", "ångström", "ärlig", "öl", "olive", "Zürich", "zucchini", "ñandú", "nube", "llama", "luz", "chico", "cuna", "a10", "a2", "a1", "résumé", "resume", "côte", "côté", "coté", "cote"]
}

fn same(a: u8[], b: u8[]) -> bool {
    if a.len != b.len {
        return false
    }
    for i in 0..a.len {
        if a[i] != b[i] {
            return false
        }
    }
    true
}

fn sorted(tag: str, o: collate.Options) {
    let l = locale.parse(tag) or locale.root()
    let c = collate.for_locale(l, o)
    var xs = words()
    collate.sort(c, mut xs)
    print("{tag}: {text.join(xs, "|")}")
}

fn main() {
    sorted("en", collate.options())
    sorted("sv", collate.options())
    sorted("de", collate.options())
    sorted("es", collate.options())
    sorted("fr-CA", collate.options())

    var numeric = collate.options()
    numeric.numeric = true
    sorted("en", numeric)

    var upper = collate.options()
    upper.case_first = collate.CaseFirst.Upper
    sorted("en", upper)

    var base = collate.options()
    base.strength = collate.Strength.Primary
    let b = collate.root(base)
    print("primary a A {collate.compare(b, "a", "A")} a á {collate.compare(b, "a", "á")} a b {collate.compare(b, "a", "b")}")

    var accent = collate.options()
    accent.strength = collate.Strength.Secondary
    let a = collate.root(accent)
    print("secondary a A {collate.compare(a, "a", "A")} a á {collate.compare(a, "a", "á")} a b {collate.compare(a, "a", "b")}")
    print("equal {collate.equal(b, "e", "é")} {collate.equal(a, "e", "é")}")

    print("tailored {collate.is_tailored(locale.root())} {collate.is_tailored(locale.parse("sv") or locale.root())} {collate.is_tailored(locale.parse("de") or locale.root())} {collate.is_tailored(locale.parse("de-u-co-phonebk") or locale.root())}")

    let c = collate.root(collate.options())
    let k1 = collate.sort_key(c, "a")
    let k2 = collate.sort_key_runes(c, [u32(0x61)])
    print("key {same(k1, k2)}")
    print("runes {collate.compare_runes(c, [u32(0x61)], [u32(0x62)])}")

    var shifted = collate.options()
    shifted.alternate = collate.Alternate.Shifted
    let s = collate.root(shifted)
    print("shifted {collate.compare(c, "a b", "ab")} {collate.compare(s, "a b", "ab")}")
}
