struct Tree {
    left: *Tree?
    right: *Tree?
    value: i64
}

struct Link {
    next: *Link?
    value: i64
}

struct Pair {
    a: i64
    b: i64
}

struct Wide {
    a: i64
    b: i64
    c: i64
    d: i64
    e: i64
    f: i64
    g: i64
}

fn grow(depth: i64, value: i64) -> *Tree {
    if depth == 0 {
        new(Tree { left: none, right: none, value: value })
    } else {
        new(Tree { left: grow(depth - 1, value * 2), right: grow(depth - 1, value * 2 + 1), value: value })
    }
}

fn total(t: *Tree) -> i64 {
    let left = match t.left {
        some(l) => total(l)
        none => 0
    }
    let right = match t.right {
        some(r) => total(r)
        none => 0
    }
    (t.value + left + right) % 1000000007
}

fn deep_list(n: i64) -> *Link? {
    var head: *Link? = none
    for i in 0..n {
        head = some(new(Link { next: head, value: i }))
    }
    head
}

fn list_total(head: *Link?) -> i64 {
    var sum = 0
    var cur = head
    for {
        match cur {
            some(l) => {
                sum += l.value
                cur = l.next
            }
            none => break
        }
    }
    sum
}

fn filled(length: i64, seed: i64) -> []i64 {
    var out: []i64 = []
    for i in 0..length {
        push(mut out, seed + i)
    }
    out
}

fn slice_total(xs: []i64) -> i64 {
    var sum = 0
    for x in xs {
        sum += x
    }
    sum
}

fn buffer_edges(seed: i64, rounds: i64) -> i64 {
    var kept: [][]i64 = []
    var expected: []i64 = []
    var junk = 0
    for round in 0..rounds {
        let length = (round * 7 + seed) % 300
        let xs = filled(length, round)
        let w = new(Wide { a: round, b: 1, c: 2, d: 3, e: 4, f: 5, g: round })
        junk += w.a + w.g + xs.len
        if round % 13 == 0 {
            push(mut kept, xs)
            push(mut expected, slice_total(xs))
        }
        let p = new(Pair { a: round, b: length })
        junk += p.a - p.b
    }
    var bad = 0
    for i in 0..kept.len {
        if slice_total(kept[i]) != expected[i] {
            bad += 1
        }
    }
    junk % 1000003 * 1000 + bad
}

fn bump(mut x: i64) {
    for i in 0..300000 {
        let p = new(Pair { a: i, b: i })
        x += p.a - p.b
    }
    x += 1
}

fn interior() -> i64 {
    var base = filled(4000, 10)
    let window = base[1000..1100]
    let tail = base[3900..4000]
    base = []
    let c = new(Wide { a: 1, b: 2, c: 3, d: 4, e: 5, f: 6, g: 7 })
    bump(mut c.d)
    bump(mut c.g)
    var churn = 0
    for i in 0..400000 {
        let p = new(Pair { a: i, b: 2 })
        churn += p.b
    }
    slice_total(window) * 1000000 + slice_total(tail) + c.d * 7 + c.g + churn % 7
}

fn worker(id: i64, out: chan[i64]) {
    var sum = 0
    for round in 0..3 {
        let t = grow(10 + id % 3, id + round)
        sum += total(t)
        let list = deep_list(20000 + id * 100)
        sum += list_total(list)
        var words: []str = []
        for i in 0..2000 {
            push(mut words, "w{id}-{i}")
        }
        var length = 0
        for w in words {
            length += w.len
        }
        sum += length
        sum += buffer_edges(id, 800) % 1000
    }
    out <- id * 100000000000 + sum % 100000000000
}

fn concurrent() {
    let out = chan[i64](16)
    for id in 0..12 {
        spawn worker(id, out)
    }
    var results: []i64 = []
    var mine = 0
    for i in 0..12 {
        mine += total(grow(12, i))
        push(mut results, (<-out) ?? -1)
    }
    var sorted = results
    for i in 0..sorted.len {
        for j in i + 1..sorted.len {
            if sorted[j] < sorted[i] {
                let t = sorted[i]
                sorted[i] = sorted[j]
                sorted[j] = t
            }
        }
    }
    for r in sorted {
        print(r)
    }
    print(mine)
}

fn main() {
    let big = grow(19, 1)
    let list = deep_list(400000)
    print(total(big))
    print(list_total(list))
    print(buffer_edges(0, 6000))
    print(buffer_edges(5, 6000))
    print(interior())
    concurrent()
    print(total(big))
    print(list_total(list))
}
