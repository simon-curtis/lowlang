fn scale8_i32(x: i32) -> i32 {
    x * 8
}

fn scale4_u8(x: u8) -> u8 {
    x * 4
}

fn scale_big(x: i64) -> i64 {
    x * 4611686018427387904
}

fn identities(x: i64) -> i64 {
    let a = x + 0
    let b = x - 0
    let c = x * 1
    let d = x * 0
    let e = x | 0
    let f = x ^ 0
    let g = x & 0
    let h = x << 0
    let i = x >> 0
    a + b + c + d + e + f + g + h + i
}

fn identities_u8(x: u8) -> u8 {
    let a = x + 0
    let b = x * 1
    let c = x << 0
    let d = x >> 0
    a + b + c + d
}

fn narrow_i32() {
    let max: i32 = 2147483647
    let min: i32 = 0 - 2147483647 - 1
    print(max + 1)
    print(min - 1)
    print(max * 2)
    print(min * 2)
    print(max + max)
    print(-min)
    print(~max)
    print(1 << 31)
    print(max >> 30)
    print(min >> 31)
    let eight: i32 = 0 - 8
    print(eight >> 1)
    print(max / 7)
    print(min / 7)
    print(min % 7)
    print(0 - 17 / 5)
    print(0 - 17 % 5)
    print(i32(4294967296 + 5))
    print(i32(3000000000))
    print(i32(0 - 1))
}

fn narrow_u8() {
    let a: u8 = 200
    let b: u8 = 100
    print(a + b)
    print(b - a)
    print(a * b)
    print(a * 16)
    print(1 << 7)
    let one: u8 = 1
    print(one << 7)
    print(one << 8)
    print(a >> 4)
    print(a >> 9)
    print(~b)
    print(0 - a)
    print(a / 7)
    print(a % 7)
    print(u8(300))
    print(u8(0 - 1))
}

fn narrow_u16() {
    let a: u16 = 65535
    let b: u16 = 300
    print(a + 1)
    print(b * b)
    print(0 - b)
    print(a >> 15)
    print(a << 1)
    print(~b)
    print(u16(70000))
}

fn narrow_u32() {
    let a: u32 = 4294967295
    let b: u32 = 65536
    print(a + 1)
    print(0 - a)
    print(b * b)
    print(a >> 31)
    print(a << 31)
    print(a << 32)
    print(~b)
    print(a / 10)
    print(a % 10)
    print(i64(a))
    print(u32(0 - 1))
}

fn wide() {
    let max = 9223372036854775807
    let min = 0 - 9223372036854775807 - 1
    print(max + 1)
    print(min - 1)
    print(max * 2)
    print(min / -1)
    print(min % -1)
    print(0 - 7 / 2)
    print(0 - 7 % 2)
    print(1 << 63)
    print(1 << 64)
    let neg = 0 - 1
    print(neg >> 70)
    print(neg >> 63)
    let big: u64 = 18446744073709551615
    print(big / 3)
    print(big % 10)
    print(big >> 63)
    print(big + 2)
}

fn main() {
    narrow_i32()
    narrow_u8()
    narrow_u16()
    narrow_u32()
    wide()
    print(scale8_i32(300000000))
    print(scale8_i32(0 - 300000000))
    print(scale4_u8(100))
    print(scale_big(3))
    print(scale_big(0 - 3))
    print(identities(41))
    print(identities_u8(250))
}
