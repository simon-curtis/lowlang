import std/base58
import std/text

fn hex(s: str) -> []u8 {
    text.decode_hex(s) catch {
        _ => []
    }
}

fn describe(e: base58.Error) -> str {
    match e {
        BadCharacter(at) => "bad character at {at}"
        BadChecksum => "bad checksum"
        TooShort => "too short"
    }
}

fn round_trip(label: str, data: []u8) {
    let encoded = base58.encode(data)
    let decoded = base58.decode(encoded) catch {
        e => {
            print("{label}: {describe(e)}")
            return
        }
    }
    print("{label}: [{encoded}] {text.encode_hex(decoded) == text.encode_hex(data)}")
}

fn flickr_round_trip(data: []u8) {
    let encoded = base58.encode_flickr(data)
    let decoded = base58.decode_flickr(encoded) catch {
        e => {
            print("flickr: {describe(e)}")
            return
        }
    }
    print("flickr [{encoded}] {text.encode_hex(decoded)}")
}

fn bad(s: str) {
    let _ = base58.decode(s) catch {
        e => {
            print("[{s}] {describe(e)}")
            return
        }
    }
    print("[{s}] decoded")
}

fn bad_check(s: str) {
    let _ = base58.decode_check(s) catch {
        e => {
            print("[{s}] {describe(e)}")
            return
        }
    }
    print("[{s}] verified")
}

fn main() {
    for h in [
        "", "61", "626262", "636363", "73696d706c792061206c6f6e6720737472696e67",
        "00eb15231dfceb60925886b67d065299925915aeb172c06647", "516b6fcd0f", "bf4f89001e670274dd",
        "572e4794", "ecac89cad93923c02321", "10c8511e", "00", "0000", "000001", "00000000", "ff", "ffffffff",
    ] {
        round_trip("[{h}]", hex(h))
    }
    print(base58.encode(hex("00000000000000000000")))
    print(text.encode_hex(base58.decode("111112") catch { _ => [] }))
    flickr_round_trip(hex("00eb15231dfceb60925886b67d065299925915aeb172c06647"))
    flickr_round_trip(hex("73696d706c792061206c6f6e6720737472696e67"))
    flickr_round_trip(hex("0001"))

    let address = hex("0077bff20c60e522dfaa3350c39b030a5d004e839a")
    print(base58.encode_check(address))
    print(text.encode_hex(base58.decode_check("1BvBMSEYstWetqTFn5Au4m4GFg7xJaNVN2") catch { _ => [] }))
    print(base58.encode_check([]))
    print(text.encode_hex(base58.decode_check(base58.encode_check([])) catch { _ => [0xEE] }))

    bad("abc0")
    bad("0")
    bad("1O")
    bad("1Il")
    bad("a b")
    bad_check("1BvBMSEYstWetqTFn5Au4m4GFg7xJaNVN3")
    bad_check("1BvBMSEYstWetqTFn5Au4m4GFg7xJaNVN2")
    bad_check("2g")
    bad_check("")
    bad_check("1BvBMSEYstWetqTFn5Au4m4GFg7xJaNVN0")
}
