import std/base64
import std/compress/deflate
import std/header
import std/http
import std/io
import std/net
import std/otel
import std/protobuf
import std/text
import std/time

struct Received {
    path: str
    content_type: str
    te: str
    encoding: str
    timeout: bool
    h2: bool
    compressed: bool
    body: []u8
}

enum Reply {
    Accept
    TrailersOnly(code: i64)
    Throttled(millis: i64)
    HttpStatus(status: i64)
}

struct Collector {
    received: chan[Received]
    replies: chan[Reply]
    port: i64
}

fn collector(l: net.Listener) -> *Collector {
    let c = new(Collector { received: chan[Received](64), replies: chan[Reply](16), port: l.handle.addr.port })
    spawn serve(l.handle, c)
    c
}

fn unpadded(s: str) -> str {
    var n = s.len
    for n > 0 && s[n - 1] == '=' {
        n -= 1
    }
    s[..n]
}

fn retry_details(millis: i64) -> str {
    let e = protobuf.encoder()
    e.write_int64(1, 8)
    e.write_string(2, "slow down")
    let any = e.begin_message(3)
    e.write_string(1, "type.googleapis.com/google.rpc.RetryInfo")
    let info = e.begin_message(2)
    let delay = e.begin_message(1)
    e.write_int64(1, millis / 1000)
    e.write_int64(2, millis % 1000 * 1000000)
    e.end_message(delay)
    e.end_message(info)
    e.end_message(any)
    unpadded(base64.encode(protobuf.encoded(e)))
}

fn grpc_frame(message: []u8) -> []u8 {
    var out: []u8 = [0]
    io.put_be32(mut out, message.len)
    io.append(mut out, message)
    out
}

fn unframe(body: []u8) -> Received {
    var r = Received { path: "", content_type: "", te: "", encoding: "", timeout: false, h2: false, compressed: false, body: [] }
    if body.len < 5 || io.be32(body, 1) != body.len - 5 {
        r.path = "bad frame"
        return r
    }
    r.compressed = body[0] == 1
    r.body = body[5..]
    r
}

fn reply_for(reply: Reply) -> http.Response {
    let grpc_type = header.Header { name: "content-type", value: "application/grpc" }
    match reply {
        Accept => http.Response { status: 200, headers: [grpc_type], body: grpc_frame([]), trailers: [header.Header { name: "grpc-status", value: "0" }] }
        TrailersOnly(code) => http.Response { status: 200, headers: [grpc_type, header.Header { name: "grpc-status", value: "{code}" }, header.Header { name: "grpc-message", value: "try later" }], body: [] }
        Throttled(millis) => http.Response {
            status: 200
            headers: [grpc_type]
            body: []
            trailers: [header.Header { name: "grpc-status", value: "8" }, header.Header { name: "grpc-status-details-bin", value: retry_details(millis) }]
        }
        HttpStatus(status) => http.response(status, "")
    }
}

fn serve(l: net.ListenerHandle, c: *Collector) {
    http.serve_on(l, fn(req: http.Request) -> http.Response {
        let reply = select {
            r = <-c.replies => r ?? Reply.Accept
            else => Reply.Accept
        }
        var r = unframe(req.body)
        if r.path.len == 0 {
            r.path = req.path
        }
        r.content_type = header.get(req.headers, "content-type") ?? ""
        r.te = header.get(req.headers, "te") ?? ""
        r.encoding = header.get(req.headers, "grpc-encoding") ?? ""
        r.timeout = header.has(req.headers, "grpc-timeout")
        r.h2 = req.version == Http2
        if r.compressed {
            r.body = deflate.gzip_decompress(r.body, 1 << 24) catch []
        }
        c.received <- r
        reply_for(reply)
    }) catch {
        _ => {}
    }
}

fn receive(c: *Collector) -> Received {
    let missing = Received { path: "timeout", content_type: "", te: "", encoding: "", timeout: false, h2: false, compressed: false, body: [] }
    select {
        r = <-c.received => r ?? missing
        after(5000) => missing
    }
}

fn sdk_for(c: *Collector, gzip: bool) -> otel.Sdk {
    let o = otel.OtlpOptions { endpoint: "http://127.0.0.1:{c.port}/ignored/path", protocol: Grpc, gzip, timeout: 3000, backoff: 1 }
    otel.install(otel.Config {
        resource: new(otel.Resource { attributes: [otel.string("service.name", "grpc-test")] })
        span_processors: [otel.batch_span_processor(otel.otlp_span_exporter(o), otel.BatchOptions { delay: 60000 })]
        log_processors: [otel.batch_log_processor(otel.otlp_log_exporter(o), otel.BatchOptions { delay: 60000 })]
        metric_readers: [otel.MetricReader { exporter: otel.otlp_metric_exporter(o), interval: 0, preference: PreferDelta }]
    })
}

fn decode(r: Received) -> []str {
    if text.ends_with(r.path, "TraceService/Export") {
        return pb_traces(r.body)
    }
    if text.ends_with(r.path, "MetricsService/Export") {
        return pb_metrics(r.body)
    }
    pb_logs(r.body)
}

fn round(c: *Collector, gzip: bool) -> []str {
    let ids = new(Ids { names: [:] })
    using sdk = sdk_for(c, gzip)
    emit_signals(ids)
    print("flush {sdk.force_flush()}")
    var by_path: [str: []str] = [:]
    var paths: []str = []
    for _ in 0..3 {
        let r = receive(c)
        print("received {r.path} {r.content_type} te={r.te} encoding=[{r.encoding}] compressed={r.compressed} timeout={r.timeout} h2={r.h2}")
        by_path[r.path] = masked(decode(r), ids)
        push(mut paths, r.path)
    }
    print("shutdown {sdk.shutdown()}")
    print("final collection on shutdown {receive(c).path}")
    var lines: []str = []
    for path in ["/opentelemetry.proto.collector.trace.v1.TraceService/Export", "/opentelemetry.proto.collector.metrics.v1.MetricsService/Export", "/opentelemetry.proto.collector.logs.v1.LogsService/Export"] {
        for line in by_path[path] ?? [] {
            push(mut lines, line)
        }
    }
    lines
}

fn retries(c: *Collector) {
    let o = otel.OtlpOptions { endpoint: "http://127.0.0.1:{c.port}", protocol: Grpc, timeout: 3000, backoff: 1, attempts: 3 }
    let exporter = otel.otlp_span_exporter(o)
    var captured: []*otel.SpanData = []
    using sdk = otel.install(otel.Config {
        span_processors: [otel.simple_span_processor(otel.SpanExporter {
            export: fn(spans) -> bool {
                for d in spans {
                    push(mut captured, d)
                }
                true
            }
            shutdown: fn() {}
        })]
    })
    otel.tracer("retry").start("retried").end()
    sdk.shutdown()
    let data = captured
    c.replies <- TrailersOnly(14)
    print("unavailable then ok {exporter.export(data)}")
    print("requests {receive(c).path} {receive(c).path}")
    c.replies <- TrailersOnly(4)
    c.replies <- TrailersOnly(10)
    print("deadline exceeded, aborted then ok {exporter.export(data)}")
    print("requests {receive(c).path} {receive(c).path} {receive(c).path}")
    c.replies <- Throttled(80)
    let before = time.now_nanos()
    print("resource exhausted with retry info then ok {exporter.export(data)}")
    print("waited for retry info {time.now_nanos() - before >= 80000000}")
    print("requests {receive(c).path} {receive(c).path}")
    c.replies <- TrailersOnly(8)
    print("resource exhausted without retry info {exporter.export(data)}")
    print("requests {receive(c).path}")
    c.replies <- TrailersOnly(3)
    print("invalid argument {exporter.export(data)}")
    print("requests {receive(c).path}")
    c.replies <- HttpStatus(503)
    c.replies <- HttpStatus(503)
    c.replies <- HttpStatus(503)
    print("gives up after attempts {exporter.export(data)}")
    print("requests {receive(c).path} {receive(c).path} {receive(c).path}")
    let leftover = select {
        r = <-c.received => "unexpected {(r ?? receive(c)).path}"
        after(50) => "none"
    }
    print("extra requests {leftover}")
}

fn main() ! io.Error {
    using l = net.listen("127.0.0.1", 0)?
    let c = collector(l)
    let plain = round(c, false)
    for line in plain {
        print(line)
    }
    let gzipped = round(c, true)
    var same = plain.len == gzipped.len
    for i in 0..plain.len {
        if same && plain[i] != gzipped[i] {
            print("differs: {plain[i]}")
            print("   gzip: {gzipped[i]}")
            same = false
        }
    }
    print("gzip decodes to the same telemetry {same}")
    retries(c)
}

fn all(data: []u8) -> []protobuf.Field {
    var out: []protobuf.Field = []
    let d = protobuf.decoder(data)
    for {
        let f = d.next() catch {
            _ => return out
        }
        match f {
            some(x) => push(mut out, x)
            none => return out
        }
    }
}

fn each(data: []u8, number: i64) -> []protobuf.Field {
    var out: []protobuf.Field = []
    for f in all(data) {
        if f.number == number {
            push(mut out, f)
        }
    }
    out
}

fn one(data: []u8, number: i64) -> protobuf.Field? {
    let found = each(data, number)
    if found.len == 0 {
        return none
    }
    found[found.len - 1]
}

fn pb_text(data: []u8, number: i64) -> str {
    match one(data, number) {
        some(f) => str(f.data)
        none => ""
    }
}

fn pb_int(data: []u8, number: i64) -> i64 {
    match one(data, number) {
        some(f) => i64(f.value)
        none => 0
    }
}

fn pb_hex(data: []u8, number: i64) -> str {
    match one(data, number) {
        some(f) => text.encode_hex(f.data)
        none => ""
    }
}

fn pb_double(f: protobuf.Field) -> f64 {
    f.as_double() catch 0.0
}

fn pb_any(data: []u8) -> str {
    for f in all(data) {
        if f.number == 1 {
            return "s:{str(f.data)}"
        }
        if f.number == 2 {
            return "b:{f.value != 0}"
        }
        if f.number == 3 {
            return "i:{i64(f.value)}"
        }
        if f.number == 4 {
            return "d:{pb_double(f)}"
        }
        if f.number == 5 {
            var parts: []str = []
            for v in each(f.data, 1) {
                push(mut parts, pb_any(v.data))
            }
            return "a:[{text.join(parts, ",")}]"
        }
        if f.number == 6 {
            return "m:{{{pb_attributes(f.data, 1)}}}"
        }
        if f.number == 7 {
            return "x:{text.encode_hex(f.data)}"
        }
    }
    "empty"
}

fn pb_attributes(data: []u8, number: i64) -> str {
    var parts: []str = []
    for kv in each(data, number) {
        let value = match one(kv.data, 2) {
            some(v) => pb_any(v.data)
            none => "missing"
        }
        push(mut parts, "{pb_text(kv.data, 1)}={value}")
    }
    text.join(parts, " ")
}

fn pb_scope(data: []u8) -> str {
    match one(data, 1) {
        some(s) => "scope {pb_text(s.data, 1)} {pb_text(s.data, 2)}"
        none => "scope missing"
    }
}

fn pb_resource(data: []u8) -> str {
    match one(data, 1) {
        some(r) => "resource {pb_attributes(r.data, 1)}"
        none => "resource missing"
    }
}

fn pb_traces(body: []u8) -> []str {
    var lines: []str = []
    for rs in each(body, 1) {
        push(mut lines, pb_resource(rs.data))
        for ss in each(rs.data, 2) {
            push(mut lines, pb_scope(ss.data))
            for sp in each(ss.data, 2) {
                let d = sp.data
                var status = "unset"
                match one(d, 15) {
                    some(st) => {
                        status = "{pb_int(st.data, 3)}:{pb_text(st.data, 2)}"
                    }
                    none => {}
                }
                let times = (one(d, 7) ?? protobuf.Field { number: 0, wire: Varint, value: 0, data: [] }).value
                let ends = (one(d, 8) ?? protobuf.Field { number: 0, wire: Varint, value: 0, data: [] }).value
                push(mut lines, "span \"{pb_text(d, 5)}\" kind={pb_int(d, 6)} trace={pb_hex(d, 1)} span={pb_hex(d, 2)} parent={pb_hex(d, 4)} state={pb_text(d, 3)} timed={times > 0 && ends >= times} flags={pb_int(d, 16)} status={status}")
                push(mut lines, "  attributes {pb_attributes(d, 9)}")
                for e in each(d, 11) {
                    push(mut lines, "  event \"{pb_text(e.data, 2)}\" timed={pb_int(e.data, 1) > 0} {pb_attributes(e.data, 3)}")
                }
                for l in each(d, 13) {
                    push(mut lines, "  link trace={pb_hex(l.data, 1)} span={pb_hex(l.data, 2)} state={pb_text(l.data, 3)} flags={pb_int(l.data, 6)} {pb_attributes(l.data, 4)}")
                }
            }
        }
    }
    lines
}

fn pb_metrics(body: []u8) -> []str {
    var lines: []str = []
    for rm in each(body, 1) {
        push(mut lines, pb_resource(rm.data))
        for sm in each(rm.data, 2) {
            push(mut lines, pb_scope(sm.data))
            for m in each(sm.data, 2) {
                let d = m.data
                push(mut lines, "metric {pb_text(d, 1)} unit={pb_text(d, 3)} description={pb_text(d, 2)}")
                match one(d, 7) {
                    some(sum) => {
                        push(mut lines, "  sum temporality={pb_int(sum.data, 2)} monotonic={pb_int(sum.data, 3)}")
                        for p in each(sum.data, 1) {
                            var value = "none"
                            match one(p.data, 6) {
                                some(f) => {
                                    value = "int {i64(f.value)}"
                                }
                                none => {}
                            }
                            match one(p.data, 4) {
                                some(f) => {
                                    value = "double {pb_double(f)}"
                                }
                                none => {}
                            }
                            push(mut lines, "  point {value} timed={pb_int(p.data, 3) != 0 && pb_int(p.data, 2) != 0} {pb_attributes(p.data, 7)}")
                        }
                    }
                    none => {}
                }
                match one(d, 9) {
                    some(h) => {
                        push(mut lines, "  histogram temporality={pb_int(h.data, 2)}")
                        for p in each(h.data, 1) {
                            let counts: []u64 = match one(p.data, 6) {
                                some(f) => f.unpack_fixed64() catch []
                                none => []
                            }
                            let bounds: []f64 = match one(p.data, 7) {
                                some(f) => f.unpack_doubles() catch []
                                none => []
                            }
                            var cs: []str = []
                            for c in counts {
                                push(mut cs, "{c}")
                            }
                            var bs: []str = []
                            for b in bounds {
                                push(mut bs, "{b}")
                            }
                            let sum = match one(p.data, 5) {
                                some(f) => pb_double(f)
                                none => -1.0
                            }
                            let min = match one(p.data, 11) {
                                some(f) => pb_double(f)
                                none => -1.0
                            }
                            let max = match one(p.data, 12) {
                                some(f) => pb_double(f)
                                none => -1.0
                            }
                            push(mut lines, "  point count={pb_int(p.data, 4)} sum={sum} min={min} max={max} buckets=[{text.join(cs, ",")}] bounds=[{text.join(bs, ",")}] {pb_attributes(p.data, 9)}")
                        }
                    }
                    none => {}
                }
            }
        }
    }
    lines
}

fn pb_logs(body: []u8) -> []str {
    var lines: []str = []
    for rl in each(body, 1) {
        push(mut lines, pb_resource(rl.data))
        for sl in each(rl.data, 2) {
            push(mut lines, pb_scope(sl.data))
            for r in each(sl.data, 2) {
                let d = r.data
                let body_text = match one(d, 5) {
                    some(b) => pb_any(b.data)
                    none => "none"
                }
                push(mut lines, "log severity={pb_int(d, 2)} text={pb_text(d, 3)} body={body_text} trace={pb_hex(d, 9)} span={pb_hex(d, 10)} flags={pb_int(d, 8)} timed={pb_int(d, 1) != 0 && pb_int(d, 11) != 0} {pb_attributes(d, 6)}")
            }
        }
    }
    lines
}

struct Ids {
    names: [str: str]
}

fn masked(lines: []str, ids: *Ids) -> []str {
    var out: []str = []
    for line in lines {
        var l = line
        for hex, name in ids.names {
            for {
                let at = text.index(l, hex)
                if at < 0 {
                    break
                }
                l = "{l[..at]}<{name}>{l[at + hex.len..]}"
            }
        }
        push(mut out, l)
    }
    out
}

fn emit_signals(ids: *Ids) {
    let t = otel.tracer("fixture/export")
    let log = otel.logger("fixture/log")
    let remote = otel.SpanContext { trace_hi: 0x0102030405060708, trace_lo: 0x090a0b0c0d0e0f10, span_id: 0x1112131415161718, flags: 1, state: "vendor=x", remote: true }
    ids.names[otel.trace_id_hex(remote)] = "linked trace"
    ids.names[otel.span_id_hex(remote)] = "linked span"
    let parent = t.start_with("checkout", otel.StartOptions {
        kind: Server
        attributes: [
            otel.string("http.request.method", "POST"), otel.int("http.response.status_code", 500), otel.boolean("retry", false),
            otel.double("ratio", 0.75), otel.blob("digest", [222, 173]), otel.strings("tags", ["a", "b"]), otel.ints("sizes", [1, 2]),
            otel.attr("nested", Map([otel.string("k", "v"), otel.int("n", 3)])),
        ]
        links: [otel.Link { context: remote, attributes: [otel.string("link.reason", "fan-in")] }]
    })
    ids.names[otel.trace_id_hex(parent.context)] = "trace"
    ids.names[otel.span_id_hex(parent.context)] = "checkout"
    let outer = otel.attach(otel.current().with_span(parent))
    let child = t.start_with("charge card", otel.StartOptions { kind: Client })
    ids.names[otel.span_id_hex(child.context)] = "charge card"
    let inner = otel.attach(otel.current().with_span(child))
    log.emit(otel.LogRecord { time: time.now_nanos(), severity: 17, body: Str("card declined"), attributes: [otel.string("card.brand", "visa")] })
    otel.detach(inner)
    child.add_event("retrying", [otel.int("attempt", 2)])
    child.set_status(Ok)
    child.end()
    parent.record_exception("PaymentError", "declined")
    parent.set_status(Failed("payment failed"))
    parent.end()
    otel.detach(outer)
    log.warn("outside any span", [])
    let m = otel.meter("fixture/meter")
    let orders = otel.counter[i64](m, "orders", "{{order}}", "Orders placed")
    orders.add(3, [otel.string("region", "eu")])
    orders.add(4, [otel.string("region", "us")])
    let load = otel.up_down_counter[f64](m, "load", "1", "")
    load.add(1.5, [])
    let latency = otel.histogram[f64](m, "latency", "s", "", [0.1, 1.0])
    latency.record(0.05, [])
    latency.record(0.5, [])
    latency.record(2.0, [])
}
