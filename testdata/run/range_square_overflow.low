fn main() {
    var composite: []u8 = []
    for i in 0..16 {
        push(mut composite, u8(0))
    }
    let limit = 3037000501
    for i in 3037000498..limit {
        print(i)
        var j = i * i
        for j < limit {
            composite[j] = 1
            j += i
        }
    }
    print("unreachable")
}
