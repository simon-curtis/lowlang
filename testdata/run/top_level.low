import std/text

enum Problem {
    Negative(i64)
}

fn checked(n: i64) -> i64 ! Problem {
    if n < 0 {
        fail Problem.Negative(n)
    }
    n
}

let name = "low"
var total = 0
for i in 0..4 {
    total += i
}
print("{name} {total}")

fn double(x: i64) -> i64 {
    x * 2
}

let n = checked(double(total))?
print(n)
let parsed = text.parse_int("12") or 0
print(parsed)
let shout = fn(s: str) -> str { "{s}!" }
print(shout(name))
defer print("done")
total + 1
checked(-1)?
print("unreachable")
