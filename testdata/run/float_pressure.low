fn pressure64(seed: f64) -> f64 {
    let a0 = seed + 1.0
    let a1 = seed * 2.0
    let a2 = seed - 3.0
    let a3 = a0 * a1
    let a4 = a1 + a2
    let a5 = a2 * a3
    let a6 = a3 - a4
    let a7 = a4 + a5
    let a8 = a5 * 0.5
    let a9 = a6 + a7
    let a10 = a7 * a8
    let a11 = a8 - a9
    let a12 = a9 + a10
    let a13 = a10 * 0.25
    let a14 = a11 + a12
    let a15 = a12 - a13
    let a16 = a13 + a14
    let a17 = a14 * a15
    let a18 = a15 + a16
    let a19 = a16 - a17
    let a20 = a17 + a18
    let a21 = a18 * 0.125
    let a22 = a19 + a20
    let a23 = a20 - a21
    a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8 + a9 + a10 + a11 + a12 + a13 + a14 + a15 + a16 + a17 + a18 + a19 + a20 + a21 + a22 + a23
}

fn pressure32(seed: f32) -> f32 {
    let a0 = seed + 1.0
    let a1 = seed * 2.0
    let a2 = seed - 3.0
    let a3 = a0 * a1
    let a4 = a1 + a2
    let a5 = a2 * a3
    let a6 = a3 - a4
    let a7 = a4 + a5
    let a8 = a5 * 0.5
    let a9 = a6 + a7
    let a10 = a7 * a8
    let a11 = a8 - a9
    let a12 = a9 + a10
    let a13 = a10 * 0.25
    let a14 = a11 + a12
    let a15 = a12 - a13
    let a16 = a13 + a14
    let a17 = a14 * a15
    let a18 = a15 + a16
    let a19 = a16 - a17
    let a20 = a17 + a18
    let a21 = a18 * 0.125
    let a22 = a19 + a20
    let a23 = a20 - a21
    a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8 + a9 + a10 + a11 + a12 + a13 + a14 + a15 + a16 + a17 + a18 + a19 + a20 + a21 + a22 + a23
}

fn loop_pressure(n: i64) -> f64 {
    var a = 1.0
    var b = 0.5
    var c = 0.25
    var d = 2.0
    var e = 3.0
    var f = 0.125
    var g = 1.5
    var h = 0.75
    var i = 4.0
    var j = 0.0625
    var k = 5.0
    var l = 0.375
    var m = 6.0
    var o = 0.1875
    var p = 7.0
    var q = 0.03125
    var count = 0
    for count < n {
        let t = a + b
        a = b * 0.5 + c
        b = c * 0.5 + d * 0.125
        c = d * 0.5 + e * 0.125
        d = e * 0.5 + f
        e = f * 0.5 + g
        f = g * 0.5 + h
        g = h * 0.5 + i * 0.0625
        h = i * 0.5 + j
        i = j * 0.5 + k * 0.0625
        j = k * 0.5 + l
        k = l * 0.5 + m * 0.0625
        l = m * 0.5 + o
        m = o * 0.5 + p * 0.0625
        o = p * 0.5 + q
        p = q * 0.5 + t * 0.0625
        q = t * 0.5
        count += 1
    }
    a + b + c + d + e + f + g + h + i + j + k + l + m + o + p + q
}

fn main() {
    print(pressure64(1.5))
    print(pressure64(-2.25))
    print(pressure32(1.5))
    print(pressure32(-2.25))
    print(loop_pressure(1))
    print(loop_pressure(100))
    print(loop_pressure(5000))
}
