fn tag(s: str) -> str {
    print("eval {s}")
    s
}

fn join5(a: str, b: str, c: str, d: str, e: str) -> str {
    a + b + c + d + e
}

fn label(name: str, n: i64, ok: bool, ratio: f64, small: f32, big: u64) -> str {
    "{name}:{n}/{ok}/{ratio}/{small}/{big}!"
}

fn main() {
    print(join5("alpha", "beta", "gamma", "delta", "epsilon"))
    print(join5("", "", "", "", ""))
    print(join5("a", "", "b", "", "c").len)
    print("x" + ("y" + "z") + "w")
    print(tag("1") + tag("2") + tag("3") + tag("4"))
    let name = "ada"
    print(name + "-" + name + "-" + "{name}")
    print("[" + "{name} {name.len}" + "]")
    print(label("k", -42, true, 1.5, 0.25, 18446744073709551615))
    print(label("", 0, false, -0.0, 1e21, 0))
    var long = ""
    for i in 0..50 {
        long = long + "{i}," + "-"
    }
    print(long)
    print(long.len)
    let multi = "héllo" + " " + "wörld" + " " + "日本"
    print(multi)
    print(multi.len)
    let empty = "" + ""
    print(empty.len)
    print(("a" + "b") == "ab")
}
