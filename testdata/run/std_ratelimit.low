import std/atomic
import std/cancel
import std/ratelimit
import std/sync
import std/time/clock
import std/time/duration
import std/time/timestamp

fn ns(d: duration.Duration) -> i64 {
    duration.as_nanos(d) ?? -1
}

fn show_delay(d: duration.Duration?) -> str {
    match d {
        some(v) => "{ns(v)}"
        none => "none"
    }
}

fn error_name(e: ratelimit.Error) -> str {
    match e {
        Cancelled => "cancelled"
        TooLarge => "too large"
    }
}

fn clocked() -> clock.Manual {
    clock.manual(timestamp.epoch())
}

fn burst_and_refill() {
    let m = clocked()
    let b = ratelimit.bucket(10, 5, m.clock())
    var granted = 0
    for i in 0..8 {
        if ratelimit.allow(b) {
            granted += 1
        }
    }
    print("initial granted {granted} available {ratelimit.available(b)} burst {ratelimit.burst(b)}")
    m.advance(duration.nanoseconds(99999999))
    print("short of a token {ratelimit.allow(b)} delay {show_delay(ratelimit.delay(b, 1))}")
    m.advance(duration.nanoseconds(1))
    print("exact token {ratelimit.allow(b)} again {ratelimit.allow(b)}")
    m.advance(duration.hours(1))
    print("cap {ratelimit.available(b)} {ratelimit.allow_n(b, 6)} {ratelimit.allow_n(b, 0)} {ratelimit.allow_n(b, -1)} {ratelimit.allow_n(b, 5)} {ratelimit.allow_n(b, 1)}")
    m.advance(duration.milliseconds(250))
    print("fraction {ratelimit.available(b)} {ratelimit.allow_n(b, 3)} {ratelimit.allow_n(b, 3)}")
    m.advance(duration.milliseconds(-3000))
    print("backwards {ratelimit.available(b)} {ratelimit.allow(b)}")
    m.advance(duration.milliseconds(100))
    print("after backwards {ratelimit.allow(b)} {ratelimit.allow(b)}")
}

fn reservations() {
    let m = clocked()
    let b = ratelimit.bucket(10, 5, m.clock())
    print("drain {ratelimit.allow_n(b, 5)}")
    print("reserve {show_delay(ratelimit.reserve(b, 1))} {show_delay(ratelimit.reserve(b, 1))} {show_delay(ratelimit.reserve(b, 3))}")
    print("peek {show_delay(ratelimit.delay(b, 1))} {show_delay(ratelimit.delay(b, 1))}")
    print("too large {show_delay(ratelimit.reserve(b, 6))} {show_delay(ratelimit.delay(b, 6))} {show_delay(ratelimit.reserve(b, -1))}")
    m.advance(duration.milliseconds(599))
    print("before {ratelimit.allow(b)}")
    m.advance(duration.milliseconds(1))
    print("after {ratelimit.allow(b)} {ratelimit.allow(b)}")
    ratelimit.refund(b, 2)
    print("refund {ratelimit.available(b)} {show_delay(ratelimit.delay(b, 3))}")
    ratelimit.refund(b, 100)
    print("refund cap {ratelimit.available(b)}")
    print("zero {show_delay(ratelimit.reserve(b, 0))}")
}

fn rounding() {
    let m = clocked()
    let b = ratelimit.bucket(3, 1, m.clock())
    print("three per second {ratelimit.allow(b)} delay {show_delay(ratelimit.delay(b, 1))}")
    m.advance(duration.nanoseconds(333333333))
    print("one short {ratelimit.allow(b)} delay {show_delay(ratelimit.delay(b, 1))}")
    m.advance(duration.nanoseconds(1))
    print("one over {ratelimit.allow(b)} delay {show_delay(ratelimit.delay(b, 1))}")
    let timeline = clocked()
    let steady = ratelimit.bucket(3, 1, timeline.clock())
    let c = timeline.clock()
    var marks = ""
    for i in 1..3001 {
        ratelimit.allow(steady)
        let wait = ratelimit.delay(steady, 1) ?? duration.zero()
        timeline.advance(wait)
        if i <= 3 || i % 1000 == 0 {
            marks = "{marks} {i}:{ns(c.monotonic())}"
        }
    }
    print("clipped{marks}")
    let carry = clocked()
    let cc = carry.clock()
    let carried = ratelimit.bucket(3, 3, cc)
    ratelimit.allow_n(carried, 3)
    marks = ""
    for i in 1..3001 {
        carry.advance(ratelimit.delay(carried, 1) ?? duration.zero())
        ratelimit.allow(carried)
        if i <= 3 || i % 1000 == 0 {
            marks = "{marks} {i}:{ns(cc.monotonic())}"
        }
    }
    print("carried{marks}")
    let slow = ratelimit.bucket_per(1, duration.minutes(90), 1, clocked().clock())
    print("slow {ratelimit.allow(slow)} {show_delay(ratelimit.delay(slow, 1))}")
    let sub = clocked()
    let fine = ratelimit.bucket(1000000000, 4, sub.clock())
    print("gigahertz {ratelimit.allow_n(fine, 4)} {show_delay(ratelimit.delay(fine, 1))} {show_delay(ratelimit.delay(fine, 4))}")
}

fn tuning() {
    let m = clocked()
    let b = ratelimit.bucket(10, 5, m.clock())
    ratelimit.allow_n(b, 5)
    m.advance(duration.milliseconds(50))
    ratelimit.set_rate(b, 20)
    m.advance(duration.milliseconds(25))
    print("set_rate {ratelimit.allow(b)} {ratelimit.allow(b)} delay {show_delay(ratelimit.delay(b, 1))}")
    let c = ratelimit.bucket(10, 5, m.clock())
    ratelimit.allow_n(c, 2)
    m.advance(duration.milliseconds(50))
    ratelimit.set_rate_per(c, 1, duration.minutes(1))
    print("set_rate_per {ratelimit.available(c)} {show_delay(ratelimit.delay(c, 4))} {show_delay(ratelimit.delay(c, 5))}")
    ratelimit.set_burst(c, 2)
    print("set_burst {ratelimit.available(c)} {ratelimit.burst(c)} {show_delay(ratelimit.delay(c, 3))}")
    ratelimit.set_burst(c, 4)
    m.advance(duration.minutes(2))
    print("grown {ratelimit.available(c)}")
}

fn window_limits() {
    let m = clocked()
    let w = ratelimit.window(3, duration.seconds(1), m.clock())
    var row = ""
    for step in 0..3 {
        row = "{row} {ratelimit.admit(w)}"
        m.advance(duration.milliseconds(100))
    }
    print("window fill{row} full {ratelimit.admit(w)} count {ratelimit.in_window(w)} retry {ns(ratelimit.retry_in(w))}")
    m.advance(duration.milliseconds(699))
    print("window early {ratelimit.admit(w)} retry {ns(ratelimit.retry_in(w))}")
    m.advance(duration.milliseconds(1))
    print("window edge {ratelimit.admit(w)} count {ratelimit.in_window(w)} retry {ns(ratelimit.retry_in(w))}")
    m.advance(duration.nanoseconds(99999999))
    print("window ns {ratelimit.admit(w)} retry {ns(ratelimit.retry_in(w))}")
    m.advance(duration.hours(1))
    print("window idle {ratelimit.in_window(w)} retry {ns(ratelimit.retry_in(w))}")

    let big = ratelimit.window(100, duration.seconds(1), m.clock())
    var total = 0
    for round in 0..12 {
        for i in 0..130 {
            if ratelimit.admit(big) {
                total += 1
            }
            m.advance(duration.milliseconds(7))
        }
    }
    print("window rolling {total} {ratelimit.in_window(big)}")
}

fn parallel_bucket() {
    let m = clocked()
    let b = ratelimit.bucket(1000, 100, m.clock())
    let granted = atomic.int(0)
    let finished = sync.wait_group()
    finished.add(8)
    for t in 0..8 {
        spawn fn() {
            for i in 0..50 {
                if ratelimit.allow(b) {
                    granted.add_int(1)
                }
            }
            finished.done()
        }()
    }
    finished.wait()
    print("parallel granted {granted.load_int()}")
}

fn parallel_keyed() {
    let m = clocked()
    let k = ratelimit.keyed[i64](1, 3, 64, duration.zero(), m.clock())
    let granted = atomic.int(0)
    let finished = sync.wait_group()
    finished.add(8)
    for t in 0..8 {
        spawn fn() {
            for i in 0..40 {
                if ratelimit.allow_key(k, i % 4) {
                    granted.add_int(1)
                }
            }
            finished.done()
        }()
    }
    finished.wait()
    print("parallel keyed granted {granted.load_int()} tracked {ratelimit.tracked(k)}")
}

fn keyed_limits() {
    let m = clocked()
    let k = ratelimit.keyed[str](1, 1, 3, duration.seconds(10), m.clock())
    print("keys {ratelimit.allow_key(k, "a")} {ratelimit.allow_key(k, "b")} {ratelimit.allow_key(k, "c")} tracked {ratelimit.tracked(k)}")
    print("again {ratelimit.allow_key(k, "a")} {ratelimit.allow_key(k, "b")} {ratelimit.allow_key(k, "c")}")
    print("evict {ratelimit.allow_key(k, "d")} tracked {ratelimit.tracked(k)}")
    print("lost state {ratelimit.allow_key(k, "a")} {ratelimit.allow_key(k, "b")} {ratelimit.allow_key(k, "a")} tracked {ratelimit.tracked(k)}")
    print("reserve {show_delay(ratelimit.reserve_key(k, "b", 1))} {show_delay(ratelimit.reserve_key(k, "b", 2))}")
    m.advance(duration.seconds(6))
    print("touch {ratelimit.allow_key(k, "z")} tracked {ratelimit.tracked(k)}")
    m.advance(duration.seconds(5))
    ratelimit.sweep(k)
    print("idle swept tracked {ratelimit.tracked(k)} z {ratelimit.allow_key(k, "z")}")
    ratelimit.forget_key(k, "z")
    ratelimit.forget_key(k, "missing")
    print("forgotten tracked {ratelimit.tracked(k)}")
    let b = ratelimit.bucket_for(k, "shared")
    print("bucket_for {ratelimit.allow(b)} {ratelimit.allow_key(k, "shared")}")
    let counted = ratelimit.keyed[i64](5, 5, 2, duration.zero(), m.clock())
    for i in 0..100 {
        ratelimit.allow_key(counted, i)
    }
    print("bounded tracked {ratelimit.tracked(counted)}")
}

fn waiting() {
    let m = clocked()
    let t = cancel.token()
    let b = ratelimit.bucket(10, 1, m.clock())
    var row = ""
    for i in 0..4 {
        ratelimit.wait(b, t) catch { e => { row = "{row} {error_name(e)}" } }
    }
    var recorded = ""
    for w in clock.sleeps(m) {
        recorded = "{recorded} {ns(w)}"
    }
    print("wait sleeps{recorded}{row}")
    ratelimit.wait_n(b, 9, t) catch { e => print("wait too large {error_name(e)}") }
    ratelimit.wait(b, t) or print("unexpected")
    print("wait delay {show_delay(ratelimit.delay(b, 1))}")

    let frozen = clock.fixed(timestamp.epoch())
    let slow = ratelimit.bucket(1, 1, frozen)
    ratelimit.allow(slow)
    let stop = cancel.token()
    spawn fn() {
        sleep(20)
        cancel.cancel(stop)
    }()
    ratelimit.wait(slow, stop) catch { e => print("wait interrupted {error_name(e)}") }
    print("after interrupt {show_delay(ratelimit.delay(slow, 1))}")
    ratelimit.wait(slow, stop) catch { e => print("wait cancelled first {error_name(e)}") }
    print("no reservation {show_delay(ratelimit.delay(slow, 1))}")

    let fast = ratelimit.bucket(1000, 1, clock.system())
    ratelimit.allow(fast)
    ratelimit.wait(fast, cancel.token()) or print("unexpected")
    print("real wait done")

    let wm = clocked()
    let w = ratelimit.window(2, duration.seconds(1), wm.clock())
    for i in 0..5 {
        ratelimit.admit_wait(w, t) or print("unexpected")
        wm.advance(duration.milliseconds(300))
    }
    var windowed = ""
    for v in clock.sleeps(wm) {
        windowed = "{windowed} {ns(v)}"
    }
    print("window waits{windowed}")
    ratelimit.admit_wait(w, stop) catch { e => print("window cancelled {error_name(e)}") }
}

fn main() {
    burst_and_refill()
    reservations()
    rounding()
    tuning()
    window_limits()
    parallel_bucket()
    parallel_keyed()
    keyed_limits()
    waiting()
}
