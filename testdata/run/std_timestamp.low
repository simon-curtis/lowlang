import std/time/duration
import std/time/fault
import std/time/rounding
import std/time/timestamp

fn describe(e: fault.Fault) -> str {
    match e {
        Syntax(at) => "syntax {at}"
        Overflow => "overflow"
        Invalid(what) => "invalid {what}"
        OutOfRange(what) => "range {what}"
        _ => "other"
    }
}

fn show(ts: timestamp.Timestamp) -> str {
    timestamp.to_string(ts)
}

fn show_option(ts: timestamp.Timestamp?) -> str {
    match ts {
        some(v) => show(v)
        none => "none"
    }
}

fn stamp(secs: i64, nanos: i64) -> timestamp.Timestamp {
    timestamp.from_parts(secs, nanos) catch { e => timestamp.epoch() }
}

fn dur(secs: i64, nanos: i64) -> duration.Duration {
    duration.from_parts(secs, nanos)
}

fn show_duration(d: duration.Duration) -> str {
    "{duration.whole_seconds(d)}/{duration.subsec_nanos(d)}"
}

fn mode_name(m: rounding.Rounding) -> str {
    match m {
        Trunc => "trunc"
        Ceil => "ceil"
        Floor => "floor"
        Expand => "expand"
        HalfExpand => "half_expand"
        HalfEven => "half_even"
        HalfTrunc => "half_trunc"
        HalfCeil => "half_ceil"
        HalfFloor => "half_floor"
    }
}

fn all_modes() -> []rounding.Rounding {
    [
        rounding.Rounding.Trunc,
        rounding.Rounding.Ceil,
        rounding.Rounding.Floor,
        rounding.Rounding.Expand,
        rounding.Rounding.HalfExpand,
        rounding.Rounding.HalfEven,
        rounding.Rounding.HalfTrunc,
        rounding.Rounding.HalfCeil,
        rounding.Rounding.HalfFloor
    ]
}

fn unix_text(secs: i64) -> str {
    let ts = timestamp.from_unix(secs) catch {
        e => return describe(e)
    }
    show(ts)
}

fn millis_text(ms: i64) -> str {
    let ts = timestamp.from_unix_millis(ms) catch {
        e => return describe(e)
    }
    show(ts)
}

fn parts_text(secs: i64, nanos: i64) -> str {
    let ts = timestamp.from_parts(secs, nanos) catch {
        e => return describe(e)
    }
    show(ts)
}

fn constructors() {
    print("epoch {show(timestamp.epoch())}")
    print("earliest {show(timestamp.earliest())}")
    print("latest {show(timestamp.latest())}")
    let seconds: []i64 = [-62135596801, -62135596800, -1, 0, 1, 1794391200, 253402300799, 253402300800, 9223372036854775807, -9223372036854775807]
    for s in seconds {
        print("from_unix {s} {unix_text(s)}")
    }
    let millis: []i64 = [0, 1, -1, 999, 1000, -1000, -1001, 1500, -1500, 1234567890123, -62135596800000, -62135596800001, 253402300799999, 253402300800000, 9223372036854775807, -9223372036854775807 - 1]
    for ms in millis {
        print("from_unix_millis {ms} {millis_text(ms)}")
    }
    let nanos: []i64 = [0, 1, -1, 999999999, 1000000000, 1500000000, -1500000000, 1234567890123456789, 9223372036854775807, -9223372036854775807 - 1]
    for n in nanos {
        print("from_unix_nanos {n} {show(timestamp.from_unix_nanos(n))}")
    }
    let pairs: []i64 = [
        0, 1500000000, 0, -1, 5, -2500000000, -62135596800, -1, -62135596800, 0, 253402300799, 999999999, 253402300799, 1000000000,
        253402300798, 1999999999, 0, 9223372036854775807, 0, -9223372036854775807 - 1, 4000000000000000001, 0, -4000000000000000001, 0,
        -62135596801, 1000000000, -62135596801, 999999999, 253402300800, -1, 253402300800, -1000000000
    ]
    var i = 0
    for i + 1 < pairs.len {
        print("from_parts {pairs[i]} {pairs[i + 1]} {parts_text(pairs[i], pairs[i + 1])}")
        i += 2
    }
}

fn nanos_text(ts: timestamp.Timestamp) -> str {
    match timestamp.unix_nanos(ts) {
        some(n) => "{n}"
        none => "none"
    }
}

fn accessors() {
    let pairs: []i64 = [
        -1, 999999999, 0, 0, 1, 1, -62135596800, 0, 253402300799, 999999999, 9223372036, 854775807, 9223372036, 854775808,
        -9223372037, 145224192, -9223372037, 145224191, 1794391200, 123456789, -1, 1, -2, 500000000, -1000, 0
    ]
    var i = 0
    for i + 1 < pairs.len {
        let ts = stamp(pairs[i], pairs[i + 1])
        print("accessors {show(ts)} {timestamp.unix_seconds(ts)} {timestamp.unix_millis(ts)} {nanos_text(ts)} {timestamp.subsec_nanos(ts)}")
        i += 2
    }
}

fn plus_text(ts: timestamp.Timestamp, d: duration.Duration) -> str {
    let r = timestamp.plus(ts, d) catch {
        e => return describe(e)
    }
    show(r)
}

fn minus_text(ts: timestamp.Timestamp, d: duration.Duration) -> str {
    let r = timestamp.minus(ts, d) catch {
        e => return describe(e)
    }
    show(r)
}

fn arithmetic() {
    let bases: []i64 = [
        0, 0, 253402300799, 999999999, -62135596800, 0, 1794391200, 500000000, -1, 999999999, 253402300799, 0, -62135596800, 1
    ]
    let deltas: []i64 = [
        0, 1, 0, -1, 1, 0, -1, 0, 1, 500000000, -1, -500000000, 86400, 0, -86400, 0, 9223372036854775807, 999999999,
        -9223372036854775807, -999999999, 315537897599, 999999999, -315537897599, -999999999, 253402300800, 0, -62135596801, 0
    ]
    var i = 0
    for i + 1 < bases.len {
        let ts = stamp(bases[i], bases[i + 1])
        var j = 0
        for j + 1 < deltas.len {
            let d = dur(deltas[j], deltas[j + 1])
            print("plus {show(ts)} {show_duration(d)} {plus_text(ts, d)} {minus_text(ts, d)} {show_option(timestamp.try_plus(ts, d))} {show_option(timestamp.try_minus(ts, d))}")
            j += 2
        }
        i += 2
    }
    let a = stamp(1000, 250000000)
    let b = stamp(998, 750000000)
    print("until {show_duration(timestamp.until(a, b))} {show_duration(timestamp.until(b, a))} {show_duration(timestamp.since(a, b))} {show_duration(timestamp.since(b, a))} {show_duration(timestamp.until(a, a))}")
    print("until span {show_duration(timestamp.until(timestamp.earliest(), timestamp.latest()))} {show_duration(timestamp.since(timestamp.earliest(), timestamp.latest()))}")
}

fn ordering() {
    let all = [stamp(-62135596800, 0), stamp(-1, 999999999), stamp(0, 0), stamp(0, 1), stamp(1, 0), stamp(253402300799, 999999999)]
    for a in all {
        var row = ""
        for b in all {
            row = "{row}{timestamp.compare(a, b)} "
        }
        print("compare {row}")
    }
    let x = stamp(10, 0)
    let y = stamp(10, 1)
    print("order {timestamp.equal(x, x)} {timestamp.equal(x, y)} {timestamp.before(x, y)} {timestamp.after(x, y)} {show(timestamp.min(x, y))} {show(timestamp.max(x, y))} {x == x} {x == y}")
}

fn rounded(ts: timestamp.Timestamp, unit: duration.Duration, m: rounding.Rounding) -> str {
    let r = timestamp.round(ts, unit, m) catch {
        e => return describe(e)
    }
    show(r)
}

fn round_matrix(label: str, unit: duration.Duration, inputs: []i64) {
    for m in all_modes() {
        var row = ""
        for i in 0..inputs.len / 2 {
            row = "{row}{rounded(stamp(inputs[i * 2], inputs[i * 2 + 1]), unit, m)} "
        }
        print("round {label} {mode_name(m)} {row}")
    }
}

fn rounding_cases() {
    let to_second: []i64 = [
        10, 500000000, 11, 500000000, -10, 500000000, -11, 500000000, 10, 499999999, 10, 500000001, -10, 499999999, -10, 500000001,
        0, 0, -1, 999999999, 0, 1, 1794391200, 0
    ]
    round_matrix("1s", duration.seconds(1), to_second)
    let to_milli: []i64 = [
        0, 1500000, 0, 2500000, -1, 998500000, -1, 997500000, 5, 499999, 5, 500001, 7, 500000, 0, 0
    ]
    round_matrix("1ms", duration.milliseconds(1), to_milli)
    let to_hour: []i64 = [5400, 0, 9000, 0, -5400, 0, -9000, 0, 1799, 999999999, 1800, 0, -1800, 0, 3600, 0, 7200, 1]
    round_matrix("1h", duration.hours(1), to_hour)
    let to_day: []i64 = [43200, 0, 129600, 0, -43200, 0, -129600, 0, 43199, 999999999, 86400, 0, -86401, 0, 1794391200, 0]
    round_matrix("1d", duration.hours(24), to_day)
    let to_seven: []i64 = [
        250000000000, 500000000, 250000000003, 500000000, -50000000001, 500000000, 9, 500000000, 3, 500000000, 7, 0, 1794391200, 123456789
    ]
    round_matrix("7s", duration.seconds(7), to_seven)
    round_matrix("100ms", duration.milliseconds(100), to_seven)
    round_matrix("333ns", duration.nanoseconds(333), to_seven)
    let edges: []i64 = [253402300799, 999999999, 253402300799, 0, -62135596800, 0, -62135596800, 1, 253402300799, 500000000]
    round_matrix("1s edges", duration.seconds(1), edges)
    round_matrix("1d edges", duration.hours(24), edges)
    round_matrix("7s edges", duration.seconds(7), edges)
}

fn truncated(ts: timestamp.Timestamp, unit: duration.Duration) -> str {
    let r = timestamp.truncate(ts, unit) catch {
        e => return describe(e)
    }
    show(r)
}

fn truncation() {
    let ts = stamp(1794391234, 567891234)
    print("truncate {truncated(ts, duration.seconds(1))} {truncated(ts, duration.milliseconds(1))} {truncated(ts, duration.minutes(1))} {truncated(ts, duration.hours(1))} {truncated(ts, duration.hours(24))}")
    let before = stamp(-1, 500000000)
    print("truncate {truncated(before, duration.seconds(1))} {truncated(before, duration.milliseconds(100))} {truncated(before, duration.hours(24))}")
    print("unit errors {truncated(ts, duration.zero())} {truncated(ts, duration.seconds(-1))} {truncated(ts, duration.seconds(4611686019))}")
}

