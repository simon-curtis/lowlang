fn fractions() {
    let nanos: []i64 = [0, 1, 10, 100, 1000, 10000, 100000, 1000000, 10000000, 100000000, 500000000, 120000000, 123000000, 123400000, 123456000, 123456700, 123456789, 999999999, 999000000, 999999000, 5000]
    for n in nanos {
        print("fraction {n} {show(stamp(1000, n))}")
    }
}

fn main() {
    constructors()
    accessors()
    arithmetic()
    ordering()
    rounding_cases()
    truncation()
    text_out()
    parsing()
    http_parsing()
    fractions()
}
