        "1994-11-06T08:49:37.123456789Z", "1994-11-06T08:49:37.000000001Z", "1994-11-06T08:49:37.0Z", "1994-11-06T08:49:37.000Z",
        "1994-11-06T08:49:37.500000000+01:00", "1994-11-06T08:49:37.5-07:00", 
        "2016-12-31T23:59:60Z", "2016-12-31T23:59:60.5Z", "2026-11-11T10:00:60+05:00", "9999-12-31T23:59:60Z",
        "0001-01-01T00:00:00Z", "9999-12-31T23:59:59.999999999Z", "0001-01-01T00:00:00-00:01", "9999-12-31T23:59:59+00:01",
        "0001-01-01T01:00:00+01:00", "9999-12-31T22:59:59.999999999-01:00", "2000-02-29T00:00:00Z", "1900-03-01T00:00:00Z",
        "2024-12-31T23:59:59Z", "1969-12-31T23:59:59.5Z", "1970-01-01T00:00:00Z", "2026-11-11T10:00:00.1Z", "2100-02-28T23:59:59Z",
        "1600-02-29T12:00:00+12:00", "0400-02-29T12:00:00-12:00", "2262-04-11T23:47:16.854775807Z", "1677-09-21T00:12:43.145224192Z"
    ]
    for s in valid {
