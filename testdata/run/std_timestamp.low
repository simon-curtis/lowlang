fn text_out() {
    let all = samples()
    var i = 0
    var same = 0
    var same_http = 0
    var count = 0
    for i + 1 < all.len {
        let ts = stamp(all[i], all[i + 1])
        print("sample {show(ts)} | {timestamp.to_http_date(ts)} | {timestamp.unix_millis(ts)}")
        let back = timestamp.parse(show(ts)) catch { e => timestamp.epoch() }
        if timestamp.equal(back, ts) {
            same += 1
        }
        let http = timestamp.parse_http_date(timestamp.to_http_date(ts)) catch { e => timestamp.epoch() }
        if timestamp.equal(http, stamp(all[i], 0)) {
            same_http += 1
        }
        count += 1
        i += 2
    }
    print("roundtrip {same} {same_http} of {count}")
}

fn parsed(s: str) -> str {
    let ts = timestamp.parse(s) catch {
        e => return "{s} -> {describe(e)}"
    }
    "{s} -> {show(ts)}"
}

