fn apply(draw: fn() -> i64) -> i64 {
    var sum = 0
    for i in 0..3 {
        sum += draw() * i
    }
    for i in 0..2 {
        sum += i
    }
    sum
}

fn twice(label: str, draw: fn() -> i64) {
    for i in 0..2 {
        print("{label} {i} {apply(draw)}")
    }
    for i in 0..1 {
        print("{label} done {i}")
    }
}

fn main() {
    var now = 1
    let clock = fn() -> i64 { now }
    let k = 3
    let draw = fn() -> i64 { k + clock() }
    print(apply(draw))
    twice("first", draw)
    now = 2
    print(apply(draw))
}
