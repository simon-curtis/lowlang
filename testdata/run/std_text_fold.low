import std/text

fn describe(s: str) {
    let up = text.upper(s)
    let low = text.lower(s)
    print("[{s}] [{up}] [{low}] {up.len} {low.len}")
}

fn main() {
    for s in ["", "a", "A", "abc", "ABC", "AbC", "123", "a1B2c3", "hello world", "HELLO WORLD", "Content-Type", "x-forwarded-for", "ÀÉ àé", "straße", "MiXeD ÄÖ ascii", "~[`|@Z^_", "az AZ"] {
        describe(s)
    }
    for pair in [["Content-Length", "content-length"], ["host", "HOST"], ["host", "hos"], ["", ""], ["a", "B"], ["Ab", "aB"], ["é", "É"], ["é", "é"], ["@", "`"], ["[", "|"], ["Z", "z"]] {
        print("{pair[0]} {pair[1]} {text.equal_fold(pair[0], pair[1])}")
    }
    for pair in [["multipart/form-data", "multipart/"], ["MULTIPART/mixed", "multipart/"], ["text/plain", "multipart/"], ["multi", "multipart/"], ["", ""], ["abc", ""], ["", "a"]] {
        print("{pair[0]} {pair[1]} {text.starts_with_fold(pair[0], pair[1])}")
    }
    let original = "already lower"
    let kept = text.lower(original)
    print("{kept == original} {kept.len}")
    for s in ["inf", "Inf", "INFINITY", "-inf", "+Infinity", "nan", "NaN", "NAN", "infinit", "nano", "-nan"] {
        let v = text.parse_float(s) or 0.0
        print("{s} {v}")
    }
}
