import std/io
import std/ui/font
import std/ui/geometry
import std/ui/scene
import std/ui/text

const unbounded: f32 = 100000.0

fn drawn(sc: scene.Scene, a: scene.Atlas, index: i64) -> font.Bitmap {
    let sp = sc.sprites[index]
    let k = f32(a.size)
    let x0 = i64(sp.tile.x * k + 0.5)
    let y0 = i64(sp.tile.y * k + 0.5)
    let width = i64(sp.tile.width * k + 0.5)
    let height = i64(sp.tile.height * k + 0.5)
    var coverage: []u8 = []
    for y in 0..height {
        for x in 0..width {
            coverage.push(a.coverage.pixels[(y0 + y) * a.size + x0 + x])
        }
    }
    font.Bitmap { width, height, left: 0, top: 0, coverage }
}

fn same(a: font.Bitmap, b: font.Bitmap) -> bool {
    if a.width != b.width || a.height != b.height {
        return false
    }
    for i in 0..a.coverage.len {
        if a.coverage[i] != b.coverage[i] {
            return false
        }
    }
    true
}

fn reference(f: font.Font, c: u32, size: f32, hinting: font.Hinting) -> font.Bitmap {
    var r = font.rasterizer(f)
    font.render(mut r, f.glyph_index(c), size, 0.0, hinting)
}

fn main() {
    let f = font.fallback()
    let scales: []f32 = [1.0, 1.5, 1.99, 2.0, 3.0]
    let logical: []f32 = [26.0, 17.5, 13.5, 13.0, 8.0]
    var sys = text.system([f])
    for i in 0..scales.len {
        var sc = scene.empty(200, 100, geometry.rgb(0))
        let l = sys.wrap("H", text.Format { size: logical[i] }, unbounded)
        sys.paint(mut sc, l, geometry.point(0.0, 0.0), geometry.rgb(0xffffff), [], scales[i])
        let pixels = logical[i] * scales[i]
        let light = reference(f, 'H', pixels, font.Hinting.Light)
        let none = reference(f, 'H', pixels, font.Hinting.None)
        let tile = drawn(sc, sys.atlas, 0)
        print("scale {scales[i]} size {pixels}: sprites {sc.sprites.len} light {same(tile, light)} unhinted {same(tile, none)} apart {!same(light, none)}")
    }
}
