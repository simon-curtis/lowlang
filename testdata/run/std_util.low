import std/container/heap
import std/csv
import std/flag
import std/log
import std/path
import std/rand
import std/sync
import std/text
import std/uuid

fn paths() {
    for p in ["a/b/../c/./d/", "/../x", "", "../../a", "/", "a//b"] {
        print("clean [{p}] = {path.clean(p)}")
    }
    print(path.join(["/srv", "", "media", "../music", "song.flac"]))
    print("{path.base("/srv/media/song.flac")} {path.dir("/srv/media/song.flac")} {path.ext("song.tar.gz")} {path.stem("/a/song.flac")}")
    print("{path.base("/")} {path.base("x/")} {path.dir("file")} {path.is_absolute("/x")}")
}

fn concurrency() {
    let guard = sync.mutex()
    let group = sync.wait_group()
    let total = new(Count { n: 0 })
    for w in 0..8 {
        sync.add(group, 1)
        spawn work(guard, group, total)
    }
    sync.wait(group)
    print("total {total.n}")
    print(sync.try_lock(guard))
    print(sync.try_lock(guard))
    sync.unlock(guard)

    let o = sync.once()
    var runs = 0
    for i in 0..3 {
        sync.run(o, fn() { runs += 1 })
    }
    print("once {runs}")
}

struct Count {
    n: i64
}

fn work(guard: sync.Mutex, group: sync.WaitGroup, total: *Count) {
    for i in 0..1000 {
        sync.lock(guard)
        let seen = total.n
        sleep(0)
        total.n = seen + 1
        sync.unlock(guard)
    }
    sync.done(group)
}

fn randomness() {
    var r = rand.seeded(42)
    var again = rand.seeded(42)
    print(r.next() == again.next())
    var counts = [0, 0, 0]
    for i in 0..3000 {
        counts[r.below(3)] += 1
    }
    print(counts[0] > 900 && counts[1] > 900 && counts[2] > 900)
    let x = r.float()
    print(x >= 0.0 && x < 1.0)
    var deck = [1, 2, 3, 4, 5]
    rand.shuffle(mut r, mut deck)
    var sum = 0
    for d in deck {
        sum += d
    }
    print(sum)
    print(rand.between(mut r, 5, 5))
    let empty: []i64 = []
    print(rand.pick(mut r, empty) ?? -1)
}

fn identifiers() {
    let a = uuid.v4()
    let b = uuid.v7()
    print("{uuid.version(a)} {uuid.version(b)} {uuid.format(a).len}")
    let parsed = uuid.parse(uuid.format(b)) catch {
        _ => uuid.nil()
    }
    print(uuid.equal(parsed, b))
    print((uuid.timestamp(b) ?? 0) > 1700000000000)
    print(uuid.format(uuid.nil()))
    let bad = uuid.parse("123e4567-e89b-12d3-a456-42661417400x") catch {
        BadDigit(at) => {
            print("bad digit at {at}")
            uuid.nil()
        }
        Length => uuid.nil()
    }
}

fn tables() {
    let src = "name,notes\r\nada,\"says \"\"hi\"\"\"\nbob,\"two\nlines\"\n\nlast,\n"
    let records = csv.parse(src) catch {
        _ => []
    }
    print(records.len)
    for r in records {
        print("{r.len}: {text.join(r, "|")}")
    }
    print(csv.format([["a", "b,c"], [" x", "say \"q\""]]))
    let broken = csv.parse("a,\"open\n") catch {
        UnterminatedQuote(line) => {
            print("unterminated quote from line {line}")
            []
        }
        BareQuote(line) => []
    }
}

fn flags() {
    let specs = [
        flag.Spec { name: "dry-run", boolean: true, help: "print actions only" },
        flag.Spec { name: "workers", fallback: "4", help: "parallel workers" },
        flag.Spec { name: "out" },
    ]
    let p = flag.parse(specs, ["--dry-run", "--workers=8", "input.txt", "-out", "x.json", "--", "--literal"]) catch {
        _ => flag.Parsed {}
    }
    print("{p.enabled("dry-run")} {p.number("workers") catch { _ => 0 }} {p.get("out")} {text.join(p.rest, " ")}")
    let refused = flag.parse(specs, ["--nope"]) catch {
        Unknown(name) => {
            print("unknown flag {name}")
            flag.Parsed {}
        }
        _ => flag.Parsed {}
    }
    print(flag.usage(specs))
}

fn ordering() {
    var h = heap.heap(fn(a: i64, b: i64) -> bool { a < b })
    for x in [5, 1, 4, 1, 3, 9, 2] {
        h.insert(x)
    }
    var out: []str = []
    for h.size() > 0 {
        push(mut out, "{h.pop() ?? -1}")
    }
    print(text.join(out, " "))
}

fn logging() {
    let l = log.Logger { level: Warn, sink: log.Sink.Fd(1), prefix: "sync" }
    l.info("hidden")
    l.warn("disk nearly full")
    l.with_prefix("jellyfin").error("refused")
}

fn main() {
    paths()
    concurrency()
    randomness()
    identifiers()
    tables()
    flags()
    ordering()
    logging()
}
