fn signed(x: i64) -> str {
    "[{x}]"
}

fn unsigned(x: u64) -> str {
    "<{x}>"
}

fn narrow(a: i32, b: u8, c: u16, d: u32) -> str {
    "{a} {b} {c} {d}"
}

fn mixed(n: i64, s: str, ok: bool) -> str {
    "{s}={n}/{ok}/{n}{n}"
}

