import std/crypto/zk/pairing
import std/text

fn bytes_of(hex: str) -> []u8 {
    if hex == "." {
        return []
    }
    text.decode_hex(hex) or []
}

fn join_hex(items: [][]u8) -> str {
    var parts: []str = []
    for item in items {
        push(mut parts, text.encode_hex(item))
    }
    text.join(parts, ",")
}

fn point_hex(g: *pairing.Group, p: pairing.Point) -> str {
    let data = pairing.serialize_zcash(g, p, false) or []
    text.encode_hex(data)
}

fn check_line(bls: *pairing.Curve, line: str) -> i64 {
    let parts = text.split(line, ' ')
    if parts.len != 6 {
        return 0
    }
    let kind = parts[0]
    let dst = bytes(parts[1])
    let msg = bytes_of(parts[2])
    let g = if kind.starts_with("g1") { pairing.g1(bls) } else { pairing.g2(bls) }
    let ro = kind.ends_with("ro")
    let count = if ro { 2 } else { 1 }
    var bad = 0
    let u = pairing.hash_to_field(g, msg, dst, count) or []
    if join_hex(u) != parts[4] {
        print("FAIL u {kind} {parts[2]}")
        bad += 1
    }
    var q: []pairing.Point = []
    for item in u {
        push(mut q, pairing.map_to_curve(g, item) or pairing.identity(g))
    }
    var q_hex: []str = []
    for point in q {
        push(mut q_hex, point_hex(g, point))
    }
    if text.join(q_hex, ",") != parts[5] {
        print("FAIL Q {kind} {parts[2]}")
        bad += 1
    }
    let p = if ro { pairing.hash_to_curve(g, msg, dst) or pairing.identity(g) } else { pairing.encode_to_curve(g, msg, dst) or pairing.identity(g) }
    let got = point_hex(g, p)
    if got != parts[3] {
        print("FAIL P {kind} {parts[2]}")
        bad += 1
    }
    bad
}

fn main() {
    let bls = pairing.bls12_381()
    var bad = 0
    var n = 0
    for line in text.lines(embed("std_zk_pairing_hash_rfc9380.txt")) {
        bad += check_line(bls, line)
        n += 1
    }
    print("lines {n} bad {bad}")
}
