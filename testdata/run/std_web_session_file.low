import std/file
import std/header
import std/http
import std/io
import std/text
import std/time
import std/web

fn site(store: web.SessionStore) -> *web.App ! io.Error {
    var key: u8[] = []
    for i in 0..32 {
        key.push(u8(i))
    }
    let app = web.app()
    web.use(app, web.sessions(web.SessionOptions { key, store })?)
    let _ = web.get(app, "/in", fn(c) {
        web.session_set(c, "user", web.query(c, "as") ?? "")
        web.text(200, "in")
    })
    let _ = web.get(app, "/who", fn(c) { web.text(200, web.session_get(c, "user") ?? "nobody") })
    let _ = web.get(app, "/out", fn(c) {
        web.session_clear(c)
        web.no_content()
    })
    app
}

fn call(h: fn(http.Request) -> http.Response, target: str, cookie: str) -> http.Response {
    var req = http.new_request("GET", target)
    if cookie.len > 0 {
        req.headers = [header.Header { name: "cookie", value: cookie }]
    }
    h(req)
}

fn sign_in(h: fn(http.Request) -> http.Response, name: str) -> str {
    let set = header.get(call(h, "/in?as={name}", "").headers, "set-cookie") ?? ""
    let semi = text.index_byte(set, ';')
    if semi < 0 { set } else { set[..semi] }
}

fn who(h: fn(http.Request) -> http.Response, cookie: str) -> str {
    str(call(h, "/who", cookie).body)
}

fn outlasts(dir: str) ! io.Error {
    let target = file.child_path(dir, "kept")
    let before = web.handler(site(web.file_session_store(target)?)?)
    let ada = sign_in(before, "ada")
    let bob = sign_in(before, "bob")
    let _ = call(before, "/out", bob)
    let after = web.handler(site(web.file_session_store(target)?)?)
    print("after the store is opened again: signed out {who(after, bob)}, signed in {who(after, ada)}")
}

fn damaged(dir: str, label: str, damage: fn(str) -> str) ! io.Error {
    let target = file.child_path(dir, text.replace(label, " ", "-"))
    let before = web.handler(site(web.file_session_store(target)?)?)
    let ada = sign_in(before, "ada")
    let _ = call(before, "/out", sign_in(before, "bob"))
    let _ = call(before, "/out", sign_in(before, "cy"))
    file.write_text(target, damage(file.read_text(target)?))?
    print("{label}: signed in {who(web.handler(site(web.file_session_store(target)?)?), ada)}")
}

fn altered(content: str) -> str {
    let end = content.len - 2
    let other = if content[end] == 'A' { "B" } else { "A" }
    "{content[..end]}{other}\n"
}

fn unwritable(dir: str) ! io.Error {
    let store = web.file_session_store(file.child_path(file.child_path(dir, "absent"), "kept"))?
    let h = web.handler(site(store)?)
    let ada = sign_in(h, "ada")
    print("no directory for the file: signed in {who(h, ada)}")
    print("no directory for the file: recorded {store.revoke("bob", time.now() + 600)}, then signed in {who(h, ada)}")
}

fn shared(dir: str) ! io.Error {
    let target = file.child_path(dir, "shared")
    let first = web.file_session_store(target)?
    let far = time.now() + 600
    print("first store: recorded {first.revoke("ada", far)}")
    let second = web.file_session_store(target)?
    print("second store on the file: reads {second.revoked("ada", far)} {second.revoked("bob", far)}, recorded {second.revoke("bob", far)}, then {second.revoked("cy", far)}")
    print("first store: recorded {first.revoke("dee", far)}, unrecorded key revoked {first.revoked("cy", far)}")
}

fn main() ! io.Error {
    let dir = file.temp_dir("low-session-file")?
    defer file.remove_all(dir) or {}
    outlasts(dir)?
    damaged(dir, "file emptied", fn(content: str) -> str { "" })?
    damaged(dir, "file cut short", fn(content: str) -> str { content[..content.len - 1] })?
    damaged(dir, "entry altered", altered)?
    damaged(dir, "first line missing", fn(content: str) -> str { content[text.index_byte(content, '\n') + 1..] })?
    unwritable(dir)?
    shared(dir)?
}
