struct Point {
    x: i64
    y: i64
}

struct Line {
    a: Point
    b: Point
}

enum E {
    TooFar(Point)
}

fn make(n: i64) -> Line {
    Line { a: Point { x: n, y: n + 1 }, b: Point { x: n + 2, y: n + 3 } }
}

fn checked(l: Line) -> Line ! E {
    if l.b.x > 10 { fail TooFar(l.b) }
    l
}

fn main() ! E {
    print(make(1).b.y)
    let mid = make(5).a
    print(mid.x + mid.y)
    let ok = checked(make(2))?
    print(ok.a.x)
    let far = checked(make(20)) catch {
        TooFar(p) => Line { a: p, b: p }
    }
    print(far.a.x)
    var i = 0
    for {
        i += 1
        let l = Line { a: Point { x: i, y: if i > 2 { break } else { i } }, b: Point { x: 0, y: 0 } }
        print(l.a.y)
    }
    print(i)
    checked(make(30))?
}
