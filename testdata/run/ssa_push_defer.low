fn report(label: str, xs: i64[]) {
    print("{label}: {xs.len}")
}

fn deferred(n: i64) -> i64 {
    var xs: i64[] = []
    defer report("exit", xs)
    for i in 0..n {
        xs.push(i)
    }
    xs.push(99)
    xs.len
}

fn deferred_block(n: i64) {
    var xs: i64[] = []
    defer {
        print("deferred sees {xs.len} last {xs[xs.len - 1]}")
    }
    for i in 0..n {
        xs.push(i * i)
        if i == 4 {
            return
        }
    }
}

fn deferred_in_loop() {
    var xs: i64[] = []
    for i in 0..3 {
        defer {
            print("iteration {i} has {xs.len}")
        }
        xs.push(i)
        xs.push(i + 10)
    }
}

fn main() {
    print(deferred(8))
    deferred_block(10)
    deferred_block(3)
    deferred_in_loop()
}
