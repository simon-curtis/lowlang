import std/io
import std/text
import std/time

struct Kind {
    offset: i64
    dst: bool
    abbreviation: str
}

struct Table {
    times: []i64
    types: []i64
    kinds: []Kind
}

fn block(mut out: []u8, version: u8, width: i64, t: Table) {
    var chars: []u8 = []
    var at: []i64 = []
    for k in t.kinds {
        push(mut at, chars.len)
        text.append(mut chars, k.abbreviation)
        push(mut chars, 0)
    }
    text.append(mut out, "TZif")
    push(mut out, version)
    for _ in 0..15 {
        push(mut out, 0)
    }
    for n in [0, 0, 0, t.times.len, t.kinds.len, chars.len] {
        io.put_be32(mut out, n)
    }
    for x in t.times {
        if width == 8 {
            io.put_be64(mut out, x)
        } else {
            io.put_be32(mut out, x)
        }
    }
    for x in t.types {
        push(mut out, u8(x))
    }
    for i, k in t.kinds {
        io.put_be32(mut out, k.offset)
        push(mut out, if k.dst { 1 } else { 0 })
        push(mut out, u8(at[i]))
    }
    io.append(mut out, chars)
}

fn footer_only(rule: str) -> []u8 {
    let t = Table { times: [], types: [], kinds: [Kind { offset: 0, dst: false, abbreviation: "LMT" }] }
    var out: []u8 = []
    block(mut out, '2', 4, t)
    block(mut out, '2', 8, t)
    text.append(mut out, "\n{rule}\n")
    out
}

fn version_one() -> []u8 {
    let kinds = [Kind { offset: 3600, dst: false, abbreviation: "AAA" }, Kind { offset: 7200, dst: true, abbreviation: "BBB" }]
    var out: []u8 = []
    block(mut out, 0, 4, Table { times: [1000000000, 1100000000], types: [1, 0], kinds })
    out
}

fn report(z: time.Zone, t: i64, before: time.Zoned, after: time.Zoned) {
    let previous = time.in_zone(z, t - 1)
    print("{z.name} {time.format_instant(previous.instant)} {before.abbreviation} -> {time.format_instant(after.instant)} {after.abbreviation} dst {after.dst}")
    let low = if before.instant.offset < after.instant.offset { before.instant.offset } else { after.instant.offset }
    let high = if before.instant.offset < after.instant.offset { after.instant.offset } else { before.instant.offset }
    for wall in [t + low - 1800, t + low + 1800, t + high + 1800] {
        let local = time.from_unix(wall)
        let i = time.localize(z, local)
        print("  wall {time.format_datetime(local)} -> {time.format_instant(i)} unix {time.timestamp(i)}")
    }
}

fn scan(z: time.Zone, year: i64) {
    var t = time.days_from_civil(year, 1, 1) * 86400
    let end = time.days_from_civil(year + 1, 1, 1) * 86400
    var previous = time.in_zone(z, t)
    for t < end {
        t += 900
        let current = time.in_zone(z, t)
        if current.instant.offset != previous.instant.offset || current.abbreviation != previous.abbreviation {
            report(z, t, previous, current)
        }
        previous = current
    }
}

fn points(z: time.Zone) {
    for t in [-5364662400, -1, 0, 999999999, 1000000000, 1099999999, 1100000000, 2147483647, 2147483648, 4102444800] {
        let at = time.in_zone(z, t)
        print("{z.name} {t} {time.format_instant(at.instant)} {at.abbreviation} dst {at.dst}")
    }
}

fn error_name(e: io.Error) -> str {
    match e {
        NotFound => "NotFound"
        Invalid => "Invalid"
        Malformed => "Malformed"
        _ => "other"
    }
}

fn wall_to_utc(z: time.Zone, s: str) ! io.Error {
    let p = time.parse_datetime(s)?
    match p {
        Naive(local) => {
            let i = time.localize(z, local)
            let utc = time.at_offset(time.timestamp(i), 0)
            print("{z.name} {s} -> {time.format_instant(i)} = {time.format_instant(utc)}")
        }
        Aware(_) => print("{s} carries an offset")
    }
}

fn main() ! io.Error {
    let london = time.load_zone("Europe/London")?
    let new_york = time.load_zone("America/New_York")?
    let sydney = time.load_zone("Australia/Sydney")?
    let utc = time.load_zone("UTC")?
    for z in [london, new_york, sydney] {
        scan(z, 2024)
        scan(z, 2100)
    }
    for z in [london, new_york, utc] {
        points(z)
    }
    for s in ["2025-11-10T19:45", "2024-03-10T02:30", "2024-11-03T01:30", "2024-03-31T01:30", "2024-10-27T01:30", "2100-03-14T02:00", "2100-11-07T01:59:59", "2100-10-31T01:00"] {
        wall_to_utc(london, s)?
        wall_to_utc(new_york, s)?
    }
    let today = time.in_zone(london, 1762803900).instant.local.date
    print("london today {time.format_date(today)} {time.weekday_name(time.weekday(today))}")
    let rules = [
        "AAA3BBB,J60/2,J300/2", "AAA3BBB,59/2,299/2", "<+10>-10<+11>,M10.1.0,M4.1.0/3", "<-02>2<-01>,M3.5.0/-1,M10.5.0/0",
        "IST-2IDT,M3.4.4/26,M10.5.0", "XXX-1YYY-3,M3.5.0,M10.5.0/3", "<+0530>-5:30", "EST5EDT,M3.2.0,M11.1.0",
    ]
    for rule in rules {
        let z = time.decode_zone(rule, footer_only(rule))?
        scan(z, 2023)
        scan(z, 2024)
        let at = time.in_zone(z, 1704067200)
        print("{rule} new year {time.format_instant(at.instant)} {at.abbreviation}")
    }
    let old = time.decode_zone("version1", version_one())?
    points(old)
    for s in ["2001-09-09T03:16:39", "2001-09-09T03:46:40", "2004-11-09T13:46:39", "2004-11-09T12:46:40", "1960-01-01T00:00"] {
        wall_to_utc(old, s)?
    }
    for name in ["Mars/Olympus", "America", "../etc/passwd", "/etc/localtime", "Europe/../UTC", "", "Europe/London/x"] {
        let z = time.load_zone(name) catch {
            e => {
                print("zone '{name}' {error_name(e)}")
                continue
            }
        }
        print("zone '{name}' loaded {z.name}")
    }
    let truncated = footer_only("GMT0")
    let broken = [truncated[..30], truncated[..truncated.len - 1], footer_only("GMT"), footer_only("GMT0BST"), footer_only("GMT0BST,M13.1.0,M10.5.0")]
    for data in broken {
        let z = time.decode_zone("broken", data) catch {
            e => {
                print("broken {error_name(e)}")
                continue
            }
        }
        print("broken loaded {z.name}")
    }
}
