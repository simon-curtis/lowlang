import std/container/deque
import std/container/lru
import std/path
import std/text

fn globs() {
    let cases = [
        ["*.flac", "song.flac"],
        ["*.flac", "dir/song.flac"],
        ["*/*.flac", "dir/song.flac"],
        ["song.?lac", "song.flac"],
        ["[a-c]*", "beta"],
        ["[!a-c]*", "beta"],
        ["[]x]", "]"],
        ["a\\*b", "a*b"],
        ["a*b*c", "aXbYbZc"],
        ["a*b*c", "aXbYbZ"],
        ["", ""],
        ["*", ""],
    ]
    for c in cases {
        print("{c[0]} ~ {c[1]}: {path.matches(c[0], c[1])}")
    }
}

fn caches() {
    var c = lru.cache[str, i64](2)
    c.put("a", 1)
    c.put("b", 2)
    print(c.get("a") ?? -1)
    let evicted = c.put("c", 3) ?? "none"
    print("evicted {evicted}")
    print(c.get("b") ?? -1)
    print(c.put("a", 10) ?? "none")
    print(text.join(c.keys(), " "))
    print("{c.size()} {c.contains("c")} {c.contains("b")}")
}

fn queues() {
    var d = deque.deque[i64]()
    for i in 0..10 {
        d.push_back(i)
    }
    d.push_front(-1)
    d.push_front(-2)
    print("{d.size()} {d.front() ?? 0} {d.back() ?? 0} {d.at(5) ?? 0}")
    var out: []str = []
    for d.size() > 0 {
        push(mut out, "{d.pop_front() ?? 0}")
        if d.size() > 0 {
            push(mut out, "{d.pop_back() ?? 0}")
        }
    }
    print(text.join(out, " "))
    print(d.pop_front() ?? 99)
}

fn main() {
    globs()
    caches()
    queues()
}
