extern struct Mixed {
    r: f32 = 0.25
    g: f32 = 3.0
    b: u8 = 1
    ok: bool = true
    n: u16 = 2
    k: i32 = -1
    w: i64 = 4
    d: f64 = 0.5
}

fn show(c: Mixed) {
    print("{c.r} {c.g} {c.b} {c.ok} {c.n} {c.k} {c.w} {c.d}")
}

fn main() {
    show(Mixed {})
    show(Mixed { r: 1.5, g: -2.25, b: 200, ok: false, n: 65000, k: -70000, w: -5, d: -1.25 })
    let x = 7
    show(Mixed { r: 0.5, b: u8(x), k: i32(x) * -3 })
}
