struct Box {
    id: i64
    tags: []str
}

fn make(id: i64) -> Box {
    var tags: []str = []
    for i in 0..4 {
        push(mut tags, "tag{id}-{i}")
    }
    Box { id, tags }
}

fn inner(id: i64) -> Box {
    region {
        let local = make(id)
        let more = make(id + 100)
        Box { id: local.id + more.id, tags: local.tags }
    }
}

fn middle() -> []Box {
    region {
        var out: []Box = []
        for i in 0..3 {
            push(mut out, inner(i))
        }
        let scratch = make(999)
        push(mut out, scratch)
        out
    }
}

fn deepest(depth: i64) -> i64 {
    if depth == 0 {
        return 1
    }
    region {
        let box = make(depth)
        deepest(depth - 1) + box.tags.len
    }
}

fn main() {
    let boxes = middle()
    for b in boxes {
        print("{b.id} {b.tags}")
    }
    print(deepest(40))
    let outer = region {
        let a = inner(1)
        let b = region { inner(2) }
        let c = region {
            let x = region { inner(3) }
            let y = inner(4)
            x.id + y.id
        }
        "{a.id} {b.id} {c}"
    }
    print(outer)
}
