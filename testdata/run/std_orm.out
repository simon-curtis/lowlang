CREATE TABLE "users" ("id" bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, "name" text NOT NULL, "email" text, "age" integer NOT NULL, "role" text NOT NULL, "address" jsonb, "tags" jsonb NOT NULL, "active" boolean NOT NULL)
SELECT "id", "name", "email", "age", "role", "address", "tags", "active" FROM "users" WHERE ("age" >= $1) AND (("role" = $2) OR ("name" LIKE $3)) ORDER BY "name", "id" DESC LIMIT 10 OFFSET 20
SELECT "id", "name", "email", "age", "role", "address", "tags", "active" FROM "users" WHERE (("email" IS NULL) AND (NOT ("id" IN ($1, $2, $3))))
