SELECT "id", "name", "email", "age", "role", "address", "tags", "active" FROM "users" WHERE ("age" >= $1) AND (("role" = $2) OR ("name" LIKE $3)) | 18, 'Admin', 'A%'
SELECT "id", "name", "email", "age", "role", "address", "tags", "active" FROM "users" WHERE ("id" = $1) LIMIT 1 | 1
INSERT INTO "users" ("name", "email", "age", "role", "address", "tags", "active") VALUES ($1, $2, $3, $4, $5, $6, $7) RETURNING "id" | 'Grace', 'grace@example.com', 85, 'Admin', '{"city":"NYC","zip":"10001"}', '["cobol"]', true
UPDATE "users" SET "name" = $1, "email" = $2, "age" = $3, "role" = $4, "address" = $5, "tags" = $6, "active" = $7 WHERE "id" = $8 | 'Grace', 'grace@example.com', 86, 'Admin', '{"city":"NYC","zip":"10001"}', '["cobol"]', true, 99
DELETE FROM "users" WHERE "id" = $1 | 99
BEGIN
UPDATE users SET active = false WHERE id = $1 | 1
COMMIT
