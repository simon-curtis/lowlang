struct Point {
    x: i64
    y: i64
}

fn total(n: i64) -> i64 {
    var sum = 0
    for i in 0..n {
        let p = new(Point { x: i, y: i * 2 })
        sum += p.x + p.y
    }
    sum
}

fn words() -> str {
    var joined = ""
    for w in ["alpha", "beta", "gamma"] {
        joined = "{joined}{w} "
    }
    joined
}

fn main() {
    let a = region { total(1000) }
    print(a)
    let b = region { words() }
    print(b)
    let c = region { 7 }
    print(c)
    region {
        print("statement")
    }
    let region = 3
    print(region + 1)
    let flag = true
    if flag {
        print("kept")
    }
    var empty = region {
        let none_here: []i64 = []
        none_here
    }
    print(empty.len)
    empty = region { [1, 2, 3] }
    print(empty.len + empty[2])
}
