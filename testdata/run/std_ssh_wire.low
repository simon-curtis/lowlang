import std/ssh/wire
import std/text

fn hex(data: u8[]) -> str {
    text.encode_hex(data)
}

fn unhex(s: str) -> u8[] {
    text.decode_hex(s) or panic("hex {s}")
}

fn mpint_failure(encoded: str) -> str {
    let r = wire.reader(unhex(encoded))
    let value = wire.read_mpint(r) catch {
        e => return "rejected"
    }
    "accepted {hex(value)}"
}

fn names_failure(encoded: str) -> str {
    let r = wire.reader(unhex(encoded))
    let names = wire.read_names(r) catch {
        e => return "rejected"
    }
    "accepted {names.len}"
}

fn string_failure(encoded: str) -> str {
    let r = wire.reader(unhex(encoded))
    let value = wire.read_string(r) catch {
        e => return "rejected"
    }
    "accepted {value.len}"
}

fn text_failure(encoded: str) -> str {
    let r = wire.reader(unhex(encoded))
    let value = wire.read_str(r) catch {
        e => return "rejected"
    }
    "accepted {value.len}"
}

fn finish_failure(encoded: str) -> str {
    let r = wire.reader(unhex(encoded))
    let _ = wire.read_u8(r) or panic("read")
    wire.finish(r) catch {
        e => return "rejected"
    }
    "finished"
}

fn rfc_4251_examples() {
    var out: u8[] = []
    wire.put_str(mut out, "testing")
    print("string testing: {hex(out)}")
    out = []
    wire.put_mpint(mut out, [])
    print("mpint 0: {hex(out)}")
    out = []
    wire.put_mpint(mut out, unhex("09a378f9b2e332a7"))
    print("mpint 9a378f9b2e332a7: {hex(out)}")
    out = []
    wire.put_mpint(mut out, unhex("0080"))
    print("mpint 80: {hex(out)}")
    out = []
    wire.put_mpint(mut out, unhex("0000"))
    print("mpint zeros: {hex(out)}")
    out = []
    wire.put_names(mut out, ["zlib", "none"])
    print("name-list zlib,none: {hex(out)}")
    out = []
    wire.put_names(mut out, [])
    print("name-list empty: {hex(out)}")
    out = []
    wire.put_string(mut out, unhex("0102"))
    wire.put_u32(mut out, 0x01020304)
    wire.put_u64(mut out, 0x0102030405060708)
    wire.put_bool(mut out, true)
    wire.put_bool(mut out, false)
    print("fixed width: {hex(out)}")
}

fn reading() {
    let r = wire.reader(unhex("0000000774657374696e67000000000000000809a378f9b2e332a7000000097a6c69622c6e6f6e65deadbeef0100"))
    print("string: {str(wire.read_string(r) or panic("read"))}")
    print("left after string: {wire.left(r)} offset {wire.offset(r)}")
    print("mpint zero: {(wire.read_mpint(r) or panic("read")).len}")
    print("mpint: {hex(wire.read_mpint(r) or panic("read"))}")
    print("names: {text.join(wire.read_names(r) or panic("read"), "|")}")
    print("rest: {hex(wire.rest(r))}")
    print("bytes: {hex(wire.read_bytes(r, 4) or panic("read"))}")
    print("bool: {wire.read_bool(r) or panic("read")} u8: {wire.read_u8(r) or panic("read")}")
    wire.finish(r) or panic("finish")
    let numbers = wire.reader(unhex("01020304fffffffffffffffe000000ff"))
    print("u32: {wire.read_u32(numbers) or panic("read")}")
    print("u64: {wire.read_u64(numbers) or panic("read")}")
    print("u32 from 0xff: {wire.read_u32(numbers) or panic("read")}")
    let words = wire.reader(unhex("00000005686f737421"))
    print("text: {wire.read_str(words) or panic("read")}")
    wire.finish(words) or panic("finish")
}

fn rejections() {
    print("mpint negative: {mpint_failure("0000000180")}")
    print("mpint superfluous zero: {mpint_failure("000000020070")}")
    print("mpint with sign byte: {mpint_failure("000000020080")}")
    print("mpint truncated: {mpint_failure("0000000401")}")
    print("string truncated: {string_failure("000000050102")}")
    print("string huge length: {string_failure("ffffffff01")}")
    print("string missing length: {string_failure("0000")}")
    print("text not utf-8: {text_failure("00000001ff")}")
    print("names trailing comma: {names_failure("00000004612c622c")}")
    print("names doubled comma: {names_failure("00000004612c2c62")}")
    print("names not ascii: {names_failure("00000002c3a9")}")
    print("names ok: {names_failure("00000003612c62")}")
    print("names empty: {names_failure("00000000")}")
    print("trailing byte: {finish_failure("0102")}")
    print("exact: {finish_failure("01")}")
    let short = wire.reader(unhex("0102"))
    print("read_bytes past end: {wire_read_failure(short, 3)}")
    print("read_bytes negative: {wire_read_failure(short, -1)}")
}

fn wire_read_failure(r: *wire.Reader, n: i64) -> str {
    let data = wire.read_bytes(r, n) catch {
        e => return "rejected"
    }
    "accepted {data.len}"
}

fn lookup() {
    let names = ["curve25519-sha256", "ecdh-sha2-nistp256"]
    print("has: {wire.has_name(names, "ecdh-sha2-nistp256")} {wire.has_name(names, "ecdh")} {wire.has_name([], "x")}")
}

fn main() {
    rfc_4251_examples()
    reading()
    rejections()
    lookup()
}
