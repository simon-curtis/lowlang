import std/markdown

fn show(title: str, source: str) {
    print("--- {title}")
    print(markdown.to_html(source))
}

fn main() {
    show("emphasis", "*a* _b_ **c** __d__ ***e*** *a **b** c*")
    show("intraword", "foo*bar*baz foo_bar_baz snake_case_name")
    show("flanking", "a * b * c ** d ** e _ f _")
    show("nested runs", "*foo**bar**baz* **foo*bar*baz**")
    show("rule of three", "*foo**bar* ***foo** bar* *foo***")
    show("strikethrough", "~~gone~~ ~single~ ~~~triple~~~")
    show("code spans", "`a` `` a`b `` ` a ` `  ` ``` x `` y ```")
    show("links", "[a](/u \"t\") [b](</u v>) [c](/u(x)) [d](/u\\)) [e](/u(x) \"t\") [f]()")
    show("links with parentheses", "[w](https://en.wikipedia.org/wiki/Low_(language)) and [n](a(b(c))d)")
    show("link nesting", "[a [b](/b) c](/a) [*em*](/e) ![img *x*](/i.png \"T\")")
    show("references", "[one][1] [two] [3][] [missing][x]\n\n[1]: /one \"First\"\n[two]: <two.md>\n[3]: /three\n")
    show("autolinks", "<https://example.com/a?b=c> <me@example.com> https://example.com/x). www.example.com, user@example.org.")
    show("inline html", "a <span class=\"x\">b</span> <!-- c --> <br/> <3 < 4")
    show("breaks", "soft\nbreak and hard  \nbreak and hard\\\nbreak")
    show("escapes", "\\*not\\* \\# \\[x\\] a\\b \\\\ \\`")
    show("entities", "&amp; &copy; &#65; &#x41; &bogus; & AT&T")
    show("special characters", "1 < 2 && 3 > 2 \"quoted\" 'single'")
    print("{markdown.plain_text(markdown.parse_inline("**bold** `code` [link](/u) ![alt](/i.png) <b>raw</b> &amp;"))}")
    print("{markdown.to_html("")}|")
}
