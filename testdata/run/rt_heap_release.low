fn filled(n: i64) -> []i64 {
    var xs: []i64 = []
    for i in 0..n {
        push(mut xs, 0)
    }
    xs
}

fn build() -> i64 {
    let a = filled(4000000)
    let b = filled(2000000)
    let first = a[3999999]
    let c = filled(5000000)
    first + b[1999999] + c[4999999]
}

fn main() {
    print(build())
}
