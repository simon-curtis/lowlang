import std/file
import std/file/watch
import std/io
import std/os
import std/text

fn kind_name(k: watch.Kind) -> str {
    match k {
        Created => "created"
        Modified => "modified"
        Deleted => "deleted"
        MovedFrom => "moved-from"
        MovedTo => "moved-to"
        Attrib => "attrib"
        Closed => "closed"
        ClosedUnmodified => "closed-ro"
        Opened => "opened"
        Accessed => "accessed"
        SelfDeleted => "self-deleted"
        SelfMoved => "self-moved"
        Overflow => "overflow"
    }
}

fn describe(e: watch.Event, root: str) -> str {
    let rel = e.path[root.len..]
    let marker = if e.dir { "+d" } else { "" }
    "{kind_name(e.kind)}:{rel}{marker}"
}

fn take(c: chan[watch.Event], n: i64, root: str) -> str {
    var parts: []str = []
    for _ in 0..n {
        let part = select {
            v = <-c => match v {
                some(e) => describe(e, root)
                none => "closed"
            }
            after(3000) => "timeout"
        }
        push(mut parts, part)
    }
    text.join(parts, " ")
}

fn quiet(c: chan[watch.Event]) -> bool {
    select {
        <-c => false
        after(100) => true
    }
}

fn recursive_tree(root: str, outside: str) ! io.Error {
    using w = watch.watch_with([root], watch.Options { recursive: true })?
    let c = watch.events(w)
    file.write_text("{root}/a.txt", "x")?
    print(take(c, 3, root))
    file.rename("{root}/a.txt", "{root}/b.txt")?
    print(take(c, 2, root))
    file.remove("{root}/b.txt")?
    print(take(c, 1, root))

    file.mkdir("{root}/sub")?
    print(take(c, 1, root))
    file.write_text("{root}/sub/x.txt", "x")?
    print(take(c, 3, root))
    file.mkdir("{root}/sub/deep")?
    print(take(c, 1, root))
    file.write_text("{root}/sub/deep/y.txt", "y")?
    print(take(c, 3, root))

    file.rename("{root}/sub", "{root}/moved")?
    print(take(c, 2, root))
    file.write_text("{root}/moved/deep/z.txt", "z")?
    print(take(c, 3, root))

    file.rename("{root}/moved", "{outside}/away")?
    print(take(c, 1, root))
    file.write_text("{outside}/away/q.txt", "q")?
    file.write_text("{root}/sentinel.txt", "s")?
    print(take(c, 3, root))
    print(quiet(c))

    file.chmod("{root}/sentinel.txt", 0o600)?
    print(take(c, 1, root))
    file.mkdir("{root}/gone")?
    file.remove_dir("{root}/gone")?
    print(take(c, 2, root))
    print(quiet(c))
}

fn plain_directory(root: str) ! io.Error {
    using w = watch.watch([root])?
    file.mkdir("{root}/inner")?
    file.write_text("{root}/inner/hidden.txt", "h")?
    file.write_text("{root}/one.txt", "1")?
    file.write_text("{root}/two.txt", "2")?
    var seen: []str = []
    for _ in 0..7 {
        let e = watch.next(w)?
        push(mut seen, describe(e, root))
    }
    print(text.join(seen, " "))
}

fn rename_cookie(root: str) ! io.Error {
    using w = watch.watch([root])?
    file.write_text("{root}/from.txt", "x")?
    file.rename("{root}/from.txt", "{root}/to.txt")?
    var out: []watch.Event = []
    for _ in 0..5 {
        push(mut out, watch.next(w)?)
    }
    let leave = out[3]
    let arrive = out[4]
    print("{describe(leave, root)} {describe(arrive, root)} {leave.cookie != 0} {leave.cookie == arrive.cookie}")
    print("{leave.watched == root} {arrive.name} {out[0].cookie}")
}

fn single_file(root: str) ! io.Error {
    let target = "{root}/single.txt"
    file.write_text(target, "x")?
    using w = watch.watch([target])?
    let c = watch.events(w)
    {
        using f = file.append(target)?
        file.write_str(f, "y")?
    }
    print(take(c, 2, target))
    file.chmod(target, 0o600)?
    print(take(c, 1, target))
    file.remove(target)?
    print(take(c, 2, target))
    print(quiet(c))
}

fn access_events(root: str) ! io.Error {
    let target = "{root}/access.txt"
    file.write_text(target, "x")?
    using w = watch.watch_with([target], watch.Options { access: true })?
    let c = watch.events(w)
    {
        using f = file.open(target)?
        let buf = io.buffer(1)
        file.read(f, buf)?
    }
    print(take(c, 3, target))
}

fn add_remove(root: str, second: str) ! io.Error {
    using w = watch.watch([root])?
    watch.add(w, second)?
    let c = watch.events(w)
    file.write_text("{second}/s.txt", "s")?
    print(take(c, 3, second))
    watch.remove(w, second)?
    file.write_text("{second}/t.txt", "t")?
    file.write_text("{root}/r.txt", "r")?
    print(take(c, 3, root))
    print(quiet(c))
    watch.remove(w, second) catch {
        e => print("remove again {e == io.Error.NotFound}")
    }
}

fn wake_after(h: watch.WatcherHandle) {
    sleep(50)
    watch.stop_on(h)
}

fn next_failed(w: watch.Watcher) -> bool {
    watch.next(w) catch {
        e => return e == io.Error.NotConnected
    }
    false
}

fn stopping(root: str) ! io.Error {
    using w = watch.watch([root])?
    let h = w.handle
    spawn wake_after(h)
    print("parked next ended: {next_failed(w)}")
    print("next after stop: {next_failed(w)}")
    watch.stop(w)
    watch.add(w, root) catch {
        e => print("add after stop: {e == io.Error.NotConnected}")
    }
    let c = watch.events(w)
    print(take(c, 1, root))
}

fn stopped_channel(root: str) ! io.Error {
    using w = watch.watch([root])?
    let c = watch.events(w)
    file.write_text("{root}/k.txt", "k")?
    print(take(c, 3, root))
    watch.stop(w)
    print(take(c, 1, root))
}

fn missing_path() -> bool {
    using w = watch.watch(["/nonexistent-low-watch-path"]) catch {
        e => return e == io.Error.NotFound
    }
    false
}

fn run(root: str, outside: str) ! io.Error {
    recursive_tree(root, outside)?
    plain_directory("{root}")?
    rename_cookie("{root}")?
    single_file(root)?
    access_events(root)?
    let second = "{root}/second"
    file.mkdir(second)?
    add_remove(root, second)?
    stopping(root)?
    stopped_channel(root)?
    print("missing: {missing_path()}")
}

fn main() {
    let root = file.temp_dir("low-std-watch-") catch {
        _ => return print("no temp dir")
    }
    let outside = file.temp_dir("low-std-watch-out-") catch {
        _ => return print("no temp dir")
    }
    run(root, outside) catch {
        e => print("failed")
    }
    file.remove_all(root) catch {
        _ => print("cannot remove {root}")
    }
    file.remove_all(outside) catch {
        _ => print("cannot remove {outside}")
    }
}
