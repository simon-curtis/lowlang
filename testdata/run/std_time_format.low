import std/io
import std/time

fn describe(p: time.Parsed) -> str {
    match p {
        Naive(dt) => "naive {time.format_datetime(dt)}"
        Aware(i) => "aware {time.format_instant(i)} unix {time.timestamp(i)}"
    }
}

fn reason(e: time.Error) -> str {
    match e {
        Invalid(at) => "invalid at {at}"
        OutOfRange(at) => "out of range at {at}"
        Overflow => "overflow"
    }
}

fn try_parse(s: str, layout: str) {
    let p = time.parse(s, layout) catch {
        e => {
            print("'{s}' by '{layout}': {reason(e)}")
            return
        }
    }
    print("'{s}' by '{layout}': {describe(p)}")
}

fn main() {
    let dt = time.DateTime { date: time.Date { year: 2024, month: 3, day: 5 }, hour: 14, minute: 7, second: 9, nanosecond: 123456789 }
    let layouts = [
        "%Y-%m-%d %H:%M:%S", "%a %A %b %B", "%j %e %p %I %y", "%f %N", "%z %Z", "100%% %q %", "%d/%m/%Y",
    ]
    for layout in layouts {
        print("{layout} => {time.format(dt, layout)}")
    }

    let morning = time.DateTime { date: time.Date { year: 2001, month: 12, day: 31 }, hour: 0, minute: 30 }
    let noon = time.DateTime { date: time.Date { year: 1999, month: 1, day: 1 }, hour: 12 }
    print(time.format(morning, "%j|%e|%p %I|%y|%a"))
    print(time.format(noon, "%j|%e|%p %I|%y|%a"))
    let early = time.DateTime { date: time.Date { year: 7, month: 2, day: 3 } }
    print(time.format(early, "%Y %y %e %A"))

    let tokyo = time.at_offset(1700000000, 9 * 3600)
    let india = time.at_offset(1700000000, 5 * 3600 + 1800)
    let west = time.at_offset(1700000000, -(8 * 3600))
    let utc = time.at_offset(1700000000, 0)
    for i in [tokyo, india, west, utc] {
        print(time.format_at(i, "%Y-%m-%dT%H:%M:%S %z %Z"))
        print(time.format_rfc2822(i))
        print(time.format_instant(i))
    }

    let good = time.parse_rfc3339("2023-11-14T22:13:20+09:00") catch {
        _ => return
    }
    print("rfc3339 {time.format_instant(good)}")
    let bad = ["2023-11-14T22:13:20", "2023-11-14", "nope"]
    for s in bad {
        let i = time.parse_rfc3339(s) catch {
            _ => {
                print("rfc3339 '{s}' rejected")
                continue
            }
        }
        print("rfc3339 '{s}' {time.timestamp(i)}")
    }

    try_parse("2024-03-05 14:07:09", "%Y-%m-%d %H:%M:%S")
    try_parse("5/3/2024", "%d/%m/%Y")
    try_parse("Tue Mar 5 2024 02:07 PM", "%a %b %e %Y %I:%M %p")
    try_parse("Tuesday, March 05, 2024", "%A, %B %d, %Y")
    try_parse("tue, mar 05 2024", "%a, %b %d %Y")
    try_parse("2024-03-05 12:00 AM", "%Y-%m-%d %I:%M %p")
    try_parse("2024-03-05 12:00 pm", "%Y-%m-%d %I:%M %p")
    try_parse("2024-03-05 11:59 PM", "%Y-%m-%d %I:%M %p")
    try_parse("24 065", "%y %j")
    try_parse("99 365", "%y %j")
    try_parse("2023 366", "%Y %j")
    try_parse("2024 366", "%Y %j")
    try_parse("12:30:45.5", "%H:%M:%S.%f")
    try_parse("12:30:45.123456789", "%H:%M:%S.%N")
    try_parse("12:30:45.0000001", "%H:%M:%S.%f")
    try_parse("2024-03-05T14:07:09+0530", "%Y-%m-%dT%H:%M:%S%z")
    try_parse("2024-03-05T14:07:09-08:00", "%Y-%m-%dT%H:%M:%S%z")
    try_parse("2024-03-05T14:07:09Z", "%Y-%m-%dT%H:%M:%S%z")
    try_parse("2024-03-05 14:07 UTC", "%Y-%m-%d %H:%M %Z")
    try_parse("100% 2024", "100%% %Y")
    try_parse("2024-02-30", "%Y-%m-%d")
    try_parse("2023-02-29", "%Y-%m-%d")
    try_parse("2024-13-01", "%Y-%m-%d")
    try_parse("2024-03-05 24:00", "%Y-%m-%d %H:%M")
    try_parse("2024-03-05 10:61", "%Y-%m-%d %H:%M")
    try_parse("2024-03-05 13:00 PM", "%Y-%m-%d %I:%M %p")
    try_parse("2024-03-05x", "%Y-%m-%d")
    try_parse("2024-03", "%Y-%m-%d")
    try_parse("24-03-05", "%Y-%m-%d")
    try_parse("Foo 2024", "%b %Y")
    try_parse("2024 +0100", "%Y %z")
    try_parse("2024 +2500", "%Y %z")
    try_parse("2024", "%Q")
    try_parse("", "%Y")

    let round = time.DateTime { date: time.Date { year: 2031, month: 8, day: 17 }, hour: 23, minute: 59, second: 58, nanosecond: 5000000 }
    let layout = "%A %d %B %Y %I:%M:%S.%N %p"
    let text = time.format(round, layout)
    print(text)
    try_parse(text, layout)
}
