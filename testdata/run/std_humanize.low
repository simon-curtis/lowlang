fn french() -> humanize.Words {
    humanize.Words {
        just_now: "à l'instant",
        under_second: "moins d'une seconde",
        past: "il y a %s",
        future: "dans %s",
        about: "environ %s",
        quantity: "%d %s",
        singular: ["seconde", "minute", "heure", "jour", "mois", "an"],
        plural: ["secondes", "minutes", "heures", "jours", "mois", "ans"],
        short: ["s", "min", "h", "j", "mo", "a"]
    }
}

fn terse() -> humanize.Words {
    humanize.Words {
        just_now: "now",
        under_second: "<1s",
        past: "-%s",
        future: "+%s",
        about: "~%s",
        quantity: "%s%d",
        singular: ["s", "m", "h", "d", "M", "Y"],
        plural: ["s", "m", "h", "d", "M", "Y"],
        short: ["s", "m", "h", "d", "M", "Y"]
    }
}

fn broken() -> humanize.Words {
    humanize.Words {
        just_now: "now",
        under_second: "soon",
        past: "%s ago",
        future: "in %s",
        about: "about %s",
        quantity: "%d %s",
        singular: ["s"],
        plural: ["s"],
        short: ["s"]
    }
}

fn row_cases() {
    for row in hand_rows() {
        show_row(row)
    }
    for row in random_rows() {
        show_row(row)
    }
}

fn round_cases() {
    for row in hand_rows() {
        for units in [1, 2, 3, 4] {
            show_round(row, units)
        }
    }
    for row in random_rows() {
        for units in [1, 2, 3, 5, 9, 10, 1000000000000] {
            show_round(row, units)
        }
    }
    show_round([3661, 0], 0)
    show_round([3661, 0], -1)
}

fn words_cases() {
    show_with([0, 0], french())
    show_with([0, 700000000], french())
    show_with([4, 0], french())
    show_with([5, 0], french())
    show_with([59, 0], french())
    show_with([60, 0], french())
    show_with([3600, 0], french())
    show_with([5400, 0], french())
    show_with([7500, 0], french())
    show_with([86400, 0], french())
    show_with([259200, 0], french())
    show_with([2592000, 0], french())
    show_with([5184000, 0], french())
    show_with([31536000, 0], french())
    show_with([94608000, 0], french())
    show_with([-4, 0], french())
    show_with([-5, 0], french())
    show_with([-90, 0], french())
    show_with([-7200, 0], french())
    show_with([-5400, 0], french())
    show_with([-86400, 0], french())
    show_with([-3153600000, 0], french())
    show_with([0, 0], terse())
    show_with([0, 700000000], terse())
    show_with([4, 0], terse())
    show_with([5, 0], terse())
    show_with([59, 0], terse())
    show_with([60, 0], terse())
    show_with([3600, 0], terse())
    show_with([5400, 0], terse())
    show_with([7500, 0], terse())
    show_with([86400, 0], terse())
    show_with([259200, 0], terse())
    show_with([2592000, 0], terse())
    show_with([5184000, 0], terse())
    show_with([31536000, 0], terse())
    show_with([94608000, 0], terse())
    show_with([-4, 0], terse())
    show_with([-5, 0], terse())
    show_with([-90, 0], terse())
    show_with([-7200, 0], terse())
    show_with([-5400, 0], terse())
    show_with([-86400, 0], terse())
    show_with([-3153600000, 0], terse())
    show_with([0, 0], broken())
    show_with([0, 700000000], broken())
    show_with([4, 0], broken())
    show_with([5, 0], broken())
    show_with([59, 0], broken())
    show_with([60, 0], broken())
}

fn relative_cases() {
    show_relative(1000, 1000)
    show_relative(1000, 1003)
    show_relative(1000, 1004)
    show_relative(1000, 1005)
    show_relative(1005, 1000)
    show_relative(1004, 1000)
    show_relative(1003, 1000)
    show_relative(0, 60)
    show_relative(60, 0)
    show_relative(0, 7200)
    show_relative(7200, 0)
    show_relative(0, 86400)
    show_relative(86400, 0)
    show_relative(0, 2592000)
    show_relative(2592000, 0)
    show_relative(0, 31536000)
    show_relative(31536000, 0)
    show_relative(-62135596800, 253402300799)
    show_relative(253402300799, -62135596800)
    show_relative(1762855000, 1762865859)
    show_relative(1762865859, 1762855000)
    show_relative(1762855000, 1766743000)
    show_relative_with(1000, 1000, french())
    show_relative_with(1000, 1003, french())
    show_relative_with(1000, 1004, french())
    show_relative_with(1000, 1005, french())
    show_relative_with(1005, 1000, french())
    show_relative_with(1004, 1000, french())
    show_relative_with(1003, 1000, french())
    show_relative_with(0, 60, french())
    show_relative_with(60, 0, french())
    show_relative_with(0, 7200, french())
    show_relative_with(7200, 0, french())
    show_relative_with(0, 86400, french())
    show_relative_with(0, 60, broken())
}

fn section(name: str) {
    print("== {name}")
}

fn main() {
    section("rows")
    row_cases()
    section("round_to")
    round_cases()
    section("words")
    words_cases()
    section("relative")
    relative_cases()
}
