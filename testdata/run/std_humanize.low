import std/time/duration
import std/time/fault
import std/time/humanize
import std/time/timestamp

fn describe(e: fault.Fault) -> str {
    match e {
        Overflow => "overflow"
        Invalid(what) => "invalid {what}"
        _ => fault.to_string(e)
    }
}

fn pair(row: []i64) -> duration.Duration {
    duration.from_parts(row[0], row[1])
}

fn show_row(row: []i64) {
    let d = pair(row)
    let ago = humanize.ago(d)
    let words = humanize.in_words(d)
    let compact = humanize.compact(d)
    print("D {row[0]} {row[1]} | {ago} | {words} | {compact}")
}

fn show_round(row: []i64, units: i64) {
    let d = pair(row)
    let r = humanize.round_to(d, units) catch {
        e => return print("R {row[0]} {row[1]} {units} !{describe(e)}")
    }
    print("R {row[0]} {row[1]} {units} = {duration.whole_seconds(r)} {duration.subsec_nanos(r)}")
}

fn show_with(row: []i64, w: humanize.Words) {
    let d = pair(row)
    let ago = humanize.ago_with(d, w) catch { e => return print("W {row[0]} {row[1]} !{describe(e)}") }
    let words = humanize.in_words_with(d, w) catch { e => return print("W {row[0]} {row[1]} !{describe(e)}") }
    let compact = humanize.compact_with(d, w) catch { e => return print("W {row[0]} {row[1]} !{describe(e)}") }
    print("W {row[0]} {row[1]} | {ago} | {words} | {compact}")
}

fn show_relative(ts: i64, now: i64) {
    let a = timestamp.from_unix(ts) or return print("bad ts")
    let b = timestamp.from_unix(now) or return print("bad now")
    print("T {ts} {now} | {humanize.relative(a, b)}")
}

fn show_relative_with(ts: i64, now: i64, w: humanize.Words) {
    let a = timestamp.from_unix(ts) or return print("bad ts")
    let b = timestamp.from_unix(now) or return print("bad now")
    let phrase = humanize.relative_with(a, b, w) catch { e => return print("TW {ts} {now} !{describe(e)}") }
    print("TW {ts} {now} | {phrase}")
}

