enum Problem {
    Negative
}

struct Op {
    name: str
    apply: fn(i64) -> i64
}

fn double(x: i64) -> i64 {
    x * 2
}

fn compose(f: fn(i64) -> i64, g: fn(i64) -> i64) -> fn(i64) -> i64 {
    fn(x) { g(f(x)) }
}

fn counter() -> fn() -> i64 {
    var n = 0
    fn() -> i64 {
        n += 1
        n
    }
}

fn apply_all(ops: []Op, x: i64) -> i64 {
    var v = x
    for op in ops {
        v = op.apply(v)
    }
    v
}

fn checked(x: i64) -> i64 ! Problem {
    if x < 0 {
        fail Negative
    }
    x
}

fn bump(mut x: i64) {
    x += 10
}

fn churn(n: i64) -> i64 {
    var sum = 0
    for i in 0..n {
        let boxed = new(i)
        let get = fn() -> i64 { *boxed }
        sum += get()
    }
    sum
}

fn main() {
    let next = counter()
    next()
    next()
    print(next())
    let other = counter()
    print(other())

    let quad = compose(double, double)
    print(quad(5))
    let inc = fn(x: i64) -> i64 { x + 1 }
    print(compose(inc, double)(4))

    var total = 0
    let add = fn(x: i64) { total += x }
    for i in 1..5 {
        add(i)
    }
    print(total)

    let ops = [Op { name: "double", apply: double }, Op { name: "inc", apply: inc }, Op { name: "square", apply: fn(x) { x * x } }]
    print(apply_all(ops, 3))
    print(ops[2].name)

    let table: [str: fn(i64) -> i64] = ["double": double, "inc": inc]
    let f = table["inc"] ?? double
    print(f(41))

    let check: fn(i64) -> i64 ! Problem = checked
    print(check(-1) or 0)
    print(check(7) or 0)

    let bumper: fn(mut i64) = bump
    var b = 1
    bumper(mut b)
    print(b)

    var fib: fn(i64) -> i64 = fn(n) { n }
    fib = fn(n) {
        if n < 2 {
            return n
        }
        fib(n - 1) + fib(n - 2)
    }
    print(fib(20))

    let outer = 100
    let nested = fn(x: i64) -> fn(i64) -> i64 {
        fn(y) { outer + x + y }
    }
    print(nested(10)(1))

    var later: []fn() -> i64 = []
    for i in 0..3 {
        push(mut later, fn() -> i64 { i * 10 })
    }
    for g in later {
        print(g())
    }

    print(churn(200000))
    print(next())
}
