import std/simd

fn inner[V: Vector](v: V) -> u64 {
    simd.mask(v)
}

fn middle[V: Vector](v: V) -> u64 {
    inner(v)
}

fn outer[V: Vector](v: V) -> u64 {
    middle(v)
}

fn selected[V: Vector](choose: V, a: V, b: V) -> u64 {
    outer(simd.blend(choose, a, b))
}

fn any_set[V: Vector](v: V) -> bool {
    simd.any(v)
}

fn forwarded_any[V: Vector](v: V) -> bool {
    any_set(v)
}

fn main() {
    let bytes: u8x16 = simd.splat(u8(255))
    print("{outer(bytes)}")
    let words: u32x8 = simd.splat(u32(0x80000000))
    print("{outer(words)}")
    let clear: u16x8 = simd.splat(u16(1))
    print("{outer(clear)}")
    let choose: u8x16 = simd.splat(u8(255))
    let a: u8x16 = simd.splat(u8(128))
    let b: u8x16 = simd.splat(u8(0))
    print("{selected(choose, a, b)}")
    print("{selected(b, a, b)}")
    print("{forwarded_any(bytes)}")
    print("{forwarded_any(clear)}")
}
