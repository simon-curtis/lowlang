import std/net/punycode
import std/text

fn code_points(field: str) -> str {
    var out: []u8 = []
    for token in text.fields(field) {
        text.append_char(mut out, u32(text.parse_uint(token, 16) or 0))
    }
    str(out)
}

fn describe(e: punycode.Error) -> str {
    match e {
        Overflow => "overflow"
        InvalidUtf8 => "invalid utf-8"
        BadDigit(at) => "bad digit at {at}"
        Truncated => "truncated"
        InvalidCodePoint => "invalid code point"
    }
}

fn encoded(s: str) -> str {
    punycode.encode(s) catch {
        e => describe(e)
    }
}

fn decoded(s: str) -> str {
    punycode.decode(s) catch {
        e => describe(e)
    }
}

fn hex(s: str) -> str {
    var parts: []str = []
    for c in s {
        push(mut parts, text.upper(text.pad_left(text.hex(i64(c)), 4, '0')))
    }
    text.join(parts, " ")
}

fn main() {
    var total = 0
    var failed = 0
    for line in text.lines(embed("std_punycode.txt")) {
        if line == "" || line[0] == '#' {
            continue
        }
        let cut = text.cut(line, " ; ")
        let source = code_points(cut.before)
        let expected = cut.after
        total += 1
        if text.lower(encoded(source)) != text.lower(expected) || decoded(expected) != source {
            failed += 1
            print("failed: {line}")
        }
    }
    print("cases {total} failed {failed}")

    print("empty: [{encoded("")}] [{decoded("")}]")
    print("ascii: {encoded("abc")} {decoded("abc-")}")
    print("ascii mixed case kept: {encoded("AbC-d")}")
    print("encode keeps case: {encoded("München")} {encoded("MÜNCHEN")}")
    print("decode uppercase digits: {decoded("Mnchen-3ya")} {decoded("MNCHEN-3YA")}")
    print("decode only digits: {decoded("tda")} {hex(decoded("tda"))}")
    print("delimiter only: {decoded("-")}")
    print("leading delimiter: {decoded("--bcd")}")

    print("non-ascii input to decode: {decoded("é")} {decoded("ab-é")}")
    print("bad digit: {decoded("ab-_")} {decoded("ab- ")}")
    print("truncated: {decoded("a-9")} {decoded("9")}")
    print("overflow in digits: {decoded("99999999999")}")
    print("lone surrogate: {decoded("ib9b")}")
    print("above U+10FFFF: {decoded("en32g")} {decoded("a-j023p")}")
    print("invalid utf-8: {encoded(str([u8(0xFF)]))}")
    var long: []u8 = []
    for i in 0..4000 {
        push(mut long, 'a')
    }
    text.append_char(mut long, 0x10FFFF)
    print("encode overflow: {encoded(str(long))}")
    long = []
    for i in 0..3000 {
        push(mut long, 'a')
    }
    text.append_char(mut long, 0x10FFFF)
    let wide = encoded(str(long))
    print("no overflow: {wide.len} {decoded(wide) == str(long)}")
}
