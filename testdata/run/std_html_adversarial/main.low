import std/html
import std/text

struct Shape {
    name: str
    input: str
}

struct Stats {
    elements: i64
    texts: i64
    others: i64
    depth: i64
}

fn units(unit: str, n: i64) -> str {
    text.repeat(unit, n)
}

fn distinct(prefix: str, n: i64, suffix: str) -> str {
    var parts: str[] = []
    for i in 0..n {
        parts.push("{prefix}{i}{suffix}")
    }
    text.join(parts, "")
}

fn shapes() -> Shape[] {
    [
        Shape { name: "a nested div", input: units("<div>", 10000) }
        Shape { name: "b nested b, stray end p", input: "{units("<b>", 7000)}{units("</p>", 7000)}" }
        Shape { name: "b nested b, p reconstruction", input: "{units("<b>", 4000)}{units("<p>x", 4000)}" }
        Shape { name: "b distinct b, closed p", input: "{distinct("<b x=", 3000, ">")}{units("<p>x</p>", 3000)}" }
        Shape { name: "b nested b, div, end b", input: "<b>{units("<div>", 7000)}{units("</b>", 7000)}" }
        Shape { name: "c nested a", input: units("<a>", 10000) }
        Shape { name: "c nested a, div", input: units("<a><div>", 3500) }
        Shape { name: "d nested table", input: units("<table><tr><td>", 3000) }
        Shape { name: "e unclosed svg", input: units("<svg>", 10000) }
        Shape { name: "e svg, stray end tags", input: "{units("<svg>", 4000)}{units("</x>", 4000)}" }
        Shape { name: "e unclosed math", input: units("<math>", 10000) }
        Shape { name: "e nested template", input: units("<template>", 10000) }
        Shape { name: "f nested li", input: units("<li>", 10000) }
        Shape { name: "f nested dd", input: units("<dd>", 10000) }
        Shape { name: "f nested option", input: "<select>{units("<option>", 10000)}" }
        Shape { name: "f nested button", input: units("<button>", 10000) }
        Shape { name: "g repeated attribute", input: "<div{units(" a=1", 10000)}>" }
        Shape { name: "g distinct attributes", input: "<div{distinct(" a", 3000, "=1")}>" }
        Shape { name: "g html attributes", input: distinct("<html a", 3000, "=1>") }
        Shape { name: "h null characters", input: units("a{text.from_char(0)}", 15000) }
        Shape { name: "h character references", input: units("&amp;", 15000) }
        Shape { name: "h text and comments", input: units("a<!---->", 7000) }
        Shape { name: "i stray end body", input: "{units("<div>", 3500)}{units("</body>", 3500)}" }
        Shape { name: "i stray end span", input: "{units("<span>", 3500)}{units("</z>", 3500)}" }
        Shape { name: "i tables in divs", input: "{units("<div>", 3000)}{units("<table></table>", 3000)}" }
    ]
}

fn measure(root: *html.Node) -> Stats {
    var stats = Stats { elements: 0, texts: 0, others: 0, depth: 0 }
    var pending: *html.Node[] = []
    var levels: i64[] = []
    for c in html.children(root) {
        pending.push(c)
        levels.push(1)
    }
    for pending.len > 0 {
        let n = pending[pending.len - 1]
        let level = levels[levels.len - 1]
        pending.pop()
        levels.pop()
        if level > stats.depth {
            stats.depth = level
        }
        match n.data {
            Element => { stats.elements += 1 }
            Text => { stats.texts += 1 }
            _ => { stats.others += 1 }
        }
        for c in html.children(n) {
            pending.push(c)
            levels.push(level + 1)
        }
        let contents = html.template_contents(n) ?? continue
        for c in html.children(contents) {
            pending.push(c)
            levels.push(level + 1)
        }
    }
    stats
}

fn show(stats: Stats) -> str {
    "elements={stats.elements} texts={stats.texts} others={stats.others} depth={stats.depth}"
}

fn main() {
    let policy = html.default_policy()
    for shape in shapes() {
        let parsed = html.parse_body(shape.input)
        let tree = measure(parsed.root)
        let unlimited = html.parse_with(shape.input, html.ParseOptions { max_depth: 0 })
        let full = measure(unlimited.root)
        let removed = html.clean(parsed.root, policy)
        let cleaned = measure(parsed.root)
        let sanitized = html.sanitize(shape.input, policy)
        let result = measure(html.parse_body(sanitized).root)
        print("{shape.name}")
        print("  parse_body: {show(tree)}")
        print("  unlimited:  {show(full)}")
        print("  clean: removed={removed} {show(cleaned)}")
        print("  sanitize: bytes={sanitized.len} {show(result)}")
    }
}
