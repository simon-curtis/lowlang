import std/regex
import std/text

fn unicode_cases() {
    case_all("k", "i", regex.generated("(?i)k"), "kK\u212A x")
    case_all("\\u212A", "i", regex.generated("(?i)\\u212A"), "kK\u212A x")
    case_all("s", "i", regex.generated("(?i)s"), "sS\u017F x")
    case_all("\u017F", "i", regex.generated("(?i)\u017F"), "sS\u017F x")
    case_all("\u03C2", "i", regex.generated("(?i)\u03C2"), "\u03C3\u03C2\u03A3 x")
    case_all("\u00DF", "i", regex.generated("(?i)\u00DF"), "\u00DF\u1E9E ss")
    case_all("\u13A0", "i", regex.generated("(?i)\u13A0"), "\u13A0\uAB70")
    case_all("\u01C5", "i", regex.generated("(?i)\u01C5"), "\u01C4\u01C5\u01C6")
    case_all("\u0101+", "i", regex.generated("(?i)\u0101+"), "\u0100\u0101\u0100 a")
    case_all("k", "", regex.generated("k"), "kK\u212A x")
    case_all("[a-z]+", "i", regex.generated("(?i)[a-z]+"), "A\u212A\u017Fz1")
    case_all("[a-z0-9]+", "i", regex.generated("(?i)[a-z0-9]+"), "A\u212A\u017Fz1_")
    case_all("[^k]", "i", regex.generated("(?i)[^k]"), "kK\u212Axy")
    case_all("[^a-z]", "i", regex.generated("(?i)[^a-z]"), "aZ\u212A\u017F1")
    case_all("[\u03B1-\u03C9]+", "i", regex.generated("(?i)[\u03B1-\u03C9]+"), "\u03A3\u03C2\u0391 a")
    case_all("\\w+", "", regex.generated("\\w+"), "caf\u00E9 na\u00EFve \u65E5\u672C\u8A9E e\u0301 a\u200Db \U0001D49C a\u203Fb \u0663")
    case_all("\\W+", "", regex.generated("\\W+"), "caf\u00E9, \u3002\U0001F600 \u00B2!")
    case_all("[\\w-]+", "", regex.generated("[\\w-]+"), "caf\u00E9-na\u00EFve \u3002")
    case_all("[^\\W\\d]+", "", regex.generated("[^\\W\\d]+"), "\u00E9a1\u0663x")
    case_all("\\w+", "i", regex.generated("(?i)\\w+"), "\u212A\u00E9!")
    case_all("\\b\\w+\\b", "", regex.generated("\\b\\w+\\b"), "caf\u00E9 na\u00EFve \u65E5\u672C\u8A9E")
    case_all("\\b", "", regex.generated("\\b"), "\u00E9 a\u0301-\u65E5")
    case_all("\\B", "", regex.generated("\\B"), "\u00E9 \u00E9a")
    case_all("\\b\u00E9", "", regex.generated("\\b\u00E9"), "a\u00E9 \u00E9")
    case_all("\\d+", "", regex.generated("\\d+"), "12\u066334")
    case_all("^", "m", regex.generated("(?m)^"), "a\nb\rc\r\nd\n\re")
    case_all("$", "m", regex.generated("(?m)$"), "a\nb\rc\r\nd\n\re")
    case_all("^\\w+$", "m", regex.generated("(?m)^\\w+$"), "one\ntwo\rthree\r\nfour")
    case_all("^$", "m", regex.generated("(?m)^$"), "a\r\rb\n\nc\r\n\r\nd")
    case_all("^.*$", "m", regex.generated("(?m)^.*$"), "a\rb\nc")
    case_all("^[^\\r\\n]*$", "m", regex.generated("(?m)^[^\\r\\n]*$"), "a\rb\nc\r\nd")
    case_all("^", "", regex.generated("^"), "a\rb\nc")
    case_all("$", "", regex.generated("$"), "a\rb\r")
    case_all("$", "", regex.generated("$"), "a\r\n")
    case_find("(?s).", "", regex.generated("(?s)."), "\r")
    case_full("k{{2001}}", "i", regex.generated("(?i)k{{2001}}"), "{text.repeat("K", 2000)}\u212A")
    case_full("\\w{{2001}}", "", regex.generated("\\w{{2001}}"), "{text.repeat("\u00E9", 2000)}a")
    case_split("\\W+", "", regex.generated("\\W+"), "caf\u00E9, na\u00EFve; \u65E5\u672C", -1)
    case_sub("k", "i", regex.generated("(?i)k"), "kK\u212A!", ".")
    case_split("^", "m", regex.generated("(?m)^"), "a\rb\r\nc\nd", -1)
}
