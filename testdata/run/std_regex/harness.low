import std/regex
import std/text

fn esc(s: str) -> str {
    if s.len > 64 {
        return "{esc(s[..32])}...({s.len} bytes)"
    }
    s |> text.replace("\n", "\\n") |> text.replace("\r", "\\r") |> text.replace("\t", "\\t")
}

fn flags(spec: str) -> regex.Flags {
    regex.Flags { ignore_case: text.contains(spec, "i"), multiline: text.contains(spec, "m"), dot_all: text.contains(spec, "s") }
}

fn compiled(pattern: str, spec: str) -> regex.Regex? {
    let re = regex.compile_with(pattern, flags(spec)) catch {
        Invalid(at, message) => {
            print("  error at {at}: {message}")
            return none
        }
    }
    re
}

fn show(m: regex.Match, groups: i64) -> str {
    var out = "{m.start()}..{m.end()} [{esc(m.text())}]"
    for g in 1..groups + 1 {
        let part = match m.span(g) {
            some(s) => "{g}={s.start}..{s.end}"
            none => "{g}=-"
        }
        out = "{out} {part}"
    }
    out
}

fn show_found(found: regex.Match?, groups: i64) -> str {
    match found {
        some(m) => show(m, groups)
        none => "none"
    }
}

fn settle(runtime: []str, generated: []str) {
    for line in runtime {
        print(line)
    }
    if text.join(runtime, "\n") != text.join(generated, "\n") {
        print("  generated program differs:")
        for line in generated {
            print("  {line}")
        }
    }
}

fn find_lines(re: regex.Regex, input: str) -> []str {
    ["  {show_found(re.find(input), re.group_count())}"]
}

fn full_lines(re: regex.Regex, input: str) -> []str {
    ["  {show_found(re.full_match(input), re.group_count())}"]
}

fn test_lines(re: regex.Regex, input: str) -> []str {
    ["  {re.is_match(input)}"]
}

fn all_lines(re: regex.Regex, input: str) -> []str {
    var out: []str = []
    for m in re.find_all(input) {
        push(mut out, "  {show(m, re.group_count())}")
    }
    out
}

fn sub_lines(re: regex.Regex, input: str, with: str) -> []str {
    let out = re.replace_all(input, fn(m: regex.Match) -> str { with })
    ["  [{esc(out)}]"]
}

fn wrap_lines(re: regex.Regex, input: str) -> []str {
    let out = re.replace_all(input, fn(m: regex.Match) -> str { "<{m.text()}:{m.start()}>" })
    ["  [{esc(out)}]"]
}

fn split_lines(re: regex.Regex, input: str, max: i64) -> []str {
    let parts = if max < 0 { re.split(input) } else { re.split_n(input, max) }
    var out: []str = []
    for p in parts {
        push(mut out, "  [{esc(p)}]")
    }
    out
}

fn case_find(pattern: str, spec: str, generated: regex.Regex, input: str) {
    print("find /{esc(pattern)}/{spec} [{esc(input)}]")
    let re = compiled(pattern, spec) ?? return
    let runtime = find_lines(re, input)
    let program = find_lines(generated, input)
    settle(runtime, program)
}

fn case_full(pattern: str, spec: str, generated: regex.Regex, input: str) {
    print("full /{esc(pattern)}/{spec} [{esc(input)}]")
    let re = compiled(pattern, spec) ?? return
    let runtime = full_lines(re, input)
    let program = full_lines(generated, input)
    settle(runtime, program)
}

fn case_test(pattern: str, spec: str, generated: regex.Regex, input: str) {
    print("test /{esc(pattern)}/{spec} [{esc(input)}]")
    let re = compiled(pattern, spec) ?? return
    let runtime = test_lines(re, input)
    let program = test_lines(generated, input)
    settle(runtime, program)
}

fn case_all(pattern: str, spec: str, generated: regex.Regex, input: str) {
    print("all /{esc(pattern)}/{spec} [{esc(input)}]")
    let re = compiled(pattern, spec) ?? return
    let runtime = all_lines(re, input)
    let program = all_lines(generated, input)
    settle(runtime, program)
}

fn case_sub(pattern: str, spec: str, generated: regex.Regex, input: str, with: str) {
    print("sub /{esc(pattern)}/{spec} [{esc(input)}] [{esc(with)}]")
    let re = compiled(pattern, spec) ?? return
    let runtime = sub_lines(re, input, with)
    let program = sub_lines(generated, input, with)
    settle(runtime, program)
}

fn case_wrap(pattern: str, spec: str, generated: regex.Regex, input: str) {
    print("wrap /{esc(pattern)}/{spec} [{esc(input)}]")
    let re = compiled(pattern, spec) ?? return
    let runtime = wrap_lines(re, input)
    let program = wrap_lines(generated, input)
    settle(runtime, program)
}

fn case_split(pattern: str, spec: str, generated: regex.Regex, input: str, max: i64) {
    print("split /{esc(pattern)}/{spec} [{esc(input)}] {max}")
    let re = compiled(pattern, spec) ?? return
    let runtime = split_lines(re, input, max)
    let program = split_lines(generated, input, max)
    settle(runtime, program)
}
