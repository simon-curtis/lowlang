import std/archive
import std/archive/tar
import std/file
import std/hash
import std/io
import std/slices
import std/text

fn nibble(c: u8) -> i64 {
    if c >= '0' && c <= '9' {
        i64(c - '0')
    } else {
        i64(c - 'a') + 10
    }
}

fn number(s: str, at: i64) -> i64 {
    var n = 0
    var i = at
    for s[i] >= '0' && s[i] <= '9' {
        n = n * 10 + i64(s[i] - '0')
        i += 1
    }
    n
}

fn unpack(s: str) -> []u8 {
    var out: []u8 = []
    var i = 0
    for i < s.len {
        if s[i] == '[' {
            for _ in 0..number(s, i + 1) {
                push(mut out, 0)
            }
            i = text.index_byte(s[i..], ']') + i + 1
        } else if s[i] == '(' {
            let value = u8(nibble(s[i + 1]) << 4 | nibble(s[i + 2]))
            for _ in 0..number(s, i + 4) {
                push(mut out, value)
            }
            i = text.index_byte(s[i..], ')') + i + 1
        } else {
            push(mut out, u8(nibble(s[i]) << 4 | nibble(s[i + 1])))
            i += 2
        }
    }
    out
}

fn ustar_ref() -> []u8 {
    unpack("642f[98]303030303735350030303031373530003030303031343400(30*11)00313336303332353636343500303036323637002035[100]7573746172003030[247]642f68617264[94]303030303634340030303031373530003030303031343400(30*10)3600313336303332353636343500303037313234002030[100]7573746172003030[247]68656c6c6f0a[506]642f68656c6c6f2e747874[89]303030303634340030303031373530003030303031343400(30*11)00313336303332353636343500303131323034002031642f68617264[94]7573746172003030[247]642f6c6e[96]303030303737370030303031373530003030303031343400(30*11)0031333630333235363634350030313034363400203268656c6c6f2e747874[91]7573746172003030[247]")
}

fn gnu_ref() -> []u8 {
    unpack("672f[98]303030303735350030303031373530003030303031343400(30*11)00313336303332353636343500303036323332002035[100]75737461722020[248]2e2f2e2f404c6f6e674c696e6b[87]303030303634340030303030303030003030303030303000(30*8)31373300(30*11)0030303737373400204c[100]75737461722020[248]672f(6e*120)[390]672f(6e*98)303030303634340030303031373530003030303031343400(30*10)3500313336303332353636343500303333323633002030[100]75737461722020[248]6c6f6e670a[507]2e2f2e2f404c6f6e674c696e6b[87]303030303634340030303030303030003030303030303000(30*8)32303300(30*11)0030303737363500204b[100]75737461722020[248](6d*130)[382]672f736c[96]303030303737370030303031373530003030303031343400(30*11)00313336303332353636343500303334303136002032(6d*100)75737461722020[248]")
}

fn pax_ref() -> []u8 {
    unpack("702f[98]303030303735350030303031373530003030303031343400(30*11)00313336303332353636343500303036333033002035[100]7573746172003030[247]702f506178486561646572732f66726163[83]303030303634340030303030303030003030303030303000(30*9)333600313336303332353636343500303131323436002078[100]7573746172003030[247]3330206d74696d653d313537373933343234352e3637383930313233340a[482]702f66726163[94]303030303634340030303031373530003030303031343400(30*10)3500313336303332353636343500303037313334002030[100]7573746172003030[247]667261630a[507]702f506178486561646572732f68c3a96c6c6f[81]303030303634340030303030303030003030303030303000(30*9)323100313336303332353636343500303132303337002078[100]7573746172003030[247]313720706174683d702f68c3a96c6c6f0a[495]702f68c3a96c6c6f[92]303030303634340030303031373530003030303031343400(30*10)3400313336303332353636343500303037373332002030[100]7573746172003030[247]7574660a[508]702f506178486561646572732f(70*87)303030303634340030303030303030003030303030303000(30*8)31373200313336303332353636343500303333343333002078[100]7573746172003030[247]31323220706174683d702f(70*110)0a[390]702f(70*98)303030303634340030303031373530003030303031343400(30*10)3400313336303332353636343500303333363337002030[100]7573746172003030[247]7061780a[508]")
}

fn ustar_gzip() -> []u8 {
    unpack("")
}

fn error_name(e: io.Error) -> str {
    match e {
        Malformed => "Malformed"
        TooLarge => "TooLarge"
        Eof => "Eof"
        Denied => "Denied"
        Unsupported => "Unsupported"
        Invalid => "Invalid"
        NotFound => "NotFound"
        NotDir => "NotDir"
        IsDir => "IsDir"
        Exists => "Exists"
        _ => "other"
    }
}

fn kind_name(k: tar.Kind) -> str {
    match k {
        File => "file"
        Dir => "dir"
        Symlink => "symlink"
        Hardlink => "hardlink"
        Other => "other"
    }
}

fn body_text(body: []u8) -> str {
    if body.len <= 24 {
        return "{body.len}:{text.trim(str(body))}"
    }
    "{body.len} bytes"
}

fn walk(label: str, r: *tar.Reader) {
    for {
        let next = tar.next(r) catch {
            e => {
                print("{label}: next {error_name(e)}")
                return
            }
        }
        let e = next ?? {
            print("{label}: end")
            return
        }
        let body = tar.read_entry(r) catch {
            err => {
                print("{label}: {e.name} body {error_name(err)}")
                return
            }
        }
        print("{label}: {e.name} {kind_name(e.kind)} size={e.size} mode={text.radix(e.mode, 8)} uid={e.uid} gid={e.gid} mtime={e.mtime} link={e.link} body={body_text(body)}")
    }
}

fn walk_data(label: str, data: []u8) {
    walk(label, tar.bytes_reader(data))
}

fn field(block: []u8, at: i64, s: str) {
    for i in 0..s.len {
        block[at + i] = s[i]
    }
}

fn octal(v: i64, width: i64) -> str {
    text.pad_left(text.radix(v, 8), width, '0')
}

fn seal(block: []u8) {
    for i in 148..156 {
        block[i] = ' '
    }
    var sum = 0
    for b in block {
        sum += i64(b)
    }
    field(block, 148, octal(sum, 6))
    block[154] = 0
    block[155] = ' '
}

fn forge(name: str, flag: u8, size: i64, link: str) -> []u8 {
    let block = io.buffer(512)
    field(block, 0, name)
    field(block, 100, "0000644")
    field(block, 108, "0001750")
    field(block, 116, "0000144")
    field(block, 124, octal(size, 11))
    field(block, 136, "13603256645")
    block[156] = flag
    field(block, 157, link)
    field(block, 257, "ustar")
    field(block, 263, "00")
    seal(block)
    block
}

fn base256(block: []u8, v: i64) {
    block[124] = 0x80
    for i in 1..12 {
        block[124 + i] = u8(v >> (8 * (11 - i)))
    }
    seal(block)
}

fn padded(body: str) -> []u8 {
    let out = bytes(body)
    var result: []u8 = []
    io.append(mut result, out)
    for _ in 0..(512 - body.len % 512) % 512 {
        push(mut result, 0)
    }
    result
}

fn join(parts: [][]u8) -> []u8 {
    var out: []u8 = []
    for p in parts {
        io.append(mut out, p)
    }
    out
}

fn record(key: str, value: str) -> str {
    let body = key.len + value.len + 3
    let total = if body + 1 < 10 { body + 1 } else if body + 2 < 100 { body + 2 } else { body + 3 }
    "{total} {key}={value}\n"
}

fn references() {
    walk_data("ustar", ustar_ref())
    walk_data("gnu", gnu_ref())
    walk_data("pax", pax_ref())
}

fn gzip_reference() {
    let r = tar.read_gzip(ustar_gzip()) catch {
        e => {
            print("gzip: {error_name(e)}")
            return
        }
    }
    walk("gzip", r)
}

fn forged() {
    walk_data("plain", join([forge("a.txt", '0', 5, ""), padded("hello")]))

    let sized = forge("big.bin", '0', 0, "")
    base256(sized, 5)
    walk_data("base256", join([sized, padded("12345")]))

    let negative = forge("neg", '0', 0, "")
    negative[124] = 0xFF
    for i in 125..136 {
        negative[i] = 0xFF
    }
    seal(negative)
    walk_data("negative size", join([negative]))

    let flipped = forge("bad", '0', 0, "")
    flipped[0] = 'c'
    walk_data("checksum", join([flipped]))

    walk_data("truncated body", join([forge("t", '0', 600, ""), padded("short")]))
    let cut = forge("t", '0', 0, "")[..300]
    walk_data("truncated header", cut)

    let pax_size = join([forge("px", 'x', record("size", "3").len, ""), padded(record("size", "3")), forge("v", '0', 100, ""), padded("abc")])
    walk_data("pax size", pax_size)

    let pax_path = join([forge("px", 'x', record("path", "renamed/dir/file").len + record("uid", "77").len + record("mtime", "5.5").len, ""), padded("{record("path", "renamed/dir/file")}{record("uid", "77")}{record("mtime", "5.5")}"), forge("orig", '0', 0, "")])
    walk_data("pax fields", pax_path)

    let bad_length = join([forge("px", 'x', 10, ""), padded("99 path=a\n"), forge("v", '0', 0, "")])
    walk_data("pax bad length", bad_length)

    let no_equals = join([forge("px", 'x', 9, ""), padded("9 pathab\n"), forge("v", '0', 0, "")])
    walk_data("pax no equals", no_equals)

    let global = join([forge("g", 'g', record("path", "ignored").len, ""), padded(record("path", "ignored")), forge("kept", '0', 0, "")])
    walk_data("pax global", global)

    walk_data("sparse", join([forge("sp", 'S', 0, "")]))

    let skipped = join([forge("one", '0', 700, ""), padded(text.repeat("x", 700)), forge("two", '0', 3, ""), padded("abc")])
    let r = tar.bytes_reader(skipped)
    let first = tar.next(r) catch {
        _ => none
    }
    print("skip first {(first ?? tar.Entry { name: "none" }).name}")
    walk("skip rest", r)

    let ended = join([forge("a", '0', 1, ""), padded("z"), io.buffer(1024), forge("after", '0', 0, "")])
    walk_data("after end", ended)

    let tiny = tar.bytes_reader(join([forge("t", '0', 10, ""), padded("0123456789")]))
    let t = tar.next(tiny) catch {
        _ => none
    }
    let buf = io.buffer(4)
    var pieces = ""
    for {
        let n = tar.read_body(tiny, buf) catch {
            _ => -1
        }
        if n <= 0 {
            break
        }
        pieces = "{pieces}[{str(buf[..n])}]"
    }
    print("small reads {(t ?? tar.Entry { name: "none" }).size} {pieces}")
}

fn limits() {
    let big = join([forge("big", '0', 5000, ""), padded(text.repeat("y", 5000))])
    let entry_limit = tar.reader_with(io.bytes_reader(big), tar.Limits { entry: 4096 })
    walk("entry limit", entry_limit)

    let two = join([forge("a", '0', 3000, ""), padded(text.repeat("a", 3000)), forge("b", '0', 3000, ""), padded(text.repeat("b", 3000))])
    let total_limit = tar.reader_with(io.bytes_reader(two), tar.Limits { total: 5000 })
    walk("total limit", total_limit)

    let header_limit = join([forge("px", 'x', 2000, ""), padded(text.repeat("a", 2000)), forge("v", '0', 0, "")])
    walk("header limit", tar.reader_with(io.bytes_reader(header_limit), tar.Limits { header: 1000 }))

    let bomb = join([forge("bomb", '0', 0, ""), []])
    base256(bomb, 1 << 40)
    walk_data("huge size", bomb)

    let gz = tar.read_gzip_with(ustar_gzip(), tar.Limits { total: 2048 }) catch {
        e => {
            print("gzip limit: {error_name(e)}")
            return
        }
    }
    walk("gzip limit", gz)
}

fn describe(w: *tar.Writer) {
    let data = tar.output(w)
    print("size {data.len} blocks {data.len % 512}")
    walk_data("written", data)
}

fn writer_fields() {
    let w = tar.writer()
    let e = tar.Entry { name: "a.txt", mode: 0o644, uid: 1000, gid: 100, mtime: 1577934245 }
    tar.add(w, e, bytes("hi\n")) catch {
        _ => return
    }
    let data = tar.output(w)
    print(text.encode_hex(data[100..157]))
    print(text.encode_hex(data[257..265]))
    print(text.encode_hex(data[512..515]))
    print(data.len)
    tar.finish(w) catch {
        _ => return
    }
    print(tar.output(w).len)
    print(is_zero(tar.output(w)[1024..]))
    tar.add_file(w, "late", [], 0o644) catch {
        e => print("add after finish: {error_name(e)}")
    }
}

fn is_zero(data: []u8) -> bool {
    for b in data {
        if b != 0 {
            return false
        }
    }
    true
}

fn writer_roundtrip() ! io.Error {
    let w = tar.writer()
    tar.add_dir(w, "docs", 0o755)?
    tar.add_file(w, "docs/readme.txt", bytes("hello tar"), 0o640)?
    tar.add_file(w, "docs/empty", [], 0o600)?
    let deep = "{text.repeat("verylongdirectoryname/", 8)}file.txt"
    tar.add_file(w, deep, bytes("deep"), 0o600)?
    let flat = text.repeat("x", 130)
    tar.add_file(w, flat, bytes("flat"), 0o600)?
    tar.add_file(w, "héllo.txt", bytes("utf8"), 0o644)?
    tar.add_symlink(w, "docs/link", "readme.txt")?
    tar.add_symlink(w, "docs/biglink", text.repeat("t", 150))?
    tar.add_hardlink(w, "docs/hard", "docs/readme.txt")?
    tar.add(w, tar.Entry { name: "wide", uid: 5000000, gid: 3, mtime: -5 }, bytes("neg"))?
    tar.add(w, tar.Entry { name: "late", mtime: 9000000000 }, bytes("late"))?
    tar.finish(w)?
    describe(w)
    let again = tar.list(tar.output(w))?
    print("listed {again.len}")
    let big = tar.writer()
    tar.add_file(big, "large", bytes(text.repeat("0123456789", 100)), 0o644)?
    tar.add_file(big, "next", bytes("n"), 0o644)?
    tar.finish(big)?
    walk_data("large", tar.output(big))
    let gz = tar.write_gzip(w, 6)?
    let back = tar.read_gzip(gz)?
    var count = 0
    for {
        let e = tar.next(back)? ?? break
        count += 1
    }
    print("gzip round trip {count}")
}

fn streaming() ! io.Error {
    var chunks = 0
    var collected: []u8 = []
    let sink = io.Stream {
        read: fn(buf) { 0 }
        write: fn(data) -> i64 ! io.Error {
            chunks += 1
            io.append(mut collected, data)
            data.len
        }
        close: fn() {}
    }
    let w = tar.stream_writer(sink)
    tar.add_file(w, "one", bytes("1"), 0o644)?
    tar.add_dir(w, "two", 0o755)?
    tar.finish(w)?
    print("streamed {collected.len} {chunks > 3}")
    print("buffer empty {tar.output(w).len}")
    walk_data("streamed", collected)
    let gz = tar.write_gzip(w, 6) catch {
        e => {
            print("stream gzip: {error_name(e)}")
            return
        }
    }
    print(gz.len)
}

fn tree(root: str) -> str {
    let names = file.list(root) catch {
        _ => []
    }
    var sorted = names
    sorted |> slices.sort()
    text.join(sorted, ",")
}

fn extract_reference(root: str) ! io.Error {
    let dir = "{root}/ref"
    tar.extract(ustar_ref(), dir)?
    print("ref tree {tree("{dir}/d")}")
    print(text.trim(file.read_text("{dir}/d/hard")?))
    print(text.trim(file.read_text("{dir}/d/hello.txt")?))
    print(text.trim(file.read_text("{dir}/d/ln")?))
    print(archive.read_link("{dir}/d/ln")?)
    let st = archive.lstat("{dir}/d/hello.txt")?
    print("{text.radix(st.mode & 0o700, 8)} {st.mtime}")
    let dst = archive.lstat("{dir}/d")?
    print("dir {text.radix(dst.mode & 0o700, 8)} {dst.mtime}")

    tar.extract_gzip(ustar_gzip(), "{root}/gz")?
    print("gz tree {tree("{root}/gz/d")}")
    let pax = "{root}/pax"
    tar.extract(pax_ref(), pax)?
    print("pax tree {tree("{pax}/p")}")
    let st2 = archive.lstat("{pax}/p/frac")?
    print(st2.mtime)
    let gnu = "{root}/gnu"
    tar.extract(gnu_ref(), gnu)?
    print("gnu tree {tree("{gnu}/g").len}")
    print(archive.read_link("{gnu}/g/sl")?.len)
}

fn extract_roundtrip(root: str) ! io.Error {
    let w = tar.writer()
    tar.add_dir(w, "top", 0o755)?
    tar.add_file(w, "top/a.txt", bytes("alpha"), 0o644)?
    tar.add_file(w, "top/sub/b.txt", bytes("bravo"), 0o600)?
    tar.add_file(w, "top/sub/setuid", bytes("s"), 0o4755)?
    tar.add_symlink(w, "top/sub/link", "b.txt")?
    tar.add_hardlink(w, "top/sub/hard", "top/sub/b.txt")?
    tar.add(w, tar.Entry { name: "top/old", mtime: 1000000000 }, bytes("old"))?
    tar.add(w, tar.Entry { name: "top/old-dir", kind: Dir, mode: 0o500, mtime: 1000000000 }, [])?
    tar.finish(w)?
    let dir = "{root}/rt"
    tar.extract(tar.output(w), dir)?
    print("rt tree {tree("{dir}/top")} / {tree("{dir}/top/sub")}")
    print(file.read_text("{dir}/top/sub/b.txt")?)
    print(file.read_text("{dir}/top/sub/link")?)
    print(file.read_text("{dir}/top/sub/hard")?)
    let s = archive.lstat("{dir}/top/sub/setuid")?
    print("setuid stripped {s.mode & 0o7000} {s.mode & 0o700 == 0o700}")
    print(archive.lstat("{dir}/top/old")?.mtime)
    let od = archive.lstat("{dir}/top/old-dir")?
    print("{od.mtime} {text.radix(od.mode & 0o700, 8)}")

    tar.extract(tar.output(w), dir)?
    print("again {tree("{dir}/top")}")

    let packed = tar.create(dir)?
    let listing = tar.list(packed)?
    var names: []str = []
    for e in listing {
        push(mut names, "{e.name}:{kind_name(e.kind)}:{e.size}")
    }
    print(text.join(names, " "))
    let gz = tar.create_gzip(dir, 6)?
    let r = tar.read_gzip(gz)?
    var count = 0
    for {
        let e = tar.next(r)? ?? break
        count += 1
    }
    print("create gzip {count}")

    let copy = "{root}/copy"
    tar.extract(packed, copy)?
    print(file.read_text("{copy}/top/sub/b.txt")?)
    print(archive.read_link("{copy}/top/sub/link")?)
}

fn attempt(root: str, label: str, data: []u8) {
    let dir = "{root}/{label}"
    tar.extract(data, dir) catch {
        e => {
            print("{label}: {error_name(e)}")
            return
        }
    }
    print("{label}: extracted {tree(dir)}")
}

fn hostile(root: str) ! io.Error {
    let outside = "{root}/outside"
    file.mkdir(outside)?
    let absolute = join([forge("{outside}/abs.txt", '0', 1, ""), padded("x")])
    attempt(root, "absolute", absolute)
    print("absolute created {file.exists("{outside}/abs.txt")}")

    attempt(root, "dotdot", join([forge("../escape.txt", '0', 1, ""), padded("x")]))
    print("dotdot created {file.exists("{root}/escape.txt")}")
    attempt(root, "nested dotdot", join([forge("a/../../escape2.txt", '0', 1, ""), padded("x")]))
    print("nested created {file.exists("{root}/escape2.txt")}")
    attempt(root, "bare dotdot", join([forge("..", '5', 0, "")]))
    attempt(root, "empty name", join([forge("", '0', 0, "")]))

    let through = join([forge("s", '2', 0, outside), forge("s/pwn.txt", '0', 3, ""), padded("pwn")])
    attempt(root, "symlink escape", through)
    print("symlink escape created {file.exists("{outside}/pwn.txt")}")

    let relative = join([forge("r", '2', 0, "../outside"), forge("r/pwn2.txt", '0', 3, ""), padded("pwn")])
    attempt(root, "relative escape", relative)
    print("relative escape created {file.exists("{outside}/pwn2.txt")}")

    let dir_through = join([forge("d", '2', 0, outside), forge("d/sub/", '5', 0, "")])
    attempt(root, "dir escape", dir_through)
    print("dir escape created {file.exists("{outside}/sub")}")

    let victim = "{root}/victim.txt"
    file.write_text(victim, "original")?
    attempt(root, "hardlink escape", join([forge("h", '1', 0, "../victim.txt")]))
    attempt(root, "hardlink absolute", join([forge("h", '1', 0, victim)]))
    attempt(root, "hardlink through link", join([forge("l", '2', 0, outside), forge("h", '1', 0, "l/abs.txt")]))
    print("victim {file.read_text(victim)?}")

    let existing = "{root}/pre"
    archive.make_root(existing)?
    archive.symlink("{existing}/jump", outside)?
    tar.extract(join([forge("jump/planted.txt", '0', 1, ""), padded("x")]), existing) catch {
        e => print("existing link: {error_name(e)}")
    }
    print("existing link created {file.exists("{outside}/planted.txt")}")

    tar.extract(join([forge("file", '0', 1, ""), padded("x"), forge("file/under", '0', 1, ""), padded("y")]), "{root}/under") catch {
        e => print("file as dir: {error_name(e)}")
    }

    let replace = join([forge("swap", '0', 1, ""), padded("a"), forge("swap", '2', 0, outside), forge("swap", '0', 1, ""), padded("b")])
    attempt(root, "replace link", replace)
    print("replace link {file.read_text("{root}/replace link/swap")?} {file.exists("{outside}/swap")}")

    let truncated = join([forge("a", '0', 1, ""), padded("a"), forge("b", '0', 600, ""), padded("short")])
    attempt(root, "truncated", truncated)
    print("truncated {tree("{root}/truncated")}")

    let limited = tar.reader_with(io.bytes_reader(join([forge("l", '0', 5000, ""), padded(text.repeat("z", 5000))])), tar.Limits { entry: 100 })
    tar.extract_from(limited, "{root}/limited") catch {
        e => print("limited: {error_name(e)}")
    }
    print("limited {tree("{root}/limited")}")
}

fn main() ! io.Error {
    references()
    gzip_reference()
    forged()
    limits()
    writer_fields()
    writer_roundtrip()?
    streaming()?
    let root = file.temp_dir("low-std-tar-")?
    extract_reference(root)?
    extract_roundtrip(root)?
    hostile(root)?
    file.remove_all(root)?
    print(file.exists(root))
}
