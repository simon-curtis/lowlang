import std/net/publicsuffix
import std/text

struct Argument {
    absent: bool
    value: str
}

fn argument(token: str) -> Argument {
    if token == "null" {
        return Argument { absent: true, value: "" }
    }
    Argument { absent: false, value: text.trim_suffix(text.trim_prefix(token, "'"), "'") }
}

fn optional(a: Argument) -> str? {
    if a.absent { none } else { a.value }
}

fn shown(s: str?) -> str {
    match s {
        some(v) => v
        none => "null"
    }
}

fn section_name(s: publicsuffix.Section) -> str {
    match s {
        Icann => "icann"
        Private => "private"
        Unlisted => "unlisted"
    }
}

fn suffix_text(domain: str, rules: publicsuffix.Rules) -> str {
    match publicsuffix.public_suffix(domain, rules) {
        some(s) => "{s.name} {section_name(s.section)}"
        none => "null"
    }
}

fn row(domain: str) {
    let registrable = publicsuffix.registrable_domain(domain, publicsuffix.Rules.All)
    let icann = publicsuffix.registrable_domain(domain, publicsuffix.Rules.Icann)
    print("{domain} | all: {suffix_text(domain, publicsuffix.Rules.All)}, {shown(registrable)} | icann: {suffix_text(domain, publicsuffix.Rules.Icann)}, {shown(icann)}")
}

fn vectors() {
    var total = 0
    var passed = 0
    var skipped = 0
    for line in text.lines(embed("std_publicsuffix.txt")) {
        if !text.starts_with(line, "checkPublicSuffix(") {
            continue
        }
        let inner = text.trim_suffix(text.trim_prefix(line, "checkPublicSuffix("), ");")
        let cut = text.cut(inner, ", ")
        let input = argument(cut.before)
        let expected = optional(argument(cut.after))
        if input.absent {
            skipped += 1
            continue
        }
        total += 1
        let got = publicsuffix.registrable_domain(input.value, publicsuffix.Rules.All)
        if got == expected {
            passed += 1
        } else {
            print("failed: {line} got {shown(got)}")
        }
    }
    print("vectors {total} passed {passed} skipped {skipped}")
}

fn main() {
    vectors()

    print("sections")
    for domain in ["www.example.co.uk", "foo.bar.github.io", "github.io", "x.us-east-1.compute.amazonaws.com", "example.com", "a.b.c.ck", "www.ck", "www.city.kobe.jp", "nowhere.invalid-tld", "localhost"] {
        row(domain)
    }

    print("forms")
    for domain in ["WWW.食狮.公司.CN", "WWW.XN--85X722F.XN--55QX5D.CN", "www。食狮。公司。cn", "ＷＷＷ.ｅｘａｍｐｌｅ.ｃｏｍ", "食狮.xn--55qx5d.cn", "Bücher.Example.中国"] {
        row(domain)
    }

    print("rejected")
    for domain in ["", ".", ".com", "example.com.", "a..com", "xn--.com", "xn--a-ä.com", "a�.com"] {
        row(domain)
    }
    print("underscore {shown(publicsuffix.registrable_domain("_dmarc.example.com", publicsuffix.Rules.All))}")

    for domain in ["com", "co.uk", "github.io", "localhost", "example.com", "www.github.io", "", ".com"] {
        print("is_public_suffix {domain}: {publicsuffix.is_public_suffix(domain, publicsuffix.Rules.All)} {publicsuffix.is_public_suffix(domain, publicsuffix.Rules.Icann)}")
    }
    print("list {publicsuffix.list_version()} {publicsuffix.list_commit()}")
}
