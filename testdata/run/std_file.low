import std/file
import std/io

fn closed(op: fn() -> i64 ! io.Error) -> str {
    op() catch {
        NotConnected => return "closed"
        _ => return "other"
    }
    "open"
}

fn main() ! io.Error {
    let dir = "/tmp/low-std-file-test/nested"
    file.mkdir_all(dir)?
    let path = "{dir}/notes.txt"
    file.write_text(path, "first\n")?
    {
        using f = file.append(path)?
        file.write_str(f, "second\n")?
    }
    print(file.read_text(path)?)
    let info = file.stat(path)?
    print(info.size)
    print(info.dir)
    print(file.stat(dir)?.dir)
    using g = file.open(path)?
    print(file.seek(g, -7, End)?)
    let buf = io.buffer(32)
    let n = file.read(g, buf)?
    print(str(buf[..n]))
    let view = g.handle
    file.close(g)
    file.close(g)
    {
        using reopened = file.open(path)?
        print(reopened.handle.fd == view.fd)
        print(closed(fn() -> i64 ! io.Error { file.read_on(view, buf)? }))
        print(closed(fn() -> i64 ! io.Error { file.write_on(view, buf)? }))
        print(closed(fn() -> i64 ! io.Error { file.stream_on(view).read(buf)? }))
    }
    file.rename(path, "{dir}/moved.txt")?
    print(file.exists(path))
    for name in file.list(dir)? {
        print(name)
    }
    file.remove("{dir}/moved.txt")?
    file.remove_dir(dir)?
    file.remove_dir("/tmp/low-std-file-test")?
    file.open(path) catch {
        NotFound => {
            print("gone")
            return
        }
        _ => return
    }
}
