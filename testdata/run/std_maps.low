import std/maps
import std/slices
import std/text

fn show(xs: []i64) -> str {
    text.join(slices.map(xs, fn(x: i64) -> str { "{x}" }), ",")
}

fn main() {
    let ages = ["ada": 36, "alan": 41, "grace": 85]
    print(text.join(ages |> maps.keys(), " "))
    print(show(ages |> maps.values()))
    print(text.join(["pear": 1, "apple": 2, "fig": 3] |> maps.sorted_keys(), " "))
    print("{ages |> maps.has("ada")} {ages |> maps.has("bob")}")
    print("{maps.get_or(ages, "alan", 0)} {maps.get_or(ages, "bob", -1)}")

    let pairs = ages |> maps.entries()
    for p in pairs {
        print("{p.first}={p.second}")
    }
    let rebuilt = maps.from_pairs(pairs)
    print("{rebuilt.len} {rebuilt["grace"] ?? 0}")
    let dup = maps.from_pairs([slices.Pair[str, i64] { first: "k", second: 1 }, slices.Pair[str, i64] { first: "k", second: 2 }])
    print("{dup.len} {dup["k"] ?? 0}")

    var copy = maps.clone(ages)
    copy["ada"] = 0
    copy["new"] = 1
    print("{ages["ada"] ?? -1} {ages.len} {copy["ada"] ?? -1} {copy.len}")

    let merged = maps.merge(["a": 1, "b": 2], ["b": 20, "c": 30])
    print(text.join(merged |> maps.keys(), " "))
    print(show(merged |> maps.values()))

    let big = ages |> maps.filter(fn(k: str, v: i64) -> bool { v > 40 && k != "grace" })
    print(text.join(big |> maps.keys(), " "))

    let labels = ages |> maps.map_values(fn(v: i64) -> str { "age {v}" })
    print(labels["ada"] ?? "none")

    let by_age = ages |> maps.invert()
    print(by_age[85] ?? "none")
    print(by_age[1] ?? "none")

    let words = ["apple", "avocado", "banana", "blueberry", "cherry", "apricot"]
    let counts = words |> maps.count_by(fn(w: str) -> u8 { w[0] })
    for first in counts |> maps.sorted_keys() {
        print("{first} {counts[first] ?? 0}")
    }
    let groups = words |> maps.group_by(fn(w: str) -> i64 { w.len })
    for n in groups |> maps.sorted_keys() {
        print("{n} {text.join(groups[n] ?? [], " ")}")
    }

    let empty: [str: i64] = [:]
    print("{(empty |> maps.keys()).len} {(empty |> maps.entries()).len} {(empty |> maps.merge(empty)).len}")
}
