enum Inner {
    Bad(at: i64)
    Empty
}

enum Outer {
    Parse(Inner)
    Other
}

fn parse(s: str) -> i64 ! Inner {
    if s.len == 0 { fail Empty }
    if s[0] == 'x' { fail Bad(7) }
    s.len
}

fn lift(e: Inner) -> Outer {
    Parse(e)
}

fn noisy(e: Inner) -> Outer {
    print("mapping")
    Parse(e)
}

fn wrapped(s: str) -> i64 ! Outer {
    parse(s) catch Parse
}

fn qualified(s: str) -> i64 ! Outer {
    parse(s) catch Outer.Parse
}

fn piped(s: str) -> i64 ! Outer {
    let n = s |> parse() catch lift
    n + 1
}

fn stored(s: str) -> i64 ! Outer {
    let wrap: fn(Inner) -> Outer = lift
    parse(s) catch wrap
}

fn deferred(s: str) -> i64 ! Outer {
    defer print("deferred")
    parse(s) catch noisy
}

fn replaced(s: str) -> i64 ! Outer {
    parse(s) or fail Other
}

fn optional(s: str) -> i64? {
    parse(s) or return none
}

fn report(e: Outer) -> i64 {
    match e {
        Parse(inner) => match inner {
            Bad(at) => print("parse: bad at {at}")
            Empty => print("parse: empty")
        }
        Other => print("other")
    }
    -1
}

fn main() {
    print(wrapped("abc") or -1)
    print(wrapped("x") catch { e => report(e) })
    print(qualified("") catch { e => report(e) })
    print(piped("ab") or -1)
    print(piped("x") catch { e => report(e) })
    print(stored("") catch { e => report(e) })
    print(deferred("x") catch { e => report(e) })
    print(replaced("") catch { e => report(e) })
    print("" |> parse() or 0)
    let o: i64? = parse("") or none
    print(o ?? -3)
    let p: i64? = parse("abcd") or none
    print(p ?? -3)
    let q: i64? = parse("x") catch {
        Empty => none
        Bad(at) => at
    }
    print(q ?? -4)
    print(optional("") ?? -5)
    print(optional("ab") ?? -5)
}
