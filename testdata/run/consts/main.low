import limits

const billion: f32 = 1_000_000_000.0
const half = billion / 2.0
const max_byte: u8 = 255
const wrapped: u8 = max_byte + 1
const low_bits: u32 = 0xFF_FF
const mask = ~low_bits
const negative: i32 = -7
const quotient = negative / 2
const remainder = negative % 2
const narrowed = u8(300)
const truncated = i64(-2.75)
const widened = f64(negative)
const unsigned_top: u64 = 18_446_744_073_709_551_615
const top_half = unsigned_top >> 1
const signed_shift = negative >> 70
const enabled = max_byte > 200 && !(half < 1.0)
const ok = 200
const not_found = 404

fn status(code: i64) -> str {
    match code {
        ok => "ok"
        not_found => "not found"
        _ => "other"
    }
}

fn bounded(width: f32) -> bool {
    width < limits.unbounded
}

fn main() {
    let ok = 1
    print(billion)
    print(half)
    print(wrapped)
    print(mask)
    print(quotient)
    print(remainder)
    print(narrowed)
    print(truncated)
    print(widened)
    print(top_half)
    print(signed_shift)
    print(enabled)
    print(ok)
    print(status(200))
    print(status(404))
    print(status(500))
    print(bounded(billion))
    print(bounded(limits.unbounded))
    print(limits.mib)
    print(limits.greeting)
    var total: u8 = 250
    total += max_byte - 250
    print(total)
}
