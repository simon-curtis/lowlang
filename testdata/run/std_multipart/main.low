import std/base64
import std/header
import std/http
import std/io
import std/multipart
import std/text

struct Seen {
    part: multipart.Part
    data: []u8
}

fn failure(e: multipart.Error) -> str {
    match e {
        BadContentType => "BadContentType"
        BadBoundary => "BadBoundary"
        Malformed(at, message) => "Malformed at {at}: {message}"
        Truncated => "Truncated"
        TooManyParts => "TooManyParts"
        HeaderTooLarge => "HeaderTooLarge"
        TooLarge => "TooLarge"
        BoundaryInData => "BoundaryInData"
        InvalidHeader => "InvalidHeader"
        Finished => "Finished"
        Io(_) => "Io"
    }
}

fn same(a: []u8, b: []u8) -> bool {
    if a.len != b.len {
        return false
    }
    for i in 0..a.len {
        if a[i] != b[i] {
            return false
        }
    }
    true
}

fn collect(r: *multipart.Reader) -> []Seen ! multipart.Error {
    var out: []Seen = []
    for {
        let part = multipart.next_part(r)? ?? break
        let data = multipart.read_bytes(r)?
        push(mut out, Seen { part, data })
    }
    out
}

fn gather(body: []u8, boundary: str, limits: multipart.Limits) -> []Seen ! multipart.Error {
    let r = multipart.bytes_reader(body, boundary, limits)?
    collect(r)?
}

fn summary(s: Seen) -> str {
    let p = s.part
    "#{p.index} {p.disposition} name={text.quote(p.name)} file={text.quote(p.filename ?? "(none)")} type={text.quote(p.content_type)} size={s.data.len}"
}

fn dump(label: str, body: []u8, boundary: str) {
    print("== {label}")
    let seen = gather(body, boundary, multipart.Limits {}) catch {
        e => {
            print("error {failure(e)}")
            return
        }
    }
    for s in seen {
        print(summary(s))
    }
}

fn boundaries() {
    let cases = [
        "multipart/form-data; boundary=abc"
        "Multipart/Form-Data; Boundary=\"a b c\""
        "multipart/form-data;boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW"
        "multipart/mixed; charset=utf-8; boundary=\"=_foo:bar\"; x=y"
        "multipart/form-data; boundary=\"quoted \\\"inner\\\"\""
        "multipart/form-data; boundary=abc; boundary=def"
        "text/plain; boundary=abc"
        "multipart/form-data"
        "multipart/form-data; boundary="
        "multipart/form-data; boundary=\"\""
        "multipart/form-data; boundary=\"trailing \""
        "multipart/form-data; boundary=a@b"
        "multipart/form-data; boundary=12345678901234567890123456789012345678901234567890123456789012345678901"
        "multipart/form-data; boundary=1234567890123456789012345678901234567890123456789012345678901234567890"
        ""
    ]
    for c in cases {
        let b = multipart.boundary_from_content_type(c) catch {
            e => failure(e)
        }
        print("{text.quote(c)} -> {text.quote(b)}")
    }
}

fn boundary_of(path_type: str) -> str {
    multipart.boundary_from_content_type(path_type) catch {
        e => failure(e)
    }
}

fn show_form(f: multipart.Form) {
    for field in f.fields {
        print("field {text.quote(field.name)} = {text.quote(field.value)}")
    }
    for file in f.files {
        print("file {text.quote(file.name)} {text.quote(file.filename)} {text.quote(file.content_type)} size={file.size} spilled={file.spilled} index={file.index}")
    }
}

fn form_of(body: []u8, boundary: str) -> multipart.Form {
    let r = multipart.bytes_reader(body, boundary, multipart.Limits {}) or return multipart.Form { fields: [], files: [] }
    multipart.read_form(r, none) catch {
        e => {
            print("error {failure(e)}")
            multipart.Form { fields: [], files: [] }
        }
    }
}

fn requests_vector() {
    let boundary = boundary_of(embed("requests.ctype"))
    let body = bytes(embed("requests.body"))
    dump("requests", body, boundary)
    let seen = gather(body, boundary, multipart.Limits {}) or return
    print("title {text.quote(str(seen[0].data))}")
    print("doc {same(seen[4].data, bytes(embed("sample.txt")))}")
    print("blob {same(seen[5].data, bytes(embed("random.bin")))}")
    let form = form_of(body, boundary)
    show_form(form)
    print("tags {text.join(multipart.values(form, "tag"), ",")} title {multipart.value(form, "title") ?? "-"} missing {multipart.value(form, "zzz") ?? "-"}")
    let doc = multipart.file(form, "doc")
    match doc {
        some(f) => print("doc form {same(f.data, bytes(embed("sample.txt")))}")
        none => print("doc missing")
    }
}

fn curl_vector() {
    let boundary = boundary_of(embed("curl.ctype"))
    let body = bytes(embed("curl.body"))
    dump("curl", body, boundary)
    let seen = gather(body, boundary, multipart.Limits {}) or return
    print("doc {same(seen[3].data, bytes(embed("sample.txt")))}")
    print("blob {same(seen[4].data, bytes(embed("random.bin")))}")
    print("note {text.quote(str(seen[5].data))}")
    print("extra {multipart.header(seen[6].part, "x-extra") ?? "-"} {multipart.media_type(seen[6].part)} {multipart.media_type(seen[0].part)}")
    show_form(form_of(body, boundary))
}

fn decoded(data: []u8) -> []u8 {
    let joined = text.replace(str(data), "\r\n", "")
    base64.decode(joined) or []
}

fn email_vector() {
    let boundary = boundary_of(embed("email.ctype"))
    let whole = embed("email.body")
    let at = text.index(whole, "\r\n\r\n")
    let body = bytes(whole[at + 4..])
    dump("email", body, boundary)
    let seen = gather(body, boundary, multipart.Limits {}) or return
    print("first {text.quote(str(decoded(seen[0].data)))}")
    print("attachment {same(decoded(seen[2].data), bytes(embed("random.bin")))}")
    print("long {text.quote(seen[3].part.filename ?? "")}")
    print("long body {text.quote(str(seen[3].data))}")
    let nested = multipart.boundary_from_content_type(seen[1].part.content_type) catch {
        e => failure(e)
    }
    print("nested boundary {text.quote(nested)}")
    dump("nested", seen[1].data, nested)
    for h in seen[2].part.headers {
        print("{h.name}: {h.value}")
    }
    for h in seen[2].part.params {
        print("param {h.name} = {text.quote(h.value)}")
    }
}

fn msg(lines: []str) -> []u8 {
    bytes(text.join(lines, "\r\n"))
}

fn disposition(rest: str) -> str {
    "Content-Disposition: {rest}"
}

fn handcrafted() {
    dump("preamble padding case", msg([
        "preamble text", "more preamble", "--XYZ  \t",
        disposition("form-data; name=\"a\""), "", "one",
        "--XYZ",
        "content-disposition: FORM-DATA; NAME=a;  filename = \"x.txt\" ", "CONTENT-TYPE: Text/Plain", "", "two",
        "--XYZ--", "epilogue", "",
    ]), "XYZ")
    dump("bare start and bare end", bytes("--XYZ\r\n\r\nbody\r\n--XYZ--"), "XYZ")
    let lookalike = gather(msg([
        "--XYZ", disposition("form-data; name=\"a\""), "", "x", "--XYZ-nope", "--XYZQ", "--XY", "-- XYZ", "y", "--XYZ--",
    ]), "XYZ", multipart.Limits {}) or return
    print("lookalike {text.quote(str(lookalike[0].data))} {lookalike.len}")
    let empties = gather(msg([
        "--XYZ", disposition("form-data; name=\"e\""), "", "", "--XYZ", disposition("form-data; name=\"cr\""), "", "a\r", "--XYZ--",
    ]), "XYZ", multipart.Limits {}) or return
    print("empties {text.quote(str(empties[0].data))} {text.quote(str(empties[1].data))}")
    let folded = gather(msg([
        "--XYZ", "Content-Disposition: form-data;", " name=\"folded\";", "\tfilename=\"f.txt\"", "X-Long: one", "  two", "", "d", "--XYZ--",
    ]), "XYZ", multipart.Limits {}) or return
    print("folded {text.quote(folded[0].part.name)} {text.quote(folded[0].part.filename ?? "-")} {text.quote(multipart.header(folded[0].part, "x-long") ?? "-")}")
}

fn params() {
    dump("parameters", msg([
        "--XYZ", disposition("form-data; name=\"a\\\"b\\\\c\"; filename=\"C:\\dir\\file.txt\""), "", "1",
        "--XYZ", disposition("form-data; name=\"semi;colon\"; filename=\"x;y.txt\"; name=\"second\""), "", "2",
        "--XYZ", disposition("form-data; name=plain; filename*=UTF-8''%e2%82%ac%20rates.txt; filename=\"fallback.txt\""), "", "3",
        "--XYZ", disposition("attachment; filename*=iso-8859-1'en'%A3%20rates.txt"), "", "4",
        "--XYZ", disposition("form-data; name=\"u\"; filename*2*=%2Etxt; filename*0*=utf-8'en'%E2%82%AC%20; filename*1=\"rates\""), "", "5",
        "--XYZ", disposition("form-data; name=\"e\"; filename=\"\""), "", "6",
        "--XYZ", "X-Other: none", "", "7",
        "--XYZ", disposition("form-data;name=\"tight\";filename=\"t.txt\";"), "", "8",
        "--XYZ", disposition("form-data; name=\"bad\"; filename*=utf-8'en'%zz%41"), "", "9",
        "--XYZ", disposition("form-data; name=\"open\"; filename=\"unterminated"), "", "10",
        "--XYZ--", "",
    ]), "XYZ")
    let form = form_of(msg([
        "--XYZ", disposition("form-data; name=\"a\""), "", "1",
        "--XYZ", "X-Other: none", "", "skipped",
        "--XYZ", disposition("attachment; name=\"b\""), "", "skipped too",
        "--XYZ", disposition("form-data; name=\"e\"; filename=\"\""), "", "",
        "--XYZ--", "",
    ]), "XYZ")
    show_form(form)
}

struct Feed {
    data: []u8
    at: i64
    step: i64
}

fn feed_reader(data: []u8, step: i64) -> *io.Reader {
    let feed = new(Feed { data, at: 0, step })
    let stream = io.Stream {
        read: fn(buf) -> i64 ! io.Error {
            var n = feed.step
            if n > buf.len {
                n = buf.len
            }
            if n > feed.data.len - feed.at {
                n = feed.data.len - feed.at
            }
            io.copy(buf, feed.data[feed.at..feed.at + n])
            feed.at += n
            n
        }
        write: fn(buf) -> i64 ! io.Error { fail io.Error.Unsupported }
        close: fn() {}
    }
    io.reader(stream)
}

fn seen_equal(a: []Seen, b: []Seen) -> bool {
    if a.len != b.len {
        return false
    }
    for i in 0..a.len {
        if summary(a[i]) != summary(b[i]) || !same(a[i].data, b[i].data) {
            return false
        }
        if a[i].part.params.len != b[i].part.params.len || a[i].part.headers.len != b[i].part.headers.len {
            return false
        }
    }
    true
}

fn chunked_case(label: str, body: []u8, boundary: str) {
    let whole = gather(body, boundary, multipart.Limits {}) or return
    for step in [1, 2, 3, 5, 7, 64] {
        let r = multipart.reader(feed_reader(body, step), boundary, multipart.Limits {}) or return
        let seen = collect(r) catch {
            e => {
                print("{label} step {step} error {failure(e)}")
                return
            }
        }
        print("{label} step {step} parts {seen.len} same {seen_equal(whole, seen)}")
    }
}

fn tiny_reads() {
    let boundary = boundary_of(embed("requests.ctype"))
    let r = multipart.bytes_reader(bytes(embed("requests.body")), boundary, multipart.Limits {}) or return
    for {
        let part = multipart.next_part(r) or return
        let p = part ?? break
        if p.index != 5 {
            continue
        }
        var out: []u8 = []
        let dst = io.buffer(3)
        for {
            let n = multipart.read(r, dst) or return
            if n == 0 {
                break
            }
            io.append(mut out, dst[..n])
        }
        print("tiny {p.name} {out.len} {same(out, bytes(embed("random.bin")))}")
        print("tiny after end {multipart.read(r, dst) or -1}")
        let empty = io.buffer(0)
        print("tiny empty dst {multipart.read(r, empty) or -1}")
    }
}

fn chunked() {
    chunked_case("requests", bytes(embed("requests.body")), boundary_of(embed("requests.ctype")))
    chunked_case("curl", bytes(embed("curl.body")), boundary_of(embed("curl.ctype")))
    let whole = embed("email.body")
    let at = text.index(whole, "\r\n\r\n")
    chunked_case("email", bytes(whole[at + 4..]), boundary_of(embed("email.ctype")))
    tiny_reads()
}

fn three() -> []u8 {
    msg([
        "--XYZ", disposition("form-data; name=\"a\""), "", "1",
        "--XYZ", disposition("form-data; name=\"b\""), "", "2",
        "--XYZ", disposition("form-data; name=\"c\""), "", "3",
        "--XYZ--", "",
    ])
}

fn outcome(body: []u8, limits: multipart.Limits) -> str {
    let seen = gather(body, "XYZ", limits) catch {
        e => return failure(e)
    }
    "{seen.len} parts"
}

fn limits() {
    print("max_parts 2: {outcome(three(), multipart.Limits { max_parts: 2 })}")
    print("max_parts 3: {outcome(three(), multipart.Limits { max_parts: 3 })}")
    let small = msg(["--XYZ", "X: y", "", "d", "--XYZ--", ""])
    print("header 8: {outcome(small, multipart.Limits { max_header_bytes: 8 })}")
    print("header 7: {outcome(small, multipart.Limits { max_header_bytes: 7 })}")
    let endless = bytes("--XYZ\r\nX: {text.repeat("a", 5000)}")
    print("header unterminated: {outcome(endless, multipart.Limits { max_header_bytes: 100 })}")
    let many = msg(["--XYZ", "A: 1", "B: 2", "C: 3", "", "d", "--XYZ--", ""])
    print("header sum 20: {outcome(many, multipart.Limits { max_header_bytes: 20 })}")
    print("header sum 19: {outcome(many, multipart.Limits { max_header_bytes: 19 })}")
    let body = three()
    print("total {body.len}: {outcome(body, multipart.Limits { max_total_bytes: body.len })}")
    print("total {body.len - 1}: {outcome(body, multipart.Limits { max_total_bytes: body.len - 1 })}")
    let words = msg(["--XYZ", "", "abcd", "--XYZ--", ""])
    let r4 = multipart.bytes_reader(words, "XYZ", multipart.Limits { max_memory: 3 }) or return
    let first = multipart.next_part(r4) or return
    print("memory 3 abcd: {multipart.read_text(r4) catch { e => failure(e) }}")
    let words3 = msg(["--XYZ", "", "abc", "--XYZ--", ""])
    let r3 = multipart.bytes_reader(words3, "XYZ", multipart.Limits { max_memory: 3 }) or return
    let again = multipart.next_part(r3) or return
    print("memory 3 abc: {multipart.read_text(r3) catch { e => failure(e) }}")
    print("after limit error: {outcome(words, multipart.Limits { max_memory: 3 })}")
    spills()
}

struct Sink {
    data: []u8
    finished: []str
}

fn spills() {
    let payload = bytes(embed("random.bin"))
    let body = msg(["--XYZ", disposition("form-data; name=\"f\"; filename=\"f.bin\""), "", str(payload), "--XYZ--", ""])
    let sink = new(Sink { data: [], finished: [] })
    let big = multipart.bytes_reader(body, "XYZ", multipart.Limits { max_memory: 100 }) or return
    let part = multipart.next_part(big) or return
    let result = multipart.read_spill(big, fn(chunk) ! io.Error { io.append(mut sink.data, chunk) }) or return
    print("spill big spilled {result.spilled} size {result.size} held {result.data.len} sunk {sink.data.len} same {same(sink.data, payload)}")

    let held = new(Sink { data: [], finished: [] })
    let little = multipart.bytes_reader(msg(["--XYZ", "", "0123456789", "--XYZ--", ""]), "XYZ", multipart.Limits { max_memory: 100 }) or return
    let p2 = multipart.next_part(little) or return
    let kept = multipart.read_spill(little, fn(chunk) ! io.Error { io.append(mut held.data, chunk) }) or return
    print("spill small spilled {kept.spilled} size {kept.size} held {kept.data.len} sunk {held.data.len}")

    let failing = multipart.bytes_reader(body, "XYZ", multipart.Limits { max_memory: 100 }) or return
    let p3 = multipart.next_part(failing) or return
    let broken = multipart.read_spill(failing, fn(chunk) ! io.Error { fail io.Error.Denied }) catch {
        e => {
            print("spill failing sink {failure(e)}")
            return
        }
    }
    print("spill failing sink returned")
}

fn spill_form() {
    let payload = bytes(embed("random.bin"))
    let writer = multipart.writer_with("BND") or return
    multipart.write_field(writer, "title", "t") or return
    multipart.write_file(writer, "small", "s.txt", "text/plain", bytes("0123456789")) or return
    multipart.write_file(writer, "big", "big.bin", "application/octet-stream", payload) or return
    let body = multipart.finish(writer)
    let sink = new(Sink { data: [], finished: [] })
    let spill = multipart.Spill {
        write: fn(part, chunk) ! io.Error { io.append(mut sink.data, chunk) }
        finish: fn(part, size) ! io.Error { push(mut sink.finished, "{part.name}:{size}") }
    }
    let r = multipart.bytes_reader(body, "BND", multipart.Limits { max_memory: 100 }) or return
    let form = multipart.read_form(r, spill) catch {
        e => {
            print("error {failure(e)}")
            return
        }
    }
    show_form(form)
    let big = multipart.file(form, "big") ?? return
    print("form spill held {big.data.len} sunk {sink.data.len} same {same(sink.data, payload)} finished {text.join(sink.finished, ",")}")
    let small = multipart.file(form, "small") ?? return
    print("form small {text.quote(str(small.data))}")

    let r2 = multipart.bytes_reader(body, "BND", multipart.Limits { max_memory: 100 }) or return
    let refusing = multipart.Spill {
        write: fn(part, chunk) ! io.Error { }
        finish: fn(part, size) ! io.Error { fail io.Error.NoSpace }
    }
    let refused = multipart.read_form(r2, refusing) catch {
        e => {
            print("form failing finish {failure(e)}")
            multipart.Form { fields: [], files: [] }
        }
    }
    let r3 = multipart.bytes_reader(body, "BND", multipart.Limits { max_memory: 100 }) or return
    let unspilled = multipart.read_form(r3, none) catch {
        e => {
            print("form without spill {failure(e)}")
            multipart.Form { fields: [], files: [] }
        }
    }
    print("form without spill files {unspilled.files.len}")
}

fn malformed() {
    let cases = [
        "truncated body|--XYZ\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\nabc"
        "missing closer|--XYZ\r\n\r\nabc\r\n--XYZ\r\n\r\ndef"
        "wrong boundary|--ABC\r\n\r\nabc\r\n--ABC--\r\n"
        "no boundary|just some text\r\nwith lines"
        "empty|"
        "junk after boundary|--XYZ x\r\n\r\nabc\r\n--XYZ--"
        "eof in headers|--XYZ\r\nContent-Disposition: form-data"
        "eof after boundary|--XYZ"
        "no colon|--XYZ\r\nnocolon\r\n\r\nx\r\n--XYZ--"
        "bad name|--XYZ\r\nbad name: v\r\n\r\nx\r\n--XYZ--"
        "bare lf in header|--XYZ\r\nA: b\nC: d\r\n\r\nx\r\n--XYZ--"
        "bare cr in header|--XYZ\r\nA: b\rC: d\r\n\r\nx\r\n--XYZ--"
        "lf only|--XYZ\n\nbody\n--XYZ--"
        "continuation first|--XYZ\r\n folded\r\n\r\nx\r\n--XYZ--"
        "closer only|--XYZ--"
        "closer with epilogue|--XYZ--\r\nnothing here"
        "boundary then eof after dashes|--XYZ-"
    ]
    for c in cases {
        let at = text.index_byte(c, '|')
        dump(c[..at], bytes(c[at + 1..]), "XYZ")
    }
}

fn show_lines(body: []u8) {
    for line in text.split_str(str(body), "\r\n") {
        print("|{line}")
    }
}

fn writing() {
    let w = multipart.writer_with("BND") or return
    multipart.write_field(w, "a", "1") catch {
        e => print("error {failure(e)}")
    }
    multipart.write_field(w, "we\"ird\\n\r\nx", "v\r\nw") catch {
        e => print("error {failure(e)}")
    }
    multipart.write_file(w, "f", "na\"me.txt", "text/plain", bytes("hello")) catch {
        e => print("error {failure(e)}")
    }
    multipart.write_file(w, "g", "", "", []) catch {
        e => print("error {failure(e)}")
    }
    print("boundary {multipart.boundary(w)}")
    print("content type {multipart.content_type(w)}")
    print("content type mixed {multipart.content_type_as(w, "mixed")}")
    let body = multipart.finish(w)
    show_lines(body)
    let again = multipart.finish(w)
    print("finish twice {same(body, again)} {body.len}")
    multipart.write_field(w, "late", "x") catch {
        e => print("write after finish {failure(e)}")
    }
    print("unchanged {multipart.finish(w).len == body.len}")
    show_form(form_of(body, "BND"))
    let g = multipart.file(form_of(body, "BND"), "g") ?? return
    print("g type {g.content_type} size {g.size}")

    let spaced = multipart.writer_with("a b") or return
    print("spaced {multipart.content_type(spaced)}")
    let plain = multipart.writer_with("simple-boundary_1") or return
    print("plain {multipart.content_type(plain)}")
    for bad in ["", "a@b", "trailing ", text.repeat("x", 71)] {
        multipart.writer_with(bad) catch {
            e => {
                print("writer_with {bad.len} {failure(e)}")
                continue
            }
        }
        print("writer_with accepted")
    }

    print("quote {header.quote("plain")}")
    print("quote {header.quote("a\"b")}")
    print("quote {header.quote("a\\b")}")
    print("quote {header.quote("line\r\nbreak")}")
    print("quote {header.quote("")}")
    print("quote {header.quote("é €")}")
}

fn rejections() {
    let w = multipart.writer_with("BND") or return
    multipart.write_field(w, "a", "before--BNDafter") catch {
        e => print("data with boundary {failure(e)}")
    }
    multipart.write_field(w, "a", "before-BND-after") catch {
        e => print("unexpected {failure(e)}")
    }
    let bad_headers = [
        header.Header { name: "Bad Name", value: "v" }
        header.Header { name: "", value: "v" }
        header.Header { name: "X", value: "a\r\nInjected: 1" }
        header.Header { name: "X", value: "a\nb" }
        header.Header { name: "X-Ok", value: "fine" }
    ]
    for h in bad_headers {
        multipart.write_part(w, [h], bytes("d")) catch {
            e => {
                print("header {text.quote(h.name)} {failure(e)}")
                continue
            }
        }
        print("header {text.quote(h.name)} accepted")
    }
    show_lines(multipart.finish(w))

    let random = multipart.writer()
    let other = multipart.writer()
    let id = multipart.boundary(random)
    var hex = true
    for i in 0..id.len {
        let c = id[i]
        if !(c >= '0' && c <= '9' || c >= 'a' && c <= 'f') {
            hex = false
        }
    }
    print("random boundary {id.len} hex {hex} distinct {id != multipart.boundary(other)}")
    print("random content type {multipart.content_type(random) == "multipart/form-data; boundary={id}"}")
    let payload = bytes(embed("random.bin"))
    let sample = bytes(embed("sample.txt"))
    multipart.write_file(random, "blob", "blob.bin", "application/octet-stream", payload) catch {
        e => print("error {failure(e)}")
    }
    multipart.write_file(random, "doc", "doc.txt", "text/plain", sample) catch {
        e => print("error {failure(e)}")
    }
    multipart.write_field(random, "empty", "") catch {
        e => print("error {failure(e)}")
    }
    let body = multipart.finish(random)
    let parsed = form_of(body, id)
    show_form(parsed)
    let blob = multipart.file(parsed, "blob") ?? return
    let doc = multipart.file(parsed, "doc") ?? return
    print("round trip blob {same(blob.data, payload)} doc {same(doc.data, sample)}")
}

fn requests() {
    var req = http.new_request("POST", "/upload")
    let w = multipart.writer_with("BND") or return
    multipart.write_field(w, "title", "from request") catch {
        e => print("error {failure(e)}")
    }
    multipart.write_file(w, "doc", "doc.txt", "text/plain", bytes(embed("sample.txt"))) catch {
        e => print("error {failure(e)}")
    }
    http.set_multipart(mut req, w)
    print("content-type {header.get(req.headers, "content-type") ?? "-"} headers {req.headers.len}")
    let form = http.multipart_form(req, multipart.Limits {}, none) catch {
        e => {
            print("error {failure(e)}")
            return
        }
    }
    show_form(form)
    let r = http.multipart_reader(req, multipart.Limits {}) or return
    let first = multipart.next_part(r) or return
    let p = first ?? return
    print("request reader {p.name} {multipart.read_text(r) catch { e => failure(e) }}")

    http.set_multipart(mut req, multipart.writer_with("TWO") or return)
    print("replaced {header.get(req.headers, "content-type") ?? "-"} headers {req.headers.len} body {req.body.len}")

    var missing = http.new_request("POST", "/upload")
    missing.body = bytes("--BND--")
    http.multipart_form(missing, multipart.Limits {}, none) catch {
        e => {
            print("missing content type {failure(e)}")
            multipart.Form { fields: [], files: [] }
        }
    }
    let kinds = [
        "text/plain"
        "multipart/form-data"
        "multipart/form-data; boundary=\"\""
        "application/x-www-form-urlencoded; boundary=BND"
    ]
    for kind in kinds {
        var typed = http.new_request("POST", "/upload")
        header.set(mut typed.headers, "Content-Type", kind)
        http.multipart_form(typed, multipart.Limits {}, none) catch {
            e => {
                print("content type {text.quote(kind)} {failure(e)}")
                multipart.Form { fields: [], files: [] }
            }
        }
    }

    var captured = http.new_request("POST", "/upload")
    header.set(mut captured.headers, "content-type", embed("requests.ctype"))
    captured.body = bytes(embed("requests.body"))
    let real = http.multipart_form(captured, multipart.Limits {}, none) or return
    show_form(real)
    let limited = http.multipart_form(captured, multipart.Limits { max_parts: 3 }, none) catch {
        e => {
            print("limited {failure(e)}")
            multipart.Form { fields: [], files: [] }
        }
    }
    print("limited fields {limited.fields.len}")
}

fn main() {
    boundaries()
    requests_vector()
    curl_vector()
    email_vector()
    handcrafted()
    params()
    chunked()
    limits()
    spill_form()
    malformed()
    writing()
    rejections()
    requests()
}
