import std/arrow
import std/file
import std/io

fn column(b: arrow.Batch, name: str) -> arrow.Array {
    for k, f in b.schema.fields {
        if f.name == name {
            return b.columns[k]
        }
    }
    panic("no column {name}")
}

fn first_batch(fixture: str) -> arrow.Batch {
    let r = arrow.stream_bytes(find(fixture), arrow.ReaderOptions {}) catch {
        e => panic(arrow.message(e))
    }
    let all = arrow.read_batches(r) catch {
        e => panic(arrow.message(e))
    }
    all[0]
}

fn integer_accessors() {
    let b = first_batch("scalars.arrows")
    let i32s = column(b, "i32")
    expect("int_at min", arrow.int_at(i32s, 0) == -2147483648)
    expect("int_at max", arrow.int_at(i32s, 5) == 2147483647)
    expect("null_count", i32s.null_count == 1)
    expect("is_null", arrow.is_null(i32s, 3) && !arrow.is_valid(i32s, 3))
    expect("is_valid", arrow.is_valid(i32s, 2) && !arrow.is_null(i32s, 2))
    expect("int_at i8", arrow.int_at(column(b, "i8"), 0) == -128)
    expect("int_at i64", arrow.int_at(column(b, "i64"), 0) == -9223372036854775807 - 1)
    expect("uint_at u8", arrow.uint_at(column(b, "u8"), 5) == 255)
    expect("uint_at u64", arrow.uint_at(column(b, "u64"), 5) == 18446744073709551615)
    let flags = column(b, "bool_col")
    expect("bool_at", arrow.bool_at(flags, 0) && !arrow.bool_at(flags, 1) && arrow.bool_at(flags, 5))
    let nothing = column(b, "null_col")
    expect("null array", nothing.null_count == nothing.length && arrow.is_null(nothing, 0))
}

fn float_accessors() {
    let b = first_batch("scalars.arrows")
    let f64s = column(b, "f64")
    expect("float_at f64", arrow.float_at(f64s, 0) == 5e-324 && arrow.float_at(f64s, 5) == 3.141592653589793)
    let f32s = column(b, "f32")
    expect("float_at f32", arrow.float_at(f32s, 0) == 1.5 && arrow.float_at(f32s, 3) == 1.0 / 0.0)
    let nan = arrow.float_at(f32s, 5)
    expect("float_at nan", nan != nan)
    let half = column(b, "f16")
    expect("float_at f16", arrow.float_at(half, 0) == 1.5 && arrow.float_at(half, 3) == 65504.0)
    expect("float_at f16 subnormal", arrow.float_at(half, 4) == 5.960464477539063e-08)
    expect("float_at f16 inf", arrow.float_at(half, 5) == 1.0 / 0.0)
    let more = column(b, "f16b")
    expect("float_at f16 -inf", arrow.float_at(more, 0) == -1.0 / 0.0)
    expect("float_at f16 0.1", arrow.float_at(more, 2) == 0.0999755859375)
}

fn text_accessors() {
    let b = first_batch("scalars.arrows")
    let utf8 = column(b, "utf8")
    expect("str_at", arrow.str_at(utf8, 0) == "héllo" && arrow.str_at(utf8, 2) == "" && arrow.str_at(utf8, 5) == "日本語")
    let large = column(b, "large_utf8")
    expect("str_at large", arrow.str_at(large, 4) == "😀 emoji")
    let binary = column(b, "binary")
    let two = arrow.bytes_at(binary, 2)
    expect("bytes_at", two.len == 2 && two[0] == 0 && two[1] == 255)
    let fixed = column(b, "fsb3")
    expect("bytes_at fixed", arrow.str_at(fixed, 0) == "abc" && arrow.bytes_at(fixed, 4).len == 3)
    let decimal = column(b, "dec10_3")
    expect("decimal_text", arrow.decimal_text(arrow.bytes_at(decimal, 0), 3) == "-12.500")
    expect("decimal_text small", arrow.decimal_text(arrow.bytes_at(decimal, 1), 3) == "0.001")
    let wide = column(b, "dec38_0")
    expect("decimal_text wide", arrow.decimal_text(arrow.bytes_at(wide, 1), 0) == "99999999999999999999999999999999999999")
    let fraction = column(b, "dec5_5")
    expect("decimal_text negative", arrow.decimal_text(arrow.bytes_at(fraction, 2), 5) == "-0.00001")
}

fn nested_accessors() {
    let b = first_batch("nested.arrows")
    let list = column(b, "list_i32")
    let r0 = arrow.list_range(list, 0)
    let r3 = arrow.list_range(list, 3)
    expect("list_range", r0.start == 0 && r0.end == 3 && r3.start == 3 && r3.end == 5)
    expect("list null", arrow.is_null(list, 1))
    expect("list child", arrow.int_at(list.children[0], 1) == 2)
    let fixed = column(b, "fsl_i8")
    let f2 = arrow.list_range(fixed, 2)
    expect("fixed list_range", f2.start == 6 && f2.end == 9)
    let dense = column(b, "dense")
    expect("union_type_id", arrow.union_type_id(dense, 0) == 5 && arrow.union_type_id(dense, 1) == 7)
    let slot = arrow.union_slot(dense, 3)
    expect("dense union_slot", slot.start == 1 && slot.end == 1)
    let sparse = column(b, "sparse")
    let at = arrow.union_slot(sparse, 2)
    expect("sparse union_slot", at.start == 1 && at.end == 2)
    let dictionary = column(b, "dict_str")
    expect("dictionary_index", arrow.dictionary_index(dictionary, 1) == 1 && arrow.dictionary_index(dictionary, 3) == 0)
    expect("dictionary values", arrow.str_at(*(dictionary.dictionary ?? panic("no dictionary")), 1) == "b")
    let wide = column(b, "dict_i64")
    expect("dictionary_index uint8", arrow.dictionary_index(wide, 0) == 2)
}

fn layout() {
    expect("has_validity", arrow.has_validity(arrow.DataType.Int(8, true)) && !arrow.has_validity(arrow.DataType.Null))
    let union = arrow.DataType.Union(arrow.UnionMode.Dense, [], [])
    expect("has_validity union", !arrow.has_validity(union))
    expect("buffer_count", arrow.buffer_count(arrow.DataType.Utf8) == 2 && arrow.buffer_count(arrow.DataType.Null) == 0 && arrow.buffer_count(union) == 2)
    expect("buffer_count sparse", arrow.buffer_count(arrow.DataType.Union(arrow.UnionMode.Sparse, [], [])) == 1)
    expect("buffer_count int", arrow.buffer_count(arrow.DataType.Int(16, true)) == 1)
    expect("value_width", arrow.value_width(arrow.DataType.Int(16, false)) == 2 && arrow.value_width(arrow.DataType.Decimal(5, 2)) == 16)
    expect("value_width temporal", arrow.value_width(arrow.DataType.Time(arrow.TimeUnit.Second)) == 4 && arrow.value_width(arrow.DataType.Time(arrow.TimeUnit.Nanosecond)) == 8)
    expect("value_width date", arrow.value_width(arrow.DataType.Date(arrow.DateUnit.Day)) == 4 && arrow.value_width(arrow.DataType.Date(arrow.DateUnit.Millisecond)) == 8)
    expect("value_width interval", arrow.value_width(arrow.DataType.Interval(arrow.IntervalUnit.MonthDayNano)) == 16 && arrow.value_width(arrow.DataType.Interval(arrow.IntervalUnit.YearMonth)) == 4)
    expect("value_width variable", arrow.value_width(arrow.DataType.Utf8) == 0)
    expect("time_bits", arrow.time_bits(arrow.TimeUnit.Millisecond) == 32 && arrow.time_bits(arrow.TimeUnit.Microsecond) == 64)
    expect("unit_name", arrow.unit_name(arrow.TimeUnit.Second) == "s" && arrow.unit_name(arrow.TimeUnit.Nanosecond) == "ns")
    expect("type_name", arrow.type_name(arrow.DataType.Decimal(10, 3)) == "decimal128(10, 3)")
    expect("children_of", arrow.children_of(arrow.DataType.Int(8, true)).len == 0)
}

fn rejected_types() {
    print("== types")
    print("integer of 12 bits {type_outcome(arrow.DataType.Int(12, true))}")
    print("float of 8 bits {type_outcome(arrow.DataType.Float(8))}")
    print("decimal precision 39 {type_outcome(arrow.DataType.Decimal(39, 0))}")
    print("decimal scale above precision {type_outcome(arrow.DataType.Decimal(4, 5))}")
    print("fixed size binary of -1 {type_outcome(arrow.DataType.FixedSizeBinary(-1))}")
    print("fixed size list of -1 {type_outcome(arrow.DataType.FixedSizeList(item(arrow.DataType.Bool), 0 - 1))}")
    print("union ids and fields differ {type_outcome(arrow.DataType.Union(arrow.UnionMode.Dense, [field("a", arrow.DataType.Bool)], [0, 1]))}")
    print("union id 200 {type_outcome(arrow.DataType.Union(arrow.UnionMode.Dense, [field("a", arrow.DataType.Bool)], [200]))}")
    print("map without a struct {type_outcome(arrow.DataType.Map(item(arrow.DataType.Bool), false))}")
    print("nesting of 100 {type_outcome(nested(100))}")
    print("nesting of 60 {type_outcome(nested(60))}")
}

fn nested(depth: i64) -> arrow.DataType {
    var t = arrow.DataType.Int(32, true)
    for _ in 0..depth {
        t = arrow.DataType.List(item(t))
    }
    t
}

fn type_outcome(t: arrow.DataType) -> str {
    arrow.check_type(t, 0) catch {
        e => return kind(e)
    }
    "accepted"
}

fn append_outcome(t: arrow.DataType, which: i64) -> str {
    let b = arrow.builder(t) catch {
        e => return kind(e)
    }
    match which {
        == 0 => {
            arrow.append_int(b, 128) catch {
                e => return kind(e)
            }
        }
        == 1 => {
            arrow.append_str(b, "x") catch {
                e => return kind(e)
            }
        }
        == 2 => {
            arrow.append_uint(b, 70000) catch {
                e => return kind(e)
            }
        }
        == 3 => {
            arrow.append_decimal(b, "1234") catch {
                e => return kind(e)
            }
        }
        == 4 => {
            arrow.append_decimal(b, "1.2.3") catch {
                e => return kind(e)
            }
        }
        == 5 => {
            arrow.end_list(b) catch {
                e => return kind(e)
            }
        }
        == 6 => {
            arrow.end_struct(b) catch {
                e => return kind(e)
            }
        }
        == 7 => {
            arrow.append_union(b, 9) catch {
                e => return kind(e)
            }
        }
        == 8 => {
            arrow.append_bytes(b, [1, 2]) catch {
                e => return kind(e)
            }
        }
        == 9 => {
            arrow.append_interval(b, 1, 2, 3) catch {
                e => return kind(e)
            }
        }
        _ => {
            arrow.child(b, 3) catch {
                e => return kind(e)
            }
        }
    }
    "accepted"
}

fn builder_errors() {
    print("== builder")
    let i8s = arrow.DataType.Int(8, true)
    print("int 128 in int8 {append_outcome(i8s, 0)}")
    print("text in int8 {append_outcome(i8s, 1)}")
    print("70000 in uint16 {append_outcome(arrow.DataType.Int(16, false), 2)}")
    print("decimal 1234 in decimal(10, 3) {append_outcome(arrow.DataType.Decimal(10, 3), 3)}")
    print("decimal with two points {append_outcome(arrow.DataType.Decimal(10, 3), 4)}")
    print("end_list on int8 {append_outcome(i8s, 5)}")
    print("end_struct on int8 {append_outcome(i8s, 6)}")
    print("append_union on int8 {append_outcome(i8s, 7)}")
    print("bytes of 2 in fixed size binary of 3 {append_outcome(arrow.DataType.FixedSizeBinary(3), 8)}")
    print("interval on int8 {append_outcome(i8s, 9)}")
    print("child 3 of int8 {append_outcome(i8s, 10)}")
    print("end_list without elements {append_outcome(arrow.DataType.FixedSizeList(item(i8s), 2), 5)}")
    print("end_struct with unequal children {append_outcome(arrow.DataType.Struct([field("a", i8s)]), 6)}")
    print("union id 9 {append_outcome(arrow.DataType.Union(arrow.UnionMode.Dense, [field("a", i8s)], [0]), 7)}")
    print("builder_length {builder_state()}")
}

fn builder_state() -> str {
    let b = arrow.builder(arrow.DataType.Int(32, true)) catch {
        e => return kind(e)
    }
    arrow.append_int(b, 1) catch {
        e => return kind(e)
    }
    arrow.append_null(b) catch {
        e => return kind(e)
    }
    let t = arrow.type_name(arrow.builder_type(b))
    "{arrow.builder_length(b)} {t}"
}

fn corrupt(a: arrow.Array, change: i64) -> arrow.Array {
    match change {
        == 0 => arrow.Array { data_type: a.data_type, length: a.length + 1, null_count: a.null_count, validity: a.validity, buffers: a.buffers, children: a.children, dictionary: a.dictionary }
        == 1 => arrow.Array { data_type: a.data_type, length: a.length, null_count: a.null_count + 1, validity: a.validity, buffers: a.buffers, children: a.children, dictionary: a.dictionary }
        == 2 => arrow.Array { data_type: a.data_type, length: a.length, null_count: a.null_count, validity: a.validity, buffers: [], children: a.children, dictionary: a.dictionary }
        == 3 => arrow.Array { data_type: a.data_type, length: a.length, null_count: a.null_count, validity: a.validity, buffers: a.buffers, children: [], dictionary: a.dictionary }
        == 4 => arrow.Array { data_type: a.data_type, length: a.length, null_count: a.null_count, validity: [], buffers: a.buffers, children: a.children, dictionary: a.dictionary }
        _ => arrow.Array { data_type: a.data_type, length: a.length, null_count: a.null_count, validity: a.validity, buffers: a.buffers, children: a.children, dictionary: none }
    }
}

fn validate_outcome(a: arrow.Array) -> str {
    arrow.validate(a) catch {
        e => return kind(e)
    }
    "accepted"
}

fn offsets_outcome(change: i64) -> str {
    let b = first_batch("nested.arrows")
    let list = column(b, "list_i32")
    var offsets: u8[] = []
    io.append(mut offsets, list.buffers[0])
    match change {
        == 0 => io.set_le32(offsets, 4, 99)
        == 1 => io.set_le32(offsets, 4, 0 - 1)
        _ => io.set_le32(offsets, 0, 1)
    }
    validate_outcome(arrow.Array { data_type: list.data_type, length: list.length, null_count: list.null_count, validity: list.validity, buffers: [offsets], children: list.children, dictionary: list.dictionary })
}

fn validation() {
    print("== validate")
    let b = first_batch("nested.arrows")
    let ints = column(b, "list_i32")
    print("valid list {validate_outcome(ints)}")
    print("length past the offsets {validate_outcome(corrupt(ints, 0))}")
    print("null count above the nulls {validate_outcome(corrupt(ints, 1))}")
    print("no offsets buffer {validate_outcome(corrupt(ints, 2))}")
    print("no child {validate_outcome(corrupt(ints, 3))}")
    print("nulls without a bitmap {validate_outcome(corrupt(ints, 4))}")
    print("offset past the child {offsets_outcome(0)}")
    print("negative offset {offsets_outcome(1)}")
    print("first offset 1 {offsets_outcome(2)}")
    let d = column(b, "dict_str")
    print("dictionary without values {validate_outcome(corrupt(d, 5))}")
}

fn reader_options() {
    print("== limits")
    let data = find("wide_zstd.arrows")
    print("metadata limit {limit_outcome(data, 16, 1048576)}")
    print("body limit {limit_outcome(data, 1048576, 16)}")
    print("both limits {limit_outcome(data, 1048576, 1048576)}")
}

fn limit_outcome(data: u8[], metadata: i64, body: i64) -> str {
    let options = arrow.ReaderOptions { max_metadata: metadata, max_body: body }
    let r = arrow.stream_bytes(data, options) catch {
        e => return kind(e)
    }
    arrow.read_batches(r) catch {
        e => return kind(e)
    }
    "accepted"
}

fn one_at_a_time() {
    let r = arrow.stream_bytes(find("sweep.arrows"), arrow.ReaderOptions {}) catch {
        e => {
            print("FAIL next_batch open {arrow.message(e)}")
            return
        }
    }
    var count = 0
    for true {
        let next = arrow.next_batch(r) catch {
            e => {
                print("FAIL next_batch {arrow.message(e)}")
                return
            }
        }
        match next {
            some(b) => {
                expect("next_batch rows", b.length == 3)
                count += 1
            }
            none => break
        }
    }
    expect("next_batch count", count == 2)
    let again = arrow.next_batch(r) catch {
        e => {
            print("FAIL next_batch after the end {arrow.message(e)}")
            return
        }
    }
    match again {
        some(_) => print("FAIL next_batch after the end")
        none => {}
    }
}

fn files_on_disk() {
    let dir = file.temp_dir("arrow") catch {
        e => {
            print("FAIL temp dir")
            return
        }
    }
    let path = "{dir}/sweep.arrow"
    file.write_file(path, find("sweep.arrow")) catch {
        e => {
            print("FAIL write")
            return
        }
    }
    let f = arrow.open_file(path, arrow.ReaderOptions {}) catch {
        e => {
            print("FAIL open_file {arrow.message(e)}")
            return
        }
    }
    expect("open_file batches", arrow.batch_count(f) == 2)
    let missing = arrow.open_file("{dir}/absent.arrow", arrow.ReaderOptions {}) catch {
        e => {
            print("missing file {kind(e)}")
            file.remove_all(dir) catch {
                _ => print("FAIL cleanup")
            }
            return
        }
    }
    print("FAIL missing file opened {arrow.batch_count(missing)}")
}

fn api() {
    integer_accessors()
    float_accessors()
    text_accessors()
    nested_accessors()
    layout()
    one_at_a_time()
    files_on_disk()
    rejected_types()
    builder_errors()
    validation()
    reader_options()
}
