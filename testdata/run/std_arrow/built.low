import std/arrow

fn field(name: str, t: arrow.DataType) -> arrow.Field {
    arrow.Field { name, data_type: t }
}

fn item(t: arrow.DataType) -> *arrow.Field {
    new(field("item", t))
}

fn int32() -> arrow.DataType {
    arrow.DataType.Int(32, true)
}

fn schema_fields() -> []arrow.Field {
    let tagged = arrow.Field { name: "i", data_type: int32(), metadata: ["unit": "count"] }
    let entries = arrow.Field { name: "entries", data_type: arrow.DataType.Struct([
        arrow.Field { name: "key", data_type: arrow.DataType.Utf8, nullable: false },
        field("value", int32()),
    ]), nullable: false }
    [
        field("b", arrow.DataType.Bool),
        tagged,
        field("u16", arrow.DataType.Int(16, false)),
        field("u64", arrow.DataType.Int(64, false)),
        field("f16", arrow.DataType.Float(16)),
        field("f32", arrow.DataType.Float(32)),
        field("f64", arrow.DataType.Float(64)),
        field("s", arrow.DataType.Utf8),
        field("ls", arrow.DataType.LargeUtf8),
        field("bin", arrow.DataType.Binary),
        field("fsb3", arrow.DataType.FixedSizeBinary(3)),
        field("dec", arrow.DataType.Decimal(10, 3)),
        field("date", arrow.DataType.Date(arrow.DateUnit.Day)),
        field("ts", arrow.DataType.Timestamp(arrow.TimeUnit.Microsecond, "UTC")),
        field("iv", arrow.DataType.Interval(arrow.IntervalUnit.MonthDayNano)),
        field("nulls", arrow.DataType.Null),
        field("l", arrow.DataType.List(item(int32()))),
        field("fsl", arrow.DataType.FixedSizeList(item(arrow.DataType.Int(8, true)), 2)),
        field("st", arrow.DataType.Struct([field("x", int32()), field("y", arrow.DataType.Utf8)])),
        field("map", arrow.DataType.Map(new(entries), false)),
        field("dense", arrow.DataType.Union(arrow.UnionMode.Dense, [field("i", int32()), field("s", arrow.DataType.Utf8)], [5, 7])),
        field("sparse", arrow.DataType.Union(arrow.UnionMode.Sparse, [field("n", int32()), field("t", arrow.DataType.Utf8)], [0, 1])),
        field("d", arrow.DataType.Dictionary(0, new(arrow.DataType.Int(8, true)), new(arrow.DataType.Utf8), false)),
    ]
}

pub fn built_schema() -> arrow.Schema {
    arrow.Schema { fields: schema_fields(), metadata: ["made": "builder"] }
}

fn builder_for(k: i64) -> *arrow.Builder ! arrow.Error {
    arrow.builder(built_schema().fields[k].data_type)
}

fn bools() -> arrow.Array ! arrow.Error {
    let b = builder_for(0)?
    arrow.append_bool(b, true)?
    arrow.append_null(b)?
    arrow.append_bool(b, false)?
    arrow.finish(b)?
}

fn small_ints() -> arrow.Array ! arrow.Error {
    let b = builder_for(1)?
    arrow.append_int(b, 1)?
    arrow.append_null(b)?
    arrow.append_int(b, -3)?
    arrow.finish(b)?
}

fn unsigned16() -> arrow.Array ! arrow.Error {
    let b = builder_for(2)?
    arrow.append_uint(b, 0)?
    arrow.append_uint(b, 65535)?
    arrow.append_null(b)?
    arrow.finish(b)?
}

fn unsigned64() -> arrow.Array ! arrow.Error {
    let b = builder_for(3)?
    arrow.append_uint(b, 18446744073709551615)?
    arrow.append_null(b)?
    arrow.append_uint(b, 1)?
    arrow.finish(b)?
}

fn floats(k: i64, a: f64, c: f64) -> arrow.Array ! arrow.Error {
    let b = builder_for(k)?
    arrow.append_float(b, a)?
    arrow.append_null(b)?
    arrow.append_float(b, c)?
    arrow.finish(b)?
}

fn texts(k: i64) -> arrow.Array ! arrow.Error {
    let b = builder_for(k)?
    arrow.append_str(b, "a")?
    arrow.append_null(b)?
    arrow.append_str(b, "héllo")?
    arrow.finish(b)?
}

fn blobs() -> arrow.Array ! arrow.Error {
    let b = builder_for(9)?
    arrow.append_bytes(b, [0, 255])?
    arrow.append_null(b)?
    arrow.append_bytes(b, [])?
    arrow.finish(b)?
}

fn fixed() -> arrow.Array ! arrow.Error {
    let b = builder_for(10)?
    arrow.append_bytes(b, bytes("abc"))?
    arrow.append_null(b)?
    arrow.append_bytes(b, bytes("xyz"))?
    arrow.finish(b)?
}

fn decimals() -> arrow.Array ! arrow.Error {
    let b = builder_for(11)?
    arrow.append_decimal(b, "-12.500")?
    arrow.append_null(b)?
    arrow.append_decimal(b, "0.001")?
    arrow.finish(b)?
}

fn dates() -> arrow.Array ! arrow.Error {
    let b = builder_for(12)?
    arrow.append_int(b, 19000)?
    arrow.append_null(b)?
    arrow.append_int(b, -1)?
    arrow.finish(b)?
}

fn timestamps() -> arrow.Array ! arrow.Error {
    let b = builder_for(13)?
    arrow.append_int(b, 1700000000)?
    arrow.append_null(b)?
    arrow.append_int(b, -1)?
    arrow.finish(b)?
}

fn intervals() -> arrow.Array ! arrow.Error {
    let b = builder_for(14)?
    arrow.append_interval(b, 1, 2, 3)?
    arrow.append_null(b)?
    arrow.append_interval(b, -1, -2, -3)?
    arrow.finish(b)?
}

fn nulls() -> arrow.Array ! arrow.Error {
    let b = builder_for(15)?
    arrow.append_null(b)?
    arrow.append_null(b)?
    arrow.append_null(b)?
    arrow.finish(b)?
}

fn lists() -> arrow.Array ! arrow.Error {
    let b = builder_for(16)?
    let kid = arrow.child(b, 0)?
    arrow.append_int(kid, 1)?
    arrow.append_int(kid, 2)?
    arrow.end_list(b)?
    arrow.append_null(b)?
    arrow.end_list(b)?
    arrow.finish(b)?
}

fn fixed_lists() -> arrow.Array ! arrow.Error {
    let b = builder_for(17)?
    let kid = arrow.child(b, 0)?
    arrow.append_int(kid, 1)?
    arrow.append_int(kid, 2)?
    arrow.end_list(b)?
    arrow.append_null(b)?
    arrow.append_int(kid, 3)?
    arrow.append_int(kid, 4)?
    arrow.end_list(b)?
    arrow.finish(b)?
}

fn structs() -> arrow.Array ! arrow.Error {
    let b = builder_for(18)?
    let x = arrow.child(b, 0)?
    let y = arrow.child(b, 1)?
    arrow.append_int(x, 1)?
    arrow.append_str(y, "p")?
    arrow.end_struct(b)?
    arrow.append_null(b)?
    arrow.append_null(x)?
    arrow.append_str(y, "q")?
    arrow.end_struct(b)?
    arrow.finish(b)?
}

fn maps() -> arrow.Array ! arrow.Error {
    let b = builder_for(19)?
    let entries = arrow.child(b, 0)?
    let key = arrow.child(entries, 0)?
    let value = arrow.child(entries, 1)?
    arrow.append_str(key, "a")?
    arrow.append_int(value, 1)?
    arrow.end_struct(entries)?
    arrow.append_str(key, "b")?
    arrow.append_null(value)?
    arrow.end_struct(entries)?
    arrow.end_list(b)?
    arrow.append_null(b)?
    arrow.end_list(b)?
    arrow.finish(b)?
}

fn dense() -> arrow.Array ! arrow.Error {
    let b = builder_for(20)?
    let first = arrow.append_union(b, 5)?
    arrow.append_int(first, 1)?
    let second = arrow.append_union(b, 7)?
    arrow.append_str(second, "z")?
    let third = arrow.append_union(b, 5)?
    arrow.append_null(third)?
    arrow.finish(b)?
}

fn sparse() -> arrow.Array ! arrow.Error {
    let b = builder_for(21)?
    let first = arrow.append_union(b, 1)?
    arrow.append_str(first, "a")?
    let second = arrow.append_union(b, 0)?
    arrow.append_int(second, 20)?
    let third = arrow.append_union(b, 1)?
    arrow.append_null(third)?
    arrow.finish(b)?
}

fn dictionaries() -> arrow.Array ! arrow.Error {
    let b = builder_for(22)?
    arrow.append_str(b, "a")?
    arrow.append_str(b, "b")?
    arrow.append_null(b)?
    arrow.finish(b)?
}

pub fn built_batch() -> arrow.Batch ! arrow.Error {
    let columns = [
        bools()?, small_ints()?, unsigned16()?, unsigned64()?,
        floats(4, 1.5, 65504.0)?, floats(5, 1.5, 1.0 / 0.0)?, floats(6, 1.5, -0.0)?,
        texts(7)?, texts(8)?, blobs()?, fixed()?, decimals()?, dates()?, timestamps()?, intervals()?, nulls()?,
        lists()?, fixed_lists()?, structs()?, maps()?, dense()?, sparse()?, dictionaries()?,
    ]
    arrow.Batch { schema: built_schema(), length: 3, columns }
}
