import std/arrow
import std/text

fn expect(label: str, ok: bool) {
    if !ok {
        print("FAIL {label}")
    }
}

fn kind(e: arrow.Error) -> str {
    match e {
        Invalid(_, _) => "Invalid"
        Truncated(_) => "Truncated"
        TooLarge(_) => "TooLarge"
        Unsupported(_) => "Unsupported"
        Mismatch(_) => "Mismatch"
        Io(_) => "Io"
    }
}

fn hex(data: u8[]) -> str {
    text.encode_hex(data)
}

fn sorted_keys(m: [str: str]) -> str[] {
    var keys: str[] = []
    for k in m {
        var at = keys.len
        keys.push(k)
        for at > 0 && keys[at - 1] > k {
            keys[at] = keys[at - 1]
            at -= 1
        }
        keys[at] = k
    }
    keys
}

fn meta_text(m: [str: str]) -> str {
    if m.len == 0 {
        return ""
    }
    var parts: str[] = []
    for k in sorted_keys(m) {
        parts.push("{k}={m[k] ?? ""}")
    }
    " meta {text.join(parts, ",")}"
}

fn find(name: str) -> u8[] {
    for f in fixtures() {
        if f.name == name {
            return f.data
        }
    }
    for f in extras() {
        if f.name == name {
            return f.data
        }
    }
    panic("no fixture {name}")
}
