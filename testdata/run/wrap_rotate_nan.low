fn bump(x: f64) -> f64 {
    x * 1.5 + 0.25
}

fn below(start: f64, limit: f64) -> i64 {
    var x = start
    var n = 0
    for x * 1.5 < limit {
        x = x + 1.0
        n += 1
    }
    n
}

fn below_equal(start: f64, limit: f64) -> i64 {
    var x = start
    var n = 0
    for x * 1.5 <= limit {
        x = x + 1.0
        n += 1
    }
    n
}

fn above(start: f64, limit: f64) -> i64 {
    var x = start
    var n = 0
    for x * 1.5 > limit {
        x = x - 1.0
        n += 1
    }
    n
}

fn above_equal(start: f64, limit: f64) -> i64 {
    var x = start
    var n = 0
    for x * 1.5 >= limit {
        x = x - 1.0
        n += 1
    }
    n
}

fn equal(start: f64, limit: f64) -> i64 {
    var x = start
    var n = 0
    for x * 1.0 == limit && n < 5 {
        n += 1
    }
    n
}

fn unequal(start: f64, limit: f64) -> i64 {
    var x = start
    var n = 0
    for x * 1.0 != limit && n < 5 {
        n += 1
    }
    n
}

fn negated(start: f64, limit: f64) -> i64 {
    var x = start
    var n = 0
    for !(x * 1.5 < limit) && n < 5 {
        n += 1
    }
    n
}

fn called(start: f64, limit: f64) -> i64 {
    var x = start
    var n = 0
    for bump(x) < limit {
        x = x + 1.0
        n += 1
    }
    n
}

fn called_negated(start: f64, limit: f64) -> i64 {
    var x = start
    var n = 0
    for !(bump(x) >= limit) && n < 8 {
        x = x + 1.0
        n += 1
    }
    n
}

fn report(start: f64, limit: f64) {
    print(below(start, limit))
    print(below_equal(start, limit))
    print(above(start, limit))
    print(above_equal(start, limit))
    print(equal(start, limit))
    print(unequal(start, limit))
    print(negated(start, limit))
    print(called(start, limit))
    print(called_negated(start, limit))
}

fn main() {
    let zero = f64(0)
    let nan = zero / zero
    report(0.0, 10.0)
    report(20.0, 10.0)
    report(nan, 10.0)
    report(0.0, nan)
    report(nan, nan)
}
