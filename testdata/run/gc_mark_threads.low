import std/file
import std/os
import std/text

struct Tree {
    left: *Tree?
    right: *Tree?
}

fn make(depth: i64) -> *Tree {
    if depth == 0 {
        new(Tree { left: none, right: none })
    } else {
        new(Tree { left: make(depth - 1), right: make(depth - 1) })
    }
}

fn count(t: *Tree?) -> i64 {
    match t {
        some(n) => 1 + count(n.left) + count(n.right)
        none => 0
    }
}

fn os_threads() -> i64 {
    let status = file.read_text("/proc/self/status") or return 0
    for line in text.split(status, 10) {
        let c = text.cut(line, ":")
        if c.found && c.before == "Threads" {
            return text.parse_int(text.trim(c.after)) or 0
        }
    }
    0
}

fn main() {
    let kept = make(19)
    var sum = 0
    for i in 0..3000000 {
        let garbage = [i, i + 1, i + 2, i + 3]
        sum += garbage[i % 4]
    }
    let wanted = if os.cpu_count() < 16 { os.cpu_count() } else { 16 }
    let threads = os_threads()
    print("kept {count(some(kept))} {sum > 0}")
    print("mark threads: {threads == 0 || threads >= wanted}")
}
