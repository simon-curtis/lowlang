pub struct Labelled[T] {
    pub label: str
    pub value: T
}

pub enum Maybe[T] {
    Just(T)
    Nothing
}

pub fn label[T](value: T, name: str) -> Labelled[T] {
    Labelled { label: name, value }
}

pub fn largest[T: Ord](xs: []T) -> T? {
    var best: T? = none
    for x in xs {
        if x >= (best ?? x) {
            best = x
        }
    }
    best
}

pub struct Config {
    pub name: str = "geo"
    secret: i64 = hidden()
}

fn hidden() -> i64 {
    7
}

pub fn secret_of(c: Config) -> i64 {
    c.secret
}
