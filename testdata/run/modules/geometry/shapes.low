pub struct Point {
    pub x: i64
    pub y: i64
}

pub struct Circle {
    radius: i64
}

pub enum Shape {
    Square(i64)
    Dot
}

pub fn circle(r: i64) -> Circle {
    Circle { radius: r }
}

pub fn shift(p: Point) -> Point {
    Point { x: p.x + offset(), y: p.y + offset() }
}

fn offset() -> i64 {
    100
}
