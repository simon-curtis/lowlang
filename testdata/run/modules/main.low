import geometry
import t = ui/text

fn main() {
    let c = geometry.circle(2)
    print(geometry.area(c))
    let s: geometry.Shape = Square(3)
    print(geometry.describe(s))
    match s {
        Square(n) => print(n)
        Dot => print(0)
    }
    print(geometry.describe(geometry.Shape.Dot))
    let p = geometry.Point { x: 1, y: 2 }
    var q = geometry.shift(p)
    q.x += 10
    print(q.x + q.y)
    print(t.shout("hi"))
    print(helper())
    let l = geometry.label(5, "five")
    print("{l.label} {l.value}")
    let m: geometry.Maybe[str] = geometry.Maybe.Just("yes")
    match m {
        Just(v) => print(v)
        Nothing => print("no")
    }
    print(geometry.largest([3, 7, 2]) ?? 0)
    let typed = geometry.Labelled[i64] { label: "t", value: 1 }
    print(typed.value)
}
