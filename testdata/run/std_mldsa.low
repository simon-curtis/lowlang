import std/crypto/hash
import std/crypto/mldsa
import std/crypto/prehash
import std/io
import std/slices
import std/text

fn unhex(s: str) -> u8[] {
    if s == "-" {
        return []
    }
    text.decode_hex(s) or []
}

fn level_of(s: str) -> mldsa.Level {
    match s {
        "44" => Dsa44
        "65" => Dsa65
        _ => Dsa87
    }
}

fn hash_of(s: str) -> prehash.Hash {
    match s {
        "sha224" => Sha224
        "sha256" => Sha256
        "sha384" => Sha384
        "sha512" => Sha512
        "sha512_224" => Sha512_224
        "sha512_256" => Sha512_256
        "sha3_224" => Sha3_224
        "sha3_256" => Sha3_256
        "sha3_384" => Sha3_384
        "sha3_512" => Sha3_512
        "shake128" => Shake128
        _ => Shake256
    }
}

fn digest_hex(b: u8[]) -> str {
    text.encode_hex(hash.sum(hash.sha256(), b))
}

fn randomness_of(s: str) -> mldsa.Randomness {
    if s == "-" {
        return Deterministic
    }
    Given(unhex(s))
}

fn verdict(label: str, ok: bool) {
    let word = if ok { "ok" } else { "FAIL" }
    print("{label}: {word}")
}

fn keygen(f: str[], n: i64) {
    let keys = mldsa.generate_seeded(level_of(f[1]), unhex(f[2])) or return
    let ok = digest_hex(keys.public) == f[3] && digest_hex(keys.private) == f[4]
    verdict("keygen {f[1]} {n}", ok)
}

fn sign_vector(f: str[]) -> u8[] ! io.Error {
    let lv = level_of(f[2])
    let rnd = randomness_of(f[3])
    let sk = unhex(f[4])
    match f[1] {
        "pure" => mldsa.sign(lv, sk, unhex(f[5]), unhex(f[6]), rnd)
        "prehash" => mldsa.sign_prehash(lv, sk, unhex(f[5]), unhex(f[6]), hash_of(f[7]), rnd)
        "internal" => mldsa.sign_internal(lv, sk, unhex(f[5]), rnd)
        _ => mldsa.sign_mu(lv, sk, unhex(f[5]), rnd)
    }
}

fn siggen(f: str[], n: i64) {
    let sig = sign_vector(f) or return
    verdict("siggen {f[1]} {f[2]} {f[7]} {n}", digest_hex(sig) == f[8])
}

fn verify_vector(f: str[]) -> bool {
    let lv = level_of(f[2])
    let pk = unhex(f[3])
    let sig = unhex(f[7])
    match f[1] {
        "pure" => mldsa.verify(lv, pk, unhex(f[4]), unhex(f[5]), sig)
        "prehash" => mldsa.verify_prehash(lv, pk, unhex(f[4]), unhex(f[5]), hash_of(f[6]), sig)
        "internal" => mldsa.verify_internal(lv, pk, unhex(f[4]), sig)
        _ => mldsa.verify_mu(lv, pk, unhex(f[4]), sig)
    }
}

fn sigver(f: str[], n: i64) {
    let expected = f[8] == "1"
    verdict("sigver {f[1]} {f[2]} expect {expected} {n}", verify_vector(f) == expected)
}

fn seeded(f: str[], n: i64) {
    let lv = level_of(f[1])
    let keys = mldsa.generate_seeded(lv, unhex(f[2])) or return
    let sig = mldsa.sign(lv, keys.private, unhex(f[3]), unhex(f[4]), Deterministic) or return
    let ok = digest_hex(keys.public) == f[5] && digest_hex(sig) == f[6]
    verdict("openssl {f[1]} {n}", ok)
}

fn vectors() {
    var n = 0
    for line in text.lines(embed("std_mldsa_vectors.txt")) {
        let f = text.fields(line)
        n += 1
        match f[0] {
            "keygen" => keygen(f, n)
            "siggen" => siggen(f, n)
            "sigver" => sigver(f, n)
            _ => seeded(f, n)
        }
    }
}

fn seed32() -> u8[] {
    var out: u8[] = []
    for i in 0..32 {
        out.push(u8(i * 7 + 3))
    }
    out
}

fn flipped(b: u8[], at: i64) -> u8[] {
    let c = slices.clone(b)
    c[at] ^= u8(1 << (at & 7))
    c
}

fn corrupt_signature(lv: mldsa.Level, name: str) {
    let keys = mldsa.generate_seeded(lv, seed32()) or return
    let message = bytes("corruption")
    let context = bytes("ctx")
    let sig = mldsa.sign(lv, keys.private, message, context, Deterministic) or return
    verdict("{name} signature verifies", mldsa.verify(lv, keys.public, message, context, sig))
    var accepted = 0
    for i in 0..sig.len {
        if mldsa.verify(lv, keys.public, message, context, flipped(sig, i)) {
            accepted += 1
        }
    }
    print("{name} signature single-bit corruptions accepted: {accepted} of {sig.len}")
    accepted = 0
    for i in 0..keys.public.len {
        if mldsa.verify(lv, flipped(keys.public, i), message, context, sig) {
            accepted += 1
        }
    }
    print("{name} public key single-bit corruptions accepted: {accepted} of {keys.public.len}")
    verdict("{name} truncated signature", !mldsa.verify(lv, keys.public, message, context, sig[..sig.len - 1]))
    verdict("{name} empty signature", !mldsa.verify(lv, keys.public, message, context, []))
    var extended = slices.clone(sig)
    extended.push(0)
    verdict("{name} extended signature", !mldsa.verify(lv, keys.public, message, context, extended))
    verdict("{name} truncated public key", !mldsa.verify(lv, keys.public[..keys.public.len - 1], message, context, sig))
    verdict("{name} other message", !mldsa.verify(lv, keys.public, bytes("corruptiom"), context, sig))
    verdict("{name} other context", !mldsa.verify(lv, keys.public, message, bytes("cty"), sig))
    verdict("{name} pure signature is not a pre-hash signature", !mldsa.verify_prehash(lv, keys.public, message, context, Sha512, sig))
}

fn outcome(lv: mldsa.Level, keys: mldsa.Keys, message: u8[], private: u8[]) -> str {
    let sig = mldsa.sign(lv, private, message, [], Deterministic) catch {
        Invalid => return "invalid"
        _ => return "other"
    }
    if mldsa.verify(lv, keys.public, message, [], sig) {
        return "verifies"
    }
    "rejected"
}

fn region(lv: mldsa.Level, keys: mldsa.Keys, from: i64, to: i64, step: i64) -> i64[] {
    let message = bytes("private key corruption")
    var counts: [str: i64] = [:]
    var at = from
    for at < to {
        let word = outcome(lv, keys, message, flipped(keys.private, at))
        counts[word] += 1
        at += step
    }
    [(counts["invalid"] ?? 0) + (counts["rejected"] ?? 0), counts["verifies"] ?? 0]
}

fn corrupt_private(lv: mldsa.Level, name: str) {
    let keys = mldsa.generate_seeded(lv, seed32()) or return
    let eta_len = match lv {
        Dsa65 => 128
        _ => 96
    }
    let l = match lv {
        Dsa44 => 4
        Dsa65 => 5
        Dsa87 => 7
    }
    let rho = region(lv, keys, 0, 32, 1)
    let key = region(lv, keys, 32, 64, 1)
    let tr = region(lv, keys, 64, 128, 1)
    let s1 = region(lv, keys, 128, 128 + eta_len * l, 5)
    let rest = region(lv, keys, 128 + eta_len * l, keys.private.len, 29)
    verdict("{name} private key rho flips never verify", rho[0] == 32 && rho[1] == 0)
    verdict("{name} private key K flips still verify", key[0] == 0 && key[1] == 32)
    verdict("{name} private key tr flips never verify", tr[0] == 64 && tr[1] == 0)
    verdict("{name} private key s1 flips never verify", s1[1] == 0 && s1[0] > 0)
    print("{name} private key s2 and t0 flips rejected {rest[0]} verified {rest[1]}")
    verdict("{name} truncated private key", outcome(lv, keys, bytes("m"), keys.private[..keys.private.len - 1]) == "invalid")
}

fn sign_fails(lv: mldsa.Level, sk: u8[], message: u8[], context: u8[], rnd: mldsa.Randomness) -> bool {
    mldsa.sign(lv, sk, message, context, rnd) catch {
        Invalid => return true
        _ => return false
    }
    false
}

fn seed_fails(lv: mldsa.Level, seed: u8[]) -> bool {
    mldsa.generate_seeded(lv, seed) catch {
        Invalid => return true
        _ => return false
    }
    false
}

fn shapes(lv: mldsa.Level, name: str) {
    let keys = mldsa.generate_seeded(lv, seed32()) or return
    let again = mldsa.generate_seeded(lv, seed32()) or return
    verdict("{name} seed is reproducible", hash.equal(keys.private, again.private) && hash.equal(keys.public, again.public))
    verdict("{name} seed is kept", hash.equal(keys.seed, seed32()))
    let fresh = mldsa.generate(lv)
    let fresh_signature = mldsa.sign(lv, fresh.private, bytes("fresh"), [], Hedged) or return
    verdict("{name} generated key signs", mldsa.verify(lv, fresh.public, bytes("fresh"), [], fresh_signature))
    verdict("{name} generated keys differ", !hash.equal(fresh.public, keys.public))
    print("{name} sizes {keys.public.len} {keys.private.len} {mldsa.public_key_size(lv)} {mldsa.private_key_size(lv)} {mldsa.signature_size(lv)}")
    let message = bytes("message")
    let a = mldsa.sign(lv, keys.private, message, [], Deterministic) or return
    let b = mldsa.sign(lv, keys.private, message, [], Deterministic) or return
    verdict("{name} deterministic signing repeats", hash.equal(a, b))
    let c = mldsa.sign(lv, keys.private, message, [], Hedged) or return
    let d = mldsa.sign(lv, keys.private, message, [], Hedged) or return
    verdict("{name} hedged signing differs", !hash.equal(c, d) && !hash.equal(c, a))
    verdict("{name} hedged signatures verify", mldsa.verify(lv, keys.public, message, [], c) && mldsa.verify(lv, keys.public, message, [], d))
    verdict("{name} signature length", a.len == mldsa.signature_size(lv))
    let long = slices.repeat([u8(7)], 255)
    let longer = slices.repeat([u8(7)], 256)
    let at_limit = mldsa.sign(lv, keys.private, message, long, Deterministic) or return
    verdict("{name} context of 255 bytes", mldsa.verify(lv, keys.public, message, long, at_limit))
    verdict("{name} context of 256 bytes cannot be signed", sign_fails(lv, keys.private, message, longer, Deterministic))
    verdict("{name} context of 256 bytes does not verify", !mldsa.verify(lv, keys.public, message, longer, at_limit))
    let short = slices.repeat([u8(1)], 31)
    verdict("{name} short seed", seed_fails(lv, short))
    verdict("{name} short randomness", sign_fails(lv, keys.private, message, [], Given(short)))
    verdict("{name} short private key", sign_fails(lv, keys.private[..10], message, [], Deterministic))
    let ph = mldsa.sign_prehash(lv, keys.private, message, [], Sha256, Hedged) or return
    verdict("{name} pre-hash signature", mldsa.verify_prehash(lv, keys.public, message, [], Sha256, ph))
    verdict("{name} pre-hash with another hash", !mldsa.verify_prehash(lv, keys.public, message, [], Sha512, ph))
    verdict("{name} pre-hash signature is not a pure signature", !mldsa.verify(lv, keys.public, message, [], ph))
    let mu = mldsa.message_representative(lv, keys.public, message, bytes("c")) or return
    let by_mu = mldsa.sign_mu(lv, keys.private, mu, Deterministic) or return
    let by_message = mldsa.sign(lv, keys.private, message, bytes("c"), Deterministic) or return
    verdict("{name} external mu equals the pure signature", hash.equal(by_mu, by_message))
    verdict("{name} external mu verifies", mldsa.verify_mu(lv, keys.public, mu, by_mu))
    let wrong_level = match lv {
        Dsa44 => mldsa.Level.Dsa65
        _ => mldsa.Level.Dsa44
    }
    verdict("{name} other level", !mldsa.verify(wrong_level, keys.public, message, [], a))
}

fn main() {
    vectors()
    for lv in [mldsa.Level.Dsa44, Dsa65, Dsa87] {
        let name = match lv {
            Dsa44 => "ML-DSA-44"
            Dsa65 => "ML-DSA-65"
            Dsa87 => "ML-DSA-87"
        }
        shapes(lv, name)
        corrupt_signature(lv, name)
        corrupt_private(lv, name)
    }
}
