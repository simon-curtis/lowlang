import std/protobuf
import std/serde
import std/text

enum Color {
    Unspecified = 0
    Red = 1
    Green = 2
    Neg = -3
}

struct Inner {
    a: i32 "1"
    b: str "2"
    c: []i32 "3"
}

enum Choice {
    Num(value: i32) = 30
    Word(value: str) = 31
    Node(value: Inner) = 32
}

struct Scalars {
    i32: i32 "1"
    i64: i64 "2"
    u32: u32 "3"
    u64: u64 "4"
    s32: i32 "5,sint"
    s64: i64 "6,sint"
    f32: u32 "7,fixed"
    f64: u64 "8,fixed"
    sf32: i32 "9,fixed"
    sf64: i64 "10,fixed"
    fl: f32 "11"
    db: f64 "12"
    flag: bool "13"
    str: str "14"
    raw: []u8 "15"
    color: Color "16"
    inner: Inner? "17"
    maybe: i32? "18"
    packed: []i32 "19"
    loose: []i32 "20,unpacked"
    names: []str "21"
    inners: []Inner "22"
    counts: [str: i32] "23"
    by_id: [i32: Inner] "24"
    zz: []i64 "25,sint"
    fx: []u32 "26,fixed"
    ds: []f64 "27"
    colors: []Color "28"
    choice: Choice? "oneof"
}

fn blank() -> Scalars {
    Scalars {
        i32: 0, i64: 0, u32: 0, u64: 0, s32: 0, s64: 0, f32: 0, f64: 0, sf32: 0, sf64: 0,
        fl: 0.0, db: 0.0, flag: false, str: "", raw: [], color: Unspecified,
        inner: none, maybe: none, packed: [], loose: [], names: [], inners: [], counts: [:], by_id: [:],
        zz: [], fx: [], ds: [], colors: [], choice: none,
    }
}

fn node(a: i32, b: str) -> Inner {
    Inner { a, b, c: [] }
}

fn build(name: str) -> Scalars {
    var v = blank()
    match name {
        == "maybe_zero" => { v.maybe = 0 }
        == "negzero_float" => {
            v.fl = -0.0
            v.db = -0.0
        }
        == "float_round" => {
            v.fl = 0.1
            v.db = 0.1
        }
        == "int_extremes" => {
            v.i32 = -2147483648
            v.i64 = -9223372036854775808
            v.u32 = 4294967295
            v.u64 = 18446744073709551615
            v.s32 = -2147483648
            v.s64 = -9223372036854775808
            v.sf32 = -2147483648
            v.sf64 = -9223372036854775808
        }
        == "full" => {
            v.i32 = -2
            v.i64 = -3
            v.u32 = 4294967295
            v.u64 = 18446744073709551615
            v.s32 = -5
            v.s64 = -6
            v.f32 = 7
            v.f64 = 8
            v.sf32 = -9
            v.sf64 = -10
            v.fl = 1.5
            v.db = 2.25
            v.flag = true
            v.str = "hé"
            v.raw = [1, 255]
            v.color = Neg
            v.inner = Inner { a: 1, b: "x", c: [1, -1] }
            v.maybe = 0
            v.packed = [1, 300]
            v.loose = [1, 2]
            v.names = ["a", "b"]
            v.inners = [node(5, ""), node(0, "q")]
            v.zz = [-1, 2]
            v.fx = [1, 2]
            v.ds = [0.5]
            v.colors = [Red, Green]
            v.choice = Num(0)
        }
        == "map_string" => { v.counts = ["k": 7] }
        == "map_default_entry" => {
            v.counts = ["": 0]
            v.by_id = [0: node(0, "")]
        }
        == "map_message" => { v.by_id = [-5: node(1, "x")] }
        == "oneof_num" => { v.choice = Num(0) }
        == "oneof_word" => { v.choice = Word("w") }
        == "oneof_node" => { v.choice = Node(node(1, "")) }
        == "oneof_empty_node" => { v.choice = Node(node(0, "")) }
        == "empty_inner" => { v.inner = node(0, "") }
        == "bytes_nonempty" => { v.raw = [0] }
        == "utf8" => { v.str = "€ 😀" }
        == "long_string" => { v.str = text.repeat("x", 200) }
        _ => {}
    }
    v
}

fn check(name: str, got: []u8, want: str) {
    let have = text.encode_hex(got)
    if have == want {
        print("{name}: ok")
    } else {
        print("{name}: FAIL\n  got  {have}\n  want {want}")
    }
}

fn round_trip(name: str, input: str, want: str) {
    let data = text.decode_hex(input) or panic("bad vector {name}")
    let v = protobuf.deserialize[Scalars](data) catch {
        e => {
            print("{name}: FAIL {e}")
            return
        }
    }
    check(name, protobuf.serialize(v), want)
}

fn rejected(name: str, input: str) {
    let data = text.decode_hex(input) or panic("bad vector {name}")
    let v = protobuf.deserialize[Scalars](data) catch {
        e => {
            print("{name}: {e}")
            return
        }
    }
    print("{name}: FAIL accepted {text.encode_hex(protobuf.serialize(v))}")
}

fn present[T](v: T?) -> bool {
    match v {
        some(_) => true
        none => false
    }
}

fn fields() {
    let merged = text.decode_hex("8a010808011201781a01058a010508021a0109") or panic("bad vector")
    let v = protobuf.deserialize[Scalars](merged) or panic("merge")
    let inner = v.inner ?? panic("inner")
    print("merge: a {inner.a} b {inner.b} c {inner.c}")

    let blank_decoded = protobuf.deserialize[Scalars]([]) or panic("empty")
    print("absent: {blank_decoded.i32} {blank_decoded.str.len} {blank_decoded.packed.len} {blank_decoded.color} {present(blank_decoded.inner)} {present(blank_decoded.maybe)} {present(blank_decoded.choice)}")

    let explicit = text.decode_hex("900100") or panic("bad vector")
    let zero = protobuf.deserialize[Scalars](explicit) or panic("explicit")
    print("explicit zero: {present(zero.maybe)} {zero.maybe ?? -1}")

    let maps = text.decode_hex("ba01050a016b1001ba01050a016a1002ba01050a016b1003") or panic("bad vector")
    let counts = protobuf.deserialize[Scalars](maps) or panic("maps")
    let k = counts.counts["k"] ?? -1
    let j = counts.counts["j"] ?? -1
    print("map: k {k} j {j} size {counts.counts.len}")

    let choice = text.decode_hex("f00105fa010177") or panic("bad vector")
    let picked = protobuf.deserialize[Scalars](choice) or panic("choice")
    let selected = picked.choice ?? panic("oneof")
    match selected {
        Word(w) => print("oneof: word {w}")
        _ => print("oneof: FAIL")
    }
}

fn main() {
    for v in encode_vectors() {
        check("encode {v.name}", protobuf.serialize(build(v.name)), v.want)
    }
    for v in decode_vectors() {
        round_trip("decode {v.name}", v.input, v.want)
    }
    for v in encode_vectors() {
        round_trip("recode {v.name}", v.want, v.want)
    }
    for v in error_vectors() {
        rejected("error {v.name}", v.input)
    }
    fields()
}
