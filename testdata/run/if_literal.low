fn pick(k: u8[], i: i64) -> u8 {
    let a = if i < k.len { k[i] } else { 0 }
    let b = if i >= k.len { 255 } else { k[i] }
    a ^ b
}

fn spans(start: i64) -> i64[] {
    [start, start + 1]
}

fn empties(outer: i64, inner: i64) -> i64[] {
    let leading = if outer > 0 { [] } else { spans(outer) }
    let trailing = if outer > 0 { spans(outer) } else { [] }
    let chained = if outer > 1 { [] } else if inner > 0 { spans(outer) } else { [] }
    let nested = if outer > 1 { { [] } } else if inner > 0 { [] } else { spans(outer) }
    [leading.len, trailing.len, chained.len, nested.len]
}

fn main() {
    let k: u8[] = [1, 2]
    print(pick(k, 0))
    print(pick(k, 5))
    print(empties(0, 0))
    print(empties(1, 1))
    print(empties(2, 1))
    let names = if k.len > 0 { [:] } else { ["a": 1] }
    print(names.len)
    let missing: i64[]? = none
    let wrapped = if k.len > 0 { [] } else { missing }
    print((wrapped ?? [9]).len)
}
