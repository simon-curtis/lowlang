import std/bits

struct Rng {
    state: u64
}

fn next(r: *Rng) -> u64 {
    r.state = r.state * 6364136223846793005 + 1442695040888963407
    r.state >> 17
}

fn below(r: *Rng, n: i64) -> i64 {
    i64(next(r) % u64(n))
}

fn naive_popcount(x: u64) -> i64 {
    var n = 0
    for i in 0..64 {
        if ((x >> i) & 1) != 0 {
            n += 1
        }
    }
    n
}

fn check_words(r: *Rng) -> bool {
    let edges: []u64 = [0, 1, 0x8000000000000000, 0xFFFFFFFFFFFFFFFF, 0x5555555555555555, 0xAAAAAAAAAAAAAAAA]
    for x in edges {
        if bits.popcount(x) != naive_popcount(x) {
            return false
        }
    }
    if bits.trailing_zeros(0) != 64 || bits.leading_zeros(0) != 64 {
        return false
    }
    for _ in 0..2000 {
        let x = next(r) * next(r) >> u64(below(r, 64))
        let pc = naive_popcount(x)
        if bits.popcount(x) != pc {
            return false
        }
        if x != 0 {
            let tz = bits.trailing_zeros(x)
            let lz = bits.leading_zeros(x)
            if ((x >> tz) & 1) != 1 || (x & ((u64(1) << tz) - 1)) != 0 {
                return false
            }
            if (x >> (63 - lz)) != 1 {
                return false
            }
            let k = below(r, pc)
            let at = bits.select_in_word(x, k)
            if ((x >> at) & 1) != 1 || naive_popcount(x & ((u64(1) << at) - 1)) != k {
                return false
            }
        }
    }
    true
}

fn mirror(s: *bits.Set, model: []bool) -> bool {
    var n = 0
    for i, v in model {
        if bits.contains(s, i) != v {
            print("contains {i} expected {v}")
            return false
        }
        if v {
            n += 1
        }
    }
    if bits.count(s) != n {
        print("count {bits.count(s)} expected {n}")
        return false
    }
    true
}

fn random_set(r: *Rng, size: i64, density: i64) -> *bits.Set {
    let s = bits.set(below(r, size))
    for i in 0..size {
        if below(r, 100) < density {
            bits.add(s, i)
        }
    }
    s
}

fn model_of(s: *bits.Set, size: i64) -> []bool {
    var out: []bool = []
    for i in 0..size {
        push(mut out, bits.contains(s, i))
    }
    out
}

fn check_queries(s: *bits.Set, m: []bool) -> bool {
    let list = bits.members(s)
    var k = 0
    var running = 0
    var first: i64? = none
    var last: i64? = none
    for i, v in m {
        if v {
            if list[k] != i || (bits.select_at(s, k) ?? -1) != i {
                print("member {k}")
                return false
            }
            k += 1
            running += 1
            if first == none {
                first = i
            }
            last = i
        }
        if bits.rank(s, i) != running {
            print("rank {i}")
            return false
        }
        var ns: i64? = none
        var j = i
        for j < m.len {
            if m[j] {
                ns = j
                break
            }
            j += 1
        }
        if bits.next_set(s, i) != ns {
            print("next_set {i}")
            return false
        }
        var nc = i
        for nc < m.len && m[nc] {
            nc += 1
        }
        let got = bits.next_clear(s, i)
        if got != nc && !(nc == m.len && got >= m.len && !bits.contains(s, got)) {
            print("next_clear {i} {got} {nc}")
            return false
        }
    }
    if list.len != k || bits.select_at(s, k) != none || bits.select_at(s, -1) != none {
        return false
    }
    if bits.min(s) != first || bits.max(s) != last {
        print("min/max")
        return false
    }
    var seen = 0
    var ordered = true
    bits.for_each(s, fn(x: i64) -> bool {
        if seen >= list.len || list[seen] != x {
            ordered = false
        }
        seen += 1
        true
    })
    var stopped = 0
    bits.for_each(s, fn(x: i64) -> bool {
        stopped += 1
        stopped < 3
    })
    ordered && seen == k && stopped == if k < 3 { k } else { 3 }
}

fn check_algebra(r: *Rng) -> bool {
    let size = 1 + below(r, 700)
    let a = random_set(r, size, below(r, 101))
    let b = random_set(r, 1 + below(r, 700), below(r, 101))
    let span = 760
    let ma = model_of(a, span)
    let mb = model_of(b, span)
    var mu: []bool = []
    var mi: []bool = []
    var md: []bool = []
    var mx: []bool = []
    var a_sub_b = true
    var same = true
    for i in 0..span {
        push(mut mu, ma[i] || mb[i])
        push(mut mi, ma[i] && mb[i])
        push(mut md, ma[i] && !mb[i])
        push(mut mx, ma[i] != mb[i])
        if ma[i] && !mb[i] {
            a_sub_b = false
        }
        if ma[i] != mb[i] {
            same = false
        }
    }
    if !mirror(bits.union(a, b), mu) || !mirror(bits.intersect(a, b), mi) {
        return false
    }
    if !mirror(bits.difference(a, b), md) || !mirror(bits.xor(a, b), mx) {
        return false
    }
    if bits.subset(a, b) != a_sub_b || bits.equal(a, b) != same {
        print("subset/equal")
        return false
    }
    let i = bits.intersect(a, b)
    if !bits.subset(i, a) || !bits.subset(i, b) || !bits.equal(bits.union(i, bits.xor(a, b)), bits.union(a, b)) {
        return false
    }
    let c = bits.clone(a)
    bits.xor_with(c, b)
    bits.xor_with(c, b)
    if !bits.equal(c, a) {
        return false
    }
    check_queries(a, ma) && check_queries(bits.xor(a, b), mx)
}

fn check_mutations(r: *Rng) -> bool {
    let size = 1000
    let s = bits.set(0)
    var m: []bool = []
    for _ in 0..size {
        push(mut m, false)
    }
    for step in 0..6000 {
        let x = if below(r, 4) == 0 { below(r, 3) * 64 + below(r, 2) * 63 } else { below(r, size) }
        let op = below(r, 10)
        if op < 5 {
            bits.add(s, x)
            m[x] = true
        } else if op < 8 {
            bits.remove(s, x)
            m[x] = false
        } else {
            bits.toggle(s, x)
            m[x] = !m[x]
        }
        if step % 500 == 0 && !mirror(s, m) {
            return false
        }
    }
    bits.remove(s, -5)
    bits.remove(s, 1 << 40)
    if bits.contains(s, -1) || bits.contains(s, 1 << 40) {
        return false
    }
    if !mirror(s, m) || !check_queries(s, m) {
        return false
    }
    bits.clear(s)
    bits.count(s) == 0 && bits.min(s) == none && bits.max(s) == none && bits.next_clear(s, 5) == 5
}

fn main() {
    let r = new(Rng { state: 0x9E3779B97F4A7C15 })
    print("words {check_words(r)}")
    print("mutations {check_mutations(r)}")
    var ok = true
    for _ in 0..60 {
        if !check_algebra(r) {
            ok = false
            break
        }
    }
    print("algebra {ok}")
    let e = bits.set(0)
    print("empty {bits.count(e)} {bits.min(e) ?? -1} {bits.next_set(e, 0) ?? -1} {bits.next_clear(e, 0)} {bits.rank(e, 100)} {bits.members(e).len}")
    let s = bits.set(256)
    bits.add(s, 0)
    bits.add(s, 63)
    bits.add(s, 64)
    bits.add(s, 255)
    bits.add(s, 1000)
    print("edges {bits.count(s)} {bits.max(s) ?? -1} {bits.rank(s, 63)} {bits.rank(s, 64)} {bits.rank(s, 5000)} {bits.select_at(s, 3) ?? -1} {bits.next_set(s, 65) ?? -1} {bits.next_clear(s, 63)}")
}
