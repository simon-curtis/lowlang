struct Point {
    x: i64
    y: i64
}

fn repeated(p: *Point, depth: i64) -> i64 {
    if depth > 0 {
        return repeated(p, depth - 1)
    }
    p.x * p.y + p.x - p.y
}

fn stored(p: *Point, v: i64, depth: i64) -> i64 {
    if depth > 0 {
        return stored(p, v, depth - 1)
    }
    p.x = v
    p.x + 1
}

fn aliased(a: *Point, b: *Point, depth: i64) -> i64 {
    if depth > 0 {
        return aliased(a, b, depth - 1)
    }
    let before = a.x
    b.x = before + 5
    before + a.x
}

fn bump(p: *Point, depth: i64) {
    if depth > 0 {
        bump(p, depth - 1)
        return
    }
    p.x += 1
}

fn across_call(p: *Point, depth: i64) -> i64 {
    if depth > 0 {
        return across_call(p, depth - 1)
    }
    let before = p.x
    bump(p, 1)
    before * 100 + p.x
}

fn merged(p: *Point, c: bool) -> i64 {
    let before = p.x
    if c {
        p.x = 9
    }
    before * 100 + p.x
}

fn looped(p: *Point, n: i64) -> i64 {
    var total = 0
    for i in 0..n {
        total += p.x
        p.x += i
    }
    total
}

fn main() {
    let p = new(Point { x: 3, y: 4 })
    print("repeated {repeated(p, 1)}")
    print("stored {stored(p, 10, 1)}")
    print("aliased {aliased(p, p, 1)}")
    print("across_call {across_call(p, 1)}")
    print("merged {merged(p, true)} {merged(p, false)}")
    print("looped {looped(p, 4)} {p.x}")
}
