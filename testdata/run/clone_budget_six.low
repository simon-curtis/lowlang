fn fold(xs: []i64, f: fn(i64) -> i64) -> i64 {
    var a = 0
    for x in xs {
        a += f(x)
    }
    var b = 0
    for x in xs {
        b += f(x) * 2
    }
    a + b
}

fn main() {
    let xs = [1, 2, 3]
    print(fold(xs, fn(x: i64) -> i64 { x + 1 }))
    print(fold(xs, fn(x: i64) -> i64 { x + 2 }))
    print(fold(xs, fn(x: i64) -> i64 { x + 3 }))
    print(fold(xs, fn(x: i64) -> i64 { x * 4 }))
    print(fold(xs, fn(x: i64) -> i64 { x * 5 }))
    print(fold(xs, fn(x: i64) -> i64 { x - 6 }))
}
