import std/crypto/x509
import std/io
import std/net
import std/sql
import std/sql/mysql
import std/text
import std/tls

fn read_raw(p: *Peer, n: i64) -> []u8 ! io.Error {
    let buf = io.buffer(n)
    var got = 0
    for got < n {
        let read = p.stream.read(buf[got..])?
        if read == 0 {
            fail Eof
        }
        got += read
    }
    buf
}

fn server_config() -> tls.Config ! io.Error {
    tls.Config { certificates: x509.pem_certificates(leaf_pem()), key: x509.pem_private_key(leaf_key())? }
}

fn ssl_prefix(p: *Peer, plugin: str, nonce: []u8) ! io.Error {
    greeting(p, "8.4.0", 5, nonce, server_capabilities(true), plugin)?
    let raw = read_raw(p, 36)?
    note(p, "ssl request ssl bit {(io.le32(raw, 4) & ssl) != 0} charset {raw[12]} sequence {raw[3]}")
}

fn upgrade_server(p: *Peer) ! io.Error {
    let config = server_config()?
    let session = tls.server_handle(p.stream, config)?
    let secure = tls.stream_on(session)
    p.stream = secure
    p.reader = io.reader(secure)
    p.sequence = 2
}

fn secure_login(p: *Peer, plugin: str) -> Login ! io.Error {
    ssl_prefix(p, plugin, nonce_one())?
    upgrade_server(p)?
    let l = login_of(receive(p)?)
    note(p, "{l.plugin} user {l.user} response {text.encode_hex(l.response)}")
    l
}

fn script_tls_native(p: *Peer) ! io.Error {
    let l = secure_login(p, "mysql_native_password")?
    note(p, "response {if text.encode_hex(l.response) == native_one { "matches" } else { "differs" }}")
    send(p, ok(0, 0, 2))?
    drain(p)?
}

fn script_tls_sha2(p: *Peer) ! io.Error {
    secure_login(p, "caching_sha2_password")?
    send(p, [1, 4])?
    let clear = receive(p)?
    note(p, "password after full authentication {text.encode_hex(clear)}")
    send(p, ok(0, 0, 2))?
    drain(p)?
}

fn script_tls_clear(p: *Peer) ! io.Error {
    secure_login(p, "mysql_native_password")?
    var b: []u8 = [0xFE]
    cstring(mut b, "mysql_clear_password")
    send(p, b)?
    let clear = receive(p)?
    note(p, "clear password {text.encode_hex(clear)}")
    send(p, ok(0, 0, 2))?
    drain(p)?
}

fn script_tls_sha256(p: *Peer) ! io.Error {
    secure_login(p, "sha256_password")?
    send(p, ok(0, 0, 2))?
    drain(p)?
}

fn script_tls_absent(p: *Peer) ! io.Error {
    greeting(p, "8.4.0", 5, nonce_one(), server_capabilities(false), "mysql_native_password")?
    let next = command(p) catch {
        e => {
            note(p, "client closed without a request")
            return
        }
    }
    note(p, "client sent {next.len} bytes")
}

fn script_tls_untrusted(p: *Peer) ! io.Error {
    ssl_prefix(p, "mysql_native_password", nonce_one())?
    upgrade_server(p) catch {
        e => {
            note(p, "handshake refused by the client")
            return
        }
    }
    note(p, "handshake completed")
}

fn trusted_roots() -> []x509.Certificate {
    var out: []x509.Certificate = []
    for der in x509.pem_certificates(root_pem()) {
        push(mut out, x509.parse(der) or return out)
    }
    out
}

fn secure_client(password: str, config: tls.Config) -> fn(net.Listener) -> str {
    fn(l: net.Listener) -> str {
        using c = mysql.connect_tls(endpoint(l, "u", password, 5000), config) catch {
            e => return describe(e)
        }
        let affected = c.handle.execute("SELECT 1", []) catch {
            e => return "execute {describe(e)}"
        }
        "connected, execute affected {affected}"
    }
}

fn secure_rounds() -> []Round {
    let trusted = tls.Config { roots: trusted_roots() }
    [
        Round { label: "tls native", script: script_tls_native, client: secure_client("secret", trusted) },
        Round { label: "tls caching_sha2 full authentication", script: script_tls_sha2, client: secure_client("secret", trusted) },
        Round { label: "tls clear password switch", script: script_tls_clear, client: secure_client("secret", trusted) },
        Round { label: "tls sha256_password", script: script_tls_sha256, client: secure_client("secret", trusted) },
        Round { label: "tls without server support", script: script_tls_absent, client: secure_client("secret", trusted) },
        Round { label: "tls untrusted root", script: script_tls_untrusted, client: secure_client("secret", tls.Config {}) },
    ]
}

fn script_stall(p: *Peer) ! io.Error {
    welcome(p)?
    command(p)?
    send(p, ok(0, 0, 2))?
    let q = command(p)?
    note(p, "query {str(q[1..])}")
    command(p) catch {
        e => {
            note(p, "client closed")
            return
        }
    }
}

fn script_kill(p: *Peer) ! io.Error {
    welcome(p)?
    command(p)?
    send(p, ok(0, 0, 2))?
    let q = command(p)?
    note(p, "query {str(q[1..])}")
    send(p, ok(0, 0, 2))?
    drain(p)?
}

fn stall_client(l: net.Listener) -> str {
    using c = mysql.connect(endpoint(l, "u", "secret", 500)) catch {
        e => return describe(e)
    }
    let outcome = c.handle.execute("SELECT SLEEP(100)", []) catch {
        e => return "call {describe(e)}"
    }
    "call returned {outcome}"
}

fn after_stall(l: net.Listener) -> str {
    "second connection served"
}

fn timeout_rounds() -> []Round {
    [
        Round { label: "timeout", script: script_stall, client: stall_client },
        Round { label: "kill query", script: script_kill, client: after_stall },
    ]
}
