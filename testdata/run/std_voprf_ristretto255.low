import std/crypto/voprf
import std/text

struct Case {
    mode: voprf.Mode
    seed: str
    key_info: str
    secret: str
    public: str
    inputs: str[]
    info: str
    blinds: str[]
    blinded: str[]
    evaluated: str[]
    proof: str
    r: str
    outputs: str[]
}

fn suite() -> voprf.Suite {
    voprf.Suite.Ristretto255Sha512
}

fn cases() -> Case[] {
    [
        Case { mode: voprf.Mode.Oprf, seed: "a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3", key_info: "74657374206b6579", secret: "5ebcea5ee37023ccb9fc2d2019f9d7737be85591ae8652ffa9ef0f4d37063b0e", public: "", inputs: ["00"], info: "", blinds: ["64d37aed22a27f5191de1c1d69fadb899d8862b58eb4220029e036ec4c1f6706"], blinded: ["609a0ae68c15a3cf6903766461307e5c8bb2f95e7e6550e1ffa2dc99e412803c"], evaluated: ["7ec6578ae5120958eb2db1745758ff379e77cb64fe77b0b2d8cc917ea0869c7e"], proof: "", r: "", outputs: ["527759c3d9366f277d8c6020418d96bb393ba2afb20ff90df23fb7708264e2f3ab9135e3bd69955851de4b1f9fe8a0973396719b7912ba9ee8aa7d0b5e24bcf6"] }
