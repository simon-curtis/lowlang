import std/ui/geometry
import std/ui/scene

fn show(r: geometry.Rect) -> str {
    "{r.x} {r.y} {r.width} {r.height}"
}

fn kind(k: scene.Kind) -> str {
    match k {
        Quads => "quads"
        Shadows => "shadows"
        Sprites => "sprites"
    }
}

fn main() {
    let c = geometry.rgb(0xff8000)
    print("{c.r} {c.g} {c.b} {c.a}")
    let half = geometry.rgba(0x00000080)
    print(half.a > 0.5 && half.a < 0.51)

    let a = geometry.rect(10.0, 10.0, 20.0, 20.0)
    let b = geometry.rect(20.0, 0.0, 40.0, 15.0)
    print(show(geometry.intersect(a, b)))
    print(show(geometry.intersect(a, geometry.rect(100.0, 100.0, 5.0, 5.0))))
    print(show(geometry.union(a, b)))
    print(show(a.inset(geometry.Edges { top: 1.0, right: 2.0, bottom: 3.0, left: 4.0 })))
    print(show(a.inset(geometry.edges(15.0))))
    print(show(a.scale(2.0).offset(1.0, -1.0)))
    print(a.contains(geometry.point(10.0, 29.5)))
    print(a.contains(geometry.point(30.0, 15.0)))

    var s = scene.empty(100, 50, geometry.rgb(0x000000))
    print(show(s.clip()))
    s.push_quad(scene.Quad { bounds: a })
    s.push_quad(scene.Quad { bounds: b })
    s.push_clip(geometry.rect(0.0, 0.0, 15.0, 200.0))
    s.push_shadow(scene.Shadow { bounds: a, sigma: 2.0 })
    s.push_clip(geometry.rect(5.0, 5.0, 100.0, 100.0))
    s.push_sprite(scene.Sprite { bounds: a })
    s.pop_clip()
    s.push_sprite(scene.Sprite { bounds: b })
    s.pop_clip()
    s.pop_clip()
    s.push_quad(scene.Quad { bounds: b })
    print(show(s.quads[0].clip))
    print(show(s.shadows[0].clip))
    print(show(s.sprites[0].clip))
    print(show(s.sprites[1].clip))
    print(show(s.quads[2].clip))
    for batch in s.batches() {
        print("{kind(batch.kind)} {batch.first} {batch.count}")
    }
    print(scene.empty(1, 1, c).batches().len)

    var atlas = scene.atlas(8)
    print("{atlas.dirty()} {atlas.dirty_top} {atlas.dirty_bottom}")
    atlas.clean()
    print(atlas.dirty())
    atlas.write(2, 3, 2, 2, [1, 2, 3, 4])
    print("{atlas.dirty_top} {atlas.dirty_bottom} {atlas.pixels[3 * 8 + 2]} {atlas.pixels[4 * 8 + 3]}")
    atlas.write(0, 6, 1, 1, [9])
    print("{atlas.dirty_top} {atlas.dirty_bottom}")
    print(show(atlas.tile(2, 4, 4, 2)))
    atlas.clear()
    print("{atlas.pixels[3 * 8 + 2]} {atlas.dirty_top} {atlas.dirty_bottom}")
}
