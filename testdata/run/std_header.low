import std/header
import std/text

fn names(headers: []header.Header) -> str {
    var parts: []str = []
    for h in headers {
        push(mut parts, "{h.name}={h.value}")
    }
    text.join(parts, " ")
}

fn main() {
    var headers: []header.Header = []
    header.add(mut headers, "Accept", "a")
    header.add(mut headers, "X-Tag", "1")
    header.add(mut headers, "accept", "b")
    header.add(mut headers, "ACCEPT", "c")
    print("values {text.join(header.values(headers, "accept"), ",")}")
    print("none {header.values(headers, "missing").len}")

    let kept = header.remove(headers, "Accept")
    print("remove {names(kept)}")
    print("original {names(headers)}")
    print("remove missing {header.remove(headers, "missing").len}")

    header.set(mut headers, "Accept", "z")
    print("set {names(headers)}")

    let plain = header.parse_value("form-data; name=\"a\"; filename*=UTF-8''na%C3%AFve.txt")
    print("param {plain.main} {header.param(plain, "name") ?? "-"} {header.param(plain, "filename") ?? "-"}")
    let pieces = header.parse_value("attachment; title*0*=utf-8''a%20; title*1=b; title*2*=%20c")
    print("pieces {header.param(pieces, "title") ?? "-"}")
    let broken = header.parse_value("attachment; name*=nocharset")
    print("broken {header.param(broken, "name") ?? "-"}")
}
