import std/simd

struct Point {
    x: i64
    y: i64
}


struct Stack[T] {
    items: []T
}

struct Cell {
    at: Point?
}

struct Entry {
    name: str
    score: f64
    tag: u8?
    ok: bool
}

enum Tree {
    Node(i64, i64)
    Move(x: i64, y: i64)
    Leaf
}

enum Shape {
    Circle(r: f64)
    Square(side: i64)
    Dot
}

fn show[T](x: T) {
    print(x)
}

fn label[T](x: T) -> str {
    "<{x}>"
}

fn main() {
    print("top level")
    let text = "plain"
    print("{text} stays raw")

    print(["a\"b", "back\\slash", "line\nbreak", "tab\there"])
    print(Entry { name: "ada", score: 1.5, tag: 7, ok: true })
    print(Entry { name: "bob", score: -0.25, tag: none, ok: false })

    print(Point { x: 3, y: -4 })
    print(Stack[i64] { items: [1, 2, 3] })
    print(Stack[str] { items: ["x"] })

    print(Tree.Node(1, 2))
    print(Tree.Move(3, 4))
    print(Tree.Leaf)
    let shape: Shape = Circle(2.5)
    print(shape)
    print(Shape.Dot)

    let some_value: i64? = 42
    let no_value: i64? = none
    print(some_value)
    print(no_value)
    let some_text: str? = "hi"
    print(some_text)

    let empty: []i64 = []
    print(empty)
    print([10, 20, 30])
    print([[1, 2], [], [3]])

    print(bytes("hi"))
    print(bytes(""))
    let raw: []u8 = [0, 15, 255, 16]
    print(raw)

    var counts: [str: i64] = [:]
    counts["one"] = 1
    print(counts)
    var squares: [i64: i64] = [:]
    squares[2] = 4
    print(squares)
    let none_yet: [str: i64] = [:]
    print(none_yet)

    let lanes: i32x4 = simd.splat(7)
    let sum = lanes + lanes
    print(lanes)
    print(sum)
    print("lanes {lanes}")

    let points = [Entry { name: "p", score: 2.0, tag: none, ok: true }, Entry { name: "q", score: 0.5, tag: 1, ok: false }]
    print(points)
    let cells = [Cell { at: Point { x: 1, y: 2 } }, Cell { at: none }]
    print(cells)

    print("point is {Point { x: 5, y: 6 }} and list is {[1, 2]} and done")
    let n = 3
    print("{n}:{Point { x: n, y: n + 1 }}:{shape}:{some_value}")

    show(Point { x: 8, y: 9 })
    show("generic text")
    show(12)
    show([1.5, 2.5])
    print(label(Tree.Leaf))
    print(label("s"))
    print(label(Stack[bool] { items: [true, false] }))

    var many: []i64 = []
    for i in 0..40 {
        push(mut many, i * 1000)
    }
    let grown = "many: {many} and again {many}."
    print(grown.len)
    print(grown)
}

