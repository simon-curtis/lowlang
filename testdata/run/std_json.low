import std/json
import std/serde
import std/text

enum Shape {
    Circle(radius: f64)
    Rect(f64, f64)
    Empty
}

struct Address {
    street: str
    zip: u16
}

struct User {
    id: i64
    display_name: str
    tags: []str
    scores: [str: i64]
    address: Address?
    shape: Shape
    avatar: []u8
    active: bool = true
    big: u64 = 0
}

struct Node {
    value: i64
    next: *Node?
}

struct Pair[T] {
    first: T
    second: T
}

fn show(kind: serde.Kind) -> str {
    match kind {
        Bool => "bool"
        Int => "int"
        Uint => "uint"
        Float => "float"
        Text => "text"
        Binary => "binary"
        Seq => "seq"
        Map => "map"
        Optional => "optional"
        Struct => "struct"
        Enum => "enum"
        Ref => "ref"
    }
}

fn describe(s: serde.Schema, depth: i64) {
    var pad: []u8 = []
    for _ in 0..depth {
        text.append(mut pad, "  ")
    }
    print("{str(pad)}{show(s.kind)} {s.name}")
    for f in s.fields {
        print("{str(pad)}  .{f.name} required={f.required}")
        describe(f.schema, depth + 2)
    }
    for v in s.variants {
        print("{str(pad)}  |{v.name} labelled={v.labelled} fields={v.fields.len}")
    }
    for item in s.items {
        describe(item, depth + 1)
    }
}

fn problem(e: serde.Error) -> str {
    match e {
        Syntax(at, message) => "syntax at {at}: {message}"
        Mismatch(expected, at) => "expected {expected} at {at}"
        Missing(field) => "missing {field}"
        UnknownVariant(name) => "unknown variant {name}"
        Range(at) => "out of range at {at}"
        TooDeep => "too deep"
    }
}

fn user(data: str) -> str {
    let u = json.deserialize[User](bytes(data)) catch {
        Syntax(at, message) => return "syntax at {at}: {message}"
        Mismatch(expected, at) => return "expected {expected} at {at}"
        Missing(field) => return "missing {field}"
        UnknownVariant(name) => return "unknown variant {name}"
        Range(at) => return "out of range at {at}"
        TooDeep => return "too deep"
    }
    json.serialize(u)
}

fn validity(data: str) -> str {
    json.parse(bytes(data)) catch {
        Syntax(at, message) => return "invalid at {at}: {message}"
        TooDeep => return "invalid: too deep"
        _ => return "invalid"
    }
    "valid"
}

fn main() {
    let u = User {
        id: 7
        display_name: "Ada \"Countess\"\n\t\r"
        tags: ["math", "engines"]
        scores: ["a": 1, "b": -2]
        address: Address { street: "Main", zip: 12345 }
        shape: Circle(2.5)
        avatar: [1, 2, 255]
        big: 18446744073709551615
    }
    let compact = json.serialize(u)
    print(compact)
    print(json.serialize_with(u, json.Options { indent: 2, naming: CamelCase }))
    print(user(compact) == compact)
    let camel = json.serialize_with(u, json.Options { naming: CamelCase })
    let back = json.deserialize_with[User](bytes(camel), json.Options { naming: CamelCase }) catch {
        _ => return
    }
    print(json.serialize(back) == compact)

    var plain = u
    plain.address = none
    plain.shape = Empty
    print(json.serialize_with(plain, json.Options { naming: SnakeCase, omit_none: true }))
    print(json.serialize_with(plain, json.Options { naming: PascalCase }))
    let pascal = json.serialize_with(plain, json.Options { naming: PascalCase, omit_none: true })
    let again = json.deserialize_with[User](bytes(pascal), json.Options { naming: PascalCase }) catch {
        _ => return
    }
    print(json.serialize(again) == json.serialize(plain))
    let lowered = json.deserialize_with[User](bytes(camel), json.Options { naming: CamelCase }) catch {
        _ => return
    }
    print(json.serialize(lowered.shape))

    print(user("{{\"id\": 1, \"display_name\": \"x\", \"tags\": [], \"scores\": {{}}, \"address\": null, \"shape\": {{\"Rect\": [1, 2e0]}}, \"avatar\": \"\", \"extra\": [1, {{\"a\": [null]}}]}}"))
    print(user("{{\"id\": 1}}"))
    print(user("{{\"id\": \"one\"}}"))
    print(user("{{\"id\": 1, \"display_name\": \"x\", \"tags\": [], \"scores\": {{}}, \"address\": {{\"street\": \"s\", \"zip\": 70000}}, \"shape\": \"Empty\", \"avatar\": \"\"}}"))
    print(user("{{\"id\": 1, \"display_name\": \"x\", \"tags\": [], \"scores\": {{}}, \"address\": null, \"shape\": \"Hexagon\", \"avatar\": \"\"}}"))
    print(user("{{\"id\": 1, \"display_name\": \"\\u00e9\\ud83d\\ude00\", \"tags\": [], \"scores\": {{}}, \"address\": null, \"shape\": \"Empty\", \"avatar\": \"\", \"big\": 5}}"))

    let list = Node { value: 1, next: new(Node { value: 2, next: none }) }
    let encoded = json.serialize(list)
    print(encoded)
    let decoded = json.deserialize[Node](bytes(encoded)) catch {
        _ => return
    }
    print(json.serialize(decoded))
    let pairs: []Pair[f64] = [Pair { first: 0.1, second: -1e300 }, Pair { first: 5e-324, second: 3.0 }]
    let p = json.serialize(pairs)
    print(p)
    let q = json.deserialize[[]Pair[f64]](bytes(p)) catch {
        _ => return
    }
    print(json.serialize(q) == p)
    let ids: [i64: bool] = [3: true, -4: false]
    let m = json.serialize(ids)
    print(m)
    let n = json.deserialize[[i64: bool]](bytes(m)) catch {
        _ => return
    }
    print(n[-4] ?? true)

    describe(serde.schema[User](), 0)
    describe(serde.schema[Node](), 0)

    for doc in [
        "{{}}", "[]", "0", "-0.5e+3", "\"\\/\\b\"", " [1 , {{\"a\" : null}} ] ", "{{\"a\":1,}}", "[1,]", "[01]", "[1.]",
        "[.5]", "[+1]", "\"\\x\"", "\"tab\there\"", "[1] 2", "{{\"a\" 1}}", "[\"\\ud800\"]", "nul", "", "[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[1]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]",
    ] {
        print("{doc} -> {validity(doc)}")
    }

    let v = json.parse(bytes("{{\"name\": \"x\", \"list\": [1, 2.5, true, null, {{\"k\": \"v\"}}], \"big\": 123456789012345678901}}")) catch {
        _ => return
    }
    print(json.stringify(v, 0))
    print(json.stringify(json.at(json.get(v, "list") ?? json.Value.Null, 4) ?? json.Value.Null, 0))

    let r = json.reader(bytes("{{\"a\": [1, \"two\", {{\"b\": false}}], \"c\": 3.5}}"))
    var tokens: []str = []
    for json.read(r) catch false {
        push(mut tokens, "{json.depth(r)}:{str(json.value_bytes(r))}")
    }
    print(text.join(tokens, " "))
}
