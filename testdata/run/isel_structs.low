struct One {
    a: i64
}

struct Two {
    a: i64
    b: i64
}

struct Three {
    a: i64
    b: f64
    c: i64
}

struct Seven {
    a: i64
    b: i64
    c: i64
    d: f64
    e: i64
    f: i64
    g: i64
}

struct Packed {
    small: u8
    wide: u16
    mid: i32
    word: i64
    real: f32
}

fn ones(n: i64) -> []One {
    var xs: []One = []
    for i in 0..n {
        push(mut xs, One { a: i * 3 + 1 })
    }
    xs
}

fn twos(n: i64) -> []Two {
    var xs: []Two = []
    for i in 0..n {
        push(mut xs, Two { a: i, b: i * i })
    }
    xs
}

fn threes(n: i64) -> []Three {
    var xs: []Three = []
    for i in 0..n {
        push(mut xs, Three { a: i, b: f64(i) * 0.5, c: -i })
    }
    xs
}

fn sevens(n: i64) -> []Seven {
    var xs: []Seven = []
    for i in 0..n {
        push(mut xs, Seven { a: i, b: i + 1, c: i + 2, d: f64(i) + 0.25, e: i + 4, f: i + 5, g: i + 6 })
    }
    xs
}

fn packed(n: i64) -> []Packed {
    var xs: []Packed = []
    for i in 0..n {
        push(mut xs, Packed { small: u8(i * 77), wide: u16(i * 5003), mid: i32(i * 3000017 - 2000000000), word: i * 1000000007, real: f32(i) * 0.75 })
    }
    xs
}

fn sum_ones(xs: []One) -> i64 {
    var t = 0
    for i in 0..xs.len {
        t += xs[i].a
    }
    t
}

fn sum_twos(xs: []Two) -> i64 {
    var t = 0
    for i in 0..xs.len {
        t += xs[i].a * 3 + xs[i].b
    }
    t
}

fn sum_threes(xs: []Three) -> f64 {
    var t = 0.0
    for i in 0..xs.len {
        t += xs[i].b * 2.0 + f64(xs[i].a) - f64(xs[i].c)
    }
    t
}

fn sum_sevens(xs: []Seven) -> f64 {
    var t = 0.0
    for i in 0..xs.len {
        let s = xs[i]
        t += f64(s.a + s.b * 2 + s.c * 3 + s.e * 5 + s.f * 6 + s.g * 7) + s.d
    }
    t
}

fn sum_packed(xs: []Packed) -> i64 {
    var t = 0
    for i in 0..xs.len {
        t += i64(xs[i].small) + i64(xs[i].wide) * 3 + i64(xs[i].mid) * 5 + xs[i].word * 7 + i64(xs[i].real)
    }
    t
}

fn update_twos(xs: []Two) {
    for i in 0..xs.len {
        xs[i].a += xs[i].b
        xs[i].b = xs[i].a - xs[i].b
    }
}

fn update_sevens(xs: []Seven) {
    for i in 0..xs.len {
        xs[i].d = xs[i].d * 3.0
        xs[i].g = xs[i].a + xs[i].f
        xs[i].a = xs[i].g
    }
}

fn update_packed(xs: []Packed) {
    for i in 0..xs.len {
        xs[i].small += 200
        xs[i].wide += 65000
        xs[i].mid -= 2100000000
        xs[i].word *= 3
        xs[i].real += 0.5
    }
}

fn pick(xs: []Seven, i: i64, j: i64) -> i64 {
    xs[i].a + xs[j].g * 2 + xs[i + j].e
}

fn main() {
    let a = ones(23)
    let b = twos(19)
    let c = threes(17)
    let d = sevens(13)
    let e = packed(11)
    print(sum_ones(a))
    print(sum_twos(b))
    print(sum_threes(c))
    print(sum_sevens(d))
    print(sum_packed(e))
    update_twos(b)
    update_sevens(d)
    update_packed(e)
    print(sum_twos(b))
    print(sum_sevens(d))
    print(sum_packed(e))
    print("{b[0].a} {b[0].b} {b[18].a} {b[18].b}")
    print("{d[0].a} {d[0].d} {d[12].g} {d[12].d}")
    print("{e[0].small} {e[0].wide} {e[0].mid} {e[0].word} {e[0].real}")
    print("{e[10].small} {e[10].wide} {e[10].mid} {e[10].word} {e[10].real}")
    print(pick(d, 2, 5))
    print(pick(d, 0, 12))
}
