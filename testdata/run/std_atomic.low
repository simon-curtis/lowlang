import std/atomic
import std/sync

struct Config {
    name: str
    limit: i64
}

fn count_up(counter: atomic.Int, group: sync.WaitGroup, rounds: i64) {
    for i in 0..rounds {
        counter.add_int(1)
    }
    group.done()
}

fn count_by(counter: atomic.Int, group: sync.WaitGroup, step: i64) {
    for i in 0..500 {
        counter.update_int(fn(n: i64) -> i64 { n + step })
    }
    group.done()
}

fn race_to_claim(flag: atomic.Flag, winners: atomic.Int, group: sync.WaitGroup) {
    if flag.set() {
        winners.add_int(1)
    }
    group.done()
}

fn toggle(b: atomic.Bool, flips: atomic.Int, group: sync.WaitGroup) {
    for i in 0..200 {
        if b.compare_and_swap_bool(false, true) {
            flips.add_int(1)
        } else if b.compare_and_swap_bool(true, false) {
            flips.add_int(1)
        }
    }
    group.done()
}

fn grow(v: atomic.Value[Config], group: sync.WaitGroup) {
    for i in 0..300 {
        v.update_value(fn(c: Config) -> Config { Config { name: c.name, limit: c.limit + 1 } })
    }
    group.done()
}

fn wait_for_flag(flag: atomic.Flag, seen: atomic.Int, group: sync.WaitGroup) {
    for !flag.is_set() {
        sleep(1)
    }
    seen.add_int(1)
    group.done()
}

fn counters() {
    let counter = atomic.int(0)
    let group = sync.wait_group()
    for t in 0..16 {
        group.add(1)
        spawn count_up(counter, group, 1000)
    }
    group.wait()
    print("add {counter.load_int()}")

    let stepped = atomic.int(10)
    let more = sync.wait_group()
    for t in 0..8 {
        more.add(1)
        spawn count_by(stepped, more, t + 1)
    }
    more.wait()
    print("update {stepped.load_int()}")
}

fn scalar() {
    let n = atomic.int(5)
    print("load {n.load_int()}")
    n.store_int(9)
    print("store {n.load_int()}")
    print("add {n.add_int(-4)}")
    print("swap {n.swap_int(100)} {n.load_int()}")
    print("cas {n.compare_and_swap_int(1, 2)} {n.load_int()}")
    print("cas {n.compare_and_swap_int(100, 2)} {n.load_int()}")
    print("update {n.update_int(fn(x: i64) -> i64 { x * 21 })}")
}

fn booleans() {
    let b = atomic.boolean(false)
    print("bool {b.load_bool()}")
    b.store_bool(true)
    print("bool {b.load_bool()}")
    print("swap {b.swap_bool(false)} {b.load_bool()}")
    print("cas {b.compare_and_swap_bool(true, false)} {b.load_bool()}")
    print("cas {b.compare_and_swap_bool(false, true)} {b.load_bool()}")

    let flips = atomic.int(0)
    let group = sync.wait_group()
    let state = atomic.boolean(false)
    for t in 0..8 {
        group.add(1)
        spawn toggle(state, flips, group)
    }
    group.wait()
    print("toggles {state.load_bool() == (flips.load_int() % 2 == 1)}")
}

fn flags() {
    let flag = atomic.flag()
    print("flag {flag.is_set()}")
    print("set {flag.set()} {flag.set()} {flag.is_set()}")
    print("clear {flag.clear()} {flag.clear()} {flag.is_set()}")

    let claim = atomic.flag()
    let winners = atomic.int(0)
    let group = sync.wait_group()
    for t in 0..32 {
        group.add(1)
        spawn race_to_claim(claim, winners, group)
    }
    group.wait()
    print("winners {winners.load_int()}")

    let gate = atomic.flag()
    let seen = atomic.int(0)
    let waiting = sync.wait_group()
    for t in 0..4 {
        waiting.add(1)
        spawn wait_for_flag(gate, seen, waiting)
    }
    sleep(5)
    print("before {seen.load_int()}")
    gate.set()
    waiting.wait()
    print("after {seen.load_int()}")
}

fn values() {
    let v = atomic.value(Config { name: "base", limit: 1 })
    let first = v.snapshot_value()
    print("load {v.load_value().name} {v.load_value().limit}")
    let old = v.swap_value(Config { name: "next", limit: 2 })
    print("swap {old.name} {old.limit} {v.load_value().name}")
    print("stale {v.compare_and_swap_value(first, Config { name: "lost", limit: 0 })} {v.load_value().name}")
    let current = v.snapshot_value()
    print("fresh {v.compare_and_swap_value(current, Config { name: "won", limit: 7 })} {v.load_value().name}")
    v.store_value(Config { name: "set", limit: 0 })

    let shared = atomic.value(Config { name: "shared", limit: 0 })
    let group = sync.wait_group()
    for t in 0..8 {
        group.add(1)
        spawn grow(shared, group)
    }
    group.wait()
    print("grown {shared.load_value().limit} {shared.load_value().name}")
}

fn main() {
    scalar()
    counters()
    booleans()
    flags()
    values()
}
