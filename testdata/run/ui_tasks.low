import std/cancel
import std/ui

fn settle(cx: ui.Context, ms: i64) {
    sleep(ms)
    cx.dispatch(Woken)
}

fn sum_to(n: i64) -> i64 {
    var total = 0
    for i in 1..n + 1 {
        total += i
    }
    total
}

fn delivered(cx: ui.Context) {
    print("background")
    let result = cx.signal(-1)
    cx.background_task(fn(t: *cancel.Token) -> i64 { sum_to(1000) }, fn(n: i64) result.set(n))
    print("before {result.get()} due {cx.frame_due()}")
    for _ in 0..1000 {
        if result.get() >= 0 {
            break
        }
        settle(cx, 5)
    }
    print("after {result.get()}")
}

fn cancelled(cx: ui.Context) {
    print("cancelled")
    let result = cx.signal("none")
    let started: chan[bool] = chan[bool](1)
    let task = cx.background_task(fn(t: *cancel.Token) -> str {
        started <- true
        cancel.pause(t, 20)
        "late"
    }, fn(s: str) result.set(s))
    <-started
    ui.cancel_task(task)
    settle(cx, 60)
    print("result {result.get()}")
    let fired = cx.signal(false)
    let timer = cx.after(20, fn() fired.set(true))
    ui.cancel_task(timer)
    settle(cx, 60)
    print("timer fired {fired.get()}")
}

fn repeating(cx: ui.Context) {
    print("every")
    let ticks = cx.signal(0)
    let task = cx.every(5, fn() ticks.update(fn(n) n + 1))
    for _ in 0..1000 {
        if ticks.get() > 1 {
            break
        }
        settle(cx, 5)
    }
    print("ticked {ticks.get() > 1}")
    ui.cancel_task(task)
    cx.dispatch(Woken)
    let stopped = ticks.get()
    settle(cx, 60)
    print("stopped {ticks.get() == stopped}")
}

fn closing() {
    print("closing")
    let cx = ui.headless(ui.rgb(0xffffff))
    let saw: chan[bool] = chan[bool](1)
    let started: chan[bool] = chan[bool](1)
    let ran = cx.signal(false)
    cx.background_task(fn(t: *cancel.Token) -> bool {
        started <- true
        let finished = cancel.pause(t, 10000)
        saw <- !finished
        finished
    }, fn(b: bool) ran.set(true))
    <-started
    cx.quit()
    print("work saw cancel {<-saw}")
    settle(cx, 20)
    print("done ran {ran.get()}")
    let late = cx.signal(false)
    cx.after(1, fn() late.set(true))
    settle(cx, 30)
    print("after close fired {late.get()}")
}

fn main() {
    let cx = ui.headless(ui.rgb(0xffffff))
    delivered(cx)
    cancelled(cx)
    repeating(cx)
    closing()
}
