import std/crypto/hash
import std/io
import std/net
import std/slices
import std/stun
import std/text

fn same_bytes(a: u8[], b: u8[]) -> bool {
    slices.equal(a, b)
}

fn same_ints(a: i64[], b: i64[]) -> bool {
    slices.equal(a, b)
}

fn absent(v: u8[]?) -> bool {
    match v {
        some(_) => false
        none => true
    }
}

fn code_of(m: stun.Message) -> i64 {
    match stun.error_code(m) {
        some(c) => c.code
        none => 0
    }
}

fn reason_of(m: stun.Message) -> str {
    match stun.error_code(m) {
        some(c) => c.reason
        none => ""
    }
}

fn check(name: str, good: bool) {
    print("{name}: {if good { "ok" } else { "FAIL" }}")
}

fn lookup(file: str, id: str) -> u8[] {
    for line in text.split(file, '\n') {
        let at = text.index_byte(line, ' ')
        if at > 0 && line[..at] == id {
            return text.decode_hex(line[at + 1..]) or []
        }
    }
    []
}

fn rfc(id: str) -> u8[] {
    lookup(embed("std_stun_5769.hex"), id)
}

fn reference(id: str) -> u8[] {
    lookup(embed("std_stun_ref.hex"), id)
}

fn passes(f: fn() ! io.Error) -> bool {
    f() catch {
        _ => return false
    }
    true
}

fn fails_with(f: fn() ! io.Error, want: io.Error) -> bool {
    f() catch {
        e => return e == want
    }
    false
}

fn password() -> u8[] {
    bytes("VOkJxbRl1RmTxUk/WvJxBt")
}

fn kinds(m: stun.Message) -> i64[] {
    var out: i64[] = []
    for a in m.attributes {
        out.push(a.kind)
    }
    out
}

fn same(a: net.Addr, b: net.Addr) -> bool {
    a.port == b.port && hash.equal(a.ip, b.ip)
}

fn parsed(raw: u8[]) -> stun.Message {
    stun.parse(raw) or stun.message(stun.Class.Request, 0)
}

fn rfc_request() {
    let raw = rfc("2.1")
    let m = parsed(raw)
    check("2.1 class and method", m.class == stun.Class.Request && m.method == stun.binding)
    check("2.1 transaction", text.encode_hex(m.transaction) == "b7e7a701bc34d686fa87dfae")
    check("2.1 attribute order", same_ints(kinds(m), [0x8022, 0x0024, 0x8029, 0x0006, 0x0008, 0x8028]))
    check("2.1 software", stun.get_text(m, stun.attr_software) == "STUN test client")
    check("2.1 username", stun.get_text(m, stun.attr_username) == "evtj:h6vY")
    check("2.1 priority", (stun.get_u32(m, stun.attr_priority) or -1) == 0x6e0001ff)
    check("2.1 ice-controlled", (stun.get_u64(m, stun.attr_ice_controlled) or 0) == 0x932ff9b151263b36)
    check("2.1 integrity", passes(fn() ! io.Error { stun.check_integrity(m, password(), stun.Integrity.Sha1)? }))
    check("2.1 wrong key", fails_with(fn() ! io.Error { stun.check_integrity(m, bytes("other"), stun.Integrity.Sha1)? }, io.Error.Denied))
    check("2.1 no sha256", fails_with(fn() ! io.Error { stun.check_integrity(m, password(), stun.Integrity.Sha256)? }, io.Error.NotFound))
    check("2.1 fingerprint", passes(fn() ! io.Error { stun.check_fingerprint(m)? }))
    var rebuilt = stun.Message { class: stun.Class.Request, method: stun.binding, transaction: m.transaction, padding: 0x20 }
    stun.add_text(mut rebuilt, stun.attr_software, "STUN test client")
    stun.add_u32(mut rebuilt, stun.attr_priority, 0x6e0001ff)
    stun.add_u64(mut rebuilt, stun.attr_ice_controlled, 0x932ff9b151263b36)
    stun.add_text(mut rebuilt, stun.attr_username, "evtj:h6vY")
    check("2.1 rebuilt bytes", same_bytes(stun.seal(rebuilt, stun.Protection { key: password() }), raw))
}

fn rfc_response4() {
    let raw = rfc("2.2")
    let m = parsed(raw)
    check("2.2 class and method", m.class == stun.Class.Success && m.method == stun.binding)
    let want = net.Addr { ip: [192, 0, 2, 1], port: 32853 }
    check("2.2 mapped address", same(stun.reflexive_address(m) or net.Addr { ip: [], port: 0 }, want))
    check("2.2 integrity", passes(fn() ! io.Error { stun.check_integrity(m, password(), stun.Integrity.Sha1)? }))
    check("2.2 fingerprint", passes(fn() ! io.Error { stun.check_fingerprint(m)? }))
    var rebuilt = stun.Message { class: stun.Class.Success, method: stun.binding, transaction: m.transaction, padding: 0x20 }
    stun.add_text(mut rebuilt, stun.attr_software, "test vector")
    stun.add_xor_address(mut rebuilt, stun.attr_xor_mapped_address, want)
    check("2.2 rebuilt bytes", same_bytes(stun.seal(rebuilt, stun.Protection { key: password() }), raw))
}

fn rfc_response6() {
    let raw = rfc("2.3")
    let m = parsed(raw)
    let ip = text.decode_hex("20010db8123456780011223344556677") or []
    let want = net.Addr { ip, port: 32853 }
    check("2.3 mapped address", same(stun.reflexive_address(m) or net.Addr { ip: [], port: 0 }, want))
    check("2.3 integrity", passes(fn() ! io.Error { stun.check_integrity(m, password(), stun.Integrity.Sha1)? }))
    check("2.3 fingerprint", passes(fn() ! io.Error { stun.check_fingerprint(m)? }))
    var rebuilt = stun.Message { class: stun.Class.Success, method: stun.binding, transaction: m.transaction, padding: 0x20 }
    stun.add_text(mut rebuilt, stun.attr_software, "test vector")
    stun.add_xor_address(mut rebuilt, stun.attr_xor_mapped_address, want)
    check("2.3 rebuilt bytes", same_bytes(stun.seal(rebuilt, stun.Protection { key: password() }), raw))
}

fn rfc_long_term() {
    let raw = rfc("2.4")
    let m = parsed(raw)
    let user = "マトリックス"
    check("2.4 username", stun.get_text(m, stun.attr_username) == user)
    check("2.4 realm", stun.get_text(m, stun.attr_realm) == "example.org")
    check("2.4 nonce", stun.get_text(m, stun.attr_nonce) == "f//499k954d6OL34oL9FSTvy64sA")
    let key = stun.long_term_key(user, "example.org", "TheMatrIX")
    check("2.4 integrity", passes(fn() ! io.Error { stun.check_integrity(m, key, stun.Integrity.Sha1)? }))
    let raw_password = str(text.decode_hex("546865c2ad4dc2aa7472e285a8") or [])
    let unprepared = stun.long_term_key(user, "example.org", raw_password)
    check("2.4 without SASLprep the key differs", fails_with(fn() ! io.Error { stun.check_integrity(m, unprepared, stun.Integrity.Sha1)? }, io.Error.Denied))
    var rebuilt = stun.Message { class: stun.Class.Request, method: stun.binding, transaction: m.transaction }
    stun.add_text(mut rebuilt, stun.attr_username, user)
    stun.add_text(mut rebuilt, stun.attr_nonce, "f//499k954d6OL34oL9FSTvy64sA")
    stun.add_text(mut rebuilt, stun.attr_realm, "example.org")
    check("2.4 rebuilt bytes", same_bytes(stun.seal(rebuilt, stun.Protection { key, fingerprint: false }), raw))
}

fn python_reference() {
    let txid = text.decode_hex("000102030405060708090a0b") or []
    var base = stun.Message { class: stun.Class.Request, method: stun.binding, transaction: txid }
    stun.add_text(mut base, stun.attr_software, "low")
    stun.add_text(mut base, stun.attr_username, "alice:bob")
    let secret = bytes("secret")
    check("sha256 bytes", same_bytes(stun.seal(base, stun.Protection { key: secret, sha1: false, sha256: true }), reference("sha256")))
    check("sha1 and sha256 bytes", same_bytes(stun.seal(base, stun.Protection { key: secret, sha256: true }), reference("both")))
    check("sha1 only bytes", same_bytes(stun.seal(base, stun.Protection { key: secret, fingerprint: false }), reference("sha1only")))
    let both = parsed(reference("both"))
    check("both integrity", passes(fn() ! io.Error { stun.check_integrity(both, secret, stun.Integrity.Sha1)? }))
    check("both integrity sha256", passes(fn() ! io.Error { stun.check_integrity(both, secret, stun.Integrity.Sha256)? }))
    check("both fingerprint", passes(fn() ! io.Error { stun.check_fingerprint(both)? }))
    check("sha256 wrong key", fails_with(fn() ! io.Error { stun.check_integrity(both, bytes("Secret"), stun.Integrity.Sha256)? }, io.Error.Denied))
    var response = stun.Message { class: stun.Class.Success, method: stun.binding, transaction: txid }
    stun.add_xor_address(mut response, stun.attr_xor_mapped_address, net.Addr { ip: [203, 0, 113, 7], port: 54321 })
    check("xor-mapped-address v4 bytes", same_bytes(stun.seal(response, stun.Protection { key: [], sha1: false }), reference("xor4")))
    var response6 = stun.Message { class: stun.Class.Success, method: stun.binding, transaction: txid }
    let ip6 = text.decode_hex("20010db8000000000000000000000001") or []
    stun.add_xor_address(mut response6, stun.attr_xor_mapped_address, net.Addr { ip: ip6, port: 4242 })
    check("xor-mapped-address v6 bytes", same_bytes(stun.seal(response6, stun.Protection { key: [], sha1: false }), reference("xor6")))
    var failure = stun.Message { class: stun.Class.Error, method: stun.binding, transaction: txid }
    stun.add_error_code(mut failure, 487, "Role Conflict")
    check("error code bytes", same_bytes(stun.seal(failure, stun.Protection { key: [], sha1: false }), reference("error487")))
    let parsed_error = parsed(reference("error487"))
    check("error code parsed", code_of(parsed_error) == 487 && reason_of(parsed_error) == "Role Conflict")
    let long_key = lookup(embed("std_stun_ref.hex"), "longkey")
    check("long-term key md5", same_bytes(stun.long_term_key("user", "example.org", "pass"), long_key))
    check("long-term key sha256", same_bytes(stun.long_term_key_sha256("user", "example.org", "pass"), reference("longkey256")))
    var allocate = stun.Message { class: stun.Class.Request, method: stun.allocate, transaction: txid }
    stun.add_text(mut allocate, stun.attr_username, "user")
    stun.add_text(mut allocate, stun.attr_realm, "example.org")
    stun.add_text(mut allocate, stun.attr_nonce, "nonce123")
    check("long-term request bytes", same_bytes(stun.seal(allocate, stun.Protection { key: long_key, fingerprint: false }), reference("longterm")))
}

fn type_bytes(class: stun.Class, method: i64) -> i64 {
    let raw = stun.encode(stun.Message { class, method, transaction: io.buffer(12) })
    io.be16(raw, 0)
}

fn message_types() {
    check("allocate request", type_bytes(stun.Class.Request, stun.allocate) == 0x0003)
    check("allocate success", type_bytes(stun.Class.Success, stun.allocate) == 0x0103)
    check("allocate error", type_bytes(stun.Class.Error, stun.allocate) == 0x0113)
    check("refresh request", type_bytes(stun.Class.Request, stun.refresh) == 0x0004)
    check("send indication", type_bytes(stun.Class.Indication, stun.send) == 0x0016)
    check("data indication", type_bytes(stun.Class.Indication, stun.data) == 0x0017)
    check("create permission request", type_bytes(stun.Class.Request, stun.create_permission) == 0x0008)
    check("channel bind request", type_bytes(stun.Class.Request, stun.channel_bind) == 0x0009)
    check("channel bind error", type_bytes(stun.Class.Error, stun.channel_bind) == 0x0119)
    let m = parsed(reference("error487"))
    check("type decode", m.class == stun.Class.Error && m.method == stun.binding)
    check("method above 0x7f survives", parsed(stun.encode(stun.Message { class: stun.Class.Error, method: 0xABC, transaction: io.buffer(12) })).method == 0xABC)
}

fn malformed() {
    let good = rfc("2.2")
    check("empty", fails_with(fn() ! io.Error { stun.parse([])? }, io.Error.Malformed))
    check("short header", fails_with(fn() ! io.Error { stun.parse(good[..19])? }, io.Error.Malformed))
    check("truncated", fails_with(fn() ! io.Error { stun.parse(good[..good.len - 4])? }, io.Error.Malformed))
    var longer = good
    longer = slices.concat(longer, [0])
    check("trailing byte", fails_with(fn() ! io.Error { stun.parse(longer)? }, io.Error.Malformed))
    let cookie = io.buffer(good.len)
    let _ = io.copy(cookie, good)
    cookie[4] = 0x00
    check("bad cookie", fails_with(fn() ! io.Error { stun.parse(cookie)? }, io.Error.Malformed))
    let top = io.buffer(good.len)
    let _ = io.copy(top, good)
    top[0] = 0x41
    check("top bits set", fails_with(fn() ! io.Error { stun.parse(top)? }, io.Error.Malformed))
    let odd = io.buffer(good.len)
    let _ = io.copy(odd, good)
    odd[3] = 0x3d
    check("length not a multiple of four", fails_with(fn() ! io.Error { stun.parse(odd)? }, io.Error.Malformed))
    let overrun = io.buffer(good.len)
    let _ = io.copy(overrun, good)
    overrun[23] = 0x40
    check("attribute overruns the message", fails_with(fn() ! io.Error { stun.parse(overrun)? }, io.Error.Malformed))
    let flipped = io.buffer(good.len)
    let _ = io.copy(flipped, good)
    flipped[30] = flipped[30] ^ 1
    let m = parsed(flipped)
    check("flipped byte fails integrity", fails_with(fn() ! io.Error { stun.check_integrity(m, password(), stun.Integrity.Sha1)? }, io.Error.Denied))
    check("flipped byte fails fingerprint", fails_with(fn() ! io.Error { stun.check_fingerprint(m)? }, io.Error.Malformed))
    check("looks like", stun.looks_like(good) && !stun.looks_like(good[1..]) && !stun.looks_like([22, 254, 253]))
    let misplaced = stun.Message { class: stun.Class.Success, method: stun.binding, transaction: io.buffer(12) }
    let after = parsed(stun.seal(misplaced, stun.Protection { key: [], sha1: false }))
    check("fingerprint present and last", passes(fn() ! io.Error { stun.check_fingerprint(after)? }))
    let unsealed = parsed(stun.encode(misplaced))
    check("fingerprint absent", fails_with(fn() ! io.Error { stun.check_fingerprint(unsealed)? }, io.Error.NotFound))
    check("unparsed message has no checkable bytes", fails_with(fn() ! io.Error { stun.check_integrity(misplaced, [], stun.Integrity.Sha1)? }, io.Error.NotFound))
}

fn addresses() {
    let v4 = net.Addr { ip: [10, 1, 2, 3], port: 3478 }
    var m = stun.message(stun.Class.Request, stun.binding)
    stun.add_address(mut m, stun.attr_mapped_address, v4)
    stun.add_xor_address(mut m, stun.attr_xor_peer_address, v4)
    let back = parsed(stun.encode(m))
    check("plain address round trip", same(stun.get_address(back, stun.attr_mapped_address) or net.Addr { ip: [], port: 0 }, v4))
    check("xor address round trip", same(stun.get_xor_address(back, stun.attr_xor_peer_address) or net.Addr { ip: [], port: 0 }, v4))
    check("xor differs from plain", !same_bytes(stun.find(back, stun.attr_xor_peer_address) ?? [], stun.find(back, stun.attr_mapped_address) ?? []))
    check("mapped address used without xor", same(stun.reflexive_address(parsed(stun.encode(m))) or net.Addr { ip: [], port: 0 }, v4))
    var bad = stun.message(stun.Class.Request, stun.binding)
    stun.add(mut bad, stun.attr_xor_mapped_address, [0, 3, 0, 0, 1, 2, 3, 4])
    check("unknown family", fails_with(fn() ! io.Error { stun.get_xor_address(bad, stun.attr_xor_mapped_address)? }, io.Error.Malformed))
    var short = stun.message(stun.Class.Request, stun.binding)
    stun.add(mut short, stun.attr_mapped_address, [0, 1, 0, 0, 1, 2, 3])
    check("short address", fails_with(fn() ! io.Error { stun.get_address(short, stun.attr_mapped_address)? }, io.Error.Malformed))
    check("absent address", fails_with(fn() ! io.Error { stun.get_address(short, stun.attr_xor_mapped_address)? }, io.Error.NotFound))
    var unknown = stun.message(stun.Class.Request, stun.binding)
    stun.add(mut unknown, 0x0099, [1])
    stun.add(mut unknown, 0x8099, [1])
    stun.add_text(mut unknown, stun.attr_username, "u")
    check("unknown required attributes", same_ints(stun.unknown_required(unknown, [stun.attr_username]), [0x0099]))
}

fn server_answers() {
    let key = password()
    let config = stun.ServerConfig { software: "low", keys: ["evtj:h6vY": key], authenticate: true }
    let from = net.Addr { ip: [192, 0, 2, 1], port: 32853 }
    let reply = stun.respond(rfc("2.1"), from, config) ?? []
    let m = parsed(reply)
    check("answers the RFC request", m.class == stun.Class.Success && text.encode_hex(m.transaction) == "b7e7a701bc34d686fa87dfae")
    check("answer reports the sender", same(stun.reflexive_address(m) or net.Addr { ip: [], port: 0 }, from))
    check("answer integrity", passes(fn() ! io.Error { stun.check_integrity(m, key, stun.Integrity.Sha1)? }))
    check("answer fingerprint", passes(fn() ! io.Error { stun.check_fingerprint(m)? }))
    check("answer software", stun.get_text(m, stun.attr_software) == "low")
    let rejected = parsed(stun.respond(rfc("2.1"), from, stun.ServerConfig { authenticate: true, keys: ["evtj:h6vY": bytes("wrong")] }) ?? [])
    check("wrong key gets 401", rejected.class == stun.Class.Error && code_of(rejected) == 401)
    let stranger = parsed(stun.respond(rfc("2.1"), from, stun.ServerConfig { authenticate: true }) ?? [])
    check("unknown user gets 401", code_of(stranger) == 401)
    var anonymous = stun.message(stun.Class.Request, stun.binding)
    stun.add_text(mut anonymous, stun.attr_software, "client")
    let open = parsed(stun.respond(stun.encode(anonymous), from, stun.ServerConfig {}) ?? [])
    check("anonymous binding", open.class == stun.Class.Success && absent(stun.find(open, stun.attr_message_integrity)))
    let missing = parsed(stun.respond(stun.encode(anonymous), from, stun.ServerConfig { authenticate: true }) ?? [])
    check("missing credentials get 400", code_of(missing) == 400)
    var odd = stun.message(stun.Class.Request, stun.binding)
    stun.add(mut odd, 0x0099, [1, 2, 3, 4])
    let refused = parsed(stun.respond(stun.encode(odd), from, stun.ServerConfig {}) ?? [])
    check("unknown attribute gets 420", code_of(refused) == 420)
    check("unknown attribute is listed", same_bytes(stun.find(refused, stun.attr_unknown_attributes) ?? [], [0x00, 0x99]))
    let other = stun.message(stun.Class.Request, stun.allocate)
    let method = parsed(stun.respond(stun.encode(other), from, stun.ServerConfig {}) ?? [])
    check("unsupported method gets 400", code_of(method) == 400)
    check("indication gets no answer", absent(stun.respond(stun.encode(stun.message(stun.Class.Indication, stun.binding)), from, stun.ServerConfig {})))
    check("response gets no answer", absent(stun.respond(rfc("2.2"), from, stun.ServerConfig {})))
    check("garbage gets no answer", absent(stun.respond([1, 2, 3], from, stun.ServerConfig {})))
    let damaged = io.buffer(rfc("2.1").len)
    let _ = io.copy(damaged, rfc("2.1"))
    damaged[damaged.len - 1] = damaged[damaged.len - 1] ^ 1
    check("bad fingerprint gets no answer", absent(stun.respond(damaged, from, config)))
}

fn schedule() {
    check("default schedule", same_ints(stun.waits(stun.Config {}), [500, 1000, 2000, 4000, 8000, 16000, 8000]))
    check("short schedule", same_ints(stun.waits(stun.Config { rto: 10, transmissions: 3, final_wait: 2 }), [10, 20, 20]))
}

struct Lossy {
    socket: net.SocketHandle
    drop_first: i64
    seen: chan[i64]
}

fn lossy_server(l: Lossy) {
    let buf = io.buffer(2048)
    var count = 0
    for {
        let packet = net.receive_from_on(l.socket, buf) catch {
            _ => return
        }
        count += 1
        l.seen <- count
        if count <= l.drop_first {
            continue
        }
        let reply = stun.respond(buf[..packet.size], packet.from, stun.ServerConfig { software: "lossy" })
        match reply {
            some(out) => {
                let _ = net.send_to_on(l.socket, out, packet.from) or 0
            }
            none => {}
        }
    }
}

fn over_udp() {
    using server = net.bind_udp("127.0.0.1", 0) or return
    let seen = chan[i64](64)
    spawn lossy_server(Lossy { socket: server.handle, drop_first: 2, seen })
    using client = stun.client("127.0.0.1") or return
    let fast = stun.Config { rto: 20 }
    let reflexive = stun.binding_address(client, server.handle.addr, fast) catch {
        _ => net.Addr { ip: [], port: 0 }
    }
    check("binding after two lost requests", same(reflexive, client.socket.addr))
    var transmissions = 0
    for {
        let n = select {
            v = <-seen => v ?? 0
            else => 0
        }
        if n == 0 {
            break
        }
        transmissions += 1
    }
    check("three transmissions reached the server", transmissions == 3)
    check("a silent server ends in TimedOut", silent_server(client))
}

fn authenticated_exchange() {
    let key = bytes("shared-secret")
    using server = net.bind_udp("127.0.0.1", 0) or return
    let config = stun.ServerConfig { software: "auth", keys: ["alice:bob": key], authenticate: true }
    spawn stun.serve(server.handle, config)
    using client = stun.client("127.0.0.1") or return
    var m = stun.message(stun.Class.Request, stun.binding)
    stun.add_text(mut m, stun.attr_username, "alice:bob")
    let fast = stun.Config { rto: 20, transmissions: 3, final_wait: 2 }
    let reply = stun.request(client, server.handle.addr, m, some(stun.Protection { key }), some(key), fast) catch {
        _ => stun.message(stun.Class.Error, 0)
    }
    check("protected request is answered", reply.class == stun.Class.Success)
    check("protected answer reports the client", same(stun.reflexive_address(reply) or net.Addr { ip: [], port: 0 }, client.socket.addr))
    check("protected answer is sealed", passes(fn() ! io.Error { stun.check_integrity(reply, key, stun.Integrity.Sha1)? }))
    check("answer with a bad MESSAGE-INTEGRITY is ignored", expects_key_timeout(client, server.handle.addr, key))
    var anonymous = stun.message(stun.Class.Request, stun.binding)
    stun.add_text(mut anonymous, stun.attr_username, "mallory")
    let rejected = stun.request(client, server.handle.addr, anonymous, some(stun.Protection { key }), none, fast) catch {
        _ => stun.message(stun.Class.Success, 0)
    }
    check("unknown user is answered with 401", rejected.class == stun.Class.Error && code_of(rejected) == 401)
}

fn expects_key_timeout(client: stun.Client, server: net.Addr, key: u8[]) -> bool {
    var m = stun.message(stun.Class.Request, stun.binding)
    stun.add_text(mut m, stun.attr_username, "alice:bob")
    let fast = stun.Config { rto: 10, transmissions: 2, final_wait: 2 }
    stun.request(client, server, m, some(stun.Protection { key }), some(bytes("not-the-key")), fast) catch {
        e => return e == io.Error.TimedOut
    }
    false
}

fn raw_addresses() {
    let txid = text.decode_hex("000102030405060708090a0b") or []
    let v4 = net.Addr { ip: [203, 0, 113, 7], port: 54321 }
    let xor = reference("xor4")[24..32]
    check("xor_address_value matches the reference", same_bytes(stun.xor_address_value(v4, txid), xor))
    check("address_value layout", same_bytes(stun.address_value(v4), [0, 1, 0xD4, 0x31, 203, 0, 113, 7]))
}

fn silent_server(client: stun.Client) -> bool {
    let silent = stun.Config { rto: 5, transmissions: 2, final_wait: 2 }
    let m = stun.message(stun.Class.Request, stun.binding)
    using mute = net.bind_udp("127.0.0.1", 0) or return false
    stun.request(client, mute.handle.addr, m, none, none, silent) catch {
        e => return e == io.Error.TimedOut
    }
    false
}

fn main() {
    rfc_request()
    rfc_response4()
    rfc_response6()
    rfc_long_term()
    python_reference()
    message_types()
    malformed()
    addresses()
    server_answers()
    schedule()
    over_udp()
    authenticated_exchange()
    raw_addresses()
}
