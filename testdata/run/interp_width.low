struct Point {
    x: i64
    y: i64
}

enum Tree {
    Node(i64, i64)
    Leaf
}

fn main() {
    let name = "Ada"
    let age = 36
    print("hello {name,13} your age is {age:##}")
    print("[{"héllo",8}]")
    print("[{"héllo",-8}]")
    print("[{"日本",6}]")
    print("[{name,2}]")
    print("[{age,6}][{age,-6}]")
    print("[{age, 6 }][{age, -6 }]")
    print("[{true,7}][{false,-7}]")
    print("[{3.5,8}][{-3.5,-8}]")
    let p = Point { x: 1, y: 22 }
    print("[{p,20}]")
    print("[{p,-20}]")
    let t = Tree.Node(1, 2)
    print("[{t,12}][{Tree.Leaf,-6}]")
    print("[{"a" + "b",4}]")
    print("[{"x{age}y",8}]")
    print("[{[1, 2],-9}]")
    print("{name,5}{name,-5}{name,5}|")
    let nan = 0.0 / 0.0
    let inf = 1.0 / 0.0
    print("[{nan,6}][{inf,-6}][{-inf,6}]")
    print("[{nan,6:f2}][{inf,6:e3}][{-inf,-6:#.#}][{nan:n}]")
    print("[{age,-6:x}][{age,6:d4}][{1.5,8:f3}][{1.5,-8:f3}]|")
    let long = "{age,40:d3}|{age,-40:d3}|"
    print(long.len)
}
