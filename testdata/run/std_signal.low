import std/io
import std/os
import std/os/signal
import std/process

fn show(s: signal.Signal?) -> str {
    match s {
        some(v) => signal.name(v)
        none => "none"
    }
}

fn received(w: signal.Watch) -> str {
    let s = signal.wait_for(w) catch {
        _ => return "error"
    }
    signal.name(s)
}

fn basics() {
    print(signal.number(Interrupt))
    print(signal.number(WindowChange))
    print(signal.name(Terminate))
    print(show(signal.from_number(10)))
    print(show(signal.from_number(99)))
    print(signal.catchable(Kill))
    print(signal.catchable(Stop))
    print(signal.catchable(Hangup))
}

fn rejections() {
    using kill = signal.notify([Kill]) catch {
        e => {
            print("kill rejected")
            return
        }
    }
    print("kill accepted")
}

fn rejects_stop() {
    signal.ignore([Stop]) catch {
        e => {
            print("stop rejected")
            return
        }
    }
    print("stop accepted")
}

fn rejects_empty() {
    using empty = signal.notify([]) catch {
        e => {
            print("empty rejected")
            return
        }
    }
    print("empty accepted")
}

fn burst() ! io.Error {
    using w = signal.notify([User1, User2, Terminate, Hangup])?
    signal.raise(User1)?
    signal.raise(User2)?
    signal.send(os.pid(), Terminate)?
    for _ in 0..3 {
        print(received(w))
    }
    signal.raise(Hangup)?
    print(received(w))
    print(show(signal.wait_timeout(w, 30)))
    signal.raise(Terminate)?
    print(show(signal.wait_timeout(w, 2000)))
}

fn two_watches() ! io.Error {
    using first = signal.notify([User1])?
    using second = signal.notify([User1, User2])?
    signal.raise(User1)?
    print(received(second))
    print(show(signal.wait_timeout(first, 30)))
    signal.raise(User2)?
    print(received(second))
}

fn nested_restore() ! io.Error {
    using outer = signal.notify([User1])?
    inner_watch()?
    signal.raise(User1)?
    print(received(outer))
}

fn inner_watch() ! io.Error {
    using inner = signal.notify([User1])?
    signal.raise(User1)?
    print(received(inner))
    print(show(signal.wait_timeout(inner, 20)))
}

fn restores_ignored() ! io.Error {
    signal.ignore([User1])?
    signal.raise(User1)?
    print("survived ignore")
    {
        using w = signal.notify([User1])?
        signal.raise(User1)?
        print(received(w))
    }
    signal.raise(User1)?
    print("survived restored ignore")
    signal.reset([User1])?
}

fn restores_default() ! io.Error {
    {
        using w = signal.notify([WindowChange, Child])?
        signal.raise(WindowChange)?
        print(received(w))
    }
    signal.raise(WindowChange)?
    signal.raise(Child)?
    print("survived restored default")
}

fn stopped_watch() ! io.Error {
    using w = signal.notify([User2])?
    signal.stop(w)
    signal.stop(w)
    print(show(<-w.handle.signals))
    let r = signal.wait_for(w) catch {
        NotConnected => {
            print("closed")
            return
        }
        _ => {
            print("other")
            return
        }
    }
    print(signal.name(r))
}

fn coalescing() ! io.Error {
    using w = signal.notify([User1])?
    for _ in 0..40 {
        signal.raise(User1)?
    }
    sleep(100)
    var count = 0
    for signal.wait_timeout(w, 20) != none {
        count += 1
    }
    print(count >= 1 && count <= 16)
    signal.raise(User1)?
    print(received(w))
}

fn children() ! io.Error {
    using w = signal.notify([Child, Interrupt])?
    let done = process.run(process.command("true", []), [])?
    print(process.success(done.status))
    print(received(w))
    let pid = os.pid()
    let sent = process.run(process.command("kill", ["-INT", "{pid}"]), [])?
    print(process.success(sent.status))
    var seen = "none"
    for _ in 0..4 {
        if signal.wait_timeout(w, 2000) == some(Interrupt) {
            seen = "interrupt"
            break
        }
    }
    print(seen)
}

fn wait_any_signal() ! io.Error {
    spawn deliver_later()
    let s = signal.wait_any([Terminate, Interrupt])?
    print(signal.name(s))
}

fn deliver_later() {
    sleep(50)
    signal.raise(Terminate) catch {
        _ => {}
    }
}

fn main() ! io.Error {
    basics()
    rejections()
    rejects_stop()
    rejects_empty()
    burst()?
    two_watches()?
    nested_restore()?
    restores_ignored()?
    restores_default()?
    stopped_watch()?
    coalescing()?
    children()?
    wait_any_signal()?
}
