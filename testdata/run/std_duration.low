import std/time/duration
import std/time/fault
import std/time/rounding

fn show(d: duration.Duration) -> str {
    "{duration.whole_seconds(d)}/{duration.subsec_nanos(d)}"
}

fn show_option(d: duration.Duration?) -> str {
    match d {
        some(v) => show(v)
        none => "none"
    }
}

fn describe(e: fault.Fault) -> str {
    match e {
        Syntax(at) => "syntax {at}"
        Overflow => "overflow"
        Invalid(what) => "invalid {what}"
        OutOfRange(what) => "range {what}"
        _ => "other"
    }
}

fn mode_name(m: rounding.Rounding) -> str {
    match m {
        Trunc => "trunc"
        Ceil => "ceil"
        Floor => "floor"
        Expand => "expand"
        HalfExpand => "half_expand"
        HalfEven => "half_even"
        HalfTrunc => "half_trunc"
        HalfCeil => "half_ceil"
        HalfFloor => "half_floor"
    }
}

fn all_modes() -> []rounding.Rounding {
    [
        rounding.Rounding.Trunc,
        rounding.Rounding.Ceil,
        rounding.Rounding.Floor,
        rounding.Rounding.Expand,
        rounding.Rounding.HalfExpand,
        rounding.Rounding.HalfEven,
        rounding.Rounding.HalfTrunc,
        rounding.Rounding.HalfCeil,
        rounding.Rounding.HalfFloor
    ]
}

fn max_secs() -> i64 {
    9223372036854775807
}

fn parts() {
    let from_nanos: []i64 = [0, 1, -1, 999999999, 1000000000, 1500000001, -1500000001, 9223372036854775807, -9223372036854775807]
    for n in from_nanos {
        print("nanoseconds {n} {show(duration.nanoseconds(n))}")
    }
    let from_micros: []i64 = [1, -1, 1500001, -1500001, 999999, 1000000]
    for n in from_micros {
        print("microseconds {n} {show(duration.microseconds(n))}")
    }
    let from_millis: []i64 = [1, -1, 1500, -1500, 999, 1001, -1001]
    for n in from_millis {
        print("milliseconds {n} {show(duration.milliseconds(n))}")
    }
    print("seconds {show(duration.seconds(-7))} {show(duration.seconds(0))}")
    print("minutes {show(duration.minutes(90))} {show(duration.minutes(-1))}")
    print("hours {show(duration.hours(25))} {show(duration.hours(-2))}")
    print("max hours {show(duration.hours(2562047788015215))}")
    print("from_parts {show(duration.from_parts(1, -1))} {show(duration.from_parts(-1, 1))} {show(duration.from_parts(0, 2500000000))} {show(duration.from_parts(5, -2500000000))}")
    print("from_parts {show(duration.from_parts(-5, 2500000000))} {show(duration.from_parts(0, -1))} {show(duration.from_parts(-3, 0))}")
    print("try_from_parts {show_option(duration.try_from_parts(max_secs(), 0))} {show_option(duration.try_from_parts(max_secs(), 1000000000))} {show_option(duration.try_from_parts(-max_secs(), -999999999))}")
    print("try_from_parts {show_option(duration.try_from_parts(-max_secs() - 1, 0))} {show_option(duration.try_from_parts(-max_secs(), -1000000000))}")
    print("zero {show(duration.zero())} {duration.is_zero(duration.zero())}")
}

fn accessors() {
    let d = duration.from_parts(-119, -999999999)
    print("accessors {duration.whole_seconds(d)} {duration.subsec_nanos(d)} {duration.whole_millis(d)} {duration.whole_micros(d)} {duration.whole_minutes(d)} {duration.whole_hours(d)}")
    let e = duration.from_parts(7384, 123456789)
    print("accessors {duration.whole_seconds(e)} {duration.subsec_nanos(e)} {duration.whole_millis(e)} {duration.whole_micros(e)} {duration.whole_minutes(e)} {duration.whole_hours(e)}")
    print("flags {duration.is_negative(d)} {duration.is_negative(e)} {duration.is_negative(duration.zero())} {duration.is_zero(e)} {duration.is_zero(duration.nanoseconds(1))}")
    let a = duration.as_nanos(d) ?? 0
    print("as_nanos {a} {duration.as_nanos(e) ?? 0}")
    print("as_nanos edges {duration.as_nanos(duration.from_parts(9223372036, 854775807)) ?? 0} {duration.as_nanos(duration.from_parts(9223372036, 854775808)) ?? -1} {duration.as_nanos(duration.from_parts(-9223372036, -854775808)) ?? 0} {duration.as_nanos(duration.from_parts(-9223372036, -854775809)) ?? -1}")
    print("as_nanos max {duration.as_nanos(duration.from_parts(max_secs(), 0)) ?? -1}")
    print("seconds_f64 {duration.as_seconds_f64(duration.from_parts(3, 500000000))} {duration.as_seconds_f64(duration.milliseconds(-250))} {duration.as_seconds_f64(duration.zero())}")
    print("floor parts {duration.floor_seconds(d)} {duration.floor_nanos(d)} {duration.floor_seconds(e)} {duration.floor_nanos(e)}")
}

fn float_in(f: f64) -> str {
    let d = duration.from_seconds_f64(f) catch {
        e => return describe(e)
    }
    show(d)
}

fn floats() {
    var zero = 0.0
    let inf = 1.0 / zero
    let nan = zero / zero
    print("from_seconds_f64 {float_in(1.5)} {float_in(-1.5)} {float_in(0.1)} {float_in(-0.1)} {float_in(0.0)}")
    print("from_seconds_f64 {float_in(0.000000001)} {float_in(0.0000000004)} {float_in(0.0000000006)} {float_in(2.999999999)}")
    print("from_seconds_f64 {float_in(9200000000000000000.0)} {float_in(1e19)} {float_in(-1e19)}")
    print("from_seconds_f64 {float_in(nan)} {float_in(inf)} {float_in(-inf)}")
}

fn arithmetic() {
    let a = duration.from_parts(10, 700000000)
    let b = duration.from_parts(-3, -400000000)
    print("plus {show(duration.plus(a, b))} {show(duration.plus(b, a))} {show(duration.plus(a, duration.negate(a)))}")
    print("minus {show(duration.minus(a, b))} {show(duration.minus(b, a))} {show(duration.minus(b, b))}")
    print("plus mixed {show(duration.plus(duration.from_parts(1, 0), duration.from_parts(0, -1)))} {show(duration.plus(duration.from_parts(-1, 0), duration.from_parts(0, 1)))}")
    print("negate {show(duration.negate(a))} {show(duration.negate(b))} {show(duration.abs(b))} {show(duration.abs(a))}")
    let top = duration.from_parts(max_secs(), 999999999)
    let bottom = duration.from_parts(-max_secs(), -999999999)
    print("try_plus {show_option(duration.try_plus(top, duration.nanoseconds(1)))} {show_option(duration.try_plus(top, duration.nanoseconds(-1)))} {show_option(duration.try_plus(top, duration.seconds(1)))}")
    print("try_plus {show_option(duration.try_plus(bottom, duration.nanoseconds(-1)))} {show_option(duration.try_plus(bottom, duration.nanoseconds(1)))} {show_option(duration.try_plus(top, bottom))}")
    print("try_minus {show_option(duration.try_minus(top, bottom))} {show_option(duration.try_minus(bottom, top))} {show_option(duration.try_minus(top, top))} {show_option(duration.try_minus(duration.zero(), top))}")
    print("abs {show(duration.abs(bottom))} {show(duration.negate(top))}")
    print("try_plus carry {show_option(duration.try_plus(duration.from_parts(max_secs() - 1, 999999999), duration.nanoseconds(1)))} {show_option(duration.try_plus(duration.from_parts(max_secs() - 1, 999999999), duration.nanoseconds(2)))}")
}

fn multiplication() {
    let d = duration.from_parts(-1, -500000000)
    print("times {show(duration.times(d, 3))} {show(duration.times(d, -3))} {show(duration.times(d, 0))} {show(duration.times(duration.zero(), 99))}")
    let tiny = duration.nanoseconds(999999999)
    print("times {show(duration.times(tiny, 1))} {show(duration.times(tiny, 2))} {show(duration.times(tiny, 1000000007))}")
    print("times wide {show_option(duration.try_times(tiny, 9223372036854775807))} {show_option(duration.try_times(tiny, -9223372036854775807))}")
    let one = duration.from_parts(1, 1)
    print("times wide {show_option(duration.try_times(one, 9223372036854775806))} {show_option(duration.try_times(one, 9223372036854775807))}")
    print("times wide {show_option(duration.try_times(duration.nanoseconds(1), -9223372036854775807))} {show_option(duration.try_times(duration.seconds(1), -9223372036854775807))} {show_option(duration.try_times(duration.seconds(2), 4611686018427387904))}")
    print("times wide {show_option(duration.try_times(duration.seconds(1), 9223372036854775807))} {show_option(duration.try_times(duration.from_parts(0, 5), 3000000000))} {show_option(duration.try_times(duration.from_parts(-4, -5), -1000000000))}")
    print("times edge {show_option(duration.try_times(duration.seconds(1), -9223372036854775807 - 1))} {show_option(duration.try_times(duration.nanoseconds(-1), -9223372036854775807 - 1))} {show_option(duration.try_times(duration.zero(), -9223372036854775807 - 1))}")
}

fn division() {
    let cases: []i64 = [
        10, 0, 3,
        -10, 0, 3,
        1, 0, -7,
        -1, 0, -7,
        0, 1, 2,
        0, 999999999, 1000000000,
        0, -999999999, 7,
        5, 500000000, 1,
        5, 500000000, -1,
        7, 123456789, 1000,
        9223372036854775807, 999999999, 3,
        9223372036854775807, 999999999, 9223372036854775807,
        9223372036854775807, 999999999, 4611686018427387904,
        -9223372036854775807, -999999999, 6148914691236517205,
        3, 0, 9223372036854775807,
        1, 1, 9223372036854775807,
        1, 999999999, -9223372036854775807,
        9223372036854775807, 999999999, -9223372036854775807 - 1,
        1, 0, -9223372036854775807 - 1,
        86400, 1, 86401
    ]
    var i = 0
    for i + 2 < cases.len {
        let d = duration.from_parts(cases[i], cases[i + 1])
        print("divide {show(d)} by {cases[i + 2]} = {show(duration.divide(d, cases[i + 2]))}")
        i += 3
    }
}

fn ratios() {
    print("ratio {duration.ratio(duration.minutes(3), duration.seconds(90))} {duration.ratio(duration.seconds(1), duration.milliseconds(3))} {duration.ratio(duration.seconds(-1), duration.seconds(4))}")
}

fn ordering() {
    let all = [duration.from_parts(-2, -1), duration.from_parts(-2, 0), duration.from_parts(-1, -999999999), duration.from_parts(0, -1), duration.zero(), duration.from_parts(0, 1), duration.from_parts(1, 0), duration.from_parts(1, 1)]
    var row = ""
    for a in all {
        for b in all {
            row = "{row}{duration.compare(a, b)} "
        }
        print("compare {row}")
        row = ""
    }
    let x = duration.seconds(3)
    let y = duration.seconds(5)
    print("order {duration.equal(x, x)} {duration.equal(x, y)} {duration.before(x, y)} {duration.after(x, y)} {show(duration.min(x, y))} {show(duration.max(x, y))} {x == x} {x == y}")
}

fn rounded(d: duration.Duration, unit: duration.Duration, m: rounding.Rounding) -> str {
    let r = duration.round(d, unit, m) catch {
        e => return describe(e)
    }
    show(r)
}

fn round_matrix(label: str, unit: duration.Duration, inputs: []i64) {
    for m in all_modes() {
        var row = ""
        for i in 0..inputs.len / 2 {
            let d = duration.from_parts(inputs[i * 2], inputs[i * 2 + 1])
            row = "{row}{rounded(d, unit, m)} "
        }
        print("round {label} {mode_name(m)} {row}")
    }
}

fn rounding_cases() {
    let to_second: []i64 = [
        2, 500000000, 3, 500000000, -2, -500000000, -3, -500000000,
        2, 400000000, 2, 600000000, -2, -400000000, -2, -600000000,
        0, 500000000, 0, -500000000, 1, 500000000, -1, -500000000,
        2, 0, -2, 0, 0, 0, 0, 499999999, 0, 500000001, 0, -499999999, 0, -500000001
    ]
    round_matrix("1s", duration.seconds(1), to_second)
    let to_milli: []i64 = [
        0, 1500000, 0, 2500000, 0, -1500000, 0, -2500000,
        0, 499999, 0, 500001, 0, -499999, 0, -500001, 0, 500000, 0, -500000, 3, 0
    ]
    round_matrix("1ms", duration.milliseconds(1), to_milli)
    let to_hour: []i64 = [5400, 0, 9000, 0, -5400, 0, -9000, 0, 1799, 999999999, 1800, 0, -1800, 0, 3600, 0, 7200, 1]
    round_matrix("1h", duration.hours(1), to_hour)
    let to_odd: []i64 = [
        2, 250000000, 0, 750000000, 0, -750000000, -2, -250000000, 5, 250000000, 4, 500000000, 1, 500000000, 3, 0
    ]
    round_matrix("1.5s", duration.milliseconds(1500), to_odd)
    let to_seven: []i64 = [
        250000000000, 500000000, 250000000003, 500000000, -250000000001, -500000000, 9223372036854775807, 999999999,
        -9223372036854775807, -999999999, 3, 500000000, 1000000000000, 0, 7, 0
    ]
    round_matrix("7s", duration.seconds(7), to_seven)
    round_matrix("999999937ns", duration.nanoseconds(999999937), to_seven)
    round_matrix("7ns", duration.nanoseconds(7), to_seven)
    round_matrix("1d", duration.hours(24), to_seven)
    let to_big: []i64 = [
        0, 0, 4611686018427387903, 1, 4611686018427387904, 0, -4611686018427387903, -1, -4611686018427387904, -999999999,
        9223372036854775807, 0, 9223372036854775807, 999999999
    ]
    round_matrix("4611686018s", duration.seconds(4611686018), to_big)
    round_matrix("4611686018427387903ns", duration.nanoseconds(4611686018427387903), to_big)
}

fn truncated(d: duration.Duration, unit: duration.Duration) -> str {
    let r = duration.truncate(d, unit) catch {
        e => return describe(e)
    }
    show(r)
}

fn units_and_overflow() {
    let d = duration.from_parts(100, 600000000)
    print("truncate {truncated(d, duration.seconds(1))} {truncated(duration.negate(d), duration.seconds(1))} {truncated(d, duration.seconds(30))} {truncated(duration.negate(d), duration.seconds(30))}")
    print("unit errors {rounded(d, duration.zero(), rounding.Rounding.Trunc)} {rounded(d, duration.seconds(-1), rounding.Rounding.Trunc)} {rounded(d, duration.seconds(4611686019), rounding.Rounding.Trunc)} {rounded(d, duration.seconds(9223372036854775807), rounding.Rounding.Trunc)}")
    let top = duration.from_parts(max_secs(), 999999999)
    print("round overflow {rounded(top, duration.seconds(1), rounding.Rounding.Ceil)} {rounded(top, duration.seconds(1), rounding.Rounding.Floor)} {rounded(top, duration.seconds(1), rounding.Rounding.HalfExpand)} {rounded(top, duration.milliseconds(10), rounding.Rounding.Expand)}")
    let bottom = duration.negate(top)
    print("round overflow {rounded(bottom, duration.seconds(1), rounding.Rounding.Floor)} {rounded(bottom, duration.seconds(1), rounding.Rounding.Ceil)} {rounded(bottom, duration.seconds(1), rounding.Rounding.Expand)}")
}

fn rendered(d: duration.Duration) -> str {
    "{show(d)} {duration.to_string(d)} | {duration.friendly(d)}"
}

fn text_out() {
    let nanos: []i64 = [
        0, 1, -1, 999, 1000, 1500, 999999, 1000000, 1500000, 999999999, 1000000000, 1500000000, 60000000000, 61000000000,
        3600000000000, 5400000000000, 3600000000001, 86400000000000, 90061001001001, -90061001001001, -1000000000, -500000000,
        -1500000, 7200500000000, 3661000000000, 59999999999, 119500000000
    ]
    for n in nanos {
        print("text {n} {rendered(duration.nanoseconds(n))}")
    }
    print("text max {rendered(duration.from_parts(max_secs(), 999999999))}")
    print("text min {rendered(duration.from_parts(-max_secs(), -999999999))}")
    print("text big {rendered(duration.from_parts(max_secs(), 0))}")
}

fn parsed(s: str) -> str {
    let d = duration.parse(s) catch {
        e => return "{s} -> {describe(e)}"
    }
    "{s} -> {show(d)}"
}

fn parsing() {
    let valid = [
        "PT0S", "PT1S", "PT1H30M", "PT0.5S", "-PT1S", "+PT1S", "PT1H2M3.456789012S", "PT0.000000001S", "pt1h", "pt1h2m3s",
        "PT36H", "PT90M", "PT1M0.5S", "PT2562047788015215H30M7S", "-PT2562047788015215H30M7S", "PT2562047788015215H30M7.999999999S",
        "PT0H0M0S", "PT0M", "PT5H", "PT1H0.000000001S", "PT007S", "PT1.1S", "PT10.10S",
        "1h30m", "1h 30m", "1h 30m 0.5s", "250ms", "1.5s", "-2m", "+3s", "5ns", "5us", "5µs", "5μs", "1.5ms", "1.5h", "0.5m",
        "1h1m1s1ms1us1ns", "1 h 30 m", "0s", "0ns", "1.0ns", "1.000000000s", "1.999999999s", "2562047788015215h", "9223372036854775807s",
        "1h  30m", "1h30m  45s", "0.001ms", "1.000001ms", "2.5µs", "100.5us", "-1h30m0.25s", "1m30s", "1ms1s", "3s2s"
    ]
    for s in valid {
        print("parse {parsed(s)}")
    }
    let invalid = [
        "", "-", "+", "x", "1", "1x", "1.s", "1..5s", "1.5ns", "1.0000000001s", "1h 30", "1h x", "1h ", " 1h", "1m s", "1d",
        "5 ", "99999999999999999999s", "9223372036854775808s", "2562047788015216h", "-2562047788015216h", "1.5us1", "0", "1,5s",
        "P", "PT", "P1D", "PT1", "PT1X", "PT1D", "PT1H1H", "PT1M1H", "PT1.5H", "PT1.5M", "PT.5S", "PT1.S", "PT1.0000000001S", "PT1S ", "PT1Sx",
        "PT1H30", "-P", "PT-1S", "PT1S1M", "PT99999999999999999999S", "PT2562047788015215H30M8S", "P1Y", "P1M", "PT1M2S3", "pT", "-PT", "+P1D", "PT1.5S2"
    ]
    for s in invalid {
        print("parse {parsed(s)}")
    }
}

fn roundtrip() {
    let nanos: []i64 = [0, 1, -1, 999999999, 1000000000, 1500000000, -3661001000000, 90061001001001, 123456789123456789, -123456789123456789]
    var ok = 0
    for n in nanos {
        let d = duration.nanoseconds(n)
        let iso = duration.parse(duration.to_string(d)) catch { e => duration.zero() }
        let friendly = duration.parse(duration.friendly(d)) catch { e => duration.zero() }
        if duration.equal(iso, d) && duration.equal(friendly, d) {
            ok += 1
        }
    }
    print("roundtrip {ok} of {nanos.len}")
}

fn main() {
    parts()
    accessors()
    floats()
    arithmetic()
    multiplication()
    division()
    ratios()
    ordering()
    rounding_cases()
    units_and_overflow()
    text_out()
    parsing()
    roundtrip()
}
