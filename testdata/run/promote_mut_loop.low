fn rot(mut a: u32, mut b: u32) {
    a = a + b
    b = (b << 7) | (b >> 25)
    b = b ^ a
}

fn quarter(mut a: u32, mut b: u32, mut c: u32, mut d: u32) {
    a = a + b
    d = d ^ a
    d = (d << 16) | (d >> 16)
    c = c + d
    b = b ^ c
    b = (b << 12) | (b >> 20)
}

fn core(n: i64) -> u32 {
    var x: u32 = 1
    var y: u32 = 2
    for i in 0..n {
        rot(mut x, mut y)
    }
    x + y
}

fn mix(n: i64) -> u32 {
    var a: u32 = 1
    var b: u32 = 2
    var c: u32 = 3
    var d: u32 = 4
    for i in 0..n {
        quarter(mut a, mut b, mut c, mut d)
    }
    a ^ b ^ c ^ d
}

fn main() {
    print(core(0))
    print(core(1))
    print(core(10))
    print(core(1000))
    print(mix(0))
    print(mix(7))
    print(mix(500))
}
