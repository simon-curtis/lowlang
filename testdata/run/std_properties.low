import std/properties
import std/text

fn describe(e: properties.Error) -> str {
    match e {
        Syntax(line, message) => "line {line}: {message}"
    }
}

fn source() -> str {
    let lines = [
        "# comment",
        "! another comment",
        "",
        "Truth = Beauty",
        " Truth2:Beauty2",
        "Truth3                    :Beauty3",
        "fruits                           apple, banana, pear, \\",
        "                                  cantaloupe, watermelon, \\",
        "                                  kiwi, mango",
        "cheeses",
        "ke\\ y\\:with\\=chars = value with spaces  ",
        "unicode = \\u0048\\u0065llo \\u00e9 \\uD83D\\uDE00 end",
        "escapes = tab\\there\\nline\\rcr\\fff \\q \\\\ done",
        "empty=",
        "colon:value:more=still",
        "space key",
        "double = ends with two \\\\",
        "after = ok",
        "trailing = last \\",
    ]
    "{text.join(lines, "\n")}\n"
}

fn show(p: properties.Properties, key: str) {
    print("[{key}] = [{p.get(key) ?? "<none>"}]")
}

fn parsed(label: str, s: str) {
    let p = properties.parse(s) catch {
        e => {
            print("{label}: {describe(e)}")
            return
        }
    }
    print("{label}: {text.join(p.keys, "|")}")
}

fn main() {
    let p = properties.parse(source()) catch {
        e => {
            print("failed {describe(e)}")
            return
        }
    }
    print(text.join(p.keys, "|"))
    for key in p.keys {
        show(p, key)
    }
    show(p, "missing")

    let rendered = properties.format(p)
    print(rendered)
    let again = properties.parse(rendered) catch {
        e => {
            print("reparse failed {describe(e)}")
            return
        }
    }
    print(properties.format(again) == rendered)
    print(text.join(again.keys, "|") == text.join(p.keys, "|"))

    var built = properties.empty()
    built.set(" lead", " lead value")
    built.set("a=b:c#d!e", "x=y:z#w!v")
    built.set("tab\tkey", "tab\tvalue\nnext\\")
    built.set("emoji", "caf{text.from_char(0xE9)}&{text.from_char(0x1F600)}")
    built.set("lead", "first")
    built.set("lead", "second")
    let text_form = properties.format(built)
    print(text_form)
    let rebuilt = properties.parse(text_form) catch {
        e => {
            print("rebuilt failed {describe(e)}")
            return
        }
    }
    for key in built.keys {
        print(rebuilt.get(key) == built.get(key))
    }

    parsed("crlf", "a=1\r\nb=2\r\n")
    parsed("lone cr", "a=1\rb=2")
    parsed("continued comment", "a=1 \\\n# not a comment\nb=2")
    parsed("short unicode", "a=\\u12")
    parsed("bad unicode", "a=\\u12zz")
    parsed("high surrogate alone", "a=\\ud83d")
    parsed("low surrogate alone", "a=\\ude00")
    parsed("high surrogate then text", "a=\\ud83dx")
    parsed("bad key unicode", "x\n\\u12=1")
    parsed("empty", "")
}
