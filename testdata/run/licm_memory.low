fn counter(xs: []i64, n: i64) -> i64 {
    var total = 0
    for i in 0..n {
        total += xs[0]
        xs[0] += 1
    }
    total
}

fn guarded_divide(d: i64, n: i64) -> i64 {
    var total = 0
    for i in 0..n {
        if d != 0 {
            total += 100 / d
        }
        total += i
    }
    total
}

fn skipped_divide(d: i64, n: i64) -> i64 {
    var total = 0
    for i in 0..n {
        total += 100 / d + i
    }
    total
}

fn skipped_remainder(d: i64, n: i64) -> i64 {
    var total = 0
    for i in 0..n {
        total += 1000 % d + i
    }
    total
}

fn checked_index(xs: []i64, k: i64, n: i64) -> i64 {
    var total = 0
    for i in 0..n {
        total += xs[k] + i
    }
    total
}

fn shared(xs: []i64, ys: []i64, n: i64) -> i64 {
    var total = 0
    for i in 0..n {
        total += xs[1]
        ys[1] += 3
    }
    total
}

fn main() {
    let xs = [10, 20, 30]
    print(counter(xs, 4))
    print(xs[0])
    print(counter(xs, 0))
    print(guarded_divide(0, 5))
    print(guarded_divide(7, 5))
    print(skipped_divide(0, 0))
    print(skipped_divide(4, 3))
    print(skipped_remainder(0, 0))
    print(skipped_remainder(7, 3))
    print(checked_index(xs, 99, 0))
    print(checked_index(xs, 2, 3))
    let ys = [1, 2, 3]
    print(shared(ys, ys, 3))
    print(ys[1])
    print(skipped_divide(0, 1))
}
