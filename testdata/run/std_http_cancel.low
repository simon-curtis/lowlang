import std/cancel
import std/http
import std/io
import std/net

fn handle(req: http.Request, outcomes: chan[str]) -> http.Response {
    if req.path == "/quick" {
        return http.response(200, "quick")
    }
    let result = if cancel.pause(req.token, 5000) { "{req.path} finished" } else { "{req.path} cancelled" }
    outcomes <- result
    http.response(200, result)
}

fn serve(l: net.ListenerHandle, outcomes: chan[str]) {
    let handler = fn(req: http.Request) -> http.Response { handle(req, outcomes) }
    for {
        let h = net.accept_handle(l) catch {
            _ => return
        }
        spawn http.serve_conn_on(h, handler)
    }
}

fn main() ! io.Error {
    let outcomes = chan[str](4)
    using l = net.listen("127.0.0.1", 0)?
    spawn serve(l.handle, outcomes)

    using raw = net.connect(l.handle.addr)?
    net.write_all(raw, bytes("GET /h1 HTTP/1.1\r\nhost: x\r\n\r\n"))?
    sleep(50)
    net.close(raw)
    print((<-outcomes) ?? "")

    using piped = net.connect(l.handle.addr)?
    net.write_all(piped, bytes("GET /quick HTTP/1.1\r\nhost: x\r\n\r\nGET /quick HTTP/1.1\r\nhost: x\r\nconnection: close\r\n\r\n"))?
    let all = io.read_all(net.stream(piped)) catch []
    print(count_status(str(all)))
    net.close(piped)

    let h2c = http.client().with_prior_knowledge(true).with_timeout(100).build()
    let base = "http://127.0.0.1:{l.handle.addr.port}"
    let timed = h2c.get("{base}/h2") catch {
        Timeout => {
            print("client timed out")
            http.response(0, "")
        }
        _ => http.response(-1, "")
    }
    print(timed.status)
    print((<-outcomes) ?? "")
    let quick = h2c.get("{base}/quick") catch {
        _ => http.response(-1, "")
    }
    print(http.text(quick))

    let h1 = http.client().with_version(Http1).build()
    print(cancelled_fetch(h1, "{base}/client-h1", outcomes))
    let h2 = http.client().with_prior_knowledge(true).build()
    print(cancelled_fetch(h2, "{base}/client-h2", outcomes))
    let early = cancel.token()
    cancel.cancel(early)
    print(fetch_status(h1.request("GET", "{base}/quick").with_cancel(early)))
    print(fetch_status(h1.request("GET", "{base}/quick")))
    net.close_listener(l)
}

fn fetch_status(b: http.Builder[http.Response]) -> str {
    let r = b.send() catch {
        Io(Aborted) => return "cancelled"
        Timeout => return "timeout"
        _ => return "other error"
    }
    "{r.status}"
}

fn cancel_later(t: *cancel.Token) {
    sleep(50)
    cancel.cancel(t)
}

fn cancelled_fetch(c: *http.Client, url: str, outcomes: chan[str]) -> str {
    let t = cancel.token()
    spawn cancel_later(t)
    let status = fetch_status(c.request("GET", url).with_cancel(t))
    "{status}, {(<-outcomes) ?? ""}"
}

fn count_status(s: str) -> i64 {
    var n = 0
    var i = 0
    for i + 15 <= s.len {
        if s[i..i + 15] == "HTTP/1.1 200 OK" {
            n += 1
        }
        i += 1
    }
    n
}
