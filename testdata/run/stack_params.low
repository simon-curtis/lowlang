enum Failure {
    Plain
    Coded(code: i64)
}

struct Wide {
    fd: i64
    ip: []u8
    port: i64
    extra: *i64
}

struct Target {
    ip: []u8
    port: i64
}

fn encode(t: Target) -> []u8 {
    var out: []u8 = []
    push(mut out, u8(t.port))
    for b in t.ip {
        push(mut out, b)
    }
    out
}

fn retry(op: fn() -> i64) -> i64 ! Failure {
    let r = op()
    if r < 0 {
        fail Coded(r)
    }
    r
}

fn send(s: Wide, data: []u8, to: Target) -> i64 ! Failure {
    let sa = encode(to)
    retry(fn() -> i64 { s.fd + data.len + i64(sa[0]) + i64(sa[1]) + sa.len })
}

fn main() {
    let w = Wide { fd: 3, ip: [], port: 0, extra: new(0) }
    print(send(w, [1], Target { ip: [127, 0, 0, 1], port: 53 }) catch -1)
}
