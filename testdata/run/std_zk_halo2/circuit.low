import std/crypto/nistec
import std/crypto/pasta
import std/zk/halo2

struct Reference {
    cs: *halo2.ConstraintSystem
    fixed: u64[][][]
    advice: u64[][][]
    equalities: halo2.Equal[]
}

fn numbers(f: *nistec.Field, values: i64[]) -> u64[][] {
    var out: u64[][] = []
    for v in values {
        out.push(pasta.field_from_u64(f, u64(v)))
    }
    out
}

fn cell(column: halo2.Column, row: i64) -> halo2.Cell {
    halo2.Cell { column, row }
}

fn equal(a: halo2.Cell, b: halo2.Cell) -> halo2.Equal {
    halo2.Equal { a, b }
}

fn reference(f: *nistec.Field) -> Reference {
    let cs = halo2.constraint_system()
    let a = halo2.advice_column(cs)
    let b = halo2.advice_column(cs)
    let c = halo2.advice_column(cs)
    let q_mul = halo2.fixed_column(cs)
    let q_rot = halo2.fixed_column(cs)
    let q_look = halo2.fixed_column(cs)
    let table = halo2.fixed_column(cs)
    let inst = halo2.instance_column(cs)
    halo2.enable_equality(cs, a)
    halo2.enable_equality(cs, b)
    halo2.enable_equality(cs, c)
    halo2.enable_equality(cs, inst)

    let mul_q = halo2.query_fixed(cs, q_mul, 0)
    let mul_a = halo2.query_advice(cs, a, 0)
    let mul_b = halo2.query_advice(cs, b, 0)
    let mul_c = halo2.query_advice(cs, c, 0)
    halo2.create_gate(cs, [halo2.mul(mul_q, halo2.sub(halo2.mul(mul_a, mul_b), mul_c))])

    let rot_q = halo2.query_fixed(cs, q_rot, 0)
    let rot_a = halo2.query_advice(cs, a, 1)
    let rot_b = halo2.query_advice(cs, b, 0)
    let rot_c = halo2.query_advice(cs, c, 0)
    halo2.create_gate(cs, [halo2.mul(rot_q, halo2.sub(halo2.sub(rot_a, rot_b), halo2.scale(rot_c, pasta.field_from_u64(f, 5))))])

    let look_q = halo2.query_fixed(cs, q_look, 0)
    let look_a = halo2.query_advice(cs, a, 0)
    halo2.lookup(cs, [halo2.mul(look_q, look_a)], [halo2.query_fixed(cs, table, 0)])

    Reference {
        cs,
        fixed: [
            numbers(f, [1, 1, 1]),
            numbers(f, [0, 0, 0, 1]),
            numbers(f, [0, 0, 0, 0, 1, 1]),
            numbers(f, [0, 3, 5, 17, 30]),
        ],
        advice: [
            numbers(f, [3, 5, 7, 0, 17, 5, 12]),
            numbers(f, [4, 6, 8, 2, 0, 0, 0, 12]),
            numbers(f, [12, 30, 56, 3, 0, 0, 0, 0, 17]),
        ],
        equalities: [
            equal(cell(c, 0), cell(a, 6)),
            equal(cell(a, 6), cell(b, 7)),
            equal(cell(a, 4), cell(c, 8)),
            equal(cell(c, 2), cell(inst, 0)),
        ],
    }
}
