import std/crypto/blake2b
import std/crypto/pasta
import std/text
import std/zk/halo2

struct Counter {
    value: i64
}

fn seeded(seed: str) -> fn(i64) -> u8[] {
    let counter = new(Counter { value: 0 })
    fn(count) {
        var out: u8[] = []
        for out.len < count {
            counter.value += 1
            let digest = blake2b.sum(blake2b.Options {}, bytes("{seed}{counter.value}")) or []
            for b in digest {
                out.push(b)
            }
        }
        out[..count]
    }
}

fn accepts(p: *halo2.Params, vk: *halo2.VerifyingKey, instance: u64[][][], proof: u8[]) -> bool {
    halo2.verify(p, vk, instance, proof) or return false
    true
}

fn same_strings(a: str[], b: str[]) -> bool {
    if a.len != b.len {
        return false
    }
    for i in 0..a.len {
        if a[i] != b[i] {
            return false
        }
    }
    true
}

fn encoded_points(c: *pasta.Curve, points: pasta.Point[]) -> str[] {
    var out: str[] = []
    for p in points {
        out.push(hex(pasta.to_bytes(c, p)))
    }
    out
}

fn circuit_vectors(t: *Tally, files: [str: str]) {
    let c = pasta.vesta()
    let f = c.scalar
    let r = reference(f)
    let p = halo2.params(c, 4)
    let pk = halo2.keygen(p, r.cs, r.fixed, r.equalities) or panic("keygen failed")
    let vk = pk.vk
    let pinned = record(files, "circuit_pinned")
    check(t, "circuit: pinned verification key", pinned.len == 1 && hex(bytes(halo2.pinned(vk))) == pinned[0])
    check(t, "circuit: fixed commitments", same_strings(encoded_points(c, vk.fixed_commitments), record(files, "circuit_fixed_commitments")))
    check(t, "circuit: permutation commitments", same_strings(encoded_points(c, vk.permutation_commitments), record(files, "circuit_permutation_commitments")))
    let instance = [[pasta.field_from_u64(f, 56)]]
    let reference_proof = unhex(record(files, "circuit_proof")[0])
    check(t, "circuit: reference proof is accepted", accepts(p, vk, instance, reference_proof))
    let own = halo2.prove(p, pk, r.advice, instance, seeded("halo2 fixture")) or panic("prove failed")
    check(t, "circuit: own proof is accepted", accepts(p, vk, instance, own))
    check(t, "circuit: own proof is the checked in proof", hex(own) == text.trim(files["low_proof.hex"] ?? ""))
    check(t, "circuit: reference verifier accepts the own proof", same_strings(record(files, "low_proof_verdict"), ["accepted"]))
    check(t, "circuit: proof length", own.len == 1696 && reference_proof.len == own.len)
    tampering(t, p, vk, instance, own, reference_proof)
}

struct Segment {
    label: str
    at: i64
    point: bool
}

fn layout() -> Segment[] {
    var out: Segment[] = []
    for i in 0..13 {
        out.push(Segment { label: "commitment {i}", at: 32 * i, point: true })
    }
    for i in 0..24 {
        out.push(Segment { label: "evaluation {i}", at: 416 + 32 * i, point: false })
    }
    out.push(Segment { label: "quotient commitment", at: 1184, point: true })
    for i in 0..4 {
        out.push(Segment { label: "opening evaluation {i}", at: 1216 + 32 * i, point: false })
    }
    out.push(Segment { label: "inner product commitment", at: 1344, point: true })
    for i in 0..4 {
        out.push(Segment { label: "round {i} left", at: 1376 + 64 * i, point: true })
        out.push(Segment { label: "round {i} right", at: 1408 + 64 * i, point: true })
    }
    out.push(Segment { label: "inner product value", at: 1632, point: false })
    out.push(Segment { label: "inner product blind", at: 1664, point: false })
    out
}

fn replaced(proof: u8[], at: i64, with: u8[]) -> u8[] {
    var out: u8[] = []
    for b in proof {
        out.push(b)
    }
    for i in 0..with.len {
        out[at + i] = with[i]
    }
    out
}

fn tampered_segment(c: *pasta.Curve, proof: u8[], s: Segment) -> u8[] {
    if s.point {
        return replaced(proof, s.at, pasta.to_bytes(c, pasta.generator(c)))
    }
    let f = c.scalar
    let value = pasta.field_from_bytes(f, proof[s.at..s.at + 32]) ?? pasta.field_zero(f)
    replaced(proof, s.at, pasta.field_to_bytes(f, pasta.field_add(f, value, pasta.field_one(f))))
}

fn all_rejected(p: *halo2.Params, vk: *halo2.VerifyingKey, instance: u64[][][], cases: u8[][]) -> bool {
    for proof in cases {
        if accepts(p, vk, instance, proof) {
            return false
        }
    }
    true
}

fn tampering(t: *Tally, p: *halo2.Params, vk: *halo2.VerifyingKey, instance: u64[][][], proof: u8[], other: u8[]) {
    let c = p.curve
    let f = c.scalar
    check(t, "tamper: layout covers the proof", layout().len == 13 + 24 + 1 + 4 + 1 + 8 + 2)
    for part in ["commitment", "evaluation", "opening evaluation", "quotient commitment", "inner product", "round"] {
        var cases: u8[][] = []
        for s in layout() {
            if s.label.starts_with(part) {
                cases.push(tampered_segment(c, proof, s))
                cases.push(tampered_segment(c, other, s))
            }
        }
        check(t, "tamper: every {part} is rejected ({cases.len} proofs)", cases.len > 0 && all_rejected(p, vk, instance, cases))
    }
    check(t, "tamper: a changed public input is rejected", !accepts(p, vk, [[pasta.field_from_u64(f, 57)]], proof))
    check(t, "tamper: a zero public input is rejected", !accepts(p, vk, [[]], proof))
    check(t, "tamper: a public input in the wrong column count is rejected", !accepts(p, vk, [], proof) && !accepts(p, vk, [[pasta.field_from_u64(f, 56)], []], proof))
    var oversized: u64[][] = []
    for _ in 0..usable_rows_of_reference + 1 {
        oversized.push(pasta.field_zero(f))
    }
    check(t, "tamper: more public inputs than usable rows are rejected", !accepts(p, vk, [oversized], proof))
    var prefixes: u8[][] = []
    for len in 0..proof.len {
        prefixes.push(proof[..len])
    }
    check(t, "tamper: every proper prefix is rejected ({prefixes.len} proofs)", all_rejected(p, vk, instance, prefixes))
    check(t, "tamper: a trailing byte is rejected", all_rejected(p, vk, instance, [replaced_append(proof, 0), replaced_append(proof, 1), replaced_append(other, 0)]))
    var flips: u8[][] = []
    for i in 0..proof.len {
        flips.push(replaced(proof, i, [proof[i] ^ u8(1 << (i % 8))]))
    }
    check(t, "tamper: a flipped bit in every byte is rejected ({flips.len} proofs)", all_rejected(p, vk, instance, flips))
}

const usable_rows_of_reference: i64 = 10

fn replaced_append(proof: u8[], extra: u8) -> u8[] {
    var out: u8[] = []
    for b in proof {
        out.push(b)
    }
    out.push(extra)
    out
}
