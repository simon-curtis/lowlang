import std/builder

fn fill(mut b: builder.Builder, n: i64) {
    for i in 0..n {
        b.write_i64(i)
        b.write_byte(',')
    }
}

fn main() {
    var b = builder.builder()
    print(b.len())
    print(b.to_str().len)
    b.write("hello")
    b.write_byte(' ')
    b.write_char('w')
    b.write_char('ö')
    b.write_char('€')
    b.write_char(0x1F600)
    b.write_line("!")
    b.write_i64(-42)
    b.write_byte(' ')
    b.write_f64(1.5)
    b.write_byte(' ')
    b.write_f64(-0.25)
    print(b.to_str())
    print(b.len())

    var numbers = builder.builder()
    for n in [0, 7, -7, 10, 99, 100, 123456789, -9223372036854775807 - 1, 9223372036854775807] {
        numbers.write_i64(n)
        numbers.write_byte(' ')
    }
    print(numbers.to_str())

    b.reset()
    print(b.len())
    b.write("reused")
    let first = b.to_str()
    b.reset()
    b.write("OVERWR")
    print("{first} {b.to_str()}")

    b.truncate(4)
    print(b.to_str())
    b.truncate(100)
    b.truncate(-1)
    print(b.to_str())
    b.write_bytes(bytes("+raw"))
    print(b.to_str())
    print(str(b.to_bytes()))

    var joined = builder.builder()
    joined.write_join(["a", "b", "c"], ", ")
    joined.write_repeat("-", 3)
    joined.write_join([], "x")
    joined.write_join(["only"], "x")
    print(joined.to_str())

    var sized = builder.with_capacity(64)
    print(sized.len())
    print(sized.capacity())
    sized.write("0123456789")
    print(sized.capacity())
    sized.reserve(100)
    print(sized.len())
    print(sized.capacity() >= 110)
    print(sized.to_str())

    var big = builder.builder()
    fill(mut big, 200000)
    print(big.len())
    let text = big.to_str()
    print(text[..12])
    print(text[text.len - 14..])

    var wide = builder.builder()
    for _ in 0..100000 {
        wide.write("ab")
        wide.write_char('é')
    }
    print(wide.len())
}
