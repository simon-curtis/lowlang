import std/serde
import std/toml

enum Shape {
    Circle(radius: f64)
    Rect(f64, f64)
    Empty
}

struct Server {
    host: str
    port: u16
    tags: []str
}

struct Column[T] {
    values: []T
}

struct Config {
    title: str
    started: str
    ratio: f64
    big: u64
    enabled: bool
    owner: str?
    nickname: str?
    limits: [str: i64]
    servers: []Server
    shapes: []Shape
    key: []u8
}

fn show_error(source: str) {
    let t = toml.parse(source) catch {
        Syntax(line, column, message) => {
            print("{line}:{column} {message}")
            return
        }
    }
    print("accepted {t.keys.len} keys")
}

fn serialize_report[T](v: T) -> str {
    toml.serialize(v) catch {
        Syntax(at, message) => "syntax {at}: {message}"
        Mismatch(expected, at) => "mismatch {expected} at {at}"
        Missing(field) => "missing {field}"
        UnknownVariant(name) => "unknown variant {name}"
        Range(at) => "range at {at}"
        TooDeep => "too deep"
        TooLarge => "too large"
    }
}

fn deserialize_report[T](source: str) -> str {
    let v: T = toml.deserialize(source) catch {
        Syntax(at, message) => return "syntax {at}: {message}"
        Mismatch(expected, at) => return "mismatch {expected} at {at}"
        Missing(field) => return "missing {field}"
        UnknownVariant(name) => return "unknown variant {name}"
        Range(at) => return "range at {at}"
        TooDeep => return "too deep"
        TooLarge => return "too large"
    }
    "ok"
}

fn bell() -> str {
    let b: []u8 = ['a', ' ', '=', ' ', '"', 7, '"', '\n']
    str(b)
}

fn document() -> str {
    "title = \"TOML \\\"example\\\" \\u00e9\"\n\n[owner]\nname = 'Tom Preston-Werner'\ndob = 1979-05-27T07:32:00-08:00\n\n[database]\nenabled = true\nports = [ 8000, 8001, 8002 ]\ndata = [ [\"delta\", \"phi\"], [3.14] ]\ntemp_targets = {{ cpu = 79.5, case = 72.0 }}\n\n[servers]\n\n[servers.alpha]\nip = \"10.0.0.1\"\nrole = \"frontend\"\n\n[[products]]\nname = \"Hammer\"\nsku = 738_594_937\n\n[[products]]\n\n[[products]]\nname = \"Nail\"\nsku = 0x10\ncolor = \"gray\"\nsite.\"google.com\" = true\nnums = [0o17, 0b101, +1e3, -inf, nan]\nwhen = [1979-05-27, 07:32:00.999999999, 1979-05-27 07:32:00]\nlines = \"\"\"\nRoses\\\n    are red\"\"\"\n"
}

fn main() {
    let t = toml.parse(document()) catch {
        Syntax(line, column, message) => {
            print("{line}:{column} {message}")
            return
        }
    }
    print(toml.text(t, "title") ?? "?")
    print(toml.text(t, "owner.name") ?? "?")
    match toml.get(t, "owner.dob") {
        some(v) => print(toml.datetime_text(v) ?? "?")
        none => print("missing dob")
    }
    print((toml.datetime(t, "owner.dob") ?? toml.DateTime {}).offset)
    print(toml.boolean(t, "database.enabled") ?? false)
    print((toml.array(t, "database.ports") ?? []).len)
    print(toml.float(t, "database.temp_targets.cpu") ?? 0.0)
    print(toml.text(t, "servers.alpha.ip") ?? "?")
    print(toml.integer(t, "servers.alpha.ip") ?? -1)
    print(toml.integer(t, "missing.key") ?? -1)
    match toml.table(t, "servers") {
        some(s) => print(s.keys.len)
        none => print("no servers")
    }
    let products = toml.array(t, "products") ?? []
    print(products.len)
    match products[2] {
        Table(p) => {
            print(toml.integer(p, "sku") ?? -1)
            print(toml.boolean(p, "site.\"google.com\"") ?? false)
            print(toml.text(p, "lines") ?? "?")
        }
        _ => print("not a table")
    }
    print(toml.encode(t))

    show_error("a = 1\nb = 2\na = 3\n")
    show_error("[a]\nx = 1\n[a]\n")
    show_error("a.b = 1\n[a.b]\n")
    show_error("[a.b]\n[a]\nb.c = 1\n")
    show_error("a = {{b = 1}}\n[a.c]\n")
    show_error("a = []\n[[a]]\n")
    show_error("[[a]]\n[a]\n")
    show_error("a = {{b = 1,}}\n")
    show_error("a = \"\\q\"\n")
    show_error(bell())
    show_error("a = 9223372036854775808\n")
    show_error("a = 0_1\n")
    show_error("a = 1__0\n")
    show_error("a = 1979-02-30\n")
    show_error("a = 1979-05-27T25:00:00\n")
    show_error("a = 1\nb = \"\"\"never closed\n")
    show_error("a = 1 b = 2\n")
    show_error("[x]\ny.z = 1\n[x.y.w]\n")

    var config = Config {
        title: "demo"
        started: "1979-05-27T07:32:00Z"
        ratio: 0.25
        big: 18000000000000000000
        enabled: true
        owner: "ops"
        nickname: none
        limits: ["cpu": 4, "memory": 1024]
        servers: [Server { host: "a", port: 80, tags: ["x", "y"] }, Server { host: "b", port: 443, tags: [] }]
        shapes: [Circle(2.0), Rect(1.0, 2.0), Empty]
        key: [1, 2, 3, 255]
    }
    print(serialize_report(config))
    config.big = 7
    let encoded = serialize_report(config)
    print(encoded)
    let back: Config = toml.deserialize(encoded) or {
        print("deserialize failed")
        return
    }
    print(back.title == config.title && back.big == 7 && back.ratio == 0.25 && back.owner == config.owner)
    print(back.nickname == none && (back.limits["memory"] ?? 0) == 1024 && back.servers.len == 2)
    print(back.servers[0].tags.len == 2 && back.servers[1].port == 443 && back.shapes.len == 3)
    print(back.shapes[1] == Rect(1.0, 2.0) && back.key.len == 4 && back.key[3] == 255)

    let dated: Config = toml.deserialize("title = \"t\"\nstarted = 1979-05-27T07:32:00.5+01:30\nratio = 1\nbig = 1\nenabled = false\nlimits = {{}}\nservers = []\nshapes = []\nkey = \"\"\n") or {
        print("dated failed")
        return
    }
    print(dated.started)
    print(dated.ratio)

    print(deserialize_report[Config]("title = 1\n"))
    print(deserialize_report[Config]("title = \"x\"\n"))
    print(deserialize_report[Server]("host = \"a\"\nport = 70000\ntags = []\n"))
    print(deserialize_report[Server]("host = \n"))
    print(deserialize_report[Server]("host = \"a\"\nport = 1\ntags = [1]\n"))
    print(serialize_report(5))
    let holes = Column[i64?] { values: [1, none] }
    print(serialize_report(holes))
    let optional: [str: i64?] = ["a": none, "b": 2]
    print(serialize_report(optional))
}
