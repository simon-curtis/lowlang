import std/http
import std/io
import std/net

fn serve(l: net.ListenerHandle) {
    let handler = fn(req: http.Request) -> http.Response { http.response(200, req.remote) }
    for {
        let h = net.accept_handle(l) or return
        spawn http.serve_conn_on(h, handler)
    }
}

fn body(c: *http.Client, url: str) -> str {
    let r = c.get(url) or return "request failed"
    http.text(r)
}

fn main() ! io.Error {
    using l = net.listen("127.0.0.1", 0)?
    spawn serve(l.handle)
    let url = "http://127.0.0.1:{l.handle.addr.port}/"
    print(body(http.client().with_version(Http1).build(), url))
    print(body(http.client().with_prior_knowledge(true).build(), url))
    print(http.new_request("GET", "/").remote.len)
    for check in [["100.101.1.2", "100.64.0.0/10"], ["100.128.0.1", "100.64.0.0/10"], ["192.168.0.12", "192.168.0.0/24"], ["::1", "::1/128"], ["10.0.0.1", "::/0"], ["10.0.0.1", "10.0.0.0/40"], ["10.0.0.1", "10.0.0.0"], ["10.0.0.0", "10.0.0.0/32"], ["10.0.0.0", "10.0.0.0/33"]] {
        print(net.in_network(net.parse_ip(check[0])?, check[1]))
    }
    net.close_listener(l)
}
