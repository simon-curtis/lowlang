import std/file
import std/io

fn pattern(n: i64) -> u8[] {
    let out = io.buffer(n)
    for i in 0..n {
        out[i] = u8(i % 251)
    }
    out
}

fn describe(e: io.Error) -> str {
    match e {
        Invalid => "Invalid"
        Denied => "Denied"
        Unsupported => "Unsupported"
        NotConnected => "NotConnected"
        TooLarge => "TooLarge"
        _ => "other"
    }
}

fn outcome(f: file.File, mode: file.MapMode, offset: i64, length: i64) -> str {
    using m = file.map(f, mode, offset, length) catch {
        e => return describe(e)
    }
    "ok {m.data.len}"
}

fn anonymous_outcome(mode: file.MapMode, length: i64) -> str {
    using m = file.map_anonymous(mode, length) catch {
        e => return describe(e)
    }
    "ok {m.data.len}"
}

fn matches_pattern(data: u8[], offset: i64) -> bool {
    for i in 0..data.len {
        if data[i] != u8((offset + i) % 251) {
            return false
        }
    }
    true
}

fn count_differences(a: u8[], b: u8[]) -> i64 {
    var n = 0
    for i in 0..a.len {
        if a[i] != b[i] {
            n += 1
        }
    }
    n
}

fn churn() -> i64 {
    var kept = 0
    for i in 0..400 {
        let garbage = io.buffer(100000)
        garbage[0] = u8(i)
        kept += i64(garbage[0])
    }
    kept
}

fn read_only(path: str) ! io.Error {
    using f = file.open(path)?
    using whole = file.map(f, file.MapMode.ReadOnly, 0, 0)?
    print("whole {whole.data.len} {matches_pattern(whole.data, 0)}")
    using tail = file.map(f, file.MapMode.ReadOnly, 99000, 0)?
    print("tail {tail.data.len} {matches_pattern(tail.data, 99000)}")
    using unaligned = file.map(f, file.MapMode.ReadOnly, 70001, 123)?
    print("unaligned {unaligned.data.len} {matches_pattern(unaligned.data, 70001)}")
    using aligned = file.map(f, file.MapMode.ReadOnly, 65536, 4096)?
    print("aligned {aligned.data.len} {matches_pattern(aligned.data, 65536)}")
    using last = file.map(f, file.MapMode.ReadOnly, 99999, 1)?
    print("last {last.data.len} {last.data[0] == u8(99999 % 251)}")
    churn()
    print("after churn {matches_pattern(whole.data, 0)}")
    print("bounds {outcome(f, file.MapMode.ReadOnly, 0, 100001)}")
    print("past end {outcome(f, file.MapMode.ReadOnly, 100001, 0)}")
    print("at end {outcome(f, file.MapMode.ReadOnly, 100000, 0)}")
    print("negative offset {outcome(f, file.MapMode.ReadOnly, -1, 10)}")
    print("negative length {outcome(f, file.MapMode.ReadOnly, 0, -1)}")
    print("shared on read only {outcome(f, file.MapMode.Shared, 0, 10)}")
    print("private on read only {outcome(f, file.MapMode.Private, 0, 10)}")
    file.sync_map(whole, file.Flush.Wait)?
    file.sync_map(whole, file.Flush.Queue)?
    for advice in [file.Advice.Normal, file.Advice.Random, file.Advice.Sequential, file.Advice.WillNeed] {
        file.advise_map(whole, advice)?
    }
    print("advice ok")
    file.close(f)
    print("after close {matches_pattern(whole.data, 0)}")
    print("closed {outcome(f, file.MapMode.ReadOnly, 0, 10)}")
}

fn shared(path: str, original: u8[]) ! io.Error {
    using f = file.update(path)?
    using m = file.map(f, file.MapMode.Shared, 0, 0)?
    let bytes = m.data
    bytes[0] = 0xAA
    bytes[4095] = 0xBB
    bytes[4096] = 0xCC
    bytes[bytes.len - 1] = 0xDD
    file.sync_map(m, file.Flush.Wait)?
    let after = file.read_file(path)?
    print("shared size {after.len}")
    print("shared bytes {after[0] == 0xAA} {after[4095] == 0xBB} {after[4096] == 0xCC} {after[after.len - 1] == 0xDD}")
    print("shared differences {count_differences(after, original)}")
    bytes[1] = 0x11
    file.sync_map(m, file.Flush.Queue)?
    file.sync_map(m, file.Flush.Wait)?
    print("queued {file.read_file(path)?[1] == 0x11}")
    using second = file.map(f, file.MapMode.Shared, 0, 16)?
    print("second sees {second.data[0] == 0xAA} {second.data[1] == 0x11}")
    second.data[2] = 0x22
    print("first sees {bytes[2] == 0x22}")
    let window = 65536 + 1000
    using inner = file.map(f, file.MapMode.Shared, window, 8)?
    inner.data[0] = 0x77
    file.sync_map(inner, file.Flush.Wait)?
    print("window {file.read_file(path)?[window] == 0x77}")
}

fn private(path: str) ! io.Error {
    let before = file.read_file(path)?
    using f = file.update(path)?
    using m = file.map(f, file.MapMode.Private, 0, 0)?
    let bytes = m.data
    bytes[0] = 0xEE
    bytes[bytes.len - 1] = 0xEF
    file.sync_map(m, file.Flush.Wait)?
    print("private reads back {bytes[0] == 0xEE} {bytes[bytes.len - 1] == 0xEF}")
    let after = file.read_file(path)?
    print("private file unchanged {count_differences(before, after)}")
    file.write_all(f, [0x01, 0x02, 0x03])?
    print("write by file {bytes[0] == 0xEE}")
    using other = file.map(f, file.MapMode.Private, 0, 4)?
    print("other private {other.data[0] == 0x01} {other.data[2] == 0x03}")
}

fn empty(dir: str) ! io.Error {
    let path = "{dir}/empty"
    file.write_file(path, [])?
    using f = file.update(path)?
    using m = file.map(f, file.MapMode.Shared, 0, 0)?
    print("empty {m.data.len}")
    file.sync_map(m, file.Flush.Wait)?
    file.advise_map(m, file.Advice.WillNeed)?
    print("empty past {outcome(f, file.MapMode.Shared, 0, 1)}")
    print("empty offset {outcome(f, file.MapMode.Shared, 1, 0)}")
    file.truncate(f, 8192)?
    using grown = file.map(f, file.MapMode.Shared, 0, 0)?
    print("grown {grown.data.len} {grown.data[8191]}")
    grown.data[8191] = 9
    file.sync_map(grown, file.Flush.Wait)?
    print("grown file {file.read_file(path)?[8191]}")
}

fn modes(dir: str) ! io.Error {
    let path = "{dir}/modes"
    using writer = file.create(path)?
    file.write_all(writer, pattern(5000))?
    print("write only read {outcome(writer, file.MapMode.ReadOnly, 0, 10)}")
    print("write only shared {outcome(writer, file.MapMode.Shared, 0, 10)}")
    using folder = file.open(dir)?
    print("directory {outcome(folder, file.MapMode.ReadOnly, 0, 0)}")
}

fn anonymous() ! io.Error {
    using region = file.map_anonymous(file.MapMode.Private, 100000)?
    print("anonymous {region.data.len} {region.data[0]} {region.data[99999]}")
    region.data[0] = 1
    region.data[99999] = 2
    churn()
    print("anonymous kept {region.data[0]} {region.data[99999]}")
    var grown = region.data
    grown.push(7)
    var head = region.data[..10]
    head.push(9)
    print("push {grown.len} {region.data.len} {grown[100000]} {region.data[99999]} {head.len} {region.data[10]}")
    using shared = file.map_anonymous(file.MapMode.Shared, 4096)?
    shared.data[10] = 5
    file.sync_map(shared, file.Flush.Wait)?
    file.advise_map(shared, file.Advice.Sequential)?
    print("shared anonymous {shared.data.len} {shared.data[10]}")
    using zeros = file.map_anonymous(file.MapMode.ReadOnly, 5000)?
    print("read only anonymous {zeros.data.len} {zeros.data[4999]}")
    using none = file.map_anonymous(file.MapMode.Private, 0)?
    print("anonymous zero {none.data.len}")
    print("anonymous negative {anonymous_outcome(file.MapMode.Private, -1)}")
}

fn early_unmap() ! io.Error {
    using var m = file.map_anonymous(file.MapMode.Private, 8192)?
    m.data[0] = 3
    print("before unmap {m.data.len} {m.data[0]}")
    file.unmap(mut m)
    print("after unmap {m.data.len}")
    file.unmap(mut m)
    print("unmapped twice {m.data.len}")
}

fn many(path: str) ! io.Error {
    using f = file.open(path)?
    var total = 0
    for i in 0..300 {
        using m = file.map(f, file.MapMode.ReadOnly, i * 100, 50)?
        total += i64(m.data[0])
    }
    print("many {total}")
}

fn main() ! io.Error {
    let dir = file.temp_dir("low-std-map-")?
    let path = "{dir}/data"
    let original = pattern(100000)
    file.write_file(path, original)?
    read_only(path)?
    shared(path, original)?
    private(path)?
    empty(dir)?
    modes(dir)?
    anonymous()?
    early_unmap()?
    file.write_file("{dir}/fresh", original)?
    many("{dir}/fresh")?
    file.remove_all(dir)?
}
