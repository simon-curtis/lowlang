enum Err {
    Bad
    Coded(code: i64)
}

struct Point {
    x: i64
    y: i64
}

struct Slot {
    n: i64
    closed: fn(Err?)
}

struct Probe {
    seen: fn(Point?) -> i64
    made: fn() -> Err?
}

struct Node[T] {
    value: T
    visit: fn(Node[T]?) -> i64
}

fn report(e: Err?) {
    match e {
        some(err) => {
            match err {
                Bad => print("closed: bad")
                Coded(code) => print("closed: code {code}")
            }
        }
        none => print("closed: clean")
    }
}

fn sum(p: Point?) -> i64 {
    match p {
        some(q) => q.x + q.y
        none => -1
    }
}

fn coded() -> Err? {
    Err.Coded(7)
}

fn depth(n: Node[i64]?) -> i64 {
    match n {
        some(node) => node.value
        none => 0
    }
}

fn run_slot(s: Slot) {
    s.closed(none)
    s.closed(Err.Coded(s.n))
}

fn run_probe(p: *Probe) {
    print("seen {p.seen(Point { x: 3, y: 4 })} {p.seen(none)}")
    match p.made() {
        some(e) => report(e)
        none => print("made nothing")
    }
}

fn main() {
    let s = new(Slot { n: 1, closed: report })
    s.closed(Err.Bad)
    run_slot(Slot { n: 2, closed: report })
    run_probe(new(Probe { seen: sum, made: coded }))
    let node = new(Node[i64] { value: 5, visit: depth })
    print("visit {node.visit(*node)} {node.visit(none)}")
}
