import std/simd

fn exercise_u8x16(data: []u8) {
    let a: u8x16 = simd.read(data, 0)
    let b: u8x16 = simd.read(data, 16)
    let s: u8x16 = simd.splat(u8(3))
    print(a + b)
    print(a - b)
    print(a * b)
    print(a & b)
    print(a | b)
    print(a ^ b)
    print(a == b)
    print(a != b)
    print(a < b)
    print(a <= b)
    print(a > b)
    print(a >= b)
    print(a << 3)
    print(a >> 3)
    print(~a)
    print(simd.min(a, b))
    print(simd.max(a, b))
    print(simd.blend(a < b, a, s))
    print(simd.mask(a == b))
}

