fn main() {
    var d_u8x16: []u8 = []
    for k in 0..32 {
        d_u8x16.push(u8(k * 7 % 11 + 1))
    }
    exercise_u8x16(d_u8x16)
    var d_u8x32: []u8 = []
    for k in 0..64 {
        d_u8x32.push(u8(k * 7 % 11 + 1))
    }
    exercise_u8x32(d_u8x32)
    var d_u16x8: []u16 = []
    for k in 0..16 {
        d_u16x8.push(u16(k * 7 % 11 + 1))
    }
    exercise_u16x8(d_u16x8)
    var d_u16x16: []u16 = []
    for k in 0..32 {
        d_u16x16.push(u16(k * 7 % 11 + 1))
    }
    exercise_u16x16(d_u16x16)
    var d_i32x4: []i32 = []
    for k in 0..8 {
        d_i32x4.push(i32(k * 7 % 11 + 1))
    }
    exercise_i32x4(d_i32x4)
    var d_i32x8: []i32 = []
    for k in 0..16 {
        d_i32x8.push(i32(k * 7 % 11 + 1))
    }
    exercise_i32x8(d_i32x8)
    var d_u32x4: []u32 = []
    for k in 0..8 {
        d_u32x4.push(u32(k * 7 % 11 + 1))
    }
    exercise_u32x4(d_u32x4)
    var d_u32x8: []u32 = []
    for k in 0..16 {
        d_u32x8.push(u32(k * 7 % 11 + 1))
    }
    exercise_u32x8(d_u32x8)
    var d_i64x2: []i64 = []
    for k in 0..4 {
        d_i64x2.push(i64(k * 7 % 11 + 1))
    }
    exercise_i64x2(d_i64x2)
    var d_i64x4: []i64 = []
    for k in 0..8 {
        d_i64x4.push(i64(k * 7 % 11 + 1))
    }
    exercise_i64x4(d_i64x4)
    var d_u64x2: []u64 = []
    for k in 0..4 {
        d_u64x2.push(u64(k * 7 % 11 + 1))
    }
    exercise_u64x2(d_u64x2)
    var d_u64x4: []u64 = []
    for k in 0..8 {
        d_u64x4.push(u64(k * 7 % 11 + 1))
    }
    exercise_u64x4(d_u64x4)
    var d_f32x4: []f32 = []
    for k in 0..8 {
        d_f32x4.push(f32(k * 7 % 11 + 1))
    }
    exercise_f32x4(d_f32x4)
    var d_f32x8: []f32 = []
    for k in 0..16 {
        d_f32x8.push(f32(k * 7 % 11 + 1))
    }
    exercise_f32x8(d_f32x8)
    var d_f64x2: []f64 = []
    for k in 0..4 {
        d_f64x2.push(f64(k * 7 % 11 + 1))
    }
    exercise_f64x2(d_f64x2)
    var d_f64x4: []f64 = []
    for k in 0..8 {
        d_f64x4.push(f64(k * 7 % 11 + 1))
    }
    exercise_f64x4(d_f64x4)
}
