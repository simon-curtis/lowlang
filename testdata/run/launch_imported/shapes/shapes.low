import std/gpu

pub kernel fn double(id: u32, values: u32[], mut doubled: u32[]) {
    doubled[id] = values[id] * 2
}

pub fn tripled(values: u32[]) -> u32[] {
    var out: u32[] = [0, 0, 0]
    gpu.run_on_cpu(launch(triple, 3, values, mut out))
    out
}

kernel fn triple(id: u32, values: u32[], mut tripled: u32[]) {
    tripled[id] = values[id] * 3
}
