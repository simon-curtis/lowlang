fn ownership(l: net.Listener, st: *Store) ! smtp.Error {
    using c = smtp.connect(options(l))?
    let view = c.handle
    smtp.noop(c)?
    smtp.close_client(c)
    smtp.close_client(c)
    smtp.noop(c) catch {
        e => print("owner after close: {describe(e)}")
    }
    print("view after close: {outcome(fn() ! smtp.Error { smtp.noop_on(view)? })}")
    settle(st)

    using var moved = smtp.connect(options(l))?
    let kept = smtp.detach(mut moved)
    using again = smtp.adopt(kept)
    smtp.noop(again)?
    print("adopted noop ok")
    smtp.quit(again)
    settle(st)
}

fn leave(l: net.Listener, st: *Store) ! smtp.Error {
    using c = smtp.connect(options(l))?
    smtp.noop(c)?
}

fn deliver_one(h: *smtp.ClientHandle, subject: str, done: chan[str]) {
    let result = smtp.send_on(h, letter(subject, "from a worker\n")) catch {
        e => {
            done <- "{subject}: {describe(e)}"
            return
        }
    }
    done <- "{subject}: {result.code}"
}

fn shared(l: net.Listener, st: *Store) ! smtp.Error {
    using c = smtp.connect(options(l))?
    let h = c.handle
    let done = chan[str](8)
    for i in 0..6 {
        spawn deliver_one(h, "worker {i}", done)
    }
    var results: []str = []
    for _ in 0..6 {
        let one = <-done
        push(mut results, one ?? "?")
    }
    slices.sort(mut results)
    for r in results {
        print("  {r}")
    }
    var subjects: []str = []
    for r in stored(st) {
        let cut = text.cut(r.data, "Subject: ")
        push(mut subjects, text.cut(cut.after, "\r\n").before)
    }
    slices.sort(mut subjects)
    print("stored: {text.join(subjects, ", ")}")
    var clean = true
    for r in stored(st) {
        if !text.contains(r.data, "from a worker") {
            clean = false
        }
    }
    print("messages intact: {flag(clean)}")
}

fn roots() -> []x509.Certificate {
    var out: []x509.Certificate = []
    for der in x509.pem_blocks(embed("std_tls_ca.pem"), "CERTIFICATE") {
        push(mut out, x509.parse(der) catch {
            _ => return out
        })
    }
    out
}

fn server_config() -> tls.Config {
    let pem = embed("std_tls_ec.pem")
    let key = tls.load_key(pem) catch {
        _ => return tls.Config {}
    }
    tls.Config { certificates: tls.load_certificates(pem), key }
}

fn client_config(name: str) -> tls.Config {
    tls.Config { server_name: name, roots: roots() }
}

