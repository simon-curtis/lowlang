fn stuffing(l: net.Listener, st: *Store) ! smtp.Error {
    using c = smtp.connect(options(l))?
    let body = "before\n.\n..\n.hidden\nafter\n"
    let m = letter("Dots", body)
    let sent = smtp.send(c, m)?
    print("dots: {sent.code} matches={flag(matches(st, 0, m))} stored={stored(st).len}")

    let smuggle = smtp.Envelope { from: "ada@example.com", to: ["bob@example.org"] }
    let raw = "hello\r\n.\r\nMAIL FROM:<evil@example.com>\r\nRCPT TO:<victim@example.org>\r\nDATA\r\nsmuggled\r\n"
    let second = smtp.send_raw(c, smuggle, bytes(raw))?
    let all = stored(st)
    print("smuggle: {second.code} stored={all.len} data={text.quote(all[1].data)}")

    let bare = smtp.send_raw(c, smuggle, bytes("a\n.\nb\n"))?
    let more = stored(st)
    print("bare lf: {bare.code} data={text.quote(more[2].data)}")

    let empty = smtp.send_raw(c, smtp.Envelope { from: "", to: ["bob@example.org"] }, [])?
    let last = stored(st)
    print("null sender: {empty.code} from={text.quote(last[3].from)} data={text.quote(last[3].data)}")
    smtp.quit(c)
    dialogue(st)
    settle(st)
}

fn invalid_input(l: net.Listener, st: *Store) ! smtp.Error {
    using c = smtp.connect(options(l))?
    let h = c.handle
    var injected = letter("Hello\r\nBcc: evil@example.com", "x\n")
    print("subject injection: {outcome(fn() ! smtp.Error { smtp.send_on(h, injected)? })}")
    var nobody = letter("Nobody", "x\n")
    nobody.to = []
    print("no recipients: {outcome(fn() ! smtp.Error { smtp.send_on(h, nobody)? })}")
    var odd = letter("Odd", "x\n")
    odd.to = [mail.address("bob@example.org\r\nRCPT TO:<evil@example.com>")]
    print("recipient injection: {outcome(fn() ! smtp.Error { smtp.send_on(h, odd)? })}")
    let raw_from = smtp.Envelope { from: "a b", to: ["bob@example.org"] }
    print("raw bad sender: {outcome(fn() ! smtp.Error { smtp.send_raw_on(h, raw_from, bytes("x"))? })}")
    let raw_to = smtp.Envelope { from: "ada@example.com", to: ["x@y\r\nDATA"] }
    print("raw bad recipient: {outcome(fn() ! smtp.Error { smtp.send_raw_on(h, raw_to, bytes("x"))? })}")
    let raw_none = smtp.Envelope { from: "ada@example.com", to: [] }
    print("raw no recipients: {outcome(fn() ! smtp.Error { smtp.send_raw_on(h, raw_none, bytes("x"))? })}")
    smtp.noop(c)?
    print("still usable")
    smtp.quit(c)
    dialogue(st)
    settle(st)
    print("nothing stored: {flag(stored(st).len == 0)}")
}

