    var bad_token = signed_in(l, smtp.Mechanism.XOAuth2)
    bad_token.password = "expired"
    let third = outcome(fn() ! smtp.Error {
        using c = smtp.connect(bad_token)?
    })
    print("bad token: {third}")
    settle(st)
    dialogue(st)

    var cram = signed_in(l, smtp.Mechanism.CramMd5)
    cram.password = "wrong"
    let fourth = outcome(fn() ! smtp.Error {
        using c = smtp.connect(cram)?
    })
    print("wrong cram password: {fourth}")
    settle(st)
    dialogue(st)
}

