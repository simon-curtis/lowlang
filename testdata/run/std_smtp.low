    settle(st)
}

fn many_recipients(c: smtp.Client, st: *Store) ! smtp.Error {
    var m = letter("Crowd", "to everyone\n")
    m.to = [mail.address("bob@example.org"), mail.address("nouser1@example.org")]
    m.cc = [mail.address("carol@example.org")]
    m.bcc = [mail.address("dave@example.org")]
    let receipt = smtp.send(c, m)?
    print("partial: {describe_receipt(receipt)}")
    let all = stored(st)
    print("stored to: {text.join(all[all.len - 1].to, ",")}")
}

fn refusals(h: *smtp.ClientHandle) {
    var none_left = letter("Nobody", "x\n")
    none_left.to = [mail.address("nouser1@example.org"), mail.address("nouser2@example.org")]
    print("all permanent: {outcome(fn() ! smtp.Error { smtp.send_on(h, none_left)? })}")

    var busy = letter("Busy", "x\n")
    busy.to = [mail.address("later@example.org")]
    print("all transient: {outcome(fn() ! smtp.Error { smtp.send_on(h, busy)? })}")

    var blocked = letter("Blocked", "x\n")
    blocked.from = mail.address("blocked@example.org")
    print("sender refused: {outcome(fn() ! smtp.Error { smtp.send_on(h, blocked)? })}")

    let rejected = letter("REJECT this", "x\n")
    print("data rejected: {outcome(fn() ! smtp.Error { smtp.send_on(h, rejected)? })}")
    let deferred = letter("DEFER this", "x\n")
    print("data deferred: {outcome(fn() ! smtp.Error { smtp.send_on(h, deferred)? })}")
}

fn deliveries(l: net.Listener, st: *Store) ! smtp.Error {
    using c = smtp.connect(options(l))?
    many_recipients(c, st)?
    refusals(c.handle)
    let after = smtp.send(c, letter("After failures", "still works\n"))?
    print("after failures: {describe_receipt(after)}")
    smtp.quit(c)
    dialogue(st)
    settle(st)
    var subjects: []str = []
    for r in stored(st) {
        let cut = text.cut(r.data, "Subject: ")
        push(mut subjects, text.cut(cut.after, "\r\n").before)
    }
    print("stored subjects: {text.join(subjects, ", ")}")
}

fn pipelined(l: net.Listener, st: *Store, label: str) ! smtp.Error {
    using c = smtp.connect(options(l))?
    let h = c.handle
    var m = letter("Pipe", "x\n")
    m.to = [mail.address("bob@example.org"), mail.address("nouser1@example.org"), mail.address("carol@example.org")]
    let receipt = smtp.send(c, m)?
    print("{label}: {describe_receipt(receipt)}")
    let mail_refused = letter("Pipe two", "x\n")
    var blocked = mail_refused
    blocked.from = mail.address("blocked@example.org")
    print("{label} sender refused: {outcome(fn() ! smtp.Error { smtp.send_on(h, blocked)? })}")
    var later = letter("Pipe three", "x\n")
    later.to = [mail.address("later@example.org")]
    print("{label} recipient refused: {outcome(fn() ! smtp.Error { smtp.send_on(h, later)? })}")
    let last = smtp.send(c, letter("Pipe four", "x\n"))?
    print("{label} afterwards: {last.code}")
    smtp.quit(c)
    dialogue(st)
    settle(st)
    sync.lock(st.gate)
    let batches = st.batches
    sync.unlock(st.gate)
    print("{label} batched commands: {flag(batches > 0)}")
}

fn extension_use(l: net.Listener, st: *Store) ! smtp.Error {
    using c = smtp.connect(options(l))?
    let h = c.handle
    let plain_one = letter("Plain", "ascii only\n")
    let sent = smtp.send(c, plain_one)?
    let all = stored(st)
    let rendered = mail.render(plain_one) catch {
        _ => ""
    }
    print("size parameter: {all[0].params} rendered={rendered.len} reply={sent.code}")

    var wide = letter("8bit", "Grüße\n")
    wide.eight_bit = true
    let second = smtp.send(c, wide)?
    print("8bit: params={stored(st)[1].params} reply={second.code} matches={flag(matches(st, 1, wide))}")

    var utf8 = letter("International", "hi\n")
    utf8.to = [mail.address("jörg@exämple.org")]
    let third = smtp.send(c, utf8)?
    print("smtputf8: params={stored(st)[2].params} to={stored(st)[2].to[0]} reply={third.code}")

    var huge = letter("Huge", text.repeat("0123456789abcdef\n", 200))
    print("over size: {outcome(fn() ! smtp.Error { smtp.send_on(h, huge)? })}")
    smtp.quit(c)
    dialogue(st)
    settle(st)
}

