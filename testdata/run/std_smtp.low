import std/base64
import std/crypto/x509
import std/io
import std/mail
import std/net
import std/slices
import std/smtp
import std/sync
import std/text
import std/time/offset
import std/time/timestamp
import std/time/zone
import std/time/zoned
import std/tls

struct Settings {
    starttls: bool = false
    auth: str = ""
    size: i64 = 0
    eight_bit: bool = false
    utf8: bool = false
    pipelining: bool = false
    ehlo_unknown: bool = false
    require_auth: bool = false
}

struct Received {
    from: str
    to: []str
    params: str
    data: str
}

struct Store {
    gate: sync.Mutex
    settings: Settings
    config: tls.Config
    messages: []Received
    log: []str
    batches: i64
    sessions: i64
    ended: chan[str]
}

struct Session {
    st: *Store
    stream: io.Stream
    reader: *io.Reader
    encrypted: bool
    greeted: bool
    authed: bool
    has_from: bool
    from: str
    params: str
    accepted: []str
    upgrade: bool
    done: bool
}

fn new_store(settings: Settings, config: tls.Config) -> *Store {
    new(Store {
        gate: sync.mutex()
        settings
        config
        messages: []
        log: []
        batches: 0
        sessions: 0
        ended: chan[str](64)
    })
}

fn open_session(st: *Store, stream: io.Stream, encrypted: bool) -> *Session {
    new(Session {
        st
        stream
        reader: io.reader(stream)
        encrypted
        greeted: false
        authed: false
        has_from: false
        from: ""
        params: ""
        accepted: []
        upgrade: false
        done: false
    })
}

fn record(st: *Store, line: str) {
    sync.lock(st.gate)
    push(mut st.log, line)
    sync.unlock(st.gate)
}

fn say(s: *Session, reply: str) {
    io.write_str(s.stream, reply) catch {
        _ => {
            s.done = true
        }
    }
}

fn offers(list: str, mechanism: str) -> bool {
    for m in text.fields(list) {
        if m == mechanism {
            return true
        }
    }
    false
}

fn extension_lines(s: *Session) -> []str {
    let set = s.st.settings
    var lines = ["fake.example Hello"]
    if set.size > 0 {
        push(mut lines, "SIZE {set.size}")
    }
    if set.pipelining {
        push(mut lines, "PIPELINING")
    }
    if set.eight_bit {
        push(mut lines, "8BITMIME")
    }
    if set.utf8 {
        push(mut lines, "SMTPUTF8")
    }
    if set.starttls && !s.encrypted {
        push(mut lines, "STARTTLS")
    }
    if set.auth.len > 0 && (s.encrypted || !set.starttls) {
        push(mut lines, "AUTH {set.auth}")
    }
    lines
}

fn ehlo_reply(s: *Session) -> str {
    let lines = extension_lines(s)
    var out = ""
    for i, line in lines {
        let joint = if i == lines.len - 1 { " " } else { "-" }
        out = "{out}250{joint}{line}\r\n"
    }
    out
}

fn reset_transaction(s: *Session) {
    s.has_from = false
    s.from = ""
    s.params = ""
    s.accepted = []
}

fn path_of(arg: str) -> str {
    let start = text.index_byte(arg, '<')
    let stop = text.index_byte(arg, '>')
    if start < 0 || stop < start {
        return ""
    }
    arg[start + 1..stop]
}

fn params_of(arg: str) -> str {
    let stop = text.index_byte(arg, '>')
    if stop < 0 {
        return ""
    }
    text.trim(arg[stop + 1..])
}

fn declared_size(params: str) -> i64 {
    let cut = text.cut(params, "SIZE=")
    if !cut.found {
        return 0
    }
    let digits = text.cut(cut.after, " ").before
    text.parse_int(digits) catch {
        _ => 0
    }
}

fn cmd_ehlo(s: *Session) {
    if s.st.settings.ehlo_unknown {
        say(s, "502 5.5.1 Command not implemented\r\n")
        return
    }
    s.greeted = true
    reset_transaction(s)
    say(s, ehlo_reply(s))
}

fn cmd_helo(s: *Session) {
    s.greeted = true
    reset_transaction(s)
    say(s, "250 fake.example\r\n")
}

fn cmd_mail(s: *Session, arg: str) {
    let set = s.st.settings
    if !s.greeted {
        say(s, "503 5.5.1 Say EHLO first\r\n")
        return
    }
    if set.require_auth && !s.authed {
        say(s, "530 5.7.0 Authentication required\r\n")
        return
    }
    if !text.starts_with(text.upper(arg), "FROM:") {
        say(s, "501 5.5.4 Syntax error\r\n")
        return
    }
    let sender = path_of(arg)
    let params = params_of(arg)
    if sender == "blocked@example.org" {
        say(s, "550 5.7.1 Sender blocked\r\n")
        return
    }
    let size = declared_size(params)
    if set.size > 0 && size > set.size {
        say(s, "552 5.3.4 Message size exceeds fixed limit\r\n")
        return
    }
    if text.contains(params, "SMTPUTF8") && !set.utf8 {
        say(s, "555 5.6.7 SMTPUTF8 not supported\r\n")
        return
    }
    if text.contains(params, "BODY=8BITMIME") && !set.eight_bit {
        say(s, "555 5.5.4 BODY not supported\r\n")
        return
    }
    s.has_from = true
    s.from = sender
    s.params = params
    s.accepted = []
    say(s, "250 2.1.0 Ok\r\n")
}

fn cmd_rcpt(s: *Session, arg: str) {
    if !s.has_from {
        say(s, "503 5.5.1 Need MAIL first\r\n")
        return
    }
    let to = path_of(arg)
    if text.starts_with(to, "nouser") {
        say(s, "550 5.1.1 <{to}>: Recipient address rejected: User unknown\r\n")
        return
    }
    if text.starts_with(to, "later") {
        say(s, "450 4.2.0 <{to}>: Mailbox busy\r\n")
        return
    }
    if text.starts_with(to, "hang") {
        sleep(600)
    }
    push(mut s.accepted, to)
    say(s, "250 2.1.5 Ok\r\n")
}

fn read_data(s: *Session) -> str {
    var lines: []str = []
    for {
        let line = io.read_line(s.reader) catch {
            _ => {
                s.done = true
                return ""
            }
        }
        if line == "." {
            break
        }
        if text.starts_with(line, "..") {
            push(mut lines, line[1..])
        } else {
            push(mut lines, line)
        }
    }
    if lines.len == 0 {
        return ""
    }
    "{text.join(lines, "\r\n")}\r\n"
}

fn store_message(s: *Session, data: str) -> i64 {
    let st = s.st
    sync.lock(st.gate)
    push(mut st.messages, Received { from: s.from, to: s.accepted, params: s.params, data })
    let count = st.messages.len
    sync.unlock(st.gate)
    count
}

fn cmd_data(s: *Session) {
    if s.accepted.len == 0 {
        say(s, "503 5.5.1 Need RCPT first\r\n")
        return
    }
    say(s, "354 End data with <CR><LF>.<CR><LF>\r\n")
    let data = read_data(s)
    if s.done {
        return
    }
    if text.contains(data, "Subject: REJECT") {
        reset_transaction(s)
        say(s, "554 5.6.0 Message rejected\r\n")
        return
    }
    if text.contains(data, "Subject: DEFER") {
        reset_transaction(s)
        say(s, "451 4.3.0 Try again later\r\n")
        return
    }
    let count = store_message(s, data)
    reset_transaction(s)
    say(s, "250 2.0.0 Ok: queued as Q{count}\r\n")
}

fn cmd_starttls(s: *Session) {
    if !s.st.settings.starttls || s.encrypted {
        say(s, "502 5.5.1 STARTTLS not available\r\n")
        return
    }
    say(s, "220 2.0.0 Ready to start TLS\r\n")
    s.upgrade = true
}

fn answer(s: *Session) -> str {
    let line = io.read_line(s.reader) catch {
        _ => {
            s.done = true
            return ""
        }
    }
    record(s.st, "C: {line}")
    line
}

fn decoded(value: str) -> str {
    let raw = base64.decode(value) catch {
        _ => return ""
    }
    str(raw)
}

fn accept_auth(s: *Session) {
    s.authed = true
    say(s, "235 2.7.0 Authentication successful\r\n")
}

fn reject_auth(s: *Session) {
    say(s, "535 5.7.8 Authentication credentials invalid\r\n")
}

fn auth_plain(s: *Session, initial: str) {
    if decoded(initial) == "\0tim\0tanstaaftanstaaf" {
        accept_auth(s)
        return
    }
    reject_auth(s)
}

fn auth_login(s: *Session) {
    say(s, "334 VXNlcm5hbWU6\r\n")
    let user = decoded(answer(s))
    say(s, "334 UGFzc3dvcmQ6\r\n")
    let password = decoded(answer(s))
    if user == "tim" && password == "tanstaaftanstaaf" {
        accept_auth(s)
        return
    }
    reject_auth(s)
}

fn auth_cram_md5(s: *Session) {
    say(s, "334 PDE4OTYuNjk3MTcwOTUyQHBvc3RvZmZpY2UucmVzdG9uLm1jaS5uZXQ+\r\n")
    let response = answer(s)
    if response == "dGltIGI5MTNhNjAyYzdlZGE3YTQ5NWI0ZTZlNzMzNGQzODkw" {
        accept_auth(s)
        return
    }
    reject_auth(s)
}

fn auth_xoauth2(s: *Session, initial: str) {
    if initial == "dXNlcj10aW0BYXV0aD1CZWFyZXIgdG9rAQE=" {
        accept_auth(s)
        return
    }
    let problem = base64.encode(bytes("{{\"status\":\"401\",\"scope\":\"mail\"}}"))
    say(s, "334 {problem}\r\n")
    let ignored = answer(s)
    say(s, "535 5.7.8 Token not accepted\r\n")
}

fn cmd_auth(s: *Session, arg: str) {
    let set = s.st.settings
    if !s.greeted || s.authed {
        say(s, "503 5.5.1 Bad sequence of commands\r\n")
        return
    }
    let cut = text.cut(arg, " ")
    let mechanism = text.upper(cut.before)
    if !offers(set.auth, mechanism) || (set.starttls && !s.encrypted) {
        say(s, "504 5.5.4 Unrecognized authentication type\r\n")
        return
    }
    if mechanism == "PLAIN" {
        auth_plain(s, cut.after)
    } else if mechanism == "LOGIN" {
        auth_login(s)
    } else if mechanism == "CRAM-MD5" {
        auth_cram_md5(s)
    } else {
        auth_xoauth2(s, cut.after)
    }
}

fn handle(s: *Session, line: str) {
    let cut = text.cut(line, " ")
    let verb = text.upper(cut.before)
    if verb == "EHLO" {
        cmd_ehlo(s)
    } else if verb == "HELO" {
        cmd_helo(s)
    } else if verb == "MAIL" {
        cmd_mail(s, cut.after)
    } else if verb == "RCPT" {
        cmd_rcpt(s, cut.after)
    } else if verb == "DATA" {
        cmd_data(s)
    } else if verb == "AUTH" {
        cmd_auth(s, cut.after)
    } else if verb == "STARTTLS" {
        cmd_starttls(s)
    } else if verb == "RSET" {
        reset_transaction(s)
        say(s, "250 2.0.0 Ok\r\n")
    } else if verb == "NOOP" {
        say(s, "250 2.0.0 Ok\r\n")
    } else if verb == "QUIT" {
        say(s, "221 2.0.0 Bye\r\n")
        s.done = true
    } else {
        say(s, "500 5.5.2 Command not recognized\r\n")
    }
}

fn note_batch(s: *Session) {
    if io.buffered(s.reader) == 0 {
        return
    }
    sync.lock(s.st.gate)
    s.st.batches += 1
    sync.unlock(s.st.gate)
}

fn converse(s: *Session) -> bool {
    for !s.done {
        let line = io.read_line(s.reader) catch {
            _ => return false
        }
        note_batch(s)
        record(s.st, "C: {line}")
        handle(s, line)
        if s.upgrade {
            return true
        }
    }
    false
}

fn next_session(st: *Store) -> i64 {
    sync.lock(st.gate)
    st.sessions += 1
    let id = st.sessions
    sync.unlock(st.gate)
    id
}

fn secure(st: *Store, wire: io.Stream) {
    using t = tls.server(wire, st.config) catch {
        _ => return
    }
    let s = open_session(st, tls.stream(t), true)
    converse(s)
}

fn plain(h: net.ConnHandle, st: *Store) {
    using c = net.adopt(h)
    let id = next_session(st)
    let wire = net.stream(c)
    let s = open_session(st, wire, false)
    say(s, "220 fake.example ESMTP ready\r\n")
    if converse(s) {
        secure(st, wire)
    }
    st.ended <- "session {id} ended"
}

fn encrypted_session(h: net.ConnHandle, st: *Store) {
    using c = net.adopt(h)
    let id = next_session(st)
    using t = tls.server(net.stream(c), st.config) catch {
        _ => {
            st.ended <- "session {id} ended"
            return
        }
    }
    let s = open_session(st, tls.stream(t), true)
    say(s, "220 fake.example ESMTP ready\r\n")
    converse(s)
    st.ended <- "session {id} ended"
}

fn serve(l: net.ListenerHandle, st: *Store) {
    for {
        let h = net.accept_handle(l) catch {
            _ => return
        }
        spawn plain(h, st)
    }
}

fn serve_tls(l: net.ListenerHandle, st: *Store) {
    for {
        let h = net.accept_handle(l) catch {
            _ => return
        }
        spawn encrypted_session(h, st)
    }
}

fn mail_error(e: mail.Error) -> str {
    match e {
        InvalidAddress(a) => "InvalidAddress({text.quote(a)})"
        HeaderInjection(h) => "HeaderInjection({text.quote(h)})"
        InvalidHeader(h) => "InvalidHeader({text.quote(h)})"
        NoRecipients => "NoRecipients"
    }
}

fn describe(e: smtp.Error) -> str {
    match e {
        Connect => "Connect"
        Closed => "Closed"
        Timeout => "Timeout"
        Protocol => "Protocol"
        TooLarge => "TooLarge"
        Insecure => "Insecure"
        MessageTooLarge => "MessageTooLarge"
        Unsupported(f) => "Unsupported({f})"
        Transient(code, message) => "Transient({code}, {text.quote(message)})"
        Permanent(code, message) => "Permanent({code}, {text.quote(message)})"
        Auth(message) => "Auth({text.quote(message)})"
        Invalid(error) => "Invalid({mail_error(error)})"
    }
}

fn parse(label: str, data: str) {
    let r = smtp.parse_reply(bytes(data)) catch {
        e => {
            print("{label}: error {describe(e)}")
            return
        }
    }
    print("{label}: {r.code} {text.quote(text.join(r.lines, "|"))} lines={r.lines.len}")
}

fn parse_limited(label: str, data: str, lines: i64) {
    let r = smtp.parse_reply_with(bytes(data), smtp.Limits { lines }) catch {
        e => {
            print("{label}: error {describe(e)}")
            return
        }
    }
    print("{label}: {r.code} lines={r.lines.len}")
}

struct Drip {
    data: []u8
    at: i64
}

fn dripping(data: str, size: i64) -> io.Stream {
    let state = new(Drip { data: bytes(data), at: 0 })
    io.Stream {
        read: fn(buf) {
            let left = state.data.len - state.at
            if left == 0 {
                return 0
            }
            var n = if left < size { left } else { size }
            if n > buf.len {
                n = buf.len
            }
            let k = io.copy(buf[..n], state.data[state.at..state.at + n])
            state.at += k
            k
        }
        write: fn(data) { data.len }
        close: fn() {}
    }
}

fn parse_stream(label: str, data: str, size: i64) {
    let r = smtp.read_reply(io.reader(dripping(data, size)), smtp.Limits {}) catch {
        e => {
            print("{label}: error {describe(e)}")
            return
        }
    }
    print("{label}: {r.code} lines={r.lines.len} bytes={text.join(r.lines, "").len}")
}

fn flag(v: bool) -> str {
    if v { "yes" } else { "no" }
}

fn extensions_of(label: str, data: str) {
    let r = smtp.parse_reply(bytes(data)) catch {
        e => {
            print("{label}: error {describe(e)}")
            return
        }
    }
    let e = smtp.parse_extensions(r)
    print("{label}: greeting={text.quote(e.greeting)} names={text.join(e.names, ",")} auth={text.join(e.mechanisms, ",")} size={e.size}")
    print("{label}: starttls={flag(e.starttls)} 8bit={flag(e.eight_bit_mime)} utf8={flag(e.smtputf8)} pipelining={flag(e.pipelining)} enhanced={flag(e.enhanced_codes)} plain={flag(smtp.supports(e, "plain"))}")
}

fn parser_tests() {
    parse("simple", "250 OK\r\n")
    parse("no text", "250\r\n")
    parse("empty text", "250 \r\n")
    parse("multiline", "250-first\r\n250-second\r\n250 third\r\n")
    parse("bare lf", "250 fine\n")
    parse("greeting", "220 mail.example.com ESMTP Postfix\r\n")
    parse("enhanced", "550 5.1.1 <a@b>: Recipient address rejected\r\n")
    parse("trailing data", "250 ok\r\n250 next\r\n")
    parse("empty", "")
    parse("short", "25\r\n")
    parse("letters", "abc def\r\n")
    parse("glued", "250x ok\r\n")
    parse("code range", "999 x\r\n")
    parse("code low", "099 x\r\n")
    parse("code mismatch", "250-a\r\n251 b\r\n")
    parse("truncated", "250-a\r\n")
    parse("no newline", "250 ok")
    parse("blank line", "\r\n")
    parse("continuation after final", "250 a\r\n250-b\r\n250 c\r\n")
    parse_limited("lines at limit", "250-a\r\n250-b\r\n250 c\r\n", 3)
    parse_limited("lines over limit", "250-a\r\n250-b\r\n250-c\r\n250 d\r\n", 3)
    parse_limited("lines one", "250 a\r\n", 1)
    parse_limited("lines zero", "250 a\r\n", 0)
    parse_stream("dripped", "250-one\r\n250-two\r\n250 three\r\n", 3)
    parse_stream("dripped one byte", "354 go ahead\r\n", 1)
    parse_stream("oversize line", "250 {text.repeat("a", 20000)}\r\n", 1000)
    parse_stream("long line", "250 {text.repeat("a", 4000)}\r\n", 1000)
    parse_stream("endless line", text.repeat("2", 40000), 1000)
}

fn extension_tests() {
    extensions_of("postfix", "250-mail.example.com\r\n250-PIPELINING\r\n250-SIZE 10240000\r\n250-VRFY\r\n250-ETRN\r\n250-STARTTLS\r\n250-AUTH PLAIN LOGIN\r\n250-AUTH=PLAIN LOGIN\r\n250-ENHANCEDSTATUSCODES\r\n250-8BITMIME\r\n250-DSN\r\n250 SMTPUTF8\r\n")
    extensions_of("lowercase", "250-host Hello there\r\n250-auth plain cram-md5\r\n250 starttls\r\n")
    extensions_of("greeting only", "250 host\r\n")
    extensions_of("size bare", "250-host\r\n250 SIZE\r\n")
    extensions_of("size bogus", "250-host\r\n250 SIZE lots\r\n")
    extensions_of("size negative", "250-host\r\n250 SIZE -5\r\n")
    extensions_of("empty lines", "250-host\r\n250- \r\n250 8BITMIME\r\n")
    extensions_of("auth alone", "250-host\r\n250 AUTH\r\n")
    extensions_of("xoauth", "250-host\r\n250 AUTH XOAUTH2 PLAIN\r\n")
}

fn dot(s: str) {
    print("dot {text.quote(s)}: {text.quote(str(smtp.dot_stuff(bytes(s))))}")
}

fn dot_tests() {
    dot("")
    dot("a")
    dot("a\r\n")
    dot(".")
    dot(".\r\n")
    dot("..\r\n")
    dot(".x")
    dot("line\r\n.hidden\r\nend\r\n")
    dot("a\n.\nb\n")
    dot("a\r.\rb")
    dot("a\r\r\nb")
    dot("\r\n\r\n")
    dot("x\r\n.\r\nMAIL FROM:<evil@example.com>\r\n")
}

fn choice(advertised: []str, encrypted: bool) -> str {
    let picked = smtp.choose(advertised, encrypted)
    match picked {
        some(m) => smtp.mechanism_name(m)
        none => "(none)"
    }
}

fn auth_tests() {
    print("plain: {smtp.plain_response("user", "pass")}")
    print("plain tim: {smtp.plain_response("tim", "tanstaaftanstaaf")}")
    print("login: {smtp.login_response("tim")} {smtp.login_response("tanstaaftanstaaf")}")
    print("xoauth2: {smtp.xoauth2_response("someuser@example.com", "ya29.vF9dft4qmTc2Nvb3RlckBhdHRhdmlzdGEuY29tCg")}")
    let challenge = "<1896.697170952@postoffice.reston.mci.net>"
    print("cram digest: {smtp.cram_md5_digest("tanstaaftanstaaf", challenge)}")
    print("cram response: {smtp.cram_md5_response("tim", "tanstaaftanstaaf", challenge)}")
    let decoded = smtp.decode_challenge("PDE4OTYuNjk3MTcwOTUyQHBvc3RvZmZpY2UucmVzdG9uLm1jaS5uZXQ+") catch {
        _ => "(error)"
    }
    print("challenge: {decoded}")
    print("encrypted pick: {choice(["PLAIN", "LOGIN", "CRAM-MD5"], true)}")
    print("plain pick: {choice(["PLAIN", "LOGIN", "CRAM-MD5"], false)}")
    print("login only: {choice(["LOGIN"], true)}")
    print("xoauth only: {choice(["XOAUTH2"], true)}")
    print("none: {choice([], true)}")
    print("names: {smtp.mechanism_name(smtp.Mechanism.Auto)} {smtp.mechanism_name(smtp.Mechanism.Plain)} {smtp.mechanism_name(smtp.Mechanism.Login)} {smtp.mechanism_name(smtp.Mechanism.XOAuth2)} {smtp.mechanism_name(smtp.Mechanism.CramMd5)}")
}

fn when() -> zoned.Zoned? {
    let ts = timestamp.from_unix(1762851000) catch {
        _ => return none
    }
    let shift = offset.hours(1) catch {
        _ => return none
    }
    let stamp = zoned.of(ts, zone.fixed(shift)) catch {
        _ => return none
    }
    stamp
}

fn letter(subject: str, body: str) -> mail.Message {
    mail.Message {
        from: mail.address("ada@example.com")
        to: [mail.address("bob@example.org")]
        subject
        date: when()
        message_id: "smtp-1@example.com"
        text: body
        boundary: "BOUNDARY"
    }
}

fn dialogue(st: *Store) {
    sync.lock(st.gate)
    let lines = st.log
    st.log = []
    sync.unlock(st.gate)
    for line in lines {
        print("  {line}")
    }
}

fn settle(st: *Store) {
    let note = <-st.ended
    print("  {note ?? "?"}")
}

fn options(l: net.Listener) -> smtp.Options {
    smtp.Options { port: l.handle.addr.port, timeout: 5000, hello: "client.example" }
}

fn signed_in(l: net.Listener, mechanism: smtp.Mechanism) -> smtp.Options {
    var o = options(l)
    o.username = "tim"
    o.password = "tanstaaftanstaaf"
    o.mechanism = mechanism
    o.insecure_auth = true
    o
}

fn describe_receipt(r: smtp.Receipt) -> str {
    var refused: []str = []
    for f in r.refused {
        push(mut refused, "{f.address}={f.code} {text.quote(f.message)}")
    }
    "accepted={text.join(r.accepted, ",")} refused=[{text.join(refused, "; ")}] reply={r.code} {text.quote(r.message)}"
}

fn describe_extensions(e: smtp.Extensions) -> str {
    "greeting={text.quote(e.greeting)} names={text.join(e.names, ",")} auth={text.join(e.mechanisms, ",")} size={e.size}"
}

fn stored(st: *Store) -> []Received {
    sync.lock(st.gate)
    let all = st.messages
    sync.unlock(st.gate)
    all
}

fn matches(st: *Store, index: i64, m: mail.Message) -> bool {
    let all = stored(st)
    let rendered = mail.render(m) catch {
        _ => return false
    }
    all[index].data == rendered
}

fn basics(o: smtp.Options, st: *Store) ! smtp.Error {
    using c = smtp.connect(o)?
    let h = c.handle
    print("extensions: {describe_extensions(c.handle.extensions)}")
    print("encrypted: {flag(c.handle.encrypted)}")
    let m = letter("Hello", "Hi Bob,\nthe build is green.\n")
    let receipt = smtp.send(c, m)?
    print("receipt: {describe_receipt(receipt)}")
    print("stored matches rendered: {flag(matches(st, 0, m))}")
    smtp.noop(c)?
    smtp.reset(c)?
    smtp.quit(c)
    dialogue(st)
    settle(st)
    print("after quit: {outcome(fn() ! smtp.Error { smtp.noop_on(h)? })}")
}

fn outcome(body: fn() ! smtp.Error) -> str {
    body() catch {
        e => return describe(e)
    }
    "ok"
}

fn authenticating(l: net.Listener, st: *Store) ! smtp.Error {
    let all = [smtp.Mechanism.Plain, smtp.Mechanism.Login, smtp.Mechanism.CramMd5, smtp.Mechanism.XOAuth2, smtp.Mechanism.Auto]
    for m in all {
        var o = signed_in(l, m)
        if smtp.mechanism_name(m) == "XOAUTH2" {
            o.password = "tok"
        }
        using c = smtp.connect(o)?
        print("authenticated with {smtp.mechanism_name(m)}")
        smtp.quit(c)
        dialogue(st)
        settle(st)
    }
}

fn rejected_credentials(l: net.Listener, st: *Store) {
    var wrong = signed_in(l, smtp.Mechanism.Plain)
    wrong.password = "nope"
    let tried = outcome(fn() ! smtp.Error {
        using c = smtp.connect(wrong)?
    })
    print("wrong plain password: {tried}")
    settle(st)
