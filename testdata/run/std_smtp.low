fn authentication_required(l: net.Listener, st: *Store) ! smtp.Error {
    using c = smtp.connect(options(l))?
    let h = c.handle
    let before = outcome(fn() ! smtp.Error { smtp.send_on(h, letter("Early", "x\n"))? })
    print("send before auth: {before}")
    smtp.authenticate(c, "tim", "tanstaaftanstaaf", smtp.Mechanism.CramMd5)?
    let receipt = smtp.send(c, letter("Late", "x\n"))?
