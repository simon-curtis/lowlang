struct Script {
    replies: []str
    next: i64
    out: []u8
    at: i64
}

fn script(replies: []str) -> io.Stream {
    let state = new(Script { replies, next: 1, out: bytes(replies[0]), at: 0 })
    io.Stream {
        read: fn(buf) {
            let left = state.out.len - state.at
            if left == 0 {
                return 0
            }
            let n = if left < buf.len { left } else { buf.len }
            let k = io.copy(buf[..n], state.out[state.at..state.at + n])
            state.at += k
            k
        }
        write: fn(data) {
            if state.next < state.replies.len {
                text.append(mut state.out, state.replies[state.next])
                state.next += 1
            }
            data.len
        }
        close: fn() {}
    }
}

fn scripted(label: str, replies: []str, o: smtp.Options) {
    using c = smtp.connect_stream(script(replies), o) catch {
        e => {
            print("{label}: {describe(e)}")
            return
        }
    }
    print("{label}: connected greeting={text.quote(c.handle.extensions.greeting)} names={text.join(c.handle.extensions.names, ",")}")
}

fn faulty_servers() {
    let o = smtp.Options {}
    var tight = smtp.Options {}
    tight.limits = smtp.Limits { lines: 3 }
    let hello = "250-x\r\n250 AUTH CRAM-MD5\r\n"
    scripted("greeting 554", ["554 5.3.2 No service\r\n"], o)
    scripted("greeting 421", ["421 4.3.2 Too busy\r\n"], o)
    scripted("greeting 250", ["250 not a greeting\r\n", hello], o)
    scripted("greeting garbage", ["hello there\r\n"], o)
    scripted("greeting mismatch", ["220-a\r\n221 b\r\n"], o)
    scripted("greeting truncated", ["220-a\r\n"], o)
    scripted("greeting silent", [""], o)
    scripted("too many lines", ["220-a\r\n220-b\r\n220-c\r\n220-d\r\n220 e\r\n"], tight)
    scripted("oversize line", ["220 {text.repeat("a", 20000)}\r\n"], o)
    scripted("ehlo unavailable", ["220 hi\r\n", "421 4.3.2 Shutting down\r\n"], o)
    scripted("ehlo then helo", ["220 hi\r\n", "502 5.5.1 no\r\n", "250 fake.example\r\n"], o)
    scripted("helo fails too", ["220 hi\r\n", "500 5.5.1 no\r\n", "500 5.5.1 still no\r\n"], o)
    scripted("ehlo multi", ["220 hi\r\n", "250-fake.example Hello\r\n250-PIPELINING\r\n250 8BITMIME\r\n"], o)
    scripted("helo reply garbage", ["220 hi\r\n", "502 5.5.1 no\r\n", "what\r\n"], o)

    var creds = smtp.Options {}
    creds.username = "tim"
    creds.password = "tanstaaftanstaaf"
    creds.mechanism = smtp.Mechanism.CramMd5
    scripted("cram not base64", ["220 hi\r\n", hello, "334 !!nope!!\r\n"], creds)
    scripted("cram ok", ["220 hi\r\n", hello, "334 PDE4OTYuNjk3MTcwOTUyQHBvc3RvZmZpY2UucmVzdG9uLm1jaS5uZXQ+\r\n", "235 2.7.0 ok\r\n"], creds)
    scripted("cram refused", ["220 hi\r\n", hello, "334 PDE4OTYuNjk3MTcwOTUyQHBvc3RvZmZpY2UucmVzdG9uLm1jaS5uZXQ+\r\n", "535 5.7.8 no\r\n"], creds)
    scripted("cram temporary", ["220 hi\r\n", hello, "334 PDE4OTYuNjk3MTcwOTUyQHBvc3RvZmZpY2UucmVzdG9uLm1jaS5uZXQ+\r\n", "454 4.7.0 try later\r\n"], creds)
    scripted("cram no challenge", ["220 hi\r\n", hello, "235 2.7.0 ok\r\n"], creds)
    scripted("cram rejected up front", ["220 hi\r\n", hello, "504 5.5.4 no such mechanism\r\n"], creds)

    var login = creds
    login.mechanism = smtp.Mechanism.Login
    login.insecure_auth = true
    scripted("login unsupported", ["220 hi\r\n", hello], login)
}

fn injection_attempt() {
    var o = smtp.Options {}
    using c = smtp.connect_stream(script(["220 hi\r\n", "250-x\r\n250 STARTTLS\r\n", "220 go\r\n220 injected\r\n"]), o) catch {
        e => {
            print("injection connect: {describe(e)}")
            return
        }
    }
    let h = c.handle
    print("injection: {outcome(fn() ! smtp.Error { smtp.start_tls_on(h, client_config("localhost"))? })}")
    print("after injection: {outcome(fn() ! smtp.Error { smtp.noop_on(h)? })}")
}

fn refused_connection() {
    using l = net.listen("127.0.0.1", 0) catch {
        _ => {
            print("refused: listen failed")
            return
        }
    }
    let port = l.handle.addr.port
    net.close_listener(l)
    var o = smtp.Options {}
    o.port = port
    o.connect_timeout = 1000
    using c = smtp.connect(o) catch {
        e => {
            print("refused: {describe(e)}")
            return
        }
    }
    print("refused: connected")
}

fn script_session(label: str, replies: []str, body: fn(*smtp.ClientHandle) ! smtp.Error) {
    using c = smtp.connect_stream(script(replies), smtp.Options {}) catch {
        e => {
            print("{label}: connect {describe(e)}")
            return
        }
    }
    let h = c.handle
    body(h) catch {
        e => {
            print("{label}: {describe(e)}")
            return
        }
    }
    print("{label}: ok")
}

fn faulty_transactions() {
    let hello = "250 fake.example\r\n"
    var m = letter("Scripted", "x\n")
    script_session("data accepted as 250", ["220 hi\r\n", hello, "250 ok\r\n", "250 ok\r\n", "250 surprise\r\n"], fn(h) ! smtp.Error { smtp.send_on(h, m)? })
    script_session("sender 4xx", ["220 hi\r\n", hello, "451 4.3.0 local error\r\n"], fn(h) ! smtp.Error { smtp.send_on(h, m)? })
    script_session("final reply 5xx", ["220 hi\r\n", hello, "250 ok\r\n", "250 ok\r\n", "354 go\r\n", "554 5.6.0 no\r\n"], fn(h) ! smtp.Error { smtp.send_on(h, m)? })
    script_session("final reply garbage", ["220 hi\r\n", hello, "250 ok\r\n", "250 ok\r\n", "354 go\r\n", "zzz\r\n"], fn(h) ! smtp.Error { smtp.send_on(h, m)? })
    script_session("final reply missing", ["220 hi\r\n", hello, "250 ok\r\n", "250 ok\r\n", "354 go\r\n"], fn(h) ! smtp.Error { smtp.send_on(h, m)? })
    script_session("noop 5xx", ["220 hi\r\n", hello, "500 5.5.2 what\r\n"], fn(h) ! smtp.Error { smtp.noop_on(h)? })
    script_session("noop ok", ["220 hi\r\n", hello, "250 fine\r\n"], fn(h) ! smtp.Error { smtp.noop_on(h)? })
}

fn with_server(label: str, settings: Settings, body: fn(net.Listener, *Store) ! smtp.Error) {
    using l = net.listen("127.0.0.1", 0) catch {
        _ => {
            print("{label}: listen failed")
            return
        }
    }
    let st = new_store(settings, server_config())
    spawn serve(l.handle, st)
    print("--- {label}")
    body(l, st) catch {
        e => print("{label} failed: {describe(e)}")
    }
}

fn with_tls_server(label: str, settings: Settings, body: fn(net.Listener, *Store) ! smtp.Error) {
    using l = net.listen("127.0.0.1", 0) catch {
        _ => {
            print("{label}: listen failed")
            return
        }
    }
    let st = new_store(settings, server_config())
    spawn serve_tls(l.handle, st)
    print("--- {label}")
    body(l, st) catch {
        e => print("{label} failed: {describe(e)}")
    }
}

fn main() {
    parser_tests()
    extension_tests()
    dot_tests()
    auth_tests()
    faulty_servers()
    injection_attempt()
    faulty_transactions()
    refused_connection()

    let full = Settings { auth: "PLAIN LOGIN CRAM-MD5 XOAUTH2", size: 1500, eight_bit: true, utf8: true }
    with_server("basics", Settings { size: 10240000, eight_bit: true, pipelining: true, auth: "PLAIN LOGIN" }, fn(l, st) ! smtp.Error { basics(options(l), st)? })
    with_server("authenticating", full, fn(l, st) ! smtp.Error { authenticating(l, st)? })
    with_server("rejected credentials", full, fn(l, st) ! smtp.Error { rejected_credentials(l, st) })
    with_server("automatic", full, fn(l, st) ! smtp.Error { automatic(l, st)? })
    with_server("plaintext refused", Settings { auth: "PLAIN LOGIN" }, fn(l, st) ! smtp.Error { plaintext_refused(l, st) })
    with_server("unsupported", Settings { auth: "PLAIN" }, fn(l, st) ! smtp.Error { unsupported(l, st) })
    with_server("no auth", Settings {}, fn(l, st) ! smtp.Error { unsupported(l, st) })
    with_server("starttls missing", Settings {}, fn(l, st) ! smtp.Error { starttls_missing(l, st, client_config("localhost")) })
    with_server("authentication required", Settings { auth: "CRAM-MD5", require_auth: true }, fn(l, st) ! smtp.Error { authentication_required(l, st)? })
    with_server("deliveries", Settings { size: 10240000 }, fn(l, st) ! smtp.Error { deliveries(l, st)? })
    with_server("pipelined", Settings { pipelining: true }, fn(l, st) ! smtp.Error { pipelined(l, st, "pipelined")? })
    with_server("sequential", Settings {}, fn(l, st) ! smtp.Error { pipelined(l, st, "sequential")? })
    with_server("extensions", Settings { size: 1500, eight_bit: true, utf8: true }, fn(l, st) ! smtp.Error { extension_use(l, st)? })
    with_server("bare", Settings {}, fn(l, st) ! smtp.Error { bare_server(l, st)? })
    with_server("stuffing", Settings {}, fn(l, st) ! smtp.Error { stuffing(l, st)? })
    with_server("invalid input", Settings {}, fn(l, st) ! smtp.Error { invalid_input(l, st)? })
    with_server("bad hello", Settings {}, fn(l, st) ! smtp.Error { bad_hello(l, st) })
    with_server("helo fallback", Settings { ehlo_unknown: true }, fn(l, st) ! smtp.Error { basics(options(l), st)? })
    with_server("timeout", Settings {}, fn(l, st) ! smtp.Error { timing(l, st)? })
    with_server("ownership", Settings {}, fn(l, st) ! smtp.Error { ownership(l, st)? })
    with_server("scoped", Settings {}, fn(l, st) ! smtp.Error {
        leave(l, st)?
        settle(st)
    })
    with_server("shared", Settings {}, fn(l, st) ! smtp.Error { shared(l, st)? })
    let secured = Settings { starttls: true, auth: "PLAIN LOGIN", size: 10240000 }
    with_server("starttls", secured, fn(l, st) ! smtp.Error { upgraded(l, st)? })
    with_server("starttls by hand", secured, fn(l, st) ! smtp.Error { upgraded_by_hand(l, st)? })
    with_server("credentials before starttls", secured, fn(l, st) ! smtp.Error { plaintext_with_credentials(l, st) })
    with_server("starttls wrong name", secured, fn(l, st) ! smtp.Error { wrong_certificate_name(l, st) })
    with_tls_server("implicit tls", Settings { auth: "PLAIN LOGIN", size: 10240000 }, fn(l, st) ! smtp.Error { implicit(l, st)? })
}
