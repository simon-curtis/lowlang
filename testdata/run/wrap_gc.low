struct Node {
    v: i64
    next: *Node?
}

fn churn(n: i64, seed: i64) -> i64 {
    if n <= 0 {
        return seed
    }
    var head: *Node? = none
    for i in 0..n {
        head = new(Node { v: i + seed, next: head })
        let junk = new(Node { v: i, next: none })
        if junk.v < 0 {
            return 0
        }
    }
    var s = 0
    var cur = head
    for {
        match cur {
            some(c) => {
                s += c.v
                cur = c.next
            }
            none => break
        }
    }
    s
}

fn maybe(a: *Node, n: i64) -> i64 {
    if n == 0 {
        return a.v
    }
    churn(n, a.v) + a.v
}

fn keep(depth: i64) -> i64 {
    let a = new(Node { v: depth, next: none })
    let b = new(Node { v: depth * 2, next: some(a) })
    let c = new(Node { v: depth * 3, next: some(b) })
    let d = new(Node { v: depth * 5, next: some(c) })
    let e = new(Node { v: depth * 7, next: some(d) })
    var t = maybe(a, 0) + maybe(b, depth % 3) + maybe(c, 0)
    t += maybe(d, 20000) + maybe(e, 0)
    var chk = 0
    var cur: *Node? = some(e)
    for {
        match cur {
            some(x) => {
                chk += x.v
                cur = x.next
            }
            none => break
        }
    }
    if chk != depth * 18 || a.v != depth || e.v != depth * 7 {
        print(-1)
    }
    t + chk
}

fn main() {
    var total = 0
    for i in 0..300 {
        total += keep(i)
    }
    print(total)
}
