fn main() {
    let x = -1.2345678901234567e-6
    let s = "abcdefgh"
    var kept: []str = []
    var total = 0
    for i in 0..4000 {
        let t = "{x}{s}"
        total += t.len
        push(mut kept, t)
    }
    var intact = 0
    for t in kept {
        if t == "-0.0000012345678901234567abcdefgh" {
            intact += 1
        }
    }
    print(kept[0])
    print(total)
    print(intact)
    print("{-1.7976931348623157e308}|{-2.2250738585072014e-308}|{-123456789012345680000.0}|{s}")
}
