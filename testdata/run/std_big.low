import std/big
import std/crypto/hash
import std/text

struct Gen {
    state: u64
}

fn next(mut g: Gen) -> u64 {
    var x = g.state
    x ^= x >> 12
    x ^= x << 25
    x ^= x >> 27
    g.state = x
    x * 0x2545F4914F6CDD1D
}

fn from_raw(raw: []u8) -> big.Int {
    big.from_bytes(raw)
}

fn random_bits(mut g: Gen, bits: i64) -> big.Int {
    let n = (bits + 7) / 8
    var raw: []u8 = []
    for _ in 0..n {
        push(mut raw, u8(next(mut g) >> 56))
    }
    raw[0] = raw[0] & (u8(255) >> (8 * n - bits))
    from_raw(raw)
}

fn limb_patterns(mut g: Gen, bits: i64) -> big.Int {
    let patterns: []u32 = [0, 1, 0x7fffffff, 0x80000000, 0xffffffff, 0xfffffffe]
    let limbs = bits / 32 + 1
    var raw: []u8 = []
    for _ in 0..limbs {
        let p = patterns[i64(next(mut g) % 6)]
        push(mut raw, u8(p >> 24))
        push(mut raw, u8(p >> 16))
        push(mut raw, u8(p >> 8))
        push(mut raw, u8(p))
    }
    from_raw(raw)
}

fn operand(mut g: Gen, max_bits: i64) -> big.Int {
    let kind = i64(next(mut g) % 6)
    let bits = 1 + i64(next(mut g) % u64(max_bits))
    var v = match kind {
        == 2 => big.pow(big.from_i64(2), u64(bits)).sub(big.one())
        == 3 => big.pow(big.from_i64(2), u64(bits)).add(big.from_i64(i64(next(mut g) % 3) - 1))
        == 4 => limb_patterns(mut g, bits)
        == 5 => random_bits(mut g, bits).shl(i64(next(mut g) % 70))
        _ => random_bits(mut g, bits)
    }
    if next(mut g) & 1 == 1 {
        v = big.neg(v)
    }
    v
}

fn digest(s: str) -> str {
    text.encode_hex(hash.sum(hash.sha256(), bytes(s)))
}

fn feed(chains: []str, op: i64, value: str) {
    chains[op] = digest("{chains[op]}{value}")
}

fn ops() -> []str {
    ["add", "sub", "mul", "mulhex", "divmod", "floor", "euclid", "gcd", "shifts", "bitwise", "bits", "str", "parse", "isqrt", "pow", "modpow", "inverse", "float", "prime", "nextprime"]
}

fn bases() -> []i64 {
    [2, 3, 7, 10, 16, 32, 36]
}

fn dec(x: big.Int) -> str {
    x.to_str(10)
}

fn pair(a: big.Int, b: big.Int) -> str {
    "{dec(a)} {dec(b)}"
}

fn division(d: big.DivMod) -> str {
    pair(d.quotient, d.remainder)
}

fn strings(a: big.Int) -> str {
    var parts: []str = []
    for base in bases() {
        push(mut parts, a.to_str(base))
    }
    text.join(parts, " ")
}

fn reparsed(a: big.Int) -> str ! big.Error {
    var parts: []str = []
    for base in bases() {
        let again = big.parse(a.to_str(base), base)?
        push(mut parts, dec(again))
    }
    text.join(parts, " ")
}

fn capped(a: big.Int, bits: i64) -> big.Int {
    let extra = a.bit_len() - bits
    if extra > 0 { a.shr(extra) } else { a }
}

fn float_text(a: big.Int) -> str {
    let shifted = capped(big.abs(a), 1000)
    let v = if big.is_negative(a) { big.neg(shifted).to_f64() } else { shifted.to_f64() }
    big.from_u64(text.float_bits(v)).to_str(16)
}

fn inverse_text(a: big.Int, m: big.Int) -> str {
    let inv = big.mod_inverse(a, m) or return "none"
    dec(inv)
}

fn mask256() -> big.Int {
    big.pow(big.from_i64(2), 256).sub(big.one())
}

fn run_case(chains: []str, a: big.Int, b: big.Int, c: big.Int, k: i64) ! big.Error {
    feed(chains, 0, dec(a.add(b)))
    feed(chains, 1, dec(a.sub(b)))
    feed(chains, 2, dec(a.mul(b)))
    feed(chains, 3, a.mul(b).to_str(16))
    feed(chains, 4, division(a.divmod(b)?))
    feed(chains, 5, division(a.divmod_floor(b)?))
    feed(chains, 6, division(a.divmod_euclid(b)?))
    feed(chains, 7, pair(a.gcd(b), a.lcm(b)))
    feed(chains, 8, pair(a.shl(k), a.shr(k)))
    feed(chains, 9, "{pair(a.bit_and(b), a.bit_or(b))} {pair(a.bit_xor(b), a.bit_not())}")
    feed(chains, 10, "{a.bit_len()} {a.trailing_zeros()} {a.bit(k)} {a.bit(5 * k)}")
    feed(chains, 11, strings(a))
    feed(chains, 12, reparsed(a)?)
    feed(chains, 13, dec(big.isqrt(big.abs(a))?))
    feed(chains, 14, dec(a.pow(u64(k % 5))))
    let m = big.abs(c)
    let e = big.abs(b).bit_and(mask256())
    feed(chains, 15, dec(big.modpow(a, e, m)?))
    feed(chains, 16, inverse_text(a, m))
    feed(chains, 17, float_text(a))
    let small = big.abs(a)
    if small.bit_len() <= 700 {
        feed(chains, 18, "{small.is_probable_prime(8)}")
    }
    feed(chains, 19, dec(big.next_prime(capped(small, 200))))
}

fn nonzero(x: big.Int) -> big.Int {
    if x.is_zero() { big.one() } else { x }
}

fn random_cases() ! big.Error {
    var g = Gen { state: 0x9E3779B97F4A7C15 }
    let sizes = [64, 200, 700, 2000, 5000]
    var chains: []str = []
    for _ in ops() {
        push(mut chains, "")
    }
    for i in 0..150 {
        let max_bits = sizes[i % 5]
        let a = operand(mut g, max_bits)
        let b = nonzero(operand(mut g, max_bits))
        let c = nonzero(operand(mut g, 700))
        let k = i64(next(mut g) % 130)
        run_case(chains, a, b, c, k)?
    }
    for j, name in ops() {
        print("{name} {chains[j]}")
    }
}

fn describe(e: big.Error) -> str {
    match e {
        Empty => "empty"
        BadDigit(at) => "bad digit at {at}"
        BadBase => "bad base"
        DivideByZero => "divide by zero"
        Overflow => "overflow"
        NoInverse => "no inverse"
        Negative => "negative"
        NotPositive => "not positive"
    }
}

fn outcome(f: fn() -> big.Int ! big.Error) -> str {
    let v = f() catch {
        e => return describe(e)
    }
    dec(v)
}

fn sized(a: big.Int, n: i64) -> str {
    let raw = big.to_bytes_sized(a, n) catch {
        e => return describe(e)
    }
    text.encode_hex(raw)
}

fn tried(s: str, base: i64) -> str {
    let v = big.parse(s, base) catch {
        e => return describe(e)
    }
    dec(v)
}

fn literal(s: str) -> big.Int {
    big.parse(s, 10) or big.zero()
}

fn power(base: i64, e: u64) -> big.Int {
    big.pow(big.from_i64(base), e)
}

fn mersenne(p: u64) -> big.Int {
    power(2, p).sub(big.one())
}

fn known_primes() {
    print(mersenne(521).is_probable_prime(20))
    print(mersenne(2203).is_probable_prime(3))
    print(mersenne(127).is_probable_prime(20))
    print(power(2, 521).add(big.one()).is_probable_prime(20))
    print(power(2, 128).add(big.one()).is_probable_prime(20))
    print(literal("3317044064679887385961981").is_probable_prime(20))
    print(literal("3825123056546413051").is_probable_prime(20))
    for n in [0, 1, 2, 561, 41041, 825265, 1000003] {
        print("{n} {big.from_i64(n).is_probable_prime(10)}")
    }
    print(big.next_prime(power(2, 64)).to_str(10))
    print(big.next_prime(power(10, 9)).to_str(10))
    for n in [-5, 0, 1, 2, 14] {
        print(big.next_prime(big.from_i64(n)).to_str(10))
    }
}

fn known_values() ! big.Error {
    print(big.factorial(100).to_str(10))
    print(big.factorial(0).to_str(10))
    print(big.fibonacci(1000).to_str(10))
    for n in [0, 1, 2, 3, 10, 90] {
        print(big.fibonacci(u64(n)).to_str(10))
    }
    print(big.binomial(100, 50).to_str(10))
    print(big.binomial(5, 7).to_str(10))
    print(big.binomial(10, 0).to_str(10))
    print(big.binomial(64, 32).to_str(10))
    let m = big.modpow(big.from_i64(3), power(10, 6), big.from_i64(1000000007))?
    print(m.to_str(10))
    print(power(2, 1000).to_str(16))
    print(power(2, 1000).to_str(36))
    print(power(-2, 63).to_str(10))
    print(big.pow(big.zero(), 0).to_str(10))
}

fn integer_edges() {
    let low = big.from_i64(-9223372036854775807 - 1)
    let high = big.from_i64(9223372036854775807)
    print(low.to_str(10))
    print(high.to_str(10))
    for x in [low, high, power(2, 63), power(-2, 63).sub(big.one()), big.zero()] {
        let v = big.to_i64(x) catch {
            e => {
                print(describe(e))
                continue
            }
        }
        print(v)
    }
    for x in [mersenne(64), power(2, 64), big.from_i64(-1)] {
        let v = big.to_u64(x) catch {
            e => {
                print(describe(e))
                continue
            }
        }
        print(v)
    }
    print(big.neg(big.zero()).is_negative())
    print(big.from_i64(-3).sign())
    print(big.from_i64(0).sign())
    print(big.from_u64(18446744073709551615).to_str(16))
    print(big.cmp(big.from_i64(-5), big.from_i64(3)))
    print(big.cmp(big.from_i64(-5), big.from_i64(-7)))
    print(big.equal(big.from_i64(12), big.from_u64(12)))
}

fn parsing() {
    print(tried("-0x1F", 0))
    print(tried("0b1010_1010", 0))
    print(tried("0o777", 0))
    print(tried("1_000_000", 10))
    print(tried("+42", 10))
    print(tried("-z", 36))
    print(tried("Zz", 36))
    print(tried("ff", 16))
    print(tried("0010", 10))
    print(tried("-0", 10))
    print(tried("123456789012345678901234567890123456789", 10))
    print(tried("", 10))
    print(tried("-", 10))
    print(tried("0x", 0))
    print(tried("12a", 10))
    print(tried("1__0", 10))
    print(tried("_1", 10))
    print(tried("1_", 10))
    print(tried("12", 1))
    print(tried("12", 37))
    print(tried("1 2", 10))
}

fn bytes_and_shifts() ! big.Error {
    print(big.from_bytes([1, 0]).to_str(10))
    print(big.from_bytes([]).to_str(10))
    print(big.from_bytes([0, 0, 255]).to_str(10))
    print(text.encode_hex(power(2, 64).to_bytes()))
    print(text.encode_hex(big.zero().to_bytes()))
    print(text.encode_hex(big.from_i64(-258).to_bytes()))
    print(text.encode_hex(big.from_i64(258).to_bytes_sized(4)?))
    print(sized(power(2, 40), 5))
    print(sized(power(2, 40), 6))
    print(sized(big.from_i64(-1), 6))
    for x in [-5, -1, 5, 255] {
        let a = big.from_i64(x)
        print("{x} {a.shr(1).to_str(10)} {a.shr(100).to_str(10)} {a.shl(3).to_str(10)} {a.shl(-1).to_str(10)} {a.shr(-2).to_str(10)}")
    }
    for x in [-5, -4, 5, 12] {
        for y in [3, -3] {
            let a = big.from_i64(x)
            let b = big.from_i64(y)
            print("{x} {y} {a.bit_and(b).to_str(10)} {a.bit_or(b).to_str(10)} {a.bit_xor(b).to_str(10)}")
        }
    }
    for x in [-7, 7] {
        for y in [2, -2] {
            let a = big.from_i64(x)
            let b = big.from_i64(y)
            print("{x} {y} {division(a.divmod(b)?)} {division(a.divmod_floor(b)?)} {division(a.divmod_euclid(b)?)} {a.quo(b)?.to_str(10)} {a.rem(b)?.to_str(10)} {a.modulo(b)?.to_str(10)}")
        }
    }
}

fn float_edges() {
    let vals = [power(2, 53).add(big.one()), power(2, 53).add(big.from_i64(3)), power(2, 53).add(big.from_i64(2)), mersenne(64), power(2, 1023), mersenne(1024), power(2, 1024), power(2, 1024).sub(power(2, 970)), power(2, 1024).sub(power(2, 971)), big.from_i64(-12345), big.zero()]
    for v in vals {
        let f = v.to_f64()
        let infinite = f == 1.0 / 0.0
        print("{infinite} {big.from_u64(text.float_bits(f)).to_str(16)}")
    }
}

fn number_theory() ! big.Error {
    print(big.mod_inverse(big.from_i64(3), big.from_i64(11))?.to_str(10))
    print(big.mod_inverse(big.from_i64(-3), big.from_i64(11))?.to_str(10))
    print(inverse_text(big.from_i64(2), big.from_i64(4)))
    print(big.modpow(big.from_i64(3), big.from_i64(-1), big.from_i64(11))?.to_str(10))
    print(big.modpow(big.from_i64(-3), big.from_i64(3), big.from_i64(-7))?.to_str(10))
    print(big.modpow(big.from_i64(5), big.zero(), big.from_i64(7))?.to_str(10))
    print(big.modpow(big.from_i64(5), big.from_i64(3), big.one())?.to_str(10))
    print(outcome(fn() -> big.Int ! big.Error { big.modpow(big.from_i64(5), big.from_i64(3), big.zero()) }))
    print(outcome(fn() -> big.Int ! big.Error { big.isqrt(big.from_i64(-1)) }))
    print(big.isqrt(power(10, 40))?.to_str(10))
    print(big.isqrt(power(10, 40).sub(big.one()))?.to_str(10))
    print(big.isqrt(big.zero())?.to_str(10))
    print(outcome(fn() -> big.Int ! big.Error { big.quo(big.from_i64(7), big.zero()) }))
    print(big.gcd(big.zero(), big.zero()).to_str(10))
    print(big.gcd(big.from_i64(-12), big.from_i64(18)).to_str(10))
    print(big.lcm(big.from_i64(-4), big.from_i64(6)).to_str(10))
    print(big.lcm(big.zero(), big.from_i64(6)).to_str(10))
}

fn large_checks() ! big.Error {
    let nine = power(10, 1000).sub(big.one())
    let twice = big.from_i64(2).mul(power(10, 1000))
    let expected = power(10, 2000).sub(twice).add(big.one())
    print(nine.mul(nine).equal(expected))
    let p = mersenne(2203)
    let a = big.from_i64(123456789).pow(7)
    print(big.modpow(a, p.sub(big.one()), p)?.to_str(10))
    let q = mersenne(1279)
    let n = p.mul(q)
    let phi = p.sub(big.one()).mul(q.sub(big.one()))
    let e = big.from_i64(65537)
    let d = big.mod_inverse(e, phi)?
    let message = a.add(power(3, 5000))
    let sealed = big.modpow(message, e, n)?
    let opened = big.modpow(sealed, d, n)?
    print(opened.equal(message.rem(n)?))
    print(sealed.bit_len())
    print(text.encode_hex(hash.sum(hash.sha256(), sealed.to_bytes())))
    print(d.bit_len())
    let sq = big.isqrt(n.mul(n).add(big.from_i64(12345)))?
    print(sq.equal(n))
}

fn random_below_checks() ! big.Error {
    var inside = true
    var seen_high = false
    let bound = power(2, 200).add(big.from_i64(12345))
    for _ in 0..200 {
        let r = big.random_below(bound)?
        if big.cmp(r, bound) >= 0 || big.is_negative(r) {
            inside = false
        }
        if r.bit_len() >= 199 {
            seen_high = true
        }
    }
    print(inside)
    print(seen_high)
    let small = big.random_below(big.from_i64(1))?
    print(small.to_str(10))
    print(outcome(fn() -> big.Int ! big.Error { big.random_below(big.zero()) }))
    var seen: [i64: bool] = [:]
    for _ in 0..200 {
        let v = big.to_i64(big.random_below(big.from_i64(6))?)?
        seen[v] = true
    }
    print(seen.len)
}

fn main() ! big.Error {
    random_cases()?
    known_primes()
    known_values()?
    integer_edges()
    parsing()
    bytes_and_shifts()?
    float_edges()
    number_theory()?
    large_checks()?
    random_below_checks()?
}
