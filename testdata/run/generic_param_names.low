struct Span {
    n: i64
}

fn wrap[T](body: fn(Span) -> T) -> T {
    in_span("x", body)
}

fn in_span[T](name: str, body: fn(Span) -> T) -> T {
    body(Span { n: name.len })
}

fn apply[T](x: T, f: fn(T) -> T) -> T {
    f(x)
}

fn label[T](x: T, show: fn(T) -> str) -> str {
    "<{show(x)}>"
}

fn main() {
    print(wrap(fn(s: Span) -> i64 { s.n + 5 }))
    print(in_span("abc", fn(s: Span) -> str { "span {s.n}" }))
    print(apply(3, fn(x: i64) -> i64 { x * 2 }))
    print(label("hi", fn(s: str) -> str { s }))
}
