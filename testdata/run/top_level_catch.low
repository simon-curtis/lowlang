enum Inner {
    Bad(i64)
}

enum Outer {
    Wrapped(Inner)
    Other
}

fn inner(n: i64) -> i64 ! Inner {
    if n > 2 {
        fail Bad(n)
    }
    n
}

fn describe(e: Inner) -> Outer {
    Other
}

print(inner(1) catch Outer.Wrapped)
print(inner(2) catch describe)
print(inner(5) catch Outer.Wrapped)
print("unreachable")
