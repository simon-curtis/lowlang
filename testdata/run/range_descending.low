fn descend(xs: []i64, from: i64) -> i64 {
    var total = 0
    var j = from
    for j >= 0 {
        total += xs[j]
        j -= 1
    }
    total
}

fn main() {
    var xs: []i64 = []
    for i in 0..10 {
        push(mut xs, i + 1)
    }
    print(descend(xs, 9))
    print(descend(xs, 4))
    print(descend(xs, -1))
}
