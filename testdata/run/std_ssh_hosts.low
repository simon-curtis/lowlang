import std/file
import std/ssh/key
import std/text

const vectors = "testdata/ssh"
const inside_window = 1800000000

fn read(name: str) -> str {
    file.read_text("{vectors}/{name}") or panic("read {name}")
}

fn key_of(name: str) -> key.PublicKey {
    let parsed = key.parse_line(read("{name}.pub")) or panic("parse {name}.pub")
    parsed.key
}

fn status_name(s: key.HostStatus) -> str {
    match s {
        Trusted => "Trusted"
        Unknown => "Unknown"
        Mismatch => "Mismatch"
        Revoked => "Revoked"
    }
}

fn marker_name(m: key.Marker) -> str {
    match m {
        Plain => "plain"
        CertAuthority => "cert-authority"
        Revoked => "revoked"
    }
}

fn status(entries: key.KnownHost[], host: str, port: i64, k: key.PublicKey) -> str {
    status_name(key.check_host_key(entries, host, port, k, inside_window))
}

fn known_hosts_failure(line: str) -> str {
    let entries = key.parse_known_hosts(line) catch {
        e => return "rejected"
    }
    "accepted {entries.len}"
}

fn authorized_failure(line: str) -> str {
    let entries = key.parse_authorized_keys(line) catch {
        e => return "rejected"
    }
    "accepted {entries.len}"
}

fn plain_hosts() {
    let entries = key.parse_known_hosts(read("known_hosts_plain")) or panic("parse")
    print("entries: {entries.len}")
    for e in entries {
        print("entry: {marker_name(e.marker)} {text.join(e.patterns, ",")} {e.key.kind} {e.comment}")
    }
    let ed = key_of("ed25519")
    print("listed: {status(entries, "example.test", 22, ed)}")
    print("case folded: {status(entries, "EXAMPLE.test", 22, ed)}")
    print("changed key: {status(entries, "example.test", 22, key_of("ed25519_encrypted"))}")
    print("other key type: {status(entries, "example.test", 22, key_of("ecdsa256"))}")
    print("unlisted host: {status(entries, "unlisted.test", 22, ed)}")
    print("bracketed port: {status(entries, "example.test", 2222, key_of("ecdsa256"))}")
    print("other port: {status(entries, "example.test", 2223, key_of("ecdsa256"))}")
    let rsa = key_of("rsa2048")
    print("wildcard: {status(entries, "good.wild.test", 22, rsa)}")
    print("negation: {status(entries, "bad.wild.test", 22, rsa)}")
    print("revoked: {status(entries, "revoked.test", 22, key_of("ecdsa384"))}")
    let cert = key_of("hostca-cert")
    print("authority certificate: {status(entries, "a.ca.test", 22, cert)}")
    print("authority other host: {status(entries, "b.ca.test", 22, cert)}")
    print("authority outside the window: {status_name(key.check_host_key(entries, "a.ca.test", 22, cert, 1500000000))}")
    let verify = key.known_hosts_verifier(entries, "example.test", 22)
    print("verifier: {verify(ed)} {verify(key_of("ed25519_encrypted"))} {verify(key_of("ecdsa256"))}")
}

fn hashed_hosts() {
    let content = read("known_hosts_hashed")
    let entries = key.parse_known_hosts(content) or panic("parse hashed")
    let ed = key_of("ed25519")
    print("hashed entries: {entries.len}")
    print("hashed host: {status(entries, "hashed.test", 22, ed)}")
    print("hashed host with port: {status(entries, "hashed.test", 2222, key_of("ecdsa256"))}")
    print("hashed other host: {status(entries, "other.test", 22, ed)}")
    let first = text.fields(content)[0]
    print("hash matches ssh-keygen: {key.hash_host("hashed.test", entries[0].salt) == first}")
    print("labels: {key.host_label("Example.TEST", 22)} {key.host_label("example.test", 2222)}")
}

fn written_lines() {
    let k = key_of("ed25519")
    let hashed = key.known_hosts_line("round.test", 22, k, [1, 2, 3, 4])
    let plain = key.known_hosts_line("round.test", 2200, k, [])
    let entries = key.parse_known_hosts("{hashed}\n{plain}\n") or panic("parse")
    print("round trip: {entries.len} {status(entries, "round.test", 22, k)} {status(entries, "round.test", 2200, k)}")
    print("plain line: {text.starts_with(plain, "[round.test]:2200 ssh-ed25519 ")} {text.starts_with(hashed, "|1|")}")
    for line in ["host", "host ssh-ed25519", "@bogus host ssh-ed25519 AAAA", "|1|a|b ssh-ed25519 AAAA", "host ssh-ed25519 !!!!"] {
        print("malformed {line.len}: {known_hosts_failure(line)}")
    }
}

fn first_use() {
    let dir = file.temp_dir("std-ssh-hosts") or panic("temp dir")
    let path = "{dir}/known_hosts"
    let trust = key.trust_on_first_use(path, "tofu.test", 22)
    print("first use: {trust(key_of("ed25519"))}")
    print("second use: {trust(key_of("ed25519"))}")
    print("changed key: {trust(key_of("ed25519_encrypted"))}")
    let written = file.read_text(path) or panic("read")
    print("lines written: {text.count(written, "\n")}")
    let other = key.trust_on_first_use(path, "tofu2.test", 22)
    print("second host: {other(key_of("ecdsa256"))}")
    let entries = key.parse_known_hosts(file.read_text(path) or panic("read")) or panic("parse")
    print("file entries: {entries.len}")
    file.remove_all(dir) or panic("remove")
}

fn authorized() {
    let entries = key.parse_authorized_keys(read("authorized_keys")) or panic("parse")
    print("authorized entries: {entries.len}")
    let plain = key.find_authorized(entries, key_of("ed25519")) ?? panic("plain")
    print("plain: {plain.options.len} {plain.comment}")
    let restricted = key.find_authorized(entries, key_of("ecdsa256")) ?? panic("restricted")
    print("command: {key.authorized_option(restricted, "command")[0]}")
    print("from: {key.authorized_option(restricted, "from")[0]}")
    print("environment: {text.join(key.authorized_option(restricted, "environment"), ";")}")
    print("flags: {key.has_authorized_option(restricted, "no-pty")} {key.has_authorized_option(restricted, "no-agent-forwarding")}")
    for o in restricted.options {
        print("option: {o.name}={o.value}")
    }
    let authority = key.find_authorized(entries, key_of("ca")) ?? panic("authority")
    print("authority: {key.has_authorized_option(authority, "cert-authority")} {key.authorized_option(authority, "principals")[0]}")
    let bare = key.find_authorized(entries, key_of("rsa2048")) ?? panic("bare")
    print("bare comment: {bare.comment.len}")
    let unlisted = match key.find_authorized(entries, key_of("host")) {
        some(_) => "listed"
        none => "absent"
    }
    print("unlisted: {unlisted}")
    for line in ["no-pty", "command=\"unterminated ssh-ed25519 AAAA", "ssh-ed25519 !!!!"] {
        print("malformed {line.len}: {authorized_failure(line)}")
    }
}

fn main() {
    plain_hosts()
    hashed_hosts()
    written_lines()
    first_use()
    authorized()
}
