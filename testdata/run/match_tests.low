enum Shape {
    Circle(f64)
    Square(f64)
    Empty
}

enum Problem {
    Missing
    Denied
}

fn classify(n: i64) -> str {
    match n {
        % 15 == 0 => "FizzBuzz",
        % 3 == 0 => "Fizz",
        % 5 == 0 => "Buzz",
        _ => "number"
    }
}

fn size(s: str) -> str {
    match s.len {
        == 0 => "empty"
        < 4 => "short"
        _ => "long"
    }
}

fn describe(s: Shape) -> str {
    match s {
        == Empty => "nothing",
        Circle(r) => "circle {r}",
        _ => "other"
    }
}

fn calls(n: i64) -> i64 {
    print("evaluated")
    n
}

fn lookup(n: i64) -> i64 ! Problem {
    if n < 0 {
        fail Denied
    }
    if n == 0 {
        fail Missing
    }
    n
}

fn main() {
    for i in 1..16 {
        print("{i} {classify(i)}")
    }
    print(size(""))
    print(size("abc"))
    print(size("abcdef"))
    print(describe(Empty))
    print(describe(Circle(1.5)))
    print(describe(Square(2.0)))

    let band = match calls(42) {
        < 10 => "low",
        >= 10 && < 100 => "mid"
        _ => "high"
    }
    print(band)

    let flag = true
    print(match flag {
        == true => "yes",
        _ => "no"
    })

    let r = lookup(-1) catch {
        == Denied => -2
        _ => -1
    }
    print(r)
}
