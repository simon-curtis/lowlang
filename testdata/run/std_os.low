import std/file
import std/io
import std/os
import std/process

fn describe(e: process.Exit) -> str {
    match e {
        Exited(code) => "exited {code}"
        Signaled(_) => "signaled"
    }
}

fn mode_of(path: str) -> i64 ! io.Error {
    using f = file.create(path)?
    file.info(f)?.mode
}

fn main() ! io.Error {
    let args = os.args()
    if args.len > 1 {
        os.exit(3)
        print("unreachable")
        return
    }
    print(args.len)
    print(os.env("LOW_STD_OS_MISSING") ?? "missing")
    print(os.env("PATH") != none)
    print(os.environment().len > 0)
    print(os.pid() > 0)

    let dir = file.temp_dir("low-std-os-")?
    let previous = os.umask(0o077)
    print(mode_of("{dir}/private")? == 0o600)
    print(os.umask(0o022) == 0o077)
    print(mode_of("{dir}/shared")? == 0o644)
    print(os.umask(previous) == 0o022)
    file.remove_all(dir)?

    let program = os.executable()?
    let exited = process.run(process.command(program, ["exit"]), [])?
    print(describe(exited.status))
    print(exited.stdout.len)
}
