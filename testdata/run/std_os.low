import std/os

fn main() {
    print(os.args().len)
    print(os.env("LOW_STD_OS_MISSING") ?? "missing")
    print(os.env("PATH") != none)
    print(os.environment().len > 0)
    print(os.pid() > 0)
    let previous = os.umask(0o077)
    print(os.umask(previous) == 0o077)
    os.exit(3)
    print("unreachable")
}
