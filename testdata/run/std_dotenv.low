import std/dotenv

fn show(src: str) {
    let vars = dotenv.parse(src) catch {
        MissingEquals(line) => {
            print("missing = on line {line}")
            return
        }
        BadName(line) => {
            print("bad name on line {line}")
            return
        }
        UnterminatedQuote(line) => {
            print("unterminated quote from line {line}")
            return
        }
        Read(cause) => return
    }
    for key in ["PORT", "NAME", "GREETING", "RAW", "EMPTY", "export_me", "HASH", "MULTI"] {
        match vars[key] {
            some(v) => print("{key}=[{v}]")
            none => {}
        }
    }
}

fn main() {
    show("# settings\nPORT=8080\nNAME = gateway   # trailing comment\nGREETING=\"hello\\nworld\"\nRAW='keep \\n as is'\nEMPTY=\nexport export_me=yes\nHASH=a#b\nMULTI=\"line one\nline two\"\n")
    show("PORT=1\nnot a pair\n")
    show("1BAD=x\n")
    show("OPEN=\"never closed\n")
}
