import std/crypto/ristretto255
import std/text

struct Pair {
    input: str
    output: str
}

struct Triple {
    point: str
    scalar: str
    output: str
}

struct Ops {
    a: str
    b: str
    sum: str
    difference: str
    negated: str
}

struct ScalarOps {
    a: str
    b: str
    sum: str
    difference: str
    product: str
    negated: str
    inverse: str
}

struct SquareRoot {
    u: str
    v: str
    was_square: bool
    root: str
}

fn unhex(s: str) -> u8[] {
    text.decode_hex(s) or bytes("")
}

fn hex(b: u8[]) -> str {
    text.encode_hex(b)
}

fn report(label: str, got: str, want: str) {
    let verdict = if got == want { "ok" } else { "MISMATCH {got}" }
    print("{label}: {verdict}")
}

fn element(s: str) -> ristretto255.Element {
    match ristretto255.decode(unhex(s)) {
        some(e) => e
        none => panic("invalid element {s}")
    }
}

fn encoded(e: ristretto255.Element) -> str {
    hex(ristretto255.encode(e))
}

fn scalar(s: str) -> u8[] {
    unhex(s)
}

fn present(o: u8[]?) -> bool {
    match o {
        some(_) => true
        none => false
    }
}

fn present_element(o: ristretto255.Element?) -> bool {
    match o {
        some(_) => true
        none => false
    }
}

fn small_scalar(n: i64) -> u8[] {
    var k: u8[] = [u8(n)]
    for _ in 0..31 {
        k.push(0)
    }
    k
}

