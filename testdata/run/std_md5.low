import std/crypto/hash
import std/crypto/md5
import std/crypto/password
import std/text

fn hex(s: str) -> []u8 {
    text.decode_hex(s) catch {
        _ => []
    }
}

fn show(data: []u8) {
    print(text.encode_hex(md5.sum(data)))
}

fn main() {
    show(bytes(""))
    show(bytes("a"))
    show(bytes("abc"))
    show(bytes("message digest"))
    show(bytes("abcdefghijklmnopqrstuvwxyz"))
    show(bytes("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"))
    show(bytes("12345678901234567890123456789012345678901234567890123456789012345678901234567890"))
    show(bytes("0123456789012345678901234567890123456789012345678901234"))
    show(bytes("01234567890123456789012345678901234567890123456789012345"))
    var long: []u8 = []
    for i in 0..1000 {
        push(mut long, u8(i * 7))
    }
    for n in [55, 56, 57, 63, 64, 65, 119, 120, 128, 1000] {
        show(long[..n])
    }
    let d = md5.md5().digest()
    d.update(long[..100])
    let snapshot = d.clone()
    d.update(long[100..])
    print(text.encode_hex(d.finish()) == text.encode_hex(md5.sum(long)))
    snapshot.update(long[100..])
    print(text.encode_hex(snapshot.finish()) == text.encode_hex(d.finish()))
    let early = md5.md5().digest()
    early.update(bytes("ab"))
    let first = early.finish()
    early.update(bytes("c"))
    print(text.encode_hex(first))
    print(text.encode_hex(early.finish()))
    print(md5.md5().name)
    print(md5.md5().size)
    print(md5.md5().block)
    print(text.encode_hex(hash.hmac(md5.md5(), hex("0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b"), bytes("Hi There"))))
    print(text.encode_hex(hash.hmac(md5.md5(), bytes("Jefe"), bytes("what do ya want for nothing?"))))
    var key: []u8 = []
    for _ in 0..80 {
        push(mut key, 0xaa)
    }
    print(text.encode_hex(hash.hmac(md5.md5(), key, bytes("Test Using Larger Than Block-Size Key - Hash Key First"))))
    print(text.encode_hex(password.pbkdf2(md5.md5(), bytes("password"), bytes("salt"), 100, 20)))
    print(hash.equal(md5.sum(bytes("abc")), hex("900150983cd24fb0d6963f7d28e17f72")))
}
