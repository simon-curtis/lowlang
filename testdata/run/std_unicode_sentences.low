import std/text
import std/unicode

fn code(token: str) -> u32 {
    u32(text.parse_uint(token, 16) or 0)
}

fn flush(mut pieces: str[], mut current: u8[]) {
    pieces.push(str(current))
    current = []
}

fn check(line: str) -> bool {
    var expected: str[] = []
    var current: u8[] = []
    var whole: u8[] = []
    for token in text.fields(line) {
        if token == "÷" {
            flush(mut expected, mut current)
        } else if token != "×" {
            let c = code(token)
            text.append_char(mut current, c)
            text.append_char(mut whole, c)
        }
    }
    flush(mut expected, mut current)
    let input = str(whole)
    let got = unicode.sentences(input)
    if got.len != expected.len || unicode.sentence_count(input) != expected.len {
        return false
    }
    var at = 0
    for i, sentence in got {
        if sentence != expected[i] {
            return false
        }
        let end = unicode.sentence_end(input, at)
        if end != at + sentence.len {
            return false
        }
        at = end
    }
    true
}

fn show(s: str) {
    print("{unicode.sentence_count(s)}: {text.join(unicode.sentences(s), "|")}")
}

fn main() {
    var total = 0
    var failed = 0
    for line in text.lines(embed("std_unicode_sentences.txt")) {
        if line == "" {
            continue
        }
        total += 1
        if !check(line) {
            failed += 1
            print("failed: {line}")
        }
    }
    print("cases {total} failed {failed}")

    show("")
    show("One sentence.")
    show("Hello there. How are you? Fine!")
    show("He paid $3.50 for it. Then left.")
    show("See Mr. Smith. He knows.")
    show("It was \"over.\" Nobody spoke.")
    show("Wait... what? Yes.")
    show("first line\nsecond line\r\nthird")
    show("U.S.A. is a country. so is it")
    print(unicode.sentence_end("Hi. Yo.", 0))
    print(unicode.sentence_end("Hi. Yo.", 4))
}
