import std/text

fn parsed(s: str) -> str {
    let n = text.parse_int(s) catch {
        Empty => return "empty"
        BadDigit(at) => return "bad digit at {at}"
        Overflow => return "overflow"
    }
    "{n}"
}

fn main() {
    print(text.split_str("a,b,,c", ",") |> text.join("|"))
    print(text.split_str("héllo", "") |> text.join("."))
    print(text.split_str("a::b", "::") |> text.join(" "))
    print("[{text.trim("  hi there \n")}]")
    print("[{text.trim_start("  x ")}] [{text.trim_end("  x ")}]")
    print(text.last_index("abcabc", "bc"))
    print(text.contains("hello", "ell"))
    print(text.trim_prefix("v1.2", "v"))
    print(text.trim_suffix("main.low", ".low"))
    print(text.replace("a-b-c", "-", "+"))
    print(text.upper("héllo"))
    print(text.fields("  one two\tthree  ") |> text.join(","))
    print(text.lines("a\r\nb\nc\n") |> text.join(","))
    print(text.repeat("ab", 3))
    print(text.count("cheese", "e"))
    print(text.char_count("héllo"))
    print(text.pad_left("7", 3, '0'))
    print(text.pad_right("ab", 4, '.'))
    print(text.from_char(0x1F600))

    var out: []u8 = []
    text.append(mut out, "x = ")
    text.append_char(mut out, 'λ')
    print(str(out))

    print("apple" < "banana")
    print("b" > "abc")

    for s in ["42", "-9223372036854775808", "9223372036854775808", "12a", "", "-"] {
        print(parsed(s))
    }
    print(text.parse_radix("-ff", 16) or 0)
    print(text.parse_bool("true") or false)
    print(text.radix(-10, 2))
    print(text.radix(255, 16))
    print(text.hex_digit('7'))
    print(text.hex_digit('b'))
    print(text.hex_digit('F'))
    print(text.hex_digit('g'))
    var encoded: []u8 = []
    let points: []u32 = [0x41, 0xE9, 0x20AC, 0x1F600]
    for c in points {
        text.append_char(mut encoded, c)
    }
    print(text.encode_hex(encoded))
    print("{text.char_len(0x7F)} {text.char_len(0x80)} {text.char_len(0x7FF)} {text.char_len(0x800)} {text.char_len(0xFFFF)} {text.char_len(0x10000)}")
    print(text.fixed(3.14159, 2))
    print(text.fixed(2.5, 0))
    print(text.fixed(0.125, 2))
    print(text.fixed(-0.0001, 3))
    print(text.fixed(1e20, 1))
    print(text.fixed(0.1, 20))
    print(text.fixed(999.9996, 3))
}
