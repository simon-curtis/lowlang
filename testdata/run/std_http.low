import std/http
import std/http/websocket
import std/io
import std/net
import std/text

fn handle(req: http.Request) -> http.Response {
    if req.path == "/ws" {
        using ws = websocket.accept(req) catch {
            _ => return http.response(400, "")
        }
        for {
            let m = websocket.receive(ws) catch {
                _ => break
            }
            websocket.send_text(ws, "echo: {str(m.data)}") catch {
                _ => break
            }
        }
        return http.upgraded()
    }
    http.response(200, "{req.method} {req.path} {req.query} {str(req.body)}")
}

fn exchange(input: []u8) -> []u8 ! io.Error {
    using l = net.listen("127.0.0.1", 0)?
    using client = net.connect(l.handle.addr)?
    using server = net.accept(l)?
    net.write_all(client, input)?
    net.shutdown_write(client)?
    http.serve_conn(server, handle)
    io.read_all(net.stream(client))?
}

fn frame(mut out: []u8, kind: i64, flags: i64, stream: i64, payload: []u8) {
    io.put_be24(mut out, payload.len)
    push(mut out, u8(kind))
    push(mut out, u8(flags))
    io.put_be32(mut out, stream)
    io.append(mut out, payload)
}

fn show(b: []u8) {
    var parts: []str = []
    for x in b {
        push(mut parts, "{x}")
    }
    print(text.join(parts, " "))
}

fn urls() ! io.Error {
    for s in ["http://example.com", "http://user@[::1]:8080/a/b?c=d#frag", "ws://h:81?q"] {
        let u = http.parse_url(s)?
        print("{u.scheme} {u.host} {u.port} {u.target} {http.authority(u)}")
    }
}

fn http1() ! io.Error {
    var input: []u8 = []
    io.append_str(mut input, "GET /a?x=1 HTTP/1.1\r\nHost: t\r\n\r\n")
    io.append_str(mut input, "POST /b HTTP/1.1\r\nHost: t\r\nTransfer-Encoding: chunked\r\n\r\n3\r\nabc\r\n2\r\nde\r\n0\r\n\r\n")
    io.append_str(mut input, "PUT /c HTTP/1.1\r\nHost: t\r\nContent-Length: 2\r\nConnection: close\r\n\r\nok")
    print(str(exchange(input)?))
}

fn http2() ! io.Error {
    var input: []u8 = []
    io.append_str(mut input, "PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n")
    frame(mut input, 4, 0, 0, [])
    frame(mut input, 1, 5, 1, [0x82, 0x86, 0x84])
    frame(mut input, 1, 4, 3, [0x83, 0x86, 0x84])
    frame(mut input, 0, 1, 3, bytes("hi"))
    let output = exchange(input)?
    var lines: []str = []
    var at = 0
    for at < output.len {
        let size = io.be24(output, at)
        let kind = output[at + 3]
        let flags = output[at + 4]
        let stream = io.be32(output, at + 5)
        let payload = output[at + 9..at + 9 + size]
        if kind == 0 {
            push(mut lines, "DATA {stream} {flags} {str(payload)}")
        } else {
            push(mut lines, "frame {kind} {stream} {flags} {size}")
        }
        at += 9 + size
    }
    for i in 1..lines.len {
        var j = i
        for j > 0 && before(lines[j], lines[j - 1]) {
            let t = lines[j]
            lines[j] = lines[j - 1]
            lines[j - 1] = t
            j -= 1
        }
    }
    for line in lines {
        print(line)
    }
}

fn before(a: str, b: str) -> bool {
    let n = if a.len < b.len { a.len } else { b.len }
    for i in 0..n {
        if a[i] != b[i] {
            return a[i] < b[i]
        }
    }
    a.len < b.len
}

fn ws() ! io.Error {
    var input: []u8 = []
    io.append_str(mut input, "GET /ws HTTP/1.1\r\nHost: t\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n")
    io.append_str(mut input, "Sec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\n\r\n")
    io.append(mut input, [0x81, 0x82, 1, 2, 3, 4, 0x69, 0x6B])
    io.append(mut input, [0x88, 0x82, 0, 0, 0, 0, 0x03, 0xE8])
    let output = exchange(input)?
    let reply = str(output)
    let head = text.index(reply, "\r\n\r\n") + 4
    print(reply[..head])
    show(output[head..head + 2])
    print(str(output[head + 2..head + 10]))
    show(output[head + 10..])
}

fn main() ! io.Error {
    urls()?
    http1()?
    http2()?
    ws()?
}
