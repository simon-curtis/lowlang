import std/file
import std/io
import std/os
import std/text
import std/time/fault
import std/time/offset
import std/time/timestamp
import std/time/tzdata
import std/time/zone

fn describe(f: fault.Fault) -> str {
    match f {
        OutOfRange(what) => "OutOfRange({what})"
        Invalid(what) => "Invalid({what})"
        Syntax(at) => "Syntax({at})"
        UnknownZone(name) => "UnknownZone({name})"
        Malformed(what) => "Malformed({what})"
        _ => fault.to_string(f)
    }
}

fn at(secs: i64) -> timestamp.Timestamp {
    timestamp.from_unix(secs) catch { e => timestamp.epoch() }
}

fn secs_of(iso: str) -> i64 {
    let ts = timestamp.parse(iso) catch { e => timestamp.epoch() }
    timestamp.unix_seconds(ts)
}

fn iso_of(secs: i64) -> str {
    timestamp.to_string(at(secs))
}

fn show_info(i: zone.Info) -> str {
    "{offset.to_string(i.offset)} {i.abbreviation} {i.dst}"
}

fn digest(lines: []str) -> i64 {
    var h = 7
    for line in lines {
        for i in 0..line.len {
            h = (h * 131 + i64(line[i])) % 2147483647
        }
        h = (h * 131 + 10) % 2147483647
    }
    h
}

fn show_lines(lines: []str) {
    let keep = 2
    if lines.len <= 2 * keep {
        for line in lines {
            print(line)
        }
        return
    }
    for i in 0..keep {
        print(lines[i])
    }
    print("... {lines.len - 2 * keep} more")
    for i in lines.len - keep..lines.len {
        print(lines[i])
    }
}

fn show_candidates(c: zone.Candidates) -> str {
    match c {
        One(o) => "One({offset.to_string(o)})"
        Overlap(a, b) => "Overlap({offset.to_string(a)},{offset.to_string(b)})"
        Gap(a, b) => "Gap({offset.to_string(a)},{offset.to_string(b)})"
    }
}

fn show_stamp(t: timestamp.Timestamp?) -> str {
    match t {
        some(ts) => timestamp.to_string(ts)
        none => "none"
    }
}

fn show_transition(t: zone.Transition?) -> str {
    match t {
        some(x) => "{timestamp.to_string(x.at)} {show_info(x.before)} > {show_info(x.after)}"
        none => "none"
    }
}

fn host(name: str) -> zone.Zone {
    zone.named(name) catch {
        e => {
            print("load {name} failed: {describe(e)}")
            zone.utc()
        }
    }
}

fn known(name: str) -> zone.Zone {
    zone.load_from(name, tzdata.source()) catch {
        e => {
            print("load {name} failed: {describe(e)}")
            zone.utc()
        }
    }
}

fn new_york_bytes() -> []u8 {
    let source = tzdata.source()
    source("America/New_York") ?? []
}

fn scan_info(name: str, z: zone.Zone, start: str, count: i64, step: i64) {
    let first = secs_of(start)
    var last = ""
    var lines: []str = []
    for i in 0..count {
        let s = first + i * step
        let line = show_info(zone.info_at(z, at(s)))
        if line != last {
            push(mut lines, "info {name} {iso_of(s)} {line}")
            last = line
        }
    }
    show_lines(lines)
    print("info {name} from {start} count {count} step {step} runs {lines.len} hash {digest(lines)}")
}

fn scan_candidates(name: str, z: zone.Zone, start: str, count: i64, step: i64) {
    let first = secs_of(start)
    var last = ""
    var lines: []str = []
    var ones = 0
    var overlaps = 0
    var gaps = 0
    var total = 0
    for i in 0..count {
        let s = first + i * step
        let c = zone.candidates(z, s)
        let line = show_candidates(c)
        match c {
            One(o) => {
                ones += 1
                total += offset.seconds_of(o)
            }
            Overlap(a, b) => {
                overlaps += 1
            }
            Gap(a, b) => {
                gaps += 1
            }
        }
        if line != last {
            push(mut lines, "cand {name} {iso_of(s)} {line}")
            last = line
        }
    }
    show_lines(lines)
    print("cand {name} from {start} count {count} step {step} runs {lines.len} one {ones} overlap {overlaps} gap {gaps} sum {total} hash {digest(lines)}")
}

fn same_transition(a: zone.Transition?, b: zone.Transition) -> bool {
    match a {
        some(x) => timestamp.equal(x.at, b.at) && show_info(x.before) == show_info(b.before) && show_info(x.after) == show_info(b.after)
        none => false
    }
}

fn list_transitions(name: str, z: zone.Zone, from: str, to: str) {
    let all = zone.transitions(z, at(secs_of(from)), at(secs_of(to)))
    var mismatches = 0
    var previous: zone.Transition? = none
    var lines: []str = []
    for t in all {
        let s = timestamp.unix_seconds(t.at)
        push(mut lines, "trans {name} {timestamp.to_string(t.at)} {show_info(t.before)} > {show_info(t.after)}")
        if !same_transition(zone.next_transition(z, at(s - 1)), t) {
            mismatches += 1
        }
        if !same_transition(zone.previous_transition(z, at(s + 1)), t) {
            mismatches += 1
        }
        match previous {
            some(p) => {
                if !same_transition(zone.next_transition(z, p.at), t) {
                    mismatches += 1
                }
                if !same_transition(zone.previous_transition(z, t.at), p) {
                    mismatches += 1
                }
            }
            none => {}
        }
        previous = t
    }
    show_lines(lines)
    print("trans {name} from {from} to {to} count {all.len} mismatches {mismatches} hash {digest(lines)}")
}

fn probe(name: str, z: zone.Zone, iso: str) {
    let ts = at(secs_of(iso))
    let next = zone.next_transition(z, ts)
    let prev = zone.previous_transition(z, ts)
    var next_at = "none"
    var prev_at = "none"
    match next {
        some(t) => {
            next_at = timestamp.to_string(t.at)
        }
        none => {}
    }
    match prev {
        some(t) => {
            prev_at = timestamp.to_string(t.at)
        }
        none => {}
    }
    print("probe {name} {iso} {show_info(zone.info_at(z, ts))} next {next_at} prev {prev_at}")
}

fn scan_posix(rule: str, start: str, count: i64, step: i64) {
    let z = zone.from_posix(rule, "posix") catch {
        e => return print("posix [{rule}] {describe(e)}")
    }
    let first = secs_of(start)
    var last = ""
    for i in 0..count {
        let s = first + i * step
        let line = show_info(zone.info_at(z, at(s)))
        if line != last {
            print("posix [{rule}] {iso_of(s)} {line}")
            last = line
        }
    }
    print("posix [{rule}] from {start} count {count} step {step} fixed {zone.is_fixed(z)}")
}

fn posix_error(rule: str) {
    let z = zone.from_posix(rule, "posix") catch {
        e => return print("posix [{rule}] {describe(e)}")
    }
    print("posix [{rule}] accepted {zone.name(z)}")
}

fn same_behaviour(label: str, a: zone.Zone, b: zone.Zone, start: str, count: i64, step: i64) {
    let first = secs_of(start)
    var info_diffs = 0
    var candidate_diffs = 0
    for i in 0..count {
        let s = first + i * step
        if show_info(zone.info_at(a, at(s))) != show_info(zone.info_at(b, at(s))) {
            info_diffs += 1
        }
        if show_candidates(zone.candidates(a, s)) != show_candidates(zone.candidates(b, s)) {
            candidate_diffs += 1
        }
    }
    print("same {label} count {count} info diffs {info_diffs} candidate diffs {candidate_diffs}")
}

fn grow(mut b: []u8, s: str) {
    text.append(mut b, s)
}

fn header(version: u8, times: i64, types: i64, chars: i64) -> []u8 {
    var b: []u8 = []
    grow(mut b, "TZif")
    push(mut b, version)
    for _ in 0..15 {
        push(mut b, 0)
    }
    for n in [0, 0, 0, times, types, chars] {
        io.put_be32(mut b, n)
    }
    b
}

fn append_type(mut b: []u8, utoff: i64, dst: u8, name_at: u8) {
    io.put_be32(mut b, utoff)
    push(mut b, dst)
    push(mut b, name_at)
}

fn build_v1() -> []u8 {
    var b = header(0, 2, 3, 12)
    io.put_be32(mut b, 1000000)
    io.put_be32(mut b, 2000000)
    push(mut b, 1)
    push(mut b, 2)
    append_type(mut b, 3600, 0, 0)
    append_type(mut b, 7200, 1, 4)
    append_type(mut b, 0, 0, 8)
    grow(mut b, "AAA")
    push(mut b, 0)
    grow(mut b, "BBB")
    push(mut b, 0)
    grow(mut b, "CCC")
    push(mut b, 0)
    b
}

fn build_v2(footer: str) -> []u8 {
    var b = header(50, 0, 1, 4)
    append_type(mut b, 0, 0, 0)
    grow(mut b, "UTC")
    push(mut b, 0)
    var second = header(50, 0, 1, 4)
    append_type(mut second, 3600, 0, 0)
    grow(mut second, "CET")
    push(mut second, 0)
    grow(mut second, footer)
    for x in second {
        push(mut b, x)
    }
    b
}

fn build_bad_type() -> []u8 {
    var b = header(0, 1, 1, 4)
    io.put_be32(mut b, 1000)
    push(mut b, 5)
    append_type(mut b, 0, 0, 0)
    grow(mut b, "UTC")
    push(mut b, 0)
    b
}

fn build_bad_offset() -> []u8 {
    var b = header(0, 0, 1, 4)
    append_type(mut b, 200000, 0, 0)
    grow(mut b, "UTC")
    push(mut b, 0)
    b
}

fn build_bad_name() -> []u8 {
    var b = header(0, 0, 1, 4)
    append_type(mut b, 0, 0, 9)
    grow(mut b, "UTC")
    push(mut b, 0)
    b
}

fn decoded(label: str, data: []u8) -> zone.Zone? {
    let z = zone.decode(label, data) catch {
        e => {
            print("decode {label} {describe(e)}")
            return none
        }
    }
    z
}

fn crafted() {
    let v1 = decoded("v1", build_v1()) ?? zone.utc()
    print("v1 name {zone.name(v1)} fixed {zone.is_fixed(v1)}")
    for s in [-5000000000, 0, 999999, 1000000, 1999999, 2000000, 9000000000] {
        print("v1 info {s} {show_info(zone.info_at(v1, at(s)))}")
    }
    print("v1 next {show_transition(zone.next_transition(v1, at(0)))}")
    print("v1 next {show_transition(zone.next_transition(v1, at(1000000)))}")
    print("v1 next {show_transition(zone.next_transition(v1, at(2000000)))}")
    print("v1 prev {show_transition(zone.previous_transition(v1, at(2500000)))}")
    print("v1 prev {show_transition(zone.previous_transition(v1, at(2000000)))}")
    print("v1 prev {show_transition(zone.previous_transition(v1, at(1000000)))}")
    for s in [1003599, 1003600, 1006000, 1007199, 1007200, 2000000, 2003600, 2007199, 2007200] {
        print("v1 candidates {s} {show_candidates(zone.candidates(v1, s))}")
    }
    let rule = "CET-1CEST,M3.5.0,M10.5.0/3"
    let v2 = decoded("v2", build_v2("\n{rule}\n")) ?? zone.utc()
    let paris = known("Europe/Paris")
    print("v2 name {zone.name(v2)} fixed {zone.is_fixed(v2)}")
    same_behaviour("v2 footer vs Europe/Paris", v2, paris, "1996-01-01T00:00:00Z", 24 * 366 * 4, 3600)
    let flat = decoded("v2 no footer", build_v2("\n\n")) ?? zone.utc()
    print("v2 no footer {zone.is_fixed(flat)} {show_info(zone.info_at(flat, at(86400)))}")
    let broken = decoded("v2 bad footer", build_v2("\nCET-1CEST,M3.5.0\n")) ?? zone.utc()
    let unterminated = decoded("v2 unterminated footer", build_v2("\nCET-1")) ?? zone.utc()
    let missing = decoded("v2 missing footer", build_v2("")) ?? zone.utc()
    let truncated = decoded("truncated", build_v1()[0..30]) ?? zone.utc()
    let short_body = decoded("short body", build_v1()[0..60]) ?? zone.utc()
    let empty = decoded("empty", []) ?? zone.utc()
    let magic = decoded("magic", bytes("TZxf0123456789012345678901234567890123456789")) ?? zone.utc()
    let bad_type = decoded("bad type", build_bad_type()) ?? zone.utc()
    let bad_offset = decoded("bad offset", build_bad_offset()) ?? zone.utc()
    let bad_name = decoded("bad name", build_bad_name()) ?? zone.utc()
}

fn failure(name: str) {
    let z = zone.named(name) catch {
        e => return print("load [{name}] {describe(e)}")
    }
    print("load [{name}] ok {zone.name(z)}")
}

fn nul_name() {
    let z = zone.named("a\0b") catch {
        e => return print("load [NUL] {describe(e)}")
    }
    print("load [NUL] ok {zone.name(z)}")
}

fn api() {
    let u = zone.utc()
    print("utc {zone.name(u)} {zone.is_fixed(u)} {show_info(zone.info_at(u, at(0)))} {zone.is_dst_at(u, at(0))}")
    let kathmandu = offset.hm(5, 45) catch { e => offset.utc() }
    let f = zone.fixed(kathmandu)
    print("fixed {zone.name(f)} {zone.is_fixed(f)} {show_info(zone.info_at(f, at(1000)))} {offset.to_string(zone.offset_at(f, at(0)))}")
    print("fixed candidates {show_candidates(zone.candidates(f, 123456))}")
    print("fixed transitions {show_transition(zone.next_transition(f, at(0)))} {show_transition(zone.previous_transition(f, at(0)))} {zone.transitions(f, at(0), at(4000000000)).len}")
    let zero = zone.fixed(offset.utc())
    print("fixed utc {zone.name(zero)} {zone.is_fixed(zero)}")
    let negative = offset.hm(-3, 30) catch { e => offset.utc() }
    print("fixed negative {zone.name(zone.fixed(negative))} {show_info(zone.info_at(zone.fixed(negative), at(0)))}")
    let ny = known("America/New_York")
    print("ny {zone.name(ny)} {zone.is_fixed(ny)}")
    let utc_file = host("UTC")
    print("UTC file {zone.name(utc_file)} {zone.is_fixed(utc_file)} {show_info(zone.info_at(utc_file, at(0)))}")
    for name in ["", "/etc/passwd", "../etc/passwd", "America/../Asia/Tokyo", "a\\b", "Nope/Nowhere", "America", "America/", "UTC", "Etc/GMT+5"] {
        failure(name)
    }
    nul_name()
    let ny_bytes = new_york_bytes()
    let source = fn(name: str) -> []u8? {
        if name == "Custom/Zone" {
            return ny_bytes
        }
        if name == "Custom/Junk" {
            return bytes("not a zone")
        }
        none
    }
    for name in ["Custom/Zone", "Custom/Junk", "Custom/Missing", "../Custom/Zone", ""] {
        let z = zone.load_from(name, source) catch {
            e => {
                print("load_from [{name}] {describe(e)}")
                continue
            }
        }
        print("load_from [{name}] {zone.name(z)} {show_info(zone.info_at(z, at(1800000000)))}")
    }
    same_behaviour("load_from vs America/New_York", zone.load_from("Custom/Zone", source) catch { e => zone.utc() }, ny, "1900-01-01T00:00:00Z", 24 * 366 * 10, 3600)
    for rule in ["", "A5", "EST", "EST5EDT", "EST5EDT,M13.1.0,M11.1.0", "EST5EDT,M3.2.0", "EST5EDT,M3.2.0,M11.1.0x", "<EST5", "<EST>5", "EST5EDT,J0,J5", "EST5EDT,J366,J5", "EST5EDT,M3.6.0,M11.1.0", "EST5EDT,M3.2.7,M11.1.0", "EST5EDT,366,5", "EST99", "EST5:60", "EST5:00:60", "EST5EDT,M3.2.0/,M11.1.0", "EST5EDT,M3.2.0,M11.1.0/", "EST5EDT4:00,M3.2.0,M11.1.0", "ES5", "<+05>-5", "<+0530>-5:30", "UTC0", "UTC", "5EST", "EST-5:30:15", "EST+5", "EST5EDT,,M11.1.0"] {
        posix_error(rule)
    }
}

fn environment() {
    let root = file.temp_dir("zonetest") catch { e => "/tmp/zonetest-failed" }
    let nested = "{root}/Test"
    file.mkdir_all(nested) catch { e => print("mkdir failed") }
    let ny_bytes = new_york_bytes()
    file.write_file("{nested}/Custom", ny_bytes) catch { e => print("write failed") }
    file.write_file("{nested}/Junk", bytes("TZif but not really")) catch { e => print("write failed") }
    os.set_env("ZONEINFO", root) catch { e => print("set_env failed") }
    let custom = host("Test/Custom")
    print("ZONEINFO custom {zone.name(custom)} {show_info(zone.info_at(custom, at(1800000000)))}")
    print("ZONEINFO fallback {zone.name(host("Asia/Tokyo"))} {show_info(zone.info_at(host("Asia/Tokyo"), at(0)))}")
    failure("Test/Junk")
    failure("Test/Absent")
    os.set_env("ZONEINFO", "{root}/does-not-exist") catch { e => print("set_env failed") }
    print("ZONEINFO missing dir {zone.name(host("Asia/Tokyo"))}")
    os.unset_env("ZONEINFO") catch { e => print("unset failed") }
    failure("Test/Custom")
    file.remove_all(root) catch { e => print("remove failed") }

    for value in ["Asia/Kolkata", ":Asia/Kolkata", "", ":", "EST5EDT,M3.2.0,M11.1.0", ":EST5EDT,M3.2.0,M11.1.0", "<+0330>-3:30", "/usr/share/zoneinfo/Europe/Paris", ":/usr/share/zoneinfo/Europe/Paris", "/usr/share/zoneinfo/Nowhere", "Nowhere/Zone", "UTC", "Etc/GMT-14", "garbage"] {
        os.set_env("TZ", value) catch { e => print("set_env failed") }
        let z = zone.local() catch {
            e => {
                print("local TZ [{value}] {describe(e)}")
                continue
            }
        }
        print("local TZ [{value}] {zone.name(z)} {zone.is_fixed(z)} {show_info(zone.info_at(z, at(1800000000)))} {show_info(zone.info_at(z, at(1785000000)))}")
    }
    os.unset_env("TZ") catch { e => print("unset failed") }
    let system = zone.local() catch {
        e => {
            print("local failed {describe(e)}")
            zone.utc()
        }
    }
    let any = zone.name(system).len > 0
    print("local system {any}")
}

fn posix_by_hand() {
    scan_posix("ABC4DEF,100,300", "2023-01-01T00:00:00Z", 24 * 366 * 3, 3600)
    scan_posix("AAA3BBB,M1.1.0/0,M12.5.0/24", "2024-01-01T00:00:00Z", 24 * 366 * 2, 3600)
    scan_posix("AAA3BBB,J1/0,J365/24", "2024-01-01T00:00:00Z", 24 * 366 * 2, 3600)
}

