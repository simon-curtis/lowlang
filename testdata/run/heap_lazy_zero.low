import std/io

fn main() {
    var held: [][]u8 = []
    for i in 0..4 {
        let b = io.buffer(33554432)
        b[16777216 + i] = u8(7 + i)
        push(mut held, b)
    }
    let wide = io.buffer(67108864)
    wide[wide.len - 1] = 9
    var total = 0
    for i in 0..held.len {
        total += i64(held[i][16777216 + i]) + i64(held[i][16777217 + i])
    }
    print(total)
    print(i64(wide[wide.len - 1]) + i64(wide[wide.len - 2]))
    print(wide.len)
}
