struct Node {
    id: i64
    next: *Node?
}

struct Blob {
    a: i64
    b: i64
    c: i64
    d: i64
}

fn garbage(n: i64) -> i64 {
    var total = 0
    for i in 0..n {
        let blob = new(Blob { a: i, b: i + 1, c: i + 2, d: i + 3 })
        total += blob.d - blob.a
    }
    total
}

fn pushed_nodes(n: i64) -> i64 {
    var nodes: []*Node = []
    var numbers: []i64 = []
    var previous: *Node? = none
    for i in 0..n {
        let node = new(Node { id: i, next: previous })
        push(mut nodes, node)
        push(mut numbers, i * 3)
        previous = some(node)
        garbage(30)
    }
    garbage(200000)
    var total = 0
    for i in 0..nodes.len {
        total += nodes[i].id + numbers[i]
    }
    total
}

fn filled_then_churn(n: i64) -> i64 {
    var zeros: []i64 = []
    for i in 0..n {
        push(mut zeros, 0)
    }
    var sevens: []i64 = []
    for i in 0..n {
        push(mut sevens, 7)
    }
    garbage(500000)
    for i in 0..n {
        zeros[i] = i
    }
    garbage(500000)
    var total = 0
    for i in 0..n {
        total += zeros[i] + sevens[i]
    }
    total
}

fn strings_pushed(n: i64) -> i64 {
    var names: []str = []
    for i in 0..n {
        push(mut names, "item {i}")
        garbage(10)
    }
    garbage(300000)
    var total = 0
    for name in names {
        total += name.len
    }
    total
}

fn main() {
    print(pushed_nodes(3000))
    print(filled_then_churn(10000))
    print(strings_pushed(2000))
}
