struct Cell {
    items: i64[] = []
}

struct Row {
    a: Cell = Cell {}
    b: Cell = Cell {}
    c: Cell = Cell {}
    d: Cell = Cell {}
    e: Cell = Cell {}
    f: Cell = Cell {}
    g: Cell = Cell {}
    h: Cell = Cell {}
}

struct Grid {
    a: Row = Row {}
    b: Row = Row {}
    c: Row = Row {}
    d: Row = Row {}
    e: Row = Row {}
    f: Row = Row {}
    g: Row = Row {}
    h: Row = Row {}
}

struct Held {
    first: Grid = Grid {}
    second: Grid = Grid {}
    third: Grid = Grid {}
    fourth: Grid = Grid {}
    fifth: Grid = Grid {}
    sixth: Grid = Grid {}
    name: str = ""
}

fn filled(seed: i64) -> Cell {
    var xs: i64[] = []
    for i in 0..64 {
        xs.push(seed + i)
    }
    Cell { items: xs }
}

fn build(seed: i64, depth: i64) -> Held {
    if depth > 0 {
        return build(seed, depth - 1)
    }
    var held = Held {}
    held.first.a.a = filled(seed)
    held.first.h.h = filled(seed + 1000)
    held.sixth.d.e = filled(seed + 2000)
    held.sixth.h.h = filled(seed + 3000)
    held.name = "held-{seed}"
    held
}

fn churn(rounds: i64) -> i64 {
    var total = 0
    for r in 0..rounds {
        var junk: i64[] = []
        for i in 0..512 {
            junk.push(r + i)
        }
        total += junk[junk.len - 1]
    }
    total
}

fn sum(cell: Cell) -> i64 {
    var total = 0
    for x in cell.items {
        total += x
    }
    total
}

fn survive(held: Held, rounds: i64, depth: i64) -> i64 {
    if depth > 0 {
        return survive(held, rounds, depth - 1)
    }
    let churned = churn(rounds)
    let kept = sum(held.first.a.a) + sum(held.first.h.h) + sum(held.sixth.d.e) + sum(held.sixth.h.h)
    kept + held.name.len + churned - churned
}

fn inspect(held: Held, f: fn(i64) -> i64) -> i64 {
    let _ = f(8192)
    sum(held.first.a.a) + sum(held.sixth.h.h) + held.name.len
}

fn main() {
    print(survive(build(1, 1), 20000, 1))
    print(survive(build(5, 1), 40000, 1))
    let held = build(9, 1)
    print(inspect(held, churn))
    print(held.name)
}
