enum Problem {
    Bad
}

fn note(s: str) {
    print(s)
}

fn early(n: i64) -> i64 {
    defer note("early: outer")
    if n > 0 {
        defer note("early: inner")
        return n * 10
    }
    n
}

fn failing(n: i64) -> i64 ! Problem {
    defer note("failing: cleanup")
    if n < 0 {
        fail Bad
    }
    n
}

fn propagate(n: i64) -> i64 ! Problem {
    defer note("propagate: cleanup")
    let v = failing(n)?
    v + 1
}

fn loops() {
    for i in 0..3 {
        defer note("loop: end of {i}")
        if i == 0 {
            continue
        }
        if i == 2 {
            break
        }
        note("loop: body {i}")
    }
}

fn main() {
    defer note("main: last")
    defer {
        let parting = "second last"
        note("main: {parting}")
    }
    print(early(1))
    print(early(0))
    print(propagate(5) or -1)
    print(propagate(-5) or -1)
    loops()
    note("main: body")
}
