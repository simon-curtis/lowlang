import std/bits
import std/simd

fn report(name: str, bad: i64) {
    if bad == 0 {
        print("{name}: ok")
    } else {
        print("{name}: {bad} mismatches")
    }
}

fn ramp(n: i64, step: u32) -> []u32 {
    var out: []u32 = []
    for k in 0..n {
        out.push(u32(k) * step)
    }
    out
}

fn sum_lanes(v: u32x8) -> u32 {
    var total: u32 = 0
    for i in 0..8 {
        let lane: u32 = simd.lane(v, i)
        total += lane
    }
    total
}

fn accumulate(data: []u32) -> u32x8 {
    var acc: u32x8 = simd.splat(0)
    var i = 0
    for i + 8 <= data.len {
        let chunk: u32x8 = simd.read(data, i)
        acc += chunk
        i += 8
    }
    acc
}

fn clamped(data: []u32, limit: u32) -> u32x8 {
    let cap: u32x8 = simd.splat(limit)
    var acc: u32x8 = simd.splat(0)
    var i = 0
    for i + 8 <= data.len {
        let chunk: u32x8 = simd.read(data, i)
        acc += simd.min(chunk, cap)
        i += 8
    }
    acc
}

fn fib(n: i64) -> i64 {
    if n < 2 {
        return n
    }
    fib(n - 1) + fib(n - 2)
}

fn across_calls() -> u32x8 {
    var acc: u32x8 = simd.splat(10)
    let step: u32x8 = simd.splat(2)
    for k in 0..4 {
        let n = fib(k + 6)
        acc += step
        print(n)
        acc += step
    }
    acc
}

fn busy(seed: u32, rounds: i64) -> u32x8 {
    var acc: u32x8 = simd.splat(seed)
    let one: u32x8 = simd.splat(1)
    var kept = 0
    for r in 0..rounds {
        acc += one
        if (r & 65535) == 0 {
            var junk: []i64 = []
            for k in 0..16384 {
                junk.push(k)
            }
            kept += junk.len
        }
    }
    if kept == 0 {
        return simd.splat(0)
    }
    acc
}

fn worker(done: chan[u32], seed: u32) {
    let v = busy(seed, 40000000)
    let first: u32 = simd.lane(v, 0)
    done <- first
}

fn concurrent() {
    let done = chan[u32](8)
    for k in 0..6 {
        spawn worker(done, u32(k * 100))
    }
    let mine = busy(7, 40000000)
    var total: u32 = 0
    for k in 0..6 {
        let got = (<-done) ?? 0
        total += got
    }
    let own: u32 = simd.lane(mine, 5)
    print(own)
    print(total)
}

fn lanes() {
    var v: u32x8 = simd.splat(1)
    for i in 0..8 {
        v = simd.with_lane(v, i, u32(i * i))
    }
    print(v)
    var b: u8x16 = simd.splat(3)
    for i in 0..16 {
        b = simd.with_lane(b, i, u8(i * 2))
    }
    var sum: u64 = 0
    for i in 0..16 {
        let x: u8 = simd.lane(b, i)
        sum += u64(x)
    }
    let fifth: u8 = simd.lane(b, 5)
    print(fifth)
    print(sum)
    var w: f32x8 = simd.splat(f32(0.5))
    w = simd.with_lane(w, 2, f32(40.0))
    let kept: f32 = simd.lane(w, 1)
    let changed: f32 = simd.lane(w, 2)
    print(kept + changed)
}

fn twice(v: u32x8) -> u32x8 {
    v + v
}

fn power(v: u32x8, n: i64) -> u32x8 {
    if n == 0 {
        return v
    }
    power(v + v, n - 1)
}

fn through_functions() {
    var acc: u32x8 = simd.splat(1)
    let step: u32x8 = simd.splat(5)
    for k in 0..3 {
        acc = twice(acc) + power(step, 2)
    }
    let last: u32 = simd.lane(acc, 6)
    print(last)
    print(power(simd.splat(3), 5))
}

fn crowded() -> u32x8 {
    let c0: u32x8 = simd.splat(1)
    let c1: u32x8 = simd.splat(2)
    let c2: u32x8 = simd.splat(3)
    let c3: u32x8 = simd.splat(4)
    let c4: u32x8 = simd.splat(5)
    let c5: u32x8 = simd.splat(6)
    let c6: u32x8 = simd.splat(7)
    let c7: u32x8 = simd.splat(8)
    let c8: u32x8 = simd.splat(9)
    let c9: u32x8 = simd.splat(10)
    var total: u32x8 = simd.splat(0)
    for i in 0..4 {
        let x: u32x8 = simd.splat(u32(i))
        total += x * c0 + c1 * c2 - c3 + c4 * c5 + c6 - c7 + c8 * c9
    }
    total
}

fn crowded128() -> u32x4 {
    let c0: u32x4 = simd.splat(1)
    let c1: u32x4 = simd.splat(2)
    let c2: u32x4 = simd.splat(3)
    let c3: u32x4 = simd.splat(4)
    let c4: u32x4 = simd.splat(5)
    let c5: u32x4 = simd.splat(6)
    let c6: u32x4 = simd.splat(7)
    let c7: u32x4 = simd.splat(8)
    let c8: u32x4 = simd.splat(9)
    let c9: u32x4 = simd.splat(10)
    var total: u32x4 = simd.splat(0)
    for i in 0..4 {
        let x: u32x4 = simd.splat(u32(i))
        total += x * c0 + c1 * c2 - c3 + c4 * c5 + c6 - c7 + c8 * c9
    }
    total
}

fn floats() {
    var a: f32x8 = simd.splat(f32(1.0))
    let two: f32x8 = simd.splat(f32(2.0))
    let quarter: f32x8 = simd.splat(f32(0.25))
    for k in 0..4 {
        a = a * two + quarter
    }
    let big: f32 = simd.lane(a, 2)
    print(big)
    var b: f32x4 = simd.splat(f32(1.5))
    let twof: f32x4 = simd.splat(f32(2.0))
    let halff: f32x4 = simd.splat(f32(0.5))
    for k in 0..4 {
        b = b * twof + halff
    }
    let scaled = b / simd.splat(f32(4.0))
    let low: f32 = simd.lane(scaled, 3)
    print(low)
    let cap: f32x8 = simd.splat(f32(10.0))
    let capped = simd.min(a, cap) - simd.max(quarter, simd.splat(f32(1.0)))
    let c: f32 = simd.lane(capped, 0)
    print(c)
}

fn find(data: []u8, c: u8) -> i64 {
    let needle: u8x32 = simd.splat(c)
    var i = 0
    for i + 32 <= data.len {
        let chunk: u8x32 = simd.read(data, i)
        let hits = simd.mask(chunk == needle)
        if hits != 0 {
            return i + bits.trailing_zeros(hits)
        }
        i += 32
    }
    -1
}

fn searching() {
    var data: []u8 = []
    for i in 0..100 {
        data.push(u8(i))
    }
    print(find(data, 77))
    print(find(data, 200))
    var order: []u8 = []
    var table: []u8 = []
    for i in 0..16 {
        order.push(u8(15 - i))
        table.push(u8(i * 3))
    }
    let t: u8x16 = simd.read(table, 0)
    let idx: u8x16 = simd.read(order, 0)
    let reversed = simd.shuffle16(t, idx)
    let first: u8 = simd.lane(reversed, 0)
    let fifth: u8 = simd.lane(reversed, 4)
    let last: u8 = simd.lane(reversed, 15)
    print(first)
    print(fifth)
    print(last)
    var out: []u32 = ramp(16, 1)
    var v: u32x8 = simd.splat(100)
    for k in 0..3 {
        v += simd.splat(u32(k))
    }
    simd.write(out, 4, v)
    print(out[3])
    print(out[4])
    print(out[11])
    print(out[12])
}

fn mix_vector(seed: u32x8, rounds: i64) -> u32x8 {
    var v = seed
    let golden: u32x8 = simd.splat(0x9E3779B1)
    let floor: u32x8 = simd.splat(0x1000)
    for r in 0..rounds {
        v = (v * golden) ^ (v >> 15)
        v = v + (v >> 3)
        v = simd.max(v, floor)
        v = simd.blend(v > golden, v ^ floor, ~v)
    }
    v
}

fn mix_lane(seed: u32, rounds: i64) -> u32 {
    var v = seed
    let golden: u32 = 0x9E3779B1
    let floor: u32 = 0x1000
    for r in 0..rounds {
        v = (v * golden) ^ (v >> 15)
        v = v + (v >> 3)
        if v < floor {
            v = floor
        }
        if v > golden {
            v = v ^ floor
        } else {
            v = ~v
        }
    }
    v
}

fn mixing() {
    var seeds: []u32 = []
    for i in 0..8 {
        seeds.push(u32(i) * 0x01010101 + 17)
    }
    let seed: u32x8 = simd.read(seeds, 0)
    var bad = 0
    for rounds in 0..40 {
        let v = mix_vector(seed, rounds)
        for i in 0..8 {
            let got: u32 = simd.lane(v, i)
            if got != mix_lane(seeds[i], rounds) {
                bad += 1
            }
        }
    }
    report("mixing", bad)
}

fn main() {
    let acc = accumulate(ramp(64, 3))
    print(acc)
    print(sum_lanes(acc))
    let capped = clamped(ramp(64, 5), 100)
    let lo: u32 = simd.lane(capped, 0)
    let hi: u32 = simd.lane(capped, 7)
    print(lo)
    print(hi)
    print(sum_lanes(capped))
    print(across_calls())
    concurrent()
    lanes()
    through_functions()
    print(crowded())
    print(crowded128())
    floats()
    searching()
    mixing()
}
