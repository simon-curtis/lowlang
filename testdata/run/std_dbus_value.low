import std/dbus

fn text_of(v: dbus.Value) -> str {
    dbus.signature_of(v) catch {
        e => return "error {e}"
    }
}

fn int_result(v: dbus.Value) -> str {
    let n = dbus.int_of(v) catch {
        e => return "{e}"
    }
    "{n}"
}

fn uint_result(v: dbus.Value) -> str {
    let n = dbus.uint_of(v) catch {
        e => return "{e}"
    }
    "{n}"
}

fn string_result(v: dbus.Value) -> str {
    let s = dbus.string_of(v) catch {
        e => return "{e}"
    }
    s
}

fn bool_result(v: dbus.Value) -> str {
    let b = dbus.bool_of(v) catch {
        e => return "{e}"
    }
    "{b}"
}

fn double_result(v: dbus.Value) -> str {
    let d = dbus.double_of(v) catch {
        e => return "{e}"
    }
    "{d}"
}

fn fd_result(v: dbus.Value) -> str {
    let fd = dbus.fd_of(v) catch {
        e => return "{e}"
    }
    "{fd}"
}

fn bytes_result(v: dbus.Value) -> str {
    let b = dbus.bytes_of(v) catch {
        e => return "{e}"
    }
    "{b}"
}

fn array_result(v: dbus.Value) -> str {
    let items = dbus.array_of(v) catch {
        e => return "{e}"
    }
    "{items.len} items"
}

fn fields_result(v: dbus.Value) -> str {
    let fields = dbus.fields_of(v) catch {
        e => return "{e}"
    }
    "{fields.len} fields"
}

fn unwrap_result(v: dbus.Value) -> str {
    let inner = dbus.unwrap(v) catch {
        e => return "{e}"
    }
    "{inner}"
}

fn dict_result(v: dbus.Value) -> str {
    let entries = dbus.dict_of(v) catch {
        e => return "{e}"
    }
    var out = ""
    for name, value in entries {
        out = "{out}{name}={value};"
    }
    out
}

fn entry(k: dbus.Value, v: dbus.Value) -> dbus.Value {
    dbus.Value.DictEntry(new(k), new(v))
}

fn main() {
    print("signature_of scalars")
    let scalars = [
        dbus.Value.Byte(1),
        dbus.Value.Boolean(true),
        dbus.Value.Int16(-1),
        dbus.Value.UInt16(1),
        dbus.Value.Int32(-1),
        dbus.Value.UInt32(1),
        dbus.Value.Int64(-1),
        dbus.Value.UInt64(1),
        dbus.Value.Double(1.0),
        dbus.Value.String("s"),
        dbus.Value.ObjectPath("/"),
        dbus.Value.Signature("i"),
        dbus.Value.UnixFd(3),
    ]
    for v in scalars {
        print("  {text_of(v)}")
    }

    print("signature_of containers")
    print("  {text_of(dbus.Value.Bytes([1, 2]))}")
    print("  {text_of(dbus.Value.Array("i", []))}")
    print("  {text_of(dbus.Value.Array("(ii)", []))}")
    print("  {text_of(dbus.Value.Array("{{sv}}", []))}")
    print("  {text_of(dbus.Value.Array("ii", []))}")
    print("  {text_of(dbus.Value.Array("", []))}")
    print("  {text_of(dbus.Value.Struct([dbus.Value.Int32(1), dbus.Value.String("x")]))}")
    print("  {text_of(dbus.Value.Struct([]))}")
    print("  {text_of(dbus.variant(dbus.Value.Int32(1)))}")
    print("  {text_of(entry(dbus.Value.String("k"), dbus.variant(dbus.Value.Byte(1))))}")
    print("  {text_of(dbus.strings(["a", "b"]))}")
    print("  {text_of(dbus.strings([]))}")
    print("  {text_of(dbus.dict(["a": dbus.Value.Int32(1)]))}")
    print("  {text_of(dbus.dict([:]))}")

    print("values_signature")
    let signature = dbus.values_signature([dbus.Value.Int32(1), dbus.Value.String("x"), dbus.strings(["a"])]) or "failed"
    print("  {signature}")
    let empty = dbus.values_signature([]) or "failed"
    print("  [{empty}]")
    let bad = dbus.values_signature([dbus.Value.Int32(1), dbus.Value.Struct([])]) or "failed"
    print("  {bad}")

    print("variant, strings and dict")
    print("  {dbus.variant(dbus.Value.Byte(9))}")
    print("  {dbus.strings(["a", "b"])}")
    let wrapped = dbus.dict(["one": dbus.Value.Int32(1), "two": dbus.variant(dbus.Value.String("2"))])
    print("  {wrapped}")
    print("  dict_of {dict_result(wrapped)}")
    let repeated = dbus.Value.Array("{{sv}}", [
        entry(dbus.Value.String("a"), dbus.variant(dbus.Value.Int32(1))),
        entry(dbus.Value.String("a"), dbus.variant(dbus.Value.Int32(2))),
    ])
    print("  dict_of repeated {dict_result(repeated)}")
    print("  dict_of non-array {dict_result(dbus.Value.Int32(1))}")
    print("  dict_of non-entry {dict_result(dbus.Value.Array("i", [dbus.Value.Int32(1)]))}")
    print("  dict_of numeric key {dict_result(dbus.Value.Array("{{ii}}", [entry(dbus.Value.Int32(1), dbus.Value.Int32(2))]))}")
    print("  dict_of empty {dict_result(dbus.dict([:]))}")

    print("bool_of")
    print("  {bool_result(dbus.Value.Boolean(false))}")
    print("  {bool_result(dbus.Value.Int32(1))}")

    print("int_of")
    for v in [
        dbus.Value.Byte(255),
        dbus.Value.Int16(-32768),
        dbus.Value.UInt16(65535),
        dbus.Value.Int32(-2147483648),
        dbus.Value.UInt32(4294967295),
        dbus.Value.Int64(-9223372036854775807),
        dbus.Value.UInt64(9223372036854775807),
        dbus.Value.UInt64(9223372036854775808),
        dbus.Value.Double(1.0),
        dbus.Value.String("1"),
    ] {
        print("  {int_result(v)}")
    }

    print("uint_of")
    for v in [
        dbus.Value.Byte(7),
        dbus.Value.Int16(5),
        dbus.Value.Int32(-1),
        dbus.Value.Int64(-9),
        dbus.Value.UInt64(18446744073709551615),
        dbus.Value.UInt32(4294967295),
        dbus.Value.String("1"),
    ] {
        print("  {uint_result(v)}")
    }

    print("double_of")
    print("  {double_result(dbus.Value.Double(2.5))}")
    print("  {double_result(dbus.Value.Int32(2))}")

    print("string_of")
    print("  {string_result(dbus.Value.String("text"))}")
    print("  {string_result(dbus.Value.ObjectPath("/p"))}")
    print("  {string_result(dbus.Value.Signature("ii"))}")
    print("  {string_result(dbus.Value.Int32(1))}")

    print("fd_of")
    print("  {fd_result(dbus.Value.UnixFd(12))}")
    print("  {fd_result(dbus.Value.Int32(12))}")

    print("bytes_of")
    print("  {bytes_result(dbus.Value.Bytes([1, 2, 3]))}")
    print("  {bytes_result(dbus.Value.Array("y", [dbus.Value.Byte(4), dbus.Value.Byte(5)]))}")
    print("  {bytes_result(dbus.Value.Array("i", [dbus.Value.Int32(4)]))}")
    print("  {bytes_result(dbus.Value.String("x"))}")

    print("array_of")
    print("  {array_result(dbus.Value.Bytes([1, 2, 3]))}")
    print("  {array_result(dbus.strings(["a"]))}")
    print("  {array_result(dbus.Value.Int32(1))}")

    print("fields_of")
    print("  {fields_result(dbus.Value.Struct([dbus.Value.Int32(1), dbus.Value.Int32(2)]))}")
    print("  {fields_result(dbus.Value.Int32(1))}")

    print("unwrap")
    print("  {unwrap_result(dbus.variant(dbus.Value.Int32(1)))}")
    print("  {unwrap_result(dbus.variant(dbus.variant(dbus.Value.Byte(2))))}")
    print("  {unwrap_result(dbus.Value.Int32(1))}")
}
