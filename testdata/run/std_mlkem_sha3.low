import std/crypto/hash
import std/crypto/sha3
import std/text

fn data(n: i64) -> []u8 {
    var out: []u8 = []
    for i in 0..n {
        push(mut out, u8((i * 131 + n * 7) % 251))
    }
    out
}

fn split(a: hash.Algorithm, d: []u8) -> str {
    let g = a.digest()
    let third = d.len / 3
    g.update(d[..third])
    let snapshot = g.clone()
    g.update(d[third..])
    snapshot.update(d[third..])
    let x = text.encode_hex(g.finish())
    let y = text.encode_hex(snapshot.finish())
    if x != y {
        return "clone mismatch"
    }
    x
}

fn shake(s: *sha3.Shake, d: []u8) -> str {
    let half = d.len / 2
    sha3.absorb(s, d[..half])
    sha3.absorb(s, d[half..])
    var out: []u8 = []
    for n in [1, 167, 168, 0, 200, 37] {
        for b in sha3.squeeze(s, n) {
            push(mut out, b)
        }
    }
    text.encode_hex(hash.sum(sha3.sha3_256(), out))
}

fn main() {
    for input in [bytes(""), bytes("abc")] {
        print(text.encode_hex(hash.sum(sha3.sha3_256(), input)))
        print(text.encode_hex(hash.sum(sha3.sha3_384(), input)))
        print(text.encode_hex(hash.sum(sha3.sha3_512(), input)))
        let a = sha3.shake128()
        sha3.absorb(a, input)
        print(text.encode_hex(sha3.squeeze(a, 32)))
        let b = sha3.shake256()
        sha3.absorb(b, input)
        print(text.encode_hex(sha3.squeeze(b, 64)))
    }
    for n in [0, 1, 71, 72, 73, 103, 104, 105, 135, 136, 137, 167, 168, 169, 271, 272, 273, 335, 336, 337, 1000, 5000] {
        let d = data(n)
        print(split(sha3.sha3_256(), d))
        print(split(sha3.sha3_384(), d))
        print(split(sha3.sha3_512(), d))
        print(shake(sha3.shake128(), d))
        print(shake(sha3.shake256(), d))
    }
}
