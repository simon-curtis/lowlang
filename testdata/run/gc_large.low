struct W8 {
    a: i64
    b: i64
    c: i64
    d: i64
    e: i64
    f: i64
    g: i64
    h: i64
}

struct W64 {
    a: W8
    b: W8
    c: W8
    d: W8
    e: W8
    f: W8
    g: W8
    h: W8
}

struct W128 {
    lo: W64
    hi: W64
}

enum Tree {
    Node(*Tree, i64, *Tree)
    Leaf
}

fn w8(n: i64) -> W8 {
    W8 { a: n, b: n, c: n, d: n, e: n, f: n, g: n, h: n }
}

fn w64(n: i64) -> W64 {
    W64 { a: w8(n), b: w8(n), c: w8(n), d: w8(n), e: w8(n), f: w8(n), g: w8(n), h: w8(n) }
}

fn tree(depth: i64, value: i64) -> Tree {
    if depth == 0 {
        return Tree.Leaf
    }
    Node(new(tree(depth - 1, value * 2)), value, new(tree(depth - 1, value * 2 + 1)))
}

fn total(t: Tree) -> i64 {
    match t {
        Node(l, v, r) => total(*l) + v + total(*r)
        Leaf => 0
    }
}

fn main() {
    let kept = new(W128 { lo: w64(-1), hi: w64(-2) })
    let shape = tree(10, 1)
    var i = 0
    var sum = 0
    for i < 60000 {
        let big = new(W128 { lo: w64(i), hi: w64(i + 1) })
        let small = new(w8(i))
        sum += big.hi.h.h - big.lo.a.a + small.c
        if i % 1000 == 0 {
            sum += total(tree(8, 1))
        }
        i += 1
    }
    print(sum)
    print(kept.lo.d.e + kept.hi.h.h)
    print(total(shape))
}
