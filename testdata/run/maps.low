struct Point {
    x: i64
    y: i64
}

fn count(words: []str) -> [str: i64] {
    let counts: [str: i64] = [:]
    for w in words {
        counts[w] += 1
    }
    counts
}

fn main() {
    let ages = ["ada": 36, "alan": 41]
    print(ages.len)
    print(ages["ada"] ?? -1)
    print(ages["bob"] ?? -1)
    ages["grace"] = 85
    ages["ada"] = 37
    print(ages.len)
    for k, v in ages {
        print("{k}={v}")
    }

    var shared = ages
    delete(mut shared, "alan")
    delete(mut shared, "nobody")
    print(ages.len)
    for k in ages {
        print(k)
    }
    print(ages["alan"] ?? 0)
    ages["alan"] = 1
    for k in ages {
        print(k)
    }

    let counts = count(["a", "b", "a", "c", "a", "b"])
    for k, v in counts {
        print("{k} {v}")
    }

    var squares: [i64: i64] = [:]
    for i in 0..1000 {
        squares[i] = i * i
    }
    for i in 0..1000 {
        if i % 2 == 0 {
            delete(mut squares, i)
        }
    }
    print(squares.len)
    print(squares[999] ?? -1)
    print(squares[998] ?? -1)
    var total = 0
    for k, v in squares {
        total += v
    }
    print(total)
    for i in 0..2000 {
        squares[i + 5000] = i
    }
    print(squares.len)
    print(squares[5001] ?? -1)
    print(squares[999] ?? -1)
    print(squares[2] ?? -1)

    let places: [str: Point] = ["home": Point { x: 1, y: 2 }]
    places["work"] = Point { x: 5, y: 6 }
    match places["work"] {
        some(p) => print(p.x + p.y)
        none => print(0)
    }

    let flags = [true: "yes", false: "no"]
    print(flags[1 > 0] ?? "?")
    let firsts: [u8: i64] = [:]
    firsts['a'] = 1
    print(firsts['a'] ?? 0)
    print(firsts['b'] ?? 0)
}
