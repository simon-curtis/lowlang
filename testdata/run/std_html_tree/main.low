import std/html
import std/slices
import std/text

struct Case {
    line: i64
    data: str
    context: str?
    expected: str
    script: bool
}

struct Totals {
    passed: i64
    failed: i64
    skipped: i64
}

fn starts_case(lines: str[], i: i64) -> bool {
    if lines[i] != "" || i + 1 >= lines.len {
        return false
    }
    lines[i + 1] == "#data" || lines[i + 1] == "#description"
}

fn split_cases(content: str) -> Case[] {
    let lines = text.split_str(content, "\n")
    var cases: Case[] = []
    var start = 0
    for start < lines.len && lines[start] == "" {
        start += 1
    }
    var i = start
    for i <= lines.len {
        if i == lines.len || starts_case(lines, i) {
            var end = i
            for end > start && lines[end - 1] == "" {
                end -= 1
            }
            if end > start {
                cases.push(read_case(lines[start..end], start + 1))
            }
            start = i + 1
        }
        i += 1
    }
    cases
}

fn read_case(lines: str[], line: i64) -> Case {
    var section = ""
    var data: str[] = []
    var document: str[] = []
    var context: str? = none
    var script = false
    for l in lines {
        match l {
            "#description" => { section = "description" }
            "#data" => { section = "data" }
            "#errors" => { section = "errors" }
            "#new-errors" => { section = "errors" }
            "#document-fragment" => { section = "fragment" }
            "#document" => { section = "document" }
            "#script-on" => { script = true }
            "#script-off" => { section = "off" }
            _ => match section {
                "data" => data.push(l)
                "fragment" => {
                    context = l
                    section = "off"
                }
                "document" => document.push(l)
                _ => {}
            }
        }
    }
    Case { line, data: text.join(data, "\n"), context, expected: text.join(document, "\n"), script }
}

fn display_name(a: html.Attr) -> str {
    if a.prefix == "" { a.name } else { "{a.prefix} {a.name}" }
}

fn dump_attributes(e: *html.Element, depth: i64, mut out: str[]) {
    var names: str[] = []
    let values: [str: str] = [:]
    for a in e.attributes {
        let name = display_name(a)
        names.push(name)
        values[name] = a.value
    }
    slices.sort(mut names)
    let pad = text.repeat("  ", depth)
    for name in names {
        let value = values[name] ?? ""
        out.push("| {pad}{name}=\"{value}\"")
    }
}

fn dump_children(n: *html.Node, depth: i64, mut out: str[]) {
    for c in html.children(n) {
        dump_node(c, depth, mut out)
    }
}

fn dump_node(n: *html.Node, depth: i64, mut out: str[]) {
    let pad = text.repeat("  ", depth)
    match n.data {
        Doctype(name, public_id, system_id) => {
            if public_id == "" && system_id == "" {
                out.push("| {pad}<!DOCTYPE {name}>")
            } else {
                out.push("| {pad}<!DOCTYPE {name} \"{public_id}\" \"{system_id}\">")
            }
        }
        Element(e) => {
            let label = match e.namespace {
                Svg => "svg {e.name}"
                MathMl => "math {e.name}"
                _ => e.name
            }
            out.push("| {pad}<{label}>")
            dump_attributes(e, depth + 1, mut out)
            if html.is_html(n, "template") {
                out.push("| {pad}  content")
                let contents = html.template_contents(n) ?? n
                dump_children(contents, depth + 2, mut out)
            } else {
                dump_children(n, depth + 1, mut out)
            }
        }
        Text(s) => out.push("| {pad}\"{s}\"")
        Comment(s) => out.push("| {pad}<!-- {s} -->")
        Instruction(target, data) => out.push("| {pad}<?{target} {data}?>")
        _ => dump_children(n, depth, mut out)
    }
}

fn context_element(spec: str) -> *html.Node {
    let parts = text.split_str(spec, " ")
    if parts.len == 2 {
        let ns = if parts[0] == "svg" { html.Namespace.Svg } else { html.Namespace.MathMl }
        return html.create_element(ns, parts[1], [])
    }
    html.create_element(html.Namespace.Html, spec, [])
}

fn actual(c: Case) -> str {
    var out: str[] = []
    match c.context {
        some(spec) => {
            let parsed = html.parse_fragment(context_element(spec), c.data)
            dump_children(parsed.root, 0, mut out)
        }
        none => {
            let parsed = html.parse(c.data)
            dump_children(parsed.root, 0, mut out)
        }
    }
    text.join(out, "\n")
}

fn main() {
    let files = embed_dir("data")
    var names: str[] = []
    for name, content in files {
        if text.ends_with(name, ".dat") {
            names.push(name)
        }
    }
    slices.sort(mut names)
    var all = Totals { passed: 0, failed: 0, skipped: 0 }
    for name in names {
        let content = files[name] ?? ""
        var totals = Totals { passed: 0, failed: 0, skipped: 0 }
        var failures: str[] = []
        for c in split_cases(content) {
            if c.script {
                totals.skipped += 1
                continue
            }
            let got = actual(c)
            if got == c.expected {
                totals.passed += 1
            } else {
                totals.failed += 1
                failures.push("{name}:{c.line}")
                failures.push("input: {text.quote(c.data)}\nexpected:\n{c.expected}\ngot:\n{got}")
            }
        }
        let total = totals.passed + totals.failed
        print("{name}: {totals.passed}/{total} skipped {totals.skipped}")
        for f in failures {
            print("  FAIL {f}")
        }
        all.passed += totals.passed
        all.failed += totals.failed
        all.skipped += totals.skipped
    }
    print("passed {all.passed} failed {all.failed} skipped {all.skipped}")
}
