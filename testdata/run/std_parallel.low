import std/atomic
import std/parallel

enum Bad {
    Index(i: i64)
}

fn visits(count: i64) -> i64[] {
    var seen: i64[] = []
    for _ in 0..count {
        seen.push(0)
    }
    parallel.each(count, fn(i: i64) {
        seen[i] += 1
    })
    seen
}

fn all_once(seen: i64[]) -> bool {
    for n in seen {
        if n != 1 {
            return false
        }
    }
    true
}

fn covered(count: i64, grain: i64) -> str {
    var seen: i64[] = []
    for _ in 0..count {
        seen.push(0)
    }
    let calls = atomic.int(0)
    let longest = atomic.int(0)
    parallel.chunks(count, grain, fn(start: i64, end: i64) {
        let _ = calls.add_int(1)
        let _ = longest.update_int(fn(n: i64) -> i64 { if end - start > n { end - start } else { n } })
        for i in start..end {
            seen[i] += 1
        }
    })
    "{calls.load_int()} calls, longest {longest.load_int()}, each index once: {all_once(seen)}"
}

fn fails_at(i: i64) -> Bad? {
    if i % 1000 == 617 {
        return some(Bad.Index(i))
    }
    none
}

fn meet() -> i64 {
    if parallel.cpus() == 1 {
        return 42
    }
    let handoff = chan[i64]()
    let got = atomic.int(0)
    parallel.each(2, fn(i: i64) {
        if i == 0 {
            handoff <- 42
        } else {
            got.store_int((<-handoff) ?? 0)
        }
    })
    got.load_int()
}

fn main() {
    print("cpus at least 1: {parallel.cpus() >= 1}")
    print("two jobs meet on a channel: {meet()}")
    print("chunks 5 by the largest i64: {covered(5, 9223372036854775807)}")
    print("each 0: {visits(0).len}")
    print("each -3: {visits(-3).len}")
    print("each 1: {all_once(visits(1))}")
    print("each 100000: {all_once(visits(100000))}")

    print("chunks 10 by 3: {covered(10, 3)}")
    print("chunks 12 by 3: {covered(12, 3)}")
    print("chunks 5 by 0: {covered(5, 0)}")
    print("chunks 5 by 100: {covered(5, 100)}")
    print("chunks 0 by 4: {covered(0, 4)}")

    let total = atomic.int(0)
    parallel.each(40, fn(i: i64) {
        parallel.each(40, fn(j: i64) {
            let _ = total.add_int(i * j)
        })
    })
    print("nested: {total.load_int()}")

    print(parallel.map([3, 1, 4, 1, 5, 9, 2, 6], fn(x: i64) -> str { "<{x * x}>" }))
    let none_in: i64[] = []
    print(parallel.map(none_in, fn(x: i64) -> i64 { x }).len)
    var big: i64[] = []
    for i in 0..50000 {
        big.push(i)
    }
    let doubled = parallel.map(big, fn(x: i64) -> i64 { x * 2 })
    var in_order = doubled.len == big.len
    for i in 0..doubled.len {
        in_order = in_order && doubled[i] == i * 2
    }
    print("map keeps order: {in_order}")

    let below = atomic.int(0)
    let failed = parallel.try_each[Bad](200000, fn(i: i64) -> Bad? {
        if i < 617 {
            let _ = below.add_int(1)
        }
        fails_at(i)
    })
    match failed {
        some(e) => print("lowest failure: {e}, calls below it: {below.load_int()}")
        none => print("no failure")
    }
    let clean = parallel.try_each[Bad](1000, fn(i: i64) -> Bad? { none })
    print("clean: {clean == none}")
}
