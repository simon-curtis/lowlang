import std/file
import std/io

fn pattern(n: i64) -> []u8 {
    var data: []u8 = []
    var x: u64 = 0x2545F4914F6CDD1D
    for i in 0..n {
        x = x ^ (x << 13)
        x = x ^ (x >> 7)
        x = x ^ (x << 17)
        push(mut data, u8(x >> 56))
    }
    data
}

fn checksum(data: []u8) -> i64 {
    var sum = 0
    for i in 0..data.len {
        sum = (sum * 31 + i64(data[i]) + i) % 1000000007
    }
    sum
}

fn same(a: []u8, b: []u8) -> bool {
    if a.len != b.len {
        return false
    }
    for i in 0..a.len {
        if a[i] != b[i] {
            return false
        }
    }
    true
}

fn failure(path: str) -> str {
    file.read_file(path) or return "error"
    "read"
}

fn main() ! io.Error {
    let dir = file.temp_dir("low-read-file-")?
    for size in [0, 1, 2, 63, 64, 65, 4095, 4096, 4097, 65535, 65536, 65537, 131072, 200003, 1000000] {
        let path = "{dir}/data-{size}.bin"
        let data = pattern(size)
        file.write_file(path, data)?
        let back = file.read_file(path)?
        print("{size} {back.len} {same(data, back)} {checksum(back)}")
        let text = file.read_text(path)?
        print("{text.len}")
    }
    let appended = "{dir}/grown.bin"
    file.write_file(appended, pattern(10))?
    {
        using f = file.append(appended)?
        file.write_all(f, pattern(70000))?
    }
    let grown = file.read_file(appended)?
    print("grown {grown.len} {checksum(grown)}")
    let proc = file.read_text("/proc/self/status")?
    print("proc {proc.len > 100} {proc[..5]}")
    let cmdline = file.read_file("/proc/self/cmdline")?
    print("cmdline {cmdline.len > 0}")
    let sizes = file.stat("/proc/self/status")?.size
    print("proc size {sizes}")
    print("directory {failure(dir)}")
    print("missing {failure("{dir}/absent")}")
    file.remove_all(dir)?
}
