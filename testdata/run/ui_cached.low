import std/ui
import std/ui/geometry
import std/ui/scene

fn widths(s: scene.Scene) -> str {
    var out = ""
    for q in s.quads {
        out = "{out} {q.bounds.width}"
    }
    out
}

fn shot(cx: ui.Context, render: fn() -> ui.Element) -> str {
    let s = cx.frame(render, geometry.size(200.0, 100.0), 1.0)
    widths(s)
}

fn bar(width: f32) -> ui.Element {
    ui.div().size(width, 10.0).background(ui.rgb(0xff0000))
}

fn reuse(cx: ui.Context) {
    print("reuse")
    let wide = cx.signal(f32(10.0))
    let other = cx.signal(0)
    var builds = 0
    let render = fn() -> ui.Element {
        ui.div().column().children() {
            ui.cached(cx, "bar", fn() -> ui.Element {
                builds += 1
                bar(wide.get())
            })
            bar(f32(other.get()) + 1.0)
        }
    }
    let first = shot(cx, render)
    print("first{first} builds {builds}")
    let again = shot(cx, render)
    print("again{again} builds {builds}")
    other.set(5)
    let unrelated = shot(cx, render)
    print("unrelated{unrelated} builds {builds}")
    wide.set(30.0)
    let changed = shot(cx, render)
    print("changed{changed} builds {builds}")
}

fn nested(cx: ui.Context) {
    print("nested")
    let inner = cx.signal(f32(10.0))
    var outer_builds = 0
    var inner_builds = 0
    let render = fn() -> ui.Element {
        ui.cached(cx, "outer", fn() -> ui.Element {
            outer_builds += 1
            ui.div().column().children() {
                bar(50.0)
                ui.cached(cx, "inner", fn() -> ui.Element {
                    inner_builds += 1
                    bar(inner.get())
                })
            }
        })
    }
    let first = shot(cx, render)
    print("first{first} outer {outer_builds} inner {inner_builds}")
    inner.set(20.0)
    let changed = shot(cx, render)
    print("changed{changed} outer {outer_builds} inner {inner_builds}")
}

fn memo_cutoff(cx: ui.Context) {
    print("memo")
    let n = cx.signal(2)
    let even = cx.memo(fn() -> bool { n.get() % 2 == 0 })
    var builds = 0
    let render = fn() -> ui.Element {
        ui.cached(cx, "parity", fn() -> ui.Element {
            builds += 1
            bar(if even.read() { 20.0 } else { 10.0 })
        })
    }
    let first = shot(cx, render)
    n.set(4)
    let same = shot(cx, render)
    print("same parity{same} builds {builds}")
    n.set(5)
    let flipped = shot(cx, render)
    print("flipped{flipped} builds {builds}")
    print("first{first}")
}

fn focus(cx: ui.Context) {
    print("focus")
    var builds = 0
    let render = fn() -> ui.Element {
        ui.cached(cx, "focus", fn() -> ui.Element {
            builds += 1
            bar(if cx.focused() == "box" { 40.0 } else { 10.0 })
        })
    }
    let first = shot(cx, render)
    cx.set_focus("box")
    let focused = shot(cx, render)
    print("focused{focused} builds {builds} first{first}")
}

fn dropped(cx: ui.Context) {
    print("dropped")
    let shown = cx.signal(true)
    var builds = 0
    let render = fn() -> ui.Element {
        ui.div().children() {
            if shown.get() {
                ui.cached(cx, "maybe", fn() -> ui.Element {
                    builds += 1
                    bar(15.0)
                })
            } else {
                bar(5.0)
            }
        }
    }
    shot(cx, render)
    shot(cx, render)
    print("shown builds {builds}")
    shown.set(false)
    let hidden = shot(cx, render)
    shown.set(true)
    let back = shot(cx, render)
    print("hidden{hidden} back{back} builds {builds}")
}

fn main() {
    let cx = ui.headless(ui.rgb(0xffffff))
    reuse(cx)
    nested(cx)
    memo_cutoff(cx)
    focus(cx)
    dropped(cx)
    listed(cx)
    actions(cx)
    clicks(cx)
}

fn listed(cx: ui.Context) {
    print("listed")
    let render = fn() -> ui.Element {
        ui.uniform_list("list", 20, fn(first, end) {
            var out: []ui.Element = []
            for i in first..end {
                out.push(ui.cached(cx, "item{i}", fn() -> ui.Element {
                    ui.div().focusable().height(10.0)
                }))
            }
            out
        }).size(100.0, 50.0)
    }
    shot(cx, render)
    cx.scroll_to("list", geometry.point(0.0, 30.0))
    shot(cx, render)
    cx.dispatch(PointerDown(Left, 5.0, 2.0))
    cx.dispatch(PointerUp(Left, 5.0, 2.0))
    print("focus {cx.focused()}")
}

fn actions(cx: ui.Context) {
    print("actions")
    cx.set_focus("")
    var builds = 0
    let render = fn() -> ui.Element {
        ui.div().column().children() {
            ui.cached(cx, "menu", fn() -> ui.Element {
                builds += 1
                bar(if cx.is_action_available("copy") { 30.0 } else { 10.0 })
            })
            ui.div().id("editor").focusable().size(10.0, 10.0).on_action("copy", fn() {})
        }
    }
    let before = shot(cx, render)
    cx.set_focus("editor")
    let after = shot(cx, render)
    print("before{before} after{after} builds {builds}")
}

fn clicks(cx: ui.Context) {
    print("clicks")
    cx.set_focus("")
    var builds = 0
    let render = fn() -> ui.Element {
        ui.div().size(200.0, 100.0).children() {
            ui.cached(cx, "plain", fn() -> ui.Element {
                builds += 1
                bar(if cx.focused() == "" { 10.0 } else { 20.0 })
            })
        }
    }
    shot(cx, render)
    for _ in 0..3 {
        cx.dispatch(PointerDown(Left, 150.0, 80.0))
        cx.dispatch(PointerUp(Left, 150.0, 80.0))
        shot(cx, render)
    }
    print("builds {builds}")
}
