import std/json

struct Leaf {
    value: i64
}

struct Fork {
    left: *Leaf
    right: *Leaf
}

enum Tree {
    Branch(*Tree, *Tree)
    Tip(i64)
}

fn main() {
    let leaf = new(Leaf { value: 5 })
    print(json.serialize(Fork { left: leaf, right: leaf }))

    let tip = new(Tree.Tip(1))
    print(json.serialize(Tree.Branch(tip, tip)))
    print(json.serialize([leaf, leaf, leaf]))
}
