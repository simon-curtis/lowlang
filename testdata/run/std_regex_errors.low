import std/regex
import std/text

fn esc(s: str) -> str {
    if s.len > 64 {
        return "{esc(s[..32])}...({s.len} bytes)"
    }
    s |> text.replace("\n", "\\n") |> text.replace("\r", "\\r") |> text.replace("\t", "\\t")
}

fn flags(spec: str) -> regex.Flags {
    regex.Flags { ignore_case: text.contains(spec, "i"), multiline: text.contains(spec, "m"), dot_all: text.contains(spec, "s") }
}

fn compiled(pattern: str, spec: str) -> regex.Regex? {
    let re = regex.compile_with(pattern, flags(spec)) catch {
        Invalid(at, message) => {
            print("  error at {at}: {message}")
            return none
        }
    }
    re
}

fn case_test(pattern: str, spec: str, input: str) {
    print("test /{esc(pattern)}/{spec} [{esc(input)}]")
    let re = compiled(pattern, spec) ?? return
    print("  {re.is_match(input)}")
}

fn main() {
    case_test("(ab", "", "")
    case_test("a(b(c)", "", "")
    case_test("(?:a", "", "")
    case_test("ab)", "", "")
    case_test("*a", "", "")
    case_test("a|*", "", "")
    case_test("(+)", "", "")
    case_test("{{2}}", "", "")
    case_test("\\b+", "", "")
    case_test("^*", "", "")
    case_test("a**", "", "")
    case_test("a???", "", "")
    case_test("x{{1,2}}{{3}}", "", "")
    case_test("a*+", "", "")
    case_test("a{{3,2}}", "", "")
    case_test("a{{10001}}", "", "")
    case_test("a{{1,99999}}", "", "")
    case_test("[abc", "", "")
    case_test("[]", "", "")
    case_test("[^]", "", "")
    case_test("x[a-", "", "")
    case_test("[z-a]", "", "")
    case_test("[\\d-z]", "", "")
    case_test("[a-\\w]", "", "")
    case_test("\\q", "", "")
    case_test("[\\A]", "", "")
    case_test("a\\", "", "")
    case_test("\\x4", "", "")
    case_test("\\xzz", "", "")
    case_test("\\u12", "", "")
    case_test("\\U00110000", "", "")
    case_test("(a)\\1", "", "")
    case_test("(?=a)", "", "")
    case_test("(?<!a)b", "", "")
    case_test("(?P<year>a)", "", "")
    case_test("(?", "", "")
    case_test("(?i", "", "")
    case_test("(?q)", "", "")
    case_test("(?)", "", "")
    case_test("(?iq)", "", "")
    case_test("(?-q:a)", "", "")
    case_test("(?--i:a)", "", "")
    case_test("(?i-:a)", "", "")
    case_test("(?x)a", "", "")
    case_test("(?:a{{1000}}){{1000}}", "", "")
}
