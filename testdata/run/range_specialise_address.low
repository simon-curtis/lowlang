fn sieve(limit: i64) -> i64 {
    var composite: []u8 = []
    for i in 0..limit {
        push(mut composite, u8(0))
    }
    var count = 0
    for i in 2..limit {
        if composite[i] == 0 {
            count += 1
            var j = i * i
            for j < limit {
                composite[j] = 1
                j += i
            }
        }
    }
    count
}

fn run(f: fn(i64) -> i64, n: i64) -> i64 {
    f(n)
}

fn main() {
    print(sieve(100))
    print(run(sieve, 1000))
}
