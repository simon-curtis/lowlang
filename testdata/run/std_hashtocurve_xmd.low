        Vector { name: "extra sha512 16320 digest", hash: "sha512", dst: "DST", msg: "abc", length: 16320, expected: "3f0c02b81beda57eb4ec8b4c288bf3ec09d9fb66f20eb08f42d2a5aabc7a88a2", digest: true }
    ]
}

fn check(v: Vector) {
    let out = hashtocurve.expand_message_xmd(algorithm(v.hash), bytes(v.msg), bytes(v.dst), v.length) catch {
        Length => {
            print("{v.name}: length error")
            return
        }
    }
    var got = text.encode_hex(out)
    if v.digest {
        got = text.encode_hex(hash.sum(hash.sha256(), out))
    }
    let verdict = if got == v.expected { "ok" } else { "MISMATCH {got}" }
    print("{v.name}: {verdict}")
}

fn refuse(label: str, length: i64) {
    let out = hashtocurve.expand_message_xmd(hash.sha256(), bytes("abc"), bytes("DST"), length) catch {
        Length => {
            print("{label}: length error")
            return
        }
    }
    print("{label}: accepted {out.len} bytes")
}

fn main() {
    for v in vectors() {
        check(v)
    }
    for v in extras() {
        check(v)
    }
    refuse("length -1", -1)
    refuse("length 0", 0)
    refuse("length 8160", 8160)
    refuse("length 8161", 8161)
    refuse("length 65536", 65536)
}
