import std/crypto/hash
import std/crypto/hashtocurve
import std/text

struct Vector {
    name: str
    hash: str
    dst: str
    msg: str
    length: i64
    expected: str
    digest: bool
}

fn algorithm(name: str) -> hash.Algorithm {
    match name {
        "sha512" => hash.sha512()
        _ => hash.sha256()
    }
}

