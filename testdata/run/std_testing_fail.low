import std/file
import std/os
import std/rand
import std/testing
import std/text

struct Point {
    x: i64
    y: i64
}

enum Shape {
    Circle(r: f64)
    Rect(w: i64, h: i64)
    Dot
}

fn parse(s: str) -> i64 ! text.ParseError {
    text.parse_int(s)?
}

fn fails_equal(t: *testing.T) {
    t.equal(2 + 2, 5)
    t.equal("go", "golang")
    t.equal(0.1 + 0.2, 0.3)
    t.equal(true, false)
    t.equal(Point { x: 1, y: 2 }, Point { x: 1, y: 3 })
    t.equal(Shape.Rect(2, 3), Shape.Circle(1.5))
    t.not_equal("same", "same")
}

fn fails_truth(t: *testing.T) {
    let some_value: i64? = 4
    let no_value: i64? = none
    t.is_true(1 > 2)
    t.is_false(1 < 2)
    t.is_some(no_value)
    t.is_none(some_value)
}

fn fails_collections(t: *testing.T) {
    t.equal_slice([1, 2, 3], [1, 5, 3])
    t.equal_slice(["a"], ["a", "b"])
    t.contains_item([1.5, 2.5], 3.5)
    t.contains("hello world", "xyz")
    t.close_to(1.0, 1.5, 0.25)
    t.close_to(0.0 / 0.0, 1.0, 100.0)
}

fn fails_errors(t: *testing.T) {
    let n = parse("") catch { e => t.unexpected(e, -1) }
    t.equal(n, -1)
    let m = parse("x") catch { e => t.expect_error(e, text.ParseError.Empty, 0) }
    t.equal(m, 0)
}

fn stops_at_fatal(t: *testing.T) {
    t.log("before")
    t.fatal("fatal stops here")
    t.error("never recorded")
}

fn stops_at_require(t: *testing.T) {
    t.require(t.equal(1, 2))
    t.error("never recorded")
}

fn stops_at_must(t: *testing.T) {
    let n = parse("12x") catch { e => t.must(e, 0) }
    t.log("never recorded {n}")
}

fn conditions(t: *testing.T) {
    t.error_if(3 > 2, "three exceeds two")
    t.error_if(2 > 3, "not recorded")
    t.fatal_if(1 == 1, "one is one")
    t.error("never recorded")
}

fn fails_in_subtests(t: *testing.T) {
    t.sub("passes", fn(st) { st.equal(1, 1) })
    let ok = t.sub("fails", fn(st) {
        st.log("context")
        st.equal(1, 2)
    })
    t.log("sub returned {ok}")
    t.sub("stops", fn(st) {
        st.fatal("stopped")
        st.error("never recorded")
    })
}

struct Case {
    input: str
    want: i64
}

fn fails_in_tables(t: *testing.T) {
    let cases = ["small": Case { input: "7", want: 7 }, "wrong": Case { input: "8", want: 9 }]
    t.table(cases, fn(st, c) {
        let got = parse(c.input) catch { e => st.unexpected(e, 0) }
        st.equal(got, c.want)
    })
}

fn passes(t: *testing.T) {
    t.equal(1, 1)
}

fn skipped(t: *testing.T) {
    t.skip("skipped on purpose")
}

fn hangs(t: *testing.T) {
    sleep(10000)
    t.log("never recorded")
}

fn deadlocks(t: *testing.T) {
    let never = chan[bool]()
    let value = <-never
    t.log("never recorded")
}

fn fails_golden(t: *testing.T) {
    let dir = "/tmp/std_testing_fail_golden"
    file.remove_all(dir) catch { _ => {} }
    t.golden_in(dir, "absent", "text", false)
    t.golden_in(dir, "changed", "one\ntwo\nthree\n", true)
    t.golden_in(dir, "changed", "one\n2\nthree\n", false)
    t.golden_in(dir, "changed", "one\ntwo\n", false)
    file.remove_all(dir) catch { e => t.error("cleanup failed: {testing.format(e)}") }
}

fn fails_property(t: *testing.T) {
    t.check_ints(200, 7, 0, 1000, fn(n) { n < 100 })
    t.check_ints(200, 7, -500, 500, fn(n) { n > -40 })
    t.check_property(100, 11, fn(mut r: rand.Rng) -> []i64 {
        var xs: []i64 = []
        for _ in 0..rand.below(mut r, 8) {
            push(mut xs, rand.between(mut r, 0, 9))
        }
        xs
    }, fn(xs) { xs.len < 5 })
}

fn main() {
    let tests = [
        testing.Test { name: "passes", run: passes }
        testing.Test { name: "fails_equal", run: fails_equal }
        testing.Test { name: "fails_truth", run: fails_truth }
        testing.Test { name: "fails_collections", run: fails_collections }
        testing.Test { name: "fails_errors", run: fails_errors }
        testing.Test { name: "stops_at_fatal", run: stops_at_fatal }
        testing.Test { name: "stops_at_require", run: stops_at_require }
        testing.Test { name: "stops_at_must", run: stops_at_must }
        testing.Test { name: "conditions", run: conditions }
        testing.Test { name: "fails_in_subtests", run: fails_in_subtests }
        testing.Test { name: "fails_in_tables", run: fails_in_tables }
        testing.Test { name: "skipped", run: skipped }
        testing.Test { name: "hangs", run: hangs }
        testing.Test { name: "deadlocks", run: deadlocks }
        testing.Test { name: "fails_golden", run: fails_golden }
        testing.Test { name: "fails_property", run: fails_property }
    ]
    let failed = testing.run_with(tests, testing.Settings { timing: false, timeout_ms: 400 })
    if failed > 0 {
        os.exit(1)
    }
}
