import std/io
import std/log
import std/os

fn new_lines() -> *[]str {
    let empty: []str = []
    new(empty)
}

fn new_records() -> *[]log.Record {
    let empty: []log.Record = []
    new(empty)
}

fn new_bytes() -> *[]u8 {
    let empty: []u8 = []
    new(empty)
}

fn collect(lines: *[]str) -> log.Logger {
    let base = log.Logger { level: Debug }
    base.with_lines(fn(line) { push(mut *lines, line) })
}

fn text_lines() {
    let lines = new_lines()
    let l = collect(lines).with_prefix("app")
    l.info("started")
    l.info_with("request", [
        log.str_attr("path", "/a b"),
        log.int_attr("status", 200),
        log.float_attr("ms", 1.5),
        log.bool_attr("cached", false),
    ])
    l.warn_with("quoting", [
        log.str_attr("empty", ""),
        log.str_attr("eq", "a=b"),
        log.str_attr("quote", "say \"hi\""),
        log.str_attr("tab", "a\tb"),
        log.str_attr("plain", "word"),
    ])
    let bound = l.with_attrs([log.str_attr("user", "ada")]).with_attrs([log.int_attr("id", 7)])
    bound.error_with("failed", [log.str_attr("why", "disk full")])
    bound.debug("bound only")
    log.emit(bound.with_prefix("db"), Warn, "nested")
    collect(lines).error("no prefix")
    for line in *lines {
        print(line)
    }
}

fn json_lines() {
    let lines = new_lines()
    let l = collect(lines).with_format(Json)
    l.info("plain")
    l.with_prefix("svc").with_prefix("api").warn_with("escapes", [
        log.str_attr("text", "line\nbreak \"quoted\" back\\slash\ttab"),
        log.str_attr("ctl", "a\0b"),
        log.int_attr("n", -42),
        log.float_attr("f", 2.5),
        log.float_attr("nan", 0.0 / 0.0),
        log.bool_attr("ok", true),
    ])
    l.with_attrs([log.str_attr("request", "r1")]).error("bound")
    for line in *lines {
        print(line)
    }
}

fn thresholds() {
    let lines = new_lines()
    let l = collect(lines).with_level(Warn)
    l.debug("no")
    l.info("no")
    l.warn("yes")
    l.error("yes")
    print((*lines).len)
    print(log.enabled(l, Info))
    print(log.enabled(l, Warn))
    let quiet = l.with_level(Error)
    quiet.warn("no")
    quiet.error("yes")
    print((*lines).len)
}

fn levels() {
    print(log.parse_level("debug") or Error == Debug)
    print(log.parse_level(" INFO ") or Error == Info)
    print(log.parse_level("Warning") or Error == Warn)
    print(log.parse_level("warn") or Error == Warn)
    print(log.parse_level("error") or Debug == Error)
    let bad = log.parse_level("loud") or Debug
    print(bad == Debug)
    let failed = log.parse_level("") or Error
    print(failed == Error)
}

fn environment() {
    print(log.level_from_env(Info) == Info)
    os.set_env("LOG_LEVEL", "debug") or {}
    print(log.level_from_env(Error) == Debug)
    os.set_env("LOG_LEVEL", "warn") or {}
    let lines = new_lines()
    let l = collect(lines).with_env_level()
    l.info("hidden")
    l.warn("shown")
    print((*lines).len)
    os.set_env("LOG_LEVEL", "nonsense") or {}
    print(log.level_from_env(Info) == Info)
    os.unset_env("LOG_LEVEL") or {}
}

fn timestamps() {
    let lines = new_lines()
    let l = collect(lines).with_clock(fn() -> i64 { 1700000000123456789 })
    l.info("off")
    let stamped = l.with_timestamps(true)
    stamped.info("on")
    stamped.with_format(Json).info("on")
    let whole = stamped.with_clock(fn() -> i64 { 1700000000000000000 })
    whole.info("whole")
    for line in *lines {
        print(line)
    }
}

fn handler() {
    let seen = new_records()
    let l = log.Logger {}.with_prefix("h").with_attrs([log.int_attr("a", 1)]).with_handler(fn(r) { push(mut *seen, r) })
    l.info_with("one", [log.bool_attr("b", true)])
    l.debug("filtered")
    l.error("two")
    for r in *seen {
        print("{r.message} {r.prefix} {r.attrs.len} {r.time == none}")
    }
}

fn stream_sink() {
    let sink = new_bytes()
    let stream = io.Stream {
        read: fn(buf) -> i64 ! io.Error { 0 }
        write: fn(data) -> i64 ! io.Error {
            io.append(mut *sink, data)
            data.len
        }
        close: fn() {}
    }
    let l = log.Logger {}.with_stream(stream).with_prefix("s")
    l.info_with("to stream", [log.int_attr("n", 3)])
    l.with_format(Json).warn("json")
    print(str(*sink))
}

fn descriptor() {
    let l = log.Logger { level: Info, sink: log.Sink.Fd(1), prefix: "fd" }
    l.info_with("to stdout", [log.str_attr("k", "v w")])
    l.with_format(Json).info("json stdout")
}

fn main() {
    text_lines()
    json_lines()
    thresholds()
    levels()
    environment()
    timestamps()
    handler()
    stream_sink()
    descriptor()
}
