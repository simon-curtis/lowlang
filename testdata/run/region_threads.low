struct Tally {
    id: i64
    words: []str
    sums: [str: i64]
}

fn work(id: i64, rounds: i64, out: chan[Tally]) {
    var last = Tally { id, words: [], sums: [:] }
    for r in 0..rounds {
        last = region {
            var words: []str = []
            var sums: [str: i64] = [:]
            for i in 0..50 {
                let w = "w{id}-{i % 7}"
                push(mut words, w)
                sums[w] += i + r
            }
            Tally { id, words, sums }
        }
        sleep(0)
    }
    out <- last
}

fn main() {
    let out = chan[Tally](32)
    for id in 0..24 {
        spawn work(id, 200, out)
    }
    var total = 0
    var seen = 0
    for n in 0..24 {
        let t = (<-out) ?? Tally { id: -1, words: [], sums: [:] }
        var sum = 0
        for k, v in t.sums {
            sum += v
        }
        total += sum + t.words.len + t.id
        seen += 1
    }
    print(seen)
    print(total)
}
