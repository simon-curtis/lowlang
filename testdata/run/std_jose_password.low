import std/crypto/hash
import std/crypto/password
import std/text

fn repeated(n: i64, b: u8) -> []u8 {
    var out: []u8 = []
    for i in 0..n {
        push(mut out, b)
    }
    out
}

fn counting(n: i64) -> []u8 {
    var out: []u8 = []
    for i in 0..n {
        push(mut out, u8(i))
    }
    out
}

fn blake2b() {
    print("blake2b empty {text.encode_hex(password.blake2b([], 64, []))}")
    print("blake2b abc {text.encode_hex(password.blake2b(bytes("abc"), 64, []))}")
    var big: []u8 = []
    for r in 0..3 {
        for b in counting(256) {
            push(mut big, b)
        }
    }
    print("blake2b keyed {text.encode_hex(password.blake2b(big, 32, repeated(64, 'k')))}")
    print("blake2b one block {text.encode_hex(password.blake2b(big[..128], 20, []))}")
    print("blake2b bad length {password.blake2b(big, 65, []).len} {password.blake2b(big, 0, []).len}")
}

fn pbkdf2() {
    print("pbkdf2 4096 {text.encode_hex(password.pbkdf2(hash.sha256(), bytes("password"), bytes("salt"), 4096, 32))}")
    print("pbkdf2 long {text.encode_hex(password.pbkdf2(hash.sha256(), repeated(100, 'p'), bytes("saltSALT"), 1000, 70))}")
}

fn argon2() {
    let rfc = password.argon2id_keyed(repeated(32, 1), repeated(16, 2), repeated(8, 3), repeated(12, 4), 3, 32, 4, 32)
    print("rfc9106 {text.encode_hex(rfc)}")
    let long = password.argon2id(bytes("long tag"), bytes("saltsaltsalt"), 1, 1000, 2, 100)
    print("openssl two lanes {text.encode_hex(long)}")
    print("bad parameters {password.argon2id(bytes("x"), bytes("short"), 1, 64, 1, 32).len}")
}

fn phc() {
    let openssl_default = "$argon2id$v=19$m=19456,t=2,p=1$c29tZXNhbHRzb21lc2FsdA$K13EBUiG7JV+9ZxztmHFTdb7J0WQsnj2V8bZaqyPptE"
    print("openssl default {password.verify("password", openssl_default)} wrong {password.verify("Password", openssl_default)}")
    let openssl_lanes = "$argon2id$v=19$m=256,t=3,p=4$AAECAwQFBgcICQoLDA0ODw$ZvlOJcWgQfSXM3eUY8N1yOS8VL8Eatmw"
    print("openssl four lanes {password.verify("correct horse", openssl_lanes)}")
    print("openssl empty password {password.verify("", "$argon2id$v=19$m=8,t=1,p=1$AAAAAAAAAAA$A7PU93ZyROamGkY1EqoNGw")}")
    let python_pbkdf2 = "$pbkdf2-sha256$i=2000$TmFDbC1zYWx0$30Yyt6ZFjSXVXZwJrCNF/nGLk8nG2cSBJwGQlcoKCeQ"
    print("python pbkdf2 {password.verify("hunter2", python_pbkdf2)} wrong {password.verify("hunter3", python_pbkdf2)}")
    print("python pbkdf2 short tag {password.verify("hunter2", "$pbkdf2-sha256$i=2000$TmFDbC1zYWx0$30Yyt6ZFjSXVXZwJrCNF/nGLk8k")}")

    let ours = password.hash("tr0ub4dor&3")
    print("hash prefix {text.starts_with(ours, "$argon2id$v=19$m=19456,t=2,p=1$")} length {ours.len}")
    print("hash verifies {password.verify("tr0ub4dor&3", ours)}")
    let ours_pbkdf2 = password.hash_pbkdf2("hunter2", 1000)
    print("pbkdf2 prefix {text.starts_with(ours_pbkdf2, "$pbkdf2-sha256$i=1000$")} length {ours_pbkdf2.len}")
    print("pbkdf2 verifies {password.verify("hunter2", ours_pbkdf2)} wrong {password.verify("hunter", ours_pbkdf2)}")
    print("pbkdf2 clamped {text.starts_with(password.hash_pbkdf2("x", 0), "$pbkdf2-sha256$i=1$")}")

    let rejected = [
        "",
        "$argon2id$v=19$m=1048577,t=1,p=1$AAAAAAAAAAA$A7PU93ZyROamGkY1EqoNGw",
        "$argon2id$v=19$m=8,t=101,p=1$AAAAAAAAAAA$A7PU93ZyROamGkY1EqoNGw",
        "$argon2id$v=19$m=8,t=1,p=0$AAAAAAAAAAA$A7PU93ZyROamGkY1EqoNGw",
        "$argon2id$v=19$m=8,t=1,p=2$AAAAAAAAAAA$A7PU93ZyROamGkY1EqoNGw",
        "$argon2id$v=16$m=8,t=1,p=1$AAAAAAAAAAA$A7PU93ZyROamGkY1EqoNGw",
        "$argon2id$m=8,t=1,p=1$AAAAAAAAAAA$A7PU93ZyROamGkY1EqoNGw",
        "$argon2i$v=19$m=8,t=1,p=1$AAAAAAAAAAA$A7PU93ZyROamGkY1EqoNGw",
        "$argon2id$v=19$t=1,m=8,p=1$AAAAAAAAAAA$A7PU93ZyROamGkY1EqoNGw",
        "$argon2id$v=19$m=8,t=1,p=1,k=2$AAAAAAAAAAA$A7PU93ZyROamGkY1EqoNGw",
        "$argon2id$v=19$m=8,t=-1,p=1$AAAAAAAAAAA$A7PU93ZyROamGkY1EqoNGw",
        "$argon2id$v=19$m=8,t=1,p=1$AAAAAAAAAAA=$A7PU93ZyROamGkY1EqoNGw",
        "$argon2id$v=19$m=8,t=1,p=1$AAAAAA$A7PU93ZyROamGkY1EqoNGw",
        "$argon2id$v=19$m=8,t=1,p=1$AAAAAAAAAAA$A7PU93ZyROamGkY1EqoNG",
        "$argon2id$v=19$m=8,t=1,p=1$AAAA*AAAAAA$A7PU93ZyROamGkY1EqoNGw",
        "$argon2id$v=19$m=8,t=1,p=1$AAAAAAAAAAA$A7PU93ZyROamGkY1EqoNGw$",
        "argon2id$v=19$m=8,t=1,p=1$AAAAAAAAAAA$A7PU93ZyROamGkY1EqoNGw",
    ]
    for i, encoded in rejected {
        print("rejected argon2id {i} {password.verify("", encoded)}")
    }
    let rejected_pbkdf2 = [
        "$pbkdf2-sha256$i=0$TmFDbC1zYWx0$30Yyt6ZFjSXVXZwJrCNF/nGLk8k",
        "$pbkdf2-sha256$i=10000001$TmFDbC1zYWx0$30Yyt6ZFjSXVXZwJrCNF/nGLk8k",
        "$pbkdf2-sha256$2000$TmFDbC1zYWx0$30Yyt6ZFjSXVXZwJrCNF/nGLk8k",
        "$pbkdf2-sha512$i=2000$TmFDbC1zYWx0$30Yyt6ZFjSXVXZwJrCNF/nGLk8k",
    ]
    for i, encoded in rejected_pbkdf2 {
        print("rejected pbkdf2 {i} {password.verify("hunter2", encoded)}")
    }
}

fn main() {
    blake2b()
    pbkdf2()
    argon2()
    phc()
}
