import std/acme
import std/base64
import std/crypto/x509
import std/http
import std/io
import std/text

fn directory_cases(rig: Rig, c: *acme.Client) ! io.Error {
    let d = c.directory
    show("directory resources", yes(text.ends_with(d.new_nonce, "/nonce") && text.ends_with(d.new_account, "/acct") && text.ends_with(d.new_order, "/order") && text.ends_with(d.revoke_cert, "/revoke") && text.ends_with(d.key_change, "/rollover")))
    show("directory meta", "tos={d.terms_of_service} website={d.website} caa={text.join(d.caa_identities, ",")} eab={d.external_account_required} profiles={text.join(d.profiles, ",")}")
    show("directory renewalInfo", "{d.renewal_info.len}")
    let client = http.client().with_roots(rig.roots).build()
    show("connect over http", connect_text(acme.Options { directory: "http://127.0.0.1:1/dir", http: client }))
    show("connect to a missing directory", connect_text(acme.Options { directory: "{rig.base}/missing", http: client }))
    show("connect to a closed port", connect_text(acme.Options { directory: "https://127.0.0.1:1/dir", http: client }))
}

fn connect_text(options: acme.Options) -> str {
    let c = acme.connect(options) catch { e => return acme.describe(e) }
    "connected to {c.directory.new_order.len}"
}

fn nonce_cases(rig: Rig, c: *acme.Client) ! io.Error {
    let key = x509.generate_private_key(x509.KeyType.P256)?
    let a = acme.new_account(c, key, acme.AccountRequest { terms_agreed: true }) catch {
        e => {
            show("nonce account", acme.describe(e))
            return
        }
    }
    let before = acme.rejected_nonces(c)
    let posts = rig.fake.posts
    rig.fake.rejections_left = 2
    let updated = acme.update_account(c, a, ["mailto:nonce@example.test"]) catch {
        e => {
            show("update after two badNonce", acme.describe(e))
            return
        }
    }
    show("update after two badNonce", "contacts={text.join(updated.contacts, ",")} rejected={acme.rejected_nonces(c) - before} posts={rig.fake.posts - posts}")
    let again = acme.rejected_nonces(c)
    let posts_again = rig.fake.posts
    rig.fake.rejections_left = 9
    let exhausted = refresh_text(c, a)
    show("refresh after more badNonce than retries", "{exhausted} rejected={acme.rejected_nonces(c) - again} posts={rig.fake.posts - posts_again}")
    rig.fake.rejections_left = 0
    let recovered = acme.refresh_account(c, a) catch {
        e => {
            show("refresh after recovery", acme.describe(e))
            return
        }
    }
    show("refresh after recovery", recovered.status)
}

fn account_cases(rig: Rig) ! io.Error {
    let c = client_for(rig)?
    directory_cases(rig, c)?
    nonce_cases(rig, c)?
    key_type_cases(rig, c)?
    account_flow(rig, c)?
    binding_cases(rig, c)?
    rollover_cases(rig, c)?
}

fn key_type_cases(rig: Rig, c: *acme.Client) ! io.Error {
    let kinds = [x509.KeyType.P256, x509.KeyType.P384, x509.KeyType.Ed25519]
    let names = ["P-256", "P-384", "Ed25519"]
    for i in 0..kinds.len {
        let key = x509.generate_private_key(kinds[i])?
        let a = acme.new_account(c, key, acme.AccountRequest { terms_agreed: true }) catch {
            e => {
                show("new account with {names[i]}", acme.describe(e))
                continue
            }
        }
        let found = acme.find_account(c, key) catch {
            e => {
                show("find account with {names[i]}", acme.describe(e))
                continue
            }
        }
        show("account with {names[i]}", "status={a.status} found={yes(found.url == a.url)}")
    }
    rsa_case(rig, c)?
}

fn rsa_case(rig: Rig, c: *acme.Client) ! io.Error {
    let key = x509.pem_private_key(embed("rsa_account.pem"))?
    let a = acme.new_account(c, key, acme.AccountRequest { terms_agreed: true }) catch {
        e => {
            show("account with RSA", acme.describe(e))
            return
        }
    }
    let found = acme.find_account(c, key) catch {
        e => {
            show("find account with RSA", acme.describe(e))
            return
        }
    }
    show("account with RSA", "status={a.status} found={yes(found.url == a.url)}")
    let issued = issue_one(rig, c, a, "rsa-account.example.test", x509.KeyType.P256) catch { e => fail Refused }
    show("order of an RSA account", leaf_text(issued.chain))
}

fn account_flow(rig: Rig, c: *acme.Client) ! io.Error {
    let key = x509.generate_private_key(x509.KeyType.P256)?
    show("new account without agreeing to the terms", new_text(c, key, acme.AccountRequest {}))
    show("find an unknown key", find_text(c, key))
    let a = acme.new_account(c, key, acme.AccountRequest { terms_agreed: true, contacts: ["mailto:admin@example.test", "mailto:ops@example.test"] }) catch {
        e => {
            show("new account", acme.describe(e))
            return
        }
    }
    show("new account", "status={a.status} contacts={text.join(a.contacts, ",")} url={yes(text.starts_with(a.url, "{rig.base}/acct/"))} orders={yes(text.starts_with(a.orders, "{rig.base}/orders/"))}")
    let same = acme.new_account(c, key, acme.AccountRequest { terms_agreed: true }) catch {
        e => {
            show("new account again", acme.describe(e))
            return
        }
    }
    show("new account again returns the account", yes(same.url == a.url))
    let found = acme.find_account(c, key) catch {
        e => {
            show("find account", acme.describe(e))
            return
        }
    }
    show("find account", "same={yes(found.url == a.url)} contacts={found.contacts.len}")
    let updated = acme.update_account(c, a, ["mailto:new@example.test"]) catch {
        e => {
            show("update account", acme.describe(e))
            return
        }
    }
    show("update account", text.join(updated.contacts, ","))
    let refreshed = acme.refresh_account(c, a) catch {
        e => {
            show("refresh account", acme.describe(e))
            return
        }
    }
    show("refresh account", text.join(refreshed.contacts, ","))
    let other = x509.generate_private_key(x509.KeyType.P256)?
    let stranger = acme.Account { url: a.url, key: other, status: a.status, contacts: [], orders: "" }
    show("refresh with another key", refresh_text(c, stranger))
    let off = acme.deactivate_account(c, a) catch {
        e => {
            show("deactivate", acme.describe(e))
            return
        }
    }
    show("deactivate", off.status)
    show("update after deactivation", update_text(c, a, ["mailto:late@example.test"]))
}

fn update_text(c: *acme.Client, a: acme.Account, contacts: str[]) -> str {
    let r = acme.update_account(c, a, contacts) catch { e => return acme.describe(e) }
    "status {r.status}"
}

fn refresh_text(c: *acme.Client, a: acme.Account) -> str {
    let r = acme.refresh_account(c, a) catch { e => return acme.describe(e) }
    "status {r.status}"
}

fn find_text(c: *acme.Client, key: x509.PrivateKey) -> str {
    let r = acme.find_account(c, key) catch { e => return acme.describe(e) }
    "status {r.status}"
}

fn new_text(c: *acme.Client, key: x509.PrivateKey, request: acme.AccountRequest) -> str {
    let r = acme.new_account(c, key, request) catch { e => return acme.describe(e) }
    "status {r.status}"
}

fn change_text(c: *acme.Client, a: acme.Account, key: x509.PrivateKey) -> str {
    let r = acme.change_key(c, a, key) catch { e => return acme.describe(e) }
    "status {r.status}"
}

fn binding_attempt(c: *acme.Client, label: str, binding: acme.Binding?) ! io.Error {
    let key = x509.generate_private_key(x509.KeyType.P256)?
    let a = acme.new_account(c, key, acme.AccountRequest { terms_agreed: true, binding }) catch {
        e => {
            show(label, acme.describe(e))
            return
        }
    }
    show(label, "status={a.status}")
}

fn binding_cases(rig: Rig, c: *acme.Client) ! io.Error {
    let secret = base64.decode_url("zWNDZM6eQGHWpSRTPal5eIUYFTu7EajVIoguysqZ9wG44nMEtx3MUAsUDkMTQ12W") or fail Malformed
    let other = base64.decode_url("b10lLJs8l1GPIzsLP0s6pMt8O0XVGnfTaCeROxQM0BIt2XrJMDHJZBM5NuQmQJQH") or fail Malformed
    rig.fake.eab_keys["kid-1"] = secret
    rig.fake.eab_keys["kid-2"] = other
    rig.fake.eab_required = true
    let strict = client_for(rig)?
    show("directory requires a binding", yes(strict.directory.external_account_required))
    binding_attempt(strict, "no binding", none)?
    binding_attempt(strict, "kid-1 with the key of kid-2", some(acme.Binding { key_id: "kid-1", mac_key: other }))?
    binding_attempt(strict, "unknown kid", some(acme.Binding { key_id: "kid-9", mac_key: secret }))?
    binding_attempt(strict, "kid-1 with its key", some(acme.Binding { key_id: "kid-1", mac_key: secret }))?
    binding_attempt(strict, "kid-2 with its key", some(acme.Binding { key_id: "kid-2", mac_key: other }))?
    rig.fake.eab_required = false
    show("bindings the server accepted", text.join(binding_log(rig.fake), ","))
}

fn binding_log(f: *Fake) -> str[] {
    var out: str[] = []
    for line in f.log {
        let at = text.index(line, "binding=")
        if at >= 0 && line[at + 8..].len > 0 {
            out.push(line[at + 8..])
        }
    }
    out
}

fn rollover_cases(rig: Rig, c: *acme.Client) ! io.Error {
    let old = x509.generate_private_key(x509.KeyType.P256)?
    let a = acme.new_account(c, old, acme.AccountRequest { terms_agreed: true, contacts: ["mailto:roll@example.test"] }) catch {
        e => {
            show("rollover account", acme.describe(e))
            return
        }
    }
    let fresh = x509.generate_private_key(x509.KeyType.Ed25519)?
    let rolled = acme.change_key(c, a, fresh) catch {
        e => {
            show("change key", acme.describe(e))
            return
        }
    }
    show("change key", "same url={yes(rolled.url == a.url)} contacts={text.join(rolled.contacts, ",")}")
    show("old key after rollover", find_text(c, old))
    let found = acme.find_account(c, fresh) catch {
        e => {
            show("new key after rollover", acme.describe(e))
            return
        }
    }
    show("new key after rollover", yes(found.url == a.url))
    show("old account key signing", refresh_text(c, a))
    let taken = x509.generate_private_key(x509.KeyType.P384)?
    let b = acme.new_account(c, taken, acme.AccountRequest { terms_agreed: true }) catch {
        e => {
            show("second account", acme.describe(e))
            return
        }
    }
    show("change to a key in use", change_text(c, b, fresh))
}
