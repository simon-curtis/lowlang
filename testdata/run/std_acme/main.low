import std/acme
import std/crypto/x509
import std/http
import std/io
import std/net
import std/time/clock
import std/time/duration
import std/time/timestamp
import std/tls

struct Rig {
    fake: *Fake
    clk: clock.Manual
    challenges: acme.Challenges
    solvers: acme.Solvers
    roots: x509.Certificate[]
    base: str
}

fn app(req: http.Request) -> http.Response {
    http.response(200, "app")
}

fn serve_acme(l: net.ListenerHandle, config: tls.Config, f: *Fake) {
    http.serve_tls_on(l, config, fn(req: http.Request) -> http.Response { handle_request(f, req) }) or {}
}

fn serve_challenges(l: net.ListenerHandle, responses: acme.Challenges) {
    acme.serve_http01(l, responses) or {}
}

fn serve_alpn(l: net.ListenerHandle, config: tls.Config) {
    http.serve_tls_on(l, config, app) or {}
}

fn empty_source() -> tls.CredentialSource {
    tls.CredentialSource { choose: fn(info: tls.HelloInfo) -> tls.Credentials { tls.Credentials {} } }
}

fn server_credentials() -> tls.Config ! io.Error {
    let ca_key = x509.generate_private_key(x509.KeyType.P256)?
    let ca_der = ca_certificate("Fixture Server CA", ca_key)?
    let ca = x509.parse(ca_der)?
    let key = x509.generate_private_key(x509.KeyType.P256)?
    let template = x509.Template {
        serial: [2], subject: "acme fake", not_before: 1767225600, not_after: 4102444800, dns_names: ["localhost"], ip_addresses: [[127, 0, 0, 1]],
    }
    let public = x509.public_key_info(key)?
    let leaf = x509.create_certificate(template, public, ca_key, ca.subject)?
    tls.Config { certificates: [leaf], key: some(key), roots: [ca] }
}

fn start(acme_l: net.ListenerHandle, web: net.ListenerHandle, alpn: net.ListenerHandle) -> Rig ! io.Error {
    let secure = server_credentials()?
    let plain = http.client().build()
    let started = timestamp.from_unix(1900000000) or fail Invalid
    let clk = clock.manual(started)
    let f = fake(plain, clock.clock(clk))?
    f.base = "https://127.0.0.1:{acme_l.addr.port}"
    f.http_port = web.addr.port
    f.tls_port = alpn.addr.port
    spawn serve_acme(acme_l, secure, f)
    let responses = acme.challenges()
    spawn serve_challenges(web, responses)
    let source = acme.tls_alpn_source(responses, empty_source())
    spawn serve_alpn(alpn, tls.Config { credentials: some(source) })
    let solvers = acme.Solvers { challenges: some(responses), dns: some(dns_records(f)) }
    Rig { fake: f, clk, challenges: responses, solvers, roots: secure.roots, base: f.base }
}

fn dns_records(f: *Fake) -> acme.DnsRecords {
    acme.DnsRecords {
        publish: fn(name: str, value: str) ! io.Error {
            f.records[name] = value
        },
        remove: fn(name: str, value: str) ! io.Error {
            f.records.delete(name)
        },
    }
}

fn connect_client(rig: Rig) -> *acme.Client ! acme.Error {
    let http_client = http.client().with_roots(rig.roots).build()
    let options = acme.Options { directory: "{rig.base}/dir", http: http_client, clock: clock.clock(rig.clk) }
    acme.connect(options)?
}

fn client_for(rig: Rig) -> *acme.Client ! io.Error {
    connect_client(rig) catch { _ => fail Refused }
}

fn show(label: str, value: str) {
    print("{label}: {value}")
}

fn yes(ok: bool) -> str {
    if ok { "yes" } else { "NO" }
}

fn run() ! io.Error {
    using acme_l = net.listen("127.0.0.1", 0)?
    using web = net.listen("127.0.0.1", 0)?
    using alpn = net.listen("127.0.0.1", 0)?
    let rig = start(acme_l.handle, web.handle, alpn.handle)?
    account_cases(rig)?
    order_cases(rig)?
}

fn order_cases(rig: Rig) ! io.Error {
    let c = client_for(rig)?
    let a = fresh_account(c)?
    method_cases(rig, c, a)
    name_cases(rig, c, a)
    polling_cases(rig, c, a)
    failure_cases(rig, c, a)
    flow_cases(rig, c, a)?
    refusal_cases(rig, c, a)
    csr_cases(rig)?
    solver_cases(rig, c, a)?
    cancel_cases(rig, c)?
    revocation_cases(rig, c, a)?
    renewal_cases(rig, c, a)?
    helper_cases(rig)?
    scheduled_cases(rig, c)?
    lookup_cases(rig, c)?
    ari_cases(rig)?
    forced_cases(rig)?
    manager_failure_cases(rig, c)?
    reload_cases(rig, c)?
    failing_cases(rig, c)?
    directory_store_cases(rig, c)?
    serving_cases(rig, c)?
}

fn main() {
    run() or print("failed")
}
