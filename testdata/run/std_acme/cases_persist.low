import std/acme
import std/crypto/x509
import std/io
import std/text

struct Published {
    calls: i64
}

fn persistent(rig: Rig, published: *Published) -> acme.PersistentDns {
    acme.PersistentDns {
        publish: fn(name: str, value: str) ! io.Error {
            published.calls += 1
            rig.fake.records[name] = value
        },
    }
}

fn forget_records(rig: Rig) {
    let empty: [str: str] = [:]
    rig.fake.records = empty
}

fn only_persistent(solver: acme.PersistentDns) -> acme.Solvers {
    acme.Solvers { persistent: some(solver), methods: ["dns-persist-01"] }
}

fn record_at(rig: Rig, domain: str) -> str {
    let value = text.replace(rig.fake.records[acme.dns_persist_name(domain)] ?? "none", rig.base, "<server>")
    let hashed = text.cut(value, "sha-256/")
    if !hashed.found {
        return value
    }
    "{hashed.before}sha-256/<{hashed.after.len} bytes>"
}

fn value_text(r: acme.PersistRecord) -> str {
    acme.dns_persist_value(r) catch { e => acme.describe(e) }
}

fn hash_text(domain: str, key: x509.PrivateKey) -> str {
    acme.account_hash_uri("https://ca.example/account-hash/", domain, key, "https://ca.example/acct/123") catch { e => acme.describe(e) }
}

fn lengths_text(value: str) -> str {
    var parts: str[] = []
    for piece in acme.dns_persist_strings(value) {
        parts.push("{piece.len}")
    }
    text.join(parts, " ")
}

fn parsed_text(value: str) -> str {
    let r = acme.parse_dns_persist(value) catch { e => return acme.describe(e) }
    let until = match r.persist_until {
        some(limit) => "{limit}"
        none => "none"
    }
    "issuer={r.issuer} accounturi={r.account_uri} wildcard={r.wildcard} until={until}"
}

fn persist_helper_cases() ! io.Error {
    expect("dns-persist-01 name", acme.dns_persist_name("www.example.org"), "_validation-persist.www.example.org")
    expect("dns-persist-01 name of a wildcard", acme.dns_persist_name("*.example.org"), "_validation-persist.example.org")
    expect("dns-persist-01 name in upper case with a dot", acme.dns_persist_name("WWW.Example.ORG."), "_validation-persist.www.example.org")
    let key = fixed_key()?
    expect("account hash", hash_text("Example.ORG.", key), "https://ca.example/account-hash/sha-256/l_AtCLjVWhBrcm2legnZITnvJV25Se3aYzLzaXNiMbY")
    expect("account hash of any domain", hash_text("*", key), "https://ca.example/account-hash/sha-256/OO8Xf9EQzljEQDvFtpCf5K5DL6BKzSwAFbheIAi_0jU")
    show("account hash of no domain", hash_text("", key))
    let uri = "https://ca.example/acct/123"
    expect("record", value_text(acme.PersistRecord { issuer: "authority.example", account_uri: uri }), "authority.example; accounturi=https://ca.example/acct/123")
    expect("record with a policy", value_text(acme.PersistRecord { issuer: "authority.example", account_uri: uri, wildcard: true }), "authority.example; accounturi=https://ca.example/acct/123; policy=wildcard")
    expect("record with a limit", value_text(acme.PersistRecord { issuer: "authority.example", account_uri: uri, persist_until: some(1721952000) }), "authority.example; accounturi=https://ca.example/acct/123; persistUntil=1721952000")
    expect("record with both", value_text(acme.PersistRecord { issuer: "authority.example", account_uri: uri, wildcard: true, persist_until: some(1721952000) }), "authority.example; accounturi=https://ca.example/acct/123; policy=wildcard; persistUntil=1721952000")
    show("record with an upper case issuer", value_text(acme.PersistRecord { issuer: "Authority.example", account_uri: uri }))
    show("record with a semicolon in the account", value_text(acme.PersistRecord { issuer: "authority.example", account_uri: "{uri};policy=wildcard" }))
    show("record with a negative limit", value_text(acme.PersistRecord { issuer: "authority.example", account_uri: uri, persist_until: some(-1) }))
    show("strings of 255, 256 and 600 bytes", "{lengths_text(text.repeat("a", 255))} | {lengths_text(text.repeat("a", 256))} | {lengths_text(text.repeat("a", 600))}")
}

fn persist_parse_cases() {
    show("parse", parsed_text("letsencrypt.org; accounturi=https://acme-v02.api.letsencrypt.org/acme/acct/1234567890"))
    show("parse with a policy and a limit", parsed_text("letsencrypt.org; accounturi=https://ca.example/acct/1; policy=wildcard; persistUntil=1767225600"))
    show("parse without spaces, in mixed case", parsed_text("authority.example;AccountURI=https://ca.example/acct/1;POLICY=Wildcard;PERSISTUNTIL=0"))
    show("parse with spaces, tabs and a last semicolon", parsed_text(" authority.example ;\taccounturi = https://ca.example/acct/1 ; "))
    show("parse with an unknown parameter and policy", parsed_text("authority.example; future=1; accounturi=https://ca.example/acct/1; policy=other"))
    show("parse of an empty record", parsed_text(""))
    show("parse without an issuer", parsed_text("; accounturi=https://ca.example/acct/1"))
    show("parse without an account", parsed_text("authority.example; policy=wildcard"))
    show("parse with two accounts", parsed_text("authority.example; accounturi=https://ca.example/acct/1; ACCOUNTURI=https://ca.example/acct/2"))
    show("parse with a parameter that has no value sign", parsed_text("authority.example; accounturi=https://ca.example/acct/1; wildcard"))
    show("parse with a space in a value", parsed_text("authority.example; accounturi=https://ca.example/acct/1 2"))
    show("parse with a signed limit", parsed_text("authority.example; accounturi=https://ca.example/acct/1; persistUntil=+5"))
    show("parse with a limit of 2^63", parsed_text("authority.example; accounturi=https://ca.example/acct/1; persistUntil=9223372036854775808"))
}

fn offered_text(c: *acme.Client, a: acme.Account) -> str {
    let request = acme.OrderRequest { identifiers: identifiers_of(["offer.example.test"]) }
    let order = acme.new_order(c, a, request) catch { e => return acme.describe(e) }
    let authz = acme.get_authorization(c, a, order.authorizations[0]) catch { e => return acme.describe(e) }
    for ch in authz.challenges {
        if ch.kind == "dns-persist-01" {
            return "issuers=[{text.join(ch.issuers, ",")}] token={ch.token.len} bytes"
        }
    }
    "not offered"
}

fn persist_flow_cases(rig: Rig, c: *acme.Client, a: acme.Account, form: str) {
    let published = new(Published { calls: 0 })
    let solver = persistent(rig, published)
    show("{form}: challenge", offered_text(c, a))
    let from = rig.fake.log.len
    show("{form}: obtain with dns-persist-01", obtain_with(c, a, ["persist.example.test"], only_persistent(solver)))
    show("  server log", log_since(rig.fake, from))
    show("  record", record_at(rig, "persist.example.test"))
    show("{form}: obtain again", obtain_with(c, a, ["persist.example.test"], only_persistent(solver)))
    show("  records, publish calls", "{rig.fake.records.len}, {published.calls}")
    let stranger = fresh_account(c) catch { _ => a }
    let silent = acme.PersistentDns { publish: fn(name: str, value: str) ! io.Error {} }
    show("{form}: obtain with the record of another account", obtain_with(c, stranger, ["persist.example.test"], only_persistent(silent)))
    forget_records(rig)
}

fn persist_policy_cases(rig: Rig, c: *acme.Client, a: acme.Account) {
    let published = new(Published { calls: 0 })
    let plain = persistent(rig, published)
    let names = ["*.pw.example.test", "pw.example.test"]
    show("wildcard without the policy", obtain_with(c, a, names, only_persistent(plain)))
    var from = rig.fake.log.len
    let mixed = acme.Solvers { dns: rig.solvers.dns, persistent: some(plain) }
    show("wildcard without the policy and a dns-01 solver", obtain_with(c, a, names, mixed))
    show("  server log", log_since(rig.fake, from))
    forget_records(rig)
    var wide = persistent(rig, published)
    wide.wildcard = true
    wide.persist_until = some(4000000000)
    from = rig.fake.log.len
    show("wildcard with the policy and a limit", obtain_with(c, a, names, only_persistent(wide)))
    show("  server log", log_since(rig.fake, from))
    show("  record", record_at(rig, "pw.example.test"))
    show("  records", "{rig.fake.records.len}")
    forget_records(rig)
    var expired = persistent(rig, published)
    expired.persist_until = some(1)
    show("an IP address", obtain_with(c, a, ["127.0.0.1"], only_persistent(plain)))
    show("  records", "{rig.fake.records.len}")
    show("a limit in the past", obtain_with(c, a, ["late.example.test"], only_persistent(expired)))
    show("  records", "{rig.fake.records.len}")
}

fn persist_issuer_cases(rig: Rig, c: *acme.Client, a: acme.Account) {
    let published = new(Published { calls: 0 })
    var second = persistent(rig, published)
    second.issuer = "other.example.test"
    show("the second issuer", obtain_with(c, a, ["issuer.example.test"], only_persistent(second)))
    show("  record", record_at(rig, "issuer.example.test"))
    var absent = persistent(rig, published)
    absent.issuer = "absent.example.test"
    show("an issuer the server does not offer", obtain_with(c, a, ["issuer.example.test"], only_persistent(absent)))
    let offered = rig.fake.issuers
    rig.fake.issuers = []
    show("a challenge without issuers", obtain_with(c, a, ["issuer.example.test"], only_persistent(second)))
    for n in 0..11 {
        rig.fake.issuers.push("ca{n}.example.test")
    }
    show("a challenge with 11 issuers", obtain_with(c, a, ["issuer.example.test"], only_persistent(second)))
    rig.fake.issuers = offered
    let failing = acme.PersistentDns { publish: fn(name: str, value: str) ! io.Error { fail Refused } }
    show("a failing publish function", obtain_with(c, a, ["issuer.example.test"], only_persistent(failing)))
    forget_records(rig)
}

fn persist_cases(rig: Rig) ! io.Error {
    persist_helper_cases()?
    persist_parse_cases()
    rig.fake.issuers = ["ca.example.test", "other.example.test"]
    rig.fake.persist_field = "issuer-domain-names"
    let c = client_for(rig)?
    let a = fresh_account(c)?
    show("directory without a hash prefix", "prefix={c.directory.account_hash_prefix.len} bytes issuers=[{text.join(c.directory.issuer_domain_names, ",")}]")
    persist_flow_cases(rig, c, a, "account URL")
    persist_policy_cases(rig, c, a)
    persist_issuer_cases(rig, c, a)
    rig.fake.persist_field = "issuerDomainNames"
    rig.fake.hash_prefix = "{rig.base}/account-hash/"
    let hashing = client_for(rig)?
    let b = fresh_account(hashing)?
    show("directory with a hash prefix", "prefix={text.replace(hashing.directory.account_hash_prefix, rig.base, "<server>")} issuers=[{text.join(hashing.directory.issuer_domain_names, ",")}]")
    persist_flow_cases(rig, hashing, b, "account hash")
    rig.fake.persist_field = ""
    rig.fake.hash_prefix = ""
}
