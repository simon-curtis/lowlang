fn scale(v: f64, k: i64) -> f64 {
    v * f64(k) + 0.5
}

fn mixed(n: i64) -> f64 {
    var i = 0
    var x = 0.5
    var count = 0
    var y = 1.0
    for i < n {
        x = x * 1.5 + f64(i)
        if x > 100.0 {
            x = x - 100.0
            count += 1
        }
        y = y + x * 0.25
        i += 1
    }
    x + y + f64(count)
}

fn with_calls(n: i64) -> f64 {
    var acc = 1.0
    var steps = 0
    var weight = 2
    for i in 0..n {
        acc = scale(acc, weight) - f64(steps)
        steps += i
        weight = (weight * 3 + 1) % 5 + 1
        if acc > 1000.0 {
            acc = acc / 7.0
        }
    }
    acc + f64(steps)
}

fn narrow(n: i64) -> f32 {
    var a: f32 = 1.5
    var k: i32 = 3
    var b: f32 = 0.25
    var m: u8 = 200
    for i in 0..n {
        a = a * 1.25 + b
        b = b + f32(k)
        k = k * 3 % 17 + 1
        m = m + 77
        if a > 500.0 {
            a = a - 499.0
        }
    }
    a + b + f32(k) + f32(m)
}

fn alternate(n: i64) -> f64 {
    var total = 0.0
    var flip = 1
    var i = 0
    for i < n {
        let term = f64(flip) / f64(2 * i + 1)
        total = total + term
        flip = 0 - flip
        i += 1
    }
    total * 4.0
}

fn main() {
    print(mixed(0))
    print(mixed(1))
    print(mixed(10))
    print(mixed(200))
    print(with_calls(0))
    print(with_calls(5))
    print(with_calls(300))
    print(narrow(0))
    print(narrow(7))
    print(narrow(100))
    print(alternate(1))
    print(alternate(1000))
}
