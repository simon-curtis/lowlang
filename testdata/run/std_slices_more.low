import std/slices
import std/text

struct Item {
    key: i64
    order: i64
}

fn show(xs: []i64) -> str {
    text.join(slices.map(xs, fn(x: i64) -> str { "{x}" }), ",")
}

fn show_all(xss: [][]i64) -> str {
    text.join(slices.map(xss, fn(xs: []i64) -> str { "[{show(xs)}]" }), " ")
}

fn stable_sorts() {
    var items: []Item = []
    var seed = 7
    for i in 0..3000 {
        seed = (seed * 1103515245 + 12345) % 2147483648
        push(mut items, Item { key: seed % 50, order: i })
    }
    var merged = slices.clone(items)
    merged |> slices.sort_stable_by(fn(a: Item, b: Item) -> bool { a.key < b.key })
    var ok = true
    for i in 1..merged.len {
        let prev = merged[i - 1]
        let cur = merged[i]
        if cur.key < prev.key || (cur.key == prev.key && cur.order < prev.order) {
            ok = false
        }
    }
    print("stable_by {ok} {merged.len}")

    var keyed = slices.clone(items)
    keyed |> slices.sort_by_key(fn(it: Item) -> i64 { it.key })
    var same = true
    for i, it in keyed {
        if it.key != merged[i].key || it.order != merged[i].order {
            same = false
        }
    }
    print("by_key matches {same}")

    var plain: []i64 = []
    for it in items {
        push(mut plain, it.key * 10000 + (it.order * 7919) % 10000)
    }
    var a = slices.clone(plain)
    var b = slices.clone(plain)
    a |> slices.sort_stable()
    b |> slices.sort()
    print("stable equals unstable {slices.equal(a, b)} {slices.sorted(a)}")

    var words = ["bb", "a", "ccc", "dd", "e", "fff"]
    words |> slices.sort_by_key(fn(w: str) -> i64 { w.len })
    print(text.join(words, " "))
    var tiny: []i64 = [3]
    tiny |> slices.sort_stable()
    var none_left: []i64 = []
    none_left |> slices.sort_stable()
    print("{tiny[0]} {none_left.len}")
}

fn searching() {
    let xs = [1, 3, 3, 5, 8, 13]
    print("{slices.binary_search(xs, 8) ?? -1} {slices.binary_search(xs, 4) ?? -1} {slices.binary_search(xs, 0) ?? -1} {slices.binary_search(xs, 99) ?? -1}")
    print("{slices.lower_bound(xs, 3)} {slices.lower_bound(xs, 4)} {slices.lower_bound(xs, 100)} {slices.lower_bound(xs, -5)}")
    let by = slices.binary_search_by(xs, fn(x: i64) -> i64 { x - 5 })
    print(by ?? -1)
    let missing = slices.binary_search_by(xs, fn(x: i64) -> i64 { x - 6 })
    print(missing ?? -1)
    let strs = ["ant", "bee", "cat", "dog"]
    print(slices.binary_search(strs, "cat") ?? -1)
    print(slices.find(xs, fn(x: i64) -> bool { x > 3 }) ?? -1)
    print(slices.find_index(xs, fn(x: i64) -> bool { x > 3 }) ?? -1)
    print(slices.find_index(xs, fn(x: i64) -> bool { x > 100 }) ?? -1)
    print(slices.count(xs, fn(x: i64) -> bool { x % 2 == 1 }))
    print("{slices.first(xs) ?? -1} {slices.last(xs) ?? -1}")
    let empty: []i64 = []
    print("{slices.first(empty) ?? -1} {slices.last(empty) ?? -1}")
}

fn comparing() {
    print("{slices.equal([1, 2], [1, 2])} {slices.equal([1, 2], [1, 3])} {slices.equal([1], [1, 2])}")
    print("{slices.compare([1, 2], [1, 3])} {slices.compare([1, 3], [1, 2])} {slices.compare([1, 2], [1, 2])} {slices.compare([1], [1, 2])} {slices.compare([1, 2], [1])}")
    print("{slices.compare(["a", "b"], ["a", "c"])}")
    print("{slices.starts_with([1, 2, 3], [1, 2])} {slices.starts_with([1, 2, 3], [2])} {slices.starts_with([1], [1, 2])}")
    print("{slices.ends_with([1, 2, 3], [2, 3])} {slices.ends_with([1, 2, 3], [2])} {slices.ends_with([3], [1, 3])}")
}

fn shaping() {
    print(show(slices.unique([1, 1, 2, 2, 2, 3, 1, 1])))
    print(show_all(slices.chunks([1, 2, 3, 4, 5, 6, 7], 3)))
    print(show_all(slices.windows([1, 2, 3, 4], 2)))
    print(slices.windows([1, 2], 3).len)
    print(show(slices.take([1, 2, 3, 4], 2)))
    print(show(slices.take([1, 2, 3, 4], 10)))
    print(show(slices.take([1, 2, 3, 4], -1)))
    print(show(slices.skip([1, 2, 3, 4], 3)))
    print(show(slices.skip([1, 2, 3, 4], 9)))
    print(show(slices.skip([1, 2, 3, 4], 0)))
    let parts = slices.partition([1, 2, 3, 4, 5, 6], fn(x: i64) -> bool { x % 2 == 0 })
    print("{show(parts.first)} | {show(parts.second)}")
    print(show(slices.flat_map([1, 2, 3], fn(x: i64) -> []i64 { slices.repeat([x], x) })))
    print(show(slices.flatten([[1], [], [2, 3]])))
    print(show(slices.repeat([1, 2], 3)))
    print(slices.repeat([1, 2], 0).len)
    let pairs = slices.zip([1, 2, 3], ["a", "b"])
    print(pairs.len)
    for p in pairs {
        print("{p.first}{p.second}")
    }
    print(slices.reduce([4, 9, 2], fn(a: i64, b: i64) -> i64 { if a > b { a } else { b } }) ?? -1)
    let empty: []i64 = []
    print(slices.reduce(empty, fn(a: i64, b: i64) -> i64 { a + b }) ?? -1)
}

fn editing() {
    var xs = [1, 2, 3, 4, 5]
    xs |> slices.rotate(2)
    print(show(xs))
    xs |> slices.rotate(-2)
    print(show(xs))
    xs |> slices.rotate(7)
    print(show(xs))
    xs |> slices.rotate(5)
    print(show(xs))
    xs |> slices.swap(0, 4)
    print(show(xs))
    xs |> slices.fill(9)
    print(show(xs))

    var ys = [10, 20, 30]
    ys |> slices.insert(0, 5)
    ys |> slices.insert(2, 15)
    ys |> slices.insert(5, 35)
    print(show(ys))
    let removed = ys |> slices.remove(1)
    print("{removed} {show(ys)}")
    let tail = ys |> slices.remove(ys.len - 1)
    print("{tail} {show(ys)}")
    let head = ys |> slices.remove(0)
    print("{head} {show(ys)}")
    push(mut ys, 99)
    print(show(ys))
    var empty: []i64 = []
    empty |> slices.insert(0, 1)
    print(show(empty))
}

fn main() {
    stable_sorts()
    searching()
    comparing()
    shaping()
    editing()
}
