import std/base64
import std/crypto/zk/kzg
import std/text

struct Counts {
    pass: i64
    bad: i64
}

struct Blobs {
    names: []str
    data: [][]u8
}

fn record(counts: *Counts, ok: bool, label: str) {
    if ok {
        counts.pass += 1
    } else {
        counts.bad += 1
        print("FAIL {label}")
    }
}

fn unhex(s: str) -> []u8 {
    text.decode_hex(s) catch { _ => return [] }
}

fn zeros(n: i64) -> []u8 {
    var out: []u8 = []
    for _ in 0..n {
        push(mut out, 0)
    }
    out
}

fn build_blob(fields: []str) -> []u8 {
    let kind = fields[1]
    if kind == "base64" {
        return base64.decode(fields[2]) catch { _ => return [] }
    }
    if kind == "fill" {
        let value = unhex(fields[2])[0]
        var out: []u8 = []
        for _ in 0..kzg.bytes_per_blob() {
            push(mut out, value)
        }
        return out
    }
    if kind == "repeat" {
        let element = unhex(fields[2])
        var out: []u8 = []
        for _ in 0..kzg.field_elements_per_blob() {
            for b in element {
                push(mut out, b)
            }
        }
        return out
    }
    let out = zeros(kzg.bytes_per_blob())
    let index = text.parse_int(fields[2]) catch { _ => return [] }
    let element = unhex(fields[3])
    for k in 0..32 {
        out[index * 32 + k] = element[k]
    }
    out
}

fn load_blobs(contents: str) -> Blobs {
    var names: []str = []
    var data: [][]u8 = []
    for line in text.lines(contents) {
        let fields = text.fields(line)
        if fields.len < 2 {
            continue
        }
        push(mut names, fields[0])
        push(mut data, build_blob(fields))
    }
    Blobs { names, data }
}

fn lookup(blobs: Blobs, name: str) -> []u8 {
    for i in 0..blobs.names.len {
        if blobs.names[i] == name {
            return blobs.data[i]
        }
    }
    []
}

fn hex_list(s: str) -> [][]u8 {
    var out: [][]u8 = []
    if s == "-" {
        return out
    }
    for part in text.split(s, ',') {
        push(mut out, unhex(part))
    }
    out
}

fn blob_list(blobs: Blobs, s: str) -> [][]u8 {
    var out: [][]u8 = []
    if s == "-" {
        return out
    }
    for part in text.split(s, ',') {
        push(mut out, lookup(blobs, part))
    }
    out
}

fn commit_outcome(s: kzg.BlobSetup, blob: []u8) -> str {
    let commitment = kzg.blob_to_commitment(s, blob) catch { _ => return "error" }
    text.encode_hex(commitment)
}

fn proof_outcome(s: kzg.BlobSetup, blob: []u8, z: []u8) -> str {
    let opening = kzg.compute_proof(s, blob, z) catch { _ => return "error" }
    "{text.encode_hex(opening.proof)} {text.encode_hex(opening.value)}"
}

fn blob_proof_outcome(s: kzg.BlobSetup, blob: []u8, commitment: []u8) -> str {
    let proof = kzg.compute_blob_proof(s, blob, commitment) catch { _ => return "error" }
    text.encode_hex(proof)
}

fn verify_outcome(s: kzg.BlobSetup, commitment: []u8, z: []u8, y: []u8, proof: []u8) -> str {
    let ok = kzg.verify_proof(s, commitment, z, y, proof) catch { _ => return "error" }
    "{ok}"
}

fn verify_blob_outcome(s: kzg.BlobSetup, blob: []u8, commitment: []u8, proof: []u8) -> str {
    let ok = kzg.verify_blob_proof(s, blob, commitment, proof) catch { _ => return "error" }
    "{ok}"
}

fn batch_outcome(s: kzg.BlobSetup, blobs: [][]u8, commitments: [][]u8, proofs: [][]u8) -> str {
    let ok = kzg.verify_blob_proof_batch(s, blobs, commitments, proofs) catch { _ => return "error" }
    "{ok}"
}

fn vectors(counts: *Counts, s: kzg.BlobSetup, blobs: Blobs, contents: str) {
    var number = 0
    for line in text.lines(contents) {
        let f = text.fields(line)
        if f.len == 0 {
            continue
        }
        number += 1
        let label = "{f[0]} line {number}"
        if f[0] == "commit" {
            record(counts, commit_outcome(s, lookup(blobs, f[1])) == f[2], label)
        } else if f[0] == "proof" {
            let want = if f[3] == "error" { "error" } else { "{f[3]} {f[4]}" }
            record(counts, proof_outcome(s, lookup(blobs, f[1]), unhex(f[2])) == want, label)
        } else if f[0] == "blobproof" {
            record(counts, blob_proof_outcome(s, lookup(blobs, f[1]), unhex(f[2])) == f[3], label)
        } else if f[0] == "verify" {
            record(counts, verify_outcome(s, unhex(f[1]), unhex(f[2]), unhex(f[3]), unhex(f[4])) == f[5], label)
        } else if f[0] == "verifyblob" {
            record(counts, verify_blob_outcome(s, lookup(blobs, f[1]), unhex(f[2]), unhex(f[3])) == f[4], label)
        } else if f[0] == "batch" {
            record(counts, batch_outcome(s, blob_list(blobs, f[1]), hex_list(f[2]), hex_list(f[3])) == f[4], label)
        }
    }
}

fn setup_outcome(contents: str) -> str {
    let s = kzg.blob_setup_from_text(contents) catch { e => return error_name(e) }
    "ok"
}

fn error_name(e: kzg.Error) -> str {
    match e {
        Truncated => "Truncated"
        Magic => "Magic"
        Unsupported => "Unsupported"
        Malformed => "Malformed"
        Size => "Size"
        Length => "Length"
        Point(p) => "Point"
    }
}

fn replaced_line(contents: str, index: i64, replacement: str) -> str {
    var out: []str = []
    let lines = text.lines(contents)
    for i in 0..lines.len {
        push(mut out, if i == index { replacement } else { lines[i] })
    }
    text.join(out, "\n")
}

fn infinity_setup(g2_first: str, g2_second: str) -> str {
    var out: []str = ["4096", "65"]
    let infinity = "c0{text.repeat("00", 47)}"
    for _ in 0..4096 {
        push(mut out, infinity)
    }
    push(mut out, g2_first)
    push(mut out, g2_second)
    for _ in 0..63 {
        push(mut out, g2_second)
    }
    text.join(out, "\n")
}

fn setup_rejections(counts: *Counts, contents: str) {
    let lines = text.lines(contents)
    let flagged = "c0{text.repeat("00", 46)}01"
    record(counts, setup_outcome("") == "Truncated", "empty setup")
    record(counts, setup_outcome("4096\n65\n") == "Truncated", "no points")
    record(counts, setup_outcome("4095\n65\n") == "Malformed", "short count")
    record(counts, setup_outcome("x\n65\n") == "Malformed", "bad count")
    record(counts, setup_outcome(replaced_line(contents, 2, "zz")) == "Malformed", "bad hex")
    record(counts, setup_outcome(replaced_line(contents, 2, "00")) == "Size", "short line")
    record(counts, setup_outcome(replaced_line(contents, 2, flagged)) == "Point", "infinity with a coordinate")
    record(counts, setup_outcome(replaced_line(contents, 2, lines[4098])) == "Size", "G2 line among the G1 points")
    record(counts, setup_outcome(infinity_setup(lines[4099], lines[4099])) == "Malformed", "first G2 point is not the generator")
    record(counts, setup_outcome(infinity_setup(lines[4098], lines[4099])) == "ok", "G1 infinity points and the generator")
}

fn main() {
    let counts = new(Counts { pass: 0, bad: 0 })
    let contents = embed("std_zk_kzg_setup.txt")
    let s = kzg.blob_setup_from_text(contents) or {
        print("setup failed")
        return
    }
    let blobs = load_blobs(embed("std_zk_kzg_blobs.txt"))
    vectors(counts, s, blobs, embed("std_zk_kzg_eip4844.txt"))
    setup_rejections(counts, contents)
    print("pass {counts.pass} bad {counts.bad}")
}
