struct Pair {
    name: str
    count: i64
}

fn drain(mut xs: []i64) -> i64 {
    var total = 0
    for {
        let v = pop(mut xs) ?? break
        total += v
    }
    total
}

fn main() {
    var xs = [1, 2, 3, 4, 5]
    print(pop(mut xs) ?? -1)
    print(xs.len)
    xs.truncate(2)
    print(xs.len)
    push(mut xs, 40)
    print(xs[2])
    print(drain(mut xs))
    print(xs.len)
    print(pop(mut xs) ?? -1)

    var names: []str = ["a", "bb", "ccc"]
    print(names.pop() ?? "none")
    print(names.pop() ?? "none")
    names.push("dd")
    print(names[1])
    print(names.len)

    var pairs = [Pair { name: "x", count: 1 }, Pair { name: "y", count: 2 }]
    let last = pairs.pop()
    match last {
        none => print("empty")
        some(p) => print("{p.name} {p.count}")
    }
    print(pairs.len)

    var bytes: []u8 = []
    print(bytes.pop() ?? 255)
    push(mut bytes, 7)
    push(mut bytes, 8)
    print(bytes.pop() ?? 0)
    bytes.truncate(0)
    print(bytes.len)

    var stack: []i64 = []
    for i in 0..1000 {
        push(mut stack, i)
        if i % 3 == 0 {
            stack.truncate(stack.len - 1)
        }
    }
    print(stack.len)

    var shared = [10, 20, 30, 40]
    let alias = shared
    shared.truncate(3)
    push(mut shared, 99)
    print(alias[3])

    var resliced = [10, 20, 30, 40]
    let alias2 = resliced
    resliced = resliced[..3]
    push(mut resliced, 99)
    print(alias2[3])
}
