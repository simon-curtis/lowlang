fn fib(n: i64) -> i64 {
    if n < 2 {
        return n
    }
    fib(n - 1) + fib(n - 2)
}

fn reply(requests: chan[i64], replies: chan[i64]) {
    for r in requests {
        replies <- r * 2
    }
    close(replies)
}

fn main() {
    let requests = chan[i64]()
    let replies = chan[i64](1)
    spawn reply(requests, replies)
    var total = 0
    for r in 0..300 {
        requests <- r
        var answer: i64? = none
        for answer == none {
            fib(10)
            answer = select {
                v = <-replies => v
                else => none
            }
        }
        total += answer ?? 0
    }
    close(requests)
    print("total {total}")
}
