struct Trace {
    log: []i64
}

fn probe(mut t: Trace, id: i64, value: bool) -> bool {
    push(mut t.log, id)
    value
}

fn render(t: Trace) -> str {
    var out = ""
    for id in t.log {
        out = "{out}{id}"
    }
    out
}

fn fresh() -> Trace {
    Trace { log: [] }
}

fn not_branch(x: i64) -> i64 {
    if !(x > 3) { 1 } else { 2 }
}

fn not_not_branch(x: i64) -> i64 {
    if !!(x > 3) { 1 } else { 2 }
}

fn not_equal(x: i64, y: i64) -> i64 {
    if !(x == y) { 1 } else { 2 }
}

fn not_unsigned(x: u32, y: u32) -> i64 {
    if !(x < y) { 1 } else { 2 }
}

fn not_float(x: f64, y: f64) -> i64 {
    if !(x < y) { 1 } else { 2 }
}

fn not_float_equal(x: f64, y: f64) -> i64 {
    if !(x == y) { 1 } else { 2 }
}

fn not_value(x: i64, y: i64) -> bool {
    !(x < y)
}

fn not_flag(b: bool) -> i64 {
    if !b { 1 } else { 2 }
}

fn both(mut t: Trace, a: bool, b: bool) -> i64 {
    if probe(mut t, 1, a) && probe(mut t, 2, b) { 1 } else { 0 }
}

fn either(mut t: Trace, a: bool, b: bool) -> i64 {
    if probe(mut t, 1, a) || probe(mut t, 2, b) { 1 } else { 0 }
}

fn chain_and(mut t: Trace, a: bool, b: bool, c: bool) -> i64 {
    if probe(mut t, 1, a) && probe(mut t, 2, b) && probe(mut t, 3, c) { 1 } else { 0 }
}

fn chain_or(mut t: Trace, a: bool, b: bool, c: bool) -> i64 {
    if probe(mut t, 1, a) || probe(mut t, 2, b) || probe(mut t, 3, c) { 1 } else { 0 }
}

fn mixed(mut t: Trace, a: bool, b: bool, c: bool) -> i64 {
    if probe(mut t, 1, a) && (probe(mut t, 2, b) || probe(mut t, 3, c)) { 1 } else { 0 }
}

fn mixed_right(mut t: Trace, a: bool, b: bool, c: bool) -> i64 {
    if probe(mut t, 1, a) || (probe(mut t, 2, b) && probe(mut t, 3, c)) { 1 } else { 0 }
}

fn negated_and(mut t: Trace, a: bool, b: bool) -> i64 {
    if !(probe(mut t, 1, a) && probe(mut t, 2, b)) { 1 } else { 0 }
}

fn negated_or(mut t: Trace, a: bool, b: bool) -> i64 {
    if !(probe(mut t, 1, a) || probe(mut t, 2, b)) { 1 } else { 0 }
}

fn negated_operand(mut t: Trace, a: bool, b: bool) -> i64 {
    if !probe(mut t, 1, a) && !probe(mut t, 2, b) { 1 } else { 0 }
}

fn as_value(mut t: Trace, a: bool, b: bool) -> bool {
    probe(mut t, 1, a) && probe(mut t, 2, b)
}

fn as_value_or(mut t: Trace, a: bool, b: bool) -> bool {
    probe(mut t, 1, a) || probe(mut t, 2, b)
}

fn stored(mut t: Trace, a: bool, b: bool) -> i64 {
    let both = probe(mut t, 1, a) && probe(mut t, 2, b)
    let other = probe(mut t, 3, b) || probe(mut t, 4, a)
    if both { 10 } else { 0 } + if other { 1 } else { 0 }
}

fn compare_chain(x: i64, lo: i64, hi: i64) -> i64 {
    if x >= lo && x < hi { 1 } else { 0 }
}

fn compare_either(x: i64, lo: i64, hi: i64) -> i64 {
    if x < lo || x >= hi { 1 } else { 0 }
}

fn compare_not_chain(x: i64, lo: i64, hi: i64) -> i64 {
    if !(x < lo || x >= hi) { 1 } else { 0 }
}

fn guarded_divide(a: i64, b: i64) -> i64 {
    if b != 0 && a / b > 2 { 1 } else { 0 }
}

fn guarded_index(xs: []i64, i: i64) -> i64 {
    if i < xs.len && xs[i] > 10 { 1 } else { 0 }
}

fn guarded_index_or(xs: []i64, i: i64) -> i64 {
    if i >= xs.len || xs[i] > 10 { 1 } else { 0 }
}

fn loop_flags(n: i64) -> i64 {
    var hits = 0
    for i in 0..n {
        let even = i % 2 == 0
        let big = i > 5
        if !even && !big { hits += 1 }
        if even && big { hits += 10 }
        if !(even || big) { hits += 100 }
        if even != big { hits += 1000 }
    }
    hits
}

fn while_not(n: i64) -> i64 {
    var i = 0
    var steps = 0
    for !(i >= n) {
        i += 3
        steps += 1
    }
    steps
}

fn show(name: str, t: Trace, result: i64) {
    print("{name} {result} {render(t)}")
}

fn main() {
    for x in [2, 3, 4] {
        print("{not_branch(x)} {not_not_branch(x)} {not_equal(x, 3)} {not_value(x, 3)}")
    }
    print("{not_unsigned(1, 2)} {not_unsigned(2, 2)} {not_unsigned(4000000000, 5)}")
    let nan = sqrt(-1.0)
    print("{not_float(1.0, 2.0)} {not_float(2.0, 1.0)} {not_float(nan, 1.0)} {not_float(1.0, nan)}")
    print("{not_float_equal(1.0, 1.0)} {not_float_equal(1.0, 2.0)} {not_float_equal(nan, nan)}")
    print("{not_flag(true)} {not_flag(false)}")

    for a in [false, true] {
        for b in [false, true] {
            var t1 = fresh()
            let rt1 = both(mut t1, a, b)
            show("and {a} {b}", t1, rt1)
            var t2 = fresh()
            let rt2 = either(mut t2, a, b)
            show("or {a} {b}", t2, rt2)
            var t3 = fresh()
            let rt3 = negated_and(mut t3, a, b)
            show("nand {a} {b}", t3, rt3)
            var t4 = fresh()
            let rt4 = negated_or(mut t4, a, b)
            show("nor {a} {b}", t4, rt4)
            var t5 = fresh()
            let rt5 = negated_operand(mut t5, a, b)
            show("notops {a} {b}", t5, rt5)
            var t6 = fresh()
            let v6 = as_value(mut t6, a, b)
            show("value-and {a} {b} {v6}", t6, 0)
            var t7 = fresh()
            let v7 = as_value_or(mut t7, a, b)
            show("value-or {a} {b} {v7}", t7, 0)
            var t8 = fresh()
            let rt8 = stored(mut t8, a, b)
            show("stored {a} {b}", t8, rt8)
        }
    }

    for a in [false, true] {
        for b in [false, true] {
            for c in [false, true] {
                var t1 = fresh()
                let rt1 = chain_and(mut t1, a, b, c)
                show("and3 {a} {b} {c}", t1, rt1)
                var t2 = fresh()
                let rt2 = chain_or(mut t2, a, b, c)
                show("or3 {a} {b} {c}", t2, rt2)
                var t3 = fresh()
                let rt3 = mixed(mut t3, a, b, c)
                show("mixed {a} {b} {c}", t3, rt3)
                var t4 = fresh()
                let rt4 = mixed_right(mut t4, a, b, c)
                show("mixedr {a} {b} {c}", t4, rt4)
            }
        }
    }

    for x in [-1, 0, 5, 9, 10, 11] {
        print("{x} {compare_chain(x, 0, 10)} {compare_either(x, 0, 10)} {compare_not_chain(x, 0, 10)}")
    }
    print("{guarded_divide(9, 0)} {guarded_divide(9, 3)} {guarded_divide(6, 3)}")
    let xs = [5, 20, 30]
    print("{guarded_index(xs, 1)} {guarded_index(xs, 0)} {guarded_index(xs, 3)} {guarded_index(xs, 99)}")
    print("{guarded_index_or(xs, 1)} {guarded_index_or(xs, 0)} {guarded_index_or(xs, 3)} {guarded_index_or(xs, 99)}")
    print(loop_flags(12))
    print("{while_not(0)} {while_not(1)} {while_not(9)} {while_not(10)}")
}
