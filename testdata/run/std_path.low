import std/path

fn globs() {
    let cases = [
        ["*.flac", "song.flac"],
        ["*.flac", "dir/song.flac"],
        ["*/*.flac", "dir/song.flac"],
        ["song.?lac", "song.flac"],
        ["[a-c]*", "beta"],
        ["[!a-c]*", "beta"],
        ["[]x]", "]"],
        ["a\\*b", "a*b"],
        ["a*b*c", "aXbYbZc"],
        ["a*b*c", "aXbYbZ"],
        ["", ""],
        ["*", ""],
    ]
    for c in cases {
        print("{c[0]} ~ {c[1]}: {path.matches(c[0], c[1])}")
    }
}

fn main() {
    globs()
}
