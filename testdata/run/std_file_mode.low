import std/file
import std/io
import std/os
import std/text
import std/time

fn permissions(path: str) -> str {
    let info = file.stat(path) or return "missing"
    text.radix(info.mode & 0o777, 8)
}

fn run(dir: str) ! io.Error {
    let state = "{dir}/state/nested"
    file.mkdir_all_mode(state, 0o700)?
    print("dir {permissions(state)} {permissions("{dir}/state")}")

    let accounts = "{state}/accounts.json"
    let temp = "{accounts}.tmp"
    file.write_text_mode(temp, "[]", 0o600)?
    file.rename(temp, accounts)?
    print("file {permissions(accounts)} {file.read_text(accounts)?}")

    file.chmod(accounts, 0o640)?
    print("chmod {permissions(accounts)}")

    let plain = "{dir}/plain.txt"
    file.write_text(plain, "x")?
    print("default {permissions(plain)}")

    file.mkdir_mode("{dir}/private", 0o711)?
    print("mkdir {permissions("{dir}/private")}")
}

fn main() {
    print("{0o755} {0o7_7}")
    let dir = "/tmp/low-std-file-mode-{os.pid()}"
    file.mkdir(dir) or print("cannot make {dir}")
    run(dir) or print("failed")
    file.remove_all(dir) or print("cannot remove {dir}")
    let nanos = time.now_nanos()
    let millis = time.now_millis()
    print(nanos / 1000000000 >= time.now() - 1 && millis / 1000 >= time.now() - 1)
    print(nanos % 1000000000 != 0 || time.now_nanos() % 1000000000 != 0)
}
