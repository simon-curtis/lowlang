struct Item {
    n: i64
}

struct Box[T] {
    items: []T
    ok: bool
}

fn check[T](xs: []T, test: fn([]T) -> bool) -> bool {
    test(xs)
}

fn take[T](sink: fn([]T) -> bool) -> *Box[T] {
    let items: []T = []
    new(Box[T] { items: items, ok: sink(items) })
}

fn main() {
    let empty = fn(xs: []*Item) -> bool { xs.len == 0 }
    print(take[*Item](empty).ok)
    print(check([1, 2], fn(xs: []i64) -> bool { xs.len == 2 }))
}
