struct Big {
    a: i64
    b: i64
    c: i64
    d: i64
}

fn many(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64, i: i64) -> i64 {
    a * 1 + b * 2 + c * 3 + d * 4 + e * 5 + f * 6 + g * 7 + h * 8 + i * 9
}

fn swapped(a: i64, b: i64, n: i64) -> i64 {
    if n == 0 {
        return a * 10 + b
    }
    swapped(b, a, n - 1)
}

fn pass(b: Big, k: i64) -> Big {
    Big { a: b.d + k, b: b.c + k, c: b.b + k, d: b.a + k }
}

fn pressure(n: i64) -> i64 {
    let v1 = n + 1
    let v2 = n + 2
    let v3 = n + 3
    let v4 = n + 4
    let v5 = n + 5
    let v6 = n + 6
    let v7 = n + 7
    let v8 = n + 8
    let v9 = n + 9
    let v10 = n + 10
    let v11 = n + 11
    let v12 = n + 12
    let v13 = n + 13
    let v14 = n + 14
    let v15 = n + 15
    let v16 = n + 16
    let v17 = n + 17
    let v18 = n + 18
    let v19 = n + 19
    let v20 = n + 20
    let s = many(v1, v2, v3, v4, v5, v6, v7, v8, v9)
    s + v10 + v11 + v12 + v13 + v14 + v15 + v16 + v17 + v18 + v19 + v20 + v1 + v2
}

fn fibLoop(n: i64) -> i64 {
    var a = 0
    var b = 1
    var i = 0
    for i < n {
        let t = a + b
        a = b
        b = t
        i += 1
    }
    a
}

fn rotate(n: i64) -> i64 {
    var x = 1
    var y = 2
    var z = 3
    var i = 0
    for i < n {
        let t = x
        x = y
        y = z
        z = t
        i += 1
    }
    x * 100 + y * 10 + z
}

fn main() {
    print(many(1, 2, 3, 4, 5, 6, 7, 8, 9))
    print(swapped(1, 2, 5))
    let b = pass(pass(Big { a: 1, b: 2, c: 3, d: 4 }, 10), 100)
    print(b.a)
    print(b.d)
    print(pressure(1))
    print(fibLoop(50))
    print(rotate(4))
}
