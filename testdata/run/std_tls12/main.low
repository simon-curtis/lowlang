import std/crypto/x509
import std/io
import std/net
import std/text
import std/tls

enum Outcome {
    Done(t: *tls.SessionHandle)
    Failed(why: str)
}

fn outcome(attempt: fn() -> *tls.SessionHandle ! io.Error) -> Outcome {
    let t = attempt() catch {
        Invalid => return Failed("invalid")
        Unsupported => return Failed("unsupported")
        Malformed => return Failed("malformed")
        Refused => return Failed("refused")
        Eof => return Failed("eof")
        _ => return Failed("other")
    }
    Done(t)
}

fn certificates(pem: str) -> []x509.Certificate {
    var out: []x509.Certificate = []
    for der in x509.pem_certificates(pem) {
        push(mut out, x509.parse(der) catch {
            _ => return out
        })
    }
    out
}

fn describe(t: *tls.SessionHandle) -> str {
    "{text.hex(t.version)} {text.hex(t.cipher_suite)} {text.hex(t.group)} alpn={t.protocol}"
}

fn serve(l: net.ListenerHandle, config: tls.Config, done: chan[str]) {
    let h = net.accept_handle(l) catch {
        _ => {
            done <- "accept failed"
            return
        }
    }
    using c = net.adopt(h)
    let wire = net.stream(c)
    let view = match outcome(fn() -> *tls.SessionHandle ! io.Error { tls.server_handle(wire, config) }) {
        Done(t) => t
        Failed(why) => {
            done <- "server failed ({why})"
            return
        }
    }
    using session = tls.Session { handle: view }
    let s = tls.stream(session)
    let r = io.reader(s)
    let line = io.read_line(r) catch "?"
    let body = io.read_exact(r, 100000) catch []
    var total = 0
    for b in body {
        total += i64(b)
    }
    io.write_str(s, "{line} {body.len} {total}\n") catch {
        _ => {}
    }
    tls.close(session)
    done <- "server {describe(view)}"
}

fn exchange(pem: str, server: tls.Config, client: tls.Config) -> str ! io.Error {
    var config = server
    config.certificates = x509.pem_certificates(pem)
    config.key = x509.pem_private_key(pem)?
    using l = net.listen("127.0.0.1", 0)?
    let done = chan[str](1)
    spawn serve(l.handle, config, done)
    using conn = net.connect(l.handle.addr)?
    let wire = net.stream(conn)
    let view = match outcome(fn() -> *tls.SessionHandle ! io.Error { tls.client_handle(wire, client) }) {
        Done(found) => found
        Failed(why) => {
            net.close(conn)
            let said = (<-done) ?? ""
            net.close_listener(l)
            return "client failed ({why}), {said}"
        }
    }
    using t = tls.Session { handle: view }
    let s = tls.stream(t)
    var payload: []u8 = []
    for i in 0..100000 {
        push(mut payload, u8(i % 251))
    }
    io.write_str(s, "hello\n")?
    io.write_all(s, payload)?
    let reply = io.read_line(io.reader(s))?
    var rekey = "ok"
    tls.update_keys(t, false) catch {
        Unsupported => {
            rekey = "unsupported"
        }
        _ => {
            rekey = "failed"
        }
    }
    tls.close(t)
    net.close_listener(l)
    let said = (<-done) ?? ""
    "client {describe(view)} [{reply}] update_keys={rekey}, {said}"
}

fn main() ! io.Error {
    let p256 = embed("p256.pem")
    let p384 = embed("p384.pem")
    let rsa = embed("rsa.pem")
    let trusted = certificates(embed("ca.pem"))
    let only12 = tls.Config { server_name: "localhost", roots: trusted, max_version: tls.tls12() }
    print("suites")
    for code in [0xC02B, 0xC02C, 0xCCA9] {
        var client = only12
        client.cipher_suites = [code]
        print("  p256 {exchange(p256, tls.Config {}, client)?}")
        print("  p384 {exchange(p384, tls.Config {}, client)?}")
    }
    for code in [0xC02F, 0xC030, 0xCCA8] {
        var client = only12
        client.cipher_suites = [code]
        print("  rsa {exchange(rsa, tls.Config {}, client)?}")
    }
    print("  rsa, server preference: {exchange(rsa, tls.Config {}, only12)?}")
    print("  rsa key, ecdsa suites only: {exchange(rsa, tls.Config { cipher_suites: [0xC02B, 0xC02C] }, only12)?}")
    print("groups")
    let group_lists: [][]i64 = [[0x001D, 0x0017], [0x0017], [0x0018, 0x0017]]
    for g in group_lists {
        var client = only12
        client.groups = g
        print("  p256 {exchange(p256, tls.Config {}, client)?}")
    }
    var p384_only = only12
    p384_only.groups = [0x0018]
    print("  p384 {exchange(p384, tls.Config {}, p384_only)?}")
    var p256_only = only12
    p256_only.groups = [0x0017]
    print("  p384 certificate curve not offered: {exchange(p384, tls.Config {}, p256_only)?}")
    var x25519_only = only12
    x25519_only.groups = [0x001D]
    print("  p256 certificate curve not offered: {exchange(p256, tls.Config {}, x25519_only)?}")
    print("alpn")
    var alpn = only12
    alpn.alpn = ["h2", "http/1.1"]
    print("  {exchange(p256, tls.Config { alpn: ["http/1.1"] }, alpn)?}")
    print("  {exchange(p256, tls.Config { alpn: ["h3"] }, alpn)?}")
    print("versions")
    let both = tls.Config { server_name: "localhost", roots: trusted }
    print("  both default: {exchange(p256, tls.Config {}, both)?}")
    print("  1.2 client, default server: {exchange(p256, tls.Config {}, only12)?}")
    print("  default client, 1.2 server: {exchange(p256, tls.Config { max_version: tls.tls12() }, both)?}")
    var only13 = both
    only13.min_version = tls.tls13()
    print("  1.3 client, 1.2 server: {exchange(p256, tls.Config { max_version: tls.tls12() }, only13)?}")
    print("  1.2 client, 1.3 server: {exchange(p256, tls.Config { min_version: tls.tls13() }, only12)?}")
    var inverted = only13
    inverted.max_version = tls.tls12()
    print("  inverted range: {exchange(p256, tls.Config {}, inverted)?}")
    print("verification")
    var wrong_name = only12
    wrong_name.server_name = "example.com"
    print("  wrong name: {exchange(p256, tls.Config {}, wrong_name)?}")
    var untrusted = only12
    untrusted.roots = certificates(embed("../std_tls_ca.pem"))
    print("  untrusted root: {exchange(p256, tls.Config {}, untrusted)?}")
}
