struct Cell {
    count: i64
    scale: f64
    tag: u8
}

fn store_between(xs: []i64, i: i64) -> i64 {
    let before = xs[i]
    xs[i] = 1000
    before + 1
}

fn store_between_sum(xs: []i64, i: i64) -> i64 {
    let before = xs[i]
    xs[i] = before * 7
    let after = xs[i]
    before + after
}

fn store_other_index(xs: []i64, i: i64, j: i64) -> i64 {
    let before = xs[i]
    xs[j] = 5
    before - 1
}

fn store_float_between(xs: []f64, i: i64) -> f64 {
    let before = xs[i]
    xs[i] = 100.0
    before + 0.5
}

fn store_float_other(xs: []f64, i: i64, j: i64) -> f64 {
    let before = xs[i]
    xs[j] = 100.0
    before * 3.0
}

fn compare_after_store(xs: []i64, i: i64) -> i64 {
    let before = xs[i]
    xs[i] = before + 10
    if xs[i] > before { 1 } else { 0 }
}

fn bump(xs: []i64, i: i64) -> i64 {
    xs[i] += 100
    xs[i]
}

fn call_between(xs: []i64, i: i64) -> i64 {
    let before = xs[i]
    let changed = bump(xs, i)
    before + changed
}

fn call_between_float(xs: []f64, ys: []i64, i: i64) -> f64 {
    let before = xs[i]
    let changed = bump(ys, i)
    before + f64(changed)
}

fn grow(xs: []i64) -> i64 {
    var ys = xs
    push(mut ys, 77)
    ys[0] = 31
    ys.len
}

fn call_between_alias(xs: []i64) -> i64 {
    let before = xs[0]
    let n = grow(xs)
    before + xs[0] + n
}

fn narrow_into_wide(xs: []u8, ys: []i64, i: i64) -> i64 {
    ys[i] + i64(xs[i])
}

fn narrow_compare(xs: []u8, limit: i64, i: i64) -> bool {
    i64(xs[i]) < limit
}

fn narrow_signed(xs: []i32, limit: i64, i: i64) -> bool {
    i64(xs[i]) > limit
}

fn narrow_u32_wide(xs: []u32, ys: []i64, i: i64) -> i64 {
    ys[i] - i64(xs[i])
}

fn float_into_arith(xs: []f64, i: i64) -> f64 {
    xs[i] * xs[i + 1] - xs[i + 2] / xs[i + 3] + xs[i]
}

fn float32_into_arith(xs: []f32, i: i64) -> f32 {
    xs[i] * xs[i + 1] - xs[i + 2] / xs[i + 3] + xs[i]
}

fn float_compare(xs: []f64, ys: []f64, i: i64) -> i64 {
    var n = 0
    if xs[i] < ys[i] { n += 1 }
    if xs[i] > ys[i] { n += 2 }
    if xs[i] == ys[i] { n += 4 }
    if xs[i] != ys[i] { n += 8 }
    n
}

fn float_compare_const(xs: []f64, i: i64) -> i64 {
    var n = 0
    if xs[i] < 1.5 { n += 1 }
    if 1.5 < xs[i] { n += 2 }
    if xs[i] == 1.5 { n += 4 }
    n
}

fn field_mix(cells: []Cell, i: i64) -> f64 {
    f64(cells[i].count) * cells[i].scale + f64(cells[i].tag)
}

fn field_store_between(cells: []Cell, i: i64) -> i64 {
    let before = cells[i].count
    cells[i].count = before * 2
    cells[i].count + before
}

fn memory_operands(xs: []i64, i: i64) -> i64 {
    let a = xs[i] + 1
    let b = xs[i] - 2
    let c = xs[i] & 0xff
    let d = xs[i] | 0x100
    let e = xs[i] ^ 0x55
    let f = xs[i] * 3
    a + b + c + d + e + f
}

fn same_load_twice(xs: []i64, i: i64) -> i64 {
    xs[i] + xs[i]
}

fn shared_load(xs: []i64, i: i64) -> i64 {
    let v = xs[i]
    v + v * v
}

fn float_cells(n: i64) -> []f64 {
    var xs: []f64 = []
    for i in 0..n {
        push(mut xs, f64(i) * 0.5 + 0.25)
    }
    xs
}

fn ints(n: i64) -> []i64 {
    var xs: []i64 = []
    for i in 0..n {
        push(mut xs, i * 13 + 5)
    }
    xs
}

fn main() {
    var xs = ints(16)
    print(store_between(xs, 3))
    print(xs[3])
    print(store_between_sum(xs, 4))
    print(xs[4])
    print(store_other_index(xs, 5, 5))
    print(xs[5])
    print(store_other_index(xs, 6, 7))
    print(xs[6])
    print(xs[7])
    print(compare_after_store(xs, 8))
    print(xs[8])

    var fs = float_cells(16)
    print(store_float_between(fs, 2))
    print(fs[2])
    print(store_float_other(fs, 3, 3))
    print(fs[3])
    print(store_float_other(fs, 4, 5))
    print(fs[5])

    var ys = ints(16)
    print(call_between(ys, 2))
    print(ys[2])
    print(call_between_float(fs, ys, 6))
    print(ys[6])
    print(call_between_alias(ys))
    print(ys[0])

    let bytes: []u8 = [200, 100, 255, 0]
    let wide: []i64 = [1000, 2000, 3000, 4000]
    print(narrow_into_wide(bytes, wide, 0))
    print(narrow_into_wide(bytes, wide, 2))
    print(narrow_compare(bytes, 150, 0))
    print(narrow_compare(bytes, 150, 1))
    print(narrow_compare(bytes, 256, 2))
    print(narrow_compare(bytes, 0, 3))
    let signed: []i32 = [-5, 5, -2147483648, 2147483647]
    print(narrow_signed(signed, -6, 0))
    print(narrow_signed(signed, 0, 0))
    print(narrow_signed(signed, 4, 1))
    print(narrow_signed(signed, -2147483649, 2))
    print(narrow_signed(signed, 2147483646, 3))
    let unsigned: []u32 = [4000000000, 7, 0, 4294967295]
    print(narrow_u32_wide(unsigned, wide, 0))
    print(narrow_u32_wide(unsigned, wide, 3))

    let reals = float_cells(8)
    print(float_into_arith(reals, 0))
    print(float_into_arith(reals, 3))
    let small: []f32 = [1.5, 2.5, 3.5, 0.5, 4.25, 8.0]
    print(float32_into_arith(small, 0))
    print(float32_into_arith(small, 2))
    let left: []f64 = [1.0, 2.0, sqrt(-1.0), 2.0]
    let right: []f64 = [2.0, 1.0, 1.0, 2.0]
    print(float_compare(left, right, 0))
    print(float_compare(left, right, 1))
    print(float_compare(left, right, 2))
    print(float_compare(left, right, 3))
    print(float_compare_const(left, 0))
    print(float_compare_const(left, 1))
    print(float_compare_const(left, 2))
    print(float_compare_const([1.5], 0))

    var cells: []Cell = []
    for i in 0..5 {
        push(mut cells, Cell { count: i * 4, scale: f64(i) + 0.5, tag: u8(i * 60) })
    }
    print(field_mix(cells, 3))
    print(field_mix(cells, 4))
    print(field_store_between(cells, 2))
    print(cells[2].count)

    print(memory_operands(xs, 9))
    print(memory_operands(xs, 10))
    print(same_load_twice(xs, 11))
    print(shared_load(xs, 12))
}
