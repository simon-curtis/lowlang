fn fib(n: i64) -> i64 {
    if n < 2 { n } else { fib(n - 1) + fib(n - 2) }
}

fn classify(n: i64) -> str {
    if n % 15 == 0 {
        "FizzBuzz"
    } else if n % 3 == 0 {
        "Fizz"
    } else if n % 5 == 0 {
        "Buzz"
    } else {
        "number"
    }
}

fn main() {
    print(fib(30))

    var i = 1
    for i <= 15 {
        let label = classify(i)
        if label == "number" { print(i) } else { print(label) }
        i += 1
    }

    var sum = 0
    for {
        sum += 7
        if sum > 100 { break }
    }
    print(sum)
    print(sum > 100 && !false)
    print(-9223372036854775807 - 1)
}
