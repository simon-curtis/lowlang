import std/html
import std/text

fn element(name: str, id: str) -> *html.Node {
    let e = html.create_element(html.Namespace.Html, name, [])
    if id != "" {
        html.set_attr(e, "id", id)
    }
    e
}

fn try_insert(parent: *html.Node, child: *html.Node, reference: *html.Node?) -> str {
    html.insert_before(parent, child, reference) catch {
        HierarchyRequest => return "HierarchyRequest"
        NotFound => return "NotFound"
    }
    "ok"
}

fn try_append(parent: *html.Node, child: *html.Node) -> str {
    try_insert(parent, child, none)
}

fn parent_state(n: *html.Node) -> str {
    if html.parent(n) == none { "none" } else { "set" }
}

fn name_or_none(n: *html.Node?) -> str {
    let node = n ?? return "none"
    html.local_name(node)
}

fn main() {
    let root = element("div", "r")
    let a = element("p", "a")
    let b = element("p", "b")
    let s = element("span", "s")
    let content = html.create_text("text")
    html.append_child(s, content) or return
    html.append_child(a, s) or return
    html.append_child(root, a) or return
    html.append_child(root, b) or return
    print("built: {html.outer_html(root)}")

    print("append self: {try_append(a, a)}")
    print("append ancestor into descendant: {try_append(s, root)}")
    print("append parent into child: {try_append(s, a)}")
    print("reference not a child: {try_insert(root, element("i", ""), s)}")
    print("append into text: {try_append(content, element("i", ""))}")
    print("append document: {try_append(root, html.create_document())}")
    print("unchanged: {html.outer_html(root)}")

    html.append_child(b, s) or return
    print("moved: {html.outer_html(root)}")
    let em = element("em", "")
    html.insert_before(root, em, a) or return
    print("inserted before: {html.outer_html(root)}")
    html.insert_before(root, element("u", ""), none) or return
    print("inserted last: {html.outer_html(root)}")
    html.insert_before(root, s, em) or return
    print("moved before: {html.outer_html(root)}")
    html.remove(b)
    print("removed: {html.outer_html(root)} parent {parent_state(b)}")

    let shallow = html.clone(a, false)
    let deep = html.clone(root, true)
    print("shallow: {html.outer_html(shallow)} children {html.children(shallow).len}")
    print("deep: {html.outer_html(deep)} parent {parent_state(deep)}")
    let first = html.first_child(deep) ?? return
    html.set_attr(first, "id", "copy")
    print("copy independent: {text.contains(html.outer_html(root), "copy")}")

    let item = element("li", "i1")
    html.set_attr(item, "class", "x")
    html.set_attr(item, "title", "a \"b\" & c")
    html.set_attr(item, "id", "i2")
    print("attributes: {html.outer_html(item)}")
    html.remove_attr(item, "class")
    html.remove_attr(item, "missing")
    print("removed attribute: {html.outer_html(item)} has id {html.has_attr(item, "id")} has class {html.has_attr(item, "class")}")
    print("attribute value: {html.attr(item, "title") ?? "null"} {html.attr(item, "class") ?? "null"}")

    print("contains: {html.contains(root, s)} {html.contains(s, root)} {html.contains(s, s)} {html.contains(a, s)} {html.contains(root, b)}")
    print("text: {text.quote(html.text_content(root))} {text.quote(html.text_content(s))} {text.quote(html.text_content(html.create_text("t")))}")
    let last = html.last_child(root) ?? return
    print("navigation: {name_or_none(html.first_child(root))} {name_or_none(html.last_child(root))} {name_or_none(html.next_sibling(s))} {name_or_none(html.previous_sibling(s))} {name_or_none(html.parent(s))} {name_or_none(html.previous_sibling(last))}")

    let dirty = html.parse_body("<p onclick=x class=c>a<script>1</script><custom>b</custom><a href=\"javascript:x\">l</a><!-- c --></p>")
    let removed = html.clean(dirty.root, html.default_policy())
    print("clean: {removed} {html.inner_html(dirty.root)}")
    print("clean again: {html.clean(dirty.root, html.default_policy())}")
    let holder = html.parse_body("<section><template><b onclick=x>t</b></template><i>k</i></section>")
    let section = html.first_child(holder.root) ?? return
    print("clean keeps root: {html.clean(section, html.default_policy())} {html.outer_html(section)}")
}
