import std/regex
import std/text

fn esc(s: str) -> str {
    s |> text.replace("\n", "\\n") |> text.replace("\r", "\\r") |> text.replace("\t", "\\t")
}

fn report(pattern: str) {
    print("test /{esc(pattern)}/ []")
    let re = regex.compile(pattern) catch {
        Invalid(at, message) => {
            print("  error at {at}: {message}")
            return
        }
    }
    print("  {re.is_match("")}")
}

fn main() {
    for pattern in text.lines(embed("patterns.txt")) {
        report(pattern)
    }
}
