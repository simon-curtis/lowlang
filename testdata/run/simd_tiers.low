        for i in 0..4 {
            let x = edge[i]
            let got_left: i64 = simd.lane(shifted_left, i)
            let got_right: i64 = simd.lane(shifted_right, i)
            let want_left: i64 = if n < 0 || n >= 64 { 0 } else { x << n }
            let want_right: i64 = x >> (n & 63)
            if got_left != want_left || got_right != want_right {
                bad += 1
            }
        }
    }
    report("i64x4", bad)
}

fn check_f32x4() {
    let vals: f32[] = [0.0, 1.0, -1.0, 0.5, -0.5, 3.25, -1024.0, 100000.0]
    var bad = 0
    for round in 0..64 {
        let x0 = round / 8
        let y0 = round % 8
        var xs: f32[] = []
        var ys: f32[] = []
        for i in 0..4 {
            xs.push(vals[(x0 + i) % 8])
            ys.push(vals[(y0 + 3 * i) % 8])
        }
        let a: f32x4 = simd.read(xs, 0)
        let b: f32x4 = simd.read(ys, 0)
        let ops: f32x4[] = [a + b, a - b, a * b, simd.min(a, b), simd.max(a, b), -a, simd.blend(a < b, a, b), simd.blend(a >= b, b, a)]
        var lt: u64 = 0
        var le: u64 = 0
        var gt: u64 = 0
        var ge: u64 = 0
        var eq: u64 = 0
        var ne: u64 = 0
        for i in 0..4 {
            let x = xs[i]
            let y = ys[i]
            lt |= bit(x < y, i)
            le |= bit(x <= y, i)
            gt |= bit(x > y, i)
            ge |= bit(x >= y, i)
            eq |= bit(x == y, i)
            ne |= bit(x != y, i)
            let want: f32[] = [x + y, x - y, x * y, if x < y { x } else { y }, if x > y { x } else { y }, -x, if x < y { x } else { y }, if x >= y { y } else { x }]
            for k, v in ops {
                let got: f32 = simd.lane(v, i)
                if got != want[k] {
                    bad += 1
                }
            }
        }
        if simd.mask(a < b) != lt || simd.mask(a <= b) != le || simd.mask(a > b) != gt || simd.mask(a >= b) != ge {
            bad += 1
        }
        if simd.mask(a == b) != eq || simd.mask(a != b) != ne {
            bad += 1
        }
        let s: f32x4 = simd.splat(xs[0])
        for i in 0..4 {
            let got: f32 = simd.lane(s, i)
            if got != xs[0] {
                bad += 1
            }
        }
    }
    report("f32x4", bad)
}

fn check_f32x8() {
    let vals: f32[] = [0.0, 1.0, -1.0, 0.5, -0.5, 3.25, -1024.0, 100000.0]
    var bad = 0
    for round in 0..64 {
        let x0 = round / 8
        let y0 = round % 8
        var xs: f32[] = []
        var ys: f32[] = []
        for i in 0..8 {
            xs.push(vals[(x0 + i) % 8])
            ys.push(vals[(y0 + 3 * i) % 8])
        }
        let a: f32x8 = simd.read(xs, 0)
        let b: f32x8 = simd.read(ys, 0)
        let ops: f32x8[] = [a + b, a - b, a * b, simd.min(a, b), simd.max(a, b), -a, simd.blend(a < b, a, b), simd.blend(a >= b, b, a)]
        var lt: u64 = 0
        var le: u64 = 0
        var gt: u64 = 0
        var ge: u64 = 0
        var eq: u64 = 0
        var ne: u64 = 0
        for i in 0..8 {
            let x = xs[i]
            let y = ys[i]
            lt |= bit(x < y, i)
            le |= bit(x <= y, i)
            gt |= bit(x > y, i)
            ge |= bit(x >= y, i)
            eq |= bit(x == y, i)
            ne |= bit(x != y, i)
            let want: f32[] = [x + y, x - y, x * y, if x < y { x } else { y }, if x > y { x } else { y }, -x, if x < y { x } else { y }, if x >= y { y } else { x }]
            for k, v in ops {
                let got: f32 = simd.lane(v, i)
                if got != want[k] {
                    bad += 1
                }
            }
        }
        if simd.mask(a < b) != lt || simd.mask(a <= b) != le || simd.mask(a > b) != gt || simd.mask(a >= b) != ge {
            bad += 1
        }
        if simd.mask(a == b) != eq || simd.mask(a != b) != ne {
            bad += 1
        }
        let s: f32x8 = simd.splat(xs[0])
        for i in 0..8 {
            let got: f32 = simd.lane(s, i)
            if got != xs[0] {
                bad += 1
            }
        }
    }
    report("f32x8", bad)
}

fn check_f64x2() {
    let vals: f64[] = [0.0, 1.0, -1.0, 0.5, -0.5, 3.25, -1024.0, 100000.0]
