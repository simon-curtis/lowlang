import std/simd

fn report(name: str, failures: i64) {
    if failures == 0 {
        print("{name}: ok")
    } else {
        print("{name}: {failures} mismatches")
    }
}

fn bit(cond: bool, at: i64) -> u64 {
    if cond {
        return u64(1) << at
    }
    0
}

fn check_u8x16() {
    let vals: u8[] = [0, 1, 2, 127, 128, 129, 254, 255]
    var bad = 0
    for round in 0..64 {
        let x0 = round / 8
        let y0 = round % 8
        var xs: u8[] = []
        var ys: u8[] = []
        for i in 0..16 {
            xs.push(vals[(x0 + i) % 8])
            ys.push(vals[(y0 + 3 * i) % 8])
        }
        let a: u8x16 = simd.read(xs, 0)
        let b: u8x16 = simd.read(ys, 0)
        let ops: u8x16[] = [a + b, a - b, a * b, a & b, a | b, a ^ b, ~a, simd.min(a, b), simd.max(a, b), a == b, a != b, a < b, a <= b, a > b, a >= b, a << 3, a >> 3, simd.blend(a < b, a, b), simd.blend(a != b, b, a), a >= vals[4], a < vals[5]]
        var lt: u64 = 0
        var le: u64 = 0
        var gt: u64 = 0
        var ge: u64 = 0
        var eq: u64 = 0
        var ne: u64 = 0
        var top: u64 = 0
        for i in 0..16 {
            let x = xs[i]
            let y = ys[i]
            lt |= bit(x < y, i)
            le |= bit(x <= y, i)
            gt |= bit(x > y, i)
            ge |= bit(x >= y, i)
            eq |= bit(x == y, i)
            ne |= bit(x != y, i)
            top |= bit(x >= 128, i)
            let want: u8[] = [
                x + y,
                x - y,
                x * y,
                x & y,
                x | y,
                x ^ y,
                ~x,
                if x < y { x } else { y },
                if x > y { x } else { y },
                if x == y { 255 } else { 0 },
                if x != y { 255 } else { 0 },
                if x < y { 255 } else { 0 },
                if x <= y { 255 } else { 0 },
                if x > y { 255 } else { 0 },
                if x >= y { 255 } else { 0 },
                x << 3,
                x >> 3,
                if x < y { x } else { y },
                if x != y { y } else { x },
                if x >= vals[4] { 255 } else { 0 },
                if x < vals[5] { 255 } else { 0 }
            ]
            for k, v in ops {
                let got: u8 = simd.lane(v, i)
                if got != want[k] {
                    bad += 1
                }
            }
        }
        if simd.mask(a < b) != lt || simd.mask(a <= b) != le || simd.mask(a > b) != gt || simd.mask(a >= b) != ge {
            bad += 1
        }
        if simd.mask(a == b) != eq || simd.mask(a != b) != ne || simd.mask(a) != top {
            bad += 1
        }
        let s: u8x16 = simd.splat(xs[0])
        for i in 0..16 {
            let got: u8 = simd.lane(s, i)
            if got != xs[0] {
                bad += 1
            }
        }
    }
    let counts: i64[] = [0, 1, 7, 8, 9, 15, 16, 17, 31, 32, 33, 63, 64, 65, 200, 4294967296, -1]
    var edge: u8[] = []
    for i in 0..16 {
        edge.push(vals[i % 8])
    }
    let c: u8x16 = simd.read(edge, 0)
    for n in counts {
        let shifted_left = c << n
        let shifted_right = c >> n
        for i in 0..16 {
            let x = edge[i]
            let got_left: u8 = simd.lane(shifted_left, i)
            let got_right: u8 = simd.lane(shifted_right, i)
            let want_left: u8 = if (n & 63) >= 8 { 0 } else { x << (n & 63) }
            let want_right: u8 = if (n & 63) >= 8 { 0 } else { x >> (n & 63) }
            if got_left != want_left || got_right != want_right {
                bad += 1
            }
        }
    }
    report("u8x16", bad)
}

