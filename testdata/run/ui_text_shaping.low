import std/io
import std/ui
import std/ui/font
import std/ui/geometry
import std/ui/platform
import std/ui/text
import strings = std/text

struct Table {
    tag: str
    data: []u8
}

struct Script {
    tag: str
    features: []i64
}

struct Feature {
    tag: str
    lookups: []i64
}

fn u16s(values: []i64) -> []u8 {
    var b: []u8 = []
    for v in values {
        io.put_be16(mut b, v)
    }
    b
}

fn zeros(n: i64) -> []u8 {
    var b: []u8 = []
    for _ in 0..n {
        b.push(0)
    }
    b
}

fn append(mut b: []u8, more: []u8) {
    for x in more {
        b.push(x)
    }
}

fn assemble(tables: []Table) -> str {
    var out: []u8 = []
    io.put_be32(mut out, 65536)
    io.put_be16(mut out, tables.len)
    for _ in 0..6 {
        out.push(0)
    }
    var offset = 12 + 16 * tables.len
    for t in tables {
        for i in 0..4 {
            out.push(t.tag[i])
        }
        io.put_be32(mut out, 0)
        io.put_be32(mut out, offset)
        io.put_be32(mut out, t.data.len)
        offset += (t.data.len + 3) / 4 * 4
    }
    for t in tables {
        append(mut out, t.data)
        for _ in 0..(4 - t.data.len % 4) % 4 {
            out.push(0)
        }
    }
    str(out)
}

fn box(x0: i64, x1: i64, y1: i64) -> []u8 {
    var b = u16s([1, 0, 0, 0, 0, 3, 0])
    for _ in 0..4 {
        b.push(1)
    }
    for dx in [x0, x1 - x0, 0, x0 - x1] {
        io.put_be16(mut b, dx)
    }
    for dy in [0, 0, y1, 0] {
        io.put_be16(mut b, dy)
    }
    b
}

fn cmap_table(points: []i64) -> []u8 {
    var b = u16s([0, 1, 3, 10])
    io.put_be32(mut b, 12)
    io.put_be16(mut b, 12)
    io.put_be16(mut b, 0)
    io.put_be32(mut b, 16 + 12 * (points.len / 2))
    io.put_be32(mut b, 0)
    io.put_be32(mut b, points.len / 2)
    for i in 0..points.len / 2 {
        io.put_be32(mut b, points[2 * i])
        io.put_be32(mut b, points[2 * i])
        io.put_be32(mut b, points[2 * i + 1])
    }
    b
}

fn name_table(family: str) -> []u8 {
    var b = u16s([0, 1, 18, 3, 1, 0x409, 1, 2 * family.len, 0])
    for i in 0..family.len {
        io.put_be16(mut b, i64(family[i]))
    }
    b
}

fn coverage1(glyphs: []i64) -> []u8 {
    var b: []u8 = []
    append(mut b, u16s([1, glyphs.len]))
    append(mut b, u16s(glyphs))
    b
}

fn class1(start: i64, classes: []i64) -> []u8 {
    var b = u16s([1, start, classes.len])
    append(mut b, u16s(classes))
    b
}

fn ligature_sub(coverage: []u8, set: [][]i64) -> []u8 {
    var b = u16s([1, 8, 1, 8 + coverage.len])
    append(mut b, coverage)
    io.put_be16(mut b, set.len)
    var inner = 2 + 2 * set.len
    for lig in set {
        io.put_be16(mut b, inner)
        inner += 2 * (lig.len + 1)
    }
    for lig in set {
        io.put_be16(mut b, lig[0])
        io.put_be16(mut b, lig.len)
        append(mut b, u16s(lig[1..]))
    }
    b
}

fn attach_sub(first: []u8, second: []u8, classes: i64, marks: []u8, bases: []u8) -> []u8 {
    let at = 12
    var b = u16s([1, at, at + first.len, classes, at + first.len + second.len, at + first.len + second.len + marks.len])
    append(mut b, first)
    append(mut b, second)
    append(mut b, marks)
    append(mut b, bases)
    b
}

fn mark_array(anchors: [][]i64) -> []u8 {
    var b = u16s([anchors.len])
    var at = 2 + 4 * anchors.len
    for a in anchors {
        io.put_be16(mut b, 0)
        io.put_be16(mut b, at)
        at += 2 * a.len
    }
    for a in anchors {
        append(mut b, u16s(a))
    }
    b
}

fn base_array(anchors: [][]i64) -> []u8 {
    var b = u16s([anchors.len])
    var at = 2 + 2 * anchors.len
    for a in anchors {
        io.put_be16(mut b, at)
        at += 2 * a.len
    }
    for a in anchors {
        append(mut b, u16s(a))
    }
    b
}

fn lookup(kind: i64, subtable: []u8) -> []u8 {
    var b = u16s([kind, 0, 1, 8])
    append(mut b, subtable)
    b
}

fn list(tags: []str, items: [][]u8) -> []u8 {
    let record = if tags.len > 0 { 6 } else { 2 }
    var b = u16s([items.len])
    var at = 2 + record * items.len
    for i in 0..items.len {
        if tags.len > 0 {
            for j in 0..4 {
                b.push(tags[i][j])
            }
        }
        io.put_be16(mut b, at)
        at += items[i].len
    }
    for item in items {
        append(mut b, item)
    }
    b
}

fn layout(features: []Feature, lookups: [][]u8) -> []u8 {
    var feature_tags: []str = []
    var feature_tables: [][]u8 = []
    var indices: []i64 = []
    for i in 0..features.len {
        feature_tags.push(features[i].tag)
        var t = u16s([0, features[i].lookups.len])
        append(mut t, u16s(features[i].lookups))
        feature_tables.push(t)
        indices.push(i)
    }
    var script = u16s([4, 0, 0, 65535, indices.len])
    append(mut script, u16s(indices))
    let script_list = list(["DFLT"], [script])
    let feature_list = list(feature_tags, feature_tables)
    var b: []u8 = []
    io.put_be32(mut b, 65536)
    append(mut b, u16s([10, 10 + script_list.len, 10 + script_list.len + feature_list.len]))
    append(mut b, script_list)
    append(mut b, feature_list)
    append(mut b, list([], lookups))
    b
}

fn gsub_table() -> []u8 {
    let sub = ligature_sub(coverage1([1]), [[5, 1, 2], [4, 2], [10, 3]])
    layout([Feature { tag: "liga", lookups: [0] }], [lookup(4, sub)])
}

fn gpos_table() -> []u8 {
    let marks = mark_array([[1, 128, 0], [1, 192, 0]])
    let bases = base_array([[1, 192, 640], [1, 256, 512], [1, 256, 768]])
    let attach = attach_sub(coverage1([8, 9]), coverage1([2, 7, 11]), 1, marks, bases)
    let chain_marks = mark_array([[1, 64, 0]])
    let chain_bases = base_array([[1, 128, 320]])
    let chain = attach_sub(coverage1([9]), coverage1([8]), 1, chain_marks, chain_bases)
    layout([Feature { tag: "mark", lookups: [0] }, Feature { tag: "mkmk", lookups: [1] }], [lookup(4, attach), lookup(6, chain)])
}

fn gdef_table() -> []u8 {
    var b = u16s([1, 0, 12, 0, 0, 0])
    append(mut b, class1(8, [3, 3]))
    b
}

fn shaping_font(family: str, with_i: bool) -> font.Font {
    var head = zeros(54)
    io.set_be16(head, 18, 1024)
    var hhea = zeros(36)
    io.set_be16(hhea, 4, 1024)
    io.set_be16(hhea, 6, -256)
    io.set_be16(hhea, 8, 128)
    io.set_be16(hhea, 34, 12)
    var maxp = zeros(6)
    io.set_be16(maxp, 4, 12)
    var hmtx: []u8 = []
    for advance in [512, 384, 256, 256, 576, 832, 256, 512, 192, 192, 576, 512] {
        io.put_be16(mut hmtx, advance)
        io.put_be16(mut hmtx, 0)
    }
    var glyf: []u8 = []
    var loca: []u8 = []
    io.put_be16(mut loca, 0)
    for g in 0..12 {
        if g == 8 {
            append(mut glyf, box(0, 128, 128))
        }
        io.put_be16(mut loca, glyf.len / 2)
    }
    var points = [32, 6, 97, 7, 98, 11, 102, 1]
    if with_i {
        points.push(105)
        points.push(2)
    }
    for p in [108, 3, 768, 9, 769, 8] {
        points.push(p)
    }
    let tables = [
        Table { tag: "head", data: head }
        Table { tag: "hhea", data: hhea }
        Table { tag: "maxp", data: maxp }
        Table { tag: "cmap", data: cmap_table(points) }
        Table { tag: "hmtx", data: hmtx }
        Table { tag: "loca", data: loca }
        Table { tag: "glyf", data: glyf }
        Table { tag: "name", data: name_table(family) }
        Table { tag: "GSUB", data: gsub_table() }
        Table { tag: "GPOS", data: gpos_table() }
        Table { tag: "GDEF", data: gdef_table() }
    ]
    font.parse(assemble(tables)) or font.Font {}
}

fn unbounded() -> f32 {
    1000000000.0
}

fn acute() -> str {
    strings.from_char(0x301)
}

fn grave() -> str {
    strings.from_char(0x300)
}

fn show(label: str, l: text.Layout) {
    print("{label}: {l.lines.len} lines")
    for line in l.lines {
        var parts = ""
        for g in line.glyphs {
            parts = "{parts} {g.font}:{g.glyph}@{g.x},{g.y}+{g.advance}#{g.at}-{g.end}"
        }
        print("  width {line.width}:{parts}")
    }
}

fn lay(mut sys: text.System, label: str, s: str) {
    show(label, sys.wrap(s, text.Format { wrap: false }, unbounded()))
}

fn click(cx: ui.Context, x: f32) {
    cx.dispatch(PointerDown(Left, x, 15.0))
    cx.dispatch(PointerUp(Left, x, 15.0))
}

fn key(k: platform.NamedKey) -> platform.Event {
    Key(platform.KeyEvent { key: Named(k) })
}

fn caret_x(cx: ui.Context) -> str {
    match cx.input_caret() {
        some(r) => "{r.x}"
        none => "none"
    }
}

fn carets(cx: ui.Context, name: str, s: str, clicks: []f32) {
    let f = ui.text_field(cx, s)
    let view = fn() -> ui.Element {
        ui.div().size(300.0, 100.0).padding(10.0).font_family("Shape").children() {
            ui.field(cx, f, name, 16.0).width(200.0)
        }
    }
    cx.frame(view, geometry.size(300.0, 100.0), 1.0)
    for x in clicks {
        click(cx, x)
        cx.frame(view, geometry.size(300.0, 100.0), 1.0)
        print("{name} click {x}: {f.field_value().selection.end} caret {caret_x(cx)}")
    }
    var steps = "{name} keys"
    let moves: []platform.NamedKey = [End, Left, Left, Right]
    for k in moves {
        cx.dispatch(key(k))
        cx.frame(view, geometry.size(300.0, 100.0), 1.0)
        steps = "{steps} {f.field_value().selection.end}@{caret_x(cx)}"
    }
    print(steps)
}

fn main() {
    let full = shaping_font("Shape", true)
    var sys = text.system([full])
    lay(mut sys, "fi", "fi")
    lay(mut sys, "ffi", "ffi")
    lay(mut sys, "bffib", "bffib")
    lay(mut sys, "fil", "fil")
    lay(mut sys, "fl", "fl")
    lay(mut sys, "f i", "f i")
    lay(mut sys, "a acute", "a{acute()}")
    lay(mut sys, "a acute b", "a{acute()}b")
    lay(mut sys, "i acute grave", "i{acute()}{grave()}")
    lay(mut sys, "a grave", "a{grave()}")
    lay(mut sys, "space acute", " {acute()}")
    lay(mut sys, "acute", acute())
    lay(mut sys, "fi acute", "fi{acute()}")
    lay(mut sys, "fi a acute", "fia{acute()}")

    show("wrap mark", sys.wrap("bbba{acute()}", text.Format {}, 24.0))
    show("ligature kept whole", sys.wrap("fi", text.Format {}, 4.0))
    show("ligatures wrap", sys.wrap("fi fi", text.Format {}, 12.0))
    show("ellipsis ligature", sys.wrap("bbb", text.Format { wrap: false, ellipsis: "fi" }, 20.0))
    show("ellipsis mark", sys.wrap("ba{acute()}bb", text.Format { wrap: false, ellipsis: "b" }, 28.0))
    show("ellipsis back off", sys.wrap("bba{acute()}bb", text.Format { wrap: false, ellipsis: "b" }, 28.0))

    var split = text.system([shaping_font("Shape", false), shaping_font("Other", true)])
    lay(mut split, "fonts differ", "fi")

    let cx = ui.headless(ui.rgb(0xffffff))
    var now = 0
    cx.set_clock(fn() -> i64 { now })
    ui.bind_field_keys(cx) or {
        print("bind failed")
        return
    }
    ui.add_fonts(cx, [full])
    carets(cx, "ligature", "fi", [14.0, 20.0, 12.0])
    carets(cx, "mark", "a{acute()}", [17.0, 12.0])

    let sc = cx.frame(fn() -> ui.Element { ui.text("a{acute()}").font_family("Shape") }, geometry.size(200.0, 100.0), 1.0)
    var parts: []str = []
    for s in sc.sprites {
        parts.push("{s.bounds.x},{s.bounds.y} {s.bounds.width}x{s.bounds.height}")
    }
    print("sprites: {parts}")
}
