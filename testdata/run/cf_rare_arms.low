fn arm_with_loop(limit: i64) -> i64 {
    var marks: []u8 = []
    for i in 0..limit {
        push(mut marks, u8(if i % 3 == 0 { 1 } else { 0 }))
    }
    var count = 0
    for i in 0..limit {
        if marks[i] == 0 {
            count += 1
            var j = i
            for j < limit {
                count += j % 2
                j += 7
            }
        }
    }
    count
}

fn arm_returns(values: []i64) -> i64 {
    var seen = 0
    for v in values {
        if v == 0 {
            return seen * 100
        }
        seen += v
    }
    seen
}

fn arm_breaks(values: []i64) -> i64 {
    var total = 0
    for v in values {
        if v == 9 {
            total += 1000
            break
        }
        total += v
    }
    total
}

fn arm_continues(values: []i64) -> i64 {
    var total = 0
    for v in values {
        if v == 2 {
            total += 50
            continue
        }
        total += v * 3
    }
    total
}

fn nested_arms(limit: i64) -> i64 {
    var total = 0
    for i in 0..limit {
        if i % 2 == 0 {
            if i % 3 == 0 {
                if i % 5 == 0 {
                    total += 1000
                }
                total += 100
            }
            total += 10
        }
        total += 1
    }
    total
}

fn arm_ends_body(limit: i64) -> i64 {
    var total = 0
    var i = 0
    for i < limit {
        i += 1
        if i % 4 == 0 {
            total += i
        }
    }
    total
}

fn phi_across_arm(limit: i64) -> i64 {
    var a = 1
    var b = 2
    for i in 0..limit {
        if i % 3 == 0 {
            let t = a
            a = b + i
            b = t
        }
        a += 1
    }
    a * 1000 + b
}

fn inside_green_thread(limit: i64, out: chan[i64]) {
    var total = 0
    for i in 0..limit {
        if i % 1000 == 0 {
            var j = 0
            for j < 1000 {
                total += j
                j += 1
            }
        }
        total += 1
    }
    out <- total
}

fn main() {
    print(arm_with_loop(1000))
    print(arm_returns([1, 2, 3]))
    print(arm_returns([1, 2, 0, 3]))
    print(arm_breaks([1, 2, 3]))
    print(arm_breaks([1, 9, 3]))
    print(arm_continues([1, 2, 3, 2]))
    print(nested_arms(100))
    print(arm_ends_body(100))
    print(phi_across_arm(50))
    let out = chan[i64](1)
    spawn inside_green_thread(100000, out)
    print((<-out) ?? -1)
}
