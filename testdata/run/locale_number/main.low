import std/locale
import std/locale/decimal
import std/locale/numfmt
import std/text

fn mode_of(name: str) -> decimal.Mode {
    match name {
        "ceil" => decimal.Mode.Ceil
        "floor" => decimal.Mode.Floor
        "expand" => decimal.Mode.Expand
        "trunc" => decimal.Mode.Trunc
        "halfCeil" => decimal.Mode.HalfCeil
        "halfFloor" => decimal.Mode.HalfFloor
        "halfExpand" => decimal.Mode.HalfExpand
        "halfTrunc" => decimal.Mode.HalfTrunc
        _ => decimal.Mode.HalfEven
    }
}

fn number(s: str) -> i64 {
    text.parse_int(s) or 0
}

fn set_option(o: *numfmt.Options, key: str, value: str) {
    match key {
        "style" => {
            o.style = match value {
                "percent" => numfmt.Style.Percent
                "currency" => numfmt.Style.Currency
                _ => numfmt.Style.Decimal
            }
        }
        "currency" => { o.currency = value }
        "currencyDisplay" => {
            o.currency_display = match value {
                "code" => numfmt.CurrencyDisplay.Code
                "narrowSymbol" => numfmt.CurrencyDisplay.NarrowSymbol
                "name" => numfmt.CurrencyDisplay.Name
                _ => numfmt.CurrencyDisplay.Symbol
            }
        }
        "currencySign" => {
            o.currency_sign = if value == "accounting" { numfmt.CurrencySign.Accounting } else { numfmt.CurrencySign.Standard }
        }
        "currencyUsage" => {
            o.currency_usage = if value == "cash" { numfmt.CurrencyUsage.Cash } else { numfmt.CurrencyUsage.Standard }
        }
        "notation" => {
            o.notation = match value {
                "compact" => numfmt.Notation.Compact
                "scientific" => numfmt.Notation.Scientific
                "engineering" => numfmt.Notation.Engineering
                _ => numfmt.Notation.Standard
            }
        }
        "compactDisplay" => {
            o.compact_display = if value == "long" { numfmt.CompactDisplay.Long } else { numfmt.CompactDisplay.Short }
        }
        "signDisplay" => {
            o.sign_display = match value {
                "always" => numfmt.SignDisplay.Always
                "never" => numfmt.SignDisplay.Never
                "exceptZero" => numfmt.SignDisplay.ExceptZero
                "negative" => numfmt.SignDisplay.Negative
                _ => numfmt.SignDisplay.Auto
            }
        }
        "useGrouping" => {
            o.grouping = match value {
                "false" => numfmt.Grouping.Off
                "min2" => numfmt.Grouping.Min2
                "always" => numfmt.Grouping.Always
                _ => numfmt.Grouping.Auto
            }
        }
        "minimumIntegerDigits" => { o.minimum_integer = number(value) }
        "minimumFractionDigits" => { o.minimum_fraction = number(value) }
        "maximumFractionDigits" => { o.maximum_fraction = number(value) }
        "minimumSignificantDigits" => { o.minimum_significant = number(value) }
        "maximumSignificantDigits" => { o.maximum_significant = number(value) }
        "roundingMode" => { o.rounding_mode = mode_of(value) }
        "roundingIncrement" => { o.rounding_increment = number(value) }
        "trailingZeroDisplay" => {
            o.trailing_zeros = if value == "stripIfInteger" { numfmt.TrailingZeros.StripIfInteger } else { numfmt.TrailingZeros.Auto }
        }
        _ => {}
    }
}

fn options_of(spec: str) -> numfmt.Options {
    let o = new(numfmt.options())
    if spec != "" {
        for item in text.split(spec, ',') {
            let cut = text.cut(item, "=")
            set_option(o, cut.before, cut.after)
        }
    }
    *o
}

fn main() {
    var checked = 0
    var failed = 0
    var current = ""
    var l = locale.root()
    for line in text.lines(embed("numbers.tsv")) {
        let f = text.split(line, '\t')
        if f.len != 4 {
            continue
        }
        if f[0] != current {
            current = f[0]
            l = locale.parse(current) or locale.root()
        }
        let d = decimal.parse(f[2]) or decimal.zero()
        let got = numfmt.format(l, d, options_of(f[1])) or "error"
        checked += 1
        if got != f[3] {
            failed += 1
            if failed <= 40 {
                print("{f[0]} [{f[1]}] {f[2]}: want {f[3]}, got {got}")
            }
        }
    }
    print("number: {checked} checked, {failed} wrong")
}
