enum Align {
    Start
    Center
    End
}

enum Element {
    Box(Div)
    Label(Text)
}

struct Text {
    value: str
    size: f64 = 14.0
}

struct Div {
    padding: f64 = 0.0
    gap: f64 = 0.0
    align: Align = Start
    flex: bool = false
    id: i64 = next_id(counter())
    on_click: fn() -> str = fn() -> str { "nothing" }
    children: []Element = []
}

struct Stack[T] {
    items: []T = []
    limit: i64 = 8
}

fn counter() -> i64 {
    41
}

fn next_id(seed: i64) -> i64 {
    seed + 1
}

fn div(padding: f64, children: []Element) -> Element {
    Box(Div { padding, gap: 2.0, children })
}

fn text(value: str) -> Element {
    Label(Text { value })
}

fn count(e: Element) -> i64 {
    match e {
        Box(d) => {
            var n = 1
            for child in d.children {
                n += count(child)
            }
            n
        }
        Label(_) => 1
    }
}

fn describe(e: Element, depth: i64) {
    var indent = ""
    for i in 0..depth {
        indent = "{indent}  "
    }
    match e {
        Box(d) => {
            print("{indent}div padding={d.padding} gap={d.gap} flex={d.flex} id={d.id} children={d.children.len}")
            for child in d.children {
                describe(child, depth + 1)
            }
        }
        Label(t) => print("{indent}text {t.value} size={t.size}")
    }
}

fn main() {
    let plain = Div {}
    print(plain.padding)
    print(plain.align == Start)
    print(plain.children.len)
    print(plain.on_click())

    let tree = Element.Box(Div { padding: 8.0, flex: true } {
        Label(Text { value: "title", size: 20.0 })
        Box(Div { gap: 4.0, align: Center } {
            Label(Text { value: "ok" })
            Label(Text { value: "cancel" })
        })
        div(1.0) {
            text("nested")
            div(2.0) {}
        }
    })
    describe(tree, 0)
    print(count(tree))

    let inline = Div { on_click: fn() -> str { "saved" } } { text("a"), text("b") }
    print(inline.children.len)
    print(inline.on_click())

    let s: Stack[str] = Stack {}
    print(s.limit)
    let t = Stack[i64] { limit: 2 }
    print(t.items.len + t.limit)
}
