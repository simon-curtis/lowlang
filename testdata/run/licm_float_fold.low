fn pass64(x: f64, depth: i64) -> f64 {
    if depth == 0 { x } else { pass64(x, depth - 1) }
}

fn pass32(x: f32, depth: i64) -> f32 {
    if depth == 0 { x } else { pass32(x, depth - 1) }
}

fn passInt(x: i64, depth: i64) -> i64 {
    if depth == 0 { x } else { passInt(x, depth - 1) }
}

fn same64(name: str, folded: f64, runtime: f64) {
    let direction = 1.0 / pass64(1.0, 2)
    let sign = if folded == 0.0 { direction / folded } else { 0.0 }
    let runtime_sign = if runtime == 0.0 { direction / runtime } else { 0.0 }
    var verdict = "differs"
    if folded == runtime || (folded != folded && runtime != runtime) {
        if sign == runtime_sign {
            verdict = "same"
        }
    }
    print("{name} {folded} {runtime} {verdict}")
}

fn same32(name: str, folded: f32, runtime: f32) {
    let direction: f32 = 1.0 / pass32(1.0, 2)
    let sign: f32 = if folded == 0.0 { direction / folded } else { 0.0 }
    let runtime_sign: f32 = if runtime == 0.0 { direction / runtime } else { 0.0 }
    var verdict = "differs"
    if folded == runtime || (folded != folded && runtime != runtime) {
        if sign == runtime_sign {
            verdict = "same"
        }
    }
    print("{name} {folded} {runtime} {verdict}")
}

fn arithmetic64() {
    let zero = 0.0
    let one = 1.0
    let tiny = 4.9406564584124654e-324
    let big = 1.7976931348623157e308
    let third = 1.0 / 3.0
    same64("add", 0.1 + 0.2, pass64(0.1, 1) + pass64(0.2, 1))
    same64("sub", 0.3 - 0.1, pass64(0.3, 1) - pass64(0.1, 1))
    same64("mul", 1.1 * 1.1, pass64(1.1, 1) * pass64(1.1, 1))
    same64("div", one / 3.0, pass64(1.0, 1) / pass64(3.0, 1))
    same64("third", third * 3.0, pass64(third, 1) * pass64(3.0, 1))
    same64("negzero_mul", -1.0 * zero, pass64(-1.0, 1) * pass64(0.0, 1))
    same64("negzero_neg", -zero, -pass64(0.0, 1))
    same64("negzero_sub", zero - zero, pass64(0.0, 1) - pass64(0.0, 1))
    same64("negzero_add", -zero + -zero, -pass64(0.0, 1) + -pass64(0.0, 1))
    same64("posinf", one / zero, pass64(1.0, 1) / pass64(0.0, 1))
    same64("neginf", -one / zero, -pass64(1.0, 1) / pass64(0.0, 1))
    same64("overflow", big * 2.0, pass64(big, 1) * pass64(2.0, 1))
    same64("overflow_add", big + big, pass64(big, 1) + pass64(big, 1))
    same64("subnormal", tiny / 2.0, pass64(tiny, 1) / pass64(2.0, 1))
    same64("subnormal_mul", tiny * 0.5, pass64(tiny, 1) * pass64(0.5, 1))
    same64("subnormal_add", tiny + tiny, pass64(tiny, 1) + pass64(tiny, 1))
    same64("underflow", tiny * tiny, pass64(tiny, 1) * pass64(tiny, 1))
    same64("inf_minus_inf", one / zero - one / zero, pass64(1.0, 1) / pass64(0.0, 1) - pass64(1.0, 1) / pass64(0.0, 1))
    same64("zero_over_zero", zero / zero, pass64(0.0, 1) / pass64(0.0, 1))
    same64("inf_times_zero", one / zero * zero, pass64(1.0, 1) / pass64(0.0, 1) * pass64(0.0, 1))
    same64("sqrt", sqrt(2.0), sqrt(pass64(2.0, 1)))
    same64("sqrt_negzero", sqrt(-zero), sqrt(-pass64(0.0, 1)))
    same64("sqrt_negative", sqrt(-1.0), sqrt(pass64(-1.0, 1)))
    same64("floor", floor(-2.5), floor(pass64(-2.5, 1)))
    same64("floor_negzero", floor(-zero), floor(-pass64(0.0, 1)))
    same64("floor_tiny", floor(-tiny), floor(-pass64(tiny, 1)))
}

fn arithmetic32() {
    let zero: f32 = 0.0
    let one: f32 = 1.0
    let tiny: f32 = 1.4e-45
    let big: f32 = 3.4028235e38
    same32("add", 0.1 + 0.2, pass32(0.1, 1) + pass32(0.2, 1))
    same32("mul", 1.1 * 1.1, pass32(1.1, 1) * pass32(1.1, 1))
    same32("div", one / 3.0, pass32(1.0, 1) / pass32(3.0, 1))
    same32("negzero", -one * zero, -pass32(1.0, 1) * pass32(0.0, 1))
    same32("neg", -zero, -pass32(0.0, 1))
    same32("overflow", big * 2.0, pass32(big, 1) * pass32(2.0, 1))
    same32("subnormal", tiny / 2.0, pass32(tiny, 1) / pass32(2.0, 1))
    same32("subnormal_add", tiny + tiny, pass32(tiny, 1) + pass32(tiny, 1))
    same32("posinf", one / zero, pass32(1.0, 1) / pass32(0.0, 1))
    same32("nan", zero / zero, pass32(0.0, 1) / pass32(0.0, 1))
    same32("sqrt", sqrt(2.0), sqrt(pass32(2.0, 1)))
    same32("floor", floor(-0.5), floor(pass32(-0.5, 1)))
}

fn conversions() {
    let size = 2000
    let scale = 2.0 / f64(size)
    same64("scale", scale, 2.0 / f64(passInt(2000, 1)))
    same64("i64", f64(9007199254740993), f64(passInt(9007199254740993, 1)))
    same64("i64_min", f64(-9223372036854775807 - 1), f64(passInt(-9223372036854775807 - 1, 1)))
    same64("i64_max", f64(9223372036854775807), f64(passInt(9223372036854775807, 1)))
    same64("u64_small", f64(u64(12345678901234567)), f64(u64(passInt(12345678901234567, 1))))
    same32("i64_to_f32", f32(16777217), f32(passInt(16777217, 1)))
    same32("i64_to_f32_big", f32(9223372036854775807), f32(passInt(9223372036854775807, 1)))
    same32("i32_to_f32", f32(i32(-2147483647)), f32(i32(passInt(-2147483647, 1))))
    same64("f32_to_f64", f64(f32(0.1)), f64(pass32(0.1, 1)))
    same32("f64_to_f32", f32(0.1), f32(pass64(0.1, 1)))
    same32("f64_to_f32_big", f32(1e300), f32(pass64(1e300, 1)))
    same32("f64_to_f32_small", f32(1e-300), f32(pass64(1e-300, 1)))
    same32("f64_to_f32_subnormal", f32(1e-45), f32(pass64(1e-45, 1)))
    print("trunc {i64(2.9)} {i64(passFloat(2.9))}")
    print("trunc_neg {i64(-2.9)} {i64(passFloat(-2.9))}")
    print("trunc_big {i64(1e30)} {i64(passFloat(1e30))}")
    print("trunc_small {i64(-1e30)} {i64(passFloat(-1e30))}")
    print("trunc_inf {i64(1.0 / 0.0)} {i64(passFloat(1.0 / 0.0))}")
    print("trunc_nan {i64((0.0 / 0.0))} {i64(passFloat(0.0 / 0.0))}")
    print("narrow {i32(3000000000.5)} {i32(passFloat(3000000000.5))}")
    print("narrow_u8 {u8(300.7)} {u8(passFloat(300.7))}")
    print("narrow_u8_neg {u8(-1.5)} {u8(passFloat(-1.5))}")
    print("narrow_u32 {u32(5000000000.0)} {u32(passFloat(5000000000.0))}")
    print("u64_in_range {u64(1e18)} {u64(passFloat(1e18))}")
    print("u64_two_63 {u64(9223372036854775808.0)} {u64(passFloat(9223372036854775808.0))}")
    print("u64_large {u64(1.5e19)} {u64(passFloat(1.5e19))}")
    print("u64_negative {u64(-1.0)} {u64(passFloat(-1.0))}")
    print("f32_trunc {i64(f32(7.9))} {i64(pass32(7.9, 1))}")
    print("f32_trunc_big {i64(f32(1e30))} {i64(pass32(1e30, 1))}")
}

fn passFloat(x: f64) -> f64 {
    pass64(x, 1)
}

fn main() {
    arithmetic64()
    arithmetic32()
    conversions()
}
