    case_all("[a-c]+", "i", regex.generated("(?i)[a-c]+"), "xABCabcD")
    case_all("[^\\W\\d_]+", "", regex.generated("[^\\W\\d_]+"), "ab12_cd")
    case_all("[\\d\\s]+", "", regex.generated("[\\d\\s]+"), "a1 2\tb")
    case_find("(?s)a.b", "", regex.generated("(?s)a.b"), "a\nb")
    case_find("a.b", "", regex.generated("a.b"), "a\nb")
    case_find("(?m)^b$", "", regex.generated("(?m)^b$"), "a\nb\nc")
    case_find("(?ms)^a.b$", "", regex.generated("(?ms)^a.b$"), "x\na\nb\ny")
    case_all("[]a]", "", regex.generated("[]a]"), "a]b")
    case_all("[a-]", "", regex.generated("[a-]"), "a-b")
    case_all("[-a]", "", regex.generated("[-a]"), "a-b")
    case_all("[.]|\\.", "", regex.generated("[.]|\\."), "a.b")
    case_all("[^]]", "", regex.generated("[^]]"), "a]b")
    case_all("\\(\\)\\[\\]\\{{\\}}\\*\\+\\?\\|\\^\\$\\\\", "", regex.generated("\\(\\)\\[\\]\\{{\\}}\\*\\+\\?\\|\\^\\$\\\\"), "x()[]{{}}*+?|^$\\x")
    case_test("needle", "", regex.generated("needle"), "haystack with needle inside")
    case_test("needle", "", regex.generated("needle"), "haystack")
    case_test("^$", "", regex.generated("^$"), "")
    case_find("(a+)+$", "", regex.generated("(a+)+$"), "{text.repeat("a", 30)}!")
    case_find("(x+x+)+y", "", regex.generated("(x+x+)+y"), text.repeat("x", 5000))
    case_find("(a|aa)*c", "", regex.generated("(a|aa)*c"), "{text.repeat("a", 5000)}b")
    case_find("(a*)*b", "", regex.generated("(a*)*b"), text.repeat("a", 5000))
    case_find("(a+)+$", "", regex.generated("(a+)+$"), text.repeat("a", 10000))
    case_all("(?:a?){{30}}a{{30}}", "", regex.generated("(?:a?){{30}}a{{30}}"), text.repeat("a", 30))
