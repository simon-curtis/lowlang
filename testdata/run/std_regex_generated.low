    case_find("(a??)(a*)", "", regex.generated("(a??)(a*)"), "aa")
    case_find("(a*?)(a*?)$", "", regex.generated("(a*?)(a*?)$"), "aa")
    case_all("a{{3}}", "", regex.generated("a{{3}}"), "aaaaaaa")
    case_all("a{{,2}}", "", regex.generated("a{{,2}}"), "aaaaa")
    case_all("a{{2,}}", "", regex.generated("a{{2,}}"), "a aa aaa")
    case_all("a{{,}}", "", regex.generated("a{{,}}"), "baab")
    case_all("a{{", "", regex.generated("a{{"), "a{{ a{{x}} a{{1,2x}}")
    case_all("x{{1, 2}}", "", regex.generated("x{{1, 2}}"), "x{{1, 2}}")
    case_all("{{", "", regex.generated("{{"), "a{{b}}")
    case_all("\\d+|[a-z]+", "", regex.generated("\\d+|[a-z]+"), "abc123def45")
    case_all("a*", "", regex.generated("a*"), "baaac")
    case_all("", "", regex.generated(""), "ab")
    case_all("\\b", "", regex.generated("\\b"), "hi there")
    case_all("x*", "", regex.generated("x*"), "axxb")
    case_all("|a", "", regex.generated("|a"), "aa")
    case_all("a|", "", regex.generated("a|"), "aba")
    case_all("", "", regex.generated(""), "hé😀")
    case_sub("x*", "", regex.generated("x*"), "abxd", "-")
    case_sub("", "", regex.generated(""), "abc", "-")
    case_sub("a|", "", regex.generated("a|"), "baac", "-")
    case_wrap("\\d+", "", regex.generated("\\d+"), "a1b22c333")
    case_wrap("a*", "", regex.generated("a*"), "baac")
    case_split("x*", "", regex.generated("x*"), "axbc", -1)
    case_split("\\b", "", regex.generated("\\b"), "a b", -1)
    case_split(",", "", regex.generated(","), "a,b,,c,", -1)
