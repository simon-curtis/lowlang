    case_all("^a", "m", regex.generated("(?m)^a"), "a\nb\na")
    case_all("^a", "", regex.generated("^a"), "a\nb\na")
    case_all("$", "", regex.generated("$"), "a\nb\n")
    case_all("$", "m", regex.generated("(?m)$"), "a\nb\n")
    case_all("^", "m", regex.generated("(?m)^"), "a\n\nb\n")
    case_find("a$", "", regex.generated("a$"), "a\n")
    case_find("a$", "", regex.generated("a$"), "a\n\n")
