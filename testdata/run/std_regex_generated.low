import std/regex
import std/text

fn esc(s: str) -> str {
    if s.len > 64 {
        return "{esc(s[..32])}...({s.len} bytes)"
    }
    s |> text.replace("\n", "\\n") |> text.replace("\r", "\\r") |> text.replace("\t", "\\t")
}

fn show(m: regex.Match, groups: i64) -> str {
    var out = "{m.start()}..{m.end()} [{esc(m.text())}]"
    for g in 1..groups + 1 {
        let part = match m.span(g) {
            some(s) => "{g}={s.start}..{s.end}"
            none => "{g}=-"
        }
        out = "{out} {part}"
    }
    out
}

fn show_found(found: regex.Match?, groups: i64) -> str {
    match found {
        some(m) => show(m, groups)
        none => "none"
    }
}

fn case_find(pattern: str, spec: str, re: regex.Regex, input: str) {
    print("find /{esc(pattern)}/{spec} [{esc(input)}]")
    print("  {show_found(re.find(input), re.group_count())}")
}

fn case_full(pattern: str, spec: str, re: regex.Regex, input: str) {
    print("full /{esc(pattern)}/{spec} [{esc(input)}]")
    print("  {show_found(re.full_match(input), re.group_count())}")
}

fn case_test(pattern: str, spec: str, re: regex.Regex, input: str) {
    print("test /{esc(pattern)}/{spec} [{esc(input)}]")
    print("  {re.is_match(input)}")
}

fn case_all(pattern: str, spec: str, re: regex.Regex, input: str) {
    print("all /{esc(pattern)}/{spec} [{esc(input)}]")
    for m in re.find_all(input) {
        print("  {show(m, re.group_count())}")
    }
}

fn case_sub(pattern: str, spec: str, re: regex.Regex, input: str, with: str) {
    print("sub /{esc(pattern)}/{spec} [{esc(input)}] [{esc(with)}]")
    let out = re.replace_all(input, fn(m: regex.Match) -> str { with })
    print("  [{esc(out)}]")
}

fn case_wrap(pattern: str, spec: str, re: regex.Regex, input: str) {
    print("wrap /{esc(pattern)}/{spec} [{esc(input)}]")
    let out = re.replace_all(input, fn(m: regex.Match) -> str { "<{m.text()}:{m.start()}>" })
    print("  [{esc(out)}]")
}

fn case_split(pattern: str, spec: str, re: regex.Regex, input: str, max: i64) {
    print("split /{esc(pattern)}/{spec} [{esc(input)}] {max}")
    let parts = if max < 0 { re.split(input) } else { re.split_n(input, max) }
    for p in parts {
        print("  [{esc(p)}]")
    }
}

fn main() {
    case_find("(a+)(b)?", "", regex.generated("(a+)(b)?"), "xxaab")
    case_find("(a+)(b)?", "", regex.generated("(a+)(b)?"), "xxaac")
    case_find("(a)|(b)", "", regex.generated("(a)|(b)"), "b")
    case_find("(a)?b", "", regex.generated("(a)?b"), "b")
    case_find("(a*)+", "", regex.generated("(a*)+"), "b")
    case_find("(a*)*", "", regex.generated("(a*)*"), "b")
    case_find("(a|b)*", "", regex.generated("(a|b)*"), "abc")
    case_find("((a)|b)+", "", regex.generated("((a)|b)+"), "ab")
    case_find("(a|ab)(c|bcd)(d*)", "", regex.generated("(a|ab)(c|bcd)(d*)"), "abcd")
    case_find("(?:(a)|(b)|(c))+", "", regex.generated("(?:(a)|(b)|(c))+"), "abcab")
    case_find("()", "", regex.generated("()"), "x")
    case_full("(a)(?:x(b))?(c)?", "", regex.generated("(a)(?:x(b))?(c)?"), "a")
    case_full("(a+)(a*)", "", regex.generated("(a+)(a*)"), "aaaa")
    case_full("(a+?)(a*)", "", regex.generated("(a+?)(a*)"), "aaaa")
    case_full("(a|ab)(c|bcd)(d*)", "", regex.generated("(a|ab)(c|bcd)(d*)"), "abcd")
    case_full("a|ab", "", regex.generated("a|ab"), "ab")
    case_find("a|ab", "", regex.generated("a|ab"), "ab")
    case_find("ab|a", "", regex.generated("ab|a"), "ab")
    case_find("(?:a|ab)c", "", regex.generated("(?:a|ab)c"), "abc")
    case_find("a+", "", regex.generated("a+"), "baaa")
    case_find("a+?", "", regex.generated("a+?"), "baaa")
    case_find("a*?b", "", regex.generated("a*?b"), "aaab")
    case_find("<.+>", "", regex.generated("<.+>"), "<a><b>")
    case_find("<.+?>", "", regex.generated("<.+?>"), "<a><b>")
    case_find("a{{2,4}}", "", regex.generated("a{{2,4}}"), "aaaaa")
    case_find("a{{2,4}}?", "", regex.generated("a{{2,4}}?"), "aaaaa")
    case_find("a{{2,}}?", "", regex.generated("a{{2,}}?"), "aaaaa")
