extern "c" {
    fn malloc(n: i64) -> ptr
    fn free(p: ptr)
}

struct Node {
    value: i64
    next: *Node?
}

fn churn() {
    for i in 0..300000 {
        let junk = new(Node { value: i, next: none })
    }
}

fn stash(slot: ptr[ptr]) {
    let node = new(Node { value: 4242, next: none })
    store(slot, pin(node))
}

fn main() {
    let slot: ptr[ptr] = malloc(8)
    defer free(slot)
    stash(slot)
    churn()
    let held: ptr[Node] = load(slot)
    print(load(held).value)
    unpin(load(slot))
}
