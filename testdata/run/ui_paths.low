import std/ui
import std/ui/font
import std/ui/geometry

fn total(b: font.Bitmap) -> i64 {
    var sum = 0
    for c in b.coverage {
        sum += i64(c)
    }
    sum
}

fn rows(b: font.Bitmap) -> str {
    var out = ""
    for y in 0..b.height {
        for x in 0..b.width {
            out += match b.coverage[y * b.width + x] {
                255 => "#"
                0 => "."
                _ => "+"
            }
        }
        out += "\n"
    }
    out
}

fn square(x: f32, y: f32, side: f32) -> geometry.Path {
    var p = geometry.path()
    p.move_to(geometry.point(x, y))
    p.line_to(geometry.point(x + side, y))
    p.line_to(geometry.point(x + side, y + side))
    p.line_to(geometry.point(x, y + side))
    p.close()
    p
}

fn fills() {
    print("fills")
    let whole = font.fill(geometry.flatten(square(1.0, 2.0, 3.0), 1.0), geometry.FillRule.NonZero)
    print("whole {whole.left} {whole.top} {whole.width}x{whole.height} {total(whole)}")
    print(rows(whole))
    let half = font.fill(geometry.flatten(square(0.5, 0.0, 2.0), 1.0), geometry.FillRule.NonZero)
    print("half {half.left} {half.width}x{half.height} {total(half)}")
    print(rows(half))
    var hole = square(0.0, 0.0, 4.0)
    hole.move_to(geometry.point(1.0, 1.0))
    hole.line_to(geometry.point(1.0, 3.0))
    hole.line_to(geometry.point(3.0, 3.0))
    hole.line_to(geometry.point(3.0, 1.0))
    hole.close()
    print(rows(font.fill(geometry.flatten(hole, 1.0), geometry.FillRule.NonZero)))
    var twice = square(0.0, 0.0, 2.0)
    twice.move_to(geometry.point(1.0, 0.0))
    twice.line_to(geometry.point(3.0, 0.0))
    twice.line_to(geometry.point(3.0, 2.0))
    twice.line_to(geometry.point(1.0, 2.0))
    twice.close()
    print(rows(font.fill(geometry.flatten(twice, 1.0), geometry.FillRule.NonZero)))
    let scaled = font.fill(geometry.flatten(square(1.0, 1.0, 2.0), 2.0), geometry.FillRule.NonZero)
    print("scaled {scaled.left} {scaled.top} {scaled.width}x{scaled.height} {total(scaled)}")
}

fn curves() {
    print("curves")
    var q = geometry.path()
    q.move_to(geometry.point(0.0, 0.0))
    q.quadratic_to(geometry.point(50.0, 100.0), geometry.point(100.0, 0.0))
    let qs = geometry.flatten(q, 1.0)
    let qp = qs[0]
    let mid = qp[qp.len / 2]
    print("quadratic contours {qs.len} points {qp.len} middle {mid.x} {mid.y}")
    var c = geometry.path()
    c.move_to(geometry.point(0.0, 0.0))
    c.cubic_to(geometry.point(0.0, 100.0), geometry.point(100.0, 100.0), geometry.point(100.0, 0.0))
    let cp = geometry.flatten(c, 1.0)[0]
    print("cubic points {cp.len} middle {cp[cp.len / 2].x} {cp[cp.len / 2].y}")
    var open = geometry.path()
    open.move_to(geometry.point(0.0, 0.0))
    open.line_to(geometry.point(10.0, 0.0))
    print("open line flattens to {geometry.flatten(open, 1.0).len}")
    let pen = font.fill(geometry.stroke(open, 2.0, 1.0), geometry.FillRule.NonZero)
    print("stroke {pen.left} {pen.top} {pen.width}x{pen.height}")
    print(rows(pen))
}

fn canvases(cx: ui.Context) {
    print("canvases")
    let view = fn() -> ui.Element {
        ui.div().size(200.0, 100.0).children() {
            ui.canvas(fn(mut p) {
                let b = p.bounds
                p.paint_path(square(b.x, b.y, 4.0), ui.rgb(0xff0000))
                p.paint_path(square(b.x + 10.0, b.y, 4.0), ui.rgb(0x00ff00))
                p.paint_stroke(square(b.x + 20.0, b.y, 4.0), 1.0, ui.rgb(0x0000ff))
                p.paint_underline(geometry.point(b.x, b.y + 10.0), 20.0, 1.0, ui.rgb(0x000000), false)
                p.paint_underline(geometry.point(b.x, b.y + 15.0), 20.0, 1.0, ui.rgb(0x000000), true)
            }).size(50.0, 20.0).margin(5.0)
        }
    }
    let s = cx.frame(view, geometry.size(200.0, 100.0), 1.0)
    for sp in s.sprites {
        print("sprite {sp.bounds.x} {sp.bounds.y} {sp.bounds.width} {sp.bounds.height} {sp.color.r} {sp.color.g} {sp.color.b}")
    }
    print("same tile {s.sprites[0].tile == s.sprites[1].tile}")
    for q in s.quads {
        print("quad {q.bounds.x} {q.bounds.y} {q.bounds.width} {q.bounds.height}")
    }
}

fn main() {
    fills()
    curves()
    canvases(ui.headless(ui.rgb(0xffffff)))
}
