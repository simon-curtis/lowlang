import std/simd

enum Fault {
    Odd(at: i64)
}

struct Cell {
    lanes: u32x8
    count: i64
}

struct Pair {
    low: u32x4
    high: u8x16
}

fn note(s: str) {
    print(s)
}

fn fib(n: i64) -> i64 {
    if n < 2 {
        return n
    }
    fib(n - 1) + fib(n - 2)
}

fn check(n: i64) -> i64 ! Fault {
    if n % 3 == 2 {
        fail Odd(n)
    }
    n * 2
}

fn through_error(n: i64) -> u32 ! Fault {
    var acc: u32x8 = simd.splat(u32(n))
    let step: u32x8 = simd.splat(3)
    acc += step
    let a = check(n)?
    acc += simd.splat(u32(a))
    let b = check(n + 1)?
    acc = acc + step * simd.splat(u32(b))
    let r: u32 = simd.lane(acc, 3)
    r
}

fn caught(n: i64) -> u32 {
    var acc: u32x8 = simd.splat(u32(n))
    let step: u32x8 = simd.splat(3)
    acc += step
    let a = check(n) catch {
        Odd(at) => at + 100
    }
    acc += simd.splat(u32(a))
    let b = check(n + 1) catch {
        Odd(at) => at + 200
    }
    acc = acc + step * simd.splat(u32(b))
    let r: u32 = simd.lane(acc, 5)
    r
}

fn errors() {
    for n in 0..6 {
        let got = through_error(n) catch {
            Odd(at) => u32(1000 + at)
        }
        print(got)
        print(caught(n))
    }
}

fn deferred(n: i64) -> u32 {
    var acc: u32x8 = simd.splat(1)
    defer {
        let seen: u32 = simd.lane(acc, 0)
        print(seen)
    }
    defer note("deferred exit")
    for k in 0..n {
        acc += simd.splat(u32(k))
        if k == 3 {
            let r: u32 = simd.lane(acc, 7)
            return r
        }
        let f = fib(k + 3)
        acc += simd.splat(u32(f))
    }
    let r: u32 = simd.lane(acc, 1)
    r
}

fn lane_call_loop() {
    var v: u32x8 = simd.splat(1)
    for i in 0..8 {
        v = simd.with_lane(v, i, u32(i * 7))
        let n = fib(i + 3)
        v += simd.splat(u32(n))
        let l: u32 = simd.lane(v, i)
        print(l)
    }
    print(v)
}

fn narrow_calls() {
    var a: u32x4 = simd.splat(2)
    var b: u8x16 = simd.splat(1)
    let step: u32x4 = simd.splat(5)
    let bump: u8x16 = simd.splat(3)
    for k in 0..5 {
        let n = fib(k + 4)
        a = a + step * a
        b += bump
        print(n)
        a += simd.splat(u32(n))
        b = simd.with_lane(b, k, u8(n))
    }
    print(a)
    print(b)
}

fn make(n: i64) -> u32x8 {
    simd.splat(u32(n * 11))
}

fn join(n: i64, seed: u32x8) -> u32x8 {
    var v = seed
    if n == 0 {
        v += simd.splat(5)
    } else if n < 2 {
        v = make(n + 2)
    } else if n % 2 == 0 {
        v = simd.with_lane(v, 2, u32(n * 50))
    } else {
        v = v + make(n)
    }
    v + simd.splat(1)
}

fn joins() {
    let seed: u32x8 = simd.splat(7)
    for n in 0..5 {
        print(join(n, seed))
    }
}

fn crowded_calls() -> u32x8 {
    let c0: u32x8 = simd.splat(1)
    let c1: u32x8 = simd.splat(2)
    let c2: u32x8 = simd.splat(3)
    let c3: u32x8 = simd.splat(4)
    let c4: u32x8 = simd.splat(5)
    let c5: u32x8 = simd.splat(6)
    let c6: u32x8 = simd.splat(7)
    let c7: u32x8 = simd.splat(8)
    let c8: u32x8 = simd.splat(9)
    let c9: u32x8 = simd.splat(10)
    var total: u32x8 = simd.splat(0)
    for i in 0..4 {
        let n = fib(i + 5)
        let x: u32x8 = simd.splat(u32(n))
        total += x * c0 + c1 * c2 - c3
        print(n)
        total += c4 * c5 + c6 - c7 + c8 * c9
    }
    total
}

fn cells() {
    var cell = Cell { lanes: simd.splat(4), count: 0 }
    for i in 0..4 {
        cell.lanes = cell.lanes + simd.splat(u32(fib(i + 4)))
        cell.count += 1
    }
    print(cell.lanes)
    print(cell.count)
    let heap = new(Cell { lanes: simd.splat(1), count: 0 })
    for i in 0..4 {
        heap.lanes = simd.with_lane(heap.lanes + heap.lanes, i, u32(fib(i + 2)))
        heap.count += 1
    }
    print(heap.lanes)
    print(heap.count)
    var pair = Pair { low: simd.splat(9), high: simd.splat(2) }
    for i in 0..3 {
        pair.low = pair.low + simd.splat(u32(fib(i + 5)))
        pair.high = pair.high + simd.splat(u8(fib(i + 3)))
    }
    print(pair.low)
    print(pair.high)
}

fn mixv(v: u32x8, k: u32) -> u32x8 {
    let a = simd.with_lane(v, 1, k)
    let b = simd.min(a, simd.splat(k + 7))
    let c = simd.max(b, simd.splat(u32(3)))
    let d = simd.blend(c > a, c, a)
    let l: u32 = simd.lane(d, 2)
    d + simd.splat(l)
}

fn walk(depth: i64, v: u32x8) -> u32 {
    if depth == 0 {
        return simd.lane(v, 0)
    }
    let c = mixv(mixv(mixv(v, u32(depth)), u32(depth * 3)), u32(depth * 5))
    let top: u32 = simd.lane(c, 4)
    walk(depth - 1, c) + top
}

fn main() {
    errors()
    print(deferred(2))
    print(deferred(6))
    lane_call_loop()
    narrow_calls()
    joins()
    print(crowded_calls())
    cells()
    print(walk(5000, simd.splat(u32(1))))
}
