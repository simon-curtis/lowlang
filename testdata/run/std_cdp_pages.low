import std/cdp
import std/header
import std/http
import std/io
import std/net
import std/text

fn handle(req: http.Request) -> http.Response {
    let html = header.Header { name: "content-type", value: "text/html" }
    http.Response { status: 200, headers: [html], body: bytes("<html><body>{req.path}</body></html>") }
}

fn serve(l: net.ListenerHandle) {
    for {
        let c = net.accept_handle(l) catch {
            _ => return
        }
        spawn http.serve_conn_on(c, handle)
    }
}

fn handlers(name: str, seen: chan[str]) -> cdp.Handlers {
    cdp.Handlers {
        request: fn(r: cdp.Request) -> cdp.Verdict {
            if r.resource == "Document" {
                seen <- "{name} {r.url}"
            }
            Continue
        }
        response: fn(url: str, status: i64) {}
        failure: fn(url: str, reason: str) {}
    }
}

fn visit(p: cdp.Page, base: str, path: str, seen: chan[str]) -> str {
    cdp.navigate(p, "{base}{path}", "") catch {
        _ => return "navigate failed"
    }
    select {
        s = <-seen => s ?? "closed"
        after(15000) => "none"
    }
}

fn main() ! io.Error {
    using l = net.listen("127.0.0.1", 0)?
    spawn serve(l.handle)
    let base = "http://127.0.0.1:{l.handle.addr.port}"
    using b = cdp.launch(cdp.Options { args: ["--disable-background-networking"] }) catch {
        _ => {
            print("launch failed")
            return
        }
    }
    let first = chan[str](8)
    let second = chan[str](8)
    let one = cdp.open_page(b, handlers("one", first)) catch {
        _ => {
            print("open one failed")
            return
        }
    }
    let two = cdp.open_page(b, handlers("two", second)) catch {
        _ => {
            print("open two failed")
            return
        }
    }
    print("different contexts: {one.context != two.context}")
    print(text.replace(visit(one, base, "/a", first), base, "BASE"))
    print(text.replace(visit(two, base, "/b", second), base, "BASE"))
    cdp.close_page(one) catch {
        _ => print("close failed")
    }
    print(text.replace(visit(two, base, "/c", second), base, "BASE"))
    let three = cdp.open_page(b, handlers("three", first)) catch {
        _ => {
            print("open three failed")
            return
        }
    }
    print(text.replace(visit(three, base, "/d", first), base, "BASE"))
    cdp.close_page(two) catch {
        _ => print("close failed")
    }
    cdp.close_page(three) catch {
        _ => print("close failed")
    }
    cdp.shutdown(b)
    net.close_listener(l)
}
