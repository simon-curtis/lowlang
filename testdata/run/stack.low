enum Shape {
    Rect(i64, i64)
    Empty
}

enum E {
    Bad(i64, i64)
}

fn area(s: Shape) -> i64 {
    match s {
        Rect(w, h) => w * h
        Empty => 0
    }
}

fn make(ok: bool) -> Shape ! E {
    if !ok { fail Bad(4, 5) }
    Shape.Rect(2, 3)
}

fn add3(a: i64, b: Shape, c: i64) -> i64 {
    a + area(b) + c
}

fn main() {
    var i = 0
    for {
        i += 1
        let v = add3(100, if i < 3 { continue } else { Shape.Rect(i, i) }, if i > 5 { break } else { 1 })
        print(v)
    }
    print(i)
    print(area(make(false) catch {
        Bad(a, b) => Shape.Rect(a, b)
    }))
    print(area(make(true) or Shape.Empty))
    let flag = true
    if flag { Shape.Empty } else { 1 }
    print(add3(1, Shape.Rect(2, 2), 3))
}
