import std/net/idna
import std/text

struct Case {
    source: str
    unicode: str
    unicode_status: []str
    ascii_n: str
    ascii_n_status: []str
    ascii_t: str
    ascii_t_status: []str
}

struct Counts {
    total: i64
    skipped: i64
    unicode: i64
    ascii_n: i64
    ascii_t: i64
}

fn unescape(field: str) -> str? {
    if field == "\"\"" {
        return ""
    }
    var out: []u8 = []
    var i = 0
    for i < field.len {
        if field[i] != '\\' {
            push(mut out, field[i])
            i += 1
            continue
        }
        var digits = ""
        if i + 5 < field.len && field[i + 1] == 'u' {
            digits = field[i + 2..i + 6]
            i += 6
        } else if i + 2 < field.len && field[i + 1] == 'x' && field[i + 2] == '{' {
            let close = text.index_byte(field[i..], '}')
            if close < 0 {
                return none
            }
            digits = field[i + 3..i + close]
            i += close + 1
        } else {
            return none
        }
        let c = text.parse_uint(digits, 16) or return none
        if !text.is_scalar(u32(c)) {
            return none
        }
        text.append_char(mut out, u32(c))
    }
    str(out)
}

fn statuses(field: str) -> []str {
    var out: []str = []
    let inner = text.trim_suffix(text.trim_prefix(field, "["), "]")
    for part in text.split(inner, ',') {
        let code = text.trim(part)
        if code != "" {
            push(mut out, code)
        }
    }
    out
}

fn parse_case(line: str) -> Case? {
    let fields = text.split(line, ';')
    var trimmed: []str = []
    for f in fields {
        push(mut trimmed, text.trim(f))
    }
    let source = unescape(trimmed[0]) ?? return none
    let unicode = if trimmed[1] == "" { source } else { unescape(trimmed[1]) ?? return none }
    let unicode_status = statuses(trimmed[2])
    let ascii_n = if trimmed[3] == "" { unicode } else { unescape(trimmed[3]) ?? return none }
    let ascii_n_status = if trimmed[4] == "" { unicode_status } else { statuses(trimmed[4]) }
    let ascii_t = if trimmed[5] == "" { ascii_n } else { unescape(trimmed[5]) ?? return none }
    let ascii_t_status = if trimmed[6] == "" { ascii_n_status } else { statuses(trimmed[6]) }
    Case { source, unicode, unicode_status, ascii_n, ascii_n_status, ascii_t, ascii_t_status }
}

fn code(e: idna.Error) -> str {
    match e {
        NotNormalized => "V1"
        HyphensInThirdAndFourth => "V2"
        HyphenAtEdge => "V3"
        AcePrefix => "V4"
        ContainsDot => "V5"
        LeadingMark => "V6"
        DisallowedCodePoint => "V7"
        AsciiRule => "U1"
        InvalidPunycode => "P4"
        BidiStart => "B1"
        BidiRtlCharacter => "B2"
        BidiRtlEnd => "B3"
        BidiMixedDigits => "B4"
        BidiLtrCharacter => "B5"
        BidiLtrEnd => "B6"
        ZwnjContext => "C1"
        ZwjContext => "C2"
        EmptyLabel => "X4_2"
        PunycodeEncoding => "A3"
        DomainLength => "A4_1"
        LabelLength => "A4_2"
    }
}

fn contains(codes: []str, c: str) -> bool {
    for x in codes {
        if x == c {
            return true
        }
    }
    false
}

fn error_agrees(got: idna.Error?, expected: []str) -> bool {
    match got {
        some(e) => contains(expected, code(e))
        none => expected.len == 0
    }
}

fn unicode_agrees(c: Case) -> bool {
    let got = idna.to_unicode(c.source, idna.Options {})
    got.text == c.unicode && error_agrees(got.error, c.unicode_status)
}

fn ascii_agrees(c: Case, transitional: bool, expected: str, expected_status: []str) -> bool {
    let o = idna.Options { transitional }
    var failure: idna.Error? = none
    let got = idna.to_ascii(c.source, o) catch {
        e => {
            failure = e
            ""
        }
    }
    if !error_agrees(failure, expected_status) {
        return false
    }
    failure != none || got == expected
}

fn run_case(line: str, c: Case, mut counts: Counts, mut shown: i64) {
    let unicode_ok = unicode_agrees(c)
    let ascii_n_ok = ascii_agrees(c, false, c.ascii_n, c.ascii_n_status)
    let ascii_t_ok = ascii_agrees(c, true, c.ascii_t, c.ascii_t_status)
    counts.unicode += if unicode_ok { 1 } else { 0 }
    counts.ascii_n += if ascii_n_ok { 1 } else { 0 }
    counts.ascii_t += if ascii_t_ok { 1 } else { 0 }
    if (!unicode_ok || !ascii_n_ok || !ascii_t_ok) && shown < 40 {
        shown += 1
        print("failed: {line} [{unicode_ok} {ascii_n_ok} {ascii_t_ok}]")
    }
}

fn main() {
    var counts = Counts { total: 0, skipped: 0, unicode: 0, ascii_n: 0, ascii_t: 0 }
    var shown = 0
    for line in text.lines(embed("std_idna_conformance.txt")) {
        if line == "" || line[0] == '#' {
            continue
        }
        counts.total += 1
        match parse_case(line) {
            some(c) => run_case(line, c, mut counts, mut shown)
            none => {
                counts.skipped += 1
            }
        }
    }
    let run = counts.total - counts.skipped
    print("lines {counts.total} skipped {counts.skipped}")
    print("to_unicode {counts.unicode}/{run}")
    print("to_ascii nontransitional {counts.ascii_n}/{run}")
    print("to_ascii transitional {counts.ascii_t}/{run}")
}
