"a," -> 2: expected a selector
",a" -> 0: expected a selector
"" -> 0: expected a selector
"  " -> 2: expected a selector
"a$" -> 1: unexpected "$"
"a b$" -> 3: unexpected "$"
"." -> 1: expected an identifier after .
"#" -> 1: expected an identifier after #
".1" -> 1: expected an identifier after .
"a#1" -> 2: expected an identifier after #
":" -> 0: expected a pseudo-class name
"::before" -> 0: pseudo-elements are not supported
":hover" -> 0: unknown pseudo-class :hover
"a:Hover" -> 1: unknown pseudo-class :hover
":nth-child" -> 0: unknown pseudo-class :nth-child
":nth-child(" -> 11: expected an+b
":nth-child()" -> 11: expected an+b
":nth-child(n" -> 0: unterminated :nth-child(
":nth-child(2n+)" -> 14: expected a number after the sign
":nth-child(2 n)" -> 13: expected )
":nth-child(1.5)" -> 12: expected )
":nth-child(2n+1 of)" -> 18: expected a selector after of
":nth-child(2n+1 ofp)" -> 16: expected )
":nth-of-type(1 of p)" -> 15: expected )
":not()" -> 5: expected a selector
":not(" -> 5: expected a selector
":not(p" -> 0: unterminated :not(
":not(p,)" -> 7: expected a selector
":has()" -> 5: expected a selector
":has(> )" -> 7: expected a selector
":has(:has(a))" -> 5: :has() cannot be nested in :has()
":has(:not(:has(a)))" -> 10: :has() cannot be nested in :has()
":first-child()" -> 0: unknown pseudo-class :first-child
"svg|a" -> 3: namespace prefixes are not supported
"*|a" -> 1: namespace prefixes are not supported
"a[ns|b]" -> 4: namespace prefixes are not supported
"a:is(p, !, span)" -> ok
