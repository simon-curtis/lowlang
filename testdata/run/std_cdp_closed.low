import std/cdp
import std/io

fn describe(r: fn() ! cdp.Error) -> str {
    r() catch {
        Closed => return "Closed"
        Timeout => return "Timeout"
        Protocol(_) => return "Protocol"
        Launch(_) => return "Launch"
    }
    "ok"
}

fn main() ! io.Error {
    using b = cdp.launch(cdp.Options { args: ["--disable-background-networking"] }) catch {
        _ => {
            print("launch failed")
            return
        }
    }
    let h = b.handle
    let handlers = cdp.Handlers {
        request: fn(r: cdp.Request) -> cdp.Verdict { Continue }
        response: fn(url: str, status: i64) {}
        failure: fn(url: str, reason: str) {}
    }
    print("before shutdown: {describe(fn() ! cdp.Error { cdp.call(h.connection, "", "Browser.getVersion", [])? })}")
    let stop = fn() { cdp.shutdown_on(h) }
    stop()
    stop()
    cdp.shutdown(b)
    print("call after shutdown: {describe(fn() ! cdp.Error { cdp.call(h.connection, "", "Browser.getVersion", [])? })}")
    print("open page after shutdown: {describe(fn() ! cdp.Error { cdp.open_page_on(h, handlers)? })}")
}
