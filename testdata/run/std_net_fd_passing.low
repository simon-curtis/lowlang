import std/io
import std/net
import std/sys

fn pipe_ends() -> sys.Pair {
    sys.pipe(false) or panic("pipe failed")
}

fn read_text(fd: i64) -> str {
    let buf = io.buffer(32)
    let n = sys.read(fd, buf) or panic("read failed")
    str(buf[..n])
}

fn single_descriptor() ! io.Error {
    using pair = net.socketpair()?
    let ends = pipe_ends()
    let sent = net.write_with_fds(pair.first, bytes("hello"), [ends.first])?
    print("sent {sent}")
    sys.close_fd(ends.first)

    let buf = io.buffer(16)
    let got = net.read_with_fds(pair.second, buf)?
    print("received {got.size} bytes {str(buf[..got.size])} with {got.fds.len} descriptor")
    sys.write_all(ends.second, bytes("through the pipe"))?
    print(read_text(got.fds[0]))
    sys.close_fd(got.fds[0])
    sys.close_fd(ends.second)
}

fn several_descriptors() ! io.Error {
    using pair = net.socketpair()?
    let a = pipe_ends()
    let b = pipe_ends()
    net.write_with_fds(pair.first, bytes("x"), [a.first, b.first])?
    let buf = io.buffer(4)
    let got = net.read_with_fds(pair.second, buf)?
    print("descriptors {got.fds.len}")
    sys.write_all(a.second, bytes("first"))?
    sys.write_all(b.second, bytes("second"))?
    print("{read_text(got.fds[0])} {read_text(got.fds[1])}")
    for fd in [a.first, a.second, b.first, b.second, got.fds[0], got.fds[1]] {
        sys.close_fd(fd)
    }
}

fn plain_data_carries_none() ! io.Error {
    using pair = net.socketpair()?
    net.write_all(pair.first, bytes("plain"))?
    let buf = io.buffer(16)
    let got = net.read_with_fds(pair.second, buf)?
    print("plain {got.size} {got.fds.len}")
    net.write_with_fds(pair.first, bytes("empty list"), [])?
    let again = net.read_with_fds(pair.second, buf)?
    print("empty {again.size} {again.fds.len}")
}

fn end_of_input() ! io.Error {
    using pair = net.socketpair()?
    net.close(pair.first)
    let buf = io.buffer(4)
    let got = net.read_with_fds(pair.second, buf)?
    print("end {got.size} {got.fds.len}")
}

fn outcome(c: net.Conn, fds: []i64) -> str {
    net.write_with_fds(c, bytes("x"), fds) catch {
        Invalid => return "invalid"
        NotConnected => return "not connected"
        BrokenPipe => return "broken pipe"
        Reset => return "broken pipe"
        _ => return "other error"
    }
    "sent"
}

fn too_many() ! io.Error {
    using pair = net.socketpair()?
    var fds: []i64 = []
    for _ in 0..254 {
        push(mut fds, 0)
    }
    print("254 descriptors: {outcome(pair.first, fds)}")
    print("253 descriptors: {outcome(pair.first, fds[..253])}")
}

fn closed_connection() ! io.Error {
    using pair = net.socketpair()?
    net.close(pair.first)
    let ends = pipe_ends()
    print("closed: {outcome(pair.first, [ends.first])}")
    sys.close_fd(ends.first)
    sys.close_fd(ends.second)
}

fn peer_gone() ! io.Error {
    using pair = net.socketpair()?
    net.close(pair.second)
    let ends = pipe_ends()
    print("peer gone: {outcome(pair.first, [ends.first])}")
    sys.close_fd(ends.first)
    sys.close_fd(ends.second)
}

fn read_on_view(h: net.ConnHandle, buf: []u8) -> net.FdRead ! io.Error {
    net.read_with_fds_on(h, buf)?
}

fn read_outcome(h: net.ConnHandle, buf: []u8) -> str {
    let got = read_on_view(h, buf) catch {
        TimedOut => return "timed out"
        NotConnected => return "not connected"
        _ => return "other error"
    }
    "read {got.size}"
}

fn views() ! io.Error {
    using var pair = net.socketpair()?
    let first = net.detach(mut pair.first)
    let second = net.detach(mut pair.second)
    let ends = pipe_ends()
    let sent = net.write_with_fds_on(first, bytes("view"), [ends.first])?
    print("sent {sent}")
    let buf = io.buffer(16)
    let got = read_on_view(second, buf)?
    print("received {str(buf[..got.size])} with {got.fds.len} descriptor")
    sys.write_all(ends.second, bytes("via views"))?
    print(read_text(got.fds[0]))
    for fd in [ends.first, ends.second, got.fds[0]] {
        sys.close_fd(fd)
    }
    second.timeouts.read = 50
    print("idle: {read_outcome(second, buf)}")
    net.close_on(first)
    net.close_on(second)
    print("closed: {read_outcome(second, buf)}")
}

fn main() ! io.Error {
    views()?
    single_descriptor()?
    several_descriptors()?
    plain_data_carries_none()?
    end_of_input()?
    too_many()?
    closed_connection()?
    peer_gone()?
}
