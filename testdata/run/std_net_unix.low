import std/file
import std/io
import std/net
import std/os
import std/text

fn listen_outcome(path: str) -> str {
    using l = net.listen_unix(path) catch {
        AddrInUse => return "in use"
        Invalid => return "invalid"
        _ => return "other"
    }
    "listening"
}

fn dial_outcome(path: str) -> str {
    using c = net.connect_unix(path) catch {
        NotFound => return "not found"
        Refused => return "refused"
        _ => return "other"
    }
    "connected"
}

fn echo_once(c: net.Conn) ! io.Error {
    let buf = io.buffer(32)
    let n = net.read(c, buf)?
    net.write_all(c, buf[..n])?
}

fn pathname(dir: str) ! io.Error {
    let path = "{dir}/echo.sock"
    using l = net.listen_unix(path)?
    print("listening on path {l.handle.addr.path == path}")
    print("socket file exists {file.exists(path)}")
    print("formatted {net.format(l.handle.addr) == "unix:{path}"}")

    using client = net.connect_unix(path)?
    using server = net.accept(l)?
    print("client remote {client.handle.remote.path == path}")
    print("server remote unnamed {server.handle.remote.path.len == 0}")

    net.write_all(client, bytes("hello unix"))?
    echo_once(server)?
    let buf = io.buffer(32)
    let n = net.read(client, buf)?
    print(str(buf[..n]))

    let creds = net.peer_credentials(client)?
    print("peer uid {creds.uid == os.uid()} gid {creds.gid == os.gid()} pid {creds.pid == os.pid()}")
    let seen = net.peer_credentials(server)?
    print("server sees uid {seen.uid == os.uid()}")

    using again = net.listen_unix(path) catch {
        AddrInUse => {
            print("second listener in use")
            return
        }
        _ => {
            print("second listener other")
            return
        }
    }
    net.close_listener(again)
    print("second listener bound")
}

fn removal(dir: str) ! io.Error {
    let path = "{dir}/gone.sock"
    using listener = net.listen_unix(path)?
    let h = listener.handle
    let blocked = chan[str](1)
    spawn fn() {
        net.accept_handle(h) catch {
            NotConnected => {
                blocked <- "accept woke with NotConnected"
                return
            }
            _ => {
                blocked <- "accept woke with another error"
                return
            }
        }
        blocked <- "accepted"
    }()
    sleep(50)
    print("before close {file.exists(path)}")
    net.close_listener(listener)
    print((<-blocked) ?? "")
    print("after close {file.exists(path)}")
    net.close_listener(listener)
    print(dial_outcome(path))
}

fn abstract_names() ! io.Error {
    let name = "@lowlang-net-unix-{os.pid()}"
    using l = net.listen_unix(name)?
    print("abstract addr {l.handle.addr.path == name}")
    using client = net.connect_unix(name)?
    using server = net.accept(l)?
    net.write_all(client, bytes("abstract"))?
    echo_once(server)?
    let buf = io.buffer(32)
    let n = net.read(client, buf)?
    print(str(buf[..n]))

    let nul = "\0lowlang-net-unix-nul-{os.pid()}"
    using l2 = net.listen_unix(nul)?
    print("nul form normalised {l2.handle.addr.path == "@{nul[1..]}"}")
    using c2 = net.connect_unix(nul)?
    using s2 = net.accept(l2)?
    print("nul form connected {net.peer_credentials(c2)?.uid == os.uid()}")

    print(listen_outcome(name))
}

fn invalid_paths() {
    let long = text.repeat("x", 120)
    for p in ["", long] {
        print(listen_outcome(p))
    }
}

fn pair() ! io.Error {
    using p = net.socketpair()?
    net.write_all(p.first, bytes("left"))?
    let buf = io.buffer(16)
    var n = net.read(p.second, buf)?
    print(str(buf[..n]))
    net.write_all(p.second, bytes("right"))?
    n = net.read(p.first, buf)?
    print(str(buf[..n]))
    print("pair uid {net.peer_credentials(p.first)?.uid == os.uid()}")

    let reader = p.first.handle
    let done = chan[i64](1)
    spawn fn() {
        let scratch = io.buffer(8)
        let got = net.read_on(reader, scratch) catch {
            _ => -1
        }
        done <- got
    }()
    sleep(20)
    net.shutdown_write(p.second)?
    print("eof after shutdown {(<-done) ?? -2}")
}

fn reuse_port() ! io.Error {
    let shared = net.ListenOptions { reuse_port: true }
    using a = net.listen_with("127.0.0.1", 0, shared)?
    let port = a.handle.addr.port
    using b = net.listen_with("127.0.0.1", port, shared)?
    print("two listeners share the port {b.handle.addr.port == port}")
    using plain = net.listen("127.0.0.1", port) catch {
        AddrInUse => {
            print("plain listener refused")
            return
        }
        _ => {
            print("plain listener other")
            return
        }
    }
    net.close_listener(plain)
    print("plain listener accepted")
}

fn tuning() ! io.Error {
    using l = net.listen("127.0.0.1", 0)?
    using c = net.connect(l.handle.addr)?
    using s = net.accept(l)?
    net.set_keepalive(c, 30, 7, 4)?
    let k = net.keepalive(c)?
    print("keepalive {k.enabled} {k.idle} {k.interval} {k.count}")
    net.set_keepalive(c, 0, 0, 0)?
    print("keepalive off {!net.keepalive(c)?.enabled}")
    net.set_buffer_sizes(c, 65536, 32768)?
    let sizes = net.buffer_sizes(c)?
    print("buffers {sizes.receive >= 65536} {sizes.send >= 32768}")
    using u = net.bind_udp("127.0.0.1", 0)?
    net.set_socket_buffer_sizes(u, 65536, 0)?
    print("udp buffers {net.socket_buffer_sizes(u)?.receive >= 65536}")
}

fn multicast() ! io.Error {
    let group = net.parse_ip("239.255.42.99")?
    using receiver = net.bind_udp("0.0.0.0", 0)?
    net.join_group(receiver, group, "lo") catch {
        _ => {
            print("multicast unavailable")
            return
        }
    }
    using sender = net.bind_udp("127.0.0.1", 0)?
    net.set_multicast_interface(sender, "lo")?
    net.set_multicast_ttl(sender, 1)?
    net.set_multicast_loop(sender, true)?
    net.set_receive_timeout(receiver, 500)
    let target = net.Addr { ip: group, port: receiver.handle.addr.port }
    net.send_to(sender, bytes("to the group"), target)?
    let buf = io.buffer(32)
    let p = net.receive_from(receiver, buf) catch {
        _ => {
            print("multicast unavailable")
            return
        }
    }
    print("received {str(buf[..p.size])}")

    net.leave_group(receiver, group, "lo")?
    net.send_to(sender, bytes("after leaving"), target)?
    let late = net.receive_from(receiver, buf) catch {
        TimedOut => net.Packet { size: -1, from: target }
        _ => net.Packet { size: -2, from: target }
    }
    print("after leave {late.size}")
    net.join_group(receiver, net.parse_ip("10.0.0.1")?, "lo") catch {
        Invalid => print("rejects unicast group")
        _ => print("other")
    }
}

fn main() ! io.Error {
    let dir = file.temp_dir("lowunix")?
    pathname(dir)?
    removal(dir)?
    abstract_names()?
    invalid_paths()
    pair()?
    reuse_port()?
    tuning()?
    multicast()?
    file.remove_all(dir)?
}
