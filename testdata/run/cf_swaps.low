fn fibonacci(n: i64) -> i64 {
    var a = 0
    var b = 1
    for i in 0..n {
        let t = a + b
        a = b
        b = t
    }
    a
}

fn swap_pairs(n: i64) -> i64 {
    var a = 1
    var b = 2
    for i in 0..n {
        let t = a
        a = b
        b = t
    }
    a * 10 + b
}

fn rotate_three(n: i64) -> i64 {
    var a = 1
    var b = 2
    var c = 3
    for i in 0..n {
        let t = a
        a = b
        b = c
        c = t
    }
    a * 100 + b * 10 + c
}

fn rotate_six(n: i64) -> i64 {
    var a = 1
    var b = 2
    var c = 3
    var d = 4
    var e = 5
    var f = 6
    for i in 0..n {
        let t = a
        a = b
        b = c
        c = d
        d = e
        e = f
        f = t
    }
    a * 100000 + b * 10000 + c * 1000 + d * 100 + e * 10 + f
}

fn conditional_swap(n: i64) -> i64 {
    var lo = 10
    var hi = 3
    var steps = 0
    for i in 0..n {
        if lo > hi {
            let t = lo
            lo = hi
            hi = t
        } else {
            lo = lo + i
        }
        steps += 1
    }
    lo * 1000 + hi + steps
}

fn swap_with_counter(n: i64) -> i64 {
    var x = 7
    var y = 9
    var i = 0
    for i < n {
        let t = x
        x = y + i
        y = t
        i += 1
    }
    x * 1000 + y
}

fn bubble(xs: []i64) -> i64 {
    var swapped = true
    var passes = 0
    for swapped {
        swapped = false
        for i in 1..xs.len {
            if xs[i - 1] > xs[i] {
                let t = xs[i - 1]
                xs[i - 1] = xs[i]
                xs[i] = t
                swapped = true
            }
        }
        passes += 1
    }
    passes
}

fn main() {
    print(fibonacci(0))
    print(fibonacci(1))
    print(fibonacci(50))
    print(swap_pairs(0))
    print(swap_pairs(1))
    print(swap_pairs(1001))
    print(rotate_three(0))
    print(rotate_three(1))
    print(rotate_three(2))
    print(rotate_three(3))
    print(rotate_three(100))
    print(rotate_six(1))
    print(rotate_six(4))
    print(rotate_six(6))
    print(rotate_six(1000001))
    print(conditional_swap(1))
    print(conditional_swap(10))
    print(swap_with_counter(5))
    print(swap_with_counter(100))
    var xs = [5, 2, 9, 1, 7, 3, 8]
    print(bubble(xs))
    print(xs[0] * 1000000 + xs[1] * 100000 + xs[2] * 10000 + xs[3] * 1000 + xs[4] * 100 + xs[5] * 10 + xs[6])
}
