import std/crypto/hash
import std/text

fn show(data: []u8) {
    print(text.encode_hex(hash.sum(hash.sha1(), data)))
}

fn main() {
    show(bytes(""))
    show(bytes("abc"))
    show(bytes("The quick brown fox jumps over the lazy dog"))
    show(bytes("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"))
    var long: []u8 = []
    for i in 0..1000 {
        push(mut long, u8(i * 7))
    }
    for n in [55, 56, 57, 63, 64, 65, 119, 120, 128, 1000] {
        show(long[..n])
    }
    let d = hash.sha1().digest()
    d.update(long[..100])
    let snapshot = d.clone()
    d.update(long[100..])
    print(text.encode_hex(d.finish()) == text.encode_hex(hash.sum(hash.sha1(), long)))
    snapshot.update(long[100..])
    print(text.encode_hex(snapshot.finish()) == text.encode_hex(d.finish()))
    let early = hash.sha1().digest()
    early.update(bytes("ab"))
    let first = early.finish()
    early.update(bytes("c"))
    print(text.encode_hex(first))
    print(text.encode_hex(early.finish()))
    print(hash.sha1().name)
    print(hash.sha1().size)
    print(hash.sha1().block)
    print(text.encode_hex(hash.hmac(hash.sha1(), bytes("Jefe"), bytes("what do ya want for nothing?"))))
    print(text.encode_hex(hash.hmac(hash.sha1(), bytes("key"), bytes("The quick brown fox jumps over the lazy dog"))))
}
