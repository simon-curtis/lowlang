import std/os
import std/process
import std/testing

fn test_pass(t: *testing.T) {
    t.equal(1 + 1, 2)
}

fn test_fail(t: *testing.T) {
    t.error("something broke")
}

fn test_skip(t: *testing.T) {
    t.skip("not today")
}

fn test_subtests(t: *testing.T) {
    t.sub("a", fn(st) { st.log("in a") })
    t.sub("b", fn(st) { st.log("in b") })
}

fn tests() -> []testing.Test {
    [
        testing.Test { name: "pass", run: test_pass, file: "testing_protocol.low", line: 6 }
        testing.Test { name: "fail", run: test_fail }
        testing.Test { name: "skip", run: test_skip }
        testing.Test { name: "subtests", run: test_subtests }
    ]
}

fn invoke(program: str, args: []str) {
    print("$ {args}")
    let output = process.run(process.command(program, args), []) catch {
        e => {
            print("error: {e}")
            return
        }
    }
    match output.status {
        Exited(code) => print("status {code}")
        Signaled(_) => print("signaled")
    }
    print(str(output.stdout))
}

fn main() {
    if os.args().len > 1 {
        testing.run(tests())
        return
    }
    let program = os.executable() catch {
        e => {
            print("error: {e}")
            return
        }
    }
    invoke(program, ["-list"])
    invoke(program, ["-one", "pass", "-notime"])
    invoke(program, ["-one", "fail", "-notime"])
    invoke(program, ["-one", "skip", "-notime", "-v"])
    invoke(program, ["-one", "subtests", "-run", "subtests/b", "-v", "-notime"])
    invoke(program, ["-one", "missing"])
    invoke(program, ["-timeout", "0", "-notime"])
}
