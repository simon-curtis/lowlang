import std/markdown

fn table_size(r: markdown.Renderer, table: markdown.Table) -> str {
    "<p>table {table.header.len}x{table.rows.len}</p>\n"
}

fn heading_id(r: markdown.Renderer, level: i64, raw: str, inner: str) -> str {
    "<h{level} data-raw=\"{markdown.escape_html(raw)}\">{inner}</h{level}>\n"
}

fn tagged_code(r: markdown.Renderer, lang: str, code: str) -> str {
    "<pre lang=\"{lang}\">{markdown.escape_html(code)}</pre>\n"
}

fn loud_span(r: markdown.Renderer, code: str) -> str {
    "<kbd>{markdown.escape_html(code)}</kbd>"
}

fn drop_comments(r: markdown.Renderer, source: str) -> str {
    if source == "<!-- drop -->" { "" } else { markdown.default_html_block(r, source) }
}

fn visible_tag(r: markdown.Renderer, source: str) -> str {
    markdown.escape_html(source)
}

fn main() {
    let source = "# Title with `code`\n\n<!-- drop -->\n\n<!-- keep -->\n\n```low\nlet a = 1 < 2\n```\n\n    indented\n\n| a | b |\n|---|---|\n| 1 | 2 |\n\nText with `span` here.\n\n> ## Quoted *heading*\n"
    let renderer = markdown.Renderer {
        heading: heading_id,
        code_block: tagged_code,
        code_span: loud_span,
        html_block: drop_comments,
        html_inline: visible_tag,
        table: table_size,
    }
    print(markdown.render(renderer, markdown.parse(source)))
    print(markdown.render_inline(renderer, markdown.parse_inline("a `b` *c `d` <i>e</i>*")))
}
