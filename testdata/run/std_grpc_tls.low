import std/crypto/x509
import std/grpc
import std/net
import std/tls

struct Say {
    text: str "1"
    n: i64 "2"
}

fn roots() -> x509.Certificate[] {
    var out: x509.Certificate[] = []
    for der in x509.pem_certificates(embed("std_tls_ca.pem")) {
        out.push(x509.parse(der) or return out)
    }
    out
}

fn echo(ctx: *grpc.Context, req: Say) -> Say ! grpc.Error {
    Say { text: "secure {req.text}", n: req.n }
}

fn chat(ctx: *grpc.Context) ! grpc.Error {
    for {
        let next = grpc.read[Say](ctx)?
        match next {
            some(m) => grpc.write[Say](ctx, Say { text: "re {m.text}", n: m.n + 1 })?
            none => break
        }
    }
}

fn run(s: *grpc.Server, l: net.ListenerHandle) {
    grpc.serve_tls_on(s, l) or {}
}

fn unary_over(ch: grpc.Channel, label: str, timeout: i64) {
    let r = grpc.unary[Say, Say](ch, "/t.S/Echo", Say { text: "x", n: 4 }, grpc.CallOptions { timeout, retry: false }) catch {
        e => {
            print("{label} {grpc.describe(e)}")
            return
        }
    }
    print("{label} {r.value.text} {r.value.n}")
}

fn bidi_over(ch: grpc.Channel) {
    let st = grpc.bidi_streaming(ch, "/t.S/Chat", grpc.CallOptions {}) catch {
        e => {
            print("bidi failed {grpc.describe(e)}")
            return
        }
    }
    defer grpc.close_stream(st)
    for i in 0..3 {
        grpc.send[Say](st, Say { text: "m{i}", n: i }) catch {
            e => {
                print("bidi send failed {grpc.describe(e)}")
                return
            }
        }
        let back = grpc.receive[Say](st) catch {
            e => {
                print("bidi receive failed {grpc.describe(e)}")
                return
            }
        }
        match back {
            some(m) => print("bidi {m.text} {m.n}")
            none => print("bidi ended")
        }
    }
    let closed = grpc.close_send(st) or false
    print("bidi closed {closed}")
}

fn main() {
    let pem = embed("std_tls_ec.pem")
    let key = x509.pem_private_key(pem) or {
        print("no key")
        return
    }
    let config = tls.Config { certificates: x509.pem_certificates(pem), key }
    using l = net.listen("127.0.0.1", 0) or {
        print("listen failed")
        return
    }
    let s = grpc.server(grpc.ServerOptions { tls: config })
    grpc.handle_unary[Say, Say](s, "/t.S/Echo", echo)
    grpc.handle_bidi_streaming(s, "/t.S/Chat", chat)
    spawn run(s, l.handle)
    let port = l.handle.addr.port
    let trusted = grpc.dial("https://localhost:{port}", grpc.ChannelOptions { roots: roots() }) or {
        print("dial failed")
        return
    }
    unary_over(trusted, "trusted", 5000)
    unary_over(trusted, "reused", 5000)
    bidi_over(trusted)
    let untrusted = grpc.dial("https://localhost:{port}", grpc.ChannelOptions {}) or return
    unary_over(untrusted, "untrusted", 5000)
    let plain = grpc.dial("localhost:{port}", grpc.ChannelOptions {}) or return
    unary_over(plain, "plaintext to tls", 300)
    let insecure = grpc.dial("https://127.0.0.1:{port}", grpc.ChannelOptions { insecure: true }) or return
    unary_over(insecure, "insecure", 5000)
    grpc.close_channel(trusted)
    grpc.close_channel(untrusted)
    grpc.close_channel(plain)
    grpc.close_channel(insecure)
    grpc.shutdown(s, 0)
    print("shut down")
}
