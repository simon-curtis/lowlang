fn twice(x: f64) -> f64 {
    x * 2.0
}

fn twice_left(x: f64) -> f64 {
    2.0 * x
}

fn twice32(x: f32) -> f32 {
    x * 2.0
}

fn twice_left32(x: f32) -> f32 {
    2.0 * x
}

fn half(x: f64) -> f64 {
    x * 0.5
}

fn thrice(x: f64) -> f64 {
    x * 3.0
}

fn negative_two(x: f64) -> f64 {
    x * -2.0
}

fn square(x: f64) -> f64 {
    x * x
}

fn sum_self(x: f64) -> f64 {
    x + x
}

fn chain(x: f64) -> f64 {
    x * 2.0 * 2.0 + x * 2.0
}

fn bits(x: f64) -> str {
    if x != x {
        "nan"
    } else if x == 0.0 {
        if 1.0 / x < 0.0 { "-0" } else { "+0" }
    } else {
        "{x}"
    }
}

fn bits32(x: f32) -> str {
    if x != x {
        "nan"
    } else if x == 0.0 {
        if 1.0 / x < 0.0 { "-0" } else { "+0" }
    } else {
        "{x}"
    }
}

fn in_loop(xs: []f64) -> f64 {
    var t = 0.0
    for i in 0..xs.len {
        t += xs[i] * 2.0
    }
    t
}

fn main() {
    let inf = 1.0 / 0.0
    let nan = sqrt(-1.0)
    let values: []f64 = [0.0, -0.0, 1.0, -1.5, 0.1, 1.7976931348623157e308, -1.7976931348623157e308, 5e-324, inf, -inf, nan, 123456.789]
    for v in values {
        print("{bits(v)} {bits(twice(v))} {bits(twice_left(v))} {bits(half(v))} {bits(thrice(v))} {bits(negative_two(v))} {bits(square(v))} {bits(sum_self(v))} {bits(chain(v))}")
    }
    let small: []f32 = [0.0, -0.0, 1.0, -1.5, 0.1, 3.4028235e38, -3.4028235e38, 1e-45, f32(inf), f32(-inf), f32(nan)]
    for v in small {
        print("{bits32(v)} {bits32(twice32(v))} {bits32(twice_left32(v))}")
    }
    print(in_loop(values[2..7]))
    print(in_loop([0.5, 0.25, 0.125]))
}
