import std/text
import std/unicode

fn code(token: str) -> u32 {
    u32(text.parse_uint(token, 16) or 0)
}

fn check(line: str) -> bool {
    var expected: []i64 = []
    var whole: []u8 = []
    for token in text.fields(line) {
        if token == "÷" {
            push(mut expected, whole.len)
        } else if token != "×" {
            text.append_char(mut whole, code(token))
        }
    }
    let input = str(whole)
    push(mut expected, input.len)
    let got = unicode.line_breaks(input)
    if got.len != expected.len {
        return false
    }
    for i, b in got {
        if b.at != expected[i] {
            return false
        }
    }
    got[got.len - 1].mandatory
}

fn show(s: str) {
    var parts: []str = []
    for b in unicode.line_breaks(s) {
        push(mut parts, if b.mandatory { "{b.at}!" } else { "{b.at}" })
    }
    print("{text.join(parts, " ")}")
}

fn build(cs: []u32) -> str {
    var out: []u8 = []
    for c in cs {
        text.append_char(mut out, c)
    }
    str(out)
}

fn main() {
    var total = 0
    var failed = 0
    for line in text.lines(embed("std_unicode_line_breaks.txt")) {
        if line == "" {
            continue
        }
        total += 1
        if !check(line) {
            failed += 1
            print("failed: {line}")
        }
    }
    print("cases {total} failed {failed}")

    show("")
    show("x")
    show("hello world")
    show("a  b   c")
    show("one\ntwo\r\nthree\n")
    show("a-b c-d")
    show("-a")
    show("e.g. (see) [1]")
    show("$12.50 and 3,000 (approx.) 5%")
    show(build(['d', 'o', 'n', '\'', 't', ' ', 's', 0x2028, 'n', 0x2029]))
    show(build(['a', 0x200B, 'b', ' ', 0x200B, ' ', 'c']))
    show(build(['a', 0x2060, 'b', 0xA0, 'c', ' ', 'd']))
    show("\"quoted text\" and 'it'")
    show(build([0x65E5, 0x672C, 0x8A9E, 0x3002, 0x300C, 0x3042, 0x3041, 0x300D]))
    show(build([0x1F1EF, 0x1F1F5, 0x1F1FA, 0x1F1F8, 0x1F1EB, 0x1F1F7, 0x1F1E9]))
    show(build([0x1F468, 0x200D, 0x1F469, 0x200D, 0x1F467, 'x']))
    show(build([0x1F44D, 0x1F3FD, ' ', 'x']))
    show(build(['a', 0x301, ' ', 0x301, 'b']))
    show(build([0x1100, 0x1161, 0x11A8, 0x1112, 0x1161, 0x11AB]))
    show(build([0x915, 0x94D, 0x937, ' ', 0x915]))
    show("a/b/c http://x.y/z")
    show("(a) 「b」")
    show(build(['1', '.', '5', ' ', '2', 0x2014, '3', ' ', 'x', 0x2026, 'y']))
}
