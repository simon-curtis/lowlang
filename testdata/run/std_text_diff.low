import std/text
import std/text/diff

fn op_name(op: diff.Op) -> str {
    match op {
        Equal => "="
        Insert => "+"
        Delete => "-"
    }
}

fn show_edits(edits: []diff.Edit) {
    var parts: []str = []
    for e in edits {
        push(mut parts, "{op_name(e.op)}{e.old_at}.{e.new_at}")
    }
    print(text.join(parts, " "))
}

fn show(name: str, a: str, b: str, ctx: i64) {
    print("== {name}")
    let u = diff.unified(a, b, ctx, "a", "b")
    if u == "" {
        print("(identical)")
    } else {
        print(u)
    }
}

fn applies(a: str, b: str, ctx: i64) -> bool {
    let u = diff.unified(a, b, ctx, "a", "b")
    if u == "" {
        return a == b
    }
    let patched = diff.patch(a, u) or "failed"
    patched == b
}

fn numbered(n: i64, prefix: str) -> str {
    var rows: []str = []
    for i in 1..n + 1 {
        push(mut rows, "{prefix}{i}")
    }
    "{text.join(rows, "\n")}\n"
}

fn edit_script() {
    show_edits(diff.diff([1, 2, 3, 4], [1, 3, 5, 4]))
    show_edits(diff.diff(["a", "b"], ["a", "b"]))
    let none_after: []i64 = []
    show_edits(diff.diff([1, 2], none_after))
    show_edits(diff.diff(none_after, [7, 8]))
    show_edits(diff.diff_by(["Apple", "pear"], ["apple", "plum"], fn(x: str, y: str) -> bool { text.equal_fold(x, y) }))
    let myers = diff.diff(bytes("ABCABBA"), bytes("CBABAC"))
    print(diff.distance(myers))
    show_edits(diff.diff_lines("x\ny\nz\n", "x\nz\nw"))
    let moved = diff.diff_lines("a\nb\nc\nd\n", "d\nc\nb\na\n")
    print(diff.distance(moved))
}

fn unified_cases() {
    let ten = numbered(10, "line ")
    show("change", "a\nb\nc\n", "a\nx\nc\n", 3)
    show("identical", ten, ten, 3)
    show("new file", "", "a\nb\nc\n", 3)
    show("deleted file", "a\nb\n", "", 3)
    show("single line replaced", "old\n", "new\n", 3)
    show("single line added to empty", "", "a\n", 3)
    show("single line removed", "a\n", "", 3)
    show("insert only", "a\nc\n", "a\nb\nc\n", 3)
    show("no newline at end replaced", "a\nb", "a\nc", 3)
    show("no newline added", "a\nb", "a\nb\n", 3)
    show("no newline removed", "a\nb\n", "a\nb", 3)
    show("no newline unchanged", "a\nb", "a\nb\nc", 3)
    show("both no newline, same tail", "x\ny\nz", "w\ny\nz", 3)
    show("empty to no newline", "", "a", 3)
    show("no newline to empty", "a", "", 3)
    show("blank lines", "\n\n\n", "\n", 3)
    let a = numbered(20, "n")
    var b = a
    b = text.replace(b, "n5\n", "five\n")
    b = text.replace(b, "n17\n", "seventeen\n")
    show("two hunks gap 11", a, b, 3)
    let c = text.replace(text.replace(a, "n5\n", "A\n"), "n12\n", "B\n")
    show("gap 6 ctx 3 merges", a, c, 3)
    show("gap 6 ctx 2 splits", a, c, 2)
    let d = text.replace(text.replace(a, "n5\n", "A\n"), "n11\n", "B\n")
    show("gap 5 ctx 2 splits", a, d, 2)
    show("gap 5 ctx 3 merges", a, d, 3)
    show("ctx 0", a, c, 0)
    show("ctx 1", a, c, 1)
    show("adjacent changes ctx 0", "a\nb\nc\nd\n", "a\nX\nY\nd\n", 0)
    show("pure insert ctx 0", "a\nb\n", "a\nX\nb\n", 0)
    show("pure delete ctx 0", "a\nX\nb\n", "a\nb\n", 0)
    show("start and end", "a\nb\nc\nd\ne\nf\ng\nh\n", "A\nb\nc\nd\ne\nf\ng\nH\n", 1)
    show("crlf", "a\r\nb\r\n", "a\r\nc\r\n", 3)
    show("unicode", "héllo\nwörld\n", "héllo\nwórld\n", 3)
    show("tab and space", "a\tb\n c\n", "a\tb\n  c\n", 3)
}

fn round_trips() {
    let a = numbered(30, "r")
    let b = text.replace(text.replace(a, "r4\n", ""), "r20\n", "r20\nextra\nlines\n")
    var ok = 0
    for ctx in 0..6 {
        if applies(a, b, ctx) {
            ok += 1
        }
    }
    print("round trips {ok}/6")
    print(applies("", "a\nb", 3))
    print(applies("a\nb", "", 3))
    print(applies("a", "a\n", 1))
    print(applies("a\n", "a", 1))
}

fn patch_text(a: str, p: str) -> str {
    diff.patch(a, p) catch {
        Malformed(line) => "malformed at line {line}"
        Mismatch(hunk) => "mismatch in hunk {hunk}"
    }
}

fn patch_cases() {
    let base = numbered(40, "p")
    let edited = text.replace(text.replace(base, "p10\n", "ten\n"), "p30\n", "thirty\n")
    let u = diff.unified(base, edited, 2, "a", "b")
    let shifted = "head 1\nhead 2\nhead 3\n{base}"
    print(patch_text(shifted, u) == "head 1\nhead 2\nhead 3\n{edited}")
    var trimmed = base
    for i in 0..5 {
        trimmed = text.trim_prefix(trimmed, "p{i + 1}\n")
    }
    let drifted = text.replace(text.replace(trimmed, "p10\n", "ten\n"), "p30\n", "thirty\n")
    print(patch_text(trimmed, u) == drifted)
    print(patch_text(base, u) == edited)
    let altered = text.replace(base, "p10\n", "changed\n")
    print(patch_text(altered, u))
    print(patch_text("", u))
    print(patch_text("{base}", "garbage\nonly\n") == base)
    print(patch_text(base, "@@ -1,2 +1,2 @@\n p1\n-p2\n") )
    print(patch_text(base, "@@ nope @@\n"))
    print(patch_text(base, "@@ -1 +1 @@\n*p1\n"))
    var far = ""
    for i in 0..30 {
        far = "{far}pad {i}\n"
    }
    let moved_far = "{far}{base}"
    let expected_far = text.replace(text.replace(moved_far, "p10\n", "ten\n"), "p30\n", "thirty\n")
    print(patch_text(moved_far, u) == expected_far)
    let within = diff.patch_within(moved_far, u, 100) or "failed"
    print(within == expected_far)
    let narrow = diff.patch_within(moved_far, u, 5) catch {
        Malformed(line) => "malformed"
        Mismatch(hunk) => "mismatch {hunk}"
    }
    print(narrow)
    let zero = "@@ -0,0 +1,2 @@\n+first\n+second\n"
    print(patch_text("", zero) == "first\nsecond\n")
    let appended = "@@ -2,0 +3 @@\n+three\n"
    print(patch_text("one\ntwo\n", appended) == "one\ntwo\nthree\n")
    let blank_context = "@@ -1,3 +1,3 @@\n a\n\n-c\n+d\n"
    print(patch_text("a\n\nc\n", blank_context) == "a\n\nd\n")
    let trailing = "--- a\n+++ b\n@@ -1,2 +1,2 @@\n a\n-b\n+c\n-- \n2.40\n"
    print(patch_text("a\nb\n", trailing) == "a\nc\n")
}

fn stats_cases() {
    let s = diff.stats("a\nb\nc\nd\n", "a\nx\nc\nd\ne\n")
    print("{s.added} {s.removed} {s.unchanged}")
    print(text.fixed(diff.similarity("a\nb\nc\nd\n", "a\nx\nc\nd\ne\n"), 4))
    print(text.fixed(diff.similarity("", ""), 2))
    print(text.fixed(diff.similarity("a\n", "b\n"), 2))
    print(text.fixed(diff.similarity("a\nb\n", "a\nb\n"), 2))
    print(diff.distance(diff.diff_lines("a\nb\nc\n", "c\nb\na\n")))
}

fn spans(label: str, a: str, b: str) {
    let marked = diff.inline_markup(diff.inline(a, b))
    print("{label}: {marked}")
}

fn char_spans(label: str, a: str, b: str) {
    let marked = diff.inline_markup(diff.inline_chars(a, b))
    print("{label}: {marked}")
}

fn inline_cases() {
    spans("words", "the quick brown fox", "the slow brown dog")
    spans("append", "hello", "hello world")
    spans("punctuation", "a, b; c", "a, d; c!")
    spans("identical", "same text", "same text")
    spans("empty", "", "new")
    spans("whitespace", "a  b", "a b")
    spans("unicode", "héllo wörld", "héllo wórld")
    char_spans("chars", "kitten", "sitting")
    char_spans("combining", "éa", "ea")
    char_spans("emoji", "a👍🏽b", "a👍b")
    print(text.join(diff.words("foo_bar  baz,qux-1.5"), "|"))
    let spans_of = diff.inline("one two", "one three")
    var kinds: []str = []
    for sp in spans_of {
        push(mut kinds, "{op_name(sp.op)}{sp.text}")
    }
    print(text.join(kinds, "|"))
    let marks = diff.inline_with(spans_of, "<del>", "</del>", "<ins>", "</ins>")
    print(marks)
}

struct Lcg {
    state: u64
}

fn next(mut g: Lcg, bound: i64) -> i64 {
    g.state = g.state * 6364136223846793005 + 1442695040888963407
    i64(g.state >> 33) % bound
}

fn generated() {
    var g = Lcg { state: 12345 }
    var old: []str = []
    for i in 0..400 {
        push(mut old, "row {next(mut g, 60)}")
    }
    var cur = old
    for step in 0..70 {
        let at = next(mut g, cur.len)
        if next(mut g, 2) == 0 {
            var rest: []str = []
            for i, row in cur {
                if i != at {
                    push(mut rest, row)
                }
            }
            cur = rest
        } else {
            var grown: []str = []
            for i, row in cur {
                if i == at {
                    push(mut grown, "ins {next(mut g, 60)}")
                }
                push(mut grown, row)
            }
            cur = grown
        }
    }
    let a = "{text.join(old, "\n")}\n"
    let b = "{text.join(cur, "\n")}\n"
    let edits = diff.diff_lines(a, b)
    let s = diff.stats_of(edits)
    print("lines {old.len} {cur.len} distance {diff.distance(edits)} added {s.added} removed {s.removed}")
    for ctx in 0..5 {
        let u = diff.unified(a, b, ctx, "a", "b")
        let parts = diff.hunks(edits, ctx)
        var rows = 0
        for r in text.lines(u) {
            rows += 1
        }
        let back = diff.patch(a, u) or "failed"
        print("ctx {ctx} hunks {parts.len} rows {rows} patch {back == b}")
    }
    let first = diff.unified(a, b, 1, "a", "b")
    let head = text.lines(first)
    print(text.join(head[..6], "\n"))
}

fn main() {
    edit_script()
    unified_cases()
    round_trips()
    patch_cases()
    stats_cases()
    inline_cases()
    generated()
}
