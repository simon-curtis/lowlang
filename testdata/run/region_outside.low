struct Tally {
    hits: i64
    label: str
    names: str[]
}

fn main() {
    let t = new(Tally { hits: 0, label: "first", names: ["a", "b"] })
    var total = 0
    var label = ""
    var last: str? = some("x")
    var names: str[] = []
    let n = region {
        let scratch = "scratch {t.hits}"
        total += scratch.len
        t.hits += 1
        label = t.label
        names = t.names[1..]
        last = none
        t.label = "second"
        scratch.len
    }
    print("{n} {total} {t.hits} {label} {names.len} {last == none} {t.label}")
}
