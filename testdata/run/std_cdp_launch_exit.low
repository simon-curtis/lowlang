import std/cdp
import std/file
import std/io
import std/time

fn describe(e: cdp.Error) -> str {
    match e {
        Launch(cause) => match cause {
            TimedOut => "Launch(TimedOut)"
            Aborted => "Launch(Aborted)"
            Eof => "Launch(Eof)"
            NotFound => "Launch(NotFound)"
            _ => "Launch(other)"
        }
        Protocol(_) => "Protocol"
        Closed => "Closed"
        Timeout => "Timeout"
    }
}

fn attempt(label: str, executable: str, startup: i64) {
    let start = time.monotonic()
    using b = cdp.launch(cdp.Options { executable, startup }) catch {
        e => {
            let millis = (time.monotonic() - start) / 1000000
            print("{label}: {describe(e)} within 5s {millis < 5000}")
            return
        }
    }
    print("{label}: launched")
}

fn main() ! io.Error {
    let dir = file.temp_dir("low-cdp-exit-")?
    let lingering = "{dir}/lingering"
    file.write_file_mode(lingering, bytes("#!/bin/sh\nsleep 60 &\nexit 1\n"), 0o755)?
    let quiet = "{dir}/quiet"
    file.write_file_mode(quiet, bytes("#!/bin/sh\nexit 1\n"), 0o755)?
    let silent = "{dir}/silent"
    file.write_file_mode(silent, bytes("#!/bin/sh\nexec sleep 30\n"), 0o755)?
    let closed = "{dir}/closed"
    file.write_file_mode(closed, bytes("#!/bin/sh\nexec 2>&-\nexec sleep 30\n"), 0o755)?
    attempt("exits while a child holds stderr", lingering, 20000)
    attempt("exits", quiet, 20000)
    attempt("missing", "{dir}/absent", 20000)
    attempt("announces nothing", silent, 400)
    attempt("closes stderr", closed, 20000)
    file.remove_all(dir)?
}
