import std/cdp
import std/file
import std/io
import std/time

fn describe(e: cdp.Error) -> str {
    match e {
        Launch(cause) => match cause {
            TimedOut => "Launch(TimedOut)"
            NotFound => "Launch(NotFound)"
            _ => "Launch(other)"
        }
        Protocol(_) => "Protocol"
        Closed => "Closed"
        Timeout => "Timeout"
    }
}

fn attempt(label: str, executable: str) {
    let start = time.monotonic()
    using b = cdp.launch(cdp.Options { executable, startup: 20000 }) catch {
        e => {
            let millis = (time.monotonic() - start) / 1000000
            print("{label}: {describe(e)} within 5s {millis < 5000}")
            return
        }
    }
    print("{label}: launched")
}

fn main() ! io.Error {
    let dir = file.temp_dir("low-cdp-exit-")?
    let lingering = "{dir}/lingering"
    file.write_file_mode(lingering, bytes("#!/bin/sh\nsleep 60 &\nexit 1\n"), 0o755)?
    let quiet = "{dir}/quiet"
    file.write_file_mode(quiet, bytes("#!/bin/sh\nexit 1\n"), 0o755)?
    attempt("exits while a child holds stderr", lingering)
    attempt("exits", quiet)
    attempt("missing", "{dir}/absent")
    file.remove_all(dir)?
}
