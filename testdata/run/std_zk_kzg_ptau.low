import std/crypto/zk/kzg
import std/crypto/zk/pairing
import std/text

struct Counts {
    pass: i64
    bad: i64
}

struct Suite {
    name: str
    curve: *pairing.Curve
    ptau: []u8
}

fn record(counts: *Counts, ok: bool, label: str) {
    if ok {
        counts.pass += 1
    } else {
        counts.bad += 1
        print("FAIL {label}")
    }
}

fn unhex(s: str) -> []u8 {
    text.decode_hex(s) catch { _ => return [] }
}

fn scalar(c: *pairing.Curve, hex: str) -> []u64 {
    let padded = "{text.repeat("0", 64 - hex.len)}{hex}"
    pairing.fr_from_bytes(c, unhex(padded)) catch { _ => return pairing.fr_zero(c) }
}

fn coefficients(c: *pairing.Curve, csv: str) -> [][]u64 {
    var out: [][]u64 = []
    for part in text.split(csv, ',') {
        push(mut out, scalar(c, part))
    }
    out
}

fn point(g: *pairing.Group, hex: str) -> pairing.Point {
    pairing.decode_evm(g, unhex(hex)) catch { _ => return pairing.identity(g) }
}

fn hex_of(g: *pairing.Group, p: pairing.Point) -> str {
    text.encode_hex(pairing.encode_evm(g, p))
}

fn error_name(e: kzg.Error) -> str {
    match e {
        Truncated => "Truncated"
        Magic => "Magic"
        Unsupported => "Unsupported"
        Malformed => "Malformed"
        Size => "Size"
        Length => "Length"
        Point(p) => "Point"
    }
}

fn load_outcome(c: *pairing.Curve, data: []u8, size: i64) -> str {
    let srs = kzg.srs_from_ptau(c, data, size) catch { e => return error_name(e) }
    "ok {srs.g1.len}"
}

fn open_case(counts: *Counts, k: Suite, srs: kzg.Srs, f: []str) {
    let c = k.curve
    let g1 = pairing.g1(c)
    let coeffs = coefficients(c, f[2])
    let z = scalar(c, f[3])
    let label = "{k.name} open {f[2]} at {f[3]}"
    let commitment = kzg.commit(srs, coeffs) catch { _ => return record(counts, false, label) }
    record(counts, hex_of(g1, commitment) == f[5], "{label} commitment")
    let secret = kzg.commit_secret(srs, coeffs) catch { _ => return record(counts, false, label) }
    record(counts, pairing.equal(g1, commitment, secret), "{label} constant-time commitment")
    let opening = kzg.open(srs, coeffs, z) catch { _ => return record(counts, false, label) }
    record(counts, text.encode_hex(pairing.fr_bytes(c, opening.value)) == f[4], "{label} value")
    record(counts, hex_of(g1, opening.proof) == f[6], "{label} proof")
    let secret_opening = kzg.open_secret(srs, coeffs, z) catch { _ => return record(counts, false, label) }
    record(counts, pairing.equal(g1, opening.proof, secret_opening.proof), "{label} constant-time proof")
    let decoded = point(g1, f[6])
    record(counts, kzg.verify(srs.verifier, point(g1, f[5]), z, scalar(c, f[4]), decoded), "{label} verifies")
}

fn wrong_case(counts: *Counts, k: Suite, srs: kzg.Srs, f: []str) {
    let c = k.curve
    let g1 = pairing.g1(c)
    let ok = kzg.verify(srs.verifier, point(g1, f[2]), scalar(c, f[3]), scalar(c, f[4]), point(g1, f[5]))
    record(counts, !ok, "{k.name} wrong value {f[3]} {f[4]}")
}

fn srs_case(counts: *Counts, k: Suite, srs: kzg.Srs, f: []str) {
    let c = k.curve
    let g1 = pairing.g1(c)
    let count = text.parse_int(f[2]) catch { _ => return record(counts, false, "count") }
    record(counts, srs.g1.len == 16, "{k.name} loaded powers")
    let full = kzg.srs_from_ptau(c, k.ptau, count) catch { _ => return record(counts, false, "{k.name} full load") }
    record(counts, hex_of(g1, full.g1[1]) == f[3], "{k.name} first power")
    record(counts, hex_of(g1, full.g1[count - 1]) == f[4], "{k.name} last power")
    record(counts, load_outcome(c, k.ptau, count + 1) == "Size", "{k.name} one power too many")
}

fn tau2_case(counts: *Counts, k: Suite, srs: kzg.Srs, f: []str) {
    let g2 = pairing.g2(k.curve)
    record(counts, hex_of(g2, srs.verifier.tau_g2) == f[2], "{k.name} tau times H")
}

fn flipped(data: []u8, at: i64) -> []u8 {
    var out: []u8 = []
    for i in 0..data.len {
        push(mut out, if i == at { data[i] ^ 1 } else { data[i] })
    }
    out
}

fn rejections(counts: *Counts, k: Suite) {
    let c = k.curve
    let data = k.ptau
    let n8 = c.n * 8
    let g1_start = 48 + n8
    let g2_start = g1_start + 31 * 2 * n8 + 12
    record(counts, load_outcome(c, data, 16) == "ok 16", "{k.name} loads")
    record(counts, load_outcome(c, data, 31) == "ok 31", "{k.name} loads every power")
    record(counts, load_outcome(c, data, 32) == "Size", "{k.name} too many")
    record(counts, load_outcome(c, data, 0) == "Size", "{k.name} none")
    record(counts, load_outcome(c, data[..0], 4) == "Truncated", "{k.name} empty")
    record(counts, load_outcome(c, data[..11], 4) == "Truncated", "{k.name} short header")
    record(counts, load_outcome(c, data[..40], 4) == "Truncated", "{k.name} cut in the header section")
    record(counts, load_outcome(c, data[..g1_start + 100], 4) == "Truncated", "{k.name} cut in the G1 section")
    record(counts, load_outcome(c, data[..data.len - 1], 4) == "Truncated", "{k.name} one byte short")
    record(counts, load_outcome(c, flipped(data, 0), 4) == "Magic", "{k.name} magic")
    record(counts, load_outcome(c, flipped(data, 4), 4) == "Unsupported", "{k.name} version")
    record(counts, load_outcome(c, flipped(data, 24), 4) == "Malformed", "{k.name} element width")
    record(counts, load_outcome(c, flipped(data, 28), 4) == "Malformed", "{k.name} prime")
    record(counts, load_outcome(c, flipped(data, g1_start + 3 * 2 * n8 + 5), 8) == "Point", "{k.name} G1 point off the curve")
    record(counts, load_outcome(c, flipped(data, g2_start + 1 * 4 * n8 + 5), 4) == "Point", "{k.name} G2 point off the curve")
}

fn main() {
    let counts = new(Counts { pass: 0, bad: 0 })
    let suites = [
        Suite { name: "bn254", curve: pairing.bn254(), ptau: bytes(embed("std_zk_kzg_small_bn128.ptau")) }
        Suite { name: "bls12381", curve: pairing.bls12_381(), ptau: bytes(embed("std_zk_kzg_small_bls12381.ptau")) }
    ]
    for k in suites {
        let srs = kzg.srs_from_ptau(k.curve, k.ptau, 16) or {
            print("{k.name} ptau failed")
            return
        }
        for line in text.lines(embed("std_zk_kzg_ptau.txt")) {
            let f = text.fields(line)
            if f.len < 3 || f[0] != k.name {
                continue
            }
            if f[1] == "open" {
                open_case(counts, k, srs, f)
            } else if f[1] == "wrong" {
                wrong_case(counts, k, srs, f)
            } else if f[1] == "srs" {
                srs_case(counts, k, srs, f)
            } else if f[1] == "tau2" {
                tau2_case(counts, k, srs, f)
            }
        }
        rejections(counts, k)
    }
    print("pass {counts.pass} bad {counts.bad}")
}
