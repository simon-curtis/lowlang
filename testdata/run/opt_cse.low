struct Cell {
    n: i64
    label: str
}

fn shared(a: i64, b: i64, n: i64) -> i64 {
    var total = 0
    for i in 0..n {
        let k = a * b + a
        total += k ^ i
        if i % 3 == 0 {
            total += a * b + a
        } else {
            total -= a * b - a
        }
        total += (a * b + a) >> 1
    }
    total
}

fn branches(a: i64, b: i64) -> i64 {
    let first = a * b + a
    var total = 0
    if first > 10 {
        total += a * b + a
        if a > 2 {
            total += (a * b + a) * 3
        }
    } else {
        total += a * b - a
    }
    for i in 0..3 {
        total += (a * b + a) * i
    }
    total + a * b + a
}

fn noisy(x: i64) -> i64 {
    var t = x
    for i in 0..5 {
        t = t * 31 + i
    }
    t
}

fn across_calls(a: i64, b: i64) -> i64 {
    let x = a * 7 + b
    let y = noisy(x)
    let z = a * 7 + b
    let w = noisy(y ^ z)
    x + y + z + w + (a * 7 + b)
}

fn churn(rounds: i64) -> i64 {
    var total = 0
    for r in 0..rounds {
        var junk: []i64 = []
        for k in 0..200 {
            push(mut junk, k * r)
        }
        total += junk[199]
    }
    total
}

fn make_cells(seed: i64) -> []Cell {
    [Cell { n: seed, label: "a" }, Cell { n: seed + 1, label: "b" }, Cell { n: seed + 2, label: "c" }, Cell { n: seed + 3, label: "d" }]
}

fn survive(seed: i64) -> i64 {
    let cells = make_cells(seed)
    let before = cells[2].n
    let noise = churn(4000)
    let after = cells[2].n
    let again = cells[2].n + cells[2].n
    before + after + again + noise
}

fn survive_loop(seed: i64) -> i64 {
    let cells = make_cells(seed)
    var total = 0
    for r in 0..40 {
        let first = cells[3].n
        total += churn(100)
        let second = cells[3].n
        total += first + second
    }
    total
}

fn worker(a: i64, b: i64, n: i64, expected: i64, out: chan[bool]) {
    out <- (shared(a, b, n) == expected)
}

fn main() {
    print(branches(5, 6))
    print(branches(1, 2))
    print(branches(2, 9))
    print(across_calls(3, 4))
    print(across_calls(0 - 9, 12))
    print(survive(10))
    print(survive_loop(100))

    let n = 8000000
    let expected = shared(7, 9, n)
    print(expected)
    let done = chan[bool](8)
    for w in 0..8 {
        spawn worker(7, 9, n, expected, done)
    }
    var matches = 0
    for w in 0..8 {
        if (<-done) ?? false {
            matches += 1
        }
    }
    print(matches)
}
