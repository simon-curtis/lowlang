fn main() {
    print("{36:##}|{0:##}|{0.5:#.##}|{0.5:0.##}|{2.5:0.##}|{2:0.##}|{3.14159:0.00}|{1234567.891:#,##0.00}|{5:000}")
    print("{1234567:#,###}|{1234567.5:#,##0.#}|{0.0:0.0}|{-1234.5:#,##0.00}|{12:0,000}|{1234:0,000}|{999:#,##0}")
    print("{-0.001:0.00}|{0.0005:0.###}|{0.0004:0.###}|{0.00049999:#.###}|{1e-20:0.##}|{5.0:#.##}|{100:#,#}")
    print("{1234.5678:00.0000}|{1234.5678:0.##}|{0.125:0.00}|{0.375:0.00}|{2.675:0.00}|{-2.5:0}|{0.5:0}|{1.5:0}")
    print("{1234567.0:#,#.0}|{1e15:#,##0}|{0.1:.0##}|{0.1:#.#}|{0.04:#.#}|{0.05:#.#}|{0.0:#.#}|{0.0:#}|{7:#.0}")
    let tiny: f32 = 1.4e-45
    let third: f32 = 0.3
    print("{third:0.##}|{third:0.00000000}|{third:0.0#######}|{tiny:0.###}|{16777217.0:#,#}")
}
