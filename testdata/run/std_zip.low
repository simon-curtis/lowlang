import std/archive
import std/archive/zip
import std/compress/deflate
import std/file
import std/hash
import std/io
import std/slices
import std/text

struct Raw {
    name: str
    body: []u8
    method: i64 = 0
    flags: i64 = 0
    crc: i64 = -1
    packed: i64 = -1
    size: i64 = -1
    offset: i64 = -1
    external: i64 = 0
    wide: bool = false
}

fn number(s: str, at: i64) -> i64 {
    var n = 0
    var i = at
    for s[i] >= '0' && s[i] <= '9' {
        n = n * 10 + i64(s[i] - '0')
        i += 1
    }
    n
}

fn unpack(s: str) -> []u8 {
    var out: []u8 = []
    var i = 0
    for i < s.len {
        if s[i] == '[' {
            for _ in 0..number(s, i + 1) {
                push(mut out, 0)
            }
            i = text.index_byte(s[i..], ']') + i + 1
        } else if s[i] == '(' {
            let value = u8(text.hex_digit(s[i + 1]) << 4 | text.hex_digit(s[i + 2]))
            for _ in 0..number(s, i + 4) {
                push(mut out, value)
            }
            i = text.index_byte(s[i..], ')') + i + 1
        } else {
            push(mut out, u8(text.hex_digit(s[i]) << 4 | text.hex_digit(s[i + 1])))
            i += 2
        }
    }
    out
}

fn reference() -> []u8 {
    unpack("504b03041400000008008f52655818b9f69e10000000280000000900000068656c6c6f2e747874cb48cdc9c957a8ca2c50c8c0c7e20200504b0304140000000000000021500bf9435606000000060000000a00000073746f7265642e74787473746f726564504b030414000000000000002150[12][11]80010000000068656c6c6f2e747874504b01021403140000000000000021500bf9435606000000060000000a[11]80013700000073746f7265642e747874504b0102140314000000000000002150[12]04[11]8001650000006469722f504b010214031400000008002541c752264c0bb71a0100000004000013[11]8001870000006469722f6e65737465642f66696c652e62696e504b01021403140000080800000021505f7fceca0b000000090000000a[11]8001d201000068c3a96c6c6f2e747874504b0102140314000000000000002150bbce6012090000000900000004[11]ffa1050200006c696e6b504b050600000000060006004c0100003002000009006120636f6d6d656e74")
}

fn descriptor() -> []u8 {
    unpack("504b0304140008000800a3204354[12]0c00000073747265616d65642e7478742b2e294a4dcc4d4d5148492c495428a6390f00504b07085fbf8a771300000070000000504b0304140008000000a3204354[12]09000000706c61696e2e74787473746f7265642073747265616d6564504b0708b547bd150f0000000f000000504b01021403140008000800a32043545fbf8a7713000000700000000c[11]80010000000073747265616d65642e747874504b01021403140008000000a3204354b547bd150f0000000f00000009[11]80014d000000706c61696e2e747874504b0506000000000200020071000000930000000000")
}

fn wide_local() -> []u8 {
    unpack("504b03042d0000000800a3204354d4320273(ff*8)08001400776964652e7478740100100050000000000000000f000000000000002bcf4c495548492c495428a70a0b00504b01022d032d0000000800a3204354d43202730f0000005000000008[11]800100000000776964652e747874504b0506000000000100010036000000490000000000")
}

fn error_name(e: io.Error) -> str {
    match e {
        Malformed => "Malformed"
        TooLarge => "TooLarge"
        Eof => "Eof"
        Denied => "Denied"
        Unsupported => "Unsupported"
        Invalid => "Invalid"
        NotFound => "NotFound"
        NotDir => "NotDir"
        IsDir => "IsDir"
        Exists => "Exists"
        _ => "other"
    }
}

fn method_name(m: zip.Method) -> str {
    match m {
        Stored => "stored"
        Deflate => "deflate"
        Other(code) => "other{code}"
    }
}

fn kind_name(k: zip.Kind) -> str {
    match k {
        File => "file"
        Dir => "dir"
        Symlink => "symlink"
    }
}

fn describe(e: zip.Entry) -> str {
    "{e.name} {kind_name(e.kind)} {method_name(e.method)} size={e.size} packed={e.compressed} mode={text.radix(e.mode, 8)} mtime={e.mtime} crc={e.crc}"
}

fn show(label: str, data: []u8, limits: zip.Limits) {
    let a = zip.open_with(data, limits) catch {
        e => {
            print("{label}: open {error_name(e)}")
            return
        }
    }
    print("{label}: {a.entries.len} entries comment={a.comment}")
    for e in a.entries {
        let body = zip.read(a, e) catch {
            err => {
                print("  {describe(e)} read {error_name(err)}")
                continue
            }
        }
        let shown = if body.len <= 24 { text.trim(str(body)) } else { "crc {hash.crc32(body)}" }
        print("  {describe(e)} body={body.len}:{shown}")
    }
}

fn plain(label: str, data: []u8) {
    show(label, data, zip.Limits {})
}

fn pick(v: i64, fallback: i64) -> i64 {
    if v < 0 { fallback } else { v }
}

fn raw_archive(entries: []Raw) -> []u8 {
    var out: []u8 = []
    var offsets: []i64 = []
    for r in entries {
        push(mut offsets, out.len)
        let crc = pick(r.crc, i64(hash.crc32(r.body)))
        let packed = pick(r.packed, r.body.len)
        let size = pick(r.size, r.body.len)
        io.put_le32(mut out, 0x04034b50)
        io.put_le16(mut out, 20)
        io.put_le16(mut out, r.flags)
        io.put_le16(mut out, r.method)
        io.put_le16(mut out, 0)
        io.put_le16(mut out, 0x21)
        io.put_le32(mut out, crc)
        io.put_le32(mut out, packed)
        io.put_le32(mut out, size)
        io.put_le16(mut out, r.name.len)
        io.put_le16(mut out, 0)
        text.append(mut out, r.name)
        io.append(mut out, r.body)
    }
    let start = out.len
    for i in 0..entries.len {
        let r = entries[i]
        let crc = pick(r.crc, i64(hash.crc32(r.body)))
        let packed = pick(r.packed, r.body.len)
        let size = pick(r.size, r.body.len)
        let offset = pick(r.offset, offsets[i])
        var extra: []u8 = []
        if r.wide {
            io.put_le16(mut extra, 1)
            io.put_le16(mut extra, 24)
            io.put_le64(mut extra, size)
            io.put_le64(mut extra, packed)
            io.put_le64(mut extra, offset)
        }
        io.put_le32(mut out, 0x02014b50)
        io.put_le16(mut out, 0x031E)
        io.put_le16(mut out, 20)
        io.put_le16(mut out, r.flags)
        io.put_le16(mut out, r.method)
        io.put_le16(mut out, 0)
        io.put_le16(mut out, 0x21)
        io.put_le32(mut out, crc)
        io.put_le32(mut out, if r.wide { 0xFFFFFFFF } else { packed })
        io.put_le32(mut out, if r.wide { 0xFFFFFFFF } else { size })
        io.put_le16(mut out, r.name.len)
        io.put_le16(mut out, extra.len)
        io.put_le16(mut out, 0)
        io.put_le16(mut out, 0)
        io.put_le16(mut out, 0)
        io.put_le32(mut out, r.external)
        io.put_le32(mut out, if r.wide { 0xFFFFFFFF } else { offset })
        text.append(mut out, r.name)
        io.append(mut out, extra)
    }
    let size = out.len - start
    io.put_le32(mut out, 0x06054b50)
    io.put_le16(mut out, 0)
    io.put_le16(mut out, 0)
    io.put_le16(mut out, entries.len)
    io.put_le16(mut out, entries.len)
    io.put_le32(mut out, size)
    io.put_le32(mut out, start)
    io.put_le16(mut out, 0)
    out
}

fn references() {
    plain("reference", reference())
    plain("descriptor", descriptor())
    plain("local zip64", wide_local())
    let a = zip.open(reference()) or return
    print(text.trim(str(zip.read_entry(a, "hello.txt") or bytes("failed"))))
    let missing = zip.read_entry(a, "absent") catch {
        e => {
            print("absent: {error_name(e)}")
            return
        }
    }
    print(missing.len)
}

fn corrupt() {
    let hello = bytes("hello")
    plain("valid", raw_archive([Raw { name: "a", body: hello }]))
    plain("bad crc", raw_archive([Raw { name: "a", body: hello, crc: 12345 }]))
    plain("stored mismatch", raw_archive([Raw { name: "a", body: hello, size: 6 }]))
    let ten = deflate.compress(bytes("aaaaaaaaaa"), 6)
    plain("deflate exact", raw_archive([Raw { name: "a", body: ten, method: 8, size: 10, crc: i64(hash.crc32(bytes("aaaaaaaaaa"))) }]))
    plain("deflate longer", raw_archive([Raw { name: "a", body: ten, method: 8, size: 5, crc: 0 }]))
    plain("deflate shorter", raw_archive([Raw { name: "a", body: ten, method: 8, size: 20, crc: 0 }]))
    plain("garbage deflate", raw_archive([Raw { name: "a", body: bytes("hello"), method: 8, size: 5 }]))
    plain("encrypted", raw_archive([Raw { name: "a", body: hello, flags: 1 }]))
    plain("method 99", raw_archive([Raw { name: "a", body: hello, method: 99 }]))
    plain("offset outside", raw_archive([Raw { name: "a", body: hello, offset: 100000 }]))
    plain("offset huge", raw_archive([Raw { name: "a", body: hello, offset: 0x7FFFFFFF }]))
    plain("packed outside", raw_archive([Raw { name: "a", body: hello, packed: 400, size: 400 }]))

    var broken = raw_archive([Raw { name: "a", body: hello }])
    broken[0] = 'X'
    plain("local signature", broken)

    let whole = raw_archive([Raw { name: "a", body: hello }, Raw { name: "b", body: hello }])
    plain("no end record", whole[..whole.len - 22])
    plain("empty", [])
    plain("short", bytes("PK"))
    let tail = raw_archive([Raw { name: "a", body: hello }])
    let bad_count = io.buffer(tail.len)
    io.copy(bad_count, tail)
    io.set_le16(bad_count, tail.len - 12, 5)
    plain("count too large", bad_count)
    let split = io.buffer(tail.len)
    io.copy(split, tail)
    io.set_le16(split, tail.len - 18, 1)
    plain("multi disk", split)
}

fn limits() {
    let zeros = deflate.compress(io.buffer(1000000), 6)
    print("zeros packed {zeros.len < 1500}")
    let one = raw_archive([Raw { name: "z", body: zeros, method: 8, size: 1000000, crc: i64(hash.crc32(io.buffer(1000000))) }])
    plain("zeros", one)
    show("entry limit", one, zip.Limits { entry: 100000 })
    show("total limit", one, zip.Limits { total: 100000 })
    show("ratio limit", one, zip.Limits { ratio: 10 })
    show("entries limit", raw_archive([Raw { name: "a", body: [] }, Raw { name: "b", body: [] }]), zip.Limits { entries: 1 })

    let ratio = raw_archive([Raw { name: "a", body: bytes("0123456789"), size: 20000 }])
    plain("ratio", ratio)

    var overlap: []Raw = []
    for i in 0..300 {
        let none_body: []u8 = []
        let body = if i == 0 { zeros } else { none_body }
        push(mut overlap, Raw { name: "f{i}", body, method: 8, size: 1000000, packed: zeros.len, offset: 0 })
    }
    plain("overlapping", raw_archive(overlap))

    let huge = raw_archive([Raw { name: "huge", body: io.buffer(5000000), size: 5000000000, packed: 5000000, offset: 0, wide: true }])
    plain("zip64 sizes default limits", huge)
    show("zip64 sizes", huge, zip.Limits { entry: 1 << 33, total: 1 << 34 })
}

fn writer_vectors() {
    let w = zip.writer()
    zip.add(w, zip.Entry { name: "a.txt", method: Stored, mtime: 1700000000, mode: 0o640 }, bytes("hi")) or return
    let data = zip.output(w)
    print(text.encode_hex(data[..30]))
    print(text.encode_hex(data[30..44]))
    print(data.len)
    zip.finish(w) or return
    let tail = zip.output(w)
    print(tail.len)
    print(text.encode_hex(tail[tail.len - 22..]))
    zip.add_file(w, "late", [], Stored) catch {
        e => print("add after finish: {error_name(e)}")
    }
}

fn writer_roundtrip() ! io.Error {
    let w = zip.writer()
    zip.add_dir(w, "docs")?
    zip.add_file(w, "docs/a.txt", bytes("hello zip hello zip hello zip hello zip"), Deflate)?
    zip.add_file(w, "docs/b.txt", bytes("stored"), Stored)?
    zip.add_file(w, "docs/tiny.txt", bytes("x"), Deflate)?
    zip.add_file(w, "docs/empty.txt", [], Deflate)?
    zip.add_file(w, "héllo.txt", bytes("utf8"), Deflate)?
    zip.add_symlink(w, "docs/link", "a.txt")?
    zip.add(w, zip.Entry { name: "docs/dated.txt", mtime: 1700000000, mode: 0o600 }, bytes("dated"))?
    zip.add(w, zip.Entry { name: "docs/early.txt", mtime: 100 }, bytes("early"))?
    zip.finish(w)?
    plain("written", zip.output(w))
    let again = zip.open(zip.output(w))?
    print(zip.find(again, "docs/b.txt") != none)
    print(zip.find(again, "docs/c.txt") == none)

    let big = io.buffer(200000)
    for i in 0..big.len {
        big[i] = u8(i * 7 + i / 251)
    }
    let w2 = zip.writer()
    zip.add_file(w2, "big.bin", big, Deflate)?
    zip.add_file(w2, "big.stored", big, Stored)?
    zip.finish(w2)?
    let b = zip.open(zip.output(w2))?
    for e in b.entries {
        let body = zip.read(b, e)?
        print("{e.name} {method_name(e.method)} {e.size} {body.len == big.len} {hash.crc32(body) == hash.crc32(big)}")
    }
}

fn zip64() ! io.Error {
    let w = zip.writer()
    zip.force_zip64(w)
    zip.add_file(w, "z.txt", bytes("zip64 forced zip64 forced zip64 forced"), Deflate)?
    zip.add_dir(w, "d")?
    zip.add_symlink(w, "l", "z.txt")?
    zip.finish(w)?
    plain("forced zip64", zip.output(w))
    let out = zip.output(w)
    print("eocd64 {io.le32(out, out.len - 22 - 20 - 56) == 0x06064b50}")

    let many = zip.writer()
    for i in 0..65536 {
        zip.add(many, zip.Entry { name: "{i}", method: Stored }, [])?
    }
    zip.finish(many)?
    let data = zip.output(many)
    let a = zip.open(data)?
    print("many {a.entries.len} {a.entries[65535].name} {io.le32(data, data.len - 22 - 20 - 56) == 0x06064b50}")

    let under = zip.writer()
    for i in 0..65535 {
        zip.add(under, zip.Entry { name: "{i}", method: Stored }, [])?
    }
    zip.finish(under)?
    let small = zip.output(under)
    print("below {zip.open(small)?.entries.len} {io.le16(small, small.len - 12)}")
}

fn streaming() ! io.Error {
    var collected: []u8 = []
    let sink = io.Stream {
        read: fn(buf) { 0 }
        write: fn(data) -> i64 ! io.Error {
            io.append(mut collected, data)
            data.len
        }
        close: fn() {}
    }
    let w = zip.stream_writer(sink)
    zip.add_file(w, "one.txt", bytes("one one one one one one"), Deflate)?
    zip.add_dir(w, "two")?
    zip.finish(w)?
    print("buffer empty {zip.output(w).len}")
    plain("streamed", collected)
}

fn tree(root: str) -> str {
    let names = file.list(root) or []
    var sorted = names
    sorted |> slices.sort()
    text.join(sorted, ",")
}

fn extract_reference(root: str) ! io.Error {
    let dir = "{root}/ref"
    zip.extract(reference(), dir)?
    print("tree {tree(dir)}")
    print("nested {tree("{dir}/dir/nested")}")
    print(text.trim(file.read_text("{dir}/hello.txt")?))
    print(file.readlink("{dir}/link")?)
    print(file.read_text("{dir}/héllo.txt")?)
    print(file.read_file("{dir}/dir/nested/file.bin")?.len)
    let st = file.lstat("{dir}/hello.txt")?
    print("{text.radix(st.mode & 0o777, 8)} {st.modified}")
    zip.extract(reference(), dir)?
    print("again {tree(dir)}")

    let w = zip.writer()
    zip.add_dir(w, "pkg")?
    zip.add_file(w, "pkg/run.sh", bytes("#!/bin/sh"), Deflate)?
    zip.add(w, zip.Entry { name: "pkg/secret", mode: 0o4700, mtime: 1700000000 }, bytes("s"))?
    zip.add_symlink(w, "pkg/to-run", "run.sh")?
    zip.finish(w)?
    zip.extract(zip.output(w), "{root}/rt")?
    print("rt {tree("{root}/rt/pkg")}")
    let s = file.lstat("{root}/rt/pkg/secret")?
    print("{s.mode & 0o7000} {text.radix(s.mode & 0o700, 8)} {s.modified}")
    print(text.trim(file.read_text("{root}/rt/pkg/to-run")?))
}

fn attempt(root: str, label: str, data: []u8) {
    let dir = "{root}/{label}"
    zip.extract(data, dir) catch {
        e => {
            print("{label}: {error_name(e)} created={file.exists(dir)}")
            return
        }
    }
    print("{label}: extracted {tree(dir)}")
}

fn hostile(root: str) ! io.Error {
    let outside = "{root}/outside"
    file.mkdir(outside)?
    let one = bytes("x")
    attempt(root, "absolute", raw_archive([Raw { name: "{outside}/abs.txt", body: one }]))
    print("absolute created {file.exists("{outside}/abs.txt")}")
    attempt(root, "dotdot", raw_archive([Raw { name: "ok.txt", body: one }, Raw { name: "../escape.txt", body: one }]))
    print("dotdot created {file.exists("{root}/escape.txt")}")
    attempt(root, "nested", raw_archive([Raw { name: "a/b/../../../escape2.txt", body: one }]))
    print("nested created {file.exists("{root}/escape2.txt")}")
    attempt(root, "empty", raw_archive([Raw { name: "", body: one }]))
    attempt(root, "dir dotdot", raw_archive([Raw { name: "../dir/", body: [], external: 0x10 }]))

    let link = 0o120777 << 16
    let through = raw_archive([Raw { name: "s", body: bytes(outside), external: link }, Raw { name: "s/pwn.txt", body: one }])
    attempt(root, "symlink escape", through)
    print("symlink escape created {file.exists("{outside}/pwn.txt")}")

    let relative = raw_archive([Raw { name: "r", body: bytes("../outside"), external: link }, Raw { name: "r/pwn2.txt", body: one }])
    attempt(root, "relative escape", relative)
    print("relative escape created {file.exists("{outside}/pwn2.txt")}")

    let existing = "{root}/pre"
    archive.make_root(existing)?
    archive.symlink("{existing}/jump", outside)?
    zip.extract(raw_archive([Raw { name: "jump/planted.txt", body: one }]), existing) catch {
        e => print("existing link: {error_name(e)}")
    }
    print("existing link created {file.exists("{outside}/planted.txt")}")

    attempt(root, "file as dir", raw_archive([Raw { name: "f", body: one }, Raw { name: "f/under", body: one }]))
    attempt(root, "bad second", raw_archive([Raw { name: "good", body: one }, Raw { name: "bad", body: one, crc: 1 }]))
    attempt(root, "replace link", raw_archive([Raw { name: "swap", body: bytes(outside), external: link }, Raw { name: "swap", body: one }]))
    print("replace link {file.read_text("{root}/replace link/swap")?} {file.exists("{outside}/swap")}")
    print("outside {tree(outside)}")
}

fn main() ! io.Error {
    references()
    corrupt()
    limits()
    writer_vectors()
    writer_roundtrip()?
    zip64()?
    streaming()?
    let root = file.temp_dir("low-std-zip-")?
    extract_reference(root)?
    hostile(root)?
    file.remove_all(root)?
    print(file.exists(root))
}
