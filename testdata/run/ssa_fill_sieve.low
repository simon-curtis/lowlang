fn sieve(limit: i64) -> i64 {
    var composite: []u8 = []
    for i in 0..limit {
        push(mut composite, u8(0))
    }
    var count = 0
    for i in 2..limit {
        if composite[i] == 0 {
            count += 1
            var j = i * i
            for j < limit {
                composite[j] = 1
                j += i
            }
        }
    }
    count
}

fn sparse(limit: i64, step: i64) -> i64 {
    var marks: []u8 = []
    for i in 0..limit {
        push(mut marks, u8(0))
    }
    var j = 0
    for j < limit {
        marks[j] = 1
        j += step
    }
    var count = 0
    for m in marks {
        count += i64(m)
    }
    count
}

fn main() {
    print(sieve(-4))
    print(sieve(0))
    print(sieve(1))
    print(sieve(2))
    print(sieve(3))
    print(sieve(30))
    print(sieve(1000))
    print(sieve(100000))
    print(sparse(100, 7))
    print(sparse(0, 7))
}
