import std/crypto/hash
import checksum = std/hash
import std/text

fn main() {
    var long: []u8 = []
    for i in 0..1000 {
        push(mut long, u8(i * 7))
    }
    for data in [bytes(""), bytes("abc"), long] {
        print(text.encode_hex(hash.sum(hash.sha256(), data)))
        print(text.encode_hex(hash.sum(hash.sha384(), data)))
        print(text.encode_hex(hash.sum(hash.sha512(), data)))
        print(checksum.crc32(data))
        print(checksum.adler32(data))
        print(checksum.crc64(data))
        print(checksum.xxh32(data, 0))
        print(checksum.xxh64(data, 0))
    }
    let d = hash.sha256().digest()
    d.update(long[..100])
    let snapshot = d.clone()
    d.update(long[100..])
    print(text.encode_hex(d.finish()) == text.encode_hex(hash.sum(hash.sha256(), long)))
    snapshot.update(long[100..])
    print(text.encode_hex(snapshot.finish()) == text.encode_hex(d.finish()))
    print(text.encode_hex(hash.hmac(hash.sha256(), bytes("key"), bytes("The quick brown fox jumps over the lazy dog"))))
    let prk = hash.hkdf_extract(hash.sha256(), bytes("salt"), bytes("input key"))
    print(text.encode_hex(hash.hkdf_expand(hash.sha256(), prk, bytes("info"), 42)))
}
