import std/file
import std/io
import std/os
import std/path
import std/process
import std/text

fn status_field(name: str, at: i64) -> i64 {
    let content = file.read_text("/proc/self/status") or return -1
    for line in text.lines(content) {
        if text.starts_with(line, "{name}:") {
            return text.parse_int(text.fields(line)[at]) or -1
        }
    }
    -1
}

fn show(name: str) {
    let value = os.env(name) ?? "<none>"
    print("{name}={value}")
}

fn rejected(name: str, value: str) -> bool {
    os.set_env(name, value) catch {
        Invalid => return true
        _ => return false
    }
    false
}

fn child_sees(name: str) -> str {
    let script = "printf %s \"${name}\""
    let out = process.run(process.command("sh", ["-c", script]), []) or return "<error>"
    str(out.stdout)
}

fn setter(i: i64, done: chan[bool]) {
    os.set_env("LOW_STD_OS_T{i}", "value{i}") or {}
    done <- true
}

fn main() ! io.Error {
    print(os.uid() == status_field("Uid", 1))
    print(os.euid() == status_field("Uid", 2))
    print(os.gid() == status_field("Gid", 1))
    print(os.egid() == status_field("Gid", 2))
    print(os.ppid() == status_field("PPid", 1))
    print(os.ppid() > 0 && os.pid() > 0)

    let hostname = os.hostname()?
    print(hostname.len > 0)
    print(hostname == text.trim(file.read_text("/proc/sys/kernel/hostname")?))

    let dir = file.temp_dir("low-std-os-")?
    let before = os.getcwd()?
    os.chdir(dir)?
    print(os.getcwd()? == file.realpath(dir)?)
    file.write_text("here.txt", "relative")?
    print(file.read_text("{dir}/here.txt")?)
    os.chdir("..")?
    print(os.getcwd()? == path.dir(file.realpath(dir)?))
    os.chdir(before)?
    print(os.getcwd()? == before)
    os.chdir("{dir}/missing") catch {
        NotFound => print("chdir missing")
        _ => print("chdir other")
    }
    file.remove_all(dir)?

    show("LOW_STD_OS_SET")
    os.set_env("LOW_STD_OS_SET", "first")?
    show("LOW_STD_OS_SET")
    print(os.environment()["LOW_STD_OS_SET"] ?? "<none>")
    os.set_env("LOW_STD_OS_SET", "second=with equals")?
    show("LOW_STD_OS_SET")
    print(child_sees("LOW_STD_OS_SET"))
    os.set_env("LOW_STD_OS_SET", "")?
    print(os.env("LOW_STD_OS_SET") == some(""))
    os.unset_env("LOW_STD_OS_SET")?
    show("LOW_STD_OS_SET")
    print(os.environment()["LOW_STD_OS_SET"] == none)
    print(child_sees("LOW_STD_OS_SET").len)

    let path = os.env("PATH") ?? ""
    print(path.len > 0)
    os.unset_env("PATH")?
    print(os.env("PATH") == none)
    print(os.environment()["PATH"] == none)
    os.set_env("PATH", path)?
    print(os.env("PATH") == some(path))
    print(os.environment().len > 0)

    print(rejected("", "1"))
    print(rejected("a=b", "1"))
    print(rejected("LOW_STD_OS_NUL", "x\0y"))
    print(rejected("LOW_STD_OS_OK", "fine"))

    let done = chan[bool](8)
    for i in 0..8 {
        spawn setter(i, done)
    }
    for _ in 0..8 {
        <-done
    }
    var seen = 0
    for i in 0..8 {
        if os.env("LOW_STD_OS_T{i}") == some("value{i}") {
            seen += 1
        }
    }
    print(seen)

    os.set_env("HOME", "/home/low")?
    os.unset_env("XDG_CACHE_HOME")?
    os.unset_env("XDG_CONFIG_HOME")?
    os.unset_env("XDG_DATA_HOME")?
    os.unset_env("XDG_STATE_HOME")?
    os.unset_env("TMPDIR")?
    print(os.home_dir() ?? "<none>")
    print(os.cache_dir() ?? "<none>")
    print(os.config_dir() ?? "<none>")
    print(os.data_dir() ?? "<none>")
    print(os.state_dir() ?? "<none>")
    print(os.temp_dir_path())
    os.set_env("XDG_CACHE_HOME", "/var/cache/low")?
    os.set_env("XDG_CONFIG_HOME", "relative/ignored")?
    os.set_env("TMPDIR", "/var/tmp")?
    print(os.cache_dir() ?? "<none>")
    print(os.config_dir() ?? "<none>")
    print(os.temp_dir_path())
    os.unset_env("HOME")?
    os.unset_env("XDG_CONFIG_HOME")?
    let account = os.lookup_user(os.euid())
    print(os.home_dir() == account_home(account))

    let exe = os.executable()?
    print(exe.len > 0 && exe[0] == '/')
    print(file.is_file(exe))

    let root = os.lookup_user(0) ?? os.User { name: "<none>", uid: 0, gid: 0, home: "", shell: "" }
    print("{root.name} {root.uid} {root.gid}")
    print(os.lookup_user(-5) == none)
    print(os.user_name() == name_of(account))

    print(os.uptime()? > 0)
    let cpus = os.cpu_count()
    print(cpus >= 1 && cpus <= 65536)
}

fn account_home(user: os.User?) -> str? {
    let u = user ?? return none
    u.home
}

fn name_of(user: os.User?) -> str? {
    let u = user ?? return none
    u.name
}
