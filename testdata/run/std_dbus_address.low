import std/dbus
import std/os
import std/text

fn parse_result(s: str) -> str {
    let list = dbus.parse_addresses(s) catch {
        e => return "{e}"
    }
    var out = ""
    for a in list {
        out = "{out}[{a.transport} {a.keys} guid {text.quote(dbus.address_guid(a))}]"
    }
    out
}

fn path_result(s: str) -> str {
    let list = dbus.parse_addresses(s) catch {
        e => return "{e}"
    }
    let path = dbus.socket_path(list[0]) catch {
        e => return "{e}"
    }
    path
}

fn unescape_result(s: str) -> str {
    let out = dbus.unescape_address_value(s) catch {
        e => return "{e}"
    }
    text.quote(out)
}

fn list_text(list: []dbus.Address) -> str {
    var out = ""
    for a in list {
        out = "{out}{dbus.address_text(a)} "
    }
    out
}

fn session() -> str {
    let list = dbus.session_addresses() catch {
        e => return "{e}"
    }
    list_text(list)
}

fn system() -> str {
    let list = dbus.system_addresses() catch {
        e => return "{e}"
    }
    list_text(list)
}

fn set(name: str, value: str) {
    os.set_env(name, value) or panic("set_env")
}

fn clear(name: str) {
    os.unset_env(name) or panic("unset_env")
}

fn main() {
    print("parse_addresses")
    let lists = [
        "unix:path=/run/user/1000/bus",
        "unix:abstract=/tmp/dbus-XXXX,guid=0123456789abcdef",
        "unix:runtime=yes",
        "unix:path=/a;unix:abstract=b",
        "unix:path=/a;;unix:path=/b;",
        "tcp:host=localhost,port=1234;unix:path=/a",
        "unix:path=/with%20space%3d%2c%3b%25",
        "unix:path=/UPPER%2F%2f",
        "unix:",
        "unix:path=",
        "unix:path=/a,path=/b",
        "",
        ";",
        "unix",
        ":path=/a",
        "unix:path",
        "unix:=/a",
        "unix:path=%zz",
        "unix:path=%4",
        "unix:path=%",
        "unix:path=/a,",
        "unix:path=/a,,guid=ff",
    ]
    for s in lists {
        print("  {text.quote(s)}: {parse_result(s)}")
    }

    print("escape_address_value")
    for s in ["abc-_/.\\*XYZ019", "a b", "=,;%", "é", "", "\n"] {
        let escaped = dbus.escape_address_value(s)
        print("  {text.quote(s)}: {escaped} {unescape_result(escaped)}")
    }

    var every_byte: []u8 = []
    for b in 1..128 {
        push(mut every_byte, u8(b))
    }
    print("  bytes 1 to 127: {dbus.escape_address_value(str(every_byte))}")

    print("unescape_address_value")
    for s in ["%41%42", "%4a%4A", "%00", "%", "%a", "%gg", "plain", "100%25"] {
        print("  {text.quote(s)}: {unescape_result(s)}")
    }

    print("address_text")
    for s in ["unix:path=/a b,guid=ff", "unix:abstract=x%2Cy", "unix:runtime=yes"] {
        let list = dbus.parse_addresses(s) or panic("parse")
        let written = dbus.address_text(list[0])
        let back = dbus.parse_addresses(written) or panic("reparse")
        print("  {written} {"{back[0].keys}" == "{list[0].keys}"}")
    }

    print("socket_path")
    set("XDG_RUNTIME_DIR", "/run/user/7")
    let paths = [
        "unix:path=/run/user/1000/bus",
        "unix:abstract=/tmp/dbus-X",
        "unix:runtime=yes",
        "unix:runtime=no",
        "unix:path=/a,abstract=b",
        "unix:path=/a,runtime=yes",
        "unix:guid=ff",
        "tcp:host=h,port=1",
        "unix:path=/a%20b",
    ]
    for s in paths {
        print("  {text.quote(s)}: {path_result(s)}")
    }
    clear("XDG_RUNTIME_DIR")
    print("  runtime=yes without XDG_RUNTIME_DIR: {path_result("unix:runtime=yes")}")

    print("session_addresses")
    set("DBUS_SESSION_BUS_ADDRESS", "unix:path=/custom;unix:abstract=other")
    set("XDG_RUNTIME_DIR", "/run/user/7")
    print("  variable: {session()}")
    set("DBUS_SESSION_BUS_ADDRESS", "")
    print("  empty variable: {session()}")
    clear("DBUS_SESSION_BUS_ADDRESS")
    print("  fallback: {session()}")
    set("XDG_RUNTIME_DIR", "/run/user/a b")
    print("  fallback with an escaped directory: {session()}")
    clear("XDG_RUNTIME_DIR")
    print("  neither: {session()}")
    set("DBUS_SESSION_BUS_ADDRESS", "garbage")
    print("  malformed: {session()}")
    clear("DBUS_SESSION_BUS_ADDRESS")

    print("system_addresses")
    clear("DBUS_SYSTEM_BUS_ADDRESS")
    print("  fallback: {system()}")
    set("DBUS_SYSTEM_BUS_ADDRESS", "unix:path=/custom/system")
    print("  variable: {system()}")
    set("DBUS_SYSTEM_BUS_ADDRESS", "")
    print("  empty variable: {system()}")
    set("DBUS_SYSTEM_BUS_ADDRESS", "garbage")
    print("  malformed: {system()}")
    clear("DBUS_SYSTEM_BUS_ADDRESS")
}
