enum Shape {
    Empty
    Circle(radius: i64)
    Labelled(name: str, sides: []i64)
}

struct Slot {
    value: str?
}

struct Leaf {
    id: i64
    label: str
}

struct Record {
    name: str
    numbers: []i64
    names: []str
    lookup: [str: i64]
    shape: Shape
    maybe: str?
    missing: i64?
    leaf: *Leaf
    twin: *Leaf
    leaves: []*Leaf
    nested: [][]str
}

fn build() -> Record {
    region {
        let shared = new(Leaf { id: 7, label: "shared" })
        var lookup: [str: i64] = [:]
        lookup["zebra"] = 1
        lookup["apple"] = 2
        lookup["mango"] = 3
        var leaves: []*Leaf = []
        for i in 0..3 {
            push(mut leaves, new(Leaf { id: i, label: "leaf{i}" }))
        }
        Record {
            name: "record-{shared.id}"
            numbers: [10, 20, 30]
            names: ["a", "b"]
            lookup
            shape: Shape.Labelled("poly", [3, 4, 5])
            maybe: "present"
            missing: none
            leaf: shared
            twin: shared
            leaves
            nested: [["x"], [], ["y", "z"]]
        }
    }
}

fn shapes() -> []Shape {
    region {
        [Shape.Empty, Shape.Circle(5), Shape.Labelled("tri", [1, 2, 3])]
    }
}

fn options() -> []Slot {
    region {
        [Slot { value: "one" }, Slot { value: none }]
    }
}

fn ints() -> [i64: []i64] {
    region {
        var m: [i64: []i64] = [:]
        for i in 0..4 {
            m[i * 10] = [i, i + 1]
        }
        m
    }
}

fn main() {
    let r = build()
    print(r.name)
    print(r.numbers)
    print(r.names)
    for k, v in r.lookup {
        print("{k}={v}")
    }
    match r.shape {
        Labelled(name, sides) => print("{name} {sides}")
        _ => print("other")
    }
    print(r.maybe ?? "none")
    print(r.missing ?? -1)
    print("{r.leaf.id} {r.leaf.label} {r.twin.id} {r.twin.label}")
    r.leaf.id = 99
    print("{r.leaf.id} {r.twin.id}")
    var ids = 0
    for l in r.leaves {
        ids += l.id
        print(l.label)
    }
    print(ids)
    print(r.nested)

    for s in shapes() {
        match s {
            Empty => print("empty")
            Circle(radius) => print("circle {radius}")
            Labelled(name, sides) => print("{name} {sides}")
        }
    }
    for o in options() {
        print(o.value ?? "absent")
    }
    let m = ints()
    for k, v in m {
        print("{k}: {v}")
    }
}
