import std/msgpack
import std/serde
import std/text

enum Shape {
    Circle(radius: f64)
    Rect(f64, f64)
    Empty
}

struct Sample {
    id: i64
    name: str
    tags: []str
    scores: [str: i64]
    blob: []u8
    ratio: f32
    shape: Shape
    note: str?
    big: u64
}

fn hex(s: str) -> []u8 {
    text.decode_hex(s) catch {
        _ => []
    }
}

fn show(label: str, v: msgpack.Value, head: i64) {
    let data = msgpack.encode(v)
    let n = if data.len < head { data.len } else { head }
    print("{label} {data.len} {text.encode_hex(data[..n])}")
}

fn zeros(n: i64) -> []u8 {
    var out: []u8 = []
    for _ in 0..n {
        push(mut out, 0)
    }
    out
}

fn integers() {
    let values: []i64 = [
        0, 1, 127, 128, 255, 256, 65535, 65536, 4294967295, 4294967296, 9223372036854775807,
        -1, -32, -33, -128, -129, -32768, -32769, -2147483648, -2147483649, -9223372036854775807 - 1,
    ]
    for n in values {
        show("int {n}", msgpack.Value.Int(n), 16)
    }
    show("uint 18446744073709551615", msgpack.Value.Uint(18446744073709551615), 16)
    show("uint 9223372036854775808", msgpack.Value.Uint(9223372036854775808), 16)
    show("uint 5", msgpack.Value.Uint(5), 16)
}

fn scalars() {
    show("nil", msgpack.Value.Nil, 16)
    show("true", msgpack.Value.Bool(true), 16)
    show("false", msgpack.Value.Bool(false), 16)
    show("single 1.5", msgpack.Value.Single(1.5), 16)
    show("single -0", msgpack.Value.Single(-0.0), 16)
    show("double 3.14159", msgpack.Value.Double(3.14159), 16)
    show("double 1e300", msgpack.Value.Double(1e300), 16)
}

fn sized() {
    for n in [0, 1, 31, 32, 255, 256, 65535, 65536] {
        let body = text.repeat("a", n)
        show("str {n}", msgpack.Value.Str(body), 5)
        show("bin {n}", msgpack.Value.Bin(bytes(body)), 5)
    }
    for n in [0, 1, 15, 16, 65535, 65536] {
        var items: []msgpack.Value = []
        var entries: []msgpack.Entry = []
        for _ in 0..n {
            push(mut items, msgpack.Value.Nil)
            push(mut entries, msgpack.Entry { key: msgpack.Value.Nil, value: msgpack.Value.Nil })
        }
        let a = msgpack.encode(msgpack.Value.Array(items))
        let m = msgpack.encode(msgpack.Value.Map(entries))
        let ah = a[..if a.len < 5 { a.len } else { 5 }]
        let mh = m[..if m.len < 5 { m.len } else { 5 }]
        print("array {n} {a.len - n} {text.encode_hex(ah)}")
        print("map {n} {m.len - 2 * n} {text.encode_hex(mh)}")
    }
    for n in [0, 1, 2, 3, 4, 5, 8, 9, 16, 17, 255, 256, 65535, 65536] {
        show("ext {n}", msgpack.Value.Ext(5, zeros(n)), 3)
    }
    show("ext kind -3", msgpack.Value.Ext(-3, [1]), 3)
    show("ext kind -128", msgpack.Value.Ext(-128, [1]), 3)
}

fn timestamps() {
    let cases: [][]i64 = [
        [0, 0], [1, 0], [4294967295, 0], [4294967296, 0], [1, 1], [17179869183, 999999999],
        [17179869184, 0], [-1, 0], [-1, 500], [1700000000, 123456789],
    ]
    for c in cases {
        show("timestamp {c[0]} {c[1]}", msgpack.Value.Timestamp(c[0], c[1]), 16)
    }
    show("timestamp normalised", msgpack.Value.Timestamp(1, 2500000000), 16)
    show("timestamp normalised negative", msgpack.Value.Timestamp(1, -500000000), 16)
}

fn failure(e: msgpack.Error) -> str {
    "{msgpack.offset(e)} {msgpack.message(e)}"
}

fn decoded(h: str) {
    let v = msgpack.decode(hex(h)) catch {
        e => {
            print("{h} failed {failure(e)}")
            return
        }
    }
    let again = text.encode_hex(msgpack.encode(v))
    let mark = if again == h { "" } else { " -> {again}" }
    print("{h} {msgpack.diagnostic(v)}{mark}")
}

fn spec() {
    for h in [
        "c0", "c2", "c3", "00", "7f", "e0", "ff", "cc80", "cd0100", "ce00010000", "cf0000000100000000",
        "d0df", "d1ff7f", "d2ffff7fff", "d3ffffffff7fffffff", "cfffffffffffffffff", "cf8000000000000000",
        "ca3fc00000", "cb400921f9f01b866e", "ca7f800000", "cbfff0000000000000", "cb7ff8000000000000",
        "a0", "a161", "a3e6b0b4", "d9026162", "da00026162", "db000000026162",
        "c40100", "c5000200ff", "c600000002aabb",
        "90", "9201c3", "dc000201a161", "dd0000000193c0c2c3", "93c0c2c3",
        "80", "82a7636f6d70616374c3a6736368656d6100", "de0001a16101", "df00000001a16102",
        "81a161810102", "8101a161", "81c0c3", "82a16101a16102",
        "d4010a", "d5020102", "d60301020304", "d7040102030405060708", "d8050102030405060708090a0b0c0d0e0f10",
        "c7040a01020304", "c8000402aabbccdd", "c90000000203aabb", "d4ff00",
        "d6ff00000000", "d6ff499602d2", "d7ff0000000100000000", "d7ff1d6f34546553f100", "c70cff000001f4ffffffffffffffff",
        "c70cff000000000000000400000000", "d7ffee6b27ffffffffff",
    ] {
        decoded(h)
    }
}

fn errors() {
    for h in [
        "", "c1", "cd01", "a2", "a261", "d9", "d90561", "c40161", "92c0", "81c0", "82a16101", "dd0000000501", "df00000003c0",
        "a1ff", "a2c328", "a2c0af", "a3e0809f", "a3eda080", "a4f4908080", "a2c3",
        "d5ff0000", "c70cffffffffff00000000000000000000", "c70cffc4653600000000000000000000", "d7ffffffffffffffffffff",
        "c70bff0000000000000000000000", "c70cff3b9aca00ffffffffffffffff", "d7ff0000000000000000",
        "00c0", "c0c0", "9201",
    ] {
        decoded(h)
    }
}

fn limits() {
    let deep = hex("9191919191919191c0")
    let shallow = msgpack.Options { max_depth: 7 }
    let v = msgpack.decode_with(deep, shallow) catch {
        e => {
            print("depth 7: {failure(e)}")
            msgpack.Value.Nil
        }
    }
    let ok = msgpack.Options { max_depth: 9 }
    let w = msgpack.decode_with(deep, ok) catch {
        e => {
            print("depth 9: {failure(e)}")
            msgpack.Value.Nil
        }
    }
    print("depth 9 value {msgpack.diagnostic(w)}")

    let tight = msgpack.Options { max_length: 3 }
    for h in ["a3616263", "a461626364", "c404616263", "c403616263", "9401020304", "9301020300", "dd0000ffff01", "8401020304050607", "c60000000501", "da000461626364", "82010203"] {
        let r = msgpack.decode_with(hex(h), tight) catch {
            e => {
                print("{h} {failure(e)}")
                continue
            }
        }
        print("{h} {msgpack.diagnostic(r)}")
    }
    let near = msgpack.decode(hex("dd00ffffff01")) catch {
        e => {
            print("short array: {failure(e)}")
            msgpack.Value.Nil
        }
    }
    let huge = msgpack.decode(hex("dd7fffffff01")) catch {
        e => {
            print("huge array: {failure(e)}")
            msgpack.Value.Nil
        }
    }
}

fn streams() {
    let data = hex("01a16182c3c0c2c3ff")
    var at = 0
    for at < data.len {
        let item = msgpack.decode_first(data[at..], msgpack.Options {}) catch {
            e => {
                print("stream failed at {at + msgpack.offset(e)}")
                return
            }
        }
        print("item at {at} length {item.length} {msgpack.diagnostic(item.value)}")
        at += item.length
    }
}

fn lookups() {
    let v = msgpack.decode(hex("83a16101a16202a16103")) catch { _ => msgpack.Value.Nil }
    print(msgpack.as_integer(msgpack.get(v, "a") ?? msgpack.Value.Nil) ?? -1)
    print(msgpack.as_integer(msgpack.get(v, "b") ?? msgpack.Value.Nil) ?? -1)
    print(msgpack.as_integer(msgpack.get(v, "z") ?? msgpack.Value.Nil) ?? -1)
    print(msgpack.as_integer(msgpack.Value.Uint(18446744073709551615)) ?? -1)
    print(msgpack.as_integer(msgpack.Value.Uint(7)) ?? -1)
    print(msgpack.as_integer(msgpack.Value.Str("x")) ?? -1)
}

fn describe(e: serde.Error) -> str {
    match e {
        Syntax(at, message) => "syntax at {at}: {message}"
        Mismatch(expected, at) => "expected {expected} at {at}"
        Missing(field) => "missing {field}"
        UnknownVariant(name) => "unknown variant {name}"
        Range(at) => "out of range at {at}"
        TooDeep => "too deep"
    }
}

fn sample() -> Sample {
    Sample {
        id: -7
        name: "ada"
        tags: ["x", "yz"]
        scores: ["a": 1, "b": 300]
        blob: [1, 2, 3]
        ratio: 0.5
        shape: Shape.Rect(2.0, 3.5)
        note: none
        big: 18446744073709551615
    }
}

fn serde_round_trip() {
    let s = sample()
    let data = msgpack.serialize(s)
    print(text.encode_hex(data))
    let back = msgpack.deserialize[Sample](data) catch {
        e => {
            print("failed {describe(e)}")
            return
        }
    }
    print("{back.id} {back.name} {back.tags.len} {back.scores["b"] ?? 0} {back.blob.len} {back.ratio} {back.big}")
    print(msgpack.diagnostic(msgpack.to_value(back)))
    print(text.encode_hex(msgpack.serialize(back)) == text.encode_hex(data))

    print(text.encode_hex(msgpack.serialize(Shape.Circle(1.0))))
    print(text.encode_hex(msgpack.serialize(Shape.Empty)))
    print(text.encode_hex(msgpack.serialize([1, 2, 3])))
    print(text.encode_hex(msgpack.serialize("hi")))
    let opt: i64? = 5
    print(text.encode_hex(msgpack.serialize(opt)))
}

fn mismatch(h: str) {
    let r = msgpack.deserialize[Sample](hex(h)) catch {
        e => {
            print("{h} {describe(e)}")
            return
        }
    }
    print("{h} decoded")
}

fn serde_errors() {
    mismatch("c1")
    mismatch("")
    mismatch("c0")
    mismatch("90")
    mismatch("80")
    mismatch("81a2696401")
    mismatch("81a2696ea161")
    let nest = text.repeat("91", 200)
    let data = hex("{nest}c0")
    let deep = msgpack.deserialize[[]i64](data) catch {
        e => {
            print("deep {describe(e)}")
            []
        }
    }
}

fn main() {
    integers()
    scalars()
    sized()
    timestamps()
    spec()
    errors()
    limits()
    streams()
    lookups()
    serde_round_trip()
    serde_errors()
}
