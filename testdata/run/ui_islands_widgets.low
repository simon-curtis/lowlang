import std/image
import std/ui
import std/ui/geometry
import std/ui/platform
import std/ui/scene
import std/ui/islands

fn rounded(v: f32) -> i64 {
    i64(v + 0.5)
}

fn show(r: geometry.Rect) -> str {
    "{rounded(r.x)} {rounded(r.y)} {rounded(r.width)} {rounded(r.height)}"
}

fn name_of(c: geometry.Color) -> str {
    if c == islands.hovered() {
        "hovered"
    } else if c == islands.raised() {
        "raised"
    } else if c == islands.control() {
        "control"
    } else if c == islands.danger() {
        "danger"
    } else if c == islands.border_colour() {
        "border"
    } else if c == islands.canvas() {
        "canvas"
    } else if c == islands.surface() {
        "surface"
    } else {
        "other"
    }
}

fn dump(label: str, s: scene.Scene) {
    print("{label}: quads {s.quads.len} sprites {s.sprites.len} shadows {s.shadows.len}")
    for q in s.quads {
        print("  quad {show(q.bounds)} {name_of(q.background)}")
    }
}

fn named(cx: ui.Context, k: platform.NamedKey) {
    cx.dispatch(Key(platform.KeyEvent { key: Named(k) }))
}

fn typed(cx: ui.Context, text: str) {
    cx.dispatch(Key(platform.KeyEvent { key: Character(text), text }))
}

fn click(cx: ui.Context, button: platform.Button, x: f32, y: f32) {
    cx.dispatch(PointerMoved(x, y))
    cx.dispatch(PointerDown(button, x, y))
    cx.dispatch(PointerUp(button, x, y))
}

fn appended(l: []str, line: str) -> []str {
    var out = l[0..]
    out.push(line)
    out
}

fn flush(log: ui.Signal[[]str]) {
    for line in log.get() {
        print("  log {line}")
    }
    let none_yet: []str = []
    log.set(none_yet)
}

fn menus() {
    print("menu")
    let cx = ui.headless(ui.rgb(0x000000))
    let none_yet: []str = []
    let log = cx.signal(none_yet)
    let m = islands.menu_state(cx)
    let chosen = fn(name: str) -> fn() {
        fn() log.update(fn(l) appended(l, name))
    }
    let items = [
        islands.menu_item("Rename", islands.check_icon(), chosen("rename")).with_hint("F2"),
        islands.menu_item("Copy", islands.search_icon(), chosen("copy")),
        islands.menu_item("Delete", islands.window_close_icon(), chosen("delete")).separated().with_danger(true),
    ]
    let view = fn() -> ui.Element {
        let base = ui.div().id("base").focusable().size_full().background(islands.canvas())
            .on_mouse_down(Right, fn(e: ui.MouseEvent) islands.show_menu(m, e.position, items))
        ui.div().relative().size_full().children([base, islands.context_menu(m)])
    }
    let size = geometry.size(400.0, 300.0)
    cx.dispatch(Resized(400.0, 300.0, 1.0))
    cx.set_focus("base")
    let hidden = cx.frame(view, size, 1.0)
    dump("hidden", hidden)
    click(cx, Right, 50.0, 60.0)
    print("focus {cx.focused()}")
    let shown = cx.frame(view, size, 1.0)
    dump("shown", shown)
    print("focus {cx.focused()}")
    named(cx, Down)
    named(cx, Down)
    dump("second", cx.frame(view, size, 1.0))
    named(cx, Up)
    named(cx, Up)
    dump("wrapped", cx.frame(view, size, 1.0))
    named(cx, Enter)
    flush(log)
    print("after enter focus {cx.focused()}")
    dump("closed", cx.frame(view, size, 1.0))

    click(cx, Right, 50.0, 60.0)
    cx.frame(view, size, 1.0)
    typed(cx, "x")
    flush(log)
    print("after other key focus {cx.focused()}")
    dump("dismissed", cx.frame(view, size, 1.0))

    click(cx, Right, 50.0, 60.0)
    cx.frame(view, size, 1.0)
    click(cx, Left, 300.0, 250.0)
    print("after outside press focus {cx.focused()}")
    dump("outside", cx.frame(view, size, 1.0))

    click(cx, Right, 50.0, 60.0)
    cx.frame(view, size, 1.0)
    cx.dispatch(PointerDown(Right, 50.0, 60.0))
    print("same spot focus {cx.focused()}")
    cx.dispatch(PointerUp(Right, 50.0, 60.0))
    dump("same spot", cx.frame(view, size, 1.0))
    click(cx, Left, 300.0, 250.0)
    cx.frame(view, size, 1.0)

    click(cx, Right, 50.0, 60.0)
    let again = cx.frame(view, size, 1.0)
    print("menu {show(again.quads[1].bounds)}")
    click(cx, Left, 70.0, 100.0)
    flush(log)
    print("after click focus {cx.focused()}")
    dump("clicked", cx.frame(view, size, 1.0))
}

fn confirms() {
    print("confirm")
    let cx = ui.headless(ui.rgb(0x000000))
    let th = islands.theme("pink", "cascadia", 13)
    let none_yet: []str = []
    let log = cx.signal(none_yet)
    let open = cx.signal(true)
    let view = fn() -> ui.Element {
        let outer = ui.div().relative().size_full().background(islands.canvas())
        if !open.get() {
            return outer
        }
        let dialog = islands.confirm_dialog(th, "Delete this?", "rm -rf build/\nthis cannot be undone", "Delete", fn() {
            log.update(fn(l) appended(l, "confirmed"))
            open.set(false)
        }, fn() {
            log.update(fn(l) appended(l, "dismissed"))
            open.set(false)
        })
        outer.child(dialog)
    }
    let size = geometry.size(640.0, 400.0)
    cx.dispatch(Resized(640.0, 400.0, 1.0))
    islands.focus_confirm(cx)
    let first = cx.frame(view, size, 1.0)
    dump("dialog", first)
    print("focus {cx.focused()}")
    typed(cx, "q")
    flush(log)
    named(cx, Escape)
    flush(log)
    dump("gone", cx.frame(view, size, 1.0))
    open.set(true)
    islands.focus_confirm(cx)
    cx.frame(view, size, 1.0)
    named(cx, Enter)
    flush(log)
    open.set(true)
    islands.focus_confirm(cx)
    let third = cx.frame(view, size, 1.0)
    let cancel_box = third.quads[third.quads.len - 2].bounds
    let confirm_box = third.quads[third.quads.len - 1].bounds
    let cancel_at = geometry.point(cancel_box.x + 4.0, cancel_box.y + 4.0)
    let confirm_at = geometry.point(confirm_box.x + 4.0, confirm_box.y + 4.0)
    print("buttons cancel {show(cancel_box)} confirm {show(confirm_box)}")
    click(cx, Left, cancel_at.x, cancel_at.y)
    flush(log)
    open.set(true)
    cx.frame(view, size, 1.0)
    click(cx, Left, confirm_at.x, confirm_at.y)
    flush(log)
}

fn letters() -> []islands.Choice {
    [
        islands.choice("a", "Amber", "warm", "orange"),
        islands.choice("b", "Blue", "", "sky"),
        islands.choice("c", "Cyan", "cool", "aqua"),
        islands.choice("d", "Denim", "", "jeans"),
        islands.choice("e", "Emerald", "green", "gem"),
        islands.choice("f", "Fuchsia", "", "pink"),
        islands.choice("g", "Green", "plain", "grass"),
        islands.choice("h", "Hazel", "", "eyes"),
        islands.choice("i", "Indigo", "dark", "dye"),
        islands.choice("j", "Jade", "", "stone"),
        islands.choice("k", "Khaki", "dull", "army"),
        islands.choice("l", "Lime", "", "fruit"),
        islands.choice("m", "Magenta", "loud", "print"),
        islands.choice("n", "Navy", "", "sea"),
    ]
}

fn dump_keys(p: islands.Picker) {
    print("  shown {islands.shown_keys(p)} selected {islands.selected_index(p)}")
}

fn pickers() {
    print("picker")
    let cx = ui.headless(ui.rgb(0x000000))
    let th = islands.theme("pink", "cascadia", 13)
    ui.bind_field_keys(cx) or {
        print("bind failed")
        return
    }
    let none_yet: []str = []
    let log = cx.signal(none_yet)
    let p = islands.picker_state(cx, "scheme", "Search colours", "No colour matches")
    let chosen = fn(key: str) log.update(fn(l) appended(l, "chosen {key}"))
    let dismissed = fn() log.update(fn(l) appended(l, "dismissed"))
    let view = fn() -> ui.Element {
        ui.div().relative().size_full().padding(20.0).items_start().background(islands.canvas()).child(islands.picker(th, p, chosen, dismissed))
    }
    let size = geometry.size(500.0, 600.0)
    cx.dispatch(Resized(500.0, 600.0, 1.0))
    print("focus {cx.focused()}")
    dump("loading", cx.frame(view, size, 1.0))

    islands.load_choices(p, letters(), "k")
    dump_keys(p)
    let loaded = cx.frame(view, size, 1.0)
    dump("loaded", loaded)
    print("  scroll {cx.scroll_offset("scheme-list").y}")
    named(cx, Down)
    named(cx, Down)
    named(cx, Down)
    dump_keys(p)
    cx.frame(view, size, 1.0)
    print("  scroll {cx.scroll_offset("scheme-list").y}")
    named(cx, Up)
    named(cx, Up)
    named(cx, Up)
    named(cx, Up)
    dump_keys(p)
    cx.frame(view, size, 1.0)
    print("  scroll {cx.scroll_offset("scheme-list").y}")
    for _ in 0..13 {
        named(cx, Down)
    }
    dump_keys(p)
    cx.frame(view, size, 1.0)
    print("  scroll {cx.scroll_offset("scheme-list").y}")
    named(cx, Down)
    dump_keys(p)
    cx.frame(view, size, 1.0)
    print("  scroll {cx.scroll_offset("scheme-list").y}")
    named(cx, Up)
    dump_keys(p)
    cx.frame(view, size, 1.0)
    print("  scroll {cx.scroll_offset("scheme-list").y}")
    named(cx, Enter)
    flush(log)

    typed(cx, "g")
    typed(cx, "r")
    dump_keys(p)
    let narrowed = cx.frame(view, size, 1.0)
    dump("narrowed", narrowed)
    named(cx, Down)
    named(cx, Enter)
    flush(log)

    typed(cx, "e")
    dump_keys(p)
    typed(cx, "e")
    dump_keys(p)
    cx.frame(view, size, 1.0)
    named(cx, Enter)
    flush(log)
    typed(cx, "z")
    dump_keys(p)
    dump("nothing", cx.frame(view, size, 1.0))
    named(cx, Enter)
    named(cx, Down)
    dump_keys(p)
    flush(log)
    named(cx, Backspace)
    named(cx, Backspace)
    named(cx, Backspace)
    named(cx, Backspace)
    named(cx, Backspace)
    dump_keys(p)

    typed(cx, "A")
    typed(cx, " ")
    typed(cx, "R")
    dump_keys(p)
    cx.frame(view, size, 1.0)
    named(cx, Escape)
    flush(log)
    click(cx, Left, 490.0, 590.0)
    flush(log)

    named(cx, Backspace)
    named(cx, Backspace)
    named(cx, Backspace)
    dump_keys(p)
    let again = cx.frame(view, size, 1.0)
    print("rows {again.quads.len}")
    click(cx, Left, 60.0, 180.0)
    flush(log)
    print("focus {cx.focused()}")

    islands.load_choices(p, letters(), none)
    dump_keys(p)
    let plain = cx.frame(view, size, 1.0)
    islands.load_choices(p, letters(), "a")
    let checked = cx.frame(view, size, 1.0)
    print("check mark quads {checked.quads.len - plain.quads.len} sprites {checked.sprites.len - plain.sprites.len} pictures {checked.pictures.len - plain.pictures.len}")
    islands.load_failed(p, "Could not read the colours")
    dump_keys(p)
    dump("failed", cx.frame(view, size, 1.0))
}

fn mark_image() -> image.Image {
    let img = image.create(24, 24, Rgb8)
    for y in 0..24 {
        for x in 0..24 {
            img.set(x, y, image.Rgba { r: 200, g: 60, b: 140, a: 255 })
        }
    }
    img
}

fn windows() {
    print("window")
    let cx = ui.headless(ui.rgb(0x000000))
    var now = 0
    cx.set_clock(fn() -> i64 { now })
    let th = islands.theme("teal", "jetbrains", 14)
    let b = islands.backdrop(cx)
    let mark = cx.render_image(mark_image())
    let view_index = cx.signal(0)
    let ticked = cx.signal(false)
    let none_yet: []str = []
    let log = cx.signal(none_yet)
    let content = fn() -> ui.Element {
        let rail = islands.rail().children([
            islands.rail_button("rail-0", islands.search_icon(), view_index.get() == 0, "Search", fn(e: ui.ClickEvent) view_index.set(0)),
            islands.rail_button("rail-1", islands.check_icon(), view_index.get() == 1, "Done", fn(e: ui.ClickEvent) view_index.set(1)),
        ])
        let strip = islands.status_strip().child(ui.text("2 items"))
        let main_view = if view_index.get() == 0 {
            ui.div().column().flex_1().children([
                ui.div().height(islands.bar_height()).padding_x(12.0).child(islands.tabs([
                    islands.tab(th, "tab-a", "Open", true, fn(e: ui.ClickEvent) log.update(fn(l) appended(l, "tab a"))),
                    islands.tab(th, "tab-b", "Closed", false, fn(e: ui.ClickEvent) log.update(fn(l) appended(l, "tab b"))),
                ])),
                ui.div().column().flex_1().gap(4.0).padding(8.0).children([
                    islands.checkbox(th, "tick", "Done", ticked.get(), fn(e: ui.ClickEvent) ticked.set(!ticked.get())),
                    islands.pill("Draft", islands.warn()),
                    islands.keys("ctrl-shift-p"),
                ]),
            ])
        } else {
            islands.empty_state(islands.check_icon(), "Nothing here", "Pick another view")
        }
        ui.div().column().size_full().children([ui.div().flex_1().children([rail, main_view]), strip])
    }
    let view = fn() -> ui.Element {
        islands.tool_window(th, cx, b, "Islands", islands.brand(mark, true), content())
    }
    let size = geometry.size(800.0, 500.0)
    cx.dispatch(Resized(800.0, 500.0, 1.0))
    cx.dispatch(DecorationsChanged(Client))
    let first = cx.frame(view, size, 1.0)
    dump("client", first)
    print("pictures {first.pictures.len}")
    print("caption {cx.window_decorations() == platform.Decorations.Client}")
    cx.dispatch(DecorationsChanged(Server))
    let server = cx.frame(view, size, 1.0)
    print("server quads {server.quads.len} sprites {server.sprites.len} fewer sprites {first.sprites.len - server.sprites.len}")
    cx.dispatch(DecorationsChanged(Client))
    cx.frame(view, size, 1.0)
    cx.dispatch(PointerMoved(30.0, 100.0))
    now = 100000000
    let early = cx.frame(view, size, 1.0)
    now = 700000000
    let late = cx.frame(view, size, 1.0)
    print("tooltip shadows {early.shadows.len} {late.shadows.len} sprites {late.sprites.len - early.sprites.len}")
    click(cx, Left, 30.0, 100.0)
    print("view {view_index.get()}")
    dump("empty", cx.frame(view, size, 1.0))
    click(cx, Left, 30.0, 60.0)
    print("view {view_index.get()}")
    let back = cx.frame(view, size, 1.0)
    dump("back", back)
    click(cx, Left, 120.0, 55.0)
    flush(log)
    click(cx, Left, 70.0, 100.0)
    cx.frame(view, size, 1.0)
    print("ticked {ticked.get()}")
}

fn main() {
    menus()
    confirms()
    pickers()
    windows()
}
