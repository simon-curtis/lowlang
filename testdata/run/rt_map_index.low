fn mix(state: i64, value: i64) -> i64 {
    (state * 1000003 + value) % 1000000007
}

fn order_digest(m: [i64: i64]) -> i64 {
    var digest = 0
    for k, v in m {
        digest = mix(mix(digest, k), v)
    }
    digest
}

fn str_digest(m: [str: i64]) -> i64 {
    var digest = 0
    for k, v in m {
        for c in k {
            digest = mix(digest, i64(c))
        }
        digest = mix(digest, v)
    }
    digest
}

fn first_keys(m: [i64: i64], limit: i64) -> []i64 {
    var out: []i64 = []
    for k in m {
        if out.len == limit {
            break
        }
        push(mut out, k)
    }
    out
}

fn integer_keys() {
    var m: [i64: i64] = [:]
    for i in 0..20000 {
        m[i << 20] = i
    }
    for i in 0..20000 {
        m[-(i << 24) - 1] = -i
    }
    print(m.len)
    print(order_digest(m))
    var found = 0
    var absent = 0
    for i in 0..40000 {
        if (m[i << 20] ?? -1) == i {
            found += 1
        }
        if m[(i << 20) + 1] == none {
            absent += 1
        }
    }
    print("{found} {absent}")
    for i in 0..20000 {
        if i % 3 != 0 {
            delete(mut m, i << 20)
        }
    }
    print(m.len)
    for i in 0..20000 {
        if i % 3 == 1 {
            m[i << 20] = i * 2
        }
    }
    print(m.len)
    print(order_digest(m))
    print(first_keys(m, 8).len)
    let keys = first_keys(m, 6)
    for k in keys {
        print("{k} {m[k] ?? -99}")
    }
    m[0] = 5
    m[-1] = 6
    m[9223372036854775807] = 7
    m[-9223372036854775807 - 1] = 8
    print("{m[0] ?? -99} {m[-1] ?? -99} {m[9223372036854775807] ?? -99} {m[-9223372036854775807 - 1] ?? -99}")
    delete(mut m, -1)
    print(m[-1] == none)
    m[-1] = 11
    print(m[-1] ?? -99)
}

fn tombstones() {
    var m: [i64: i64] = [:]
    var rounds = 0
    for rounds < 40 {
        for i in 0..500 {
            m[rounds * 1000 + i] = i
        }
        for i in 0..500 {
            delete(mut m, rounds * 1000 + i)
        }
        rounds += 1
    }
    print(m.len)
    for i in 0..300 {
        m[i * 64] = i
    }
    for i in 0..300 {
        delete(mut m, i * 64)
        m[i * 64 + 1] = i
        m[i * 64] = -i
    }
    print(m.len)
    print(order_digest(m))
    var sum = 0
    for i in 0..300 {
        sum += (m[i * 64] ?? 0) + (m[i * 64 + 1] ?? 0)
    }
    print(sum)
}

fn string_keys() {
    var m: [str: i64] = [:]
    for i in 0..6000 {
        let key = "common-prefix-that-is-long-{i % 1500}-suffix"
        m[key] += i
    }
    for i in 0..3000 {
        let key = "k{i}"
        m[key] = i
    }
    print(m.len)
    print(str_digest(m))
    for i in 0..3000 {
        if i % 2 == 0 {
            delete(mut m, "k{i}")
        }
    }
    for i in 0..1500 {
        if i % 5 == 0 {
            delete(mut m, "common-prefix-that-is-long-{i}-suffix")
        }
    }
    print(m.len)
    print(str_digest(m))
    var hits = 0
    for i in 0..3000 {
        if m["k{i}"] != none {
            hits += 1
        }
    }
    print(hits)
    var lengths = 0
    for length in 0..40 {
        var key = ""
        for i in 0..length {
            key = "{key}q"
        }
        m[key] = length
        lengths += m[key] ?? -1
    }
    print(lengths)
    print(m[""] ?? -1)
    print(m.len)
}

fn insertion_order() {
    var m: [i64: i64] = [:]
    for i in 0..50 {
        m[(i * 37) % 101] = i
    }
    m[37] = 1000
    delete(mut m, 74)
    m[74] = 2000
    var line = ""
    for k, v in m {
        line = "{line} {k}:{v}"
    }
    print(line)
}

fn main() {
    integer_keys()
    tombstones()
    string_keys()
    insertion_order()
}
