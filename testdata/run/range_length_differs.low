fn count(xs: []u8, limit: i64) -> i64 {
    var seen = 0
    var j = 0
    for j < limit {
        seen += i64(xs[j]) + 1
        j += 1
    }
    seen
}

fn main() {
    var long: []u8 = []
    for i in 0..100 {
        push(mut long, u8(0))
    }
    var short: []u8 = []
    for i in 0..40 {
        push(mut short, u8(0))
    }
    print(count(long, 60))
    print(count(short, 60))
}
