struct Handler {
    name: str
    run: fn(i64) -> i64
    events: chan[str]
}

struct Mapping {
    base: ptr[u8]
    size: i64
}

fn double(x: i64) -> i64 {
    x * 2
}

fn add(a: i64, b: i64) -> i64 {
    a + b
}

fn main() {
    let offset = 3
    let handler = Handler { name: "h", run: fn(x) { x + offset }, events: chan[str](4) }
    print(handler)
    print("handler: {handler}")

    let f: fn(i64) -> i64 = double
    print(f)
    print(add)
    print("{f} and {add}")

    let jobs = chan[i64](1)
    print(jobs)

    let nothing: ptr[u8] = null
    print(nothing)
    let untyped: ptr = null
    print(untyped)
    print(Mapping { base: null, size: 0 })

    let live = bytes("abc")
    let address = pin(live)
    let text = "{address}"
    print(text.len > 5)
    print(text[0..6])
    unpin(address)
}
