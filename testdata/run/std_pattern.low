fn format_matrix() {
    let rows = matrix_rows()
    let layouts = matrix_layouts()
    for i, row in rows {
        let dt = dt_of(row)
        print("-- {datetime.to_string(dt)}")
        for layout in layouts {
            show_format(i, dt, layout)
        }
    }
}

