    let o7 = pattern.Fields { offset_seconds: -93599 }
    let o8 = pattern.Fields { offset_seconds: -1 }
    let o9 = pattern.Fields { offset_seconds: 45 }
    let o10 = pattern.Fields { offset_seconds: -3600 }
    show_render("%z", o0)
    show_render("%:z", o0)
