fn french() -> pattern.Names {
    pattern.Names {
        months: ["janvier", "février", "mars", "avril", "mai", "juin", "juillet", "août", "septembre", "octobre", "novembre", "décembre"],
        short_months: ["janv.", "févr.", "mars", "avr.", "mai", "juin", "juil.", "août", "sept.", "oct.", "nov.", "déc."],
        weekdays: ["lundi", "mardi", "mercredi", "jeudi", "vendredi", "samedi", "dimanche"],
        short_weekdays: ["lun.", "mar.", "mer.", "jeu.", "ven.", "sam.", "dim."],
        am: "du matin",
        pm: "de l'après-midi"
    }
}

fn prefixed() -> pattern.Names {
    pattern.Names {
        months: ["m1", "m10", "m11", "m12", "m2", "m3", "m4", "m5", "m6", "m7", "m8", "m9"],
        short_months: ["a", "b", "c", "d", "e", "f", "g", "h", "i", "j", "k", "l"],
        weekdays: ["d1", "d2", "d3", "d4", "d5", "d6", "d7"],
        short_weekdays: ["w1", "w2", "w3", "w4", "w5", "w6", "w7"],
        am: "a.m.",
        pm: "p.m."
    }
}

fn short_names() -> pattern.Names {
    pattern.Names {
        months: ["a"],
        short_months: [],
        weekdays: [],
        short_weekdays: [],
        am: "AM",
        pm: "PM"
    }
}

fn names_cases() {
    let dt = datetime.of(2026, 11, 11, 15, 5, 9, 0) catch { e => return print("bad") }
    let christmas = datetime.of(2027, 2, 5, 0, 30, 0, 0) catch { e => return print("bad") }
    show_named(dt, "%A %-d %B %Y %H:%M %p", french())
    show_named(dt, "%a %d %b %Y", french())
    show_named(dt, "%^A %^B", french())
    show_named(dt, "%-I:%M %P", french())
    show_named(dt, "%^p", french())
    show_named(christmas, "%A %-d %B %Y %H:%M %p", french())
    show_named(christmas, "%a %d %b %Y", french())
    show_named(christmas, "%^A %^B", french())
    show_named(christmas, "%-I:%M %P", french())
    show_named(christmas, "%^p", french())
    show_named(dt, "%B", short_names())
    show_parse_named("%A %d %B %Y %H:%M", "mercredi 11 novembre 2026 15:05", french())
    show_parse_named("%a %d %b %Y %H", "mer. 11 nov. 2026 15", french())
    show_parse_named("%a %d %b %Y %H", "MER. 11 NOV. 2026 15", french())
    show_parse_named("%a %d %b %Y %H", "mer. 11 févr. 2026 15", french())
    show_parse_named("%a %d %b %Y %H", "mer. 11 fevr. 2026 15", french())
    show_parse_named("%d %B %Y %I %p", "5 février 2027 12 du matin", french())
    show_parse_named("%d %B %Y %I %p", "5 février 2027 12 de l'après-midi", french())
    show_parse_named("%d %B %Y %I %P", "5 FÉVRIER 2027 12 du matin", french())
    show_parse_named("%d %B %Y %I %P", "5 février 2027 3 DE L'APRÈS-MIDI", french())
    show_parse_named("%d %B %Y %I %P", "5 août 2027 3 de l'après-midi", french())
    show_parse_named("%d %B %Y %I %p", "5 February 2027 12 AM", french())
    show_parse_named("%d %B %Y %H", "5 mars 2027 1", french())
    show_scan_names("%B", "m11", prefixed())
    show_scan_names("%B", "m1", prefixed())
    show_scan_names("%B", "m10", prefixed())
    show_scan_names("%B", "m12", prefixed())
    show_scan_names("%B", "m2", prefixed())
    show_scan_names("%B", "m9", prefixed())
    show_scan_names("%B", "M9", prefixed())
    show_scan_names("%B", "m13", prefixed())
    show_scan_names("%B", "m", prefixed())
    show_scan_names("%b", "l", prefixed())
    show_scan_names("%A", "d7", prefixed())
    show_scan_names("%a", "w3", prefixed())
    show_scan_names("%p", "P.M.", prefixed())
    show_scan_names("%P", "a.m.", prefixed())
    show_scan_names("%p", "AM", prefixed())
}

