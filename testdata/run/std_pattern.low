import std/text
import std/time/date
import std/time/datetime
import std/time/fault
import std/time/pattern
import std/time/timeofday

fn describe(e: fault.Fault) -> str {
    match e {
        Syntax(at) => "syntax {at}"
        Overflow => "overflow"
        Invalid(what) => "invalid {what}"
        OutOfRange(what) => "range {what}"
        Unsupported(what) => "unsupported {what}"
        _ => fault.to_string(e)
    }
}

fn visible(s: str) -> str {
    text.replace(text.replace(s, "\n", "\\n"), "\t", "\\t")
}

fn dt_of(row: []i64) -> datetime.DateTime {
    datetime.of(row[0], row[1], row[2], row[3], row[4], row[5], row[6]) catch {
        e => return datetime.epoch()
    }
}

fn show_format(i: i64, dt: datetime.DateTime, layout: str) {
    let result = datetime.format(dt, layout) catch {
        e => return print("F{i} {visible(layout)} !{describe(e)}")
    }
    print("F{i} {visible(layout)} [{visible(result)}]")
}

fn show_compile(layout: str) {
    let p = pattern.compile(layout) catch {
        e => return print("C {visible(layout)} !{describe(e)}")
    }
    print("C {visible(layout)} ok")
}

fn show_parse(layout: str, input: str) {
    let dt = datetime.parse_with(input, layout) catch {
        e => return print("P {visible(layout)} | {visible(input)} !{describe(e)}")
    }
    print("P {visible(layout)} | {visible(input)} = {datetime.to_string(dt)}")
}

fn show_parse_date(layout: str, input: str) {
    let d = date.parse_with(input, layout) catch {
        e => return print("PD {visible(layout)} | {visible(input)} !{describe(e)}")
    }
    print("PD {visible(layout)} | {visible(input)} = {date.to_string(d)}")
}

fn show_parse_time(layout: str, input: str) {
    let t = timeofday.parse_with(input, layout) catch {
        e => return print("PT {visible(layout)} | {visible(input)} !{describe(e)}")
    }
    print("PT {visible(layout)} | {visible(input)} = {timeofday.to_string(t)}")
}

fn show_format_date(d: date.Date, layout: str) {
    let result = date.format(d, layout) catch {
        e => return print("FD {date.to_string(d)} {visible(layout)} !{describe(e)}")
    }
    print("FD {date.to_string(d)} {visible(layout)} [{visible(result)}]")
}

fn show_format_time(t: timeofday.TimeOfDay, layout: str) {
    let result = timeofday.format(t, layout) catch {
        e => return print("FT {timeofday.to_string_full(t)} {visible(layout)} !{describe(e)}")
    }
    print("FT {timeofday.to_string_full(t)} {visible(layout)} [{visible(result)}]")
}

fn note(mut parts: []str, name: str, v: i64?) {
    let n = v ?? return
    push(mut parts, "{name}={n}")
}

fn fields_line(f: pattern.Fields) -> str {
    var parts: []str = []
    note(mut parts, "year", f.year)
    note(mut parts, "month", f.month)
    note(mut parts, "day", f.day)
    note(mut parts, "yday", f.day_of_year)
    note(mut parts, "wday", f.weekday)
    note(mut parts, "isoyear", f.iso_year)
    note(mut parts, "isoweek", f.iso_week)
    note(mut parts, "wsun", f.week_sunday)
    note(mut parts, "wmon", f.week_monday)
    note(mut parts, "century", f.century)
    note(mut parts, "yy", f.year_of_century)
    note(mut parts, "hour", f.hour)
    note(mut parts, "hour12", f.hour12)
    note(mut parts, "period", f.period)
    note(mut parts, "minute", f.minute)
    note(mut parts, "second", f.second)
    note(mut parts, "nano", f.nanosecond)
    note(mut parts, "offset", f.offset_seconds)
    let zone = f.zone_abbreviation ?? ""
    if zone != "" {
        push(mut parts, "zone={zone}")
    }
    note(mut parts, "unix", f.unix_seconds)
    text.join(parts, " ")
}

fn show_scan_names(layout: str, input: str, names: pattern.Names) {
    let p = pattern.compile(layout) catch {
        e => return print("S {visible(layout)} | {visible(input)} !compile {describe(e)}")
    }
    let f = pattern.scan(p, input, names) catch {
        e => return print("S {visible(layout)} | {visible(input)} !{describe(e)}")
    }
    print("S {visible(layout)} | {visible(input)} = {fields_line(f)}")
}

fn show_scan(layout: str, input: str) {
    show_scan_names(layout, input, pattern.english())
}

fn show_render_names(layout: str, f: pattern.Fields, names: pattern.Names) {
    let p = pattern.compile(layout) catch {
        e => return print("R {visible(layout)} !compile {describe(e)}")
    }
    let result = pattern.render(p, f, names) catch {
        e => return print("R {visible(layout)} !{describe(e)}")
    }
    print("R {visible(layout)} [{visible(result)}]")
}

fn show_render(layout: str, f: pattern.Fields) {
    show_render_names(layout, f, pattern.english())
}

fn show_uses(layout: str) {
    let p = pattern.compile(layout) catch {
        e => return print("U {layout} !{describe(e)}")
    }
    let u = pattern.uses(p)
    print("U {layout} date={u.date} time={u.time} offset={u.offset} zone={u.zone} unix={u.unix}")
}

