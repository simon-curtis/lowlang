fn roundtrip_cases() {
    let rows = rt_rows()
    let layouts = rt_layouts()
    for layout in layouts {
        var ok = 0
        var skipped = 0
        for row in rows {
            let dt = dt_of(row)
            let formatted = datetime.format(dt, layout) catch {
                e => {
                    skipped += 1
                    continue
                }
            }
            let back = datetime.parse_with(formatted, layout) catch {
                e => {
                    print("FAIL {visible(layout)} [{formatted}] {describe(e)}")
                    continue
                }
            }
            if datetime.equal(back, dt) {
                ok += 1
            } else {
                print("FAIL {visible(layout)} [{formatted}] {datetime.to_string(back)}")
            }
        }
        print("RT {visible(layout)} ok={ok} skipped={skipped}")
    }
    let layout = "%Y-%m-%dT%H:%M:%S.%N %a %j %G-W%V-%u"
    for row in rows {
        let dt = dt_of(row)
        show_format(0, dt, layout)
    }
    let date_layout = "%G-W%V-%u"
    var date_ok = 0
    for row in rows {
        let d = date.of(row[0], row[1], row[2]) catch { e => continue }
        let formatted = date.format(d, date_layout) catch { e => continue }
        let back = date.parse_with(formatted, date_layout) catch { e => continue }
        if date.equal(back, d) {
            date_ok += 1
        }
    }
    print("RT date iso ok={date_ok}")
    var time_ok = 0
    for row in rows {
        let t = timeofday.of(row[3], row[4], row[5], row[6]) catch { e => continue }
        let formatted = timeofday.format(t, "%I:%M:%S.%N %p") catch { e => continue }
        let back = timeofday.parse_with(formatted, "%I:%M:%S.%N %p") catch { e => continue }
        if timeofday.equal(back, t) {
            time_ok += 1
        }
    }
    print("RT time 12h ok={time_ok}")
}

fn rt_layouts() -> []str {
    [
        "%Y-%m-%d %H:%M:%S.%N",
        "%e/%m/%Y %I:%M:%S.%N %p",
        "%A, %d %B %Y %H:%M:%S.%N",
        "%G-W%V-%u %H:%M:%S.%N",
        "%Y-%j %H:%M:%S.%N",
        "%-d.%-m.%Y %-H:%-M:%-S,%N",
        "%^a %^b %_d %Y %I:%M:%S.%N %P",
        "%C%y-%m-%d %T.%N",
        "%a %U %W %w %Y %j %H:%M:%S.%N"
    ]
}

fn compiled_cases() {
    let p = pattern.compile("%a %d %b %Y %H:%M:%S.%f") catch { e => return print("compile failed") }
    let rows = matrix_rows()
    for row in rows {
        let dt = dt_of(row)
        let formatted = datetime.format_with(dt, p) catch { e => return print("format failed") }
        let back = datetime.parse_pattern(formatted, p) catch { e => return print("CP [{formatted}] !{describe(e)}") }
        print("CP [{formatted}] = {datetime.to_string(back)}")
    }
    let dp = pattern.compile("%G-W%V-%u %A") catch { e => return print("compile failed") }
    for row in rows {
        let d = date.of(row[0], row[1], row[2]) catch { e => return print("bad date") }
        let formatted = date.format_with(d, dp) catch { e => return print("format failed") }
        let back = date.parse_pattern(formatted, dp) catch { e => return print("CD [{formatted}] !{describe(e)}") }
        print("CD [{formatted}] = {date.to_string(back)}")
    }
    let tp = pattern.compile("%I.%M.%S %p") catch { e => return print("compile failed") }
    for row in rows {
        let t = timeofday.of(row[3], row[4], row[5], row[6]) catch { e => return print("bad time") }
        let formatted = timeofday.format_with(t, tp) catch { e => return print("format failed") }
        let back = timeofday.parse_pattern(formatted, tp) catch { e => return print("CT [{formatted}] !{describe(e)}") }
        print("CT [{formatted}] = {timeofday.to_string(back)}")
    }
}

fn show_named(dt: datetime.DateTime, layout: str, names: pattern.Names) {
    let p = pattern.compile(layout) catch {
        e => return print("N {visible(layout)} !compile {describe(e)}")
    }
    let result = datetime.format_names(dt, p, names) catch {
        e => return print("N {datetime.to_string(dt)} {visible(layout)} !{describe(e)}")
    }
    print("N {datetime.to_string(dt)} {visible(layout)} [{visible(result)}]")
}

fn show_parse_named(layout: str, input: str, names: pattern.Names) {
    let p = pattern.compile(layout) catch {
        e => return print("PN {visible(layout)} !compile {describe(e)}")
    }
    let dt = datetime.parse_names(input, p, names) catch {
        e => return print("PN {visible(layout)} | {visible(input)} !{describe(e)}")
    }
    print("PN {visible(layout)} | {visible(input)} = {datetime.to_string(dt)}")
}

fn section(name: str) {
    print("== {name}")
}

fn main() {
    section("format matrix")
    format_matrix()
    section("compile")
    compile_cases()
    section("parse matrix")
    parse_matrix()
    section("parse cases")
    parse_cases()
    section("date wrappers")
    date_cases()
    section("time wrappers")
    time_cases()
    section("format wrappers")
    format_wrappers()
    section("scan")
    scan_cases()
    section("render")
    render_cases()
    section("uses")
    uses_cases()
    section("names")
    names_cases()
    section("compiled")
    compiled_cases()
    section("round trips")
    roundtrip_cases()
}
