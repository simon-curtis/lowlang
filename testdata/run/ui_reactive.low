import std/ui

fn lazy(cx: ui.Context) {
    print("lazy")
    let a = cx.signal(2)
    var runs = 0
    let double = cx.memo(fn() -> i64 {
        runs += 1
        a.get() * 2
    })
    print("unread runs {runs}")
    let first = double.read()
    print("read {first} runs {runs}")
    let again = double.read()
    print("again {again} runs {runs}")
    a.set(3)
    print("set runs {runs}")
    let changed = double.read()
    print("read {changed} runs {runs}")
}

fn cutoff(cx: ui.Context) {
    print("cutoff")
    let a = cx.signal(2)
    var parities = 0
    let parity = cx.memo(fn() -> i64 {
        parities += 1
        a.get() % 2
    })
    var runs = 0
    var seen = -1
    cx.effect(fn() {
        runs += 1
        seen = parity.read()
    })
    print("effect runs {runs} seen {seen}")
    a.set(4)
    cx.dispatch(Woken)
    print("even runs {runs} parities {parities}")
    a.set(5)
    cx.dispatch(Woken)
    print("odd runs {runs} seen {seen} parities {parities}")
}

fn effects(cx: ui.Context) {
    print("effects")
    let a = cx.signal(1)
    let b = cx.signal(10)
    var log = ""
    let e = cx.effect(fn() {
        let sum = a.get() + b.get()
        log = "{log} {sum}"
    })
    a.set(2)
    b.set(20)
    print("batched before flush{log}")
    cx.dispatch(Woken)
    print("flushed{log}")
    ui.dispose(e)
    a.set(3)
    cx.dispatch(Woken)
    print("disposed{log}")
}

fn dynamic(cx: ui.Context) {
    print("dynamic")
    let left = cx.signal(true)
    let a = cx.signal(1)
    let b = cx.signal(100)
    var runs = 0
    var seen = 0
    cx.effect(fn() {
        runs += 1
        seen = if left.get() { a.get() } else { b.get() }
    })
    left.set(false)
    cx.dispatch(Woken)
    print("switched runs {runs} seen {seen}")
    a.set(2)
    cx.dispatch(Woken)
    print("old source runs {runs}")
    b.set(200)
    cx.dispatch(Woken)
    print("new source runs {runs} seen {seen}")
}

fn chain(cx: ui.Context) {
    print("chain")
    let a = cx.signal(1)
    var doubles = 0
    var nexts = 0
    let double = cx.memo(fn() -> i64 {
        doubles += 1
        a.get() * 2
    })
    let next = cx.memo(fn() -> i64 {
        nexts += 1
        double.read() + 1
    })
    let first = next.read()
    print("first {first} doubles {doubles} nexts {nexts}")
    a.set(5)
    let second = next.read()
    print("second {second} doubles {doubles} nexts {nexts}")
}

fn cascade(cx: ui.Context) {
    print("cascade")
    let a = cx.signal(1)
    let b = cx.signal(0)
    var seen = 0
    cx.effect(fn() b.set(a.get() * 10))
    cx.effect(fn() {
        seen = b.get()
    })
    print("start {seen}")
    a.set(4)
    cx.dispatch(Woken)
    print("cascaded {seen}")
}

fn main() {
    let cx = ui.headless(ui.rgb(0xffffff))
    lazy(cx)
    cutoff(cx)
    effects(cx)
    dynamic(cx)
    chain(cx)
    cascade(cx)
    feedback(cx)
}

fn feedback(cx: ui.Context) {
    print("feedback")
    let x = cx.signal(1)
    let double = cx.memo(fn() -> i64 { x.get() * 2 })
    var runs = 0
    var log = ""
    cx.effect(fn() {
        runs += 1
        let d = double.read()
        log = "{log} {d}"
        if d > 20 {
            x.set(10)
        }
    })
    x.set(15)
    cx.dispatch(Woken)
    x.set(3)
    cx.dispatch(Woken)
    x.set(4)
    cx.dispatch(Woken)
    print("seen{log} runs {runs}")
}
