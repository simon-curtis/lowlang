import std/ui
import std/ui/font
import std/ui/geometry
import std/ui/scene
import std/slices
import uitext = std/ui/text

fn show(r: geometry.Rect) -> str {
    "{r.x} {r.y} {r.width} {r.height}"
}

fn tint(c: geometry.Color) -> str {
    "{c.r},{c.g},{c.b},{c.a}"
}

fn quads(sc: scene.Scene) {
    for q in sc.quads {
        print("  quad {show(q.bounds)} {tint(q.background)}")
    }
}

fn metrics() {
    let f = font.fallback()
    print("underline {f.underline_position} {f.underline_thickness} strikeout {f.strikeout_position} {f.strikeout_size}")
}

fn offsets() {
    var sys = uitext.default_system()
    let l = sys.wrap("añb\n€ c", uitext.Format { size: 16.0 }, 1000.0)
    for line in l.lines {
        var parts: []i64 = []
        for g in line.glyphs {
            parts.push(g.at)
        }
        print("offsets {parts}")
    }
}

fn direct() {
    print("direct")
    var sys = uitext.default_system()
    let l = sys.wrap("abc def ", uitext.Format { size: 16.0 }, 1000.0)
    let red = geometry.rgb(0xff0000)
    let blue = geometry.rgb(0x0000ff)
    let marks: []uitext.Highlight = [
        uitext.Highlight { start: 0, end: 3, color: red }
        uitext.Highlight { start: 2, end: 5, background: blue }
        uitext.Highlight { start: 4, end: 8, underline: uitext.Decoration {} }
        uitext.Highlight { start: 5, end: 6, underline: uitext.Decoration { color: red, thickness: 2.0 } }
    ]
    var sc = scene.empty(200, 50, geometry.rgb(0xffffff))
    sys.paint(mut sc, l, geometry.point(10.0, 5.0), geometry.rgb(0x000000), marks, 1.0)
    print("glyph x {l.lines[0].glyphs.map(fn(g) g.x)} width {l.lines[0].width}")
    var colors: []str = []
    for s in sc.sprites {
        colors.push(tint(s.color))
    }
    print("sprites {colors}")
    quads(sc)
    for b in sc.batches() {
        print("  batch {b.kind} {b.first} {b.count}")
    }
    var struck = scene.empty(200, 50, geometry.rgb(0xffffff))
    let through: []uitext.Highlight = [uitext.Highlight { start: 0, end: 3, strikethrough: uitext.Decoration { wavy: true } }]
    let before = struck.sprites.len
    sys.paint(mut struck, sys.wrap("abc", uitext.Format { size: 16.0 }, 1000.0), geometry.point(0.0, 0.0), red, through, 2.0)
    let wave = struck.sprites[struck.sprites.len - 1]
    print("wavy sprites {struck.sprites.len - before} wave {show(wave.bounds)} {tint(wave.color)}")
}

fn inherited(cx: ui.Context) {
    print("inherited")
    let view = fn() -> ui.Element {
        ui.div().column().underline(uitext.Decoration { color: ui.rgb(0x00ff00) }).opacity(0.5).children() {
            ui.text("ab").highlights([uitext.Highlight { start: 1, end: 2, background: ui.rgb(0x0000ff), strikethrough: uitext.Decoration {} }])
            ui.text("cd").strikethrough(uitext.Decoration {})
        }
    }
    let sc = cx.frame(view, geometry.size(100.0, 60.0), 1.0)
    quads(sc)
}

fn main() {
    metrics()
    offsets()
    direct()
    inherited(ui.headless(ui.rgb(0xffffff)))
}
