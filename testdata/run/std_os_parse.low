import std/os

fn passwd_text() -> str {
    let lines = [
        "root:x:0:0:root:/root:/bin/bash"
        "# comment:x:5:5:c:/c:/c"
        "daemon:x:1:1:daemon:/usr/sbin:/usr/sbin/nologin"
        ""
        "short:x:2"
        "bad:x:abc:3:Bad:/home/bad:/bin/sh"
        "nogid:x:4:zz:Bad:/home/nogid:/bin/sh"
        "alice:x:1000:1000:Alice Example,,,:/home/alice:/bin/zsh"
        "extra:x:1001:1001:a:/h:/bin/sh:more:fields"
        "+::::::"
        "empty:x:7:7:::"
    ]
    var out = ""
    for line in lines {
        out = "{out}{line}\n"
    }
    out
}

fn group_text() -> str {
    let lines = [
        "root:x:0:"
        "daemon:x:1:alice,bob"
        "# comment:x:9:alice"
        "short:x:2"
        "sudo:x:27:alice,,bob,"
        "bad:x:zz:alice"
        "users:x:100:carol"
    ]
    var out = ""
    for line in lines {
        out = "{out}{line}\n"
    }
    out
}

fn show_users() {
    for u in os.parse_passwd(passwd_text()) {
        print("user {u.name} {u.uid} {u.gid} [{u.home}] [{u.shell}]")
    }
    print("users of empty {os.parse_passwd("").len}")
    print("users of newline {os.parse_passwd("\n\n").len}")
}

fn show_groups() {
    for g in os.parse_group(group_text()) {
        print("group {g.name} {g.gid} {g.members}")
    }
    print("groups of empty {os.parse_group("").len}")
}

fn mountinfo_text() -> str {
    let lines = [
        "22 28 0:21 / /sys rw,nosuid,nodev,noexec,relatime shared:7 - sysfs sysfs rw"
        "36 35 98:0 /mnt1 /mnt2 rw,noatime master:1 - ext3 /dev/root rw,errors=continue"
        "29 22 0:26 / /sys/fs/cgroup rw,nosuid,nodev,noexec,relatime shared:9 - cgroup2 cgroup2 rw,nsdelegate,memory_recursiveprot"
        "40 29 0:27 /system.slice/my\\040service /mnt/with\\040space\\011tab rw - cgroup2 cgroup2 rw"
        "41 29 0:28 /plain /mnt/odd\\1x\\4009 rw master:2 shared:3 - tmpfs tmpfs rw"
        "garbage"
        "1 2 3 / /x rw"
        "1 2 0:1 / /x rw shared:1 - ext4"
        "1 2 0:1 / /x rw shared:1 foo bar baz"
        ""
    ]
    var out = ""
    for line in lines {
        out = "{out}{line}\n"
    }
    out
}

fn show_mounts() {
    for m in os.parse_mountinfo(mountinfo_text()) {
        print("mount [{m.root}] [{m.point}] {m.fs}")
    }
    print("mounts of empty {os.parse_mountinfo("").len}")
}

fn place(proc_cgroup: str, mounts: os.Mount[]) -> str {
    let found = os.locate_cgroup(proc_cgroup, mounts) ?? return "none"
    "{found.mount} {found.path}"
}

fn show_locate() {
    let mounts = os.parse_mountinfo(mountinfo_text())
    print(place("0::/user.slice/session-1.scope\n", mounts))
    print(place("12:cpu,cpuacct:/foo\n1:name=systemd:/a\n0::/\n", mounts))
    print(place("12:cpu,cpuacct:/foo\n1:name=systemd:/a\n", mounts))
    print(place("", mounts))
    print(place("0::\n", mounts))
    print(place("0::relative\n", mounts))
    print(place("0::/x (deleted)\n", mounts))
    let rooted = [os.Mount { root: "/a", point: "/cg", fs: "cgroup2" }]
    print(place("0::/a/b\n", rooted))
    print(place("0::/a\n", rooted))
    print(place("0::/ab\n", rooted))
    print(place("0::/\n", rooted))
    let first = [os.Mount { root: "/a", point: "/one", fs: "cgroup2" }, os.Mount { root: "/", point: "/two", fs: "cgroup2" }]
    print(place("0::/b\n", first))
    let wrong = [os.Mount { root: "/", point: "/cg", fs: "cgroup" }]
    print(place("0::/b\n", wrong))
    print(place("0::/b\n", []))
}

fn memory(content: str) -> str {
    let value = os.parse_memory_limit(content) catch {
        Malformed => return "malformed"
        _ => return "other"
    }
    match value {
        some(n) => "{n}"
        none => "unlimited"
    }
}

fn cpu(content: str) -> str {
    let value = os.parse_cpu_max(content) catch {
        Malformed => return "malformed"
        _ => return "other"
    }
    match value {
        some(l) => "{l.quota} {l.period} {l.cpus}"
        none => "unlimited"
    }
}

fn show_values() {
    for content in ["max\n", "1048576\n", " 42 ", "0", "9223372036854771712\n", "", "\n", "-1", "12x", "1 2", "99999999999999999999", "max max"] {
        print("memory [{content}] {memory(content)}")
    }
    for content in ["max 100000\n", "50000 100000\n", "150000 100000", "200000\n", "max", "100000 50000", "1 3", "", "0 100000", "50000 0", "-5 100000", "a b", "1 2 3", "max 0", "max x"] {
        print("cpu [{content}] {cpu(content)}")
    }
}

fn main() {
    show_users()
    show_groups()
    show_mounts()
    show_locate()
    show_values()
}
