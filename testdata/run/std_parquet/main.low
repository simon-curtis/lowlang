import std/parquet

fn dump_all() {
    var group = ""
    for f in fixtures() {
        if f.group != group {
            group = f.group
            if group != "files" {
                print("directory {group}")
            }
        }
        let lines = dump(f.name, f.data, f.group == "files") catch {
            _ => ["file {f.name}", "error"]
        }
        for line in lines {
            print(line)
        }
    }
}

fn main() {
    dump_all()
    api_reading() catch {
        e => print("api failed: {parquet.message(e)}")
    }
    rows_reading() catch {
        e => print("rows failed: {parquet.message(e)}")
    }
    writing() catch {
        e => print("writing failed: {parquet.message(e)}")
    }
    read_errors()
    checksum_cases()
    limit_cases()
    sweeps()
    reader_misuse()
    schema_cases()
    path_cases()
}
