import std/arrow
import std/text
import std/parquet

fn find(name: str) -> u8[] {
    for f in fixtures() {
        if f.name == "{name}.parquet" {
            return f.data
        }
    }
    panic("no fixture {name}")
}

fn open_fixture(name: str) -> *parquet.FileReader ! parquet.Error {
    parquet.open_bytes(find(name), parquet.ReaderOptions {})?
}

fn project(name: str, columns: str[], group: i64) ! parquet.Error {
    let f = open_fixture(name)?
    print("projection {name} {text.join(columns, ",")} group {group}")
    let b = parquet.read_row_group(f, group, columns)?
    for line in batch_lines(b) {
        print(line)
    }
}

fn column(name: str, field: str, group: i64) ! parquet.Error {
    let f = open_fixture(name)?
    let a = parquet.read_column(f, group, field)?
    print("column {name} {field} group {group} {arrow.diagnostic(a)}")
}

fn selection(name: str, field: str, low: i64, high: i64) ! parquet.Error {
    let f = open_fixture(name)?
    let groups = parquet.select_row_groups(f, field, low, high)?
    var parts: str[] = []
    for g in groups {
        parts.push("{g}")
    }
    print("select {name} {field} {low} {high} [{text.join(parts, ", ")}]")
}

fn api_reading() ! parquet.Error {
    print("api")
    project("flat_snappy_v2", ["s", "i32", "req"], 0)?
    project("nested_v1_snappy", ["m", "li", "st"], 0)?
    project("nested_groups", ["ll", "rs"], 2)?
    project("flat_groups_v2", ["b", "dec10"], 3)?
    column("nested_v1_snappy", "ll", 0)?
    column("flat_pages_v1", "s_unique", 0)?
    column("flat_groups", "ts_us", 1)?
    selection("flat_groups", "req", 5, 12)?
    selection("flat_groups", "req", -100, -50)?
    selection("flat_groups_v2", "u8", 100, 130)?
    selection("flat_groups_v2", "i64", -5, 5)?
    selection("flat_v1_dict", "i32", 0, 0)?
    let f = open_fixture("flat_groups_v2")?
    print("batches flat_groups_v2 {parquet.row_group_count(f)}")
}
