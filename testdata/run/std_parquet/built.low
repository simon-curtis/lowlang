import std/arrow

fn leaf(name: str, t: arrow.DataType) -> arrow.Field {
    arrow.Field { name, data_type: t }
}

fn element(t: arrow.DataType) -> *arrow.Field {
    new(leaf("item", t))
}

fn int32() -> arrow.DataType {
    arrow.DataType.Int(32, true)
}

fn built_fields() -> []arrow.Field {
    let tagged = arrow.Field { name: "i", data_type: int32(), metadata: ["PARQUET:field_id": "7"] }
    let entries = arrow.Field { name: "entries", data_type: arrow.DataType.Struct([
        arrow.Field { name: "key", data_type: arrow.DataType.Utf8, nullable: false },
        leaf("value", int32()),
    ]), nullable: false }
    [
        leaf("b", arrow.DataType.Bool),
        tagged,
        leaf("u16", arrow.DataType.Int(16, false)),
        leaf("u64", arrow.DataType.Int(64, false)),
        leaf("f16", arrow.DataType.Float(16)),
        leaf("f32", arrow.DataType.Float(32)),
        leaf("f64", arrow.DataType.Float(64)),
        leaf("s", arrow.DataType.Utf8),
        leaf("ls", arrow.DataType.LargeUtf8),
        leaf("bin", arrow.DataType.Binary),
        leaf("fsb3", arrow.DataType.FixedSizeBinary(3)),
        leaf("dec", arrow.DataType.Decimal(10, 3)),
        leaf("date", arrow.DataType.Date(arrow.DateUnit.Day)),
        leaf("t64", arrow.DataType.Time(arrow.TimeUnit.Microsecond)),
        leaf("ts", arrow.DataType.Timestamp(arrow.TimeUnit.Microsecond, "UTC")),
        leaf("nulls", arrow.DataType.Null),
        leaf("l", arrow.DataType.List(element(int32()))),
        leaf("lg", arrow.DataType.LargeList(element(arrow.DataType.Utf8))),
        leaf("fsl", arrow.DataType.FixedSizeList(element(arrow.DataType.Int(8, true)), 2)),
        leaf("st", arrow.DataType.Struct([leaf("x", int32()), leaf("y", arrow.DataType.Utf8)])),
        leaf("map", arrow.DataType.Map(new(entries), false)),
        leaf("d", arrow.DataType.Dictionary(0, new(arrow.DataType.Int(8, true)), new(arrow.DataType.Utf8), false)),
        leaf("di", arrow.DataType.Dictionary(1, new(arrow.DataType.Int(32, true)), new(arrow.DataType.Int(64, true)), false)),
        arrow.Field { name: "req", data_type: int32(), nullable: false },
        arrow.Field { name: "rst", data_type: arrow.DataType.Struct([arrow.Field { name: "z", data_type: arrow.DataType.Float(64), nullable: false }]), nullable: false },
    ]
}

pub fn built_schema() -> arrow.Schema {
    arrow.Schema { fields: built_fields(), metadata: ["made": "builder", "owner": "low"] }
}

fn built_builder(k: i64) -> *arrow.Builder ! arrow.Error {
    arrow.builder(built_fields()[k].data_type)
}

fn built_bools() -> arrow.Array ! arrow.Error {
    let b = built_builder(0)?
    arrow.append_bool(b, true)?
    arrow.append_null(b)?
    arrow.append_bool(b, false)?
    arrow.finish(b)?
}

fn built_small_ints() -> arrow.Array ! arrow.Error {
    let b = built_builder(1)?
    arrow.append_int(b, 1)?
    arrow.append_null(b)?
    arrow.append_int(b, -3)?
    arrow.finish(b)?
}

fn built_unsigned16() -> arrow.Array ! arrow.Error {
    let b = built_builder(2)?
    arrow.append_uint(b, 0)?
    arrow.append_uint(b, 65535)?
    arrow.append_null(b)?
    arrow.finish(b)?
}

fn built_unsigned64() -> arrow.Array ! arrow.Error {
    let b = built_builder(3)?
    arrow.append_uint(b, 18446744073709551615)?
    arrow.append_null(b)?
    arrow.append_uint(b, 1)?
    arrow.finish(b)?
}

fn built_floats(k: i64, a: f64, c: f64) -> arrow.Array ! arrow.Error {
    let b = built_builder(k)?
    arrow.append_float(b, a)?
    arrow.append_null(b)?
    arrow.append_float(b, c)?
    arrow.finish(b)?
}

fn built_texts(k: i64) -> arrow.Array ! arrow.Error {
    let b = built_builder(k)?
    arrow.append_str(b, "a")?
    arrow.append_null(b)?
    arrow.append_str(b, "héllo")?
    arrow.finish(b)?
}

fn built_blobs() -> arrow.Array ! arrow.Error {
    let b = built_builder(9)?
    arrow.append_bytes(b, [0, 255])?
    arrow.append_null(b)?
    arrow.append_bytes(b, [])?
    arrow.finish(b)?
}

fn built_fixed() -> arrow.Array ! arrow.Error {
    let b = built_builder(10)?
    arrow.append_bytes(b, bytes("abc"))?
    arrow.append_null(b)?
    arrow.append_bytes(b, bytes("xyz"))?
    arrow.finish(b)?
}

fn built_decimals() -> arrow.Array ! arrow.Error {
    let b = built_builder(11)?
    arrow.append_decimal(b, "-12.500")?
    arrow.append_null(b)?
    arrow.append_decimal(b, "0.001")?
    arrow.finish(b)?
}

fn built_numbers(k: i64, a: i64, c: i64) -> arrow.Array ! arrow.Error {
    let b = built_builder(k)?
    arrow.append_int(b, a)?
    arrow.append_null(b)?
    arrow.append_int(b, c)?
    arrow.finish(b)?
}

fn built_nulls() -> arrow.Array ! arrow.Error {
    let b = built_builder(15)?
    arrow.append_null(b)?
    arrow.append_null(b)?
    arrow.append_null(b)?
    arrow.finish(b)?
}

fn built_lists() -> arrow.Array ! arrow.Error {
    let b = built_builder(16)?
    let kid = arrow.child(b, 0)?
    arrow.append_int(kid, 1)?
    arrow.append_null(kid)?
    arrow.end_list(b)?
    arrow.append_null(b)?
    arrow.end_list(b)?
    arrow.finish(b)?
}

fn built_large_lists() -> arrow.Array ! arrow.Error {
    let b = built_builder(17)?
    arrow.end_list(b)?
    let kid = arrow.child(b, 0)?
    arrow.append_str(kid, "p")?
    arrow.append_str(kid, "q")?
    arrow.end_list(b)?
    arrow.append_null(b)?
    arrow.finish(b)?
}

fn built_fixed_lists() -> arrow.Array ! arrow.Error {
    let b = built_builder(18)?
    let kid = arrow.child(b, 0)?
    arrow.append_int(kid, 1)?
    arrow.append_int(kid, 2)?
    arrow.end_list(b)?
    arrow.append_null(b)?
    arrow.append_int(kid, 3)?
    arrow.append_int(kid, 4)?
    arrow.end_list(b)?
    arrow.finish(b)?
}

fn built_structs() -> arrow.Array ! arrow.Error {
    let b = built_builder(19)?
    let x = arrow.child(b, 0)?
    let y = arrow.child(b, 1)?
    arrow.append_int(x, 1)?
    arrow.append_str(y, "p")?
    arrow.end_struct(b)?
    arrow.append_null(b)?
    arrow.append_null(x)?
    arrow.append_str(y, "q")?
    arrow.end_struct(b)?
    arrow.finish(b)?
}

fn built_maps() -> arrow.Array ! arrow.Error {
    let b = built_builder(20)?
    let entries = arrow.child(b, 0)?
    let key = arrow.child(entries, 0)?
    let value = arrow.child(entries, 1)?
    arrow.append_str(key, "a")?
    arrow.append_int(value, 1)?
    arrow.end_struct(entries)?
    arrow.append_str(key, "b")?
    arrow.append_null(value)?
    arrow.end_struct(entries)?
    arrow.end_list(b)?
    arrow.append_null(b)?
    arrow.end_list(b)?
    arrow.finish(b)?
}

fn built_dictionaries() -> arrow.Array ! arrow.Error {
    let b = built_builder(21)?
    arrow.append_str(b, "a")?
    arrow.append_str(b, "b")?
    arrow.append_null(b)?
    arrow.finish(b)?
}

fn built_int_dictionaries() -> arrow.Array ! arrow.Error {
    let b = built_builder(22)?
    arrow.append_int(b, 500)?
    arrow.append_int(b, 500)?
    arrow.append_int(b, -7)?
    arrow.finish(b)?
}

fn built_required_structs() -> arrow.Array ! arrow.Error {
    let b = built_builder(24)?
    let z = arrow.child(b, 0)?
    arrow.append_float(z, 0.5)?
    arrow.end_struct(b)?
    arrow.append_float(z, -2.5)?
    arrow.end_struct(b)?
    arrow.append_float(z, 8.0)?
    arrow.end_struct(b)?
    arrow.finish(b)?
}

fn built_required() -> arrow.Array ! arrow.Error {
    let b = built_builder(23)?
    arrow.append_int(b, 10)?
    arrow.append_int(b, 20)?
    arrow.append_int(b, 30)?
    arrow.finish(b)?
}

pub fn built_batch() -> arrow.Batch ! arrow.Error {
    let columns = [
        built_bools()?, built_small_ints()?, built_unsigned16()?, built_unsigned64()?,
        built_floats(4, 1.5, 65504.0)?, built_floats(5, 1.5, 1.0 / 0.0)?, built_floats(6, 1.5, -0.0)?,
        built_texts(7)?, built_texts(8)?, built_blobs()?, built_fixed()?, built_decimals()?,
        built_numbers(12, 19000, -1)?, built_numbers(13, 3600000001, 0)?, built_numbers(14, 1700000000, -1)?, built_nulls()?,
        built_lists()?, built_large_lists()?, built_fixed_lists()?, built_structs()?, built_maps()?,
        built_dictionaries()?, built_int_dictionaries()?, built_required()?, built_required_structs()?,
    ]
    arrow.Batch { schema: built_schema(), length: 3, columns }
}
