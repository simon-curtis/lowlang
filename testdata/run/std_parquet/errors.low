import std/arrow
import std/file
import std/io
import std/parquet
import std/path

fn kind(e: parquet.Error) -> str {
    match e {
        Invalid(_, _) => "Invalid"
        Truncated(_) => "Truncated"
        TooLarge(_) => "TooLarge"
        Unsupported(_) => "Unsupported"
        Mismatch(_) => "Mismatch"
        Checksum(_) => "Checksum"
        Io(_) => "Io"
    }
}

fn read_everything(data: []u8, options: parquet.ReaderOptions) -> str {
    let f = parquet.open_bytes(data, options) catch {
        e => return kind(e)
    }
    parquet.read_batches(f, []) catch {
        e => return kind(e)
    }
    "ok"
}

fn read_errors() {
    print("== read errors")
    for f in fixtures() {
        if f.group == "bad_data" || f.group == "encrypted" {
            print("{f.group}/{f.name} {read_everything(f.data, parquet.ReaderOptions {})}")
        }
    }
}

fn flipped(data: []u8, at: i64) -> []u8 {
    var out: []u8 = []
    io.append(mut out, data)
    out[at] = out[at] ^ 0x55
    out
}

fn checksum_cases() {
    print("== checksums")
    for name in ["flat_crc_v1", "flat_crc_v2", "flat_snappy_v1"] {
        let data = find(name)
        let f = parquet.open_bytes(data, parquet.ReaderOptions {}) catch {
            _ => return
        }
        let chunk = parquet.metadata(f).row_groups[0].columns[0]
        let last = chunk.data_page_offset + chunk.total_compressed - 1
        let bad = flipped(data, last)
        let strict = read_everything(bad, parquet.ReaderOptions {})
        let lenient = read_everything(bad, parquet.ReaderOptions { verify_checksums: false })
        print("{name} flipped last page byte: verified {strict}, unverified {lenient}")
    }
}

fn limit_cases() {
    print("== limits")
    let data = find("flat_v1_dict")
    print("max_metadata 4 {read_everything(data, parquet.ReaderOptions { max_metadata: 4 })}")
    print("max_page 8 {read_everything(data, parquet.ReaderOptions { max_page: 8 })}")
    print("max_values 3 {read_everything(data, parquet.ReaderOptions { max_values: 3 })}")
}

fn sweeps() {
    print("== sweeps")
    let data = find("nested_v1_snappy")
    var rejected = 0
    var prefixes = 0
    var at = 0
    for at < data.len {
        prefixes += 1
        if read_everything(data[..at], parquet.ReaderOptions {}) != "ok" {
            rejected += 1
        }
        at += 1
    }
    print("prefixes {prefixes} rejected {rejected}")
    var flips = 0
    var pos = 0
    for pos < data.len {
        read_everything(flipped(data, pos), parquet.ReaderOptions {})
        flips += 1
        pos += 3
    }
    print("flips {flips} completed")
}

fn try_group(f: *parquet.FileReader, index: i64, fields: []str) -> str {
    parquet.read_row_group(f, index, fields) catch {
        e => return kind(e)
    }
    "ok"
}

fn try_column(f: *parquet.FileReader, index: i64, name: str) -> str {
    parquet.read_column(f, index, name) catch {
        e => return kind(e)
    }
    "ok"
}

fn try_select(f: *parquet.FileReader, column: str) -> str {
    parquet.select_row_groups(f, column, 0, 1) catch {
        e => return kind(e)
    }
    "ok"
}

fn reader_misuse() {
    print("== reader misuse")
    let f = parquet.open_bytes(find("flat_groups"), parquet.ReaderOptions {}) catch {
        _ => return
    }
    print("group 99 {try_group(f, 99, [])}")
    print("group -1 {try_group(f, -1, [])}")
    print("field nope {try_group(f, 0, ["nope"])}")
    print("column nope {try_column(f, 0, "nope")}")
    print("select nope {try_select(f, "nope")}")
    print("select string column {try_select(f, "s")}")
}
