import std/parquet
import std/text

fn row_text(row: []parquet.Value) -> str {
    var parts: []str = []
    for v in row {
        push(mut parts, parquet.diagnostic(v))
    }
    text.join(parts, " | ")
}

fn print_rows(name: str, fields: []str) ! parquet.Error {
    let f = open_fixture(name)?
    print("rows {name} {text.join(fields, ",")}")
    let rows = parquet.read_rows(f, fields)?
    for r, row in rows {
        print("row {r}: {row_text(row)}")
    }
}

fn rows_reading() ! parquet.Error {
    print_rows("flat_v1_dict", [])?
    print_rows("nested_v1_snappy", [])?
    print_rows("flat_groups", ["req_s", "i32"])?
}
