import std/arrow
import std/file
import std/parquet
import std/path

fn schema_of(t: arrow.DataType) -> arrow.Schema {
    arrow.Schema { fields: [arrow.Field { name: "x", data_type: t }] }
}

fn outcome_of(schema: arrow.Schema, batches: arrow.Batch[], options: parquet.WriterOptions) -> str {
    parquet.write_bytes(schema, batches, options) catch {
        e => return "{kind(e)}: {parquet.message(e)}"
    }
    "ok"
}

fn schema_case(label: str, schema: arrow.Schema) {
    print("{label} {outcome_of(schema, [], parquet.WriterOptions {})}")
}

fn int_column(values: i64[], nullable: bool) -> arrow.Batch ! arrow.Error {
    let t = arrow.DataType.Int(32, true)
    let b = arrow.builder(t)?
    for v in values {
        if v < 0 {
            arrow.append_null(b)?
        } else {
            arrow.append_int(b, v)?
        }
    }
    let a = arrow.finish(b)?
    let schema = arrow.Schema { fields: [arrow.Field { name: "x", data_type: t, nullable }] }
    arrow.Batch { schema, length: values.len, columns: [a] }
}

fn text_column() -> arrow.Batch ! arrow.Error {
    let b = arrow.builder(arrow.DataType.Utf8)?
    arrow.append_str(b, "a")?
    let a = arrow.finish(b)?
    arrow.Batch { schema: schema_of(arrow.DataType.Utf8), length: 1, columns: [a] }
}

fn data_cases() ! arrow.Error {
    let nulls = int_column([1, -1, 3], false)?
    print("null in a required field {outcome_of(nulls.schema, [nulls], parquet.WriterOptions {})}")
    let fine = int_column([1, 2, 3], false)?
    print("required field without nulls {outcome_of(fine.schema, [fine], parquet.WriterOptions {})}")
    let wide = arrow.Batch { schema: fine.schema, length: 3, columns: [fine.columns[0], fine.columns[0]] }
    print("two columns for one field {outcome_of(fine.schema, [wide], parquet.WriterOptions {})}")
    let other = schema_of(arrow.DataType.Int(64, true))
    print("column of another type {outcome_of(other, [fine], parquet.WriterOptions {})}")
    let words = text_column()?
    let delta = parquet.WriterOptions { encodings: ["x": parquet.Encoding.DeltaBinaryPacked] }
    print("delta encoding of text {outcome_of(words.schema, [words], delta)}")
    let plain_dictionary = parquet.WriterOptions { encodings: ["x": parquet.Encoding.PlainDictionary] }
    print("PLAIN_DICTIONARY {outcome_of(words.schema, [words], plain_dictionary)}")
    let packed = parquet.WriterOptions { encodings: ["x": parquet.Encoding.BitPacked] }
    print("BIT_PACKED {outcome_of(words.schema, [words], packed)}")
    let split = parquet.WriterOptions { encodings: ["x": parquet.Encoding.ByteStreamSplit] }
    print("BYTE_STREAM_SPLIT of text {outcome_of(words.schema, [words], split)}")
}

fn entries_of(t: arrow.DataType) -> *arrow.Field {
    new(arrow.Field { name: "entries", data_type: t, nullable: false })
}

fn schema_cases() {
    print("== write errors")
    schema_case("date64", schema_of(arrow.DataType.Date(arrow.DateUnit.Millisecond)))
    schema_case("time in seconds", schema_of(arrow.DataType.Time(arrow.TimeUnit.Second)))
    schema_case("timestamp in seconds", schema_of(arrow.DataType.Timestamp(arrow.TimeUnit.Second, "")))
    schema_case("duration", schema_of(arrow.DataType.Duration(arrow.TimeUnit.Millisecond)))
    schema_case("interval", schema_of(arrow.DataType.Interval(arrow.IntervalUnit.DayTime)))
    schema_case("union", schema_of(arrow.DataType.Union(arrow.UnionMode.Dense, [arrow.Field { name: "i", data_type: arrow.DataType.Int(32, true) }], [0])))
    schema_case("empty struct", schema_of(arrow.DataType.Struct([])))
    schema_case("no fields", arrow.Schema { fields: [] })
    schema_case("required null type", arrow.Schema { fields: [arrow.Field { name: "x", data_type: arrow.DataType.Null, nullable: false }] })
    schema_case("map of integers", schema_of(arrow.DataType.Map(entries_of(arrow.DataType.Int(32, true)), false)))
    schema_case("fixed size binary of 0", schema_of(arrow.DataType.FixedSizeBinary(0)))
    print("page version 3 {outcome_of(schema_of(arrow.DataType.Bool), [], parquet.WriterOptions { page_version: 3 })}")
    print("hadoop lz4 {outcome_of(schema_of(arrow.DataType.Bool), [], parquet.WriterOptions { compression: parquet.Codec.Lz4 })}")
    print("lzo {outcome_of(schema_of(arrow.DataType.Bool), [], parquet.WriterOptions { compression: parquet.Codec.Lzo })}")
    print("row groups of 0 rows {outcome_of(schema_of(arrow.DataType.Bool), [], parquet.WriterOptions { row_group_rows: 0 })}")
    print("pages of 0 bytes {outcome_of(schema_of(arrow.DataType.Bool), [], parquet.WriterOptions { page_size: 0 })}")
    data_cases() catch {
        e => print("setup failed: {arrow.message(e)}")
    }
}

fn path_cases() {
    print("== paths")
    let dir = file.temp_dir("low-parquet") catch {
        _ => return
    }
    let target = path.join([dir, "out.parquet"])
    let source = parquet.open_bytes(find("flat_v1_dict"), parquet.ReaderOptions {}) catch {
        _ => return
    }
    let batches = parquet.read_batches(source, []) catch {
        _ => return
    }
    let schema = parquet.arrow_schema(source)
    parquet.write(target, schema, batches, parquet.WriterOptions {}) catch {
        e => {
            print("write failed {parquet.message(e)}")
            return
        }
    }
    let opened = parquet.open(target, parquet.ReaderOptions {}) catch {
        e => {
            print("open failed {parquet.message(e)}")
            return
        }
    }
    let again = parquet.read_batches(opened, []) catch {
        e => {
            print("read failed {parquet.message(e)}")
            return
        }
    }
    print("opened {parquet.row_group_count(opened)} groups {again[0].length} rows {again.len} batches")
    let name = parquet.read_column(opened, 0, "s_unique") catch {
        e => {
            print("column failed {parquet.message(e)}")
            return
        }
    }
    print("s_unique {arrow.diagnostic(name)}")
    print("missing file {open_outcome(path.join([dir, "missing.parquet"]))}")
    print("write into a missing directory {write_outcome(path.join([dir, "none", "out.parquet"]), schema, batches)}")
    file.remove(target) catch {
        _ => {}
    }
    file.remove_dir(dir) catch {
        _ => {}
    }
}

fn open_outcome(target: str) -> str {
    parquet.open(target, parquet.ReaderOptions {}) catch {
        e => return kind(e)
    }
    "ok"
}

fn write_outcome(target: str, schema: arrow.Schema, batches: arrow.Batch[]) -> str {
    parquet.write(target, schema, batches, parquet.WriterOptions {}) catch {
        e => return kind(e)
    }
    "ok"
}
