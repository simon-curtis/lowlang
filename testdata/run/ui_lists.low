import std/ui
import std/ui/geometry
import std/ui/scene

fn tops(s: scene.Scene) -> str {
    var out = ""
    for q in s.quads {
        out += "{q.bounds.y}/{q.bounds.height} "
    }
    out
}

fn item(i: i64) -> ui.Element {
    let shade = if i % 2 == 0 { ui.rgb(0xff0000) } else { ui.rgb(0x00ff00) }
    ui.div().padding(3.0).background(shade).child(ui.div().height(4.0))
}

fn lists(cx: ui.Context) {
    print("lists")
    let asked = cx.signal("")
    let clicked = cx.signal(-1)
    let count = cx.signal(100)
    let view = fn() -> ui.Element {
        ui.div().size(200.0, 100.0).children() {
            ui.uniform_list("list", count.get(), fn(first, end) {
                asked.set(asked.get() + "{first}-{end} ")
                var out: []ui.Element = []
                for i in first..end {
                    out.push(item(i).on_click(fn(e) clicked.set(i)))
                }
                out
            }).size(100.0, 50.0).padding(5.0)
        }
    }
    let size = geometry.size(200.0, 100.0)
    let frame = fn() -> scene.Scene {
        asked.set("")
        let s = cx.frame(view, size, 1.0)
        print("asked {asked.get()}")
        s
    }
    print(tops(frame()))
    cx.dispatch(PointerMoved(20.0, 20.0))
    cx.dispatch(Scrolled(0.0, 25.0))
    print("offset {cx.scroll_offset("list").y}")
    print(tops(frame()))
    cx.dispatch(PointerDown(Left, 20.0, 20.0))
    cx.dispatch(PointerUp(Left, 20.0, 20.0))
    print("clicked {clicked.get()} focus {cx.focused()}")
    cx.scroll_to("list", geometry.point(0.0, 5000.0))
    print(tops(frame()))
    print("offset {cx.scroll_offset("list").y}")
    cx.scroll_to_item("list", 50)
    print("to 50 {cx.scroll_offset("list").y}")
    cx.scroll_to_item("list", 52)
    print("to 52 {cx.scroll_offset("list").y}")
    cx.scroll_to_item("list", 55)
    print("to 55 {cx.scroll_offset("list").y}")
    print(tops(frame()))
    count.set(3)
    print(tops(frame()))
    print("offset {cx.scroll_offset("list").y}")
    count.set(0)
    print(tops(frame()))
}

fn canvases(cx: ui.Context) {
    print("canvases")
    let view = fn() -> ui.Element {
        ui.div().size(200.0, 100.0).padding(10.0).children() {
            ui.canvas(fn(mut p) {
                let b = p.bounds
                p.paint_shadow(scene.Shadow { bounds: geometry.rect(b.x, b.y, 10.0, 10.0), color: ui.rgb(0x000000), sigma: 2.0 })
                p.paint_quad(scene.Quad { bounds: geometry.rect(b.x + b.width - 10.0, b.y, 10.0, b.height), background: ui.rgb(0x0000ff), border_widths: geometry.edges(1.0) })
            }).size(50.0, 20.0).opacity(0.5)
        }
    }
    let s = cx.frame(view, geometry.size(200.0, 100.0), 2.0)
    for sh in s.shadows {
        print("shadow {sh.bounds.x} {sh.bounds.y} {sh.bounds.width} {sh.bounds.height} sigma {sh.sigma} alpha {sh.color.a}")
    }
    for q in s.quads {
        print("quad {q.bounds.x} {q.bounds.y} {q.bounds.width} {q.bounds.height} border {q.border_widths.left} alpha {q.background.a}")
    }
}

fn sized(sizes: ui.Signal[[]f32], i: i64) -> ui.Element {
    ui.div().height(sizes.get()[i]).background(ui.rgb(0x0000ff))
}

fn top_of(s: ui.ListState) -> str {
    let top = s.logical_scroll_top()
    "top {top.item} {top.offset}"
}

fn variable(cx: ui.Context) {
    print("variable")
    var start: []f32 = []
    for i in 0..20 {
        start.push(f32(10 + (i % 3) * 10))
    }
    let sizes = cx.signal(start)
    let state = cx.list_state(20, Top)
    let view = fn() -> ui.Element {
        ui.div().size(200.0, 100.0).child(ui.list(state, fn(i) sized(sizes, i)).size(100.0, 50.0))
    }
    let size = geometry.size(200.0, 100.0)
    print(tops(cx.frame(view, size, 1.0)))
    cx.dispatch(PointerMoved(20.0, 20.0))
    cx.dispatch(Scrolled(0.0, 25.0))
    print(tops(cx.frame(view, size, 1.0)))
    print("{top_of(state)} offset {cx.scroll_offset("0/0").y}")
    state.scroll_to_reveal_item(10)
    print(tops(cx.frame(view, size, 1.0)))
    print(top_of(state))
    state.scroll_to_reveal_item(9)
    print(tops(cx.frame(view, size, 1.0)))
    print(top_of(state))
    state.scroll_to_reveal_item(4)
    print(tops(cx.frame(view, size, 1.0)))
    print(top_of(state))
    sizes.set(sizes.get()[2..])
    state.splice(0, 2, 0)
    print("{top_of(state)} count {state.item_count()}")
    print(tops(cx.frame(view, size, 1.0)))
    state.scroll_to_offset(ui.ListOffset { item: 17, offset: 0.0 })
    print(tops(cx.frame(view, size, 1.0)))
    print(top_of(state))
}

fn chat(cx: ui.Context) {
    print("chat")
    let first: []f32 = [10.0, 10.0, 10.0]
    let sizes = cx.signal(first)
    let state = cx.list_state(3, Bottom)
    let view = fn() -> ui.Element {
        ui.div().size(200.0, 100.0).child(ui.list(state, fn(i) sized(sizes, i)).size(100.0, 50.0))
    }
    let size = geometry.size(200.0, 100.0)
    print(tops(cx.frame(view, size, 1.0)))
    sizes.set([10.0, 10.0, 10.0, 10.0, 10.0, 10.0, 10.0, 10.0])
    state.splice(3, 3, 5)
    print(tops(cx.frame(view, size, 1.0)))
    print(top_of(state))
    cx.dispatch(PointerMoved(20.0, 20.0))
    cx.dispatch(Scrolled(0.0, -15.0))
    print(tops(cx.frame(view, size, 1.0)))
    print(top_of(state))
    sizes.set([10.0, 10.0, 10.0, 10.0, 10.0, 10.0, 10.0, 10.0, 25.0])
    state.splice(8, 8, 1)
    print(tops(cx.frame(view, size, 1.0)))
    print(top_of(state))
    state.reset(2)
    print(tops(cx.frame(view, size, 1.0)))
}

fn main() {
    let cx = ui.headless(ui.rgb(0xffffff))
    lists(cx)
    variable(cx)
    chat(cx)
    canvases(cx)
}
