import std/crypto
import std/crypto/x509
import std/file
import std/io
import std/net
import std/ssh
import std/ssh/key
import std/ssh/sftp

fn error_name(e: sftp.Error) -> str {
    match e {
        Io(_) => "Io"
        NotFound => "NotFound"
        PermissionDenied => "PermissionDenied"
        Failure(_) => "Failure"
        BadMessage => "BadMessage"
        Unsupported => "Unsupported"
        Closed => "Closed"
        Protocol => "Protocol"
        Invalid => "Invalid"
    }
}

fn pattern(n: i64, seed: i64) -> u8[] {
    var out = io.buffer(n)
    var state = seed * 2654435761 + 12345
    for i in 0..n {
        state = (state * 6364136223846793005 + 1442695040888963407) & 0x7FFFFFFFFFFFFFFF
        out[i] = u8((state >> 33) & 0xFF)
    }
    out
}

fn same(a: u8[], b: u8[]) -> bool {
    str(a) == str(b)
}

fn serve_in(stream: io.Stream, root: str) {
    sftp.serve(stream, root) or {}
}

fn open_failure(c: *sftp.Session, path: str, flags: sftp.OpenFlags) -> str {
    using f = sftp.open_file(c, path, flags, sftp.Attrs {}) catch {
        e => return error_name(e)
    }
    "opened"
}

fn stat_failure(c: *sftp.Session, path: str) -> str {
    let a = sftp.stat(c, path) catch {
        e => return error_name(e)
    }
    "found"
}

fn read_failure(c: *sftp.Session, path: str) -> str {
    let data = sftp.read_file(c, path) catch {
        e => return error_name(e)
    }
    "read {data.len}"
}

fn remove_failure(c: *sftp.Session, path: str) -> str {
    sftp.remove(c, path) catch {
        e => return error_name(e)
    }
    "removed"
}

fn rmdir_failure(c: *sftp.Session, path: str) -> str {
    sftp.rmdir(c, path) catch {
        e => return error_name(e)
    }
    "removed"
}

fn rename_failure(c: *sftp.Session, from: str, to: str) -> str {
    sftp.rename(c, from, to) catch {
        e => return error_name(e)
    }
    "renamed"
}

fn symlink_failure(c: *sftp.Session, target: str, link: str) -> str {
    sftp.symlink(c, target, link) catch {
        e => return error_name(e)
    }
    "linked"
}

fn names_of(entries: sftp.Entry[]) -> str {
    var out = ""
    for e in entries {
        out = "{out}{e.name},"
    }
    out
}

fn mode_of(a: sftp.Attrs) -> i64 {
    (a.permissions ?? 0) & 0o777
}

fn files() {
    let root = file.temp_dir("std-ssh-sftp-files") or panic("temp dir")
    using ends = net.socketpair() or panic("socketpair")
    spawn serve_in(net.stream(ends.second), root)
    using client = sftp.connect(net.stream(ends.first)) or panic("connect")
    let c = client.handle
    sftp.write_file(c, "hello.txt", bytes("hello world"), 0o640) or panic("write_file")
    let back = sftp.read_file(c, "hello.txt") or panic("read_file")
    print("read back: {str(back)}")
    print("on disk: {file.read_text("{root}/hello.txt") or panic("disk")}")
    let info = sftp.stat(c, "hello.txt") or panic("stat")
    print("stat: size {info.size ?? -1} mode {mode_of(info)} regular {sftp.is_regular(info)} dir {sftp.is_dir(info)} link {sftp.is_symlink(info)}")
    print("missing: {stat_failure(c, "absent")} {read_failure(c, "absent")} {open_failure(c, "absent", sftp.OpenFlags { read: true })}")
    print("read a directory: {read_failure(c, ".")}")
    print("exclusive create: {open_failure(c, "hello.txt", sftp.OpenFlags { write: true, create: true, exclusive: true })}")
    {
        using f = sftp.open_file(c, "hello.txt", sftp.OpenFlags { write: true, append: true }, sftp.Attrs {}) or panic("append")
        let written = sftp.write(f, bytes("!!")) or panic("write")
        sftp.close(f) or panic("close")
        print("append: {written} {str(sftp.read_file(c, "hello.txt") or panic("read"))}")
    }
    {
        using f = sftp.open_file(c, "hello.txt", sftp.OpenFlags { write: true, truncate: true }, sftp.Attrs {}) or panic("truncate")
        sftp.close(f) or panic("close")
        let emptied = sftp.stat(c, "hello.txt") or panic("stat")
        print("truncate: {emptied.size ?? -1}")
    }
    file.remove_all(root) or panic("remove")
}

fn large_transfer() {
    let root = file.temp_dir("std-ssh-sftp-large") or panic("temp dir")
    using ends = net.socketpair() or panic("socketpair")
    spawn serve_in(net.stream(ends.second), root)
    using client = sftp.connect(net.stream(ends.first)) or panic("connect")
    let c = client.handle
    let size = 3 * 1024 * 1024 + 123
    let data = pattern(size, 7)
    using out = sftp.open_file(c, "big.bin", sftp.OpenFlags { write: true, create: true, truncate: true }, sftp.Attrs { permissions: 0o644 }) or panic("open")
    var at = 0
    for at < size {
        var end = at + 100000
        if end > size {
            end = size
        }
        sftp.write(out, data[at..end]) or panic("write")
        at = end
    }
    sftp.close(out) or panic("close")
    let stored = file.read_file("{root}/big.bin") or panic("disk")
    print("stored: {stored.len} {same(stored, data)}")
    using input = sftp.open_file(c, "big.bin", sftp.OpenFlags { read: true }, sftp.Attrs {}) or panic("open read")
    var all: u8[] = []
    let buf = io.buffer(70000)
    for {
        let n = sftp.read(input, buf) or panic("read")
        if n == 0 {
            break
        }
        io.append(mut all, buf[..n])
    }
    print("sequential read: {all.len} {same(all, data)}")
    let window = io.buffer(5000)
    let n = sftp.read_at(input, 2000000, window) or panic("read_at")
    print("read_at: {n} {same(window[..n], data[2000000..2000000 + n])}")
    sftp.seek(input, 3000000) or panic("seek")
    let tail = io.buffer(1000)
    let m = sftp.read(input, tail) or panic("read")
    print("after seek: {m} {same(tail[..m], data[3000000..3000000 + m])}")
    let copy = pattern(300000, 3)
    using sink = sftp.open_file(c, "copy.bin", sftp.OpenFlags { write: true, create: true, truncate: true }, sftp.Attrs {}) or panic("open")
    io.write_all(sftp.stream(sink), copy) or panic("write_all")
    sftp.flush(sink) or panic("flush")
    sftp.close(sink) or panic("close")
    using source = sftp.open_file(c, "copy.bin", sftp.OpenFlags { read: true }, sftp.Attrs {}) or panic("open")
    let reader = io.reader(sftp.stream(source))
    let got = io.read_exact(reader, copy.len) or panic("read_exact")
    print("stream copy: {same(got, copy)}")
    file.remove_all(root) or panic("remove")
}

fn directories() {
    let root = file.temp_dir("std-ssh-sftp-dirs") or panic("temp dir")
    using ends = net.socketpair() or panic("socketpair")
    spawn serve_in(net.stream(ends.second), root)
    using client = sftp.connect(net.stream(ends.first)) or panic("connect")
    let c = client.handle
    sftp.mkdir(c, "sub", 0o755) or panic("mkdir")
    for name in ["b", "a", "c"] {
        sftp.write_file(c, "sub/{name}.txt", bytes(name), 0o644) or panic("write")
    }
    let listed = sftp.list(c, "sub") or panic("list")
    print("list: {names_of(listed)}")
    for e in listed {
        print("entry {e.name}: regular {sftp.is_regular(e.attrs)} size {e.attrs.size ?? -1}")
    }
    using dir = sftp.open_dir(c, ".") or panic("open_dir")
    let batch = sftp.read_dir(dir) or panic("read_dir")
    print("read_dir: {names_of(batch)} {sftp.is_dir(batch[0].attrs)}")
    let rest = sftp.read_dir(dir) or panic("read_dir")
    print("read_dir end: {rest.len}")
    print("rmdir full: {rmdir_failure(c, "sub")}")
    sftp.remove(c, "sub/a.txt") or panic("remove")
    print("removed: {stat_failure(c, "sub/a.txt")}")
    sftp.rename(c, "sub/b.txt", "sub/d.txt") or panic("rename")
    print("rename onto file: {rename_failure(c, "sub/c.txt", "sub/d.txt")}")
    sftp.posix_rename(c, "sub/c.txt", "sub/d.txt") or panic("posix_rename")
    print("posix_rename: {names_of(sftp.list(c, "sub") or panic("list"))} {str(sftp.read_file(c, "sub/d.txt") or panic("read"))}")
    sftp.remove(c, "sub/d.txt") or panic("remove")
    sftp.rmdir(c, "sub") or panic("rmdir")
    sftp.mkdir(c, "plain", 0o755) or panic("mkdir")
    print("remove directory: {remove_failure(c, "plain")}")
    print("remove root: {remove_failure(c, ".")} {rmdir_failure(c, "/")}")
    print("real_path: {sftp.real_path(c, "a/../b/./c") or panic("real_path")} {sftp.real_path(c, ".") or panic("real_path")}")
    file.remove_all(root) or panic("remove")
}

fn links_and_extensions() {
    let root = file.temp_dir("std-ssh-sftp-links") or panic("temp dir")
    using ends = net.socketpair() or panic("socketpair")
    spawn serve_in(net.stream(ends.second), root)
    using client = sftp.connect(net.stream(ends.first)) or panic("connect")
    let c = client.handle
    for name in ["posix-rename@openssh.com", "statvfs@openssh.com", "fstatvfs@openssh.com", "hardlink@openssh.com", "fsync@openssh.com", "limits@openssh.com", "nonsense@example.com"] {
        print("supports {name}: {sftp.supports(c, name)}")
    }
    sftp.write_file(c, "target.txt", bytes("payload"), 0o644) or panic("write")
    sftp.symlink(c, "target.txt", "link.txt") or panic("symlink")
    print("read_link: {sftp.read_link(c, "link.txt") or panic("read_link")}")
    print("stat follows: {sftp.is_regular(sftp.stat(c, "link.txt") or panic("stat"))}")
    print("lstat reports: {sftp.is_symlink(sftp.lstat(c, "link.txt") or panic("lstat"))}")
    print("through link: {str(sftp.read_file(c, "link.txt") or panic("read"))}")
    print("symlink over file: {symlink_failure(c, "x", "link.txt")}")
    sftp.hardlink(c, "target.txt", "hard.txt") or panic("hardlink")
    print("hardlink: {str(sftp.read_file(c, "hard.txt") or panic("read"))}")
    sftp.set_attrs(c, "target.txt", sftp.Attrs { permissions: 0o600, size: 3, accessed: 1000000000, modified: 1000000500 }) or panic("set_attrs")
    let changed = sftp.stat(c, "target.txt") or panic("stat")
    print("set_attrs: size {changed.size ?? -1} mode {mode_of(changed)} modified {changed.modified ?? -1}")
    using f = sftp.open_file(c, "target.txt", sftp.OpenFlags { read: true, write: true }, sftp.Attrs {}) or panic("open")
    print("fstat: {(sftp.fstat(f) or panic("fstat")).size ?? -1}")
    sftp.write_at(f, 3, bytes("tail")) or panic("write_at")
    sftp.sync(f) or panic("fsync")
    sftp.set_file_attrs(f, sftp.Attrs { permissions: 0o644 }) or panic("fsetstat")
    let grown = sftp.fstat(f) or panic("fstat")
    print("after write_at: size {grown.size ?? -1} mode {mode_of(grown)}")
    let vfs = sftp.statvfs(c, ".") or panic("statvfs")
    print("statvfs: {vfs.blocks > 0} {vfs.block_size > 0} {vfs.name_max > 0}")
    let limit = sftp.limits(c) or panic("limits")
    print("limits: {limit.packet_length > 0} {limit.read_length > 0} {limit.write_length > 0}")
    file.remove_all(root) or panic("remove")
}

fn confinement() {
    let parent = file.temp_dir("std-ssh-sftp-jail") or panic("temp dir")
    let root = "{parent}/root"
    file.mkdir(root) or panic("mkdir")
    file.write_text("{parent}/secret.txt", "outside") or panic("secret")
    file.mkdir("{parent}/outside") or panic("outside")
    file.write_text("{parent}/outside/data.txt", "outside data") or panic("data")
    file.write_text("{root}/inside.txt", "inside") or panic("inside")
    file.symlink("../secret.txt", "{root}/relative_escape") or panic("link")
    file.symlink("{parent}/secret.txt", "{root}/absolute_escape") or panic("link")
    file.symlink("{parent}/outside", "{root}/directory_escape") or panic("link")
    file.symlink("../../../../../../etc/passwd", "{root}/deep_escape") or panic("link")
    file.symlink("inside.txt", "{root}/local_link") or panic("link")
    file.symlink("loop_b", "{root}/loop_a") or panic("loop")
    file.symlink("loop_a", "{root}/loop_b") or panic("loop")
    using ends = net.socketpair() or panic("socketpair")
    spawn serve_in(net.stream(ends.second), root)
    using client = sftp.connect(net.stream(ends.first)) or panic("connect")
    let c = client.handle
    for path in ["../secret.txt", "/../secret.txt", "a/../../secret.txt", "relative_escape", "absolute_escape", "deep_escape", "directory_escape/data.txt", "../outside/data.txt"] {
        print("read {path}: {read_failure(c, path)}")
    }
    print("local link: {str(sftp.read_file(c, "local_link") or panic("read"))}")
    print("dot-dot stops at the root: {str(sftp.read_file(c, "../../../inside.txt") or panic("read"))}")
    print("loop: {read_failure(c, "loop_a")}")
    sftp.write_file(c, "../escaped.txt", bytes("kept inside"), 0o644) or panic("write")
    print("escaped write lands inside: {file.exists("{root}/escaped.txt")} {file.exists("{parent}/escaped.txt")}")
    print("remove escape link: {remove_failure(c, "directory_escape/data.txt")} {file.exists("{parent}/outside/data.txt")}")
    file.remove_all(parent) or panic("remove")
}

fn closed_session() {
    let root = file.temp_dir("std-ssh-sftp-closed") or panic("temp dir")
    using ends = net.socketpair() or panic("socketpair")
    spawn serve_in(net.stream(ends.second), root)
    using client = sftp.connect(net.stream(ends.first)) or panic("connect")
    let c = client.handle
    sftp.write_file(c, "x", bytes("x"), 0o644) or panic("write")
    net.close_on(ends.second.handle)
    print("after the stream ends: {stat_failure(c, "x")}")
    file.remove_all(root) or panic("remove")
}

fn session_server(root: str) -> ssh.ServerConfig {
    let host = key.signer(x509.PrivateKey.Ed25519(crypto.random(32))) or panic("host key")
    let auth = ssh.ServerAuth { methods: ["password"], password: fn(user, password) { password == "secret" } }
    ssh.ServerConfig { host_keys: [host], auth, channels: sftp.handler(root) }
}

fn serve_one(stream: io.Stream, config: ssh.ServerConfig) {
    using conn = ssh.serve_stream(stream, config) or return
    ssh.wait_on(conn.handle)
}

fn over_ssh() {
    let root = file.temp_dir("std-ssh-sftp-ssh") or panic("temp dir")
    using ends = net.socketpair() or panic("socketpair")
    spawn serve_one(net.stream(ends.second), session_server(root))
    let config = ssh.ClientConfig {
        user: "alice"
        verify_host_key: ssh.accept_any_host_key()
        auth: [ssh.AuthMethod.Password("secret")]
    }
    using conn = ssh.client(net.stream(ends.first), config) or panic("client")
    using client = sftp.open(conn) or panic("sftp open")
    let c = client.handle
    let data = pattern(1500000, 11)
    sftp.write_file(c, "remote.bin", data, 0o644) or panic("write_file")
    let back = sftp.read_file(c, "remote.bin") or panic("read_file")
    print("over ssh: {back.len} {same(back, data)}")
    print("on disk: {same(file.read_file("{root}/remote.bin") or panic("disk"), data)}")
    using shell = ssh.open_session(conn) or panic("session")
    print("shell refused: {refused(shell.handle)}")
    file.remove_all(root) or panic("remove")
}

fn refused(h: *ssh.ChannelHandle) -> str {
    ssh.shell_on(h) catch {
        e => return "refused"
    }
    "accepted"
}

fn main() {
    files()
    large_transfer()
    directories()
    links_and_extensions()
    confinement()
    closed_session()
    over_ssh()
}
