fn chain(x: i64) -> i64 {
    if 1 == 2 {
        return 100
    }
    if 2 == 2 {
        if 3 == 4 {
            return 200
        }
        return x + 1
    }
    300
}

fn merged(x: i64) -> i64 {
    var n = x
    if 3 > 2 {
        n = n * 2
    } else {
        n = n * 3
    }
    if 5 < 4 {
        n += 1000
    }
    n
}

fn signed_and_unsigned() {
    let big: u64 = 18446744073709551615
    let neg = 0 - 1
    let narrow: i32 = 0 - 5
    let byte: u8 = 200
    if big > 5 {
        print("u64")
    }
    if neg < 0 {
        print("i64")
    }
    if narrow < 3 {
        print("i32")
    }
    if byte > 100 {
        print("u8")
    }
    if byte < 100 {
        print("wrong")
    }
    if big <= 5 {
        print("wrong")
    }
}

fn loops() -> i64 {
    var k = 0
    for {
        k += 1
        if 1 == 1 {
            break
        }
    }
    for 2 < 1 {
        k += 100
    }
    for i in 0..3 {
        if 2 > 1 {
            continue
        }
        k += 1000
    }
    var j = 0
    for j < 4 {
        j += 1
        if 7 == 7 {
            k += j
        } else {
            k += 5000
        }
    }
    k
}

fn main() {
    print(chain(7))
    print(merged(21))
    signed_and_unsigned()
    print(loops())
    print(!(1 > 2))
}
