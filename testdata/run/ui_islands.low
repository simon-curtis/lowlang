import std/bits
import std/ui
import std/ui/geometry
import std/ui/islands
import std/ui/scene
import uitext = std/ui/text

fn hex(c: geometry.Color) -> str {
    let r = i64(c.r * 255.0 + 0.5)
    let g = i64(c.g * 255.0 + 0.5)
    let b = i64(c.b * 255.0 + 0.5)
    let a = i64(c.a * 255.0 + 0.5)
    "{r:x2}{g:x2}{b:x2}{a:x2}"
}

fn show(th: islands.Theme) {
    print("{th.scheme.name} {th.code_face.name} {th.code_size}")
}

fn themes() {
    print("themes")
    show(islands.theme("pink", "cascadia", 13))
    show(islands.theme("teal", "jetbrains", 16))
    show(islands.theme("nope", "nope", 99))
    show(islands.theme("slate", "ia-mono", 11))
    show(islands.theme("", "consolas", 18))
    var names = ""
    for s in islands.schemes() {
        names = "{names} {s.name}"
    }
    print("schemes{names}")
    var faces = ""
    for f in islands.code_faces() {
        faces = "{faces} {f.name}"
    }
    print("faces{faces}")
    var sizes = ""
    for s in islands.code_sizes() {
        sizes = "{sizes} {s}:{islands.code_line_height(s)}"
    }
    print("sizes{sizes}")
    print("default {islands.default_scheme().name} {islands.default_code_size()}")
}

fn tokens() {
    print("tokens")
    let pink = islands.theme("pink", "cascadia", 13)
    let teal = islands.theme("teal", "cascadia", 13)
    print("canvas {hex(islands.canvas())} surface {hex(islands.surface())} raised {hex(islands.raised())}")
    print("hovered {hex(islands.hovered())} border {hex(islands.border_colour())} text {hex(islands.text_colour())}")
    print("muted {hex(islands.muted())} faint {hex(islands.faint())} connector {hex(islands.connector())}")
    print("accent {hex(islands.accent(pink))} {hex(islands.accent(teal))}")
    print("soft {hex(islands.accent_soft(pink))} selection {hex(islands.selection(teal))}")
    print("keyword {hex(islands.syntax_keyword(pink))} {hex(islands.syntax_keyword(teal))}")
    print("danger {hex(islands.danger())} ok {hex(islands.ok())} warn {hex(islands.warn())} soft {hex(islands.danger_soft())}")
    print("control {hex(islands.control())} selected {hex(islands.selected())} scrim {hex(islands.scrim_colour())} rail {hex(islands.rail_selected())}")
    print("find {hex(islands.find_match())} {hex(islands.find_current())} line {hex(islands.current_line())} white {hex(islands.whitespace())}")
    print("scrollbar {hex(islands.scrollbar())} {hex(islands.scrollbar_hot())} on accent {hex(islands.on_accent())}")
    print("syntax {hex(islands.syntax_plain())} {hex(islands.syntax_comment())} {hex(islands.syntax_string())} {hex(islands.syntax_number())} {hex(islands.syntax_variable())}")
    let shadow = islands.popover_shadow()
    print("shadow {hex(shadow.color)} {shadow.x} {shadow.y} {shadow.blur} {shadow.spread}")
    print("sizes {islands.control_height()} {islands.radius()} {islands.radius_lg()} {islands.size_text()} {islands.size_small()} {islands.size_caption()} {islands.size_title()} {islands.size_heading()}")
    print("layout {islands.title_height()} {islands.bar_height()} {islands.header_height()} {islands.info_height()} {islands.float_inset()} {islands.rail_button_size()} {islands.rail_width()} {islands.rail_icon_size()} {islands.tab_height()} {islands.status_height()} {islands.mark_size()}")
    print("fonts {islands.ui_font()} {islands.code_family(pink)} {islands.code_pixels(pink)}")
}

fn blends() {
    print("blend")
    print("{islands.blend(0x000000, 0xffffff, 0.5):x6}")
    print("{islands.blend(0x9d8cf6, 0xffffff, 0.3):x6}")
    print("{islands.blend(0xe874d9, 0xe874d9, 0.9):x6}")
    print("{islands.blend(0x102030, 0xf0e0d0, 0.0):x6} {islands.blend(0x102030, 0xf0e0d0, 1.0):x6}")
    print("{hex(islands.faded(ui.rgb(0xff0000), 0.25))}")
    print("colour")
    for text in ["#ff8000", "#FF8000", "ff8000", "#12345", "#1234567", "#gg0000", "", "#000000"] {
        print("[{text}] {hex(islands.colour(text))}")
    }
}

fn counts(label: str, element: ui.Element) {
    let cx = ui.headless(ui.rgb(0x000000))
    let root = fn() -> ui.Element { element }
    let s = cx.frame(root, geometry.size(300.0, 100.0), 1.0)
    print("{label}: quads {s.quads.len} sprites {s.sprites.len}")
}

fn chords() {
    print("chords")
    counts("single", islands.keys("enter"))
    counts("joined", islands.keys("ctrl+k"))
    counts("two steps", islands.keys("ctrl+k ctrl+s"))
    counts("three", islands.keys("g g g"))
    counts("cap", islands.kbd("esc"))
}

fn easing() {
    print("easing")
    let points: []f32 = [0.0, 0.1, 0.25, 0.5, 0.75, 0.9, 1.0]
    for x32 in points {
        print("ease {x32:f2} {islands.ease(x32):f4}")
    }
    var s = islands.slide(0.0)
    print("rest {s.value} moving {islands.tick(mut s, false, 0)}")
    islands.set_slide(mut s, 1.0, 1000)
    for at in [1000, 1125, 1250, 1375, 1499, 1500, 1800] {
        let moving = islands.tick(mut s, false, at)
        print("open t+{at - 1000} {s.value:f4} moving {moving}")
    }
    islands.set_slide(mut s, 0.0, 2000)
    for at in [2000, 2150, 2299, 2300] {
        let moving = islands.tick(mut s, false, at)
        print("close t+{at - 2000} {s.value:f4} moving {moving}")
    }
    islands.set_slide(mut s, 0.5, 3000)
    var moving = islands.tick(mut s, false, 3125)
    print("half way t+125 {s.value:f4} moving {moving}")
    islands.set_slide(mut s, 0.5, 3200)
    moving = islands.tick(mut s, false, 3250)
    print("same target {s.value:f4} moving {moving}")
    moving = islands.tick(mut s, true, 3260)
    print("still {s.value:f4} moving {moving}")
    islands.set_slide(mut s, 1.0, 4000)
    moving = islands.tick(mut s, true, 4001)
    print("jump {s.value} moving {moving}")
}

fn patterns() {
    print("patterns")
    let seed = islands.pattern("0123456789abcdef0123456789abcdef")
    print("seed {seed == 0x1bec} {seed:x4}")
    for text in ["", "a", "ffffffffffffffffffffffffffffffff"] {
        let p = islands.pattern(text)
        print("[{text}] {p:x4} bits {bits.popcount(u64(p))} enough {bits.popcount(u64(p)) >= 4}")
    }
    print("stable {islands.pattern("ada") == islands.pattern("ada")}")
}

fn avatars() {
    print("avatars")
    let cx = ui.headless(ui.rgb(0x000000))
    let face = islands.face("Ada", "#e874d9", "0123456789abcdef0123456789abcdef", none)
    print("face {face.name} {hex(face.colour)} gray {hex(islands.face("x", "nope", "", none).colour)}")
    let root = fn() -> ui.Element { islands.avatar(cx, face, 40.0) }
    let s = cx.frame(root, geometry.size(100.0, 100.0), 1.0)
    var lit = 0
    for q in s.quads {
        if q.bounds.width == 5.0 {
            lit += 1
        }
    }
    print("quads {s.quads.len} cells {lit} disc {s.quads[0].bounds.width}x{s.quads[0].bounds.height} radius {s.quads[0].corner_radii.top_left}")
    let made = islands.picture(cx, bytes("not an image"))
    match made {
        some(p) => print("decoded")
        none => print("not a picture")
    }
}

fn quads_shown(s: islands.Scrollbars, hot: islands.Axis?) {
    for q in islands.quads(s, hot) {
        print("quad {q.bounds.x} {q.bounds.y} {q.bounds.width} {q.bounds.height} radius {q.corner_radii.top_left} {hex(q.background)}")
    }
}

fn scrolling() {
    print("scrollbars")
    let vertical = geometry.rect(490.0, 0.0, 10.0, 300.0)
    let horizontal = geometry.rect(0.0, 300.0, 400.0, 10.0)
    let idle = islands.scrollbars(vertical, horizontal, geometry.point(0.0, 0.0), geometry.point(400.0, 300.0))
    print("near {islands.near(idle, geometry.point(495.0, 150.0)) == some(islands.Axis.Vertical)}")
    print("near {islands.near(idle, geometry.point(200.0, 305.0)) == some(islands.Axis.Horizontal)}")
    print("near {islands.near(idle, geometry.point(200.0, 296.0)) == some(islands.Axis.Horizontal)}")
    print("near {islands.near(idle, geometry.point(200.0, 150.0)) == none}")
    let none_to_scroll = islands.scrollbars(vertical, horizontal, geometry.point(0.0, 0.0), geometry.point(0.0, 300.0))
    print("near {islands.near(none_to_scroll, geometry.point(200.0, 305.0)) == none}")

    let grab = islands.grab(idle, geometry.point(10.0, 305.0)) ?? return
    print("grab horizontal {grab.axis == islands.Axis.Horizontal}")
    var at = islands.drag(idle, grab, geometry.point(110.0, 305.0), geometry.point(0.0, 40.0))
    print("drag {at.x} {at.y}")
    at = islands.drag(idle, grab, geometry.point(900.0, 305.0), at)
    print("drag {at.x} {at.y}")

    let press = geometry.point(250.0, 305.0)
    let track = islands.grab(idle, press) ?? return
    let centred = islands.drag(idle, track, press, geometry.point(0.0, 0.0))
    print("track {centred.x} {centred.y}")

    let scrolled = islands.scrollbars(vertical, horizontal, geometry.point(120.0, 0.0), geometry.point(400.0, 300.0))
    let thumb = islands.grab(scrolled, geometry.point(495.0, 10.0)) ?? return
    print("grab vertical {thumb.axis == islands.Axis.Vertical}")
    let down = islands.drag(scrolled, thumb, geometry.point(495.0, 85.0), geometry.point(120.0, 0.0))
    print("drag {down.x} {down.y}")

    let no_hot: islands.Axis? = none
    let horizontal_hot: islands.Axis? = islands.Axis.Horizontal
    quads_shown(scrolled, no_hot)
    quads_shown(scrolled, horizontal_hot)
    print("quads when idle {islands.quads(none_to_scroll, no_hot).len} width {islands.scrollbar_width()}")
}

fn icons() {
    print("icons")
    print("check {islands.check_icon().shapes.len} chevrons {islands.chevrons_up_down_icon().shapes.len} search {islands.search_icon().shapes.len}")
    print("window {islands.window_minimize_icon().shapes.len} {islands.window_maximize_icon().shapes.len} {islands.window_restore_icon().shapes.len} {islands.window_close_icon().shapes.len}")
    let own = islands.stroke_icon("<path d='M2 2 L22 22'/>")
    print("own {own.shapes.len} {own.view_box.width} {own.shapes[0].stroke_width}")
    print("broken {islands.stroke_icon("<path d='nonsense'/>").shapes.len} {islands.stroke_icon("<rect").shapes.len}")
}

fn fonts() {
    print("fonts")
    let cx = ui.headless(ui.rgb(0x000000))
    let format = uitext.Format { typeface: uitext.Typeface { family: "JetBrains Mono" } }
    let before = cx.shape_text("MMii", format, 1000.0)
    islands.load_fonts(cx) catch {
        e => print("failed")
    }
    let after = cx.shape_text("MMii", format, 1000.0)
    print("jetbrains chosen {after.font != before.font}")
    let mono = uitext.Format { typeface: uitext.Typeface { family: "iA Writer Mono S" } }
    let writer = cx.shape_text("MMii", mono, 1000.0)
    print("ia writer chosen {writer.font != before.font && writer.font != after.font}")
    var files = 0
    for f in islands.code_faces() {
        if f.family == "JetBrains Mono" || f.family == "iA Writer Mono S" {
            files += 1
        }
    }
    print("bundled faces {files}")
}

fn main() {
    themes()
    tokens()
    blends()
    chords()
    easing()
    patterns()
    avatars()
    scrolling()
    icons()
    fonts()
}
