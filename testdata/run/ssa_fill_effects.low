fn tick(mut calls: i64) -> i64 {
    calls += 1
    calls
}

fn counted(n: i64) {
    var calls = 0
    var xs: []i64 = []
    for i in 0..n {
        push(mut xs, tick(mut calls))
    }
    print("n {n} calls {calls} len {xs.len}")
    var total = 0
    for x in xs {
        total += x
    }
    print("sum {total}")
}

fn lookup(ys: []i64, n: i64) -> i64 {
    var xs: []i64 = []
    for i in 0..n {
        push(mut xs, ys[5])
    }
    xs.len
}

fn divided(n: i64, d: i64) -> i64 {
    var xs: []i64 = []
    for i in 0..n {
        push(mut xs, 100 / d)
    }
    xs.len
}

fn uses_counter(n: i64) -> i64 {
    var xs: []i64 = []
    for i in 0..n {
        push(mut xs, i)
    }
    var ys: []i64 = []
    for i in 0..n {
        push(mut ys, xs.len)
    }
    var total = 0
    for y in ys {
        total += y
    }
    total
}

fn self_referencing(n: i64) -> i64 {
    var xs: []i64 = []
    for i in 0..n {
        push(mut xs, xs.len)
    }
    var total = 0
    for x in xs {
        total += x
    }
    total
}

fn main() {
    counted(0)
    counted(-3)
    counted(1)
    counted(6)
    print(lookup([1, 2], 0))
    print(divided(0, 0))
    print(divided(3, 5))
    print(uses_counter(12))
    print(self_referencing(10))
}
