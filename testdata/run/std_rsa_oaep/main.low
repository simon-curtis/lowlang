import std/crypto/hash
import std/crypto/rsa
import std/crypto/x509
import std/io
import std/text

struct Vector {
    name: str
    algorithm: hash.Algorithm
    label: str
    message: []u8
    ciphertext: []u8
}

fn repeated(c: u8, n: i64) -> []u8 {
    let out = io.buffer(n)
    for i in 0..n {
        out[i] = c
    }
    out
}

fn counting(n: i64) -> []u8 {
    let out = io.buffer(n)
    for i in 0..n {
        out[i] = u8(i)
    }
    out
}

fn vectors() -> []Vector {
    let empty: []u8 = []
    [
        Vector { name: "sha1 empty", algorithm: hash.sha1(), label: "", message: empty, ciphertext: bytes(embed("case0.bin")) },
        Vector { name: "sha1 password", algorithm: hash.sha1(), label: "", message: bytes("mysql password\0"), ciphertext: bytes(embed("case1.bin")) },
        Vector { name: "sha256", algorithm: hash.sha256(), label: "", message: bytes("hello world"), ciphertext: bytes(embed("case2.bin")) },
        Vector { name: "sha256 label", algorithm: hash.sha256(), label: "label", message: bytes("x"), ciphertext: bytes(embed("case3.bin")) },
        Vector { name: "sha384", algorithm: hash.sha384(), label: "", message: repeated('a', 100), ciphertext: bytes(embed("case4.bin")) },
        Vector { name: "sha512 label", algorithm: hash.sha512(), label: "label two", message: repeated('b', 50), ciphertext: bytes(embed("case5.bin")) },
        Vector { name: "sha1 longest", algorithm: hash.sha1(), label: "", message: counting(214), ciphertext: bytes(embed("case6.bin")) },
        Vector { name: "openssl sha1", algorithm: hash.sha1(), label: "", message: bytes("openssl made this"), ciphertext: bytes(embed("openssl_sha1.bin")) },
        Vector { name: "openssl sha256 label", algorithm: hash.sha256(), label: "label", message: bytes("openssl made this"), ciphertext: bytes(embed("openssl_sha256_label.bin")) },
    ]
}

fn refusal(work: fn() -> []u8 ! io.Error) -> str {
    work() catch {
        Invalid => return "Invalid"
        Malformed => return "Malformed"
        Unsupported => return "Unsupported"
        _ => return "other"
    }
    "accepted"
}

fn main() ! io.Error {
    let key = rsa.parse_private(bytes(embed("key.der")))?
    let public = rsa.public(key)
    let blocks = x509.pem_blocks(embed("public.pem"), "PUBLIC KEY")
    let info = rsa.parse_public_key_info(blocks[0])?
    print("public key info matches {hash.equal(info.n, key.n) && hash.equal(info.e, key.e)}")
    print("public key info truncated {refusal(fn() -> []u8 ! io.Error { rsa.parse_public_key_info(blocks[0][..blocks[0].len - 1])?.n })}")
    print("public key info of a pkcs1 key {refusal(fn() -> []u8 ! io.Error { rsa.parse_public_key_info(bytes(embed("key.der")))?.n })}")

    for v in vectors() {
        let label = bytes(v.label)
        let plain = rsa.decrypt_oaep(key, v.algorithm, label, v.ciphertext)?
        print("decrypt {v.name} {hash.equal(plain, v.message)}")
        let sealed = rsa.encrypt_oaep(public, v.algorithm, label, v.message)?
        let again = rsa.encrypt_oaep(public, v.algorithm, label, v.message)?
        let back = rsa.decrypt_oaep(key, v.algorithm, label, sealed)?
        print("round trip {v.name} {hash.equal(back, v.message)} length {sealed.len} randomised {!hash.equal(sealed, again)}")
    }

    let first = vectors()[1]
    let wrong_label = refusal(fn() -> []u8 ! io.Error { rsa.decrypt_oaep(key, first.algorithm, bytes("other"), first.ciphertext)? })
    let wrong_hash = refusal(fn() -> []u8 ! io.Error { rsa.decrypt_oaep(key, hash.sha256(), [], first.ciphertext)? })
    let flipped = io.buffer(first.ciphertext.len)
    io.copy(flipped, first.ciphertext)
    flipped[7] ^= 1
    let tampered = refusal(fn() -> []u8 ! io.Error { rsa.decrypt_oaep(key, first.algorithm, [], flipped)? })
    let short = refusal(fn() -> []u8 ! io.Error { rsa.decrypt_oaep(key, first.algorithm, [], first.ciphertext[1..])? })
    let modulus = refusal(fn() -> []u8 ! io.Error { rsa.decrypt_oaep(key, first.algorithm, [], key.n)? })
    let zeros = refusal(fn() -> []u8 ! io.Error { rsa.decrypt_oaep(key, first.algorithm, [], repeated(0, key.n.len))? })
    let oversize = refusal(fn() -> []u8 ! io.Error { rsa.encrypt_oaep(public, hash.sha1(), [], counting(215))? })
    let oversize_sha256 = refusal(fn() -> []u8 ! io.Error { rsa.encrypt_oaep(public, hash.sha256(), [], counting(191))? })
    print("wrong label {wrong_label} wrong hash {wrong_hash} tampered {tampered} short {short} modulus {modulus} zeros {zeros}")
    print("oversize sha1 {oversize} oversize sha256 {oversize_sha256}")
    let longest_sha256 = rsa.encrypt_oaep(public, hash.sha256(), [], counting(190))?
    print("longest sha256 {longest_sha256.len}")
}
