import std/text
import std/unicode

fn flags(c: u32) -> str {
    var out: []u8 = []
    if unicode.is_letter(c) { push(mut out, 'L') }
    if unicode.is_digit(c) { push(mut out, 'D') }
    if unicode.is_number(c) { push(mut out, 'N') }
    if unicode.is_upper(c) { push(mut out, 'U') }
    if unicode.is_lower(c) { push(mut out, 'l') }
    if unicode.is_title(c) { push(mut out, 'T') }
    if unicode.is_space(c) { push(mut out, 'S') }
    if unicode.is_punct(c) { push(mut out, 'P') }
    if unicode.is_symbol(c) { push(mut out, 'Y') }
    if unicode.is_control(c) { push(mut out, 'C') }
    if unicode.is_mark(c) { push(mut out, 'M') }
    if unicode.is_alphanumeric(c) { push(mut out, 'A') }
    if unicode.is_identifier_start(c) { push(mut out, 's') }
    if unicode.is_identifier_continue(c) { push(mut out, 'c') }
    str(out)
}

fn show(c: u32) {
    let code = unicode.category_code(unicode.category(c))
    print("{text.hex(i64(c))} {code} {flags(c)} w{unicode.display_width(c)}")
}

fn script_of(c: u32) -> str {
    let s = unicode.script(c)
    if s == unicode.Script.Latin { return "Latin" }
    if s == unicode.Script.Greek { return "Greek" }
    if s == unicode.Script.Cyrillic { return "Cyrillic" }
    if s == unicode.Script.Hebrew { return "Hebrew" }
    if s == unicode.Script.Arabic { return "Arabic" }
    if s == unicode.Script.Devanagari { return "Devanagari" }
    if s == unicode.Script.Thai { return "Thai" }
    if s == unicode.Script.Hangul { return "Hangul" }
    if s == unicode.Script.Hiragana { return "Hiragana" }
    if s == unicode.Script.Katakana { return "Katakana" }
    if s == unicode.Script.Han { return "Han" }
    if s == unicode.Script.Common { return "Common" }
    if s == unicode.Script.Inherited { return "Inherited" }
    if s == unicode.Script.Other { return "Other" }
    "Unknown"
}

fn width_of(c: u32) -> str {
    let w = unicode.east_asian_width(c)
    if w == unicode.Width.Wide { return "W" }
    if w == unicode.Width.Fullwidth { return "F" }
    if w == unicode.Width.Halfwidth { return "H" }
    if w == unicode.Width.Narrow { return "Na" }
    if w == unicode.Width.Ambiguous { return "A" }
    "N"
}

fn cases(c: u32) {
    let upper = text.hex(i64(unicode.to_upper(c)))
    let lower = text.hex(i64(unicode.to_lower(c)))
    let title = text.hex(i64(unicode.to_title(c)))
    print("{text.hex(i64(c))}: upper {upper} lower {lower} title {title}")
}

fn codes(s: str) -> str {
    var parts: []str = []
    for c in s {
        push(mut parts, text.hex(i64(c)))
    }
    text.join(parts, " ")
}

fn main() {
    let samples: []u32 = [
        'A', 'z', '5', ' ', '\t', '_', '-', '(', '+', '$', '^', '\n',
        0xA0, 0xAD, 0xB2, 0xC9, 0xDF, 0xE9, 0x130, 0x1C5, 0x2B0, 0x300, 0x3A3, 0x5D0, 0x627,
        0x660, 0x903, 0x2028, 0x200D, 0x2160, 0x20AC, 0x2603, 0x3000, 0x3042, 0x4E2D, 0xAC00,
        0xD800, 0xE000, 0xFF21, 0x1F600, 0x10FFFF, 0x378, 0x110000,
    ]
    for c in samples {
        show(c)
    }

    for c in [0x41, 0x3B1, 0x430, 0x5D0, 0x627, 0x915, 0xE01, 0xAC00, 0x3042, 0x30AB, 0x4E2D, 0x20, 0x300, 0x1F600, 0x378] {
        print("{text.hex(i64(c))} {script_of(u32(c))} {width_of(u32(c))}")
    }

    for c in [0x61, 0x41, 0xE9, 0xDF, 0x1C4, 0x1C5, 0x1C6, 0x130, 0x131, 0x3C3, 0x3C2, 0x3A3, 0x1F80, 0x10428, 0x2160, 0x4E2D] {
        cases(u32(c))
    }

    print(unicode.upper("hello, wörld"))
    print(unicode.upper("straße"))
    print(codes(unicode.upper("ŉ ﬃ ǆ")))
    print(unicode.lower("ÀÉÎÕÜ ǅ ΑΒΓ Ж"))
    print(codes(unicode.lower("İ")))
    print(unicode.lower("HeLLo"))
    print(unicode.upper("ἀ"))
    print(codes(unicode.upper("ᾳ")))

    print(unicode.display_width('a'))
    print(unicode.text_width("日本語abc"))
    print(unicode.text_width("é"))
    print(unicode.text_width("😀"))
    print(unicode.text_width(""))
}
