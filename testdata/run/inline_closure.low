fn apply_all(xs: []i64, f: fn(i64) -> i64) -> i64 {
    var total = 0
    for x in xs {
        total += f(x)
    }
    total
}

fn count_if(xs: []i64, keep: fn(i64) -> bool) -> i64 {
    var n = 0
    for x in xs {
        if keep(x) {
            n += 1
        }
    }
    n
}

fn tally(xs: []i64, limit: i64) -> i64 {
    var total = 0
    for x in xs {
        if x > limit {
            total += x * 2
        }
    }
    total
}

fn double(x: i64) -> i64 {
    x * 2
}

fn recurse(xs: []i64, depth: i64, f: fn(i64) -> i64) -> i64 {
    if depth == 0 {
        return apply_all(xs, f)
    }
    recurse(xs, depth - 1, f) + 1
}

fn main() {
    let xs = [1, 2, 3, 4, 5, 6]
    print(apply_all(xs, fn(x: i64) -> i64 { x * x }))
    print(count_if(xs, fn(x: i64) -> bool { x % 2 == 0 }))
    print(count_if(xs, fn(x: i64) -> bool { x > 3 }))
    print(apply_all(xs, double))
    let offset = 10
    print(apply_all(xs, fn(x: i64) -> i64 { x + offset }))
    print(recurse(xs, 3, fn(x: i64) -> i64 { x - 1 }))
    print(tally(xs, 2))
    print(tally(xs, 100))
}
