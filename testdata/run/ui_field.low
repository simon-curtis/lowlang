import std/ui
import std/ui/geometry
import std/ui/platform
import uitext = std/ui/text

fn show(f: ui.TextField) {
    let v = f.field_value()
    let marked = match v.marked {
        some(m) => " marked {m.start}-{m.end}"
        none => ""
    }
    let way = if v.reversed { " reversed" } else { "" }
    print("[{v.text}] {v.selection.start}-{v.selection.end}{way}{marked}")
}

fn typed(text: str) -> platform.Event {
    Key(platform.KeyEvent { key: Character(text), text })
}

fn named(k: platform.NamedKey, shift: bool) -> platform.Event {
    Key(platform.KeyEvent { key: Named(k), modifiers: platform.Modifiers { shift } })
}

fn word_key(k: platform.NamedKey, shift: bool) -> platform.Event {
    Key(platform.KeyEvent { key: Named(k), modifiers: platform.Modifiers { control: true, shift } })
}

fn click(cx: ui.Context, x: f32) {
    cx.dispatch(PointerDown(Left, x, 15.0))
    cx.dispatch(PointerUp(Left, x, 15.0))
}

fn control(c: str) -> platform.Event {
    Key(platform.KeyEvent { key: Character(c), modifiers: platform.Modifiers { control: true } })
}

fn render(cx: ui.Context, view: fn() -> ui.Element) {
    cx.frame(view, geometry.size(300.0, 100.0), 1.0)
}

fn caret_text(c: platform.Caret?) -> str {
    match c {
        some(r) => "{r.x},{r.y} {r.width}x{r.height}"
        none => "none"
    }
}

fn main() {
    let cx = ui.headless(ui.rgb(0xffffff))
    var now = 0
    cx.set_clock(fn() -> i64 { now })
    ui.bind_field_keys(cx) or {
        print("bind failed")
        return
    }
    let f = ui.text_field(cx, "héllo")
    let view = fn() -> ui.Element {
        ui.div().size(300.0, 100.0).padding(10.0).children() {
            ui.field(cx, f, "name", 16.0).width(200.0)
        }
    }
    render(cx, view)
    show(f)
    print("unfocused caret {caret_text(cx.input_caret())}")
    cx.dispatch(PointerDown(Left, 12.0, 15.0))
    cx.dispatch(PointerUp(Left, 12.0, 15.0))
    render(cx, view)
    print("focus {cx.focused()}")
    show(f)
    print("caret {caret_text(cx.input_caret())}")
    cx.dispatch(named(End, false))
    show(f)
    cx.dispatch(typed("!"))
    show(f)
    cx.dispatch(named(Left, false))
    cx.dispatch(named(Left, true))
    cx.dispatch(named(Left, true))
    show(f)
    cx.dispatch(named(Right, true))
    show(f)
    cx.dispatch(named(Backspace, false))
    show(f)
    cx.dispatch(named(Home, false))
    cx.dispatch(named(Right, false))
    cx.dispatch(named(Right, true))
    show(f)
    cx.dispatch(control("c"))
    cx.dispatch(named(Right, false))
    show(f)
    cx.dispatch(control("v"))
    show(f)
    cx.dispatch(named(Delete, false))
    show(f)
    cx.dispatch(control("a"))
    show(f)
    cx.dispatch(control("x"))
    show(f)
    print("clipboard {cx.read_from_clipboard() or none}")
    cx.dispatch(Preedit("か", none))
    show(f)
    cx.dispatch(Preedit("かな", platform.TextRange { start: 0, end: 6 }))
    show(f)
    cx.dispatch(Commit("仮名"))
    show(f)
    cx.dispatch(Preedit("x", none))
    cx.dispatch(Preedit("", none))
    show(f)
    cx.write_to_clipboard("two\nlines") or {}
    cx.dispatch(control("v"))
    show(f)
    cx.dispatch(named(Home, false))
    cx.dispatch(named(End, true))
    show(f)
    cx.dispatch(named(Home, true))
    show(f)
    cx.dispatch(ModifiersChanged(platform.Modifiers {}))
    f.set_field_text("ab")
    render(cx, view)
    show(f)
    print("caret {caret_text(cx.input_caret())}")
    cx.dispatch(PointerDown(Left, 11.0, 15.0))
    cx.dispatch(PointerMoved(200.0, 15.0))
    cx.dispatch(PointerUp(Left, 200.0, 15.0))
    show(f)
    now += 1000000000
    cx.dispatch(PointerDown(Left, 11.0, 15.0))
    cx.dispatch(PointerUp(Left, 11.0, 15.0))
    show(f)
    now += 1000000000
    cx.dispatch(ModifiersChanged(platform.Modifiers { shift: true }))
    cx.dispatch(PointerDown(Left, 200.0, 15.0))
    cx.dispatch(PointerMoved(15.0, 15.0))
    cx.dispatch(PointerUp(Left, 15.0, 15.0))
    show(f)
    cx.dispatch(ModifiersChanged(platform.Modifiers {}))
    cx.dispatch(Key(platform.KeyEvent { key: Named(Escape) }))
    cx.dispatch(typed("z"))
    show(f)
    words(cx, f, view)
    clicks(cx, f, view)
    edges(cx, f, view, fn() {
        now += 1000000000
    })
    blink(cx, f, view, fn(ms: i64) {
        now += ms * 1000000
    })
}

fn words(cx: ui.Context, f: ui.TextField, view: fn() -> ui.Element) {
    print("words")
    f.set_field_text("one two, three")
    render(cx, view)
    cx.dispatch(named(Home, false))
    for _ in 0..4 {
        cx.dispatch(word_key(Right, false))
        show(f)
    }
    for _ in 0..4 {
        cx.dispatch(word_key(Left, false))
        show(f)
    }
    cx.dispatch(word_key(Right, true))
    cx.dispatch(word_key(Right, true))
    show(f)
    cx.dispatch(word_key(Left, true))
    show(f)
    cx.dispatch(named(End, false))
    cx.dispatch(word_key(Backspace, false))
    show(f)
    cx.dispatch(named(Home, false))
    cx.dispatch(word_key(Delete, false))
    show(f)
    cx.dispatch(word_key(Delete, false))
    show(f)
}

fn clicks(cx: ui.Context, f: ui.TextField, view: fn() -> ui.Element) {
    print("clicks")
    f.set_field_text("alpha beta gamma")
    render(cx, view)
    let l = cx.shape_text("alpha beta gamma", uitext.Format {}, 1000.0)
    let x = 10.0 + l.lines[0].glyphs[7].x
    click(cx, x)
    show(f)
    click(cx, x)
    show(f)
    click(cx, x)
    show(f)
}

fn edges(cx: ui.Context, f: ui.TextField, view: fn() -> ui.Element, later: fn()) {
    print("edges")
    f.set_field_text("can't stop")
    render(cx, view)
    cx.dispatch(named(Home, false))
    for _ in 0..3 {
        cx.dispatch(named(Right, false))
    }
    cx.dispatch(word_key(Right, false))
    show(f)
    f.set_field_text("a\rb c\r\nd")
    show(f)
    f.set_field_text("éx")
    render(cx, view)
    let l = cx.shape_text("éx", uitext.Format {}, 1000.0)
    let accent = l.lines[0].glyphs[1]
    let past = 10.0 + (accent.x + accent.advance) / 2.0 + 1.0
    later()
    click(cx, past)
    show(f)
    later()
    click(cx, 11.0)
    show(f)
    f.set_field_text("abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyz")
    let clipped = fn() -> ui.Element {
        ui.div().size(300.0, 100.0).padding(10.0).truncate().children() {
            ui.field(cx, f, "name", 16.0).width(200.0)
        }
    }
    let sc = cx.frame(clipped, geometry.size(300.0, 100.0), 1.0)
    print("sprites under truncate {sc.sprites.len}")
}

fn carets(cx: ui.Context, view: fn() -> ui.Element) -> i64 {
    let sc = cx.frame(view, geometry.size(300.0, 100.0), 1.0)
    var n = 0
    for q in sc.quads {
        if q.bounds.width == 1.5 {
            n += 1
        }
    }
    n
}

fn blink(cx: ui.Context, f: ui.TextField, view: fn() -> ui.Element, wait: fn(i64)) {
    print("blink")
    f.set_field_text("ab")
    let fresh = carets(cx, view)
    wait(400)
    let held = carets(cx, view)
    wait(200)
    let off = carets(cx, view)
    wait(500)
    let on = carets(cx, view)
    wait(500)
    let again = carets(cx, view)
    cx.dispatch(typed("c"))
    let typing = carets(cx, view)
    cx.set_focus("")
    let unfocused = carets(cx, view)
    print("fresh {fresh} held {held} off {off} on {on} off {again} typed {typing} unfocused {unfocused}")
}
