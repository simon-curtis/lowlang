import std/io
import std/net

fn main() ! io.Error {
    let l = net.listen("127.0.0.1", 0)?
    let accepted = chan[net.Conn](1)
    spawn fn() {
        let peer = net.accept(l) catch {
            _ => return
        }
        accepted <- peer
    }()
    let c = net.connect(net.Addr { ip: net.parse_ip("127.0.0.1")?, port: l.addr.port })?
    let peer = match <-accepted {
        some(p) => p
        none => return
    }
    let done = chan[str](1)
    spawn fn() {
        let buf = io.buffer(16)
        let n = net.read(c, buf) catch {
            _ => -1
        }
        done <- "reader returned {n}"
    }()
    sleep(50)
    net.close(c)
    print((<-done) ?? "")
    let after = net.read(c, io.buffer(16)) catch {
        NotConnected => -2
        _ => -3
    }
    print("read after close {after}")
    net.close(c)
    net.close(peer)
    print("closed twice")
}
