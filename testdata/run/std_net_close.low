import std/io
import std/net

fn accepting(l: net.ListenerHandle) -> str {
    net.accept_handle(l) catch {
        NotConnected => return "listener closed"
        _ => return "listener other"
    }
    "listener open"
}

fn main() ! io.Error {
    using l = net.listen("127.0.0.1", 0)?
    let listening = l.handle
    let accepted = chan[net.ConnHandle](1)
    spawn fn() {
        let peer = net.accept_handle(listening) catch {
            _ => return
        }
        accepted <- peer
    }()
    using c = net.connect(net.Addr { ip: net.parse_ip("127.0.0.1")?, port: l.handle.addr.port })?
    using peer = match <-accepted {
        some(p) => net.adopt(p)
        none => return
    }
    let view = c.handle
    let done = chan[str](1)
    spawn fn() {
        let buf = io.buffer(16)
        let n = net.read_on(view, buf) catch {
            _ => -1
        }
        done <- "reader returned {n}"
    }()
    sleep(50)
    net.close(c)
    print((<-done) ?? "")
    let after = net.read(c, io.buffer(16)) catch {
        NotConnected => -2
        _ => -3
    }
    print("read after close {after}")
    net.close(c)
    net.close(peer)
    print("closed twice")

    net.close_listener(l)
    print(accepting(l.handle))
    net.close_listener(l)

    using udp = net.bind_udp("127.0.0.1", 0)?
    let target = udp.handle.addr
    net.close_socket(udp)
    let sent = net.send_to(udp, bytes("x"), target) catch {
        NotConnected => -2
        _ => -3
    }
    let received = net.receive_from(udp, io.buffer(8)) catch {
        NotConnected => net.Packet { size: -2, from: target }
        _ => net.Packet { size: -3, from: target }
    }
    print("udp after close {sent} {received.size}")
}
