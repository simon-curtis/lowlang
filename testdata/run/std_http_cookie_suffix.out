icann suffixes
  a=1; Domain=com from http://shop.example.com/: false
  b=1; Domain=co.uk from http://shop.example.co.uk/: false
  c=1; Domain=.CO.UK from http://shop.example.co.uk/: false
  d=1; Domain=example.co.uk from http://shop.example.co.uk/: true
  http://shop.example.co.uk/ sends d=1
  http://other.example.co.uk/ sends d=1
  http://example.com/ sends (none)
a suffix equal to the host is host-only
  a=1; Domain=com from http://com/: true
  b=1; Domain=co.uk from http://co.uk/: true
  c=1; Domain=localhost from http://localhost/: true
  holds a=1 domain com host_only true
  holds b=1 domain co.uk host_only true
  holds c=1 domain localhost host_only true
  http://sub.co.uk/ sends (none)
  http://co.uk/ sends b=1
private section
  a=1; Domain=github.io from http://alice.github.io/: false
  b=1; Domain=github.io from http://github.io/: true
  c=1; Domain=alice.github.io from http://alice.github.io/: true
  holds b=1 domain github.io host_only true
  holds c=1 domain alice.github.io host_only false
  http://alice.github.io/ sends c=1
  http://bob.github.io/ sends (none)
wildcard and exception rules
  w=1; Domain=b.ck from http://a.b.ck/: false
  x=1; Domain=a.b.ck from http://a.b.ck/: true
  y=1; Domain=www.ck from http://www.ck/: true
  z=1; Domain=ck from http://www.ck/: false
  v=1; Domain=sub.www.ck from http://x.sub.www.ck/: true
  http://a.b.ck/ sends x=1
  http://www.ck/ sends y=1
  http://x.sub.www.ck/ sends y=1; v=1
internationalised names
  a=1; Domain=中国 from http://shop.食狮.中国/: false
  b=1; Domain=xn--fiqs8s from http://shop.食狮.中国/: false
  c=1; Domain=食狮.中国 from http://shop.食狮.中国/: true
  d=1; Domain=.XN--85X722F.XN--FIQS8S from http://shop.食狮.中国/: true
  e=1; Domain=食狮.公司.cn from http://shop.xn--85x722f.xn--fiqs8s/: false
  f=1; Domain=公司.cn from http://www.食狮.公司.cn/: false
  g=1; Domain=食狮.公司.cn from http://www.食狮.公司.cn/: true
  http://shop.xn--85x722f.xn--fiqs8s/ sends c=1; d=1
  http://www.xn--85x722f.xn--55qx5d.cn/ sends g=1
  holds c=1 domain xn--85x722f.xn--fiqs8s host_only false
  holds d=1 domain xn--85x722f.xn--fiqs8s host_only false
  holds g=1 domain xn--85x722f.xn--55qx5d.cn host_only false
addresses are not suffixes
  a=1; Domain=127.0.0.1 from http://127.0.0.1/: true
  holds a=1 domain 127.0.0.1 host_only false
