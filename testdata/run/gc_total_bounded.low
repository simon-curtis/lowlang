import std/io

struct Cell {
    a: i64
    next: *Cell?
}

fn buffer_round(round: i64) -> i64 {
    let b = io.buffer(1048576)
    b[round % 1048576] = u8(round % 251 + 1)
    b[1048575] = 7
    i64(b[round % 1048576]) + i64(b[1048575]) + i64(b[524288])
}

fn chain_round(round: i64) -> i64 {
    var head: *Cell? = none
    for i in 0..1000 {
        head = new(Cell { a: i + round, next: head })
    }
    var sum = 0
    var cur = head
    for {
        match cur {
            some(c) => {
                sum += c.a
                cur = c.next
            }
            none => break
        }
    }
    sum
}

fn main() {
    var total = 0
    for round in 0..2048 {
        total += buffer_round(round)
    }
    print(total)
    for round in 0..4000 {
        total += chain_round(round) % 1000
    }
    print(total)
}
