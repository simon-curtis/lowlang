fn pick(mut a: i64, mut b: i64, flag: bool) {
    if flag {
        a = b + 1
    } else {
        b = a + 2
    }
}

fn maybe(mut a: i64, limit: i64) {
    if a < limit {
        a = a * 2
    }
}

fn once(mut a: i64, mut b: i64, mode: i64) {
    match mode {
        0 => {
            a = 10
        }
        1 => {
            b = 20
        }
        _ => {
            a = a + b
        }
    }
}

fn main() {
    var x = 1
    var y = 5
    for i in 0..4 {
        pick(mut x, mut y, i % 2 == 0)
    }
    print(x)
    print(y)

    var z = 3
    for i in 0..6 {
        maybe(mut z, 40)
    }
    print(z)

    var p = 0
    var q = 0
    for mode in 0..4 {
        once(mut p, mut q, mode)
        print(p)
        print(q)
    }
}
