    resolved("long_to_float", "long", "float", avro.Value.Int(16777216))
    resolved("string_to_bytes", "string", "bytes", avro.Value.Str("foo"))
    resolved("bytes_to_string", "bytes", "string", avro.Value.Bytes(bytes("bar")))
    conversions()
    rejects()
    mismatches()
    failed_resolutions()
    writer_state()
}

