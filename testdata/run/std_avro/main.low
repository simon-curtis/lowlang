import std/avro
import digest = std/crypto/hash
import std/io
import std/text

struct Address {
    street: str
    zip: i64?
}

enum Kind {
    Admin
    Guest
}

struct Person {
    id: i64
    name: str
    emails: str[]
    address: Address?
    scores: [str: f64]
    kind: Kind
    avatar: u8[]
}

fn expect(label: str, ok: bool) {
    if !ok {
        print("FAIL {label}")
    }
}

fn hex(data: u8[]) -> str {
    text.encode_hex(data)
}

fn hex64(x: u64) -> str {
    var out: u8[] = []
    for i in 0..8 {
        out.push(u8((x >> u64(56 - 8 * i)) & 0xFF))
    }
    hex(out)
}

fn copy(data: u8[]) -> u8[] {
    var out: u8[] = []
    io.append(mut out, data)
    out
}

fn same(a: u8[], b: u8[]) -> bool {
    if a.len != b.len {
        return false
    }
    for i in 0..a.len {
        if a[i] != b[i] {
            return false
        }
    }
    true
}

fn schema_of(source: str) -> *avro.Schema {
    avro.parse(source) catch {
        e => panic("schema {source}: {avro.message(e)}")
    }
}

fn prim(name: str) -> *avro.Schema {
    schema_of("\"{name}\"")
}

fn name_of(e: avro.Error) -> str {
    match e {
        Schema(_) => "Schema"
        Truncated(_) => "Truncated"
        Invalid(_, _) => "Invalid"
        TooLarge(_) => "TooLarge"
        Mismatch(_) => "Mismatch"
        Resolution(_) => "Resolution"
        Codec(_) => "Codec"
        Checksum => "Checksum"
        Io(_) => "Io"
    }
}

fn verdict(s: *avro.Schema, data: u8[]) -> str {
    avro.decode(s, data) catch {
        e => return name_of(e)
    }
    "accepted"
}

fn longs() {
    print("== long")
    let s = prim("long")
    let values: i64[] = [
        0, -1, 1, -2, 2, 63, -64, 64, -65, 8191, -8192, 8192, 2147483647, -2147483648, 4294967296,
        9223372036854775807, -9223372036854775807 - 1,
    ]
    for n in values {
        let data = avro.encode(s, avro.Value.Int(n)) or []
        print("long {n} {hex(data)}")
        let back = avro.decode(s, data) or avro.Value.Null
        expect("long round trip {n}", avro.diagnostic(back) == "{n}")
    }
}

fn primitive(kind: str, v: avro.Value) {
    let s = prim(kind)
    let data = avro.encode(s, v) or []
    print("{kind} {avro.diagnostic(v)} {hex(data)}")
    let back = avro.decode(s, data) or avro.Value.Null
    expect("{kind} round trip", avro.diagnostic(back) == avro.diagnostic(v))
}

fn primitives() {
    print("== primitives")
    primitive("int", avro.Value.Int(150))
    primitive("int", avro.Value.Int(-2147483648))
    primitive("int", avro.Value.Int(2147483647))
    primitive("boolean", avro.Value.Bool(true))
    primitive("boolean", avro.Value.Bool(false))
    primitive("float", avro.Value.Float(1.5))
    primitive("float", avro.Value.Float(-0.15625))
    primitive("float", avro.Value.Float(text.float_from_bits(0x7FF0000000000000)))
    primitive("double", avro.Value.Float(0.1))
    primitive("double", avro.Value.Float(-0.0))
    primitive("double", avro.Value.Float(text.float_from_bits(0xFFF0000000000000)))
    primitive("string", avro.Value.Str(""))
    primitive("string", avro.Value.Str("foo"))
    primitive("string", avro.Value.Str("héllo ☃ 𝄞"))
    primitive("string", avro.Value.Str("quote \" back \\ line \n tab \t ctl \0"))
    primitive("bytes", avro.Value.Bytes([]))
    primitive("bytes", avro.Value.Bytes([0x00, 0xFF, 0x10]))
    primitive("null", avro.Value.Null)
}

fn canonical_lines(label: str, source: str) {
    let s = schema_of(source)
    print("canonical {label} {avro.canonical(s)}")
    print("fingerprint {label} {hex64(avro.fingerprint(s))} {hex(avro.fingerprint_md5(s))} {hex(avro.fingerprint_sha256(s))}")
    let again = avro.parse(avro.to_json(s)) or s
    expect("to_json {label}", avro.canonical(again) == avro.canonical(s))
}

fn schemas() {
    print("== schemas")
    canonical_lines("spec_test.avsc", embed("spec_test.avsc"))
    canonical_lines("event.avsc", embed("event.avsc"))
    canonical_lines("named_refs.avsc", embed("named_refs.avsc"))
    canonical_lines("namespaces.avsc", embed("namespaces.avsc"))
    canonical_lines("logical.avsc", embed("logical.avsc"))
    canonical_lines("linked_list.avsc", embed("linked_list.avsc"))
    canonical_lines("unions.avsc", embed("unions.avsc"))
}

fn container(name: str, data: u8[]) {
    let fr = avro.open_bytes(data, avro.ReaderOptions {}) or return
    let values = avro.read_all(fr) or []
    print("file {name} codec {avro.codec_name(fr.codec)} count {values.len}")
    for v in values {
        print(avro.diagnostic(v))
    }
}

fn containers() {
    print("== containers")
    container("event_null.avro", bytes(embed("event_null.avro")))
    container("event_deflate.avro", bytes(embed("event_deflate.avro")))
    container("event_snappy.avro", bytes(embed("event_snappy.avro")))
    container("event_zstandard.avro", bytes(embed("event_zstandard.avro")))
    container("event_bzip2.avro", bytes(embed("event_bzip2.avro")))
    container("event_xz.avro", bytes(embed("event_xz.avro")))
}

fn logical() {
    print("== logical")
    container("logical.avro", bytes(embed("logical.avro")))
}

fn resolution() {
    print("== resolution")
    let reader = schema_of(embed("res_reader.avsc"))
    let data = bytes(embed("res_writer.avro"))
    let fr = avro.open_bytes(data, avro.ReaderOptions { reader_schema: some(reader) }) or return
    let values = avro.read_all(fr) or []
    print("file res_writer.avro resolved count {values.len}")
    for v in values {
        print(avro.diagnostic(v))
    }
}

fn record(a: i64, b: str) -> avro.Value {
    avro.Value.Record([
        avro.Member { name: "a", value: avro.Value.Int(a) },
        avro.Member { name: "b", value: avro.Value.Str(b) },
    ])
}

fn single() {
    print("== single")
    let s = schema_of(embed("spec_test.avsc"))
    let store = avro.schema_store()
    let id = avro.register(store, s)
    let first = avro.encode_single(s, record(27, "foo")) or []
    print("single {hex(first)}")
    let second = avro.encode_single(s, record(-1000000, "hé")) or []
    print("single2 {hex(second)}")
    expect("single fingerprint", avro.single_fingerprint(first) or 0 == id)
    let back = avro.decode_single(store, second) or avro.Value.Null
    expect("single decode", avro.diagnostic(back) == "{{\"a\": -1000000, \"b\": \"hé\"}}")
    let with = avro.decode_single_with(s, first) or avro.Value.Null
    expect("single decode_with", avro.diagnostic(with) == "{{\"a\": 27, \"b\": \"foo\"}}")
    let other = prim("long")
    expect("single other schema", verdict_single(other, first) == "Invalid")
    expect("single empty store", store_verdict(avro.schema_store(), first) == "Invalid")
    let broken = copy(first)
    broken[0] = 0xC2
    expect("single marker", store_verdict(store, broken) == "Invalid")
    expect("single short", store_verdict(store, first[..9]) == "Truncated")
}

fn store_verdict(store: avro.SchemaStore, data: u8[]) -> str {
    avro.decode_single(store, data) catch {
        e => return name_of(e)
    }
    "accepted"
}

fn verdict_single(s: *avro.Schema, data: u8[]) -> str {
    avro.decode_single_with(s, data) catch {
        e => return name_of(e)
    }
    "accepted"
}

fn typed() {
    print("== serde")
    let s = schema_of(embed("person.avsc"))
    round_trip(s, "person1", bytes(embed("person1.bin")))
    round_trip(s, "person2", bytes(embed("person2.bin")))
}

fn round_trip(s: *avro.Schema, label: str, data: u8[]) {
    let person = avro.deserialize[Person](s, data) or return
    let again = avro.serialize(s, person) or []
    print("{label} {hex(again)}")
    expect("{label} byte identical", same(again, data))
}

fn try_read(data: u8[]) -> bool {
    let fr = avro.open_bytes(data, avro.ReaderOptions {}) or return false
    avro.read_all(fr) or return false
    true
}

fn prefixes(name: str, data: u8[]) {
    var accepted = 0
    for n in 0..data.len + 1 {
        if try_read(data[..n]) {
            accepted += 1
        }
    }
    print("prefixes {name} accepted {accepted} of {data.len + 1}")
}

fn flips(name: str, data: u8[]) {
    var survived = 0
    for i in 0..data.len {
        let altered = copy(data)
        altered[i] ^= 0xFF
        let _ = try_read(altered)
        survived += 1
    }
    print("flips {name} swept {survived}")
}

fn find(data: u8[], pattern: str) -> i64 {
    let p = bytes(pattern)
    for i in 0..data.len - p.len + 1 {
        if same(data[i..i + p.len], p) {
            return i
        }
    }
    -1
}

fn read_verdict(data: u8[]) -> str {
    let fr = avro.open_bytes(data, avro.ReaderOptions {}) catch {
        e => return name_of(e)
    }
    avro.read_all(fr) catch {
        e => return name_of(e)
    }
    "accepted"
}

fn container_hostile() {
    let names = ["null", "deflate", "snappy", "zstandard", "bzip2", "xz"]
    let files = [
        bytes(embed("event_null.avro")),
        bytes(embed("event_deflate.avro")),
        bytes(embed("event_snappy.avro")),
        bytes(embed("event_zstandard.avro")),
        bytes(embed("event_bzip2.avro")),
        bytes(embed("event_xz.avro")),
    ]
    for i, data in files {
        prefixes("event_{names[i]}.avro", data)
    }
    print("badcrc {read_verdict(bytes(embed("event_badcrc.avro")))}")
    print("badsync {read_verdict(bytes(embed("event_badsync.avro")))}")
    let magic = copy(files[0])
    magic[0] ^= 1
    print("badmagic {read_verdict(magic)}")
    let unknown = copy(files[0])
    let at = find(unknown, "avro.codec")
    unknown[at + 11 + 3] = '9'
    print("unknowncodec {read_verdict(unknown)}")
}

fn flip_sweeps() {
    let names = ["null", "deflate", "snappy", "zstandard", "bzip2", "xz"]
    let files = [
        bytes(embed("event_null.avro")),
        bytes(embed("event_deflate.avro")),
        bytes(embed("event_snappy.avro")),
        bytes(embed("event_zstandard.avro")),
        bytes(embed("event_bzip2.avro")),
        bytes(embed("event_xz.avro")),
    ]
    for i, data in files {
        flips("event_{names[i]}.avro", data)
    }
}

fn long_bytes(n: i64) -> u8[] {
    avro.encode(prim("long"), avro.Value.Int(n)) or []
}

fn chain(nodes: i64) -> u8[] {
    var out: u8[] = []
    for _ in 1..nodes {
        out.push(0x00)
        out.push(0x02)
    }
    out.push(0x00)
    out.push(0x00)
    out
}

fn reject_prefixes(person: *avro.Schema, label: str, data: u8[]) {
    var rejected = 0
    for n in 0..data.len {
        if verdict(person, data[..n]) != "accepted" {
            rejected += 1
        }
    }
    print("prefixes {label}.bin rejected {rejected} of {data.len}")
}

fn array_outcome(s: *avro.Schema, data: u8[]) -> str {
    let v = avro.decode(s, data) catch {
        e => return name_of(e)
    }
    match v {
        Array(items) => "{items.len} accepted"
        _ => "not an array"
    }
}

fn binary_hostile() {
    let one = bytes(embed("person1.bin"))
    let two = bytes(embed("person2.bin"))
    let person = schema_of(embed("person.avsc"))
    reject_prefixes(person, "person1", one)
    reject_prefixes(person, "person2", two)
    var longer = copy(two)
    longer.push(0)
    print("trailing person2.bin {verdict(person, longer)}")
    print("badunion {verdict(schema_of("[\"null\", \"int\"]"), [0x0A])}")
    print("badenum {verdict(schema_of("{{\"type\": \"enum\", \"name\": \"E\", \"symbols\": [\"X\"]}}"), [0x04])}")
    print("hugearray {verdict(schema_of("{{\"type\": \"array\", \"items\": \"int\"}}"), long_bytes(1099511627776))}")
    print("hugestring {verdict(prim("string"), long_bytes(1099511627776))}")
    print("negativelength {verdict(prim("string"), long_bytes(-1))}")
    let list = schema_of(embed("linked_list.avsc"))
    for nodes in [50, 300, 100000] {
        print("deep {nodes} {verdict(list, chain(nodes))}")
    }
    let empties = schema_of("{{\"type\": \"array\", \"items\": {{\"type\": \"record\", \"name\": \"E\", \"fields\": []}}}}")
    var thousand = long_bytes(1000)
    thousand.push(0)
    print("zeroarray {array_outcome(empties, thousand)}")
    var huge = long_bytes(1073741824)
    huge.push(0)
    print("zeroarray 1073741824 {array_outcome(empties, huge)}")
}

fn written(s: *avro.Schema, values: avro.Value[], options: avro.WriterOptions) -> u8[] {
    var out: u8[] = []
    let sink: fn(u8[]) ! io.Error = fn(chunk) { io.append(mut out, chunk) }
    let w = avro.file_writer(s, sink, options) catch {
        e => panic("file_writer: {avro.message(e)}")
    }
    for v in values {
        avro.append(w, v) catch {
            e => panic("append: {avro.message(e)}")
        }
    }
    avro.finish(w) catch {
        e => panic("finish: {avro.message(e)}")
    }
    out
}

fn sync_marker(start: u8) -> u8[] {
    var out: u8[] = []
    for i in 0..16 {
        out.push(start + u8(i))
    }
    out
}

fn all_values(data: u8[]) -> avro.Value[] {
    let fr = avro.open_bytes(data, avro.ReaderOptions {}) or return []
    avro.read_all(fr) or []
}

fn rewrite(name: str, s: *avro.Schema, values: avro.Value[], options: avro.WriterOptions) {
    let data = written(s, values, options)
    let sum = digest.sum(digest.sha256(), data)
    print("wrote {name} {data.len} {hex(sum)}")
    let back = all_values(data)
    expect("{name} read back", back.len == values.len)
    for i in 0..back.len {
        expect("{name} value {i}", avro.diagnostic(back[i]) == avro.diagnostic(values[i]))
    }
}

fn writing() {
    print("== writing")
    let event = schema_of(embed("event.avsc"))
    let values = all_values(bytes(embed("event_null.avro")))
    let codecs = [avro.Codec.Null, avro.Codec.Deflate, avro.Codec.Snappy, avro.Codec.Zstandard, avro.Codec.Bzip2, avro.Codec.Xz]
    for codec in codecs {
        rewrite("event_{avro.codec_name(codec)}.avro", event, values, avro.WriterOptions { codec, sync: sync_marker(0), block_bytes: 400 })
    }
    let logical = schema_of(embed("logical.avsc"))
    rewrite("logical.avro", logical, all_values(bytes(embed("logical.avro"))), avro.WriterOptions { sync: sync_marker(16) })
    let person = schema_of(embed("person.avsc"))
    let sample = avro.deserialize[Person](person, bytes(embed("person1.bin"))) or return
    let metadata: [str: u8[]] = [:]
    metadata["origin"] = bytes("fixture")
    var buffer: u8[] = []
    let sink: fn(u8[]) ! io.Error = fn(chunk) { io.append(mut buffer, chunk) }
    let w = avro.file_writer(person, sink, avro.WriterOptions { codec: avro.Codec.Deflate, sync: sync_marker(48), metadata }) or return
    avro.write_value(w, sample) or return
    avro.write_value(w, sample) or return
    avro.finish(w) or return
    let fr = avro.open_bytes(buffer, avro.ReaderOptions {}) or return
    let people = avro.read_values[Person](fr) or return
    expect("typed file count", people.len == 2)
    expect("typed file metadata", same(fr.metadata["origin"] ?? [], bytes("fixture")))
    print("wrote person.avro {buffer.len} {hex(digest.sum(digest.sha256(), buffer))}")
}

fn decimals() {
    let texts = ["0.00", "-1234.567", "99999999.99", "-0.5", "128", "-128", "0"]
    let scales: i64[] = [2, 3, 2, 1, 0, 0, 0]
    for i, t in texts {
        let raw = avro.decimal_unscaled(t, scales[i], 0) or []
        print("decimal_unscaled {t} {scales[i]} {hex(raw)}")
        print("decimal_text {hex(raw)} {scales[i]} {avro.decimal_text(raw, scales[i])}")
    }
}

fn limited(s: *avro.Schema, data: u8[], options: avro.Options) -> str {
    avro.decode_with(s, data, options) catch {
        e => return name_of(e)
    }
    "accepted"
}

fn limits() {
    let text = avro.encode(prim("string"), avro.Value.Str("abc")) or []
    print("limits string {limited(prim("string"), text, avro.Options { max_length: 2 })}")
    let numbers = schema_of("{{\"type\": \"array\", \"items\": \"int\"}}")
    let items = avro.encode(numbers, avro.Value.Array([avro.Value.Int(1), avro.Value.Int(2), avro.Value.Int(3)])) or []
    print("limits items {limited(numbers, items, avro.Options { max_items: 2 })}")
    print("limits depth {limited(schema_of(embed("linked_list.avsc")), chain(5), avro.Options { max_depth: 3 })}")
}

fn resolved(label: str, writer: str, reader: str, v: avro.Value) {
    let ws = prim(writer)
    let data = avro.encode(ws, v) or []
    let got = avro.decode_resolved(ws, prim(reader), data) or avro.Value.Null
    print("resolve {label} {hex(data)} {avro.diagnostic(got)}")
}

fn conversions() {
    let s = schema_of(embed("spec_test.avsc"))
    let newer = schema_of(embed("spec_test_v2.avsc"))
    let store = avro.schema_store()
    let _ = avro.register(store, s)
    let message = avro.encode_single(s, record(27, "foo")) or []
    let upgraded = avro.decode_single_resolved(store, newer, message) or avro.Value.Null
    print("single_resolved {avro.diagnostic(upgraded)}")
    expect("lookup found", avro.lookup(store, avro.fingerprint(s)) != none)
    expect("lookup missing", avro.lookup(store, 1) == none)
    let direct = avro.resolve(prim("int"), prim("long"), avro.Value.Int(5)) or avro.Value.Null
    expect("resolve direct", avro.diagnostic(direct) == "5")
    let promoted = avro.deserialize_resolved[f64](prim("long"), prim("double"), long_bytes(5)) or -1.0
    expect("deserialize_resolved", promoted == 5.0)

    let person = schema_of(embed("person.avsc"))
    let data = bytes(embed("person1.bin"))
    let decoded = avro.decode(person, data) or avro.Value.Null
    let sample = avro.from_value[Person](decoded) or return
    let value = avro.to_value(person, sample) or avro.Value.Null
    print("tovalue {avro.diagnostic(value)}")
    print("fromvalue {sample.id} {sample.name} {sample.emails.len}")
}

fn parse_verdict(source: str) -> str {
    avro.parse(source) catch {
        e => return name_of(e)
    }
    "accepted"
}

fn rejects() {
    for line in text.lines(embed("rejects.txt")) {
        let at = text.index_byte(line, '\t')
        print("schema {line[..at]} {parse_verdict(line[at + 1..])}")
    }
}

fn encode_verdict(s: *avro.Schema, v: avro.Value) -> str {
    avro.encode(s, v) catch {
        e => return name_of(e)
    }
    "accepted"
}

fn mismatches() {
    let spec = schema_of(embed("spec_test.avsc"))
    let fixed = schema_of("{{\"type\": \"fixed\", \"name\": \"F3\", \"size\": 3}}")
    let symbols = schema_of("{{\"type\": \"enum\", \"name\": \"E1\", \"symbols\": [\"X\"]}}")
    let optional = schema_of("[\"null\", \"string\"]")
    let missing = avro.Value.Record([avro.Member { name: "b", value: avro.Value.Str("x") }])
    print("mismatch string_as_long {encode_verdict(prim("long"), avro.Value.Str("abc"))}")
    print("mismatch int_overflow {encode_verdict(prim("int"), avro.Value.Int(3000000000))}")
    print("mismatch missing_field {encode_verdict(spec, missing)}")
    print("mismatch fixed_size {encode_verdict(fixed, avro.Value.Bytes(bytes("abcd")))}")
    print("mismatch unknown_symbol {encode_verdict(symbols, avro.Value.Str("Z"))}")
    print("mismatch union_member {encode_verdict(optional, avro.Value.Int(5))}")
}

fn resolution_verdict(writer: *avro.Schema, reader: *avro.Schema, v: avro.Value) -> str {
    let data = avro.encode(writer, v) or []
    avro.decode_resolved(writer, reader, data) catch {
        e => return name_of(e)
    }
    "accepted"
}

fn failed_resolutions() {
    let spec = schema_of(embed("spec_test.avsc"))
    let other = schema_of("{{\"type\": \"record\", \"name\": \"test\", \"fields\": [{{\"name\": \"z\", \"type\": \"int\"}}]}}")
    let wide = schema_of("{{\"type\": \"enum\", \"name\": \"E\", \"symbols\": [\"X\", \"Y\"]}}")
    let narrow = schema_of("{{\"type\": \"enum\", \"name\": \"E\", \"symbols\": [\"X\"]}}")
    let strings = schema_of("[\"null\", \"string\"]")
    let ints = schema_of("[\"null\", \"int\"]")
    print("resolution string_to_int {resolution_verdict(prim("string"), prim("int"), avro.Value.Str("x"))}")
    print("resolution record_without_default {resolution_verdict(spec, other, record(1, "x"))}")
    print("resolution missing_symbol {resolution_verdict(wide, narrow, avro.Value.Enum(1, "Y"))}")
    print("resolution union_branch {resolution_verdict(strings, ints, avro.Value.Union(1, new(avro.Value.Str("s"))))}")
}

fn trickle(data: u8[]) -> *io.Reader {
    var at = 0
    let source = io.Stream {
        read: fn(buf) -> i64 ! io.Error {
            if at >= data.len || buf.len == 0 {
                return 0
            }
            buf[0] = data[at]
            at += 1
            1
        }
        write: fn(buf) -> i64 ! io.Error { fail io.Error.Unsupported }
        close: fn() {}
    }
    io.reader(source)
}

fn writer_state() {
    let spec = schema_of(embed("spec_test.avsc"))
    var chunks = 0
    let sink: fn(u8[]) ! io.Error = fn(chunk) { chunks += 1 }
    let w = avro.file_writer(spec, sink, avro.WriterOptions { sync: sync_marker(7) }) or return
    expect("header chunk", chunks == 1)
    expect("writer sync", same(avro.writer_sync(w), sync_marker(7)))
    avro.append(w, record(1, "a")) or return
    avro.append(w, record(2, "b")) or return
    expect("written", avro.written(w) == 2)
    expect("buffered", chunks == 1)
    avro.flush(w) or return
    expect("flushed", chunks == 2)
    avro.flush(w) or return
    expect("empty flush", chunks == 2)
    avro.finish(w) or return
    expect("finish", chunks == 2)
    let data = bytes(embed("event_snappy.avro"))
    let streamed = avro.open(trickle(data), avro.ReaderOptions {}) or return
    let whole = all_values(data)
    let values = avro.read_all(streamed) or []
    expect("trickle count", values.len == whole.len)
    for i in 0..values.len {
        expect("trickle value {i}", avro.diagnostic(values[i]) == avro.diagnostic(whole[i]))
    }
}

fn api() {
    print("== api")
    decimals()
