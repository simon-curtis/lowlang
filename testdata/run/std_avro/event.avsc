{
  "type": "record",
  "name": "Event",
  "namespace": "org.example",
  "doc": "A record with one field of every type",
  "fields": [
    {"name": "id", "type": "long"},
    {"name": "flag", "type": "boolean"},
    {"name": "count", "type": "int"},
    {"name": "ratio", "type": "float"},
    {"name": "score", "type": "double"},
    {"name": "blob", "type": "bytes"},
    {"name": "name", "type": "string"},
    {"name": "kind", "type": {"type": "enum", "name": "Kind", "symbols": ["A", "B", "C"], "default": "A"}},
    {"name": "tags", "type": {"type": "array", "items": "string"}},
    {"name": "attrs", "type": {"type": "map", "values": "long"}},
    {"name": "hash", "type": {"type": "fixed", "name": "Hash", "size": 4}},
    {"name": "maybe", "type": ["null", "string"], "default": null},
    {"name": "either", "type": ["int", "string", "Hash"]},
    {"name": "child", "type": ["null", {"type": "record", "name": "Node", "fields": [
      {"name": "value", "type": "int"},
      {"name": "next", "type": ["null", "Node"], "default": null}
    ]}], "default": null},
    {"name": "nested", "type": {"type": "array", "items": {"type": "map", "values": {"type": "array", "items": "double"}}}},
    {"name": "empty_rec", "type": {"type": "record", "name": "Empty", "fields": []}}
  ]
}
