import std/dbus
import std/io
import std/text

struct Decode {
    name: str
    signature: str
    hex: str
    order: dbus.ByteOrder = dbus.ByteOrder.Little
    fds: i64[] = []
}

fn decodes() -> Decode[] {
    [
        Decode { name: "int32", signature: "i", hex: "01000000" },
        Decode { name: "int32 big endian", signature: "i", hex: "00000001", order: dbus.ByteOrder.Big },
        Decode { name: "int16 negative", signature: "n", hex: "ffff" },
        Decode { name: "int16 negative big endian", signature: "n", hex: "fffe", order: dbus.ByteOrder.Big },
        Decode { name: "uint64", signature: "t", hex: "ffffffffffffffff" },
        Decode { name: "int64 big endian", signature: "x", hex: "fffffffffffffffe", order: dbus.ByteOrder.Big },
        Decode { name: "double", signature: "d", hex: "000000000000f83f" },
        Decode { name: "double big endian", signature: "d", hex: "3ff8000000000000", order: dbus.ByteOrder.Big },
        Decode { name: "boolean true", signature: "b", hex: "01000000" },
        Decode { name: "boolean false", signature: "b", hex: "00000000" },
        Decode { name: "boolean 2", signature: "b", hex: "02000000" },
        Decode { name: "boolean with a high byte", signature: "b", hex: "00000001" },
        Decode { name: "string", signature: "s", hex: "02000000686900" },
        Decode { name: "string without NUL", signature: "s", hex: "02000000686958" },
        Decode { name: "string holding NUL", signature: "s", hex: "0300000068006900" },
        Decode { name: "string invalid UTF-8", signature: "s", hex: "01000000ff00" },
        Decode { name: "string truncated", signature: "s", hex: "05000000686900" },
        Decode { name: "string length missing", signature: "s", hex: "0200" },
        Decode { name: "byte then uint32", signature: "yu", hex: "0100000002000000" },
        Decode { name: "non-zero padding", signature: "yu", hex: "0100010002000000" },
        Decode { name: "trailing byte", signature: "u", hex: "0100000000" },
        Decode { name: "truncated uint32", signature: "u", hex: "010000" },
        Decode { name: "empty input", signature: "u", hex: "" },
        Decode { name: "object path", signature: "o", hex: "020000002f6100" },
        Decode { name: "invalid object path", signature: "o", hex: "010000006100" },
        Decode { name: "signature", signature: "g", hex: "02696900" },
        Decode { name: "invalid signature", signature: "g", hex: "016100" },
        Decode { name: "fd index 1", signature: "h", hex: "01000000", fds: [10, 11] },
        Decode { name: "fd index 2", signature: "h", hex: "02000000", fds: [10, 11] },
        Decode { name: "fd without descriptors", signature: "h", hex: "00000000" },
        Decode { name: "variant of int32", signature: "v", hex: "0169000001000000" },
        Decode { name: "variant of invalid signature", signature: "v", hex: "016100" },
        Decode { name: "variant of two types", signature: "v", hex: "02696900" },
        Decode { name: "variant of nothing", signature: "v", hex: "0000" },
        Decode { name: "array of int32", signature: "ai", hex: "080000000100000002000000" },
        Decode { name: "array of int32 big endian", signature: "ai", hex: "000000080000000100000002", order: dbus.ByteOrder.Big },
        Decode { name: "array element past the end", signature: "ai", hex: "060000000100000002000000" },
        Decode { name: "array longer than data", signature: "ai", hex: "1000000001000000" },
        Decode { name: "empty int64 array", signature: "ax", hex: "0000000000000000" },
        Decode { name: "empty int64 array, bad padding", signature: "ax", hex: "0000000000000100" },
        Decode { name: "array over 64 MiB", signature: "ai", hex: "01000004" },
        Decode { name: "byte array", signature: "ay", hex: "03000000010203" },
        Decode { name: "struct", signature: "(yi)", hex: "0700000007000000" },
        Decode { name: "struct after a byte", signature: "y(yi)", hex: "01000000000000000700000007000000" },
        Decode { name: "struct with non-zero padding", signature: "(yi)", hex: "07ff000007000000" },
        Decode { name: "dict of string to variant", signature: "a{{sv}}", hex: "100000000000000001000000610001690000000005000000" },
        Decode { name: "empty dict", signature: "a{{sv}}", hex: "0000000000000000" },
    ]
}

fn show_values(values: dbus.Value[]) -> str {
    "{values}"
}

fn decode_case(c: Decode) {
    let types = dbus.parse_signature(c.signature) or panic("signature")
    let data = text.decode_hex(c.hex) or panic("hex")
    let values = dbus.decode(types, data, c.fds, c.order) catch {
        e => {
            print("{c.name}: {e}")
            return
        }
    }
    print("{c.name}: {show_values(values)}")
}

fn nested_variants(depth: i64) -> dbus.Value {
    var v = dbus.Value.Byte(7)
    for _ in 0..depth {
        v = dbus.variant(v)
    }
    v
}

fn nesting_result(depth: i64) -> str {
    let e = dbus.encode([nested_variants(depth)], dbus.ByteOrder.Little) catch {
        err => return "{err}"
    }
    "ok {e.data.len} bytes"
}

fn nested_variant_bytes(depth: i64) -> u8[] {
    var parts: str[] = []
    for _ in 1..depth {
        parts.push("017600")
    }
    parts.push("01790007")
    text.decode_hex(text.join(parts, "")) or panic("hex")
}

fn clip(s: str) -> str {
    if s.len > 100 {
        return "{s[..60]}... ({s.len} bytes)"
    }
    s
}

fn encode_result(values: dbus.Value[], order: dbus.ByteOrder) -> str {
    let e: dbus.Encoded = dbus.encode(values, order) catch {
        err => return clip("{err}")
    }
    "{text.encode_hex(e.data)} fds {e.fds}"
}

fn invalid_utf8() -> u8[] {
    let b: u8[] = [0x61, 0xff]
    b
}

fn embedded_nul() -> u8[] {
    let b: u8[] = [0x61, 0, 0x62]
    b
}

fn text_of(bytes: u8[]) -> str {
    str(bytes)
}

fn main() {
    for c in decodes() {
        decode_case(c)
    }

    print("nesting")
    let variant_type = [dbus.Type.Variant]
    for depth in [1, 64, 65, 100] {
        let decoded = dbus.decode(variant_type, nested_variant_bytes(depth), [], dbus.ByteOrder.Little) catch {
            e => {
                print("  decode {depth} variants: {e}")
                continue
            }
        }
        print("  decode {depth} variants: ok {decoded.len}")
    }
    for depth in [1, 64, 65, 100] {
        print("  encode {depth} variants: {nesting_result(depth)}")
    }

    print("encode")
    let cases: [str: dbus.Value[]] = [
        "int16 max": [dbus.Value.Int16(32767)],
        "int16 min": [dbus.Value.Int16(-32768)],
        "int16 above": [dbus.Value.Int16(32768)],
        "int16 below": [dbus.Value.Int16(-32769)],
        "string with NUL": [dbus.Value.String(text_of(embedded_nul()))],
        "string invalid UTF-8": [dbus.Value.String(text_of(invalid_utf8()))],
        "object path invalid": [dbus.Value.ObjectPath("a")],
        "object path": [dbus.Value.ObjectPath("/a")],
        "signature invalid": [dbus.Value.Signature("a")],
        "signature too long": [dbus.Value.Signature(text.repeat("i", 256))],
        "array item of the wrong type": [dbus.Value.Array("i", [dbus.Value.String("x")])],
        "array item of the wrong container": [dbus.Value.Array("(ii)", [dbus.Value.Struct([dbus.Value.Int32(1)])])],
        "array element not one type": [dbus.Value.Array("ii", [])],
        "empty struct": [dbus.Value.Struct([])],
        "dict entry outside an array": [dbus.Value.DictEntry(new(dbus.Value.String("a")), new(dbus.Value.Int32(1)))],
        "dict entry array": [dbus.Value.Array("{{si}}", [dbus.Value.DictEntry(new(dbus.Value.String("a")), new(dbus.Value.Int32(1)))])],
        "dict entry of a wrong key type": [dbus.Value.Array("{{si}}", [dbus.Value.DictEntry(new(dbus.Value.Int32(1)), new(dbus.Value.Int32(1)))])],
        "bytes as array of byte": [dbus.Value.Array("y", [dbus.Value.Byte(1), dbus.Value.Byte(2)])],
        "bytes": [dbus.Value.Bytes([1, 2])],
        "same fd twice": [dbus.Value.UnixFd(9), dbus.Value.UnixFd(9), dbus.Value.UnixFd(4)],
        "no values": [],
    ]
    for name, values in cases {
        print("  {name}: {encode_result(values, dbus.ByteOrder.Little)}")
    }
    print("  int16 big endian: {encode_result([dbus.Value.Int16(-2), dbus.Value.UInt32(1)], dbus.ByteOrder.Big)}")

    print("array limit")
    let large = io.buffer(67108865)
    let too_large = dbus.encode([dbus.Value.Bytes(large)], dbus.ByteOrder.Little) catch {
        e => {
            print("  {e}")
            return
        }
    }
    print("  encoded {too_large.data.len}")
}
