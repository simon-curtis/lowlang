    let one = next(r)
    let s: u64x4 = simd.splat(one)
    let la = lanes_u64x4(a)
    let lb = lanes_u64x4(b)
    let binary_lanes = lanes_all_u64x4(binary)
    let unary_lanes = lanes_all_u64x4(unary)
    let splat_lanes = lanes_u64x4(s)
    check_integers(c, la, lb, count, binary_lanes, unary_lanes, compare, splat_lanes, one)
}

