fn main() {
    let r = new(Rng { state: 0x9E3779B97F4A7C15 })
    check_u8x16(r)
    check_u8x32(r)
    check_u16x8(r)
    check_u16x16(r)
    check_u32x4(r)
    check_u32x8(r)
    check_i32x4(r)
    check_i32x8(r)
    check_u64x2(r)
    check_u64x4(r)
    check_i64x2(r)
    check_i64x4(r)
    check_f32x4(r)
    check_f32x8(r)
    check_f64x2(r)
    check_f64x4(r)
}
