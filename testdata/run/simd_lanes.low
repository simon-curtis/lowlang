    let a: u64x2 = simd.read(raw, 0)
    let b: u64x2 = simd.read(raw, 32)
    let count = i64(round % 64)
    let binary: []u64x2 = [a + b, a - b, a * b, a & b, a | b, a ^ b, simd.min(a, b), simd.max(a, b), simd.blend(a < b, a, b)]
    let unary: []u64x2 = [~a, -a, a << count, a >> count]
    let compare: []u64 = [simd.mask(a == b), simd.mask(a != b), simd.mask(a < b), simd.mask(a <= b), simd.mask(a > b), simd.mask(a >= b)]
    let one = next(r)
    let s: u64x2 = simd.splat(one)
    let la = lanes_u64x2(a)
    let lb = lanes_u64x2(b)
    let binary_lanes = lanes_all_u64x2(binary)
    let unary_lanes = lanes_all_u64x2(unary)
    let splat_lanes = lanes_u64x2(s)
    check_integers(c, la, lb, count, binary_lanes, unary_lanes, compare, splat_lanes, one)
}

fn check_u64x2(r: *Rng) {
    let c = new(Check { missed: [] })
    for round in 0..rounds {
        round_u64x2(c, r, round)
    }
    report("u64x2", c)
}

