fn round_f32x4(c: *Check, r: *Rng, round: i64) {
    let xs = floats32(r, 16)
    if round % 3 == 0 {
        share_floats32(xs)
    }
    let a: f32x4 = simd.read(xs, 0)
    let b: f32x4 = simd.read(xs, 8)
    let binary: []f32x4 = [a + b, a - b, a * b, a / b, simd.min(a, b), simd.max(a, b), simd.blend(a < b, a, b)]
    let unary: []f32x4 = [-a]
    let compare: []u64 = [simd.mask(a == b), simd.mask(a != b), simd.mask(a < b), simd.mask(a <= b), simd.mask(a > b), simd.mask(a >= b)]
    let la = lanes_f32x4(a)
    let lb = lanes_f32x4(b)
    let one = la[round % 4]
    let s: f32x4 = simd.splat(one)
    let binary_lanes = lanes_all_f32x4(binary)
    let unary_lanes = lanes_all_f32x4(unary)
    let splat_lanes = lanes_f32x4(s)
    check_floats(c, la, lb, binary_lanes, unary_lanes, compare, splat_lanes, one)
}

