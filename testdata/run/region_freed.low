struct Leaf {
    id: i64
}

struct Holder {
    leaf: *Leaf?
}

fn keep(h: *Holder, leaf: *Leaf) {
    h.leaf = leaf
}

fn main() {
    let kept = new(Holder { leaf: none })
    let id = region {
        let leaf = new(Leaf { id: 11 })
        keep(kept, leaf)
        leaf.id
    }
    print(id)
    match kept.leaf {
        some(leaf) => print(leaf.id)
        none => print("none")
    }
}
