import std/crypto/der
import std/text

fn hex(data: u8[]) -> str {
    text.encode_hex(data)
}

fn oid_text(name: str) -> str {
    let encoded = der.object_identifier(name) catch { e => return "rejected" }
    let element = der.whole(encoded, 0x06) catch { e => return "unreadable" }
    let back = der.oid(element.content) catch { e => return "undecodable" }
    "{hex(encoded)} {yes(back == name)}"
}

fn yes(ok: bool) -> str {
    if ok { "round trip" } else { "MISMATCH" }
}

fn time_text(seconds: i64) -> str {
    let encoded = der.time_value(seconds) catch { e => return "rejected" }
    let element = der.whole(encoded, encoded[0]) catch { e => return "unreadable" }
    let back = der.time(element) catch { e => return "undecodable" }
    "{hex(encoded)} {str(element.content)} {yes(back == seconds)}"
}

fn main() {
    for name in ["2.5.4.3", "1.2.840.113549.1.1.11", "1.3.6.1.5.5.7.1.31", "2.999.3", "0.9.2342.19200300.100.1.1", "2.5", "1.2.840.113549.1.1.11.1.268435456", "1", "3.1", "1.40", "1..2", "1.x", "", "2.5.4.3."] {
        print("object identifier {name}: {oid_text(name)}")
    }
    print("octet string: {hex(der.octet_string(bytes("abc")))}")
    print("empty octet string: {hex(der.octet_string([]))}")
    print("bit string: {hex(der.bit_string([0xA5, 0x01]))}")
    print("empty bit string: {hex(der.bit_string([]))}")
    print("utf8 string: {hex(der.utf8_string("héllo"))}")
    let long = text.repeat("x", 200)
    print("long utf8 string header: {hex(der.utf8_string(long)[0..4])}")
    print("set: {hex(der.set([der.octet_string([1]), der.octet_string([2, 3])]))}")
    print("empty set: {hex(der.set([]))}")
    for seconds in [0, 1767225600, 2524607999, 2524608000, -1, -631152000, -631152001, -2208988800, 253402300799, 253402300800, -62135596800, -62135596801, 951782400, 1709164800] {
        print("time {seconds}: {time_text(seconds)}")
    }
}
