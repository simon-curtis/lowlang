import std/time

fn next(mut state: u64) -> u64 {
    state ^= state << 13
    state ^= state >> 7
    state ^= state << 17
    state
}

fn inverse_fold(h: u64) -> u64 {
    let y = h << 1
    let x = y ^ y >> 16 ^ y >> 32 ^ y >> 48
    x ^ x >> 32
}

fn long_key(i: i64, mut state: u64, flood: bool) -> str {
    var b: []u8 = []
    for p in 0..23 {
        push(mut b, u8(next(mut state)))
    }
    if flood {
        for p in 0..7 {
            b[p] = u8(u64(i) >> u64(8 * p))
        }
        for p in 7..15 {
            b[p] = 0
        }
    }
    str(b)
}

fn short_key(i: i64, mut state: u64, flood: bool) -> str {
    var b: []u8 = []
    for p in 0..12 {
        push(mut b, u8(next(mut state)))
    }
    if flood {
        for p in 0..8 {
            b[p] = 0
        }
        for p in 0..4 {
            b[8 + p] = u8(u64(i) >> u64(8 * p))
        }
    }
    str(b)
}

fn integer_key(i: i64, mut state: u64, flood: bool) -> i64 {
    let random = next(mut state)
    if flood {
        return i64(inverse_fold(u64(i) << 32 | 12345))
    }
    i64(random)
}

fn strings(n: i64, long: bool, flood: bool) -> []str {
    var state: u64 = 88172645463325252
    var keys: []str = []
    for i in 0..n {
        push(mut keys, if long { long_key(i, mut state, flood) } else { short_key(i, mut state, flood) })
    }
    keys
}

fn integers(n: i64, flood: bool) -> []i64 {
    var state: u64 = 88172645463325252
    var keys: []i64 = []
    for i in 0..n {
        push(mut keys, integer_key(i, mut state, flood))
    }
    keys
}

fn measure[K: Hash](keys: []K) -> i64 {
    let start = time.now_nanos()
    var m: [K: i64] = [:]
    for i in 0..keys.len {
        m[keys[i]] = i
    }
    var found = 0
    for i in 0..keys.len {
        if (m[keys[i]] ?? -1) == i {
            found += 1
        }
    }
    for i in 0..keys.len {
        if i % 2 == 0 {
            delete(mut m, keys[i])
        }
    }
    let elapsed = time.now_nanos() - start
    if found != keys.len || m.len != keys.len / 2 {
        return -1
    }
    elapsed
}

fn spreads[K: Hash](flooded: []K, random: []K) -> bool {
    var base = measure(random)
    for round in 0..4 {
        let again = measure(random)
        if again < base {
            base = again
        }
    }
    if base <= 0 {
        return false
    }
    for round in 0..3 {
        let took = measure(flooded)
        if took >= 0 && took <= 30 * base {
            return true
        }
    }
    false
}

fn distinct(keys: []str) -> i64 {
    var seen: [str: bool] = [:]
    for k in keys {
        seen[k] = true
    }
    seen.len
}

fn main() {
    let n = 20000
    let long = strings(n, true, true)
    let short = strings(n, false, true)
    print("keys {distinct(long)} {distinct(short)} {long[0].len} {short[0].len}")
    print(spreads(long, strings(n, true, false)))
    print(spreads(short, strings(n, false, false)))
    print(spreads(integers(n, true), integers(n, false)))
}
