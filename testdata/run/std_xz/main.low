import std/compress/xz
import checksum = std/hash
import std/io

fn same(a: []u8, b: []u8) -> bool {
    if a.len != b.len {
        return false
    }
    for i in 0..a.len {
        if a[i] != b[i] {
            return false
        }
    }
    true
}

fn unpack(packed: []u8, limit: i64, want: []u8) -> str {
    let out = xz.decompress(packed, limit) catch {
        Malformed => return "Malformed"
        TooLarge => return "TooLarge"
        Unsupported => return "Unsupported"
        _ => return "other"
    }
    if same(out, want) { "ok" } else { "differs" }
}

fn unpack_lzma(packed: []u8, limit: i64, want: []u8) -> str {
    let out = xz.lzma_decompress(packed, limit) catch {
        Malformed => return "Malformed"
        TooLarge => return "TooLarge"
        Unsupported => return "Unsupported"
        _ => return "other"
    }
    if same(out, want) { "ok" } else { "differs" }
}

fn text(n: i64) -> []u8 {
    let words = ["lambda", "signal", "window", "range", "coder", "match", "literal", "dictionary", "chunk", "stream"]
    let out = io.buffer(n)
    var at = 0
    var seed: u32 = 12345
    for at < n {
        seed = seed * 1103515245 + 12345
        let w = words[i64(seed >> 16) % words.len]
        for i in 0..w.len {
            if at < n {
                out[at] = w[i]
                at += 1
            }
        }
        if at < n {
            out[at] = if seed & 0x700 == 0 { '\n' } else { ' ' }
            at += 1
        }
    }
    out
}

fn noise(n: i64) -> []u8 {
    let out = io.buffer(n)
    var s: u64 = 88172645463325252
    for i in 0..n {
        s ^= s << 13
        s ^= s >> 7
        s ^= s << 17
        out[i] = u8(s >> 32)
    }
    out
}

fn roundtrip(label: str, data: []u8, level: i64) {
    let packed = xz.compress(data, level)
    let alone = xz.lzma_compress(data, level)
    let back = unpack(packed, data.len, data)
    let alone_back = unpack_lzma(alone, data.len, data)
    print("{label} -{level} {data.len} -> {packed.len} {back}, lzma {alone.len} {alone_back}")
}

fn streaming(data: []u8) ! io.Error {
    var packed: []u8 = []
    let sink: fn([]u8) ! io.Error = fn(chunk) { io.append(mut packed, chunk) }
    let e = xz.encoder(6, sink)
    var at = 0
    var step = 1
    for at < data.len {
        var n = step
        if n > data.len - at {
            n = data.len - at
        }
        xz.encode(e, data[at..at + n])?
        at += n
        step = step * 5 + 3
    }
    xz.finish(e)?
    var chunks = 0
    var total = 0
    let crc = checksum.crc32_new()
    let count: fn([]u8) ! io.Error = fn(chunk) {
        chunks += 1
        total += chunk.len
        checksum.crc32_update(crc, chunk)
    }
    xz.decode(io.bytes_reader(packed), count, data.len)?
    let oneshot = xz.compress(data, 6)
    print("streaming {packed.len} oneshot {oneshot.len} {total == data.len} {checksum.crc32_sum(crc) == checksum.crc32(data)} {chunks < 40}")
}

fn main() {
    let sample = bytes(embed("sample.txt"))
    print("sha256 -9e {unpack(bytes(embed("sha256.xz")), 1 << 30, sample)}")
    print("crc32 -0 {unpack(bytes(embed("crc32.xz")), 1 << 30, sample)}")
    print("blocks {unpack(bytes(embed("blocks.xz")), 1 << 30, sample)}")
    print("delta {unpack(bytes(embed("delta.xz")), 1 << 30, sample)}")
    print("x86 {unpack(bytes(embed("x86.xz")), 1 << 30, sample)}")
    var twice: []u8 = []
    io.append(mut twice, sample)
    io.append(mut twice, sample)
    print("concatenated {unpack(bytes(embed("concat.xz")), 1 << 30, twice)}")
    print("lzma {unpack_lzma(bytes(embed("sample.lzma")), 1 << 30, sample)}")
    print("block limit {unpack(bytes(embed("blocks.xz")), sample.len - 1, sample)}")

    let empty: []u8 = []
    roundtrip("empty", empty, 6)
    roundtrip("byte", bytes("x"), 6)
    roundtrip("zeros", io.buffer(300000), 6)
    let words = text(400000)
    roundtrip("text", words, 0)
    roundtrip("text", words, 6)
    roundtrip("text", words, 9)
    roundtrip("noise", noise(150000), 6)
    streaming(text(1200000)) catch {
        _ => print("streaming failed")
    }

    let packed = xz.compress(words, 6)
    print("limit {unpack(packed, words.len - 1, words)}")
    print("truncated {unpack(packed[..packed.len - 5], words.len, words)}")
    let flipped = io.buffer(packed.len)
    io.copy(flipped, packed)
    flipped[packed.len / 2] ^= 0x10
    print("corrupt {unpack(flipped, words.len, words)}")
    print("lzma limit {unpack_lzma(xz.lzma_compress(words, 6), 100, words)}")
}
