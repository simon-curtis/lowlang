import std/mail
import std/text
import std/time

fn describe(e: mail.Error) -> str {
    match e {
        InvalidAddress(a) => "InvalidAddress({text.quote(a)})"
        HeaderInjection(h) => "HeaderInjection({text.quote(h)})"
        InvalidHeader(h) => "InvalidHeader({text.quote(h)})"
        NoRecipients => "NoRecipients"
    }
}

fn when() -> time.Instant {
    time.at_offset(1762851000, 3600)
}

fn base(subject: str, body: str) -> mail.Message {
    mail.Message {
        from: mail.address("ada@example.com")
        to: [mail.address("bob@example.org")]
        subject
        date: when()
        message_id: "plain-1@example.com"
        text: body
        boundary: "BOUNDARY"
    }
}

fn show(label: str, m: mail.Message) {
    let rendered = mail.render(m) catch {
        e => {
            print("=== {label}: {describe(e)}")
            return
        }
    }
    print("=== {label}")
    print(rendered)
    print("=== end")
}

fn reject(label: str, m: mail.Message) {
    let rendered = mail.render(m) catch {
        e => {
            print("{label}: {describe(e)}")
            return
        }
    }
    print("{label}: rendered {rendered.len} bytes")
}

fn binary(n: i64) -> []u8 {
    var out: []u8 = []
    for i in 0..n {
        push(mut out, u8(i * 7 + 3))
    }
    out
}

fn messages() {
    show("plain", base("Hello", "Hi Bob,\nthe build is green.\n"))

    var accented = base("Café ☕ - résumé für Zoë", "Grüße aus Köln: 100% = größer\n")
    accented.from = mail.named("Ada Lovelace-Königin", "ada@example.com")
    accented.to = [mail.named("Bob \"The Builder\" O'Neil", "bob@example.org"), mail.named("Émile Zola", "emile@example.net"), mail.address("plain@example.net")]
    show("accented", accented)

    var long_subject = base("", "x")
    long_subject.subject = "Rapport trimestriel détaillé du département des opérations: résultats, prévisions et écarts par rapport au budget initial 日本語のテキストも含む"
    show("long subject", long_subject)

    var ascii_long = base("", "x")
    ascii_long.subject = "A very long ASCII subject line that goes on and on and on past the seventy-eight column recommendation for header lines"
    show("long ascii subject", ascii_long)

    var crowd = base("Crowd", "to everyone\n")
    crowd.to = [
        mail.named("Alexandria Ocasio", "alexandria.ocasio@example.com")
        mail.named("Bartholomew Higgins-Smythe", "bartholomew.higgins-smythe@example.org")
        mail.named("Cornelius, Jr.", "cornelius@example.net")
        mail.address("dee@example.net")
    ]
    crowd.cc = [mail.named("Eve", "eve@example.com")]
    crowd.bcc = [mail.address("hidden@example.com")]
    crowd.reply_to = [mail.named("Team", "team@example.com")]
    crowd.headers = [mail.Header { name: "X-Mailer", value: "lowlang" }, mail.Header { name: "List-Id", value: "Ünïcode <list.example.com>" }]
    show("crowd", crowd)

    var alt = base("Both", "plain body\n")
    alt.html = "<p>html <b>body</b> with = and é</p>\n"
    show("alternative", alt)

    var html_only = base("Only html", "")
    html_only.html = "<h1>Title</h1>"
    show("html only", html_only)

    var empty = base("", "")
    show("empty", empty)

    var wrapped = base("Wrapped", "")
    wrapped.text = "{text.repeat("word ", 40)}\nshort line  \nline with tab\t\nequals = sign and é accent and trailing space \n\n\nend"
    show("quoted printable", wrapped)

    var full = base("With files", "See attached.\n")
    full.html = "<p>See <i>attached</i>.</p>\n"
    full.attachments = [
        mail.Attachment { filename: "data.bin", data: binary(200), content_type: "application/octet-stream" }
        mail.Attachment { filename: "résumé \"final\".txt", data: bytes("héllo\n"), content_type: "text/plain" }
        mail.Attachment { filename: "empty.pdf", data: [], content_type: "application/pdf" }
        mail.Attachment { filename: "quote\".txt", data: bytes("q"), content_type: "text/plain" }
    ]
    show("attachments", full)

    var attached_only = base("Just a file", "")
    attached_only.attachments = [mail.Attachment { filename: "a.txt", data: bytes("abc") }]
    show("attachment only", attached_only)

    var bit8 = base("8bit", "Grüße\n")
    bit8.eight_bit = true
    show("eight bit", bit8)
    print("needs 8bit: {mail.needs_8bit(bit8)} {mail.needs_8bit(accented)} {mail.needs_8bit(base("a", "b"))}")

    var utf8 = base("International", "hi\n")
    utf8.to = [mail.address("jörg@exämple.org")]
    show("international address", utf8)
    print("needs utf8: {mail.needs_utf8(utf8)} {mail.needs_utf8(accented)}")
}

fn injection() {
    var subject = base("Hello\r\nBcc: evil@example.com", "x")
    reject("subject crlf", subject)
    subject.subject = "Hello\nBcc: evil@example.com"
    reject("subject lf", subject)
    subject.subject = "Hello\rBcc: evil@example.com"
    reject("subject cr", subject)

    var name = base("ok", "x")
    name.from = mail.named("Ada\r\nBcc: evil@example.com", "ada@example.com")
    reject("from name", name)
    name = base("ok", "x")
    name.to = [mail.named("Bob\n", "bob@example.org")]
    reject("to name", name)
    name = base("ok", "x")
    name.cc = [mail.address("bob@example.org\r\nBcc: evil@example.com")]
    reject("cc address", name)
    name = base("ok", "x")
    name.reply_to = [mail.address("bob@example.org\n")]
    reject("reply-to address", name)

    var id = base("ok", "x")
    id.message_id = "a@b\r\nBcc: evil@example.com"
    reject("message id", id)
    id.message_id = "a b@example.com"
    reject("message id space", id)

    var extra = base("ok", "x")
    extra.headers = [mail.Header { name: "X-Note", value: "fine\r\nBcc: evil@example.com" }]
    reject("header value", extra)
    extra.headers = [mail.Header { name: "X-Note\r\nBcc", value: "fine" }]
    reject("header name crlf", extra)
    extra.headers = [mail.Header { name: "X Note", value: "fine" }]
    reject("header name space", extra)
    extra.headers = [mail.Header { name: "X-Note:", value: "fine" }]
    reject("header name colon", extra)
    extra.headers = [mail.Header { name: "", value: "fine" }]
    reject("header name empty", extra)
    extra.headers = [mail.Header { name: "X-Tab", value: "a\tb" }]
    reject("header value tab", extra)
    extra.headers = [mail.Header { name: "X-Nul", value: "a\0b" }]
    reject("header value nul", extra)

    var file = base("ok", "x")
    file.attachments = [mail.Attachment { filename: "a\r\nBcc: evil@example.com", data: [] }]
    reject("attachment filename", file)
    file.attachments = [mail.Attachment { filename: "a.txt", data: [], content_type: "text/plain\r\nBcc: x" }]
    reject("attachment type", file)
    file.attachments = [mail.Attachment { filename: "a.txt", data: [], content_type: "plain" }]
    reject("attachment type shape", file)

    var boundary = base("ok", "x")
    boundary.boundary = "a\r\nb"
    reject("boundary crlf", boundary)
    boundary.boundary = "a b"
    reject("boundary space", boundary)

    let body = base("ok", "line one\r\nBcc: evil@example.com\r\n.\r\n")
    reject("body lines allowed", body)
}

fn addresses() {
    for a in ["ada@example.com", "a.b+c@sub.example.com", "jörg@exämple.org", "", "@", "a@", "@b", "a@b@c", "a b@c", "a..b@c", ".a@c", "a.@c", "a@c..d", "a<b>@c", "a@c.", "a@[1.2.3.4]", "\"q\"@c", "a,b@c", "a\0@c"] {
        print("valid {text.quote(a)}: {mail.valid_email(a)}")
    }
    for a in ["ada@example.com", "Ada Lovelace <ada@example.com>", "\"Lovelace, Ada\" <ada@example.com>", "<ada@example.com>", "  Ada  <ada@example.com>  ", "\"Q \\\"x\\\"\" <ada@example.com>", "Ada <ada@example.com", "Ada ada@example.com>", "Ada <bad>", "<>", ""] {
        let parsed = mail.parse_address(a) catch {
            e => {
                print("parse {text.quote(a)}: {describe(e)}")
                continue
            }
        }
        print("parse {text.quote(a)}: name={text.quote(parsed.name)} email={parsed.email} formatted={text.quote(mail.format_address(parsed))}")
    }
}

fn recipients() {
    var m = base("r", "x")
    m.to = [mail.address("a@example.com"), mail.address("A@example.com"), mail.address("b@example.com")]
    m.cc = [mail.address("c@example.com"), mail.address("b@example.com")]
    m.bcc = [mail.address("d@example.com")]
    let all = mail.recipients(m) catch {
        e => {
            print("recipients: {describe(e)}")
            return
        }
    }
    print("recipients: {text.join(all, " ")}")
    m.to = []
    m.cc = []
    m.bcc = []
    let none_left = mail.recipients(m) catch {
        e => {
            print("no recipients: {describe(e)}")
            []
        }
    }
    m.bcc = [mail.address("nope")]
    let bad = mail.recipients(m) catch {
        e => {
            print("bad recipient: {describe(e)}")
            []
        }
    }
}

fn encodings() {
    for s in ["", "plain", "trailing ", "a=b", "é", "tab\there", "tab at end\t", "line\r\nbreak", "bare\nlf", "bare\rcr", "x\n"] {
        print("qp {text.quote(s)}: {text.quote(mail.quoted_printable(s))}")
    }
    print("qp 80 a: {text.quote(mail.quoted_printable(text.repeat("a", 80)))}")
    print("qp 76 a: {text.quote(mail.quoted_printable(text.repeat("a", 76)))}")
    print("qp 75 a: {text.quote(mail.quoted_printable(text.repeat("a", 75)))}")
    print("qp 74 a then é: {text.quote(mail.quoted_printable("{text.repeat("a", 74)}é"))}")
    print("qp 73 a then é: {text.quote(mail.quoted_printable("{text.repeat("a", 73)}é"))}")
    for s in ["", "é", "日本語", "plain é mix", text.repeat("é", 40)] {
        print("words {text.quote(s)}: {text.quote(mail.encode_words(s, 9))}")
    }
    print("base64 0: {text.quote(mail.wrap_base64([]))}")
    print("base64 57: {text.quote(mail.wrap_base64(binary(57)))}")
    print("base64 58: {text.quote(mail.wrap_base64(binary(58)))}")
    let generated = mail.new_message_id("example.com")
    print("generated id: {generated.len} {generated[0]} {generated[generated.len - 1]} {text.ends_with(generated, "@example.com>")}")
}

fn defaults() {
    var m = base("defaults", "x")
    m.date = none
    m.message_id = ""
    m.boundary = ""
    let rendered = mail.render(m) catch {
        e => {
            print("defaults: {describe(e)}")
            return
        }
    }
    let lines = text.split_str(rendered, "\r\n")
    print("defaults: date {text.starts_with(lines[0], "Date: ")} {text.ends_with(lines[0], " +0000")}")
    var id = ""
    for line in lines {
        if text.starts_with(line, "Message-ID: ") {
            id = line
        }
    }
    print("defaults: {id.len} {text.ends_with(id, "@example.com>")}")
}

fn main() {
    messages()
    injection()
    addresses()
    recipients()
    encodings()
    defaults()
}
