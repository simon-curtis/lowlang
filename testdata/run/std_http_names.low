import std/header
import std/http
import std/io
import std/text

struct Source {
    data: []u8
    at: i64
}

fn source_stream(src: *Source) -> io.Stream {
    io.Stream {
        read: fn(buf: []u8) -> i64 ! io.Error {
            let n = io.copy(buf, src.data[src.at..])
            src.at += n
            n
        }
        write: fn(buf: []u8) -> i64 ! io.Error {
            buf.len
        }
        close: fn() {}
    }
}

fn request_with(names: []str) -> []u8 {
    var out: []u8 = []
    text.append(mut out, "POST /submit?x=1 HTTP/1.1\r\n")
    for i in 0..names.len {
        text.append(mut out, "{names[i]}: value-{i}\r\n")
    }
    text.append(mut out, "Content-Length: 2\r\n\r\nok")
    out
}

fn parsed(names: []str) ! io.Error {
    let src = new(Source { data: request_with(names), at: 0 })
    let r = io.reader(source_stream(src))
    let req = http.read_request(r)?
    print("{req.method} {req.path} {req.query} {str(req.body)}")
    for h in req.headers {
        print("{h.name}={h.value}")
    }
}

fn lookups() ! io.Error {
    let names = ["Host", "ACCEPT-ENCODING", "x-Custom-Header", "Content-Type"]
    let src = new(Source { data: request_with(names), at: 0 })
    let r = io.reader(source_stream(src))
    let req = http.read_request(r)?
    for name in ["host", "HOST", "accept-encoding", "x-custom-header", "content-type", "content-length", "missing"] {
        let value = header.get(req.headers, name) ?? "-"
        print("{name} {value}")
    }
}

fn statuses() {
    var known = 0
    var total = 0
    for status in 0..700 {
        let name = http.status_text(status)
        if name.len > 0 {
            known += 1
            total += name.len
            print("{status} {name}")
        }
    }
    print("known {known} {total}")
}

fn error_name(e: io.Error) -> str {
    match e {
        Denied => "Denied"
        NotFound => "NotFound"
        WouldBlock => "WouldBlock"
        Exists => "Exists"
        NotDir => "NotDir"
        IsDir => "IsDir"
        Invalid => "Invalid"
        NoSpace => "NoSpace"
        BrokenPipe => "BrokenPipe"
        NotEmpty => "NotEmpty"
        AddrInUse => "AddrInUse"
        AddrUnavailable => "AddrUnavailable"
        Unreachable => "Unreachable"
        Aborted => "Aborted"
        Reset => "Reset"
        NotConnected => "NotConnected"
        TimedOut => "TimedOut"
        Refused => "Refused"
        Os(code) => "Os({code})"
        _ => "other"
    }
}

fn errors() {
    var parts: []str = []
    for code in 0..130 {
        let name = error_name(io.errno(code))
        push(mut parts, "{code}:{name}")
    }
    print(text.join(parts, " "))
}

fn main() ! io.Error {
    parsed(["Host", "host", "DATE", "ETag", "vary", "Range", "Accept", "COOKIE", "Origin", "server", "Pragma", "Referer", "Upgrade", "Expires", "Location", "Connection", "User-Agent", "Set-Cookie", "Content-Type", "Authorization", "Cache-Control", "Last-Modified", "If-None-Match", "Accept-Encoding", "Accept-Language", "X-Forwarded-For", "Content-Encoding", "Transfer-Encoding", "If-Modified-Since"])?
    parsed(["hosx", "Dat", "Accep", "X-Y", "x-forwarded-fo", "Content-Typ", "AUTHORIZATIONS", "Cache-Controls", "Z", "A-Very-Long-Header-Name-Indeed", "Mixed-CASE-Name"])?
    lookups()?
    statuses()
    errors()
}
