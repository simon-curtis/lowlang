fn fill_u8(n: i64) -> []u8 {
    var xs: []u8 = []
    for i in 0..n {
        push(mut xs, u8(i * 37 + 200))
    }
    xs
}

fn fill_u16(n: i64) -> []u16 {
    var xs: []u16 = []
    for i in 0..n {
        push(mut xs, u16(i * 4099 + 65000))
    }
    xs
}

fn fill_u32(n: i64) -> []u32 {
    var xs: []u32 = []
    for i in 0..n {
        push(mut xs, u32(i * 268435399 + 4000000000))
    }
    xs
}

fn fill_i32(n: i64) -> []i32 {
    var xs: []i32 = []
    for i in 0..n {
        push(mut xs, i32(i * 1000003 - 2100000000))
    }
    xs
}

fn fill_i64(n: i64) -> []i64 {
    var xs: []i64 = []
    for i in 0..n {
        push(mut xs, i * 3000000007 - 9000000000)
    }
    xs
}

fn fill_f32(n: i64) -> []f32 {
    var xs: []f32 = []
    for i in 0..n {
        push(mut xs, f32(i) * 1.5 - 7.25)
    }
    xs
}

fn fill_f64(n: i64) -> []f64 {
    var xs: []f64 = []
    for i in 0..n {
        push(mut xs, f64(i) * 0.375 - 3.5)
    }
    xs
}

fn sum_u8(xs: []u8) -> i64 {
    var t = 0
    for i in 0..xs.len {
        t += i64(xs[i])
    }
    t
}

fn sum_u16(xs: []u16) -> i64 {
    var t = 0
    for i in 0..xs.len {
        t += i64(xs[i])
    }
    t
}

fn sum_u32(xs: []u32) -> i64 {
    var t = 0
    for i in 0..xs.len {
        t += i64(xs[i])
    }
    t
}

fn sum_i32(xs: []i32) -> i64 {
    var t = 0
    for i in 0..xs.len {
        t += i64(xs[i])
    }
    t
}

fn sum_i64(xs: []i64) -> i64 {
    var t = 0
    for i in 0..xs.len {
        t += xs[i]
    }
    t
}

fn sum_f32(xs: []f32) -> f32 {
    var t: f32 = 0.0
    for i in 0..xs.len {
        t += xs[i]
    }
    t
}

fn sum_f64(xs: []f64) -> f64 {
    var t = 0.0
    for i in 0..xs.len {
        t += xs[i]
    }
    t
}

fn offsets(xs: []i64, i: i64) -> i64 {
    xs[i] + xs[i + 1] * 2 + xs[i + 3] * 3 + xs[i * 2 + 1]
}

fn store_u8(xs: []u8, n: i64) {
    for i in 0..n {
        xs[i] = u8(i * 91)
        xs[i] += 250
    }
}

fn store_u16(xs: []u16, n: i64) {
    for i in 0..n {
        xs[i] = u16(i * 9001)
        xs[i] += 65500
    }
}

fn store_u32(xs: []u32, n: i64) {
    for i in 0..n {
        xs[i] = u32(i * 900000001)
        xs[i] += 4294967000
    }
}

fn store_i32(xs: []i32, n: i64) {
    for i in 0..n {
        xs[i] = i32(i * 700000001)
        xs[i] -= 2147483000
    }
}

fn store_f32(xs: []f32, n: i64) {
    for i in 0..n {
        xs[i] = f32(i) * 0.1
        xs[i] += 0.25
    }
}

fn store_f64(xs: []f64, n: i64) {
    for i in 0..n {
        xs[i] = f64(i) * 0.1
        xs[i] += 0.25
    }
}

fn reverse_i64(xs: []i64) {
    var lo = 0
    var hi = xs.len - 1
    for lo < hi {
        let t = xs[lo]
        xs[lo] = xs[hi]
        xs[hi] = t
        lo += 1
        hi -= 1
    }
}

fn reverse_u8(xs: []u8) {
    var lo = 0
    var hi = xs.len - 1
    for lo < hi {
        let t = xs[lo]
        xs[lo] = xs[hi]
        xs[hi] = t
        lo += 1
        hi -= 1
    }
}

fn byte_index(xs: []u8, table: []i64) -> i64 {
    var t = 0
    for i in 0..xs.len {
        t += table[xs[i]]
    }
    t
}

fn first_last(xs: []u16) -> i64 {
    i64(xs[0]) * 100000 + i64(xs[xs.len - 1])
}

fn main() {
    let a = fill_u8(37)
    let b = fill_u16(41)
    let c = fill_u32(29)
    let d = fill_i32(23)
    let e = fill_i64(31)
    let f = fill_f32(19)
    let g = fill_f64(17)
    print(sum_u8(a))
    print(sum_u16(b))
    print(sum_u32(c))
    print(sum_i32(d))
    print(sum_i64(e))
    print(sum_f32(f))
    print(sum_f64(g))
    print(offsets(e, 0))
    print(offsets(e, 5))
    print(offsets(e, 13))
    print(first_last(b))

    store_u8(a, 37)
    store_u16(b, 41)
    store_u32(c, 29)
    store_i32(d, 23)
    store_f32(f, 19)
    store_f64(g, 17)
    print(sum_u8(a))
    print(sum_u16(b))
    print(sum_u32(c))
    print(sum_i32(d))
    print(sum_f32(f))
    print(sum_f64(g))
    print("{a[0]} {a[1]} {a[36]}")
    print("{b[0]} {b[1]} {b[40]}")
    print("{c[0]} {c[1]} {c[28]}")
    print("{d[0]} {d[1]} {d[22]}")
    print("{f[0]} {f[1]} {f[18]}")
    print("{g[0]} {g[1]} {g[16]}")

    reverse_i64(e)
    reverse_u8(a)
    print("{e[0]} {e[30]} {a[0]} {a[36]}")

    let table: []i64 = fill_i64(256)
    print(byte_index(a, table))
}
