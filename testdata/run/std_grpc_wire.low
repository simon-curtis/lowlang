import std/grpc
import std/header
import std/io

fn hex(data: u8[]) -> str {
    var out = ""
    for b in data {
        let digits = "0123456789abcdef"
        let hi = i64(b) >> 4
        let lo = i64(b) & 15
        out = "{out}{digits[hi..hi + 1]}{digits[lo..lo + 1]}"
    }
    out
}

fn show_timeout(nanos: i64) {
    let encoded = grpc.encode_timeout(nanos) ?? "none"
    let back = grpc.parse_timeout(encoded) ?? -1
    print("timeout {nanos} -> {encoded} -> {back}")
}

fn show_parse(value: str) {
    match grpc.parse_timeout(value) {
        some(n) => print("parse {value} = {n}")
        none => print("parse {value} rejected")
    }
}

fn show_message(message: str) {
    let encoded = grpc.encode_message(message)
    let decoded = grpc.decode_message(encoded)
    print("message {encoded} round trip {decoded == message}")
}

fn show_http(status: i64) {
    print("http {status} {grpc.code_name(grpc.code_of_http(status))}")
}

fn show_reset(code: i64) {
    print("reset {code} {grpc.code_name(grpc.status_of_reset(code).code)}")
}

fn timeouts() {
    show_timeout(1)
    show_timeout(99999999)
    show_timeout(100000000)
    show_timeout(1500000000)
    show_timeout(100000000000)
    show_timeout(3600000000000)
    show_timeout(9000000000000000000)
    show_timeout(0)
    show_timeout(-5)
    show_parse("1H")
    show_parse("10M")
    show_parse("5S")
    show_parse("250m")
    show_parse("7u")
    show_parse("99999999n")
    show_parse("123456789S")
    show_parse("5")
    show_parse("S")
    show_parse("5x")
    show_parse("-5S")
    show_parse("5 S")
}

fn messages() {
    show_message("")
    show_message("plain text, with spaces")
    show_message("100%")
    show_message("line\nbreak")
    show_message("tab\there")
    show_message("héllo ☃")
    show_message("%41 stays literal when decoded from text")
    print("decode {grpc.decode_message("a%2")} {grpc.decode_message("a%zz")} {grpc.decode_message("%e2%98%83")}")
}

fn statuses() {
    for status in [200, 400, 401, 403, 404, 429, 500, 502, 503, 504, 302] {
        show_http(status)
    }
    for code in 0..15 {
        show_reset(code)
    }
    for n in [-1, 0, 16, 17, 99] {
        print("code {n} {grpc.code_name(grpc.code_of(n))}")
    }
}

fn framing() {
    print("frame {hex(grpc.frame([1, 2, 3], false))}")
    print("frame flag {hex(grpc.frame([], true))}")
    let reader = grpc.message_reader(1024, grpc.Encoding.Identity)
    let whole = grpc.frame([9, 8, 7], false)
    var out = whole
    io.append(mut out, grpc.frame([], false))
    io.append(mut out, grpc.frame([5], false))
    var taken = 0
    for b in out {
        grpc.feed(reader, [b])
        for {
            let next = grpc.take(reader) catch {
                e => {
                    print("take failed {grpc.describe(e)}")
                    return
                }
            }
            match next {
                some(m) => {
                    taken += 1
                    print("message {taken} {hex(m)}")
                }
                none => break
            }
        }
    }
    print("pending {grpc.pending(reader)}")
}

fn read_error(r: *grpc.MessageReader) {
    let _ = grpc.take(r) catch {
        e => {
            print("error {grpc.describe(e)}")
            return
        }
    }
    print("no error")
}

fn failures() {
    let small = grpc.message_reader(4, grpc.Encoding.Identity)
    grpc.feed(small, grpc.frame([1, 2, 3, 4, 5], false))
    read_error(small)
    let exact = grpc.message_reader(5, grpc.Encoding.Identity)
    grpc.feed(exact, grpc.frame([1, 2, 3, 4, 5], false))
    read_error(exact)
    let flag = grpc.message_reader(100, grpc.Encoding.Identity)
    grpc.feed(flag, [2, 0, 0, 0, 0])
    read_error(flag)
    let bare = grpc.message_reader(100, grpc.Encoding.Identity)
    grpc.feed(bare, grpc.frame([1], true))
    read_error(bare)
    let broken = grpc.message_reader(100, grpc.Encoding.Gzip)
    grpc.feed(broken, grpc.frame([1, 2, 3], true))
    read_error(broken)
    let zip = grpc.message_reader(60, grpc.Encoding.Gzip)
    var zeros: u8[] = []
    for _ in 0..200 {
        zeros.push(0)
    }
    let big = grpc.encode_message_frame(zeros, grpc.Encoding.Gzip)
    grpc.feed(zip, big)
    read_error(zip)
}

fn compression() {
    let data = bytes("hello hello hello hello hello hello hello hello")
    for e in [grpc.Encoding.Identity, grpc.Encoding.Gzip, grpc.Encoding.Deflate] {
        let framed = grpc.encode_message_frame(data, e)
        let r = grpc.message_reader(1024, e)
        grpc.feed(r, framed)
        let back = grpc.take(r) catch {
            err => {
                print("compression {grpc.encoding_name(e)} failed {grpc.describe(err)}")
                continue
            }
        }
        let same = match back {
            some(m) => str(m) == str(data)
            none => false
        }
        print("compression {grpc.encoding_name(e)} flag={framed[0]} smaller={framed.len < data.len + 5} round trip {same}")
    }
    for name in ["gzip", "GZIP", "deflate", "identity", "br", "snappy", ""] {
        print("encoding {name} {grpc.parse_encoding(name) != none}")
    }
    print("accepts {grpc.accepts("gzip, deflate", grpc.Encoding.Gzip)} {grpc.accepts("deflate", grpc.Encoding.Gzip)} {grpc.accepts("", grpc.Encoding.Identity)}")
    print("first {grpc.encoding_name(grpc.first_encoding("br,gzip,deflate"))} {grpc.encoding_name(grpc.first_encoding("br"))}")
}

fn metadata() {
    var m = grpc.Metadata {}
    grpc.add(mut m, "X-Trace", "one") or {}
    grpc.add(mut m, "x-trace", "two") or {}
    grpc.add_bin(mut m, "token-bin", [0, 255, 7]) or {}
    print("values {grpc.values(m, "X-TRACE")} first {grpc.get(m, "x-trace") ?? "-"} keys {grpc.keys(m)} count {grpc.count(m)}")
    for h in grpc.to_headers(m) {
        print("header {h.name}={h.value}")
    }
    let reject = [
        "grpc-status"
        "grpc-custom"
        ":path"
        "content-type"
        "te"
        "host"
        "bad key"
        ""
        "UPPER_ok"
        "token-bin"
    ]
    for key in reject {
        var probe = grpc.Metadata {}
        grpc.add(mut probe, key, "v") catch {
            e => {
                print("add {key} rejected {e}")
                continue
            }
        }
        print("add {key} accepted")
    }
    var probe = grpc.Metadata {}
    grpc.add(mut probe, "x-a", " padded") catch {
        e => print("value rejected {e}")
    }
    grpc.add_bin(mut probe, "plain", [1]) catch {
        e => print("bin rejected {e}")
    }
    grpc.set(mut m, "x-trace", "three") or {}
    print("after set {grpc.values(m, "x-trace")}")
    grpc.remove(mut m, "X-Trace")
    print("after remove {grpc.keys(m)}")
    let wire = [
        header.Header { name: ":status", value: "200" }
        header.Header { name: "content-type", value: "application/grpc" }
        header.Header { name: "grpc-status", value: "0" }
        header.Header { name: "x-one", value: "1" }
        header.Header { name: "x-one", value: "2" }
        header.Header { name: "x-blob-bin", value: "AP8H,AP8H" }
        header.Header { name: "x-padded-bin", value: "AP8H" }
        header.Header { name: "x-broken-bin", value: "!!!" }
    ]
    let parsed = grpc.from_headers(wire)
    print("parsed keys {grpc.keys(parsed)} one={grpc.values(parsed, "x-one")} blob={grpc.values_bin(parsed, "x-blob-bin")} broken={grpc.values_bin(parsed, "x-broken-bin")}")
}

fn main() {
    timeouts()
    messages()
    statuses()
    framing()
    failures()
    compression()
    metadata()
}
