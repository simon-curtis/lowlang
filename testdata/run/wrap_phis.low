struct Box {
    a: i64
    b: *Box?
}

fn spin(seed: i64, n: i64) -> i64 {
    var x0 = f64(seed) * 0.5
    var x1 = 1.25
    var x2 = -3.5
    var x3 = 0.125
    var x4 = 2.0
    var x5 = 7.5
    var x6 = -0.75
    var x7 = 9.0
    var x8 = 1.0
    var x9 = 3.0
    var x10 = 4.0
    var x11 = 5.0
    var x12 = 6.0
    var x13 = 8.0
    var x14 = 10.0
    var x15 = 11.0
    var x16 = 12.0
    var i0 = seed
    var i1 = 3
    var i2 = 5
    var keep: *Box? = none
    var k = 0
    for k < n {
        let t = x0
        x0 = x1 + x16 * 0.0000001
        x1 = x2
        x2 = x3
        x3 = x4
        x4 = x5
        x5 = x6
        x6 = x7
        x7 = x8
        x8 = x9
        x9 = x10
        x10 = x11
        x11 = x12
        x12 = x13
        x13 = x14
        x14 = x15
        x15 = x16
        x16 = t + 0.5
        let ti = i0
        i0 = i1
        i1 = i2
        i2 = ti + k
        if k % 4096 == 0 {
            keep = new(Box { a: k, b: keep })
        }
        k += 1
    }
    var depth = 0
    var cur = keep
    for {
        match cur {
            some(b) => {
                depth += b.a % 7
                cur = b.b
            }
            none => break
        }
    }
    i64(x0 + x5 + x9 + x13 + x16 * 3.0) + i0 + i1 * 3 + i2 * 7 + depth
}

fn work(seed: i64, n: i64, out: chan[i64]) {
    out <- spin(seed, n)
}

fn churn(n: i64) -> i64 {
    var total = 0
    for i in 0..n {
        let b = new(Box { a: i, b: none })
        var xs: []i64 = []
        for j in 0..(i % 50) {
            push(mut xs, j)
        }
        total += b.a % 3 + xs.len
    }
    total
}

fn main() {
    let out = chan[i64](16)
    for s in 0..8 {
        spawn work(s, 3000000, out)
    }
    let c = churn(400000)
    var sum = 0
    for s in 0..8 {
        sum += (<-out) ?? 0
    }
    print(c)
    print(sum)
    var single = 0
    for s in 0..8 {
        single += spin(s, 3000000)
    }
    print(single)
}
