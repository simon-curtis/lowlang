import boxes

fn cell(size: f32) -> boxes.Box {
    boxes.empty().size(size, size)
}

fn label(pad: i64) -> str {
    "x".pad(pad)
}

fn closure_wins() -> boxes.Box {
    let size = fn(b: boxes.Box, w: f32, h: f32) -> boxes.Box { boxes.Box { w: w + 1.0, h: h + 1.0 } }
    boxes.empty().size(1.0, 2.0)
}

fn main() {
    let c = cell(4.0)
    print("{c.w} {c.h}")
    print(label(9))
    let d = closure_wins()
    print("{d.w} {d.h}")
}
