import std/io
import std/math
import std/ui
import std/ui/font
import std/ui/geometry
import std/ui/text

struct Table {
    tag: str
    data: []u8
}

fn u16s(values: []i64) -> []u8 {
    var b: []u8 = []
    for v in values {
        io.put_be16(mut b, v)
    }
    b
}

fn zeros(n: i64) -> []u8 {
    var b: []u8 = []
    for _ in 0..n {
        b.push(0)
    }
    b
}

fn assemble(tables: []Table) -> str {
    var out: []u8 = []
    io.put_be32(mut out, 65536)
    io.put_be16(mut out, tables.len)
    for _ in 0..6 {
        out.push(0)
    }
    var offset = 12 + 16 * tables.len
    for t in tables {
        for i in 0..4 {
            out.push(t.tag[i])
        }
        io.put_be32(mut out, 0)
        io.put_be32(mut out, offset)
        io.put_be32(mut out, t.data.len)
        offset += (t.data.len + 3) / 4 * 4
    }
    for t in tables {
        for b in t.data {
            out.push(b)
        }
        for _ in 0..(4 - t.data.len % 4) % 4 {
            out.push(0)
        }
    }
    str(out)
}

fn box(x0: i64, x1: i64, y1: i64) -> []u8 {
    var b = u16s([1, 0, 0, 0, 0, 3, 0])
    for _ in 0..4 {
        b.push(1)
    }
    for dx in [x0, x1 - x0, 0, x0 - x1] {
        io.put_be16(mut b, dx)
    }
    for dy in [0, 0, y1, 0] {
        io.put_be16(mut b, dy)
    }
    b
}

fn cmap4(segments: []i64) -> []u8 {
    let n = segments.len / 3 + 1
    var b = u16s([0, 1, 3, 1, 0, 12, 4, 16 + 8 * n, 0, 2 * n, 0, 0, 0])
    for i in 0..n - 1 {
        io.put_be16(mut b, segments[3 * i + 1])
    }
    io.put_be16(mut b, 65535)
    io.put_be16(mut b, 0)
    for i in 0..n - 1 {
        io.put_be16(mut b, segments[3 * i])
    }
    io.put_be16(mut b, 65535)
    for i in 0..n - 1 {
        io.put_be16(mut b, segments[3 * i + 2] - segments[3 * i])
    }
    io.put_be16(mut b, 1)
    for _ in 0..n {
        io.put_be16(mut b, 0)
    }
    b
}

fn name_table(family: str) -> []u8 {
    var b = u16s([0, 1, 18, 3, 1, 0x409, 1, 2 * family.len, 0])
    for i in 0..family.len {
        io.put_be16(mut b, i64(family[i]))
    }
    b
}

fn os2_table(weight: i64, italic: bool) -> []u8 {
    var b = zeros(78)
    io.set_be16(b, 4, weight)
    io.set_be16(b, 62, if italic { 1 } else { 0 })
    b
}

fn face(family: str, weight: i64, italic: bool, advance: i64) -> font.Font {
    var head = zeros(54)
    io.set_be16(head, 18, 1024)
    var hhea = zeros(36)
    io.set_be16(hhea, 4, 1024)
    io.set_be16(hhea, 6, -256)
    io.set_be16(hhea, 8, 128)
    io.set_be16(hhea, 34, 4)
    var maxp = zeros(6)
    io.set_be16(maxp, 4, 4)
    let hmtx = u16s([512, 0, 256, 0, advance, 0, 640, 0])
    let glyphs: [][]u8 = [[], [], box(64, advance - 64, 768), box(64, 576, 512)]
    var glyf: []u8 = []
    var loca: []u8 = []
    io.put_be16(mut loca, 0)
    for g in glyphs {
        for x in g {
            glyf.push(x)
        }
        io.put_be16(mut loca, glyf.len / 2)
    }
    var tables = [
        Table { tag: "head", data: head }
        Table { tag: "hhea", data: hhea }
        Table { tag: "maxp", data: maxp }
        Table { tag: "cmap", data: cmap4([32, 32, 1, 65, 65, 2, 99, 99, 3]) }
        Table { tag: "hmtx", data: hmtx }
        Table { tag: "loca", data: loca }
        Table { tag: "glyf", data: glyf }
    ]
    if family != "" {
        tables.push(Table { tag: "name", data: name_table(family) })
        tables.push(Table { tag: "OS/2", data: os2_table(weight, italic) })
    }
    font.parse(assemble(tables)) or font.Font {}
}

fn unbounded() -> f32 {
    f32(math.infinity())
}

fn show(label: str, l: text.Layout) {
    print("{label}: font {l.font}, {l.lines.len} lines, {l.width} x {l.height}, line {l.line_height} baseline {l.baseline}, truncated {l.truncated}")
    for line in l.lines {
        var xs = ""
        for g in line.glyphs {
            xs = "{xs} {g.glyph}@{g.x}#{g.at}"
        }
        print("  x {line.x} y {line.y} width {line.width}:{xs}")
    }
}

fn chosen(mut sys: text.System, t: text.Typeface) -> i64 {
    sys.wrap("A", text.Format { typeface: t }, unbounded()).font
}

fn sprites(label: str, cx: ui.Context, view: fn() -> ui.Element) {
    let sc = cx.frame(view, geometry.size(200.0, 100.0), 1.0)
    var parts: []str = []
    for s in sc.sprites {
        parts.push("{s.bounds.x},{s.bounds.y} {s.bounds.width}x{s.bounds.height}")
    }
    print("{label}: {parts}")
}

fn elements(fonts: []font.Font) {
    let cx = ui.headless(ui.rgb(0xffffff))
    sprites("go", cx, fn() ui.text("A"))
    ui.add_fonts(cx, fonts)
    sprites("alpha", cx, fn() ui.text("A").font_family("Alpha"))
    sprites("bold", cx, fn() ui.div().font_family("Alpha").font_weight(700).children() {
        ui.text("A")
    })
    sprites("italic", cx, fn() ui.text("A").font_family("Alpha").italic())
    sprites("tall", cx, fn() ui.text("A\nA").font_family("Alpha").line_height(30.0))
    sprites("center", cx, fn() ui.div().width(100.0).font_family("Alpha").text_center().children() {
        ui.text("A A\nA")
    })
    sprites("right", cx, fn() ui.text("A").width(100.0).font_family("Alpha").text_right())
    sprites("nowrap", cx, fn() ui.text("AA AA").width(30.0).font_family("Alpha").whitespace_nowrap())
    sprites("wrap", cx, fn() ui.text("AA AA").width(30.0).font_family("Alpha"))
    sprites("clamp", cx, fn() ui.text("AA\nAA\nAA").font_family("Alpha").line_clamp(2))
    sprites("truncate", cx, fn() ui.text("AAAAA").width(40.0).font_family("Alpha").truncate())
    sprites("truncate lines", cx, fn() ui.text("A\nA").width(40.0).font_family("Alpha").truncate())
    sprites("ellipsis", cx, fn() ui.text("AA AA").width(30.0).font_family("Alpha").text_ellipsis().line_clamp(1))
}

fn main() {
    let fonts = [face("Alpha", 400, false, 768), face("Alpha", 700, false, 896), face("Alpha", 400, true, 832), face("Beta", 300, false, 640), face("", 0, false, 768)]
    for f in fonts {
        let d = font.describe(f)
        print("described [{d.family}] {d.weight} {d.italic}")
    }
    var sys = text.system(fonts)
    print("default {chosen(mut sys, text.Typeface {})}")
    print("bold {chosen(mut sys, text.Typeface { family: "alpha", weight: 700 })}")
    print("semibold {chosen(mut sys, text.Typeface { family: "Alpha", weight: 600 })}")
    print("light {chosen(mut sys, text.Typeface { family: "Alpha", weight: 300 })}")
    print("medium {chosen(mut sys, text.Typeface { family: "Alpha", weight: 500 })}")
    print("italic {chosen(mut sys, text.Typeface { family: "Alpha", italic: true })}")
    print("bold italic {chosen(mut sys, text.Typeface { family: "Alpha", weight: 700, italic: true })}")
    print("beta black {chosen(mut sys, text.Typeface { family: "Beta", weight: 900 })}")
    print("missing {chosen(mut sys, text.Typeface { family: "Gamma" })}")
    print("generic {chosen(mut sys, text.Typeface { family: "monospace" })}")
    var plain = text.system([face("Alpha", 400, false, 768)])
    show("tall", plain.wrap("A\nA", text.Format { line_height: 30.0 }, unbounded()))
    show("short", plain.wrap("A", text.Format { line_height: 10.0 }, unbounded()))
    show("left", plain.wrap("A A", text.Format {}, 100.0))
    show("center", plain.wrap("A A\nA", text.Format { align: Center }, 100.0))
    show("right", plain.wrap("A A\nA", text.Format { align: Right }, 100.0))
    show("center unbounded", plain.wrap("A A\nA", text.Format { align: Center }, unbounded()))
    show("clamped", plain.wrap("A\nA\nA", text.Format { max_lines: 2 }, unbounded()))
    show("clamped ellipsis", plain.wrap("AA AA", text.Format { max_lines: 1, ellipsis: "c" }, 30.0))
    show("clamped fits", plain.wrap("A\nAA", text.Format { max_lines: 1, ellipsis: "c" }, 30.0))
    show("nowrap", plain.wrap("AA AA", text.Format { wrap: false }, 30.0))
    show("nowrap ellipsis", plain.wrap("AAAAA\nA", text.Format { wrap: false, ellipsis: "c" }, 40.0))
    show("ellipsis spaces", plain.wrap("A  AAA", text.Format { wrap: false, ellipsis: "c" }, 40.0))
    show("line breaks", plain.wrap("A\rA\r\nA AA", text.Format {}, unbounded()))
    show("cluster", plain.wrap("AÁA", text.Format {}, 20.0))
    show("hyphen", plain.wrap("AA-AA", text.Format {}, 34.0))
    show("trailing newline", plain.wrap("A\n", text.Format { max_lines: 1, ellipsis: "c" }, 30.0))
    show("trailing blanks", plain.wrap("A\n   ", text.Format { max_lines: 1, ellipsis: "c" }, 30.0))
    show("wrapped uncut", plain.wrap("AA AA", text.Format { ellipsis: "c" }, 10.0))
    show("cut cluster", plain.wrap("AÁA", text.Format { wrap: false, ellipsis: "c" }, 36.0))
    var keyed = text.system([face("Alpha", 400, false, 768)])
    let first = keyed.wrap("A", text.Format { ellipsis: "c|true" }, unbounded())
    let second = keyed.wrap("true|A", text.Format { ellipsis: "c" }, unbounded())
    print("keys {keyed.cached()}: {first.lines[0].glyphs.len} {second.lines[0].glyphs.len}")
    elements(fonts)
}
