fn kernel(seed: f64, n: i64) -> f64 {
    var a = seed
    var b = seed * 0.5
    var c = 1.0
    var d = 0.25
    var e = seed + 2.0
    var f = 0.0
    var g = 3.0
    var h = 1.5
    for i in 0..n {
        let t = a * 0.999 + b * 0.001
        b = c * 0.5 + d * 0.5
        c = d + e * 0.0001
        d = e * 0.75 + f * 0.25
        e = f + g * 0.0001
        f = g * 0.5 + h * 0.5
        g = h + 0.0001
        h = t
        a = t + 0.0001
    }
    a + b + c + d + e + f + g + h
}

fn kernel32(seed: f32, n: i64) -> f32 {
    var a = seed
    var b = seed * 0.5
    var c: f32 = 1.0
    var d: f32 = 0.25
    var e = seed + 2.0
    var f: f32 = 0.0
    var g: f32 = 3.0
    var h: f32 = 1.5
    for i in 0..n {
        let t = a * 0.999 + b * 0.001
        b = c * 0.5 + d * 0.5
        c = d + e * 0.0001
        d = e * 0.75 + f * 0.25
        e = f + g * 0.0001
        f = g * 0.5 + h * 0.5
        g = h + 0.0001
        h = t
        a = t + 0.0001
    }
    a + b + c + d + e + f + g + h
}

fn worker(seed: i64, n: i64, expected: f64, expected32: f32, out: chan[bool]) {
    let wide = kernel(f64(seed), n)
    let narrow = kernel32(f32(seed), n)
    out <- (wide == expected && narrow == expected32)
}

fn churn(rounds: i64, out: chan[i64]) {
    var kept: []i64 = []
    var total = 0
    for i in 0..rounds {
        var block: []i64 = []
        for j in 0..512 {
            push(mut block, i + j)
        }
        total += block.len
        if i % 16 == 0 {
            kept = block
        }
    }
    out <- total + kept.len
}

fn relay(input: chan[f64], output: chan[f64], scale: f64) {
    for v in input {
        let kept = v * scale
        let next = kernel(kept, 100)
        output <- kept + next * 0.0
    }
    close(output)
}

fn main() {
    let n = 6000000
    var expected: []f64 = []
    var expected32: []f32 = []
    for s in 0..4 {
        push(mut expected, kernel(f64(s), n))
        push(mut expected32, kernel32(f32(s), n))
    }

    let done = chan[bool](64)
    let churned = chan[i64]()
    spawn churn(20000, churned)
    for w in 0..32 {
        spawn worker(w % 4, n, expected[w % 4], expected32[w % 4], done)
    }
    var matches = 0
    for w in 0..32 {
        if (<-done) ?? false {
            matches += 1
        }
    }
    print(matches)
    print((<-churned) ?? 0)

    let input = chan[f64](4)
    let output = chan[f64](4)
    spawn relay(input, output, 0.5)
    var sum = 0.0
    for i in 0..200 {
        input <- f64(i)
        sum += (<-output) ?? 0.0
    }
    close(input)
    print(sum)
}
