import std/crypto/zk/pairing
import std/text

struct Counts {
    pass: i64
    bad: i64
}

fn padded(data: []u8, n: i64) -> []u8 {
    var out: []u8 = []
    for i in 0..n {
        push(mut out, if i < data.len { data[i] } else { 0 })
    }
    out
}

fn bytes_of(hex: str) -> []u8 {
    if hex == "." {
        return []
    }
    text.decode_hex(hex) or []
}

fn evm_add(g: *pairing.Group, a: []u8, b: []u8, checked: bool) -> []u8 ! pairing.Error {
    let p = if checked { pairing.decode_evm(g, a)? } else { pairing.decode_evm_unchecked(g, a)? }
    let q = if checked { pairing.decode_evm(g, b)? } else { pairing.decode_evm_unchecked(g, b)? }
    pairing.encode_evm(g, pairing.add(g, p, q))
}

fn evm_mul(g: *pairing.Group, a: []u8, scalar: []u8) -> []u8 ! pairing.Error {
    let p = pairing.decode_evm(g, a)?
    pairing.encode_evm(g, pairing.scalar_mul(g, p, scalar))
}

fn evm_msm(g: *pairing.Group, input: []u8, step: i64, size: i64) -> []u8 ! pairing.Error {
    if input.len == 0 || input.len % step != 0 {
        fail Length
    }
    var acc = pairing.identity(g)
    for i in 0..input.len / step {
        let base = i * step
        let p = pairing.decode_evm(g, input[base..base + size])?
        acc = pairing.add(g, acc, pairing.scalar_mul(g, p, input[base + size..base + step]))
    }
    pairing.encode_evm(g, acc)
}

fn evm_pair(c: *pairing.Curve, input: []u8, size1: i64, step: i64, allow_empty: bool) -> []u8 ! pairing.Error {
    if input.len % step != 0 || (input.len == 0 && !allow_empty) {
        fail Length
    }
    let one = pairing.g1(c)
    let two = pairing.g2(c)
    var ps: []pairing.Point = []
    var qs: []pairing.Point = []
    for i in 0..input.len / step {
        let base = i * step
        push(mut ps, pairing.decode_evm(one, input[base..base + size1])?)
        push(mut qs, pairing.decode_evm(two, input[base + size1..base + step])?)
    }
    var out: []u8 = []
    for _ in 0..31 {
        push(mut out, 0)
    }
    push(mut out, if pairing.pairing_check(c, ps, qs) { 1 } else { 0 })
    out
}

fn evm_map(g: *pairing.Group, input: []u8) -> []u8 ! pairing.Error {
    var u: []u8 = []
    for k in 0..g.degree {
        let part = input[k * 64..(k + 1) * 64]
        for i in 0..16 {
            if part[i] != 0 {
                fail Flags
            }
        }
    }
    if g.degree == 1 {
        u = input[16..64]
    } else {
        for b in input[64 + 16..128] {
            push(mut u, b)
        }
        for b in input[16..64] {
            push(mut u, b)
        }
    }
    let p = pairing.map_to_curve(g, u)?
    pairing.encode_evm(g, pairing.clear_cofactor(g, p))
}

fn run_case(bn: *pairing.Curve, bls: *pairing.Curve, op: str, input: []u8) -> []u8 ! pairing.Error {
    let b1 = pairing.g1(bn)
    let bls1 = pairing.g1(bls)
    let bls2 = pairing.g2(bls)
    match op {
        "bn_add" => {
            let data = padded(input, 128)
            evm_add(b1, data[..64], data[64..128], true)?
        }
        "bn_mul" => {
            let data = padded(input, 96)
            evm_mul(b1, data[..64], data[64..96])?
        }
        "bn_pair" => evm_pair(bn, input, 64, 192, true)?
        "g1_add" => {
            if input.len != 256 {
                fail Length
            }
            evm_add(bls1, input[..128], input[128..], false)?
        }
        "g1_mul" => {
            if input.len != 160 {
                fail Length
            }
            evm_mul(bls1, input[..128], input[128..])?
        }
        "g1_msm" => evm_msm(bls1, input, 160, 128)?
        "g2_add" => {
            if input.len != 512 {
                fail Length
            }
            evm_add(bls2, input[..256], input[256..], false)?
        }
        "g2_mul" => {
            if input.len != 288 {
                fail Length
            }
            evm_mul(bls2, input[..256], input[256..])?
        }
        "g2_msm" => evm_msm(bls2, input, 288, 256)?
        "bls_pair" => evm_pair(bls, input, 128, 384, false)?
        "map_g1" => {
            if input.len != 64 {
                fail Length
            }
            evm_map(bls1, input)?
        }
        "map_g2" => {
            if input.len != 128 {
                fail Length
            }
            evm_map(bls2, input)?
        }
        _ => fail Length
    }
}

fn check_file(bn: *pairing.Curve, bls: *pairing.Curve, data: str, counts: *Counts) {
    for line in text.lines(data) {
        let parts = text.split(line, ' ')
        if parts.len != 4 {
            continue
        }
        let op = parts[0]
        let input = bytes_of(parts[2])
        let want = parts[3]
        let got = run_case(bn, bls, op, input) catch {
            _ => []
        }
        var text_got = "-"
        if got.len > 0 {
            text_got = text.encode_hex(got)
        }
        if text_got == want {
            counts.pass += 1
        } else {
            counts.bad += 1
            print("FAIL {op} {parts[1]}")
        }
    }
}

fn main() {
    let bn = pairing.bn254()
    let bls = pairing.bls12_381()
    let counts = new(Counts { pass: 0, bad: 0 })
    check_file(bn, bls, embed("std_zk_pairing_evm_bn.txt"), counts)
    check_file(bn, bls, embed("std_zk_pairing_evm_bls.txt"), counts)
    print("pass {counts.pass} bad {counts.bad}")
}
