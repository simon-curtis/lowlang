pub struct Safe {
    pub label: str
    combination: i64
    opened: bool
}

pub struct Box[T] {
    contents: T
}

pub enum Lock {
    Open
    Closed(attempts: i64)
}

pub fn safe(label: str) -> Safe {
    Safe { label, combination: 1234, opened: false }
}

pub fn boxed[T](contents: T) -> Box[T] {
    Box { contents }
}
