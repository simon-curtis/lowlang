import std/serde
import std/xml

enum Shape {
    Circle(radius: f64)
    Rect(f64, f64)
    Empty
}

struct Address {
    street: str
    zip: u16
}

struct Person {
    id: i64
    name: str
    tags: []str
    address: Address?
    shape: Shape
    others: []Shape
    scores: [str: i64]
    avatar: []u8
    ratio: f64
    big: u64
    active: bool
    nick: str?
    level: i32 = 1
}

struct Order {
    id: i64
    status: str
    lines: []Line
    note: str?
    codes: []i64
}

struct Line {
    sku: str
    qty: i64
    price: f64
}

fn show(n: xml.Name) -> str {
    if n.namespace == "" { xml.qualified(n) } else { "{xml.qualified(n)}[{n.namespace}]" }
}

fn token_line(r: *xml.Reader, t: xml.Token) -> str {
    let p = xml.position(r)
    let at = "{p.line}:{p.column}"
    match t {
        StartElement(name, attributes, empty) => {
            var line = "{at} start {show(name)}"
            for a in attributes {
                line = "{line} {show(a.name)}=\"{a.value}\""
            }
            if empty { "{line} (empty)" } else { line }
        }
        EndElement(name) => "{at} end {show(name)}"
        Text(v) => "{at} text \"{v}\""
        CData(v) => "{at} cdata \"{v}\""
        Comment(v) => "{at} comment \"{v}\""
        Instruction(target, d) => "{at} pi {target} \"{d}\""
        Doctype(v) => "{at} doctype \"{v}\""
        End => "{at} end of document"
    }
}

fn dump(data: []u8) {
    let r = xml.reader(data)
    for {
        let t = xml.next(r) catch {
            Malformed(line, column, message) => {
                print("malformed {line}:{column} {message}")
                return
            }
            Limit(line, column, message) => {
                print("limit {line}:{column} {message}")
                return
            }
            Unsupported(message) => {
                print("unsupported {message}")
                return
            }
        }
        print(token_line(r, t))
        match t {
            End => return
            _ => {}
        }
    }
}

fn check(name: str, data: str) {
    check_bytes(name, bytes(data))
}

fn check_bytes(name: str, data: []u8) {
    let outcome = xml.parse(data) catch {
        Malformed(line, column, message) => {
            print("{name}: {line}:{column} {message}")
            return
        }
        Limit(line, column, message) => {
            print("{name}: limit {line}:{column} {message}")
            return
        }
        Unsupported(message) => {
            print("{name}: unsupported {message}")
            return
        }
    }
    print("{name}: accepted <{outcome.name.local}>")
}

fn declared(label: str, content: []u8) -> []u8 {
    var out = bytes("<?xml version='1.0' encoding='{label}'?><a>")
    for b in content {
        push(mut out, b)
    }
    for c in "</a>" {
        push(mut out, u8(c))
    }
    out
}

fn utf16le(s: str) -> []u8 {
    var out: []u8 = [0xFF, 0xFE]
    for c in s {
        if c >= 0x10000 {
            let v = c - 0x10000
            let high = 0xD800 + (v >> 10)
            let low = 0xDC00 + (v & 0x3FF)
            push(mut out, u8(high & 0xFF))
            push(mut out, u8(high >> 8))
            push(mut out, u8(low & 0xFF))
            push(mut out, u8(low >> 8))
        } else {
            push(mut out, u8(c & 0xFF))
            push(mut out, u8(c >> 8))
        }
    }
    out
}

fn read_person(s: str) -> Person ! serde.Error {
    xml.deserialize[Person](bytes(s))
}

fn read_order(s: str) -> Order ! serde.Error {
    xml.deserialize[Order](bytes(s))
}

fn order_outcome(s: str) -> str {
    let o = read_order(s) catch {
        Syntax(at, message) => return "syntax {message}"
        Mismatch(expected, at) => return "expected {expected}"
        Missing(field) => return "missing {field}"
        UnknownVariant(name) => return "unknown variant {name}"
        Range(at) => return "out of range"
        TooDeep => return "too deep"
    }
    "order {o.id}"
}

fn reader_section() {
    print("-- reader")
    dump(bytes("<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!DOCTYPE doc [\n  <!ENTITY sig \"<b>Ada &amp; co</b>\">\n  <!ATTLIST doc version CDATA \"2\" ids NMTOKENS #IMPLIED>\n]>\n<doc xmlns=\"urn:doc\" xmlns:m=\"urn:meta\" m:id=\"7\" ids=\"  a   b \" note=\"tab\there&#10;nl\">\n  <m:title xml:lang=\"en\">Café &lt;中&#x4E2D;&gt;</m:title>\n  <body>&sig;!<![CDATA[<raw> & ]]><!-- note --><?render fast?></body>\n  <empty/>\n</doc>\n<!-- after -->\n"))
    print("-- utf-16 and line endings")
    dump(utf16le("<a x='é'>\r\n😀\r</a>"))
    dump(bytes("<a>one\r\ntwo\rthree</a>"))
    print("-- declared encodings")
    dump(declared("latin1", [0xE9, 0xFF]))
    dump(declared("ISO-8859-1", [0xA3, 0xE9]))
    dump(declared("windows-1252", [0x80, 0xE9]))
    dump(declared("KOI8-R", [0xC1]))
    dump(declared("US-ASCII", [0x41]))
    dump(declared("UTF-16", [0x41]))
}

fn malformed_section() {
    print("-- malformed")
    check("mismatch", "<root>\n  <a>\n  </b>\n</root>")
    check("unclosed", "<root>\n  <a>\n</root>")
    check("eof", "<root>\n  <a>")
    check("two roots", "<a/>\n<b/>")
    check("no root", "<!-- only -->")
    check("text after", "<a/>\ntext")
    check("duplicate", "<a x='1'\n   x='2'/>")
    check("duplicate expanded", "<a xmlns:p='urn:u' xmlns:q='urn:u' p:x='1' q:x='2'/>")
    check("undeclared prefix", "<a>\n  <p:b/>\n</a>")
    check("xml prefix rebound", "<a xmlns:xml='urn:x'/>")
    check("empty prefix binding", "<a xmlns:p=''/>")
    check("lt in attribute", "<a v='a<b'/>")
    check("bare ampersand", "<a>fish & chips</a>")
    check("undeclared entity", "<a>&nbsp;</a>")
    check("bad character reference", "<a>&#xD800;</a>")
    check_bytes("control character", [0x3C, 0x61, 0x3E, 0x01, 0x3C, 0x2F, 0x61, 0x3E])
    check_bytes("invalid utf-8", [0x3C, 0x61, 0x3E, 0xC3, 0x28, 0x3C, 0x2F, 0x61, 0x3E])
    check("double hyphen", "<a><!-- x -- y --></a>")
    check("cdata end in text", "<a>x ]]> y</a>")
    check("reserved pi", "<a><?xml version='1.0'?></a>")
    check("late declaration", " <?xml version='1.0'?><a/>")
    check("bad version", "<?xml version='2.0'?><a/>")
    check("encoding", "<?xml version='1.0' encoding='EBCDIC'?><a/>")
    check("name", "<1a/>")
    check("recursive entity", "<!DOCTYPE a [<!ENTITY x '&y;'><!ENTITY y '&x;'>]><a>&x;</a>")
    check("unbalanced entity", "<!DOCTYPE a [<!ENTITY x '<b>'>]><a>&x;</b></a>")
    check("lt through entity", "<!DOCTYPE a [<!ENTITY x '&#60;'>]><a v='&x;'/>")
    var laughs = "<!DOCTYPE l [<!ENTITY a 'hahahahahahahahahahahahahahahahahahahaha'>"
    let letters = "abcdefghij"
    for i in 1..9 {
        let previous = letters[i - 1..i]
        let current = letters[i..i + 1]
        var body = ""
        for _ in 0..10 {
            body = "{body}&{previous};"
        }
        laughs = "{laughs}<!ENTITY {current} '{body}'>"
    }
    check("billion laughs", "{laughs}]><l>&i;</l>")
    var bad16 = utf16le("<a/>")
    push(mut bad16, 0x41)
    check_bytes("odd utf-16", bad16)
    check("external entity is skipped", "<!DOCTYPE a [<!ENTITY e SYSTEM 'file:///etc/passwd'>]><a>&e;</a>")
}

fn dom_section() ! xml.Error {
    print("-- dom")
    let doc = xml.parse(bytes("<shop xmlns='urn:shop' xmlns:x='urn:x'><name>Corner &amp; Co</name><items><item sku='a1' x:hot='yes'>Apple</item><item sku='b2'>Bread<!-- fresh --></item><item sku='c3'><![CDATA[<Cheese>]]></item></items><info>mixed <b>bold</b> text</info></shop>"))?
    print(xml.attribute(doc, "xmlns") ?? "no attribute")
    print(xml.text(xml.child(doc, "name") ?? doc))
    let items = xml.children(xml.child(doc, "items") ?? doc, "item")
    for item in items {
        print("{xml.attribute(item, "sku") ?? "?"} {xml.attribute(item, "hot") ?? "-"} {xml.text(item)}")
    }
    match xml.find(doc, "items/item") {
        some(e) => print("find {xml.text(e)} in {e.name.namespace}")
        none => print("find failed")
    }
    print(xml.find(doc, "items/missing") == none)
    print(xml.text(xml.child(doc, "info") ?? doc))
    let compact = xml.serialize(doc, false)
    print(compact)
    print(xml.serialize(doc, true))
    let again = xml.parse(bytes(compact))?
    print(xml.serialize(again, false) == compact)
}

fn writer_section() {
    print("-- writer")
    let w = xml.writer(true)
    xml.write_declaration(w)
    xml.write_comment(w, "generated -- by test-")
    xml.start_element(w, "feed")
    xml.write_namespace(w, "", "http://www.w3.org/2005/Atom")
    xml.write_namespace(w, "m", "urn:media")
    xml.write_attribute(w, "title", "Q&A \"live\" <now>\n\tnext")
    xml.start_element(w, "entry")
    xml.start_element(w, "m:thumb")
    xml.write_attribute(w, "url", "a.png")
    xml.end_element(w)
    xml.start_element(w, "summary")
    xml.write_text(w, "1 < 2 && 3 > 2 ]]>")
    xml.end_element(w)
    xml.start_element(w, "content")
    xml.write_cdata(w, "x]]>y")
    xml.end_element(w)
    xml.write_instruction(w, "page", "break ?> here")
    xml.end_element(w)
    let out = xml.finish(w)
    print(out)
    let doc = xml.parse(bytes(out)) catch {
        _ => {
            print("writer output rejected")
            return
        }
    }
    print(xml.attribute(doc, "title") ?? "")
    print(xml.text(xml.find(doc, "entry/summary") ?? doc))
    print(xml.text(xml.find(doc, "entry/content") ?? doc))
}

fn binding_section() ! serde.Error {
    print("-- binding")
    let p = Person {
        id: -42, name: "Ada <Lovelace> & co", tags: ["math", "engines"]
        address: Address { street: "St James's Square", zip: 12345 }
        shape: Rect(1.5, 2.0), others: [Circle(0.25), Empty]
        scores: ["first": 1, "second": -2], avatar: bytes("png\0data")
        ratio: -1.0 / 0.0, big: 18446744073709551615, active: true, nick: none
    }
    let s = xml.serialize_value("person", p)
    print(s)
    let back = read_person(s)?
    print(xml.serialize_value("person", back) == s)
    print("{back.name} {back.tags.len} {back.scores["second"] ?? 0} {back.big} {back.level} {back.nick == none}")
    match back.shape {
        Rect(w, h) => print("rect {w} {h}")
        _ => print("wrong shape")
    }
    let order = read_order("<order id=' 17 ' status='paid' codes='3 1  4'><lines><sku>a</sku><qty>2</qty><price>1.25</price></lines><lines sku='b' qty='1'><price>1e3</price></lines><note xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance' xsi:nil='true'/></order>")?
    print("{order.id} {order.status} {order.lines.len} {order.lines[1].sku} {order.lines[1].price} {order.codes.len} {order.codes[2]} {order.note == none}")
    print(order_outcome("<order><id>1</id></order>"))
    print(order_outcome("<order><id>x</id><status/><lines/><codes/></order>"))
    print(order_outcome("<order><id>99999999999999999999</id></order>"))
    print(order_outcome("<order><id>1</order>"))
    print(order_outcome("<order><id>5</id><status/><codes/></order>"))
    print(order_outcome("<order><id>5</id><status/></order>"))
    let list = xml.serialize_value("numbers", [3, 1, 4])
    print(list)
    let numbers = xml.deserialize[[]i64](bytes(list))?
    print(numbers.len)
    print(xml.serialize_value("flag", true))
    print(xml.deserialize[bool](bytes("<flag> 1 </flag>"))?)
}

fn main() {
    reader_section()
    malformed_section()
    dom_section() catch {
        _ => print("dom section failed")
    }
    writer_section()
    binding_section() catch {
        _ => print("binding section failed")
    }
}
