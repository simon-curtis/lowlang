struct Job {
    id: i64
    names: []str
}

fn worker(job: Job, done: chan[str]) {
    var churn: [][]i64 = []
    for i in 0..2000 {
        push(mut churn, [i, i + 1, i + 2])
    }
    done <- "{job.id}:{job.names.len}:{churn.len}"
}

fn launch(first: chan[str], second: chan[str]) -> i64 {
    region {
        var names: []str = []
        for i in 0..5 {
            push(mut names, "name{i}")
        }
        let job = Job { id: 42, names }
        spawn worker(job, first)
        spawn worker(Job { id: 43, names: ["x"] }, second)
        names.len
    }
}

fn main() {
    let first = chan[str](1)
    let second = chan[str](1)
    print(launch(first, second))
    var churn: [][]i64 = []
    for i in 0..20000 {
        push(mut churn, [i])
    }
    print((<-first) ?? "none")
    print((<-second) ?? "none")
}
