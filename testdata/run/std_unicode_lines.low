import std/text
import std/unicode

fn code(token: str) -> u32 {
    u32(text.parse_uint(token, 16) or 0)
}

fn ends_hard_line(c: u32) -> bool {
    c == 0x0A || c == 0x0B || c == 0x0C || c == 0x0D || c == 0x85 || c == 0x2028 || c == 0x2029
}

fn check(line: str) -> bool {
    var whole: []u8 = []
    var expected: []i64 = []
    var hard: []bool = []
    var last: u32 = 0
    for token in text.fields(line) {
        if token == "÷" {
            push(mut expected, whole.len)
            push(mut hard, ends_hard_line(last))
        } else if token != "×" {
            last = code(token)
            text.append_char(mut whole, last)
        }
    }
    push(mut expected, whole.len)
    push(mut hard, true)
    let input = str(whole)
    let got = unicode.line_breaks(input)
    if got.len != expected.len {
        return false
    }
    var previous = 0
    let pieces = unicode.line_segments(input)
    if pieces.len != got.len {
        return false
    }
    for i, b in got {
        if b.at != expected[i] || b.mandatory != hard[i] || pieces[i] != input[previous..b.at] {
            return false
        }
        previous = b.at
    }
    true
}

fn build(cs: []u32) -> str {
    var out: []u8 = []
    for c in cs {
        text.append_char(mut out, c)
    }
    str(out)
}

fn show(s: str) {
    var parts: []str = []
    for b in unicode.line_breaks(s) {
        let mark = if b.mandatory { "!" } else { "/" }
        push(mut parts, "{b.at}{mark}")
    }
    print("{text.join(unicode.line_segments(s), "|")} {text.join(parts, " ")}")
}

fn main() {
    var total = 0
    var failed = 0
    for line in text.lines(embed("std_unicode_lines.txt")) {
        if line == "" {
            continue
        }
        total += 1
        if !check(line) {
            failed += 1
            print("failed: {line}")
        }
    }
    print("cases {total} failed {failed}")

    show("")
    show("hello")
    show("hello world")
    show("one two  three")
    show("a\nb\r\nc\rd")
    show("well-known state-of-the-art")
    show("cost $12.50, or (maybe) 3,000 units")
    show("日本語のテキスト")
    show(build(['a', 0x200B, 'b', ' ', 'c']))
    show(build(['n', 'o', 0xA0, 'b', 'r', 'e', 'a', 'k', ' ', 'h', 'e', 'r', 'e']))
    show(build([0x1F1EF, 0x1F1F5, 0x1F1FA, 0x1F1F8, 0x1F1EB]))
    show(build([0x1F468, 0x200D, 0x1F469, ' ', 'x']))
    show("end.\n")
}
