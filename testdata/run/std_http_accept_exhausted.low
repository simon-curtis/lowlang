import std/http
import std/io
import std/net
import std/sys

fn handle(req: http.Request) -> http.Response {
    http.response(200, "served")
}

fn serve(l: net.ListenerHandle, ended: chan[bool]) {
    http.serve_on(l, handle) or {}
    ended <- true
}

fn main() ! io.Error {
    let descriptors = 7
    sys.set_rlimit(descriptors, sys.Rlimit { soft: 64, hard: 64 })?
    using l = net.listen("127.0.0.1", 0)?
    let ended = chan[bool](1)
    spawn serve(l.handle, ended)
    sleep(50)
    var held: sys.FdHandle[] = []
    for {
        let f = sys.open("/dev/null", Read, 0) or break
        held.push(f)
    }
    for _ in 0..2 {
        sys.close_on(held.pop() ?? panic("no descriptors were taken"))
    }
    using c = net.connect(l.handle.addr)?
    net.set_read_timeout(c, 3000)
    net.write_all(c, bytes("GET / HTTP/1.1\r\nconnection: close\r\n\r\n"))?
    sleep(200)
    let stopped = select {
        <-ended => true
        else => false
    }
    print("serve returned while descriptors ran out: {stopped}")
    for f in held {
        sys.close_on(f)
    }
    let all = io.read_all(net.stream(c)) or []
    print("answered once descriptors were free: {str(all).len > 0}")
}
