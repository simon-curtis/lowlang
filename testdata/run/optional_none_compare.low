struct Row {
    cells: i64[]
    label: str
}

struct Pair {
    a: i64
    b: i64
}

fn absent_slice(xs: i64[]?) -> bool {
    xs == none
}

fn present_slice(xs: i64[]?) -> bool {
    xs != none
}

fn absent_map(m: [str: i64]?) -> bool {
    m == none
}

fn absent_row(r: Row?) -> bool {
    r == none
}

fn absent_pair(p: Pair?) -> bool {
    p == none
}

fn absent_number(n: i64?) -> bool {
    n == none
}

fn absent_text(s: str?) -> bool {
    s == none
}

fn main() {
    let empty: i64[] = []
    print(absent_slice(none))
    print(absent_slice(empty))
    print(absent_slice([1, 2, 3]))
    print(present_slice(none))
    print(present_slice(empty))
    print(absent_map(none))
    print(absent_map(["a": 1]))
    print(absent_row(none))
    print(absent_row(Row { cells: [1], label: "x" }))
    print(absent_pair(none))
    print(absent_pair(Pair { a: 1, b: 2 }))
    print(absent_number(none))
    print(absent_number(0))
    print(absent_text(none))
    print(absent_text(""))
    var xs: i64[]? = none
    if xs == none {
        xs = [4, 5]
    }
    if xs != none {
        print("assigned")
    }
}
