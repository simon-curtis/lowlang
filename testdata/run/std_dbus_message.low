import std/dbus
import std/io
import std/text

fn field(code: i64, v: dbus.Value) -> dbus.Value {
    dbus.Value.Struct([dbus.Value.Byte(u8(code)), dbus.variant(v)])
}

fn build(kind: i64, serial: i64, fields: []dbus.Value) -> []u8 {
    let header = dbus.encode([
        dbus.Value.Byte('l'),
        dbus.Value.Byte(u8(kind)),
        dbus.Value.Byte(0),
        dbus.Value.Byte(1),
        dbus.Value.UInt32(0),
        dbus.Value.UInt32(u32(serial)),
        dbus.Value.Array("(yv)", fields),
    ], dbus.ByteOrder.Little) or panic("header")
    var out = header.data
    for out.len % 8 != 0 {
        push(mut out, 0)
    }
    out
}

fn call_fields() -> []dbus.Value {
    [
        field(1, dbus.Value.ObjectPath("/a")),
        field(3, dbus.Value.String("Ping")),
    ]
}

fn extended(fields: []dbus.Value, more: dbus.Value) -> []dbus.Value {
    var out = fields
    push(mut out, more)
    out
}

fn decode_result(data: []u8, fds: []i64) -> str {
    let m = dbus.decode_message(data, fds) catch {
        e => return "{e}"
    }
    "{m.kind} serial {m.serial} path {text.quote(m.path)} member {text.quote(m.member)} body {m.body.len} fds {m.fds}"
}

fn encode_result(m: dbus.Message) -> str {
    let e = dbus.encode_message(m, dbus.ByteOrder.Little) catch {
        err => return "{err}"
    }
    "ok {e.data.len} bytes {e.fds}"
}

fn length_result(prefix: []u8) -> str {
    let n = dbus.message_length(prefix) catch {
        e => return "{e}"
    }
    "{n}"
}

struct Prefix {
    name: str
    hex: str
}

fn prefix(hex: str) -> []u8 {
    text.decode_hex(hex) or panic("hex")
}

fn with_trailing_byte(data: []u8) -> []u8 {
    var out = io.buffer(0)
    io.append(mut out, data)
    push(mut out, 0)
    out
}

fn with_byte(data: []u8, at: i64, v: u8) -> []u8 {
    var out = io.buffer(data.len)
    io.copy(out, data)
    out[at] = v
    out
}

fn call(serial: i64) -> dbus.Message {
    var m = dbus.method_call("org.example.Svc", "/org/example/Obj", "org.example.Iface", "Ping", [dbus.Value.Int32(1)])
    m.serial = serial
    m
}

fn main() {
    print("constants")
    print("  {dbus.no_reply_expected} {dbus.no_auto_start} {dbus.allow_interactive_authorization}")
    print("  {dbus.MessageType.MethodCall.index} {dbus.MessageType.MethodReturn.index} {dbus.MessageType.ErrorReply.index} {dbus.MessageType.Signal.index}")

    print("constructors")
    let c = call(9)
    print("  {c}")
    var incoming = call(12)
    incoming.sender = ":1.7"
    print("  {dbus.signal("/a", "org.example.I", "Changed", [dbus.Value.String("x")])}")
    print("  {dbus.method_return(incoming, [dbus.Value.Int32(2)])}")
    print("  {dbus.error_reply(incoming, "org.example.Failed", "broke")}")
    print("  {dbus.error_reply(incoming, "org.example.Failed", "")}")
    print("  {dbus.remote_error(dbus.error_reply(incoming, "org.example.Failed", "broke"))}")
    print("  {dbus.remote_error(dbus.error_reply(incoming, "org.example.Failed", ""))}")
    var odd = dbus.error_reply(incoming, "org.example.Failed", "")
    odd.body = [dbus.Value.Int32(4)]
    print("  {dbus.remote_error(odd)}")

    print("encode_message")
    print("  {encode_result(call(5))}")
    print("  serial 0: {encode_result(call(0))}")
    var no_path = call(5)
    no_path.path = ""
    print("  no path: {encode_result(no_path)}")
    var no_member = call(5)
    no_member.member = ""
    print("  no member: {encode_result(no_member)}")
    var no_interface = call(5)
    no_interface.interface = ""
    print("  no interface: {encode_result(no_interface)}")
    var bad_path = call(5)
    bad_path.path = "a"
    print("  bad path: {encode_result(bad_path)}")
    var bad_interface = call(5)
    bad_interface.interface = "a"
    print("  bad interface: {encode_result(bad_interface)}")
    var bad_member = call(5)
    bad_member.member = "a.b"
    print("  bad member: {encode_result(bad_member)}")
    var bad_destination = call(5)
    bad_destination.destination = "nodots"
    print("  bad destination: {encode_result(bad_destination)}")
    var bad_sender = call(5)
    bad_sender.sender = "nodots"
    print("  bad sender: {encode_result(bad_sender)}")
    var bad_body = call(5)
    bad_body.body = [dbus.Value.Int16(40000)]
    print("  bad body: {encode_result(bad_body)}")
    var flags = call(5)
    flags.flags = dbus.no_reply_expected | dbus.no_auto_start
    print("  flags: {encode_result(flags)}")
    var emitted = dbus.signal("/a", "org.example.I", "Changed", [])
    emitted.serial = 3
    print("  signal: {encode_result(emitted)}")
    var no_signal_interface = dbus.signal("/a", "", "Changed", [])
    no_signal_interface.serial = 3
    print("  signal without interface: {encode_result(no_signal_interface)}")
    var no_reply_serial = dbus.method_return(incoming, [])
    no_reply_serial.serial = 3
    no_reply_serial.reply_serial = 0
    print("  return without reply serial: {encode_result(no_reply_serial)}")
    var no_error_name = dbus.error_reply(incoming, "", "")
    no_error_name.serial = 3
    print("  error without a name: {encode_result(no_error_name)}")
    var bad_error_name = dbus.error_reply(incoming, "Failed", "")
    bad_error_name.serial = 3
    print("  error with a bad name: {encode_result(bad_error_name)}")
    var with_fds = call(5)
    with_fds.body = [dbus.Value.UnixFd(21), dbus.Value.UnixFd(22)]
    with_fds.fds = [99]
    print("  fds: {encode_result(with_fds)}")

    print("message_length")
    let prefixes = [
        Prefix { name: "no fields, no body", hex: "6c010001000000000100000000000000" },
        Prefix { name: "little endian, 14 field bytes and 16 body bytes", hex: "6c01000110000000010000000e000000" },
        Prefix { name: "big endian, 14 field bytes and 16 body bytes", hex: "4201000100000010000000010000000e" },
        Prefix { name: "fields of exactly 64 MiB", hex: "6c010001000000000100000000000004" },
        Prefix { name: "fields over 64 MiB", hex: "6c010001000000000100000001000004" },
        Prefix { name: "message of exactly 128 MiB", hex: "6c010001f0ffff070100000000000000" },
        Prefix { name: "message over 128 MiB", hex: "6c010001f1ffff070100000000000000" },
        Prefix { name: "bad byte order mark", hex: "78010001000000000100000000000000" },
        Prefix { name: "protocol version 2", hex: "6c010002000000000100000000000000" },
        Prefix { name: "protocol version 0", hex: "6c010000000000000100000000000000" },
        Prefix { name: "short prefix", hex: "6c0100010000000001000000" },
        Prefix { name: "empty prefix", hex: "" },
    ]
    for p in prefixes {
        print("  {p.name}: {length_result(prefix(p.hex))}")
    }

    print("decode_message")
    let good = build(1, 5, call_fields())
    print("  {decode_result(good, [])}")
    print("  {length_result(good)}")
    print("  trailing byte: {decode_result(with_trailing_byte(good), [])}")
    print("  truncated: {decode_result(good[..good.len - 1], [])}")
    print("  type 0: {decode_result(with_byte(good, 1, 0), [])}")
    print("  type 5: {decode_result(with_byte(good, 1, 5), [])}")
    print("  version 2: {decode_result(with_byte(good, 3, 2), [])}")
    print("  marker x: {decode_result(with_byte(good, 0, 'x'), [])}")
    print("  serial 0: {decode_result(build(1, 0, call_fields()), [])}")
    print("  unannounced fds: {decode_result(good, [4])}")
    print("  unknown field: {decode_result(build(1, 5, extended(call_fields(), field(77, dbus.Value.String("x")))), [])}")
    print("  duplicate field: {decode_result(build(1, 5, extended(call_fields(), field(3, dbus.Value.String("Pong")))), [])}")
    print("  field of the wrong type: {decode_result(build(1, 5, [field(1, dbus.Value.String("/a")), field(3, dbus.Value.String("Ping"))]), [])}")
    print("  call without a member: {decode_result(build(1, 5, [field(1, dbus.Value.ObjectPath("/a"))]), [])}")
    print("  call without a path: {decode_result(build(1, 5, [field(3, dbus.Value.String("Ping"))]), [])}")
    print("  invalid member: {decode_result(build(1, 5, [field(1, dbus.Value.ObjectPath("/a")), field(3, dbus.Value.String("a.b"))]), [])}")
    print("  invalid interface: {decode_result(build(1, 5, extended(call_fields(), field(2, dbus.Value.String("a")))), [])}")
    print("  return without reply serial: {decode_result(build(2, 5, []), [])}")
    print("  return: {decode_result(build(2, 5, [field(5, dbus.Value.UInt32(4))]), [])}")
    print("  error without a name: {decode_result(build(3, 5, [field(5, dbus.Value.UInt32(4))]), [])}")
    print("  error: {decode_result(build(3, 5, [field(5, dbus.Value.UInt32(4)), field(4, dbus.Value.String("org.example.Failed"))]), [])}")
    print("  signal without an interface: {decode_result(build(4, 5, [field(1, dbus.Value.ObjectPath("/a")), field(3, dbus.Value.String("Changed"))]), [])}")
    print("  signature field with a body missing: {decode_result(build(1, 5, extended(call_fields(), field(8, dbus.Value.Signature("i")))), [])}")
    print("  declared fd count mismatch: {decode_result(build(1, 5, extended(call_fields(), field(9, dbus.Value.UInt32(2)))), [4])}")
    print("  declared fd count: {decode_result(build(1, 5, extended(call_fields(), field(9, dbus.Value.UInt32(1)))), [4])}")
    print("  non-zero header padding: {decode_result(with_byte(good, good.len - 1, 1), [])}")

    print("message_fd_count")
    let sent = dbus.encode_message(with_fds, dbus.ByteOrder.Big) or panic("fds")
    print("  {dbus.message_fd_count(sent.data) or -1}")
    let plain = dbus.encode_message(call(5), dbus.ByteOrder.Little) or panic("plain")
    print("  {dbus.message_fd_count(plain.data) or -1}")
    print("  {dbus.message_fd_count(plain.data[..plain.data.len - 1]) or -1}")
    print("  {dbus.message_fd_count([]) or -1}")

    print("round trip with fds")
    let echoed = dbus.decode_message(sent.data, [31, 32]) or panic("echo")
    print("  {echoed.body} {echoed.fds}")
}
