import std/text

fn show_cut(c: text.Cut) {
    print("{c.found} [{c.before}] [{c.after}]")
}

fn show_unquote(s: str) {
    let out = text.unquote(s) catch {
        NotQuoted => return print("not quoted")
        BadEscape(at) => return print("bad escape at {at}")
        BadCodePoint(at) => return print("bad code point at {at}")
    }
    print("[{out}] {out.len}")
}

fn show_option(s: str?) {
    match s {
        some(v) => print("some [{v}]")
        none => print("none")
    }
}

fn main() {
    show_cut(text.cut("key=value=more", "="))
    show_cut(text.cut("novalue", "="))
    show_cut(text.cut("a::b", "::"))
    show_cut(text.cut("trailing=", "="))
    show_cut(text.last_cut("key=value=more", "="))
    show_cut(text.last_cut("a/b/c.txt", "/"))
    show_cut(text.last_cut("none", "/"))

    show_option(text.strip_prefix("v1.2", "v"))
    show_option(text.strip_prefix("1.2", "v"))
    show_option(text.strip_prefix("abc", "abc"))
    show_option(text.strip_suffix("main.low", ".low"))
    show_option(text.strip_suffix("main.low", ".go"))

    print(text.split_n("a,b,c,d", ",", 2) |> text.join("|"))
    print(text.split_n("a,b,c,d", ",", -1) |> text.join("|"))
    print(text.split_n("a,b,c,d", ",", 1) |> text.join("|"))
    print(text.split_n("a,b,c,d", ",", 0).len)
    print(text.split_n("a,b,c,d", ",", 10) |> text.join("|"))
    print(text.split_n("a::b::c", "::", 2) |> text.join("|"))
    print(text.split_n("héllo", "", 3) |> text.join("|"))

    print(text.title("hello wORLD of low-lang's std"))
    print(text.title("  ünï cöde 3rd"))

    print(text.quote("plain"))
    print(text.quote("tab\there \"q\" back\\slash\nnew"))
    print(text.quote("héllo 😀"))
    print(text.quote(str([u8(0x41), 0xFF, 0x7F, 0x01])))
    show_unquote("\"plain\"")
    show_unquote("\"a\\tb\\n\\\"q\\\" \\\\ \\x41\\x7a\"")
    show_unquote("\"\\u00e9\\u03bb\\U0001F600\"")
    show_unquote(text.quote("round \"trip\"\n\t é"))
    show_unquote("noquotes")
    show_unquote("\"open")
    show_unquote("\"a\"b\"")
    show_unquote("\"bad \\q\"")
    show_unquote("\"short \\x4\"")
    show_unquote("\"surrogate \\ud800\"")
    show_unquote("\"huge \\U00110000\"")
    show_unquote("\"dangling \\\"")
    show_unquote("\"\"")

    print(text.edit_distance("kitten", "sitting"))
    print(text.edit_distance("", "abc"))
    print(text.edit_distance("abc", ""))
    print(text.edit_distance("same", "same"))
    print(text.edit_distance("flaw", "lawn"))
    print(text.edit_distance("héllo", "hello"))
    print(text.edit_distance("日本語", "日本"))

    print(text.wrap("the quick brown fox jumps over the lazy dog", 10))
    print("--")
    print(text.wrap("short", 10))
    print("--")
    print(text.wrap("a verylongwordthatexceeds fits", 8))
    print("--")
    print(text.wrap("first paragraph here\n\nsecond   one", 12))
    print("--")
    print(text.wrap("héllo wörld ünï", 9))

    print(text.is_ascii("plain text 123"))
    print(text.is_ascii("héllo"))
    print(text.is_ascii(""))

    print(text.reverse("hello"))
    print(text.reverse("héllo 😀!"))
    print(text.reverse(""))
}
