import std/file
import std/header
import std/http
import std/io
import std/net
import std/sync

struct Seen {
    lock: sync.Mutex
    hosts: []str
}

fn origin_answer(req: http.Request) -> http.Response {
    let host = header.get(req.headers, "host") ?? req.authority
    http.response(200, "{req.method} host={host} path={req.target} body={str(req.body)}")
}

fn unix_handle(path: str) -> net.ConnHandle ! io.Error {
    using var c = net.connect_unix(path)?
    net.detach(mut c)
}

fn main() ! io.Error {
    let dir = file.temp_dir("lowunix")?
    let socket_path = "{dir}/origin.sock"
    using unix = net.listen_unix(socket_path)?
    let handler = fn(req: http.Request) -> http.Response { origin_answer(req) }
    let unix_view = unix.handle
    spawn fn() {
        http.serve_on(unix_view, handler) or {}
    }()
    let dialled = new(Seen { lock: sync.mutex(), hosts: [] })
    let dial_unix = net.Dialer {
        dial: fn(host: str, port: i64) -> net.ConnHandle ! io.Error {
            sync.lock(dialled.lock)
            push(mut dialled.hosts, "{host}:{port}")
            sync.unlock(dialled.lock)
            unix_handle(socket_path)?
        }
    }
    let client = http.client().with_dialer(dial_unix).build()
    let r = client.get("http://unix.test/over-unix") or {
        print("request failed")
        return
    }
    print("{r.status} {http.text(r)}")
    print("dialer asked for {dialled.hosts[0]}")
    net.close_listener(unix)
    file.remove_all(dir)?
}
