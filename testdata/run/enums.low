enum Shape {
    Circle(radius: i64)
    Rect(w: i64, h: i64)
    Empty
}

enum Color {
    Red
    Green
    Blue
}

enum Wrapper {
    Holds(Shape, Color)
    Nothing
}

fn area(s: Shape) -> i64 {
    match s {
        Circle(r) => 3 * r * r
        Rect(w, h) => w * h
        Empty => 0
    }
}

fn name(c: Color) -> str {
    match c {
        Red => "red"
        Green => "green"
        Blue => "blue"
    }
}

fn biggest(a: Shape, b: Shape) -> Shape {
    if area(a) >= area(b) { a } else { b }
}

fn unwrap(w: Wrapper) -> Shape {
    match w {
        Holds(s, _) => s
        Nothing => Shape.Empty
    }
}

fn main() {
    print(area(Shape.Circle(2)))
    print(area(Shape.Rect(3, 4)))
    print(area(Shape.Empty))

    let c: Color = Green
    print(name(c))
    print(name(Color.Blue))

    let big = biggest(Shape.Rect(2, 2), Shape.Circle(3))
    print(area(big))

    var s: Shape = Rect(5, 6)
    print(area(s))
    s = Empty
    print(area(s))

    let w = Wrapper.Holds(Shape.Rect(7, 8), Color.Red)
    print(area(unwrap(w)))
    print(area(unwrap(Wrapper.Nothing)))

    let kind = match big {
        Circle(_) => "circle"
        _ => "other"
    }
    print(kind)

    for {
        match c {
            Green => break
            _ => print("unreachable")
        }
    }
    print("done")
}
