import std/file
import std/io
import std/text

fn main() ! io.Error {
    let root = file.temp_dir("low-std-tree-")?
    print(text.starts_with(root, "/tmp/low-std-tree-"))
    print(file.stat(root)?.mode & 0x1FF)
    let other = file.temp_dir("low-std-tree-")?
    print(root != other)
    file.mkdir_all("{root}/a/b/c")?
    file.write_text("{root}/a/b/c/leaf", "leaf")?
    file.write_text("{root}/top", "top")?
    file.symlink("missing-target", "{root}/a/dangling")?
    file.symlink("/tmp", "{root}/a/outside")?
    file.remove_all(root)?
    print(file.exists(root))
    print(file.exists("/tmp"))
    file.remove_all(root)?
    file.write_text("{other}/plain", "x")?
    file.remove_all("{other}/plain")?
    print(file.list(other)?.len)
    file.remove_all(other)?
    print(file.exists(other))
}
