        Probe { label: "tinyint", expression: "CAST(255 AS tinyint)", kind: "tinyint", want: "Int(255)" },
        Probe { label: "smallint", expression: "CAST(-32768 AS smallint)", kind: "smallint", want: "Int(-32768)" },
        Probe { label: "int", expression: "CAST(-2147483648 AS int)", kind: "int", want: "Int(-2147483648)" },
        Probe { label: "bigint", expression: "CAST(-9223372036854775808 AS bigint)", kind: "bigint", want: "Int(-9223372036854775808)" },
        Probe { label: "bit", expression: "CAST(1 AS bit)", kind: "bit", want: "Bool(true)" },
        Probe { label: "real", expression: "CAST(1.5 AS real)", kind: "real", want: "Float(1.5)" },
        Probe { label: "float", expression: "CAST(-0.1 AS float)", kind: "float", want: "Float(-0.1)" },
        Probe { label: "decimal", expression: "CAST(-12345.6789012345 AS decimal(38, 10))", kind: "decimal", want: "Decimal(-12345.6789012345)" },
        Probe { label: "decimal max", expression: "CAST(99999999999999999999999999999999999999 AS decimal(38, 0))", kind: "decimal", want: "Decimal(99999999999999999999999999999999999999)" },
        Probe { label: "numeric", expression: "CAST(0.001 AS numeric(5, 4))", kind: "numeric", want: "Decimal(0.0010)" },
        Probe { label: "numeric zero", expression: "CAST(0 AS numeric(3, 1))", kind: "numeric", want: "Decimal(0.0)" },
        Probe { label: "money", expression: "CAST(-922337203685477.5808 AS money)", kind: "money", want: "Decimal(-922337203685477.5808)" },
        Probe { label: "smallmoney", expression: "CAST(-214748.3648 AS smallmoney)", kind: "smallmoney", want: "Decimal(-214748.3648)" },
        Probe { label: "datetime", expression: "CAST('2024-02-29T13:45:30.997' AS datetime)", kind: "datetime", want: "Timestamp(1709214330996667)" },
        Probe { label: "smalldatetime", expression: "CAST('2024-02-29 13:45:29' AS smalldatetime)", kind: "smalldatetime", want: "Timestamp(1709214300000000)" },
