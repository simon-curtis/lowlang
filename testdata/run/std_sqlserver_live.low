import std/crypto/x509
import std/file
import std/io
import std/orm
import std/os
import std/sql
import std/sql/sqlserver
import std/text
import std/time
import std/tls

struct Target {
    options: sql.Options
    ca: str
}

struct Probe {
    label: str
    expression: str
    kind: str
    want: str
}

enum Role {
    Admin
    Member
}

struct Address {
    city: str
    zip: str
}

struct User {
    id: i64
    name: str
    email: str?
    age: i32
    role: Role
    address: Address?
    tags: str[]
    active: bool = true
}

fn target() -> Target? {
    let env = os.environment()
    let spec = env["LOWLANG_SQLSERVER"] ?? ""
    let at = text.last_index_byte(spec, '@')
    if at < 0 {
        return none
    }
    let credentials = spec[..at]
    let address = spec[at + 1..]
    let colon = text.index_byte(credentials, ':')
    let port_at = text.last_index_byte(address, ':')
    if colon < 0 || port_at < 0 {
        print("FAIL LOWLANG_SQLSERVER is not user:password@host:port")
        return none
    }
    let port = text.parse_int(address[port_at + 1..]) or {
        print("FAIL LOWLANG_SQLSERVER port")
        return none
    }
    let options = sql.Options { host: address[..port_at], port, user: credentials[..colon], password: credentials[colon + 1..], timeout: 5000 }
    Target { options, ca: env["LOWLANG_SQLSERVER_CA"] ?? "" }
}

fn show(v: sql.Value) -> str {
    match v {
        Null => "NULL"
        Bool(b) => "Bool({b})"
        Int(n) => "Int({n})"
        Float(x) => "Float({x})"
        Decimal(d) => "Decimal({d})"
        Text(s) => "Text({s})"
        Bytes(b) => "Bytes({text.encode_hex(b)})"
        Uuid(b) => "Uuid({text.encode_hex(b)})"
        Date(d) => "Date({d})"
        Time(t) => "Time({t})"
        Timestamp(t) => "Timestamp({t})"
        TimestampTz(t) => "TimestampTz({t})"
    }
}

fn attempt(work: fn() ! sql.Error) -> str {
    work() catch {
        Connect => return "Connect"
        Authentication => return "Authentication"
        Closed => return "Closed"
        Timeout => return "Timeout"
        Protocol => return "Protocol"
        Unsupported => return "Unsupported"
        Conversion => return "Conversion"
        Busy => return "Busy"
        Cancelled => return "Cancelled"
        Server(errors) => return "Server({server_text(errors)})"
    }
    "ok"
}

fn server_text(errors: sql.Diagnostic[]) -> str {
    var parts: str[] = []
    for d in errors {
        parts.push("{d.code}, {d.message}")
    }
    text.join(parts, " + ")
}

fn count_text(count: i64?) -> str {
    match count {
        some(n) => "{n}"
        none => "none"
    }
}

fn level_name(l: sql.Level) -> str {
    match l {
        Info => "Info"
        Warning => "Warning"
        Failure => "Failure"
        Fatal => "Fatal"
    }
}

fn describe(d: sql.Diagnostic) -> str {
    "{level_name(d.level)} {d.code} class={d.class} state={d.state} line={d.line} {d.message}"
}

fn event_text(e: sql.Event) -> str {
    match e {
        Columns(cols) => {
            var names: str[] = []
            for c in cols {
                names.push(c.name)
            }
            "columns({text.join(names, ",")})"
        }
        Row(values) => {
            var cells: str[] = []
            for v in values {
                cells.push(show(v))
            }
            "row({text.join(cells, ",")})"
        }
        Done(count) => "done({count_text(count)})"
    }
}

fn cancel_later(db: sql.ConnectionHandle, millis: i64) {
    sleep(millis)
    db.cancel()
}

fn failures(work: fn() ! sql.Error) -> sql.Diagnostic[] {
    work() catch {
        Server(all) => return all
        _ => return []
    }
    []
}

fn diagnostics(db: sql.ConnectionHandle) ! sql.Error {
    var notices: str[] = []
    db.on_notice(fn(n: sql.Notice) {
        match n {
            Message(d) => notices.push(describe(d))
            Notification(channel, payload, process) => notices.push(channel)
            Setting(name, value) => notices.push("{name}={value}")
        }
    })
    let _ = db.execute("PRINT 'hello'", [])?
    let _ = db.execute("RAISERROR('careful', 10, 3)", [])?
    check("notices", text.join(notices, "|"), "Info 0 class=0 state=1 line=1 hello|Info 50000 class=0 state=3 line=1 careful")
    db.on_notice(fn(n: sql.Notice) {})

    let errors = failures(fn() ! sql.Error {
        db.execute("SELECT 1;\nRAISERROR('first', 16, 1);\nRAISERROR('second', 16, 2)", [])?
    })
    check("several errors", server_text(errors), "50000, first + 50000, second")
    check("error fields", "{errors.len} {errors[0].class} {errors[0].state} {errors[0].line} {errors[1].state} {errors[1].line}", "2 16 1 2 2 3")
    check("usable after several errors", show(single(db, "SELECT 4", [])?), "Int(4)")

    var events: str[] = []
    db.stream("SELECT 1 AS a; SELECT 2 AS b, 3 AS c", [], fn(e) -> bool {
        events.push(event_text(e))
        true
    })?
    check("stream", text.join(events, " "), "columns(a) row(Int(1)) done(1) columns(b,c) row(Int(2),Int(3)) done(1)")

    let sets = db.query_all("SELECT 1 AS a; SELECT 2 AS b, 3 AS c", [])?
    check("sets", "{sets.len} {sets[0].rows.len} {sets[1].columns.len}", "2 1 2")
    check("last set", show(db.query("SELECT 1 AS a; SELECT 2 AS b", [])?.rows[0][0]), "Int(2)")
    check("usable after sets", show(single(db, "SELECT 5", [])?), "Int(5)")
}

fn shape(c: sql.Column) -> str {
    "{c.kind} precision={c.precision} scale={c.scale} length={c.length}"
}

fn fidelity(o: sql.Options) ! sql.Error {
    using plain = sqlserver.connect(o)?
    let db = plain.handle
    let r = db.query("SELECT CAST('2024-01-02 03:04:05.1234567 +05:30' AS datetimeoffset(7)) AS a, CAST('2024-01-02 03:04:05' AS datetime2(0)) AS b, CAST('03:04:05.12' AS time(2)) AS c, CAST(1 AS decimal(12, 3)) AS d, CAST('x' AS nvarchar(10)) AS e, CAST('x' AS varchar(max)) AS f, CAST('x' AS char(4)) AS g, CAST(0x01 AS varbinary(8)) AS h, CAST('x' AS nvarchar(max)) AS i", [])?
    check("datetimeoffset shape", shape(r.columns[0]), "datetimeoffset precision=0 scale=7 length=0")
    check("datetime2 shape", shape(r.columns[1]), "datetime2 precision=0 scale=0 length=0")
    check("time shape", shape(r.columns[2]), "time precision=0 scale=2 length=0")
    check("decimal shape", shape(r.columns[3]), "decimal precision=12 scale=3 length=0")
    check("nvarchar shape", shape(r.columns[4]), "nvarchar precision=0 scale=0 length=10")
    check("varchar max shape", shape(r.columns[5]), "varchar precision=0 scale=0 length=-1")
    check("char shape", shape(r.columns[6]), "char precision=0 scale=0 length=4")
    check("varbinary shape", shape(r.columns[7]), "varbinary precision=0 scale=0 length=8")
    check("nvarchar max shape", shape(r.columns[8]), "nvarchar precision=0 scale=0 length=-1")
    check("default offset", show(r.rows[0][0]), "TimestampTz(1704144845123456)")

    var events: str[] = []
    db.stream("CREATE TABLE #none (a int)", [], fn(e) -> bool {
        events.push(event_text(e))
        true
    })?
    check("ddl count", text.join(events, " "), "done(none)")
    events = []
    db.stream("UPDATE #none SET a = 1 WHERE a = 2", [], fn(e) -> bool {
        events.push(event_text(e))
        true
    })?
    check("matched no rows", text.join(events, " "), "done(0)")
    events = []
    db.stream("SET NOCOUNT ON; UPDATE #none SET a = 1 WHERE a = 2", [], fn(e) -> bool {
        events.push(event_text(e))
        true
    })?
    check("nocount", events[events.len - 1], "done(none)")
    let _ = db.execute("SET NOCOUNT OFF", [])?

    let before = db.query("SELECT DB_NAME()", [])?
    var original = "master"
    match before.rows[0][0] {
        Text(name) => {
            original = name
        }
        _ => {}
    }
    let moved = if original == "tempdb" { "master" } else { "tempdb" }
    var settings: str[] = []
    db.on_notice(fn(n: sql.Notice) {
        match n {
            Message(d) => settings.push("notice {d.code}")
            Notification(channel, payload, process) => {}
            Setting(name, value) => settings.push("{name}={value}")
        }
    })
    let _ = db.execute("USE [{moved}]", [])?
    check("database change", text.join(settings, " "), "database={moved} notice 5701")
    db.on_notice(fn(n: sql.Notice) {})
    let _ = db.execute("USE [{original}]", [])?

    var exact = o
    exact.server_text = true
    using shown = sqlserver.connect(exact)?
    let e = shown.handle.query("SELECT CAST('2024-01-02 03:04:05.1234567 +05:30' AS datetimeoffset(7)) AS a, CAST('2024-01-02 03:04:05.1234567' AS datetime2(7)) AS b, CAST('2024-01-02 03:04:05' AS datetime2(0)) AS c, CAST('03:04:05.1234567' AS time(7)) AS d, CAST('2024-01-02 03:04:05.5 -08:00' AS datetimeoffset(1)) AS f, CAST('2024-01-02' AS date) AS g, CAST(7 AS int) AS h", [])?
    var got: str[] = []
    for v in e.rows[0] {
        got.push(show(v))
    }
    check("exact values", text.join(got, "|"), "Text(2024-01-02 03:04:05.1234567 +05:30)|Text(2024-01-02 03:04:05.1234567)|Text(2024-01-02 03:04:05)|Text(03:04:05.1234567)|Text(2024-01-02 03:04:05.5 -08:00)|Date(19724)|Int(7)")

    using intent = sqlserver.connect_with(o, sqlserver.Config { read_only: true })?
    check("read only intent", show(single(intent.handle, "SELECT 1", [])?), "Int(1)")
}

fn cancelling(o: sql.Options) ! sql.Error {
    using conn = sqlserver.connect(o)?
    let db = conn.handle
    spawn cancel_later(db, 300)
    let started = time.monotonic()
    check("cancel waitfor", attempt(fn() ! sql.Error { db.execute("WAITFOR DELAY '00:00:10'", [])? }), "Cancelled")
    let elapsed = (time.monotonic() - started) / 1000000
    check("cancel elapsed", if elapsed >= 250 && elapsed < 3000 { "ok" } else { "{elapsed}" }, "ok")
    check("usable after cancel", show(single(db, "SELECT 6", [])?), "Int(6)")
    db.cancel()
    check("idle cancel is ignored", show(single(db, "SELECT 7", [])?), "Int(7)")

    var seen = 0
    check("cancel in callback", attempt(fn() ! sql.Error {
        db.each("SELECT TOP (200000) a.object_id FROM sys.all_columns a CROSS JOIN sys.all_columns b", [], fn(cols, values) -> bool {
            seen += 1
            db.cancel()
            true
        })?
    }), "Cancelled")
    check("callback stops at the cancelled row", "{seen}", "1")
    check("usable after callback cancel", show(single(db, "SELECT 8", [])?), "Int(8)")
    conn.handle.close()
}

fn check(label: str, got: str, want: str) {
    if got != want {
        print("FAIL {label}: got {got} want {want}")
    }
}

fn single(db: sql.ConnectionHandle, text: str, values: sql.Value[]) -> sql.Value ! sql.Error {
    let r = db.query(text, values)?
    if r.rows.len != 1 || r.rows[0].len != 1 {
        fail Protocol
    }
    r.rows[0][0]
}

