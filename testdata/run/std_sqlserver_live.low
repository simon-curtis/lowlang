import std/crypto/x509
import std/file
import std/io
import std/orm
import std/sql
import std/sql/sqlserver
import std/text
import std/time
import std/tls

struct Target {
    options: sql.Options
    ca: str
}

struct Probe {
    label: str
    expression: str
    kind: str
    want: str
}

enum Role {
    Admin
    Member
}

struct Address {
    city: str
    zip: str
}

struct User {
    id: i64
    name: str
    email: str?
    age: i32
    role: Role
    address: Address?
    tags: []str
    active: bool = true
}

fn environment() -> [str: str] {
    var out: [str: str] = [:]
    let data = file.read_file("/proc/self/environ") catch {
        _ => return out
    }
    var start = 0
    for i in 0..data.len {
        if data[i] == 0 {
            let entry = str(data[start..i])
            let eq = text.index_byte(entry, '=')
            if eq > 0 {
                out[entry[..eq]] = entry[eq + 1..]
            }
            start = i + 1
        }
    }
    out
}

fn target() -> Target? {
    let env = environment()
    let spec = env["LOWLANG_SQLSERVER"] ?? ""
    let at = text.last_index_byte(spec, '@')
    if at < 0 {
        return none
    }
    let credentials = spec[..at]
    let address = spec[at + 1..]
    let colon = text.index_byte(credentials, ':')
    let port_at = text.last_index_byte(address, ':')
    if colon < 0 || port_at < 0 {
        print("FAIL LOWLANG_SQLSERVER is not user:password@host:port")
        return none
    }
    let port = text.parse_int(address[port_at + 1..]) catch {
        _ => {
            print("FAIL LOWLANG_SQLSERVER port")
            return none
        }
    }
    let options = sql.Options { host: address[..port_at], port, user: credentials[..colon], password: credentials[colon + 1..], timeout: 5000 }
    Target { options, ca: env["LOWLANG_SQLSERVER_CA"] ?? "" }
}

fn show(v: sql.Value) -> str {
    match v {
        Null => "NULL"
        Bool(b) => "Bool({b})"
        Int(n) => "Int({n})"
        Float(x) => "Float({x})"
        Decimal(d) => "Decimal({d})"
        Text(s) => "Text({s})"
        Bytes(b) => "Bytes({text.encode_hex(b)})"
        Uuid(b) => "Uuid({text.encode_hex(b)})"
        Date(d) => "Date({d})"
        Time(t) => "Time({t})"
        Timestamp(t) => "Timestamp({t})"
        TimestampTz(t) => "TimestampTz({t})"
    }
}

fn attempt(work: fn() ! sql.Error) -> str {
    work() catch {
        Connect => return "Connect"
        Authentication => return "Authentication"
        Closed => return "Closed"
        Timeout => return "Timeout"
        Protocol => return "Protocol"
        Unsupported => return "Unsupported"
        Conversion => return "Conversion"
        Busy => return "Busy"
        Server(code, message) => return "Server({code}, {message})"
    }
    "ok"
}

fn check(label: str, got: str, want: str) {
    if got != want {
        print("FAIL {label}: got {got} want {want}")
    }
}

fn single(db: sql.Connection, text: str, values: []sql.Value) -> sql.Value ! sql.Error {
    let r = db.query(text, values)?
    if r.rows.len != 1 || r.rows[0].len != 1 {
        fail Protocol
    }
    r.rows[0][0]
}

