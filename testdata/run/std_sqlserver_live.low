fn null_type(expression: str) -> str {
    let start = text.last_index_byte(expression, 'S')
    "CAST(NULL A{expression[start..]}"
}

fn decoding(db: sql.Connection) ! sql.Error {
    let all = probes()
    var parts: []str = []
    var nulls: []str = []
    for i, p in all {
        push(mut parts, "{p.expression} AS [{p.label}]")
        push(mut nulls, null_type(p.expression))
    }
    let r = db.query("SELECT {text.join(parts, ", ")}", [])?
    let n = db.query("SELECT {text.join(nulls, ", ")}", [])?
    for i, p in all {
        check("{p.label} name", r.columns[i].name, p.label)
        check("{p.label} kind", r.columns[i].kind, p.kind)
        check("{p.label} value", show(r.rows[0][i]), p.want)
        check("{p.label} null", show(n.rows[0][i]), "NULL")
    }
    let h = db.query("SELECT CAST('/1/2/' AS hierarchyid) AS h, CAST(CAST('/1/2/' AS hierarchyid) AS varbinary(20)) AS b", [])?
    check("hierarchyid kind", h.columns[0].kind, "hierarchyid")
    check("hierarchyid value", show(h.rows[0][0]), show(h.rows[0][1]))
    db.execute("CREATE TABLE #fixed (a tinyint NOT NULL, b smallint NOT NULL, c int NOT NULL, d bigint NOT NULL, e bit NOT NULL, f real NOT NULL, g float NOT NULL, h money NOT NULL, i smallmoney NOT NULL, j datetime NOT NULL, k smalldatetime NOT NULL)", [])?
    db.execute("INSERT INTO #fixed VALUES (7, -7, 70000, 7000000000, 0, 0.25, 1e300, 12.3456, -1.5, '1900-01-01', '1900-01-01 00:01')", [])?
    let f = db.query("SELECT * FROM #fixed", [])?
    var got: []str = []
    for v in f.rows[0] {
        push(mut got, show(v))
    }
    check("fixed", text.join(got, " "), "Int(7) Int(-7) Int(70000) Int(7000000000) Bool(false) Float(0.25) Float(1e+300) Decimal(12.3456) Decimal(-1.5000) Timestamp(-2208988800000000) Timestamp(-2208988740000000)")
    db.execute("CREATE TABLE #utf8 (v varchar(20) COLLATE Latin1_General_100_CI_AS_SC_UTF8)", [])?
    db.execute("INSERT INTO #utf8 VALUES (N'é€😀')", [])?
    let u = db.query("SELECT v FROM #utf8", [])?
    check("varchar utf8", "{u.columns[0].kind} {show(u.rows[0][0])}", "varchar Text(é€😀)")
    var sparse: []str = []
    for i in 0..40 {
        push(mut sparse, if i % 13 == 0 { "{i} AS c{i}" } else { "CAST(NULL AS int) AS c{i}" })
    }
    let s = db.query("SELECT {text.join(sparse, ", ")} FROM (VALUES (1), (2)) AS v(x)", [])?
    var shown: []str = []
    for v in s.rows[1] {
        if show(v) != "NULL" {
            push(mut shown, show(v))
        }
    }
    check("sparse row", text.join(shown, " "), "Int(0) Int(13) Int(26) Int(39)")
}

fn uuid_bytes() -> []u8 {
    [0xa0, 0xee, 0xbc, 0x99, 0x9c, 0x0b, 0x4e, 0xf8, 0xbb, 0x6d, 0x6b, 0xb9, 0xbd, 0x38, 0x0a, 0x11]
}

fn parameters() -> []sql.Value {
    [
        sql.Value.Null,
        sql.Value.Bool(true),
        sql.Value.Bool(false),
        sql.Value.Int(-9223372036854775807 - 1),
        sql.Value.Int(9223372036854775807),
        sql.Value.Float(-0.25),
        sql.Value.Float(1e300),
        sql.Value.Decimal("1.50"),
        sql.Value.Decimal("-0.000120"),
        sql.Value.Decimal("99999999999999999999999999999999999999"),
        sql.Value.Decimal("-12345678901234567890.123456789012345678"),
        sql.Value.Text(""),
        sql.Value.Text("héllo 😀"),
        sql.Value.Bytes([]),
        sql.Value.Bytes([0, 255, 16]),
        sql.Value.Uuid(uuid_bytes()),
        sql.Value.Date(-719162),
        sql.Value.Date(2932896),
        sql.Value.Date(-1),
        sql.Value.Time(0),
        sql.Value.Time(86399999999),
        sql.Value.Timestamp(-1),
        sql.Value.Timestamp(951825600000001),
        sql.Value.TimestampTz(1704164645123456),
    ]
}

fn expected_echo(v: sql.Value) -> str {
    match v {
        Decimal(d) => {
            if d == "-12345678901234567890.123456789012345678" {
                return "Decimal(-12345678901234567890.123456789012345678)"
            }
            show(v)
        }
        _ => show(v)
    }
}

fn binding(db: sql.Connection) ! sql.Error {
    for i, v in parameters() {
        let got = single(db, "SELECT @p1", [v])?
        check("echo {i}", show(got), expected_echo(v))
    }
    let several = db.query("SELECT @p1 + @p2 AS sum, @p3 AS t, CONCAT(@p3, @p4) AS joined", [sql.Value.Int(2), sql.Value.Int(40), sql.Value.Text("a"), sql.Value.Int(1)])?
    check("several", "{show(several.rows[0][0])} {show(several.rows[0][1])} {show(several.rows[0][2])}", "Int(42) Text(a) Text(a1)")
    check("decimal out of range", attempt(fn() ! sql.Error { db.query("SELECT @p1", [sql.Value.Decimal("123456789012345678901234567890123456789")])? }), "Conversion")
    check("decimal malformed", attempt(fn() ! sql.Error { db.query("SELECT @p1", [sql.Value.Decimal("1e5")])? }), "Conversion")
    check("date out of range", attempt(fn() ! sql.Error { db.query("SELECT @p1", [sql.Value.Date(2932897)])? }), "Conversion")
    check("time out of range", attempt(fn() ! sql.Error { db.query("SELECT @p1", [sql.Value.Time(86400000000)])? }), "Conversion")
    check("nan", attempt(fn() ! sql.Error { db.query("SELECT @p1", [sql.Value.Float(0.0 / 0.0)])? }), "Conversion")
    check("short uuid", attempt(fn() ! sql.Error { db.query("SELECT @p1", [sql.Value.Uuid([1, 2])])? }), "Conversion")
    db.execute("CREATE TABLE #typed (id int, b bit, i bigint, f float, d decimal(20, 6), t nvarchar(max), v varchar(50), bin varbinary(max), u uniqueidentifier, dt date, tm time, ts datetime2, tz datetimeoffset, moment datetime)", [])?
    let row = [sql.Value.Int(1), sql.Value.Bool(true), sql.Value.Int(-5), sql.Value.Float(2.5), sql.Value.Decimal("-3.25"), sql.Value.Text("ñ😀"),
        sql.Value.Text("ascii"), sql.Value.Bytes([1, 2, 3]), sql.Value.Uuid(uuid_bytes()), sql.Value.Date(18262), sql.Value.Time(3723456000),
        sql.Value.Timestamp(951825600000001), sql.Value.TimestampTz(1704164645123456), sql.Value.Timestamp(1709214330997000)]
    let inserted = db.execute("INSERT INTO #typed VALUES (@p1, @p2, @p3, @p4, @p5, @p6, @p7, @p8, @p9, @p10, @p11, @p12, @p13, @p14)", row)?
    check("typed insert count", "{inserted}", "1")
    var nulls: []sql.Value = [sql.Value.Int(2)]
    for _ in 1..14 {
        push(mut nulls, sql.Value.Null)
    }
    db.execute("INSERT INTO #typed (id, b, i, f, d, t, v, u, dt, tm, ts, tz, moment) VALUES (@p1, @p2, @p3, @p4, @p5, @p6, @p7, @p9, @p10, @p11, @p12, @p13, @p14)", nulls)?
    let back = db.query("SELECT * FROM #typed ORDER BY id", [])?
    var got: []str = []
    for v in back.rows[0] {
        push(mut got, show(v))
    }
    check("typed row", text.join(got, " "), "Int(1) Bool(true) Int(-5) Float(2.5) Decimal(-3.250000) Text(ñ😀) Text(ascii) Bytes(010203) Uuid(a0eebc999c0b4ef8bb6d6bb9bd380a11) Date(18262) Time(3723456000) Timestamp(951825600000001) TimestampTz(1704164645123456) Timestamp(1709214330996667)")
    var null_count = 0
    for v in back.rows[1] {
        if show(v) == "NULL" {
            null_count += 1
        }
    }
    check("typed nulls", "{null_count}", "13")
    check("null into varbinary", attempt(fn() ! sql.Error { db.execute("INSERT INTO #typed (id, bin) VALUES (3, @p1)", [sql.Value.Null])? }), "Server(257, Implicit conversion from data type nvarchar to varbinary(max) is not allowed. Use the CONVERT function to run this query.)")
}

fn large(db: sql.Connection) ! sql.Error {
    var wide: []u8 = []
    for i in 0..150000 {
        io.append_str(mut wide, if i % 1000 == 0 { "€😀" } else { "ab" })
    }
    let long_text = str(wide)
    let blob = io.buffer(3000000)
    for i in 0..blob.len {
        blob[i] = u8(i * 7 + i / 251)
    }
    db.execute("CREATE TABLE #big (t nvarchar(max), b varbinary(max))", [])?
    db.execute("INSERT INTO #big VALUES (@p1, @p2)", [sql.Value.Text(long_text), sql.Value.Bytes(blob)])?
    let r = db.query("SELECT t, b, LEN(t), DATALENGTH(b) FROM #big", [])?
    match r.rows[0][0] {
        Text(s) => check("long text", if s == long_text { "same" } else { "differs {s.len}" }, "same")
        _ => check("long text", show(r.rows[0][0]), "Text")
    }
    match r.rows[0][1] {
        Bytes(b) => check("long blob", if b.len == blob.len && str(b) == str(blob) { "same" } else { "differs {b.len}" }, "same")
        _ => check("long blob", "not bytes", "Bytes")
    }
    check("long text length", show(r.rows[0][2]), "Int(300150)")
    check("long blob length", show(r.rows[0][3]), "Int(3000000)")
    let generated = single(db, "SELECT REPLICATE(CAST(N'é' AS nvarchar(max)), 1000000)", [])?
    match generated {
        Text(s) => check("generated text", "{s.len}", "2000000")
        _ => check("generated text", show(generated), "Text")
    }
}

fn errors(db: sql.Connection, o: sql.Options) ! sql.Error {
    check("missing table", attempt(fn() ! sql.Error { db.query("SELECT * FROM nope", [])? }), "Server(208, Invalid object name 'nope'.)")
    check("usable after error", show(single(db, "SELECT 1", [])?), "Int(1)")
    check("divide by zero", attempt(fn() ! sql.Error { db.query("SELECT 1 / @p1", [sql.Value.Int(0)])? }), "Server(8134, Divide by zero error encountered.)")
    check("raiserror", attempt(fn() ! sql.Error { db.execute("RAISERROR('boom %d', 16, 1, 7)", [])? }), "Server(50000, boom 7)")
    check("syntax", attempt(fn() ! sql.Error { db.execute("SELEC 1", [])? }), "Server(2812, Could not find stored procedure 'SELEC'.)")
    check("parameter syntax", attempt(fn() ! sql.Error { db.execute("SELECT FROM WHERE @p1", [sql.Value.Int(1)])? }), "Server(156, Incorrect syntax near the keyword 'FROM'.)")
    check("rows before error", attempt(fn() ! sql.Error { db.query("SELECT 1; SELECT * FROM nope", [])? }), "Server(208, Invalid object name 'nope'.)")
    check("usable after errors", show(single(db, "SELECT @p1", [sql.Value.Text("still")])?), "Text(still)")
    check("bad login", attempt(fn() ! sql.Error {
        let bad = sqlserver.connect(sql.Options { host: o.host, port: o.port, user: o.user, password: "wrong" })?
        bad.close()
    }), "Server(18456, Login failed for user 'sa'.)")
    check("missing database", attempt(fn() ! sql.Error {
        let bad = sqlserver.connect(sql.Options { host: o.host, port: o.port, user: o.user, password: o.password, database: "nope" })?
        bad.close()
    }), "Server(4060, Cannot open database \"nope\" requested by the login. The login failed.)")
    check("refused port", attempt(fn() ! sql.Error {
        let bad = sqlserver.connect(sql.Options { host: "127.0.0.1", port: 1, user: o.user, password: o.password })?
        bad.close()
    }), "Connect")
    let fatal = sqlserver.connect(o)?
    check("fatal", attempt(fn() ! sql.Error { fatal.execute("RAISERROR('fatal', 20, 1) WITH LOG", [])? }), "Server(50000, fatal)")
    check("after fatal", attempt(fn() ! sql.Error { fatal.execute("SELECT 1", [])? }), "Closed")
    fatal.close()
}

fn counts(db: sql.Connection) ! sql.Error {
    db.execute("CREATE TABLE #c (n int)", [])?
    check("insert count", "{db.execute("INSERT INTO #c VALUES (1), (2), (3)", [])?}", "3")
    check("update count", "{db.execute("UPDATE #c SET n = n + 1 WHERE n > @p1", [sql.Value.Int(1)])?}", "2")
    check("batch count", "{db.execute("DELETE FROM #c; INSERT INTO #c VALUES (9)", [])?}", "4")
    check("nocount", "{db.execute("SET NOCOUNT ON; INSERT INTO #c VALUES (10); SET NOCOUNT OFF", [])?}", "0")
    check("select count", "{db.execute("SELECT * FROM #c", [])?}", "2")
    let r = db.query("INSERT INTO #c VALUES (11); SELECT n FROM #c ORDER BY n", [])?
    check("last result set", "{r.columns[0].name} {r.rows.len}", "n 3")
}

fn trancount(db: sql.Connection) -> str ! sql.Error {
    show(single(db, "SELECT @@TRANCOUNT", [])?)
}

fn rows_in(db: sql.Connection) -> str ! sql.Error {
    show(single(db, "SELECT COUNT(*) FROM #tx", [])?)
}

fn transactions(db: sql.Connection) ! sql.Error {
    db.execute("CREATE TABLE #tx (n int PRIMARY KEY)", [])?
    db.begin()?
    check("in transaction", trancount(db)?, "Int(1)")
    db.execute("INSERT INTO #tx VALUES (@p1)", [sql.Value.Int(1)])?
    db.rollback()?
    check("rolled back", rows_in(db)?, "Int(0)")
    check("after rollback", trancount(db)?, "Int(0)")
    db.begin()?
    db.execute("INSERT INTO #tx VALUES (1)", [])?
    db.commit()?
    check("committed", rows_in(db)?, "Int(1)")
    db.begin()?
    db.execute("INSERT INTO #tx VALUES (2)", [])?
    let duplicate = attempt(fn() ! sql.Error { db.execute("INSERT INTO #tx VALUES (@p1)", [sql.Value.Int(2)])? })
    check("duplicate", if text.starts_with(duplicate, "Server(2627, Violation of PRIMARY KEY constraint") { "ok" } else { duplicate }, "ok")
    db.commit()?
    check("survived error", rows_in(db)?, "Int(2)")
    db.execute("SET XACT_ABORT ON", [])?
    db.begin()?
    db.execute("INSERT INTO #tx VALUES (3)", [])?
    check("aborting error", attempt(fn() ! sql.Error { db.execute("INSERT INTO #tx VALUES ('x')", [])? }), "Server(245, Conversion failed when converting the varchar value 'x' to data type int.)")
    check("commit after abort", attempt(db.commit), "Server(3902, The COMMIT TRANSACTION request has no corresponding BEGIN TRANSACTION.)")
    db.execute("SET XACT_ABORT OFF", [])?
    check("aborted rows", rows_in(db)?, "Int(2)")
    check("rollback without transaction", attempt(db.rollback), "Server(3903, The ROLLBACK TRANSACTION request has no corresponding BEGIN TRANSACTION.)")
    db.begin()?
    db.begin()?
    check("nested", trancount(db)?, "Int(2)")
    db.rollback()?
    check("nested rollback", trancount(db)?, "Int(0)")
}

fn streaming(db: sql.Connection) ! sql.Error {
    var total = 0
    var seen = 0
    db.each("SELECT TOP (@p1) CAST(ROW_NUMBER() OVER (ORDER BY (SELECT NULL)) AS bigint) AS n, REPLICATE(N'x', 40) AS pad FROM sys.all_columns a CROSS JOIN sys.all_columns b", [sql.Value.Int(60000)], fn(cols, values) -> bool {
        match values[0] {
            Int(n) => {
                total += n
            }
            _ => {}
        }
        seen += 1
        true
    })?
    check("streamed rows", "{seen} {total}", "60000 1800030000")
    var first: []str = []
    db.each("SELECT TOP (200000) a.object_id FROM sys.all_columns a CROSS JOIN sys.all_columns b", [], fn(cols, values) -> bool {
        push(mut first, cols[0].name)
        first.len < 5
    })?
    check("stopped early", "{first.len}", "5")
    check("usable after stop", show(single(db, "SELECT 2", [])?), "Int(2)")
    var inner = ""
    db.each("SELECT 1 AS a UNION ALL SELECT 2", [], fn(cols, values) -> bool {
        inner = attempt(fn() ! sql.Error { db.query("SELECT 1", [])? })
        true
    })?
    check("busy", inner, "Busy")
    check("each error", attempt(fn() ! sql.Error {
        db.each("SELECT 1 AS a; SELECT * FROM nope", [], fn(cols, values) -> bool { true })?
    }), "Server(208, Invalid object name 'nope'.)")
    check("usable after each error", show(single(db, "SELECT 3", [])?), "Int(3)")
}

fn timeouts(o: sql.Options) ! sql.Error {
    var quick = o
    quick.timeout = 300
    let db = sqlserver.connect(quick)?
    let started = time.monotonic()
    check("timeout", attempt(fn() ! sql.Error { db.execute("WAITFOR DELAY '00:00:05'", [])? }), "Timeout")
    let elapsed = (time.monotonic() - started) / 1000000
    check("timeout elapsed", if elapsed >= 300 && elapsed < 1000 { "ok" } else { "{elapsed}" }, "ok")
    check("after timeout", attempt(fn() ! sql.Error { db.execute("SELECT 1", [])? }), "Closed")
    db.close()
    let slow = sqlserver.connect(quick)?
    var rows = 0
    slow.each("SELECT 1 AS n UNION ALL SELECT 2", [], fn(cols, values) -> bool {
        sleep(400)
        rows += 1
        true
    })?
    check("slow visitor", "{rows}", "2")
    slow.close()
}

fn secure(o: sql.Options, ca: str) ! sql.Error {
    let pem = file.read_text(ca) catch {
        _ => {
            print("FAIL cannot read {ca}")
            return
        }
    }
    let root = x509.parse(x509.pem_blocks(pem, "CERTIFICATE")[0]) catch {
        _ => {
            print("FAIL cannot parse {ca}")
            return
        }
    }
    let db = sqlserver.connect_tls(o, tls.Config { roots: [root] })?
    let r = db.query("SELECT encrypt_option FROM sys.dm_exec_connections WHERE session_id = @@SPID", [])?
    check("encrypted", show(r.rows[0][0]), "Text(TRUE)")
    var big: []u8 = []
    for _ in 0..20000 {
        io.append_str(mut big, "0123456789")
    }
    check("tls large", show(single(db, "SELECT LEN(@p1)", [sql.Value.Text(str(big))])?), "Int(200000)")
    db.close()
    check("wrong host", attempt(fn() ! sql.Error {
        let bad = sqlserver.connect_tls(sql.Options { host: "127.0.0.2", port: o.port, user: o.user, password: o.password }, tls.Config { roots: [root], server_name: "example.com" })?
        bad.close()
    }), "Connect")
    let unverified = sqlserver.connect_tls(o, tls.Config { verify: false })?
    check("unverified", show(single(unverified, "SELECT 5", [])?), "Int(5)")
    unverified.close()
}

fn relational(db: sql.Connection) ! sql.Error {
    let users = orm.table[User]("#orm_users")
    orm.drop_table(db, users)?
    orm.create_table(db, users)?
    let ada = User { id: 0, name: "Ada", email: none, age: 36, role: Admin, address: Address { city: "London", zip: "N1" }, tags: ["math", "engines"] }
    let alan = User { id: 0, name: "Alan", email: "alan@example.com", age: 41, role: Member, address: none, tags: [] }
    let kid = User { id: 0, name: "Kim", email: none, age: 9, role: Member, address: none, tags: ["lego"], active: false }
    var ids: []str = []
    for u in [ada, alan, kid] {
        push(mut ids, show(orm.insert(db, users, u)?))
    }
    check("orm ids", text.join(ids, " "), "Int(1) Int(2) Int(3)")
    let adults = orm.filter(orm.from(users), orm.ge(User.age, 18))
    var names: []str = []
    for u in orm.list(db, orm.order_by_desc(adults, User.name))? {
        let city = match u.address {
            some(a) => a.city
            none => "-"
        }
        push(mut names, "{u.id}:{u.name}:{u.email ?? "-"}:{city}:{u.tags.len}:{u.active}")
    }
    check("orm list", text.join(names, " "), "2:Alan:alan@example.com:-:0:true 1:Ada:-:London:2:true")
    check("orm count", "{orm.count(db, adults)?}", "2")
    let paged = orm.list(db, orm.take(orm.skip(orm.order_by(orm.from(users), User.id), 1), 1))?
    check("orm page", if paged.len == 1 { paged[0].name } else { "{paged.len}" }, "Alan")
    let found = orm.find(db, users, 3)?
    match found {
        some(u) => check("orm find", "{u.name} {u.active} {u.tags[0]}", "Kim false lego")
        none => check("orm find", "none", "Kim")
    }
    var older = alan
    older.id = 2
    older.age = 42
    check("orm update", "{orm.update(db, users, older)?}", "1")
    check("orm updated", "{orm.count(db, orm.filter(orm.from(users), orm.eq(User.age, 42)))?}", "1")
    check("orm like", "{orm.count(db, orm.filter(orm.from(users), orm.like(User.name, "A%")))?}", "2")
    check("orm null", "{orm.count(db, orm.filter(orm.from(users), orm.is_null(User.email)))?}", "2")
    check("orm one_of", "{orm.count(db, orm.filter(orm.from(users), orm.one_of(User.id, [1, 3])))?}", "2")
    check("orm transaction", attempt(fn() ! sql.Error {
        orm.transaction(db, fn() ! sql.Error {
            orm.execute(db, "DELETE FROM [#orm_users] WHERE id = @p1", [sql.Value.Int(1)])?
            orm.execute(db, "SELECT * FROM nope", [])?
        })?
    }), "Server(208, Invalid object name 'nope'.)")
    check("orm rolled back", "{orm.count(db, orm.from(users))?}", "3")
    orm.transaction(db, fn() ! sql.Error {
        orm.remove(db, users, older)?
    })?
    check("orm removed", "{orm.count(db, orm.from(users))?}", "2")
    let raw: []User = orm.query(db, "SELECT * FROM [#orm_users] WHERE age < @p1", [sql.Value.Int(18)])?
    check("orm raw", if raw.len == 1 { raw[0].name } else { "{raw.len}" }, "Kim")
    check("orm deleted", "{orm.delete_matching(db, orm.filter(orm.from(users), orm.lt(User.age, 18)))?}", "1")
    orm.drop_table(db, users)?
}

fn live(t: Target) ! sql.Error {
    let db = sqlserver.connect(t.options)?
    decoding(db)?
    binding(db)?
    large(db)?
    errors(db, t.options)?
    counts(db)?
    transactions(db)?
    streaming(db)?
    relational(db)?
    db.close()
    check("closed", attempt(fn() ! sql.Error { db.execute("SELECT 1", [])? }), "Closed")
    timeouts(t.options)?
    if t.ca.len > 0 {
        secure(t.options, t.ca)?
    }
}

fn main() {
    match target() {
        some(t) => {
            let outcome = attempt(fn() ! sql.Error { live(t)? })
            check("live run", outcome, "ok")
        }
        none => {}
    }
}
