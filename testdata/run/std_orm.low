import std/orm
import std/serde
import std/sql

enum Role {
    Admin
    Member
}

struct Address {
    city: str
    zip: str
}

struct User {
    id: i64
    name: str
    email: str?
    age: i32
    role: Role
    address: Address?
    tags: []str
    active: bool = true
}

struct Log {
    statements: []str
    rows: [][]sql.Value
}

fn describe(v: sql.Value) -> str {
    match v {
        Null => "NULL"
        Bool(b) => "{b}"
        Int(n) => "{n}"
        Float(x) => "{x}"
        Decimal(d) => d
        Text(s) => "'{s}'"
        Bytes(b) => "bytes({b.len})"
        Uuid(b) => "uuid"
        Date(d) => "date {d}"
        Time(t) => "time {t}"
        Timestamp(t) => "ts {t}"
        TimestampTz(t) => "tstz {t}"
    }
}

fn record(log: *Log, text: str, values: []sql.Value) {
    var parts: []u8 = []
    for c in bytes(text) {
        push(mut parts, c)
    }
    for i, v in values {
        for c in bytes(if i == 0 { " | " } else { ", " }) {
            push(mut parts, c)
        }
        for c in bytes(describe(v)) {
            push(mut parts, c)
        }
    }
    push(mut log.statements, str(parts))
}

fn fake(d: sql.Dialect, log: *Log, columns: []sql.Column) -> sql.ConnectionHandle {
    sql.ConnectionHandle {
        dialect: d
        query: fn(text, values) -> sql.Rows ! sql.Error {
            record(log, text, values)
            sql.Rows { columns, rows: log.rows }
        }
        each: fn(text, values, visit) ! sql.Error {
            record(log, text, values)
        }
        execute: fn(text, values) -> i64 ! sql.Error {
            record(log, text, values)
            1
        }
        begin: fn() ! sql.Error { record(log, "BEGIN", []) }
        commit: fn() ! sql.Error { record(log, "COMMIT", []) }
        rollback: fn() ! sql.Error { record(log, "ROLLBACK", []) }
        close: fn() {}
    }
}

fn names(columns: []str) -> []sql.Column {
    var out: []sql.Column = []
    for c in columns {
        push(mut out, sql.Column { name: c, kind: "" })
    }
    out
}

fn run(d: sql.Dialect) ! sql.Error {
    let users = orm.table[User]("users")
    let log = new(Log { statements: [], rows: [] })
    let db = fake(d, log, names(["id", "name", "email", "age", "role", "address", "tags", "active"]))
    print(orm.create_table_sql(d, users))
    let q = orm.from(users)
    let adults = orm.filter(orm.filter(q, orm.ge(User.age, 18)), orm.any([orm.eq(User.role, Admin), orm.like(User.name, "A%")]))
    print(orm.to_sql(d, orm.take(orm.skip(orm.order_by_desc(orm.order_by(adults, User.name), User.id), 20), 10)))
    print(orm.to_sql(d, orm.filter(q, orm.all([orm.is_null(User.email), orm.not(orm.one_of(User.id, [1, 2, 3]))]))))
    log.rows = [
        [sql.Value.Int(1), sql.Value.Text("Ada"), sql.Value.Null, sql.Value.Int(36), sql.Value.Text("Admin"),
         sql.Value.Text("{{\"city\":\"London\",\"zip\":\"N1\"}}"), sql.Value.Text("[\"math\",\"engines\"]"), sql.Value.Bool(true)],
        [sql.Value.Int(2), sql.Value.Text("Alan"), sql.Value.Text("alan@example.com"), sql.Value.Int(41), sql.Value.Text("Member"),
         sql.Value.Null, sql.Value.Text("[]"), sql.Value.Int(0)],
    ]
    for u in orm.list(db, adults)? {
        let city = match u.address {
            some(a) => a.city
            none => "-"
        }
        print("{u.id} {u.name} {u.email ?? "-"} {u.age} {city} {u.tags.len} {u.active}")
    }
    let ada = orm.find(db, users, 1)? ?? User { id: 0, name: "", email: none, age: 0, role: Member, address: none, tags: [] }
    print(ada.name)
    log.rows = [[sql.Value.Int(99)]]
    let created = User { id: 0, name: "Grace", email: "grace@example.com", age: 85, role: Admin, address: Address { city: "NYC", zip: "10001" }, tags: ["cobol"] }
    print(describe(orm.insert(db, users, created)?))
    var changed = created
    changed.id = 99
    changed.age = 86
    orm.update(db, users, changed)?
    orm.remove(db, users, changed)?
    orm.transaction(db, fn() ! sql.Error {
        orm.execute(db, "UPDATE users SET active = false WHERE id = $1", [sql.Value.Int(1)])?
    })?
    for s in log.statements {
        print(s)
    }
}

fn main() ! sql.Error {
    run(Postgres)?
    run(SqlServer)?
}
