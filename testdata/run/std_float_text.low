fn parse_outcome(s: str) -> str {
    let v = text.parse_float(s) or return "rejected"
    "{v}"
}

fn rejected_parses() {
    for s in ["", "-", "+", ".", "e5", "1e", "1e+", "1..2", "1.2.3", "12x", "1e5x", "--1", "1 ", "inf", "-inf", "+Inf", "infinity", "-Infinity", "nan", "NaN", "-nan", "infinit", "nanx"] {
        let outcome = parse_outcome(s)
        print("[{s}] {outcome}")
    }
}

fn main() {
    random_round_trips()
    decimal_round_trips()
    float32_round_trips()
    powers_of_two()
    powers_of_ten()
    extremes()
    halfway_parses()
    rejected_parses()
}
