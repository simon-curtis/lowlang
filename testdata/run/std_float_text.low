import std/text

fn next(s: u64) -> u64 {
    var x = s
    x = x ^ (x << 13)
    x = x ^ (x >> 7)
    x = x ^ (x << 17)
    x
}

fn finite(bits: u64) -> bool {
    (bits >> 52) & 0x7FF != 0x7FF
}

fn parsed_bits(s: str) -> u64 {
    let v = text.parse_float(s) or return 0xFFFFFFFFFFFFFFFF
    text.float_bits(v)
}

fn round_trip(bits: u64) -> bool {
    let v = text.float_from_bits(bits)
    let s = "{v}"
    parsed_bits(s) == bits
}

fn show_bits(label: str, bits: u64) {
    let v = text.float_from_bits(bits)
    let s = "{v}"
    let same = parsed_bits(s) == bits
    print("{label} {s} {same}")
}

fn show_parse(s: str) {
    let bits = parsed_bits(s)
    let v = text.float_from_bits(bits)
    print("{s.len} {bits} {v}")
}

fn random_round_trips() {
    var x: u64 = 0x9E3779B97F4A7C15
    var checked = 0
    var failed = 0
    for i in 0..200000 {
        x = next(x)
        if finite(x) {
            checked += 1
            if !round_trip(x) {
                failed += 1
            }
        }
    }
    print("random {checked} {failed}")
}

fn decimal_round_trips() {
    var x: u64 = 0x2545F4914F6CDD1D
    var failed = 0
    for i in 0..100000 {
        x = next(x)
        let r = f64(i64(x >> 20))
        let a = r / 1000.0
        let b = r / 7.0
        let c = r * 1e-17
        let d = r * 1e100
        if !round_trip(text.float_bits(a)) {
            failed += 1
        }
        if !round_trip(text.float_bits(b)) {
            failed += 1
        }
        if !round_trip(text.float_bits(c)) {
            failed += 1
        }
        if !round_trip(text.float_bits(d)) {
            failed += 1
        }
    }
    print("decimal {failed}")
}

fn float32_round_trips() {
    var x: u64 = 0x1B873593CC9E2D51
    var failed = 0
    for i in 0..100000 {
        x = next(x)
        let r = f64(i64(x >> 40)) - 8000000.0
        let scale = i64(x & 31)
        var v = r
        for j in 0..scale {
            v = v / 2.0
        }
        let single = f32(v)
        let s = "{single}"
        let back = text.parse_float(s) or 0.0
        if f32(back) != single {
            failed += 1
        }
    }
    print("float32 {failed}")
}

fn powers_of_two() {
    var p = 1.0
    var failed = 0
    for i in 0..1023 {
        let bits = text.float_bits(p)
        for d in 0..3 {
            if !round_trip(bits + u64(d)) || !round_trip(bits - u64(d)) {
                failed += 1
            }
        }
        p = p * 2.0
    }
    var q = 1.0
    for i in 0..1074 {
        let bits = text.float_bits(q)
        for d in 0..3 {
            if !round_trip(bits + u64(d)) || !round_trip(bits - u64(d)) {
                failed += 1
            }
        }
        q = q / 2.0
    }
    print("powers {failed}")
}

fn powers_of_ten() {
    var failed = 0
    var up = 1.0
    for i in 0..308 {
        let bits = text.float_bits(up)
        for d in 0..3 {
            if !round_trip(bits + u64(d)) || !round_trip(bits - u64(d)) {
                failed += 1
            }
        }
        up = up * 10.0
    }
    var down = 1.0
    for i in 0..323 {
        let bits = text.float_bits(down)
        for d in 0..3 {
            if !round_trip(bits + u64(d)) || !round_trip(bits - u64(d)) {
                failed += 1
            }
        }
        down = down / 10.0
    }
    print("tens {failed}")
}

fn extremes() {
    show_bits("max", 0x7FEFFFFFFFFFFFFF)
    show_bits("min_normal", 0x0010000000000000)
    show_bits("max_subnormal", 0x000FFFFFFFFFFFFF)
    show_bits("min_subnormal", 0x0000000000000001)
    show_bits("second_subnormal", 0x0000000000000002)
    show_bits("one", 0x3FF0000000000000)
    show_bits("one_up", 0x3FF0000000000001)
    show_bits("one_down", 0x3FEFFFFFFFFFFFFF)
    show_bits("two_53", 0x4340000000000000)
    show_bits("two_53_up", 0x4340000000000001)
    show_bits("two_63", 0x43E0000000000000)
    show_bits("two_64", 0x43F0000000000000)
    show_bits("1e21", 0x444B1AE4D6E2EF50)
    show_bits("1e22", 0x4480F0CF064DD592)
    show_bits("1e23", 0x44B52D02C7E14AF6)
    show_bits("neg_zero", 0x8000000000000000)
    show_bits("zero", 0)
    show_bits("neg_max", 0xFFEFFFFFFFFFFFFF)
    show_bits("neg_min_subnormal", 0x8000000000000001)
    show_bits("pi", 0x400921FB54442D18)
    show_bits("tenth", 0x3FB999999999999A)
    show_bits("third", 0x3FD5555555555555)
}

