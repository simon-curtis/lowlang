import std/crypto/rsa
import std/text

fn check(label: str, base: str, exponent: str, modulus: str, want: str) {
    let r = rsa.mod_pow(text.decode_hex(base) or [], text.decode_hex(exponent) or [], text.decode_hex(modulus) or []) catch {
        e => {
            print("{label}: error")
            return
        }
    }
    print("{label}: {text.encode_hex(r) == want}")
}

fn rejected(label: str, base: u8[], exponent: u8[], modulus: u8[]) {
    let r = rsa.mod_pow(base, exponent, modulus) catch {
        e => {
            print("{label}: rejected")
            return
        }
    }
    print("{label}: accepted")
}

fn main() {
    check("vector 1", "555c636a71787f868e959ca3aab1b8bfc7ced5dce3eaf1f800070e151c232a31", "010001", "9f262d343b424950585f666d747b828991989fa6adb4bbc2cad1d8dfe6edf4fb", "59c52cda5d8f732609eedbc9586b026c0d5d37b8da483e59420fc7c8c7f2c4dc")
