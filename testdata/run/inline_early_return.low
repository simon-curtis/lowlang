struct Span {
    lo: i64
    hi: i64
}

fn classify(n: i64) -> i64 {
    if n < 0 {
        return -1
    }
    if n == 0 {
        return 0
    }
    if n > 100 {
        return 100
    }
    n
}

fn first_over(xs: []i64, limit: i64) -> i64 {
    for x in xs {
        if x > limit {
            return x
        }
    }
    -1
}

fn clamp_span(s: Span, lo: i64, hi: i64) -> Span {
    if s.lo > s.hi {
        return Span { lo: 0, hi: 0 }
    }
    if s.hi < lo {
        return Span { lo: lo, hi: lo }
    }
    Span { lo: s.lo, hi: s.hi }
}

fn halves(n: i64) -> i64 ! Bad {
    if n < 0 {
        fail Negative
    }
    if n == 0 {
        return 0
    }
    n / 2
}

enum Bad {
    Negative
}

fn pick(flag: bool, a: str, b: str) -> str {
    if flag {
        return a
    }
    b
}

fn search(xs: []i64, key: i64) -> i64 {
    var i = 0
    for i < xs.len {
        if xs[i] == key {
            return i
        }
        i += 1
    }
    -1
}

fn main() {
    var total = 0
    for i in -3..5 {
        total += classify(i * 40) * (i + 4)
    }
    print(total)
    let xs = [3, 9, 27, 81]
    print(first_over(xs, 10))
    print(first_over(xs, 100))
    let s = clamp_span(Span { lo: 5, hi: 2 }, 0, 10)
    print(s.lo + s.hi)
    let t = clamp_span(Span { lo: -4, hi: -2 }, 0, 10)
    print(t.lo + t.hi)
    let u = clamp_span(Span { lo: 1, hi: 8 }, 0, 10)
    print(u.lo + u.hi)
    var halved = 0
    for i in -2..6 {
        halved += halves(i) or 1000
    }
    print(halved)
    print(pick(true, "yes", "no"))
    print(pick(false, "yes", "no"))
    print(search(xs, 27))
    print(search(xs, 28))
    print(search([], 1))
}
