import std/conv
import std/math

fn float(s: str) -> str {
    let x = conv.parse_float(s) catch {
        Empty => return "empty"
        Invalid(at) => return "invalid at {at}"
        Overflow => return "overflow"
    }
    "{x}"
}

fn main() {
    for s in ["3.25", "-1e3", ".5", "1e400", "1.2.3", "e5", "inf", ""] {
        print(float(s))
    }
    print(conv.fixed(3.14159, 2))
    print(conv.fixed(1e20, 1))

    print(math.sin(math.pi() / 2.0))
    print(math.pow(2.0, 10.0))
    print(math.round(2.5))
    print(math.atan2(1.0, 1.0) * 4.0 == math.pi())
    print(math.abs(-5))
    print(math.abs(-2.5))
    print(math.max("pear", "apple"))
    print(math.min(3, -4))
    print(math.clamp(15, 0, 10))
    print(math.ipow(3, 4))
    print(math.gcd(12, -18))
    print(math.is_nan(math.nan()))
    print(math.is_inf(-math.infinity()))
}
