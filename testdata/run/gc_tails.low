fn fill(n: i64, tag: i64) -> []i64 {
    var xs: []i64 = []
    for i in 0..n {
        push(mut xs, tag * 1000 + i)
    }
    xs
}

fn worker(id: i64, out: chan[i64]) {
    var tails: [][]i64 = []
    var tags: []i64 = []
    for r in 0..2000 {
        let n = 200 + (r * 7 + id) % 60
        let xs = fill(n, r)
        if r % 3 == 0 {
            push(mut tails, xs[n - 3..])
            push(mut tags, r * 1000 + n - 3)
        }
        var junk: []i64 = []
        for k in 0..(r % 50) {
            push(mut junk, k)
        }
    }
    var bad = 0
    for i in 0..tails.len {
        let t = tails[i]
        for j in 0..3 {
            if t[j] != tags[i] + j {
                bad += 1
            }
        }
    }
    out <- bad
}

fn main() {
    let n = 24
    let out = chan[i64](n)
    for id in 0..n {
        spawn worker(id, out)
    }
    var bad = 0
    for i in 0..n {
        bad += (<-out) ?? 1000
    }
    print(bad)
}
