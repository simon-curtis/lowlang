struct Table {
    rows: str?[]
    ages: [str: i64?]
    parent: (*Table?)?
    handlers: (fn() -> i64)[]
}

fn describe(cell: str?) -> str {
    match cell {
        some(s) => "some {s}"
        none => "none"
    }
}

fn nested(v: str??) -> str {
    match v {
        some(inner) => "outer some, {describe(inner)}"
        none => "outer none"
    }
}

fn wrapped(v: (str?)?) -> str {
    nested(v)
}

fn first(cells: str?[]) -> (str?) {
    cells[0]
}

fn grow(items: *(i64[])) {
    (*items).push((*items).len)
}

fn main() {
    var cells: str?[] = []
    cells.push("a")
    cells.push(none)
    for cell in cells {
        print(describe(cell))
    }
    print(describe(first(cells)))

    let ages: [str: i64?] = [:]
    ages["ann"] = 31
    ages["bob"] = none
    print((ages["ann"] ?? none) ?? 0)
    print((ages["bob"] ?? none) ?? -1)

    let present: str?? = some("x")
    let hollow: str?? = some(none)
    let absent: str?? = none
    print(nested(present))
    print(nested(hollow))
    print(nested(absent))
    print(wrapped(some(none)))

    let counts: i64[] = []
    let shared = new(counts)
    grow(shared)
    grow(shared)
    print((*shared).len)

    var handlers: (fn() -> i64)[] = []
    handlers.push(fn() -> i64 { 7 })
    handlers.push(fn() -> i64 { 9 })
    var total = 0
    for h in handlers {
        total += h()
    }
    print(total)

    let table = Table { rows: cells, ages, parent: none, handlers }
    print(table.rows.len)
    print(table.parent == none)
}
