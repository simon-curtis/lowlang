fn overflowing(n: i64) -> i64 {
    var total = 0
    var i = 9223372036854775800
    for k in 0..n {
        total += i * 56
        total ^= i * 3
        i += 1
    }
    total
}

fn big_stride(n: i64) -> i64 {
    var total = 0
    for i in 0..n {
        total += i * 4611686018427387905
    }
    total
}

fn descending(n: i64) -> i64 {
    var total = 0
    var i = n
    for i > 0 {
        total += i * 56 + 1
        i -= 1
    }
    total
}

fn negative_step(n: i64) -> i64 {
    var total = 0
    var i = 100
    for k in 0..n {
        total += i * -7
        total += i * 56
        i += -3
    }
    total
}

fn large_step(n: i64) -> i64 {
    var total = 0
    var i = 1
    for k in 0..n {
        total += i * 13
        i += 1000003
    }
    total
}

fn two_strides(n: i64) -> i64 {
    var total = 0
    for i in 0..n {
        total += i * 24 + i * 40 - i * 24
    }
    total
}

fn offset_start(start: i64, n: i64) -> i64 {
    var total = 0
    var i = start
    for k in 0..n {
        total += i * 56
        i += 2
    }
    total
}

fn narrow(n: i64) -> i64 {
    var total = 0
    var i: i32 = 2147483600
    for k in 0..n {
        total += i64(i * 56)
        i += 3
    }
    total
}

fn unsigned_wrap(n: i64) -> i64 {
    var total = 0
    var i: u64 = 18446744073709551600
    for k in 0..n {
        total += i64(i * 56)
        i += 5
    }
    total
}

fn main() {
    print(overflowing(0))
    print(overflowing(12))
    print(big_stride(0))
    print(big_stride(9))
    print(descending(0))
    print(descending(10))
    print(negative_step(0))
    print(negative_step(40))
    print(large_step(1))
    print(large_step(30))
    print(two_strides(0))
    print(two_strides(20))
    print(offset_start(5, 0))
    print(offset_start(-9, 6))
    print(offset_start(9223372036854775800, 6))
    print(narrow(0))
    print(narrow(20))
    print(unsigned_wrap(0))
    print(unsigned_wrap(8))
}
