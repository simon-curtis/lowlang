fn helper(x: i64) -> i64 {
    x * 3 + 1
}

fn mixed(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, k: i64) -> i64 {
    let u = a + b
    let v = c * d
    let w = e - f
    let x = a ^ f
    let y = b | e
    let z = c & d
    if k > 0 {
        let h = helper(u)
        return h + v + w + x + y + z + a + b + c + d + e + f
    }
    u + v + w + x + y + z
}

fn floats(a: f64, b: f64, c: f64, k: i64) -> f64 {
    let u = a * b
    let v = b * c
    let w = c * a
    let x = u + v
    let y = v + w
    if k > 0 {
        let h = f64(helper(k))
        return h + u + v + w + x + y + a + b + c
    }
    x * y + w
}

fn main() {
    for k in -1..3 {
        print(mixed(1, 2, 3, 4, 5, 6, k))
        print(mixed(-9, 70, 3, -4, 55, 6, k))
        print(floats(1.5, 2.5, 3.5, k))
        print(floats(-0.5, 8.0, 0.25, k))
    }
}
