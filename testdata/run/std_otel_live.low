import std/os
import std/otel

fn check(label: str, ok: bool) {
    if !ok {
        print("FAIL {label}")
    }
}

fn emit(protocol: str) {
    let t = otel.tracer("lowlang/live")
    let remote = otel.SpanContext { trace_hi: 0x0102030405060708, trace_lo: 0x090a0b0c0d0e0f10, span_id: 0x1112131415161718, flags: 1, state: "vendor=x", remote: true }
    let server = t.start_with("GET /orders/:id", otel.StartOptions {
        kind: Server
        attributes: [
            otel.string("protocol", protocol), otel.int("http.response.status_code", 500), otel.boolean("cached", false),
            otel.double("ratio", 0.75), otel.blob("digest", [222, 173, 190, 239]), otel.strings("tags", ["a", "b"]),
            otel.ints("sizes", [1, 2, 3]), otel.attr("nested", Map([otel.string("k", "v"), otel.int("n", 3)])),
        ]
        links: [otel.Link { context: remote, attributes: [otel.string("link.reason", "fan-in")] }]
    })
    let outer = otel.attach(otel.current().with_span(server))
    for kind in [otel.Kind.Internal, otel.Kind.Client, otel.Kind.Producer, otel.Kind.Consumer] {
        let child = t.start_with("child", otel.StartOptions { kind })
        child.add_event("step", [otel.int("attempt", 2)])
        child.set_status(Ok)
        child.end()
    }
    let log = otel.logger("lowlang/live")
    log.error("order lookup failed", [otel.string("order.id", "42")])
    otel.detach(outer)
    log.info("not in a span", [])
    server.record_exception("LookupError", "not found")
    server.set_status(Failed("lookup failed"))
    server.end()
    let m = otel.meter("lowlang/live")
    otel.counter[i64](m, "live.orders", "{{order}}", "Orders").add(5, [otel.string("protocol", protocol)])
    otel.up_down_counter[f64](m, "live.queue", "1", "").add(-2.5, [])
    let h = otel.histogram[f64](m, "live.latency", "s", "Latency", [0.1, 1.0, 10.0])
    h.record(0.05, [])
    h.record(0.5, [])
    h.record(5.0, [])
    h.record(50.0, [])
    otel.observable_gauge(m, "live.temperature", "Cel", "", fn() -> []otel.Observation[f64] {
        [otel.Observation { value: 21.5, attributes: [otel.string("room", "a")] }]
    })
}

fn round(endpoint: str, protocol: otel.Protocol, name: str, gzip: bool) {
    let o = otel.OtlpOptions { endpoint, protocol, gzip, timeout: 5000, attempts: 2, backoff: 100 }
    using sdk = otel.install(otel.Config {
        resource: new(otel.Resource { attributes: [otel.string("service.name", "lowlang-live-{name}")] })
        span_processors: [otel.batch_span_processor(otel.otlp_span_exporter(o), otel.BatchOptions {})]
        log_processors: [otel.batch_log_processor(otel.otlp_log_exporter(o), otel.BatchOptions {})]
        metric_readers: [otel.MetricReader { exporter: otel.otlp_metric_exporter(o), interval: 0 }]
    })
    emit(name)
    check("{name} flush", sdk.force_flush())
    check("{name} shutdown", sdk.shutdown())
}

fn main() {
    let env = os.environment()
    let endpoint = env["LOWLANG_OTEL_COLLECTOR"] ?? ""
    if endpoint.len > 0 {
        round(endpoint, HttpProtobuf, "protobuf", false)
        round(endpoint, HttpJson, "json", true)
    }
    let grpc_endpoint = env["LOWLANG_OTEL_COLLECTOR_GRPC"] ?? ""
    if grpc_endpoint.len > 0 {
        round(grpc_endpoint, Grpc, "grpc", false)
        round(grpc_endpoint, Grpc, "grpc-gzip", true)
    }
}
