import std/file
import std/os
import std/sql
import std/sql/sqlite

fn show(v: sql.Value) -> str {
    match v {
        Null => "null"
        Int(n) => "{n}"
        Float(x) => "{x}"
        Text(s) => "'{s}'"
        Bytes(b) => "{b.len} bytes"
        _ => "other"
    }
}

fn describe(e: sql.Error) -> str {
    match e {
        Server(code, message) => "server {code}: {message}"
        Busy => "busy"
        Closed => "closed"
        Conversion => "conversion"
        _ => "other"
    }
}

fn run(dir: str) ! sql.Error {
    let path = "{dir}/app.db"
    using db = sqlite.open(path)?
    sqlite.exec(db, "CREATE TABLE jobs (id INTEGER PRIMARY KEY, name TEXT UNIQUE, score REAL, data BLOB); CREATE INDEX jobs_score ON jobs(score)")?

    let insert = "INSERT INTO jobs (name, score, data) VALUES (?, ?, ?)"
    sqlite.begin_immediate(db)?
    for i in 0..5 {
        sqlite.execute(db, insert, [Text("job {i}"), Float(f64(i) * 1.5), Bytes(bytes("x{i}"))])?
    }
    sqlite.commit(db)?
    print(sqlite.last_insert_id(db))

    print(sqlite.execute(db, "INSERT OR IGNORE INTO jobs (name, score, data) VALUES (?, ?, ?)", [Text("job 1"), Float(9.0), Null])?)
    print(sqlite.execute(db, "INSERT OR REPLACE INTO jobs (id, name, score, data) VALUES (?, ?, ?, ?)", [Int(2), Text("job one"), Null, Bytes([])])?)

    let rows = sqlite.query(db, "SELECT id, name, score, data FROM jobs WHERE id <= ? ORDER BY id", [Int(3)])?
    var names: []str = []
    for c in rows.columns {
        push(mut names, "{c.name}:{c.kind}")
    }
    print(names.len)
    for r in rows.rows {
        print("{show(r[0])} {show(r[1])} {show(r[2])} {show(r[3])}")
    }

    var seen = 0
    sqlite.each(db, "SELECT name FROM jobs ORDER BY id", [], fn(cols: []sql.Column, values: []sql.Value) -> bool {
        seen += 1
        seen < 2
    })?
    print(seen)

    sqlite.begin(db)?
    sqlite.execute(db, "DELETE FROM jobs", [])?
    sqlite.rollback(db)?
    print(sqlite.query(db, "SELECT count(*) FROM jobs", [])?.rows[0][0] |> show)

    let attempts: [][]sql.Value = [[Text("job 0"), Float(1.0), Null], [Text("too few")]]
    for values in attempts {
        let changed = sqlite.execute(db, insert, values) catch {
            e => {
                print(describe(e))
                0
            }
        }
        print(changed)
    }

    let copy = "{dir}/copy.db"
    sqlite.backup(db, copy)?
    using restored = sqlite.open(copy)?
    print(sqlite.query(restored, "SELECT count(*) FROM jobs", [])?.rows[0][0] |> show)
    sqlite.close(restored)

    using conn = sqlite.connection(db)
    print(sql.placeholder(conn.handle.dialect, 0))
    let n = conn.handle.execute("UPDATE jobs SET score = score + 1 WHERE score > ?1", [Float(2.0)])?
    print(n)
    conn.handle.close()
    print(sqlite.query(db, "SELECT count(*) FROM jobs", [])?.rows[0][0] |> show)
    sqlite.close(db)
    let after = sqlite.query(db, "SELECT 1", []) catch {
        e => {
            print(describe(e))
            sql.Rows { columns: [], rows: [] }
        }
    }
    print(after.rows.len)
    sqlite.close(db)
    print(sqlite.last_insert_id(db))
    closed(db, conn)
    scoped(dir)?
}

fn refused(label: str, work: fn() ! sql.Error) {
    work() catch {
        e => {
            print("{label} {describe(e)}")
            return
        }
    }
    print("{label} ok")
}

fn closed(db: sqlite.Database, conn: sql.Connection) {
    let h = conn.handle
    sqlite.exec(db, "SELECT 1") catch {
        e => print("exec {describe(e)}")
    }
    sqlite.query(db, "SELECT 1", []) catch {
        e => {
            print("query {describe(e)}")
            sql.Rows { columns: [], rows: [] }
        }
    }
    sqlite.execute(db, "DELETE FROM jobs", []) catch {
        e => {
            print("execute {describe(e)}")
            0
        }
    }
    sqlite.each(db, "SELECT 1", [], fn(cols: []sql.Column, values: []sql.Value) -> bool { true }) catch {
        e => print("each {describe(e)}")
    }
    sqlite.begin(db) catch {
        e => print("begin {describe(e)}")
    }
    sqlite.begin_immediate(db) catch {
        e => print("begin immediate {describe(e)}")
    }
    sqlite.commit(db) catch {
        e => print("commit {describe(e)}")
    }
    sqlite.rollback(db) catch {
        e => print("rollback {describe(e)}")
    }
    sqlite.backup(db, "/tmp/low-std-sqlite-closed.db") catch {
        e => print("backup {describe(e)}")
    }
    refused("connection query", fn() ! sql.Error { h.query("SELECT 1", [])? })
    refused("connection execute", fn() ! sql.Error { h.execute("DELETE FROM jobs", [])? })
    refused("connection begin", fn() ! sql.Error { h.begin()? })
}

fn leaked(path: str) -> sql.ConnectionHandle ! sql.Error {
    using owner = sqlite.connect(sql.Options { database: path })?
    let h = owner.handle
    h.execute("CREATE TABLE IF NOT EXISTS t (n INTEGER)", [])?
    h
}

fn scoped(dir: str) ! sql.Error {
    let h = leaked("{dir}/scoped.db")?
    refused("after scope exit", fn() ! sql.Error { h.query("SELECT 1", [])? })
    h.close()
    refused("after scope exit and close", fn() ! sql.Error { h.execute("DELETE FROM t", [])? })
}

fn main() {
    let dir = "/tmp/low-std-sqlite-{os.pid()}"
    file.mkdir(dir) or print("cannot make {dir}")
    run(dir) catch {
        e => print("failed: {describe(e)}")
    }
    file.remove_all(dir) or print("cannot remove {dir}")
}
