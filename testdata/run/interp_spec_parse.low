struct Point {
    x: i64
    y: i64
}

fn pick(a: i64, b: i64) -> i64 {
    a * 10 + b
}

fn main() {
    let age = 36
    let flag = true
    let nums = [7, 8, 9]
    let p = Point { x: 4, y: 5 }
    print("[{pick(1, 2),6}]")
    print("[{pick(3, 4):d5}]")
    print("[{nums[1],4:x3}]")
    print("[{Point { x: 1, y: 2 }.y,3}]")
    print("[{if flag { 1 } else { 2 },3}]")
    print("[{p.x + p.y,-5:b}]")
    print("[{"a,b:c",9}]")
    print("[{',',3}]")
    print("[{':',3:x}]")
    print("[{"x{age,4}y",9}]")
    print("{{{age,4}}}")
    print("{{}}{age:d4}{{}}")
    print("[{[pick(1, 2), pick(3, 4)],-12}]")
    print("[{age,3}{age,3}{age:x}{age,3}]")
    print("{age}{age,2}{age:d}{age,2:d}")
    let f = fn(a: i64, b: i64) -> i64 { a - b }
    print("[{f(10, 4),4:d2}]")
}
