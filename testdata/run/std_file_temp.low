import std/file
import std/io
import std/text

fn permissions(path: str) -> str {
    let info = file.stat(path) catch {
        _ => return "missing"
    }
    text.radix(info.mode & 0o777, 8)
}

fn base(path: str) -> str {
    path[text.last_index_byte(path, '/') + 1..]
}

fn alphanumeric(s: str) -> bool {
    for i in 0..s.len {
        let c = s[i]
        let digit = c >= '0' && c <= '9'
        let lower = c >= 'a' && c <= 'z'
        if !digit && !lower {
            return false
        }
    }
    true
}

fn shape(path: str, prefix: str, suffix: str) -> str {
    let name = base(path)
    let middle = name[prefix.len..name.len - suffix.len]
    let framed = text.starts_with(name, prefix) && text.ends_with(name, suffix)
    "{name.len} {framed} {middle.len} {alphanumeric(middle)}"
}

fn patterns(dir: str) ! io.Error {
    using plain = file.temp_file(dir, "plain")?
    print("append {shape(plain.path, "plain", "")} {permissions(plain.path)}")

    using star = file.temp_file(dir, "log-*.txt")?
    print("star {shape(star.path, "log-", ".txt")} {permissions(star.path)}")

    using lead = file.temp_file(dir, "*.tmp")?
    print("lead {shape(lead.path, "", ".tmp")}")

    using two = file.temp_file(dir, "a*b*c")?
    print("last {shape(two.path, "a*b", "c")}")

    using bare = file.temp_file(dir, "")?
    print("empty {shape(bare.path, "", "")}")

    print("dir {text.starts_with(star.path, "{dir}/")}")
}

fn uniqueness(dir: str) ! io.Error {
    var paths: [str: bool] = [:]
    for _ in 0..40 {
        using t = file.temp_file(dir, "u-*")?
        paths[t.path] = true
        file.write_str(t.file, "x")?
        file.sync(t.file)?
    }
    print("unique {paths.len}")
    print("left {file.list(dir)?.len}")
}

fn content(dir: str) ! io.Error {
    using t = file.temp_file(dir, "c-*")?
    file.write_str(t.file, "hello")?
    file.write_str(t.file, " world")?
    let info = file.info(t.file)?
    print("size {info.size} regular {info.regular} {permissions(t.path)}")
    let start = file.seek(t.file, 0, Start)?
    print("seek {start}")
    let buf = io.buffer(32)
    let n = file.read(t.file, buf)?
    print("read {str(buf[..n])}")
    print("text {file.read_text(t.path)?}")
}

fn cleanup(dir: str) ! io.Error {
    var gone = ""
    var view: file.FileHandle? = none
    {
        using t = file.temp_file(dir, "drop-*")?
        gone = t.path
        view = some(t.file.handle)
        print("alive {file.exists(gone)}")
    }
    print("dropped {file.exists(gone)}")
    match view {
        some(h) => print("closed {write_failed(h)}")
        none => {}
    }

    var kept = ""
    {
        using var t = file.temp_file(dir, "keep-*")?
        file.write_str(t.file, "kept")?
        kept = file.keep(mut t)
    }
    print("kept {file.exists(kept)} {file.read_text(kept)?}")
    file.remove(kept)?

    var moved = ""
    {
        using t = file.temp_file(dir, "move-*")?
        file.write_str(t.file, "renamed")?
        moved = "{t.path}.final"
        file.rename(t.path, moved)?
    }
    print("renamed {file.exists(moved)} {file.read_text(moved)?}")
    file.remove(moved)?
}

fn write_failed(h: file.FileHandle) -> bool {
    file.write_on(h, bytes("x")) catch {
        e => return e == io.Error.NotConnected
    }
    false
}

fn directories(dir: str) ! io.Error {
    let a = file.temp_dir_pattern(dir, "d-*-x")?
    let b = file.temp_dir_pattern(dir, "d-*-x")?
    let c = file.temp_dir_pattern(dir, "plain")?
    print("dirs {shape(a, "d-", "-x")} {permissions(a)} {a != b} {file.is_dir(a)}")
    print("plain {shape(c, "plain", "")} {permissions(c)}")
    file.remove_dir(a)?
    file.remove_dir(b)?
    file.remove_dir(c)?
}

fn rejects(dir: str) {
    using t = file.temp_file(dir, "bad/name") catch {
        e => return print("slash {e == io.Error.Invalid}")
    }
    print("slash accepted")
}

fn missing_dir(dir: str) {
    using t = file.temp_file("{dir}/absent", "x-*") catch {
        e => return print("absent {e == io.Error.NotFound}")
    }
    print("absent accepted")
}

fn trailing_slash(dir: str) ! io.Error {
    using t = file.temp_file("{dir}/", "slash-*")?
    print("slashdir {text.starts_with(t.path, "{dir}/slash-")} {t.path.len - dir.len}")
}

fn default_dir() ! io.Error {
    using t = file.temp_file("", "low-std-temp-default-*")?
    print("default {text.starts_with(t.path, "/tmp/low-std-temp-default-")}")
}

fn run(dir: str) ! io.Error {
    patterns(dir)?
    uniqueness(dir)?
    content(dir)?
    cleanup(dir)?
    directories(dir)?
    rejects(dir)
    missing_dir(dir)
    trailing_slash(dir)?
    default_dir()?
    print("left {file.list(dir)?.len}")
}

fn main() {
    let dir = file.temp_dir("low-std-temp-") catch {
        _ => return print("no temp dir")
    }
    run(dir) catch {
        e => print("failed")
    }
    file.remove_all(dir) catch {
        _ => print("cannot remove {dir}")
    }
}
