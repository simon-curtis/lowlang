import std/cancel
import std/time/clock
import std/time/duration
import std/time/timestamp

fn show(ts: timestamp.Timestamp) -> str {
    timestamp.to_string(ts)
}

fn show_duration(d: duration.Duration) -> str {
    "{duration.whole_seconds(d)}/{duration.subsec_nanos(d)}"
}

fn start() -> timestamp.Timestamp {
    timestamp.parse("2026-11-11T10:00:00Z") or timestamp.epoch()
}

fn fixed_clock() {
    let c = clock.fixed(start())
    let first = clock.now(c)
    let second = c.read()
    print("fixed {show(first)} {show(second)} {timestamp.equal(first, second)}")
    print("fixed elapsed {show_duration(clock.elapsed_since(c, duration.zero()))} {show_duration(c.monotonic())}")
}

fn manual_clock() {
    let m = clock.manual(start())
    let c = m.clock()
    let began = c.monotonic()
    print("manual start {show(clock.now(c))} {show_duration(began)}")
    m.advance(duration.milliseconds(1500))
    print("manual advanced {show(clock.now(c))} {show_duration(c.monotonic())} {show_duration(clock.elapsed_since(c, began))}")
    m.advance(duration.milliseconds(-500))
    print("manual back {show(clock.now(c))} {show_duration(c.monotonic())}")
    let target = timestamp.parse("2030-01-01T00:00:00.25Z") or timestamp.epoch()
    m.set(target)
    print("manual set {show(clock.now(c))} {show_duration(c.monotonic())}")
    m.advance(duration.hours(24))
    print("manual day {show(clock.now(c))} {show_duration(c.monotonic())}")
    let later = clock.clock(m)
    m.advance(duration.nanoseconds(1))
    print("manual shared {show(clock.now(c))} {show(clock.now(later))} {show_duration(clock.elapsed_since(later, began))}")
    let other = clock.manual(timestamp.epoch())
    other.advance(duration.seconds(5))
    print("manual separate {show(clock.now(other.clock()))} {show(clock.now(c))}")
}

fn bump(m: clock.Manual, times: i64, done: chan[bool]) {
    for i in 0..times {
        m.advance(duration.nanoseconds(1))
    }
    done <- true
}

fn manual_threads() {
    let m = clock.manual(timestamp.epoch())
    let c = m.clock()
    let done = chan[bool](8)
    for i in 0..8 {
        spawn bump(m, 2000, done)
    }
    for i in 0..8 {
        <-done
    }
    print("manual threads {show(clock.now(c))} {show_duration(c.monotonic())}")
}

fn system_clock() {
    let c = clock.system()
    let first = clock.now(c)
    let mono = c.monotonic()
    let after_2020 = timestamp.after(first, timestamp.from_unix(1577836800) or timestamp.epoch())
    let before_2200 = timestamp.before(first, timestamp.from_unix(7258118400) or timestamp.epoch())
    let second = clock.now(c)
    let later = c.monotonic()
    print("system {after_2020} {before_2200} {!timestamp.before(second, first)} {!duration.before(later, mono)}")
    let spent = clock.elapsed_since(c, mono)
    print("system elapsed {!duration.is_negative(spent)}")
}

fn show_sleeps(m: clock.Manual) -> str {
    var row = ""
    for d in clock.sleeps(m) {
        row = "{row} {show_duration(d)}"
    }
    row
}

fn sleeping() {
    let m = clock.manual(start())
    let c = m.clock()
    c.sleep(none, duration.milliseconds(1500))
    c.sleep(none, duration.zero())
    c.sleep(none, duration.seconds(-1))
    print("manual sleep {show(clock.now(c))} {show_duration(c.monotonic())} sleeps{show_sleeps(m)}")
    let t = cancel.token()
    cancel.cancel(t)
    c.sleep(some(t), duration.seconds(10))
    print("manual cancelled sleep {show(clock.now(c))} sleeps{show_sleeps(m)}")

    let frozen = clock.fixed(start())
    frozen.sleep(none, duration.milliseconds(2))
    print("fixed sleep {show(clock.now(frozen))} {show_duration(frozen.monotonic())}")

    let real = clock.system()
    let began = real.monotonic()
    real.sleep(none, duration.milliseconds(3))
    let gap = clock.elapsed_since(real, began)
    print("system sleep {!duration.before(gap, duration.milliseconds(3))}")
    let stop = cancel.token()
    spawn fn() {
        sleep(10)
        cancel.cancel(stop)
    }()
    let before = real.monotonic()
    real.sleep(some(stop), duration.seconds(30))
    let woken = clock.elapsed_since(real, before)
    print("system cancelled sleep {duration.before(woken, duration.seconds(30))}")
}

fn main() {
    fixed_clock()
    manual_clock()
    manual_threads()
    system_clock()
    sleeping()
}
