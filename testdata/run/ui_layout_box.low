import std/ui/geometry
import std/ui/layout

fn show(name: str, r: geometry.Rect) {
    print("{name} {r.x} {r.y} {r.width} {r.height}")
}

fn dump(t: layout.Tree, names: []str) {
    for i, name in names {
        show(name, layout.rect(t, i))
    }
}

fn win(w: f32, h: f32) -> geometry.Size {
    geometry.size(w, h)
}

fn wide(w: f32) -> layout.Style {
    layout.Style { width: Px(w) }
}

fn boxed(w: f32, h: f32) -> layout.Style {
    layout.Style { width: Px(w), height: Px(h) }
}

fn frames() {
    print("padding border margin")
    var t = layout.tree()
    let a = t.node(layout.Style {
        width: Px(50.0)
        margin: geometry.Edges { top: 3.0, right: 4.0, bottom: 5.0, left: 6.0 }
        padding: geometry.edges(5.0)
        border: geometry.edges(1.0)
    }, [])
    let b = t.node(wide(30.0), [])
    let root = t.node(layout.Style { padding: geometry.edges(10.0), border: geometry.edges(2.0) }, [a, b])
    t.compute(root, win(200.0, 100.0))
    dump(t, ["a", "b", "root"])
    show("a content", layout.content(t, a))
    show("root content", layout.content(t, root))

    print("frame floor")
    var u = layout.tree()
    let narrow = u.node(layout.Style { width: Px(8.0), padding: geometry.edges(10.0) }, [])
    let hollow = u.node(layout.Style { padding: geometry.edges(5.0), border: geometry.edges(1.0) }, [])
    let top = u.node(layout.Style { align_items: Start }, [narrow, hollow])
    u.compute(top, win(100.0, 50.0))
    dump(u, ["narrow", "hollow", "top"])
}

fn gaps() {
    print("gap row")
    var t = layout.tree()
    let a = t.node(wide(30.0), [])
    let b = t.node(wide(30.0), [])
    let c = t.node(wide(30.0), [])
    let root = t.node(layout.Style { gap: 10.0 }, [a, b, c])
    t.compute(root, win(200.0, 10.0))
    dump(t, ["a", "b", "c", "root"])

    print("gap column")
    var u = layout.tree()
    let d = u.node(layout.Style { height: Px(20.0) }, [])
    let e = u.node(layout.Style { height: Px(20.0) }, [])
    let f = u.node(layout.Style { height: Px(20.0) }, [])
    let column = u.node(layout.Style { direction: Column, gap: 10.0 }, [d, e, f])
    u.compute(column, win(50.0, 200.0))
    dump(u, ["d", "e", "f", "column"])
}

fn justified(j: layout.Justify, column: bool, count: i64, item: f32, room: f32, gap: f32) {
    var t = layout.tree()
    var kids: []i64 = []
    for i in 0..count {
        push(mut kids, t.node(if column { boxed(10.0, item) } else { boxed(item, 10.0) }, []))
    }
    let direction = if column { layout.Direction.Column } else { layout.Direction.Row }
    let root = t.node(layout.Style { direction, justify: j, gap }, kids)
    t.compute(root, if column { win(10.0, room) } else { win(room, 10.0) })
    var line = "{j} {count} x {item} in {room} gap {gap}:"
    for k in kids {
        let r = layout.rect(t, k)
        line = "{line} {if column { r.y } else { r.x }}"
    }
    print(line)
}

fn justifies() {
    let all = [layout.Justify.Start, layout.Justify.End, layout.Justify.Center, layout.Justify.SpaceBetween, layout.Justify.SpaceAround, layout.Justify.SpaceEvenly]
    print("justify three items")
    for j in all {
        justified(j, false, 3, 10.0, 90.0, 0.0)
    }
    print("justify three items with gap")
    for j in all {
        justified(j, false, 3, 30.0, 200.0, 10.0)
    }
    print("justify one item")
    for j in all {
        justified(j, false, 1, 30.0, 90.0, 0.0)
    }
    print("justify column")
    for j in all {
        justified(j, true, 3, 10.0, 90.0, 0.0)
    }
}

fn aligned(name: str, direction: layout.Direction, items: layout.Align, child: layout.Style) {
    var t = layout.tree()
    let c = t.node(child, [])
    let root = t.node(layout.Style { direction, align_items: items }, [c])
    t.compute(root, win(100.0, 100.0))
    show(name, layout.rect(t, c))
}

fn aligns() {
    print("align row")
    aligned("start", Row, Start, boxed(10.0, 20.0))
    aligned("end", Row, End, boxed(10.0, 20.0))
    aligned("center", Row, Center, boxed(10.0, 20.0))
    aligned("stretch explicit", Row, Stretch, boxed(10.0, 20.0))
    aligned("stretch auto", Row, Stretch, wide(10.0))
    aligned("start auto", Row, Start, wide(10.0))
    aligned("stretch max", Row, Stretch, layout.Style { width: Px(10.0), max_height: Px(60.0) })
    aligned("stretch margins", Row, Stretch, layout.Style { width: Px(10.0), margin: geometry.Edges { top: 10.0, bottom: 20.0 } })
    aligned("center margin", Row, Center, layout.Style { width: Px(10.0), height: Px(20.0), margin: geometry.Edges { top: 10.0 } })
    aligned("end margin", Row, End, layout.Style { width: Px(10.0), height: Px(20.0), margin: geometry.Edges { bottom: 5.0 } })
    aligned("start margin", Row, Start, layout.Style { width: Px(10.0), height: Px(20.0), margin: geometry.Edges { top: 7.0 } })
    aligned("center overflow", Row, Center, boxed(10.0, 140.0))

    print("align column")
    aligned("start", Column, Start, boxed(30.0, 10.0))
    aligned("end", Column, End, boxed(30.0, 10.0))
    aligned("center", Column, Center, boxed(30.0, 10.0))
    aligned("stretch auto", Column, Stretch, layout.Style { height: Px(10.0) })
    aligned("end margin", Column, End, layout.Style { width: Px(30.0), height: Px(10.0), margin: geometry.Edges { right: 6.0 } })

    print("align self")
    var t = layout.tree()
    let a = t.node(boxed(10.0, 20.0), [])
    let b = t.node(layout.Style { width: Px(10.0), height: Px(20.0), align_self: End }, [])
    let c = t.node(layout.Style { width: Px(10.0), height: Px(20.0), align_self: Start }, [])
    let d = t.node(layout.Style { width: Px(10.0), align_self: Stretch }, [])
    let root = t.node(layout.Style { align_items: Center }, [a, b, c, d])
    t.compute(root, win(100.0, 100.0))
    dump(t, ["a", "b", "c", "d"])

    print("align self over start")
    var u = layout.tree()
    let e = u.node(layout.Style { width: Px(10.0), height: Px(20.0), align_self: Center }, [])
    let f = u.node(layout.Style { width: Px(10.0) }, [])
    let top = u.node(layout.Style { align_items: Start }, [e, f])
    u.compute(top, win(100.0, 100.0))
    dump(u, ["e", "f"])
}

fn percents() {
    print("percent")
    var t = layout.tree()
    let a = t.node(layout.Style { width: Percent(50.0), height: Percent(50.0) }, [])
    let b = t.node(layout.Style { width: Percent(25.0) }, [])
    let root = t.node(layout.Style {}, [a, b])
    t.compute(root, win(200.0, 100.0))
    dump(t, ["a", "b", "root"])

    print("percent inside padding")
    var u = layout.tree()
    let c = u.node(layout.Style { width: Percent(50.0), height: Percent(50.0) }, [])
    let d = u.node(layout.Style { width: Percent(25.0) }, [])
    let padded = u.node(layout.Style { padding: geometry.edges(10.0) }, [c, d])
    u.compute(padded, win(200.0, 100.0))
    dump(u, ["c", "d", "padded"])

    print("percent in a column")
    var v = layout.tree()
    let e = v.node(layout.Style { height: Percent(25.0) }, [])
    let f = v.node(layout.Style { grow: 1.0 }, [])
    let column = v.node(layout.Style { direction: Column }, [e, f])
    v.compute(column, win(100.0, 200.0))
    dump(v, ["e", "f", "column"])

    print("percent width of a column child")
    var w = layout.tree()
    let g = w.node(layout.Style { width: Percent(50.0), height: Px(10.0) }, [])
    let h = w.node(layout.Style { direction: Column, align_items: End }, [g])
    w.compute(h, win(200.0, 100.0))
    dump(w, ["g", "h"])
}

fn main() {
    frames()
    gaps()
    justifies()
    aligns()
    percents()
}
