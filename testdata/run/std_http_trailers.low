import std/http
import std/io
import std/net

fn chunked_once(l: net.ListenerHandle) {
    let h = net.accept_handle(l) catch {
        _ => return
    }
    using c = net.adopt(h)
    let s = net.stream(c)
    let r = io.reader(s)
    for {
        let line = io.read_line(r) catch {
            _ => return
        }
        if line.len == 0 {
            break
        }
    }
    io.write_str(s, "HTTP/1.1 200 OK\r\ntransfer-encoding: chunked\r\ntrailer: x-checksum\r\nconnection: close\r\n\r\n5\r\nhello\r\n0\r\nx-checksum: abc\r\n\r\n") catch {
        _ => {}
    }
    net.close(c)
}

fn h2_server(l: net.ListenerHandle) {
    http.serve_on(l, fn(req: http.Request) -> http.Response {
        if req.path == "/only" {
            return http.Response { status: 200, headers: [http.Header { name: "grpc-status", value: "14" }], body: [] }
        }
        if req.path == "/empty" {
            return http.Response { status: 200, headers: [], body: [], trailers: [http.Header { name: "x-done", value: "yes" }] }
        }
        http.Response { status: 200, headers: [], body: bytes("payload"), trailers: [http.Header { name: "X-Sum", value: "7" }, http.Header { name: "connection", value: "drop me" }] }
    }) catch {
        _ => {}
    }
}

fn show(label: str, r: http.Response) {
    var parts: []str = []
    for h in r.trailers {
        push(mut parts, "{h.name}={h.value}")
    }
    let only = http.header(r.headers, "grpc-status") ?? "-"
    print("{label} {r.status} body={r.text()} h2={r.version == Http2} trailers=[{parts.len}] {if parts.len > 0 { parts[0] } else { "" }} header-status={only}")
}

fn fetch(c: *http.Client, label: str, url: str) {
    let r = c.get(url) catch {
        _ => {
            print("{label} failed")
            return
        }
    }
    show(label, r)
}

fn main() ! io.Error {
    using plain = net.listen("127.0.0.1", 0)?
    spawn chunked_once(plain.handle)
    let c = http.client().build()
    fetch(c, "chunked", "http://127.0.0.1:{plain.handle.addr.port}/")
    using l = net.listen("127.0.0.1", 0)?
    spawn h2_server(l.handle)
    let h2c = http.client().with_prior_knowledge(true).build()
    let base = "http://127.0.0.1:{l.handle.addr.port}"
    fetch(h2c, "h2c body", "{base}/body")
    fetch(h2c, "h2c empty", "{base}/empty")
    fetch(h2c, "h2c trailers-only", "{base}/only")
    fetch(c, "h1 ignores", "{base}/body")
}
