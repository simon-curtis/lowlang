import std/io
import std/net
import std/pipe
import std/text

fn produce_lines(w: pipe.Writer, count: i64) {
    for i in 0..count {
        let line = bytes("line {i}\n")
        let memory = pipe.get_memory(w, line.len)
        pipe.advance(w, io.copy(memory, line))
        if i % 7 == 0 {
            pipe.flush(w)
        }
    }
    pipe.complete_writer(w)
}

fn consume_lines(r: pipe.Reader) -> i64 {
    var total = 0
    var lines = 0
    for {
        let result = pipe.read(r) catch {
            _ => return -1
        }
        let reader = pipe.sequence_reader(result.buffer)
        for {
            let line = match pipe.read_line(reader) {
                some(x) => x
                none => break
            }
            let digits = str(pipe.to_bytes(line))[5..]
            total += text.parse_int(digits) catch 0
            lines += 1
        }
        pipe.advance_to(r, pipe.consumed(reader), result.buffer.end)
        if result.completed {
            break
        }
    }
    print("lines {lines}")
    total
}

fn produce_frames(w: pipe.Writer) {
    for i in 1..40 {
        var frame: []u8 = []
        io.put_be16(mut frame, i)
        for _ in 0..i {
            push(mut frame, u8(i))
        }
        var at = 0
        for at < frame.len {
            let step = if frame.len - at < 3 { frame.len - at } else { 3 }
            pipe.write(w, frame[at..at + step])
            pipe.flush(w)
            at += step
        }
    }
    pipe.complete_writer(w)
}

fn consume_frames(r: pipe.Reader) {
    var frames = 0
    var bytes_seen = 0
    for {
        let result = pipe.read(r) catch {
            _ => return
        }
        let reader = pipe.sequence_reader(result.buffer)
        for {
            let start = pipe.consumed(reader)
            let size = match pipe.read_be(reader, 2) {
                some(x) => x
                none => break
            }
            let body = pipe.read_exact(reader, i64(size))
            match body {
                some(b) => {
                    frames += 1
                    bytes_seen += pipe.length(b)
                }
                none => {
                    pipe.advance_to(r, start, result.buffer.end)
                    break
                }
            }
        }
        if pipe.remaining(reader) == 0 {
            pipe.advance_to(r, pipe.consumed(reader), result.buffer.end)
        }
        if result.completed {
            break
        }
    }
    print("frames {frames} bytes {bytes_seen}")
}

fn echo(c: net.Conn) {
    let d = pipe.duplex(net.stream(c), pipe.Options {})
    for {
        let result = pipe.read(d.input) catch {
            _ => break
        }
        let reader = pipe.sequence_reader(result.buffer)
        for {
            let line = match pipe.read_line(reader) {
                some(x) => x
                none => break
            }
            pipe.write(d.output, bytes(text.lower(str(pipe.to_bytes(line)))))
            pipe.write(d.output, bytes("\n"))
        }
        pipe.flush(d.output)
        pipe.advance_to(d.input, pipe.consumed(reader), result.buffer.end)
        if result.completed {
            break
        }
    }
    pipe.complete_writer(d.output)
}

fn main() ! io.Error {
    let lines = pipe.pipe(pipe.Options { pause: 256, resume: 128, segment_size: 64 })
    spawn produce_lines(lines.writer, 5000)
    print("sum {consume_lines(lines.reader)}")

    let frames = pipe.pipe(pipe.Options { pause: 64, resume: 16, segment_size: 16 })
    spawn produce_frames(frames.writer)
    consume_frames(frames.reader)

    echo_test()?

    let idle = pipe.pipe(pipe.Options {})
    spawn fn() {
        sleep(20)
        pipe.cancel_pending_read(idle.reader)
    }()
    let canceled = pipe.read(idle.reader)?
    print("canceled {canceled.canceled} {pipe.length(canceled.buffer)}")
    pipe.fail_writer(idle.writer, Refused)
    let failed = pipe.read(idle.reader) catch {
        Refused => {
            print("failed with Refused")
            return
        }
        _ => return
    }
    print(failed.completed)
}

fn echo_test() ! io.Error {
    let l = net.listen("127.0.0.1", 0)?
    let client = net.connect(l.addr)?
    let server = net.accept(l)?
    spawn echo(server)
    net.write_all(client, bytes("Hello\nWORLD\npartial"))?
    net.write_all(client, bytes(" LINE\n"))?
    net.shutdown_write(client)?
    print(str(io.read_all(net.stream(client))?))
    net.close(client)
}
