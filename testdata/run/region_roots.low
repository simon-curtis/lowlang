struct Keep {
    id: i64
    data: []i64
}

fn churn(rounds: i64, done: chan[i64]) {
    var total = 0
    for r in 0..rounds {
        var xs: []i64 = []
        for i in 0..4000 {
            push(mut xs, i + r)
        }
        total += xs.len
    }
    done <- total
}

fn fill(n: i64) -> []i64 {
    var xs: []i64 = []
    for i in 0..n {
        push(mut xs, i * 3)
    }
    xs
}

fn pool() -> []*Keep {
    var out: []*Keep = []
    for i in 0..50 {
        push(mut out, new(Keep { id: i, data: fill(100 + i) }))
    }
    out
}

fn main() {
    let done = chan[i64]()
    spawn churn(3000, done)
    var check = 0
    for round in 0..20 {
        var outside = pool()
        let sum = region {
            var held: []*Keep = []
            for p in outside {
                push(mut held, p)
            }
            outside = []
            var spin = 0
            for k in 0..200000 {
                spin += k % 3
            }
            sleep(1)
            var s = 0
            for h in held {
                var inner = 0
                for v in h.data {
                    inner += v
                }
                s += inner + h.id
            }
            s + spin % 2
        }
        check += sum % 1000
    }
    print(check)
    print((<-done) ?? 0)
}
