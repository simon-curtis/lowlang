import std/simd

struct Pair {
    a: u32x8
    tag: i64
}

fn twice(v: u32x8) -> u32x8 {
    v + v
}

fn main() {
    let base: u32x8 = simd.splat(u32(3))
    let p = Pair { a: twice(base), tag: 7 }
    var list: []Pair = [p]
    push(mut list, Pair { a: list[0].a * 2, tag: 8 })
    let total = twice(list[1].a) + p.a
    let first: u32 = simd.lane(total, 0)
    let last: u32 = simd.lane(total, 7)
    print(first)
    print(last)
    print(list[1].tag)
}
