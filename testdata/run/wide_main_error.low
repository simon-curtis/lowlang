struct Pad8 {
    a: i64 = 0
    b: i64 = 0
    c: i64 = 0
    d: i64 = 0
    e: i64 = 0
    f: i64 = 0
    g: i64 = 0
    h: i64 = 0
}

struct Pad64 {
    a: Pad8 = Pad8 {}
    b: Pad8 = Pad8 {}
    c: Pad8 = Pad8 {}
    d: Pad8 = Pad8 {}
    e: Pad8 = Pad8 {}
    f: Pad8 = Pad8 {}
    g: Pad8 = Pad8 {}
    h: Pad8 = Pad8 {}
}

struct Pad512 {
    a: Pad64 = Pad64 {}
    b: Pad64 = Pad64 {}
    c: Pad64 = Pad64 {}
    d: Pad64 = Pad64 {}
    e: Pad64 = Pad64 {}
    f: Pad64 = Pad64 {}
    g: Pad64 = Pad64 {}
    h: Pad64 = Pad64 {}
}

struct Pad4096 {
    a: Pad512 = Pad512 {}
    b: Pad512 = Pad512 {}
    c: Pad512 = Pad512 {}
    d: Pad512 = Pad512 {}
    e: Pad512 = Pad512 {}
    f: Pad512 = Pad512 {}
    g: Pad512 = Pad512 {}
    h: Pad512 = Pad512 {}
}

enum Refusal {
    Negative
    Wide(pad: Pad4096)
}

fn main() ! Refusal {
    print(1)
    fail Wide(Pad4096 {})
}
