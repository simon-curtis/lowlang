extern "c" {
    fn pipe(fds: ptr[i32]) -> i32
    fn write(fd: i32, buf: ptr, n: i64) -> i64
    fn read(fd: i32, buf: ptr, n: i64) -> i64
    fn malloc(n: i64) -> ptr
    fn free(p: ptr)
    fn qsort(base: ptr, n: i64, size: i64, compare: extern fn(ptr[i64], ptr[i64]) -> i32)
}

struct Node {
    value: i64
    next: *Node?
}

fn churning(a: ptr[i64], b: ptr[i64]) -> i32 {
    var junk: *Node? = none
    for i in 0..200 {
        junk = new(Node { value: i, next: junk })
    }
    let x = load(a)
    let y = load(b)
    if x < y {
        return -1
    }
    if x > y {
        return 1
    }
    0
}

fn sorter(seed: i64, out: chan[i64]) {
    let n = 200
    let data: ptr[i64] = malloc(8 * n)
    let values = view(data, n)
    for i in 0..n {
        values[i] = (i * 7919 + seed) % n
    }
    qsort(data, n, 8, churning)
    var ok = 1
    for i in 1..n {
        if values[i - 1] > values[i] {
            ok = 0
        }
    }
    free(data)
    out <- ok
}

fn reader(fd: i32, out: chan[str]) {
    let buf: ptr[u8] = malloc(64)
    wait_readable(i64(fd))
    let n = read(fd, buf, 64)
    out <- str(view(buf, n))
    free(buf)
}

fn main() {
    let results = chan[i64](16)
    for s in 0..16 {
        spawn sorter(s, results)
    }
    var good = 0
    for s in 0..16 {
        good += (<-results) ?? 0
    }
    print(good)

    let fds: ptr[i32] = malloc(8)
    pipe(fds)
    let pair = view(fds, 2)
    let got = chan[str]()
    spawn reader(pair[0], got)
    sleep(20)
    let msg = cstr("hello pipe")
    write(pair[1], msg, 10)
    print((<-got) ?? "")
}
