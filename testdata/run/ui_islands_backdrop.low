import std/image
import std/ui
import std/ui/geometry
import std/ui/islands
import std/ui/scene

fn checksum(img: image.Image) -> u64 {
    var hash: u64 = 0xcbf29ce484222325
    for b in img.pixels {
        hash = (hash ^ u64(b)) * 0x100000001b3
    }
    hash
}

fn texel(img: image.Image, x: i64, y: i64) -> str {
    let c = img.get(x, y)
    "{c.r},{c.g},{c.b},{c.a}"
}

fn grain() {
    print("grain")
    let first = islands.grain_pixels()
    let second = islands.grain_pixels()
    print("size {first.width}x{first.height} format {first.format == image.Format.Rgba8}")
    print("same {checksum(first) == checksum(second)} hash {checksum(first):x16}")
    var light = 0
    var dark = 0
    var clear = 0
    for i in 0..first.width * first.height {
        let r = first.pixels[i * 4]
        let a = first.pixels[i * 4 + 3]
        if a == 0 {
            clear += 1
        } else if r == 255 {
            light += 1
        } else {
            dark += 1
        }
    }
    print("light {light} dark {dark} clear {clear}")
    for p in [0, 1, 2, 255, 256, 1000, 65535] {
        print("pixel {p}: {texel(first, p % 256, p / 256)}")
    }
}

fn glows() {
    print("glow")
    let pink = islands.theme("pink", "cascadia", 13)
    let teal = islands.theme("teal", "cascadia", 13)
    let a = islands.glow_pixels(pink)
    let b = islands.glow_pixels(pink)
    let c = islands.glow_pixels(teal)
    print("size {a.width}x{a.height} format {a.format == image.Format.Rgba8}")
    print("same {checksum(a) == checksum(b)} schemes differ {checksum(a) != checksum(c)}")
    print("hash {checksum(a):x16} {checksum(c):x16}")
    for at in [[0, 0], [576, 0], [576, 60], [576, 200], [1420, 60], [1420, 400], [960, 419], [1919, 0], [1919, 419]] {
        print("pink {at[0]},{at[1]}: {texel(a, at[0], at[1])} teal {texel(c, at[0], at[1])}")
    }
    var brightest = 0
    var covered = 0
    for i in 0..a.width * a.height {
        let alpha = a.pixels[i * 4 + 3]
        if i64(alpha) > brightest {
            brightest = i64(alpha)
        }
        if alpha > 0 {
            covered += 1
        }
    }
    print("most opaque {brightest} covered {covered}")
}

fn layers() {
    print("layers")
    let cx = ui.headless(ui.rgb(0x000000))
    let b = islands.backdrop(cx)
    let th = islands.theme("pink", "cascadia", 13)
    let other = islands.theme("lime", "cascadia", 13)
    let size = geometry.size(900.0, 600.0)
    let view = fn() -> ui.Element {
        ui.div().relative().size_full().children([islands.glow_image(b, th, size), islands.grain_layer(b, size)])
    }
    let first = cx.frame(view, size, 1.0)
    for p in first.pictures {
        print("picture {p.bounds.x} {p.bounds.y} {p.bounds.width} {p.bounds.height} tile {p.tile.width * 1024.0}x{p.tile.height * 1024.0}")
    }
    let again = cx.frame(view, size, 2.0)
    print("sharper {again.pictures.len} {again.pictures[0].bounds.width} {again.pictures[1].bounds.width}")
    print("glow tile {again.pictures[0].tile.width * 1024.0}x{again.pictures[0].tile.height * 1024.0} grain tile {again.pictures[1].tile.width * 1024.0}")
    let wide = geometry.size(3000.0, 700.0)
    let big = fn() -> ui.Element {
        ui.div().relative().size_full().children([islands.glow_image(b, th, wide), islands.grain_layer(b, wide)])
    }
    let huge = cx.frame(big, wide, 1.0)
    print("wide {huge.pictures.len} {huge.pictures[0].bounds.x} {huge.pictures[0].bounds.width} tile {huge.pictures[0].tile.width * 1024.0}x{huge.pictures[0].tile.height * 1024.0}")
    let rescheme = fn() -> ui.Element {
        ui.div().relative().size_full().children([islands.glow_image(b, other, size), islands.grain_layer(b, size)])
    }
    let tinted = cx.frame(rescheme, size, 1.0)
    print("other scheme {tinted.pictures.len} {tinted.pictures[0].tile == first.pictures[0].tile}")
}

fn main() {
    grain()
    glows()
    layers()
}
