fn make(n: i64, seed: i64) -> str {
    var b: []u8 = []
    for i in 0..n {
        push(mut b, u8(97 + (i + seed) % 26))
    }
    str(b)
}

fn worker(id: i64, out: chan[i64]) {
    var views: []str = []
    var starts: []i64 = []
    var seeds: []i64 = []
    for round in 0..1500 {
        let n = 1 + (round * 13 + id) % 300
        let s = make(n, round)
        let off = (round * 7) % n
        let len = (n - off) % 17
        push(mut views, s[off..off + len])
        push(mut starts, off)
        push(mut seeds, round)
        var junk: []i64 = []
        for k in 0..(round % 40) {
            push(mut junk, k)
        }
    }
    var bad = 0
    for i in 0..views.len {
        let v = views[i]
        for j in 0..v.len {
            if v[j] != u8(97 + (starts[i] + j + seeds[i]) % 26) {
                bad += 1
            }
        }
        let again = make(starts[i] + v.len, seeds[i])
        if again[starts[i]..starts[i] + v.len] != v {
            bad += 1
        }
    }
    out <- bad
}

fn main() {
    let out = chan[i64](16)
    for id in 0..16 {
        spawn worker(id, out)
    }
    var bad = 0
    for i in 0..16 {
        bad += (<-out) ?? 1000
    }
    print(bad)
}
