struct Node {
    value: i64
    next: *Node?
}

fn chain(n: i64) -> *Node {
    var head = new(Node { value: 0, next: none })
    for i in 1..n {
        head = new(Node { value: i, next: head })
    }
    head
}

fn sum(list: *Node?) -> i64 {
    var total = 0
    var cur = list
    for {
        match cur {
            some(node) => {
                total += node.value
                cur = node.next
            }
            none => break
        }
    }
    total
}

fn churn() -> i64 {
    var x = 0
    for i in 0..20000 {
        let junk = new(Node { value: i, next: none })
        x += junk.value
    }
    x
}

fn many() -> i64 {
    let a = chain(100)
    let b = chain(200)
    let c = chain(300)
    let d = chain(400)
    let e = chain(500)
    let f = chain(600)
    let g = chain(700)
    let h = chain(800)
    let i = chain(900)
    let j = chain(1000)
    let k = chain(1100)
    let l = chain(1200)
    var noise = churn()
    noise += churn()
    noise += churn()
    let words = ["alpha", "beta"]
    var names: [str: i64] = [:]
    for n in 0..500 {
        names["{words[n % 2]}-{n}"] = n
    }
    noise += churn()
    let total = sum(a) + sum(b) + sum(c) + sum(d) + sum(e) + sum(f)
    total + sum(g) + sum(h) + sum(i) + sum(j) + sum(k) + sum(l) + (names["beta-499"] ?? 0) + noise * 0
}

fn main() {
    var total = 0
    for round in 0..10 {
        total += many()
    }
    print(total)
}
