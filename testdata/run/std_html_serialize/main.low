import std/html
import std/json
import std/text

fn unlimited() -> html.ParseOptions {
    html.ParseOptions { max_depth: 0 }
}

fn context_element(spec: str) -> *html.Node {
    let parts = text.split_str(spec, " ")
    if parts.len == 2 {
        let ns = if parts[0] == "svg" { html.Namespace.Svg } else { html.Namespace.MathMl }
        return html.create_element(ns, parts[1], [])
    }
    html.create_element(html.Namespace.Html, spec, [])
}

fn first_element(root: *html.Node) -> *html.Node? {
    for child in html.children(root) {
        if html.is_element(child) {
            return child
        }
    }
    none
}

fn serialized(input: str, context: str?, outer: bool) -> str {
    match context {
        some(spec) => {
            let parsed = html.parse_fragment_with(context_element(spec), input, unlimited())
            if outer {
                let element = first_element(parsed.root) ?? return ""
                return html.outer_html(element)
            }
            html.inner_html(parsed.root)
        }
        none => {
            let parsed = html.parse_with(input, unlimited())
            html.inner_html(parsed.root)
        }
    }
}

fn main() {
    let doc = json.parse(bytes(embed("cases.json"))) or json.Value.Null
    var passed = 0
    var failed = 0
    var i = 0
    for {
        let c = json.at(doc, i) ?? break
        let input = json.field_text(c, "input") ?? ""
        let expected = json.field_text(c, "output") ?? ""
        let context = json.field_text(c, "context")
        let outer = match json.get(c, "outer") ?? json.Value.Null {
            Bool(value) => value
            _ => false
        }
        let got = serialized(input, context, outer)
        if got == expected {
            passed += 1
        } else {
            failed += 1
            print("FAIL {i}")
            print("input: {text.quote(input)}\nexpected: {text.quote(expected)}\ngot:      {text.quote(got)}")
        }
        i += 1
    }
    print("passed {passed} failed {failed}")
}
