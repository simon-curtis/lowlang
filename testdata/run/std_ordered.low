import std/container/ordered
import std/container/sorted
import std/slices
import std/text

fn show(xs: []i64) -> str {
    text.join(slices.map(xs, fn(x: i64) -> str { "{x}" }), ",")
}

fn show_entries(es: []ordered.Entry[i64, str]) -> str {
    text.join(slices.map(es, fn(e: ordered.Entry[i64, str]) -> str { "{e.key}={e.value}" }), ",")
}

fn entry_text(e: ordered.Entry[i64, str]?) -> str {
    let found = e ?? return "none"
    "{found.key}={found.value}"
}

fn basics() {
    var t = ordered.tree[i64, str]()
    print("{t.put(5, "five")} {t.put(2, "two")} {t.put(8, "eight")} {t.put(5, "FIVE")}")
    print("{t.size()} {t.get(5) ?? "none"} {t.get(7) ?? "none"} {t.contains(2)} {t.contains(3)}")
    print(show(t.keys()))
    print(text.join(t.values(), ","))
    print(show_entries(t.entries()))
    print("{t.remove(2)} {t.remove(2)} {t.size()}")
    print("{entry_text(t.first())} {entry_text(t.last())}")
    let empty = ordered.tree[i64, str]()
    print("{entry_text(empty.first())} {entry_text(empty.last())} {empty.size()} {empty.height()}")
}

fn navigation() {
    var t = ordered.tree[i64, str]()
    for k in [10, 20, 30, 40, 50] {
        t.put(k, "v{k}")
    }
    print("{entry_text(t.floor_entry(30))} {entry_text(t.floor_entry(35))} {entry_text(t.floor_entry(9))} {entry_text(t.floor_entry(99))}")
    print("{entry_text(t.ceiling_entry(30))} {entry_text(t.ceiling_entry(35))} {entry_text(t.ceiling_entry(9))} {entry_text(t.ceiling_entry(99))}")
    print(show_entries(t.range(20, 50)))
    print(show_entries(t.range(21, 49)))
    print(show_entries(t.range(0, 100)))
    print(show_entries(t.range(30, 30)))
    print(show_entries(t.range(60, 70)))
    var total = 0
    t.each_range(15, 45, fn(k: i64, v: str) { total += k })
    print(total)
    var seen = ""
    t.each(fn(k: i64, v: str) { seen = "{seen}{v} " })
    print(seen)
}

fn strings() {
    var t = ordered.tree[str, i64]()
    for w in ["pear", "apple", "fig", "banana", "apple"] {
        t.put(w, w.len)
    }
    print(text.join(t.keys(), " "))
    print("{t.size()} {t.get("fig") ?? -1}")
}

fn log2_bound(n: i64) -> i64 {
    var bits = 0
    var v = n + 2
    for v > 1 {
        v /= 2
        bits += 1
    }
    bits + bits / 2 + 1
}

fn randomised() {
    var t = ordered.tree[i64, i64]()
    var reference: []i64 = []
    var seed = 99
    var mismatches = 0
    var worst = 0
    var peak = 0
    for step in 0..6000 {
        seed = (seed * 1103515245 + 12345) % 2147483648
        let key = (seed / 16) % 1500
        if (seed / 8) % 5 < 3 {
            let added = t.put(key, step)
            let at = slices.lower_bound(reference, key)
            let present = at < reference.len && reference[at] == key
            if added == present {
                mismatches += 1
            }
            if !present {
                reference |> slices.insert(at, key)
            }
        } else {
            let removed = t.remove(key)
            let at = slices.lower_bound(reference, key)
            let present = at < reference.len && reference[at] == key
            if removed != present {
                mismatches += 1
            }
            if present {
                reference |> slices.remove(at)
            }
        }
        if t.size() != reference.len {
            mismatches += 1
        }
        if !t.is_valid() || t.height() > log2_bound(t.size()) {
            worst += 1
        }
        if t.size() > peak {
            peak = t.size()
        }
        if step % 500 == 0 {
            if !slices.equal(t.keys(), reference) {
                mismatches += 1
            }
        }
    }
    print("mismatches {mismatches} unbalanced {worst} peak {peak}")
    print("final {slices.equal(t.keys(), reference)} {t.size() == reference.len}")

    var lookups = 0
    for probe in 0..1500 {
        let at = slices.lower_bound(reference, probe)
        let present = at < reference.len && reference[at] == probe
        if t.contains(probe) != present {
            lookups += 1
        }
        let ceil = t.ceiling_entry(probe)
        let want_ceil = if at < reference.len { reference[at] } else { -1 }
        if (match ceil {
            some(e) => e.key
            none => -1
        }) != want_ceil {
            lookups += 1
        }
        let down = if present { at } else { at - 1 }
        let want_floor = if down >= 0 { reference[down] } else { -1 }
        if (match t.floor_entry(probe) {
            some(e) => e.key
            none => -1
        }) != want_floor {
            lookups += 1
        }
    }
    print("lookups {lookups}")

    let lo = 300
    let hi = 700
    var want: []i64 = []
    for k in reference {
        if k >= lo && k < hi {
            push(mut want, k)
        }
    }
    let got = slices.map(t.range(lo, hi), fn(e: ordered.Entry[i64, i64]) -> i64 { e.key })
    print("range {slices.equal(got, want)} {want.len > 0}")

    for k in slices.clone(reference) {
        t.remove(k)
    }
    print("drained {t.size()} {t.height()} {t.keys().len}")
}

fn ascending() {
    var t = ordered.tree[i64, i64]()
    for i in 0..4096 {
        t.put(i, i)
    }
    print("{t.size()} {t.height()}")
    for i in 0..4096 {
        if i % 4 != 0 {
            t.remove(i)
        }
    }
    let low = t.first() ?? return
    let high = t.last() ?? return
    print("{t.size()} {t.height() <= 12} {low.key} {high.key}")
}

fn sorted_sets() {
    var s = sorted.from_slice([5, 1, 9, 3, 7, 3])
    print("{s.size()} {show(s.items())}")
    print("{s.add(4)} {s.add(5)} {s.remove(1)} {s.remove(2)}")
    print(show(s.items()))
    print("{s.first() ?? -1} {s.last() ?? -1} {s.has(7)} {s.has(8)}")
    print("{s.floor_item(6) ?? -1} {s.ceiling_item(6) ?? -1} {s.floor_item(2) ?? -1} {s.ceiling_item(10) ?? -1}")
    print(show(s.range(4, 9)))
    let empty = sorted.sorted[i64]()
    print("{empty.first() ?? -1} {empty.size()}")
}

fn main() {
    basics()
    navigation()
    strings()
    randomised()
    ascending()
    sorted_sets()
}
