import std/ui
import std/ui/geometry
import std/ui/scene

fn name(c: geometry.Color) -> str {
    if c == ui.rgb(0xff0000) {
        "red"
    } else if c == ui.rgb(0x00ff00) {
        "green"
    } else if c == ui.rgb(0x0000ff) {
        "blue"
    } else if c == ui.rgb(0x808080) {
        "gray"
    } else if c == ui.rgb(0x000000) {
        "black"
    } else {
        "other"
    }
}

fn quads(s: scene.Scene) -> str {
    var out = ""
    for q in s.quads {
        out += "{name(q.background)} {q.bounds.x} {q.bounds.y} {q.bounds.width} {q.bounds.height}; "
    }
    out
}

fn milli(x: f32) -> i64 {
    i64(x * 1000.0 + 0.5)
}

fn render_frame(cx: ui.Context, render: fn() -> ui.Element) -> scene.Scene {
    cx.frame(render, geometry.size(200.0, 100.0), 1.0)
}

fn box(c: u32) -> ui.Element {
    ui.div().size(50.0, 50.0).background(ui.rgb(c))
}

fn easings() {
    print("easings")
    print("{milli(ui.linear(0.25))} {milli(ui.quadratic(0.5))} {milli(ui.ease_in_out(0.25))} {milli(ui.ease_in_out(0.75))} {milli(ui.ease_out_quint(0.5))}")
    let there_and_back = ui.bounce(ui.linear)
    print("{milli(there_and_back(0.25))} {milli(there_and_back(0.75))}")
    let pulse = ui.pulsating_between(0.0, 1.0)
    print("{milli(pulse(0.0))} {milli(pulse(0.25))} {milli(pulse(0.5))} {milli(pulse(0.75))} {milli(pulse(1.25))}")
}

fn animations(cx: ui.Context, clock: ui.Signal[i64]) {
    print("animations")
    let shown = cx.signal(true)
    let view = fn() -> ui.Element {
        if !shown.get() {
            return ui.div()
        }
        ui.div().children() {
            ui.div().with_animation("grow", ui.Animation { duration_ms: 1000 }, fn(e, t) e.size(100.0 * t, 10.0).background(ui.rgb(0xff0000)))
            ui.div().with_animation("spin", ui.Animation { duration_ms: 1000, repeat: true, easing: ui.ease_in_out }, fn(e, t) e.size(100.0 * t, 10.0).background(ui.rgb(0x00ff00)))
        }
    }
    clock.set(0)
    print(quads(render_frame(cx, view)))
    print("due {cx.frame_due()}")
    clock.set(250000000)
    print(quads(render_frame(cx, view)))
    clock.set(1250000000)
    print(quads(render_frame(cx, view)))
    print("due {cx.frame_due()}")
    shown.set(false)
    render_frame(cx, view)
    print("due {cx.frame_due()}")
    shown.set(true)
    clock.set(1500000000)
    print(quads(render_frame(cx, view)))
}

fn layers(cx: ui.Context) {
    print("layers")
    let clicks = cx.signal("")
    let view = fn() -> ui.Element {
        ui.div().size(200.0, 100.0).children() {
            ui.deferred(box(0xff0000)).priority(2)
            ui.deferred(box(0x00ff00)).priority(1)
            box(0x0000ff).on_click(fn(e) clicks.set(clicks.get() + "blue "))
            ui.div().size(10.0, 10.0).overflow_hidden().child(ui.deferred(ui.div().size(40.0, 40.0).background(ui.rgb(0x808080))))
            ui.deferred(ui.div().size(20.0, 20.0).occlude().on_click(fn(e) clicks.set(clicks.get() + "cover "))).absolute().left(100.0).top(0.0)
        }
    }
    let s = render_frame(cx, view)
    print(quads(s))
    print("clip {s.quads[1].clip.width}")
    cx.dispatch(PointerDown(Left, 110.0, 10.0))
    cx.dispatch(PointerUp(Left, 110.0, 10.0))
    cx.dispatch(PointerDown(Left, 110.0, 30.0))
    cx.dispatch(PointerUp(Left, 110.0, 30.0))
    print(clicks.get())
    cx.dispatch(PointerLeft)
}

fn anchors(cx: ui.Context) {
    print("anchors")
    let view = fn() -> ui.Element {
        ui.div().size(200.0, 100.0).padding(10.0).children() {
            ui.anchored(ui.Anchor { position: geometry.point(190.0, 10.0) }).child(ui.div().size(40.0, 20.0).background(ui.rgb(0xff0000)))
            ui.anchored(ui.Anchor { position: geometry.point(30.0, 15.0), corner: BottomRight }).child(ui.div().size(40.0, 20.0).background(ui.rgb(0x00ff00)))
            ui.anchored(ui.Anchor { position: geometry.point(190.0, 95.0), snap: true, margin: 4.0 }).child(ui.div().size(40.0, 20.0).background(ui.rgb(0x0000ff)))
            ui.anchored(ui.Anchor { offset: geometry.point(5.0, 5.0) }).child(ui.div().size(40.0, 20.0).background(ui.rgb(0x808080)))
        }
    }
    print(quads(render_frame(cx, view)))
}

fn tooltips(cx: ui.Context, clock: ui.Signal[i64]) {
    print("tooltips")
    let view = fn() -> ui.Element {
        ui.div().size(200.0, 100.0).child(box(0x808080).id("tipped").tooltip(fn() ui.div().size(30.0, 10.0).background(ui.rgb(0x000000))))
    }
    clock.set(0)
    render_frame(cx, view)
    cx.dispatch(PointerMoved(10.0, 10.0))
    print(quads(render_frame(cx, view)))
    clock.set(400000000)
    print(quads(render_frame(cx, view)))
    clock.set(600000000)
    print(quads(render_frame(cx, view)))
    cx.dispatch(PointerMoved(12.0, 10.0))
    print("moved due {cx.frame_due()}")
    cx.dispatch(PointerDown(Left, 12.0, 10.0))
    cx.dispatch(PointerUp(Left, 12.0, 10.0))
    clock.set(2000000000)
    print(quads(render_frame(cx, view)))
    cx.dispatch(PointerMoved(100.0, 10.0))
    cx.dispatch(PointerMoved(20.0, 20.0))
    clock.set(2600000000)
    print(quads(render_frame(cx, view)))
    cx.dispatch(PointerLeft)
    print("left due {cx.frame_due()}")
    print(quads(render_frame(cx, view)))
}

fn dragging(cx: ui.Context) {
    print("dragging")
    let events = cx.signal("")
    let view = fn() -> ui.Element {
        ui.div().size(200.0, 100.0).children() {
            ui.div().id("card").size(20.0, 20.0).background(ui.rgb(0xff0000))
                .on_drag("card-1", fn() ui.div().size(20.0, 20.0).background(ui.rgb(0x0000ff)))
                .on_click(fn(e) events.set(events.get() + "clicked "))
            ui.div().id("bin").margin_x(40.0).size(50.0, 50.0).background(ui.rgb(0x808080))
                .drag_over(fn(v) v.with_background(ui.rgb(0x00ff00)))
                .on_drop(fn(v) events.set(events.get() + "dropped {v} "))
        }
    }
    render_frame(cx, view)
    cx.dispatch(PointerDown(Left, 5.0, 5.0))
    cx.dispatch(PointerMoved(6.0, 5.0))
    print("drag {cx.active_drag() ?? "none"}")
    cx.dispatch(PointerMoved(30.0, 10.0))
    print("drag {cx.active_drag() ?? "none"}")
    print(quads(render_frame(cx, view)))
    cx.dispatch(PointerMoved(80.0, 10.0))
    print(quads(render_frame(cx, view)))
    cx.dispatch(PointerUp(Left, 80.0, 10.0))
    print("drag {cx.active_drag() ?? "none"}")
    print(quads(render_frame(cx, view)))
    cx.dispatch(PointerDown(Left, 5.0, 5.0))
    cx.dispatch(PointerUp(Left, 5.0, 5.0))
    print(events.get())
}

fn later(cx: ui.Context) {
    print("after")
    let fired = cx.signal(false)
    cx.after(1, fn() fired.set(true))
    sleep(100)
    print("before woken {fired.get()}")
    cx.dispatch(Woken)
    print("after woken {fired.get()}")
}

fn main() {
    let cx = ui.headless(ui.rgb(0xffffff))
    let clock = cx.signal(0)
    cx.set_clock(fn() clock.get())
    easings()
    animations(cx, clock)
    layers(cx)
    anchors(cx)
    tooltips(cx, clock)
    dragging(cx)
    later(cx)
}
