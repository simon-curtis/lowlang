import std/file
import std/io
import std/log
import std/text

fn writer(l: log.Logger, id: i64, done: chan[i64]) {
    for i in 0..40 {
        l.info_with("record from a green thread with a reasonably long message", [
            log.int_attr("worker", id),
            log.int_attr("seq", i),
            log.str_attr("padding", "0123456789012345678901234567890123456789"),
        ])
    }
    done <- id
}

fn interleaving() ! io.Error {
    let dir = file.temp_dir("logt")?
    defer file.remove_all(dir) or {}
    let path = "{dir}/out.log"
    using out = file.append(path)?
    let l = log.Logger { level: Info, sink: log.Sink.Fd(out.handle.fd) }
    let done = chan[i64](8)
    for id in 0..8 {
        spawn writer(l, id, done)
    }
    for _ in 0..8 {
        let _ = <-done
    }
    let lines = text.lines(file.read_text(path)?)
    var whole = 0
    for line in lines {
        if text.starts_with(line, "info record from a green thread with a reasonably long message worker=") && text.ends_with(line, "padding=0123456789012345678901234567890123456789") {
            whole += 1
        }
    }
    print("{lines.len} {whole}")
}

fn main() {
    interleaving() or print("interleaving failed")
}
