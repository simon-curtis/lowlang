import shapes
import std/grpc

pub struct HelloRequest {
    pub name: str "1"
}

pub struct HelloReply {
    pub message: str "1"
    pub count: i64 "2"
}

/// The client of the service `helloworld.Greeter`.
pub struct GreeterClient {
    pub channel: grpc.Channel
}

/// Returns a client of the service `helloworld.Greeter` that calls through `channel`.
pub fn greeter_client(channel: grpc.Channel) -> GreeterClient {
    GreeterClient { channel }
}

/// Calls the unary method `SayHello`.
pub fn say_hello(c: GreeterClient, request: HelloRequest, opts: grpc.CallOptions) -> grpc.Reply[HelloReply] ! grpc.Error {
    grpc.unary[HelloRequest, HelloReply](c.channel, "/helloworld.Greeter/SayHello", request, opts)?
}

/// Starts the server streaming method `LotsOfReplies`; read the responses with `grpc.receive`.
pub fn lots_of_replies(c: GreeterClient, request: HelloRequest, opts: grpc.CallOptions) -> *grpc.Stream ! grpc.Error {
    grpc.server_streaming[HelloRequest](c.channel, "/helloworld.Greeter/LotsOfReplies", request, opts)?
}

/// Starts the client streaming method `LotsOfGreetings`; send with `grpc.send`, then read with `grpc.finish`.
pub fn lots_of_greetings(c: GreeterClient, opts: grpc.CallOptions) -> *grpc.Stream ! grpc.Error {
    grpc.client_streaming(c.channel, "/helloworld.Greeter/LotsOfGreetings", opts)?
}

/// Starts the bidirectional streaming method `BidiHello`; send with `grpc.send`, then read with `grpc.receive`.
pub fn bidi_hello(c: GreeterClient, opts: grpc.CallOptions) -> *grpc.Stream ! grpc.Error {
    grpc.bidi_streaming(c.channel, "/helloworld.Greeter/BidiHello", opts)?
}

/// Calls the unary method `Measure`.
pub fn measure(c: GreeterClient, request: shapes.Shape, opts: grpc.CallOptions) -> grpc.Reply[shapes.Area] ! grpc.Error {
    grpc.unary[shapes.Shape, shapes.Area](c.channel, "/helloworld.Greeter/Measure", request, opts)?
}

/// The functions that serve the methods of the service `helloworld.Greeter`, for `register_greeter`.
pub struct GreeterHandlers {
    pub say_hello: fn(*grpc.Context, HelloRequest) -> HelloReply ! grpc.Error
    pub lots_of_replies: fn(*grpc.Context, HelloRequest) ! grpc.Error
    pub lots_of_greetings: fn(*grpc.Context) -> HelloReply ! grpc.Error
    pub bidi_hello: fn(*grpc.Context) ! grpc.Error
    pub measure: fn(*grpc.Context, shapes.Shape) -> shapes.Area ! grpc.Error
}

/// Registers the methods of the service `helloworld.Greeter` on `server`.
pub fn register_greeter(server: *grpc.Server, handlers: GreeterHandlers) {
    grpc.handle_unary[HelloRequest, HelloReply](server, "/helloworld.Greeter/SayHello", handlers.say_hello)
    grpc.handle_server_streaming[HelloRequest](server, "/helloworld.Greeter/LotsOfReplies", handlers.lots_of_replies)
    grpc.handle_client_streaming[HelloReply](server, "/helloworld.Greeter/LotsOfGreetings", handlers.lots_of_greetings)
    grpc.handle_bidi_streaming(server, "/helloworld.Greeter/BidiHello", handlers.bidi_hello)
    grpc.handle_unary[shapes.Shape, shapes.Area](server, "/helloworld.Greeter/Measure", handlers.measure)
}

/// The client of the service `helloworld.Farewell`.
pub struct FarewellClient {
    pub channel: grpc.Channel
}

/// Returns a client of the service `helloworld.Farewell` that calls through `channel`.
pub fn farewell_client(channel: grpc.Channel) -> FarewellClient {
    FarewellClient { channel }
}

/// Calls the unary method `SayHello`.
pub fn say_hello_2(c: FarewellClient, request: HelloRequest, opts: grpc.CallOptions) -> grpc.Reply[HelloReply] ! grpc.Error {
    grpc.unary[HelloRequest, HelloReply](c.channel, "/helloworld.Farewell/SayHello", request, opts)?
}

/// Calls the unary method `return`.
pub fn return_(c: FarewellClient, request: HelloRequest, opts: grpc.CallOptions) -> grpc.Reply[HelloReply] ! grpc.Error {
    grpc.unary[HelloRequest, HelloReply](c.channel, "/helloworld.Farewell/return", request, opts)?
}

/// The functions that serve the methods of the service `helloworld.Farewell`, for `register_farewell`.
pub struct FarewellHandlers {
    pub say_hello: fn(*grpc.Context, HelloRequest) -> HelloReply ! grpc.Error
    pub return_: fn(*grpc.Context, HelloRequest) -> HelloReply ! grpc.Error
}

/// Registers the methods of the service `helloworld.Farewell` on `server`.
pub fn register_farewell(server: *grpc.Server, handlers: FarewellHandlers) {
    grpc.handle_unary[HelloRequest, HelloReply](server, "/helloworld.Farewell/SayHello", handlers.say_hello)
    grpc.handle_unary[HelloRequest, HelloReply](server, "/helloworld.Farewell/return", handlers.return_)
}

/// The client of the service `helloworld.Empty`.
pub struct EmptyClient {
    pub channel: grpc.Channel
}

/// Returns a client of the service `helloworld.Empty` that calls through `channel`.
pub fn empty_client(channel: grpc.Channel) -> EmptyClient {
    EmptyClient { channel }
}
