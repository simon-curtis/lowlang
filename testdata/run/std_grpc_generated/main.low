import hello
import shapes
import std/grpc
import std/io
import std/net
import std/protobuf/proto

struct Golden {
    path: str
    text: str
}

fn goldens() -> Golden[] {
    [
        Golden { path: "hello/hello.low", text: embed("hello/hello.low") },
        Golden { path: "shapes/shapes.low", text: embed("shapes/shapes.low") },
    ]
}

fn source(name: str) -> str ! io.Error {
    match name {
        == "hello.proto" => embed("protos/hello.proto")
        == "shapes.proto" => embed("protos/shapes.proto")
        _ => fail io.Error.NotFound
    }
}

fn check_generated() {
    let set = proto.read_files(["hello.proto"], [""], source) or panic("read_files")
    let outputs = proto.generate(set, proto.Options {}) or panic("generate")
    print("outputs {outputs.len}")
    for o in outputs {
        for g in goldens() {
            if g.path == o.path {
                print("{o.path}: {if g.text == o.text { "matches" } else { "DIFFERS" }}")
            }
        }
    }
}

fn say_hello(ctx: *grpc.Context, req: hello.HelloRequest) -> hello.HelloReply ! grpc.Error {
    hello.HelloReply { message: "hello {req.name}", count: 1 }
}

fn lots_of_replies(ctx: *grpc.Context, req: hello.HelloRequest) ! grpc.Error {
    for i in 0..3 {
        grpc.write[hello.HelloReply](ctx, hello.HelloReply { message: "{req.name} #{i}", count: i })?
    }
}

fn lots_of_greetings(ctx: *grpc.Context) -> hello.HelloReply ! grpc.Error {
    var names = ""
    var count = 0
    for {
        let next = grpc.read[hello.HelloRequest](ctx)?
        match next {
            some(r) => {
                names = "{names}{r.name};"
                count += 1
            }
            none => break
        }
    }
    hello.HelloReply { message: names, count }
}

fn bidi_hello(ctx: *grpc.Context) ! grpc.Error {
    for {
        let next = grpc.read[hello.HelloRequest](ctx)?
        match next {
            some(r) => grpc.write[hello.HelloReply](ctx, hello.HelloReply { message: "hi {r.name}", count: 0 })?
            none => break
        }
    }
}

fn measure(ctx: *grpc.Context, shape: shapes.Shape) -> shapes.Area ! grpc.Error {
    shapes.Area { value: shape.width * shape.height }
}

fn farewell(ctx: *grpc.Context, req: hello.HelloRequest) -> hello.HelloReply ! grpc.Error {
    hello.HelloReply { message: "bye {req.name}", count: 2 }
}

fn refuse(ctx: *grpc.Context, req: hello.HelloRequest) -> hello.HelloReply ! grpc.Error {
    fail grpc.error(NotFound, "no goodbye for {req.name}")
}

fn run(s: *grpc.Server, l: net.ListenerHandle) {
    grpc.serve_on(s, l) or {}
}

fn calls(ch: grpc.Channel) ! grpc.Error {
    let greeter = hello.greeter_client(ch)
    let one = hello.say_hello(greeter, hello.HelloRequest { name: "ann" }, grpc.CallOptions {})?
    print("say_hello {one.value.message} {one.value.count}")

    let replies = hello.lots_of_replies(greeter, hello.HelloRequest { name: "bob" }, grpc.CallOptions {})?
    defer grpc.close_stream(replies)
    for {
        let next = grpc.receive[hello.HelloReply](replies)?
        match next {
            some(r) => print("lots_of_replies {r.message} {r.count}")
            none => break
        }
    }

    let uploads = hello.lots_of_greetings(greeter, grpc.CallOptions {})?
    defer grpc.close_stream(uploads)
    for name in ["x", "y", "z"] {
        grpc.send[hello.HelloRequest](uploads, hello.HelloRequest { name })?
    }
    grpc.close_send(uploads)?
    let done = grpc.finish[hello.HelloReply](uploads)?
    print("lots_of_greetings {done.value.message} {done.value.count}")

    let chat = hello.bidi_hello(greeter, grpc.CallOptions {})?
    defer grpc.close_stream(chat)
    grpc.send[hello.HelloRequest](chat, hello.HelloRequest { name: "p" })?
    let answer = grpc.receive[hello.HelloReply](chat)?
    match answer {
        some(r) => print("bidi_hello {r.message}")
        none => print("bidi_hello ended")
    }
    grpc.close_send(chat)?

    let area = hello.measure(greeter, shapes.Shape { width: 3.0, height: 4.5 }, grpc.CallOptions {})?
    print("measure {area.value.value}")

    let farewell = hello.farewell_client(ch)
    let bye = hello.say_hello_2(farewell, hello.HelloRequest { name: "cy" }, grpc.CallOptions {})?
    print("farewell {bye.value.message} {bye.value.count}")
    let other = hello.return_(farewell, hello.HelloRequest { name: "di" }, grpc.CallOptions {}) catch {
        e => {
            print("farewell return {grpc.describe(e)}")
            return
        }
    }
    print("farewell return unexpected success")
}

fn main() {
    check_generated()
    using l = net.listen("127.0.0.1", 0) or {
        print("listen failed")
        return
    }
    let s = grpc.server(grpc.ServerOptions {})
    hello.register_greeter(s, hello.GreeterHandlers {
        say_hello
        lots_of_replies
        lots_of_greetings
        bidi_hello
        measure
    })
    hello.register_farewell(s, hello.FarewellHandlers {
        say_hello: farewell
        return_: refuse
    })
    spawn run(s, l.handle)
    let ch = grpc.dial("127.0.0.1:{l.handle.addr.port}", grpc.ChannelOptions {}) or {
        print("dial failed")
        return
    }
    calls(ch) catch {
        e => print("calls failed {grpc.describe(e)}")
    }
    grpc.close_channel(ch)
    grpc.shutdown(s, 0)
    print("shut down")
}
