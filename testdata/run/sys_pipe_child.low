import std/io
import std/sys

fn deliver(fd: i64, text: str) {
    sleep(30)
    sys.write_all(fd, bytes(text)) or return
    sys.close_fd(fd)
}

fn read_text(fd: i64) -> str ! io.Error {
    let buf = io.buffer(32)
    let n = sys.read(fd, buf)?
    str(buf[..n])
}

fn parent_writes() ! io.Error {
    let ends = sys.pipe_for_child(true)?
    sys.write_all(ends.second, bytes("to the child"))?
    print("child reads: {read_text(ends.first)?}")
    sys.close_fd(ends.second)
    print("child reads at end: {sys.read(ends.first, io.buffer(8))?}")
    sys.close_fd(ends.first)
}

fn parent_reads() ! io.Error {
    let ends = sys.pipe_for_child(false)?
    spawn deliver(ends.second, "from the child")
    print("parent reads: {read_text(ends.first)?}")
    print("parent reads at end: {sys.read(ends.first, io.buffer(8))?}")
    sys.close_fd(ends.first)
}

fn both_ends_nonblocking() ! io.Error {
    let ends = sys.pipe(true)?
    spawn deliver(ends.second, "between threads")
    print("reader parks and gets: {read_text(ends.first)?}")
    sys.close_fd(ends.first)
}

fn main() ! io.Error {
    parent_writes()?
    parent_reads()?
    both_ends_nonblocking()?
}
