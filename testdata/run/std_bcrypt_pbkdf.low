import std/crypto/password
import std/text

fn check(label: str, pw: str, salt: str, rounds: i64, length: i64, want: str) {
    let derived = password.bcrypt_pbkdf(bytes(pw), text.decode_hex(salt) or [], rounds, length) catch {
        e => {
            print("{label}: error")
            return
        }
    }
    print("{label}: {text.encode_hex(derived) == want}")
}

fn failure(label: str, pw: str, salt: []u8, rounds: i64, length: i64) {
    let derived = password.bcrypt_pbkdf(bytes(pw), salt, rounds, length) catch {
        e => {
            print("{label}: rejected")
            return
        }
    }
    print("{label}: accepted {derived.len}")
}

fn main() {
    check("vector 1", "password", "73616c74", 4, 32, "5bbf0cc293587f1c3635555c27796598d47e579071bf427e9d8fbe842aba34d9")
    check("vector 2", "correct horse battery staple", "d9e0e7eef5fc030a121920272e353c43", 16, 48, "e1c90dec46cf66fc4f0f9fc7c09e750b40b6ee0402d70dc183c793590cea6681469450be88acd259834393d931fde731")
    check("vector 3", "x", "f8ff060d141b222931383f464d545b62", 1, 64, "43ac6b521bb0d8e4ed5c60a03a0c15235a76f243205b4dc331e4588e8b93f69323a81a35905b6ab65e24115e59d2a4bf992a5d8c5d280eefd4f61598ec6d9989")
    failure("zero rounds", "pw", [1], 0, 16)
    failure("empty salt", "pw", [], 1, 16)
    failure("empty password", "", [1], 1, 16)
    failure("zero length", "pw", [1], 1, 0)
    failure("too long", "pw", [1], 1, 1025)
}
