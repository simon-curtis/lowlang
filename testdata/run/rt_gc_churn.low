struct Node {
    next: *Node?
    key: i64
    p0: i64
    p1: i64
    p2: i64
    p3: i64
}

fn filled(length: i64, seed: i64) -> []i64 {
    var out: []i64 = []
    for i in 0..length {
        push(mut out, seed + i)
    }
    out
}

fn main() {
    var live: []*Node = []
    for i in 0..2000 {
        push(mut live, new(Node { next: none, key: i, p0: 0, p1: 0, p2: 0, p3: 0 }))
    }
    var checksum = 0
    for round in 0..40000 {
        let scratch = filled(round % 200 + 1, round)
        let chain = new(Node { next: none, key: round, p0: 1, p1: 2, p2: 3, p3: 4 })
        checksum += scratch[scratch.len - 1] + chain.key
        if round % 50 == 0 {
            live[round / 50 % live.len] = chain
        }
    }
    var kept = 0
    for n in live {
        kept += n.key
    }
    print("{checksum} {kept}")
}
