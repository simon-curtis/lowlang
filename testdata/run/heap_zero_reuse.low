import std/io

fn dirty(n: i64, tag: u8) -> i64 {
    var total = 0
    var held: [][]u8 = []
    for i in 0..n {
        let size = 64 + (i * 977) % 70000
        var b = io.buffer(size)
        for j in 0..size {
            b[j] = tag
        }
        total += size
        if i % 4 == 0 {
            push(mut held, b)
        }
    }
    total
}

fn count_nonzero(sizes: []i64) -> i64 {
    var bad = 0
    for s in sizes {
        let b = io.buffer(s)
        for j in 0..b.len {
            if b[j] != 0 {
                bad += 1
            }
        }
    }
    bad
}

fn big_cycle(round: i64) -> i64 {
    let n = 2000000 + round * 4096
    var b = io.buffer(n)
    for j in 0..n {
        b[j] = 255
    }
    let again = io.buffer(n)
    var bad = 0
    for j in 0..n {
        if again[j] != 0 {
            bad += 1
        }
    }
    bad
}

fn main() {
    var sizes: []i64 = []
    for i in 0..600 {
        push(mut sizes, 64 + (i * 977) % 70000)
    }
    var bad = 0
    for round in 0..6 {
        let tag = u8(255 - round)
        let total = dirty(400, tag)
        bad += count_nonzero(sizes)
        print("round {round} wrote {total}")
    }
    print("small and medium nonzero {bad}")

    var big_bad = 0
    for round in 0..4 {
        big_bad += big_cycle(round)
    }
    print("large nonzero {big_bad}")
}
