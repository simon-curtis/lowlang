import std/gpu

struct Body {
    position: f32
    velocity: f32
    steps: u32
}

enum Mode {
    Forward
    Backward
}

kernel fn step(id: u32, dt: f32, mode: Mode, bodies_in: Body[], mut bodies: Body[]) {
    let b = bodies_in[id]
    let sign: f32 = if mode == Mode.Forward { 1.0 } else { -1.0 }
    bodies[id].position = b.position + sign * b.velocity * dt
    bodies[id].steps = b.steps + 1
}

kernel fn offsets(id: u32, base: i64, scale: f64, on: bool, mut out: i64[]) {
    if on {
        out[id] = base + i64(f64(id) * scale)
    }
}

kernel fn fill(id: u32, mut out: u32[]) {
    out[id] = id * id
}

fn counted(mut calls: i64[], n: u32) -> u32 {
    calls[0] += 1
    n
}

fn packed(job: i64, constants: u8[]) {
    var line = "{job}:"
    for byte in constants {
        line = "{line} {byte}"
    }
    print(line)
}

fn squares[T](seed: T, n: u32) -> u32[] {
    var out: u32[] = []
    for _ in 0..n {
        out.push(0)
    }
    gpu.run_on_cpu(launch(fill, n, mut out))
    out
}

fn main() {
    let before = [Body { position: 1.0, velocity: 2.0, steps: 0 }, Body { position: 5.0, velocity: -1.0, steps: 7 }]
    var after = [Body { position: 0.0, velocity: 0.0, steps: 0 }, Body { position: 0.0, velocity: 0.0, steps: 0 }]
    let stepped = launch(step, 2, 0.5, Mode.Backward, before, mut after)
    gpu.run_on_cpu(stepped)
    packed(0, stepped.constants)
    print(after[0].position)
    print(after[1].position)
    print(after[1].steps)

    var calls: i64[] = [0]
    var out: i64[] = [0, 0, 0, 0, 0]
    let job = launch(offsets, counted(mut calls, 4), 5000000000, 2.5, true, mut out)
    gpu.run_on_cpu(job)
    gpu.run_on_cpu(job)
    print(calls[0])
    print(out[3])
    print(out[4])
    packed(1, job.constants)
    print(job.operands.len)
    print(job.operands[0].bytes)
    print(job.operands[0].mutable)

    let later = fn() -> u32[] { squares("seed", 1000) }
    let filled = later()
    print(filled[999])
    print(squares(7, 10)[9])
}
