import std/io

fn big(i: i64) -> i64 {
    region {
        let b = io.buffer(1073741824)
        b[i] = u8(i % 200 + 1)
        b[b.len - 1 - i] = 3
        i64(b[i]) + i64(b[b.len - 1 - i]) + i64(b[b.len / 2])
    }
}

fn main() {
    var total = 0
    for i in 0..100 {
        total += big(i)
    }
    print(total)
    var churn: [][]i64 = []
    for r in 0..40 {
        churn = []
        for i in 0..20000 {
            push(mut churn, [i, r])
        }
        total += big(r)
    }
    print(total)
}
