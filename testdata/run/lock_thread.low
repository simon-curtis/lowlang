import std/sync

extern "c" {
    fn gettid() -> i32
}

fn spin(rounds: i64, done: chan[i64]) {
    var total = 0
    for i in 0..rounds {
        total += i % 7
    }
    done <- total
}

fn locked(results: chan[bool]) {
    sync.lock_thread()
    let home = gettid()
    var stayed = true
    var total_ping = 0
    let ping = chan[i64](4)
    for round in 0..200 {
        let done = chan[i64]()
        for k in 0..4 {
            spawn spin(20000, done)
        }
        for k in 0..4 {
            let v = (<-done) ?? 0
            ping <- v
        }
        for k in 0..4 {
            total_ping += (<-ping) ?? 0
        }
        sleep(0)
        if gettid() != home {
            stayed = false
        }
    }
    sync.unlock_thread()
    results <- stayed
}

fn main() {
    let results = chan[bool]()
    for i in 0..3 {
        spawn locked(results)
    }
    for i in 0..3 {
        print((<-results) ?? false)
    }
}
