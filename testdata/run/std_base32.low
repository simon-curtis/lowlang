import std/base32

fn main() {
    for s in ["", "f", "fo", "foo", "foob", "fooba", "foobar"] {
        let encoded = base32.encode(bytes(s))
        let decoded = base32.decode(encoded) catch {
            _ => []
        }
        print("[{s}] {encoded} {base32.encode_hex(bytes(s))} {str(decoded) == s}")
    }
    print(base32.encode_unpadded(bytes("foobar")))
    print(str(base32.decode("mzxw6ytboi") catch { _ => [] }))
    let bad = base32.decode("MZX1") catch {
        BadCharacter(at) => {
            print("bad character at {at}")
            []
        }
        BadLength => []
    }
    let short = base32.decode("M") catch {
        BadLength => {
            print("bad length")
            []
        }
        BadCharacter(at) => []
    }
}
