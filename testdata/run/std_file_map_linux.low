import std/file
import std/io
import std/text

fn describe(e: io.Error) -> str {
    match e {
        TooLarge => "TooLarge"
        Invalid => "Invalid"
        _ => "other"
    }
}

fn address_space_kb() -> i64 {
    let status = file.read_text("/proc/self/status") or return -1
    for line in text.lines(status) {
        if text.starts_with(line, "VmSize:") {
            return text.parse_int(text.fields(line)[1]) or -1
        }
    }
    -1
}

fn huge() -> str {
    using m = file.map_anonymous(file.MapMode.Private, 1 << 60) catch {
        e => return describe(e)
    }
    "ok {m.data.len}"
}

fn resident() ! io.Error {
    let before = address_space_kb()
    using var region = file.map_anonymous(file.MapMode.Private, 256 << 20)?
    let during = address_space_kb()
    file.unmap(mut region)
    let after = address_space_kb()
    print("mapped {during - before >= 262144}")
    print("unmapped {after - before < 1024}")
}

fn hold() ! io.Error {
    using region = file.map_anonymous(file.MapMode.Private, 256 << 20)?
    region.data[0] = 1
}

fn dropped() ! io.Error {
    let before = address_space_kb()
    hold()?
    print("dropped {address_space_kb() - before < 1024}")
}

fn dont_need(dir: str) ! io.Error {
    let path = "{dir}/advice"
    file.write_file(path, [1, 2, 3, 4])?
    using f = file.update(path)?
    using private = file.map(f, file.MapMode.Private, 0, 0)?
    private.data[0] = 9
    file.advise_map(private, file.Advice.DontNeed)?
    print("private file {private.data[0]} {private.data[3]}")
    using shared = file.map(f, file.MapMode.Shared, 0, 0)?
    shared.data[1] = 8
    file.advise_map(shared, file.Advice.DontNeed)?
    print("shared file {shared.data[1]} {shared.data[0]}")
    using anonymous = file.map_anonymous(file.MapMode.Private, 8192)?
    anonymous.data[100] = 7
    file.advise_map(anonymous, file.Advice.DontNeed)?
    print("private anonymous {anonymous.data[100]}")
    using kept = file.map_anonymous(file.MapMode.Shared, 8192)?
    kept.data[100] = 6
    file.advise_map(kept, file.Advice.DontNeed)?
    print("shared anonymous {kept.data[100]}")
    file.advise_map(kept, file.Advice.WillNeed)?
    print("will need {kept.data[100]}")
}

fn main() ! io.Error {
    print("huge {huge()}")
    resident()?
    dropped()?
    let dir = file.temp_dir("low-std-map-linux-")?
    dont_need(dir)?
    file.remove_all(dir)?
}
