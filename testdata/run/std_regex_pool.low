import std/regex

fn subject(i: i64) -> str {
    "user {i}-name{i % 7}x@host{i % 13}.com trailing text"
}

fn worker(id: i64, re: regex.Regex, lines: []str, done: chan[i64]) {
    var hits = 0
    var sum = 0
    var matched = 0
    for i in 0..400 {
        let s = subject(id * 1000 + i)
        match regex.find(re, s) {
            some(m) => {
                hits += 1
                sum += regex.end(m)
            }
            none => {}
        }
        if regex.is_match(re, s) {
            matched += 1
        }
        sleep(0)
    }
    lines[id] = "worker {id} {hits} {sum} {matched}"
    done <- id
}

fn shared_across_threads() {
    let re = regex.compile("([0-9]+)-([a-z0-9]+)@([a-z0-9]+)\\.com") catch {
        _ => return
    }
    let done = chan[i64](8)
    var lines: []str = []
    for id in 0..8 {
        push(mut lines, "")
    }
    for id in 0..8 {
        spawn worker(id, re, lines, done)
    }
    for _ in 0..8 {
        let finished = <-done ?? -1
    }
    for line in lines {
        print(line)
    }
}

fn reentrant_callbacks() {
    let re = regex.compile("[a-z]+") catch {
        _ => return
    }
    let inner = regex.compile("[0-9]+") catch {
        _ => return
    }
    let out = regex.replace_all(re, "abc 123 def 456 ghi", fn(m: regex.Match) -> str {
        let word = regex.text(m)
        let nested = regex.find(re, "zzz yyy") ?? return "?"
        let digits = regex.is_match(inner, "no digits here 99")
        let again = regex.find(re, word) ?? return "?"
        "<{word}:{regex.text(nested)}:{digits}:{regex.text(again)}>"
    })
    print(out)
    let parts = regex.split(re, "1a22b333c4444")
    print(parts.len)
    for p in parts {
        print("[{p}]")
    }
    let all = regex.find_all(re, "one two three")
    for m in all {
        print("{regex.start(m)} {regex.end(m)} {regex.text(m)}")
    }
}

fn repeated_use() {
    let re = regex.compile("(a+)(b*)") catch {
        _ => return
    }
    var total = 0
    for i in 0..5000 {
        let s = "xx{i}aaab{i}"
        match regex.find(re, s) {
            some(m) => {
                let g = regex.group(m, 1) ?? ""
                let h = regex.group(m, 2) ?? "-"
                total += g.len * 10 + h.len
            }
            none => {}
        }
        match regex.full_match(re, "aaabb") {
            some(m) => {
                total += regex.end(m)
            }
            none => {}
        }
        match regex.full_match(re, "aaabbc") {
            some(_) => {
                total += 1000
            }
            none => {}
        }
    }
    print(total)
}

fn match_survives_reuse() {
    let re = regex.compile("([a-z]+)-([0-9]+)") catch {
        _ => return
    }
    let first = regex.find(re, "key-123 other") ?? return
    let second = regex.find(re, "zzz-9") ?? return
    let third = regex.find(re, "no match here")
    print("{regex.text(first)} {regex.group(first, 1) ?? "none"} {regex.group(first, 2) ?? "none"}")
    print("{regex.text(second)} {regex.group(second, 1) ?? "none"} {regex.group(second, 2) ?? "none"}")
    match third {
        some(_) => print("unexpected")
        none => print("none")
    }
}

fn main() {
    shared_across_threads()
    reentrant_callbacks()
    repeated_use()
    match_survives_reuse()
}
