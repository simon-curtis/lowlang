import std/time

fn reason(e: time.Error) -> str {
    match e {
        Invalid(at) => "invalid at {at}"
        OutOfRange(at) => "out of range at {at}"
        Overflow => "overflow"
    }
}

fn parse(s: str) {
    let d = time.parse_duration(s) catch {
        e => {
            print("'{s}' {reason(e)}")
            return
        }
    }
    print("'{s}' {d.nanos} {time.format_duration(d)}")
}

fn show(d: time.Duration) {
    print("{d.nanos} {time.format_duration(d)}")
}

fn constructors() {
    show(time.nanoseconds(1))
    show(time.microseconds(1))
    show(time.milliseconds(1))
    show(time.seconds(1))
    show(time.minutes(1))
    show(time.hours(1))
    show(time.hours(1).add(time.minutes(30)))
    show(time.hours(1).sub(time.minutes(90)))
    show(time.seconds(0))
    show(time.nanoseconds(999))
    show(time.nanoseconds(1500))
    show(time.nanoseconds(1000000))
    show(time.nanoseconds(1000001))
    show(time.milliseconds(250))
    show(time.milliseconds(1500))
    show(time.seconds(90))
    show(time.seconds(3600))
    show(time.seconds(3661).add(time.milliseconds(5)))
    show(time.minutes(-2))
    show(time.hours(-25).sub(time.nanoseconds(1)))
    show(time.nanoseconds(9223372036854775807))
    show(time.nanoseconds(-9223372036854775807 - 1))
    let d = time.seconds(5400)
    print("{d.as_nanos()} {d.as_micros()} {d.as_millis()} {d.as_seconds()} {d.as_minutes()} {d.as_hours()}")
    let small = time.nanoseconds(1500000)
    print("{small.as_millis()} {small.as_seconds()}")
    print(time.seconds(2) == time.milliseconds(2000))
}

fn parsing() {
    let inputs = [
        "1h30m", "250ms", "1.5s", "-2m", "+3s", "0", "-0", "1h", "90m", "1h2m3s4ms5us6ns", "1h2m3s4ms5µs6ns", "1μs",
        "100ns", ".5s", "2.s", "1.25h", "0.001s", "1.9ns", "0.5ns", "1.0000000001s", "2562047h47m16.854775807s", "9223372036854775807ns",
        "", "-", "+", "1", "10", "1x", "1h30", "1h30x", "s", "-s", "1.5.5s", "1 h", " 1h", "1h ", "1hm", "h1", "1ms2", "5m-3s",
        "2562047h47m16.854775808s", "9223372036854775808ns", "99999999999999999999s", "9999999999h", "1h9223372036854775807ns",
    ]
    for s in inputs {
        parse(s)
    }
}

fn round_trip() {
    let samples = [0, 1, 999, 1000, 1001, 999999, 1000000, 59999999999, 60000000000, 3599999999999, 3600000000000, 86400000000000, 123456789012345, -1, -90000000000, 9223372036854775807]
    var failures = 0
    for n in samples {
        let d = time.nanoseconds(n)
        let text = time.format_duration(d)
        let back = time.parse_duration(text) catch {
            _ => {
                failures += 1
                continue
            }
        }
        if back != d {
            print("mismatch {n} {text} {back.nanos}")
            failures += 1
        }
    }
    print("round trip failures {failures}")
}

fn timers() {
    let started = time.monotonic()
    time.sleep_for(time.milliseconds(20))
    print("slept {time.since(started).as_millis() >= 1}")
    time.sleep_for(time.nanoseconds(1))
    time.sleep_for(time.nanoseconds(0))
    time.sleep_for(time.seconds(-1))
    print("short sleeps done")

    let watch = time.start()
    time.sleep_for(time.milliseconds(10))
    let first = watch.elapsed()
    time.sleep_for(time.milliseconds(10))
    let second = watch.elapsed()
    print("stopwatch {first.nanos > 0} {second.nanos >= first.nanos}")

    let t = time.timer(time.milliseconds(5))
    let fired = select {
        <-t.fired => true
        after(5000) => false
    }
    print("timer fired {fired}")

    let waited = select {
        <-time.after(time.milliseconds(5)) => "after"
        after(5000) => "late"
    }
    print("after {waited}")

    let stopped = time.timer(time.seconds(30))
    print("stop {time.stop_timer(stopped)} {time.stop_timer(stopped)}")
    let quiet = select {
        <-stopped.fired => "fired"
        after(30) => "quiet"
    }
    print("stopped timer {quiet}")

    let slow = time.timer(time.seconds(30))
    time.reset_timer(slow, time.milliseconds(5))
    let reset = select {
        <-slow.fired => "fired"
        after(5000) => "late"
    }
    print("reset timer {reset}")

    let expired = time.timer(time.milliseconds(1))
    let landed = select {
        <-expired.fired => true
        after(5000) => false
    }
    print("expired {landed} stop after firing {time.stop_timer(expired)}")
}

fn tickers() {
    let tk = time.ticker(time.milliseconds(5))
    var count = 0
    for count < 5 {
        let tick = select {
            <-tk.ticks => true
            after(5000) => false
        }
        if !tick {
            break
        }
        count += 1
    }
    time.stop_ticker(tk)
    print("ticks {count}")
    time.sleep_for(time.milliseconds(30))
    var drained = 0
    for {
        let more = select {
            <-tk.ticks => true
            else => false
        }
        if !more {
            break
        }
        drained += 1
    }
    let after_stop = select {
        <-tk.ticks => "tick"
        after(50) => "silent"
    }
    print("drained at most one {drained <= 1} after stop {after_stop}")
}

fn main() {
    constructors()
    parsing()
    round_trip()
    timers()
    tickers()
}
