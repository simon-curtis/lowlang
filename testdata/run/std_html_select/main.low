import std/html
import std/json
import std/text

fn ints(v: json.Value) -> []i64 {
    var out: []i64 = []
    var i = 0
    for {
        let item = json.at(v, i) ?? break
        match item {
            Int(value) => push(mut out, value)
            _ => {}
        }
        i += 1
    }
    out
}

fn index_of(all: []*html.Node, n: *html.Node?) -> i64 {
    let target = n ?? return -1
    for i, e in all {
        if e == target {
            return i
        }
    }
    -1
}

fn indices(all: []*html.Node, found: []*html.Node) -> []i64 {
    var out: []i64 = []
    for n in found {
        push(mut out, index_of(all, n))
    }
    out
}

fn show(xs: []i64) -> str {
    var parts: []str = []
    for x in xs {
        push(mut parts, "{x}")
    }
    "[{text.join(parts, ",")}]"
}

fn same(a: []i64, b: []i64) -> bool {
    if a.len != b.len {
        return false
    }
    for i in 0..a.len {
        if a[i] != b[i] {
            return false
        }
    }
    true
}

fn main() {
    let doc = json.parse(bytes(embed("cases.json"))) or json.Value.Null
    let everything = html.compile("*") or return
    var roots: []*html.Node = []
    var elements: [][]*html.Node = []
    var i = 0
    for {
        let d = json.at(json.field(doc, "docs"), i) ?? break
        let parsed = html.parse(json.field_text(d, "html") ?? "")
        push(mut roots, parsed.root)
        push(mut elements, html.query_all(parsed.root, everything))
        i += 1
    }
    var passed = 0
    var failed = 0
    var rejected = 0
    var closest_checked = 0
    var c = 0
    for {
        let entry = json.at(json.field(doc, "cases"), c) ?? break
        c += 1
        let source = json.field_text(entry, "selector") ?? ""
        let expect_error = match json.field(entry, "error") { Bool(value) => value
        _ => false
    }
        let compiled = html.compile(source) catch {
            Invalid(at, message) => {
                if expect_error {
                    passed += 1
                    rejected += 1
                } else {
                    failed += 1
                    print("FAIL {text_of(source)} rejected at {at}: {message}")
                }
                continue
            }
        }
        if expect_error {
            failed += 1
            print("FAIL {text_of(source)} compiled but should be rejected")
            continue
        }
        let wanted = json.field(entry, "docs")
        let firsts = json.field(entry, "first")
        let closests = json.field(entry, "closest")
        var ok = true
        for d in 0..roots.len {
            let expected = ints(json.at(wanted, d) ?? json.Value.Null)
            let found = html.query_all(roots[d], compiled)
            let got = indices(elements[d], found)
            if !same(expected, got) {
                ok = false
                print("FAIL {text_of(source)} doc {d}: expected {show(expected)} got {show(got)}")
            }
            var matched: []i64 = []
            for k, e in elements[d] {
                if html.matches(e, compiled) {
                    push(mut matched, k)
                }
            }
            if !same(expected, matched) {
                ok = false
                print("FAIL {text_of(source)} doc {d}: matches {show(matched)}")
            }
            let first = index_of(elements[d], html.query(roots[d], compiled))
            var expected_first = -1
            match json.at(firsts, d) ?? json.Value.Null {
                Int(value) => { expected_first = value }
                _ => {}
            }
            if first != expected_first {
                ok = false
                print("FAIL {text_of(source)} doc {d}: query {first} expected {expected_first}")
            }
            match json.at(closests, d) {
                some(row) => {
                    closest_checked += 1
                    let want = ints(row)
                    var have: []i64 = []
                    for e in elements[d] {
                        push(mut have, index_of(elements[d], html.closest(e, compiled)))
                    }
                    if !same(want, have) {
                        ok = false
                        print("FAIL {text_of(source)} doc {d}: closest {show(have)} expected {show(want)}")
                    }
                }
                none => {}
            }
        }
        if ok {
            passed += 1
        } else {
            failed += 1
        }
    }
    print("selectors passed {passed} failed {failed} rejected {rejected} closest rows {closest_checked}")
}

fn text_of(source: str) -> str {
    json.stringify(json.Value.Str(source), 0)
}
