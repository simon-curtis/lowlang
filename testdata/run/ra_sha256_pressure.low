fn rotr(x: u32, k: u32) -> u32 {
    (x >> k) | (x << (32 - k))
}

fn constants() -> []u32 {
    [1116352408, 1899447441, 3049323471, 3921009573, 961987163, 1508970993, 2453635748, 2870763221,
     3624381080, 310598401, 607225278, 1426881987, 1925078388, 2162078206, 2614888103, 3248222580,
     3835390401, 4022224774, 264347078, 604807628, 770255983, 1249150122, 1555081692, 1996064986,
     2554220882, 2821834349, 2952996808, 3210313671, 3336571891, 3584528711, 113926993, 338241895,
     666307205, 773529912, 1294757372, 1396182291, 1695183700, 1986661051, 2177026350, 2456956037,
     2730485921, 2820302411, 3259730800, 3345764771, 3516065817, 3600352804, 4094571909, 275423344,
     430227734, 506948616, 659060556, 883997877, 958139571, 1322822218, 1537002063, 1747873779,
     1955562222, 2024104815, 2227730452, 2361852424, 2428436474, 2756734187, 3204031479, 3329325298]
}

fn digest(message: []u8) -> []u32 {
    var data: []u8 = []
    for b in message {
        push(mut data, b)
    }
    push(mut data, 128)
    for data.len % 64 != 56 {
        push(mut data, 0)
    }
    let bits = message.len * 8
    for i in 0..8 {
        push(mut data, u8(bits >> (56 - 8 * i)))
    }
    let k = constants()
    var h0: u32 = 1779033703
    var h1: u32 = 3144134277
    var h2: u32 = 1013904242
    var h3: u32 = 2773480762
    var h4: u32 = 1359893119
    var h5: u32 = 2600822924
    var h6: u32 = 528734635
    var h7: u32 = 1541459225
    var w: []u32 = []
    for i in 0..64 {
        push(mut w, 0)
    }
    for block in 0..data.len / 64 {
        for t in 0..16 {
            let at = block * 64 + t * 4
            w[t] = (u32(data[at]) << 24) | (u32(data[at + 1]) << 16) | (u32(data[at + 2]) << 8) | u32(data[at + 3])
        }
        for t in 16..64 {
            let s0 = rotr(w[t - 15], 7) ^ rotr(w[t - 15], 18) ^ (w[t - 15] >> 3)
            let s1 = rotr(w[t - 2], 17) ^ rotr(w[t - 2], 19) ^ (w[t - 2] >> 10)
            w[t] = w[t - 16] + s0 + w[t - 7] + s1
        }
        var a = h0
        var b = h1
        var c = h2
        var d = h3
        var e = h4
        var f = h5
        var g = h6
        var h = h7
        for t in 0..64 {
            let big1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25)
            let choose = (e & f) ^ (~e & g)
            let temp1 = h + big1 + choose + k[t] + w[t]
            let big0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22)
            let majority = (a & b) ^ (a & c) ^ (b & c)
            let temp2 = big0 + majority
            h = g
            g = f
            f = e
            e = d + temp1
            d = c
            c = b
            b = a
            a = temp1 + temp2
        }
        h0 += a
        h1 += b
        h2 += c
        h3 += d
        h4 += e
        h5 += f
        h6 += g
        h7 += h
    }
    [h0, h1, h2, h3, h4, h5, h6, h7]
}

fn text(n: i64) -> []u8 {
    var out: []u8 = []
    for i in 0..n {
        push(mut out, u8(97 + i % 26))
    }
    out
}

fn main() {
    for n in [0, 3, 55, 56, 63, 64, 65, 1000] {
        let words = digest(text(n))
        var line = 0
        for w in words {
            line = (line * 31 + i64(w)) % 1000000007
        }
        print(line)
    }
    let abc = digest(text(3))
    for w in abc {
        print(i64(w))
    }
}
