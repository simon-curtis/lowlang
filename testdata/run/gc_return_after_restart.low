import std/os
import std/process
import std/text

struct Return {
    pause: i64
    returned: i64
}

fn block(n: i64) -> i64[] {
    var xs: i64[] = []
    for i in 0..n {
        xs.push(i)
    }
    xs
}

fn churn() {
    var kept: i64[][] = []
    for b in 0..16 {
        kept.push(block(1000000))
    }
    var sum = 0
    for xs in kept {
        sum += xs[xs.len - 1]
    }
    kept = []
    for i in 0..200 {
        let garbage = block(131072)
        sum += garbage[i]
    }
    print("sum {sum}")
}

fn field(line: str, name: str) -> i64 {
    let c = text.cut(line, name)
    if !c.found {
        return -1
    }
    let rest = c.after
    var end = 0
    for end < rest.len && rest[end] >= 48 && rest[end] <= 57 {
        end += 1
    }
    text.parse_int(rest[..end]) or -1
}

fn largest_return() -> Return {
    let env = os.environment()
    env["LOW_GCTRACE"] = "1"
    var best = Return { pause: -1, returned: -1 }
    let program = os.executable() or return best
    let out = process.run(process.Command { program, args: ["churn"], env: some(env) }, []) or return best
    print("child: {text.trim(str(out.stdout))}")
    for line in text.split(str(out.stderr), 10) {
        if !text.starts_with(line, "gc ") {
            continue
        }
        let returned = field(line, " return_us=")
        if returned > best.returned {
            best = Return { pause: field(line, " pause_us="), returned }
        }
    }
    best
}

fn main() {
    let args = os.args()
    if args.len > 1 {
        churn()
        return
    }
    let r = largest_return()
    print("pages returned: {r.returned > 0}")
    print("returned after the world restarts: {r.pause >= 0 && r.returned > r.pause}")
}
