import std/io
import std/time

fn show(seconds: i64) {
    let dt = time.from_unix(seconds)
    let d = dt.date
    print("{seconds} {time.format_datetime(dt)} {time.weekday_name(time.weekday(d))} ordinal {time.ordinal(d)} back {time.to_unix(dt)}")
}

fn check_date(year: i64, month: i64, day: i64) {
    let d = time.date(year, month, day) catch {
        _ => {
            print("{year}-{month}-{day} invalid")
            return
        }
    }
    print("{time.format_date(d)} days {time.days(d)} {time.weekday_name(time.weekday(d))}")
}

fn round_trips(first: i64, last: i64) -> i64 {
    var failures = 0
    var previous = time.civil_from_days(first - 1)
    for n in first..last {
        let d = time.civil_from_days(n)
        let next_day = previous.day + 1 <= time.days_in_month(previous.year, previous.month)
        let expected = if next_day {
            time.Date { year: previous.year, month: previous.month, day: previous.day + 1 }
        } else if previous.month < 12 {
            time.Date { year: previous.year, month: previous.month + 1, day: 1 }
        } else {
            time.Date { year: previous.year + 1, month: 1, day: 1 }
        }
        if d != expected || time.days(d) != n || time.from_ordinal(time.ordinal(d)) != d {
            failures += 1
        }
        previous = d
    }
    failures
}

fn main() ! io.Error {
    for s in [0, -1, 86399, 86400, -86400, 951782400, 951868800, 4107456000, 4107542400, -2208988800, -62135596800, 253402300799, 1709322312, 1762803900] {
        show(s)
    }
    for y in [1900, 1996, 2000, 2023, 2024, 2100, 2400] {
        print("{y} leap {time.leap_year(y)} february {time.days_in_month(y, 2)}")
    }
    check_date(2000, 2, 29)
    check_date(2100, 2, 29)
    check_date(2024, 2, 29)
    check_date(2023, 2, 29)
    check_date(2024, 4, 31)
    check_date(2024, 13, 1)
    check_date(2024, 0, 1)
    check_date(2024, 1, 0)
    check_date(1, 1, 1)
    check_date(1969, 12, 31)
    check_date(1600, 3, 1)
    check_date(9999, 12, 31)
    let leap_eve = time.date(2000, 2, 28)?
    let century_eve = time.date(2100, 2, 28)?
    print("{time.format_date(time.add_days(leap_eve, 1))} {time.format_date(time.add_days(leap_eve, 2))}")
    print("{time.format_date(time.add_days(century_eve, 1))} {time.format_date(time.add_days(century_eve, -365))}")
    print("{time.format_date(time.add_days(time.date(1970, 1, 1)?, -1))} {time.format_date(time.add_days(time.date(2024, 12, 31)?, 1))}")
    print("{time.format_date(time.add_days(time.date(2024, 3, 1)?, 10000))} {time.format_date(time.add_days(time.date(2024, 3, 1)?, -100000))}")
    print("{time.format_date(time.from_ordinal(1))} {time.format_date(time.from_ordinal(738946))} {time.format_date(time.from_ordinal(719163))}")
    print("{time.format_date(time.civil_from_days(-719528))} {time.format_date(time.civil_from_days(-1000000))}")
    print("{time.days_from_civil(1, 1, 1)} {time.days_from_civil(-1, 12, 31)} {time.days_from_civil(2100, 3, 1)}")
    let a = time.date(2024, 3, 1)?
    let b = time.date(2024, 2, 29)?
    let c = time.date(2023, 12, 31)?
    print("{time.compare(a, b)} {time.compare(b, a)} {time.compare(a, a)} {time.compare(c, b)} {a == a} {a == b}")
    print("round trip failures {round_trips(-800000, 800000)}")
    var unix_failures = 0
    var s = -100000000000
    for s < 100000000000 {
        if time.to_unix(time.from_unix(s)) != s {
            unix_failures += 1
        }
        s += 999999937
    }
    print("unix failures {unix_failures}")
}
