import std/io
import std/ui/font

struct Table {
    tag: str
    data: []u8
}

struct Script {
    tag: str
    features: []i64
}

struct Feature {
    tag: str
    lookups: []i64
}

fn pad(mut b: []u8, n: i64) {
    for _ in 0..n {
        b.push(0)
    }
}

fn zeros(n: i64) -> []u8 {
    var b: []u8 = []
    pad(mut b, n)
    b
}

fn append(mut b: []u8, more: []u8) {
    for x in more {
        b.push(x)
    }
}

fn words(mut b: []u8, w: []i64) {
    for v in w {
        io.put_be16(mut b, v)
    }
}

fn tag(mut b: []u8, t: str) {
    for i in 0..4 {
        b.push(t[i])
    }
}

fn assemble(tables: []Table) -> []u8 {
    var out: []u8 = []
    io.put_be32(mut out, 65536)
    io.put_be16(mut out, tables.len)
    pad(mut out, 6)
    var offset = 12 + 16 * tables.len
    for t in tables {
        tag(mut out, t.tag)
        io.put_be32(mut out, 0)
        io.put_be32(mut out, offset)
        io.put_be32(mut out, t.data.len)
        offset += (t.data.len + 3) / 4 * 4
    }
    for t in tables {
        append(mut out, t.data)
        pad(mut out, (4 - t.data.len % 4) % 4)
    }
    out
}

fn head() -> []u8 {
    var b = zeros(54)
    io.set_be16(b, 18, 16)
    b
}

fn hhea() -> []u8 {
    var b = zeros(36)
    io.set_be16(b, 4, 14)
    io.set_be16(b, 6, -4)
    io.set_be16(b, 34, 1)
    b
}

fn maxp(glyphs: i64) -> []u8 {
    var b = zeros(6)
    io.set_be16(b, 4, glyphs)
    b
}

fn hmtx() -> []u8 {
    var b: []u8 = []
    words(mut b, [8, 0])
    b
}

fn cmap12() -> []u8 {
    var b: []u8 = []
    words(mut b, [0, 1, 3, 10])
    io.put_be32(mut b, 12)
    words(mut b, [12, 0])
    io.put_be32(mut b, 28)
    io.put_be32(mut b, 0)
    io.put_be32(mut b, 1)
    for v in [65, 66, 1] {
        io.put_be32(mut b, v)
    }
    b
}

fn kern0(pairs: []i64) -> []u8 {
    var b: []u8 = []
    words(mut b, [0, 1, 0, 14 + 2 * pairs.len, 1, pairs.len / 3])
    pad(mut b, 6)
    words(mut b, pairs)
    b
}

fn coverage1(glyphs: []i64) -> []u8 {
    var b: []u8 = []
    words(mut b, [1, glyphs.len])
    words(mut b, glyphs)
    b
}

fn coverage2(ranges: []i64) -> []u8 {
    var b: []u8 = []
    words(mut b, [2, ranges.len / 3])
    words(mut b, ranges)
    b
}

fn class1(start: i64, classes: []i64) -> []u8 {
    var b: []u8 = []
    words(mut b, [1, start, classes.len])
    words(mut b, classes)
    b
}

fn class2(ranges: []i64) -> []u8 {
    var b: []u8 = []
    words(mut b, [2, ranges.len / 3])
    words(mut b, ranges)
    b
}

fn pair1(coverage: []u8, format1: i64, format2: i64, sets: [][][]i64) -> []u8 {
    var header = 10 + 2 * sets.len
    var b: []u8 = []
    words(mut b, [1, header, format1, format2, sets.len])
    var at = header + coverage.len
    for set in sets {
        io.put_be16(mut b, at)
        var size = 2
        for record in set {
            size += 2 * record.len
        }
        at += size
    }
    append(mut b, coverage)
    for set in sets {
        io.put_be16(mut b, set.len)
        for record in set {
            words(mut b, record)
        }
    }
    b
}

fn pair2(coverage: []u8, format1: i64, format2: i64, first: []u8, second: []u8, first_count: i64, second_count: i64, matrix: []i64) -> []u8 {
    let header = 16 + 2 * matrix.len
    var b: []u8 = []
    words(mut b, [2, header, format1, format2, header + coverage.len, header + coverage.len + first.len, first_count, second_count])
    words(mut b, matrix)
    append(mut b, coverage)
    append(mut b, first)
    append(mut b, second)
    b
}

fn pair_pos(left: i64, right: i64, value: i64) -> []u8 {
    pair1(coverage1([left]), 4, 0, [[[right, value]]])
}

fn lookup(kind: i64, subtables: [][]u8) -> []u8 {
    var b: []u8 = []
    words(mut b, [kind, 0, subtables.len])
    var at = 6 + 2 * subtables.len
    for s in subtables {
        io.put_be16(mut b, at)
        at += s.len
    }
    for s in subtables {
        append(mut b, s)
    }
    b
}

fn extension(kind: i64, inner: []u8) -> []u8 {
    var b: []u8 = []
    words(mut b, [1, kind])
    io.put_be32(mut b, 8)
    append(mut b, inner)
    b
}

fn list(tags: []str, items: [][]u8) -> []u8 {
    let record = if tags.len > 0 { 6 } else { 2 }
    var b: []u8 = []
    io.put_be16(mut b, items.len)
    var at = 2 + record * items.len
    for i in 0..items.len {
        if tags.len > 0 {
            tag(mut b, tags[i])
        }
        io.put_be16(mut b, at)
        at += items[i].len
    }
    for item in items {
        append(mut b, item)
    }
    b
}

fn script_table(s: Script) -> []u8 {
    var b: []u8 = []
    words(mut b, [4, 0, 0, 65535, s.features.len])
    words(mut b, s.features)
    b
}

fn feature_table(f: Feature) -> []u8 {
    var b: []u8 = []
    words(mut b, [0, f.lookups.len])
    words(mut b, f.lookups)
    b
}

fn gpos(scripts: []Script, features: []Feature, lookups: [][]u8) -> []u8 {
    var script_tags: []str = []
    var script_tables: [][]u8 = []
    for s in scripts {
        script_tags.push(s.tag)
        script_tables.push(script_table(s))
    }
    var feature_tags: []str = []
    var feature_tables: [][]u8 = []
    for f in features {
        feature_tags.push(f.tag)
        feature_tables.push(feature_table(f))
    }
    let script_list = list(script_tags, script_tables)
    let feature_list = list(feature_tags, feature_tables)
    var b: []u8 = []
    io.put_be32(mut b, 65536)
    words(mut b, [10, 10 + script_list.len, 10 + script_list.len + feature_list.len])
    append(mut b, script_list)
    append(mut b, feature_list)
    append(mut b, list([], lookups))
    b
}

fn kern_gpos(lookups: [][]u8) -> []u8 {
    var indices: []i64 = []
    for i in 0..lookups.len {
        indices.push(i)
    }
    gpos([Script { tag: "DFLT", features: [0] }], [Feature { tag: "kern", lookups: indices }], lookups)
}

fn open(gpos_data: []u8, kern_pairs: []i64) -> font.Font {
    var tables = [
        Table { tag: "head", data: head() }
        Table { tag: "hhea", data: hhea() }
        Table { tag: "maxp", data: maxp(20) }
        Table { tag: "cmap", data: cmap12() }
        Table { tag: "hmtx", data: hmtx() }
        Table { tag: "loca", data: zeros(42) }
        Table { tag: "glyf", data: zeros(0) }
    ]
    if kern_pairs.len > 0 {
        tables.push(Table { tag: "kern", data: kern0(kern_pairs) })
    }
    if gpos_data.len > 0 {
        tables.push(Table { tag: "GPOS", data: gpos_data })
    }
    font.parse(str(assemble(tables))) or font.Font {}
}

fn kerns(label: str, f: font.Font, pairs: []i64) {
    var line = label
    for i in 0..pairs.len / 2 {
        line = "{line} {pairs[2 * i]},{pairs[2 * i + 1]}={f.kern(pairs[2 * i], pairs[2 * i + 1])}"
    }
    print(line)
}

fn pair_sets() -> font.Font {
    let first = pair1(coverage1([3, 5]), 5, 3, [
        [[4, 10, -50, 1, 2], [7, 10, -30, 1, 2]]
        [[2, 0, 20, 0, 0]]
    ])
    let second = pair1(coverage2([5, 9, 0]), 4, 0, [
        [[2, -99], [3, -11]]
        [[1, -12]]
        []
        [[8, -13]]
        [[1, -14]]
    ])
    open(kern_gpos([lookup(2, [first, second])]), [])
}

fn classes() -> []u8 {
    let matrix = [0, 7, 8, 0, -40, -41, 0, -60, 3]
    let sub = pair2(coverage1([2, 3, 4, 10]), 4, 0, class1(2, [1, 2, 1]), class2([5, 6, 1, 8, 12, 2]), 3, 3, matrix)
    lookup(2, [sub])
}

fn second_classes() -> []u8 {
    let matrix = [0, 100, 0, 200]
    let sub = pair2(coverage2([2, 4, 0]), 4, 0, class2([2, 2, 1, 3, 4, 0]), class1(5, [0, 1]), 2, 2, matrix)
    lookup(2, [sub])
}

fn summed() -> font.Font {
    let features = [
        Feature { tag: "kern", lookups: [1, 0] }
        Feature { tag: "kern", lookups: [0] }
    ]
    open(gpos([Script { tag: "DFLT", features: [0, 1] }], features, [classes(), second_classes()]), [])
}

fn wrapped() -> font.Font {
    let inner = pair1(coverage1([4]), 4, 0, [[[6, -25]]])
    let decoy = pair1(coverage1([4]), 4, 0, [[[6, -1000]]])
    let lookups = [lookup(9, [extension(2, inner)]), lookup(9, [extension(1, decoy)]), lookup(1, [decoy])]
    open(kern_gpos(lookups), [])
}

fn script_font(scripts: []str, values: []i64) -> font.Font {
    var lookups: [][]u8 = []
    var features: []Feature = []
    var tables: []Script = []
    for i in 0..scripts.len {
        lookups.push(lookup(2, [pair_pos(3, 4, values[i])]))
        features.push(Feature { tag: "kern", lookups: [i] })
        tables.push(Script { tag: scripts[i], features: [i] })
    }
    open(gpos(tables, features, lookups), [])
}

fn no_kern_feature(feature_tag: str, lookup_index: i64) -> font.Font {
    let lookups = [lookup(2, [pair_pos(3, 4, -50)])]
    let data = gpos([Script { tag: "DFLT", features: [0] }], [Feature { tag: feature_tag, lookups: [lookup_index] }], lookups)
    open(data, [1, 2, -2, 3, 4, -9])
}

fn broken(what: str) -> i64 {
    var sub = pair_pos(3, 4, -50)
    if what == "coverage" {
        io.set_be16(sub, 2, 65535)
    } else if what == "pair set" {
        io.set_be16(sub, 10, 65535)
    } else if what == "format" {
        io.set_be16(sub, 0, 3)
    }
    var direct = lookup(2, [sub])
    if what == "subtable" {
        io.set_be16(direct, 6, 65535)
    }
    var ext = extension(2, sub)
    if what == "extension" {
        io.set_be32(ext, 4, 2147483647)
    } else if what == "extension type" {
        io.set_be16(ext, 2, 9)
    }
    let wrapped = lookup(9, [ext])
    let chosen = if what.len >= 9 && what[0..9] == "extension" { wrapped } else { direct }
    var data = kern_gpos([chosen])
    if what == "script list" {
        io.set_be16(data, 4, 65535)
    } else if what == "feature list" {
        io.set_be16(data, 6, 65535)
    } else if what == "lookup list" {
        io.set_be16(data, 8, 65535)
    }
    open(data, []).kern(3, 4)
}

fn truncated() {
    let data = kern_gpos([lookup(2, [pair_pos(3, 4, -50)])])
    var zero = 0
    var full = 0
    var other = 0
    for cut in 0..data.len + 1 {
        var part: []u8 = []
        for i in 0..cut {
            part.push(data[i])
        }
        let v = open(part, []).kern(3, 4)
        match v {
            0 => {
                zero += 1
            }
            -50 => {
                full += 1
            }
            _ => {
                other += 1
            }
        }
    }
    print("truncated {data.len + 1}: zero {zero} full {full} other {other}")
}

fn main() {
    let a = pair_sets()
    kerns("format 1", a, [3, 4, 3, 7, 3, 5, 5, 2, 5, 3, 6, 1, 7, 1, 8, 8, 9, 1, 3, 2, 4, 1, 10, 1, 0, 0, -1, 4, 3, 70000])

    let b = open(kern_gpos([classes()]), [])
    kerns("format 2", b, [2, 5, 2, 6, 2, 8, 2, 12, 2, 13, 2, 7, 2, 4, 3, 5, 3, 9, 4, 6, 10, 5, 10, 11, 11, 5, 5, 5])

    kerns("summed", summed(), [2, 6, 2, 5, 3, 6, 4, 6, 10, 5, 3, 9])

    kerns("extension", wrapped(), [4, 6, 6, 4, 4, 7])

    let both = open(kern_gpos([lookup(2, [pair_pos(3, 4, -50)])]), [1, 2, -2, 3, 4, -9])
    kerns("both", both, [3, 4, 1, 2])
    kerns("kern only", open([], [1, 2, -2, 3, 4, -9]), [3, 4, 1, 2])

    kerns("mark feature", no_kern_feature("mark", 0), [3, 4, 1, 2])
    kerns("bad lookup index", no_kern_feature("kern", 5), [3, 4, 1, 2])

    kerns("latn over DFLT", script_font(["DFLT", "latn"], [-1, -2]), [3, 4])
    kerns("latn over first", script_font(["arab", "latn", "DFLT"], [-1, -2, -3]), [3, 4])
    kerns("DFLT over first", script_font(["arab", "DFLT"], [-3, -4]), [3, 4])
    kerns("first script", script_font(["cyrl", "grek"], [-5, -6]), [3, 4])

    var line = "malformed"
    for what in ["intact", "script list", "feature list", "lookup list", "subtable", "coverage", "pair set", "format", "extension", "extension type"] {
        line = "{line} {what}={broken(what)}"
    }
    print(line)
    truncated()
    print("short table {open([0, 1, 0, 0], [1, 2, -2]).kern(1, 2)}")
}
