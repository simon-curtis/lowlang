import std/crypto/password
import std/text

fn describe(e: password.Error) -> str {
    match e {
        InvalidParameters => "InvalidParameters"
        MemoryLimit => "MemoryLimit"
        InvalidCost => "InvalidCost"
        InvalidSalt => "InvalidSalt"
        PasswordTooLong => "PasswordTooLong"
    }
}

fn show(p: str, s: str, n: i64, r: i64, pl: i64, length: i64, limit: i64) {
    let out = password.scrypt(bytes(p), bytes(s), n, r, pl, length, limit) catch {
        e => {
            print(describe(e))
            return
        }
    }
    print(text.encode_hex(out))
}

fn check(pw: str, encoded: str) {
    print("{password.verify(pw, encoded)} {encoded}")
}

fn main() {
    let limit = 1073741824
    show("", "", 16, 1, 1, 64, limit)
    show("password", "NaCl", 1024, 8, 16, 64, limit)
    show("pleaseletmein", "SodiumChloride", 16384, 8, 1, 64, limit)
    show("pw", "s", 2, 1, 1, 1, limit)
    show("pw", "salty", 256, 3, 3, 100, limit)
    show("pw", "salty", 3, 1, 1, 16, limit)
    show("pw", "salty", 0, 1, 1, 16, limit)
    show("pw", "salty", 1, 1, 1, 16, limit)
    show("pw", "salty", 16, 0, 1, 16, limit)
    show("pw", "salty", 16, 1, 0, 16, limit)
    show("pw", "salty", 16, 1, 1, 0, limit)
    show("pw", "salty", 16, 1073741824, 1, 16, limit)
    show("pw", "salty", 1048576, 8, 1, 16, 1048576)
    show("pw", "salty", 16, 1, 1, 16, 2303)
    show("pw", "salty", 16, 1, 1, 16, 2304)
    print(password.scrypt_memory(16384, 8, 1))
    check("hunter2", "$scrypt$ln=10,r=8,p=2$ICEiIyQlJicoKSorLC0uLw$YwcZKzJdfvuduvzFsQ/XAoJ9ggPqfK6QItUad27LurI")
    check("hunter3", "$scrypt$ln=10,r=8,p=2$ICEiIyQlJicoKSorLC0uLw$YwcZKzJdfvuduvzFsQ/XAoJ9ggPqfK6QItUad27LurI")
    check("", "$scrypt$ln=2,r=1,p=1$c2FsdHNhbHQ$LgOv2U+CJJRSsioDdZ7GH0nD2rc")
    check("", "$scrypt$ln=2,r=1,p=1$c2FsdHNhbHQ$LgOv2U+CJJRSsioDdZ7GH1nD2rc")
    check("", "$scrypt$ln=0,r=1,p=1$c2FsdHNhbHQ$LgOv2U+CJJRSsioDdZ7GH0nD2rc")
    check("", "$scrypt$ln=40,r=1,p=1$c2FsdHNhbHQ$LgOv2U+CJJRSsioDdZ7GH0nD2rc")
    check("", "$scrypt$ln=30,r=1024,p=1$c2FsdHNhbHQ$LgOv2U+CJJRSsioDdZ7GH0nD2rc")
    check("", "$scrypt$r=1,ln=2,p=1$c2FsdHNhbHQ$LgOv2U+CJJRSsioDdZ7GH0nD2rc")
    check("", "$scrypt$ln=2,r=1$c2FsdHNhbHQ$LgOv2U+CJJRSsioDdZ7GH0nD2rc")
    check("", "$scrypt$ln=2,r=1,p=1$c2FsdHNhbHQ")
    let encoded = password.hash_scrypt("secret", 10, 8, 1) or ""
    print(encoded.len)
    print(encoded[..22])
    print(password.verify("secret", encoded))
    print(password.verify("Secret", encoded))
    let other = password.hash_scrypt("secret", 10, 8, 1) or ""
    print(other != encoded)
    let bad = password.hash_scrypt("secret", 0, 8, 1) catch {
        e => describe(e)
    }
    print(bad)
}
