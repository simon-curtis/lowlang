struct Row {
    label: str
    cells: i64[]
    next: *Row?
}

fn row(n: i64) -> Row {
    var cells: i64[] = []
    for i in 0..n {
        cells.push(i + n)
    }
    Row { label: "row {n}", cells, next: none }
}

fn chain(n: i64) -> *Row {
    let head = new(row(n))
    head.next = new(row(n + 1))
    head
}

fn width(r: *Row) -> i64 {
    let next = r.next ?? return r.cells.len
    r.cells.len + width(next)
}

fn main() {
    let rows = region {
        let a, b = fork { row(2), row(3) }
        [a, b]
    }
    print("{rows[0].label} {rows[0].cells} {rows[1].label} {rows[1].cells}")
    let summary = region {
        let left, right = fork { chain(1), chain(4) }
        let inner = region {
            let m, n = fork { width(left), width(right) }
            m + n
        }
        "{left.label} {right.label} {inner}"
    }
    print(summary)
    var seen = 0
    for round in 0..200 {
        seen += region {
            let a, b = fork { row(round % 7).cells.len, row(round % 5).label.len }
            a + b
        }
    }
    print(seen)
}
