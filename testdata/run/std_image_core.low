import std/hash
import std/image
import std/io
import std/text

fn rgba(r: u8, g: u8, b: u8, a: u8) -> image.Rgba {
    image.Rgba { r, g, b, a }
}

fn show(label: str, c: image.Rgba) {
    print("{label} {c.r} {c.g} {c.b} {c.a}")
}

fn pattern(width: i64, height: i64) -> image.Image {
    let img = image.create(width, height, Rgba16)
    for y in 0..height {
        for x in 0..width {
            let p = (y * width + x) * 8
            let r = (x * 65535) / (width - 1)
            let g = (y * 65535) / (height - 1)
            let b = ((x * 7 + y * 13) % 32) * 2047
            let a = if (x + y) % 5 == 0 { 0 } else { 65535 - ((x * y * 997) % 40000) }
            for k, v in [r, g, b, a] {
                img.pixels[p + k * 2] = u8(v >> 8)
                img.pixels[p + k * 2 + 1] = u8(v)
            }
        }
    }
    img
}

fn smooth(width: i64, height: i64) -> image.Image {
    let img = image.create(width, height, Rgb8)
    for y in 0..height {
        for x in 0..width {
            image.set(img, x, y, rgba(u8(x * 255 / (width - 1)), u8(y * 255 / (height - 1)), u8((x + y) * 255 / (width + height - 2)), 255))
        }
    }
    img
}

fn same(a: image.Image, b: image.Image) -> bool {
    if a.width != b.width || a.height != b.height || a.format != b.format || a.pixels.len != b.pixels.len {
        return false
    }
    for i in 0..a.pixels.len {
        if a.pixels[i] != b.pixels[i] {
            return false
        }
    }
    true
}

fn close_to(a: image.Image, b: image.Image, max_mse: f64) -> bool {
    let x = image.convert(a, Rgb8).pixels
    let y = image.convert(b, Rgb8).pixels
    if x.len != y.len {
        return false
    }
    var total = 0
    for i in 0..x.len {
        let d = i64(x[i]) - i64(y[i])
        total += d * d
    }
    f64(total) / f64(x.len) < max_mse
}

fn outcome(data: []u8) -> str {
    let img = image.decode(data) catch {
        Malformed => return "Malformed"
        Unsupported => return "Unsupported"
        TooLarge => return "TooLarge"
        _ => return "other"
    }
    "{img.width}x{img.height}"
}

fn limited(data: []u8, max_pixels: i64) -> str {
    let img = image.decode_limited(data, max_pixels) catch {
        TooLarge => return "TooLarge"
        _ => return "other"
    }
    "{img.width}x{img.height}"
}

fn chunk(kind: str, body: []u8) -> []u8 {
    var out: []u8 = []
    io.put_be32(mut out, body.len)
    var typed: []u8 = []
    text.append(mut typed, kind)
    io.append(mut typed, body)
    io.append(mut out, typed)
    io.put_be32(mut out, i64(hash.crc32(typed)))
    out
}

fn png_bomb() -> []u8 {
    var out: []u8 = [0x89, 'P', 'N', 'G', 0x0D, 0x0A, 0x1A, 0x0A]
    var header: []u8 = []
    io.put_be32(mut header, 100000)
    io.put_be32(mut header, 100000)
    io.append(mut header, [8, 6, 0, 0, 0])
    io.append(mut out, chunk("IHDR", header))
    io.append(mut out, chunk("IDAT", [0x78, 0x9C, 0x03, 0x00, 0x00, 0x00, 0x00, 0x01]))
    io.append(mut out, chunk("IEND", []))
    out
}

fn bmp565() -> []u8 {
    var out: []u8 = ['B', 'M']
    for v in [70, 0, 66, 40, 2, 1] {
        io.put_le32(mut out, v)
    }
    io.append(mut out, [1, 0, 16, 0])
    for v in [3, 4, 0, 0, 0, 0, 0xF800, 0x07E0, 0x001F] {
        io.put_le32(mut out, v)
    }
    io.append(mut out, [0x00, 0x84, 0xEF, 0x7B])
    out
}

fn geometry() {
    let img = image.create(3, 2, Rgb8)
    for y in 0..2 {
        for x in 0..3 {
            image.set(img, x, y, rgba(u8(x * 10 + y), 0, 0, 255))
        }
    }
    let views = [image.rotate90(img), image.rotate180(img), image.rotate270(img), image.flip_horizontal(img), image.flip_vertical(img), image.transpose(img), image.crop(img, 1, 0, 5, 1)]
    for v in views {
        var line = "{v.width}x{v.height}"
        for y in 0..v.height {
            for x in 0..v.width {
                line = "{line} {image.get(v, x, y).r}"
            }
        }
        print(line)
    }
    for o in 1..9 {
        let t = image.orient(img, o)
        print("orient {o} {t.width}x{t.height} {image.get(t, 0, 0).r}")
    }
}

fn pixels() {
    let img = image.create(4, 3, Rgba8)
    image.set(img, 1, 1, rgba(200, 100, 50, 128))
    show("get", image.get(img, 1, 1))
    show("outside", image.get(img, 9, 1))
    image.set(img, -1, 0, rgba(1, 1, 1, 1))
    for f in [image.Format.Gray8, GrayAlpha8, Rgb8, Rgba8, Gray16, Rgba16] {
        let c = image.convert(img, f)
        show("convert {image.channels(f)} {image.bytes_per_pixel(f)}", image.get(c, 1, 1))
    }
    let pre = image.premultiply(img)
    show("premultiplied", image.get(pre, 1, 1))
    show("unpremultiplied", image.get(image.unpremultiply(pre), 1, 1))
    image.fill_rect(img, 2, -1, 10, 3, rgba(9, 8, 7, 255))
    show("fill", image.get(img, 3, 1))
    show("unfilled", image.get(img, 3, 2))
    let dst = image.create(2, 2, Rgba8)
    image.fill_rect(dst, 0, 0, 2, 2, rgba(255, 0, 0, 255))
    let src = image.create(2, 2, Rgba8)
    image.fill_rect(src, 0, 0, 2, 2, rgba(0, 0, 255, 128))
    image.blend(dst, src, 1, 1)
    show("blend", image.get(dst, 1, 1))
    show("unblended", image.get(dst, 0, 1))
    let clear = image.create(1, 1, Rgba8)
    image.blend(clear, src, 0, 0)
    show("blend clear", image.get(clear, 0, 0))
    let opaque = image.create(1, 1, Rgb8)
    image.fill_rect(opaque, 0, 0, 1, 1, rgba(0, 255, 0, 255))
    image.blend(opaque, src, 0, 0)
    show("blend rgb", image.get(opaque, 0, 0))
    let made = image.from_pixels(2, 1, Rgb8, [1, 2, 3, 4, 5, 6]) catch {
        _ => image.create(0, 0, Rgb8)
    }
    show("from_pixels", image.get(made, 1, 0))
    let bad = image.from_pixels(2, 2, Rgb8, [1, 2, 3]) catch {
        Invalid => image.create(7, 7, Rgb8)
        _ => image.create(0, 0, Rgb8)
    }
    print("from_pixels short {bad.width}")
}

fn resizing() {
    let img = pattern(13, 9)
    let flat = image.create(9, 7, Rgba8)
    image.fill_rect(flat, 0, 0, 9, 7, rgba(40, 80, 120, 200))
    for f in [image.Filter.Nearest, Bilinear, Bicubic, Lanczos3] {
        let up = image.resize(img, 29, 20, f)
        let down = image.resize(img, 5, 4, f)
        let still = image.resize(flat, 23, 3, f)
        var steady = true
        for y in 0..still.height {
            for x in 0..still.width {
                let c = image.get(still, x, y)
                if c.r != 40 || c.g != 80 || c.b != 120 || c.a != 200 {
                    steady = false
                }
            }
        }
        print("resize {up.width}x{up.height} {down.width}x{down.height} constant {steady}")
    }
    let small = image.create(2, 1, Gray8)
    image.set(small, 0, 0, rgba(0, 0, 0, 255))
    image.set(small, 1, 0, rgba(255, 255, 255, 255))
    let near = image.resize(small, 4, 1, Nearest)
    let linear = image.resize(small, 4, 1, Bilinear)
    var a = "nearest"
    var b = "bilinear"
    for x in 0..4 {
        a = "{a} {image.get(near, x, 0).r}"
        b = "{b} {image.get(linear, x, 0).r}"
    }
    print(a)
    print(b)
}

fn round_trips() {
    let base = pattern(37, 29)
    for f in [image.Format.Gray8, GrayAlpha8, Rgb8, Rgba8, Gray16, Rgba16] {
        let img = image.convert(base, f)
        let png = image.decode(image.encode_png(img)) catch {
            _ => image.create(0, 0, f)
        }
        let qoi = image.decode(image.encode_qoi(img)) catch {
            _ => image.create(0, 0, f)
        }
        let bmp = image.decode(image.encode_bmp(img)) catch {
            _ => image.create(0, 0, f)
        }
        let wide = image.has_alpha(f)
        let flat = if wide { image.Format.Rgba8 } else { image.Format.Rgb8 }
        print("png {same(png, img)} qoi {same(qoi, image.convert(img, flat))} bmp {same(bmp, image.convert(img, flat))}")
    }
    let empty: []image.Rgba = []
    let few = image.create(31, 17, Rgba8)
    for y in 0..17 {
        for x in 0..31 {
            let a: u8 = if x == y { 0 } else { 255 }
            image.set(few, x, y, rgba(u8(x % 8 * 32), u8(y % 4 * 80), u8((x + y) % 3 * 100), a))
        }
    }
    let gif = image.decode(image.encode_gif(few, empty)) catch {
        _ => image.create(0, 0, Rgba8)
    }
    var exact = true
    for y in 0..17 {
        for x in 0..31 {
            let p = image.get(gif, x, y)
            let q = image.get(few, x, y)
            if p.a != q.a || q.a != 0 && (p.r != q.r || p.g != q.g || p.b != q.b) {
                exact = false
            }
        }
    }
    print("gif exact {exact}")
    let gradient = smooth(37, 29)
    let palette = image.median_cut(gradient, 16)
    let quantized = image.decode(image.encode_gif(gradient, palette)) catch {
        _ => image.create(0, 0, Rgba8)
    }
    print("gif palette {palette.len} {quantized.width}x{quantized.height} mse {close_to(quantized, gradient, 400.0)}")
    let big = pattern(300, 220)
    let lzw = image.decode(image.encode_gif(image.convert(big, Rgb8), image.median_cut(big, 256))) catch {
        _ => image.create(0, 0, Rgba8)
    }
    print("gif large {lzw.width}x{lzw.height} mse {close_to(lzw, big, 205.0)}")
    for q in [1, 50, 90, 100] {
        let jpeg = image.decode(image.encode_jpeg(gradient, q)) catch {
            _ => image.create(0, 0, Rgb8)
        }
        let limit = if q == 1 { 1000.0 } else if q == 50 { 15.0 } else if q == 90 { 4.0 } else { 1.5 }
        print("jpeg q{q} {jpeg.width}x{jpeg.height} mse {close_to(jpeg, gradient, limit)}")
    }
    let gray = image.decode(image.encode_jpeg(image.convert(base, Gray8), 95)) catch {
        _ => image.create(0, 0, Gray8)
    }
    print("jpeg gray {gray.format == Gray8} mse {close_to(gray, image.convert(base, Gray8), 6.0)}")
}

fn errors() {
    let empty: []u8 = []
    print("empty {outcome(empty)}")
    print("unknown {outcome([1, 2, 3, 4])}")
    let png = image.encode_png(pattern(5, 4))
    print("png ok {outcome(png)}")
    print("png truncated {outcome(png[..png.len - 20])}")
    var copy: []u8 = []
    io.append(mut copy, png)
    copy[40] = copy[40] ^ 1
    print("png crc {outcome(copy)}")
    print("png bomb {outcome(png_bomb())}")
    print("png limited {limited(png, 19)} {limited(png, 20)}")
    let jpeg = image.encode_jpeg(pattern(5, 4), 80)
    print("jpeg truncated {outcome(jpeg[..jpeg.len / 2])}")
    print("jpeg limited {limited(jpeg, 19)}")
    let gif: []u8 = [0x47, 0x49, 0x46, 0x38, 0x39, 0x61, 0xFF, 0xFF, 0xFF, 0xFF, 0, 0, 0, 0x3B]
    print("gif bomb {outcome(gif)}")
    print("bmp 565 {outcome(bmp565())}")
    let bmp = image.decode(bmp565()) catch {
        _ => image.create(0, 0, Rgb8)
    }
    show("bmp 565 first", image.get(bmp, 0, 0))
    show("bmp 565 second", image.get(bmp, 1, 0))
    let qoi = image.encode_qoi(pattern(3, 3))
    print("qoi truncated {outcome(qoi[..12])}")
}

fn main() {
    geometry()
    pixels()
    resizing()
    round_trips()
    errors()
}
