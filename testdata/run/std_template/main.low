import std/io
import std/slices
import std/template
import std/text

struct Item {
    name: str
    price: str?
}

enum Role {
    Admin
    Guest(name: str)
    Staff(level: i64, team: str)
}

struct Account {
    id: i64
    owner: str
    role: Role
    scores: [str: i64]
    note: str?
    tags: []str
    ratio: f64
}

fn run(options: template.Options, source: str, data: template.Data) -> str {
    var s = template.set(options)
    s.add("t", source) catch {
        e => return "! {template.describe(e)}"
    }
    template.render(s, "t", data) catch {
        e => "! {template.describe(e)}"
    }
}

fn show(source: str, data: template.Data) {
    print(run(template.Options {}, source, data))
}

fn show_plain(source: str, data: template.Data) {
    print(run(template.Options { escape: None }, source, data))
}

fn show_strict(source: str, data: template.Data) {
    print(run(template.Options { strict: true }, source, data))
}

fn account() -> template.Data {
    let scores: [str: i64] = ["math": 90, "art": 75, "pe": 60]
    template.to_data(Account {
        id: 7
        owner: "Ada <Lovelace> & \"co\""
        role: Role.Staff(3, "core")
        scores
        note: none
        tags: ["go", "low", "c"]
        ratio: 0.25
    })
}

fn derivation() {
    let d = account()
    show("{{{{ id }}}} {{{{ owner }}}}", d)
    show("{{{{ role.Staff.level }}}} {{{{ role.Staff.team }}}}", d)
    show("[{{{{ note }}}}] [{{{{ note | default(\"none\") }}}}] {{{{ ratio }}}}", d)
    show("{{{{ for k, v in scores }}}}{{{{ k }}}}={{{{ v }}}}{{{{ if !@last }}}},{{{{ end }}}}{{{{ end }}}}", d)
    show("{{{{ for k in scores }}}}{{{{ k }}}} {{{{ end }}}}", d)
    show("{{{{ tags | join(\"+\") }}}} {{{{ tags | len }}}} {{{{ tags[1] }}}} {{{{ tags.2 }}}}", d)
    let guest = template.to_data(Role.Guest("zed"))
    show("{{{{ Guest.name }}}}", guest)
    show("{{{{ if scores.math > 80 && \"low\" in tags }}}}strong{{{{ end }}}}", d)
}

fn pair(name: str, price: str?) -> template.Data {
    template.to_data(Item { name, price })
}

fn site(extra: [str: template.Data]) -> template.Data {
    let entries: [str: template.Data] = ["site": template.Data.Str("low & co"), "year": template.Data.Int(2026)]
    for k, v in extra {
        entries[k] = v
    }
    template.Data.Map(entries)
}

fn pages() {
    var s = template.set(template.Options {})
    for name in ["layout.html", "footer.html", "page.html", "special.html"] {
        let source = match name {
            == "layout.html" => embed("layout.html")
            == "footer.html" => embed("footer.html")
            == "page.html" => embed("page.html")
            _ => embed("special.html")
        }
        s.add(name, source) catch {
            e => print("! {template.describe(e)}")
        }
    }
    let items = template.Data.List([pair("pen", "1.50"), pair("ink <blue>", none), pair("pad", "3")])
    let first = site(["title": template.Data.Str("Shop"), "items": items])
    print(template.render(s, "page.html", first) catch { e => template.describe(e) })
    print(template.render(s, "special.html", site(["title": template.Data.Str("Empty"), "items": template.Data.List([])])) catch { e => template.describe(e) })
    print(template.render(s, "footer.html", site([:])) catch { e => template.describe(e) })
    print(template.render(s, "missing.html", site([:])) catch { e => template.describe(e) })
}

fn scope() -> template.Data {
    template.from_json("{{\"a\": 3, \"b\": 4.5, \"name\": \"x\", \"list\": [1, 2, 3], \"nest\": {{\"deep\": {{\"v\": true}}}}, \"empty\": [], \"n\": 1, \"words\": [\"<a>\", \"b\"], \"s\": \"h\\u00e9llo w\\u00f6rld\", \"nothing\": null}}") catch {
        _ => template.Data.Null
    }
}

fn syntax() {
    let d = scope()
    show("{{{{ 1 + 2 * 3 }}}}|{{{{ (1 + 2) * 3 }}}}|{{{{ 7 / 2 }}}}|{{{{ 7 % 4 }}}}|{{{{ 7 / 2.0 }}}}|{{{{ a - b }}}}|{{{{ -a }}}}|{{{{ \"a\" + \"b\" }}}}|{{{{ 1.5 + 1 }}}}", d)
    show("{{{{ a < b }}}} {{{{ a == 3 }}}} {{{{ a == 3.0 }}}} {{{{ name == \"x\" }}}} {{{{ name != \"y\" }}}} {{{{ a >= 4 }}}} {{{{ b <= 4.5 }}}} {{{{ \"abc\" < \"abd\" }}}}", d)
    show("{{{{ a > 5 || \"fallback\" }}}} {{{{ name && \"yes\" }}}} {{{{ !empty }}}} {{{{ empty || \"none\" }}}} {{{{ a && b }}}} {{{{ !!a }}}}", d)
    show("{{{{ 2 in list }}}} {{{{ 9 in list }}}} {{{{ \"deep\" in nest }}}} {{{{ \"k\" in nest }}}} {{{{ \"ab\" in \"cabd\" }}}}", d)
    show("{{{{ nest.deep.v }}}} {{{{ nest[\"deep\"][\"v\"] }}}} {{{{ list[0] }}}}{{{{ list.1 }}}}{{{{ list[a - 1] }}}} [{{{{ nest.nothing.v }}}}] [{{{{ list[9] }}}}] [{{{{ nothing.x }}}}]", d)
    show("{{{{ let x = a * 2 }}}}{{{{ x }}}} {{{{ if true }}}}{{{{ let y = 1 }}}}{{{{ y }}}}{{{{ end }}}}[{{{{ y }}}}]", d)
    show("{{{{ for i in list }}}}{{{{ for j in list }}}}{{{{ if j > i }}}}{{{{ i }}}}{{{{ j }}}}@{{{{ @index }}}} {{{{ end }}}}{{{{ end }}}}{{{{ end }}}}", d)
    show("{{{{ for i, x in list }}}}{{{{ i }}}}:{{{{ x }}}}{{{{ if @last }}}}.{{{{ else }}}},{{{{ end }}}}{{{{ end }}}}", d)
    show("{{{{ for x in list }}}}{{{{ let sq = x * x }}}}{{{{ sq }}}} {{{{ end }}}}[{{{{ sq }}}}]", d)
    show("{{{{ for x in empty }}}}{{{{ x }}}}{{{{ else }}}}empty{{{{ end }}}} {{{{ for x in nothing }}}}{{{{ x }}}}{{{{ else }}}}null{{{{ end }}}}", d)
    show("{{{{ if a > 5 }}}}big{{{{ else if a > 2 }}}}mid{{{{ else if a > 1 }}}}small{{{{ else }}}}tiny{{{{ end }}}}", d)
    show("a  {{{{- \"b\" -}}}}  c {{{{# note -}}}}   d\n  {{{{- \"e\" }}}}\n", d)
    show("{{{{# a comment }}}}x{{{{ true }}}}{{{{ none }}}}{{{{ null }}}}{{{{ false }}}}", d)
    show("{{{{ \"{{{{\" }}}} {{{{ \"a}}}}b\" }}}} {{{{ 'it\\'s' }}}} {{{{ \"t\\tn\\\\\" }}}}", d)
    show("{{{{ name }}}}", template.Data.Int(5))
    show("{{{{- 5 -}}}}{{{{- if true -}}}} x {{{{- end -}}}}", d)
}

fn label(args: []template.Data) -> str {
    if args.len == 0 {
        return "b"
    }
    match args[0] {
        Str(text) => text
        _ => "b"
    }
}

fn filters() {
    let d = scope()
    show("{{{{ \"  Hello \" | trim | upper }}}}|{{{{ \"MiXed\" | lower }}}}|{{{{ s | len }}}}|{{{{ list | len }}}}|{{{{ nest | len }}}}|{{{{ nothing | len }}}}", d)
    show("{{{{ missing | default(\"d\") }}}}|{{{{ \"\" | default(\"e\") }}}}|{{{{ 0 | default(\"z\") }}}}|{{{{ 0 | default(\"z\", true) }}}}|{{{{ false | default(1, true) }}}}|{{{{ name | default(\"q\") }}}}|{{{{ nothing | default(a) }}}}", d)
    show("{{{{ list | join(\", \") }}}}|{{{{ list | join }}}}|{{{{ words | join(\"&\") }}}}", d)
    show_plain("{{{{ words | join(\"&\") }}}}|{{{{ \"<b>\" }}}}|{{{{ \"<b>\" | escape }}}}", d)
    show("{{{{ \"<i>\" | escape }}}}|{{{{ \"<i>\" | escape | escape }}}}|{{{{ \"<i>\" | raw }}}}|{{{{ \"<i>\" | raw | upper }}}}|{{{{ 5 | escape }}}}", d)
    show("{{{{ nest | json }}}}|{{{{ list | json(2) }}}}|{{{{ \"</script>&'\\\"\" | json }}}}|{{{{ a | json }}}}|{{{{ nothing | json }}}}", d)
    show("{{{{ \"a b&c/é~-_.\" | url }}}}", d)
    show("{{{{ 1700000000 | date(\"%Y-%m-%d %H:%M:%S\") }}}}|{{{{ 0 | date }}}}|{{{{ \"2024-02-29T10:30:00+02:00\" | date(\"%d %b %Y %H:%M %z\") }}}}", d)
    show("{{{{ s | truncate(5) }}}}|{{{{ s | truncate(20) }}}}|{{{{ s | truncate(3, \"~\") }}}}|{{{{ s | truncate(0, \"\") }}}}", d)
    show("{{{{ n }}}} item{{{{ n | pluralize }}}}, {{{{ a }}}} item{{{{ a | pluralize }}}}, {{{{ n }}}} cit{{{{ n | pluralize(\"y\", \"ies\") }}}}, {{{{ a }}}} cit{{{{ a | pluralize(\"y\", \"ies\") }}}}, {{{{ a }}}} box{{{{ a | pluralize(\"es\") }}}}, {{{{ list | pluralize }}}}", d)
    show("{{{{ \"a-b-c\" | replace(\"-\", \"+\") }}}}|{{{{ list | first }}}}|{{{{ list | last }}}}|{{{{ s | first }}}}|{{{{ s | last }}}}|{{{{ nest | keys | join(\",\") }}}}|{{{{ empty | first }}}}", d)
    show("{{{{ list | join(\"-\") | upper | len }}}}|{{{{ words | first | len }}}}", d)

    var s = template.set(template.Options {})
    s.add_filter("double", fn(v, args) -> template.Data ! template.FilterError {
        match v {
            Int(n) => template.Data.Int(n * 2)
            _ => fail template.FilterError.Invalid("not an int")
        }
    })
    s.add_filter("wrap", fn(v, args) -> template.Data ! template.FilterError {
        let left = label(args)
        match v {
            Str(text) => template.Data.Safe("<{left}>{text}</{left}>")
            _ => template.Data.Str("?")
        }
    })
    s.add_filter("upper", fn(v, args) -> template.Data ! template.FilterError {
        template.Data.Str("custom")
    })
    s.add("t", "{{{{ a | double }}}}|{{{{ name | wrap }}}}|{{{{ name | wrap(\"em\") }}}}|{{{{ name | upper }}}}") catch {
        e => print("! {template.describe(e)}")
    }
    print(template.render(s, "t", d) catch { e => template.describe(e) })
    s.add("u", "{{{{ a | double | double }}}}") catch {
        e => print("! {template.describe(e)}")
    }
    print(template.render(s, "u", d) catch { e => template.describe(e) })
    s.add("v", "line one\n{{{{ name | double }}}}") catch {
        e => print("! {template.describe(e)}")
    }
    print(template.render(s, "v", d) catch { e => template.describe(e) })
}

fn parse_errors() {
    let d = scope()
    show("a {{{{ b", d)
    show("{{{{# never ends", d)
    show("x\n  {{{{ if a }}}}no end", d)
    show("{{{{ for x in list }}}}no end", d)
    show("{{{{ if a }}}}x{{{{ else }}}}y{{{{ else }}}}z{{{{ end }}}}", d)
    show("line1\nline2 {{{{ end }}}}", d)
    show("{{{{ else }}}}", d)
    show("{{{{ x + }}}}", d)
    show("{{{{ x | }}}}", d)
    show("{{{{ x | f( }}}}", d)
    show("{{{{ (x }}}}", d)
    show("{{{{ x[1 }}}}", d)
    show("{{{{ \"abc }}}}", d)
    show("{{{{ for in x }}}}{{{{ end }}}}", d)
    show("{{{{ for x list }}}}{{{{ end }}}}", d)
    show("{{{{ let = 1 }}}}", d)
    show("{{{{ let x 1 }}}}", d)
    show("{{{{ x y }}}}", d)
    show("{{{{ include }}}}", d)
    show("{{{{ block \"b\" }}}}{{{{ end }}}}{{{{ block \"b\" }}}}{{{{ end }}}}", d)
    show("{{{{ extends \"a\" }}}}{{{{ extends \"b\" }}}}", d)
    show("{{{{ if true }}}}{{{{ extends \"a\" }}}}{{{{ end }}}}", d)
    show("{{{{ block b }}}}{{{{ end }}}}", d)
    show("ok\n\n{{{{ 12345678901234567890 }}}}", d)
    show("{{{{ # }}}}", d)
    show("{{{{ $ }}}}", d)
    show("{{{{ {text.repeat("(", 600)}1{text.repeat(")", 600)} }}}}", d)
    show("{{{{ {text.repeat("1 + ", 600)}1 }}}}", d)
    show("{{{{ {text.repeat("!", 600)}1 }}}}", d)
    show("{{{{ x{text.repeat(".a", 600)} }}}}", d)
    show(text.repeat("{{{{ if true }}}}", 150), d)
    show("{{{{ {text.repeat("(", 120)}1{text.repeat(")", 120)} }}}}", d)
}

fn render_errors() {
    let d = scope()
    show_strict("{{{{ nope }}}}", d)
    show_strict("ok\nok {{{{ nest.deep.zip }}}}", d)
    show_strict("{{{{ nest.deep.zip | default(\"fine\") }}}}|{{{{ nope | default(1) | upper }}}}", d)
    show_strict("{{{{ list[7] }}}}", d)
    show_strict("{{{{ nothing.x }}}}", d)
    show("{{{{ 1 / 0 }}}}", d)
    show("{{{{ 1 % 0 }}}}", d)
    show("{{{{ 1.5 % 2 }}}}", d)
    show("{{{{ list | nope }}}}", d)
    show("{{{{ list }}}}", d)
    show("{{{{ nest }}}}", d)
    show("{{{{ \"a\" < 1 }}}}", d)
    show("{{{{ \"a\" - 1 }}}}", d)
    show("{{{{ -name }}}}", d)
    show("{{{{ 1 in 2 }}}}", d)
    show("{{{{ 1 in \"abc\" }}}}", d)
    show("{{{{ for x in 5 }}}}{{{{ end }}}}", d)
    show("{{{{ @index }}}}", d)
    show("{{{{ include \"gone\" }}}}", d)
    show("{{{{ include 5 }}}}", d)
    show("{{{{ name.first }}}}", d)
    show("{{{{ list.first }}}}", d)
    show("{{{{ list[\"a\"] }}}}", d)
    show("{{{{ nest[list] }}}}", d)
    show("{{{{ a | join }}}}", d)
    show("{{{{ a | len(1) }}}}", d)
    show("{{{{ a | truncate }}}}", d)
    show("{{{{ a | truncate(\"x\") }}}}", d)
    show("{{{{ a | date }}}}|{{{{ name | date }}}}", d)
    show("{{{{ nest | upper }}}}", d)
    show("{{{{ true | pluralize }}}}", d)
    show("line 1\nline 2\n  {{{{ list | nope }}}}", d)
}

fn limits() {
    let d = scope()
    var loop = template.set(template.Options { max_depth: 8 })
    loop.add("self", "x{{{{ include \"self\" }}}}") catch {
        e => print("! {template.describe(e)}")
    }
    print(template.render(loop, "self", d) catch { e => template.describe(e) })
    loop.add("a", "a{{{{ include \"b\" }}}}") catch {
        e => print("! {template.describe(e)}")
    }
    loop.add("b", "b{{{{ include \"c\" }}}}") catch {
        e => print("! {template.describe(e)}")
    }
    loop.add("c", "c") catch {
        e => print("! {template.describe(e)}")
    }
    print(template.render(loop, "a", d) catch { e => template.describe(e) })
    var tight = template.set(template.Options { max_depth: 2 })
    tight.add("a", "a{{{{ include \"b\" }}}}") catch {
        e => print("! {template.describe(e)}")
    }
    tight.add("b", "b{{{{ include \"c\" }}}}") catch {
        e => print("! {template.describe(e)}")
    }
    tight.add("c", "c") catch {
        e => print("! {template.describe(e)}")
    }
    print(template.render(tight, "a", d) catch { e => template.describe(e) })
    loop.add("cycle1", "{{{{ extends \"cycle2\" }}}}") catch {
        e => print("! {template.describe(e)}")
    }
    loop.add("cycle2", "{{{{ extends \"cycle1\" }}}}") catch {
        e => print("! {template.describe(e)}")
    }
    print(template.render(loop, "cycle1", d) catch { e => template.describe(e) })

    var small = template.set(template.Options { max_output: 50 })
    small.add("big", "{{{{ for i in list }}}}0123456789012345678901234567890123456789{{{{ end }}}}") catch {
        e => print("! {template.describe(e)}")
    }
    print(template.render(small, "big", d) catch { e => template.describe(e) })
    small.add("fits", "{{{{ for i in list }}}}0123456789{{{{ end }}}}") catch {
        e => print("! {template.describe(e)}")
    }
    print(template.render(small, "fits", d) catch { e => template.describe(e) })
}

struct Capture {
    data: []u8
    writes: i64
}

fn capture_stream(c: *Capture, limit: i64) -> io.Stream {
    io.Stream {
        read: fn(buf) -> i64 ! io.Error { 0 }
        write: fn(buf) -> i64 ! io.Error {
            if c.data.len >= limit {
                fail io.Error.BrokenPipe
            }
            io.append(mut c.data, buf)
            c.writes += 1
            buf.len
        }
        close: fn() {}
    }
}

fn streaming() {
    var s = template.set(template.Options {})
    s.add("rows", "{{{{ for n in numbers }}}}{{{{ @index }}}}:{{{{ n | upper }}}};{{{{ end }}}}done") catch {
        e => print("! {template.describe(e)}")
    }
    var numbers: []template.Data = []
    for i in 0..4000 {
        push(mut numbers, template.Data.Str("n{i}"))
    }
    let entries: [str: template.Data] = ["numbers": template.Data.List(numbers)]
    let data = template.Data.Map(entries)
    let whole = template.render(s, "rows", data) catch { e => template.describe(e) }
    let c = new(Capture { data: [], writes: 0 })
    template.render_to(s, "rows", data, capture_stream(c, 1000000)) catch {
        e => print("! {template.describe(e)}")
    }
    print("{whole.len} {c.data.len} {str(c.data) == whole} {c.writes > 1}")
    print(whole[..24])
    print(whole[whole.len - 20..])
    let broken = new(Capture { data: [], writes: 0 })
    template.render_to(s, "rows", data, capture_stream(broken, 20000)) catch {
        e => print("! {template.describe(e)}")
    }
    print("{broken.data.len > 0}")
    template.render_to(s, "nothing", data, capture_stream(broken, 20000)) catch {
        e => print("! {template.describe(e)}")
    }
}

fn worker(s: template.Set, id: i64, rounds: i64, results: chan[str]) {
    var last = ""
    for i in 0..rounds {
        let entries: [str: template.Data] = [
            "id": template.Data.Int(id)
            "round": template.Data.Int(i)
            "items": template.Data.List([template.Data.Str("a<{id}>"), template.Data.Str("b")])
        ]
        last = template.render(s, "job", template.Data.Map(entries)) catch {
            e => template.describe(e)
        }
    }
    results <- last
}

fn threads() {
    var s = template.set(template.Options {})
    s.add("job", "worker {{{{ id }}}} round {{{{ round }}}}: {{{{ for it in items }}}}{{{{ it }}}}{{{{ if !@last }}}}, {{{{ end }}}}{{{{ end }}}}") catch {
        e => print("! {template.describe(e)}")
    }
    let results = chan[str](8)
    for id in 0..8 {
        spawn worker(s, id, 300, results)
    }
    var lines: []str = []
    for i in 0..8 {
        let line = (<-results) ?? ""
        push(mut lines, line)
    }
    slices.sort(mut lines)
    for line in lines {
        print(line)
    }
}

fn main() {
    derivation()
    pages()
    syntax()
    filters()
    parse_errors()
    render_errors()
    limits()
    streaming()
    threads()
}
