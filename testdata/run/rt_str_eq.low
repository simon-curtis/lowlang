fn content(length: i64, seed: i64) -> []u8 {
    var out: []u8 = []
    var state = seed
    for i in 0..length {
        state = (state * 1103515245 + 12345) % 2147483648
        push(mut out, u8(97 + state / 65536 % 26))
    }
    out
}

fn aligned(bytes: []u8, offset: i64) -> str {
    var buf: []u8 = []
    for i in 0..offset {
        push(mut buf, 'x')
    }
    for b in bytes {
        push(mut buf, b)
    }
    for i in 0..9 {
        push(mut buf, 'y')
    }
    let whole = str(buf)
    whole[offset..offset + bytes.len]
}

fn flipped(bytes: []u8, at: i64) -> []u8 {
    var copy = bytes[0..bytes.len]
    var out: []u8 = []
    for i in 0..copy.len {
        if i == at {
            push(mut out, copy[i] ^ 1)
        } else {
            push(mut out, copy[i])
        }
    }
    out
}

fn main() {
    for length in 0..41 {
        let bytes = content(length, length * 7 + 1)
        var equal = 0
        var unequal = 0
        var prefix = 0
        for left in 0..8 {
            for right in 0..8 {
                let a = aligned(bytes, left)
                let b = aligned(bytes, right)
                if a == b {
                    equal += 1
                }
                if a != b {
                    unequal += 1
                }
                for at in 0..length {
                    let c = aligned(flipped(bytes, at), right)
                    if a == c {
                        unequal += 1000
                    } else {
                        prefix += 1
                    }
                    if c == a {
                        unequal += 1000
                    }
                }
                let longer = aligned(content(length + 1, length * 7 + 1), right)
                if a == longer || longer == a {
                    unequal += 1000
                }
                if a == longer[0..length] {
                    prefix += 0
                } else {
                    unequal += 1000
                }
            }
        }
        print("{length} {equal} {unequal} {prefix}")
    }
    let same = "abcdefghijklmnop"
    print(same == same)
    print(same[0..8] == same[8..16])
    print(same[0..8] == same[0..8])
    print("" == "")
    print("a" == "")
}
