import std/bits/roaring
import std/hash
import std/io
import std/text

struct Rng {
    state: u64
}

fn next(r: *Rng) -> u64 {
    r.state = r.state * 6364136223846793005 + 1442695040888963407
    r.state >> 33
}

fn recipe(id: i64) -> *roaring.Roaring {
    let b = roaring.roaring()
    let r = new(Rng { state: u64(id) * 0x9E3779B97F4A7C15 + 7 })
    var optimize = false
    if id == 1 {
        for v in [0, 1, 65535, 65536, 0xFFFFFFFF] {
            roaring.add(b, u32(v))
        }
    } else if id == 2 {
        for _ in 0..5000 {
            roaring.add(b, u32(next(r) % 65536))
        }
    } else if id == 3 {
        for i in 0..4096 {
            roaring.add(b, u32(2 * i))
        }
    } else if id == 4 || id == 5 {
        roaring.add_range(b, 10, 20000)
        roaring.add_range(b, 70000, 70003)
        roaring.add(b, 1 << 20)
        roaring.add_range(b, 0xFFFF0000, 1 << 32)
        for _ in 0..300 {
            roaring.add(b, u32(200000 + next(r) % 100000))
        }
        optimize = id == 5
    } else if id == 6 || id == 8 {
        for _ in 0..20 {
            let lo = next(r) % (6 * 65536)
            let hi = lo + next(r) % 20000
            roaring.add_range(b, i64(lo), i64(hi))
        }
        for _ in 0..3000 {
            roaring.add(b, u32(next(r) % (6 * 65536)))
        }
        for _ in 0..8 {
            let lo = next(r) % (6 * 65536)
            let hi = lo + next(r) % 5000
            roaring.remove_range(b, i64(lo), i64(hi))
        }
        optimize = id == 6
    } else if id == 7 {
        roaring.add_range(b, 0, 100)
        roaring.add_range(b, 65536, 65600)
        roaring.add(b, 200000)
        optimize = true
    }
    if optimize {
        roaring.run_optimize(b)
    }
    b
}

fn same(a: []u8, b: []u8) -> bool {
    if a.len != b.len {
        return false
    }
    for i, x in a {
        if b[i] != x {
            return false
        }
    }
    true
}

fn bytes_of(hex: str) -> []u8 {
    text.decode_hex(hex) catch {
        _ => []
    }
}

fn spec_vectors() {
    let plain = roaring.roaring()
    roaring.add(plain, 1)
    roaring.add(plain, 2)
    roaring.add(plain, 0x10000)
    let plain_bytes = bytes_of("3a300000020000000000010001000000180000001c000000010002000000")
    print("spec plain {same(roaring.serialize(plain), plain_bytes)}")
    let runs = roaring.roaring()
    roaring.add_range(runs, 5, 10)
    roaring.run_optimize(runs)
    let run_bytes = bytes_of("3b3000000100000400010005000400")
    print("spec runs {same(roaring.serialize(runs), run_bytes)}")
    let decoded = roaring.deserialize(run_bytes) catch {
        _ => roaring.roaring()
    }
    print("spec decode {roaring.equal(decoded, runs)} {roaring.members(decoded).len} {roaring.min(decoded) ?? 0} {roaring.max(decoded) ?? 0}")
    let four = roaring.roaring()
    for k in 0..4 {
        roaring.add_range(four, k << 16, (k << 16) + 4)
    }
    roaring.run_optimize(four)
    let four_bytes = bytes_of("3b3003000f00000300010003000200030003000300250000002b0000003100000037000000010000000300010000000300010000000300010000000300")
    print("spec offsets {same(roaring.serialize(four), four_bytes)}")
}

fn rejected(hex: str) -> bool {
    let decoded = roaring.deserialize(bytes_of(hex)) catch {
        Malformed => return true
        _ => return false
    }
    roaring.cardinality(decoded) < 0
}

fn malformed() {
    let cases = [
        "",
        "3a30",
        "3a300000",
        "3930000000000000",
        "3a300000ffffffff",
        "3a300000020000000100000000000000180000001a00000005000700",
        "3a30000001000000000001001000000005000500",
        "3a3000000100000000000100110000000500060000",
        "3a30000001000000000002001000000005000600",
        "3b300000010000070002000000050003000100",
        "3b30000001000001000100ffff0100",
        "3b3000000100000900010005000400",
        "3b30000001000004000000",
        "3b300000010000040001000500",
    ]
    var summary: []u8 = []
    for hex in cases {
        push(mut summary, if rejected(hex) { 'r' } else { 'a' })
    }
    print("malformed {str(summary)}")
    print("valid {rejected("3b3000000100000400010005000400")} {rejected("3a30000000000000")}")
}

fn main() {
    for id in 0..9 {
        let b = recipe(id)
        let data = roaring.serialize(b)
        let back = roaring.deserialize(data) catch {
            _ => roaring.roaring()
        }
        print("recipe {id} {data.len} {hash.crc32(data)} {roaring.cardinality(b)} {roaring.equal(back, b)} {roaring.serialized_size(b) == data.len}")
    }
    spec_vectors()
    malformed()
}
