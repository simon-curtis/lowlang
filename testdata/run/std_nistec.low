}

struct Invalid {
    label: str
    a: str
    b: str
}

struct OrderCase {
    a: str
    b: str
    sum: str
    difference: str
    product: str
    negated: str
    inverse: str
}

struct Pair {
    input: str
    output: str
}

struct Canonical {
    input: str
    accepted: bool
}

