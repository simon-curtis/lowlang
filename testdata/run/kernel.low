import std/bits
import std/simd

struct Particle {
    x: f32
    y: f32
    hits: u32
}

enum Mode {
    Add
    Scale
}

fn span(a: f32, b: f32) -> f32 {
    b - a
}

fn mix(a: f32, b: f32, t: f32) -> f32 {
    a + span(a, b) * t
}

kernel fn saxpy(id: u32, a: f32, x: f32[], mut y: f32[]) {
    y[id] = a * x[id] + y[id]
}

pub kernel fn step(id: u32, mode: Mode, k: f32, mut ps: Particle[]) {
    let p = ps[id]
    let moved = match mode {
        Add => p.x + k
        Scale => p.x * k
    }
    ps[id].x = mix(p.x, moved, 0.5)
    if sqrt(p.y) > 1.0 {
        ps[id].hits = p.hits + 1
    }
}

kernel fn blur(id: u32, w: u32, h: u32, src: f32[], mut dst: f32[]) {
    let x = id % w
    let y = id / w
    var sum: f32 = 0.0
    var n: f32 = 0.0
    for dy in 0..3 {
        for dx in 0..3 {
            let sx = x + u32(dx)
            let sy = y + u32(dy)
            if sx >= 1 && sy >= 1 && sx - 1 < w && sy - 1 < h {
                sum += src[(sy - 1) * w + sx - 1]
                n += 1.0
            }
        }
    }
    dst[id] = sum / n
}

kernel fn edges(id: u32, mut out: f32[]) {
    out[0] = f32(0.5) + f32(id << 1)
    out[out.len - 1] = out[1..][0]
}

kernel fn lanes(id: u32, x: f32[], mut y: f32[]) {
    let at = i64(id) * 4
    let a: f32x4 = simd.read(x, at)
    let b: f32x4 = simd.read(y, at)
    simd.write(y, at, a + b)
}

kernel fn grow(id: u32, mut out: f32[]) {
    out[id] = f32(exp(f64(out[id])))
}

struct Cell {
    total: i64
    seen: u32
}

kernel fn search(id: u32, needle: u32, hay: u32[], mut found: i64[]) {
    var at: i64 = -1
    for i in 0..hay.len {
        if hay[i] == 0 {
            continue
        }
        if hay[i] == needle + id {
            at = i
            break
        }
    }
    found[id] = at
}

kernel fn grid(id: u32, w: u32, cells: u32[], mut out: u32[]) {
    var hits: u32 = 0
    var y: u32 = 0
    rows: for y < w {
        var x: u32 = 0
        for x < w {
            let c = cells[y * w + x]
            if c == id {
                hits += 1
                break rows
            }
            if c > 100 {
                x += 2
                continue
            }
            if c == 7 {
                y += 1
                continue rows
            }
            x += 1
        }
        y += 1
    }
    out[id] = hits
}

kernel fn choose(id: u32, a: f32[], b: f32[], mut out: f32[]) {
    let from = if id % 2 == 0 { a } else { b }
    var sum: f32 = 0.0
    for i in 0..from.len {
        sum += from[i]
    }
    out[id] = sum
}

kernel fn wide(id: u32, k: i64, scale: f64, xs: i64[], mut cells: Cell[]) {
    let x = xs[id]
    var total = (x >> 3) + 5000000000 * k
    total = total / (k - 2) + total % 7 + total % (k + 12)
    let shifted = u64(total) << u64(id)
    cells[id].total = total ^ i64(shifted >> 1)
    cells[id].seen = u32(i64(f64(x) * scale)) + u32(bits.trailing_zeros(u64(x)))
}

kernel fn limits(id: u32, count: u64, scale: f64, xs: i64[], mut out: i64[]) {
    let x = xs[id]
    out[id] = i64(u64(x) << count)
    out[id + 1] = x >> i64(count)
    out[id + 2] = i64(f64(x) * scale)
    out[id + 3] = i64(bits.trailing_zeros(u64(x))) + x / i64(count - 65)
}

kernel fn early(id: u32, limit: f32, xs: f32[], mut out: f32[]) {
    if xs[id] > limit {
        return
    }
    var n: u32 = 0
    for {
        n += 1
        if f32(n) * xs[id] > limit {
            break
        }
        if n > 100 {
            return
        }
    }
    out[id] = f32(n)
}

kernel fn mask(id: u32, xs: i32[], mut out: u32[]) {
    let at = i64(id) * 4
    let a: i32x4 = simd.read(xs, at)
    let b: i32x4 = simd.splat(i32(3))
    let c = (a * b) >> 1
    out[id] = u32(simd.mask(c > b))
}

fn main() {
    let kernel = 3
    let xs: f32[] = [1.0, 2.0, 3.0, 4.0]
    var ys: f32[] = [10.0, 20.0, 30.0, 40.0]
    for i in 0..xs.len {
        saxpy(u32(i), 2.0, xs, mut ys)
    }
    print(ys[kernel])
    var ps = [Particle { x: 2.0, y: 4.0, hits: 0 }]
    step(0, Mode.Scale, 3.0, mut ps)
    print(ps[0].x)
    print(ps[0].hits)
    var out: f32[] = [0.0, 0.0, 0.0, 0.0]
    for i in 0..4 {
        blur(u32(i), 2, 2, xs, mut out)
    }
    print(out[0])
    edges(3, mut out)
    print(out[0])
    print(out[3])
    lanes(0, xs, mut ys)
    print(ys[3])
    var zs: f32[] = [1.5]
    grow(0, mut zs)
    print(zs[0])
    var found: i64[] = [0, 0]
    search(0, 3, [0, 3, 4], mut found)
    search(1, 3, [0, 3, 4], mut found)
    print(found[0])
    print(found[1])
    var hits: u32[] = [0, 0, 0, 0]
    grid(1, 2, [0, 7, 1, 200], mut hits)
    print(hits[1])
    var sums: f32[] = [0.0, 0.0]
    choose(0, [1.0, 2.0], [5.0], mut sums)
    choose(1, [1.0, 2.0], [5.0], mut sums)
    print(sums[0])
    print(sums[1])
    var cells: Cell[] = [Cell { total: 0, seen: 0 }]
    wide(0, -5, 0.5, [40], mut cells)
    print(cells[0].total)
    print(cells[0].seen)
    var ends: i64[] = [0, 0, 0, 0]
    limits(0, 64, 1.0e30, [-1099511627776], mut ends)
    for end in ends {
        print(end)
    }
    var steps: f32[] = [0.0]
    early(0, 10.0, [3.0], mut steps)
    print(steps[0])
    var bits: u32[] = [0]
    mask(0, [1, 2, 3, 4], mut bits)
    print(bits[0])
}
