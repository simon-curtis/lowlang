fn helper(x: i64) -> i64 { x * 2 }
fn f(xs: []i64, i: i64, k: i64) -> i64 {
    if k > 0 {
        return xs[i] + 1
    }
    helper(xs[0]) + helper(i)
}
fn g(a: i64, b: i64) -> i64 {
    if b != 7 {
        return a / b
    }
    helper(a)
}
fn main() {
    let xs = [1, 2, 3]
    print(f(xs, 1, 1))
    print(f(xs, 1, 0))
    print(g(10, 3))
    print(g(10, 0))
}
