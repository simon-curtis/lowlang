fn key(i: i64) -> i64 {
    (i * 0x5851F42D4C957F2D) ^ (i << 17)
}

fn main() {
    var m: [i64: i64] = [:]
    let n = 3000000
    for i in 0..n {
        m[key(i)] = i
    }
    var bad = 0
    for i in 0..n {
        if (m[key(i)] ?? -1) != i {
            bad += 1
        }
    }
    for i in 0..n {
        if i % 3 == 0 {
            delete(mut m, key(i))
        }
    }
    for i in 0..n {
        let want = if i % 3 == 0 { -1 } else { i }
        if (m[key(i)] ?? -1) != want {
            bad += 1
        }
    }
    print(bad)
    print(m.len)
}
