struct Pair {
    a: i64
    b: i64
}

fn sum_squares(n: i64) -> i64 {
    var xs: []i64 = []
    for i in 0..n {
        push(mut xs, i * i)
    }
    var total = 0
    for i in 0..xs.len {
        total += xs[i]
    }
    total
}

fn nested(n: i64) -> i64 {
    var xs: []i64 = []
    for i in 0..n {
        for j in 0..i {
            push(mut xs, i * 100 + j)
        }
    }
    var total = xs.len
    for i in 0..xs.len {
        total += xs[i] * (i % 3 + 1)
    }
    total
}

fn split(n: i64) -> i64 {
    var evens: []i64 = []
    var odds: []i64 = []
    for i in 0..n {
        if i % 2 == 0 {
            push(mut evens, i)
        } else {
            push(mut odds, i)
        }
    }
    var total = evens.len * 1000 + odds.len
    for i in 0..odds.len {
        total += odds[i] - evens[i]
    }
    total
}

fn shadowed(n: i64) -> i64 {
    var xs: []i64 = []
    for i in 0..n {
        push(mut xs, i)
    }
    var total = xs.len
    {
        var xs: []i64 = []
        for i in 0..3 {
            push(mut xs, i * 7)
        }
        total += xs[2] * 100
    }
    total + xs[n - 1]
}

fn early_break(n: i64, stop: i64) -> i64 {
    var xs: []i64 = []
    for i in 0..n {
        if i == stop {
            break
        }
        push(mut xs, i + 1)
    }
    var total = xs.len * 1000
    for i in 0..xs.len {
        total += xs[i]
    }
    total
}

fn conditional_push(n: i64) -> i64 {
    var xs: []i64 = []
    for i in 0..n {
        if i % 3 != 0 {
            push(mut xs, i)
        }
    }
    var total = xs.len
    for i in 0..xs.len {
        total = (total * 31 + xs[i]) % 1000003
    }
    total
}

fn pairs(n: i64) -> i64 {
    var ps: []Pair = []
    for i in 0..n {
        push(mut ps, Pair { a: i, b: i * 2 })
    }
    var total = 0
    for i in 0..ps.len {
        total += ps[i].a * 3 + ps[i].b
    }
    total
}

fn byte_sum(n: i64) -> i64 {
    var bs: []u8 = []
    for i in 0..n {
        push(mut bs, u8(i % 251))
    }
    var total = 0
    for i in 0..bs.len {
        total += i64(bs[i])
    }
    total
}

fn grown_in_stages() -> i64 {
    var xs: []i64 = []
    var total = 0
    for round in 0..5 {
        for i in 0..(round + 1) * 13 {
            push(mut xs, i)
        }
        total += xs.len
        total += xs[xs.len - 1]
    }
    total
}

fn struct_field(n: i64) -> i64 {
    var holder = Holder { items: [], tag: 5 }
    for i in 0..n {
        push(mut holder.items, i + holder.tag)
    }
    var total = 0
    for i in 0..holder.items.len {
        total += holder.items[i]
    }
    total + holder.tag
}

struct Holder {
    items: []i64
    tag: i64
}

fn main() {
    print(sum_squares(1000))
    print(sum_squares(0))
    print(nested(40))
    print(split(101))
    print(shadowed(10))
    print(early_break(100, 17))
    print(early_break(5, 17))
    print(conditional_push(60))
    print(pairs(33))
    print(byte_sum(1000))
    print(grown_in_stages())
    print(struct_field(70))
}
