struct Point {
    x: i64
    y: i64
    label: str
}

fn adder(k: i64) -> fn(i64) -> i64 {
    fn(x: i64) -> i64 { x + k }
}

fn counter() -> fn() -> i64 {
    var n = 0
    fn() -> i64 {
        n += 1
        n
    }
}

fn nested(a: i64, name: str) -> fn(i64) -> fn() -> str {
    fn(b: i64) -> fn() -> str {
        fn() -> str { "{name}:{a + b}" }
    }
}

fn describe(p: Point) -> fn() -> str {
    fn() -> str { "{p.label}({p.x},{p.y})" }
}

fn scaled(ratio: f64, small: f32, byte: u8) -> fn(f64) -> f64 {
    fn(v: f64) -> f64 { v * ratio + f64(small) + f64(byte) }
}

fn maybe(v: i64?) -> fn() -> i64 {
    fn() -> i64 { v ?? -1 }
}

fn worker(a: i64, b: str, done: chan[str]) {
    done <- "{b}{a}"
}

fn call(f: fn() -> i64) -> i64 {
    f()
}

fn main() {
    let add3 = adder(3)
    print(add3(4))

    let next = counter()
    next()
    next()
    print(next())

    var frozen = 10
    let read_frozen = fn() -> i64 { frozen }
    print(read_frozen())

    var changed = 1
    let read_changed = fn() -> i64 { changed }
    changed = 2
    print(read_changed())

    var bumped = 5
    let bump = fn() { bumped += 1 }
    bump()
    bump()
    print(bumped)

    var items: []i64 = [1, 2]
    let total = fn() -> i64 {
        var t = 0
        for v in items { t += v }
        t
    }
    push(mut items, 3)
    print(total())

    var fixed: []i64 = [4, 5, 6]
    let sum_fixed = fn() -> i64 {
        var t = 0
        for v in fixed { t += v }
        t
    }
    print(sum_fixed())

    print(nested(1, "n")(2)())
    print(describe(Point { x: 1, y: 2, label: "p" })())
    print(scaled(0.5, 0.25, 3)(10.0))
    print(maybe(7)())
    print(maybe(none)())

    var fns: []fn() -> i64 = []
    for i in 0..4 {
        let sq = i * i
        push(mut fns, fn() -> i64 { sq + i })
    }
    var out = 0
    for f in fns {
        out = out * 10 + f()
    }
    print(out)

    var late = 100
    let g = fn() -> i64 { late }
    let h = fn() -> i64 { late + g() }
    late += 1
    print(h())

    let done = chan[str](4)
    for i in 0..3 {
        spawn worker(i, "w", done)
    }
    var got: []str = []
    for i in 0..3 {
        push(mut got, (<-done) ?? "")
    }
    var sorted = 0
    for s in got {
        sorted += s.len
    }
    print(sorted)

    let key = "k"
    let lookup = fn(i: i64) -> str { "{key}{i}" }
    print(lookup(9))
    print(call(fn() -> i64 { add3(1) }))
}
