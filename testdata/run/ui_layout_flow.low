import std/ui/geometry
import std/ui/layout

fn dump(t: layout.Tree, names: []str) {
    for i, name in names {
        let r = layout.rect(t, i)
        print("{name} {r.x} {r.y} {r.width} {r.height}")
    }
}

fn win(w: f32, h: f32) -> geometry.Size {
    geometry.size(w, h)
}

fn wide(w: f32) -> layout.Style {
    layout.Style { width: Px(w) }
}

fn boxed(w: f32, h: f32) -> layout.Style {
    layout.Style { width: Px(w), height: Px(h) }
}

fn based(basis: f32, grow: f32) -> layout.Style {
    layout.Style { basis: Px(basis), grow }
}

fn fixed_content(w: f32) -> geometry.Size {
    geometry.size(100.0, 10.0)
}

fn row_of(mut t: layout.Tree, available: geometry.Size, styles: []layout.Style) {
    var children: []i64 = []
    for s in styles {
        push(mut children, t.node(s, []))
    }
    let root = t.node(layout.Style {}, children)
    t.compute(root, available)
}

fn fixed_row() {
    print("fixed row")
    var t = layout.tree()
    row_of(mut t, win(300.0, 100.0), [boxed(50.0, 20.0), boxed(80.0, 30.0), boxed(40.0, 10.0)])
    dump(t, ["a", "b", "c", "root"])
}

fn fixed_column() {
    print("fixed column")
    var t = layout.tree()
    let a = t.node(boxed(50.0, 20.0), [])
    let b = t.node(boxed(80.0, 30.0), [])
    let c = t.node(boxed(40.0, 10.0), [])
    let root = t.node(layout.Style { direction: Column }, [a, b, c])
    t.compute(root, win(100.0, 300.0))
    dump(t, ["a", "b", "c", "root"])
}

fn grows() {
    print("grow 0 1 3")
    var t = layout.tree()
    row_of(mut t, win(400.0, 50.0), [wide(40.0), layout.Style { grow: 1.0 }, layout.Style { grow: 3.0 }])
    dump(t, ["a", "b", "c", "root"])

    print("grow with basis")
    var u = layout.tree()
    row_of(mut u, win(110.0, 20.0), [based(20.0, 1.0), based(10.0, 3.0)])
    dump(u, ["d", "e", "root"])

    print("grow below one")
    var v = layout.tree()
    row_of(mut v, win(100.0, 10.0), [based(20.0, 0.25), based(20.0, 0.25)])
    dump(v, ["a", "b", "root"])

    print("column grow")
    var w = layout.tree()
    let a = w.node(layout.Style { height: Px(20.0) }, [])
    let b = w.node(layout.Style { grow: 1.0 }, [])
    let c = w.node(layout.Style { grow: 2.0 }, [])
    let root = w.node(layout.Style { direction: Column }, [a, b, c])
    w.compute(root, win(100.0, 200.0))
    dump(w, ["a", "b", "c", "root"])
}

fn shrinks() {
    print("shrink by basis")
    var t = layout.tree()
    row_of(mut t, win(100.0, 40.0), [based(100.0, 0.0), based(50.0, 0.0), based(50.0, 0.0)])
    dump(t, ["a", "b", "c", "root"])

    print("shrink factor zero")
    var u = layout.tree()
    row_of(mut u, win(150.0, 10.0), [layout.Style { basis: Px(100.0), shrink: 0.0 }, based(100.0, 0.0)])
    dump(u, ["a", "b", "root"])

    print("shrink factors")
    var v = layout.tree()
    row_of(mut v, win(90.0, 10.0), [layout.Style { basis: Px(60.0), shrink: 1.0 }, layout.Style { basis: Px(60.0), shrink: 2.0 }])
    dump(v, ["a", "b", "root"])

    print("no automatic minimum")
    var w = layout.tree()
    let a = w.leaf(layout.Style {}, fixed_content)
    let root = w.node(layout.Style {}, [a])
    w.compute(root, win(50.0, 10.0))
    dump(w, ["leaf", "root"])
}

fn clamps() {
    print("min on shrink")
    var t = layout.tree()
    row_of(mut t, win(100.0, 10.0), [layout.Style { basis: Px(80.0), min_width: Px(70.0) }, based(80.0, 0.0)])
    dump(t, ["a", "b", "root"])

    print("max on grow")
    var u = layout.tree()
    row_of(mut u, win(100.0, 10.0), [layout.Style { grow: 1.0, max_width: Px(20.0) }, layout.Style { grow: 1.0 }, layout.Style { grow: 1.0 }])
    dump(u, ["a", "b", "c", "root"])

    print("min and max on grow")
    var v = layout.tree()
    row_of(mut v, win(100.0, 10.0), [layout.Style { grow: 1.0, max_width: Px(10.0) }, layout.Style { grow: 1.0, min_width: Px(50.0) }, layout.Style { grow: 1.0 }])
    dump(v, ["a", "b", "c", "root"])

    print("min beats max")
    var w = layout.tree()
    row_of(mut w, win(200.0, 10.0), [layout.Style { width: Px(50.0), min_width: Px(80.0), max_width: Px(30.0) }])
    dump(w, ["a", "root"])

    print("min on a column")
    var x = layout.tree()
    let a = x.node(layout.Style { grow: 1.0, min_height: Px(60.0) }, [])
    let b = x.node(layout.Style { grow: 1.0 }, [])
    let root = x.node(layout.Style { direction: Column }, [a, b])
    x.compute(root, win(50.0, 100.0))
    dump(x, ["a", "b", "root"])

    print("percent max")
    var y = layout.tree()
    row_of(mut y, win(200.0, 10.0), [layout.Style { grow: 1.0, max_width: Percent(50.0) }])
    dump(y, ["a", "root"])
}

fn bases() {
    print("basis over width")
    var t = layout.tree()
    row_of(mut t, win(200.0, 10.0), [layout.Style { width: Px(80.0), basis: Px(30.0) }, wide(60.0)])
    dump(t, ["a", "b", "root"])

    print("percent basis and width")
    var u = layout.tree()
    row_of(mut u, win(200.0, 10.0), [layout.Style { basis: Percent(25.0) }, layout.Style { width: Percent(50.0) }])
    dump(u, ["a", "b", "root"])
}

fn free_space() {
    print("exact fit")
    var t = layout.tree()
    row_of(mut t, win(100.0, 10.0), [layout.Style { width: Px(60.0), grow: 1.0 }, layout.Style { width: Px(40.0), grow: 1.0 }])
    dump(t, ["a", "b", "root"])

    print("overflow")
    var u = layout.tree()
    row_of(mut u, win(100.0, 10.0), [layout.Style { width: Px(80.0), shrink: 0.0 }, layout.Style { width: Px(60.0), shrink: 0.0 }])
    dump(u, ["a", "b", "root"])

    for j in [layout.Justify.Center, layout.Justify.End, layout.Justify.SpaceBetween, layout.Justify.SpaceAround, layout.Justify.SpaceEvenly] {
        print("overflow {j}")
        var v = layout.tree()
        let a = v.node(layout.Style { width: Px(80.0), shrink: 0.0 }, [])
        let b = v.node(layout.Style { width: Px(60.0), shrink: 0.0 }, [])
        let root = v.node(layout.Style { justify: j }, [a, b])
        v.compute(root, win(100.0, 10.0))
        dump(v, ["a", "b"])
    }

    print("margins")
    var w = layout.tree()
    let a = w.node(layout.Style { grow: 1.0, margin: geometry.Edges { left: 5.0, right: 5.0 } }, [])
    let b = w.node(layout.Style { width: Px(20.0), margin: geometry.Edges { right: 10.0 } }, [])
    let root = w.node(layout.Style {}, [a, b])
    w.compute(root, win(100.0, 10.0))
    dump(w, ["a", "b", "root"])

    print("empty container")
    var x = layout.tree()
    let e = x.node(layout.Style {}, [])
    let f = x.node(wide(30.0), [])
    let top = x.node(layout.Style {}, [e, f])
    x.compute(top, win(100.0, 10.0))
    dump(x, ["e", "f", "top"])
}

fn recompute() {
    print("recompute")
    var t = layout.tree()
    let a = t.node(layout.Style { grow: 1.0 }, [])
    let b = t.node(wide(50.0), [])
    let root = t.node(layout.Style {}, [a, b])
    t.compute(root, win(100.0, 10.0))
    dump(t, ["a", "b", "root"])
    t.compute(root, win(200.0, 20.0))
    dump(t, ["a", "b", "root"])
}

fn main() {
    fixed_row()
    fixed_column()
    grows()
    shrinks()
    clamps()
    bases()
    free_space()
    recompute()
}
