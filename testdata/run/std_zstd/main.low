import std/compress/zstd
import std/hash
import std/io
import std/text

fn generated(n: i64, start: u64) -> []u8 {
    let words = ["alpha ", "beta ", "gamma ", "delta ", "stream ", "window ", "huffman ", "\n"]
    var out: []u8 = []
    var seed = start
    for out.len < n {
        seed = seed * 6364136223846793005 + 1442695040888963407
        text.append(mut out, words[i64(seed >> 61)])
    }
    out[..n]
}

fn noise(n: i64, start: u64) -> []u8 {
    let out = io.buffer(n)
    var seed = start
    for i in 0..n {
        seed = seed * 6364136223846793005 + 1442695040888963407
        out[i] = u8(seed >> 56)
    }
    out
}

fn repeated(n: i64, v: u8) -> []u8 {
    let out = io.buffer(n)
    for i in 0..n {
        out[i] = v
    }
    out
}

fn joined(parts: [][]u8) -> []u8 {
    var out: []u8 = []
    for p in parts {
        io.append(mut out, p)
    }
    out
}

fn same(a: []u8, b: []u8) -> bool {
    a.len == b.len && hash.crc32(a) == hash.crc32(b)
}

fn outcome(packed: []u8, limit: i64, want: []u8) -> str {
    let got = zstd.decompress(packed, limit) catch {
        Malformed => return "Malformed"
        TooLarge => return "TooLarge"
        Unsupported => return "Unsupported"
        _ => return "other"
    }
    if same(got, want) { "ok" } else { "mismatch" }
}

fn references() {
    print("text19 {outcome(bytes(embed("text19.zst")), 1 << 24, generated(40000, 1))}")
    print("fast {outcome(bytes(embed("fast.zst")), 1 << 24, generated(40000, 1))}")
    print("ultra {outcome(bytes(embed("ultra.zst")), 1 << 24, generated(60000, 2))}")
    print("noise {outcome(bytes(embed("noise.zst")), 1 << 24, noise(3000, 3))}")
    let empty: []u8 = []
    let multi = joined([generated(500, 4), empty, repeated(300000, 'z')])
    print("multi {outcome(bytes(embed("multi.zst")), 1 << 24, multi)}")
}

fn round_trips() {
    let empty: []u8 = []
    let names = ["empty", "byte", "hello", "text", "noise", "run"]
    let inputs = [empty, bytes("a"), bytes("hello world"), generated(300000, 9), noise(200000, 10), repeated(500000, 7)]
    for level in [1, 3, 9] {
        for i, data in inputs {
            let packed = zstd.compress(data, level)
            print("level {level} {names[i]} {outcome(packed, 1 << 24, data)} smaller {packed.len < data.len}")
        }
    }
    let text = generated(60000, 11)
    for level in [0, 19, 30] {
        let packed = zstd.compress(text, level)
        print("level {level} text {outcome(packed, 1 << 24, text)} smaller {packed.len < text.len / 3}")
    }
}

fn streaming() ! io.Error {
    let data = joined([generated(400000, 12), noise(50000, 13), repeated(100000, 1), generated(100000, 12)])
    var packed: []u8 = []
    let sink: fn([]u8) ! io.Error = fn(b) { io.append(mut packed, b) }
    let e = zstd.encoder(3, sink)
    var at = 0
    var pieces = 0
    for at < data.len {
        let n = if at + 777 > data.len { data.len - at } else { 777 }
        zstd.encode(e, data[at..at + n])?
        at += n
        pieces += 1
        if pieces % 97 == 0 {
            zstd.flush(e)?
        }
    }
    zstd.finish(e)?
    var out: []u8 = []
    var chunks = 0
    var largest = 0
    let collect: fn([]u8) ! io.Error = fn(b) {
        chunks += 1
        if b.len > largest {
            largest = b.len
        }
        io.append(mut out, b)
    }
    zstd.decode(io.bytes_reader(packed), collect, 1 << 24)?
    print("stream {same(out, data)} chunked {chunks > 4 && largest <= 131072}")
    print("stream buffered {outcome(packed, 1 << 24, data)}")
}

fn errors() {
    let data = generated(20000, 14)
    let packed = zstd.compress(data, 3)
    print("truncated {outcome(packed[..packed.len - 5], 1 << 24, data)}")
    let flipped = joined([packed])
    flipped[flipped.len - 1] ^= 1
    print("checksum {outcome(flipped, 1 << 24, data)}")
    print("limit {outcome(packed, data.len - 1, data)}")
    print("exact {outcome(packed, data.len, data)}")
    let empty: []u8 = []
    print("empty {outcome(empty, 1 << 24, empty)}")
    let dictionary: []u8 = [0x28, 0xB5, 0x2F, 0xFD, 0x21, 7, 0, 1, 0, 0]
    print("dictionary {outcome(dictionary, 1 << 24, empty)}")
    let garbage: []u8 = [1, 2, 3, 4, 5, 6, 7, 8]
    print("garbage {outcome(garbage, 1 << 24, empty)}")
}

fn verdict(step: fn() ! io.Error) -> str {
    step() catch {
        Invalid => return "Invalid"
        _ => return "other"
    }
    "accepted"
}

fn after_finish() ! io.Error {
    let e = zstd.encoder(3, fn(chunk) {})
    zstd.finish(e)?
    print("encode after finish {verdict(fn() ! io.Error { zstd.encode(e, bytes("a"))? })}")
    print("flush after finish {verdict(fn() ! io.Error { zstd.flush(e)? })}")
    print("finish after finish {verdict(fn() ! io.Error { zstd.finish(e)? })}")
}

fn main() ! io.Error {
    references()
    round_trips()
    streaming()?
    errors()
    after_finish()?
}
