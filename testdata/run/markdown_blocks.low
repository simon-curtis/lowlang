import std/markdown

fn show(title: str, source: str) {
    print("--- {title}")
    print(markdown.to_html(source))
}

fn main() {
    show("headings", "# One\n\n## Two ##\n\nSetext\n======\n\nSub\n---\n\n####### seven\n")
    show("paragraphs", "first line\nsecond line  \nthird line\\\nfourth\n\nnext paragraph\n")
    show("nested list", "- a\n  - b\n    - c\n  - d\n- e\n")
    show("ordered list", "3. three\n4. four\n   1) inner\n   2) inner two\n5. five\n")
    show("loose list", "- one\n\n- two\n- three\n")
    show("loose by inner blank", "- one\n  more\n\n  second paragraph\n- two\n")
    show("task list", "- [x] done\n- [ ] open\n- [x]no space\n")
    show("fence with backticks", "````md\n```low\nlet x = 1\n```\n````\n")
    show("tilde fence", "~~~ sh extra\necho `hi`\n~~~\n")
    show("unclosed fence", "```\nopen\n")
    show("indented code", "    let a = 1\n\n    let b = 2\n")
    show("html comment", "<!-- one\ntwo\n\nthree -->\n\ntext\n")
    show("html block", "<div>\n*not emphasis*\n</div>\n\nafter\n")
    show("block quote", "> quote\n> - item\n>\n> > nested\n\nlazy\n> continuation\nlazy line\n")
    show("thematic breaks", "***\n\n- - -\n\n___\n")
    show("code in list", "1. step\n\n       indented\n\n   ```sh\n   run\n   ```\n")
}
