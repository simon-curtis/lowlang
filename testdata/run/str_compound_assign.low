struct Label {
    text: str
}

fn suffix() -> str {
    "!"
}

fn main() {
    var s = "a"
    s += "b"
    s += suffix()
    s += s
    print(s)

    var label = Label { text: "x" }
    label.text += "y"
    print(label.text)

    var parts = ["p", "q"]
    parts[1] += "r"
    print(parts[1])

    var counts: [str: str] = [:]
    counts["k"] += "one"
    counts["k"] += "two"
    print(counts["k"] ?? "missing")

    var total = 1
    total += 2
    print(total)
}
