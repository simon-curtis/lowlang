/// A point on the plane.
pub struct Point {
    /// Distance from the y axis.
    pub x: i64
    /// Distance from the x axis.
    pub y: i64
}

/// Where a point lies.
enum Side {
    /// Left of the y axis.
    Left
    /// On the y axis or right of it.
    Right
}

//// Four slashes make an ordinary comment.
/// Classifies a point.
///
/// ```low
/// side(Point { x: -1, y: 0 })
/// ```
fn side(p: Point) -> Side {
    if p.x < 0 {
        return Left
    }
    return Right
}

fn main() {
    let url = "http:///path"
    match side(Point { x: -3, y: 4 }) {
        Left => print("left")
        Right => print("right")
    }
    print(url)
}
