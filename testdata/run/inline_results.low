struct Pair {
    a: i64
    b: i64
}

struct Mixed {
    name: str
    ratio: f64
    count: i32
}

enum Odd {
    Odd
}

enum Shape {
    Circle(f64)
    Rect(i64, i64)
    Empty
}

fn make_pair(a: i64, b: i64) -> Pair {
    Pair { a: b, b: a }
}

fn make_mixed(name: str, n: i32) -> Mixed {
    Mixed { name: name, ratio: f64(n) / 4.0, count: n + 1 }
}

fn front(xs: []i64, n: i64) -> []i64 {
    xs[0..n]
}

fn label(n: i64) -> str {
    if n < 0 { "negative" } else { "positive" }
}

fn shape(n: i64) -> Shape {
    if n == 0 {
        Empty
    } else if n < 0 {
        Circle(f64(n) * -0.5)
    } else {
        Rect(n, n + 1)
    }
}

fn describe(s: Shape) -> i64 {
    match s {
        Circle(r) => i64(r * 10.0)
        Rect(w, h) => w * h
        Empty => -1
    }
}

fn fail_on_odd(n: i64) -> i64 ! Odd {
    if n % 2 == 1 {
        fail Odd
    }
    n / 2
}

fn maybe(n: i64) -> i64? {
    if n > 5 { some(n * 2) } else { none }
}

fn swap(p: Pair) -> Pair {
    Pair { a: p.b, b: p.a }
}

fn main() {
    let p = make_pair(1, 2)
    print(p.a)
    print(p.b)
    let q = swap(swap(swap(p)))
    print(q.a)
    print(q.b)
    let m = make_mixed("mix", 6)
    print(m.name)
    print(m.ratio)
    print(m.count)
    let xs = [1, 2, 3, 4, 5]
    let part = front(xs, 3)
    print(part.len)
    print(part[2])
    print(label(-4))
    print(label(4))
    print(label(0).len)
    print(describe(shape(0)))
    print(describe(shape(-4)))
    print(describe(shape(3)))
    var total = 0
    for i in 0..10 {
        total += describe(shape(i - 5))
        let v = fail_on_odd(i) catch -1
        total += v
        let w = maybe(i) ?? 100
        total += w
    }
    print(total)
}
