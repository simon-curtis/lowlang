import std/io
import std/net

fn main() ! io.Error {
    for s in ["10.0.0.1", "::1", "2001:db8::8:800:200c:417a", "fe80::", "1:0:0:2:0:0:0:3", "::"] {
        print(net.format_ip(net.parse_ip(s)?))
    }
    for bad in ["1.2.3", "256.0.0.1", "1::2::3", "x"] {
        let rejected = net.parse_ip(bad) catch {
            Invalid => []
            _ => []
        }
        print(rejected.len)
    }
    print(net.format(net.parse_addr("[::1]:8080")?))

    let l = net.listen("127.0.0.1", 0)?
    let client = net.connect(l.addr)?
    let server = net.accept(l)?
    net.set_nodelay(client, true)?
    net.write_all(client, bytes("ping"))?
    net.shutdown_write(client)?
    let buf = io.buffer(16)
    let n = net.read(server, buf)?
    print(str(buf[..n]))
    print(net.read(server, buf)?)
    net.write_all(server, bytes("pong"))?
    net.close(server)
    let m = net.read(client, buf)?
    print(str(buf[..m]))
    net.close(client)
    net.close_listener(l)

    let a = net.bind_udp("127.0.0.1", 0)?
    let b = net.bind_udp("127.0.0.1", 0)?
    net.send_to(a, bytes("datagram"), b.addr)?
    let p = net.receive_from(b, buf)?
    print(str(buf[..p.size]))
    print(p.from.port == a.addr.port)
    net.close_socket(a)
    net.close_socket(b)

    print(net.lookup("127.0.0.1")?.len)
    print(net.lookup("localhost")?.len > 0)
}
