import std/mime
import std/semver
import std/slices
import std/text

fn main() {
    print(mime.by_extension(".FLAC") ?? "unknown")
    print(mime.by_extension("m3u8") ?? "unknown")
    print(mime.by_extension("nope") ?? "unknown")
    print(mime.extension("image/webp; q=1") ?? "unknown")
    let png: []u8 = [0x89, 'P', 'N', 'G', 0x0d, 0x0a, 0x1a, 0x0a, 'r']
    print(mime.sniff(png))
    print(mime.sniff(bytes("fLaC....")))
    print(mime.sniff(bytes("....ftypisom")))
    print(mime.sniff(bytes("  <!DOCTYPE html><p>")))
    print(mime.sniff(bytes("{{\"a\": 1}}")))
    print(mime.sniff(bytes("plain words\n")))
    print(mime.sniff([0x00, 0x01, 0x02]))

    var versions: []semver.Version = []
    for s in ["1.0.0", "1.0.0-alpha", "1.0.0-alpha.1", "1.0.0-alpha.beta", "1.0.0-beta.11", "1.0.0-beta.2", "1.0.0-rc.1", "v2.1.3+build.7", "0.9.12"] {
        let v = semver.parse(s) catch {
            _ => semver.Version { major: 0, minor: 0, patch: 0 }
        }
        push(mut versions, v)
    }
    versions |> slices.sort_by(semver.less)
    var names: []str = []
    for v in versions {
        push(mut names, semver.format(v))
    }
    print(text.join(names, " < "))
    for bad in ["1.2", "01.2.3", "1.2.3-", "1.2.3-a..b", ""] {
        let reason = semver.parse(bad) catch {
            Empty => {
                print("[{bad}] empty")
                continue
            }
            Malformed(at) => {
                print("[{bad}] malformed at {at}")
                continue
            }
        }
        print("[{bad}] parsed {semver.format(reason)}")
    }
}
