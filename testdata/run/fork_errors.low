enum Bad {
    Odd(n: i64)
    Slow
}

enum Other {
    Missing
}

fn half(n: i64) -> i64 ! Bad {
    if n % 2 == 1 {
        fail Odd(n)
    }
    n / 2
}

fn slow_fail(ms: i64) -> i64 ! Bad {
    sleep(ms)
    fail Slow
}

fn both(a: i64, b: i64) -> i64 ! Bad {
    let x, y = fork { half(a)?, half(b)? }
    x + y
}

fn first_in_source_order() -> i64 ! Bad {
    let a, b = fork { slow_fail(30)?, half(3)? }
    a + b
}

fn every_branch_finishes(done: chan[i64]) -> i64 ! Bad {
    let a, _ = fork {
        half(3)?
        {
            sleep(30)
            done <- 1
        }
    }
    a
}

fn even(n: i64) ! Bad {
    if n % 2 == 1 {
        fail Odd(n)
    }
}

fn checked(a: i64, b: i64) -> i64 ! Bad {
    let _, _, sum = fork {
        even(a)?
        half(b)?
        {
            if a + b > 100 {
                fail Slow
            }
            a + b
        }
    }
    sum
}

fn nested(n: i64) -> i64 ! Bad {
    let a, b = fork {
        {
            let x, y = fork { half(n)?, half(n + 2)? }
            x + y
        }
        half(n + 4)?
    }
    a + b
}

fn handled() -> str {
    let a, b = fork { half(4) catch { _ => 0 }, "{half(3) catch { _ => -1 }}" }
    "{a} {b}"
}

fn mapped() -> i64 ! Other {
    let a, b = fork { half(3) catch { _ => fail_other()? }, 1 }
    a + b
}

fn fail_other() -> i64 ! Other {
    fail Missing
}

fn text(e: Bad) -> str {
    match e {
        Odd(n) => "odd {n}"
        Slow => "slow"
    }
}

fn report(e: Bad) -> i64 {
    print(text(e))
    -1
}

fn main() {
    print(both(4, 6) catch { e => report(e) })
    print(both(3, 5) catch { e => report(e) })
    print(both(4, 5) catch { e => report(e) })
    print(first_in_source_order() catch { e => report(e) })
    let done = chan[i64](1)
    print(every_branch_finishes(done) catch { e => report(e) })
    let finished = select {
        v = <-done => v ?? 0
        else => 0
    }
    print(finished)
    print(nested(4) catch { e => report(e) })
    print(nested(5) catch { e => report(e) })
    print(checked(2, 4) catch { e => report(e) })
    print(checked(3, 4) catch { e => report(e) })
    print(checked(2, 200) catch { e => report(e) })
    print(handled())
    print(mapped() catch { Missing => -7 })
}
