struct Row {
    cells: str?[]
}

fn present(xs: i64?[]) -> i64 {
    var n = 0
    for x in xs {
        match x {
            some(v) => {
                n += v
            }
            none => {}
        }
    }
    n
}

fn main() {
    var xs: i64?[] = [1, none, 3]
    xs.push(none)
    xs.push(10)
    print(present(xs))
    print(xs.len)
    let r = Row { cells: ["a", none, "c"] }
    print(r.cells[1] ?? "missing")
    print(r.cells[2] ?? "missing")
    let maybe: i64?[]? = none
    print((maybe ?? [7])[0] ?? 0)
    let grid: [str: i64?[]] = ["k": [none, 4]]
    print((grid["k"] ?? [])[1] ?? 0)
}
