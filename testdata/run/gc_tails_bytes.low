import std/io

fn worker(id: i64, out: chan[i64]) {
    var tails: [][]u8 = []
    var tags: []i64 = []
    for r in 0..3000 {
        let n = 1500 + (r * 7 + id) % 540
        var xs = io.buffer(n)
        for j in n - 5..n {
            xs[j] = u8((r + j) % 256)
        }
        if r % 3 == 0 {
            push(mut tails, xs[n - 5..])
            push(mut tags, r + n - 5)
        }
        let junk = io.buffer(r % 300)
    }
    var bad = 0
    for i in 0..tails.len {
        for j in 0..5 {
            if tails[i][j] != u8((tags[i] + j) % 256) {
                bad += 1
            }
        }
    }
    out <- bad
}

fn main() {
    let n = 24
    let out = chan[i64](n)
    for id in 0..n {
        spawn worker(id, out)
    }
    var bad = 0
    for i in 0..n {
        bad += (<-out) ?? 1000
    }
    print(bad)
}
