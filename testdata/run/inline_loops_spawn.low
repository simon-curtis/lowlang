fn mix(acc: i64, i: i64) -> i64 {
    var x = acc
    for k in 0..3 {
        x = (x * 33 + i + k) % 1000003
    }
    x
}

fn busy(rounds: i64, done: chan[i64]) {
    var acc = 1
    for i in 0..rounds {
        acc = mix(acc, i)
    }
    done <- acc
}

fn watcher(flag: chan[i64], rounds: i64) {
    var seen = 0
    for i in 0..rounds {
        seen += mix(i, 7) % 3
    }
    flag <- seen
}

fn main() {
    let done = chan[i64](4)
    for id in 0..3 {
        spawn busy(2000000 + id, done)
    }
    spawn watcher(done, 1500000)
    var total = 0
    for i in 0..4 {
        total += (<-done) ?? -1
    }
    print(total)
    var local = 1
    for i in 0..4000000 {
        local = mix(local, i)
    }
    print(local)
}
