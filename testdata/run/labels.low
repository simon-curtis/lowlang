struct Log {
    name: str
    drop print("close {name}")
}

fn find(grid: [][]i64, want: i64) -> str {
    var found = "none"
    rows: for row, cells in grid {
        for col, cell in cells {
            if cell == want {
                found = "{row},{col}"
                break rows
            }
        }
    }
    found
}

fn main() {
    let grid = [[1, 2, 3], [4, 5, 6], [7, 8, 9]]
    print(find(grid, 5))
    print(find(grid, 10))

    var pairs = 0
    outer: for i in 0..5 {
        for j in 0..5 {
            if j > i {
                continue outer
            }
            pairs += 1
        }
    }
    print(pairs)

    var n = 0
    forever: for {
        for {
            n += 1
            if n == 3 {
                break forever
            }
        }
    }
    print(n)

    search: for i in 0..3 {
        using log = Log { name: "outer {i}" }
        for j in 0..3 {
            using inner = Log { name: "inner {j}" }
            if i == 1 && j == 1 {
                break search
            }
        }
    }
    print("done")
}
