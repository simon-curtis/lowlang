import std/base64
import std/crypto
import std/crypto/hash
import std/text

fn problem(s: str) -> str {
    base64.decode(s) catch {
        BadLength => return "length"
        BadByte(at) => return "byte {at}"
    }
    "valid"
}

fn main() {
    for s in ["", "abc", "The quick brown fox jumps over the lazy dog"] {
        print(base64.encode(hash.sum(hash.sha1(), bytes(s))))
    }
    var long: []u8 = []
    for i in 0..1000 {
        push(mut long, u8(i))
    }
    print(base64.encode(hash.sum(hash.sha1(), long)))
    for s in ["", "f", "fo", "foo", "foob"] {
        let encoded = base64.encode(bytes(s))
        let decoded = base64.decode(encoded) catch []
        print("{encoded} {str(decoded)}")
    }
    print(problem("ab=c"))
    print(problem("abc"))
    print(crypto.random(16).len)
    print(text.parse_int("-42") catch 0)
    print(text.parse_uint("ff", 16) catch 0)
    print(text.parse_uint("99999999999999999999", 10) catch -1)
    print(text.hex(48879))
    print(text.trim("  padded \r\n"))
    print(text.join(text.split("a,b,,c", ','), "|"))
    print(text.has_token("keep-alive, Upgrade", "upgrade"))
    print(text.lower("MiXeD"))
}
