fn walk(limit: i64, keep: bool) -> i64 {
    var xs: []i64 = []
    for i in 0..limit {
        push(mut xs, 1)
    }
    if !keep {
        xs = [5, 6, 7]
    }
    var total = 0
    for i in 2..limit {
        total += xs[i]
    }
    total
}

fn main() {
    print(walk(8, true))
    print(walk(3, false))
    print(walk(8, false))
}
