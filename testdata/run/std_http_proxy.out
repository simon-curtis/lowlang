403 Forbidden
connect error denied
connect error refused
  proxy saw: GET http://blocked.example/ auth=-
  proxy saw: CONNECT blocked.example:443 auth=-
  proxy saw: CONNECT dead.example:1 auth=-
connect tunnel
200 GET host=localhost:PORT path=/secure body= auth=- proxy-auth=- h2=true
200 GET host=localhost:PORT path=/again body= auth=- proxy-auth=-
  proxy saw: CONNECT localhost:PORT auth=Basic dXNlcjpwYXNz
  client resolved: proxy.test
strict proxy connections 3
server name
tls error
