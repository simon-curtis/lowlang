import std/otel
import std/text

fn show_options(label: str, o: otel.OtlpOptions) {
    var headers: []str = []
    for h in o.headers {
        push(mut headers, "{h.name}={h.value}")
    }
    let protocol = match o.protocol {
        HttpProtobuf => "http/protobuf"
        HttpJson => "http/json"
        Grpc => "grpc"
    }
    print("{label} endpoint={otel.endpoint_of(o)} traces={o.traces_endpoint} metrics={o.metrics_endpoint} logs={o.logs_endpoint} protocol={protocol} gzip={o.gzip} timeout={o.timeout} headers=[{text.join(headers, " ")}]")
}

fn show_config(label: str, c: otel.Config) {
    let resource: []otel.Attribute = match c.resource {
        some(r) => r.attributes
        none => []
    }
    var shown: []otel.Attribute = []
    for a in resource {
        if a.key != "service.name" || !text.starts_with(otel.format_value(a.value), "unknown_service") {
            push(mut shown, a)
        } else {
            push(mut shown, otel.string(a.key, "unknown_service:<process>"))
        }
    }
    print("{label} resource {otel.format_attributes(shown)}")
    print("{label} sampler {otel.description(c.sampler)}")
    print("{label} propagators trace_context={c.propagators.trace_context} baggage={c.propagators.baggage}")
    print("{label} processors spans={c.span_processors.len} readers={c.metric_readers.len} logs={c.log_processors.len}")
    print("{label} limits attributes={c.limits.attributes} events={c.limits.events} links={c.limits.links} per_event={c.limits.attributes_per_event} per_link={c.limits.attributes_per_link}")
    for r in c.metric_readers {
        let preference = match r.preference {
            PreferCumulative => "cumulative"
            PreferDelta => "delta"
            LowMemory => "lowmemory"
        }
        print("{label} reader interval={r.interval} timeout={r.timeout} preference={preference}")
    }
}

fn main() {
    let env: [str: str] = [
        "OTEL_SERVICE_NAME": "checkout",
        "OTEL_RESOURCE_ATTRIBUTES": "deployment.environment.name=prod, service.name=ignored,team=a%20b,broken",
        "OTEL_TRACES_SAMPLER": "parentbased_traceidratio",
        "OTEL_TRACES_SAMPLER_ARG": "0.25",
        "OTEL_EXPORTER_OTLP_ENDPOINT": "http://collector:4318/",
        "OTEL_EXPORTER_OTLP_TRACES_ENDPOINT": "http://traces:9999/custom",
        "OTEL_EXPORTER_OTLP_HEADERS": "api-key=secret%3D,x=1",
        "OTEL_EXPORTER_OTLP_LOGS_HEADERS": "x=2",
        "OTEL_EXPORTER_OTLP_PROTOCOL": "http/json",
        "OTEL_EXPORTER_OTLP_METRICS_PROTOCOL": "http/protobuf",
        "OTEL_EXPORTER_OTLP_COMPRESSION": "gzip",
        "OTEL_EXPORTER_OTLP_LOGS_TIMEOUT": "2500",
        "OTEL_TRACES_EXPORTER": "console,none",
        "OTEL_METRICS_EXPORTER": "otlp",
        "OTEL_LOGS_EXPORTER": "none",
        "OTEL_METRIC_EXPORT_INTERVAL": "15000",
        "OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE": "Delta",
        "OTEL_PROPAGATORS": "baggage",
        "OTEL_ATTRIBUTE_COUNT_LIMIT": "64",
        "OTEL_SPAN_EVENT_COUNT_LIMIT": "10",
        "OTEL_LINK_ATTRIBUTE_COUNT_LIMIT": "bad",
    ]
    show_config("custom", otel.config_from_env(env))
    show_options("traces", otel.otlp_options_from_env(env, "TRACES"))
    show_options("metrics", otel.otlp_options_from_env(env, "METRICS"))
    show_options("logs", otel.otlp_options_from_env(env, "LOGS"))
    let empty: [str: str] = [:]
    show_config("default", otel.config_from_env(empty))
    show_options("default traces", otel.otlp_options_from_env(empty, "TRACES"))
    show_options("grpc traces", otel.otlp_options_from_env(["OTEL_EXPORTER_OTLP_PROTOCOL": "grpc"], "TRACES"))
    show_options("grpc logs", otel.otlp_options_from_env(["OTEL_EXPORTER_OTLP_PROTOCOL": "grpc", "OTEL_EXPORTER_OTLP_LOGS_PROTOCOL": "http/protobuf"], "LOGS"))
    for name in ["always_on", "always_off", "traceidratio", "parentbased_always_off", "unknown"] {
        print("sampler {name} {otel.description(otel.sampler_from_env(["OTEL_TRACES_SAMPLER": name, "OTEL_TRACES_SAMPLER_ARG": "7"]))}")
    }
    let merged = otel.merge(new(otel.Resource { attributes: [otel.string("a", "1"), otel.string("b", "2")] }), [otel.string("b", "3"), otel.string("c", "4")])
    print("merged {otel.format_attributes(merged.attributes)}")
    var names: []str = []
    for n in [0, 1, 4, 5, 9, 12, 13, 17, 21, 24, 25] {
        push(mut names, "{n}:{otel.severity_name(n)}")
    }
    print("severities {text.join(names, " ")}")
}
