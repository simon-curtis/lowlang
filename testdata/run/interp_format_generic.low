struct Pair[T] {
    first: T
    second: T
}

fn pad[T](x: T) -> str {
    "[{x,6}][{x,-6}]"
}

fn money[T: Number](x: T) -> str {
    "{x:f1}|{x,8:f2}|{x,-9:n}|{x:0.0#}|{x:e1}"
}

fn bits[T: Integer](x: T) -> str {
    "{x:x4}|{x:X}|{x:b}|{x:d3}|{x,6:f1}|{x:#,##0}"
}

fn real[T: Float](x: T) -> str {
    "{x:f3}|{x,10:e2}"
}

fn both[T: Integer + Ord](a: T, b: T) -> str {
    if a > b {
        "{a:x}>{b:x}"
    } else {
        "{a:x}<={b:x}"
    }
}

fn pair_text[T: Number](p: Pair[T]) -> str {
    "{p.first,5:f1}{p.second,-5:f1}|{p,30}"
}

fn main() {
    print(pad(42))
    print(pad("ab"))
    print(pad(true))
    print(pad(Pair { first: 1, second: 2 }))
    print(money(1234567))
    print(money(3.14159))
    print(money(u8(200)))
    print(money(f32(0.1)))
    print(bits(255))
    print(bits(u8(255)))
    print(bits(i32(-1)))
    let top: u64 = 18446744073709551615
    print(bits(top))
    print(real(2.5))
    print(real(f32(0.1)))
    print(both(255, 16))
    print(both(u32(1), u32(4000000000)))
    print(pair_text(Pair { first: 1.5, second: 2.25 }))
    print(pair_text(Pair { first: 3, second: 4 }))
}
