import std/crypto/hash
import std/crypto/prehash
import std/crypto/sha3
import std/text

fn hash_of(s: str) -> prehash.Hash {
    match s {
        "Sha224" => Sha224
        "Sha256" => Sha256
        "Sha384" => Sha384
        "Sha512" => Sha512
        "Sha512_224" => Sha512_224
        "Sha512_256" => Sha512_256
        "Sha3_224" => Sha3_224
        "Sha3_256" => Sha3_256
        "Sha3_384" => Sha3_384
        "Sha3_512" => Sha3_512
        "Shake128" => Shake128
        _ => Shake256
    }
}

fn pattern(n: i64) -> []u8 {
    var out: []u8 = []
    for i in 0..n {
        push(mut out, u8((i * 131 + 7) % 251))
    }
    out
}

fn input(index: str) -> []u8 {
    match index {
        "0" => []
        "1" => bytes("abc")
        _ => pattern(1000)
    }
}

fn verdict(label: str, ok: bool) {
    let word = if ok { "ok" } else { "FAIL" }
    print("{label}: {word}")
}

fn split_digest(a: hash.Algorithm, data: []u8) -> bool {
    let d = a.digest()
    d.update(data[..300])
    let snapshot = d.clone()
    d.update(data[300..])
    snapshot.update(data[300..])
    hash.equal(d.finish(), snapshot.finish()) && hash.equal(d.finish(), hash.sum(a, data))
}

fn main() {
    for line in text.lines(embed("std_prehash.txt")) {
        let f = text.fields(line)
        let h = hash_of(f[0])
        if f[1] == "oid" {
            verdict("{f[0]} oid", text.encode_hex(prehash.oid(h)) == f[2])
        } else {
            verdict("{f[0]} digest {f[1]}", text.encode_hex(prehash.digest(h, input(f[1]))) == f[2])
        }
    }
    let data = pattern(1000)
    for a in [hash.sha224(), hash.sha512_224(), hash.sha512_256(), sha3.sha3_224()] {
        verdict("{a.name} incremental", split_digest(a, data))
        print("{a.name} size {a.size} block {a.block}")
    }
}
