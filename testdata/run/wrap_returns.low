fn fdiv(a: f64, b: f64) -> f64 { a / b }
fn fadd(a: f64, b: f64) -> f64 { a + b }
fn fsqrt(a: f64) -> f64 { sqrt(a) }
fn ffloor(a: f64) -> f64 { floor(a) }
fn fneg(a: f64) -> f64 { 0.0 - a }
fn f32add(a: f32, b: f32) -> f32 { a * b }
fn conv(a: f64) -> i64 { i64(a) }
fn conv2(a: i64) -> f64 { f64(a) }
fn conv3(a: f32) -> f64 { f64(a) }
fn idiv(a: i64, b: i64) -> i64 { a / b }
fn irem(a: i64, b: i64) -> i64 { a % b }
fn shl(a: i64, b: i64) -> i64 { a << b }
fn shr(a: i64, b: i64) -> i64 { a >> b }
fn ushr(a: u64, b: u64) -> u64 { a >> b }
fn lt(a: i64, b: i64) -> bool { a < b }
fn flt(a: f64, b: f64) -> bool { a < b }
fn d7(a: i64) -> i64 { a / 7 }
fn r7(a: i64) -> i64 { a % 7 }
fn u7(a: u64) -> u64 { a / 7 }
fn mul(a: i64, b: i64) -> i64 { a * b }
fn sub(a: i64, b: i64) -> i64 { a - b }
fn sub2(a: i64, b: i64) -> i64 { b - a }
fn narrow(a: i64) -> u8 { u8(a) }
fn narrow2(a: i64) -> i32 { i32(a) }
fn main() {
    print(fdiv(7.0, 2.0))
    print(fadd(1.25, 2.5))
    print(fsqrt(16.0))
    print(ffloor(2.75))
    print(fneg(3.5))
    print(f32add(1.5, 3.0))
    print(conv(-3.75))
    print(conv2(-12))
    print(conv3(0.5))
    print(idiv(-17, 5))
    print(irem(-17, 5))
    print(shl(3, 4))
    print(shr(-64, 3))
    print(ushr(18446744073709551615, 60))
    print(lt(1, 2))
    print(flt(2.0, 1.0))
    print(d7(-50))
    print(r7(-50))
    print(u7(18446744073709551615))
    print(mul(6, -7))
    print(sub(10, 3))
    print(sub2(10, 3))
    print(narrow(511))
    print(narrow2(4294967295))
}
