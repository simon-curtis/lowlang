struct Node {
    name: str
    next: *Node?
}

struct Leaf {
    value: i64
}

struct Fork {
    left: *Leaf
    right: *Leaf
}

enum Tree {
    Branch(*Tree, *Tree)
    Tip(i64)
}

struct Ring {
    members: []*Node
}

fn main() {
    let a = new(Node { name: "a", next: none })
    let b = new(Node { name: "b", next: a })
    a.next = b
    print(a)
    print(b)

    let alone = new(Node { name: "alone", next: none })
    alone.next = alone
    print(alone)
    print("ring: {alone}")

    let leaf = new(Leaf { value: 5 })
    print(Fork { left: leaf, right: leaf })
    print(leaf)

    let tip = new(Tree.Tip(1))
    print(Tree.Branch(tip, tip))

    let first = new(Node { name: "first", next: none })
    let second = new(Node { name: "second", next: first })
    first.next = second
    print(Ring { members: [first, second] })
}
