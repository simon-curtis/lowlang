extern struct Pair {
    first: i64
    second: i64
}

fn second_of(address: i64) -> i64 {
    let at: ptr[i64] = ptr(address + 8)
    load(at)
}

fn main() {
    let held = pin(new(Pair { first: 3, second: 7 }))
    let address = i64(held)
    print(address != 0)
    print(ptr(address) == held)
    print(u64(held) == u64(address))
    print(ptr(0) == null)
    print(i64(null))
    let pair: ptr[Pair] = ptr(address)
    print(load(pair).first)
    print(second_of(address))
    unpin(held)
}
