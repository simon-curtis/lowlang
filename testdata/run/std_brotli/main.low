import std/compress/brotli
import std/crypto/hash
import std/io
import std/text

fn same(a: []u8, b: []u8) -> bool {
    if a.len != b.len {
        return false
    }
    for i in 0..a.len {
        if a[i] != b[i] {
            return false
        }
    }
    true
}

fn unpack(packed: []u8, limit: i64, want: []u8) -> str {
    let out = brotli.decompress(packed, limit) catch {
        Malformed => return "Malformed"
        TooLarge => return "TooLarge"
        _ => return "other"
    }
    if same(out, want) { "ok" } else { "differs" }
}

fn digest(packed: []u8) -> str {
    let out = brotli.decompress(packed, 1 << 24) or return "error"
    "{out.len} {text.encode_hex(hash.sum(hash.sha256(), out))}"
}

fn chunks(packed: []u8) -> str {
    var count = 0
    var total = 0
    let sink: fn([]u8) ! io.Error = fn(chunk) {
        count += 1
        total += chunk.len
    }
    brotli.decode(io.bytes_reader(packed), sink, 1 << 24) or return "error"
    "{total} bytes in {if count > 0 && count <= total / 1000 { "few" } else { "many" }} chunks"
}

fn main() {
    let sample = bytes(embed("sample.txt"))
    let empty: []u8 = []
    let q11 = bytes(embed("sample.q11.br"))
    print("empty {unpack(bytes(embed("empty.br")), 1 << 20, empty)}")
    print("quality 0 {unpack(bytes(embed("sample.q0.br")), 1 << 20, sample)}")
    print("quality 1 {unpack(bytes(embed("sample.q1.br")), 1 << 20, sample)}")
    print("quality 11 {unpack(q11, 1 << 20, sample)}")
    print("window 10 {unpack(bytes(embed("sample.w10.br")), 1 << 20, sample)}")
    print("mixed {digest(bytes(embed("mixed.br")))}")
    print("transforms {digest(bytes(embed("words.br")))}")
    print("mixed streamed {chunks(bytes(embed("mixed.br")))}")
    print("exact limit {unpack(q11, sample.len, sample)}")
    print("under limit {unpack(q11, sample.len - 1, sample)}")
    print("truncated {unpack(q11[..q11.len - 1], 1 << 20, sample)}")
    var trailing = bytes(embed("sample.q11.br"))
    push(mut trailing, 0)
    print("trailing {unpack(trailing, 1 << 20, sample)}")
    let large: []u8 = [0x11, 0x03]
    print("large window {unpack(large, 1 << 20, empty)}")
    let padding: []u8 = [0x86]
    print("padding {unpack(padding, 1 << 20, empty)}")
    let garbage: []u8 = [0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF]
    print("garbage {unpack(garbage, 1 << 20, empty)}")
}
