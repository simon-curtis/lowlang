import std/dbus
import std/text

fn text_result(r: dbus.MatchRule) -> str {
    let written = dbus.rule_text(r) catch {
        e => return "{e}"
    }
    written
}

fn signal(path: str, interface: str, member: str, body: []dbus.Value) -> dbus.Message {
    dbus.signal(path, interface, member, body)
}

fn strings(items: []str) -> []dbus.Value {
    var out: []dbus.Value = []
    for item in items {
        push(mut out, dbus.Value.String(item))
    }
    out
}

fn verdict(r: dbus.MatchRule, m: dbus.Message) -> str {
    if dbus.rule_matches(r, m) {
        return "match"
    }
    "no match"
}

fn main() {
    print("signal_rule")
    print("  {dbus.signal_rule("/org/example", "org.example.I", "Changed")}")
    print("  {dbus.signal_rule("", "", "")}")

    print("quote_rule_value")
    for s in ["plain", "", "it's", "a,b", "''", "back\\slash"] {
        print("  {text.quote(s)}: {dbus.quote_rule_value(s)}")
    }

    print("rule_text")
    print("  {text_result(dbus.MatchRule {})}")
    print("  {text_result(dbus.signal_rule("/org/example", "org.example.I", "Changed"))}")
    print("  {text_result(dbus.MatchRule { kind: "method_call", sender: "org.example.Svc", destination: ":1.5", interface: "org.example.I", member: "Ping", path: "/a" })}")
    print("  {text_result(dbus.MatchRule { kind: "method_return" })}")
    print("  {text_result(dbus.MatchRule { kind: "error" })}")
    print("  {text_result(dbus.MatchRule { path_namespace: "/org/example", arg0_namespace: "org.example" })}")
    print("  {text_result(dbus.MatchRule { args: [3: "c", 0: "a", 1: "it's"], arg_paths: [2: "/x/", 0: "/y"] })}")
    print("  {text_result(dbus.MatchRule { args: [63: "last"] })}")
    print("  {text_result(dbus.MatchRule { args: [0: ""] })}")
    print("  bad kind: {text_result(dbus.MatchRule { kind: "broadcast" })}")
    print("  bad sender: {text_result(dbus.MatchRule { sender: "nodots" })}")
    print("  bad destination: {text_result(dbus.MatchRule { destination: "nodots" })}")
    print("  bad interface: {text_result(dbus.MatchRule { interface: "x" })}")
    print("  bad member: {text_result(dbus.MatchRule { member: "a.b" })}")
    print("  bad path: {text_result(dbus.MatchRule { path: "a" })}")
    print("  bad path namespace: {text_result(dbus.MatchRule { path_namespace: "a" })}")
    print("  argument 64: {text_result(dbus.MatchRule { args: [64: "x"] })}")
    print("  argument -1: {text_result(dbus.MatchRule { args: [-1: "x"] })}")
    print("  path argument 64: {text_result(dbus.MatchRule { arg_paths: [64: "/x"] })}")

    let changed = signal("/org/example/Obj", "org.example.I", "Changed", strings(["alpha", "/aa/bb/cc", "org.example.Foo.bar"]))
    let call = dbus.method_call("org.example.Svc", "/org/example/Obj", "org.example.I", "Ping", [])
    let reply = dbus.method_return(call, [])
    let failure = dbus.error_reply(call, "org.example.Failed", "")

    print("rule_matches")
    print("  empty rule, signal: {verdict(dbus.MatchRule {}, changed)}")
    print("  empty rule, call: {verdict(dbus.MatchRule {}, call)}")
    print("  signal type, signal: {verdict(dbus.MatchRule { kind: "signal" }, changed)}")
    print("  signal type, call: {verdict(dbus.MatchRule { kind: "signal" }, call)}")
    print("  method_call type, call: {verdict(dbus.MatchRule { kind: "method_call" }, call)}")
    print("  method_return type, reply: {verdict(dbus.MatchRule { kind: "method_return" }, reply)}")
    print("  method_return type, call: {verdict(dbus.MatchRule { kind: "method_return" }, call)}")
    print("  error type, error: {verdict(dbus.MatchRule { kind: "error" }, failure)}")
    print("  error type, reply: {verdict(dbus.MatchRule { kind: "error" }, reply)}")
    print("  interface: {verdict(dbus.MatchRule { interface: "org.example.I" }, changed)}")
    print("  other interface: {verdict(dbus.MatchRule { interface: "org.example.J" }, changed)}")
    print("  member: {verdict(dbus.MatchRule { member: "Changed" }, changed)}")
    print("  other member: {verdict(dbus.MatchRule { member: "Other" }, changed)}")
    print("  path: {verdict(dbus.MatchRule { path: "/org/example/Obj" }, changed)}")
    print("  other path: {verdict(dbus.MatchRule { path: "/org/example" }, changed)}")
    print("  sender and destination are left to the bus: {verdict(dbus.MatchRule { sender: ":1.9", destination: ":1.8" }, changed)}")
    print("  path namespace, below: {verdict(dbus.MatchRule { path_namespace: "/org/example" }, changed)}")
    print("  path namespace, equal: {verdict(dbus.MatchRule { path_namespace: "/org/example/Obj" }, changed)}")
    print("  path namespace, longer name: {verdict(dbus.MatchRule { path_namespace: "/org/example/Ob" }, changed)}")
    print("  path namespace, root: {verdict(dbus.MatchRule { path_namespace: "/" }, changed)}")
    print("  path namespace, elsewhere: {verdict(dbus.MatchRule { path_namespace: "/org/other" }, changed)}")
    print("  argument 0: {verdict(dbus.MatchRule { args: [0: "alpha"] }, changed)}")
    print("  argument 0, different: {verdict(dbus.MatchRule { args: [0: "beta"] }, changed)}")
    print("  argument 1 and 0: {verdict(dbus.MatchRule { args: [1: "/aa/bb/cc", 0: "alpha"] }, changed)}")
    print("  argument beyond the body: {verdict(dbus.MatchRule { args: [3: "x"] }, changed)}")
    print("  argument of another type: {verdict(dbus.MatchRule { args: [0: "1"] }, signal("/a", "org.example.I", "Changed", [dbus.Value.Int32(1)]))}")
    print("  empty argument: {verdict(dbus.MatchRule { args: [0: ""] }, signal("/a", "org.example.I", "Changed", strings([""])))}")
    print("  path argument, equal: {verdict(dbus.MatchRule { arg_paths: [1: "/aa/bb/cc"] }, changed)}")
    print("  path argument, rule is a prefix with a slash: {verdict(dbus.MatchRule { arg_paths: [1: "/aa/bb/"] }, changed)}")
    print("  path argument, rule is a prefix without a slash: {verdict(dbus.MatchRule { arg_paths: [1: "/aa/bb"] }, changed)}")
    print("  path argument, value is a prefix with a slash: {verdict(dbus.MatchRule { arg_paths: [1: "/aa/bb/cc/dd"] }, signal("/a", "org.example.I", "Changed", strings(["x", "/aa/bb/"])))}")
    print("  path argument, value is a prefix without a slash: {verdict(dbus.MatchRule { arg_paths: [1: "/aa/bb/cc/dd"] }, signal("/a", "org.example.I", "Changed", strings(["x", "/aa/bb"])))}")
    print("  path argument, unrelated: {verdict(dbus.MatchRule { arg_paths: [1: "/xx/"] }, changed)}")
    print("  path argument of an object path: {verdict(dbus.MatchRule { arg_paths: [0: "/aa/"] }, signal("/a", "org.example.I", "Changed", [dbus.Value.ObjectPath("/aa/bb")]))}")
    print("  path argument beyond the body: {verdict(dbus.MatchRule { arg_paths: [5: "/aa/"] }, changed)}")
    print("  argument 0 namespace, equal: {verdict(dbus.MatchRule { arg0_namespace: "org.example.Foo" }, signal("/a", "org.example.I", "Changed", strings(["org.example.Foo"])))}")
    print("  argument 0 namespace, below: {verdict(dbus.MatchRule { arg0_namespace: "org.example.Foo" }, signal("/a", "org.example.I", "Changed", strings(["org.example.Foo.bar"])))}")
    print("  argument 0 namespace, longer name: {verdict(dbus.MatchRule { arg0_namespace: "org.example.Foo" }, signal("/a", "org.example.I", "Changed", strings(["org.example.Foobar"])))}")
    print("  argument 0 namespace, without a body: {verdict(dbus.MatchRule { arg0_namespace: "org.example.Foo" }, signal("/a", "org.example.I", "Changed", []))}")
    print("  everything: {verdict(dbus.MatchRule { kind: "signal", interface: "org.example.I", member: "Changed", path: "/org/example/Obj", path_namespace: "/org", args: [0: "alpha"], arg_paths: [1: "/aa/"], arg0_namespace: "alpha" }, changed)}")
}
