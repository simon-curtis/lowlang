fn captured_after(n: i64) -> i64 {
    var xs: []i64 = []
    for i in 0..n {
        push(mut xs, i * 3)
    }
    let sum = fn() -> i64 {
        var t = 0
        for x in xs {
            t += x
        }
        t
    }
    push(mut xs, 1000)
    sum() + xs.len
}

fn captured_before(n: i64) -> i64 {
    var xs: []i64 = []
    let add = fn(v: i64) {
        push(mut xs, v)
    }
    for i in 0..n {
        add(i * 2)
    }
    var total = xs.len
    for i in 0..xs.len {
        total += xs[i]
    }
    total
}

fn counter_of_lists() -> fn(i64) -> i64 {
    var seen: []i64 = []
    for i in 0..5 {
        push(mut seen, i)
    }
    fn(v: i64) -> i64 {
        push(mut seen, v)
        seen.len * 100 + seen[seen.len - 1]
    }
}

fn main() {
    print(captured_after(20))
    print(captured_before(20))
    let next = counter_of_lists()
    print(next(70))
    print(next(71))
    print(next(72))
}
