import std/charset
import std/text

fn hex_bytes(data: []u8) -> str {
    var parts: []str = []
    for b in data {
        push(mut parts, text.hex(i64(b)))
    }
    text.join(parts, " ")
}

fn codes(s: str) -> str {
    var parts: []str = []
    for c in s {
        push(mut parts, text.hex(i64(c)))
    }
    text.join(parts, " ")
}

fn error_text(e: charset.Error) -> str {
    match e {
        UnknownEncoding => "unknown encoding"
        Malformed(at) => "malformed at {at}"
        Unmappable(at, c) => "unmappable {text.hex(i64(c))} at {at}"
    }
}

fn decoded(label: str, data: []u8) -> str {
    charset.decode(label, data) catch { e => error_text(e) }
}

fn encoded(label: str, s: str) -> str {
    let data = charset.encode(label, s) catch { e => return error_text(e) }
    hex_bytes(data)
}

fn all_bytes() -> []u8 {
    var out: []u8 = []
    for b in 0..256 {
        push(mut out, u8(b))
    }
    out
}

fn fingerprint(s: str) -> u64 {
    var h: u64 = 14695981039346656037
    for c in s {
        h = (h ^ u64(c)) * 1099511628211
    }
    h
}

fn round_trip(label: str) -> bool {
    let data = all_bytes()
    let s = charset.decode(label, data) catch { e => "" }
    let back = charset.encode(label, s) catch { e => bytes("") }
    hex_bytes(back) == hex_bytes(data)
}

fn name_of(label: str) -> str {
    charset.canonical(label) ?? "none"
}

fn bom_text(data: []u8) -> str {
    match charset.detect_bom(data) {
        some(b) => "{b.name} {b.len}"
        none => "none"
    }
}

fn main() {
    for label in ["latin1", "ISO-8859-1", "  Latin1\n", "cp1252", "windows-1252", "ascii", "iso-8859-2", "latin2", "iso-8859-15", "l9", "koi8-r", "KOI8_R", "cp1250", "windows-1251", "cp437", "ibm850", "utf8", "UTF-8", "utf-16", "utf-16be", "utf-32be", "shift_jis", ""] {
        print("{label.len} {name_of(label)}")
    }

    for label in ["ISO-8859-1", "windows-1252", "windows-1250", "windows-1251", "ISO-8859-2", "ISO-8859-15", "KOI8-R", "IBM437", "IBM850"] {
        let all = decoded(label, all_bytes())
        print("{label} {fingerprint(all)} {round_trip(label)}")
    }

    print(codes(decoded("latin1", [0x63, 0x61, 0x66, 0xE9, 0x80, 0xFF])))
    print(codes(decoded("windows-1252", [0x80, 0x81, 0x93, 0x94, 0x9F, 0xE9])))
    print(codes(decoded("windows-1250", [0x8A, 0x9A, 0xA3, 0xB3, 0xE8])))
    print(codes(decoded("windows-1251", [0xCF, 0xF0, 0xE8, 0xE2, 0xE5, 0xF2, 0xB8])))
    print(decoded("windows-1251", [0xCF, 0xF0, 0xE8, 0xE2, 0xE5, 0xF2]))
    print(decoded("iso-8859-2", [0xA3, 0xB3, 0xEA, 0xF8]))
    print(decoded("iso-8859-15", [0xA4, 0xA6, 0xA8, 0xBC, 0xBD, 0xBE]))
    print(decoded("koi8-r", [0xF0, 0xD2, 0xC9, 0xD7, 0xC5, 0xD4]))
    print(decoded("cp437", [0xDA, 0xC4, 0xBF, 0xB3, 0xB0, 0xE0, 0xE1, 0xE3, 0xF1]))
    print(decoded("cp850", [0xB5, 0xD0, 0xE0, 0xE9, 0x9B]))

    print(encoded("latin1", "café"))
    print(encoded("latin1", "€"))
    print(encoded("windows-1252", "€“”™"))
    print(encoded("windows-1252", "Ā"))
    print(encoded("windows-1250", "Šš Łł"))
    print(encoded("windows-1251", "Привет, мир"))
    print(encoded("iso-8859-2", "Zażółć"))
    print(encoded("iso-8859-15", "€ŠšŽžŒœŸ"))
    print(encoded("koi8-r", "Привет"))
    print(encoded("cp437", "┌─┐│é"))
    print(encoded("cp850", "Éé¢"))
    print(encoded("windows-1252", "plain ascii"))
    print(encoded("windows-1252", "ab😀"))
    print(encoded("nonsense", "a"))

    print(hex_bytes(charset.encode_replace("latin1", "a€b😀", "?") catch { e => bytes("") }))
    print(hex_bytes(charset.encode_replace("ascii", "é", "") catch { e => bytes("") }))
    print(hex_bytes(charset.encode_replace("utf-8", "é€", "?") catch { e => bytes("") }))
    print(hex_bytes(charset.encode_replace("utf-16be", "a", "?") catch { e => bytes("") }))
    print(hex_bytes(charset.encode_replace("utf-32le", "a", "?") catch { e => bytes("") }))
    print(hex_bytes(charset.encode_replace("bogus", "a", "?") catch { e => bytes("E") }))

    print(decoded("utf-8", [0x61, 0xC3, 0xA9]))
    print(decoded("utf-8", [0xEF, 0xBB, 0xBF, 0x61]))
    print(decoded("utf-8", [0x61, 0xFF, 0x62]))
    print(decoded("utf-16le", [0x61, 0x00, 0x3D, 0xD8, 0x00, 0xDE]))
    print(decoded("utf-16be", [0xFE, 0xFF, 0x00, 0x61]))
    print(decoded("utf-16", [0xFE, 0xFF, 0x00, 0x61]))
    print(decoded("utf-16le", [0x61]))
    print(decoded("utf-16le", [0x00, 0xD8]))
    print(decoded("utf-32le", [0x61, 0, 0, 0]))
    print(decoded("utf-32be", [0, 0, 0, 0x61, 0, 0xD8, 0, 0]))
    print(decoded("utf-32le", [1, 2, 3]))
    print(decoded("klingon", [0x61]))

    print(codes(charset.decode_lossy("utf-8", [0x61, 0xFF, 0x62]) catch "x"))
    print(codes(charset.decode_lossy("utf-16le", [0x61, 0x00, 0x62]) catch "x"))
    print(codes(charset.decode_lossy("utf-32be", [0, 0, 0, 0x61, 0x62]) catch "x"))
    print(codes(charset.decode_lossy("windows-1252", [0x81, 0x41]) catch "x"))
    print(charset.decode_lossy("klingon", [0x61]) catch "unknown")

    print(hex_bytes(charset.encode("utf-8", "é€") catch { e => bytes("") }))
    print(hex_bytes(charset.encode("utf-16le", "é😀") catch { e => bytes("") }))
    print(hex_bytes(charset.encode("utf-32be", "é") catch { e => bytes("") }))

    print(bom_text([0xEF, 0xBB, 0xBF, 0x41]))
    print(bom_text([0xFF, 0xFE, 0x41, 0x00]))
    print(bom_text([0xFE, 0xFF, 0x00, 0x41]))
    print(bom_text([0xFF, 0xFE, 0x00, 0x00, 0x41, 0, 0, 0]))
    print(bom_text([0x00, 0x00, 0xFE, 0xFF]))
    print(bom_text([0xEF, 0xBB]))
    print(bom_text([0x41, 0x42]))
    print(bom_text([]))
}
