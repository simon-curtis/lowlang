import std/serde

struct Reading {
    id: i32 "1"
    scale: f64 "2,fixed" = 1.0
    label: str
    samples: i64[] "4,sint,unpacked"
}

enum Level {
    Low = 3
    High = 7
}

enum Source {
    Sensor(id: i32 "sint") = 1
    Note(text: str) = 9
    Plain(i64 "fixed") = 4
}

enum Position {
    First
    Second(i64 "fixed")
}

fn show(p: serde.Property) {
    print("{p.name}: {p.schema.kind} tag [{p.tag}] required {p.required}")
}

fn main() {
    let reading = serde.schema[Reading]()
    for p in reading.fields {
        show(p)
    }
    let source = serde.schema[Source]()
    for v in source.variants {
        print("{v.name} index {v.index} labelled {v.labelled}")
        for p in v.fields {
            show(p)
        }
    }
    let level = serde.schema[Level]()
    for v in level.variants {
        print("{v.name} index {v.index}")
    }
    let position = serde.schema[Position]()
    for v in position.variants {
        print("{v.name} index {v.index}")
    }
}
