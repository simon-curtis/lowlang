struct Pad8 {
    a: i64 = 0
    b: i64 = 0
    c: i64 = 0
    d: i64 = 0
    e: i64 = 0
    f: i64 = 0
    g: i64 = 0
    h: i64 = 0
}

struct Pad64 {
    a: Pad8 = Pad8 {}
    b: Pad8 = Pad8 {}
    c: Pad8 = Pad8 {}
    d: Pad8 = Pad8 {}
    e: Pad8 = Pad8 {}
    f: Pad8 = Pad8 {}
    g: Pad8 = Pad8 {}
    h: Pad8 = Pad8 {}
}

struct Pad512 {
    a: Pad64 = Pad64 {}
    b: Pad64 = Pad64 {}
    c: Pad64 = Pad64 {}
    d: Pad64 = Pad64 {}
    e: Pad64 = Pad64 {}
    f: Pad64 = Pad64 {}
    g: Pad64 = Pad64 {}
    h: Pad64 = Pad64 {}
}

struct Pad4096 {
    a: Pad512 = Pad512 {}
    b: Pad512 = Pad512 {}
    c: Pad512 = Pad512 {}
    d: Pad512 = Pad512 {}
    e: Pad512 = Pad512 {}
    f: Pad512 = Pad512 {}
    g: Pad512 = Pad512 {}
    h: Pad512 = Pad512 {}
}

fn make(seed: i64) -> Pad4096 {
    var pad = Pad4096 {}
    pad.a.a.a.a = seed
    pad.h.h.h.h = seed * 3
    pad
}

fn first_and_last(pad: Pad4096) -> i64 {
    pad.a.a.a.a + pad.h.h.h.h
}

fn doubled(pad: Pad4096) -> Pad4096 {
    var next = pad
    next.a.a.a.a = pad.a.a.a.a * 2
    next.h.h.h.h = pad.h.h.h.h * 2
    next
}

fn apply(f: fn(Pad4096) -> i64, pad: Pad4096) -> i64 {
    f(pad)
}

fn transform(f: fn(Pad4096) -> Pad4096, pad: Pad4096) -> Pad4096 {
    f(pad)
}

fn scaled(k: i64) -> fn(Pad4096) -> i64 {
    fn(pad: Pad4096) -> i64 { (pad.a.a.a.a + pad.h.h.h.h) * k }
}

fn shifted(base: Pad4096) -> fn(Pad4096, i64) -> Pad4096 {
    fn(pad: Pad4096, by: i64) -> Pad4096 {
        var next = pad
        next.a.a.a.a = base.a.a.a.a + by
        next.h.h.h.h = pad.h.h.h.h + by
        next
    }
}

fn main() {
    let pad = make(4)
    print(apply(first_and_last, pad))
    print(apply(scaled(10), pad))
    print(first_and_last(transform(doubled, pad)))
    let shift = shifted(make(100))
    let moved = shift(pad, 5)
    print(moved.a.a.a.a)
    print(moved.h.h.h.h)
    var chosen: fn(Pad4096) -> i64 = first_and_last
    var total = 0
    for k in 1..4 {
        total += chosen(pad)
        chosen = scaled(k)
    }
    print(total)
}
