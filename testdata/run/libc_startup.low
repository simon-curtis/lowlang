extern "c" {
    fn printf(format: ptr[u8], ...) -> i32
    fn puts(s: ptr[u8]) -> i32
    fn fflush(stream: ptr) -> i32
    fn atexit(handler: extern fn(ptr) -> i32) -> i32
    fn cxa_atexit(handler: extern fn(ptr[u8]) -> i32, arg: ptr[u8], dso: ptr) -> i32 = "__cxa_atexit"
}

fn main() {
    print(atexit(fflush))
    print(cxa_atexit(puts, cstr("exit handler ran"), null))
    printf(cstr("stdio flushed at exit %d "), 42)
    print("low output")
}
