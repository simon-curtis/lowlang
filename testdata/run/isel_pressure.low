fn weighted(xs: []i64, n: i64) -> i64 {
    let a = n + 1
    let b = n + 2
    let c = n + 3
    let d = n + 4
    let e = n + 5
    let f = n + 6
    let g = n + 7
    let h = n + 8
    let i = n + 9
    let j = n + 10
    var total = 0
    for k in 0..xs.len {
        total += xs[k] * a + b
        total ^= c
    }
    total + d + e + f + g + h + i + j
}

fn inner_hot(xs: []i64) -> i64 {
    let p = xs[0]
    let q = xs[1]
    let r = xs[2]
    let s = xs[3]
    let t = xs[4]
    let u = xs[5]
    let v = xs[6]
    let w = xs[7]
    let x = xs[8]
    let y = xs[9]
    var acc = 0
    var i = 0
    for i < 40 {
        var j = 0
        for j < 40 {
            acc += (i ^ j) + (i & j) - (i | j) + (j << 1)
            acc = (acc * 31) % 1000003
            j += 1
        }
        i += 1
    }
    acc + p + q * 2 + r * 3 + s * 4 + t * 5 + u * 6 + v * 7 + w * 8 + x * 9 + y * 10
}

fn floats(xs: []f64, n: i64) -> f64 {
    let a = xs[0]
    let b = xs[1]
    let c = xs[2]
    let d = xs[3]
    let e = xs[4]
    let f = xs[5]
    let g = xs[6]
    let h = xs[7]
    var total = 0.0
    for k in 0..n {
        let x = f64(k)
        total += x * a + b
        total -= x * c
        total += d * e
    }
    total + f + g * h
}

fn quick(xs: []i64, lo: i64, hi: i64) {
    if lo >= hi {
        return
    }
    let pivot = xs[(lo + hi) / 2]
    var i = lo
    var j = hi
    for i <= j {
        for xs[i] < pivot {
            i += 1
        }
        for xs[j] > pivot {
            j -= 1
        }
        if i <= j {
            let t = xs[i]
            xs[i] = xs[j]
            xs[j] = t
            i += 1
            j -= 1
        }
    }
    quick(xs, lo, j)
    quick(xs, i, hi)
}

fn lcg(n: i64) -> []i64 {
    var xs: []i64 = []
    var state = 12345
    for i in 0..n {
        state = (state * 1103515245 + 12345) % 2147483648
        push(mut xs, state % 1000)
    }
    xs
}

fn checksum(xs: []i64) -> i64 {
    var t = 0
    for i in 0..xs.len {
        t = (t * 31 + xs[i]) % 1000000007
    }
    t
}

fn sorted(xs: []i64) -> bool {
    for i in 1..xs.len {
        if xs[i - 1] > xs[i] {
            return false
        }
    }
    true
}

fn main() {
    let ys = lcg(200)
    print(weighted(ys, 7))
    print(inner_hot([3, 1, 4, 1, 5, 9, 2, 6, 5, 3]))
    print(floats([1.5, 2.5, 3.5, 0.25, 4.0, 8.5, 0.5, 7.0], 100))
    var data = lcg(500)
    quick(data, 0, data.len - 1)
    print(sorted(data))
    print(checksum(data))
    print("{data[0]} {data[249]} {data[499]}")
}
