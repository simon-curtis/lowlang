fn filled(n: i64) -> i64 {
    var xs: []u8 = []
    for i in 0..n {
        push(mut xs, u8(0))
    }
    var total = 0
    for i in 0..n {
        total += i64(xs[i])
    }
    print("within: {total}")
    for i in 0..n + 1 {
        total += i64(xs[i])
    }
    total
}

fn main() {
    print(filled(9))
}
