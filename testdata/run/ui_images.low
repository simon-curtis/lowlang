import std/image
import std/ui
import std/ui/geometry
import std/ui/platform
import std/ui/scene
import uitext = std/ui/text

fn show(r: geometry.Rect) -> str {
    "{r.x} {r.y} {r.width} {r.height}"
}

fn halves(width: i64, height: i64) -> image.Image {
    let img = image.create(width, height, Rgb8)
    for y in 0..height {
        for x in 0..width {
            let c = if x < width / 2 { image.Rgba { r: 255, g: 0, b: 0, a: 255 } } else { image.Rgba { r: 0, g: 0, b: 255, a: 255 } }
            img.set(x, y, c)
        }
    }
    img
}

fn texel(a: scene.Atlas, uv: geometry.Rect, x: i64, y: i64) -> str {
    let left = i64(uv.x * f32(a.size) + 0.5) + x
    let top = i64(uv.y * f32(a.size) + 0.5) + y
    let at = (top * a.size + left) * 4
    let p = a.colors.pixels
    "{p[at]},{p[at + 1]},{p[at + 2]},{p[at + 3]}"
}

fn direct() {
    print("direct")
    var sys = uitext.system_with_atlas([], 64)
    var sc = scene.empty(64, 64, ui.rgb(0xffffff))
    let img = halves(4, 2)
    let whole = geometry.rect(0.0, 0.0, 4.0, 2.0)
    sys.paint_image(mut sc, "a", img, whole, scene.Picture { bounds: geometry.rect(10.25, 3.6, 4.0, 2.0), opacity: 0.5 })
    let p = sc.pictures[0]
    print("bounds {show(p.bounds)} opacity {p.opacity} tile {show(p.tile)}")
    print("texels {texel(sys.atlas, p.tile, 0, 0)} {texel(sys.atlas, p.tile, 3, 1)} border {texel(sys.atlas, p.tile, -1, 0)}")
    sys.atlas.clean()
    sys.paint_image(mut sc, "a", img, whole, scene.Picture { bounds: geometry.rect(30.0, 30.0, 4.0, 2.0) })
    print("again {sc.pictures[1].tile == p.tile} dirty {sys.atlas.dirty()}")
    sys.paint_image(mut sc, "a", img, geometry.rect(2.0, 0.0, 2.0, 2.0), scene.Picture { bounds: geometry.rect(0.0, 0.0, 2.0, 2.0) })
    let right = sc.pictures[2]
    print("crop {texel(sys.atlas, right.tile, 0, 0)} {texel(sys.atlas, right.tile, 1, 1)} rows {sys.atlas.colors.dirty_top}..{sys.atlas.colors.dirty_bottom}")
    let gray = image.create(1, 1, Gray8)
    gray.set(0, 0, image.Rgba { r: 9, g: 9, b: 9, a: 255 })
    sys.paint_image(mut sc, "g", gray, geometry.rect(0.0, 0.0, 1.0, 1.0), scene.Picture { bounds: geometry.rect(0.0, 0.0, 1.0, 1.0) })
    print("gray {texel(sys.atlas, sc.pictures[3].tile, 0, 0)}")
    sys.paint_image(mut sc, "big", img, whole, scene.Picture { bounds: geometry.rect(0.0, 0.0, 63.0, 2.0) })
    sys.paint_image(mut sc, "none", img, geometry.rect(5.0, 0.0, 2.0, 2.0), scene.Picture { bounds: geometry.rect(0.0, 0.0, 2.0, 2.0) })
    print("pictures {sc.pictures.len}")
}

fn fits(cx: ui.Context) {
    print("fits")
    let wide = cx.render_image(halves(40, 20))
    let view = fn() -> ui.Element {
        ui.div().column().children() {
            ui.div().row().children() {
                ui.img(wide).size(20.0, 20.0)
                ui.img(wide).size(20.0, 20.0).object_fit(Fill)
                ui.img(wide).size(20.0, 20.0).object_fit(Cover).rounded(4.0)
                ui.img(wide).size(20.0, 20.0).object_fit(Unscaled).opacity(0.5)
                ui.img(wide).size(60.0, 30.0).object_fit(ScaleDown).grayscale(true)
                ui.img(wide).size(10.0, 10.0).object_fit(ScaleDown).padding(2.0)
            }
            ui.div().width(30.0).child(ui.img(wide))
            ui.img(wide).id("hovered").hover(fn(v) v.with_grayscale(true))
        }
    }
    let size = geometry.size(200.0, 100.0)
    let first = cx.frame(view, size, 1.0)
    for p in first.pictures {
        print("picture {show(p.bounds)} corners {p.corner_radii.top_left} opacity {p.opacity} gray {p.grayscale} tile {p.tile.width * 1024.0} {p.tile.height * 1024.0}")
    }
    print("cover and unscaled share pixels {first.pictures[2].tile == first.pictures[3].tile}")
    cx.dispatch(PointerMoved(5.0, 50.0))
    let hovered = cx.frame(view, size, 2.0)
    let last = hovered.pictures[hovered.pictures.len - 1]
    print("scaled {show(hovered.pictures[2].bounds)} corners {hovered.pictures[2].corner_radii.top_left} hovered {show(last.bounds)} gray {last.grayscale}")
}

fn main() {
    direct()
    fits(ui.headless(ui.rgb(0xffffff)))
}
