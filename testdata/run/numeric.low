fn hypot(a: f64, b: f64) -> f64 {
    sqrt(a * a + b * b)
}

fn scaled(x: f64) -> i64 {
    i64(floor(x * 1000000.0))
}

fn main() {
    var a: u8 = 250
    a += 10
    print(a)
    let b: u8 = 255
    print(b + 1)
    var c: i32 = 2147483647
    c += 1
    print(c)
    let d: u16 = 65535
    print(d * d)
    let e: u32 = 4294967295
    print(e + 2)

    let big: u32 = 4000000000
    let small: u32 = 5
    print(big > small)
    print(big / small)
    print(big % 7)
    let neg: i32 = -7
    print(neg / 2)
    print(neg % 2)
    print(neg >> 1)
    print(neg % -1)

    print(0xF0 & 0x3C)
    print(0xF0 | 0x0F)
    print(0xFF ^ 0x0F)
    print(~0)
    let m: u8 = 0b1010_0101
    print(~m)
    print(m << 1)
    print(m >> 4)
    var s: i64 = 1
    s <<= 62
    print(s)
    let n = 70
    print(1 << n)
    print(-8 >> n)
    let k = 3
    print(5 << k)
    var flags: u32 = 0
    flags |= 1 << 3
    flags |= 3
    flags &= ~2
    print(flags)

    print(u8(300))
    print(i32(4294967295))
    print(i64(3.99))
    print(i64(-3.99))
    print(u8(f64(258)))
    let x: f32 = 1.5
    print(i64(f64(x) * 4.0))

    print(hypot(3.0, 4.0) == 5.0)
    print(scaled(sqrt(2.0)))
    print(i64(floor(-2.5)))
    print(scaled(exp(1.0)))
    print(i64(exp(10.0)))
    print(scaled(exp(-2.5)))
    print(exp(-1000.0) == 0.0)
    print(exp(1000.0) > 1.0e308)
    let nan = sqrt(-1.0)
    print(nan == nan)
    print(nan != nan)
    print(nan < 1.0)
    print(1.0 < 2.0)
    print(2.0 <= 2.0)
    let half: f32 = 0.5
    print(i64(sqrt(half * 8.0)))
    print(scaled(f64(f32(0.1))))
    print(i64(-x))
    var acc = 0.0
    var i = 0
    for i < 10 {
        acc += 0.1
        i += 1
    }
    print(acc == 1.0)
    print(scaled(acc))
}
