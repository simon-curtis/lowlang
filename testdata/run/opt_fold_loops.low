fn a(n: i64) -> i64 {
    var x = n
    var i = 0
    for 3 > 2 {
        i += 1
        if i > 10 { break }
        if 2 > 3 { x = x * 100 } else { x = x + i }
    }
    x
}
fn b(n: i64) -> i64 {
    var x = n
    for 1 > 2 {
        x += 1
        return x
    }
    let k = 7
    var y = 0
    if k * 3 == 21 { y = x + 1 } else { y = x - 1 }
    y
}
fn c(n: i64) -> i64 {
    var t = 0
    var s = 5
    for i in 0..n {
        let z = 4 / 2
        if z == 2 {
            if n > 3 { t += s } else { t -= s }
            s = s + 1
        } else {
            let u = s
            s = t
            t = u
        }
    }
    t * 100 + s
}
fn d(n: i64) -> i64 {
    var x = 0
    var flag = true
    for i in 0..n {
        if flag { x += i }
        flag = true
        if 0 * i == 1 { flag = false }
    }
    x
}
fn main() {
    print(a(5))
    print(b(5))
    print(c(0))
    print(c(2))
    print(c(10))
    print(d(10))
}
