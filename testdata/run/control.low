fn sign(n: i64) -> i64 {
    if n < 0 { return -1 }
    if n == 0 { return 0 }
    1
}

fn gcd(a: i64, b: i64) -> i64 {
    var x = a
    var y = b
    for y != 0 {
        let t = y
        y = x % y
        x = t
    }
    x
}

fn main() {
    print(sign(-5))
    print(sign(0))
    print(sign(12))
    print(gcd(1071, 462))

    var odd = 0
    var i = 0
    for i < 10 {
        i += 1
        if i % 2 == 0 { continue }
        odd += i
    }
    print(odd)

    let x = 5
    let y = {
        let x = 10
        x * 2
    }
    print(x + y)

    var n = 100
    n -= 1
    n *= 3
    n /= 2
    print(n)
    print(-7 / 2)
    print(-7 % 2)
    print("tab\there \"quoted\"")
    print("" == "")
    print("a" != "b")
    print(1 > 2 || 3 >= 3)
}
