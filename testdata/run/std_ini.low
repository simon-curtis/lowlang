import std/ini
import std/text

fn source() -> str {
    let lines = [
        "; global comment",
        "name = global value",
        "# another comment",
        "[server]",
        "host = example.com",
        "port: 8080",
        "path = C:\\temp\\dir",
        "quoted = \"  padded value  \"",
        "escaped = \"tab\\there\\nnewline \\\"q\\\" \\u00e9 \\; \\\\\"",
        "tail = \"done\"   ; trailing comment",
        "empty =",
        "spaced   =   inside   ",
        "colon = a:b=c",
        "[server]",
        "extra = yes",
        "[ spaced section ]  # note",
        "long = first \\",
        "    second \\",
        "    third",
        "Mixed = CaseSensitive",
        "mixed = lower",
        "dup = 1",
        "dup = 2",
        "url = http://a/b?c=d",
        "quoted_cont = \"abc \\",
        "   def\"",
        "double = a\\\\",
        "after = ok",
        "hash = #fff ; not a comment",
    ]
    "{text.join(lines, "\n")}\n"
}

fn show(d: ini.Document, section: str, key: str) {
    print("[{section}] {key} = {d.get(section, key) ?? "<none>"}")
}

fn describe(e: ini.Error) -> str {
    match e {
        Syntax(line, message) => "line {line}: {message}"
    }
}

fn parsed(label: str, s: str) {
    let d = ini.parse(s) catch {
        e => {
            print("{label}: {describe(e)}")
            return
        }
    }
    print("{label}: ok {text.join(d.sections(), ",")}")
}

fn main() {
    let d = ini.parse(source()) catch {
        e => {
            print("failed {describe(e)}")
            return
        }
    }
    print(text.join(d.sections(), "|"))
    print(text.join(d.keys(""), "|"))
    print(text.join(d.keys("server"), "|"))
    print(text.join(d.keys("spaced section"), "|"))
    show(d, "", "name")
    show(d, "server", "host")
    show(d, "server", "port")
    show(d, "server", "path")
    show(d, "server", "quoted")
    show(d, "server", "escaped")
    show(d, "server", "tail")
    show(d, "server", "empty")
    show(d, "server", "spaced")
    show(d, "server", "colon")
    show(d, "server", "extra")
    show(d, "spaced section", "long")
    show(d, "spaced section", "Mixed")
    show(d, "spaced section", "mixed")
    show(d, "spaced section", "MIXED")
    show(d, "spaced section", "dup")
    show(d, "spaced section", "url")
    show(d, "spaced section", "quoted_cont")
    show(d, "spaced section", "double")
    show(d, "spaced section", "after")
    show(d, "spaced section", "hash")
    show(d, "missing", "name")
    show(d, "server", "name")
    print(d.has_section("server"))
    print(d.has_section("nope"))
    print(d.has_section(""))

    let all = ini.parse_with(source(), ini.Options { collect: true }) catch {
        e => {
            print("failed {describe(e)}")
            return
        }
    }
    print(text.join(all.get_all("spaced section", "dup"), ","))
    print(text.join(all.get_all("server", "host"), ","))
    print(text.join(all.get_all("server", "nothing"), ","))
    show(all, "spaced section", "dup")
    print(text.join(all.keys("spaced section"), "|"))
    print(d.sections[1].entries[0].line)
    print(d.sections[1].entries[1].line)

    let rendered = ini.format(d)
    print(rendered)
    let again = ini.parse(rendered) catch {
        e => {
            print("reparse failed {describe(e)}")
            return
        }
    }
    print(ini.format(again) == rendered)

    var built = ini.document()
    built.set("", "mode", "fast")
    built.set("net", "host", " padded ")
    built.set("net", "note", "line one\nline \"two\"\\")
    built.set("net", "host", "  spaced  ")
    built.add("net", "peer", "a")
    built.add("net", "peer", "b")
    built.set("empty", "e", "")
    let text_form = ini.format(built)
    print(text_form)
    let rebuilt = ini.parse_with(text_form, ini.Options { collect: true }) catch {
        e => {
            print("rebuilt failed {describe(e)}")
            return
        }
    }
    show(rebuilt, "net", "host")
    show(rebuilt, "net", "note")
    print(text.join(rebuilt.get_all("net", "peer"), ","))
    print(ini.format(rebuilt) == text_form)

    parsed("empty source", "")
    parsed("bom", "{text.from_char(0xFEFF)}a = 1")
    parsed("crlf", "[a]\r\nk = v\r\n")
    parsed("missing separator", "a = 1\nbroken line\n")
    parsed("empty key", "= v")
    parsed("unterminated section", "[a")
    parsed("empty section", "[ ]")
    parsed("text after section", "[a] b")
    parsed("unterminated quote", "k = \"abc")
    parsed("text after quote", "k = \"abc\" tail")
    parsed("unknown escape", "k = \"\\q\"")
    parsed("bad unicode", "k = \"\\u12g4\"")
    parsed("short unicode", "k = \"\\u12\"")
    parsed("surrogate", "k = \"\\ud83d\"")
    parsed("dangling", "k = \"abc\\")
    parsed("continuation at end", "k = a \\")
    parsed("line after continuation", "a = 1\nk = x \\\ny = 2\nz = 3\nbad")
}
