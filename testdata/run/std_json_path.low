import std/json
import std/json/path
import std/text

fn doc(s: str) -> json.Value {
    let quoted = text.replace(s, "'", "\"")
    json.parse(bytes(quoted)) or json.Value.Null
}

fn show(nodes: []path.Node) -> str {
    if nodes.len == 0 {
        return "(none)"
    }
    var parts: []str = []
    for n in nodes {
        push(mut parts, "{n.path}={json.stringify(n.value, 0)}")
    }
    text.join(parts, " ")
}

fn run(v: json.Value, source: str) {
    let p = path.compile(source) catch {
        Syntax(at, message) => {
            print("{source} -> error at {at}: {message}")
            return
        }
    }
    print("{source} -> {show(path.query(v, p))}")
}

fn values(v: json.Value, source: str) {
    let nodes = path.find(v, source) catch {
        Syntax(at, message) => {
            print("{source} -> error at {at}: {message}")
            return
        }
    }
    var parts: []str = []
    for item in path.values(nodes) {
        push(mut parts, json.stringify(item, 0))
    }
    print("{source} -> [{text.join(parts, ", ")}]")
}

fn main() {
    let store = doc("{{'store': {{'book': [{{'category': 'reference', 'author': 'Nigel Rees', 'title': 'Sayings of the Century', 'price': 8.95}}, {{'category': 'fiction', 'author': 'Evelyn Waugh', 'title': 'Sword of Honour', 'price': 12.99}}, {{'category': 'fiction', 'author': 'Herman Melville', 'title': 'Moby Dick', 'isbn': '0-553-21311-3', 'price': 8.99}}, {{'category': 'fiction', 'author': 'J. R. R. Tolkien', 'title': 'The Lord of the Rings', 'isbn': '0-395-19395-8', 'price': 22.99}}], 'bicycle': {{'color': 'red', 'price': 399}}}}}}")
    for source in [
        "$.store.book[*].author", "$..author", "$.store.*", "$.store..price", "$..book[2]", "$..book[2].author",
        "$..book[-1]", "$..book[0,1]", "$..book[:2]", "$..book[?@.isbn]", "$..book[?@.price<10]", "$..*",
        "$.store.book[?@.price > 10].title", "$['store']['bicycle']['color']", "$.store.book.length", "$..book[?@.category == 'reference'].title",
    ] {
        run(store, source)
    }

    let filters = doc("{{'a': [3, 5, 1, 2, 4, 6, {{'b': 'j'}}, {{'b': 'k'}}, {{'b': {{}}}}, {{'b': 'kilo'}}], 'o': {{'p': 1, 'q': 2, 'r': 3, 's': 5, 't': {{'u': 6}}}}, 'e': 'f'}}")
    for source in [
        "$.a[?@.b == 'kilo']", "$.a[?(@.b == 'kilo')]", "$.a[?@>3.5]", "$.a[?@.b]", "$[?@.*]", "$[?@[?@.b]]",
        "$.o[?@<3, ?@<3]", "$.a[?@<2 || @.b == \"k\"]", "$.a[?match(@.b, \"[jk]\")]", "$.a[?search(@.b, \"[jk]\")]",
        "$.o[?@>1 && @<4]", "$.o[?@.u || @.x]", "$.a[?@.b == $.x]", "$.a[?@ == @]", "$.a[?!@.b]", "$.a[?!(@ > 2)]",
        "$.a[?@ >= 5 && !(@ == 6)]", "$.a[?@ != 3 && @ <= 2]", "$.o[?@ > 1 || @ < 0 && @ == 99]", "$.o[?$.e == 'f']",
        "$.a[?@.b == {{}}]",
    ] {
        run(filters, source)
    }

    let letters = doc("['a', 'b', 'c', 'd', 'e', 'f', 'g']")
    for source in [
        "$[1]", "$[-2]", "$[7]", "$[-8]", "$[0]", "$[1:3]", "$[5:]", "$[1:5:2]", "$[5:1:-2]", "$[::-1]", "$[:2]", "$[-3:]", "$[::0]",
        "$[2:1]", "$[::2]", "$[-1:-4:-1]", "$[10:]", "$[:100]", "$[-100:2]", "$[1:3:-1]", "$[3:0:-1]", "$[::]", "$[ 1 : 3 ]", "$[0,2,-1]", "$[1, 1]",
        "$[*]", "$.a", "$[?@ == 'c']",
    ] {
        values(letters, source)
    }

    let names = doc("{{'o': {{'j j': {{'k.k': 3}}}}, '\\u0027': {{'@': 2}}, 'a b': 1, 'é': 5, '_x1': 6}}")
    for source in [
        "$.o['j j']['k.k']", "$.o[\"j j\"][\"k.k\"]", "$[\"'\"][\"@\"]", "$['\\'']['@']", "$['a b']", "$.é", "$._x1", "$.o.*", "$[ 'a b' , '_x1' ]",
        "$['\\u00e9']", "$['\\u00E9']", "$['missing']", "$.o.j j", "$.1", "$.", "$..", "$ .o", "$. o", "$[ 'a b' ]  ",
    ] {
        run(names, source)
    }

    let nested = doc("{{'o': {{'j': 1, 'k': 2}}, 'a': [5, 3, [{{'j': 4}}, {{'k': 6}}]]}}")
    for source in [
        "$.o[*, *]", "$.a[*]", "$.a[*].j", "$.a[*][?@.j]", "$..j", "$..[0]", "$..[*]", "$..*", "$..o", "$.o..[*, *]", "$.a..[0, 1]", "$..j..k", "$..['j','k']",
        "$..[?@.k]", "$..a[2][0]", "$.a[2][1].k",
    ] {
        run(nested, source)
    }

    let empties = doc("{{'a': null, 'b': [null], 'c': [{{}}], 'null': 1}}")
    for source in [
        "$.a", "$.a[0]", "$.a.d", "$.b[0]", "$.b[*]", "$.b[?@]", "$.b[?@==null]", "$.c[?@.d==null]", "$.null", "$.c[?@.d]", "$.c[?!@.d]",
    ] {
        run(empties, source)
    }

    let functions = doc("[{{'authors': ['a', 'b', 'c', 'd', 'e']}}, {{'authors': ['a', 'b']}}, {{'authors': 'xyz'}}, {{'authors': {{'x': 1, 'y': 2, 'z': 3, 'u': 4, 'v': 5}}}}, {{'authors': 7}}]")
    for source in [
        "$[?length(@.authors) >= 5]", "$[?length(@.authors) == 3]", "$[?length(@.authors) == 7]", "$[?length(@.nothing) == 1]", "$[?length(@.nothing) == $.nothing]",
        "$[?count(@.*) == 1]", "$[?count(@.authors.*) > 2]", "$[?count(@..*) >= 5]", "$[?value(@.authors) == 'xyz']", "$[?value(@..x) == 1]", "$[?value(@.authors.*) == 'a']",
        "$[?length('abc') == 3]", "$[?length(\"héé\") == 3]", "$[?length(1) == 1]", "$[?count(@.authors) == 1]", "$[?length(value(@.authors)) == 3]",
        "$[?length(@.authors) == count(@.authors.*)]",
    ] {
        run(functions, source)
    }

    let text_doc = doc("['abc', 'a.c', 'a\\nc', 'ab', 'xabcx', 'ABC', 7, null, 'a\\rc', 'é']")
    for source in [
        "$[?match(@, 'abc')]", "$[?search(@, 'abc')]", "$[?match(@, 'a.c')]", "$[?match(@, 'a\\\\.c')]", "$[?match(@, '[a-c]+')]", "$[?search(@, '^a')]", "$[?match(@, '(')]",
        "$[?search(@, 'b|é')]", "$[?match(@, 7)]", "$[?match(1, 'a')]", "$[?!match(@, 'a.*')]", "$[?match(@, '\\\\w+')]", "$[?match(@, '.')]",
    ] {
        run(text_doc, source)
    }

    let order = doc("{{'a': 1, 'b': {{'a': 2}}, 'c': [{{'a': 3}}]}}")
    for source in ["$..a", "$..*", "$..['a','b']", "$.b.a", "$..[0].a"] {
        run(order, source)
    }

    let tricky = doc("{{'a\\nb': 1, 'q\\u0027': 2, 'back\\\\': 3, 'tab\\t': 4, 'bell\\u0007': 5, 'sol/': 6}}")
    run(tricky, "$.*")

    let numbers = doc("[1, 1.0, 2, 'x', true, false, null, [1], {{'a': 1}}, 1e2, 100]")
    for source in [
        "$[?@ == 1]", "$[?@ == 1.0]", "$[?@ < 2]", "$[?@ == 1e2]", "$[?@ == 100]", "$[?@ > 1.5]", "$[?@ == true]", "$[?@ == false]", "$[?@ == null]", "$[?@ == 'x']", "$[?@ < 'y']", "$[?@ >= 'x']",
        "$[?@ == -0]", "$[?@ == 1.50e+0]", "$[?@[0] == 1]", "$[?@.a == 1]", "$[?@ == [1]]", "$[?@ == $[8]]", "$[?$[6] == null]", "$[?-1 < @ && @ < 3]",
    ] {
        run(numbers, source)
    }

    let any = doc("{{'a': 1}}")
    for source in [
        "a", "", "$[", "$[?", "$[1,", "$['a]", "$[01]", "$[-0]", "$[1:2:3:4]", "$.a b", "$[?@.a ==]", "$[?1]", "$[?true]", "$[?@.* == 1]", "$[?length(@.*) == 1]",
        "$[?match(@.a)]", "$[?count(1) == 1]", "$[?foo(@)]", "$[?@.a=1]", "$[?!@.a == 1]", "$['\\q']", "$[\"\\ud800\"]", "$[\"\\ud83d\\ude00\"]", "$[9007199254740992]",
        "$[9007199254740991]", "$[?length(@)]", "$[?count(@.a)]", "$[?@.a == match(@, 'a')]", "$[?search(@, 'a') == true]", "$[?(@.a]", "$[?@.a)]", "$[]", "$[,]", "$[a]",
        "$[?@.a && ]", "$[?@.a ||]", "$['a'] x", "$[?@ == 01]", "$[?@ == 1.]", "$[?@ == .5]", "$[?@ == 1e]", "$[?@ == nul]", "$[?value(1) == 1]", "$[?length() == 1]", "$[?count(@, @) == 1]",
        "$[?@.a == 'unterminated]", "$[?@..a]", "$[?@..*  == 1]", "$.*.*", "$[?@.a ]", "$[ ?@.a]", "$[?  ! @.b]", "$[?@.a== 1 ]", "$..[?@.a]",
    ] {
        run(any, source)
    }

    let compiled = path.compile("$..price") or return
    print(show(path.query(store, compiled)))
    print(show(path.query(doc("{{'price': 1, 'x': [{{'price': 2}}]}}"), compiled)))
    print(path.paths(path.query(store, compiled)).len)
}
