fn produce(out: chan[i64], first: i64, count: i64, done: chan[bool]) {
    for i in 0..count {
        out <- first + i
    }
    done <- true
}

fn consume(input: chan[i64], sums: chan[i64], counts: chan[i64]) {
    var sum = 0
    var seen = 0
    for v in input {
        sum += v
        seen += 1
    }
    sums <- sum
    counts <- seen
}

fn run(pairs: i64, capacity: i64, per: i64) {
    let jobs = chan[i64](capacity)
    let done = chan[bool]()
    let sums = chan[i64]()
    let counts = chan[i64]()
    for c in 0..pairs {
        spawn consume(jobs, sums, counts)
    }
    for p in 0..pairs {
        spawn produce(jobs, p * per, per, done)
    }
    for p in 0..pairs {
        if !((<-done) ?? false) {
            print("lost producer")
        }
    }
    close(jobs)
    var total = 0
    var count = 0
    for c in 0..pairs {
        total += (<-sums) ?? 0
        count += (<-counts) ?? 0
    }
    let n = pairs * per
    let expected = n * (n - 1) / 2
    print("{pairs} {capacity} {count} {total} {total == expected}")
}

fn main() {
    let sizes = [1, 2, 4, 16, 64]
    let capacities = [0, 1, 16]
    for pairs in sizes {
        for capacity in capacities {
            run(pairs, capacity, 4000)
        }
    }
}
