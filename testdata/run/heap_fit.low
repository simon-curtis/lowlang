import std/io

fn scatter(n: i64) -> [][]u8 {
    var keep: [][]u8 = []
    var holes: [][]u8 = []
    for i in 0..n {
        let hole = io.buffer(65536)
        hole[0] = 1
        push(mut holes, hole)
        let spacer = io.buffer(4096)
        spacer[0] = u8(i % 200 + 1)
        push(mut keep, spacer)
    }
    keep
}

fn churn(n: i64) -> i64 {
    var sum = 0
    for i in 0..n {
        let b = io.buffer(4096)
        b[0] = 1
        sum += i64(b[0])
    }
    sum
}

fn fit(n: i64) -> i64 {
    var blocks: [][]u8 = []
    for i in 0..n {
        let b = io.buffer(61440)
        b[0] = u8(i % 100 + 1)
        b[b.len - 1] = u8(i % 100 + 1)
        push(mut blocks, b)
    }
    var sum = 0
    for i in 0..blocks.len {
        sum += i64(blocks[i][0]) + i64(blocks[i][blocks[i].len - 1])
    }
    sum
}

fn main() {
    let keep = scatter(1000)
    print(churn(60000))
    print(fit(1000))
    var sum = 0
    for i in 0..keep.len {
        sum += i64(keep[i][0])
    }
    print(sum)
}
