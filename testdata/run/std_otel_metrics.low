import std/otel

fn ignored() -> otel.MetricExporter {
    otel.MetricExporter { export: fn(batch) -> bool { true }, shutdown: fn() {} }
}

fn dump(label: str, batch: otel.MetricBatch) {
    print("-- {label}")
    for m in batch.metrics {
        for line in otel.format_metric(m) {
            print(line)
        }
    }
}

fn find(batch: otel.MetricBatch, name: str) -> otel.MetricData? {
    for m in batch.metrics {
        if m.name == name {
            return m
        }
    }
    none
}

fn record_round(requests: otel.Measure[i64], active: otel.Measure[i64], latency: otel.Measure[f64], temperature: otel.Measure[f64], scale: i64) {
    let get = [otel.string("method", "GET")]
    let post = [otel.string("method", "POST")]
    requests.add(2 * scale, get)
    requests.add(scale, [otel.string("method", "POST")])
    requests.add(-5, get)
    active.add(3 * scale, [])
    active.add(-scale, [])
    latency.record(0.004, get)
    latency.record(0.3, get)
    latency.record(f64(scale) * 4.0, get)
    latency.record(20.0, post)
    temperature.record(20.5 + f64(scale), [])
}

fn main() {
    let before = otel.counter[i64](otel.meter("early"), "unused", "1", "")
    before.add(1, [])
    print("measure before install enabled {before.enabled_measure()}")
    using sdk = otel.install(otel.Config {
        metric_readers: [
            otel.MetricReader { exporter: ignored(), interval: 0 },
            otel.MetricReader { exporter: ignored(), interval: 0, preference: PreferDelta },
            otel.MetricReader { exporter: ignored(), interval: 0, preference: LowMemory },
        ]
    })
    let m = otel.meter("fixture")
    let requests = otel.counter[i64](m, "requests", "{{request}}", "Requests served")
    let again = otel.counter[i64](m, "requests", "{{request}}", "Requests served")
    let active = otel.up_down_counter[i64](m, "active", "{{connection}}", "")
    let latency = otel.histogram[f64](m, "latency", "s", "", otel.duration_bounds())
    let temperature = otel.gauge[f64](m, "temperature", "Cel", "")
    let sized = otel.histogram[i64](m, "size", "By", "", [])
    let ticks = new(0)
    otel.observable_counter(m, "cpu.ticks", "1", "", fn() -> []otel.Observation[i64] {
        [otel.Observation { value: *ticks, attributes: [otel.string("cpu", "0")] }]
    })
    otel.observable_up_down_counter(m, "queue.depth", "1", "", fn() -> []otel.Observation[f64] {
        [otel.Observation { value: 7.5 - f64(*ticks) / 100.0 }]
    })
    otel.observable_gauge(m, "load", "1", "", fn() -> []otel.Observation[f64] {
        [otel.Observation { value: 0.25, attributes: [otel.string("host", "a")] }, otel.Observation { value: 0.75, attributes: [otel.string("host", "b")] }]
    })
    again.add(1, [otel.string("method", "GET")])
    sized.record(7, [])
    sized.record(5000, [])
    record_round(requests, active, latency, temperature, 1)
    *ticks = 100
    let c1 = otel.collect(sdk, 0)
    dump("cumulative 1", c1)
    let d1 = otel.collect(sdk, 1)
    dump("delta 1", d1)
    let l1 = otel.collect(sdk, 2)
    dump("low memory 1", l1)
    record_round(requests, active, latency, temperature, 10)
    *ticks = 350
    let c2 = otel.collect(sdk, 0)
    dump("cumulative 2", c2)
    let d2 = otel.collect(sdk, 1)
    dump("delta 2", d2)
    let d3 = otel.collect(sdk, 1)
    dump("delta 3 idle", d3)
    match find(c1, "requests") {
        some(a) => match find(c2, "requests") {
            some(b) => print("cumulative start kept {a.points[0].start == b.points[0].start} time advanced {b.points[0].time >= a.points[0].time}")
            none => {}
        }
        none => {}
    }
    match find(d1, "requests") {
        some(a) => match find(d2, "requests") {
            some(b) => print("delta start equals the last collection time {b.points[0].start == a.points[0].time}")
            none => {}
        }
        none => {}
    }
    for i in 0..2100 {
        requests.add(1, [otel.int("id", i)])
    }
    match find(otel.collect(sdk, 0), "requests") {
        some(r) => {
            var overflow = 0
            for p in r.points {
                match otel.lookup(p.attributes, "otel.metric.overflow") {
                    some(_) => {
                        overflow = p.int_value
                    }
                    none => {}
                }
            }
            print("cardinality points {r.points.len} overflow {overflow}")
        }
        none => {}
    }
    sdk.shutdown()
}
