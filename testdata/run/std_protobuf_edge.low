import std/protobuf
import std/text

struct Wide {
    fifteen: i32 "15"
    sixteen: i32 "16"
    big: i64 "536870911"
}

struct Node {
    child: *Node? "1"
    value: i32 "2"
}

struct Req {
    id: i32 "1,required"
    name: str? "2"
    flag: bool "3,required"
}

struct Defaults {
    id: i32 "1"
    label: str "2" = "unset"
    scale: f64 "3" = 1.5
}

enum Level {
    Low = 0
    High = 1
}

struct Levels {
    level: Level "1"
    all: Level[] "2"
    by_name: [str: Level] "3"
}

fn hex(data: u8[]) -> str {
    text.encode_hex(data)
}

fn bytes_of(s: str) -> u8[] {
    text.decode_hex(s) or panic("bad vector")
}

fn chain(depth: i64) -> u8[] {
    var data: u8[] = []
    for _ in 0..depth {
        var next: u8[] = [0x0a]
        push_varint(mut next, data.len)
        for b in data {
            next.push(b)
        }
        data = next
    }
    data
}

fn push_varint(mut out: u8[], n: i64) {
    var rest = n
    for rest >= 0x80 {
        out.push(u8(rest & 0x7F | 0x80))
        rest = rest >> 7
    }
    out.push(u8(rest))
}

fn depth_of(data: u8[]) -> i64 {
    let n = protobuf.deserialize[Node](data) catch {
        e => {
            print("depth failure {e}")
            return -1
        }
    }
    var count = 1
    var current = n
    for {
        let next = current.child ?? break
        count += 1
        current = *next
    }
    count
}

fn main() {
    more()
    let wide = Wide { fifteen: 9, sixteen: 7, big: 5 }
    print(hex(protobuf.serialize(wide)))
    let wide_back = protobuf.deserialize[Wide](bytes_of("7809800107f8ffffff0f05")) or panic("wide")
    print("{wide_back.fifteen} {wide_back.sixteen} {wide_back.big}")

    let leaf = Node { child: none, value: 3 }
    let middle = Node { child: new(leaf), value: 2 }
    let top = Node { child: new(middle), value: 1 }
    print(hex(protobuf.serialize(top)))
    let chain_back = protobuf.deserialize[Node](bytes_of("0a060a02100310021001")) or panic("chain")
    print("chain depth {depth_of(protobuf.serialize(chain_back))}")

    print(hex(protobuf.serialize(Req { id: 0, name: none, flag: false })))
    print(hex(protobuf.serialize(Req { id: 5, name: "n", flag: true })))
    print(hex(protobuf.serialize(Req { id: 5, name: "", flag: true })))
    let req = protobuf.deserialize[Req](bytes_of("080512001801")) or panic("req")
    print("req name {req.name ?? "none"} flag {req.flag}")
    let absent = protobuf.deserialize[Req](bytes_of("0805")) catch {
        e => {
            print("required: {e}")
            return
        }
    }
    print(absent.id)
}

fn more() {
    let defaults = protobuf.deserialize[Defaults](bytes_of("0803")) or panic("defaults")
    print("defaults {defaults.id} {defaults.label} {defaults.scale}")
    print(hex(protobuf.serialize(Defaults { id: 0, label: "", scale: 0.0 })))

    let levels = protobuf.deserialize[Levels](bytes_of("0801120200011a050a01611001")) or panic("levels")
    print("levels {levels.level} {levels.all} {levels.by_name.len}")

    print("depth 100 {depth_of(chain(99))}")
    print("depth 101 {depth_of(chain(100))}")

    let missing = protobuf.deserialize[Node](bytes_of("")) or panic("empty node")
    print("empty node {missing.value}")

    let wrong = protobuf.deserialize[i64](bytes_of("")) catch {
        e => {
            print("non struct: {e}")
            return
        }
    }
    print(wrong)
}
