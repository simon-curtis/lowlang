import std/conv
import std/strings

fn parsed(s: str) -> str {
    let n = conv.parse_int(s) catch {
        Empty => return "empty"
        Invalid(at) => return "invalid at {at}"
        Overflow => return "overflow"
    }
    "{n}"
}

fn main() {
    print(strings.split("a,b,,c", ",") |> strings.join("|"))
    print(strings.split("héllo", "") |> strings.join("."))
    print("[{strings.trim("  hi there \n")}]")
    print(strings.index("hello", "ll") ?? -1)
    print(strings.last_index("abcabc", "bc") ?? -1)
    print(strings.index("hello", "z") ?? -1)
    print(strings.contains("hello", "ell"))
    print(strings.has_prefix("hello", "he") && strings.has_suffix("hello", "lo"))
    print(strings.trim_prefix("v1.2", "v"))
    print(strings.replace("a-b-c", "-", "+"))
    print(strings.to_upper("héllo") |> strings.to_lower())
    print(strings.fields("  one two\tthree  ") |> strings.join(","))
    print(strings.lines("a\r\nb\nc\n") |> strings.join(","))
    print(strings.repeat("ab", 3))
    print(strings.count("cheese", "e"))
    print(strings.char_count("héllo"))
    print(strings.pad_left("7", 3, '0'))
    print(strings.pad_right("ab", 4, '.'))
    print(strings.from_char(0x1F600))

    var b = strings.Builder {}
    b.write("x = ")
    b.write_char('λ')
    b.write_byte('!')
    print("{b.build()} {b.length()}")

    print("apple" < "banana")
    print("b" > "abc")

    for s in ["42", "-9223372036854775808", "9223372036854775808", "12a", "", "-"] {
        print(parsed(s))
    }
    print(conv.parse_radix("ff", 16) catch { _ => -1 })
    print(conv.parse_bool("true") catch { _ => false })
    print(conv.hex(255))
    print(conv.radix(-10, 2))
    print(conv.radix(-9223372036854775807 - 1, 10))
}
