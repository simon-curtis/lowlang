import std/html
import std/text

struct Shape {
    name: str
    input: str
}

struct Stats {
    elements: i64
    texts: i64
    depth: i64
}

fn shapes() -> Shape[] {
    [
        Shape { name: "a div 3000", input: text.repeat("<div>", 3000) }
        Shape { name: "a div 600", input: text.repeat("<div>", 600) }
        Shape { name: "a div 512", input: text.repeat("<div>", 512) }
        Shape { name: "a div 513", input: text.repeat("<div>", 513) }
        Shape { name: "b b div end b 3000", input: "<b>{text.repeat("<div>", 3000)}{text.repeat("</b>", 3000)}" }
        Shape { name: "c a div 1500", input: text.repeat("<a><div>", 1500) }
        Shape { name: "d table 1000", input: text.repeat("<table><tr><td>", 1000) }
        Shape { name: "e svg 3000", input: text.repeat("<svg>", 3000) }
        Shape { name: "e template 3000", input: text.repeat("<template>", 3000) }
        Shape { name: "b b p 1500", input: "{text.repeat("<b>", 1500)}{text.repeat("<p>x", 1500)}" }
        Shape { name: "i span 1500 end z", input: "{text.repeat("<span>", 1500)}{text.repeat("</z>", 1500)}" }
        Shape { name: "text after 600 div", input: "{text.repeat("<div>", 600)}text<!--c-->" }
    ]
}

fn measure(root: *html.Node) -> Stats {
    var stats = Stats { elements: 0, texts: 0, depth: 0 }
    var pending: *html.Node[] = []
    var levels: i64[] = []
    for c in html.children(root) {
        pending.push(c)
        levels.push(1)
    }
    for pending.len > 0 {
        let n = pending[pending.len - 1]
        let level = levels[levels.len - 1]
        let _ = pending.pop()
        let _ = levels.pop()
        if level > stats.depth {
            stats.depth = level
        }
        match n.data {
            Element => { stats.elements += 1 }
            Text => { stats.texts += 1 }
            _ => {}
        }
        for c in html.children(n) {
            pending.push(c)
            levels.push(level + 1)
        }
        let contents = html.template_contents(n) ?? continue
        for c in html.children(contents) {
            pending.push(c)
            levels.push(level + 1)
        }
    }
    stats
}

fn show(stats: Stats) -> str {
    "elements={stats.elements} texts={stats.texts} depth={stats.depth}"
}

fn context() -> *html.Node {
    html.create_element(html.Namespace.Html, "body", [])
}

fn main() {
    print("default limit: {html.default_max_depth} {html.default_options().max_depth}")
    for shape in shapes() {
        let limited = html.parse_body(shape.input)
        let ten = html.parse_fragment_with(context(), shape.input, html.ParseOptions { max_depth: 10 })
        let unlimited = html.parse_fragment_with(context(), shape.input, html.ParseOptions { max_depth: 0 })
        print("{shape.name}")
        print("  default:   {show(measure(limited.root))}")
        print("  max 10:    {show(measure(ten.root))}")
        print("  unlimited: {show(measure(unlimited.root))}")
    }

    let nested = text.repeat("<div>", 20)
    let tree = html.parse_with(nested, html.ParseOptions { max_depth: 4 })
    print("document, max 4: {show(measure(tree.root))}")
    print("serialized: {html.inner_html(html.parse_body(text.repeat("<p>", 3)).root)}")
}
