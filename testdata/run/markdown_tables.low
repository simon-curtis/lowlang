import std/markdown

fn show(title: str, source: str) {
    print("--- {title}")
    print(markdown.to_html(source))
}

fn main() {
    show("alignment", "| L | C | R | D |\n|:--|:-:|--:|---|\n| a | b | c | d |\n| e | f | g | h |\n")
    show("escaped pipes", "| a | b |\n|---|---|\n| x \\| y | `p \\| q` |\n")
    show("code with pipe", "| code | text |\n|---|---|\n| `a|b` | c |\n")
    show("inline content", "| *em* | [l](/u) |\n|---|---|\n| **b** | ~~s~~ |\n")
    show("short and long rows", "| a | b |\n|---|---|\n| only |\n| 1 | 2 | 3 |\n")
    show("no outer pipes", "a | b\n--|--\n1 | 2\n")
    show("table ends at blank", "| a |\n|---|\n| 1 |\n\nparagraph\n")
    show("table ends at quote", "| a |\n|---|\n| 1 |\n> quote\n")
    show("not a table", "| a | b |\n|---|\n| 1 | 2 |\n")

    let doc = markdown.parse("| h1 | h2 |\n|:--|--:|\n| *a* | b |\n")
    for block in doc {
        match block {
            Table(table) => {
                for cell in table.header {
                    print("header {cell.raw} {markdown.plain_text(cell.content)}")
                }
                for row in table.rows {
                    for cell in row {
                        print("cell {cell.raw} {markdown.plain_text(cell.content)}")
                    }
                }
            }
            _ => {}
        }
    }
}
