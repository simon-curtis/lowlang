import std/term
import std/text
import std/text/table
import std/unicode

fn prices() -> table.Table {
    var t = table.Table { header: ["Item", "Qty", "Price"] }
    table.add_row(mut t, ["apple", "3", "1.25"])
    table.add_row(mut t, ["watermelon", "12", "10.5"])
    table.add_row(mut t, ["fig", "100", "0.3"])
    t
}

fn show(name: str, t: table.Table) {
    print("== {name}")
    print(table.render(t))
}

fn aligned(t: table.Table, a: table.Align, b: table.Align, c: table.Align) -> table.Table {
    var out = t
    table.set_align(mut out, 0, a)
    table.set_align(mut out, 1, b)
    table.set_align(mut out, 2, c)
    out
}

fn bordered(t: table.Table, b: table.Border) -> table.Table {
    var out = t
    out.border = b
    out
}

fn basic() {
    let base = aligned(prices(), Left, Right, Right)
    show("ascii", base)
    show("unicode centre", bordered(aligned(prices(), Center, Center, Right), Unicode))
    show("none", bordered(base, None))
    var wide = bordered(base, None)
    wide.padding = 2
    show("none padding 2", wide)
    var tight = bordered(base, Unicode)
    tight.padding = 0
    show("unicode padding 0", tight)
    var loose = bordered(base, Ascii)
    loose.padding = 3
    show("ascii padding 3", loose)
}

fn markdown_and_tabs() {
    var t = table.Table { header: ["Name", "Count", "Note"], border: Markdown }
    table.add_row(mut t, ["a|b", "1", "two\nlines"])
    table.add_row(mut t, ["back\\slash", "22", "x"])
    table.add_row(mut t, ["", "333", ""])
    table.set_align(mut t, 1, Right)
    table.set_align(mut t, 2, Center)
    show("markdown", t)
    var bare = table.Table { border: Markdown }
    table.add_row(mut bare, ["k", "v"])
    show("markdown without header", bare)
    var tsv = table.Table { header: ["a", "b"], border: Tabs }
    table.add_row(mut tsv, ["x\ty", "line\nbreak"])
    table.add_row(mut tsv, ["back\\slash"])
    show("tsv", tsv)
}

fn wide_text() {
    var t = table.Table { header: ["Kind", "Sample"], border: Unicode }
    table.add_row(mut t, ["ascii", "abc"])
    table.add_row(mut t, ["cjk", "日本語"])
    table.add_row(mut t, ["hangul", "한국어"])
    table.add_row(mut t, ["fullwidth", "ＡＢ"])
    table.add_row(mut t, ["emoji", "😀😀"])
    table.add_row(mut t, ["combining", "éà"])
    table.add_row(mut t, ["tone", "👍🏽"])
    table.add_row(mut t, ["family", "👨‍👩‍👧"])
    table.add_row(mut t, ["flag", "🇯🇵"])
    table.add_row(mut t, ["mixed", "a日é😀"])
    show("wide", t)
    for s in ["abc", "日本語", "é", "😀", "👍🏽", "👨‍👩‍👧", "🇯🇵", "한", "ＡＢ", ""] {
        print("{table.width(s)}")
    }
}

fn limited(ellipsis: str, code_limit: i64) -> table.Table {
    var t = table.Table { header: ["Name", "Description", "Code"], border: Ascii, ellipsis }
    table.add_row(mut t, ["alphabetical", "a fairly long description", "x"])
    table.add_row(mut t, ["short", "tiny", "yy"])
    table.add_row(mut t, ["日本語日本語日本語", "日本語日本語日本語", "zzz"])
    table.set_limits(mut t, 0, 0, 8)
    table.set_limits(mut t, 1, 0, 9)
    table.set_limits(mut t, 2, 0, code_limit)
    t
}

fn limits() {
    show("truncate", limited("...", 2))
    show("truncate unicode ellipsis", limited("…", 1))
    show("ellipsis wider than column", limited("...", 1))
    var minimum = prices()
    table.set_limits(mut minimum, 1, 9, 0)
    table.set_align(mut minimum, 1, Center)
    show("min width", minimum)
    var clamp = prices()
    table.set_limits(mut clamp, 0, 12, 4)
    show("min wins over max", clamp)
}

fn wrap_table(b: table.Border, a: table.Align) -> table.Table {
    var t = table.Table { header: ["Text", "N"], border: b, wrap: true }
    table.add_row(mut t, ["the quick brown fox jumps over the lazy dog", "1"])
    table.add_row(mut t, ["supercalifragilisticexpialidocious", "2"])
    table.add_row(mut t, ["short", "3"])
    table.add_row(mut t, ["日本語日本語日本語日本語 日本語", "4"])
    table.set_limits(mut t, 0, 0, 12)
    table.set_align(mut t, 0, a)
    t
}

fn wrapping() {
    show("wrap", wrap_table(Ascii, Left))
    show("wrap centred", wrap_table(Unicode, Center))
    show("wrap right", wrap_table(None, Right))
    show("wrap markdown", wrap_table(Markdown, Left))
    var lines = table.Table { border: Ascii, wrap: true }
    table.add_row(mut lines, ["first line\nsecond line is longer than the limit", "x"])
    table.set_limits(mut lines, 0, 0, 10)
    show("wrap multi-line cell", lines)
}

fn shapes() {
    var plain = table.Table { border: Ascii }
    table.add_row(mut plain, ["a", "bb"])
    table.add_row(mut plain, ["ccc", "d"])
    show("no header", plain)
    let head_only = table.Table { header: ["x", "y"], border: Unicode }
    show("header only", head_only)
    var ragged = table.Table { header: ["a"], border: Ascii }
    table.add_row(mut ragged, ["1", "2", "3"])
    table.add_row(mut ragged, [])
    table.add_row(mut ragged, ["4"])
    show("ragged", ragged)
    let empty = table.Table {}
    print("[{table.render(empty)}]")
    var lines = table.Table { header: ["k", "v"], border: Unicode }
    table.add_row(mut lines, ["one", "a\nbb\nccc"])
    table.add_row(mut lines, ["two\nlines", "b"])
    show("multi-line", lines)
    var tabs = table.Table { header: ["k"], border: Ascii }
    table.add_row(mut tabs, ["a\tb"])
    show("tab expands", tabs)
}

fn visible(s: str) -> str {
    text.replace(s, text.from_char(27), "^")
}

fn styled() {
    let bold = term.bold("bold")
    let red = term.fg(term.Colour.Red, "red")
    print("{table.width(bold)} {table.width(red)} {term.visible_width(bold)} {unicode.text_width(term.strip(red))}")
    var t = table.Table { header: ["Style", "Text"], border: Unicode }
    table.add_row(mut t, ["bold", bold])
    table.add_row(mut t, ["red", red])
    table.add_row(mut t, ["plain", "plain"])
    var bare = table.Table { header: ["Style", "Text"], border: Unicode }
    table.add_row(mut bare, ["bold", "bold"])
    table.add_row(mut bare, ["red", "red"])
    table.add_row(mut bare, ["plain", "plain"])
    print(term.strip(table.render(t)) == table.render(bare))
    var cut = table.Table { border: Ascii }
    table.add_row(mut cut, [term.bold("hello world")])
    table.set_limits(mut cut, 0, 0, 6)
    let rendered = table.render(cut)
    print(term.strip(rendered))
    print(rendered.len - term.strip(rendered).len)
    var folded = table.Table { border: None, wrap: true }
    let green = term.fg(term.Colour.Green, "one two three four")
    table.add_row(mut folded, [green, "x"])
    table.set_limits(mut folded, 0, 0, 9)
    print(visible(table.render(folded)))
    var mixed = table.Table { border: None, wrap: true }
    let switched = "{term.bold("bold")} {term.fg(term.Colour.Red, "red words")} plain words here"
    table.add_row(mut mixed, [switched])
    table.set_limits(mut mixed, 0, 0, 10)
    print(visible(table.render(mixed)))
}

fn tabwriter() {
    print(table.align([["a", "bb", "c"], ["aaa", "b", "ccc"], ["x"], ["y", "z"]], 2))
    print("--")
    print(table.align([["name", "size", "path"], ["a", "1", "/x"], ["longer name", "22", "/y/z"], ["b", "333", "/"]], 1))
    print("--")
    print(table.align([["a", "b", ""], ["aa", "", "c"], ["", "x", "y"]], 2))
    print("--")
    print(table.align([["key", "value"], ["a"], ["bbbb", "c"], ["dd", "ee"], ["f"], ["g", "h"]], 3))
    print("--")
    print(table.align([["x", "y", "z"], ["x"], ["xx", "yy", "zz"], ["xxx", "y"]], 0))
    print("--")
    print(table.align_tabbed("alpha\t1\tfoo\nbeta\t22\tbar baz\ngamma\t333\t\nlast\n", 2))
    print("--")
    print(table.align([["日本", "x"], ["a", "y"]], 1))
    let empty: [][]str = []
    print("[{table.align(empty, 2)}]")
}

struct Lcg {
    state: u64
}

fn next(mut g: Lcg, bound: i64) -> i64 {
    g.state = g.state * 6364136223846793005 + 1442695040888963407
    i64(g.state >> 33) % bound
}

fn random_cell(mut g: Lcg) -> str {
    let words = ["a", "bb", "ccc", "日本", "語", "é", "éx", "😀", "longer-word", "x", "supercalifragilistic"]
    var parts: []str = []
    for i in 0..1 + next(mut g, 4) {
        push(mut parts, words[next(mut g, words.len)])
    }
    text.join(parts, " ")
}

fn checksum(s: str) -> u64 {
    var h: u64 = 0
    for i in 0..s.len {
        h = h * 131 + u64(s[i])
    }
    h
}

fn generated_table(wrap: bool, border: table.Border) -> str {
    var g = Lcg { state: 4242 }
    var t = table.Table { header: ["id", "name", "tags", "note"], border, wrap }
    for i in 0..60 {
        table.add_row(mut t, ["{i}", random_cell(mut g), random_cell(mut g), random_cell(mut g)])
    }
    table.set_limits(mut t, 1, 0, 10)
    table.set_limits(mut t, 2, 4, 6)
    table.set_limits(mut t, 3, 0, 14)
    table.set_align(mut t, 0, Right)
    table.set_align(mut t, 2, Center)
    table.render(t)
}

fn generated() {
    for border in [table.Border.Unicode, table.Border.None, table.Border.Markdown] {
        for wrap in [false, true] {
            let out = generated_table(wrap, border)
            let rows = text.lines(out)
            print("wrap {wrap} lines {rows.len} checksum {checksum(out)}")
        }
    }
}

fn main() {
    basic()
    markdown_and_tabs()
    wide_text()
    limits()
    wrapping()
    shapes()
    styled()
    tabwriter()
    generated()
}
