import std/io

fn fresh(len: i64) -> []u8 {
    var b: []u8 = []
    for i in 0..len {
        push(mut b, u8(i % 251))
    }
    b
}

fn main() {
    var bad = 0
    for n in 0..200 {
        for d in 0..20 {
            for s in 0..20 {
                let buf = fresh(n + 40)
                let want = fresh(n + 40)
                var tmp: []u8 = []
                for i in 0..n {
                    push(mut tmp, want[s + i])
                }
                for i in 0..n {
                    want[d + i] = tmp[i]
                }
                let moved = io.copy(buf[d..d + n], buf[s..s + n])
                if moved != n {
                    bad += 1
                }
                for i in 0..buf.len {
                    if buf[i] != want[i] {
                        bad += 1
                    }
                }
            }
        }
    }
    print(bad)
}
