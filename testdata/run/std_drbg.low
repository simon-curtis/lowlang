}

fn pattern(start: i64, n: i64) -> u8[] {
    var out: u8[] = []
    for i in 0..n {
        out.push(u8(start + i))
    }
    out
}

fn named(e: drbg.Error) -> str {
    match e {
        InvalidEntropy => "InvalidEntropy"
        InvalidNonce => "InvalidNonce"
        InputTooLong => "InputTooLong"
        InvalidLength => "InvalidLength"
        RequestTooLarge => "RequestTooLarge"
        ReseedRequired => "ReseedRequired"
        Uninstantiated => "Uninstantiated"
    }
}

fn try_generate(label: str, d: *drbg.CtrDrbg, n: i64) {
    let out = drbg.generate(d, n, []) catch {
        e => {
            print("{label}: {named(e)}")
            return
        }
    }
    print("{label}: {out.len} bytes")
}

fn try_generate_with(label: str, d: *drbg.CtrDrbg, additional: u8[]) {
    let out = drbg.generate(d, 16, additional) catch {
        e => {
            print("{label}: {named(e)}")
            return
        }
    }
    print("{label}: {out.len} bytes")
}

fn try_instantiate(label: str, entropy: u8[], nonce: u8[]) {
    let _ = drbg.instantiate(entropy, nonce, []) catch {
        e => {
            print("{label}: {named(e)}")
            return
        }
    }
    print("{label}: accepted")
}

fn try_without_df(label: str, entropy: u8[], personalization: u8[]) {
    drbg.instantiate_without_df(entropy, personalization) catch {
        e => {
            print("{label}: {named(e)}")
            return
        }
    }
    print("{label}: instantiated")
}

fn without_df_errors() ! drbg.Error {
    let none: u8[] = []
    try_without_df("without df, 47-byte entropy", pattern(1, 47), none)
    try_without_df("without df, 49-byte entropy", pattern(1, 49), none)
    try_without_df("without df, 49-byte personalization", pattern(1, 48), pattern(1, 49))
    try_without_df("without df, 48-byte entropy and personalization", pattern(1, 48), pattern(1, 48))
    let d = drbg.instantiate_without_df(pattern(1, 48), none)?
    try_generate_with("without df, generate with 49-byte additional input", d, pattern(1, 49))
    drbg.reseed(d, pattern(1, 32), none) catch {
        e => print("without df, reseed with 32-byte entropy: {named(e)}")
    }
    drbg.reseed(d, pattern(1, 48), pattern(1, 49)) catch {
        e => print("without df, reseed with 49-byte additional input: {named(e)}")
    }
    drbg.reseed(d, pattern(1, 48), pattern(1, 48))?
    print("without df, reseed with 48-byte entropy and additional input: ok")
}

fn errors() ! drbg.Error {
    let entropy = pattern(1, 32)
    let nonce = pattern(100, 16)
    let none: u8[] = []
    try_instantiate("31-byte entropy", pattern(1, 31), nonce)
    try_instantiate("15-byte nonce", entropy, pattern(100, 15))
    try_instantiate("32-byte entropy and 16-byte nonce", entropy, nonce)
    let d = drbg.instantiate(entropy, nonce, none)?
    try_generate("generate 0", d, 0)
    try_generate("generate 65536", d, 65536)
    try_generate("generate 65537", d, 65537)
    try_generate("generate -1", d, -1)
    drbg.reseed(d, pattern(1, 31), none) catch {
        e => print("reseed 31-byte entropy: {named(e)}")
    }
    drbg.reseed(d, pattern(1, 32), none)?
    let same_a = drbg.instantiate(entropy, nonce, bytes("device"))?
    let same_b = drbg.instantiate(entropy, nonce, bytes("device"))?
    let other = drbg.instantiate(entropy, nonce, bytes("devicf"))?
    let a = drbg.generate(same_a, 48, none)?
    let b = drbg.generate(same_b, 48, none)?
    let c = drbg.generate(other, 48, none)?
    print("same inputs same output: {text.encode_hex(a) == text.encode_hex(b)}")
    print("other personalization other output: {text.encode_hex(a) != text.encode_hex(c)}")
    let next = drbg.generate(same_a, 48, none)?
    print("next output differs: {text.encode_hex(a) != text.encode_hex(next)}")
    without_df_errors()?
    drbg.uninstantiate(d)
    try_generate("generate after uninstantiate", d, 16)
    drbg.reseed(d, entropy, none) catch {
        e => print("reseed after uninstantiate: {named(e)}")
    }
}

fn main() {
    var matched = 0
    var total = 0
    for v in vectors() {
        total += 1
        let out = run(v) catch {
            e => {
                print("{v.label}: {named(e)}")
                continue
            }
        }
        if matches(v, out) {
            matched += 1
            print("{v.label}: match")
        } else {
            print("{v.label}: MISMATCH")
        }
    }
    print("{matched} of {total} match")
    errors() catch {
        e => print("failed: {named(e)}")
    }
}
