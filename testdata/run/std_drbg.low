import std/crypto/drbg
import std/crypto/hash
import std/text

struct Vector {
    label: str
    mode: str
    df: bool = true
    entropy: str = ""
    nonce: str = ""
    personalization: str = ""
    reseed1_entropy: str = ""
    reseed1_additional: str = ""
    additional1: str = ""
    reseed2_entropy: str = ""
    reseed2_additional: str = ""
    additional2: str = ""
    returned: str
    sha256: bool = false
    first: i64
    last: i64
}

fn hex(s: str) -> u8[] {
    text.decode_hex(s) or []
}

fn instantiated(v: Vector) -> *drbg.CtrDrbg ! drbg.Error {
    if v.df {
        return drbg.instantiate(hex(v.entropy), hex(v.nonce), hex(v.personalization))
    }
    drbg.instantiate_without_df(hex(v.entropy), hex(v.personalization))
}

fn run(v: Vector) -> u8[] ! drbg.Error {
    let d = instantiated(v)?
    if v.mode == "reseed" {
        drbg.reseed(d, hex(v.reseed1_entropy), hex(v.reseed1_additional))?
        let _ = drbg.generate(d, v.first, hex(v.additional1))?
        return drbg.generate(d, v.last, hex(v.additional2))
    }
    if v.mode == "pr" {
        drbg.reseed(d, hex(v.reseed1_entropy), hex(v.reseed1_additional))?
        let _ = drbg.generate(d, v.first, [])?
        drbg.reseed(d, hex(v.reseed2_entropy), hex(v.reseed2_additional))?
        return drbg.generate(d, v.last, [])
    }
    let _ = drbg.generate(d, v.first, hex(v.additional1))?
    drbg.generate(d, v.last, hex(v.additional2))
}

fn matches(v: Vector, out: u8[]) -> bool {
    if v.sha256 {
        return text.encode_hex(hash.sum(hash.sha256(), out)) == v.returned
    }
    text.encode_hex(out) == v.returned
}

