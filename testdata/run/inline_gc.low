struct Node {
    next: *Node?
    value: i64
}

struct Box {
    items: []i64
    label: str
}

fn value_of(n: *Node) -> i64 {
    n.value
}

fn link(head: *Node?, value: i64) -> *Node {
    new(Node { next: head, value: value })
}

fn next_of(n: *Node) -> *Node? {
    n.next
}

fn pick(a: *Node, b: *Node, flag: bool) -> *Node {
    if flag { a } else { b }
}

fn items_of(b: Box) -> []i64 {
    b.items
}

fn name_of(b: Box) -> str {
    b.label
}

fn churn(rounds: i64) -> i64 {
    var junk = 0
    for i in 0..rounds {
        let scratch = new(Node { next: none, value: i })
        junk += scratch.value % 3
        var filler: []i64 = []
        for k in 0..40 {
            push(mut filler, k + i)
        }
        junk += filler.len
    }
    junk
}

fn hold_through_allocation(rounds: i64) -> i64 {
    var head: *Node? = none
    for i in 0..rounds {
        head = some(link(head, i))
        let probe = link(none, i * 2)
        let chosen = pick(probe, link(none, i * 3), i % 2 == 0)
        junk_sink(churn(30))
        if value_of(chosen) < 0 {
            return -1
        }
    }
    var total = 0
    var cur = head
    for {
        match cur {
            some(n) => {
                total += value_of(n)
                cur = next_of(n)
            }
            none => break
        }
    }
    total
}

fn junk_sink(n: i64) {
    if n < 0 {
        print(n)
    }
}

fn boxes(rounds: i64) -> i64 {
    var total = 0
    for i in 0..rounds {
        var items: []i64 = []
        for k in 0..20 {
            push(mut items, k * i)
        }
        let b = Box { items: items, label: "box{i}" }
        total += churn(5)
        let held = items_of(b)
        let text = name_of(b)
        total += churn(5)
        total += held[19] + text.len
    }
    total
}

fn main() {
    print(hold_through_allocation(3000))
    print(boxes(2000))
    print(churn(20000))
}
