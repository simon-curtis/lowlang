struct Entry {
    name: str
    code: i64
}

enum Level {
    Low
    High
}

fn status(code: i64) -> str {
    let known: [i64: str] = [
        200: "OK", 201: "Created", 204: "No Content", 301: "Moved", 302: "Found",
        400: "Bad Request", 404: "Not Found", 500: "Internal Server Error",
    ]
    known[code] ?? "unknown"
}

fn count_known() -> i64 {
    let known: [i64: str] = [200: "OK", 404: "Not Found", 500: "Error", 503: "Unavailable"]
    var n = 0
    for code, text in known {
        n += code + text.len
    }
    n + known.len
}

fn fresh_map() -> [str: i64] {
    let m: [str: i64] = ["a": 1, "b": 2, "c": 3, "d": 4, "e": 5]
    m
}

fn mutate(mut m: [str: i64]) {
    m["a"] = 100
    m["z"] = 26
    delete(mut m, "b")
}

fn poke_local() -> i64 {
    let m: [str: i64] = ["a": 1, "b": 2, "c": 3, "d": 4]
    m["a"] += 10
    m["a"] ?? 0
}

fn small() -> [i64: i64] {
    let m: [i64: i64] = [1: 10, 2: 20]
    m[3] = 30
    m
}

fn names(i: i64) -> str {
    let xs = ["alpha", "beta", "gamma", "delta"]
    xs[i % xs.len]
}

fn total_names() -> i64 {
    var n = 0
    for s in ["one", "three", "five"] {
        n += s.len
    }
    n
}

fn first_entry(i: i64) -> str {
    let es = [Entry { name: "x", code: 1 }, Entry { name: "yy", code: 2 }, Entry { name: "zzz", code: 3 }]
    "{es[i].name}{es[i].code}"
}

fn levels(i: i64) -> i64 {
    let ls = [Level.Low, Level.High, Level.High]
    if ls[i] == Level.High { 1 } else { 0 }
}

fn halves() -> []f64 {
    [0.5, 1.5, 2.5]
}

fn negatives() -> []i64 {
    let xs = [-1, -2, -3]
    xs[0] + xs[1] + xs[2]
    xs
}

fn shuffle(xs: []i64) {
    xs[0] = 999
}

fn smash() -> []i64 {
    let xs = [1, 2, 3, 4]
    shuffle(xs)
    xs
}

fn main() {
    print(status(200))
    print(status(404))
    print(status(999))
    print(count_known())
    print(count_known())

    var a = fresh_map()
    mutate(mut a)
    print(a["a"] ?? -1)
    print(a["b"] ?? -1)
    print(a["z"] ?? -1)
    print(a.len)
    let b = fresh_map()
    print(b["a"] ?? -1)
    print(b["b"] ?? -1)
    print(b["z"] ?? -1)
    print(b.len)
    print(poke_local())
    print(poke_local())

    let s1 = small()
    let s2 = small()
    s1[1] = 11
    print(s1.len)
    print(s1[1] ?? 0)
    print(s2[1] ?? 0)

    for i in 0..6 {
        print(names(i))
    }
    print(total_names())
    print(first_entry(0))
    print(first_entry(2))
    print(levels(0))
    print(levels(2))
    print(halves()[1])
    print(negatives().len)

    let p = smash()
    let q = smash()
    print(p[0])
    print(q[0])
    print(q[3])

    let ws = halves()
    ws[0] = 9.0
    print(halves()[0])
    print(ws[0])
}
