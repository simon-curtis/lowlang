fn insertion(xs: []i64, less: fn(i64, i64) -> bool) {
    for i in 1..xs.len {
        var j = i
        for j > 0 && less(xs[j], xs[j - 1]) {
            let t = xs[j]
            xs[j] = xs[j - 1]
            xs[j - 1] = t
            j -= 1
        }
    }
}

fn walk(xs: []i64, i: i64, f: fn(i64) -> i64) -> i64 {
    if i == xs.len {
        return 0
    }
    f(xs[i]) + walk(xs, i + 1, f)
}

fn twice(xs: []i64, f: fn(i64) -> i64) -> i64 {
    var a = 0
    for x in xs {
        a += f(x)
    }
    var b = 0
    for x in xs {
        b += f(f(x))
    }
    a * 1000 + b
}

fn through(xs: []i64, f: fn(i64) -> i64) -> i64 {
    twice(xs, f) + 1
}

fn double(x: i64) -> i64 {
    x * 2
}

fn pick(flag: bool) -> fn(i64) -> i64 {
    if flag {
        double
    } else {
        fn(x: i64) -> i64 { x + 100 }
    }
}

fn main() {
    var a: []i64 = [5, 3, 9, 1, 7]
    var b: []i64 = [5, 3, 9, 1, 7]
    insertion(a, fn(x: i64, y: i64) -> bool { x < y })
    insertion(b, fn(x: i64, y: i64) -> bool { x > y })
    print("{a[0]} {a[1]} {a[2]} {a[3]} {a[4]}")
    print("{b[0]} {b[1]} {b[2]} {b[3]} {b[4]}")

    let k = 10
    let m = 3
    print(walk(a, 0, fn(x: i64) -> i64 { x + k }))
    print(walk(a, 0, fn(x: i64) -> i64 { x * m }))
    print(walk(a, 0, double))

    print(through(a, fn(x: i64) -> i64 { x + k }))
    print(through(a, fn(x: i64) -> i64 { x - m }))

    print(twice(b, pick(true)))
    print(twice(b, pick(false)))
    for round in 0..3 {
        print(twice(a, fn(x: i64) -> i64 { x + round }))
    }
}
