struct Cell {
    a: i64
    b: i64
    next: *Cell?
}

fn build(n: i64) -> i64 {
    region {
        var head: *Cell? = none
        for i in 0..n {
            head = new(Cell { a: i, b: i * 2, next: head })
        }
        var sum = 0
        var cur = head
        for {
            match cur {
                some(c) => {
                    sum += c.a + c.b
                    cur = c.next
                }
                none => break
            }
        }
        sum
    }
}

fn main() {
    print(build(8000000))
    print(build(1000))
    var total = 0
    for i in 0..3 {
        total += build(2000000) % 1000
    }
    print(total)
}
