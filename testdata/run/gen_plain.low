import std/simd

struct Pixel {
    red: f32
    alpha: u8
    lit: bool
}

struct Pair {
    first: Pixel
    second: Pixel
}

enum Shade {
    Clear
    Grey(u8)
}

fn keep[T: Plain](x: T) -> T {
    x
}

fn twice[T: Plain + Number](x: T) -> T {
    keep(x) + keep(x)
}

fn main() {
    print(keep(7))
    print(keep(true))
    print(twice(1.5))
    let pair = keep(Pair { first: Pixel { red: 0.5, alpha: 255, lit: true }, second: Pixel { red: 1.0, alpha: 0, lit: false } })
    print("{pair.first.alpha} {pair.second.red}")
    print(keep(Shade.Grey(9)))
    let lanes: i32x4 = simd.splat(3)
    print(keep(lanes))
    let maybe: i64? = 4
    print(keep(maybe) ?? 0)
}
