enum Colour {
    Black = 0,
    Red = 1,
    Green = 2,
    Yellow = 3,
    Blue = 4,
    Magenta = 5,
    Cyan = 6,
    White = 7,
    BrightBlack = 8,
    BrightRed = 9,
    BrightGreen = 10,
    BrightYellow = 11,
    BrightBlue = 12,
    BrightMagenta = 13,
    BrightCyan = 14,
    BrightWhite = 15,
    Indexed(n: u8) = -1,
    Rgb(r: u8, g: u8, b: u8) = -1,
}

enum Level {
    Debug = 10
    Info = 11
    Warn = 12
}

enum Status {
    Ok = 200, Created = 201, Missing = 404, Broken = 500, Busy = 503,
}

enum Choice[T] {
    Some(T) = 1
    Nothing = 0
}

struct Point { x: i64, y: i64, }

fn index_of(c: Colour) -> i64 {
    c.index
}

fn main() {
    let colours = [Colour.Black, Colour.Yellow, Colour.BrightWhite, Colour.Indexed(200), Colour.Rgb(1, 2, 3)]
    for c in colours {
        print(index_of(c))
    }
    let levels = [Level.Debug, Level.Info, Level.Warn]
    for l in levels {
        print(l.index)
    }
    let statuses = [Status.Ok, Status.Created, Status.Missing, Status.Broken, Status.Busy]
    for s in statuses {
        print(s.index)
    }
    let some: Choice[str] = Some("x")
    let nothing: Choice[str] = Nothing
    print(some.index)
    print(nothing.index)
    print(Colour.BrightRed.index)
    let p = Point { x: 1, y: 2 }
    print(p.x + p.y)
}
