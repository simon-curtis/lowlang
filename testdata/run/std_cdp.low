import std/cdp
import std/header
import std/http
import std/io
import std/net
import std/text

struct Seen {
    paths: []str
    images: i64
}

fn page(port: i64) -> str {
    "<html><body><img src=\"/picture.png\"><iframe src=\"http://localhost:{port}/frame\"></iframe><script>window.open('/popup')</script></body></html>"
}

fn handle(req: http.Request, port: i64, seen: *Seen) -> http.Response {
    push(mut seen.paths, req.path)
    let html = header.Header { name: "content-type", value: "text/html" }
    if req.path == "/" {
        return http.Response { status: 200, headers: [html], body: bytes(page(port)) }
    }
    if req.path == "/frame" {
        return http.Response { status: 200, headers: [html], body: bytes("<script>fetch('/video.m3u8')</script>") }
    }
    http.response(404, "")
}

fn serve(l: net.ListenerHandle, seen: *Seen) {
    let port = l.addr.port
    let handler = fn(req: http.Request) -> http.Response { handle(req, port, seen) }
    for {
        let c = net.accept_handle(l) catch {
            _ => return
        }
        spawn http.serve_conn_on(c, handler)
    }
}

fn decide(r: cdp.Request, seen: *Seen, found: chan[str]) -> cdp.Verdict {
    if text.ends_with(r.url, ".m3u8") {
        found <- r.url
        return Fail
    }
    if r.resource == "Image" {
        seen.images += 1
        return Fail
    }
    Continue
}

fn main() ! io.Error {
    let seen = new(Seen { paths: [], images: 0 })
    using l = net.listen("127.0.0.1", 0)?
    spawn serve(l.handle, seen)
    using b = cdp.launch(cdp.Options { args: ["--disable-background-networking"] }) catch {
        _ => {
            print("launch failed")
            return
        }
    }
    let found = chan[str](4)
    let handlers = cdp.Handlers {
        request: fn(r: cdp.Request) -> cdp.Verdict { decide(r, seen, found) }
        response: fn(url: str, status: i64) {}
        failure: fn(url: str, reason: str) {}
    }
    let p = cdp.open_page(b, handlers) catch {
        _ => {
            print("open failed")
            cdp.shutdown(b)
            return
        }
    }
    cdp.navigate(p, "http://127.0.0.1:{l.handle.addr.port}/", "") catch {
        _ => print("navigate failed")
    }
    let playlist = select {
        u = <-found => u ?? ""
        after(15000) => "none"
    }
    print(playlist == "http://localhost:{l.handle.addr.port}/video.m3u8")
    print(seen.images > 0)
    var popup = false
    var picture = false
    for path in seen.paths {
        popup = popup || path == "/popup"
        picture = picture || path == "/picture.png"
    }
    print(popup)
    print(picture)
    cdp.shutdown(b)
    net.close_listener(l)
}
