extern "c" {
    fn labs(n: i64) -> i64
}

extern "m" {
    fn cbrt(x: f64) -> f64
}

struct Node {
    value: i64
    next: *Node?
}

fn main() {
    var list: *Node? = none
    for i in 0..1000 {
        list = new(Node { value: i, next: list })
    }
    var junk = 0
    for i in 0..200000 {
        let n = new(Node { value: i, next: none })
        junk += labs(n.value % 2)
    }
    var total = 0
    var cur = list
    for {
        match cur {
            some(node) => {
                total += node.value
                cur = node.next
            }
            none => break
        }
    }
    print("total {total}, junk {junk}, ratio {f64(total) / 3.0 * cbrt(1.0)}")
}
