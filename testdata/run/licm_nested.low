struct Cell {
    a: i64
    b: i64
    c: i64
}

fn grid(rows: i64, cols: i64, depth: i64) -> i64 {
    var total = 0
    for i in 0..rows {
        let row = i * 31 + rows
        for j in 0..cols {
            let cell = j * 17 + row
            for k in 0..depth {
                total += cell * 3 + k * row + i * j
            }
            total += cell
        }
        total += row
    }
    total
}

fn triangle(n: i64) -> i64 {
    var total = 0
    for i in 0..n {
        for j in i + 1..n {
            total += i * 56 + j * 56
        }
    }
    total
}

fn stride_table(cells: []Cell) -> i64 {
    var total = 0
    for i in 0..cells.len {
        for j in i..cells.len {
            total += cells[i].a * cells[j].b + cells[j].c
        }
    }
    total
}

fn inner_exit(n: i64) -> i64 {
    var total = 0
    for i in 0..n {
        let base = i * 9 + 1
        var j = 0
        for j < n {
            if j * base > 40 {
                break
            }
            total += base + j
            j += 1
        }
        total += j
    }
    total
}

fn main() {
    print(grid(0, 4, 4))
    print(grid(3, 0, 4))
    print(grid(3, 4, 0))
    print(grid(4, 5, 6))
    print(triangle(0))
    print(triangle(1))
    print(triangle(9))
    var cells: []Cell = []
    for i in 0..7 {
        push(mut cells, Cell { a: i + 1, b: i * 2, c: 100 - i })
    }
    print(stride_table(cells))
    print(inner_exit(0))
    print(inner_exit(8))
}
