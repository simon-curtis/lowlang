file timestamp.proto proto3 package google.protobuf
option cc_enable_arenas = true
option go_package = "google.golang.org/protobuf/types/known/timestamppb"
option java_package = "com.google.protobuf"
option java_outer_classname = "TimestampProto"
option java_multiple_files = true
option objc_class_prefix = "GPB"
option csharp_namespace = "Google.Protobuf.WellKnownTypes"
message Timestamp
  int64 seconds = 1
  int32 nanos = 2
file duration.proto proto3 package google.protobuf
option cc_enable_arenas = true
option go_package = "google.golang.org/protobuf/types/known/durationpb"
option java_package = "com.google.protobuf"
option java_outer_classname = "DurationProto"
option java_multiple_files = true
option objc_class_prefix = "GPB"
option csharp_namespace = "Google.Protobuf.WellKnownTypes"
message Duration
  int64 seconds = 1
  int32 nanos = 2
file any.proto proto3 package google.protobuf
option go_package = "google.golang.org/protobuf/types/known/anypb"
option java_package = "com.google.protobuf"
option java_outer_classname = "AnyProto"
option java_multiple_files = true
option objc_class_prefix = "GPB"
option csharp_namespace = "Google.Protobuf.WellKnownTypes"
message Any
  string type_url = 1
  bytes value = 2
file service.proto proto3 package svc
message Req
message Reply
  string text = 1
service Echo [deprecated = false]
  rpc Unary(Req) returns (Reply)
  rpc ClientStream(stream Req) returns (Reply)
  rpc ServerStream(Req) returns (stream Reply)
  rpc Bidi(stream Req) returns (stream Reply)
  rpc WithOptions(Req) returns (Reply) [idempotency_level = NO_SIDE_EFFECTS]
  rpc Dotted(.svc.Req) returns (stream .svc.Reply)
file proto2.proto proto2 package people.test
import public other.proto
import weak weak.proto
option java_package = "com.example"
option (my.file_opt) = {a: 1 b: "x" nested { c: [1, 2] }}
message Person [(my.msg_opt).sub = 3]
  required string name = 1
  optional int32 id = 2 default -5
  optional string tag = 3 default "a\tbAAé{}" json TAG
  optional Kind kind = 4 default ADULT
  optional double ratio = 5 default 1500
  optional bytes raw = 6 default "\x00\xff"
  optional bool flag = 7 default true
  optional float big = 8 default inf
  repeated int32 nums = 9 [packed = true]
  optional .people.test.Person.Nested nested = 11
  int32 a = 20 in pick
  string b = 21 in pick
  .people.test.Person.Nested c = 22 in pick
  optional int32 marked = 30 [(my.field_opt) = true] [deprecated = true]
  oneof pick [(my.oneof_opt) = true]
  extensions 100..199,1000..536870911
  reserved numbers 15..15,17..19 names old,older
  enum Kind allow_alias [allow_alias = true]
    CHILD = 0
    ADULT = 1
    GROWNUP = 1
    NEG = -1
    HEX = 16
    OCT = 8
    DEAD = 20 [deprecated = true]
    reserved numbers 30..40 names GONE
  message Nested
    optional Person parent = 1
    repeated map<int64, Nested> kids = 2
    repeated .people.test.Person.Kind kinds = 3
extend Person
  optional int32 extra = 100
service Directory
  rpc Find(Person) returns (Person) [deprecated = true]
