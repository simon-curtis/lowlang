import std/otel

struct Probe {
    exported: i64
    shutdowns: i64
}

fn exporter(p: *Probe) -> otel.SpanExporter {
    otel.SpanExporter {
        export: fn(spans) -> bool {
            p.exported += spans.len
            true
        }
        shutdown: fn() { p.shutdowns += 1 }
    }
}

fn batched(p: *Probe) -> otel.SpanProcessor {
    otel.batch_span_processor(exporter(p), otel.BatchOptions { delay: 60000, timeout: 1000 })
}

fn record(count: i64) {
    let t = otel.tracer("closed")
    for i in 0..count {
        t.start("s{i}").end()
    }
}

fn scope_only(p: *Probe) {
    using sdk = otel.install(otel.Config { span_processors: [batched(p)] })
    record(3)
    print("recording inside scope {otel.tracer("closed").start("probe").is_recording()}")
}

fn explicit_then_scope(p: *Probe) {
    using sdk = otel.install(otel.Config { span_processors: [batched(p)] })
    record(2)
    print("first shutdown {otel.shutdown(sdk)}")
    print("second shutdown {otel.shutdown(sdk)}")
    print("flush after shutdown {otel.force_flush(sdk)}")
    print("recording after shutdown {otel.tracer("closed").start("late").is_recording()}")
}

fn through_view(p: *Probe) {
    using sdk = otel.install(otel.Config { span_processors: [batched(p)] })
    record(1)
    let view = match otel.provider() {
        some(v) => v
        none => return
    }
    print("view shutdown {otel.shutdown_on(view)}")
    print("view shutdown again {otel.shutdown_on(view)}")
    print("view flush {otel.force_flush_on(view)}")
    print("owner shutdown {otel.shutdown(sdk)}")
}

fn adopted(p: *Probe) {
    let view = otel.install_handle(otel.Config { span_processors: [batched(p)] })
    using owner = otel.adopt(view)
    record(4)
}

fn report(name: str, p: *Probe) {
    print("{name}: exported {p.exported} shutdowns {p.shutdowns}")
}

fn main() {
    let a = new(Probe { exported: 0, shutdowns: 0 })
    scope_only(a)
    report("scope exit", a)
    let b = new(Probe { exported: 0, shutdowns: 0 })
    explicit_then_scope(b)
    report("explicit then scope exit", b)
    let c = new(Probe { exported: 0, shutdowns: 0 })
    through_view(c)
    report("view and owner", c)
    let d = new(Probe { exported: 0, shutdowns: 0 })
    adopted(d)
    report("adopted view", d)
}
