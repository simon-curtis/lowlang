struct Point {
    x: i64
    y: i64
}

struct Body {
    pos: Point
    vel: Point
    hits: i64
}

enum Light {
    Red
    Amber
    Green
}

fn origin() -> Point {
    Point { x: 0, y: 0 }
}

fn add(a: Point, b: Point) -> Point {
    Point { x: a.x + b.x, y: a.y + b.y }
}

fn shift(mut p: Point, dx: i64, dy: i64) {
    p.x += dx
    p.y += dy
}

fn step(mut b: Body) {
    shift(mut b.pos, b.vel.x, b.vel.y)
    if b.pos.x > 10 {
        bounce(mut b)
    }
}

fn bounce(mut b: Body) {
    b.vel = Point { x: -b.vel.x, y: b.vel.y }
    b.hits += 1
}

fn next(l: Light) -> Light {
    match l {
        Red => Green
        Green => Amber
        Amber => Red
    }
}

fn advance(mut l: Light) {
    l = next(l)
}

fn name(l: Light) -> str {
    match l {
        Red => "red"
        Amber => "amber"
        Green => "green"
    }
}

fn swap(mut a: i64, mut b: i64) {
    let t = a
    a = b
    b = t
}

fn reset(mut p: Point) {
    p = origin()
}

fn grow(mut body: Body, by: i64) {
    shift(mut body.pos, by, by)
    reset(mut body.vel)
}

fn main() {
    var p = Point { x: 1, y: 2 }
    shift(mut p, 10, 20)
    print(p.x)
    print(p.y)

    var a = 3
    var b = 4
    swap(mut a, mut b)
    print(a)
    print(b)
    swap(mut p.x, mut p.y)
    print(p.x)

    var body = Body { pos: Point { x: 0, y: 0 }, vel: Point { x: 4, y: 1 }, hits: 0 }
    var i = 0
    for i < 5 {
        step(mut body)
        i += 1
    }
    print(body.pos.x)
    print(body.pos.y)
    print(body.hits)

    let copy = body
    grow(mut body, 100)
    print(body.pos.x)
    print(body.vel.x)
    print(copy.pos.x)

    var light = Light.Red
    advance(mut light)
    print(name(light))
    advance(mut light)
    advance(mut light)
    print(name(light))
    print(add(origin(), p).y)
}
