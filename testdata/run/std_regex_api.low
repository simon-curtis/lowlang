import std/regex
import std/text

fn count_tokens(re: regex.Regex, input: str, results: chan[i64]) {
    var total = 0
    for i in 0..200 {
        total += re.find_all(input).len
    }
    results <- total
}

fn main() {
    let re = regex.compile("(\\w+)@(\\w+)\\.com") or return
    print(re.group_count())
    let m = re.find("mail ada@example.com now") ?? return
    print("{m.text()} {m.start()} {m.end()}")
    print(m.group(0) ?? "-")
    print(m.group(1) ?? "-")
    print(m.group(2) ?? "-")
    print(m.group(3) ?? "none")
    print(m.group(-1) ?? "none")
    let s = m.span(2) ?? return
    print("{s.start} {s.end}")

    let words = regex.compile("[a-z]+") or return
    print(words.split_n("a1b2c3d", 0) |> text.join(","))
    print(words.split_n("a1b2c3d", 2) |> text.join(","))
    print(words.replace_all("one two three", fn(found: regex.Match) -> str { text.upper(found.text()) }))

    let results = chan[i64](8)
    for i in 0..8 {
        let input = text.repeat("w{i} ", i + 1)
        spawn count_tokens(words, input, results)
    }
    var sum = 0
    for i in 0..8 {
        sum += (<-results) ?? 0
    }
    print(sum)
}
