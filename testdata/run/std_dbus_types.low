import std/dbus
import std/text

struct Case {
    text: str
    valid: bool
}

fn repeat(unit: str, n: i64) -> str {
    var parts: str[] = []
    for i in 0..n {
        parts.push(unit)
    }
    text.join(parts, "")
}

fn cases() -> Case[] {
    [
        Case { text: "", valid: true },
        Case { text: "i", valid: true },
        Case { text: "ii", valid: true },
        Case { text: "a", valid: false },
        Case { text: "ai", valid: true },
        Case { text: "aai", valid: true },
        Case { text: "(ii)", valid: true },
        Case { text: "()", valid: false },
        Case { text: "(i", valid: false },
        Case { text: "i)", valid: false },
        Case { text: "a{{sv}}", valid: true },
        Case { text: "{{sv}}", valid: false },
        Case { text: "a{{vs}}", valid: false },
        Case { text: "a{{s}}", valid: false },
        Case { text: "a{{sss}}", valid: false },
        Case { text: "a{{(i)s}}", valid: false },
        Case { text: "a{{as}}", valid: false },
        Case { text: "a{{}}", valid: false },
        Case { text: "a{{i}}", valid: false },
        Case { text: "v", valid: true },
        Case { text: "av", valid: true },
        Case { text: "(a{{sv}}i)", valid: true },
        Case { text: "z", valid: false },
        Case { text: "a(", valid: false },
        Case { text: "a{{", valid: false },
        Case { text: "ybnqiuxtdsogh", valid: true },
        Case { text: "m", valid: false },
        Case { text: "*", valid: false },
        Case { text: "?", valid: false },
        Case { text: "r", valid: false },
        Case { text: "e", valid: false },
        Case { text: "aa", valid: false },
        Case { text: "(ai)", valid: true },
        Case { text: "a(a{{sv}})", valid: true },
        Case { text: "a{{sa{{sv}}}}", valid: true },
        Case { text: "(i)(i)", valid: true },
        Case { text: "a{{iv}}a{{vi}}", valid: false },
        Case { text: "{{ii}}", valid: false },
        Case { text: "ia{{ss}}", valid: true },
        Case { text: "a{{sv}}{{sv}}", valid: false },
        Case { text: "{repeat("a", 32)}i", valid: true },
        Case { text: "{repeat("a", 33)}i", valid: false },
        Case { text: "{repeat("(", 32)}i{repeat(")", 32)}", valid: true },
        Case { text: "{repeat("(", 33)}i{repeat(")", 33)}", valid: false },
        Case { text: "{repeat("a", 32)}{repeat("(", 32)}i{repeat(")", 32)}", valid: true },
        Case { text: "{repeat("a", 31)}{repeat("(", 33)}i{repeat(")", 33)}", valid: false },
        Case { text: "a{repeat("(", 32)}i{repeat(")", 32)}", valid: true },
        Case { text: "{repeat("i", 255)}", valid: true },
        Case { text: "{repeat("i", 256)}", valid: false },
        Case { text: "{repeat("a", 32)}{{is}}", valid: true },
        Case { text: "a{{i{repeat("a", 31)}s}}", valid: true },
    ]
}

fn type_result(parse: fn(str) -> dbus.Type ! dbus.Error, s: str) -> str {
    let t = parse(s) catch {
        e => return "{e}"
    }
    dbus.type_signature(t)
}

fn show(s: str) -> str {
    if s.len > 40 {
        return "{s[..12]}... ({s.len} bytes)"
    }
    text.quote(s)
}

fn main() {
    var wrong = 0
    var round_trip = 0
    for c in cases() {
        let parsed = dbus.parse_signature(c.text) catch {
            e => {
                if c.valid {
                    print("{show(c.text)}: rejected but valid: {e}")
                    wrong += 1
                }
                continue
            }
        }
        if !c.valid {
            print("{show(c.text)}: accepted but invalid")
            wrong += 1
            continue
        }
        if dbus.signature_text(parsed) != c.text {
            print("{show(c.text)}: signature_text gives {show(dbus.signature_text(parsed))}")
            wrong += 1
        } else {
            round_trip += 1
        }
    }
    print("{cases().len} signatures checked against libdbus, {wrong} wrong, {round_trip} round trips")

    for s in ["a{{sv}}", "(iay)", "s", "", "ii", "a", "{{sv}}"] {
        print("parse_type {text.quote(s)}: {type_result(dbus.parse_type, s)}")
    }
    for s in ["{{sv}}", "s", "", "ss", "a", "{{s}}", "s}}", "(ii)"] {
        print("parse_element {text.quote(s)}: {type_result(dbus.parse_element, s)}")
    }
    print("type_signature of a nested type: {dbus.type_signature(dbus.Type.Array(new(dbus.Type.Struct([dbus.Type.Int32, dbus.Type.Array(new(dbus.Type.Byte))]))))}")
    print("signature_text of several: {dbus.signature_text([dbus.Type.String, dbus.Type.Variant, dbus.Type.UnixFd])}")
    let empty = dbus.parse_signature("") or [dbus.Type.Byte]
    print("empty: {empty.len}")
    let types = dbus.parse_signature("ybnqiuxtdsogvh") or []
    print("basic types: {types.len}")
}
