}

fn check_f32x16() {
    let zero: f32 = 0.0
    let vals: f32[] = [0.0, -zero, 1.0, -1.5, zero / zero, 1.0 / zero, -1.0 / zero, 3.25]
    var bad = 0
    for round in 0..64 {
        let x0 = round / 8
        let y0 = round % 8
        var xs: f32[] = []
        var ys: f32[] = []
        for i in 0..16 {
            xs.push(vals[(x0 + i + i / 8) % 8])
            ys.push(vals[(y0 + 3 * i + i / 5) % 8])
        }
        let a: f32x16 = simd.read(xs, 0)
        let b: f32x16 = simd.read(ys, 0)
        let ops: f32x16[] = [a + b, a - b, a * b, a / b, simd.min(a, b), simd.max(a, b), -a, simd.blend(a < b, a, b), simd.blend(a >= b, b, a)]
        let compared: u32x16[] = [u32x16(a == b), u32x16(a != b), u32x16(a < b), u32x16(a <= b), u32x16(a > b), u32x16(a >= b)]
        var lt: u64 = 0
        var le: u64 = 0
        var gt: u64 = 0
        var ge: u64 = 0
        var eq: u64 = 0
        var ne: u64 = 0
        for i in 0..16 {
            let x = xs[i]
            let y = ys[i]
            lt |= bit(x < y, i)
            le |= bit(x <= y, i)
            gt |= bit(x > y, i)
            ge |= bit(x >= y, i)
            eq |= bit(x == y, i)
            ne |= bit(x != y, i)
            let want: f32[] = [x + y, x - y, x * y, x / y, if x < y { x } else { y }, if x > y { x } else { y }, -x, if x < y { x } else { y }, if x >= y { y } else { x }]
            for k, v in ops {
                let got: f32 = simd.lane(v, i)
                if !same_f32(got, want[k]) {
                    bad += 1
                }
            }
            let held: bool[] = [x == y, x != y, x < y, x <= y, x > y, x >= y]
            for k, v in compared {
                let got: u32 = simd.lane(v, i)
                let expected: u32 = if held[k] { 4294967295 } else { 0 }
                if got != expected {
                    bad += 1
                }
            }
        }
        if simd.mask(a < b) != lt || simd.mask(a <= b) != le || simd.mask(a > b) != gt || simd.mask(a >= b) != ge {
            bad += 1
        }
        if simd.mask(a == b) != eq || simd.mask(a != b) != ne || simd.any(a < b) != (lt != 0) {
            bad += 1
        }
        let full: u64 = 65535
        if simd.all(a == b) != (eq == full) || simd.all(a <= b) != (le == full) {
            bad += 1
        }
        let m = a < b
        let bits = simd.mask(m)
        let picked = simd.blend(m, a, b)
        if bits != lt {
            bad += 1
        }
        for i in 0..16 {
            let p: f32 = simd.lane(picked, i)
            if !same_f32(p, if xs[i] < ys[i] { xs[i] } else { ys[i] }) {
                bad += 1
            }
        }
        let s: f32x16 = simd.splat(xs[15])
        for i in 0..16 {
            let got: f32 = simd.lane(s, i)
            if !same_f32(got, xs[15]) {
                bad += 1
            }
        }
    }
    report("f32x16", bad)
}

fn same_f32(got: f32, want: f32) -> bool {
    if got != got {
        return want != want
    }
    if got != want {
        return false
    }
    got != 0.0 || 1.0 / got == 1.0 / want
}

fn check_f64x8() {
    let zero: f64 = 0.0
    let vals: f64[] = [0.0, -zero, 1.0, -1.5, zero / zero, 1.0 / zero, -1.0 / zero, 3.25]
    var bad = 0
    for round in 0..64 {
        let x0 = round / 8
        let y0 = round % 8
        var xs: f64[] = []
        var ys: f64[] = []
        for i in 0..8 {
            xs.push(vals[(x0 + i + i / 8) % 8])
            ys.push(vals[(y0 + 3 * i + i / 5) % 8])
        }
        let a: f64x8 = simd.read(xs, 0)
        let b: f64x8 = simd.read(ys, 0)
        let ops: f64x8[] = [a + b, a - b, a * b, a / b, simd.min(a, b), simd.max(a, b), -a, simd.blend(a < b, a, b), simd.blend(a >= b, b, a)]
        let compared: u64x8[] = [u64x8(a == b), u64x8(a != b), u64x8(a < b), u64x8(a <= b), u64x8(a > b), u64x8(a >= b)]
        var lt: u64 = 0
        var le: u64 = 0
        var gt: u64 = 0
        var ge: u64 = 0
        var eq: u64 = 0
        var ne: u64 = 0
        for i in 0..8 {
            let x = xs[i]
            let y = ys[i]
            lt |= bit(x < y, i)
            le |= bit(x <= y, i)
            gt |= bit(x > y, i)
            ge |= bit(x >= y, i)
            eq |= bit(x == y, i)
            ne |= bit(x != y, i)
            let want: f64[] = [x + y, x - y, x * y, x / y, if x < y { x } else { y }, if x > y { x } else { y }, -x, if x < y { x } else { y }, if x >= y { y } else { x }]
            for k, v in ops {
                let got: f64 = simd.lane(v, i)
                if !same_f64(got, want[k]) {
                    bad += 1
                }
            }
            let held: bool[] = [x == y, x != y, x < y, x <= y, x > y, x >= y]
            for k, v in compared {
                let got: u64 = simd.lane(v, i)
                let expected: u64 = if held[k] { 18446744073709551615 } else { 0 }
                if got != expected {
                    bad += 1
                }
            }
        }
        if simd.mask(a < b) != lt || simd.mask(a <= b) != le || simd.mask(a > b) != gt || simd.mask(a >= b) != ge {
            bad += 1
        }
        if simd.mask(a == b) != eq || simd.mask(a != b) != ne || simd.any(a < b) != (lt != 0) {
            bad += 1
        }
        let full: u64 = 255
        if simd.all(a == b) != (eq == full) || simd.all(a <= b) != (le == full) {
            bad += 1
        }
        let m = a < b
        let bits = simd.mask(m)
        let picked = simd.blend(m, a, b)
        if bits != lt {
            bad += 1
        }
        for i in 0..8 {
            let p: f64 = simd.lane(picked, i)
            if !same_f64(p, if xs[i] < ys[i] { xs[i] } else { ys[i] }) {
                bad += 1
            }
        }
        let s: f64x8 = simd.splat(xs[7])
        for i in 0..8 {
            let got: f64 = simd.lane(s, i)
            if !same_f64(got, xs[7]) {
                bad += 1
            }
        }
    }
    report("f64x8", bad)
}

fn same_f64(got: f64, want: f64) -> bool {
    if got != got {
        return want != want
    }
    if got != want {
        return false
    }
    got != 0.0 || 1.0 / got == 1.0 / want
}

fn check_shuffle64() {
    var bad = 0
    var table: u8[] = []
    var indices: u8[] = []
    for i in 0..64 {
        table.push(u8(200 - 3 * i))
        indices.push(u8((i * 7 + i / 16) % 16))
    }
    indices[5] = 128
    indices[33] = 255
    indices[62] = 143
    let t: u8x64 = simd.read(table, 0)
    let k: u8x64 = simd.read(indices, 0)
    let got_all = simd.shuffle64(t, k)
    for i in 0..64 {
        let index = indices[i]
        let want: u8 = if index >= 128 { 0 } else { table[(i / 16) * 16 + i64(index % 16)] }
        let got: u8 = simd.lane(got_all, i)
        if got != want {
            bad += 1
        }
    }
    report("shuffle64", bad)
}

struct Held {
    words: u32x16
    wide: i64x8
    count: i64
}

fn fib(n: i64) -> i64 {
    if n < 2 {
        return n
    }
    fib(n - 1) + fib(n - 2)
}

fn scaled(v: f64x8, by: f64) -> f64x8 {
    v * by + v
}

fn accumulate(data: u32[]) -> u32x16 {
    var acc: u32x16 = simd.splat(1)
    let cap: u32x16 = simd.splat(1000)
    var i = 0
    for i + 16 <= data.len {
        let chunk: u32x16 = simd.read(data, i)
        acc += simd.min(chunk, cap)
        if fib(6) != 8 {
            acc ^= chunk
        }
        i += 16
    }
    acc
}

fn check_paths() {
    var bad = 0
    var data: u32[] = []
    for i in 0..160 {
        data.push(u32(i * 37 % 1500))
    }
    let acc = accumulate(data)
    for lane in 0..16 {
        var want: u32 = 1
        for block in 0..10 {
            let x = data[16 * block + lane]
            want += if x < 1000 { x } else { 1000 }
        }
        let got: u32 = simd.lane(acc, lane)
        if got != want {
            bad += 1
        }
    }
    var wide: i64[] = []
    var floats: f64[] = []
    for i in 0..8 {
        wide.push(i64(i) * 1000000007 - 3)
        floats.push(f64(i) * 0.5 - 1.0)
    }
    let h = Held { words: acc, wide: simd.read(wide, 0), count: 3 }
    var list: Held[] = [h, h]
    list[1].wide = list[1].wide * h.wide
    let f = scaled(simd.read(floats, 0), 2.0)
    for i in 0..16 {
        let got: u32 = simd.lane(list[0].words, i)
        let want: u32 = simd.lane(acc, i)
        if got != want {
            bad += 1
        }
    }
    for i in 0..8 {
        let got: i64 = simd.lane(list[1].wide, i)
        if got != wide[i] * wide[i] {
            bad += 1
        }
        let got_f: f64 = simd.lane(f, i)
        if got_f != floats[i] * 2.0 + floats[i] {
            bad += 1
        }
    }
    let bytes: u8x64 = u8x64(list[1].words)
    let back: u32x16 = u32x16(bytes)
    for i in 0..16 {
        let got: u32 = simd.lane(back, i)
        let want: u32 = simd.lane(list[1].words, i)
        if got != want {
            bad += 1
        }
    }
    var updated = simd.with_lane(acc, 15, u32(7))
    updated = simd.with_lane(updated, 9, u32(9))
    let last: u32 = simd.lane(updated, 15)
    let ninth: u32 = simd.lane(updated, 9)
    if last != 7 || ninth != 9 {
        bad += 1
    }
    var out: u32[] = []
    for _ in 0..20 {
        out.push(0)
    }
    simd.write(out, 2, updated)
    if out[17] != 7 || out[11] != 9 || out[1] != 0 || out[18] != 0 {
        bad += 1
    }
    print("{acc}")
    report("paths", bad)
}

fn main() {
    check_u8x64()
    check_u16x32()
    check_u32x16()
    check_u64x8()
    check_i32x16()
    check_i64x8()
    check_f32x16()
    check_f64x8()
    check_shuffle64()
    check_paths()
}
