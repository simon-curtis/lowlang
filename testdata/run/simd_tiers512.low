fn check_i32x16() {
    let vals: i32[] = [0, 1, -1, 2, -2, 2147483647, -2147483648, -2147483647]
    var bad = 0
    for round in 0..64 {
        let x0 = round / 8
        let y0 = round % 8
        var xs: i32[] = []
        var ys: i32[] = []
        for i in 0..16 {
            xs.push(vals[(x0 + i + i / 8) % 8])
