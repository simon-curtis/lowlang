        }
        let a: i32x16 = simd.read(xs, 0)
        let b: i32x16 = simd.read(ys, 0)
        let ops: i32x16[] = [a + b, a - b, a * b, a & b, a | b, a ^ b, ~a, simd.min(a, b), simd.max(a, b), a == b, a != b, a < b, a <= b, a > b, a >= b, a << 3, a >> 3, simd.blend(a < b, a, b), simd.blend(a != b, b, a), a >= vals[4], a < vals[5], -a]
        var lt: u64 = 0
        var le: u64 = 0
        var gt: u64 = 0
        var ge: u64 = 0
        var eq: u64 = 0
        var ne: u64 = 0
        var top: u64 = 0
        for i in 0..16 {
            let x = xs[i]
            let y = ys[i]
            lt |= bit(x < y, i)
            le |= bit(x <= y, i)
            gt |= bit(x > y, i)
            ge |= bit(x >= y, i)
            eq |= bit(x == y, i)
            ne |= bit(x != y, i)
            top |= bit(x < 0, i)
            let want: i32[] = [
                x + y,
                x - y,
                x * y,
                x & y,
                x | y,
                x ^ y,
                ~x,
                if x < y { x } else { y },
                if x > y { x } else { y },
                if x == y { -1 } else { 0 },
                if x != y { -1 } else { 0 },
                if x < y { -1 } else { 0 },
                if x <= y { -1 } else { 0 },
                if x > y { -1 } else { 0 },
                if x >= y { -1 } else { 0 },
                x << 3,
                x >> 3,
                if x < y { x } else { y },
                if x != y { y } else { x },
                if x >= vals[4] { -1 } else { 0 },
                if x < vals[5] { -1 } else { 0 },
                -x
            ]
            for k, v in ops {
                let got: i32 = simd.lane(v, i)
                if got != want[k] {
                    bad += 1
                }
            }
        }
        if simd.mask(a < b) != lt || simd.mask(a <= b) != le || simd.mask(a > b) != gt || simd.mask(a >= b) != ge {
            bad += 1
        }
        if simd.mask(a == b) != eq || simd.mask(a != b) != ne || simd.mask(a) != top {
            bad += 1
        }
        if simd.any(a > b) != (gt != 0) || simd.any(a == b) != (eq != 0) {
            bad += 1
        }
        let full: u64 = 65535
        if simd.all(a < b) != (lt == full) || simd.all(a >= b) != (ge == full) || !simd.all(a == a) {
            bad += 1
        }
        let m = a < b
        let bits = simd.mask(m)
        let picked = simd.blend(m, a, b)
        let n2 = a != b
        let bits2 = simd.mask(n2)
        if round % 2 == 1 {
            bad += i64(bits2 & 0)
        }
        let swapped = simd.blend(n2, b, a)
        if bits != lt || bits2 != ne {
            bad += 1
        }
        for i in 0..16 {
            let p: i32 = simd.lane(picked, i)
            let q: i32 = simd.lane(swapped, i)
            if p != (if xs[i] < ys[i] { xs[i] } else { ys[i] }) || q != ys[i] {
                bad += 1
            }
        }
        let kept = a <= b
        let low = simd.blend(kept, a, b)
        if simd.mask(kept) != le {
            bad += 1
        }
        let apart = a != b
        if round % 3 == 0 {
            if lane_sum_i32x16(low) != lane_sum_i32x16(simd.min(a, b)) {
                bad += 1
            }
        }
        if simd.mask(apart) != ne {
            bad += 1
        }
        let s: i32x16 = simd.splat(xs[15])
        for i in 0..16 {
            let got: i32 = simd.lane(s, i)
            if got != xs[15] {
                bad += 1
            }
        }
    }
    let counts: i64[] = [0, 1, 7, 8, 9, 15, 16, 17, 31, 32, 33, 63, 64, 65, 200, 4294967296, -1]
    var edge: i32[] = []
    for i in 0..16 {
        edge.push(vals[(i + i / 8) % 8])
    }
    let c: i32x16 = simd.read(edge, 0)
    for n in counts {
        let shifted_left = c << n
        let shifted_right = c >> n
        for i in 0..16 {
            let x = edge[i]
            let got_left: i32 = simd.lane(shifted_left, i)
            let got_right: i32 = simd.lane(shifted_right, i)
            let want_left: i32 = if n < 0 || n >= 32 { 0 } else { x << n }
            let want_right: i32 = if n < 0 || n >= 32 { if x < 0 { -1 } else { 0 } } else { x >> n }
            if got_left != want_left || got_right != want_right {
                bad += 1
            }
        }
    }
    report("i32x16", bad)
}

fn lane_sum_i32x16(v: i32x16) -> i64 {
    var total = 0
    for i in 0..16 {
        let x: i32 = simd.lane(v, i)
        total += i64(x % 251)
    }
    total
}

fn check_i64x8() {
