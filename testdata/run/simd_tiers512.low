import std/simd

fn report(name: str, failures: i64) {
    if failures == 0 {
        print("{name}: ok")
    } else {
        print("{name}: {failures} mismatches")
    }
}

fn bit(cond: bool, at: i64) -> u64 {
    if cond {
        return u64(1) << at
    }
    0
}

fn check_u8x64() {
    let vals: u8[] = [0, 1, 2, 127, 128, 129, 254, 255]
    var bad = 0
    for round in 0..64 {
        let x0 = round / 8
        let y0 = round % 8
        var xs: u8[] = []
        var ys: u8[] = []
        for i in 0..64 {
            xs.push(vals[(x0 + i + i / 8) % 8])
            ys.push(vals[(y0 + 3 * i + i / 5) % 8])
        }
        let a: u8x64 = simd.read(xs, 0)
        let b: u8x64 = simd.read(ys, 0)
        let ops: u8x64[] = [a + b, a - b, a * b, a & b, a | b, a ^ b, ~a, simd.min(a, b), simd.max(a, b), a == b, a != b, a < b, a <= b, a > b, a >= b, a << 3, a >> 3, simd.blend(a < b, a, b), simd.blend(a != b, b, a), a >= vals[4], a < vals[5]]
        var lt: u64 = 0
        var le: u64 = 0
        var gt: u64 = 0
        var ge: u64 = 0
        var eq: u64 = 0
        var ne: u64 = 0
        var top: u64 = 0
        for i in 0..64 {
            let x = xs[i]
            let y = ys[i]
            lt |= bit(x < y, i)
            le |= bit(x <= y, i)
            gt |= bit(x > y, i)
            ge |= bit(x >= y, i)
            eq |= bit(x == y, i)
            ne |= bit(x != y, i)
            top |= bit(x >= 128, i)
            let want: u8[] = [
                x + y,
                x - y,
                x * y,
                x & y,
                x | y,
                x ^ y,
                ~x,
                if x < y { x } else { y },
                if x > y { x } else { y },
                if x == y { 255 } else { 0 },
                if x != y { 255 } else { 0 },
                if x < y { 255 } else { 0 },
                if x <= y { 255 } else { 0 },
                if x > y { 255 } else { 0 },
                if x >= y { 255 } else { 0 },
                x << 3,
                x >> 3,
                if x < y { x } else { y },
                if x != y { y } else { x },
                if x >= vals[4] { 255 } else { 0 },
                if x < vals[5] { 255 } else { 0 }
            ]
            for k, v in ops {
                let got: u8 = simd.lane(v, i)
                if got != want[k] {
                    bad += 1
                }
            }
        }
        if simd.mask(a < b) != lt || simd.mask(a <= b) != le || simd.mask(a > b) != gt || simd.mask(a >= b) != ge {
            bad += 1
        }
        if simd.mask(a == b) != eq || simd.mask(a != b) != ne || simd.mask(a) != top {
            bad += 1
        }
        if simd.any(a > b) != (gt != 0) || simd.any(a == b) != (eq != 0) {
            bad += 1
        }
        let full: u64 = 18446744073709551615
        if simd.all(a < b) != (lt == full) || simd.all(a >= b) != (ge == full) || !simd.all(a == a) {
            bad += 1
        }
        let m = a < b
        let bits = simd.mask(m)
        let picked = simd.blend(m, a, b)
        let n2 = a != b
        let bits2 = simd.mask(n2)
        if round % 2 == 1 {
            bad += i64(bits2 & 0)
        }
        let swapped = simd.blend(n2, b, a)
        if bits != lt || bits2 != ne {
            bad += 1
        }
        for i in 0..64 {
            let p: u8 = simd.lane(picked, i)
            let q: u8 = simd.lane(swapped, i)
            if p != (if xs[i] < ys[i] { xs[i] } else { ys[i] }) || q != ys[i] {
                bad += 1
            }
        }
        let kept = a <= b
        let low = simd.blend(kept, a, b)
        if simd.mask(kept) != le {
            bad += 1
        }
        let apart = a != b
        if round % 3 == 0 {
            if lane_sum_u8x64(low) != lane_sum_u8x64(simd.min(a, b)) {
                bad += 1
            }
        }
        if simd.mask(apart) != ne {
            bad += 1
        }
        let s: u8x64 = simd.splat(xs[63])
        for i in 0..64 {
            let got: u8 = simd.lane(s, i)
            if got != xs[63] {
                bad += 1
            }
        }
    }
    let counts: i64[] = [0, 1, 7, 8, 9, 15, 16, 17, 31, 32, 33, 63, 64, 65, 200, 4294967296, -1]
    var edge: u8[] = []
    for i in 0..64 {
        edge.push(vals[(i + i / 8) % 8])
    }
    let c: u8x64 = simd.read(edge, 0)
    for n in counts {
        let shifted_left = c << n
        let shifted_right = c >> n
        for i in 0..64 {
            let x = edge[i]
            let got_left: u8 = simd.lane(shifted_left, i)
            let got_right: u8 = simd.lane(shifted_right, i)
            let want_left: u8 = if n < 0 || n >= 8 { 0 } else { x << n }
            let want_right: u8 = if n < 0 || n >= 8 { 0 } else { x >> n }
            if got_left != want_left || got_right != want_right {
                bad += 1
            }
        }
    }
    report("u8x64", bad)
}

fn lane_sum_u8x64(v: u8x64) -> i64 {
    var total = 0
    for i in 0..64 {
        let x: u8 = simd.lane(v, i)
        total += i64(x % 251)
    }
    total
}

