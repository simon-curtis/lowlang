                if x > y { x } else { y },
                if x == y { -1 } else { 0 },
                if x != y { -1 } else { 0 },
                if x < y { -1 } else { 0 },
                if x <= y { -1 } else { 0 },
                if x > y { -1 } else { 0 },
                if x >= y { -1 } else { 0 },
                x << 3,
                x >> 3,
                if x < y { x } else { y },
                if x != y { y } else { x },
                if x >= vals[4] { -1 } else { 0 },
                if x < vals[5] { -1 } else { 0 },
                -x
            ]
            for k, v in ops {
                let got: i64 = simd.lane(v, i)
                if got != want[k] {
                    bad += 1
                }
            }
        }
        if simd.mask(a < b) != lt || simd.mask(a <= b) != le || simd.mask(a > b) != gt || simd.mask(a >= b) != ge {
            bad += 1
        }
        if simd.mask(a == b) != eq || simd.mask(a != b) != ne || simd.mask(a) != top {
            bad += 1
        }
        if simd.any(a > b) != (gt != 0) || simd.any(a == b) != (eq != 0) {
            bad += 1
        }
        let full: u64 = 255
        if simd.all(a < b) != (lt == full) || simd.all(a >= b) != (ge == full) || !simd.all(a == a) {
            bad += 1
        }
        let m = a < b
        let bits = simd.mask(m)
        let picked = simd.blend(m, a, b)
        let n2 = a != b
        let bits2 = simd.mask(n2)
        if round % 2 == 1 {
            bad += i64(bits2 & 0)
        }
        let swapped = simd.blend(n2, b, a)
        if bits != lt || bits2 != ne {
            bad += 1
        }
        for i in 0..8 {
            let p: i64 = simd.lane(picked, i)
            let q: i64 = simd.lane(swapped, i)
            if p != (if xs[i] < ys[i] { xs[i] } else { ys[i] }) || q != ys[i] {
                bad += 1
            }
        }
        let kept = a <= b
        let low = simd.blend(kept, a, b)
        if simd.mask(kept) != le {
            bad += 1
        }
        let apart = a != b
        if round % 3 == 0 {
            if lane_sum_i64x8(low) != lane_sum_i64x8(simd.min(a, b)) {
                bad += 1
            }
        }
        if simd.mask(apart) != ne {
            bad += 1
        }
        let s: i64x8 = simd.splat(xs[7])
        for i in 0..8 {
            let got: i64 = simd.lane(s, i)
            if got != xs[7] {
                bad += 1
