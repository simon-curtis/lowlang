import std/file
import std/io
import std/os
import std/text

fn first_with(lines: []str, column: i64, value: str) -> str? {
    for line in lines {
        let parts = text.split(line, ':')
        if parts.len > column && parts[column] == value {
            return line
        }
    }
    none
}

fn user_lines() -> []str {
    var out: []str = []
    let content = file.read_text("/etc/passwd") or return out
    for line in text.lines(content) {
        if text.split(line, ':').len >= 7 && !text.starts_with(line, "#") {
            push(mut out, line)
        }
    }
    out
}

fn group_lines() -> []str {
    var out: []str = []
    let content = file.read_text("/etc/group") or return out
    for line in text.lines(content) {
        if text.split(line, ':').len >= 4 && !text.starts_with(line, "#") {
            push(mut out, line)
        }
    }
    out
}

fn users() {
    var checked = 0
    var consistent = 0
    for line in user_lines() {
        let parts = text.split(line, ':')
        let uid = text.parse_int(parts[2]) or continue
        let by_id = os.lookup_user(uid) ?? continue
        let by_name = os.lookup_user_name(parts[0]) ?? continue
        checked += 1
        let id_fields = text.split(first_with(user_lines(), 2, parts[2]) ?? "", ':')
        let name_fields = text.split(first_with(user_lines(), 0, parts[0]) ?? "", ':')
        let name_uid = text.parse_int(name_fields[2]) or -1
        let by_id_matches = by_id.name == id_fields[0] && by_id.home == id_fields[5]
        let by_name_matches = by_name.uid == name_uid && by_name.shell == name_fields[6]
        if by_id_matches && by_name_matches {
            consistent += 1
        }
    }
    print("users agree {checked == consistent}")
    print("lookup by missing id {os.lookup_user(1 << 40) == none}")
    print("lookup by missing name {os.lookup_user_name("no such user name") == none}")
    print("lookup by empty name {os.lookup_user_name("") == none}")
}

fn missing_group(g: os.Group?) -> bool {
    match g {
        some(_) => false
        none => true
    }
}

fn groups() {
    var checked = 0
    var consistent = 0
    for line in group_lines() {
        let parts = text.split(line, ':')
        let gid = text.parse_int(parts[2]) or continue
        let by_id = os.lookup_group(gid) ?? continue
        let by_name = os.lookup_group_name(parts[0]) ?? continue
        checked += 1
        let id_fields = text.split(first_with(group_lines(), 2, parts[2]) ?? "", ':')
        let name_fields = text.split(first_with(group_lines(), 0, parts[0]) ?? "", ':')
        let name_gid = text.parse_int(name_fields[2]) or -1
        if by_id.name == id_fields[0] && by_name.gid == name_gid {
            consistent += 1
        }
    }
    print("groups agree {checked == consistent}")
    print("lookup by missing gid {missing_group(os.lookup_group(1 << 40))}")
    print("lookup by missing group {missing_group(os.lookup_group_name("no such group name"))}")
}

fn member_names(line: str) -> []str {
    let parts = text.split(line, ':')
    var out: []str = []
    for name in text.split(parts[3], ',') {
        if name.len > 0 {
            push(mut out, name)
        }
    }
    out
}

fn expected_groups(user: str) -> []str {
    var out: []str = []
    for line in group_lines() {
        for name in member_names(line) {
            if name == user {
                push(mut out, text.split(line, ':')[0])
                break
            }
        }
    }
    out
}

fn supplementary() {
    var checked = 0
    var consistent = 0
    for line in user_lines() {
        let name = text.split(line, ':')[0]
        var found: []str = []
        for g in os.supplementary_groups(name) {
            push(mut found, g.name)
        }
        checked += 1
        if text.join(found, ",") == text.join(expected_groups(name), ",") {
            consistent += 1
        }
    }
    print("supplementary agree {checked == consistent}")
    print("supplementary of nobody {os.supplementary_groups("no such user name").len}")
}

fn current() {
    let me = os.lookup_user(os.euid())
    match me {
        some(u) => print("current user {u.uid == os.euid()} {os.user_name() == some(u.name)}")
        none => print("current user {os.user_name() == none}")
    }
}

fn cgroup_consistent() {
    let membership = file.read_text("/proc/self/cgroup") or return print("cgroup unreadable")
    var path = ""
    for line in text.lines(membership) {
        if text.starts_with(line, "0::") {
            path = line[3..]
        }
    }
    let unified = path.len > 0 && file.exists("/sys/fs/cgroup/cgroup.controllers")
    let limits = os.cgroup_limits() catch {
        Unsupported => return print("cgroup limits consistent {!unified}")
        e => return print("cgroup limits {e}")
    }
    var agrees = unified
    let own = "/sys/fs/cgroup{path}/memory.current"
    if file.exists(own) {
        agrees = limits.memory_current != none
    }
    print("cgroup limits consistent {agrees}")
}

fn main() {
    users()
    groups()
    supplementary()
    current()
    cgroup_consistent()
}
