import std/io

fn spread(n: i64) -> [][]u8 {
    var keep: [][]u8 = []
    for i in 0..n {
        let hole = io.buffer(2097152)
        for p in 0..hole.len {
            hole[p] = 1
        }
        let spacer = io.buffer(4096)
        spacer[0] = u8(i % 200 + 1)
        push(mut keep, spacer)
    }
    keep
}

fn refill(n: i64) -> i64 {
    var total = 0
    for i in 0..n {
        let b = io.buffer(3145728)
        b[0] = 1
        total += b.len
        let c = io.buffer(1048576)
        var bad = 0
        for j in 0..64 {
            if c[j * 16384] != 0 {
                bad += 1
            }
        }
        total += bad
    }
    total
}

fn main() {
    let keep = spread(24)
    let total = refill(24)
    print(total)
    var sum = 0
    for i in 0..keep.len {
        sum += i64(keep[i][0])
    }
    print(sum)
}
