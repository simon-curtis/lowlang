struct Grid {
    rows: u8[][]
    names: [str: str[]]
    nodes: *Node[]
}

struct Node {
    value: i64
}

struct Box[T] {
    items: T[]
}

fn total(xs: i64[]) -> i64 {
    var sum = 0
    for x in xs {
        sum += x
    }
    sum
}

fn first(words: str[]?) -> str {
    var ws = words ?? return "none"
    ws.pop() ?? "empty"
}

fn drain(mut queue: str[]) -> i64 {
    var n = 0
    for {
        queue.pop() ?? break
        n += 1
    }
    n
}

fn pick[T](xs: T[], i: i64) -> T {
    xs[i]
}

fn main() {
    var xs: i64[] = [1, 2, 3]
    xs.push(4)
    print(total(xs))
    print(xs.pop() ?? 0)
    xs.truncate(1)
    print(xs.len)

    let old: i64[] = xs
    print(total(old))

    print(first(none))
    print(first(some([])))
    print(first(some(["low", "lang"])))

    var g = Grid { rows: [[1, 2], [3]], names: ["a": ["x", "y"]], nodes: [] }
    g.rows.push([4, 5, 6])
    g.rows[0].push(7)
    g.nodes.push(new(Node { value: 9 }))
    print(g.rows.len)
    print(g.rows[0].len)
    print(g.nodes[0].value)
    print((g.names["a"] ?? [])[1])

    var m: [str: i64] = ["k": 1, "j": 2]
    m.delete("k")
    print(m.len)

    var queue: str[] = ["build", "test"]
    print(queue.drain())
    print(queue.len)

    let b = Box[i64[]] { items: [[1], [2, 3]] }
    print(pick[i64[]](b.items, 1).len)
    let c: chan[u8[]] = chan[u8[]](1)
    c <- [1, 2]
    let got = <-c
    print((got ?? []).len)
}
