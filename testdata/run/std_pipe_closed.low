import std/io
import std/pipe

struct Sink {
    data: []u8
    closes: i64
    closed: chan[bool]
}

fn sink_stream(s: *Sink) -> io.Stream {
    io.Stream {
        read: fn(buf) -> i64 ! io.Error { 0 }
        write: fn(data) -> i64 ! io.Error {
            io.append(mut s.data, data)
            data.len
        }
        close: fn() {
            s.closes += 1
            s.closed <- true
        }
    }
}

fn leave_writer(handle: pipe.WriterHandle) {
    using w = pipe.adopt_writer(handle)
    pipe.write(w, bytes("abc"))
}

fn leave_reader(handle: pipe.ReaderHandle) {
    using r = pipe.adopt_reader(handle)
}

fn writer_dropped_completes() {
    using p = pipe.pipe(pipe.Options {})
    leave_writer(p.writer.handle)
    let result = pipe.read(p.reader) catch {
        _ => return
    }
    print("after writer drop: length {pipe.length(result.buffer)} completed {result.completed}")
}

fn reader_dropped_releases_writer() {
    using p = pipe.pipe(pipe.Options { pause: 16, resume: 8, segment_size: 16 })
    let wh = p.writer.handle
    let outcome = chan[bool](1)
    spawn fn() {
        var completed = false
        for i in 0..1000 {
            if !completed {
                completed = pipe.write_and_flush_on(wh, bytes("0123456789")).completed
            }
        }
        outcome <- completed
    }()
    sleep(20)
    leave_reader(p.reader.handle)
    print("writer released after reader drop: {(<-outcome) ?? false}")
}

fn explicit_then_scope() {
    using p = pipe.pipe(pipe.Options {})
    pipe.write(p.writer, bytes("hello"))
    pipe.flush(p.writer)
    pipe.complete_writer(p.writer)
    pipe.complete_writer(p.writer)
    let first = pipe.read(p.reader) catch {
        _ => return
    }
    print("before reader complete: length {pipe.length(first.buffer)} completed {first.completed}")
    pipe.complete_reader(p.reader)
    pipe.complete_reader(p.reader)
    let polled = pipe.try_read(p.reader)
    match polled {
        some(_) => print("try_read after complete: data")
        none => print("try_read after complete: none")
    }
    let after = pipe.read(p.reader) catch {
        NotConnected => {
            print("read after complete: not connected")
            return
        }
        _ => return
    }
    print("read after complete: {pipe.length(after.buffer)}")
}

fn writer_after_complete() {
    using p = pipe.pipe(pipe.Options {})
    pipe.write(p.writer, bytes("kept"))
    pipe.complete_writer(p.writer)
    pipe.write(p.writer, bytes("ignored"))
    pipe.fail_writer(p.writer, Reset)
    let flushed = pipe.flush(p.writer)
    print("flush after complete: {flushed.completed}")
    let result = pipe.read(p.reader) catch {
        _ => return
    }
    print("reader sees {str(pipe.to_bytes(result.buffer))} completed {result.completed}")
}

fn blocked_read_released() {
    using p = pipe.pipe(pipe.Options {})
    let rh = p.reader.handle
    let outcome = chan[str](1)
    spawn fn() {
        let r = pipe.read_on(rh) catch {
            NotConnected => {
                outcome <- "blocked read released"
                return
            }
            _ => {
                outcome <- "other error"
                return
            }
        }
        outcome <- "read {pipe.length(r.buffer)}"
    }()
    sleep(20)
    pipe.complete_reader_on(rh)
    print((<-outcome) ?? "")
}

fn wait_closed(s: *Sink) {
    <-s.closed
}

fn send_and_leave(s: *Sink) {
    using w = pipe.to_stream(sink_stream(s), pipe.Options {})
    pipe.write(w, bytes("hello "))
    pipe.write(w, bytes("world"))
    pipe.flush(w)
}

fn to_stream_delivers_then_closes() {
    let s = new(Sink { data: [], closes: 0, closed: chan[bool](4) })
    send_and_leave(s)
    wait_closed(s)
    print("to_stream wrote {str(s.data)} closes {s.closes}")
}

fn to_stream_failure_closes() {
    let s = new(Sink { data: [], closes: 0, closed: chan[bool](4) })
    using w = pipe.to_stream(sink_stream(s), pipe.Options {})
    pipe.fail_writer(w, Reset)
    wait_closed(s)
    print("to_stream failed closes {s.closes}")
}

fn main() {
    writer_dropped_completes()
    reader_dropped_releases_writer()
    explicit_then_scope()
    writer_after_complete()
    blocked_read_released()
    to_stream_delivers_then_closes()
    to_stream_failure_closes()
}
