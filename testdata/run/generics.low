struct Stack[T] {
    items: []T
}

struct Pair[A, B] {
    first: A
    second: B
}

enum Tree[T: Ord] {
    Node(*Tree[T], T, *Tree[T])
    Leaf
}

fn max[T: Ord](a: T, b: T) -> T {
    if a > b { a } else { b }
}

fn sum[T: Number](xs: []T) -> T {
    var total: T = 0
    for x in xs {
        total += x
    }
    total
}

fn push_all[T](mut s: Stack[T], xs: []T) {
    for x in xs {
        push(mut s.items, x)
    }
}

fn pop[T](mut s: Stack[T]) -> T? {
    if s.items.len == 0 {
        return none
    }
    let last = s.items[s.items.len - 1]
    s.items = s.items[0..s.items.len - 1]
    last
}

fn map[T, U](xs: []T, f: fn(T) -> U) -> []U {
    var out: []U = []
    for x in xs {
        push(mut out, f(x))
    }
    out
}

fn insert[T: Ord](t: Tree[T], v: T) -> Tree[T] {
    match t {
        Node(l, x, r) => {
            if v < x {
                return Node(new(insert(*l, v)), x, r)
            }
            Node(l, x, new(insert(*r, v)))
        }
        Leaf => Node(new(Tree.Leaf), v, new(Tree.Leaf))
    }
}

fn walk[T: Ord](t: Tree[T], mut out: []T) {
    match t {
        Node(l, x, r) => {
            walk(*l, mut out)
            push(mut out, x)
            walk(*r, mut out)
        }
        Leaf => {}
    }
}

fn swap[A, B](p: Pair[A, B]) -> Pair[B, A] {
    Pair { first: p.second, second: p.first }
}

fn count[K: Hash](xs: []K) -> [K: i64] {
    var counts: [K: i64] = [:]
    for x in xs {
        counts[x] += 1
    }
    counts
}

fn convert[T: Number](x: i64) -> T {
    T(x)
}

fn zero[T: Number]() -> T {
    0
}

fn depth[T](n: i64, value: T) -> i64 {
    if n == 0 {
        return 0
    }
    1 + depth(n - 1, value)
}

fn main() {
    print(max(3, 9))
    print(max(2.5, -1.0))
    print(max[u8](200, 100))
    print(sum([1, 2, 3, 4]))
    print(sum([0.5, 0.25]))

    var s = Stack[str] { items: [] }
    push_all(mut s, ["a", "b", "c"])
    print(pop(mut s) ?? "empty")
    print(s.items.len)

    let lengths = map(["one", "three"], fn(x: str) -> i64 { x.len })
    print(lengths[1])

    var t: Tree[i64] = Leaf
    for v in [5, 2, 8, 1, 9, 3] {
        t = insert(t, v)
    }
    var sorted: []i64 = []
    walk(t, mut sorted)
    print("{sorted[0]} {sorted[1]} {sorted[5]}")

    let p = swap(Pair { first: 1, second: "x" })
    print(p.first)
    print(p.second)

    let c = count(["a", "b", "a"])
    print(c["a"] ?? 0)
    let bytes = count([1, 1, 2, 1])
    print(bytes[1] ?? 0)

    let f: f64 = convert(7)
    print(f)
    let pick: fn(i64, i64) -> i64 = max
    print(pick(4, 6))
    let empty: Stack[i64] = Stack { items: [] }
    print(empty.items.len)
    let z: u16 = zero()
    print(z)
    print(depth(10, "deep"))

    var big: [i64: Pair[i64, str]] = [:]
    for i in 0..5000 {
        big[i] = Pair { first: i * 2, second: "v{i}" }
    }
    delete(mut big, 7)
    print(big.len)
    print((big[4999] ?? Pair { first: 0, second: "" }).second)
}
