fn walk(limit: i64, start: i64) -> i64 {
    var xs: []u8 = []
    for i in 0..limit {
        push(mut xs, u8(0))
    }
    var count = 0
    var j = start
    for j < limit {
        xs[j] = 1
        count += 1
        j += 1
    }
    count
}

fn main() {
    print(walk(0, 0))
    print(walk(5, 3))
    print(walk(5, 0))
    print(walk(5, -1))
}
