struct Pad8 {
    a: i64 = 0
    b: i64 = 0
    c: i64 = 0
    d: i64 = 0
    e: i64 = 0
    f: i64 = 0
    g: i64 = 0
    h: i64 = 0
}

struct Pad64 {
    a: Pad8 = Pad8 {}
    b: Pad8 = Pad8 {}
    c: Pad8 = Pad8 {}
    d: Pad8 = Pad8 {}
    e: Pad8 = Pad8 {}
    f: Pad8 = Pad8 {}
    g: Pad8 = Pad8 {}
    h: Pad8 = Pad8 {}
}

struct Pad512 {
    a: Pad64 = Pad64 {}
    b: Pad64 = Pad64 {}
    c: Pad64 = Pad64 {}
    d: Pad64 = Pad64 {}
    e: Pad64 = Pad64 {}
    f: Pad64 = Pad64 {}
    g: Pad64 = Pad64 {}
    h: Pad64 = Pad64 {}
}

fn dive(n: i64, pad: Pad512, m0: Pad64, m1: Pad64, m2: Pad64, m3: Pad64, m4: Pad64) -> i64 {
    if n == 0 {
        return pad.a.a.a
    }
    var next = pad
    next.a.a.a += n
    next.h.h.h = n
    dive(n - 1, next, m0, m1, m2, m3, m4) + next.h.h.h
}

fn run(out: chan[i64], depth: i64) {
    out <- dive(depth, Pad512 {}, Pad64 {}, Pad64 {}, Pad64 {}, Pad64 {}, Pad64 {})
}

fn main() {
    print("start")
    let out = chan[i64](1)
    spawn run(out, 1000000)
    print((<-out) ?? 0)
}
