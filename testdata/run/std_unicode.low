import std/text
import std/unicode

fn codes(s: str) -> str {
    var parts: []str = []
    for c in s {
        push(mut parts, text.hex(i64(c)))
    }
    parts |> text.join(" ")
}

fn build(cs: []u32) -> str {
    var out: []u8 = []
    for c in cs {
        text.append_char(mut out, c)
    }
    str(out)
}

fn show(label: str, s: str) {
    print("  {label}: {s} [{codes(s)}]")
}

fn report(s: str) {
    print("input: {s} [{codes(s)}]")
    show("nfd", unicode.nfd(s))
    show("nfkd", unicode.nfkd(s))
    show("nfc", unicode.nfc(s))
    show("nfkc", unicode.nfkc(s))
    show("casefold", unicode.casefold(s))
    show("search_key", unicode.search_key(s))
}

fn main() {
    let inputs = [
        "Ångström",
        "Müller",
        "José",
        "ﬁnance ﬀ",
        "①②③ ⑩",
        "Ｆｕｌｌ ｗｉｄｔｈ ＡＢＣ１２３",
        "Straße STRASSE",
        "한국어 가각",
        build([0x1100, 0x1161, 0x11A8]),
        build(['q', 0x307, 0x323]),
        build(['a', 0x301, 0x316, 0x328]),
        "Ἀθήνα ΆΈΉΊΌΎΏ ΐ ΰ",
        "😀 👍🏽 👨‍👩‍👧",
        build([0x1E9B, 0x323]),
        build([0x2126, ' ', 0x212B]),
        "℡ ㍿ Ǆ ﬆ",
        "ΣΑΣ İ ﬃ ŉ",
        "",
        "plain ascii MIXED",
    ]
    for s in inputs {
        report(s)
    }
    let probes: []u32 = [0x41, 0x301, 0x316, 0x328, 0x5B0, 0x3099, 0x1D16D, 0x1F600]
    for c in probes {
        print("ccc {text.hex(i64(c))}: {unicode.combining_class(c)}")
    }
}
