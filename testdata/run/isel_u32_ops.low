fn add(a: u32, b: u32) -> u32 {
    a + b
}

fn add_const(a: u32) -> u32 {
    a + 4000000000
}

fn sub(a: u32, b: u32) -> u32 {
    a - b
}

fn sub_const(a: u32) -> u32 {
    a - 3000000000
}

fn mul(a: u32, b: u32) -> u32 {
    a * b
}

fn mul_const(a: u32) -> u32 {
    a * 2654435761
}

fn neg(a: u32) -> u32 {
    0 - a
}

fn shl_const(a: u32) -> u32 {
    a << 13
}

fn shl_var(a: u32, k: u32) -> u32 {
    a << k
}

fn shr_const(a: u32) -> u32 {
    a >> 7
}

fn sar_const(a: i32) -> i32 {
    a >> 7
}

fn xor_mix(a: u32, b: u32) -> u32 {
    (a ^ b) & 4042322160 | (a & b)
}

fn widen_sum(a: u32, b: u32) -> u64 {
    u64(a) + u64(b)
}

fn widen_signed(a: i32, b: u32) -> i64 {
    i64(a) + i64(b)
}

fn narrow_then_widen(a: u64) -> u64 {
    u64(u32(a))
}

fn chain(a: u32, b: u32) -> u32 {
    ((a + b) * 31 - (a << 5)) ^ (b >> 3)
}

fn compare_wrapped(a: u32, b: u32) -> bool {
    a + b < a
}

fn index_after_wrap(xs: []i64, a: u32, b: u32) -> i64 {
    xs[i64(a + b) % xs.len]
}

fn digest(a: u32, b: u32) -> u64 {
    var total: u64 = 0
    total += u64(add(a, b))
    total += u64(add_const(a)) * 3
    total += u64(sub(a, b)) * 5
    total += u64(sub_const(a)) * 7
    total += u64(mul(a, b)) * 11
    total += u64(mul_const(a)) * 13
    total += u64(neg(a)) * 17
    total += u64(shl_const(a)) * 19
    total += u64(shl_var(a, b % 32)) * 23
    total += u64(shr_const(a)) * 29
    total += u64(i64(sar_const(i32(a)))) * 31
    total += u64(xor_mix(a, b)) * 37
    total += widen_sum(a, b) * 41
    total += u64(widen_signed(i32(a), b)) * 43
    total += narrow_then_widen(u64(a) * u64(b)) * 47
    total += u64(chain(a, b)) * 53
    if compare_wrapped(a, b) {
        total += 59
    }
    total
}

fn main() {
    let values: []u32 = [0, 1, 2, 3, 255, 65535, 65536, 2147483647, 2147483648, 2147483649, 3000000000, 4000000000, 4294967294, 4294967295, 305419896]
    let table: []i64 = [10, 20, 30, 40, 50, 60, 70]
    for a in values {
        var line: u64 = 0
        for b in values {
            line += digest(a, b) % 1000000007
            line += u64(index_after_wrap(table, a, b))
        }
        print(i64(line))
    }
}
