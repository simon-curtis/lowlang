import std/file
import std/io
import std/os
import std/process
import std/sys
import std/text

fn describe(e: process.Exit) -> str {
    match e {
        Exited(code) => "exited {code}"
        Signaled(_) => "signaled"
    }
}

fn child(mode: str) ! io.Error {
    match mode {
        "filter" => {
            let input = io.read_all(sys.stream(0))?
            sys.write_all(1, input)?
            sys.write_all(2, bytes("err\n"))?
            os.exit(3)
        }
        "env" => {
            print(os.env("GREETING") ?? "")
            print(os.getcwd()?)
        }
        "hidden" => print("hidden")
        _ => sleep(30000)
    }
}

fn environment(greeting: str) -> [str: str] {
    let env = ["GREETING": greeting]
    for name in ["SystemRoot", "SYSTEMROOT"] {
        match os.env(name) {
            some(value) => { env[name] = value }
            none => {}
        }
    }
    env
}

fn main() ! io.Error {
    let args = os.args()
    if args.len > 1 {
        child(args[1])?
        return
    }
    let program = os.executable()?
    print(process.find(program) != none)
    print(process.find("no-such-program-here") == none)

    let echoed = process.run(process.command(program, ["filter"]), bytes("piped input"))?
    print(str(echoed.stdout))
    print(text_of(echoed.stderr))
    print(describe(echoed.status))
    print(process.success(echoed.status))

    let dir = file.temp_dir("low-std-process-")?
    let env = process.run(process.Command { program, args: ["env"], env: some(environment("hello ")), dir }, [])?
    let lines = text.lines(str(env.stdout))
    print("{lines[0]}|")
    print(text.ends_with(lines[1], dir[dir.len - 10..]))

    using sleeper = process.start(process.Command { program, args: ["sleep"], group: true })?
    process.kill(sleeper, Terminate)?
    print(!process.success(process.wait(sleeper)?))
    print(!process.success(process.wait(sleeper)?))

    using silent = process.start(process.Command { program, args: ["hidden"], stdout: Null })?
    print(describe(process.wait(silent)?))

    let script = "{dir}/not-a-program.exe"
    file.write_text(script, "not a program")?
    file.chmod(script, 0o755)?
    print(start_outcome(script))

    let lock_path = "{dir}/lock"
    using first = file.create(lock_path)?
    using second = file.open(lock_path)?
    print(file.try_lock(first, true)?)
    print(file.try_lock(second, true)?)
    file.unlock(first)?
    print(file.try_lock(second, true)?)
    file.close(first)
    file.close(second)
    file.remove_all(dir)?

    using missing = process.start(process.command("no-such-program-here", [])) catch {
        NotFound => {
            print("not found")
            return
        }
        _ => return
    }
    print(missing.handle.pid)
}

fn start_outcome(path: str) -> str {
    using child = process.start(process.command(path, [])) catch {
        Os(_) => return "exec failed"
        _ => return "other error"
    }
    "started {child.handle.pid > 0}"
}

fn text_of(b: u8[]) -> str {
    if b.len > 0 && b[b.len - 1] == '\n' {
        return str(b[..b.len - 1])
    }
    str(b)
}
