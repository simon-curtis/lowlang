import std/file
import std/io
import std/process

fn describe(e: process.Exit) -> str {
    match e {
        Exited(code) => "exited {code}"
        Signaled(signal) => "signaled {signal}"
    }
}

fn main() ! io.Error {
    print(process.find("sh") != none)
    print(process.find("no-such-program-here") == none)

    let echoed = process.run(process.command("sh", ["-c", "cat; echo err >&2; exit 3"]), bytes("piped input"))?
    print(str(echoed.stdout))
    print(text_of(echoed.stderr))
    print(describe(echoed.status))
    print(process.success(echoed.status))

    let env = process.run(process.Command { program: "sh", args: ["-c", "printf %s \"$GREETING\"; pwd"], env: some(["GREETING": "hello "]), dir: "/" }, [])?
    print(str(env.stdout))

    using sleeper = process.start(process.Command { program: "sleep", args: ["30"], group: true })?
    process.kill(sleeper, 15)?
    print(describe(process.wait(sleeper)?))
    print(describe(process.wait(sleeper)?))

    using silent = process.start(process.Command { program: "sh", args: ["-c", "echo hidden"], stdout: Null })?
    print(describe(process.wait(silent)?))

    let script = "/tmp/low-std-process-noexec"
    file.write_text(script, "not a program")?
    process.run(process.command("chmod", ["+x", script]), [])?
    print(start_outcome(script))

    let lock_path = "/tmp/low-std-process-lock"
    using first = file.create(lock_path)?
    using second = file.open(lock_path)?
    print(file.try_lock(first, true)?)
    print(file.try_lock(second, true)?)
    file.unlock(first)?
    print(file.try_lock(second, true)?)
    file.close(first)
    file.close(second)
    file.remove(lock_path)?
    file.remove(script)?

    using missing = process.start(process.command("no-such-program-here", [])) catch {
        NotFound => {
            print("not found")
            return
        }
        _ => return
    }
    print(missing.handle.pid)
}

fn start_outcome(path: str) -> str {
    using child = process.start(process.command(path, [])) catch {
        Os(code) => return "exec failed {code}"
        _ => return "other error"
    }
    "started {child.handle.pid > 0}"
}

fn text_of(b: []u8) -> str {
    if b.len > 0 && b[b.len - 1] == '\n' {
        return str(b[..b.len - 1])
    }
    str(b)
}
