import std/io
import std/net
import std/slices

fn has_address(i: net.Interface, ip: str, prefix: i64) -> bool {
    i.addresses.any(fn(a) net.format_ip(a.ip) == ip && a.prefix == prefix)
}

fn main() ! io.Error {
    let found = net.interfaces()?
    print(found.len > 0)

    var loopbacks = 0
    var loopback_up = false
    var loopback_v4 = false
    var loopback_v6 = false
    var any_v6 = false
    var prefixes_ok = true
    var addresses_ok = true
    var names_ok = true
    var indices_ok = true
    var seen: i64[] = []
    for i in found {
        if i.name.len == 0 {
            names_ok = false
        }
        if i.index <= 0 || seen.contains(i.index) {
            indices_ok = false
        }
        seen.push(i.index)
        if i.loopback {
            loopbacks += 1
            loopback_up = loopback_up || i.up
            loopback_v4 = loopback_v4 || has_address(i, "127.0.0.1", 8)
            loopback_v6 = loopback_v6 || has_address(i, "::1", 128)
        }
        for a in i.addresses {
            let limit = match a.ip.len {
                4 => 32
                16 => 128
                _ => -1
            }
            if limit < 0 {
                addresses_ok = false
            }
            if a.prefix < 0 || a.prefix > limit {
                prefixes_ok = false
            }
            if a.ip.len == 16 {
                any_v6 = true
            }
        }
    }
    print(loopbacks > 0)
    print(loopback_up)
    print(loopback_v4)
    print(!any_v6 || loopback_v6)
    print(addresses_ok)
    print(prefixes_ok)
    print(names_ok)
    print(indices_ok)
}
