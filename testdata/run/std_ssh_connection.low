import std/crypto
import std/crypto/x509
import std/io
import std/net
import std/ssh
import std/ssh/key
import std/text

struct Seen {
    term: str
    columns: i64
    rows: i64
    env: str
}

fn error_name(e: ssh.Error) -> str {
    match e {
        Io(_) => "Io"
        Key(_) => "Key"
        Malformed => "Malformed"
        Protocol => "Protocol"
        BadVersion => "BadVersion"
        NoCommonAlgorithm(_) => "NoCommonAlgorithm"
        KeyExchange => "KeyExchange"
        HostKeyRejected => "HostKeyRejected"
        BadSignature => "BadSignature"
        MacFailed => "MacFailed"
        TooLarge => "TooLarge"
        StrictKex => "StrictKex"
        Disconnected(_, _) => "Disconnected"
        AuthFailed => "AuthFailed"
        Closed => "Closed"
        ChannelRefused(_, _) => "ChannelRefused"
        RequestRefused => "RequestRefused"
        Invalid => "Invalid"
        Unsupported => "Unsupported"
        TimedOut => "TimedOut"
    }
}

fn read_all(h: *ssh.ChannelHandle) -> u8[] {
    var all: u8[] = []
    let buf = io.buffer(4096)
    for {
        let n = ssh.read_on(h, buf) catch {
            e => return all
        }
        if n == 0 {
            return all
        }
        io.append(mut all, buf[..n])
    }
    all
}

fn run_command(h: *ssh.ChannelHandle, command: str, seen: Seen) {
    if command == "echo hello" {
        ssh.write_on(h, bytes("hello\n")) or return
        ssh.send_exit_status_on(h, 0) or return
    }
    if command == "fail" {
        ssh.write_stderr_on(h, bytes("boom")) or return
        ssh.send_exit_status_on(h, 3) or return
    }
    if command == "upper" {
        let input = read_all(h)
        ssh.write_on(h, bytes(text.upper(str(input)))) or return
        ssh.send_exit_status_on(h, 0) or return
    }
    if command == "big" {
        let block = io.buffer(65536)
        for i in 0..48 {
            ssh.write_on(h, block) or return
        }
        ssh.send_exit_status_on(h, 0) or return
    }
    if command == "signal" {
        ssh.send_exit_signal_on(h, "KILL", false, "killed") or return
    }
    if command == "report" {
        ssh.write_on(h, bytes("{seen.term} {seen.columns}x{seen.rows} {seen.env}")) or return
        ssh.send_exit_status_on(h, 0) or return
    }
    ssh.close_write_on(h) or return
}

fn handle_session(inc: ssh.Incoming) {
    using ch = ssh.accept(inc) or return
    var seen = Seen { term: "", columns: 0, rows: 0, env: "" }
    for {
        let next = ssh.next_request_on(ch.handle)
        let req = match next {
            some(r) => r
            none => return
        }
        if req.kind == "pty-req" {
            let pty = ssh.parse_pty(req) or return
            seen.term = pty.term
            seen.columns = pty.columns
            seen.rows = pty.rows
            ssh.answer_on(ch.handle, req, true) or return
            continue
        }
        if req.kind == "env" {
            let e = ssh.parse_env(req) or return
            seen.env = "{seen.env}{e.name}={e.value};"
            ssh.answer_on(ch.handle, req, true) or return
            continue
        }
        if req.kind == "window-change" {
            let size = ssh.parse_window_change(req) or return
            seen.columns = size[0]
            seen.rows = size[1]
            continue
        }
        if req.kind == "exec" {
            let command = ssh.parse_exec(req) or return
            ssh.answer_on(ch.handle, req, true) or return
            run_command(ch.handle, command, seen)
            return
        }
        ssh.answer_on(ch.handle, req, false) or return
    }
}

fn handle_channel(inc: ssh.Incoming) {
    if inc.kind == "session" {
        handle_session(inc)
        return
    }
    if inc.kind == "direct-tcpip" {
        ssh.serve_direct_tcpip(inc)
        return
    }
    ssh.reject(inc, 3, "unknown channel type")
}

fn serve_one(stream: io.Stream, config: ssh.ServerConfig, report: chan[str]) {
    using conn = ssh.serve_stream(stream, config) catch {
        e => {
            report <- error_name(e)
            return
        }
    }
    report <- "ok"
    ssh.wait_on(conn.handle)
}

fn host_signer() -> key.Signer {
    key.signer(x509.PrivateKey.Ed25519(crypto.random(32))) or panic("host key")
}

fn password_server(auth: ssh.ServerAuth, host: key.Signer) -> ssh.ServerConfig {
    ssh.ServerConfig { host_keys: [host], auth, channels: handle_channel, global: ssh.forward_global }
}

fn password_auth() -> ssh.ServerAuth {
    ssh.ServerAuth { methods: ["password"], password: fn(user, password) { user == "alice" && password == "secret" } }
}

fn client_with(auth: ssh.AuthMethod[]) -> ssh.ClientConfig {
    ssh.ClientConfig { user: "alice", verify_host_key: ssh.accept_any_host_key(), auth }
}

fn outcome(config: ssh.ClientConfig, server: ssh.ServerConfig) -> str {
    using ends = net.socketpair() or panic("socketpair")
    let report = chan[str](1)
    spawn serve_one(net.stream(ends.second), server, report)
    using conn = ssh.client(net.stream(ends.first), config) catch {
        e => return error_name(e)
    }
    let result = ssh.exec(conn, "echo hello") or panic("exec")
    "ok {str(result.stdout)}"
}

fn connect_pair(config: ssh.ClientConfig, server: ssh.ServerConfig, ends: net.ConnPair) -> ssh.Connection {
    let report = chan[str](1)
    spawn serve_one(net.stream(ends.second), server, report)
    ssh.client(net.stream(ends.first), config) or panic("client")
}

fn authentication() {
    let host = host_signer()
    print("password: {outcome(client_with([ssh.AuthMethod.Password("secret")]), password_server(password_auth(), host))}")
    print("wrong password: {outcome(client_with([ssh.AuthMethod.Password("nope")]), password_server(password_auth(), host))}")
    print("retry: {outcome(client_with([ssh.AuthMethod.Password("nope"), ssh.AuthMethod.Password("secret")]), password_server(password_auth(), host))}")
    print("none refused: {outcome(client_with([ssh.AuthMethod.NoAuth]), password_server(password_auth(), host))}")
    print("none accepted: {outcome(client_with([]), password_server(ssh.ServerAuth { methods: ["none"] }, host))}")
    let user = key.signer(x509.PrivateKey.Ed25519(crypto.random(32))) or panic("user key")
    let by_key = ssh.ServerAuth { methods: ["publickey"], public_key: fn(name, k) { key.equal(k, user.public) } }
    print("publickey: {outcome(client_with([ssh.AuthMethod.PublicKey(user)]), password_server(by_key, host))}")
    let stranger = key.signer(x509.PrivateKey.Ed25519(crypto.random(32))) or panic("stranger")
    print("unlisted key: {outcome(client_with([ssh.AuthMethod.PublicKey(stranger)]), password_server(by_key, host))}")
    let interactive = ssh.ServerAuth {
        methods: ["keyboard-interactive"]
        keyboard_interactive: fn(name, ask) {
            let answers = ask("login", "enter the pin", [ssh.Prompt { text: "pin", echo: false }])
            answers.len == 1 && answers[0] == "1234"
        }
    }
    let right = ssh.AuthMethod.KeyboardInteractive(fn(name, instruction, prompts) { ["1234"] })
    let wrong = ssh.AuthMethod.KeyboardInteractive(fn(name, instruction, prompts) { ["0000"] })
    print("keyboard-interactive: {outcome(client_with([right]), password_server(interactive, host))}")
    print("wrong pin: {outcome(client_with([wrong]), password_server(interactive, host))}")
    let both = ssh.ServerAuth {
        methods: ["publickey", "password"]
        required: ["publickey", "password"]
        public_key: fn(name, k) { key.equal(k, user.public) }
        password: fn(name, password) { password == "secret" }
    }
    print("key then password: {outcome(client_with([ssh.AuthMethod.PublicKey(user), ssh.AuthMethod.Password("secret")]), password_server(both, host))}")
    print("password then key: {outcome(client_with([ssh.AuthMethod.Password("secret"), ssh.AuthMethod.PublicKey(user)]), password_server(both, host))}")
    print("one of two: {outcome(client_with([ssh.AuthMethod.Password("secret")]), password_server(both, host))}")
    let limited = ssh.ServerAuth { methods: ["password"], max_attempts: 2, password: fn(name, password) { false } }
    let guesses = [ssh.AuthMethod.Password("a"), ssh.AuthMethod.Password("b"), ssh.AuthMethod.Password("c")]
    print("attempt limit: {outcome(client_with(guesses), password_server(limited, host))}")
    let greeting = chan[str](2)
    let banner = ssh.ClientConfig {
        user: "alice"
        verify_host_key: ssh.accept_any_host_key()
        auth: [ssh.AuthMethod.Password("secret")]
        banner: fn(shown) { greeting <- shown }
    }
    let welcoming = ssh.ServerAuth { methods: ["password"], banner: "welcome", password: fn(name, password) { password == "secret" } }
    print("banner connection: {outcome(banner, password_server(welcoming, host))}")
    print("banner: {<-greeting ?? ""}")
}

fn host_keys() {
    let host = host_signer()
    let rejecting = ssh.ClientConfig { user: "alice", verify_host_key: fn(k) { false }, auth: [ssh.AuthMethod.Password("secret")] }
    print("rejected host key: {outcome(rejecting, password_server(password_auth(), host))}")
    let forged = key.Signer { public: host.public, sign: fn(algorithm, data) { host.sign(algorithm, bytes("not the exchange hash")) } }
    print("forged signature: {outcome(client_with([ssh.AuthMethod.Password("secret")]), password_server(password_auth(), forged))}")
    let narrow = ssh.ClientConfig {
        user: "alice"
        verify_host_key: ssh.accept_any_host_key()
        auth: [ssh.AuthMethod.Password("secret")]
        algorithms: ssh.Algorithms { host_keys: ["ecdsa-sha2-nistp256"] }
    }
    print("no common host key: {outcome(narrow, password_server(password_auth(), host))}")
    print("defaults: {text.join(ssh.default_kex(), ",")}")
    print("host keys: {text.join(ssh.default_host_keys(), ",")}")
    print("ciphers: {text.join(ssh.default_ciphers(), ",")}")
    print("macs: {text.join(ssh.default_macs(), ",")}")
}

fn subsystem_failure(h: *ssh.ChannelHandle) -> str {
    ssh.subsystem_on(h, "nothing") catch {
        e => return error_name(e)
    }
    "accepted"
}

fn sessions() {
    using ends = net.socketpair() or panic("socketpair")
    using conn = connect_pair(client_with([ssh.AuthMethod.Password("secret")]), password_server(password_auth(), host_signer()), ends)
    let result = ssh.exec(conn, "fail") or panic("exec")
    print("exec: {str(result.stdout)}|{str(result.stderr)}|{result.status.code}")
    using ch = ssh.open_session(conn) or panic("session")
    ssh.pty_on(ch.handle, ssh.Pty { term: "xterm", columns: 80, rows: 24 }) or panic("pty")
    ssh.env_on(ch.handle, "LANG", "C") or panic("env")
    ssh.window_change_on(ch.handle, 100, 40, 0, 0) or panic("window change")
    ssh.exec_on(ch.handle, "report") or panic("exec")
    print("report: {str(read_all(ch.handle))} {ssh.wait_exit_on(ch.handle).code}")
    using signalled = ssh.open_session(conn) or panic("session")
    ssh.exec_on(signalled.handle, "signal") or panic("exec")
    let status = ssh.wait_exit_on(signalled.handle)
    print("exit signal: {status.signal} {status.exited}")
    using half = ssh.open_session(conn) or panic("session")
    ssh.exec_on(half.handle, "upper") or panic("exec")
    ssh.write_on(half.handle, bytes("hello world")) or panic("write")
    ssh.close_write_on(half.handle) or panic("close write")
    print("half close: {str(read_all(half.handle))}")
    using refused = ssh.open_session(conn) or panic("session")
    print("unknown subsystem: {subsystem_failure(refused.handle)}")
    ssh.keepalive(conn) or panic("keepalive")
    print("key exchanges: {ssh.key_exchanges(conn.handle)}")
}

fn rekeying() {
    using ends = net.socketpair() or panic("socketpair")
    var client = client_with([ssh.AuthMethod.Password("secret")])
    client.rekey_bytes = 400000
    var server = password_server(password_auth(), host_signer())
    server.rekey_bytes = 400000
    using conn = connect_pair(client, server, ends)
    let result = ssh.exec(conn, "big") or panic("exec")
    print("transferred: {result.stdout.len}")
    print("rekeyed: {ssh.key_exchanges(conn.handle) >= 4}")
    let again = ssh.exec(conn, "echo hello") or panic("exec")
    print("after rekey: {str(again.stdout)}")
}

fn echo_loop(listener: net.ListenerHandle) {
    for {
        let h = net.accept_handle(listener) catch {
            e => return
        }
        spawn echo_one(h)
    }
}

fn echo_one(h: net.ConnHandle) {
    using tcp = net.adopt(h)
    let buf = io.buffer(4096)
    for {
        let n = net.read_on(h, buf) catch {
            e => return
        }
        if n == 0 {
            return
        }
        net.write_all_on(h, buf[..n]) catch {
            e => return
        }
    }
}

fn forwarding() {
    using ends = net.socketpair() or panic("socketpair")
    using conn = connect_pair(client_with([ssh.AuthMethod.Password("secret")]), password_server(password_auth(), host_signer()), ends)
    using echo = net.listen("127.0.0.1", 0) or panic("listen")
    spawn echo_loop(echo.handle)
    using forward = ssh.listen_local(conn, "127.0.0.1", 0, "127.0.0.1", echo.handle.addr.port) or panic("listen local")
    using tcp = net.dial("127.0.0.1", forward.port) or panic("dial")
    io.write_all(net.stream(tcp), bytes("through the tunnel")) or panic("write")
    let reader = io.reader(net.stream(tcp))
    let echoed = io.read_exact(reader, 18) or panic("read")
    print("local forward: {str(echoed)}")
    using direct = ssh.direct_tcpip(conn, "127.0.0.1", echo.handle.addr.port, "127.0.0.1", 1) or panic("direct")
    ssh.write_on(direct.handle, bytes("direct")) or panic("write")
    let buf = io.buffer(16)
    let n = ssh.read_on(direct.handle, buf) or panic("read")
    print("direct-tcpip: {str(buf[..n])}")
    let remote = ssh.listen_remote(conn, "127.0.0.1", 0) or panic("listen remote")
    using visitor = net.dial("127.0.0.1", remote.port) or panic("dial remote")
    using arrived = ssh.accept_forward(remote) or panic("accept forward")
    ssh.write_on(arrived.channel.handle, bytes("remote")) or panic("write")
    let visitor_reader = io.reader(net.stream(visitor))
    let seen = io.read_exact(visitor_reader, 6) or panic("read remote")
    print("remote forward: {str(seen)} {arrived.origin_host}")
    ssh.cancel_forward(remote) or panic("cancel")
}

fn main() {
    authentication()
    host_keys()
    sessions()
    rekeying()
    forwarding()
}
