import std/cancel
import std/io
import std/net

struct Seen {
    calls: []str
}

fn worker(t: *cancel.Token, results: chan[str]) {
    let outcome = select {
        <-cancel.done(t) => "worker stopped"
        after(5000) => "worker timed out"
    }
    results <- outcome
}

fn blocked_read(c: net.ConnHandle, results: chan[str]) {
    let buf = io.buffer(8)
    let n = net.read_on(c, buf) catch {
        NotConnected => -1
        _ => -2
    }
    results <- "read returned {n}"
}

fn checked(t: *cancel.Token) -> str {
    cancel.check(t) catch {
        Aborted => return "aborted"
        _ => return "other"
    }
    "running"
}

fn scoped(t: *cancel.Token, seen: *Seen) {
    using held = cancel.on_cancel(t, fn() { push(mut seen.calls, "scope exit callback") })
}

fn explicit_then_scope(t: *cancel.Token, seen: *Seen) {
    using held = cancel.on_cancel(t, fn() { push(mut seen.calls, "explicit release callback") })
    cancel.release(held)
    cancel.release(held)
}

fn view_release(t: *cancel.Token, seen: *Seen) {
    let view = cancel.on_cancel_handle(t, fn() { push(mut seen.calls, "view callback") })
    cancel.release_on(view)
    cancel.release_on(view)
}

fn kept_until_cancel(t: *cancel.Token, seen: *Seen) -> cancel.RegistrationHandle {
    cancel.on_cancel_handle(t, fn() { push(mut seen.calls, "unowned callback") })
}

fn main() ! io.Error {
    let seen = new(Seen { calls: [] })
    let parent = cancel.token()
    let child = cancel.child(parent)
    using kept = cancel.on_cancel(child, fn() { push(mut seen.calls, "child callback") })
    using dropped = cancel.on_cancel(parent, fn() { push(mut seen.calls, "released callback") })
    cancel.release(dropped)
    print(cancel.cancelled(child))
    print(cancel.pause(child, 1))

    let results = chan[str](4)
    spawn worker(child, results)

    using l = net.listen("127.0.0.1", 0)?
    using client = net.connect(l.handle.addr)?
    using server = net.accept(l)?
    let served = server.handle
    using closing = cancel.on_cancel(parent, fn() { net.close_on(served) })
    spawn blocked_read(served, results)
    sleep(20)

    cancel.cancel(parent)
    cancel.cancel(parent)
    let first = (<-results) ?? ""
    let second = (<-results) ?? ""
    print(if first < second { first } else { second })
    print(if first < second { second } else { first })
    print(cancel.cancelled(child))
    print(cancel.pause(child, 5000))
    print(checked(child))
    using late = cancel.on_cancel(child, fn() { push(mut seen.calls, "late callback") })
    for c in seen.calls {
        print(c)
    }
    cancel.release(kept)

    let probe = new(Seen { calls: [] })
    let lifetime = cancel.token()
    scoped(lifetime, probe)
    explicit_then_scope(lifetime, probe)
    view_release(lifetime, probe)
    kept_until_cancel(lifetime, probe)
    cancel.cancel(lifetime)
    print("probe {probe.calls.len}")
    for c in probe.calls {
        print(c)
    }
}
