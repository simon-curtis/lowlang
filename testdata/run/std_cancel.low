import std/cancel
import std/io
import std/net

struct Seen {
    calls: []str
}

fn worker(t: *cancel.Token, results: chan[str]) {
    let outcome = select {
        <-cancel.done(t) => "worker stopped"
        after(5000) => "worker timed out"
    }
    results <- outcome
}

fn blocked_read(c: net.Conn, results: chan[str]) {
    let buf = io.buffer(8)
    let n = net.read(c, buf) catch {
        NotConnected => -1
        _ => -2
    }
    results <- "read returned {n}"
}

fn checked(t: *cancel.Token) -> str {
    cancel.check(t) catch {
        Aborted => return "aborted"
        _ => return "other"
    }
    "running"
}

fn main() ! io.Error {
    let seen = new(Seen { calls: [] })
    let parent = cancel.token()
    let child = cancel.child(parent)
    let kept = cancel.on_cancel(child, fn() { push(mut seen.calls, "child callback") })
    let dropped = cancel.on_cancel(parent, fn() { push(mut seen.calls, "released callback") })
    cancel.release(dropped)
    print(cancel.cancelled(child))
    print(cancel.pause(child, 1))

    let results = chan[str](4)
    spawn worker(child, results)

    let l = net.listen("127.0.0.1", 0)?
    let client = net.connect(l.addr)?
    let server = net.accept(l)?
    cancel.on_cancel(parent, fn() { net.close(server) })
    spawn blocked_read(server, results)
    sleep(20)

    cancel.cancel(parent)
    cancel.cancel(parent)
    let first = (<-results) ?? ""
    let second = (<-results) ?? ""
    print(if first < second { first } else { second })
    print(if first < second { second } else { first })
    print(cancel.cancelled(child))
    print(cancel.pause(child, 5000))
    print(checked(child))
    cancel.on_cancel(child, fn() { push(mut seen.calls, "late callback") })
    for c in seen.calls {
        print(c)
    }
    cancel.release(kept)
    net.close(client)
    net.close_listener(l)
}
