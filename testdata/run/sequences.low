struct Point {
    x: i64
    y: i64
}

fn sum(xs: []i64) -> i64 {
    var total = 0
    for x in xs {
        total += x
    }
    total
}

fn fill(mut xs: []i64, n: i64) {
    for i in 0..n {
        push(mut xs, i * i)
    }
}

fn main() {
    let xs = [3, 1, 4, 1, 5]
    print(xs.len)
    print(xs[2])
    print(sum(xs))
    print(sum(xs[1..4]))
    print(sum(xs[..2]))
    print(sum(xs[3..]))

    var squares: []i64 = []
    fill(mut squares, 10)
    print(squares.len)
    print(squares[9])

    let shared = squares
    shared[0] = 100
    print(squares[0])

    var head = squares[0..2]
    push(mut head, -1)
    print(squares[2])
    print(head[2])

    var points: []Point = []
    push(mut points, Point { x: 1, y: 2 })
    push(mut points, Point { x: 3, y: 4 })
    points[1].y += 10
    var total = 0
    for i, p in points {
        total += i * 100 + p.x + p.y
    }
    print(total)

    var bytes: []u8 = []
    for i in 0..300 {
        push(mut bytes, u8(i))
    }
    print(bytes.len)
    print(bytes[299])

    for i in 0..10 {
        if i % 3 != 0 {
            continue
        }
        print(i)
    }

    let word = "héllo, 世界"
    print(word.len)
    var count = 0
    var last: u32 = 0
    for c in word {
        count += 1
        last = c
    }
    print(count)
    print(last)
    for i, c in "aé" {
        print("{i}:{c}")
    }
    print(word[0])
    print(word[0..5])

    let name = "Ada"
    let age = 36
    print("{name} is {age}, next year {age + 1}, {age > 30}")
    print("braces {{}} and pi {3.14159}")
    print(name + " Lovelace")
    print(name == "Ada")
    print(name != "Ada")
    print(str(bytes(name)) == name)

    print(0.1)
    print(1.0 / 3.0)
    print(100.0)
    print(1.5e-7)
    print(1.0e21)
    print(-0.0)
    print(2.0 * 1.0e308)
    print(sqrt(-1.0))
    let small: f32 = 0.1
    print(small)
    print(5.0e-324)
    print(1.7976931348623157e308)
    print(123456789.125)
}
