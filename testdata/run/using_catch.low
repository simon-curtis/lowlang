enum Failure {
    Bad
    Worse
}

struct Slot {
    n: i64
    drop print("release {n}")
}

fn check(n: i64) ! Failure {
    if n < 0 {
        fail Bad
    }
}

fn make(n: i64) -> Slot ! Failure {
    using s = Slot { n }
    check(n) catch {
        Bad => fail Worse
        _ => fail Bad
    }
    s
}

fn main() {
    using a = make(1) or Slot { n: 0 }
    using b = make(-1) or Slot { n: 9 }
    print("end {a.n} {b.n}")
}
