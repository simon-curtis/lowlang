import std/io
import std/net
import std/sql
import std/sql/postgres

fn describe(e: sql.Error) -> str {
    match e {
        Connect => "Connect"
        Authentication => "Authentication"
        Closed => "Closed"
        Timeout => "Timeout"
        Protocol => "Protocol"
        Unsupported => "Unsupported"
        Conversion => "Conversion"
        Busy => "Busy"
        Server(code, message) => "Server({code}, {message})"
    }
}

fn welcome() -> []u8 {
    var b: []u8 = []
    push(mut b, 'R')
    io.put_be32(mut b, 8)
    io.put_be32(mut b, 0)
    push(mut b, 'Z')
    io.put_be32(mut b, 5)
    push(mut b, 'I')
    b
}

fn serve(h: net.ListenerHandle, greet: bool, report: chan[str]) {
    let accepted = net.accept_handle(h) or return
    using peer = net.adopt(accepted)
    let buf = io.buffer(512)
    net.read(peer, buf) or return
    if !greet {
        report <- "server hung up"
        return
    }
    net.write_all(peer, welcome()) or return
    var tail = 0
    for {
        let got = net.read(peer, buf) or -1
        if got <= 0 {
            report <- "server saw {tail} bytes then end {got}"
            return
        }
        tail += got
    }
}

fn options(l: net.Listener) -> sql.Options {
    sql.Options { host: "127.0.0.1", port: l.handle.addr.port, user: "u", password: "p", timeout: 2000 }
}

fn explicit(l: net.Listener) {
    using db = postgres.connect(options(l)) catch {
        e => {
            print("connect {describe(e)}")
            return
        }
    }
    print("connected {db.handle.dialect.system == sql.postgres().system}")
    db.handle.close()
    db.handle.execute("SELECT 1", []) catch {
        e => {
            print("after close {describe(e)}")
            0
        }
    }
    db.handle.close()
    print("closed twice")
}

fn leave(l: net.Listener) {
    using db = postgres.connect(options(l)) catch {
        e => {
            print("connect {describe(e)}")
            return
        }
    }
    print("connected {db.handle.dialect.system == sql.postgres().system}")
}

fn silent(l: net.Listener) {
    using db = postgres.connect(options(l)) catch {
        e => {
            print("silent server {describe(e)}")
            return
        }
    }
    print("unexpected connect")
}

fn scenario(greet: bool, run: fn(net.Listener)) ! io.Error {
    using l = net.listen("127.0.0.1", 0)?
    let report = chan[str](1)
    let listening = l.handle
    spawn serve(listening, greet, report)
    run(l)
    print((<-report) ?? "")
}

fn main() ! io.Error {
    scenario(true, explicit)?
    scenario(true, leave)?
    scenario(false, silent)?
}
