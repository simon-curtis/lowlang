import std/io
import std/net
import std/sql
import std/sql/postgres

fn describe(e: sql.Error) -> str {
    match e {
        Connect => "Connect"
        Authentication => "Authentication"
        Closed => "Closed"
        Timeout => "Timeout"
        Protocol => "Protocol"
        Unsupported => "Unsupported"
        Conversion => "Conversion"
        Busy => "Busy"
        Cancelled => "Cancelled"
        Server(errors) => "Server({errors[0].code}, {errors[0].message})"
    }
}

fn welcome() -> u8[] {
    var b: u8[] = []
    b.push('R')
    io.put_be32(mut b, 8)
    io.put_be32(mut b, 0)
    b.push('Z')
    io.put_be32(mut b, 5)
    b.push('I')
    b
}

fn serve(h: net.ListenerHandle, greet: bool, report: chan[str]) {
    let accepted = net.accept_handle(h) or return
    using peer = net.adopt(accepted)
    let buf = io.buffer(512)
    net.read(peer, buf) or return
    if !greet {
        report <- "server hung up"
        return
    }
    net.write_all(peer, welcome()) or return
    var tail = 0
    for {
        let got = net.read(peer, buf) or -1
        if got <= 0 {
            report <- "server saw {tail} bytes then end {got}"
            return
        }
        tail += got
    }
}

fn options(l: net.Listener) -> sql.Options {
    sql.Options { host: "127.0.0.1", port: l.handle.addr.port, user: "u", password: "p", timeout: 2000 }
}

fn explicit(l: net.Listener) {
    using db = postgres.connect(options(l)) catch {
        e => {
            print("connect {describe(e)}")
            return
        }
    }
    print("connected {db.handle.dialect.system == sql.postgres().system}")
    db.handle.close()
    db.handle.execute("SELECT 1", []) catch {
        e => {
            print("after close {describe(e)}")
            0
        }
    }
    db.handle.close()
    print("closed twice")
}

fn leave(l: net.Listener) {
    using db = postgres.connect(options(l)) catch {
        e => {
            print("connect {describe(e)}")
            return
        }
    }
    print("connected {db.handle.dialect.system == sql.postgres().system}")
}

fn silent(l: net.Listener) {
    using db = postgres.connect(options(l)) catch {
        e => {
            print("silent server {describe(e)}")
            return
        }
    }
    print("unexpected connect")
}

fn scenario(greet: bool, run: fn(net.Listener)) ! io.Error {
    using l = net.listen("127.0.0.1", 0)?
    let report = chan[str](1)
    let listening = l.handle
    spawn serve(listening, greet, report)
    run(l)
    print((<-report) ?? "")
}

fn keyed_welcome() -> u8[] {
    [82, 0, 0, 0, 8, 0, 0, 0, 0, 75, 0, 0, 0, 12, 0, 0, 0, 99, 1, 2, 3, 4, 90, 0, 0, 0, 5, 73]
}

fn error_57014() -> u8[] {
    var body: u8[] = []
    for field in ["SERROR", "VERROR", "C57014", "Mcanceling statement due to user request"] {
        body.push(field[0])
        io.append(mut body, bytes(field[1..]))
        body.push(0)
    }
    body.push(0)
    var b: u8[] = []
    b.push('E')
    io.put_be32(mut b, body.len + 4)
    io.append(mut b, body)
    b.push('Z')
    io.put_be32(mut b, 5)
    b.push('I')
    b
}

fn completed() -> u8[] {
    var b: u8[] = []
    b.push('C')
    io.put_be32(mut b, 13)
    io.append(mut b, bytes("SELECT 1"))
    b.push(0)
    b.push('Z')
    io.put_be32(mut b, 5)
    b.push('I')
    b
}

fn serve_cancel(h: net.ListenerHandle, started: chan[bool], report: chan[str]) {
    let accepted = net.accept_handle(h) or return
    using peer = net.adopt(accepted)
    let buf = io.buffer(512)
    net.read(peer, buf) or return
    net.write_all(peer, keyed_welcome()) or return
    net.read(peer, buf) or return
    started <- true
    let side = net.accept_handle(h) or return
    using canceller = net.adopt(side)
    let got = net.read(canceller, buf) or return
    report <- "cancel request {got} bytes length {io.be32(buf, 0)} code {io.be32(buf, 4)} process {io.be32(buf, 8)} secret {io.be32(buf, 12)}"
    net.write_all(peer, error_57014()) or return
    net.read(peer, buf) or return
    net.write_all(peer, completed()) or return
    var tail = 0
    for {
        let got = net.read(peer, buf) or -1
        if got <= 0 {
            report <- "server saw {tail} bytes then end {got}"
            return
        }
        tail += got
    }
}

fn interrupt(h: sql.ConnectionHandle, started: chan[bool]) {
    let go = (<-started) ?? false
    if go {
        h.cancel()
    }
}

fn cancelled(l: net.Listener, started: chan[bool]) {
    using db = postgres.connect(options(l)) catch {
        e => {
            print("connect {describe(e)}")
            return
        }
    }
    spawn interrupt(db.handle, started)
    let slept = db.handle.execute("SELECT pg_sleep(10)", []) catch {
        e => {
            print("sleep {describe(e)}")
            -1
        }
    }
    print("slept {slept}")
    let next = db.handle.execute("SELECT 1", []) catch {
        e => {
            print("next {describe(e)}")
            -1
        }
    }
    print("next {next}")
}

fn cancel_scenario() ! io.Error {
    using l = net.listen("127.0.0.1", 0)?
    let started = chan[bool](1)
    let report = chan[str](2)
    let listening = l.handle
    spawn serve_cancel(listening, started, report)
    cancelled(l, started)
    print((<-report) ?? "")
    print((<-report) ?? "")
}

fn main() ! io.Error {
    scenario(true, explicit)?
    scenario(true, leave)?
    scenario(false, silent)?
    cancel_scenario()?
}
