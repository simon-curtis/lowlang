import std/big
import std/big/decimal
import std/big/rat
import std/crypto/hash
import std/text

struct Gen {
    state: u64
}

fn next(mut g: Gen) -> u64 {
    var x = g.state
    x ^= x >> 12
    x ^= x << 25
    x ^= x >> 27
    g.state = x
    x * 0x2545F4914F6CDD1D
}

fn random_bits(mut g: Gen, bits: i64) -> big.Int {
    let n = (bits + 7) / 8
    var raw: []u8 = []
    for _ in 0..n {
        push(mut raw, u8(next(mut g) >> 56))
    }
    raw[0] = raw[0] & (u8(255) >> (8 * n - bits))
    big.from_bytes(raw)
}

fn signed(mut g: Gen, bits: i64) -> big.Int {
    let v = random_bits(mut g, bits)
    if next(mut g) & 1 == 1 { big.neg(v) } else { v }
}

fn nonzero(x: big.Int) -> big.Int {
    if big.is_zero(x) { big.one() } else { x }
}

fn power(base: i64, e: u64) -> big.Int {
    big.pow(big.from_i64(base), e)
}

fn digest(s: str) -> str {
    text.encode_hex(hash.sum(hash.sha256(), bytes(s)))
}

fn feed(chains: []str, op: i64, value: str) {
    chains[op] = digest("{chains[op]}{value}")
}

fn fresh(names: []str) -> []str {
    var chains: []str = []
    for _ in names {
        push(mut chains, "")
    }
    chains
}

fn report(names: []str, chains: []str) {
    for j, name in names {
        print("{name} {chains[j]}")
    }
}

fn describe(e: big.Error) -> str {
    match e {
        Empty => "empty"
        BadDigit(at) => "bad digit at {at}"
        BadBase => "bad base"
        DivideByZero => "divide by zero"
        Overflow => "overflow"
        NoInverse => "no inverse"
        Negative => "negative"
        NotPositive => "not positive"
    }
}

fn rat_names() -> []str {
    ["add", "sub", "mul", "div", "cmp", "str", "float", "fixed", "parse", "unary"]
}

fn rat_operand(mut g: Gen) -> rat.Rat ! big.Error {
    let kind = next(mut g) % 4
    if kind == 1 {
        let n = big.from_i64(i64(next(mut g) % 41) - 20)
        let d = big.from_i64(1 + i64(next(mut g) % 20))
        return rat.ratio(n, d)
    }
    if kind == 2 {
        let n = signed(mut g, 1 + i64(next(mut g) % 300))
        let d = power(2, next(mut g) % 1400)
        return rat.ratio(n, d)
    }
    if kind == 3 {
        return rat.from_int(signed(mut g, 1 + i64(next(mut g) % 300)))
    }
    let n = signed(mut g, 1 + i64(next(mut g) % 300))
    let d = nonzero(signed(mut g, 1 + i64(next(mut g) % 300)))
    rat.ratio(n, d)
}

fn float_bits_text(f: f64) -> str {
    big.from_u64(text.float_bits(f)).to_str(16)
}

fn rat_division(x: rat.Rat, y: rat.Rat) -> str {
    let q = rat.div(x, y) catch {
        e => return describe(e)
    }
    rat.to_str(q)
}

fn rat_inverse(x: rat.Rat) -> str {
    let q = rat.inv(x) catch {
        e => return describe(e)
    }
    rat.to_str(q)
}

fn rat_cases() ! big.Error {
    var g = Gen { state: 0x243F6A8885A308D3 }
    let names = rat_names()
    let chains = fresh(names)
    for i in 0..150 {
        let x = rat_operand(mut g)?
        let y = rat_operand(mut g)?
        let places = i64(next(mut g) % 12)
        feed(chains, 0, rat.to_str(rat.add(x, y)))
        feed(chains, 1, rat.to_str(rat.sub(x, y)))
        feed(chains, 2, rat.to_str(rat.mul(x, y)))
        feed(chains, 3, rat_division(x, y))
        feed(chains, 4, "{rat.cmp(x, y)} {rat.equal(x, x)}")
        feed(chains, 5, "{rat.to_str(x)} {big.to_str(rat.numerator(x), 10)} {big.to_str(rat.denominator(x), 10)}")
        feed(chains, 6, float_bits_text(rat.to_f64(x)))
        feed(chains, 7, rat.to_fixed(x, places))
        feed(chains, 8, rat.to_str(rat.parse(rat.to_str(x))?))
        feed(chains, 9, "{rat.to_str(rat.neg(x))} {rat.to_str(rat.abs(x))} {rat_inverse(x)} {rat.sign(x)} {rat.is_int(x)} {rat.is_zero(x)}")
    }
    report(names, chains)
}

fn rat_parse_line(s: str) -> str {
    let r = rat.parse(s) catch {
        e => return describe(e)
    }
    "{rat.to_str(r)} {float_bits_text(rat.to_f64(r))}"
}

fn rat_known() ! big.Error {
    for s in ["3/6", "-4/-8", "4/-8", "0/5", "1.25", "-.5", "5.", "1e3", "1.5E-3", "+7", "-0", "0.000", "123456789/1000", "1/0", "x/2", "1/2/3", "", "/", "1.2.3", "1e", "1e5000000000", " 7", "1/3", "2/3", "-1/3"] {
        print("{s}: {rat_parse_line(s)}")
    }
    let tiny = rat.ratio(big.one(), power(2, 1074))?
    let half = rat.ratio(big.one(), power(2, 1075))?
    let three = rat.ratio(big.from_i64(3), power(2, 1075))?
    let over = rat.ratio(power(2, 1024).sub(power(2, 970)), big.one())?
    let under = rat.ratio(power(2, 1024).sub(power(2, 971)), big.one())?
    for r in [tiny, half, three, over, under, rat.from_i64(0)] {
        print(float_bits_text(rat.to_f64(r)))
    }
    for s in ["2/3", "-2/3", "1/8", "5/8", "-5/8", "1/200", "-1/200", "999/1000", "1234567/1000"] {
        let r = rat.parse(s)?
        print("{s} {rat.to_fixed(r, 0)} {rat.to_fixed(r, 1)} {rat.to_fixed(r, 2)} {rat.to_fixed(r, 3)}")
    }
    let a = rat.parse("1/3")?
    let b = rat.parse("1/6")?
    print(a.add(b).to_str())
    print(a.sub(b).to_str())
    print(a.mul(b).to_str())
    print(rat_division(a, b))
    print(rat_division(a, rat.from_i64(0)))
    print(rat_inverse(rat.from_i64(0)))
    print(rat.cmp(a, b))
    print(rat.cmp(b, a))
    print(rat.equal(rat.parse("2/4")?, rat.parse("0.5")?))
    var sum = rat.from_i64(0)
    for k in 1..21 {
        sum = rat.add(sum, rat.ratio(big.one(), big.from_i64(k))?)
    }
    print(sum.to_str())
    print(float_bits_text(sum.to_f64()))
    print(sum.to_fixed(10))
}

fn decimal_names() -> []str {
    ["add", "sub", "mul", "cmp", "str", "rescale", "div", "strip", "parse", "unary"]
}

fn modes() -> []decimal.Rounding {
    [decimal.Rounding.HalfEven, decimal.Rounding.HalfUp, decimal.Rounding.Down, decimal.Rounding.Up, decimal.Rounding.Floor, decimal.Rounding.Ceiling]
}

fn decimal_operand(mut g: Gen) -> decimal.Decimal {
    let kind = next(mut g) % 5
    let exp = i32(i64(next(mut g) % 19) - 12)
    if kind == 0 {
        return decimal.from_parts(big.from_i64(i64(next(mut g) % 2001) - 1000), exp)
    }
    if kind == 1 {
        let coef = big.from_i64(5 + 10 * i64(next(mut g) % 100))
        return decimal.from_parts(coef, exp)
    }
    decimal.from_parts(signed(mut g, 1 + i64(next(mut g) % 120)), exp)
}

fn decimal_division(x: decimal.Decimal, y: decimal.Decimal, exp: i32, mode: decimal.Rounding) -> str {
    let q = decimal.div(x, y, exp, mode) catch {
        e => return describe(e)
    }
    decimal.to_str(q)
}

fn decimal_products(x: decimal.Decimal, y: decimal.Decimal) -> str {
    let p = decimal.mul(x, y) catch {
        e => return describe(e)
    }
    decimal.to_str(p)
}

fn decimal_cases() {
    var g = Gen { state: 0x13198A2E03707344 }
    let names = decimal_names()
    let chains = fresh(names)
    for _ in 0..150 {
        let x = decimal_operand(mut g)
        let y = decimal_operand(mut g)
        let target = i32(i64(next(mut g) % 19) - 14)
        feed(chains, 0, decimal.to_str(decimal.add(x, y)))
        feed(chains, 1, decimal.to_str(decimal.sub(x, y)))
        feed(chains, 2, decimal_products(x, y))
        feed(chains, 3, "{decimal.cmp(x, y)} {decimal.equal(x, x)}")
        feed(chains, 4, "{decimal.to_str(x)} {decimal.sign(x)} {decimal.exponent(x)} {big.to_str(decimal.coefficient(x), 10)}")
        for mode in modes() {
            feed(chains, 5, decimal.to_str(decimal.rescale(x, target, mode)))
            feed(chains, 6, decimal_division(x, y, target, mode))
        }
        feed(chains, 7, decimal.to_str(decimal.strip(x)))
        let again = decimal.parse(decimal.to_str(x)) or decimal.from_i64(-1, 0)
        feed(chains, 8, "{decimal.to_str(again)} {decimal.equal(again, x)}")
        feed(chains, 9, "{decimal.to_str(decimal.neg(x))} {decimal.to_str(decimal.abs(x))} {decimal.is_zero(x)}")
    }
    report(names, chains)
}

fn decimal_parse_line(s: str) -> str {
    let d = decimal.parse(s) catch {
        e => return describe(e)
    }
    "{decimal.to_str(d)} {decimal.exponent(d)} {big.to_str(decimal.coefficient(d), 10)}"
}

fn money(s: str) -> decimal.Decimal {
    decimal.parse(s) or decimal.from_i64(0, 0)
}

fn decimal_known() ! big.Error {
    for s in ["12.345", "-12.345", "0", "0.00", "-0.00", "100", "1.5e3", "1.50e-1", "5.", ".5", "-.5E+2", "+1.0", "1e2147483648", "1.2.3", "1e", "e5", "", "-", "12a", "1,5"] {
        print("{s}: {decimal_parse_line(s)}")
    }
    for s in ["1e2147483647", "-1e-2147483648", "1.5e-2147483647"] {
        let d = money(s)
        print("{s}: {decimal.exponent(d)} {big.to_str(decimal.coefficient(d), 10)}")
    }
    print(decimal.to_str(decimal.add(money("0.1"), money("0.2"))))
    print(decimal.to_str(decimal.mul(money("19.99"), money("3"))?))
    print(decimal.to_str(decimal.sub(money("10"), money("0.01"))))
    print(decimal_division(money("100"), money("3"), -2, decimal.Rounding.HalfEven))
    print(decimal_division(money("100"), money("0"), -2, decimal.Rounding.HalfEven))
    print(decimal_division(money("-7"), money("2"), 0, decimal.Rounding.HalfEven))
    print(decimal_division(money("-5"), money("2"), 0, decimal.Rounding.HalfEven))
    print(decimal_division(money("1"), money("8"), 3, decimal.Rounding.Down))
    print(decimal_division(money("1234"), money("0.01"), 1, decimal.Rounding.Down))
    for s in ["2.675", "-2.675", "2.665", "2.6651", "0.005", "-0.005", "0.004", "1.005"] {
        let d = money(s)
        var line = s
        for mode in modes() {
            line = "{line} {decimal.to_str(decimal.rescale(d, -2, mode))}"
        }
        print(line)
    }
    print(decimal.to_str(decimal.rescale(money("123.45"), 1, decimal.Rounding.HalfUp)))
    print(decimal.to_str(decimal.rescale(money("125"), 1, decimal.Rounding.HalfEven)))
    print(decimal.to_str(decimal.rescale(money("135"), 1, decimal.Rounding.HalfEven)))
    print(decimal.to_str(decimal.rescale(money("1.5"), -4, decimal.Rounding.Down)))
    print(decimal.to_str(decimal.strip(money("1.500"))))
    print(decimal.to_str(decimal.strip(money("1500"))))
    print(decimal.to_str(decimal.strip(money("0.00"))))
    print(decimal.cmp(money("1.50"), money("1.5")))
    print(decimal.equal(money("1.50"), money("1.5")))
    print(decimal.cmp(money("-1"), money("0.001")))
    let third = rat.ratio(big.one(), big.from_i64(3))?
    print(decimal.to_str(rat.to_decimal(third, -6, decimal.Rounding.HalfEven)))
    print(decimal.to_str(rat.to_decimal(third.neg(), -6, decimal.Rounding.Floor)))
    print(rat.to_str(rat.from_decimal(money("-12.345"))))
    print(rat.to_str(rat.from_decimal(money("1.5e3"))))
    print(float_bits_text(rat.to_f64(rat.from_decimal(money("0.1")))))
}

fn main() ! big.Error {
    rat_cases()?
    rat_known()?
    decimal_cases()
    decimal_known()?
}
