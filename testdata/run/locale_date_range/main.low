import std/locale
import std/locale/datefmt
import std/text
import std/time/datetime
import std/time/timeofday

fn moment_of(value: str) -> datefmt.Moment {
    let n = text.split(value, ',')
    let year = text.parse_int(n[0]) or 0
    let month = text.parse_int(n[1]) or 1
    let day = text.parse_int(n[2]) or 1
    let hour = text.parse_int(n[3]) or 0
    let minute = text.parse_int(n[4]) or 0
    let second = text.parse_int(n[5]) or 0
    let dt = datetime.of(year, month, day, hour, minute, second, 0) or datetime.epoch()
    datefmt.from_datetime(dt)
}

fn length_of(name: str) -> datefmt.Length {
    match name {
        "full" => datefmt.Length.Full
        "long" => datefmt.Length.Long
        "medium" => datefmt.Length.Medium
        _ => datefmt.Length.Short
    }
}

fn options_of(skeleton: str, cycle: str) -> datefmt.Options {
    var o = datefmt.options()
    if text.starts_with(skeleton, "date=") {
        o.date_style = length_of(skeleton[5..])
        return o
    }
    o.skeleton = skeleton
    match cycle {
        "h12" => { o.hour_cycle = datefmt.HourCycle.H12 }
        "h23" => { o.hour_cycle = datefmt.HourCycle.H23 }
        _ => {}
    }
    o
}

fn missing_date() -> str ! datefmt.Error {
    let t = datefmt.from_time(timeofday.of(10, 0, 0, 0) or timeofday.midnight())
    var o = datefmt.options()
    o.skeleton = "yMd"
    datefmt.format_range(locale.root(), t, t, o)?
}

fn main() {
    var checked = 0
    var failed = 0
    var current = ""
    var l = locale.root()
    for line in text.lines(embed("range.tsv")) {
        let f = text.split(line, '\t')
        if f.len != 6 {
            continue
        }
        if f[0] != current {
            current = f[0]
            l = locale.parse(current) or locale.root()
        }
        let raw = datefmt.format_range(l, moment_of(f[3]), moment_of(f[4]), options_of(f[1], f[2])) or "error"
        let got = text.replace(raw, text.from_char(0x202f), " ")
        checked += 1
        if got != f[5] {
            failed += 1
            if failed <= 40 {
                print("{f[0]} {f[1]} {f[2]} {f[3]} {f[4]}: want {f[5]}, got {got}")
            }
        }
    }
    print("range: {checked} checked, {failed} wrong")
    print(missing_date() catch {
        MissingDate => "missing date"
        e => "other"
    })
}
