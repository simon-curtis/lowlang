extern struct Pair {
    a: u8 = 0
    b: u16 = 0
    c: u32 = 0
}

fn bump(mut x: u8) {
    x += 1
}

fn widen(mut x: u16) {
    x = x * 3 + 1
}

fn grow(mut x: u32) {
    x = x + 100000
}

fn main() {
    var keep: [][]u8 = []
    for i in 0..2000 {
        var xs: []u8 = [10, 20, 30]
        bump(mut xs[1])
        push(mut keep, xs)
    }
    var ok = 0
    for xs in keep {
        if xs.len == 3 && xs[0] == 10 && xs[1] == 21 && xs[2] == 30 {
            ok += 1
        }
    }
    print(ok)
    var hs: []u16 = [7, 8, 9]
    widen(mut hs[2])
    print("{hs[0]} {hs[1]} {hs[2]}")
    var p = Pair { a: 1, b: 2, c: 3 }
    bump(mut p.a)
    widen(mut p.b)
    grow(mut p.c)
    print("{p.a} {p.b} {p.c}")
    let f = bump
    f(mut xs_of(keep)[0])
    print(keep[0][0])
}

fn xs_of(keep: [][]u8) -> []u8 {
    keep[0]
}
