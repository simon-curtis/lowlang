import std/ui
import std/ui/geometry
import std/ui/scene
import std/ui/svg
import uitext = std/ui/text

fn icon(source: str) -> svg.Icon {
    svg.parse(source) or svg.Icon { view_box: geometry.rect(0.0, 0.0, 24.0, 24.0), shapes: [] }
}

fn drawn(viewbox: str, body: str) -> svg.Icon {
    icon("<svg xmlns='http://www.w3.org/2000/svg' viewBox='{viewbox}'>{body}</svg>")
}

fn show(label: str, s: scene.Scene) {
    print("{label}: {s.sprites.len} sprites")
    for sp in s.sprites {
        print("  {sp.bounds.x},{sp.bounds.y} {sp.bounds.width}x{sp.bounds.height} rgba {sp.color.r:f2} {sp.color.g:f2} {sp.color.b:f2} {sp.color.a:f2}")
    }
}

fn frame_of(cx: ui.Context, root: fn() -> ui.Element, scale: f32) -> scene.Scene {
    cx.frame(root, geometry.size(100.0, 50.0), scale)
}

fn placement(cx: ui.Context) {
    print("placement")
    let square = drawn("0 0 10 10", "<rect width='10' height='10'/>")
    show("wide box", frame_of(cx, fn() -> ui.Element {
        ui.div().size(100.0, 50.0).children() {
            ui.svg_icon(square).size(20.0, 10.0)
        }
    }, 1.0))
    show("tall box", frame_of(cx, fn() -> ui.Element {
        ui.div().size(100.0, 50.0).children() {
            ui.svg_icon(square).size(10.0, 30.0)
        }
    }, 1.0))
    show("margin", frame_of(cx, fn() -> ui.Element {
        ui.div().size(100.0, 50.0).children() {
            ui.svg_icon(square).size(10.0, 10.0).margin(7.0)
        }
    }, 1.0))
    show("scale 2", frame_of(cx, fn() -> ui.Element {
        ui.div().size(100.0, 50.0).children() {
            ui.svg_icon(square).size(20.0, 10.0)
        }
    }, 2.0))
    let offset = drawn("5 5 10 10", "<rect x='5' y='5' width='5' height='10'/>")
    show("view box origin", frame_of(cx, fn() -> ui.Element {
        ui.div().size(100.0, 50.0).children() {
            ui.svg_icon(offset).size(20.0, 20.0)
        }
    }, 1.0))
    show("no size", frame_of(cx, fn() -> ui.Element {
        ui.div().size(100.0, 50.0).children() {
            ui.svg_icon(square)
        }
    }, 1.0))
    show("empty", frame_of(cx, fn() -> ui.Element {
        ui.div().size(100.0, 50.0).children() {
            ui.svg_icon(drawn("0 0 10 10", "")).size(20.0, 10.0)
        }
    }, 1.0))
}

fn colours(cx: ui.Context) {
    print("colours")
    let strip = drawn("0 0 10 2", "<rect width='2' height='2'/><rect x='2' width='2' height='2' fill='#00ff00'/><rect x='4' width='2' height='2' fill='currentColor'/><rect x='6' width='2' height='2' fill-opacity='0.5'/><rect x='8' width='2' height='2' fill='rgba(0, 0, 255, 0.5)' opacity='0.5'/>")
    show("text colour", frame_of(cx, fn() -> ui.Element {
        ui.div().size(100.0, 50.0).text_color(ui.rgb(0xff0000)).children() {
            ui.svg_icon(strip).size(10.0, 2.0)
        }
    }, 1.0))
    show("inherited from ancestor", frame_of(cx, fn() -> ui.Element {
        ui.div().size(100.0, 50.0).text_color(ui.rgb(0x0000ff)).children() {
            ui.div().children() {
                ui.svg_icon(drawn("0 0 2 2", "<rect width='2' height='2'/>")).size(2.0, 2.0)
            }
        }
    }, 1.0))
    show("default text colour", frame_of(cx, fn() -> ui.Element {
        ui.div().size(100.0, 50.0).children() {
            ui.svg_icon(drawn("0 0 2 2", "<rect width='2' height='2'/>")).size(2.0, 2.0)
        }
    }, 1.0))
    show("text alpha", frame_of(cx, fn() -> ui.Element {
        ui.div().size(100.0, 50.0).text_color(ui.rgba(0x00ff0080)).children() {
            ui.svg_icon(drawn("0 0 2 2", "<rect width='2' height='2'/>")).size(2.0, 2.0)
        }
    }, 1.0))
    show("element opacity", frame_of(cx, fn() -> ui.Element {
        ui.div().size(100.0, 50.0).text_color(ui.rgb(0xff0000)).opacity(0.5).children() {
            ui.svg_icon(drawn("0 0 2 2", "<rect width='2' height='2' fill-opacity='0.5'/>")).size(2.0, 2.0)
        }
    }, 1.0))
    show("no paint", frame_of(cx, fn() -> ui.Element {
        ui.div().size(100.0, 50.0).children() {
            ui.svg_icon(drawn("0 0 2 2", "<rect width='2' height='2' fill='none'/>")).size(2.0, 2.0)
        }
    }, 1.0))
}

fn strokes(cx: ui.Context) {
    print("strokes")
    let ruled = drawn("0 0 10 10", "<line x1='2' y1='5' x2='8' y2='5' fill='none' stroke='currentColor' stroke-width='2'/>")
    show("stroke", frame_of(cx, fn() -> ui.Element {
        ui.div().size(100.0, 50.0).text_color(ui.rgb(0x00ff00)).children() {
            ui.svg_icon(ruled).size(10.0, 10.0)
        }
    }, 1.0))
    show("stroke scaled", frame_of(cx, fn() -> ui.Element {
        ui.div().size(100.0, 50.0).children() {
            ui.svg_icon(ruled).size(20.0, 20.0)
        }
    }, 1.0))
    let both = drawn("0 0 10 10", "<rect x='2' y='2' width='6' height='6' stroke='red' stroke-opacity='0.5'/>")
    show("fill and stroke", frame_of(cx, fn() -> ui.Element {
        ui.div().size(100.0, 50.0).children() {
            ui.svg_icon(both).size(10.0, 10.0)
        }
    }, 1.0))
}

fn pixel(a: scene.Atlas, x: i64, y: i64) -> u8 {
    a.coverage.pixels[y * a.size + x]
}

fn rows(sp: scene.Sprite, a: scene.Atlas) -> str {
    let k = f32(a.size)
    let left = i64(sp.tile.x * k + 0.5)
    let top = i64(sp.tile.y * k + 0.5)
    let width = i64(sp.tile.width * k + 0.5)
    let height = i64(sp.tile.height * k + 0.5)
    var out = ""
    for y in 0..height {
        for x in 0..width {
            out += match pixel(a, left + x, top + y) {
                255 => "#"
                0 => "."
                _ => "+"
            }
        }
        out += "\n"
    }
    out
}

fn painted(source: str, evenodd: bool) {
    var sys = uitext.default_system()
    var sc = scene.empty(100, 50, geometry.rgb(0xffffff))
    let parsed = icon(source)
    let path = parsed.shapes[0].path
    let rule = if evenodd { geometry.FillRule.EvenOdd } else { geometry.FillRule.NonZero }
    uitext.paint_polygons(mut sys, mut sc, geometry.flatten(path, 1.0), rule, geometry.rgb(0))
    print("sprite {sc.sprites[0].bounds.x},{sc.sprites[0].bounds.y} {sc.sprites[0].bounds.width}x{sc.sprites[0].bounds.height}")
    print(rows(sc.sprites[0], sys.atlas))
}

fn evenodd(cx: ui.Context) {
    print("evenodd")
    let frame = "M0 0h10v10H0z M2 2h6v6H2z"
    print("nonzero")
    painted("<svg viewBox='0 0 10 10'><path d='{frame}'/></svg>", false)
    print("evenodd")
    painted("<svg viewBox='0 0 10 10'><path fill-rule='evenodd' d='{frame}'/></svg>", true)
    print("island")
    painted("<svg viewBox='0 0 10 10'><path fill-rule='evenodd' d='{frame} M4 4h2v2H4z'/></svg>", true)
    print("separate")
    painted("<svg viewBox='0 0 10 10'><path fill-rule='evenodd' d='M0 0h4v4H0z M6 6h4v4H6z'/></svg>", true)
    print("crossing")
    painted("<svg viewBox='0 0 10 10'><path fill-rule='evenodd' d='M0 0h6v6H0z M4 4h6v6H4z'/></svg>", true)
    print("same direction")
    painted("<svg viewBox='0 0 10 10'><path fill-rule='evenodd' d='M0 0v10h10V0z M2 2v6h6V2z'/></svg>", true)

    let ring = drawn("0 0 10 10", "<path fill-rule='evenodd' d='{frame}'/>")
    let solid = drawn("0 0 10 10", "<path d='{frame}'/>")
    let a = frame_of(cx, fn() -> ui.Element {
        ui.div().size(100.0, 50.0).children() {
            ui.svg_icon(ring).size(10.0, 10.0)
        }
    }, 1.0)
    let b = frame_of(cx, fn() -> ui.Element {
        ui.div().size(100.0, 50.0).children() {
            ui.svg_icon(solid).size(10.0, 10.0)
        }
    }, 1.0)
    print("scene ring {a.sprites.len} {a.sprites[0].bounds.width}x{a.sprites[0].bounds.height} solid {b.sprites.len} {b.sprites[0].bounds.width}x{b.sprites[0].bounds.height} same tile {a.sprites[0].tile == b.sprites[0].tile}")
}

fn main() {
    let cx = ui.headless(ui.rgb(0xffffff))
    placement(cx)
    colours(cx)
    strokes(cx)
    evenodd(cx)
}
