import std/text
import std/time/date
import std/time/datetime
import std/time/duration
import std/time/fault
import std/time/offset
import std/time/rounding
import std/time/span
import std/time/timeofday
import std/time/timestamp
import std/time/tzdata
import std/time/zone
import std/time/zoned

fn describe(f: fault.Fault) -> str {
    match f {
        OutOfRange(what) => "OutOfRange"
        Invalid(what) => "Invalid"
        Syntax(at) => "Syntax({at})"
        Overflow => "Overflow"
        UnknownZone(name) => "UnknownZone"
        Malformed(what) => "Malformed"
        Unsupported(what) => "Unsupported"
        Skipped => "Skipped"
        Ambiguous => "Ambiguous"
        OffsetConflict => "OffsetConflict"
    }
}

fn number(s: str) -> i64 {
    text.parse_int(s) or 0
}

fn how(word: str) -> zoned.Disambiguation {
    if word == "earlier" {
        return zoned.Disambiguation.Earlier
    }
    if word == "later" {
        return zoned.Disambiguation.Later
    }
    if word == "reject" {
        return zoned.Disambiguation.Reject
    }
    zoned.Disambiguation.Compatible
}

fn policy_of(word: str) -> zoned.OffsetPolicy {
    if word == "prefer_offset" {
        return zoned.OffsetPolicy.PreferOffset
    }
    if word == "use_offset" {
        return zoned.OffsetPolicy.UseOffset
    }
    if word == "use_zone" {
        return zoned.OffsetPolicy.UseZone
    }
    zoned.OffsetPolicy.Reject
}

fn unit_of(name: str) -> span.Unit {
    for i in 0..10 {
        if span.unit_name(span.unit_of(i)) == name {
            return span.unit_of(i)
        }
    }
    span.Unit.Days
}

fn mode_name(m: rounding.Rounding) -> str {
    match m {
        Trunc => "trunc"
        Ceil => "ceil"
        Floor => "floor"
        Expand => "expand"
        HalfExpand => "half_expand"
        HalfEven => "half_even"
        HalfTrunc => "half_trunc"
        HalfCeil => "half_ceil"
        HalfFloor => "half_floor"
    }
}

fn mode_of(name: str) -> rounding.Rounding {
    let all = [
        rounding.Rounding.Trunc,
        rounding.Rounding.Ceil,
        rounding.Rounding.Floor,
        rounding.Rounding.Expand,
        rounding.Rounding.HalfExpand,
        rounding.Rounding.HalfEven,
        rounding.Rounding.HalfTrunc,
        rounding.Rounding.HalfCeil,
        rounding.Rounding.HalfFloor
    ]
    for m in all {
        if mode_name(m) == name {
            return m
        }
    }
    rounding.Rounding.Trunc
}

fn digest(lines: []str) -> i64 {
    var h = 7
    for line in lines {
        for i in 0..line.len {
            h = (h * 131 + i64(line[i])) % 2147483647
        }
        h = (h * 131 + 10) % 2147483647
    }
    h
}

fn sample(tag: str, lines: []str) {
    let keep = 1
    if lines.len <= 2 * keep {
        for line in lines {
            print("{tag} {line}")
        }
        return
    }
    for i in 0..keep {
        print("{tag} {lines[i]}")
    }
    print("{tag} ... {lines.len - 2 * keep} more")
    for i in lines.len - keep..lines.len {
        print("{tag} {lines[i]}")
    }
}

fn known(name: str) -> zone.Zone ! fault.Fault {
    zone.load_from(name, tzdata.source())?
}

fn marker_how(mark: str) -> zoned.Disambiguation {
    if mark == "e" {
        return zoned.Disambiguation.Earlier
    }
    if mark == "l" {
        return zoned.Disambiguation.Later
    }
    if mark == "r" {
        return zoned.Disambiguation.Reject
    }
    zoned.Disambiguation.Compatible
}

fn civil_at(f: []str, at: i64) -> zoned.Zoned ! fault.Fault {
    let tz = known(f[at])?
    let parts = text.cut(f[at + 1], "~")
    let dt = datetime.parse(parts.before)?
    zoned.from_civil(dt, tz, marker_how(parts.after))?
}

fn field_or(f: []str, at: i64, fallback: str) -> str {
    if at < f.len { f[at] } else { fallback }
}

fn date_of(s: str) -> date.Date ! fault.Fault {
    date.parse(s)?
}

fn time_of(s: str) -> timeofday.TimeOfDay ! fault.Fault {
    timeofday.parse(s)?
}

fn span_of(s: str) -> span.Span ! fault.Fault {
    span.parse(s)?
}

fn rest_after(line: str, words: i64) -> str {
    var rest = line
    for _ in 0..words {
        rest = text.cut(rest, " ").after
    }
    rest
}

fn at_text(t: zone.Transition?) -> str {
    match t {
        some(x) => timestamp.to_string(x.at)
        none => "none"
    }
}

fn custom_loader(name: str) -> zone.Zone ! fault.Fault {
    if name == "Test/Posix" {
        return zone.from_posix("EST5EDT,M3.2.0,M11.1.0", name)?
    }
    known(name)?
}

fn day_text(z: zoned.Zoned) -> str ! fault.Fault {
    let first = zoned.start_of_day(z)?
    let last = zoned.end_of_day(z)?
    let length = zoned.hours_in_day(z)?
    "start={zoned.to_string(first)} end={zoned.to_string(last)} secs={duration.whole_seconds(length)} nanos={duration.subsec_nanos(length)}"
}

fn field_text(z: zoned.Zoned) -> str {
    let w = date.weekday_to_number(zoned.weekday(z))
    let fields = "{zoned.year(z)} {zoned.month_number(z)} {zoned.day(z)} {zoned.hour(z)} {zoned.minute(z)} {zoned.second(z)} {zoned.nanosecond(z)}"
    "{fields} {w} {zoned.day_of_year(z)} {zoned.abbreviation(z)} {zoned.is_dst(z)} {offset.seconds_of(zoned.offset(z))}"
}

fn transition_text(z: zoned.Zoned) -> str {
    "next={at_text(zoned.next_transition(z))} prev={at_text(zoned.previous_transition(z))}"
}

fn compare_text(a: zoned.Zoned, b: zoned.Zoned) -> str {
    let d = zoned.duration_until(a, b)
    let flags = "{zoned.compare(a, b)} {zoned.equal(a, b)} {zoned.before(a, b)} {zoned.after(a, b)} {zoned.same_instant_and_zone(a, b)}"
    "{flags} {duration.whole_seconds(d)} {duration.subsec_nanos(d)}"
}

fn series_text(f: []str) -> str ! fault.Fault {
    let start = civil_at(f, 1)?
    let step = span_of(f[3])?
    let items = zoned.series(start, step, number(f[5]), how(f[4]))?
    var parts: []str = []
    for item in items {
        push(mut parts, zoned.to_string(item))
    }
    text.join(parts, " ; ")
}

fn with_text(f: []str) -> str ! fault.Fault {
    let z = civil_at(f, 1)?
    let how_to = how(f[5])
    if f[3] == "date" {
        let d = date_of(f[4])?
        return zoned.to_string(zoned.with_date(z, d, how_to)?)
    }
    if f[3] == "time" {
        let t = time_of(f[4])?
        return zoned.to_string(zoned.with_time(z, t, how_to)?)
    }
    let dt = datetime.parse(f[4])?
    zoned.to_string(zoned.with_datetime(z, dt, how_to)?)
}

fn civil_four(f: []str) -> str ! fault.Fault {
    let tz = known(f[1])?
    let dt = datetime.parse(f[2])?
    let compat = scan_token(dt, tz, zoned.Disambiguation.Compatible)
    let early = scan_token(dt, tz, zoned.Disambiguation.Earlier)
    let late = scan_token(dt, tz, zoned.Disambiguation.Later)
    let reject = scan_token(dt, tz, zoned.Disambiguation.Reject)
    "{compat} | {early} | {late} | {reject}"
}

fn answer(line: str) -> str ! fault.Fault {
    let f = text.fields(line)
    let op = f[0]
    if op == "civil" {
        return zoned.to_string(civil_at(f, 1)?)
    }
    if op == "civil4" {
        return civil_four(f)?
    }
    if op == "plus" || op == "minus" {
        let z = civil_at(f, 1)?
        let s = span_of(f[3])?
        let w = how(field_or(f, 4, "compatible"))
        let r = if op == "plus" { zoned.plus(z, s, w)? } else { zoned.minus(z, s, w)? }
        return zoned.to_string(r)
    }
    if op == "plusd" {
        let z = civil_at(f, 1)?
        let d = duration.seconds(number(f[3]))
        return zoned.to_string(zoned.plus_duration(z, d)?)
    }
    if op == "until" || op == "since" {
        let a = civil_at(f, 1)?
        let b = civil_at(f, 3)?
        let smallest = unit_of(field_or(f, 6, "nanoseconds"))
        let diff = span.Diff { largest: unit_of(f[5]), smallest, increment: number(field_or(f, 7, "1")), mode: mode_of(field_or(f, 8, "trunc")) }
        let s = if op == "until" { zoned.until(a, b, diff)? } else { zoned.since(a, b, diff)? }
        return span.to_string(s)
    }
    if op == "day" {
        return day_text(civil_at(f, 1)?)?
    }
    if op == "round" {
        let z = civil_at(f, 1)?
        return zoned.to_string(zoned.round(z, unit_of(f[3]), number(field_or(f, 4, "1")), mode_of(field_or(f, 5, "trunc")))?)
    }
    if op == "rfc" {
        let z = civil_at(f, 1)?
        return "{zoned.to_rfc3339(z)} | {zoned.to_rfc2822(z)}"
    }
    if op == "fields" {
        return field_text(civil_at(f, 1)?)
    }
    if op == "trans" {
        return transition_text(civil_at(f, 1)?)
    }
    if op == "cmp" {
        return compare_text(civil_at(f, 1)?, civil_at(f, 3)?)
    }
    if op == "inzone" {
        let z = civil_at(f, 1)?
        return zoned.to_string(zoned.in_zone(z, known(f[3])?)?)
    }
    if op == "series" {
        return series_text(f)?
    }
    if op == "with" {
        return with_text(f)?
    }
    if op == "parse" {
        return zoned.to_string(zoned.parse(rest_after(line, 1))?)
    }
    if op == "parse_opt" {
        return zoned.to_string(zoned.parse_with_options(rest_after(line, 2), policy_of(f[1]))?)
    }
    if op == "parse_loader" {
        return zoned.to_string(zoned.parse_using(rest_after(line, 1), custom_loader)?)
    }
    "unknown op"
}

fn run(line: str) {
    let result = answer(line) catch {
        e => "!{describe(e)}"
    }
    print("{line} => {result}")
}

fn scan_token(dt: datetime.DateTime, tz: zone.Zone, how_to: zoned.Disambiguation) -> str {
    let z = zoned.from_civil(dt, tz, how_to) catch {
        e => return "!{describe(e)}"
    }
    zoned.to_string(z)
}

fn scan_civil(line: str) {
    let f = text.fields(line)
    let tz = known(f[1]) catch { e => return print("{line} => !{describe(e)}") }
    let start = datetime.parse(f[2]) catch { e => return print("{line} => !{describe(e)}") }
    let step = number(f[3])
    let count = number(f[4])
    let base = datetime.civil_seconds(start)
    var lines: []str = []
    var skipped = 0
    var ambiguous = 0
    for i in 0..count {
        let dt = datetime.from_civil_seconds(base + i * step, 0) or return print("scan range")
        let compat = scan_token(dt, tz, zoned.Disambiguation.Compatible)
        let early = scan_token(dt, tz, zoned.Disambiguation.Earlier)
        let late = scan_token(dt, tz, zoned.Disambiguation.Later)
        let reject = scan_token(dt, tz, zoned.Disambiguation.Reject)
        if reject == "!Skipped" {
            skipped += 1
        }
        if reject == "!Ambiguous" {
            ambiguous += 1
        }
        push(mut lines, "{datetime.to_string(dt)}|{compat}|{early}|{late}|{reject}")
    }
    sample("scan_civil", lines)
    print("{line} => skipped {skipped} ambiguous {ambiguous} hash {digest(lines)}")
}

fn scan_days(line: str) {
    let f = text.fields(line)
    let tz = known(f[1]) catch { e => return print("{line} => !{describe(e)}") }
    let start = datetime.parse(f[2]) catch { e => return print("{line} => !{describe(e)}") }
    let count = number(f[3])
    let base = datetime.civil_seconds(start)
    var lines: []str = []
    var odd: []str = []
    var below = 0
    var even = 0
    var above = 0
    for i in 0..count {
        let dt = datetime.from_civil_seconds(base + i * 86400, 0) or return print("scan range")
        let z = zoned.from_civil(dt, tz, zoned.Disambiguation.Compatible) or return print("scan range")
        let length = zoned.hours_in_day(z) or return print("scan length")
        let secs = duration.whole_seconds(length)
        let first = zoned.start_of_day(z) or return print("scan start")
        let last = zoned.end_of_day(z) or return print("scan end")
        let entry = "{datetime.to_string(dt)} {secs} {zoned.to_string(first)} {zoned.to_string(last)}"
        push(mut lines, entry)
        if secs < 86400 {
            below += 1
            push(mut odd, entry)
        } else if secs > 86400 {
            above += 1
            push(mut odd, entry)
        } else {
            even += 1
        }
    }
    sample("scan_days", odd)
    print("{line} => short {below} regular {even} long {above} hash {digest(lines)}")
}

fn nanos_for(i: i64) -> i64 {
    if i % 4 == 0 { 0 } else { i * 123456789 % 1000000000 }
}

fn round_trips(z: zoned.Zoned, s: str) -> bool {
    let back = zoned.parse(s) or return false
    zoned.same_instant_and_zone(z, back) && zoned.to_string(back) == s
}

fn roundtrip(line: str) {
    let f = text.fields(line)
    let tz = known(f[1]) catch { e => return print("{line} => !{describe(e)}") }
    let first = timestamp.parse(f[2]) catch { e => return print("{line} => !{describe(e)}") }
    let step = number(f[3])
    let count = number(f[4])
    var lines: []str = []
    var bad = 0
    for i in 0..count {
        let secs = timestamp.unix_seconds(first) + i * step
        let ts = timestamp.from_parts(secs, nanos_for(i)) or return print("roundtrip range")
        let z = zoned.of(ts, tz) or return print("roundtrip zoned")
        let s = zoned.to_string(z)
        push(mut lines, s)
        if !round_trips(z, s) {
            bad += 1
        }
    }
    sample("roundtrip", lines)
    print("{line} => mismatches {bad} hash {digest(lines)}")
}

fn dispatch(line: str) {
    if text.starts_with(line, "scan_civil ") {
        return scan_civil(line)
    }
    if text.starts_with(line, "scan_days ") {
        return scan_days(line)
    }
    if text.starts_with(line, "roundtrip ") {
        return roundtrip(line)
    }
    run(line)
}

