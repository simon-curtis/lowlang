    "parse 2026-11-11T10:00:00+01:00[America/New_York]",
    "parse 2026-11-11T10:00:00-05:00[America/New_York] ",
    "parse  2026-11-11T10:00:00Z",
    "parse 2026-11-11T10:00:00+0530x",
    "parse -0001-11-11T10:00:00Z",
    "parse 0000-01-01T00:00:00Z",
    "parse 2026-11-11TT10:00:00Z",
    "parse_opt prefer_offset 2026-11-11T10:00:00+01:00[Mars/Olympus]",
    "parse_opt prefer_offset 2026-11-11T10:00:00x[America/New_York]",
    "parse_opt use_offset 2026-11-11T10:00:00+01:00[Mars/Olympus]",
    "parse_opt use_offset 2026-11-11T10:00:00x[America/New_York]",
    "parse_opt use_zone 2026-11-11T10:00:00+01:00[Mars/Olympus]",
    "parse_opt use_zone 2026-11-11T10:00:00x[America/New_York]",
    "parse_loader 2026-07-01T12:00:00-04:00[Test/Posix]",
    "parse_loader 2026-07-01T12:00:00[Test/Posix]",
    "parse_loader 2026-03-08T02:30:00[Test/Posix]",
    "parse_loader 2026-11-01T01:30:00-05:00[Test/Posix]",
