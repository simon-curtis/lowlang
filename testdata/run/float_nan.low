fn digit(b: bool) -> i64 {
    if b { 1 } else { 0 }
}

fn lt64(a: f64, b: f64) -> bool { a < b }
fn le64(a: f64, b: f64) -> bool { a <= b }
fn gt64(a: f64, b: f64) -> bool { a > b }
fn ge64(a: f64, b: f64) -> bool { a >= b }
fn eq64(a: f64, b: f64) -> bool { a == b }
fn ne64(a: f64, b: f64) -> bool { a != b }

fn lt32(a: f32, b: f32) -> bool { a < b }
fn le32(a: f32, b: f32) -> bool { a <= b }
fn gt32(a: f32, b: f32) -> bool { a > b }
fn ge32(a: f32, b: f32) -> bool { a >= b }
fn eq32(a: f32, b: f32) -> bool { a == b }
fn ne32(a: f32, b: f32) -> bool { a != b }

fn blt64(a: f64, b: f64) -> i64 { if a < b { 1 } else { 0 } }
fn ble64(a: f64, b: f64) -> i64 { if a <= b { 1 } else { 0 } }
fn bgt64(a: f64, b: f64) -> i64 { if a > b { 1 } else { 0 } }
fn bge64(a: f64, b: f64) -> i64 { if a >= b { 1 } else { 0 } }
fn beq64(a: f64, b: f64) -> i64 { if a == b { 1 } else { 0 } }
fn bne64(a: f64, b: f64) -> i64 { if a != b { 1 } else { 0 } }

fn blt32(a: f32, b: f32) -> i64 { if a < b { 1 } else { 0 } }
fn ble32(a: f32, b: f32) -> i64 { if a <= b { 1 } else { 0 } }
fn bgt32(a: f32, b: f32) -> i64 { if a > b { 1 } else { 0 } }
fn bge32(a: f32, b: f32) -> i64 { if a >= b { 1 } else { 0 } }
fn beq32(a: f32, b: f32) -> i64 { if a == b { 1 } else { 0 } }
fn bne32(a: f32, b: f32) -> i64 { if a != b { 1 } else { 0 } }

fn negated64(a: f64, b: f64) -> i64 { if !(a < b) { 1 } else { 0 } }
fn negated32(a: f32, b: f32) -> i64 { if !(a >= b) { 1 } else { 0 } }

fn matrix64(name: str, f: fn(f64, f64) -> bool, values: []f64) {
    var out = ""
    for a in values {
        for b in values {
            out = "{out}{digit(f(a, b))}"
        }
    }
    print("{name} {out}")
}

fn matrix32(name: str, f: fn(f32, f32) -> bool, values: []f32) {
    var out = ""
    for a in values {
        for b in values {
            out = "{out}{digit(f(a, b))}"
        }
    }
    print("{name} {out}")
}

fn branches64(name: str, f: fn(f64, f64) -> i64, values: []f64) {
    var out = ""
    for a in values {
        for b in values {
            out = "{out}{f(a, b)}"
        }
    }
    print("{name} {out}")
}

fn branches32(name: str, f: fn(f32, f32) -> i64, values: []f32) {
    var out = ""
    for a in values {
        for b in values {
            out = "{out}{f(a, b)}"
        }
    }
    print("{name} {out}")
}

fn constants64(x: f64) -> i64 {
    var n = 0
    if x < 1.5 { n += 1 }
    if x > 1.5 { n += 2 }
    if x == 1.5 { n += 4 }
    if x != 1.5 { n += 8 }
    if 1.5 <= x { n += 16 }
    if 1.5 >= x { n += 32 }
    n
}

fn constants32(x: f32) -> i64 {
    var n = 0
    if x < 1.5 { n += 1 }
    if x > 1.5 { n += 2 }
    if x == 1.5 { n += 4 }
    if x != 1.5 { n += 8 }
    if 1.5 <= x { n += 16 }
    if 1.5 >= x { n += 32 }
    n
}

fn main() {
    let nan = sqrt(-1.0)
    let values: []f64 = [1.0, 2.0, nan, 2.0, -0.0, 0.0]
    matrix64("lt", lt64, values)
    matrix64("le", le64, values)
    matrix64("gt", gt64, values)
    matrix64("ge", ge64, values)
    matrix64("eq", eq64, values)
    matrix64("ne", ne64, values)
    branches64("blt", blt64, values)
    branches64("ble", ble64, values)
    branches64("bgt", bgt64, values)
    branches64("bge", bge64, values)
    branches64("beq", beq64, values)
    branches64("bne", bne64, values)
    branches64("negated", negated64, values)
    print(constants64(nan))
    print(constants64(1.0))
    print(constants64(1.5))
    print(constants64(2.0))

    let nan32: f32 = f32(nan)
    let small: []f32 = [1.0, 2.0, nan32, 2.0, -0.0, 0.0]
    matrix32("lt32", lt32, small)
    matrix32("le32", le32, small)
    matrix32("gt32", gt32, small)
    matrix32("ge32", ge32, small)
    matrix32("eq32", eq32, small)
    matrix32("ne32", ne32, small)
    branches32("blt32", blt32, small)
    branches32("ble32", ble32, small)
    branches32("bgt32", bgt32, small)
    branches32("bge32", bge32, small)
    branches32("beq32", beq32, small)
    branches32("bne32", bne32, small)
    branches32("negated32", negated32, small)
    print(constants32(nan32))
    print(constants32(1.0))
    print(constants32(1.5))
    print(constants32(2.0))
}
