fn fib(n: i64) -> i64 {
    if n < 2 {
        return n
    }
    fib(n - 1) + fib(n - 2)
}

fn reply(requests: chan[i64], replies: chan[i64]) {
    for r in requests {
        replies <- r * 2
    }
    close(replies)
}

fn compute_then_wait(rounds: i64, depth: i64) {
    let requests = chan[i64]()
    let replies = chan[i64](1)
    spawn reply(requests, replies)
    var total = 0
    var overlapped = 0
    for r in 0..rounds {
        requests <- r
        var answer: i64? = none
        var work = 0
        for answer == none {
            work += fib(depth)
            answer = select {
                v = <-replies => v
                else => none
            }
        }
        total += answer ?? 0
        overlapped += 1
    }
    close(requests)
    print("compute {rounds} {total} {overlapped}")
}

fn compute_without_polling(depth: i64) {
    let requests = chan[i64]()
    let replies = chan[i64](1)
    spawn reply(requests, replies)
    requests <- 21
    let work = fib(depth)
    let answer = (<-replies) ?? 0
    close(requests)
    print("fib {work % 1000 >= 0} {answer}")
}

fn main() {
    compute_then_wait(5, 22)
    compute_then_wait(40, 12)
    compute_without_polling(30)
}
