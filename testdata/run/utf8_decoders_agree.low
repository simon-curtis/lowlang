import std/unicode

fn walked(s: str) -> []i64 {
    var out: []i64 = []
    for i, c in s {
        push(mut out, i)
        push(mut out, i64(c))
    }
    out
}

fn decoded(s: str) -> []i64 {
    var out: []i64 = []
    var at = 0
    for at < s.len {
        let r = unicode.decode_rune(s, at)
        push(mut out, at)
        push(mut out, i64(r.code))
        at += r.size
    }
    out
}

fn same(a: []i64, b: []i64) -> bool {
    if a.len != b.len {
        return false
    }
    for i in 0..a.len {
        if a[i] != b[i] {
            return false
        }
    }
    true
}

fn main() {
    let edges: []u8 = [0, 0x7F, 0x80, 0x8F, 0x90, 0x9F, 0xA0, 0xBF, 0xC0]
    var checked = 0
    var mismatched = 0
    for lead in 0..256 {
        for a in edges {
            for b in edges {
                for c in edges {
                    let bytes: []u8 = [u8(lead), a, b, c]
                    for size in 1..5 {
                        let s = str(bytes[0..size])
                        checked += 1
                        if !same(walked(s), decoded(s)) {
                            mismatched += 1
                        }
                    }
                }
            }
        }
    }
    print("checked {checked}")
    print("mismatched {mismatched}")
}
