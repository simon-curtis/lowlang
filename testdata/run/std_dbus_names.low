import std/dbus
import std/text

fn repeat(unit: str, n: i64) -> str {
    var parts: []str = []
    for i in 0..n {
        push(mut parts, unit)
    }
    text.join(parts, "")
}

struct Case {
    name: str
    valid: bool
}

fn valid(name: str) -> Case {
    Case { name, valid: true }
}

fn invalid(name: str) -> Case {
    Case { name, valid: false }
}

fn run(kind: str, cases: []Case, check: fn(str) -> bool) -> i64 {
    var wrong = 0
    for c in cases {
        if check(c.name) != c.valid {
            print("{kind} {text.quote(c.name)}: expected {c.valid}")
            wrong += 1
        }
    }
    print("{kind}: {cases.len} names, {wrong} wrong")
    wrong
}

fn main() {
    let paths = [
        valid("/"),
        valid("/a"),
        valid("/a/b_c/D1"),
        valid("/org/freedesktop/DBus"),
        valid("/{repeat("a", 300)}"),
        invalid(""),
        invalid("a"),
        invalid("//"),
        invalid("/a/"),
        invalid("/a//b"),
        invalid("/a-b"),
        invalid("/a.b"),
        invalid("/é"),
    ]
    let interfaces = [
        valid("org.freedesktop.DBus"),
        valid("a.b"),
        valid("A.B_c1"),
        valid("_a._b"),
        valid("a.{repeat("b", 253)}"),
        invalid("a.{repeat("b", 254)}"),
        invalid(""),
        invalid("a"),
        invalid(".a.b"),
        invalid("a..b"),
        invalid("a.b."),
        invalid("a.1b"),
        invalid("a.b-c"),
        invalid("a.b$"),
    ]
    let members = [
        valid("Ping"),
        valid("_x1"),
        valid(repeat("a", 255)),
        invalid(repeat("a", 256)),
        invalid(""),
        invalid("1a"),
        invalid("a.b"),
        invalid("a-b"),
    ]
    let buses = [
        valid(":1.42"),
        valid(":1.2.3"),
        valid(":1.2-3"),
        valid("org.example.Svc"),
        valid("org.example.my-svc"),
        valid("org.example.{repeat("a", 243)}"),
        invalid("org.example.{repeat("a", 244)}"),
        invalid(":1"),
        invalid(":1."),
        invalid("org.1x"),
        invalid("nodots"),
        invalid(""),
        invalid(".a.b"),
    ]
    var wrong = 0
    wrong += run("object path", paths, fn(s) { dbus.valid_object_path(s) })
    wrong += run("interface", interfaces, fn(s) { dbus.valid_interface(s) })
    wrong += run("member", members, fn(s) { dbus.valid_member(s) })
    wrong += run("error name", interfaces, fn(s) { dbus.valid_error_name(s) })
    wrong += run("bus name", buses, fn(s) { dbus.valid_bus_name(s) })
    print("wrong {wrong}")
}
