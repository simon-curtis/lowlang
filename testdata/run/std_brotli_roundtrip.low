import std/compress/brotli
import std/io

fn same(a: []u8, b: []u8) -> bool {
    if a.len != b.len {
        return false
    }
    for i in 0..a.len {
        if a[i] != b[i] {
            return false
        }
    }
    true
}

fn text(n: i64) -> []u8 {
    let words = ["the", "window", "of", "stream", "and", "literal", "context", "dictionary", "block", "with", "Huffman", "is"]
    let out = io.buffer(n)
    var at = 0
    var seed: u32 = 12345
    for at < n {
        seed = seed * 1103515245 + 12345
        let w = words[i64(seed >> 16) % words.len]
        for i in 0..w.len {
            if at < n {
                out[at] = w[i]
                at += 1
            }
        }
        if at < n {
            out[at] = if seed & 0x700 == 0 { '\n' } else { ' ' }
            at += 1
        }
    }
    out
}

fn noise(n: i64) -> []u8 {
    let out = io.buffer(n)
    var s: u64 = 88172645463325252
    for i in 0..n {
        s ^= s << 13
        s ^= s >> 7
        s ^= s << 17
        out[i] = u8(s >> 32)
    }
    out
}

fn repeated(n: i64) -> []u8 {
    let out = io.buffer(n)
    for i in 0..n {
        out[i] = u8(i % 7 + i / 50000)
    }
    out
}

fn roundtrip(label: str, data: []u8, level: i64) {
    let packed = brotli.compress(data, level)
    let back = brotli.decompress(packed, data.len) catch {
        Malformed => {
            print("{label} q{level} Malformed")
            return
        }
        TooLarge => {
            print("{label} q{level} TooLarge")
            return
        }
        _ => {
            print("{label} q{level} other")
            return
        }
    }
    print("{label} q{level} {data.len} -> {packed.len} {if same(back, data) { "ok" } else { "differs" }}")
}

struct Collected {
    data: []u8
}

fn collected_sink(c: *Collected) -> fn([]u8) ! io.Error {
    fn(chunk) {
        for b in chunk {
            push(mut c.data, b)
        }
    }
}

fn dribble(data: []u8, step: i64) -> *io.Reader {
    var at = 0
    io.reader(io.Stream {
        read: fn(buf) -> i64 ! io.Error {
            var n = data.len - at
            if n > step {
                n = step
            }
            if n > buf.len {
                n = buf.len
            }
            io.copy(buf, data[at..at + n])
            at += n
            n
        }
        write: fn(buf) -> i64 ! io.Error { fail Unsupported }
        close: fn() {}
    })
}

fn streaming(data: []u8) ! io.Error {
    let packed = new(Collected { data: [] })
    let e = brotli.encoder(5, collected_sink(packed))
    let cut = 100000
    var at = 0
    var step = 1
    for at < cut {
        let end = if at + step > cut { cut } else { at + step }
        brotli.encode(e, data[at..end])?
        at = end
        step = step * 3 + 1
    }
    brotli.flush(e)?
    let partial = new(Collected { data: [] })
    var status = "complete"
    brotli.decode(io.bytes_reader(packed.data), collected_sink(partial), 1 << 24) catch {
        Malformed => {
            status = "stops at the flush point"
        }
        _ => {
            status = "other"
        }
    }
    print("flushed prefix {if same(partial.data, data[..cut]) { "ok" } else { "differs" }}, {status}")
    brotli.encode(e, data[cut..])?
    brotli.finish(e)?
    var late = "accepted"
    brotli.encode(e, data[..1]) catch {
        Invalid => {
            late = "Invalid"
        }
        _ => {
            late = "other"
        }
    }
    print("encode after finish {late}")
    let whole = brotli.decompress(packed.data, data.len) or {
        print("streamed decompress failed")
        return
    }
    print("streamed encoder {if same(whole, data) { "ok" } else { "differs" }}")
    var chunks = 0
    let out = new(Collected { data: [] })
    let sink = collected_sink(out)
    let counting: fn([]u8) ! io.Error = fn(chunk) {
        chunks += 1
        sink(chunk)?
    }
    brotli.decode(dribble(packed.data, 7), counting, data.len)?
    print("dribbled decode {if same(out.data, data) { "ok" } else { "differs" }}, chunked {chunks > 1 && chunks < data.len / 16}")
    var limited = "complete"
    brotli.decode(dribble(packed.data, 4096), counting, data.len - 1) catch {
        TooLarge => {
            limited = "TooLarge"
        }
        _ => {
            limited = "other"
        }
    }
    print("decode limit {limited}")
}

fn main() ! io.Error {
    let empty: []u8 = []
    let one: []u8 = [42]
    let words = text(200000)
    for level in [0, 1, 5, 11] {
        roundtrip("empty", empty, level)
        roundtrip("one", one, level)
    }
    for level in [0, 1, 3, 4, 5, 7, 9, 11] {
        roundtrip("text", words, level)
    }
    for level in [1, 6] {
        roundtrip("noise", noise(70000), level)
        roundtrip("repeated", repeated(300000), level)
    }
    roundtrip("blocks", text(700000), 5)
    streaming(text(400000))?
}
