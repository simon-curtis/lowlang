import std/crypto/blake3
import std/crypto/hash
import std/text

fn pattern(n: i64) -> []u8 {
    var out: []u8 = []
    for i in 0..n {
        push(mut out, u8(i % 251))
    }
    out
}

fn key() -> []u8 {
    bytes("whats the Elvish word for friend")
}

fn context() -> str {
    "BLAKE3 2019-12-27 16:29:52 test vectors context"
}

fn hex(data: []u8) -> str {
    text.encode_hex(data)
}

fn keyed(data: []u8) -> []u8 {
    blake3.keyed_hash(key(), data) catch { _ => [] }
}

fn lengths() -> []i64 {
    [0, 1, 2, 3, 4, 5, 6, 7, 8, 63, 64, 65, 127, 128, 129, 1023, 1024, 1025, 2048, 2049, 3072, 3073, 4096, 4097, 5120, 5121, 6144, 6145, 7168, 7169, 8192, 8193, 16384, 31744, 102400]
}

fn vectors() {
    print("-- official input pattern, hash keyed derive_key")
    let all = pattern(102400)
    for n in lengths() {
        let input = all[..n]
        let plain = hex(blake3.sum(input))
        let mac = hex(keyed(input))
        let derived = hex(blake3.derive_key(context(), input, 32))
        print("{n} {plain} {mac} {derived}")
    }
}

fn extended() {
    print("-- extended output 131 bytes")
    let all = pattern(102400)
    for n in [0, 1, 1025, 31744] {
        print("{n} {hex(blake3.xof(all[..n], 131))}")
    }
    print("-- keyed extended 131, derive_key extended 131 at 2049")
    let input = all[..2049]
    let h = blake3.keyed_hasher(key()) catch { _ => blake3.hasher() }
    blake3.update(h, input)
    print(hex(blake3.finalize(h, 131)))
    print(hex(blake3.derive_key(context(), input, 131)))
    print("-- seek 2049 at 100 len 31 and at 64 len 64")
    let plain = blake3.hasher()
    blake3.update(plain, input)
    print(hex(blake3.finalize_at(plain, 100, 31)))
    print(hex(blake3.finalize_at(plain, 64, 64)))
    print("-- abc")
    print(hex(blake3.sum(bytes("abc"))))
}

fn chunked(data: []u8, step: i64) -> []u8 {
    let h = blake3.hasher()
    var at = 0
    for at < data.len {
        let end = if at + step < data.len { at + step } else { data.len }
        blake3.update(h, data[at..end])
        at = end
    }
    blake3.finalize(h, 32)
}

fn incremental() {
    print("-- incremental")
    let all = pattern(102400)
    var agree = true
    for n in [0, 1, 63, 64, 65, 1023, 1024, 1025, 2048, 2049, 3073, 8193, 31744, 102400] {
        let data = all[..n]
        let want = hex(blake3.sum(data))
        for step in [1, 7, 63, 64, 65, 1000, 1024, 1025, 4096] {
            if hex(chunked(data, step)) != want {
                agree = false
            }
        }
    }
    print("chunked agrees with one-shot: {agree}")
    let h = blake3.hasher()
    blake3.update(h, all[..3000])
    let snapshot = blake3.clone(h)
    blake3.update(h, all[3000..9000])
    blake3.update(snapshot, all[3000..9000])
    print("clone: {hex(blake3.finalize(h, 32)) == hex(blake3.sum(all[..9000]))} {hex(blake3.finalize(snapshot, 32)) == hex(blake3.finalize(h, 32))}")
    print("finalize does not consume: {hex(blake3.finalize(h, 32)) == hex(blake3.finalize(h, 32))}")
    let longer = blake3.finalize(h, 200)
    print("prefix property: {hex(longer[..32]) == hex(blake3.finalize(h, 32))} {longer.len}")
}

fn algorithm() {
    print("-- algorithm")
    let all = pattern(5000)
    let a = blake3.algorithm()
    print("{a.name} {a.size} {a.block}")
    print(hex(hash.sum(a, all)) == hex(blake3.sum(all)))
    let d = a.digest()
    d.update(all[..2500])
    let c = d.clone()
    d.update(all[2500..])
    c.update(all[2500..])
    print(hex(d.finish()) == hex(blake3.sum(all)))
    print(hex(c.finish()) == hex(blake3.sum(all)))
    let mac = hash.hmac(a, bytes("key"), bytes("message"))
    print(hex(mac))
}

fn errors() {
    print("-- errors")
    let short = blake3.keyed_hash(bytes("short"), bytes("x")) catch {
        BadKey => bytes("rejected")
    }
    print(str(short))
}

fn main() {
    vectors()
    extended()
    incremental()
    algorithm()
    errors()
}
