struct Shared {
    closed: bool
    uses: i64
    closes: i64
}

struct Handle {
    id: i64
    shared: *Shared
}

struct Resource {
    handle: Handle
    detached: bool = false
    drop {
        if !detached {
            close_on(handle)
        }
    }
}

enum Failure {
    Closed
}

fn open(id: i64) -> Resource {
    print("open {id}")
    Resource { handle: Handle { id, shared: new(Shared { closed: false, uses: 0, closes: 0 }) } }
}

fn adopt(h: Handle) -> Resource {
    Resource { handle: h }
}

fn detach(mut r: Resource) -> Handle {
    r.detached = true
    r.handle
}

fn close_on(h: Handle) {
    if !h.shared.closed {
        h.shared.closed = true
        h.shared.closes += 1
    }
}

fn read_on(h: Handle) -> i64 ! Failure {
    if h.shared.closed {
        fail Closed
    }
    h.shared.uses += 1
    h.id * 10 + h.shared.uses
}

fn read(r: Resource) -> i64 ! Failure {
    read_on(r.handle)?
}

fn close(r: Resource) {
    close_on(r.handle)
}

fn worker(h: Handle, done: chan[i64]) {
    using owned = adopt(h)
    done <- read(owned) or -1
}

fn probe(h: Handle) -> str {
    let n = read_on(h) catch {
        Closed => return "closed"
    }
    "read {n}"
}

fn wrapped(id: i64) -> Handle {
    using var r = open(id)
    detach(mut r)
}

fn main() ! Failure {
    using a = open(1)
    print(read(a)?)
    let view = a.handle
    print(probe(view))
    close(a)
    close(a)
    print(probe(view))
    print(view.shared.closes)

    using b = open(2)
    let done = chan[i64](1)
    spawn worker(b.handle, done)
    print((<-done) ?? -2)
    sleep(20)
    print(probe(b.handle))
    print(b.handle.shared.closes)

    let kept = wrapped(3)
    print(probe(kept))
    close_on(kept)
    print(probe(kept))
    print(kept.shared.closes)
    print("end of main")
}
