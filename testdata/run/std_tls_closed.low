import std/crypto/x509
import std/io
import std/net
import std/tls

fn roots() -> []x509.Certificate {
    var out: []x509.Certificate = []
    for der in x509.pem_certificates(embed("std_tls_ca.pem")) {
        push(mut out, x509.parse(der) catch {
            _ => return out
        })
    }
    out
}

fn echo(l: net.ListenerHandle, config: tls.Config, done: chan[str]) {
    let h = net.accept_handle(l) catch {
        _ => {
            done <- "accept failed"
            return
        }
    }
    using c = net.adopt(h)
    using t = tls.server(net.stream(c), config) catch {
        _ => {
            done <- "handshake failed"
            return
        }
    }
    let s = tls.stream(t)
    let line = io.read_line(io.reader(s)) catch "?"
    io.write_str(s, "{line}\n") catch {
        _ => {}
    }
    let rest = io.read_line(io.reader(s)) catch "eof"
    done <- "server saw [{line}] then [{rest}]"
}

fn kind(r: fn() -> i64 ! io.Error) -> str {
    let n = r() catch {
        NotConnected => return "NotConnected"
        _ => return "other error"
    }
    "ok {n}"
}

fn main() ! io.Error {
    let pem = embed("std_tls_ec.pem")
    let config = tls.Config { certificates: x509.pem_certificates(pem), key: x509.pem_private_key(pem)? }
    using l = net.listen("127.0.0.1", 0)?
    let done = chan[str](1)
    spawn echo(l.handle, config, done)
    using conn = net.connect(l.handle.addr)?
    using t = tls.client(net.stream(conn), tls.Config { server_name: "localhost", roots: roots() })?
    let view = t.handle
    let wire = conn.handle
    let s = tls.stream(t)
    io.write_str(s, "hello\n")?
    let reply = io.read_line(io.reader(s))?
    print("reply [{reply}]")
    let buf = io.buffer(16)
    tls.close(t)
    tls.close(t)
    print("read after close: {kind(fn() -> i64 ! io.Error { tls.read_on(view, buf) })}")
    print("write after close: {kind(fn() -> i64 ! io.Error { tls.write_on(view, buf) })}")
    print("stream read after close: {kind(fn() -> i64 ! io.Error { s.read(buf) })}")
    print("stream write after close: {kind(fn() -> i64 ! io.Error { s.write(buf) })}")
    print("underlying connection read after close: {kind(fn() -> i64 ! io.Error { net.read_on(wire, buf) })}")
    print((<-done) ?? "")
}
