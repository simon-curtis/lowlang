import std/html
import std/text

struct Row {
    input: str
    mode: html.QuirksMode
}

fn name(mode: html.QuirksMode) -> str {
    match mode {
        Standards => "standards"
        LimitedQuirks => "limited-quirks"
        Quirks => "quirks"
    }
}

fn rows() -> []Row {
    [
        Row { input: "", mode: html.QuirksMode.Quirks }
        Row { input: "<p>x", mode: html.QuirksMode.Quirks }
        Row { input: "<!DOCTYPE html>", mode: html.QuirksMode.Standards }
        Row { input: "<!doctype HTML>", mode: html.QuirksMode.Standards }
        Row { input: "<!DOCTYPE>", mode: html.QuirksMode.Quirks }
        Row { input: "<!DOCTYPE foo>", mode: html.QuirksMode.Quirks }
        Row { input: "<!DOCTYPE html SYSTEM \"about:legacy-compat\">", mode: html.QuirksMode.Standards }
        Row { input: "<!DOCTYPE html PUBLIC \"-//W3C//DTD HTML 4.01//EN\" \"http://www.w3.org/TR/html4/strict.dtd\">", mode: html.QuirksMode.Standards }
        Row { input: "<!DOCTYPE html PUBLIC \"-//W3C//DTD HTML 4.01//EN\">", mode: html.QuirksMode.Standards }
        Row { input: "<!DOCTYPE html PUBLIC \"-//W3C//DTD HTML 4.01 Transitional//EN\">", mode: html.QuirksMode.Quirks }
        Row { input: "<!DOCTYPE html PUBLIC \"-//W3C//DTD HTML 4.01 Transitional//EN\" \"http://www.w3.org/TR/html4/loose.dtd\">", mode: html.QuirksMode.LimitedQuirks }
        Row { input: "<!DOCTYPE html PUBLIC \"-//W3C//DTD HTML 4.01 Frameset//EN\">", mode: html.QuirksMode.Quirks }
        Row { input: "<!DOCTYPE html PUBLIC \"-//W3C//DTD HTML 4.01 Frameset//EN\" \"http://www.w3.org/TR/html4/frameset.dtd\">", mode: html.QuirksMode.LimitedQuirks }
        Row { input: "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Transitional//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\">", mode: html.QuirksMode.LimitedQuirks }
        Row { input: "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Frameset//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-frameset.dtd\">", mode: html.QuirksMode.LimitedQuirks }
        Row { input: "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Strict//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd\">", mode: html.QuirksMode.Standards }
        Row { input: "<!DOCTYPE html PUBLIC \"-//W3C//DTD HTML 3.2 Final//EN\">", mode: html.QuirksMode.Quirks }
        Row { input: "<!DOCTYPE html PUBLIC \"-//IETF//DTD HTML//EN\">", mode: html.QuirksMode.Quirks }
        Row { input: "<!DOCTYPE html PUBLIC \"-//W3O//DTD W3 HTML Strict 3.0//EN//\">", mode: html.QuirksMode.Quirks }
        Row { input: "<!DOCTYPE html PUBLIC \"-/W3C/DTD HTML 4.0 Transitional/EN\">", mode: html.QuirksMode.Quirks }
        Row { input: "<!DOCTYPE html PUBLIC \"HTML\">", mode: html.QuirksMode.Quirks }
        Row { input: "<!DOCTYPE html PUBLIC \"-//microsoft//dtd internet explorer 3.0 html//en\">", mode: html.QuirksMode.Quirks }
        Row { input: "<!DOCTYPE html PUBLIC \"-//SOFTQUAD SOFTWARE//DTD HOTMETAL PRO 6.0::19990601::EXTENSIONS TO HTML 4.0//EN\">", mode: html.QuirksMode.Quirks }
        Row { input: "<!DOCTYPE html SYSTEM \"http://www.ibm.com/data/dtd/v11/ibmxhtml1-transitional.dtd\">", mode: html.QuirksMode.Quirks }
        Row { input: "<!DOCTYPE html PUBLIC \"-//W3C//DTD HTML 4.01 Transitional//EN\" \"about:legacy-compat\">", mode: html.QuirksMode.LimitedQuirks }
        Row { input: "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.1//EN\" \"http://www.w3.org/TR/xhtml11/DTD/xhtml11.dtd\">", mode: html.QuirksMode.Standards }
        Row { input: "<!DOCTYPE html PUBLIC>", mode: html.QuirksMode.Quirks }
        Row { input: "<!DOCTYPE html PUBLIC \"-//W3C//DTD HTML 4.01//EN\"", mode: html.QuirksMode.Quirks }
        Row { input: "<!DOCTYPE html SYSTEM>", mode: html.QuirksMode.Quirks }
        Row { input: "<!DOCTYPE html PUBLIC \"-//WEBTECHS//DTD MOZILLA HTML 2.0//EN\">", mode: html.QuirksMode.Quirks }
        Row { input: "<!DOCTYPE html PUBLIC \"-//W3C//DTD HTML EXPERIMENTAL 970421//EN\">", mode: html.QuirksMode.Quirks }
        Row { input: "<!DOCTYPE html PUBLIC \"-//W3C//DTD W3 HTML//EN\">", mode: html.QuirksMode.Quirks }
        Row { input: "<!DOCTYPE html PUBLIC \"-//AS//DTD HTML 3.0 asWedit + extensions//EN\">", mode: html.QuirksMode.Quirks }
        Row { input: "<!DOCTYPE html PUBLIC \"-//Netscape Comm. Corp.//DTD Strict HTML//EN\">", mode: html.QuirksMode.Quirks }
        Row { input: "<!DOCTYPE html PUBLIC \"+//Silmaril//dtd html Pro v0r11 19970101//\">", mode: html.QuirksMode.Quirks }
        Row { input: "<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0//EN\">", mode: html.QuirksMode.Standards }
        Row { input: "<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0 Transitional//EN\" \"http://www.w3.org/TR/REC-html40/loose.dtd\">", mode: html.QuirksMode.Quirks }
        Row { input: "<!--c--><!DOCTYPE html>", mode: html.QuirksMode.Standards }
        Row { input: "<!DOCTYPE html><!DOCTYPE html PUBLIC \"-//W3O//DTD W3 HTML Strict 3.0//EN//\">", mode: html.QuirksMode.Standards }
        Row { input: "<html><!DOCTYPE html PUBLIC \"-//W3O//DTD W3 HTML Strict 3.0//EN//\">", mode: html.QuirksMode.Quirks }
        Row { input: "x<!DOCTYPE html>", mode: html.QuirksMode.Quirks }
    ]
}

fn counts(doc: html.Parsed) -> str {
    var parts: []str = []
    for source in [".foo", ".FOO", ".Foo", "#main", "#MAIN", "#Main", "p.FOO", "[class~=FOO]", "[id=MAIN]", ".bar.FOO", ":not(.FOO)"] {
        let selector = html.compile(source) or panic("cannot compile {source}")
        push(mut parts, "{source}={html.query_all(doc.root, selector).len}")
    }
    text.join(parts, " ")
}

fn main() {
    var failed = 0
    for row in rows() {
        let parsed = html.parse(row.input)
        let marker = if parsed.quirks == row.mode { "ok  " } else { "FAIL" }
        if parsed.quirks != row.mode {
            failed += 1
        }
        print("{marker} {name(parsed.quirks)} {text.quote(row.input)}")
        let recorded = match parsed.root.data {
            Document(quirks) => quirks
            _ => html.QuirksMode.Standards
        }
        if recorded != parsed.quirks {
            failed += 1
            print("FAIL document records {name(recorded)}")
        }
    }
    print("mode mismatches: {failed}")

    let body = "<p id=\"Main\" class=\"Foo bar\">x</p><p id=\"main\" class=\"foo\">y</p>"
    print("no doctype: {counts(html.parse(body))}")
    print("standards: {counts(html.parse("<!DOCTYPE html>{body}"))}")
    print("limited: {counts(html.parse("<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Transitional//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\">{body}"))}")
    print("quirks doctype: {counts(html.parse("<!DOCTYPE html PUBLIC \"-//W3C//DTD HTML 4.01 Transitional//EN\">{body}"))}")
    print("fragment: {counts(html.parse_fragment(html.create_element(html.Namespace.Html, "body", []), body))}")
    print("created: {html.matches(html.create_element(html.Namespace.Html, "p", []), html.compile(".A") or panic("compile"))}")
}
