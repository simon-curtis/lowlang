import std/compress/deflate
import std/hash
import std/io
import std/text

fn hex(s: str) -> []u8 {
    text.decode_hex(s) or []
}

fn show(name: str, run: fn() -> []u8 ! io.Error) {
    let out = run() catch {
        Malformed => {
            print("{name}: Malformed")
            return
        }
        TooLarge => {
            print("{name}: TooLarge")
            return
        }
        Unsupported => {
            print("{name}: Unsupported")
            return
        }
        _ => {
            print("{name}: other error")
            return
        }
    }
    if out.len <= 64 {
        print("{name}: {str(out)}")
        return
    }
    print("{name}: {out.len} bytes crc {hash.crc32(out)}")
}

fn zlib_hello() -> []u8 {
    hex("789ccb48cdc9c95728cf2fca4901001a0b045d")
}

fn gzip_fields() -> []u8 {
    hex("1f8b081e00000000000306004142020078796e616d652e747874006120636f6d6d656e7400fd5b4bccc951c8484d4c492d5248cb4ccd49295628284a2d4ecd2b0100b69cc17119000000")
}

fn vectors() {
    show("zlib", fn() { deflate.zlib_decompress(zlib_hello(), 100) })
    show("stored", fn() { deflate.decompress(hex("010c00f3ff73746f72656420626c6f636b"), 100) })
    show("fixed", fn() { deflate.decompress(hex("4bcbac484d51484322334ad3d27213f300"), 100) })
    show("dynamic", fn() { deflate.decompress(hex("8dd4510a82501484e1f7567196d099b1b4e588de8b825e212c68f7d10afadfffa78f61b6b595b8c651e35c4acc9f36eeeb14cbabd67d6cf12ed3793c2fdb2f4a128944265147a21b89ee24ea493490e881301939324f849e483d117b22f744f089e413d127b217b217db3bb217b217b217b217b217b217b217b237b237b2373b1b646f646f646f646f646f64ef7ff65f"), 10000) })
    show("gzip fields", fn() { deflate.gzip_decompress(gzip_fields(), 100) })
    show("gzip members", fn() { deflate.gzip_decompress(hex("1f8b08000000000002ff4bcb2c2a2e510000fc7af11c060000001f8b08000000000002ff030000000000000000001f8b08000000000002ff2b4e4dcecf4b010069111fb606000000"), 100) })
}

fn flipped(data: []u8, at: i64) -> []u8 {
    var out: []u8 = []
    io.append(mut out, data)
    out[at] ^= 0x01
    out
}

fn errors() {
    let z = zlib_hello()
    show("zlib truncated", fn() { deflate.zlib_decompress(z[..z.len - 3], 100) })
    show("zlib adler", fn() { deflate.zlib_decompress(flipped(z, z.len - 1), 100) })
    show("zlib header", fn() { deflate.zlib_decompress(flipped(z, 1), 100) })
    show("zlib dictionary", fn() { deflate.zlib_decompress(hex("78bb00000000"), 100) })
    show("zlib over limit", fn() { deflate.zlib_decompress(z, 10) })
    show("zlib at limit", fn() { deflate.zlib_decompress(z, 11) })
    let g = gzip_fields()
    show("gzip header crc", fn() { deflate.gzip_decompress(flipped(g, 30), 100) })
    show("gzip crc", fn() { deflate.gzip_decompress(flipped(g, g.len - 6), 100) })
    show("gzip size", fn() { deflate.gzip_decompress(flipped(g, g.len - 2), 100) })
    show("gzip magic", fn() { deflate.gzip_decompress(flipped(g, 0), 100) })
    show("gzip trailing byte", fn() { deflate.gzip_decompress(hex("1f8b08000000000002ff030000000000000000001f"), 100) })
    show("block type 3", fn() { deflate.decompress(hex("07"), 100) })
    show("stored length", fn() { deflate.decompress(hex("010c00f4ff73746f72656420626c6f636b"), 100) })
    show("distance too far", fn() { deflate.decompress(hex("4b044200"), 100) })
    show("oversubscribed", fn() { deflate.decompress(hex("050092040000"), 100) })
    show("empty input", fn() { deflate.decompress([], 100) })
}

fn generated(n: i64) -> []u8 {
    let words = ["alpha ", "beta ", "gamma ", "delta ", "stream ", "window ", "huffman ", "\n"]
    var out: []u8 = []
    var seed: u64 = 12345
    for out.len < n {
        seed = seed * 6364136223846793005 + 1442695040888963407
        io.append(mut out, bytes(words[i64(seed >> 61)]))
    }
    out[..n]
}

fn streaming() ! io.Error {
    let data = generated(200000)
    var encoded: []u8 = []
    let e = deflate.encoder(Gzip, 6, fn(chunk) { io.append(mut encoded, chunk) })
    deflate.encode(e, data[..120000])?
    deflate.flush(e)?
    let cut = encoded.len
    deflate.encode(e, data[120000..])?
    deflate.finish(e)?
    let marker = encoded[cut - 4..cut]
    print("flush marker: {marker[0]} {marker[1]} {marker[2]} {marker[3]}")
    var served = 0
    var received = 0
    var chunks = 0
    var before_cut = -1
    let source = io.Stream {
        read: fn(buf) {
            if served == cut && before_cut < 0 {
                before_cut = received
            }
            let end = if served < cut { cut } else { encoded.len }
            let n = io.copy(buf, encoded[served..if end - served > 1000 { served + 1000 } else { end }])
            served += n
            n
        }
        write: fn(buf) -> i64 ! io.Error { fail Unsupported }
        close: fn() {}
    }
    var decoded: []u8 = []
    deflate.gzip_decode(io.reader(source), fn(chunk) {
        received += chunk.len
        chunks += 1
        io.append(mut decoded, chunk)
    }, 1 << 20)?
    print("output before reading past flush: {before_cut}")
    print("streamed: {decoded.len == data.len && hash.crc32(decoded) == hash.crc32(data)} chunked: {chunks > 1 && chunks < 1000}")
    deflate.gzip_decode(io.bytes_reader(encoded), fn(chunk) {}, 150000) catch {
        TooLarge => {
            print("stream limit: TooLarge")
            return
        }
        _ => {
            print("stream limit: other error")
            return
        }
    }
    print("stream limit: not enforced")
}

fn main() ! io.Error {
    vectors()
    errors()
    streaming()?
}
