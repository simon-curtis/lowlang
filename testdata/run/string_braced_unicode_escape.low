fn main() {
    print("\u{41}\u{42}")
    print("\u{e9} \u{E9} \u{00e9} \u{0000e9}")
    print("\u{1F600} \u{1f600} \u{10FFFF}".len)
    print("\u{1F600}")
    print("\u{10FFFF}".len)
    let nul = "\u{0}"
    print(nul.len)
    print(nul[0])
    print("a\u{0}b".len)
    let x = 1
    let y = 2
    let mixed = "{x}\u{2028}{y}"
    print(mixed.len)
    print(mixed == "1\u20282")
    print("{{\u{7B}}} \u{7D}\u{7b}")
    print("{{x}}\u{41}{{")
    print("{"\u{41}"}")
    print("{"\u{e9}".len}")
    print("\u{41}\x42\u0043\U00000044\u{45}")
    print("{x}\u{3b1}{y}\u{3B2}")
    print('\u{41}')
    print('\u{e9}')
    print('\u{2028}')
    print('\u{1F600}')
    print('\u{10FFFF}')
    print('\u{0}')
    print('\u{000041}')
    print("\u{41}" == "A")
    print("\u{e9}" == "é")
    print("\u{1F600}" == "\U0001F600")
}
