        "2026-1111", "2026-11-11x", "-", "-2026",
        "2026-11-11-", "2026-W", "2026W", "-9999-W01-1",
        "9999-W52-7", "9999-W53-1", "-9999-W01-7", "9999-W01-1",
        "0000-W01-1", "0000-W53-1", "-0001-W53-1", "2026-W53-1",
        "2026-W53-7", "2027-W01-1", "2026 11 11", "20261111 ",
        "2026-366-", "2024-366", "202636", "-2026-11-11",
        "-20261111"
    ]
    for s in invalid {
        print("parse {parsed(s)}")
    }
}

fn ordering() {
    print("-- compare")
    let all = [
        -9999, 1, 1, 0, 2, 29, 1970, 1, 1, 2026, 11, 11,
        2026, 11, 12, 9999, 12, 31
    ]
    var i = 0
    var ds: []date.Date = []
    for i + 2 < all.len {
        push(mut ds, dt(all[i], all[i + 1], all[i + 2]))
        i += 3
    }
    for a in ds {
        var row = ""
        for b in ds {
            row = "{row}{date.compare(a, b)} "
        }
        print("compare {dated(a)} {row}")
    }
    for a in ds {
        for b in ds {
            print("order {dated(a)} {dated(b)} {date.equal(a, b)} {date.before(a, b)} {date.after(a, b)} {dated(date.min(a, b))} {dated(date.max(a, b))} {a == b}")
        }
    }
}

fn today_text(secs: i64) -> str {
    let ts = timestamp.from_unix(secs) catch {
        e => return describe(e)
    }
    dated(date.today(clock.fixed(ts)))
}

fn today() {
    print("-- today")
    for secs in [
        0, 86399, 86400, -1, -86400, -86401, 1794391200, 253402300799,
        -62135596800, 951782400, 1709208000
    ] {
        print("today {secs} {today_text(secs)}")
    }
    print("limits {dated(date.epoch())} {dated(date.earliest())} {dated(date.latest())}")
}

fn main() {
    names()
    leap_years()
    constructors()
    conversions()
    accessors()
    arithmetic()
    weekdays()
    sweep()
    until_matrix()
    property()
    parsing()
    ordering()
    today()
}
