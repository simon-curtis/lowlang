fn date_line(d: date.Date) -> str {
    let w = date.iso_week(d)
    let a = "year {date.year(d)} month {date.month_name(date.month(d))} {date.month_number(d)} day {date.day(d)} wd {date.weekday_name(date.weekday(d))} doy {date.day_of_year(d)} epoch {date.epoch_days(d)}"
    let b = "dim {date.days_in_month(d)} diy {date.days_in_year(d)} leap {date.is_leap_year(d)} iso {w.year}-W{w.week} q {date.quarter(d)}"
    let c = "fm {dated(date.first_of_month(d))} lm {dated(date.last_of_month(d))} fy {dated(date.first_of_year(d))} ly {dated(date.last_of_year(d))}"
    "{dated(d)} {a} {b} {c}"
}

fn with_day_text(d: date.Date, n: i64) -> str {
    let r = date.with_day(d, n) catch {
        e => return describe(e)
    }
    dated(r)
}

fn with_year_text(d: date.Date, y: i64) -> str {
    let r = date.with_year(d, y) catch {
        e => return describe(e)
    }
    dated(r)
}

fn accessors() {
    print("-- accessors")
    let all = [
        2026, 11, 11, 2020, 12, 31, 2021, 1, 3, 2021, 1, 4,
        2026, 1, 1, 2027, 1, 3, 2027, 1, 4, 2024, 2, 29,
        2000, 2, 29, 1900, 2, 28, 1900, 3, 1, 2100, 12, 31,
        1970, 1, 1, 1969, 12, 31, 1, 1, 1, 0, 1, 1,
        0, 12, 31, -1, 12, 31, -4, 2, 29, -9999, 1, 1,
        -9999, 12, 31, 9999, 1, 1, 9999, 12, 31, 2015, 12, 31,
        2016, 1, 1, 2016, 1, 3, 2018, 12, 31, 2019, 1, 1,
        2008, 12, 29, 2010, 1, 3, 1998, 12, 31, 1999, 1, 1,
        2026, 12, 31, 2025, 12, 29, 2025, 12, 28, 2024, 12, 30,
        2023, 1, 1, 2022, 1, 2, 2026, 7, 1, 2026, 4, 1,
        2026, 10, 1, 2026, 3, 31, 2026, 6, 30, 2026, 9, 30
    ]
    var i = 0
    for i + 2 < all.len {
        print("acc {date_line(dt(all[i], all[i + 1], all[i + 2]))}")
        i += 3
    }
    print("-- with")
    let bases = [
        2024, 2, 29, 2024, 1, 31, 2023, 3, 31, 2020, 12, 31,
        2000, 2, 29, 1900, 2, 28, -4, 2, 29, 9999, 12, 31,
        -9999, 1, 1
    ]
    i = 0
    for i + 2 < bases.len {
        let d = dt(bases[i], bases[i + 1], bases[i + 2])
        for n in [0, 1, 15, 28, 29, 30, 31, 32, -1] {
            print("with_day {dated(d)} {n} {with_day_text(d, n)}")
        }
        for n in 1..13 {
            print("with_month {dated(d)} {n} {dated(date.with_month(d, month_at(n)))}")
        }
        for y in [2024, 2023, 2100, 2000, 1900, 0, -4, -9999, 9999, 10000, -10000, 1] {
            print("with_year {dated(d)} {y} {with_year_text(d, y)}")
        }
        i += 3
    }
}

fn plus_months_text(d: date.Date, n: i64) -> str {
    let r = date.plus_months(d, n) catch {
        e => return describe(e)
    }
    dated(r)
}

fn plus_years_text(d: date.Date, n: i64) -> str {
    let r = date.plus_years(d, n) catch {
        e => return describe(e)
    }
    dated(r)
}

fn plus_days_text(d: date.Date, n: i64) -> str {
    let r = date.plus_days(d, n) catch {
        e => return describe(e)
    }
    dated(r)
}

fn plus_weeks_text(d: date.Date, n: i64) -> str {
    let r = date.plus_weeks(d, n) catch {
        e => return describe(e)
    }
    dated(r)
}

fn chain(d: date.Date) -> str {
    var row = ""
    var current = d
    for _ in 0..14 {
        current = date.plus_months(current, 1) or current
        row = "{row}{dated(current)} "
    }
    row
}

fn plus_span_text(d: date.Date, s: span.Span) -> str {
    let r = date.plus(d, s) catch {
        e => return describe(e)
    }
    let m = date.minus(d, s) catch {
        e => return "{dated(r)} | {describe(e)}"
    }
    "{dated(r)} | {dated(m)}"
}

fn arithmetic() {
    print("-- plus_months")
    let starts = [
        2026, 1, 31, 2024, 2, 29, 2023, 8, 31, 2026, 3, 31,
        2020, 1, 30, 1900, 1, 31, -4, 2, 29, 9999, 12, 31,
        -9999, 1, 1, 2026, 11, 11
    ]
    var i = 0
    for i + 2 < starts.len {
        let d = dt(starts[i], starts[i + 1], starts[i + 2])
        var months: []str = []
        for k in -15..16 {
            push(mut months, "plus_months {dated(d)} {k} {plus_months_text(d, k)}")
        }
        show_group("plus_months {dated(d)}", months)
        for k in [100, -100, 1000, -1000, 119988, -119988, 120000, 239999, 999999999999, 1000000000000, 1000000000001, -1000000000001] {
            print("plus_months {dated(d)} {k} {plus_months_text(d, k)}")
        }
        print("chain {dated(d)} {chain(d)}")
        var years: []str = []
        for k in -9..10 {
            push(mut years, "plus_years {dated(d)} {k} {plus_years_text(d, k)}")
        }
        show_group("plus_years {dated(d)}", years)
        for k in [100, -100, 2000, -2000, 7999, 8000, 10000, -10000, 1000000000, 1000000001, -1000000001] {
            print("plus_years {dated(d)} {k} {plus_years_text(d, k)}")
        }
        i += 3
    }
    print("-- plus_days")
    let day_starts = [
        2026, 11, 11, 2000, 2, 29, 1970, 1, 1, 9999, 12, 31,
        -9999, 1, 1, 0, 1, 1, 1, 1, 1
    ]
    i = 0
    for i + 2 < day_starts.len {
        let d = dt(day_starts[i], day_starts[i + 1], day_starts[i + 2])
        for k in [0, 1, -1, 7, -7, 30, 31, 59, 60, 365, 366, -365, -366, 1461, -1461, 36524, 36525, -36524, 146097, -146097, 1000000, -1000000, 3652059, -3652059, 7304484, 7304485, -7304484, -7304485, 100000000, 100000001, -100000001] {
            print("plus_days {dated(d)} {k} {plus_days_text(d, k)}")
        }
        for k in [0, 1, -1, 52, 53, 1043, -1043, 10000000, 10000001, -10000001] {
            print("plus_weeks {dated(d)} {k} {plus_weeks_text(d, k)}")
        }
        i += 3
    }
    print("-- plus_span")
    let spans = [
