import std/text
import std/time/clock
import std/time/date
import std/time/duration
import std/time/fault
import std/time/rounding
import std/time/span
import std/time/timestamp

fn describe(e: fault.Fault) -> str {
    match e {
        Syntax(at) => "syntax {at}"
        Overflow => "overflow"
        Invalid(what) => "invalid {what}"
        OutOfRange(what) => "range {what}"
        _ => "other"
    }
}

fn mode_name(m: rounding.Rounding) -> str {
    match m {
        Trunc => "trunc"
        Ceil => "ceil"
        Floor => "floor"
        Expand => "expand"
        HalfExpand => "half_expand"
        HalfEven => "half_even"
        HalfTrunc => "half_trunc"
        HalfCeil => "half_ceil"
        HalfFloor => "half_floor"
    }
}

fn all_modes() -> []rounding.Rounding {
    [
        rounding.Rounding.Trunc,
        rounding.Rounding.Ceil,
        rounding.Rounding.Floor,
        rounding.Rounding.Expand,
        rounding.Rounding.HalfExpand,
        rounding.Rounding.HalfEven,
        rounding.Rounding.HalfTrunc,
        rounding.Rounding.HalfCeil,
        rounding.Rounding.HalfFloor
    ]
}

fn digest(lines: []str) -> i64 {
    var h = 7
    for line in lines {
        for i in 0..line.len {
            h = (h * 131 + i64(line[i])) % 2147483647
        }
        h = (h * 131 + 10) % 2147483647
    }
    h
}

fn show_group(label: str, lines: []str) {
    let keep = 2
    if lines.len <= 2 * keep {
        for line in lines {
            print(line)
        }
    } else {
        for i in 0..keep {
            print(lines[i])
        }
        print("... {lines.len - 2 * keep} more")
        for i in lines.len - keep..lines.len {
            print(lines[i])
        }
    }
    print("group {label} lines {lines.len} hash {digest(lines)}")
}

fn shape(s: span.Span) -> str {
    let c = span.counts(s)
    "{c[0]} {c[1]} {c[2]} {c[3]} {c[4]} {c[5]} {c[6]} {c[7]} {c[8]} {c[9]}"
}

fn dt(y: i64, m: i64, d: i64) -> date.Date {
    date.of(y, m, d) or date.epoch()
}

fn dated(r: date.Date) -> str {
    date.to_string(r)
}

fn month_at(n: i64) -> date.Month {
    date.month_from_number(n) or date.month(date.epoch())
}

fn weekday_at(n: i64) -> date.Weekday {
    date.weekday_from_number(n) or date.weekday(date.epoch())
}

fn month_text(n: i64) -> str {
    let m = date.month_from_number(n) catch {
        e => return describe(e)
    }
    date.month_name(m)
}

fn weekday_text(n: i64) -> str {
    let w = date.weekday_from_number(n) catch {
        e => return describe(e)
    }
    date.weekday_name(w)
}

fn names() {
    print("-- names")
    for n in 1..13 {
        let m = month_at(n)
        print("month {n} {date.month_name(m)} {date.month_short_name(m)} {date.month_to_number(m)} {date.month_name(date.month_next(m))} {date.month_name(date.month_previous(m))} {date.month_days(m, 2024)} {date.month_days(m, 2023)} {date.month_days(m, 1900)} {date.month_days(m, 2000)}")
    }
    for n in [0, 13, -1, 100] {
        print("month_from_number {n} {month_text(n)}")
    }
    for n in 1..8 {
        let w = weekday_at(n)
        print("weekday {n} {date.weekday_name(w)} {date.weekday_short_name(w)} {date.weekday_to_number(w)} {date.weekday_name(date.weekday_next(w))} {date.weekday_name(date.weekday_previous(w))}")
    }
    for n in [0, 8, -1, 100] {
        print("weekday_from_number {n} {weekday_text(n)}")
    }
    for a in 1..8 {
        var row = ""
        for b in 1..8 {
            row = "{row}{date.weekday_days_until(weekday_at(a), weekday_at(b))} "
        }
        print("weekday_days_until {a} {row}")
    }
}

fn leap_years() {
    print("-- leap")
    let years = [
        1600, 1700, 1800, 1900, 2000, 2100, 2200, 2300, 2400, 2023, 2024, 2025,
        2028, 1996, 1, 4, 0, -1, -4, -100, -96, -400, -300, -9999,
        -9996, 9999, 9996, 1970, 2026
    ]
    for y in years {
        let d = dt(y, 2, 1)
        print("leap {y} {date.is_leap_year(d)} {date.days_in_year(d)} {date.days_in_month(d)} {date.is_leap_year(dt(y, 12, 31))}")
    }
}

fn of_text(y: i64, m: i64, d: i64) -> str {
    let r = date.of(y, m, d) catch {
        e => return describe(e)
    }
    dated(r)
}

fn clamped_text(y: i64, m: i64, d: i64) -> str {
    let r = date.clamped(y, m, d) catch {
        e => return describe(e)
    }
    dated(r)
}

fn from_month_text(y: i64, m: i64, d: i64) -> str {
    let month = date.month_from_number(m) catch {
        e => return describe(e)
    }
    let r = date.from_month(y, month, d) catch {
        e => return describe(e)
    }
    dated(r)
}

fn constructors() {
    print("-- of")
    let table = [
        2026, 11, 11, 2000, 2, 29, 1900, 2, 28, 2024, 2, 29,
        1, 1, 1, 0, 1, 1, 0, 2, 29, -1, 12, 31,
        -4, 2, 29, -9999, 1, 1, -9999, 12, 31, 9999, 12, 31,
        9999, 1, 1, 1970, 1, 1, 2023, 12, 31, 1600, 2, 29,
        2400, 2, 29, -400, 2, 29, 1900, 2, 29, 2100, 2, 29,
        2023, 2, 29, -100, 2, 29, -1, 2, 29, 2026, 4, 31,
        2026, 6, 31, 2026, 9, 31, 2026, 11, 31, 2026, 2, 30,
        2026, 2, 31, 2026, 1, 32, 2026, 1, 0, 2026, 1, -1,
        2026, 0, 1, 2026, 13, 1, 2026, -1, 1, 10000, 1, 1,
        -10000, 1, 1, 9223372036854775807, 1, 1, 10000, 13, 40, 2026, 13, 40,
        2026, 2, 40, 2026, 12, 31, 2026, 1, 31, 2026, 3, 31,
        2026, 5, 31, 2026, 7, 31, 2026, 8, 31, 2026, 10, 31,
        2026, 2, 100, 2024, 2, 31, 2026, 4, 30, 2026, 2, 28
    ]
    var i = 0
    for i + 2 < table.len {
        print("of {table[i]} {table[i + 1]} {table[i + 2]} {of_text(table[i], table[i + 1], table[i + 2])}")
        print("clamped {table[i]} {table[i + 1]} {table[i + 2]} {clamped_text(table[i], table[i + 1], table[i + 2])}")
        print("from_month {table[i]} {table[i + 1]} {table[i + 2]} {from_month_text(table[i], table[i + 1], table[i + 2])}")
        i += 3
    }
}

fn epoch_text(n: i64) -> str {
    let r = date.from_epoch_days(n) catch {
        e => return describe(e)
    }
    "{dated(r)} {date.epoch_days(r)}"
}

fn ordinal_text(y: i64, n: i64) -> str {
    let r = date.from_ordinal(y, n) catch {
        e => return describe(e)
    }
    "{dated(r)} {date.day_of_year(r)}"
}

fn iso_text(y: i64, w: i64, n: i64) -> str {
    let day = date.weekday_from_number(n) catch {
        e => return describe(e)
    }
    let r = date.from_iso_week(y, w, day) catch {
        e => return describe(e)
    }
    let back = date.iso_week(r)
    "{dated(r)} {back.year}-W{back.week}"
}

fn weekday_in_month_text(y: i64, m: i64, w: i64, k: i64) -> str {
    let month = date.month_from_number(m) catch {
        e => return describe(e)
    }
    let day = date.weekday_from_number(w) catch {
        e => return describe(e)
    }
    let r = date.from_weekday_in_month(y, month, day, k) catch {
        e => return describe(e)
    }
    dated(r)
}

fn nth_line(t: []i64, i: i64) -> str {
    "nth {t[i]} {t[i + 1]} {t[i + 2]} {t[i + 3]} {weekday_in_month_text(t[i], t[i + 1], t[i + 2], t[i + 3])}"
}

