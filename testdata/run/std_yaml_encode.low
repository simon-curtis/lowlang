import std/yaml

enum Shape {
    Circle(radius: f64)
    Rect(f64, f64)
    Empty
}

struct Server {
    host: str
    port: u16
    tags: []str
}

struct Config {
    title: str
    ratio: f64
    big: u64
    enabled: bool
    owner: str?
    nickname: str?
    limits: [str: i64]
    ids: [i64: str]
    servers: []Server
    shapes: []Shape
    key: []u8
    notes: str
}

fn serialize_text[T](v: T) -> str {
    yaml.serialize(v) catch {
        Syntax(at, message) => "syntax {at}: {message}"
        Mismatch(expected, at) => "mismatch {expected} at line {at}"
        Missing(field) => "missing {field}"
        UnknownVariant(name) => "unknown variant {name}"
        Range(at) => "range at line {at}"
        TooDeep => "too deep"
    }
}

fn decode_config(source: str) -> Config? {
    let c: Config = yaml.deserialize(source) catch {
        Syntax(at, message) => {
            print("syntax {at}: {message}")
            return none
        }
        Mismatch(expected, at) => {
            print("mismatch {expected} at line {at}")
            return none
        }
        _ => {
            print("failed")
            return none
        }
    }
    c
}

fn deserialize_report[T](source: str) -> str {
    let v: T = yaml.deserialize(source) catch {
        Syntax(at, message) => return "syntax {at}: {message}"
        Mismatch(expected, at) => return "mismatch {expected} at line {at}"
        Missing(field) => return "missing {field}"
        UnknownVariant(name) => return "unknown variant {name}"
        Range(at) => return "range at line {at}"
        TooDeep => return "too deep"
    }
    "ok"
}

fn bytes_text(b: []u8) -> str {
    str(b)
}

fn strings() -> []str {
    [
        "plain words"
        ""
        " leading"
        "trailing "
        "true"
        "yes"
        "null"
        "~"
        "12"
        "0x1F"
        "1.5"
        ".inf"
        "1_000"
        "2001-12-14"
        "- dash"
        "-x"
        "key: value"
        "a #comment"
        "a#b"
        "#start"
        "[flow]"
        "it's"
        "tab\there"
        bytes_text(['b', 'e', 'l', 'l', 7])
        "line\nbreak\n"
        "  indented\nlines"
        "no newline\nat end"
        "keep\n\n"
        "\n"
        "---"
        "é ünïcödé"
        bytes_text(['n', 'e', 'l', 0xC2, 0x85])
    ]
}

fn main() {
    var items: []*yaml.Node = []
    for s in strings() {
        push(mut items, yaml.node(yaml.Value.Str(s)))
    }
    let shared = yaml.node(yaml.Value.Map([yaml.Pair { key: yaml.node(yaml.Value.Str("k")), value: yaml.node(yaml.Value.Int(1)) }]))
    let doc = yaml.node(yaml.Value.Map([
        yaml.Pair { key: yaml.node(yaml.Value.Str("strings")), value: yaml.node(yaml.Value.Seq(items)) }
        yaml.Pair { key: yaml.node(yaml.Value.Str("numbers")), value: yaml.node(yaml.Value.Seq([yaml.node(yaml.Value.Int(-7)), yaml.node(yaml.Value.Float(2.0)), yaml.node(yaml.Value.Float(1e21)), yaml.node(yaml.Value.Float(-1.0 / 0.0)), yaml.node(yaml.Value.Null), yaml.node(yaml.Value.Bool(false))])) }
        yaml.Pair { key: yaml.node(yaml.Value.Seq([yaml.node(yaml.Value.Int(1)), yaml.node(yaml.Value.Int(2))])), value: yaml.node(yaml.Value.Str("complex key")) }
        yaml.Pair { key: yaml.node(yaml.Value.Str("first")), value: shared }
        yaml.Pair { key: yaml.node(yaml.Value.Str("second")), value: shared }
        yaml.Pair { key: yaml.node(yaml.Value.Str("empty")), value: yaml.node(yaml.Value.Seq([])) }
        yaml.Pair { key: yaml.node(yaml.Value.Str("blob")), value: yaml.node(yaml.Value.Binary([0, 1, 2, 250])) }
        yaml.Pair { key: yaml.node(yaml.Value.Str("local")), value: new(yaml.Node { value: yaml.Value.Str("x"), tag: "!thing" }) }
    ]))
    let encoded = yaml.encode(doc)
    print(encoded)
    let back = yaml.parse(encoded) catch {
        Syntax(line, column, message) => {
            print("reparse failed {line}:{column} {message}")
            return
        }
        TooManyNodes(line, column) => return
    }
    print(yaml.encode(back) == encoded)
    let texts = yaml.get(back, "strings") ?? back
    var same = true
    for i, s in strings() {
        if (yaml.text(yaml.at(texts, i) ?? back) ?? "?") != s {
            print("mismatch at {i}")
            same = false
        }
    }
    print(same)
    print(yaml.encode_all([yaml.node(yaml.Value.Str("one")), yaml.node(yaml.Value.Seq([yaml.node(yaml.Value.Int(2))]))]))

    let config = Config {
        title: "demo: settings"
        ratio: 0.25
        big: 9000000000000000000
        enabled: true
        owner: "ann"
        nickname: none
        limits: ["cpu": 4, "mem": 512]
        ids: [7: "seven", -1: "minus"]
        servers: [Server { host: "alpha", port: 8080, tags: ["a", "yes"] }, Server { host: "beta", port: 9, tags: [] }]
        shapes: [Circle(1.5), Rect(2.0, 3.0), Empty]
        key: [104, 105]
        notes: "first line\nsecond line\n"
    }
    let text = serialize_text(config)
    print(text)
    let decoded = match decode_config(text) {
        some(c) => c
        none => return
    }
    print(decoded.title)
    print(decoded.big)
    print(decoded.owner ?? "none")
    print(decoded.nickname ?? "none")
    print(decoded.limits["mem"] ?? 0)
    print(decoded.ids[-1] ?? "?")
    print(decoded.servers[0].tags[1])
    print(decoded.servers[1].port)
    print(decoded.key.len)
    print(decoded.notes)
    match decoded.shapes[1] {
        Rect(w, h) => print(w * h)
        _ => print("wrong shape")
    }
    print(serialize_text(decoded) == text)

    print(serialize_text(Config { title: "", ratio: 0.0, big: 18000000000000000000, enabled: false, owner: none, nickname: none, limits: [:], ids: [:], servers: [], shapes: [], key: [], notes: "" }))
    print(deserialize_report[Server]("host: h\nport: 70000\ntags: []\n"))
    print(deserialize_report[Server]("host: h\ntags: []\n"))
    print(deserialize_report[Server]("host: h\nport: x\ntags: []\n"))
    print(deserialize_report[Server]("host: [h\n"))
    print(deserialize_report[Shape]("Hexagon\n"))
    print(deserialize_report[Shape]("Circle: {{radius: 2}}\n"))
    print(deserialize_report[Server]("host: &h h\nport: 1\ntags: [*h, *h]\nextra: {{a: 1}}\n"))
}
