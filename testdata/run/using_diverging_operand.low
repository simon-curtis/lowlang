struct Handle {
    id: i64
    drop print("release {id}")
}

enum OpenError {
    Missing
}

fn lookup() -> str? {
    "x"
}

fn coalesce_fail() -> Handle ! OpenError {
    let _ = lookup() ?? fail OpenError.Missing
    using h = Handle { id: 1 }
    h
}

fn coalesce_return() -> Handle ! OpenError {
    let _ = lookup() ?? return Handle { id: 0 }
    using h = Handle { id: 2 }
    h
}

fn coalesce_value() -> Handle ! OpenError {
    let _ = lookup() ?? "y"
    using h = Handle { id: 3 }
    h
}

fn coalesce_fail_return() -> Handle ! OpenError {
    let _ = lookup() ?? fail OpenError.Missing
    using h = Handle { id: 4 }
    return h
}

fn coalesce_panic() -> Handle {
    let _ = lookup() ?? panic("missing")
    using h = Handle { id: 5 }
    h
}

fn coalesce_chain() -> Handle ! OpenError {
    let _ = lookup() ?? lookup() ?? fail OpenError.Missing
    using h = Handle { id: 6 }
    h
}

fn coalesce_continue() -> Handle ! OpenError {
    for i in 0..3 {
        let _ = lookup() ?? continue
        using h = Handle { id: 7 }
        return h
    }
    fail OpenError.Missing
}

fn or_fail(ready: bool) -> Handle ! OpenError {
    let _ = ready || fail OpenError.Missing
    using h = Handle { id: 8 }
    h
}

fn and_return(ready: bool) -> Handle ! OpenError {
    let _ = ready && return Handle { id: 9 }
    using h = Handle { id: 0 }
    h
}

fn main() {
    using a = coalesce_fail() or return
    print("got {a.id}")
    using b = coalesce_return() or return
    print("got {b.id}")
    using c = coalesce_value() or return
    print("got {c.id}")
    using d = coalesce_fail_return() or return
    print("got {d.id}")
    using e = coalesce_panic()
    print("got {e.id}")
    using f = coalesce_chain() or return
    print("got {f.id}")
    using g = coalesce_continue() or return
    print("got {g.id}")
    using h = or_fail(true) or return
    print("got {h.id}")
    using i = and_return(true) or return
    print("got {i.id}")
    print("end")
}
