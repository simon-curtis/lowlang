import std/io
import std/net/dns
import std/text

fn unhex(s: str) -> []u8 {
    text.decode_hex(s) or []
}

fn same(label: str, got: str, want: str) {
    if got != want {
        print("FAIL {label}")
        print("  got  {got}")
        print("  want {want}")
    }
}

fn expect(label: str, ok: bool) {
    if !ok {
        print("FAIL {label}")
    }
}

fn dotted(ip: []u8) -> str {
    var out: []str = []
    for b in ip {
        push(mut out, "{b}")
    }
    text.join(out, ".")
}

fn quoted(parts: [][]u8) -> str {
    var out: []str = []
    for p in parts {
        push(mut out, "\"{str(p)}\"")
    }
    text.join(out, " ")
}

fn show(r: dns.Record) -> str {
    let head = "{r.name}\t{r.ttl}\t"
    match r.data {
        A(ip) => "{head}A\t{dotted(ip)}"
        Aaaa(ip) => "{head}AAAA\t{text.encode_hex(ip)}"
        Cname(t) => "{head}CNAME\t{t}"
        Ns(h) => "{head}NS\t{h}"
        Ptr(h) => "{head}PTR\t{h}"
        MxData(mx) => "{head}MX\t{mx.preference} {mx.host}"
        Txt(parts) => "{head}TXT\t{quoted(parts)}"
        SrvData(s) => "{head}SRV\t{s.priority} {s.weight} {s.port} {s.target}"
        SoaData(s) => "{head}SOA\t{s.mname} {s.rname} {s.serial} {s.refresh} {s.retry} {s.expire} {s.minimum}"
        CaaData(c) => "{head}CAA\t{c.flags} {c.tag} \"{str(c.value)}\""
        Opt(options) => "{head}OPT\t{r.class} {options.len}"
        Raw(k, b) => "{head}TYPE{k}\t{text.encode_hex(b)}"
    }
}

fn query_with(name: str, kind: i64, payload: i64) -> dns.Message {
    var q = dns.query(0x1234, name, kind, payload)
    q.authentic = true
    q
}

fn encodes(label: str, q: dns.Message, want: str) {
    let got = dns.encode(q) catch {
        e => {
            print("FAIL {label}: {e}")
            return
        }
    }
    same(label, text.encode_hex(got), want)
    let decoded = dns.decode(got) catch {
        e => {
            print("FAIL {label} decode: {e}")
            return
        }
    }
    let back = dns.encode(decoded) or []
    same("{label} round trip", text.encode_hex(back), want)
}

fn queries() {
    encodes("a", query_with("www.example.com", dns.type_a, 0), "12340120000100000000000003777777076578616d706c6503636f6d0000010001")
    encodes("aaaa", query_with("www.example.com", dns.type_aaaa, 1232), "12340120000100000000000103777777076578616d706c6503636f6d00001c000100002904d0000000000000")
    encodes("mx", query_with("example.org", dns.type_mx, 1232), "123401200001000000000001076578616d706c65036f726700000f000100002904d0000000000000")
    encodes("txt", query_with("_dmarc.example.org", dns.type_txt, 0), "123401200001000000000000065f646d617263076578616d706c65036f72670000100001")
    encodes("srv", query_with("_sip._tcp.example.com", dns.type_srv, 0), "123401200001000000000000045f736970045f746370076578616d706c6503636f6d0000210001")
    encodes("caa", query_with("example.com", dns.type_caa, 1232), "123401200001000000000001076578616d706c6503636f6d000101000100002904d0000000000000")
    encodes("ptr", query_with("4.3.2.1.in-addr.arpa", dns.type_ptr, 0), "123401200001000000000000013401330132013107696e2d61646472046172706100000c0001")
    encodes("cname", query_with("alias.example.com", dns.type_cname, 0), "12340120000100000000000005616c696173076578616d706c6503636f6d0000050001")
    encodes("ns", query_with("example.com", dns.type_ns, 0), "123401200001000000000000076578616d706c6503636f6d0000020001")
    encodes("root", query_with(".", dns.type_ns, 0), "1234012000010000000000000000020001")
    encodes("upper", query_with("WWW.EXAMPLE.COM", dns.type_a, 0), "12340120000100000000000003575757074558414d504c4503434f4d0000010001")
    var norecurse = query_with("host.example.com", dns.type_a, 0)
    norecurse.recursion_desired = false
    encodes("norecurse", norecurse, "12340020000100000000000004686f7374076578616d706c6503636f6d0000010001")
    var flags = query_with("host.example.com", dns.type_a, 0)
    flags.checking_disabled = true
    flags.additional = [dns.Record { name: ".", class: 1232, ttl: 0x8000, data: dns.Data.Opt([]) }]
    encodes("cd ad do", flags, "12340130000100000000000104686f7374076578616d706c6503636f6d000001000100002904d0000080000000")
    let reverse4 = dns.reverse_name([1, 2, 3, 4]) or ""
    same("reverse4", reverse4, "4.3.2.1.in-addr.arpa")
    let reverse6 = dns.reverse_name(unhex("20010db8000000000000000000000001")) or ""
    encodes("ptr6", query_with(reverse6, dns.type_ptr, 0), "1234012000010000000000000131013001300130013001300130013001300130013001300130013001300130013001300130013001300130013001300138016201640130013101300130013203697036046172706100000c0001")
    let bad = dns.reverse_name([1, 2, 3]) catch {
        e => "{e}"
    }
    same("reverse of three bytes", "{bad}", "Invalid")
}

fn answer() {
    let msg = unhex("")
    let m = dns.decode(msg) catch {
        e => {
            print("FAIL answer: {e}")
            return
        }
    }
    expect("flags", m.id == 0x1234 && m.response && m.authoritative && !m.truncated && m.recursion_desired && m.recursion_available && m.opcode == 0 && m.rcode == 0)
    same("question", "{m.questions[0].name} {m.questions[0].kind} {m.questions[0].class}", "example.com 1 1")
    let want = [
        "example.com\t300\tA\t192.0.2.1"
        "example.com\t300\tAAAA\t20010db8000000000000000000000001"
        "www.example.com\t300\tCNAME\texample.com"
        "example.com\t300\tNS\tns1.example.com"
        "1.2.0.192.in-addr.arpa\t300\tPTR\thost.example.com"
        "example.com\t300\tMX\t10 mail.example.com"
        "example.com\t300\tTXT\t\"v=spf1 -all\" \"second part\""
        "_sip._tcp.example.com\t300\tSRV\t1 5 5060 sip.example.com"
        "example.com\t300\tCAA\t128 issue \"ca.example.net\""
        "example.com\t300\tTYPE65400\t010203"
        "a\\.b.example.com\t300\tA\t10.0.0.1"
    ]
    same("answer count", "{m.answers.len}", "{want.len}")
    for i, w in want {
        same("answer {i}", show(m.answers[i]), w)
    }
    same("authority", show(m.authority[0]), "example.com\t300\tSOA\tns1.example.com hostmaster.example.com 2026111401 7200 3600 1209600 300")
    same("opt", show(m.additional[0]), ".\t32768\tOPT\t1232 1")
    expect("payload", dns.payload_size(m) == 1232)
    let again = dns.encode(m) or []
    same("re-encode", text.encode_hex(again), text.encode_hex(msg))
}

fn compression() {
    let msg = unhex("000180000000000400000000014603495349044152504100000100010000000000040102030403464f4fc00c0001000100000000000405060708c01200010001000000000004090a0b0c00000100010000000000040d0e0f10")
    let m = dns.decode(msg) catch {
        e => {
            print("FAIL compression: {e}")
            return
        }
    }
    var names: []str = []
    for r in m.answers {
        push(mut names, r.name)
    }
    same("rfc 1035 names", text.join(names, " "), "F.ISI.ARPA FOO.F.ISI.ARPA ARPA .")
    let again = dns.encode(m) or []
    same("rfc 1035 encode", text.encode_hex(again), text.encode_hex(msg))
    expect("same name", dns.same_name("Foo.Example.COM.", "foo.example.com") && !dns.same_name("foo.example.com", "bar.example.com") && dns.same_name(".", "."))
}

fn extended() {
    var m = query_with("example.com", dns.type_a, 1232)
    m.response = true
    m.rcode = 16
    let wire = dns.encode(m) or []
    same("badvers wire", text.encode_hex(wire), "123481200001000000000001076578616d706c6503636f6d000001000100002904d0010000000000")
    let back = dns.decode(wire) or m
    same("badvers rcode", "{back.rcode}", "16")
    let head = dns.decode_head(wire) or m
    same("head rcode", "{head.rcode} {head.questions.len} {head.additional.len}", "0 1 0")
    var plain = query_with("example.com", dns.type_a, 0)
    plain.rcode = 16
    let failed = dns.encode(plain) catch {
        e => []
    }
    same("rcode without opt", "{failed.len}", "0")
}

fn rejects(label: str, msg: []u8, want: io.Error) {
    let got = dns.decode(msg) catch {
        e => {
            same(label, "{e}", "{want}")
            return
        }
    }
    print("FAIL {label}: decoded id {got.id}")
}

fn question(name_hex: str) -> str {
    "123401000001000000000000{name_hex}00010001"
}

fn pointer_chain(hops: i64) -> []u8 {
    var msg = unhex("123481800000000200000000")
    push(mut msg, 0)
    io.put_be16(mut msg, 65400)
    io.put_be16(mut msg, 1)
    io.put_be32(mut msg, 0)
    let size_at = msg.len
    io.put_be16(mut msg, 0)
    let start = msg.len
    push(mut msg, 0)
    var previous = start
    for _ in 0..hops {
        let at = msg.len
        io.put_be16(mut msg, 0xC000 | previous)
        previous = at
    }
    io.set_be16(msg, size_at, msg.len - start)
    io.put_be16(mut msg, 0xC000 | previous)
    io.put_be16(mut msg, 65400)
    io.put_be16(mut msg, 1)
    io.put_be32(mut msg, 0)
    io.put_be16(mut msg, 0)
    msg
}

fn long_name() -> []u8 {
    var msg = unhex("123401000001000000000000")
    for _ in 0..130 {
        push(mut msg, 1)
        push(mut msg, 'a')
    }
    push(mut msg, 0)
    io.put_be16(mut msg, 1)
    io.put_be16(mut msg, 1)
    msg
}

fn reply(kind: str, length: str, rdata: str) -> []u8 {
    unhex("123481800001000100000000076578616d706c650000010001c00c{kind}00010000012c{length}{rdata}")
}

fn malformed() {
    rejects("shorter than the header", unhex("1234818000010000000000")[..11], Malformed)
    rejects("question count without bytes", unhex("123481800001000000000000"), Malformed)
    rejects("huge answer count", unhex("12348180000000000000ffff0000"), Malformed)
    rejects("question without type", unhex("12340100000100000000000003777777"), Malformed)
    rejects("question truncated before class", unhex("1234010000010000000000000377777700000100"), Malformed)
    rejects("reserved label bits 01", unhex(question("4041")), Malformed)
    rejects("reserved label bits 10", unhex(question("8001")), Malformed)
    rejects("self pointer", unhex("123401000001000000000000c00c00010001"), Malformed)
    rejects("forward pointer", unhex("123401000001000000000000c01000010001"), Malformed)
    rejects("pointer past the end", unhex("123401000001000000000000c0ff00010001"), Malformed)
    rejects("pointer without second byte", unhex("123401000001000000000000c0"), Malformed)
    rejects("name without terminator", unhex("12340100000100000000000003777777"), Malformed)
    rejects("label past the end", unhex("12340100000100000000000009777777"), Malformed)
    rejects("name over 255 octets", long_name(), Malformed)
    rejects("pointer chain of 128", pointer_chain(127), Malformed)
    rejects("pointer chain of 201", pointer_chain(200), Malformed)
    rejects("rdata past the end", reply("0001", "0008", "c0000201"), Malformed)
    rejects("a with five bytes", reply("0001", "0005", "c000020101"), Malformed)
    rejects("aaaa with four bytes", reply("001c", "0004", "c0000201"), Malformed)
    rejects("cname with bytes left over", reply("0005", "0003", "00ffff"), Malformed)
    rejects("cname name overruns rdata", reply("0005", "0002", "03777777"), Malformed)
    rejects("mx without a name", reply("000f", "0002", "000a"), Malformed)
    rejects("txt string overruns", reply("0010", "0003", "05616200"), Malformed)
    rejects("txt without a string", reply("0010", "0000", ""), Malformed)
    rejects("srv too short", reply("0021", "0006", "000100020003"), Malformed)
    rejects("soa too short", reply("0006", "0016", "0000000000000000000000000000000000000000"), Malformed)
    rejects("caa with empty tag", reply("0101", "0003", "008000"), Malformed)
    rejects("caa tag overruns", reply("0101", "0004", "0005616c"), Malformed)
    rejects("opt option overruns", reply("0029", "0005", "0003000561"), Malformed)
    rejects("opt option header cut", reply("0029", "0002", "0003"), Malformed)
    let ok = dns.decode(pointer_chain(126)) catch {
        e => dns.Message { id: -1, response: false, opcode: 0, authoritative: false, truncated: false, recursion_desired: false, recursion_available: false, authentic: false, checking_disabled: false, rcode: 0, questions: [], answers: [], authority: [], additional: [] }
    }
    same("pointer chain of 127", "{ok.answers.len} {ok.answers[1].name}", "2 .")
    let trailing = unhex("123401000000000000000000ffff")
    let tolerated = dns.decode(trailing) or ok
    same("trailing bytes", "{tolerated.id}", "{0x1234}")
}

fn encoder_limits() {
    let long_label = text.repeat("a", 64)
    let wide = text.join([text.repeat("a", 63), text.repeat("b", 63), text.repeat("c", 63), text.repeat("d", 63)], ".")
    let names = ["a..b", long_label, wide, "a\\", "a\\256", "a\\2", ".a", ".."]
    for name in names {
        let q = query_with(name, dns.type_a, 0)
        let result = dns.encode(q) catch {
            e => []
        }
        same("invalid name {name.len}", "{result.len}", "0")
    }
    let near = text.join([text.repeat("a", 63), text.repeat("b", 63), text.repeat("c", 63), text.repeat("d", 61)], ".")
    let fits = dns.encode(query_with(near, dns.type_a, 0)) or []
    same("name of 255 octets", "{fits.len}", "{12 + 255 + 4}")
    let over = dns.encode(query_with("{near}d", dns.type_a, 0)) or []
    same("name of 256 octets", "{over.len}", "0")
    let escaped = dns.encode(query_with("a\\.b\\046c.d", dns.type_a, 0)) or []
    same("escaped dots", text.encode_hex(escaped), "12340120000100000000000005612e622e63016400" + "00010001")
}

fn ordering() {
    let mx = dns.order_mx([dns.Mx { preference: 20, host: "b" }, dns.Mx { preference: 10, host: "a" }, dns.Mx { preference: 20, host: "c" }, dns.Mx { preference: 5, host: "d" }])
    var hosts: []str = []
    for m in mx {
        push(mut hosts, m.host)
    }
    same("mx order", text.join(hosts, " "), "d a b c")
    let list = [
        dns.Srv { priority: 10, weight: 60, port: 1, target: "a" }
        dns.Srv { priority: 10, weight: 20, port: 2, target: "b" }
        dns.Srv { priority: 5, weight: 0, port: 3, target: "c" }
        dns.Srv { priority: 10, weight: 0, port: 4, target: "d" }
        dns.Srv { priority: 10, weight: 20, port: 5, target: "e" }
    ]
    var next = 0
    let low = fn(n: i64) -> i64 { 0 }
    let high = fn(n: i64) -> i64 { n - 1 }
    var targets: []str = []
    for s in dns.order_srv(list, low) {
        push(mut targets, s.target)
    }
    same("srv lowest draw", text.join(targets, " "), "c d a b e")
    targets = []
    for s in dns.order_srv(list, high) {
        push(mut targets, s.target)
    }
    same("srv highest draw", text.join(targets, " "), "c e b a d")
    let draws = [0, 50, 0, 30, 0]
    let scripted = fn(n: i64) -> i64 {
        let v = draws[next]
        next += 1
        v
    }
    targets = []
    for s in dns.order_srv(list, scripted) {
        push(mut targets, s.target)
    }
    same("srv scripted draw", text.join(targets, " "), "c a d e b")
}

fn main() {
    queries()
    print("queries")
    answer()
    print("answer")
    compression()
    print("compression")
    extended()
    print("extended")
    malformed()
    print("malformed")
    encoder_limits()
    print("encoder limits")
    ordering()
    print("ordering")
}
