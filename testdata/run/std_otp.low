import std/crypto/otp
import std/text

fn describe(e: otp.Error) -> str {
    match e {
        BadDigits => "BadDigits"
        BadPeriod => "BadPeriod"
        BadTime => "BadTime"
        BadSecret => "BadSecret"
        BadAlgorithm => "BadAlgorithm"
        BadUri => "BadUri"
    }
}

fn code(run: fn() -> str ! otp.Error) -> str {
    run() catch { e => describe(e) }
}

fn verify(secret: []u8, given: str, time: i64, window: i64) -> str {
    let ok = otp.verify_totp(secret, given, time, 30, 6, otp.Algorithm.Sha1, window) catch { _ => false }
    "{ok}"
}

fn describe_parse(source: str) -> str {
    let key = otp.parse_uri(source) catch { e => return describe(e) }
    let kind = if key.kind == otp.Kind.Totp { "totp" } else { "hotp" }
    let secret = text.encode_hex(key.secret)
    "{kind} [{key.issuer}] [{key.account}] {secret} {key.digits} {key.period} {key.counter}"
}

fn rfc4226() {
    print("-- rfc 4226")
    let secret = bytes("12345678901234567890")
    for counter in 0..10 {
        print(code(fn() -> str ! otp.Error { otp.hotp(secret, counter, 6, otp.Algorithm.Sha1)? }))
    }
}

fn rfc6238() {
    print("-- rfc 6238")
    let sha1 = bytes("12345678901234567890")
    let sha256 = bytes("12345678901234567890123456789012")
    let sha512 = bytes("1234567890123456789012345678901234567890123456789012345678901234")
    for time in [59, 1111111109, 1111111111, 1234567890, 2000000000, 20000000000] {
        let a = code(fn() -> str ! otp.Error { otp.totp(sha1, time, 30, 8, otp.Algorithm.Sha1)? })
        let b = code(fn() -> str ! otp.Error { otp.totp(sha256, time, 30, 8, otp.Algorithm.Sha256)? })
        let c = code(fn() -> str ! otp.Error { otp.totp(sha512, time, 30, 8, otp.Algorithm.Sha512)? })
        print("{time} {a} {b} {c}")
    }
}

fn digit_widths() {
    print("-- digits")
    let secret = bytes("12345678901234567890")
    for digits in [5, 6, 7, 8, 9] {
        print("{digits} {code(fn() -> str ! otp.Error { otp.totp(secret, 59, 30, digits, otp.Algorithm.Sha1)? })}")
    }
    print(code(fn() -> str ! otp.Error { otp.totp(secret, 59, 0, 6, otp.Algorithm.Sha1)? }))
    print(code(fn() -> str ! otp.Error { otp.totp(secret, -1, 30, 6, otp.Algorithm.Sha1)? }))
}

fn verification() {
    print("-- verify")
    let secret = bytes("12345678901234567890")
    let now = 1111111109
    let current = otp.totp(secret, now, 30, 6, otp.Algorithm.Sha1) catch { _ => "" }
    let earlier = otp.totp(secret, now - 30, 30, 6, otp.Algorithm.Sha1) catch { _ => "" }
    let later = otp.totp(secret, now + 60, 30, 6, otp.Algorithm.Sha1) catch { _ => "" }
    print("{current} {earlier} {later}")
    print("exact {verify(secret, current, now, 0)}")
    print("previous step, window 0 {verify(secret, earlier, now, 0)}")
    print("previous step, window 1 {verify(secret, earlier, now, 1)}")
    print("two steps ahead, window 1 {verify(secret, later, now, 1)}")
    print("two steps ahead, window 2 {verify(secret, later, now, 2)}")
    let five = "12345"
    print("wrong length {verify(secret, five, now, 1)}")
    let first = "755224"
    print("start of time {verify(secret, first, 0, 2)} {verify(secret, current, 0, 2)}")
    let next = otp.verify_hotp(secret, "287922", 3, 5, 6, otp.Algorithm.Sha1) catch { _ => none }
    print("hotp resync {next ?? -1}")
    let missed = otp.verify_hotp(secret, "287922", 3, 2, 6, otp.Algorithm.Sha1) catch { _ => none }
    print("hotp outside window {missed ?? -1}")
}

fn secrets() {
    print("-- secrets")
    let secret = bytes("12345678901234567890")
    let encoded = otp.secret_to_base32(secret)
    print(encoded)
    let decoded = otp.secret_from_base32("gezd gnbv-gy3t qojq") catch { _ => [] }
    print(str(decoded))
    let again = otp.secret_from_base32(encoded) catch { _ => [] }
    print(str(again) == "12345678901234567890")
    let bad = otp.secret_from_base32("MZX1") catch { e => return print(describe(e)) }
    print(bad.len)
}

fn random_secret() {
    print("-- generated")
    let a = otp.generate_secret(20)
    let b = otp.generate_secret(20)
    print("{a.len} {b.len} {text.encode_hex(a) != text.encode_hex(b)}")
    let round = otp.secret_from_base32(otp.secret_to_base32(a)) catch { _ => [] }
    print(text.encode_hex(round) == text.encode_hex(a))
}

fn uris() {
    print("-- uri")
    let hello: []u8 = [72, 101, 108, 108, 111, 33, 0xDE, 0xAD, 0xBE, 0xEF]
    let totp_key = otp.Key { kind: otp.Kind.Totp, account: "alice@example.com", issuer: "Example Co", secret: hello }
    print(otp.uri(totp_key))
    let wide = otp.Key { kind: otp.Kind.Totp, account: "bob", secret: hello, algorithm: otp.Algorithm.Sha512, digits: 8, period: 60 }
    print(otp.uri(wide))
    let counter_key = otp.Key { kind: otp.Kind.Hotp, account: "carol", issuer: "A:B", secret: hello, algorithm: otp.Algorithm.Sha256, counter: 42 }
    print(otp.uri(counter_key))
    for key in [totp_key, wide, counter_key] {
        print(describe_parse(otp.uri(key)))
    }
    print(describe_parse("otpauth://totp/Example:alice@google.com?secret=JBSWY3DPEHPK3PXP&issuer=Example"))
    print(describe_parse("otpauth://totp/alice%40google.com?secret=jbswy3dpehpk3pxp&digits=8&algorithm=sha256&period=45&unknown=1"))
    print(describe_parse("otpauth://hotp/Service%3Aname?secret=JBSWY3DPEHPK3PXP&counter=7&issuer=Override"))
    print(describe_parse("otpauth://hotp/x?secret=JBSWY3DPEHPK3PXP"))
    print(describe_parse("otpauth://totp/x"))
    print(describe_parse("otpauth://totp/x?secret=!!"))
    print(describe_parse("otpauth://totp/x?secret=JBSWY3DPEHPK3PXP&digits=9"))
    print(describe_parse("otpauth://totp/x?secret=JBSWY3DPEHPK3PXP&digits=ab"))
    print(describe_parse("otpauth://totp/x?secret=JBSWY3DPEHPK3PXP&period=0"))
    print(describe_parse("otpauth://totp/x?secret=JBSWY3DPEHPK3PXP&algorithm=md5"))
    print(describe_parse("otpauth://other/x?secret=JBSWY3DPEHPK3PXP"))
    print(describe_parse("https://totp/x?secret=JBSWY3DPEHPK3PXP"))
    print(describe_parse("otpauth://totp/x%2?secret=JBSWY3DPEHPK3PXP"))
}

fn main() {
    rfc4226()
    rfc6238()
    digit_widths()
    verification()
    secrets()
    random_secret()
    uris()
}
