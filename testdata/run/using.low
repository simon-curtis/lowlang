enum Problem {
    Bad
}

struct File {
    name: str
    drop print("close {name}")
}

struct Conn {
    id: i64
    log: File
    drop {
        print("flush {id}")
        print("disconnect {id}")
    }
}

struct Pair[A, B] {
    first: A
    second: B
}

fn open(name: str) -> File {
    print("open {name}")
    File { name }
}

fn connect(id: i64) -> Conn ! Problem {
    if id < 0 {
        fail Bad
    }
    using log = open("log {id}")
    Conn { id, log }
}

fn size(f: File) -> i64 {
    f.name.len
}

fn relog(mut c: Conn) {
    c.log = open("relogged {c.id}")
}

fn handoff(name: str) -> File {
    using f = open(name)
    print("handing off {f.name}")
    f
}

fn early(n: i64) -> i64 {
    using a = open("early a")
    if n > 0 {
        using b = open("early b")
        return n
    }
    0
}

fn propagate(id: i64) -> i64 ! Problem {
    using c = connect(id)?
    c.id
}

fn loops() {
    for i in 0..3 {
        using f = open("loop {i}")
        if i == 1 {
            continue
        }
        if i == 2 {
            break
        }
        print("body {i}")
    }
}

fn branch(keep: bool) {
    using a = open("branch")
    if keep {
        using b = a
        print("moved to b")
    }
    print("end of branch")
}

fn main() {
    using first = open("first")
    defer print("deferred")
    print(size(first))
    print(early(1))
    print(early(0))
    print(propagate(7) or -1)
    print(propagate(-1) or -1)
    loops()
    using owned = handoff("handed")
    print("caller owns {owned.name}")
    using var current = open("a")
    current = open("b")
    using conn = connect(3) or Conn { id: 0, log: open("fallback") }
    using var holder = Conn { id: 4, log: open("first log") }
    holder.log = open("second log")
    relog(mut holder)
    using pair = Pair { first: open("pair"), second: 1 }
    let plain = Pair { first: 1, second: 2 }
    print(plain.first + plain.second)
    branch(true)
    branch(false)
    {
        using inner = open("inner")
        print("in block")
    }
    print("end of main")
}
