import std/math
import std/slices
import std/text

fn main() {
    let words = "  low  level   language ".fields()
    print(words)
    print(words.map(fn(w) w.len).sum())
    print([3, 1, 4].scan(10, fn(total, x) total + x).count(fn(x) x > 13))
    var xs = [5, 2, 9]
    xs.sort()
    print(xs)
    print(xs.max() ?? 0)
    print(7.max(3))
    print("a,b".cut(",").before)
    print(words.count(fn(w) w.len > 3))
    print("banana".count("an"))
    let total = text.lines("1\n2\n3")
        .map(fn(line) text.parse_int(line) catch { _ => 0 })
        .sum()
    print(total)
}
