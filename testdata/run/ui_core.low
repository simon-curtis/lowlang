import std/ui
import std/ui/geometry
import std/ui/platform
import std/ui/scene

fn show(r: geometry.Rect) -> str {
    "{r.x} {r.y} {r.width} {r.height}"
}

fn counter(cx: ui.Context, count: ui.Signal[i64], log: ui.Signal[[]str]) -> ui.Element {
    ui.div().column().padding(10.0).gap(4.0).background(ui.rgb(0x202124)).children() {
        ui.text("Clicked {count.get()} times").text_color(ui.rgb(0xe8eaed)).text_size(12.0)
        ui.div().id("button").size(80.0, 20.0).rounded(4.0).background(ui.rgb(0x1a73e8))
            .hover(fn(v: ui.Visual) -> ui.Visual { v.with_background(ui.rgb(0x4285f4)) })
            .on_click(fn(e) count.set(count.get() + 1))
        ui.div().row().gap(4.0).on_key_down(fn(k) {
            log.update(fn(l) appended(l, "row {k.text}"))
            if k.text == "x" {
                cx.stop_propagation()
            }
        }).children() {
            ui.div().id("a").size(20.0, 20.0).focusable().background(ui.rgb(0xff0000))
            ui.div().id("b").size(20.0, 20.0).focusable().background(ui.rgb(0x00ff00))
        }
    }
}

fn appended(l: []str, line: str) -> []str {
    var out = l[0..]
    out.push(line)
    out
}

fn press(cx: ui.Context, x: f32, y: f32) {
    cx.dispatch(PointerDown(Left, x, y))
    cx.dispatch(PointerUp(Left, x, y))
}

fn typed(cx: ui.Context, text: str) {
    cx.dispatch(Key(platform.KeyEvent { key: Character(text), text }))
}

fn main() {
    let cx = ui.headless(ui.rgb(0xffffff))
    let count = cx.signal(0)
    let none_yet: []str = []
    let log = cx.signal(none_yet)
    let view = fn() -> ui.Element { counter(cx, count, log) }
    cx.dispatch(Resized(200.0, 100.0, 2.0))
    print(cx.frame_due())
    let s = cx.frame(view, geometry.size(200.0, 100.0), 2.0)
    print("{s.width} {s.height} quads {s.quads.len} sprites {s.sprites.len > 0}")
    print(show(s.quads[1].bounds))
    print(s.quads[1].background == ui.rgb(0x1a73e8))
    print(cx.frame_due())
    let fractional = cx.frame(view, geometry.size(200.3, 100.0), 1.25)
    print("fractional {fractional.width} {fractional.height} {show(fractional.quads[1].bounds)}")

    cx.dispatch(PointerMoved(30.0, 40.0))
    print("hover due {cx.frame_due()}")
    let hovered = cx.frame(view, geometry.size(200.0, 100.0), 2.0)
    print(hovered.quads[1].background == ui.rgb(0x4285f4))

    press(cx, 30.0, 40.0)
    press(cx, 30.0, 40.0)
    print("count {count.get()} due {cx.frame_due()}")
    cx.dispatch(PointerDown(Left, 30.0, 40.0))
    cx.dispatch(PointerUp(Left, 150.0, 90.0))
    print("count after drag off {count.get()}")
    cx.frame(view, geometry.size(200.0, 100.0), 2.0)

    press(cx, 15.0, 65.0)
    print("focus {cx.focused()}")
    typed(cx, "q")
    typed(cx, "x")
    cx.dispatch(Key(platform.KeyEvent { key: Named(Tab) }))
    print("focus {cx.focused()}")
    cx.dispatch(Key(platform.KeyEvent { key: Named(Tab) }))
    print("focus {cx.focused()}")
    cx.dispatch(Key(platform.KeyEvent { key: Named(Tab), modifiers: platform.Modifiers { shift: true } }))
    print("focus {cx.focused()}")
    for line in log.get() {
        print(line)
    }

    let h = cx.handle()
    h.post(fn() { count.set(100) })
    cx.dispatch(Woken)
    print("posted {count.get()} due {cx.frame_due()}")
    cx.open_url("https://example.com/a b") or {}
    cx.open_url("mailto:someone@example.com") or {}
    for bad in ["-x", "C:\\evil.exe", "\\\\host\\share", "example.com", "1a:b"] {
        cx.open_url(bad) catch {
            e => print("refused {bad}")
        }
    }
    print("opened {cx.opened_urls()}")
    cx.dispatch(CloseRequested)
    print(cx.closed())
}
