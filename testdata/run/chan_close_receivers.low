fn wait_for(c: chan[i64], out: chan[i64]) {
    out <- (<-c) ?? -1
}

fn closed_receivers(waiters: i64, capacity: i64, queued: i64) {
    let c = chan[i64](capacity)
    let out = chan[i64](waiters)
    for i in 0..queued {
        c <- (i + 1) * 10
    }
    for w in 0..waiters {
        spawn wait_for(c, out)
    }
    sleep(5)
    close(c)
    var total = 0
    var nones = 0
    for w in 0..waiters {
        let v = (<-out) ?? -100
        if v == -1 {
            nones += 1
        } else {
            total += v
        }
    }
    print("{waiters} {capacity} {queued} values {total} closed {nones}")
}

fn main() {
    let counts = [1, 4, 16, 64]
    for n in counts {
        closed_receivers(n, 0, 0)
        closed_receivers(n, 8, 0)
        closed_receivers(n, 8, 3)
    }
    let c = chan[i64](2)
    close(c)
    print((<-c) ?? -1)
    print((<-c) ?? -1)
}
