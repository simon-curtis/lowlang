import std/dbus
import std/text

fn vector(name: str) -> str {
    match name {
        "scalars_le" => ""
        "strings_le" => ""
        "empty_arrays_le" => ""
        "bytes_le" => "6c01000107000000070000007000000001016f00100000002f6f72672f6578616d706c652f4f626a000000000000000002017300110000006f72672e6578616d706c652e496661636500000000000000030173000400000050696e6700000000060173000f0000006f72672e6578616d706c652e537663000801670002617900030000000102ff"
        "struct_after_byte_le" => "6c0100010d000000070000007300000001016f00100000002f6f72672f6578616d706c652f4f626a000000000000000002017300110000006f72672e6578616d706c652e496661636500000000000000030173000400000050696e6700000000060173000f0000006f72672e6578616d706c652e53766300080167000579286979290000000000000700000000000000f7ffffff03"
        "array_of_structs_le" => ""
        "nested_variants_le" => ""
        "dict_uint_string_le" => ""
        "array_of_arrays_le" => ""
        "array_of_int64_after_byte_le" => ""
        "variant_in_struct_le" => "6c01000109000000070000007200000001016f00100000002f6f72672f6578616d706c652f4f626a000000000000000002017300110000006f72672e6578616d706c652e496661636500000000000000030173000400000050696e6700000000060173000f0000006f72672e6578616d706c652e5376630008016700042876792900000000000000016900000300000004"
        "doubles_le" => ""
        "dict_entry_struct_value_le" => ""
        "no_body_le" => "6c01000100000000070000006800000001016f00100000002f6f72672f6578616d706c652f4f626a000000000000000002017300110000006f72672e6578616d706c652e496661636500000000000000030173000400000050696e6700000000060173000f0000006f72672e6578616d706c652e53766300"
        "method_return_le" => "6c02010109000000090000002f000000050175000700000006017300040000003a312e350000000007017300040000003a312e3200000000080167000173000004000000706f6e6700"
        "error_le" => "6c0300010d0000000a0000003f00000004017300120000006f72672e6578616d706c652e4661696c6564000000000000050175000700000006017300040000003a312e350000000008016700017300000800000069742062726f6b6500"
        "signal_le" => ""
        "fds_le" => ""
        "scalars_be" => ""
        "strings_be" => ""
        "empty_arrays_be" => ""
        "bytes_be" => "4201000100000007000000070000007001016f00000000102f6f72672f6578616d706c652f4f626a000000000000000002017300000000116f72672e6578616d706c652e496661636500000000000000030173000000000450696e6700000000060173000000000f6f72672e6578616d706c652e537663000801670002617900000000030102ff"
        "struct_after_byte_be" => "420100010000000d000000070000007301016f00000000102f6f72672f6578616d706c652f4f626a000000000000000002017300000000116f72672e6578616d706c652e496661636500000000000000030173000000000450696e6700000000060173000000000f6f72672e6578616d706c652e53766300080167000579286979290000000000000700000000000000fffffff703"
        "array_of_structs_be" => ""
        "nested_variants_be" => ""
        "dict_uint_string_be" => ""
        "array_of_arrays_be" => ""
        "array_of_int64_after_byte_be" => ""
        "variant_in_struct_be" => "4201000100000009000000070000007201016f00000000102f6f72672f6578616d706c652f4f626a000000000000000002017300000000116f72672e6578616d706c652e496661636500000000000000030173000000000450696e6700000000060173000000000f6f72672e6578616d706c652e5376630008016700042876792900000000000000016900000000000304"
        "doubles_be" => ""
        "dict_entry_struct_value_be" => ""
        "no_body_be" => "4201000100000000000000070000006801016f00000000102f6f72672f6578616d706c652f4f626a000000000000000002017300000000116f72672e6578616d706c652e496661636500000000000000030173000000000450696e6700000000060173000000000f6f72672e6578616d706c652e53766300"
        "method_return_be" => "4202010100000009000000090000002f050175000000000706017300000000043a312e350000000007017300000000043a312e3200000000080167000173000000000004706f6e6700"
        "error_be" => "420300010000000d0000000a0000003f04017300000000126f72672e6578616d706c652e4661696c6564000000000000050175000000000706017300000000043a312e350000000008016700017300000000000869742062726f6b6500"
        "signal_be" => ""
        "fds_be" => ""
        _ => ""
    }
}

fn entry(k: dbus.Value, v: dbus.Value) -> dbus.Value {
    dbus.Value.DictEntry(new(k), new(v))
}

fn call(body: []dbus.Value) -> dbus.Message {
    var m = dbus.method_call("org.example.Svc", "/org/example/Obj", "org.example.Iface", "Ping", body)
    m.serial = 7
    m
}

fn cases() -> [str: dbus.Message] {
    let b = dbus.Value.Byte(0xAB)
    [
        "scalars": call([
            b,
            dbus.Value.Boolean(true),
            dbus.Value.Int16(-2),
            dbus.Value.UInt16(65535),
            dbus.Value.Int32(-123456),
            dbus.Value.UInt32(4000000000),
            dbus.Value.Int64(-1099511627776),
            dbus.Value.UInt64(9223372036854775813),
            dbus.Value.Double(1.5),
        ]),
        "strings": call([dbus.Value.String("héllo"), dbus.Value.ObjectPath("/a/b"), dbus.Value.Signature("a{{sv}}")]),
        "empty_arrays": call([
            dbus.Value.Array("i", []),
            dbus.Value.Array("s", []),
            dbus.Value.Array("(ii)", []),
            dbus.Value.Array("{{sv}}", []),
            dbus.Value.Array("x", []),
            dbus.Value.Array("t", []),
        ]),
        "bytes": call([dbus.Value.Bytes([1, 2, 255])]),
        "struct_after_byte": call([dbus.Value.Byte(7), dbus.Value.Struct([dbus.Value.Int32(-9), dbus.Value.Byte(3)])]),
        "array_of_structs": call([
            dbus.Value.Array("(sa(ii))", [
                dbus.Value.Struct([
                    dbus.Value.String("a"),
                    dbus.Value.Array("(ii)", [
                        dbus.Value.Struct([dbus.Value.Int32(1), dbus.Value.Int32(2)]),
                        dbus.Value.Struct([dbus.Value.Int32(3), dbus.Value.Int32(4)]),
                    ]),
                ]),
                dbus.Value.Struct([dbus.Value.String("bc"), dbus.Value.Array("(ii)", [])]),
            ]),
        ]),
        "nested_variants": call([
            dbus.variant(dbus.variant(dbus.dict(["k": dbus.Value.String("x"), "n": dbus.Value.UInt32(9)]))),
        ]),
        "dict_uint_string": call([
            dbus.Value.Array("{{us}}", [
                entry(dbus.Value.UInt32(1), dbus.Value.String("one")),
                entry(dbus.Value.UInt32(4000000000), dbus.Value.String("big")),
            ]),
        ]),
        "array_of_arrays": call([
            dbus.Value.Array("ai", [
                dbus.Value.Array("i", [dbus.Value.Int32(1), dbus.Value.Int32(2)]),
                dbus.Value.Array("i", []),
                dbus.Value.Array("i", [dbus.Value.Int32(3)]),
            ]),
        ]),
        "array_of_int64_after_byte": call([
            dbus.Value.Byte(1),
            dbus.Value.Array("x", [dbus.Value.Int64(5), dbus.Value.Int64(-6)]),
        ]),
        "variant_in_struct": call([dbus.Value.Struct([dbus.variant(dbus.Value.Int32(3)), dbus.Value.Byte(4)])]),
        "doubles": call([dbus.Value.Array("d", [dbus.Value.Double(0.0), dbus.Value.Double(-2.5), dbus.Value.Double(1e300)])]),
        "dict_entry_struct_value": call([
            dbus.Value.Array("{{s(ii)}}", [
                entry(dbus.Value.String("p"), dbus.Value.Struct([dbus.Value.Int32(1), dbus.Value.Int32(2)])),
            ]),
        ]),
        "no_body": call([]),
        "method_return": dbus.Message {
            kind: dbus.MessageType.MethodReturn,
            flags: dbus.no_reply_expected,
            serial: 9,
            reply_serial: 7,
            destination: ":1.5",
            sender: ":1.2",
            body: [dbus.Value.String("pong")],
        },
        "error": dbus.Message {
            kind: dbus.MessageType.ErrorReply,
            serial: 10,
            error_name: "org.example.Failed",
            reply_serial: 7,
            destination: ":1.5",
            body: [dbus.Value.String("it broke")],
        },
        "signal": dbus.Message {
            kind: dbus.MessageType.Signal,
            serial: 11,
            path: "/org/example/Obj",
            interface: "org.example.Iface",
            member: "Changed",
            sender: ":1.2",
            body: [dbus.Value.Int32(5), dbus.dict(["a": dbus.Value.Boolean(true)])],
        },
        "fds": dbus.Message {
            kind: dbus.MessageType.MethodCall,
            flags: dbus.no_auto_start | dbus.allow_interactive_authorization,
            serial: 12,
            path: "/org/example/Obj",
            interface: "org.example.Iface",
            member: "Ping",
            destination: "org.example.Svc",
            body: [dbus.Value.UnixFd(30), dbus.Value.Int32(4), dbus.Value.UnixFd(31)],
        },
    ]
}

fn check(name: str, order: dbus.ByteOrder, m: dbus.Message, suffix: str) -> bool {
    let want = vector("{name}_{suffix}")
    let e = dbus.encode_message(m, order) or {
        print("{name}_{suffix}: encode failed")
        return false
    }
    let got = text.encode_hex(e.data)
    if got != want {
        print("{name}_{suffix}: encoded bytes differ")
        print("  want {want}")
        print("  got  {got}")
        return false
    }
    let raw = text.decode_hex(want) or panic("vector")
    var fds: []i64 = []
    for fd in e.fds {
        push(mut fds, fd)
    }
    let back = dbus.decode_message(raw, fds) or {
        print("{name}_{suffix}: decode failed")
        return false
    }
    if "{back.body}" != "{m.body}" || back.kind != m.kind || back.serial != m.serial || back.flags != m.flags || back.path != m.path || back.interface != m.interface || back.member != m.member || back.error_name != m.error_name || back.reply_serial != m.reply_serial || back.destination != m.destination || back.sender != m.sender {
        print("{name}_{suffix}: decoded message differs")
        print("  want {m}")
        print("  got  {back}")
        return false
    }
    let total = dbus.message_length(raw[..16]) or -1
    if total != raw.len {
        print("{name}_{suffix}: message_length {total}, want {raw.len}")
        return false
    }
    true
}

fn main() {
    var passed = 0
    var failed = 0
    for name, m in cases() {
        for order in [dbus.ByteOrder.Little, dbus.ByteOrder.Big] {
            let suffix = if order == dbus.ByteOrder.Little { "le" } else { "be" }
            if check(name, order, m, suffix) {
                passed += 1
            } else {
                failed += 1
            }
        }
    }
    print("vectors passed {passed}, failed {failed}")

    let fd_message = cases()["fds"] ?? call([])
    let e = dbus.encode_message(fd_message, dbus.ByteOrder.Little) or panic("fds")
    print("fds {e.fds}")
}
