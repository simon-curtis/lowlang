import std/ui
import std/ui/geometry
import std/ui/platform

fn press(cx: ui.Context, key: platform.Key, text: str, m: platform.Modifiers) {
    cx.dispatch(Key(platform.KeyEvent { key, text, modifiers: m }))
    cx.dispatch(Key(platform.KeyEvent { key, modifiers: m, pressed: false }))
}

fn char(cx: ui.Context, c: str) {
    press(cx, Character(c), c, platform.Modifiers {})
}

fn ctrl(cx: ui.Context, c: str) {
    press(cx, Character(c), "", platform.Modifiers { control: true })
}

fn show_error(e: ui.BindError) -> str {
    match e {
        Keys(text) => "keys '{text}'"
        Predicate(text) => "predicate '{text}'"
    }
}

fn try_bind(cx: ui.Context, keys: str, action: str, context: str) {
    ui.bind(cx, keys, action, context) catch {
        e => {
            print("rejected {show_error(e)}")
            return
        }
    }
    print("bound {keys}")
}

fn must_bind(cx: ui.Context, keys: str, action: str, context: str) {
    ui.bind(cx, keys, action, context) catch {
        e => print("unexpected {show_error(e)}")
    }
}

fn errors(cx: ui.Context) {
    print("errors")
    try_bind(cx, "", "a", "")
    try_bind(cx, "   ", "a", "")
    try_bind(cx, "ctrl-hyper-a", "a", "")
    try_bind(cx, "ctrl-", "a", "")
    try_bind(cx, "ctrl--", "a", "")
    try_bind(cx, "-", "a", "")
    try_bind(cx, "a", "a", "Editor &&")
    try_bind(cx, "a", "a", "(Editor")
    try_bind(cx, "a", "a", "mode ==")
    try_bind(cx, "a", "a", "Editor Panel")
    try_bind(cx, "a", "a", "!(Editor || Panel) > Pane && mode != full")
}

fn main() {
    let cx = ui.headless(ui.rgb(0xffffff))
    let clock = cx.signal(0)
    cx.set_clock(fn() clock.get())
    errors(ui.headless(ui.rgb(0xffffff)))

    let log = cx.signal("")
    let note = fn(s: str) log.set(log.get() + s + " ")
    let flush = fn() {
        print(log.get())
        log.set("")
    }
    let view = fn() -> ui.Element {
        ui.div().key_context("Workspace").on_action("save", fn() note("save")).on_action("save-all", fn() note("workspace-save-all")).children() {
            ui.div().id("editor").focusable().key_context("Editor mode=full").size(10.0, 10.0)
                .on_action("delete-line", fn() note("delete-line"))
                .on_action("top", fn() note("top"))
                .on_action("editor-cancel", fn() note("editor-cancel"))
                .on_action("nested", fn() note("nested"))
                .on_action("save-all", fn() {
                    note("editor-save-all")
                    cx.propagate()
                })
                .on_key_down(fn(k) note("key:{k.text}"))
            ui.div().id("panel").focusable().key_context("Panel").size(10.0, 10.0)
                .on_action("cancel", fn() note("panel-cancel"))
                .on_key_down(fn(k) note("panel-key:{k.text}"))
        }
    }
    cx.on_app_action("help", fn() note("help"))
    cx.on_app_action("first", fn() note("first"))
    cx.on_app_action("second", fn() note("second"))
    cx.on_app_action("fallback", fn() note("fallback"))
    cx.on_app_action("quit-app", fn() note("quit-app"))
    cx.on_app_action("cancel", fn() note("app-cancel"))
    must_bind(cx, "ctrl-s", "save", "")
    must_bind(cx, "ctrl-shift-k", "delete-line", "Editor")
    must_bind(cx, "g g", "top", "Editor")
    must_bind(cx, "?", "help", "")
    must_bind(cx, "escape", "cancel", "Workspace")
    must_bind(cx, "escape", "editor-cancel", "Editor")
    must_bind(cx, "ctrl-d", "first", "")
    must_bind(cx, "ctrl-d", "second", "")
    must_bind(cx, "ctrl-e", "fallback", "")
    must_bind(cx, "ctrl-e", "orphan", "Editor")
    must_bind(cx, "ctrl-q", "quit-app", "")
    must_bind(cx, "ctrl-q", "", "Editor")
    must_bind(cx, "ctrl-p", "nested", "Workspace > Editor")
    must_bind(cx, "ctrl-o", "nested", "Panel > Editor")
    must_bind(cx, "ctrl-m", "delete-line", "Editor && mode != full")
    must_bind(cx, "ctrl-n", "delete-line", "Editor && mode == full && !Panel")
    must_bind(cx, "ctrl-a", "save-all", "")
    let size = geometry.size(100.0, 100.0)
    cx.frame(view, size, 1.0)

    print("unfocused")
    ctrl(cx, "s")
    ctrl(cx, "k")
    press(cx, Named(Escape), "", platform.Modifiers {})
    flush()
    print("available delete-line {cx.is_action_available("delete-line")} save {cx.is_action_available("save")}")

    print("editor")
    cx.set_focus("editor")
    cx.frame(view, size, 1.0)
    ctrl(cx, "s")
    press(cx, Character("K"), "", platform.Modifiers { control: true, shift: true })
    press(cx, Character("?"), "?", platform.Modifiers { shift: true })
    press(cx, Named(Escape), "", platform.Modifiers {})
    ctrl(cx, "d")
    ctrl(cx, "e")
    ctrl(cx, "q")
    ctrl(cx, "p")
    ctrl(cx, "o")
    ctrl(cx, "m")
    ctrl(cx, "n")
    ctrl(cx, "a")
    flush()
    print("available delete-line {cx.is_action_available("delete-line")} orphan {cx.is_action_available("orphan")}")
    print("bindings cancel {cx.bindings_for("cancel")} editor-cancel {cx.bindings_for("editor-cancel")} delete-line {cx.bindings_for("delete-line")}")

    print("sequences")
    char(cx, "g")
    print("pending '{cx.pending_keys()}'")
    char(cx, "g")
    print("pending '{cx.pending_keys()}'")
    flush()
    char(cx, "g")
    char(cx, "x")
    flush()
    char(cx, "g")
    clock.set(2000000000)
    char(cx, "y")
    flush()
    char(cx, "g")
    ctrl(cx, "s")
    flush()

    print("panel")
    cx.set_focus("panel")
    cx.frame(view, size, 1.0)
    press(cx, Named(Escape), "", platform.Modifiers {})
    ctrl(cx, "q")
    char(cx, "g")
    print("pending '{cx.pending_keys()}'")
    flush()
    print("available delete-line {cx.is_action_available("delete-line")}")
    print("bindings cancel {cx.bindings_for("cancel")} editor-cancel {cx.bindings_for("editor-cancel")}")

    print("dispatch")
    print("{cx.dispatch_action("cancel")} {cx.dispatch_action("top")} {cx.dispatch_action("missing")}")
    flush()
}
