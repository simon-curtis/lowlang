fn main() {
    print("{3.14159:f3}|{7.0:f1}|{12345.678:e2}|{1234567.891:n}|{1234567.891:n1}|{0.5:n}")
    print("{0.125:f2}|{0.375:f2}|{2.675:f2}|{2.5:f0}|{3.5:f0}|{0.5:f0}|{1.5:f0}|{0.045:f2}")
    print("{-0.001:f2}|{-0.0:f2}|{0.001:f2}|{-0.5:f0}|{0.0:f2}|{-0.0000001:f3}")
    print("{1e300:f2}")
    print("{1e300:e5}|{1e-300:e5}|{5e-324:e3}|{1.7976931348623157e308:e3}")
    print("{5e-324:f2}|{1e-7:f9}|{1e-7:e2}|{0.000123:e1}|{123456789.0:e0}|{0.0:e2}|{-0.0:e1}")
    print("{99.995:f2}|{9.995:f2}|{0.9999:f2}|{999.9999:e3}|{9.9999:e2}|{0.99:f1}|{9.5:e0}|{8.5:e0}")
    print("{1.0:f}|{1.5:e}|{1234.5:n}|{-1234.5:n}|{0.1:f20}")
    let small: f32 = 0.1
    let third: f32 = 0.3
    let big: f32 = 16777216.0
    let top: f32 = 3.4028235e38
    let tiny: f32 = 1.4e-45
    print("{small:f10}|{third:f8}|{big:f2}|{top:f0}|{top:e9}|{tiny:e3}|{small:e9}")
    print("{small:f2}|{small}|{small:#.########}|{small:0.00#######}")
    print("{1e21:f0}|{1e22:n}|{123456789012345678901234567890.0:f1}|{4503599627370497.0:f1}|{9007199254740993.0:f0}")
}
