import std/io
import std/math
import std/ui/font
import std/ui/geometry
import std/ui/scene
import std/ui/text

struct Table {
    tag: str
    data: []u8
}

fn u16s(values: []i64) -> []u8 {
    var b: []u8 = []
    for v in values {
        io.put_be16(mut b, v)
    }
    b
}

fn zeros(n: i64) -> []u8 {
    var b: []u8 = []
    for _ in 0..n {
        b.push(0)
    }
    b
}

fn assemble(tables: []Table) -> str {
    var out: []u8 = []
    io.put_be32(mut out, 65536)
    io.put_be16(mut out, tables.len)
    for _ in 0..6 {
        out.push(0)
    }
    var offset = 12 + 16 * tables.len
    for t in tables {
        for i in 0..4 {
            out.push(t.tag[i])
        }
        io.put_be32(mut out, 0)
        io.put_be32(mut out, offset)
        io.put_be32(mut out, t.data.len)
        offset += (t.data.len + 3) / 4 * 4
    }
    for t in tables {
        for b in t.data {
            out.push(b)
        }
        for _ in 0..(4 - t.data.len % 4) % 4 {
            out.push(0)
        }
    }
    str(out)
}

fn box(x0: i64, x1: i64, y1: i64) -> []u8 {
    var b = u16s([1, 0, 0, 0, 0, 3, 0])
    for _ in 0..4 {
        b.push(1)
    }
    for dx in [x0, x1 - x0, 0, x0 - x1] {
        io.put_be16(mut b, dx)
    }
    for dy in [0, 0, y1, 0] {
        io.put_be16(mut b, dy)
    }
    b
}

fn cmap4(segments: []i64) -> []u8 {
    let n = segments.len / 3 + 1
    var b = u16s([0, 1, 3, 1, 0, 12, 4, 16 + 8 * n, 0, 2 * n, 0, 0, 0])
    for i in 0..n - 1 {
        io.put_be16(mut b, segments[3 * i + 1])
    }
    io.put_be16(mut b, 65535)
    io.put_be16(mut b, 0)
    for i in 0..n - 1 {
        io.put_be16(mut b, segments[3 * i])
    }
    io.put_be16(mut b, 65535)
    for i in 0..n - 1 {
        io.put_be16(mut b, segments[3 * i + 2] - segments[3 * i])
    }
    io.put_be16(mut b, 1)
    for _ in 0..n {
        io.put_be16(mut b, 0)
    }
    b
}

fn kern0(pairs: []i64) -> []u8 {
    var b = u16s([0, 1, 0, 14 + 2 * pairs.len, 1, pairs.len / 3, 0, 0, 0])
    for v in pairs {
        io.put_be16(mut b, v)
    }
    b
}

fn synthetic(upem: i64, advances: []i64, glyphs: [][]u8, segments: []i64, pairs: []i64) -> str {
    var head = zeros(54)
    io.set_be16(head, 18, upem)
    var hhea = zeros(36)
    io.set_be16(hhea, 4, upem)
    io.set_be16(hhea, 6, -upem / 4)
    io.set_be16(hhea, 8, upem / 8)
    io.set_be16(hhea, 34, advances.len)
    var maxp = zeros(6)
    io.set_be16(maxp, 4, glyphs.len)
    var hmtx: []u8 = []
    for a in advances {
        io.put_be16(mut hmtx, a)
        io.put_be16(mut hmtx, 0)
    }
    var glyf: []u8 = []
    var loca: []u8 = []
    io.put_be16(mut loca, 0)
    for g in glyphs {
        for x in g {
            glyf.push(x)
        }
        if g.len % 2 == 1 {
            glyf.push(0)
        }
        io.put_be16(mut loca, glyf.len / 2)
    }
    var tables = [
        Table { tag: "head", data: head }
        Table { tag: "hhea", data: hhea }
        Table { tag: "maxp", data: maxp }
        Table { tag: "cmap", data: cmap4(segments) }
        Table { tag: "hmtx", data: hmtx }
        Table { tag: "loca", data: loca }
        Table { tag: "glyf", data: glyf }
    ]
    if pairs.len > 0 {
        tables.push(Table { tag: "kern", data: kern0(pairs) })
    }
    assemble(tables)
}

fn latin() -> font.Font {
    let glyphs: [][]u8 = [[], [], box(64, 704, 768), box(64, 704, 640), box(64, 448, 384), box(0, 1536, 1280), box(64, 320, 256)]
    let data = synthetic(1024, [512, 256, 768, 768, 640, 640, 512], glyphs, [32, 32, 1, 65, 65, 2, 86, 86, 3, 97, 99, 4], [2, 3, -64, 3, 2, -64, 4, 5, 32])
    font.parse(data) or font.Font {}
}

fn wide() -> font.Font {
    let glyphs: [][]u8 = [[], box(0, 2048, 2048)]
    let data = synthetic(2048, [1024, 2048], glyphs, [90, 90, 1], [])
    font.parse(data) or font.Font {}
}

fn show(l: text.Layout) {
    print("{l.lines.len} lines, {l.width} x {l.height}, size {l.size}")
    for line in l.lines {
        var xs = ""
        for g in line.glyphs {
            xs = xs + " {g.font}:{g.glyph}@{g.x}"
        }
        print("  y {line.y} width {line.width}:{xs}")
    }
}

fn unbounded() -> f32 {
    f32(math.infinity())
}

fn sprites(sc: scene.Scene, a: scene.Atlas) {
    let k = f32(a.size)
    for sp in sc.sprites {
        print("  {sp.bounds.x},{sp.bounds.y} {sp.bounds.width}x{sp.bounds.height} tile {sp.tile.x * k},{sp.tile.y * k} {sp.tile.width * k}x{sp.tile.height * k}")
    }
}

fn pixel(a: scene.Atlas, x: i64, y: i64) -> u8 {
    a.pixels[y * a.size + x]
}

fn blank() -> scene.Scene {
    scene.empty(200, 100, geometry.rgb(0))
}

fn main() {
    var sys = text.system([latin()])
    print("atlas {sys.atlas.size} cached {text.cached(sys)}")

    show(sys.wrap("AV", 16.0, unbounded()))
    show(sys.wrap("VA", 16.0, unbounded()))
    show(sys.wrap("ab", 16.0, unbounded()))
    show(sys.wrap("A A", 16.0, unbounded()))
    show(sys.wrap(" A", 16.0, unbounded()))
    show(sys.wrap("Aq", 16.0, unbounded()))
    show(sys.wrap("AV", 32.0, unbounded()))

    show(sys.wrap("AA AA AA", 16.0, 40.0))
    show(sys.wrap("AAAAA", 16.0, 30.0))
    show(sys.wrap("AA   ", 16.0, 30.0))
    show(sys.wrap("AA   AA", 16.0, 30.0))
    show(sys.wrap("AA AA", 16.0, 12.0))
    show(sys.wrap("A\nA", 16.0, unbounded()))
    show(sys.wrap("A\n", 16.0, unbounded()))
    show(sys.wrap("\n\n", 16.0, unbounded()))
    show(sys.wrap("", 16.0, unbounded()))
    show(sys.wrap("A\r\nA", 16.0, unbounded()))
    show(sys.wrap("AA AA", 16.0, 24.0))
    show(sys.wrap("A AAA", 16.0, 24.0))

    let size = sys.measure("AA AA AA", 16.0, 40.0)
    print("measure {size.width} x {size.height}")
    let line = sys.measure("A", 16.0, unbounded())
    print("one line {line.width} x {line.height}")

    print("cached {text.cached(sys)}")
    let again = sys.wrap("AV", 16.0, unbounded())
    print("cached {text.cached(sys)} {again.width} {again.lines[0].glyphs[1].x}")
    sys.end_frame()
    print("cached {text.cached(sys)}")
    let after = sys.wrap("AV", 16.0, unbounded())
    print("cached {text.cached(sys)} {after.width}")

    var mixed = text.system([latin(), wide()])
    show(mixed.wrap("AZV", 16.0, unbounded()))
    show(mixed.wrap("ZZ", 8.0, unbounded()))

    var go = text.default_system()
    show(go.wrap("AV", 16.0, unbounded()))
    var fallback = text.system([])
    show(fallback.wrap("AV", 16.0, unbounded()))

    var packed = text.system([latin()])
    var sc = blank()
    let ab = packed.wrap("AV", 16.0, unbounded())
    packed.paint(mut sc, ab, geometry.point(10.25, 5.5), geometry.rgb(0xffffff), 2.0)
    print("sprites {sc.sprites.len} white {sc.sprites[0].color.r} clip {sc.sprites[0].clip.width}")
    sprites(sc, packed.atlas)
    let a = packed.atlas
    print("atlas pixels corner {pixel(a, 0, 0)} first {pixel(a, 1, 1)} last {pixel(a, 20, 24)} right {pixel(a, 21, 1)} below {pixel(a, 1, 25)} next {pixel(a, 23, 1)} dirty {a.dirty_top}..{a.dirty_bottom}")
    scene.clean(mut packed.atlas)
    var again_scene = blank()
    packed.paint(mut again_scene, ab, geometry.point(10.25, 5.5), geometry.rgb(0xffffff), 2.0)
    print("repainted {again_scene.sprites.len} dirty {scene.dirty(packed.atlas)}")

    var one = blank()
    packed.paint(mut one, packed.wrap("AV", 16.0, unbounded()), geometry.point(0.0, 0.0), geometry.rgb(0xff0000), 1.0)
    sprites(one, packed.atlas)
    print("dirty {scene.dirty(packed.atlas)} {packed.atlas.dirty_top}..{packed.atlas.dirty_bottom}")

    var spaced = blank()
    packed.paint(mut spaced, packed.wrap("A A", 16.0, unbounded()), geometry.point(0.0, 0.0), geometry.rgb(0x00ff00), 1.0)
    print("spaced {spaced.sprites.len}")
    sprites(spaced, packed.atlas)
    var empty_scene = blank()
    packed.paint(mut empty_scene, packed.wrap("   ", 16.0, unbounded()), geometry.point(0.0, 0.0), geometry.rgb(0x00ff00), 1.0)
    print("spaces only {empty_scene.sprites.len}")
    packed.end_frame()
    scene.clean(mut packed.atlas)
    var kept = blank()
    packed.paint(mut kept, packed.wrap("AV", 16.0, unbounded()), geometry.point(0.0, 0.0), geometry.rgb(0), 1.0)
    print("kept across a frame {scene.dirty(packed.atlas)}")

    var small = text.system_with_atlas([latin()], 32)
    var s1 = blank()
    small.paint(mut s1, small.wrap("AVabc", 16.0, unbounded()), geometry.point(0.0, 0.0), geometry.rgb(0), 1.0)
    print("full atlas {s1.sprites.len} sprites")
    sprites(s1, small.atlas)
    var s2 = blank()
    small.paint(mut s2, small.wrap("cAb", 16.0, unbounded()), geometry.point(0.0, 0.0), geometry.rgb(0), 1.0)
    print("after full {s2.sprites.len} sprites")
    sprites(s2, small.atlas)
    small.end_frame()
    print("cleared {pixel(small.atlas, 1, 1)} {pixel(small.atlas, 0, 0)} dirty {scene.dirty(small.atlas)}")
    var s3 = blank()
    small.paint(mut s3, small.wrap("bc", 16.0, unbounded()), geometry.point(0.0, 0.0), geometry.rgb(0), 1.0)
    print("next frame {s3.sprites.len} sprites")
    sprites(s3, small.atlas)

    var tiny = text.system_with_atlas([latin()], 8)
    var s4 = blank()
    tiny.paint(mut s4, tiny.wrap("AV", 16.0, unbounded()), geometry.point(0.0, 0.0), geometry.rgb(0), 1.0)
    print("too small {s4.sprites.len}")
}
