fn first[T](xs: []T, keep: fn(T) -> bool) -> T? {
    for x in xs {
        if keep(x) {
            return x
        }
    }
    none
}

fn count[T](xs: []T, keep: fn(T) -> bool) -> i64 {
    var n = 0
    for x in xs {
        if keep(x) {
            n += 1
        }
    }
    n
}

fn main() {
    let xs = [3, 8, 5, 10]
    print(first(xs, fn(x: i64) -> bool { x > 4 }) ?? -1)
    print(count(xs, fn(x: i64) -> bool { x % 2 == 0 }))
    print(count(["a", "bb"], fn(s: str) -> bool { s.len > 1 }))
}
