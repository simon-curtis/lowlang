import std/time/fault
import std/time/offset
import std/time/pattern
import std/time/timestamp
import std/time/zone
import std/time/zoned

struct Moment {
    secs: i64
    nanos: i64
}

struct FixedCase {
    layout: str
    input: str
}

struct ZoneCase {
    zone: str
    how: str
    layout: str
    input: str
}

fn describe(f: fault.Fault) -> str {
    match f {
        OutOfRange(what) => "OutOfRange"
        Invalid(what) => "Invalid"
        Syntax(at) => "Syntax({at})"
        Overflow => "Overflow"
        UnknownZone(name) => "UnknownZone"
        Malformed(what) => "Malformed"
        Unsupported(what) => "Unsupported"
        Skipped => "Skipped"
        Ambiguous => "Ambiguous"
        OffsetConflict => "OffsetConflict"
    }
}

fn how_of(word: str) -> zoned.Disambiguation {
    if word == "earlier" {
        return zoned.Disambiguation.Earlier
    }
    if word == "later" {
        return zoned.Disambiguation.Later
    }
    if word == "reject" {
        return zoned.Disambiguation.Reject
    }
    zoned.Disambiguation.Compatible
}

fn formatted(z: zoned.Zoned, layout: str) -> str {
    zoned.format(z, layout) catch { e => return "!{describe(e)}" }
}

fn short_line(z: zoned.Zoned) -> str {
    let ts = zoned.timestamp(z)
    let unix = timestamp.unix_seconds(ts)
    let nanos = timestamp.subsec_nanos(ts)
    let shift = offset.seconds_of(zoned.offset(z))
    let civil = formatted(z, "%Y-%m-%dT%H:%M:%S")
    "{unix} {nanos} {shift} {civil}"
}

fn full_line(z: zoned.Zoned) -> str {
    "{short_line(z)} {zoned.abbreviation(z)}"
}

fn format_section(zones: []str, moments: []Moment, layouts: []str) {
    for name in zones {
        let tz = zone.named(name) or return print("!zone {name}")
        for m in moments {
            let ts = timestamp.from_parts(m.secs, m.nanos) or return print("!moment")
            let z = zoned.of(ts, tz) or return print("!of")
            for layout in layouts {
                let out = formatted(z, layout)
                print("format {name} {m.secs} {m.nanos} {layout} => [{out}]")
            }
        }
    }
}

fn parsed_line(c: FixedCase) -> str {
    let z = zoned.parse_with(c.input, c.layout) catch { e => return "!{describe(e)}" }
    short_line(z)
}

fn parse_section(cases: []FixedCase) {
    for c in cases {
        let line = parsed_line(c)
        print("parse {c.layout} | {c.input} => {line}")
    }
}

fn zone_line(c: ZoneCase) -> str {
    let tz = zone.named(c.zone) catch { e => return "!{describe(e)}" }
    let z = zoned.parse_with_zone(c.input, c.layout, tz, how_of(c.how)) catch { e => return "!{describe(e)}" }
    full_line(z)
}

fn zone_section(cases: []ZoneCase) {
    for c in cases {
        let line = zone_line(c)
        print("zone {c.zone} {c.how} {c.layout} | {c.input} => {line}")
    }
}

fn german(short_months: []str) -> pattern.Names {
    pattern.Names {
        months: [
            "Januar", "Februar", "Maerz", "April", "Mai", "Juni", "Juli", "August", "September", "Oktober", "November", "Dezember"
        ],
        short_months,
        weekdays: ["Montag", "Dienstag", "Mittwoch", "Donnerstag", "Freitag", "Samstag", "Sonntag"],
        short_weekdays: ["Mo", "Di", "Mi", "Do", "Fr", "Sa", "So"],
        am: "vorm.",
        pm: "nachm."
    }
}

fn german_short_months() -> []str {
    ["Jan", "Feb", "Mrz", "Apr", "Mai", "Jun", "Jul", "Aug", "Sep", "Okt", "Nov", "Dez"]
}

fn names_format(z: zoned.Zoned, layout: str, names: pattern.Names) -> str {
    let p = pattern.compile(layout) catch { e => return "!{describe(e)}" }
    let out = zoned.format_names(z, p, names) catch { e => return "!{describe(e)}" }
    "[{out}]"
}

fn names_parse(layout: str, input: str, names: pattern.Names) -> str {
    let p = pattern.compile(layout) catch { e => return "!{describe(e)}" }
    let z = zoned.parse_names(input, p, names) catch { e => return "!{describe(e)}" }
    short_line(z)
}

fn names_parse_zone(layout: str, input: str, names: pattern.Names, tz: zone.Zone) -> str {
    let p = pattern.compile(layout) catch { e => return "!{describe(e)}" }
    let how = zoned.Disambiguation.Compatible
    let z = zoned.parse_names_zone(input, p, names, tz, how) catch { e => return "!{describe(e)}" }
    full_line(z)
}

fn reuse_line(z: zoned.Zoned) -> str {
    let date_pattern = pattern.compile("%F") catch { e => return "!{describe(e)}" }
    let time_pattern = pattern.compile("%T") catch { e => return "!{describe(e)}" }
    let first = zoned.format_with(z, date_pattern) catch { e => return "!{describe(e)}" }
    let second = zoned.format_with(z, time_pattern) catch { e => return "!{describe(e)}" }
    "[{first}] [{second}]"
}

fn round_trip_line(z: zoned.Zoned, tz: zone.Zone) -> str {
    let text = formatted(z, "%F %T %z")
    let how = zoned.Disambiguation.Compatible
    let p = pattern.compile("%F %T %z") catch { e => return "!{describe(e)}" }
    let back = zoned.parse_pattern_zone(text, p, tz, how) catch { e => return "!{describe(e)}" }
    full_line(back)
}

fn names_section() {
    let ny = zone.named("America/New_York") or return print("!zone")
    let berlin = zone.named("Europe/Berlin") or return print("!zone")
    let ts = timestamp.from_unix(1794409445) or return print("!ts")
    let z = zoned.of(ts, ny) or return print("!of")
    let names = german(german_short_months())
    let few = german(["Jan", "Feb"])
    let long_layout = "%A, %d. %B %Y %H:%M:%S %z"
    let zone_layout = "%A, %d. %B %Y %H:%M:%S"
    let formatted_long = names_format(z, long_layout, names)
    print("names format => {formatted_long}")
    let formatted_short = names_format(z, "%a %b %I:%M %p", names)
    print("names short => {formatted_short}")
    let formatted_bad = names_format(z, "%b", few)
    print("names bad => {formatted_bad}")
    let parsed = names_parse(long_layout, "Mittwoch, 11. November 2026 10:04:05 -0500", names)
    print("names parse => {parsed}")
    let parsed_zone = names_parse_zone(zone_layout, "Mittwoch, 11. November 2026 16:04:05", names, berlin)
    print("names parse_zone => {parsed_zone}")
    let english = names_format(z, long_layout, pattern.english())
    print("names english => {english}")
    let reused = reuse_line(z)
    print("names reuse => {reused}")
    let bad_pattern = names_format(z, "%Q", names)
    print("names compile => {bad_pattern}")
    let locale_pattern = names_format(z, "%c", names)
    print("names locale => {locale_pattern}")
    let round = round_trip_line(z, ny)
    print("names round_trip => {round}")
}

