import std/io
import std/quic/recovery

fn ms(n: i64) -> i64 {
    n * 1000000
}

fn data(number: i64, time: i64, size: i64) -> recovery.Sent {
    recovery.Sent { number, time, size, ack_eliciting: true, in_flight: true }
}

fn span(smallest: i64, largest: i64) -> recovery.AckRange {
    recovery.AckRange { smallest, largest }
}

fn numbers(list: []recovery.Sent) -> []i64 {
    var out: []i64 = []
    for p in list {
        push(mut out, p.number)
    }
    out
}

fn probe_name(p: recovery.Space?) -> str {
    match p {
        some(s) => match s {
            Initial => "initial"
            Handshake => "handshake"
            Application => "application"
        }
        none => "none"
    }
}

fn ssthresh_text(r: *recovery.Recovery) -> str {
    if r.ssthresh > 4611686018427387904 { "inf" } else { "{r.ssthresh}" }
}

fn show(label: str, r: *recovery.Recovery) {
    print("{label}: latest={r.latest_rtt} srtt={r.smoothed_rtt} var={r.rttvar} min={r.min_rtt} cwnd={r.congestion_window} flight={r.bytes_in_flight} ssthresh={ssthresh_text(r)} pto={r.pto_count} deadline={recovery.deadline(r)}")
}

fn show_ack(res: recovery.AckResult) {
    print("  acked={numbers(res.acked)} lost={numbers(res.lost)} rtt_updated={res.rtt_updated}")
}

fn show_timeout(t: recovery.Timeout) {
    print("  timeout lost={numbers(t.lost)} probe={probe_name(t.probe)} probes={t.probes}")
}

fn baseline() -> *recovery.Recovery ! io.Error {
    let r = recovery.recovery(1200)
    r.handshake_confirmed = true
    recovery.on_sent(r, Application, data(0, 0, 1200))
    let res = recovery.on_ack(r, Application, [span(0, 0)], 0, ms(100))?
    r
}

fn initial_state() {
    let r = recovery.recovery(1200)
    show("new", r)
    let big = recovery.recovery(9000)
    print("window for 9000: {big.congestion_window} flight {big.bytes_in_flight}")
    print("pto {recovery.pto_duration(r)} closing {recovery.closing_duration(r)}")
}

fn first_sample() ! io.Error {
    let r = recovery.recovery(1200)
    recovery.on_sent(r, Application, data(0, 0, 1200))
    show("sent", r)
    r.handshake_confirmed = true
    recovery.rearm_timer(r, 0)
    show("confirmed", r)
    let res = recovery.on_ack(r, Application, [span(0, 0)], 0, ms(100))?
    show_ack(res)
    show("acked", r)
    print("first sample {r.first_rtt_sample} largest acked {recovery.largest_acked(r, Application)}")
}

fn smoothing() ! io.Error {
    let r = baseline()?
    recovery.on_sent(r, Application, data(1, ms(200), 1200))
    let first = recovery.on_ack(r, Application, [span(1, 1)], ms(30), ms(340))?
    show_ack(first)
    show("capped delay", r)
    recovery.on_sent(r, Application, data(2, ms(400), 1200))
    let second = recovery.on_ack(r, Application, [span(2, 2)], ms(10), ms(540))?
    show_ack(second)
    show("small delay", r)
    recovery.on_sent(r, Application, data(3, ms(600), 1200))
    let third = recovery.on_ack(r, Application, [span(3, 3)], ms(500), ms(700))?
    show_ack(third)
    show("implausible delay", r)
}

fn delay_before_confirmation() ! io.Error {
    let r = recovery.recovery(1200)
    recovery.on_sent(r, Handshake, data(0, 0, 1200))
    let first = recovery.on_ack(r, Handshake, [span(0, 0)], 0, ms(100))?
    recovery.on_sent(r, Handshake, data(1, ms(200), 1200))
    let second = recovery.on_ack(r, Handshake, [span(1, 1)], ms(40), ms(340))?
    show_ack(second)
    show("handshake delay uncapped", r)
    recovery.on_sent(r, Initial, data(0, ms(400), 1200))
    let third = recovery.on_ack(r, Initial, [span(0, 0)], ms(40), ms(540))?
    show_ack(third)
    show("initial delay ignored", r)
}

fn packet_and_time_threshold() ! io.Error {
    let r = baseline()?
    for k in 1..6 {
        recovery.on_sent(r, Application, data(k, ms(199 + k), 1200))
    }
    show("sent five", r)
    let res = recovery.on_ack(r, Application, [span(5, 5)], 0, ms(205))?
    show_ack(res)
    show("packet threshold", r)
    print("  unresolved {recovery.unresolved(r, Application)} loss time {recovery.loss_time(r, Application)} largest acked {recovery.largest_acked(r, Application)}")
    let first = recovery.on_timeout(r, 300578125)
    show_timeout(first)
    show("time threshold one", r)
    let second = recovery.on_timeout(r, 301578125)
    show_timeout(second)
    show("time threshold two", r)
    for k in 6..11 {
        recovery.on_sent(r, Application, data(k, ms(394 + k), 1200))
    }
    let again = recovery.on_ack(r, Application, [span(10, 10)], 0, ms(450))?
    show_ack(again)
    show("second round trip", r)
}

fn probe_backoff() ! io.Error {
    let r = baseline()?
    recovery.on_sent(r, Application, data(1, ms(200), 1200))
    show("armed", r)
    var due = recovery.deadline(r)
    for k in 0..3 {
        let t = recovery.on_timeout(r, due)
        show_timeout(t)
        show("backoff {k + 1}", r)
        due = recovery.deadline(r)
    }
    recovery.on_sent(r, Application, data(2, ms(2800), 1200))
    show("probe sent", r)
    let res = recovery.on_ack(r, Application, [span(2, 2)], 0, ms(2900))?
    show_ack(res)
    show("probe acked", r)
}

fn slow_start() ! io.Error {
    let r = baseline()?
    for k in 1..6 {
        recovery.on_sent(r, Application, data(k, ms(199 + k), 1200))
    }
    print("can send 7200 {recovery.can_send(r, 7200)} 7201 {recovery.can_send(r, 7201)}")
    let res = recovery.on_ack(r, Application, [span(1, 5)], 0, ms(300))?
    show_ack(res)
    show("slow start", r)
}

fn congestion_avoidance() ! io.Error {
    let r = baseline()?
    r.ssthresh = r.congestion_window
    for k in 1..12 {
        recovery.on_sent(r, Application, data(k, ms(199 + k), 1200))
    }
    let first = recovery.on_ack(r, Application, [span(1, 10)], 0, ms(300))?
    show_ack(first)
    show("ten acked", r)
    let second = recovery.on_ack(r, Application, [span(11, 11)], 0, ms(301))?
    show_ack(second)
    show("window acked", r)
}

fn recovery_period() ! io.Error {
    let r = baseline()?
    for k in 1..11 {
        recovery.on_sent(r, Application, data(k, ms(199 + k), 1200))
    }
    let loss = recovery.on_ack(r, Application, [span(10, 10)], 0, ms(250))?
    show_ack(loss)
    show("entered recovery", r)
    let late = recovery.on_ack(r, Application, [span(9, 9)], 0, ms(260))?
    show_ack(late)
    show("ack from before recovery", r)
    let timeout = recovery.on_timeout(r, recovery.deadline(r))
    show_timeout(timeout)
    show("loss inside recovery", r)
    for k in 11..17 {
        recovery.on_sent(r, Application, data(k, ms(389 + k), 1200))
    }
    let after = recovery.on_ack(r, Application, [span(11, 16)], 0, ms(450))?
    show_ack(after)
    show("after recovery", r)
}

fn limited_sender() ! io.Error {
    let r = baseline()?
    r.limited = true
    recovery.on_sent(r, Application, data(1, ms(200), 1200))
    let res = recovery.on_ack(r, Application, [span(1, 1)], 0, ms(300))?
    show_ack(res)
    show("limited", r)
}

fn ack_only_packets() ! io.Error {
    let r = baseline()?
    let quiet = recovery.Sent { number: 1, time: ms(200), size: 80, ack_eliciting: false, in_flight: false }
    recovery.on_sent(r, Application, quiet)
    show("ack only sent", r)
    let res = recovery.on_ack(r, Application, [span(1, 1)], 0, ms(300))?
    show_ack(res)
    show("ack only acked", r)
    let repeat = recovery.on_ack(r, Application, [span(0, 1)], 0, ms(310))?
    show_ack(repeat)
}

fn quiet(number: i64, time: i64) -> recovery.Sent {
    recovery.Sent { number, time, size: 80, ack_eliciting: false, in_flight: false }
}

fn ack_only_raises_largest() ! io.Error {
    let r = baseline()?
    for k in 1..6 {
        recovery.on_sent(r, Application, data(k, ms(199 + k), 1200))
    }
    recovery.on_sent(r, Application, quiet(6, ms(210)))
    show("data then ack only", r)
    let res = recovery.on_ack(r, Application, [span(6, 6)], 0, ms(300))?
    show_ack(res)
    show("ack only largest", r)
    print("  unresolved {recovery.unresolved(r, Application)} largest acked {recovery.largest_acked(r, Application)}")
}

fn ack_only_flood() ! io.Error {
    let r = baseline()?
    for k in 1..200001 {
        recovery.on_sent(r, Application, quiet(k, ms(200)))
    }
    recovery.on_sent(r, Application, data(200001, ms(201), 1200))
    print("ack only flood: unresolved {recovery.unresolved(r, Application)} flight {r.bytes_in_flight}")
    var repeats: []recovery.AckRange = []
    for k in 0..240 {
        push(mut repeats, span(100000 - 2 * k, 100000 - 2 * k))
    }
    var total = 0
    for k in 0..400 {
        let res = recovery.on_ack(r, Application, repeats, 0, ms(300))?
        total += res.acked.len
    }
    print("  400 frames of 240 ranges: acked {total} unresolved {recovery.unresolved(r, Application)}")
    let res = recovery.on_ack(r, Application, [span(200001, 200001)], 0, ms(400))?
    show_ack(res)
    print("  unresolved {recovery.unresolved(r, Application)} flight {r.bytes_in_flight}")
}

fn persistent_congestion() ! io.Error {
    let r = baseline()?
    recovery.on_sent(r, Application, data(1, ms(200), 1200))
    recovery.on_sent(r, Application, data(2, ms(400), 1200))
    recovery.on_sent(r, Application, data(3, ms(1000), 1200))
    recovery.on_sent(r, Application, data(4, ms(1400), 1200))
    recovery.on_sent(r, Application, data(5, ms(1800), 1200))
    recovery.on_sent(r, Application, data(6, ms(1900), 1200))
    let res = recovery.on_ack(r, Application, [span(6, 6)], 0, ms(2000))?
    show_ack(res)
    show("persistent congestion", r)
    print("  recovery start {r.recovery_start_time}")
    recovery.on_sent(r, Application, data(7, ms(2100), 1200))
    let next = recovery.on_ack(r, Application, [span(7, 7)], 0, ms(2150))?
    show_ack(next)
    show("next sample", r)
}

fn acked_between_losses() ! io.Error {
    let r = baseline()?
    recovery.on_sent(r, Application, data(1, ms(200), 1200))
    recovery.on_sent(r, Application, data(2, ms(400), 1200))
    recovery.on_sent(r, Application, data(3, ms(1000), 1200))
    recovery.on_sent(r, Application, data(4, ms(1400), 1200))
    recovery.on_sent(r, Application, data(5, ms(1800), 1200))
    recovery.on_sent(r, Application, data(6, ms(1900), 1200))
    let res = recovery.on_ack(r, Application, [span(6, 6), span(3, 3)], 0, ms(2000))?
    show_ack(res)
    show("acked between", r)
}

fn discard_and_anti_deadlock() ! io.Error {
    let r = recovery.recovery(1200)
    recovery.on_sent(r, Initial, data(0, 0, 1200))
    recovery.on_sent(r, Initial, data(1, ms(1), 100))
    recovery.on_sent(r, Handshake, data(0, ms(10), 500))
    show("flight", r)
    let first = recovery.on_timeout(r, recovery.deadline(r))
    show_timeout(first)
    show("initial pto", r)
    recovery.discard_space(r, Initial, ms(1100))
    print("  initial unresolved {recovery.unresolved(r, Initial)}")
    show("initial discarded", r)
    r.has_handshake_keys = true
    recovery.discard_space(r, Handshake, ms(1200))
    show("handshake discarded", r)
    let second = recovery.on_timeout(r, recovery.deadline(r))
    show_timeout(second)
    show("anti-deadlock", r)
    let early = recovery.recovery(1200)
    recovery.rearm_timer(early, ms(500))
    show("no handshake keys", early)
    let third = recovery.on_timeout(early, recovery.deadline(early))
    show_timeout(third)
}

fn client_address_validation() ! io.Error {
    let r = recovery.recovery(1200)
    recovery.on_sent(r, Initial, data(0, 0, 1200))
    let first = recovery.on_timeout(r, recovery.deadline(r))
    show_timeout(first)
    let initial_ack = recovery.on_ack(r, Initial, [span(0, 0)], 0, ms(1000))?
    print("after initial ack pto={r.pto_count} validated={r.peer_completed_address_validation}")
    recovery.on_sent(r, Handshake, data(0, ms(1000), 600))
    let handshake_ack = recovery.on_ack(r, Handshake, [span(0, 0)], 0, ms(1100))?
    print("after handshake ack pto={r.pto_count} validated={r.peer_completed_address_validation} deadline={recovery.deadline(r)}")
}

fn server_amplification() {
    let r = recovery.recovery(1200)
    r.peer_completed_address_validation = true
    recovery.on_sent(r, Initial, data(0, 0, 1200))
    r.amplification_blocked = true
    recovery.rearm_timer(r, ms(10))
    print("blocked deadline {recovery.deadline(r)}")
    let blocked = recovery.on_timeout(r, ms(2000))
    show_timeout(blocked)
    r.amplification_blocked = false
    recovery.rearm_timer(r, ms(50))
    print("unblocked deadline {recovery.deadline(r)}")
    let idle = recovery.recovery(1200)
    idle.peer_completed_address_validation = true
    recovery.rearm_timer(idle, ms(50))
    print("idle server deadline {recovery.deadline(idle)}")
}

fn application_not_armed() {
    let r = recovery.recovery(1200)
    recovery.on_sent(r, Application, data(0, 0, 1200))
    print("unconfirmed deadline {recovery.deadline(r)}")
    r.handshake_confirmed = true
    recovery.rearm_timer(r, ms(1))
    print("confirmed deadline {recovery.deadline(r)}")
}

fn malformed_name(e: io.Error) -> str {
    match e {
        Malformed => "malformed"
        _ => "other"
    }
}

fn expect_malformed(label: str, r: *recovery.Recovery, space: recovery.Space, ranges: []recovery.AckRange, delay: i64) {
    let before = r.bytes_in_flight
    let outcome = recovery.on_ack(r, space, ranges, delay, ms(400)) catch {
        e => {
            print("{label}: {malformed_name(e)} flight {before} -> {r.bytes_in_flight} cwnd {r.congestion_window}")
            return
        }
    }
    print("{label}: accepted acked={numbers(outcome.acked)} lost={numbers(outcome.lost)}")
}

fn hostile_acks() ! io.Error {
    let r = baseline()?
    for k in 1..5 {
        recovery.on_sent(r, Application, data(k, ms(199 + k), 1200))
    }
    expect_malformed("unsent number", r, Application, [span(5, 5)], 0)
    expect_malformed("unsent range", r, Application, [span(2, 9)], 0)
    expect_malformed("huge number", r, Application, [span(4611686018427387903, 4611686018427387903)], 0)
    expect_malformed("empty", r, Application, [], 0)
    expect_malformed("reversed", r, Application, [span(3, 2)], 0)
    expect_malformed("negative", r, Application, [span(-1, 2)], 0)
    expect_malformed("ascending ranges", r, Application, [span(1, 1), span(3, 3)], 0)
    expect_malformed("overlapping ranges", r, Application, [span(2, 4), span(1, 2)], 0)
    expect_malformed("adjacent order", r, Application, [span(3, 4), span(3, 3)], 0)
    expect_malformed("handshake never sent", r, Handshake, [span(0, 0)], 0)
    print("state after rejects: flight {r.bytes_in_flight} unresolved {recovery.unresolved(r, Application)} largest {recovery.largest_acked(r, Application)} pto {r.pto_count}")

    let wide = recovery.on_ack(r, Application, [span(0, 4)], 4611686018427387903, ms(400))?
    show_ack(wide)
    show("huge delay", r)

    let all = baseline()?
    recovery.on_sent(all, Application, data(1, ms(200), 1200))
    let negative = recovery.on_ack(all, Application, [span(1, 1)], -5, ms(100))?
    show_ack(negative)
    show("negative sample and delay", all)
    recovery.on_sent(all, Application, data(2, ms(500), 1200))
    let capped = recovery.on_ack(all, Application, [span(2, 2)], 0, 9000000000000000000)?
    show_ack(capped)
    show("huge sample", all)
}

fn range_flood() ! io.Error {
    let r = baseline()?
    for k in 1..601 {
        recovery.on_sent(r, Application, data(k, ms(200), 1200))
    }
    var unsent: []recovery.AckRange = []
    var top = 4611686018427387903
    for k in 0..1000 {
        push(mut unsent, span(top - 1, top))
        top -= 4
    }
    expect_malformed("unsent flood", r, Application, unsent, 0)
    var overlapping: []recovery.AckRange = [span(2, 3)]
    for k in 0..1000 {
        push(mut overlapping, span(0, 0))
    }
    expect_malformed("overlapping flood", r, Application, overlapping, 0)
    var singles: []recovery.AckRange = []
    for k in 0..300 {
        push(mut singles, span(598 - 2 * k, 598 - 2 * k))
    }
    let res = recovery.on_ack(r, Application, singles, 0, ms(400))?
    print("300 ranges: acked {res.acked.len} lost {res.lost.len} rtt_updated {res.rtt_updated}")
    print("unresolved {recovery.unresolved(r, Application)} flight {r.bytes_in_flight} cwnd {r.congestion_window}")
}

fn skipped_numbers() ! io.Error {
    let r = baseline()?
    recovery.on_sent(r, Application, data(1, ms(200), 1200))
    recovery.skip(r, Application, 2)
    recovery.on_sent(r, Application, data(3, ms(201), 1200))
    expect_malformed("covers skipped", r, Application, [span(1, 3)], 0)
    expect_malformed("exact skipped", r, Application, [span(2, 2)], 0)
    expect_malformed("skipped above", r, Application, [span(3, 3), span(2, 2)], 0)
    let res = recovery.on_ack(r, Application, [span(3, 3), span(1, 1)], 0, ms(400))?
    show_ack(res)
    show("acked around skip", r)
    recovery.skip(r, Application, 3)
    recovery.skip(r, Application, 9)
    expect_malformed("later skip", r, Application, [span(9, 9)], 0)
    for k in 0..40 {
        recovery.skip(r, Application, 100 + k)
    }
    expect_malformed("newest skip kept", r, Application, [span(139, 139)], 0)
    expect_malformed("oldest skip forgotten", r, Application, [span(100, 100)], 0)
}

fn main() ! io.Error {
    initial_state()
    first_sample()?
    smoothing()?
    delay_before_confirmation()?
    packet_and_time_threshold()?
    probe_backoff()?
    slow_start()?
    congestion_avoidance()?
    recovery_period()?
    limited_sender()?
    ack_only_packets()?
    ack_only_raises_largest()?
    ack_only_flood()?
    persistent_congestion()?
    acked_between_losses()?
    discard_and_anti_deadlock()?
    client_address_validation()?
    server_amplification()
    application_not_armed()
    hostile_acks()?
    range_flood()?
    skipped_numbers()?
}
