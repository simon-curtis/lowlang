extern "c" {
    fn abs(n: i32) -> i32
}

struct Point {
    x: i64
    y: i64
}

struct Label {
    text: str
    at: Point
    weight: f64
    small: u8
    flag: bool
}

enum Shape {
    Circle(Point, f64)
    Rect(Point, Point)
    Text(str)
    Empty
}

enum Color {
    Red
    Green
}

struct Pair[A, B] {
    first: A
    second: B
}

extern struct Packed {
    a: u8
    b: i32
    c: f32
}

struct Linked {
    value: i64
    next: *Linked?
}

fn changed[T: Eq](old: T, new: T) -> bool {
    old != new
}

fn main() {
    let p = Point { x: 1, y: 2 }
    print(p == Point { x: 1, y: 2 })
    print(p != Point { x: 1, y: 3 })

    let hello = "hel"
    let a = Label { text: "{hello}lo", at: p, weight: 0.5, small: 200, flag: true }
    let b = Label { text: "hello", at: Point { x: 1, y: 2 }, weight: 0.5, small: 200, flag: true }
    print(a == b)
    print(a == Label { text: "hello", at: p, weight: 0.5, small: 201, flag: true })
    let nan = 0.0 / 0.0
    let c = Label { text: "n", at: p, weight: nan, small: 0, flag: false }
    print(c == c)
    print(Label { text: "z", at: p, weight: 0.0, small: 0, flag: false } == Label { text: "z", at: p, weight: -0.0, small: 0, flag: false })

    print(Shape.Circle(p, 1.5) == Circle(Point { x: 1, y: 2 }, 1.5))
    let r: Shape = Rect(p, p)
    let t: Shape = Text("hi")
    print(r == t)
    print(t == Text("h{"i"}"))
    print(Shape.Empty == Empty)
    let e: Shape = Empty
    print(e == Text(""))
    print(Color.Red == Red)
    print(Color.Red != Green)

    let maybe: Point? = p
    print(maybe == p)
    print(maybe == none)
    let nothing: Point? = none
    print(nothing == none)

    print(Pair { first: 1, second: "x" } == Pair { first: 1, second: "x" })
    print(changed(p, Point { x: 1, y: 2 }))
    print(changed(Pair { first: Color.Red, second: 2.0 }, Pair { first: Color.Green, second: 2.0 }))

    let k = Packed { a: 1, b: -5, c: 2.5 }
    print(k == Packed { a: 1, b: -5, c: 2.5 })
    print(k == Packed { a: 1, b: abs(-5), c: 2.5 })

    let shared = new(Linked { value: 1, next: none })
    print(Linked { value: 2, next: shared } == Linked { value: 2, next: shared })
    print(Linked { value: 2, next: shared } == Linked { value: 2, next: new(Linked { value: 1, next: none }) })
}
