import std/crypto/bls12381
import std/crypto/nistec
import std/crypto/pairing
import std/text

struct Vector {
    msg: str
    p: str
}

fn element_hex(c: *pairing.Curve, a: u64[]) -> str {
    var out = ""
    for i in 0..a.len / c.l {
        let plain = nistec.element(c.fp)
        nistec.from_mont(c.fp, plain, a[i * c.l..(i + 1) * c.l])
        out = out + text.encode_hex(nistec.encode(plain))
    }
    out
}

fn point_hex(c: *pairing.Curve, p: pairing.Point) -> str {
    match pairing.affine(c, p) {
        some(a) => element_hex(c, a.x) + element_hex(c, a.y)
        none => "infinity"
    }
}

fn suite(h: *bls12381.Hasher, name: str, vectors: Vector[], whole: fn(*bls12381.Hasher, u8[], u8[]) -> pairing.Point) {
    let dst = bytes("QUUX-V01-CS02-with-" + name)
    var matched = 0
    for v in vectors {
        let got = point_hex(h.curve, whole(h, bytes(v.msg), dst))
        if got == v.p {
            matched += 1
        } else {
            print("{name} {v.msg}: got {got}, want {v.p}")
        }
    }
    print("{name}: {matched} of {vectors.len} match")
}

fn unhex(s: str) -> u8[] {
    text.decode_hex(s) or bytes("")
}

fn multiples() -> u64[] {
    [0, 1, 2, 3, 77, 999]
}

fn codec(name: str, base: pairing.Point, vectors: str[], encoder: fn(*pairing.Curve, pairing.Point) -> u8[], decoder: fn(*pairing.Curve, u8[]) -> pairing.Point ! bls12381.Error) {
    let c = pairing.bls12_381()
    var matched = 0
    for i, k in multiples() {
        let p = pairing.mul_public(c, base, [k])
        let encoded = text.encode_hex(encoder(c, p)) == vectors[i]
        let decoded = pairing.equal(c, decoder(c, unhex(vectors[i])) or pairing.mul_public(c, base, [k + 1]), p)
        if encoded && decoded {
            matched += 1
        } else {
            print("{name} [{k}] G: encodes {encoded}, decodes {decoded}")
        }
    }
    print("{name}: {matched} of {vectors.len} match")
}

fn rejection(data: str, decoder: fn(*pairing.Curve, u8[]) -> pairing.Point ! bls12381.Error) -> str {
    let c = pairing.bls12_381()
    let p = decoder(c, unhex(data)) catch {
        Length => return "Length"
        Flags => return "Flags"
        Coordinate => return "Coordinate"
        NotOnCurve => return "NotOnCurve"
        NotInSubgroup => return "NotInSubgroup"
    }
    if pairing.is_infinity(p) { "infinity" } else { "a point" }
}

fn replaced(s: str, at: i64, with: str) -> str {
    s[..at] + with + s[at + with.len..]
}

fn rejections() {
    let g1 = g1_compressed_vectors()[1]
    let g1_full = g1_uncompressed_vectors()[1]
    let g2 = g2_compressed_vectors()[1]
    let p = "1a0111ea397fe69a4b1ba7b6434bacd764774b84f38512bf6730d2a0f6b0f6241eabfffeb153ffffb9feffffffffaaab"
    print("47 bytes: {rejection(g1[..94], bls12381.decode_g1)}")
    print("48 bytes without the compression flag: {rejection(replaced(g1, 0, "17"), bls12381.decode_g1)}")
    print("96 bytes with the compression flag: {rejection(replaced(g1_full, 0, "97"), bls12381.decode_g1)}")
    print("96 bytes with the sort flag: {rejection(replaced(g1_full, 0, "37"), bls12381.decode_g1)}")
    print("infinity with the sort flag: {rejection("e0" + text.repeat("0", 94), bls12381.decode_g1)}")
    print("infinity with a nonzero byte: {rejection("c0" + text.repeat("0", 92) + "01", bls12381.decode_g1)}")
    print("compressed infinity: {rejection("c0" + text.repeat("0", 94), bls12381.decode_g1)}")
    print("uncompressed infinity: {rejection("40" + text.repeat("0", 190), bls12381.decode_g1)}")
    print("x = p: {rejection("9a" + p[2..], bls12381.decode_g1)}")
    print("x = 1, where x^3 + 4 is not a square: {rejection("80" + text.repeat("0", 92) + "01", bls12381.decode_g1)}")
    print("y changed: {rejection(replaced(g1_full, 190, "00"), bls12381.decode_g1)}")
    print("Q0 of RFC 9380 J.9.1, outside G1: {rejection("11a3cce7e1d90975990066b2f2643b9540fa40d6137780df4e753a8054d07580db3b7f1f03396333d4a359d1fe3766fe0eeaf6d794e479e270da10fdaf768db4c96b650a74518fc67b04b03927754bac66f3ac720404f339ecdcc028afa091b7", bls12381.decode_g1)}")
    print("G2 96 bytes without the compression flag: {rejection(replaced(g2, 0, "13"), bls12381.decode_g2)}")
    print("G2 compressed infinity: {rejection("c0" + text.repeat("0", 190), bls12381.decode_g2)}")
    print("G2 uncompressed infinity: {rejection("40" + text.repeat("0", 382), bls12381.decode_g2)}")
    print("G2 x.c1 = p: {rejection(p + g2_uncompressed_vectors()[1][96..], bls12381.decode_g2)}")
    print("Q0 of RFC 9380 J.10.1, outside G2: {rejection(q0_g2, bls12381.decode_g2)}")
}

/// Hashes the messages of RFC 9380 appendices J.9.1, J.9.2, J.10.1 and J.10.2 with the four BLS12-381 suites and compares the points with the RFC's. Encodes and decodes `[k] G` for six `k` against entries of zkcrypto bls12_381's `src/tests/*_valid_test_vectors.dat`, which hold `[k] G` for `k` below 1000 in each format, then rejects malformed encodings: the points outside the subgroups are `Q0` of the empty message in RFC 9380, on the curve before cofactor clearing.
fn main() {
    let h = bls12381.hasher(pairing.bls12_381())
    suite(h, "BLS12381G1_XMD:SHA-256_SSWU_RO_", g1_hash_vectors(), bls12381.hash_to_g1)
    suite(h, "BLS12381G1_XMD:SHA-256_SSWU_NU_", g1_encode_vectors(), bls12381.encode_to_g1)
    suite(h, "BLS12381G2_XMD:SHA-256_SSWU_RO_", g2_hash_vectors(), bls12381.hash_to_g2)
    suite(h, "BLS12381G2_XMD:SHA-256_SSWU_NU_", g2_encode_vectors(), bls12381.encode_to_g2)
    let c = h.curve
    codec("G1 compressed", c.g1, g1_compressed_vectors(), bls12381.compress_g1, bls12381.decode_g1)
    codec("G1 uncompressed", c.g1, g1_uncompressed_vectors(), bls12381.serialize_g1, bls12381.decode_g1)
    codec("G2 compressed", c.g2, g2_compressed_vectors(), bls12381.compress_g2, bls12381.decode_g2)
    codec("G2 uncompressed", c.g2, g2_uncompressed_vectors(), bls12381.serialize_g2, bls12381.decode_g2)
    rejections()
}

const q0_g2: str = ""

