fn g2_hash_vectors() -> Vector[] {
    [
        Vector { msg: "", p: "" }
        Vector { msg: "abc", p: "" }
        Vector { msg: "abcdef0123456789", p: "" }
        Vector { msg: "q128_" + text.repeat("q", 128), p: "" }
        Vector { msg: "a512_" + text.repeat("a", 512), p: "" }
    ]
}

fn g2_encode_vectors() -> Vector[] {
    [
        Vector { msg: "", p: "" }
        Vector { msg: "abc", p: "" }
        Vector { msg: "abcdef0123456789", p: "" }
        Vector { msg: "q128_" + text.repeat("q", 128), p: "" }
        Vector { msg: "a512_" + text.repeat("a", 512), p: "" }
