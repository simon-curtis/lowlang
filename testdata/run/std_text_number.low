import std/text
import std/text/number

fn describe(e: number.NumberError) -> str {
    match e {
        Empty => "Empty"
        Malformed(offset) => "Malformed({offset})"
        UnknownUnit(unit) => "UnknownUnit({unit})"
        TooPrecise => "TooPrecise"
        OutOfRange => "OutOfRange"
    }
}

fn float_of(label: str) -> f64 {
    text.parse_float(label) catch { e => 0.0 }
}

fn row(name: str, args: str, result: str) {
    print("{name} {args} -> {result}")
}

fn min_i64() -> i64 {
    -9223372036854775807 - 1
}

fn byte_row(n: i64) {
    row("format_bytes", "{n} | decimal", number.format_bytes(n, false))
    row("format_bytes", "{n} | binary", number.format_bytes(n, true))
}

fn byte_sizes() {
    let sizes = [
        0, 1, 9, 10, 99, 100, 999, 1000, 1001, 1023, 1024, 1025, 1500, 1536, 1949, 1950, 9949, 9950, 9999, 10000, 10188, 10239,
        10240, 99949, 99950, 100000, 102400, 999499, 999500, 999949, 999950, 999999, 1000000, 1048063, 1048064, 1048575,
        1048576, 1572864, 5000000, 1000000000, 1073741823, 1073741824, 1000000000000, 1099511627776, 1000000000000000,
        1125899906842624, 1000000000000000000, 1152921504606846976, 8000000000000000000, 9223372036854775807, -1, -1000, -1500,
        -1048576, -9223372036854775807
    ]
    for n in sizes {
        byte_row(n)
    }
    byte_row(min_i64())
}

fn byte_sweeps() {
    var decimal: i64 = 1
    for i in 0..19 {
        byte_row(decimal)
        byte_row(decimal * 5)
        if i < 18 {
            byte_row(decimal * 9 + decimal / 2)
            decimal = decimal * 10
        }
    }
    for i in 0..63 {
        let power: i64 = 1 << i
        byte_row(power)
        byte_row(power - 1)
        byte_row(power + power / 2)
    }
}

fn parsed_bytes(s: str) -> str {
    let v = number.parse_bytes(s) catch { e => return describe(e) }
    "{v}"
}

fn parse_row(s: str) {
    row("parse_bytes", "[{s}]", parsed_bytes(s))
}

fn parse_bytes_cases() {
    let inputs = [
        "0", "1", "512", "1 kB", "1kB", "1KB", "1 kb", "1 K", "1k", "1.5 kB", "1.5KiB", "1.5 KiB", "1.5 ki", "2 MiB", "2 MB", "3 gib",
        "3 GB", "4 TiB", "4 TB", "5 PB", "5 PiB", "1 e", "1 EB", "1 Kib", "1 KIB", "1 m", "1 g", "1 t", "1 p", "1 b", "1 B", "7 EiB",
        "7.9 EiB", "7.999999 EiB", "8 EiB", "8 EB", "9.2 EB", "9.3 EB", "10 EiB", "0 EiB", "-0 kB", "00012 kB", "-1 kB", "+1 kB",
        "-8 EiB", "-8.1 EiB", "0.5", "0.4999 kB", "0.0005 kB", "0.0004 kB", "1.0001 KiB", "1.9999 KiB", "0.49999 B", "0.5 B", "1.5 B",
        "2.5 B", "  12  MB  ", "\t5\tkB", "12MB ", "1.000000000000000000 B", "1.0000000000000000001 B", "0.123456789012345678 EB",
        "0.000000000000000001 EB", "1.5000000000000000000000 kB", "9223372036854775807", "9223372036854775808",
        "-9223372036854775808", "-9223372036854775809", "-9223372036854775808 B", "9223372036854775807.4",
        "9223372036854775807.5 B", "99999999999999999999", "18446744073709551615", "18446744073709551616", ".5 kB", "5. kB", "kB",
        "", "   ", "-", "+", "12 parsecs", "12 kbb", "12 bytes", "1 x", "1 2", "12.5.3", "1,000", "1_000", "1e3", "1 k B", "1 µB",
        "--1", "1 -1", "1.5.", "0x10"
    ]
    for s in inputs {
        parse_row(s)
    }
}

fn grouped_cases() {
    let values = [
        0, 7, 12, 123, 1234, 12345, 123456, 1234567, -999, -1000, -1234567, 1000000000, 9223372036854775807
    ]
    for n in values {
        row("grouped", "{n} | [,]", number.grouped(n, ","))
    }
    row("grouped", "{min_i64()} | [,]", number.grouped(min_i64(), ","))
    let separators = [".", " ", "'", "", "_", "--"]
    for sep in separators {
        row("grouped", "1234567 | [{sep}]", number.grouped(1234567, sep))
        row("grouped", "-12345 | [{sep}]", number.grouped(-12345, sep))
        row("grouped", "999 | [{sep}]", number.grouped(999, sep))
    }
}

fn ordinal_cases() {
    for n in -3..31 {
        row("ordinal", "{n}", number.ordinal(n))
    }
    for n in 100..126 {
        row("ordinal", "{n}", number.ordinal(n))
    }
    let values = [1000, 1011, 1012, 1013, 1021, 1022, 1023, 1111, 9223372036854775807]
    for n in values {
        row("ordinal", "{n}", number.ordinal(n))
    }
    row("ordinal", "{min_i64()}", number.ordinal(min_i64()))
}

fn percent_cases() {
    let labels = [
        "0", "1", "0.5", "0.12345", "0.125", "0.0005", "-0.25", "2.5", "1e-9", "0.99995", "0.285", "123456.789", "-0.0001", "0.3333333"
    ]
    for label in labels {
        for digits in [0, 1, 2, 3] {
            row("percent", "{label} | {digits}", number.percent(float_of(label), digits))
        }
    }
    row("percent", "0.5 | -2", number.percent(0.5, -2))
    row("percent", "nan | 1", number.percent(float_of("nan"), 1))
    row("percent", "inf | 1", number.percent(float_of("inf"), 1))
    row("percent", "-inf | 1", number.percent(float_of("-inf"), 1))
}

fn percent_of_cases() {
    row("percent_of", "1 | 3 | 2", number.percent_of(1, 3, 2))
    row("percent_of", "1 | 3 | 0", number.percent_of(1, 3, 0))
    row("percent_of", "2 | 3 | 1", number.percent_of(2, 3, 1))
    row("percent_of", "0 | 5 | 1", number.percent_of(0, 5, 1))
    row("percent_of", "5 | 5 | 0", number.percent_of(5, 5, 0))
    row("percent_of", "-1 | 4 | 1", number.percent_of(-1, 4, 1))
    row("percent_of", "3 | 2 | 0", number.percent_of(3, 2, 0))
    row("percent_of", "123456789 | 1000000000 | 4", number.percent_of(123456789, 1000000000, 4))
    row("percent_of", "1 | 8 | 1", number.percent_of(1, 8, 1))
    row("percent_of", "1 | 16 | 1", number.percent_of(1, 16, 1))
    row("percent_of", "1 | 1000 | 0", number.percent_of(1, 1000, 0))
    row("percent_of", "5 | 1000 | 0", number.percent_of(5, 1000, 0))
    row("percent_of", "37 | 120 | 1", number.percent_of(37, 120, 1))
}

fn compact_cases() {
    let values = [
        0, 999, 1000, 1049, 1050, 1500, 9949, 9950, 9999, 10000, 12345, 99949, 99950, 999499, 999500, 1000000, 1234567, 999999999,
        1000000000, 2500000000, 1000000000000, 1500000000000, 1000000000000000, 1000000000000000000, 9223372036854775807, -1, -1500,
        -123456789, -999999
    ]
    for n in values {
        row("compact", "{n}", number.compact(n))
    }
    row("compact", "{min_i64()}", number.compact(min_i64()))
    var power: i64 = 1
    for i in 0..19 {
        row("compact", "{power}", number.compact(power))
        row("compact", "{power * 5}", number.compact(power * 5))
        if i < 18 {
            power = power * 10
        }
    }
}

fn si_cases() {
    let labels = [
        "0", "1", "-1", "123", "999", "999.4", "999.5", "999.95", "1000", "1234.5", "7105000000", "2963.5", "0.5", "0.001", "0.00123",
        "0.000001", "1e-9", "1e-12", "1e-24", "1e-25", "5e-27", "1e24", "1e27", "9.995e26", "1e30", "1.5e30", "123456789",
        "0.000999995", "-4.2e-7", "6.255e-12", "9.055e-06", "99.95", "9.995", "0.9995", "65535", "299792458", "1.245", "1.235"
    ]
    for label in labels {
        row("si", "{label} | [Hz]", number.si(float_of(label), "Hz"))
    }
    row("si", "1500 | []", number.si(1500.0, ""))
    row("si", "0.0025 | []", number.si(0.0025, ""))
    row("si", "42 | []", number.si(42.0, ""))
    row("si", "0 | []", number.si(0.0, ""))
    row("si", "nan | [B]", number.si(float_of("nan"), "B"))
    row("si", "inf | [B]", number.si(float_of("inf"), "B"))
    row("si", "-inf | [B]", number.si(float_of("-inf"), "B"))
    row("si", "-1234567 | [m/s]", number.si(-1234567.0, "m/s"))
    let digit_labels = ["1234.5", "7105000000", "2963.5", "999.95", "0.000999995", "6.255e-12", "1.5", "299792458", "12345.6789"]
    for label in digit_labels {
        for digits in [0, 1, 2, 4, 6, -2] {
            row("si", "{label} | {digits} | [s]", number.si_digits(float_of(label), "s", digits))
        }
    }
}

fn word_cases() {
    for n in -21..131 {
        row("words", "{n}", number.words(n))
    }
    let values = [
        199, 200, 201, 999, 1000, 1001, 1010, 1100, 1999, 2000, 10000, 12345, 100000, 123456, 999999, 1000000, 1000001, 1001001,
        1234567, 1000000000, 2147483648, 1000000000000, 1000000000001, 123456789012, 1000000000000000, 1000000000000000000,
        9223372036854775807, -1000, -1000000, -9223372036854775807
    ]
    for n in values {
        row("words", "{n}", number.words(n))
    }
    row("words", "{min_i64()}", number.words(min_i64()))
}

fn roman_text(n: i64) -> str {
    number.roman(n) catch { e => describe(e) }
}

fn parsed_roman(s: str) -> str {
    let v = number.parse_roman(s) catch { e => return describe(e) }
    "{v}"
}

fn roman_cases() {
    for n in -1..21 {
        row("roman", "{n}", roman_text(n))
    }
    let values = [
        24, 39, 40, 49, 90, 99, 400, 444, 499, 900, 949, 1994, 2024, 3888, 3999, 4000, 4001, 9223372036854775807
    ]
    for n in values {
        row("roman", "{n}", roman_text(n))
    }
    row("roman", "{min_i64()}", roman_text(min_i64()))
    var n = 1
    for n < 3999 {
        let numeral = roman_text(n)
        row("roman", "{n}", numeral)
        row("parse_roman", "[{numeral}]", parsed_roman(numeral))
        n += 97
    }
}

fn parse_roman_cases() {
    let inputs = [
        "I", "iv", "XLII", "mcmxciv", "MmXxIv", "MMMCMXCIX", "MMMDCCCLXXXVIII", "IIII", "VX", "IC", "MMMM", "MMMMM", "ABC", "XIZ", "",
        "IIX", "VV", "XXXX", "LXL", "CMC", "MCMC", " X", "X ", "IXI", "XIIII", "IL", "XM", "VIV", "DD", "CCCC", "IIV", "MDCCCCX"
    ]
    for s in inputs {
        row("parse_roman", "[{s}]", parsed_roman(s))
    }
}

fn main() {
    byte_sizes()
    byte_sweeps()
    parse_bytes_cases()
    grouped_cases()
    ordinal_cases()
    percent_cases()
    percent_of_cases()
    compact_cases()
    si_cases()
    word_cases()
    roman_cases()
    parse_roman_cases()
}
