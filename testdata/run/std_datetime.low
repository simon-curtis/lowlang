    let combos = [
        3, 1, 4, 1, 4, 3, 4, 6, 4, 12, 5, 1,
        5, 15, 5, 30, 6, 1, 6, 30, 7, 1, 7, 500,
        8, 1, 8, 500, 9, 1, 9, 500
    ]
    var i = 0
    for i + 6 < times.len {
        let dt = dtm(times, i)
        var lines: []str = []
        var k = 0
        for k + 1 < combos.len {
            for m in all_modes() {
                push(mut lines, "round {show(dt)} {unit_label(combos[k])} {combos[k + 1]} {mode_name(m)} {round_text(dt, combos[k], combos[k + 1], m)}")
            }
            k += 2
        }
        for u in 0..10 {
            push(mut lines, "truncate {show(dt)} {unit_label(u)} {truncate_text(dt, u)}")
        }
        show_group("round {show(dt)}", lines)
        i += 7
    }
    print("-- round errors")
    let bad = [
        3, 2, 3, 0, 3, -1, 2, 1, 1, 1, 0, 1,
        0, 0, 4, 24, 4, 0, 4, 5, 5, 60, 5, 7,
        6, 45, 7, 3, 7, 1000, 8, 7, 9, 1000, 9, 3,
        4, 25, 4, -2
    ]
    let dt = dtm([
        2026, 11, 11, 10, 15, 30, 500000000
    ], 0)
    var k = 0
    for k + 1 < bad.len {
        print("round_bad {unit_label(bad[k])} {bad[k + 1]} {round_text(dt, bad[k], bad[k + 1], rounding.Rounding.HalfExpand)}")
        k += 2
    }
}

struct Random {
    state: i64
}

fn next_value(mut r: Random) -> i64 {
    r.state = (r.state * 1103515245 + 12345) % 2147483648
    r.state
}

fn next_datetime(mut r: Random) -> datetime.DateTime {
    let days = next_value(mut r) % 7304484 + date.epoch_days(date.earliest())
    let high = next_value(mut r)
    let low = next_value(mut r)
    let nanos = (high * 2147483648 + low) % 86400000000000
    let d = date.from_epoch_days(days) or date.epoch()
    let t = timeofday.from_nanos_of_day(nanos) or timeofday.midnight()
    datetime.from_parts(d, t)
}

fn property() {
    print("-- property")
    var r = Random { state: 20261111 }
    var total = 0
    var roundtrips = 0
    var civil_ok = 0
    var exact_ok = 0
    var calendar_total = 0
    var calendar_ok = 0
    var years = 0
    var months = 0
    var weeks = 0
    var days = 0
    var hours = 0
    for _ in 0..400 {
        let a = next_datetime(mut r)
        let b = next_datetime(mut r)
        total += 1
        let parsed = datetime.parse(show(a)) or datetime.epoch()
        if datetime.equal(parsed, a) {
            roundtrips += 1
        }
        let rebuilt = datetime.from_civil_seconds(datetime.civil_seconds(a), datetime.nanosecond(a)) or datetime.epoch()
        if datetime.equal(rebuilt, a) {
            civil_ok += 1
        }
        let gap = datetime.duration_until(a, b)
        let moved = datetime.plus_duration(a, gap) or datetime.epoch()
        if datetime.equal(moved, b) {
            exact_ok += 1
        }
        for largest in [0, 1, 2, 3] {
            let s = datetime.until(a, b, diff_of(largest, 9, 1, rounding.Rounding.Trunc)) or continue
            let back = datetime.plus(a, s) or datetime.epoch()
            calendar_total += 1
            if datetime.equal(back, b) {
                calendar_ok += 1
            }
            years += span.year_count(s)
            months += span.month_count(s)
            weeks += span.week_count(s)
            days += span.day_count(s)
            hours += span.hour_count(s)
        }
    }
    print("property total {total} roundtrips {roundtrips} civil {civil_ok} exact {exact_ok} calendar {calendar_total} {calendar_ok} years {years} months {months} weeks {weeks} days {days} hours {hours}")
}

fn parsed(s: str) -> str {
    let r = datetime.parse(s) catch {
        e => return "{s} -> {describe(e)}"
    }
    "{s} -> {show(r)}"
}

