        0, 6, 1, 0, 1, 3, 1, 1, 5, 0, 0, 2,
        3, 3, 7, 3, 3, 30, 2, 2, 2
    ]
    i = 0
    for i + 13 < mode_pairs.len {
        let a = dtm(mode_pairs, i)
        let b = dtm(mode_pairs, i + 7)
        var modes: []str = []
        var k = 0
        for k + 2 < mode_combos.len {
            for m in all_modes() {
                let d = diff_of(mode_combos[k], mode_combos[k + 1], mode_combos[k + 2], m)
                push(mut modes, "mode {show(a)} {show(b)} {mode_combos[k]} {mode_combos[k + 1]} {mode_combos[k + 2]} {mode_name(m)} {until_text(a, b, d)}")
