        "2026-11-111T10:00", "2026-11-11-T10:00",
        "T10:00", "2026T10:00",
        "-0000-01-01T10:00", "",
        "2026-11-11", "20261111",
        "2026-11-11x10:00", "T10:00",
        "2026-11-11TT10:00", "2026-11-11tT10:00",
        "2026-11-11 T10:00", "2026-11-11T",
        "2026-11-11 ", "2026-11-11  10:00",
        "2026-11-11 10:00 ", "2026-11-11T10:00Z",
        "2026-11-11T10:00:00+01:00", "2026-11-11T10:00:00Z",
        "2026-11-11T24:00", "2026-11-11T12:60",
        "2026-11-11T12:34:61", "2026-11-11T25",
        "2021-W53-1T10:00", "2026-11-11T10:",
        "2026-11-11T1", "2026-11-11T10:00:00.",
        "2026-11-11T10:00:00.1234567890", "2026-11-11T10:00:00.5x",
        "2026-11-11T1000x", "-9999-01-01T00:00:00.9999999999",
        "2026-11-11/10:00", "2026-11-11T10:00:00 +01:00",
        "2026-11-11TZ", "2026-11-11T-10:00"
    ]
    for s in invalid {
        print("parse {parsed(s)}")
    }
}

fn ordering() {
    print("-- compare")
    let all = [
        -9999, 1, 1, 0, 0, 0, 0, 0, 2, 29, 12, 0, 0, 0,
        2026, 11, 11, 0, 0, 0, 0, 2026, 11, 11, 0, 0, 0, 1,
        2026, 11, 11, 23, 59, 59, 999999999, 2026, 11, 12, 0, 0, 0, 0,
        9999, 12, 31, 23, 59, 59, 999999999
    ]
    var i = 0
    var ds: []datetime.DateTime = []
    for i + 6 < all.len {
        push(mut ds, dtm(all, i))
        i += 7
    }
    for a in ds {
        var row = ""
        for b in ds {
            row = "{row}{datetime.compare(a, b)} "
        }
        print("compare {show(a)} {row}")
    }
    for a in ds {
        for b in ds {
            print("order {show(a)} {show(b)} {datetime.equal(a, b)} {datetime.before(a, b)} {datetime.after(a, b)} {show(datetime.min(a, b))} {show(datetime.max(a, b))} {a == b}")
        }
    }
}

fn main() {
    constructors()
    arithmetic()
    untils()
    rounding_section()
    property()
    parsing()
    ordering()
}
