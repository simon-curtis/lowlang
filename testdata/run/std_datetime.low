    ], 0)
    let b = dtm([
        2026, 1, 31, 10, 0, 0, 0, 2026, 11, 11, 15, 30, 0, 0
    ], 7)
    var k = 0
    for k + 2 < bad.len {
        let d = diff_of(bad[k], bad[k + 1], bad[k + 2], rounding.Rounding.Trunc)
        print("until_bad {bad[k]} {bad[k + 1]} {bad[k + 2]} {until_text(a, b, d)}")
        k += 3
    }
    let wide = [
        -9999, 1, 1, 0, 0, 0, 0, 9999, 12, 31, 23, 59, 59, 999999999
    ]
    let low = dtm(wide, 0)
    let high = dtm(wide, 7)
    for u in 0..10 {
        let d = diff_of(u, 9, 1, rounding.Rounding.Trunc)
        let e = diff_of(u, u, 1, rounding.Rounding.Trunc)
        print("until_wide {unit_label(u)} ns {until_text(low, high, d)} | {until_text(high, low, d)} own {until_text(low, high, e)} | {until_text(high, low, e)}")
    }
}

fn round_text(dt: datetime.DateTime, unit: i64, inc: i64, m: rounding.Rounding) -> str {
    let r = datetime.round(dt, span.unit_of(unit), inc, m) catch {
        e => return describe(e)
    }
    show(r)
}

fn truncate_text(dt: datetime.DateTime, unit: i64) -> str {
    let r = datetime.truncate(dt, span.unit_of(unit)) catch {
        e => return describe(e)
    }
    show(r)
}

