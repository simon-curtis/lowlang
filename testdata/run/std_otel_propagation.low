import std/http
import std/otel

fn show(label: str, value: str) {
    match otel.parse_traceparent(value) {
        some(sc) => print("{label}: ok {otel.trace_id_hex(sc)} {otel.span_id_hex(sc)} sampled={otel.sampled(sc)} remote={sc.remote} -> {otel.format_traceparent(sc)}")
        none => print("{label}: invalid")
    }
}

fn traceparents() {
    show("valid sampled", "00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01")
    show("valid unsampled", "00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-00")
    show("other flags", "00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-09")
    show("surrounding space", "  00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01 ")
    show("future version", "cc-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01-what-the-future-will-be-like")
    show("future version no dash", "cc-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01x")
    show("version ff", "ff-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01")
    show("version 00 too long", "00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01-extra")
    show("uppercase", "00-4BF92F3577B34DA6A3CE929D0E0E4736-00F067AA0BA902B7-01")
    show("zero trace", "00-00000000000000000000000000000000-00f067aa0ba902b7-01")
    show("zero span", "00-4bf92f3577b34da6a3ce929d0e0e4736-0000000000000000-01")
    show("short", "00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7")
    show("bad separator", "00_4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01")
    show("non hex", "00-4bf92f3577b34da6a3ce929d0e0e473g-00f067aa0ba902b7-01")
    show("empty", "")
}

fn state(label: str, value: str) {
    print("{label}: {otel.normalize_tracestate(value) ?? "rejected"}")
}

fn tracestates() {
    state("simple", "rojo=00f067aa0ba902b7,congo=t61rcWkgMzE")
    state("spaces and empties", " rojo=1 ,, congo=2 ")
    state("tenant", "tenant@system=v,a-b_c*d/e=x")
    state("uppercase key", "Rojo=1")
    state("duplicate", "a=1,a=2")
    state("missing value", "a=")
    state("equals in value", "a=b=c")
    state("trailing space value", "a=b ,c=d")
    var many: []str = []
    for i in 0..33 {
        push(mut many, "k{i}=v")
    }
    var joined = many[0]
    for i in 1..many.len {
        joined = "{joined},{many[i]}"
    }
    state("33 members", joined)
}

fn baggages() {
    let entries = otel.parse_baggage("userId=alice, serverNode = DF%2028 ;prop=1, bad key=x, isProduction=false,empty=,userId=bob")
    for e in entries {
        print("baggage {e.key}=[{e.value}] metadata=[{e.metadata}]")
    }
    print("format {otel.format_baggage([otel.Entry { key: "k", value: "a b,c;d%é", metadata: "" }, otel.Entry { key: "m", value: "v", metadata: "p=1" }, otel.Entry { key: "bad key", value: "x", metadata: "" }])}")
    let back = otel.parse_baggage(otel.format_baggage([otel.Entry { key: "k", value: "a b,c;d%é", metadata: "" }]))
    print("round trip [{back[0].value}]")
    print("bad percent {otel.parse_baggage("a=%zz,b=ok").len}")
}

fn headers() {
    let incoming = [
        http.Header { name: "TraceParent", value: "00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01" },
        http.Header { name: "tracestate", value: "rojo=1" },
        http.Header { name: "tracestate", value: "congo=2" },
        http.Header { name: "baggage", value: "user=ada,team=core" },
    ]
    let c = otel.extract(incoming)
    let sc = c.span.context
    print("extracted {otel.trace_id_hex(sc)} {otel.span_id_hex(sc)} remote={sc.remote} state={sc.state} user={c.baggage_value("user") ?? "-"}")
    var out: []http.Header = [http.Header { name: "traceparent", value: "stale" }]
    otel.inject(c.set_baggage("team", "platform"), mut out)
    for h in out {
        print("inject {h.name}: {h.value}")
    }
    let invalid = otel.extract([http.Header { name: "traceparent", value: "garbage" }, http.Header { name: "tracestate", value: "a=1" }])
    print("invalid parent valid={otel.valid(invalid.span.context)} state=[{invalid.span.context.state}]")
    let scoped = otel.in_context(c, fn() -> str { otel.span_id_hex(otel.current_span().context) })
    print("in context span {scoped} restored {otel.valid(otel.current_span().context)}")
    var none_out: []http.Header = []
    otel.inject(otel.current(), mut none_out)
    print("inject with nothing {none_out.len}")
    using restricted = otel.install(otel.Config { propagators: otel.Propagators { baggage: false } })
    let only_trace = otel.extract(incoming)
    print("baggage disabled entries {only_trace.baggage.len} trace valid {otel.valid(only_trace.span.context)}")
    restricted.shutdown()
}

fn main() {
    traceparents()
    tracestates()
    baggages()
    headers()
}
