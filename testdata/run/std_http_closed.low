import std/file
import std/http
import std/http/websocket
import std/io
import std/net
import std/text

fn handle(req: http.Request) -> http.Response {
    if req.path == "/ws" {
        using ws = websocket.accept(req) or return http.response(400, "")
        for {
            let m = websocket.receive(ws) or break
            websocket.send_text(ws, "echo: {str(m.data)}") or break
        }
        return http.upgraded()
    }
    http.response(200, "hello")
}

fn serve(l: net.ListenerHandle) {
    http.serve_on(l, handle) or {}
}

fn truncated(l: net.ListenerHandle) {
    let h = net.accept_handle(l) or return
    using c = net.adopt(h)
    let r = io.reader(net.stream(c))
    http.read_request(r) or return
    net.write_all(c, bytes("HTTP/1.1 200 OK\r\ncontent-length: 100\r\n\r\nshort")) or {}
}

fn outcome(r: fn() ! io.Error) -> str {
    r() catch {
        NotConnected => return "NotConnected"
        Eof => return "Eof"
        _ => return "other error"
    }
    "ok"
}

fn websockets(url: str) ! io.Error {
    using ws = websocket.dial(url)?
    let view = ws.handle
    websocket.send_text(ws, "one")?
    let first = websocket.receive(ws)?
    print(str(first.data))
    websocket.close(ws, 1000)?
    print("send after close: {outcome(fn() ! io.Error { websocket.send_text_on(view, "two")? })}")
    print("binary after close: {outcome(fn() ! io.Error { websocket.send_binary_on(view, [1])? })}")
    print("ping after close: {outcome(fn() ! io.Error { websocket.ping_on(view, [])? })}")
    print("receive after close: {outcome(fn() ! io.Error { websocket.receive_on(view)? })}")
    print("second close: {outcome(fn() ! io.Error { websocket.close_on(view, 1000)? })}")
}

fn dropped(url: str) ! io.Error {
    for i in 0..5 {
        using ws = websocket.dial(url)?
        websocket.send_text(ws, "n{i}")?
        let m = websocket.receive(ws)?
        print(str(m.data))
    }
}

fn connection(u: http.Url) ! io.Error {
    using c = http.connect(u, [])?
    let s = c.stream
    io.write_str(s, "GET /plain HTTP/1.1\r\nhost: x\r\nconnection: close\r\n\r\n")?
    let status = io.read_line(io.reader(s))?
    print(status)
    s.close()
    let buf = io.buffer(8)
    print("read after close: {outcome(fn() ! io.Error { s.read(buf)? })}")
    print("write after close: {outcome(fn() ! io.Error { s.write(buf)? })}")
}

fn handed_over(u: http.Url) -> io.Stream ! io.Error {
    using var c = http.connect(u, [])?
    http.detach(mut c)
}

fn detached(u: http.Url) ! io.Error {
    let s = handed_over(u)?
    io.write_str(s, "GET /plain HTTP/1.1\r\nhost: x\r\nconnection: close\r\n\r\n")?
    print("detached {io.read_line(io.reader(s))?}")
    s.close()
}

fn failing_download(url: str, path: str) {
    let c = http.client().with_version(Http1).build()
    let r = c.request("GET", url).download(path) or {
        print("download failed, partial file kept: {file.exists(path)}")
        return
    }
    print("download {r.status}")
}

fn main() ! io.Error {
    using l = net.listen("127.0.0.1", 0)?
    using cut = net.listen("127.0.0.1", 0)?
    spawn serve(l.handle)
    spawn truncated(cut.handle)
    let port = l.handle.addr.port
    websockets("ws://127.0.0.1:{port}/ws")?
    dropped("ws://127.0.0.1:{port}/ws")?
    let u = http.parse_url("http://127.0.0.1:{port}/plain")?
    connection(u)?
    detached(u)?
    failing_download("http://127.0.0.1:{cut.handle.addr.port}/", "/tmp/std_http_closed_download.bin")
}
