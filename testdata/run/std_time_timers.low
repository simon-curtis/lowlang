import std/time
import std/time/duration

fn clocks() {
    let secs = time.now()
    let millis = time.now_millis()
    let nanos = time.now_nanos()
    print("unix seconds plausible {secs > 1700000000 && secs < 4000000000}")
    print("millis agree {millis / 1000 - secs <= 1 && millis / 1000 - secs >= 0}")
    print("nanos agree {nanos / 1000000 - millis <= 1000 && nanos / 1000000 - millis >= 0}")
    let first = time.monotonic()
    let second = time.monotonic()
    print("monotonic {first > 0 && second >= first}")
}

fn sleeping() {
    let started = time.monotonic()
    time.sleep_for(duration.milliseconds(20))
    let waited = duration.nanoseconds(time.monotonic() - started)
    print("slept {duration.whole_millis(waited) >= 1}")
    time.sleep_for(duration.nanoseconds(1))
    time.sleep_for(duration.zero())
    time.sleep_for(duration.seconds(-1))
    print("short sleeps done")
}

fn stopwatches() {
    let watch = time.start()
    time.sleep_for(duration.milliseconds(10))
    let first = watch.elapsed()
    time.sleep_for(duration.milliseconds(10))
    let second = watch.elapsed()
    let grew = duration.compare(second, first) >= 0
    let long_enough = duration.after(second, duration.milliseconds(5))
    print("stopwatch {duration.after(first, duration.zero())} {grew} {long_enough}")
}

fn timers() {
    let t = time.timer(duration.milliseconds(5))
    let fired = select {
        <-t.fired => true
        after(5000) => false
    }
    print("timer fired {fired}")

    let waited = select {
        <-time.after(duration.milliseconds(5)) => "after"
        after(5000) => "late"
    }
    print("after {waited}")

    let stopped = time.timer(duration.seconds(30))
    print("stop {time.stop_timer(stopped)} {time.stop_timer(stopped)}")
    let quiet = select {
        <-stopped.fired => "fired"
        after(30) => "quiet"
    }
    print("stopped timer {quiet}")

    let slow = time.timer(duration.seconds(30))
    time.reset_timer(slow, duration.milliseconds(5))
    let reset = select {
        <-slow.fired => "fired"
        after(5000) => "late"
    }
    print("reset timer {reset}")

    let expired = time.timer(duration.milliseconds(1))
    let landed = select {
        <-expired.fired => true
        after(5000) => false
    }
    print("expired {landed} stop after firing {time.stop_timer(expired)}")

    let immediate = time.timer(duration.zero())
    let now_fired = select {
        <-immediate.fired => true
        after(5000) => false
    }
    print("zero timer {now_fired}")

    let past = time.timer(duration.seconds(-5))
    let past_fired = select {
        <-past.fired => true
        after(5000) => false
    }
    print("negative timer {past_fired}")

    let again = time.timer(duration.milliseconds(1))
    time.sleep_for(duration.milliseconds(30))
    time.reset_timer(again, duration.milliseconds(5))
    let rearmed = select {
        <-again.fired => "fired"
        after(5000) => "late"
    }
    print("reset after firing {rearmed}")
}

fn tickers() {
    let tk = time.ticker(duration.milliseconds(5))
    var count = 0
    for count < 5 {
        let tick = select {
            <-tk.ticks => true
            after(5000) => false
        }
        if !tick {
            break
        }
        count += 1
    }
    time.stop_ticker(tk)
    print("ticks {count}")
    time.sleep_for(duration.milliseconds(30))
    var drained = 0
    for {
        let more = select {
            <-tk.ticks => true
            else => false
        }
        if !more {
            break
        }
        drained += 1
    }
    let after_stop = select {
        <-tk.ticks => "tick"
        after(50) => "silent"
    }
    print("drained at most one {drained <= 1} after stop {after_stop}")

    let fast = time.ticker(duration.nanoseconds(1))
    let clamped = select {
        <-fast.ticks => true
        after(5000) => false
    }
    time.stop_ticker(fast)
    print("tiny period ticks {clamped}")
}

fn main() {
    clocks()
    sleeping()
    stopwatches()
    timers()
    tickers()
}
