struct Tally {
    hits: i64
}

fn bump(mut n: i64) {
    n += 1
}

fn run(work: fn()) {
    work()
}

fn main() {
    var total = 0
    var xs: i64[] = [1, 2]
    var counts: [str: i64] = ["a": 1]
    var tally = Tally { hits: 0 }
    let cell = new(Tally { hits: 0 })
    spawn fn() {
        total = 5
        bump(mut total)
        xs.push(3)
        print(xs.pop() ?? 0)
        xs.truncate(1)
        xs[0] = 9
        counts.delete("a")
        counts["b"] = 2
        tally.hits = 1
        cell.hits = 1
        let inner = fn() {
            total = 6
        }
        inner()
    }()
    spawn run(fn() {
        total = 7
    })
    print(total + xs.len + counts.len + tally.hits + cell.hits)
}
