import std/text

fn main() {
    let width = 4
    let count = undefined_total() + width + text.count("a b", " ")
    let doubled = count * 2
    let half = {
        let base = count / 2
        base + doubled
    }
    for i in 0..half {
        print(i + count)
    }
    print("{doubled} {half}")
}
