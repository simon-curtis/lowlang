enum Bad {
    Odd
}

enum Other {
    Missing
}

fn half(n: i64) -> i64 ! Bad {
    if n % 2 == 1 {
        fail Odd
    }
    n / 2
}

fn find(n: i64) -> i64 ! Other {
    if n == 0 {
        fail Missing
    }
    n
}

fn no_error_type() -> i64 {
    let a, b = fork { half(2)?, 3 }
    a + b
}

fn unhandled() -> i64 {
    let a, b = fork { half(2), 3 }
    a + b
}

fn other_type() -> i64 ! Other {
    let a, b = fork { find(2)?, half(2)? }
    a + b
}

fn two_types() -> i64 ! Bad {
    let a, b = fork { half(2)? + find(2)?, 3 }
    a + b
}

fn main() {
    print(no_error_type() + unhandled())
    print(other_type() catch { Missing => 0 })
    print(two_types() catch { Odd => 0 })
}
