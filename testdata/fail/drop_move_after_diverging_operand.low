struct File {
    fd: i64
    drop print(fd)
}

enum OpenError {
    Missing
}

fn lookup() -> str? {
    "x"
}

fn open() -> File ! OpenError {
    let name = lookup() ?? fail OpenError.Missing
    using a = File { fd: 1 }
    using b = a
    a
}

fn main() {
    using f = open() or return
    print(f.fd)
}
