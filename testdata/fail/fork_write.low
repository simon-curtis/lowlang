fn fill(mut xs: i64[]) -> i64 {
    xs.push(1)
    xs.len
}

fn main() {
    var total = 0
    var xs: i64[] = [1, 2]
    let cell = new(7)
    let a, b, c, d = fork {
        {
            total = 5
            1
        }
        fill(mut xs)
        {
            xs[0] = 9
            *cell = 8
            2
        }
        {
            let inner = fn() {
                total += 1
            }
            inner()
            3
        }
    }
    print(a + b + c + d + total + *cell)
}
