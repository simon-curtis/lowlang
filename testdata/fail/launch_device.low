struct Pair {
    low: f32
    high: f32
}

kernel fn clamp(id: u32, range: Pair, mut y: f32[]) {
    if y[id] < range.low {
        y[id] = range.low
    }
    if y[id] > range.high {
        y[id] = range.high
    }
}

fn main() {
    var y: f32[] = [1.0]
    clamp(0, Pair { low: 0.0, high: 0.5 }, mut y)
    let job = launch(clamp, 1, Pair { low: 0.0, high: 0.5 }, mut y)
    print(job.count)
}
