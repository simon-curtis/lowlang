enum Bad {
    Odd
}

fn pick(n: i64) -> i64 {
    let a, b = fork {
        if n > 0 {
            return 1
        } else {
            2
        }
        3
    }
    a + b
}

fn scan(xs: i64[]) -> i64 {
    var total = 0
    for x in xs {
        let a, b = fork {
            {
                if x > 1 {
                    break
                }
                x
            }
            3
        }
        total += a + b
    }
    total
}

fn check(n: i64) -> i64 ! Bad {
    let a, b = fork {
        half(n) catch widen
        3
    }
    a + b
}

fn half(n: i64) -> i64 ! Bad {
    if n % 2 == 1 {
        fail Odd
    }
    n / 2
}

fn widen(e: Bad) -> Bad {
    e
}

fn main() {
    print(pick(1))
    print(scan([1, 2]))
    print(check(1) catch { Odd => 0 })
}
