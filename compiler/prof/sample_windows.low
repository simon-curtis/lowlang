import compiler
import std/io
import std/process
import std/time

extern "kernel32" {
    fn OpenProcess(access: u32, inherit: i32, pid: u32) -> i64
    fn OpenThread(access: u32, inherit: i32, tid: u32) -> i64
    fn CloseHandle(handle: i64) -> i32
    fn SuspendThread(thread: i64) -> u32
    fn ResumeThread(thread: i64) -> u32
    fn GetThreadContext(thread: i64, context: i64) -> i32
    fn QueryProcessCycleTime(process: i64, mut cycles: u64) -> i32
    fn ReadProcessMemory(process: i64, address: i64, buffer: ptr, size: i64, done: i64) -> i32
    fn K32EnumProcessModules(process: i64, mut module: i64, size: u32, mut needed: u32) -> i32
    fn VirtualAlloc(address: ptr, size: i64, kind: u32, protect: u32) -> ptr[u8]
    fn VirtualFree(address: ptr, size: i64, kind: u32) -> i32
    fn WaitForSingleObject(handle: i64, milliseconds: u32) -> u32
    fn Sleep(milliseconds: u32)
}

extern "ntdll" {
    fn NtQuerySystemInformation(class: u32, buffer: ptr, length: u32, mut returned: u32) -> i32
}

extern "winmm" {
    fn timeBeginPeriod(period: u32) -> u32
    fn timeEndPeriod(period: u32) -> u32
}

const process_access: u32 = 0x100410
const thread_access: u32 = 0x4A
const suspend_failed: u32 = 0xFFFFFFFF
const wait_signalled: u32 = 0
const context_size = 1232
const frame_offset = 2048
const page_size = 8192
const commit_reserve: u32 = 0x3000
const read_write: u32 = 4
const release: u32 = 0x8000
const context_flags = 0x100003
const flags_offset = 0x30
const rsp_offset = 0x98
const rbp_offset = 0xA0
const rip_offset = 0xF8
const scan_bytes = 4096
const scan_block = 512
const stack_reach = 0x100000
const process_information: u32 = 5
const length_mismatch: i32 = -1073741820
const process_entry_size = 0x100
const process_id_offset = 0x50
const thread_entry_size = 0x50
const thread_id_offset = 0x30
const thread_state_offset = 0x44
const thread_running = 2
const first_query_size = 0x200000

struct Sampler {
    process: i64
    pid: i64
    base: i64
    code: Span
    depth: i64
    memory: ptr[u8]
    context: []u8
    frame: []u8
    readable: i64
    query: ptr[u8]
    query_size: i64
    running: []i64
    threads: [i64: i64]
    stacks: []Stack
}

struct Stack {
    weight: i64
    frames: []i64
}

struct Walk {
    stacks: []Stack
    cycles: i64
    threads: i64
}

pub const needs_map = true

fn capture(config: Config) -> Recording ! Error {
    if config.event != "cycles" {
        fail Failed("a Windows program is sampled by cycles only")
    }
    let program = process.find(config.command[0]) ?? config.command[0]
    let image = read_image(program)?
    let symbols = load_symbols(config.map, image)?
    let c = process.command(program, config.command[1..])
    let handle = process.start_handle(c) catch {
        e => fail Failed("{c.program}: {compiler.reason(e)}")
    }
    using child = process.adopt(handle)
    let walk = record(handle.pid, config.interval_ms, config.depth, image.code)?
    let exit = process.wait(child) catch {
        e => fail Failed("{c.program}: {compiler.reason(e)}")
    }
    if !process.success(exit) {
        let note = config.note
        note("{c.program} failed; the profile covers the run up to its exit")
    }
    var samples: []Sample = []
    for stack in walk.stacks {
        var frames: []str = []
        for rva in stack.frames {
            frames.push(name_at(symbols, rva))
        }
        samples.push(Sample { weight: stack.weight, frames })
    }
    let unit = Unit { name: "cycles", suffix: "G", scale: 1000000000.0 }
    let fact = "process cycles {amount(unit, walk.cycles)} G, {samples.len} on-CPU samples over {walk.threads} threads"
    Recording { samples, unit, facts: [fact] }
}

fn record(pid: i64, interval_ms: i64, depth: i64, code: Span) -> Walk ! Error {
    let process = OpenProcess(process_access, 0, u32(pid))
    if process == 0 {
        fail Failed("cannot open process {pid}")
    }
    let memory = VirtualAlloc(null, page_size, commit_reserve, read_write)
    if memory == null {
        let _ = CloseHandle(process)
        fail Failed("cannot allocate the thread context")
    }
    let frame_at: ptr[u8] = ptr(i64(memory) + frame_offset)
    let s = new(Sampler { process, pid, base: 0, code, depth, memory, context: view(memory, context_size), frame: view(frame_at, scan_bytes), readable: 0, query: null, query_size: 0, running: [], threads: [:], stacks: [] })
    let _ = timeBeginPeriod(1)
    var last = time.monotonic()
    for {
        if s.base == 0 {
            s.base = module_base(process)
        }
        let now = time.monotonic()
        if s.find_running() && s.base != 0 {
            s.sample_running(now - last)
        }
        last = now
        if WaitForSingleObject(process, 0) == wait_signalled {
            break
        }
        Sleep(u32(interval_ms))
    }
    let _ = timeEndPeriod(1)
    var total: u64 = 0
    let _ = QueryProcessCycleTime(process, mut total)
    for _, handle in s.threads {
        CloseHandle(handle)
    }
    let _ = CloseHandle(process)
    let _ = VirtualFree(memory, 0, release)
    if s.query != null {
        VirtualFree(s.query, 0, release)
    }
    s.to_cycles(i64(total))
    Walk { stacks: s.stacks, cycles: i64(total), threads: s.threads.len }
}

fn to_cycles(s: *Sampler, total: i64) {
    var observed = 0
    for stack in s.stacks {
        observed += stack.weight
    }
    if observed == 0 {
        return
    }
    let scale = f64(total) / f64(observed)
    for i in 0..s.stacks.len {
        s.stacks[i].weight = i64(f64(s.stacks[i].weight) * scale)
    }
}

fn module_base(process: i64) -> i64 {
    var module = 0
    var needed: u32 = 0
    if K32EnumProcessModules(process, mut module, 8, mut needed) == 0 {
        return 0
    }
    module
}

fn query_processes(s: *Sampler) -> []u8 {
    for {
        if s.query == null {
            let size = if s.query_size == 0 { first_query_size } else { s.query_size }
            s.query = VirtualAlloc(null, size, commit_reserve, read_write)
            if s.query == null {
                return []
            }
            s.query_size = size
        }
        var returned: u32 = 0
        let status = NtQuerySystemInformation(process_information, s.query, u32(s.query_size), mut returned)
        if status == 0 {
            return view(s.query, i64(returned))
        }
        if status != length_mismatch {
            return []
        }
        let _ = VirtualFree(s.query, 0, release)
        s.query = null
        s.query_size = (i64(returned) + first_query_size) * 2
    }
}

fn find_running(s: *Sampler) -> bool {
    s.running = []
    let table = s.query_processes()
    var at = 0
    for at + process_entry_size <= table.len {
        if io.le64(table, at + process_id_offset) == s.pid {
            s.read_threads(table, at)
            return true
        }
        let next = io.le32(table, at)
        if next == 0 {
            break
        }
        at += next
    }
    false
}

fn read_threads(s: *Sampler, table: []u8, entry: i64) {
    let count = io.le32(table, entry + 4)
    for i in 0..count {
        let at = entry + process_entry_size + i * thread_entry_size
        if at + thread_entry_size > table.len {
            return
        }
        let id = io.le64(table, at + thread_id_offset)
        s.track(id)
        if io.le32(table, at + thread_state_offset) == thread_running {
            s.running.push(id)
        }
    }
}

fn track(s: *Sampler, id: i64) {
    if s.threads[id] != none {
        return
    }
    let handle = OpenThread(thread_access, 0, u32(id))
    if handle != 0 {
        s.threads[id] = handle
    }
}

fn sample_running(s: *Sampler, weight: i64) {
    for id in s.running {
        let handle = s.threads[id] ?? 0
        if handle != 0 {
            s.sample_thread(handle, weight)
        }
    }
}

fn sample_thread(s: *Sampler, handle: i64, weight: i64) {
    if SuspendThread(handle) == suspend_failed {
        return
    }
    let frames = s.walk_thread(handle)
    let _ = ResumeThread(handle)
    if frames.len > 0 {
        s.stacks.push(Stack { weight, frames })
    }
}

struct Found {
    at: i64
    ret: i64
}

fn walk_thread(s: *Sampler, thread: i64) -> []i64 {
    io.set_le32(s.context, flags_offset, context_flags)
    if GetThreadContext(thread, i64(s.memory)) == 0 {
        return []
    }
    let rip = io.le64(s.context, rip_offset)
    var rbp = io.le64(s.context, rbp_offset)
    let rsp = io.le64(s.context, rsp_offset)
    var frames: []i64 = [rip - s.base]
    if !s.in_code(rip) {
        let found = s.scan(rsp)
        if found.ret == 0 {
            return frames
        }
        frames.push(found.ret - 1 - s.base)
        rbp = s.frame_above(rsp, found.at)
    }
    for frames.len <= s.depth {
        if rbp < rsp || rbp % 8 != 0 {
            break
        }
        if ReadProcessMemory(s.process, rbp, ptr(i64(s.memory) + frame_offset), 16, 0) == 0 {
            break
        }
        let next = io.le64(s.frame, 0)
        let ret = io.le64(s.frame, 8)
        if !s.in_code(ret) {
            break
        }
        frames.push(ret - 1 - s.base)
        if next <= rbp {
            break
        }
        rbp = next
    }
    frames
}

fn in_code(s: *Sampler, address: i64) -> bool {
    let rva = address - s.base
    rva >= s.code.start && rva < s.code.end
}

fn read_stack(s: *Sampler, rsp: i64) {
    s.readable = 0
    for s.readable < scan_bytes {
        let into = ptr(i64(s.memory) + frame_offset + s.readable)
        if ReadProcessMemory(s.process, rsp + s.readable, into, scan_block, 0) == 0 {
            return
        }
        s.readable += scan_block
    }
}

fn scan(s: *Sampler, rsp: i64) -> Found {
    s.read_stack(rsp)
    var at = 0
    for at < s.readable {
        let word = io.le64(s.frame, at)
        if s.in_code(word) {
            return Found { at, ret: word }
        }
        at += 8
    }
    Found { at: 0, ret: 0 }
}

fn frame_above(s: *Sampler, rsp: i64, from: i64) -> i64 {
    var at = from + 8
    for at + 16 <= s.readable {
        let saved = io.le64(s.frame, at)
        let ret = io.le64(s.frame, at + 8)
        let here = rsp + at
        let outermost = saved == 0 || saved > here && saved < here + stack_reach
        if outermost && s.in_code(ret) {
            return here
        }
        at += 8
    }
    0
}
