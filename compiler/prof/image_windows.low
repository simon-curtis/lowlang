import compiler
import std/file
import std/io
import std/text

struct Span {
    start: i64
    end: i64
}

struct Image {
    base: i64
    size: i64
    code: Span
}

const section_header_size = 40
const executable_section = 0x20000000

fn read_image(program: str) -> Image ! Error {
    let bytes = file.read_file(program) catch {
        e => fail Failed("{program}: {compiler.reason(e)}")
    }
    if bytes.len < 64 || bytes[0] != 'M' || bytes[1] != 'Z' {
        fail Failed("{program} is not a Windows executable")
    }
    let header = io.le32(bytes, 0x3C)
    let optional = header + 24
    if optional + 64 > bytes.len || io.le32(bytes, header) != 0x4550 {
        fail Failed("{program} has no PE header")
    }
    let sections = io.le16(bytes, header + 6)
    let table = optional + io.le16(bytes, header + 20)
    if table + sections * section_header_size > bytes.len {
        fail Failed("{program} has a truncated section table")
    }
    let size = io.le32(bytes, optional + 56)
    var code = Span { start: size, end: 0 }
    for i in 0..sections {
        let at = table + i * section_header_size
        if io.le32(bytes, at + 36) & executable_section == 0 {
            continue
        }
        let start = io.le32(bytes, at + 12)
        let end = start + io.le32(bytes, at + 8)
        if start < code.start {
            code.start = start
        }
        if end > code.end {
            code.end = end
        }
    }
    if code.end == 0 {
        fail Failed("{program} has no executable section")
    }
    Image { base: io.le64(bytes, optional + 24), size, code }
}

struct Symbols {
    starts: []i64
    names: []str
    size: i64
}

fn load_symbols(path: str, image: Image) -> Symbols ! Error {
    let content = file.read_text(path) catch {
        e => fail Failed("{path}: {compiler.reason(e)}")
    }
    var starts: []i64 = []
    var names: []str = []
    for line in text.split(content, '\n') {
        let space = text.index_byte(line, ' ')
        if space <= 0 {
            continue
        }
        let address = text.parse_radix(line[..space], 16) catch {
            _ => fail Failed("{path}: {line} does not start with a hexadecimal address")
        }
        let rva = address - image.base
        if rva < 0 || rva >= image.size {
            continue
        }
        starts.push(rva)
        names.push(line[space + 1..])
    }
    if starts.len == 0 {
        fail Failed("{path} names no symbol inside the image")
    }
    Symbols { starts, names, size: image.size }
}

fn name_at(s: Symbols, rva: i64) -> str {
    if rva < 0 || rva >= s.size {
        return "[outside the image]"
    }
    var lo = 0
    var hi = s.starts.len
    for lo < hi {
        let mid = lo + (hi - lo) / 2
        if s.starts[mid] <= rva {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    if lo == 0 {
        return "[image header]"
    }
    s.names[lo - 1]
}
