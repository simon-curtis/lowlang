import std/io
import std/slices

struct Segment {
    offset: i64
    address: i64
    size: i64
}

struct Symbol {
    start: i64
    name: str
}

struct Image {
    label: str
    segments: []Segment
    symbols: []Symbol
}

const header_size = 64
const loadable = 1
const executable_segment = 1
const executable_section = 4
const symbol_table = 2
const dynamic_symbols = 11
const symbol_size = 24
const reserved_sections = 0xFF00
const function = 2
const shared_object = 3

struct Section {
    kind: i64
    flags: i64
    offset: i64
    size: i64
    link: i64
}

fn read_image(label: str, bytes: []u8) -> *Image {
    let image = new(Image { label, segments: [], symbols: [] })
    if bytes.len < header_size || io.le32(bytes, 0) != 0x464C457F || bytes[4] != 2 || bytes[5] != 1 {
        return image
    }
    image.segments = executable_segments(bytes)
    let sections = section_table(bytes)
    let table = symbols_of(sections) ?? return image
    if table.link >= sections.len {
        return image
    }
    let names = sections[table.link]
    let suffix = if io.le16(bytes, 0x10) == shared_object { " {label}" } else { "" }
    var at = table.offset
    for at + symbol_size <= table.offset + table.size && at + symbol_size <= bytes.len {
        let kind = i64(bytes[at + 4]) & 15
        let section = io.le16(bytes, at + 6)
        let name = name_in(bytes, names, io.le32(bytes, at))
        if (kind == 0 || kind == function) && name != "" && section > 0 && section < reserved_sections && section < sections.len && sections[section].flags & executable_section != 0 {
            image.symbols.push(Symbol { start: io.le64(bytes, at + 8), name: if suffix == "" { name } else { "{name}{suffix}" } })
        }
        at += symbol_size
    }
    slices.sort_by(mut image.symbols, fn(x, y) x.start < y.start)
    image
}

fn executable_segments(bytes: []u8) -> []Segment {
    var out: []Segment = []
    let first = io.le64(bytes, 0x20)
    let each = io.le16(bytes, 0x36)
    for i in 0..io.le16(bytes, 0x38) {
        let at = first + i * each
        if at + 56 > bytes.len {
            break
        }
        if io.le32(bytes, at) == loadable && io.le32(bytes, at + 4) & executable_segment != 0 {
            out.push(Segment { offset: io.le64(bytes, at + 8), address: io.le64(bytes, at + 16), size: io.le64(bytes, at + 32) })
        }
    }
    out
}

fn section_table(bytes: []u8) -> []Section {
    var out: []Section = []
    let first = io.le64(bytes, 0x28)
    let each = io.le16(bytes, 0x3A)
    for i in 0..io.le16(bytes, 0x3C) {
        let at = first + i * each
        if at + 64 > bytes.len {
            break
        }
        out.push(Section { kind: io.le32(bytes, at + 4), flags: io.le64(bytes, at + 8), offset: io.le64(bytes, at + 24), size: io.le64(bytes, at + 32), link: io.le32(bytes, at + 40) })
    }
    out
}

fn symbols_of(sections: []Section) -> Section? {
    var dynamic: Section? = none
    for s in sections {
        if s.kind == symbol_table {
            return s
        }
        if s.kind == dynamic_symbols {
            dynamic = s
        }
    }
    dynamic
}

fn name_in(bytes: []u8, names: Section, at: i64) -> str {
    let start = names.offset + at
    var end = start
    for end < bytes.len && end < names.offset + names.size && bytes[end] != 0 {
        end += 1
    }
    if start >= end {
        return ""
    }
    str(bytes[start..end])
}

fn address_of(image: *Image, offset: i64) -> i64? {
    for s in image.segments {
        if offset >= s.offset && offset < s.offset + s.size {
            return offset - s.offset + s.address
        }
    }
    none
}

fn symbol_at(image: *Image, offset: i64) -> str {
    let address = image.address_of(offset) ?? return image.label
    var lo = 0
    var hi = image.symbols.len
    for lo < hi {
        let mid = lo + (hi - lo) / 2
        if image.symbols[mid].start <= address {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    if lo == 0 {
        return image.label
    }
    image.symbols[lo - 1].name
}
