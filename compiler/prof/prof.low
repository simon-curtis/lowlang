import compiler
import std/builder
import std/file
import std/slices
import std/text

pub enum Error {
    Failed(message: str)
}

struct Sample {
    weight: i64
    frames: []str
}

struct Unit {
    name: str
    suffix: str
    scale: f64
}

struct Recording {
    samples: []Sample
    unit: Unit
    facts: []str
}

pub struct Config {
    pub map: str
    pub event: str
    pub interval_ms: i64
    pub depth: i64
    pub top: i64
    pub folded: str
    pub callers: str
    pub command: []str
    pub note: fn(str)
}

struct Tally {
    name: str
    weight: i64
}

pub fn run(config: Config) -> str ! Error {
    let recording = capture(config)?
    if config.folded != "" {
        write_folded(recording, config.folded)?
    }
    var out = builder.builder()
    report(mut out, recording, config.top)
    if config.callers != "" {
        write_callers_of(mut out, recording, config.callers)
    }
    out.to_str()
}

fn category(name: str) -> str {
    if text.starts_with(name, "[") || text.ends_with(name, "]") {
        return "system"
    }
    if text.starts_with(name, "fn___") {
        return "prelude"
    }
    if text.starts_with(name, "fn_std.") {
        return "std"
    }
    if text.starts_with(name, "fn_") {
        return "program"
    }
    "runtime"
}

fn add(mut tallies: [str: i64], name: str, weight: i64) {
    tallies[name] = (tallies[name] ?? 0) + weight
}

fn ranked(tallies: [str: i64]) -> []Tally {
    var out: []Tally = []
    for name, weight in tallies {
        out.push(Tally { name, weight })
    }
    slices.sort_by(mut out, fn(x, y) x.weight > y.weight || x.weight == y.weight && x.name < y.name)
    out
}

fn report(mut out: builder.Builder, r: Recording, top: i64) {
    var sampled = 0
    var own: [str: i64] = [:]
    var within: [str: i64] = [:]
    var kinds: [str: i64] = [:]
    for sample in r.samples {
        sampled += sample.weight
        let leaf = sample.frames[0]
        add(mut own, leaf, sample.weight)
        add(mut kinds, category(leaf), sample.weight)
        let seen: [str: bool] = [:]
        for name in sample.frames {
            if seen[name] == none {
                seen[name] = true
                add(mut within, name, sample.weight)
            }
        }
    }
    for fact in r.facts {
        out.write("{fact}\n")
    }
    let heading = "{r.unit.name} {r.unit.suffix}"
    let width = if heading.len < 8 { 10 } else { heading.len + 2 }
    out.write("\n{text.pad_right("category", 10, ' ')}{text.pad_left(heading, width, ' ')}   share\n")
    for t in ranked(kinds) {
        out.write("{text.pad_right(t.name, 10, ' ')}{text.pad_left(amount(r.unit, t.weight), width, ' ')}{text.pad_left(share(t.weight, sampled), 8, ' ')}\n")
    }
    write_table(mut out, r.unit, "self", ranked(own), sampled, top)
    write_table(mut out, r.unit, "inclusive", ranked(within), sampled, top)
}

fn write_table(mut out: builder.Builder, u: Unit, title: str, tallies: []Tally, sampled: i64, top: i64) {
    out.write("\n{title}\n")
    let count = if tallies.len < top { tallies.len } else { top }
    for t in tallies[..count] {
        out.write("{text.pad_left(share(t.weight, sampled), 8, ' ')}{text.pad_left(amount(u, t.weight), 10, ' ')}  {t.name}\n")
    }
}

fn amount(u: Unit, weight: i64) -> str {
    text.fixed(f64(weight) / u.scale, 3)
}

fn share(part: i64, whole: i64) -> str {
    if whole == 0 {
        return "-"
    }
    "{text.fixed(f64(part) * 100.0 / f64(whole), 1)}%"
}

fn write_folded(r: Recording, path: str) ! Error {
    var stacks: [str: i64] = [:]
    for sample in r.samples {
        var names: []str = []
        var i = sample.frames.len - 1
        for i >= 0 {
            names.push(sample.frames[i])
            i -= 1
        }
        add(mut stacks, text.join(names, ";"), sample.weight)
    }
    var out = builder.builder()
    for stack, weight in stacks {
        out.write("{stack} {weight}\n")
    }
    file.write_file(path, out.to_bytes()) catch {
        e => fail Failed("{path}: {compiler.reason(e)}")
    }
}

struct Caller {
    name: str
    weight: i64 = 0
    callers: [str: *Caller] = [:]
}

const callers_floor = 0.5

fn is_named(wanted: str, frame: str) -> bool {
    frame == wanted || frame.len == wanted.len + 3 && text.starts_with(frame, "fn_") && text.ends_with(frame, wanted)
}

fn write_callers_of(mut out: builder.Builder, r: Recording, wanted: str) {
    var sampled = 0
    let root = new(Caller { name: wanted })
    for sample in r.samples {
        sampled += sample.weight
        var at = sample.frames.len - 1
        for at >= 0 && !is_named(wanted, sample.frames[at]) {
            at -= 1
        }
        if at < 0 {
            continue
        }
        root.weight += sample.weight
        var node = root
        for name in sample.frames[at + 1..] {
            node = node.called_by(name)
            node.weight += sample.weight
        }
    }
    if root.weight == 0 {
        out.write("\nno sample passes through {wanted}\n")
        return
    }
    out.write("\ncallers of {wanted}, {share(root.weight, sampled)} of the samples\n")
    let floor = i64(f64(root.weight) * callers_floor / 100.0)
    root.write_callers(mut out, root.weight, floor, 0)
}

fn called_by(c: *Caller, name: str) -> *Caller {
    match c.callers[name] {
        some(found) => found
        none => {
            let made = new(Caller { name })
            c.callers[name] = made
            made
        }
    }
}

fn write_callers(c: *Caller, mut out: builder.Builder, whole: i64, floor: i64, indent: i64) {
    var above: []*Caller = []
    for _, by in c.callers {
        if by.weight > floor {
            above.push(by)
        }
    }
    slices.sort_by(mut above, fn(x, y) x.weight > y.weight || x.weight == y.weight && x.name < y.name)
    let deeper = if above.len > 1 { indent + 1 } else { indent }
    for by in above {
        out.write("{text.pad_left(share(by.weight, whole), 8, ' ')}  {text.repeat("  ", indent)}{by.name}\n")
        by.write_callers(mut out, whole, floor, deeper)
    }
}
