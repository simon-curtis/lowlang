import std/builder
import std/crypto/hash
import std/file
import std/io
import std/path
import std/slices
import std/text

pub const sum_file = "shaders.sum"
pub const target_env = "vulkan1.2"

const include_ext = ".glsl"
const binary_ext = ".spv"

fn stage_exts() -> []str {
    [".vert", ".frag"]
}

pub fn binary(stage: str) -> str {
    "{stage}{binary_ext}"
}

fn is_stage(ext: str) -> bool {
    slices.contains(stage_exts(), ext)
}

fn is_recorded(ext: str) -> bool {
    is_stage(ext) || ext == include_ext || ext == binary_ext
}

pub fn stages(dir: str) -> []str ! io.Error {
    list(dir, is_stage)?
}

pub fn sum(dir: str) -> str ! io.Error {
    let names = list(dir, is_recorded)?
    var lines = builder.builder()
    for name in names {
        let data = file.read_file(file.child_path(dir, name))?
        let digest = hash.sum(hash.sha256(), data)
        builder.write(mut lines, "{text.encode_hex(digest)}  {name}\n")
    }
    builder.to_str(lines)
}

fn list(dir: str, wanted: fn(str) -> bool) -> []str ! io.Error {
    var names: []str = []
    for name in file.list(dir)? {
        if wanted(path.ext(name)) {
            push(mut names, name)
        }
    }
    slices.sort(mut names)
    names
}
