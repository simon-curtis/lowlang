import check
import diag
import gentest
import lexer
import target
import types
import std/builder
import std/file
import std/io
import std/path
import std/protobuf/proto
import std/testing
import std/text

struct Source {
    path: str
    text: str
}

fn lexer_keywords() -> []str {
    var words: []str = []
    for s in lexer.keyword_spellings() {
        words.push(s.text)
    }
    words
}

fn contains(words: []str, word: str) -> bool {
    for w in words {
        if w == word {
            return true
        }
    }
    false
}

fn test_keywords_match_the_lexer(t: *testing.T) {
    let generator = proto.keywords()
    for word in lexer_keywords() {
        if !contains(generator, word) {
            t.error("proto.keywords lacks {word}")
        }
    }
    for word in generator {
        if !contains(lexer_keywords(), word) {
            t.error("proto.keywords lists {word}, which the lexer does not")
        }
    }
}

fn keyword_words() -> []str {
    var words = lexer_keywords()
    for w in lexer.contextual_keywords() {
        words.push(w)
    }
    words
}

fn is_identifier(word: str) -> bool {
    if word == "" || word[0] == '_' {
        return false
    }
    for c in word {
        let lower = c >= 'a' && c <= 'z'
        let digit = c >= '0' && c <= '9'
        if !lower && !digit && c != '_' {
            return false
        }
    }
    !(word[0] >= '0' && word[0] <= '9')
}

fn builtin_words() -> []str {
    let universe = types.new_universe(fn(t: *types.Type) ! diag.Error {})
    var words = keyword_words()
    for b in check.builtins(universe) {
        if is_identifier(b.name) && !contains(words, b.name) {
            words.push(b.name)
        }
    }
    words
}

fn field_name(word: str) -> str {
    if contains(lexer_keywords(), word) {
        return "{word}_"
    }
    word
}

fn words_proto(words: []str) -> str {
    var out = builder.builder()
    builder.write(mut out, "syntax = \"proto3\";\nmessage Words {{\n")
    var number = 1
    for word in words {
        builder.write(mut out, "  int32 {word} = {number};\n")
        number += 1
    }
    builder.write(mut out, "}}\n")
    builder.to_str(out)
}

fn words_main(words: []str) -> str {
    var out = builder.builder()
    builder.write(mut out, "import std/protobuf\nimport std/text\n\nfn main() {{\n    let w = Words {{\n")
    var number = 1
    for word in words {
        builder.write(mut out, "        {field_name(word)}: {number},\n")
        number += 1
    }
    builder.write(mut out, "    }}\n    let data = protobuf.serialize(w)\n    print(text.encode_hex(data))\n")
    builder.write(mut out, "    let back = protobuf.deserialize[Words](data) or panic(\"decode\")\n")
    builder.write(mut out, "    print(text.encode_hex(protobuf.serialize(back)))\n}}\n")
    builder.to_str(out)
}

fn varint(mut out: []u8, value: i64) {
    var rest = value
    for rest >= 0x80 {
        out.push(u8(rest & 0x7F | 0x80))
        rest = rest >> 7
    }
    out.push(u8(rest))
}

fn words_expected(words: []str) -> str {
    var data: []u8 = []
    var number = 1
    for _ in words {
        varint(mut data, number << 3)
        varint(mut data, number)
        number += 1
    }
    text.encode_hex(data)
}

fn reader(files: []Source) -> fn(str) -> str ! io.Error {
    fn(name: str) -> str ! io.Error {
        for f in files {
            if f.path == name {
                return f.text
            }
        }
        fail io.Error.NotFound
    }
}

fn generate(t: *testing.T, files: []Source, paths: []str, options: proto.Options) -> []proto.Output {
    let set = proto.read_files(paths, [""], reader(files)) catch {
        e => {
            t.fatal(proto.message(e))
            return []
        }
    }
    proto.generate(set, options) catch {
        e => {
            t.fatal(proto.message(e))
            return []
        }
    }
}

fn run_words(t: *testing.T, words: []str) {
    let outputs = generate(t, [Source { path: "words.proto", text: words_proto(words) }], ["words.proto"], proto.Options {})
    let dir = file.temp_dir("protogen") catch {
        e => {
            t.fatal("{e}")
            return
        }
    }
    defer file.remove_all(dir) or {}
    let programs = [
        gentest.Program { file: "words.low", contents: bytes(outputs[0].text) }
        gentest.Program { file: "main.low", contents: bytes(words_main(words)) }
    ]
    let binary = gentest.build_directory(t, dir, programs, target.host())
    let got = gentest.run_binary(t, binary)
    let want = "{words_expected(words)}\n{words_expected(words)}\n"
    if got != want {
        t.error("output:\n{got}\nwant:\n{want}")
    }
}

fn test_keyword_and_builtin_fields_compile(t: *testing.T) {
    run_words(t, builtin_words())
}

fn test_output_is_deterministic(t: *testing.T) {
    let files = [Source { path: "words.proto", text: words_proto(keyword_words()) }]
    let a = generate(t, files, ["words.proto"], proto.Options {})
    let b = generate(t, files, ["words.proto"], proto.Options {})
    if a[0].text != b[0].text {
        t.error("two generations of one file differ")
    }
}

fn first_proto() -> Source {
    Source { path: "a/bytes.proto", text: "syntax = \"proto3\";\npackage one;\nmessage First {{ int32 v = 1; }}\n" }
}

fn second_proto() -> Source {
    Source { path: "b/bytes.proto", text: "syntax = \"proto3\";\npackage two;\nmessage Second {{ int32 v = 1; }}\n" }
}

fn top_proto() -> Source {
    var out = builder.builder()
    builder.write(mut out, "syntax = \"proto3\";\npackage top;\nimport \"a/bytes.proto\";\nimport \"b/bytes.proto\";\n")
    builder.write(mut out, "message Outer {{ message Inner {{ int32 x = 1; }} Inner inner = 1; }}\n")
    builder.write(mut out, "message OuterInner {{ int32 y = 1; }}\n")
    builder.write(mut out, "message Names {{ int32 fooBar = 1; int32 foo_bar = 2; }}\n")
    builder.write(mut out, "message Holder {{ one.First first = 1; two.Second second = 2; Outer.Inner inner = 3; OuterInner other = 4; }}\n")
    Source { path: "top.proto", text: builder.to_str(out) }
}

fn collision_main() -> str {
    var out = builder.builder()
    builder.write(mut out, "import first = gen/a/bytes\nimport second = gen/b/bytes\nimport gen/top\nimport std/protobuf\nimport std/text\n\n")
    builder.write(mut out, "fn main() {{\n    let holder = top.Holder {{\n")
    builder.write(mut out, "        first: first.First {{ v: 1 }},\n        second: second.Second {{ v: 2 }},\n")
    builder.write(mut out, "        inner: top.OuterInner {{ x: 3 }},\n        other: top.OuterInner2 {{ y: 4 }},\n    }}\n")
    builder.write(mut out, "    print(text.encode_hex(protobuf.serialize(holder)))\n")
    builder.write(mut out, "    print(text.encode_hex(protobuf.serialize(top.Names {{ foo_bar: 7, foo_bar_2: 8 }})))\n}}\n")
    builder.to_str(out)
}

fn test_colliding_names_and_modules_compile(t: *testing.T) {
    let files = [first_proto(), second_proto(), top_proto()]
    let outputs = generate(t, files, ["top.proto"], proto.Options { module: "gen" })
    let dir = file.temp_dir("protogen") catch {
        e => {
            t.fatal("{e}")
            return
        }
    }
    defer file.remove_all(dir) or {}
    var programs: []gentest.Program = []
    for o in outputs {
        let relative = "gen/{o.path}"
        file.mkdir_all(file.child_path(dir, path.dir(relative))) catch {
            e => {
                t.fatal("{relative}: {e}")
                return
            }
        }
        programs.push(gentest.Program { file: relative, contents: bytes(o.text) })
    }
    programs.push(gentest.Program { file: "low.mod", contents: [] })
    programs.push(gentest.Program { file: "main.low", contents: bytes(collision_main()) })
    let binary = gentest.build_directory(t, dir, programs, target.host())
    let got = gentest.run_binary(t, binary)
    let want = "0a020801120208021a02080322020804\n08071008\n"
    if got != want {
        t.error("output:\n{got}\nwant:\n{want}")
    }
}

fn test_module_path_ending_in_slash(t: *testing.T) {
    let files = [first_proto(), second_proto(), top_proto()]
    let plain = generate(t, files, ["top.proto"], proto.Options { module: "gen" })
    let slashed = generate(t, files, ["top.proto"], proto.Options { module: "gen/" })
    if plain.len != slashed.len {
        t.fatal("output counts differ")
    }
    for i in 0..plain.len {
        if plain[i].text != slashed[i].text {
            t.error("{plain[i].path} differs with a trailing slash on the module")
        }
    }
}

fn main() {
    testing.run([
        testing.Test { name: "keywords_match_the_lexer", run: test_keywords_match_the_lexer }
        testing.Test { name: "keyword_and_builtin_fields_compile", run: test_keyword_and_builtin_fields_compile }
        testing.Test { name: "output_is_deterministic", run: test_output_is_deterministic }
        testing.Test { name: "colliding_names_and_modules_compile", run: test_colliding_names_and_modules_compile }
        testing.Test { name: "module_path_ending_in_slash", run: test_module_path_ending_in_slash }
    ])
}
