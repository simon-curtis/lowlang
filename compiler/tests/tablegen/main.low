import std/file
import std/testing
import std/text
import tablegen

struct LayoutCase {
    dir: str
    file: str
    source: str
    tables: []str
    command: str
}

fn layout_cases() -> []LayoutCase {
    [
        LayoutCase { dir: "unicode", file: tablegen.normalization_layout_file, source: tablegen.normalization_layout_source(), tables: tablegen.unicode_tables(), command: "unicode" }
        LayoutCase { dir: "unicode", file: tablegen.property_layout_file, source: tablegen.property_layout_source(), tables: tablegen.property_tables(), command: "properties" }
        LayoutCase { dir: "html", file: tablegen.entity_layout_file, source: tablegen.entity_layout_source(), tables: tablegen.entity_tables(), command: "entities" }
    ]
}

fn case_name(c: LayoutCase) -> str {
    "{c.dir}/{c.file}"
}

fn test_layout_files_match_generator(t: *testing.T) {
    testing.table_of(t, layout_cases(), case_name, fn(t: *testing.T, c: LayoutCase) {
        let dir = "std/{c.dir}"
        let committed = file.read_text(file.child_path(dir, c.file)) or ""
        if committed != c.source {
            t.error("std/{c.dir}/{c.file} differs from the generator; run tablegen {c.command}")
        }
        for table in c.tables {
            if !file.exists(file.child_path(dir, table)) {
                t.error("std/{c.dir}/{table}: no such file")
            }
        }
    })
}

fn test_pow10_tables_match_generator(t: *testing.T) {
    let sections = tablegen.pow10_sections() catch {
        e => {
            t.fatal("pow10_sections: {e}")
            return
        }
    }
    let binary = file.read_file("std/text/pow10.bin") or {
        t.fatal("std/text/pow10.bin: cannot read")
        return
    }
    if !equal_bytes(binary, sections[0].data) {
        t.error("std/text/pow10.bin differs from the generator; run tablegen pow10")
    }
    let prelude = file.read_text("compiler/compiler/prelude/prelude.low") or {
        t.fatal("compiler/compiler/prelude/prelude.low: cannot read")
        return
    }
    let generated = str(sections[1].data)
    if !text.contains(prelude, generated) {
        t.error("prelude.low __pow10_hi and __pow10_lo differ from the generator; run tablegen pow10")
    }
}

fn equal_bytes(a: []u8, b: []u8) -> bool {
    if a.len != b.len {
        return false
    }
    for i in 0..a.len {
        if a[i] != b[i] {
            return false
        }
    }
    true
}

fn main() {
    testing.run([
        testing.Test { name: "layout_files_match_generator", run: test_layout_files_match_generator }
        testing.Test { name: "pow10_tables_match_generator", run: test_pow10_tables_match_generator }
    ])
}
