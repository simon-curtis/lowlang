import fixture
import std/file
import std/testing

const millisecond: i64 = 1000000

fn scratch(t: *testing.T) -> str {
    file.temp_dir("fixture-test-") catch {
        e => {
            t.fatal("{e}")
            return ""
        }
    }
}

fn put_file(t: *testing.T, path: str, content: str) {
    file.write_text(path, content) or {
        t.fatal("cannot write {path}")
    }
}

fn test_write_then_read_round_trips(t: *testing.T) {
    let dir = scratch(t)
    defer file.remove_all(dir) or {}
    let path = file.child_path(dir, "program.low")
    let want = fixture.Sidecars {
        stdout: "5\n"
        stderr: "panic: integer divide by zero\n"
        panics: true
        max_rss_kb: 16000
        max_time_ns: 1500 * millisecond
        libraries: ["libc.so.6", "libm.so.6"]
        simd: true
        linux_only: true
    }
    fixture.write(want, path) catch {
        e => {
            t.fatal(fixture.message(e))
            return
        }
    }
    let got = fixture.read(path) catch {
        e => {
            t.fatal(fixture.message(e))
            return
        }
    }
    t.equal(got.stdout, want.stdout)
    t.equal(got.stderr, want.stderr)
    t.equal(got.panics, want.panics)
    t.equal(got.max_rss_kb, want.max_rss_kb)
    t.equal(got.max_time_ns, want.max_time_ns)
    t.equal(got.libraries.len, want.libraries.len)
    for i in 0..want.libraries.len {
        t.equal(got.libraries[i], want.libraries[i])
    }
    t.equal(got.simd, want.simd)
    t.equal(got.linux_only, want.linux_only)
}

fn test_write_omits_empty_sidecars(t: *testing.T) {
    let dir = scratch(t)
    defer file.remove_all(dir) or {}
    let path = file.child_path(dir, "program.low")
    fixture.write(fixture.Sidecars {}, path) catch {
        e => {
            t.fatal(fixture.message(e))
            return
        }
    }
    let entries = file.list(dir) or {
        t.fatal("cannot list {dir}")
        return
    }
    t.equal(entries.len, 0)
}

fn test_read_without_sidecars_is_empty(t: *testing.T) {
    let dir = scratch(t)
    defer file.remove_all(dir) or {}
    let got = fixture.read(file.child_path(dir, "program.low")) catch {
        e => {
            t.fatal(fixture.message(e))
            return
        }
    }
    t.equal(got.stdout, "")
    t.equal(got.stderr, "")
    t.is_false(got.panics)
    t.equal(got.max_rss_kb, 0)
    t.equal(got.max_time_ns, 0)
    t.equal(got.libraries.len, 0)
    t.is_false(got.simd)
    t.is_false(got.linux_only)
    t.is_true(fixture.windows(got))
}

fn test_read_rejects_unknown_tag(t: *testing.T) {
    let dir = scratch(t)
    defer file.remove_all(dir) or {}
    put_file(t, file.child_path(dir, "program.tags"), "simd\nfast\n")
    fixture.read(file.child_path(dir, "program.low")) catch {
        e => return
    }
    t.error("an unknown tag was accepted")
}

fn test_read_rejects_bad_limits(t: *testing.T) {
    for ext in [fixture.max_rss_ext, fixture.max_time_ext] {
        let dir = scratch(t)
        defer file.remove_all(dir) or {}
        put_file(t, file.child_path(dir, "program{ext}"), "soon\n")
        fixture.read(file.child_path(dir, "program.low")) catch {
            e => continue
        }
        t.error("{ext} accepted an unparsable limit")
    }
}

fn test_read_test_sidecars(t: *testing.T) {
    let dir = scratch(t)
    defer file.remove_all(dir) or {}
    let program = file.child_path(dir, "split")
    put_file(t, file.child_path(dir, "split.out"), "PASS\n")
    put_file(t, file.child_path(dir, "split.err"), "warning\n")
    put_file(t, file.child_path(dir, "split.args"), "-v\n\n -run split \n")
    put_file(t, file.child_path(dir, "split.status"), "1\n")
    put_file(t, file.child_path(dir, "split.module"), "a/b\n")
    let got = fixture.read_test(program) catch {
        e => {
            t.fatal(fixture.message(e))
            return
        }
    }
    t.equal(got.stdout, "PASS\n")
    t.equal(got.stderr, "warning\n")
    t.equal(got.status, 1)
    t.equal(got.module, "a/b")
    t.equal_slice(got.args, ["-v", "-run split"])
}

fn test_read_test_sidecars_default_to_empty(t: *testing.T) {
    let dir = scratch(t)
    defer file.remove_all(dir) or {}
    let got = fixture.read_test(file.child_path(dir, "split")) catch {
        e => {
            t.fatal(fixture.message(e))
            return
        }
    }
    t.equal(got.stdout, "")
    t.equal(got.stderr, "")
    t.equal(got.status, 0)
    t.equal(got.module, "")
    t.equal(got.args.len, 0)
}

fn test_read_test_rejects_a_bad_status(t: *testing.T) {
    let dir = scratch(t)
    defer file.remove_all(dir) or {}
    put_file(t, file.child_path(dir, "split.status"), "failed\n")
    fixture.read_test(file.child_path(dir, "split")) catch {
        e => return
    }
    t.error("an unparsable status was accepted")
}

fn test_libraries_exclude_windows(t: *testing.T) {
    t.is_false(fixture.windows(fixture.Sidecars { libraries: ["libm.so.6"] }))
    t.is_false(fixture.windows(fixture.Sidecars { linux_only: true }))
}

fn test_directory_fixture_sidecars_sit_beside_it(t: *testing.T) {
    let dir = scratch(t)
    defer file.remove_all(dir) or {}
    let program = file.child_path(dir, "modules")
    file.mkdir(program) or {
        t.fatal("cannot create {program}")
    }
    put_file(t, file.child_path(dir, "modules.out"), "ok\n")
    let got = fixture.read(program) catch {
        e => {
            t.fatal(fixture.message(e))
            return
        }
    }
    t.equal(got.stdout, "ok\n")
}

fn test_duration_text_matches_the_runner_format(t: *testing.T) {
    t.equal(fixture.duration_text(1500 * millisecond), "1.5s")
    t.equal(fixture.duration_text(60000 * millisecond), "1m0s")
    t.equal(fixture.duration_text(250000), "250µs")
    t.equal(fixture.duration_text(750), "750ns")
    t.equal(fixture.duration_text(2 * millisecond), "2ms")
}

fn main() {
    testing.run([
        testing.Test { name: "write_then_read_round_trips", run: test_write_then_read_round_trips }
        testing.Test { name: "write_omits_empty_sidecars", run: test_write_omits_empty_sidecars }
        testing.Test { name: "read_without_sidecars_is_empty", run: test_read_without_sidecars_is_empty }
        testing.Test { name: "read_rejects_unknown_tag", run: test_read_rejects_unknown_tag }
        testing.Test { name: "read_rejects_bad_limits", run: test_read_rejects_bad_limits }
        testing.Test { name: "read_test_sidecars", run: test_read_test_sidecars }
        testing.Test { name: "read_test_sidecars_default_to_empty", run: test_read_test_sidecars_default_to_empty }
        testing.Test { name: "read_test_rejects_a_bad_status", run: test_read_test_rejects_a_bad_status }
        testing.Test { name: "libraries_exclude_windows", run: test_libraries_exclude_windows }
        testing.Test { name: "directory_fixture_sidecars_sit_beside_it", run: test_directory_fixture_sidecars_sit_beside_it }
        testing.Test { name: "duration_text_matches_the_runner_format", run: test_duration_text_matches_the_runner_format }
    ])
}
