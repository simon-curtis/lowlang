import amd64
import ir
import std/testing
import std/text

fn defines_label(source: str, label: str) -> bool {
    text.contains(source, "\n{label}:")
}

fn test_hot_runtime_defines_patch_symbols(t: *testing.T) {
    let hot = amd64.hot_runtime()
    for symbol in [amd64.patch_list_symbol, amd64.patch_count_symbol] {
        let global = "\t.globl {symbol}\n{symbol}:\n"
        if !text.contains(hot, global) {
            t.error("hot runtime does not define {symbol}")
        }
    }
}

fn test_poll_saves_every_float_register(t: *testing.T) {
    let scheduler = amd64.scheduler_asm()
    let after_label = text.cut(scheduler, "\nrt_poll:\n")
    if !after_label.found {
        t.fatal("scheduler does not define rt_poll")
        return
    }
    let body = text.cut(after_label.after, "\nrt_poll_run:")
    if !body.found {
        t.fatal("scheduler does not define rt_poll_run after rt_poll")
        return
    }
    for reg in amd64.float_regs() {
        let save = ", {reg}\n"
        let restore = "movq {reg}, [rsp"
        if !text.contains(body.before, save) || !text.contains(body.before, restore) {
            t.error("rt_poll does not save and restore {reg}")
        }
    }
}

struct Source {
    system: str
    text: str
}

fn sources() -> []Source {
    let shared = "{amd64.runtime_asm()}\n{amd64.scheduler_asm()}\n{amd64.collector_asm()}"
    [
        Source { system: "linux", text: "{shared}\n{amd64.linux_runtime()}" }
        Source { system: "windows", text: "{shared}\n{amd64.windows_runtime()}" }
    ]
}

fn entry_symbols(entry: ir.Runtime) -> []str {
    let symbol = ir.runtime_symbol(entry)
    if ir.runtime_convention(entry) == ir.Convention.CallGrow {
        return ["{symbol}_scan", "{symbol}_noscan"]
    }
    [symbol]
}

fn test_runtime_entries_are_defined(t: *testing.T) {
    let all = sources()
    for entry in ir.runtime_entries() {
        for symbol in entry_symbols(entry) {
            for source in all {
                if !defines_label(source.text, symbol) {
                    t.error("{source.system} runtime does not define {symbol}")
                }
            }
        }
    }
}

fn main() {
    testing.run([
        testing.Test { name: "hot_runtime_defines_patch_symbols", run: test_hot_runtime_defines_patch_symbols }
        testing.Test { name: "poll_saves_every_float_register", run: test_poll_saves_every_float_register }
        testing.Test { name: "runtime_entries_are_defined", run: test_runtime_entries_are_defined }
    ])
}
