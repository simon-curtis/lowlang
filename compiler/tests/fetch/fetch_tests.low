import fetch
import native
import std/file
import std/os
import std/path
import std/process
import std/testing
import std/text

struct Remote {
    dir: str
}

struct Release {
    name: str
    version: str
    body: str
    manifest: str
}

fn remote(t: *testing.T) -> Remote? {
    if process.find("git") == none {
        t.skip("needs git on PATH")
        return none
    }
    let dir = file.temp_dir("low-fetch-") catch {
        e => {
            t.fatal("create temporary directory: {testing.format(e)}")
            return none
        }
    }
    let settings = [
        ["GIT_CONFIG_GLOBAL", "/dev/null"]
        ["GIT_CONFIG_NOSYSTEM", "1"]
        ["GIT_CONFIG_COUNT", "1"]
        ["GIT_CONFIG_KEY_0", "url.file://{dir}/repos/.insteadOf"]
        ["GIT_CONFIG_VALUE_0", "https://"]
        ["GIT_AUTHOR_NAME", "low"]
        ["GIT_AUTHOR_EMAIL", "low@example.com"]
        ["GIT_COMMITTER_NAME", "low"]
        ["GIT_COMMITTER_EMAIL", "low@example.com"]
    ]
    for pair in settings {
        os.set_env(pair[0], pair[1]) catch {
            e => {
                t.fatal("set {pair[0]}: {testing.format(e)}")
                return none
            }
        }
    }
    Remote { dir }
}

fn publish(r: Remote, t: *testing.T, release: Release) {
    let work = "{r.dir}/src/{release.name}"
    if !file.is_dir(work) {
        git(t, ["init", "--quiet", work])
    }
    write(t, "{work}/{release.name}.low", release.body)
    write(t, "{work}/build.low", release.manifest)
    git(t, ["-C", work, "add", "-A"])
    git(t, ["-C", work, "commit", "--quiet", "-m", release.version])
    git(t, ["-C", work, "tag", "-a", release.version, "-m", release.version])
    let bare = "{r.dir}/repos/example.com/{release.name}"
    file.remove_all(bare) or {}
    git(t, ["clone", "--quiet", "--bare", work, bare])
}

fn git(t: *testing.T, args: str[]) {
    let command = process.command("git", args)
    let out = process.run(command, []) catch {
        e => {
            t.fatal("git: {testing.format(e)}")
            return
        }
    }
    if !process.success(out.status) {
        let printed = text.join(args, " ")
        let detail = str(out.stderr)
        t.fatal("git {printed}: {detail}")
    }
}

fn write(t: *testing.T, location: str, contents: str) {
    file.mkdir_all(path.dir(location)) catch {
        e => t.fatal("create the directory of {location}: {testing.format(e)}")
    }
    file.write_text(location, contents) catch {
        e => t.fatal("write {location}: {testing.format(e)}")
    }
}

fn read(t: *testing.T, location: str) -> str {
    file.read_text(location) catch {
        e => {
            t.fatal("read {location}: {testing.format(e)}")
            ""
        }
    }
}

fn app(r: Remote, t: *testing.T, range: str) -> str {
    let dir = "{r.dir}/app"
    write(t, "{dir}/build.low", "import std/build\n\nbuild.dep(\"example.com/ui\", \"{range}\")\n")
    dir
}

fn sync(t: *testing.T, dir: str, update: bool) {
    let docs = native.overlay()
    fetch.sync(docs, dir, update) catch {
        e => t.fatal("sync: {fetch.message(e)}")
    }
}

fn versions(t: *testing.T, dir: str) -> str {
    let lock = read(t, "{dir}/{fetch.lock_file}")
    var held: str[] = []
    for line in text.lines(lock) {
        let fields = text.fields(line)
        if fields.len == 3 {
            held.push("{fields[0]} {fields[1]}")
        }
    }
    text.join(held, ", ")
}

fn color(version: str, shade: str) -> Release {
    Release { name: "color", version, body: "pub const name = \"{shade}\"\n", manifest: "import std/build\n" }
}

fn ui(version: str, range: str) -> Release {
    let manifest = "import std/build\n\nbuild.dep(\"example.com/color\", \"{range}\")\n"
    Release { name: "ui", version, body: "import example.com/color\n\npub const label = color.name\n", manifest }
}

fn test_resolves_pins_and_updates(t: *testing.T) {
    let r = remote(t) ?? return
    defer file.remove_all(r.dir) or {}
    publish(r, t, color("v1.0.0", "red 1.0"))
    publish(r, t, color("v1.2.0", "red 1.2"))
    publish(r, t, ui("v0.4.2", "^1.1"))
    let dir = app(r, t, "^0.4")
    sync(t, dir, false)
    t.equal(versions(t, dir), "example.com/color v1.2.0, example.com/ui v0.4.2")
    let fetched = "{dir}/.low/deps/example.com/color/color.low"
    t.is_true(text.contains(read(t, fetched), "red 1.2"))
    publish(r, t, color("v1.3.0", "red 1.3"))
    sync(t, dir, false)
    t.equal(versions(t, dir), "example.com/color v1.2.0, example.com/ui v0.4.2")
    sync(t, dir, true)
    t.equal(versions(t, dir), "example.com/color v1.3.0, example.com/ui v0.4.2")
    t.is_true(text.contains(read(t, fetched), "red 1.3"))
}

fn test_unsatisfiable_range_names_every_want(t: *testing.T) {
    let r = remote(t) ?? return
    defer file.remove_all(r.dir) or {}
    publish(r, t, color("v1.0.0", "red 1.0"))
    publish(r, t, ui("v0.4.2", "^2"))
    let dir = app(r, t, "^0.4")
    let docs = native.overlay()
    fetch.sync(docs, dir, false) catch {
        e => {
            let got = fetch.message(e)
            t.is_true(text.contains(got, "no tagged version of example.com/color satisfies ^2 at"))
            return
        }
    }
    t.error("resolved a range no tag satisfies")
}
