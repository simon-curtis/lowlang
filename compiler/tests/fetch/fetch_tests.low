import compiler
import fetch
import native
import std/file
import std/os
import std/path
import std/process
import std/testing
import std/text

const color_v1_hash = "h1:3HxccZ+LU9SRBs68aW1+4v0em3QER0tAcUxMmdFRxhM="

struct Remote {
    dir: str
    cache: str
}

struct Release {
    name: str
    version: str
    body: str
    manifest: str
    link: str = ""
}

fn remote(t: *testing.T) -> Remote? {
    if process.find("git") == none {
        t.skip("needs git on PATH")
        return none
    }
    let dir = file.temp_dir("low-fetch-") catch {
        e => {
            t.fatal("create temporary directory: {testing.format(e)}")
            return none
        }
    }
    let cache = "{dir}/cache"
    let settings = [
        ["GIT_CONFIG_GLOBAL", "/dev/null"]
        ["GIT_CONFIG_NOSYSTEM", "1"]
        ["GIT_CONFIG_COUNT", "1"]
        ["GIT_CONFIG_KEY_0", "url.file://{dir}/repos/.insteadOf"]
        ["GIT_CONFIG_VALUE_0", "https://"]
        ["GIT_AUTHOR_NAME", "low"]
        ["GIT_AUTHOR_EMAIL", "low@example.com"]
        ["GIT_COMMITTER_NAME", "low"]
        ["GIT_COMMITTER_EMAIL", "low@example.com"]
        ["LOW_CACHE", cache]
    ]
    for pair in settings {
        os.set_env(pair[0], pair[1]) catch {
            e => {
                t.fatal("set {pair[0]}: {testing.format(e)}")
                return none
            }
        }
    }
    Remote { dir, cache }
}

fn use_cache(t: *testing.T, cache: str) {
    os.set_env("LOW_CACHE", cache) catch {
        e => t.fatal("set LOW_CACHE: {testing.format(e)}")
    }
}

fn publish(r: Remote, t: *testing.T, release: Release) {
    let work = "{r.dir}/src/{release.name}"
    if !file.is_dir(work) {
        git(t, ["init", "--quiet", work])
    }
    write(t, "{work}/{release.name}.low", release.body)
    write(t, "{work}/build.low", release.manifest)
    if release.link != "" {
        file.symlink("{release.name}.low", "{work}/{release.link}") catch {
            e => t.fatal("link {release.link}: {testing.format(e)}")
        }
    }
    git(t, ["-C", work, "add", "-A"])
    git(t, ["-C", work, "commit", "--quiet", "-m", release.version])
    git(t, ["-C", work, "tag", "-f", "-a", release.version, "-m", release.version])
    let bare = "{r.dir}/repos/example.com/{release.name}"
    file.remove_all(bare) or {}
    git(t, ["clone", "--quiet", "--bare", work, bare])
}

fn git(t: *testing.T, args: str[]) {
    let command = process.command("git", args)
    let out = process.run(command, []) catch {
        e => {
            t.fatal("git: {testing.format(e)}")
            return
        }
    }
    if !process.success(out.status) {
        let printed = text.join(args, " ")
        let detail = str(out.stderr)
        t.fatal("git {printed}: {detail}")
    }
}

fn write(t: *testing.T, location: str, contents: str) {
    file.mkdir_all(path.dir(location)) catch {
        e => t.fatal("create the directory of {location}: {testing.format(e)}")
    }
    file.write_text(location, contents) catch {
        e => t.fatal("write {location}: {testing.format(e)}")
    }
}

fn read(t: *testing.T, location: str) -> str {
    file.read_text(location) catch {
        e => {
            t.fatal("read {location}: {testing.format(e)}")
            ""
        }
    }
}

fn app_at(t: *testing.T, dir: str, range: str) -> str {
    write(t, "{dir}/build.low", "import std/build\n\nbuild.dep(\"example.com/ui\", \"{range}\")\n")
    dir
}

fn app(r: Remote, t: *testing.T, range: str) -> str {
    app_at(t, "{r.dir}/app", range)
}

fn sync(t: *testing.T, dir: str, update: bool) {
    let docs = native.overlay()
    fetch.sync(docs, dir, update) catch {
        e => t.fatal("sync: {fetch.message(e)}")
    }
}

fn sync_error(t: *testing.T, dir: str, update: bool) -> str {
    let docs = native.overlay()
    fetch.sync(docs, dir, update) catch {
        e => {
            return fetch.message(e)
        }
    }
    t.error("sync succeeded")
    ""
}

fn lock_entry(t: *testing.T, dir: str, source: str) -> str[] {
    let lock = read(t, "{dir}/{compiler.lock_file}")
    for line in text.lines(lock) {
        let fields = text.fields(line)
        if fields.len > 0 && fields[0] == source {
            return fields
        }
    }
    t.fatal("{source} is not in {dir}/{compiler.lock_file}")
    []
}

fn versions(t: *testing.T, dir: str) -> str {
    let lock = read(t, "{dir}/{compiler.lock_file}")
    var held: str[] = []
    for line in text.lines(lock) {
        let fields = text.fields(line)
        if fields.len == 4 {
            held.push("{fields[0]} {fields[1]}")
        }
    }
    text.join(held, ", ")
}

fn cached(r: Remote, t: *testing.T, dir: str, source: str) -> str {
    let fields = lock_entry(t, dir, source)
    compiler.cached_dir(r.cache, source, fields[2])
}

fn color(version: str, shade: str) -> Release {
    Release { name: "color", version, body: "pub const name = \"{shade}\"\n", manifest: "import std/build\n" }
}

fn ui(version: str, range: str) -> Release {
    let manifest = "import std/build\n\nbuild.dep(\"example.com/color\", \"{range}\")\n"
    Release { name: "ui", version, body: "import example.com/color\n\npub const label = color.name\n", manifest }
}

fn test_resolves_pins_and_updates(t: *testing.T) {
    let r = remote(t) ?? return
    defer file.remove_all(r.dir) or {}
    publish(r, t, color("v1.0.0", "red 1.0"))
    publish(r, t, color("v1.2.0", "red 1.2"))
    publish(r, t, ui("v0.4.2", "^1.1"))
    let dir = app(r, t, "^0.4")
    sync(t, dir, false)
    t.equal(versions(t, dir), "example.com/color v1.2.0, example.com/ui v0.4.2")
    let first_tree = cached(r, t, dir, "example.com/color")
    let fetched = "{first_tree}/color.low"
    t.is_true(text.contains(read(t, fetched), "red 1.2"))
    publish(r, t, color("v1.3.0", "red 1.3"))
    sync(t, dir, false)
    t.equal(versions(t, dir), "example.com/color v1.2.0, example.com/ui v0.4.2")
    sync(t, dir, true)
    t.equal(versions(t, dir), "example.com/color v1.3.0, example.com/ui v0.4.2")
    let second_tree = cached(r, t, dir, "example.com/color")
    let updated = "{second_tree}/color.low"
    t.is_true(text.contains(read(t, updated), "red 1.3"))
    t.is_true(text.contains(read(t, fetched), "red 1.2"))
}

fn test_unsatisfiable_range_names_every_want(t: *testing.T) {
    let r = remote(t) ?? return
    defer file.remove_all(r.dir) or {}
    publish(r, t, color("v1.0.0", "red 1.0"))
    publish(r, t, ui("v0.4.2", "^2"))
    let dir = app(r, t, "^0.4")
    let docs = native.overlay()
    fetch.sync(docs, dir, false) catch {
        e => {
            let got = fetch.message(e)
            t.is_true(text.contains(got, "no tagged version of example.com/color satisfies ^2 at"))
            return
        }
    }
    t.error("resolved a range no tag satisfies")
}

fn test_lock_line_holds_source_version_commit_and_hash(t: *testing.T) {
    let r = remote(t) ?? return
    defer file.remove_all(r.dir) or {}
    publish(r, t, color("v1.0.0", "red 1.0"))
    publish(r, t, ui("v0.4.2", "^1.0"))
    let dir = app(r, t, "^0.4")
    sync(t, dir, false)
    let fields = lock_entry(t, dir, "example.com/color")
    t.equal(fields.len, 4)
    t.equal(fields[1], "v1.0.0")
    t.equal(fields[2].len, 40)
    t.equal(fields[3], color_v1_hash)
    let other = lock_entry(t, dir, "example.com/ui")
    t.equal(other.len, 4)
    t.is_true(text.starts_with(other[3], "h1:"))
    let lines = text.lines(read(t, "{dir}/{compiler.lock_file}"))
    t.is_true(lines[0] < lines[1])
    sync(t, dir, true)
    let again = lock_entry(t, dir, "example.com/color")
    t.equal(again[3], color_v1_hash)
}

fn test_edited_hash_fails_when_the_tree_is_fetched(t: *testing.T) {
    let r = remote(t) ?? return
    defer file.remove_all(r.dir) or {}
    publish(r, t, color("v1.0.0", "red 1.0"))
    publish(r, t, ui("v0.4.2", "^1.0"))
    let dir = app(r, t, "^0.4")
    sync(t, dir, false)
    let lock_path = "{dir}/{compiler.lock_file}"
    let edited = text.replace(read(t, lock_path), color_v1_hash, "h1:AAAA")
    write(t, lock_path, edited)
    let fresh = "{r.dir}/fresh"
    use_cache(t, fresh)
    let got = sync_error(t, dir, false)
    t.is_true(text.contains(got, "example.com/color v1.0.0"))
    t.is_true(text.contains(got, "build.lock holds h1:AAAA"))
    t.is_true(text.contains(got, color_v1_hash))
    let held = lock_entry(t, dir, "example.com/color")
    let rejected = compiler.cached_dir(fresh, "example.com/color", held[2])
    t.is_false(file.is_dir(rejected))
}

fn test_moved_tag_fails_update(t: *testing.T) {
    let r = remote(t) ?? return
    defer file.remove_all(r.dir) or {}
    publish(r, t, color("v1.0.0", "red 1.0"))
    publish(r, t, ui("v0.4.2", "^1.0"))
    let dir = app(r, t, "^0.4")
    sync(t, dir, false)
    let held = lock_entry(t, dir, "example.com/color")
    let old = held[2]
    publish(r, t, color("v1.0.0", "red moved"))
    sync(t, dir, false)
    let got = sync_error(t, dir, true)
    t.is_true(text.contains(got, "example.com/color: tag v1.0.0 moved from {old} to "))
    let kept = lock_entry(t, dir, "example.com/color")
    t.equal(kept[2], old)
}

fn test_projects_share_one_cache_tree(t: *testing.T) {
    let r = remote(t) ?? return
    defer file.remove_all(r.dir) or {}
    publish(r, t, color("v1.0.0", "red 1.0"))
    publish(r, t, ui("v0.4.2", "^1.0"))
    let first = app(r, t, "^0.4")
    sync(t, first, false)
    let second = app_at(t, "{r.dir}/other", "^0.4")
    let lock = read(t, "{first}/{compiler.lock_file}")
    write(t, "{second}/{compiler.lock_file}", lock)
    file.remove_all("{r.dir}/repos") or {}
    sync(t, second, false)
    t.equal(read(t, "{second}/{compiler.lock_file}"), lock)
    let trees = file.list("{r.cache}/deps/example.com") catch {
        e => {
            t.fatal("list the cache: {testing.format(e)}")
            return
        }
    }
    t.equal(trees.len, 2)
    for name in trees {
        t.is_false(text.contains(name, ".tmp-"))
    }
    let mirrors = file.list("{r.cache}/git/example.com") catch {
        e => {
            t.fatal("list the mirrors: {testing.format(e)}")
            return
        }
    }
    t.equal(mirrors.len, 2)
    t.is_true(file.is_dir(cached(r, t, second, "example.com/ui")))
}

fn test_missing_cache_is_an_error(t: *testing.T) {
    let r = remote(t) ?? return
    defer file.remove_all(r.dir) or {}
    publish(r, t, color("v1.0.0", "red 1.0"))
    publish(r, t, ui("v0.4.2", "^1.0"))
    let dir = app(r, t, "^0.4")
    sync(t, dir, false)
    use_cache(t, "")
    os.unset_env("XDG_CACHE_HOME") or {}
    os.unset_env("HOME") or {}
    let got = sync_error(t, dir, true)
    t.is_true(text.contains(got, "there is no module cache"))
}

fn test_source_must_be_a_repository_path(t: *testing.T) {
    let r = remote(t) ?? return
    defer file.remove_all(r.dir) or {}
    let dir = "{r.dir}/app"
    for source in ["example.com/../ui", "example.com//ui", "example.com:8080/ui", "example.com/ui@v1", "example.com\\\\ui"] {
        write(t, "{dir}/build.low", "import std/build\n\nbuild.dep(\"{source}\", \"^1\")\n")
        let got = sync_error(t, dir, false)
        t.is_true(text.contains(got, "is not a repository path such as github.com/acme/ui"))
    }
}

fn test_symbolic_link_in_a_tagged_tree_is_refused(t: *testing.T) {
    let r = remote(t) ?? return
    defer file.remove_all(r.dir) or {}
    let release = Release { name: "ui", version: "v1.0.0", body: "pub const label = \"blue\"\n", manifest: "import std/build\n", link: "alias.low" }
    publish(r, t, release)
    let dir = app(r, t, "^1")
    let got = sync_error(t, dir, false)
    t.is_true(text.contains(got, "example.com/ui v1.0.0: alias.low is a symbolic link"))
    let left = file.list("{r.cache}/deps/example.com") catch {
        e => {
            t.fatal("list the cache: {testing.format(e)}")
            return
        }
    }
    t.equal(left.len, 0)
}
