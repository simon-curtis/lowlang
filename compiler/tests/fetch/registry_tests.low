import compiler
import fetch
import native
import target
import std/file
import std/git
import std/os
import std/testing
import std/text

const source = "example.com/color"

fn index_dir(r: Remote) -> str {
    "{r.dir}/index"
}

fn open_index(r: Remote, t: *testing.T) {
    git.init(index_dir(r), false) catch {
        e => {
            t.fatal("init the index: {git.message(e)}")
            return
        }
    }
    os.set_env("LOW_INDEX", index_dir(r)) catch {
        e => t.fatal("set LOW_INDEX: {testing.format(e)}")
    }
}

fn index_file(r: Remote, t: *testing.T) -> str {
    read(t, "{index_dir(r)}/{source}")
}

fn commit_of(r: Remote, t: *testing.T, name: str, version: str) -> str {
    let location = "{r.dir}/repos/example.com/{name}"
    let repo = git.open(location) catch {
        e => {
            t.fatal("open {location}: {git.message(e)}")
            return ""
        }
    }
    git.resolve(repo, "{version}^{{commit}}") catch {
        e => {
            t.fatal("resolve {version}: {git.message(e)}")
            ""
        }
    }
}

fn index_log(r: Remote, t: *testing.T) -> str {
    let repo = git.open(index_dir(r)) catch {
        e => {
            t.fatal("open the index: {git.message(e)}")
            return ""
        }
    }
    var subjects: []str = []
    var id = git.head(repo) or ""
    for id != "" {
        let c = git.read_commit(repo, id) catch {
            e => {
                t.fatal("read {id}: {git.message(e)}")
                return ""
            }
        }
        subjects.push(text.lines(c.message)[0])
        id = if c.parents.len == 0 { "" } else { c.parents[0] }
    }
    text.join(subjects, "\n")
}

fn index_publish(t: *testing.T, version: str) {
    let docs = native.overlay()
    fetch.publish(docs, source, version) catch {
        e => {
            t.fatal("publish {version}: {fetch.message(e)}")
            return
        }
    }
}

fn index_yank(t: *testing.T, version: str, undo: bool) {
    let docs = native.overlay()
    fetch.yank(docs, source, version, undo) catch {
        e => {
            t.fatal("yank {version}: {fetch.message(e)}")
            return
        }
    }
}

fn publish_error(t: *testing.T, name: str, version: str) -> str {
    let docs = native.overlay()
    fetch.publish(docs, name, version) catch {
        e => return fetch.message(e)
    }
    t.error("publish {name} {version} succeeded")
    ""
}

fn yank_error(t: *testing.T, version: str, undo: bool) -> str {
    let docs = native.overlay()
    fetch.yank(docs, source, version, undo) catch {
        e => return fetch.message(e)
    }
    t.error("yank {version} succeeded")
    ""
}

fn color_app(t: *testing.T, dir: str, range: str) -> str {
    write(t, "{dir}/build.low", "import std/build\n\nbuild.dep(\"{source}\", \"{range}\")\n")
    dir
}

fn sync_warnings(t: *testing.T, dir: str, update: bool) -> str[] {
    let docs = native.overlay()
    fetch.sync(docs, dir, update) catch {
        e => {
            t.fatal("sync: {fetch.message(e)}")
            return []
        }
    }
}

fn test_publish_records_tag_commit_and_hash(t: *testing.T) {
    let r = remote(t) ?? return
    defer file.remove_all(r.dir) or {}
    open_index(r, t)
    publish(r, t, color("v1.0.0", "red 1.0"))
    index_publish(t, "1.0.0")
    let commit = commit_of(r, t, "color", "v1.0.0")
    let _ = t.equal(index_file(r, t), "v1.0.0 {commit} {color_v1_hash}\n")
    t.equal(index_log(r, t), "publish {source} v1.0.0")
}

fn test_published_version_never_changes(t: *testing.T) {
    let r = remote(t) ?? return
    defer file.remove_all(r.dir) or {}
    open_index(r, t)
    publish(r, t, color("v1.0.0", "red 1.0"))
    index_publish(t, "v1.0.0")
    let before = index_file(r, t)
    publish(r, t, color("v1.0.0", "red moved"))
    let got = publish_error(t, source, "1.0.0")
    let _ = t.is_true(text.contains(got, "{source} v1.0.0 is already in the package index"))
    let _ = t.equal(index_file(r, t), before)
    t.equal(index_log(r, t), "publish {source} v1.0.0")
}

fn test_publish_refuses_a_tree_that_does_not_build(t: *testing.T) {
    let r = remote(t) ?? return
    defer file.remove_all(r.dir) or {}
    open_index(r, t)
    publish(r, t, Release { name: "color", version: "v1.0.0", body: "pub const name = missing\n", manifest: "import std/build\n" })
    let got = publish_error(t, source, "v1.0.0")
    let _ = t.is_true(text.contains(got, "{source} v1.0.0: . does not build"))
    t.is_false(file.exists("{index_dir(r)}/{source}"))
}

fn test_publish_refuses_a_tag_that_is_not_pushed_and_a_wrong_declared_version(t: *testing.T) {
    let r = remote(t) ?? return
    defer file.remove_all(r.dir) or {}
    open_index(r, t)
    let manifest = "import std/build\n\nbuild.version(\"0.9.0\")\n"
    publish(r, t, Release { name: "color", version: "v1.0.0", body: "pub const name = \"red\"\n", manifest })
    let _ = t.is_true(text.contains(publish_error(t, source, "v1.0.0"), "{source} v1.0.0: build.low declares version 0.9.0"))
    let _ = t.is_true(text.contains(publish_error(t, source, "v2.0.0"), "{source} has no tag for version 2.0.0"))
    let _ = t.is_true(text.contains(publish_error(t, "example.com/../color", "v1.0.0"), "is not a repository path"))
    let _ = t.is_true(text.contains(publish_error(t, "example.com/.git/hooks", "v1.0.0"), "is not a repository path"))
    t.is_false(file.exists("{index_dir(r)}/{source}"))
}

fn test_yank_flips_only_the_flag(t: *testing.T) {
    let r = remote(t) ?? return
    defer file.remove_all(r.dir) or {}
    open_index(r, t)
    publish(r, t, color("v1.0.0", "red 1.0"))
    publish(r, t, color("v1.1.0", "red 1.1"))
    index_publish(t, "v1.0.0")
    index_publish(t, "v1.1.0")
    let published = index_file(r, t)
    let lines = text.lines(published)
    index_yank(t, "1.0.0", false)
    let _ = t.equal(index_file(r, t), "{lines[0]} yanked\n{lines[1]}\n")
    let _ = t.is_true(text.contains(yank_error(t, "v1.0.0", false), "{source} v1.0.0 is already yanked"))
    index_yank(t, "v1.0.0", true)
    let _ = t.equal(index_file(r, t), published)
    let _ = t.is_true(text.contains(yank_error(t, "v1.0.0", true), "{source} v1.0.0 is not yanked"))
    let _ = t.is_true(text.contains(yank_error(t, "v3.0.0", false), "{source} v3.0.0 is not in the package index"))
    t.equal(index_log(r, t), "unyank {source} v1.0.0\nyank {source} v1.0.0\npublish {source} v1.1.0\npublish {source} v1.0.0")
}

fn test_resolution_takes_versions_from_the_index(t: *testing.T) {
    let r = remote(t) ?? return
    defer file.remove_all(r.dir) or {}
    open_index(r, t)
    publish(r, t, color("v1.0.0", "red 1.0"))
    index_publish(t, "v1.0.0")
    publish(r, t, color("v1.1.0", "red 1.1"))
    publish(r, t, ui("v0.4.2", "^1.0"))
    let dir = app(r, t, "^0.4")
    sync(t, dir, false)
    let _ = t.equal(versions(t, dir), "{source} v1.0.0, example.com/ui v0.4.2")
    let held = lock_entry(t, dir, source)
    let _ = t.equal(held[2], commit_of(r, t, "color", "v1.0.0"))
    let _ = t.equal(held[3], color_v1_hash)
    index_publish(t, "v1.1.0")
    sync(t, dir, false)
    let _ = t.equal(versions(t, dir), "{source} v1.0.0, example.com/ui v0.4.2")
    sync(t, dir, true)
    t.equal(versions(t, dir), "{source} v1.1.0, example.com/ui v0.4.2")
}

fn test_yanked_version_is_skipped_and_still_builds_where_locked(t: *testing.T) {
    let r = remote(t) ?? return
    defer file.remove_all(r.dir) or {}
    open_index(r, t)
    publish(r, t, color("v1.0.0", "red 1.0"))
    index_publish(t, "v1.0.0")
    publish(r, t, color("v1.1.0", "red 1.1"))
    index_publish(t, "v1.1.0")
    let dir = color_app(t, "{r.dir}/app", "^1")
    let _ = t.equal(sync_warnings(t, dir, false).len, 0)
    let _ = t.equal(versions(t, dir), "{source} v1.1.0")
    index_yank(t, "v1.1.0", false)
    let warnings = sync_warnings(t, dir, false)
    let _ = t.equal(warnings.len, 1)
    let _ = t.is_true(text.contains(warnings[0], "{source} v1.1.0 is yanked"))
    let _ = t.equal(versions(t, dir), "{source} v1.1.0")
    let fresh = color_app(t, "{r.dir}/fresh", "^1")
    let _ = t.equal(sync_warnings(t, fresh, false).len, 0)
    let _ = t.equal(versions(t, fresh), "{source} v1.0.0")
    let _ = t.equal(sync_warnings(t, dir, true).len, 0)
    t.equal(versions(t, dir), "{source} v1.0.0")
}

fn test_range_of_yanked_versions_names_them(t: *testing.T) {
    let r = remote(t) ?? return
    defer file.remove_all(r.dir) or {}
    open_index(r, t)
    publish(r, t, color("v1.0.0", "red 1.0"))
    index_publish(t, "v1.0.0")
    index_yank(t, "v1.0.0", false)
    let dir = color_app(t, "{r.dir}/app", "^1")
    let got = sync_error(t, dir, false)
    let _ = t.is_true(text.contains(got, "no tagged version of {source} satisfies ^1 at"))
    t.is_true(text.contains(got, "; yanked: v1.0.0"))
}

fn test_index_hash_is_checked_when_a_tree_is_fetched(t: *testing.T) {
    let r = remote(t) ?? return
    defer file.remove_all(r.dir) or {}
    open_index(r, t)
    publish(r, t, color("v1.0.0", "red 1.0"))
    index_publish(t, "v1.0.0")
    let location = "{index_dir(r)}/{source}"
    write(t, location, text.replace(read(t, location), color_v1_hash, "h1:AAAA"))
    let dir = color_app(t, "{r.dir}/app", "^1")
    let got = sync_error(t, dir, false)
    let _ = t.is_true(text.contains(got, "{source} v1.0.0: the package index holds h1:AAAA but the fetched tree hashes to {color_v1_hash}"))
    t.is_false(file.exists("{dir}/{compiler.lock_file}"))
}

fn test_locked_version_that_the_index_changed_fails(t: *testing.T) {
    let r = remote(t) ?? return
    defer file.remove_all(r.dir) or {}
    open_index(r, t)
    publish(r, t, color("v1.0.0", "red 1.0"))
    index_publish(t, "v1.0.0")
    let dir = color_app(t, "{r.dir}/app", "^1")
    sync(t, dir, false)
    let location = "{index_dir(r)}/{source}"
    write(t, location, text.replace(read(t, location), color_v1_hash, "h1:AAAA"))
    let got = sync_error(t, dir, false)
    t.is_true(text.contains(got, "{source}: v1.0.0 has the hash h1:AAAA in the package index and {color_v1_hash} in build.lock"))
}

fn module_paths(release: fetch.Release) -> str {
    var paths: str[] = []
    for m in release.modules {
        paths.push(m.path)
    }
    text.join(paths, ", ")
}

fn indexed_packages(t: *testing.T) -> fetch.Package[] {
    fetch.document_index(native.overlay(), target.host()) catch {
        e => {
            t.fatal("document_index: {fetch.message(e)}")
            return []
        }
    }
}

fn test_document_index_lists_every_version_newest_first_with_yanked_marked(t: *testing.T) {
    let r = remote(t) ?? return
    defer file.remove_all(r.dir) or {}
    open_index(r, t)
    publish(r, t, color("v1.0.0", "red 1.0"))
    index_publish(t, "v1.0.0")
    write(t, "{r.dir}/src/color/label/label.low", "/// Labels a shade.\npub fn label(shade: str) -> str {{\n    shade\n}}\n")
    write(t, "{r.dir}/src/color/testdata/shade/shade.low", "pub const hidden = 1\n")
    write(t, "{r.dir}/src/color/_scratch/scratch.low", "pub const hidden = 1\n")
    write(t, "{r.dir}/src/color/examples/red.low", "import example.com/color\n\nfn main() {{\n    print(color.name)\n}}\n")
    write(t, "{r.dir}/src/color/examples/red.out", "red 1.1\n")
    publish(r, t, color("v1.1.0", "red 1.1"))
    index_publish(t, "v1.1.0")
    index_yank(t, "v1.0.0", false)
    write(t, "{index_dir(r)}/README.md", "not a package\n")
    let found = indexed_packages(t)
    let _ = t.equal(found.len, 1)
    let _ = t.equal(found[0].source, source)
    let releases = found[0].releases
    let _ = t.equal(releases.len, 2)
    let _ = t.equal(releases[0].tag, "v1.1.0")
    let _ = t.equal(releases[0].commit, commit_of(r, t, "color", "v1.1.0"))
    let _ = t.equal(releases[0].hash, text.fields(text.lines(index_file(r, t))[1])[2])
    let _ = t.is_false(releases[0].yanked)
    let _ = t.equal(module_paths(releases[0]), "{source}, {source}/label")
    let _ = t.equal(releases[0].modules[0].items[0].name, "name")
    let _ = t.equal(releases[0].modules[0].examples[0].output, "red 1.1\n")
    let _ = t.equal(releases[0].modules[1].items[0].doc, "Labels a shade.")
    let _ = t.equal(releases[1].tag, "v1.0.0")
    let _ = t.is_true(releases[1].yanked)
    let _ = t.equal(module_paths(releases[1]), source)
    t.equal(releases[1].modules[0].items[0].name, "name")
}

fn test_document_index_names_modules_by_the_modules_directory(t: *testing.T) {
    let r = remote(t) ?? return
    defer file.remove_all(r.dir) or {}
    open_index(r, t)
    write(t, "{r.dir}/src/color/src/shade/shade.low", "pub const dark = 1\n")
    write(t, "{r.dir}/src/color/src/color.low", "pub const name = \"red\"\n")
    publish(r, t, Release { name: "color", version: "v1.0.0", body: "pub const outside = 1\n", manifest: "import std/build\n\nbuild.modules(\"src\")\n" })
    index_publish(t, "v1.0.0")
    let found = indexed_packages(t)
    let _ = t.equal(found.len, 1)
    t.equal(module_paths(found[0].releases[0]), "{source}, {source}/shade")
}

fn test_document_index_lists_nothing_without_an_index(t: *testing.T) {
    let r = remote(t) ?? return
    defer file.remove_all(r.dir) or {}
    let _ = t.equal(indexed_packages(t).len, 0)
    os.set_env("LOW_INDEX", "{r.dir}/absent") catch {
        e => t.fatal("set LOW_INDEX: {testing.format(e)}")
    }
    let _ = t.equal(indexed_packages(t).len, 0)
    open_index(r, t)
    t.equal(indexed_packages(t).len, 0)
}
