import std/testing

fn main() {
    let tests = [
        testing.Test { name: "ResolvesPinsAndUpdates", run: test_resolves_pins_and_updates }
        testing.Test { name: "UnsatisfiableRangeNamesEveryWant", run: test_unsatisfiable_range_names_every_want }
        testing.Test { name: "LockLineHoldsSourceVersionCommitAndHash", run: test_lock_line_holds_source_version_commit_and_hash }
        testing.Test { name: "EditedHashFailsWhenTheTreeIsFetched", run: test_edited_hash_fails_when_the_tree_is_fetched }
        testing.Test { name: "MovedTagFailsUpdate", run: test_moved_tag_fails_update }
        testing.Test { name: "ProjectsShareOneCacheTree", run: test_projects_share_one_cache_tree }
        testing.Test { name: "MissingCacheIsAnError", run: test_missing_cache_is_an_error }
        testing.Test { name: "SourceMustBeARepositoryPath", run: test_source_must_be_a_repository_path }
        testing.Test { name: "SymbolicLinkInATaggedTreeIsRefused", run: test_symbolic_link_in_a_tagged_tree_is_refused }
        testing.Test { name: "PublishRecordsTagCommitAndHash", run: test_publish_records_tag_commit_and_hash }
        testing.Test { name: "PublishedVersionNeverChanges", run: test_published_version_never_changes }
        testing.Test { name: "PublishRefusesATreeThatDoesNotBuild", run: test_publish_refuses_a_tree_that_does_not_build }
        testing.Test { name: "PublishRefusesAnUnpushedTagAndAWrongDeclaredVersion", run: test_publish_refuses_a_tag_that_is_not_pushed_and_a_wrong_declared_version }
        testing.Test { name: "YankFlipsOnlyTheFlag", run: test_yank_flips_only_the_flag }
        testing.Test { name: "ResolutionTakesVersionsFromTheIndex", run: test_resolution_takes_versions_from_the_index }
        testing.Test { name: "YankedVersionIsSkippedAndStillBuildsWhereLocked", run: test_yanked_version_is_skipped_and_still_builds_where_locked }
        testing.Test { name: "RangeOfYankedVersionsNamesThem", run: test_range_of_yanked_versions_names_them }
        testing.Test { name: "IndexHashIsCheckedWhenATreeIsFetched", run: test_index_hash_is_checked_when_a_tree_is_fetched }
        testing.Test { name: "LockedVersionThatTheIndexChangedFails", run: test_locked_version_that_the_index_changed_fails }
        testing.Test { name: "DocumentIndexListsEveryVersionNewestFirstWithYankedMarked", run: test_document_index_lists_every_version_newest_first_with_yanked_marked }
        testing.Test { name: "DocumentIndexNamesModulesByTheModulesDirectory", run: test_document_index_names_modules_by_the_modules_directory }
        testing.Test { name: "DocumentIndexListsNothingWithoutAnIndex", run: test_document_index_lists_nothing_without_an_index }
    ]
    testing.run(tests)
}
