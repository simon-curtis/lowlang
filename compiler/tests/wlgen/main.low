import gentest
import std/file
import std/os
import std/testing
import std/text
import target
import wlgen

const checked_in = "internal/compiler/std/ui/platform/wayland_linux.low"
const regenerate = "wlgen -o internal/compiler/std/ui/platform/wayland_linux.low internal/wlgen/protocols/wayland.xml internal/wlgen/protocols/xdg-shell.xml"

fn load_protocols(t: *testing.T, names: []str) -> []wlgen.Protocol {
    var protocols: []wlgen.Protocol = []
    for name in names {
        let data = file.read_file("internal/wlgen/protocols/{name}") catch {
            e => {
                t.fatal("{name}: {e}")
                return protocols
            }
        }
        let protocol = wlgen.parse(data) catch {
            Failed(message) => {
                t.fatal("{name}: {message}")
                return protocols
            }
        }
        push(mut protocols, protocol)
    }
    protocols
}

fn failure_of(t: *testing.T, protocols: []wlgen.Protocol) -> str {
    wlgen.generate(protocols) catch {
        Failed(message) => return message
    }
    t.fatal("generate succeeded")
    ""
}

struct SignatureCase {
    message: wlgen.Message
    code: str
    types: str
}

fn signature_cases() -> []SignatureCase {
    [
        SignatureCase {
            message: wlgen.Message { args: [wlgen.Arg { kind: "uint" }, wlgen.Arg { kind: "new_id" }] }
            code: "usun"
            types: "null null null null"
        }
        SignatureCase {
            message: wlgen.Message { since: 3, args: [wlgen.Arg { kind: "object", interface_name: "wl_surface", allow_null: true }, wlgen.Arg { kind: "fixed" }] }
            code: "3?of"
            types: "ifs.wl_surface null"
        }
        SignatureCase {
            message: wlgen.Message { args: [wlgen.Arg { kind: "new_id", interface_name: "wl_callback" }, wlgen.Arg { kind: "fd" }, wlgen.Arg { kind: "array" }, wlgen.Arg { kind: "string" }] }
            code: "nhas"
            types: "ifs.wl_callback null null null"
        }
    ]
}

fn test_signatures(t: *testing.T) {
    for c in signature_cases() {
        let got = wlgen.signature(c.message)
        let types = text.join(got.types, " ")
        if got.code != c.code || types != c.types {
            t.error("signature = {text.quote(got.code)} {text.quote(types)}, want {text.quote(c.code)} {text.quote(c.types)}")
        }
    }
}

fn test_rejects_unknown_references(t: *testing.T) {
    let protocols = load_protocols(t, ["xdg-shell.xml"])
    let message = failure_of(t, protocols)
    t.contains(message, "refers to interface wl_surface")
}

fn test_rejects_duplicates(t: *testing.T) {
    let protocols = load_protocols(t, ["wayland.xml", "wayland.xml"])
    let message = failure_of(t, protocols)
    t.contains(message, "declared twice")
}

fn generated(t: *testing.T) -> str {
    let protocols = load_protocols(t, ["wayland.xml", "xdg-shell.xml"])
    wlgen.generate(protocols) catch {
        Failed(message) => {
            t.fatal(message)
            return ""
        }
    }
}

fn test_checked_in_bindings(t: *testing.T) {
    let source = generated(t)
    let got = file.read_text(checked_in) catch {
        e => {
            t.fatal("{e}; run {regenerate}")
            return
        }
    }
    if got != source {
        t.error("{checked_in} differs from the generator output; run {regenerate}")
    }
}

fn test_bindings_are_private(t: *testing.T) {
    if text.contains(generated(t), "pub ") {
        t.error("generated bindings declare pub items")
    }
}

fn test_registry(t: *testing.T) {
    if !gentest.library_available("wayland-client") {
        t.skip("libwayland-client is not available")
        return
    }
    let source = file.read_text(checked_in) catch {
        e => {
            t.fatal("{checked_in}: {e}")
            return
        }
    }
    let program = file.read_text("internal/wlgen/testdata/registry.low") catch {
        e => {
            t.fatal("registry.low: {e}")
            return
        }
    }
    let dir = file.temp_dir("wlgen") catch {
        e => {
            t.fatal("{e}")
            return
        }
    }
    defer file.remove_all(dir) or {}
    let files = [
        gentest.Program { file: "wayland_linux.low", contents: bytes(source) }
        gentest.Program { file: "main.low", contents: bytes(program) }
    ]
    let binary = gentest.build_directory(t, dir, files, target.OS.Linux)
    let display = os.env("WAYLAND_DISPLAY") ?? ""
    if display == "" {
        t.skip("no Wayland compositor to connect to")
        return
    }
    let got = gentest.run_binary(t, binary)
    let want = "true\ntrue\ntrue\ntrue\n1\n"
    if got != want {
        t.error("output:\n{got}\nwant:\n{want}")
    }
}

fn main() {
    testing.run([
        testing.Test { name: "signatures", run: test_signatures }
        testing.Test { name: "rejects_unknown_references", run: test_rejects_unknown_references }
        testing.Test { name: "rejects_duplicates", run: test_rejects_duplicates }
        testing.Test { name: "checked_in_bindings", run: test_checked_in_bindings }
        testing.Test { name: "bindings_are_private", run: test_bindings_are_private }
        testing.Test { name: "registry", run: test_registry }
    ])
}
