import compiler
import target
import std/os
import std/testing

const bench_variable = "LOW_BENCH"
const bench_target_ms = 1000

fn compile_for(t: *testing.T, program: Program, rounds: i64) {
    for round in 0..rounds {
        let unit = compiler.analyse(program.path, compiler.release(target.OS.Linux)) catch {
            e => {
                t.fatal(compiler.message(e))
                return
            }
        }
        compiler.generate(unit) catch {
            e => {
                t.fatal(compiler.message(e))
                return
            }
        }
    }
}

fn program_name(p: Program) -> str {
    p.name
}

fn bench_body(t: *testing.T, p: Program) {
    let result = testing.bench_for(p.name, fn(rounds: i64) { compile_for(t, p, rounds) }, bench_target_ms)
    t.log(testing.describe(result))
}

fn test_compile_bench(t: *testing.T) {
    if os.env(bench_variable) == none {
        t.skip("benchmarks run when {bench_variable} is set")
        return
    }
    let programs = bench_programs()
    if programs.len == 0 {
        t.fatal("no benchmark programs")
        return
    }
    t.table_of(programs, program_name, bench_body)
}
