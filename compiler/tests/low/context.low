import std/file
import std/testing
import std/text

const context_project = "compiler/tests/low/testdata"

fn context_of(t: *testing.T, c: Commands, args: []str) -> str {
    let first = t.invoke(c, [:], context_project, args)
    let second = t.invoke(c, [:], context_project, args)
    t.equal(first.err, "")
    t.equal(first.status, 0)
    t.equal(second.out, first.out)
    first.out
}

fn headings(out: str) -> []str {
    var found: []str = []
    for line in text.lines(out) {
        let rest = text.strip_prefix(line, "// ") ?? continue
        for kind in ["fn ", "struct ", "enum ", "const ", "constraint "] {
            if text.starts_with(rest, kind) {
                found.push(text.split_str(rest, "  ")[0])
                break
            }
        }
    }
    found
}

fn test_context_lists_what_a_function_uses(t: *testing.T, shared: *SharedLow) {
    let c = t.new_commands(shared)
    defer file.remove_all(c.dir) or {}
    if t.failed() {
        return
    }
    let out = t.context_of(c, ["context", "app.describe"])
    t.equal(text.join(headings(out), ", "), "fn app.describe, struct shapes.Point, enum shapes.Shade, fn shapes.largest, fn std/text.join, fn shapes.area")
    t.is_true(text.contains(out, "    text.join([\"{{p.area()}}\", \"{{wide}}\", shade], \" \")\n}}\n"))
    t.is_true(text.contains(out, "\n// imports of app/app.low\nimport shapes\nimport std/text\n"))
    t.is_true(text.contains(out, "\npub fn largest[T: Ord](a: T, b: T) -> T\n"))
    let call = t.context_of(c, ["context", "app/app.low:5:24"])
    t.equal(text.join(headings(call), ", "), "fn shapes.largest, constraint Ord")
    let field = t.context_of(c, ["context", "app/app.low:5:33"])
    t.equal(text.join(headings(field), ", "), "struct shapes.Point.x")
}

fn test_context_follows_references_to_a_depth(t: *testing.T, shared: *SharedLow) {
    let c = t.new_commands(shared)
    defer file.remove_all(c.dir) or {}
    if t.failed() {
        return
    }
    let out = t.context_of(c, ["context", "--depth", "3", "app.total"])
    t.equal(text.join(headings(out), ", "), "fn app.total, struct shapes.Point, fn shapes.largest, fn shapes.area, constraint Ord, fn shapes.scale, const shapes.unit")
    t.is_true(text.contains(out, "\n// uses at depth 3\n"))
}

fn test_context_budget_cuts_the_deepest_level_first(t: *testing.T, shared: *SharedLow) {
    let c = t.new_commands(shared)
    defer file.remove_all(c.dir) or {}
    if t.failed() {
        return
    }
    let full = t.context_of(c, ["context", "--depth", "3", "app.total"])
    let budget = full.len / 4 - 5
    let out = t.context_of(c, ["context", "--depth", "3", "--budget", "{budget}", "app.total"])
    t.equal(text.join(headings(out), ", "), "fn app.total, struct shapes.Point, fn shapes.largest, fn shapes.area, constraint Ord, fn shapes.scale")
    t.is_true(text.ends_with(out, "\n// cut by --budget {budget}\nconst shapes.unit\n"))
    t.is_true(out.len <= budget * 4)
}

fn test_context_lists_callers(t: *testing.T, shared: *SharedLow) {
    let c = t.new_commands(shared)
    defer file.remove_all(c.dir) or {}
    if t.failed() {
        return
    }
    let out = t.context_of(c, ["context", "--callers", "app.describe"])
    t.is_true(text.ends_with(out, "\n// callers\napp/app.low:18  fn caller() -> str\n"))
    let refs = t.context_of(c, ["refs", "shapes.area"])
    t.equal(refs, "app/app.low:10:20: text.join([\"{{p.area()}}\", \"{{wide}}\", shade], \" \")\napp/app.low:14:22: shapes.largest(p.area(), 0)\n")
    let fields = t.context_of(c, ["refs", "shapes.Point.x"])
    t.equal(fields, "app/app.low:5:33: let wide = shapes.largest(p.x, p.y)\napp/app.low:18:29: describe(shapes.Point {{ x: 1, y: 2 }}, shapes.Shade.Dark)\nshapes/shapes.low:24:13: scale(p.x) * p.y\n")
}

fn test_context_json_has_one_object_per_line(t: *testing.T, shared: *SharedLow) {
    let c = t.new_commands(shared)
    defer file.remove_all(c.dir) or {}
    if t.failed() {
        return
    }
    let out = t.context_of(c, ["context", "--json", "--callers", "app.describe"])
    var kinds: []str = []
    for line in text.lines(out) {
        t.is_true(text.starts_with(line, "{{\"kind\":\"") && text.ends_with(line, "}}"))
        kinds.push(text.split(line, '"')[3])
    }
    t.equal(text.join(kinds, ", "), "definition, import, import, use, use, use, use, use, caller")
    t.is_true(text.contains(out, "{{\"kind\":\"use\",\"depth\":1,\"item\":\"fn\",\"name\":\"shapes.area\",\"file\":\"shapes/shapes.low\",\"line\":23,\"text\":\"pub fn area(p: Point) -> i64\"}}\n"))
}
