import native
import target
import std/file
import std/os
import std/process
import std/testing
import std/text

const greeting_source = "fn main() {{\n    print(\"hello\")\n}}\n"
const install_manifest = "import std/build\n\nbuild.install(\"app\")\n"

struct Installing {
    low: str
    project: str
    bin: str
}

fn install_workspace(t: *testing.T, dir: str) -> Installing {
    let low = build_low(t, dir, native.overlay())
    let project = file.child_path(dir, "project")
    let app = file.child_path(project, "app")
    file.mkdir_all(app) catch {
        e => t.fatal("create {app}: {e}")
    }
    let manifest = file.child_path(project, "build.low")
    file.write_text(manifest, install_manifest) catch {
        e => t.fatal("write {manifest}: {e}")
    }
    let source = file.child_path(app, "main.low")
    file.write_text(source, greeting_source) catch {
        e => t.fatal("write {source}: {e}")
    }
    Installing { low, project, bin: file.child_path(dir, "bin") }
}

fn run_install(t: *testing.T, w: Installing, dir: str) {
    var env = os.environment()
    env["LOW_BIN"] = w.bin
    var command = process.command(w.low, ["install", dir])
    command.env = env
    let result = process.run(command, []) catch {
        e => {
            t.fatal("{w.low} install: {e}")
            return
        }
    }
    if !process.success(result.status) {
        t.fatal("low install {dir}: {str(result.stderr)}")
    }
}

fn installed_output(t: *testing.T, w: Installing) -> str {
    let program = file.child_path(w.bin, target.executable(target.host(), "app"))
    let result = process.run(process.command(program, []), []) catch {
        e => {
            t.fatal("{program}: {e}")
            return ""
        }
    }
    text.trim(str(result.stdout))
}

fn test_install_builds_manifest_programs(t: *testing.T) {
    let dir = file.temp_dir("install-") catch {
        e => {
            t.fatal("{e}")
            return
        }
    }
    defer file.remove_all(dir) or {}
    let w = install_workspace(t, dir)
    if t.failed() {
        return
    }
    run_install(t, w, w.project)
    t.equal(installed_output(t, w), "hello")
    run_install(t, w, file.child_path(w.project, "app"))
    t.equal(installed_output(t, w), "hello")
}
