import native
import target
import std/file
import std/os
import std/process
import std/testing
import std/text

const greeting_source = "fn main() {{\n    print(\"hello\")\n}}\n"
const install_manifest = "import std/build\n\nbuild.install(\"app\")\n"

struct Installing {
    dir: str
    low: str
    project: str
    bin: str
}

fn install_workspace(t: *testing.T, dir: str) -> Installing {
    let low = build_low(t, dir, native.overlay())
    let project = file.child_path(dir, "project")
    let app = file.child_path(project, "app")
    file.mkdir_all(app) catch {
        e => t.fatal("create {app}: {e}")
    }
    let manifest = file.child_path(project, "build.low")
    file.write_text(manifest, install_manifest) catch {
        e => t.fatal("write {manifest}: {e}")
    }
    let source = file.child_path(app, "main.low")
    file.write_text(source, greeting_source) catch {
        e => t.fatal("write {source}: {e}")
    }
    Installing { dir, low, project, bin: file.child_path(dir, "bin") }
}

fn low_with_bin(t: *testing.T, w: Installing, args: []str) {
    var env = os.environment()
    env["LOW_BIN"] = w.bin
    var command = process.command(w.low, args)
    command.env = env
    let result = process.run(command, []) catch {
        e => {
            t.fatal("{w.low}: {e}")
            return
        }
    }
    if !process.success(result.status) {
        let joined = text.join(args, " ")
        t.fatal("low {joined}: {str(result.stderr)}")
    }
}

fn app_output(t: *testing.T, dir: str) -> str {
    let program = file.child_path(dir, target.executable(target.host(), "app"))
    let result = process.run(process.command(program, []), []) catch {
        e => {
            t.fatal("{program}: {e}")
            return ""
        }
    }
    text.trim(str(result.stdout))
}

fn new_install_workspace(t: *testing.T) -> Installing {
    let dir = file.temp_dir("install-") catch {
        e => {
            t.fatal("{e}")
            return Installing { dir: "", low: "", project: "", bin: "" }
        }
    }
    install_workspace(t, dir)
}

fn test_install_builds_manifest_programs(t: *testing.T) {
    let w = new_install_workspace(t)
    defer file.remove_all(w.dir) or {}
    if t.failed() {
        return
    }
    low_with_bin(t, w, ["install", w.project])
    t.equal(app_output(t, w.bin), "hello")
    low_with_bin(t, w, ["install", file.child_path(w.project, "app")])
    t.equal(app_output(t, w.bin), "hello")
}

fn test_build_writes_manifest_programs(t: *testing.T) {
    let w = new_install_workspace(t)
    defer file.remove_all(w.dir) or {}
    if t.failed() {
        return
    }
    let out = file.child_path(w.project, "out")
    low_with_bin(t, w, ["build", w.project, "-o", out])
    t.equal(app_output(t, out), "hello")
    t.is_false(file.exists(w.bin))
}
