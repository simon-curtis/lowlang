import compiler
import diag
import ir
import native
import target
import std/builder
import std/io
import std/os
import std/slices
import std/sync
import std/testing
import std/text

const browser_load_rejection = "browser/wasm32 has no "
const playground_entry = "compiler/playground"

struct Case {
    name: str
    path: str
    profile: compiler.Profile
}

struct Outcome {
    name: str
    problem: str
    skipped: bool = false
}

struct Compiled {
    ir: str
    asm: str
}

fn case_name(group: str, program: Program, platform: target.OS, mode: str) -> str {
    "{group}/{program.name}/{target.string(platform)}/{mode}"
}

fn release_case(group: str, program: Program, platform: target.OS) -> Case {
    Case { name: case_name(group, program, platform, "release"), path: program.path, profile: compiler.release(platform) }
}

fn dev_case(group: str, program: Program) -> Case {
    Case { name: case_name(group, program, target.OS.Linux, "dev"), path: program.path, profile: compiler.dev() }
}

fn determinism_cases() -> []Case ! io.Error {
    var cases: []Case = []
    for program in fixture_programs("testdata/run")? {
        push(mut cases, release_case("run", program, target.OS.Linux))
    }
    for program in bench_programs() {
        push(mut cases, release_case("bench", program, target.OS.Linux))
        push(mut cases, dev_case("bench", program))
        push(mut cases, release_case("bench", program, target.OS.Windows))
    }
    for program in fixture_programs("testdata/windows")? {
        push(mut cases, release_case("windows", program, target.OS.Windows))
    }
    cases
}

fn module_cases() -> []Case ! io.Error {
    var cases: []Case = []
    let programs = fixture_programs("testdata/run")?
    let examples = example_programs("std")?
    for program in slices.concat(programs, examples) {
        push(mut cases, release_case("module", program, target.OS.Browser))
    }
    let playground = Program { name: "playground", path: playground_entry }
    push(mut cases, release_case("module", playground, target.OS.Browser))
    cases
}

fn compile_once(c: Case) -> Compiled ! native.Error {
    let unit = native.analyse(c.path, c.profile)?
    let out = native.generate(unit)?
    let program = unit.program ?? panic("{c.path} analysed without a program")
    var text_out = builder.builder()
    for f in program.funcs {
        ir.write_func(mut text_out, f)
    }
    Compiled { ir: text_out.to_str(), asm: out.asm }
}

fn first_difference(a: str, b: str) -> str {
    let left = text.split(a, '\n')
    let right = text.split(b, '\n')
    let shared = if left.len < right.len { left.len } else { right.len }
    for i in 0..shared {
        if left[i] != right[i] {
            return "line {i + 1}: {diag.quote(left[i])} != {diag.quote(right[i])}"
        }
    }
    "lengths differ: {left.len} != {right.len} lines"
}

fn check_case(c: Case) -> str {
    let first = compile_once(c) catch {
        e => return native.message(e)
    }
    let second = compile_once(c) catch {
        e => return native.message(e)
    }
    if first.ir != second.ir {
        return "ir differs between compiles: {first_difference(first.ir, second.ir)}"
    }
    if first.asm != second.asm {
        return "assembly differs between compiles: {first_difference(first.asm, second.asm)}"
    }
    ""
}

fn rejected(e: native.Error) -> bool {
    match e {
        Wasm(inner) => true
        Front(inner) => text.contains(compiler.message(inner), browser_load_rejection)
        _ => false
    }
}

fn compile_module(c: Case) -> []u8 ! native.Error {
    let unit = native.analyse(c.path, c.profile)?
    native.module(unit)?
}

fn first_byte_difference(a: []u8, b: []u8) -> str {
    let shared = if a.len < b.len { a.len } else { b.len }
    for i in 0..shared {
        if a[i] != b[i] {
            return "byte {i}: {a[i]} != {b[i]}"
        }
    }
    "lengths differ: {a.len} != {b.len} bytes"
}

fn check_native_case(c: Case) -> Outcome {
    Outcome { name: c.name, problem: check_case(c) }
}

fn check_module_case(c: Case) -> Outcome {
    let first = compile_module(c) catch {
        e => {
            if rejected(e) {
                return Outcome { name: c.name, problem: "", skipped: true }
            }
            return Outcome { name: c.name, problem: native.message(e) }
        }
    }
    let second = compile_module(c) catch {
        e => return Outcome { name: c.name, problem: native.message(e) }
    }
    if !slices.equal(first, second) {
        let difference = first_byte_difference(first, second)
        return Outcome { name: c.name, problem: "module bytes differ between compiles: {difference}" }
    }
    Outcome { name: c.name, problem: "" }
}

fn check_parallel(check: fn(Case) -> Outcome, cases: []Case, index: i64, outcomes: []Outcome, permits: sync.Semaphore, group: sync.WaitGroup) {
    sync.acquire(permits)
    let c = cases[index]
    outcomes[index] = check(c)
    sync.release(permits)
    sync.done(group)
}

fn check_all(cases: []Case, check: fn(Case) -> Outcome) -> []Outcome {
    var outcomes: []Outcome = []
    for c in cases {
        push(mut outcomes, Outcome { name: c.name, problem: "" })
    }
    let group = sync.wait_group()
    let permits = sync.semaphore(os.cpu_count())
    for i in 0..cases.len {
        sync.add(group, 1)
        spawn check_parallel(check, cases, i, outcomes, permits, group)
    }
    sync.wait(group)
    outcomes
}

fn outcome_name(o: Outcome) -> str {
    o.name
}

fn outcome_body(t: *testing.T, o: Outcome) {
    if o.skipped {
        t.skip("the browser target rejects the program")
        return
    }
    if o.problem != "" {
        t.error(o.problem)
    }
}

fn test_compile_is_deterministic(t: *testing.T) {
    let cases = determinism_cases() catch {
        e => {
            t.fatal("{e}")
            return
        }
    }
    let outcomes = check_all(cases, check_native_case)
    t.table_of(outcomes, outcome_name, outcome_body)
}

fn test_browser_module_is_deterministic(t: *testing.T) {
    let cases = module_cases() catch {
        e => {
            t.fatal("{e}")
            return
        }
    }
    let outcomes = check_all(cases, check_module_case)
    t.table_of(outcomes, outcome_name, outcome_body)
}
