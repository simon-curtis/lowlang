import target
import std/file
import std/process
import std/testing
import std/text

const green_stack_bytes: i64 = 1048576

fn run_stderr(t: *testing.T, name: str) -> []str {
    let dir = file.temp_dir("fault-") catch {
        e => {
            t.fatal("{e}")
            return []
        }
    }
    defer file.remove_all(dir) or {}
    let host = target.host()
    let binary = file.child_path(dir, target.executable(host, "main"))
    build_host_binary(t, run_program(name).path, binary)
    if t.failed() {
        return []
    }
    let result = process.run(process.command(binary, []), []) catch {
        e => {
            t.fatal("{binary}: {e}")
            return []
        }
    }
    if process.success(result.status) {
        t.fatal("{name} exited without panicking")
        return []
    }
    text.lines(str(result.stderr))
}

fn hex_field(t: *testing.T, words: []str, at: i64, label: str) -> i64 {
    if words[at] != label {
        t.fatal("word {at} of the fault line is {words[at]}, want {label}")
        return 0
    }
    let value = words[at + 1]
    if !text.starts_with(value, "0x") || value.len != 18 {
        t.fatal("{label} {value} is not 0x and 16 hexadecimal digits")
        return 0
    }
    text.parse_radix(value[2..], 16) catch {
        _ => {
            t.fatal("{label} {value} is not hexadecimal")
            0
        }
    }
}

fn test_invalid_memory_access_reports_the_fault(t: *testing.T) {
    if target.host() != target.OS.Linux {
        t.skip("runs Linux binaries, which need a Linux host")
        return
    }
    let lines = run_stderr(t, "ptr_unused_null_load")
    if t.failed() {
        return
    }
    t.equal(lines.len, 2)
    if lines.len != 2 {
        return
    }
    t.equal(lines[1], "panic: invalid memory access")
    let words = text.split(lines[0], ' ')
    if words.len != 9 || words[0] != "fault:" {
        t.fatal("fault line {lines[0]} is not fault: followed by four labelled values")
        return
    }
    t.equal(hex_field(t, words, 1, "address"), 0)
    t.not_equal(hex_field(t, words, 3, "pc"), 0)
    let sp = hex_field(t, words, 5, "sp")
    let stack = hex_field(t, words, 7, "stack")
    t.is_true(sp >= stack && sp - stack < 2 * green_stack_bytes)
}

fn test_stack_overflow_has_no_fault_report(t: *testing.T) {
    if target.host() != target.OS.Linux {
        t.skip("runs Linux binaries, which need a Linux host")
        return
    }
    let lines = run_stderr(t, "overflow")
    if t.failed() {
        return
    }
    t.equal(lines.len, 1)
    t.equal(lines[0], "panic: stack overflow")
}
