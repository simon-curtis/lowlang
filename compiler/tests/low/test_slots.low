import std/file
import std/os
import std/path
import std/process
import std/testing
import std/time
import std/time/duration

const held_ms = 1500

struct Slotted {
    output: str
    ended: i64
}

fn hold_test_slots(t: *testing.T, dir: str, at: i64, count: i64, inner: fn()) {
    if at == count {
        inner()
        return
    }
    using slot = file.update(path.join([dir, "{at}"])) catch {
        e => {
            t.fatal("open slot {at}: {e}")
            return
        }
    }
    let locked = file.try_lock(slot, true) or false
    t.is_true(locked)
    hold_test_slots(t, dir, at + 1, count, inner)
}

fn slotted_run(r: Reused, finished: chan[Slotted]) {
    var env = os.environment()
    env["LOW_CACHE"] = r.cache
    var command = process.command(r.low, ["test", "probe", "--nocache", "--notime", "--run", "word"])
    command.env = env
    command.dir = r.project
    let result = process.run(command, []) or {
        finished <- Slotted { output: "could not run {r.low}", ended: time.monotonic() }
        return
    }
    finished <- Slotted { output: "{str(result.stdout)}{str(result.stderr)}", ended: time.monotonic() }
}

fn test_test_processes_wait_for_a_machine_slot(t: *testing.T, shared: *SharedLow) {
    let r = new_reused(t, shared)
    defer file.remove_all(r.dir) or {}
    if t.failed() {
        return
    }
    let slots = path.join([r.cache, "slots", "test"])
    file.mkdir_all(slots) catch {
        e => t.fatal("create {slots}: {e}")
    }
    let finished = chan[Slotted](1)
    hold_test_slots(t, slots, 0, os.cpu_count(), fn() {
        spawn slotted_run(r, finished)
        time.sleep_for(duration.milliseconds(held_ms))
    })
    let released = time.monotonic()
    let run = (<-finished) ?? Slotted { output: "", ended: 0 }
    t.contains(run.output, "ok   probe 1 passed\n")
    t.is_true(run.ended >= released)
}
