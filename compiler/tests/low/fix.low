import std/file
import std/testing

const fixable_source = "import std/math\n\nstruct Handle {{\n    descriptor: i64\n    drop print(descriptor)\n}}\n\nfn open_handle() -> Handle {{\n    Handle {{ descriptor: 3 }}\n}}\n\nfn main() {{\n    let handle = open_handle()\n    using count = 4\n    var start = 0\n    let spare = 5\n    var values: i64[] = []\n    push(mut values, 1)\n    var counts: [str: i64] = [\"a\": 1]\n    delete(counts, \"a\")\n    outer: for step in start..3 {{\n        print(step + count + handle.descriptor + values.len)\n    }}\n}}\n"

const fixed_source = "struct Handle {{\n    descriptor: i64\n    drop print(descriptor)\n}}\n\nfn open_handle() -> Handle {{\n    Handle {{ descriptor: 3 }}\n}}\n\nfn main() {{\n    using handle = open_handle()\n    let count = 4\n    let start = 0\n    let _ = 5\n    var values: i64[] = []\n    values.push(1)\n    var counts: [str: i64] = [\"a\": 1]\n    counts.delete(\"a\")\n    for step in start..3 {{\n        print(step + count + handle.descriptor + values.len)\n    }}\n}}\n"

const fixable_hunk = "@@ -1,5 +1,3 @@\n-import std/math\n-\n struct Handle {{\n     descriptor: i64\n     drop print(descriptor)\n@@ -10,15 +8,15 @@\n }}\n \n fn main() {{\n-    let handle = open_handle()\n-    using count = 4\n-    var start = 0\n-    let spare = 5\n+    using handle = open_handle()\n+    let count = 4\n+    let start = 0\n+    let _ = 5\n     var values: i64[] = []\n-    push(mut values, 1)\n+    values.push(1)\n     var counts: [str: i64] = [\"a\": 1]\n-    delete(counts, \"a\")\n-    outer: for step in start..3 {{\n+    counts.delete(\"a\")\n+    for step in start..3 {{\n         print(step + count + handle.descriptor + values.len)\n     }}\n }}\n"

const unsafe_source = "import std/file\n\nfn main() {{\n    print(file.read_text(\"notes.txt\")?)\n}}\n"

fn placed(t: *testing.T, c: Commands, name: str, source: str) -> str {
    let dir = file.child_path(c.dir, name)
    file.mkdir_all(dir) catch {
        e => t.fatal("create {dir}: {e}")
    }
    let main = file.child_path(dir, "main.low")
    file.write_text(main, source) catch {
        e => t.fatal("write {main}: {e}")
    }
    main
}

fn held(t: *testing.T, name: str) -> str {
    file.read_text(name) catch {
        e => {
            t.fatal("read {name}: {e}")
            ""
        }
    }
}

fn test_fix_applies_every_safe_fix(t: *testing.T, shared: *SharedLow) {
    let c = new_commands(t, shared)
    defer file.remove_all(c.dir) or {}
    let main = placed(t, c, "fixing", fixable_source)
    if t.failed() {
        return
    }
    let preview = plain(t, c, ["fix", "--dry-run", "fixing"])
    let _ = t.equal(preview.status, 0)
    let name = file.child_path("fixing", "main.low")
    let _ = t.equal(preview.out, "--- a/{name}\n+++ b/{name}\n{fixable_hunk}")
    let _ = t.equal(held(t, main), fixable_source)
    let applied = plain(t, c, ["fix", "fixing"])
    let _ = t.equal(applied.status, 0)
    let _ = t.equal(applied.out, "{name}: applied 9 fixes\n")
    let _ = t.equal(held(t, main), fixed_source)
    let again = plain(t, c, ["fix", "fixing"])
    let _ = t.equal(again.status, 0)
    let _ = t.equal(again.out, "")
    let _ = t.equal(held(t, main), fixed_source)
    let built = plain(t, c, ["run", "fixing"])
    let _ = t.equal(built.status, 0)
    let _ = t.equal(built.err, "")
    let _ = t.equal(built.out, "8\n9\n10\n3\n")
}

fn test_fix_leaves_unsafe_fixes_alone(t: *testing.T, shared: *SharedLow) {
    let c = new_commands(t, shared)
    defer file.remove_all(c.dir) or {}
    let main = placed(t, c, "unsafe", unsafe_source)
    if t.failed() {
        return
    }
    let got = plain(t, c, ["fix", "unsafe"])
    let _ = t.equal(got.status, 0)
    let _ = t.equal(got.out, "")
    let _ = t.equal(held(t, main), unsafe_source)
}
