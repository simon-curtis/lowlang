import compiler
import diag
import fixture
import native
import target
import std/file
import std/io
import std/process
import std/testing
import std/text

const blocked_read = "std_sched_blocked_read"
const woken_data = "xyz"

struct Release {
    name: str
    eof: bool
    reader: str
    binary: str
    first: str
}

fn release_name(c: Release) -> str {
    c.name
}

fn build_host_binary(t: *testing.T, source: str, binary: str) {
    let host = target.host()
    let profile = compiler.release(host)
    let unit = native.analyse(source, profile) catch {
        e => {
            t.fatal(native.message(e))
            return
        }
    }
    native.build(unit, binary) catch {
        e => {
            t.fatal(native.message(e))
            return
        }
    }
}

fn release_child(t: *testing.T, c: Release, stdin: io.Stream) {
    if c.eof {
        stdin.close()
        return
    }
    io.write_str(stdin, woken_data) catch {
        e => t.fatal("write to the blocked reader: {e}")
    }
}

fn release_body(t: *testing.T, c: Release) {
    var command = process.command(c.binary, [])
    command.stdin = process.Stdio.Piped
    command.stdout = process.Stdio.Piped
    using child = process.start(command) catch {
        e => {
            t.fatal("{c.binary}: {e}")
            return
        }
    }
    let handle = child.handle
    let stdin = match handle.stdin {
        some(s) => s
        none => {
            t.fatal("the child has no stdin pipe")
            return
        }
    }
    let stdout = match handle.stdout {
        some(s) => s
        none => {
            t.fatal("the child has no stdout pipe")
            return
        }
    }
    let lines = io.reader(stdout)
    let first = io.read_line(lines) catch {
        e => {
            t.fatal("no output while a reader was blocked: {e}")
            return
        }
    }
    if first != c.first {
        t.fatal("first line {diag.quote(first)}, want {diag.quote(c.first)}")
        return
    }
    release_child(t, c, stdin)
    let second = io.read_line(lines) catch {
        e => {
            t.fatal("reader never woke: {e}")
            return
        }
    }
    if second != c.reader {
        t.error("second line {diag.quote(second)}, want {diag.quote(c.reader)}")
    }
}

fn test_blocked_read_does_not_stall_collection(t: *testing.T) {
    let host = target.host()
    if host != target.OS.Linux {
        t.skip("runs Linux binaries, which need a Linux host")
        return
    }
    let dir = file.temp_dir("blocking-") catch {
        e => {
            t.fatal("{e}")
            return
        }
    }
    defer file.remove_all(dir) or {}
    let program = run_program(blocked_read)
    let binary = file.child_path(dir, target.executable(host, "main"))
    build_host_binary(t, program.path, binary)
    if t.failed() {
        return
    }
    let sidecars = fixture.read(program.path) catch {
        e => {
            t.fatal(fixture.message(e))
            return
        }
    }
    let stdout = text.split(text.trim_suffix(sidecars.stdout, "\n"), '\n')
    let cases = [
        Release { name: "eof", eof: true, reader: stdout[1], binary, first: stdout[0] }
        Release { name: "data", eof: false, reader: "reader {woken_data.len}", binary, first: stdout[0] }
    ]
    t.table_of(cases, release_name, release_body)
}
