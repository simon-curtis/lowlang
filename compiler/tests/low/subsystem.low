import native
import oracletool
import std/file
import std/process
import std/testing
import std/text

const hello_source = "fn main() {{\n    print(\"hello\")\n}}\n"

struct Built {
    low: str
    source: str
    dir: str
}

struct Rejection {
    name: str
    args: []str
    want: str
}

fn new_workspace(t: *testing.T) -> Built {
    let dir = file.temp_dir("subsystem-") catch {
        e => {
            t.fatal("{e}")
            return Built { low: "", source: "", dir: "" }
        }
    }
    let low = build_low(t, dir, native.overlay())
    let source = file.child_path(dir, "main.low")
    file.write_file(source, bytes(hello_source)) catch {
        e => t.fatal("write {source}: {e}")
    }
    Built { low, source, dir }
}

fn run_low(t: *testing.T, w: Built, args: []str) -> process.Output {
    let command = process.command(w.low, args)
    process.run(command, []) catch {
        e => {
            t.fatal("{w.low}: {e}")
            process.Output { status: process.Exit.Exited(1), stdout: [], stderr: [] }
        }
    }
}

fn subsystem_of(t: *testing.T, path: str) -> i64 {
    let image = file.read_file(path) catch {
        e => {
            t.fatal("read {path}: {e}")
            return 0
        }
    }
    let parsed = oracletool.read_pe(image) catch {
        e => {
            t.fatal("parse {path}: {oracletool.message(e)}")
            return 0
        }
    }
    match parsed.header {
        some(header) => header.subsystem
        none => {
            t.fatal("{path} has no optional header")
            0
        }
    }
}

fn build_windows(t: *testing.T, w: Built, name: str, flags: []str) -> str {
    let output = file.child_path(w.dir, name)
    var args = ["build", w.source, "-o", output, "-target", "windows/amd64"]
    for f in flags {
        args.push(f)
    }
    let result = run_low(t, w, args)
    if !process.success(result.status) {
        let joined = text.join(flags, " ")
        t.fatal("low build {joined}: {str(result.stderr)}")
    }
    output
}

fn test_build_subsystem(t: *testing.T) {
    let w = new_workspace(t)
    if t.failed() {
        return
    }
    defer file.remove_all(w.dir) or {}
    let default = build_windows(t, w, "default.exe", [])
    let console = build_windows(t, w, "console.exe", ["-subsystem", "console"])
    let gui = build_windows(t, w, "gui.exe", ["-subsystem", "gui"])
    if t.failed() {
        return
    }
    testing.equal(t, subsystem_of(t, default), oracletool.pe_subsystem_windows_cui)
    testing.equal(t, subsystem_of(t, console), oracletool.pe_subsystem_windows_cui)
    testing.equal(t, subsystem_of(t, gui), oracletool.pe_subsystem_windows_gui)
}

fn check_rejection(t: *testing.T, w: Built, c: Rejection) {
    var args = ["build", w.source, "-o", file.child_path(w.dir, "out")]
    for a in c.args {
        args.push(a)
    }
    let result = run_low(t, w, args)
    if process.success(result.status) {
        let joined = text.join(c.args, " ")
        t.error("{c.name}: low build {joined} succeeded")
        return
    }
    let message = text.trim(str(result.stderr))
    if message != c.want {
        t.error("{c.name}: got {message}, want {c.want}")
    }
}

fn test_build_subsystem_rejected(t: *testing.T) {
    let w = new_workspace(t)
    if t.failed() {
        return
    }
    defer file.remove_all(w.dir) or {}
    let cases = [
        Rejection { name: "linux", args: ["-target", "linux/amd64", "-subsystem", "gui"], want: "-subsystem applies only to the windows/amd64 target" }
        Rejection { name: "browser", args: ["-target", "browser/wasm32", "-subsystem", "console"], want: "-subsystem applies only to the windows/amd64 target" }
        Rejection { name: "unknown", args: ["-target", "windows/amd64", "-subsystem", "windowed"], want: "unknown subsystem windowed, expected console or gui" }
    ]
    for c in cases {
        check_rejection(t, w, c)
    }
}
