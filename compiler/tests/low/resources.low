import oracletool
import std/file
import std/io
import std/path
import std/process
import std/testing
import std/text
import std/unicode
import std/unicode/utf16

const manifest_text = "<assembly manifestVersion=\"1.0\"/>"
const project_build = "import std/build\n\nbuild.title(\"demo\")\nbuild.version(\"1.4.0\")\nbuild.icon(\"assets/app.ico\")\nbuild.manifest(\"assets/app.manifest\")\nbuild.file_info(\"CompanyName\", \"Example Ltd\")\n"

fn icon_image(fill: i64) -> []u8 {
    var out: []u8 = []
    io.put_le(mut out, 40, 4)
    io.put_le(mut out, 16, 4)
    io.put_le(mut out, 32, 4)
    io.put_le(mut out, 1, 2)
    io.put_le(mut out, 32, 2)
    for _ in 0..24 {
        out.push(0)
    }
    for _ in 0..16 * 16 * 4 {
        out.push(u8(fill))
    }
    out
}

fn icon_file(image: []u8) -> []u8 {
    var out: []u8 = []
    io.put_le(mut out, 0, 2)
    io.put_le(mut out, 1, 2)
    io.put_le(mut out, 1, 2)
    io.put_le(mut out, 16, 1)
    io.put_le(mut out, 16, 1)
    io.put_le(mut out, 0, 1)
    io.put_le(mut out, 0, 1)
    io.put_le(mut out, 1, 2)
    io.put_le(mut out, 32, 2)
    io.put_le(mut out, image.len, 4)
    io.put_le(mut out, 22, 4)
    io.append(mut out, image)
    out
}

fn write_bytes(t: *testing.T, path: str, data: []u8) {
    file.write_file(path, data) catch {
        e => t.fatal("write {path}: {e}")
    }
}

fn write_project_file(t: *testing.T, w: Built, name: str, data: []u8) -> str {
    let file_path = file.child_path(w.dir, name)
    file.mkdir_all(path.dir(file_path)) catch {
        e => t.fatal("create {path.dir(file_path)}: {e}")
    }
    write_bytes(t, file_path, data)
    file_path
}

fn resource_section(t: *testing.T, path: str) -> str {
    let image = file.read_file(path) catch {
        e => {
            t.fatal("read {path}: {e}")
            return ""
        }
    }
    let parsed = oracletool.read_pe(image) catch {
        e => {
            t.fatal("parse {path}: {oracletool.message(e)}")
            return ""
        }
    }
    let section = oracletool.pe_section(parsed, ".rsrc") ?? return ""
    let data = oracletool.pe_data(parsed, section) catch {
        e => {
            t.fatal("read .rsrc of {path}: {oracletool.message(e)}")
            return ""
        }
    }
    str(data)
}

fn expect_contains(t: *testing.T, what: str, whole: str, part: str, want: bool) {
    if text.contains(whole, part) != want {
        var verb = "hold"
        if want {
            verb = "lack"
        }
        t.error("the resources {verb} {what}")
    }
}

fn wide(s: str) -> str {
    str(utf16.encode_bytes(s, unicode.Order.Little, false))
}

fn build_project(t: *testing.T, w: Built, output: str, flags: []str) -> str {
    var args = ["build", file.child_path(w.dir, "proj"), "-o", output, "-target", "windows/amd64"]
    for f in flags {
        args.push(f)
    }
    let result = run_low(t, w, args)
    if !process.success(result.status) {
        let joined = text.join(flags, " ")
        t.fatal("low build {joined}: {str(result.stderr)}")
    }
    resource_section(t, output)
}

fn test_build_resources_flags(t: *testing.T) {
    let w = new_workspace(t)
    if t.failed() {
        return
    }
    defer file.remove_all(w.dir) or {}
    let image = icon_image(0x5A)
    let icon = write_project_file(t, w, "app.ico", icon_file(image))
    let manifest = write_project_file(t, w, "app.manifest", bytes(manifest_text))
    let output = build_windows(t, w, "flags.exe", ["-icon", icon, "-manifest", manifest])
    let section = resource_section(t, output)
    expect_contains(t, "the icon image", section, str(image), true)
    expect_contains(t, "the manifest", section, manifest_text, true)
    expect_contains(t, "version information", section, wide("VS_VERSION_INFO"), false)
    let plain = resource_section(t, build_windows(t, w, "plain.exe", []))
    testing.equal(t, plain, "")
}

fn test_build_resources_declared_and_overridden(t: *testing.T) {
    let w = new_workspace(t)
    if t.failed() {
        return
    }
    defer file.remove_all(w.dir) or {}
    let declared = icon_image(0x11)
    let flagged = icon_image(0x22)
    write_project_file(t, w, "proj/main.low", bytes(hello_source))
    write_project_file(t, w, "proj/build.low", bytes(project_build))
    write_project_file(t, w, "proj/assets/app.ico", icon_file(declared))
    write_project_file(t, w, "proj/assets/app.manifest", bytes(manifest_text))
    let replacement = write_project_file(t, w, "other.ico", icon_file(flagged))
    let section = build_project(t, w, file.child_path(w.dir, "declared.exe"), [])
    expect_contains(t, "the declared icon", section, str(declared), true)
    expect_contains(t, "the manifest", section, manifest_text, true)
    expect_contains(t, "the FileVersion key", section, wide("FileVersion"), true)
    expect_contains(t, "the file version", section, wide("1.4.0.0"), true)
    expect_contains(t, "the company name", section, wide("Example Ltd"), true)
    let overridden = build_project(t, w, file.child_path(w.dir, "overridden.exe"), ["-icon", replacement])
    expect_contains(t, "the flagged icon", overridden, str(flagged), true)
    expect_contains(t, "the declared icon", overridden, str(declared), false)
    expect_contains(t, "the manifest", overridden, manifest_text, true)
}

fn test_build_resources_ignored_off_windows(t: *testing.T) {
    let w = new_workspace(t)
    if t.failed() {
        return
    }
    defer file.remove_all(w.dir) or {}
    let missing = file.child_path(w.dir, "missing.ico")
    for platform in ["linux/amd64", "browser/wasm32"] {
        let args = ["build", w.source, "-o", file.child_path(w.dir, "ignored"), "-target", platform, "-icon", missing, "-manifest", missing]
        let result = run_low(t, w, args)
        if !process.success(result.status) {
            t.error("{platform}: {str(result.stderr)}")
        }
    }
}

fn check_failure(t: *testing.T, w: Built, name: str, flags: []str, want: str) {
    var args = ["build", w.source, "-o", file.child_path(w.dir, "out"), "-target", "windows/amd64"]
    for f in flags {
        args.push(f)
    }
    let result = run_low(t, w, args)
    if process.success(result.status) {
        t.error("{name}: low build succeeded")
        return
    }
    let message = text.trim(str(result.stderr))
    if !text.starts_with(message, want) {
        t.error("{name}: got {message}, want a message that starts {want}")
    }
}

fn test_build_resources_rejected(t: *testing.T) {
    let w = new_workspace(t)
    if t.failed() {
        return
    }
    defer file.remove_all(w.dir) or {}
    let missing = file.child_path(w.dir, "missing.ico")
    let broken = write_project_file(t, w, "broken.ico", bytes("not an icon file"))
    check_failure(t, w, "missing icon", ["-icon", missing], "read {missing}:")
    check_failure(t, w, "missing manifest", ["-manifest", missing], "read {missing}:")
    check_failure(t, w, "broken icon", ["-icon", broken], "link: icon: the file is not an .ico file")
}
