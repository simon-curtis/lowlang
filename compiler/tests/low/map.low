import std/file
import std/testing
import std/text

fn read_bytes(t: *testing.T, path: str) -> []u8 {
    file.read_file(path) catch {
        e => {
            t.fatal("read {path}: {e}")
            []
        }
    }
}

fn map_entry(t: *testing.T, line: str) -> i64 {
    let space = text.index_byte(line, ' ')
    if space <= 0 {
        t.fatal("map line {line} has no address")
        return 0
    }
    text.parse_radix(line[..space], 16) catch {
        _ => {
            t.fatal("map line {line} does not start with a hexadecimal address")
            0
        }
    }
}

fn test_build_map(t: *testing.T) {
    let w = new_workspace(t)
    if t.failed() {
        return
    }
    defer file.remove_all(w.dir) or {}
    let map = file.child_path(w.dir, "main.map")
    let plain = build_windows(t, w, "plain.exe", [])
    let mapped = build_windows(t, w, "mapped.exe", ["--map", map])
    if t.failed() {
        return
    }
    if str(read_bytes(t, plain)) != str(read_bytes(t, mapped)) {
        t.error("--map changed the executable")
    }
    let listing = str(read_bytes(t, map))
    var previous = 0
    var first = true
    var has_main = false
    for line in text.split(text.trim(listing), '\n') {
        let address = map_entry(t, line)
        if !first && address < previous {
            t.error("{line} comes after a higher address")
        }
        first = false
        previous = address
        has_main = has_main || text.ends_with(line, " fn_main")
    }
    if !has_main {
        t.error("the map has no fn_main")
    }
}
