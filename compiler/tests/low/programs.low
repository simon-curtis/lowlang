import fixture
import std/file
import std/io
import std/slices
import std/text

const bench_pattern = "bench/*/main.low"

struct Program {
    name: str
    path: str
}

fn fixture_programs(dir: str) -> []Program ! io.Error {
    var names = file.list(dir)?
    slices.sort(mut names)
    var programs: []Program = []
    for name in names {
        let path = file.child_path(dir, name)
        if file.is_dir(path) || text.ends_with(name, fixture.source_ext) {
            push(mut programs, Program { name: fixture.base(name), path })
        }
    }
    programs
}

fn bench_programs() -> []Program {
    var programs: []Program = []
    for path in file.glob(bench_pattern) {
        let parts = text.split(path, '/')
        push(mut programs, Program { name: parts[parts.len - 2], path })
    }
    programs
}

fn run_program(name: str) -> Program {
    Program { name, path: "testdata/run/{name}{fixture.source_ext}" }
}
