import std/file
import std/path
import std/process
import std/testing
import std/text

fn registry_env(c: Commands) -> [str: str] {
    [
        "GIT_CONFIG_GLOBAL": "/dev/null"
        "GIT_CONFIG_NOSYSTEM": "1"
        "GIT_CONFIG_COUNT": "1"
        "GIT_CONFIG_KEY_0": "url.file://{c.dir}/repos/.insteadOf"
        "GIT_CONFIG_VALUE_0": "https://"
        "GIT_AUTHOR_NAME": "low"
        "GIT_AUTHOR_EMAIL": "low@example.com"
        "GIT_COMMITTER_NAME": "low"
        "GIT_COMMITTER_EMAIL": "low@example.com"
        "LOW_CACHE": "{c.dir}/cache"
        "LOW_INDEX": "{c.dir}/index"
    ]
}

fn registry_git(t: *testing.T, c: Commands, args: []str) {
    var command = process.command("git", args)
    command.env = registry_env(c)
    let out = process.run(command, []) catch {
        e => {
            t.fatal("git: {e}")
            return
        }
    }
    if !process.success(out.status) {
        t.fatal("git {text.join(args, " ")}: {str(out.stderr)}")
    }
}

fn registry_file(t: *testing.T, location: str, contents: str) {
    file.mkdir_all(path.dir(location)) catch {
        e => t.fatal("create the directory of {location}: {e}")
    }
    file.write_text(location, contents) catch {
        e => t.fatal("write {location}: {e}")
    }
}

fn registry_low(t: *testing.T, c: Commands, dir: str, args: []str) -> Invocation {
    invoke(t, c, registry_env(c), dir, args)
}

fn test_publish_and_yank_reach_the_build(t: *testing.T) {
    if process.find("git") == none {
        t.skip("needs git on PATH")
        return
    }
    let c = new_commands(t)
    defer file.remove_all(c.dir) or {}
    if t.failed() {
        return
    }
    let work = "{c.dir}/work"
    registry_file(t, "{work}/color.low", "pub const name = \"red\"\n")
    registry_git(t, c, ["init", "--quiet", work])
    registry_git(t, c, ["-C", work, "add", "-A"])
    registry_git(t, c, ["-C", work, "commit", "--quiet", "-m", "one"])
    registry_git(t, c, ["-C", work, "tag", "v1.0.0"])
    registry_git(t, c, ["clone", "--quiet", "--bare", work, "{c.dir}/repos/example.com/color"])
    registry_git(t, c, ["init", "--quiet", "{c.dir}/index"])
    let project = "{c.dir}/project"
    registry_file(t, "{project}/build.low", "import std/build\n\nbuild.dep(\"example.com/color\", \"^1\")\n")
    registry_file(t, "{project}/main.low", "import example.com/color\n\nfn main() {{\n    print(color.name)\n}}\n")
    let output = "{c.dir}/out"

    let published = registry_low(t, c, c.dir, ["publish", "example.com/color", "1.0.0"])
    t.equal(published.status, 0)
    t.is_true(text.starts_with(published.out, "published example.com/color v1.0.0 "))
    let again = registry_low(t, c, c.dir, ["publish", "example.com/color", "v1.0.0"])
    t.equal(again.status, 1)
    t.is_true(text.contains(again.err, "example.com/color v1.0.0 is already in the package index"))

    let built = registry_low(t, c, project, ["build", "-o", output])
    t.equal(built.status, 0)
    t.equal(built.err, "")

    let yanked = registry_low(t, c, c.dir, ["yank", "example.com/color", "1.0.0"])
    t.equal(yanked.out, "yanked example.com/color v1.0.0\n")
    let warned = registry_low(t, c, project, ["build", "-o", output])
    t.equal(warned.status, 0)
    t.equal(text.split_str(warned.err, "is yanked").len, 2)
    t.is_true(text.starts_with(warned.err, "warning: example.com/color v1.0.0 is yanked"))

    let restored = registry_low(t, c, c.dir, ["yank", "--undo", "example.com/color", "1.0.0"])
    t.equal(restored.out, "unyanked example.com/color v1.0.0\n")
    let quiet = registry_low(t, c, project, ["build", "-o", output])
    t.equal(quiet.status, 0)
    t.equal(quiet.err, "")
}
