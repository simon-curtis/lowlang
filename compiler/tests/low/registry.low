import std/file
import std/git
import std/path
import std/process
import std/testing
import std/text

fn registry_env(c: Commands) -> [str: str] {
    [
        "GIT_CONFIG_GLOBAL": "/dev/null"
        "GIT_CONFIG_NOSYSTEM": "1"
        "GIT_CONFIG_COUNT": "1"
        "GIT_CONFIG_KEY_0": "url.file://{c.dir}/repos/.insteadOf"
        "GIT_CONFIG_VALUE_0": "https://"
        "GIT_AUTHOR_NAME": "low"
        "GIT_AUTHOR_EMAIL": "low@example.com"
        "GIT_COMMITTER_NAME": "low"
        "GIT_COMMITTER_EMAIL": "low@example.com"
        "LOW_CACHE": "{c.dir}/cache"
        "LOW_INDEX": "{c.dir}/index"
    ]
}

fn registry_repos(t: *testing.T, c: Commands) ! git.Error {
    let repo = git.init("{c.dir}/repos/example.com/color", true)?
    let blob = git.write_object(repo, Blob, bytes("pub const name = \"red\"\n"))?
    let tree = git.write_tree(repo, [git.TreeEntry { name: "color.low", mode: File, id: blob }])?
    let who = git.Signature { name: "low", email: "low@example.com", time: 1700000000 }
    let commit = git.write_commit(repo, git.Commit { tree, author: who, committer: who, message: "one\n" })?
    git.set_ref(repo, "refs/heads/main", commit)?
    git.set_ref(repo, "refs/tags/v1.0.0", commit)?
    git.init("{c.dir}/index", false)?
}

fn registry_file(t: *testing.T, location: str, contents: str) {
    file.mkdir_all(path.dir(location)) catch {
        e => t.fatal("create the directory of {location}: {e}")
    }
    file.write_text(location, contents) catch {
        e => t.fatal("write {location}: {e}")
    }
}

fn registry_low(t: *testing.T, c: Commands, dir: str, args: []str) -> Invocation {
    invoke(t, c, registry_env(c), dir, args)
}

fn test_publish_and_yank_reach_the_build(t: *testing.T, shared: *SharedLow) {
    if process.find("git") == none {
        t.skip("needs git on PATH")
        return
    }
    let c = new_commands(t, shared)
    defer file.remove_all(c.dir) or {}
    if t.failed() {
        return
    }
    registry_repos(t, c) catch {
        e => {
            t.fatal("write the repositories: {git.message(e)}")
            return
        }
    }
    let project = "{c.dir}/project"
    registry_file(t, "{project}/build.low", "import std/build\n\nbuild.dep(\"example.com/color\", \"^1\")\n")
    registry_file(t, "{project}/main.low", "import example.com/color\n\nfn main() {{\n    print(color.name)\n}}\n")
    let output = "{c.dir}/out"

    let published = registry_low(t, c, c.dir, ["publish", "example.com/color", "1.0.0"])
    let _ = t.equal(published.status, 0)
    let _ = t.is_true(text.starts_with(published.out, "published example.com/color v1.0.0 "))
    let again = registry_low(t, c, c.dir, ["publish", "example.com/color", "v1.0.0"])
    let _ = t.equal(again.status, 1)
    let _ = t.is_true(text.contains(again.err, "example.com/color v1.0.0 is already in the package index"))

    let built = registry_low(t, c, project, ["build", "-o", output])
    let _ = t.equal(built.status, 0)
    let _ = t.equal(built.err, "")

    let yanked = registry_low(t, c, c.dir, ["yank", "example.com/color", "1.0.0"])
    let _ = t.equal(yanked.out, "yanked example.com/color v1.0.0\n")
    let listed = registry_low(t, c, c.dir, ["doc", "index"])
    let _ = t.equal(listed.status, 0)
    let _ = t.is_true(text.contains(listed.out, "\"source\": \"example.com/color\""))
    let _ = t.is_true(text.contains(listed.out, "\"tag\": \"v1.0.0\""))
    let _ = t.is_true(text.contains(listed.out, "\"yanked\": true"))
    let _ = t.is_true(text.contains(listed.out, "\"path\": \"example.com/color\""))
    let warned = registry_low(t, c, project, ["build", "-o", output])
    let _ = t.equal(warned.status, 0)
    let _ = t.equal(text.split_str(warned.err, "is yanked").len, 2)
    let _ = t.is_true(text.starts_with(warned.err, "warning: example.com/color v1.0.0 is yanked"))

    let restored = registry_low(t, c, c.dir, ["yank", "--undo", "example.com/color", "1.0.0"])
    let _ = t.equal(restored.out, "unyanked example.com/color v1.0.0\n")
    let _ = t.is_true(text.contains(registry_low(t, c, c.dir, ["doc", "index"]).out, "\"yanked\": false"))
    let quiet = registry_low(t, c, project, ["build", "-o", output])
    let _ = t.equal(quiet.status, 0)
    t.equal(quiet.err, "")
}
