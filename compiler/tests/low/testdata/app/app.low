import shapes
import std/text

pub fn describe(p: shapes.Point, s: shapes.Shade) -> str {
    let wide = shapes.largest(p.x, p.y)
    let shade = match s {
        Light => "light"
        Dark => "dark"
    }
    text.join(["{p.area()}", "{wide}", shade], " ")
}

pub fn total(p: shapes.Point) -> i64 {
    shapes.largest(p.area(), 0)
}

fn caller() -> str {
    describe(shapes.Point { x: 1, y: 2 }, shapes.Shade.Dark)
}
