/// A point on the grid.
pub struct Point {
    pub x: i64
    pub y: i64
}

pub enum Shade {
    Light
    Dark
}

/// The scale of one unit of area, in the smallest measure the fixture knows of.
const unit = 1

pub fn largest[T: Ord](a: T, b: T) -> T {
    if a > b { a } else { b }
}

fn scale(n: i64) -> i64 {
    n * unit
}

pub fn area(p: Point) -> i64 {
    scale(p.x) * p.y
}
