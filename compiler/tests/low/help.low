import target
import std/file
import std/os
import std/process
import std/term
import std/testing
import std/text

fn all_commands() -> []str {
    ["build", "run", "test", "install", "update", "publish", "yank", "asm", "ir", "lint", "doc", "names", "dev", "prof", "abbench", "protogen", "lsp", "version", "help"]
}

const column_limit = 80

struct Invocation {
    status: i64
    out: str
    err: str
}

struct UsageCase {
    name: str
    args: []str
    first: str
    usage: str
}

fn escape() -> str {
    text.from_char(27)
}

fn invoke(t: *testing.T, c: Commands, extra: [str: str], dir: str, args: []str) -> Invocation {
    var env = os.environment()
    env.delete("NO_COLOR")
    env.delete("CLICOLOR_FORCE")
    for name, value in extra {
        env[name] = value
    }
    var command = process.command(c.low, args)
    command.env = env
    command.dir = dir
    let result = process.run(command, []) catch {
        e => {
            t.fatal("{c.low}: {e}")
            return Invocation { status: -1, out: "", err: "" }
        }
    }
    var status = -1
    match result.status {
        Exited(code) => {
            status = code
        }
        Signaled(_) => {}
    }
    Invocation { status, out: str(result.stdout), err: str(result.stderr) }
}

fn plain(t: *testing.T, c: Commands, args: []str) -> Invocation {
    invoke(t, c, [:], c.dir, args)
}

fn forced(t: *testing.T, c: Commands, args: []str) -> Invocation {
    invoke(t, c, ["CLICOLOR_FORCE": "1"], c.dir, args)
}

fn check_layout(t: *testing.T, label: str, shown: str) {
    t.is_false(text.contains(shown, escape()))
    t.is_true(text.ends_with(shown, "\n"))
    t.is_false(text.ends_with(shown, "\n\n"))
    for line in text.lines(shown) {
        if text.char_count(line) > column_limit {
            t.error("{label}: line over {column_limit} columns: {line}")
        }
        if text.ends_with(line, " ") {
            t.error("{label}: trailing space: {line}")
        }
    }
}

fn check_help(t: *testing.T, label: str, got: Invocation) {
    t.equal(got.status, 0)
    t.equal(got.err, "")
    check_layout(t, label, got.out)
}

fn listed_commands(top: str) -> []str {
    var names: []str = []
    var inside = false
    for line in text.lines(top) {
        if line == "Commands:" {
            inside = true
        } else if line == "" {
            inside = false
        } else if inside {
            names.push(text.fields(line)[0])
        }
    }
    names
}

fn test_top_level_help(t: *testing.T) {
    let c = new_commands(t)
    defer file.remove_all(c.dir) or {}
    if t.failed() {
        return
    }
    let top = plain(t, c, ["--help"])
    check_help(t, "low --help", top)
    t.is_true(text.starts_with(top.out, "Low "))
    t.is_true(text.contains(top.out, "\nUsage: low <command> [options] [arguments]\n"))
    t.equal_slice(listed_commands(top.out), all_commands())
    let aliases: [][]str = [[], ["-h"], ["help"]]
    for args in aliases {
        let same = plain(t, c, args)
        t.equal(same.out, top.out)
        t.equal(same.status, 0)
        t.equal(same.err, "")
    }
    let version = plain(t, c, ["version"])
    t.equal(version.status, 0)
    let versions: [][]str = [["-V"], ["--version"]]
    for args in versions {
        t.equal(plain(t, c, args).out, version.out)
    }
}

fn sentence_count(paragraph: str) -> i64 {
    let flat = text.replace(paragraph, "\n", " ")
    var count = 1
    for part in text.split_str(flat, ". ")[1..] {
        if part.len > 0 && part[..1] != text.lower(part[..1]) {
            count += 1
        }
    }
    count
}

fn test_every_command_help(t: *testing.T) {
    let c = new_commands(t)
    defer file.remove_all(c.dir) or {}
    if t.failed() {
        return
    }
    for name in all_commands() {
        let long = plain(t, c, [name, "--help"])
        check_help(t, "low {name} --help", long)
        t.is_true(text.starts_with(long.out, "Usage: low {name}"))
        t.is_true(text.contains(long.out, "\nOptions:\n"))
        t.is_true(sentence_count(text.split_str(long.out, "\n\n")[1]) <= 2)
        t.is_true(text.contains(long.out, "\n  -h, --help "))
        t.equal(plain(t, c, [name, "-h"]).out, long.out)
        t.equal(plain(t, c, ["help", name]).out, long.out)
    }
}

fn test_colour_is_decided_at_the_write(t: *testing.T) {
    let c = new_commands(t)
    defer file.remove_all(c.dir) or {}
    if t.failed() {
        return
    }
    let pages: [][]str = [["--help"], ["build", "--help"], ["test", "--help"]]
    for args in pages {
        let bare = plain(t, c, args)
        let coloured = forced(t, c, args)
        t.is_true(text.contains(coloured.out, escape()))
        t.equal(term.strip(coloured.out), bare.out)
    }
    let muted = invoke(t, c, ["CLICOLOR_FORCE": "1", "NO_COLOR": "1"], c.dir, ["--help"])
    t.is_false(text.contains(muted.out, escape()))
    let failed = forced(t, c, ["build", "--frobnicate"])
    t.is_true(text.contains(failed.err, escape()))
    t.equal(term.strip(failed.err), plain(t, c, ["build", "--frobnicate"]).err)
}

fn usage_cases() -> []UsageCase {
    let build = "Usage: low build [options] [file.low|dir]"
    let test = "Usage: low test [options] [module|dir/...|file_test.low:line]..."
    let prof = "Usage: low prof [options] <program> [args...]"
    let abbench = "Usage: low abbench [options] <command> [args...]"
    let protogen = "Usage: low protogen [options] <file.proto>..."
    let host = target.string(target.host())
    var foreign = "windows/amd64"
    if host == foreign {
        foreign = "linux/amd64"
    }
    [
        UsageCase { name: "unknown option", args: ["build", "--frobnicate"], first: "low build: unknown option --frobnicate", usage: build }
        UsageCase { name: "unknown short option", args: ["build", "-x"], first: "low build: unknown option -x", usage: build }
        UsageCase { name: "missing value", args: ["build", "--target"], first: "low build: option --target needs a value", usage: build }
        UsageCase { name: "missing short value", args: ["build", "-o"], first: "low build: option --output needs a value", usage: build }
        UsageCase { name: "one-dash long option", args: ["build", "-target", "linux/amd64"], first: "low build: unknown option -target", usage: build }
        UsageCase { name: "one-dash long option with a value", args: ["build", "-target=linux/amd64"], first: "low build: unknown option -target=linux/amd64", usage: build }
        UsageCase { name: "unknown letter in a group", args: ["test", "-vx"], first: "low test: unknown option -vx", usage: test }
        UsageCase { name: "short switch with a value", args: ["test", "-v=1"], first: "low test: unknown option -v=1", usage: test }
        UsageCase { name: "long option with a value", args: ["build", "--frobnicate=3"], first: "low build: unknown option --frobnicate=3", usage: build }
        UsageCase { name: "switch given false", args: ["test", "--list=false"], first: "low test: option --list takes no value", usage: test }
        UsageCase { name: "switch given true", args: ["test", "--list=true"], first: "low test: option --list takes no value", usage: test }
        UsageCase { name: "empty target", args: ["build", "--target="], first: "low build: {target.message(target.ParseError.Unknown(""))}", usage: build }
        UsageCase { name: "empty config", args: ["build", "-c", ""], first: "low build: unknown configuration ''; use release or debug", usage: build }
        UsageCase { name: "empty subsystem", args: ["build", "--target", "windows/amd64", "--subsystem="], first: "low build: unknown subsystem ''; use console or gui", usage: build }
        UsageCase { name: "empty count", args: ["test", "--count="], first: "low test: invalid value '' for --count", usage: test }
        UsageCase { name: "empty shuffle seed", args: ["test", "--shuffle", ""], first: "low test: invalid value '' for --shuffle", usage: test }
        UsageCase { name: "grouped switch and value", args: ["test", "-vj0"], first: "low test: option --jobs needs at least 1", usage: test }
        UsageCase { name: "unknown config", args: ["build", "-c", "fast"], first: "low build: unknown configuration 'fast'; use release or debug", usage: build }
        UsageCase { name: "unknown subsystem", args: ["build", "--target", "windows/amd64", "--subsystem", "windowed"], first: "low build: unknown subsystem 'windowed'; use console or gui", usage: build }
        UsageCase { name: "subsystem off windows", args: ["build", "--target", "linux/amd64", "--subsystem", "gui"], first: "low build: option --subsystem applies only to the windows/amd64 target", usage: build }
        UsageCase { name: "too many operands", args: ["build", "a", "b"], first: "low build: unexpected operand 'b'", usage: build }
        UsageCase { name: "missing operand", args: ["asm"], first: "low asm: missing operand", usage: "Usage: low asm [options] <file.low>" }
        UsageCase { name: "bad count", args: ["test", "--count", "0"], first: "low test: option --count needs at least 1", usage: test }
        UsageCase { name: "bad number", args: ["test", "--jobs", "many"], first: "low test: invalid value 'many' for --jobs", usage: test }
        UsageCase { name: "install for another target", args: ["install", "--target", foreign], first: "low install: option --target must be {host}", usage: "Usage: low install [options] [file.low|dir]..." }
        UsageCase { name: "prof without a map", args: ["prof", "app"], first: "low prof: missing option --map", usage: prof }
        UsageCase { name: "prof with an empty map", args: ["prof", "--map=", "app"], first: "low prof: option --map needs a value", usage: prof }
        UsageCase { name: "prof without a program", args: ["prof", "--map", "m"], first: "low prof: missing operand", usage: prof }
        UsageCase { name: "prof interval", args: ["prof", "--map", "m", "--interval", "0", "app"], first: "low prof: option --interval needs at least 1", usage: prof }
        UsageCase { name: "prof depth", args: ["prof", "--map", "m", "--depth", "deep", "app"], first: "low prof: invalid value 'deep' for --depth", usage: prof }
        UsageCase { name: "abbench without the first program", args: ["abbench", "--b", "y", "cmd"], first: "low abbench: missing option --a", usage: abbench }
        UsageCase { name: "abbench without the second program", args: ["abbench", "--a", "x", "cmd"], first: "low abbench: missing option --b", usage: abbench }
        UsageCase { name: "abbench with an empty program", args: ["abbench", "--a=", "--b", "y", "cmd"], first: "low abbench: option --a needs a value", usage: abbench }
        UsageCase { name: "abbench without a command", args: ["abbench", "--a", "x", "--b", "y"], first: "low abbench: missing operand", usage: abbench }
        UsageCase { name: "abbench runs", args: ["abbench", "--a", "x", "--b", "y", "--runs", "4", "cmd"], first: "low abbench: option --runs needs at least 5", usage: abbench }
        UsageCase { name: "abbench mask", args: ["abbench", "--a", "x", "--b", "y", "--affinity", "zz", "cmd"], first: "low abbench: invalid value 'zz' for --affinity", usage: abbench }
        UsageCase { name: "abbench empty mask", args: ["abbench", "--a", "x", "--b", "y", "--affinity=", "cmd"], first: "low abbench: invalid value '' for --affinity", usage: abbench }
        UsageCase { name: "abbench signed mask", args: ["abbench", "--a", "x", "--b", "y", "--affinity", "+3", "cmd"], first: "low abbench: invalid value '+3' for --affinity", usage: abbench }
        UsageCase { name: "abbench mask over 64 bits", args: ["abbench", "--a", "x", "--b", "y", "--affinity", "0x10000000000000000", "cmd"], first: "low abbench: invalid value '0x10000000000000000' for --affinity", usage: abbench }
        UsageCase { name: "abbench short options", args: ["abbench", "-a", "x", "-by", "--runs", "4", "cmd"], first: "low abbench: option --runs needs at least 5", usage: abbench }
        UsageCase { name: "abbench zero mask", args: ["abbench", "--a", "x", "--b", "y", "--affinity", "0x0", "cmd"], first: "low abbench: invalid value '0x0' for --affinity", usage: abbench }
        UsageCase { name: "protogen without an output", args: ["protogen", "a.proto"], first: "low protogen: missing option --output", usage: protogen }
        UsageCase { name: "protogen with an empty output", args: ["protogen", "--output=", "a.proto"], first: "low protogen: option --output needs a value", usage: protogen }
        UsageCase { name: "protogen without a file", args: ["protogen", "-o", "out"], first: "low protogen: missing operand", usage: protogen }
        UsageCase { name: "protogen one-dash include", args: ["protogen", "-include", "d", "-o", "out", "a.proto"], first: "low protogen: unknown option -include", usage: protogen }
        UsageCase { name: "publish without a version", args: ["publish", "example.com/color"], first: "low publish: missing operand", usage: "Usage: low publish [options] <source> <version>" }
        UsageCase { name: "yank with too many operands", args: ["yank", "example.com/color", "1.0.0", "2.0.0"], first: "low yank: unexpected operand '2.0.0'", usage: "Usage: low yank [options] <source> <version>" }
        UsageCase { name: "option of another command", args: ["update", "--target", "linux/amd64"], first: "low update: unknown option --target", usage: "Usage: low update [options] [dir]" }
    ]
}

fn test_usage_errors(t: *testing.T) {
    let c = new_commands(t)
    defer file.remove_all(c.dir) or {}
    if t.failed() {
        return
    }
    for u in usage_cases() {
        let got = plain(t, c, u.args)
        let want = "{u.first}\n{u.usage}\nTry 'low {u.args[0]} --help' for more information.\n"
        if got.status != 2 || got.out != "" || got.err != want {
            t.error("{u.name}: status {got.status}, stdout {got.out}, stderr {got.err}, want {want}")
        }
    }
    let unknown = plain(t, c, ["frob"])
    t.equal(unknown.status, 2)
    t.equal(unknown.out, "")
    t.equal(unknown.err, "low: unknown command 'frob'\nTry 'low --help' for more information.\n")
    let option = plain(t, c, ["--frobnicate"])
    t.equal(option.status, 2)
    t.equal(option.err, "low: unknown option --frobnicate\nTry 'low --help' for more information.\n")
    let dashed = plain(t, c, ["-target"])
    t.equal(dashed.status, 2)
    t.equal(dashed.err, "low: unknown option -target\nTry 'low --help' for more information.\n")
    let help = plain(t, c, ["help", "frob"])
    t.equal(help.status, 2)
    t.equal(help.err, "low: unknown command 'frob'\nTry 'low --help' for more information.\n")
}

fn test_version_takes_no_operands(t: *testing.T) {
    let c = new_commands(t)
    defer file.remove_all(c.dir) or {}
    if t.failed() {
        return
    }
    let command = plain(t, c, ["version", "extra"])
    t.equal(command.status, 2)
    t.equal(command.out, "")
    t.is_true(text.starts_with(command.err, "low version: unexpected operand 'extra'\n"))
    let spellings: [][]str = [["-V", "extra"], ["--version", "extra"]]
    for args in spellings {
        let got = plain(t, c, args)
        t.equal(got.status, 2)
        t.equal(got.out, "")
        t.equal(got.err, command.err)
    }
}

fn test_options_end_at_the_program_or_command(t: *testing.T) {
    let c = new_commands(t)
    defer file.remove_all(c.dir) or {}
    if t.failed() {
        return
    }
    let prof = plain(t, c, ["prof", "--map", "m", "missing.exe", "--interval", "0"])
    t.equal(prof.status, 1)
    t.is_false(text.contains(prof.err, "--interval"))
    let abbench = plain(t, c, ["abbench", "--a", "missing.exe", "--b", "missing.exe", "missing.exe", "--runs", "1"])
    t.equal(abbench.status, 1)
    t.is_false(text.contains(abbench.err, "--runs"))
}

fn test_lone_dash_is_an_operand(t: *testing.T) {
    let c = new_commands(t)
    defer file.remove_all(c.dir) or {}
    if t.failed() {
        return
    }
    let got = plain(t, c, ["build", "-"])
    t.equal(got.status, 1)
    t.is_false(text.contains(got.err, "unknown option"))
}

fn test_run_help_lists_the_targets_it_can_run(t: *testing.T) {
    let c = new_commands(t)
    defer file.remove_all(c.dir) or {}
    if t.failed() {
        return
    }
    let run = plain(t, c, ["run", "--help"]).out
    let build = plain(t, c, ["build", "--help"]).out
    for platform in target.all() {
        let name = target.string(platform)
        t.is_true(text.contains(build, name))
        t.equal(text.contains(run, name), platform == target.host() || !target.native(platform))
    }
}

fn assembly(t: *testing.T, c: Commands, options: []str) -> str {
    var args = ["asm"]
    for o in options {
        args.push(o)
    }
    let got = plain(t, c, args)
    if got.status != 0 {
        t.fatal("low {text.join(args, " ")}: {got.err}")
    }
    got.out
}

fn test_long_option_spellings_are_equivalent(t: *testing.T) {
    let c = new_commands(t)
    defer file.remove_all(c.dir) or {}
    if t.failed() {
        return
    }
    let separate = assembly(t, c, [c.app, "--target", "linux/amd64"])
    t.is_true(separate != "")
    t.equal(assembly(t, c, [c.app, "--target=linux/amd64"]), separate)
    t.equal(assembly(t, c, ["--target", "linux/amd64", c.app]), separate)
    t.equal(assembly(t, c, ["--", c.app]), assembly(t, c, [c.app]))
}

fn test_run_gives_the_program_its_arguments(t: *testing.T) {
    let c = new_commands(t)
    defer file.remove_all(c.dir) or {}
    if t.failed() {
        return
    }
    t.equal(text.trim(plain(t, c, ["run", c.app, "-h"]).out), "-h")
    t.equal(text.trim(plain(t, c, ["run", c.app, "--help"]).out), "--help")
    t.equal(text.trim(plain(t, c, ["run", "--", c.app, "x"]).out), "x")
    t.equal(text.trim(plain(t, c, ["run", c.app, "--", "y"]).out), "--")
    let own = plain(t, c, ["run", "--help"])
    t.is_true(text.starts_with(own.out, "Usage: low run"))
}

fn output_spellings(c: Commands) -> [][]str {
    [
        ["-o", "@", c.app]
        ["--output", "@", c.app]
        ["--output=@", c.app]
        ["-o@", c.app]
        [c.app, "-o", "@"]
        ["-o", "@", "--", c.app]
    ]
}

fn built_with(t: *testing.T, c: Commands, spelling: []str, output: str) -> []u8 {
    var args = ["build"]
    for a in spelling {
        args.push(text.replace(a, "@", output))
    }
    let got = plain(t, c, args)
    if got.status != 0 {
        t.fatal("low {text.join(args, " ")}: {got.err}")
        return []
    }
    file.read_file(output) catch {
        e => {
            t.fatal("read {output}: {e}")
            return []
        }
    }
}

fn test_output_spellings_are_equivalent(t: *testing.T) {
    let c = new_commands(t)
    defer file.remove_all(c.dir) or {}
    if t.failed() {
        return
    }
    let first = file.child_path(c.dir, "first")
    let want = built_with(t, c, ["-o", "@", c.app], first)
    for i, spelling in output_spellings(c) {
        let output = file.child_path(c.dir, "out{i}")
        t.equal_slice(built_with(t, c, spelling, output), want)
    }
}
