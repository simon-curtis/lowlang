import compiler
import target
import std/file
import std/process
import std/testing
import std/text

const low_entry = "compiler/low"
const version_file = "compiler/low/version.txt"

fn build_low(t: *testing.T, dir: str, overlay: *compiler.Overlay) -> str {
    let host = target.host()
    let std = compiler.new_std()
    let unit = compiler.check_in(low_entry, host, std, overlay) catch {
        e => {
            t.fatal(compiler.message(e))
            return ""
        }
    }
    compiler.lower(unit, compiler.release(host))
    let binary = file.child_path(dir, target.executable(host, "low"))
    compiler.build(unit, binary) catch {
        e => {
            t.fatal(compiler.message(e))
            return ""
        }
    }
    binary
}

fn reported_version(t: *testing.T, binary: str) -> str {
    let output = process.run(process.command(binary, ["version"]), []) catch {
        e => {
            t.fatal("{binary} version: {e}")
            return ""
        }
    }
    if !process.success(output.status) {
        t.fatal("{binary} version failed: {str(output.stderr)}")
        return ""
    }
    text.trim(str(output.stdout))
}

fn stamped_overlay(t: *testing.T, version: str) -> *compiler.Overlay {
    let overlay = compiler.new_overlay()
    let path = compiler.absolute_path(version_file) catch {
        e => {
            t.fatal(compiler.message(e))
            return overlay
        }
    }
    compiler.overlay_put(overlay, path, version)
    overlay
}

fn test_build_version_prefers_stamp(t: *testing.T) {
    let dir = file.temp_dir("version-") catch {
        e => {
            t.fatal("{e}")
            return
        }
    }
    defer file.remove_all(dir) or {}
    let overlay = stamped_overlay(t, "v1.2.3")
    if t.failed() {
        return
    }
    let binary = build_low(t, dir, overlay)
    if t.failed() {
        return
    }
    t.equal(reported_version(t, binary), "v1.2.3")
}

fn test_build_version_unstamped(t: *testing.T) {
    let dir = file.temp_dir("version-") catch {
        e => {
            t.fatal("{e}")
            return
        }
    }
    defer file.remove_all(dir) or {}
    let binary = build_low(t, dir, compiler.new_overlay())
    if t.failed() {
        return
    }
    let got = reported_version(t, binary)
    if !text.starts_with(got, "dev") {
        t.error("version is {got}, want a dev version")
    }
}
