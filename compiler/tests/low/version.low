import compiler
import native
import target
import std/file
import std/process
import std/testing
import std/text

const low_entry = "compiler/low"
const version_file = "compiler/low/version.txt"

fn build_low(t: *testing.T, dir: str, overlay: *compiler.Overlay) -> str {
    let host = target.host()
    let std = compiler.new_std()
    let unit = compiler.check_in(low_entry, host, std, overlay) catch {
        e => {
            t.fatal(compiler.message(e))
            return ""
        }
    }
    let profile = compiler.release(host)
    let jobs = native.runner()
    compiler.lower(unit, profile, jobs)
    let binary = file.child_path(dir, target.executable(host, "low"))
    native.build(unit, binary) catch {
        e => {
            t.fatal(native.message(e))
            return ""
        }
    }
    binary
}

struct SharedLow {
    dir: str = ""
    binary: str = ""
    tried: bool = false
}

fn shared_low(t: *testing.T, shared: *SharedLow) -> str {
    if !shared.tried {
        shared.tried = true
        shared.dir = file.temp_dir("low-") catch {
            e => {
                t.fatal("{e}")
                return ""
            }
        }
        shared.binary = build_low(t, shared.dir, native.overlay())
    }
    if shared.binary == "" {
        t.fatal("low did not build")
    }
    shared.binary
}

fn drop_shared_low(shared: *SharedLow) {
    if shared.dir != "" {
        file.remove_all(shared.dir) or {}
    }
}

fn reported_version(t: *testing.T, binary: str) -> str {
    let output = process.run(process.command(binary, ["version"]), []) catch {
        e => {
            t.fatal("{binary} version: {e}")
            return ""
        }
    }
    if !process.success(output.status) {
        t.fatal("{binary} version failed: {str(output.stderr)}")
        return ""
    }
    text.trim(str(output.stdout))
}

fn stamped_overlay(t: *testing.T, version: str) -> *compiler.Overlay {
    let overlay = native.overlay()
    let path = compiler.absolute_path(overlay, version_file) catch {
        e => {
            t.fatal(compiler.message(e))
            return overlay
        }
    }
    compiler.overlay_put(overlay, path, version)
    overlay
}

fn test_build_version_prefers_stamp(t: *testing.T) {
    let dir = file.temp_dir("version-") catch {
        e => {
            t.fatal("{e}")
            return
        }
    }
    defer file.remove_all(dir) or {}
    let overlay = stamped_overlay(t, "v1.2.3")
    if t.failed() {
        return
    }
    let binary = build_low(t, dir, overlay)
    if t.failed() {
        return
    }
    t.equal(reported_version(t, binary), "v1.2.3")
}

fn stamping_overlay(revision: str) -> *compiler.Overlay {
    var disk = native.disk()
    disk.stamp = fn(root: str) -> compiler.Stamp {
        compiler.Stamp { revision, time: 1795017690 }
    }
    compiler.new_overlay(disk, native.runner())
}

fn version_built_with(t: *testing.T, revision: str) -> str {
    let dir = file.temp_dir("version-") catch {
        e => {
            t.fatal("{e}")
            return ""
        }
    }
    defer file.remove_all(dir) or {}
    let overlay = stamping_overlay(revision)
    let binary = build_low(t, dir, overlay)
    if t.failed() {
        return ""
    }
    reported_version(t, binary)
}

fn test_build_version_names_the_commit_and_build_time(t: *testing.T) {
    let got = version_built_with(t, "0e21bead73d7157301537553a55ddfd8b718afea")
    t.equal(got, "dev+0e21bead73d7 ~ 2026/11/18 16:01")
}

fn test_build_version_outside_git(t: *testing.T) {
    let got = version_built_with(t, "")
    t.equal(got, "dev")
}
