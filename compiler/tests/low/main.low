import std/os
import std/testing

const slow_timeout = 1800000

fn main() {
    let shared = new(SharedLow {})
    let tests = [
        testing.Test { name: "compile_is_deterministic", run: test_compile_is_deterministic }
        testing.Test { name: "browser_module_is_deterministic", run: test_browser_module_is_deterministic }
        testing.Test { name: "blocked_read_does_not_stall_collection", run: test_blocked_read_does_not_stall_collection }
        testing.Test { name: "invalid_memory_access_reports_the_fault", run: test_invalid_memory_access_reports_the_fault }
        testing.Test { name: "stack_overflow_has_no_fault_report", run: test_stack_overflow_has_no_fault_report }
        testing.Test { name: "build_version_prefers_stamp", run: test_build_version_prefers_stamp }
        testing.Test { name: "build_version_names_the_commit_and_build_time", run: test_build_version_names_the_commit_and_build_time }
        testing.Test { name: "build_version_outside_git", run: test_build_version_outside_git }
        testing.Test { name: "build_subsystem", run: fn(t) { test_build_subsystem(t, shared) } }
        testing.Test { name: "declared_gui_sets_the_subsystem", run: fn(t) { test_declared_gui_sets_the_subsystem(t, shared) } }
        testing.Test { name: "declared_gui_reaches_run_and_install", run: fn(t) { test_declared_gui_reaches_run_and_install(t, shared) } }
        testing.Test { name: "declared_icon_reaches_every_windows_program", run: fn(t) { test_declared_icon_reaches_every_windows_program(t, shared) } }
        testing.Test { name: "declared_version_and_manifest_reach_every_windows_program", run: fn(t) { test_declared_version_and_manifest_reach_every_windows_program(t, shared) } }
        testing.Test { name: "bare_commands_use_the_declared_programs", run: fn(t) { test_bare_commands_use_the_declared_programs(t, shared) } }
        testing.Test { name: "bare_commands_with_one_program", run: fn(t) { test_bare_commands_with_one_program(t, shared) } }
        testing.Test { name: "bare_commands_without_programs", run: fn(t) { test_bare_commands_without_programs(t, shared) } }
        testing.Test { name: "low_test_builds_a_console_harness", run: fn(t) { test_low_test_builds_a_console_harness(t, shared) } }
        testing.Test { name: "modules_directory_places_imports_for_every_command", run: fn(t) { test_modules_directory_places_imports_for_every_command(t, shared) } }
        testing.Test { name: "declared_programs_of_a_dependency_are_ignored", run: fn(t) { test_declared_programs_of_a_dependency_are_ignored(t, shared) } }
        testing.Test { name: "build_map", run: fn(t) { test_build_map(t, shared) } }
        testing.Test { name: "install_names_programs_after_their_directory", run: fn(t) { test_install_names_programs_after_their_directory(t, shared) } }
        testing.Test { name: "build_names_programs_after_their_directory", run: fn(t) { test_build_names_programs_after_their_directory(t, shared) } }
        testing.Test { name: "run_defaults_to_the_current_directory", run: fn(t) { test_run_defaults_to_the_current_directory(t, shared) } }
        testing.Test { name: "top_level_help", run: fn(t) { test_top_level_help(t, shared) } }
        testing.Test { name: "every_command_help", run: fn(t) { test_every_command_help(t, shared) } }
        testing.Test { name: "colour_is_decided_at_the_write", run: fn(t) { test_colour_is_decided_at_the_write(t, shared) } }
        testing.Test { name: "usage_errors", run: fn(t) { test_usage_errors(t, shared) } }
        testing.Test { name: "version_takes_no_operands", run: fn(t) { test_version_takes_no_operands(t, shared) } }
        testing.Test { name: "options_end_at_the_program_or_command", run: fn(t) { test_options_end_at_the_program_or_command(t, shared) } }
        testing.Test { name: "lone_dash_is_an_operand", run: fn(t) { test_lone_dash_is_an_operand(t, shared) } }
        testing.Test { name: "run_help_lists_the_targets_it_can_run", run: fn(t) { test_run_help_lists_the_targets_it_can_run(t, shared) } }
        testing.Test { name: "long_option_spellings_are_equivalent", run: fn(t) { test_long_option_spellings_are_equivalent(t, shared) } }
        testing.Test { name: "output_spellings_are_equivalent", run: fn(t) { test_output_spellings_are_equivalent(t, shared) } }
        testing.Test { name: "run_gives_the_program_its_arguments", run: fn(t) { test_run_gives_the_program_its_arguments(t, shared) } }
        testing.Test { name: "test_cache_replays_passes_until_an_input_changes", run: fn(t) { test_test_cache_replays_passes_until_an_input_changes(t, shared) } }
        testing.Test { name: "test_programs_are_reused_until_an_input_changes", run: fn(t) { test_test_programs_are_reused_until_an_input_changes(t, shared) } }
        testing.Test { name: "test_processes_wait_for_a_machine_slot", run: fn(t) { test_test_processes_wait_for_a_machine_slot(t, shared) } }
        testing.Test { name: "prof_samples_a_program", run: fn(t) { test_prof_samples_a_program(t, shared) } }
        testing.Test { name: "abbench_compares_two_programs", run: fn(t) { test_abbench_compares_two_programs(t, shared) } }
        testing.Test { name: "abbench_same_compares_the_files_both_sides_write", run: fn(t) { test_abbench_same_compares_the_files_both_sides_write(t, shared) } }
        testing.Test { name: "abbench_affinity_restricts_the_runs", run: fn(t) { test_abbench_affinity_restricts_the_runs(t, shared) } }
        testing.Test { name: "protogen_writes_the_modules_the_fixture_compiles", run: fn(t) { test_protogen_writes_the_modules_the_fixture_compiles(t, shared) } }
        testing.Test { name: "protogen_places_the_modules_under_the_module_path", run: fn(t) { test_protogen_places_the_modules_under_the_module_path(t, shared) } }
        testing.Test { name: "protogen_failures_exit_with_status_one", run: fn(t) { test_protogen_failures_exit_with_status_one(t, shared) } }
        testing.Test { name: "context_lists_what_a_function_uses", run: fn(t) { test_context_lists_what_a_function_uses(t, shared) } }
        testing.Test { name: "context_follows_references_to_a_depth", run: fn(t) { test_context_follows_references_to_a_depth(t, shared) } }
        testing.Test { name: "context_budget_cuts_the_deepest_level_first", run: fn(t) { test_context_budget_cuts_the_deepest_level_first(t, shared) } }
        testing.Test { name: "context_lists_callers", run: fn(t) { test_context_lists_callers(t, shared) } }
        testing.Test { name: "context_json_has_one_object_per_line", run: fn(t) { test_context_json_has_one_object_per_line(t, shared) } }
        testing.Test { name: "publish_and_yank_reach_the_build", run: fn(t) { test_publish_and_yank_reach_the_build(t, shared) } }
        testing.Test { name: "fix_applies_every_safe_fix", run: fn(t) { test_fix_applies_every_safe_fix(t, shared) } }
        testing.Test { name: "fix_leaves_unsafe_fixes_alone", run: fn(t) { test_fix_leaves_unsafe_fixes_alone(t, shared) } }
        testing.Test { name: "max_errors_one_stops_at_the_first_error", run: fn(t) { test_max_errors_one_stops_at_the_first_error(t, shared) } }
        testing.Test { name: "json_lists_the_fixes", run: fn(t) { test_json_lists_the_fixes(t, shared) } }
        testing.Test { name: "json_offers_to_remove_unused_declarations", run: fn(t) { test_json_offers_to_remove_unused_declarations(t, shared) } }
        testing.Test { name: "compile_bench", run: test_compile_bench }
    ]
    let args = os.args()
    var settings = testing.settings_from(args[1..]) catch {
        e => {
            print("flags: {e}")
            os.exit(2)
            testing.Settings {}
        }
    }
    let defaults = testing.Settings {}
    if settings.timeout_ms == defaults.timeout_ms {
        settings.timeout_ms = slow_timeout
    }
    let failed = testing.run_with(tests, settings)
    drop_shared_low(shared)
    if failed > 0 {
        os.exit(1)
    }
}
