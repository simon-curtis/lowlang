import std/os
import std/testing

const slow_timeout = 1800000

fn main() {
    let tests = [
        testing.Test { name: "compile_is_deterministic", run: test_compile_is_deterministic }
        testing.Test { name: "browser_module_is_deterministic", run: test_browser_module_is_deterministic }
        testing.Test { name: "blocked_read_does_not_stall_collection", run: test_blocked_read_does_not_stall_collection }
        testing.Test { name: "invalid_memory_access_reports_the_fault", run: test_invalid_memory_access_reports_the_fault }
        testing.Test { name: "stack_overflow_has_no_fault_report", run: test_stack_overflow_has_no_fault_report }
        testing.Test { name: "build_version_prefers_stamp", run: test_build_version_prefers_stamp }
        testing.Test { name: "build_version_names_the_commit_and_build_time", run: test_build_version_names_the_commit_and_build_time }
        testing.Test { name: "build_version_outside_git", run: test_build_version_outside_git }
        testing.Test { name: "build_subsystem", run: test_build_subsystem }
        testing.Test { name: "declared_gui_sets_the_subsystem", run: test_declared_gui_sets_the_subsystem }
        testing.Test { name: "declared_gui_reaches_run_and_install", run: test_declared_gui_reaches_run_and_install }
        testing.Test { name: "declared_icon_reaches_every_windows_program", run: test_declared_icon_reaches_every_windows_program }
        testing.Test { name: "declared_version_and_manifest_reach_every_windows_program", run: test_declared_version_and_manifest_reach_every_windows_program }
        testing.Test { name: "bare_commands_use_the_declared_programs", run: test_bare_commands_use_the_declared_programs }
        testing.Test { name: "bare_commands_with_one_program", run: test_bare_commands_with_one_program }
        testing.Test { name: "bare_commands_without_programs", run: test_bare_commands_without_programs }
        testing.Test { name: "low_test_builds_a_console_harness", run: test_low_test_builds_a_console_harness }
        testing.Test { name: "modules_directory_places_imports_for_every_command", run: test_modules_directory_places_imports_for_every_command }
        testing.Test { name: "declared_programs_of_a_dependency_are_ignored", run: test_declared_programs_of_a_dependency_are_ignored }
        testing.Test { name: "build_map", run: test_build_map }
        testing.Test { name: "install_names_programs_after_their_directory", run: test_install_names_programs_after_their_directory }
        testing.Test { name: "build_names_programs_after_their_directory", run: test_build_names_programs_after_their_directory }
        testing.Test { name: "run_passes_arguments_after_the_program", run: test_run_passes_arguments_after_the_program }
        testing.Test { name: "run_defaults_to_the_current_directory", run: test_run_defaults_to_the_current_directory }
        testing.Test { name: "build_subsystem_rejected", run: test_build_subsystem_rejected }
        testing.Test { name: "top_level_help", run: test_top_level_help }
        testing.Test { name: "every_command_help", run: test_every_command_help }
        testing.Test { name: "colour_is_decided_at_the_write", run: test_colour_is_decided_at_the_write }
        testing.Test { name: "usage_errors", run: test_usage_errors }
        testing.Test { name: "version_takes_no_operands", run: test_version_takes_no_operands }
        testing.Test { name: "options_end_at_the_program_or_command", run: test_options_end_at_the_program_or_command }
        testing.Test { name: "lone_dash_is_an_operand", run: test_lone_dash_is_an_operand }
        testing.Test { name: "run_help_lists_the_targets_it_can_run", run: test_run_help_lists_the_targets_it_can_run }
        testing.Test { name: "long_option_spellings_are_equivalent", run: test_long_option_spellings_are_equivalent }
        testing.Test { name: "output_spellings_are_equivalent", run: test_output_spellings_are_equivalent }
        testing.Test { name: "run_gives_the_program_its_arguments", run: test_run_gives_the_program_its_arguments }
        testing.Test { name: "test_cache_replays_passes_until_an_input_changes", run: test_test_cache_replays_passes_until_an_input_changes }
        testing.Test { name: "prof_samples_a_mapped_program", run: test_prof_samples_a_mapped_program }
        testing.Test { name: "abbench_compares_two_programs", run: test_abbench_compares_two_programs }
        testing.Test { name: "abbench_same_compares_the_files_both_sides_write", run: test_abbench_same_compares_the_files_both_sides_write }
        testing.Test { name: "abbench_affinity_needs_windows", run: test_abbench_affinity_needs_windows }
        testing.Test { name: "protogen_writes_the_modules_the_fixture_compiles", run: test_protogen_writes_the_modules_the_fixture_compiles }
        testing.Test { name: "protogen_places_the_modules_under_the_module_path", run: test_protogen_places_the_modules_under_the_module_path }
        testing.Test { name: "protogen_failures_exit_with_status_one", run: test_protogen_failures_exit_with_status_one }
        testing.Test { name: "publish_and_yank_reach_the_build", run: test_publish_and_yank_reach_the_build }
        testing.Test { name: "compile_bench", run: test_compile_bench }
    ]
    let args = os.args()
    var settings = testing.settings_from(args[1..]) catch {
        e => {
            print("flags: {e}")
            os.exit(2)
            testing.Settings {}
        }
    }
    let defaults = testing.Settings {}
    if settings.timeout_ms == defaults.timeout_ms {
        settings.timeout_ms = slow_timeout
    }
    let failed = testing.run_with(tests, settings)
    if failed > 0 {
        os.exit(1)
    }
}
