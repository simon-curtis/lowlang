import std/os
import std/testing

const slow_timeout = 1800000

fn main() {
    let tests = [
        testing.Test { name: "compile_is_deterministic", run: test_compile_is_deterministic }
        testing.Test { name: "browser_module_is_deterministic", run: test_browser_module_is_deterministic }
        testing.Test { name: "blocked_read_does_not_stall_collection", run: test_blocked_read_does_not_stall_collection }
        testing.Test { name: "build_version_prefers_stamp", run: test_build_version_prefers_stamp }
        testing.Test { name: "build_version_unstamped", run: test_build_version_unstamped }
        testing.Test { name: "compile_bench", run: test_compile_bench }
    ]
    let args = os.args()
    var settings = testing.settings_from(args[1..]) catch {
        e => {
            print("flags: {e}")
            os.exit(2)
            testing.Settings {}
        }
    }
    let defaults = testing.Settings {}
    if settings.timeout_ms == defaults.timeout_ms {
        settings.timeout_ms = slow_timeout
    }
    let failed = testing.run_with(tests, settings)
    if failed > 0 {
        os.exit(1)
    }
}
