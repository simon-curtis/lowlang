import std/file
import std/testing
import std/text

const two_errors_source = "fn total(values: i64[]) -> i64 {{\n    var sum = 0\n    for value in values {{\n        sum += value\n    }}\n    sum + \"0\"\n}}\n\nfn label(count: i64) -> str {{\n    let shown: str = count\n    shown\n}}\n\nfn main() {{\n    print(total([1, 2]))\n    print(label(3))\n}}\n"

const unused_label_source = "fn main() {{\n    outer: for step in 0..3 {{\n        print(step)\n    }}\n}}\n"

fn test_max_errors_one_stops_at_the_first_error(t: *testing.T, shared: *SharedLow) {
    let c = new_commands(t, shared)
    defer file.remove_all(c.dir) or {}
    placed(t, c, "two", two_errors_source)
    if t.failed() {
        return
    }
    let program = file.child_path(c.dir, "program")
    let name = file.child_path("two", "main.low")
    let first = plain(t, c, ["build", "--max-errors", "1", "-o", program, "two"])
    t.equal(first.status, 1)
    t.equal(first.err, "{name}:6:11: expected i64, found str [type-mismatch]\n")
}

fn test_json_lists_the_fixes(t: *testing.T, shared: *SharedLow) {
    let c = new_commands(t, shared)
    defer file.remove_all(c.dir) or {}
    placed(t, c, "label", unused_label_source)
    if t.failed() {
        return
    }
    let got = plain(t, c, ["build", "--json", "-o", file.child_path(c.dir, "program"), "label"])
    t.equal(got.status, 1)
    t.equal(text.count(got.err, "\n"), 1)
    t.is_true(text.starts_with(got.err, "{{\"event\":\"diagnostic\",\"code\":\"unused-label\",\"severity\":\"error\",\"file\":"))
    t.is_true(text.contains(got.err, "\"line\":2,\"column\":12,\"end_line\":2,\"end_column\":15,\"message\":\"label outer is not used\",\"related\":[],\"fixes\":[{{\"title\":\"Remove the label outer\",\"safe\":true,\"edits\":[{{\"file\":"))
    t.is_true(text.ends_with(got.err, "\"line\":2,\"column\":5,\"end_line\":2,\"end_column\":12,\"text\":\"\"}}]}}]}}\n"))
}
