import native
import std/file
import std/os
import std/path
import std/process
import std/slices
import std/testing
import std/text
import std/time

const probe_source = "import std/file\nimport std/os\nimport std/process\nimport std/testing\n\nfn test_runs_itself(t: *testing.T) {{\n    let command = process.command(os.args()[0], [\"-list\"])\n    let result = process.run(command, []) catch {{\n        e => {{\n            t.fatal(\"{{e}}\")\n            return\n        }}\n    }}\n    t.is_true(result.stdout.len > 0)\n}}\n\nfn test_reads_data(t: *testing.T) {{\n    let contents = file.read_text(\"data.txt\") or return\n    t.is_true(contents.len > 0)\n}}\n\nfn test_reads_environment(t: *testing.T) {{\n    let value = os.env(\"CACHE_PROBE\") ?? \"\"\n    t.is_true(value.len > 0)\n}}\n\nfn test_lists_directory(t: *testing.T) {{\n    let names = file.list(\"items\") or return\n    t.is_true(names.len > 0)\n}}\n\nfn test_always_fails(t: *testing.T) {{\n    t.fatal(\"fails on purpose\")\n}}\n"
const settled_age_seconds = 3600

struct Probe {
    dir: str
    low: str
    project: str
    module: str
    cache: str
}

fn new_probe(t: *testing.T) -> Probe {
    let dir = file.temp_dir("test-cache-") catch {
        e => {
            t.fatal("{e}")
            return Probe { dir: "", low: "", project: "", module: "", cache: "" }
        }
    }
    let low = build_low(t, dir, native.overlay())
    let project = file.child_path(dir, "project")
    let module = file.child_path(project, "probe")
    let cache = file.child_path(dir, "cache")
    let probe = Probe { dir, low, project, module, cache }
    let marker = file.child_path(project, "low.mod")
    write_fixture(t, marker, "")
    put(t, probe, "probe_test.low", probe_source)
    put(t, probe, "data.txt", "one\n")
    put(t, probe, "items/a.txt", "a\n")
    settle(t, module)
    settle(t, project)
    probe
}

fn settle(t: *testing.T, location: str) {
    let past = time.now() - settled_age_seconds
    file.set_times(location, past, past) catch {
        e => t.fatal("backdate {location}: {e}")
    }
}

fn put(t: *testing.T, p: Probe, name: str, content: str) {
    let location = file.child_path(p.module, name)
    write_fixture(t, location, content)
}

fn write_fixture(t: *testing.T, location: str, content: str) {
    let parent = path.dir(location)
    file.mkdir_all(parent) catch {
        e => t.fatal("create {parent}: {e}")
    }
    file.write_text(location, content) catch {
        e => t.fatal("write {location}: {e}")
    }
    settle(t, location)
    settle(t, parent)
}

fn run_tests(t: *testing.T, p: Probe, probe_value: str, flags: []str) -> str {
    var env = os.environment()
    env["LOW_CACHE"] = p.cache
    env["CACHE_PROBE"] = probe_value
    let args = slices.concat(["test", "probe", "-notime"], flags)
    var command = process.command(p.low, args)
    command.env = env
    command.dir = p.project
    let result = process.run(command, []) catch {
        e => {
            t.fatal("{p.low}: {e}")
            return ""
        }
    }
    "{str(result.stdout)}{str(result.stderr)}"
}

fn expect_run(t: *testing.T, p: Probe, probe_value: str, flags: []str, cached: i64) {
    let got = run_tests(t, p, probe_value, flags)
    var want = "1 failed, 4 passed\n"
    if cached > 0 {
        want = "1 failed, 4 passed ({cached} cached)\n"
    }
    if !text.contains(got, want) {
        t.error("want {text.quote(want)} in:\n{got}")
    }
}

fn test_test_cache_replays_passes_until_an_input_changes(t: *testing.T) {
    let p = new_probe(t)
    defer file.remove_all(p.dir) or {}
    if t.failed() {
        return
    }
    expect_run(t, p, "a", [], 0)
    expect_run(t, p, "a", [], 3)
    expect_run(t, p, "b", [], 2)
    expect_run(t, p, "b", [], 3)
    put(t, p, "data.txt", "two\n")
    expect_run(t, p, "b", [], 2)
    expect_run(t, p, "b", [], 3)
    put(t, p, "items/b.txt", "b\n")
    expect_run(t, p, "b", [], 2)
    expect_run(t, p, "b", [], 3)
    expect_run(t, p, "b", ["-nocache"], 0)
    let failing = ["-run", "always_fails"]
    let first = run_tests(t, p, "b", failing)
    let second = run_tests(t, p, "b", failing)
    t.is_false(text.contains(first, "cached"))
    t.is_false(text.contains(second, "cached"))
    t.contains(second, "FAIL probe 1 failed, 0 passed\n")
}
