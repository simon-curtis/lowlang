import native
import oracletool
import target
import std/file
import std/os
import std/path
import std/process
import std/testing
import std/text

const peek_source = "import std/file\nimport std/os\n\nfn main() {{\n    let image = file.read_file(os.args()[0]) catch {{\n        _ => {{\n            print(\"unreadable\")\n            return\n        }}\n    }}\n    let header = i64(image[60]) + i64(image[61]) * 256\n    let at = header + 24 + 68\n    print(\"{{i64(image[at]) + i64(image[at + 1]) * 256}}\")\n}}\n"

const harness_test_source = "import std/file\nimport std/os\nimport std/testing\n\nfn test_harness_is_a_console_program(t: *testing.T) {{\n    let image = file.read_file(os.args()[0]) catch {{\n        e => {{\n            t.fatal(\"read: {{e}}\")\n            return\n        }}\n    }}\n    let header = i64(image[60]) + i64(image[61]) * 256\n    let at = header + 24 + 68\n    t.equal(i64(image[at]) + i64(image[at + 1]) * 256, 3)\n}}\n"

struct Declared {
    low: str
    dir: str
    bin: str
}

fn new_declared(t: *testing.T) -> Declared {
    let dir = file.temp_dir("declared-") catch {
        e => {
            t.fatal("{e}")
            return Declared { low: "", dir: "", bin: "" }
        }
    }
    let low = build_low(t, dir, native.overlay())
    let work = file.child_path(dir, "work")
    Declared { low, dir: work, bin: file.child_path(dir, "bin") }
}

fn place_file(t: *testing.T, d: Declared, name: str, content: str) {
    let location = file.child_path(d.dir, name)
    file.mkdir_all(path.dir(location)) catch {
        e => t.fatal("create {path.dir(location)}: {e}")
    }
    file.write_text(location, content) catch {
        e => t.fatal("write {location}: {e}")
    }
}

fn low_result(t: *testing.T, d: Declared, name: str, args: []str) -> process.Output {
    var env = os.environment()
    env["LOW_BIN"] = d.bin
    var command = process.command(d.low, args)
    command.env = env
    command.dir = file.child_path(d.dir, name)
    process.run(command, []) catch {
        e => {
            t.fatal("{d.low}: {e}")
            process.Output { status: process.Exit.Exited(1), stdout: [], stderr: [] }
        }
    }
}

fn low_succeeds(t: *testing.T, d: Declared, name: str, args: []str) -> str {
    let result = low_result(t, d, name, args)
    if !process.success(result.status) {
        let joined = text.join(args, " ")
        t.fatal("low {joined} in {name}: {str(result.stderr)}")
    }
    text.trim(str(result.stdout))
}

fn low_fails(t: *testing.T, d: Declared, name: str, args: []str) -> str {
    let result = low_result(t, d, name, args)
    if process.success(result.status) {
        let joined = text.join(args, " ")
        t.error("low {joined} in {name} succeeded")
    }
    text.trim(str(result.stderr))
}

fn image_subsystem(t: *testing.T, location: str) -> i64 {
    let image = file.read_file(location) catch {
        e => {
            t.fatal("read {location}: {e}")
            return 0
        }
    }
    let parsed = oracletool.read_pe(image) catch {
        e => {
            t.fatal("parse {location}: {oracletool.message(e)}")
            return 0
        }
    }
    match parsed.header {
        some(header) => header.subsystem
        none => {
            t.fatal("{location} has no optional header")
            0
        }
    }
}

fn windows_host() -> bool {
    target.host() == target.OS.Windows
}

fn built_subsystem(t: *testing.T, d: Declared, args: []str) -> i64 {
    let output = file.child_path(d.dir, "built.exe")
    var all = ["build", "-target", "windows/amd64", "-o", output]
    for a in args {
        all.push(a)
    }
    low_succeeds(t, d, ".", all)
    image_subsystem(t, output)
}

fn executable(d: Declared, name: str) -> str {
    file.child_path(d.bin, target.executable(target.host(), name))
}

fn run_executable(t: *testing.T, location: str) -> str {
    let result = process.run(process.command(location, []), []) catch {
        e => {
            t.fatal("{location}: {e}")
            return ""
        }
    }
    text.trim(str(result.stdout))
}

fn windowed_project(t: *testing.T, d: Declared) {
    place_file(t, d, "build.low", "import std/build\n\nbuild.gui(\"src/app\")\nbuild.program(\"src/tool\")\n")
    place_file(t, d, "src/app/main.low", peek_source)
    place_file(t, d, "src/tool/main.low", peek_source)
    place_file(t, d, "src/plain/main.low", peek_source)
    place_file(t, d, "other/low.mod", "")
    place_file(t, d, "other/main.low", peek_source)
}

fn test_declared_gui_sets_the_subsystem(t: *testing.T) {
    let d = new_declared(t)
    defer file.remove_all(path.dir(d.dir)) or {}
    if t.failed() {
        return
    }
    windowed_project(t, d)
    place_file(t, d, "plain/low.mod", "")
    place_file(t, d, "plain/main.low", peek_source)
    let gui = oracletool.pe_subsystem_windows_gui
    let console = oracletool.pe_subsystem_windows_cui
    testing.equal(t, built_subsystem(t, d, ["./src/app"]), gui)
    testing.equal(t, built_subsystem(t, d, ["src/app/main.low"]), gui)
    testing.equal(t, built_subsystem(t, d, ["./src/tool"]), console)
    testing.equal(t, built_subsystem(t, d, ["./src/plain"]), console)
    testing.equal(t, built_subsystem(t, d, ["./other"]), console)
    testing.equal(t, built_subsystem(t, d, ["-subsystem", "console", "./src/app"]), console)
    testing.equal(t, built_subsystem(t, d, ["-subsystem", "gui", "./src/tool"]), gui)
    testing.equal(t, built_subsystem(t, d, ["./plain"]), console)
    low_succeeds(t, d, ".", ["build", "-target", "linux/amd64", "-o", file.child_path(d.dir, "built"), "./src/app"])
    low_succeeds(t, d, "src/app", ["build", "-target", "windows/amd64", "-o", file.child_path(d.dir, "built.exe")])
    testing.equal(t, image_subsystem(t, file.child_path(d.dir, "built.exe")), gui)
}

fn test_declared_gui_reaches_run_and_install(t: *testing.T) {
    if !windows_host() {
        t.skip("run and install write a Windows image only on a Windows host")
        return
    }
    let d = new_declared(t)
    defer file.remove_all(path.dir(d.dir)) or {}
    if t.failed() {
        return
    }
    windowed_project(t, d)
    testing.equal(t, low_succeeds(t, d, ".", ["run", "./src/app"]), "2")
    testing.equal(t, low_succeeds(t, d, ".", ["run", "./src/tool"]), "3")
    t.contains(low_fails(t, d, ".", ["run", "-subsystem", "gui", "./src/tool"]), "usage:")
    low_succeeds(t, d, ".", ["install", "./src/app", "./src/tool", "./src/plain"])
    testing.equal(t, run_executable(t, executable(d, "app")), "2")
    testing.equal(t, run_executable(t, executable(d, "tool")), "3")
    testing.equal(t, run_executable(t, executable(d, "plain")), "3")
    let flagged = low_fails(t, d, ".", ["install", "-subsystem", "gui", "./src/tool"])
    t.contains(flagged, "usage:")
}

fn test_bare_commands_use_the_declared_programs(t: *testing.T) {
    let d = new_declared(t)
    defer file.remove_all(path.dir(d.dir)) or {}
    if t.failed() {
        return
    }
    windowed_project(t, d)
    place_file(t, d, "scripts/note.txt", "x")
    for from in [".", "scripts", "src"] {
        let built = low_fails(t, d, from, ["build"])
        t.contains(built, "low build takes one program and this project declares src/app, src/tool; name one")
        let ran = low_fails(t, d, from, ["run"])
        t.contains(ran, "low run takes one program and this project declares src/app, src/tool; name one")
    }
    low_succeeds(t, d, "scripts", ["install"])
    t.is_true(file.exists(executable(d, "app")))
    t.is_true(file.exists(executable(d, "tool")))
    t.is_false(file.exists(executable(d, "scripts")))
    t.is_false(file.exists(executable(d, "plain")))
    if windows_host() {
        testing.equal(t, run_executable(t, executable(d, "app")), "2")
        testing.equal(t, run_executable(t, executable(d, "tool")), "3")
    }
}

fn test_bare_commands_with_one_program(t: *testing.T) {
    let d = new_declared(t)
    defer file.remove_all(path.dir(d.dir)) or {}
    if t.failed() {
        return
    }
    place_file(t, d, "build.low", "import std/build\n\nbuild.gui(\"src/app\")\n")
    place_file(t, d, "src/app/main.low", peek_source)
    place_file(t, d, "docs/note.txt", "x")
    let name = target.executable(target.host(), "app")
    low_succeeds(t, d, "docs", ["build"])
    t.is_true(file.exists(file.child_path(file.child_path(d.dir, "docs"), name)))
    low_succeeds(t, d, ".", ["build", "-o", "{d.dir}/out/"])
    t.is_true(file.exists(file.child_path(file.child_path(d.dir, "out"), name)))
    low_succeeds(t, d, ".", ["install"])
    t.is_true(file.exists(executable(d, "app")))
    if windows_host() {
        testing.equal(t, low_succeeds(t, d, ".", ["run"]), "2")
        testing.equal(t, low_succeeds(t, d, "docs", ["run", "-c", "debug"]), "2")
        testing.equal(t, run_executable(t, file.child_path(file.child_path(d.dir, "docs"), name)), "2")
    }
}

fn test_bare_commands_without_programs(t: *testing.T) {
    let d = new_declared(t)
    defer file.remove_all(path.dir(d.dir)) or {}
    if t.failed() {
        return
    }
    place_file(t, d, "build.low", "import std/build\n\nbuild.title(\"app\")\n")
    place_file(t, d, "src/app/main.low", peek_source)
    for command in ["build", "run", "install"] {
        t.equal(low_fails(t, d, ".", [command]), ".: no .low files")
    }
    place_file(t, d, "other/build.low", "import std/build\n\nbuild.gui(\"missing\")\n")
    place_file(t, d, "other/src/note.txt", "x")
    let missing = low_fails(t, d, "other/src", ["install"])
    t.contains(missing, "missing: no such directory")
}

fn test_low_test_builds_a_console_harness(t: *testing.T) {
    if !windows_host() {
        t.skip("a Windows image is read only on a Windows host")
        return
    }
    let d = new_declared(t)
    defer file.remove_all(path.dir(d.dir)) or {}
    if t.failed() {
        return
    }
    place_file(t, d, "build.low", "import std/build\n\nbuild.gui(\"windowed\")\n")
    place_file(t, d, "windowed/windowed.low", "pub fn answer() -> i64 {{\n    42\n}}\n")
    place_file(t, d, "windowed/windowed_test.low", harness_test_source)
    let report = low_succeeds(t, d, ".", ["test", "windowed", "-nocache", "-notime"])
    t.contains(report, "1 passed")
}

fn modules_project(t: *testing.T, d: Declared) {
    place_file(t, d, "build.low", "import std/build\n\nbuild.modules(\"src\")\nbuild.gui(\"src/app\")\n")
    place_file(t, d, "src/app/main.low", "import lib_a\n\nfn main() {{\n    print(\"{{lib_a.value}}\")\n}}\n")
    place_file(t, d, "src/lib_a/lib_a.low", "pub const value = 42\n")
    place_file(t, d, "src/lib_a/lib_a_test.low", "import std/testing\n\nfn test_value(t: *testing.T) {{\n    testing.equal(t, value, 42)\n}}\n")
    place_file(t, d, "scripts/tool_test.low", "import std/testing\n\nfn test_tool(t: *testing.T) {{\n}}\n")
}

fn test_modules_directory_places_imports_for_every_command(t: *testing.T) {
    let d = new_declared(t)
    defer file.remove_all(path.dir(d.dir)) or {}
    if t.failed() {
        return
    }
    modules_project(t, d)
    testing.equal(t, built_subsystem(t, d, ["./src/app"]), oracletool.pe_subsystem_windows_gui)
    let inside = low_succeeds(t, d, "src", ["test", "lib_a", "-nocache", "-notime"])
    t.contains(inside, "1 passed")
    let root = low_succeeds(t, d, ".", ["test", "./src/lib_a", "-nocache", "-notime"])
    t.contains(root, "1 passed")
    let outside = low_fails(t, d, ".", ["test", "./scripts", "-nocache", "-notime"])
    t.contains(outside, "scripts: outside the modules directory")
    low_succeeds(t, d, "scripts", ["install"])
    t.is_true(file.exists(executable(d, "app")))
    if windows_host() {
        testing.equal(t, run_executable(t, executable(d, "app")), "42")
        testing.equal(t, low_succeeds(t, d, ".", ["run", "./src/app"]), "42")
    }
    place_file(t, d, "src/low.mod", "")
    let marked = low_fails(t, d, ".", ["install"])
    t.contains(marked, "src/low.mod marks another project root inside the modules directory")
}

fn test_declared_programs_of_a_dependency_are_ignored(t: *testing.T) {
    let d = new_declared(t)
    defer file.remove_all(path.dir(d.dir)) or {}
    if t.failed() {
        return
    }
    place_file(t, d, "build.low", "import std/build\n\nbuild.local(\"dep\")\n")
    place_file(t, d, "dep/build.low", "import std/build\n\nbuild.gui(\"app\")\nbuild.program(\"missing\")\n")
    place_file(t, d, "app/main.low", peek_source)
    testing.equal(t, built_subsystem(t, d, ["./app"]), oracletool.pe_subsystem_windows_cui)
}
