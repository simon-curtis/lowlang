import native
import target
import std/file
import std/os
import std/process
import std/testing
import std/text

const echo_source = "import std/os\n\nfn main() {{\n    let args = os.args()\n    if args.len > 1 {{\n        print(args[1])\n        return\n    }}\n    print(\"hello\")\n}}\n"

struct Commands {
    dir: str
    low: str
    app: str
    bin: str
}

fn new_commands(t: *testing.T) -> Commands {
    let dir = file.temp_dir("commands-") catch {
        e => {
            t.fatal("{e}")
            return Commands { dir: "", low: "", app: "", bin: "" }
        }
    }
    let low = build_low(t, dir, native.overlay())
    let app = file.child_path(dir, "app")
    file.mkdir_all(app) catch {
        e => t.fatal("create {app}: {e}")
    }
    let source = file.child_path(app, "main.low")
    file.write_text(source, echo_source) catch {
        e => t.fatal("write {source}: {e}")
    }
    Commands { dir, low, app, bin: file.child_path(dir, "bin") }
}

fn low_in(t: *testing.T, c: Commands, dir: str, args: []str) -> str {
    var env = os.environment()
    env["LOW_BIN"] = c.bin
    var command = process.command(c.low, args)
    command.env = env
    command.dir = dir
    let result = process.run(command, []) catch {
        e => {
            t.fatal("{c.low}: {e}")
            return ""
        }
    }
    if !process.success(result.status) {
        let joined = text.join(args, " ")
        t.fatal("low {joined}: {str(result.stderr)}")
    }
    text.trim(str(result.stdout))
}

fn app_output(t: *testing.T, dir: str) -> str {
    let program = file.child_path(dir, target.executable(target.host(), "app"))
    let result = process.run(process.command(program, []), []) catch {
        e => {
            t.fatal("{program}: {e}")
            return ""
        }
    }
    text.trim(str(result.stdout))
}

fn test_install_names_programs_after_their_directory(t: *testing.T) {
    let c = new_commands(t)
    defer file.remove_all(c.dir) or {}
    if t.failed() {
        return
    }
    low_in(t, c, c.app, ["install"])
    t.equal(app_output(t, c.bin), "hello")
    low_in(t, c, c.dir, ["install", c.app])
    t.equal(app_output(t, c.bin), "hello")
}

fn test_build_names_programs_after_their_directory(t: *testing.T) {
    let c = new_commands(t)
    defer file.remove_all(c.dir) or {}
    if t.failed() {
        return
    }
    low_in(t, c, c.app, ["build"])
    t.equal(app_output(t, c.app), "hello")
    let out = file.child_path(c.dir, "out")
    low_in(t, c, c.dir, ["build", "-o", "{out}/", c.app])
    t.equal(app_output(t, out), "hello")
    low_in(t, c, c.dir, ["build", "-o", out, c.app])
    t.equal(app_output(t, out), "hello")
    t.is_false(file.exists(c.bin))
}

fn test_run_passes_arguments_after_the_program(t: *testing.T) {
    let c = new_commands(t)
    defer file.remove_all(c.dir) or {}
    if t.failed() {
        return
    }
    t.equal(low_in(t, c, c.dir, ["run", "-c", "debug", c.app, "-v"]), "-v")
}

fn test_run_defaults_to_the_current_directory(t: *testing.T) {
    let c = new_commands(t)
    defer file.remove_all(c.dir) or {}
    if t.failed() {
        return
    }
    t.equal(low_in(t, c, c.app, ["run"]), "hello")
    t.equal(low_in(t, c, c.app, ["run", "-c", "debug"]), "hello")
}
