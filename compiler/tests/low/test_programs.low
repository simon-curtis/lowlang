import std/file
import std/os
import std/process
import std/slices
import std/testing
import std/text

const reused_probe = "import dep\nimport std/testing\n\nfn test_value(t: *testing.T) {{\n    testing.equal(t, value(), 1)\n}}\n\nfn test_word(t: *testing.T) {{\n    testing.equal(t, dep.word, \"a\")\n}}\n\nfn test_embedded(t: *testing.T) {{\n    testing.equal(t, embed(\"data.txt\"), \"x\\n\")\n}}\n"
const reused_value_one = "pub fn value() -> i64 {{\n    1\n}}\n"
const reused_value_two = "pub fn value() -> i64 {{\n    2\n}}\n"
const reused_extra = "import std/testing\n\nfn test_extra(t: *testing.T) {{\n}}\n"

struct Reused {
    dir: str
    low: str
    project: str
    cache: str
}

fn new_reused(t: *testing.T, shared: *SharedLow) -> Reused {
    let dir = file.temp_dir("test-programs-") catch {
        e => {
            t.fatal("{e}")
            return Reused { dir: "", low: "", project: "", cache: "" }
        }
    }
    let r = Reused { dir, low: shared_low(t, shared), project: file.child_path(dir, "project"), cache: file.child_path(dir, "cache") }
    place_reused(t, r, "low.mod", "")
    place_reused(t, r, "probe/probe_test.low", reused_probe)
    place_reused(t, r, "probe/probe.low", reused_value_one)
    place_reused(t, r, "probe/data.txt", "x\n")
    place_reused(t, r, "dep/dep.low", "pub const word = \"a\"\n")
    r
}

fn place_reused(t: *testing.T, r: Reused, name: str, content: str) {
    write_fixture(t, file.child_path(r.project, name), content)
}

fn reused_run(t: *testing.T, r: Reused, flags: []str) -> str {
    var env = os.environment()
    env["LOW_CACHE"] = r.cache
    var command = process.command(r.low, slices.concat(["test", "probe", "--json", "--notime"], flags))
    command.env = env
    command.dir = r.project
    let result = process.run(command, []) catch {
        e => {
            t.fatal("{r.low}: {e}")
            return ""
        }
    }
    "{str(result.stdout)}{str(result.stderr)}"
}

fn expect_reused(t: *testing.T, r: Reused, flags: []str, cached: bool, failed: i64, passed: i64) {
    let got = reused_run(t, r, flags)
    let build = "{{\"event\":\"build\",\"module\":\"probe\",\"ok\":true,\"cached\":{cached}}}\n"
    let result = if failed > 0 { "fail" } else { "ok" }
    let counts = "\"module\":\"probe\",\"result\":\"{result}\",\"failed\":{failed},\"crashed\":0,\"timed_out\":0,\"build_failed\":0,\"passed\":{passed},"
    if !text.contains(got, build) || !text.contains(got, counts) {
        t.error("want {text.quote(build)} and {text.quote(counts)} in:\n{got}")
    }
}

fn test_test_programs_are_reused_until_an_input_changes(t: *testing.T, shared: *SharedLow) {
    let r = new_reused(t, shared)
    defer file.remove_all(r.dir) or {}
    if t.failed() {
        return
    }
    expect_reused(t, r, [], false, 0, 3)
    expect_reused(t, r, [], true, 0, 3)
    place_reused(t, r, "probe/probe.low", reused_value_two)
    expect_reused(t, r, [], false, 1, 2)
    expect_reused(t, r, [], true, 1, 2)
    place_reused(t, r, "probe/probe.low", reused_value_one)
    expect_reused(t, r, [], false, 0, 3)
    place_reused(t, r, "dep/dep.low", "pub const word = \"b\"\n")
    expect_reused(t, r, [], false, 1, 2)
    place_reused(t, r, "dep/dep.low", "pub const word = \"a\"\n")
    place_reused(t, r, "probe/data.txt", "y\n")
    expect_reused(t, r, [], false, 1, 2)
    place_reused(t, r, "probe/data.txt", "x\n")
    place_reused(t, r, "probe/extra_test.low", reused_extra)
    expect_reused(t, r, [], false, 0, 4)
    expect_reused(t, r, [], true, 0, 4)
    expect_reused(t, r, ["--nocache"], false, 0, 4)
}
