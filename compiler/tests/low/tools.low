import target
import std/file
import std/testing
import std/text

const spin_source = "fn spin_fib(n: i64) -> i64 {{\n    if n < 2 {{\n        return n\n    }}\n    spin_fib(n - 1) + spin_fib(n - 2)\n}}\n\nfn main() {{\n    print(spin_fib(36))\n}}\n"

fn on_windows() -> bool {
    target.host() == target.OS.Windows
}

fn refused(r: Invocation) -> bool {
    r.status == 1 && text.contains(r.err, "low prof: the system refuses to sample")
}

fn folded_stacks(t: *testing.T, r: Invocation, folded: str) -> str {
    let _ = t.equal(r.status, 0)
    let _ = t.equal(r.err, "")
    let _ = t.is_true(text.contains(r.out, "\ncategory"))
    let _ = t.is_true(text.contains(r.out, "\nself\n"))
    let _ = t.is_true(text.contains(r.out, "\ninclusive\n"))
    file.read_text(folded) catch {
        e => {
            t.fatal("read {folded}: {e}")
            return ""
        }
    }
}

fn test_prof_samples_a_program(t: *testing.T, shared: *SharedLow) {
    let c = new_commands(t, shared)
    defer file.remove_all(c.dir) or {}
    if t.failed() {
        return
    }
    let map = file.child_path(c.dir, "spin.map")
    let folded = file.child_path(c.dir, "spin.folded")
    let spin = file.child_path(c.dir, "source")
    file.mkdir_all(spin) catch {
        e => t.fatal("create {spin}: {e}")
    }
    file.write_text(file.child_path(spin, "main.low"), spin_source) catch {
        e => t.fatal("write spin: {e}")
    }
    let program = file.child_path(c.dir, target.executable(target.host(), "spin"))
    let built = plain(t, c, ["build", "--map", map, "-o", program, spin])
    let _ = t.equal(built.status, 0)
    if t.failed() {
        return
    }
    if on_windows() {
        let profile = plain(t, c, ["prof", "--map", map, "--folded", folded, program])
        let _ = t.is_true(text.contains(profile.out, "process cycles"))
        let _ = t.is_true(text.contains(folded_stacks(t, profile, folded), "fn_main"))
        return
    }
    let mapped = plain(t, c, ["prof", "--map", map, program])
    let _ = t.equal(mapped.status, 1)
    let _ = t.equal(mapped.err, "low prof: --map names the symbols of a Windows program; a Linux program carries its own\n")
    let profile = plain(t, c, ["prof", "--event", "cpu-clock", "--folded", folded, "--callers", "spin_fib", program])
    if refused(profile) {
        t.skip("the system refuses performance events")
        return
    }
    let _ = t.is_true(text.contains(profile.out, "\nwall "))
    let _ = t.is_true(text.contains(profile.out, " samples of cpu-clock\n"))
    let _ = t.is_true(text.contains(profile.out, "\ncallers of spin_fib, "))
    let _ = t.is_true(text.contains(folded_stacks(t, profile, folded), "rt_program;fn_main;fn_spin_fib"))
    let grown = plain(t, c, ["prof", "--event", "faults", program])
    let _ = t.equal(grown.status, 0)
    let _ = t.is_true(text.contains(grown.out, " samples of faults\n"))
    let child = plain(t, c, ["prof", "--event", "cpu-clock", "--folded", folded, c.low, "run", spin])
    let _ = t.is_true(text.contains(folded_stacks(t, child, folded), "rt_program;fn_main;fn_spin_fib"))
    let unknown = plain(t, c, ["prof", "--event", "heat", program])
    let _ = t.equal(unknown.status, 1)
    t.equal(unknown.err, "low prof: unknown event heat\n")
}

fn test_abbench_compares_two_programs(t: *testing.T, shared: *SharedLow) {
    let c = new_commands(t, shared)
    defer file.remove_all(c.dir) or {}
    if t.failed() {
        return
    }
    let got = plain(t, c, ["abbench", "--a", c.low, "--b", c.low, "--runs", "5", "--warmup", "0", "{{exe}}", "version"])
    let _ = t.equal(got.status, 0)
    let _ = t.is_true(text.contains(got.err, "run 5/5"))
    let _ = t.is_true(text.contains(got.out, "5 runs of each side, alternating ab and ba"))
    let _ = t.is_true(text.contains(got.out, "\nwall "))
    let _ = t.is_true(text.contains(got.out, "b/a"))
    t.is_true(text.contains(got.out, if on_windows() { "\npeak private " } else { "\npeak resident " }))
}

fn test_abbench_same_compares_the_files_both_sides_write(t: *testing.T, shared: *SharedLow) {
    let c = new_commands(t, shared)
    defer file.remove_all(c.dir) or {}
    if t.failed() {
        return
    }
    let program = target.executable(target.host(), "out-{{side}}")
    let same = plain(t, c, ["abbench", "--a", c.low, "--b", c.low, "--runs", "5", "--dir", c.dir, "--same", program, "{{exe}}", "build", "app", "-o", program])
    let _ = t.equal(same.status, 0)
    let _ = t.is_true(text.contains(same.err, " are identical\n"))
    let missing = plain(t, c, ["abbench", "--a", c.low, "--b", c.low, "--dir", c.dir, "--same", "gone-{{side}}", "{{exe}}", "version"])
    let _ = t.equal(missing.status, 1)
    let _ = t.equal(missing.out, "")
    let _ = t.is_true(text.contains(missing.err, "low abbench: "))
    t.is_true(text.contains(missing.err, "gone-a"))
}

fn test_abbench_affinity_restricts_the_runs(t: *testing.T, shared: *SharedLow) {
    if on_windows() {
        t.skip("the allowed CPUs are read from /proc")
        return
    }
    let c = new_commands(t, shared)
    defer file.remove_all(c.dir) or {}
    if t.failed() {
        return
    }
    let got = plain(t, c, ["abbench", "--a", c.low, "--b", c.low, "--runs", "5", "--warmup", "0", "--affinity", "1", "--dir", c.dir, "sh", "-c", "grep Cpus_allowed_list /proc/self/status > allowed-{{side}}"])
    let _ = t.equal(got.status, 0)
    let allowed = file.read_text(file.child_path(c.dir, "allowed-b")) catch {
        e => {
            t.fatal("read allowed-b: {e}")
            return
        }
    }
    t.equal(text.join(text.fields(allowed), " "), "Cpus_allowed_list: 0")
}

const generated_protos = "testdata/run/std_protobuf_generated"

fn golden_paths() -> []str {
    ["all/all.low", "rich/rich.low", "items/items.low", "kinds/kinds.low", "google/protobuf/duration/duration.low", "google/protobuf/timestamp/timestamp.low"]
}

fn read_file_text(t: *testing.T, name: str) -> str {
    file.read_text(name) catch {
        e => {
            t.fatal("read {name}: {e}")
            return ""
        }
    }
}

fn test_protogen_writes_the_modules_the_fixture_compiles(t: *testing.T, shared: *SharedLow) {
    let c = new_commands(t, shared)
    defer file.remove_all(c.dir) or {}
    if t.failed() {
        return
    }
    let out = file.child_path(c.dir, "out")
    let protos = "{generated_protos}/protos"
    let got = invoke(t, c, [:], "", ["protogen", "-I", protos, "-o", out, "all.proto", "rich.proto", "items.proto", "kinds.proto"])
    let _ = t.equal(got.status, 0)
    let _ = t.equal(got.out, "")
    let _ = t.equal(got.err, "")
    for name in golden_paths() {
        t.equal(read_file_text(t, file.child_path(out, name)), read_file_text(t, "{generated_protos}/{name}"))
    }
    let spellings: [][]str = [
        ["protogen", "--include", protos, "--output", "@", "all.proto", "rich.proto", "items.proto", "kinds.proto"]
        ["protogen", "--include={protos}", "--output=@", "all.proto", "rich.proto", "items.proto", "kinds.proto"]
        ["protogen", "all.proto", "-I{protos}", "-o@", "rich.proto", "items.proto", "kinds.proto"]
    ]
    for i, spelling in spellings {
        let target = file.child_path(c.dir, "again{i}")
        var args: []str = []
        for a in spelling {
            args.push(text.replace(a, "@", target))
        }
        let again = invoke(t, c, [:], "", args)
        let _ = t.equal(again.status, 0)
        for name in golden_paths() {
            t.equal(read_file_text(t, file.child_path(target, name)), read_file_text(t, file.child_path(out, name)))
        }
    }
}

fn test_protogen_places_the_modules_under_the_module_path(t: *testing.T, shared: *SharedLow) {
    let c = new_commands(t, shared)
    defer file.remove_all(c.dir) or {}
    if t.failed() {
        return
    }
    let plain_out = file.child_path(c.dir, "plain")
    let placed_out = file.child_path(c.dir, "placed")
    let protos = "{generated_protos}/protos"
    let _ = t.equal(invoke(t, c, [:], "", ["protogen", "-I", protos, "-o", plain_out, "rich.proto"]).status, 0)
    let _ = t.equal(invoke(t, c, [:], "", ["protogen", "-I", protos, "--module", "gen", "-o", placed_out, "rich.proto"]).status, 0)
    let plain_text = read_file_text(t, file.child_path(plain_out, "rich/rich.low"))
    let placed_text = read_file_text(t, file.child_path(placed_out, "rich/rich.low"))
    let _ = t.is_true(text.contains(placed_text, "import gen/google/protobuf/timestamp\n"))
    t.is_true(text.contains(plain_text, "import google/protobuf/timestamp\n"))
}

fn test_protogen_failures_exit_with_status_one(t: *testing.T, shared: *SharedLow) {
    let c = new_commands(t, shared)
    defer file.remove_all(c.dir) or {}
    if t.failed() {
        return
    }
    let out = file.child_path(c.dir, "out")
    let missing = plain(t, c, ["protogen", "-o", out, "absent.proto"])
    let _ = t.equal(missing.status, 1)
    let _ = t.equal(missing.out, "")
    let _ = t.is_true(text.starts_with(missing.err, "low protogen: "))
    let _ = t.is_true(text.contains(missing.err, "absent.proto"))
    t.is_false(file.exists(out))
}
