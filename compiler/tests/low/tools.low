import target
import std/file
import std/testing
import std/text

const spin_source = "fn work(n: i64) -> i64 {{\n    var x = 0\n    for i in 0..n {{\n        x += i % 7 + x % 3\n    }}\n    x\n}}\n\nfn main() {{\n    print(work(100000000))\n}}\n"

fn on_windows() -> bool {
    target.host() == target.OS.Windows
}

fn test_prof_samples_a_mapped_program(t: *testing.T) {
    let c = new_commands(t)
    defer file.remove_all(c.dir) or {}
    if t.failed() {
        return
    }
    let map = file.child_path(c.dir, "spin.map")
    let folded = file.child_path(c.dir, "spin.folded")
    let spin = file.child_path(c.dir, "spin")
    file.mkdir_all(spin) catch {
        e => t.fatal("create {spin}: {e}")
    }
    file.write_text(file.child_path(spin, "main.low"), spin_source) catch {
        e => t.fatal("write spin: {e}")
    }
    let program = file.child_path(c.dir, target.executable(target.host(), "spin"))
    let built = plain(t, c, ["build", "--map", map, "-o", program, spin])
    t.equal(built.status, 0)
    if t.failed() {
        return
    }
    let profile = plain(t, c, ["prof", "--map", map, "--folded", folded, program])
    if !on_windows() {
        t.equal(profile.status, 1)
        t.equal(profile.out, "")
        t.equal(profile.err, "low prof: sampling is supported on Windows only\n")
        return
    }
    t.equal(profile.status, 0)
    t.equal(profile.err, "")
    t.is_true(text.contains(profile.out, "process cycles"))
    t.is_true(text.contains(profile.out, "\ncategory"))
    t.is_true(text.contains(profile.out, "\nself\n"))
    t.is_true(text.contains(profile.out, "\ninclusive\n"))
    let stacks = file.read_text(folded) catch {
        e => {
            t.fatal("read {folded}: {e}")
            return
        }
    }
    t.is_true(text.contains(stacks, "fn_main"))
}

fn test_abbench_compares_two_programs(t: *testing.T) {
    let c = new_commands(t)
    defer file.remove_all(c.dir) or {}
    if t.failed() {
        return
    }
    let got = plain(t, c, ["abbench", "--a", c.low, "--b", c.low, "--runs", "5", "--warmup", "0", "{{exe}}", "version"])
    t.equal(got.status, 0)
    t.is_true(text.contains(got.err, "run 5/5"))
    t.is_true(text.contains(got.out, "5 runs of each side, alternating ab and ba"))
    t.is_true(text.contains(got.out, "\nwall "))
    t.is_true(text.contains(got.out, "b/a"))
    t.equal(text.contains(got.out, "\ncycles "), on_windows())
    t.equal(text.contains(got.out, "\npeak private "), on_windows())
}

fn test_abbench_same_compares_the_files_both_sides_write(t: *testing.T) {
    let c = new_commands(t)
    defer file.remove_all(c.dir) or {}
    if t.failed() {
        return
    }
    let program = target.executable(target.host(), "out-{{side}}")
    let same = plain(t, c, ["abbench", "--a", c.low, "--b", c.low, "--runs", "5", "--dir", c.dir, "--same", program, "{{exe}}", "build", "app", "-o", program])
    t.equal(same.status, 0)
    t.is_true(text.contains(same.err, " are identical\n"))
    let missing = plain(t, c, ["abbench", "--a", c.low, "--b", c.low, "--dir", c.dir, "--same", "gone-{{side}}", "{{exe}}", "version"])
    t.equal(missing.status, 1)
    t.equal(missing.out, "")
    t.is_true(text.contains(missing.err, "low abbench: "))
    t.is_true(text.contains(missing.err, "gone-a"))
}

fn test_abbench_affinity_needs_windows(t: *testing.T) {
    if on_windows() {
        t.skip("CPU affinity is applied on Windows")
        return
    }
    let c = new_commands(t)
    defer file.remove_all(c.dir) or {}
    if t.failed() {
        return
    }
    let got = plain(t, c, ["abbench", "--a", c.low, "--b", c.low, "--affinity", "0xFFFFFFFFFFFFFFFF", "{{exe}}", "version"])
    t.equal(got.status, 1)
    t.equal(got.out, "")
    t.equal(got.err, "low abbench: CPU affinity is supported on Windows only\n")
}

const generated_protos = "testdata/run/std_protobuf_generated"

fn golden_paths() -> []str {
    ["all/all.low", "rich/rich.low", "items/items.low", "kinds/kinds.low", "google/protobuf/duration/duration.low", "google/protobuf/timestamp/timestamp.low"]
}

fn read_file_text(t: *testing.T, name: str) -> str {
    file.read_text(name) catch {
        e => {
            t.fatal("read {name}: {e}")
            return ""
        }
    }
}

fn test_protogen_writes_the_modules_the_fixture_compiles(t: *testing.T) {
    let c = new_commands(t)
    defer file.remove_all(c.dir) or {}
    if t.failed() {
        return
    }
    let out = file.child_path(c.dir, "out")
    let protos = "{generated_protos}/protos"
    let got = invoke(t, c, [:], "", ["protogen", "-I", protos, "-o", out, "all.proto", "rich.proto", "items.proto", "kinds.proto"])
    t.equal(got.status, 0)
    t.equal(got.out, "")
    t.equal(got.err, "")
    for name in golden_paths() {
        t.equal(read_file_text(t, file.child_path(out, name)), read_file_text(t, "{generated_protos}/{name}"))
    }
    let spellings: [][]str = [
        ["protogen", "--include", protos, "--output", "@", "all.proto", "rich.proto", "items.proto", "kinds.proto"]
        ["protogen", "--include={protos}", "--output=@", "all.proto", "rich.proto", "items.proto", "kinds.proto"]
        ["protogen", "all.proto", "-I{protos}", "-o@", "rich.proto", "items.proto", "kinds.proto"]
    ]
    for i, spelling in spellings {
        let target = file.child_path(c.dir, "again{i}")
        var args: []str = []
        for a in spelling {
            args.push(text.replace(a, "@", target))
        }
        let again = invoke(t, c, [:], "", args)
        t.equal(again.status, 0)
        for name in golden_paths() {
            t.equal(read_file_text(t, file.child_path(target, name)), read_file_text(t, file.child_path(out, name)))
        }
    }
}

fn test_protogen_places_the_modules_under_the_module_path(t: *testing.T) {
    let c = new_commands(t)
    defer file.remove_all(c.dir) or {}
    if t.failed() {
        return
    }
    let plain_out = file.child_path(c.dir, "plain")
    let placed_out = file.child_path(c.dir, "placed")
    let protos = "{generated_protos}/protos"
    t.equal(invoke(t, c, [:], "", ["protogen", "-I", protos, "-o", plain_out, "rich.proto"]).status, 0)
    t.equal(invoke(t, c, [:], "", ["protogen", "-I", protos, "--module", "gen", "-o", placed_out, "rich.proto"]).status, 0)
    let plain_text = read_file_text(t, file.child_path(plain_out, "rich/rich.low"))
    let placed_text = read_file_text(t, file.child_path(placed_out, "rich/rich.low"))
    t.is_true(text.contains(placed_text, "import gen/google/protobuf/timestamp\n"))
    t.is_true(text.contains(plain_text, "import google/protobuf/timestamp\n"))
}

fn test_protogen_failures_exit_with_status_one(t: *testing.T) {
    let c = new_commands(t)
    defer file.remove_all(c.dir) or {}
    if t.failed() {
        return
    }
    let out = file.child_path(c.dir, "out")
    let missing = plain(t, c, ["protogen", "-o", out, "absent.proto"])
    t.equal(missing.status, 1)
    t.equal(missing.out, "")
    t.is_true(text.starts_with(missing.err, "low protogen: "))
    t.is_true(text.contains(missing.err, "absent.proto"))
    t.is_false(file.exists(out))
}
