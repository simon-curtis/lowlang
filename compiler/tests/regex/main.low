import regex
import std/file
import std/testing
import std/text

const fixture_base = "testdata/run/std_regex_errors"

fn read_fixture(t: *testing.T, path: str) -> str {
    file.read_text(path) catch {
        e => {
            t.fatal("{path}: {e}")
            return ""
        }
    }
}

fn fixture_patterns(t: *testing.T, path: str) -> []str {
    let data = read_fixture(t, path)
    text.split(text.trim_suffix(data, "\n"), '\n')
}

fn fixture_outcomes(t: *testing.T, path: str) -> []str {
    let data = read_fixture(t, path)
    var outcomes: []str = []
    for line in text.split(data, '\n') {
        if text.starts_with(line, "  ") {
            outcomes.push(text.trim(line))
        }
    }
    outcomes
}

fn outcome(pattern: str) -> str {
    regex.compile(pattern) catch {
        Invalid(at, detail) => return "error at {at}: {detail}"
    }
    ""
}

fn test_compile_agrees_with_std_errors(t: *testing.T) {
    let patterns = fixture_patterns(t, "{fixture_base}/patterns.txt")
    let outcomes = fixture_outcomes(t, "{fixture_base}.out")
    if patterns.len == 0 || patterns.len != outcomes.len {
        t.fatal("{patterns.len} patterns, {outcomes.len} outcomes")
        return
    }
    for i in 0..patterns.len {
        let want = outcomes[i]
        let got = outcome(patterns[i])
        let expects_error = text.starts_with(want, "error at ")
        if expects_error != (got != "") || got != "" && got != want {
            t.error("{patterns[i]}: got {got}, want {want}")
        }
    }
}

fn test_generate_falls_back_for_large_programs(t: *testing.T) {
    let prog = regex.compile("a{{2001}}") catch {
        e => {
            t.fatal(regex.message(e))
            return
        }
    }
    let source = regex.generate("__r", "a{{2001}}", prog)
    t.contains(source, "compile(\"a{{{{2001}}}}\")")
}

fn class_of(t: *testing.T, pattern: str) -> []regex.Range {
    let prog = regex.compile(pattern) catch {
        e => {
            t.fatal(regex.message(e))
            return []
        }
    }
    for inst in prog.insts {
        if inst.op == regex.Op.Class {
            return inst.ranges
        }
    }
    t.fatal("{pattern}: no class instruction")
    []
}

fn covers(ranges: []regex.Range, c: u32) -> bool {
    for r in ranges {
        if c >= r.lo && c <= r.hi {
            return true
        }
    }
    false
}

fn test_fold_follows_unicode_orbits(t: *testing.T) {
    let ranges = class_of(t, "(?i)k")
    t.equal(ranges.len, 3)
    t.is_true(covers(ranges, 0x4B))
    t.is_true(covers(ranges, 0x6B))
    t.is_true(covers(ranges, 0x212A))
    let folded = class_of(t, "(?i)[a-z]")
    t.is_true(covers(folded, 0x212A))
    t.is_true(covers(folded, 0x17F))
    let negated = class_of(t, "(?i)[^k]")
    t.is_false(covers(negated, 0x212A))
    t.is_true(covers(negated, 0x4C))
}

fn test_word_class_is_unicode(t: *testing.T) {
    let ranges = class_of(t, "\\w")
    for c in [0x5F, 0x61, 0xE9, 0x301, 0x663, 0x200D, 0x203F, 0x2163, 0x65E5, 0x1D49C] {
        t.is_true(covers(ranges, u32(c)))
    }
    for c in [0x20, 0x2D, 0xB2, 0x3002, 0x1F600] {
        t.is_false(covers(ranges, u32(c)))
    }
    let complement = class_of(t, "\\W")
    t.is_true(covers(complement, 0x3002))
    t.is_false(covers(complement, 0xE9))
}

fn test_generate_splits_ascii_in_large_classes(t: *testing.T) {
    let prog = regex.compile("\\w+") catch {
        e => {
            t.fatal(regex.message(e))
            return
        }
    }
    let source = regex.generate("__r", "\\w+", prog)
    t.contains(source, "if c < 128 {{")
}

fn test_generate_shares_identical_classes(t: *testing.T) {
    let prog = regex.compile("\\w\\w-\\w") catch {
        e => {
            t.fatal(regex.message(e))
            return
        }
    }
    let source = regex.generate("__r", "\\w\\w-\\w", prog)
    t.equal(text.count(source, "(c: u32) -> bool"), 1)
}

fn main() {
    testing.run([
        testing.Test { name: "compile_agrees_with_std_errors", run: test_compile_agrees_with_std_errors }
        testing.Test { name: "generate_falls_back_for_large_programs", run: test_generate_falls_back_for_large_programs }
        testing.Test { name: "fold_follows_unicode_orbits", run: test_fold_follows_unicode_orbits }
        testing.Test { name: "word_class_is_unicode", run: test_word_class_is_unicode }
        testing.Test { name: "generate_splits_ascii_in_large_classes", run: test_generate_splits_ascii_in_large_classes }
        testing.Test { name: "generate_shares_identical_classes", run: test_generate_shares_identical_classes }
    ])
}
