import regex
import std/file
import std/testing
import std/text

const fixture_base = "testdata/run/std_regex_errors"

fn read_fixture(t: *testing.T, path: str) -> str {
    file.read_text(path) catch {
        e => {
            t.fatal("{path}: {e}")
            return ""
        }
    }
}

fn fixture_patterns(t: *testing.T, path: str) -> []str {
    let data = read_fixture(t, path)
    text.split(text.trim_suffix(data, "\n"), '\n')
}

fn fixture_outcomes(t: *testing.T, path: str) -> []str {
    let data = read_fixture(t, path)
    var outcomes: []str = []
    for line in text.split(data, '\n') {
        if text.starts_with(line, "  ") {
            push(mut outcomes, text.trim(line))
        }
    }
    outcomes
}

fn outcome(pattern: str) -> str {
    regex.compile(pattern) catch {
        Invalid(at, detail) => return "error at {at}: {detail}"
    }
    ""
}

fn test_compile_agrees_with_std_errors(t: *testing.T) {
    let patterns = fixture_patterns(t, "{fixture_base}/patterns.txt")
    let outcomes = fixture_outcomes(t, "{fixture_base}.out")
    if patterns.len == 0 || patterns.len != outcomes.len {
        t.fatal("{patterns.len} patterns, {outcomes.len} outcomes")
        return
    }
    for i in 0..patterns.len {
        let want = outcomes[i]
        let got = outcome(patterns[i])
        let expects_error = text.starts_with(want, "error at ")
        if expects_error != (got != "") || got != "" && got != want {
            t.error("{patterns[i]}: got {got}, want {want}")
        }
    }
}

fn test_generate_falls_back_for_large_programs(t: *testing.T) {
    let prog = regex.compile("a{{2001}}") catch {
        e => {
            t.fatal(regex.message(e))
            return
        }
    }
    let source = regex.generate("__r", "a{{2001}}", prog)
    t.contains(source, "compile(\"a{{{{2001}}}}\")")
}

fn main() {
    testing.run([
        testing.Test { name: "compile_agrees_with_std_errors", run: test_compile_agrees_with_std_errors }
        testing.Test { name: "generate_falls_back_for_large_programs", run: test_generate_falls_back_for_large_programs }
    ])
}
