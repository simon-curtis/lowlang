import compiler
import ir
import native
import oracletool
import spirv
import target
import std/file
import std/process
import std/testing

const fixture = "testdata/run/kernel.low"
const target_env = "vulkan1.2"
const printed = "testdata/run/kernel.out"
const interpreter = "compiler/tests/spirv/parity.py"

fn kernels(t: *testing.T) -> []*ir.Func {
    let unit = native.analyse(fixture, compiler.dev(target.OS.Linux)) catch {
        e => {
            t.fatal(native.message(e))
            return []
        }
    }
    let program = unit.program ?? return []
    var built: []*ir.Func = []
    for k in program.kernels {
        built.push(ir.with_blocks(program, k))
    }
    built
}

fn write_module(t: *testing.T, dir: str, k: *ir.Func) -> str {
    let binary = file.child_path(dir, "{k.name}.spv")
    let module = spirv.generate(k) catch {
        e => {
            t.fatal("{k.name}: {spirv.message(e)}\n{ir.text(k)}")
            return binary
        }
    }
    file.write_file(binary, module) catch {
        e => t.fatal("write {binary}: {testing.format(e)}")
    }
    binary
}

fn module_dir(t: *testing.T) -> str {
    file.temp_dir("low-spirv-") catch {
        e => {
            t.fatal("create temporary directory: {testing.format(e)}")
            ""
        }
    }
}

fn validate(t: *testing.T, dir: str, k: *ir.Func) {
    let binary = t.write_module(dir, k)
    let output = process.run(process.command("spirv-val", ["--target-env", target_env, binary]), []) catch {
        e => {
            t.error("{binary}: {e}")
            return
        }
    }
    if !process.success(output.status) {
        t.error("{k.name}: spirv-val rejects the module\n{str(output.stdout)}{str(output.stderr)}\n{ir.text(k)}")
    }
}

fn test_fixture_kernels_validate(t: *testing.T) {
    oracletool.require(t, "spirv-val", oracletool.spirv_tools)
    let dir = t.module_dir()
    defer file.remove_all(dir) or {}
    let built = t.kernels()
    if built.len == 0 {
        t.error("{fixture} has no kernel builds")
    }
    for k in built {
        t.validate(dir, k)
    }
}

fn test_fixture_kernels_match_native(t: *testing.T) {
    let python = match process.find("python3") {
        some(path) => path
        none => {
            t.skip("python3 is not available")
            return
        }
    }
    let dir = t.module_dir()
    defer file.remove_all(dir) or {}
    for k in t.kernels() {
        let _ = t.write_module(dir, k)
    }
    let output = process.run(process.command(python, [interpreter, dir, printed]), []) catch {
        e => {
            t.error("{interpreter}: {e}")
            return
        }
    }
    if !process.success(output.status) {
        t.error("the modules differ from the native build\n{str(output.stdout)}{str(output.stderr)}")
    }
}

fn main() {
    testing.run([
        testing.Test { name: "fixture_kernels_validate", run: test_fixture_kernels_validate }
        testing.Test { name: "fixture_kernels_match_native", run: test_fixture_kernels_match_native }
    ])
}
