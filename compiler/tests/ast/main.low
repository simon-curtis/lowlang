import ast
import diag
import std/testing

struct WidthCase {
    text: str
    width: i64
    ok: bool
}

fn width_name(c: WidthCase) -> str {
    diag.quote(c.text)
}

fn width_body(t: *testing.T, c: WidthCase) {
    let parsed = ast.parse_width(c.text)
    t.equal(parsed != none, c.ok)
    t.equal(parsed ?? 0, c.width)
}

fn test_parse_width(t: *testing.T) {
    let cases = [
        WidthCase { text: "13", width: 13, ok: true }
        WidthCase { text: "-6", width: -6, ok: true }
        WidthCase { text: " 6 ", width: 6, ok: true }
        WidthCase { text: "", width: 0, ok: false }
        WidthCase { text: "0", width: 0, ok: false }
        WidthCase { text: "-0", width: 0, ok: false }
        WidthCase { text: "- 6", width: 0, ok: false }
        WidthCase { text: "abc", width: 0, ok: false }
        WidthCase { text: "1.5", width: 0, ok: false }
        WidthCase { text: "--2", width: 0, ok: false }
        WidthCase { text: "99999999999999999999", width: 0, ok: false }
    ]
    t.table_of(cases, width_name, width_body)
}

fn parsed(t: *testing.T, source: str) -> *ast.Format {
    match ast.parse_format(source, diag.Pos {}) {
        some(f) => f
        none => {
            t.error("{diag.quote(source)} is rejected")
            new(ast.Format { text: source, pos: diag.Pos {} })
        }
    }
}

struct StandardCase {
    text: str
    kind: u8
    precision: i64
    explicit: bool
}

fn standard_name(c: StandardCase) -> str {
    diag.quote(c.text)
}

fn standard_body(t: *testing.T, c: StandardCase) {
    let f = parsed(t, c.text)
    t.equal(f.kind, c.kind)
    t.equal(f.precision, c.precision)
    t.equal(f.explicit, c.explicit)
}

fn test_parse_standard_format(t: *testing.T) {
    let cases = [
        StandardCase { text: "d", kind: ast.decimal_format, precision: 0, explicit: false }
        StandardCase { text: "d3", kind: ast.decimal_format, precision: 3, explicit: true }
        StandardCase { text: "x8", kind: ast.hex_format, precision: 8, explicit: true }
        StandardCase { text: "X", kind: ast.upper_hex_format, precision: 0, explicit: false }
        StandardCase { text: "b12", kind: ast.binary_format, precision: 12, explicit: true }
        StandardCase { text: "f2", kind: ast.fixed_format, precision: 2, explicit: true }
        StandardCase { text: "e0", kind: ast.scientific_format, precision: 0, explicit: true }
        StandardCase { text: "n", kind: ast.grouped_format, precision: 0, explicit: false }
        StandardCase { text: "f99", kind: ast.fixed_format, precision: 99, explicit: true }
    ]
    t.table_of(cases, standard_name, standard_body)
}

struct PictureCase {
    text: str
    min_int: i64
    min_frac: i64
    max_frac: i64
    group: bool
}

fn picture_name(c: PictureCase) -> str {
    diag.quote(c.text)
}

fn picture_body(t: *testing.T, c: PictureCase) {
    let f = parsed(t, c.text)
    t.equal(f.kind, ast.picture_format)
    t.equal(f.min_int, c.min_int)
    t.equal(f.min_frac, c.min_frac)
    t.equal(f.max_frac, c.max_frac)
    t.equal(f.group, c.group)
}

fn test_parse_picture(t: *testing.T) {
    let cases = [
        PictureCase { text: "##", min_int: 0, min_frac: 0, max_frac: 0, group: false }
        PictureCase { text: "0", min_int: 1, min_frac: 0, max_frac: 0, group: false }
        PictureCase { text: "#.##", min_int: 0, min_frac: 0, max_frac: 2, group: false }
        PictureCase { text: "0.0#", min_int: 1, min_frac: 1, max_frac: 2, group: false }
        PictureCase { text: "#,##0.00", min_int: 1, min_frac: 2, max_frac: 2, group: true }
        PictureCase { text: "0,000", min_int: 4, min_frac: 0, max_frac: 0, group: true }
        PictureCase { text: ".0#", min_int: 0, min_frac: 1, max_frac: 2, group: false }
        PictureCase { text: "#.", min_int: 0, min_frac: 0, max_frac: 0, group: false }
    ]
    t.table_of(cases, picture_name, picture_body)
}

fn test_reject_formats(t: *testing.T) {
    let texts = ["", "q2", "f100", "fx", "f-1", "d 3", " f2", "0.0.0", "#.#%", ",.", ",", ".", "f2 ", "x00000"]
    for source in texts {
        t.is_none(ast.parse_format(source, diag.Pos {}))
    }
}

struct SpecCase {
    text: str
    width: i64
    width_col: i64
    format: str
    format_col: i64
}

fn spec_name(c: SpecCase) -> str {
    diag.quote(c.text)
}

fn spec_body(t: *testing.T, c: SpecCase) {
    let at = diag.Pos { file: "spec", line: 3, col: 10 }
    let spec = ast.parse_spec(c.text, at) catch {
        e => {
            t.fatal(diag.message(e))
            return
        }
    }
    t.equal(spec.width, c.width)
    if c.width != 0 {
        t.equal(spec.width_pos.col, c.width_col)
    }
    match spec.format {
        some(f) => {
            if c.format == "" {
                t.error("format {diag.quote(f.text)} where none was given")
                return
            }
            t.equal(f.text, c.format)
            t.equal(f.pos.col, c.format_col)
        }
        none => t.equal(c.format, "")
    }
}

fn test_parse_spec(t: *testing.T) {
    let cases = [
        SpecCase { text: ":x", width: 0, width_col: 0, format: "x", format_col: 11 }
        SpecCase { text: ",8", width: 8, width_col: 11, format: "", format_col: 0 }
        SpecCase { text: ",-8:#,##0", width: -8, width_col: 11, format: "#,##0", format_col: 14 }
        SpecCase { text: ",  4:f2", width: 4, width_col: 13, format: "f2", format_col: 15 }
    ]
    t.table_of(cases, spec_name, spec_body)
}

struct RejectCase {
    text: str
    want: str
}

fn reject_name(c: RejectCase) -> str {
    diag.quote(c.text)
}

fn reject_body(t: *testing.T, c: RejectCase) {
    let at = diag.Pos { file: "spec", line: 1, col: 5 }
    ast.parse_spec(c.text, at) catch {
        At(pos, msg) => {
            t.equal(msg, c.want)
            return
        }
    }
    t.error("parse_spec accepted {diag.quote(c.text)}")
}

fn test_parse_spec_rejects(t: *testing.T) {
    let cases = [
        RejectCase { text: ",", want: "invalid width \"\"" }
        RejectCase { text: ",0", want: "invalid width \"0\"" }
        RejectCase { text: ",a:x", want: "invalid width \"a\"" }
        RejectCase { text: ":", want: "invalid format \"\"" }
        RejectCase { text: ",3:q", want: "invalid format \"q\"" }
    ]
    t.table_of(cases, reject_name, reject_body)
}

struct IntegerCase {
    text: str
    want: bool
}

fn integer_name(c: IntegerCase) -> str {
    diag.quote(c.text)
}

fn integer_body(t: *testing.T, c: IntegerCase) {
    let f = parsed(t, c.text)
    t.equal(ast.integer_only(f), c.want)
}

fn test_integer_only(t: *testing.T) {
    let cases = [
        IntegerCase { text: "d", want: true }
        IntegerCase { text: "x", want: true }
        IntegerCase { text: "X", want: true }
        IntegerCase { text: "b", want: true }
        IntegerCase { text: "f", want: false }
        IntegerCase { text: "e", want: false }
        IntegerCase { text: "n", want: false }
        IntegerCase { text: "0.0", want: false }
    ]
    t.table_of(cases, integer_name, integer_body)
}

fn main() {
    testing.run([
        testing.Test { name: "parse_width", run: test_parse_width }
        testing.Test { name: "parse_standard_format", run: test_parse_standard_format }
        testing.Test { name: "parse_picture", run: test_parse_picture }
        testing.Test { name: "reject_formats", run: test_reject_formats }
        testing.Test { name: "parse_spec", run: test_parse_spec }
        testing.Test { name: "parse_spec_rejects", run: test_parse_spec_rejects }
        testing.Test { name: "integer_only", run: test_integer_only }
    ])
}
