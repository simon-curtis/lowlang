import diag
import lexer
import std/testing

fn lexed(t: *testing.T, source: str, name: str, privileged: bool) -> []lexer.Token {
    lexer.lex(source, diag.start(name), privileged) catch {
        e => {
            t.fatal("{diag.message(e)}")
            return []
        }
    }
}

fn lex_fails(source: str, name: str, privileged: bool) -> bool {
    lexer.lex(source, diag.start(name), privileged) catch {
        _ => return true
    }
    false
}

fn spellings() -> []str {
    var words: []str = []
    for s in lexer.keyword_spellings() {
        push(mut words, s.text)
    }
    for s in lexer.operator_spellings() {
        push(mut words, s.text)
    }
    words
}

fn test_spellings_round_trip(t: *testing.T) {
    for word in spellings() {
        let tokens = lexer.lex(word, diag.start("spelling"), false) catch {
            e => {
                t.error("{diag.quote(word)} does not lex: {diag.message(e)}")
                continue
            }
        }
        if tokens.len == 0 || lexer.kind_text(tokens[0].kind) != word {
            t.error("{diag.quote(word)} lexes to {tokens.len} tokens")
        }
    }
}

fn test_print_is_not_a_keyword(t: *testing.T) {
    t.is_false(lexer.is_keyword("print"))
}

fn every_byte() -> str {
    var bytes: []u8 = []
    for c in 0..256 {
        push(mut bytes, u8(c))
    }
    str(bytes)
}

fn test_quote_round_trips(t: *testing.T) {
    let texts = ["", "plain", "\"\\{{}}\n\r\0\t'", every_byte()]
    for source in texts {
        let quoted = lexer.quote(source)
        let tokens = lexer.lex(quoted, diag.start("quote"), false) catch {
            e => {
                t.error("quote of {source.len} bytes does not lex: {diag.message(e)}")
                continue
            }
        }
        if tokens.len == 0 || tokens[0].kind != lexer.Kind.String || tokens[0].text != source {
            t.error("quote of {source.len} bytes lexes to {tokens.len} tokens")
        }
    }
}

fn test_char_carries_value(t: *testing.T) {
    let tokens = lexed(t, "'a' '\\n' 'é'", "char", false)
    var got: []i64 = []
    for token in tokens {
        if token.kind == lexer.Kind.Char {
            push(mut got, i64(token.char))
        }
    }
    t.equal_slice(got, [97, 10, 233])
}

fn test_interpolation_is_lexed_once(t: *testing.T) {
    let tokens = lexed(t, "\"a{{x + 1,-8:#,##0}}b\"", "interp", false)
    let parts = tokens[0].parts
    if parts.len != 3 || parts[0].text != "a" || parts[2].text != "b" {
        t.fatal("parts {parts.len}")
        return
    }
    let expr = parts[1]
    t.is_true(expr.tokens[0].kind == lexer.Kind.Ident)
    t.equal(expr.tokens[0].pos.col, 4)
    t.equal(expr.spec, ",-8:#,##0")
    t.equal(expr.spec_pos.col, 9)
}

fn test_interpolation_lex_errors(t: *testing.T) {
    t.is_true(lex_fails("\"{{__x}}\"", "reserved", false))
    t.is_false(lex_fails("\"{{__x}}\"", "privileged", true))
}

fn main() {
    testing.run([
        testing.Test { name: "spellings_round_trip", run: test_spellings_round_trip }
        testing.Test { name: "print_is_not_a_keyword", run: test_print_is_not_a_keyword }
        testing.Test { name: "quote_round_trips", run: test_quote_round_trips }
        testing.Test { name: "char_carries_value", run: test_char_carries_value }
        testing.Test { name: "interpolation_is_lexed_once", run: test_interpolation_is_lexed_once }
        testing.Test { name: "interpolation_lex_errors", run: test_interpolation_lex_errors }
    ])
}
