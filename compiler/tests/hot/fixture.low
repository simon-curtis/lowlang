import hot
import std/cancel
import std/file
import std/path
import std/testing
import std/text
import std/time

struct Fixture {
    t: *testing.T
    path: str
    dir: str
    stdout: *hot.Capture
    stderr: *hot.Capture
    session: *hot.Session
}

fn new_fixture(t: *testing.T, source: str) -> Fixture {
    let dir = temp_dir(t)
    let location = "{dir}/app.low"
    write_file(t, dir, location, source)
    let f = open_session(t, dir, location)
    reload(f)
    f
}

fn temp_dir(t: *testing.T) -> str {
    file.temp_dir("low-hot-") catch {
        e => {
            testing.fatal(t, "create temporary directory: {testing.format(e)}")
            panic("fatal returned")
        }
    }
}

fn open_session(t: *testing.T, dir: str, location: str) -> Fixture {
    let stdout = hot.new_capture()
    let stderr = hot.new_capture()
    let out_sink = hot.Sink.Buffer(stdout)
    let err_sink = hot.Sink.Buffer(stderr)
    let session = hot.new_session(location, out_sink, err_sink) catch {
        e => {
            remove_dir(dir)
            testing.fatal(t, "open session: {hot.message(e)}")
            panic("fatal returned")
        }
    }
    Fixture { t, path: location, dir, stdout, stderr, session }
}

fn close_fixture(f: Fixture) {
    hot.close_session(f.session)
    remove_dir(f.dir)
}

fn remove_dir(dir: str) {
    file.remove_all(dir) or {}
}

fn abort(f: Fixture, message: str) {
    close_fixture(f)
    testing.fatal(f.t, message)
}

fn write_file(t: *testing.T, dir: str, location: str, source: str) {
    let parent = path.dir(location)
    file.mkdir_all(parent) catch {
        e => cleanup_fatal(t, dir, "create {parent}: {testing.format(e)}")
    }
    file.write_text(location, source) catch {
        e => cleanup_fatal(t, dir, "write {location}: {testing.format(e)}")
    }
}

fn cleanup_fatal(t: *testing.T, dir: str, message: str) {
    remove_dir(dir)
    testing.fatal(t, message)
}

fn write_source(f: Fixture, source: str) {
    write_file(f.t, f.dir, f.path, source)
}

fn reload(f: Fixture) {
    let token = cancel.token()
    hot.reload(f.session, token) catch {
        e => abort(f, hot.message(e))
    }
}

fn no_restart(f: Fixture) {
    let err = hot.captured(f.stderr)
    if text.contains(err, "restarted") {
        abort(f, "program restarted instead of reloading:\n{err}")
    }
}

fn wait_for(f: Fixture, buffer: *hot.Capture, want: str) {
    let deadline = time.monotonic() + 5000000000
    for !text.contains(hot.captured(buffer), want) {
        if time.monotonic() > deadline {
            let out = hot.captured(f.stdout)
            let err = hot.captured(f.stderr)
            abort(f, "timed out waiting for \"{want}\"\nstdout:\n{out}\nstderr:\n{err}")
        }
        sleep(5)
    }
}

fn replace_once(source: str, old: str, new_text: str) -> str {
    let at = text.index(source, old)
    if at < 0 {
        return source
    }
    let rest = source[at + old.len..]
    "{source[..at]}{new_text}{rest}"
}
