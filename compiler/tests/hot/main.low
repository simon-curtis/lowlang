import hot
import std/builder
import std/cancel
import std/file
import std/testing
import std/text

fn spin(value: str) -> str {
    text.replace(embed("programs/spin.txt"), "VALUE", value)
}

fn heap(done: str) -> str {
    text.replace(embed("programs/heap.txt"), "DONE", done)
}

fn values(value: str) -> str {
    text.replace(embed("programs/values.txt"), "VALUE", value)
}

fn generic(value: str) -> str {
    text.replace(embed("programs/generic.txt"), "VALUE", value)
}

fn strung(funcs: str, value: str) -> str {
    let with_funcs = text.replace(embed("programs/strung.txt"), "FUNCS", funcs)
    text.replace(with_funcs, "VALUE", value)
}

fn prefixed(prefix: str, value: str) -> str {
    let program = spin(value)
    "{prefix}{program}"
}

fn string_program(k: i64, lengths: []i64, last: bool) -> str {
    var funcs = builder.builder()
    for i in 1..k + 1 {
        let letters = text.repeat("x", lengths[i - 1])
        funcs.write("fn f{i}() -> i64 {{\n    i64(\"{letters}\"[1])\n}}\n\n")
    }
    let want = if last { 2 } else { 1 }
    let value = "f{k}() - 120 + {want}"
    strung(funcs.to_str(), value)
}

fn test_dynamic_reload(t: *testing.T) {
    let empty = "extern \"c\" {{}}\n\n"
    let f = new_fixture(t, prefixed(empty, "1"))
    defer close_fixture(f)
    wait_for(f, f.stdout, "0\n")
    write_source(f, prefixed(empty, "2"))
    reload(f)
    wait_for(f, f.stdout, "0\n2\ntrue\n")
    wait_for(f, f.stderr, "low: reloaded value in")
    no_restart(f)
}

fn test_reload_calling_c(t: *testing.T) {
    let c = "extern \"c\" {{\n    fn labs(n: i64) -> i64\n}}\n\n"
    let f = new_fixture(t, prefixed(c, "labs(1)"))
    defer close_fixture(f)
    wait_for(f, f.stdout, "0\n")
    write_source(f, prefixed(c, "labs(-6)"))
    reload(f)
    wait_for(f, f.stdout, "0\n6\ntrue\n")
    wait_for(f, f.stderr, "low: reloaded value in")
    no_restart(f)
}

fn test_library_change_restarts(t: *testing.T) {
    let f = new_fixture(t, spin("1"))
    defer close_fixture(f)
    wait_for(f, f.stdout, "0\n")
    let math = "extern \"m\" {{\n    fn cbrt(x: f64) -> f64\n}}\n\n"
    write_source(f, prefixed(math, "i64(cbrt(8.0))"))
    reload(f)
    wait_for(f, f.stderr, "low: restarted: linked libraries changed")
    wait_for(f, f.stdout, "0\n0\n2\n")
}

struct Running {
    session: *hot.Session
    token: *cancel.Token
    done: chan[bool]
}

fn drive(r: Running) {
    hot.run(r.session, r.token) or {}
    r.done <- true
}

fn test_run_watches_modules(t: *testing.T) {
    let dir = temp_dir(t)
    write_file(t, dir, "{dir}/low.mod", "")
    write_file(t, dir, "{dir}/main.low", embed("programs/modules_main.txt"))
    let library = "{dir}/lib/lib.low"
    write_file(t, dir, library, text.replace(embed("programs/modules_lib.txt"), "VALUE", "1"))
    let f = open_session(t, dir, dir)
    let running = Running { session: f.session, token: cancel.token(), done: chan[bool](1) }
    spawn drive(running)
    wait_for(f, f.stdout, "0\n")
    write_file(t, dir, library, text.replace(embed("programs/modules_lib.txt"), "VALUE", "4"))
    wait_for(f, f.stdout, "0\n4\n")
    wait_for(f, f.stderr, "low: reloaded lib.value in")
    no_restart(f)
    cancel.cancel(running.token)
    <-running.done
    close_fixture(f)
}

fn test_reload_on_embedded_change(t: *testing.T) {
    let f = new_fixture(t, embed("programs/embedded.txt"))
    defer close_fixture(f)
    wait_for(f, f.stderr, "n.txt: no such file")
    let data = "{f.dir}/n.txt"
    write_file(t, f.dir, data, "a")
    reload(f)
    wait_for(f, f.stdout, "0\n")
    write_file(t, f.dir, data, "abc")
    reload(f)
    wait_for(f, f.stdout, "0\n3\n")
    wait_for(f, f.stderr, "low: reloaded value in")
    no_restart(f)
}

fn test_reload_keeps_state(t: *testing.T) {
    let f = new_fixture(t, spin("1"))
    defer close_fixture(f)
    wait_for(f, f.stdout, "0\n")
    write_source(f, spin("2"))
    reload(f)
    wait_for(f, f.stdout, "0\n2\ntrue\n")
    wait_for(f, f.stderr, "low: reloaded value in")
    no_restart(f)
}

fn test_reload_adds_function(t: *testing.T) {
    let f = new_fixture(t, spin("1"))
    defer close_fixture(f)
    wait_for(f, f.stdout, "0\n")
    let added = replace_once(spin("seven() - 4"), "fn main", "fn seven() -> i64 {{\n    7\n}}\n\nfn main")
    write_source(f, added)
    reload(f)
    wait_for(f, f.stdout, "0\n3\ntrue\n")
    wait_for(f, f.stderr, "low: reloaded seven, value in")
    no_restart(f)
}

fn test_compile_error_keeps_program_running(t: *testing.T) {
    let f = new_fixture(t, spin("1"))
    defer close_fixture(f)
    wait_for(f, f.stdout, "0\n")
    write_source(f, spin("undefined_name"))
    reload(f)
    wait_for(f, f.stderr, "undefined: undefined_name")
    write_source(f, spin("5"))
    reload(f)
    wait_for(f, f.stdout, "0\n5\ntrue\n")
    wait_for(f, f.stderr, "low: reloaded value in")
    no_restart(f)
}

fn test_reload_keeps_heap(t: *testing.T) {
    let f = new_fixture(t, heap("false"))
    defer close_fixture(f)
    wait_for(f, f.stdout, "0\n")
    let scaled = replace_once(embed("programs/heap.txt"), "v + total(*rest)", "2 * v + total(*rest)")
    let finished = text.replace(scaled, "DONE", "true")
    write_source(f, finished)
    reload(f)
    wait_for(f, f.stdout, "0\n10100\n")
    wait_for(f, f.stderr, "low: reloaded done, total in")
    no_restart(f)
}

fn expect_reloaded(f: Fixture, names: []str) {
    let err = hot.captured(f.stderr)
    for name in names {
        if !text.contains(err, name) {
            abort(f, "{name} was not reloaded:\n{err}")
        }
    }
}

fn test_reload_reaches_stored_functions(t: *testing.T) {
    let f = new_fixture(t, values("1"))
    defer close_fixture(f)
    wait_for(f, f.stdout, "0\n")
    write_source(f, values("2"))
    reload(f)
    wait_for(f, f.stdout, "0\n6\n")
    wait_for(f, f.stderr, "low: reloaded ")
    expect_reloaded(f, ["main..c1", "native", "value"])
    no_restart(f)
}

fn test_reload_patches_instances(t: *testing.T) {
    let f = new_fixture(t, generic("1"))
    defer close_fixture(f)
    wait_for(f, f.stdout, "0\n")
    write_source(f, generic("2"))
    reload(f)
    wait_for(f, f.stdout, "0\n2\n")
    wait_for(f, f.stderr, "low: reloaded ")
    expect_reloaded(f, ["scale[i64]", "scale[f64]"])
    no_restart(f)
}

fn test_capture_change_restarts(t: *testing.T) {
    let inline = replace_once(embed("programs/values.txt"), "fn() -> i64 {{ VALUE }}", "fn() -> i64 {{ one }}")
    let captures = replace_once(inline, "    let named", "    let one = 1\n    let named")
    let f = new_fixture(t, text.replace(captures, "VALUE", "1"))
    defer close_fixture(f)
    wait_for(f, f.stdout, "0\n")
    write_source(f, values("2"))
    reload(f)
    wait_for(f, f.stderr, "low: restarted: ")
    wait_for(f, f.stdout, "0\n0\n6\n")
}

fn test_layout_change_restarts(t: *testing.T) {
    let narrow = "struct P {{\n    x: i64\n}}\n\n"
    let f = new_fixture(t, prefixed(narrow, "1"))
    defer close_fixture(f)
    wait_for(f, f.stdout, "0\n")
    let wide = "struct P {{\n    x: i64\n    y: i64\n}}\n\n"
    write_source(f, prefixed(wide, "2"))
    reload(f)
    wait_for(f, f.stderr, "low: restarted: type layout changed")
    wait_for(f, f.stdout, "0\n0\n2\n")
}

fn test_signature_change_restarts(t: *testing.T) {
    let f = new_fixture(t, spin("1"))
    defer close_fixture(f)
    wait_for(f, f.stdout, "0\n")
    let old_head = "fn step(n: i64) -> i64 {{\n    n + value()"
    let new_head = "fn step(n: i64, m: i64) -> i64 {{\n    n + m"
    let signature = replace_once(spin("2"), old_head, new_head)
    let changed = replace_once(signature, "step(total)", "step(total, 1)")
    write_source(f, changed)
    reload(f)
    wait_for(f, f.stderr, "low: restarted: ")
    wait_for(f, f.stdout, "0\n0\n2\n")
}

fn test_reloads_at_unaligned_offsets(t: *testing.T) {
    let lengths = [3, 40, 7, 90, 2, 17, 130, 5]
    let f = new_fixture(t, strung("", "1"))
    defer close_fixture(f)
    wait_for(f, f.stdout, "0\n")
    var unaligned = 0
    for i in 0..lengths.len {
        let k = i + 1
        if f.session.next % 32 == 16 {
            unaligned += 1
        }
        write_source(f, string_program(k, lengths, k == lengths.len))
        reload(f)
    }
    wait_for(f, f.stdout, "0\n2\n")
    no_restart(f)
    if unaligned == 0 {
        abort(f, "no reload started at an offset of 16 modulo 32")
    }
}

fn main() {
    let tests = [
        testing.Test { name: "dynamic_reload", run: test_dynamic_reload }
        testing.Test { name: "reload_calling_c", run: test_reload_calling_c }
        testing.Test { name: "library_change_restarts", run: test_library_change_restarts }
        testing.Test { name: "run_watches_modules", run: test_run_watches_modules }
        testing.Test { name: "reload_on_embedded_change", run: test_reload_on_embedded_change }
        testing.Test { name: "reload_keeps_state", run: test_reload_keeps_state }
        testing.Test { name: "reload_adds_function", run: test_reload_adds_function }
        testing.Test { name: "compile_error_keeps_program_running", run: test_compile_error_keeps_program_running }
        testing.Test { name: "reload_keeps_heap", run: test_reload_keeps_heap }
        testing.Test { name: "reload_reaches_stored_functions", run: test_reload_reaches_stored_functions }
        testing.Test { name: "reload_patches_instances", run: test_reload_patches_instances }
        testing.Test { name: "capture_change_restarts", run: test_capture_change_restarts }
        testing.Test { name: "layout_change_restarts", run: test_layout_change_restarts }
        testing.Test { name: "signature_change_restarts", run: test_signature_change_restarts }
        testing.Test { name: "reloads_at_unaligned_offsets", run: test_reloads_at_unaligned_offsets }
    ]
    testing.run(tests)
}
