import asm
import std/testing

fn check_aligned_case(t: *testing.T, c: TextCase) {
    check_text(t, c.name, c.source, asm.Options { align_branches: true }, c.want)
}

fn align_branches_cases() -> []TextCase {
    [
        TextCase { name: "jcc crossing the boundary is preceded by a nop", source: repeated("nop\n", 30, "jne t\nt:\nret"), want: "90*30 6690 7500 c3" }
        TextCase { name: "jmp crossing the boundary", source: repeated("nop\n", 30, "jmp t\nt:\nret"), want: "90*30 6690 eb00 c3" }
        TextCase { name: "near jcc crossing the boundary", source: repeated("nop\n", 30, "jne t\n.zero 130\nt:\nret"), want: "90*30 6690 0f85 82000000 00*130 c3" }
        TextCase { name: "a label before the branch stays before the padding", source: repeated("nop\n", 30, "l:\njne l\nret"), want: "90*30 6690 75fc c3" }
        TextCase { name: "call is not padded", source: repeated("nop\n", 30, "call t\nt:\nret"), want: "90*30 e800000000 c3" }
        TextCase { name: "indirect jmp is not padded", source: repeated("nop\n", 30, "jmp rax\nret"), want: "90*30 ffe0 c3" }
        TextCase { name: "cmp fused with jne is padded together", source: repeated("nop\n", 30, "cmp rax, rbx\njne t\nt:\nret"), want: "90*30 6690 4839d8 7500 c3" }
        TextCase { name: "inc fused with jne", source: repeated("nop\n", 30, "inc rax\njne t\nt:\nret"), want: "90*30 6690 48ffc0 7500 c3" }
        TextCase { name: "test fused with jle", source: repeated("nop\n", 30, "test rax, rax\njle t\nt:\nret"), want: "90*30 6690 4885c0 7e00 c3" }
        TextCase { name: "alignment between the pair breaks the fusion", source: repeated("nop\n", 30, "and eax, 1\n.p2align 3\njne t\nt:\nret"), want: "90*30 83e001 0f1f8000000000 7500 c3" }
        TextCase { name: "cs prefixes widen earlier instructions", source: repeated("mov rax, rbx\n", 9, "nop\nnop\nnop\njne t\nt:\nret"), want: "2e2e 4889d8 4889d8*8 90*3 7500 c3" }
        TextCase { name: "an existing segment prefix is repeated", source: repeated("mov rax, fs:[rbx]\n", 7, "nop\nnop\njne t\nt:\nret"), want: "6464 64488b03 64488b03*6 90*2 7500 c3" }
    ]
}

fn test_align_branches_padding(t: *testing.T) {
    t.table_of(align_branches_cases(), text_case_name, check_aligned_case)
}

fn test_align_branches_no_padding_without_flag(t: *testing.T) {
    let source = repeated("nop\n", 30, "jne t\nt:\nret")
    check_text(t, "no flag", source, asm.Options {}, "90*30 7500 c3")
}

fn test_align_branches_raises_section_alignment(t: *testing.T) {
    let program = ".intel_syntax noprefix\n.text\njne t\nt:\nret\n"
    let aligned = asm.assemble(program, asm.Options { align_branches: true }) catch {
        e => {
            t.fatal(asm.message(e))
            return
        }
    }
    let got = aligned.sections[0].align
    if got != 32 {
        t.error("section alignment {got}, want 32")
    }
    let plain = asm.assemble(program, asm.Options {}) catch {
        e => {
            t.fatal(asm.message(e))
            return
        }
    }
    let plain_got = plain.sections[0].align
    if plain_got != 1 {
        t.error("section alignment {plain_got}, want 1")
    }
}
