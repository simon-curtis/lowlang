import std/os
import std/testing

struct Report {
    errors: []str = []
    skip: str = ""
}

struct Ahead {
    jobs: []fn() -> Report
    results: []chan[Report]
    next: i64 = 0
}

fn deliver(job: fn() -> Report, out: chan[Report]) {
    out <- job()
}

fn start_through(a: *Ahead, last: i64) {
    for a.next <= last && a.next < a.jobs.len {
        spawn deliver(a.jobs[a.next], a.results[a.next])
        a.next += 1
    }
}

fn await_report(t: *testing.T, a: *Ahead, index: i64) {
    start_through(a, index + os.cpu_count() / 4)
    let report = <-a.results[index] ?? Report { errors: ["the job ended without a report"] }
    for e in report.errors {
        t.error(e)
    }
    if report.skip != "" {
        t.skip(report.skip)
    }
}

struct Pending {
    name: str
    job: fn() -> Report
}

fn ahead_tests(filter: str, pending: []Pending) -> []testing.Test {
    let a = new(Ahead { jobs: [], results: [] })
    var tests: []testing.Test = []
    for p in pending {
        if !testing.selected(filter, p.name) {
            continue
        }
        let index = a.jobs.len
        a.jobs.push(p.job)
        a.results.push(chan[Report](1))
        tests.push(testing.Test { name: p.name, run: fn(t) { await_report(t, a, index) } })
    }
    tests
}
