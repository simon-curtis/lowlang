import asm
import oracletool
import target
import std/builder
import std/file
import std/testing
import std/text

const max_mismatch_lines = 3
const skip_reason_limit = 100

fn oracle_variants(platform: target.OS) -> []oracletool.GNUOptions {
    if platform == target.OS.Linux {
        return [oracletool.GNUOptions { align_branches: true }, oracletool.GNUOptions {}]
    }
    [oracletool.GNUOptions {}]
}

fn skip_reason(message: str) -> str {
    let line = text.cut(message, "\n").before
    if line.len > skip_reason_limit {
        return line[..skip_reason_limit]
    }
    line
}

fn format_mismatches(label: str, variant: oracletool.GNUOptions, mismatches: []str) -> str {
    var out = builder.builder()
    out.write("{label}: {mismatches.len} mismatches")
    for i, m in mismatches {
        if i == max_mismatch_lines {
            break
        }
        out.write("\n    as align_branches={variant.align_branches}: {m}")
    }
    out.to_str()
}

fn compare_variant(t: *testing.T, e: CorpusEntry, dir: str, source: str, variant: oracletool.GNUOptions) -> bool {
    let label = entry_label(e)
    let options = asm.Options { align_branches: variant.align_branches }
    let object = asm.assemble(source, options) catch {
        err => {
            t.error("{label}: parse: {asm.message(err)}")
            return false
        }
    }
    let fed = as_source(source, e.platform)
    let oracle = run_as(dir, fed, variant) catch {
        err => {
            t.error("{label}: oracle: {oracletool.message(err)}")
            return false
        }
    }
    let c = new_comparison(object, oracle, e.platform)
    run_comparison(c)
    if c.mismatches.len > 0 {
        t.error(format_mismatches(label, variant, c.mismatches))
    }
    true
}

fn run_oracle_entry(t: *testing.T, e: CorpusEntry) {
    oracletool.require(t, "as", oracletool.gnu)
    let dir = scratch(t)
    defer file.remove_all(dir) or {}
    let source = generate_entry(dir, e) catch {
        err => {
            t.skip(skip_reason(oracletool.message(err)))
            return
        }
    }
    for variant in oracle_variants(e.platform) {
        if !compare_variant(t, e, dir, source, variant) {
            return
        }
    }
}

fn oracle_entry_tests(entries: []CorpusEntry) -> []testing.Test {
    var tests: []testing.Test = []
    for e in entries {
        let label = entry_label(e)
        push(mut tests, testing.Test { name: "oracle/{label}", run: fn(t) { run_oracle_entry(t, e) } })
    }
    tests
}

fn oracle_tests() -> []testing.Test {
    let entries = corpus_entries() catch {
        err => {
            let message = oracletool.message(err)
            return [testing.Test { name: "oracle", run: fn(t) { t.fatal(message) } }]
        }
    }
    oracle_entry_tests(entries)
}
