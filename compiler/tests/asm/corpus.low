fn sample_benchmarks() -> []str {
    ["fib", "nbody"]
}

fn entry_label(e: CorpusEntry) -> str {
    let platform = target.string(e.platform)
    "{e.name} [{platform}]"
}

fn program_named(programs: []oracletool.Program, name: str) -> oracletool.Program ! oracletool.Error {
    for program in programs {
        if program.name == name {
            return program
        }
    }
    fail oracletool.Error.Failed("sample program {name} does not exist")
}

fn named(programs: []oracletool.Program, names: []str) -> []oracletool.Program ! oracletool.Error {
    var found: []oracletool.Program = []
    for name in names {
        let program = program_named(programs, name)?
        push(mut found, program)
    }
    found
}

fn corpus_programs() -> []oracletool.Program ! oracletool.Error {
    let run = oracletool.programs("run")?
    let windows = oracletool.programs("windows")?
    let benchmarks = oracletool.benchmarks()?
    let full = os.env("LOW_ASM_FULL") ?? ""
    if full != "" {
        return slices.concat(slices.concat(run, windows), benchmarks)
    }
    let sampled_run = named(run, sample_run())?
    let sampled_benchmarks = named(benchmarks, sample_benchmarks())?
    slices.concat(slices.concat(sampled_run, windows), sampled_benchmarks)
}

fn corpus_entries() -> []CorpusEntry ! oracletool.Error {
    let programs = corpus_programs()?
    var entries: []CorpusEntry = []
    for program in programs {
        push(mut entries, CorpusEntry { name: program.path, path: program.path, platform: target.OS.Linux })
        push(mut entries, CorpusEntry { name: program.path, path: program.path, platform: target.OS.Windows })
    }
    entries
}

fn generate_entry(dir: str, e: CorpusEntry) -> str ! oracletool.Error {
    let generated = oracletool.generate(dir, e.path, e.platform)?
    generated.asm
}
