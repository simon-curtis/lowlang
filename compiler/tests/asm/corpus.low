import oracletool
import target
import std/slices

struct CorpusEntry {
    name: str
    path: str
    platform: target.OS
}

fn entry_label(e: CorpusEntry) -> str {
    let platform = target.string(e.platform)
    "{e.name} [{platform}]"
}

fn corpus_entries() -> []CorpusEntry ! oracletool.Error {
    let run = oracletool.programs("run")?
    let windows = oracletool.programs("windows")?
    let benchmarks = oracletool.benchmarks()?
    let programs = slices.concat(slices.concat(run, windows), benchmarks)
    var entries: []CorpusEntry = []
    for program in programs {
        push(mut entries, CorpusEntry { name: program.path, path: program.path, platform: target.OS.Linux })
        push(mut entries, CorpusEntry { name: program.path, path: program.path, platform: target.OS.Windows })
    }
    entries
}

fn generate_entry(dir: str, e: CorpusEntry) -> str ! oracletool.Error {
    let generated = oracletool.generate(dir, e.path, e.platform)?
    generated.asm
}
