import asm
import compiler
import link
import native
import oracletool
import target
import std/slices
import std/testing
import std/text

const compiler_path = "compiler/low"
const windows_programs = "testdata/windows/"

fn first_difference(a: []u8, b: []u8) -> i64 {
    var n = a.len
    if b.len < n {
        n = b.len
    }
    for i in 0..n {
        if a[i] != b[i] {
            return i
        }
    }
    if a.len != b.len {
        return n
    }
    -1
}

fn check_chunk_image(t: *testing.T, label: str, path: str, platform: target.OS) {
    let profile = compiler.release(platform)
    let unit = native.analyse(path, profile) catch {
        e => {
            t.fatal("{label}: {native.message(e)}")
            return
        }
    }
    let linked = native.link_text_image(unit) catch {
        e => {
            t.fatal("{label}: text path: {native.message(e)}")
            return
        }
    }
    let chunked = native.link_chunk_image(unit) catch {
        e => {
            t.fatal("{label}: chunk path: {native.message(e)}")
            return
        }
    }
    let linked_bytes = link.contents(linked)
    let chunked_bytes = link.contents(chunked)
    let at = first_difference(linked_bytes, chunked_bytes)
    if at >= 0 {
        t.error("{label}: images differ at byte {at} (text path {linked_bytes.len} bytes, chunk path {chunked_bytes.len} bytes)")
    }
}

fn chunk_entry_tests(entries: []CorpusEntry) -> []testing.Test {
    var tests: []testing.Test = []
    for e in entries {
        if e.platform == target.OS.Linux && text.starts_with(e.path, windows_programs) {
            continue
        }
        let label = entry_label(e)
        tests.push(testing.Test { name: "chunks/{label}", run: fn(t) { check_chunk_image(t, label, e.path, e.platform) } })
    }
    tests
}

fn compiler_chunk_tests() -> []testing.Test {
    [
        testing.Test { name: "chunks/compiler [linux/amd64]", run: fn(t) { check_chunk_image(t, "compiler", compiler_path, target.OS.Linux) } }
        testing.Test { name: "chunks/compiler [windows/amd64]", run: fn(t) { check_chunk_image(t, "compiler", compiler_path, target.OS.Windows) } }
    ]
}

fn dynamic_names() -> []str {
    ["cinterop", "dynamic", "libc_startup", "std_math"]
}

fn dynamic_chunk_tests() -> []testing.Test {
    let programs = oracletool.programs("run") catch {
        err => {
            let message = oracletool.message(err)
            return [testing.Test { name: "chunks/dynamic", run: fn(t) { t.fatal(message) } }]
        }
    }
    var tests: []testing.Test = []
    for p in programs {
        if slices.contains(dynamic_names(), p.name) {
            let label = "{p.name} [linux/amd64]"
            tests.push(testing.Test { name: "chunks/dynamic/{label}", run: fn(t) { check_chunk_image(t, label, p.path, target.OS.Linux) } })
        }
    }
    tests
}

fn chunk_tests() -> []testing.Test {
    let entries = corpus_entries() catch {
        err => {
            let message = oracletool.message(err)
            return [testing.Test { name: "chunks", run: fn(t) { t.fatal(message) } }]
        }
    }
    var tests = chunk_unit_tests()
    for t in chunk_entry_tests(entries) {
        tests.push(t)
    }
    for t in compiler_chunk_tests() {
        tests.push(t)
    }
    for t in dynamic_chunk_tests() {
        tests.push(t)
    }
    tests
}

const chunk_prologue = "\t.p2align 5\nfn_f:\n"

fn test_chunk_external_branch_needs_disp32(t: *testing.T) {
    let env = asm.new_env("\t.intel_syntax noprefix\n", asm.Options { align_branches: true }) catch {
        e => {
            t.fatal(asm.message(e))
            return
        }
    }
    let source = "{chunk_prologue}\tjne rt_panic\n\tret\n"
    asm.assemble_chunk(env, source, [], false) catch {
        e => return
    }
    t.error("a branch leaving the chunk without {{disp32}} was accepted")
}

fn test_chunk_records_external_branch(t: *testing.T) {
    let env = asm.new_env("\t.intel_syntax noprefix\n", asm.Options { align_branches: true }) catch {
        e => {
            t.fatal(asm.message(e))
            return
        }
    }
    let source = "{chunk_prologue}\t{{disp32}} jne rt_panic\n.Lback:\n\tjmp .Lback\n\tret\n"
    let chunk = asm.assemble_chunk(env, source, ["fn_f"], false) catch {
        e => {
            t.fatal(asm.message(e))
            return
        }
    }
    if chunk.fixups.len != 1 || chunk.fixups[0].symbol != "rt_panic" || !chunk.fixups[0].branch {
        t.error("fixups {chunk.fixups}")
    }
    if chunk.marks.len != 1 || chunk.marks[0] != 0 {
        t.error("marks {chunk.marks}")
    }
}

fn chunk_unit_tests() -> []testing.Test {
    [
        testing.Test { name: "chunks/external_branch_needs_disp32", run: test_chunk_external_branch_needs_disp32 }
        testing.Test { name: "chunks/records_external_branch", run: test_chunk_records_external_branch }
    ]
}
