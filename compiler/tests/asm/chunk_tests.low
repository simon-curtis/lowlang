import asm
import compiler
import link
import native
import oracletool
import target
import std/slices
import std/testing
import std/text

const compiler_path = "compiler/low"
const windows_programs = "testdata/windows/"

fn first_difference(a: []u8, b: []u8) -> i64 {
    var n = a.len
    if b.len < n {
        n = b.len
    }
    for i in 0..n {
        if a[i] != b[i] {
            return i
        }
    }
    if a.len != b.len {
        return n
    }
    -1
}

fn chunk_report(label: str, path: str, platform: target.OS) -> Report {
    let profile = compiler.release(platform)
    let unit = native.analyse(path, profile) catch {
        e => return Report { errors: ["{label}: {native.message(e)}"] }
    }
    let linked = native.link_text_image(unit) catch {
        e => return Report { errors: ["{label}: text path: {native.message(e)}"] }
    }
    let chunked = native.link_chunk_image(unit) catch {
        e => return Report { errors: ["{label}: chunk path: {native.message(e)}"] }
    }
    let linked_bytes = link.contents(linked)
    let chunked_bytes = link.contents(chunked)
    let at = first_difference(linked_bytes, chunked_bytes)
    if at >= 0 {
        return Report { errors: ["{label}: images differ at byte {at} (text path {linked_bytes.len} bytes, chunk path {chunked_bytes.len} bytes)"] }
    }
    Report {}
}

fn chunk_pending(label: str, path: str, platform: target.OS) -> Pending {
    Pending { name: "chunks/{label}", job: fn() -> Report { chunk_report(label, path, platform) } }
}

fn chunk_entry_pending(entries: []CorpusEntry) -> []Pending {
    var pending: []Pending = []
    for e in entries {
        if e.platform == target.OS.Linux && text.starts_with(e.path, windows_programs) {
            continue
        }
        pending.push(chunk_pending(entry_label(e), e.path, e.platform))
    }
    pending
}

fn compiler_chunk_pending() -> []Pending {
    [chunk_pending("compiler [linux/amd64]", compiler_path, target.OS.Linux), chunk_pending("compiler [windows/amd64]", compiler_path, target.OS.Windows)]
}

fn dynamic_names() -> []str {
    ["cinterop", "dynamic", "libc_startup", "std_math"]
}

fn dynamic_chunk_pending() -> []Pending ! oracletool.Error {
    let programs = oracletool.programs("run")?
    var pending: []Pending = []
    for p in programs {
        if slices.contains(dynamic_names(), p.name) {
            pending.push(chunk_pending("dynamic/{p.name} [linux/amd64]", p.path, target.OS.Linux))
        }
    }
    pending
}

const chunk_prologue = "\t.p2align 5\nfn_f:\n"

fn test_chunk_external_branch_needs_disp32(t: *testing.T) {
    let env = asm.new_env("\t.intel_syntax noprefix\n", asm.Options { align_branches: true }) catch {
        e => {
            t.fatal(asm.message(e))
            return
        }
    }
    let source = "{chunk_prologue}\tjne rt_panic\n\tret\n"
    asm.assemble_chunk(env, source, [], false) catch {
        e => return
    }
    t.error("a branch leaving the chunk without {{disp32}} was accepted")
}

fn test_chunk_records_external_branch(t: *testing.T) {
    let env = asm.new_env("\t.intel_syntax noprefix\n", asm.Options { align_branches: true }) catch {
        e => {
            t.fatal(asm.message(e))
            return
        }
    }
    let source = "{chunk_prologue}\t{{disp32}} jne rt_panic\n.Lback:\n\tjmp .Lback\n\tret\n"
    let chunk = asm.assemble_chunk(env, source, ["fn_f"], false) catch {
        e => {
            t.fatal(asm.message(e))
            return
        }
    }
    if chunk.fixups.len != 1 || chunk.fixups[0].symbol != "rt_panic" || !chunk.fixups[0].branch {
        t.error("fixups {chunk.fixups}")
    }
    if chunk.marks.len != 1 || chunk.marks[0] != 0 {
        t.error("marks {chunk.marks}")
    }
}
