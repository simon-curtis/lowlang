import asm
import oracletool
import std/file
import std/slices
import std/testing

fn clang_text(t: *testing.T, source: str) -> []u8 {
    let dir = scratch(t)
    defer file.remove_all(dir) or {}
    let output = oracletool.assemble_clang(dir, source) catch {
        e => {
            t.fatal(oracletool.message(e))
            return []
        }
    }
    let data = file.read_file(output) catch {
        e => {
            t.fatal("read {output}: {e}")
            return []
        }
    }
    let image = oracletool.read_pe(data) catch {
        e => {
            t.fatal(oracletool.message(e))
            return []
        }
    }
    match oracletool.pe_section(image, ".text") {
        some(section) => oracletool.pe_data(image, section) catch {
            e => {
                t.fatal(oracletool.message(e))
                return []
            }
        }
        none => {
            t.fatal("{output} has no .text section")
            []
        }
    }
}

fn clang_layout_text(t: *testing.T, source: str) -> []u8 {
    let object = asm.assemble(source, asm.Options { clang_layout: true }) catch {
        e => {
            t.fatal("assemble: {asm.message(e)}")
            return []
        }
    }
    object.sections[0].data
}

fn require_clang(t: *testing.T) {
    oracletool.require(t, "clang", oracletool.llvm)
}

fn check_clang_layout(t: *testing.T, label: str, source: str) {
    let got = clang_layout_text(t, source)
    let want = clang_text(t, source)
    if !slices.equal(got, want) {
        let got_text = oracletool.spaced_hex(got)
        let want_text = oracletool.spaced_hex(want)
        t.error("{label}: got {got_text}, want {want_text}")
    }
}

fn test_clang_layout_alignment_padding(t: *testing.T) {
    require_clang(t)
    for power in [3, 4, 5, 6] {
        for filler in 0..70 {
            let source = "\t.intel_syntax noprefix\n\t.text\n\t.zero {filler}\n\t.p2align {power}\n\tret\n"
            check_clang_layout(t, "p2align {power} after {filler} bytes", source)
        }
    }
}

fn relaxation_source(before: i64, gap: i64) -> str {
    let aligned = 20 + gap * 3
    let tail = 24 + before / 4
    "\t.intel_syntax noprefix\n\t.text\ntop:\n\tjne far\n\t.zero {before}\n\tjne far\n\t.p2align 5\n\t.zero {aligned}\n\tjne top\n\t.zero {tail}\nfar:\n\tret\n"
}

fn test_clang_layout_relaxation(t: *testing.T) {
    require_clang(t)
    for step in 0..13 {
        let before = 100 + step * 2
        for gap in 0..4 {
            check_clang_layout(t, "before {before} gap {gap}", relaxation_source(before, gap))
        }
    }
}
