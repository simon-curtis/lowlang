import oracletool
import target
import std/file
import std/testing

const fib_path = "bench/fib/main.low"

fn check_section_present(t: *testing.T, label: str, oracle: OracleObject, name: str) {
    match oracle.sections[name] {
        some(section) => {
            if section.size == 0 {
                t.error("{label}: section {name} is missing or empty")
            }
        }
        none => t.error("{label}: section {name} is missing or empty")
    }
}

fn relocated_section_name(platform: target.OS) -> str {
    if platform == target.OS.Windows {
        return ".idata$4"
    }
    ".rodata"
}

fn check_relocations(t: *testing.T, label: str, oracle: OracleObject, name: str) {
    match oracle.sections[name] {
        some(section) => {
            if section.relocs.len == 0 {
                t.fatal("{label}: section {name} has no relocations")
                return
            }
            let kind = section.relocs[0].kind
            if kind != "Abs64" && kind != "Abs32" {
                t.error("{label}: unexpected relocation kind {kind}")
            }
        }
        none => t.fatal("{label}: section {name} has no relocations")
    }
}

fn check_oracle_object(t: *testing.T, e: CorpusEntry, oracle: OracleObject) {
    let label = entry_label(e)
    for name in [".text", ".rodata", ".data", ".bss"] {
        check_section_present(t, label, oracle, name)
    }
    if oracle.symbols.len == 0 {
        t.error("{label}: no symbols read")
    }
    check_relocations(t, label, oracle, relocated_section_name(e.platform))
    match oracle.sections[".bss"] {
        some(bss) => {
            if !bss.nobits {
                t.error("{label}: .bss should be nobits")
            }
        }
        none => {}
    }
}

fn check_oracle_platform(t: *testing.T, platform: target.OS) {
    let e = CorpusEntry { name: fib_path, path: fib_path, platform }
    let label = entry_label(e)
    let dir = scratch(t)
    defer file.remove_all(dir) or {}
    let source = generate_entry(dir, e) catch {
        err => {
            t.fatal("{label}: {oracletool.message(err)}")
            return
        }
    }
    let oracle = run_as(dir, as_source(source, platform), oracletool.GNUOptions {}) catch {
        err => {
            t.fatal("{label}: {oracletool.message(err)}")
            return
        }
    }
    check_oracle_object(t, e, oracle)
}

fn test_oracle_reads_objects(t: *testing.T) {
    oracletool.require(t, "as", oracletool.gnu)
    for platform in [target.OS.Linux, target.OS.Windows] {
        check_oracle_platform(t, platform)
    }
}
