        EncodingCase { source: "vpbroadcastd ymm20{{k1}}{{z}}, ecx", hex: "62 e2 7d a9 7c e1" }
        EncodingCase { source: "vpbroadcastw zmm1, word ptr [rax+254]", hex: "62 f2 7d 48 79 48 7f" }
        EncodingCase { source: "kmovq k1, k2", hex: "c4 e1 f8 90 ca" }
        EncodingCase { source: "kmovq k1, qword ptr [rax]", hex: "c4 e1 f8 90 08" }
