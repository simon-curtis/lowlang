import asm
import std/testing
import std/text

struct EncodingCase {
    source: str
    hex: str
}

fn assemble_text(t: *testing.T, source: str, opts: asm.Options) -> []u8 {
    let program = ".intel_syntax noprefix\n.text\n{source}\n"
    let object = asm.assemble(program, opts) catch {
        e => {
            let quoted = text.quote(source)
            t.fatal("assemble {quoted}: {asm.message(e)}")
            return []
        }
    }
    for s in object.sections {
        if s.name == ".text" {
            return s.data
        }
    }
    t.fatal("no .text section")
    []
}

fn encoding_name(c: EncodingCase) -> str {
    c.source
}

fn check_encoding(t: *testing.T, c: EncodingCase) {
    let data = assemble_text(t, c.source, asm.Options {})
    let got = text.encode_hex(data)
    let want = text.replace(c.hex, " ", "")
    if got != want {
        t.error("{c.source}: got {got}, want {want}")
    }
}

fn memory_base_cases() -> []EncodingCase {
    [
        EncodingCase { source: "mov rax, [rbp]", hex: "48 8b 45 00" }
        EncodingCase { source: "mov rax, [rbp+8]", hex: "48 8b 45 08" }
        EncodingCase { source: "mov rax, [rbp+1000]", hex: "48 8b 85 e8 03 00 00" }
        EncodingCase { source: "mov rax, [r13]", hex: "49 8b 45 00" }
        EncodingCase { source: "mov rax, [r13+8]", hex: "49 8b 45 08" }
        EncodingCase { source: "mov rax, [r13+rcx*4]", hex: "49 8b 44 8d 00" }
        EncodingCase { source: "mov rax, [rsp]", hex: "48 8b 04 24" }
        EncodingCase { source: "mov rax, [rsp+8]", hex: "48 8b 44 24 08" }
        EncodingCase { source: "mov rax, [rsp+400]", hex: "48 8b 84 24 90 01 00 00" }
        EncodingCase { source: "mov rax, [r12]", hex: "49 8b 04 24" }
        EncodingCase { source: "mov rax, [r12+8]", hex: "49 8b 44 24 08" }
        EncodingCase { source: "mov rax, [r12+rax*2]", hex: "49 8b 04 44" }
        EncodingCase { source: "mov rax, [rbp+rcx]", hex: "48 8b 44 0d 00" }
        EncodingCase { source: "mov rax, [r13+r12*8-16]", hex: "4b 8b 44 e5 f0" }
        EncodingCase { source: "mov r12, [rsp+r13]", hex: "4e 8b 24 2c" }
        EncodingCase { source: "lea rax, [rax+rax*8]", hex: "48 8d 04 c0" }
        EncodingCase { source: "mov eax, [rcx*4+16]", hex: "8b 04 8d 10 00 00 00" }
        EncodingCase { source: "movzx eax, byte ptr [r13]", hex: "41 0f b6 45 00" }
    ]
}

fn register_and_immediate_cases() -> []EncodingCase {
    [
        EncodingCase { source: "mov al, sil", hex: "40 88 f0" }
        EncodingCase { source: "mov ah, bl", hex: "88 dc" }
        EncodingCase { source: "mov dword ptr [rbp-4], 5", hex: "c7 45 fc 05 00 00 00" }
        EncodingCase { source: "mov word ptr [rsp], 7", hex: "66 c7 04 24 07 00" }
        EncodingCase { source: "add rax, 128", hex: "48 05 80 00 00 00" }
        EncodingCase { source: "add rax, 127", hex: "48 83 c0 7f" }
        EncodingCase { source: "add eax, -129", hex: "05 7f ff ff ff" }
        EncodingCase { source: "xchg rcx, rdx", hex: "48 87 d1" }
        EncodingCase { source: "xchg [rax], rcx", hex: "48 87 08" }
        EncodingCase { source: "push r12", hex: "41 54" }
        EncodingCase { source: "pop rbp", hex: "5d" }
        EncodingCase { source: "imul rax, rbx, 300", hex: "48 69 c3 2c 01 00 00" }
        EncodingCase { source: "shl rax, 1", hex: "48 d1 e0" }
        EncodingCase { source: "shl r9d, cl", hex: "41 d3 e1" }
        EncodingCase { source: "hlt", hex: "f4" }
    ]
}

fn vex_cases() -> []EncodingCase {
    [
        EncodingCase { source: "vaddps xmm0, xmm1, xmm2", hex: "c5 f0 58 c2" }
        EncodingCase { source: "vaddps ymm8, ymm1, ymm2", hex: "c5 74 58 c2" }
        EncodingCase { source: "vaddps xmm0, xmm1, [rax]", hex: "c5 f0 58 00" }
        EncodingCase { source: "vaddps xmm0, xmm1, [r8]", hex: "c4 c1 70 58 00" }
        EncodingCase { source: "vaddps xmm0, xmm1, [rax+r9]", hex: "c4 a1 70 58 04 08" }
        EncodingCase { source: "vmovdqu ymm0, [rbp-32]", hex: "c5 fe 6f 45 e0" }
        EncodingCase { source: "vpxor xmm0, xmm0, xmm0", hex: "c5 f9 ef c0" }
        EncodingCase { source: "vmovq xmm0, rax", hex: "c4 e1 f9 6e c0" }
        EncodingCase { source: "vpshufb xmm1, xmm2, xmm3", hex: "c4 e2 69 00 cb" }
        EncodingCase { source: "vzeroupper", hex: "c5 f8 77" }
        EncodingCase { source: "vpbroadcastb ymm0, xmm1", hex: "c4 e2 7d 78 c1" }
        EncodingCase { source: "vsubps xmm0, xmm1, xmm2", hex: "c5 f0 5c c2" }
        EncodingCase { source: "vsubps ymm8, ymm9, ymm10", hex: "c4 41 34 5c c2" }
        EncodingCase { source: "vsubps ymm0, ymm1, ymmword ptr [rbp-32]", hex: "c5 f4 5c 45 e0" }
        EncodingCase { source: "vsubpd xmm0, xmm1, xmm2", hex: "c5 f1 5c c2" }
        EncodingCase { source: "vsubpd ymm8, ymm9, ymm10", hex: "c4 41 35 5c c2" }
        EncodingCase { source: "vsubpd ymm0, ymm1, ymmword ptr [rbp-32]", hex: "c5 f5 5c 45 e0" }
        EncodingCase { source: "vminps xmm0, xmm1, xmm2", hex: "c5 f0 5d c2" }
        EncodingCase { source: "vminps ymm8, ymm9, ymm10", hex: "c4 41 34 5d c2" }
        EncodingCase { source: "vminps ymm0, ymm1, ymmword ptr [rbp-32]", hex: "c5 f4 5d 45 e0" }
        EncodingCase { source: "vmaxps xmm0, xmm1, xmm2", hex: "c5 f0 5f c2" }
        EncodingCase { source: "vmaxps ymm8, ymm9, ymm10", hex: "c4 41 34 5f c2" }
        EncodingCase { source: "vmaxps ymm0, ymm1, ymmword ptr [rbp-32]", hex: "c5 f4 5f 45 e0" }
        EncodingCase { source: "vmaxpd xmm0, xmm1, xmm2", hex: "c5 f1 5f c2" }
        EncodingCase { source: "vmaxpd ymm8, ymm9, ymm10", hex: "c4 41 35 5f c2" }
        EncodingCase { source: "vmaxpd ymm0, ymm1, ymmword ptr [rbp-32]", hex: "c5 f5 5f 45 e0" }
        EncodingCase { source: "vdivps xmm0, xmm1, xmm2", hex: "c5 f0 5e c2" }
        EncodingCase { source: "vdivps ymm8, ymm9, ymm10", hex: "c4 41 34 5e c2" }
        EncodingCase { source: "vdivps ymm0, ymm1, ymmword ptr [rbp-32]", hex: "c5 f4 5e 45 e0" }
        EncodingCase { source: "vpandn xmm0, xmm1, xmm2", hex: "c5 f1 df c2" }
        EncodingCase { source: "vpandn ymm8, ymm9, ymm10", hex: "c4 41 35 df c2" }
        EncodingCase { source: "vpandn ymm0, ymm1, ymmword ptr [rbp-32]", hex: "c5 f5 df 45 e0" }
        EncodingCase { source: "vpcmpeqw xmm0, xmm1, xmm2", hex: "c5 f1 75 c2" }
        EncodingCase { source: "vpcmpeqw ymm8, ymm9, ymm10", hex: "c4 41 35 75 c2" }
        EncodingCase { source: "vpcmpeqw ymm0, ymm1, ymmword ptr [rbp-32]", hex: "c5 f5 75 45 e0" }
        EncodingCase { source: "vpmaxud xmm0, xmm1, xmm2", hex: "c4 e2 71 3f c2" }
        EncodingCase { source: "vpmaxud ymm8, ymm9, ymm10", hex: "c4 42 35 3f c2" }
        EncodingCase { source: "vpmaxud ymm0, ymm1, ymmword ptr [rbp-32]", hex: "c4 e2 75 3f 45 e0" }
        EncodingCase { source: "vpsubq xmm0, xmm1, xmm2", hex: "c5 f1 fb c2" }
        EncodingCase { source: "vpsubq ymm8, ymm9, ymm10", hex: "c4 41 35 fb c2" }
        EncodingCase { source: "vpsubq ymm0, ymm1, ymmword ptr [rbp-32]", hex: "c5 f5 fb 45 e0" }
        EncodingCase { source: "vpslld xmm0, xmm1, xmm6", hex: "c5 f1 f2 c6" }
        EncodingCase { source: "vpslld ymm8, ymm9, xmm6", hex: "c5 35 f2 c6" }
        EncodingCase { source: "vpslld ymm0, ymm1, xmmword ptr [rax]", hex: "c5 f5 f2 00" }
        EncodingCase { source: "vpbroadcastw xmm0, xmm0", hex: "c4 e2 79 79 c0" }
        EncodingCase { source: "vpbroadcastw ymm8, xmm9", hex: "c4 42 7d 79 c1" }
        EncodingCase { source: "vpbroadcastw ymm0, word ptr [rax]", hex: "c4 e2 7d 79 00" }
        EncodingCase { source: "vpbroadcastq xmm0, xmm0", hex: "c4 e2 79 59 c0" }
        EncodingCase { source: "vpbroadcastq ymm8, xmm9", hex: "c4 42 7d 59 c1" }
        EncodingCase { source: "vpbroadcastq ymm0, qword ptr [rax]", hex: "c4 e2 7d 59 00" }
    ]
}

fn sse_cases() -> []EncodingCase {
    [
        EncodingCase { source: "subps xmm0, xmm1", hex: "0f 5c c1" }
        EncodingCase { source: "subps xmm9, xmmword ptr [rbp-32]", hex: "44 0f 5c 4d e0" }
        EncodingCase { source: "subpd xmm0, xmm1", hex: "66 0f 5c c1" }
        EncodingCase { source: "subpd xmm9, xmmword ptr [rbp-32]", hex: "66 44 0f 5c 4d e0" }
        EncodingCase { source: "minps xmm0, xmm1", hex: "0f 5d c1" }
        EncodingCase { source: "minps xmm9, xmmword ptr [rbp-32]", hex: "44 0f 5d 4d e0" }
        EncodingCase { source: "maxps xmm0, xmm1", hex: "0f 5f c1" }
        EncodingCase { source: "maxps xmm9, xmmword ptr [rbp-32]", hex: "44 0f 5f 4d e0" }
        EncodingCase { source: "maxpd xmm0, xmm1", hex: "66 0f 5f c1" }
        EncodingCase { source: "maxpd xmm9, xmmword ptr [rbp-32]", hex: "66 44 0f 5f 4d e0" }
        EncodingCase { source: "pcmpeqw xmm0, xmm1", hex: "66 0f 75 c1" }
        EncodingCase { source: "pcmpeqw xmm9, xmmword ptr [rbp-32]", hex: "66 44 0f 75 4d e0" }
        EncodingCase { source: "pslld xmm0, xmm6", hex: "66 0f f2 c6" }
        EncodingCase { source: "pslld xmm9, xmmword ptr [rbp-32]", hex: "66 44 0f f2 4d e0" }
        EncodingCase { source: "psubq xmm0, xmm1", hex: "66 0f fb c1" }
        EncodingCase { source: "psubq xmm9, xmmword ptr [rbp-32]", hex: "66 44 0f fb 4d e0" }
        EncodingCase { source: "punpcklqdq xmm0, xmm0", hex: "66 0f 6c c0" }
        EncodingCase { source: "punpcklqdq xmm9, xmmword ptr [rbp-32]", hex: "66 44 0f 6c 4d e0" }
    ]
}

fn test_memory_base_encodings(t: *testing.T) {
    t.table_of(memory_base_cases(), encoding_name, check_encoding)
}

fn test_register_and_immediate_encodings(t: *testing.T) {
    t.table_of(register_and_immediate_cases(), encoding_name, check_encoding)
}

fn test_vex_encodings(t: *testing.T) {
    t.table_of(vex_cases(), encoding_name, check_encoding)
}

fn test_sse_encodings(t: *testing.T) {
    t.table_of(sse_cases(), encoding_name, check_encoding)
}
