import std/slices
import std/testing

fn fixed_tests() -> []testing.Test {
    [
        testing.Test { name: "memory_base_encodings", run: test_memory_base_encodings }
        testing.Test { name: "register_and_immediate_encodings", run: test_register_and_immediate_encodings }
        testing.Test { name: "vex_encodings", run: test_vex_encodings }
        testing.Test { name: "relaxation_boundaries", run: test_relaxation_boundaries }
        testing.Test { name: "relaxation_chain", run: test_relaxation_chain }
        testing.Test { name: "relaxation_through_alignment", run: test_relaxation_through_alignment }
        testing.Test { name: "unresolved_jumps_keep_relocations", run: test_unresolved_jumps_keep_relocations }
        testing.Test { name: "align_padding_lengths", run: test_align_padding_lengths }
        testing.Test { name: "align_jumps_over_long_padding", run: test_align_jumps_over_long_padding }
        testing.Test { name: "align_max_skip", run: test_align_max_skip }
        testing.Test { name: "align_branches_padding", run: test_align_branches_padding }
        testing.Test { name: "align_branches_no_padding_without_flag", run: test_align_branches_no_padding_without_flag }
        testing.Test { name: "align_branches_raises_section_alignment", run: test_align_branches_raises_section_alignment }
        testing.Test { name: "constant_expressions", run: test_constant_expressions }
        testing.Test { name: "symbol_differences", run: test_symbol_differences }
        testing.Test { name: "text_symbol_difference", run: test_text_symbol_difference }
        testing.Test { name: "macros_conditionals_and_local_labels", run: test_macros_conditionals_and_local_labels }
        testing.Test { name: "strings_floats_and_fill", run: test_strings_floats_and_fill }
        testing.Test { name: "incbin", run: test_incbin }
        testing.Test { name: "incbin_paths", run: test_incbin_paths }
        testing.Test { name: "incbin_missing_file", run: test_incbin_missing_file }
        testing.Test { name: "errors", run: test_errors }
        testing.Test { name: "clang_layout_alignment_padding", run: test_clang_layout_alignment_padding }
        testing.Test { name: "clang_layout_relaxation", run: test_clang_layout_relaxation }
        testing.Test { name: "oracle_reads_objects", run: test_oracle_reads_objects }
    ]
}

fn main() {
    testing.run(slices.concat(fixed_tests(), oracle_tests()))
}
