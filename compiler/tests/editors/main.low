import check
import diag
import lexer
import types
import std/file
import std/io
import std/process
import std/regex
import std/slices
import std/testing
import std/text

const editors_dir = "editors"
const grammar_source = "editors/tree-sitter-low/src"
const zed_manifest = "editors/zed/extension.toml"

struct Listing {
    path: str
    label: str
    category: str
    words: fn(str) -> []str
}

fn expected_lists() -> [str: []str] {
    var keywords: []str = []
    for s in lexer.keyword_spellings() {
        push(mut keywords, s.text)
    }
    var literals = slices.clone(keywords)
    push(mut literals, lexer.when)
    var functions: []str = []
    var type_names: []str = []
    var constants: []str = []
    let universe = types.new_universe(fn(t: *types.Type) ! diag.Error {})
    for b in check.builtins(universe) {
        if b.kind == check.BuiltinKind.FunctionBuiltin && check.is_public(b) {
            push(mut functions, b.name)
        } else if b.kind == check.BuiltinKind.TypeBuiltin {
            push(mut type_names, b.name)
        } else if b.kind == check.BuiltinKind.ConstantBuiltin {
            push(mut constants, b.name)
        }
    }
    [
        "keywords": keywords
        "contextual keywords": lexer.contextual_keywords()
        "grammar literals": literals
        "functions": functions
        "types": type_names
        "constants": constants
        "constraints": types.constraint_names()
    ]
}

fn listings() -> []Listing {
    let highlights = "tree-sitter-low/queries/highlights.scm"
    let textmate = "vscode/syntaxes/low.tmLanguage.json"
    let site = "../site/gen/highlight.low"
    [
        Listing { path: "tree-sitter-low/grammar.js", label: "literals", category: "grammar literals", words: grammar_keywords }
        Listing { path: highlights, label: "keywords", category: "keywords", words: query_keywords }
        Listing { path: highlights, label: "contextual keywords", category: "contextual keywords", words: query_list("#eq\\? @keyword (\"[^\"]*\")") }
        Listing { path: highlights, label: "constants", category: "constants", words: query_constants }
        Listing { path: highlights, label: "builtin calls", category: "functions", words: query_list("#any-of\\? @function\\.builtin ([^)]*)") }
        Listing { path: highlights, label: "plain calls", category: "functions", words: query_list("#not-any-of\\? @function\\.call ([^)]*)") }
        Listing { path: highlights, label: "builtin types", category: "types", words: query_pattern("#match\\? @type\\.builtin \"\\^\\(([^)]*)\\)\\$\"") }
        Listing { path: highlights, label: "plain types", category: "types", words: query_pattern("#not-match\\? @type \"\\^\\(([^)]*)\\)\\$\"") }
        Listing { path: textmate, label: "keywords", category: "keywords", words: scopes(["keyword.control.", "storage.", "constant.language.boolean."]) }
        Listing { path: textmate, label: "contextual keywords", category: "contextual keywords", words: scopes(["keyword.other."]) }
        Listing { path: textmate, label: "constants", category: "constants", words: scopes(["constant.language."]) }
        Listing { path: textmate, label: "types", category: "types", words: scopes(["support.type.primitive."]) }
        Listing { path: textmate, label: "constraints", category: "constraints", words: scopes(["support.type.constraint."]) }
        Listing { path: textmate, label: "builtin calls", category: "functions", words: captured("support.function.builtin.") }
        Listing { path: site, label: "keywords", category: "keywords", words: site_keywords }
        Listing { path: site, label: "contextual keywords", category: "contextual keywords", words: module_set("contextual_keywords") }
        Listing { path: site, label: "types", category: "types", words: module_set("type_names") }
        Listing { path: site, label: "constants", category: "constants", words: module_set("constants") }
    ]
}

fn read_editor_file(t: *testing.T, path: str) -> str {
    let full = file.child_path(editors_dir, path)
    file.read_text(full) catch {
        e => {
            t.fatal("{full}: {e}")
            return ""
        }
    }
}

fn read_editor_bytes(t: *testing.T, path: str) -> []u8 {
    let full = file.child_path(editors_dir, path)
    file.read_file(full) catch {
        e => {
            t.fatal("{full}: {e}")
            return []
        }
    }
}

struct ListingCase {
    listing: Listing
    want: []str
}

fn listing_name(c: ListingCase) -> str {
    "{c.listing.path} {c.listing.label}"
}

fn listing_body(t: *testing.T, c: ListingCase) {
    let source = read_editor_file(t, c.listing.path)
    let found = c.listing.words(source)
    let missing = difference(c.want, found)
    if missing.len > 0 {
        t.error("{c.listing.path} {c.listing.label} lacks {c.listing.category}: {text.join(missing, ", ")}")
    }
    let extra = difference(found, c.want)
    if extra.len > 0 {
        t.error("{c.listing.path} {c.listing.label} lists {c.listing.category} the language does not have: {text.join(extra, ", ")}")
    }
}

fn test_grammars_match_language_tables(t: *testing.T) {
    let lists = expected_lists()
    var cases: []ListingCase = []
    for listing in listings() {
        let want = lists[listing.category] ?? []
        push(mut cases, ListingCase { listing, want })
    }
    t.table_of(cases, listing_name, listing_body)
}

struct Copy {
    path: str
    source: str
}

fn copy_name(c: Copy) -> str {
    c.path
}

fn copy_body(t: *testing.T, c: Copy) {
    let want = read_editor_bytes(t, c.source)
    let have = read_editor_bytes(t, c.path)
    if !slices.equal(have, want) {
        t.error("{c.path} differs from {c.source}; copy it over")
    }
}

fn test_editor_files_copy_their_source(t: *testing.T) {
    let cases = [
        Copy { path: "zed/languages/low/highlights.scm", source: "tree-sitter-low/queries/highlights.scm" }
        Copy { path: "nvim/queries/low/highlights.scm", source: "tree-sitter-low/queries/highlights.scm" }
        Copy { path: "vscode/icon.png", source: "../site/public/icon-192.png" }
    ]
    t.table_of(cases, copy_name, copy_body)
}

fn git_status(args: []str) -> process.Exit ! io.Error {
    let output = process.run(process.command("git", args), [])?
    output.status
}

fn git_succeeds(args: []str) -> bool {
    let status = git_status(args) catch {
        _ => return false
    }
    process.success(status)
}

fn git_installed() -> bool {
    match process.find("git") {
        some(path) => true
        none => false
    }
}

fn manifest_rev(t: *testing.T) -> str {
    let manifest = read_editor_file(t, "zed/extension.toml")
    let re = pattern("(?m)^rev = \"([0-9a-f]+)\"$")
    match regex.find(re, manifest) {
        some(m) => group_text(m, 1)
        none => {
            t.fatal("{zed_manifest} has no rev")
            ""
        }
    }
}

fn test_zed_rev_holds_the_current_grammar(t: *testing.T) {
    if !git_installed() {
        t.skip("git is not installed")
        return
    }
    if !git_succeeds(["rev-parse", "--git-dir"]) {
        t.skip("not a git checkout")
        return
    }
    let rev = manifest_rev(t)
    if rev == "" {
        return
    }
    if !git_succeeds(["cat-file", "-e", "{rev}^{{commit}}"]) {
        t.skip("commit {rev} is not in this checkout")
        return
    }
    let status = git_status(["diff", "--quiet", rev, "HEAD", "--", grammar_source]) catch {
        e => {
            t.fatal("git diff: {e}")
            return
        }
    }
    match status {
        Exited(code) => {
            if code == 1 {
                t.error("{grammar_source} differs between rev {rev} in {zed_manifest} and HEAD; point rev at a commit that holds the current grammar")
            } else if code != 0 {
                t.fatal("git diff exited with {code}")
            }
        }
        Signaled(signal) => t.fatal("git diff was stopped by a signal")
    }
}

fn main() {
    testing.run([
        testing.Test { name: "grammars_match_language_tables", run: test_grammars_match_language_tables }
        testing.Test { name: "editor_files_copy_their_source", run: test_editor_files_copy_their_source }
        testing.Test { name: "zed_rev_holds_the_current_grammar", run: test_zed_rev_holds_the_current_grammar }
    ])
}
