import lexer
import std/json
import std/regex
import std/slices
import std/text

const word_pattern = "([A-Za-z_][A-Za-z0-9_]*)"
const double_quote = "\""
const word_boundary = "\\\\b"

fn pattern(source: str) -> regex.Regex {
    regex.compile(source) catch {
        Invalid(at, message) => panic("{source}: at byte {at}: {message}")
    }
}

fn group_text(m: regex.Match, index: i64) -> str {
    regex.group(m, index) ?? ""
}

fn quoted(source: str, quote: str) -> []str {
    let re = pattern("{quote}{word_pattern}{quote}")
    var words: []str = []
    for m in regex.find_all(re, source) {
        push(mut words, group_text(m, 1))
    }
    words
}

fn grammar_keywords(source: str) -> []str {
    let re = pattern("(field\\(|name: )?'([a-z_]+)'")
    var words: []str = []
    for m in regex.find_all(re, source) {
        if regex.group(m, 1) == none {
            push(mut words, group_text(m, 2))
        }
    }
    words
}

fn without_predicates(source: str) -> str {
    let re = pattern("\\(#[^)]*\\)")
    regex.replace_all(re, source, fn(m: regex.Match) -> str { "" })
}

fn implied_keywords(source: str) -> []str {
    var words: []str = []
    if text.contains(source, "(boolean)") {
        push(mut words, "true")
        push(mut words, "false")
    }
    if text.contains(source, "(visibility)") {
        push(mut words, "pub")
    }
    words
}

fn query_keywords(source: str) -> []str {
    var words = quoted(without_predicates(source), double_quote)
    for word in implied_keywords(source) {
        push(mut words, word)
    }
    words
}

fn query_constants(source: str) -> []str {
    var words: []str = []
    if text.contains(source, "(boolean)") {
        push(mut words, "true")
        push(mut words, "false")
    }
    let listed = query_list("#any-of\\? @constant\\.builtin ([^)]*)")
    for word in listed(source) {
        push(mut words, word)
    }
    words
}

fn query_list(predicate: str) -> fn(str) -> []str {
    let re = pattern(predicate)
    fn(source: str) -> []str {
        var words: []str = []
        for m in regex.find_all(re, source) {
            for word in quoted(group_text(m, 1), double_quote) {
                push(mut words, word)
            }
        }
        words
    }
}

fn query_pattern(predicate: str) -> fn(str) -> []str {
    let re = pattern(predicate)
    fn(source: str) -> []str {
        var words: []str = []
        for m in regex.find_all(re, source) {
            for word in text.split(group_text(m, 1), '|') {
                push(mut words, word)
            }
        }
        words
    }
}

fn alternatives(expression: str) -> []str {
    let group = pattern("\\(([A-Za-z0-9_|]+)\\)")
    match regex.find(group, expression) {
        some(m) => text.split(group_text(m, 1), '|')
        none => quoted(expression, word_boundary)
    }
}

fn collect_objects(v: json.Value, mut found: []json.Value) {
    match v {
        Object(members) => {
            push(mut found, v)
            for member in members {
                collect_objects(member.value, mut found)
            }
        }
        Array(items) => {
            for item in items {
                collect_objects(item, mut found)
            }
        }
        _ => {}
    }
}

fn rules(source: str) -> []json.Value {
    let root = json.parse(bytes(source)) catch {
        _ => panic("the grammar is not valid JSON")
    }
    var found: []json.Value = []
    collect_objects(root, mut found)
    found
}

fn member_text(rule: json.Value, name: str) -> str? {
    let member = json.get(rule, name) ?? return none
    match member {
        Str(value) => value
        _ => none
    }
}

fn has_prefix(name: str, prefixes: []str) -> bool {
    for prefix in prefixes {
        if text.starts_with(name, prefix) {
            return true
        }
    }
    false
}

fn scopes(prefixes: []str) -> fn(str) -> []str {
    fn(source: str) -> []str {
        var words: []str = []
        for rule in rules(source) {
            let name = member_text(rule, "name") ?? continue
            let expression = member_text(rule, "match") ?? continue
            if has_prefix(name, prefixes) {
                for word in alternatives(expression) {
                    push(mut words, word)
                }
            }
        }
        words
    }
}

fn first_capture_name(rule: json.Value) -> str {
    let captures = json.get(rule, "captures") ?? return ""
    let first = json.get(captures, "1") ?? return ""
    member_text(first, "name") ?? ""
}

fn captured(prefix: str) -> fn(str) -> []str {
    fn(source: str) -> []str {
        var words: []str = []
        for rule in rules(source) {
            let name = first_capture_name(rule)
            let expression = member_text(rule, "match") ?? ""
            if text.starts_with(name, prefix) {
                for word in alternatives(expression) {
                    push(mut words, word)
                }
            }
        }
        words
    }
}

fn module_set(name: str) -> fn(str) -> []str {
    let re = pattern("const {name} = new Set\\(\\[([^\\]]*)\\]\\)")
    fn(source: str) -> []str {
        match regex.find(re, source) {
            some(m) => quoted(group_text(m, 1), double_quote)
            none => []
        }
    }
}

fn site_keywords(source: str) -> []str {
    let keywords = module_set("keywords")
    let constants = module_set("constants")
    var words = keywords(source)
    for word in constants(source) {
        if lexer.is_keyword(word) {
            push(mut words, word)
        }
    }
    words
}

fn difference(have: []str, want: []str) -> []str {
    var out: []str = []
    for word in have {
        if !slices.contains(want, word) && !slices.contains(out, word) {
            push(mut out, word)
        }
    }
    slices.sort(mut out)
    out
}
