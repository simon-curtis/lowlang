import lsp
import std/json
import std/testing
import std/text

struct LineCase {
    now: str
    line: i64
    want: i64
}

fn test_completion_module_members(t: *testing.T) {
    let c = start(t)
    defer stop(c)
    let f = read_fixture(t, "modules/main.low")
    open(c, f, f.src)
    let found = complete_typing(c, f, "fn main() {{", "    geometry.")
    expect(t, found, ["circle", "shift", "Point", "Shape", "Circle"], ["offset", "main", "print", "fn"])
    let detail = detail_of(found, "circle")
    testing.error_if(t, detail != "fn circle(r: i64) -> geometry.Circle", "circle detail = {detail}")
    let variants = complete_typing(c, f, "fn main() {{", "    geometry.Shape.")
    expect(t, variants, ["Square", "Dot"], ["circle"])
}

fn test_completion_generated_regex(t: *testing.T) {
    let c = start(t)
    defer stop(c)
    let f = read_fixture(t, "std_regex_api.low")
    open(c, f, f.src)
    let found = complete_typing(c, f, "fn main() {{", "    regex.")
    expect(t, found, ["generated", "compile", "Regex"], ["machine"])
    let detail = detail_of(found, "generated")
    testing.error_if(t, detail != "fn generated(pattern: str) -> regex.Regex", "generated detail = {detail}")
}

fn test_completion_fields(t: *testing.T) {
    let c = start(t)
    defer stop(c)
    let f = read_fixture(t, "structs.low")
    open(c, f, f.src)
    let direct = complete_typing(c, f, "print(r.label)", "    r.")
    expect(t, direct, ["min", "max", "label"], ["x", "print"])
    let detail = detail_of(direct, "label")
    testing.error_if(t, detail != "str", "label detail = {detail}")
    let chained = complete_typing(c, f, "print(r.label)", "    r.max.")
    expect(t, chained, ["x", "y"], ["min"])
    let partial = complete_typing(c, f, "print(r.label)", "    r.max.x")
    expect(t, partial, ["x", "y"], [])
}

fn test_completion_after_calls_and_indexing(t: *testing.T) {
    let c = start(t)
    defer stop(c)
    let f = read_fixture(t, "structs.low")
    open(c, f, f.src)
    let typings = [
        "    origin()."
        "    corner(r)."
        "    add(origin(), Point {{ x: 1, y: (2) }})."
        "    r.max."
        "    corner(r).x"
    ]
    for typed in typings {
        let found = complete_typing(c, f, "print(r.label)", typed)
        expect(t, found, ["x", "y"], ["label", "print"])
    }
    let source = "struct Point {{\n    x: i64\n    y: i64\n}}\n\nenum Problem {{\n    Bad\n}}\n\nfn find(n: i64) -> Point ! Problem {{\n    if n < 0 {{\n        fail Bad\n    }}\n    Point {{ x: n, y: n }}\n}}\n\nfn main() ! Problem {{\n    let pts = [Point {{ x: 1, y: 2 }}]\n    let pick = fn(i: i64) -> Point {{ pts[i] }}\n    print(pts.len)\n}}\n"
    let shapes = scratch(t, "points.low", source)
    defer drop_scratch(shapes)
    open(c, shapes, shapes.src)
    for typed in ["    pts[0].", "    find(1)?.", "    pick(0)."] {
        let found = complete_typing(c, shapes, "print(pts.len)", typed)
        expect(t, found, ["x", "y"], ["print"])
    }
    let unhandled = complete_typing(c, shapes, "print(pts.len)", "    find(1).")
    testing.error_if(t, unhandled.len != 0, "fields offered on an unhandled result: {unhandled.len} items")
}

fn test_completion_after_module_call(t: *testing.T) {
    let c = start(t)
    defer stop(c)
    let f = read_fixture(t, "modules/main.low")
    open(c, f, f.src)
    let found = complete_typing(c, f, "fn main() {{", "    geometry.shift(p).")
    expect(t, found, ["x", "y"], ["circle"])
    let private = complete_typing(c, f, "fn main() {{", "    geometry.circle(2).")
    expect(t, private, [], ["radius"])
}

fn test_compiled_line(t: *testing.T) {
    let compiled = lsp.new_text("a\nb\nc\nd")
    let tables = lsp.new_tables()
    let program = lsp.Program { tables }
    let cases = [
        LineCase { now: "a\nb\nc\nd", line: 2, want: 2 }
        LineCase { now: "a\nx\nb\nc\nd", line: 0, want: 0 }
        LineCase { now: "a\nx\nb\nc\nd", line: 1, want: 0 }
        LineCase { now: "a\nx\nb\nc\nd", line: 3, want: 2 }
        LineCase { now: "a\nx\ny\nz\nd", line: 2, want: 0 }
        LineCase { now: "a\nx\ny\nz\nd", line: 4, want: 3 }
        LineCase { now: "a\nd", line: 1, want: 3 }
        LineCase { now: "x\nb\nc\nd", line: 0, want: -1 }
    ]
    for tc in cases {
        let cursor = new(lsp.Cursor { program, text: lsp.new_text(tc.now), compiled, line: tc.line, col: 0 })
        let got = lsp.compiled_line(cursor)
        testing.error_if(t, got != tc.want, "{tc.now} line {tc.line} -> {got}, want {tc.want}")
    }
}

fn test_completion_scope(t: *testing.T) {
    let c = start(t)
    defer stop(c)
    let f = read_fixture(t, "structs.low")
    open(c, f, f.src)
    let found = complete_typing(c, f, "print(r.label)", "    sn")
    expect(t, found, ["p", "q", "r", "manhattan", "Point", "Shape", "Box", "print", "i64", "match", "none"], ["n", "a", "b", "snapshot", "m"])
    let later = complete_typing(c, f, "let snapshot = r", "    sn")
    expect(t, later, ["r", "snapshot"], ["m"])
    let r_detail = detail_of(found, "r")
    testing.error_if(t, r_detail != "Rect", "r detail = {r_detail}")
    let box_detail = detail_of(found, "Box")
    testing.error_if(t, box_detail != "Shape.Box(Rect)", "Box detail = {box_detail}")
}

fn test_completion_imports_and_helpers(t: *testing.T) {
    let c = start(t)
    defer stop(c)
    let f = read_fixture(t, "modules/main.low")
    open(c, f, f.src)
    let found = complete_typing(c, f, "fn main() {{", "    ")
    expect(t, found, ["geometry", "t", "helper", "main"], ["circle", "offset", "c", "q"])
    let later = complete_typing(c, f, "q.x += 10", "    ")
    expect(t, later, ["c", "s", "p", "q"], ["l", "m", "typed"])
}

fn test_completion_without_compile(t: *testing.T) {
    let c = start(t)
    defer stop(c)
    let f = read_fixture(t, "structs.low")
    open(c, f, "fn main() {{\n    let x = \n}}\n")
    let found = complete(c, f, lsp.Position { line: 1, character: 12 })
    expect(t, found, ["print", "let", "i64"], [])
}
