import lsp
import std/json
import std/testing
import std/text

struct HintCase {
    line: str
    label: str
}

fn hint_after(f: Fixture, hints: []json.Value, line: str) -> str? {
    let lines = text.split(f.src, '\n')
    for h in hints {
        let position = json.field(h, "position")
        if lines[json.int_of(position, "line")] == line {
            return json.text_of(h, "label")
        }
    }
    none
}

fn hint_label(f: Fixture, hints: []json.Value, line: str) -> str {
    hint_after(f, hints, line) ?? ""
}

fn first_word_after(line: str) -> str {
    let fields = text.fields(line)
    fields[1]
}

fn test_inlay_hints(t: *testing.T) {
    let c = start(t)
    defer stop(c)
    let f = read_fixture(t, "structs.low")
    open(c, f, f.src)
    let hints = inlay_hints(c, f)
    let cases = [
        HintCase { line: "    let p = Point {{ x: 3, y: -4 }}", label: ": Point" }
        HintCase { line: "    let q = add(p, Point {{ x: 1, y: 1 }})", label: ": Point" }
        HintCase { line: "    var r = Rect {{", label: ": Rect" }
    ]
    for tc in cases {
        let found = hint_after(f, hints, tc.line)
        let got = found ?? ""
        testing.error_if(t, found == none || got != tc.label, "hint on {tc.line} = {got}, want {tc.label}")
    }
    let lines = text.split(f.src, '\n')
    for h in hints {
        let position = json.field(h, "position")
        let line = lines[json.int_of(position, "line")]
        let name = first_word_after(line)
        let after = text.index(line, " {name}") + 1 + name.len
        let label = json.text_of(h, "label")
        testing.error_if(t, json.int_of(position, "character") != after, "hint {label} not placed after {name} in {line}")
    }
    change(c, f, "{f.src}\nfn broken() {{ let x: i64 = \"s\" }}\n")
    let stale = inlay_hints(c, f)
    testing.error_if(t, stale.len != 0, "hints while the program does not compile = {stale.len}")
}

fn test_inlay_hint_refresh(t: *testing.T) {
    let c = start_with(t, true, false)
    defer stop(c)
    let f = read_fixture(t, "structs.low")
    open(c, f, f.src)
    symbols(c, f)
    testing.error_if(t, asked_count(c, "workspace/inlayHint/refresh") == 0, "no refresh after a successful compile")
    let quiet = start(t)
    defer stop(quiet)
    open(quiet, f, f.src)
    symbols(quiet, f)
    testing.error_if(t, quiet.asked.len != 0, "server requests to a client without refresh support: {quiet.asked.len}")
}

fn test_inlay_hints_skip_written_types(t: *testing.T) {
    let c = start(t)
    defer stop(c)
    let f = scratch(t, "typed.low", "fn main() {{\n    let a: i64 = 1\n    let b = 2\n    for i in 0..3 {{\n        print(i + a + b)\n    }}\n}}\n")
    defer drop_scratch(f)
    open(c, f, f.src)
    let hints = inlay_hints(c, f)
    let written = hint_after(f, hints, "    let a: i64 = 1")
    testing.error_if(t, written != none, "hint on a let with a written type")
    let b = hint_label(f, hints, "    let b = 2")
    testing.error_if(t, b != ": i64", "hint on b = {b}")
    let loop_label = hint_label(f, hints, "    for i in 0..3 {{")
    testing.error_if(t, loop_label != ": i64", "hint on loop variable = {loop_label}")
}

fn test_workspace_symbols(t: *testing.T) {
    let c = start(t)
    defer stop(c)
    let f = read_fixture(t, "modules/main.low")
    open(c, f, f.src)
    let list = workspace_symbols(c, "sh")
    var found: [str: json.Value] = [:]
    for s in list {
        found[json.text_of(s, "name")] = s
    }
    for name in ["shift", "Shape", "shout"] {
        testing.error_if(t, !has(found, name), "missing {name} among {list.len} symbols")
    }
    testing.error_if(t, has(found, "circle"), "circle does not match sh")
    let shift = found["shift"] ?? json.Value.Null
    let location = json.field(shift, "location")
    let line = file_line(t, path_of_location(location), start_of(location).line)
    let container = json.text_of(shift, "containerName")
    testing.error_if(t, !text.contains(line, "fn shift") || container != "geometry", "shift at {line} in {container}")
}
