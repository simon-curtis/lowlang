import lsp
import std/json
import std/testing
import std/text

struct DiagnosticCase {
    name: str
    src: str
    line: i64
    want: str
}

struct NameCase {
    name: str
    want: str
}

struct HeaderCase {
    line: str
    want: str
}

fn test_diagnostics_carry_typed_positions(t: *testing.T) {
    let cases = [
        DiagnosticCase { name: "lex.low", src: "fn main() {{\n    let s = \"open\n}}\n", line: 1, want: "unterminated" }
        DiagnosticCase { name: "parse.low", src: "fn main() {{\n    let = 1\n}}\n", line: 1, want: "expected" }
        DiagnosticCase { name: "check.low", src: "fn main() {{\n    let x: i64 = \"s\"\n}}\n", line: 1, want: "i64" }
        DiagnosticCase { name: "module.low", src: "\n\nimport nowhere\n\nfn main() {{\n}}\n", line: 2, want: "cannot find module nowhere" }
    ]
    for tc in cases {
        testing.sub(t, tc.name, fn(s: *testing.T) { diagnostic_case(s, tc) })
    }
}

fn diagnostic_case(t: *testing.T, tc: DiagnosticCase) {
    let c = start(t)
    defer stop(c)
    let f = scratch(t, tc.name, tc.src)
    defer drop_scratch(f)
    let got = open(c, f, f.src)
    testing.fatal_if(t, got.len != 1, "diagnostics = {got.len}, want one")
    let line = start_of(got[0]).line
    let message = json.text_of(got[0], "message")
    testing.error_if(t, line != tc.line, "line = {line}, want {tc.line} ({message})")
    testing.error_if(t, !text.contains(message, tc.want), "message = {message}, want it to mention {tc.want}")
    testing.error_if(t, text.starts_with(message, f.path), "message = {message} still carries the position")
}

fn test_malformed_notification_is_logged(t: *testing.T) {
    let c = start(t)
    defer stop(c)
    notify(c, "textDocument/didOpen", "{{\"textDocument\":5}}")
    request(c, "shutdown", "null")
    let logged = asked_count(c, "window/logMessage")
    testing.error_if(t, logged != 1, "window/logMessage sent {logged} times, want 1")
}

fn test_malformed_request_fails(t: *testing.T) {
    let c = start(t)
    defer stop(c)
    let reply = call(c, "textDocument/hover", "\"position\"")
    match reply.failure {
        some(failure) => {
            testing.error_if(t, failure.code != lsp.invalid_params, "failure code = {failure.code}, want invalid params")
        }
        none => {
            testing.error(t, "request succeeded, want invalid params")
        }
    }
}

fn test_name_error(t: *testing.T) {
    let tables = lsp.new_tables()
    let cases = [
        NameCase { name: "count", want: "" }
        NameCase { name: "_count", want: "" }
        NameCase { name: "fn", want: "is a keyword" }
        NameCase { name: "2c", want: "not a valid name" }
        NameCase { name: "a b", want: "not a valid name" }
        NameCase { name: "", want: "not a valid name" }
        NameCase { name: "__c", want: "are reserved" }
    ]
    for tc in cases {
        let found = lsp.name_error(tables, tc.name)
        let message = found ?? ""
        let bad = if tc.want == "" { found != none } else { found == none || !text.contains(message, tc.want) }
        testing.error_if(t, bad, "{tc.name}: {message}, want {tc.want}")
    }
}

fn test_header_name(t: *testing.T) {
    let cases = [
        HeaderCase { line: "fn main() {{", want: "main" }
        HeaderCase { line: "pub fn area(s: Shape) {{", want: "area" }
        HeaderCase { line: "    fn puts(s: str)", want: "puts" }
        HeaderCase { line: "\tpub fn read(fd: i64)", want: "read" }
        HeaderCase { line: "let f = fn(x: i64) {{ x }}", want: "" }
        HeaderCase { line: "// fn main() {{", want: "" }
        HeaderCase { line: "    print(\"fn x\")", want: "" }
        HeaderCase { line: "fn", want: "" }
    ]
    for tc in cases {
        let got = lsp.header_name(tc.line)
        testing.error_if(t, got != tc.want, "header_name({tc.line}) = {got}, want {tc.want}")
    }
}
