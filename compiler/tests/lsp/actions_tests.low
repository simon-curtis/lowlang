import lsp
import std/json
import std/testing
import std/text

const open_file_source = "import std/file\n\nfn main() {{\n  file.open(\"data.txt\")?\n}}\n"

const parse_twice_source = "enum ParseError {{\n    Empty\n}}\n\nfn parse(s: str) -> i64 ! ParseError {{\n    if s.len == 0 {{ fail Empty }}\n    1\n}}\n\nfn twice(s: str) -> i64 {{\n    parse(s)? * 2\n}}\n\nfn main() ! ParseError {{\n    print(twice(\"4\")?)\n}}\n"

fn found_action(t: *testing.T, actions: [str: json.Value], title: str) -> json.Value {
    match actions[title] {
        some(action) => action
        none => {
            testing.fatal(t, "no {title} action among {actions.len}")
            json.Value.Null
        }
    }
}

fn test_lift_imports_the_error_module(t: *testing.T) {
    let c = start(t)
    defer stop(c)
    let f = scratch(t, "main.low", open_file_source)
    defer drop_scratch(f)
    open(c, f, f.src)
    let actions = code_actions(c, f, fixture_at(t, f, "file.open", 0))
    let lift = found_action(t, actions, "Add ! io.Error to main")
    let want = "import std/file\nimport std/io\n\nfn main() ! io.Error {{\n  file.open(\"data.txt\")?\n}}\n"
    let got = applied(t, f, lift)
    testing.fatal_if(t, got != want, "lift produced\n{got}\nwant\n{want}")
    compiles(t, f.path, only(f.path, got))
}

fn test_catch_wraps_the_try(t: *testing.T) {
    let c = start(t)
    defer stop(c)
    let f = scratch(t, "main.low", open_file_source)
    defer drop_scratch(f)
    open(c, f, f.src)
    let actions = code_actions(c, f, fixture_at(t, f, "?", 0))
    let catch_action = found_action(t, actions, "Catch the error")
    let want = "import std/file\n\nfn main() {{\n  file.open(\"data.txt\") catch {{\n    e => return\n  }}\n}}\n"
    let got = applied(t, f, catch_action)
    testing.fatal_if(t, got != want, "catch produced\n{got}\nwant\n{want}")
    compiles(t, f.path, only(f.path, got))
}

fn test_or_replaces_the_try(t: *testing.T) {
    let c = start(t)
    defer stop(c)
    let f = scratch(t, "main.low", open_file_source)
    defer drop_scratch(f)
    open(c, f, f.src)
    let actions = code_actions(c, f, fixture_at(t, f, "?", 0))
    let or_action = found_action(t, actions, "Ignore the error with or")
    let want = "import std/file\n\nfn main() {{\n  file.open(\"data.txt\") or return\n}}\n"
    let got = applied(t, f, or_action)
    testing.fatal_if(t, got != want, "or produced\n{got}\nwant\n{want}")
    compiles(t, f.path, only(f.path, got))
}

fn test_or_places_the_cursor_after_or(t: *testing.T) {
    let c = start_with(t, false, true)
    defer stop(c)
    let f = scratch(t, "main.low", parse_twice_source)
    defer drop_scratch(f)
    open(c, f, f.src)
    let actions = code_actions(c, f, fixture_at(t, f, "parse(s)?", 0))
    let or_action = found_action(t, actions, "Ignore the error with or")
    let changes = items(json.field(json.field(or_action, "edit"), "documentChanges"))
    testing.fatal_if(t, changes.len != 1, "want one snippet edit, got {changes.len} changes")
    let edits = items(json.field(changes[0], "edits"))
    testing.fatal_if(t, edits.len != 1, "want one snippet edit, got {edits.len} edits")
    let want = "    parse(s) or $0"
    let got = json.text_of(json.field(edits[0], "snippet"), "value")
    testing.fatal_if(t, got != want, "snippet {got}, want {want}")
}

fn test_catch_places_the_cursor_in_the_arm(t: *testing.T) {
    let c = start_with(t, false, true)
    defer stop(c)
    let f = scratch(t, "main.low", open_file_source)
    defer drop_scratch(f)
    open(c, f, f.src)
    change_versioned(c, f, 7, f.src)
    let actions = code_actions(c, f, fixture_at(t, f, "?", 0))
    let catch_action = found_action(t, actions, "Catch the error")
    let changes = items(json.field(json.field(catch_action, "edit"), "documentChanges"))
    testing.fatal_if(t, changes.len != 1, "want one snippet edit at version 7, got {changes.len} changes")
    let version = json.int_of(json.field(changes[0], "textDocument"), "version")
    let edits = items(json.field(changes[0], "edits"))
    testing.fatal_if(t, version != 7 || edits.len != 1, "want one snippet edit at version 7, got version {version} and {edits.len} edits")
    let edit = edits[0]
    let want = "  file.open(\"data.txt\") catch {{\n    e => $0\n  \\}}"
    let got = json.text_of(json.field(edit, "snippet"), "value")
    testing.fatal_if(t, got != want, "snippet {got}, want {want}")
    let try_end = fixture_at(t, f, "?", 1)
    let from = start_of(edit)
    let to = end_of(edit)
    let ok = from.line == try_end.line && from.character == 0 && same_position(to, try_end)
    testing.fatal_if(t, !ok, "snippet replaces {position_text(from)}-{position_text(to)}, want {try_end.line}:0-{position_text(try_end)}")
}

fn test_lift_after_result_type(t: *testing.T) {
    let c = start(t)
    defer stop(c)
    let f = scratch(t, "main.low", parse_twice_source)
    defer drop_scratch(f)
    open(c, f, f.src)
    let actions = code_actions(c, f, fixture_at(t, f, "parse(s)?", 0))
    let lift = found_action(t, actions, "Add ! ParseError to twice")
    let got = applied(t, f, lift)
    compiles(t, f.path, only(f.path, got))
}

fn handlers(t: *testing.T, actions: [str: json.Value]) {
    let ok = actions.len == 2 && has(actions, "Catch the error") && has(actions, "Ignore the error with or")
    testing.fatal_if(t, !ok, "want only the catch and or actions, got {actions.len}")
}

fn test_lift_needs_an_undeclared_error_type(t: *testing.T) {
    let c = start(t)
    defer stop(c)
    let f = scratch(t, "main.low", parse_twice_source)
    defer drop_scratch(f)
    open(c, f, f.src)
    handlers(t, code_actions(c, f, fixture_at(t, f, "twice(\"4\")?", 0)))
}

fn test_no_lift_into_an_expression_closure(t: *testing.T) {
    let c = start(t)
    defer stop(c)
    let source = text.replace(parse_twice_source, "print(twice(\"4\")?)", "let f = fn(text: str) parse(text)?")
    let f = scratch(t, "main.low", source)
    defer drop_scratch(f)
    open(c, f, f.src)
    handlers(t, code_actions(c, f, fixture_at(t, f, "parse(text)?", 0)))
}

fn test_no_actions_away_from_try(t: *testing.T) {
    let c = start(t)
    defer stop(c)
    let f = scratch(t, "main.low", open_file_source)
    defer drop_scratch(f)
    open(c, f, f.src)
    let actions = code_actions(c, f, fixture_at(t, f, "fn main", 0))
    testing.fatal_if(t, actions.len != 0, "want no actions, got {actions.len}")
}
