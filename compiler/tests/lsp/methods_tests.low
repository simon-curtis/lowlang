import lsp
import std/json
import std/testing
import std/text

struct MethodCase {
    typed: str
    present: []str
    absent: []str
}

const methods_source = "struct Point {{\n    x: i64\n    y: i64\n}}\n\nstruct Op {{\n    apply: fn(i64) -> i64\n}}\n\nenum Level {{\n    Low = 1,\n    High = 2,\n}}\n\nenum Mode {{\n    On, Off,\n}}\n\nfn scale(p: Point, by: i64) -> Point {{\n    Point {{ x: p.x * by, y: p.y * by }}\n}}\n\nfn norm(p: Point) -> i64 {{\n    p.x + p.y\n}}\n\nfn first[T](xs: []T) -> T {{\n    xs[0]\n}}\n\nfn unrelated(n: i64) -> i64 {{\n    n\n}}\n\nfn main() {{\n    let p = Point {{ x: 1, y: 2 }}\n    let pts = [p]\n    let level = Level.Low\n    let mode = Mode.On\n    let op = Op {{ apply: fn(n: i64) -> i64 {{ n }} }}\n    print(p.norm() + op.apply(1) + pts.first().x + level.index)\n    print(mode == Mode.Off)\n}}\n"

const imported_methods_source = "import std/http\n\nfn host_of(u: http.Url) -> str {{\n    u.host\n}}\n\nfn show(u: http.Url) -> str {{\n    u.authority()\n}}\n\nfn main() {{\n    print(show(http.Url {{ scheme: \"http\", host: \"a\", port: 80, target: \"/\" }}))\n}}\n"

const constrained_source = "struct Point {{\n    x: i64\n    y: i64\n}}\n\nfn biggest[T: Ord](xs: []T) -> T {{\n    var best = xs[0]\n    for x in xs {{\n        if x > best {{\n            best = x\n        }}\n    }}\n    best\n}}\n\nfn first[T](xs: []T) -> T {{\n    xs[0]\n}}\n\nfn main() {{\n    let pts = [Point {{ x: 1, y: 2 }}]\n    let ints = [1, 2]\n    print(pts.first().x + ints.biggest())\n}}\n"

const local_func_source = "struct Point {{\n    x: i64\n}}\n\nfn main() {{\n    let p = Point {{ x: 1 }}\n    let show = fn(q: Point?) -> i64 {{ 0 }}\n    let other = fn(n: i64) -> i64 {{ n }}\n    print(p.show() + other(1))\n}}\n"

const slice_methods_source = "import std/slices\nimport std/text\n\nfn main() {{\n    let words = text.fields(\"a bb\")\n    let name = \"x\"\n    print(words.map(fn(w) w.len).sum() + name.len)\n}}\n"

fn test_method_completion(t: *testing.T) {
    let c = start(t)
    defer stop(c)
    let f = scratch(t, "methods.low", methods_source)
    defer drop_scratch(f)
    let opened = open(c, f, f.src)
    testing.fatal_if(t, opened.len != 0, "diagnostics = {opened.len}")
    let cases = [
        MethodCase { typed: "    p.", present: ["x", "y", "scale", "norm"], absent: ["unrelated", "first", "print"] }
        MethodCase { typed: "    pts.", present: ["len", "first", "push"], absent: ["norm", "x"] }
        MethodCase { typed: "    p.scale(2).", present: ["x", "y", "norm"], absent: ["len"] }
        MethodCase { typed: "    p.scale(2).norm().", present: [], absent: ["x", "norm"] }
        MethodCase { typed: "    level.", present: ["index"], absent: ["len"] }
        MethodCase { typed: "    mode.", present: [], absent: ["index"] }
    ]
    for tc in cases {
        let found = complete_typing(c, f, "let op = ", tc.typed)
        expect(t, found, tc.present, tc.absent)
    }
}

fn test_method_signature_and_navigation(t: *testing.T) {
    let c = start(t)
    defer stop(c)
    let f = scratch(t, "methods.low", methods_source)
    defer drop_scratch(f)
    open(c, f, f.src)
    let scale = signature(c, f, "let op = ", "    p.scale(")
    testing.error_if(t, !has_help(scale) || active_param(scale) != "by: i64", "p.scale( help = {json.stringify(scale, 0)}")
    let apply = signature(c, f, "let op = ", "    op.apply(")
    testing.error_if(t, !has_help(apply) || active_param(apply) != "i64", "op.apply( help = {json.stringify(apply, 0)}")
    change(c, f, f.src)
    let receiver = hover(c, f, fixture_at(t, f, "print(p.norm()", 6))
    testing.error_if(t, !text.contains(receiver, "let p: Point"), "hover on receiver = {receiver}")
    let loc = definition(c, f, fixture_at(t, f, "p.norm()", 2))
    let want = fixture_at(t, f, "fn norm", 3)
    testing.error_if(t, !same_position(start_of(loc), want), "definition of norm = {position_text(start_of(loc))}")
}

fn test_imported_methods(t: *testing.T) {
    let c = start(t)
    defer stop(c)
    let f = scratch(t, "imported.low", imported_methods_source)
    defer drop_scratch(f)
    let opened = open(c, f, f.src)
    testing.fatal_if(t, opened.len != 0, "diagnostics = {opened.len}")
    let found = complete_typing(c, f, "fn show(u: http.Url) -> str {{", "    u.")
    expect(t, found, ["host", "authority", "host_of"], ["default_port", "parse_url"])
    let help = signature(c, f, "fn show(u: http.Url) -> str {{", "    u.authority(")
    testing.error_if(t, !has_help(help), "u.authority( help = {json.stringify(help, 0)}")
}

fn test_constrained_method_completion(t: *testing.T) {
    let c = start(t)
    defer stop(c)
    let f = scratch(t, "constrained.low", constrained_source)
    defer drop_scratch(f)
    let opened = open(c, f, f.src)
    testing.fatal_if(t, opened.len != 0, "diagnostics = {opened.len}")
    let points = complete_typing(c, f, "let ints = ", "    pts.")
    expect(t, points, ["first"], ["biggest"])
    let ints = complete_typing(c, f, "print(pts.first", "    ints.")
    expect(t, ints, ["first", "biggest"], [])
}

fn test_method_completion_offers_locals_accepting_the_receiver(t: *testing.T) {
    let c = start(t)
    defer stop(c)
    let f = scratch(t, "localfn.low", local_func_source)
    defer drop_scratch(f)
    let opened = open(c, f, f.src)
    testing.fatal_if(t, opened.len != 0, "diagnostics = {opened.len}")
    let found = complete_typing(c, f, "print(p.show", "    p.")
    expect(t, found, ["show"], ["other"])
}

fn test_methods_from_imported_modules(t: *testing.T) {
    let c = start(t)
    defer stop(c)
    let f = scratch(t, "slices.low", slice_methods_source)
    defer drop_scratch(f)
    let opened = open(c, f, f.src)
    testing.fatal_if(t, opened.len != 0, "diagnostics = {opened.len}")
    var found = complete_typing(c, f, "let words = text.fields(\"a bb\")", "    words.")
    expect(t, found, ["map", "scan", "count", "len"], ["trim", "fields"])
    found = complete_typing(c, f, "let name = \"x\"", "    name.")
    expect(t, found, ["trim", "fields", "count"], ["scan", "flat_map"])
    let help = signature(c, f, "let words = text.fields(\"a bb\")", "    words.scan(")
    testing.error_if(t, !has_help(help) || active_param(help) != "initial: A", "words.scan( help = {json.stringify(help, 0)}")
}
