import lsp
import target
import std/testing
import std/text

const names_program = "import std/slices\n\nstruct Point {{\n    x: i64\n    y: i64\n}}\n\n/// Adds the coordinates.\nfn total(p: Point) -> i64 {{\n    p.x + p.y\n}}\n\nfn main() {{\n    let x = 1\n    let p = Point {{ x, y: 2 }}\n    print(total(p))\n    print(slices.sum([x, 2]))\n}}\n"

struct Found {
    at: i64
    name: *lsp.Name
}

fn names_of(t: *testing.T, f: Fixture) -> []*lsp.Name {
    let none_found: []*lsp.Name = []
    lsp.names(f.path, target.host()) catch {
        e => testing.must(t, e, none_found)
    }
}

fn name_at(t: *testing.T, found: []*lsp.Name, line: i64, column: i64) -> Found {
    for at, n in found {
        if n.line == line && n.column <= column && column <= n.column + n.name.len {
            return Found { at, name: n }
        }
    }
    testing.fatal(t, "no name at {line}:{column}")
    Found { at: 0, name: found[0] }
}

fn test_names_describe_every_occurrence(t: *testing.T) {
    let f = scratch(t, "main.low", names_program)
    defer drop_scratch(f)
    let found = names_of(t, f)

    let call = name_at(t, found, 16, 11).name
    testing.error_if(t, call.name != "total" || call.hover != "fn total(p: Point) -> i64" || call.doc != "Adds the coordinates.", "call to total described as {call.name} {call.hover} {call.doc}")
    let defined = call.definition ?? lsp.Definition { path: "", line: 0, column: 0, local: false }
    testing.error_if(t, call.definition == none || !defined.local || defined.line != 9 || defined.column != 4, "call to total defined at {defined.path}:{defined.line}:{defined.column}")

    let imported = name_at(t, found, 17, 18).name
    let source = imported.definition ?? lsp.Definition { path: "", line: 0, column: 0, local: true }
    testing.error_if(t, imported.definition == none || source.local || !text.ends_with(source.path, "std/slices/slices.low"), "slices.sum defined at {source.path}")

    let builtin = name_at(t, found, 16, 5).name
    testing.error_if(t, builtin.definition != none || builtin.first != none, "print has a definition")
}

fn test_names_group_references(t: *testing.T) {
    let f = scratch(t, "main.low", names_program)
    defer drop_scratch(f)
    let found = names_of(t, f)

    let declaration = name_at(t, found, 9, 4)
    let call = name_at(t, found, 16, 11)
    let declaration_first = declaration.name.first ?? -1
    let call_first = call.name.first ?? -1
    testing.error_if(t, declaration_first < 0 || call_first < 0 || declaration_first != call_first || call_first > declaration.at, "total declaration and call are not one group: {declaration_first} {call_first}")

    let local = name_at(t, found, 14, 9).name
    let shorthand = name_at(t, found, 15, 21).name
    let field = name_at(t, found, 4, 5).name
    let use = name_at(t, found, 17, 23).name
    let local_first = local.first ?? -1
    let use_first = use.first ?? -1
    testing.error_if(t, local_first < 0 || use_first < 0 || local_first != use_first, "local x and its use are not one group: {local_first} {use_first}")
    let shorthand_first = shorthand.first ?? -1
    let field_first = field.first ?? -1
    testing.error_if(t, shorthand_first < 0 || field_first < 0 || shorthand_first != field_first, "shorthand x and field x are not one group: {shorthand_first} {field_first}")
}

fn test_names_fail_on_a_compile_error(t: *testing.T) {
    let f = scratch(t, "main.low", "fn main() {{\n    missing()\n}}\n")
    defer drop_scratch(f)
    let found = lsp.names(f.path, target.host()) catch {
        _ => return
    }
    testing.error(t, "a program that does not check produced {found.len} names")
}
