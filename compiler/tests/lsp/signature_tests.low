import std/json
import std/testing

struct SignatureCase {
    typed: str
    label: str
    param: str
}

fn test_signature_help(t: *testing.T) {
    let c = start(t)
    defer stop(c)
    let f = read_fixture(t, "structs.low")
    open(c, f, f.src)
    let add = "fn add(a: Point, b: Point) -> Point"
    let cases = [
        SignatureCase { typed: "    add(", label: add, param: "a: Point" }
        SignatureCase { typed: "    add(p, ", label: add, param: "b: Point" }
        SignatureCase { typed: "    print(add(p, ", label: add, param: "b: Point" }
        SignatureCase { typed: "    add(origin(), ", label: add, param: "b: Point" }
        SignatureCase { typed: "    add(\"a,(b\", ", label: add, param: "b: Point" }
        SignatureCase { typed: "    add(\n        p,\n        ", label: add, param: "b: Point" }
        SignatureCase { typed: "    add([p, q], ", label: add, param: "b: Point" }
        SignatureCase { typed: "    Box(", label: "Shape.Box(Rect)", param: "Rect" }
    ]
    for tc in cases {
        let help = signature(c, f, "print(r.label)", tc.typed)
        if !has_help(help) {
            testing.error(t, "{tc.typed}: no signature help")
            continue
        }
        let label = signature_label(help)
        testing.error_if(t, label != tc.label, "{tc.typed}: label = {label}, want {tc.label}")
        let active = active_param(help)
        testing.error_if(t, active != tc.param, "{tc.typed}: active = {active}, want {tc.param}")
    }
    for typed in ["    add(p, q) ", "    unknown(", "    let x = 1"] {
        let help = signature(c, f, "print(r.label)", typed)
        testing.error_if(t, has_help(help), "{typed}: signature help = {json.stringify(help, 0)}, want none")
    }
}

fn test_signature_help_across_modules(t: *testing.T) {
    let c = start(t)
    defer stop(c)
    let f = read_fixture(t, "modules/main.low")
    open(c, f, f.src)
    let help = signature(c, f, "fn main() {{", "    geometry.circle(")
    testing.fatal_if(t, !has_help(help), "no signature help")
    let label = signature_label(help)
    testing.error_if(t, label != "fn circle(r: i64) -> geometry.Circle", "label = {label}")
    let variant = signature(c, f, "fn main() {{", "    geometry.Shape.Square(")
    let ok = has_help(variant) && signature_label(variant) == "Shape.Square(i64)"
    testing.error_if(t, !ok, "variant help = {json.stringify(variant, 0)}")
}
