import std/testing
import std/text

fn test_hover_on_using_bindings(t: *testing.T) {
    let c = start(t)
    defer stop(c)
    let f = read_fixture(t, "using.low")
    open(c, f, f.src)
    let cases = [
        HoverCase { at: fixture_at(t, f, "using log = open", 6), want: "using log: File" }
        HoverCase { at: fixture_at(t, f, "using b = a", 10), want: "using a: File" }
        HoverCase { at: fixture_at(t, f, "Conn {{ id, log }}", 11), want: "log: File" }
        HoverCase { at: fixture_at(t, f, "fn connect(id: i64)", 11), want: "id: i64" }
    ]
    check_hovers(t, c, f, cases)
}

fn test_drop_bodies_and_test_arms_are_indexed(t: *testing.T) {
    let c = start(t)
    defer stop(c)
    let source = "struct File {{\n    fd: i64\n    label: str = make_label(3)\n    drop release(fd)\n}}\n\nfn release(fd: i64) {{\n    print(fd)\n}}\n\nfn make_label(n: i64) -> str {{\n    \"file\"\n}}\n\nfn limit(scale: i64) -> i64 {{\n    scale * 2\n}}\n\nfn band(n: i64) -> str {{\n    match n {{\n        < limit(5) => \"low\",\n        _ => \"high\"\n    }}\n}}\n\nfn main() {{\n    using f = File {{ fd: 3 }}\n    print(band(f.fd))\n}}\n"
    let f = scratch(t, "drops.low", source)
    defer drop_scratch(f)
    let opened = open(c, f, f.src)
    testing.fatal_if(t, opened.len != 0, "diagnostics = {opened.len}")
    let cases = [
        HoverCase { at: fixture_at(t, f, "drop release(fd)", 5), want: "fn release(fd: i64)" }
        HoverCase { at: fixture_at(t, f, "= make_label(3)", 2), want: "fn make_label(n: i64) -> str" }
        HoverCase { at: fixture_at(t, f, "< limit(5)", 2), want: "fn limit(scale: i64) -> i64" }
    ]
    check_hovers(t, c, f, cases)
    let loc = definition(c, f, fixture_at(t, f, "drop release(fd)", 5))
    let want = fixture_at(t, f, "fn release", 3)
    testing.error_if(t, !same_position(start_of(loc), want), "definition of release from drop = {position_text(start_of(loc))}")
}
