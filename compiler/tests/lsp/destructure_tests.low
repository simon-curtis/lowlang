import lsp
import std/testing
import std/text

const destructure_source = "struct Point {{\n    x: i64\n    y: i64\n}}\n\nstruct Rect {{\n    min: Point\n    max: Point\n}}\n\nfn main() {{\n    let r = Rect {{ min: Point {{ x: 1, y: 2 }}, max: Point {{ x: 3, y: 4 }} }}\n    let {{ min: {{ x, y }}, max: top }} = r\n    print(x + y + top.x)\n    for {{ x: px }} in [r.min, r.max] {{\n        print(px)\n    }}\n}}\n"

fn test_destructure_hover_and_definition(t: *testing.T) {
    let c = start(t)
    defer stop(c)
    let f = scratch(t, "destructure.low", destructure_source)
    defer drop_scratch(f)
    open(c, f, f.src)
    let shorthand = hover(c, f, fixture_at(t, f, "x + y", 0))
    testing.error_if(t, !text.contains(shorthand, "x: i64"), "hover on a shorthand-bound use = {shorthand}")
    let bound = hover(c, f, fixture_at(t, f, "top.x", 0))
    testing.error_if(t, !text.contains(bound, "top: Point"), "hover on a bound name = {bound}")
    let key = hover(c, f, fixture_at(t, f, "min: {{", 0))
    testing.error_if(t, !text.contains(key, "min: Point"), "hover on a field key = {key}")
    let x = definition(c, f, fixture_at(t, f, "x + y", 0))
    testing.error_if(t, !same_position(start_of(x), fixture_at(t, f, "{{ x, y }}", 2)), "definition of x = {position_text(start_of(x))}")
    let top = definition(c, f, fixture_at(t, f, "top.x", 0))
    testing.error_if(t, !same_position(start_of(top), fixture_at(t, f, "top }}", 0)), "definition of top = {position_text(start_of(top))}")
    let min = definition(c, f, fixture_at(t, f, "min: {{", 0))
    testing.error_if(t, !same_position(start_of(min), fixture_at(t, f, "    min: Point", 4)), "definition of the field key min = {position_text(start_of(min))}")
}

fn test_destructure_references(t: *testing.T) {
    let c = start(t)
    defer stop(c)
    let f = scratch(t, "destructure.low", destructure_source)
    defer drop_scratch(f)
    open(c, f, f.src)
    let locals = references(c, f, fixture_at(t, f, "x + y", 0), true)
    testing.error_if(t, locals.len != 2, "references to the local x = {locals.len}, want 2")
    let fields = references(c, f, fixture_at(t, f, "    x: i64", 4), true)
    testing.error_if(t, fields.len < 4, "references to the field x = {fields.len}, want at least 4")
}

fn test_rename_local_in_shorthand_pattern(t: *testing.T) {
    let c = start(t)
    defer stop(c)
    let f = scratch(t, "destructure.low", destructure_source)
    defer drop_scratch(f)
    open(c, f, f.src)
    let edited = renamed(c, f, fixture_at(t, f, "x + y", 0), "left")
    let got = edited_text(edited, f.path)
    let ok = text.contains(got, "min: {{ x: left, y }}") && text.contains(got, "left + y + top.x")
    testing.error_if(t, !ok, "local rename:\n{got}")
    compiles(t, f.path, edited)
}

fn test_rename_field_in_shorthand_pattern(t: *testing.T) {
    let c = start(t)
    defer stop(c)
    let f = scratch(t, "destructure.low", destructure_source)
    defer drop_scratch(f)
    open(c, f, f.src)
    let edited = renamed(c, f, fixture_at(t, f, "    x: i64", 4), "column")
    let got = edited_text(edited, f.path)
    let ok = text.contains(got, "min: {{ column: x, y }}") && text.contains(got, "for {{ column: px }}") && text.contains(got, "Point {{ column: 1")
    testing.error_if(t, !ok, "field rename:\n{got}")
    compiles(t, f.path, edited)
}

fn test_rename_bound_name_in_pattern(t: *testing.T) {
    let c = start(t)
    defer stop(c)
    let f = scratch(t, "destructure.low", destructure_source)
    defer drop_scratch(f)
    open(c, f, f.src)
    let edited = renamed(c, f, fixture_at(t, f, "top.x", 0), "upper")
    let got = edited_text(edited, f.path)
    let ok = text.contains(got, "max: upper }}") && text.contains(got, "upper.x")
    testing.error_if(t, !ok, "bound name rename:\n{got}")
    compiles(t, f.path, edited)
}
