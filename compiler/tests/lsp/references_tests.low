import lsp
import std/json
import std/path
import std/testing
import std/text

struct RefusalCase {
    at: lsp.Position
    name: str
    reason: str
}

fn test_references(t: *testing.T) {
    let c = start(t)
    defer stop(c)
    let f = read_fixture(t, "enums.low")
    open(c, f, f.src)
    let at = fixture_at(t, f, "print(area(big))", 6)
    let with = references(c, f, at, true)
    let want = text.count(f.src, "area(")
    testing.error_if(t, with.len != want, "references with declaration = {with.len}, want {want}")
    let without = references(c, f, at, false)
    testing.error_if(t, without.len != want - 1, "references without declaration = {without.len}, want {want - 1}")
    let declaration = fixture_at(t, f, "fn area(", 3)
    for loc in without {
        testing.error_if(t, same_position(start_of(loc), declaration), "declaration included in {without.len} references")
    }
}

fn test_rename_local_leaves_other_functions(t: *testing.T) {
    let c = start(t)
    defer stop(c)
    let f = read_fixture(t, "structs.low")
    open(c, f, f.src)
    let edited = renamed(c, f, fixture_at(t, f, "print(r.label)", 6), "rect")
    let src = edited_text(edited, f.path)
    let ok = text.contains(src, "print(rect.label)") && text.contains(src, "r.max.x - r.min.x")
    testing.error_if(t, !ok, "rename touched the wrong r:\n{src}")
    compiles(t, f.path, edited)
}

fn test_rename_field_expands_shorthand(t: *testing.T) {
    let c = start(t)
    defer stop(c)
    let source = "struct Point {{\n    x: i64\n    y: i64\n}}\n\nfn make(x: i64, y: i64) -> Point {{\n    Point {{ x, y }}\n}}\n\nfn main() {{\n    let p = make(1, 2)\n    print(p.x)\n}}\n"
    let f = scratch(t, "shorthand.low", source)
    defer drop_scratch(f)
    open(c, f, f.src)
    let field = renamed(c, f, fixture_at(t, f, "    x: i64", 4), "px")
    let field_src = edited_text(field, f.path)
    testing.error_if(t, !text.contains(field_src, "Point {{ px: x, y }}") || !text.contains(field_src, "p.px"), "field rename:\n{field_src}")
    compiles(t, f.path, field)
    let param = renamed(c, f, fixture_at(t, f, "fn make(x", 8), "a")
    let param_src = edited_text(param, f.path)
    testing.error_if(t, !text.contains(param_src, "Point {{ x: a, y }}") || !text.contains(param_src, "fn make(a: i64"), "parameter rename:\n{param_src}")
    compiles(t, f.path, param)
}

fn test_rename_field_skips_trailing_block(t: *testing.T) {
    let c = start(t)
    defer stop(c)
    let source = "struct Box {{\n    tag: i64 = 0\n    children: []i64 = []\n}}\n\nfn main() {{\n    let b = Box {{ tag: 1 }} {{\n        1\n        2\n    }}\n    let d = Box {{}}\n    print(b.children.len)\n    print(d.tag)\n}}\n"
    let f = scratch(t, "trailing.low", source)
    defer drop_scratch(f)
    open(c, f, f.src)
    let edited = renamed(c, f, fixture_at(t, f, "    children: []i64", 4), "items")
    let got = edited_text(edited, f.path)
    let bad = text.contains(got, "items: children") || !text.contains(got, "b.items.len") || !text.contains(got, "Box {{ tag: 1 }} {{")
    testing.error_if(t, bad, "field rename:\n{got}")
    let over = hover(c, f, fixture_at(t, f, "}} {{", 2))
    testing.error_if(t, over != "", "hover on the trailing brace = {over}, want nothing")
}

fn test_interpolation_with_width_and_format(t: *testing.T) {
    let c = start(t)
    defer stop(c)
    let source = "fn main() {{\n    let ratio = 3.14159\n    print(\"{{ratio,10:f2}}|{{ratio:e1}}|{{ratio, -8}}|{{ratio}}\")\n}}\n"
    let f = scratch(t, "specs.low", source)
    defer drop_scratch(f)
    open(c, f, f.src)
    for probe in ["{{ratio,10:f2}}", "{{ratio:e1}}", "{{ratio, -8}}", "{{ratio}}"] {
        let at = fixture_at(t, f, probe, 1)
        let shown = hover(c, f, at)
        testing.error_if(t, !text.contains(shown, "f64"), "hover on ratio in {probe} = {shown}, want its type")
        let loc = definition(c, f, at)
        let want = fixture_at(t, f, "let ratio", 4)
        testing.error_if(t, !same_position(start_of(loc), want), "definition of ratio in {probe} = {position_text(start_of(loc))}")
    }
    let found = references(c, f, fixture_at(t, f, "{{ratio,10:f2}}", 1), true)
    testing.error_if(t, found.len != 5, "references to ratio = {found.len}, want 5")
    let edited = renamed(c, f, fixture_at(t, f, "let ratio", 4), "r")
    let want = "print(\"{{r,10:f2}}|{{r:e1}}|{{r, -8}}|{{r}}\")"
    let got = edited_text(edited, f.path)
    testing.error_if(t, !text.contains(got, want), "rename left specs misplaced:\n{got}")
    compiles(t, f.path, edited)
}

fn test_rename_binding_arm(t: *testing.T) {
    let c = start(t)
    defer stop(c)
    let source = "enum Oops {{\n    Bad(i64)\n    Worse\n}}\n\nfn risky(n: i64) -> i64 ! Oops {{\n    if n > 2 {{\n        fail Bad(n)\n    }}\n    n\n}}\n\nfn describe(e: Oops) -> i64 {{\n    match e {{\n        Bad(n) => n\n        Worse => 0\n    }}\n}}\n\nfn main() {{\n    print(risky(5) catch {{\n        problem => describe(problem)\n    }})\n}}\n"
    let f = scratch(t, "binding.low", source)
    defer drop_scratch(f)
    open(c, f, f.src)
    let edited = renamed(c, f, fixture_at(t, f, "problem =>", 0), "err")
    let got = edited_text(edited, f.path)
    testing.error_if(t, !text.contains(got, "err => describe(err)"), "binding arm rename:\n{got}")
    compiles(t, f.path, edited)
}

fn test_rename_catch_mapper(t: *testing.T) {
    let c = start(t)
    defer stop(c)
    let source = "enum Inner {{\n    Bad\n}}\n\nenum Outer {{\n    Wrap(Inner)\n}}\n\nfn lift(e: Inner) -> Outer {{\n    Wrap(e)\n}}\n\nfn risky() -> i64 ! Inner {{\n    fail Bad\n}}\n\nfn variant() -> i64 ! Outer {{\n    risky() catch Wrap\n}}\n\nfn function() -> i64 ! Outer {{\n    risky() catch lift\n}}\n\nfn main() {{\n    print(variant() or 0)\n    print(function() or 0)\n}}\n"
    let f = scratch(t, "mapper.low", source)
    defer drop_scratch(f)
    open(c, f, f.src)
    var edited = renamed(c, f, fixture_at(t, f, "Wrap(Inner)", 0), "Parse")
    let variant_src = edited_text(edited, f.path)
    testing.error_if(t, text.count(variant_src, "Parse") != 3, "variant mapper rename:\n{variant_src}")
    compiles(t, f.path, edited)
    edited = renamed(c, f, fixture_at(t, f, "catch lift", 6), "raise")
    let function_src = edited_text(edited, f.path)
    testing.error_if(t, text.count(function_src, "raise") != 2, "function mapper rename:\n{function_src}")
    compiles(t, f.path, edited)
}

fn test_rename_across_modules(t: *testing.T) {
    let c = start(t)
    defer stop(c)
    let f = read_fixture(t, "modules/main.low")
    open(c, f, f.src)
    let entry = path.dir(f.path)
    let function = renamed(c, f, fixture_at(t, f, "geometry.circle(2)", 9), "round")
    testing.error_if(t, function.len != 2, "function rename edited {function.len} files, want 2")
    compiles(t, entry, function)
    let variant = renamed(c, f, fixture_at(t, f, "Square(3)", 0), "Block")
    let variant_src = edited_text(variant, f.path)
    testing.error_if(t, text.contains(variant_src, "Square"), "variant rename left Square:\n{variant_src}")
    compiles(t, entry, variant)
}

fn test_rename_refusals(t: *testing.T) {
    let c = start(t)
    defer stop(c)
    let f = read_fixture(t, "modules/main.low")
    open(c, f, f.src)
    let local = fixture_at(t, f, "let c = ", 4)
    let cases = [
        RefusalCase { at: fixture_at(t, f, "print(geometry", 0), name: "show", reason: "nothing to rename" }
        RefusalCase { at: fixture_at(t, f, "geometry.circle(2)", 0), name: "geo", reason: "only names declared" }
        RefusalCase { at: local, name: "fn", reason: "is a keyword" }
        RefusalCase { at: local, name: "or", reason: "is a keyword" }
        RefusalCase { at: local, name: "2c", reason: "not a valid name" }
        RefusalCase { at: local, name: "__c", reason: "are reserved" }
        RefusalCase { at: local, name: "print", reason: "is a builtin" }
        RefusalCase { at: local, name: "str", reason: "is a builtin type" }
    ]
    for tc in cases {
        let reply = rename(c, f, tc.at, tc.name)
        match reply.failure {
            some(failure) => {
                testing.error_if(t, !text.contains(failure.message, tc.reason), "rename to {tc.name} = {failure.message}, want failure {tc.reason}")
            }
            none => {
                testing.error(t, "rename to {tc.name} succeeded, want failure {tc.reason}")
            }
        }
    }
    change(c, f, "{f.src}\nfn broken() {{ let x: i64 = \"s\" }}\n")
    let broken = rename(c, f, local, "circle")
    match broken.failure {
        some(failure) => {
            testing.error_if(t, !text.contains(failure.message, "needs the program to compile"), "rename on a broken program = {failure.message}")
        }
        none => {
            testing.error(t, "rename on a broken program succeeded")
        }
    }
}
