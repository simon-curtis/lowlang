import lsp
import std/json
import std/testing
import std/text

const into_main_title = "Move the statements into fn main"
const out_of_main_title = "Move fn main to the top level"

const script_source = "enum Problem {{\n    Negative(i64)\n}}\n\n// the input\nlet n = 12\nvar seen = 0\n\nfn checked(n: i64) -> i64 ! Problem {{\n    if n < 0 {{\n        fail Problem.Negative(n)\n    }}\n    n\n}}\n\nseen = checked(n)?\nprint(seen)\n"

const gathered_source = "enum Problem {{\n    Negative(i64)\n}}\n\nfn main() ! Problem {{\n    // the input\n    let n = 12\n    var seen = 0\n\n    seen = checked(n)?\n    print(seen)\n}}\n\nfn checked(n: i64) -> i64 ! Problem {{\n    if n < 0 {{\n        fail Problem.Negative(n)\n    }}\n    n\n}}\n"

const spread_source = "enum Problem {{\n    Negative(i64)\n}}\n\n// the input\nlet n = 12\nvar seen = 0\n\nseen = checked(n)?\nprint(seen)\n\nfn checked(n: i64) -> i64 ! Problem {{\n    if n < 0 {{\n        fail Problem.Negative(n)\n    }}\n    n\n}}\n"

fn rewritten(t: *testing.T, c: *Client, f: Fixture, src: str, needle: str, title: str) -> str {
    let actions = actions_at(t, c, f, needle)
    let action = found_action(t, actions, title)
    applied_to(src, action)
}

fn actions_at(t: *testing.T, c: *Client, f: Fixture, needle: str) -> [str: json.Value] {
    let at = fixture_at(t, f, needle, 0)
    code_actions(c, f, at)
}

fn compiles_alone(t: *testing.T, f: Fixture, src: str) {
    let edited = only(f.path, src)
    compiles(t, f.path, edited)
}

fn changed(c: *Client, f: Fixture, src: str) -> Fixture {
    let _ = change(c, f, src)
    Fixture { path: f.path, uri: f.uri, src }
}

fn expect_text(t: *testing.T, got: str, want: str) {
    testing.fatal_if(t, got != want, "rewrite produced\n{got}\nwant\n{want}")
}

fn titles(actions: [str: json.Value]) -> str {
    var names: []str = []
    for title in actions {
        names.push(title)
    }
    text.join(names, ", ")
}

fn expect_no_rewrite(t: *testing.T, actions: [str: json.Value]) {
    let offered = has(actions, into_main_title) || has(actions, out_of_main_title)
    testing.error_if(t, offered, "unexpected rewrite among {titles(actions)}")
}

fn test_statements_move_into_main(t: *testing.T) {
    let c = start(t)
    defer stop(c)
    let f = scratch(t, "main.low", script_source)
    defer drop_scratch(f)
    let _ = open(c, f, f.src)
    let got = rewritten(t, c, f, f.src, "var seen", into_main_title)
    expect_text(t, got, gathered_source)
    compiles_alone(t, f, got)
}

fn test_main_moves_to_top_level(t: *testing.T) {
    let c = start(t)
    defer stop(c)
    let f = scratch(t, "main.low", gathered_source)
    defer drop_scratch(f)
    let _ = open(c, f, f.src)
    let got = rewritten(t, c, f, f.src, "fn main", out_of_main_title)
    expect_text(t, got, spread_source)
    compiles_alone(t, f, got)
}

fn test_rewrites_round_trip_from_one_line(t: *testing.T) {
    let c = start(t)
    defer stop(c)
    let f = scratch(t, "main.low", gathered_source)
    defer drop_scratch(f)
    let _ = open(c, f, f.src)
    let spread = rewritten(t, c, f, f.src, "fn main", out_of_main_title)
    let edited = changed(c, f, spread)
    let back = actions_at(t, c, edited, "let n")
    let action = found_action(t, back, into_main_title)
    let gathered = applied_to(spread, action)
    expect_text(t, gathered, gathered_source)
}

fn test_rewrites_keep_the_run_fixture_compiling(t: *testing.T) {
    let c = start(t)
    defer stop(c)
    let f = read_fixture(t, "top_level.low")
    let _ = open(c, f, f.src)
    let gathered = rewritten(t, c, f, f.src, "let name", into_main_title)
    compiles_alone(t, f, gathered)
    let edited = changed(c, f, gathered)
    let spread = rewritten(t, c, edited, gathered, "fn main()", out_of_main_title)
    compiles_alone(t, f, spread)
    let again = changed(c, f, spread)
    let regathered = rewritten(t, c, again, spread, "let name", into_main_title)
    expect_text(t, regathered, gathered)
}

fn test_main_doc_comment_and_bare_fail(t: *testing.T) {
    let c = start(t)
    defer stop(c)
    let source = "enum Problem {{\n    Bad\n}}\n\n/// Fails at once.\nfn main() ! Problem {{ fail Bad }}\n"
    let f = scratch(t, "main.low", source)
    defer drop_scratch(f)
    let _ = open(c, f, f.src)
    let got = rewritten(t, c, f, f.src, "fn main", out_of_main_title)
    expect_text(t, got, "enum Problem {{\n    Bad\n}}\n\n// Fails at once.\nfail Problem.Bad\n")
    compiles_alone(t, f, got)
}

fn test_statements_import_the_error_module(t: *testing.T) {
    let c = start(t)
    defer stop(c)
    let f = scratch(t, "main.low", "import std/file\n\nprint(file.read_text(\"data.txt\")?)\n")
    defer drop_scratch(f)
    let _ = open(c, f, f.src)
    let got = rewritten(t, c, f, f.src, "file.read_text", into_main_title)
    expect_text(t, got, "import std/file\nimport std/io\n\nfn main() ! io.Error {{\n    print(file.read_text(\"data.txt\")?)\n}}\n")
    compiles_alone(t, f, got)
}

fn test_rewrites_not_offered(t: *testing.T) {
    let c = start(t)
    defer stop(c)
    let f = scratch(t, "main.low", script_source)
    defer drop_scratch(f)
    let _ = open(c, f, f.src)
    let on_declaration = actions_at(t, c, f, "fn checked")
    expect_no_rewrite(t, on_declaration)
    let in_function = actions_at(t, c, f, "fail Problem")
    expect_no_rewrite(t, in_function)
    let sources = [
        "fn main() {{}}\n"
        "fn main() {{\n    main()\n}}\n"
        "fn main() {{\n    print(1)\n}}\n"
    ]
    for i, source in sources {
        let edited = changed(c, f, source)
        let needle = if i == 2 { "print" } else { "fn main" }
        let offered = actions_at(t, c, edited, needle)
        expect_no_rewrite(t, offered)
    }
}

fn test_unchecked_error_type_is_not_guessed(t: *testing.T) {
    let c = start(t)
    defer stop(c)
    let source = "enum Problem {{\n    Bad\n}}\n\nfn parse() -> i64 ! Problem {{\n    1\n}}\n\nprint(parse()?)\nprint(missing)\n"
    let f = scratch(t, "main.low", source)
    defer drop_scratch(f)
    let _ = open(c, f, f.src)
    let offered = actions_at(t, c, f, "print(parse")
    expect_no_rewrite(t, offered)
    let edited = changed(c, f, "print(1)\nprint(missing)\n")
    let plain = actions_at(t, c, edited, "print(1)")
    testing.error_if(t, !has(plain, into_main_title), "no {into_main_title} for statements that cannot fail, got {titles(plain)}")
}

fn test_final_value_stays_the_tail_of_main(t: *testing.T) {
    let c = start(t)
    defer stop(c)
    let source = "import std/file\nimport std/io\n\nfn main() ! io.Error {{\n    print(io.buffer(4).len)\n    file.open(\"data.txt\")?\n}}\n"
    let f = scratch(t, "main.low", source)
    defer drop_scratch(f)
    let _ = open(c, f, f.src)
    let spread = rewritten(t, c, f, f.src, "fn main", out_of_main_title)
    expect_text(t, spread, "import std/file\nimport std/io\n\nprint(io.buffer(4).len)\nfile.open(\"data.txt\")?\n")
    compiles_alone(t, f, spread)
    let edited = changed(c, f, spread)
    let back = rewritten(t, c, edited, spread, "file.open", into_main_title)
    expect_text(t, back, source)
}

fn test_main_qualifies_a_bare_catch_mapper(t: *testing.T) {
    let c = start(t)
    defer stop(c)
    let declarations = "enum Inner {{\n    Bad\n}}\n\nenum Outer {{\n    Wrapped(Inner)\n}}\n\nfn inner() -> i64 ! Inner {{\n    1\n}}\n\n"
    let f = scratch(t, "main.low", "{declarations}fn main() ! Outer {{\n    print(inner() catch Wrapped)\n}}\n")
    defer drop_scratch(f)
    let _ = open(c, f, f.src)
    let got = rewritten(t, c, f, f.src, "fn main", out_of_main_title)
    expect_text(t, got, "{declarations}print(inner() catch Outer.Wrapped)\n")
    compiles_alone(t, f, got)
}

fn execute(c: *Client, command: str, f: Fixture) -> Reply {
    let uri = lsp.quote_json(f.uri)
    let name = lsp.quote_json(command)
    call(c, "workspace/executeCommand", "{{\"command\":{name},\"arguments\":[{uri}]}}")
}

fn expect_declined(t: *testing.T, c: *Client, f: Fixture) {
    let reply = execute(c, "low.toggleMain", f)
    match reply.failure {
        some(failure) => {
            let want = "neither {into_main_title} nor {out_of_main_title} applies to"
            testing.error_if(t, !text.starts_with(failure.message, want), "low.toggleMain failed with {failure.message}")
        }
        none => testing.error(t, "low.toggleMain succeeded on\n{f.src}")
    }
}

fn test_toggle_command_applies_the_rewrite(t: *testing.T) {
    let c = start(t)
    defer stop(c)
    let f = scratch(t, "main.low", gathered_source)
    defer drop_scratch(f)
    let _ = open(c, f, f.src)
    let reply = execute(c, "low.toggleMain", f)
    testing.fatal_if(t, reply.failure != none, "low.toggleMain failed")
    let asked = c.asked_with["workspace/applyEdit"] ?? json.Value.Null
    let spread = applied_to(f.src, asked)
    expect_text(t, spread, spread_source)
    let edited = changed(c, f, spread_source)
    let again = execute(c, "low.toggleMain", edited)
    testing.fatal_if(t, again.failure != none, "low.toggleMain failed on the spread program")
    let back = c.asked_with["workspace/applyEdit"] ?? json.Value.Null
    let gathered = applied_to(spread_source, back)
    expect_text(t, gathered, gathered_source)
    let declined = ["enum Empty {{\n    None\n}}\n", "fn main(n: i64) {{\n    print(n)\n}}\n"]
    for source in declined {
        let edited_again = changed(c, f, source)
        expect_declined(t, c, edited_again)
    }
    let unknown = execute(c, "low.unknown", f)
    testing.error_if(t, unknown.failure == none, "low.unknown succeeded")
}
