import lsp
import std/json
import std/path
import std/testing
import std/text

const constants_source = "/// Bytes in a kilobyte.\npub const kib = 1 << 10\nconst mib = kib * kib\nconst name: str = \"low\"\n\nfn size(n: i64) -> i64 {{\n    n * mib\n}}\n\nfn pick(code: i64) -> str {{\n    match code {{\n        kib => \"kib\"\n        _ => name\n    }}\n}}\n\nfn main() {{\n    let kib = 2\n    print(size(kib))\n    print(pick(1024))\n}}\n"

fn test_constant_hover(t: *testing.T) {
    let c = start(t)
    defer stop(c)
    let f = scratch(t, "constants.low", constants_source)
    defer drop_scratch(f)
    let opened = open(c, f, f.src)
    testing.fatal_if(t, opened.len != 0, "diagnostics = {opened.len}")
    let cases = [
        HoverCase { at: fixture_at(t, f, "n * mib", 4), want: "const mib: i64 = kib * kib" }
        HoverCase { at: fixture_at(t, f, "const mib", 6), want: "const mib: i64 = kib * kib" }
        HoverCase { at: fixture_at(t, f, "_ => name", 5), want: "const name: str = \"low\"" }
        HoverCase { at: fixture_at(t, f, "kib => ", 0), want: "const kib: i64 = 1 << 10\n```\n\nBytes in a kilobyte." }
        HoverCase { at: fixture_at(t, f, "const mib", 12), want: "Bytes in a kilobyte." }
        HoverCase { at: fixture_at(t, f, "print(size(kib))", 11), want: "let kib: i64" }
    ]
    check_hovers(t, c, f, cases)
    let hidden = hover(c, f, fixture_at(t, f, "print(size(kib))", 11))
    testing.error_if(t, text.contains(hidden, "const"), "hover on the local that hides a constant = {hidden}")
}

fn test_constant_definition(t: *testing.T) {
    let c = start(t)
    defer stop(c)
    let f = scratch(t, "constants.low", constants_source)
    defer drop_scratch(f)
    open(c, f, f.src)
    let cases = [
        DefinitionCase { at: fixture_at(t, f, "n * mib", 4), want: fixture_at(t, f, "const mib", 6) }
        DefinitionCase { at: fixture_at(t, f, "const mib", 6), want: fixture_at(t, f, "const mib", 6) }
        DefinitionCase { at: fixture_at(t, f, "kib => ", 0), want: fixture_at(t, f, "pub const kib", 10) }
        DefinitionCase { at: fixture_at(t, f, "const mib = kib", 12), want: fixture_at(t, f, "pub const kib", 10) }
        DefinitionCase { at: fixture_at(t, f, "print(size(kib))", 11), want: fixture_at(t, f, "let kib", 4) }
    ]
    check_definitions(t, c, f, cases)
}

fn test_constant_references(t: *testing.T) {
    let c = start(t)
    defer stop(c)
    let f = scratch(t, "constants.low", constants_source)
    defer drop_scratch(f)
    open(c, f, f.src)
    let at = fixture_at(t, f, "pub const kib", 10)
    let with = references(c, f, at, true)
    testing.error_if(t, with.len != 4, "references with declaration = {with.len}, want 4")
    let without = references(c, f, fixture_at(t, f, "kib => ", 0), false)
    testing.error_if(t, without.len != 3, "references without declaration = {without.len}, want 3")
    for loc in without {
        testing.error_if(t, same_position(start_of(loc), at), "declaration included in {without.len} references")
    }
}

fn test_rename_constant(t: *testing.T) {
    let c = start(t)
    defer stop(c)
    let f = scratch(t, "constants.low", constants_source)
    defer drop_scratch(f)
    open(c, f, f.src)
    let edited = renamed(c, f, fixture_at(t, f, "const mib = kib", 12), "kilo")
    let got = edited_text(edited, f.path)
    for want in ["pub const kilo = 1 << 10", "const mib = kilo * kilo", "kilo => \"kib\"", "let kib = 2", "print(size(kib))"] {
        testing.error_if(t, !text.contains(got, want), "rename lacks {want}:\n{got}")
    }
    compiles(t, f.path, edited)
    let local = renamed(c, f, fixture_at(t, f, "let kib", 4), "two")
    let local_src = edited_text(local, f.path)
    let ok = text.contains(local_src, "let two = 2") && text.contains(local_src, "print(size(two))") && text.contains(local_src, "kib => \"kib\"")
    testing.error_if(t, !ok, "renaming the local touched the constant:\n{local_src}")
}

fn test_constants_across_modules(t: *testing.T) {
    let c = start(t)
    defer stop(c)
    let f = read_fixture(t, "consts/main.low")
    let opened = open(c, f, f.src)
    testing.fatal_if(t, opened.len != 0, "diagnostics = {opened.len}")
    let unbounded = fixture_at(t, f, "width < limits.unbounded", 15)
    let shown = hover(c, f, unbounded)
    for want in ["const unbounded: f32 = 1.0 / 0.0", "The width that stands for no limit."] {
        testing.error_if(t, !text.contains(shown, want), "hover = {shown}, want {want}")
    }
    let loc = definition(c, f, unbounded)
    let at = start_of(loc)
    let ok = path.base(path_of_location(loc)) == "limits.low" && at.line == 1 && at.character == 10
    testing.error_if(t, !ok, "definition = {json.text_of(loc, "uri")} {position_text(at)}")
    let found = references(c, f, unbounded, true)
    testing.error_if(t, found.len != 3, "references to unbounded = {found.len}, want 3")
    let edited = renamed(c, f, fixture_at(t, f, "print(limits.mib)", 13), "megabyte")
    testing.error_if(t, edited.len != 2, "rename edited {edited.len} files, want 2")
    let got = edited_text(edited, f.path)
    testing.error_if(t, !text.contains(got, "print(limits.megabyte)"), "rename left the use:\n{got}")
    compiles(t, path.dir(f.path), edited)
}

fn test_constant_symbols(t: *testing.T) {
    let c = start(t)
    defer stop(c)
    let f = scratch(t, "constants.low", constants_source)
    defer drop_scratch(f)
    open(c, f, f.src)
    var names: [str: json.Value] = [:]
    for s in symbols(c, f) {
        names[json.text_of(s, "name")] = s
    }
    let expected: [str: str] = [
        "kib": "const kib = 1 << 10"
        "mib": "const mib = kib * kib"
        "name": "const name: str = \"low\""
    ]
    for name in expected {
        let detail = expected[name] ?? ""
        if !has(names, name) {
            testing.error(t, "missing symbol {name}")
            continue
        }
        let s = names[name] ?? json.Value.Null
        let kind = json.int_of(s, "kind")
        let got = json.text_of(s, "detail")
        testing.error_if(t, kind != lsp.symbol_constant || got != detail, "{name} = kind {kind} detail {got}, want kind {lsp.symbol_constant} detail {detail}")
    }
    let found = workspace_symbols(c, "ib")
    var kinds: [str: i64] = [:]
    for s in found {
        kinds[json.text_of(s, "name")] = json.int_of(s, "kind")
    }
    let kib_kind = kinds["kib"] ?? 0
    let mib_kind = kinds["mib"] ?? 0
    let ok = kib_kind == lsp.symbol_constant && mib_kind == lsp.symbol_constant && kinds.len == 2
    testing.error_if(t, !ok, "workspace symbols = {found.len}")
}

fn test_constant_completion(t: *testing.T) {
    let c = start(t)
    defer stop(c)
    let f = scratch(t, "constants.low", constants_source)
    defer drop_scratch(f)
    open(c, f, f.src)
    let found = complete_typing(c, f, "let kib = 2", "    ")
    expect(t, found, ["kib", "mib", "name", "size"], [])
    let mib = found["mib"] ?? json.Value.Null
    let mib_ok = json.int_of(mib, "kind") == lsp.completion_constant && json.text_of(mib, "detail") == "const mib: i64 = kib * kib"
    testing.error_if(t, !mib_ok, "mib = {json.stringify(mib, 0)}")
    let g = read_fixture(t, "consts/main.low")
    open(c, g, g.src)
    let members = complete_typing(c, g, "fn main() {{", "    limits.")
    expect(t, members, ["unbounded", "kib", "mib", "greeting"], ["name", "main"])
    let unbounded = members["unbounded"] ?? json.Value.Null
    let ok = json.int_of(unbounded, "kind") == lsp.completion_constant && json.text_of(unbounded, "detail") == "const unbounded: f32 = 1.0 / 0.0"
    testing.error_if(t, !ok, "unbounded = {json.stringify(unbounded, 0)}")
}
