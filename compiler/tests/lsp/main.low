import std/os
import std/testing

const slow_timeout = 600000

fn main() {
    let tests = [
        testing.Test { name: "DiagnosticsFollowOverlay", run: test_diagnostics_follow_overlay }
        testing.Test { name: "CloseReleasesTheEntry", run: test_close_releases_the_entry }
        testing.Test { name: "CloseKeepsAnEntryWithOpenDocuments", run: test_close_keeps_an_entry_with_open_documents }
        testing.Test { name: "RapidEditsPublishOnlyTheLatest", run: test_rapid_edits_publish_only_the_latest }
        testing.Test { name: "HoverDoesNotWaitForPendingCompile", run: test_hover_does_not_wait_for_pending_compile }
        testing.Test { name: "Hover", run: test_hover }
        testing.Test { name: "HoverShowsDocComments", run: test_hover_shows_doc_comments }
        testing.Test { name: "HoverOnBuiltins", run: test_hover_on_builtins }
        testing.Test { name: "Definition", run: test_definition }
        testing.Test { name: "DefinitionAcrossModules", run: test_definition_across_modules }
        testing.Test { name: "DocumentSymbols", run: test_document_symbols }
        testing.Test { name: "Shutdown", run: test_shutdown }
        testing.Test { name: "EveryOccurrenceAnswers", run: test_every_occurrence_answers }
        testing.Test { name: "LiftImportsTheErrorModule", run: test_lift_imports_the_error_module }
        testing.Test { name: "CatchWrapsTheTry", run: test_catch_wraps_the_try }
        testing.Test { name: "OrReplacesTheTry", run: test_or_replaces_the_try }
        testing.Test { name: "OrPlacesTheCursorAfterOr", run: test_or_places_the_cursor_after_or }
        testing.Test { name: "CatchPlacesTheCursorInTheArm", run: test_catch_places_the_cursor_in_the_arm }
        testing.Test { name: "LiftAfterResultType", run: test_lift_after_result_type }
        testing.Test { name: "LiftNeedsAnUndeclaredErrorType", run: test_lift_needs_an_undeclared_error_type }
        testing.Test { name: "NoLiftIntoAnExpressionClosure", run: test_no_lift_into_an_expression_closure }
        testing.Test { name: "NoActionsAwayFromTry", run: test_no_actions_away_from_try }
        testing.Test { name: "CompletionModuleMembers", run: test_completion_module_members }
        testing.Test { name: "CompletionGeneratedRegex", run: test_completion_generated_regex }
        testing.Test { name: "CompletionFields", run: test_completion_fields }
        testing.Test { name: "CompletionAfterCallsAndIndexing", run: test_completion_after_calls_and_indexing }
        testing.Test { name: "CompletionAfterModuleCall", run: test_completion_after_module_call }
        testing.Test { name: "CompiledLine", run: test_compiled_line }
        testing.Test { name: "CompletionScope", run: test_completion_scope }
        testing.Test { name: "CompletionImportsAndHelpers", run: test_completion_imports_and_helpers }
        testing.Test { name: "CompletionWithoutCompile", run: test_completion_without_compile }
        testing.Test { name: "ConstantHover", run: test_constant_hover }
        testing.Test { name: "ConstantDefinition", run: test_constant_definition }
        testing.Test { name: "ConstantReferences", run: test_constant_references }
        testing.Test { name: "RenameConstant", run: test_rename_constant }
        testing.Test { name: "ConstantsAcrossModules", run: test_constants_across_modules }
        testing.Test { name: "ConstantSymbols", run: test_constant_symbols }
        testing.Test { name: "ConstantCompletion", run: test_constant_completion }
        testing.Test { name: "DestructureHoverAndDefinition", run: test_destructure_hover_and_definition }
        testing.Test { name: "DestructureReferences", run: test_destructure_references }
        testing.Test { name: "RenameLocalInShorthandPattern", run: test_rename_local_in_shorthand_pattern }
        testing.Test { name: "RenameFieldInShorthandPattern", run: test_rename_field_in_shorthand_pattern }
        testing.Test { name: "RenameBoundNameInPattern", run: test_rename_bound_name_in_pattern }
        testing.Test { name: "DiagnosticsCarryTypedPositions", run: test_diagnostics_carry_typed_positions }
        testing.Test { name: "MalformedNotificationIsLogged", run: test_malformed_notification_is_logged }
        testing.Test { name: "MalformedRequestFails", run: test_malformed_request_fails }
        testing.Test { name: "NameError", run: test_name_error }
        testing.Test { name: "HeaderName", run: test_header_name }
        testing.Test { name: "InlayHints", run: test_inlay_hints }
        testing.Test { name: "InlayHintRefresh", run: test_inlay_hint_refresh }
        testing.Test { name: "InlayHintsSkipWrittenTypes", run: test_inlay_hints_skip_written_types }
        testing.Test { name: "WorkspaceSymbols", run: test_workspace_symbols }
        testing.Test { name: "MethodCompletion", run: test_method_completion }
        testing.Test { name: "MethodSignatureAndNavigation", run: test_method_signature_and_navigation }
        testing.Test { name: "ImportedMethods", run: test_imported_methods }
        testing.Test { name: "ConstrainedMethodCompletion", run: test_constrained_method_completion }
        testing.Test { name: "MethodCompletionOffersLocalsAcceptingTheReceiver", run: test_method_completion_offers_locals_accepting_the_receiver }
        testing.Test { name: "MethodsFromImportedModules", run: test_methods_from_imported_modules }
        testing.Test { name: "References", run: test_references }
        testing.Test { name: "RenameLocalLeavesOtherFunctions", run: test_rename_local_leaves_other_functions }
        testing.Test { name: "RenameFieldExpandsShorthand", run: test_rename_field_expands_shorthand }
        testing.Test { name: "RenameFieldSkipsTrailingBlock", run: test_rename_field_skips_trailing_block }
        testing.Test { name: "InterpolationWithWidthAndFormat", run: test_interpolation_with_width_and_format }
        testing.Test { name: "RenameBindingArm", run: test_rename_binding_arm }
        testing.Test { name: "RenameCatchMapper", run: test_rename_catch_mapper }
        testing.Test { name: "RenameAcrossModules", run: test_rename_across_modules }
        testing.Test { name: "RenameRefusals", run: test_rename_refusals }
        testing.Test { name: "HoverOnUsingBindings", run: test_hover_on_using_bindings }
        testing.Test { name: "DropBodiesAndTestArmsAreIndexed", run: test_drop_bodies_and_test_arms_are_indexed }
        testing.Test { name: "SignatureHelp", run: test_signature_help }
        testing.Test { name: "SignatureHelpAcrossModules", run: test_signature_help_across_modules }
        testing.Test { name: "URIRoundTrip", run: test_uri_round_trip }
        testing.Test { name: "NamesDescribeEveryOccurrence", run: test_names_describe_every_occurrence }
        testing.Test { name: "NamesGroupReferences", run: test_names_group_references }
        testing.Test { name: "NamesFailOnACompileError", run: test_names_fail_on_a_compile_error }
    ]
    let args = os.args()
    var settings = testing.settings_from(args[1..]) catch {
        e => {
            print("flags: {e}")
            os.exit(2)
            testing.Settings {}
        }
    }
    let defaults = testing.Settings {}
    if settings.timeout_ms == defaults.timeout_ms {
        settings.timeout_ms = slow_timeout
    }
    let failed = testing.run_with(tests, settings)
    if failed > 0 {
        os.exit(1)
    }
}
