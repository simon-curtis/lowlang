import compiler
import lsp
import native
import std/file
import std/json
import std/slices
import std/testing
import std/text
import target

fn edit_before(a: json.Value, b: json.Value) -> bool {
    let from = start_of(a)
    let to = start_of(b)
    if from.line != to.line {
        return from.line > to.line
    }
    from.character > to.character
}

fn apply_text(src: str, edits: []json.Value) -> str {
    let t = lsp.new_text(src)
    var sorted = edits
    slices.sort_by(mut sorted, edit_before)
    var lines = t.lines
    for e in sorted {
        let from = start_of(e)
        let to = end_of(e)
        let line = from.line
        let first = lsp.byte_col(t, line, from.character)
        let last = lsp.byte_col(t, line, to.character)
        let replacement = json.text_of(e, "newText")
        lines[line] = "{lines[line][..first]}{replacement}{lines[line][last..]}"
    }
    text.join(lines, "\n")
}

fn apply_edit(t: *testing.T, edit: json.Value) -> [str: str] {
    var out: [str: str] = [:]
    match json.field(edit, "changes") {
        Object(members) => {
            for m in members {
                let file_path = lsp.path_of(m.name)
                let src = file.read_text(file_path) catch {
                    e => testing.must(t, e, "")
                }
                out[file_path] = apply_text(src, items(m.value))
            }
        }
        _ => {}
    }
    out
}

fn applied(t: *testing.T, f: Fixture, action: json.Value) -> str {
    let edited = apply_edit(t, json.field(action, "edit"))
    edited[f.path] ?? ""
}

fn renamed(c: *Client, f: Fixture, p: lsp.Position, name: str) -> [str: str] {
    let reply = rename(c, f, p, name)
    match reply.failure {
        some(failure) => testing.fatal(c.t, "rename to {name} failed: {failure.message}")
        none => {}
    }
    apply_edit(c.t, reply.result)
}

fn compiles(t: *testing.T, entry: str, edited: [str: str]) {
    let docs = native.overlay()
    for name in edited {
        compiler.overlay_put(docs, name, edited[name] ?? "")
    }
    let std = compiler.new_std()
    let checked = compiler.check_overlay(entry, target.host(), std, docs)
    match checked.error {
        some(e) => testing.error(t, "renamed program does not compile: {compiler.message(e)}")
        none => {}
    }
}

fn edited_text(edited: [str: str], name: str) -> str {
    edited[name] ?? ""
}

fn only(file_path: str, contents: str) -> [str: str] {
    let held: [str: str] = [file_path: contents]
    held
}
