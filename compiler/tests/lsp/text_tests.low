import lsp
import std/testing

fn test_uri_round_trip(t: *testing.T) {
    let uri = lsp.uri_of("/home/a b/main.low")
    testing.error_if(t, uri != "file:///home/a%20b/main.low", "uri_of(/home/a b/main.low) = {uri}, want file:///home/a%20b/main.low")
    let file_path = lsp.path_of("file:///home/a%20b/main.low")
    testing.error_if(t, file_path != "/home/a b/main.low", "path_of(file:///home/a%20b/main.low) = {file_path}, want /home/a b/main.low")
}
