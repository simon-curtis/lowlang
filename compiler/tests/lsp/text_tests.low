import compiler
import lsp
import native
import target
import std/testing

fn test_uri_round_trip(t: *testing.T) {
    let uri = lsp.uri_of("/home/a b/main.low")
    testing.error_if(t, uri != "file:///home/a%20b/main.low", "uri_of(/home/a b/main.low) = {uri}, want file:///home/a%20b/main.low")
    let file_path = lsp.path_of("file:///home/a%20b/main.low")
    testing.error_if(t, file_path != "/home/a b/main.low", "path_of(file:///home/a%20b/main.low) = {file_path}, want /home/a b/main.low")
}

struct UriCase {
    path: str
    uri: str
}

fn windows_uri_cases() -> []UriCase {
    [
        UriCase { path: "D:\\a b\\main.low", uri: "file:///D:/a%20b/main.low" }
        UriCase { path: "d:\\a\\main.low", uri: "file:///D:/a/main.low" }
        UriCase { path: "D:/a/main.low", uri: "file:///D:/a/main.low" }
        UriCase { path: "D:\\Users\\x\\lowlang/testdata/run/enums.low", uri: "file:///D:/Users/x/lowlang/testdata/run/enums.low" }
        UriCase { path: "\\\\host\\share\\a b.low", uri: "file://host/share/a%20b.low" }
        UriCase { path: "//host/share/a.low", uri: "file://host/share/a.low" }
        UriCase { path: "/rooted/a.low", uri: "file:///rooted/a.low" }
    ]
}

fn test_windows_uri_of(t: *testing.T) {
    for c in windows_uri_cases() {
        let got = lsp.uri_for(c.path, target.OS.Windows)
        testing.error_if(t, got != c.uri, "uri_for({c.path}) = {got}, want {c.uri}")
    }
}

struct PathCase {
    uri: str
    path: str
}

fn windows_path_cases() -> []PathCase {
    [
        PathCase { uri: "file:///D:/a%20b/main.low", path: "D:/a b/main.low" }
        PathCase { uri: "file:///d%3A/a%20b/main.low", path: "D:/a b/main.low" }
        PathCase { uri: "file:///d%3a/a/main.low", path: "D:/a/main.low" }
        PathCase { uri: "file:///d:/a/../b/main.low", path: "D:/b/main.low" }
        PathCase { uri: "file://localhost/D:/a/main.low", path: "D:/a/main.low" }
        PathCase { uri: "file://host/share/a%20b.low", path: "//host/share/a b.low" }
        PathCase { uri: "file:///rooted/a.low", path: "/rooted/a.low" }
    ]
}

fn test_windows_path_of(t: *testing.T) {
    for c in windows_path_cases() {
        let got = lsp.path_for(c.uri, target.OS.Windows)
        testing.error_if(t, got != c.path, "path_for({c.uri}) = {got}, want {c.path}")
    }
}

fn test_windows_spellings_name_one_file(t: *testing.T) {
    let spellings = [
        lsp.path_for("file:///D:/x/y.low", target.OS.Windows)
        lsp.path_for("file:///d%3A/x/y.low", target.OS.Windows)
        lsp.path_for(lsp.uri_for("D:\\x\\y.low", target.OS.Windows), target.OS.Windows)
        lsp.path_for(lsp.uri_for("d:/x/y.low", target.OS.Windows), target.OS.Windows)
    ]
    for s in spellings {
        testing.error_if(t, s != "D:/x/y.low", "spelling gave {s}, want D:/x/y.low")
    }
    let canonical = lsp.uri_for("d:\\x\\y.low", target.OS.Windows)
    let again = lsp.uri_for(lsp.path_for(canonical, target.OS.Windows), target.OS.Windows)
    testing.error_if(t, again != canonical, "uri round trip gave {again}, want {canonical}")
}

fn test_other_hosts_keep_drive_like_names(t: *testing.T) {
    let uri = lsp.uri_for("/tmp/D:/a b.low", target.OS.Linux)
    testing.error_if(t, uri != "file:///tmp/D:/a%20b.low", "uri_for on Linux = {uri}")
    let file_path = lsp.path_for("file:///D:/a.low", target.OS.Linux)
    testing.error_if(t, file_path != "/D:/a.low", "path_for on Linux = {file_path}")
    let backslashes = lsp.uri_for("/a\\b.low", target.OS.Linux)
    testing.error_if(t, backslashes != "file:///a%5Cb.low", "uri_for keeps a backslash on Linux: {backslashes}")
}

fn test_overlay_matches_drive_spellings(t: *testing.T) {
    var disk = native.disk()
    disk.drives = true
    let docs = compiler.new_overlay(disk)
    compiler.overlay_put(docs, "d:\\x\\y.low", "held")
    for name in ["D:/x/y.low", "d:/x/y.low", "D:\\x\\y.low", "D:/x/../x/y.low"] {
        let got = compiler.overlay_read(docs, name) or "missing"
        testing.error_if(t, got != "held", "overlay_read({name}) = {got}")
    }
    compiler.overlay_drop(docs, "D:/x/y.low")
    let dropped = compiler.overlay_read(docs, "d:\\x\\y.low") or "missing"
    testing.error_if(t, dropped != "missing", "overlay_read after drop = {dropped}")
}
