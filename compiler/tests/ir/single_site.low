import compiler
import native
import target
import std/testing

const single_site_program = "testdata/run/single_site_inline.low"

fn test_callee_with_one_reference_is_inlined_past_the_size_limit(t: *testing.T) {
    let profile = compiler.release(target.OS.Linux)
    let unit = native.analyse(single_site_program, profile) catch {
        e => {
            t.fatal(native.message(e))
            return
        }
    }
    let program = unit.program ?? panic("{single_site_program} analysed without a program")
    let names: [str: bool] = [:]
    for f in program.funcs {
        names[f.name] = true
    }
    if names["once"] ?? false {
        t.error("once has one call site but keeps its own function")
    }
    if !(names["stir"] ?? false) {
        t.error("stir has two call sites and is over the size limit, but was inlined")
    }
}
