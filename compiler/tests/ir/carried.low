import compiler
import ir
import native
import target
import std/testing

const carried_program = "testdata/run/carried_fields.low"

fn loop_load_counts() -> []LoadCount {
    [
        LoadCount { func: "skip_spaces", want: 1 }
        LoadCount { func: "count_below", want: 0 }
        LoadCount { func: "twin", want: 1 }
        LoadCount { func: "with_call", want: 1 }
    ]
}

fn loads_in_loops(f: *ir.Func) -> i64 {
    var inside: [i64: bool] = [:]
    let doms = ir.func_dominators(f)
    for l in ir.find_loops(doms) {
        for b in l.order {
            inside[b.id] = true
        }
    }
    var loads = 0
    for b in f.blocks {
        if !(inside[b.id] ?? false) {
            continue
        }
        for v in b.values {
            if v.op == ir.Op.OpLoad {
                loads += 1
            }
        }
    }
    loads
}

fn test_loops_carry_fields_written_through_one_pointer(t: *testing.T) {
    let profile = compiler.release(target.OS.Linux)
    let unit = native.analyse(carried_program, profile) catch {
        e => {
            t.fatal(native.message(e))
            return
        }
    }
    let program = unit.program ?? panic("{carried_program} analysed without a program")
    for c in loop_load_counts() {
        var found = false
        for f in program.funcs {
            if f.name != c.func {
                continue
            }
            found = true
            let loads = loads_in_loops(f)
            if loads != c.want {
                t.error("{c.func} keeps {loads} loads inside loops, want {c.want}")
            }
        }
        if !found {
            t.error("{carried_program} has no function {c.func}")
        }
    }
}
