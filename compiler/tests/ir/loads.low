import compiler
import ir
import native
import target
import std/testing

const loads_program = "testdata/run/forwarded_loads.low"

struct LoadCount {
    func: str
    want: i64
}

fn load_counts() -> []LoadCount {
    [
        LoadCount { func: "repeated", want: 2 }
        LoadCount { func: "stored", want: 0 }
        LoadCount { func: "aliased", want: 2 }
        LoadCount { func: "across_call", want: 2 }
    ]
}

fn loads_in(f: *ir.Func) -> i64 {
    var loads = 0
    for b in f.blocks {
        for v in b.values {
            if v.op == ir.Op.OpLoad {
                loads += 1
            }
        }
    }
    loads
}

fn test_loads_reuse_dominating_memory_of_the_same_version(t: *testing.T) {
    let profile = compiler.release(target.OS.Linux)
    let unit = native.analyse(loads_program, profile) catch {
        e => {
            t.fatal(native.message(e))
            return
        }
    }
    let program = unit.program ?? panic("{loads_program} analysed without a program")
    for c in load_counts() {
        var found = false
        for f in program.funcs {
            if f.name != c.func {
                continue
            }
            found = true
            let loads = loads_in(f)
            if loads != c.want {
                t.error("{c.func} keeps {loads} loads, want {c.want}")
            }
        }
        if !found {
            t.error("{loads_program} has no function {c.func}")
        }
    }
}
