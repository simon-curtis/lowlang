import compiler
import ir
import native
import target
import std/file
import std/io
import std/os
import std/slices
import std/sync
import std/testing
import std/text

const compiler_entry = "compiler/low"
const bench_pattern = "bench/*/main.low"
const run_directory = "testdata/run"
const source_ext = ".low"

struct Subject {
    name: str
    path: str
}

struct Verdict {
    name: str
    problem: str
}

fn subjects() -> []Subject ! io.Error {
    var out: []Subject = [Subject { name: "compiler", path: compiler_entry }]
    for path in file.glob(bench_pattern) {
        let parts = text.split(path, '/')
        push(mut out, Subject { name: "bench/{parts[parts.len - 2]}", path })
    }
    var names = file.list(run_directory)?
    slices.sort(mut names)
    for name in names {
        let path = file.child_path(run_directory, name)
        if file.is_dir(path) || text.ends_with(name, source_ext) {
            push(mut out, Subject { name: "run/{text.trim_suffix(name, source_ext)}", path })
        }
    }
    out
}

fn irreducible_in(program: *ir.Program) -> []str {
    var names: []str = []
    for f in program.funcs {
        if !ir.is_reducible(ir.func_dominators(f)) {
            push(mut names, f.name)
        }
    }
    names
}

fn judge(s: Subject) -> str {
    let profile = compiler.release(target.OS.Linux)
    let unit = native.analyse(s.path, profile) catch {
        e => return native.message(e)
    }
    let program = unit.program ?? panic("{s.path} analysed without a program")
    let names = irreducible_in(program)
    if names.len == 0 {
        return ""
    }
    "irreducible control flow in {text.join(names, ", ")}"
}

fn judge_parallel(subjects: []Subject, index: i64, verdicts: []Verdict, permits: sync.Semaphore, group: sync.WaitGroup) {
    sync.acquire(permits)
    let s = subjects[index]
    verdicts[index] = Verdict { name: s.name, problem: judge(s) }
    sync.release(permits)
    sync.done(group)
}

fn judge_all(subjects: []Subject) -> []Verdict {
    var verdicts: []Verdict = []
    for s in subjects {
        push(mut verdicts, Verdict { name: s.name, problem: "" })
    }
    let group = sync.wait_group()
    let permits = sync.semaphore(os.cpu_count())
    for i in 0..subjects.len {
        sync.add(group, 1)
        spawn judge_parallel(subjects, i, verdicts, permits, group)
    }
    sync.wait(group)
    verdicts
}

fn verdict_name(v: Verdict) -> str {
    v.name
}

fn verdict_body(t: *testing.T, v: Verdict) {
    if v.problem != "" {
        t.error(v.problem)
    }
}

fn test_optimised_control_flow_is_reducible(t: *testing.T) {
    let found = subjects() catch {
        e => {
            t.fatal("{e}")
            return
        }
    }
    let verdicts = judge_all(found)
    t.table_of(verdicts, verdict_name, verdict_body)
}
