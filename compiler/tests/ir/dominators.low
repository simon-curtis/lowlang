import ir
import std/rand
import std/testing

const graph_count = 300
const max_graph_blocks = 12

fn random_edges(mut generator: rand.Rng) -> [][]i64 {
    let n = rand.between(mut generator, 2, max_graph_blocks)
    var edges: [][]i64 = []
    for _ in 0..n {
        var targets: []i64 = []
        for _ in 0..rand.below(mut generator, 4) {
            targets.push(rand.below(mut generator, n))
        }
        edges.push(targets)
    }
    edges
}

fn reachable_without(blocks: []*ir.Block, removed: i64) -> []bool {
    var seen: []bool = []
    for _ in blocks {
        seen.push(false)
    }
    if removed == 0 {
        return seen
    }
    var work = [0]
    seen[0] = true
    for work.len > 0 {
        let at = work[work.len - 1]
        work.truncate(work.len - 1)
        for s in blocks[at].succs {
            if s.id != removed && !seen[s.id] {
                seen[s.id] = true
                work.push(s.id)
            }
        }
    }
    seen
}

fn strict_dominators(blocks: []*ir.Block) -> [][]bool {
    var doms: [][]bool = []
    for _ in blocks {
        var row: []bool = []
        for _ in blocks {
            row.push(false)
        }
        doms.push(row)
    }
    let reached = reachable_without(blocks, -1)
    for d in 0..blocks.len {
        let without = reachable_without(blocks, d)
        for v in 0..blocks.len {
            if v != d && reached[v] && !without[v] {
                doms[v][d] = true
            }
        }
    }
    doms
}

fn brute_idom(doms: [][]bool, v: i64) -> i64 {
    for d in 0..doms.len {
        if !doms[v][d] {
            continue
        }
        var nearest = true
        for other in 0..doms.len {
            if other != d && doms[v][other] && !doms[d][other] {
                nearest = false
            }
        }
        if nearest {
            return d
        }
    }
    -1
}

fn test_dominators_match_path_removal(t: *testing.T) {
    var generator = rand.seeded(3)
    for g in 0..graph_count {
        let edges = random_edges(mut generator)
        let blocks = blocks_of(edges)
        let d = ir.new_dominators(blocks[0])
        let doms = strict_dominators(blocks)
        for i, b in d.nodes {
            if i == 0 {
                continue
            }
            let got = d.nodes[d.idom[i]].id
            let want = brute_idom(doms, b.id)
            if got != want {
                t.error("graph {g} {edges}: block {b.id} has immediate dominator {got}, want {want}")
            }
        }
    }
}
