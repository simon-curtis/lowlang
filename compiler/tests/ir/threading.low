import diag
import ir
import types
import std/testing

const chain_links = 64

struct Chain {
    s: *ir.Ssa
    exit: *ir.Block
}

fn connect(from: *ir.Block, to: *ir.Block) {
    from.succs.push(to)
    to.preds.push(from)
}

fn and_chain(links: i64) -> Chain {
    let universe = types.new_universe(fn(t: *types.Type) ! diag.Error {})
    let f = new(ir.Func { name: "chain", ret: universe.void })
    let entry = ir.new_block(f)
    let exit = ir.new_block(f)
    let taken = ir.new_block(f)
    let operand = ir.new_value(f, entry, ir.Op.OpParam, [])
    var zero = ir.new_value(f, entry, ir.Op.OpConst, [])
    entry.values = [operand, zero]
    entry.kind = ir.Kind.If
    entry.control = operand
    var from = entry
    for k in 0..links {
        let rhs = ir.new_block(f)
        let join = ir.new_block(f)
        connect(from, rhs)
        connect(from, join)
        connect(rhs, join)
        let phi = ir.new_value(f, join, ir.Op.OpPhi, [zero, operand])
        join.values = [phi]
        if k + 1 < links {
            zero = ir.new_value(f, join, ir.Op.OpConst, [])
            join.values.push(zero)
        }
        join.kind = ir.Kind.If
        join.control = phi
        from = join
    }
    connect(from, taken)
    connect(from, exit)
    let s = new(ir.Ssa { func: f, ws: new(ir.Workspace {}), u: universe })
    Chain { s, exit }
}

fn test_and_chain_threads_in_one_pass(t: *testing.T) {
    let chain = and_chain(chain_links)
    t.is_true(ir.thread_branches(chain.s))
    t.is_false(ir.thread_branches(chain.s))
    t.equal(chain.exit.preds.len, chain_links + 1)
}
