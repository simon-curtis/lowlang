import diag
import ir
import types
import std/rand
import std/slices
import std/testing

fn new_func(name: str) -> *ir.Func {
    let universe = types.new_universe(fn(t: *types.Type) ! diag.Error {})
    new(ir.Func { name, ret: universe.void })
}

struct Branch {
    entry: *ir.Block
    phi: *ir.Value
}

fn branch_on_constant(condition: i64) -> Branch {
    let f = new_func("branch")
    let entry = ir.new_block(f)
    let join = ir.new_block(f)
    let control = ir.new_value(f, entry, ir.Op.OpConst, [])
    control.aux = condition
    let first = ir.new_value(f, entry, ir.Op.OpConst, [])
    first.aux = 1
    let second = ir.new_value(f, entry, ir.Op.OpConst, [])
    second.aux = 2
    let phi = ir.new_value(f, join, ir.Op.OpPhi, [first, second])
    entry.values = [control, first, second]
    entry.kind = ir.Kind.If
    entry.control = control
    entry.succs = [join, join]
    join.preds = [entry, entry]
    join.values = [phi]
    Branch { entry, phi }
}

struct TakeCase {
    condition: i64
    want: i64
}

fn take_name(c: TakeCase) -> str {
    "condition {c.condition}"
}

fn take_body(t: *testing.T, c: TakeCase) {
    let branch = branch_on_constant(c.condition)
    ir.take_case(branch.entry, ir.branch_index(c.condition != 0))
    if branch.phi.args.len != 1 || branch.phi.args[0].aux != c.want {
        t.error("phi has {branch.phi.args.len} arguments, want the constant {c.want}")
    }
    let join = branch.entry.succs[0]
    if join.preds.len != 1 || join.preds[0] != branch.entry {
        t.error("join has {join.preds.len} predecessors, want one edge from the entry")
    }
}

fn test_take_branch_with_shared_successor_keeps_taken_phi_argument(t: *testing.T) {
    t.table_of([TakeCase { condition: 1, want: 1 }, TakeCase { condition: 0, want: 2 }], take_name, take_body)
}

fn high_product(a: u64, b: u64) -> u64 {
    let mask: u64 = 0xFFFFFFFF
    let a0 = a & mask
    let a1 = a >> 32
    let b0 = b & mask
    let b1 = b >> 32
    let w0 = a0 * b0
    let carry = a1 * b0 + (w0 >> 32)
    let low = carry & mask
    let high = carry >> 32
    let cross = a0 * b1 + low
    a1 * b1 + high + (cross >> 32)
}

fn unsigned_quotient(m: ir.UnsignedMagic, x: u64) -> u64 {
    var high = high_product(m.multiplier, x)
    if m.add {
        high = ((x - high) >> 1) + high
    }
    high >> u64(m.shift)
}

fn signed_quotient(m: ir.SignedMagic, x: i64) -> i64 {
    var product = i64(high_product(u64(m.multiplier), u64(x)))
    if m.multiplier < 0 {
        product -= x
    }
    if x < 0 {
        product -= m.multiplier
    }
    if m.add {
        product += x
    }
    product = product >> m.shift
    product + i64(u64(x) >> 63)
}

const max_u64: u64 = 0xFFFFFFFFFFFFFFFF
const max_i64_word: u64 = 0x7FFFFFFFFFFFFFFF

fn dividends() -> []u64 {
    let max_u32: u64 = 0xFFFFFFFF
    let max_i32: u64 = 0x7FFFFFFF
    let top = max_i64_word
    var values: []u64 = [0, 1, 2, 3, 5, 7, 9, 10, 11, 100, 1000, max_i32, max_i32 + 1, max_u32,
        top - 1, top, top + 1, top + 2, max_u64 - 1, max_u64]
    var generator = rand.seeded(1)
    for _ in 0..200 {
        push(mut values, rand.next(mut generator))
        let shift = rand.below(mut generator, 64)
        push(mut values, rand.next(mut generator) >> u64(shift))
    }
    for i in 0..64 {
        let bit = u64(1) << u64(i)
        push(mut values, bit)
        push(mut values, bit - 1)
        push(mut values, bit + 1)
    }
    values
}

fn divisors() -> []u64 {
    var values: []u64 = []
    for d in 3..3000 {
        push(mut values, u64(d))
    }
    var generator = rand.seeded(2)
    for _ in 0..2000 {
        let shift = rand.below(mut generator, 62)
        push(mut values, rand.next(mut generator) >> u64(shift))
    }
    for i in 2..64 {
        let bit = u64(1) << u64(i)
        push(mut values, bit - 1)
        push(mut values, bit + 1)
        push(mut values, bit + 3)
    }
    let top = max_i64_word
    for extra in [max_u64, max_u64 - 1, top, top - 1, top + 1, top + 2] {
        push(mut values, extra)
    }
    values
}

fn check_divisor(t: *testing.T, d: u64, inputs: []u64) -> bool {
    let unsigned = ir.new_unsigned_magic(d)
    let signed_applies = d <= max_i64_word
    var signed = ir.SignedMagic { multiplier: 0, shift: 0 }
    if signed_applies {
        signed = ir.new_signed_magic(d)
    }
    for u in inputs {
        let got = unsigned_quotient(unsigned, u)
        if got != u / d {
            t.error("{u} / {d} = {u / d}, unsigned magic gives {got} ({unsigned.multiplier}, {unsigned.shift}, {unsigned.add})")
            return false
        }
        if !signed_applies {
            continue
        }
        let x = i64(u)
        let signed_got = signed_quotient(signed, x)
        if signed_got != x / i64(d) {
            t.error("{x} / {d} = {x / i64(d)}, signed magic gives {signed_got} ({signed.multiplier}, {signed.shift}, {signed.add})")
            return false
        }
    }
    true
}

fn test_magic_numbers_match_division(t: *testing.T) {
    let inputs = dividends()
    for d in divisors() {
        if d & (d - 1) == 0 || d < 3 {
            continue
        }
        if !check_divisor(t, d, inputs) {
            return
        }
    }
}

fn blocks_of(edges: [][]i64) -> []*ir.Block {
    let f = new_func("loops")
    var blocks: []*ir.Block = []
    for _ in 0..edges.len {
        push(mut blocks, ir.new_block(f))
    }
    for from, targets in edges {
        for to in targets {
            push(mut blocks[from].succs, blocks[to])
            push(mut blocks[to].preds, blocks[from])
        }
    }
    blocks
}

fn body_of(l: *ir.NaturalLoop) -> []i64 {
    var body: []i64 = []
    for block in l.body {
        push(mut body, block.id)
    }
    slices.sort(mut body)
    body
}

fn test_nested_loops_are_ordered_innermost_first(t: *testing.T) {
    let blocks = blocks_of([[1], [2, 5], [3], [2, 4], [1], []])
    let found = ir.loops(ir.new_dominators(blocks[0]))
    if found.len != 2 {
        t.fatal("found {found.len} loops, want 2")
        return
    }
    t.equal_slice(body_of(found[0]), [2, 3])
    t.equal(found[0].header.id, 2)
    t.equal_slice(body_of(found[1]), [1, 2, 3, 4])
    t.equal(found[1].header.id, 1)
}

fn test_cycle_with_two_entries_is_not_a_loop(t: *testing.T) {
    let blocks = blocks_of([[1, 2], [2, 3], [1, 3], []])
    let found = ir.loops(ir.new_dominators(blocks[0]))
    t.equal(found.len, 0)
}

fn main() {
    testing.run([
        testing.Test { name: "take_branch_with_shared_successor_keeps_taken_phi_argument", run: test_take_branch_with_shared_successor_keeps_taken_phi_argument }
        testing.Test { name: "magic_numbers_match_division", run: test_magic_numbers_match_division }
        testing.Test { name: "nested_loops_are_ordered_innermost_first", run: test_nested_loops_are_ordered_innermost_first }
        testing.Test { name: "cycle_with_two_entries_is_not_a_loop", run: test_cycle_with_two_entries_is_not_a_loop }
    ])
}
