import compiler
import ir
import native
import target
import std/testing

const logical_program = "testdata/run/logical_branches.low"
const logical_func = "kind"

fn test_logical_conditions_branch_without_phis(t: *testing.T) {
    let profile = compiler.release(target.OS.Linux)
    let unit = native.analyse(logical_program, profile) catch {
        e => {
            t.fatal(native.message(e))
            return
        }
    }
    let program = unit.program ?? panic("{logical_program} analysed without a program")
    var found = false
    for f in program.funcs {
        if f.name != logical_func {
            continue
        }
        found = true
        var phis = 0
        for b in f.blocks {
            for v in b.values {
                if v.op == ir.Op.OpPhi {
                    phis += 1
                }
            }
        }
        if phis > 0 {
            t.error("{logical_func} keeps {phis} phis, want each && and || condition to branch directly")
        }
    }
    if !found {
        t.error("{logical_program} has no function {logical_func}")
    }
}
