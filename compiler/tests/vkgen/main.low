import gentest
import shaders
import std/file
import std/testing
import std/text
import target
import vkgen

const bindings_dir = "internal/compiler/std/ui/gpu"
const shader_dir = "internal/compiler/std/ui/gpu/shaders"
const registry_path = "internal/vkgen/registry/vk.xml.gz"
const selection_path = "internal/vkgen/registry/vulkan.list"
const regenerate = "vkgen -registry internal/vkgen/registry/vk.xml.gz -select internal/vkgen/registry/vulkan.list -o internal/compiler/std/ui/gpu"

fn registry(t: *testing.T) -> vkgen.Registry {
    vkgen.read_registry(registry_path) catch {
        Failed(message) => {
            t.fatal(message)
            return vkgen.Registry { types: [], enums: [], commands: [], features: [], extensions: [] }
        }
    }
}

fn selection(t: *testing.T) -> vkgen.Selection {
    let list = file.read_text(selection_path) catch {
        e => {
            t.fatal("{selection_path}: {e}")
            return empty_selection()
        }
    }
    vkgen.parse_selection(list) catch {
        Failed(message) => {
            t.fatal(message)
            return empty_selection()
        }
    }
}

fn empty_selection() -> vkgen.Selection {
    vkgen.Selection { commands: [], extensions: [], types: [], libraries: [:] }
}

fn generated(t: *testing.T) -> []vkgen.File {
    let reg = registry(t)
    let sel = selection(t)
    vkgen.generate(reg, sel) catch {
        Failed(message) => {
            t.fatal(message)
            return []
        }
    }
}

fn generation_error(t: *testing.T, sel: vkgen.Selection) -> str {
    let reg = registry(t)
    vkgen.generate(reg, sel) catch {
        Failed(message) => return message
    }
    t.fatal("generate succeeded")
    ""
}

fn test_checked_in_bindings(t: *testing.T) {
    for f in generated(t) {
        let path = file.child_path(bindings_dir, f.name)
        let got = file.read_text(path) catch {
            e => {
                t.error("{f.name}: {e}; run {regenerate}")
                continue
            }
        }
        if got != f.source {
            t.error("{f.name} differs from the generator output; run {regenerate}")
        }
    }
}

struct DeclCase {
    inner: str
    want: vkgen.Decl
}

fn decl_cases() -> []DeclCase {
    [
        DeclCase { inner: "const <type>VkApplicationInfo</type>* <name>pApplicationInfo</name>", want: vkgen.Decl { constant: true, type: "VkApplicationInfo", stars: 1, name: "pApplicationInfo" } }
        DeclCase { inner: "<type>char</type> <name>deviceName</name>[<enum>VK_MAX_PHYSICAL_DEVICE_NAME_SIZE</enum>]<comment>x</comment>", want: vkgen.Decl { type: "char", name: "deviceName", dims: ["VK_MAX_PHYSICAL_DEVICE_NAME_SIZE"] } }
        DeclCase { inner: "<type>float</type> <name>matrix</name>[3][4]", want: vkgen.Decl { type: "float", name: "matrix", dims: ["3", "4"] } }
        DeclCase { inner: "<type>VkBool32</type> <name alias=\"X::y\">robustImageAccess</name>", want: vkgen.Decl { type: "VkBool32", name: "robustImageAccess" } }
        DeclCase { inner: "<type>void</type>** <name>ppData</name>", want: vkgen.Decl { type: "void", stars: 2, name: "ppData" } }
    ]
}

fn test_parse_decl(t: *testing.T) {
    for c in decl_cases() {
        let got = vkgen.parse_decl(c.inner) catch {
            Failed(message) => {
                t.fatal(message)
                return
            }
        }
        let same = got.constant == c.want.constant && got.type == c.want.type && got.stars == c.want.stars && got.name == c.want.name && text.join(got.dims, ",") == text.join(c.want.dims, ",")
        if !same {
            t.error("parse_decl({text.quote(c.inner)}) = {got.type} {got.name} stars {got.stars} dims {text.join(got.dims, ",")}")
        }
    }
}

struct ValueCase {
    enum_value: vkgen.Enum
    extension: i64
    want: i64
}

fn value_cases() -> []ValueCase {
    [
        ValueCase { enum_value: vkgen.Enum { offset: "4", ext_number: "315" }, extension: 0, want: 1000314004 }
        ValueCase { enum_value: vkgen.Enum { offset: "0" }, extension: 2, want: 1000001000 }
        ValueCase { enum_value: vkgen.Enum { offset: "1", dir: "-" }, extension: 1, want: -1000000001 }
        ValueCase { enum_value: vkgen.Enum { bit_pos: "10" }, extension: 0, want: 1024 }
        ValueCase { enum_value: vkgen.Enum { value: "0x0000000FULL" }, extension: 0, want: 15 }
        ValueCase { enum_value: vkgen.Enum { value: "(~0U)" }, extension: 0, want: -1 }
    ]
}

fn test_enum_values(t: *testing.T) {
    for c in value_cases() {
        let got = vkgen.enum_value(c.enum_value, c.extension) catch {
            Failed(message) => {
                t.error("enum_value: {message}")
                continue
            }
        }
        if !got.ok || got.value != c.want {
            t.error("enum_value = {got.value} {got.ok}, want {c.want}")
        }
    }
    t.equal(vkgen.literal(-1, "u32"), "4294967295")
}

fn test_selection(t: *testing.T) {
    let source = "# bindings\nlibrary linux vulkan\nlibrary windows vulkan-1\nextension VK_KHR_surface\n\ncommand vkCreateInstance\ncommand vkCreateWaylandSurfaceKHR linux\ntype VkExtent2D\n"
    let sel = vkgen.parse_selection(source) catch {
        Failed(message) => {
            t.fatal(message)
            return
        }
    }
    t.equal(sel.extensions.len, 1)
    t.equal(sel.commands.len, 2)
    t.equal(sel.types.len, 1)
    t.fatal_if(sel.commands.len != 2, "expected two commands")
    t.equal(sel.commands[0].name, "vkCreateInstance")
    t.equal(sel.commands[0].system, "")
    t.equal(sel.commands[1].name, "vkCreateWaylandSurfaceKHR")
    t.equal(sel.commands[1].system, "linux")
    t.equal(sel.libraries["linux"] ?? "", "vulkan")
    t.equal(sel.libraries["windows"] ?? "", "vulkan-1")
}

struct SelectionError {
    source: str
    want: str
}

fn selection_errors() -> []SelectionError {
    [
        SelectionError { source: "function vkCreateInstance", want: "line 1: expected" }
        SelectionError { source: "command", want: "line 1: expected" }
        SelectionError { source: "command vkCreateInstance linux extra", want: "line 1: expected" }
        SelectionError { source: "library linux", want: "line 1: expected" }
        SelectionError { source: "library linux vulkan extra", want: "line 1: expected" }
        SelectionError { source: "command vkCreateInstance plan9", want: "line 1: unknown system \"plan9\"" }
        SelectionError { source: "\nlibrary plan9 vulkan", want: "line 2: unknown system \"plan9\"" }
        SelectionError { source: "library linux vulkan\nlibrary linux vulkan-2", want: "line 2: library for linux is already named" }
    ]
}

fn test_selection_errors(t: *testing.T) {
    for c in selection_errors() {
        vkgen.parse_selection(c.source) catch {
            Failed(message) => {
                if !text.contains(message, c.want) {
                    t.error("parse_selection({text.quote(c.source)}) error = {message}, want {text.quote(c.want)}")
                }
                continue
            }
        }
        t.error("parse_selection({text.quote(c.source)}) succeeded, want {text.quote(c.want)}")
    }
}

fn test_missing_library(t: *testing.T) {
    var sel = empty_selection()
    push(mut sel.commands, vkgen.SelectedCommand { name: "vkCreateInstance" })
    sel.libraries["linux"] = "vulkan"
    let message = generation_error(t, sel)
    t.contains(message, "no \"library windows NAME\" line")
}

fn test_unknown_command(t: *testing.T) {
    var sel = empty_selection()
    push(mut sel.commands, vkgen.SelectedCommand { name: "vkDoesNotExist" })
    sel.libraries["linux"] = "vulkan"
    sel.libraries["windows"] = "vulkan-1"
    let message = generation_error(t, sel)
    t.contains(message, "unknown command vkDoesNotExist")
}

fn test_target_files(t: *testing.T) {
    let files = generated(t)
    var names: []str = []
    for f in files {
        push(mut names, f.name)
    }
    t.equal(text.join(names, " "), "vulkan.low vulkan_linux.low vulkan_windows.low")
    t.fatal_if(files.len != 3, "expected three files")
    let shared = files[0].source
    let linux = files[1].source
    let windows = files[2].source
    t.is_false(text.contains(shared, "extern \""))
    for want in ["extern \"vulkan\" {{", "fn vkCreateInstance(", "fn vkCreateWaylandSurfaceKHR(", "fn vkGetPhysicalDeviceWaylandPresentationSupportKHR("] {
        t.contains(linux, want)
    }
    for want in ["extern \"vulkan-1\" {{", "fn vkCreateInstance(", "fn vkCreateWin32SurfaceKHR(", "fn vkGetPhysicalDeviceWin32PresentationSupportKHR("] {
        t.contains(windows, want)
    }
    t.is_false(text.contains(linux, "Win32"))
    t.is_false(text.contains(windows, "Wayland"))
    for want in ["extern struct VkWaylandSurfaceCreateInfoKHR {{", "extern struct VkWin32SurfaceCreateInfoKHR {{"] {
        t.contains(shared, want)
    }
}

fn test_bindings_shape(t: *testing.T) {
    var all = ""
    for f in generated(t) {
        all = "{all}{f.source}"
    }
    t.is_false(text.contains(all, "pub "))
    let wanted = [
        "fn vkCreateInstance(mut pCreateInfo: VkInstanceCreateInfo, pAllocator: ptr[VkAllocationCallbacks], mut pInstance: VkInstance) -> i32"
        "fn vkMapMemory(device: VkDevice, memory: VkDeviceMemory, offset: i64, size: i64, flags: u32, mut ppData: ptr) -> i32"
        "    sType: i32 = 1000314004"
        "extern struct VkBuffer {{\n    handle: i64 = 0\n}}"
        "extern struct VkInstance {{\n    handle: ptr = null\n}}"
        "fn VkPhysicalDeviceProperties_deviceName(s: VkPhysicalDeviceProperties) -> str {{"
        "fn VkPhysicalDeviceMemoryProperties_memoryTypes(s: VkPhysicalDeviceMemoryProperties) -> []VkMemoryType {{"
        "const VK_QUEUE_FAMILY_IGNORED: u32 = 4294967295"
        "    hwnd: ptr = null"
    ]
    for want in wanted {
        t.contains(all, want)
    }
}

fn offscreen_files(t: *testing.T) -> []gentest.Program {
    let program = file.read_file("internal/vkgen/testdata/offscreen.low") catch {
        e => {
            t.fatal("offscreen.low: {e}")
            return []
        }
    }
    var files = [gentest.Program { file: "main.low", contents: program }]
    for f in generated(t) {
        let contents = bytes(f.source)
        push(mut files, gentest.Program { file: f.name, contents })
    }
    let stages = shaders.stages(shader_dir) catch {
        e => {
            t.fatal("{shader_dir}: {e}")
            return files
        }
    }
    for stage in stages {
        let name = shaders.binary(stage)
        let data = file.read_file(file.child_path(shader_dir, name)) catch {
            e => {
                t.fatal("{name}: {e}")
                return files
            }
        }
        push(mut files, gentest.Program { file: name, contents: data })
    }
    files
}

fn scratch_directory(t: *testing.T) -> str {
    file.temp_dir("vkgen") catch {
        e => {
            t.fatal("{e}")
            return ""
        }
    }
}

fn test_offscreen_render(t: *testing.T) {
    if !gentest.library_available("vulkan") {
        t.skip("libvulkan is not available")
        return
    }
    let files = offscreen_files(t)
    let dir = scratch_directory(t)
    defer file.remove_all(dir) or {}
    let binary = gentest.build_directory(t, dir, files, target.OS.Linux)
    let got = gentest.run_binary(t, binary)
    if text.starts_with(got, "no vulkan 1.3 device") {
        t.skip("no Vulkan 1.3 device")
        return
    }
    let want = "0 0 0 255\n255 0 0 255\n0 0 255 255\n0 0 0 255\n"
    if got != want {
        t.error("pixels:\n{got}\nwant:\n{want}")
    }
}

fn test_windows_bindings_build(t: *testing.T) {
    let files = offscreen_files(t)
    let dir = scratch_directory(t)
    defer file.remove_all(dir) or {}
    let binary = gentest.build_directory(t, dir, files, target.OS.Windows)
    let data = file.read_file(binary) catch {
        e => {
            t.fatal("{binary}: {e}")
            return
        }
    }
    let lowered = text.lower(str(data))
    if !text.contains(lowered, "vulkan-1.dll") {
        t.error("the Windows executable does not import vulkan-1.dll")
    }
}

fn main() {
    testing.run([
        testing.Test { name: "checked_in_bindings", run: test_checked_in_bindings }
        testing.Test { name: "parse_decl", run: test_parse_decl }
        testing.Test { name: "enum_values", run: test_enum_values }
        testing.Test { name: "selection", run: test_selection }
        testing.Test { name: "selection_errors", run: test_selection_errors }
        testing.Test { name: "missing_library", run: test_missing_library }
        testing.Test { name: "unknown_command", run: test_unknown_command }
        testing.Test { name: "target_files", run: test_target_files }
        testing.Test { name: "bindings_shape", run: test_bindings_shape }
        testing.Test { name: "offscreen_render", run: test_offscreen_render }
        testing.Test { name: "windows_bindings_build", run: test_windows_bindings_build }
    ])
}
