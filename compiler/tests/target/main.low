import target
import std/testing

fn test_every_name_parses_back(t: *testing.T) {
    for name in target.names() {
        let parsed = target.parse(name) catch {
            e => {
                t.fatal(target.message(e))
                return
            }
        }
        t.equal(target.string(parsed), name)
    }
}

fn test_parse_error_lists_the_names(t: *testing.T) {
    target.parse("plan9/amd64") catch {
        e => {
            let message = target.message(e)
            for name in target.names() {
                t.contains(message, name)
            }
            return
        }
    }
    t.error("parsed an unknown target")
}

fn test_executable_suffix(t: *testing.T) {
    t.equal(target.executable(target.OS.Linux, "app"), "app")
    t.equal(target.executable(target.OS.Windows, "app"), "app.exe")
}

struct BuildsCase {
    os: target.OS
    file: str
    want: bool
}

fn builds_name(c: BuildsCase) -> str {
    "{target.string(c.os)} {c.file}"
}

fn builds_body(t: *testing.T, c: BuildsCase) {
    t.equal(target.builds(c.os, c.file), c.want)
}

fn test_builds_files_by_target_suffix(t: *testing.T) {
    let cases = [
        BuildsCase { os: target.OS.Linux, file: "main.low", want: true }
        BuildsCase { os: target.OS.Linux, file: "surface_linux.low", want: true }
        BuildsCase { os: target.OS.Linux, file: "surface_windows.low", want: false }
        BuildsCase { os: target.OS.Windows, file: "surface_windows.low", want: true }
        BuildsCase { os: target.OS.Windows, file: "dir/surface_linux.low", want: false }
        BuildsCase { os: target.OS.Windows, file: "linux.low", want: true }
    ]
    t.table_of(cases, builds_name, builds_body)
}

struct TestFileCase {
    file: str
    want: bool
}

fn test_file_name(c: TestFileCase) -> str {
    c.file
}

fn test_file_body(t: *testing.T, c: TestFileCase) {
    t.equal(target.is_test(c.file), c.want)
}

fn test_test_files_end_in_test_before_the_target_suffix(t: *testing.T) {
    let cases = [
        TestFileCase { file: "split_test.low", want: true }
        TestFileCase { file: "split_test_linux.low", want: true }
        TestFileCase { file: "split_test_windows.low", want: true }
        TestFileCase { file: "_test.low", want: true }
        TestFileCase { file: "split.low", want: false }
        TestFileCase { file: "split_linux.low", want: false }
        TestFileCase { file: "split_tests.low", want: false }
        TestFileCase { file: "test.low", want: false }
        TestFileCase { file: "split_test_helpers.low", want: false }
        TestFileCase { file: "split_test.txt", want: false }
    ]
    t.table_of(cases, test_file_name, test_file_body)
}

fn test_all_lists_every_target(t: *testing.T) {
    var got = target.all()
    let names = target.names()
    t.equal(got.len, names.len)
    for i in 0..got.len {
        t.equal(target.string(got[i]), names[i])
    }
    got[0] = target.OS.Windows
    t.is_true(target.all()[0] == target.OS.Linux)
}

fn main() {
    testing.run([
        testing.Test { name: "every_name_parses_back", run: test_every_name_parses_back }
        testing.Test { name: "parse_error_lists_the_names", run: test_parse_error_lists_the_names }
        testing.Test { name: "executable_suffix", run: test_executable_suffix }
        testing.Test { name: "builds_files_by_target_suffix", run: test_builds_files_by_target_suffix }
        testing.Test { name: "test_files_end_in_test_before_the_target_suffix", run: test_test_files_end_in_test_before_the_target_suffix }
        testing.Test { name: "all_lists_every_target", run: test_all_lists_every_target }
    ])
}
