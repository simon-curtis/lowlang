import shaders
import std/file
import std/process
import std/testing
import std/text

const shader_dir = "internal/compiler/std/ui/gpu/shaders"

fn test_binaries_match_sources(t: *testing.T) {
    let want = shaders.sum(shader_dir) catch {
        e => {
            t.fatal("{shader_dir}: {e}")
            return
        }
    }
    let got = file.read_text(file.child_path(shader_dir, shaders.sum_file)) catch {
        e => {
            t.fatal("{shaders.sum_file}: {e}")
            return
        }
    }
    if got != want {
        t.error("shader sources or SPIR-V changed without a record; run shadergen {shader_dir}\nrecorded:\n{got}\ncurrent:\n{want}")
    }
}

fn test_binaries_validate(t: *testing.T) {
    let validator = process.find("spirv-val") ?? ""
    if validator == "" {
        t.skip("spirv-val is not installed")
        return
    }
    let stages = shaders.stages(shader_dir) catch {
        e => {
            t.fatal("{shader_dir}: {e}")
            return
        }
    }
    for stage in stages {
        validate_stage(t, validator, stage)
    }
}

fn validate_stage(t: *testing.T, validator: str, stage: str) {
    let binary = file.child_path(shader_dir, shaders.binary(stage))
    let command = process.command(validator, ["--target-env", shaders.target_env, binary])
    let output = process.run(command, []) catch {
        e => {
            t.error("{binary}: {e}")
            return
        }
    }
    if !process.success(output.status) {
        t.error("{binary}: failed\n{str(output.stdout)}{str(output.stderr)}")
    }
}

fn main() {
    testing.run([
        testing.Test { name: "binaries_match_sources", run: test_binaries_match_sources }
        testing.Test { name: "binaries_validate", run: test_binaries_validate }
    ])
}
