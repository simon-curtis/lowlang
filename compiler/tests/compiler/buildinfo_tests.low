import compiler
import native
import target
import std/process
import std/testing
import std/text

struct Stamped {
    roots: []str
}

fn stamping_overlay(seen: *Stamped) -> *compiler.Overlay {
    var disk = native.disk()
    disk.stamp = fn(root: str) -> compiler.Stamp {
        seen.roots.push(root)
        compiler.Stamp { revision: "0123456789abcdef", time: 1795017690 }
    }
    compiler.new_overlay(disk, native.runner())
}

fn output_of(t: *testing.T, dir: str, source: str, seen: *Stamped) -> str {
    let host = target.host()
    write_text(t, "{dir}/low.mod", "")
    write_text(t, "{dir}/main.low", source)
    let overlay = stamping_overlay(seen)
    let std = compiler.new_std()
    let unit = compiler.check_in(dir, host, std, overlay) catch {
        e => {
            remove_dir(dir)
            testing.fatal(t, compiler.message(e))
            panic("fatal returned")
        }
    }
    let profile = compiler.release(host)
    compiler.lower(unit, profile, native.runner())
    let binary = "{dir}/{target.executable(host, "main")}"
    build_unit(t, dir, unit, binary)
    let command = process.command(binary, [])
    let output = process.run(command, []) catch {
        e => {
            remove_dir(dir)
            testing.fatal(t, "run {binary}: {testing.format(e)}")
            panic("fatal returned")
        }
    }
    text.trim(str(output.stdout))
}

fn test_buildinfo_reports_the_stamp_of_the_project_root(t: *testing.T) {
    let dir = make_temp_dir(t)
    let seen = new(Stamped { roots: [] })
    let got = output_of(t, dir, "import std/buildinfo\n\nfn main() {{\n    print(\"{{buildinfo.revision}} {{buildinfo.time}}\")\n}}\n", seen)
    remove_dir(dir)
    t.equal(got, "0123456789abcdef 1795017690")
    let roots = testing.format(seen.roots)
    let want = testing.format([dir])
    t.equal(roots, want)
}

fn test_programs_without_buildinfo_are_not_stamped(t: *testing.T) {
    let dir = make_temp_dir(t)
    let seen = new(Stamped { roots: [] })
    let got = output_of(t, dir, "fn main() {{\n    print(\"plain\")\n}}\n", seen)
    remove_dir(dir)
    t.equal(got, "plain")
    t.equal(seen.roots.len, 0)
}
