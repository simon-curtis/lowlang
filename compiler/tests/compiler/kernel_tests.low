import ir
import std/testing
import std/text

fn kernel_operation(v: *ir.Value) -> bool {
    match v.op {
        OpCall => false
        OpCCall => false
        OpSyscall => false
        OpFuncAddr => false
        OpString => false
        OpCell => false
        OpEmbed => false
        OpEmbedTable => false
        OpStaticBlock => false
        OpHashSeed => false
        OpRuntime => v.runtime == ir.Runtime.RtExp
        _ => true
    }
}

fn test_kernel_build_holds_only_kernel_operations(t: *testing.T) {
    let prog = dev_fixture(t, "kernel")
    let called = ir.text(function(t, prog, "step"))
    if !text.contains(called, " call mix ") {
        t.error("a dev build inlined mix into step, so the kernel build of step proves nothing:\n{called}")
    }
    if prog.kernels.len == 0 {
        t.error("the program has no kernel builds")
    }
    for k in prog.kernels {
        let built = ir.with_blocks(prog, k)
        for b in built.blocks {
            for v in b.values {
                if !kernel_operation(v) {
                    t.error("the kernel build of {k.name} holds {ir.op_name(v.op)}:\n{ir.text(built)}")
                }
            }
        }
    }
}
