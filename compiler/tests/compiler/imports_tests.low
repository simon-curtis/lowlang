import compiler
import native
import target
import std/testing
import std/text

fn operating_system_modules() -> []str {
    ["std/sys", "std/os", "std/file", "parallel", "amd64", "asm", "link"]
}

fn is_operating_system(name: str) -> bool {
    for banned in operating_system_modules() {
        if name == banned || text.starts_with(name, "{banned}/") {
            return true
        }
    }
    false
}

fn test_front_end_imports_no_operating_system_module(t: *testing.T) {
    let std = compiler.new_std()
    let docs = native.overlay()
    let loaded = compiler.load_modules("compiler/compiler", target.OS.Linux, std, docs) catch {
        e => {
            t.fatal(compiler.message(e))
            return
        }
    }
    let names = compiler.module_names(loaded)
    var found: []str = []
    for name in names {
        if is_operating_system(name) {
            push(mut found, name)
        }
    }
    if found.len > 0 {
        t.error("compiler/compiler imports {testing.format(found)}")
    }
    if names.len == 0 {
        t.error("compiler/compiler loaded no modules")
    }
}
