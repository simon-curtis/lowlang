import compiler
import target
import std/slices
import std/testing
import std/text

struct TestSourceCase {
    name: str
    platform: target.OS
    want: bool
}

fn test_source_name(c: TestSourceCase) -> str {
    "{c.name} on {c.platform}"
}

fn test_source_body(t: *testing.T, c: TestSourceCase) {
    t.equal(compiler.is_test_source(c.name, c.platform), c.want)
}

fn test_test_sources_follow_the_name_and_the_platform(t: *testing.T) {
    let cases = [
        TestSourceCase { name: "split_test.low", platform: target.OS.Linux, want: true }
        TestSourceCase { name: "split_test_linux.low", platform: target.OS.Linux, want: true }
        TestSourceCase { name: "split_test_windows.low", platform: target.OS.Linux, want: false }
        TestSourceCase { name: "split_test_windows.low", platform: target.OS.Windows, want: true }
        TestSourceCase { name: "split.low", platform: target.OS.Linux, want: false }
        TestSourceCase { name: "split_test.txt", platform: target.OS.Linux, want: false }
    ]
    t.table_of(cases, test_source_name, test_source_body)
}

fn test_std_test_modules_are_sorted_standard_library_paths(t: *testing.T) {
    let found = compiler.std_test_modules(target.OS.Linux)
    t.is_true(slices.sorted(found))
    for place in found {
        t.is_true(place == "std" || text.starts_with(place, "std/"))
    }
}
