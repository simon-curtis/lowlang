import compiler
import target
import std/testing

fn checks(entry: str, std: *compiler.Std, docs: *compiler.Overlay) -> bool {
    compiler.check_in(entry, target.OS.Linux, std, docs) or return false
    true
}

fn test_overlay_files_join_their_directory(t: *testing.T) {
    let dir = make_temp_dir(t)
    write_text(t, "{dir}/main.low", "fn main() {{\n    helper()\n}}\n")
    let std = compiler.new_std()
    let overlay = compiler.new_overlay()
    compiler.overlay_put(overlay, "{dir}/helper.low", "fn helper() {{\n}}\n")
    let with_unsaved = checks(dir, std, overlay)
    let empty = compiler.new_overlay()
    let without = checks(dir, std, empty)
    remove_dir(dir)
    if !with_unsaved {
        t.error("directory with an unsaved file failed to check")
    }
    if without {
        t.error("helper resolved without the unsaved file")
    }
}

fn test_overlay_shadows_disk(t: *testing.T) {
    let dir = make_temp_dir(t)
    let disk = "{dir}/main.low"
    write_text(t, disk, "fn main() {{\n    missing()\n}}\n")
    let std = compiler.new_std()
    let empty = compiler.new_overlay()
    let on_disk = checks(disk, std, empty)
    let overlay = compiler.new_overlay()
    compiler.overlay_put(overlay, disk, "fn main() {{\n}}\n")
    let shadowed = checks(disk, std, overlay)
    remove_dir(dir)
    if on_disk {
        t.error("disk copy compiled")
    }
    if !shadowed {
        t.error("overlay copy failed to check")
    }
}

fn test_overlay_embeds_unsaved_file(t: *testing.T) {
    let dir = make_temp_dir(t)
    let disk = "{dir}/main.low"
    write_text(t, disk, "fn main() {{\n    print(embed(\"note.txt\"))\n}}\n")
    let note = "{dir}/note.txt"
    let std = compiler.new_std()
    let overlay = compiler.new_overlay()
    compiler.overlay_put(overlay, note, "held in memory")
    let checked = compiler.check_in(disk, target.OS.Linux, std, overlay) catch {
        e => {
            remove_dir(dir)
            t.fatal(compiler.message(e))
            panic("fatal returned")
        }
    }
    let empty = compiler.new_overlay()
    let without = checks(disk, std, empty)
    remove_dir(dir)
    if checked.sources.len != 2 || checked.sources[1] != note {
        t.fatal("sources {testing.format(checked.sources)}, want the program and {note}")
    }
    if without {
        t.error("embed resolved without the unsaved file")
    }
}

fn test_root_finds_module_file(t: *testing.T) {
    let dir = make_temp_dir(t)
    let nested = "{dir}/a/b"
    make_dir(t, nested)
    let empty = compiler.new_overlay()
    let bare = compiler.root(empty, nested)
    let overlay = compiler.new_overlay()
    compiler.overlay_put(overlay, "{dir}/low.mod", "")
    let found = compiler.root(overlay, nested)
    remove_dir(dir)
    match bare {
        some(_) => t.fatal("found a root without low.mod")
        none => {}
    }
    match found {
        some(root) => t.equal(root, dir)
        none => t.error("root not found; want {dir}")
    }
}

fn test_parse_file_reads_through_the_overlay(t: *testing.T) {
    let dir = make_temp_dir(t)
    let name = "{dir}/held.low"
    let overlay = compiler.new_overlay()
    compiler.overlay_put(overlay, name, "fn held() {{\n}}\n")
    let parsed = compiler.parse_file(overlay, name) catch {
        e => {
            remove_dir(dir)
            t.fatal(compiler.message(e))
            panic("fatal returned")
        }
    }
    remove_dir(dir)
    if parsed.path != name || parsed.funcs.len != 1 {
        t.fatal("parsed \"{parsed.path}\" with {parsed.funcs.len} functions")
    }
}
