import std/testing

fn main() {
    let tests = [
        testing.Test { name: "ConcatenationChainAllocatesOnce", run: test_concatenation_chain_allocates_once }
        testing.Test { name: "InterpolationAllocatesOnce", run: test_interpolation_allocates_once }
        testing.Test { name: "CapturedImmutableIsNotBoxed", run: test_captured_immutable_is_not_boxed }
        testing.Test { name: "DevBuildDoesNotHoistLiterals", run: test_dev_build_does_not_hoist_literals }
        testing.Test { name: "ReleaseBuildHoistsConstantLiterals", run: test_release_build_hoists_constant_literals }
        testing.Test { name: "UnreachableFunctionsAreNotBuilt", run: test_unreachable_functions_are_not_built }
        testing.Test { name: "UnusedLoadIsRemoved", run: test_unused_load_is_removed }
        testing.Test { name: "Unsigned32BitArithmeticUsesDwordForms", run: test_unsigned_32_bit_arithmetic_uses_dword_forms }
        testing.Test { name: "Unsigned32BitAddUsesNoAddressSizePrefix", run: test_unsigned_32_bit_add_uses_no_address_size_prefix }
        testing.Test { name: "WideningConversionNeedsNoNormalisation", run: test_widening_conversion_needs_no_normalisation }
        testing.Test { name: "ShiftPairBecomesRotate", run: test_shift_pair_becomes_rotate }
        testing.Test { name: "ShiftPairThatDoesNotCoverTheWidthIsNotARotate", run: test_shift_pair_that_does_not_cover_the_width_is_not_a_rotate }
        testing.Test { name: "LiteralComparisonIsInline", run: test_literal_comparison_is_inline }
        testing.Test { name: "StringComparisonChecksLengthsBeforeCalling", run: test_string_comparison_checks_lengths_before_calling }
        testing.Test { name: "GrowKeepsScalarsInCallerSavedRegisters", run: test_grow_keeps_scalars_in_caller_saved_registers }
        testing.Test { name: "CompressionLoopKeepsFewFrameOperands", run: test_compression_loop_keeps_few_frame_operands }
        testing.Test { name: "HotBuildExposesThePatchProtocol", run: test_hot_build_exposes_the_patch_protocol }
        testing.Test { name: "PatchLinksAtTheHotRegion", run: test_patch_links_at_the_hot_region }
        testing.Test { name: "BuildChoosesTheLinkerFromTheTarget", run: test_build_chooses_the_linker_from_the_target }
        testing.Test { name: "TwoLambdasCloned", run: test_two_lambdas_cloned }
        testing.Test { name: "DevClonesNothing", run: test_dev_clones_nothing }
        testing.Test { name: "CapturingClosureCloned", run: test_capturing_closure_cloned }
        testing.Test { name: "RecursiveCloneCallsItself", run: test_recursive_clone_calls_itself }
        testing.Test { name: "UnknownFunctionValueKeepsOriginal", run: test_unknown_function_value_keeps_original }
        testing.Test { name: "CloneBudgetIsFourPerFunction", run: test_clone_budget_is_four_per_function }
        testing.Test { name: "SameCodeWithDifferentEnvironmentsCloned", run: test_same_code_with_different_environments_cloned }
        testing.Test { name: "DocumentProject", run: test_document_project }
        testing.Test { name: "StdTargetsShareAPI", run: test_std_targets_share_api }
        testing.Test { name: "StdDocumented", run: test_std_documented }
        testing.Test { name: "StringHashIgnoresLengthCancellation", run: test_string_hash_ignores_length_cancellation }
        testing.Test { name: "InlinesCalleeWithSlot", run: test_inlines_callee_with_slot }
        testing.Test { name: "AppendStrInlinedAndPromoted", run: test_append_str_inlined_and_promoted }
        testing.Test { name: "DevInlinesNothing", run: test_dev_inlines_nothing }
        testing.Test { name: "DevirtualisedSiteInlined", run: test_devirtualised_site_inlined }
        testing.Test { name: "BoundsChecksRemoved", run: test_bounds_checks_removed }
        testing.Test { name: "Float32CallResultIsCleared", run: test_float32_call_result_is_cleared }
        testing.Test { name: "OptimiserRemovals", run: test_optimiser_removals }
        testing.Test { name: "NoJumpToNextBlock", run: test_no_jump_to_next_block }
        testing.Test { name: "NoJumpOnlyBlocks", run: test_no_jump_only_blocks }
        testing.Test { name: "SieveInnerLoopIsRotated", run: test_sieve_inner_loop_is_rotated }
        testing.Test { name: "FibBaseCaseSavesNothing", run: test_fib_base_case_saves_nothing }
        testing.Test { name: "LightPathAvoidsCalleeSavedRegisters", run: test_light_path_avoids_callee_saved_registers }
        testing.Test { name: "SortClosureIsFrameless", run: test_sort_closure_is_frameless }
        testing.Test { name: "QuicksortHasNoSlotToSlotCopies", run: test_quicksort_has_no_slot_to_slot_copies }
        testing.Test { name: "SmallJoinIsClonedOntoTheLightPath", run: test_small_join_is_cloned_onto_the_light_path }
        testing.Test { name: "LargeJoinIsNotCloned", run: test_large_join_is_not_cloned }
        testing.Test { name: "QuicksortElementAccessUsesScaledIndex", run: test_quicksort_element_access_uses_scaled_index }
        testing.Test { name: "QuicksortPartitionIndexStaysInRegister", run: test_quicksort_partition_index_stays_in_register }
        testing.Test { name: "NbodyInnerLoopFoldsLoadsIntoFloatOperations", run: test_nbody_inner_loop_folds_loads_into_float_operations }
        testing.Test { name: "MandelbrotDoublesWithoutMultiplying", run: test_mandelbrot_doubles_without_multiplying }
        testing.Test { name: "SieveSliceLivesInRegisters", run: test_sieve_slice_lives_in_registers }
        testing.Test { name: "SieveChecksOnlyTheMarkingIndex", run: test_sieve_checks_only_the_marking_index }
        testing.Test { name: "SieveFillGrowsOnceOutsideAnyLoop", run: test_sieve_fill_grows_once_outside_any_loop }
        testing.Test { name: "PushedSliceTakesNoFrameSlot", run: test_pushed_slice_takes_no_frame_slot }
        testing.Test { name: "MandelbrotReleaseInlinesEscapes", run: test_mandelbrot_release_inlines_escapes }
        testing.Test { name: "NbodyPairLoopMultipliesOnlyPerBody", run: test_nbody_pair_loop_multiplies_only_per_body }
        testing.Test { name: "SortReleaseCallsComparisonDirectly", run: test_sort_release_calls_comparison_directly }
        testing.Test { name: "SieveReleaseMarkingLoopHasNoIndexCheck", run: test_sieve_release_marking_loop_has_no_index_check }
        testing.Test { name: "SieveMarkingLoopStartsOnAThirtyTwoByteBoundary", run: test_sieve_marking_loop_starts_on_a_thirty_two_byte_boundary }
        testing.Test { name: "LightEqualArmStaysInLine", run: test_light_equal_arm_stays_in_line }
        testing.Test { name: "SievePrimeArmIsOutOfLine", run: test_sieve_prime_arm_is_out_of_line }
        testing.Test { name: "OverlayFilesJoinTheirDirectory", run: test_overlay_files_join_their_directory }
        testing.Test { name: "OverlayShadowsDisk", run: test_overlay_shadows_disk }
        testing.Test { name: "OverlayEmbedsUnsavedFile", run: test_overlay_embeds_unsaved_file }
        testing.Test { name: "RootFindsModuleFile", run: test_root_finds_module_file }
        testing.Test { name: "ParseFileReadsThroughTheOverlay", run: test_parse_file_reads_through_the_overlay }
        testing.Test { name: "FrontEndImportsNoOperatingSystemModule", run: test_front_end_imports_no_operating_system_module }
        testing.Test { name: "InlinedMutCalleeLosesSlot", run: test_inlined_mut_callee_loses_slot }
        testing.Test { name: "EscapingSlotStays", run: test_escaping_slot_stays }
        testing.Test { name: "ConditionalStoresBecomePhis", run: test_conditional_stores_become_phis }
        testing.Test { name: "CStructSlotStays", run: test_c_struct_slot_stays }
        testing.Test { name: "SelectBoxStays", run: test_select_box_stays }
        testing.Test { name: "MultiWordSlotPromoted", run: test_multi_word_slot_promoted }
        testing.Test { name: "InlinedRawLoadKeepsTrap", run: test_inlined_raw_load_keeps_trap }
        testing.Test { name: "SquareBoundDecidesTheMarkingCheck", run: test_square_bound_decides_the_marking_check }
        testing.Test { name: "SteppedIndexKeepsItsCheckOnlyWhenTheAddCanWrap", run: test_stepped_index_keeps_its_check_only_when_the_add_can_wrap }
        testing.Test { name: "SpecialisedLimitRemovesTheCheck", run: test_specialised_limit_removes_the_check }
        testing.Test { name: "ConstantSpecialisationNeedsEveryCallToAgree", run: test_constant_specialisation_needs_every_call_to_agree }
        testing.Test { name: "DevBuildKeepsConstantParameters", run: test_dev_build_keeps_constant_parameters }
        testing.Test { name: "ConstantThatFoldsNothingStaysAParameter", run: test_constant_that_folds_nothing_stays_a_parameter }
        testing.Test { name: "SwitchLowering", run: test_switch_lowering }
        testing.Test { name: "SwitchTablesEnumTags", run: test_switch_tables_enum_tags }
        testing.Test { name: "EnumIndexLowering", run: test_enum_index_lowering }
        testing.Test { name: "SwitchFoldsConstantSubject", run: test_switch_folds_constant_subject }
    ]
    testing.run(tests)
}
