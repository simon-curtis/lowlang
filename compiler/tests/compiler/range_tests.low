import ir
import std/testing
import std/text

struct LimitCase {
    limit: i64
    checks: i64
}

struct StepCase {
    name: str
    start: i64
    step: i64
    checks: i64
}

struct SpecialiseCase {
    fixture: str
    name: str
    params: i64
}

fn limit_cases() -> []LimitCase {
    [
        LimitCase { limit: 1000, checks: 0 }
        LimitCase { limit: 3037000500, checks: 0 }
        LimitCase { limit: 3037000501, checks: 1 }
        LimitCase { limit: 3037000502, checks: 1 }
    ]
}

fn test_square_bound_decides_the_marking_check(t: *testing.T) {
    t.table_of(limit_cases(), fn(c: LimitCase) -> str { "{c.limit}" }, fn(st: *testing.T, c: LimitCase) {
        let source = text.replace(embed("programs/square_marking.txt"), "LIMIT", "{c.limit}")
        let prog = release_program(st, source)
        let f = function(st, prog, "main")
        let got = count_checks(f)
        if got != c.checks {
            st.error("{got} checks, want {c.checks}\n{ir.text(f)}")
        }
    })
}

fn step_cases() -> []StepCase {
    [
        StepCase { name: "small step", start: 0, step: 7, checks: 0 }
        StepCase { name: "largest step that cannot wrap", start: 5, step: 9223372036854774808, checks: 0 }
        StepCase { name: "smallest step that can wrap", start: 5, step: 9223372036854774809, checks: 1 }
        StepCase { name: "step near the maximum", start: 5, step: 9223372036854775805, checks: 1 }
        StepCase { name: "negative start", start: -3, step: 1, checks: 1 }
    ]
}

fn test_stepped_index_keeps_its_check_only_when_the_add_can_wrap(t: *testing.T) {
    t.table_of(step_cases(), fn(c: StepCase) -> str { c.name }, fn(st: *testing.T, c: StepCase) {
        let with_start = text.replace(embed("programs/stepped_marking.txt"), "START", "{c.start}")
        let source = text.replace(with_start, "STEP", "{c.step}")
        let prog = release_program(st, source)
        let f = function(st, prog, "main")
        let got = count_checks(f)
        if got != c.checks {
            st.error("{got} checks, want {c.checks}\n{ir.text(f)}")
        }
    })
}

fn test_specialised_limit_removes_the_check(t: *testing.T) {
    let prog = release_fixture(t, "range_specialise_constant")
    let f = function(t, prog, "sieve")
    if f.param_words != 0 {
        t.error("sieve keeps {f.param_words} parameter words")
    }
    let got = count_checks(f)
    if got != 0 {
        t.error("{got} checks remain\n{ir.text(f)}")
    }
}

fn specialise_cases() -> []SpecialiseCase {
    [
        SpecialiseCase { fixture: "range_specialise_constant", name: "sieve", params: 0 }
        SpecialiseCase { fixture: "range_specialise_mixed", name: "sieve", params: 1 }
        SpecialiseCase { fixture: "range_specialise_address", name: "sieve", params: 1 }
        SpecialiseCase { fixture: "range_specialise_recursion", name: "marks", params: 1 }
        SpecialiseCase { fixture: "range_specialise_recursion", name: "climb", params: 3 }
    ]
}

fn test_constant_specialisation_needs_every_call_to_agree(t: *testing.T) {
    t.table_of(specialise_cases(), fn(c: SpecialiseCase) -> str { "{c.fixture}/{c.name}" }, fn(st: *testing.T, c: SpecialiseCase) {
        let prog = release_fixture(st, c.fixture)
        let f = function(st, prog, c.name)
        if f.param_words != c.params {
            st.error("{f.param_words} parameter words, want {c.params}\n{ir.text(f)}")
        }
    })
}

fn test_dev_build_keeps_constant_parameters(t: *testing.T) {
    let prog = dev_fixture(t, "range_specialise_constant")
    let f = function(t, prog, "sieve")
    if f.param_words != 1 {
        t.error("dev build specialised sieve: {f.param_words} parameter words")
    }
}

fn test_constant_that_folds_nothing_stays_a_parameter(t: *testing.T) {
    let prog = release_program(t, embed("programs/idle_constant.txt"))
    let f = function(t, prog, "spread")
    if f.param_words != 4 {
        t.error("{f.param_words} parameter words, want 4 (the slice and the scale)\n{ir.text(f)}")
    }
}
