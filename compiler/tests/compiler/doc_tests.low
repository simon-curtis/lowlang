import ast
import compiler
import diag
import native
import target
import std/file
import std/testing
import std/text

struct Undocumented {
    missing: []str
    malformed: []str
}

fn documented(t: *testing.T, dir: str, platform: target.OS) -> []*compiler.ModuleDoc {
    let docs = native.overlay()
    compiler.document(dir, platform, docs) catch {
        e => {
            t.fatal(compiler.message(e))
            panic("fatal returned")
        }
    }
}

fn test_document_project(t: *testing.T) {
    let dir = make_temp_dir(t)
    let shapes = "{dir}/shapes"
    make_dir(t, shapes)
    write_text(t, "{shapes}/box.low", embed("programs/doc_box.txt"))
    let examples = "{shapes}/examples"
    make_dir(t, examples)
    let example = "import shapes\n\nfn main() {{\n    print(shapes.unit().width)\n}}\n"
    write_text(t, "{examples}/unit.low", example)
    write_text(t, "{examples}/unit.out", "1\n")
    write_text(t, "{examples}/notes.txt", "skipped")
    let modules = documented(t, dir, target.OS.Linux)
    remove_dir(dir)
    if modules.len != 1 {
        t.fatal("modules = {testing.format(modules)}")
    }
    let module = modules[0]
    if module.path != "shapes" {
        t.fatal("modules = {testing.format(modules)}")
    }
    check_imports(t, module)
    check_items(t, module)
    check_examples(t, module, example)
}

fn check_imports(t: *testing.T, module: *compiler.ModuleDoc) {
    let want = compiler.ImportDoc { path: "std/text", alias: "text" }
    if module.imports.len != 1 {
        t.error("imports = {testing.format(module.imports)}")
        return
    }
    t.equal(module.imports[0].path, want.path)
    t.equal(module.imports[0].alias, want.alias)
}

fn want_items() -> []compiler.ItemDoc {
    [
        compiler.ItemDoc { kind: "struct", name: "Box", text: "pub struct Box {{\n    /// Across.\n    pub width: i64\n    ...\n}}", doc: "A box.", file: "box.low", line: 4 }
        compiler.ItemDoc { kind: "enum", name: "Shape", text: "pub enum Shape {{\n    Dot\n    Square(i64)\n}}", file: "box.low", line: 10 }
        compiler.ItemDoc { kind: "fn", name: "area", receiver: "Box", text: "pub fn area(b: *Box) -> i64", file: "box.low", line: 15 }
        compiler.ItemDoc { kind: "const", name: "clamp", text: "pub const clamp = u8(300)", file: "box.low", line: 32 }
        compiler.ItemDoc { kind: "const", name: "label", text: "pub const label = \"box\" + \"es\"", file: "box.low", line: 34 }
        compiler.ItemDoc { kind: "const", name: "limit", text: "pub const limit = base * 4", doc: "The most boxes in a row.", file: "box.low", line: 28 }
        compiler.ItemDoc { kind: "const", name: "scale", text: "pub const scale: f32 = 1.5", file: "box.low", line: 30 }
        compiler.ItemDoc { kind: "fn", name: "unit", text: "pub fn unit() -> Box", file: "box.low", line: 19 }
    ]
}

fn same_item(a: compiler.ItemDoc, b: compiler.ItemDoc) -> bool {
    a.kind == b.kind && a.name == b.name && a.receiver == b.receiver && a.text == b.text && a.doc == b.doc && a.file == b.file && a.line == b.line
}

fn check_items(t: *testing.T, module: *compiler.ModuleDoc) {
    let want = want_items()
    if module.items.len != want.len {
        t.fatal("items = {testing.format(module.items)}")
    }
    for i, item in module.items {
        if !same_item(item, want[i]) {
            t.error("item {i} = {testing.format(item)}, want {testing.format(want[i])}")
        }
    }
}

fn check_examples(t: *testing.T, module: *compiler.ModuleDoc, example: str) {
    if module.examples.len != 1 {
        t.error("examples = {testing.format(module.examples)}, want one")
        return
    }
    let found = module.examples[0]
    if found.name != "unit" || found.source != example || found.output != "1\n" {
        t.error("examples = {testing.format(module.examples)}")
    }
}

fn api_key(module: *compiler.ModuleDoc, item: compiler.ItemDoc) -> str {
    "{module.path} {item.kind} {item.receiver}.{item.name}"
}

fn api_item(item: compiler.ItemDoc) -> compiler.ItemDoc {
    var text_of = item.text
    if item.kind == "const" {
        text_of = text.cut(item.text, " = ").before
    }
    compiler.ItemDoc { kind: item.kind, name: item.name, receiver: item.receiver, text: text_of, doc: item.doc, file: "", line: 0 }
}

fn os_dependent_modules(modules: []*compiler.ModuleDoc) -> [str: bool] {
    var dependent: [str: bool] = ["std/sys": true]
    var changed = true
    for changed {
        changed = false
        for module in modules {
            if dependent[module.path] != none {
                continue
            }
            for imp in module.imports {
                if dependent[imp.path] != none {
                    dependent[module.path] = true
                    changed = true
                    break
                }
            }
        }
    }
    dependent
}

fn documented_api(modules: []*compiler.ModuleDoc, skipped: [str: bool]) -> [str: compiler.ItemDoc] {
    var api: [str: compiler.ItemDoc] = [:]
    for module in modules {
        if skipped[module.path] != none {
            continue
        }
        for item in module.items {
            api[api_key(module, item)] = api_item(item)
        }
    }
    api
}

fn test_std_targets_share_api(t: *testing.T) {
    let linux_modules = documented(t, "std", target.OS.Linux)
    for os in target.all() {
        if os == target.OS.Linux {
            continue
        }
        let modules = documented(t, "std", os)
        var skipped: [str: bool] = [:]
        if !target.has_os(os) {
            skipped = os_dependent_modules(modules)
        }
        compare_api(t, documented_api(linux_modules, skipped), documented_api(modules, skipped), target.string(os))
    }
}

fn compare_api(t: *testing.T, linux: [str: compiler.ItemDoc], other_api: [str: compiler.ItemDoc], name: str) {
    for key in linux {
        let item = linux[key] ?? panic("key without an item")
        match other_api[key] {
            some(other) => {
                if !same_item(other, item) {
                    t.error("{key} differs between targets:\nlinux: {text.quote("{item.text} {item.doc}")}\n{name}: {text.quote("{other.text} {other.doc}")}")
                }
            }
            none => t.error("{key} is missing on {name}")
        }
    }
    for key in other_api {
        match linux[key] {
            some(_) => {}
            none => t.error("{key} is missing on linux, present on {name}")
        }
    }
}

fn check_doc(u: *Undocumented, doc: str, pos: diag.Pos, name: str) {
    if doc == "" {
        push(mut u.missing, "{diag.text(pos)}: {name}")
        return
    }
    for line in text.split(doc, '\n') {
        if text.starts_with(text.trim(line), "///") {
            push(mut u.malformed, "{diag.text(pos)}: {name}")
            return
        }
    }
}

fn check_file(u: *Undocumented, f: *ast.File) {
    for s in f.structs {
        if !s.exported {
            continue
        }
        check_doc(u, s.doc, s.pos, s.name)
        for field in s.fields {
            if field.exported {
                check_doc(u, field.doc, field.pos, "{s.name}.{field.name}")
            }
        }
    }
    for e in f.enums {
        if !e.exported {
            continue
        }
        check_doc(u, e.doc, e.pos, e.name)
        for v in e.variants {
            check_doc(u, v.doc, v.pos, "{e.name}.{v.name}")
        }
    }
    for k in f.consts {
        if k.exported {
            check_doc(u, k.doc, k.pos, k.name)
        }
    }
    for fn_decl in f.funcs {
        if fn_decl.exported {
            check_doc(u, fn_decl.doc, fn_decl.pos, fn_decl.name)
        }
    }
    for e in f.externs {
        for fn_decl in e.funcs {
            if fn_decl.exported {
                check_doc(u, fn_decl.doc, fn_decl.pos, fn_decl.name)
            }
        }
    }
}

fn test_std_documented(t: *testing.T) {
    let u = new(Undocumented { missing: [], malformed: [] })
    let files = embed_dir("../../../std")
    for name in files {
        if !text.ends_with(name, ".low") {
            continue
        }
        let source = files[name] ?? ""
        let parsed = compiler.parse_source(source, "std/{name}", true) catch {
            e => {
                t.fatal(compiler.message(e))
                return
            }
        }
        check_file(u, parsed)
    }
    if u.missing.len > 0 {
        t.error("{u.missing.len} public std items have no /// doc:\n{text.join(u.missing, "\n")}")
    }
    if u.malformed.len > 0 {
        t.error("{u.malformed.len} public std docs have a line starting with a second ///:\n{text.join(u.malformed, "\n")}")
    }
}
