import ir
import std/builder
import std/regex
import std/testing
import std/text

struct SwitchCase {
    name: str
    keys: []i64
    extra: str
    tables: i64
    lt: i64
    eq: i64
}

struct IndexCase {
    name: str
    indexes: []i64
    tables: i64
    eq: i64
    add: i64
}

fn switch_program(keys: []i64, extra: str) -> str {
    var b = builder.builder()
    b.write("fn pick(n: i64) -> i64 {{\n    match n {{\n")
    for i, k in keys {
        b.write("        {k} => {i},\n")
    }
    b.write(extra)
    b.write("        _ => -1\n    }}\n}}\n\nfn main() {{\n    print(pick(1))\n}}\n")
    b.to_str()
}

fn count_ops(t: *testing.T, body: str, op: str) -> i64 {
    let re = pattern(t, " = {op}[: ]")
    regex.find_all(re, body).len
}

fn count_tables(body: str) -> i64 {
    text.count(body, "  switch ")
}

fn sequence(first: i64, count: i64, step: i64) -> []i64 {
    var out: []i64 = []
    for i in 0..count {
        push(mut out, first + i * step)
    }
    out
}

fn with_key(keys: []i64, extra: i64) -> []i64 {
    var out = keys
    push(mut out, extra)
    out
}

fn switch_cases() -> []SwitchCase {
    let dense = sequence(1, 12, 1)
    let duplicated = with_key(dense, 2)
    [
        SwitchCase { name: "eleven dense keys stay linear", keys: sequence(1, 11, 1), extra: "", tables: 0, lt: 0, eq: 11 }
        SwitchCase { name: "twelve dense keys use a table", keys: sequence(1, 12, 1), extra: "", tables: 1, lt: 0, eq: 0 }
        SwitchCase { name: "shuffled keys use a table", keys: [5, 1, 9, 3, 7, 2, 8, 4, 6, 0, 11, 10], extra: "", tables: 1, lt: 0, eq: 0 }
        SwitchCase { name: "gaps inside the span use a table", keys: sequence(0, 12, 2), extra: "", tables: 1, lt: 0, eq: 0 }
        SwitchCase { name: "negative keys use a table", keys: sequence(-6, 12, 1), extra: "", tables: 1, lt: 0, eq: 0 }
        SwitchCase { name: "forty-seven sparse keys stay linear", keys: sequence(0, 47, 100), extra: "", tables: 0, lt: 0, eq: 47 }
        SwitchCase { name: "forty-eight sparse keys use a tree", keys: sequence(0, 48, 100), extra: "", tables: 0, lt: 15, eq: 48 }
        SwitchCase { name: "duplicate key stays linear", keys: duplicated, extra: "", tables: 0, lt: 0, eq: 13 }
        SwitchCase { name: "test arm stays linear", keys: sequence(1, 12, 1), extra: "        % 10 == 0 => 99,\n", tables: 0, lt: 0, eq: 13 }
    ]
}

fn test_switch_lowering(t: *testing.T) {
    t.table_of(switch_cases(), fn(c: SwitchCase) -> str { c.name }, fn(st: *testing.T, c: SwitchCase) {
        let source = switch_program(c.keys, c.extra)
        let prog = dev_program(st, source)
        let body = ir.text(function(st, prog, "pick"))
        let tables = count_tables(body)
        if tables != c.tables {
            st.error("tables {tables}, want {c.tables}\n{body}")
        }
        let lt = count_ops(st, body, "lt")
        if lt != c.lt {
            st.error("lt compares {lt}, want {c.lt}")
        }
        let eq = count_ops(st, body, "eq")
        if eq != c.eq {
            st.error("eq compares {eq}, want {c.eq}")
        }
    })
}

fn test_switch_tables_enum_tags(t: *testing.T) {
    var src = builder.builder()
    src.write("enum Op {{\n")
    for i in 0..13 {
        src.write("    V{i}\n")
    }
    src.write("}}\n\nfn pick(op: Op) -> i64 {{\n    match op {{\n")
    for i in 0..13 {
        src.write("        V{i} => {i}\n")
    }
    src.write("    }}\n}}\n\nfn main() {{\n    print(pick(V3))\n}}\n")
    let prog = dev_program(t, src.to_str())
    let body = ir.text(function(t, prog, "pick"))
    let tables = count_tables(body)
    if tables != 1 {
        t.error("tables {tables}, want 1\n{body}")
    }
}

fn index_program(indexes: []i64) -> str {
    var src = builder.builder()
    src.write("enum Op {{\n")
    for i, value in indexes {
        src.write("    V{i} = {value},\n")
    }
    src.write("}}\n\nfn pick(op: Op) -> i64 {{\n    op.index\n}}\n\nfn main() {{\n    print(pick(V0))\n}}\n")
    src.to_str()
}

fn index_cases() -> []IndexCase {
    let sixteen = sequence(0, 16, 1)
    let one_missing = with_key(sixteen, -1)
    let two_missing = with_key(one_missing, -1)
    [
        IndexCase { name: "indexes equal to tags read the tag", indexes: sequence(0, 5, 1), tables: 0, eq: 0, add: 0 }
        IndexCase { name: "indexes offset from tags add a constant", indexes: sequence(10, 5, 1), tables: 0, eq: 0, add: 1 }
        IndexCase { name: "shared indexes default to the largest group", indexes: [5, 9, 5, 5], tables: 0, eq: 1, add: 0 }
        IndexCase { name: "many distinct indexes use a table", indexes: two_missing, tables: 1, eq: 0, add: 0 }
    ]
}

fn test_enum_index_lowering(t: *testing.T) {
    t.table_of(index_cases(), fn(c: IndexCase) -> str { c.name }, fn(st: *testing.T, c: IndexCase) {
        let source = index_program(c.indexes)
        let prog = dev_program(st, source)
        let body = ir.text(function(st, prog, "pick"))
        let tables = count_tables(body)
        if tables != c.tables {
            st.error("tables {tables}, want {c.tables}\n{body}")
        }
        let eq = count_ops(st, body, "eq")
        if eq != c.eq {
            st.error("eq compares {eq}, want {c.eq}\n{body}")
        }
        let add = count_ops(st, body, "add")
        if add != c.add {
            st.error("adds {add}, want {c.add}\n{body}")
        }
    })
}

fn test_switch_folds_constant_subject(t: *testing.T) {
    let keys = sequence(1, 12, 1)
    let source = switch_program(keys, "")
    let prog = release_program(t, source)
    let body = ir.text(function(t, prog, "main"))
    let tables = count_tables(body)
    if tables != 0 {
        t.error("tables in main {tables}, want 0\n{body}")
    }
}
