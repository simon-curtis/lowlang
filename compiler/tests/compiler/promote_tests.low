import ir
import std/testing
import std/text

fn test_inlined_mut_callee_loses_slot(t: *testing.T) {
    let prog = release_program(t, embed("programs/promote_rot.txt"))
    let entry = function(t, prog, "main")
    if entry.slots.len != 0 {
        t.fatal("slots remain: {testing.format(entry.slots)}")
    }
    let body = ir.text(entry)
    for op in [" = load ", " = store ", " = slot "] {
        if text.contains(body, op) {
            t.fatal("main still contains{op}:\n{body}")
        }
    }
    let asm = function_asm(t, prog, "main")
    if text.contains(asm, "[rbp") {
        t.fatal("main addresses the frame:\n{asm}")
    }
}

fn test_escaping_slot_stays(t: *testing.T) {
    let prog = dev_program(t, embed("programs/promote_rot.txt"))
    let core = function(t, prog, "core")
    if core.slots.len != 2 {
        t.fatal("want 2 slots passed to rot, got {testing.format(core.slots)}")
    }
    if !text.contains(ir.text(core), " = load ") {
        t.fatal("loads after the call were removed:\n{ir.text(core)}")
    }
}

fn test_conditional_stores_become_phis(t: *testing.T) {
    let prog = release_program(t, embed("programs/promote_branch.txt"))
    let entry = function(t, prog, "main")
    let body = ir.text(entry)
    if entry.slots.len != 0 {
        t.fatal("slots remain: {testing.format(entry.slots)}\n{body}")
    }
    if !text.contains(body, " = phi ") {
        t.fatal("expected phis:\n{body}")
    }
}

fn test_c_struct_slot_stays(t: *testing.T) {
    let prog = release_program(t, embed("programs/promote_cstruct.txt"))
    let entry = function(t, prog, "main")
    let body = ir.text(entry)
    if entry.slots.len == 0 {
        t.fatal("extern struct slot was promoted:\n{body}")
    }
    if !text.contains(body, " = load ") {
        t.fatal("extern struct field loads were removed:\n{body}")
    }
}

fn test_select_box_stays(t: *testing.T) {
    let prog = release_program(t, embed("programs/promote_select.txt"))
    let entry = function(t, prog, "main")
    if entry.slots.len == 0 {
        t.fatal("select box slot was promoted:\n{ir.text(entry)}")
    }
}

fn test_multi_word_slot_promoted(t: *testing.T) {
    let prog = release_program(t, embed("programs/promote_wide.txt"))
    let entry = function(t, prog, "main")
    if entry.slots.len != 0 {
        t.fatal("slots remain: {testing.format(entry.slots)}\n{ir.text(entry)}")
    }
}

fn test_inlined_raw_load_keeps_trap(t: *testing.T) {
    let prog = release_program(t, embed("programs/promote_raw.txt"))
    let entry = function(t, prog, "main")
    if !text.contains(ir.text(entry), " = load ") {
        t.fatal("inlined unused load was discarded:\n{ir.text(entry)}")
    }
}
