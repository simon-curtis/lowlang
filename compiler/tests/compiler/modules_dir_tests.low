import compiler
import native
import target
import std/path
import std/testing
import std/text

fn modules_project(t: *testing.T, dir: str, build_file: str) {
    write_modules_file(t, "{dir}/build.low", build_file)
    write_modules_file(t, "{dir}/src/app/main.low", "import lib_a\nimport lib_b\n\nfn main() {{\n    print(lib_a.count(lib_b.make()))\n}}\n")
    write_modules_file(t, "{dir}/src/lib_a/item.low", "pub struct Item {{\n    pub n: i64\n}}\n\npub fn count(i: Item) -> i64 {{\n    i.n\n}}\n")
    write_modules_file(t, "{dir}/src/lib_b/make.low", "import lib_a\n\npub fn make() -> lib_a.Item {{\n    lib_a.Item {{ n: 7 }}\n}}\n")
    write_modules_file(t, "{dir}/src/lib_a/item_test.low", "import lib_b\nimport std/testing\n\nfn test_item_from_a_sibling(t: *testing.T) {{\n    testing.equal(t, count(lib_b.make()), 7)\n}}\n")
    write_modules_file(t, "{dir}/scripts/tool_test.low", "import std/testing\n\nfn test_tool(t: *testing.T) {{\n}}\n")
}

fn write_modules_file(t: *testing.T, location: str, contents: str) {
    make_dir(t, path.dir(location))
    write_text(t, location, contents)
}

fn checked_message(dir: str, entry: str) -> str {
    let docs = native.overlay()
    compiler.check("{dir}/{entry}", target.host(), docs) catch {
        e => {
            return compiler.message(e)
        }
    }
    ""
}

fn tested_message(dir: str, module_dir: str) -> str {
    let docs = native.overlay()
    compiler.check_tests("{dir}/{module_dir}", target.host(), docs) catch {
        e => {
            return compiler.message(e)
        }
    }
    ""
}

fn test_modules_dir_places_the_projects_own_imports(t: *testing.T) {
    let dir = make_temp_dir(t)
    defer remove_dir(dir)
    modules_project(t, dir, "import std/build\n\nbuild.modules(\"src\")\n")
    let _ = t.equal(checked_message(dir, "src/app"), "")
    write_modules_file(t, "{dir}/src/app/more.low", "import lib_c\n")
    let got = checked_message(dir, "src/app")
    t.is_true(text.contains(got, "cannot find module lib_c in {dir}/src/lib_c"))
}

fn test_modules_dir_is_only_what_the_declaration_says(t: *testing.T) {
    let dir = make_temp_dir(t)
    defer remove_dir(dir)
    modules_project(t, dir, "import std/build\n")
    let got = checked_message(dir, "src/app")
    t.is_true(text.contains(got, "cannot find module lib_a in {dir}/lib_a"))
}

fn test_modules_dir_names_a_tested_module_by_its_import_path(t: *testing.T) {
    let dir = make_temp_dir(t)
    defer remove_dir(dir)
    modules_project(t, dir, "import std/build\n\nbuild.modules(\"src\")\n")
    t.equal(tested_message(dir, "src/lib_a"), "")
}

fn test_modules_dir_rejects_a_tested_directory_outside_it(t: *testing.T) {
    let dir = make_temp_dir(t)
    defer remove_dir(dir)
    modules_project(t, dir, "import std/build\n\nbuild.modules(\"src\")\n")
    let outside = tested_message(dir, "scripts")
    let _ = t.is_true(text.contains(outside, "scripts: outside the modules directory {dir}/src"))
    let itself = tested_message(dir, "src")
    t.is_true(text.contains(itself, "src: outside the modules directory {dir}/src"))
}

fn test_modules_dir_holds_no_other_project_root(t: *testing.T) {
    for marker in ["low.mod", "build.low"] {
        let dir = make_temp_dir(t)
        defer remove_dir(dir)
        modules_project(t, dir, "import std/build\n\nbuild.modules(\"src\")\n")
        write_modules_file(t, "{dir}/main.low", "fn main() {{\n}}\n")
        write_modules_file(t, "{dir}/src/{marker}", "")
        let want = "src/{marker} marks another project root inside the modules directory"
        let got = checked_message(dir, "main.low")
        if !text.contains(got, want) {
            t.error("{marker}: got {got}, want {want}")
        }
    }
}

fn dependency_tree(t: *testing.T, dir: str, dependency_build: str) {
    write_modules_file(t, "{dir}/build.low", "import std/build\n\nbuild.dep(\"example.com/ui\", \"^1.0\")\n")
    write_modules_file(t, "{dir}/main.low", "import example.com/ui\nimport example.com/ui/text\n\nprint(ui.title + text.label)\n")
    let tree = compiler.cached_dir("{dir}/cache", "example.com/ui", dependency_commit)
    write_modules_file(t, "{tree}/build.low", dependency_build)
    write_modules_file(t, "{tree}/lib/ui.low", "import text\n\npub const title = \"ui \"\n\npub fn labelled() -> str {{\n    text.label\n}}\n")
    write_modules_file(t, "{tree}/lib/text/text.low", "pub const label = \"text\"\n")
    write_modules_file(t, "{dir}/build.lock", "example.com/ui v1.0.0 {dependency_commit} {dependency_hash}\n")
}

fn test_dependency_modules_dir_places_its_imports(t: *testing.T) {
    let dir = make_temp_dir(t)
    defer remove_dir(dir)
    dependency_tree(t, dir, "import std/build\n\nbuild.modules(\"lib\")\nbuild.gui(\"app\")\nbuild.program(\"../tool\")\n")
    let _ = t.is_true(text.contains(check_dependent(dir), "program takes a directory inside the project, not \"../tool\""))
    dependency_tree(t, dir, "import std/build\n\nbuild.modules(\"lib\")\nbuild.gui(\"app\")\n")
    t.equal(check_dependent(dir), "")
}

fn test_dependency_without_a_modules_dir_keeps_its_root(t: *testing.T) {
    let dir = make_temp_dir(t)
    defer remove_dir(dir)
    dependency_tree(t, dir, "import std/build\n")
    let got = check_dependent(dir)
    t.is_true(text.contains(got, "cannot find module"))
}

fn test_dependency_modules_dir_holds_no_other_project_root(t: *testing.T) {
    let dir = make_temp_dir(t)
    defer remove_dir(dir)
    dependency_tree(t, dir, "import std/build\n\nbuild.modules(\"lib\")\n")
    let tree = compiler.cached_dir("{dir}/cache", "example.com/ui", dependency_commit)
    write_modules_file(t, "{tree}/lib/low.mod", "")
    t.is_true(text.contains(check_dependent(dir), "lib/low.mod marks another project root inside the modules directory"))
}
