import ir
import std/testing
import std/text

fn test_inlines_callee_with_slot(t: *testing.T) {
    let prog = release_program(t, embed("programs/slot_callee.txt"))
    if has_function(prog, "label") {
        t.error("label is still reachable")
    }
    let entry = function(t, prog, "main")
    let entry_text = ir.text(entry)
    if text.contains(entry_text, " call label ") {
        t.error("main still calls label:\n{entry_text}")
    }
    if !text.contains(entry_text, "slots=[3 3]") {
        t.error("main did not take label's frame slots:\n{entry_text}")
    }
}

fn test_append_str_inlined_and_promoted(t: *testing.T) {
    let prog = release_program(t, embed("programs/interpolation.txt"))
    let entry = function(t, prog, "main")
    let entry_text = ir.text(entry)
    if text.contains(entry_text, " call __append_str ") {
        t.error("main still calls __append_str:\n{entry_text}")
    }
    let main_asm = function_asm(t, prog, "main")
    if text.contains(main_asm, "call fn___append_str") {
        t.error("main's asm still calls fn___append_str")
    }
    if entry.slots.len != 0 {
        t.error("main keeps frame slots {testing.format(entry.slots)}:\n{entry_text}")
    }
}

fn test_dev_inlines_nothing(t: *testing.T) {
    let prog = dev_program(t, embed("programs/slot_callee.txt"))
    let entry = function(t, prog, "main")
    if !text.contains(ir.text(entry), " call label ") {
        t.error("a dev build inlined label:\n{ir.text(entry)}")
    }
    if entry.slots.len != 0 {
        t.error("main has slots {testing.format(entry.slots)}")
    }
}

fn test_devirtualised_site_inlined(t: *testing.T) {
    let prog = release_program(t, embed("programs/devirtualised.txt"))
    let entry = function(t, prog, "main")
    let entry_text = ir.text(entry)
    for name in ["run", "double", "negate", "double..value", "negate..value"] {
        if text.contains(entry_text, " call {name} ") {
            t.error("main still calls {name}:\n{entry_text}")
        }
    }
    let indirect = pattern(t, indirect_call)
    let body = function_asm(t, prog, "main")
    let lines = asm_lines(body)
    if any_match(indirect, lines) {
        t.error("main still makes an indirect call:\n{body}")
    }
}
