import ir
import std/math
import std/regex
import std/testing
import std/text

struct Literal {
    name: str
    want: str
}

struct Rotation {
    name: str
    width: str
}

fn backend_asm(t: *testing.T, name: str) -> []str {
    let prog = dev_program(t, embed("programs/backend.txt"))
    let body = function_asm(t, prog, name)
    asm_lines(body)
}

fn dword_arithmetic(t: *testing.T) -> regex.Regex {
    pattern(t, "^(add|sub|imul|shl|lea) (e[a-z]{{2}}|r\\d+d),")
}

fn self_extend(t: *testing.T) -> regex.Regex {
    pattern(t, "^mov (e[a-z]{{2}}|r\\d+d), (e[a-z]{{2}}|r\\d+d)$")
}

fn test_unused_load_is_removed(t: *testing.T) {
    let prog = dev_program(t, embed("programs/backend.txt"))
    let f = function(t, prog, "first_unused")
    for b in f.blocks {
        for v in b.values {
            if v.op == ir.Op.OpLoad {
                t.error("load of an unused element survives in block {b.id}:\n{ir.text(f)}")
            }
        }
    }
}

fn test_unsigned_32_bit_arithmetic_uses_dword_forms(t: *testing.T) {
    let dword_form = dword_arithmetic(t)
    let extend_form = self_extend(t)
    for name in ["add32", "mix32"] {
        let lines = backend_asm(t, name)
        var dword = 0
        for line in lines {
            if regex.is_match(extend_form, line) {
                t.error("{name} moves between 32-bit registers: {line}")
            }
            if regex.is_match(dword_form, line) {
                dword += 1
            }
        }
        if dword == 0 {
            t.error("{name} has no 32-bit arithmetic:\n{joined(lines)}")
        }
    }
}

fn test_unsigned_32_bit_add_uses_no_address_size_prefix(t: *testing.T) {
    let lines = backend_asm(t, "add32")
    if !contains_line(lines, "lea eax, [rdi+rsi]") {
        t.error("add32 is not one lea with 64-bit address registers:\n{joined(lines)}")
    }
}

fn test_widening_conversion_needs_no_normalisation(t: *testing.T) {
    let dword_form = dword_arithmetic(t)
    let extend_form = self_extend(t)
    let lines = backend_asm(t, "widen")
    for line in lines {
        if regex.is_match(dword_form, line) || regex.is_match(extend_form, line) {
            t.error("widening a u32 touches a 32-bit register: {line}")
        }
    }
}

fn test_shift_pair_becomes_rotate(t: *testing.T) {
    let rotations = [Rotation { name: "rotl32", width: "rol e" }, Rotation { name: "rotr64", width: "rol r" }]
    for rotation in rotations {
        let lines = backend_asm(t, rotation.name)
        if count_prefix(lines, rotation.width) != 1 {
            t.error("{rotation.name} does not use one \"{rotation.width}\":\n{joined(lines)}")
        }
        if count_prefix(lines, "shr ") + count_prefix(lines, "shl ") != 0 {
            t.error("{rotation.name} keeps its shifts:\n{joined(lines)}")
        }
    }
}

fn test_shift_pair_that_does_not_cover_the_width_is_not_a_rotate(t: *testing.T) {
    let lines = backend_asm(t, "shifted_pair")
    if count_prefix(lines, "rol ") != 0 {
        t.error("shifts 7 and 24 of a 32-bit word are not a rotate:\n{joined(lines)}")
    }
}

fn test_literal_comparison_is_inline(t: *testing.T) {
    let literals = [Literal { name: "is_get", want: "cmp word ptr [rdi], 0x4547" }, Literal { name: "is_empty", want: "cmp rsi, 0" }]
    for literal in literals {
        let lines = backend_asm(t, literal.name)
        if !contains_line(lines, literal.want) {
            t.error("{literal.name} lacks \"{literal.want}\":\n{joined(lines)}")
        }
    }
    for name in ["is_get", "is_empty"] {
        let lines = backend_asm(t, name)
        if contains_line(lines, "call rt_str_eq") {
            t.error("{name} calls rt_str_eq")
        }
    }
    let long_lines = backend_asm(t, "is_long")
    if !contains_line(long_lines, "call rt_str_eq") {
        t.error("a literal over the inline limit is compared inline")
    }
}

fn test_string_comparison_checks_lengths_before_calling(t: *testing.T) {
    let lines = backend_asm(t, "same")
    var call = -1
    for i, line in lines {
        if line == "call rt_str_eq" {
            call = i
        }
    }
    if call < 3 || lines[call - 2] != "cmp rsi, rcx" || !text.starts_with(lines[call - 1], "jne ") {
        t.error("the call is not guarded by a length comparison:\n{joined(lines)}")
    }
}

fn test_grow_keeps_scalars_in_caller_saved_registers(t: *testing.T) {
    let grow_call = pattern(t, "^call rt_grow_(scan|noscan)$")
    let spill = pattern(t, register_spill)
    let lines = backend_asm(t, "collect")
    var grows = 0
    for i, line in lines {
        if !regex.is_match(grow_call, line) {
            continue
        }
        grows += 1
        for around in lines[math.max(0, i - 12)..i] {
            if regex.is_match(spill, around) {
                t.error("a caller-saved register is spilled around the grow call: {around}\n{joined(lines)}")
            }
        }
    }
    if grows != 1 {
        t.error("{grows} grow calls:\n{joined(lines)}")
    }
}

fn test_compression_loop_keeps_few_frame_operands(t: *testing.T) {
    let source = fixture_source(t, "ra_sha256_pressure")
    let prog = release_program(t, source)
    let lines = function_lines(t, prog, "digest")
    var frame = 0
    for line in lines {
        if text.contains(line, "[rbp-") {
            frame += 1
        }
    }
    if frame > 120 {
        t.error("{frame} instructions address the frame in digest:\n{joined(lines)}")
    }
}

fn first_loop_body(t: *testing.T, lines: []str) -> []str {
    let jump = pattern(t, "^j[a-z]+ (\\.L[.A-Za-z0-9_]+)$")
    for i, line in lines {
        let target = group_of(jump, line, 1) ?? continue
        let at = index_of_line(lines, "{target}:")
        if at >= 0 && at < i {
            return lines[at + 1..i]
        }
    }
    testing.fatal(t, "no loop in\n{joined(lines)}")
    panic("fatal returned")
}

fn is_ymm_memory(operand: str) -> bool {
    text.starts_with(operand, "ymmword ptr [")
}

fn stale_vector_uses(lines: []str) -> []str {
    var problems: []str = []
    var stale: [str: bool] = [:]
    var stored: [str: bool] = [:]
    var after_call = false
    var previous = ""
    for line in lines {
        let last = previous
        previous = line
        if text.ends_with(line, ":") {
            if !text.starts_with(last, "call ") {
                stale = [:]
                stored = [:]
                after_call = false
            }
            continue
        }
        if text.starts_with(line, "call ") {
            after_call = true
            for n in 8..16 {
                stale["ymm{n}"] = true
            }
            continue
        }
        let space = text.index_byte(line, ' ')
        if space < 0 {
            continue
        }
        let mnemonic = line[..space]
        let operands = text.split_str(line[space + 1..], ", ")
        if mnemonic == "vmovdqu" && operands.len == 2 && is_ymm_memory(operands[1]) {
            if after_call && !(stored[operands[1]] ?? false) {
                problems.push("reload without a spill in the block: {line}")
            }
            stale[operands[0]] = false
            continue
        }
        if mnemonic == "vmovdqu" && operands.len == 2 && is_ymm_memory(operands[0]) {
            if stale[operands[1]] ?? false {
                problems.push("spill of a register a call destroyed: {line}")
            }
            stored[operands[0]] = true
            continue
        }
        for k in 1..operands.len {
            if stale[operands[k]] ?? false {
                problems.push("read after a call without a reload: {line}")
            }
        }
        if text.starts_with(operands[0], "ymm") {
            stale[operands[0]] = false
        }
    }
    problems
}

fn test_vector_across_call_is_reloaded_before_it_is_read(t: *testing.T) {
    let prog = dev_program(t, embed("programs/vector_across_call.txt"))
    let lines = function_lines(t, prog, "across.avx2")
    let reload = pattern(t, "^vmovdqu ymm\\d+, ymmword ptr \\[rbp")
    let spill = pattern(t, "^vmovdqu ymmword ptr \\[rbp[^\\]]*\\], ymm\\d+$")
    if count_prefix(lines, "call ") == 0 || count_matches(reload, lines) == 0 || count_matches(spill, lines) == 0 {
        t.error("the loop has no spill, call and reload:\n{joined(lines)}")
    }
    for problem in stale_vector_uses(lines) {
        t.error("{problem}\n{joined(lines)}")
    }
}

fn test_inline_syscall_keeps_vectors_in_registers(t: *testing.T) {
    let prog = release_program(t, embed("programs/vector_across_call.txt"))
    let lines = function_lines(t, prog, "across_syscall.avx2")
    let body = first_loop_body(t, lines)
    if !contains_line(body, "syscall") {
        t.error("the loop has no inline syscall:\n{joined(body)}")
    }
    for line in body {
        if text.contains(line, "[rbp") || text.starts_with(line, "call ") || line == "vzeroupper" {
            t.error("the loop saves vectors around the syscall: {line}\n{joined(body)}")
        }
    }
    for problem in stale_vector_uses(lines) {
        t.error("{problem}\n{joined(lines)}")
    }
}

fn test_vector_accumulator_loop_stays_in_registers(t: *testing.T) {
    let prog = dev_program(t, embed("programs/vector_accumulate.txt"))
    let lines = function_lines(t, prog, "accumulate.avx2")
    let body = first_loop_body(t, lines)
    for line in body {
        if text.contains(line, "[rbp") {
            t.error("the loop addresses the frame: {line}\n{joined(lines)}")
        }
    }
    for want in ["vpminud ymm", "vpaddd ymm"] {
        let found = count_prefix(body, want)
        if found != 1 {
            t.error("{found} {want} instructions in the loop:\n{joined(body)}")
        }
    }
}

struct TierForm {
    function: str
    wanted: []str
}

fn avx512_forms() -> []TierForm {
    [
        TierForm { function: "multiply64", wanted: ["vpmullq ymm"] }
        TierForm { function: "minimum64", wanted: ["vpminsq ymm"] }
        TierForm { function: "maximum_unsigned64", wanted: ["vpmaxuq xmm"] }
        TierForm { function: "shift_signed64", wanted: ["vpsraq ymm"] }
        TierForm { function: "less_unsigned8", wanted: ["vpcmpub k1, ymm0, ymm2, 1", "vpmovm2b ymm0, k1"] }
        TierForm { function: "not_equal32", wanted: ["vpcmpd k1, ymm0, ymm2, 4", "vpmovm2d ymm0, k1"] }
        TierForm { function: "less_equal64", wanted: ["vpcmpq k1, xmm0, xmm2, 2", "vpmovm2q xmm0, k1"] }
        TierForm { function: "select32", wanted: ["vpternlogq ymm0, ymm2, ymm4, 202"] }
        TierForm { function: "invert16", wanted: ["vpternlogd ymm0, ymm0, ymm0, 85"] }
        TierForm { function: "broadcast16", wanted: ["vpbroadcastw ymm8, eax"] }
        TierForm { function: "broadcast64", wanted: ["vpbroadcastq ymm8, rax"] }
        TierForm { function: "mask16", wanted: ["vpmovw2m k1, ymm", "kmovw eax, k1"] }
        TierForm { function: "mask16_narrow", wanted: ["vpmovw2m k1, xmm", "kmovw eax, k1"] }
    ]
}

fn test_avx512_tier_uses_evex_forms(t: *testing.T) {
    let prog = dev_program(t, embed("programs/vector_avx512.txt"))
    for form in avx512_forms() {
        let lines = function_lines(t, prog, "{form.function}.avx512")
        for want in form.wanted {
            if count_prefix(lines, want) == 0 {
                t.error("{form.function}.avx512 has no {want}:\n{joined(lines)}")
            }
        }
    }
}

fn lower_tier_forbidden(want: str) -> str {
    let mnemonic = want[0..text.index_byte(want, ' ')]
    if mnemonic == "and" {
        return ""
    }
    if text.starts_with(mnemonic, "vpbroadcast") {
        return want
    }
    "{mnemonic} "
}

fn test_lower_tiers_have_no_evex_forms(t: *testing.T) {
    let prog = dev_program(t, embed("programs/vector_avx512.txt"))
    var forbidden: []str = []
    for form in avx512_forms() {
        for want in form.wanted {
            let prefix = lower_tier_forbidden(want)
            if prefix != "" {
                forbidden.push(prefix)
            }
        }
    }
    for form in avx512_forms() {
        for tier in ["avx2", "sse2"] {
            let lines = function_lines(t, prog, "{form.function}.{tier}")
            for line in lines {
                for prefix in forbidden {
                    if text.starts_with(line, prefix) {
                        t.error("{form.function}.{tier} has an AVX-512 instruction: {line}")
                    }
                }
            }
        }
    }
}

fn test_vector_stub_dispatches_on_the_tier(t: *testing.T) {
    let prog = dev_program(t, embed("programs/vector_avx512.txt"))
    let lines = function_lines(t, prog, "add32")
    let want = ["cmp byte ptr [rip+rt_simd_tier], 1", "je fn_add32.avx2", "ja fn_add32.avx512", "jmp fn_add32.sse2"]
    for i, line in want {
        if lines.len <= i || lines[i] != line {
            t.error("stub line {i} is not {line}:\n{joined(lines)}")
        }
    }
}
