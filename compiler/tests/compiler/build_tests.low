import amd64
import compiler
import native
import target
import std/file
import std/testing
import std/text

fn build_unit(t: *testing.T, dir: str, unit: *compiler.Unit, output: str) -> native.Built {
    native.build(unit, output) catch {
        e => {
            remove_dir(dir)
            testing.fatal(t, native.message(e))
            panic("fatal returned")
        }
    }
}

fn unsigned_symbols(symbols: [str: i64]) -> [str: u64] {
    var out: [str: u64] = [:]
    for name in symbols {
        out[name] = u64(symbols[name] ?? 0)
    }
    out
}

fn test_hot_build_exposes_the_patch_protocol(t: *testing.T) {
    let dir = make_temp_dir(t)
    let profile = compiler.dev()
    let unit = unit_with(t, embed("programs/hot_source.txt"), profile)
    let built = build_unit(t, dir, unit, "{dir}/app")
    remove_dir(dir)
    for name in [amd64.patch_list_symbol, amd64.patch_count_symbol, amd64.func_table_symbol] {
        match built.symbols[name] {
            some(_) => {}
            none => t.error("image has no {name}")
        }
    }
    let answer = built.funcs["answer"] ?? ""
    if answer == "" {
        t.error("no code recorded for answer in {testing.format(built.funcs)}")
    }
}

fn test_patch_links_at_the_hot_region(t: *testing.T) {
    let dir = make_temp_dir(t)
    let profile = compiler.dev()
    let unit = unit_with(t, embed("programs/hot_source.txt"), profile)
    let built = build_unit(t, dir, unit, "{dir}/app")
    remove_dir(dir)
    let suffix = "_r1_0"
    let table = built.table ?? panic("hot build without a function table")
    let patch = native.patch(built, unit, table, ["answer"], suffix, amd64.hot_base) catch {
        e => {
            t.fatal(native.message(e))
            panic("fatal returned")
        }
    }
    let end = patch.address + patch.code.len
    if patch.address < amd64.hot_base || end > amd64.hot_base + amd64.hot_size {
        t.error("patch at {text.hex(patch.address)} for {patch.code.len} bytes lies outside the hot region")
    }
    match patch.symbols[amd64.symbol("answer", suffix)] {
        some(address) => {
            if address < patch.address || address >= end {
                t.error("patched symbol at {text.hex(address)} outside {text.hex(patch.address)}+{patch.code.len}")
            }
        }
        none => t.error("patched symbol is missing from {testing.format(patch.symbols)}")
    }
    let entries = amd64.func_table_patch_entries(table, ["answer"], suffix, unsigned_symbols(patch.symbols))
    if entries.len != 16 {
        t.error("patch entry is {entries.len} bytes")
    }
}

fn magic_of(platform: target.OS) -> []u8 {
    match platform {
        Linux => [0x7f, 'E', 'L', 'F']
        Windows => ['M', 'Z']
        Browser => [0, 'a', 's', 'm']
    }
}

fn check_linker_for(t: *testing.T, platform: target.OS) {
    let dir = make_temp_dir(t)
    let profile = compiler.release(platform)
    let unit = unit_with(t, embed("programs/hot_source.txt"), profile)
    let output = "{dir}/{target.executable(platform, "app")}"
    build_unit(t, dir, unit, output)
    let image = file.read_file(output) catch {
        e => {
            remove_dir(dir)
            t.fatal("read {output}: {testing.format(e)}")
            return
        }
    }
    remove_dir(dir)
    let magic = magic_of(platform)
    if image.len < magic.len {
        t.fatal("image of {image.len} bytes is shorter than its magic")
    }
    let start = image[..magic.len]
    t.equal_slice(start, magic)
}

fn test_build_chooses_the_linker_from_the_target(t: *testing.T) {
    t.table_of(target.natives(), fn(platform: target.OS) -> str { target.string(platform) }, check_linker_for)
}
