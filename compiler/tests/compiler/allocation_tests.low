import ir
import std/testing
import std/text

fn hoisted_literals(prog: *ir.Program) -> i64 {
    var total = 0
    for f in prog.funcs {
        total += text.count(ir.text(f), " = cell ")
    }
    total
}

fn test_concatenation_chain_allocates_once(t: *testing.T) {
    let prog = dev_program(t, embed("programs/allocation.txt"))
    let f = function(t, prog, "join")
    let grows = count_instructions(f, "rt_grow")
    if grows != 1 {
        t.error("a + b + c + d + e performs {grows} allocations:\n{ir.text(f)}")
    }
}

fn test_interpolation_allocates_once(t: *testing.T) {
    let prog = dev_program(t, embed("programs/allocation.txt"))
    let f = function(t, prog, "label")
    let grows = count_instructions(f, "rt_grow")
    if grows != 1 {
        t.error("interpolation performs {grows} allocations:\n{ir.text(f)}")
    }
}

fn test_captured_immutable_is_not_boxed(t: *testing.T) {
    let prog = dev_program(t, embed("programs/allocation.txt"))
    let by_value = function(t, prog, "counter")
    let counter_allocs = count_instructions(by_value, "rt_alloc")
    if counter_allocs != 1 {
        t.error("counter allocates {counter_allocs} objects, want the environment only:\n{ir.text(by_value)}")
    }
    let boxed = function(t, prog, "bumper")
    let bumper_allocs = count_instructions(boxed, "rt_alloc")
    if bumper_allocs != 2 {
        t.error("bumper allocates {bumper_allocs} objects, want a box and an environment:\n{ir.text(boxed)}")
    }
}

fn test_dev_build_does_not_hoist_literals(t: *testing.T) {
    let prog = dev_program(t, embed("programs/allocation.txt"))
    let hoisted = hoisted_literals(prog)
    if hoisted != 0 {
        t.error("dev build contains {hoisted} hoisted literals")
    }
    if prog.cells != 0 {
        t.error("dev build reserves {prog.cells} cells")
    }
}

fn test_release_build_hoists_constant_literals(t: *testing.T) {
    let prog = release_program(t, embed("programs/allocation.txt"))
    let hoisted = hoisted_literals(prog)
    if hoisted < 2 {
        t.error("release build hoists {hoisted} literals, want the map and the slice")
    }
    if prog.cells < 2 {
        t.error("release build reserves {prog.cells} cells")
    }
}

fn test_unreachable_functions_are_not_built(t: *testing.T) {
    let prog = dev_program(t, embed("programs/allocation.txt"))
    for f in prog.funcs {
        if f.name == "unused" {
            t.fatal("unreachable function {f.name} was built")
        }
    }
}
