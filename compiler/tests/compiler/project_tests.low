import compiler
import native
import target
import std/semver
import std/testing
import std/text

struct RangeCase {
    range: str
    version: str
    accepted: bool
}

struct RejectedManifest {
    name: str
    source: str
    want: str
}

fn test_root_finds_build_file(t: *testing.T) {
    let dir = make_temp_dir(t)
    let nested = "{dir}/a/b"
    make_dir(t, nested)
    let overlay = native.overlay()
    compiler.overlay_put(overlay, "{dir}/build.low", "import std/build\n")
    let found = compiler.root(overlay, nested)
    remove_dir(dir)
    match found {
        some(root) => t.equal(root, dir)
        none => t.error("root not found; want {dir}")
    }
}

fn range_cases() -> []RangeCase {
    [
        RangeCase { range: "^1.2", version: "1.2.0", accepted: true }
        RangeCase { range: "^1.2", version: "1.9.4", accepted: true }
        RangeCase { range: "^1.2", version: "2.0.0", accepted: false }
        RangeCase { range: "^1.2", version: "1.1.9", accepted: false }
        RangeCase { range: "1.2", version: "1.3.0", accepted: true }
        RangeCase { range: "^0.4", version: "0.4.7", accepted: true }
        RangeCase { range: "^0.4", version: "0.5.0", accepted: false }
        RangeCase { range: "^0.0.3", version: "0.0.3", accepted: true }
        RangeCase { range: "^0.0.3", version: "0.0.4", accepted: false }
        RangeCase { range: "^0", version: "0.9.0", accepted: true }
        RangeCase { range: "^0", version: "1.0.0", accepted: false }
        RangeCase { range: "~1.2.3", version: "1.2.9", accepted: true }
        RangeCase { range: "~1.2.3", version: "1.3.0", accepted: false }
        RangeCase { range: "~1", version: "1.8.0", accepted: true }
        RangeCase { range: "=1.2.3", version: "1.2.3", accepted: true }
        RangeCase { range: "=1.2.3", version: "1.2.4", accepted: false }
        RangeCase { range: "^1.2", version: "1.3.0-rc.1", accepted: false }
        RangeCase { range: "=1.3.0-rc.1", version: "1.3.0-rc.1", accepted: true }
    ]
}

fn test_version_ranges(t: *testing.T) {
    for c in range_cases() {
        let range = compiler.parse_range(c.range) ?? {
            t.error("{c.range} did not parse")
            continue
        }
        let version = semver.parse(c.version) catch {
            _ => {
                t.error("{c.version} did not parse")
                continue
            }
        }
        if compiler.accepts(range, version) != c.accepted {
            t.error("{c.range} accepts {c.version}: got {!c.accepted}, want {c.accepted}")
        }
    }
}

fn test_malformed_ranges_do_not_parse(t: *testing.T) {
    for written in ["", "two", "^", "~x", "1.2.3.4", "=1.2", "^-1"] {
        match compiler.parse_range(written) {
            some(_) => t.error("{written} parsed as a range")
            none => {}
        }
    }
}

fn manifest_in(t: *testing.T, source: str) -> *compiler.Manifest ! compiler.Error {
    let overlay = native.overlay()
    let name = "/project/build.low"
    compiler.overlay_put(overlay, name, source)
    compiler.read_manifest(overlay, name)?
}

fn test_manifest_reads_every_declaration(t: *testing.T) {
    let source = "import std/build\n\nbuild.title(\"Test App\")\nbuild.version(\"0.3.0\")\nbuild.dep(\"github.com/acme/ui\", \"^0.4\")\nbuild.local(\"../shared/build.low\")\nbuild.pre_build(\"npm\", [\"install\"])\nbuild.post_build(\"npm\", [\"run\", \"clean\"])\n"
    let m = manifest_in(t, source) catch {
        e => {
            t.fatal(compiler.message(e))
            return
        }
    }
    t.equal(m.title, "Test App")
    t.equal(m.version, "0.3.0")
    t.equal(m.deps.len, 2)
    t.equal(m.deps[0].source, "github.com/acme/ui")
    t.equal(m.deps[0].range, "^0.4")
    t.is_false(m.deps[0].local)
    t.equal(m.deps[1].source, "../shared/build.low")
    t.is_true(m.deps[1].local)
    t.equal(m.pre_build.len, 1)
    t.equal(m.pre_build[0].program, "npm")
    t.equal_slice(m.post_build[0].args, ["run", "clean"])
    t.equal(compiler.local_dir("/work/app", "../shared/build.low"), "/work/shared")
}

fn rejected_manifests() -> []RejectedManifest {
    [
        RejectedManifest { name: "other import", source: "import std/build\nimport std/os\n", want: "imports only std/build, not std/os" }
        RejectedManifest { name: "declaration", source: "import std/build\nfn helper() {{\n}}\n", want: "holds only calls to std/build" }
        RejectedManifest { name: "binding", source: "import std/build\nlet t = \"x\"\nbuild.title(t)\n", want: "holds only calls to std/build" }
        RejectedManifest { name: "variable argument", source: "import std/build\nbuild.pre_build(\"npm\", [\"a\", b])\n", want: "argument is a string literal" }
        RejectedManifest { name: "repeated title", source: "import std/build\nbuild.title(\"a\")\nbuild.title(\"b\")\n", want: "title is already declared" }
        RejectedManifest { name: "unknown declaration", source: "import std/build\nbuild.name(\"a\")\n", want: "std/build has no declaration name" }
        RejectedManifest { name: "arity", source: "import std/build\nbuild.dep(\"a\")\n", want: "dep takes 2 arguments, found 1" }
        RejectedManifest { name: "range", source: "import std/build\nbuild.dep(\"a.com/b\", \"two\")\n", want: "two is not a version range" }
        RejectedManifest { name: "version", source: "import std/build\nbuild.version(\"one\")\n", want: "one is not a semantic version" }
        RejectedManifest { name: "hook arguments", source: "import std/build\nbuild.pre_build(\"npm\", \"install\")\n", want: "a slice of string literals" }
    ]
}

fn test_manifest_rejects_what_it_cannot_read(t: *testing.T) {
    for c in rejected_manifests() {
        manifest_in(t, c.source) catch {
            e => {
                let got = compiler.message(e)
                if !text.contains(got, c.want) {
                    t.error("{c.name}: got {got}, want {c.want}")
                }
                continue
            }
        }
        t.error("{c.name}: read without an error")
    }
}

const dependency_commit = "0123456789abcdef0123456789abcdef01234567"
const dependency_hash = "h1:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="

fn dependent_project(t: *testing.T, dir: str) {
    write_text(t, "{dir}/build.low", "import std/build\n\nbuild.dep(\"example.com/ui\", \"^1.0\")\n")
    write_text(t, "{dir}/main.low", "import example.com/ui\n\nprint(ui.label)\n")
}

fn cached_overlay(dir: str) -> *compiler.Overlay {
    var disk = native.disk()
    disk.cache = "{dir}/cache"
    compiler.new_overlay(disk, native.runner())
}

fn check_dependent(dir: str) -> str {
    let docs = cached_overlay(dir)
    compiler.check("{dir}/main.low", target.host(), docs) catch {
        e => {
            return compiler.message(e)
        }
    }
    ""
}

fn test_dependency_loads_from_the_cache_through_the_lock(t: *testing.T) {
    let dir = make_temp_dir(t)
    defer remove_dir(dir)
    dependent_project(t, dir)
    let tree = compiler.cached_dir("{dir}/cache", "example.com/ui", dependency_commit)
    make_dir(t, tree)
    write_text(t, "{tree}/ui.low", "pub const label = \"blue\"\n")
    write_text(t, "{dir}/build.lock", "example.com/ui v1.0.0 {dependency_commit} {dependency_hash}\n")
    t.equal(check_dependent(dir), "")
}

fn test_dependency_without_a_lock_entry_is_not_fetched(t: *testing.T) {
    let dir = make_temp_dir(t)
    defer remove_dir(dir)
    dependent_project(t, dir)
    let got = check_dependent(dir)
    t.is_true(text.contains(got, "example.com/ui is not fetched; low build, low run and low test fetch it"))
}

fn test_dependency_missing_from_the_cache_is_not_fetched(t: *testing.T) {
    let dir = make_temp_dir(t)
    defer remove_dir(dir)
    dependent_project(t, dir)
    write_text(t, "{dir}/build.lock", "example.com/ui v1.0.0 {dependency_commit} {dependency_hash}\n")
    let got = check_dependent(dir)
    t.is_true(text.contains(got, "example.com/ui is not fetched; low build, low run and low test fetch it"))
}

fn test_lock_lines_are_source_version_commit_and_hash(t: *testing.T) {
    let line = "example.com/ui v1.0.0 {dependency_commit} {dependency_hash}\n"
    let held = compiler.parse_lock(line, "build.lock") catch {
        e => {
            t.fatal("parse: {compiler.message(e)}")
            return
        }
    }
    let entry = held["example.com/ui"] ?? compiler.Locked { source: "", version: "", commit: "", hash: "" }
    t.equal(entry.version, "v1.0.0")
    t.equal(entry.commit, dependency_commit)
    t.equal(entry.hash, dependency_hash)
    t.equal(compiler.format_lock([entry]), line)
}

fn test_lock_lines_with_other_shapes_are_rejected(t: *testing.T) {
    let three = "example.com/ui v1.0.0 {dependency_commit}\n"
    let short = "example.com/ui v1.0.0 abc {dependency_hash}\n"
    let unhashed = "example.com/ui v1.0.0 {dependency_commit} sha256:AAAA\n"
    for line in [three, short, unhashed] {
        compiler.parse_lock(line, "build.lock") catch {
            e => {
                t.is_true(text.starts_with(compiler.message(e), "build.lock:1: "))
                continue
            }
        }
        t.error("parsed {line}")
    }
}
