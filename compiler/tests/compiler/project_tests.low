import compiler
import native
import target
import std/file
import std/semver
import std/testing
import std/text

struct RangeCase {
    range: str
    version: str
    accepted: bool
}

struct RejectedManifest {
    name: str
    source: str
    want: str
}

fn test_root_finds_build_file(t: *testing.T) {
    let dir = make_temp_dir(t)
    let nested = "{dir}/a/b"
    make_dir(t, nested)
    let overlay = native.overlay()
    compiler.overlay_put(overlay, "{dir}/build.low", "import std/build\n")
    let found = compiler.root(overlay, nested)
    remove_dir(dir)
    match found {
        some(root) => t.equal(root, dir)
        none => t.error("root not found; want {dir}")
    }
}

fn range_cases() -> []RangeCase {
    [
        RangeCase { range: "^1.2", version: "1.2.0", accepted: true }
        RangeCase { range: "^1.2", version: "1.9.4", accepted: true }
        RangeCase { range: "^1.2", version: "2.0.0", accepted: false }
        RangeCase { range: "^1.2", version: "1.1.9", accepted: false }
        RangeCase { range: "1.2", version: "1.3.0", accepted: true }
        RangeCase { range: "^0.4", version: "0.4.7", accepted: true }
        RangeCase { range: "^0.4", version: "0.5.0", accepted: false }
        RangeCase { range: "^0.0.3", version: "0.0.3", accepted: true }
        RangeCase { range: "^0.0.3", version: "0.0.4", accepted: false }
        RangeCase { range: "^0", version: "0.9.0", accepted: true }
        RangeCase { range: "^0", version: "1.0.0", accepted: false }
        RangeCase { range: "~1.2.3", version: "1.2.9", accepted: true }
        RangeCase { range: "~1.2.3", version: "1.3.0", accepted: false }
        RangeCase { range: "~1", version: "1.8.0", accepted: true }
        RangeCase { range: "=1.2.3", version: "1.2.3", accepted: true }
        RangeCase { range: "=1.2.3", version: "1.2.4", accepted: false }
        RangeCase { range: "^1.2", version: "1.3.0-rc.1", accepted: false }
        RangeCase { range: "=1.3.0-rc.1", version: "1.3.0-rc.1", accepted: true }
    ]
}

fn test_version_ranges(t: *testing.T) {
    for c in range_cases() {
        let range = compiler.parse_range(c.range) ?? {
            t.error("{c.range} did not parse")
            continue
        }
        let version = semver.parse(c.version) catch {
            _ => {
                t.error("{c.version} did not parse")
                continue
            }
        }
        if compiler.accepts(range, version) != c.accepted {
            t.error("{c.range} accepts {c.version}: got {!c.accepted}, want {c.accepted}")
        }
    }
}

fn test_malformed_ranges_do_not_parse(t: *testing.T) {
    for written in ["", "two", "^", "~x", "1.2.3.4", "=1.2", "^-1"] {
        match compiler.parse_range(written) {
            some(_) => t.error("{written} parsed as a range")
            none => {}
        }
    }
}

fn manifest_in(t: *testing.T, source: str) -> *compiler.Manifest ! compiler.Error {
    let overlay = native.overlay()
    let name = "/project/build.low"
    compiler.overlay_put(overlay, name, source)
    compiler.read_manifest(overlay, name)?
}

fn test_manifest_reads_every_declaration(t: *testing.T) {
    let source = "import std/build\n\nbuild.title(\"Test App\")\nbuild.version(\"0.3.0\")\nbuild.dep(\"github.com/acme/ui\", \"^0.4\")\nbuild.local(\"../shared/build.low\")\nbuild.modules(\"./src\")\nbuild.program(\"tool\")\nbuild.gui(\"./src/app\")\nbuild.gui(\"win\\\\ui\")\nbuild.icon(\"./assets\\\\app.ico\")\nbuild.manifest(\"assets/app.manifest\")\nbuild.file_info(\"CompanyName\", \"Example Ltd\")\nbuild.file_info(\"ProductName\", \"Test App\")\nbuild.pre_build(\"npm\", [\"install\"])\nbuild.post_build(\"npm\", [\"run\", \"clean\"])\n"
    let m = manifest_in(t, source) catch {
        e => {
            t.fatal(compiler.message(e))
            return
        }
    }
    let _ = t.equal(m.title, "Test App")
    let _ = t.equal(m.version, "0.3.0")
    let _ = t.equal(m.deps.len, 2)
    let _ = t.equal(m.deps[0].source, "github.com/acme/ui")
    let _ = t.equal(m.deps[0].range, "^0.4")
    let _ = t.is_false(m.deps[0].local)
    let _ = t.equal(m.deps[1].source, "../shared/build.low")
    let _ = t.is_true(m.deps[1].local)
    let _ = t.equal(m.modules, "src")
    let _ = t.equal(compiler.modules_dir("/project", m), "/project/src")
    let _ = t.equal(m.programs.len, 3)
    let _ = t.equal(m.programs[0].dir, "tool")
    let _ = t.is_false(m.programs[0].gui)
    let _ = t.equal(m.programs[1].dir, "src/app")
    let _ = t.is_true(m.programs[1].gui)
    let _ = t.equal(m.programs[2].dir, "win/ui")
    let _ = t.is_true(m.programs[2].gui)
    let _ = t.equal(m.icon, "assets/app.ico")
    let _ = t.equal(m.app_manifest, "assets/app.manifest")
    let _ = t.equal(m.file_info.len, 2)
    let _ = t.equal(m.file_info[0].key, "CompanyName")
    let _ = t.equal(m.file_info[0].value, "Example Ltd")
    let _ = t.equal(m.file_info[1].key, "ProductName")
    let _ = t.equal(m.pre_build.len, 1)
    let _ = t.equal(m.pre_build[0].program, "npm")
    let _ = t.equal_slice(m.post_build[0].args, ["run", "clean"])
    t.equal(compiler.local_dir("/work/app", "../shared/build.low"), "/work/shared")
}

fn rejected_manifests() -> []RejectedManifest {
    [
        RejectedManifest { name: "other import", source: "import std/build\nimport std/os\n", want: "imports only std/build, not std/os" }
        RejectedManifest { name: "declaration", source: "import std/build\nfn helper() {{\n}}\n", want: "holds only calls to std/build" }
        RejectedManifest { name: "binding", source: "import std/build\nlet t = \"x\"\nbuild.title(t)\n", want: "holds only calls to std/build" }
        RejectedManifest { name: "variable argument", source: "import std/build\nbuild.pre_build(\"npm\", [\"a\", b])\n", want: "argument is a string literal" }
        RejectedManifest { name: "repeated title", source: "import std/build\nbuild.title(\"a\")\nbuild.title(\"b\")\n", want: "title is already declared" }
        RejectedManifest { name: "unknown declaration", source: "import std/build\nbuild.name(\"a\")\n", want: "std/build has no declaration name" }
        RejectedManifest { name: "arity", source: "import std/build\nbuild.dep(\"a\")\n", want: "dep takes 2 arguments, found 1" }
        RejectedManifest { name: "range", source: "import std/build\nbuild.dep(\"a.com/b\", \"two\")\n", want: "two is not a version range" }
        RejectedManifest { name: "version", source: "import std/build\nbuild.version(\"one\")\n", want: "one is not a semantic version" }
        RejectedManifest { name: "repeated program", source: "import std/build\nbuild.program(\"app\")\nbuild.program(\"./app\")\n", want: "app is already declared as a program" }
        RejectedManifest { name: "repeated gui", source: "import std/build\nbuild.gui(\"a/b\")\nbuild.gui(\"a//b/\")\n", want: "a/b is already declared as a program" }
        RejectedManifest { name: "gui and program", source: "import std/build\nbuild.gui(\"app\")\nbuild.program(\"app\")\n", want: "app is already declared as a program" }
        RejectedManifest { name: "parent program", source: "import std/build\nbuild.program(\"../app\")\n", want: "program takes a directory inside the project" }
        RejectedManifest { name: "inner parent", source: "import std/build\nbuild.gui(\"a/../../app\")\n", want: "gui takes a directory inside the project" }
        RejectedManifest { name: "backslash parent", source: "import std/build\nbuild.gui(\"a\\\\..\\\\app\")\n", want: "gui takes a directory inside the project" }
        RejectedManifest { name: "absolute program", source: "import std/build\nbuild.program(\"/app\")\n", want: "program takes a directory relative to the build.low" }
        RejectedManifest { name: "rooted backslash", source: "import std/build\nbuild.gui(\"\\\\app\")\n", want: "gui takes a directory relative to the build.low" }
        RejectedManifest { name: "drive program", source: "import std/build\nbuild.gui(\"C:/app\")\n", want: "gui takes a directory relative to the build.low" }
        RejectedManifest { name: "empty program", source: "import std/build\nbuild.program(\"\")\n", want: "program takes a directory relative to the build.low" }
        RejectedManifest { name: "program arity", source: "import std/build\nbuild.gui()\n", want: "gui takes 1 arguments, found 0" }
        RejectedManifest { name: "modules arity", source: "import std/build\nbuild.modules()\n", want: "modules takes 1 arguments, found 0" }
        RejectedManifest { name: "repeated manifest", source: "import std/build\nbuild.manifest(\"a.manifest\")\nbuild.manifest(\"b.manifest\")\n", want: "manifest is already declared" }
        RejectedManifest { name: "parent manifest", source: "import std/build\nbuild.manifest(\"../a.manifest\")\n", want: "manifest takes a file inside the project" }
        RejectedManifest { name: "absolute manifest", source: "import std/build\nbuild.manifest(\"/a.manifest\")\n", want: "manifest takes a file relative to the build.low" }
        RejectedManifest { name: "repeated file_info key", source: "import std/build\nbuild.file_info(\"Comments\", \"a\")\nbuild.file_info(\"Comments\", \"b\")\n", want: "file_info \"Comments\" is already declared" }
        RejectedManifest { name: "empty file_info key", source: "import std/build\nbuild.file_info(\" \", \"a\")\n", want: "file_info names no key" }
        RejectedManifest { name: "file_info arity", source: "import std/build\nbuild.file_info(\"Comments\")\n", want: "file_info takes 2 arguments, found 1" }
        RejectedManifest { name: "hook arguments", source: "import std/build\nbuild.pre_build(\"npm\", \"install\")\n", want: "a slice of string literals" }
    ]
}

fn test_manifest_rejects_what_it_cannot_read(t: *testing.T) {
    for c in rejected_manifests() {
        manifest_in(t, c.source) catch {
            e => {
                let got = compiler.message(e)
                if !text.contains(got, c.want) {
                    t.error("{c.name}: got {got}, want {c.want}")
                }
                continue
            }
        }
        t.error("{c.name}: read without an error")
    }
}

fn test_modules_default_to_the_project_root(t: *testing.T) {
    let m = manifest_in(t, "import std/build\n\nbuild.title(\"x\")\n") catch {
        e => {
            t.fatal(compiler.message(e))
            return
        }
    }
    let _ = t.equal(m.modules, ".")
    let _ = t.equal(compiler.modules_dir("/project", m), "/project")
    t.equal(compiler.modules_dir("/project", none), "/project")
}

fn project_resources_of(t: *testing.T, dir: str, source: str) -> compiler.Resources ! compiler.Error {
    let overlay = native.overlay()
    compiler.overlay_put(overlay, "{dir}/build.low", source)
    let m = compiler.read_manifest(overlay, "{dir}/build.low")?
    compiler.project_resources(overlay, dir, m)?
}

fn test_project_resources_resolve_version_strings(t: *testing.T) {
    let dir = make_temp_dir(t)
    defer remove_dir(dir)
    write_text(t, "{dir}/app.manifest", "<assembly/>")
    let source = "import std/build\nbuild.version(\"1.4.0-rc.1\")\nbuild.file_info(\"CompanyName\", \"Example Ltd\")\nbuild.file_info(\"ProductVersion\", \"1.4.0.7\")\nbuild.manifest(\"app.manifest\")\n"
    let r = project_resources_of(t, dir, source) catch {
        e => {
            t.fatal(compiler.message(e))
            return
        }
    }
    var got: []str = []
    for s in r.strings {
        got.push("{s.key}={s.value}")
    }
    let _ = t.equal_slice(got, ["FileVersion=1.4.0-rc.1", "ProductVersion=1.4.0.7", "CompanyName=Example Ltd"])
    let held = r.app_manifest ?? return t.fatal("the manifest was not read")
    let _ = t.equal(str(held.data), "<assembly/>")
    t.is_true(r.icon == none)
}

fn test_project_resources_must_be_files(t: *testing.T) {
    let dir = make_temp_dir(t)
    defer remove_dir(dir)
    make_dir(t, "{dir}/assets")
    let cases = [
        RejectedManifest { name: "missing manifest", source: "import std/build\nbuild.manifest(\"missing.manifest\")\n", want: "missing.manifest: no such file" }
        RejectedManifest { name: "directory manifest", source: "import std/build\nbuild.manifest(\"assets\")\n", want: "assets: not a file" }
        RejectedManifest { name: "missing icon", source: "import std/build\nbuild.icon(\"missing.ico\")\n", want: "missing.ico: no such file" }
    ]
    for c in cases {
        project_resources_of(t, dir, c.source) catch {
            e => {
                let got = compiler.message(e)
                if !text.contains(got, c.want) {
                    t.error("{c.name}: got {got}, want {c.want}")
                }
                continue
            }
        }
        t.error("{c.name}: accepted")
    }
}

const dependency_commit = "0123456789abcdef0123456789abcdef01234567"
const dependency_hash = "h1:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="

fn dependent_project(t: *testing.T, dir: str) {
    write_text(t, "{dir}/build.low", "import std/build\n\nbuild.dep(\"example.com/ui\", \"^1.0\")\n")
    write_text(t, "{dir}/main.low", "import example.com/ui\n\nprint(ui.label)\n")
}

fn cached_overlay(dir: str) -> *compiler.Overlay {
    var disk = native.disk()
    disk.cache = "{dir}/cache"
    compiler.new_overlay(disk, native.runner())
}

fn check_dependent(dir: str) -> str {
    check_main(dir, "{dir}/main.low")
}

fn check_main(dir: str, main: str) -> str {
    let docs = cached_overlay(dir)
    compiler.check(main, target.host(), docs) catch {
        e => {
            return compiler.message(e)
        }
    }
    ""
}

fn test_dependency_loads_from_the_cache_through_the_lock(t: *testing.T) {
    let dir = make_temp_dir(t)
    defer remove_dir(dir)
    dependent_project(t, dir)
    let tree = compiler.cached_dir("{dir}/cache", "example.com/ui", dependency_commit)
    make_dir(t, tree)
    write_text(t, "{tree}/ui.low", "pub const label = \"blue\"\n")
    write_text(t, "{dir}/build.lock", "example.com/ui v1.0.0 {dependency_commit} {dependency_hash}\n")
    t.equal(check_dependent(dir), "")
}

fn embedding_dependency(t: *testing.T, dir: str, label: str) -> str {
    dependent_project(t, dir)
    let tree = compiler.cached_dir("{dir}/cache", "example.com/ui", dependency_commit)
    make_dir(t, tree)
    write_text(t, "{tree}/ui.low", "pub fn label() -> str {{\n    {label}\n}}\n")
    write_text(t, "{dir}/main.low", "import example.com/ui\n\nprint(ui.label())\n")
    write_text(t, "{dir}/build.lock", "example.com/ui v1.0.0 {dependency_commit} {dependency_hash}\n")
    write_text(t, "{dir}/secret.txt", "secret")
    tree
}

fn link(t: *testing.T, target_path: str, location: str) {
    file.symlink(target_path, location) catch {
        e => testing.fatal(t, "link {location}: {testing.format(e)}")
    }
}

fn test_dependency_embeds_files_inside_its_tree(t: *testing.T) {
    let dir = make_temp_dir(t)
    defer remove_dir(dir)
    let tree = embedding_dependency(t, dir, "embed(\"assets/blue.txt\")")
    make_dir(t, "{tree}/assets")
    write_text(t, "{tree}/assets/blue.txt", "blue")
    let _ = t.equal(check_dependent(dir), "")
    let _ = embedding_dependency(t, dir, "embed_dir(\"assets\")[\"blue.txt\"] ?? \"\"")
    t.equal(check_dependent(dir), "")
}

fn test_dependency_cannot_embed_a_relative_path_out_of_its_tree(t: *testing.T) {
    let dir = make_temp_dir(t)
    defer remove_dir(dir)
    let _ = embedding_dependency(t, dir, "embed(\"../../../../secret.txt\")")
    let got = check_dependent(dir)
    t.is_true(text.contains(got, "cannot embed ../../../../secret.txt: {dir}/secret.txt is outside the dependency tree"))
}

fn test_dependency_cannot_embed_an_absolute_path_out_of_its_tree(t: *testing.T) {
    let dir = make_temp_dir(t)
    defer remove_dir(dir)
    let _ = embedding_dependency(t, dir, "embed(\"{dir}/secret.txt\")")
    let got = check_dependent(dir)
    t.is_true(text.contains(got, "{dir}/secret.txt is outside the dependency tree"))
}

fn test_dependency_cannot_embed_through_a_symlink_out_of_its_tree(t: *testing.T) {
    let dir = make_temp_dir(t)
    defer remove_dir(dir)
    let tree = embedding_dependency(t, dir, "embed(\"link\")")
    link(t, "{dir}/secret.txt", "{tree}/link")
    let got = check_dependent(dir)
    t.is_true(text.contains(got, "cannot embed link: {tree}/link resolves to {dir}/secret.txt, outside the dependency tree"))
}

fn test_dependency_cannot_embed_a_directory_that_links_out_of_its_tree(t: *testing.T) {
    let dir = make_temp_dir(t)
    defer remove_dir(dir)
    let tree = embedding_dependency(t, dir, "embed_dir(\"assets\")[\"secret.txt\"] ?? \"\"")
    link(t, dir, "{tree}/assets")
    let got = check_dependent(dir)
    t.is_true(text.contains(got, "cannot embed assets: {tree}/assets resolves to {dir}, outside the dependency tree"))
}

fn test_root_project_embeds_files_outside_its_tree(t: *testing.T) {
    let dir = make_temp_dir(t)
    defer remove_dir(dir)
    write_text(t, "{dir}/secret.txt", "secret")
    make_dir(t, "{dir}/app")
    write_text(t, "{dir}/app/main.low", "print(embed(\"../secret.txt\"))\n")
    t.equal(check_main(dir, "{dir}/app/main.low"), "")
}

fn test_local_dependency_embeds_files_outside_its_tree(t: *testing.T) {
    let dir = make_temp_dir(t)
    defer remove_dir(dir)
    write_text(t, "{dir}/secret.txt", "secret")
    make_dir(t, "{dir}/app")
    make_dir(t, "{dir}/shared")
    write_text(t, "{dir}/app/build.low", "import std/build\n\nbuild.local(\"../shared/build.low\")\n")
    write_text(t, "{dir}/app/main.low", "import shared\n\nprint(shared.label())\n")
    write_text(t, "{dir}/shared/build.low", "import std/build\n")
    write_text(t, "{dir}/shared/shared.low", "pub fn label() -> str {{\n    embed(\"../secret.txt\")\n}}\n")
    t.equal(check_main(dir, "{dir}/app/main.low"), "")
}

fn test_dependency_without_a_lock_entry_is_not_fetched(t: *testing.T) {
    let dir = make_temp_dir(t)
    defer remove_dir(dir)
    dependent_project(t, dir)
    let got = check_dependent(dir)
    t.is_true(text.contains(got, "example.com/ui is not fetched; low build, low run and low test fetch it"))
}

fn test_dependency_missing_from_the_cache_is_not_fetched(t: *testing.T) {
    let dir = make_temp_dir(t)
    defer remove_dir(dir)
    dependent_project(t, dir)
    write_text(t, "{dir}/build.lock", "example.com/ui v1.0.0 {dependency_commit} {dependency_hash}\n")
    let got = check_dependent(dir)
    t.is_true(text.contains(got, "example.com/ui is not fetched; low build, low run and low test fetch it"))
}

fn test_lock_lines_are_source_version_commit_and_hash(t: *testing.T) {
    let line = "example.com/ui v1.0.0 {dependency_commit} {dependency_hash}\n"
    let held = compiler.parse_lock(line, "build.lock") catch {
        e => {
            t.fatal("parse: {compiler.message(e)}")
            return
        }
    }
    let entry = held["example.com/ui"] ?? compiler.Locked { source: "", version: "", commit: "", hash: "" }
    let _ = t.equal(entry.version, "v1.0.0")
    let _ = t.equal(entry.commit, dependency_commit)
    let _ = t.equal(entry.hash, dependency_hash)
    t.equal(compiler.format_lock([entry]), line)
}

fn test_lock_lines_with_other_shapes_are_rejected(t: *testing.T) {
    let three = "example.com/ui v1.0.0 {dependency_commit}\n"
    let short = "example.com/ui v1.0.0 abc {dependency_hash}\n"
    let unhashed = "example.com/ui v1.0.0 {dependency_commit} sha256:AAAA\n"
    for line in [three, short, unhashed] {
        compiler.parse_lock(line, "build.lock") catch {
            e => {
                let _ = t.is_true(text.starts_with(compiler.message(e), "build.lock:1: "))
                continue
            }
        }
        t.error("parsed {line}")
    }
}
