import ir
import std/testing
import std/text

fn clones_of(prog: *ir.Program, name: str) -> []*ir.Func {
    var clones: []*ir.Func = []
    for f in prog.funcs {
        if text.starts_with(f.name, "{name}..with") {
            push(mut clones, f)
        }
    }
    clones
}

fn require_direct(t: *testing.T, prog: *ir.Program, f: *ir.Func) {
    let body = ir.text(f)
    if text.contains(body, " call fn(") {
        t.error("{f.name} still calls through a function value:\n{body}")
    }
    let indirect = pattern(t, indirect_call)
    let lines = function_lines(t, prog, f.name)
    if any_match(indirect, lines) {
        t.error("{f.name} still makes an indirect call in its asm")
    }
}

fn test_two_lambdas_cloned(t: *testing.T) {
    let prog = release_program(t, embed("programs/comparators.txt"))
    let clones = clones_of(prog, "insertion")
    if clones.len != 2 {
        t.fatal("got {clones.len} clones of insertion, want 2")
    }
    for clone in clones {
        require_direct(t, prog, clone)
    }
    if has_function(prog, "insertion") {
        t.error("the original insertion is still reachable")
    }
    let entry = function(t, prog, "main")
    let entry_text = ir.text(entry)
    for clone in clones {
        if !text.contains(entry_text, " call {clone.name} ") {
            t.error("main does not call {clone.name}:\n{entry_text}")
        }
    }
}

fn test_dev_clones_nothing(t: *testing.T) {
    let prog = dev_program(t, embed("programs/comparators.txt"))
    let clones = clones_of(prog, "insertion")
    if clones.len != 0 {
        t.error("a dev build cloned insertion {clones.len} times")
    }
}

fn test_capturing_closure_cloned(t: *testing.T) {
    let prog = release_fixture(t, "clone_closures")
    let clones = clones_of(prog, "walk")
    if clones.len != 3 {
        t.fatal("got {clones.len} clones of walk, want 3")
    }
    var captured = 0
    for clone in clones {
        require_direct(t, prog, clone)
        if clone.param_words == 5 {
            captured += 1
        }
    }
    if captured != 2 {
        t.error("got {captured} clones that keep an environment word, want 2")
    }
}

fn test_recursive_clone_calls_itself(t: *testing.T) {
    let prog = release_fixture(t, "clone_closures")
    for clone in clones_of(prog, "walk") {
        let body = ir.text(clone)
        if !text.contains(body, " call {clone.name} ") {
            t.error("{clone.name} does not recurse into itself:\n{body}")
        }
        if text.contains(body, " call walk ") {
            t.error("{clone.name} recurses into the original walk:\n{body}")
        }
    }
}

fn test_unknown_function_value_keeps_original(t: *testing.T) {
    let prog = release_fixture(t, "clone_closures")
    if !has_function(prog, "twice") {
        t.error("twice was removed although pick hands it function values that are not known")
    }
    let clones = clones_of(prog, "twice")
    if clones.len != 3 {
        t.error("got {clones.len} clones of twice, want 3")
    }
}

fn test_clone_budget_is_four_per_function(t: *testing.T) {
    let prog = release_fixture(t, "clone_budget_six")
    let clones = clones_of(prog, "fold")
    if clones.len != 4 {
        t.fatal("got {clones.len} clones of fold, want 4")
    }
    if !has_function(prog, "fold") {
        t.error("the original fold is gone although two call sites still use it")
    }
    let entry = function(t, prog, "main")
    let entry_text = ir.text(entry)
    let calls = text.count(entry_text, " call fold ")
    if calls != 2 {
        t.error("main calls the original fold {calls} times, want 2:\n{entry_text}")
    }
}

fn test_same_code_with_different_environments_cloned(t: *testing.T) {
    let prog = release_program(t, embed("programs/shared_code.txt"))
    let clones = clones_of(prog, "apply")
    if clones.len != 1 {
        t.fatal("got {clones.len} clones of apply, want 1")
    }
    require_direct(t, prog, clones[0])
    if clones[0].param_words != 4 {
        t.error("clone has {clones[0].param_words} parameter words, want 4 with the environment kept")
    }
    if has_function(prog, "apply") {
        t.error("the original apply is still reachable")
    }
}
