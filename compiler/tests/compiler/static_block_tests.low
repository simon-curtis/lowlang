import amd64
import compiler
import ir
import native
import target
import wasm
import std/regex
import std/testing
import std/text

const frame_store = "^\\w+ ((q|d|x)word )?ptr \\[(rbp|rsp)[-+]\\d+\\], "
const retagged_module = "std/other"

fn test_chacha_routines_keep_no_state_in_the_frame(t: *testing.T) {
    let prog = release_program(t, embed("programs/random_state.txt"))
    let store = pattern(t, frame_store)
    let saved = pattern(t, callee_saved_store)
    for name in ["std.crypto.aead.chacha_rounds", "std.crypto.aead.chacha20_blocks"] {
        let body = function_asm(t, prog, name)
        for line in after_prologue(asm_lines(body)) {
            if regex.is_match(store, line) && !regex.is_match(saved, line) {
                t.error("{name} stores to the frame: {line}")
            }
            if text.starts_with(line, "push") && line != "push rbp" {
                t.error("{name} pushes: {line}")
            }
        }
    }
}

fn after_prologue(lines: []str) -> []str {
    for i, line in lines {
        if text.starts_with(line, ".L") && text.ends_with(line, ":") {
            return lines[i..]
        }
    }
    lines
}

fn retag_install(prog: *ir.Program) -> i64 {
    var retagged = 0
    for f in prog.funcs {
        if f.name != "std.crypto.install" {
            continue
        }
        for b in f.blocks {
            for v in b.values {
                if v.op == ir.Op.OpStaticBlock {
                    v.str = retagged_module
                    retagged += 1
                }
            }
        }
    }
    prog.static_blocks = ir.static_blocks(prog.funcs)
    retagged
}

fn test_one_block_per_module_that_asks_for_one(t: *testing.T) {
    let prog = release_program(t, embed("programs/random_state.txt"))
    t.equal_slice(prog.static_blocks, ["std/crypto"])
}

fn test_modules_get_distinct_blocks_on_amd64(t: *testing.T) {
    let prog = release_program(t, embed("programs/random_state.txt"))
    t.is_true(retag_install(prog) > 0)
    t.equal_slice(prog.static_blocks, ["std/crypto", retagged_module])
    let platform = amd64.new_platform(target.OS.Linux)
    let out = amd64.generate(prog, platform, none, false, native.runner())
    for label in ["rt_static_block.std.crypto", "rt_static_block.std.other"] {
        t.equal(text.count(out.asm, "\n{label}:\n\t.zero {ir.static_block_bytes}\n"), 1)
        t.is_true(text.contains(out.asm, "[rip+{label}]"))
    }
}

fn test_modules_get_distinct_blocks_on_wasm(t: *testing.T) {
    let unit = unit_with(t, embed("programs/random_state.txt"), compiler.release(target.OS.Browser))
    let prog = program_of(unit)
    t.is_true(retag_install(prog) > 0)
    let at = wasm.static_block_addresses(prog)
    let first = at["std/crypto"] ?? -1
    let second = at[retagged_module] ?? -1
    t.is_true(first > 0)
    t.equal(second, first + ir.static_block_bytes)
    let image = native.module(unit) catch {
        e => {
            t.fatal(native.message(e))
            return
        }
    }
    t.is_true(image.len > 0)
}
