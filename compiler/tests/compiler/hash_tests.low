import ast
import check
import compiler
import native
import target
import std/builder
import std/process
import std/testing
import std/text

struct LengthPair {
    n: i64
    m: i64
    filler: u8
    x_at: i64
    y_at: i64
    special: u8
}

struct Window {
    blocks: str
    a: u64
    b: u64
}

struct Probe {
    dir: str
    binary: str
}

struct RunResult {
    output: str
    failure: str
}

fn pair_call(p: LengthPair) -> str {
    "    collisions += trial({p.n}, {p.m}, {p.filler}, {p.x_at}, {p.y_at}, {p.special})\n"
}

fn shaped(p: LengthPair, length: i64, at: i64) -> str {
    var b: []u8 = []
    for i in 0..length {
        if i == at {
            push(mut b, p.special)
        } else {
            push(mut b, p.filler)
        }
    }
    str(b)
}

fn pair_strings(p: LengthPair) -> []str {
    [shaped(p, p.n, p.x_at), shaped(p, p.m, p.y_at)]
}

fn block_count(n: i64) -> i64 {
    if n <= 16 {
        return 0
    }
    (n + 15) / 16 - 1
}

fn little_endian(s: str, at: i64) -> u64 {
    var value: u64 = 0
    for i in 0..8 {
        value = value | (u64(s[at + i]) << u64(8 * i))
    }
    value
}

fn window_of(s: str) -> Window {
    let n = s.len
    let k = block_count(n)
    let blocks = s[..16 * k]
    if n >= 16 {
        return Window { blocks, a: little_endian(s, n - 16), b: little_endian(s, n - 8) }
    }
    if n >= 8 {
        return Window { blocks, a: little_endian(s, 0), b: little_endian(s, n - 8) }
    }
    Window { blocks, a: 0, b: 0 }
}

fn length_cancels(x: str, y: str) -> bool {
    let wx = window_of(x)
    let wy = window_of(y)
    x.len != y.len && block_count(x.len) == block_count(y.len) && wx.blocks == wy.blocks && wx.a == wy.a && (wx.b ^ u64(x.len)) == (wy.b ^ u64(y.len))
}

fn length_pairs() -> []LengthPair {
    let filler: u8 = 96
    var pairs: []LengthPair = []
    for n in 8..17 {
        for m in n + 1..17 {
            let d = u8(n ^ m)
            let pair = LengthPair { n, m, filler, x_at: n - 8, y_at: n - 8, special: filler ^ d }
            push(mut pairs, pair)
        }
    }
    for blocks in 1..4 {
        for n in 16 * blocks + 8..16 * blocks + 17 {
            for m in n + 1..16 * blocks + 17 {
                let d = u8(n ^ m)
                let pair = LengthPair { n, m, filler, x_at: n - 8, y_at: -1, special: filler ^ d }
                push(mut pairs, pair)
            }
        }
    }
    pairs
}

fn no_embeds(f: *ast.File, name: str) -> check.Embedded ! check.EmbedError {
    fail check.EmbedError.Missing
}

fn no_embed_dirs(f: *ast.File, name: str) -> []str ! check.EmbedError {
    fail check.EmbedError.Missing
}

fn probe_failed(t: *testing.T, dir: str, message: str) {
    remove_dir(dir)
    t.fatal(message)
}

fn build_probe(t: *testing.T, source: str) -> Probe {
    let dir = make_temp_dir(t)
    let prelude_file = compiler.parse_prelude() catch {
        e => {
            probe_failed(t, dir, compiler.message(e))
            panic("fatal returned")
        }
    }
    let probe_file = compiler.parse_source(source, "probe.low", true) catch {
        e => {
            probe_failed(t, dir, compiler.message(e))
            panic("fatal returned")
        }
    }
    let files = [prelude_file, probe_file]
    let universe = check.check(files, no_embeds, no_embed_dirs) catch {
        e => {
            probe_failed(t, dir, testing.format(e))
            panic("fatal returned")
        }
    }
    let host = target.host()
    let unit = new(compiler.Unit { files, universe, sources: [], embeds: [:], warnings: [] })
    let profile = compiler.release(host)
    let jobs = native.runner()
    compiler.lower(unit, profile, jobs)
    let binary = "{dir}/{target.executable(host, "probe")}"
    native.build(unit, binary) catch {
        e => {
            probe_failed(t, dir, native.message(e))
            panic("fatal returned")
        }
    }
    Probe { dir, binary }
}

fn run_once(binary: str) -> RunResult {
    let out = process.run(process.command(binary, []), []) catch {
        e => return RunResult { output: "", failure: "run {binary}: {testing.format(e)}" }
    }
    if !process.success(out.status) {
        return RunResult { output: "", failure: "{binary} ended with {testing.format(out.status)}: {str(out.stderr)}" }
    }
    RunResult { output: text.trim(str(out.stdout)), failure: "" }
}

fn test_string_hash_ignores_length_cancellation(t: *testing.T) {
    let pairs = length_pairs()
    var calls = builder.builder()
    for p in pairs {
        let strings = pair_strings(p)
        if !length_cancels(strings[0], strings[1]) {
            t.fatal("pair of lengths {p.n} and {p.m} does not cancel the length")
        }
        let call = pair_call(p)
        calls.write(call)
    }
    let first = pair_strings(pairs[0])
    let literal = "a{text.repeat("`", 7)}"
    if first[0] != literal || first[1] != "{literal}`" {
        t.fatal("first pair is {text.quote(first[0])} and {text.quote(first[1])}, want the 8 and 9 byte pair")
    }
    let source = text.replace(embed("programs/hash_probe.txt"), "CALLS", calls.to_str())
    let probe = build_probe(t, source)
    var results: []RunResult = []
    for _ in 0..8 {
        let result = run_once(probe.binary)
        push(mut results, result)
    }
    remove_dir(probe.dir)
    for run, result in results {
        if result.failure != "" {
            t.fatal(result.failure)
        }
        if result.output != "0" {
            t.error("run {run}: {result.output} of {pairs.len} pairs hash the same under a fresh seed")
        }
    }
}
