import std/testing

fn main() {
    testing.run([
        testing.Test { name: "builtins_documented", run: test_builtins_documented }
        testing.Test { name: "builtins_are_complete", run: test_builtins_are_complete }
        testing.Test { name: "ident", run: test_ident }
        testing.Test { name: "public_builtins_reject_wrong_arity", run: test_public_builtins_reject_wrong_arity }
        testing.Test { name: "takes_first_follows_generic_inference", run: test_takes_first_follows_generic_inference }
        testing.Test { name: "spawned_call_is_visited_once", run: test_spawned_call_is_visited_once }
    ])
}
