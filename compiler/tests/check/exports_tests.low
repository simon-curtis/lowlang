import ast
import check
import compiler
import diag
import target
import types
import std/file
import std/testing

const takes_first_source = "struct Point {{\n    x: i64\n}}\n\nfn biggest[T: Ord](xs: []T) -> i64 {{\n    xs.len\n}}\n\nfn lengths[T](xs: []T) -> i64 {{\n    xs.len\n}}\n\nfn keyed[K](m: [str: K]) -> i64 {{\n    m.len\n}}\n\nfn plain(xs: []i64) -> i64 {{\n    xs.len\n}}\n\nfn main() {{\n}}\n"

const spawn_source = "fn work(n: i64) {{\n}}\n\nfn main() {{\n    spawn work(7)\n}}\n"

fn checked_source(t: *testing.T, source: str) -> *compiler.Unit? {
    let dir = file.temp_dir("check-") catch {
        e => {
            t.fatal("{e}")
            return none
        }
    }
    defer file.remove_all(dir) or {}
    let path = file.child_path(dir, "main.low")
    file.write_text(path, source) catch {
        e => {
            t.fatal("{path}: {e}")
            return none
        }
    }
    compiler.check(path, target.OS.Linux) catch {
        e => {
            t.fatal(compiler.message(e))
            return none
        }
    }
}

fn slice_of(t: *testing.T, u: *types.Universe, elem: *types.Type) -> *types.Type {
    types.slice(u, elem) catch {
        e => {
            t.fatal(diag.message(e))
            return elem
        }
    }
}

fn map_of(t: *testing.T, u: *types.Universe, key: *types.Type, value: *types.Type) -> *types.Type {
    types.map(u, key, value) catch {
        e => {
            t.fatal(diag.message(e))
            return value
        }
    }
}

struct TakesFirstCase {
    funcs: [str: *ast.Func]
    name: str
    from: *types.Type
    want: bool
}

fn takes_first_name(c: TakesFirstCase) -> str {
    "{c.name} {c.from.name}"
}

fn takes_first_body(t: *testing.T, c: TakesFirstCase) {
    let func = c.funcs[c.name] ?? return
    t.equal(check.takes_first(func, c.from), c.want)
}

fn declared_funcs(unit: *compiler.Unit) -> [str: *ast.Func] {
    var funcs: [str: *ast.Func] = [:]
    for f in unit.files {
        for decl in f.funcs {
            if ast.declared(decl) {
                funcs[decl.name] = decl
            }
        }
    }
    funcs
}

fn point_type(unit: *compiler.Unit) -> *types.Type? {
    var point: *types.Type? = none
    for f in unit.files {
        for s in f.structs {
            if s.name == "Point" {
                point = s.type
            }
        }
    }
    point
}

fn test_takes_first_follows_generic_inference(t: *testing.T) {
    let unit = checked_source(t, takes_first_source) ?? return
    let funcs = declared_funcs(unit)
    let point = point_type(unit) ?? return
    let u = unit.universe
    let points = slice_of(t, u, point)
    let numbers = slice_of(t, u, u.i64)
    let by_name = map_of(t, u, u.str, point)
    let by_number = map_of(t, u, u.i64, point)
    let cases = [
        TakesFirstCase { funcs, name: "biggest", from: points, want: false }
        TakesFirstCase { funcs, name: "biggest", from: numbers, want: true }
        TakesFirstCase { funcs, name: "biggest", from: point, want: false }
        TakesFirstCase { funcs, name: "lengths", from: points, want: true }
        TakesFirstCase { funcs, name: "lengths", from: point, want: false }
        TakesFirstCase { funcs, name: "keyed", from: by_name, want: true }
        TakesFirstCase { funcs, name: "keyed", from: by_number, want: false }
        TakesFirstCase { funcs, name: "plain", from: numbers, want: true }
        TakesFirstCase { funcs, name: "plain", from: points, want: false }
    ]
    t.table_of(cases, takes_first_name, takes_first_body)
}

struct Counter {
    calls: i64
}

fn named(call: *ast.Call, name: str) -> bool {
    match call.callee {
        Ident(id) => id.name == name
        _ => false
    }
}

fn count_calls(body: *ast.Block, name: str) -> i64 {
    let counter = new(Counter { calls: 0 })
    ast.inspect(ast.Node.Expr(ast.Expr.Block(body)), fn(n: ast.Node) -> bool {
        match n {
            Expr(e) => match e {
                Call(call) => {
                    if named(call, name) {
                        counter.calls += 1
                    }
                }
                _ => {}
            }
            _ => {}
        }
        true
    })
    counter.calls
}

fn test_spawned_call_is_visited_once(t: *testing.T) {
    let unit = checked_source(t, spawn_source) ?? return
    var calls = 0
    for f in unit.files {
        for decl in f.funcs {
            if decl.name != "main" || !ast.declared(decl) {
                continue
            }
            let body = decl.body ?? continue
            calls += count_calls(body, "work")
        }
    }
    if calls != 1 {
        t.error("the spawned call was visited {calls} times, want 1")
    }
}
