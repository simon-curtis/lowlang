import diag
import std/file
import std/slices
import std/testing
import std/text

const codes_heading = "\n### Diagnostic codes\n"

struct Row {
    name: str
    severity: str
    meaning: str
    example: str
}

fn severity_name(s: diag.Severity) -> str {
    match s {
        Error => "error"
        Warning => "warning"
    }
}

fn table_cells(line: str) -> []str {
    var cells: []str = []
    for cell in text.split_str(text.replace(line, "\\|", "\u{1}"), " | ") {
        cells.push(text.replace(text.trim(text.trim_suffix(text.trim_prefix(cell, "|"), "|")), "\u{1}", "|"))
    }
    cells
}

fn documented_codes(t: *testing.T) -> []Row {
    let found = text.cut(read_design(t), codes_heading)
    if !found.found {
        t.fatal("{design_path} has no ### Diagnostic codes section")
        return []
    }
    let section = text.cut(text.cut(found.after, chapter_end).before, section_separator).before
    var rows: []Row = []
    for line in text.split(section, '\n') {
        if !text.starts_with(line, "| `") {
            continue
        }
        let cells = table_cells(line)
        if cells.len != 4 {
            t.error("a Diagnostic codes row has {cells.len} cells, not 4: {line}")
            continue
        }
        rows.push(Row { name: text.trim_suffix(text.trim_prefix(cells[0], "`"), "`"), severity: cells[1], meaning: cells[2], example: cells[3] })
    }
    rows
}

fn is_code(s: str) -> bool {
    if s.len == 0 || s[0] < 'a' || s[0] > 'z' {
        return false
    }
    for i in 0..s.len {
        let c = s[i]
        if !(c >= 'a' && c <= 'z' || c >= '0' && c <= '9' || c == '-') {
            return false
        }
    }
    true
}

fn reporting_calls() -> []str {
    ["At(", "report(", "warn(", "warning(", "error("]
}

fn calls(before: str, callee: str) -> bool {
    var from = 0
    for {
        let at = text.index(before[from..], callee)
        if at < 0 {
            return false
        }
        let start = from + at
        if start == 0 || !is_word_byte(before[start - 1]) {
            return true
        }
        from = start + callee.len
    }
    false
}

fn reports_on(line: str, at: i64) -> bool {
    for callee in reporting_calls() {
        if calls(line[..at], callee) {
            return true
        }
    }
    false
}

fn line_codes(line: str, mut found: [str: str], place: str) {
    var rest = line
    var offset = 0
    for {
        let at = text.index(rest, ", \"")
        if at < 0 {
            return
        }
        let start = at + 3
        let close = text.index_byte(rest[start..], '"')
        if close < 0 {
            return
        }
        let literal = rest[start..start + close]
        let after = rest[start + close + 1..]
        if is_code(literal) && text.starts_with(after, ",") && reports_on(line, offset + at) && found[literal] == none {
            found[literal] = place
        }
        offset += start
        rest = rest[start..]
    }
}

fn emitted_codes(t: *testing.T) -> [str: str] {
    var found: [str: str] = [:]
    let paths = source_paths(t)
    for path in paths {
        let source = file.read_text(path) catch {
            e => {
                t.error("{path}: {e}")
                continue
            }
        }
        for i, line in text.split(source, '\n') {
            line_codes(line, mut found, "{path}:{i + 1}")
        }
    }
    found
}

fn source_paths(t: *testing.T) -> []str {
    var paths: []str = []
    file.walk("compiler", fn(v: file.Visit) -> file.Step {
        if v.dir && v.path == "compiler/tests" {
            return file.Step.Skip
        }
        if v.regular && text.ends_with(v.path, ".low") {
            paths.push(v.path)
        }
        file.Step.Continue
    }) catch {
        e => t.fatal("walking compiler: {e}")
    }
    paths
}

fn test_codes_are_sorted(t: *testing.T) {
    let codes = diag.codes()
    for i in 1..codes.len {
        if codes[i - 1].name >= codes[i].name {
            t.error("diag.codes() lists {codes[i - 1].name} before {codes[i].name}; keep the names sorted and unique")
        }
    }
}

fn test_codes_documented(t: *testing.T) {
    let rows = documented_codes(t)
    var documented: [str: Row] = [:]
    for row in rows {
        documented[row.name] = row
    }
    var table: []str = []
    for code in diag.codes() {
        table.push(code.name)
        match documented[code.name] {
            some(row) => {
                t.equal(row.severity, severity_name(code.severity))
                t.equal(row.meaning, code.meaning)
                t.equal(row.example, code.example)
            }
            none => t.error("code {code.name} has no row in ### Diagnostic codes")
        }
    }
    for row in rows {
        if !slices.contains(table, row.name) {
            t.error("### Diagnostic codes documents {row.name}, which diag.codes() lacks")
        }
    }
}

fn test_codes_emitted(t: *testing.T) {
    let emitted = emitted_codes(t)
    for code, place in emitted {
        if diag.lookup(code) == none {
            t.error("{place} reports code {code}, which has no row in diag.codes()")
        }
    }
    for code in diag.codes() {
        if emitted[code.name] == none {
            t.error("no part of the compiler reports code {code.name}")
        }
    }
}

fn fixture_codes(t: *testing.T, dir: str, suffix: str) {
    let names = file.list(dir) catch {
        e => {
            t.error("{dir}: {e}")
            return
        }
    }
    for name in names {
        if !text.ends_with(name, suffix) {
            continue
        }
        let content = file.read_text("{dir}/{name}") or continue
        for line in text.split(content, '\n') {
            let open = text.last_index(line, " [")
            if open < 0 || !text.ends_with(line, "]") || !text.contains(line, ": ") {
                continue
            }
            let code = line[open + 2..line.len - 1]
            if is_code(code) && diag.lookup(code) == none {
                t.error("{dir}/{name} expects code {code}, which has no row in diag.codes()")
            }
        }
    }
}

fn test_fixture_codes_documented(t: *testing.T) {
    fixture_codes(t, "testdata/fail", ".err")
    fixture_codes(t, "testdata/lint", ".warn")
    fixture_codes(t, "testdata/test", ".err")
}
