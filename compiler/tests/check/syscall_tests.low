import ast
import check
import compiler
import diag
import target
import std/testing

const probe_source = "fn getpid() -> i64 {{\n    __syscall(39)\n}}\n\nfn main() {{\n    print(getpid())\n}}\n"

fn no_embeds(f: *ast.File, name: str) -> check.Embedded ! check.EmbedError {
    fail check.EmbedError.Missing
}

fn no_embed_dirs(f: *ast.File, name: str) -> []str ! check.EmbedError {
    fail check.EmbedError.Missing
}

fn syscall_probe(t: *testing.T, platform: target.OS) -> str {
    let prelude_file = compiler.parse_prelude() catch {
        e => {
            t.fatal(compiler.message(e))
            return ""
        }
    }
    let probe_file = compiler.parse_source(probe_source, "probe.low", true) catch {
        e => {
            t.fatal(compiler.message(e))
            return ""
        }
    }
    var files = [prelude_file]
    if !target.has_os(platform) {
        let runtime_file = compiler.parse_browser_runtime() catch {
            e => {
                t.fatal(compiler.message(e))
                return ""
            }
        }
        files.push(runtime_file)
    }
    files.push(probe_file)
    check.check(files, platform, true, no_embeds, no_embed_dirs) catch {
        e => return diag.message(e)
    }
    ""
}

fn test_linux_accepts_syscall(t: *testing.T) {
    t.equal(syscall_probe(t, target.OS.Linux), "")
}

fn test_windows_rejects_syscall(t: *testing.T) {
    t.equal(syscall_probe(t, target.OS.Windows), "probe.low:2:5: windows/amd64 has no system calls, so __syscall cannot be called")
}

fn test_browser_rejects_syscall(t: *testing.T) {
    t.equal(syscall_probe(t, target.OS.Browser), "probe.low:2:5: browser/wasm32 has no system calls, so __syscall cannot be called")
}
