import check
import compiler
import diag
import ident
import lexer
import native
import target
import types
import std/file
import std/slices
import std/testing
import std/text

const design_path = "docs/design.md"
const builtins_heading = "\n## Builtins\n"
const section_separator = "\n### "
const chapter_end = "\n## "

struct Documented {
    names: []str
    signatures: [str: []str]
}

fn builtin_table() -> []*check.Builtin {
    let universe = types.new_universe(fn(t: *types.Type) ! diag.Error {})
    check.builtins(universe)
}

fn read_design(t: *testing.T) -> str {
    file.read_text(design_path) catch {
        e => {
            t.fatal("{design_path}: {e}")
            return ""
        }
    }
}

fn parameter_names(list: str) -> []str {
    var names: []str = []
    for param in text.split(list, ',') {
        let before = text.cut(param, ":").before
        let name = text.join(text.fields(before), " ")
        if name != "" {
            push(mut names, name)
        }
    }
    names
}

fn signature_parameters(body: str, name: str) -> []str? {
    let at = text.index(body, "`{name}(")
    if at < 0 {
        return none
    }
    let rest = body[at + name.len + 2..]
    let close = text.index_byte(rest, ')')
    if close < 0 {
        return parameter_names(rest)
    }
    parameter_names(rest[..close])
}

fn is_word_byte(c: u8) -> bool {
    c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9' || c == '_'
}

fn table_row_name(line: str) -> str? {
    if !text.starts_with(line, "| `") {
        return none
    }
    var end = 3
    for end < line.len && is_word_byte(line[end]) {
        end += 1
    }
    if end == 3 || !text.starts_with(line[end..], "` |") {
        return none
    }
    line[3..end]
}

fn documented_builtins(t: *testing.T) -> Documented {
    let design = read_design(t)
    let found = text.cut(design, builtins_heading)
    if !found.found {
        t.fatal("{design_path} has no ## Builtins chapter")
        return Documented { names: [], signatures: [:] }
    }
    let chapter = text.cut(found.after, chapter_end).before
    var names: []str = []
    var signatures: [str: []str] = [:]
    for section in text.split_str(chapter, section_separator) {
        let parts = text.cut(section, "\n")
        let name = text.trim_suffix(text.trim_prefix(parts.before, "`"), "`")
        if parts.before == name {
            continue
        }
        push(mut names, name)
        match signature_parameters(parts.after, name) {
            some(params) => {
                signatures[name] = params
            }
            none => {}
        }
    }
    for line in text.split(chapter, '\n') {
        match table_row_name(line) {
            some(name) => push(mut names, name)
            none => {}
        }
    }
    Documented { names, signatures }
}

fn test_builtins_documented(t: *testing.T) {
    let documented = documented_builtins(t)
    var registered: []str = []
    for b in builtin_table() {
        if !check.is_public(b) {
            continue
        }
        push(mut registered, b.name)
        if !slices.contains(documented.names, b.name) {
            t.error("builtin {b.name} has no entry in ## Builtins")
        }
        if b.kind != check.BuiltinKind.FunctionBuiltin {
            continue
        }
        match documented.signatures[b.name] {
            some(params) => {
                if !slices.equal(params, b.params) {
                    t.error("{b.name} takes ({text.join(b.params, ", ")}) but ## Builtins documents ({text.join(params, ", ")})")
                }
            }
            none => t.error("## Builtins gives no signature for {b.name}")
        }
    }
    for name in documented.names {
        if !slices.contains(registered, name) {
            t.error("## Builtins documents {name}, which is not a builtin")
        }
    }
}

fn is_reserved(names: ident.Reserved, word: str) -> bool {
    ident.ident(names, word) == "{word}_"
}

fn test_builtins_are_complete(t: *testing.T) {
    var seen: [str: bool] = [:]
    for b in builtin_table() {
        if seen[b.name] != none {
            t.error("{b.name} is registered twice")
        }
        seen[b.name] = true
        if b.kind == check.BuiltinKind.FunctionBuiltin && b.params.len == 0 && check.is_public(b) {
            t.error("{b.name} names no parameters")
        }
    }
    let names = ident.reserved()
    for word in ["fn", "match", "true"] {
        if !is_reserved(names, word) {
            t.error("{word} is not reserved")
        }
    }
    t.is_false(is_reserved(names, "frobnicate"))
}

fn test_ident(t: *testing.T) {
    let names = ident.reserved()
    for b in builtin_table() {
        t.equal(ident.ident(names, b.name), "{b.name}_")
    }
    for s in lexer.keyword_spellings() {
        t.equal(ident.ident(names, s.text), "{s.text}_")
    }
    t.equal(ident.ident(names, "frobnicate"), "frobnicate")
}

fn diagnostic_message(e: compiler.Error) -> str? {
    match e {
        Diag(inner) => match inner {
            At(pos, msg) => msg
        }
        _ => none
    }
}

fn rejection(path: str, std: *compiler.Std) -> str {
    let docs = native.overlay()
    compiler.check_in(path, target.OS.Linux, std, docs) catch {
        e => return diagnostic_message(e) ?? compiler.message(e)
    }
    ""
}

fn test_public_builtins_reject_wrong_arity(t: *testing.T) {
    let dir = file.temp_dir("check-arity-") catch {
        e => {
            t.fatal("{e}")
            return
        }
    }
    defer file.remove_all(dir) or {}
    let path = file.child_path(dir, "builtin.low")
    let std = compiler.new_std()
    for b in builtin_table() {
        if b.kind != check.BuiltinKind.FunctionBuiltin || !check.is_public(b) {
            continue
        }
        let source = "fn main() {{\n    {b.name}()\n}}\n"
        file.write_text(path, source) catch {
            e => {
                t.fatal("{path}: {e}")
                return
            }
        }
        let message = rejection(path, std)
        if !text.contains(message, "takes") {
            t.error("{b.name}() reported {diag.quote(message)}")
        }
    }
}
