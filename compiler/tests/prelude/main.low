import ast
import diag
import prelude
import std/testing

fn new_params(count: i64) -> []*ast.Param {
    var params: []*ast.Param = []
    for i in 0..count {
        push(mut params, new(ast.Param { name: "p{i}", pos: diag.Pos {} }))
    }
    params
}

fn new_type_params(count: i64) -> []*ast.TypeParam {
    var params: []*ast.TypeParam = []
    for i in 0..count {
        push(mut params, new(ast.TypeParam { name: "T{i}", pos: diag.Pos {} }))
    }
    params
}

fn result_name(func: str) -> str {
    "{func}Result"
}

fn func_index(file: *ast.File, name: str) -> i64 {
    for i, f in file.funcs {
        if f.name == name {
            return i
        }
    }
    -1
}

fn declare() -> *ast.File {
    let file = new(ast.File {})
    for e in prelude.entries() {
        let f = new(ast.Func {
            name: e.name
            params: new_params(e.params)
            type_params: new_type_params(prelude.type_params(e.role))
            pos: diag.Pos {}
        })
        push(mut file.funcs, f)
    }
    var structs: [str: *ast.StructDecl] = [:]
    for l in prelude.layouts() {
        var declared = structs[l.func]
        if declared == none {
            let s = new(ast.StructDecl { name: result_name(l.func), pos: diag.Pos {} })
            structs[l.func] = s
            push(mut file.structs, s)
            var at = func_index(file, l.func)
            if at < 0 {
                push(mut file.funcs, new(ast.Func { name: l.func, pos: diag.Pos {} }))
                at = file.funcs.len - 1
            }
            let elem = new(ast.TypeName { name: s.name, pos: diag.Pos {} })
            file.funcs[at].result = new(ast.TypeName { is_pointer: true, elem, pos: diag.Pos {} })
            declared = s
        }
        let owner = declared ?? continue
        let type_name = new(ast.TypeName { name: "i64", pos: diag.Pos {} })
        push(mut owner.fields, new(ast.FieldDecl { name: l.field, type_name, pos: diag.Pos {} }))
    }
    file
}

fn failure(file: *ast.File) -> str {
    prelude.validate(file) catch {
        e => return prelude.message(e)
    }
    ""
}

fn test_validate_accepts_a_declared_prelude(t: *testing.T) {
    t.equal(failure(declare()), "")
}

fn test_validate_names_a_missing_function(t: *testing.T) {
    let file = declare()
    file.funcs = file.funcs[1..]
    t.contains(failure(file), prelude.entries()[0].name)
}

fn test_validate_names_a_wrong_parameter_count(t: *testing.T) {
    let file = declare()
    file.funcs[0].params = []
    t.contains(failure(file), "parameters")
}

fn test_validate_names_a_missing_field(t: *testing.T) {
    let file = declare()
    file.structs[0].fields = []
    t.contains(failure(file), prelude.layouts()[0].field)
}

fn test_validate_names_a_field_that_is_not_first(t: *testing.T) {
    let file = declare()
    let want = result_name(prelude.box)
    for s in file.structs {
        if s.name == want {
            let other = new(ast.FieldDecl { name: "other", type_name: new(ast.TypeName { name: "i64", pos: diag.Pos {} }), pos: diag.Pos {} })
            var fields = [other]
            for f in s.fields {
                push(mut fields, f)
            }
            s.fields = fields
        }
    }
    t.contains(failure(file), prelude.box_value)
}

fn test_validate_accepts_a_struct_result_by_value(t: *testing.T) {
    let file = declare()
    let index = func_index(file, prelude.sel_recv)
    let pointer = file.funcs[index].result ?? return
    let elem = pointer.elem ?? return
    file.funcs[index].result = new(ast.TypeName { name: elem.name, pos: diag.Pos {} })
    t.equal(failure(file), "")
}

fn test_validate_names_a_result_that_is_not_a_struct(t: *testing.T) {
    let file = declare()
    let layout = prelude.layouts()[0]
    let index = func_index(file, layout.func)
    file.funcs[index].result = new(ast.TypeName { name: "i64", pos: diag.Pos {} })
    t.contains(failure(file), layout.func)
}

fn main() {
    testing.run([
        testing.Test { name: "validate_accepts_a_declared_prelude", run: test_validate_accepts_a_declared_prelude }
        testing.Test { name: "validate_names_a_missing_function", run: test_validate_names_a_missing_function }
        testing.Test { name: "validate_names_a_wrong_parameter_count", run: test_validate_names_a_wrong_parameter_count }
        testing.Test { name: "validate_names_a_missing_field", run: test_validate_names_a_missing_field }
        testing.Test { name: "validate_names_a_field_that_is_not_first", run: test_validate_names_a_field_that_is_not_first }
        testing.Test { name: "validate_accepts_a_struct_result_by_value", run: test_validate_accepts_a_struct_result_by_value }
        testing.Test { name: "validate_names_a_result_that_is_not_a_struct", run: test_validate_names_a_result_that_is_not_a_struct }
    ])
}
