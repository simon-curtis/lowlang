import link
import std/testing

struct XxhVector {
    length: i64
    want: u64
}

fn xxh3_vectors() -> []XxhVector {
    [
        XxhVector { length: 241, want: 0x82b1de299f6e411e }
        XxhVector { length: 1024, want: 0xf75e768c7cdd54b2 }
        XxhVector { length: 1025, want: 0x667a5eabe344e5df }
        XxhVector { length: 2048, want: 0x9e5e4a8160109a5d }
        XxhVector { length: 2049, want: 0x242c61fe5ed5db14 }
        XxhVector { length: 5000, want: 0x8e5898f51713d386 }
        XxhVector { length: 20000, want: 0x05b36829a6c3c68f }
    ]
}

fn xxh3_input(length: i64) -> []u8 {
    var data: []u8 = []
    for i in 0..length {
        push(mut data, u8((i * 7 + 3) % 251))
    }
    data
}

fn test_xxh3_long(t: *testing.T) {
    for v in xxh3_vectors() {
        let data = xxh3_input(v.length)
        let got = link.xxh3_long(data)
        if got != v.want {
            t.error("length {v.length}: got {got:x}, want {v.want:x}")
        }
    }
}
