import oracletool
import std/slices
import std/testing

fn fixed_tests() -> []testing.Test {
    [
        testing.Test { name: "abs64", run: test_abs64 }
        testing.Test { name: "abs32", run: test_abs32 }
        testing.Test { name: "abs32_overflow", run: test_abs32_overflow }
        testing.Test { name: "abs32s", run: test_abs32s }
        testing.Test { name: "pc32_and_plt32", run: test_pc32_and_plt32 }
        testing.Test { name: "pc32_overflow", run: test_pc32_overflow }
        testing.Test { name: "unsupported_fixup", run: test_unsupported_fixup }
        testing.Test { name: "undefined_symbols", run: test_undefined_symbols }
        testing.Test { name: "unreferenced_undefined_symbol_is_allowed", run: test_unreferenced_undefined_symbol_is_allowed }
        testing.Test { name: "missing_entry", run: test_missing_entry }
        testing.Test { name: "structure", run: test_structure }
        testing.Test { name: "symbol_table", run: test_symbol_table }
        testing.Test { name: "section_alignment", run: test_section_alignment }
        testing.Test { name: "deterministic", run: test_deterministic }
        testing.Test { name: "empty_sections_are_dropped", run: test_empty_sections_are_dropped }
        testing.Test { name: "xxh3_long", run: test_xxh3_long }
        testing.Test { name: "patch_resolves_against_the_running_image", run: test_patch_resolves_against_the_running_image }
        testing.Test { name: "patch_rejects_what_it_cannot_resolve", run: test_patch_rejects_what_it_cannot_resolve }
        testing.Test { name: "patch_rejects_writable_sections", run: test_patch_rejects_writable_sections }
        testing.Test { name: "link_returns_the_resolved_symbols", run: test_link_returns_the_resolved_symbols }
        testing.Test { name: "dynamic_got_and_plt_relocations", run: test_dynamic_got_and_plt_relocations }
        testing.Test { name: "dynamic_plt_slot_holds_lazy_entry", run: test_dynamic_plt_slot_holds_lazy_entry }
        testing.Test { name: "dynamic_undefined_symbol_names_libraries", run: test_dynamic_undefined_symbol_names_libraries }
        testing.Test { name: "dynamic_rejects_copy_relocation", run: test_dynamic_rejects_copy_relocation }
        testing.Test { name: "dynamic_records_libraries_in_link_order", run: test_dynamic_records_libraries_in_link_order }
        testing.Test { name: "resolve_maps_runtime_libraries_and_puts_libc_last", run: test_resolve_maps_runtime_libraries_and_puts_libc_last }
        testing.Test { name: "resolve_reads_soname_through_symlink", run: test_resolve_reads_soname_through_symlink }
        testing.Test { name: "resolve_missing_library", run: test_resolve_missing_library }
        testing.Test { name: "resolve_rejects_non_shared_object", run: test_resolve_rejects_non_shared_object }
        testing.Test { name: "pe_headers", run: test_pe_headers }
        testing.Test { name: "pe_section_layout", run: test_pe_section_layout }
        testing.Test { name: "pe_orders_sections_by_name", run: test_pe_orders_sections_by_name }
        testing.Test { name: "pe_fixups", run: test_pe_fixups }
        testing.Test { name: "pe_base_relocations", run: test_pe_base_relocations }
        testing.Test { name: "pe_omits_relocations_without_absolute_addresses", run: test_pe_omits_relocations_without_absolute_addresses }
        testing.Test { name: "pe_import_directories", run: test_pe_import_directories }
        testing.Test { name: "pe_stamps_content_hash", run: test_pe_stamps_content_hash }
        testing.Test { name: "pe_rejections", run: test_pe_rejections }
    ]
}

fn failed(name: str, e: oracletool.Error) -> []testing.Test {
    let message = oracletool.message(e)
    [testing.Test { name, run: fn(t) { t.fatal(message) } }]
}

fn static_tests() -> []testing.Test {
    let programs = link_corpus() catch {
        e => return failed("matches_gnu_ld", e)
    }
    static_oracle_tests(programs)
}

fn dynamic_tests() -> []testing.Test {
    let programs = dynamic_programs() catch {
        e => return failed("dynamic_matches_gnu_ld", e)
    }
    dynamic_oracle_tests(programs)
}

fn windows_tests() -> []testing.Test {
    let programs = windows_corpus() catch {
        e => return failed("pe_matches_lld", e)
    }
    pe_oracle_tests(programs)
}

fn main() {
    let oracle = slices.concat(static_tests(), dynamic_tests())
    let all = slices.concat(oracle, windows_tests())
    testing.run(slices.concat(fixed_tests(), all))
}
