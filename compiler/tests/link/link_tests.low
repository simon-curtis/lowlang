import amd64
import asm
import link
import oracletool
import std/io
import std/maps
import std/slices
import std/testing
import std/text

const largest_u32: i64 = 4294967295
const smallest_i32: i64 = -2147483648
const largest_i32: i64 = 2147483647
const three_gigabytes: i64 = 3221225472
const page_size = 0x1000

struct RangeCase {
    name: str
    value: i64
    fails: bool
}

fn range_case_name(c: RangeCase) -> str {
    c.name
}

fn test_abs64(t: *testing.T) {
    let obj = fixture_object(FixtureOptions {
        data_fixups: [
            fixup(0, asm.abs64, "text_label", 3)
            fixup(8, asm.abs64, "constant", -1)
        ]
    })
    let file = must_link(t, obj)
    let data = section_data(t, file, ".data")
    let want = symbol_address(t, file, "text_label") + 3
    expect_equal(t, "Abs64 against a label", io.le64(data, 0), want)
    expect_equal(t, "Abs64 against a constant", io.le64(data, 8), 0x1233)
}

fn test_abs32(t: *testing.T) {
    let obj = fixture_object(FixtureOptions { data_fixups: [fixup(0, asm.abs32, "rodata_label", 1)] })
    let file = must_link(t, obj)
    let data = section_data(t, file, ".data")
    let want = symbol_address(t, file, "rodata_label") + 1
    expect_equal(t, "Abs32", io.le32(data, 0), want)
}

fn abs32_overflow_cases() -> []RangeCase {
    [
        RangeCase { name: "largest", value: largest_u32, fails: false }
        RangeCase { name: "too large", value: largest_u32 + 1, fails: true }
        RangeCase { name: "negative", value: -1, fails: true }
    ]
}

fn check_abs32_overflow(t: *testing.T, c: RangeCase) {
    let obj = fixture_object(FixtureOptions {
        symbols: [absolute_symbol("wide", c.value)]
        data_fixups: [fixup(0, asm.abs32, "wide", 0)]
    })
    let message = link_error(obj)
    if (message != "") != c.fails {
        t.fatal("error {message}, want failure {c.fails}")
        return
    }
    if c.fails {
        t.contains(message, "wide")
    }
}

fn test_abs32_overflow(t: *testing.T) {
    t.table_of(abs32_overflow_cases(), range_case_name, check_abs32_overflow)
}

fn abs32s_cases() -> []RangeCase {
    [
        RangeCase { name: "negative", value: -5, fails: false }
        RangeCase { name: "smallest", value: smallest_i32, fails: false }
        RangeCase { name: "largest", value: largest_i32, fails: false }
        RangeCase { name: "too large", value: largest_i32 + 1, fails: true }
        RangeCase { name: "too small", value: smallest_i32 - 1, fails: true }
    ]
}

fn check_abs32s(t: *testing.T, c: RangeCase) {
    let obj = fixture_object(FixtureOptions {
        symbols: [absolute_symbol("signed", c.value)]
        data_fixups: [fixup(4, asm.abs32s, "signed", 0)]
    })
    let image = link.static(obj) catch {
        e => {
            if !c.fails {
                t.fatal("link: {link.message(e)}, want success")
            }
            return
        }
    }
    if c.fails {
        t.fatal("link succeeded, want failure")
        return
    }
    let file = parse_image(t, image)
    let data = section_data(t, file, ".data")
    let got = sign_extend_32(io.le32(data, 4))
    if got != c.value {
        t.error("Abs32S: got {got}, want {c.value}")
    }
}

fn test_abs32s(t: *testing.T) {
    t.table_of(abs32s_cases(), range_case_name, check_abs32s)
}

fn fixup_kind_name(kind: i64) -> str {
    asm.fixup_kind_text(kind)
}

fn check_pc32_displacements(t: *testing.T, kind: i64) {
    let obj = fixture_object(FixtureOptions {
        text_fixups: [
            fixup(16, kind, "data_label", -4)
            fixup(32, kind, "text_label", -4)
        ]
    })
    let file = must_link(t, obj)
    let text = section_of(t, file, ".text")
    let data = section_data(t, file, ".text")
    let forward = sign_extend_32(io.le32(data, 16))
    let want_forward = symbol_address(t, file, "data_label") - 4 - (text.addr + 16)
    if forward != want_forward {
        t.error("forward displacement: got {forward}, want {want_forward}")
    }
    let backward = sign_extend_32(io.le32(data, 32))
    let want_backward = symbol_address(t, file, "text_label") - 4 - (text.addr + 32)
    if backward != want_backward {
        t.error("backward displacement: got {backward}, want {want_backward}")
    }
}

fn test_pc32_and_plt32(t: *testing.T) {
    t.table_of([asm.pc32, asm.plt32], fixup_kind_name, check_pc32_displacements)
}

fn test_pc32_overflow(t: *testing.T) {
    let obj = fixture_object(FixtureOptions {
        bss_size: three_gigabytes
        symbols: [asm.Symbol { name: "far", section: bss_index, value: three_gigabytes - 8 }]
        text_fixups: [fixup(0, asm.pc32, "far", -4)]
    })
    let message = link_error(obj)
    if message == "" {
        t.fatal("link succeeded, want an overflow naming far")
        return
    }
    t.contains(message, "far")
}

fn check_unsupported_fixup(t: *testing.T, kind: i64) {
    let obj = fixture_object(FixtureOptions { text_fixups: [fixup(0, kind, "text_label", 0)] })
    let message = link_error(obj)
    let name = asm.fixup_kind_text(kind)
    if message == "" {
        t.fatal("link succeeded, want an error naming {name}")
        return
    }
    t.contains(message, name)
}

fn test_unsupported_fixup(t: *testing.T) {
    let kinds = [asm.gotpcrel, asm.gotpcrelx, asm.rex_gotpcrelx, asm.img_rel32]
    t.table_of(kinds, fixup_kind_name, check_unsupported_fixup)
}

fn test_undefined_symbols(t: *testing.T) {
    let obj = fixture_object(FixtureOptions {
        symbols: [undefined_symbol("zeta"), undefined_symbol("alpha")]
        text_fixups: [
            fixup(0, asm.pc32, "zeta", -4)
            fixup(8, asm.pc32, "alpha", -4)
            fixup(16, asm.pc32, "zeta", -4)
        ]
    })
    let message = link_error(obj)
    if message == "" {
        t.fatal("link succeeded with undefined symbols")
        return
    }
    t.equal(message, "link: undefined symbol alpha, zeta")
}

fn test_unreferenced_undefined_symbol_is_allowed(t: *testing.T) {
    let obj = fixture_object(FixtureOptions { symbols: [undefined_symbol("unused")] })
    must_link(t, obj)
}

fn test_missing_entry(t: *testing.T) {
    var obj = fixture_object(FixtureOptions {})
    obj.symbols[0].name = "begin"
    let message = link_error(obj)
    if message == "" {
        t.fatal("link succeeded without an entry symbol")
        return
    }
    t.contains(message, amd64.elf_entry_symbol)
}

fn expected_program_types() -> []i64 {
    [
        oracletool.pt_load
        oracletool.pt_load
        oracletool.pt_load
        oracletool.pt_load
        oracletool.pt_tls
        oracletool.pt_gnu_stack
    ]
}

fn expected_program_flags() -> []i64 {
    [
        oracletool.pf_r
        oracletool.pf_r | oracletool.pf_x
        oracletool.pf_r
        oracletool.pf_r | oracletool.pf_w
        oracletool.pf_r
        oracletool.pf_r | oracletool.pf_w
    ]
}

fn check_program_headers(t: *testing.T, file: oracletool.ElfFile) {
    let want_types = expected_program_types()
    let want_flags = expected_program_flags()
    if file.progs.len != want_types.len {
        t.fatal("got {file.progs.len} program headers, want {want_types.len}")
        return
    }
    for i, prog in file.progs {
        if prog.kind != want_types[i] || prog.flags != want_flags[i] {
            t.error("program header {i}: got type {prog.kind} flags {prog.flags}, want {want_types[i]} {want_flags[i]}")
        }
        let congruent = prog.offset % page_size == prog.vaddr % page_size
        if prog.kind == oracletool.pt_load && (!congruent || prog.align != page_size) {
            let offset = oracletool.hex_text(prog.offset)
            let address = oracletool.hex_text(prog.vaddr)
            t.error("program header {i}: offset {offset} and address {address} are not congruent")
        }
    }
}

fn test_structure(t: *testing.T) {
    let file = must_link(t, fixture_object(FixtureOptions {}))
    check_program_headers(t, file)
    expect_equal(t, "image start", file.progs[0].vaddr, link.base_address)
    let code = section_of(t, file, ".text")
    expect_equal(t, "entry", file.entry, code.addr)
    let names = ["", ".text", ".rodata", ".tbss", ".data", ".bss", ".symtab", ".strtab", ".shstrtab"]
    if file.sections.len != names.len {
        t.fatal("got {file.sections.len} sections, want {names.len}")
        return
    }
    for i, name in names {
        if file.sections[i].name != name {
            let got = text.quote(file.sections[i].name)
            let want = text.quote(name)
            t.error("section {i} is {got}, want {want}")
        }
    }
}

fn symbols_by_name(t: *testing.T, file: oracletool.ElfFile) -> [str: oracletool.ElfSymbol] {
    var by_name: [str: oracletool.ElfSymbol] = [:]
    for sym in file_symbols(t, file) {
        by_name[sym.name] = sym
    }
    by_name
}

fn named_symbol(t: *testing.T, by_name: [str: oracletool.ElfSymbol], name: str) -> oracletool.ElfSymbol {
    match by_name[name] {
        some(sym) => sym
        none => {
            t.error("symbol {name} is missing")
            oracletool.ElfSymbol { name }
        }
    }
}

fn symbol_type(sym: oracletool.ElfSymbol) -> i64 {
    sym.info & 0xf
}

fn symbol_binding(sym: oracletool.ElfSymbol) -> i64 {
    sym.info >> 4
}

fn test_symbol_table(t: *testing.T) {
    let file = must_link(t, fixture_object(FixtureOptions {}))
    let by_name = symbols_by_name(t, file)
    if maps.has(by_name, ".Lhidden") {
        t.error("a .L symbol reached the symbol table")
    }
    let expected = ["text_label", "rodata_label", "bss_label", "tls_label", "constant", "_start", "data_label", "_end", "_edata", "__bss_start"]
    for name in expected {
        if !maps.has(by_name, name) {
            t.error("symbol {name} is missing")
        }
    }
    let constant = named_symbol(t, by_name, "constant")
    if constant.shndx != oracletool.shn_abs || constant.value != 0x1234 {
        let value = oracletool.hex_text(constant.value)
        t.error("constant: got section {constant.shndx} value {value}")
    }
    let tls = named_symbol(t, by_name, "tls_label")
    let tls_type = symbol_type(tls)
    if tls_type != oracletool.stt_tls || tls.value != 0 {
        let value = oracletool.hex_text(tls.value)
        t.error("tls_label: got type {tls_type} value {value}")
    }
    let text_label = named_symbol(t, by_name, "text_label")
    let start = named_symbol(t, by_name, "_start")
    if symbol_binding(text_label) != oracletool.stb_local || symbol_binding(start) != oracletool.stb_global {
        t.error("symbol binding is wrong")
    }
    let bss = section_of(t, file, ".bss")
    expect_equal(t, "_end", named_symbol(t, by_name, "_end").value, bss.addr + bss.size)
    expect_equal(t, "__bss_start", named_symbol(t, by_name, "__bss_start").value, bss.addr)
}

fn test_section_alignment(t: *testing.T) {
    var obj = fixture_object(FixtureOptions {})
    obj.sections[rodata_index].align = 64
    obj.sections[data_index].align = 128
    let file = must_link(t, obj)
    for section in file.sections {
        if section.flags & oracletool.shf_alloc == 0 || section.addralign <= 1 {
            continue
        }
        if section.addr % section.addralign != 0 || section.offset % section.addralign != 0 {
            let address = oracletool.hex_text(section.addr)
            let offset = oracletool.hex_text(section.offset)
            t.error("{section.name} at {address}/{offset} is not aligned to {section.addralign}")
        }
    }
}

fn deterministic_image(t: *testing.T) -> []u8 {
    let obj = fixture_object(FixtureOptions { data_fixups: [fixup(0, asm.abs64, "text_label", 0)] })
    let image = link.static(obj) catch {
        e => {
            t.fatal(link.message(e))
            return []
        }
    }
    image.bytes
}

fn test_deterministic(t: *testing.T) {
    let first = deterministic_image(t)
    let second = deterministic_image(t)
    if !slices.equal(first, second) {
        t.error("two links of the same object differ")
    }
}

fn test_empty_sections_are_dropped(t: *testing.T) {
    var obj = fixture_object(FixtureOptions {})
    obj.sections[bss_index].size = 0
    obj.sections[tbss_index].size = 0
    obj.symbols = obj.symbols[..4]
    let file = must_link(t, obj)
    for name in [".bss", ".tbss"] {
        if has_section(file, name) {
            t.error("empty section {name} was kept")
        }
    }
    for prog in file.progs {
        if prog.kind == oracletool.pt_tls {
            t.error("a TLS segment was emitted without TLS sections")
        }
    }
}
