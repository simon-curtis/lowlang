import asm
import compiler
import link
import oracletool
import target
import std/file
import std/testing

fn read_output(path: str) -> []u8 ! oracletool.Error {
    file.read_file(path) catch {
        e => fail oracletool.Error.Failed("read {path}: {e}")
    }
}

fn link_with_ld(dir: str, source: str) -> []u8 ! oracletool.Error {
    let options = oracletool.GNUOptions { align_branches: true, linkable: true }
    let object = oracletool.assemble_gnu(dir, source, options)?
    let output = file.child_path(dir, "main.ld")
    oracletool.run_tool("ld", ["-static", "-o", output, object])?
    read_output(output)?
}

fn link_in_process(source: str) -> []u8 ! oracletool.Error {
    let object = asm.assemble(source, compiler.assembler(target.OS.Linux)) catch {
        e => fail oracletool.Error.Failed("assemble: {asm.message(e)}")
    }
    let image = link.static(object) catch {
        e => fail oracletool.Error.Failed(link.message(e))
    }
    image.bytes
}

fn run_static_program(t: *testing.T, program: oracletool.Program) {
    oracletool.require(t, "as", oracletool.gnu)
    oracletool.require(t, "ld", oracletool.gnu)
    let dir = scratch(t)
    defer file.remove_all(dir) or {}
    let generated = oracletool.generate(dir, program.path, target.OS.Linux) catch {
        e => {
            t.fatal("compile: {oracletool.message(e)}")
            return
        }
    }
    if generated.libraries.len > 0 {
        t.skip("program links C libraries")
        return
    }
    let want = link_with_ld(dir, generated.asm) catch {
        e => {
            t.fatal(oracletool.message(e))
            return
        }
    }
    let got = link_in_process(generated.asm) catch {
        e => {
            t.fatal(oracletool.message(e))
            return
        }
    }
    compare_executables(t, got, want)
}

fn static_oracle_tests(programs: []oracletool.Program) -> []testing.Test {
    var tests: []testing.Test = []
    for program in programs {
        push(mut tests, testing.Test { name: "matches_gnu_ld/{program.name}", run: fn(t) { run_static_program(t, program) } })
    }
    tests
}
