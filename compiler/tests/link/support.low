import amd64
import asm
import link
import oracletool
import std/file
import std/io
import std/slices
import std/testing

const text_index = 0
const rodata_index = 1
const data_index = 2
const bss_index = 3
const tbss_index = 4

const default_bss_size = 64
const rela_entry_size = 24

struct FixtureOptions {
    text_fixups: []asm.Fixup = []
    data_fixups: []asm.Fixup = []
    symbols: []asm.Symbol = []
    bss_size: i64 = 0
}

fn fixture_object(options: FixtureOptions) -> asm.Object {
    let bss_size = if options.bss_size == 0 { default_bss_size } else { options.bss_size }
    let text = asm.Section {
        name: ".text"
        flags: asm.flag_alloc | asm.flag_exec
        align: 16
        data: io.buffer(64)
        fixups: options.text_fixups
    }
    let rodata_bytes: []u8 = [1, 2, 3, 4, 5, 6, 7, 8]
    let rodata = asm.Section { name: ".rodata", flags: asm.flag_alloc, align: 8, data: rodata_bytes }
    let data = asm.Section {
        name: ".data"
        flags: asm.flag_alloc | asm.flag_write
        align: 8
        data: io.buffer(32)
        fixups: options.data_fixups
    }
    let bss = asm.Section { name: ".bss", flags: asm.flag_alloc | asm.flag_write, align: 8, nobits: true, size: bss_size }
    let tbss_flags = asm.flag_alloc | asm.flag_write | asm.flag_tls
    let tbss = asm.Section { name: ".tbss", flags: tbss_flags, align: 8, nobits: true, size: 24 }
    let base_symbols = [
        asm.Symbol { name: amd64.elf_entry_symbol, section: text_index, global: true }
        asm.Symbol { name: "text_label", section: text_index, value: 8 }
        asm.Symbol { name: "rodata_label", section: rodata_index, value: 4 }
        asm.Symbol { name: "data_label", section: data_index, value: 16, global: true }
        asm.Symbol { name: "bss_label", section: bss_index, value: 8 }
        asm.Symbol { name: "tls_label", section: tbss_index, value: 0 }
        asm.Symbol { name: "constant", section: asm.section_absolute, value: 0x1234 }
        asm.Symbol { name: ".Lhidden", section: text_index, value: 2 }
    ]
    asm.Object {
        sections: [text, rodata, data, bss, tbss]
        symbols: slices.concat(base_symbols, options.symbols)
    }
}

fn fixup(offset: i64, kind: i64, symbol: str, addend: i64) -> asm.Fixup {
    asm.Fixup { offset, kind, symbol, addend }
}

fn absolute_symbol(name: str, value: i64) -> asm.Symbol {
    asm.Symbol { name, section: asm.section_absolute, value }
}

fn undefined_symbol(name: str) -> asm.Symbol {
    asm.Symbol { name, section: asm.section_undefined, global: true }
}

fn parse_image(t: *testing.T, image: link.Image) -> oracletool.ElfFile {
    oracletool.read_elf(image.bytes) catch {
        e => {
            t.fatal("parse linked image: {oracletool.message(e)}")
            return oracletool.ElfFile {}
        }
    }
}

fn must_link(t: *testing.T, obj: asm.Object) -> oracletool.ElfFile {
    let image = link.static(obj) catch {
        e => {
            t.fatal("link: {link.message(e)}")
            return oracletool.ElfFile {}
        }
    }
    parse_image(t, image)
}

fn link_error(obj: asm.Object) -> str {
    link.static(obj) catch {
        e => return link.message(e)
    }
    ""
}

fn section_of(t: *testing.T, file: oracletool.ElfFile, name: str) -> oracletool.ElfSection {
    match oracletool.elf_section(file, name) {
        some(section) => section
        none => {
            t.fatal("section {name} is missing")
            oracletool.ElfSection { name }
        }
    }
}

fn has_section(file: oracletool.ElfFile, name: str) -> bool {
    match oracletool.elf_section(file, name) {
        some(section) => true
        none => false
    }
}

fn section_data(t: *testing.T, file: oracletool.ElfFile, name: str) -> []u8 {
    let section = section_of(t, file, name)
    oracletool.elf_data(file, section) catch {
        e => {
            t.fatal("read {name}: {oracletool.message(e)}")
            return []
        }
    }
}

fn file_symbols(t: *testing.T, file: oracletool.ElfFile) -> []oracletool.ElfSymbol {
    oracletool.elf_symbols(file) catch {
        e => {
            t.fatal("read symbols: {oracletool.message(e)}")
            return []
        }
    }
}

fn symbol_address(t: *testing.T, file: oracletool.ElfFile, name: str) -> i64 {
    for sym in file_symbols(t, file) {
        if sym.name == name {
            return sym.value
        }
    }
    t.fatal("symbol {name} is missing")
    0
}

fn scratch(t: *testing.T) -> str {
    file.temp_dir("link-test-") catch {
        e => {
            t.fatal("temp dir: {e}")
            return ""
        }
    }
}

fn expect_equal(t: *testing.T, what: str, got: i64, want: i64) {
    if got != want {
        let got_text = oracletool.hex_text(got)
        let want_text = oracletool.hex_text(want)
        t.error("{what}: got {got_text}, want {want_text}")
    }
}

fn sign_extend_32(value: i64) -> i64 {
    if value >= 0x80000000 {
        return value - 0x100000000
    }
    value
}
