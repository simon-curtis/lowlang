import fixture
import oracletool
import std/os
import std/slices

fn run_program(name: str) -> oracletool.Program {
    oracletool.Program { name, path: "testdata/run/{name}.low" }
}

fn benchmark_program(name: str) -> oracletool.Program {
    oracletool.Program { name, path: "bench/{name}/main.low" }
}

fn sample_corpus() -> []oracletool.Program {
    [
        run_program("chaining")
        run_program("callbacks")
        run_program("cf_loops")
        run_program("cf_spawn_loop")
        run_program("chan_fairness")
        run_program("std_jose")
        run_program("std_tzdata")
        run_program("std_unicode_graphemes")
        run_program("std_http_proxy")
        benchmark_program("binarytrees")
        benchmark_program("nbody")
        benchmark_program("jsonpar")
        benchmark_program("maps")
    ]
}

fn link_corpus() -> []oracletool.Program ! oracletool.Error {
    let full = os.env("LOW_LINK_FULL") ?? ""
    if full == "" {
        return sample_corpus()
    }
    let run = oracletool.programs("run")?
    let benchmarks = oracletool.benchmarks()?
    slices.concat(run, benchmarks)
}

fn windows_corpus() -> []oracletool.Program ! oracletool.Error {
    let windows = oracletool.programs("windows")?
    let linked = link_corpus()?
    slices.concat(windows, linked)
}

fn dynamic_programs() -> []oracletool.Program ! oracletool.Error {
    let run = oracletool.programs("run")?
    var found: []oracletool.Program = []
    for program in run {
        let sidecars = fixture.read(program.path) catch {
            e => fail oracletool.Error.Failed(fixture.message(e))
        }
        if sidecars.libraries.len > 0 {
            push(mut found, program)
        }
    }
    found
}
