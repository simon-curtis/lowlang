import oracletool
import std/slices
import std/testing

const header_bytes = 64
const symbol_mismatch_limit = 5
const absolute_section_name = "*ABS*"

struct SymbolView {
    value: i64
    info: i64
    other: i64
    section: str
}

struct SymbolViews {
    views: [str: SymbolView]
    first_global: i64
}

fn same_view(a: SymbolView, b: SymbolView) -> bool {
    a.value == b.value && a.info == b.info && a.other == b.other && a.section == b.section
}

fn view_text(v: SymbolView) -> str {
    "value 0x{v.value:x} info {v.info} other {v.other} section {v.section}"
}

fn same_prog(a: oracletool.ElfProg, b: oracletool.ElfProg) -> bool {
    a.kind == b.kind && a.flags == b.flags && a.offset == b.offset && a.vaddr == b.vaddr && a.paddr == b.paddr && a.filesz == b.filesz && a.memsz == b.memsz && a.align == b.align
}

fn prog_text(p: oracletool.ElfProg) -> str {
    "type {p.kind} flags {p.flags} offset 0x{p.offset:x} vaddr 0x{p.vaddr:x} paddr 0x{p.paddr:x} filesz 0x{p.filesz:x} memsz 0x{p.memsz:x} align 0x{p.align:x}"
}

fn same_section(a: oracletool.ElfSection, b: oracletool.ElfSection) -> bool {
    a.name == b.name && a.kind == b.kind && a.flags == b.flags && a.addr == b.addr && a.offset == b.offset && a.size == b.size && a.linked == b.linked && a.info == b.info && a.addralign == b.addralign && a.entsize == b.entsize
}

fn section_text(s: oracletool.ElfSection) -> str {
    "{s.name} type {s.kind} flags {s.flags} addr 0x{s.addr:x} offset 0x{s.offset:x} size 0x{s.size:x} link {s.linked} info {s.info} align {s.addralign} entsize {s.entsize}"
}

fn parse_elf(t: *testing.T, what: str, data: []u8) -> oracletool.ElfFile {
    oracletool.read_elf(data) catch {
        e => {
            t.fatal("open {what}: {oracletool.message(e)}")
            return oracletool.ElfFile {}
        }
    }
}

fn read_symbols(t: *testing.T, file: oracletool.ElfFile) -> []oracletool.ElfSymbol {
    oracletool.elf_symbols(file) catch {
        e => {
            t.fatal("read symbols: {oracletool.message(e)}")
            return []
        }
    }
}

fn symbol_section_name(file: oracletool.ElfFile, shndx: i64) -> str {
    if shndx == oracletool.shn_abs {
        return absolute_section_name
    }
    if shndx < oracletool.shn_loreserve {
        return oracletool.elf_section_name(file, shndx)
    }
    ""
}

fn symbol_views(t: *testing.T, file: oracletool.ElfFile, skip_files: bool) -> SymbolViews {
    var views: [str: SymbolView] = [:]
    var first_global = 0
    for i, sym in read_symbols(t, file) {
        if first_global == 0 && sym.info >> 4 != oracletool.stb_local {
            first_global = i + 1
        }
        if skip_files && sym.info & 0xf == oracletool.stt_file {
            continue
        }
        let section = symbol_section_name(file, sym.shndx)
        views[sym.name] = SymbolView { value: sym.value, info: sym.info, other: sym.other, section }
    }
    SymbolViews { views, first_global }
}

fn compare_header(t: *testing.T, got: oracletool.ElfFile, want: oracletool.ElfFile) {
    if got.kind != want.kind || got.machine != want.machine || got.entry != want.entry {
        t.error("header: got type {got.kind} machine {got.machine} entry 0x{got.entry:x}, want type {want.kind} machine {want.machine} entry 0x{want.entry:x}")
    }
}

fn compare_programs(t: *testing.T, got: oracletool.ElfFile, want: oracletool.ElfFile) {
    if got.progs.len != want.progs.len {
        t.error("program headers: got {got.progs.len}, want {want.progs.len}")
        return
    }
    for i, w in want.progs {
        let g = got.progs[i]
        if !same_prog(g, w) {
            let got_text = prog_text(g)
            let want_text = prog_text(w)
            t.error("program header {i}: got {got_text}, want {want_text}")
        }
    }
}

fn without_file_extent(s: oracletool.ElfSection) -> oracletool.ElfSection {
    var masked = s
    masked.offset = 0
    masked.size = 0
    masked
}

fn compare_sections(t: *testing.T, got: oracletool.ElfFile, want: oracletool.ElfFile) {
    if got.sections.len != want.sections.len {
        t.error("sections: got {got.sections.len}, want {want.sections.len}")
        return
    }
    for i, w in want.sections {
        var g = got.sections[i]
        var expected = w
        if w.flags & oracletool.shf_alloc == 0 {
            g = without_file_extent(g)
            expected = without_file_extent(expected)
        }
        if !same_section(g, expected) {
            let got_text = section_text(got.sections[i])
            let want_text = section_text(w)
            t.error("section {i}: got {got_text}, want {want_text}")
        }
    }
}

fn symbol_problems(got: [str: SymbolView], want: [str: SymbolView]) -> []str {
    var problems: []str = []
    for name, w in want {
        match got[name] {
            some(g) => {
                if !same_view(g, w) {
                    let got_text = view_text(g)
                    let want_text = view_text(w)
                    push(mut problems, "{name}: got {got_text}, want {want_text}")
                }
            }
            none => push(mut problems, "{name}: missing")
        }
    }
    slices.sort(mut problems)
    problems
}

fn report_symbol_problems(t: *testing.T, problems: []str) {
    for i, problem in problems {
        if i == symbol_mismatch_limit {
            let more = problems.len - symbol_mismatch_limit
            t.error("... {more} more symbol mismatches")
            break
        }
        t.error(problem)
    }
}

fn compare_symbols(t: *testing.T, got_file: oracletool.ElfFile, want_file: oracletool.ElfFile) {
    let got = symbol_views(t, got_file, false)
    let want = symbol_views(t, want_file, false)
    if got.first_global != want.first_global {
        t.error("first global symbol index: got {got.first_global}, want {want.first_global}")
    }
    if got.views.len != want.views.len {
        t.error("symbols: got {got.views.len}, want {want.views.len}")
    }
    report_symbol_problems(t, symbol_problems(got.views, want.views))
}

fn compare_symbols_ignoring_files(t: *testing.T, got_file: oracletool.ElfFile, want_file: oracletool.ElfFile) {
    let got = symbol_views(t, got_file, true)
    let want = symbol_views(t, want_file, true)
    if got.views.len != want.views.len {
        t.error("symbols: got {got.views.len}, want {want.views.len}")
    }
    report_symbol_problems(t, symbol_problems(got.views, want.views))
}

fn compare_loaded_bytes(t: *testing.T, got: oracletool.ElfFile, want: oracletool.ElfFile) {
    for i, w in want.progs {
        if w.kind != oracletool.pt_load || i >= got.progs.len {
            continue
        }
        let g = got.progs[i]
        let skip = if w.offset == 0 { header_bytes } else { 0 }
        let got_data = got.data[g.offset + skip..g.offset + g.filesz]
        let want_data = want.data[w.offset + skip..w.offset + w.filesz]
        if !slices.equal(got_data, want_data) {
            let at = oracletool.first_difference(got_data, want_data)
            t.error("segment {i} (flags {w.flags}): loaded bytes differ at {at}")
        }
    }
}

fn compare_executables(t: *testing.T, got_bytes: []u8, want_bytes: []u8) {
    let got = parse_elf(t, "linked output", got_bytes)
    let want = parse_elf(t, "ld output", want_bytes)
    compare_header(t, got, want)
    compare_programs(t, got, want)
    compare_sections(t, got, want)
    compare_symbols(t, got, want)
    compare_loaded_bytes(t, got, want)
}
