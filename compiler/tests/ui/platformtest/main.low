import std/io
import std/sys
import std/time

extern "xkbcommon" {
    fn xkb_keymap_new_from_names(context: ptr, names: ptr, flags: i32) -> ptr
}

fn named_name(k: NamedKey) -> str {
    match k {
        Enter => "Enter"
        Escape => "Escape"
        Tab => "Tab"
        Backspace => "Backspace"
        Delete => "Delete"
        Left => "Left"
        Right => "Right"
        Up => "Up"
        Down => "Down"
        Home => "Home"
        End => "End"
        PageUp => "PageUp"
        PageDown => "PageDown"
        Insert => "Insert"
        Pause => "Pause"
        Break => "Break"
        Menu => "Menu"
        Function(number) => "F{number}"
    }
}

fn key_name(k: Key) -> str {
    match k {
        Named(n) => named_name(n)
        Character(text) => "char:{text}"
    }
}

fn button_name(b: Button) -> str {
    match b {
        Left => "left"
        Right => "right"
        Middle => "middle"
        Navigate(direction) => {
            match direction {
                Back => "back"
                Forward => "forward"
            }
        }
        Other(code) => "other:{code}"
    }
}

fn click_suffix(b: ButtonEvent) -> str {
    if b.clicks == 1 { "" } else { " x{b.clicks}" }
}

fn modifier_flags(m: Modifiers) -> str {
    var flags = ""
    if m.shift {
        flags = "{flags}S"
    }
    if m.control {
        flags = "{flags}C"
    }
    if m.alt {
        flags = "{flags}A"
    }
    if m.super {
        flags = "{flags}U"
    }
    flags
}

fn event_text(e: Event) -> str {
    match e {
        Resized(width, height, scale) => "resized {width} {height} {scale}"
        CloseRequested => "close"
        PointerMoved(x, y) => "moved {x} {y}"
        PointerLeft => "left"
        PointerDown(b) => "down {button_name(b.button)} {b.x} {b.y}{click_suffix(b)}"
        PointerUp(b) => "up {button_name(b.button)} {b.x} {b.y}{click_suffix(b)}"
        Scrolled(dx, dy, modifiers) => "scrolled {dx} {dy} mods=[{modifier_flags(modifiers)}]"
        Key(k) => "key {key_name(k.key)} text=[{k.text}] mods=[{modifier_flags(k.modifiers)}] pressed={k.pressed} repeat={k.repeat}"
        Preedit(text, cursor) => "preedit [{text}] {cursor_text(cursor)}"
        Commit(text) => "commit [{text}]"
        Maximized(maximized) => "maximized {maximized}"
        FocusChanged(focused) => "focus {focused}"
        Woken => "woken"
        FileDragEntered(x, y, paths) => "file drag entered {x} {y} {paths.len}"
        FileDragMoved(x, y) => "file drag moved {x} {y}"
        FileDropped(x, y) => "file dropped {x} {y}"
        FileDragExited => "file drag exited"
    }
}

fn cursor_text(cursor: TextRange?) -> str {
    match cursor {
        some(c) => "{c.start}-{c.end}"
        none => "hidden"
    }
}

fn drain(label: str, s: *WindowState) {
    let events = take_events(s)
    if events.len == 0 {
        print("{label}: none")
    }
    for e in events {
        print("{label}: {event_text(e)}")
    }
}

fn press(s: *WindowState, label: str, code: u32) {
    on_key(s.handle, null, 0, 0, code, wl_keyboard_key_state_pressed)
    drain(label, s)
}

fn release(s: *WindowState, label: str, code: u32) {
    on_key(s.handle, null, 0, 0, code, wl_keyboard_key_state_released)
    drain(label, s)
}

fn hold(s: *WindowState, depressed: u32) {
    on_modifiers(s.handle, null, 0, depressed, 0, 0, 0)
}

fn fixture() -> *WindowState ! Error {
    let ifs = interfaces()
    let waker = new(WakerState { signal: chan[bool](1) })
    let s = new(WindowState { ifs, arm: chan[bool](1), ready: chan[bool](1), done: chan[bool](1), waker, width: 320, height: 200 })
    s.handle = pin(new(Handle { state: s }))
    start_keys(s)?
    let keymap = xkb_keymap_new_from_names(s.keys.context, null, 0)
    if keymap == null {
        fail Failed("xkb_keymap_new_from_names", 0)
    }
    s.keys.keymap = keymap
    s.keys.state = xkb_state_new(keymap)
    s
}

fn keys(s: *WindowState) {
    press(s, "a", 30)
    release(s, "a", 30)
    hold(s, 1)
    press(s, "shift a", 30)
    press(s, "shift 1", 2)
    press(s, "shift tab", 15)
    hold(s, 4)
    press(s, "control a", 30)
    hold(s, 8)
    press(s, "alt a", 30)
    hold(s, 64)
    press(s, "super a", 30)
    hold(s, 0)
    press(s, "left shift", 42)
    press(s, "space", 57)
    press(s, "enter", 28)
    press(s, "keypad enter", 96)
    press(s, "escape", 1)
    press(s, "tab", 15)
    press(s, "backspace", 14)
    press(s, "delete", 111)
    press(s, "left", 105)
    press(s, "right", 106)
    press(s, "up", 103)
    press(s, "down", 108)
    press(s, "home", 102)
    press(s, "end", 107)
    press(s, "page up", 104)
    press(s, "page down", 109)
    press(s, "insert", 110)
    press(s, "pause", 119)
    hold(s, 4)
    press(s, "control pause", 119)
    hold(s, 0)
    press(s, "menu", 127)
    press(s, "f1", 59)
    press(s, "f12", 88)
    press(s, "keypad 1 without numlock", 79)
    on_modifiers(s.handle, null, 0, 0, 0, 16, 0)
    press(s, "keypad 1 with numlock", 79)
    hold(s, 0)
}

fn repeating(s: *WindowState) {
    on_repeat_info(s.handle, null, 50, 120)
    press(s, "held", 30)
    emit_repeat(s)
    drain("held early", s)
    sleep(160)
    emit_repeat(s)
    drain("held late", s)
    release(s, "held", 30)
    sleep(40)
    emit_repeat(s)
    drain("released", s)
    press(s, "modifier", 42)
    sleep(160)
    emit_repeat(s)
    drain("modifier held", s)
    on_repeat_info(s.handle, null, 0, 120)
    press(s, "disabled", 30)
    sleep(160)
    emit_repeat(s)
    drain("disabled held", s)
}

fn pointer(s: *WindowState) {
    on_pointer_enter(s.handle, null, 0, null, 2560, 5120)
    drain("enter", s)
    on_pointer_motion(s.handle, null, 0, 2688, 5248)
    drain("motion", s)
    on_pointer_button(s.handle, null, 0, 0, 272, wl_pointer_button_state_pressed)
    drain("press", s)
    on_pointer_button(s.handle, null, 0, 0, 273, wl_pointer_button_state_released)
    drain("release", s)
    on_pointer_button(s.handle, null, 0, 0, 274, wl_pointer_button_state_pressed)
    drain("middle", s)
    on_pointer_button(s.handle, null, 0, 0, 275, wl_pointer_button_state_pressed)
    drain("side", s)
    on_pointer_button(s.handle, null, 0, 0, 276, wl_pointer_button_state_pressed)
    drain("extra", s)
    on_pointer_button(s.handle, null, 0, 1000, 272, wl_pointer_button_state_pressed)
    on_pointer_button(s.handle, null, 0, 1100, 272, wl_pointer_button_state_released)
    on_pointer_button(s.handle, null, 0, 1300, 272, wl_pointer_button_state_pressed)
    on_pointer_button(s.handle, null, 0, 1350, 272, wl_pointer_button_state_released)
    on_pointer_button(s.handle, null, 0, 1600, 272, wl_pointer_button_state_pressed)
    drain("triple", s)
    on_pointer_button(s.handle, null, 0, 2100, 272, wl_pointer_button_state_pressed)
    drain("late", s)
    on_pointer_button(s.handle, null, 0, 2200, 273, wl_pointer_button_state_pressed)
    drain("other button", s)
    on_pointer_axis(s.handle, null, 0, wl_pointer_axis_vertical_scroll, 2560)
    drain("vertical", s)
    on_pointer_axis(s.handle, null, 0, wl_pointer_axis_horizontal_scroll, -1280)
    drain("horizontal", s)
    hold(s, 1)
    on_pointer_axis(s.handle, null, 0, wl_pointer_axis_vertical_scroll, 2560)
    drain("shift vertical", s)
    hold(s, 5)
    on_pointer_axis(s.handle, null, 0, wl_pointer_axis_horizontal_scroll, 1280)
    drain("shift control horizontal", s)
    hold(s, 0)
    on_pointer_leave(s.handle, null, 0, null)
    drain("leave", s)
    on_keyboard_enter(s.handle, null, 0, null, null)
    drain("focus", s)
    on_keyboard_leave(s.handle, null, 0, null)
    drain("blur", s)
    on_toplevel_close(s.handle, null)
    drain("close", s)
}

fn composing(s: *WindowState) {
    on_preedit_string(s.handle, null, cstr("ka"), 2, 2)
    on_text_done(s.handle, null, 1)
    drain("composition while off", s)
    s.text_enabled = true
    on_preedit_string(s.handle, null, cstr("ka"), 2, 2)
    drain("preedit before done", s)
    on_text_done(s.handle, null, 1)
    drain("preedit", s)
    on_preedit_string(s.handle, null, cstr("かな"), 0, 6)
    on_text_done(s.handle, null, 2)
    drain("preedit selected", s)
    on_commit_string(s.handle, null, cstr("仮名"))
    on_text_done(s.handle, null, 3)
    drain("commit", s)
    on_commit_string(s.handle, null, cstr("x"))
    on_text_done(s.handle, null, 4)
    drain("commit alone", s)
    on_preedit_string(s.handle, null, null, -1, -1)
    on_text_done(s.handle, null, 5)
    drain("empty done", s)
    on_preedit_string(s.handle, null, cstr("a"), -1, -1)
    on_text_done(s.handle, null, 6)
    drain("hidden cursor", s)
    on_text_leave(s.handle, null, null)
    drain("leave", s)
    print("enabled after leave {s.text_enabled}")
    let surface: ptr = malloc(8)
    let elsewhere: ptr = malloc(8)
    s.surface = surface
    on_text_enter(s.handle, null, elsewhere)
    print("entered elsewhere {s.text_entered}")
    on_text_enter(s.handle, null, surface)
    print("entered {s.text_entered}")
    set_window_text_input(s, Caret { x: 1, y: 2, width: 0, height: 16 })
    print("caret kept {s.caret == Caret { x: 1, y: 2, width: 0, height: 16 }} enabled {s.text_enabled}")
    set_window_text_input(s, none)
    print("caret cleared {s.caret == none}")
    s.surface = null
    free(elsewhere)
    free(surface)
}

struct ShapeCase {
    cursor: Cursor
    name: str
    shape: u32
}

fn shape_cases() -> []ShapeCase {
    [
        ShapeCase { cursor: Cursor.Arrow, name: "Arrow", shape: wp_cursor_shape_device_v1_shape_default }
        ShapeCase { cursor: Cursor.Text, name: "Text", shape: wp_cursor_shape_device_v1_shape_text }
        ShapeCase { cursor: Cursor.Pointer, name: "Pointer", shape: wp_cursor_shape_device_v1_shape_pointer }
        ShapeCase { cursor: Cursor.Crosshair, name: "Crosshair", shape: wp_cursor_shape_device_v1_shape_crosshair }
        ShapeCase { cursor: Cursor.Grab, name: "Grab", shape: wp_cursor_shape_device_v1_shape_grab }
        ShapeCase { cursor: Cursor.Grabbing, name: "Grabbing", shape: wp_cursor_shape_device_v1_shape_grabbing }
        ShapeCase { cursor: Cursor.NotAllowed, name: "NotAllowed", shape: wp_cursor_shape_device_v1_shape_not_allowed }
        ShapeCase { cursor: Cursor.Move, name: "Move", shape: wp_cursor_shape_device_v1_shape_move }
        ShapeCase { cursor: Cursor.Wait, name: "Wait", shape: wp_cursor_shape_device_v1_shape_wait }
        ShapeCase { cursor: Cursor.Progress, name: "Progress", shape: wp_cursor_shape_device_v1_shape_progress }
        ShapeCase { cursor: Cursor.Help, name: "Help", shape: wp_cursor_shape_device_v1_shape_help }
        ShapeCase { cursor: Cursor.ResizeLeftRight, name: "ResizeLeftRight", shape: wp_cursor_shape_device_v1_shape_ew_resize }
        ShapeCase { cursor: Cursor.ResizeUpDown, name: "ResizeUpDown", shape: wp_cursor_shape_device_v1_shape_ns_resize }
        ShapeCase { cursor: Cursor.ResizeUpLeftDownRight, name: "ResizeUpLeftDownRight", shape: wp_cursor_shape_device_v1_shape_nwse_resize }
        ShapeCase { cursor: Cursor.ResizeUpRightDownLeft, name: "ResizeUpRightDownLeft", shape: wp_cursor_shape_device_v1_shape_nesw_resize }
        ShapeCase { cursor: Cursor.Hidden, name: "Hidden", shape: wp_cursor_shape_device_v1_shape_default }
    ]
}

fn cursors(s: *WindowState) {
    for c in shape_cases() {
        set_window_cursor(s, c.cursor)
        print("cursor {c.name} shape {cursor_shape(c.cursor) == c.shape} kept {s.cursor == c.cursor}")
    }
    on_pointer_enter(s.handle, null, 7, null, 0, 0)
    drain("cursor enter", s)
    print("pointer inside {s.pointer_inside} serial {s.enter_serial} shown {show_cursor(s)}")
    on_pointer_leave(s.handle, null, 8, null)
    drain("cursor leave", s)
    print("pointer inside {s.pointer_inside}")
}

fn read_pipe(fd: i64) -> str {
    let buffer = io.buffer(64)
    var out: []u8 = []
    for {
        let n = sys.try_read(fd, buffer) or 0
        if n <= 0 {
            return str(out)
        }
        io.append(mut out, buffer[..n])
    }
    str(out)
}

fn send(s: *WindowState, source: ptr, mime: str) -> str {
    let ends = sys.pipe(true) or {
        return "no pipe"
    }
    on_source_send(s.handle, source, cstr(mime), i32(ends.second))
    let got = read_pipe(ends.first)
    sys.close_fd(ends.first)
    got
}

fn drained(text: str, close_first: bool) -> str {
    let ends = sys.pipe(true) or {
        return "no pipe"
    }
    if text != "" {
        sys.write_all(ends.second, bytes(text)) or {}
    }
    if close_first {
        sys.close_fd(ends.second)
    }
    let got = drain_pipe(ends.first)
    sys.close_fd(ends.first)
    if !close_first {
        sys.close_fd(ends.second)
    }
    got
}

fn receiving() {
    let whole = drained("héllo\nline", true)
    print("received [{whole}]")
    let empty = drained("", true)
    print("received nothing [{empty}]")
    let start = time.monotonic()
    let idle = drained("kept", false)
    let waited = (time.monotonic() - start) / 1000000
    print("received without end [{idle}] waited {waited + 1 >= clipboard_read_ms} {waited < 5 * clipboard_read_ms}")
}

fn pasting(s: *WindowState) {
    let offer: ptr = malloc(8)
    let source: ptr = malloc(8)
    let other: ptr = malloc(8)
    s.incoming = offer
    on_offer_type(s.handle, offer, cstr("text/html"))
    print("html [{s.incoming_type}]")
    on_offer_type(s.handle, offer, cstr("text/plain"))
    print("plain [{s.incoming_type}]")
    on_offer_type(s.handle, offer, cstr("text/plain;charset=utf-8"))
    print("utf-8 [{s.incoming_type}]")
    on_offer_type(s.handle, offer, cstr("text/plain"))
    print("plain again [{s.incoming_type}]")
    on_offer_type(s.handle, other, cstr("text/plain"))
    print("other offer [{s.incoming_type}]")
    on_selection(s.handle, null, offer)
    print("selection [{s.selection_type}] taken {s.selection == offer} incoming {s.incoming == null}")
    s.selection = null
    s.selection_type = ""
    s.source = source
    s.source_text = "héllo\nline"
    let utf8 = send(s, source, "text/plain;charset=utf-8")
    let plain = send(s, source, "text/plain")
    let html = send(s, source, "text/html")
    let foreign = send(s, other, "text/plain")
    print("sent utf-8 [{utf8}]")
    print("sent plain [{plain}]")
    print("sent html [{html}]")
    print("sent for another source [{foreign}]")
    s.source = null
    s.source_text = ""
    free(other)
    free(source)
    free(offer)
}

fn sizes(s: *WindowState) {
    s.requested_width = 320
    apply_configure(s)
    drain("first configure", s)
    s.pending_width = 640
    s.pending_height = 480
    apply_configure(s)
    drain("resized", s)
    apply_configure(s)
    drain("repeated", s)
    s.pending_width = 0
    s.pending_height = 0
    apply_configure(s)
    drain("zero keeps the size", s)
    print("scale changed {apply_scale(s, 2)}")
    drain("scale 2", s)
    print("scale changed {apply_scale(s, 2)}")
    drain("scale 2 again", s)
    print("scale changed {apply_scale(s, 0)}")
    drain("scale 0", s)
}

fn main() {
    let s = fixture() or {
        print("no keymap")
        return
    }
    keys(s)
    repeating(s)
    pointer(s)
    composing(s)
    cursors(s)
    pasting(s)
    receiving()
    sizes(s)
    stop_keys(s)
    unpin(s.handle)
}
