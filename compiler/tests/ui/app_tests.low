import target
import std/os
import std/testing
import std/text

fn require_compositor(t: *testing.T) {
    if target.host() != target.OS.Linux {
        return
    }
    require_library(t, "wayland-client")
    require_library(t, "xkbcommon")
    let display = os.env("WAYLAND_DISPLAY") ?? ""
    if display.len == 0 {
        t.skip("no Wayland compositor to connect to")
    }
}

fn test_app(t: *testing.T) {
    require_vulkan(t)
    require_compositor(t)
    let host = target.host()
    let body = with_temp_dir(t, fn(dir) { run_built_with(dir, "app", host, ["--smoke"]) })
    if text.starts_with(body, no_display) {
        t.skip("the program could not connect to a compositor")
    }
    if text.starts_with(body, no_device) {
        t.skip("no Vulkan 1.3 device that presents to a window")
    }
    expect_lines(t, lines_of(body), ["clicks 1", "name hi"])
}
