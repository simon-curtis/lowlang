import std/testing
import std/text

struct Pixel {
    r: i64
    g: i64
    b: i64
    a: i64
}

struct Point {
    x: i64
    y: i64
}

struct Frame {
    width: i64
    height: i64
    pixels: []u8
}

struct Output {
    frames: [str: Frame]
    lines: []str
}

struct Header {
    name: str
    width: i64
    height: i64
}

fn rgba(r: i64, g: i64, b: i64, a: i64) -> Pixel {
    Pixel { r, g, b, a }
}

fn opaque(r: i64, g: i64, b: i64) -> Pixel {
    Pixel { r, g, b, a: 255 }
}

fn points(coordinates: []i64) -> []Point {
    var out: []Point = []
    var i = 0
    for i + 1 < coordinates.len {
        push(mut out, Point { x: coordinates[i], y: coordinates[i + 1] })
        i += 2
    }
    out
}

fn pixel_text(p: Pixel) -> str {
    "[{p.r} {p.g} {p.b} {p.a}]"
}

fn same_pixel(a: Pixel, b: Pixel) -> bool {
    a.r == b.r && a.g == b.g && a.b == b.b && a.a == b.a
}

fn abs(n: i64) -> i64 {
    if n < 0 {
        return -n
    }
    n
}

fn image_header(line: str) -> Header? {
    let parts = text.fields(line)
    if parts.len < 4 || parts[0] != "image" {
        return none
    }
    let width = text.parse_int(parts[2]) catch {
        _ => return none
    }
    let height = text.parse_int(parts[3]) catch {
        _ => return none
    }
    Header { name: parts[1], width, height }
}

fn image_rows(t: *testing.T, h: Header, rows: []str) -> []u8? {
    var pixels: []u8 = []
    for row in rows {
        let data = text.decode_hex(text.trim_prefix(row, "0x")) catch {
            _ => {
                t.fatal("image {h.name}: bad row {text.quote(row)}")
                return none
            }
        }
        if data.len != h.width * 4 {
            t.fatal("image {h.name}: bad row {text.quote(row)}")
            return none
        }
        for b in data {
            push(mut pixels, b)
        }
    }
    pixels
}

fn parse_output(t: *testing.T, body: str) -> Output {
    var out = Output { frames: [:], lines: [] }
    let lines = text.split(text.trim_suffix(body, "\n"), '\n')
    var i = 0
    for i < lines.len {
        match image_header(lines[i]) {
            some(h) => {
                if i + h.height >= lines.len {
                    t.fatal("image {h.name} is cut short")
                    return out
                }
                let pixels = image_rows(t, h, lines[i + 1..i + 1 + h.height]) ?? return out
                out.frames[h.name] = Frame { width: h.width, height: h.height, pixels }
                i += h.height + 1
            }
            none => {
                push(mut out.lines, lines[i])
                i += 1
            }
        }
    }
    out
}

fn frame(t: *testing.T, out: Output, name: str) -> Frame {
    match out.frames[name] {
        some(f) => f
        none => {
            t.fatal("the program printed no image {text.quote(name)}")
            Frame { width: 0, height: 0, pixels: [] }
        }
    }
}

fn at(f: Frame, x: i64, y: i64) -> Pixel {
    if x < 0 || y < 0 || x >= f.width || y >= f.height {
        panic("pixel {x},{y} outside {f.width}x{f.height}")
    }
    let i = (y * f.width + x) * 4
    Pixel { r: i64(f.pixels[i]), g: i64(f.pixels[i + 1]), b: i64(f.pixels[i + 2]), a: i64(f.pixels[i + 3]) }
}

fn expect(t: *testing.T, f: Frame, x: i64, y: i64, want: Pixel, tolerance: i64) {
    let got = at(f, x, y)
    let close = abs(got.r - want.r) <= tolerance && abs(got.g - want.g) <= tolerance && abs(got.b - want.b) <= tolerance && abs(got.a - want.a) <= tolerance
    if !close {
        t.error("pixel {x},{y} = {pixel_text(got)}, want {pixel_text(want)} within {tolerance}")
    }
}

fn expect_all(t: *testing.T, f: Frame, want: Pixel, tolerance: i64, spots: []i64) {
    for p in points(spots) {
        expect(t, f, p.x, p.y, want, tolerance)
    }
}
