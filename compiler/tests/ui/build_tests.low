import target
import std/file
import std/os
import std/sync
import std/testing
import std/text

fn windows_libraries(name: str) -> []str {
    if name == "app" {
        return ["vulkan-1.dll", "user32.dll", "kernel32.dll", "dwmapi.dll"]
    }
    if name == "win32_hidden" || name == "win32_border" ||name == "win32_appreveal" || name == "win32_apptool" {
        return ["user32.dll", "dwmapi.dll"]
    }
    if name == "win32_twopresent" {
        return ["vulkan-1.dll", "user32.dll", "gdi32.dll"]
    }
    if text.starts_with(name, "win32_") || name == "wayland_window" || name == "wayland_reopen" || name == "wayland_clipboard" || name == "wayland_wait" {
        return ["user32.dll"]
    }
    ["vulkan-1.dll"]
}

fn windows_executable(dir: str, name: str) -> str ! Failure {
    let binary = file.child_path(dir, "{name}.exe")
    let source = "{testdata_dir}/{name}"
    build_path(source, target.OS.Windows, binary)?
    let data = file.read_file(binary) catch {
        e => fail Failed("{binary}: {e}")
    }
    text.lower(str(data))
}

struct WindowsBuild {
    name: str
    missing: []str = []
    failure: str = ""
}

fn windows_build(name: str) -> WindowsBuild {
    let dir = file.temp_dir("uitest-") catch {
        e => return WindowsBuild { name, failure: "create a temporary directory: {e}" }
    }
    defer file.remove_all(dir) or {}
    let lowered = windows_executable(dir, name) catch {
        Failed(message) => return WindowsBuild { name, failure: message }
    }
    var missing: []str = []
    for library in windows_libraries(name) {
        if !text.contains(lowered, library) {
            missing.push(library)
        }
    }
    WindowsBuild { name, missing }
}

fn build_in_parallel(names: []str, index: i64, builds: []WindowsBuild, permits: sync.Semaphore, group: sync.WaitGroup) {
    sync.acquire(permits)
    builds[index] = windows_build(names[index])
    sync.release(permits)
    sync.done(group)
}

fn windows_builds(names: []str) -> []WindowsBuild {
    var builds: []WindowsBuild = []
    for name in names {
        builds.push(WindowsBuild { name })
    }
    let group = sync.wait_group()
    let permits = sync.semaphore(os.cpu_count())
    for i in 0..names.len {
        sync.add(group, 1)
        spawn build_in_parallel(names, i, builds, permits, group)
    }
    sync.wait(group)
    builds
}

fn check_windows_build(t: *testing.T, b: WindowsBuild) {
    if b.failure != "" {
        t.fatal(b.failure)
        return
    }
    for library in b.missing {
        t.error("the Windows executable does not import {library}")
    }
}

fn test_windows_builds(t: *testing.T) {
    let builds = windows_builds(program_names(t))
    t.table_of(builds, fn(b) { b.name }, check_windows_build)
}
