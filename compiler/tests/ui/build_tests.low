import target
import std/file
import std/testing
import std/text

fn windows_library(name: str) -> str {
    if text.starts_with(name, "win32_") || name == "wayland_window" || name == "wayland_reopen" {
        return "user32.dll"
    }
    "vulkan-1.dll"
}

fn windows_executable(dir: str, name: str) -> str ! Failure {
    let binary = file.child_path(dir, "{name}.exe")
    let source = "{testdata_dir}/{name}"
    build_path(source, target.OS.Windows, binary)?
    let data = file.read_file(binary) catch {
        e => fail Failed("{binary}: {e}")
    }
    text.lower(str(data))
}

fn check_windows_build(t: *testing.T, name: str) {
    let lowered = with_temp_dir(t, fn(dir) { windows_executable(dir, name) })
    let library = windows_library(name)
    if !text.contains(lowered, library) {
        t.error("the Windows executable does not import {library}")
    }
}

fn test_windows_builds(t: *testing.T) {
    let names = program_names(t)
    t.table_of(names, fn(name) { name }, check_windows_build)
}
