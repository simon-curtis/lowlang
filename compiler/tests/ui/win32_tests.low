                "title renamed"
                "taskbar false on an owned window leaves WS_EX_APPWINDOW clear true"
                "taskbar false on an unowned window is a tool window true"
                "an owner from another display fails with Unsupported: the owner window belongs to another display"
                "plain centring would leave the work area true"
                "clamped inside the work area true"
                "the system destroyed the owned window true"
                "its handle is cleared true"
                "next returns the close once true"
                "next afterwards fails with Unsupported: the window has closed"
                "releasing it reports no failure true"
                "the system destroyed window gave back its drop target pins true"
                "40 owned windows destroyed by the system left their pins free true"
                "40 owners released first left their pins free true"
