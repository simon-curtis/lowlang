import target
import std/file
import std/process
import std/testing
import std/text

const skip_prefix = "skip "

struct Win32Case {
    name: str
    want: []str
    vulkan: bool = false
}

fn run_win32_program(dir: str, name: str) -> str ! Failure {
    let binary = file.child_path(dir, "{name}.exe")
    let source = "{testdata_dir}/{name}"
    build_path(source, target.OS.Windows, binary)?
    let direct = process.command(binary, [])
    execute(direct)
}

fn run_win32(t: *testing.T, name: str, vulkan: bool) -> []str {
    if vulkan {
        require_vulkan(t)
    }
    let body = with_temp_dir(t, fn(dir) { run_win32_program(dir, name) })
    if text.starts_with(body, no_display) {
        t.skip("cannot create a window here")
    }
    if text.starts_with(body, no_device) {
        t.skip("no Vulkan 1.3 device")
    }
    if text.starts_with(body, skip_prefix) {
        t.skip(text.trim_suffix(text.trim_prefix(body, skip_prefix), "\n"))
    }
    lines_of(body)
}

fn cursor_lines() -> []str {
    var lines = [
        "away from the window, unchanged true"
        "client hit handled 1 wait true"
    ]
    let names = ["text", "pointer", "crosshair", "grab", "grabbing", "not allowed", "move", "wait", "progress", "help", "left right", "up down", "up left down right", "up right down left", "arrow"]
    for name in names {
        lines.push("over the window, {name} true")
        lines.push("client hit, {name} true")
    }
    for line in [
        "caption hit not handled true"
        "caption hit leaves text true"
        "hidden true"
        "hidden on client hit true"
        "left the window, unchanged true"
        "client hit, help true"
        "move 10 20"
    ] {
        lines.push(line)
    }
    lines
}

