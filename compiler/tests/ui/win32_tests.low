                "enter 0 effect 1"
                "file drag entered 10 20 [C:\\a.txt|C:\\dir\\b c.txt|C:\\café.txt]"
                "over 0 effect 2"
                "file drag moved 15 25"
                "negative screen point maps to the client true"
                "drop 0 effect 4"
                "file dropped 16 26"
                "enter move or link effect 2"
                "file drag entered 1 2 [C:\\a.txt|C:\\dir\\b c.txt|C:\\café.txt]"
                "file drag exited"
                "no files effect 0"
                "no files over effect 0"
