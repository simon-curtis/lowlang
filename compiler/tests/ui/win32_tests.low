fn key_lines() -> []str {
    var lines: []str = []
    let named = ["Enter", "Escape", "Tab", "Backspace", "Delete", "Left", "Right", "Up", "Down", "Home", "End", "PageUp", "PageDown", "F1", "F12"]
    for key in named {
        lines.push("key press {key} text=")
        lines.push("key release {key} text=")
    }
    for line in [
        "key press 'a' text=a"
        "key press 'a' text=a repeat"
        "key release 'a' text="
        "key press ' ' text= "
        "key release ' ' text="
        "key press 'A' text=A shift"
        "key release 'A' text= shift"
        "key press 'a' text= control"
        "key release 'a' text= control"
        "key press Enter text= control"
        "key press Left text= shift control alt"
        "key press 'x' text=x alt"
        "key release 'x' text= alt"
        "key press 'a' text=😀"
        "key release 'a' text="
        "key press 'a' text=é"
        "key release 'a' text="
    ] {
        lines.push(line)
    }
    lines
}

fn win32_cases() -> []Win32Case {
    [
        Win32Case {
            name: "win32_open"
            want: repeated(2, [
                "native true true"
                "resized 320 200"
                "scale true"
                "client true"
                "no events"
            ])
        }
        Win32Case {
            name: "win32_hidden"
            want: [
                "opened without hidden: visible true cloaked 0"
                "shown anyway: visible true cloaked 0"
                "resized 320 200"
                "opened hidden: visible true cloaked 1"
                "cloaked by the app true"
                "client is the requested size true"
                "shown: visible true cloaked 0"
                "shown again: visible true cloaked 0"
                "no events"
            ]
        }
        Win32Case {
            name: "win32_pair"
            want: repeated(2, [
                "same window false"
                "scroll 0 -48"
                "close"
                "no events"
                "close"
            ])
        }
        Win32Case {
            name: "win32_mouse"
            want: [
                "move 10 20"
                "move 11 -3"
                "leave"
                "move 10 20"
                "down left 4 5"
                "up left 4 5"
                "down right 6 7"
                "up right 6 7"
                "down middle 8 9"
                "up middle 8 9"
                "down back 1 2"
                "up back 1 2"
                "down forward 3 4"
                "up forward 3 4"
                "scroll 0 -48"
                "scroll 0 96"
                "scroll 24 0"
                "scroll -48 0"
                "down left 10 20"
                "down right 10 20"
                "up left 10 20"
                "up right 10 20"
                "down left 10 20"
                "up left 10 20"
                "down left 10 20 x2 control"
                "up left 10 20 x2 control"
                "down left 10 20 x3 shift"
                "up left 10 20 x3"
                "down left 60 20"
                "up left 60 20"
            ]
        }
        Win32Case { name: "win32_keys", want: key_lines() }
        Win32Case {
            name: "win32_window"
            want: [
                "focus true"
                "focus false"
                "close"
                "move 5 6"
                "resized 400 300"
                "resized 401 301"
                "resized scale 2 sized true"
                "resized scale 1 sized true"
                "resized scale 1.25 sized true"
                "resized scale 1.5 sized true"
            ]
        }
        Win32Case {
            name: "win32_clipboard"
            want: [
                "roundtrip true"
                "units 13 55357 56832 10"
                "replaced true"
                "empty true"
                "long true"
                "private true"
                "not text true"
                "cleared true"
            ]
        }
        Win32Case {
            name: "win32_ime"
            want: [
                "start false"
                "on true"
                "moved true"
                "off false"
                "on again true"
                "no events"
                "no events"
                "no events"
                "preedit [a😀é] 7-7"
                "preedit [] hidden"
                "preedit [bc] 2-2"
                "commit [bc]"
                "no events"
                "key press 'a' text=a"
                "key release 'a' text="
                "preedit [d] 1-1"
                "off false"
                "preedit [] hidden"
                "no events"
                "no events"
            ]
        }
        Win32Case { name: "win32_cursor", want: cursor_lines() }
        Win32Case { name: "win32_titlebar", want: titlebar_lines() }
        Win32Case {
            name: "win32_titled"
            want: [
                "client keeps the system frame true"
                "hit content 1"
                "hit area 20"
                "hit system caption 2"
                "move 100 100"
                "leave"
                "hit area 20"
                "close"
            ]
        }
        Win32Case {
            name: "win32_apptitlebar"
            want: [
                "hit drag 2"
                "hit handler inside the drag area 1"
                "hit min 8"
                "hit max 9"
                "hit close 20"
                "hit content 1"
                "restored true"
                "maximised by the max area true"
                "restored by toggle_maximize true"
            ]
        }
        Win32Case {
            name: "win32_appreveal"
            want: [
                "after open: cloaked 1"
                "after the first frame: cloaked 0"
                "empty after open: cloaked 1"
                "before the deadline: cloaked 1"
                "after the deadline: cloaked 0"
            ]
        }
        Win32Case {
            name: "win32_wake"
            want: [
                "no events"
                "woken"
                "woken"
                "woken"
                "woken"
                "move 3 4"
                "no events"
                "woken 3"
                "no events"
            ]
        }
        Win32Case {
            name: "win32_drop"
            want: [
                "query unknown 0 out target"
                "query drop target 0 out target"
                "query data object -2147467262 out null"
                "query near miss -2147467262 out null"
                "query null out -2147467261"
                "add ref 1 release 1"
                "enter 0 effect 1"
                "file drag entered 10 20 [C:\\a.txt|C:\\dir\\b c.txt|C:\\café.txt]"
                "over 0 effect 2"
                "file drag moved 15 25"
                "negative screen point maps to the client true"
                "drop 0 effect 4"
                "file dropped 16 26"
                "enter move or link effect 2"
                "file drag entered 1 2 [C:\\a.txt|C:\\dir\\b c.txt|C:\\café.txt]"
                "file drag exited"
                "no files effect 0"
                "no files over effect 0"
                "no files drop effect 0"
                "no events"
                "target gone after close true"
            ]
        }
    ]
}

fn test_win32(t: *testing.T) {
    if target.host() != target.OS.Windows {
        t.skip("runs Windows programs, which need a Windows host")
    }
    t.table_of(win32_cases(), fn(c) { text.trim_prefix(c.name, "win32_") }, fn(st, c) {
        let got = run_win32(st, c.name)
        compare_lines(st, got, c.want)
    })
}
