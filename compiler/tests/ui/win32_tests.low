import target
import std/file
import std/process
import std/testing
import std/text

const skip_prefix = "skip "

struct Win32Case {
    name: str
    want: []str
}

fn run_win32_program(dir: str, name: str) -> str ! Failure {
    let binary = file.child_path(dir, "{name}.exe")
    let source = "{testdata_dir}/{name}"
    build_path(source, target.OS.Windows, binary)?
    let direct = process.command(binary, [])
    execute(direct)
}

fn run_win32(t: *testing.T, name: str) -> []str {
    let body = with_temp_dir(t, fn(dir) { run_win32_program(dir, name) })
    if text.starts_with(body, no_display) {
        t.skip("cannot create a window here")
    }
    if text.starts_with(body, skip_prefix) {
        t.skip(text.trim_suffix(text.trim_prefix(body, skip_prefix), "\n"))
    }
    lines_of(body)
}

fn cursor_lines() -> []str {
    var lines = [
        "away from the window, unchanged true"
        "client hit handled 1 wait true"
    ]
    let names = ["text", "pointer", "crosshair", "grab", "grabbing", "not allowed", "move", "wait", "progress", "help", "left right", "up down", "up left down right", "up right down left", "arrow"]
    for name in names {
        lines.push("over the window, {name} true")
        lines.push("client hit, {name} true")
    }
    for line in [
        "caption hit not handled true"
        "caption hit leaves text true"
        "hidden true"
        "hidden on client hit true"
        "left the window, unchanged true"
        "client hit, help true"
        "move 10 20"
    ] {
        lines.push(line)
    }
    lines
}

fn key_lines() -> []str {
    var lines: []str = []
    let named = ["Enter", "Escape", "Tab", "Backspace", "Delete", "Left", "Right", "Up", "Down", "Home", "End", "PageUp", "PageDown", "F1", "F12"]
    for key in named {
        lines.push("key press {key} text=")
        lines.push("key release {key} text=")
    }
    for line in [
        "key press 'a' text=a"
        "key press 'a' text=a repeat"
        "key release 'a' text="
        "key press ' ' text= "
        "key release ' ' text="
        "key press 'A' text=A shift"
        "key release 'A' text= shift"
        "key press 'a' text= control"
        "key release 'a' text= control"
        "key press Enter text= control"
        "key press Left text= shift control alt"
        "key press 'x' text=x alt"
        "key release 'x' text= alt"
        "key press 'a' text=😀"
        "key release 'a' text="
        "key press 'a' text=é"
        "key release 'a' text="
    ] {
        lines.push(line)
    }
    lines
}

fn win32_cases() -> []Win32Case {
    [
        Win32Case {
            name: "win32_open"
            want: repeated(2, [
                "native true true"
                "resized 320 200"
                "scale true"
                "client true"
                "no events"
            ])
        }
        Win32Case {
            name: "win32_pair"
            want: repeated(2, [
                "same window false"
                "scroll 0 -48"
                "close"
                "no events"
                "close"
            ])
        }
        Win32Case {
            name: "win32_mouse"
            want: [
                "move 10 20"
                "move 11 -3"
                "leave"
                "move 10 20"
                "down left 4 5"
                "up left 4 5"
                "down right 6 7"
                "up right 6 7"
                "down middle 8 9"
                "up middle 8 9"
                "down back 1 2"
                "up back 1 2"
                "down forward 3 4"
                "up forward 3 4"
                "scroll 0 -48"
                "scroll 0 96"
                "scroll 24 0"
                "scroll -48 0"
                "down left 10 20"
                "down right 10 20"
                "up left 10 20"
                "up right 10 20"
                "down left 10 20"
                "up left 10 20"
                "down left 10 20 x2 control"
                "up left 10 20 x2 control"
                "down left 10 20 x3 shift"
                "up left 10 20 x3"
                "down left 60 20"
                "up left 60 20"
            ]
        }
        Win32Case { name: "win32_keys", want: key_lines() }
        Win32Case {
            name: "win32_window"
            want: [
                "focus true"
                "focus false"
                "close"
                "move 5 6"
                "resized 400 300"
                "resized 401 301"
                "resized scale 2 sized true"
                "resized scale 1 sized true"
                "resized scale 1.25 sized true"
                "resized scale 1.5 sized true"
            ]
        }
        Win32Case {
            name: "win32_clipboard"
            want: [
                "roundtrip true"
                "units 13 55357 56832 10"
                "replaced true"
                "empty true"
                "long true"
                "private true"
                "not text true"
                "cleared true"
            ]
        }
        Win32Case {
            name: "win32_ime"
            want: [
                "start false"
                "on true"
                "moved true"
                "off false"
                "on again true"
                "no events"
                "no events"
                "no events"
                "preedit [a😀é] 7-7"
                "preedit [] hidden"
                "preedit [bc] 2-2"
                "commit [bc]"
                "no events"
                "key press 'a' text=a"
                "key release 'a' text="
                "preedit [d] 1-1"
                "off false"
                "preedit [] hidden"
                "no events"
                "no events"
            ]
        }
        Win32Case { name: "win32_cursor", want: cursor_lines() }
        Win32Case {
            name: "win32_wake"
            want: [
                "no events"
                "woken"
                "woken"
                "woken"
                "woken"
                "move 3 4"
                "no events"
                "woken 3"
                "no events"
            ]
        }
    ]
}

fn test_win32(t: *testing.T) {
    if target.host() != target.OS.Windows {
        t.skip("runs Windows programs, which need a Windows host")
    }
    t.table_of(win32_cases(), fn(c) { text.trim_prefix(c.name, "win32_") }, fn(st, c) {
        let got = run_win32(st, c.name)
        compare_lines(st, got, c.want)
    })
}
