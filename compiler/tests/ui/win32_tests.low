import target
import std/file
import std/process
import std/testing
import std/text

struct Win32Case {
    name: str
    want: []str
}

fn run_win32_program(dir: str, name: str) -> str ! Failure {
    let binary = file.child_path(dir, "{name}.exe")
    let source = "{testdata_dir}/{name}"
    build_path(source, target.OS.Windows, binary)?
    let direct = process.command(binary, [])
    execute(direct)
}

fn run_win32(t: *testing.T, name: str) -> []str {
    let body = with_temp_dir(t, fn(dir) { run_win32_program(dir, name) })
    if text.starts_with(body, no_display) {
        t.skip("cannot create a window here")
    }
    lines_of(body)
}

fn key_lines() -> []str {
    var lines: []str = []
    let named = ["Enter", "Escape", "Tab", "Backspace", "Delete", "Left", "Right", "Up", "Down", "Home", "End", "PageUp", "PageDown", "F1", "F12"]
    for key in named {
        push(mut lines, "key press {key} text=")
        push(mut lines, "key release {key} text=")
    }
    for line in [
        "key press 'a' text=a"
        "key press 'a' text=a repeat"
        "key release 'a' text="
        "key press ' ' text= "
        "key release ' ' text="
        "key press 'A' text=A shift"
        "key release 'A' text= shift"
        "key press 'a' text= control"
        "key release 'a' text= control"
        "key press Enter text= control"
        "key press Left text= shift control alt"
        "key press 'x' text=x alt"
        "key release 'x' text= alt"
        "key press 'a' text=😀"
        "key release 'a' text="
        "key press 'a' text=é"
        "key release 'a' text="
    ] {
        push(mut lines, line)
    }
    lines
}

fn win32_cases() -> []Win32Case {
    [
        Win32Case {
            name: "win32_open"
            want: repeated(2, [
                "native true true"
                "resized 320 200"
                "scale true"
                "client true"
                "no events"
            ])
        }
        Win32Case {
            name: "win32_pair"
            want: repeated(2, [
                "same window false"
                "scroll 0 -48"
                "close"
                "no events"
                "close"
            ])
        }
        Win32Case {
            name: "win32_mouse"
            want: [
                "move 10 20"
                "move 11 -3"
                "leave"
                "move 10 20"
                "down left 4 5"
                "up left 4 5"
                "down right 6 7"
                "up right 6 7"
                "down middle 8 9"
                "up middle 8 9"
                "down other4 1 2"
                "up other4 1 2"
                "down other5 3 4"
                "up other5 3 4"
                "scroll 0 -48"
                "scroll 0 96"
                "scroll 24 0"
                "scroll -48 0"
                "down left 10 20"
                "down right 10 20"
                "up left 10 20"
                "up right 10 20"
            ]
        }
        Win32Case { name: "win32_keys", want: key_lines() }
        Win32Case {
            name: "win32_window"
            want: [
                "focus true"
                "focus false"
                "close"
                "move 5 6"
                "resized 400 300"
                "resized 401 301"
                "resized scale 2 sized true"
                "resized scale 1 sized true"
                "resized scale 1 sized true"
                "resized scale 2 sized true"
            ]
        }
        Win32Case {
            name: "win32_wake"
            want: [
                "no events"
                "woken"
                "woken"
                "woken"
                "woken"
                "move 3 4"
                "no events"
                "woken 3"
                "no events"
            ]
        }
    ]
}

fn test_win32(t: *testing.T) {
    if target.host() != target.OS.Windows {
        t.skip("runs Windows programs, which need a Windows host")
    }
    t.table_of(win32_cases(), fn(c) { text.trim_prefix(c.name, "win32_") }, fn(st, c) {
        let got = run_win32(st, c.name)
        compare_lines(st, got, c.want)
    })
}
