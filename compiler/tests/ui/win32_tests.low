        Win32Case {
            name: "win32_windowhandles"
            want: repeated(2, [
                "a closure holding a handle set the title true"
                "a closure holding a handle waited and was woken true"
                "a detached window stays open after its owner is released true"
                "close_on closed it true"
                "a second close_on does nothing true"
                "a closed window has null native handles true"
                "next_on on a closed window fails with Unsupported: the window has closed"
                "the clipboard of a closed window fails with Unsupported: the window has closed"
                "the other operations on a closed window do nothing true"
                "an adopted handle closes the window when its owner is released true"
                "close_on after the release does nothing true"
                "an owner that has closed fails with Unsupported: the owner window has closed"
                "next_on returned the close of a window the system destroyed true"
                "close_on after the system destroyed it does nothing true"
