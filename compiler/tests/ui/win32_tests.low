fn key_lines() -> []str {
    var lines: []str = []
    let named = ["Enter", "Escape", "Tab", "Backspace", "Delete", "Left", "Right", "Up", "Down", "Home", "End", "PageUp", "PageDown", "Insert", "Pause", "Break", "Menu", "F1", "F12"]
    for key in named {
        lines.push("key press {key} text=")
        lines.push("key release {key} text=")
    }
    for line in [
        "key press 'a' text=a"
        "key press 'a' text=a repeat"
        "key release 'a' text="
        "key press ' ' text= "
        "key release ' ' text="
        "key press 'A' text=A shift"
        "key release 'A' text= shift"
        "key press 'a' text= control"
        "key release 'a' text= control"
        "key press Enter text= control"
        "key press Left text= shift control alt"
        "key press 'x' text=x alt"
        "key release 'x' text= alt"
        "key press 'a' text=😀"
        "key release 'a' text="
        "key press 'a' text=é"
        "key release 'a' text="
    ] {
        lines.push(line)
    }
    lines
}

fn win32_cases() -> []Win32Case {
    [
        Win32Case {
            name: "win32_open"
            want: repeated(2, [
                "native true true"
                "a window opened with activate false is neither the foreground nor the active window true"
                "resized 320 200"
                "scale true"
                "client true"
                "no events"
            ])
        }
        Win32Case {
            name: "win32_hidden"
            want: [
                "opened without hidden: visible true cloaked 0"
                "shown anyway: visible true cloaked 0"
                "resized 320 200"
                "opened hidden: visible true cloaked 1"
                "cloaked by the app true"
                "client is the requested size true"
                "shown: visible true cloaked 0"
                "shown again: visible true cloaked 0"
                "no events"
            ]
        }
        Win32Case {
            name: "win32_border"
            want: [
                "the frame shows the border as 0x00BBGGRR true"
                "the frame shows an asymmetric border with red and blue swapped true"
                "the asymmetric border is not the grey one true"
                "a window with no border leaves the system's true"
            ]
        }
        Win32Case {
            name: "win32_pair"
            want: repeated(2, [
                "same window false"
                "scroll 0 -48"
                "close"
                "no events"
                "close"
            ])
        }
        Win32Case {
            name: "win32_classonce"
            want: repeated(2, [
                "before any display: window class false waker class false"
                "display open: window class false waker class true"
                "two windows open: window class true waker class true"
                "the first window closed: window class true waker class true"
                "both windows closed: window class true waker class true"
                "two windows open: window class true waker class true"
                "the second window closed: window class true waker class true"
                "both windows closed: window class true waker class true"
                "a window opened again: window class true waker class true"
                "display closed: window class false waker class false"
                "a window opened by open: window class true waker class true"
                "that window closed: window class false waker class false"
                "two displays open: window class false waker class true"
                "the second display closed: window class false waker class true"
                "a window opened in the first display: window class true waker class true"
                "the first display closed: window class false waker class false"
                "a window opened by open closed: window class false waker class true"
                "a window opened in the held display: window class true waker class true"
                "the held display closed: window class false waker class false"
            ])
        }
        Win32Case {
            name: "win32_mouse"
            want: [
                "move 10 20"
                "move 11 -3"
                "leave"
                "move 10 20"
                "down left 4 5"
                "up left 4 5"
                "down right 6 7"
                "up right 6 7"
                "down middle 8 9"
                "up middle 8 9"
                "down back 1 2"
                "up back 1 2"
                "down forward 3 4"
                "up forward 3 4"
                "scroll 0 -48"
                "scroll 0 96"
                "scroll 24 0"
                "scroll -48 0"
                "scroll 0 -48 shift"
                "scroll 0 -48 control"
                "scroll 0 -48 shift control"
                "scroll 48 0 shift"
                "scroll 0 -48 shift alt"
                "down left 10 20"
                "down right 10 20"
                "up left 10 20"
                "up right 10 20"
                "down left 10 20"
                "up left 10 20"
                "down left 10 20 x2 control"
                "up left 10 20 x2 control"
                "down left 10 20 x3 shift"
                "up left 10 20 x3"
                "down left 60 20"
                "up left 60 20"
            ]
        }
        Win32Case { name: "win32_keys", want: key_lines() }
        Win32Case {
            name: "win32_window"
            want: [
                "focus true"
                "focus false"
                "close"
                "move 5 6"
                "resized 400 300"
                "resized 401 301"
                "resized scale 2 sized true"
                "resized scale 1 sized true"
                "resized scale 1.25 sized true"
                "resized scale 1.5 sized true"
            ]
        }
        Win32Case {
            name: "win32_clipboard"
            want: [
                "roundtrip true"
                "units 13 55357 56832 10"
                "replaced true"
                "empty true"
                "long true"
                "private true"
                "not text true"
                "cleared true"
            ]
        }
        Win32Case {
