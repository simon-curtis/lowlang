import std/os
import std/testing

const slow_timeout = 900000

fn main() {
    let tests = [
        testing.Test { name: "quads", run: test_quads }
        testing.Test { name: "shadow", run: test_shadow }
        testing.Test { name: "gpui_parity_shapes", run: test_shapes_match_the_pixels_gpui_draws }
        testing.Test { name: "gpui_parity_text_area", run: test_text_area_matches_the_pixels_gpui_draws }
        testing.Test { name: "gpui_parity_group_hover", run: test_group_hover_matches_the_pixels_gpui_draws }
        testing.Test { name: "gpui_parity_virtual_lists", run: test_virtual_lists_match_the_pixels_gpui_draws }
        testing.Test { name: "gpui_parity_overlays", run: test_overlays_match_the_pixels_gpui_draws }
        testing.Test { name: "gpui_parity_placeholder", run: test_placeholder_matches_the_pixels_gpui_draws }
        testing.Test { name: "sprites", run: test_sprites }
        testing.Test { name: "subpixel_sprites", run: test_subpixel_sprites }
        testing.Test { name: "polychrome_sprites", run: test_polychrome_sprites }
        testing.Test { name: "clip", run: test_clip }
        testing.Test { name: "draw_order", run: test_draw_order }
        testing.Test { name: "frames_in_flight", run: test_frames_in_flight }
        testing.Test { name: "instance_buffer_growth", run: test_instance_buffer_growth }
        testing.Test { name: "atlas_updates", run: test_atlas_updates }
        testing.Test { name: "elements", run: test_elements }
        testing.Test { name: "app", run: test_app }
        testing.Test { name: "windows_builds", run: test_windows_builds }
        testing.Test { name: "win32", run: test_win32 }
        testing.Test { name: "platform_callbacks", run: test_platform_callbacks }
        testing.Test { name: "wayland_window", run: test_wayland_window }
        testing.Test { name: "wayland_clipboard", run: test_wayland_clipboard }
        testing.Test { name: "wayland_reopen", run: test_wayland_reopen }
        testing.Test { name: "wayland_wait", run: test_wayland_wait }
        testing.Test { name: "wayland_apptool", run: test_wayland_apptool }
        testing.Test { name: "wayland_present", run: test_wayland_present }
        testing.Test { name: "wayland_twopresent", run: test_wayland_twopresent }
    ]
    let args = os.args()
    var settings = testing.settings_from(args[1..]) catch {
        e => {
            print("flags: {e}")
            os.exit(2)
            testing.Settings {}
        }
    }
    let defaults = testing.Settings {}
    if settings.timeout_ms == defaults.timeout_ms {
        settings.timeout_ms = slow_timeout
    }
    let failed = testing.run_with(tests, settings)
    if failed > 0 {
        os.exit(1)
    }
}
