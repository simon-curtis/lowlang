import std/os
import std/testing

const slow_timeout = 900000

fn main() {
    let tests = [
        testing.Test { name: "quads", run: test_quads }
        testing.Test { name: "shadow", run: test_shadow }
        testing.Test { name: "sprites", run: test_sprites }
        testing.Test { name: "clip", run: test_clip }
        testing.Test { name: "draw_order", run: test_draw_order }
        testing.Test { name: "frames_in_flight", run: test_frames_in_flight }
        testing.Test { name: "instance_buffer_growth", run: test_instance_buffer_growth }
        testing.Test { name: "atlas_updates", run: test_atlas_updates }
        testing.Test { name: "windows_builds", run: test_windows_builds }
        testing.Test { name: "win32", run: test_win32 }
        testing.Test { name: "platform_callbacks", run: test_platform_callbacks }
        testing.Test { name: "wayland_window", run: test_wayland_window }
        testing.Test { name: "wayland_reopen", run: test_wayland_reopen }
        testing.Test { name: "wayland_present", run: test_wayland_present }
    ]
    let args = os.args()
    var settings = testing.settings_from(args[1..]) catch {
        e => {
            print("flags: {e}")
            os.exit(2)
            testing.Settings {}
        }
    }
    let defaults = testing.Settings {}
    if settings.timeout_ms == defaults.timeout_ms {
        settings.timeout_ms = slow_timeout
    }
    let failed = testing.run_with(tests, settings)
    if failed > 0 {
        os.exit(1)
    }
}
