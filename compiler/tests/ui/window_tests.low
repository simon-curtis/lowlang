import target
import std/file
import std/process
import std/testing
import std/text

const platform_dir = "internal/compiler/std/ui/platform"
const platform_test_dir = "internal/uitest/platformtest"

fn platform_sources() -> []str {
    var sources: []str = []
    let pattern = "{platform_dir}/*.low"
    for source in file.glob(pattern) {
        if !text.ends_with(source, "_windows.low") {
            push(mut sources, source)
        }
    }
    let main = "{platform_test_dir}/main.low"
    push(mut sources, main)
    sources
}

fn copy_sources(dir: str) ! Failure {
    for source in platform_sources() {
        let parts = text.split(source, '/')
        let destination = file.child_path(dir, parts[parts.len - 1])
        file.copy(source, destination) catch {
            e => fail Failed("{source}: {e}")
        }
    }
}

fn keymap_environment() -> [str: str] {
    environment_with([
        "XKB_DEFAULT_RULES": "evdev"
        "XKB_DEFAULT_MODEL": "pc105"
        "XKB_DEFAULT_LAYOUT": "us"
        "XKB_DEFAULT_VARIANT": ""
        "XKB_DEFAULT_OPTIONS": ""
    ])
}

fn run_platform_program(dir: str) -> str ! Failure {
    copy_sources(dir)?
    let binary = file.child_path(dir, "platformtest")
    build_path(dir, target.OS.Linux, binary)?
    var command = process.command(binary, [])
    command.env = some(keymap_environment())
    execute(command)
}

fn test_platform_callbacks(t: *testing.T) {
    require_linux_host(t)
    require_library(t, "wayland-client")
    require_library(t, "xkbcommon")
    let got = with_temp_dir(t, run_platform_program)
    if text.starts_with(got, "no keymap") {
        t.skip("libxkbcommon has no default keymap")
    }
    let expected_path = "{platform_test_dir}/main.out"
    let want = file.read_text(expected_path) catch {
        e => {
            t.fatal("{expected_path}: {e}")
            return
        }
    }
    if got != want {
        t.error("output:\n{got}\nwant:\n{want}")
    }
}

fn test_wayland_window(t: *testing.T) {
    let got = run_window(t, "wayland_window", [])
    expect_lines(t, got, [
        "resized 320 200 true"
        "idle true true"
        "woken 1 true true"
        "pending 1 true"
        "coalesced 0"
        "idle true true"
        "closing"
    ])
}

fn test_wayland_reopen(t: *testing.T) {
    let got = run_window(t, "wayland_reopen", [])
    expect_lines(t, got, ["cycle 0", "cycle 1", "cycle 2", "cycle 3", "cycle 4", "cycle 5"])
}

fn test_wayland_present(t: *testing.T) {
    let got = run_window(t, "wayland_present", ["vulkan"])
    expect_lines(t, got, [
        "first size"
        "grown"
        "empty"
        "shrunk"
        "restored"
        "offscreen 255 0 0 255"
        "no surface"
    ])
}
