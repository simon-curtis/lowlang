import target
import std/file
import std/process
import std/testing
import std/text

const platform_dir = "std/ui/platform"
const platform_test_dir = "compiler/tests/ui/platformtest"

fn platform_sources() -> []str {
    var sources: []str = []
    let pattern = "{platform_dir}/*.low"
    for source in file.glob(pattern) {
        if !text.ends_with(source, "_windows.low") {
            sources.push(source)
        }
    }
    let main = "{platform_test_dir}/main.low"
    sources.push(main)
    sources
}

fn copy_sources(dir: str) ! Failure {
    for source in platform_sources() {
        let parts = text.split(source, '/')
        let destination = file.child_path(dir, parts[parts.len - 1])
        file.copy(source, destination) catch {
            e => fail Failed("{source}: {e}")
        }
    }
}

fn keymap_environment() -> [str: str] {
    environment_with([
        "XKB_DEFAULT_RULES": "evdev"
        "XKB_DEFAULT_MODEL": "pc105"
        "XKB_DEFAULT_LAYOUT": "us"
        "XKB_DEFAULT_VARIANT": ""
        "XKB_DEFAULT_OPTIONS": ""
    ])
}

fn run_platform_program(dir: str) -> str ! Failure {
    copy_sources(dir)?
    let binary = file.child_path(dir, "platformtest")
    build_path(dir, target.OS.Linux, binary)?
    var command = process.command(binary, [])
    command.env = some(keymap_environment())
    execute(command)
}

fn test_platform_callbacks(t: *testing.T) {
    require_linux_host(t)
    require_library(t, "wayland-client")
    require_library(t, "xkbcommon")
    let got = with_temp_dir(t, run_platform_program)
    if text.starts_with(got, "no keymap") {
        t.skip("libxkbcommon has no default keymap")
    }
    let expected_path = "{platform_test_dir}/main.out"
    let want = file.read_text(expected_path) catch {
        e => {
            t.fatal("{expected_path}: {e}")
            return
        }
    }
    if got != want {
        t.error("output:\n{got}\nwant:\n{want}")
    }
}

fn test_wayland_window(t: *testing.T) {
    let got = run_window(t, "wayland_window", [])
    expect_lines(t, got, [
        "resized 320 200 true"
        "idle true true"
        "woken 1 true true"
        "pending 1 true"
        "coalesced 0"
        "idle true true"
        "closing"
    ])
}

fn test_wayland_clipboard(t: *testing.T) {
    let got = run_window(t, "wayland_clipboard", [])
    expect_lines(t, got, [
        "read \"héllo 😀\\nline\""
        "kept \"héllo 😀\\nline\""
    ])
}

fn test_wayland_reopen(t: *testing.T) {
    let got = run_window(t, "wayland_reopen", [])
    expect_lines(t, got, ["cycle 0", "cycle 1", "cycle 2", "cycle 3", "cycle 4", "cycle 5"])
}

fn test_wayland_wait(t: *testing.T) {
    let got = run_window(t, "wayland_wait", [])
    let round = [
        "nothing pending runs to the timeout true"
        "two wakes ended wait true"
        "a wake already taken runs to the timeout true"
        "a display wake gives windows 0 wakes"
        "a wake from another green thread ended wait true"
        "a wake of the second window ended wait true"
        "woken first 0 second 1"
        "next on the first runs through a wake of the second true"
        "the second keeps its wake 1"
        "a wake after the first window closed ended wait true"
        "a wake with no window open ended wait true"
    ]
    var want = repeated(2, round)
    want.push("next on a window whose display was released fails true")
    want.push("wait on a released display fails true")
    want.push("open in a released display fails true")
    want.push("a wake and a close after release do nothing")
    expect_lines(t, got, want)
}

fn test_wayland_apptool(t: *testing.T) {
    let got = run_window(t, "wayland_apptool", ["vulkan"])
    expect_lines(t, got, [
        "the main window drew its first frame true"
        "open_window opened a second window that drew a frame true"
        "a signal set by a post changed the main window's next frame true"
        "closing the second window ran closed true"
        "run ended"
    ])
}

fn test_wayland_present(t: *testing.T) {
    let got = run_window(t, "wayland_present", ["vulkan"])
    expect_lines(t, got, [
        "first size"
        "grown"
        "empty"
        "shrunk"
        "restored"
        "offscreen 255 0 0 255"
        "no surface"
    ])
}

fn test_wayland_twopresent(t: *testing.T) {
    let got = run_window(t, "wayland_twopresent", ["vulkan"])
    expect_lines(t, got, wayland_twopresent_lines())
}
