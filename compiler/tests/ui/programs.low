import compiler
import gentest
import target
import std/file
import std/os
import std/process
import std/slices
import std/testing
import std/text

const testdata_dir = "internal/uitest/testdata"
const no_device = "no device"
const no_display = "no display"

enum Failure {
    Failed(message: str)
}

fn program_names(t: *testing.T) -> []str {
    var names: []str = []
    let pattern = "{testdata_dir}/*/main.low"
    for main in file.glob(pattern) {
        let parts = text.split(main, '/')
        push(mut names, parts[parts.len - 2])
    }
    if names.len == 0 {
        t.fatal("no programs in testdata")
    }
    names
}

fn require_linux_host(t: *testing.T) {
    if target.host() != target.OS.Linux {
        t.skip("runs Linux binaries, which need a Linux host")
    }
}

fn require_library(t: *testing.T, name: str) {
    if !gentest.library_available(name) {
        t.skip("lib{name} is not available")
    }
}

fn build_path(path: str, platform: target.OS, binary: str) ! Failure {
    let profile = compiler.release(platform)
    let unit = compiler.analyse(path, profile) catch {
        e => fail Failed(compiler.message(e))
    }
    compiler.build(unit, binary) catch {
        e => fail Failed(compiler.message(e))
    }
}

fn run_command(command: process.Command) -> process.Output ! Failure {
    let output = process.run(command, []) catch {
        e => fail Failed("{command.program}: {e}")
    }
    if !process.success(output.status) {
        fail Failed("{command.program} failed\n{str(output.stdout)}\n{str(output.stderr)}")
    }
    output
}

fn execute(command: process.Command) -> str ! Failure {
    let output = run_command(command)?
    str(output.stdout)
}

fn environment_with(extra: [str: str]) -> [str: str] {
    var environment = os.environment()
    for name, value in extra {
        environment[name] = value
    }
    environment
}

fn with_temp_dir(t: *testing.T, body: fn(str) -> str ! Failure) -> str {
    let dir = file.temp_dir("uitest-") catch {
        e => {
            t.fatal("create a temporary directory: {e}")
            return ""
        }
    }
    var failure = ""
    let result = body(dir) catch {
        Failed(message) => {
            failure = message
            ""
        }
    }
    file.remove_all(dir) or {}
    if failure.len > 0 {
        t.fatal(failure)
    }
    result
}

fn lines_of(body: str) -> []str {
    let trimmed = text.trim_suffix(body, "\n")
    text.split(trimmed, '\n')
}

fn compare_lines(t: *testing.T, got: []str, want: []str) {
    var i = 0
    for i < got.len || i < want.len {
        let g = if i < got.len { got[i] } else { "" }
        let w = if i < want.len { want[i] } else { "" }
        if g != w {
            t.error("line {i + 1} = {text.quote(g)}, want {text.quote(w)}")
        }
        i += 1
    }
}

fn expect_lines(t: *testing.T, got: []str, want: []str) {
    if !slices.equal(got, want) {
        let got_text = text.join(got, "\n")
        let want_text = text.join(want, "\n")
        t.error("output:\n{got_text}\nwant:\n{want_text}")
    }
}

fn repeated(times: i64, lines: []str) -> []str {
    var out: []str = []
    for i in 0..times {
        for line in lines {
            push(mut out, line)
        }
    }
    out
}

fn run_testdata(dir: str, name: str) -> str ! Failure {
    let binary = file.child_path(dir, name)
    let source = "{testdata_dir}/{name}"
    build_path(source, target.OS.Linux, binary)?
    let command = process.command(binary, [])
    execute(command)
}

fn run_render(t: *testing.T, name: str) -> Output {
    require_linux_host(t)
    require_library(t, "vulkan")
    let body = with_temp_dir(t, fn(dir) { run_testdata(dir, name) })
    if text.starts_with(body, no_device) {
        t.skip("no Vulkan 1.3 device")
    }
    parse_output(t, body)
}

fn run_window(t: *testing.T, name: str, libraries: []str) -> []str {
    require_linux_host(t)
    require_library(t, "wayland-client")
    require_library(t, "xkbcommon")
    for library in libraries {
        require_library(t, library)
    }
    let display = os.env("WAYLAND_DISPLAY") ?? ""
    if display.len == 0 {
        t.skip("no Wayland compositor to connect to")
    }
    let body = with_temp_dir(t, fn(dir) { run_testdata(dir, name) })
    if text.starts_with(body, no_display) {
        t.skip("the program could not connect to a Wayland compositor")
    }
    if text.starts_with(body, no_device) {
        t.skip("no Vulkan 1.3 device that presents to a Wayland surface")
    }
    lines_of(body)
}
