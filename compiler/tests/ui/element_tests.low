import std/testing

fn test_elements(t: *testing.T) {
    let out = run_render(t, "elements")
    let white = opaque(255, 255, 255)
    let blue = opaque(0, 0, 255)
    let green = opaque(0, 255, 0)
    let red = opaque(255, 0, 0)
    let yellow = opaque(255, 255, 0)
    let magenta = opaque(255, 0, 255)

    let idle = frame(t, out, "idle")
    expect_all(t, idle, white, 0, [2, 2, 9, 9, 41, 9, 9, 41, 85, 20, 97, 57])
    expect_all(t, idle, blue, 0, [10, 10, 39, 10, 10, 39, 39, 39, 25, 25])
    expect_all(t, idle, green, 0, [50, 10, 79, 10, 50, 39, 79, 39, 65, 25])

    let hover = frame(t, out, "hover")
    expect_all(t, hover, red, 0, [10, 10, 39, 39, 25, 25])
    expect_all(t, hover, green, 0, [50, 10, 79, 39])
    expect_all(t, hover, white, 0, [85, 20, 2, 2])

    let pressed = frame(t, out, "pressed")
    expect_all(t, pressed, yellow, 0, [10, 10, 39, 39, 25, 25])
    expect_all(t, pressed, green, 0, [50, 10, 79, 39])

    let clicked = frame(t, out, "clicked")
    expect_all(t, clicked, magenta, 0, [10, 10, 39, 39, 25, 25])
    expect_all(t, clicked, green, 0, [50, 10, 89, 39, 70, 25])
    expect_all(t, clicked, white, 0, [2, 2, 9, 9, 50, 45, 90, 25, 90, 50])
}
