import std/ui/platform
import win32support

fn once() ! platform.Error {
    using w = platform.open(platform.Options { title: "mouse", width: 320, height: 200 })?
    let scale = win32support.ready(w)?
    let at = win32support.point(10 * scale, 20 * scale)

    win32support.post(w, 0x200, 0, at)
    win32support.post(w, 0x200, 0, win32support.point(11 * scale + scale / 2, -3 * scale))
    win32support.post(w, 0x2A3, 0, 0)
    win32support.show(platform.next(w, 1000)?)

    win32support.post(w, 0x200, 0, at)
    win32support.post(w, 0x201, 1, win32support.point(4 * scale, 5 * scale))
    win32support.post(w, 0x202, 0, win32support.point(4 * scale, 5 * scale))
    win32support.post(w, 0x204, 2, win32support.point(6 * scale, 7 * scale))
    win32support.post(w, 0x205, 0, win32support.point(6 * scale, 7 * scale))
    win32support.post(w, 0x207, 0x10, win32support.point(8 * scale, 9 * scale))
    win32support.post(w, 0x208, 0, win32support.point(8 * scale, 9 * scale))
    win32support.post(w, 0x20B, (1 << 16) | 0x20, win32support.point(1 * scale, 2 * scale))
    win32support.post(w, 0x20C, 1 << 16, win32support.point(1 * scale, 2 * scale))
    win32support.post(w, 0x20B, (2 << 16) | 0x40, win32support.point(3 * scale, 4 * scale))
    win32support.post(w, 0x20C, 2 << 16, win32support.point(3 * scale, 4 * scale))
    win32support.show_stable(platform.next(w, 1000)?)

    win32support.post(w, 0x20A, 120 << 16, 0)
    win32support.post(w, 0x20A, (65536 - 240) << 16, 0)
    win32support.post(w, 0x20E, 60 << 16, 0)
    win32support.post(w, 0x20E, (65536 - 120) << 16, 0)
    win32support.show_stable(platform.next(w, 1000)?)

    win32support.post(w, 0x201, 1, at)
    win32support.post(w, 0x204, 2, at)
    win32support.post(w, 0x202, 0, at)
    win32support.post(w, 0x205, 0, at)
    win32support.show_stable(platform.next(w, 1000)?)
}

fn main() {
    win32support.guard(once)
}
