import std/time
import std/ui/platform
import win32support

const patient_ms = 5000
const prompt_ms = 1500
const timeout_ms = 200
const tick_ms = 16
const delay_ms = 100

fn since(started: i64) -> i64 {
    (time.monotonic() - started) / 1000000
}

fn options(title: str) -> platform.Options {
    platform.Options { title, width: 200, height: 100 }
}

fn waited(display: platform.Display, label: str) ! platform.Error {
    let started = time.monotonic()
    platform.wait(display, patient_ms)?
    print("{label} ended wait {since(started) < prompt_ms}")
}

fn idle(display: platform.Display, label: str) ! platform.Error {
    let started = time.monotonic()
    platform.wait(display, timeout_ms)?
    let took = since(started)
    print("{label} runs to the timeout {took >= timeout_ms - tick_ms && took < prompt_ms}")
}

fn wake_after(k: platform.Waker, ms: i64) {
    sleep(ms)
    platform.wake(k)
}

fn woken_by_thread(display: platform.Display, k: platform.Waker) ! platform.Error {
    spawn wake_after(k, delay_ms)
    let started = time.monotonic()
    platform.wait(display, patient_ms)?
    let took = since(started)
    print("a wake from another green thread ended wait {took >= delay_ms - tick_ms && took < prompt_ms}")
}

fn typed_to_both(display: platform.Display, first: platform.Window, second: platform.Window) ! platform.Error {
    win32support.post(first, 0x100, 0x70, 0x3B0001)
    win32support.post(second, 0x100, 0x71, 0x3C0001)
    win32support.post(first, 0x102, 0x61, 0x1E0001)
    win32support.post(second, 0x102, 0x62, 0x300001)
    waited(display, "keys to both windows")?
    win32support.show_stable(platform.next(first, 0)?)
    win32support.show_stable(platform.next(second, 0)?)
}

fn typed_across_waits(display: platform.Display, first: platform.Window) ! platform.Error {
    win32support.post(first, 0x100, 0x70, 0x3B0001)
    platform.wait(display, 0)?
    win32support.post(first, 0x102, 0x61, 0x1E0001)
    platform.wait(display, 0)?
    win32support.show_stable(platform.next(first, 0)?)
}

fn once() ! platform.Error {
    using display = platform.open_display()?
    using first = platform.open_in(display, options("first"))?
    using second = platform.open_in(display, options("second"))?
    win32support.ready(first)?
    win32support.ready(second)?

    idle(display, "nothing pending")?

    win32support.post(second, 0x20A, 120 << 16, 0)
    waited(display, "a message to the second window")?
    win32support.show_stable(platform.next(first, 0)?)
    win32support.show_stable(platform.next(second, 0)?)

    typed_to_both(display, first, second)?
    typed_across_waits(display, first)?

    let k = platform.waker_of(display)
    platform.wake(k)
    platform.wake(k)
    waited(display, "two wakes")?
    idle(display, "a wake already taken")?
    win32support.show_stable(platform.next(first, 0)?)
    win32support.show_stable(platform.next(second, 0)?)

    woken_by_thread(display, k)?

    win32support.post(first, 0x10, 0, 0)
    {
        using moved = first
    }
    platform.wake(k)
    waited(display, "a wake after the first window closed")?
    win32support.show_stable(platform.next(second, 0)?)

    {
        using moved = second
    }
    platform.wake(k)
    waited(display, "a wake with no window open")?
}

fn main() {
    win32support.guard(once)
    win32support.guard(once)
}
