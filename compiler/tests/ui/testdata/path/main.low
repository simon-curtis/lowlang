import std/ui/gpu
import std/ui/scene
import std/ui/geometry
import support

fn pt(x: f32, y: f32) -> geometry.Point {
    geometry.point(x, y)
}

fn triangle(a: geometry.Point, b: geometry.Point, c: geometry.Point, color: geometry.Color) -> scene.Path {
    var p = scene.path(a, color)
    scene.line_to(mut p, b)
    scene.line_to(mut p, c)
    p
}

fn solid() -> scene.Scene {
    var s = scene.empty(64, 48, geometry.rgb(0xffffff))
    scene.push_path(mut s, triangle(pt(8.0, 8.0), pt(40.0, 8.0), pt(8.0, 40.0), geometry.rgb(0xff0000)))
    scene.push_path(mut s, triangle(pt(44.0, 8.0), pt(60.0, 8.0), pt(44.0, 24.0), geometry.rgb(0x0000ff)))
    s
}

fn dome() -> scene.Scene {
    var s = scene.empty(64, 64, geometry.rgb(0xffffff))
    var p = scene.path(pt(8.0, 40.0), geometry.rgb(0x008000))
    scene.curve_to(mut p, pt(56.0, 40.0), pt(32.0, 0.0))
    scene.line_to(mut p, pt(56.0, 56.0))
    scene.line_to(mut p, pt(8.0, 56.0))
    scene.push_path(mut s, p)
    s
}

fn bulge() -> scene.Scene {
    var s = scene.empty(64, 64, geometry.rgb(0xffffff))
    var p = scene.path(pt(8.0, 40.0), geometry.rgb(0x008000))
    scene.curve_to(mut p, pt(56.0, 40.0), pt(32.0, 0.0))
    scene.push_path(mut s, p)
    s
}

fn translucent() -> scene.Scene {
    var s = scene.empty(64, 48, geometry.rgb(0xffffff))
    scene.push_quad(mut s, scene.Quad { bounds: geometry.rect(4.0, 4.0, 32.0, 32.0), background: geometry.rgb(0x00ff00) })
    scene.push_path(mut s, triangle(pt(8.0, 8.0), pt(56.0, 8.0), pt(8.0, 40.0), geometry.rgba(0xff000080)))
    s
}

fn crossing() -> scene.Scene {
    var s = scene.empty(64, 48, geometry.rgb(0xffffff))
    scene.push_path(mut s, triangle(pt(4.0, 4.0), pt(44.0, 4.0), pt(4.0, 44.0), geometry.rgba(0xff000080)))
    scene.push_path(mut s, triangle(pt(20.0, 4.0), pt(60.0, 4.0), pt(60.0, 44.0), geometry.rgba(0x0000ff80)))
    s
}

fn layered() -> scene.Scene {
    var s = scene.empty(64, 48, geometry.rgb(0xffffff))
    scene.push_quad(mut s, scene.Quad { bounds: geometry.rect(4.0, 4.0, 24.0, 40.0), background: geometry.rgb(0xff0000) })
    scene.push_path(mut s, triangle(pt(8.0, 8.0), pt(56.0, 8.0), pt(8.0, 40.0), geometry.rgb(0x0000ff)))
    scene.push_quad(mut s, scene.Quad { bounds: geometry.rect(16.0, 16.0, 16.0, 16.0), background: geometry.rgb(0x00ff00) })
    s
}

fn interleaved() -> scene.Scene {
    var s = scene.empty(64, 48, geometry.rgb(0xffffff))
    scene.push_path(mut s, triangle(pt(2.0, 2.0), pt(40.0, 2.0), pt(2.0, 40.0), geometry.rgb(0xff0000)))
    scene.push_quad(mut s, scene.Quad { bounds: geometry.rect(10.0, 10.0, 30.0, 20.0), background: geometry.rgb(0x00ff00) })
    scene.push_path(mut s, triangle(pt(20.0, 6.0), pt(60.0, 6.0), pt(60.0, 44.0), geometry.rgba(0x0000ff80)))
    scene.push_quad(mut s, scene.Quad { bounds: geometry.rect(30.0, 20.0, 10.0, 10.0), background: geometry.rgb(0xffff00) })
    scene.push_path(mut s, triangle(pt(28.0, 22.0), pt(38.0, 22.0), pt(28.0, 28.0), geometry.rgba(0x00000080)))
    s
}

fn clipped() -> scene.Scene {
    var s = scene.empty(64, 48, geometry.rgb(0xffffff))
    scene.push_clip(mut s, geometry.rect(16.0, 8.0, 20.0, 20.0))
    scene.push_path(mut s, triangle(pt(8.0, 8.0), pt(56.0, 8.0), pt(8.0, 56.0), geometry.rgb(0xff0000)))
    scene.pop_clip(mut s)
    s
}

fn stroked() -> scene.Scene {
    var s = scene.empty(64, 48, geometry.rgb(0xffffff))
    let line = [pt(8.0, 40.0), pt(24.0, 12.0), pt(40.0, 36.0), pt(56.0, 8.0)]
    scene.push_path(mut s, scene.stroke_polyline(line, 4.0, geometry.rgb(0x000000)))
    s
}

fn curved_stroke() -> scene.Scene {
    var s = scene.empty(64, 48, geometry.rgb(0xffffff))
    scene.push_path(mut s, scene.stroke_quad(pt(8.0, 40.0), pt(32.0, 0.0), pt(56.0, 40.0), 4.0, geometry.rgb(0x000000)))
    s
}

fn small() -> scene.Scene {
    var s = scene.empty(16, 16, geometry.rgb(0xffffff))
    scene.push_path(mut s, triangle(pt(2.0, 2.0), pt(14.0, 2.0), pt(2.0, 14.0), geometry.rgb(0xff0000)))
    s
}

fn wide() -> scene.Scene {
    var s = scene.empty(320, 24, geometry.rgb(0xffffff))
    scene.push_path(mut s, triangle(pt(4.0, 2.0), pt(20.0, 2.0), pt(4.0, 18.0), geometry.rgb(0xff0000)))
    scene.push_path(mut s, triangle(pt(300.0, 2.0), pt(316.0, 2.0), pt(300.0, 18.0), geometry.rgb(0x0000ff)))
    s
}

fn render() ! gpu.Error {
    using g = gpu.open()?
    var atlas = scene.atlas(1024)

    using tile = gpu.target(g, 64, 48)?
    gpu.render(g, tile, solid(), mut atlas)?
    support.snapshot(g, tile, "solid")?
    gpu.render(g, tile, translucent(), mut atlas)?
    support.snapshot(g, tile, "translucent")?
    gpu.render(g, tile, crossing(), mut atlas)?
    support.snapshot(g, tile, "crossing")?
    gpu.render(g, tile, layered(), mut atlas)?
    support.snapshot(g, tile, "layered")?
    gpu.render(g, tile, interleaved(), mut atlas)?
    support.snapshot(g, tile, "interleaved")?
    gpu.render(g, tile, interleaved(), mut atlas)?
    support.snapshot(g, tile, "interleaved_again")?
    gpu.render(g, tile, clipped(), mut atlas)?
    support.snapshot(g, tile, "clipped")?
    gpu.render(g, tile, stroked(), mut atlas)?
    support.snapshot(g, tile, "stroked")?
    gpu.render(g, tile, curved_stroke(), mut atlas)?
    support.snapshot(g, tile, "curved_stroke")?

    using square = gpu.target(g, 64, 64)?
    gpu.render(g, square, dome(), mut atlas)?
    support.snapshot(g, square, "dome")?
    gpu.render(g, square, bulge(), mut atlas)?
    support.snapshot(g, square, "bulge")?

    using little = gpu.target(g, 16, 16)?
    gpu.render(g, little, small(), mut atlas)?
    support.snapshot(g, little, "small_first")?
    gpu.render(g, tile, solid(), mut atlas)?
    support.snapshot(g, tile, "solid_after_small")?

    using long = gpu.target(g, 320, 24)?
    gpu.render(g, long, wide(), mut atlas)?
    support.snapshot(g, long, "wide")?
    gpu.render(g, little, small(), mut atlas)?
    support.snapshot(g, little, "small_last")?
    gpu.render(g, tile, solid(), mut atlas)?
    support.snapshot(g, tile, "solid_after_wide")?
}

fn main() ! gpu.Error {
    support.guard(render)?
}
