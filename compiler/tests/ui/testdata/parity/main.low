import std/math
import std/ui/gpu
import std/ui/scene
import std/ui/geometry
import support

fn hsla(h: f32, s: f32, l: f32, a: f32) -> geometry.Color {
    let hh = h * 6.0
    let c = (1.0 - math.abs(2.0 * l - 1.0)) * s
    let x = c * (1.0 - math.abs(hh - 2.0 * floor(hh / 2.0) - 1.0))
    let m = l - c / 2.0
    var r: f32 = 0.0
    var g: f32 = 0.0
    var b: f32 = 0.0
    if hh >= 0.0 && hh < 1.0 {
        r = c
        g = x
    } else if hh >= 1.0 && hh < 2.0 {
        r = x
        g = c
    } else if hh >= 2.0 && hh < 3.0 {
        g = c
        b = x
    } else if hh >= 3.0 && hh < 4.0 {
        g = x
        b = c
    } else if hh >= 4.0 && hh < 5.0 {
        r = x
        b = c
    } else {
        r = c
        b = x
    }
    geometry.Color { r: r + m, g: g + m, b: b + m, a }
}

fn corners(tl: f32, tr: f32, br: f32, bl: f32) -> geometry.Corners {
    geometry.Corners { top_left: tl, top_right: tr, bottom_right: br, bottom_left: bl }
}

fn edges(t: f32, r: f32, b: f32, l: f32) -> geometry.Edges {
    geometry.Edges { top: t, right: r, bottom: b, left: l }
}

fn quad(mut s: scene.Scene, x: f32, y: f32, w: f32, h: f32, radii: geometry.Corners, bg: geometry.Color, widths: geometry.Edges, border: geometry.Color) {
    scene.push_quad(mut s, scene.Quad {
        bounds: geometry.snap(geometry.rect(x, y, w, h), 1.0)
        background: bg
        border_color: border
        corner_radii: radii
        border_widths: geometry.snap_edges(widths, 1.0)
    })
}

fn render() ! gpu.Error {
    using g = gpu.open()?
    using t = gpu.target(g, 240, 160)?
    var atlases = [scene.atlas(1024)]

    let blue = hsla(0.6, 0.5, 0.4, 1.0)
    let orange = hsla(0.05, 0.8, 0.5, 1.0)
    let white = hsla(0.0, 0.0, 1.0, 1.0)
    let red = hsla(0.0, 0.8, 0.5, 1.0)
    let none = hsla(0.0, 0.0, 0.0, 0.0)
    let panel = hsla(0.0, 0.0, 0.2, 1.0)
    let no_radius = corners(0.0, 0.0, 0.0, 0.0)
    let no_border = edges(0.0, 0.0, 0.0, 0.0)

    var s = scene.empty(240, 160, hsla(0.0, 0.0, 0.1, 1.0))
    quad(mut s, 8.0, 8.0, 60.0, 40.0, geometry.corners(8.0), blue, no_border, none)
    quad(mut s, 80.0, 8.0, 60.0, 40.0, corners(4.0, 12.0, 24.0, 0.0), orange, no_border, none)
    quad(mut s, 152.0, 8.0, 60.0, 40.0, geometry.corners(8.0), blue, geometry.edges(2.0), white)
    quad(mut s, 8.0, 60.0, 60.0, 40.0, no_radius, blue, edges(1.0, 2.0, 3.0, 4.0), red)
    quad(mut s, 80.0, 60.0, 60.0, 40.0, geometry.corners(16.0), blue, edges(1.0, 4.0, 2.0, 6.0), red)
    quad(mut s, 152.0, 60.0, 60.0, 40.0, geometry.corners(10.0), hsla(0.6, 0.5, 0.4, 0.5), geometry.edges(3.0), hsla(0.0, 0.8, 0.5, 0.5))
    quad(mut s, 8.5, 112.5, 60.4, 30.4, no_radius, white, no_border, none)
    quad(mut s, 176.0, 110.0, 30.0, 40.0, no_radius, orange, no_border, none)
    let grown = geometry.outset(geometry.offset(geometry.rect(100.0, 112.0, 60.0, 30.0), 0.0, 4.0), geometry.edges(2.0))
    scene.push_shadow(mut s, scene.Shadow { bounds: geometry.cover(grown, 1.0), color: hsla(0.0, 0.0, 0.0, 0.5), corner_radii: geometry.corners(8.0), sigma: 12.0 })
    quad(mut s, 100.0, 112.0, 60.0, 30.0, geometry.corners(8.0), panel, no_border, none)
    gpu.render(g, t, s, mut atlases)?
    support.snapshot(g, t, "parity")?
}

fn main() ! gpu.Error {
    support.guard(render)?
}
