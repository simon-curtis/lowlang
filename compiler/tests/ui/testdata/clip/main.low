import std/ui/gpu
import std/ui/scene
import std/ui/geometry
import support

fn render() ! gpu.Error {
    using g = gpu.open()?
    using t = gpu.target(g, 64, 64)?
    var atlas = scene.atlas(1024)

    var s = scene.empty(64, 64, geometry.rgb(0x000000))
    scene.push_clip(mut s, geometry.rect(0.0, 0.0, 32.0, 64.0))
    scene.push_quad(mut s, scene.Quad { bounds: geometry.rect(16.0, 8.0, 32.0, 16.0), background: geometry.rgb(0xff0000) })
    scene.pop_clip(mut s)

    scene.push_clip(mut s, geometry.rect(0.0, 0.0, 64.0, 40.0))
    scene.push_clip(mut s, geometry.rect(0.0, 32.0, 64.0, 32.0))
    scene.push_quad(mut s, scene.Quad { bounds: geometry.rect(8.0, 28.0, 48.0, 20.0), background: geometry.rgb(0x0000ff) })
    scene.pop_clip(mut s)
    scene.pop_clip(mut s)

    scene.push_quad(mut s, scene.Quad { bounds: geometry.rect(8.0, 52.0, 16.0, 8.0), background: geometry.rgb(0x00ff00) })
    gpu.render(g, t, s, mut atlas)?
    support.snapshot(g, t, "clip")?
}

fn main() ! gpu.Error {
    support.guard(render)?
}
