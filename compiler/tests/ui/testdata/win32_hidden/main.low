import std/ui/platform
import win32support

const cloaked_by_app: i64 = 1

fn report(w: platform.Window, when: str) {
    print("{when}: visible {win32support.visible(w)} cloaked {win32support.cloak_state(w)}")
}

fn shown() ! platform.Error {
    using w = platform.open(platform.Options { title: "shown", width: 320, height: 200 })?
    report(w, "opened without hidden")
    platform.show(w)
    report(w, "shown anyway")
}

fn hidden() ! platform.Error {
    using w = platform.open(platform.Options { title: "hidden", width: 320, height: 200, hidden: true })?
    let opened = win32support.client_size(w)
    let events = platform.next(w, 1000)?
    print(win32support.describe(events[0]))
    report(w, "opened hidden")
    print("cloaked by the app {win32support.cloak_state(w) == cloaked_by_app}")
    for e in events {
        match e {
            Resized(width, height, scale) => print("client is the requested size {opened == "{width * scale} {height * scale}"}")
            _ => {}
        }
    }
    platform.show(w)
    report(w, "shown")
    platform.show(w)
    report(w, "shown again")
    win32support.show_stable(platform.next(w, 20)?)
}

fn main() {
    win32support.guard(shown)
    win32support.guard(hidden)
}
