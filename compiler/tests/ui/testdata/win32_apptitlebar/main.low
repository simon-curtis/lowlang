import std/ui
import std/ui/geometry
import std/ui/platform

extern "user32" {
    fn FindWindowW(class: ptr, title: ptr) -> ptr
    fn SendMessageW(hwnd: ptr, message: u32, wparam: i64, lparam: i64) -> i64
    fn ClientToScreen(hwnd: ptr, mut at: Point) -> i32
    fn GetDpiForWindow(hwnd: ptr) -> u32
    fn EnableWindow(hwnd: ptr, enable: i32) -> i32
}

extern "kernel32" {
    fn GetCurrentProcessId() -> u32
}

extern struct Point {
    x: i32
    y: i32
}

const wm_nchittest: u32 = 0x84
const wm_nclbuttondown: u32 = 0xA1
const wm_nclbuttonup: u32 = 0xA2

fn wide(s: str) -> []u8 {
    var out: []u8 = []
    for b in bytes(s) {
        out.push(b)
        out.push(0)
    }
    out.push(0)
    out.push(0)
    out
}

fn find_window(title: str) -> ptr {
    let name = wide(title)
    let at: ptr[u8] = pin(name)
    let hwnd = FindWindowW(null, at)
    unpin(at)
    hwnd
}

fn pixels(hwnd: ptr, logical: i64) -> i64 {
    (logical * i64(GetDpiForWindow(hwnd)) + 48) / 96
}

fn screen_of(hwnd: ptr, x: i64, y: i64) -> i64 {
    var at = Point { x: i32(pixels(hwnd, x)), y: i32(pixels(hwnd, y)) }
    ClientToScreen(hwnd, mut at)
    ((i64(at.y) & 0xFFFF) << 16) | (i64(at.x) & 0xFFFF)
}

fn hit(hwnd: ptr, name: str, x: i64, y: i64) {
    print("hit {name} {SendMessageW(hwnd, wm_nchittest, 0, screen_of(hwnd, x, y))}")
}

fn press(hwnd: ptr, code: i64, x: i64, y: i64) {
    let at = screen_of(hwnd, x, y)
    SendMessageW(hwnd, wm_nclbuttondown, code, at)
    SendMessageW(hwnd, wm_nclbuttonup, code, at)
}

fn caption(area: platform.WindowControlArea, left: f32) -> ui.Element {
    ui.div().absolute().left(left).top(0.0).size(30.0, 30.0).window_control_area(area)
}

fn bar(clicks: ui.Signal[i64]) -> ui.Element {
    let counted = fn(e: ui.ClickEvent) { ui.update(clicks, fn(n: i64) -> i64 { n + 1 }) }
    ui.div().window_control_area(platform.WindowControlArea.Drag).height(30.0).children() {
        ui.div().width(40.0).height(30.0).on_click(counted),
        caption(platform.WindowControlArea.Min, 230.0),
        caption(platform.WindowControlArea.Max, 260.0),
        caption(platform.WindowControlArea.Close, 290.0),
    }
}

fn check(cx: ui.Context, hwnd: ptr) {
    hit(hwnd, "drag", 100, 15)
    hit(hwnd, "handler inside the drag area", 20, 15)
    hit(hwnd, "min", 245, 15)
    hit(hwnd, "max", 275, 15)
    hit(hwnd, "close", 305, 15)
    hit(hwnd, "content", 100, 100)
    print("restored {!ui.is_maximized(cx)}")
    press(hwnd, 9, 275, 15)
}

fn zoomed_now(h: ui.Handle, cx: ui.Context, answers: chan[bool]) -> bool {
    ui.post(h, fn() { answers <- ui.is_maximized(cx) })
    <-answers ?? false
}

fn wait_until(h: ui.Handle, cx: ui.Context, answers: chan[bool], want: bool) -> bool {
    for attempt in 0..200 {
        if zoomed_now(h, cx, answers) == want {
            return true
        }
        sleep(25)
    }
    false
}

fn drive(h: ui.Handle, cx: ui.Context, hwnd: ptr) {
    let answers = chan[bool](1)
    sleep(300)
    ui.post(h, fn() { check(cx, hwnd) })
    print("maximised by the max area {wait_until(h, cx, answers, true)}")
    ui.post(h, fn() { ui.toggle_maximize(cx) })
    print("restored by toggle_maximize {wait_until(h, cx, answers, false)}")
    ui.post(h, fn() { ui.quit(cx) })
}

fn once() ! ui.Error {
    let titlebar = ui.TitlebarOptions { appears_transparent: true }
    let title = "apptitlebar {GetCurrentProcessId()}"
    using app = ui.open(ui.Options { title, width: 320, height: 200, titlebar })?
    let cx = app.cx
    let clicks = ui.signal(cx, 0)
    let hwnd = find_window(title)
    EnableWindow(hwnd, 0)
    let view = fn() -> ui.Element { bar(clicks) }
    ui.frame(cx, view, geometry.size(320.0, 200.0), 1.0)
    spawn drive(ui.handle(cx), cx, hwnd)
    ui.run(app, view)?
}

fn main() ! ui.Error {
    once() catch {
        Platform(error) => {
            match error {
                NoDisplay(detail) => {
                    print("no display")
                    return
                }
                e => fail ui.Error.Platform(e)
            }
        }
        Gpu(error) => {
            match error {
                NoDevice => {
                    print("skip no Vulkan 1.3 device that presents to a window")
                    return
                }
                Vulkan(call, result) => {
                    print("skip Vulkan {call} returned {result}, so no window can be drawn")
                    return
                }
                e => fail ui.Error.Gpu(e)
            }
        }
    }
}
