import std/io
import std/ui/platform
import twopresent
import win32support

const client_only_and_full_content: u32 = 3

extern "user32" {
    fn GetDC(hwnd: ptr) -> ptr
    fn ReleaseDC(hwnd: ptr, dc: ptr) -> i32
    fn PrintWindow(hwnd: ptr, dc: ptr, flags: u32) -> i32
}

extern "gdi32" {
    fn CreateCompatibleDC(dc: ptr) -> ptr
    fn CreateCompatibleBitmap(dc: ptr, width: i32, height: i32) -> ptr
    fn SelectObject(dc: ptr, object: ptr) -> ptr
    fn DeleteObject(object: ptr) -> i32
    fn DeleteDC(dc: ptr) -> i32
    fn GetDIBits(dc: ptr, bitmap: ptr, start: u32, lines: u32, bits: ptr[u8], mut info: BitmapInfo, usage: u32) -> i32
}

extern struct BitmapInfo {
    size: u32
    width: i32
    height: i32
    planes: u16
    bit_count: u16
    compression: u32
    size_image: u32
    x_pixels_per_meter: i32
    y_pixels_per_meter: i32
    colors_used: u32
    colors_important: u32
    colors: u32
}

fn rgba_from_bgra(bgra: []u8) -> []u8 {
    let out = io.buffer(bgra.len)
    var i = 0
    for i < bgra.len {
        out[i] = bgra[i + 2]
        out[i + 1] = bgra[i + 1]
        out[i + 2] = bgra[i]
        out[i + 3] = 255
        i += 4
    }
    out
}

fn capture_window(w: platform.Window, size: twopresent.Size) -> []u8 {
    let hwnd = platform.native(w).window
    let width = i32(size.width)
    let height = i32(size.height)
    let screen = GetDC(null)
    let memory = CreateCompatibleDC(screen)
    let bitmap = CreateCompatibleBitmap(screen, width, height)
    let previous = SelectObject(memory, bitmap)
    let printed = PrintWindow(hwnd, memory, client_only_and_full_content)
    let _ = SelectObject(memory, previous)
    let bgra = io.buffer(size.width * size.height * 4)
    var info = BitmapInfo {
        size: 40
        width
        height: -height
        planes: 1
        bit_count: 32
        compression: 0
        size_image: 0
        x_pixels_per_meter: 0
        y_pixels_per_meter: 0
        colors_used: 0
        colors_important: 0
        colors: 0
    }
    let at: ptr[u8] = pin(bgra)
    let lines = GetDIBits(memory, bitmap, 0, u32(height), at, mut info, 0)
    unpin(at)
    let _ = DeleteObject(bitmap)
    let _ = DeleteDC(memory)
    let _ = ReleaseDC(null, screen)
    if printed == 0 || lines == 0 {
        return []
    }
    rgba_from_bgra(bgra)
}

fn size_of(w: platform.Window) -> twopresent.Size {
    twopresent.Size { width: win32support.client_width(w), height: win32support.client_height(w) }
}

fn run() ! twopresent.Failure {
    using first = platform.open(platform.Options { title: "first", width: 200, height: 120, activate: false }) catch twopresent.Failure.Window
    using second = platform.open(platform.Options { title: "second", width: 320, height: 180, activate: false }) catch twopresent.Failure.Window
    win32support.ready(first) catch twopresent.Failure.Window
    win32support.ready(second) catch twopresent.Failure.Window
    let sizes = twopresent.Sizes { first: size_of(first), second: size_of(second) }
    twopresent.run(first, second, sizes, fn(w, size) { capture_window(w, size) })?
}

fn main() ! twopresent.Failure {
    run() catch {
        Window(error) => {
            match error {
                NoDisplay(detail) => {
                    print("no display")
                    return
                }
                e => fail twopresent.Failure.Window(e)
            }
        }
        Graphics(error) => {
            match error {
                NoDevice => {
                    print("no device")
                    return
                }
                e => fail twopresent.Failure.Graphics(e)
            }
        }
        NoPresenter => {
            print("no presenter")
        }
    }
}
