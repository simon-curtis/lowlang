import std/ui/platform
import win32support

extern "user32" {
    fn GetWindow(hwnd: ptr, command: u32) -> ptr
    fn GetWindowLongPtrW(hwnd: ptr, index: i32) -> i64
    fn IsWindowEnabled(hwnd: ptr) -> i32
    fn IsWindow(hwnd: ptr) -> i32
    fn DestroyWindow(hwnd: ptr) -> i32
    fn GetWindowRect(hwnd: ptr, mut rect: Rect) -> i32
    fn SetWindowPos(hwnd: ptr, after: ptr, x: i32, y: i32, width: i32, height: i32, flags: u32) -> i32
    fn MonitorFromWindow(hwnd: ptr, flags: u32) -> ptr
    fn GetMonitorInfoW(monitor: ptr, mut info: MonitorInfo) -> i32
    fn AdjustWindowRectExForDpi(mut rect: Rect, style: u32, menu: i32, ex_style: u32, dpi: u32) -> i32
    fn GetWindowTextW(hwnd: ptr, text: ptr[u16], count: i32) -> i32
    fn SendMinMax(hwnd: ptr, message: u32, wparam: i64, mut info: MinMax) -> i64 = "SendMessageW"
    fn DefMinMax(hwnd: ptr, message: u32, wparam: i64, mut info: MinMax) -> i64 = "DefWindowProcW"
    fn GetPropW(hwnd: ptr, name: ptr[u16]) -> ptr
}

extern "kernel32" {
    fn GetLastError() -> u32
    fn SetLastError(code: u32)
}

extern struct Rect {
    left: i32 = 0
    top: i32 = 0
    right: i32 = 0
    bottom: i32 = 0
}

extern struct MonitorInfo {
    size: u32 = 40
    monitor: Rect = Rect {}
    work: Rect = Rect {}
    flags: u32 = 0
}

extern struct MinMax {
    reserved_x: i32 = 0
    reserved_y: i32 = 0
    max_size_x: i32 = 0
    max_size_y: i32 = 0
    max_position_x: i32 = 0
    max_position_y: i32 = 0
    min_x: i32 = 0
    min_y: i32 = 0
    max_x: i32 = 0
    max_y: i32 = 0
}

const gw_owner: u32 = 4
const gwl_exstyle: i32 = -20
const ws_ex_appwindow: i64 = 0x40000
const ws_ex_toolwindow: i64 = 0x80
const style: u32 = 0x00CF0000
const wm_getminmaxinfo: u32 = 0x24
const swp_nosize: u32 = 0x1
const swp_nozorder: u32 = 0x4
const swp_noactivate: u32 = 0x10
const nearest: u32 = 2
const sentinel: i32 = 7
const pin_capacity = 65536
const display_pins = 1
const pin_slack = 32
const probe_free = 8
const pin_cycles = 40

fn hwnd_of(w: platform.Window) -> ptr {
    platform.native(w).window
}

fn options(title: str, width: i64, height: i64) -> platform.Options {
    platform.Options { title, width, height, activate: false }
}

fn owned_by(owner: platform.Window, title: str, width: i64, height: i64) -> platform.Options {
    platform.Options { title, width, height, owner: some(owner.handle), placement: platform.Placement.CentreOnOwner, activate: false }
}

fn rect_of(w: platform.Window) -> Rect {
    var rect = Rect {}
    GetWindowRect(hwnd_of(w), mut rect)
    rect
}

fn work_area(w: platform.Window) -> Rect {
    var info = MonitorInfo {}
    GetMonitorInfoW(MonitorFromWindow(hwnd_of(w), nearest), mut info)
    info.work
}

fn move_to(w: platform.Window, x: i64, y: i64) {
    SetWindowPos(hwnd_of(w), null, i32(x), i32(y), 0, 0, swp_nosize | swp_nozorder | swp_noactivate)
}

fn within(inner: Rect, outer: Rect) -> bool {
    inner.left >= outer.left && inner.top >= outer.top && inner.right <= outer.right && inner.bottom <= outer.bottom
}

fn middle(a: i32, b: i32) -> i64 {
    i64(a + b) / 2
}

fn apart(a: i64, b: i64) -> i64 {
    if a > b { a - b } else { b - a }
}

fn extended(w: platform.Window) -> i64 {
    GetWindowLongPtrW(hwnd_of(w), gwl_exstyle)
}

fn title_of(w: platform.Window) -> str {
    var units: []u16 = []
    for i in 0..64 {
        units.push(0)
    }
    let at: ptr[u16] = pin(units)
    let count = GetWindowTextW(hwnd_of(w), at, 64)
    unpin(at)
    var out: []u8 = []
    for i in 0..i64(count) {
        out.push(u8(units[i]))
    }
    str(out)
}

fn minimum_of(w: platform.Window) -> MinMax {
    var info = MinMax { min_x: sentinel, min_y: sentinel }
    SendMinMax(hwnd_of(w), wm_getminmaxinfo, 0, mut info)
    info
}

fn same_as_system(w: platform.Window) -> bool {
    let ours = minimum_of(w)
    var system = MinMax { min_x: sentinel, min_y: sentinel }
    DefMinMax(hwnd_of(w), wm_getminmaxinfo, 0, mut system)
    ours.min_x == system.min_x && ours.min_y == system.min_y && ours.max_x == system.max_x && ours.max_y == system.max_y && ours.max_size_x == system.max_size_x && ours.max_size_y == system.max_size_y
}

fn raised_minimum(display: platform.Display, owner: platform.Window) ! platform.Error {
    using small = platform.open_in(display, platform.Options {
        title: "small"
        width: 100
        height: 60
        min_width: 400
        min_height: 300
        owner: some(owner.handle)
        placement: platform.Placement.CentreOnOwner
        activate: false
    })?
    win32support.ready(small)?
    let owner_rect = rect_of(owner)
    let small_rect = rect_of(small)
    let dx = apart(middle(owner_rect.left, owner_rect.right), middle(small_rect.left, small_rect.right))
    let dy = apart(middle(owner_rect.top, owner_rect.bottom), middle(small_rect.top, small_rect.bottom))
    print("a window smaller than its minimum is centred at the minimum {dx <= 1 && dy <= 1}")
    let wide_enough = i64(small_rect.right - small_rect.left) >= win32support.pixels(small, 400) && i64(small_rect.bottom - small_rect.top) >= win32support.pixels(small, 300)
    print("a window smaller than its minimum opens at the minimum {wide_enough}")
}

fn foreign_owner(owner: platform.Window) ! platform.Error {
    using other = platform.open_display()?
    using window = platform.open_in(other, platform.Options { title: "foreign", owner: some(owner.handle), activate: false }) catch {
        Unsupported(detail) => {
            print("an owner from another display fails with Unsupported: {detail}")
            return
        }
        e => {
            print("an owner from another display fails with {e}")
            return
        }
    }
    print("an owner from another display opened a window")
}

fn frame_of(w: platform.Window, dpi: u32) -> Rect {
    var rect = Rect {}
    AdjustWindowRectExForDpi(mut rect, style, 0, u32(extended(w)), dpi)
    rect
}

fn report_minimum(w: platform.Window, label: str, dpi: u32) {
    let info = minimum_of(w)
    let frame = frame_of(w, dpi)
    let content_x = i64(info.min_x) - i64(frame.right - frame.left)
    let content_y = i64(info.min_y) - i64(frame.bottom - frame.top)
    print("minimum at {label} percent {content_x} {content_y}")
}

fn placement_checks(display: platform.Display) ! platform.Error {
    using owner = platform.open_in(display, options("owner", 300, 200))?
    print("the first window has no owner {GetWindow(hwnd_of(owner), gw_owner) == null}")
    print("an unowned window with a taskbar button has neither WS_EX_APPWINDOW nor WS_EX_TOOLWINDOW {(extended(owner) & (ws_ex_appwindow | ws_ex_toolwindow)) == 0}")
    let area = work_area(owner)
    let outer = rect_of(owner)
    move_to(owner, middle(area.left, area.right) - i64(outer.right - outer.left) / 2, middle(area.top, area.bottom) - i64(outer.bottom - outer.top) / 2)

    using tool = platform.open_in(display, platform.Options {
        title: "tool"
        width: 200
        height: 100
        min_width: 150
        min_height: 80
        owner: some(owner.handle)
        placement: platform.Placement.CentreOnOwner
        activate: false
    })?
    print("the tool window is owned by the owner {GetWindow(hwnd_of(tool), gw_owner) == hwnd_of(owner)}")
    print("the owner is enabled with the tool window open {IsWindowEnabled(hwnd_of(owner)) != 0}")
    print("the tool window is enabled {IsWindowEnabled(hwnd_of(tool)) != 0}")
    print("taskbar true sets WS_EX_APPWINDOW {(extended(tool) & ws_ex_appwindow) != 0}")
    win32support.ready(owner)?
    win32support.ready(tool)?

    let owner_rect = rect_of(owner)
    let tool_rect = rect_of(tool)
    let dx = apart(middle(owner_rect.left, owner_rect.right), middle(tool_rect.left, tool_rect.right))
    let dy = apart(middle(owner_rect.top, owner_rect.bottom), middle(tool_rect.top, tool_rect.bottom))
    print("centre within a pixel of the owner's {dx <= 1 && dy <= 1}")
    print("inside the work area {within(tool_rect, work_area(tool))}")

    win32support.change_dpi(tool, 96, 40, 40, 440, 340)
    report_minimum(tool, "100", 96)
    win32support.change_dpi(tool, 144, 40, 40, 640, 490)
    report_minimum(tool, "150", 144)
    print("no minimum answers as the system default does {same_as_system(owner)}")
    raised_minimum(display, owner)?

    platform.set_title(tool, "renamed")
    print("title {title_of(tool)}")

    using quiet = platform.open_in(display, platform.Options { title: "quiet", width: 100, height: 100, owner: some(owner.handle), taskbar: false, activate: false })?
    print("taskbar false on an owned window leaves WS_EX_APPWINDOW clear {(extended(quiet) & ws_ex_appwindow) == 0}")
    using tray = platform.open_in(display, platform.Options { title: "tray", width: 100, height: 100, taskbar: false, activate: false })?
    print("taskbar false on an unowned window is a tool window {(extended(tray) & ws_ex_toolwindow) != 0}")
    foreign_owner(owner)?
}

fn clamped(display: platform.Display) ! platform.Error {
    using owner = platform.open_in(display, options("corner", 100, 80))?
    let area = work_area(owner)
    move_to(owner, i64(area.left), i64(area.top))
    using big = platform.open_in(display, owned_by(owner, "big", 500, 300))?
    let owner_rect = rect_of(owner)
    let big_rect = rect_of(big)
    let wanted_x = middle(owner_rect.left, owner_rect.right) - i64(big_rect.right - big_rect.left) / 2
    let wanted_y = middle(owner_rect.top, owner_rect.bottom) - i64(big_rect.bottom - big_rect.top) / 2
    print("plain centring would leave the work area {wanted_x < i64(area.left) && wanted_y < i64(area.top)}")
    print("clamped inside the work area {within(big_rect, work_area(big))}")
}

fn show_closed(tool: platform.Window) ! platform.Error {
    let events = platform.next(tool, 0)?
    var names: []str = []
    for e in events {
        names.push(win32support.describe(e))
    }
    var closes = 0
    for name in names {
        if name == "close" {
            closes = closes + 1
        }
    }
    let once = closes == 1 && names[names.len - 1] == "close"
    print("next returns the close once {once}")
    platform.next(tool, 0) catch {
        Unsupported(detail) => {
            print("next afterwards fails with Unsupported: {detail}")
            return
        }
        e => {
            print("next afterwards fails with {e}")
            return
        }
    }
    print("next afterwards returned events")
}

fn destroyed_with_owner(display: platform.Display) ! platform.Error {
    using owner = platform.open_in(display, options("owner", 200, 100))?
    using tool = platform.open_in(display, owned_by(owner, "tool", 100, 60))?
    let handle = hwnd_of(tool)
    let target = drop_target_of(tool)
    {
        using moved = owner
    }
    print("the system destroyed the owned window {IsWindow(handle) == 0}")
    print("its handle is cleared {hwnd_of(tool) == null}")
    show_closed(tool)?
    SetLastError(0)
    {
        using moved = tool
    }
    let code = GetLastError()
    print("releasing it reports no failure {code == 0}")
}

fn drop_target_of(w: platform.Window) -> ptr {
    var name: []u16 = []
    for c in "OleDropTargetInterface" {
        name.push(u16(c))
    }
    name.push(0)
    let at: ptr[u16] = pin(name)
    let target = GetPropW(hwnd_of(w), at)
    unpin(at)
    target
}

fn drop_pins(w: platform.Window) -> i64 {
    if drop_target_of(w) == null {
        return 0
    }
    2
}

fn destroyed_quietly(display: platform.Display) ! platform.Error {
    using owner = platform.open_in(display, options("owner", 200, 100))?
    using tool = platform.open_in(display, owned_by(owner, "tool", 100, 60))?
    DestroyWindow(hwnd_of(owner))
}

fn owner_released_first(display: platform.Display) ! platform.Error {
    using owner = platform.open_in(display, options("owner", 200, 100))?
    using tool = platform.open_in(display, owned_by(owner, "tool", 100, 60))?
    {
        using moved = owner
    }
}

fn fill_pins(taken: i64, free: i64) -> []ptr[i64] {
    let filler: []i64 = [0]
    var held: []ptr[i64] = []
    for i in 0..pin_capacity - display_pins - taken - free {
        let at: ptr[i64] = pin(filler)
        held.push(at)
    }
    held
}

fn release_pins(held: []ptr[i64]) {
    for at in held {
        unpin(at)
    }
}

fn pins_survive(display: platform.Display) ! platform.Error {
    let held = fill_pins(0, pin_slack)
    for i in 0..pin_cycles {
        destroyed_quietly(display)?
    }
    print("{pin_cycles} owned windows destroyed by the system left their pins free true")
    for i in 0..pin_cycles {
        owner_released_first(display)?
    }
    print("{pin_cycles} owners released first left their pins free true")
    release_pins(held)
}

fn drop_target_unpinned(display: platform.Display) ! platform.Error {
    using owner = platform.open_in(display, options("owner", 200, 100))?
    using tool = platform.open_in(display, owned_by(owner, "tool", 100, 60))?
    let drops = drop_pins(tool)
    let held = fill_pins(2 * (1 + drops), probe_free)
    {
        using moved = owner
    }
    let filler: []i64 = [0]
    var probed: []ptr[i64] = []
    for i in 0..probe_free + (1 + drops) + drops {
        let at: ptr[i64] = pin(filler)
        probed.push(at)
    }
    release_pins(probed)
    release_pins(held)
    print("the system destroyed window gave back its drop target pins {drops == 2}")
}

fn once() ! platform.Error {
    using display = platform.open_display()?
    placement_checks(display)?
    clamped(display)?
    destroyed_with_owner(display)?
    drop_target_unpinned(display)?
    pins_survive(display)?
}

fn main() {
    win32support.guard(once)
}
