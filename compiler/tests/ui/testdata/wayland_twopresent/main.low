import std/ui/platform
import twopresent

fn scale_of(events: []platform.Event) -> i64 {
    var scale = 1
    for e in events {
        match e {
            Resized(width, height, found) => {
                scale = i64(found)
            }
            _ => {}
        }
    }
    scale
}

fn settle(w: platform.Window, logical: twopresent.Size) -> twopresent.Size ! twopresent.Failure {
    let events = platform.next(w, 5000) catch twopresent.Failure.Window
    let scale = scale_of(events)
    twopresent.Size { width: logical.width * scale, height: logical.height * scale }
}

fn unread(w: platform.Window, size: twopresent.Size) -> []u8 {
    []
}

fn run() ! twopresent.Failure {
    using first = platform.open(platform.Options { title: "low wayland first", width: 200, height: 120 }) catch twopresent.Failure.Window
    using second = platform.open(platform.Options { title: "low wayland second", width: 320, height: 180 }) catch twopresent.Failure.Window
    let first_size = settle(first, twopresent.Size { width: 200, height: 120 })?
    let second_size = settle(second, twopresent.Size { width: 320, height: 180 })?
    let sizes = twopresent.Sizes { first: first_size, second: second_size }
    twopresent.run(first, second, sizes, fn(w, size) { unread(w, size) })?
}

fn main() ! twopresent.Failure {
    run() catch {
        Window(error) => {
            match error {
                NoDisplay(detail) => {
                    print("no display")
                    return
                }
                e => fail twopresent.Failure.Window(e)
            }
        }
        Graphics(error) => {
            match error {
                NoDevice => {
                    print("no device")
                    return
                }
                e => fail twopresent.Failure.Graphics(e)
            }
        }
        NoPresenter => {
            print("no presenter")
        }
    }
}
