import std/ui/gpu
import std/ui/scene
import std/ui/geometry
import support

fn straight() -> scene.Scene {
    var s = scene.empty(64, 48, geometry.rgb(0xffffff))
    scene.push_underline(mut s, scene.Underline { bounds: geometry.rect(8.0, 8.0, 24.0, 2.0), color: geometry.rgb(0xff0000) })
    scene.push_underline(mut s, scene.Underline { bounds: geometry.rect(40.0, 8.0, 16.0, 2.0), color: geometry.rgba(0x00000080) })

    scene.push_clip(mut s, geometry.rect(8.0, 16.0, 12.0, 4.0))
    scene.push_underline(mut s, scene.Underline { bounds: geometry.rect(8.0, 16.0, 24.0, 4.0), color: geometry.rgb(0xff0000) })
    scene.pop_clip(mut s)

    scene.push_quad(mut s, scene.Quad { bounds: geometry.rect(8.0, 28.0, 16.0, 12.0), background: geometry.rgb(0x00ff00) })
    scene.push_underline(mut s, scene.Underline { bounds: geometry.rect(8.0, 32.0, 16.0, 2.0), color: geometry.rgb(0x000000) })

    scene.push_underline(mut s, scene.Underline { bounds: geometry.rect(40.0, 28.0, 16.0, 12.0), color: geometry.rgb(0x000000) })
    scene.push_quad(mut s, scene.Quad { bounds: geometry.rect(40.0, 28.0, 16.0, 12.0), background: geometry.rgb(0x0000ff) })
    s
}

fn wavy() -> scene.Scene {
    var s = scene.empty(64, 24, geometry.rgb(0xffffff))
    scene.push_underline(mut s, scene.Underline { bounds: geometry.rect(4.0, 4.0, 56.0, 12.0), color: geometry.rgb(0x0000ff), thickness: 2.0, wavy: 1.0 })
    s
}

fn render() ! gpu.Error {
    using g = gpu.open()?
    var atlases = [scene.atlas(1024)]

    using flat = gpu.target(g, 64, 48)?
    gpu.render(g, flat, straight(), mut atlases)?
    support.snapshot(g, flat, "straight")?

    using curved = gpu.target(g, 64, 24)?
    gpu.render(g, curved, wavy(), mut atlases)?
    support.snapshot(g, curved, "wavy")?
}

fn main() ! gpu.Error {
    support.guard(render)?
}
