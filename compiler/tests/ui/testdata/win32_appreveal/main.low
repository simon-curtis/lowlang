import std/ui

extern "user32" {
    fn FindWindowW(class: ptr, title: ptr) -> ptr
    fn EnableWindow(hwnd: ptr, enable: i32) -> i32
}

extern "dwmapi" {
    fn DwmGetWindowAttribute(hwnd: ptr, attribute: u32, mut value: i32, size: u32) -> i32
}

extern "kernel32" {
    fn GetCurrentProcessId() -> u32
}

const dwmwa_cloaked: u32 = 14

fn wide(s: str) -> []u8 {
    var out: []u8 = []
    for b in bytes(s) {
        out.push(b)
        out.push(0)
    }
    out.push(0)
    out.push(0)
    out
}

fn find_window(title: str) -> ptr {
    let name = wide(title)
    let at: ptr[u8] = pin(name)
    let hwnd = FindWindowW(null, at)
    unpin(at)
    hwnd
}

fn cloak_state(hwnd: ptr) -> i64 {
    var state: i32 = -1
    if DwmGetWindowAttribute(hwnd, dwmwa_cloaked, mut state, 4) < 0 {
        return -1
    }
    i64(state)
}

fn report(hwnd: ptr, when: str) {
    print("{when}: cloaked {cloak_state(hwnd)}")
}

fn after_first_frame(h: ui.Handle, cx: ui.Context, hwnd: ptr) {
    sleep(300)
    ui.post(h, fn() {
        report(hwnd, "after the first frame")
        ui.quit(cx)
    })
}

fn nothing_to_draw(h: ui.Handle, cx: ui.Context, hwnd: ptr) {
    sleep(200)
    ui.post(h, fn() { report(hwnd, "before the deadline") })
    sleep(800)
    ui.post(h, fn() {
        report(hwnd, "after the deadline")
        ui.quit(cx)
    })
}

fn content() -> ui.Element {
    ui.div().child(ui.text("revealed"))
}

fn drawn() ! ui.Error {
    let title = "appreveal drawn {GetCurrentProcessId()}"
    using app = ui.open(ui.Options { title, width: 320, height: 200, activate: false })?
    let hwnd = find_window(title)
    let _ = EnableWindow(hwnd, 0)
    report(hwnd, "after open")
    spawn after_first_frame(ui.handle(app.cx), app.cx, hwnd)
    ui.run(app, content)?
}

fn empty() ! ui.Error {
    let title = "appreveal empty {GetCurrentProcessId()}"
    using app = ui.open(ui.Options { title, width: 0, height: 0, activate: false })?
    let hwnd = find_window(title)
    let _ = EnableWindow(hwnd, 0)
    report(hwnd, "empty after open")
    spawn nothing_to_draw(ui.handle(app.cx), app.cx, hwnd)
    ui.run(app, content)?
}

fn guard(body: fn() ! ui.Error) ! ui.Error {
    body() catch {
        Platform(error) => {
            match error {
                NoDisplay(detail) => {
                    print("no display")
                    return
                }
                e => fail ui.Error.Platform(e)
            }
        }
        Gpu(error) => {
            match error {
                NoDevice => {
                    print("skip no Vulkan 1.3 device that presents to a window")
                    return
                }
                Vulkan(call, result) => {
                    print("skip Vulkan {call} returned {result}, so no window can be drawn")
                    return
                }
                e => fail ui.Error.Gpu(e)
            }
        }
    }
}

fn main() ! ui.Error {
    guard(drawn)?
    guard(empty)?
}
