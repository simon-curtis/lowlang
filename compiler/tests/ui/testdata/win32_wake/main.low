import std/ui/platform
import win32support

fn wake_after(k: platform.Waker, ms: i64, times: i64) {
    sleep(ms)
    for i in 0..times {
        platform.wake(k)
    }
}

fn once() ! platform.Error {
    using w = platform.open(platform.Options { title: "wake", width: 320, height: 200 })?
    let scale = win32support.ready(w)?
    let k = platform.waker(w)

    win32support.show(platform.next(w, 50)?)

    spawn wake_after(k, 100, 1)
    win32support.show(platform.next(w, -1)?)

    platform.wake(k)
    win32support.show(platform.next(w, -1)?)

    platform.wake(k)
    platform.wake(k)
    win32support.post(w, 0x200, 0, win32support.point(3 * scale, 4 * scale))
    win32support.show_stable(platform.next(w, 1000)?)
    win32support.show_stable(platform.next(w, 0)?)

    spawn wake_after(k, 100, 3)
    var woken = 0
    for woken < 3 {
        for e in platform.next(w, 2000)? {
            match e {
                Woken => {
                    woken += 1
                }
                _ => {}
            }
        }
    }
    print("woken {woken}")

    let before = platform.next(w, 0)?
    win32support.show_stable(before)
}

fn main() {
    win32support.guard(once)
}
