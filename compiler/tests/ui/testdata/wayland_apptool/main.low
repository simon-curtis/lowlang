import std/ui

const patient_ms = 10000
const step_ms = 10

struct Seen {
    main_renders: i64 = 0
    main_count: i64 = -1
    tool_renders: i64 = 0
    tool: ui.Window? = none
    closed: i64 = 0
}

fn until(ready: fn() -> bool) -> bool {
    for waited in 0..patient_ms / step_ms {
        if ready() {
            return true
        }
        sleep(step_ms)
    }
    ready()
}

fn main_view(seen: *Seen, count: ui.Signal[i64]) -> ui.Element {
    seen.main_renders += 1
    seen.main_count = ui.get(count)
    ui.div().size(320.0, 200.0).child(ui.text("count {ui.get(count)}"))
}

fn tool_view(seen: *Seen) -> ui.Element {
    seen.tool_renders += 1
    ui.div().size(240.0, 160.0).child(ui.text("tool"))
}

fn open_tool(cx: ui.Context, seen: *Seen) {
    let on_closed = fn(why: ui.CloseReason) { seen.closed += 1 }
    let options = ui.WindowOptions { title: "low wayland tool", width: 240, height: 160, activate: false, closed: on_closed }
    let w = ui.open_window(cx, options, fn() -> ui.Element { tool_view(seen) }) catch {
        e => {
            print("open_window failed {e}")
            return
        }
    }
    seen.tool = w
}

fn close_tool(seen: *Seen) {
    let w = seen.tool ?? return
    ui.close_window(w)
}

fn drive(h: ui.Handle, cx: ui.Context, seen: *Seen, count: ui.Signal[i64]) {
    print("the main window drew its first frame {until(fn() -> bool { seen.main_renders > 0 })}")
    ui.post(h, fn() { open_tool(cx, seen) })
    print("open_window opened a second window that drew a frame {until(fn() -> bool { seen.tool_renders > 0 })}")
    ui.post(h, fn() { ui.update(count, fn(n: i64) -> i64 { n + 1 }) })
    print("a signal set by a post changed the main window's next frame {until(fn() -> bool { seen.main_count == 1 })}")
    ui.post(h, fn() { close_tool(seen) })
    print("closing the second window ran closed {until(fn() -> bool { seen.closed == 1 })}")
    ui.post(h, fn() { ui.quit(cx) })
}

fn once() ! ui.Error {
    using app = ui.open(ui.Options { title: "low wayland apptool", width: 320, height: 200, activate: false })?
    let cx = app.cx
    let seen = new(Seen {})
    let count = ui.signal(cx, 0)
    spawn drive(ui.handle(cx), cx, seen, count)
    ui.run(app, fn() -> ui.Element { main_view(seen, count) })?
    print("run ended")
}

fn main() ! ui.Error {
    once() catch {
        Platform(error) => {
            match error {
                NoDisplay(detail) => {
                    print("no display")
                    return
                }
                e => fail ui.Error.Platform(e)
            }
        }
        Gpu(error) => {
            match error {
                NoDevice => {
                    print("no device")
                    return
                }
                e => fail ui.Error.Gpu(e)
            }
        }
        e => fail e
    }
}
