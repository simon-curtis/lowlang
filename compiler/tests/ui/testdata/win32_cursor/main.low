import std/ui/platform
import win32support

struct Shape {
    name: str
    cursor: platform.Cursor
    resource: i64
}

fn shapes() -> []Shape {
    [
        Shape { name: "text", cursor: platform.Cursor.Text, resource: 32513 }
        Shape { name: "pointer", cursor: platform.Cursor.Pointer, resource: 32649 }
        Shape { name: "crosshair", cursor: platform.Cursor.Crosshair, resource: 32515 }
        Shape { name: "grab", cursor: platform.Cursor.Grab, resource: 32649 }
        Shape { name: "grabbing", cursor: platform.Cursor.Grabbing, resource: 32649 }
        Shape { name: "not allowed", cursor: platform.Cursor.NotAllowed, resource: 32648 }
        Shape { name: "move", cursor: platform.Cursor.Move, resource: 32646 }
        Shape { name: "wait", cursor: platform.Cursor.Wait, resource: 32514 }
        Shape { name: "progress", cursor: platform.Cursor.Progress, resource: 32650 }
        Shape { name: "help", cursor: platform.Cursor.Help, resource: 32651 }
        Shape { name: "left right", cursor: platform.Cursor.ResizeLeftRight, resource: 32644 }
        Shape { name: "up down", cursor: platform.Cursor.ResizeUpDown, resource: 32645 }
        Shape { name: "up left down right", cursor: platform.Cursor.ResizeUpLeftDownRight, resource: 32642 }
        Shape { name: "up right down left", cursor: platform.Cursor.ResizeUpRightDownLeft, resource: 32643 }
        Shape { name: "arrow", cursor: platform.Cursor.Arrow, resource: 32512 }
    ]
}

fn client_hit(w: platform.Window) -> i64 {
    win32support.ask(w, 0x20, 0, 1 | (0x200 << 16))
}

fn caption_hit(w: platform.Window) -> i64 {
    win32support.ask(w, 0x20, 0, 2 | (0x200 << 16))
}

fn once() ! platform.Error {
    using w = platform.open(platform.Options { title: "cursor", width: 320, height: 200, activate: false })?
    let scale = win32support.ready(w)?
    let inside = win32support.point(10 * scale, 20 * scale)

    win32support.clear_cursor()
    platform.set_cursor(w, platform.Cursor.Wait)
    print("away from the window, unchanged {win32support.cursor_hidden()}")
    print("client hit handled {client_hit(w)} wait {win32support.cursor_is(32514)}")

    win32support.send(w, 0x200, 0, inside)
    for shape in shapes() {
        win32support.clear_cursor()
        platform.set_cursor(w, shape.cursor)
        print("over the window, {shape.name} {win32support.cursor_is(shape.resource)}")
        win32support.clear_cursor()
        let _ = client_hit(w)
        print("client hit, {shape.name} {win32support.cursor_is(shape.resource)}")
    }

    platform.set_cursor(w, platform.Cursor.Text)
    win32support.clear_cursor()
    print("caption hit not handled {caption_hit(w) != 1}")
    print("caption hit leaves text {!win32support.cursor_is(32513)}")

    platform.set_cursor(w, platform.Cursor.Hidden)
    print("hidden {win32support.cursor_hidden()}")
    win32support.clear_cursor()
    let _ = client_hit(w)
    print("hidden on client hit {win32support.cursor_hidden()}")

    win32support.send(w, 0x2A3, 0, 0)
    win32support.clear_cursor()
    platform.set_cursor(w, platform.Cursor.Help)
    print("left the window, unchanged {win32support.cursor_hidden()}")
    let _ = client_hit(w)
    print("client hit, help {win32support.cursor_is(32651)}")
    win32support.show_stable(platform.next(w, 100)?)
}

fn main() {
    win32support.guard(once)
}
