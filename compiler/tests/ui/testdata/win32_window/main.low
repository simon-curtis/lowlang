import std/ui/platform
import win32support

fn scales(events: []platform.Event) {
    for e in events {
        match e {
            Resized(width, height, found) => print("resized scale {found} sized {width > 0 && height > 0}")
            _ => print(win32support.describe(e))
        }
    }
    if events.len == 0 {
        print("no events")
    }
}

fn once() ! platform.Error {
    using w = platform.open(platform.Options { title: "window", width: 320, height: 200 })?
    let scale = win32support.ready(w)?

    win32support.post(w, 0x7, 0, 0)
    win32support.post(w, 0x8, 0, 0)
    win32support.show(platform.next(w, 1000)?)

    win32support.post(w, 0x10, 0, 0)
    win32support.post(w, 0x200, 0, win32support.point(5 * scale, 6 * scale))
    win32support.show_stable(platform.next(w, 1000)?)

    win32support.send(w, 0x5, 0, win32support.point(400 * scale, 300 * scale))
    win32support.send(w, 0x5, 0, win32support.point(400 * scale, 300 * scale))
    win32support.send(w, 0x5, 1, 0)
    win32support.send(w, 0x5, 0, win32support.point(401 * scale + scale - 1, 301 * scale))
    win32support.show(platform.next(w, 1000)?)

    win32support.change_dpi(w, 192, 40, 40, 840, 640)
    scales(platform.next(w, 1000)?)

    win32support.change_dpi(w, 96, 40, 40, 440, 340)
    scales(platform.next(w, 1000)?)

    win32support.change_dpi(w, 120, 40, 40, 540, 440)
    scales(platform.next(w, 1000)?)

    win32support.change_dpi(w, 144, 40, 40, 540, 440)
    scales(platform.next(w, 1000)?)
}

fn main() {
    win32support.guard(once)
}
