import std/ui/gpu
import std/ui/scene
import std/ui/geometry
import support

fn swatch(width: i64, height: i64, step: i64) -> scene.Scene {
    var s = scene.empty(width, height, geometry.rgb(0x000000))
    let shade = f32(step * 30) / 255.0
    let color = geometry.Color { r: shade, g: 1.0 - shade, b: 0.0, a: 1.0 }
    scene.push_quad(mut s, scene.Quad { bounds: geometry.rect(f32(step * 8), 4.0, 8.0, 8.0), background: color })
    s
}

fn render() ! gpu.Error {
    using g = gpu.open()?
    using wide = gpu.target(g, 64, 16)?
    using square = gpu.target(g, 24, 24)?
    var atlas = scene.atlas(1024)

    for step in 0..6 {
        let scene_for_wide = swatch(64, 16, step)
        gpu.render(g, wide, scene_for_wide, mut atlas)?
        support.snapshot(g, wide, "step{step}")?
    }

    for step in 0..4 {
        let burst = swatch(64, 16, step)
        gpu.render(g, wide, burst, mut atlas)?
    }
    support.snapshot(g, wide, "burst")?

    var tall = scene.empty(24, 24, geometry.rgb(0x808080))
    scene.push_quad(mut tall, scene.Quad { bounds: geometry.rect(2.0, 2.0, 20.0, 20.0), background: geometry.rgb(0xff00ff) })
    gpu.render(g, square, tall, mut atlas)?
    let last = swatch(64, 16, 7)
    gpu.render(g, wide, last, mut atlas)?
    support.snapshot(g, square, "square")?
    support.snapshot(g, wide, "wide")?

    let empty_scene = scene.empty(64, 16, geometry.rgb(0x336699))
    gpu.render(g, wide, empty_scene, mut atlas)?
    support.snapshot(g, wide, "empty")?
}

fn rejects() ! gpu.Error {
    using g = gpu.open()?
    using bad = gpu.target(g, 0, 10) catch {
        InvalidSize(w, h) => {
            print("invalid {w} {h}")
            return
        }
        e => fail e
    }
    print("accepted {bad.width}")
}

fn main() ! gpu.Error {
    support.guard(render)?
    support.guard(rejects)?
}
