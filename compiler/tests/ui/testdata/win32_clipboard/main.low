import std/text
import std/ui/platform
import win32support

fn restore(w: platform.Window, saved: win32support.SavedClipboard) {
    if !win32support.restore_clipboard(w, saved) {
        print("restore failed")
    }
}

fn long_text() -> str {
    let body = text.repeat("x", 20000)
    "{body}é😀"
}

fn once() ! platform.Error {
    using w = platform.open(platform.Options { title: "clipboard", width: 320, height: 200, activate: false })?
    let _ = win32support.ready(w)?
    let saved = win32support.save_clipboard(w)
    if !saved.kept {
        print("skip the clipboard holds data that cannot be put back")
        return
    }
    defer restore(w, saved)
    let c = platform.clipboard(w)

    let sample = "héllo 😀\nline"
    platform.write_clipboard(c, sample)?
    print("roundtrip {platform.read_clipboard(c)? == some(sample)}")
    let units = win32support.clipboard_units(w)
    print("units {units.len} {units[6]} {units[7]} {units[8]}")

    platform.write_clipboard(c, "second")?
    print("replaced {platform.read_clipboard(c)? == some("second")}")

    platform.write_clipboard(c, "")?
    print("empty {platform.read_clipboard(c)? == some("")}")

    let long = long_text()
    platform.write_clipboard(c, long)?
    print("long {platform.read_clipboard(c)? == some(long)}")

    print("private {win32support.put_private_clipboard(w)}")
    print("not text {platform.read_clipboard(c)? == none}")

    win32support.clear_clipboard(w)
    print("cleared {platform.read_clipboard(c)? == none}")
}

fn main() {
    win32support.guard(once)
}
