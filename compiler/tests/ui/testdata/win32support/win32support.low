import std/text
import std/ui/platform

extern "user32" {
    fn GetWindowLongPtrW(hwnd: ptr, index: i32) -> i64
    fn SetWindowLongPtrW(hwnd: ptr, index: i32, value: i64) -> i64
    fn PostMessageW(hwnd: ptr, message: u32, wparam: i64, lparam: i64) -> i32
    fn RegisterWindowMessageW(name: ptr) -> u32
    fn SendMessageW(hwnd: ptr, message: u32, wparam: i64, lparam: i64) -> i64
    fn SendMessageRect(hwnd: ptr, message: u32, wparam: i64, mut rect: Rect) -> i64 = "SendMessageW"
    fn SetKeyboardState(state: ptr[u8]) -> i32
    fn GetClientRect(hwnd: ptr, mut rect: Rect) -> i32
    fn GetWindowRect(hwnd: ptr, mut rect: Rect) -> i32
    fn ClientToScreen(hwnd: ptr, mut at: Point) -> i32
    fn ShowWindow(hwnd: ptr, command: i32) -> i32
    fn IsZoomed(hwnd: ptr) -> i32
    fn IsIconic(hwnd: ptr) -> i32
    fn IsWindowVisible(hwnd: ptr) -> i32
    fn GetDpiForWindow(hwnd: ptr) -> u32
    fn GetSystemMetricsForDpi(index: i32, dpi: u32) -> i32
    fn MonitorFromWindow(hwnd: ptr, flags: u32) -> ptr
    fn GetMonitorInfoW(monitor: ptr, mut info: MonitorInfo) -> i32
    fn EnableWindow(hwnd: ptr, enable: i32) -> i32
    fn GetCursor() -> ptr
    fn SetCursor(cursor: ptr) -> ptr
    fn LoadCursorW(instance: ptr, name: i64) -> ptr
    fn OpenClipboard(hwnd: ptr) -> i32
    fn CloseClipboard() -> i32
    fn EmptyClipboard() -> i32
    fn EnumClipboardFormats(format: u32) -> u32
    fn GetClipboardData(format: u32) -> ptr
    fn SetClipboardData(format: u32, memory: ptr) -> ptr
}

extern "dwmapi" {
    fn DwmGetWindowAttribute(hwnd: ptr, attribute: u32, mut value: i32, size: u32) -> i32
}

extern "ntdll" {
    fn RtlGetVersion(info: ptr[u32]) -> i32
}

extern "kernel32" {
    fn GlobalAlloc(flags: u32, size: i64) -> ptr
    fn GlobalLock(memory: ptr) -> ptr
    fn GlobalUnlock(memory: ptr) -> i32
    fn GlobalSize(memory: ptr) -> i64
    fn RtlMoveMemory(destination: ptr, source: ptr, size: i64)
}

extern struct Rect {
    left: i32
    top: i32
    right: i32
    bottom: i32
}

extern struct Point {
    x: i32
    y: i32
}

extern struct MonitorInfo {
    size: u32
    monitor_left: i32
    monitor_top: i32
    monitor_right: i32
    monitor_bottom: i32
    work_left: i32
    work_top: i32
    work_right: i32
    work_bottom: i32
    flags: u32
}

pub fn pixels(w: platform.Window, logical: i64) -> i64 {
    (logical * i64(GetDpiForWindow(platform.native(w).window)) + 48) / 96
}

pub fn screen_point(w: platform.Window, x: i64, y: i64) -> i64 {
    var at = Point { x: i32(x), y: i32(y) }
    let _ = ClientToScreen(platform.native(w).window, mut at)
    point(i64(at.x), i64(at.y))
}

pub fn client_width(w: platform.Window) -> i64 {
    var client = Rect { left: 0, top: 0, right: 0, bottom: 0 }
    let _ = GetClientRect(platform.native(w).window, mut client)
    i64(client.right - client.left)
}

pub fn client_height(w: platform.Window) -> i64 {
    var client = Rect { left: 0, top: 0, right: 0, bottom: 0 }
    let _ = GetClientRect(platform.native(w).window, mut client)
    i64(client.bottom - client.top)
}

pub fn client_fills_window(w: platform.Window) -> bool {
    var client = Rect { left: 0, top: 0, right: 0, bottom: 0 }
    var outer = Rect { left: 0, top: 0, right: 0, bottom: 0 }
    let _ = GetClientRect(platform.native(w).window, mut client)
    let _ = GetWindowRect(platform.native(w).window, mut outer)
    client.right - client.left == outer.right - outer.left && client.bottom - client.top == outer.bottom - outer.top
}

fn windows_build() -> u32 {
    var info: []u32 = []
    for i in 0..69 {
        info.push(0)
    }
    info[0] = 276
    let at: ptr[u32] = pin(info)
    let _ = RtlGetVersion(at)
    unpin(at)
    info[3]
}

pub fn has_border_colour() -> bool {
    windows_build() >= 22000
}

pub fn client_is_window_less_frame(w: platform.Window) -> bool {
    let hwnd = platform.native(w).window
    let dpi = GetDpiForWindow(hwnd)
    let padding = GetSystemMetricsForDpi(92, dpi)
    let side = GetSystemMetricsForDpi(32, dpi) + padding
    let bottom = GetSystemMetricsForDpi(33, dpi) + padding
    var top: i32 = 0
    if windows_build() >= 22000 {
        top = 1
    }
    var client = Rect { left: 0, top: 0, right: 0, bottom: 0 }
    var outer = Rect { left: 0, top: 0, right: 0, bottom: 0 }
    let _ = GetClientRect(hwnd, mut client)
    let _ = GetWindowRect(hwnd, mut outer)
    var origin = Point { x: 0, y: 0 }
    let _ = ClientToScreen(hwnd, mut origin)
    let right = origin.x + client.right - client.left
    let below = origin.y + client.bottom - client.top
    origin.x - outer.left == side && origin.y - outer.top == top && outer.right - right == side && outer.bottom - below == bottom
}

pub fn drain(w: platform.Window) -> []platform.Event ! platform.Error {
    var all: []platform.Event = []
    for {
        let events = platform.next(w, 300)?
        if events.len == 0 {
            return all
        }
        for e in events {
            all.push(e)
        }
    }
}

pub fn client_within_work_area(w: platform.Window) -> bool {
    let hwnd = platform.native(w).window
    var client = Rect { left: 0, top: 0, right: 0, bottom: 0 }
    let _ = GetClientRect(hwnd, mut client)
    var origin = Point { x: 0, y: 0 }
    let _ = ClientToScreen(hwnd, mut origin)
    var info = MonitorInfo { size: 40, monitor_left: 0, monitor_top: 0, monitor_right: 0, monitor_bottom: 0, work_left: 0, work_top: 0, work_right: 0, work_bottom: 0, flags: 0 }
    if GetMonitorInfoW(MonitorFromWindow(hwnd, 2), mut info) == 0 {
        return false
    }
    let right = origin.x + client.right - client.left
    let bottom = origin.y + client.bottom - client.top
    origin.x >= info.work_left && origin.y >= info.work_top && right <= info.work_right && bottom <= info.work_bottom
}

const gwl_exstyle: i32 = -20
const ws_ex_noactivate: i64 = 0x08000000

pub fn never_activate(w: platform.Window) {
    let hwnd = platform.native(w).window
    SetWindowLongPtrW(hwnd, gwl_exstyle, GetWindowLongPtrW(hwnd, gwl_exstyle) | ws_ex_noactivate)
}

pub fn show_window(w: platform.Window, command: i32) {
    ShowWindow(platform.native(w).window, command)
}

pub fn visible(w: platform.Window) -> bool {
    IsWindowVisible(platform.native(w).window) != 0
}

pub fn cloak_state(w: platform.Window) -> i64 {
    var state: i32 = -1
    let result = DwmGetWindowAttribute(platform.native(w).window, 14, mut state, 4)
    if result < 0 {
        return -1
    }
    i64(state)
}

pub fn zoomed(w: platform.Window) -> bool {
    IsZoomed(platform.native(w).window) != 0
}

pub fn iconic(w: platform.Window) -> bool {
    IsIconic(platform.native(w).window) != 0
}

pub fn post(w: platform.Window, message: u32, wparam: i64, lparam: i64) {
    PostMessageW(platform.native(w).window, message, wparam, lparam)
}

pub fn registered(name: str) -> u32 {
    var units: u8[] = []
    for unit in bytes(name) {
        units.push(unit)
        units.push(0)
    }
    units.push(0)
    units.push(0)
    let at = pin(units)
    let message = RegisterWindowMessageW(at)
    unpin(at)
    message
}

pub fn send(w: platform.Window, message: u32, wparam: i64, lparam: i64) {
    SendMessageW(platform.native(w).window, message, wparam, lparam)
}

pub fn ask(w: platform.Window, message: u32, wparam: i64, lparam: i64) -> i64 {
    SendMessageW(platform.native(w).window, message, wparam, lparam)
}

pub fn cursor_is(resource: i64) -> bool {
    GetCursor() == LoadCursorW(null, resource)
}

pub fn cursor_hidden() -> bool {
    GetCursor() == null
}

pub fn clear_cursor() {
    SetCursor(null)
}

fn open_clipboard(w: platform.Window) -> i32 {
    for attempt in 0..200 {
        if OpenClipboard(platform.native(w).window) != 0 {
            return 1
        }
        sleep(5)
    }
    0
}

pub struct ClipboardEntry {
    pub format: u32
    pub data: []u8
}

pub struct SavedClipboard {
    pub kept: bool
    pub entries: []ClipboardEntry
}

fn holds_gdi_handle(format: u32) -> bool {
    format == 2 || format == 3 || format == 9 || format == 14 || (format >= 0x80 && format <= 0x8F) || (format >= 0x300 && format <= 0x3FF)
}

fn copy_out(memory: ptr) -> []u8 {
    let size = GlobalSize(memory)
    let source = GlobalLock(memory)
    let data = bytes(text.repeat(" ", size))
    if size > 0 && source != null {
        let target: ptr[u8] = pin(data)
        RtlMoveMemory(target, source, size)
        unpin(target)
    }
    let _ = GlobalUnlock(memory)
    data
}

pub fn save_clipboard(w: platform.Window) -> SavedClipboard {
    var saved = SavedClipboard { kept: false, entries: [] }
    if open_clipboard(w) == 0 {
        return saved
    }
    var whole = true
    var format = EnumClipboardFormats(0)
    for format != 0 {
        let memory = GetClipboardData(format)
        if memory == null || holds_gdi_handle(format) {
            whole = false
        } else {
            saved.entries.push(ClipboardEntry { format, data: copy_out(memory) })
        }
        format = EnumClipboardFormats(format)
    }
    let _ = CloseClipboard()
    saved.kept = whole
    saved
}

pub fn restore_clipboard(w: platform.Window, saved: SavedClipboard) -> bool {
    if open_clipboard(w) == 0 {
        return false
    }
    let _ = EmptyClipboard()
    var restored = true
    for entry in saved.entries {
        let memory = GlobalAlloc(2, entry.data.len)
        let target = GlobalLock(memory)
        if memory == null || target == null {
            restored = false
            continue
        }
        let data = entry.data
        let source: ptr[u8] = pin(data)
        RtlMoveMemory(target, source, entry.data.len)
        unpin(source)
        let _ = GlobalUnlock(memory)
        if SetClipboardData(entry.format, memory) == null {
            restored = false
        }
    }
    let _ = CloseClipboard()
    restored
}

pub fn clear_clipboard(w: platform.Window) {
    if open_clipboard(w) != 0 {
        let _ = EmptyClipboard()
        CloseClipboard()
    }
}

pub fn put_private_clipboard(w: platform.Window) -> bool {
    let memory = GlobalAlloc(2, 8)
    if memory == null {
        return false
    }
    if open_clipboard(w) == 0 {
        return false
    }
    let _ = EmptyClipboard()
    let placed = SetClipboardData(0x200, memory) != null
    let _ = CloseClipboard()
    placed
}

pub fn clipboard_units(w: platform.Window) -> []i64 {
    var units: []i64 = []
    if open_clipboard(w) == 0 {
        return units
    }
    let memory = GetClipboardData(13)
    if memory != null {
        let size = GlobalSize(memory)
        let source = GlobalLock(memory)
        var raw: []u16 = []
        for i in 0..size / 2 {
            raw.push(0)
        }
        let target: ptr[u16] = pin(raw)
        RtlMoveMemory(target, source, 2 * raw.len)
        unpin(target)
        let _ = GlobalUnlock(memory)
        for unit in raw {
            if unit == 0 {
                break
            }
            units.push(i64(unit))
        }
    }
    let _ = CloseClipboard()
    units
}

pub fn change_dpi(w: platform.Window, dpi: i64, left: i32, top: i32, right: i32, bottom: i32) {
    var suggested = Rect { left, top, right, bottom }
    SendMessageRect(platform.native(w).window, 0x2E0, dpi, mut suggested)
}

pub fn client_size(w: platform.Window) -> str {
    var client = Rect { left: 0, top: 0, right: 0, bottom: 0 }
    let _ = GetClientRect(platform.native(w).window, mut client)
    "{client.right - client.left} {client.bottom - client.top}"
}

pub fn hold(shift: bool, control: bool, alt: bool) {
    var state: []u8 = []
    for i in 0..256 {
        state.push(0)
    }
    if shift {
        state[0x10] = 0x80
    }
    if control {
        state[0x11] = 0x80
    }
    if alt {
        state[0x12] = 0x80
    }
    let at: ptr[u8] = pin(state)
    let _ = SetKeyboardState(at)
    unpin(at)
}

pub fn point(x: i64, y: i64) -> i64 {
    ((y & 0xFFFF) << 16) | (x & 0xFFFF)
}

pub fn describe(e: platform.Event) -> str {
    match e {
        Resized(width, height, scale) => "resized {width} {height}"
        CloseRequested => "close"
        PointerMoved(x, y) => "move {x} {y}"
        PointerLeft => "leave"
        PointerDown(b) => "down {button_name(b.button)} {b.x} {b.y}{click_suffix(b)}"
        PointerUp(b) => "up {button_name(b.button)} {b.x} {b.y}{click_suffix(b)}"
        Scrolled(dx, dy, modifiers) => "scroll {dx} {dy}{modifier_names(modifiers)}"
        Key(event) => describe_key(event)
        Preedit(text, cursor) => "preedit [{text}] {cursor_text(cursor)}"
        Commit(text) => "commit [{text}]"
        Maximized(maximized) => "maximized {maximized}"
        FocusChanged(focused) => "focus {focused}"
        Woken => "woken"
        FileDragEntered(x, y, paths) => "file drag entered {x} {y} [{joined_paths(paths)}]"
        FileDragMoved(x, y) => "file drag moved {x} {y}"
        FileDropped(x, y) => "file dropped {x} {y}"
        FileDragExited => "file drag exited"
    }
}

fn joined_paths(paths: []str) -> str {
    text.join(paths, "|")
}

fn cursor_text(cursor: platform.TextRange?) -> str {
    match cursor {
        some(range) => "{range.start}-{range.end}"
        none => "hidden"
    }
}

fn button_name(b: platform.Button) -> str {
    match b {
        Left => "left"
        Right => "right"
        Middle => "middle"
        Navigate(direction) => {
            match direction {
                Back => "back"
                Forward => "forward"
            }
        }
        Other(code) => "other{code}"
    }
}

fn click_suffix(b: platform.ButtonEvent) -> str {
    var out = if b.clicks == 1 { "" } else { " x{b.clicks}" }
    if b.modifiers.shift {
        out = "{out} shift"
    }
    if b.modifiers.control {
        out = "{out} control"
    }
    out
}

fn describe_key(e: platform.KeyEvent) -> str {
    let edge = if e.pressed { "press" } else { "release" }
    let repeat = if e.repeat { " repeat" } else { "" }
    "key {edge} {key_name(e.key)} text={e.text}{modifier_names(e.modifiers)}{repeat}"
}

fn key_name(k: platform.Key) -> str {
    match k {
        Named(key) => named_name(key)
        Character(text) => "'{text}'"
    }
}

fn named_name(k: platform.NamedKey) -> str {
    match k {
        Enter => "Enter"
        Escape => "Escape"
        Tab => "Tab"
        Backspace => "Backspace"
        Delete => "Delete"
        Left => "Left"
        Right => "Right"
        Up => "Up"
        Down => "Down"
        Home => "Home"
        End => "End"
        PageUp => "PageUp"
        PageDown => "PageDown"
        Insert => "Insert"
        Pause => "Pause"
        Break => "Break"
        Menu => "Menu"
        Function(number) => "F{number}"
    }
}

fn modifier_names(m: platform.Modifiers) -> str {
    var names = ""
    if m.shift {
        names = "{names} shift"
    }
    if m.control {
        names = "{names} control"
    }
    if m.alt {
        names = "{names} alt"
    }
    if m.super {
        names = "{names} super"
    }
    names
}

pub fn show(events: []platform.Event) {
    for e in events {
        print(describe(e))
    }
    if events.len == 0 {
        print("no events")
    }
}

pub fn show_stable(events: []platform.Event) {
    var kept: []platform.Event = []
    for e in events {
        match e {
            PointerLeft => {}
            FocusChanged(focused) => {}
            _ => kept.push(e)
        }
    }
    show(kept)
}

pub fn scale_of(events: []platform.Event) -> i64 {
    for e in events {
        match e {
            Resized(width, height, scale) => return i64(floor(scale + 0.5))
            _ => {}
        }
    }
    0
}

pub fn ready(w: platform.Window) -> i64 ! platform.Error {
    let _ = EnableWindow(platform.native(w).window, 0)
    var scale = 0
    for {
        let events = platform.next(w, 300)?
        if events.len == 0 {
            return scale
        }
        let found = scale_of(events)
        if found > 0 {
            scale = found
        }
    }
}

pub fn guard(body: fn() ! platform.Error) {
    body() catch {
        NoDisplay(detail) => {
            print("no display")
        }
        e => {
            print("error: {e}")
        }
    }
}
