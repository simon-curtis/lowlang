import std/ui/platform

extern "user32" {
    fn PostMessageW(hwnd: ptr, message: u32, wparam: i64, lparam: i64) -> i32
    fn SendMessageW(hwnd: ptr, message: u32, wparam: i64, lparam: i64) -> i64
    fn SendMessageRect(hwnd: ptr, message: u32, wparam: i64, mut rect: Rect) -> i64 = "SendMessageW"
    fn SetKeyboardState(state: ptr[u8]) -> i32
    fn GetClientRect(hwnd: ptr, mut rect: Rect) -> i32
    fn EnableWindow(hwnd: ptr, enable: i32) -> i32
}

extern struct Rect {
    left: i32
    top: i32
    right: i32
    bottom: i32
}

pub fn post(w: platform.Window, message: u32, wparam: i64, lparam: i64) {
    PostMessageW(platform.native(w).window, message, wparam, lparam)
}

pub fn send(w: platform.Window, message: u32, wparam: i64, lparam: i64) {
    SendMessageW(platform.native(w).window, message, wparam, lparam)
}

pub fn change_dpi(w: platform.Window, dpi: i64, left: i32, top: i32, right: i32, bottom: i32) {
    var suggested = Rect { left, top, right, bottom }
    SendMessageRect(platform.native(w).window, 0x2E0, dpi, mut suggested)
}

pub fn client_size(w: platform.Window) -> str {
    var client = Rect { left: 0, top: 0, right: 0, bottom: 0 }
    GetClientRect(platform.native(w).window, mut client)
    "{client.right - client.left} {client.bottom - client.top}"
}

pub fn hold(shift: bool, control: bool, alt: bool) {
    var state: []u8 = []
    for i in 0..256 {
        state.push(0)
    }
    if shift {
        state[0x10] = 0x80
    }
    if control {
        state[0x11] = 0x80
    }
    if alt {
        state[0x12] = 0x80
    }
    let at: ptr[u8] = pin(state)
    SetKeyboardState(at)
    unpin(at)
}

pub fn point(x: i64, y: i64) -> i64 {
    ((y & 0xFFFF) << 16) | (x & 0xFFFF)
}

pub fn describe(e: platform.Event) -> str {
    match e {
        Resized(width, height, scale) => "resized {width} {height}"
        CloseRequested => "close"
        PointerMoved(x, y) => "move {x} {y}"
        PointerLeft => "leave"
        PointerDown(button, x, y) => "down {button_name(button)} {x} {y}"
        PointerUp(button, x, y) => "up {button_name(button)} {x} {y}"
        Scrolled(dx, dy) => "scroll {dx} {dy}"
        Key(event) => describe_key(event)
        FocusChanged(focused) => "focus {focused}"
        Woken => "woken"
    }
}

fn button_name(b: platform.Button) -> str {
    match b {
        Left => "left"
        Right => "right"
        Middle => "middle"
        Other(code) => "other{code}"
    }
}

fn describe_key(e: platform.KeyEvent) -> str {
    let edge = if e.pressed { "press" } else { "release" }
    let repeat = if e.repeat { " repeat" } else { "" }
    "key {edge} {key_name(e.key)} text={e.text}{modifier_names(e.modifiers)}{repeat}"
}

fn key_name(k: platform.Key) -> str {
    match k {
        Named(key) => named_name(key)
        Character(text) => "'{text}'"
    }
}

fn named_name(k: platform.NamedKey) -> str {
    match k {
        Enter => "Enter"
        Escape => "Escape"
        Tab => "Tab"
        Backspace => "Backspace"
        Delete => "Delete"
        Left => "Left"
        Right => "Right"
        Up => "Up"
        Down => "Down"
        Home => "Home"
        End => "End"
        PageUp => "PageUp"
        PageDown => "PageDown"
        Function(number) => "F{number}"
    }
}

fn modifier_names(m: platform.Modifiers) -> str {
    var names = ""
    if m.shift {
        names = "{names} shift"
    }
    if m.control {
        names = "{names} control"
    }
    if m.alt {
        names = "{names} alt"
    }
    if m.super {
        names = "{names} super"
    }
    names
}

pub fn show(events: []platform.Event) {
    for e in events {
        print(describe(e))
    }
    if events.len == 0 {
        print("no events")
    }
}

pub fn show_stable(events: []platform.Event) {
    var kept: []platform.Event = []
    for e in events {
        match e {
            PointerLeft => {}
            FocusChanged(focused) => {}
            _ => kept.push(e)
        }
    }
    show(kept)
}

pub fn scale_of(events: []platform.Event) -> i64 {
    for e in events {
        match e {
            Resized(width, height, scale) => return scale
            _ => {}
        }
    }
    0
}

pub fn ready(w: platform.Window) -> i64 ! platform.Error {
    EnableWindow(platform.native(w).window, 0)
    var scale = 0
    for {
        let events = platform.next(w, 300)?
        if events.len == 0 {
            return scale
        }
        let found = scale_of(events)
        if found > 0 {
            scale = found
        }
    }
}

pub fn guard(body: fn() ! platform.Error) {
    body() catch {
        NoDisplay(detail) => {
            print("no display")
        }
        e => {
            print("error: {e}")
        }
    }
}
