import std/ui
import std/ui/geometry
import std/ui/gpu
import std/ui/platform
import support

fn to_green(v: ui.Visual) -> ui.Visual {
    v.with_background(ui.rgb(0x00ff00))
}

fn reveal(v: ui.Visual) -> ui.Visual {
    v.with_visible(true)
}

fn to_yellow(v: ui.Visual) -> ui.Visual {
    v.with_border_color(ui.rgb(0xffff00))
}

fn grouped(name: str, x: f32) -> ui.Element {
    let swatch = ui.div().absolute().left(10.0).top(10.0).size(40.0, 40.0).background(ui.rgb(0xff0000)).group_hover(name, to_green)
    let hidden = ui.div().absolute().left(60.0).top(10.0).size(30.0, 40.0).background(ui.rgb(0x0000ff)).invisible().group_hover(name, reveal)
    let framed = ui.div().absolute().left(10.0).top(60.0).size(80.0, 30.0).background(ui.rgb(0x404040)).border(2.0, ui.rgb(0x000000)).group_hover(name, to_yellow)
    ui.div().group(name).absolute().left(x).top(10.0).size(100.0, 100.0).background(ui.rgb(0xeeeeee)).children() {
        swatch,
        hidden,
        framed,
    }
}

fn scene() -> ui.Element {
    let outside = ui.div().absolute().left(10.0).top(120.0).size(30.0, 30.0).background(ui.rgb(0xff0000)).group_hover("a", to_green)
    ui.div().size(240.0, 160.0).background(ui.rgb(0xffffff)).children() {
        grouped("a", 10.0),
        grouped("b", 130.0),
        outside,
    }
}

fn render() ! gpu.Error {
    using g = gpu.open()?
    using t = gpu.target(g, 240, 160)?
    let cx = ui.headless(ui.rgb(0xffffff))
    ui.frame(cx, scene, geometry.size(240.0, 160.0), 1.0)
    ui.dispatch(cx, platform.Event.PointerMoved(105.0, 105.0))
    let frame = ui.frame(cx, scene, geometry.size(240.0, 160.0), 1.0)
    ui.draw(cx, g, t, frame)?
    support.snapshot(g, t, "group_hover")?
}

fn main() ! gpu.Error {
    support.guard(render)?
}
