import std/ui
import std/ui/geometry
import std/ui/gpu
import support

fn uniform_color(ix: i64) -> u32 {
    match ix % 6 {
        0 => 0xff0000
        1 => 0x00ff00
        2 => 0x0000ff
        3 => 0xffff00
        4 => 0xff00ff
        _ => 0x00ffff
    }
}

fn variable_color(ix: i64) -> u32 {
    match ix % 6 {
        0 => 0xc00000
        1 => 0x00c000
        2 => 0x0000c0
        3 => 0xc0c000
        4 => 0xc000c0
        _ => 0x00c0c0
    }
}

fn uniform_rows(start: i64, end: i64) -> ui.Element[] {
    var out: ui.Element[] = []
    for ix in start..end {
        out.push(ui.div().height(24.0).background(ui.rgb(uniform_color(ix))))
    }
    out
}

fn varied_row(ix: i64) -> ui.Element {
    ui.div().height(16.0 + f32(ix % 3) * 8.0).background(ui.rgb(variable_color(ix)))
}

fn boxed(x: f32, list: ui.Element) -> ui.Element {
    ui.div().absolute().left(x).top(10.0).size(100.0, 100.0).overflow_hidden().background(ui.rgb(0x808080)).child(list)
}

fn render() ! gpu.Error {
    using g = gpu.open()?
    using t = gpu.target(g, 240, 160)?
    let cx = ui.headless(ui.rgb(0xffffff))
    let handle = ui.uniform_list_scroll_handle(cx)
    let state = ui.list_state(cx, 100, ui.ListAlignment.Top, 0.0)
    ui.scroll_to_item(handle, 5, ui.ScrollStrategy.Center)
    ui.list_scroll_to(state, ui.ListOffset { item_ix: 2, offset_in_item: 10.0 })
    let scene = fn() -> ui.Element {
        let rows = ui.uniform_list("rows", 100, uniform_rows).track_scroll(handle).size(100.0, 130.0)
        let varied = ui.list(state, varied_row).size(100.0, 130.0)
        ui.div().size(240.0, 160.0).background(ui.rgb(0xffffff)).children() {
            boxed(10.0, rows),
            boxed(130.0, varied),
        }
    }
    let frame = ui.frame(cx, scene, geometry.size(240.0, 160.0), 1.0)
    ui.draw(cx, g, t, frame)?
    support.snapshot(g, t, "virtual_lists")?
}

fn main() ! gpu.Error {
    support.guard(render)?
}
