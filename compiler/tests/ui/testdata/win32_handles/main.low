import std/time
import std/ui/platform
import win32support

const patient_ms = 5000
const prompt_ms = 1500

fn options(title: str) -> platform.Options {
    platform.Options { title, width: 200, height: 100 }
}

fn released() -> platform.DisplayHandle ! platform.Error {
    using display = platform.open_display()?
    display.handle
}

fn live() ! platform.Error {
    using display = platform.open_display()?
    let handle = display.handle
    let open = fn(title: str) -> platform.Window ! platform.Error { platform.open_in_on(handle, options(title))? }
    using window = open("through a closure")?
    let ready = win32support.ready(window)?
    print("a window opened through a handle {platform.native(window).window != null && ready > 0}")
    let k = platform.waker_of_on(handle)
    platform.wake(k)
    let started = time.monotonic()
    platform.wait_on(handle, patient_ms)?
    print("a wake through a handle ended wait {(time.monotonic() - started) / 1000000 < prompt_ms}")
}

fn late_open(handle: platform.DisplayHandle) {
    using window = platform.open_in_on(handle, options("late")) catch {
        Unsupported(detail) => {
            print("open_in_on after the release fails with Unsupported: {detail}")
            return
        }
        e => {
            print("open_in_on after the release fails with {e}")
            return
        }
    }
    print("open_in_on after the release opened a window")
}

fn late_wait(handle: platform.DisplayHandle) {
    platform.wait_on(handle, 0) catch {
        Unsupported(detail) => {
            print("wait_on after the release fails with Unsupported: {detail}")
        }
        e => {
            print("wait_on after the release fails with {e}")
        }
    }
}

fn once() ! platform.Error {
    live()?
    let handle = released()?
    late_open(handle)
    late_wait(handle)
    platform.wake(platform.waker_of_on(handle))
    print("a wake after the release does nothing true")
}

fn main() {
    win32support.guard(once)
    win32support.guard(once)
}
