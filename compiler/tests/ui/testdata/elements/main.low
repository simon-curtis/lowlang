import std/ui
import std/ui/geometry
import std/ui/gpu
import std/ui/platform
import support

fn window() -> geometry.Size {
    geometry.size(100.0, 60.0)
}

fn snapshot(cx: ui.Context, g: gpu.Gpu, t: gpu.Target, view: fn() -> ui.Element, name: str) ! gpu.Error {
    let scene = ui.frame(cx, view, window(), 1.0)
    ui.draw(cx, g, t, scene)?
    support.snapshot(g, t, name)?
}

fn render() ! gpu.Error {
    using g = gpu.open()?
    using t = gpu.target(g, 100, 60)?
    let cx = ui.headless(ui.rgb(0xffffff))
    let clicks = ui.signal(cx, 0)
    let view = fn() -> ui.Element {
        let wide = 30.0 + 10.0 * f32(ui.get(clicks))
        ui.div().row().padding(10.0).gap(10.0).size(100.0, 60.0).children() {
            ui.div()
                .id("button")
                .size(30.0, 30.0)
                .background(ui.rgb(0x0000ff))
                .focusable()
                .focus(fn(v: ui.Visual) -> ui.Visual { v.with_background(ui.rgb(0xff00ff)) })
                .hover(fn(v: ui.Visual) -> ui.Visual { v.with_background(ui.rgb(0xff0000)) })
                .active(fn(v: ui.Visual) -> ui.Visual { v.with_background(ui.rgb(0xffff00)) })
                .on_click(fn() { ui.set(clicks, ui.get(clicks) + 1) }),
            ui.div().size(wide, 30.0).background(ui.rgb(0x00ff00)),
        }
    }
    snapshot(cx, g, t, view, "idle")?
    ui.dispatch(cx, platform.Event.PointerMoved(20.0, 20.0))
    snapshot(cx, g, t, view, "hover")?
    ui.dispatch(cx, platform.Event.PointerDown(platform.Button.Left, 20.0, 20.0))
    snapshot(cx, g, t, view, "pressed")?
    ui.dispatch(cx, platform.Event.PointerUp(platform.Button.Left, 20.0, 20.0))
    ui.dispatch(cx, platform.Event.PointerMoved(90.0, 50.0))
    snapshot(cx, g, t, view, "clicked")?
    scroll(g, t)?
}

fn tile(color: u32) -> ui.Element {
    ui.div().height(30.0).shrink(0.0).background(ui.rgb(color))
}

fn scroll(g: gpu.Gpu, t: gpu.Target) ! gpu.Error {
    let cx = ui.headless(ui.rgb(0xffffff))
    let view = fn() -> ui.Element {
        ui.div().id("list").column().size(60.0, 40.0).overflow_y_scroll().children() {
            tile(0xff0000),
            tile(0x00ff00),
            tile(0x0000ff),
        }
    }
    snapshot(cx, g, t, view, "list")?
    ui.dispatch(cx, platform.Event.PointerMoved(10.0, 10.0))
    ui.dispatch(cx, platform.Event.Scrolled(0.0, 30.0))
    snapshot(cx, g, t, view, "scrolled")?
}

fn main() ! gpu.Error {
    support.guard(render)?
}
