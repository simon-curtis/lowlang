import std/ui/platform
import win32support

const sw_shownoactivate: i32 = 4
const wm_nchittest: u32 = 0x84
const wm_ncmousemove: u32 = 0xA0
const wm_nclbuttondown: u32 = 0xA1
const wm_nclbuttonup: u32 = 0xA2
const wm_nclbuttondblclk: u32 = 0xA3
const wm_lbuttonup: u32 = 0x202
const bar_height = 30
const window_width = 320
const window_height = 200

fn areas(x: f32, y: f32) -> platform.WindowControlArea? {
    if x < 0.0 || y < 0.0 || x >= 320.0 || y >= 30.0 {
        return none
    }
    if x < 40.0 {
        return none
    }
    if x >= 290.0 {
        return platform.WindowControlArea.Close
    }
    if x >= 260.0 {
        return platform.WindowControlArea.Max
    }
    if x >= 230.0 {
        return platform.WindowControlArea.Min
    }
    platform.WindowControlArea.Drag
}

fn hit(w: platform.Window, name: str, x: i64, y: i64) {
    let at = win32support.screen_point(w, x, y)
    print("hit {name} {win32support.ask(w, wm_nchittest, 0, at)}")
}

fn hit_logical(w: platform.Window, name: str, x: i64, y: i64) {
    hit(w, name, win32support.pixels(w, x), win32support.pixels(w, y))
}

fn report(events: []platform.Event) {
    var sized = false
    var lines = 0
    for e in events {
        match e {
            Resized(width, height, scale) => {
                if !sized {
                    sized = true
                    lines += 1
                    print("resized sized {width > 0 && height > 0}")
                }
            }
            PointerMoved(x, y) => {
                lines += 1
                print("move {floor(x + 0.5)} {floor(y + 0.5)}")
            }
            PointerLeft => {}
            FocusChanged(focused) => {}
            _ => {
                lines += 1
                print(win32support.describe(e))
            }
        }
    }
    if lines == 0 {
        print("no events")
    }
}

fn caption_point(w: platform.Window, x: i64, y: i64) -> i64 {
    win32support.screen_point(w, win32support.pixels(w, x), win32support.pixels(w, y))
}

fn press(w: platform.Window, code: i64, x: i64, y: i64) {
    let at = caption_point(w, x, y)
    win32support.send(w, wm_nclbuttondown, code, at)
    win32support.send(w, wm_nclbuttonup, code, at)
}

fn double_click(w: platform.Window, code: i64, x: i64, y: i64) {
    let at = caption_point(w, x, y)
    win32support.send(w, wm_nclbuttondblclk, code, at)
    win32support.send(w, wm_nclbuttonup, code, at)
}

fn borders(w: platform.Window) {
    let right = win32support.client_width(w) + 1
    let bottom = win32support.client_height(w) + 1
    let middle = win32support.pixels(w, 100)
    let near = win32support.pixels(w, 10)
    hit(w, "left", -2, middle)
    hit(w, "right", right, middle)
    hit(w, "top", near, 2)
    hit(w, "bottom", middle, bottom)
    hit(w, "top left", -2, 2)
    hit(w, "top right", right, 2)
    hit(w, "bottom left", -2, bottom)
    hit(w, "bottom right", right, bottom)
}

fn release_elsewhere(w: platform.Window) ! platform.Error {
    let at = caption_point(w, 305, 15)
    win32support.send(w, wm_nclbuttondown, 20, at)
    let inside = win32support.point(win32support.pixels(w, 100), win32support.pixels(w, 100))
    win32support.send(w, wm_lbuttonup, 0, inside)
    win32support.send(w, wm_nclbuttonup, 20, at)
    report(platform.next(w, 200)?)
    report(platform.next(w, 200)?)
}

fn double_clicks(w: platform.Window, controls: platform.Controls) ! platform.Error {
    double_click(w, 9, 275, 15)
    report(win32support.drain(w)?)
    print("double click on the max area maximises {platform.is_maximized(controls)} {win32support.zoomed(w)}")
    press(w, 9, 275, 15)
    report(win32support.drain(w)?)
    print("restored by the button {!platform.is_maximized(controls)}")

    double_click(w, 2, 100, 15)
    report(win32support.drain(w)?)
    print("double click on the drag area runs no button action {!platform.is_maximized(controls)} {!win32support.iconic(w)}")
}

fn minimise_maximised(w: platform.Window, controls: platform.Controls) ! platform.Error {
    win32support.show_window(w, 3)
    report(win32support.drain(w)?)
    press(w, 8, 245, 15)
    report(win32support.drain(w)?)
    print("minimised while maximised {win32support.iconic(w)}")
    win32support.show_window(w, sw_shownoactivate)
    report(win32support.drain(w)?)
    print("still maximised {platform.is_maximized(controls)} {win32support.zoomed(w)}")
    win32support.show_window(w, sw_shownoactivate)
    report(win32support.drain(w)?)
    print("restored {!platform.is_maximized(controls)} {!win32support.zoomed(w)}")
}

fn once() ! platform.Error {
    let titlebar = platform.TitlebarOptions { appears_transparent: true }
    using w = platform.open(platform.Options { title: "titlebar", width: window_width, height: window_height, titlebar, activate: false })?
    platform.set_hit_test(w, areas)
    win32support.ready(w)?
    win32support.never_activate(w)
    let controls = platform.controls(w)

    print("client is the window less the frame {win32support.client_is_window_less_frame(w)}")
    print("client is the requested size {win32support.client_size(w) == "{win32support.pixels(w, 320)} {win32support.pixels(w, 200)}"}")
    print("restored {!platform.is_maximized(controls)}")
    hit_logical(w, "drag", 100, 15)
    hit_logical(w, "drag beside buttons", 225, 15)
    hit_logical(w, "min", 245, 15)
    hit_logical(w, "max", 275, 15)
    hit_logical(w, "close", 305, 15)
    hit_logical(w, "content", 100, 100)
    hit_logical(w, "content below bar", 245, bar_height + 20)
    borders(w)

    press(w, 20, 305, 15)
    win32support.show(platform.next(w, 1000)?)
    win32support.send(w, wm_nclbuttondown, 20, caption_point(w, 305, 15))
    win32support.send(w, wm_nclbuttonup, 9, caption_point(w, 275, 15))
    report(platform.next(w, 200)?)
    print("press and release elsewhere leaves it restored {!platform.is_maximized(controls)}")

    release_elsewhere(w)?
    double_clicks(w, controls)?

    win32support.send(w, wm_ncmousemove, 20, caption_point(w, 305, 15))
    report(platform.next(w, 1000)?)

    win32support.show_window(w, 3)
    report(platform.next(w, 1000)?)
    print("maximised {platform.is_maximized(controls)} {win32support.zoomed(w)}")
    print("client within work area {win32support.client_within_work_area(w)}")
    hit(w, "maximised top is drag", win32support.pixels(w, 100), 2)
    hit(w, "maximised right edge is content", win32support.client_width(w) - 3, win32support.pixels(w, 100))

    platform.toggle_maximize(controls)
    report(win32support.drain(w)?)
    print("restored {!platform.is_maximized(controls)} {!win32support.zoomed(w)}")
    print("client is the window less the frame {win32support.client_is_window_less_frame(w)}")

    press(w, 9, 275, 15)
    report(win32support.drain(w)?)
    print("maximised by the button {platform.is_maximized(controls)}")
    print("client within work area {win32support.client_within_work_area(w)}")
    press(w, 9, 275, 15)
    report(win32support.drain(w)?)
    print("restored by the button {!platform.is_maximized(controls)}")

    press(w, 8, 245, 15)
    win32support.drain(w)?
    print("minimised by the button {win32support.iconic(w)}")
    win32support.show_window(w, sw_shownoactivate)
    print("restored from the minimised state {!win32support.iconic(w)}")
    win32support.drain(w)?

    minimise_maximised(w, controls)?

    press(w, 20, 305, 15)
    report(platform.next(w, 1000)?)
}

fn main() {
    win32support.guard(once)
}
