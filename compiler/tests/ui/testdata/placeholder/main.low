import std/ui
import std/ui/geometry
import std/ui/gpu
import support

fn hint_box(top: f32, height: f32, size: f32, color: geometry.Color?) -> ui.Element {
    let base = ui.field("").id("hint-{top}").absolute().left(20.0).top(top).size(200.0, height).padding(6.0).background(ui.rgb(0xf0f0f0)).border(1.0, ui.rgb(0x3366aa)).font_family("Segoe UI").text_size(size).placeholder("Type here")
    match color {
        some(c) => base.placeholder_color(c)
        none => base
    }
}

fn scene() -> ui.Element {
    ui.div().size(240.0, 160.0).background(ui.rgb(0xffffff)).children() {
        hint_box(20.0, 44.0, 16.0, none),
        hint_box(80.0, 60.0, 20.0, some(ui.rgba(0xcc3300ff))),
    }
}

fn render() ! ui.Error {
    using app = ui.open(ui.Options { title: "placeholder", width: 240, height: 160, background: ui.rgb(0xffffff), titlebar: ui.TitlebarOptions { appears_transparent: true }, activate: false })?
    using g = gpu.open() catch Gpu
    using t = gpu.target(g, 240, 160) catch Gpu
    let frame = ui.frame(app.cx, scene, geometry.size(240.0, 160.0), 1.0)
    ui.draw(app.cx, g, t, frame) catch Gpu
    support.snapshot(g, t, "placeholder") catch Gpu
}

fn main() ! ui.Error {
    render() catch {
        Platform(error) => {
            match error {
                NoDisplay(detail) => {
                    print("no display")
                    return
                }
                e => fail ui.Error.Platform(e)
            }
        }
        Gpu(error) => {
            match error {
                NoDevice => {
                    print("no device")
                    return
                }
                e => fail ui.Error.Gpu(e)
            }
        }
    }
}
