import std/time
import std/ui/platform

fn elapsed_ms(since: i64) -> i64 {
    (time.monotonic() - since) / 1000000
}

fn count_woken(events: []platform.Event) -> i64 {
    var woken = 0
    for e in events {
        match e {
            Woken => {
                woken += 1
            }
            _ => {}
        }
    }
    woken
}

fn report_resized(events: []platform.Event) -> bool {
    var seen = false
    for e in events {
        match e {
            Resized(width, height, scale) => {
                print("resized {width} {height} {scale >= 1}")
                seen = true
            }
            _ => {}
        }
    }
    seen
}

fn wake_after(k: platform.Waker, ms: i64) {
    sleep(ms)
    platform.wake(k)
}

fn first_events(w: platform.Window) ! platform.Error {
    let events = platform.next(w, 5000)?
    if !report_resized(events) {
        print("no resize")
    }
}

fn idle(w: platform.Window) ! platform.Error {
    for attempt in 0..20 {
        let start = time.monotonic()
        let events = platform.next(w, 150)?
        if events.len == 0 {
            let waited = elapsed_ms(start)
            print("idle {waited >= 140} {waited < 1000}")
            return
        }
    }
    print("busy")
}

fn woken_from_thread(w: platform.Window) ! platform.Error {
    let k = platform.waker(w)
    spawn wake_after(k, 100)
    let start = time.monotonic()
    var seen = 0
    for seen == 0 {
        let events = platform.next(w, -1)?
        seen = count_woken(events)
    }
    let waited = elapsed_ms(start)
    print("woken {seen} {waited >= 90} {waited < 2000}")
}

fn woken_before_waiting(w: platform.Window) ! platform.Error {
    let k = platform.waker(w)
    platform.wake(k)
    platform.wake(k)
    let start = time.monotonic()
    let events = platform.next(w, 2000)?
    let waited = elapsed_ms(start)
    print("pending {count_woken(events)} {waited < 1000}")
    let rest = platform.next(w, 100)?
    print("coalesced {count_woken(rest)}")
}

fn run() ! platform.Error {
    using w = platform.open(platform.Options { title: "low wayland window", width: 320, height: 200 })?
    first_events(w)?
    idle(w)?
    woken_from_thread(w)?
    woken_before_waiting(w)?
    idle(w)?
    print("closing")
}

fn main() ! platform.Error {
    run() catch {
        NoDisplay(detail) => {
            print("no display")
        }
        e => fail e
    }
}
