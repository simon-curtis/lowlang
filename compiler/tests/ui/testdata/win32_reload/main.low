import std/ui/platform
import win32support

fn once() ! platform.Error {
    using w = platform.open(platform.Options { title: "reload", width: 320, height: 200, activate: false })?
    win32support.ready(w)?
    win32support.show(platform.next(w, 50)?)

    win32support.post(w, win32support.registered("LowHotReload"), 0, 0)
    win32support.show_stable(platform.next(w, 1000)?)
    win32support.show_stable(platform.next(w, 0)?)
}

fn main() {
    win32support.guard(once)
}
