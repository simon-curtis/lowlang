import std/ui/platform
import win32support

extern "user32" {
    fn IsWindow(hwnd: ptr) -> i32
    fn GetWindowTextW(hwnd: ptr, text: ptr[u16], count: i32) -> i32
}

extern "kernel32" {
    fn GetLastError() -> u32
    fn SetLastError(code: u32)
}

const patient_ms = 1500

fn options(title: str) -> platform.Options {
    platform.Options { title, width: 200, height: 100, activate: false }
}

fn title_of(hwnd: ptr) -> str {
    var units: []u16 = []
    for i in 0..64 {
        units.push(0)
    }
    let at: ptr[u16] = pin(units)
    let count = GetWindowTextW(hwnd, at, 64)
    unpin(at)
    var out: []u8 = []
    for i in 0..i64(count) {
        out.push(u8(units[i]))
    }
    str(out)
}

fn woken(events: []platform.Event) -> bool {
    for e in events {
        match e {
            Woken => return true
            _ => {}
        }
    }
    false
}

fn through_closures(display: platform.Display) ! platform.Error {
    using window = platform.open_in(display, options("closure"))?
    let _ = win32support.ready(window)?
    let handle = window.handle
    let rename = fn(title: str) { platform.set_title_on(handle, title) }
    let poll = fn() -> []platform.Event ! platform.Error { platform.next_on(handle, patient_ms)? }
    rename("renamed through a closure")
    print("a closure holding a handle set the title {title_of(platform.native_on(handle).window) == "renamed through a closure"}")
    platform.wake(platform.waker_on(handle))
    let events = poll()?
    print("a closure holding a handle waited and was woken {woken(events)}")
}

fn detached(display: platform.Display) -> platform.WindowHandle ! platform.Error {
    using var window = platform.open_in(display, options("detached"))?
    platform.detach(mut window)
}

fn adopted(handle: platform.WindowHandle) {
    using window = platform.adopt(handle)
}

fn lifecycle(display: platform.Display) ! platform.Error {
    let handle = detached(display)?
    let hwnd = platform.native_on(handle).window
    print("a detached window stays open after its owner is released {IsWindow(hwnd) != 0}")
    platform.close_on(handle)
    print("close_on closed it {IsWindow(hwnd) == 0}")
    SetLastError(0)
    platform.close_on(handle)
    print("a second close_on does nothing {GetLastError() == 0 && IsWindow(hwnd) == 0}")
    print("a closed window has null native handles {platform.native_on(handle).window == null && platform.native_on(handle).display == null}")
    stale(handle)
    let again = detached(display)?
    let second = platform.native_on(again).window
    adopted(again)
    print("an adopted handle closes the window when its owner is released {IsWindow(second) == 0}")
    SetLastError(0)
    platform.close_on(again)
    print("close_on after the release does nothing {GetLastError() == 0}")
    stale_owner(display, handle)
}

fn stale_next(handle: platform.WindowHandle) {
    let events = platform.next_on(handle, 0) catch {
        Unsupported(detail) => {
            print("next_on on a closed window fails with Unsupported: {detail}")
            return
        }
        e => {
            print("next_on on a closed window fails with {e}")
            return
        }
    }
    print("next_on on a closed window returned {events.len} events")
}

fn stale(handle: platform.WindowHandle) {
    stale_next(handle)
    platform.write_clipboard(platform.clipboard_on(handle), "x") catch {
        Unsupported(detail) => {
            print("the clipboard of a closed window fails with Unsupported: {detail}")
        }
        e => {
            print("the clipboard of a closed window fails with {e}")
        }
    }
    platform.set_title_on(handle, "gone")
    platform.show_on(handle)
    platform.set_cursor_on(handle, platform.Cursor.Arrow)
    platform.set_text_input_on(handle, none)
    platform.minimize(platform.controls_on(handle))
    print("the other operations on a closed window do nothing {!platform.is_maximized(platform.controls_on(handle))}")
}

fn stale_owner(display: platform.Display, handle: platform.WindowHandle) {
    using window = platform.open_in(display, platform.Options { title: "orphan", owner: some(handle), activate: false }) catch {
        Unsupported(detail) => {
            print("an owner that has closed fails with Unsupported: {detail}")
            return
        }
        e => {
            print("an owner that has closed fails with {e}")
            return
        }
    }
    print("an owner that has closed opened a window")
}

fn released_by_the_system(display: platform.Display) ! platform.Error {
    using owner = platform.open_in(display, options("owner"))?
    using tool = platform.open_in(display, platform.Options { title: "tool", owner: some(owner.handle), activate: false })?
    let handle = tool.handle
    {
        using moved = owner
    }
    let events = platform.next_on(handle, 0)?
    var closes = 0
    for e in events {
        match e {
            CloseRequested => {
                closes = closes + 1
            }
            _ => {}
        }
    }
    print("next_on returned the close of a window the system destroyed {closes == 1}")
    platform.close_on(handle)
    platform.close_on(handle)
    print("close_on after the system destroyed it does nothing true")
}

fn opened_and_closed() ! platform.Error {
    using window = platform.open(options("own display"))?
    let handle = window.handle
    let hwnd = platform.native_on(handle).window
    platform.close_on(handle)
    print("close_on closed a window made by open {IsWindow(hwnd) == 0}")
    SetLastError(0)
    {
        using moved = window
    }
    print("releasing it afterwards does nothing {GetLastError() == 0}")
    using next = platform.open(options("next"))?
    print("the next open works {platform.native(next).window != null}")
}

fn once() ! platform.Error {
    {
        using display = platform.open_display()?
        through_closures(display)?
        lifecycle(display)?
        released_by_the_system(display)?
    }
    opened_and_closed()?
}

fn main() {
    win32support.guard(once)
    win32support.guard(once)
}
