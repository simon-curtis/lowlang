import std/ui
import std/ui/geometry
import std/ui/gpu
import support

fn solid(w: f32, h: f32, color: u32) -> ui.Element {
    ui.div().size(w, h).background(ui.rgb(color))
}

fn at(x: f32, y: f32) -> geometry.Point {
    geometry.point(x, y)
}

fn scene() -> ui.Element {
    let clipped = ui.deferred(ui.anchored().position(at(30.0, 30.0)).child(solid(40.0, 30.0, 0xff0000)))
    let margin = ui.anchored().position(at(220.0, 150.0)).snap_to_window_with_margin(geometry.edges(8.0)).child(solid(40.0, 20.0, 0xffff00))
    let corner = ui.anchored().position(at(90.0, 150.0)).anchor(ui.Corner.BottomRight).child(solid(30.0, 20.0, 0xff8000))
    let inline = ui.anchored().offset(at(6.0, 4.0)).child(solid(20.0, 10.0, 0x008000))
    ui.div().size(240.0, 160.0).background(ui.rgb(0xffffff)).children() {
        ui.div().absolute().left(10.0).top(10.0).size(40.0, 40.0).overflow_hidden().background(ui.rgb(0x808080)).child(clipped),
        ui.deferred(ui.anchored().position(at(230.0, 20.0)).child(solid(40.0, 20.0, 0x00ff00))),
        ui.deferred(ui.anchored().position(at(20.0, 150.0)).child(solid(30.0, 20.0, 0x0000ff))),
        ui.deferred(margin),
        ui.deferred(ui.anchored().position(at(100.0, 60.0)).child(solid(40.0, 40.0, 0xff00ff))).priority(2),
        ui.deferred(ui.anchored().position(at(120.0, 80.0)).child(solid(40.0, 40.0, 0x00ffff))).priority(1),
        ui.deferred(corner),
        ui.div().absolute().left(170.0).top(60.0).size(50.0, 30.0).background(ui.rgb(0x404040)).child(inline),
    }
}

fn render() ! gpu.Error {
    using g = gpu.open()?
    using t = gpu.target(g, 240, 160)?
    let cx = ui.headless(ui.rgb(0xffffff))
    let frame = ui.frame(cx, scene, geometry.size(240.0, 160.0), 1.0)
    ui.draw(cx, g, t, frame)?
    support.snapshot(g, t, "overlays")?
}

fn main() ! gpu.Error {
    support.guard(render)?
}
