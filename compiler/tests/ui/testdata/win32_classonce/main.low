import std/ui/platform
import win32support

extern "user32" {
    fn GetClassInfoExW(instance: ptr, name: ptr, mut class: ClassInfo) -> i32
}

extern "kernel32" {
    fn GetModuleHandleW(name: ptr) -> ptr
}

extern struct ClassInfo {
    size: u32 = 80
    style: u32 = 0
    procedure: ptr = null
    class_extra: i32 = 0
    window_extra: i32 = 0
    instance: ptr = null
    icon: ptr = null
    cursor: ptr = null
    background: ptr = null
    menu: ptr = null
    class_name: ptr = null
    small_icon: ptr = null
}

fn wide(s: str) -> []u8 {
    var out: []u8 = []
    for b in bytes(s) {
        out.push(b)
        out.push(0)
    }
    out.push(0)
    out.push(0)
    out
}

fn registered(name: str) -> bool {
    let text = wide(name)
    let at: ptr[u8] = pin(text)
    var info = ClassInfo {}
    let found = GetClassInfoExW(GetModuleHandleW(null), at, mut info) != 0
    unpin(at)
    found
}

fn classes(when: str) {
    let window_class = registered("LowWindow")
    let waker_class = registered("LowDisplay")
    print("{when}: window class {window_class} waker class {waker_class}")
}

fn options(title: str) -> platform.Options {
    platform.Options { title, width: 200, height: 100 }
}

fn first_closes_first(display: platform.Display) ! platform.Error {
    using first = platform.open_in(display, options("first"))?
    using second = platform.open_in(display, options("second"))?
    win32support.ready(first)?
    win32support.ready(second)?
    classes("two windows open")
    {
        using moved = first
    }
    classes("the first window closed")
}

fn second_closes_first(display: platform.Display) ! platform.Error {
    using first = platform.open_in(display, options("first"))?
    {
        using second = platform.open_in(display, options("second"))?
        win32support.ready(first)?
        win32support.ready(second)?
        classes("two windows open")
    }
    classes("the second window closed")
}

fn two_displays() ! platform.Error {
    using first = platform.open_display()?
    {
        using second = platform.open_display()?
        classes("two displays open")
    }
    classes("the second display closed")
    using window = platform.open_in(first, options("kept"))?
    win32support.ready(window)?
    classes("a window opened in the first display")
}

fn held_display() ! platform.Error {
    using held = platform.open_display()?
    {
        using alone = platform.open(options("alone"))?
        win32support.ready(alone)?
    }
    classes("a window opened by open closed")
    using window = platform.open_in(held, options("kept"))?
    win32support.ready(window)?
    classes("a window opened in the held display")
}

fn once() ! platform.Error {
    classes("before any display")
    {
        using display = platform.open_display()?
        classes("display open")
        first_closes_first(display)?
        classes("both windows closed")
        second_closes_first(display)?
        classes("both windows closed")
        using again = platform.open_in(display, options("again"))?
        win32support.ready(again)?
        classes("a window opened again")
    }
    classes("display closed")
    {
        using alone = platform.open(options("alone"))?
        win32support.ready(alone)?
        classes("a window opened by open")
    }
    classes("that window closed")
    two_displays()?
    classes("the first display closed")
    held_display()?
    classes("the held display closed")
}

fn main() {
    win32support.guard(once)
    win32support.guard(once)
}
