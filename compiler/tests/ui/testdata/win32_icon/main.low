import std/image
import std/ui/platform
import win32support

const wm_geticon: u32 = 0x7F
const icon_small: i64 = 0
const icon_big: i64 = 1
const sm_cxicon: i32 = 11
const sm_cxsmicon: i32 = 49

extern "user32" {
    fn GetIconInfo(icon: ptr, mut info: IconInfo) -> i32
    fn SendMessageW(hwnd: ptr, message: u32, wparam: i64, lparam: i64) -> i64
    fn GetDpiForWindow(hwnd: ptr) -> u32
    fn GetSystemMetricsForDpi(index: i32, dpi: u32) -> i32
}

extern "gdi32" {
    fn GetObjectW(handle: ptr, size: i32, mut object: Bitmap) -> i32
    fn DeleteObject(handle: ptr) -> i32
}

extern struct IconInfo {
    is_icon: i32 = 0
    hotspot_x: u32 = 0
    hotspot_y: u32 = 0
    mask: ptr = null
    color: ptr = null
}

extern struct Bitmap {
    kind: i32 = 0
    width: i32 = 0
    height: i32 = 0
    row_bytes: i32 = 0
    planes: u16 = 0
    bits_per_pixel: u16 = 0
    bits: ptr = null
}

fn frame_of(size: i64) -> platform.IconFrame {
    let picture = image.create(size, size, image.Format.Rgba8)
    platform.IconFrame { size, png: str(image.encode_png(picture)) }
}

fn frames_of(sizes: i64[]) -> platform.IconFrame[] {
    var frames: platform.IconFrame[] = []
    for size in sizes {
        frames.push(frame_of(size))
    }
    frames
}

fn icon_of(w: platform.Window, which: i64) -> ptr {
    ptr(SendMessageW(platform.native(w).window, wm_geticon, which, 0))
}

fn icon_width(icon: ptr) -> i64 {
    var info = IconInfo {}
    if GetIconInfo(icon, mut info) == 0 {
        return -1
    }
    var bitmap = Bitmap {}
    var width: i64 = -1
    if GetObjectW(info.color, 32, mut bitmap) != 0 {
        width = i64(bitmap.width)
    }
    let _ = DeleteObject(info.color)
    let _ = DeleteObject(info.mask)
    width
}

fn is_live(icon: ptr) -> bool {
    icon_width(icon) > 0
}

fn covering(sizes: i64[], wanted: i64) -> i64 {
    var best: i64 = -1
    var largest: i64 = 0
    for size in sizes {
        if size > largest {
            largest = size
        }
        if size >= wanted && (best < 0 || size < best) {
            best = size
        }
    }
    if best < 0 {
        return largest
    }
    best
}

fn metric(w: platform.Window, index: i32) -> i64 {
    i64(GetSystemMetricsForDpi(index, GetDpiForWindow(platform.native(w).window)))
}

fn options(title: str, icon: platform.IconFrame[]?) -> platform.Options {
    platform.Options { title, width: 320, height: 200, activate: false, icon }
}

fn report_sizes(w: platform.Window, name: str, sizes: i64[]) {
    let big = icon_of(w, icon_big)
    let small = icon_of(w, icon_small)
    print("{name} has a big icon {big != null}")
    print("{name} has a small icon {small != null}")
    print("{name} big icon covers the system's large size {icon_width(big) == covering(sizes, metric(w, sm_cxicon))}")
    print("{name} small icon covers the system's small size {icon_width(small) == covering(sizes, metric(w, sm_cxsmicon))}")
}

fn reports_bad(call: str, w: platform.Window, frames: platform.IconFrame[]) {
    var failed = false
    platform.set_icon(w, frames) catch {
        BadIcon(detail) => {
            failed = true
        }
        e => print("{call} failed with {e}")
    }
    print("{call} is reported as BadIcon {failed}")
}

fn drawn() ! platform.Error {
    let sizes: i64[] = [16, 24, 32, 48, 64, 256]
    using w = platform.open(options("iconed", some(frames_of(sizes))))?
    report_sizes(w, "an opened window", sizes)

    let first_big = icon_of(w, icon_big)
    let first_small = icon_of(w, icon_small)
    let replacement: i64[] = [64]
    platform.set_icon(w, frames_of(replacement))?
    report_sizes(w, "a replaced icon", replacement)
    print("the replaced big icon is another handle {icon_of(w, icon_big) != first_big}")
    print("the previous big icon was destroyed {!is_live(first_big)}")
    print("the previous small icon was destroyed {!is_live(first_small)}")

    let kept_big = icon_of(w, icon_big)
    let kept_small = icon_of(w, icon_small)
    reports_bad("bytes that are not a PNG", w, [platform.IconFrame { size: 32, png: "this is not a picture, but it is long enough for a header" }])
    reports_bad("a PNG of another size", w, [platform.IconFrame { size: 32, png: frame_of(16).png }])
    let whole = frame_of(32).png
    reports_bad("a PNG cut after its header", w, [platform.IconFrame { size: 32, png: whole[0..40] }])
    reports_bad("a good frame after a bad one", w, [frame_of(32), platform.IconFrame { size: 16, png: "" }])
    print("a refused icon keeps the big icon {icon_of(w, icon_big) == kept_big && is_live(kept_big)}")
    print("a refused icon keeps the small icon {icon_of(w, icon_small) == kept_small && is_live(kept_small)}")

    platform.set_icon(w, [])?
    print("no frames remove the big icon {icon_of(w, icon_big) == null}")
    print("no frames remove the small icon {icon_of(w, icon_small) == null}")
    print("no frames destroyed the big icon {!is_live(kept_big)}")

    platform.set_icon(w, frames_of(replacement))?
    let last = icon_of(w, icon_big)
    print("an icon is set again after none {last != null && is_live(last)}")
    platform.close_on(w.handle)
    print("a closed window destroyed its icon {!is_live(last)}")
}

fn none_and_bad() ! platform.Error {
    using plain = platform.open(options("plain", none))?
    print("a window opened with no icon has no big icon {icon_of(plain, icon_big) == null}")
    print("a window opened with no icon has no small icon {icon_of(plain, icon_small) == null}")

    var bad: platform.IconFrame[] = []
    bad.push(platform.IconFrame { size: 32, png: "this is not a picture, but it is long enough for a header" })
    using broken = platform.open(options("broken", some(bad)))?
    print("a window opened with a bad icon opens without one {icon_of(broken, icon_big) == null}")
    platform.set_icon(broken, frames_of([32]))?
    print("a bad icon at open does not stop set_icon {icon_of(broken, icon_big) != null}")
}

fn main() {
    win32support.guard(drawn)
    win32support.guard(none_and_bad)
}
