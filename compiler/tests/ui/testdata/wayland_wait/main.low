import std/time
import std/ui/platform

const patient_ms = 5000
const prompt_ms = 1500
const timeout_ms = 200
const tick_ms = 16
const delay_ms = 100

fn since(started: i64) -> i64 {
    (time.monotonic() - started) / 1000000
}

fn options(title: str) -> platform.Options {
    platform.Options { title, width: 200, height: 100 }
}

fn maximized(events: platform.Event[]) -> bool {
    for e in events {
        match e {
            Maximized(on) => {
                return on
            }
            _ => {}
        }
    }
    false
}

fn settle(display: platform.Display, first: platform.Window, second: platform.Window) ! platform.Error {
    for attempt in 0..20 {
        let started = time.monotonic()
        platform.wait(display, timeout_ms)?
        let took = since(started)
        platform.next(first, 0)?
        platform.next(second, 0)?
        if took >= timeout_ms - tick_ms {
            print("nothing pending runs to the timeout {took < prompt_ms}")
            return
        }
    }
    print("busy")
}

fn maximise_ends_wait(display: platform.Display, w: platform.Window, label: str) ! platform.Error {
    platform.toggle_maximize(platform.controls(w))
    var seen = false
    let started = time.monotonic()
    for !seen && since(started) < patient_ms {
        platform.wait(display, patient_ms)?
        seen = maximized(platform.next(w, 0)?)
    }
    print("maximising the {label} window ended wait {seen && since(started) < prompt_ms}")
    platform.toggle_maximize(platform.controls(w))
}

fn wake_after(k: platform.Waker, ms: i64) {
    sleep(ms)
    platform.wake(k)
}

fn woken_by_thread(display: platform.Display, k: platform.Waker) ! platform.Error {
    spawn wake_after(k, delay_ms)
    let started = time.monotonic()
    platform.wait(display, patient_ms)?
    let took = since(started)
    print("a wake from another green thread ended wait {took >= delay_ms - tick_ms && took < prompt_ms}")
}

fn run() ! platform.Error {
    using display = platform.open_display()?
    let k = platform.waker_of(display)
    {
        using first = platform.open_in(display, options("low wayland wait first"))?
        using second = platform.open_in(display, options("low wayland wait second"))?
        settle(display, first, second)?
        maximise_ends_wait(display, second, "second")?
        settle(display, first, second)?
        maximise_ends_wait(display, first, "first")?
        settle(display, first, second)?
        woken_by_thread(display, k)?
    }
    platform.wake(k)
    let started = time.monotonic()
    platform.wait(display, patient_ms)?
    print("a wake with no window open ended wait {since(started) < prompt_ms}")
}

fn main() ! platform.Error {
    run() catch {
        NoDisplay(detail) => {
            print("no display")
        }
        e => fail e
    }
}
