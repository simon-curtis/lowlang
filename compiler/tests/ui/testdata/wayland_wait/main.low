import std/time
import std/ui/platform

const patient_ms = 5000
const prompt_ms = 1500
const timeout_ms = 200
const quiet_ms = 300
const tick_ms = 16
const delay_ms = 100

fn since(started: i64) -> i64 {
    (time.monotonic() - started) / 1000000
}

fn options(title: str) -> platform.Options {
    platform.Options { title, width: 200, height: 100 }
}

fn woken(events: platform.Event[]) -> i64 {
    var count = 0
    for e in events {
        match e {
            Woken => {
                count += 1
            }
            _ => {}
        }
    }
    count
}

fn maximized(events: platform.Event[]) -> bool {
    for e in events {
        match e {
            Maximized(on) => {
                return on
            }
            _ => {}
        }
    }
    false
}

fn settle(display: platform.Display, first: platform.Window, second: platform.Window) ! platform.Error {
    for attempt in 0..20 {
        platform.wait(display, quiet_ms)?
        let a = platform.next(first, 0)?
        let b = platform.next(second, 0)?
        if a.len == 0 && b.len == 0 {
            return
        }
    }
    print("the windows never settled")
}

fn waited(display: platform.Display, label: str) ! platform.Error {
    let started = time.monotonic()
    platform.wait(display, patient_ms)?
    print("{label} ended wait {since(started) < prompt_ms}")
}

fn idle(display: platform.Display, label: str) ! platform.Error {
    let started = time.monotonic()
    platform.wait(display, timeout_ms)?
    let took = since(started)
    print("{label} runs to the timeout {took >= timeout_ms - tick_ms && took < prompt_ms}")
}

fn maximise_ends_wait(display: platform.Display, w: platform.Window, label: str) ! platform.Error {
    platform.toggle_maximize(platform.controls(w))
    var seen = false
    let started = time.monotonic()
    for !seen && since(started) < patient_ms {
        platform.wait(display, patient_ms)?
        seen = maximized(platform.next(w, 0)?)
    }
    print("maximising the {label} window ended wait {seen && since(started) < prompt_ms}")
    platform.toggle_maximize(platform.controls(w))
}

fn wake_after(k: platform.Waker, ms: i64) {
    sleep(ms)
    platform.wake(k)
}

fn woken_by_thread(display: platform.Display, k: platform.Waker) ! platform.Error {
    spawn wake_after(k, delay_ms)
    let started = time.monotonic()
    platform.wait(display, patient_ms)?
    let took = since(started)
    print("a wake from another green thread ended wait {took >= delay_ms - tick_ms && took < prompt_ms}")
}

fn woken_window(display: platform.Display, first: platform.Window, second: platform.Window) ! platform.Error {
    platform.wake(platform.waker(second))
    waited(display, "a wake of the second window")?
    print("woken first {woken(platform.next(first, 0)?)} second {woken(platform.next(second, 0)?)}")
}

fn next_keeps_waiting(first: platform.Window, second: platform.Window) ! platform.Error {
    spawn wake_after(platform.waker(second), delay_ms)
    let started = time.monotonic()
    let events = platform.next(first, timeout_ms + delay_ms)?
    let took = since(started)
    print("next on the first runs through a wake of the second {events.len == 0 && took >= timeout_ms + delay_ms - tick_ms}")
    print("the second keeps its wake {woken(platform.next(second, 0)?)}")
}

fn once() ! platform.Error {
    using display = platform.open_display()?
    using first = platform.open_in(display, options("first"))?
    using second = platform.open_in(display, options("second"))?
    settle(display, first, second)?

    idle(display, "nothing pending")?
    maximise_ends_wait(display, second, "second")?
    settle(display, first, second)?
    maximise_ends_wait(display, first, "first")?
    settle(display, first, second)?

    let k = platform.waker_of(display)
    platform.wake(k)
    platform.wake(k)
    waited(display, "two wakes")?
    idle(display, "a wake already taken")?
    print("a display wake gives windows {woken(platform.next(first, 0)?) + woken(platform.next(second, 0)?)} wakes")

    woken_by_thread(display, k)?
    woken_window(display, first, second)?
    next_keeps_waiting(first, second)?

    {
        using moved = first
    }
    platform.wake(k)
    waited(display, "a wake after the first window closed")?

    {
        using moved = second
    }
    platform.wake(k)
    waited(display, "a wake with no window open")?
}

fn refused(call: fn() ! platform.Error) -> bool {
    call() catch {
        Unsupported(detail) => return true
        e => return false
    }
    false
}

fn outlived() ! platform.Error {
    var window: platform.WindowHandle? = none
    var view: platform.DisplayHandle? = none
    {
        using display = platform.open_display()?
        using var w = platform.open_in(display, options("outlived"))?
        window = platform.detach(mut w)
        view = display.handle
    }
    let h = window ?? return
    let d = view ?? return
    print("next on a window whose display was released fails {refused(fn() ! platform.Error { platform.next_on(h, 0)? })}")
    print("wait on a released display fails {refused(fn() ! platform.Error { platform.wait_on(d, 0)? })}")
    print("open in a released display fails {refused(fn() ! platform.Error { platform.open_in_on(d, options("late"))? })}")
    platform.wake(platform.waker_of_on(d))
    platform.close_on(h)
    print("a wake and a close after release do nothing")
}

fn run() ! platform.Error {
    once()?
    once()?
    outlived()?
}

fn main() ! platform.Error {
    run() catch {
        NoDisplay(detail) => {
            print("no display")
        }
        e => fail e
    }
}
