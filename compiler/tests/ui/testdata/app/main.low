import std/os
import std/ui
import std/ui/platform

const paper: u32 = 0xf4f4f5
const ink: u32 = 0x18181b
const white: u32 = 0xffffff
const accent: u32 = 0x2563eb
const accent_hover: u32 = 0x1d4ed8
const accent_pressed: u32 = 0x1e40af
const outline: u32 = 0xa1a1aa

fn named_label(n: platform.NamedKey) -> str {
    match n {
        Enter => "Enter"
        Escape => "Escape"
        Backspace => "Backspace"
        Delete => "Delete"
        Left => "Left"
        Right => "Right"
        Up => "Up"
        Down => "Down"
        _ => "a named key"
    }
}

fn key_label(k: platform.KeyEvent) -> str {
    match k.key {
        Character(text) => text
        Named(n) => named_label(n)
    }
}

fn leaves_focus(k: platform.KeyEvent) -> bool {
    match k.key {
        Named(n) => n == platform.NamedKey.Tab
        Character(_) => false
    }
}

fn heading(s: str) -> ui.Element {
    ui.text(s).text_size(28.0).text_color(ui.rgb(ink))
}

fn label(s: str) -> ui.Element {
    ui.text(s).text_color(ui.rgb(ink))
}

fn button(caption: str, pressed: fn(ui.ClickEvent)) -> ui.Element {
    ui.div()
        .id("button")
        .padding_xy(16.0, 10.0)
        .rounded(6.0)
        .background(ui.rgb(accent))
        .border(2.0, ui.rgb(paper))
        .cursor(platform.Cursor.Pointer)
        .hover(fn(v: ui.Visual) -> ui.Visual { v.with_background(ui.rgb(accent_hover)) })
        .active(fn(v: ui.Visual) -> ui.Visual { v.with_background(ui.rgb(accent_pressed)) })
        .focus(fn(v: ui.Visual) -> ui.Visual { v.with_border_color(ui.rgb(ink)) })
        .focusable()
        .on_click(pressed)
        .child(ui.text(caption).text_color(ui.rgb(white)))
}

fn key_panel(last: ui.Signal[str]) -> ui.Element {
    let took = fn(k: platform.KeyEvent) -> bool {
        if !k.pressed || leaves_focus(k) {
            return false
        }
        ui.set(last, key_label(k))
        true
    }
    ui.div()
        .id("keys")
        .focusable()
        .padding(12.0)
        .rounded(6.0)
        .border(2.0, ui.rgb(outline))
        .focus(fn(v: ui.Visual) -> ui.Visual { v.with_border_color(ui.rgb(accent)) })
        .on_key(took)
        .child(label("Last key pressed here: {ui.get(last)}"))
}

fn name_field(name: ui.Signal[str]) -> ui.Element {
    ui.field(ui.get(name))
        .id("name")
        .width(320.0)
        .padding(8.0)
        .rounded(6.0)
        .background(ui.rgb(white))
        .text_color(ui.rgb(ink))
        .border(2.0, ui.rgb(outline))
        .focus(fn(v: ui.Visual) -> ui.Visual { v.with_border_color(ui.rgb(accent)) })
        .on_change(fn(s: str) { ui.set(name, s) })
}

fn screen(clicks: ui.Signal[i64], last: ui.Signal[str], name: ui.Signal[str]) -> ui.Element {
    let more = fn(c: ui.ClickEvent) { ui.update(clicks, fn(n: i64) -> i64 { n + 1 }) }
    ui.div().column().padding(24.0).gap(16.0).children() {
        heading("Low UI"),
        label("Clicked {ui.get(clicks)} times"),
        ui.div().row().child(button("Click me", more)),
        key_panel(last),
        name_field(name),
        label("Hello, {ui.get(name)}"),
    }
}

fn smoke_requested() -> bool {
    let args = os.args()
    args.len > 1 && args[1] == "--smoke"
}

fn type_text(cx: ui.Context, s: str) {
    ui.dispatch(cx, platform.Event.Key(platform.KeyEvent { key: platform.Key.Character(s), text: s }))
}

fn drive(cx: ui.Context) {
    ui.set_focus(cx, "button")
    ui.dispatch(cx, platform.Event.Key(platform.KeyEvent { key: platform.Key.Named(platform.NamedKey.Enter) }))
    ui.set_focus(cx, "name")
    type_text(cx, "h")
    type_text(cx, "i")
    ui.quit(cx)
}

fn drive_after(h: ui.Handle, cx: ui.Context, ms: i64) {
    sleep(ms)
    ui.post(h, fn() { drive(cx) })
}

fn run_app() ! ui.Error {
    using app = ui.open(ui.Options { title: "Low UI", width: 480, height: 360, background: ui.rgb(paper), activate: false })?
    let clicks = ui.signal(app.cx, 0)
    let last = ui.signal(app.cx, "none yet")
    let name = ui.signal(app.cx, "")
    let smoke = smoke_requested()
    if smoke {
        spawn drive_after(ui.handle(app.cx), app.cx, 500)
    }
    ui.run(app, fn() -> ui.Element { screen(clicks, last, name) })?
    if smoke {
        print("clicks {ui.get(clicks)}")
        print("name {ui.get(name)}")
    }
}

fn main() ! ui.Error {
    run_app() catch {
        Platform(error) => {
            match error {
                NoDisplay(detail) => {
                    print("no display")
                    return
                }
                e => fail ui.Error.Platform(e)
            }
        }
        Gpu(error) => {
            match error {
                NoDevice => {
                    print("no device")
                    return
                }
                e => fail ui.Error.Gpu(e)
            }
        }
    }
}
