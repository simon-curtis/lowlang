import std/ui/gpu
import std/ui/scene
import std/ui/geometry
import support

fn stripes() -> []u8 {
    [
        255, 0, 0, 0, 255, 0, 0, 0, 255, 255, 255, 255, 128, 0, 64,
        255, 0, 0, 0, 255, 0, 0, 0, 255, 255, 255, 255, 128, 0, 64
    ]
}

fn pushed(atlas: scene.Atlas, color: geometry.Color, text: scene.TextParams) -> scene.Scene {
    let tile = scene.tile(atlas, 100, 40, 5, 2)
    var s = scene.empty(32, 32, geometry.rgb(0x404040))
    s.text = text
    scene.push_subpixel_sprite(mut s, scene.SubpixelSprite { bounds: geometry.rect(4.0, 4.0, 5.0, 2.0), color, tile })
    s
}

fn render() ! gpu.Error {
    using g = gpu.open()?
    using t = gpu.target(g, 32, 32)?
    var atlas = scene.atlas(1024)
    scene.write_stripes(mut atlas, 100, 40, 5, 2, stripes())

    let plain = pushed(atlas, geometry.rgb(0xffffff), scene.TextParams {})
    gpu.render(g, t, plain, mut atlas)?
    support.snapshot(g, t, "white")?

    let red = pushed(atlas, geometry.rgb(0xff0000), scene.TextParams {})
    gpu.render(g, t, red, mut atlas)?
    support.snapshot(g, t, "red")?

    let reversed = pushed(atlas, geometry.rgb(0xffffff), scene.TextParams { bgr: 1 })
    gpu.render(g, t, reversed, mut atlas)?
    support.snapshot(g, t, "bgr")?

    let corrected = scene.TextParams {
        gamma_0: 0.14805442
        gamma_1: -0.89459455
        gamma_2: 1.475908
        gamma_3: -0.32466826
        grayscale_contrast: 1.0
        subpixel_contrast: 0.5
    }
    let grey = pushed(atlas, geometry.rgb(0x808080), corrected)
    gpu.render(g, t, grey, mut atlas)?
    support.snapshot(g, t, "corrected")?
}

fn main() ! gpu.Error {
    support.guard(render)?
}
