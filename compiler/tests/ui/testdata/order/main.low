import std/ui/gpu
import std/ui/scene
import std/ui/geometry
import support

fn render() ! gpu.Error {
    using g = gpu.open()?
    using t = gpu.target(g, 64, 64)?
    var atlas = scene.atlas(1024)
    var solid: []u8 = []
    for i in 0..64 {
        solid.push(255)
    }
    scene.write(mut atlas, 0, 0, 8, 8, solid)
    let tile = scene.tile(atlas, 0, 0, 8, 8)

    var s = scene.empty(64, 64, geometry.rgb(0x000000))
    scene.push_sprite(mut s, scene.Sprite { bounds: geometry.rect(4.0, 4.0, 8.0, 8.0), color: geometry.rgb(0x00ff00), tile })
    scene.push_quad(mut s, scene.Quad { bounds: geometry.rect(0.0, 0.0, 16.0, 16.0), background: geometry.rgb(0xff0000) })

    scene.push_quad(mut s, scene.Quad { bounds: geometry.rect(24.0, 4.0, 16.0, 16.0), background: geometry.rgb(0x0000ff) })
    scene.push_sprite(mut s, scene.Sprite { bounds: geometry.rect(28.0, 8.0, 8.0, 8.0), color: geometry.rgb(0x00ff00), tile })

    scene.push_quad(mut s, scene.Quad { bounds: geometry.rect(4.0, 30.0, 24.0, 24.0), background: geometry.rgb(0xffffff) })
    scene.push_shadow(mut s, scene.Shadow { bounds: geometry.rect(10.0, 36.0, 12.0, 12.0), color: geometry.rgb(0x000000), sigma: 2.0 })
    scene.push_quad(mut s, scene.Quad { bounds: geometry.rect(14.0, 40.0, 4.0, 4.0), background: geometry.rgb(0x00ff00) })
    gpu.render(g, t, s, mut atlas)?
    support.snapshot(g, t, "order")?
    print("batches {scene.batches(s).len}")
}

fn main() ! gpu.Error {
    support.guard(render)?
}
