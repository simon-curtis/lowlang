import std/ui/gpu
import std/ui/scene
import std/ui/geometry
import support

const white: u32 = 0xffffff

fn sprite(x: f32, y: f32, color: u32, tile: geometry.Rect) -> scene.Sprite {
    scene.Sprite { bounds: geometry.rect(x, y, 4.0, 1.0), color: geometry.rgb(color), tile }
}

fn ramps(atlases: []scene.Atlas) -> geometry.Rect {
    scene.tile(atlases[0], 0, 0, 4, 1)
}

fn paired(atlases: []scene.Atlas, first: i64, second: i64) -> scene.Scene {
    var s = scene.empty(64, 32, geometry.rgb(0x000000))
    let tile = ramps(atlases)
    scene.push_sprite_from(mut s, sprite(2.0, 2.0, white, tile), first)
    scene.push_sprite_from(mut s, sprite(10.0, 2.0, white, tile), second)
    scene.push_sprite_from(mut s, sprite(18.0, 2.0, white, tile), first)
    scene.push_sprite_from(mut s, sprite(26.0, 2.0, white, tile), second)
    s
}

fn layered(atlases: []scene.Atlas, bottom: i64, middle: i64) -> scene.Scene {
    var s = scene.empty(64, 32, geometry.rgb(0x000000))
    let tile = ramps(atlases)
    scene.push_sprite_from(mut s, sprite(2.0, 6.0, 0xff0000, tile), bottom)
    scene.push_sprite_from(mut s, sprite(2.0, 6.0, 0x00ff00, tile), middle)
    scene.push_sprite_from(mut s, sprite(2.0, 6.0, 0x0000ff, tile), bottom)
    s
}

fn dots(atlases: []scene.Atlas, count: i64) -> scene.Scene {
    var s = scene.empty(64, 32, geometry.rgb(0x000000))
    let lit = scene.tile(atlases[1], 8, 0, 1, 1)
    for i in 0..count {
        scene.push_sprite_from(mut s, scene.Sprite { bounds: geometry.rect(f32(i % 60), f32(8 + i / 60 * 2), 1.0, 1.0), color: geometry.rgb(white), tile: lit }, 1)
    }
    scene.push_sprite_from(mut s, sprite(2.0, 2.0, white, ramps(atlases)), 0)
    s
}

fn three(atlases: []scene.Atlas) -> scene.Scene {
    var s = scene.empty(64, 32, geometry.rgb(0x000000))
    scene.push_sprite_from(mut s, sprite(2.0, 2.0, white, ramps(atlases)), 0)
    scene.push_sprite_from(mut s, sprite(10.0, 2.0, white, ramps(atlases)), 1)
    scene.push_sprite_from(mut s, sprite(18.0, 2.0, white, scene.tile(atlases[2], 100, 100, 4, 1)), 2)
    s
}

fn many(atlases: []scene.Atlas) -> scene.Scene {
    var s = scene.empty(64, 32, geometry.rgb(0x000000))
    for i in 0..atlases.len {
        scene.push_sprite_from(mut s, scene.Sprite { bounds: geometry.rect(f32(i * 4), 20.0, 1.0, 1.0), color: geometry.rgb(white), tile: scene.tile(atlases[i], 0, 0, 1, 1) }, i)
    }
    s
}

fn kinds(atlases: []scene.Atlas) -> scene.Scene {
    var s = scene.empty(64, 32, geometry.rgb(0x000000))
    for i in 0..6 {
        let x = f32(2 + i * 4)
        let side = i % 2
        let stripes = scene.SubpixelSprite { bounds: geometry.rect(x, 12.0, 1.0, 1.0), color: geometry.rgb(white), tile: scene.tile(atlases[side], 16 + side, 0, 1, 1) }
        scene.push_subpixel_sprite_from(mut s, stripes, side)
        let colour = scene.PolychromeSprite { bounds: geometry.rect(x, 16.0, 1.0, 1.0), tile: scene.tile(atlases[side], 20 + side, 0, 1, 1) }
        scene.push_polychrome_sprite_from(mut s, colour, side)
    }
    s
}

fn quads_only() -> scene.Scene {
    var s = scene.empty(64, 32, geometry.rgb(0x000000))
    scene.push_quad(mut s, scene.Quad { bounds: geometry.rect(4.0, 4.0, 8.0, 8.0), background: geometry.rgb(0x00ff00) })
    s
}

fn render() ! gpu.Error {
    using g = gpu.open()?
    using t = gpu.target(g, 64, 32)?
    var atlases = [scene.atlas(64), scene.atlas(64)]
    let first: []u8 = [255, 200, 100, 50]
    let second: []u8 = [40, 80, 160, 240]
    scene.write(mut atlases[0], 0, 0, 4, 1, first)
    scene.write(mut atlases[1], 0, 0, 4, 1, second)
    let lit: []u8 = [255]
    scene.write(mut atlases[1], 8, 0, 1, 1, lit)

    gpu.render(g, t, paired(atlases, 0, 1), mut atlases)?
    support.snapshot(g, t, "paired")?
    gpu.render(g, t, paired(atlases, 1, 0), mut atlases)?
    support.snapshot(g, t, "swapped")?

    var ends: []u8 = [255, 0, 255, 0]
    scene.write(mut atlases[0], 0, 0, 4, 1, ends)
    ends = [0, 255, 255, 0]
    scene.write(mut atlases[1], 0, 0, 4, 1, ends)
    gpu.render(g, t, layered(atlases, 0, 1), mut atlases)?
    support.snapshot(g, t, "layered")?
    gpu.render(g, t, layered(atlases, 1, 0), mut atlases)?
    support.snapshot(g, t, "layered_swapped")?

    gpu.render(g, t, dots(atlases, 300), mut atlases)?
    support.snapshot(g, t, "dots")?

    atlases.push(scene.atlas(128))
    let far: []u8 = [20, 120, 220, 255]
    scene.write(mut atlases[2], 100, 100, 4, 1, far)
    gpu.render(g, t, three(atlases), mut atlases)?
    support.snapshot(g, t, "three")?

    let rewritten: []u8 = [255, 255, 255, 255]
    scene.write(mut atlases[1], 0, 0, 4, 1, rewritten)
    gpu.render(g, t, three(atlases), mut atlases)?
    support.snapshot(g, t, "rewritten")?

    var one = [atlases[0]]
    gpu.render(g, t, quads_only(), mut one)?
    var none: []scene.Atlas = []
    gpu.render(g, t, quads_only(), mut none)?
    support.snapshot(g, t, "quads_only")?

    var again = [atlases[0], scene.atlas(64), scene.atlas(128)]
    scene.write(mut again[0], 0, 0, 4, 1, first)
    scene.write(mut again[1], 0, 0, 4, 1, second)
    scene.write(mut again[2], 100, 100, 4, 1, [200, 150, 100, 50])
    gpu.render(g, t, three(again), mut again)?
    support.snapshot(g, t, "regrown")?

    let red_stripes: []u8 = [255, 0, 0]
    let blue_stripes: []u8 = [0, 0, 255]
    scene.write_stripes(mut again[0], 16, 0, 1, 1, red_stripes)
    scene.write_stripes(mut again[1], 17, 0, 1, 1, blue_stripes)
    let green: []u8 = [0, 255, 0, 255]
    let yellow: []u8 = [255, 255, 0, 255]
    scene.write_colors(mut again[0], 20, 0, 1, 1, green)
    scene.write_colors(mut again[1], 21, 0, 1, 1, yellow)
    gpu.render(g, t, kinds(again), mut again)?
    support.snapshot(g, t, "kinds")?

    var crowd: []scene.Atlas = []
    for i in 0..12 {
        crowd.push(scene.atlas(8))
        let level: []u8 = [u8(i * 20 + 10)]
        scene.write(mut crowd[i], 0, 0, 1, 1, level)
    }
    gpu.render(g, t, many(crowd), mut crowd)?
    support.snapshot(g, t, "many")?

    gpu.render(g, t, paired(again, 0, 3), mut again) catch {
        InvalidTexture(texture, count) => print("invalid {texture} of {count}")
        e => fail e
    }
    gpu.render(g, t, paired(again, 0, 1), mut none) catch {
        InvalidTexture(texture, count) => print("invalid {texture} of {count}")
        e => fail e
    }
    gpu.render(g, t, paired(again, 0, -1), mut again) catch {
        InvalidTexture(texture, count) => print("invalid {texture} of {count}")
        e => fail e
    }
}

fn main() ! gpu.Error {
    support.guard(render)?
}
