import std/ui/gpu
import std/ui/scene
import std/ui/geometry
import support

fn render() ! gpu.Error {
    using g = gpu.open()?
    using t = gpu.target(g, 96, 64)?
    var atlas = scene.atlas(1024)

    var s = scene.empty(96, 64, geometry.rgb(0xffffff))
    scene.push_shadow(mut s, scene.Shadow {
        bounds: geometry.rect(32.0, 16.0, 32.0, 32.0)
        color: geometry.rgb(0x000000)
        sigma: 4.0
    })
    gpu.render(g, t, s, mut atlas)?
    support.snapshot(g, t, "shadow")?

    var rounded = scene.empty(96, 64, geometry.rgb(0xffffff))
    scene.push_shadow(mut rounded, scene.Shadow {
        bounds: geometry.rect(32.0, 16.0, 32.0, 32.0)
        color: geometry.rgb(0x000000)
        corner_radii: geometry.corners(16.0)
        sigma: 2.0
    })
    gpu.render(g, t, rounded, mut atlas)?
    support.snapshot(g, t, "rounded")?
}

fn main() ! gpu.Error {
    support.guard(render)?
}
