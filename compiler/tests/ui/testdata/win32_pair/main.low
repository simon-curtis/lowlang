import std/ui/platform
import win32support

fn once() ! platform.Error {
    using first = platform.open(platform.Options { title: "first", width: 200, height: 100 })?
    win32support.ready(first)?
    {
        using second = platform.open(platform.Options { title: "second", width: 300, height: 150 })?
        win32support.ready(second)?
        print("same window {platform.native(first).window == platform.native(second).window}")

        win32support.post(first, 0x10, 0, 0)
        win32support.post(second, 0x20A, 120 << 16, 0)
        win32support.show_stable(platform.next(second, 1000)?)
        win32support.show_stable(platform.next(first, 1000)?)
        win32support.show_stable(platform.next(first, 0)?)
    }
    win32support.post(first, 0x10, 0, 0)
    win32support.show_stable(platform.next(first, 1000)?)
}

fn main() {
    win32support.guard(once)
    win32support.guard(once)
}
