import std/ui
import std/ui/geometry
import std/ui/gpu
import support

fn lines() -> str[] {
    ["alpha beta", "gamma delta", "epsilon zeta"]
}

fn source() -> ui.LineSource {
    let count = fn() -> i64 { 3 }
    let line = fn(i: i64) -> str { lines()[i] }
    let edit = fn(e: ui.TextEdit) {}
    var out = ui.line_source(count, line, edit)
    out.line_fill = fn(i: i64) -> geometry.Color? {
        if i == 2 {
            return some(ui.rgb(0xffe8b0))
        }
        none
    }
    out
}

fn scene() -> ui.Element {
    let area = ui.text_area(source()).id("editor").absolute().left(20.0).top(20.0).size(200.0, 92.0).padding(6.0).background(ui.rgb(0xf8f8f8)).border(1.0, ui.rgb(0x3366aa)).font_family("Segoe UI")
    ui.div().size(240.0, 160.0).background(ui.rgb(0xffffff)).child(area)
}

fn render() ! ui.Error {
    using app = ui.open(ui.Options { title: "text area", width: 240, height: 160, background: ui.rgb(0xffffff), titlebar: ui.TitlebarOptions { appears_transparent: true }, activate: false })?
    using g = gpu.open() catch Gpu
    using t = gpu.target(g, 240, 160) catch Gpu
    let size = geometry.size(240.0, 160.0)
    ui.frame(app.cx, scene, size, 1.0)
    ui.set_focus(app.cx, "editor")
    ui.set_text_area_selection(app.cx, "editor", ui.TextPosition { line: 0, column: 6 }, ui.TextPosition { line: 1, column: 5 })
    let frame = ui.frame(app.cx, scene, size, 1.0)
    ui.draw(app.cx, g, t, frame) catch Gpu
    support.snapshot(g, t, "text_area") catch Gpu
}

fn main() ! ui.Error {
    render() catch {
        Platform(error) => {
            match error {
                NoDisplay(detail) => {
                    print("no display")
                    return
                }
                e => fail ui.Error.Platform(e)
            }
        }
        Gpu(error) => {
            match error {
                NoDevice => {
                    print("no device")
                    return
                }
                e => fail ui.Error.Gpu(e)
            }
        }
    }
}
