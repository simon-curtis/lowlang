import std/ui/platform
import win32support

const dwmwa_extended_frame_bounds: u32 = 9
const hwnd_topmost: i64 = -1
const swp_nomove_nosize_noactivate: u32 = 0x13
const attempts = 100

extern "user32" {
    fn GetDC(hwnd: ptr) -> ptr
    fn ReleaseDC(hwnd: ptr, dc: ptr) -> i32
    fn SetWindowPosAbove(hwnd: ptr, after: i64, x: i32, y: i32, width: i32, height: i32, flags: u32) -> i32 = "SetWindowPos"
}

extern "gdi32" {
    fn GetPixel(dc: ptr, x: i32, y: i32) -> u32
}

extern "dwmapi" {
    fn DwmGetFrameBounds(hwnd: ptr, attribute: u32, mut bounds: Rect, size: u32) -> i32 = "DwmGetWindowAttribute"
}

extern struct Rect {
    left: i32
    top: i32
    right: i32
    bottom: i32
}

fn frame_has_pixel(hwnd: ptr, colorref: u32) -> bool {
    var bounds = Rect { left: 0, top: 0, right: 0, bottom: 0 }
    if DwmGetFrameBounds(hwnd, dwmwa_extended_frame_bounds, mut bounds, 16) < 0 {
        return false
    }
    let width = bounds.right - bounds.left
    let height = bounds.bottom - bounds.top
    let screen = GetDC(null)
    var found = false
    for step in 1..i32(8) {
        let x = bounds.left + width * step / 8
        let y = bounds.top + height * step / 8
        if GetPixel(screen, bounds.left, y) == colorref || GetPixel(screen, bounds.right - 1, y) == colorref || GetPixel(screen, x, bounds.top) == colorref || GetPixel(screen, x, bounds.bottom - 1) == colorref {
            found = true
        }
    }
    ReleaseDC(null, screen)
    found
}

fn frame_shows(w: platform.Window, colorref: u32) -> bool ! platform.Error {
    let hwnd = platform.native(w).window
    for attempt in 0..attempts {
        if frame_has_pixel(hwnd, colorref) {
            return true
        }
        platform.next(w, 20)?
    }
    false
}

fn options(title: str, border: u32?) -> platform.Options {
    platform.Options { title, width: 320, height: 200, activate: false, border }
}

fn raise(w: platform.Window) ! platform.Error {
    win32support.ready(w)?
    SetWindowPosAbove(platform.native(w).window, hwnd_topmost, 0, 0, 0, 0, swp_nomove_nosize_noactivate)
}

fn drawn() ! platform.Error {
    using grey = platform.open(options("grey", some(0x444444)))?
    raise(grey)?
    print("the frame shows the border as 0x00BBGGRR {frame_shows(grey, 0x00444444)?}")
    using asymmetric = platform.open(options("asymmetric", some(0x445566)))?
    raise(asymmetric)?
    print("the frame shows an asymmetric border with red and blue swapped {frame_shows(asymmetric, 0x00665544)?}")
    print("the asymmetric border is not the grey one {!frame_has_pixel(platform.native(asymmetric).window, 0x00444444)}")
}

fn default() ! platform.Error {
    using system = platform.open(options("system", none))?
    raise(system)?
    platform.next(system, 500)?
    print("a window with no border leaves the system's {!frame_has_pixel(platform.native(system).window, 0x00665544)}")
}

fn once() ! platform.Error {
    if !win32support.has_border_colour() {
        print("skip the window border colour needs Windows 11")
        return
    }
    drawn()?
    default()?
}

fn main() {
    win32support.guard(once)
}
