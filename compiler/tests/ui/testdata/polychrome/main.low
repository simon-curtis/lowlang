import std/ui/gpu
import std/ui/scene
import std/ui/geometry
import support

fn pixels() -> []u8 {
    [
        255, 0, 0, 255, 0, 255, 0, 255, 0, 0, 255, 255, 255, 255, 255, 255,
        128, 0, 0, 128, 0, 0, 0, 0, 64, 64, 64, 255, 200, 100, 50, 255
    ]
}

fn pushed(atlas: scene.Atlas, grayscale: f32, opacity: f32, radius: f32) -> scene.Scene {
    let tile = scene.tile(atlas, 100, 40, 4, 2)
    var s = scene.empty(32, 32, geometry.rgb(0x404040))
    let sprite = scene.PolychromeSprite {
        bounds: geometry.rect(4.0, 4.0, 4.0, 2.0)
        tile
        corner_radii: geometry.corners(radius)
        grayscale
        opacity
    }
    scene.push_polychrome_sprite(mut s, sprite)
    s
}

fn render() ! gpu.Error {
    using g = gpu.open()?
    using t = gpu.target(g, 32, 32)?
    var atlases = [scene.atlas(1024)]
    scene.write_colors(mut atlases[0], 100, 40, 4, 2, pixels())

    gpu.render(g, t, pushed(atlases[0], 0.0, 1.0, 0.0), mut atlases)?
    support.snapshot(g, t, "plain")?

    gpu.render(g, t, pushed(atlases[0], 0.0, 0.5, 0.0), mut atlases)?
    support.snapshot(g, t, "faded")?

    gpu.render(g, t, pushed(atlases[0], 1.0, 1.0, 0.0), mut atlases)?
    support.snapshot(g, t, "gray")?

    gpu.render(g, t, pushed(atlases[0], 0.0, 1.0, 1.0), mut atlases)?
    support.snapshot(g, t, "rounded")?
}

fn main() ! gpu.Error {
    support.guard(render)?
}
