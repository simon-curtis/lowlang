import std/ui/geometry
import std/ui/gpu
import std/ui/platform
import std/ui/scene

pub enum Failure {
    Window(error: platform.Error)
    Graphics(error: gpu.Error)
    NoPresenter
}

pub struct Size {
    pub width: i64
    pub height: i64
}

pub struct Sizes {
    pub first: Size
    pub second: Size
}

struct Shot {
    pixels: []u8
    width: i64
    height: i64
}

const first_background = 0x102030
const second_background = 0x302010
const first_quad = 0xc04040
const second_quad = 0x40c040
const alternating_rounds = 40
const capture_attempts = 40

struct Tiles {
    first: []u8
    deep: []u8
}

struct Look {
    side: i64
    tiles: Tiles
}

struct Probe {
    background: i64
    channel: i64
}

fn surface_of(w: platform.Window) -> gpu.Surface {
    let native = platform.native(w)
    gpu.Surface { display: native.display, window: native.window }
}

fn pump(a: platform.Window, b: platform.Window) ! platform.Error {
    let _ = platform.next(a, 0)?
    platform.next(b, 0)?
}

fn first_scene(atlas: scene.Atlas, size: Size) -> scene.Scene {
    var s = scene.empty(size.width, size.height, geometry.rgb(u32(first_background)))
    let tile = scene.tile(atlas, 0, 0, 4, 1)
    scene.push_sprite(mut s, scene.Sprite { bounds: geometry.rect(2.0, 2.0, 4.0, 1.0), color: geometry.rgb(0xffffff), tile })
    scene.push_quad(mut s, scene.Quad { bounds: geometry.rect(16.0, 2.0, 12.0, 12.0), background: geometry.rgb(u32(first_quad)), corner_radii: geometry.corners(0.0) })
    s
}

fn second_scene(atlas: scene.Atlas, size: Size) -> scene.Scene {
    var s = scene.empty(size.width, size.height, geometry.rgb(u32(second_background)))
    let tile = scene.tile(atlas, 10, 900, 4, 1)
    scene.push_sprite(mut s, scene.Sprite { bounds: geometry.rect(2.0, 6.0, 4.0, 1.0), color: geometry.rgb(0xffffff), tile })
    scene.push_quad(mut s, scene.Quad { bounds: geometry.rect(16.0, 8.0, 12.0, 6.0), background: geometry.rgb(u32(second_quad)), corner_radii: geometry.corners(0.0) })
    s
}

fn write_tiles(mut atlas: scene.Atlas, tiles: Tiles) {
    scene.write(mut atlas, 0, 0, 4, 1, tiles.first)
    scene.write(mut atlas, 10, 900, 4, 1, tiles.deep)
}

fn channel_at(s: Shot, x: i64, y: i64, channel: i64) -> i64 {
    i64(s.pixels[(y * s.width + x) * 4 + channel])
}

fn near(got: i64, want: i64) -> bool {
    got - want <= 2 && want - got <= 2
}

fn tinted(p: Probe, coverage: i64) -> i64 {
    p.background + (255 - p.background) * coverage / 255
}

fn sprite_row(s: Shot, y: i64, background: i64, coverage: []u8) -> bool {
    for i in 0..coverage.len {
        for channel in 0..3 {
            let shift = 16 - channel * 8
            let probe = Probe { background: (background >> shift) & 0xff, channel }
            if !near(channel_at(s, 2 + i, y, channel), tinted(probe, i64(coverage[i]))) {
                return false
            }
        }
    }
    true
}

fn pixel_is(s: Shot, x: i64, y: i64, color: i64) -> bool {
    for channel in 0..3 {
        let shift = 16 - channel * 8
        if !near(channel_at(s, x, y, channel), (color >> shift) & 0xff) {
            return false
        }
    }
    true
}

fn shows(s: Shot, look: Look) -> bool {
    if look.side == 0 {
        return sprite_row(s, 2, first_background, look.tiles.first) && pixel_is(s, 20, 6, first_quad) && pixel_is(s, s.width - 4, s.height - 4, first_background)
    }
    sprite_row(s, 6, second_background, look.tiles.deep) && pixel_is(s, 20, 11, second_quad) && pixel_is(s, s.width - 4, s.height - 4, second_background)
}

fn sized(sizes: Sizes, side: i64) -> Size {
    if side == 0 {
        return sizes.first
    }
    sizes.second
}

fn presenter_for(d: gpu.Device, w: platform.Window) -> gpu.Presenter ! Failure {
    using p = gpu.presenter(d, surface_of(w)) catch {
        NoDevice => fail Failure.NoPresenter
        e => fail Failure.Graphics(e)
    }
    p
}

fn put(p: gpu.Presenter, s: scene.Scene, mut atlases: scene.Atlas[]) ! Failure {
    gpu.present_to(p, s, mut atlases) catch Failure.Graphics
}

fn snap(w: platform.Window, size: Size, capture: fn(platform.Window, Size) -> []u8) -> Shot {
    Shot { pixels: capture(w, size), width: size.width, height: size.height }
}

fn look_at(a: platform.Window, b: platform.Window, sizes: Sizes, capture: fn(platform.Window, Size) -> []u8, look: Look) -> bool? ! Failure {
    let size = sized(sizes, look.side)
    for attempt in 0..capture_attempts {
        pump(a, b) catch Failure.Window
        let shot = if look.side == 0 { snap(a, size, capture) } else { snap(b, size, capture) }
        if shot.pixels.len == 0 {
            return none
        }
        if shows(shot, look) {
            return some(true)
        }
        sleep(50)
    }
    some(false)
}

fn report(what: str, seen: bool?) {
    match seen {
        some(ok) => print("{what} {ok}")
        none => {}
    }
}

fn report_both(phase: str, a: platform.Window, b: platform.Window, sizes: Sizes, capture: fn(platform.Window, Size) -> []u8, tiles: Tiles) ! Failure {
    let first = look_at(a, b, sizes, capture, Look { side: 0, tiles })?
    report("{phase}: the first window shows its scene", first)
    let second = look_at(a, b, sizes, capture, Look { side: 1, tiles })?
    report("{phase}: the second window shows its scene", second)
}

fn rounds(a: platform.Window, b: platform.Window, mut atlases: scene.Atlas[], pa: gpu.Presenter, pb: gpu.Presenter, sizes: Sizes, capture: fn(platform.Window, Size) -> []u8) ! Failure {
    let version_one = Tiles { first: [255, 200, 100, 50], deep: [60, 120, 180, 240] }
    let version_two = Tiles { first: [10, 20, 30, 40], deep: [250, 150, 90, 30] }

    write_tiles(mut atlases[0], version_one)
    put(pa, first_scene(atlases[0], sizes.first), mut atlases)?
    put(pb, second_scene(atlases[0], sizes.second), mut atlases)?
    report_both("the first window uploads", a, b, sizes, capture, version_one)?

    write_tiles(mut atlases[0], version_two)
    put(pb, second_scene(atlases[0], sizes.second), mut atlases)?
    put(pa, first_scene(atlases[0], sizes.first), mut atlases)?
    report_both("the second window uploads", a, b, sizes, capture, version_two)?

    for round in 0..alternating_rounds {
        pump(a, b) catch Failure.Window
        if round % 2 == 0 {
            put(pa, first_scene(atlases[0], sizes.first), mut atlases)?
            put(pb, second_scene(atlases[0], sizes.second), mut atlases)?
        } else {
            put(pb, second_scene(atlases[0], sizes.second), mut atlases)?
            put(pa, first_scene(atlases[0], sizes.first), mut atlases)?
        }
    }
    print("presented {alternating_rounds} alternating rounds")
    report_both("after the alternating rounds", a, b, sizes, capture, version_two)?
}

fn after_release(a: platform.Window, b: platform.Window, mut atlases: scene.Atlas[], pb: gpu.Presenter, sizes: Sizes, capture: fn(platform.Window, Size) -> []u8) ! Failure {
    let version_three = Tiles { first: [1, 2, 3, 4], deep: [200, 100, 50, 25] }
    write_tiles(mut atlases[0], version_three)
    put(pb, second_scene(atlases[0], sizes.second), mut atlases)?
    print("presented after the first presenter was released")
    let second = look_at(a, b, sizes, capture, Look { side: 1, tiles: version_three })?
    report("after the first presenter is released: the second window shows its scene", second)
}

/// Opens one `Device` and a `Presenter` for each of `a` and `b`, presents a different scene to each, and prints whether each window shows its own scene after a glyph atlas is uploaded through each window in turn, after presents alternate between the windows and after the first window's `Presenter` is released. `capture` returns the pixels of a window as rows of RGBA, or nothing where the window's pixels cannot be read, in which case the lines about what a window shows are not printed.
pub fn run(a: platform.Window, b: platform.Window, sizes: Sizes, capture: fn(platform.Window, Size) -> []u8) ! Failure {
    using d = gpu.open_device(surface_of(a)) catch Failure.Graphics
    using pb = presenter_for(d, b)?
    var atlases = [scene.atlas(1024)]
    {
        using pa = presenter_for(d, a)?
        rounds(a, b, mut atlases, pa, pb, sizes, capture)?
    }
    after_release(a, b, mut atlases, pb, sizes, capture)?
}
