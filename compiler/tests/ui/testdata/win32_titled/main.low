import std/ui/platform
import win32support

const wm_nchittest: u32 = 0x84
const wm_nclbuttondown: u32 = 0xA1
const wm_nclbuttonup: u32 = 0xA2
const wm_ncmouseleave: u32 = 0x2A2
const wm_mousemove: u32 = 0x200

fn areas(x: f32, y: f32) -> platform.WindowControlArea? {
    if x < 0.0 || y < 0.0 || y >= 30.0 {
        return none
    }
    if x >= 250.0 {
        return platform.WindowControlArea.Close
    }
    none
}

fn hit(w: platform.Window, name: str, x: i64, y: i64) {
    let at = win32support.screen_point(w, win32support.pixels(w, x), win32support.pixels(w, y))
    print("hit {name} {win32support.ask(w, wm_nchittest, 0, at)}")
}

fn once() ! platform.Error {
    using w = platform.open(platform.Options { title: "titled", width: 320, height: 200, activate: false })?
    platform.set_hit_test(w, areas)
    let _ = win32support.ready(w)?

    print("client keeps the system frame {!win32support.client_fills_window(w)}")
    hit(w, "content", 100, 100)
    hit(w, "area", 280, 15)
    hit(w, "system caption", 100, -10)

    win32support.send(w, wm_mousemove, 0, win32support.point(win32support.pixels(w, 100), win32support.pixels(w, 100)))
    win32support.send(w, wm_ncmouseleave, 0, 0)
    win32support.show(platform.next(w, 200)?)

    let close = win32support.screen_point(w, win32support.pixels(w, 280), win32support.pixels(w, 15))
    hit(w, "area", 280, 15)
    win32support.send(w, wm_nclbuttondown, 20, close)
    win32support.send(w, wm_nclbuttonup, 20, close)
    win32support.show(platform.next(w, 1000)?)
}

fn main() {
    win32support.guard(once)
}
