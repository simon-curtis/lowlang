import std/image
import std/ui
import std/ui/platform

const wm_geticon: u32 = 0x7F
const icon_small: i64 = 0
const icon_big: i64 = 1

extern "user32" {
    fn FindWindowW(class: ptr, title: ptr) -> ptr
    fn SendMessageW(hwnd: ptr, message: u32, wparam: i64, lparam: i64) -> i64
    fn GetIconInfo(icon: ptr, mut info: IconInfo) -> i32
}

extern "gdi32" {
    fn GetObjectW(handle: ptr, size: i32, mut object: Bitmap) -> i32
    fn DeleteObject(handle: ptr) -> i32
}

extern "kernel32" {
    fn GetCurrentProcessId() -> u32
}

extern struct IconInfo {
    is_icon: i32 = 0
    hotspot_x: u32 = 0
    hotspot_y: u32 = 0
    mask: ptr = null
    color: ptr = null
}

extern struct Bitmap {
    kind: i32 = 0
    width: i32 = 0
    height: i32 = 0
    row_bytes: i32 = 0
    planes: u16 = 0
    bits_per_pixel: u16 = 0
    bits: ptr = null
}

fn wide(s: str) -> []u8 {
    var out: []u8 = []
    for b in bytes(s) {
        out.push(b)
        out.push(0)
    }
    out.push(0)
    out.push(0)
    out
}

fn find_window(title: str) -> ptr {
    let name = wide(title)
    let at: ptr[u8] = pin(name)
    let hwnd = FindWindowW(null, at)
    unpin(at)
    hwnd
}

fn frames_of(sizes: i64[]) -> ui.IconFrame[] {
    var frames: ui.IconFrame[] = []
    for size in sizes {
        let picture = image.create(size, size, image.Format.Rgba8)
        frames.push(ui.IconFrame { size, png: str(image.encode_png(picture)) })
    }
    frames
}

fn icon_of(hwnd: ptr, which: i64) -> ptr {
    ptr(SendMessageW(hwnd, wm_geticon, which, 0))
}

fn icon_width(icon: ptr) -> i64 {
    var info = IconInfo {}
    if GetIconInfo(icon, mut info) == 0 {
        return -1
    }
    var bitmap = Bitmap {}
    var width: i64 = -1
    if GetObjectW(info.color, 32, mut bitmap) != 0 {
        width = i64(bitmap.width)
    }
    DeleteObject(info.color)
    DeleteObject(info.mask)
    width
}

fn has_icons(hwnd: ptr) -> bool {
    icon_width(icon_of(hwnd, icon_big)) > 0 && icon_width(icon_of(hwnd, icon_small)) > 0
}

fn failed_with_bad_icon(w: ui.Window, frames: ui.IconFrame[]) -> bool {
    var failed = false
    ui.set_window_icon(w, frames) catch {
        Platform(error) => {
            match error {
                BadIcon(detail) => {
                    failed = true
                }
                e => print("set_window_icon failed with {e}")
            }
        }
        e => print("set_window_icon failed with {e}")
    }
    failed
}

fn content() -> ui.Element {
    ui.div()
}

fn drawn() ! ui.Error {
    let pid = GetCurrentProcessId()
    let title = "appicon main {pid}"
    let sizes: i64[] = [16, 32, 48, 256]
    using app = ui.open(ui.Options { title, width: 320, height: 200, activate: false, icon: some(frames_of(sizes)) })?
    let main = find_window(title)
    print("the main window has icons from open {has_icons(main)}")

    let first = icon_of(main, icon_big)
    let replacement: i64[] = [64]
    ui.set_window_icon(ui.main_window(app.cx), frames_of(replacement))?
    print("set_window_icon replaced the main window's icon {icon_of(main, icon_big) != first && icon_width(icon_of(main, icon_big)) == 64}")
    print("set_window_icon with a bad frame is BadIcon {failed_with_bad_icon(ui.main_window(app.cx), [ui.IconFrame { size: 32, png: frames_of([16])[0].png }])}")
    print("a refused icon keeps the main window's icon {icon_width(icon_of(main, icon_big)) == 64}")

    let tool_title = "appicon tool {pid}"
    let tool = ui.open_window(app.cx, ui.WindowOptions { title: tool_title, width: 200, height: 100, activate: false, icon: some(frames_of(sizes)) }, content)?
    let tool_hwnd = find_window(tool_title)
    print("a tool window has icons from open_window {has_icons(tool_hwnd)}")
    print("the tool window's icon is its own, not the main window's {icon_of(tool_hwnd, icon_big) != icon_of(main, icon_big)}")
    ui.close_window(tool)
    ui.set_window_icon(tool, frames_of(sizes))?
    print("set_window_icon on a closed window returns no error")

    let plain_title = "appicon plain {pid}"
    let plain = ui.open_window(app.cx, ui.WindowOptions { title: plain_title, width: 200, height: 100, activate: false }, content)?
    print("a window opened without an icon has none {icon_of(find_window(plain_title), icon_big) == null}")
    ui.close_window(plain)
}

fn guard(body: fn() ! ui.Error) ! ui.Error {
    body() catch {
        Platform(error) => {
            match error {
                NoDisplay(detail) => {
                    print("no display")
                    return
                }
                e => fail ui.Error.Platform(e)
            }
        }
        Gpu(error) => {
            match error {
                NoDevice => {
                    print("skip no Vulkan 1.3 device that presents to a window")
                    return
                }
                Vulkan(call, result) => {
                    print("skip Vulkan {call} returned {result}, so no window can be drawn")
                    return
                }
                e => fail ui.Error.Gpu(e)
            }
        }
    }
}

fn main() ! ui.Error {
    guard(drawn)?
}
