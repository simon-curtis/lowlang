import std/testing
import std/text

fn test_quads(t: *testing.T) {
    let out = run_render(t, "quad")

    let plain = frame(t, out, "plain")
    let clear = rgba(0, 0, 0, 0)
    let red = opaque(255, 0, 0)
    let green = opaque(0, 255, 0)
    expect_all(t, plain, red, 0, [18, 18, 8, 8, 27, 27, 8, 27, 27, 8])
    expect_all(t, plain, clear, 0, [4, 4, 7, 7, 28, 28, 7, 18, 28, 18, 18, 28])
    expect(t, plain, 32, 8, green, 0)
    expect(t, plain, 40, 8, green, 0)
    expect(t, plain, 44, 20, green, 0)
    expect(t, plain, 55, 31, green, 0)
    expect(t, plain, 55, 8, clear, 0)
    expect(t, plain, 32, 31, clear, 0)
    expect(t, plain, 52, 12, green, 0)
    expect(t, plain, 53, 10, clear, 0)
    expect(t, plain, 33, 30, clear, 0)

    let bordered = frame(t, out, "bordered")
    let background = opaque(0x10, 0x20, 0x30)
    let blue = opaque(0, 0, 255)
    let yellow = opaque(255, 255, 0)
    expect_all(t, bordered, background, 0, [4, 4, 7, 28, 56, 28, 30, 7, 30, 48])
    expect_all(t, bordered, yellow, 0, [30, 28, 16, 28, 51, 28, 30, 10, 30, 41])
    expect_all(t, bordered, blue, 0, [8, 28, 15, 28, 30, 8, 30, 9, 52, 28, 55, 28, 30, 42, 30, 47])

    let rounded = frame(t, out, "rounded")
    let black = opaque(0, 0, 0)
    let white = opaque(255, 255, 255)
    expect_all(t, rounded, white, 0, [8, 8, 55, 8, 8, 55, 55, 55, 2, 2])
    expect_all(t, rounded, green, 0, [32, 32, 20, 20])
    expect_all(t, rounded, black, 0, [32, 8, 32, 11, 8, 32, 55, 32, 32, 55])
}

fn test_shadow(t: *testing.T) {
    let out = run_render(t, "shadow")
    let f = frame(t, out, "shadow")
    let white = opaque(255, 255, 255)

    expect(t, f, 48, 32, opaque(0, 0, 0), 12)
    let edge = at(f, 31, 32).r
    if edge < 100 || edge > 160 {
        t.error("the shadow at the rectangle's edge is {edge}, want about 128")
    }
    let row = 32
    var previous = -1
    var x = 31
    for x >= 18 {
        let v = at(f, x, row).r
        if v < previous {
            t.error("the shadow brightens to {v} at x={x} after {previous}, so it is not monotonic")
        }
        previous = v
        x -= 1
    }
    let far = at(f, 20, row).r
    if far < 250 {
        t.error("three sigma out the shadow is {far}, want at least 250")
    }
    let near = at(f, 28, row).r
    if near < 190 || near > 230 {
        t.error("one sigma out the shadow is {near}, want about 205")
    }
    expect(t, f, 10, row, white, 0)
    expect(t, f, 85, row, white, 0)
    expect(t, f, 48, 2, white, 0)

    for k in 0..12 {
        let left = at(f, 31 - k, 32)
        let right = at(f, 64 + k, 32)
        let top = at(f, 48, 15 - k)
        let bottom = at(f, 48, 48 + k)
        if abs(left.r - right.r) > 2 {
            t.error("shadow is not symmetric in x at {k}: {pixel_text(left)} against {pixel_text(right)}")
        }
        if abs(top.r - bottom.r) > 2 {
            t.error("shadow is not symmetric in y at {k}: {pixel_text(top)} against {pixel_text(bottom)}")
        }
        if abs(left.r - top.r) > 2 {
            t.error("shadow of a square differs between x and y at {k}: {pixel_text(left)} against {pixel_text(top)}")
        }
    }

    let r = frame(t, out, "rounded")
    let inside = at(r, 48, 32).r
    let corner = at(r, 32, 16).r
    if corner < inside + 100 {
        t.error("the rounded shadow's corner {corner} is not much lighter than its middle {inside}")
    }
}

fn test_shapes_match_the_pixels_gpui_draws(t: *testing.T) {
    let out = run_render(t, "parity")
    let f = frame(t, out, "parity")
    let background = opaque(25, 25, 25)
    let blue = opaque(51, 92, 153)
    let orange = opaque(229, 87, 25)
    let white = opaque(255, 255, 255)
    let red = opaque(229, 25, 25)

    expect_all(t, f, background, 0, [8, 8, 9, 9, 67, 47, 66, 46, 80, 8, 139, 8, 138, 9, 139, 47, 132, 44, 69, 112, 68, 143, 30, 143])
    expect_all(t, f, blue, 0, [11, 11, 12, 9, 9, 12, 30, 28, 8, 28, 67, 28, 30, 8, 30, 47, 154, 28, 155, 28, 209, 28, 180, 10, 180, 45])
    expect_all(t, f, blue, 0, [12, 80, 65, 80, 40, 61, 40, 96, 86, 80, 87, 80, 134, 80, 110, 61, 90, 70, 95, 96])
    expect_all(t, f, orange, 0, [125, 40, 80, 47, 110, 28])
    expect_all(t, f, white, 0, [152, 28, 153, 28, 211, 28, 210, 28, 180, 8, 180, 9, 180, 47, 180, 46])
    expect_all(t, f, red, 0, [8, 80, 11, 80, 66, 80, 67, 80, 40, 60, 40, 98, 40, 97, 40, 99])
    expect_all(t, f, red, 0, [80, 80, 85, 80, 137, 80, 139, 80, 110, 60, 110, 98, 110, 99, 86, 66, 135, 66])

    expect(t, f, 10, 10, opaque(44, 73, 117), 0)
    expect(t, f, 81, 8, opaque(66, 37, 25), 0)
    expect(t, f, 134, 10, opaque(227, 86, 25), 0)
    expect_all(t, f, opaque(92, 125, 173), 0, [155, 12, 156, 11, 158, 10])
    expect(t, f, 84, 64, opaque(73, 25, 25), 0)
    expect(t, f, 88, 92, opaque(65, 87, 143), 0)
    expect(t, f, 130, 95, opaque(103, 72, 116), 0)

    expect_all(t, f, opaque(134, 42, 57), 0, [152, 80, 153, 80, 154, 80, 158, 62, 160, 61, 170, 60, 156, 64])
    expect_all(t, f, opaque(38, 58, 89), 0, [155, 80, 170, 80])

    expect_all(t, f, white, 0, [8, 112, 9, 112, 8, 113, 68, 112, 30, 128, 30, 142])

    expect(t, f, 97, 120, opaque(21, 21, 21), 0)
    expect(t, f, 95, 126, opaque(21, 21, 21), 0)
    expect(t, f, 90, 126, opaque(22, 22, 22), 0)
    expect(t, f, 85, 126, opaque(24, 24, 24), 0)
    expect(t, f, 130, 150, opaque(20, 20, 20), 0)
    expect(t, f, 120, 148, opaque(19, 19, 19), 0)
    expect(t, f, 165, 127, opaque(21, 21, 21), 0)
    expect(t, f, 170, 127, opaque(23, 23, 23), 0)
    expect(t, f, 130, 100, opaque(23, 23, 23), 0)
    expect(t, f, 130, 145, opaque(18, 18, 18), 0)
    expect_all(t, f, orange, 0, [176, 126, 180, 126, 190, 140])
}

fn test_overlays_match_the_pixels_gpui_draws(t: *testing.T) {
    let out = run_render(t, "overlays")
    let f = frame(t, out, "overlays")
    let white = opaque(255, 255, 255)
    let gray = opaque(128, 128, 128)
    let dark = opaque(64, 64, 64)

    expect_all(t, f, opaque(255, 0, 0), 0, [30, 30, 69, 30, 30, 59, 69, 59, 60, 55])
    expect_all(t, f, gray, 0, [10, 10, 45, 20, 20, 45, 49, 29])
    expect_all(t, f, opaque(0, 255, 0), 0, [190, 20, 229, 20, 190, 39, 229, 39])
    expect_all(t, f, opaque(255, 255, 0), 0, [192, 132, 231, 132, 192, 151, 231, 151])
    expect_all(t, f, opaque(0, 0, 255), 0, [20, 130, 49, 130, 20, 149, 49, 149])
    expect_all(t, f, opaque(255, 0, 255), 0, [100, 60, 139, 60, 100, 99, 139, 99, 130, 90])
    expect_all(t, f, opaque(0, 255, 255), 0, [140, 100, 159, 80, 120, 119, 159, 119])
    expect_all(t, f, opaque(255, 128, 0), 0, [60, 130, 89, 130, 60, 149, 89, 149])
    expect_all(t, f, opaque(0, 128, 0), 0, [176, 64, 195, 64, 176, 73, 195, 73])
    expect_all(t, f, dark, 0, [175, 68, 196, 68, 180, 63, 180, 74])
    expect_all(t, f, white, 0, [70, 45, 45, 60, 189, 30, 230, 30, 191, 140, 232, 140, 200, 131, 200, 152, 19, 140, 50, 140, 30, 150, 90, 140, 59, 140])
}

fn test_sprites(t: *testing.T) {
    let out = run_render(t, "sprite")
    let f = frame(t, out, "sprites")
    let black = opaque(0, 0, 0)

    expect(t, f, 4, 4, opaque(255, 0, 0), 1)
    expect(t, f, 5, 4, opaque(255, 0, 0), 1)
    expect(t, f, 6, 4, opaque(128, 0, 0), 2)
    expect(t, f, 7, 4, opaque(128, 0, 0), 2)
    expect(t, f, 8, 4, black, 0)
    expect(t, f, 9, 4, black, 0)
    expect(t, f, 10, 4, opaque(64, 0, 0), 2)
    expect(t, f, 11, 4, opaque(64, 0, 0), 2)
    expect(t, f, 4, 5, opaque(255, 0, 0), 1)
    expect(t, f, 12, 4, black, 0)
    expect(t, f, 4, 6, black, 0)

    expect(t, f, 4, 10, opaque(0, 128, 0), 2)
    expect(t, f, 6, 10, opaque(0, 64, 0), 2)
    expect(t, f, 8, 10, black, 0)
    expect(t, f, 10, 10, opaque(0, 32, 0), 2)

    for y in 17..19 {
        expect(t, f, 4, y, opaque(0, 0, 191), 1)
        expect(t, f, 5, y, opaque(0, 0, 255), 1)
        expect(t, f, 7, y, opaque(0, 0, 223), 1)
        expect(t, f, 8, y, opaque(0, 0, 160), 2)
        expect(t, f, 11, y, opaque(0, 0, 96), 2)
        expect(t, f, 12, y, opaque(0, 0, 32), 0)
        expect(t, f, 15, y, opaque(0, 0, 16), 0)
        expect(t, f, 16, y, opaque(0, 0, 48), 2)
        expect(t, f, 19, y, opaque(0, 0, 48), 2)
    }
    for y in [16, 19] {
        expect(t, f, 4, y, opaque(0, 0, 143), 1)
        expect(t, f, 5, y, opaque(0, 0, 191), 1)
        expect(t, f, 7, y, opaque(0, 0, 167), 1)
        expect(t, f, 8, y, opaque(0, 0, 120), 2)
        expect(t, f, 11, y, opaque(0, 0, 72), 2)
        expect(t, f, 12, y, opaque(0, 0, 24), 0)
        expect(t, f, 15, y, opaque(0, 0, 12), 0)
        expect(t, f, 16, y, opaque(0, 0, 36), 2)
        expect(t, f, 19, y, opaque(0, 0, 36), 2)
    }
    expect(t, f, 20, 16, black, 0)
    expect(t, f, 4, 20, black, 0)
}

fn test_subpixel_sprites(t: *testing.T) {
    let out = run_render(t, "subpixel")
    let ground = opaque(64, 64, 64)

    let white = frame(t, out, "white")
    expect(t, white, 4, 4, opaque(255, 64, 64), 0)
    expect(t, white, 5, 4, opaque(64, 255, 64), 0)
    expect(t, white, 6, 4, opaque(64, 64, 255), 0)
    expect(t, white, 7, 4, opaque(255, 255, 255), 0)
    expect(t, white, 8, 4, opaque(160, 64, 112), 1)
    expect(t, white, 4, 5, opaque(255, 64, 64), 0)
    expect(t, white, 9, 4, ground, 0)
    expect(t, white, 3, 4, ground, 0)
    expect(t, white, 4, 6, ground, 0)

    let red = frame(t, out, "red")
    expect(t, red, 4, 4, opaque(255, 64, 64), 0)
    expect(t, red, 5, 4, opaque(64, 0, 64), 0)
    expect(t, red, 6, 4, opaque(64, 64, 0), 0)
    expect(t, red, 7, 4, opaque(255, 0, 0), 0)

    let reversed = frame(t, out, "bgr")
    expect(t, reversed, 4, 4, opaque(64, 64, 255), 0)
    expect(t, reversed, 5, 4, opaque(64, 255, 64), 0)
    expect(t, reversed, 6, 4, opaque(255, 64, 64), 0)
    expect(t, reversed, 8, 4, opaque(112, 64, 160), 1)

    let corrected = frame(t, out, "corrected")
    expect(t, corrected, 4, 4, opaque(128, 64, 64), 1)
    expect(t, corrected, 5, 4, opaque(64, 128, 64), 1)
    expect(t, corrected, 8, 4, opaque(101, 64, 87), 1)
}

fn test_polychrome_sprites(t: *testing.T) {
    let out = run_render(t, "polychrome")
    let ground = opaque(64, 64, 64)

    let plain = frame(t, out, "plain")
    expect(t, plain, 4, 4, opaque(255, 0, 0), 0)
    expect(t, plain, 5, 4, opaque(0, 255, 0), 0)
    expect(t, plain, 6, 4, opaque(0, 0, 255), 0)
    expect(t, plain, 7, 4, opaque(255, 255, 255), 0)
    expect(t, plain, 4, 5, opaque(96, 32, 32), 2)
    expect(t, plain, 5, 5, ground, 0)
    expect(t, plain, 6, 5, opaque(64, 64, 64), 0)
    expect(t, plain, 7, 5, opaque(200, 100, 50), 0)
    expect(t, plain, 8, 4, ground, 0)
    expect(t, plain, 3, 4, ground, 0)
    expect(t, plain, 4, 6, ground, 0)

    let faded = frame(t, out, "faded")
    expect(t, faded, 4, 4, opaque(160, 32, 32), 2)
    expect(t, faded, 7, 4, opaque(160, 160, 160), 2)
    expect(t, faded, 5, 5, ground, 0)

    let gray = frame(t, out, "gray")
    expect(t, gray, 4, 4, opaque(54, 54, 54), 2)
    expect(t, gray, 5, 4, opaque(182, 182, 182), 2)
    expect(t, gray, 6, 4, opaque(18, 18, 18), 2)
    expect(t, gray, 7, 4, opaque(255, 255, 255), 2)

    let rounded = frame(t, out, "rounded")
    expect(t, rounded, 4, 4, opaque(215, 13, 13), 3)
    expect(t, rounded, 5, 4, opaque(0, 255, 0), 0)
    expect(t, rounded, 5, 5, ground, 0)
}

fn test_clip(t: *testing.T) {
    let out = run_render(t, "clip")
    let f = frame(t, out, "clip")
    let black = opaque(0, 0, 0)
    let red = opaque(255, 0, 0)
    let blue = opaque(0, 0, 255)

    expect_all(t, f, red, 0, [16, 8, 31, 8, 31, 23, 16, 23])
    expect_all(t, f, black, 0, [32, 8, 32, 23, 47, 15, 15, 15, 31, 24, 31, 7])

    expect_all(t, f, blue, 0, [8, 32, 55, 32, 30, 39, 8, 39, 55, 39])
    expect_all(t, f, black, 0, [30, 31, 30, 40, 30, 47, 7, 35, 56, 35])

    expect_all(t, f, opaque(0, 255, 0), 0, [8, 52, 23, 59])
    expect_all(t, f, black, 0, [24, 52, 8, 60, 7, 52])
}

fn test_draw_order(t: *testing.T) {
    let out = run_render(t, "order")
    let f = frame(t, out, "order")
    let green = opaque(0, 255, 0)
    let white = opaque(255, 255, 255)

    expect(t, f, 6, 6, opaque(255, 0, 0), 0)
    expect(t, f, 30, 10, green, 1)
    expect(t, f, 25, 5, opaque(0, 0, 255), 0)
    expect(t, f, 15, 15, opaque(255, 0, 0), 0)

    expect(t, f, 5, 31, white, 0)
    expect(t, f, 16, 38, opaque(0, 0, 0), 30)
    expect(t, f, 15, 41, green, 0)
    expect(t, f, 17, 43, green, 0)
    expect(t, f, 26, 52, white, 40)

    if out.lines.len != 1 || out.lines[0] != "batches 6" {
        let got = text.join(out.lines, "|")
        t.error("batches = {got}, want one line batches 6")
    }
}

fn test_frames_in_flight(t: *testing.T) {
    let out = run_render(t, "frames")
    let black = opaque(0, 0, 0)
    for step in 0..6 {
        let f = frame(t, out, "step{step}")
        let shade = opaque(step * 30, 255 - step * 30, 0)
        expect(t, f, step * 8 + 4, 8, shade, 1)
        expect(t, f, step * 8, 4, shade, 1)
        expect(t, f, step * 8 + 7, 11, shade, 1)
        for other in 0..8 {
            if other == step {
                continue
            }
            expect(t, f, other * 8 + 4, 8, black, 0)
        }
    }

    let burst = frame(t, out, "burst")
    expect(t, burst, 3 * 8 + 4, 8, opaque(90, 165, 0), 1)
    for step in 0..3 {
        expect(t, burst, step * 8 + 4, 8, black, 0)
    }

    let square = frame(t, out, "square")
    expect(t, square, 12, 12, opaque(255, 0, 255), 0)
    expect(t, square, 0, 0, opaque(128, 128, 128), 0)
    expect(t, square, 23, 23, opaque(128, 128, 128), 0)

    let wide = frame(t, out, "wide")
    expect(t, wide, 7 * 8 + 4, 8, opaque(210, 45, 0), 1)
    expect(t, wide, 3 * 8 + 4, 8, black, 0)

    let empty = frame(t, out, "empty")
    expect_all(t, empty, opaque(0x33, 0x66, 0x99), 0, [0, 0, 12, 8, 63, 15])

    if out.lines.len != 1 || out.lines[0] != "invalid 0 10" {
        let got = text.join(out.lines, "|")
        t.error("lines = {got}, want one line invalid 0 10")
    }
}

fn growth_colour(x: i64, y: i64) -> Pixel {
    opaque(x * 2 % 256, y * 5 % 256, (x + y * 3) % 256)
}

fn check_growth_frame(t: *testing.T, name: str, f: Frame, count: i64) {
    let black = opaque(0, 0, 0)
    for n in 0..5000 {
        let x = n % 100
        let y = n / 100
        let want = if n < count { growth_colour(x, y) } else { black }
        let got = at(f, x, y)
        if !same_pixel(got, want) {
            t.fatal("{name}: pixel {x},{y} = {pixel_text(got)}, want {pixel_text(want)}")
        }
    }
}

fn test_instance_buffer_growth(t: *testing.T) {
    let out = run_render(t, "growth")
    let counts = [10, 5000, 100, 5000]
    for i in 0..counts.len {
        let name = "quads{i}"
        let f = frame(t, out, name)
        check_growth_frame(t, name, f, counts[i])
    }

    let dots = frame(t, out, "sprites")
    check_growth_frame(t, "sprites", dots, 1500)

    let halos = frame(t, out, "shadows")
    for n in 0..240 {
        let x = n % 20 * 8 + 4
        let y = n / 20 * 8 + 4
        let body = at(halos, x, y).r
        if body > 100 {
            t.error("shadow {n} has no body: pixel {x},{y} is {body}")
        }
        let gap = at(halos, x - 4, y - 4).r
        if gap < 200 {
            t.error("shadow {n} spills into the gap: pixel {x - 4},{y - 4} is {gap}")
        }
    }
}

fn covered(coverage: []i64) -> []Pixel {
    var pixels: []Pixel = []
    for c in coverage {
        pixels.push(opaque(c, c, c))
    }
    pixels
}

fn check_atlas(t: *testing.T, out: Output, name: str, row: i64, x: i64, coverage: []i64) {
    let f = frame(t, out, name)
    let want = covered(coverage)
    for i in 0..want.len {
        expect(t, f, x + i, row, want[i], 1)
    }
}

fn test_atlas_updates(t: *testing.T) {
    let out = run_render(t, "atlas")
    let dark = [0, 0, 0, 0]
    let low = [10, 20, 30, 40]
    let high = [60, 120, 180, 240]
    let resized = [90, 91, 92, 93]

    check_atlas(t, out, "first", 2, 2, [255, 200, 100, 50])
    check_atlas(t, out, "first", 6, 2, dark)
    check_atlas(t, out, "rewritten", 2, 2, low)
    check_atlas(t, out, "rewritten", 6, 2, dark)
    check_atlas(t, out, "deep", 2, 2, low)
    check_atlas(t, out, "deep", 6, 2, high)
    check_atlas(t, out, "unchanged", 2, 2, low)
    check_atlas(t, out, "unchanged", 6, 2, high)
    check_atlas(t, out, "cleared", 2, 2, dark)
    check_atlas(t, out, "cleared", 6, 2, dark)
    check_atlas(t, out, "resized", 2, 2, resized)
    check_atlas(t, out, "resized", 6, 2, dark)
    check_atlas(t, out, "resized_again", 2, 2, resized)

    let want = ["dirty false", "dirty true 0 1", "dirty true 900 901"]
    if out.lines.len != want.len {
        let got_text = text.join(out.lines, "|")
        let want_text = text.join(want, "|")
        t.fatal("lines = {got_text}, want {want_text}")
    }
    for i in 0..want.len {
        if out.lines[i] != want[i] {
            t.error("line {i} = {text.quote(out.lines[i])}, want {text.quote(want[i])}")
        }
    }
}

fn check_hint_box(t: *testing.T, f: Frame, top: i64, height: i64, tint: Pixel) {
    let border = opaque(0x33, 0x66, 0xaa)
    let ground = opaque(240, 240, 240)
    let bottom = top + height
    expect_fill(t, f, 20, top, 220, top + 1, border)
    expect_fill(t, f, 20, bottom - 1, 220, bottom, border)
    expect_fill(t, f, 20, top + 1, 21, bottom - 1, border)
    expect_fill(t, f, 219, top + 1, 220, bottom - 1, border)
    expect_fill(t, f, 21, top + 1, 219, top + 7, ground)
    expect_fill(t, f, 21, bottom - 7, 219, bottom - 1, ground)
    expect_fill(t, f, 21, top + 7, 27, bottom - 7, ground)
    expect_fill(t, f, 213, top + 7, 219, bottom - 7, ground)

    let ink = ink_in(f, 27, top + 7, 213, bottom - 7, ground, tint)
    if ink.count == 0 {
        t.error("the placeholder at {top} drew no ink")
        return
    }
    if ink.left < 27 || ink.left > 29 {
        t.error("the placeholder at {top} starts at x={ink.left}, want the content box's left edge, 27")
    }
    if ink.top < top + 7 || ink.bottom >= bottom - 7 {
        t.error("the placeholder at {top} spans y={ink.top} to {ink.bottom}, outside the content box")
    }
    if ink.right < 60 || ink.right >= 213 {
        t.error("the placeholder at {top} ends at x={ink.right}, want a word of text inside the content box")
    }
    if ink.solid == 0 {
        t.error("no pixel of the placeholder at {top} is the full colour {pixel_text(tint)}")
    }
}

fn test_placeholder_matches_the_pixels_gpui_draws(t: *testing.T) {
    let out = run_window_render(t, "placeholder")
    let f = frame(t, out, "placeholder")
    let white = opaque(255, 255, 255)

    check_hint_box(t, f, 20, 44, opaque(192, 192, 192))
    check_hint_box(t, f, 80, 60, opaque(0xcc, 0x33, 0x00))

    expect_fill(t, f, 0, 0, 240, 20, white)
    expect_fill(t, f, 0, 20, 20, 140, white)
    expect_fill(t, f, 220, 20, 240, 140, white)
    expect_fill(t, f, 20, 64, 220, 80, white)
    expect_fill(t, f, 0, 140, 240, 160, white)
}
