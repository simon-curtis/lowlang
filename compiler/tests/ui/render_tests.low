import std/testing
import std/text

fn test_quads(t: *testing.T) {
    let out = run_render(t, "quad")

    let plain = frame(t, out, "plain")
    let clear = rgba(0, 0, 0, 0)
    let red = opaque(255, 0, 0)
    let green = opaque(0, 255, 0)
    expect_all(t, plain, red, 0, [18, 18, 8, 8, 27, 27, 8, 27, 27, 8])
    expect_all(t, plain, clear, 0, [4, 4, 7, 7, 28, 28, 7, 18, 28, 18, 18, 28])
    expect(t, plain, 32, 8, green, 0)
    expect(t, plain, 40, 8, green, 0)
    expect(t, plain, 44, 20, green, 0)
    expect(t, plain, 55, 31, green, 0)
    expect(t, plain, 55, 8, clear, 0)
    expect(t, plain, 32, 31, clear, 0)
    expect(t, plain, 52, 12, green, 0)
    expect(t, plain, 53, 10, clear, 0)
    expect(t, plain, 33, 30, clear, 0)

    let bordered = frame(t, out, "bordered")
    let background = opaque(0x10, 0x20, 0x30)
    let blue = opaque(0, 0, 255)
    let yellow = opaque(255, 255, 0)
    expect_all(t, bordered, background, 0, [4, 4, 7, 28, 56, 28, 30, 7, 30, 48])
    expect_all(t, bordered, yellow, 0, [30, 28, 16, 28, 51, 28, 30, 10, 30, 41])
    expect_all(t, bordered, blue, 0, [8, 28, 15, 28, 30, 8, 30, 9, 52, 28, 55, 28, 30, 42, 30, 47])

    let rounded = frame(t, out, "rounded")
    let black = opaque(0, 0, 0)
    let white = opaque(255, 255, 255)
    expect_all(t, rounded, white, 0, [8, 8, 55, 8, 8, 55, 55, 55, 2, 2])
    expect_all(t, rounded, green, 0, [32, 32, 20, 20])
    expect_all(t, rounded, black, 0, [32, 8, 32, 11, 8, 32, 55, 32, 32, 55])
}

fn test_shadow(t: *testing.T) {
    let out = run_render(t, "shadow")
    let f = frame(t, out, "shadow")
    let white = opaque(255, 255, 255)

    expect(t, f, 48, 32, opaque(0, 0, 0), 12)
    let edge = at(f, 31, 32).r
    if edge < 100 || edge > 160 {
        t.error("the shadow at the rectangle's edge is {edge}, want about 128")
    }
    let row = 32
    var previous = -1
    var x = 31
    for x >= 18 {
        let v = at(f, x, row).r
        if v < previous {
            t.error("the shadow brightens to {v} at x={x} after {previous}, so it is not monotonic")
        }
        previous = v
        x -= 1
    }
    let far = at(f, 20, row).r
    if far < 250 {
        t.error("three sigma out the shadow is {far}, want at least 250")
    }
    let near = at(f, 28, row).r
    if near < 190 || near > 230 {
        t.error("one sigma out the shadow is {near}, want about 205")
    }
    expect(t, f, 10, row, white, 0)
    expect(t, f, 85, row, white, 0)
    expect(t, f, 48, 2, white, 0)

    for k in 0..12 {
        let left = at(f, 31 - k, 32)
        let right = at(f, 64 + k, 32)
        let top = at(f, 48, 15 - k)
        let bottom = at(f, 48, 48 + k)
        if abs(left.r - right.r) > 2 {
            t.error("shadow is not symmetric in x at {k}: {pixel_text(left)} against {pixel_text(right)}")
        }
        if abs(top.r - bottom.r) > 2 {
            t.error("shadow is not symmetric in y at {k}: {pixel_text(top)} against {pixel_text(bottom)}")
        }
        if abs(left.r - top.r) > 2 {
            t.error("shadow of a square differs between x and y at {k}: {pixel_text(left)} against {pixel_text(top)}")
        }
    }

    let r = frame(t, out, "rounded")
    let inside = at(r, 48, 32).r
    let corner = at(r, 32, 16).r
    if corner < inside + 100 {
        t.error("the rounded shadow's corner {corner} is not much lighter than its middle {inside}")
    }
}

fn test_sprites(t: *testing.T) {
    let out = run_render(t, "sprite")
    let f = frame(t, out, "sprites")
    let black = opaque(0, 0, 0)

    expect(t, f, 4, 4, opaque(255, 0, 0), 1)
    expect(t, f, 5, 4, opaque(255, 0, 0), 1)
    expect(t, f, 6, 4, opaque(128, 0, 0), 2)
    expect(t, f, 7, 4, opaque(128, 0, 0), 2)
    expect(t, f, 8, 4, black, 0)
    expect(t, f, 9, 4, black, 0)
    expect(t, f, 10, 4, opaque(64, 0, 0), 2)
    expect(t, f, 11, 4, opaque(64, 0, 0), 2)
    expect(t, f, 4, 5, opaque(255, 0, 0), 1)
    expect(t, f, 12, 4, black, 0)
    expect(t, f, 4, 6, black, 0)

    expect(t, f, 4, 10, opaque(0, 128, 0), 2)
    expect(t, f, 6, 10, opaque(0, 64, 0), 2)
    expect(t, f, 8, 10, black, 0)
    expect(t, f, 10, 10, opaque(0, 32, 0), 2)

    for y in 16..20 {
        expect(t, f, 4, y, opaque(0, 0, 255), 1)
        expect(t, f, 7, y, opaque(0, 0, 255), 1)
        expect(t, f, 8, y, opaque(0, 0, 128), 2)
        expect(t, f, 11, y, opaque(0, 0, 128), 2)
        expect(t, f, 12, y, black, 0)
        expect(t, f, 15, y, black, 0)
        expect(t, f, 16, y, opaque(0, 0, 64), 2)
        expect(t, f, 19, y, opaque(0, 0, 64), 2)
    }
    expect(t, f, 20, 16, black, 0)
    expect(t, f, 4, 20, black, 0)
}

fn test_clip(t: *testing.T) {
    let out = run_render(t, "clip")
    let f = frame(t, out, "clip")
    let black = opaque(0, 0, 0)
    let red = opaque(255, 0, 0)
    let blue = opaque(0, 0, 255)

    expect_all(t, f, red, 0, [16, 8, 31, 8, 31, 23, 16, 23])
    expect_all(t, f, black, 0, [32, 8, 32, 23, 47, 15, 15, 15, 31, 24, 31, 7])

    expect_all(t, f, blue, 0, [8, 32, 55, 32, 30, 39, 8, 39, 55, 39])
    expect_all(t, f, black, 0, [30, 31, 30, 40, 30, 47, 7, 35, 56, 35])

    expect_all(t, f, opaque(0, 255, 0), 0, [8, 52, 23, 59])
    expect_all(t, f, black, 0, [24, 52, 8, 60, 7, 52])
}

fn test_draw_order(t: *testing.T) {
    let out = run_render(t, "order")
    let f = frame(t, out, "order")
    let green = opaque(0, 255, 0)
    let white = opaque(255, 255, 255)

    expect(t, f, 6, 6, opaque(255, 0, 0), 0)
    expect(t, f, 30, 10, green, 1)
    expect(t, f, 25, 5, opaque(0, 0, 255), 0)
    expect(t, f, 15, 15, opaque(255, 0, 0), 0)

    expect(t, f, 5, 31, white, 0)
    expect(t, f, 16, 38, opaque(0, 0, 0), 30)
    expect(t, f, 15, 41, green, 0)
    expect(t, f, 17, 43, green, 0)
    expect(t, f, 26, 52, white, 40)

    if out.lines.len != 1 || out.lines[0] != "batches 6" {
        let got = text.join(out.lines, "|")
        t.error("batches = {got}, want one line batches 6")
    }
}

fn test_frames_in_flight(t: *testing.T) {
    let out = run_render(t, "frames")
    let black = opaque(0, 0, 0)
    for step in 0..6 {
        let f = frame(t, out, "step{step}")
        let shade = opaque(step * 30, 255 - step * 30, 0)
        expect(t, f, step * 8 + 4, 8, shade, 1)
        expect(t, f, step * 8, 4, shade, 1)
        expect(t, f, step * 8 + 7, 11, shade, 1)
        for other in 0..8 {
            if other == step {
                continue
            }
            expect(t, f, other * 8 + 4, 8, black, 0)
        }
    }

    let burst = frame(t, out, "burst")
    expect(t, burst, 3 * 8 + 4, 8, opaque(90, 165, 0), 1)
    for step in 0..3 {
        expect(t, burst, step * 8 + 4, 8, black, 0)
    }

    let square = frame(t, out, "square")
    expect(t, square, 12, 12, opaque(255, 0, 255), 0)
    expect(t, square, 0, 0, opaque(128, 128, 128), 0)
    expect(t, square, 23, 23, opaque(128, 128, 128), 0)

    let wide = frame(t, out, "wide")
    expect(t, wide, 7 * 8 + 4, 8, opaque(210, 45, 0), 1)
    expect(t, wide, 3 * 8 + 4, 8, black, 0)

    let empty = frame(t, out, "empty")
    expect_all(t, empty, opaque(0x33, 0x66, 0x99), 0, [0, 0, 12, 8, 63, 15])

    if out.lines.len != 1 || out.lines[0] != "invalid 0 10" {
        let got = text.join(out.lines, "|")
        t.error("lines = {got}, want one line invalid 0 10")
    }
}

fn growth_colour(x: i64, y: i64) -> Pixel {
    opaque(x * 2 % 256, y * 5 % 256, (x + y * 3) % 256)
}

fn check_growth_frame(t: *testing.T, name: str, f: Frame, count: i64) {
    let black = opaque(0, 0, 0)
    for n in 0..5000 {
        let x = n % 100
        let y = n / 100
        let want = if n < count { growth_colour(x, y) } else { black }
        let got = at(f, x, y)
        if !same_pixel(got, want) {
            t.fatal("{name}: pixel {x},{y} = {pixel_text(got)}, want {pixel_text(want)}")
        }
    }
}

fn test_instance_buffer_growth(t: *testing.T) {
    let out = run_render(t, "growth")
    let counts = [10, 5000, 100, 5000]
    for i in 0..counts.len {
        let name = "quads{i}"
        let f = frame(t, out, name)
        check_growth_frame(t, name, f, counts[i])
    }

    let dots = frame(t, out, "sprites")
    check_growth_frame(t, "sprites", dots, 1500)

    let halos = frame(t, out, "shadows")
    for n in 0..240 {
        let x = n % 20 * 8 + 4
        let y = n / 20 * 8 + 4
        let body = at(halos, x, y).r
        if body > 100 {
            t.error("shadow {n} has no body: pixel {x},{y} is {body}")
        }
        let gap = at(halos, x - 4, y - 4).r
        if gap < 200 {
            t.error("shadow {n} spills into the gap: pixel {x - 4},{y - 4} is {gap}")
        }
    }
}

fn covered(coverage: []i64) -> []Pixel {
    var pixels: []Pixel = []
    for c in coverage {
        push(mut pixels, opaque(c, c, c))
    }
    pixels
}

fn check_atlas(t: *testing.T, out: Output, name: str, row: i64, x: i64, coverage: []i64) {
    let f = frame(t, out, name)
    let want = covered(coverage)
    for i in 0..want.len {
        expect(t, f, x + i, row, want[i], 1)
    }
}

fn test_atlas_updates(t: *testing.T) {
    let out = run_render(t, "atlas")
    let dark = [0, 0, 0, 0]
    let low = [10, 20, 30, 40]
    let high = [60, 120, 180, 240]
    let resized = [90, 91, 92, 93]

    check_atlas(t, out, "first", 2, 2, [255, 200, 100, 50])
    check_atlas(t, out, "first", 6, 2, dark)
    check_atlas(t, out, "rewritten", 2, 2, low)
    check_atlas(t, out, "rewritten", 6, 2, dark)
    check_atlas(t, out, "deep", 2, 2, low)
    check_atlas(t, out, "deep", 6, 2, high)
    check_atlas(t, out, "unchanged", 2, 2, low)
    check_atlas(t, out, "unchanged", 6, 2, high)
    check_atlas(t, out, "cleared", 2, 2, dark)
    check_atlas(t, out, "cleared", 6, 2, dark)
    check_atlas(t, out, "resized", 2, 2, resized)
    check_atlas(t, out, "resized", 6, 2, dark)
    check_atlas(t, out, "resized_again", 2, 2, resized)

    let want = ["dirty false", "dirty true 0 1", "dirty true 900 901"]
    if out.lines.len != want.len {
        let got_text = text.join(out.lines, "|")
        let want_text = text.join(want, "|")
        t.fatal("lines = {got_text}, want {want_text}")
    }
    for i in 0..want.len {
        if out.lines[i] != want[i] {
            t.error("line {i} = {text.quote(out.lines[i])}, want {text.quote(want[i])}")
        }
    }
}
