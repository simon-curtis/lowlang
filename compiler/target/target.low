import diag
import std/slices
import std/text

pub enum OS {
    Linux = 0
    Windows = 1
}

struct Descriptor {
    os: OS
    name: str
    suffix: str
    exe: str
}

fn targets() -> []Descriptor {
    [
        Descriptor { os: Linux, name: "linux/amd64", suffix: "_linux.low", exe: "" },
        Descriptor { os: Windows, name: "windows/amd64", suffix: "_windows.low", exe: ".exe" },
    ]
}

pub fn string(o: OS) -> str {
    entry(o).name
}

fn entry(o: OS) -> Descriptor {
    for t in targets() {
        if t.os == o {
            return t
        }
    }
    Descriptor { os: Linux, name: "", suffix: "", exe: "" }
}

pub fn executable(o: OS, name: str) -> str {
    "{name}{entry(o).exe}"
}

pub fn is_test(file: str) -> bool {
    var stem = text.trim_suffix(file, ".low")
    for t in targets() {
        if text.ends_with(file, t.suffix) {
            stem = text.trim_suffix(file, t.suffix)
        }
    }
    text.ends_with(stem, "_test")
}

pub fn builds(o: OS, file: str) -> bool {
    !targets().any(fn(t) t.os != o && text.ends_with(file, t.suffix))
}

pub fn system(o: OS) -> str {
    let cut = text.cut(string(o), "/")
    cut.before
}

pub fn all() -> []OS {
    var out: []OS = []
    for t in targets() {
        push(mut out, t.os)
    }
    out
}

pub fn names() -> []str {
    var out: []str = []
    for t in targets() {
        push(mut out, t.name)
    }
    out
}

pub fn choices() -> str {
    text.join(names(), "|")
}

pub enum ParseError {
    Unknown(name: str)
}

pub fn message(e: ParseError) -> str {
    match e {
        Unknown(name) => "unknown target {diag.quote(name)}; expected {text.join(names(), " or ")}"
    }
}

pub fn parse(name: str) -> OS ! ParseError {
    for t in targets() {
        if t.name == name {
            return t.os
        }
    }
    fail Unknown(name)
}
