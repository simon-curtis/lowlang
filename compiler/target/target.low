import diag
import std/text

pub enum OS {
    Linux = 0
    Windows = 1
    Browser = 2
}

pub enum Arch {
    Amd64 = 0
    Wasm32 = 1
}

struct Descriptor {
    os: OS
    arch: Arch
    name: str
    suffix: str
    exe: str
}

fn targets() -> []Descriptor {
    [
        Descriptor { os: Linux, arch: Amd64, name: "linux/amd64", suffix: "_linux.low", exe: "" },
        Descriptor { os: Windows, arch: Amd64, name: "windows/amd64", suffix: "_windows.low", exe: ".exe" },
        Descriptor { os: Browser, arch: Wasm32, name: "browser/wasm32", suffix: "_browser.low", exe: ".wasm" },
    ]
}

fn arch_suffix(a: Arch) -> str {
    match a {
        Amd64 => "_amd64.low"
        Wasm32 => "_wasm32.low"
    }
}

fn arches() -> []Arch {
    [Amd64, Wasm32]
}

pub fn string(o: OS) -> str {
    entry(o).name
}

fn entry(o: OS) -> Descriptor {
    for t in targets() {
        if t.os == o {
            return t
        }
    }
    Descriptor { os: Linux, arch: Amd64, name: "", suffix: "", exe: "" }
}

pub fn arch(o: OS) -> Arch {
    entry(o).arch
}

pub fn native(o: OS) -> bool {
    arch(o) == Amd64
}

pub fn executable(o: OS, name: str) -> str {
    "{name}{entry(o).exe}"
}

pub fn builds(o: OS, file: str) -> bool {
    for t in targets() {
        if t.os != o && text.ends_with(file, t.suffix) {
            return false
        }
    }
    let own = arch(o)
    for a in arches() {
        if a != own && text.ends_with(file, arch_suffix(a)) {
            return false
        }
    }
    true
}

pub fn system(o: OS) -> str {
    let cut = text.cut(string(o), "/")
    cut.before
}

pub fn all() -> []OS {
    var out: []OS = []
    for t in targets() {
        push(mut out, t.os)
    }
    out
}

pub fn natives() -> []OS {
    var out: []OS = []
    for t in targets() {
        if native(t.os) {
            push(mut out, t.os)
        }
    }
    out
}

pub fn names() -> []str {
    var out: []str = []
    for t in targets() {
        push(mut out, t.name)
    }
    out
}

pub fn choices() -> str {
    text.join(names(), "|")
}

pub enum ParseError {
    Unknown(name: str)
}

pub fn message(e: ParseError) -> str {
    match e {
        Unknown(name) => "unknown target {diag.quote(name)}; expected {text.join(names(), " or ")}"
    }
}

pub fn parse(name: str) -> OS ! ParseError {
    for t in targets() {
        if t.name == name {
            return t.os
        }
    }
    fail Unknown(name)
}
