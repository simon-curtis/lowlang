import diag
import std/slices
import std/text

pub enum OS {
    Linux = 0
    Windows = 1
    Browser = 2
}

enum Arch {
    Amd64 = 0
    Wasm32 = 1
}

struct Descriptor {
    os: OS
    arch: Arch
    name: str
    suffix: str
    exe: str
    os_calls: bool
    syscalls: bool
}

fn targets() -> []Descriptor {
    [
        Descriptor { os: Linux, arch: Amd64, name: "linux/amd64", suffix: "_linux.low", exe: "", os_calls: true, syscalls: true },
        Descriptor { os: Windows, arch: Amd64, name: "windows/amd64", suffix: "_windows.low", exe: ".exe", os_calls: true, syscalls: false },
        Descriptor { os: Browser, arch: Wasm32, name: "browser/wasm32", suffix: "_browser.low", exe: ".wasm", os_calls: false, syscalls: false },
    ]
}

fn arch_suffix(a: Arch) -> str {
    match a {
        Amd64 => "_amd64.low"
        Wasm32 => "_wasm32.low"
    }
}

fn arches() -> []Arch {
    [Amd64, Wasm32]
}

pub fn string(o: OS) -> str {
    entry(o).name
}

fn entry(o: OS) -> Descriptor {
    for t in targets() {
        if t.os == o {
            return t
        }
    }
    Descriptor { os: Linux, arch: Amd64, name: "", suffix: "", exe: "", os_calls: false, syscalls: false }
}

fn arch(o: OS) -> Arch {
    entry(o).arch
}

pub fn has_os(o: OS) -> bool {
    entry(o).os_calls
}

pub fn has_syscalls(o: OS) -> bool {
    entry(o).syscalls
}

pub fn native(o: OS) -> bool {
    arch(o) == Amd64
}

pub fn executable(o: OS, name: str) -> str {
    "{name}{entry(o).exe}"
}

pub fn is_test(file: str) -> bool {
    var stem = text.trim_suffix(file, ".low")
    for t in targets() {
        if text.ends_with(file, t.suffix) {
            stem = text.trim_suffix(file, t.suffix)
        }
    }
    for a in arches() {
        if text.ends_with(file, arch_suffix(a)) {
            stem = text.trim_suffix(file, arch_suffix(a))
        }
    }
    text.ends_with(stem, "_test")
}

pub fn builds(o: OS, file: str) -> bool {
    let own = arch(o)
    let other_os = targets().any(fn(t) t.os != o && text.ends_with(file, t.suffix))
    let other_arch = arches().any(fn(a) a != own && text.ends_with(file, arch_suffix(a)))
    !other_os && !other_arch
}

pub fn system(o: OS) -> str {
    let cut = text.cut(string(o), "/")
    cut.before
}

pub fn all() -> []OS {
    var out: []OS = []
    for t in targets() {
        out.push(t.os)
    }
    out
}

pub fn natives() -> []OS {
    var out: []OS = []
    for t in targets() {
        if native(t.os) {
            out.push(t.os)
        }
    }
    out
}

pub fn names() -> []str {
    var out: []str = []
    for t in targets() {
        out.push(t.name)
    }
    out
}

pub enum ParseError {
    Unknown(name: str)
}

pub fn message(e: ParseError) -> str {
    match e {
        Unknown(name) => "unknown target {diag.quote(name)}; expected {text.join(names(), " or ")}"
    }
}

pub fn parse(name: str) -> OS ! ParseError {
    for t in targets() {
        if t.name == name {
            return t.os
        }
    }
    fail Unknown(name)
}
