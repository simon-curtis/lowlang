import amd64
import asm
import compiler
import link
import wasm

pub enum Error {
    Front(compiler.Error)
    Backend(amd64.Error)
    Assemble(asm.Error)
    Link(link.Error)
    Wasm(wasm.Error)
}

pub fn message(e: Error) -> str {
    match e {
        Front(inner) => compiler.message(inner)
        Backend(inner) => amd64.error_message(inner)
        Assemble(inner) => asm.message(inner)
        Link(inner) => link.message(inner)
        Wasm(inner) => wasm.message(inner)
    }
}

fn failed(msg: str) -> Error {
    let inner = compiler.Error.Failed(msg)
    Error.Front(inner)
}
