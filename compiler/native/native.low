import compiler
import ir
import parallel
import std/file
import std/io
import std/sys

pub fn runner() -> ir.Runner {
    ir.Runner { each: parallel.each }
}

pub fn disk() -> compiler.Disk {
    compiler.Disk { read: disk_read, stat: disk_stat, list: disk_list, cwd: disk_cwd }
}

pub fn overlay() -> *compiler.Overlay {
    let host = disk()
    compiler.new_overlay(host)
}

pub fn analyse(path: str, profile: compiler.Profile) -> *compiler.Unit ! Error {
    let docs = overlay()
    let jobs = runner()
    compiler.analyse(path, profile, docs, jobs) catch Front
}

fn disk_read(name: str) -> []u8 ! io.Error {
    file.read_file(name)?
}

fn disk_stat(name: str) -> compiler.Info ! io.Error {
    let info = file.stat(name)?
    compiler.Info { size: info.size, dir: info.dir, regular: info.regular }
}

fn disk_list(name: str) -> []compiler.Entry ! io.Error {
    let found = file.read_dir_info(name)?
    var entries: []compiler.Entry = []
    for entry in found {
        push(mut entries, compiler.Entry { name: entry.name, dir: entry.dir, link: entry.link, regular: entry.regular })
    }
    entries
}

fn disk_cwd() -> str ! io.Error {
    sys.getcwd()?
}
