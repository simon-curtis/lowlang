import compiler
import ir
import parallel
import target
import std/file
import std/io
import std/os
import std/process
import std/sys
import std/text
import std/time

pub fn runner() -> ir.Runner {
    ir.Runner { each: parallel.each }
}

pub fn disk() -> compiler.Disk {
    let windows = target.host() == target.OS.Windows
    compiler.Disk { read: disk_read, stat: disk_stat, list: disk_list, cwd: disk_cwd, drives: windows, cache: cache_root(windows), stamp: disk_stamp }
}

fn disk_stamp(root: str) -> compiler.Stamp {
    compiler.Stamp { revision: revision(root), time: build_time() }
}

fn revision(root: str) -> str {
    let command = process.command("git", ["-C", root, "rev-parse", "HEAD"])
    let out = process.run(command, []) or return ""
    if !process.success(out.status) {
        return ""
    }
    text.trim(str(out.stdout))
}

fn build_time() -> i64 {
    let epoch = os.env("SOURCE_DATE_EPOCH") ?? ""
    text.parse_int(epoch) or time.now()
}

fn cache_root(windows: bool) -> str {
    let explicit = os.env("LOW_CACHE") ?? ""
    if explicit != "" {
        return explicit
    }
    if windows {
        let local = os.env("LOCALAPPDATA") ?? ""
        if local == "" {
            return ""
        }
        return "{local}/low"
    }
    let xdg = os.env("XDG_CACHE_HOME") ?? ""
    if xdg != "" {
        return "{xdg}/low"
    }
    let home = os.env("HOME") ?? ""
    if home == "" {
        return ""
    }
    "{home}/.cache/low"
}

pub fn overlay() -> *compiler.Overlay {
    let host = disk()
    compiler.new_overlay(host, runner())
}

pub fn analyse(path: str, profile: compiler.Profile) -> *compiler.Unit ! Error {
    let docs = overlay()
    let jobs = runner()
    compiler.analyse(path, profile, docs, jobs) catch Front
}

pub fn analyse_flat(path: str, profile: compiler.Profile) -> *compiler.Unit ! Error {
    let docs = overlay()
    let unit = compiler.check(path, profile.platform, docs) catch Front
    compiler.lower_flat(unit, profile, runner())
    unit
}

pub fn analyse_tests(module_path: str, profile: compiler.Profile) -> *compiler.Unit ! Error {
    let docs = overlay()
    let jobs = runner()
    compiler.analyse_tests(module_path, profile, docs, jobs) catch Front
}

fn disk_read(name: str) -> []u8 ! io.Error {
    file.read_file(name)?
}

fn disk_stat(name: str) -> compiler.Info ! io.Error {
    let info = file.stat(name)?
    compiler.Info { size: info.size, dir: info.dir, regular: info.regular }
}

fn disk_list(name: str) -> []compiler.Entry ! io.Error {
    let found = file.read_dir_info(name)?
    var entries: []compiler.Entry = []
    for entry in found {
        entries.push(compiler.Entry { name: entry.name, dir: entry.dir, link: entry.link, regular: entry.regular })
    }
    entries
}

fn disk_cwd() -> str ! io.Error {
    sys.getcwd()?
}
