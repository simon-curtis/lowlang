import amd64
import asm
import compiler
import ir
import link
import target
import std/file
import std/io

pub struct Built {
    pub funcs: [str: str]
    pub symbols: [str: i64]
    pub table: *amd64.FuncTable?
}

struct Toolchain {
    assembler: asm.Options
    linker: fn(asm.Object, []str) -> link.Image ! Error
}

fn toolchain(p: amd64.Platform) -> Toolchain {
    match p {
        Sysv => Toolchain { assembler: asm.Options { align_branches: true }, linker: link_elf }
        Win64 => Toolchain { assembler: asm.Options { clang_layout: true }, linker: link_pe }
    }
}

fn platform_of(u: *compiler.Unit) -> amd64.Platform {
    amd64.new_platform(u.profile.platform)
}

pub fn assembler(platform: target.OS) -> asm.Options {
    toolchain(amd64.new_platform(platform)).assembler
}

pub fn unit_assembler(u: *compiler.Unit) -> asm.Options {
    let platform = platform_of(u)
    var options = toolchain(platform).assembler
    options.embeds = u.embeds
    options
}

fn native_unit(unit: *compiler.Unit) ! Error {
    let os = unit.profile.platform
    if !target.native(os) {
        fail failed("no back end for the {target.string(os)} target")
    }
}

fn new_table(u: *compiler.Unit) -> *amd64.FuncTable? {
    if !u.profile.hot {
        return none
    }
    let program = u.program ?? panic("unit without a program")
    amd64.new_func_table(program)
}

pub fn generate(unit: *compiler.Unit) -> amd64.Output ! Error {
    let table = new_table(unit)
    generate_with(unit, table)?
}

pub fn generate_with(unit: *compiler.Unit, table: *amd64.FuncTable?) -> amd64.Output ! Error {
    generate_unit(unit, table, false)?
}

fn generate_unit(unit: *compiler.Unit, table: *amd64.FuncTable?, release: bool) -> amd64.Output ! Error {
    native_unit(unit)?
    let program = unit.program ?? panic("unit without a program")
    let platform = platform_of(unit)
    amd64.generate(program, platform, table, release) catch Backend
}

pub fn build(unit: *compiler.Unit, output: str) -> Built ! Error {
    native_unit(unit)?
    let table = new_table(unit)
    let options = unit_assembler(unit)
    let platform = platform_of(unit)
    let chain = toolchain(platform)
    let program = unit.program ?? panic("unit without a program")
    let libraries = ir.libraries(program)
    let out = generate_unit(unit, table, table == none)?
    let funcs = out.funcs
    let object = asm.assemble(out.asm, options) catch Assemble
    let linker = chain.linker
    let image = linker(object, libraries)?
    write_executable(output, image.bytes)?
    Built { funcs, symbols: image.symbols, table }
}

pub fn patch(b: Built, unit: *compiler.Unit, table: *amd64.FuncTable, changed: []str, suffix: str, base: i64) -> link.PatchImage ! Error {
    let program = unit.program ?? panic("unit without a program")
    let platform = platform_of(unit)
    let source = amd64.generate_patch(program, platform, changed, table, suffix)
    let options = unit_assembler(unit)
    let object = asm.assemble(source, options) catch Assemble
    link.patch(object, base, b.symbols) catch Link
}

fn link_elf(object: asm.Object, libraries: []str) -> link.Image ! Error {
    if libraries.len == 0 {
        return link.static(object) catch Link
    }
    let resolver = link.Resolver { dirs: link.system_dirs() }
    let resolved = link.resolve(resolver, libraries) catch Link
    link.dynamic(object, resolved) catch Link
}

fn link_pe(object: asm.Object, libraries: []str) -> link.Image ! Error {
    let bytes = link.pe(object) catch Link
    link.Image { bytes }
}

fn write_executable(output: str, image: []u8) ! Error {
    remove_existing(output) catch {
        e => fail failed("replace {output}: remove {output}: {compiler.reason(e)}")
    }
    file.write_file_mode(output, image, 0o755) catch {
        e => fail failed("write {output}: open {output}: {compiler.reason(e)}")
    }
}

fn remove_existing(output: str) ! io.Error {
    file.remove(output) catch {
        NotFound => return
        IsDir => {
            file.remove_dir(output) catch {
                NotFound => return
                e => fail e
            }
        }
        e => fail e
    }
}
