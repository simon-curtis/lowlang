import amd64
import asm
import compiler
import ir
import link
import target
import wasm
import std/file
import std/io

pub struct Built {
    pub funcs: [str: str]
    pub symbols: [str: i64]
    pub table: *amd64.FuncTable?
}

struct Toolchain {
    assembler: asm.Options
    linker: fn(asm.Object, []str, compiler.Profile) -> link.Image ! Error
}

fn toolchain(p: amd64.Platform) -> Toolchain {
    match p {
        Sysv => Toolchain { assembler: asm.Options { align_branches: true }, linker: link_elf }
        Win64 => Toolchain { assembler: asm.Options { clang_layout: true }, linker: link_pe }
    }
}

fn platform_of(u: *compiler.Unit) -> amd64.Platform {
    amd64.new_platform(u.profile.platform)
}

pub fn assembler(platform: target.OS) -> asm.Options {
    toolchain(amd64.new_platform(platform)).assembler
}

fn unit_assembler(u: *compiler.Unit) -> asm.Options {
    var options = toolchain(platform_of(u)).assembler
    options.independent_chunks = true
    options.embeds = compiler.held_embeds(u)
    options.digests = compiler.embed_digests(u)
    options
}

fn native_unit(unit: *compiler.Unit) ! Error {
    let os = unit.profile.platform
    if !target.native(os) {
        fail failed("no assembly for the {target.string(os)} target")
    }
}

fn new_table(u: *compiler.Unit) -> *amd64.FuncTable? {
    if !u.profile.hot {
        return none
    }
    let program = u.program ?? panic("unit without a program")
    amd64.new_func_table(program)
}

pub fn generate(unit: *compiler.Unit) -> amd64.Output ! Error {
    let table = new_table(unit)
    generate_with(unit, table)?
}

pub fn generate_with(unit: *compiler.Unit, table: *amd64.FuncTable?) -> amd64.Output ! Error {
    generate_unit(unit, table, false)?
}

fn generate_unit(unit: *compiler.Unit, table: *amd64.FuncTable?, release: bool) -> amd64.Output ! Error {
    native_unit(unit)?
    let program = unit.program ?? panic("unit without a program")
    let platform = platform_of(unit)
    amd64.generate(program, platform, table, release, unit.jobs)
}

struct Assembly {
    object: asm.Object
    funcs: [str: str]
}

fn assemble_text(unit: *compiler.Unit, table: *amd64.FuncTable?, release: bool) -> Assembly ! Error {
    let options = unit_assembler(unit)
    let out = generate_unit(unit, table, release)?
    ir.mark(unit.jobs, "assemble")
    let object = asm.assemble(out.asm, options) catch Assemble
    Assembly { object, funcs: out.funcs }
}

fn assemble_chunks(unit: *compiler.Unit) -> Assembly ! Error {
    native_unit(unit)?
    let options = unit_assembler(unit)
    let program = unit.program ?? panic("unit without a program")
    let platform = platform_of(unit)
    let environment = amd64.environment(program, platform, none)
    let env = asm.new_env(environment, options) catch Assemble
    let pieces = amd64.generate_pieces(program, platform, env, unit.jobs) catch Assemble
    ir.mark(unit.jobs, "layout")
    let object = asm.assemble_pieces(env, pieces) catch Assemble
    Assembly { object, funcs: [:] }
}

fn link_assembly(unit: *compiler.Unit, assembly: Assembly) -> link.Image ! Error {
    let program = unit.program ?? panic("unit without a program")
    let chain = toolchain(platform_of(unit))
    let libraries = ir.libraries(program)
    ir.mark(unit.jobs, "link")
    let linker = chain.linker
    linker(assembly.object, libraries, unit.profile)?
}

pub fn link_text_image(unit: *compiler.Unit) -> link.Image ! Error {
    let assembly = assemble_text(unit, none, false)?
    link_assembly(unit, assembly)?
}

pub fn link_chunk_image(unit: *compiler.Unit) -> link.Image ! Error {
    let assembly = assemble_chunks(unit)?
    link_assembly(unit, assembly)?
}

pub fn build(unit: *compiler.Unit, output: str) -> Built ! Error {
    if !target.native(unit.profile.platform) {
        return build_wasm(unit, output)?
    }
    let table = new_table(unit)
    var assembly = Assembly { object: asm.Object {}, funcs: [:] }
    if table == none {
        assembly = assemble_chunks(unit)?
    } else {
        assembly = assemble_text(unit, table, false)?
    }
    let image = link_assembly(unit, assembly)?
    ir.mark(unit.jobs, "write")
    write_executable(output, image.bytes)?
    Built { funcs: assembly.funcs, symbols: image.symbols, table }
}

pub fn module(unit: *compiler.Unit) -> []u8 ! Error {
    let program = unit.program ?? panic("unit without a program")
    let files = compiler.embeds(unit) catch Front
    wasm.generate(program, files) catch Wasm
}

fn build_wasm(unit: *compiler.Unit, output: str) -> Built ! Error {
    ir.mark(unit.jobs, "wasm")
    let image = module(unit)?
    ir.mark(unit.jobs, "write")
    write_executable(output, image)?
    Built { funcs: [:], symbols: [:], table: none }
}

pub fn patch(b: Built, unit: *compiler.Unit, table: *amd64.FuncTable, changed: []str, suffix: str, base: i64) -> link.PatchImage ! Error {
    let program = unit.program ?? panic("unit without a program")
    let platform = platform_of(unit)
    let source = amd64.generate_patch(program, platform, changed, table, suffix)
    let options = unit_assembler(unit)
    let object = asm.assemble(source, options) catch Assemble
    link.patch(object, base, b.symbols) catch Link
}

fn link_elf(object: asm.Object, libraries: []str, profile: compiler.Profile) -> link.Image ! Error {
    if libraries.len == 0 {
        return link.static(object) catch Link
    }
    let resolver = link.Resolver { dirs: link.system_dirs() }
    let resolved = link.resolve(resolver, libraries) catch Link
    link.dynamic(object, resolved) catch Link
}

fn link_pe(object: asm.Object, libraries: []str, profile: compiler.Profile) -> link.Image ! Error {
    if profile.hot {
        return link.pe_fixed(object) catch Link
    }
    if profile.symbols {
        return link.pe_symbols(object, profile.gui) catch Link
    }
    let bytes = link.pe(object, profile.gui) catch Link
    link.Image { bytes }
}

fn write_executable(output: str, image: []u8) ! Error {
    remove_existing(output) catch {
        e => fail failed("replace {output}: remove {output}: {compiler.reason(e)}")
    }
    file.write_file_mode(output, image, 0o755) catch {
        e => fail failed("write {output}: open {output}: {compiler.reason(e)}")
    }
}

fn remove_existing(output: str) ! io.Error {
    file.remove(output) catch {
        NotFound => return
        IsDir => {
            file.remove_dir(output) catch {
                NotFound => return
                e => fail e
            }
        }
        e => fail e
    }
}
