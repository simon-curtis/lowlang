import ast
import ir
import types
import std/builder

pub fn layout(files: []*ast.File) -> str {
    var b = builder.builder()
    for file in files {
        for d in file.enums {
            describe_enum(mut b, types.must(d.type))
        }
        for d in file.structs {
            describe_struct(mut b, types.must(d.type))
        }
    }
    b.to_str()
}

fn describe_enum(mut b: builder.Builder, t: *types.Type) {
    b.write("enum {t.name} {types.size(t)}")
    for v in t.variants {
        b.write(" {v.name}={v.tag}")
        for i, f in v.fields {
            b.write(" {types.text(f)}@{offset_of(v, i)}")
        }
    }
    b.write(";")
}

fn offset_of(v: *types.Variant, field: i64) -> i64 {
    if field < v.offsets.len {
        return v.offsets[field]
    }
    -1
}

fn describe_struct(mut b: builder.Builder, t: *types.Type) {
    b.write("struct {t.name} {types.size(t)}")
    for f in t.fields {
        b.write(" {f.name}:{types.text(f.type)}@{f.bytes}")
    }
    b.write(";")
}

pub fn signatures(prog: *ir.Program) -> [str: str] {
    var out: [str: str] = [:]
    for f in prog.funcs {
        var b = builder.builder()
        for p in f.params {
            b.write("{p.mutable} {types.text(p.type)},")
        }
        b.write("-> {types.text(f.ret)}")
        for c in f.captures {
            b.write(" {types.text(c.type)} {c.boxed}")
        }
        out[f.name] = b.to_str()
    }
    out
}
