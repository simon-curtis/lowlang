import amd64
import std/cancel
import std/file
import std/io
import std/os/signal
import std/process
import std/sys
import std/text

struct Memory {
    handle: sys.FdHandle
}

fn close_memory(m: Memory) {
    sys.close_on(m.handle)
}

const binary_suffix = ""

fn open_memory(s: *Session, child: *Child, token: *cancel.Token) -> Memory ! Error {
    let pid = child.handle.pid
    wait_for_hot_region(token, pid, s.base)?
    let memory_path = "/proc/{pid}/mem"
    let opened = sys.open(memory_path, sys.Open.ReadWrite, 0) catch {
        e => fail Failed("open {memory_path}: {e}")
    }
    Memory { handle: opened }
}

fn write_memory(m: Memory, data: []u8, address: i64) ! io.Error {
    sys.seek(m.handle.fd, address, sys.Seek.FromStart)?
    sys.write_all_on(m.handle, data)?
}

fn read_memory(m: Memory, data: []u8, address: i64) ! io.Error {
    sys.seek(m.handle.fd, address, sys.Seek.FromStart)?
    let n = sys.read_on(m.handle, data)?
    if n != data.len {
        fail Eof
    }
}

fn notify(s: *Session, child: *Child, memory: Memory) ! Error {
    let number = signal.from_number(amd64.patch_signal) ?? panic("patch signal")
    process.kill_on(child.handle, number) catch {
        e => fail Failed("signal the program: {e}")
    }
}

fn redraw(child: *Child) {
}

fn wait_for_hot_region(token: *cancel.Token, pid: i64, base: i64) ! Error {
    let region = "{text.hex(base)}-"
    let mapped = fn() -> bool ! Error {
        let maps = file.read_text("/proc/{pid}/maps") catch {
            e => fail Failed("read /proc/{pid}/maps: {e}")
        }
        text.contains(maps, region)
    }
    poll(token, mapped)?
}
