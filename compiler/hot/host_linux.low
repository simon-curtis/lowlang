import amd64
import std/os/signal
import std/process

fn check_host() ! Error {
}

fn notify(handle: *process.ChildHandle) ! Error {
    let number = signal.from_number(amd64.patch_signal) ?? panic("patch signal")
    process.kill_on(handle, number) catch {
        e => fail Failed("signal the program: {e}")
    }
}
