import std/slices
import std/text

pub const eq = 1
pub const ord = 2
pub const hash = 4
pub const number = 8
pub const integer = 16
pub const float = 32
pub const vector = 64

struct ConstraintEntry {
    name: str
    bit: i64
    bits: i64
    holds: fn(*Type) -> bool
}

fn constraints() -> []ConstraintEntry {
    [
        ConstraintEntry { name: "Eq", bit: eq, bits: eq, holds: comparable },
        ConstraintEntry { name: "Ord", bit: ord, bits: ord | eq, holds: ordered },
        ConstraintEntry { name: "Hash", bit: hash, bits: hash | eq, holds: hashable },
        ConstraintEntry { name: "Number", bit: number, bits: number | ord | eq, holds: is_number },
        ConstraintEntry { name: "Integer", bit: integer, bits: integer | number | ord | eq | hash, holds: is_integer },
        ConstraintEntry { name: "Float", bit: float, bits: float | number | ord | eq, holds: is_float },
        ConstraintEntry { name: "Vector", bit: vector, bits: vector, holds: fn(t: *Type) -> bool { t.kind == VectorKind } },
    ]
}

pub fn parse_constraint(name: str) -> i64? {
    for c in constraints() {
        if c.name == name {
            return c.bits
        }
    }
    none
}

pub fn constraint_names() -> []str {
    var names: []str = []
    for c in constraints() {
        push(mut names, c.name)
    }
    names
}

fn has(t: *Type, c: i64) -> bool {
    t.kind == ParamKind && t.constraint & c != 0
}

pub fn satisfies(t: *Type, c: i64) -> bool {
    for k in constraints() {
        let holds = k.holds
        if c & k.bit != 0 && !holds(t) {
            return false
        }
    }
    true
}

pub fn comparable(t: *Type) -> bool {
    match t.kind {
        BoolKind => true
        StrKind => true
        PointerKind => true
        RawKind => true
        ChanKind => true
        StructKind => {
            t.fields.all(fn(f) f.type.comparable())
        }
        EnumKind => {
            for v in t.variants {
                for f in v.fields {
                    if !f.comparable() {
                        return false
                    }
                }
            }
            true
        }
        _ => t.is_number() || t.has(eq)
    }
}

pub fn ordered(t: *Type) -> bool {
    t.is_number() || t.kind == StrKind || t.has(ord)
}

pub fn abstract(target: *Type?) -> bool {
    let t = target ?? return false
    if t.kind == ParamKind {
        return true
    }
    if abstract(t.elem) || abstract(t.key) || abstract(t.ret) || abstract(t.ok) || abstract(t.err) {
        return true
    }
    for p in t.params {
        if abstract(p) {
            return true
        }
    }
    t.type_args.any(fn(p) abstract(p))
}

pub fn instance_name(base: str, args: []*Type) -> str {
    var names: []str = []
    for a in args {
        push(mut names, a.text())
    }
    "{base}[{text.join(names, ", ")}]"
}
