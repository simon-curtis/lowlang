fn new_vectors(u: *Universe) -> []*Type {
    var out: []*Type = []
    for lane in [u.u8, u.u16, u.i32, u.u32, u.i64, u.u64, u.f32, u.f64] {
        for bits in [128, 256] {
            let lanes = bits / lane.bits
            let t = u.adopt(Type { kind: VectorKind, name: "{lane.name}x{lanes}", elem: lane, bits, lanes, words: bits / 64 })
            push(mut out, t)
        }
    }
    out
}

pub fn lane_bytes(t: *Type) -> i64 {
    t.elem_of().bits / 8
}

pub fn vector_bytes(t: *Type) -> i64 {
    t.bits / 8
}
