import std/slices
import std/text

pub enum Kind {
    VoidKind
    NeverKind
    IntKind
    FloatKind
    BoolKind
    StrKind
    EnumKind
    StructKind
    ResultKind
    PointerKind
    SliceKind
    MapKind
    RawKind
    FuncKind
    ParamKind
    ChanKind
    VectorKind
}

pub struct Type {
    pub id: i64 = 0
    pub kind: Kind
    pub name: str = ""
    pub variants: []*Variant = []
    pub fields: []*Field = []
    pub elem: *Type? = none
    pub key: *Type? = none
    pub params: []*Type = []
    pub muts: []bool = []
    pub ret: *Type? = none
    pub ok: *Type? = none
    pub err: *Type? = none
    pub bits: i64 = 0
    pub signed: bool = false
    pub optional: bool = false
    pub indexed: bool = false
    pub module: str = ""
    pub exported: bool = false
    pub c: bool = false
    pub bytes: i64 = 0
    pub align: i64 = 0
    pub constraint: i64 = 0
    pub origin: *Type? = none
    pub lanes: i64 = 0
    pub type_args: []*Type = []
    words: i64 = 0
}

pub struct Field {
    pub name: str
    pub bytes: i64 = 0
    pub exported: bool = false
    pub type: *Type
}

pub fn word(f: *Field) -> i64 {
    f.bytes / 8
}

pub struct Variant {
    pub name: str
    pub tag: i64 = 0
    pub index: i64 = 0
    pub fields: []*Type = []
    pub labels: []str = []
    pub offsets: []i64 = []
}

pub fn must(t: *Type?) -> *Type {
    t ?? panic("missing type")
}

pub fn elem_of(t: *Type) -> *Type {
    t.elem ?? panic("{t.name} has no element type")
}

pub fn key_of(t: *Type) -> *Type {
    t.key ?? panic("{t.name} has no key type")
}

pub fn ret_of(t: *Type) -> *Type {
    t.ret ?? panic("{t.name} has no return type")
}

pub fn ok_of(t: *Type) -> *Type {
    t.ok ?? panic("a type that is not a result has no ok type")
}

pub fn err_of(t: *Type) -> *Type {
    t.err ?? panic("a type that is not a result has no error type")
}

pub fn is_void(t: *Type) -> bool {
    t.kind == VoidKind
}

pub fn is_never(t: *Type) -> bool {
    t.kind == NeverKind
}

pub fn is_str(t: *Type) -> bool {
    t.kind == StrKind
}

fn flags(n: i64) -> []bool {
    var words: []bool = []
    for _ in 0..n {
        push(mut words, false)
    }
    words
}

fn counts(n: i64) -> []i64 {
    var words: []i64 = []
    for _ in 0..n {
        push(mut words, 0)
    }
    words
}

pub fn has_pointers(t: *Type) -> bool {
    t.pointer_words().contains(true)
}

pub fn pointer_words(t: *Type) -> []bool {
    let words = flags(t.words)
    match t.kind {
        PointerKind => { words[0] = true }
        MapKind => { words[0] = true }
        SliceKind => { words[0] = true }
        StrKind => { words[0] = true }
        RawKind => { words[0] = true }
        ParamKind => { words[0] = true }
        ChanKind => { words[0] = true }
        FuncKind => { words[words.len - 1] = !t.c }
        StructKind => {
            for f in t.fields {
                if t.c {
                    merge(words[f.word()..], f.type.pointer_words())
                    continue
                }
                copy_flags(words[f.word()..], f.type.pointer_words())
            }
        }
        EnumKind => {
            for v in t.variants {
                for i, f in v.fields {
                    merge(words[v.offsets[i]..], f.pointer_words())
                }
            }
        }
        ResultKind => {
            merge(words[1..], t.ok_of().pointer_words())
            merge(words[1..], t.err_of().pointer_words())
        }
        _ => {}
    }
    words
}

pub fn float_words(t: *Type) -> []i64 {
    let words = counts(t.words)
    match t.kind {
        FloatKind => { words[0] = t.bits }
        StructKind => {
            if t.c {
                return words
            }
            for f in t.fields {
                let from = f.type.float_words()
                let into = words[f.word()..]
                for i, bits in from {
                    into[i] = bits
                }
            }
        }
        _ => {}
    }
    words
}

fn copy_flags(into: []bool, from: []bool) {
    for i, p in from {
        into[i] = p
    }
}

fn merge(into: []bool, from: []bool) {
    for i, p in from {
        into[i] = into[i] || p
    }
}

pub fn is_integer(t: *Type) -> bool {
    t.kind == IntKind || t.has(integer)
}

pub fn is_float(t: *Type) -> bool {
    t.kind == FloatKind || t.has(float)
}

pub fn is_number(t: *Type) -> bool {
    t.is_integer() || t.is_float() || t.has(number)
}

pub fn holds(t: *Type, n: i64) -> bool {
    if t.bits == 64 || t.kind == ParamKind {
        return t.signed || n >= 0
    }
    let range = t.bounds()
    n >= range.low && n <= range.high
}

pub fn wrap(target: *Type?, n: i64) -> i64 {
    let t = target ?? return n
    if t.bits == 0 || t.bits >= 64 {
        return n
    }
    let shift = 64 - t.bits
    if t.signed {
        return n << shift >> shift
    }
    i64(u64(n) << shift >> shift)
}

pub struct Bounds {
    pub low: i64
    pub high: i64
}

pub fn bounds(t: *Type) -> Bounds {
    if t.signed {
        let limit = 1 << (t.bits - 1)
        return Bounds { low: -limit, high: limit - 1 }
    }
    Bounds { low: 0, high: (1 << t.bits) - 1 }
}

fn new_pointer(elem: *Type) -> Type {
    Type { kind: PointerKind, name: "*{elem.text()}", elem, words: 1 }
}

fn new_optional(elem: *Type) -> Type {
    let none_variant = new(Variant { name: "none", tag: 0 })
    let some_variant = new(Variant { name: "some", tag: 1, fields: [elem] })
    Type { kind: EnumKind, name: "{elem.text()}?", optional: true, elem, variants: [none_variant, some_variant], words: -1 }
}

pub fn accepts(t: *Type, from: *Type) -> bool {
    if t.kind == RawKind && from.kind == RawKind && (t.elem == none || from.elem == none) {
        return true
    }
    t == from || from.kind == NeverKind || (t.optional && t.elem == from)
}

fn new_chan(elem: *Type) -> Type {
    Type { kind: ChanKind, name: "chan[{elem.text()}]", elem, words: 1 }
}

fn new_map(key: *Type, value: *Type) -> Type {
    Type { kind: MapKind, name: "[{key.text()}: {value.text()}]", key, elem: value, words: 1 }
}

pub fn hashable(t: *Type) -> bool {
    t.is_integer() || t.kind == BoolKind || t.kind == StrKind || t.kind == PointerKind || t.has(hash)
}

pub fn struct_of(t: *Type) -> *Type {
    if t.kind == PointerKind {
        return t.elem_of()
    }
    t
}

pub fn param_text(p: *Type, mutable: bool) -> str {
    if mutable {
        return "mut {p.text()}"
    }
    p.text()
}

pub fn return_text(ret: *Type) -> str {
    if ret.kind == ResultKind && ret.ok_of().kind == VoidKind {
        return " {ret.text()}"
    }
    if ret.kind != VoidKind {
        return " -> {ret.text()}"
    }
    ""
}

fn new_func(params: []*Type, muts: []bool, ret: *Type, c: bool) -> Type {
    var texts: []str = []
    for i, p in params {
        push(mut texts, param_text(p, muts[i]))
    }
    let prefix = if c { "extern fn" } else { "fn" }
    let name = "{prefix}({text.join(texts, ", ")}){return_text(ret)}"
    Type { kind: FuncKind, name, params, muts, ret, c, words: if c { 1 } else { 2 } }
}

fn new_raw(elem: *Type?) -> Type {
    match elem {
        some(e) => Type { kind: RawKind, name: "ptr[{e.text()}]", elem, words: 1 }
        none => Type { kind: RawKind, name: "ptr", words: 1 }
    }
}

pub fn c_struct(t: *Type) -> bool {
    t.kind == StructKind && t.c
}

pub fn c_compatible(t: *Type) -> bool {
    match t.kind {
        IntKind => true
        FloatKind => true
        BoolKind => true
        RawKind => true
        StructKind => t.c
        FuncKind => t.c
        _ => false
    }
}

pub fn c_scalar(t: *Type) -> bool {
    t.c_compatible() && t.kind != StructKind
}

pub fn tail(t: *Type) -> i64 {
    if t.c_struct() {
        return t.bytes % 8
    }
    0
}

pub fn c_size(t: *Type) -> i64 {
    if t.kind == BoolKind {
        return 1
    }
    if t.c_struct() {
        return t.bytes
    }
    if t.packed() {
        return t.bits / 8
    }
    8
}

pub fn c_align(t: *Type) -> i64 {
    if t.c_struct() {
        return t.align
    }
    t.c_size()
}

fn new_slice(elem: *Type) -> Type {
    Type { kind: SliceKind, name: "[]{elem.text()}", elem, words: 3 }
}

pub fn packed(t: *Type) -> bool {
    (t.kind == IntKind || t.kind == FloatKind) && t.bits < 64
}

pub fn stride(t: *Type) -> i64 {
    if t.packed() {
        return t.bits / 8
    }
    if t.c_struct() {
        return t.bytes
    }
    8 * t.words
}

fn new_result(ok: *Type, err: *Type) -> Type {
    Type { kind: ResultKind, ok, err, words: -1 }
}

pub fn text(t: *Type) -> str {
    if t.kind != ResultKind {
        return t.name
    }
    if t.ok_of().kind == VoidKind {
        return "! {t.err_of().text()}"
    }
    "{t.ok_of().text()} ! {t.err_of().text()}"
}

pub fn size(t: *Type) -> i64 {
    t.words
}

pub fn scalar(t: *Type) -> bool {
    t.words == 1
}

pub fn field(t: *Type, name: str) -> *Field? {
    for f in t.fields {
        if f.name == name {
            return f
        }
    }
    none
}

pub fn variant(t: *Type, name: str) -> *Variant? {
    for v in t.variants {
        if v.name == name {
            return v
        }
    }
    none
}

pub enum LayoutError {
    Cycle(type: *Type)
}

pub fn message(e: LayoutError) -> str {
    match e {
        Cycle(t) => "{t.name} contains itself and has infinite size"
    }
}

pub fn layout(t: *Type) ! LayoutError {
    if t.kind == ResultKind {
        t.result_layout()?
        return
    }
    if (t.kind != EnumKind && t.kind != StructKind) || t.words > 0 {
        return
    }
    if t.words == 0 {
        fail Cycle(t)
    }
    t.words = 0
    if t.c_struct() {
        t.c_layout()?
        return
    }
    if t.kind == StructKind {
        t.struct_layout()?
        return
    }
    var payload = 0
    for v in t.variants {
        let words = v.variant_layout()?
        if words > payload {
            payload = words
        }
    }
    t.words = 1 + payload
}

fn result_layout(t: *Type) ! LayoutError {
    if t.words > 0 {
        return
    }
    let ok = t.ok_of()
    let err = t.err_of()
    ok.layout()?
    err.layout()?
    t.words = 1 + if ok.words > err.words { ok.words } else { err.words }
}

fn struct_layout(t: *Type) ! LayoutError {
    var words = 0
    for f in t.fields {
        f.type.layout()?
        f.bytes = 8 * words
        words += f.type.words
    }
    t.words = words
}

fn c_layout(t: *Type) ! LayoutError {
    var offset = 0
    var align = 1
    for f in t.fields {
        f.type.layout()?
        let a = f.type.c_align()
        offset = (offset + a - 1) / a * a
        f.bytes = offset
        offset += f.type.c_size()
        if a > align {
            align = a
        }
    }
    t.align = align
    t.bytes = (offset + align - 1) / align * align
    t.words = (t.bytes + 7) / 8
}

fn variant_layout(v: *Variant) -> i64 ! LayoutError {
    var words = 0
    v.offsets = counts(v.fields.len)
    for i, f in v.fields {
        f.layout()?
        v.offsets[i] = 1 + words
        words += f.words
    }
    words
}
