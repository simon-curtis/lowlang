import std/builder

pub struct BuiltinType {
    pub name: str
    pub type: *Type
}

pub struct Universe {
    created: fn(*Type)
    next_id: i64 = 1
    pub void: *Type
    pub never: *Type
    pub i64: *Type
    pub i32: *Type
    pub u64: *Type
    pub u32: *Type
    pub u16: *Type
    pub u8: *Type
    pub f64: *Type
    pub f32: *Type
    pub bool: *Type
    pub str: *Type
    pub numeric: []*Type
    pub vectors: []*Type = []
    builtin_types: []BuiltinType = []
    pointers: [*Type: *Type] = [:]
    slices: [*Type: *Type] = [:]
    optionals: [*Type: *Type] = [:]
    raws: [*Type: *Type] = [:]
    void_raw: *Type? = none
    chans: [*Type: *Type] = [:]
    maps: [i64: *Type] = [:]
    results: [i64: *Type] = [:]
    funcs: [str: *Type] = [:]
}

pub fn new_universe(created: fn(*Type)) -> *Universe {
    let void = new(Type { id: 1, kind: VoidKind, name: "void" })
    let never = new(Type { id: 2, kind: NeverKind, name: "never" })
    let i64 = new(Type { id: 3, kind: IntKind, name: "i64", bits: 64, signed: true, words: 1 })
    let i32 = new(Type { id: 4, kind: IntKind, name: "i32", bits: 32, signed: true, words: 1 })
    let u64 = new(Type { id: 5, kind: IntKind, name: "u64", bits: 64, words: 1 })
    let u32 = new(Type { id: 6, kind: IntKind, name: "u32", bits: 32, words: 1 })
    let u16 = new(Type { id: 7, kind: IntKind, name: "u16", bits: 16, words: 1 })
    let u8 = new(Type { id: 8, kind: IntKind, name: "u8", bits: 8, words: 1 })
    let f64 = new(Type { id: 9, kind: FloatKind, name: "f64", bits: 64, words: 1 })
    let f32 = new(Type { id: 10, kind: FloatKind, name: "f32", bits: 32, words: 1 })
    let bool = new(Type { id: 11, kind: BoolKind, name: "bool", words: 1 })
    let str = new(Type { id: 12, kind: StrKind, name: "str", words: 2 })
    let u = new(Universe {
        created, next_id: 13
        void, never, i64, i32, u64, u32, u16, u8, f64, f32, bool, str
        numeric: [i64, i32, u64, u32, u16, u8, f64, f32]
    })
    u.vectors = u.new_vectors()
    u.builtin_types = u.index_builtin_types()
    u
}

fn index_builtin_types(u: *Universe) -> []BuiltinType {
    var list: []BuiltinType = []
    for t in u.numeric {
        push(mut list, BuiltinType { name: t.name, type: t })
    }
    push(mut list, BuiltinType { name: u.bool.name, type: u.bool })
    push(mut list, BuiltinType { name: u.str.name, type: u.str })
    for t in u.vectors {
        push(mut list, BuiltinType { name: t.name, type: t })
    }
    list
}

pub fn builtin_types(u: *Universe) -> []BuiltinType {
    u.builtin_types
}

fn adopt(u: *Universe, built: Type) -> *Type {
    let t = new(built)
    t.id = u.next_id
    u.next_id += 1
    t
}

fn interned(u: *Universe, built: Type) -> *Type {
    let t = u.adopt(built)
    let created = u.created
    created(t)
    t
}

fn pair(a: *Type, b: *Type) -> i64 {
    a.id << 32 | b.id
}

pub fn new_enum(u: *Universe, name: str) -> *Type {
    u.adopt(Type { kind: EnumKind, name, words: -1 })
}

pub fn new_struct(u: *Universe, name: str) -> *Type {
    u.adopt(Type { kind: StructKind, name, words: -1 })
}

pub fn new_param(u: *Universe, name: str, c: i64) -> *Type {
    u.adopt(Type { kind: ParamKind, name, constraint: c, words: 1 })
}

pub fn width(u: *Universe, t: *Type) -> *Type? {
    if t.kind == BoolKind {
        return u.u8
    }
    if t.packed() {
        return t
    }
    none
}

pub fn pointer(u: *Universe, elem: *Type) -> *Type {
    match u.pointers[elem] {
        some(t) => t
        none => {
            let t = u.interned(new_pointer(elem))
            u.pointers[elem] = t
            t
        }
    }
}

pub fn slice(u: *Universe, elem: *Type) -> *Type {
    match u.slices[elem] {
        some(t) => t
        none => {
            let t = u.interned(new_slice(elem))
            u.slices[elem] = t
            t
        }
    }
}

pub fn optional(u: *Universe, elem: *Type) -> *Type {
    match u.optionals[elem] {
        some(t) => t
        none => {
            let t = u.interned(new_optional(elem))
            u.optionals[elem] = t
            t
        }
    }
}

pub fn raw(u: *Universe, elem: *Type?) -> *Type {
    match elem {
        some(e) => {
            match u.raws[e] {
                some(t) => t
                none => {
                    let t = u.interned(new_raw(elem))
                    u.raws[e] = t
                    t
                }
            }
        }
        none => {
            match u.void_raw {
                some(t) => t
                none => {
                    let t = u.interned(new_raw(none))
                    u.void_raw = t
                    t
                }
            }
        }
    }
}

pub fn channel(u: *Universe, elem: *Type) -> *Type {
    match u.chans[elem] {
        some(t) => t
        none => {
            let t = u.interned(new_chan(elem))
            u.chans[elem] = t
            t
        }
    }
}

pub fn map(u: *Universe, key: *Type, value: *Type) -> *Type {
    let at = pair(key, value)
    match u.maps[at] {
        some(t) => t
        none => {
            let t = u.interned(new_map(key, value))
            u.maps[at] = t
            t
        }
    }
}

pub fn result(u: *Universe, ok: *Type, err: *Type) -> *Type {
    let at = pair(ok, err)
    match u.results[at] {
        some(t) => t
        none => {
            let t = u.interned(new_result(ok, err))
            u.results[at] = t
            t
        }
    }
}

pub fn func(u: *Universe, params: []*Type, muts: []bool, ret: *Type, c: bool) -> *Type {
    var key = builder.builder()
    key.write("{c} {ret.id}")
    for i, p in params {
        key.write(" {muts[i]} {p.id}")
    }
    let at = key.to_str()
    match u.funcs[at] {
        some(t) => t
        none => {
            let t = u.interned(new_func(params, muts, ret, c))
            u.funcs[at] = t
            t
        }
    }
}
