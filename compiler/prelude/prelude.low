import ast

pub const append_str = "__append_str"
pub const append_quoted = "__append_quoted"
pub const append_hex = "__append_hex"
pub const append_bool = "__append_bool"
pub const append_u64 = "__append_u64"
pub const append_i64 = "__append_i64"
pub const append_f64 = "__append_f64"
pub const append_f32 = "__append_f32"
pub const append_decimal = "__append_decimal"
pub const append_radix = "__append_radix"
pub const append_int_layout = "__append_int_layout"
pub const append_float_layout = "__append_float_layout"
pub const align = "__align"
pub const str_cmp = "__str_cmp"
pub const min = "__min"
pub const utf8_decode = "__utf8_decode"
pub const bytes_func = "__bytes"
pub const cstr_func = "__cstr"
pub const from_cstr = "__from_cstr"
pub const from_bytes = "__from_bytes"
pub const hash_str = "__hash_str"
pub const hash_word = "__hash_word"
pub const map_new = "__map_new"
pub const map_clone = "__map_clone"
pub const map_len = "__map_len"
pub const map_get = "__map_get"
pub const map_set = "__map_set"
pub const map_delete = "__map_delete"
pub const map_next = "__map_next"
pub const map_key = "__map_key"
pub const map_value = "__map_value"
pub const chan_new = "__chan_new"
pub const chan_send = "__chan_send"
pub const chan_recv = "__chan_recv"
pub const chan_close = "__chan_close"
pub const box = "__box"
pub const sel_recv = "__sel_recv"
pub const sel_send = "__sel_send"
pub const sel_wait_recv = "__sel_wait_recv"
pub const sel_wait_send = "__sel_wait_send"
pub const sel_value = "__sel_value"
pub const waiter = "__waiter"
pub const wake = "__wake"
pub const waiter_index = "index"
pub const waiter_ok = "ok"
pub const chan_lock = "lock"
pub const probe_state = "state"
pub const probe_wake = "wake"
pub const box_value = "value"
const map_type_params = 2
const chan_type_params = 1

pub enum Role {
    Plain
    MapOp
    ChanOp
}

pub struct Entry {
    pub name: str
    pub role: Role
    pub params: i64
}

pub fn entries() -> []Entry {
    [
        Entry { name: append_str, role: Plain, params: 2 },
        Entry { name: append_quoted, role: Plain, params: 2 },
        Entry { name: append_hex, role: Plain, params: 2 },
        Entry { name: append_bool, role: Plain, params: 2 },
        Entry { name: append_u64, role: Plain, params: 2 },
        Entry { name: append_i64, role: Plain, params: 2 },
        Entry { name: append_f64, role: Plain, params: 2 },
        Entry { name: append_f32, role: Plain, params: 2 },
        Entry { name: append_decimal, role: Plain, params: 4 },
        Entry { name: append_radix, role: Plain, params: 6 },
        Entry { name: append_int_layout, role: Plain, params: 8 },
        Entry { name: append_float_layout, role: Plain, params: 7 },
        Entry { name: align, role: Plain, params: 3 },
        Entry { name: str_cmp, role: Plain, params: 2 },
        Entry { name: min, role: Plain, params: 2 },
        Entry { name: utf8_decode, role: Plain, params: 2 },
        Entry { name: bytes_func, role: Plain, params: 1 },
        Entry { name: cstr_func, role: Plain, params: 1 },
        Entry { name: from_cstr, role: Plain, params: 1 },
        Entry { name: from_bytes, role: Plain, params: 1 },
        Entry { name: hash_str, role: Plain, params: 1 },
        Entry { name: hash_word, role: Plain, params: 1 },
        Entry { name: waiter, role: Plain, params: 0 },
        Entry { name: wake, role: Plain, params: 1 },
        Entry { name: map_new, role: MapOp, params: 0 },
        Entry { name: map_clone, role: MapOp, params: 1 },
        Entry { name: map_len, role: MapOp, params: 1 },
        Entry { name: map_get, role: MapOp, params: 2 },
        Entry { name: map_set, role: MapOp, params: 3 },
        Entry { name: map_delete, role: MapOp, params: 2 },
        Entry { name: map_next, role: MapOp, params: 2 },
        Entry { name: map_key, role: MapOp, params: 2 },
        Entry { name: map_value, role: MapOp, params: 2 },
        Entry { name: chan_new, role: ChanOp, params: 1 },
        Entry { name: chan_send, role: ChanOp, params: 2 },
        Entry { name: chan_recv, role: ChanOp, params: 1 },
        Entry { name: chan_close, role: ChanOp, params: 1 },
        Entry { name: sel_recv, role: ChanOp, params: 2 },
        Entry { name: sel_send, role: ChanOp, params: 2 },
        Entry { name: sel_wait_recv, role: ChanOp, params: 4 },
        Entry { name: sel_wait_send, role: ChanOp, params: 4 },
        Entry { name: sel_value, role: ChanOp, params: 2 },
    ]
}

pub struct Layout {
    pub func: str
    pub field: str
    pub first: bool
}

pub fn layouts() -> []Layout {
    [
        Layout { func: waiter, field: waiter_index, first: false },
        Layout { func: waiter, field: waiter_ok, first: false },
        Layout { func: chan_new, field: chan_lock, first: false },
        Layout { func: sel_recv, field: probe_state, first: false },
        Layout { func: sel_recv, field: probe_wake, first: false },
        Layout { func: sel_send, field: probe_state, first: false },
        Layout { func: sel_send, field: probe_wake, first: false },
        Layout { func: box, field: box_value, first: true },
    ]
}

pub fn instances(role: Role) -> []str {
    var names: []str = []
    for e in entries() {
        if e.role == role {
            push(mut names, e.name)
        }
    }
    names
}

fn type_params(role: Role) -> i64 {
    match role {
        MapOp => map_type_params
        ChanOp => chan_type_params
        Plain => 0
    }
}

pub enum Error {
    Invalid(msg: str)
}

pub fn message(e: Error) -> str {
    match e {
        Invalid(msg) => msg
    }
}

pub fn validate(file: *ast.File) ! Error {
    var funcs: [str: *ast.Func] = [:]
    for f in file.funcs {
        funcs[f.name] = f
    }
    var structs: [str: *ast.StructDecl] = [:]
    for s in file.structs {
        structs[s.name] = s
    }
    for e in entries() {
        let f = funcs[e.name] ?? fail Invalid("prelude: the compiler calls {e.name} but the prelude does not declare it")
        let want = type_params(e.role)
        if f.type_params.len != want {
            fail Invalid("prelude: {e.name} takes {f.type_params.len} type parameters, the compiler instantiates it with {want}")
        }
        if f.params.len != e.params {
            fail Invalid("prelude: {e.name} takes {f.params.len} parameters, the compiler passes {e.params}")
        }
    }
    for l in layouts() {
        validate_layout(l, funcs, structs)?
    }
}

fn validate_layout(l: Layout, funcs: [str: *ast.Func], structs: [str: *ast.StructDecl]) ! Error {
    let f = funcs[l.func] ?? fail Invalid("prelude: the compiler reads {l.field} from the result of {l.func} but the prelude does not declare it")
    let result = f.result ?? fail Invalid("prelude: the compiler reads {l.field} from the result of {l.func} but it does not return a struct")
    if result.is_pointer && result.elem == none {
        fail Invalid("prelude: the compiler reads {l.field} from the result of {l.func} but it does not return a struct")
    }
    var name = result.name
    if result.is_pointer {
        let elem = result.elem ?? fail Invalid("prelude: the compiler reads {l.field} from the result of {l.func} but it does not return a struct")
        name = elem.name
    }
    let s = structs[name] ?? fail Invalid("prelude: {l.func} returns {name} but the prelude does not declare that struct")
    var at = -1
    for i, field in s.fields {
        if field.name == l.field {
            at = i
            break
        }
    }
    if at < 0 {
        fail Invalid("prelude: the compiler reads {name}.{l.field} from the result of {l.func} but the struct has no such field")
    }
    if l.first && at != 0 {
        fail Invalid("prelude: the compiler expects {name}.{l.field} to be the first field")
    }
}
