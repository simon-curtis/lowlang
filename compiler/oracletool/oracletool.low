import std/process
import std/slices
import std/testing
import std/text

pub const gnu = "2.47"
pub const llvm = "23.1.4"

const error_limit = 600

pub enum Error {
    Failed(message: str)
}

pub fn message(e: Error) -> str {
    match e {
        Failed(text) => text
    }
}

pub fn require(t: *testing.T, tool: str, version: str) {
    let command = process.command(tool, ["--version"])
    let output = process.run(command, []) catch {
        e => {
            t.skip("{tool} is not available: {e}")
            return
        }
    }
    if !process.success(output.status) {
        t.skip("{tool} is not available: {output.status}")
        return
    }
    let report = str(output.stdout)
    let first = text.cut(report, "\n").before
    let fields = text.fields(first)
    if !slices.contains(fields, version) {
        let quoted = text.quote(first)
        t.skip("the {tool} oracle is pinned to version {version}; found {quoted}")
    }
}

pub fn truncate(report: str) -> str {
    if report.len <= error_limit {
        return report
    }
    report[..error_limit]
}

pub fn run_tool(program: str, args: []str) ! Error {
    let command = process.command(program, args)
    let output = process.run(command, []) catch {
        e => fail Failed("{program}: {e}")
    }
    if !process.success(output.status) {
        let stdout = str(output.stdout)
        let stderr = str(output.stderr)
        let combined = "{stdout}{stderr}"
        let shown = truncate(combined)
        fail Failed("{program}: {output.status}\n{shown}")
    }
}
