import std/io

pub const pe_machine_amd64 = 0x8664
pub const pe_subsystem_windows_cui = 3

pub const pe_dir_import = 1
pub const pe_dir_base_reloc = 5
pub const pe_dir_debug = 6
pub const pe_dir_iat = 12

const coff_header_size = 20
const coff_section_size = 40
const optional_header_64_magic = 0x20b
const data_directory_count = 16

pub struct PeSection {
    pub name: str
    pub virtual_size: i64 = 0
    pub virtual_address: i64 = 0
    pub size: i64 = 0
    pub offset: i64 = 0
    pub relocations_offset: i64 = 0
    pub line_numbers_offset: i64 = 0
    pub relocation_count: i64 = 0
    pub line_number_count: i64 = 0
    pub characteristics: i64 = 0
}

pub struct PeDirectory {
    pub virtual_address: i64 = 0
    pub size: i64 = 0
}

pub struct PeOptionalHeader {
    pub major_linker_version: i64 = 0
    pub address_of_entry_point: i64 = 0
    pub base_of_code: i64 = 0
    pub image_base: i64 = 0
    pub section_alignment: i64 = 0
    pub file_alignment: i64 = 0
    pub major_operating_system_version: i64 = 0
    pub major_subsystem_version: i64 = 0
    pub size_of_image: i64 = 0
    pub size_of_headers: i64 = 0
    pub subsystem: i64 = 0
    pub dll_characteristics: i64 = 0
    pub size_of_stack_reserve: i64 = 0
    pub size_of_stack_commit: i64 = 0
    pub size_of_heap_reserve: i64 = 0
    pub size_of_heap_commit: i64 = 0
    pub directories: []PeDirectory = []
}

pub struct PeFile {
    pub data: []u8 = []
    pub machine: i64 = 0
    pub time_date_stamp: i64 = 0
    pub characteristics: i64 = 0
    pub header: PeOptionalHeader? = none
    pub sections: []PeSection = []
}

fn pe_corrupt(what: str) -> Error {
    Failed("pe: {what}")
}

pub fn read_pe(data: []u8) -> PeFile ! Error {
    var coff = 0
    if data.len >= 0x40 && data[0] == 'M' && data[1] == 'Z' {
        coff = io.le32(data, 0x3c)
        if coff < 0 || coff + 4 > data.len || data[coff] != 'P' || data[coff + 1] != 'E' {
            fail pe_corrupt("bad signature")
        }
        coff += 4
    }
    if coff + coff_header_size > data.len {
        fail pe_corrupt("file is shorter than a header")
    }
    let section_count = io.le16(data, coff + 2)
    let optional_size = io.le16(data, coff + 16)
    let optional_at = coff + coff_header_size
    let sections_at = optional_at + optional_size
    if sections_at + section_count * coff_section_size > data.len {
        fail pe_corrupt("section headers lie outside the file")
    }
    let header = read_optional_header(data, optional_at, optional_size)?
    var sections: []PeSection = []
    for i in 0..section_count {
        let at = sections_at + i * coff_section_size
        let section = read_section(data, at)
        push(mut sections, section)
    }
    PeFile {
        data
        machine: io.le16(data, coff)
        time_date_stamp: io.le32(data, coff + 4)
        characteristics: io.le16(data, coff + 18)
        header
        sections
    }
}

fn read_section(data: []u8, at: i64) -> PeSection {
    var end = at
    for end < at + 8 && data[end] != 0 {
        end += 1
    }
    PeSection {
        name: str(data[at..end])
        virtual_size: io.le32(data, at + 8)
        virtual_address: io.le32(data, at + 12)
        size: io.le32(data, at + 16)
        offset: io.le32(data, at + 20)
        relocations_offset: io.le32(data, at + 24)
        line_numbers_offset: io.le32(data, at + 28)
        relocation_count: io.le16(data, at + 32)
        line_number_count: io.le16(data, at + 34)
        characteristics: io.le32(data, at + 36)
    }
}

fn read_optional_header(data: []u8, at: i64, size: i64) -> PeOptionalHeader? ! Error {
    if size == 0 {
        return none
    }
    if size < 112 + data_directory_count * 8 || io.le16(data, at) != optional_header_64_magic {
        fail pe_corrupt("only 64-bit optional headers are read")
    }
    var directories: []PeDirectory = []
    for i in 0..data_directory_count {
        let entry = at + 112 + i * 8
        let directory = PeDirectory { virtual_address: io.le32(data, entry), size: io.le32(data, entry + 4) }
        push(mut directories, directory)
    }
    PeOptionalHeader {
        major_linker_version: i64(data[at + 2])
        address_of_entry_point: io.le32(data, at + 16)
        base_of_code: io.le32(data, at + 20)
        image_base: io.le64(data, at + 24)
        section_alignment: io.le32(data, at + 32)
        file_alignment: io.le32(data, at + 36)
        major_operating_system_version: io.le16(data, at + 40)
        major_subsystem_version: io.le16(data, at + 48)
        size_of_image: io.le32(data, at + 56)
        size_of_headers: io.le32(data, at + 60)
        subsystem: io.le16(data, at + 68)
        dll_characteristics: io.le16(data, at + 70)
        size_of_stack_reserve: io.le64(data, at + 72)
        size_of_stack_commit: io.le64(data, at + 80)
        size_of_heap_reserve: io.le64(data, at + 88)
        size_of_heap_commit: io.le64(data, at + 96)
        directories
    }
}

pub fn pe_section(f: PeFile, name: str) -> PeSection? {
    for s in f.sections {
        if s.name == name {
            return s
        }
    }
    none
}

pub fn pe_data(f: PeFile, s: PeSection) -> []u8 ! Error {
    if s.offset < 0 || s.offset + s.size > f.data.len {
        fail pe_corrupt("section {s.name} lies outside the file")
    }
    f.data[s.offset..s.offset + s.size]
}
