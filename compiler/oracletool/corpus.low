import fixture
import std/file
import std/slices
import std/text

pub struct Program {
    pub name: str
    pub path: str
}

pub fn programs(dir: str) -> []Program ! Error {
    let base = "testdata/{dir}"
    let entries = file.read_dir_info(base) catch {
        e => fail Failed("{base}: {e}")
    }
    var found: []Program = []
    for entry in entries {
        if entry.dir || text.ends_with(entry.name, fixture.source_ext) {
            let name = fixture.base(entry.name)
            let path = file.child_path(base, entry.name)
            push(mut found, Program { name, path })
        }
    }
    if found.len == 0 {
        fail Failed("no programs in {base}")
    }
    slices.sort_by(mut found, fn(a, b) { a.name < b.name })
    found
}

pub fn benchmarks() -> []Program ! Error {
    let paths = file.glob("bench/*/main.low")
    if paths.len == 0 {
        fail Failed("no benchmark programs")
    }
    var found: []Program = []
    for path in paths {
        let name = text.cut(text.trim_prefix(path, "bench/"), "/").before
        push(mut found, Program { name, path })
    }
    found
}
