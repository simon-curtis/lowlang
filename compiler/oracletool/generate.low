import amd64
import compiler
import ir
import native
import target
import std/file
import std/slices
import std/text

pub struct Generated {
    pub asm: str
    pub libraries: []str
}

pub fn generate(dir: str, path: str, platform: target.OS) -> Generated ! Error {
    let profile = compiler.release(platform)
    let unit = native.analyse(path, profile) catch {
        e => fail Failed(native.message(e))
    }
    let out = native.generate(unit) catch {
        e => fail Failed(native.message(e))
    }
    let source = materialise(dir, out.asm, unit.embeds)?
    let program = unit.program ?? fail Failed("unit without a program")
    Generated { asm: source, libraries: ir.libraries(program) }
}

fn materialise(dir: str, source: str, embeds: [str: []u8]) -> str ! Error {
    var keys: []str = []
    for key, _ in embeds {
        push(mut keys, key)
    }
    slices.sort(mut keys)
    var result = source
    for i, key in keys {
        let embed_path = file.child_path(dir, "embed-{i}")
        let content = embeds[key] ?? []
        file.write_file(embed_path, content) catch {
            e => fail Failed("write embed {key}: {e}")
        }
        let quoted_key = amd64.quote_string(key)
        let quoted_path = amd64.quote_string(embed_path)
        result = text.replace(result, quoted_key, quoted_path)
    }
    result
}
