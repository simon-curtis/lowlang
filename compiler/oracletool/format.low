import std/builder
import std/math
import std/text

pub fn hex_text(n: i64) -> str {
    let digits = text.hex(n)
    "0x{digits}"
}

pub fn signed(n: i64) -> str {
    if n < 0 {
        return "{n}"
    }
    "+{n}"
}

pub fn spaced_hex(data: []u8) -> str {
    var out = builder.builder()
    for i, b in data {
        if i > 0 {
            out.write_byte(' ')
        }
        out.write_byte(text.digit_char(i64(b >> 4)))
        out.write_byte(text.digit_char(i64(b & 15)))
    }
    out.to_str()
}

pub fn first_difference(a: []u8, b: []u8) -> i64 {
    let shared = math.min(a.len, b.len)
    for i in 0..shared {
        if a[i] != b[i] {
            return i
        }
    }
    shared
}
