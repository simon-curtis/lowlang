import std/io


pub const pt_load = 1
pub const pt_tls = 7
pub const pt_gnu_stack = 0x6474e551

pub const pf_x = 1
pub const pf_w = 2
pub const pf_r = 4

pub const sht_progbits = 1
pub const sht_symtab = 2
pub const sht_rela = 4
pub const sht_dynamic = 6
pub const sht_nobits = 8
pub const sht_dynsym = 11
pub const sht_gnu_verdef = 0x6ffffffd
pub const sht_gnu_verneed = 0x6ffffffe
pub const sht_gnu_versym = 0x6fffffff

pub const shf_write = 1
pub const shf_alloc = 2
pub const shf_execinstr = 4
pub const shf_info_link = 0x40
pub const shf_tls = 0x400

pub const stb_local = 0
pub const stb_global = 1

pub const stt_section = 3
pub const stt_file = 4
pub const stt_tls = 6

pub const shn_undef = 0
pub const shn_loreserve = 0xff00
pub const shn_abs = 0xfff1

pub const dt_null = 0
pub const dt_needed = 1
pub const dt_pltgot = 3
pub const dt_syment = 11
pub const dt_pltrel = 20
pub const dt_pltrelsz = 2
pub const dt_relasz = 8
pub const dt_relaent = 9
pub const dt_debug = 21
pub const dt_verneednum = 0x6fffffff

pub const r_x86_64_64 = 1
pub const r_x86_64_pc32 = 2
pub const r_x86_64_glob_dat = 6
pub const r_x86_64_jmp_slot = 7
pub const r_x86_64_32 = 10
pub const r_x86_64_32s = 11
pub const r_x86_64_plt32 = 4
pub const r_x86_64_gotpcrel = 9
pub const r_x86_64_gotpcrelx = 41
pub const r_x86_64_rex_gotpcrelx = 42

const elf_header_size = 64
const section_header_size = 64
const program_header_size = 56
const symbol_size = 24
const dynamic_entry_size = 16

pub struct ElfSection {
    pub name: str
    pub kind: i64 = 0
    pub flags: i64 = 0
    pub addr: i64 = 0
    pub offset: i64 = 0
    pub size: i64 = 0
    pub linked: i64 = 0
    pub info: i64 = 0
    pub addralign: i64 = 0
    pub entsize: i64 = 0
}

pub struct ElfProg {
    pub kind: i64
    pub flags: i64
    pub offset: i64
    pub vaddr: i64
    pub paddr: i64
    pub filesz: i64
    pub memsz: i64
    pub align: i64
}

pub struct ElfSymbol {
    pub name: str
    pub info: i64 = 0
    pub other: i64 = 0
    pub shndx: i64 = 0
    pub value: i64 = 0
}

pub struct ElfDynamicSymbol {
    pub name: str
    pub info: i64
    pub shndx: i64
    pub version: str
    pub library: str
}

pub struct ElfTag {
    pub tag: i64
    pub value: i64
}

pub struct ElfFile {
    pub data: []u8 = []
    pub kind: i64 = 0
    pub machine: i64 = 0
    pub entry: i64 = 0
    pub progs: []ElfProg = []
    pub sections: []ElfSection = []
}

struct VersionDefinition {
    index: i64
    name: str
}

struct VersionNeed {
    index: i64
    dep: str
    file: str
}

fn elf_corrupt(what: str) -> Error {
    Failed("elf: {what}")
}

fn bytes_at(data: []u8, offset: i64, size: i64, what: str) -> []u8 ! Error {
    if offset < 0 || size < 0 || offset + size > data.len {
        fail elf_corrupt("{what} lies outside the file")
    }
    data[offset..offset + size]
}

fn c_string(table: []u8, start: i64) -> str {
    if start < 0 || start >= table.len {
        return ""
    }
    var end = start
    for end < table.len && table[end] != 0 {
        end += 1
    }
    str(table[start..end])
}

pub fn read_elf(data: []u8) -> ElfFile ! Error {
    if data.len < elf_header_size {
        fail elf_corrupt("file is shorter than a header")
    }
    if data[0] != 0x7f || data[1] != 'E' || data[2] != 'L' || data[3] != 'F' {
        fail elf_corrupt("bad magic number")
    }
    if data[4] != 2 || data[5] != 1 {
        fail elf_corrupt("only 64-bit little-endian files are read")
    }
    let phoff = io.le64(data, 32)
    let shoff = io.le64(data, 40)
    let phentsize = io.le16(data, 54)
    let phnum = io.le16(data, 56)
    let shentsize = io.le16(data, 58)
    let shnum = io.le16(data, 60)
    let shstrndx = io.le16(data, 62)
    let progs = read_progs(data, phoff, phentsize, phnum)?
    let sections = read_sections(data, shoff, shentsize, shnum, shstrndx)?
    ElfFile {
        data
        kind: io.le16(data, 16)
        machine: io.le16(data, 18)
        entry: io.le64(data, 24)
        progs
        sections
    }
}

fn read_progs(data: []u8, offset: i64, entry_size: i64, count: i64) -> []ElfProg ! Error {
    var progs: []ElfProg = []
    if count == 0 {
        return progs
    }
    if entry_size < program_header_size {
        fail elf_corrupt("program header entries are too small")
    }
    let table = bytes_at(data, offset, count * entry_size, "program headers")?
    for i in 0..count {
        let at = i * entry_size
        let prog = ElfProg {
            kind: io.le32(table, at)
            flags: io.le32(table, at + 4)
            offset: io.le64(table, at + 8)
            vaddr: io.le64(table, at + 16)
            paddr: io.le64(table, at + 24)
            filesz: io.le64(table, at + 32)
            memsz: io.le64(table, at + 40)
            align: io.le64(table, at + 48)
        }
        push(mut progs, prog)
    }
    progs
}

fn read_sections(data: []u8, offset: i64, entry_size: i64, count: i64, names_index: i64) -> []ElfSection ! Error {
    var sections: []ElfSection = []
    if count == 0 {
        return sections
    }
    if entry_size < section_header_size {
        fail elf_corrupt("section header entries are too small")
    }
    if names_index >= count {
        fail elf_corrupt("section name table index is out of range")
    }
    let table = bytes_at(data, offset, count * entry_size, "section headers")?
    var name_offsets: []i64 = []
    for i in 0..count {
        let at = i * entry_size
        let name_offset = io.le32(table, at)
        push(mut name_offsets, name_offset)
        let section = ElfSection {
            name: ""
            kind: io.le32(table, at + 4)
            flags: io.le64(table, at + 8)
            addr: io.le64(table, at + 16)
            offset: io.le64(table, at + 24)
            size: io.le64(table, at + 32)
            linked: io.le32(table, at + 40)
            info: io.le32(table, at + 44)
            addralign: io.le64(table, at + 48)
            entsize: io.le64(table, at + 56)
        }
        push(mut sections, section)
    }
    let names = sections[names_index]
    let name_table = section_data(data, names)?
    for i in 0..count {
        sections[i].name = c_string(name_table, name_offsets[i])
    }
    sections
}

fn section_data(data: []u8, s: ElfSection) -> []u8 ! Error {
    if s.kind == sht_nobits {
        fail elf_corrupt("section {s.name} has no file data")
    }
    bytes_at(data, s.offset, s.size, "section {s.name}")?
}

pub fn elf_section(f: ElfFile, name: str) -> ElfSection? {
    for s in f.sections {
        if s.name == name {
            return s
        }
    }
    none
}

pub fn elf_data(f: ElfFile, s: ElfSection) -> []u8 ! Error {
    section_data(f.data, s)?
}

pub fn elf_section_name(f: ElfFile, index: i64) -> str {
    if index < 0 || index >= f.sections.len {
        return ""
    }
    f.sections[index].name
}

fn section_by_kind(f: ElfFile, kind: i64) -> ElfSection? {
    for s in f.sections {
        if s.kind == kind {
            return s
        }
    }
    none
}

fn string_table(f: ElfFile, symbols: ElfSection) -> []u8 ! Error {
    if symbols.linked <= 0 || symbols.linked >= f.sections.len {
        fail elf_corrupt("section {symbols.name} has an invalid string table link")
    }
    section_data(f.data, f.sections[symbols.linked])?
}

pub fn elf_symbols(f: ElfFile) -> []ElfSymbol ! Error {
    let symtab = section_by_kind(f, sht_symtab) ?? fail elf_corrupt("no symbol table")
    let table = section_data(f.data, symtab)?
    let names = string_table(f, symtab)?
    if table.len % symbol_size != 0 {
        fail elf_corrupt("the symbol table is not a multiple of the symbol size")
    }
    var symbols: []ElfSymbol = []
    var at = symbol_size
    for at < table.len {
        let symbol = ElfSymbol {
            name: c_string(names, io.le32(table, at))
            info: i64(table[at + 4])
            other: i64(table[at + 5])
            shndx: io.le16(table, at + 6)
            value: io.le64(table, at + 8)
        }
        push(mut symbols, symbol)
        at += symbol_size
    }
    symbols
}

pub fn elf_dynamic_symbols(f: ElfFile) -> []ElfDynamicSymbol ! Error {
    let dynsym = section_by_kind(f, sht_dynsym) ?? fail elf_corrupt("no dynamic symbol table")
    let table = section_data(f.data, dynsym)?
    let names = string_table(f, dynsym)?
    if table.len % symbol_size != 0 {
        fail elf_corrupt("the dynamic symbol table is not a multiple of the symbol size")
    }
    let versym = section_by_kind(f, sht_gnu_versym)
    var versions: []u8 = []
    var definitions: []VersionDefinition = []
    var needs: []VersionNeed = []
    match versym {
        some(s) => {
            versions = section_data(f.data, s)?
            definitions = version_definitions(f, names)?
            needs = version_needs(f, names)?
        }
        none => {}
    }
    var symbols: []ElfDynamicSymbol = []
    var at = symbol_size
    var i = 0
    for at < table.len {
        var symbol = ElfDynamicSymbol {
            name: c_string(names, io.le32(table, at))
            info: i64(table[at + 4])
            shndx: io.le16(table, at + 6)
            version: ""
            library: ""
        }
        let entry = (i + 1) * 2
        if entry + 2 <= versions.len {
            apply_version(mut symbol, io.le16(versions, entry) & 0x7fff, definitions, needs)
        }
        push(mut symbols, symbol)
        at += symbol_size
        i += 1
    }
    symbols
}

fn apply_version(mut symbol: ElfDynamicSymbol, index: i64, definitions: []VersionDefinition, needs: []VersionNeed) {
    if index < 2 {
        return
    }
    for need in needs {
        if need.index == index {
            symbol.version = need.dep
            symbol.library = need.file
            return
        }
    }
    for definition in definitions {
        if definition.index == index {
            symbol.version = definition.name
            return
        }
    }
}

fn version_definitions(f: ElfFile, names: []u8) -> []VersionDefinition ! Error {
    var definitions: []VersionDefinition = []
    let section = section_by_kind(f, sht_gnu_verdef) ?? return definitions
    let table = section_data(f.data, section)?
    var at = 0
    for at + 20 <= table.len {
        let index = io.le16(table, at + 4)
        let aux = io.le32(table, at + 12)
        let next = io.le32(table, at + 16)
        let name = c_string(names, io.le32(table, at + aux))
        let definition = VersionDefinition { index, name }
        push(mut definitions, definition)
        if next == 0 {
            break
        }
        at += next
    }
    definitions
}

fn version_needs(f: ElfFile, names: []u8) -> []VersionNeed ! Error {
    var needs: []VersionNeed = []
    let section = section_by_kind(f, sht_gnu_verneed) ?? return needs
    let table = section_data(f.data, section)?
    var at = 0
    for at + 16 <= table.len {
        let count = io.le16(table, at + 2)
        let file = c_string(names, io.le32(table, at + 4))
        let aux = io.le32(table, at + 8)
        let next = io.le32(table, at + 12)
        var j = at + aux
        for _ in 0..count {
            if j + 16 > table.len {
                break
            }
            let index = io.le16(table, j + 6)
            let dep = c_string(names, io.le32(table, j + 8))
            let need = VersionNeed { index, dep, file }
            push(mut needs, need)
            let step = io.le32(table, j + 12)
            if step == 0 {
                break
            }
            j += step
        }
        if next == 0 {
            break
        }
        at += next
    }
    needs
}

pub fn elf_tags(f: ElfFile) -> []ElfTag ! Error {
    let dynamic = elf_section(f, ".dynamic") ?? fail elf_corrupt("no .dynamic section")
    let table = section_data(f.data, dynamic)?
    var tags: []ElfTag = []
    var at = 0
    for at + dynamic_entry_size <= table.len {
        let tag = io.le64(table, at)
        let entry = ElfTag { tag, value: io.le64(table, at + 8) }
        push(mut tags, entry)
        if tag == dt_null {
            break
        }
        at += dynamic_entry_size
    }
    tags
}

pub fn elf_needed(f: ElfFile) -> []str ! Error {
    let dynamic = section_by_kind(f, sht_dynamic) ?? return []
    let table = section_data(f.data, dynamic)?
    let names = string_table(f, dynamic)?
    var needed: []str = []
    var at = 0
    for at + dynamic_entry_size <= table.len {
        if io.le64(table, at) == dt_needed {
            let name = c_string(names, io.le64(table, at + 8))
            push(mut needed, name)
        }
        at += dynamic_entry_size
    }
    needed
}
