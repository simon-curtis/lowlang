import std/file

const branch_flag = "-mbranches-within-32B-boundaries"
const no_used_note_flag = "-mx86-used-note=no"
const stack_note = "\n.section .note.GNU-stack,\"\",@progbits\n"
const clang_target = "--target=x86_64-pc-windows-msvc"

pub struct GNUOptions {
    pub align_branches: bool = false
    pub linkable: bool = false
}

pub fn assemble_gnu(dir: str, source: str, options: GNUOptions) -> str ! Error {
    var text = source
    var args: []str = []
    if options.align_branches {
        push(mut args, branch_flag)
    }
    if options.linkable {
        text = "{source}{stack_note}"
        push(mut args, no_used_note_flag)
    }
    let source_path = file.child_path(dir, "main.s")
    file.write_text(source_path, text) catch {
        e => fail Failed("write source: {e}")
    }
    defer file.remove(source_path) or {}
    let object = file.child_path(dir, "main.o")
    push(mut args, "-o")
    push(mut args, object)
    push(mut args, source_path)
    run_tool("as", args)?
    object
}

pub fn assemble_clang(dir: str, source: str) -> str ! Error {
    let source_path = file.child_path(dir, "main.s")
    file.write_text(source_path, source) catch {
        e => fail Failed("write source: {e}")
    }
    defer file.remove(source_path) or {}
    let object = file.child_path(dir, "main.obj")
    run_tool("clang", [clang_target, "-c", "-o", object, source_path])?
    object
}
