import types

pub struct Access {
    pub root: *Value
    pub off: i64
}

pub struct Base {
    pub root: *Value
    pub off: i64
}

pub fn base(value: *Value) -> Base {
    var v = value
    var off = 0
    for v.op == OpAdd && constant_offset(v) {
        off += v.args[1].aux
        v = resolve(v.args[0])
    }
    Base { root: v, off }
}

pub fn access_of(v: *Value) -> Access {
    let found = base(resolve(v.args[0]))
    Access { root: found.root, off: found.off + v.aux }
}

pub fn constant_offset(v: *Value) -> bool {
    v.type == none && v.args.len == 2 && v.args[1].op == OpConst
}

fn address_only_use(user: *Value, arg: i64) -> bool {
    if user.op == OpLoad || user.op == OpStore {
        return arg == 0
    }
    if is_compare(user.op) {
        return true
    }
    if user.op == OpAdd {
        return arg == 0 && constant_offset(user)
    }
    false
}

pub struct SlotInfo {
    pub escaped: []bool
    pub slot_escapes: []bool
    pub slot_values: []i64
    pub slot_first: []i64 = []
    pub word_bits: []i64 = []
    pub promotable: []bool = []
}

fn local_roots(f: *Func) -> *SlotInfo {
    let info = new(SlotInfo {
        escaped: flags(f.values + 1)
        slot_escapes: flags(f.slots.len)
        slot_values: counts(f.slots.len)
    })
    for b in f.blocks {
        for v in b.values {
            if v.op == OpSlot {
                info.slot_values[v.aux] += 1
            }
            for i, a in v.args {
                if !address_only_use(v, i) {
                    escape(info, a)
                }
            }
        }
        match b.control {
            some(c) => { escape(info, c) }
            none => {}
        }
        for r in b.results {
            escape(info, r)
        }
    }
    for b in f.blocks {
        for v in b.values {
            if v.op == OpSlot {
                let escapes = info.escaped[v.id] || info.slot_values[v.aux] > 1
                info.slot_escapes[v.aux] = info.slot_escapes[v.aux] || escapes
            }
        }
    }
    info
}

fn escape(info: *SlotInfo, v: *Value) {
    let found = base(v)
    if found.root.op == OpSlot {
        info.escaped[found.root.id] = true
    }
}

pub fn promotable_slots(f: *Func) -> *SlotInfo {
    let info = local_roots(f)
    var words = 0
    for n in f.slots {
        push(mut info.slot_first, words)
        words += n
    }
    push(mut info.slot_first, words)
    info.word_bits = counts(words)
    for escapes in info.slot_escapes {
        push(mut info.promotable, !escapes)
    }
    for b in f.blocks {
        for v in b.values {
            if v.op == OpLoad || v.op == OpStore {
                check_slot_access(info, f, v)
            }
        }
    }
    info
}

fn check_slot_access(info: *SlotInfo, f: *Func, v: *Value) {
    let acc = access_of(v)
    if acc.root.op != OpSlot {
        return
    }
    let slot = acc.root.aux
    if !info.promotable[slot] {
        return
    }
    if v.type != none || v.mem & mem_raw != 0 || acc.off < 0 || acc.off % 8 != 0 || acc.off / 8 >= f.slots[slot] {
        info.promotable[slot] = false
        return
    }
    var bits = v.float_bits
    if v.op == OpStore {
        let stored = resolve(v.args[1])
        if stored.op == OpPhi || stored.op == OpUndef {
            return
        }
        bits = stored.float_bits
    }
    let word = info.slot_first[slot] + acc.off / 8
    let seen = info.word_bits[word]
    if seen == 0 {
        info.word_bits[word] = bits + 1
    } else if seen != bits + 1 {
        info.promotable[slot] = false
    }
}
