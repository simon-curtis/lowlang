pub enum Convention {
    CallPlain
    CallGrow
    CallStrEq
}

pub enum Runtime {
    RtAlloc
    RtGrow
    RtMemmove
    RtStrEq
    RtExp
    RtPrintStr
    RtPanicMsg
    RtSleep
    RtWaitRead
    RtWaitWrite
    RtSpawn
    RtCurrent
    RtPark
    RtReady
    RtLock
    RtUnlock
    RtCas
    RtContext
    RtSetContext
    RtHasContext
    RtLockThread
    RtUnlockThread
    RtLockAll
    RtUnlockAll
    RtTimerAdd
    RtTimerDel
    RtPin
    RtUnpin
    RtArgc
    RtArgv
    RtEnvv
    RtClockNanos
    RtSysblock
    RtRegionEnter
    RtRegionLeave
    RtRegionFree
    RtRegionSuspend
    RtRegionResume
}

pub fn runtime_entries() -> []Runtime {
    [
        RtAlloc, RtGrow, RtMemmove, RtStrEq, RtExp, RtPrintStr, RtPanicMsg, RtSleep, RtWaitRead, RtWaitWrite,
        RtSpawn, RtCurrent, RtPark, RtReady, RtLock, RtUnlock, RtCas, RtContext, RtSetContext, RtHasContext,
        RtLockThread, RtUnlockThread, RtLockAll, RtUnlockAll, RtTimerAdd, RtTimerDel, RtPin, RtUnpin,
        RtArgc, RtArgv, RtEnvv, RtClockNanos, RtSysblock,
        RtRegionEnter, RtRegionLeave, RtRegionFree, RtRegionSuspend, RtRegionResume,
    ]
}

pub fn runtime_symbol(r: Runtime) -> str {
    match r {
        RtAlloc => "rt_alloc"
        RtGrow => "rt_grow"
        RtMemmove => "rt_memmove"
        RtStrEq => "rt_str_eq"
        RtExp => "rt_exp"
        RtPrintStr => "rt_print_str"
        RtPanicMsg => "rt_panic_msg"
        RtSleep => "rt_sleep"
        RtWaitRead => "rt_wait_readable"
        RtWaitWrite => "rt_wait_writable"
        RtSpawn => "rt_spawn"
        RtCurrent => "rt_current"
        RtPark => "rt_park"
        RtReady => "rt_ready"
        RtLock => "rt_lock"
        RtUnlock => "rt_unlock"
        RtCas => "rt_cas"
        RtContext => "rt_context"
        RtSetContext => "rt_set_context"
        RtHasContext => "rt_has_context"
        RtLockThread => "rt_lock_thread"
        RtUnlockThread => "rt_unlock_thread"
        RtLockAll => "rt_lock_all"
        RtUnlockAll => "rt_unlock_all"
        RtTimerAdd => "rt_timer_add"
        RtTimerDel => "rt_timer_del"
        RtPin => "rt_pin"
        RtUnpin => "rt_unpin"
        RtArgc => "rt_argc"
        RtArgv => "rt_argv"
        RtEnvv => "rt_envv"
        RtClockNanos => "rt_clock_nanos"
        RtSysblock => "rt_sysblock"
        RtRegionEnter => "rt_region_enter"
        RtRegionLeave => "rt_region_leave"
        RtRegionFree => "rt_region_free"
        RtRegionSuspend => "rt_region_suspend"
        RtRegionResume => "rt_region_resume"
    }
}

pub fn runtime_convention(r: Runtime) -> Convention {
    match r {
        RtGrow => CallGrow
        RtStrEq => CallStrEq
        _ => CallPlain
    }
}

pub fn runtime_void(r: Runtime) -> bool {
    match r {
        RtMemmove => true
        RtPrintStr => true
        RtPanicMsg => true
        RtSleep => true
        RtWaitRead => true
        RtWaitWrite => true
        RtSpawn => true
        RtPark => true
        RtReady => true
        RtLock => true
        RtUnlock => true
        RtSetContext => true
        RtLockThread => true
        RtUnlockThread => true
        RtLockAll => true
        RtUnlockAll => true
        RtTimerDel => true
        RtPin => true
        RtUnpin => true
        RtRegionLeave => true
        RtRegionFree => true
        RtRegionResume => true
        _ => false
    }
}

pub fn runtime_scalar(r: Runtime) -> bool {
    match r {
        RtStrEq => true
        RtExp => true
        RtCurrent => true
        RtCas => true
        RtHasContext => true
        RtTimerAdd => true
        RtArgc => true
        RtArgv => true
        RtEnvv => true
        RtClockNanos => true
        RtSysblock => true
        RtRegionEnter => true
        RtRegionSuspend => true
        _ => false
    }
}

pub fn runtime_call(b: *Builder, entry: Runtime, args: []*Value) -> *Value {
    let call = emit(b, OpRuntime, args)
    call.runtime = entry
    call
}

pub fn runtime(b: *Builder, entry: Runtime, args: []*Value) -> *Value? {
    let call = runtime_call(b, entry, args)
    if runtime_void(entry) {
        return none
    }
    let result = emit_result(b, call, 0)
    result.scalar = runtime_scalar(entry)
    result
}

pub fn syscall(b: *Builder, words: []*Value) -> *Value {
    let call = emit(b, OpSyscall, words)
    call.runtime = RtSysblock
    let result = emit_result(b, call, 0)
    result.scalar = true
    result
}
