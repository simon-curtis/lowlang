pub fn optimize_loops(s: *Ssa) {
    var polled = false
    for b in s.func.blocks {
        if b.poll {
            polled = true
        }
    }
    if !polled {
        return
    }
    let doms = func_dominators(s.func)
    for l in find_loops(doms) {
        if l.preheader == none {
            continue
        }
        hoist_invariants(s, l)
        reduce_strength(s, l)
    }
    for b in s.func.blocks {
        resolve_block(s, b)
    }
}

pub fn preheader_of(l: *Loop) -> *Block {
    l.preheader ?? panic("loop without a preheader")
}

fn hoist_invariants(s: *Ssa, l: *Loop) {
    let pre = preheader_of(l)
    for b in l.order {
        var kept: []*Value = []
        for v in b.values {
            if hoistable(v) && invariant_args(l, v) {
                localise_constants(s, l, v)
                v.block = pre
                push(mut pre.values, v)
                continue
            }
            push(mut kept, v)
        }
        b.values = kept
    }
}

fn hoistable(v: *Value) -> bool {
    match v.op {
        OpMul => true
        OpAnd => true
        OpOr => true
        OpXor => true
        OpShr => true
        OpNeg => true
        OpNot => true
        OpCompl => true
        OpConvert => true
        OpSqrt => true
        OpFloor => true
        OpFuncAddr => true
        OpMulHigh => true
        OpTrailingZeros => true
        OpHashSeed => true
        OpAdd => !constant_offset(v)
        OpSub => !constant_offset(v)
        OpShl => !constant_offset(v)
        OpDiv => float_value(v)
        _ => false
    }
}

fn localise_constants(s: *Ssa, l: *Loop, v: *Value) {
    let pre = preheader_of(l)
    for i, a in v.args {
        if a.op != OpConst || !(l.body[a.block] ?? false) {
            continue
        }
        let c = constant_in(s, pre, a.aux)
        c.float_bits = a.float_bits
        c.type = a.type
        v.args[i] = c
    }
}
