import ast
import lexer
import types

pub struct Location {
    pub local: *ast.Local? = none
    pub ptr: ast.Expr? = none
    pub index: *ast.Index? = none
    pub offset: i64 = 0
    pub width: *types.Type? = none
    pub tail: i64 = 0
}

fn field_width(u: *types.Universe, e: *ast.Selector) -> *types.Type? {
    let field = e.field ?? return none
    if types.struct_of(typ(e.x)).c {
        return types.width(u, field.type)
    }
    none
}

pub fn locate(u: *types.Universe, e: ast.Expr) -> *Location? {
    match e {
        Receiver(n) => locate(u, n.x)
        Ident(n) => {
            let local = n.local ?? return none
            new(Location { local })
        }
        Selector(n) => {
            let field = n.field ?? return none
            let width = field_width(u, n)
            if typ(n.x).kind == PointerKind {
                return new(Location { ptr: n.x, offset: field.bytes, width, tail: types.tail(field.type) })
            }
            let base = locate(u, n.x) ?? return none
            new(Location { local: base.local, ptr: base.ptr, index: base.index, offset: base.offset + field.bytes, width, tail: types.tail(field.type) })
        }
        Index(n) => {
            if typ(n.x).kind == SliceKind {
                return new(Location { index: n, tail: types.tail(types.must(n.type)) })
            }
            none
        }
        Unary(n) => {
            if n.op == lexer.Kind.Star {
                return new(Location { ptr: n.x, tail: types.tail(types.must(n.type)) })
            }
            none
        }
        _ => none
    }
}

pub fn must_locate(u: *types.Universe, e: ast.Expr) -> *Location {
    locate(u, e) ?? panic("ir: expression is not a place")
}

pub fn place_of(b: *Builder, e: ast.Expr) -> Place {
    build_place(b, must_locate(b.u, e))
}

pub fn param_size(f: *ast.Func, i: i64) -> i64 {
    if f.params[i].mutable {
        return 1
    }
    types.size(f.param_types[i])
}

pub fn boxed(l: *ast.Local) -> bool {
    if !l.captured {
        return false
    }
    let t = local_type(l)
    l.assigned || l.addressed || t.kind == VectorKind || types.c_struct(t)
}
