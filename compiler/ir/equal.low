import types

pub fn aggregate(t: *types.Type) -> bool {
    t.kind == StructKind || t.kind == EnumKind
}

pub fn equal(b: *Builder, t: *types.Type, x: []*Value, y: []*Value) -> *Value {
    if t == b.u.str {
        return runtime(b, RtStrEq, [x[0], x[1], y[0], y[1]]) ?? panic("string comparison without a result")
    }
    if types.c_struct(t) {
        let left = spill(b, x)
        let right = spill(b, y)
        return c_equal(b, t, left, right, 0)
    }
    match t.kind {
        StructKind => fields_equal(b, t, x, y)
        EnumKind => enum_equal(b, t, x, y)
        _ => compare_word(b, t, x[0], y[0])
    }
}

pub fn compare_word(b: *Builder, t: *types.Type, x: *Value, y: *Value) -> *Value {
    let same = typed(b, OpEq, t, [x, y])
    same.scalar = true
    same
}

fn both(b: *Builder, acc: *Value?, next: *Value) -> *Value {
    match acc {
        none => next
        some(previous) => typed(b, OpAnd, b.u.bool, [previous, next])
    }
}

fn fields_equal(b: *Builder, t: *types.Type, x: []*Value, y: []*Value) -> *Value {
    var acc: *Value? = none
    for f in t.fields {
        let start = types.word(f)
        let end = start + types.size(f.type)
        let same = equal(b, f.type, x[start..end], y[start..end])
        acc = both(b, acc, same)
    }
    match acc {
        some(found) => found
        none => constant(b, 1)
    }
}

fn variant_equal(b: *Builder, v: *types.Variant, x: []*Value, y: []*Value) -> *Value {
    var acc: *Value? = none
    for i, f in v.fields {
        let start = v.offsets[i]
        let end = start + types.size(f)
        let same = equal(b, f, x[start..end], y[start..end])
        acc = both(b, acc, same)
    }
    acc ?? panic("variant {v.name} has no fields to compare")
}

fn enum_equal(b: *Builder, t: *types.Type, x: []*Value, y: []*Value) -> *Value {
    let tags = compare_word(b, b.u.i64, x[0], y[0])
    if types.scalar(t) {
        return tags
    }
    let temp = new_temp(b)
    let done = fresh_block(b)
    let same = fresh_block(b)
    let unequal = constant(b, 0)
    write_temp(b, temp, [unequal])
    branch(b, tags, same, done)
    enter(b, same)
    for v in t.variants {
        if v.fields.len == 0 {
            continue
        }
        let hit = fresh_block(b)
        let next = fresh_block(b)
        let tag = constant(b, v.tag)
        let is_variant = compare_word(b, b.u.i64, x[0], tag)
        branch(b, is_variant, hit, next)
        enter(b, hit)
        let fields = variant_equal(b, v, x, y)
        write_temp(b, temp, [fields])
        jump(b, done)
        enter(b, next)
    }
    let equal_tags = constant(b, 1)
    write_temp(b, temp, [equal_tags])
    jump(b, done)
    enter(b, done)
    read_temp(b, temp, 1)[0]
}

pub fn spill(b: *Builder, words: []*Value) -> *Value {
    let held = slot(b, words.len)
    store_words(b, Place { addr: held }, words)
    held
}

fn c_equal(b: *Builder, t: *types.Type, x: *Value, y: *Value, base: i64) -> *Value {
    var acc: *Value? = none
    for f in t.fields {
        let same = c_field_equal(b, f, x, y, base + f.bytes)
        acc = both(b, acc, same)
    }
    acc ?? panic("c struct {t.name} has no fields to compare")
}

fn c_field_equal(b: *Builder, f: *types.Field, x: *Value, y: *Value, at: i64) -> *Value {
    if types.c_struct(f.type) {
        return c_equal(b, f.type, x, y, at)
    }
    let width = types.width(b.u, f.type)
    let left = load_words(b, Place { addr: x, offset: at, scalar: width }, f.type)[0]
    let right = load_words(b, Place { addr: y, offset: at, scalar: width }, f.type)[0]
    compare_word(b, f.type, left, right)
}
