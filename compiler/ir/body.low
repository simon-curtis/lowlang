import types

pub struct Span {
    pub start: i64 = 0
    pub len: i64 = 0
}

pub struct FlatValue {
    pub id: i64
    pub op: Op
    pub block: i64
    pub args: Span
    pub aux: i64 = 0
    pub str: Span
    pub runtime: Runtime? = none
    pub target: i64 = -1
    pub sig: i64 = -1
    pub type: i64 = 0
    pub from: i64 = 0
    pub scalar: bool = false
    pub float_bits: i64 = 0
    pub signature: i64 = -1
    pub mem: i64 = 0
    pub uses: i64 = 0
}

pub struct FlatBlock {
    pub id: i64
    pub kind: Kind
    pub values: Span
    pub control: i64 = -1
    pub table: i64 = -1
    pub results: Span
    pub succs: Span
    pub preds: Span
    pub poll: bool = false
    pub merged: bool = false
}

pub struct FlatSig {
    pub symbol: Span
    pub args: Span
    pub by_ref: Span
    pub ret: i64
}

pub struct FlatTable {
    pub low: i64
    pub cases: Span
}

pub struct FlatSignature {
    pub name: Span
    pub param_words: i64
    pub ret: i64
}

pub struct Body {
    pub values: []FlatValue = []
    pub blocks: []FlatBlock = []
    pub ints: []i64 = []
    pub bytes: []u8 = []
    pub sigs: []FlatSig = []
    pub tables: []FlatTable = []
    pub signatures: []FlatSignature = []
    pub slots: Span = Span {}
    pub value_count: i64 = 0
    pub block_count: i64 = 0
}

struct Flattener {
    body: *Body
    value_at: []i64
    block_at: []i64
    sig_at: [*CSig: i64] = [:]
    table_at: [*JumpTable: i64] = [:]
    signature_at: [*Func: i64] = [:]
}

fn signature_ref(w: *Flattener, f: *Func?) -> i64 {
    let s = f ?? return -1
    match w.signature_at[s] {
        some(at) => return at
        none => {}
    }
    let at = w.body.signatures.len
    let name = w.put_str(s.name)
    w.body.signatures.push(FlatSignature { name, param_words: s.param_words, ret: s.ret.id })
    w.signature_at[s] = at
    at
}

fn put_str(w: *Flattener, s: str) -> Span {
    let start = w.body.bytes.len
    for i in 0..s.len {
        w.body.bytes.push(s[i])
    }
    Span { start, len: s.len }
}

pub fn flatten_body(f: *Func) -> Body {
    let w = new(Flattener { body: new(Body { value_count: f.values, block_count: f.block_ids }), value_at: filled(f.values + 1), block_at: filled(f.block_ids) })
    var next = 0
    for bi, b in f.blocks {
        w.block_at[b.id] = bi
        for v in b.values {
            w.value_at[v.id] = next
            next += 1
        }
    }
    for b in f.blocks {
        w.flatten_block(b)
    }
    w.body.slots = w.put_ints(f.slots)
    *w.body
}

fn filled(n: i64) -> []i64 {
    var out: []i64 = []
    for _ in 0..n {
        out.push(-1)
    }
    out
}

fn flatten_block(w: *Flattener, b: *Block) {
    let start = w.body.values.len
    for v in b.values {
        w.flatten_value(v)
    }
    var control = -1
    match b.control {
        some(c) => { control = w.value_ref(c) }
        none => {}
    }
    var table = -1
    match b.table {
        some(t) => { table = w.table_ref(t) }
        none => {}
    }
    let results = w.put_values(b.results)
    let succs = w.put_blocks(b.succs)
    let preds = w.put_blocks(b.preds)
    w.body.blocks.push(FlatBlock {
        id: b.id
        kind: b.kind
        values: Span { start, len: b.values.len }
        control
        table
        results
        succs
        preds
        poll: b.poll
        merged: b.merged
    })
}

fn flatten_value(w: *Flattener, v: *Value) {
    if v.forward != none {
        panic("flatten: v{v.id} is forwarded")
    }
    let args = w.put_values(v.args)
    var sig = -1
    match v.sig {
        some(s) => { sig = w.sig_ref(s) }
        none => {}
    }
    let text = w.put_str(v.str)
    w.body.values.push(FlatValue {
        id: v.id
        op: v.op
        block: w.block_ref(v.block)
        args
        aux: v.aux
        str: text
        runtime: v.runtime
        target: func_ref(v.target)
        sig
        type: type_ref(v.type)
        from: type_ref(v.from)
        scalar: v.scalar
        float_bits: v.float_bits
        signature: w.signature_ref(v.signature)
        mem: v.mem
        uses: v.uses
    })
}

fn type_ref(t: *types.Type?) -> i64 {
    match t {
        some(inner) => inner.id
        none => 0
    }
}

fn func_ref(f: *Func?) -> i64 {
    match f {
        some(target) => {
            if target.id < 0 {
                panic("flatten: call to {target.name} outside the program")
            }
            target.id
        }
        none => -1
    }
}

fn value_ref(w: *Flattener, v: *Value) -> i64 {
    let at = w.value_at[v.id]
    if at < 0 {
        panic("flatten: v{v.id} is used but in no block")
    }
    at
}

fn block_ref(w: *Flattener, b: *Block) -> i64 {
    let at = w.block_at[b.id]
    if at < 0 {
        panic("flatten: b{b.id} is used but not in the function")
    }
    at
}

fn put_values(w: *Flattener, list: []*Value) -> Span {
    let start = w.body.ints.len
    for v in list {
        let at = w.value_ref(v)
        w.body.ints.push(at)
    }
    Span { start, len: list.len }
}

fn put_blocks(w: *Flattener, list: []*Block) -> Span {
    let start = w.body.ints.len
    for b in list {
        let at = w.block_ref(b)
        w.body.ints.push(at)
    }
    Span { start, len: list.len }
}

fn put_ints(w: *Flattener, list: []i64) -> Span {
    let start = w.body.ints.len
    for n in list {
        w.body.ints.push(n)
    }
    Span { start, len: list.len }
}

fn sig_ref(w: *Flattener, s: *CSig) -> i64 {
    match w.sig_at[s] {
        some(at) => return at
        none => {}
    }
    let start = w.body.ints.len
    for t in s.args {
        w.body.ints.push(t.id)
    }
    let args = Span { start, len: s.args.len }
    let by_start = w.body.ints.len
    for flag in s.by_ref {
        w.body.ints.push(if flag { 1 } else { 0 })
    }
    let by_ref = Span { start: by_start, len: s.by_ref.len }
    let at = w.body.sigs.len
    let symbol = w.put_str(s.symbol)
    w.body.sigs.push(FlatSig { symbol, args, by_ref, ret: s.ret.id })
    w.sig_at[s] = at
    at
}

fn table_ref(w: *Flattener, t: *JumpTable) -> i64 {
    match w.table_at[t] {
        some(at) => return at
        none => {}
    }
    let cases = w.put_ints(t.cases)
    let at = w.body.tables.len
    w.body.tables.push(FlatTable { low: t.low, cases })
    w.table_at[t] = at
    at
}

struct Inflater {
    body: Body
    u: *types.Universe
    funcs: []*Func
    values: []*Value
    blocks: []*Block
    sigs: []*CSig
    tables: []*JumpTable
    signatures: []*Func
}

pub fn inflate_body(f: *Func, body: Body, funcs: []*Func, u: *types.Universe) -> []*Value {
    let n = new(Inflater { body, u, funcs, values: [], blocks: [], sigs: [], tables: [], signatures: [] })
    for fs in body.signatures {
        let ret = u.type_of_id(fs.ret) ?? panic("inflate: unknown type id")
        n.signatures.push(new(Func { name: n.span_text(fs.name), param_words: fs.param_words, ret }))
    }
    for fb in body.blocks {
        n.blocks.push(new(Block { id: fb.id, kind: fb.kind, poll: fb.poll, merged: fb.merged }))
    }
    for fs in body.sigs {
        n.sigs.push(n.inflate_sig(fs))
    }
    for ft in body.tables {
        let cases = n.ints(ft.cases)
        n.tables.push(new(JumpTable { low: ft.low, cases }))
    }
    for fv in body.values {
        n.values.push(n.inflate_value(fv))
    }
    for i, fv in body.values {
        n.values[i].args = n.value_list(fv.args)
    }
    for i, fb in body.blocks {
        n.fill_block(n.blocks[i], fb)
    }
    f.blocks = n.blocks
    f.slots = n.ints(body.slots)
    f.values = body.value_count
    f.block_ids = body.block_count
    n.values
}

fn inflate_value(n: *Inflater, fv: FlatValue) -> *Value {
    var sig: *CSig? = none
    if fv.sig >= 0 {
        sig = n.sigs[fv.sig]
    }
    new(Value {
        id: fv.id
        op: fv.op
        block: n.blocks[fv.block]
        aux: fv.aux
        str: n.span_text(fv.str)
        runtime: fv.runtime
        target: n.func_of(fv.target)
        sig
        type: n.u.type_of_id(fv.type)
        from: n.u.type_of_id(fv.from)
        scalar: fv.scalar
        float_bits: fv.float_bits
        signature: n.signature_of(fv.signature)
        mem: fv.mem
        uses: fv.uses
    })
}

fn fill_block(n: *Inflater, b: *Block, fb: FlatBlock) {
    var values: []*Value = []
    for i in fb.values.start..fb.values.start + fb.values.len {
        values.push(n.values[i])
    }
    b.values = values
    if fb.control >= 0 {
        b.control = n.values[fb.control]
    }
    if fb.table >= 0 {
        b.table = n.tables[fb.table]
    }
    b.results = n.value_list(fb.results)
    b.succs = n.block_list(fb.succs)
    b.preds = n.block_list(fb.preds)
}

fn signature_of(n: *Inflater, at: i64) -> *Func? {
    if at < 0 {
        return none
    }
    n.signatures[at]
}

fn func_of(n: *Inflater, at: i64) -> *Func? {
    if at < 0 {
        return none
    }
    n.funcs[at]
}

fn inflate_sig(n: *Inflater, fs: FlatSig) -> *CSig {
    var args: []*types.Type = []
    for i in fs.args.start..fs.args.start + fs.args.len {
        args.push(n.u.type_of_id(n.body.ints[i]) ?? panic("inflate: unknown type id"))
    }
    var by_ref: []bool = []
    for i in fs.by_ref.start..fs.by_ref.start + fs.by_ref.len {
        by_ref.push(n.body.ints[i] != 0)
    }
    let ret = n.u.type_of_id(fs.ret) ?? panic("inflate: unknown type id")
    new(CSig { symbol: n.span_text(fs.symbol), args, by_ref, ret })
}

fn span_text(n: *Inflater, s: Span) -> str {
    if s.len == 0 {
        return ""
    }
    str(n.body.bytes[s.start..s.start + s.len])
}

fn ints(n: *Inflater, s: Span) -> []i64 {
    var out: []i64 = []
    for i in s.start..s.start + s.len {
        out.push(n.body.ints[i])
    }
    out
}

fn value_list(n: *Inflater, s: Span) -> []*Value {
    var out: []*Value = []
    for i in s.start..s.start + s.len {
        out.push(n.values[n.body.ints[i]])
    }
    out
}

fn block_list(n: *Inflater, s: Span) -> []*Block {
    var out: []*Block = []
    for i in s.start..s.start + s.len {
        out.push(n.blocks[n.body.ints[i]])
    }
    out
}
