import types

pub struct Span {
    pub start: i64 = 0
    pub len: i64 = 0
}

pub struct FlatValue {
    pub op: Op
    pub args: Span
    pub aux: i64 = 0
    pub refs: i64 = 0
    pub place: i64 = 0
    pub meta: i64 = 0
}

const low32 = 4294967295

pub fn flat_value(id: i64, op: Op, block: i64, args: Span, aux: i64, target: i64, ty: i64, mem: i64, uses: i64, bits: i64, extra: i64) -> FlatValue {
    if id >> 32 != 0 || block >> 31 != 0 || (target + 1) >> 32 != 0 || ty >> 31 != 0 || (extra + 1) >> 28 != 0 || bits >> 8 != 0 || mem >> 2 != 0 || uses >> 25 != 0 {
        panic("flatten: v{id} has a field too wide to pack")
    }
    FlatValue { op, args, aux, refs: (target + 1) | (ty << 32), place: id | (block << 32), meta: (extra + 1) | (bits << 28) | (mem << 36) | (uses << 38) }
}

pub fn flat_id(v: FlatValue) -> i64 {
    v.place & low32
}

pub fn flat_block(v: FlatValue) -> i64 {
    v.place >> 32
}

pub fn flat_target(v: FlatValue) -> i64 {
    (v.refs & low32) - 1
}

pub fn flat_type(v: FlatValue) -> i64 {
    v.refs >> 32
}

pub fn with_target(v: FlatValue, target: i64) -> FlatValue {
    FlatValue { op: v.op, args: v.args, aux: v.aux, refs: (target + 1) | ((v.refs >> 32) << 32), place: v.place, meta: v.meta }
}

pub fn with_type(v: FlatValue, ty: i64) -> FlatValue {
    FlatValue { op: v.op, args: v.args, aux: v.aux, refs: (v.refs & low32) | (ty << 32), place: v.place, meta: v.meta }
}

pub fn flat_extra_at(v: FlatValue) -> i64 {
    (v.meta & 268435455) - 1
}

pub fn flat_bits(v: FlatValue) -> i64 {
    (v.meta >> 28) & 255
}

pub fn flat_mem(v: FlatValue) -> i64 {
    (v.meta >> 36) & 3
}

pub fn flat_uses(v: FlatValue) -> i64 {
    v.meta >> 38
}

pub fn with_extra(v: FlatValue, extra: i64) -> FlatValue {
    FlatValue { op: v.op, args: v.args, aux: v.aux, refs: v.refs, place: v.place, meta: ((v.meta >> 28) << 28) | (extra + 1) }
}

pub fn with_bits(v: FlatValue, bits: i64) -> FlatValue {
    FlatValue { op: v.op, args: v.args, aux: v.aux, refs: v.refs, place: v.place, meta: (v.meta & 268435455) | (bits << 28) | ((v.meta >> 36) << 36) }
}

pub struct FlatExtra {
    pub str: Span = Span {}
    pub runtime: Runtime? = none
    pub sig: i64 = -1
    pub from: i64 = 0
    pub signature: i64 = -1
}

pub fn packed_bits(float_bits: i64, scalar: bool) -> i64 {
    float_bits * 2 + if scalar { 1 } else { 0 }
}

pub fn flat_float_bits(v: FlatValue) -> i64 {
    v.flat_bits() >> 1
}

pub fn flat_scalar(v: FlatValue) -> bool {
    v.flat_bits() & 1 == 1
}

pub fn flat_extra(f: *Func, v: FlatValue) -> FlatExtra {
    let at = v.flat_extra_at()
    if at < 0 {
        return FlatExtra {}
    }
    f.body.extras[at]
}

pub fn flat_text(f: *Func, v: FlatValue) -> Span {
    f.flat_extra(v).str
}

pub struct FlatBlock {
    pub id: i64
    pub kind: Kind
    pub values: Span
    pub control: i64 = -1
    pub table: i64 = -1
    pub results: Span
    pub succs: Span
    pub preds: Span
    pub poll: bool = false
    pub merged: bool = false
}

pub struct FlatSig {
    pub symbol: Span
    pub args: Span
    pub by_ref: Span
    pub ret: i64
}

pub struct FlatTable {
    pub low: i64
    pub cases: Span
}

pub struct FlatSignature {
    pub name: Span
    pub param_words: i64
    pub ret: i64
}

pub struct Body {
    pub values: []FlatValue = []
    pub extras: []FlatExtra = []
    pub blocks: []FlatBlock = []
    pub ints: []i64 = []
    pub bytes: []u8 = []
    pub sigs: []FlatSig = []
    pub tables: []FlatTable = []
    pub signatures: []FlatSignature = []
    pub slots: Span = Span {}
    pub value_count: i64 = 0
    pub block_count: i64 = 0
}

struct Flattener {
    body: *Body
    value_at: []i64
    block_at: []i64
    sig_at: [*CSig: i64] = [:]
    table_at: [*JumpTable: i64] = [:]
    signature_at: [*Func: i64] = [:]
}

fn signature_ref(w: *Flattener, f: *Func?) -> i64 {
    let s = f ?? return -1
    match w.signature_at[s] {
        some(at) => return at
        none => {}
    }
    let at = w.body.signatures.len
    let name = w.put_str(s.name)
    w.body.signatures.push(FlatSignature { name, param_words: s.param_words, ret: s.ret.id })
    w.signature_at[s] = at
    at
}

fn put_str(w: *Flattener, s: str) -> Span {
    let start = w.body.bytes.len
    for i in 0..s.len {
        w.body.bytes.push(s[i])
    }
    Span { start, len: s.len }
}

pub fn flatten_body(f: *Func) -> Body {
    let w = new(Flattener { body: new(Body { value_count: f.values, block_count: f.block_ids }), value_at: repeated(f.values + 1, -1), block_at: repeated(f.block_ids, -1) })
    let size = w.place(f)
    let blank_value = FlatValue { op: OpConst, args: Span {} }
    let blank_block = FlatBlock { id: 0, kind: Plain, values: Span {}, results: Span {}, succs: Span {}, preds: Span {} }
    w.body.values = reserved(size.values, blank_value)
    w.body.extras = reserved(size.extras, FlatExtra {})
    w.body.blocks = reserved(f.blocks.len, blank_block)
    w.body.ints = reserved(size.ints, 0)
    let blank_byte: u8 = 0
    w.body.bytes = reserved(size.bytes, blank_byte)
    for b in f.blocks {
        w.flatten_block(b)
    }
    w.body.slots = w.put_ints(f.slots)
    *w.body
}

struct BodySize {
    values: i64 = 0
    extras: i64 = 0
    ints: i64 = 0
    bytes: i64 = 0
}

fn place(w: *Flattener, f: *Func) -> BodySize {
    var size = BodySize { ints: f.slots.len }
    for bi, b in f.blocks {
        w.block_at[b.id] = bi
        size.ints += b.results.len + b.succs.len + b.preds.len
        match b.table {
            some(t) => { size.ints += t.cases.len }
            none => {}
        }
        for v in b.values {
            w.value_at[v.id] = size.values
            size.values += 1
            size.ints += v.args.len
            size.bytes += v.str.len
            if needs_extra(v) {
                size.extras += 1
            }
            match v.sig {
                some(s) => {
                    size.ints += s.args.len + s.by_ref.len
                    size.bytes += s.symbol.len
                }
                none => {}
            }
            match v.signature {
                some(s) => { size.bytes += s.name.len }
                none => {}
            }
        }
    }
    size
}

fn repeated[T](n: i64, blank: T) -> []T {
    var out: []T = []
    for _ in 0..n {
        out.push(blank)
    }
    out
}

fn reserved[T](n: i64, blank: T) -> []T {
    var out = repeated(n, blank)
    out.truncate(0)
    out
}

fn flatten_block(w: *Flattener, b: *Block) {
    let start = w.body.values.len
    for v in b.values {
        w.flatten_value(v)
    }
    var control = -1
    match b.control {
        some(c) => { control = w.value_ref(c) }
        none => {}
    }
    var table = -1
    match b.table {
        some(t) => { table = w.table_ref(t) }
        none => {}
    }
    let results = w.put_values(b.results)
    let succs = w.put_blocks(b.succs)
    let preds = w.put_blocks(b.preds)
    w.body.blocks.push(FlatBlock {
        id: b.id
        kind: b.kind
        values: Span { start, len: b.values.len }
        control
        table
        results
        succs
        preds
        poll: b.poll
        merged: b.merged
    })
}

fn flatten_value(w: *Flattener, v: *Value) {
    if v.forward != none {
        panic("flatten: v{v.id} is forwarded")
    }
    let args = w.put_values(v.args)
    var sig = -1
    match v.sig {
        some(s) => { sig = w.sig_ref(s) }
        none => {}
    }
    var extra = -1
    if needs_extra(v) {
        extra = w.body.extras.len
        w.body.extras.push(FlatExtra {
            str: w.put_str(v.str)
            runtime: v.runtime
            sig
            from: type_ref(v.from)
            signature: w.signature_ref(v.signature)
        })
    }
    w.body.values.push(flat_value(v.id, v.op, w.block_ref(v.block), args, v.aux, func_ref(v.target), type_ref(v.type), v.mem, v.uses, packed_bits(v.float_bits, v.scalar), extra))
}

fn needs_extra(v: *Value) -> bool {
    v.str.len > 0 || v.runtime != none || v.sig != none || v.from != none || v.signature != none
}

fn type_ref(t: *types.Type?) -> i64 {
    match t {
        some(inner) => inner.id
        none => 0
    }
}

fn func_ref(f: *Func?) -> i64 {
    match f {
        some(target) => {
            if target.id < 0 {
                panic("flatten: call to {target.name} outside the program")
            }
            target.id
        }
        none => -1
    }
}

fn value_ref(w: *Flattener, v: *Value) -> i64 {
    let at = w.value_at[v.id]
    if at < 0 {
        panic("flatten: v{v.id} is used but in no block")
    }
    at
}

fn block_ref(w: *Flattener, b: *Block) -> i64 {
    let at = w.block_at[b.id]
    if at < 0 {
        panic("flatten: b{b.id} is used but not in the function")
    }
    at
}

fn put_values(w: *Flattener, list: []*Value) -> Span {
    let start = w.body.ints.len
    for v in list {
        let at = w.value_ref(v)
        w.body.ints.push(at)
    }
    Span { start, len: list.len }
}

fn put_blocks(w: *Flattener, list: []*Block) -> Span {
    let start = w.body.ints.len
    for b in list {
        let at = w.block_ref(b)
        w.body.ints.push(at)
    }
    Span { start, len: list.len }
}

fn put_ints(w: *Flattener, list: []i64) -> Span {
    let start = w.body.ints.len
    for n in list {
        w.body.ints.push(n)
    }
    Span { start, len: list.len }
}

fn sig_ref(w: *Flattener, s: *CSig) -> i64 {
    match w.sig_at[s] {
        some(at) => return at
        none => {}
    }
    let start = w.body.ints.len
    for t in s.args {
        w.body.ints.push(t.id)
    }
    let args = Span { start, len: s.args.len }
    let by_start = w.body.ints.len
    for flag in s.by_ref {
        w.body.ints.push(if flag { 1 } else { 0 })
    }
    let by_ref = Span { start: by_start, len: s.by_ref.len }
    let at = w.body.sigs.len
    let symbol = w.put_str(s.symbol)
    w.body.sigs.push(FlatSig { symbol, args, by_ref, ret: s.ret.id })
    w.sig_at[s] = at
    at
}

fn table_ref(w: *Flattener, t: *JumpTable) -> i64 {
    match w.table_at[t] {
        some(at) => return at
        none => {}
    }
    let cases = w.put_ints(t.cases)
    let at = w.body.tables.len
    w.body.tables.push(FlatTable { low: t.low, cases })
    w.table_at[t] = at
    at
}

struct Inflater {
    body: Body
    u: *types.Universe
    funcs: []*Func
    values: []*Value
    blocks: []*Block
    sigs: []*CSig
    tables: []*JumpTable
    signatures: []*Func
    spare_block: *Block
    spare_value: *Value
}

pub fn inflate_body(f: *Func, body: Body, funcs: []*Func, u: *types.Universe) -> []*Value {
    let spare_block = new(Block { id: -1 })
    let spare_value = new(Value { id: -1, op: OpConst, block: spare_block })
    let values = reserved(body.values.len, spare_value)
    let blocks = reserved(body.blocks.len, spare_block)
    let n = new(Inflater { body, u, funcs, values, blocks, sigs: [], tables: [], signatures: [], spare_block, spare_value })
    for fs in body.signatures {
        let ret = u.type_of_id(fs.ret) ?? panic("inflate: unknown type id")
        n.signatures.push(new(Func { name: n.span_text(fs.name), param_words: fs.param_words, ret }))
    }
    for fb in body.blocks {
        n.blocks.push(new(Block { id: fb.id, kind: fb.kind, poll: fb.poll, merged: fb.merged }))
    }
    for fs in body.sigs {
        n.sigs.push(n.inflate_sig(fs))
    }
    for ft in body.tables {
        let cases = n.ints(ft.cases)
        n.tables.push(new(JumpTable { low: ft.low, cases }))
    }
    for fv in body.values {
        n.values.push(n.inflate_value(fv))
    }
    for i, fv in body.values {
        n.values[i].args = n.value_list(fv.args)
    }
    for i, fb in body.blocks {
        n.fill_block(n.blocks[i], fb)
    }
    f.blocks = n.blocks
    f.slots = n.ints(body.slots)
    f.values = body.value_count
    f.block_ids = body.block_count
    n.values
}

fn inflate_value(n: *Inflater, fv: FlatValue) -> *Value {
    let v = new(Value {
        id: fv.flat_id()
        op: fv.op
        block: n.blocks[fv.flat_block()]
        aux: fv.aux
        target: n.func_of(fv.flat_target())
        type: n.u.type_of_id(fv.flat_type())
        scalar: flat_scalar(fv)
        float_bits: flat_float_bits(fv)
        mem: fv.flat_mem()
        uses: fv.flat_uses()
    })
    let extra = fv.flat_extra_at()
    if extra >= 0 {
        let e = n.body.extras[extra]
        if e.sig >= 0 {
            v.sig = n.sigs[e.sig]
        }
        v.str = n.span_text(e.str)
        v.runtime = e.runtime
        v.from = n.u.type_of_id(e.from)
        v.signature = n.signature_of(e.signature)
    }
    v
}

fn fill_block(n: *Inflater, b: *Block, fb: FlatBlock) {
    var values = reserved(fb.values.len, n.spare_value)
    for i in fb.values.start..fb.values.start + fb.values.len {
        values.push(n.values[i])
    }
    b.values = values
    if fb.control >= 0 {
        b.control = n.values[fb.control]
    }
    if fb.table >= 0 {
        b.table = n.tables[fb.table]
    }
    b.results = n.value_list(fb.results)
    b.succs = n.block_list(fb.succs)
    b.preds = n.block_list(fb.preds)
}

fn signature_of(n: *Inflater, at: i64) -> *Func? {
    if at < 0 {
        return none
    }
    n.signatures[at]
}

fn func_of(n: *Inflater, at: i64) -> *Func? {
    if at < 0 {
        return none
    }
    n.funcs[at]
}

fn inflate_sig(n: *Inflater, fs: FlatSig) -> *CSig {
    var args: []*types.Type = []
    for i in fs.args.start..fs.args.start + fs.args.len {
        args.push(n.u.type_of_id(n.body.ints[i]) ?? panic("inflate: unknown type id"))
    }
    var by_ref: []bool = []
    for i in fs.by_ref.start..fs.by_ref.start + fs.by_ref.len {
        by_ref.push(n.body.ints[i] != 0)
    }
    let ret = n.u.type_of_id(fs.ret) ?? panic("inflate: unknown type id")
    new(CSig { symbol: n.span_text(fs.symbol), args, by_ref, ret })
}

fn span_text(n: *Inflater, s: Span) -> str {
    if s.len == 0 {
        return ""
    }
    str(n.body.bytes[s.start..s.start + s.len])
}

fn ints(n: *Inflater, s: Span) -> []i64 {
    var out = reserved(s.len, 0)
    for i in s.start..s.start + s.len {
        out.push(n.body.ints[i])
    }
    out
}

fn value_list(n: *Inflater, s: Span) -> []*Value {
    var out = reserved(s.len, n.spare_value)
    for i in s.start..s.start + s.len {
        out.push(n.values[n.body.ints[i]])
    }
    out
}

fn block_list(n: *Inflater, s: Span) -> []*Block {
    var out = reserved(s.len, n.spare_block)
    for i in s.start..s.start + s.len {
        out.push(n.blocks[n.body.ints[i]])
    }
    out
}
