import std/slices

pub fn thread_branches(s: *Ssa) -> bool {
    if !slices.any(s.func.blocks, has_phi_branch) {
        return false
    }
    count_uses(s)
    var threaded = false
    for b in post_order(s.func) {
        let branch = phi_branch(b) ?? continue
        let negated = branch.not != none
        let not_uses = if negated { (branch.not ?? branch.phi).uses } else { 1 }
        if branch.phi.uses != 1 || not_uses != 1 || !constants_feed_phis(b) {
            continue
        }
        if s.thread_predecessors(b, branch.phi, negated) {
            threaded = true
        }
    }
    threaded
}

pub struct PhiBranch {
    pub phi: *Value
    pub not: *Value? = none
}

fn has_phi_branch(b: *Block) -> bool {
    phi_branch(b) != none
}

fn post_order(f: *Func) -> []*Block {
    let seen = flags(f.block_ids)
    let entry = f.blocks[0]
    var post: []*Block = []
    var stack: []*Block = [entry]
    var cursor: []i64 = [0]
    seen[entry.id] = true
    for stack.len > 0 {
        let top = stack.len - 1
        let node = stack[top]
        let at = cursor[top]
        if at < node.succs.len {
            cursor[top] = at + 1
            let next = node.succs[at]
            if !seen[next.id] {
                seen[next.id] = true
                stack.push(next)
                cursor.push(0)
            }
        } else {
            post.push(node)
            stack.truncate(top)
            cursor.truncate(top)
        }
    }
    post
}

fn is_const(a: *Value) -> bool {
    a.op == OpConst
}

fn phi_branch(b: *Block) -> PhiBranch? {
    if b.kind != If || b.succs[0] == b.succs[1] || b.values.len == 0 {
        return none
    }
    let p = b.values[0]
    if p.op != OpPhi || !slices.any(p.args, is_const) {
        return none
    }
    var not: *Value? = none
    for v in b.values[1..] {
        if v.op == OpNot && v.args[0] == p && b.control == v {
            not = v
        } else if v.op != OpConst {
            return none
        }
    }
    if not == none && b.control != p {
        return none
    }
    PhiBranch { phi: p, not }
}

fn constants_feed_phis(b: *Block) -> bool {
    for v in b.values {
        if v.op == OpConst && v.uses != phi_feeds(b, v) {
            return false
        }
    }
    true
}

fn phi_feeds(b: *Block, c: *Value) -> i64 {
    var feeds = 0
    for t in b.succs {
        let at = t.single_pred_index(b)
        for v in t.values {
            if v.op == OpPhi && v.args[at] == c {
                feeds += 1
            }
        }
    }
    feeds
}

fn thread_predecessors(s: *Ssa, b: *Block, p: *Value, negated: bool) -> bool {
    let count = b.preds.len
    let moved = flags(count)
    var threaded = false
    for k in 0..count {
        let i = count - 1 - k
        let arg = p.args[i]
        if arg.op != OpConst {
            continue
        }
        let taken = (arg.aux != 0) != negated
        let target = if taken { b.succs[0] } else { b.succs[1] }
        if can_thread(b, b.preds[i], target) {
            s.redirect(b, i, target)
            moved[i] = true
            threaded = true
        }
    }
    if threaded {
        b.drop_preds(moved)
    }
    threaded
}

fn drop_preds(b: *Block, gone: []bool) {
    b.preds = kept(b.preds, gone)
    for v in b.values {
        if v.op != OpPhi {
            continue
        }
        for i, a in v.args {
            if gone[i] {
                a.uses -= 1
            }
        }
        v.args = kept(v.args, gone)
    }
}

fn kept[T](xs: []T, gone: []bool) -> []T {
    var out: []T = []
    for i, x in xs {
        if !gone[i] {
            out.push(x)
        }
    }
    out
}

fn can_thread(b: *Block, pred: *Block, target: *Block) -> bool {
    if pred == b || target == b || slices.contains(pred.succs, target) {
        return false
    }
    pred.succs.len == 1 || pred.succs[0] != pred.succs[1]
}

fn redirect(s: *Ssa, b: *Block, i: i64, target: *Block) {
    let pred = b.preds[i]
    let at = target.single_pred_index(b)
    for v in target.values {
        if v.op == OpPhi {
            let carried = s.carried(v.args[at], b, pred)
            carried.uses += 1
            v.args.push(carried)
        }
    }
    target.preds.push(pred)
    let from = slices.index(pred.succs, b) ?? panic("edge without a successor entry")
    pred.succs[from] = target
}

fn single_pred_index(b: *Block, pred: *Block) -> i64 {
    var lo = 0
    var hi = b.preds.len - 1
    for lo <= hi {
        if b.preds[hi] == pred {
            return hi
        }
        if b.preds[lo] == pred {
            return lo
        }
        lo += 1
        hi -= 1
    }
    panic("edge without a predecessor entry")
}

fn carried(s: *Ssa, a: *Value, b: *Block, pred: *Block) -> *Value {
    if !slices.contains(b.values, a) {
        return a
    }
    let c = new_value(s.func, pred, OpConst, [])
    c.aux = a.aux
    c.type = a.type
    c.scalar = a.scalar
    c.float_bits = a.float_bits
    pred.values.push(c)
    c
}
