import std/slices

pub fn thread_branches(s: *Ssa) -> bool {
    var threaded = false
    var counted = false
    for b in s.func.blocks {
        let branch = phi_branch(b) ?? continue
        if !counted {
            count_uses(s)
            counted = true
        }
        let negated = branch.not != none
        let not_uses = if negated { (branch.not ?? branch.phi).uses } else { 1 }
        if branch.phi.uses != 1 || not_uses != 1 {
            continue
        }
        if thread_predecessors(b, branch.phi, negated) {
            threaded = true
        }
    }
    threaded
}

pub struct PhiBranch {
    pub phi: *Value
    pub not: *Value? = none
}

fn is_const(a: *Value) -> bool {
    a.op == OpConst
}

fn phi_branch(b: *Block) -> PhiBranch? {
    if b.kind != If || b.succs[0] == b.succs[1] || b.values.len == 0 || b.values.len > 2 {
        return none
    }
    let p = b.values[0]
    if p.op != OpPhi || !slices.any(p.args, is_const) {
        return none
    }
    if b.values.len == 1 {
        if b.control == p {
            return PhiBranch { phi: p }
        }
        return none
    }
    let not = b.values[1]
    if not.op == OpNot && not.args[0] == p && b.control == not {
        return PhiBranch { phi: p, not }
    }
    none
}

fn thread_predecessors(b: *Block, p: *Value, negated: bool) -> bool {
    var threaded = false
    let count = b.preds.len
    for k in 0..count {
        let i = count - 1 - k
        let arg = p.args[i]
        if arg.op != OpConst {
            continue
        }
        let taken = (arg.aux != 0) != negated
        let target = if taken { b.succs[0] } else { b.succs[1] }
        if can_thread(b, b.preds[i], target) {
            redirect(b, i, target)
            threaded = true
        }
    }
    threaded
}

fn can_thread(b: *Block, pred: *Block, target: *Block) -> bool {
    if pred == b || target == b || slices.contains(target.preds, pred) {
        return false
    }
    pred.succs.len == 1 || pred.succs[0] != pred.succs[1]
}

fn redirect(b: *Block, i: i64, target: *Block) {
    let pred = b.preds[i]
    let at = slices.index(target.preds, b) ?? panic("edge without a predecessor entry")
    for v in target.values {
        if v.op == OpPhi {
            push(mut v.args, v.args[at])
        }
    }
    push(mut target.preds, pred)
    let from = slices.index(pred.succs, b) ?? panic("edge without a successor entry")
    pred.succs[from] = target
    remove_pred(b, i)
}
