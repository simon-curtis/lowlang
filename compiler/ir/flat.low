import std/math
import std/slices
import types

pub struct Ref {
    pub func: *Func
    pub at: i64
}

pub fn value_of(r: Ref) -> FlatValue {
    r.func.body.values[r.at]
}

pub fn arg_ref(f: *Func, call: i64, word: i64) -> Ref {
    let v = f.body.values[call]
    Ref { func: f, at: f.body.ints[v.args.start + word] }
}

pub fn flat_targets(f: *Func) -> []i64 {
    var found: []i64 = []
    let values = f.body.values
    for i in 0..values.len {
        let op = values[i].op
        if (op == OpCall || op == OpFuncAddr) && values[i].flat_target() >= 0 {
            found.push(i)
        }
    }
    found
}

pub fn flat_params(f: *Func) -> []i64 {
    var params: []i64 = []
    let entry = f.body.blocks[0].values
    for i in entry.start..entry.start + entry.len {
        if f.body.values[i].op == OpParam {
            params.push(i)
        }
    }
    params
}

pub fn same_text(a: *Func, sa: Span, b: *Func, sb: Span) -> bool {
    if sa.len != sb.len {
        return false
    }
    for i in 0..sa.len {
        if a.body.bytes[sa.start + i] != b.body.bytes[sb.start + i] {
            return false
        }
    }
    true
}

pub fn copy_text(to: *Func, from: *Func, s: Span) -> Span {
    let start = to.body.bytes.len
    for i in s.start..s.start + s.len {
        to.body.bytes.push(from.body.bytes[i])
    }
    Span { start, len: s.len }
}

pub fn copy_body(b: Body) -> Body {
    Body {
        values: slices.clone(b.values)
        extras: slices.clone(b.extras)
        blocks: slices.clone(b.blocks)
        ints: slices.clone(b.ints)
        bytes: slices.clone(b.bytes)
        sigs: slices.clone(b.sigs)
        tables: slices.clone(b.tables)
        signatures: slices.clone(b.signatures)
        slots: b.slots
        value_count: b.value_count
        block_count: b.block_count
    }
}

pub struct Reworker {
    pub u: *types.Universe
    pub program: *Program
}

pub fn rework(r: Reworker, f: *Func, change: fn(*Func)) {
    let body = region { r.reworked(f, change) }
    f.body = body
}

fn reworked(r: Reworker, f: *Func, change: fn(*Func)) -> Body {
    let local = r.local_copy(f)
    change(local.func)
    flatten_body(local.func)
}

pub struct Local {
    pub func: *Func
    pub values: []*Value
}

pub fn local_copy(r: Reworker, f: *Func) -> Local {
    let local = new(*f)
    let values = inflate_body(local, f.body, r.program.all, r.u)
    Local { func: local, values }
}

pub fn simplify_body(r: Reworker, f: *Func) {
    let u = r.u
    r.rework(f, fn(local: *Func) { simplify(u, local) })
}

pub fn flat_cost(f: *Func) -> i64 {
    var cost = 0
    let values = f.body.values
    for i in 0..values.len {
        if counts_toward_cost(values[i].op) {
            cost += 1
        }
    }
    cost
}

pub const max_batches = 128

pub fn batches(n: i64) -> []Span {
    let count = math.min(n, max_batches)
    var out: []Span = []
    for k in 0..count {
        let start = k * n / count
        let end = (k + 1) * n / count
        out.push(Span { start, len: end - start })
    }
    out
}

struct Load {
    span: Span
    weight: i64
}

pub fn lightest_last(spans: []Span, weight: fn(i64) -> i64) -> []Span {
    var loads: []Load = []
    for span in spans {
        var total = 0
        for i in span.start..span.start + span.len {
            total += weight(i)
        }
        loads.push(Load { span, weight: total })
    }
    slices.sort_by(mut loads, fn(a: Load, b: Load) -> bool { a.weight > b.weight })
    let heavy = loads.len - loads.len / 4
    var first = slices.clone(loads[..heavy])
    slices.sort_by(mut first, fn(a: Load, b: Load) -> bool { a.span.start < b.span.start })
    var out: []Span = []
    for l in first {
        out.push(l.span)
    }
    for l in loads[heavy..] {
        out.push(l.span)
    }
    out
}

pub fn body_text(f: *Func, s: Span) -> str {
    str(f.body.bytes[s.start..s.start + s.len])
}

pub fn materialise(p: *Program, runner: Runner) {
    let u = p.universe ?? panic("program without a universe")
    let funcs = p.funcs
    let all = p.all
    runner.mark("materialise")
    let each = runner.each
    each(funcs.len, fn(i: i64) {
        let f = funcs[i]
        if f.body.blocks.len > 0 {
            inflate_body(f, f.body, all, u)
            f.body = Body {}
            settle_copies(f)
        }
    })
}

pub fn with_blocks(p: *Program, f: *Func) -> *Func {
    if f.body.blocks.len == 0 {
        return f
    }
    let u = p.universe ?? panic("program without a universe")
    let local = new(*f)
    inflate_body(local, f.body, p.all, u)
    settle_copies(local)
    local
}
