import ast
import types

pub const by_reference_words = 64
pub const min_copy_words = 8
pub const entry_name = "main"

pub fn by_reference(t: *types.Type) -> bool {
    types.size(t) >= by_reference_words && !is_vector(t) && !types.c_struct(t)
}

pub fn returns_by_reference(f: *Func) -> bool {
    !f.callback && f.name != entry_name && by_reference(f.ret)
}

fn copyable(b: *Builder, w: *Value) -> bool {
    w.op == OpLoad && w.args.len == 1 && w.type == none && w.mem == 0 && b.frozen[w.args[0].id] != none
}

fn run_at(b: *Builder, words: []*Value, k: i64) -> i64 {
    let first = words[k]
    if !b.copyable(first) {
        return 0
    }
    var n = 1
    for k + n < words.len {
        let w = words[k + n]
        if !b.copyable(w) || w.args[0] != first.args[0] || w.aux != first.aux + 8 * n {
            return n
        }
        n += 1
    }
    n
}

fn offset_address(b: *Builder, base: *Value, offset: i64) -> *Value {
    if offset == 0 {
        return base
    }
    let by = constant(b, offset)
    emit(b, OpAdd, [base, by])
}

pub fn freeze(b: *Builder, v: *Value) -> *Value {
    b.frozen[v.id] = true
    v
}

pub fn store_plain(b: *Builder, addr: *Value, offset: i64, words: []*Value) {
    var k = 0
    for k < words.len {
        let n = b.run_at(words, k)
        if n >= min_copy_words {
            let first = words[k]
            let to = b.offset_address(addr, offset + 8 * k)
            let from = b.offset_address(first.args[0], first.aux)
            let bytes = constant(b, 8 * n)
            let _ = runtime(b, RtMemmove, [to, from, bytes])
            k += n
            continue
        }
        let v = emit(b, OpStore, [addr, words[k]])
        v.aux = offset + 8 * k
        k += 1
    }
}

fn frozen_run(b: *Builder, words: []*Value) -> *Value? {
    if words.len == 0 || b.run_at(words, 0) != words.len {
        return none
    }
    let first = words[0]
    b.freeze(b.offset_address(first.args[0], first.aux))
}

pub fn pass_by_reference(b: *Builder, words: []*Value) -> *Value {
    match b.frozen_run(words) {
        some(found) => { return found }
        none => {}
    }
    let held = slot(b, words.len)
    b.store_plain(held, 0, words)
    held
}

pub fn layout_words(b: *Builder, target: *Func, words: []*Value) -> []*Value {
    var sized = 0
    for p in target.params {
        if p.mutable {
            sized += 1
        } else {
            sized += types.size(p.type)
        }
    }
    let lead = words.len - sized
    if lead < 0 {
        panic("ir: call to {target.name} passes {words.len} words for {sized}")
    }
    var out: []*Value = []
    for k in 0..lead {
        out.push(words[k])
    }
    var at = lead
    for p in target.params {
        if p.mutable {
            out.push(words[at])
            at += 1
            continue
        }
        let n = types.size(p.type)
        if by_reference(p.type) {
            let pointer = b.pass_by_reference(words[at..at + n])
            out.push(pointer)
        } else {
            for k in 0..n {
                out.push(words[at + k])
            }
        }
        at += n
    }
    out
}

pub fn result_slot(b: *Builder, f: *Func) -> *Value? {
    if !returns_by_reference(f) {
        return none
    }
    b.freeze(slot(b, types.size(f.ret)))
}

pub fn returned(b: *Builder, results: []*Value) -> []*Value {
    let into = b.result_pointer ?? return results
    b.store_plain(into, 0, results)
    []
}

pub fn bind_in_memory(b: *Builder, local: *ast.Local, words: []*Value) {
    if local.mutable || local.addressed {
        b.slots[local] = spill(b, words)
        return
    }
    match b.frozen_run(words) {
        some(found) => {
            b.slots[local] = found
            return
        }
        none => {}
    }
    b.slots[local] = b.freeze(spill(b, words))
}
