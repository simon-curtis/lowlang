import ast
import types

struct IndexGroup {
    index: i64
    tags: []i64 = []
}

pub fn variant_index(b: *Builder, e: *ast.Selector) -> []*Value {
    let t = typ(e.x)
    let tag = value(b, e.x, t)[0]
    match tag_offset(t) {
        some(offset) => [offset_tag(b, tag, offset)]
        none => [index_of_tag(b, t, tag)]
    }
}

fn tag_offset(t: *types.Type) -> i64? {
    let first = t.variants[0]
    let offset = first.index - first.tag
    for v in t.variants[1..] {
        if v.index - v.tag != offset {
            return none
        }
    }
    offset
}

fn offset_tag(b: *Builder, tag: *Value, offset: i64) -> *Value {
    if offset == 0 {
        return tag
    }
    let shift = constant(b, offset)
    typed(b, OpAdd, b.u.i64, [tag, shift])
}

fn index_of_tag(b: *Builder, t: *types.Type, tag: *Value) -> *Value {
    let groups = index_groups(t)
    let fallback = widest_group(groups)
    let temp = new_temp(b)
    let done = fresh_block(b)
    var targets: []*Block = []
    let plan = new(SwitchPlan { typ: b.u.i64 })
    for i, g in groups {
        let target = fresh_block(b)
        push(mut targets, target)
        if i == fallback {
            continue
        }
        for member in g.tags {
            push(mut plan.cases, SwitchCase { key: member, target })
        }
    }
    sort_by_key(plan)
    lower_switch(b, plan, tag, targets[fallback])
    for i, g in groups {
        enter(b, targets[i])
        let index = constant(b, g.index)
        write_temp(b, temp, [index])
        jump(b, done)
    }
    enter(b, done)
    read_temp(b, temp, 1)[0]
}

fn index_groups(t: *types.Type) -> []IndexGroup {
    var groups: []IndexGroup = []
    for v in t.variants {
        var at = group_of(groups, v.index)
        if at < 0 {
            push(mut groups, IndexGroup { index: v.index })
            at = groups.len - 1
        }
        var tags = groups[at].tags
        push(mut tags, v.tag)
        groups[at] = IndexGroup { index: v.index, tags }
    }
    groups
}

fn group_of(groups: []IndexGroup, index: i64) -> i64 {
    for i, g in groups {
        if g.index == index {
            return i
        }
    }
    -1
}

fn widest_group(groups: []IndexGroup) -> i64 {
    var widest = 0
    for i, g in groups {
        if g.tags.len > groups[widest].tags.len {
            widest = i
        }
    }
    widest
}
