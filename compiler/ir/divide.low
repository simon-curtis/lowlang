import std/bits
import types

pub struct UnsignedMagic {
    pub multiplier: u64
    pub shift: i64
    pub add: bool = false
}

pub struct SignedMagic {
    pub multiplier: i64
    pub shift: i64
    pub add: bool = false
}

struct Quotient {
    q: u64
    rem: u64
}

fn divide_high(high: u64, d: u64) -> Quotient {
    var q: u64 = 0
    var rem = high
    for _ in 0..64 {
        let carry = rem >> 63
        rem = rem << 1
        q = q << 1
        if carry != 0 || rem >= d {
            rem = rem - d
            q = q | 1
        }
    }
    Quotient { q, rem }
}

pub fn new_unsigned_magic(d: u64) -> UnsignedMagic {
    let log = 63 - bits.leading_zeros(d)
    let division = divide_high(u64(1) << log, d)
    if d - division.rem < u64(1) << log {
        return UnsignedMagic { multiplier: division.q + 1, shift: log }
    }
    var q = division.q + division.q
    let twice = division.rem + division.rem
    if twice >= d || twice < division.rem {
        q += 1
    }
    UnsignedMagic { multiplier: q + 1, shift: log, add: true }
}

pub fn new_signed_magic(d: u64) -> SignedMagic {
    let log = 63 - bits.leading_zeros(d)
    let division = divide_high(u64(1) << (log - 1), d)
    if d - division.rem < u64(1) << log {
        return SignedMagic { multiplier: i64(division.q + 1), shift: log - 1 }
    }
    var q = division.q + division.q
    let twice = division.rem + division.rem
    if twice >= d || twice < division.rem {
        q += 1
    }
    SignedMagic { multiplier: i64(q + 1), shift: log, add: true }
}

fn magnitude(d: i64) -> u64 {
    if d < 0 {
        return u64(0) - u64(d)
    }
    u64(d)
}

fn unsigned_division(v: *Value) -> bool {
    match v.type {
        some(t) => !t.signed
        none => false
    }
}

pub fn divides_by_constant(v: *Value, d: i64) -> bool {
    if d == 0 || !integer_op(v) {
        return false
    }
    unsigned_division(v) || (d != -1 && d != min_i64)
}

fn operation(o: *Optimizer, v: *Value, op: Op, t: *types.Type, args: []*Value) -> *Value {
    let n = new_value(o.func, v.block, op, args)
    n.type = t
    n.scalar = v.scalar
    push(mut o.out, n)
    n
}

pub fn constant_for(o: *Optimizer, v: *Value, n: i64) -> *Value {
    let c = new_value(o.func, v.block, OpConst, [])
    c.aux = n
    c.scalar = true
    push(mut o.out, c)
    c
}

pub fn become(v: *Value, op: Op, args: []*Value) {
    v.op = op
    v.args = args
}

pub fn divide_by_constant(o: *Optimizer, v: *Value, x: *Value, d: i64) {
    if unsigned_division(v) {
        divide_unsigned(o, v, x, u64(d))
        return
    }
    divide_signed(o, v, x, d)
}

fn divide_unsigned(o: *Optimizer, v: *Value, x: *Value, d: u64) {
    if d == 1 && v.op == OpDiv {
        forward_to(v, x)
    } else if d == 1 {
        become_constant(v, 0)
    } else if d & (d - 1) == 0 && v.op == OpRem {
        let mask = constant_for(o, v, i64(d - 1))
        become(v, OpAnd, [x, mask])
    } else if d & (d - 1) == 0 {
        let count = constant_for(o, v, bits.trailing_zeros(d))
        become(v, OpShr, [x, count])
    } else {
        unsigned_by_magic(o, v, x, d)
    }
}

fn unsigned_by_magic(o: *Optimizer, v: *Value, x: *Value, d: u64) {
    let magic = new_unsigned_magic(d)
    let u64_type = o.u.u64
    let multiplier = constant_for(o, v, i64(magic.multiplier))
    var scaled = operation(o, v, OpMulHigh, u64_type, [x, multiplier])
    if magic.add {
        let excess = operation(o, v, OpSub, u64_type, [x, scaled])
        let one = constant_for(o, v, 1)
        let halved = operation(o, v, OpShr, u64_type, [excess, one])
        scaled = operation(o, v, OpAdd, u64_type, [halved, scaled])
    }
    let count = constant_for(o, v, magic.shift)
    if v.op == OpDiv {
        become(v, OpShr, [scaled, count])
        return
    }
    let q = operation(o, v, OpShr, u64_type, [scaled, count])
    let divisor = constant_for(o, v, i64(d))
    let product = operation(o, v, OpMul, u64_type, [q, divisor])
    become(v, OpSub, [x, product])
}

fn divide_signed(o: *Optimizer, v: *Value, x: *Value, d: i64) {
    let m = magnitude(d)
    if m == 1 && v.op == OpRem {
        become_constant(v, 0)
    } else if m == 1 {
        forward_to(v, x)
    } else if m & (m - 1) == 0 {
        signed_power_of_two(o, v, x, d, bits.trailing_zeros(m))
    } else {
        signed_by_magic(o, v, x, d, m)
    }
}

fn signed_power_of_two(o: *Optimizer, v: *Value, x: *Value, d: i64, k: i64) {
    let u64_type = o.u.u64
    let i64_type = o.u.i64
    let word_sign = constant_for(o, v, 63)
    var bias = operation(o, v, OpShr, u64_type, [x, word_sign])
    if k > 1 {
        let signs = operation(o, v, OpShr, i64_type, [x, word_sign])
        let bias_count = constant_for(o, v, 64 - k)
        bias = operation(o, v, OpShr, u64_type, [signs, bias_count])
    }
    let sum = operation(o, v, OpAdd, i64_type, [x, bias])
    let count = constant_for(o, v, k)
    if v.op == OpRem {
        let q = operation(o, v, OpShr, i64_type, [sum, count])
        let scaled = operation(o, v, OpShl, i64_type, [q, count])
        become(v, OpSub, [x, scaled])
    } else if d < 0 {
        let q = operation(o, v, OpShr, i64_type, [sum, count])
        become(v, OpNeg, [q])
    } else {
        become(v, OpShr, [sum, count])
    }
}

fn signed_by_magic(o: *Optimizer, v: *Value, x: *Value, d: i64, m: u64) {
    let i64_type = o.u.i64
    let u64_type = o.u.u64
    let magic = new_signed_magic(m)
    let multiplier = constant_for(o, v, magic.multiplier)
    var scaled = operation(o, v, OpMulHigh, i64_type, [x, multiplier])
    if magic.add {
        scaled = operation(o, v, OpAdd, i64_type, [scaled, x])
    }
    if magic.shift > 0 {
        let shift = constant_for(o, v, magic.shift)
        scaled = operation(o, v, OpShr, i64_type, [scaled, shift])
    }
    let sign_count = constant_for(o, v, 63)
    let sign = operation(o, v, OpShr, u64_type, [x, sign_count])
    if v.op == OpRem {
        let q = operation(o, v, OpAdd, i64_type, [scaled, sign])
        let divisor = constant_for(o, v, i64(m))
        let product = operation(o, v, OpMul, i64_type, [q, divisor])
        become(v, OpSub, [x, product])
    } else if d < 0 {
        let q = operation(o, v, OpAdd, i64_type, [scaled, sign])
        become(v, OpNeg, [q])
    } else {
        become(v, OpAdd, [scaled, sign])
    }
}
