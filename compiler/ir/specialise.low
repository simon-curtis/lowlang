import std/slices
import types

pub const max_specialisation_rounds = 4
pub const max_clones_per_function = 4
pub const max_clone_source_cost = 150
pub const max_cloned_program_cost = 4000

pub struct CallSite {
    pub caller: *Func
    pub call: i64
}

pub struct Specialiser {
    pub program: *Program
    pub rw: Reworker
    pub runner: Runner
    pub cloned: i64 = 0
    pub clones_of: [*Func: i64] = [:]
    pub named: [str: i64] = [:]
    targets: []Targets = []
}

pub fn specialise_constant_arguments(p: *Program, rw: Reworker, runner: Runner) {
    let s = new(Specialiser { program: p, rw, runner })
    for _ in 0..max_specialisation_rounds {
        let constants = specialise_constants(s)
        let clones = clone_for_functions(s)
        if !constants && !clones {
            return
        }
    }
}

fn sites_of(calls: *DirectCalls, g: *Func) -> []CallSite {
    if g.id < 0 || g.id >= calls.sites.len {
        return []
    }
    calls.sites[g.id]
}

fn escapes(calls: *DirectCalls, g: *Func) -> bool {
    g.id >= 0 && g.id < calls.escaping.len && calls.escaping[g.id]
}

struct Guess {
    settled: bool = false
    agreed: []Agreement = []
    unlocked: bool = false
}

fn specialise_constants(s: *Specialiser) -> bool {
    let calls = direct_calls(s)
    let guesses = s.guesses(calls)
    var changed: [*Func: bool] = [:]
    var specialised: []bool = []
    for _ in s.program.all {
        specialised.push(false)
    }
    for i, g in s.program.funcs {
        let sites = sites_of(calls, g)
        if escapes(calls, g) || !eligible(s, g, sites) {
            continue
        }
        let untouched = !(changed[g] ?? false) && !any_specialised(sites, specialised)
        let dropped = s.specialise(g, sites, guesses[i], untouched)
        if dropped.len == 0 {
            continue
        }
        drop_parameters(g, sites, dropped)
        specialised[g.id] = true
        changed[g] = true
        for site in sites {
            changed[site.caller] = true
        }
    }
    simplify_all(s, changed)
    changed.len > 0
}

fn guesses(s: *Specialiser, calls: *DirectCalls) -> []Guess {
    let funcs = s.program.funcs
    var found: []Guess = []
    for _ in funcs {
        found.push(Guess {})
    }
    let each = s.runner.each
    each(funcs.len, fn(i: i64) {
        let g = funcs[i]
        let sites = sites_of(calls, g)
        if !escapes(calls, g) && eligible(s, g, sites) {
            found[i] = s.guess(g, sites)
        }
    })
    found
}

fn guess(s: *Specialiser, g: *Func, sites: []CallSite) -> Guess {
    if has_constant_pair(g, sites) {
        return Guess {}
    }
    let agreed = agreed_integers(g, sites)
    if agreed.len == 0 {
        return Guess { settled: true }
    }
    let unlocked = unlocks_folding(s, g, agreed)
    Guess { settled: true, agreed, unlocked }
}

fn any_specialised(sites: []CallSite, specialised: []bool) -> bool {
    for site in sites {
        if specialised[site.caller.id] {
            return true
        }
    }
    false
}

fn specialise(s: *Specialiser, g: *Func, sites: []CallSite, guess: Guess, untouched: bool) -> []i64 {
    if guess.settled && untouched {
        if !guess.unlocked {
            return []
        }
        return become_constants(g, guess.agreed)
    }
    var dropped = specialise_params(g, sites)
    for word in specialise_integers(s, g, sites) {
        dropped.push(word)
    }
    dropped
}

fn eligible(s: *Specialiser, g: *Func, sites: []CallSite) -> bool {
    let main = s.program.main ?? panic("program without main")
    sites.len > 0 && g != main && !slices.contains(s.program.runtime_roots, g) && !g.callback
}

fn simplify_all(s: *Specialiser, changed: [*Func: bool]) {
    var funcs: []*Func = []
    for f in s.program.funcs {
        if changed[f] ?? false {
            funcs.push(f)
            if f.id < s.targets.len {
                s.targets[f.id] = Targets {}
            }
        }
    }
    let rw = s.rw
    let spans = batches(funcs.len)
    let each = s.runner.each
    each(spans.len, fn(k: i64) {
        let span = spans[k]
        for i in span.start..span.start + span.len {
            rw.simplify_body(funcs[i])
        }
    })
}

pub struct DirectCalls {
    pub sites: [][]CallSite = []
    pub escaping: []bool = []
}

struct Targets {
    at: []i64 = []
    fresh: bool = false
}

fn direct_calls(s: *Specialiser) -> *DirectCalls {
    let p = s.program
    let funcs = p.funcs
    for s.targets.len < p.all.len {
        s.targets.push(Targets {})
    }
    let known = s.targets
    let each = s.runner.each
    each(funcs.len, fn(i: i64) {
        let f = funcs[i]
        if !known[f.id].fresh {
            known[f.id] = Targets { at: flat_targets(f), fresh: true }
        }
    })
    var sites: [][]CallSite = []
    var escaping: []bool = []
    for _ in p.all {
        sites.push([])
        escaping.push(false)
    }
    for f in funcs {
        for at in known[f.id].at {
            let target = f.body.values[at].flat_target()
            if f.body.values[at].op != OpCall {
                escaping[target] = true
                continue
            }
            var list = sites[target]
            list.push(CallSite { caller: f, call: at })
            sites[target] = list
        }
    }
    new(DirectCalls { sites, escaping })
}

fn param_aux(g: *Func, param: i64) -> i64 {
    g.body.values[param].aux
}

fn code_env_pair(g: *Func, params: []i64, i: i64) -> bool {
    g.param_aux(params[i + 1]) == g.param_aux(params[i]) + 1
}

fn specialise_params(g: *Func, sites: []CallSite) -> []i64 {
    var dropped: []i64 = []
    var consumed = -1
    let params = flat_params(g)
    for i in 0..params.len - 1 {
        if !code_env_pair(g, params, i) {
            continue
        }
        let param = params[i]
        let env = params[i + 1]
        if consumed == param {
            continue
        }
        let code = agreed_constant(g, g.param_aux(param), sites, is_function) ?? continue
        let capture = agreed_constant(g, g.param_aux(env), sites, is_constant) ?? continue
        dropped.push(g.param_aux(param))
        dropped.push(g.param_aux(env))
        become_copy_of(g, param, code)
        become_copy_of(g, env, capture)
        consumed = env
    }
    dropped
}

pub struct Agreement {
    pub param: i64
    pub constant: Ref
}

fn has_constant_pair(g: *Func, sites: []CallSite) -> bool {
    let params = flat_params(g)
    for i in 0..params.len - 1 {
        if !code_env_pair(g, params, i) {
            continue
        }
        if agreed_constant(g, g.param_aux(params[i]), sites, is_function) == none {
            continue
        }
        if agreed_constant(g, g.param_aux(params[i + 1]), sites, is_constant) != none {
            return true
        }
    }
    false
}

fn agreed_integers(g: *Func, sites: []CallSite) -> []Agreement {
    var agreed: []Agreement = []
    for param in flat_params(g) {
        match agreed_constant(g, g.param_aux(param), sites, is_integer) {
            some(constant) => { agreed.push(Agreement { param, constant }) }
            none => {}
        }
    }
    agreed
}

fn specialise_integers(s: *Specialiser, g: *Func, sites: []CallSite) -> []i64 {
    let agreed = agreed_integers(g, sites)
    if agreed.len == 0 || !unlocks_folding(s, g, agreed) {
        return []
    }
    become_constants(g, agreed)
}

fn become_constants(g: *Func, agreed: []Agreement) -> []i64 {
    var dropped: []i64 = []
    for a in agreed {
        dropped.push(g.param_aux(a.param))
        become_copy_of(g, a.param, a.constant)
    }
    dropped
}

pub fn is_integer(v: FlatValue) -> bool {
    v.op == OpConst && flat_float_bits(v) == 0
}

pub struct Shape {
    pub checks: i64 = 0
    pub blocks: i64 = 0
    pub values: i64 = 0
}

fn shape_of(f: *Func) -> Shape {
    var s = Shape { blocks: f.blocks.len }
    for b in f.blocks {
        for v in b.values {
            match v.op {
                OpCheck => { s.checks += 1 }
                OpConst => {}
                OpParam => {}
                OpUndef => {}
                _ => { s.values += 1 }
            }
        }
    }
    s
}

fn smaller_than(s: Shape, other: Shape) -> bool {
    s.checks < other.checks || s.blocks < other.blocks || s.values < other.values
}

fn unlocks_folding(s: *Specialiser, g: *Func, agreed: []Agreement) -> bool {
    region { s.folds(g, agreed) }
}

fn folds(s: *Specialiser, g: *Func, agreed: []Agreement) -> bool {
    let baseline = s.rw.local_copy(g)
    simplify(s.rw.u, baseline.func)
    let trial = s.rw.local_copy(g)
    for a in agreed {
        s.substitute(trial.values[a.param], a.constant)
    }
    simplify(s.rw.u, trial.func)
    let before = shape_of(baseline.func)
    let after = shape_of(trial.func)
    smaller_than(after, before)
}

fn substitute(s: *Specialiser, v: *Value, constant: Ref) {
    let c = value_of(constant)
    v.op = c.op
    v.aux = c.aux
    v.target = none
    if c.flat_target() >= 0 {
        v.target = s.program.all[c.flat_target()]
    }
    let text = constant.func.flat_text(c)
    v.str = str(constant.func.body.bytes[text.start..text.start + text.len])
    v.float_bits = flat_float_bits(c)
    v.type = s.rw.u.type_of_id(c.flat_type())
    v.scalar = flat_scalar(c)
}

pub fn simplify(u: *types.Universe, f: *Func) {
    let s = new_ssa(u, f)
    finalize(s)
}

fn drop_parameters(g: *Func, sites: []CallSite, dropped: []i64) {
    for param in flat_params(g) {
        g.body.values[param].aux -= count_below(dropped, g.param_aux(param))
    }
    for site in sites {
        drop_words(site.caller, site.call, dropped)
    }
    g.param_words -= dropped.len
}

fn count_below(words: []i64, limit: i64) -> i64 {
    var n = 0
    for w in words {
        if w < limit {
            n += 1
        }
    }
    n
}

fn drop_words(f: *Func, call: i64, dropped: []i64) {
    let args = f.body.values[call].args
    var kept = 0
    for i in 0..args.len {
        if !slices.contains(dropped, i) {
            f.body.ints[args.start + kept] = f.body.ints[args.start + i]
            kept += 1
        }
    }
    f.body.values[call].args = Span { start: args.start, len: kept }
}

pub fn agreed_constant(owner: *Func?, word: i64, sites: []CallSite, accept: fn(FlatValue) -> bool) -> Ref? {
    var agreed: Ref? = none
    for site in sites {
        if word >= site.caller.body.values[site.call].args.len {
            return none
        }
        let arg = arg_ref(site.caller, site.call, word)
        let value = value_of(arg)
        let own_call = match owner {
            some(o) => o == site.caller
            none => false
        }
        if own_call && value.op == OpParam && value.aux == word {
            continue
        }
        if !accept(value) {
            return none
        }
        match agreed {
            none => { agreed = arg }
            some(first) => {
                if !same_constant(first, arg) {
                    return none
                }
            }
        }
    }
    agreed
}

pub fn is_function(v: FlatValue) -> bool {
    v.op == OpFuncAddr && v.flat_target() >= 0 && v.aux == code_addr
}

pub fn is_constant(v: FlatValue) -> bool {
    v.op == OpConst
}

fn same_constant(a: Ref, b: Ref) -> bool {
    let x = value_of(a)
    let y = value_of(b)
    x.op == y.op && x.aux == y.aux && x.flat_target() == y.flat_target() && flat_float_bits(x) == flat_float_bits(y) && same_text(a.func, a.func.flat_text(x), b.func, b.func.flat_text(y))
}

pub fn become_copy_of(g: *Func, at: i64, constant: Ref) {
    let c = value_of(constant)
    let text = copy_text(g, constant.func, constant.func.flat_text(c))
    let extra = g.body.values[at].flat_extra_at()
    if extra >= 0 {
        g.body.extras[extra].str = text
    } else if text.len > 0 {
        g.body.values[at] = g.body.values[at].with_extra(g.body.extras.len)
        g.body.extras.push(FlatExtra { str: text })
    }
    let v = g.body.values[at]
    g.body.values[at] = with_bits(with_type(with_target(FlatValue { op: c.op, args: v.args, aux: c.aux, refs: v.refs, place: v.place, meta: v.meta }, c.flat_target()), c.flat_type()), c.flat_bits())
}
