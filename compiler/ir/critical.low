pub fn split_critical_edges(f: *Func) {
    let count = f.body.blocks.len
    for bi in 0..count {
        let b = f.body.blocks[bi]
        if b.preds.len < 2 || !f.starts_with_phi(b) {
            continue
        }
        for j in 0..b.preds.len {
            let pred = f.body.ints[b.preds.start + j]
            let succs = f.body.blocks[pred].succs
            if succs.len < 2 {
                continue
            }
            let mid = f.add_edge_block(pred, bi)
            for i in succs.start..succs.start + succs.len {
                if f.body.ints[i] == bi {
                    f.body.ints[i] = mid
                }
            }
            f.body.ints[b.preds.start + j] = mid
        }
    }
}

fn starts_with_phi(f: *Func, b: FlatBlock) -> bool {
    b.values.len > 0 && f.body.values[b.values.start].op == OpPhi
}

fn add_edge_block(f: *Func, pred: i64, succ: i64) -> i64 {
    let preds = Span { start: f.body.ints.len, len: 1 }
    f.body.ints.push(pred)
    let succs = Span { start: f.body.ints.len, len: 1 }
    f.body.ints.push(succ)
    let at = f.body.blocks.len
    f.body.blocks.push(FlatBlock {
        id: f.body.block_count
        kind: Plain
        values: Span { start: f.body.values.len, len: 0 }
        results: Span {}
        succs
        preds
    })
    f.body.block_count += 1
    at
}
