pub fn split_critical_edges(p: *Program) {
    for f in p.funcs {
        split_func_critical_edges(f)
    }
}

pub fn split_func_critical_edges(f: *Func) {
    for b in f.blocks {
        if b.preds.len < 2 || !has_phi(b) {
            continue
        }
        for j, pred in b.preds {
            if pred.succs.len < 2 {
                continue
            }
            let mid = new_block(f)
            mid.kind = Plain
            mid.preds = [pred]
            mid.succs = [b]
            for i, s in pred.succs {
                if s == b {
                    pred.succs[i] = mid
                }
            }
            b.preds[j] = mid
        }
    }
}

pub fn has_phi(b: *Block) -> bool {
    b.values.len > 0 && b.values[0].op == OpPhi
}
