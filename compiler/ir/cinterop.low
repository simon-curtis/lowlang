import ast
import types

pub fn c_call(b: *Builder, e: *ast.Call) -> []*Value {
    let target = e.target ?? panic("c call without a target")
    c_invoke(b, target.symbol, target.param_types, types.must(target.ret_type), [], e.args)
}

pub fn c_invoke(b: *Builder, symbol: str, params: []*types.Type, ret: *types.Type, callee: []*Value, exprs: []ast.Expr) -> []*Value {
    var args: []*Value = []
    var arg_types: []*types.Type = []
    var by_ref: []bool = []
    var refs: []*ast.Ref = []
    for i, arg in exprs {
        match arg {
            Ref(r) => {
                let place = place_of(b, r.x)
                push(mut args, address(b, place))
                push(mut arg_types, types.must(r.type))
                push(mut by_ref, true)
                push(mut refs, r)
                continue
            }
            _ => {}
        }
        var t = typ(arg)
        if i < params.len {
            t = params[i]
        }
        var words = value(b, arg, t)
        if t == b.u.f32 && i >= params.len {
            let widened = convert(b, words[0], b.u.f32, b.u.f64)
            words = [widened]
            t = b.u.f64
        }
        for w in words {
            push(mut args, w)
        }
        push(mut arg_types, t)
        push(mut by_ref, false)
    }
    var operands = callee
    for a in args {
        push(mut operands, a)
    }
    let call = emit(b, OpCCall, operands)
    call.sig = new(CSig { symbol, args: arg_types, by_ref, ret })
    var results: []*Value = []
    for k in 0..types.size(ret) {
        let r = emit_result(b, call, k)
        push(mut results, r)
    }
    match types.width(b.u, ret) {
        some(width) => {
            if !types.is_float(width) && results.len == 1 {
                results[0] = convert(b, results[0], b.u.i64, width)
            }
        }
        none => {}
    }
    classify(results, ret)
    for r in refs {
        renormalize(b, r)
    }
    results
}

fn renormalize(b: *Builder, r: *ast.Ref) {
    let t = types.must(r.type)
    let width = types.width(b.u, t) ?? return
    if must_locate(b.u, r.x).width != none {
        return
    }
    var p = place_of(b, r.x)
    p.scalar = width
    let loaded = load_words(b, p, t)
    p.scalar = none
    store_words(b, p, loaded)
}

pub fn c_struct(b: *Builder, e: *ast.StructLit) -> []*Value {
    let t = types.must(e.type)
    let held = slot(b, types.size(t))
    let zero = constant(b, 0)
    for k in 0..types.size(t) {
        store_words(b, Place { addr: held, offset: 8 * k, mem: mem_raw }, [zero])
    }
    for init in e.fields {
        let f = init.field ?? panic("field initialiser without a field")
        let at = Place { addr: held, offset: f.bytes, scalar: types.width(b.u, f.type), tail: types.tail(f.type), mem: mem_raw }
        let stored = value(b, init.value, f.type)
        store_words(b, at, stored)
    }
    load_words(b, Place { addr: held, mem: mem_raw }, t)
}

pub fn c_field(b: *Builder, e: *ast.Selector) -> []*Value {
    let owner = typ(e.x)
    let words = value(b, e.x, owner)
    let held = slot(b, words.len)
    store_words(b, Place { addr: held, mem: mem_raw }, words)
    let f = e.field ?? panic("selector without a field")
    load_words(b, Place { addr: held, offset: f.bytes, scalar: types.width(b.u, f.type), tail: types.tail(f.type), mem: mem_raw }, types.must(e.type))
}

pub fn slot(b: *Builder, words: i64) -> *Value {
    let v = emit(b, OpSlot, [])
    v.aux = b.s.func.slots.len
    push(mut b.s.func.slots, words)
    v
}
