import ast
import parallel
import types

struct Reach {
    u: *types.Universe
    optimise_program: bool
    funcs: [*ast.Func: *Func]
    adapters: [*ast.Func: *Func]
    named: [str: *Func]
    pending: [*Func: Pending]
}

struct Built {
    func: *Func
    targets: []*Func
    cells: i64
}

fn build_reachable(u: *types.Universe, cells: *Counter, optimise_program: bool, funcs: [*ast.Func: *Func], adapters: [*ast.Func: *Func], named: [str: *Func], main: *Func, pending: [*Func: Pending]) -> [*Func: bool] {
    let r = new(Reach { u, optimise_program, funcs, adapters, named, pending })
    let done = build_closure(r, main)
    let order = discovery_order(done, main)
    var base = 0
    var built: [*Func: bool] = [:]
    for f in order {
        let item = done[f] ?? panic("function without a build result")
        if base > 0 && item.cells > 0 {
            offset_cells(f, base)
        }
        base += item.cells
        built[f] = true
    }
    cells.n = base
    built
}

fn build_closure(r: *Reach, main: *Func) -> [*Func: Built] {
    let capacity = r.pending.len + 1
    let jobs = chan[*Func](capacity)
    let results = chan[Built](capacity)
    for _ in 0..parallel.cpus() {
        spawn build_worker(r, jobs, results)
    }
    var scheduled: [*Func: bool] = [main: true]
    var done: [*Func: Built] = [:]
    jobs <- main
    var outstanding = 1
    for outstanding > 0 {
        let item = (<-results) ?? panic("build workers stopped early")
        outstanding -= 1
        done[item.func] = item
        for target in item.targets {
            if scheduled[target] ?? false {
                continue
            }
            scheduled[target] = true
            jobs <- target
            outstanding += 1
        }
    }
    close(jobs)
    done
}

fn build_worker(r: *Reach, jobs: chan[*Func], results: chan[Built]) {
    let ws = new(Workspace {})
    for f in jobs {
        let item = build_one(r, ws, f)
        results <- item
    }
}

fn build_one(r: *Reach, ws: *Workspace, f: *Func) -> Built {
    let entry = r.pending[f] ?? panic("function without a declaration")
    let cells = new(Counter {})
    let b = builder_for(r.u, ws, cells, r.optimise_program, r.funcs, r.adapters, r.named, f, entry.decl)
    if entry.adapter {
        let target = r.funcs[entry.decl] ?? panic("adapter without a target")
        adapter(b, target)
    } else {
        function(b)
    }
    finalize(b.s)
    Built { func: f, targets: buildable_targets(r, f), cells: cells.n }
}

fn buildable_targets(r: *Reach, f: *Func) -> []*Func {
    var targets: []*Func = []
    for v in direct_targets(f) {
        let target = v.target ?? continue
        match r.pending[target] {
            some(_) => { push(mut targets, target) }
            none => {}
        }
    }
    targets
}

fn discovery_order(done: [*Func: Built], main: *Func) -> []*Func {
    var order: []*Func = [main]
    var seen: [*Func: bool] = [main: true]
    var at = 0
    for at < order.len {
        let item = done[order[at]] ?? panic("function without a build result")
        at += 1
        for target in item.targets {
            if seen[target] ?? false {
                continue
            }
            seen[target] = true
            push(mut order, target)
        }
    }
    order
}

fn offset_cells(f: *Func, base: i64) {
    for b in f.blocks {
        for v in b.values {
            if v.op == OpCell {
                v.aux += base
            }
        }
    }
}
