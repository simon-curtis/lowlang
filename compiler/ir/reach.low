import ast
import types

struct Reach {
    u: *types.Universe
    runner: Runner
    optimise_program: bool
    funcs: [*ast.Func: *Func]
    adapters: [*ast.Func: *Func]
    named: [str: *Func]
    pending: [*Func: Pending]
}

struct Built {
    func: *Func
    targets: []*Func
    cells: i64
}

fn build_reachable(u: *types.Universe, cells: *Counter, optimise_program: bool, funcs: [*ast.Func: *Func], adapters: [*ast.Func: *Func], named: [str: *Func], main: *Func, pending: [*Func: Pending], runner: Runner) -> [*Func: bool] {
    let r = new(Reach { u, runner, optimise_program, funcs, adapters, named, pending })
    let done = build_closure(r, main)
    let order = discovery_order(done, main)
    var base = 0
    var built: [*Func: bool] = [:]
    for f in order {
        let item = done[f] ?? panic("function without a build result")
        if base > 0 && item.cells > 0 {
            offset_cells(f, base)
        }
        base += item.cells
        built[f] = true
    }
    cells.n = base
    built
}

fn build_closure(r: *Reach, main: *Func) -> [*Func: Built] {
    var scheduled: [*Func: bool] = [main: true]
    var done: [*Func: Built] = [:]
    var frontier: []*Func = [main]
    for frontier.len > 0 {
        let round = build_round(r, frontier)
        var next: []*Func = []
        for item in round {
            done[item.func] = item
            for target in item.targets {
                if scheduled[target] ?? false {
                    continue
                }
                scheduled[target] = true
                push(mut next, target)
            }
        }
        frontier = next
    }
    done
}

fn build_round(r: *Reach, frontier: []*Func) -> []Built {
    var results: []Built = []
    for f in frontier {
        push(mut results, Built { func: f, targets: [], cells: 0 })
    }
    let each = r.runner.each
    each(frontier.len, fn(i: i64) {
        results[i] = build_one(r, frontier[i])
    })
    results
}

fn build_one(r: *Reach, f: *Func) -> Built {
    let ws = new(Workspace {})
    let entry = r.pending[f] ?? panic("function without a declaration")
    let cells = new(Counter {})
    let b = builder_for(r.u, ws, cells, r.optimise_program, r.funcs, r.adapters, r.named, f, entry.decl)
    if entry.adapter {
        let target = r.funcs[entry.decl] ?? panic("adapter without a target")
        adapter(b, target)
    } else {
        function(b)
    }
    finalize(b.s)
    Built { func: f, targets: buildable_targets(r, f), cells: cells.n }
}

fn buildable_targets(r: *Reach, f: *Func) -> []*Func {
    var targets: []*Func = []
    for v in direct_targets(f) {
        let target = v.target ?? continue
        match r.pending[target] {
            some(_) => { push(mut targets, target) }
            none => {}
        }
    }
    targets
}

fn discovery_order(done: [*Func: Built], main: *Func) -> []*Func {
    var order: []*Func = [main]
    var seen: [*Func: bool] = [main: true]
    var at = 0
    for at < order.len {
        let item = done[order[at]] ?? panic("function without a build result")
        at += 1
        for target in item.targets {
            if seen[target] ?? false {
                continue
            }
            seen[target] = true
            push(mut order, target)
        }
    }
    order
}

fn offset_cells(f: *Func, base: i64) {
    for b in f.blocks {
        for v in b.values {
            if v.op == OpCell {
                v.aux += base
            }
        }
    }
}
