import ast
import types

struct Reach {
    u: *types.Universe
    runner: Runner
    optimise_program: bool
    funcs: [*ast.Func: *Func]
    adapters: [*ast.Func: *Func]
    named: [str: *Func]
    pending: [*Func: Pending]
    all: []*Func
}

struct Built {
    func: *Func
    targets: []*Func
    cells: i64
}

fn build_reachable(u: *types.Universe, cells: *Counter, optimise_program: bool, funcs: [*ast.Func: *Func], adapters: [*ast.Func: *Func], named: [str: *Func], roots: []*Func, pending: [*Func: Pending], all: []*Func, runner: Runner) -> [*Func: bool] {
    let r = new(Reach { u, runner, optimise_program, funcs, adapters, named, pending, all })
    let done = build_closure(r, roots)
    let order = discovery_order(done, roots)
    var base = 0
    var built: [*Func: bool] = [:]
    for f in order {
        let item = done[f] ?? panic("function without a build result")
        if base > 0 && item.cells > 0 {
            offset_cells(f, base)
        }
        base += item.cells
        built[f] = true
    }
    cells.n = base
    built
}

fn build_closure(r: *Reach, roots: []*Func) -> [*Func: Built] {
    var scheduled: [*Func: bool] = [:]
    for root in roots {
        scheduled[root] = true
    }
    var done: [*Func: Built] = [:]
    var frontier = roots
    for frontier.len > 0 {
        let round = build_round(r, frontier)
        var next: []*Func = []
        for item in round {
            done[item.func] = item
            for target in item.targets {
                if scheduled[target] ?? false {
                    continue
                }
                scheduled[target] = true
                next.push(target)
            }
        }
        frontier = next
    }
    done
}

fn build_round(r: *Reach, frontier: []*Func) -> []Built {
    var results: []Built = []
    for f in frontier {
        results.push(Built { func: f, targets: [], cells: 0 })
    }
    let spans = batches(frontier.len)
    let each = r.runner.each
    each(spans.len, fn(k: i64) {
        let span = spans[k]
        for i in span.start..span.start + span.len {
            let f = frontier[i]
            let flat = region { r.build_flat(f) }
            results[i] = r.adopt(f, flat)
        }
    })
    results
}

struct Flat {
    body: Body
    targets: []i64
    cells: i64
}

fn adopt(r: *Reach, f: *Func, flat: Flat) -> Built {
    f.body = flat.body
    var targets: []*Func = []
    for t in flat.targets {
        targets.push(r.all[t])
    }
    Built { func: f, targets, cells: flat.cells }
}

fn build_flat(r: *Reach, f: *Func) -> Flat {
    let ws = new(Workspace {})
    let entry = r.pending[f] ?? panic("function without a declaration")
    let cells = new(Counter {})
    let b = builder_for(r.u, ws, cells, r.optimise_program, r.funcs, r.adapters, r.named, f, entry.decl)
    if entry.adapter {
        let target = r.funcs[entry.decl] ?? panic("adapter without a target")
        adapter(b, target)
    } else {
        function(b)
    }
    finalize(b.s)
    let targets = buildable_targets(r, f)
    let body = flatten_body(f)
    f.blocks = []
    f.slots = []
    Flat { body, targets, cells: cells.n }
}

fn buildable_targets(r: *Reach, f: *Func) -> []i64 {
    var targets: []i64 = []
    for v in direct_targets(f) {
        let target = v.target ?? continue
        match r.pending[target] {
            some(_) => { targets.push(target.id) }
            none => {}
        }
    }
    targets
}

fn discovery_order(done: [*Func: Built], roots: []*Func) -> []*Func {
    var order = roots
    var seen: [*Func: bool] = [:]
    for root in roots {
        seen[root] = true
    }
    var at = 0
    for at < order.len {
        let item = done[order[at]] ?? panic("function without a build result")
        at += 1
        for target in item.targets {
            if seen[target] ?? false {
                continue
            }
            seen[target] = true
            order.push(target)
        }
    }
    order
}

fn offset_cells(f: *Func, base: i64) {
    for i in 0..f.body.values.len {
        if f.body.values[i].op == OpCell {
            f.body.values[i].aux += base
        }
    }
}
