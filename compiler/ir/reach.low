import ast
import types

struct Reach {
    u: *types.Universe
    runner: Runner
    optimise_program: bool
    funcs: [*ast.Func: *Func]
    adapters: [*ast.Func: *Func]
    named: [str: *Func]
    pending: []Pending
}

struct Built {
    func: *Func
    targets: []i64
    cells: i64
}

fn build_reachable(u: *types.Universe, cells: *Counter, optimise_program: bool, funcs: [*ast.Func: *Func], adapters: [*ast.Func: *Func], named: [str: *Func], roots: []*Func, pending: []Pending, all: []*Func, runner: Runner) -> []bool {
    let r = new(Reach { u, runner, optimise_program, funcs, adapters, named, pending })
    var reached: []bool = []
    for _ in all {
        reached.push(false)
    }
    for root in roots {
        reached[root.id] = true
    }
    var base = 0
    var frontier = roots
    for frontier.len > 0 {
        var next: []*Func = []
        for item in build_round(r, frontier) {
            if base > 0 && item.cells > 0 {
                offset_cells(item.func, base)
            }
            base += item.cells
            for target in item.targets {
                if !reached[target] {
                    reached[target] = true
                    next.push(all[target])
                }
            }
        }
        frontier = next
    }
    cells.n = base
    reached
}

fn build_round(r: *Reach, frontier: []*Func) -> []Built {
    var results: []Built = []
    for f in frontier {
        results.push(Built { func: f, targets: [], cells: 0 })
    }
    let each = r.runner.each
    each(frontier.len, fn(i: i64) {
        let f = frontier[i]
        let flat = region { r.build_flat(f) }
        f.body = flat.body
        results[i] = Built { func: f, targets: flat.targets, cells: flat.cells }
        r.release_body(f)
    })
    results
}

struct Flat {
    body: Body
    targets: []i64
    cells: i64
}

fn build_flat(r: *Reach, f: *Func) -> Flat {
    let ws = new(Workspace {})
    let entry = r.pending[f.id]
    let cells = new(Counter {})
    let b = builder_for(r.u, ws, cells, r.optimise_program, r.funcs, r.adapters, r.named, f, entry.decl)
    if entry.adapter {
        let target = r.funcs[entry.decl] ?? panic("adapter without a target")
        adapter(b, target)
    } else {
        function(b)
    }
    finalize(b.s)
    let targets = buildable_targets(r, f)
    let body = flatten_body(f)
    f.blocks = []
    f.slots = []
    Flat { body, targets, cells: cells.n }
}

fn buildable_targets(r: *Reach, f: *Func) -> []i64 {
    var targets: []i64 = []
    for v in direct_targets(f) {
        let target = v.target ?? continue
        targets.push(target.id)
    }
    targets
}

fn offset_cells(f: *Func, base: i64) {
    for i in 0..f.body.values.len {
        if f.body.values[i].op == OpCell {
            f.body.values[i].aux += base
        }
    }
}

fn release_body(r: *Reach, f: *Func) {
    let entry = r.pending[f.id]
    if !entry.adapter {
        entry.decl.body = none
    }
}
