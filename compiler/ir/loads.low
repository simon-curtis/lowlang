struct Available {
    value: *Value
    node: i64
    place: MemoryPlace
    next: i64
}

struct MemoryPlace {
    addr: i64
    aux: i64
    type: i64
    version: i64
}

struct LoadScan {
    doms: *Dominators
    heads: [i64: i64] = [:]
    offered: []Available = []
    exits: []i64 = []
    next: i64 = 0
    forwarded: bool = false
}

pub fn forward_loads(s: *Ssa, doms: *Dominators) -> bool {
    let ls = new(LoadScan { doms })
    for i, b in doms.nodes {
        ls.scan_block(i, b)
    }
    if ls.forwarded {
        resolve_blocks(s)
    }
    ls.forwarded
}

fn scan_block(ls: *LoadScan, node: i64, b: *Block) {
    var version = ls.entry_version(node, b)
    for v in b.values {
        if v.op == OpLoad {
            ls.reuse_load(v, node, version)
            continue
        }
        if !writes_memory(v.op) {
            continue
        }
        version = ls.fresh()
        if v.op == OpStore {
            ls.offer_store(v, node, version)
        }
    }
    if b.poll {
        version = ls.fresh()
    }
    ls.exits.push(version)
}

fn fresh(ls: *LoadScan) -> i64 {
    ls.next += 1
    ls.next
}

fn entry_version(ls: *LoadScan, node: i64, b: *Block) -> i64 {
    if node == 0 || b.preds.len == 0 {
        return ls.fresh()
    }
    let first = ls.exit_of(node, b.preds[0])
    if first < 0 {
        return ls.fresh()
    }
    for p in b.preds {
        if ls.exit_of(node, p) != first {
            return ls.fresh()
        }
    }
    first
}

fn exit_of(ls: *LoadScan, node: i64, pred: *Block) -> i64 {
    let at = ls.doms.index[pred] ?? return -1
    if at >= node {
        return -1
    }
    ls.exits[at]
}

fn reuse_load(ls: *LoadScan, v: *Value, node: i64, version: i64) {
    if v.args.len != 1 || v.mem & mem_trap != 0 {
        return
    }
    let place = memory_place(v, version)
    match ls.oldest_match(v, place, node) {
        some(found) => {
            v.forward = found
            ls.forwarded = true
        }
        none => ls.offer(place, v, node)
    }
}

fn offer_store(ls: *LoadScan, st: *Value, node: i64, version: i64) {
    if st.args.len != 2 || st.type != none || st.mem != 0 {
        return
    }
    let stored = resolve(st.args[1])
    ls.offer(memory_place(st, version), stored, node)
}

fn oldest_match(ls: *LoadScan, v: *Value, place: MemoryPlace, node: i64) -> *Value? {
    var found: *Value? = none
    var at = ls.heads[place_key(place)] ?? -1
    for at >= 0 {
        let a = ls.offered[at]
        if a.place == place && a.value != v && interchangeable(v, a.value) && dominates(ls.doms, a.node, node) {
            found = a.value
        }
        at = a.next
    }
    found
}

fn offer(ls: *LoadScan, place: MemoryPlace, v: *Value, node: i64) {
    let key = place_key(place)
    let next = ls.heads[key] ?? -1
    ls.heads[key] = ls.offered.len
    ls.offered.push(Available { value: v, node, place, next })
}

fn memory_place(v: *Value, version: i64) -> MemoryPlace {
    MemoryPlace { addr: resolve(v.args[0]).id, aux: v.aux, type: type_id(v.type), version }
}

fn place_key(p: MemoryPlace) -> i64 {
    ((p.addr * 1000003 + p.aux) * 1000003 + p.type) * 1000003 + p.version
}

fn interchangeable(v: *Value, found: *Value) -> bool {
    v.float_bits == found.float_bits && (v.scalar || !found.scalar)
}

fn writes_memory(op: Op) -> bool {
    match op {
        OpConst => false
        OpString => false
        OpEmbed => false
        OpEmbedTable => false
        OpParam => false
        OpUndef => false
        OpPhi => false
        OpAdd => false
        OpSub => false
        OpMul => false
        OpDiv => false
        OpRem => false
        OpNeg => false
        OpNot => false
        OpAnd => false
        OpOr => false
        OpXor => false
        OpShl => false
        OpShr => false
        OpCompl => false
        OpConvert => false
        OpSqrt => false
        OpFloor => false
        OpEq => false
        OpNe => false
        OpLt => false
        OpLe => false
        OpGt => false
        OpGe => false
        OpLoad => false
        OpCheck => false
        OpSlot => false
        OpResult => false
        OpFuncAddr => false
        OpMulHigh => false
        OpTrailingZeros => false
        OpHashSeed => false
        OpStaticBlock => false
        _ => true
    }
}
