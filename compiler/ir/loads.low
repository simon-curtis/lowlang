struct Available {
    value: *Value
    node: i64
}

struct LoadScan {
    doms: *Dominators
    avail: [str: []Available] = [:]
    exits: []i64 = []
    next: i64 = 0
    forwarded: bool = false
}

pub fn forward_loads(s: *Ssa) -> bool {
    let doms = func_dominators(s.func)
    let ls = new(LoadScan { doms })
    for i, b in doms.nodes {
        ls.scan_block(i, b)
    }
    if ls.forwarded {
        for b in s.func.blocks {
            resolve_block(s, b)
        }
    }
    ls.forwarded
}

fn scan_block(ls: *LoadScan, node: i64, b: *Block) {
    var version = ls.entry_version(node, b)
    for v in b.values {
        if v.op == OpLoad {
            ls.reuse_load(v, node, version)
            continue
        }
        if !writes_memory(v.op) {
            continue
        }
        version = ls.fresh()
        if v.op == OpStore {
            ls.offer_store(v, node, version)
        }
    }
    if b.poll {
        version = ls.fresh()
    }
    ls.exits.push(version)
}

fn fresh(ls: *LoadScan) -> i64 {
    ls.next += 1
    ls.next
}

fn entry_version(ls: *LoadScan, node: i64, b: *Block) -> i64 {
    if node == 0 || b.preds.len == 0 {
        return ls.fresh()
    }
    let first = ls.exit_of(node, b.preds[0])
    if first < 0 {
        return ls.fresh()
    }
    for p in b.preds {
        if ls.exit_of(node, p) != first {
            return ls.fresh()
        }
    }
    first
}

fn exit_of(ls: *LoadScan, node: i64, pred: *Block) -> i64 {
    let at = ls.doms.index[pred] ?? return -1
    if at >= node {
        return -1
    }
    ls.exits[at]
}

fn reuse_load(ls: *LoadScan, v: *Value, node: i64, version: i64) {
    if v.args.len != 1 || v.mem & mem_trap != 0 {
        return
    }
    let key = memory_key(v, version)
    let found = ls.avail[key] ?? []
    for a in found {
        if a.value != v && interchangeable(v, a.value) && dominates(ls.doms, a.node, node) {
            v.forward = a.value
            ls.forwarded = true
            return
        }
    }
    ls.offer(key, v, node)
}

fn offer_store(ls: *LoadScan, st: *Value, node: i64, version: i64) {
    if st.args.len != 2 || st.type != none || st.mem != 0 {
        return
    }
    let stored = resolve(st.args[1])
    ls.offer(memory_key(st, version), stored, node)
}

fn offer(ls: *LoadScan, key: str, v: *Value, node: i64) {
    var list = ls.avail[key] ?? []
    list.push(Available { value: v, node })
    ls.avail[key] = list
}

fn memory_key(v: *Value, version: i64) -> str {
    let addr = resolve(v.args[0])
    "{addr.id} {v.aux} {type_id(v.type)} {version}"
}

fn interchangeable(v: *Value, found: *Value) -> bool {
    v.float_bits == found.float_bits && (v.scalar || !found.scalar)
}

fn writes_memory(op: Op) -> bool {
    match op {
        OpConst => false
        OpString => false
        OpEmbed => false
        OpParam => false
        OpUndef => false
        OpPhi => false
        OpAdd => false
        OpSub => false
        OpMul => false
        OpDiv => false
        OpRem => false
        OpNeg => false
        OpNot => false
        OpAnd => false
        OpOr => false
        OpXor => false
        OpShl => false
        OpShr => false
        OpCompl => false
        OpConvert => false
        OpSqrt => false
        OpFloor => false
        OpEq => false
        OpNe => false
        OpLt => false
        OpLe => false
        OpGt => false
        OpGe => false
        OpLoad => false
        OpCheck => false
        OpSlot => false
        OpResult => false
        OpFuncAddr => false
        OpMulHigh => false
        OpTrailingZeros => false
        OpHashSeed => false
        OpStaticBlock => false
        _ => true
    }
}
