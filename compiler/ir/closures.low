import std/math
import std/slices

pub struct FunctionGroup {
    pub code: Ref
    pub sites: []CallSite = []
}

struct Cloning {
    clones: []*Func = []
    repointed: []CallSite = []
}

struct ClonePlan {
    param: i64 = -1
    env: i64 = -1
    groups: []FunctionGroup = []
    cost: i64 = 0
}

fn clone_for_functions(s: *Specialiser) -> bool {
    let calls = direct_calls(s)
    let plans = s.clone_plans(calls)
    var changed: [*Func: bool] = [:]
    var funcs: []*Func = []
    for i, g in s.program.funcs {
        funcs.push(g)
        let plan = plans[i]
        if plan.param < 0 {
            continue
        }
        let cloning = clone_groups(s, g, plan)
        for clone in cloning.clones {
            funcs.push(clone)
            changed[clone] = true
        }
        for site in cloning.repointed {
            changed[site.caller] = true
        }
    }
    s.program.funcs = funcs
    simplify_all(s, changed)
    changed.len > 0
}

fn clone_plans(s: *Specialiser, calls: *DirectCalls) -> []ClonePlan {
    let funcs = s.program.funcs
    var plans: []ClonePlan = []
    for _ in funcs {
        plans.push(ClonePlan {})
    }
    s.each_batch(funcs.len, fn(i: i64) {
        let g = funcs[i]
        let sites = sites_of(calls, g)
        if eligible(s, g, sites) {
            plans[i] = clone_plan(g, sites)
        }
    })
    plans
}

fn clone_plan(g: *Func, sites: []CallSite) -> ClonePlan {
    let params = flat_params(g)
    if !has_code_env_pair(g, params) {
        return ClonePlan {}
    }
    let cost = bounded_cost(g, max_clone_source_cost)
    if cost > max_clone_source_cost {
        return ClonePlan {}
    }
    let through = called_through(g)
    for i in 0..params.len - 1 {
        if !code_env_pair(g, params, i) || !through[params[i]] {
            continue
        }
        let param = params[i]
        let env = params[i + 1]
        let groups = group_by_function(sites, g.param_aux(param))
        if worth_cloning(groups, g.param_aux(env)) {
            return ClonePlan { param, env, groups, cost }
        }
    }
    ClonePlan {}
}

fn has_code_env_pair(g: *Func, params: []i64) -> bool {
    for i in 0..params.len - 1 {
        if code_env_pair(g, params, i) {
            return true
        }
    }
    false
}

fn bounded_cost(g: *Func, limit: i64) -> i64 {
    var cost = 0
    let values = g.body.values
    for i in 0..values.len {
        if counts_toward_cost(values[i].op) {
            cost += 1
            if cost > limit {
                return cost
            }
        }
    }
    cost
}

fn clone_groups(s: *Specialiser, g: *Func, plan: ClonePlan) -> Cloning {
    var cloning = Cloning {}
    let cost = plan.cost
    let used = s.clones_of[g] ?? 0
    let allowed = math.max(0, math.min(plan.groups.len, max_clones_per_function - used))
    for group in plan.groups[..allowed] {
        if s.cloned + cost > max_cloned_program_cost {
            break
        }
        let made = clone_for_function(s, g, plan.param, plan.env, group)
        made.name = unique(s, made.name)
        s.cloned += cost
        s.clones_of[g] = (s.clones_of[g] ?? 0) + 1
        cloning.clones.push(made)
        for site in group.sites {
            cloning.repointed.push(site)
        }
    }
    cloning
}

fn unique(s: *Specialiser, name: str) -> str {
    let earlier = s.named[name] ?? 0
    s.named[name] = earlier + 1
    if earlier == 0 {
        return name
    }
    "{name}.{earlier}"
}

fn clone_for_function(s: *Specialiser, g: *Func, param: i64, env: i64, group: FunctionGroup) -> *Func {
    let clone = new(*g)
    clone.body = copy_body(g.body)
    s.program.register(clone)
    let code_target = s.program.all[value_of(group.code).flat_target()]
    let param_word = g.param_aux(param)
    let env_word = g.param_aux(env)
    clone.name = "{g.name}..with{param_word}.{code_target.name}"
    var dropped: []i64 = [param_word]
    become_copy_of(clone, param, group.code)
    match agreed_constant(none, env_word, group.sites, is_constant) {
        some(capture) => {
            become_copy_of(clone, env, capture)
            dropped.push(env_word)
        }
        none => {}
    }
    var sites = slices.clone(group.sites)
    for call in self_calls(clone, g, param, env) {
        sites.push(CallSite { caller: clone, call })
    }
    drop_parameters(clone, sites, dropped)
    for site in sites {
        site.caller.body.values[site.call] = site.caller.body.values[site.call].with_target(clone.id)
    }
    clone
}

fn self_calls(clone: *Func, g: *Func, param: i64, env: i64) -> []i64 {
    let param_word = g.param_aux(param)
    let env_word = g.param_aux(env)
    var calls: []i64 = []
    for at, v in clone.body.values {
        if v.op != OpCall || v.flat_target() != g.id || v.args.len <= env_word {
            continue
        }
        if clone.body.ints[v.args.start + param_word] == param && clone.body.ints[v.args.start + env_word] == env {
            calls.push(at)
        }
    }
    calls
}

fn called_through(g: *Func) -> []bool {
    var through: []bool = []
    for _ in g.body.values {
        through.push(false)
    }
    for v in g.body.values {
        if v.op != OpCall || v.args.len == 0 {
            continue
        }
        var end = v.args.start + v.args.len
        if v.flat_target() < 0 {
            end = v.args.start + 1
        }
        for k in v.args.start..end {
            through[g.body.ints[k]] = true
        }
    }
    through
}

fn group_by_function(sites: []CallSite, word: i64) -> []FunctionGroup {
    var groups: []FunctionGroup = []
    for site in sites {
        if word >= site.caller.body.values[site.call].args.len {
            continue
        }
        let arg = arg_ref(site.caller, site.call, word)
        let value = value_of(arg)
        if !is_function(value) {
            continue
        }
        var k = -1
        for i, g in groups {
            if value_of(g.code).flat_target() == value.flat_target() {
                k = i
                break
            }
        }
        if k < 0 {
            groups.push(FunctionGroup { code: arg })
            k = groups.len - 1
        }
        var members = groups[k].sites
        members.push(site)
        groups[k] = FunctionGroup { code: groups[k].code, sites: members }
    }
    groups
}

fn worth_cloning(groups: []FunctionGroup, env_word: i64) -> bool {
    match groups.len {
        0 => false
        1 => agreed_constant(none, env_word, groups[0].sites, is_constant) == none
        _ => true
    }
}
