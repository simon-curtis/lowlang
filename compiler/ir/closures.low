import std/math
import std/slices

pub struct FunctionGroup {
    pub code: *Value
    pub sites: []CallSite = []
}

struct Cloning {
    clones: []*Func = []
    repointed: []CallSite = []
}

fn clone_for_functions(s: *Specialiser) -> bool {
    let calls = direct_calls(s.program)
    var changed: [*Func: bool] = [:]
    var funcs: []*Func = []
    for g in s.program.funcs {
        push(mut funcs, g)
        let sites = sites_of(calls, g)
        if !eligible(s, g, sites) {
            continue
        }
        let cloning = clone_for_function_arguments(s, g, sites)
        for clone in cloning.clones {
            push(mut funcs, clone)
        }
        for site in cloning.repointed {
            changed[site.caller] = true
        }
    }
    s.program.funcs = funcs
    simplify_all(s, changed)
    changed.len > 0
}

fn clone_for_function_arguments(s: *Specialiser, g: *Func, sites: []CallSite) -> Cloning {
    let cost = cost_of(g)
    if cost > max_clone_source_cost {
        return Cloning {}
    }
    let params = parameters(g)
    for i in 0..params.len - 1 {
        if !code_env_pair(params, i) {
            continue
        }
        let param = params[i]
        let env = params[i + 1]
        if !calls_parameter(g, param) {
            continue
        }
        let groups = group_by_function(sites, param.aux)
        if !worth_cloning(groups, env) {
            continue
        }
        return clone_groups(s, g, param, env, groups, cost)
    }
    Cloning {}
}

fn clone_groups(s: *Specialiser, g: *Func, param: *Value, env: *Value, groups: []FunctionGroup, cost: i64) -> Cloning {
    var cloning = Cloning {}
    let used = s.clones_of[g] ?? 0
    let allowed = math.max(0, math.min(groups.len, max_clones_per_function - used))
    for group in groups[..allowed] {
        if s.cloned + cost > max_cloned_program_cost {
            break
        }
        let made = clone_for_function(s, g, param, env, group)
        s.cloned += cost
        s.clones_of[g] = (s.clones_of[g] ?? 0) + 1
        push(mut cloning.clones, made)
        for site in group.sites {
            push(mut cloning.repointed, site)
        }
    }
    cloning
}

fn clone_for_function(s: *Specialiser, g: *Func, param: *Value, env: *Value, group: FunctionGroup) -> *Func {
    let c = clone_func(g)
    let clone = c.func
    let code_target = group.code.target ?? panic("function group without a target")
    clone.name = "{g.name}..with{param.aux}.{code_target.name}"
    var dropped: []i64 = [param.aux]
    become_copy_of(clone_of(c, param), group.code)
    match agreed_constant(none, env, group.sites, is_constant) {
        some(capture) => {
            become_copy_of(clone_of(c, env), capture)
            push(mut dropped, env.aux)
        }
        none => {}
    }
    var sites = slices.clone(group.sites)
    for call in self_calls(c, g, param, env) {
        push(mut sites, CallSite { call, caller: clone })
    }
    drop_parameters(clone, sites, dropped)
    for site in sites {
        site.call.target = clone
    }
    simplify(s.u, clone)
    clone
}

fn self_calls(c: *FuncClone, g: *Func, param: *Value, env: *Value) -> []*Value {
    let code = clone_of(c, param)
    let capture = clone_of(c, env)
    var calls: []*Value = []
    for b in c.func.blocks {
        for v in b.values {
            if v.op == OpCall && !is_indirect(v) && v.target == g && v.args.len > env.aux && v.args[param.aux] == code && v.args[env.aux] == capture {
                push(mut calls, v)
            }
        }
    }
    calls
}

fn calls_parameter(g: *Func, param: *Value) -> bool {
    for b in g.blocks {
        for v in b.values {
            if v.op != OpCall {
                continue
            }
            if is_indirect(v) && v.args[0] == param {
                return true
            }
            if !is_indirect(v) && slices.contains(v.args, param) {
                return true
            }
        }
    }
    false
}

fn group_by_function(sites: []CallSite, word: i64) -> []FunctionGroup {
    var groups: []FunctionGroup = []
    for site in sites {
        if word >= site.call.args.len {
            continue
        }
        let arg = site.call.args[word]
        if !is_function(arg) {
            continue
        }
        var k = -1
        for i, g in groups {
            if g.code.target == arg.target {
                k = i
                break
            }
        }
        if k < 0 {
            push(mut groups, FunctionGroup { code: arg })
            k = groups.len - 1
        }
        var members = groups[k].sites
        push(mut members, site)
        groups[k] = FunctionGroup { code: groups[k].code, sites: members }
    }
    groups
}

fn worth_cloning(groups: []FunctionGroup, env: *Value) -> bool {
    if groups.len == 0 {
        return false
    }
    if groups.len == 1 {
        return agreed_constant(none, env, groups[0].sites, is_constant) == none
    }
    true
}
