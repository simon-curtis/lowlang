import types

pub const range_depth = 4

pub struct Bound {
    pub value: i64
    pub known: bool
}

pub fn facts_at(o: *Optimizer, at: *Block) -> []Fact {
    var i = o.doms.index[at] ?? return []
    var found: []Fact = []
    for {
        match edge_fact(o, o.doms.nodes[i]) {
            some(f) => { push(mut found, f) }
            none => {}
        }
        if i == 0 {
            return found
        }
        i = o.doms.idom[i]
    }
}

pub fn upper(o: *Optimizer, value: *Value, at: *Block, depth: i64) -> Bound {
    let v = resolve(value)
    var bound = operation_upper(o, v, depth)
    if v.op == OpConst {
        return bound
    }
    for f in facts_at(o, at) {
        if f.unsigned || !same_operand(f.smaller, ref(v)) {
            continue
        }
        let found = operand_upper(o, f.larger, at, depth)
        if !found.known || (!f.or_equal && found.value == min_i64) {
            continue
        }
        var limit = found.value
        if !f.or_equal {
            limit -= 1
        }
        if !bound.known || limit < bound.value {
            bound = Bound { value: limit, known: true }
        }
    }
    bound
}

fn operand_upper(o: *Optimizer, larger: Operand, at: *Block, depth: i64) -> Bound {
    if larger.konst {
        return Bound { value: larger.n, known: true }
    }
    let def = definition(o, larger.id) ?? return Bound { value: 0, known: false }
    if depth == 0 {
        return Bound { value: 0, known: false }
    }
    upper(o, def, at, depth - 1)
}

pub fn operation_upper(o: *Optimizer, v: *Value, depth: i64) -> Bound {
    if v.op == OpConst {
        return Bound { value: v.aux, known: true }
    }
    if unsigned_narrow(v.type) {
        let t = types.must(v.type)
        return Bound { value: (1 << t.bits) - 1, known: true }
    }
    if depth == 0 || !signed_or_untyped(v.type) {
        return Bound { value: 0, known: false }
    }
    if v.op == OpAdd {
        return sum_upper(o, v, depth)
    }
    if v.op == OpMul {
        return product_upper(o, v, depth)
    }
    Bound { value: 0, known: false }
}

struct Uppers {
    x: i64
    y: i64
    ok: bool
}

fn operand_uppers(o: *Optimizer, v: *Value, depth: i64) -> Uppers {
    let a = resolve(v.args[0])
    let b = resolve(v.args[1])
    if !non_negative_unmemoised(o, a) || !non_negative_unmemoised(o, b) {
        return Uppers { x: 0, y: 0, ok: false }
    }
    let x = upper(o, a, v.block, depth - 1)
    let y = upper(o, b, v.block, depth - 1)
    Uppers { x: x.value, y: y.value, ok: x.known && y.known && x.value >= 0 && y.value >= 0 }
}

pub fn sum_upper(o: *Optimizer, v: *Value, depth: i64) -> Bound {
    let u = operand_uppers(o, v, depth)
    if !u.ok || u.x > max_of(v.type) - u.y {
        return Bound { value: 0, known: false }
    }
    Bound { value: u.x + u.y, known: true }
}

fn product_upper(o: *Optimizer, v: *Value, depth: i64) -> Bound {
    let u = operand_uppers(o, v, depth)
    if !u.ok || (u.y != 0 && u.x > max_of(v.type) / u.y) {
        return Bound { value: 0, known: false }
    }
    Bound { value: u.x * u.y, known: true }
}

pub fn bounded_below_by_fact(o: *Optimizer, v: *Value) -> bool {
    let want = ref(v)
    for f in facts_at(o, v.block) {
        if f.unsigned || !same_operand(f.larger, want) || !f.smaller.konst {
            continue
        }
        if f.smaller.n >= 0 || (!f.or_equal && f.smaller.n == -1) {
            return true
        }
    }
    false
}

pub fn product_non_negative(o: *Optimizer, v: *Value) -> bool {
    operation_upper(o, v, range_depth).known
}
