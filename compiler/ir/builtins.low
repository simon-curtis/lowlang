import ast
import builtin
import prelude
import types

pub fn lower_builtin(b: *Builder, e: *ast.Call) -> []*Value {
    match e.builtin {
        Print => print_call(b, e)
        New => allocate(b, e)
        Push => lower_push(b, e)
        Pop => lower_pop(b, e)
        Truncate => lower_truncate(b, e)
        Delete => delete_entry(b, e)
        Bytes => bytes_call(b, e)
        Str => str_call(b, e)
        Cstr => cstr_call(b, e)
        View => view_call(b, e)
        Load => load_call(b, e)
        Store => store_call(b, e)
        Pin => pin_call(b, e)
        Unpin => unpin_call(b, e)
        Embed => embed_call(b, e)
        Sqrt => sqrt_call(b, e)
        Floor => floor_call(b, e)
        Exp => exp_call(b, e)
        Close => close_call(b, e)
        Sleep => sleep_call(b, e)
        WaitReadable => wait_readable_call(b, e)
        WaitWritable => wait_writable_call(b, e)
        StrRaw => str_raw_call(b, e)
        SlicePtr => slice_ptr_call(b, e)
        Bits => bits_call(b, e)
        StrView => str_view_call(b, e)
        Extend => extend(b, e)
        ExtendBy => extend_by(b, e)
        Hash => hash_call(b, e)
        Zero => zero_call(b, e)
        Syscall => syscall_call(b, e)
        MulHi => mulhi_call(b, e)
        Make => make_call(b, e)
        Memmove => memmove_call(b, e)
        Ctz => ctz_call(b, e)
        ClockNanos => clock_nanos_call(b, e)
        HashSeed => hash_seed_call(b, e)
        Argc => argc_call(b)
        Argv => argv_call(b, e)
        Envv => envv_call(b, e)
        Render => render_call(b, e)
        Address => address_call(b, e)
        Serialize => serialize_call(b, e)
        Spawn => spawn_call(b, e)
        Current => current_call(b)
        Park => park_call(b)
        Ready => ready_call(b, e)
        Lock => lock_call(b, e)
        Unlock => unlock_call(b, e)
        Cas => cas_call(b, e)
        Panic => panic_call(b, e)
        Context => context_call(b)
        SetContext => set_context_call(b, e)
        HasContext => has_context_call(b)
        LockThread => lock_thread_call(b)
        UnlockThread => unlock_thread_call(b)
        VLoad => vector_value(b, e)
        VStore => vstore_call(b, e)
        VSplat => vector_value(b, e)
        VMask => vmask_call(b, e)
        VShuffle => vector_value(b, e)
        VSelect => vector_value(b, e)
        VMin => vector_value(b, e)
        VMax => vector_value(b, e)
        VLane => vlane_call(b, e)
        VWith => vector_value(b, e)
        Chan => chan_call(b, e)
        Convert => convert_call(b, e)
        VectorCast => vector_value(b, e)
        _ => panic("ir: no lowering for builtin {e.builtin.index}")
    }
}

fn runtime_word(b: *Builder, entry: Runtime, args: []*Value) -> *Value {
    runtime(b, entry, args) ?? panic("{runtime_symbol(entry)} has no result")
}

fn convert_call(b: *Builder, e: *ast.Call) -> []*Value {
    let from = typ(e.args[0])
    let x = word(b, e.args[0])
    let to = types.must(e.type)
    if from.kind == RawKind || to.kind == RawKind {
        return [x]
    }
    [convert(b, x, from, to)]
}

fn sqrt_call(b: *Builder, e: *ast.Call) -> []*Value {
    let x = word(b, e.args[0])
    [typed(b, OpSqrt, e.type, [x])]
}

fn floor_call(b: *Builder, e: *ast.Call) -> []*Value {
    let x = word(b, e.args[0])
    [typed(b, OpFloor, e.type, [x])]
}

fn embed_call(b: *Builder, e: *ast.Call) -> []*Value {
    let v = emit(b, OpEmbed, [])
    v.str = e.embed
    v.aux = i64(e.digest)
    v.scalar = true
    let size = constant(b, e.size)
    [v, size]
}

fn bytes_call(b: *Builder, e: *ast.Call) -> []*Value {
    let text = value(b, e.args[0], b.u.str)
    call_named(b, prelude.bytes_func, text)
}

fn str_call(b: *Builder, e: *ast.Call) -> []*Value {
    let arg = e.args[0]
    let t = typ(arg)
    if t.kind == RawKind {
        let ptr = word(b, arg)
        return call_named(b, prelude.from_cstr, [ptr])
    }
    let bytes = value(b, arg, t)
    call_named(b, prelude.from_bytes, bytes)
}

fn cstr_call(b: *Builder, e: *ast.Call) -> []*Value {
    let text = value(b, e.args[0], b.u.str)
    call_named(b, prelude.cstr_func, text)
}

fn view_call(b: *Builder, e: *ast.Call) -> []*Value {
    let ptr = word(b, e.args[0])
    let n = word(b, e.args[1])
    slice_of(ptr, n)
}

fn load_call(b: *Builder, e: *ast.Call) -> []*Value {
    let elem = types.must(e.type)
    let ptr = word(b, e.args[0])
    load_words(b, Place { addr: ptr, scalar: types.width(b.u, elem), tail: types.tail(elem), mem: mem_raw | mem_trap }, elem)
}

fn store_call(b: *Builder, e: *ast.Call) -> []*Value {
    let elem = typ(e.args[1])
    let ptr = word(b, e.args[0])
    let stored = value(b, e.args[1], elem)
    store_words(b, Place { addr: ptr, scalar: types.width(b.u, elem), tail: types.tail(elem), mem: mem_raw }, stored)
    []
}

fn pin_call(b: *Builder, e: *ast.Call) -> []*Value {
    let arg = e.args[0]
    let w = value(b, arg, typ(arg))[0]
    runtime(b, RtPin, [w])
    [w]
}

fn unpin_call(b: *Builder, e: *ast.Call) -> []*Value {
    let ptr = word(b, e.args[0])
    runtime(b, RtUnpin, [ptr])
    []
}

fn str_raw_call(b: *Builder, e: *ast.Call) -> []*Value {
    let ptr = word(b, e.args[0])
    let n = word(b, e.args[1])
    [ptr, n]
}

fn slice_ptr_call(b: *Builder, e: *ast.Call) -> []*Value {
    let arg = e.args[0]
    value(b, arg, typ(arg))[..1]
}

fn bits_call(b: *Builder, e: *ast.Call) -> []*Value {
    [word(b, e.args[0])]
}

fn address_call(b: *Builder, e: *ast.Call) -> []*Value {
    [word(b, e.args[0])]
}

fn str_view_call(b: *Builder, e: *ast.Call) -> []*Value {
    let arg = e.args[0]
    value(b, arg, typ(arg))[..2]
}

fn hash_call(b: *Builder, e: *ast.Call) -> []*Value {
    let arg = e.args[0]
    if typ(arg) == b.u.str {
        let text = value(b, arg, b.u.str)
        return call_named(b, prelude.hash_str, text)
    }
    let w = word(b, arg)
    call_named(b, prelude.hash_word, [w])
}

fn zero_call(b: *Builder, e: *ast.Call) -> []*Value {
    let zero = constant(b, 0)
    var words: []*Value = []
    for _ in 0..types.size(types.must(e.type)) {
        push(mut words, zero)
    }
    words
}

fn syscall_call(b: *Builder, e: *ast.Call) -> []*Value {
    var words: []*Value = []
    for arg in e.args {
        let w = word(b, arg)
        push(mut words, w)
    }
    [syscall(b, words)]
}

fn mulhi_call(b: *Builder, e: *ast.Call) -> []*Value {
    let x = word(b, e.args[0])
    let y = word(b, e.args[1])
    [typed(b, OpMulHigh, b.u.u64, [x, y])]
}

fn make_call(b: *Builder, e: *ast.Call) -> []*Value {
    let n = word(b, e.args[0])
    make_slice(b, types.elem_of(types.must(e.type)), n)
}

fn memmove_call(b: *Builder, e: *ast.Call) -> []*Value {
    [copy_slice(b, e)]
}

fn ctz_call(b: *Builder, e: *ast.Call) -> []*Value {
    let x = word(b, e.args[0])
    [typed(b, OpTrailingZeros, b.u.i64, [x])]
}

fn clock_nanos_call(b: *Builder, e: *ast.Call) -> []*Value {
    let clock = word(b, e.args[0])
    [runtime_word(b, RtClockNanos, [clock])]
}

fn hash_seed_call(b: *Builder, e: *ast.Call) -> []*Value {
    let seed = typed(b, OpHashSeed, b.u.u64, [])
    match e.args[0] {
        IntLit(lit) => { seed.aux = lit.value }
        _ => panic("hash seed argument is not an integer literal")
    }
    [seed]
}

fn argc_call(b: *Builder) -> []*Value {
    [runtime_word(b, RtArgc, [])]
}

fn argv_call(b: *Builder, e: *ast.Call) -> []*Value {
    let index = word(b, e.args[0])
    [runtime_word(b, RtArgv, [index])]
}

fn envv_call(b: *Builder, e: *ast.Call) -> []*Value {
    let index = word(b, e.args[0])
    [runtime_word(b, RtEnvv, [index])]
}

fn render_call(b: *Builder, e: *ast.Call) -> []*Value {
    let arg = e.args[0]
    let words = value(b, arg, typ(arg))
    let render = e.render ?? panic("render without a renderer")
    render_string(b, render, words)
}

fn serialize_call(b: *Builder, e: *ast.Call) -> []*Value {
    serialize(b, e)
    []
}

fn print_call(b: *Builder, e: *ast.Call) -> []*Value {
    let arg = e.args[0]
    var text: []*Value = []
    match e.render {
        none => { text = value(b, arg, b.u.str) }
        some(render) => {
            let words = value(b, arg, typ(arg))
            text = render_string(b, render, words)
        }
    }
    runtime(b, RtPrintStr, text)
    []
}

fn chan_call(b: *Builder, e: *ast.Call) -> []*Value {
    var capacity = constant(b, 0)
    if e.args.len == 1 {
        capacity = word(b, e.args[0])
    }
    chan_named(b, prelude.chan_new, types.must(e.type), [capacity])
}

fn close_call(b: *Builder, e: *ast.Call) -> []*Value {
    let c = word(b, e.args[0])
    chan_named(b, prelude.chan_close, typ(e.args[0]), [c])
    []
}

fn sleep_call(b: *Builder, e: *ast.Call) -> []*Value {
    let ms = word(b, e.args[0])
    runtime(b, RtSleep, [ms])
    []
}

fn wait_readable_call(b: *Builder, e: *ast.Call) -> []*Value {
    let fd = word(b, e.args[0])
    runtime(b, RtWaitRead, [fd])
    []
}

fn wait_writable_call(b: *Builder, e: *ast.Call) -> []*Value {
    let fd = word(b, e.args[0])
    runtime(b, RtWaitWrite, [fd])
    []
}

fn spawn_call(b: *Builder, e: *ast.Call) -> []*Value {
    let f = value(b, e.args[0], typ(e.args[0]))
    runtime(b, RtSpawn, f)
    []
}

fn current_call(b: *Builder) -> []*Value {
    [runtime_word(b, RtCurrent, [])]
}

fn park_call(b: *Builder) -> []*Value {
    runtime(b, RtPark, [])
    []
}

fn context_call(b: *Builder) -> []*Value {
    [runtime_word(b, RtContext, [])]
}

fn set_context_call(b: *Builder, e: *ast.Call) -> []*Value {
    let ctx = word(b, e.args[0])
    runtime(b, RtSetContext, [ctx])
    []
}

fn has_context_call(b: *Builder) -> []*Value {
    [runtime_word(b, RtHasContext, [])]
}

fn lock_thread_call(b: *Builder) -> []*Value {
    runtime(b, RtLockThread, [])
    []
}

fn unlock_thread_call(b: *Builder) -> []*Value {
    runtime(b, RtUnlockThread, [])
    []
}

fn ready_call(b: *Builder, e: *ast.Call) -> []*Value {
    let target = word(b, e.args[0])
    runtime(b, RtReady, [target])
    []
}

fn lock_call(b: *Builder, e: *ast.Call) -> []*Value {
    let addr = ref_address(b, e.args[0])
    runtime(b, RtLock, [addr])
    []
}

fn unlock_call(b: *Builder, e: *ast.Call) -> []*Value {
    let addr = ref_address(b, e.args[0])
    runtime(b, RtUnlock, [addr])
    []
}

fn cas_call(b: *Builder, e: *ast.Call) -> []*Value {
    let addr = ref_address(b, e.args[0])
    let old = word(b, e.args[1])
    let next = word(b, e.args[2])
    [runtime_word(b, RtCas, [addr, old, next])]
}

fn panic_call(b: *Builder, e: *ast.Call) -> []*Value {
    let msg = value(b, e.args[0], b.u.str)
    runtime(b, RtPanicMsg, msg)
    b.cur.kind = Unreachable
    dead(b)
    []
}

fn vector_value(b: *Builder, e: *ast.Call) -> []*Value {
    let addr = vector_call(b, e) ?? panic("builtin is not a vector operation")
    load_words(b, Place { addr }, types.must(e.type))
}

fn vstore_call(b: *Builder, e: *ast.Call) -> []*Value {
    let t = typ(e.args[2])
    let dst = vector_address(b, e.args[0], e.args[1], t)
    let source = vec(b, e.args[2])
    emit_vector(b, VectorOp.VCopy, t, [dst, source])
    []
}

fn vmask_call(b: *Builder, e: *ast.Call) -> []*Value {
    let t = typ(e.args[0])
    let source = vec(b, e.args[0])
    let v = typed(b, OpVectorScalar, b.u.u64, [source])
    v.aux = VectorOp.VMask.index
    v.from = t
    [v]
}

fn vlane_call(b: *Builder, e: *ast.Call) -> []*Value {
    let t = typ(e.args[0])
    let source = vec(b, e.args[0])
    let lane = lane_place(b, source, e.args[1], t)
    load_words(b, lane, types.elem_of(t))
}
