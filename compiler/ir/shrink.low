import ast
import types

pub fn lower_pop(b: *Builder, e: *ast.Call) -> []*Value {
    let reference = ref_arg(e.args[0])
    let elem = types.elem_of(types.must(reference.type))
    let header = place_of(b, reference.x)
    let slice = load_words(b, header, b.u.str)
    let temp = new_temp(b)
    let present_block = fresh_block(b)
    let vacant = fresh_block(b)
    let done = fresh_block(b)
    let zero = constant(b, 0)
    let is_empty = emit(b, OpEq, [slice[1], zero])
    branch(b, is_empty, vacant, present_block)
    enter(b, present_block)
    let one = constant(b, 1)
    let last = count(b, OpSub, slice[1], one)
    let addr = scaled(b, slice[0], last, types.stride(elem))
    let popped = load_words(b, Place { addr, scalar: scalar_of(elem), tail: types.tail(elem) }, elem)
    store_words(b, place_at(header, 1), [last])
    let tag = constant(b, 1)
    write_temp(b, temp, slices_of(tag, popped))
    jump(b, done)
    enter(b, vacant)
    let none_tag = constant(b, 0)
    write_temp(b, temp, pad(b, [none_tag], 1 + types.size(elem)))
    jump(b, done)
    enter(b, done)
    read_temp(b, temp, 1 + types.size(elem))
}

fn slices_of(head: *Value, rest: []*Value) -> []*Value {
    var out: []*Value = [head]
    for w in rest {
        push(mut out, w)
    }
    out
}

pub fn lower_truncate(b: *Builder, e: *ast.Call) -> []*Value {
    let reference = ref_arg(e.args[0])
    let header = place_of(b, reference.x)
    let length = word(b, e.args[1])
    let slice = load_words(b, header, b.u.str)
    let one = constant(b, 1)
    let limit = count(b, OpAdd, slice[1], one)
    bounds_check(b, length, limit)
    store_words(b, place_at(header, 1), [length])
    []
}
