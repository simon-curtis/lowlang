import ast
import builtin
import lexer
import types

pub enum VectorOp {
    VCopy = 0
    VAdd = 1
    VSub = 2
    VMul = 3
    VDiv = 4
    VAnd = 5
    VOr = 6
    VXor = 7
    VAndNot = 8
    VMin = 9
    VMax = 10
    VEq = 11
    VNe = 12
    VLt = 13
    VLe = 14
    VGt = 15
    VGe = 16
    VShuffle = 17
    VShl = 18
    VShr = 19
    VNot = 20
    VNeg = 21
    VSplat = 22
    VSelect = 23
    VMask = 24
}

pub fn vector_ops() -> []VectorOp {
    [
        VectorOp.VCopy, VectorOp.VAdd, VectorOp.VSub, VectorOp.VMul, VectorOp.VDiv, VectorOp.VAnd, VectorOp.VOr, VectorOp.VXor,
        VectorOp.VAndNot, VectorOp.VMin, VectorOp.VMax, VectorOp.VEq, VectorOp.VNe, VectorOp.VLt, VectorOp.VLe, VectorOp.VGt,
        VectorOp.VGe, VectorOp.VShuffle, VectorOp.VShl, VectorOp.VShr, VectorOp.VNot, VectorOp.VNeg, VectorOp.VSplat,
        VectorOp.VSelect, VectorOp.VMask,
    ]
}

pub fn vector_op(n: i64) -> VectorOp {
    vector_ops()[n]
}

pub fn vector_op_name(o: VectorOp) -> str {
    match o {
        VCopy => "copy"
        VAdd => "add"
        VSub => "sub"
        VMul => "mul"
        VDiv => "div"
        VAnd => "and"
        VOr => "or"
        VXor => "xor"
        VAndNot => "andnot"
        VMin => "min"
        VMax => "max"
        VEq => "eq"
        VNe => "ne"
        VLt => "lt"
        VLe => "le"
        VGt => "gt"
        VGe => "ge"
        VShuffle => "shuffle"
        VShl => "shl"
        VShr => "shr"
        VNot => "not"
        VNeg => "neg"
        VSplat => "splat"
        VSelect => "select"
        VMask => "mask"
    }
}

fn vector_binary(k: lexer.Kind) -> VectorOp {
    match k {
        Plus => VectorOp.VAdd
        Minus => VectorOp.VSub
        Star => VectorOp.VMul
        Slash => VectorOp.VDiv
        Amp => VectorOp.VAnd
        Pipe => VectorOp.VOr
        Caret => VectorOp.VXor
        Eq => VectorOp.VEq
        NotEq => VectorOp.VNe
        Lt => VectorOp.VLt
        LtEq => VectorOp.VLe
        Gt => VectorOp.VGt
        GtEq => VectorOp.VGe
        Shl => VectorOp.VShl
        Shr => VectorOp.VShr
        _ => panic("ir: no vector operation for {lexer.kind_text(k)}")
    }
}

pub fn is_vector(t: *types.Type) -> bool {
    t.kind == VectorKind
}

fn vector_slot(b: *Builder, t: *types.Type) -> *Value {
    slot(b, types.size(t))
}

pub fn emit_vector(b: *Builder, op: VectorOp, t: *types.Type, args: []*Value) {
    let v = emit(b, OpVector, args)
    v.aux = op.index
    v.type = t
}

pub fn vec(b: *Builder, e: ast.Expr) -> *Value {
    match vector_node(b, e) {
        some(addr) => { return addr }
        none => {}
    }
    match e {
        Ident(id) => {
            match id.local {
                some(local) => {
                    match b.slots[local] {
                        some(held) => { return held }
                        none => {}
                    }
                }
                none => {}
            }
        }
        _ => {}
    }
    let t = typ(e)
    let held = vector_slot(b, t)
    let words = value(b, e, t)
    store_words(b, Place { addr: held }, words)
    held
}

pub fn vector_node(b: *Builder, e: ast.Expr) -> *Value? {
    match e {
        Binary(n) => vector_binary_node(b, n)
        Unary(n) => {
            var op = VectorOp.VNeg
            if n.op == lexer.Kind.Tilde {
                op = VectorOp.VNot
            }
            let t = types.must(n.type)
            let dst = vector_slot(b, t)
            let source = vec(b, n.x)
            emit_vector(b, op, t, [dst, source])
            dst
        }
        Call(n) => vector_call(b, n)
        _ => none
    }
}

fn vector_operand(b: *Builder, e: ast.Expr, splat: bool, t: *types.Type) -> *Value {
    if !splat {
        return vec(b, e)
    }
    let held = vector_slot(b, t)
    let lane = value(b, e, types.elem_of(t))[0]
    emit_vector(b, VectorOp.VSplat, t, [held, lane])
    held
}

fn vector_binary_node(b: *Builder, e: *ast.Binary) -> *Value {
    let t = types.must(e.type)
    let op = vector_binary(e.op)
    let dst = vector_slot(b, t)
    if op == VectorOp.VShl || op == VectorOp.VShr {
        let source = vec(b, e.x)
        let amount = word(b, e.y)
        emit_vector(b, op, t, [dst, source, amount])
        return dst
    }
    let left = vector_operand(b, e.x, e.splat_x, t)
    let right = vector_operand(b, e.y, e.splat_y, t)
    emit_vector(b, op, t, [dst, left, right])
    dst
}

pub fn vector_address(b: *Builder, data: ast.Expr, at: ast.Expr, t: *types.Type) -> *Value {
    let source = typ(data)
    var stride = 1
    if source.kind == SliceKind {
        stride = types.stride(types.elem_of(source))
    }
    let words = value(b, data, source)
    let index = word(b, at)
    let lanes_needed = (types.vector_bytes(t) + stride - 1) / stride
    bounds_check(b, index, words[1])
    let last = constant(b, lanes_needed - 1)
    let end = emit(b, OpAdd, [index, last])
    bounds_check(b, end, words[1])
    scaled(b, words[0], index, stride)
}

pub fn vector_call(b: *Builder, e: *ast.Call) -> *Value? {
    let t = types.must(e.type)
    match e.builtin {
        VShuffle => { return binary_vector_call(b, e, t, VectorOp.VShuffle) }
        VMin => { return binary_vector_call(b, e, t, VectorOp.VMin) }
        VMax => { return binary_vector_call(b, e, t, VectorOp.VMax) }
        VectorCast => {
            let dst = vector_slot(b, t)
            let source = vec(b, e.args[0])
            emit_vector(b, VectorOp.VCopy, t, [dst, source])
            return dst
        }
        VLoad => {
            let dst = vector_slot(b, t)
            let source = vector_address(b, e.args[0], e.args[1], t)
            emit_vector(b, VectorOp.VCopy, t, [dst, source])
            return dst
        }
        VSplat => {
            let dst = vector_slot(b, t)
            let lane = value(b, e.args[0], types.elem_of(t))[0]
            emit_vector(b, VectorOp.VSplat, t, [dst, lane])
            return dst
        }
        VSelect => {
            let dst = vector_slot(b, t)
            let mask = vec(b, e.args[0])
            let yes = vec(b, e.args[1])
            let no = vec(b, e.args[2])
            emit_vector(b, VectorOp.VSelect, t, [dst, mask, yes, no])
            return dst
        }
        VWith => {
            let dst = vector_slot(b, t)
            let source = vec(b, e.args[0])
            emit_vector(b, VectorOp.VCopy, t, [dst, source])
            let lane = lane_place(b, dst, e.args[1], t)
            let stored = value(b, e.args[2], types.elem_of(t))
            store_words(b, lane, stored)
            return dst
        }
        _ => {}
    }
    none
}

fn binary_vector_call(b: *Builder, e: *ast.Call, t: *types.Type, op: VectorOp) -> *Value {
    let dst = vector_slot(b, t)
    let left = vec(b, e.args[0])
    let right = vec(b, e.args[1])
    emit_vector(b, op, t, [dst, left, right])
    dst
}

pub fn lane_place(b: *Builder, addr: *Value, index: ast.Expr, t: *types.Type) -> Place {
    let i = word(b, index)
    let lanes = constant(b, t.lanes)
    bounds_check(b, i, lanes)
    let lane_addr = scaled(b, addr, i, types.lane_bytes(t))
    Place { addr: lane_addr, scalar: types.width(b.u, types.elem_of(t)) }
}

fn vector_target(b: *Builder, p: Place, t: *types.Type) -> *Value {
    match p.addr {
        some(_) => address(b, p)
        none => {
            let dst = vector_slot(b, t)
            let loaded = load_words(b, p, t)
            store_words(b, Place { addr: dst }, loaded)
            dst
        }
    }
}

pub fn assign_vector(b: *Builder, s: *ast.Assign) {
    let t = typ(s.target)
    let p = place_of(b, s.target)
    let dst = vector_target(b, p, t)
    let op = lexer.operator(s.op)
    if op == lexer.Kind.Assign {
        let source = vec(b, s.value)
        emit_vector(b, VectorOp.VCopy, t, [dst, source])
    } else if op == lexer.Kind.Shl || op == lexer.Kind.Shr {
        let amount = word(b, s.value)
        emit_vector(b, vector_binary(op), t, [dst, dst, amount])
    } else {
        let operand = vector_operand(b, s.value, s.splat, t)
        emit_vector(b, vector_binary(op), t, [dst, dst, operand])
    }
    if p.addr == none {
        let result = load_words(b, Place { addr: dst }, t)
        store_words(b, p, result)
    }
}

pub fn bind_vector(b: *Builder, local: *ast.Local, e: ast.Expr) {
    let t = types.must(local.type)
    match e {
        Ident(id) => {
            match id.local {
                some(source) => {
                    if b.slots[source] != none {
                        let held = vector_slot(b, t)
                        let copied = vec(b, e)
                        emit_vector(b, VectorOp.VCopy, t, [held, copied])
                        b.slots[local] = held
                        return
                    }
                }
                none => {}
            }
        }
        _ => {}
    }
    b.slots[local] = vec(b, e)
}
