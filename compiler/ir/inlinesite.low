import std/slices
import types

pub struct InlineSite {
    pub u: *types.Universe
    pub caller: *Func
    pub call: *Value
    pub callee: *Func
    pub head: *Block
    pub tail: *Block? = none
    pub values: [i64: *Value] = [:]
    pub blocks: [i64: *Block] = [:]
    pub slot_base: i64 = 0
    pub returns: []*Block = []
}

pub fn new_inline_site(u: *types.Universe, caller: *Func, call: *Value, callee: *Func) -> *InlineSite {
    new(InlineSite {
        u
        caller
        call
        callee
        head: call.block
    })
}

fn tail_of(s: *InlineSite) -> *Block {
    s.tail ?? panic("inline site without a tail")
}

fn clone_of_block(s: *InlineSite, b: *Block) -> *Block {
    s.blocks[b.id] ?? panic("callee block b{b.id} was not cloned")
}

pub fn expand(s: *InlineSite, results: [i64: *Value]) {
    s.slot_base = s.caller.slots.len
    for n in s.callee.slots {
        push(mut s.caller.slots, n)
    }
    split_head(s)
    clone_callee(s)
    connect_site(s)
    bind_results(s, results)
}

fn split_head(s: *InlineSite) {
    let head = s.head
    let position = slices.index(head.values, s.call) ?? panic("call is not in its block")
    let tail = new_block(s.caller)
    s.tail = tail
    move_terminator(head, tail)
    tail.values = slices.clone(head.values[position + 1..])
    for v in tail.values {
        v.block = tail
    }
    head.values = head.values[..position]
}

fn clone_callee(s: *InlineSite) {
    for b in s.callee.blocks {
        s.blocks[b.id] = new_block(s.caller)
    }
    for b in s.callee.blocks {
        clone_site_values(s, b)
    }
    for b in s.callee.blocks {
        clone_site_block(s, b)
    }
}

fn duplicate_value(f: *Func, b: *Block, v: *Value) -> *Value {
    f.values += 1
    let c = new(*v)
    c.id = f.values
    c.block = b
    c.args = []
    c.uses = 0
    c.forward = none
    c
}

fn clone_site_values(s: *InlineSite, b: *Block) {
    let clone = clone_of_block(s, b)
    for v in b.values {
        if v.op == OpParam {
            s.values[v.id] = s.call.args[v.aux]
            continue
        }
        let c = duplicate_value(s.caller, clone, v)
        if v.op == OpSlot {
            c.aux += s.slot_base
        }
        s.values[v.id] = c
        push(mut clone.values, c)
    }
}

fn map_site_value(s: *InlineSite, v: *Value) -> *Value {
    let source = resolve(v)
    s.values[source.id] ?? panic("callee value v{source.id} was not cloned")
}

fn clone_site_block(s: *InlineSite, b: *Block) {
    let clone = clone_of_block(s, b)
    for v in b.values {
        if v.op == OpParam {
            continue
        }
        let c = map_site_value(s, v)
        var args: []*Value = []
        for a in v.args {
            let mapped = map_site_value(s, a)
            push(mut args, mapped)
        }
        c.args = args
    }
    copy_terminator(clone, b, fn(v: *Value) -> *Value { map_site_value(s, v) }, fn(o: *Block) -> *Block { clone_of_block(s, o) })
    if b.kind == Ret {
        make_return(s, clone)
    }
}

fn make_return(s: *InlineSite, clone: *Block) {
    clone.kind = Plain
    clone.succs = [tail_of(s)]
    push(mut s.returns, clone)
}

fn connect_site(s: *InlineSite) {
    let entry = clone_of_block(s, s.callee.blocks[0])
    entry.preds = [s.head]
    s.head.succs = [entry]
    tail_of(s).preds = slices.clone(s.returns)
}

fn bind_results(s: *InlineSite, results: [i64: *Value]) {
    for k in 0..result_words(s.callee) {
        match results[k] {
            some(result) => {
                let word = returned_word(s, k)
                forward_to(result, word)
            }
            none => {}
        }
    }
    for b in s.returns {
        b.results = []
    }
}

fn returned_word(s: *InlineSite, k: i64) -> *Value {
    if s.returns.len == 1 {
        return s.returns[0].results[k]
    }
    let tail = tail_of(s)
    let node = new_value(s.caller, tail, OpPhi, [])
    for b in s.returns {
        push(mut node.args, b.results[k])
    }
    tail.values = slices.concat([node], tail.values)
    node
}
