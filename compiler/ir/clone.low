import std/slices

pub struct FuncClone {
    pub func: *Func
    pub values: [*Value: *Value] = [:]
    pub blocks: [*Block: *Block] = [:]
}

pub fn clone_func(f: *Func) -> *FuncClone {
    let duplicate = new(*f)
    duplicate.slots = slices.clone(f.slots)
    duplicate.blocks = []
    let c = new(FuncClone { func: duplicate })
    for b in f.blocks {
        let copy = new(Block { id: b.id })
        c.blocks[b] = copy
        push(mut duplicate.blocks, copy)
    }
    for b in f.blocks {
        clone_values(c, b)
    }
    for b in f.blocks {
        connect(c, b)
    }
    c
}

fn block_copy(c: *FuncClone, b: *Block) -> *Block {
    c.blocks[b] ?? panic("block b{b.id} was not cloned")
}

fn clone_values(c: *FuncClone, b: *Block) {
    let target = block_copy(c, b)
    for v in b.values {
        if v.forward != none {
            continue
        }
        let duplicate = new(*v)
        duplicate.block = target
        duplicate.forward = none
        c.values[v] = duplicate
        push(mut target.values, duplicate)
    }
}

pub fn mapped(c: *FuncClone, v: *Value) -> *Value {
    let source = resolve(v)
    c.values[source] ?? panic("v{source.id} was not cloned")
}

fn connect(c: *FuncClone, b: *Block) {
    let target = block_copy(c, b)
    for v in target.values {
        var args: []*Value = []
        for a in v.args {
            let m = mapped(c, a)
            push(mut args, m)
        }
        v.args = args
    }
    copy_terminator(target, b, fn(v: *Value) -> *Value { mapped(c, v) }, fn(o: *Block) -> *Block { block_copy(c, o) })
}
