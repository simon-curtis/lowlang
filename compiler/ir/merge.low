pub fn merge_blocks(s: *Ssa) -> bool {
    var into: [*Block: *Block] = [:]
    for b in s.func.blocks {
        for absorbable(s.func, b) {
            let next = b.succs[0]
            absorb(b, next)
            into[next] = b
        }
    }
    if into.len == 0 {
        return false
    }
    var kept: []*Block = []
    for b in s.func.blocks {
        if !b.merged {
            kept.push(b)
        }
    }
    s.func.blocks = kept
    for b in kept {
        for i, p in b.preds {
            if p.merged {
                b.preds[i] = absorber(into, p)
            }
        }
    }
    true
}

fn absorber(into: [*Block: *Block], merged: *Block) -> *Block {
    var b = merged
    for b.merged {
        b = into[b] ?? panic("merged block without an absorber")
    }
    b
}

fn absorbable(f: *Func, b: *Block) -> bool {
    if b.merged || b.kind != Plain || b.succs.len != 1 {
        return false
    }
    let next = b.succs[0]
    if next == b || next == f.blocks[0] || next.preds.len != 1 || next.merged {
        return false
    }
    next.values.len == 0 || next.values[0].op != OpPhi
}

fn absorb(b: *Block, next: *Block) {
    for v in next.values {
        v.block = b
    }
    for v in next.values {
        b.values.push(v)
    }
    let polls = b.poll
    hand_terminator(next, b)
    b.poll = b.poll || polls
    next.merged = true
    next.values = []
    next.preds = []
}

pub fn move_terminator(from: *Block, to: *Block) {
    hand_terminator(from, to)
    for succ in to.succs {
        for i, p in succ.preds {
            if p == from {
                succ.preds[i] = to
            }
        }
    }
}

fn hand_terminator(from: *Block, to: *Block) {
    to.kind = from.kind
    to.control = from.control
    to.table = from.table
    to.results = from.results
    to.poll = from.poll
    to.succs = from.succs
    from.kind = Plain
    from.control = none
    from.table = none
    from.results = []
    from.poll = false
    from.succs = []
}

pub fn copy_terminator(to: *Block, from: *Block, value: fn(*Value) -> *Value, block: fn(*Block) -> *Block) {
    to.kind = from.kind
    to.table = from.table
    to.poll = from.poll
    match from.control {
        some(c) => { to.control = value(c) }
        none => {}
    }
    for r in from.results {
        let mapped = value(r)
        to.results.push(mapped)
    }
    for p in from.preds {
        let mapped = block(p)
        to.preds.push(mapped)
    }
    for succ in from.succs {
        let mapped = block(succ)
        to.succs.push(mapped)
    }
}
