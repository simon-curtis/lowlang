pub fn merge_blocks(s: *Ssa) -> bool {
    var merged = false
    for b in s.func.blocks {
        for absorbable(s.func, b) {
            absorb(b, b.succs[0])
            merged = true
        }
    }
    if merged {
        var kept: []*Block = []
        for b in s.func.blocks {
            if !b.merged {
                push(mut kept, b)
            }
        }
        s.func.blocks = kept
    }
    merged
}

fn absorbable(f: *Func, b: *Block) -> bool {
    if b.merged || b.kind != Plain || b.succs.len != 1 {
        return false
    }
    let next = b.succs[0]
    if next == b || next == f.blocks[0] || next.preds.len != 1 || next.merged {
        return false
    }
    next.values.len == 0 || next.values[0].op != OpPhi
}

fn absorb(b: *Block, next: *Block) {
    for v in next.values {
        v.block = b
    }
    for v in next.values {
        push(mut b.values, v)
    }
    let polls = b.poll
    move_terminator(next, b)
    b.poll = b.poll || polls
    next.merged = true
    next.values = []
    next.preds = []
}

pub fn move_terminator(from: *Block, to: *Block) {
    to.kind = from.kind
    to.control = from.control
    to.table = from.table
    to.results = from.results
    to.poll = from.poll
    to.succs = from.succs
    for succ in to.succs {
        for i, p in succ.preds {
            if p == from {
                succ.preds[i] = to
            }
        }
    }
    from.kind = Plain
    from.control = none
    from.table = none
    from.results = []
    from.poll = false
    from.succs = []
}

pub fn copy_terminator(to: *Block, from: *Block, value: fn(*Value) -> *Value, block: fn(*Block) -> *Block) {
    to.kind = from.kind
    to.table = from.table
    to.poll = from.poll
    match from.control {
        some(c) => { to.control = value(c) }
        none => {}
    }
    for r in from.results {
        let mapped = value(r)
        push(mut to.results, mapped)
    }
    for p in from.preds {
        let mapped = block(p)
        push(mut to.preds, mapped)
    }
    for succ in from.succs {
        let mapped = block(succ)
        push(mut to.succs, mapped)
    }
}
