import std/slices
import types

pub struct Induction {
    pub phi: *Value
    pub step: i64
    pub init_arg: *Value
    pub inc_idx: i64
    pub init_idx: i64
    pub derived: [i64: *Value] = [:]
}

pub fn reduce_strength(s: *Ssa, l: *Loop) {
    if l.latch == none || l.header.preds.len != 2 {
        return
    }
    for p in slices.clone(l.header.values) {
        if p.op != OpPhi {
            break
        }
        match basic_induction(l, p) {
            some(iv) => { reduce_multiples(s, l, iv) }
            none => {}
        }
    }
}

fn basic_induction(l: *Loop, p: *Value) -> *Induction? {
    let pre = preheader_of(l)
    let latch = l.latch ?? return none
    let init_idx = slices.index(l.header.preds, pre) ?? return none
    let inc_idx = slices.index(l.header.preds, latch) ?? return none
    if p.args.len != 2 || !word_arithmetic(p.args[inc_idx].type) {
        return none
    }
    let inc = p.args[inc_idx]
    if (inc.op != OpAdd && inc.op != OpSub) || inc.args[0] != p || inc.args[1].op != OpConst {
        return none
    }
    var step = inc.args[1].aux
    if inc.op == OpSub {
        step = -step
    }
    new(Induction { phi: p, step, init_arg: p.args[init_idx], inc_idx, init_idx })
}

pub fn word_arithmetic(t: *types.Type?) -> bool {
    match t {
        some(inner) => types.is_integer(inner) && inner.bits == 64
        none => true
    }
}

fn reduce_multiples(s: *Ssa, l: *Loop, iv: *Induction) {
    for b in l.order {
        for v in b.values {
            if v.op == OpMul && v.forward == none && v.args[0] == iv.phi && v.args[1].op == OpConst && word_arithmetic(v.type) {
                let derived = derived_induction(s, l, iv, v)
                forward_to(v, derived)
            }
        }
    }
}

fn derived_induction(s: *Ssa, l: *Loop, iv: *Induction, mul: *Value) -> *Value {
    let stride = mul.args[1].aux
    match iv.derived[stride] {
        some(existing) => return existing
        none => {}
    }
    let latch = l.latch ?? panic("loop without a latch")
    let start = scaled_start(s, l, iv, mul, stride)
    let p = new_value(s.func, l.header, OpPhi, [start, start])
    l.header.values = slices.concat([p], l.header.values)
    let step = constant_in(s, latch, iv.step * stride)
    let next = new_value(s.func, latch, OpAdd, [p, step])
    next.type = mul.type
    next.scalar = mul.scalar
    push(mut latch.values, next)
    p.args[iv.init_idx] = start
    p.args[iv.inc_idx] = next
    iv.derived[stride] = p
    p
}

fn scaled_start(s: *Ssa, l: *Loop, iv: *Induction, mul: *Value, stride: i64) -> *Value {
    let pre = preheader_of(l)
    if iv.init_arg.op == OpConst {
        return constant_in(s, pre, iv.init_arg.aux * stride)
    }
    let factor = constant_in(s, pre, stride)
    let scaled = new_value(s.func, pre, OpMul, [iv.init_arg, factor])
    scaled.type = mul.type
    scaled.scalar = mul.scalar
    push(mut pre.values, scaled)
    scaled
}

pub fn constant_in(s: *Ssa, b: *Block, n: i64) -> *Value {
    let c = new_value(s.func, b, OpConst, [])
    c.aux = n
    c.scalar = true
    push(mut b.values, c)
    c
}
