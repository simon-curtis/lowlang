pub struct Loop {
    pub header: *Block
    pub body: [*Block: bool] = [:]
    pub order: []*Block = []
    pub preheader: *Block? = none
    pub latch: *Block? = none
}

pub fn find_loops(d: *Dominators) -> []*Loop {
    var found: []*Loop = []
    for natural in loops(d) {
        let l = new(Loop { header: natural.header, body: natural.body, order: natural.order })
        settle(l, natural.latches)
        push(mut found, l)
    }
    found
}

fn settle(l: *Loop, latches: []*Block) {
    if latches.len == 1 {
        l.latch = latches[0]
    }
    var outside: []*Block = []
    for p in l.header.preds {
        if !(l.body[p] ?? false) {
            push(mut outside, p)
        }
    }
    if outside.len == 1 && outside[0].kind == Plain && outside[0].succs.len == 1 {
        l.preheader = outside[0]
    }
}

pub fn invariant(l: *Loop, v: *Value) -> bool {
    v.op == OpConst || !(l.body[v.block] ?? false)
}

pub fn invariant_args(l: *Loop, v: *Value) -> bool {
    for a in v.args {
        if !invariant(l, a) {
            return false
        }
    }
    true
}
