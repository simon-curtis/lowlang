import std/math
import std/slices
import types

pub const max_inline_cost = 48
pub const max_inline_loops = 1
pub const free_inline_cost = 6
pub const max_caller_growth = 240
pub const min_program_growth = 6000
pub const max_program_growth = 40000
pub const program_share = 5
pub const loop_reserve_share = 4
pub const max_inline_rounds = 4

pub struct CalleeSummary {
    pub cost: i64 = 0
    pub eligible: bool = false
}

pub struct Inliner {
    pub program: *Program
    pub rw: Reworker
    pub recursive: [*Func: bool] = [:]
    pub summaries: [*Func: CalleeSummary] = [:]
    pub level: [*Func: i64] = [:]
    pub budget: i64
    pub reserve: i64
}

pub fn inline_calls(p: *Program, rw: Reworker, runner: Runner) {
    let budget = program_budget(p)
    let inl = new(Inliner { program: p, rw, budget, reserve: budget / loop_reserve_share })
    for depth, level in call_levels(inl) {
        inline_level(inl, level, depth, runner)
    }
}

struct Pass {
    func: *Func
    grown: i64 = 0
    found: []InlineCandidate = []
    admitted: []InlineCandidate = []
}

fn inline_level(inl: *Inliner, level: []*Func, depth: i64, runner: Runner) {
    var passes: []*Pass = []
    for f in level {
        passes.push(new(Pass { func: f }))
    }
    let each = runner.each
    for _ in 0..max_inline_rounds {
        for pass in passes {
            inl.summarise_callees(pass.func, depth)
        }
        each(passes.len, fn(i: i64) {
            let pass = passes[i]
            pass.found = candidates(inl, pass.func)
        })
        var expanding: []*Pass = []
        for pass in passes {
            inl.admit(pass)
            if pass.admitted.len > 0 {
                expanding.push(pass)
            }
        }
        if expanding.len == 0 {
            return
        }
        each(expanding.len, fn(i: i64) {
            inl.expand_pass(expanding[i])
        })
        passes = expanding
    }
}

fn target_of(inl: *Inliner, f: *Func, at: i64) -> *Func {
    inl.program.all[f.body.values[at].target]
}

fn summarise_callees(inl: *Inliner, f: *Func, depth: i64) {
    for at in flat_targets(f) {
        let target = inl.target_of(f, at)
        if f.body.values[at].op != OpCall || target == f {
            continue
        }
        let below = inl.level[target] ?? depth
        if below < depth {
            summarise(inl, target)
        }
    }
}

fn admit(inl: *Inliner, pass: *Pass) {
    var admitted: []InlineCandidate = []
    for c in pass.found {
        let free = c.cost <= free_inline_cost
        if !free && !admits(inl, c, pass.grown) {
            continue
        }
        admitted.push(c)
        if !free {
            pass.grown += c.cost
            inl.budget -= c.cost
        }
    }
    pass.admitted = admitted
}

fn expand_pass(inl: *Inliner, pass: *Pass) {
    let body = region { inl.expanded(pass) }
    pass.func.body = body
}

fn expanded(inl: *Inliner, pass: *Pass) -> Body {
    let f = pass.func
    let local = inl.rw.local_copy(f)
    let results = results_of(local, pass.found)
    var callees: [i64: *Func] = [:]
    for c in pass.admitted {
        let call = local.values[c.call]
        let target = f.body.values[c.call].target
        let callee = callees[target] ?? inl.inflated_callee(target)
        callees[target] = callee
        let site = new_inline_site(inl.rw.u, local.func, call, callee)
        let words = results[c.call] ?? panic("inline candidate without results")
        expand(site, words)
    }
    simplify(inl.rw.u, local.func)
    flatten_body(local.func)
}

fn inflated_callee(inl: *Inliner, target: i64) -> *Func {
    let local = inl.rw.local_copy(inl.program.all[target])
    local.func
}

fn program_budget(p: *Program) -> i64 {
    var total = 0
    for f in p.funcs {
        total += flat_cost(f)
    }
    math.min(max_program_growth, math.max(min_program_growth, total / program_share))
}

fn direct_callees(inl: *Inliner, f: *Func) -> []*Func {
    var callees: []*Func = []
    for at in flat_targets(f) {
        let target = inl.target_of(f, at)
        if f.body.values[at].op == OpCall && !slices.contains(callees, target) {
            callees.push(target)
        }
    }
    callees
}

pub struct CallGraph {
    pub index: [*Func: i64] = [:]
    pub low: [*Func: i64] = [:]
    pub on_stack: [*Func: bool] = [:]
    pub stack: []*Func = []
    pub next: i64 = 0
    pub levels: [][]*Func = []
    pub level: [*Func: i64] = [:]
    pub recursive: [*Func: bool] = [:]
}

fn call_levels(inl: *Inliner) -> [][]*Func {
    let g = new(CallGraph {})
    for f in inl.program.funcs {
        if g.index[f] == none {
            connect_graph(inl, g, f)
        }
    }
    inl.recursive = g.recursive
    inl.level = g.level
    g.levels
}

fn connect_graph(inl: *Inliner, g: *CallGraph, f: *Func) {
    g.index[f] = g.next
    g.low[f] = g.next
    g.next += 1
    g.stack.push(f)
    g.on_stack[f] = true
    for c in inl.direct_callees(f) {
        if c == f {
            g.recursive[f] = true
        }
        match g.index[c] {
            none => {
                connect_graph(inl, g, c)
                g.low[f] = math.min(g.low[f] ?? 0, g.low[c] ?? 0)
            }
            some(seen) => {
                if g.on_stack[c] ?? false {
                    g.low[f] = math.min(g.low[f] ?? 0, seen)
                }
            }
        }
    }
    if g.low[f] == g.index[f] {
        pop_component(inl, g, f)
    }
}

fn pop_component(inl: *Inliner, g: *CallGraph, root: *Func) {
    var members: []*Func = []
    for {
        let top = g.stack[g.stack.len - 1]
        g.stack.truncate(g.stack.len - 1)
        g.on_stack[top] = false
        members.push(top)
        if top == root {
            break
        }
    }
    if members.len > 1 {
        for m in members {
            g.recursive[m] = true
        }
    }
    var depth = 0
    for m in members {
        for c in inl.direct_callees(m) {
            match g.level[c] {
                some(l) => { depth = math.max(depth, l + 1) }
                none => {}
            }
        }
    }
    for m in members {
        g.level[m] = depth
    }
    for g.levels.len <= depth {
        g.levels.push([])
    }
    for m in members {
        g.levels[depth].push(m)
    }
}

fn summarise(inl: *Inliner, g: *Func) -> CalleeSummary {
    match inl.summaries[g] {
        some(s) => return s
        none => {}
    }
    let s = measure(inl, g)
    inl.summaries[g] = s
    s
}

fn measure(inl: *Inliner, g: *Func) -> CalleeSummary {
    if (inl.recursive[g] ?? false) || g.callback || g.body.blocks[0].preds.len > 0 {
        return CalleeSummary {}
    }
    var loops = 0
    for b in g.body.blocks {
        if b.poll {
            loops += 1
        }
    }
    var cost = 0
    for v in g.body.values {
        if !inlinable_op(v.op) {
            return CalleeSummary {}
        }
        if counts_toward_cost(v.op) {
            cost += 1
        }
    }
    CalleeSummary { cost, eligible: cost <= max_inline_cost && loops <= max_inline_loops }
}

fn inlinable_op(op: Op) -> bool {
    !is_vector_op(op)
}

pub fn counts_toward_cost(op: Op) -> bool {
    match op {
        OpConst => false
        OpParam => false
        OpResult => false
        OpUndef => false
        _ => true
    }
}

pub struct InlineCandidate {
    pub call: i64
    pub id: i64
    pub depth: i64
    pub cost: i64
}

fn admits(inl: *Inliner, c: InlineCandidate, grown: i64) -> bool {
    var available = inl.budget
    if c.depth == 0 {
        available -= inl.reserve
    }
    grown + c.cost <= max_caller_growth && c.cost <= available
}

fn candidates(inl: *Inliner, f: *Func) -> []InlineCandidate {
    var found: []InlineCandidate = []
    var depths: []i64 = []
    var measured = false
    for b in f.body.blocks {
        for at in b.values.start..b.values.start + b.values.len {
            let v = f.body.values[at]
            if v.op != OpCall || v.target < 0 {
                continue
            }
            let target = inl.program.all[v.target]
            if target == f {
                continue
            }
            let summary = inl.summaries[target] ?? continue
            if !summary.eligible || v.args.len != target.param_words {
                continue
            }
            if !measured {
                depths = inl.loop_depths(f)
                measured = true
            }
            found.push(InlineCandidate { call: at, id: v.id, depth: depths[b.id], cost: summary.cost })
        }
    }
    slices.sort_by(mut found, fn(a: InlineCandidate, b: InlineCandidate) -> bool { candidate_before(a, b) })
    found
}

fn candidate_before(a: InlineCandidate, b: InlineCandidate) -> bool {
    if a.depth != b.depth {
        return a.depth > b.depth
    }
    if a.cost != b.cost {
        return a.cost < b.cost
    }
    a.id < b.id
}

fn loop_depths(inl: *Inliner, f: *Func) -> []i64 {
    var polled = false
    for b in f.body.blocks {
        if b.poll {
            polled = true
        }
    }
    if !polled {
        return counts(f.body.block_count)
    }
    region { inl.local_loop_depths(f) }
}

fn local_loop_depths(inl: *Inliner, f: *Func) -> []i64 {
    let local = inl.rw.local_copy(f)
    let depths = counts(f.body.block_count)
    for l in find_loops(func_dominators(local.func)) {
        for b in l.order {
            depths[b.id] += 1
        }
    }
    depths
}

fn results_of(local: Local, found: []InlineCandidate) -> [i64: [i64: *Value]] {
    var at_id: [i64: i64] = [:]
    var results: [i64: [i64: *Value]] = [:]
    for c in found {
        at_id[c.id] = c.call
        results[c.call] = [:]
    }
    for v in local.values {
        if v.op != OpResult {
            continue
        }
        let call = at_id[v.args[0].id] ?? continue
        var words = results[call] ?? [:]
        words[v.aux] = v
        results[call] = words
    }
    results
}
