import std/math
import std/slices
import types

pub const max_inline_cost = 48
pub const max_inline_loops = 1
pub const free_inline_cost = 14
pub const max_single_site_cost = 150
pub const max_caller_growth = 240
pub const min_program_growth = 6000
pub const max_program_growth = 40000
pub const program_share = 5
pub const loop_reserve_share = 4
pub const max_inline_rounds = 4
pub const word_credit = 2

pub struct CalleeSummary {
    pub cost: i64 = 0
    pub inlinable: bool = false
}

pub struct Inliner {
    pub program: *Program
    pub rw: Reworker
    pub recursive: []bool = []
    pub summaries: []CalleeSummary = []
    pub budget: i64
    pub reserve: i64
    pub references: []i64 = []
    pub surveys: []Survey = []
}

struct Survey {
    cost: i64 = 0
    targets: []i64 = []
    callees: []*Func = []
}

pub fn inline_calls(p: *Program, rw: Reworker, runner: Runner) {
    let inl = new(Inliner { program: p, rw, budget: 0, reserve: 0, references: counts(p.all.len) })
    for _ in p.all {
        inl.summaries.push(CalleeSummary {})
    }
    inl.survey_program(runner)
    inl.budget = program_budget(inl)
    inl.reserve = inl.budget / loop_reserve_share
    inl.count_references()
    for level in call_levels(inl) {
        inline_level(inl, level, runner)
    }
}

fn survey_program(inl: *Inliner, runner: Runner) {
    let funcs = inl.program.funcs
    var surveys: []Survey = []
    for _ in inl.program.all {
        surveys.push(Survey {})
    }
    let spans = batches(funcs.len)
    let each = runner.each
    each(spans.len, fn(k: i64) {
        let span = spans[k]
        for i in span.start..span.start + span.len {
            surveys[funcs[i].id] = inl.survey(funcs[i])
        }
    })
    inl.surveys = surveys
}

fn survey(inl: *Inliner, f: *Func) -> Survey {
    var targets: []i64 = []
    var callees: []*Func = []
    for at in flat_targets(f) {
        let v = f.body.values[at]
        targets.push(v.flat_target())
        let target = inl.program.all[v.flat_target()]
        if v.op == OpCall && !slices.contains(callees, target) {
            callees.push(target)
        }
    }
    Survey { cost: flat_cost(f), targets, callees }
}

struct Pass {
    func: *Func
    grown: i64 = 0
    found: []InlineCandidate = []
    admitted: []InlineCandidate = []
    summary: CalleeSummary = CalleeSummary {}
}

fn inline_level(inl: *Inliner, level: []*Func, runner: Runner) {
    var all: []*Pass = []
    for f in level {
        all.push(new(Pass { func: f }))
    }
    var passes = all
    let each = runner.each
    for round in 0..max_inline_rounds + 1 {
        let spans = lightest_last(batches(passes.len), fn(i: i64) -> i64 { passes[i].func.body.values.len })
        each(spans.len, fn(k: i64) {
            let span = spans[k]
            for i in span.start..span.start + span.len {
                inl.advance(passes[i], round)
            }
        })
        if round == max_inline_rounds {
            break
        }
        var expanding: []*Pass = []
        for pass in passes {
            inl.admit(pass)
            if pass.admitted.len > 0 {
                expanding.push(pass)
            }
        }
        if expanding.len == 0 {
            break
        }
        passes = expanding
    }
    for pass in all {
        inl.summaries[pass.func.id] = pass.summary
    }
}

fn advance(inl: *Inliner, pass: *Pass, round: i64) {
    let f = pass.func
    if round > 0 {
        let body = region { inl.expanded(pass) }
        f.body = body
    }
    if round < max_inline_rounds {
        let found = region { candidates(inl, f) }
        pass.found = found
    }
    pass.summary = measure(inl, f)
    inl.surveys[f.id] = inl.survey(f)
}

fn count_references(inl: *Inliner) {
    match inl.program.main {
        some(main) => inl.refer(main.id, 1)
        none => {}
    }
    for root in inl.program.runtime_roots {
        inl.refer(root.id, 1)
    }
    for s in inl.surveys {
        for target in s.targets {
            inl.refer(target, 1)
        }
    }
}

fn refer(inl: *Inliner, target: i64, delta: i64) {
    inl.references[target] += delta
}

fn single_site(inl: *Inliner, target: i64) -> bool {
    inl.references[target] == 1
}

fn admit(inl: *Inliner, pass: *Pass) {
    var admitted: []InlineCandidate = []
    for c in pass.found {
        if !c.free && !admits(inl, c, pass.grown) {
            continue
        }
        admitted.push(c)
        inl.move_references(c.target)
        if !c.free {
            pass.grown += c.cost
            inl.budget -= c.cost
        }
    }
    pass.admitted = admitted
}

fn move_references(inl: *Inliner, target: i64) {
    inl.refer(target, -1)
    for inner in inl.surveys[target].targets {
        inl.refer(inner, 1)
    }
}

fn expanded(inl: *Inliner, pass: *Pass) -> Body {
    let f = pass.func
    let local = inl.rw.local_copy(f)
    let results = results_of(local, pass.found)
    var callees: [i64: *Func] = [:]
    for c in pass.admitted {
        let call = local.values[c.call]
        let target = f.body.values[c.call].flat_target()
        let callee = callees[target] ?? inl.inflated_callee(target)
        callees[target] = callee
        let site = new_inline_site(inl.rw.u, local.func, call, callee)
        let words = results[c.call] ?? panic("inline candidate without results")
        expand(site, words)
    }
    simplify(inl.rw.u, local.func)
    flatten_body(local.func)
}

fn inflated_callee(inl: *Inliner, target: i64) -> *Func {
    let local = inl.rw.local_copy(inl.program.all[target])
    local.func
}

fn program_budget(inl: *Inliner) -> i64 {
    var total = 0
    for s in inl.surveys {
        total += s.cost
    }
    math.min(max_program_growth, math.max(min_program_growth, total / program_share))
}

pub struct CallGraph {
    pub index: []i64 = []
    pub low: []i64 = []
    pub on_stack: []bool = []
    pub stack: []*Func = []
    pub next: i64 = 0
    pub levels: [][]*Func = []
    pub level: []i64 = []
    pub recursive: []bool = []
}

fn call_levels(inl: *Inliner) -> [][]*Func {
    let g = new(CallGraph {})
    for _ in inl.program.all {
        g.index.push(-1)
        g.low.push(0)
        g.on_stack.push(false)
        g.level.push(-1)
        g.recursive.push(false)
    }
    for f in inl.program.funcs {
        if g.index[f.id] < 0 {
            connect_graph(inl, g, f)
        }
    }
    inl.recursive = g.recursive
    g.levels
}

fn connect_graph(inl: *Inliner, g: *CallGraph, f: *Func) {
    g.index[f.id] = g.next
    g.low[f.id] = g.next
    g.next += 1
    g.stack.push(f)
    g.on_stack[f.id] = true
    for c in inl.surveys[f.id].callees {
        if c == f {
            g.recursive[f.id] = true
        }
        if g.index[c.id] < 0 {
            connect_graph(inl, g, c)
            g.low[f.id] = math.min(g.low[f.id], g.low[c.id])
        } else if g.on_stack[c.id] {
            g.low[f.id] = math.min(g.low[f.id], g.index[c.id])
        }
    }
    if g.low[f.id] == g.index[f.id] {
        pop_component(inl, g, f)
    }
}

fn pop_component(inl: *Inliner, g: *CallGraph, root: *Func) {
    var members: []*Func = []
    for {
        let top = g.stack[g.stack.len - 1]
        g.stack.truncate(g.stack.len - 1)
        g.on_stack[top.id] = false
        members.push(top)
        if top == root {
            break
        }
    }
    if members.len > 1 {
        for m in members {
            g.recursive[m.id] = true
        }
    }
    var depth = 0
    for m in members {
        for c in inl.surveys[m.id].callees {
            depth = math.max(depth, g.level[c.id] + 1)
        }
    }
    for m in members {
        g.level[m.id] = depth
    }
    for g.levels.len <= depth {
        g.levels.push([])
    }
    for m in members {
        g.levels[depth].push(m)
    }
}

fn measure(inl: *Inliner, g: *Func) -> CalleeSummary {
    if inl.recursive[g.id] || g.callback || g.body.blocks[0].preds.len > 0 {
        return CalleeSummary {}
    }
    var loops = 0
    for b in g.body.blocks {
        if b.poll {
            loops += 1
        }
    }
    let returned = returned_only(g.body)
    var cost = 0
    for at, v in g.body.values {
        if !inlinable_op(v.op) {
            return CalleeSummary {}
        }
        if counts_toward_cost(v.op) && !(v.op == OpLoad && returned[at] == 1) {
            cost += 1
        }
    }
    CalleeSummary { cost: math.max(math.min(cost, 1), cost - (g.param_words + result_words(g)) / word_credit), inlinable: loops <= max_inline_loops }
}

fn returned_only(body: Body) -> []i64 {
    let uses = counts(body.values.len)
    for v in body.values {
        for k in 0..v.args.len {
            uses[body.ints[v.args.start + k]] = 2
        }
    }
    for b in body.blocks {
        if b.control >= 0 {
            uses[b.control] = 2
        }
        for k in 0..b.results.len {
            let at = body.ints[b.results.start + k]
            if b.kind != Ret {
                uses[at] = 2
            } else if uses[at] == 0 {
                uses[at] = 1
            }
        }
    }
    uses
}

fn inlinable_op(op: Op) -> bool {
    !is_vector_op(op)
}

pub fn counts_toward_cost(op: Op) -> bool {
    match op {
        OpConst => false
        OpParam => false
        OpResult => false
        OpUndef => false
        _ => true
    }
}

pub struct InlineCandidate {
    pub call: i64
    pub id: i64
    pub target: i64
    pub depth: i64
    pub cost: i64
    pub free: bool
}

fn admits(inl: *Inliner, c: InlineCandidate, grown: i64) -> bool {
    var available = inl.budget
    if c.depth == 0 {
        available -= inl.reserve
    }
    grown + c.cost <= max_caller_growth && c.cost <= available
}

fn candidates(inl: *Inliner, f: *Func) -> []InlineCandidate {
    var found: []InlineCandidate = []
    var depths: []i64 = []
    var measured = false
    for b in f.body.blocks {
        for at in b.values.start..b.values.start + b.values.len {
            let v = f.body.values[at]
            if v.op != OpCall || v.flat_target() < 0 {
                continue
            }
            let target = inl.program.all[v.flat_target()]
            if target == f {
                continue
            }
            let summary = inl.summaries[v.flat_target()]
            if !summary.inlinable || v.args.len != target.param_words {
                continue
            }
            let single = inl.single_site(v.flat_target()) && summary.cost <= max_single_site_cost
            if summary.cost > max_inline_cost && !single {
                continue
            }
            if !measured {
                depths = inl.loop_depths(f)
                measured = true
            }
            let free = single || summary.cost <= free_inline_cost
            found.push(InlineCandidate { call: at, id: v.flat_id(), target: v.flat_target(), depth: depths[b.id], cost: summary.cost, free })
        }
    }
    slices.sort_by(mut found, fn(a: InlineCandidate, b: InlineCandidate) -> bool { candidate_before(a, b) })
    found
}

fn candidate_before(a: InlineCandidate, b: InlineCandidate) -> bool {
    if a.depth != b.depth {
        return a.depth > b.depth
    }
    if a.cost != b.cost {
        return a.cost < b.cost
    }
    a.id < b.id
}

fn loop_depths(inl: *Inliner, f: *Func) -> []i64 {
    var polled = false
    for b in f.body.blocks {
        if b.poll {
            polled = true
        }
    }
    if !polled {
        return counts(f.body.block_count)
    }
    let local = inl.rw.local_copy(f)
    let depths = counts(f.body.block_count)
    for l in find_loops(func_dominators(local.func)) {
        for b in l.order {
            depths[b.id] += 1
        }
    }
    depths
}

fn results_of(local: Local, found: []InlineCandidate) -> [i64: [i64: *Value]] {
    var at_id: [i64: i64] = [:]
    var results: [i64: [i64: *Value]] = [:]
    for c in found {
        at_id[c.id] = c.call
        results[c.call] = [:]
    }
    for v in local.values {
        if v.op != OpResult {
            continue
        }
        let call = at_id[v.args[0].id] ?? continue
        var words = results[call] ?? [:]
        words[v.aux] = v
        results[call] = words
    }
    results
}
