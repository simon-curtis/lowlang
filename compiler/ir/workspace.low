import ast
import types

pub struct VarKey {
    pub local: *ast.Local? = none
    pub temp: i64 = 0
    pub word: i64 = 0
}

pub struct PendingPhi {
    pub key: VarKey
    pub phi: *Value
}

pub struct Workspace {
    pub variables: [i64: *Value] = [:]
    pub sealed: [i64: bool] = [:]
    pub incomplete: [i64: []PendingPhi] = [:]
    pub local_ids: [*ast.Local: i64] = [:]
    pub func_ids: [*Func: i64] = [:]
}

pub struct Ssa {
    pub func: *Func
    pub ws: *Workspace
    pub u: *types.Universe
}

pub fn flags(n: i64) -> []bool {
    var words: []bool = []
    for _ in 0..n {
        push(mut words, false)
    }
    words
}

pub fn counts(n: i64) -> []i64 {
    var words: []i64 = []
    for _ in 0..n {
        push(mut words, 0)
    }
    words
}

pub fn ssa_for(ws: *Workspace, u: *types.Universe, func: *Func) -> *Ssa {
    ws.variables = [:]
    ws.sealed = [:]
    ws.incomplete = [:]
    ws.local_ids = [:]
    new(Ssa { func, ws, u })
}

pub fn new_ssa(u: *types.Universe, func: *Func) -> *Ssa {
    ssa_for(new(Workspace {}), u, func)
}

fn variable_number(ws: *Workspace, k: VarKey) -> i64 {
    match k.local {
        some(l) => {
            match ws.local_ids[l] {
                some(id) => id * 2 + 1
                none => {
                    let id = ws.local_ids.len + 1
                    ws.local_ids[l] = id
                    id * 2 + 1
                }
            }
        }
        none => k.temp * 2
    }
}

pub fn def_key(ws: *Workspace, k: VarKey, block: i64) -> i64 {
    let number = variable_number(ws, k)
    if number >= 1 << 20 || k.word >= 1 << 22 || block >= 1 << 21 {
        panic("ir: variable key out of range")
    }
    ((number << 22) | k.word) << 21 | block
}

pub fn is_sealed(ws: *Workspace, b: *Block) -> bool {
    ws.sealed[b.id] ?? false
}

pub fn mark_sealed(ws: *Workspace, b: *Block) {
    ws.sealed[b.id] = true
}

pub fn add_incomplete(ws: *Workspace, b: *Block, p: PendingPhi) {
    var list = ws.incomplete[b.id] ?? []
    push(mut list, p)
    ws.incomplete[b.id] = list
}

pub fn take_incomplete(ws: *Workspace, b: *Block, i: i64) -> PendingPhi? {
    let list = ws.incomplete[b.id] ?? return none
    if i >= list.len {
        return none
    }
    list[i]
}

pub fn drop_incomplete(ws: *Workspace, b: *Block) {
    ws.incomplete[b.id] = []
}
