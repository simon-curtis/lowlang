import types

pub fn optimise(p: *Program, u: *types.Universe) {
    specialise_constant_arguments(p, u)
    inline_calls(p, u)
    let reachable = reachable_from_main(p)
    keep_reachable(p, reachable)
}

fn reachable_from_main(p: *Program) -> [*Func: bool] {
    var seen: [*Func: bool] = [:]
    let main = p.main ?? panic("program without main")
    var work: []*Func = [main]
    for work.len > 0 {
        let f = work[work.len - 1]
        truncate(mut work, work.len - 1)
        if seen[f] ?? false {
            continue
        }
        seen[f] = true
        for v in direct_targets(f) {
            let target = v.target ?? continue
            push(mut work, target)
        }
    }
    seen
}

fn keep_reachable(p: *Program, reachable: [*Func: bool]) {
    var kept: []*Func = []
    for f in p.funcs {
        if reachable[f] ?? false {
            push(mut kept, f)
        }
    }
    p.funcs = kept
}
