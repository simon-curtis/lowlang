import types

pub fn optimise(p: *Program, u: *types.Universe, runner: Runner) {
    let rw = Reworker { u, program: p }
    runner.mark("specialise")
    specialise_constant_arguments(p, rw, runner)
    runner.mark("inline")
    inline_calls(p, rw, runner)
    let reachable = reachable_from_main(p)
    keep_reachable(p, reachable)
}

fn reachable_from_main(p: *Program) -> []bool {
    var seen: []bool = []
    for _ in p.all {
        seen.push(false)
    }
    var work = program_roots(p)
    for work.len > 0 {
        let f = work[work.len - 1]
        work.truncate(work.len - 1)
        if seen[f.id] {
            continue
        }
        seen[f.id] = true
        for at in flat_targets(f) {
            work.push(p.all[f.body.values[at].flat_target()])
        }
    }
    seen
}

fn keep_reachable(p: *Program, reachable: []bool) {
    var kept: []*Func = []
    for f in p.funcs {
        if reachable[f.id] {
            kept.push(f)
        }
    }
    p.funcs = kept
    for f in p.all {
        if !reachable[f.id] {
            f.body = Body {}
        }
    }
}
