import ast
import prelude
import types

fn module_digest(path: str) -> u64 {
    var h: u64 = 14695981039346656037
    for i in 0..path.len {
        h = h ^ u64(path[i])
        h = h * 1099511628211
    }
    h
}

fn launch_call(b: *Builder, e: *ast.Call) -> []*Value {
    let made = e.call_launch() ?? panic("launch has no kernel")
    for s in made.lets {
        stmt(b, s)
    }
    let started = word(b, made.made)
    let k = b.funcs[made.kernel] ?? panic("launch of an undeclared kernel {made.kernel.name}")
    let layout = kernel_layout(k.params)
    let image = emit(b, OpEmbed, [])
    image.str = kernel_module_path(k)
    image.aux = i64(module_digest(image.str))
    image.scalar = true
    let _ = call_named(b, prelude.launch_module, [started, image, constant(b, layout.bytes), constant(b, kernel_group), constant(b, kernel_row)])
    for i in 1..k.params.len {
        launch_operand(b, started, layout, i, k.params[i], made.operands[i - 1])
    }
    [started]
}

fn launch_operand(b: *Builder, started: *Value, layout: *KernelLayout, i: i64, p: Param, operand: ast.Expr) {
    let at = constant(b, layout.members[layout.operands[i].member].offset)
    if p.type.kind == SliceKind {
        let held = value(b, operand, p.type)
        let stride = constant(b, types.stride(p.type.elem_of()))
        let _ = call_named(b, prelude.launch_slice, [started, at, held[0], held[1], stride, constant(b, if p.mutable { 1 } else { 0 })])
        return
    }
    if !p.type.scalar() {
        return
    }
    let wide = layout.members[layout.operands[i].member].wide
    let _ = call_named(b, prelude.launch_scalar, [started, at, word(b, operand), constant(b, if wide { 1 } else { 0 })])
}
