pub struct Runner {
    pub each: fn(i64, fn(i64))
    pub stage: fn(str)
}

pub fn sequential() -> Runner {
    Runner { each: run_each, stage: unstaged }
}

pub fn unstaged(name: str) {}

pub fn mark(r: Runner, name: str) {
    let stage = r.stage
    stage(name)
}

fn run_each(count: i64, job: fn(i64)) {
    for i in 0..count {
        job(i)
    }
}
