struct Elision {
    f: *Func
    uses: []i64
    dropped: [i64: bool] = [:]
    hoisted: [i64: *Value] = [:]
}

pub fn elide_result_copies(s: *Ssa) -> bool {
    let f = s.func
    if f.slots.len == 0 {
        return false
    }
    let e = new(Elision { f, uses: live_uses(f) })
    var changed = false
    for b in f.blocks {
        var redirected = false
        for i in 0..b.values.len {
            if e.redirect_result(b, i) {
                redirected = true
            }
        }
        if redirected {
            e.drop_copies(b)
            changed = true
        }
    }
    changed
}

fn drop_copies(e: *Elision, b: *Block) {
    var kept: []*Value = []
    for v in b.values {
        match e.hoisted[v.id] {
            some(to) => kept.push(to)
            none => {}
        }
        if e.dropped[v.id] == none {
            kept.push(v)
        }
    }
    b.values = kept
}

fn live_uses(f: *Func) -> []i64 {
    let all = counts(f.values + 1)
    for b in f.blocks {
        for v in b.values {
            count_args(all, v)
        }
    }
    let live = counts(f.values + 1)
    for b in f.blocks {
        for v in b.values {
            if v.op != OpLoad || all[v.id] > 0 {
                count_args(live, v)
            }
        }
        match b.control {
            some(c) => { live[resolve(c).id] += 1 }
            none => {}
        }
        for r in b.results {
            live[resolve(r).id] += 1
        }
    }
    live
}

fn count_args(into: []i64, v: *Value) {
    for a in v.args {
        into[resolve(a).id] += 1
    }
}

fn redirect_result(e: *Elision, b: *Block, at: i64) -> bool {
    let call = b.values[at]
    if call.op != OpCall || call.args.len == 0 || !returns_by_reference(call_signature(call)) {
        return false
    }
    let held = resolve(call.args[call.args.len - 1])
    if held.op != OpSlot || e.uses[held.id] != 2 {
        return false
    }
    var j = at + 1
    for j < b.values.len {
        let w = b.values[j]
        if copy_bytes(w) > 0 && resolve(w.args[1]) == held {
            return e.retarget_result(b, at, j)
        }
        if writes_memory(w.op) {
            return false
        }
        j += 1
    }
    false
}

fn retarget_result(e: *Elision, b: *Block, at: i64, copied: i64) -> bool {
    let call = b.values[at]
    let copy = b.values[copied]
    let held = resolve(copy.args[1])
    if copy_bytes(copy) != 8 * e.f.slots[held.aux] {
        return false
    }
    let to = resolve(copy.args[0])
    let root = base(to).root
    if !e.owned_destination(root) {
        return false
    }
    for k in 0..call.args.len - 1 {
        if base(resolve(call.args[k])).root == root {
            return false
        }
    }
    for k in at + 1..copied {
        let w = b.values[k]
        if w.op == OpLoad && base(resolve(w.args[0])).root == root {
            return false
        }
    }
    let later = defined_after(b, at, to)
    if later && to.args.len > 0 {
        return false
    }
    if later {
        e.hoisted[call.id] = to
        e.dropped[to.id] = true
    }
    call.args[call.args.len - 1] = to
    e.dropped[copy.id] = true
    true
}

fn owned_destination(e: *Elision, root: *Value) -> bool {
    if root.op == OpSlot {
        return true
    }
    root.op == OpParam && returns_by_reference(e.f) && root.aux == e.f.param_words - 1
}

fn defined_after(b: *Block, at: i64, v: *Value) -> bool {
    for k in at + 1..b.values.len {
        if b.values[k] == v {
            return true
        }
    }
    false
}
