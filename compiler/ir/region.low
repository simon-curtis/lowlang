import ast

fn lower_region(b: *Builder, e: *ast.Region) -> []*Value {
    let handle = runtime_word(b, RtRegionEnter, [])
    var words = lower_block(b, e.body)
    runtime(b, RtRegionLeave, [handle])
    match e.copy {
        some(copy) => { words = duplicate(b, copy, words) }
        none => {}
    }
    runtime(b, RtRegionFree, [handle])
    words
}

fn duplicate(b: *Builder, f: *ast.Func, words: []*Value) -> []*Value {
    let path = empty_slice(b)
    var args: []*Value = [path]
    for w in words {
        push(mut args, w)
    }
    let target = b.funcs[f] ?? panic("region copy {f.name} is undeclared")
    invoke(b, target, args)
}
