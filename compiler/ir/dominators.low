pub struct Dominators {
    pub nodes: []*Block = []
    pub index: [*Block: i64] = [:]
    pub idom: []i64 = []
    pub children: [][]i64 = []
}

pub fn new_dominators(entry: *Block) -> *Dominators {
    let d = new(Dominators {})
    let tree = d.order(entry)
    let n = d.nodes.len
    var preds: [][]i64 = []
    for w in tree.pre {
        var from: []i64 = []
        for p in w.preds {
            let v = tree.number[p] ?? continue
            from.push(v)
        }
        preds.push(from)
    }
    let idom = immediate_dominators(tree.parent, preds)
    for _ in 0..n {
        d.idom.push(0)
        d.children.push([])
    }
    for w in 1..n {
        d.idom[d.index[tree.pre[w]] ?? 0] = d.index[tree.pre[idom[w]]] ?? 0
    }
    for i in 1..n {
        var list = d.children[d.idom[i]]
        list.push(i)
        d.children[d.idom[i]] = list
    }
    d
}

pub fn func_dominators(f: *Func) -> *Dominators {
    new_dominators(f.blocks[0])
}

pub fn dominates(d: *Dominators, a: i64, b: i64) -> bool {
    var at = b
    for at > a {
        at = d.idom[at]
    }
    a == at
}

pub fn is_reducible(d: *Dominators) -> bool {
    for i, b in d.nodes {
        for s in b.succs {
            let to = d.index[s] ?? continue
            if to <= i && !dominates(d, to, i) {
                return false
            }
        }
    }
    true
}

struct DfsTree {
    pre: []*Block = []
    parent: []i64 = []
    number: [*Block: i64] = [:]
}

fn order(d: *Dominators, entry: *Block) -> DfsTree {
    var tree = DfsTree { pre: [entry], parent: [0] }
    tree.number[entry] = 0
    var post: []*Block = []
    var stack: []*Block = [entry]
    var cursor: []i64 = [0]
    for stack.len > 0 {
        let top = stack.len - 1
        let node = stack[top]
        let at = cursor[top]
        if at < node.succs.len {
            cursor[top] = at + 1
            let next = node.succs[at]
            if (tree.number[next] ?? -1) < 0 {
                tree.number[next] = tree.pre.len
                tree.parent.push(tree.number[node] ?? 0)
                tree.pre.push(next)
                stack.push(next)
                cursor.push(0)
            }
        } else {
            post.push(node)
            stack.truncate(top)
            cursor.truncate(top)
        }
    }
    var i = post.len - 1
    for i >= 0 {
        d.index[post[i]] = d.nodes.len
        d.nodes.push(post[i])
        i -= 1
    }
    tree
}

pub fn immediate_dominators(parent: []i64, preds: [][]i64) -> []i64 {
    let n = parent.len
    var semi: []i64 = []
    var label: []i64 = []
    var ancestor: []i64 = []
    var idom: []i64 = []
    for v in 0..n {
        semi.push(v)
        label.push(v)
        ancestor.push(-1)
        idom.push(parent[v])
    }
    var path: []i64 = []
    var w = n - 1
    for w > 0 {
        for v in preds[w] {
            let u = eval_label(mut ancestor, mut label, semi, mut path, v)
            if semi[u] < semi[w] {
                semi[w] = semi[u]
            }
        }
        ancestor[w] = parent[w]
        w -= 1
    }
    for v in 1..n {
        var x = idom[v]
        for x > semi[v] {
            x = idom[x]
        }
        idom[v] = x
    }
    idom
}

fn eval_label(mut ancestor: []i64, mut label: []i64, semi: []i64, mut path: []i64, v: i64) -> i64 {
    if ancestor[v] < 0 {
        return v
    }
    path.truncate(0)
    var x = v
    for ancestor[ancestor[x]] >= 0 {
        path.push(x)
        x = ancestor[x]
    }
    var k = path.len
    for k > 0 {
        k -= 1
        let y = path[k]
        let a = ancestor[y]
        if semi[label[a]] < semi[label[y]] {
            label[y] = label[a]
        }
        ancestor[y] = ancestor[a]
    }
    label[v]
}
