pub struct Dominators {
    pub nodes: []*Block = []
    pub index: [*Block: i64] = [:]
    pub idom: []i64 = []
    pub children: [][]i64 = []
}

pub fn new_dominators(entry: *Block) -> *Dominators {
    let d = new(Dominators {})
    order(d, entry)
    let n = d.nodes.len
    for _ in 0..n {
        push(mut d.idom, -1)
    }
    d.idom[0] = 0
    var changed = true
    for changed {
        changed = false
        for i in 1..n {
            if refine_idom(d, i) {
                changed = true
            }
        }
    }
    for _ in 0..n {
        push(mut d.children, [])
    }
    for i in 1..n {
        if d.idom[i] >= 0 {
            var list = d.children[d.idom[i]]
            push(mut list, i)
            d.children[d.idom[i]] = list
        }
    }
    d
}

pub fn func_dominators(f: *Func) -> *Dominators {
    new_dominators(f.blocks[0])
}

pub fn dominates(d: *Dominators, a: i64, b: i64) -> bool {
    var at = b
    for at > a {
        at = d.idom[at]
    }
    a == at
}

pub fn is_reducible(d: *Dominators) -> bool {
    for i, b in d.nodes {
        for s in b.succs {
            let to = d.index[s] ?? continue
            if to <= i && !dominates(d, to, i) {
                return false
            }
        }
    }
    true
}

fn order(d: *Dominators, entry: *Block) {
    var seen: [*Block: bool] = [:]
    var post: []*Block = []
    var stack: []*Block = [entry]
    var cursor: []i64 = [0]
    seen[entry] = true
    for stack.len > 0 {
        let top = stack.len - 1
        let node = stack[top]
        let at = cursor[top]
        if at < node.succs.len {
            cursor[top] = at + 1
            let next = node.succs[at]
            if !(seen[next] ?? false) {
                seen[next] = true
                push(mut stack, next)
                push(mut cursor, 0)
            }
        } else {
            push(mut post, node)
            truncate(mut stack, top)
            truncate(mut cursor, top)
        }
    }
    var i = post.len - 1
    for i >= 0 {
        d.index[post[i]] = d.nodes.len
        push(mut d.nodes, post[i])
        i -= 1
    }
}

fn refine_idom(d: *Dominators, i: i64) -> bool {
    var next = -1
    for p in d.nodes[i].preds {
        let pi = d.index[p] ?? continue
        if d.idom[pi] < 0 {
            continue
        }
        if next < 0 {
            next = pi
            continue
        }
        next = intersect(d, pi, next)
    }
    if next == d.idom[i] {
        return false
    }
    d.idom[i] = next
    true
}

pub fn intersect(d: *Dominators, x: i64, y: i64) -> i64 {
    var a = x
    var b = y
    for a != b {
        for a > b {
            a = d.idom[a]
        }
        for b > a {
            b = d.idom[b]
        }
    }
    a
}
