import std/slices

pub struct NaturalLoop {
    pub header: *Block
    pub latches: []*Block = []
    pub body: [*Block: bool] = [:]
    pub order: []*Block = []
}

pub fn loops(d: *Dominators) -> []*NaturalLoop {
    var found: []*NaturalLoop = []
    for i, header in d.nodes {
        let latches = back_edge_sources(d, i)
        if latches.len == 0 {
            continue
        }
        let l = new(NaturalLoop { header, latches })
        l.body[header] = true
        collect(d, l)
        push(mut found, l)
    }
    slices.sort_stable_by(mut found, fn(a: *NaturalLoop, b: *NaturalLoop) -> bool { a.body.len < b.body.len })
    found
}

fn back_edge_sources(d: *Dominators, header: i64) -> []*Block {
    var sources: []*Block = []
    for p in d.nodes[header].preds {
        let pi = d.index[p] ?? continue
        if dominates(d, header, pi) {
            push(mut sources, p)
        }
    }
    sources
}

fn collect(d: *Dominators, l: *NaturalLoop) {
    var work = slices.clone(l.latches)
    for work.len > 0 {
        let n = work[work.len - 1]
        truncate(mut work, work.len - 1)
        if l.body[n] ?? false {
            continue
        }
        l.body[n] = true
        for p in n.preds {
            if d.index[p] != none {
                push(mut work, p)
            }
        }
    }
    for n in d.nodes {
        if l.body[n] ?? false {
            push(mut l.order, n)
        }
    }
}
