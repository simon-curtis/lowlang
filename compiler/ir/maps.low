import lexer
import prelude
import ast
import std/slices
import types

pub fn map_call(b: *Builder, name: str, m: *types.Type, args: []*Value) -> []*Value {
    let instance = types.instance_name(name, [types.key_of(m), types.elem_of(m)])
    call_named(b, instance, args)
}

fn with_key(b: *Builder, table: *Value, key: ast.Expr, m: *types.Type, rest: []*Value) -> []*Value {
    let words = value(b, key, types.key_of(m))
    slices.concat(slices.concat([table], words), rest)
}

pub fn map_lit(b: *Builder, e: *ast.MapLit) -> []*Value {
    match hoisted_map(b, e) {
        some(found) => found.words
        none => filled_map(b, e)
    }
}

fn filled_map(b: *Builder, e: *ast.MapLit) -> []*Value {
    let m = types.must(e.type)
    let table = map_call(b, prelude.map_new, m, [])[0]
    for i, k in e.keys {
        let entry = value(b, e.values[i], types.elem_of(m))
        let args = with_key(b, table, k, m, entry)
        map_call(b, prelude.map_set, m, args)
    }
    [table]
}

pub fn lookup(b: *Builder, e: *ast.Index) -> []*Value {
    let m = typ(e.x)
    let table = word(b, e.x)
    let args = with_key(b, table, e.index, m, [])
    map_call(b, prelude.map_get, m, args)
}

pub fn assign_entry(b: *Builder, s: *ast.Assign) {
    let entry = s.entry ?? panic("assignment without an entry")
    let m = typ(entry.x)
    let elem = types.elem_of(m)
    var stored = value(b, s.value, elem)
    let table = word(b, entry.x)
    let key = with_key(b, table, entry.index, m, [])
    let op = lexer.operator(s.op)
    if op != lexer.Kind.Assign {
        let current = map_call(b, prelude.map_get, m, key)
        let old = present(b, current, types.size(elem))
        stored = compound(b, op, elem, old, stored)
    }
    let args = slices.concat(key, stored)
    map_call(b, prelude.map_set, m, args)
}

fn present(b: *Builder, optional: []*Value, words: i64) -> []*Value {
    let temp = new_temp(b)
    let found = fresh_block(b)
    let done = fresh_block(b)
    var zero: []*Value = []
    for _ in 0..words {
        let z = constant(b, 0)
        push(mut zero, z)
    }
    write_temp(b, temp, zero)
    branch(b, optional[0], found, done)
    enter(b, found)
    write_temp(b, temp, optional[1..1 + words])
    jump(b, done)
    enter(b, done)
    read_temp(b, temp, words)
}

pub fn delete_entry(b: *Builder, e: *ast.Call) -> []*Value {
    let reference = ref_arg(e.args[0])
    let m = types.must(reference.type)
    let table = load_words(b, place_of(b, reference.x), m)[0]
    let args = with_key(b, table, e.args[1], m, [])
    map_call(b, prelude.map_delete, m, args)
    []
}

pub fn ref_arg(e: ast.Expr) -> *ast.Ref {
    match e {
        Ref(r) => r
        _ => panic("argument is not a reference")
    }
}

pub fn map_loop(b: *Builder, s: *ast.ForIn) {
    let m = typ(s.iter)
    let table = word(b, s.iter)
    let cursor = new_temp(b)
    let start = constant(b, 0)
    let first = map_call(b, prelude.map_next, m, [table, start])
    write_temp(b, cursor, first)
    let loop = open_loop(b)
    let at = read_temp(b, cursor, 1)[0]
    let zero = constant(b, 0)
    let exhausted = emit(b, OpLt, [at, zero])
    branch(b, exhausted, loop.exit, loop.body)
    enter(b, loop.body)
    let key = map_call(b, prelude.map_key, m, [table, at])
    match s.key_local {
        none => { bind_loop_value(b, s, key) }
        some(key_local) => {
            bind(b, key_local, key)
            let entry = map_call(b, prelude.map_value, m, [table, at])
            bind_loop_value(b, s, entry)
        }
    }
    loop_body(b, loop, s.body)
    let one = constant(b, 1)
    let from = emit(b, OpAdd, [at, one])
    let next = map_call(b, prelude.map_next, m, [table, from])
    write_temp(b, cursor, next)
    close_loop(b, loop)
}
