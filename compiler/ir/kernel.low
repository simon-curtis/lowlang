import types

pub fn kernel_builds(p: *Program, u: *types.Universe, runner: Runner) -> []*Func {
    let rw = Reworker { u, program: p }
    var kernels: []*Func = []
    for f in p.funcs {
        if f.kernel {
            kernels.push(new(*f))
        }
    }
    let each = runner.each
    each(kernels.len, fn(i: i64) {
        let body = region { rw.without_calls(kernels[i]) }
        kernels[i].body = body
    })
    kernels
}

fn without_calls(rw: Reworker, k: *Func) -> Body {
    let local = rw.local_copy(k)
    for {
        let call = direct_call(local.func) ?? break
        let target = call.target ?? panic("direct call without a target")
        let site = new_inline_site(rw.u, local.func, call, rw.local_copy(target).func)
        expand(site, call_results(local.func, call))
    }
    simplify(rw.u, local.func)
    flatten_body(local.func)
}

fn direct_call(f: *Func) -> *Value? {
    for b in f.blocks {
        for v in b.values {
            if v.op == OpCall && v.target != none {
                return v
            }
        }
    }
    none
}

fn call_results(f: *Func, call: *Value) -> [i64: *Value] {
    let words: [i64: *Value] = [:]
    for b in f.blocks {
        for v in b.values {
            if v.op == OpResult && v.args[0] == call {
                words[v.aux] = v
            }
        }
    }
    words
}

pub const kernel_module_prefix = "kernel module "

pub fn kernel_module_path(k: *Func) -> str {
    "{kernel_module_prefix}{k.name}"
}

pub struct KernelMember {
    pub wide: bool
    pub offset: i64
}

pub struct KernelOperand {
    pub slice: bool = false
    pub member: i64 = 0
    pub buffer: i64 = 0
}

pub struct KernelLayout {
    pub members: []KernelMember = []
    pub operands: []KernelOperand = []
    pub buffers: i64 = 0
    pub bytes: i64 = 0
}

fn add_member(layout: *KernelLayout, wide: bool) -> i64 {
    let size = if wide { 8 } else { 4 }
    let offset = (layout.bytes + size - 1) / size * size
    layout.members.push(KernelMember { wide, offset })
    layout.bytes = offset + size
    layout.members.len - 1
}

fn wide_scalar(t: *types.Type) -> bool {
    (t.kind == IntKind || t.kind == FloatKind) && t.bits == 64
}

pub fn kernel_layout(params: []Param) -> *KernelLayout {
    let layout = new(KernelLayout {})
    layout.operands.push(KernelOperand { member: layout.add_member(false) })
    for p in params[1..] {
        if p.type.kind == SliceKind {
            layout.operands.push(KernelOperand { slice: true, buffer: layout.buffers })
            layout.buffers += 1
            continue
        }
        layout.operands.push(KernelOperand { member: layout.add_member(wide_scalar(p.type)) })
    }
    for i in 1..layout.operands.len {
        if layout.operands[i].slice {
            layout.operands[i].member = layout.add_member(false)
        }
    }
    layout
}
