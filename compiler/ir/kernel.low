import types

pub fn kernel_builds(p: *Program, u: *types.Universe, runner: Runner) -> []*Func {
    let rw = Reworker { u, program: p }
    var kernels: []*Func = []
    for f in p.funcs {
        if f.kernel {
            kernels.push(new(*f))
        }
    }
    let each = runner.each
    each(kernels.len, fn(i: i64) {
        let body = region { rw.without_calls(kernels[i]) }
        kernels[i].body = body
    })
    kernels
}

fn without_calls(rw: Reworker, k: *Func) -> Body {
    let local = rw.local_copy(k)
    for {
        let call = direct_call(local.func) ?? break
        let target = call.target ?? panic("direct call without a target")
        let site = new_inline_site(rw.u, local.func, call, rw.local_copy(target).func)
        expand(site, call_results(local.func, call))
    }
    simplify(rw.u, local.func)
    flatten_body(local.func)
}

fn direct_call(f: *Func) -> *Value? {
    for b in f.blocks {
        for v in b.values {
            if v.op == OpCall && v.target != none {
                return v
            }
        }
    }
    none
}

fn call_results(f: *Func, call: *Value) -> [i64: *Value] {
    let words: [i64: *Value] = [:]
    for b in f.blocks {
        for v in b.values {
            if v.op == OpResult && v.args[0] == call {
                words[v.aux] = v
            }
        }
    }
    words
}
