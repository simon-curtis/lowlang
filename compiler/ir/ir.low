import diag
import std/builder
import std/slices
import types

pub enum Op {
    OpConst = 0
    OpString = 1
    OpEmbed = 2
    OpParam = 3
    OpUndef = 4
    OpPhi = 5
    OpAdd = 6
    OpSub = 7
    OpMul = 8
    OpDiv = 9
    OpRem = 10
    OpNeg = 11
    OpNot = 12
    OpAnd = 13
    OpOr = 14
    OpXor = 15
    OpShl = 16
    OpShr = 17
    OpCompl = 18
    OpConvert = 19
    OpSqrt = 20
    OpFloor = 21
    OpEq = 22
    OpNe = 23
    OpLt = 24
    OpLe = 25
    OpGt = 26
    OpGe = 27
    OpLoad = 28
    OpStore = 29
    OpCheck = 30
    OpSlot = 31
    OpCall = 32
    OpCCall = 33
    OpRuntime = 34
    OpSyscall = 35
    OpResult = 36
    OpFuncAddr = 37
    OpMulHigh = 38
    OpVector = 39
    OpVectorScalar = 40
    OpTrailingZeros = 41
    OpHashSeed = 42
    OpCell = 43
}

pub const code_addr = 0
pub const thunk_addr = 1
pub const symbol_addr = 2

pub fn op_name(o: Op) -> str {
    match o {
        OpConst => "const"
        OpString => "string"
        OpEmbed => "embed"
        OpParam => "param"
        OpUndef => "undef"
        OpPhi => "phi"
        OpAdd => "add"
        OpSub => "sub"
        OpMul => "mul"
        OpDiv => "div"
        OpRem => "rem"
        OpNeg => "neg"
        OpNot => "not"
        OpAnd => "and"
        OpOr => "or"
        OpXor => "xor"
        OpShl => "shl"
        OpShr => "shr"
        OpCompl => "compl"
        OpConvert => "convert"
        OpSqrt => "sqrt"
        OpFloor => "floor"
        OpEq => "eq"
        OpNe => "ne"
        OpLt => "lt"
        OpLe => "le"
        OpGt => "gt"
        OpGe => "ge"
        OpLoad => "load"
        OpStore => "store"
        OpCheck => "check"
        OpSlot => "slot"
        OpCall => "call"
        OpCCall => "ccall"
        OpRuntime => "runtime"
        OpSyscall => "syscall"
        OpResult => "result"
        OpFuncAddr => "funcaddr"
        OpMulHigh => "mulhigh"
        OpVector => "vector"
        OpVectorScalar => "vectorscalar"
        OpTrailingZeros => "ctz"
        OpHashSeed => "hashseed"
        OpCell => "cell"
    }
}

pub fn is_compare(o: Op) -> bool {
    o.index >= Op.OpEq.index && o.index <= Op.OpGe.index
}

pub fn is_call(o: Op) -> bool {
    o == OpCall || o == OpCCall || o == OpRuntime || o == OpSyscall
}

pub fn is_vector_op(o: Op) -> bool {
    o == OpVector || o == OpVectorScalar
}

pub fn has_result(o: Op) -> bool {
    !is_call(o) && o != OpStore && o != OpCheck && o != OpVector
}

pub const max_i64 = 9223372036854775807
pub const min_i64 = -9223372036854775807 - 1

pub const mem_raw = 1
pub const mem_trap = 2

pub struct Value {
    pub id: i64
    pub op: Op
    pub args: []*Value = []
    pub block: *Block
    pub aux: i64 = 0
    pub str: str = ""
    pub runtime: Runtime? = none
    pub target: *Func? = none
    pub sig: *CSig? = none
    pub type: *types.Type? = none
    pub from: *types.Type? = none
    pub scalar: bool = false
    pub float_bits: i64 = 0
    pub signature: *Func? = none
    pub mem: i64 = 0
    pub uses: i64 = 0
    pub forward: *Value? = none
}

pub enum Kind {
    Plain
    If
    Ret
    Unreachable
    Switch
}

pub struct JumpTable {
    pub low: i64
    pub cases: []i64 = []
}

pub fn table_index(t: *JumpTable, control: i64) -> i64 {
    let offset = u64(control) - u64(t.low)
    if offset >= u64(t.cases.len) {
        return 0
    }
    t.cases[offset]
}

pub struct Block {
    pub id: i64
    pub kind: Kind = Plain
    pub values: []*Value = []
    pub control: *Value? = none
    pub table: *JumpTable? = none
    pub results: []*Value = []
    pub succs: []*Block = []
    pub preds: []*Block = []
    pub poll: bool = false
    pub merged: bool = false
}

pub struct Param {
    pub type: *types.Type
    pub mutable: bool
}

pub struct Capture {
    pub type: *types.Type
    pub boxed: bool
}

pub struct Func {
    pub name: str
    pub param_words: i64 = 0
    pub ret: *types.Type
    pub params: []Param = []
    pub captures: []Capture = []
    pub callback: bool = false
    pub c_params: []*types.Type = []
    pub blocks: []*Block = []
    pub slots: []i64 = []
    pub values: i64 = 0
    pub block_ids: i64 = 0
}

pub fn result_words(f: *Func) -> i64 {
    types.size(f.ret)
}

pub struct Program {
    pub c_symbols: []str = []
    pub imports: [str: []str] = [:]
    pub funcs: []*Func = []
    pub main: *Func? = none
    pub main_err: *types.Type? = none
    pub cells: i64 = 0
}

pub fn libraries(p: *Program) -> []str {
    var names: []str = []
    for name in p.imports {
        push(mut names, name)
    }
    slices.sort(mut names)
    names
}

pub struct CSig {
    pub symbol: str
    pub args: []*types.Type = []
    pub by_ref: []bool = []
    pub ret: *types.Type
}

pub fn new_block(f: *Func) -> *Block {
    let b = new(Block { id: f.block_ids })
    f.block_ids += 1
    push(mut f.blocks, b)
    b
}

pub fn new_value(f: *Func, b: *Block, op: Op, args: []*Value) -> *Value {
    f.values += 1
    new(Value { id: f.values, op, args, block: b })
}

pub fn direct_targets(f: *Func) -> []*Value {
    var found: []*Value = []
    for b in f.blocks {
        for v in b.values {
            if (v.op == OpCall || v.op == OpFuncAddr) && v.target != none {
                push(mut found, v)
            }
        }
    }
    found
}

pub fn is_indirect(v: *Value) -> bool {
    v.op == OpCall && v.target == none
}

pub fn call_signature(v: *Value) -> *Func {
    match v.target {
        some(t) => t
        none => v.signature ?? panic("call without a signature")
    }
}

pub fn text(f: *Func) -> str {
    var out = builder.builder()
    write_func(mut out, f)
    out.to_str()
}

pub fn write_func(mut out: builder.Builder, f: *Func) {
    out.write("fn {f.name} params={f.param_words} results={result_words(f)} slots=")
    write_ints(mut out, f.slots)
    out.write_byte('\n')
    for b in f.blocks {
        write_block(mut out, b)
    }
}

fn write_ints(mut out: builder.Builder, list: []i64) {
    out.write_byte('[')
    for i, n in list {
        if i > 0 {
            out.write_byte(' ')
        }
        out.write_i64(n)
    }
    out.write_byte(']')
}

fn write_blocks(mut out: builder.Builder, list: []*Block) {
    out.write_byte('[')
    for i, b in list {
        if i > 0 {
            out.write_byte(' ')
        }
        out.write_byte('b')
        out.write_i64(b.id)
    }
    out.write_byte(']')
}

fn write_values(mut out: builder.Builder, list: []*Value) {
    out.write_byte('[')
    for i, v in list {
        if i > 0 {
            out.write_byte(' ')
        }
        out.write_byte('v')
        out.write_i64(v.id)
    }
    out.write_byte(']')
}

fn control_of(b: *Block) -> *Value {
    b.control ?? panic("block b{b.id} has no control value")
}

fn write_block(mut out: builder.Builder, b: *Block) {
    out.write("b{b.id}: preds=")
    write_blocks(mut out, b.preds)
    out.write_byte('\n')
    for v in b.values {
        out.write("  ")
        write_describe(mut out, v)
        out.write_byte('\n')
    }
    match b.kind {
        Plain => out.write("  jump b{b.succs[0].id}\n")
        If => out.write("  if v{control_of(b).id} then b{b.succs[0].id} else b{b.succs[1].id}\n")
        Switch => {
            let table = b.table ?? panic("switch without a table")
            out.write("  switch v{control_of(b).id} low {table.low} table ")
            write_ints(mut out, table.cases)
            out.write(" default b{b.succs[0].id} targets ")
            write_blocks(mut out, b.succs[1..])
            out.write_byte('\n')
        }
        Ret => {
            out.write("  ret ")
            write_values(mut out, b.results)
            out.write_byte('\n')
        }
        Unreachable => out.write("  unreachable\n")
    }
}

fn type_name(t: *types.Type?) -> str {
    match t {
        some(inner) => types.text(inner)
        none => "<nil>"
    }
}

fn write_describe(mut out: builder.Builder, v: *Value) {
    out.write("v{v.id} = {op_name(v.op)}")
    var detail = ""
    match v.op {
        OpConst => { detail = " #{v.aux}" }
        OpParam => { detail = " #{v.aux}" }
        OpSlot => { detail = " #{v.aux}" }
        OpResult => { detail = " #{v.aux}" }
        OpLoad => { detail = " #{v.aux}" }
        OpStore => { detail = " #{v.aux}" }
        OpHashSeed => { detail = " #{v.aux}" }
        OpCell => { detail = " #{v.aux}" }
        OpString => { detail = " {diag.quote(v.str)}" }
        OpEmbed => { detail = " {diag.quote(v.str)}" }
        OpRuntime => { detail = " {value_symbol(v)}" }
        OpSyscall => { detail = " {value_symbol(v)}" }
        OpCall => { detail = " {call_signature(v).name}" }
        OpFuncAddr => {
            detail = " {v.str}"
            match v.target {
                some(t) => { detail = " {t.name}" }
                none => {}
            }
        }
        OpCCall => {
            let sig = v.sig ?? panic("ccall without a signature")
            detail = " {sig.symbol}"
        }
        OpConvert => { detail = " {type_name(v.from)}->{type_name(v.type)}" }
        OpVector => { detail = " {vector_op_name(vector_op(v.aux))}" }
        OpVectorScalar => { detail = " {vector_op_name(vector_op(v.aux))}" }
        _ => {}
    }
    match v.type {
        some(t) => {
            if v.op != OpConvert {
                detail = "{detail}:{types.text(t)}"
            }
        }
        none => {}
    }
    out.write(detail)
    out.write_byte(' ')
    write_values(mut out, v.args)
}

fn value_symbol(v: *Value) -> str {
    let entry = v.runtime ?? panic("runtime call without an entry")
    runtime_symbol(entry)
}
