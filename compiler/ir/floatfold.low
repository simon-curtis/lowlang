import std/text
import types

pub const sign_bit_64 = -9223372036854775807 - 1
pub const sign_bit_32 = 2147483648
pub const two_pow_63 = 9223372036854775808.0

pub fn fold_float(v: *Value) {
    match v.op {
        OpAdd => fold_float_binary(v)
        OpSub => fold_float_binary(v)
        OpMul => fold_float_binary(v)
        OpDiv => fold_float_binary(v)
        OpNeg => fold_float_negate(v)
        OpSqrt => fold_float_unary(v)
        OpFloor => fold_float_unary(v)
        _ => {}
    }
}

fn float_operand(c: *Value, bits: i64) -> f64? {
    if c.op != OpConst {
        return none
    }
    let f = float_from_bits(c.aux, bits)
    if f != f {
        return none
    }
    f
}

pub fn float_from_bits(n: i64, bits: i64) -> f64 {
    if bits == 32 {
        return f64(text.float32_from_bits(u32(n)))
    }
    text.float_from_bits(u64(n))
}

pub fn float_bits(bits: i64, f: f64) -> i64 {
    if bits == 32 {
        return i64(text.float32_bits(f32(f)))
    }
    i64(text.float_bits(f))
}

fn become_float_constant(v: *Value, f: f64, bits: i64) {
    if f != f {
        return
    }
    become_constant(v, float_bits(bits, f))
    v.float_bits = bits
}

fn value_bits(v: *Value) -> i64 {
    let t = v.type ?? panic("float operation without a type")
    t.bits
}

fn fold_float_binary(v: *Value) {
    let bits = value_bits(v)
    let x = float_operand(v.args[0], bits) ?? return
    let y = float_operand(v.args[1], bits) ?? return
    if bits == 32 {
        become_float_constant(v, f64(binary32(v.op, f32(x), f32(y))), bits)
        return
    }
    become_float_constant(v, binary64(v.op, x, y), bits)
}

fn binary32(op: Op, x: f32, y: f32) -> f32 {
    match op {
        OpAdd => x + y
        OpSub => x - y
        OpMul => x * y
        _ => x / y
    }
}

fn binary64(op: Op, x: f64, y: f64) -> f64 {
    match op {
        OpAdd => x + y
        OpSub => x - y
        OpMul => x * y
        _ => x / y
    }
}

fn fold_float_negate(v: *Value) {
    let c = v.args[0]
    if c.op != OpConst {
        return
    }
    let bits = value_bits(v)
    var mask = sign_bit_64
    if bits == 32 {
        mask = sign_bit_32
    }
    become_constant(v, c.aux ^ mask)
    v.float_bits = bits
}

fn fold_float_unary(v: *Value) {
    let bits = value_bits(v)
    let x = float_operand(v.args[0], bits) ?? return
    if v.op == OpFloor {
        become_float_constant(v, floor(x), bits)
        return
    }
    become_float_constant(v, sqrt(x), bits)
}

pub fn fold_conversion(o: *Optimizer, v: *Value) {
    let c = v.args[0]
    let from = v.from ?? return
    let to = v.type ?? return
    if c.op != OpConst {
        return
    }
    if types.is_integer(from) && types.is_integer(to) {
        become_constant(v, types.wrap(to, c.aux))
    } else if types.is_integer(from) && types.is_float(to) {
        fold_integer_to_float(o, v, c)
    } else if types.is_float(from) && types.is_integer(to) {
        fold_float_to_integer(o, v, c)
    } else if types.is_float(from) && types.is_float(to) {
        fold_float_to_float(v, c)
    }
}

fn fold_integer_to_float(o: *Optimizer, v: *Value, c: *Value) {
    if v.from == o.u.u64 && c.aux < 0 {
        return
    }
    if value_bits(v) == 32 {
        become_float_constant(v, f64(f32(c.aux)), 32)
        return
    }
    become_float_constant(v, f64(c.aux), 64)
}

fn truncate_float(f: f64) -> f64 {
    if f >= 0.0 {
        return floor(f)
    }
    -floor(-f)
}

fn fold_float_to_integer(o: *Optimizer, v: *Value, c: *Value) {
    let from = types.must(v.from)
    let f = float_operand(c, from.bits) ?? return
    let truncated = truncate_float(f)
    let in_range = truncated >= -two_pow_63 && truncated < two_pow_63
    if v.type == o.u.u64 && !(in_range && truncated >= 0.0) {
        return
    }
    if !in_range {
        become_constant(v, types.wrap(v.type, min_i64))
    } else {
        become_constant(v, types.wrap(v.type, i64(truncated)))
    }
    v.float_bits = 0
}

fn fold_float_to_float(v: *Value, c: *Value) {
    let from = types.must(v.from)
    let f = float_operand(c, from.bits) ?? return
    become_float_constant(v, f, value_bits(v))
}
