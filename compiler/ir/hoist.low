import ast
import lexer
import prelude
import types

pub const slice_copy_bytes = 1024
pub const map_copy_entries = 4

pub struct Hoisted {
    pub words: []*Value
}

fn constant_expr(e: ast.Expr) -> bool {
    match ast.literal(e) {
        IntLit(_) => true
        FloatLit(_) => true
        BoolLit(_) => true
        StrLit(_) => true
        Unary(n) => n.op == lexer.Kind.Minus && constant_expr(n.x)
        Ident(n) => n.null || n.variant != none
        StructLit(n) => {
            if types.c_struct(types.must(n.type)) {
                return false
            }
            for f in n.fields {
                if !constant_expr(f.value) {
                    return false
                }
            }
            true
        }
        _ => false
    }
}

fn all_constant(list: []ast.Expr) -> bool {
    for e in list {
        if !constant_expr(e) {
            return false
        }
    }
    true
}

fn cell(b: *Builder) -> *Value {
    let v = emit(b, OpCell, [])
    v.aux = b.cells.n
    v.scalar = true
    b.cells.n += 1
    v
}

fn template(b: *Builder, build_value: fn() -> *Value) -> *Value {
    let held = cell(b)
    let cached = emit(b, OpLoad, [held])
    let temp = new_temp(b)
    write_temp(b, temp, [cached])
    let miss = fresh_block(b)
    let done = fresh_block(b)
    let zero = constant(b, 0)
    let absent = emit(b, OpEq, [cached, zero])
    branch(b, absent, miss, done)
    enter(b, miss)
    let made = build_value()
    store_words(b, Place { addr: held }, [made])
    write_temp(b, temp, [made])
    jump(b, done)
    enter(b, done)
    read_temp(b, temp, 1)[0]
}

pub fn hoisted_slice(b: *Builder, e: *ast.SliceLit) -> *Hoisted? {
    let elem = types.elem_of(types.must(e.type))
    let elements = e.elems.len
    let bytes = elements * types.stride(elem)
    if !b.hoist || elements == 0 || types.c_struct(elem) || is_vector(elem) || !all_constant(e.elems) {
        return none
    }
    if !e.read_only && bytes < slice_copy_bytes {
        return none
    }
    let cached = template(b, fn() -> *Value { filled_slice(b, e)[0] })
    let n = constant(b, elements)
    if e.read_only {
        return new(Hoisted { words: slice_of(cached, n) })
    }
    let size = constant(b, bytes)
    let flag = scan(b, elem)
    let data = runtime(b, RtGrow, [cached, size, size, flag]) ?? panic("grow without a result")
    new(Hoisted { words: slice_of(data, n) })
}

pub fn hoisted_map(b: *Builder, e: *ast.MapLit) -> *Hoisted? {
    let entries = e.keys.len
    if !b.hoist || entries == 0 || !all_constant(e.keys) || !all_constant(e.values) {
        return none
    }
    if !e.read_only && entries < map_copy_entries {
        return none
    }
    let cached = template(b, fn() -> *Value { filled_map(b, e)[0] })
    if e.read_only {
        return new(Hoisted { words: [cached] })
    }
    new(Hoisted { words: map_call(b, prelude.map_clone, types.must(e.type), [cached]) })
}
