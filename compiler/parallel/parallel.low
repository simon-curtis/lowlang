import std/atomic
import std/os
import std/sync

pub fn cpus() -> i64 {
    os.cpu_count()
}

pub fn each(count: i64, job: fn(i64)) {
    var threads = count
    let limit = cpus()
    if limit < threads {
        threads = limit
    }
    if threads <= 1 {
        for i in 0..count {
            job(i)
        }
        return
    }
    let next = atomic.int(0)
    let group = sync.wait_group()
    sync.add(group, threads)
    for _ in 0..threads {
        spawn drain(next, count, job, group)
    }
    sync.wait(group)
}

fn drain(next: atomic.Int, count: i64, job: fn(i64), group: sync.WaitGroup) {
    for {
        let i = atomic.add_int(next, 1) - 1
        if i >= count {
            break
        }
        job(i)
    }
    sync.done(group)
}
