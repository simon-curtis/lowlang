import std/file
import std/text

const tick_ns = 10000000
const page_bytes = 4096

pub fn usage() -> Usage {
    var found = Usage {}
    let stat = file.read_text("/proc/self/stat") or ""
    let times = text.fields(text.last_cut(stat, ")").after)
    if times.len > 12 {
        let user = (text.parse_int(times[11]) or 0) * tick_ns
        found.kernel = (text.parse_int(times[12]) or 0) * tick_ns
        found.cpu = user + found.kernel
    }
    let statm = file.read_text("/proc/self/statm") or return found
    let pages = text.fields(statm)
    if pages.len < 3 {
        return found
    }
    let resident = text.parse_int(pages[1]) or 0
    let shared = text.parse_int(pages[2]) or 0
    found.resident = resident * page_bytes
    found.private = (resident - shared) * page_bytes
    found
}
