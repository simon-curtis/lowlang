import std/atomic
import std/sync
import std/time

pub struct Job {
    pub lane: i64 = 0
    pub start: i64 = 0
    pub end: i64 = 0
}

pub struct Fanout {
    pub stage: i64
    pub start: i64
    pub end: i64 = 0
    pub lanes: i64
    pub jobs: []Job
}

pub struct Stage {
    pub name: str
    pub start: i64
}

pub struct Usage {
    pub cpu: i64 = 0
    pub kernel: i64 = 0
    pub private: i64 = 0
    pub resident: i64 = 0
}

pub struct Sample {
    pub at: i64
    pub usage: Usage
}

pub struct Trace {
    pub cpus: i64
    pub start: i64
    pub end: i64
    pub stages: []Stage
    pub fanouts: []*Fanout = []
    pub samples: []Sample = []
    stopping: atomic.Bool
    sampler: sync.WaitGroup
}

pub const sample_interval_ms = 10

pub fn new_trace() -> *Trace {
    let now = time.monotonic()
    let t = new(Trace { cpus: cpus(), start: now, end: now, stages: [Stage { name: "start", start: now }], stopping: atomic.boolean(false), sampler: sync.wait_group() })
    t.samples.push(sample())
    sync.add(t.sampler, 1)
    spawn sample_until_stopped(t)
    t
}

fn sample() -> Sample {
    let found = usage()
    Sample { at: time.monotonic(), usage: found }
}

fn sample_until_stopped(t: *Trace) {
    for !atomic.load_bool(t.stopping) {
        sleep(sample_interval_ms)
        t.samples.push(sample())
    }
    sync.done(t.sampler)
}

pub fn mark(t: *Trace, name: str) {
    t.stages.push(Stage { name, start: time.monotonic() })
}

pub fn finish(t: *Trace) {
    atomic.store_bool(t.stopping, true)
    sync.wait(t.sampler)
    t.samples.push(sample())
    t.end = t.samples[t.samples.len - 1].at
}

pub fn each_traced(t: *Trace, count: i64, job: fn(i64)) {
    var jobs: []Job = []
    for _ in 0..count {
        jobs.push(Job {})
    }
    let lanes = workers(count)
    let f = new(Fanout { stage: t.stages.len - 1, start: time.monotonic(), lanes, jobs })
    if lanes <= 1 {
        for i in 0..count {
            f.jobs[i] = timed(job, i, 0)
        }
    } else {
        let next = atomic.int(0)
        let group = sync.wait_group()
        sync.add(group, lanes)
        for lane in 1..lanes + 1 {
            spawn drain_traced(next, f, job, group, lane)
        }
        sync.wait(group)
    }
    f.end = time.monotonic()
    t.fanouts.push(f)
}

fn drain_traced(next: atomic.Int, f: *Fanout, job: fn(i64), group: sync.WaitGroup, lane: i64) {
    for {
        let i = atomic.add_int(next, 1) - 1
        if i >= f.jobs.len {
            break
        }
        f.jobs[i] = timed(job, i, lane)
    }
    sync.done(group)
}

fn timed(job: fn(i64), i: i64, lane: i64) -> Job {
    let start = time.monotonic()
    job(i)
    Job { lane, start, end: time.monotonic() }
}
