const stack_alignment = 16
const arg_count = 6
const result_count = 2
const saved_count = 5
const frame_top = 16

fn abi_args() -> []str {
    ["rdi", "rsi", "rdx", "rcx", "r8", "r9"]
}

fn abi_results() -> []str {
    ["rax", "rdx"]
}

fn abi_caller() -> []str {
    ["rcx", "rsi", "rdi", "r8", "r9"]
}

fn abi_saved() -> []str {
    ["rbx", "r12", "r13", "r14", "r15"]
}

fn abi_syscall() -> []str {
    ["rax", "rdi", "rsi", "rdx", "r10", "r8", "r9"]
}

fn abi_grow() -> []str {
    ["rax", "rdx", "r10"]
}

fn abi_integers() -> []str {
    ["rcx", "rsi", "rdi", "r8", "r9", "rbx", "r12", "r13", "r14", "r15"]
}

fn abi_stack_words(params: i64) -> i64 {
    max_int(0, params - arg_count)
}

fn abi_argument(k: i64) -> str? {
    if k < arg_count {
        return abi_args()[k]
    }
    none
}

fn abi_incoming(k: i64) -> str {
    "qword ptr [rbp+{frame_top + 8 * (k - arg_count)}]"
}

fn abi_outgoing(k: i64) -> str {
    "qword ptr [rsp+{8 * (k - arg_count)}]"
}

fn abi_stack_result(params: i64, k: i64) -> str {
    "qword ptr [rsp+{8 * (abi_stack_words(params) + k)}]"
}

fn abi_returns_in_registers(words: i64) -> bool {
    words <= result_count
}

fn abi_aligned_bytes(words: i64) -> i64 {
    (8 * words + stack_alignment - 1) / stack_alignment * stack_alignment
}

const abi_saved_bytes: i64 = 8 * saved_count

fn abi_results_offset(params: i64) -> i64 {
    frame_top + 8 * abi_stack_words(params)
}
