import ir
import std/slices

enum FrameMode {
    FullFrame = 0
    DeferredFrame = 1
    FramelessFrame = 2
}

fn frame_mode(mf: *Mfunc, f: *ir.Func, saved: []str, vectors: bool) -> FrameMode {
    if vectors || f.param_words > abi_args().len {
        return FullFrame
    }
    if mf.guard == none {
        if saved.len == 0 && f.slots.len == 0 && !slices.any(mf.blocks, fn(mb: *Mblock) -> bool { mb.needs_frame() }) {
            return FramelessFrame
        }
        return FullFrame
    }
    if slices.any(mf.blocks, fn(mb: *Mblock) -> bool { mb.light && mb.needs_frame() }) {
        return FullFrame
    }
    DeferredFrame
}

fn needs_frame(mb: *Mblock) -> bool {
    if mb.poll || (mb.kind == Ret && !abi_returns_in_registers(mb.results.len)) {
        return true
    }
    if slices.any(mb.instrs, fn(ins: *Instr) -> bool { !ins.frame_free() }) {
        return true
    }
    for st in mb.steps {
        for r in slices.concat(st.uses, st.defs) {
            if r.spill >= 0 {
                return true
            }
        }
    }
    false
}

fn frame_free(ins: *Instr) -> bool {
    match ins.memory_operand() {
        some(m) => {
            if address_of(m).base.frame != none {
                return false
            }
        }
        none => {}
    }
    match ins.op {
        OpConst => true
        OpEmbed => true
        OpString => true
        OpUndef => true
        OpAdd => true
        OpSub => true
        OpMul => true
        OpAnd => true
        OpOr => true
        OpXor => true
        OpMulHigh => true
        OpTrailingZeros => true
        OpShl => true
        OpShr => true
        OpNeg => true
        OpCompl => true
        OpNot => true
        OpConvert => true
        OpSqrt => true
        OpFloor => true
        OpEq => true
        OpNe => true
        OpLt => true
        OpLe => true
        OpGt => true
        OpGe => true
        OpFuncAddr => true
        OpHashSeed => true
        OpLoad => address_of(ins.args[0]).base.frame == none
        OpStore => address_of(ins.args[0]).base.frame == none
        OpParam => ins.value.aux < abi_args().len
        OpDiv => divisor_known(ins)
        OpRem => divisor_known(ins)
        _ => false
    }
}

fn divisor_known(ins: *Instr) -> bool {
    if is_float(ins.value.type) {
        return true
    }
    let divisor = ins.args[1].konst ?? return false
    divisor != 0
}
