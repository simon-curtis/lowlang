fn new_bits(count: i64) -> []u64 {
    var words: []u64 = []
    for _ in 0..(count + 63) / 64 {
        words.push(0)
    }
    words
}

fn has_bit(words: []u64, i: i64) -> bool {
    let at = i / 64
    if i < 0 || at >= words.len {
        return false
    }
    (words[at] >> u64(i % 64)) & 1 != 0
}

fn set_bit(mut words: []u64, i: i64) {
    let at = i / 64
    let one: u64 = 1
    words[at] = words[at] | (one << u64(i % 64))
}

fn members(f: *Mfunc, words: []u64) -> []*Vreg {
    var found: []*Vreg = []
    for at, word in words {
        if word == 0 {
            continue
        }
        for b in 0..64 {
            if (word >> u64(b)) & 1 != 0 {
                found.push(f.vregs[at * 64 + b])
            }
        }
    }
    found
}
