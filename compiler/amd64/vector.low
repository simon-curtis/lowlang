import ir
import types

enum Tier {
    Baseline = 0
    Avx2 = 1
    Avx512 = 2
}

const ternlog_select = 202
const ternlog_not = 85
const vector_slot_bytes = 64
const vector_scratch_slots = 3
const vector_scratch_words = vector_scratch_slots * vector_slot_bytes / 8 + 1

fn uses_vectors(f: *ir.Func) -> bool {
    for b in f.blocks {
        for v in b.values {
            if ir.is_vector_op(v.op) {
                return true
            }
        }
    }
    false
}

struct Maddr {
    base: str
    disp: i64
}

fn at_offset(m: Maddr, off: i64) -> str {
    "[{m.base}{plus(m.disp + off)}]"
}

fn vector_address(g: *Generator, fr: *Frame, ins: *Instr, k: i64) -> Maddr {
    let v = ins.value.args[k]
    if v.op == OpSlot {
        return Maddr { base: "rbp", disp: fr.slot(v.aux) }
    }
    let loc = fr.loc(ins.args[k])
    if is_reg(loc) {
        return Maddr { base: loc, disp: 0 }
    }
    g.move("r10", loc)
    Maddr { base: "r10", disp: 0 }
}

fn scratch_at(fr: *Frame, k: i64) -> Maddr {
    Maddr { base: "rbp", disp: fr.vector_scratch + vector_slot_bytes * k }
}

struct Lanes {
    t: *types.Type
    halves: i64
    bytes: i64
}

fn vex(g: *Generator) -> bool {
    g.tier != Baseline
}

fn evex(g: *Generator) -> bool {
    g.tier == Avx512
}

fn home_bytes(g: *Generator, vectors: bool) -> i64 {
    if !vectors {
        return 0
    }
    match g.tier {
        Baseline => 0
        Avx2 => 32
        Avx512 => 64
    }
}

fn shape(g: *Generator, t: *types.Type) -> Lanes {
    let total = types.vector_bytes(t)
    var bytes = 16
    if g.evex() {
        bytes = total
    } else if g.vex() {
        bytes = min_int(total, 32)
    }
    Lanes { t, halves: total / bytes, bytes }
}

fn register_kind(bytes: i64) -> str {
    match bytes {
        16 => "xmm"
        32 => "ymm"
        _ => "zmm"
    }
}

fn vector_width(bytes: i64) -> str {
    match bytes {
        16 => "xmmword"
        32 => "ymmword"
        _ => "zmmword"
    }
}

fn zmm(l: Lanes) -> bool {
    l.bytes == 64
}

fn first_register(l: Lanes, base: i64) -> i64 {
    if l.halves > 2 {
        return 2 * base
    }
    base
}

fn lane_reg(l: Lanes, base: i64, half: i64) -> str {
    "{register_kind(l.bytes)}{l.first_register(base) + half}"
}

fn load_vector(g: *Generator, l: Lanes, base: i64, m: Maddr) {
    for h in 0..l.halves {
        g.emit("{g.vmov(l)} {l.lane_reg(base, h)}, {g.mem_width(l)} ptr {m.at_offset(l.bytes * h)}")
    }
}

fn store_vector(g: *Generator, l: Lanes, base: i64, m: Maddr) {
    for h in 0..l.halves {
        g.emit("{g.vmov(l)} {g.mem_width(l)} ptr {m.at_offset(l.bytes * h)}, {l.lane_reg(base, h)}")
    }
}

fn vmov(g: *Generator, l: Lanes) -> str {
    if l.zmm() {
        return "vmovdqu64"
    }
    if g.vex() {
        return "vmovdqu"
    }
    "movdqu"
}

fn evex_name(l: Lanes, mnemonic: str) -> str {
    if !l.zmm() {
        return mnemonic
    }
    match mnemonic {
        "pand" => "pandq"
        "pandn" => "pandnq"
        "por" => "porq"
        "pxor" => "pxorq"
        _ => mnemonic
    }
}

fn op2(g: *Generator, l: Lanes, mnemonic: str, dst: i64, src: i64) {
    for h in 0..l.halves {
        let d = l.lane_reg(dst, h)
        let s = l.lane_reg(src, h)
        if g.vex() {
            g.emit("v{evex_name(l, mnemonic)} {d}, {d}, {s}")
        } else {
            g.emit("{mnemonic} {d}, {s}")
        }
    }
}

fn cmp_float(g: *Generator, l: Lanes, dst: i64, src: i64, predicate: i64) {
    let suffix = float_suffix(l.t)
    for h in 0..l.halves {
        let d = l.lane_reg(dst, h)
        let s = l.lane_reg(src, h)
        if g.vex() {
            g.emit("vcmp{suffix} {d}, {d}, {s}, {predicate}")
        } else {
            g.emit("cmp{suffix} {d}, {s}, {predicate}")
        }
    }
}

fn copy_regs(g: *Generator, l: Lanes, dst: i64, src: i64) {
    for h in 0..l.halves {
        let d = l.lane_reg(dst, h)
        let s = l.lane_reg(src, h)
        if l.zmm() {
            g.emit("vmovdqa64 {d}, {s}")
        } else if g.vex() {
            g.emit("vmovdqa {d}, {s}")
        } else {
            g.emit("movdqa {d}, {s}")
        }
    }
}

fn int_suffix(t: *types.Type) -> str {
    match types.elem_of(t).bits {
        8 => "b"
        16 => "w"
        32 => "d"
        64 => "q"
        _ => ""
    }
}

fn float_suffix(t: *types.Type) -> str {
    if types.elem_of(t).bits == 32 {
        return "ps"
    }
    "pd"
}

fn sign_label(bits: i64) -> str {
    "rt_vsign{bits}"
}

fn all_ones(g: *Generator, l: Lanes, reg: i64) {
    g.op2(l, "pcmpeqd", reg, reg)
}

fn bias(g: *Generator, l: Lanes, reg: i64) {
    let bits = types.elem_of(l.t).bits
    let label = sign_label(bits)
    if l.zmm() {
        let r = l.lane_reg(reg, 0)
        if bits == 64 {
            g.emit("vpxorq {r}, {r}, qword ptr [rip+{label}]{{1to8}}")
        } else {
            g.emit("vpxord {r}, {r}, dword ptr [rip+{label}]{{1to16}}")
        }
        return
    }
    let temp = l.lane_reg(6, 1)
    for h in 0..l.halves {
        let r = l.lane_reg(reg, h)
        if g.vex() {
            g.emit("vpxor {r}, {r}, {g.mem_width(l)} ptr [rip+{label}]")
        } else {
            g.emit("movdqu {temp}, xmmword ptr [rip+{label}]")
            g.emit("pxor {r}, {temp}")
        }
    }
}

fn mem_width(g: *Generator, l: Lanes) -> str {
    vector_width(l.bytes)
}

fn native(op: ir.VectorOp, t: *types.Type, at: Tier) -> bool {
    let elem = types.elem_of(t)
    let bits = elem.bits
    let float = types.is_float(elem)
    let vex = at != Baseline
    let evex = at == Avx512
    match op {
        VMul => return float || bits == 16 || (bits == 32 && vex) || (bits == 64 && evex) || (bits == 8 && evex)
        VMin => return float || (bits == 8 && is_u8(elem)) || (vex && bits < 64) || (bits == 64 && evex)
        VMax => return float || (bits == 8 && is_u8(elem)) || (vex && bits < 64) || (bits == 64 && evex)
        VEq => return float || bits < 64 || vex
        VNe => return float || bits < 64 || vex
        VLt => return float || bits < 64 || vex
        VLe => return float || bits < 64 || vex
        VGt => return float || bits < 64 || vex
        VGe => return float || bits < 64 || vex
        VShuffle => return vex
        VShl => return bits != 8 || evex
        VShr => {
            if bits == 8 {
                return evex
            }
            return !is_i64(elem) || evex
        }
        _ => {}
    }
    true
}

fn vector(g: *Generator, fr: *Frame, ins: *Instr) {
    let v = ins.value
    let t = types.must(v.type)
    let op = ir.vector_op(v.aux)
    let l = g.shape(t)
    if v.op == OpVectorScalar {
        g.vector_mask(fr, ins, g.shape(types.must(v.from)))
        return
    }
    match op {
        VCopy => g.copy_vector(fr, ins, l)
        VSplat => g.splat_vector(fr, ins, l)
        VSelect => {
            g.source(fr, ins, 1, l, 0)
            g.source(fr, ins, 2, l, 2)
            g.source(fr, ins, 3, l, 4)
            g.select_regs(l)
            g.vector_result(fr, ins, l, g.select_result())
        }
        VNot => {
            g.source(fr, ins, 1, l, 0)
            g.unary_regs(l, op)
            g.vector_result(fr, ins, l, 0)
        }
        VNeg => {
            g.source(fr, ins, 1, l, 0)
            g.unary_regs(l, op)
            g.vector_result(fr, ins, l, 0)
        }
        VShl => g.vector_shift(fr, ins, l, op, t)
        VShr => g.vector_shift(fr, ins, l, op, t)
        _ => {
            if fr.fused[ins] ?? false {
                g.fused_compare(fr, ins, l, op)
                return
            }
            if g.direct(fr, ins, l) {
                return
            }
            g.source(fr, ins, 1, l, 0)
            g.source(fr, ins, 2, l, 2)
            if native(op, t, g.tier) {
                g.binary_regs(l, op)
            } else {
                g.fallback(fr, l, op, true)
            }
            g.vector_result(fr, ins, l, 0)
        }
    }
}

fn vector_shift(g: *Generator, fr: *Frame, ins: *Instr, l: Lanes, op: ir.VectorOp, t: *types.Type) {
    g.source(fr, ins, 1, l, 0)
    g.move("rax", fr.loc(ins.args[2]))
    if native(op, t, g.tier) {
        g.shift_regs(l, op)
    } else {
        g.fallback(fr, l, op, false)
    }
    g.vector_result(fr, ins, l, 0)
}

fn splat_vector(g: *Generator, fr: *Frame, ins: *Instr, l: Lanes) {
    let held = ins.args[0].vector_register()
    if g.vex() && held >= 0 {
        g.splat(fr, ins, l, held)
        return
    }
    g.splat(fr, ins, l, 0)
    g.vector_result(fr, ins, l, 0)
}

fn splat(g: *Generator, fr: *Frame, ins: *Instr, l: Lanes, dst: i64) {
    g.move("rax", fr.loc(ins.args[1]))
    let bits = types.elem_of(l.t).bits
    if g.evex() {
        g.emit("vpbroadcast{int_suffix(l.t)} {l.lane_reg(dst, 0)}, {broadcast_source(bits)}")
        return
    }
    if g.vex() {
        g.emit("vmovq xmm0, rax")
        g.emit("vpbroadcast{int_suffix(l.t)} {l.lane_reg(dst, 0)}, xmm0")
        g.repeat_first(l, dst)
        return
    }
    g.emit("movq xmm0, rax")
    match bits {
        8 => {
            g.emit("punpcklbw xmm0, xmm0")
            g.emit("punpcklwd xmm0, xmm0")
            g.emit("pshufd xmm0, xmm0, 0")
        }
        16 => {
            g.emit("punpcklwd xmm0, xmm0")
            g.emit("pshufd xmm0, xmm0, 0")
        }
        32 => g.emit("pshufd xmm0, xmm0, 0")
        _ => g.emit("punpcklqdq xmm0, xmm0")
    }
    g.repeat_first(l, 0)
}

fn repeat_first(g: *Generator, l: Lanes, base: i64) {
    for h in 1..l.halves {
        if g.vex() {
            g.emit("vmovdqa {l.lane_reg(base, h)}, {l.lane_reg(base, 0)}")
        } else {
            g.emit("movdqa {l.lane_reg(base, h)}, {l.lane_reg(base, 0)}")
        }
    }
}

fn broadcast_source(bits: i64) -> str {
    if bits == 64 {
        return "rax"
    }
    "eax"
}

fn select_result(g: *Generator) -> i64 {
    if g.evex() {
        return 0
    }
    4
}

fn select_regs(g: *Generator, l: Lanes) {
    if g.evex() {
        g.emit("vpternlogq {l.lane_reg(0, 0)}, {l.lane_reg(2, 0)}, {l.lane_reg(4, 0)}, {ternlog_select}")
        return
    }
    if g.vex() {
        for h in 0..l.halves {
            g.emit("vpblendvb {l.lane_reg(4, h)}, {l.lane_reg(4, h)}, {l.lane_reg(2, h)}, {l.lane_reg(0, h)}")
        }
        return
    }
    for h in 0..l.halves {
        g.emit("pand {l.lane_reg(2, h)}, {l.lane_reg(0, h)}")
        g.emit("pandn {l.lane_reg(0, h)}, {l.lane_reg(4, h)}")
        g.emit("por {l.lane_reg(0, h)}, {l.lane_reg(2, h)}")
        g.emit("movdqa {l.lane_reg(4, h)}, {l.lane_reg(0, h)}")
    }
}

fn unary_regs(g: *Generator, l: Lanes, op: ir.VectorOp) {
    if op == VNot && g.evex() {
        let r = l.lane_reg(0, 0)
        g.emit("vpternlogd {r}, {r}, {r}, {ternlog_not}")
        return
    }
    if op == VNot {
        g.all_ones(l, 6)
        g.op2(l, "pxor", 0, 6)
        return
    }
    if types.is_float(types.elem_of(l.t)) {
        g.bias(l, 0)
        return
    }
    g.op2(l, "pxor", 6, 6)
    g.op2(l, "psub{int_suffix(l.t)}", 6, 0)
    g.copy_regs(l, 0, 6)
}

fn shift_name(l: Lanes, op: ir.VectorOp, suffix: str) -> str {
    if op == VShl {
        return "psll{suffix}"
    }
    if types.elem_of(l.t).signed {
        return "psra{suffix}"
    }
    "psrl{suffix}"
}

fn shift_regs(g: *Generator, l: Lanes, op: ir.VectorOp) {
    if g.vex() {
        g.emit("vmovq xmm6, rax")
    } else {
        g.emit("movq xmm6, rax")
    }
    if types.elem_of(l.t).bits == 8 {
        g.byte_lanes(l, "v{l.shift_name(op, "w")}", false)
        return
    }
    let mnemonic = l.shift_name(op, int_suffix(l.t))
    for h in 0..l.halves {
        let r = l.lane_reg(0, h)
        if g.vex() {
            g.emit("v{mnemonic} {r}, {r}, xmm6")
        } else {
            g.emit("{mnemonic} {r}, xmm6")
        }
    }
}

fn byte_lanes(g: *Generator, l: Lanes, mnemonic: str, binary: bool) {
    var operands = [0]
    if binary {
        operands.push(2)
    }
    if l.zmm() {
        for base in operands {
            g.emit("vextracti64x4 ymm{base + 1}, zmm{base}, 1")
            g.emit("vpmovzxbw zmm{base + 1}, ymm{base + 1}")
            g.emit("vpmovzxbw zmm{base}, ymm{base}")
        }
        for h in 0..2 {
            g.emit(widened(mnemonic, "zmm{h}", "zmm{2 + h}", binary))
            g.emit("vpmovwb ymm{h}, zmm{h}")
        }
        g.emit("vinserti64x4 zmm0, zmm0, ymm1, 1")
        return
    }
    let wide = register_kind(2 * l.bytes)
    let narrow = register_kind(l.bytes)
    for base in operands {
        g.emit("vpmovzxbw {wide}{base}, {narrow}{base}")
    }
    g.emit(widened(mnemonic, "{wide}0", "{wide}2", binary))
    g.emit("vpmovwb {narrow}0, {wide}0")
}

fn widened(mnemonic: str, dst: str, src: str, binary: bool) -> str {
    if binary {
        return "{mnemonic} {dst}, {dst}, {src}"
    }
    "{mnemonic} {dst}, {dst}, xmm6"
}

fn arithmetic_name(op: ir.VectorOp) -> str {
    match op {
        VAdd => "add"
        VSub => "sub"
        VMul => "mul"
        VDiv => "div"
        VMin => "min"
        _ => "max"
    }
}

fn binary_regs(g: *Generator, l: Lanes, op: ir.VectorOp) {
    let float = types.is_float(types.elem_of(l.t))
    match op {
        VAdd => g.op2(l, arithmetic_mnemonic(op, l.t), 0, 2)
        VSub => g.op2(l, arithmetic_mnemonic(op, l.t), 0, 2)
        VMul => {
            if types.elem_of(l.t).bits == 8 {
                g.byte_lanes(l, "vpmullw", true)
            } else {
                g.op2(l, arithmetic_mnemonic(op, l.t), 0, 2)
            }
        }
        VDiv => g.op2(l, arithmetic_mnemonic(op, l.t), 0, 2)
        VMin => g.op2(l, arithmetic_mnemonic(op, l.t), 0, 2)
        VMax => g.op2(l, arithmetic_mnemonic(op, l.t), 0, 2)
        VAnd => g.op2(l, "pand", 0, 2)
        VOr => g.op2(l, "por", 0, 2)
        VXor => g.op2(l, "pxor", 0, 2)
        VAndNot => {
            g.op2(l, "pandn", 2, 0)
            g.copy_regs(l, 0, 2)
        }
        VShuffle => g.op2(l, "pshufb", 0, 2)
        VEq => g.compare_regs(l, op, float)
        VNe => g.compare_regs(l, op, float)
        VLt => g.compare_regs(l, op, float)
        VLe => g.compare_regs(l, op, float)
        VGt => g.compare_regs(l, op, float)
        VGe => g.compare_regs(l, op, float)
        _ => {}
    }
}

fn arithmetic_mnemonic(op: ir.VectorOp, t: *types.Type) -> str {
    let name = arithmetic_name(op)
    let elem = types.elem_of(t)
    if types.is_float(elem) {
        return "{name}{float_suffix(t)}"
    }
    let s = int_suffix(t)
    if op == VMul {
        return "pmull{s}"
    }
    if op == VMin || op == VMax {
        var sign = "u"
        if elem.signed {
            sign = "s"
        }
        return "p{name}{sign}{s}"
    }
    "p{name}{s}"
}

fn compare_regs(g: *Generator, l: Lanes, op: ir.VectorOp, float: bool) {
    if float {
        g.compare_float(l, op)
    } else {
        g.compare_int(l, op)
    }
}

fn avx_predicate(op: ir.VectorOp) -> i64 {
    match op {
        VEq => 0
        VNe => 4
        VLt => 1
        VLe => 2
        VGt => 14
        _ => 13
    }
}

fn compare_float(g: *Generator, l: Lanes, op: ir.VectorOp) {
    if l.zmm() {
        g.compare_into_k(l, op, l.lane_reg(0, 0), l.lane_reg(2, 0))
        g.emit("vpmovm2{int_suffix(l.t)} {l.lane_reg(0, 0)}, k1")
        return
    }
    if g.vex() {
        g.cmp_float(l, 0, 2, avx_predicate(op))
        return
    }
    match op {
        VEq => g.cmp_float(l, 0, 2, 0)
        VNe => g.cmp_float(l, 0, 2, 4)
        VLt => g.cmp_float(l, 0, 2, 1)
        VLe => g.cmp_float(l, 0, 2, 2)
        VGt => {
            g.cmp_float(l, 2, 0, 1)
            g.copy_regs(l, 0, 2)
        }
        VGe => {
            g.cmp_float(l, 2, 0, 2)
            g.copy_regs(l, 0, 2)
        }
        _ => {}
    }
}

fn compare_into_mask(op: ir.VectorOp, signed: bool) -> bool {
    if op == VEq {
        return false
    }
    op != VGt || !signed
}

fn mask_predicate(op: ir.VectorOp) -> i64 {
    match op {
        VEq => 0
        VLt => 1
        VLe => 2
        VNe => 4
        VGe => 5
        _ => 6
    }
}

fn compare_into_k(g: *Generator, l: Lanes, op: ir.VectorOp, a: str, b: str) {
    let elem = types.elem_of(l.t)
    if types.is_float(elem) {
        g.emit("vcmp{float_suffix(l.t)} k1, {a}, {b}, {avx_predicate(op)}")
        return
    }
    var kind = "u"
    if elem.signed {
        kind = ""
    }
    g.emit("vpcmp{kind}{int_suffix(l.t)} k1, {a}, {b}, {mask_predicate(op)}")
}

fn compare_int(g: *Generator, l: Lanes, op: ir.VectorOp) {
    let s = int_suffix(l.t)
    if g.evex() && (l.zmm() || compare_into_mask(op, types.elem_of(l.t).signed)) {
        g.compare_into_k(l, op, l.lane_reg(0, 0), l.lane_reg(2, 0))
        g.emit("vpmovm2{s} {l.lane_reg(0, 0)}, k1")
        return
    }
    if op == VEq || op == VNe {
        g.op2(l, "pcmpeq{s}", 0, 2)
        if op == VNe {
            g.all_ones(l, 6)
            g.op2(l, "pxor", 0, 6)
        }
        return
    }
    if !types.elem_of(l.t).signed {
        g.bias(l, 0)
        g.bias(l, 2)
    }
    match op {
        VGt => g.op2(l, "pcmpgt{s}", 0, 2)
        VLe => g.op2(l, "pcmpgt{s}", 0, 2)
        VLt => {
            g.op2(l, "pcmpgt{s}", 2, 0)
            g.copy_regs(l, 0, 2)
        }
        VGe => {
            g.op2(l, "pcmpgt{s}", 2, 0)
            g.copy_regs(l, 0, 2)
        }
        _ => {}
    }
    if op == VLe || op == VGe {
        g.all_ones(l, 6)
        g.op2(l, "pxor", 0, 6)
    }
}

fn vector_mask(g: *Generator, fr: *Frame, ins: *Instr, l: Lanes) {
    if g.evex() {
        g.mask_through_k(fr, ins, l)
    } else {
        let src = g.mask_source(fr, ins, l)
        match types.elem_of(l.t).bits {
            8 => g.mask_halves(l, "pmovmskb", src)
            16 => g.mask_words(l, src)
            32 => g.mask_halves(l, "movmskps", src)
            _ => g.mask_halves(l, "movmskpd", src)
        }
    }
    g.move(fr.loc(dest(ins)), "rax")
}

fn mask_through_k(g: *Generator, fr: *Frame, ins: *Instr, l: Lanes) {
    let compared = fr.masked
    fr.masked = none
    if compared != ins.value.args[0] {
        let src = g.mask_source(fr, ins, l)
        g.emit("vpmov{int_suffix(l.t)}2m k1, {l.lane_reg(src, 0)}")
    }
    match l.t.lanes {
        64 => g.emit("kmovq rax, k1")
        32 => g.emit("kmovd eax, k1")
        16 => g.emit("kmovw eax, k1")
        _ => g.emit("kmovb eax, k1")
    }
}

fn fused_compare(g: *Generator, fr: *Frame, ins: *Instr, l: Lanes, op: ir.VectorOp) {
    let first = g.register_lanes(fr, ins, 1, l)
    let second = g.memory_lanes(fr, ins, 2, l)
    g.compare_into_k(l, op, first, second)
    let result = ins.value.args[0]
    fr.masked = result
    if result.op != OpSlot || (fr.slot_uses[result.aux] ?? 0) > 2 {
        g.emit("vpmovm2{int_suffix(l.t)} {l.lane_reg(0, 0)}, k1")
        g.vector_result(fr, ins, l, 0)
    }
}

fn is_comparison(op: ir.VectorOp) -> bool {
    op == VEq || op == VNe || op == VLt || op == VLe || op == VGt || op == VGe
}

fn fused_compares(mb: *Mblock) -> [*Instr: bool] {
    let fused: [*Instr: bool] = [:]
    var compare: *Instr? = none
    for ins in mb.instrs {
        if ins.transfer != Keep {
            continue
        }
        match compare {
            some(c) => {
                if ins.op == OpVectorScalar && ins.value.args[0] == c.value.args[0] {
                    fused[c] = true
                }
            }
            none => {}
        }
        compare = none
        if ins.op == OpVector && is_comparison(ir.vector_op(ins.value.aux)) {
            compare = ins
        }
    }
    fused
}

fn slot_uses(f: *ir.Func) -> [i64: i64] {
    var uses: [i64: i64] = [:]
    for b in f.blocks {
        for v in b.values {
            for a in v.args {
                uses.count_slot(a)
            }
        }
        match b.control {
            some(c) => uses.count_slot(c)
            none => {}
        }
        for r in b.results {
            uses.count_slot(r)
        }
    }
    uses
}

fn count_slot(mut uses: [i64: i64], v: *ir.Value) {
    if v.op == OpSlot {
        uses[v.aux] = (uses[v.aux] ?? 0) + 1
    }
}

fn mask_source(g: *Generator, fr: *Frame, ins: *Instr, l: Lanes) -> i64 {
    let held = ins.args[0].vector_register()
    if held >= 0 {
        return held
    }
    g.source(fr, ins, 0, l, 0)
    0
}

fn mask_halves(g: *Generator, l: Lanes, mnemonic: str, src: i64) {
    var prefix = ""
    if g.vex() {
        prefix = "v"
    }
    let per = l.t.lanes / l.halves
    g.emit("{prefix}{mnemonic} eax, {l.lane_reg(src, 0)}")
    for h in 1..l.halves {
        g.emit("{prefix}{mnemonic} edx, {l.lane_reg(src, h)}")
        g.merge_mask(per * h)
    }
}

fn merge_mask(g: *Generator, at: i64) {
    g.emit("shl rdx, {at}")
    g.emit("or rax, rdx")
}

fn mask_words(g: *Generator, l: Lanes, src: i64) {
    if g.vex() && l.bytes == 32 {
        for h in 0..l.halves {
            let r = l.first_register(src) + h
            g.emit("vextracti128 xmm6, ymm{r}, 1")
            g.emit("vpacksswb xmm6, xmm{r}, xmm6")
            if h == 0 {
                g.emit("vpmovmskb eax, xmm6")
            } else {
                g.emit("vpmovmskb edx, xmm6")
                g.merge_mask(16 * h)
            }
        }
    } else if g.vex() {
        g.emit("vpacksswb xmm0, xmm{src}, xmm{src}")
        g.emit("vpmovmskb eax, xmm0")
        g.emit("and eax, 255")
    } else if l.halves == 1 {
        g.emit("packsswb xmm0, xmm0")
        g.emit("pmovmskb eax, xmm0")
        g.emit("and eax, 255")
    } else {
        for pair in 0..l.halves / 2 {
            let r = 2 * pair
            g.emit("packsswb xmm{r}, xmm{r + 1}")
            if pair == 0 {
                g.emit("pmovmskb eax, xmm0")
            } else {
                g.emit("pmovmskb edx, xmm{r}")
                g.merge_mask(16 * pair)
            }
        }
    }
}

fn lane_load(t: *types.Type, dst: str, mem: str) -> str {
    let elem = types.elem_of(t)
    let width = widths(elem.bits) ?? return "mov {dst}, qword ptr {mem}"
    extension(dst, "{width} ptr {mem}", elem)
}

fn lane_store(t: *types.Type, mem: str, src: str) -> str {
    let elem = types.elem_of(t)
    let width = widths(elem.bits) ?? return "mov qword ptr {mem}, {src}"
    "mov {width} ptr {mem}, {narrow(src, sub_register(elem.bits))}"
}

fn lane_at(l: Lanes, m: Maddr) -> str {
    "[{m.base}{plus(m.disp)}+r11*{types.lane_bytes(l.t)}]"
}

fn fallback(g: *Generator, fr: *Frame, l: Lanes, op: ir.VectorOp, binary: bool) {
    let a = fr.scratch_at(0)
    let b = fr.scratch_at(1)
    let out = fr.scratch_at(2)
    g.store_vector(l, 0, a)
    if binary {
        g.store_vector(l, 2, b)
    }
    let saved = fr.scratch_at(vector_scratch_slots)
    let shifting = op == VShl || op == VShr
    if shifting {
        g.emit("mov qword ptr {saved.at_offset(0)}, rcx")
        g.emit("mov rcx, rax")
        g.emit("mov r10d, 63")
        g.emit("cmp rcx, r10")
        g.emit("cmova rcx, r10")
    }
    let loop = g.new_label()
    g.emit("xor r11d, r11d")
    g.label(loop)
    g.emit(lane_load(l.t, "rax", l.lane_at(a)))
    if binary {
        g.emit(lane_load(l.t, "rdx", l.lane_at(b)))
    }
    g.scalar_lane(l, op, a)
    g.emit(lane_store(l.t, l.lane_at(out), "rax"))
    g.emit("inc r11")
    g.emit("cmp r11, {l.t.lanes}")
    g.emit("jb {loop}")
    if shifting {
        g.emit("mov rcx, qword ptr {saved.at_offset(0)}")
    }
    g.load_vector(l, 0, out)
}

fn vector_comparison(op: ir.VectorOp) -> ir.Op {
    match op {
        VEq => OpEq
        VNe => OpNe
        VLt => OpLt
        VLe => OpLe
        VGt => OpGt
        _ => OpGe
    }
}

fn scalar_lane(g: *Generator, l: Lanes, op: ir.VectorOp, table: Maddr) {
    let signed = types.elem_of(l.t).signed
    match op {
        VMul => g.emit("imul rax, rdx")
        VMin => g.pick_lane(OpGt, signed)
        VMax => g.pick_lane(OpLt, signed)
        VEq => g.compare_lane(op, signed)
        VNe => g.compare_lane(op, signed)
        VLt => g.compare_lane(op, signed)
        VLe => g.compare_lane(op, signed)
        VGt => g.compare_lane(op, signed)
        VGe => g.compare_lane(op, signed)
        VShuffle => g.shuffle_lane(table)
        VShl => g.emit("shl rax, cl")
        VShr => {
            if signed {
                g.emit("sar rax, cl")
            } else {
                g.emit("shr rax, cl")
            }
        }
        _ => {}
    }
}

fn pick_lane(g: *Generator, pick: ir.Op, signed: bool) {
    g.emit("cmp rax, rdx")
    g.emit("cmov{condition_of(pick, signed)} rax, rdx")
}

fn compare_lane(g: *Generator, op: ir.VectorOp, signed: bool) {
    g.emit("cmp rax, rdx")
    g.emit("set{condition_of(vector_comparison(op), signed)} al")
    g.emit("movzx eax, al")
    g.emit("neg rax")
}

fn shuffle_lane(g: *Generator, table: Maddr) {
    let zero = g.new_label()
    let done = g.new_label()
    g.emit("test dl, -128")
    g.emit("jnz {zero}")
    g.emit("and edx, 15")
    g.emit("mov r10, r11")
    g.emit("and r10, 48")
    g.emit("add rdx, r10")
    g.emit("movzx eax, byte ptr [{table.base}{plus(table.disp)}+rdx]")
    g.emit("jmp {done}")
    g.label(zero)
    g.emit("xor eax, eax")
    g.label(done)
}

fn leave_vectors(g: *Generator) {
    if g.vex() {
        g.emit("vzeroupper")
    }
}

fn vector_register(r: *Vreg) -> i64 {
    if r.home == none || r.reg == "" {
        return -1
    }
    var n = 0
    for at in 3..r.reg.len {
        n = n * 10 + i64(r.reg[at] - 48)
    }
    n
}

fn home_register(r: *Vreg, index: i64) -> str {
    "{register_kind(r.width)}{index}"
}

fn home_width(r: *Vreg) -> str {
    vector_width(r.width)
}

fn home_move(r: *Vreg) -> str {
    if r.width == 64 {
        return "vmovdqu64"
    }
    "vmovdqu"
}

fn home_at(fr: *Frame, r: *Vreg) -> Maddr {
    let origin = r.home ?? panic("home without a slot")
    Maddr { base: "rbp", disp: fr.slot(origin.aux) }
}

fn spill_home(g: *Generator, fr: *Frame, r: *Vreg) {
    let index = r.vector_register()
    if index < 0 {
        return
    }
    g.emit("{r.home_move()} {r.home_width()} ptr {fr.home_at(r).at_offset(0)}, {r.home_register(index)}")
}

fn fill_home(g: *Generator, fr: *Frame, r: *Vreg) {
    let index = r.vector_register()
    if index < 0 {
        return
    }
    g.emit("{r.home_move()} {r.home_register(index)}, {r.home_width()} ptr {fr.home_at(r).at_offset(0)}")
}

fn transfer_home(g: *Generator, fr: *Frame, ins: *Instr) {
    match ins.transfer {
        Spill => g.spill_home(fr, ins.args[0])
        Fill => g.fill_home(fr, dest(ins))
        Keep => {}
    }
}

fn spill_homes(g: *Generator, fr: *Frame, held: []*Vreg) {
    for r in held {
        g.spill_home(fr, r)
    }
}

fn fill_homes(g: *Generator, fr: *Frame, held: []*Vreg) {
    for r in held {
        g.fill_home(fr, r)
    }
}

fn held_homes(fr: *Frame, mb: *Mblock) -> []*Vreg {
    var held: []*Vreg = []
    for r in fr.func.vregs {
        if r.home != none && r.reg != "" && is_live(mb.live_out, r) {
            held.push(r)
        }
    }
    held
}

fn source(g: *Generator, fr: *Frame, ins: *Instr, k: i64, l: Lanes, base: i64) {
    let held = ins.args[k].vector_register()
    if held >= 0 {
        g.copy_regs(l, base, held)
        return
    }
    g.load_vector(l, base, g.vector_address(fr, ins, k))
}

fn vector_result(g: *Generator, fr: *Frame, ins: *Instr, l: Lanes, base: i64) {
    let held = ins.args[0].vector_register()
    if held >= 0 {
        g.copy_regs(l, held, base)
        return
    }
    g.store_vector(l, base, g.vector_address(fr, ins, 0))
}

fn copy_vector(g: *Generator, fr: *Frame, ins: *Instr, l: Lanes) {
    let dst = ins.args[0].vector_register()
    let src = ins.args[1].vector_register()
    if dst >= 0 && src >= 0 {
        if dst != src {
            g.copy_regs(l, dst, src)
        }
    } else if dst >= 0 {
        g.load_vector(l, dst, g.vector_address(fr, ins, 1))
    } else if src >= 0 {
        g.store_vector(l, src, g.vector_address(fr, ins, 0))
    } else {
        g.source(fr, ins, 1, l, 0)
        g.vector_result(fr, ins, l, 0)
    }
}

fn direct_mnemonic(op: ir.VectorOp, l: Lanes, at: Tier) -> str {
    let t = l.t
    if !native(op, t, at) {
        return ""
    }
    let float = types.is_float(types.elem_of(t))
    match op {
        VAdd => arithmetic_mnemonic(op, t)
        VSub => arithmetic_mnemonic(op, t)
        VMul => only_if(types.elem_of(t).bits != 8, arithmetic_mnemonic(op, t))
        VMin => arithmetic_mnemonic(op, t)
        VMax => arithmetic_mnemonic(op, t)
        VDiv => only_if(float, arithmetic_mnemonic(op, t))
        VAnd => evex_name(l, "pand")
        VOr => evex_name(l, "por")
        VXor => evex_name(l, "pxor")
        VShuffle => "pshufb"
        VEq => only_if(!float && !l.zmm(), "pcmpeq{int_suffix(t)}")
        _ => ""
    }
}

fn only_if(on: bool, mnemonic: str) -> str {
    if on {
        return mnemonic
    }
    ""
}

fn direct(g: *Generator, fr: *Frame, ins: *Instr, l: Lanes) -> bool {
    if !g.vex() || l.halves > 1 {
        return false
    }
    let mnemonic = direct_mnemonic(ir.vector_op(ins.value.aux), l, g.tier)
    if mnemonic == "" {
        return false
    }
    let first = g.register_lanes(fr, ins, 1, l)
    let second = g.memory_lanes(fr, ins, 2, l)
    var target = ins.args[0].vector_register()
    let held = target >= 0
    if !held {
        target = 0
    }
    g.emit("v{mnemonic} {l.lane_reg(target, 0)}, {first}, {second}")
    if !held {
        g.store_vector(l, 0, g.vector_address(fr, ins, 0))
    }
    true
}

fn register_lanes(g: *Generator, fr: *Frame, ins: *Instr, k: i64, l: Lanes) -> str {
    let held = ins.args[k].vector_register()
    if held >= 0 {
        return l.lane_reg(held, 0)
    }
    g.load_vector(l, 0, g.vector_address(fr, ins, k))
    l.lane_reg(0, 0)
}

fn memory_lanes(g: *Generator, fr: *Frame, ins: *Instr, k: i64, l: Lanes) -> str {
    let held = ins.args[k].vector_register()
    if held >= 0 {
        return l.lane_reg(held, 0)
    }
    "{g.mem_width(l)} ptr {g.vector_address(fr, ins, k).at_offset(0)}"
}
