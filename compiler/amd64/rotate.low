import ir
import types

fn fuse_rotates(s: *Selector) {
    for mb in s.func.blocks {
        for ins in mb.instrs {
            if ins.op == OpOr && !s.is_dead(ins) && ins.args.len == 2 && rotatable_type(ins.value.type) {
                s.fuse_rotate(ins)
            }
        }
    }
}

fn rotatable_type(t: *types.Type?) -> bool {
    let ty = t ?? return false
    types.is_integer(ty) && !ty.signed && (ty.bits == 32 || ty.bits == 64)
}

fn fuse_rotate(s: *Selector, ins: *Instr) {
    let t = types.must(ins.value.type)
    var left = s.shift_of(ins.args[0], OpShl, t)
    var right = s.shift_of(ins.args[1], OpShr, t)
    if left == none || right == none {
        left = s.shift_of(ins.args[1], OpShl, t)
        right = s.shift_of(ins.args[0], OpShr, t)
    }
    let l = left ?? return
    let r = right ?? return
    if l.args[0] != r.args[0] {
        return
    }
    let amount = l.args[1].konst ?? panic("rotate amount is not constant")
    let other = r.args[1].konst ?? panic("rotate amount is not constant")
    if amount + other != t.bits {
        return
    }
    let x = l.args[0]
    s.dead[l] = true
    s.dead[r] = true
    s.uses[x] -= 1
    ins.args = [x]
    ins.rotate = amount
}

fn shift_of(s: *Selector, r: *Vreg, op: ir.Op, t: *types.Type) -> *Instr? {
    let d = s.defs[r] ?? return none
    if s.is_dead(d) || s.use_count(r) != 1 || r.fixed() || d.op != op || d.value.type != t {
        return none
    }
    let count = d.args[1].konst ?? return none
    if count <= 0 || count >= t.bits || d.args[0].fixed() {
        return none
    }
    d
}

fn rotate(g: *Generator, fr: *Frame, ins: *Instr) {
    let dst = fr.loc(dest(ins))
    let work = g.work_register(dst)
    g.move(work, fr.loc(ins.args[0]))
    var operand = work
    if ins.word32() {
        operand = dword(work)
    }
    g.emit("rol {operand}, {ins.rotate}")
    g.move(dst, work)
}
