import ir
import std/builder
import std/text

fn cell_address(index: i64) -> str {
    "[rip+rt_cells+{8 * index}]"
}

fn write_cells(mut out: builder.Builder, count: i64) {
    builder.write(mut out, "\n\t.data\n\t.p2align 3\n\t.globl rt_cells\nrt_cells:\n\t.zero {8 * count}\n\t.globl rt_cells_end\nrt_cells_end:\n")
}

fn static_block_label(module: str) -> str {
    "rt_static_block.{text.replace(module, "/", ".")}"
}

fn write_static_blocks(mut out: builder.Builder, modules: []str) {
    if modules.len == 0 {
        return
    }
    builder.write(mut out, "\n\t.bss\n\t.p2align 3\n")
    for module in modules {
        let label = static_block_label(module)
        builder.write(mut out, "{label}:\n\t.zero {ir.static_block_bytes}\n")
    }
}
