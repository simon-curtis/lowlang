import ir

fn addresses_memory(ins: *Instr, k: i64) -> bool {
    (ins.op == OpLoad || ins.op == OpStore) && k == 0
}

fn frame_address_instr(f: *Mfunc, slot: *Vreg) -> *Instr {
    let dst = f.new_vreg()
    dst.scalar = slot.scalar
    let frame = slot.frame ?? panic("slot without a frame value")
    new(Instr { op: OpSlot, dst, value: frame })
}

fn rematerialize(f: *Mfunc, r: *Vreg, mut into: []*Instr) -> *Vreg {
    if r.frame == none {
        return r
    }
    let lea = f.frame_address_instr(r)
    push(mut into, lea)
    dest(lea)
}

fn rematerialize_frame_addresses(f: *Mfunc) {
    for mb in f.blocks {
        var rebuilt: []*Instr = []
        for ins in mb.instrs {
            match ins.dst {
                some(d) => {
                    if d.frame != none {
                        continue
                    }
                }
                none => {}
            }
            for k, arg in ins.args {
                if !ins.addresses_memory(k) {
                    ins.args[k] = f.rematerialize(arg, mut rebuilt)
                }
            }
            push(mut rebuilt, ins)
        }
        for i, r in mb.compare {
            mb.compare[i] = f.rematerialize(r, mut rebuilt)
        }
        for i, r in mb.results {
            mb.results[i] = f.rematerialize(r, mut rebuilt)
        }
        for c in mb.copies {
            c.src = f.rematerialize(c.src, mut rebuilt)
        }
        match mb.control {
            some(c) => {
                mb.control = f.rematerialize(c, mut rebuilt)
            }
            none => {}
        }
        mb.instrs = rebuilt
    }
}
