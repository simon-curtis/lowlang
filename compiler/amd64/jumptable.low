import std/builder

struct JumpTable {
    label: str
    targets: []str
}

fn jump_table(g: *Generator, fr: *Frame, mb: *Mblock) {
    let table = mb.table ?? panic("switch without a jump table")
    let fallback = fr.final(mb.succs[0])
    let control = mb.control ?? panic("switch without a control value")
    g.move("r10", fr.loc(control))
    g.rebase("r10", table.low)
    g.emit("cmp r10, {table.cases.len - 1}")
    g.emit("ja {fallback.label}")
    let label = g.new_label()
    g.emit("lea r11, [rip+{label}]")
    g.emit("movsxd r10, dword ptr [r11+r10*4]")
    g.emit("add r10, r11")
    g.emit("jmp r10")
    var targets: []str = []
    for c in table.cases {
        push(mut targets, fr.final(mb.succs[c]).label)
    }
    push(mut g.jumps, JumpTable { label, targets })
}

fn rebase(g: *Generator, reg: str, low: i64) {
    if low == 0 {
        return
    }
    if low >= -(1 << 31) && low <= (1 << 31) - 1 {
        g.emit("sub {reg}, {low}")
        return
    }
    g.emit("mov r11, {low}")
    g.emit("sub {reg}, r11")
}

fn flush_jump_tables(g: *Generator) {
    for t in g.jumps {
        g.align(2)
        g.label(t.label)
        for target in t.targets {
            g.text.write("\t.long {target} - {t.label}\n")
        }
    }
    g.jumps = []
}
