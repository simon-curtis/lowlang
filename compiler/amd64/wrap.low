import ir
import std/slices

const max_join_size = 8

fn predecessors(f: *Mfunc) -> [*Mblock: []*Mblock] {
    var preds: [*Mblock: []*Mblock] = [:]
    for mb in f.blocks {
        for s in mb.succs {
            var list = preds[s] ?? []
            list.push(mb)
            preds[s] = list
        }
    }
    preds
}

fn reach(f: *Mfunc, from: *Mblock, avoid: *Mblock?) -> [*Mblock: bool] {
    var seen: [*Mblock: bool] = [:]
    var stack: []*Mblock = [from]
    for stack.len > 0 {
        let mb = stack[stack.len - 1]
        stack.truncate(stack.len - 1)
        if (seen[mb] ?? false) || avoid == mb {
            continue
        }
        seen[mb] = true
        var i = mb.succs.len - 1
        for i >= 0 {
            stack.push(mb.succs[i])
            i -= 1
        }
    }
    seen
}

fn has_call(mb: *Mblock) -> bool {
    slices.any(mb.instrs, fn(ins: *Instr) -> bool { ins.is_call() })
}

fn guard_block(f: *Mfunc, preds: [*Mblock: []*Mblock]) -> *Mblock? {
    var calls: []*Mblock = []
    for mb in f.blocks {
        if mb.has_call() {
            calls.push(mb)
        }
    }
    if calls.len == 0 {
        return none
    }
    let d = f.dominators(preds)
    var at = d.index[calls[0]] ?? 0
    for mb in calls[1..] {
        at = d.intersect(at, d.index[mb] ?? 0)
    }
    if at == 0 {
        return none
    }
    d.nodes[at]
}

fn shrink_wrap(f: *Mfunc) {
    let preds = f.predecessors()
    let guard = f.guard_block(preds) ?? return
    let heavy = f.reach(guard, none)
    let light = f.reach(f.blocks[0], guard)
    let guard_preds = preds[guard] ?? []
    if slices.any(guard_preds, fn(p: *Mblock) -> bool { heavy[p] ?? false }) {
        return
    }
    var joins: []*Mblock = []
    for mb in f.blocks {
        if (heavy[mb] ?? false) && (light[mb] ?? false) {
            joins.push(mb)
        }
    }
    if !light_only(light) || !cloneable(joins) {
        return
    }
    f.guard = guard
    f.clone_joins(joins, light)
    for mb in light {
        mb.light = !(heavy[mb] ?? false)
    }
    f.split_at_guard(guard, heavy)
}

fn light_only(light: [*Mblock: bool]) -> bool {
    for mb in light {
        if mb.has_call() || mb.poll {
            return false
        }
    }
    true
}

fn cloneable(joins: []*Mblock) -> bool {
    var count = 0
    for j in joins {
        count += j.instrs.len + j.copies.len
        for s in j.succs {
            if !slices.contains(joins, s) {
                return false
            }
        }
    }
    count <= max_join_size
}

fn clone(mb: *Mblock) -> *Mblock {
    let c = mb.duplicate("{mb.label}c")
    c.light = true
    c
}

fn duplicate(mb: *Mblock, label: str) -> *Mblock {
    let c = new(*mb)
    c.label = label
    c.instrs = []
    for ins in mb.instrs {
        let copied = new(*ins)
        copied.args = slices.clone(ins.args)
        c.instrs.push(copied)
    }
    c.copies = []
    for cp in mb.copies {
        c.copies.push(new(*cp))
    }
    c.succs = slices.clone(mb.succs)
    c.compare = slices.clone(mb.compare)
    c.results = slices.clone(mb.results)
    c
}

fn clone_joins(f: *Mfunc, joins: []*Mblock, light: [*Mblock: bool]) {
    var clones: [*Mblock: *Mblock] = [:]
    for j in joins {
        clones[j] = j.clone()
    }
    for _, c in clones {
        for i, s in c.succs {
            c.succs[i] = clones[s] ?? panic("join successor outside the joins")
        }
    }
    var last_ref: [*Mblock: i64] = [:]
    for i, mb in f.blocks {
        if !(light[mb] ?? false) || clones[mb] != none {
            continue
        }
        for k, s in mb.succs {
            match clones[s] {
                some(c) => {
                    mb.succs[k] = c
                    last_ref[c] = i
                }
                none => {}
            }
        }
    }
    var blocks: []*Mblock = []
    var placed: [*Mblock: bool] = [:]
    for i, mb in f.blocks {
        blocks.push(mb)
        for j in joins {
            let c = clones[j] ?? continue
            let idx = last_ref[c] ?? continue
            if idx == i && !(placed[c] ?? false) {
                blocks.push(c)
                placed[c] = true
            }
        }
    }
    for j in joins {
        let c = clones[j] ?? continue
        if !(placed[c] ?? false) {
            blocks.push(c)
        }
    }
    f.blocks = blocks
}

fn split_at_guard(f: *Mfunc, guard: *Mblock, heavy: [*Mblock: bool]) {
    f.analyse()
    let count = f.vregs.len
    let defined = f.defined_in(heavy)
    let arrivals = f.stack_params()
    let below = new(Renaming { func: f, to: unset(count) })
    let above = new(Renaming { func: f, to: unset(count) })
    for v in f.vregs[..count] {
        if !is_live(guard.live_in, v) || !v.crosses_call || v.float {
            continue
        }
        let fresh = f.new_vreg()
        fresh.scalar = v.scalar
        if defined[v.id] {
            above.to[v.id] = fresh.id
            guard.heads.push(new(PhiCopy { dst: v, src: fresh }))
            continue
        }
        fresh.arrival = arrivals[v.id]
        below.to[v.id] = fresh.id
        guard.heads.push(new(PhiCopy { dst: fresh, src: v }))
    }
    for mb in f.blocks {
        if heavy[mb] ?? false {
            mb.rename(below)
        } else if mb.light {
            mb.rename(above)
        }
    }
    f.reset_analysis()
}

fn stack_params(f: *Mfunc) -> []i64 {
    var arrivals = unset(f.vregs.len)
    for ins in f.blocks[0].instrs {
        if ins.is_param() && ins.value.aux >= arg_count {
            arrivals[dest(ins).id] = ins.value.aux
        }
    }
    arrivals
}

fn analyse(f: *Mfunc) {
    f.number()
    f.liveness()
    f.build_ranges()
    f.mark_call_crossings()
}

fn reset_analysis(f: *Mfunc) {
    for r in f.vregs {
        r.ranges = []
        r.crosses_call = false
    }
}

fn defined_in(f: *Mfunc, blocks: [*Mblock: bool]) -> []bool {
    var defined: []bool = []
    for _ in f.vregs {
        defined.push(false)
    }
    for mb in blocks {
        for ins in mb.instrs {
            match ins.dst {
                some(d) => {
                    defined[d.id] = true
                }
                none => {}
            }
        }
        for c in mb.copies {
            defined[c.dst.id] = true
        }
    }
    defined
}

fn unset(count: i64) -> []i64 {
    var out: []i64 = []
    for _ in 0..count {
        out.push(-1)
    }
    out
}

struct Renaming {
    func: *Mfunc
    to: []i64
}

fn renamed_to(m: *Renaming, r: *Vreg) -> *Vreg {
    if r.id < 0 || r.id >= m.to.len || m.to[r.id] < 0 {
        return r
    }
    m.func.vregs[m.to[r.id]]
}

fn renamed_operand(m: *Renaming, r: *Vreg) -> *Vreg {
    let a = r.mem ?? return m.renamed_to(r)
    let base = m.renamed_to(a.base)
    var index = a.index
    match a.index {
        some(i) => {
            index = m.renamed_to(i)
        }
        none => {}
    }
    if base == a.base && index == a.index {
        return r
    }
    let c = new(*a)
    c.base = base
    c.index = index
    new(Vreg { mem: c })
}

fn rename_operands(m: *Renaming, mut list: []*Vreg) {
    for i, r in list {
        list[i] = m.renamed_operand(r)
    }
}

fn rename(mb: *Mblock, m: *Renaming) {
    for ins in mb.instrs {
        m.rename_operands(mut ins.args)
        match ins.dst {
            some(d) => {
                ins.dst = m.renamed_to(d)
            }
            none => {}
        }
    }
    for c in mb.copies {
        c.src = m.renamed_to(c.src)
        c.dst = m.renamed_to(c.dst)
    }
    m.rename_operands(mut mb.compare)
    m.rename_operands(mut mb.results)
    match mb.control {
        some(r) => {
            mb.control = m.renamed_to(r)
        }
        none => {}
    }
}

fn mark_light(f: *Mfunc) {
    for mb in f.blocks {
        if !mb.light {
            continue
        }
        for r in mb.live_in {
            r.light = true
        }
        for r in mb.live_out {
            r.light = true
        }
        for st in mb.steps {
            for r in st.uses {
                r.light = true
            }
            for r in st.defs {
                r.light = true
            }
        }
    }
}

fn restores(mb: *Mblock) -> bool {
    mb.kind == Ret && !mb.light
}
