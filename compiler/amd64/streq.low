import ir

const max_inline_literal = 16

struct Chunk {
    width: i64
    offset: i64
}

fn fuse_literal_equality(s: *Selector) {
    for mb in s.func.blocks {
        for ins in mb.instrs {
            if ins.is_string_equality() && !s.is_dead(ins) {
                s.fuse_literal(ins)
            }
        }
    }
}

fn fuse_literal(s: *Selector, ins: *Instr) {
    if s.fuse_literal_side(ins, 2) {
        return
    }
    s.fuse_literal_side(ins, 0)
}

fn fuse_literal_side(s: *Selector, ins: *Instr, side: i64) -> bool {
    let other = 2 - side
    let pointer = ins.args[other]
    let length = ins.args[other + 1]
    if pointer.konst != none || length.konst != none {
        return false
    }
    let text = s.literal_at(ins, side) ?? return false
    let literal = ins.args[side]
    s.uses[literal] -= 1
    s.uses[ins.args[side + 1]] -= 1
    ins.args = [pointer, length]
    ins.literal = text
    if s.use_count(literal) == 0 {
        s.kill(literal)
    }
    true
}

fn literal_at(s: *Selector, ins: *Instr, side: i64) -> str? {
    let d = s.defs[ins.args[side]] ?? return none
    if s.is_dead(d) || d.op != OpString || d.value.str.len > max_inline_literal {
        return none
    }
    let length = ins.args[side + 1].konst ?? return none
    if length != d.value.str.len {
        return none
    }
    d.value.str
}

fn literal_chunks(n: i64) -> []Chunk {
    match n {
        0 => []
        > 8 => [Chunk { width: 8, offset: 0 }, Chunk { width: 8, offset: n - 8 }]
        8 => [Chunk { width: 8, offset: 0 }]
        > 4 => [Chunk { width: 4, offset: 0 }, Chunk { width: 4, offset: n - 4 }]
        4 => [Chunk { width: 4, offset: 0 }]
        3 => [Chunk { width: 2, offset: 0 }, Chunk { width: 1, offset: 2 }]
        _ => [Chunk { width: n, offset: 0 }]
    }
}

fn chunk_value(c: Chunk, text: str) -> u64 {
    var word: u64 = 0
    for i in 0..c.width {
        let byte = u64(text[c.offset + i])
        word |= byte << u64(8 * i)
    }
    word
}

fn chunk_operand(c: Chunk, base: str) -> str {
    let width = widths(8 * c.width) ?? "qword"
    if c.offset == 0 {
        return "{width} ptr [{base}]"
    }
    "{width} ptr [{base}+{c.offset}]"
}

fn literal_equality(g: *Generator, fr: *Frame, ins: *Instr) {
    let text = ins.literal ?? panic("string equality without a literal")
    var pointer = fr.loc(ins.args[0])
    let length = fr.loc(ins.args[1])
    g.emit("cmp {length}, {text.len}")
    let done = g.new_label()
    let chunks = literal_chunks(text.len)
    if chunks.len > 0 {
        g.emit("jne {done}")
        if !is_reg(pointer) {
            g.move("r10", pointer)
            pointer = "r10"
        }
        for i, c in chunks {
            if i > 0 {
                g.emit("jne {done}")
            }
            g.compare_chunk(c, pointer, text)
        }
    }
    g.label(done)
    g.emit("sete al")
    g.emit("movzx eax, al")
}

fn compare_chunk(g: *Generator, c: Chunk, pointer: str, text: str) {
    let value = chunk_value(c, text)
    let operand = chunk_operand(c, pointer)
    if c.width == 8 {
        g.emit("mov r11, 0x{value:x}")
        g.emit("cmp {operand}, r11")
        return
    }
    g.emit("cmp {operand}, 0x{value:x}")
}

fn string_equality(g: *Generator, fr: *Frame, ins: *Instr) {
    var moves: []Pmove = []
    let regs = abi_args()
    for i, a in ins.args {
        push(mut moves, Pmove { dst: regs[i], src: fr.loc(a) })
    }
    g.parallel(moves)
    let done = g.new_label()
    g.emit("xor eax, eax")
    g.emit("cmp {regs[1]}, {regs[3]}")
    g.emit("jne {done}")
    g.leave_vectors()
    g.emit("call rt_str_eq")
    g.safepoint_at(fr, ins, done)
}

fn is_string_equality(ins: *Instr) -> bool {
    if ins.op != OpRuntime {
        return false
    }
    let rt = ins.value.runtime ?? return false
    ir.runtime_convention(rt) == CallStrEq
}
