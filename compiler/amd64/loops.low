import ir
import std/slices

const max_weighted_depth = 4
const depth_factor = 8
const save_cost = 2

struct Dominators {
    nodes: []*Mblock = []
    index: [*Mblock: i64] = [:]
    idom: []i64 = []
    preds: [*Mblock: []*Mblock] = [:]
}

fn dominators(f: *Mfunc, preds: [*Mblock: []*Mblock]) -> *Dominators {
    let d = new(Dominators { preds })
    let tree = d.order(f.blocks[0])
    let n = d.nodes.len
    var tree_preds: [][]i64 = []
    for w in tree.pre {
        var from: []i64 = []
        for p in d.preds[w] ?? [] {
            let v = tree.number[p] ?? continue
            from.push(v)
        }
        tree_preds.push(from)
    }
    let idom = ir.immediate_dominators(tree.parent, tree_preds)
    for _ in 0..n {
        d.idom.push(0)
    }
    for w in 1..n {
        d.idom[d.index[tree.pre[w]] ?? 0] = d.index[tree.pre[idom[w]]] ?? 0
    }
    d
}

struct DfsTree {
    pre: []*Mblock = []
    parent: []i64 = []
    number: [*Mblock: i64] = [:]
}

fn order(d: *Dominators, entry: *Mblock) -> DfsTree {
    var tree = DfsTree { pre: [entry], parent: [0] }
    tree.number[entry] = 0
    var post: []*Mblock = []
    var stack: []*Mblock = [entry]
    var cursor: []i64 = [0]
    for stack.len > 0 {
        let top = stack.len - 1
        let node = stack[top]
        let at = cursor[top]
        if at < node.succs.len {
            cursor[top] = at + 1
            let next = node.succs[at]
            if (tree.number[next] ?? -1) < 0 {
                tree.number[next] = tree.pre.len
                tree.parent.push(tree.number[node] ?? 0)
                tree.pre.push(next)
                stack.push(next)
                cursor.push(0)
            }
        } else {
            post.push(node)
            stack.truncate(top)
            cursor.truncate(top)
        }
    }
    var i = post.len - 1
    for i >= 0 {
        d.index[post[i]] = d.nodes.len
        d.nodes.push(post[i])
        i -= 1
    }
    tree
}

fn intersect(d: *Dominators, x: i64, y: i64) -> i64 {
    var a = x
    var b = y
    for a != b {
        for a > b {
            a = d.idom[a]
        }
        for b > a {
            b = d.idom[b]
        }
    }
    a
}

fn dominates(d: *Dominators, a: i64, b: i64) -> bool {
    var at = b
    for at > a {
        at = d.idom[at]
    }
    a == at
}

fn loop_bodies(d: *Dominators) -> [][*Mblock: bool] {
    var found: [][*Mblock: bool] = []
    for i, header in d.nodes {
        let latches = d.back_edge_sources(i)
        if latches.len == 0 {
            continue
        }
        var body: [*Mblock: bool] = [:]
        body[header] = true
        d.collect(mut body, latches)
        found.push(body)
    }
    slices.sort_stable_by(mut found, fn(a: [*Mblock: bool], b: [*Mblock: bool]) -> bool { a.len < b.len })
    found
}

fn back_edge_sources(d: *Dominators, header: i64) -> []*Mblock {
    var sources: []*Mblock = []
    for p in d.preds[d.nodes[header]] ?? [] {
        let pi = d.index[p] ?? continue
        if d.dominates(header, pi) {
            sources.push(p)
        }
    }
    sources
}

fn collect(d: *Dominators, mut body: [*Mblock: bool], latches: []*Mblock) {
    var work = slices.clone(latches)
    for work.len > 0 {
        let n = work[work.len - 1]
        work.truncate(work.len - 1)
        if body[n] ?? false {
            continue
        }
        body[n] = true
        for p in d.preds[n] ?? [] {
            if d.index[p] != none {
                work.push(p)
            }
        }
    }
}

fn loop_depths(f: *Mfunc) -> [*Mblock: i64] {
    let depths: [*Mblock: i64] = [:]
    let d = f.dominators(f.predecessors())
    for body in d.loop_bodies() {
        for mb in body {
            depths[mb] += 1
        }
    }
    depths
}

fn weigh(f: *Mfunc) {
    for r in f.vregs {
        r.weight = 0
    }
    let depths = f.loop_depths()
    for mb in f.blocks {
        var cost = 1
        for _ in 0..min_int(depths[mb] ?? 0, max_weighted_depth) {
            cost *= depth_factor
        }
        for st in mb.steps {
            for r in st.uses {
                r.weight += cost
            }
            for r in st.defs {
                r.weight += cost
            }
        }
    }
}
