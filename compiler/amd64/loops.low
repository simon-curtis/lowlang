import std/slices

const max_weighted_depth = 4
const depth_factor = 8
const save_cost = 2

struct Dominators {
    nodes: []*Mblock = []
    index: [*Mblock: i64] = [:]
    idom: []i64 = []
    preds: [*Mblock: []*Mblock] = [:]
}

fn dominators(f: *Mfunc, preds: [*Mblock: []*Mblock]) -> *Dominators {
    let d = new(Dominators { preds })
    d.order(f.blocks[0])
    let n = d.nodes.len
    for _ in 0..n {
        push(mut d.idom, -1)
    }
    d.idom[0] = 0
    var changed = true
    for changed {
        changed = false
        for i in 1..n {
            if d.refine(i) {
                changed = true
            }
        }
    }
    d
}

fn order(d: *Dominators, entry: *Mblock) {
    var seen: [*Mblock: bool] = [:]
    var post: []*Mblock = []
    var stack: []*Mblock = [entry]
    var cursor: []i64 = [0]
    seen[entry] = true
    for stack.len > 0 {
        let top = stack.len - 1
        let node = stack[top]
        let at = cursor[top]
        if at < node.succs.len {
            cursor[top] = at + 1
            let next = node.succs[at]
            if !(seen[next] ?? false) {
                seen[next] = true
                push(mut stack, next)
                push(mut cursor, 0)
            }
        } else {
            push(mut post, node)
            truncate(mut stack, top)
            truncate(mut cursor, top)
        }
    }
    var i = post.len - 1
    for i >= 0 {
        d.index[post[i]] = d.nodes.len
        push(mut d.nodes, post[i])
        i -= 1
    }
}

fn refine(d: *Dominators, i: i64) -> bool {
    var next = -1
    for p in d.preds[d.nodes[i]] ?? [] {
        let pi = d.index[p] ?? continue
        if d.idom[pi] < 0 {
            continue
        }
        if next < 0 {
            next = pi
            continue
        }
        next = d.intersect(pi, next)
    }
    if next == d.idom[i] {
        return false
    }
    d.idom[i] = next
    true
}

fn intersect(d: *Dominators, x: i64, y: i64) -> i64 {
    var a = x
    var b = y
    for a != b {
        for a > b {
            a = d.idom[a]
        }
        for b > a {
            b = d.idom[b]
        }
    }
    a
}

fn dominates(d: *Dominators, a: i64, b: i64) -> bool {
    var at = b
    for at > a {
        at = d.idom[at]
    }
    a == at
}

fn loop_bodies(d: *Dominators) -> [][*Mblock: bool] {
    var found: [][*Mblock: bool] = []
    for i, header in d.nodes {
        let latches = d.back_edge_sources(i)
        if latches.len == 0 {
            continue
        }
        var body: [*Mblock: bool] = [:]
        body[header] = true
        d.collect(mut body, latches)
        push(mut found, body)
    }
    slices.sort_stable_by(mut found, fn(a: [*Mblock: bool], b: [*Mblock: bool]) -> bool { a.len < b.len })
    found
}

fn back_edge_sources(d: *Dominators, header: i64) -> []*Mblock {
    var sources: []*Mblock = []
    for p in d.preds[d.nodes[header]] ?? [] {
        let pi = d.index[p] ?? continue
        if d.dominates(header, pi) {
            push(mut sources, p)
        }
    }
    sources
}

fn collect(d: *Dominators, mut body: [*Mblock: bool], latches: []*Mblock) {
    var work = slices.clone(latches)
    for work.len > 0 {
        let n = work[work.len - 1]
        truncate(mut work, work.len - 1)
        if body[n] ?? false {
            continue
        }
        body[n] = true
        for p in d.preds[n] ?? [] {
            if d.index[p] != none {
                push(mut work, p)
            }
        }
    }
}

fn loop_depths(f: *Mfunc) -> [*Mblock: i64] {
    var depths: [*Mblock: i64] = [:]
    let d = f.dominators(f.predecessors())
    for body in d.loop_bodies() {
        for mb in body {
            depths[mb] += 1
        }
    }
    depths
}

fn weigh(f: *Mfunc) {
    for r in f.vregs {
        r.weight = 0
    }
    let depths = f.loop_depths()
    for mb in f.blocks {
        var cost = 1
        for _ in 0..min_int(depths[mb] ?? 0, max_weighted_depth) {
            cost *= depth_factor
        }
        for st in mb.steps {
            for r in st.uses {
                r.weight += cost
            }
            for r in st.defs {
                r.weight += cost
            }
        }
    }
}
