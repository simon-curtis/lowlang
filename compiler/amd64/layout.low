import ir
import std/slices

const max_rotated_instrs = 12

fn rotatable(mb: *Mblock, latch: *Mblock) -> bool {
    mb != latch && mb.kind == If && !mb.poll && mb.copies.len == 0 && mb.instrs.len <= max_rotated_instrs
}

fn rotate_loops(f: *Mfunc) {
    var rotated = 0
    for mb in slices.clone(f.blocks) {
        if mb.kind != Plain || !mb.poll {
            continue
        }
        let head = mb.succs[0]
        if !head.rotatable(mb) {
            continue
        }
        if head.instrs.len > 0 {
            rotated += 1
            let again = head.duplicate("{head.label}r{rotated}")
            mb.succs = [again]
            push(mut f.blocks, again)
            continue
        }
        mb.kind = head.kind
        mb.fused = head.fused
        mb.compare = slices.clone(head.compare)
        mb.control = head.control
        mb.succs = slices.clone(head.succs)
    }
}

fn layout(f: *Mfunc) {
    var visited: [*Mblock: bool] = [:]
    var post: []*Mblock = []
    var stack: []*Mblock = [f.blocks[0]]
    var cursor: []i64 = [0]
    visited[f.blocks[0]] = true
    for stack.len > 0 {
        let top = stack.len - 1
        let mb = stack[top]
        let at = cursor[top]
        if at < mb.succs.len {
            cursor[top] = at + 1
            let next = mb.succs[mb.succs.len - 1 - at]
            if !(visited[next] ?? false) {
                visited[next] = true
                push(mut stack, next)
                push(mut cursor, 0)
            }
        } else {
            push(mut post, mb)
            truncate(mut stack, top)
            truncate(mut cursor, top)
        }
    }
    var ordered: []*Mblock = []
    var i = post.len - 1
    for i >= 0 {
        push(mut ordered, post[i])
        i -= 1
    }
    f.blocks = ordered
    f.sink_rare_arms()
}

fn rare_first_arm(mb: *Mblock) -> bool {
    let fused = mb.fused ?? return false
    if mb.kind != If || mb.poll || fused.op != OpEq || is_float(fused.type) {
        return false
    }
    fused.args[1].op == OpConst && mb.succs[0] != mb.succs[1]
}

fn sink_rare_arms(f: *Mfunc) {
    let d = f.dominators(f.predecessors())
    let loops = d.loop_bodies()
    for mb in slices.clone(f.blocks) {
        if !mb.rare_first_arm() {
            continue
        }
        match innermost_loop(loops, mb) {
            some(body) => f.sink_arm(mb, body)
            none => {}
        }
    }
}

fn innermost_loop(loops: [][*Mblock: bool], mb: *Mblock) -> [*Mblock: bool]? {
    for body in loops {
        if body[mb] ?? false {
            return body
        }
    }
    none
}

fn heavy(mb: *Mblock) -> bool {
    mb.poll || mb.kind == Ret || mb.kind == Unreachable || mb.has_call()
}

fn sink_arm(f: *Mfunc, mb: *Mblock, body: [*Mblock: bool]) {
    let at = slices.index(f.blocks, mb) ?? return
    let join = slices.index(f.blocks, mb.succs[1]) ?? return
    if !(body[mb.succs[1]] ?? false) || join <= at + 1 || f.blocks[at + 1] != mb.succs[0] {
        return
    }
    var last = join
    for i in join..f.blocks.len {
        if body[f.blocks[i]] ?? false {
            last = i
        }
    }
    let arm = slices.clone(f.blocks[at + 1..join])
    if !slices.any(arm, fn(b: *Mblock) -> bool { b.heavy() }) {
        return
    }
    let rest = slices.clone(f.blocks[join..last + 1])
    var blocks = slices.clone(f.blocks[..at + 1])
    blocks = slices.concat(blocks, rest)
    blocks = slices.concat(blocks, arm)
    blocks = slices.concat(blocks, f.blocks[last + 1..])
    f.blocks = blocks
}
