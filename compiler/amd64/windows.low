import diag
import ir
import std/builder
import std/slices
import std/text

const page_size = 4096
const c_runtime_dll = "msvcrt.dll"
const math_dll = "api-ms-win-crt-math-l1-1-0.dll"
const kernel_dll = "kernel32.dll"
const synch_dll = "api-ms-win-core-synch-l1-2-0.dll"
const random_dll = "bcryptprimitives.dll"
const import_prefix = "__imp_"

fn win64_int_regs() -> []str {
    ["rcx", "rdx", "r8", "r9"]
}

fn win_preserved_vectors() -> []str {
    ["xmm6", "xmm7", "xmm8", "xmm9", "xmm10", "xmm11", "xmm12", "xmm13", "xmm14", "xmm15"]
}

fn runtime_import_dll(symbol: str) -> str {
    match symbol {
        "WaitOnAddress" => synch_dll
        "WakeByAddressAll" => synch_dll
        "WakeByAddressSingle" => synch_dll
        "ProcessPrng" => random_dll
        _ => kernel_dll
    }
}

fn is_word_byte(c: u8) -> bool {
    c == 95 || (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57)
}

fn is_word(s: str) -> bool {
    if s.len == 0 {
        return false
    }
    for i in 0..s.len {
        if !is_word_byte(s[i]) {
            return false
        }
    }
    true
}

fn win_call_symbol(line: str) -> str? {
    let trimmed = text.trim(line)
    let rest = text.strip_prefix(trimmed, "WIN") ?? return none
    if rest.len == 0 || !text.space(rest[0]) {
        return none
    }
    let symbol = text.trim(rest)
    if !is_word(symbol) {
        return none
    }
    symbol
}

fn add_import(mut table: [str: []str], dll: str, symbol: str) {
    var symbols = table[dll] ?? []
    push(mut symbols, symbol)
    table[dll] = symbols
}

fn runtime_imports() -> [str: []str] {
    var imports: [str: []str] = [:]
    for line in text.lines(windows_runtime()) {
        let symbol = win_call_symbol(line) ?? continue
        add_import(mut imports, runtime_import_dll(symbol), symbol)
    }
    imports
}

fn import_symbol(symbol: str) -> str {
    "{import_prefix}{symbol}"
}

fn dll_name(library: str) -> str {
    match library {
        "c" => return c_runtime_dll
        "m" => return math_dll
        _ => {}
    }
    let lowered = text.lower(library)
    if text.ends_with(lowered, ".dll") {
        return lowered
    }
    "{lowered}.dll"
}

fn sorted_unique(symbols: []str) -> []str {
    var sorted = slices.clone(symbols)
    slices.sort(mut sorted)
    var unique: []str = []
    for s in sorted {
        if unique.len == 0 || unique[unique.len - 1] != s {
            push(mut unique, s)
        }
    }
    unique
}

fn import_table(prog: *ir.Program) -> [str: []str] {
    var table = runtime_imports()
    for library in prog.imports {
        let dll = dll_name(library)
        for symbol in prog.imports[library] ?? [] {
            add_import(mut table, dll, symbol)
        }
    }
    var result: [str: []str] = [:]
    for dll in table {
        result[dll] = sorted_unique(table[dll] ?? [])
    }
    result
}

fn sorted_keys(table: [str: []str]) -> []str {
    var keys: []str = []
    for dll in table {
        push(mut keys, dll)
    }
    slices.sort(mut keys)
    keys
}

fn write_imports(mut out: builder.Builder, prog: *ir.Program) {
    let table = import_table(prog)
    let dlls = sorted_keys(table)
    for i in 0..dlls.len {
        out.write("\n\t.section {import_descriptors},\"dr\"\n\t.long .Lilt{i}@IMGREL, 0, 0, .Ldll{i}@IMGREL, .Liat{i}@IMGREL\n")
    }
    out.write("\n\t.section {import_null_descriptor},\"dr\"\n\t.long 0, 0, 0, 0, 0\n")
    for i, dll in dlls {
        let symbols = table[dll] ?? []
        write_thunks(mut out, import_lookups, ".Lilt{i}", i, symbols, false)
        write_thunks(mut out, import_addresses, ".Liat{i}", i, symbols, true)
        out.write("\n\t.section {import_hints},\"dr\"\n")
        for j, symbol in symbols {
            out.write("\t.p2align 1\n.Lhint{i}_{j}:\n\t.short 0\n\t.asciz {diag.quote(symbol)}\n")
        }
        out.write("\n\t.section {import_names},\"dr\"\n.Ldll{i}:\n\t.asciz {diag.quote(dll)}\n")
    }
}

fn write_thunks(mut out: builder.Builder, section: str, label: str, dll: i64, symbols: []str, named: bool) {
    out.write("\n\t.section {section},\"dr\"\n\t.p2align 3\n{label}:\n")
    for j, symbol in symbols {
        if named {
            out.write("{import_symbol(symbol)}:\n")
        }
        out.write("\t.long .Lhint{dll}_{j}@IMGREL, 0\n")
    }
    out.write("\t.long 0, 0\n")
}
