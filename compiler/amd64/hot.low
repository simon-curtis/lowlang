import ir
import std/builder
import std/slices

pub const func_table_symbol = "fn_table"

pub struct FuncTable {
    pub slots: [str: i64] = [:]
}

fn slot_of(t: *FuncTable, name: str) -> str {
    "[rip+{func_table_symbol}+{8 * (t.slots[name] ?? 0)}]"
}

pub fn new_func_table(prog: *ir.Program) -> *FuncTable {
    func_table_extend(new(FuncTable {}), prog)
}

pub fn func_table_extend(t: *FuncTable, prog: *ir.Program) -> *FuncTable {
    let extended = new(FuncTable {})
    for name in t.slots {
        extended.slots[name] = t.slots[name] ?? 0
    }
    for f in prog.funcs {
        if extended.slots[f.name] == none {
            extended.slots[f.name] = extended.slots.len
        }
    }
    extended
}

pub fn func_table_full(t: *FuncTable) -> bool {
    t.slots.len > table_size
}

fn append_u64(mut entries: []u8, n: u64) {
    for i in 0..8 {
        push(mut entries, u8((n >> u64(8 * i)) & 255))
    }
}

pub fn func_table_patch_entries(t: *FuncTable, changed: []str, suffix: str, symbols: [str: u64]) -> []u8 {
    var entries: []u8 = []
    for name in changed {
        append_u64(mut entries, u64(t.slots[name] ?? 0))
        append_u64(mut entries, symbols[symbol(name, suffix)] ?? 0)
    }
    entries
}

fn write_runtime(t: *FuncTable, mut out: builder.Builder) {
    write_symbols(mut out, [
        Define { name: "HOT_BASE", value: hot_base },
        Define { name: "HOT_SIZE", value: hot_size },
        Define { name: "PATCH_BYTES", value: patch_entry_bytes * table_size },
        Define { name: "PATCH_ENTRY", value: patch_entry_bytes },
        Define { name: "PATCH_SIGNAL", value: patch_signal },
    ])
    out.write(hot_runtime())
    var entries: []str = []
    for _ in 0..table_size {
        push(mut entries, "0")
    }
    for name in t.slots {
        entries[t.slots[name] ?? 0] = symbol(name, "")
    }
    out.write("\n\t.data\n\t.p2align 3\n\t.globl {func_table_symbol}\n{func_table_symbol}:\n")
    for e in entries {
        out.write("\t.quad {e}\n")
    }
}

pub fn generate_patch(prog: *ir.Program, platform: Platform, names: []str, table: *FuncTable, suffix: str) -> str {
    let g = new_generator(platform, table, suffix)
    for f in prog.funcs {
        if slices.contains(names, f.name) {
            g.function(f)
        }
    }
    var out = builder.builder()
    out.write("\t.intel_syntax noprefix\n")
    out.write(layout_asm())
    out.write(platform_header(platform))
    out.write("\t.text\n")
    out.write(g.text.to_str())
    out.write("\n\t.section .rodata\n")
    out.write(g.data.to_str())
    out.to_str()
}
