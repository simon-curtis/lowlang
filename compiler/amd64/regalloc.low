import ir
import std/slices

const spill_cost_modes = 3

pub fn float_regs() -> []str {
    ["xmm2", "xmm3", "xmm4", "xmm5", "xmm6", "xmm7", "xmm8", "xmm9", "xmm10", "xmm11", "xmm12", "xmm13", "xmm14", "xmm15"]
}

fn vector_regs() -> []str {
    ["ymm8", "ymm9", "ymm10", "ymm11", "ymm12", "ymm13", "ymm14", "ymm15"]
}

fn fixed(r: *Vreg) -> bool {
    r.konst != none || r.pool != none || r.frame != none || r.mem != none || r.pinned != ""
}

fn first(r: *Vreg) -> i64 {
    r.ranges[0].start
}

fn last(r: *Vreg) -> i64 {
    r.ranges[r.ranges.len - 1].end
}

fn add_range(r: *Vreg, start: i64, end: i64) {
    let n = r.ranges.len
    if n > 0 && r.ranges[n - 1].start <= end {
        r.ranges[n - 1].start = min_int(r.ranges[n - 1].start, start)
        r.ranges[n - 1].end = max_int(r.ranges[n - 1].end, end)
        return
    }
    r.ranges.push(Segment { start, end })
}

fn live_across(r: *Vreg, pos: i64) -> bool {
    r.ranges.any(fn(s) s.start < pos && pos < s.end)
}

fn overlaps(a: []Segment, b: []Segment) -> bool {
    var i = 0
    var j = 0
    for i < a.len && j < b.len {
        if a[i].start < b[j].end && b[j].start < a[i].end {
            return true
        }
        if a[i].end < b[j].end {
            i += 1
        } else {
            j += 1
        }
    }
    false
}

fn terminator_uses(mb: *Mblock) -> []*Vreg {
    var uses = slices.clone(mb.compare)
    match mb.control {
        some(c) => uses.push(c)
        none => {}
    }
    slices.concat(uses, mb.results)
}

fn registers(regs: []*Vreg) -> []*Vreg {
    var out: []*Vreg = []
    for r in regs {
        match r.mem {
            some(m) => {
                out = slices.concat(out, registers(pieces(m)))
            }
            none => {
                if !r.fixed() {
                    out.push(r)
                }
            }
        }
    }
    out
}

fn collectable(regs: []*Vreg) -> []*Vreg {
    var out: []*Vreg = []
    for r in regs {
        if !r.scalar {
            out.push(r)
        }
    }
    out
}

fn copy_step(pos: i64, copies: []*PhiCopy) -> Step {
    var st = Step { pos }
    for c in copies {
        st.uses = slices.concat(st.uses, registers([c.src]))
        st.defs.push(c.dst)
    }
    st
}

fn number(f: *Mfunc) {
    var pos = 0
    for mb in f.blocks {
        mb.start = pos
        pos += 2
        for ins in mb.instrs {
            ins.pos = pos
            pos += 2
        }
        mb.copy_pos = pos
        pos += 2
        mb.end = pos
        mb.build_steps()
    }
}

fn build_steps(mb: *Mblock) {
    mb.steps = []
    var params: []*Vreg = []
    for ins in mb.instrs {
        if ins.is_param() {
            params.push(dest(ins))
        }
    }
    if params.len > 0 {
        mb.steps.push(Step { pos: mb.start, defs: params })
    }
    if mb.heads.len > 0 {
        mb.steps.push(copy_step(mb.start + 1, mb.heads))
    }
    for ins in mb.instrs {
        if ins.is_param() {
            continue
        }
        let st = ins.step()
        mb.steps.push(st)
        if ins.op == OpCCall {
            mb.steps.push(Step { pos: ins.pos + 1, uses: collectable(st.uses) })
        }
    }
    if mb.copies.len > 0 {
        mb.steps.push(copy_step(mb.copy_pos, mb.copies))
    }
    mb.steps.push(Step { pos: mb.end, uses: registers(mb.terminator_uses()) })
}

fn step(ins: *Instr) -> Step {
    var st = Step { pos: ins.pos }
    var operands = ins.args
    if ins.op == OpVector && ins.args[0].home != none {
        st.defs.push(ins.args[0])
        operands = ins.args[1..]
    }
    st.uses = registers(operands)
    match ins.dst {
        some(d) => st.defs.push(d)
        none => {}
    }
    st
}

struct Occurrences {
    exposed: [][]i64 = []
    defined: [][]i64 = []
}

fn liveness(f: *Mfunc) {
    let n = f.blocks.len
    let preds = f.block_predecessors()
    let seen = f.occurrences()
    var live_in: [][]*Vreg = []
    var live_out: [][]*Vreg = []
    var defines: []i64 = []
    var entered: []i64 = []
    var left: []i64 = []
    for _ in 0..n {
        live_in.push([])
        live_out.push([])
        defines.push(-1)
        entered.push(-1)
        left.push(-1)
    }
    var work: []i64 = []
    for r in f.vregs {
        let v = r.id
        for b in seen.defined[v] {
            defines[b] = v
        }
        for b in seen.exposed[v] {
            entered[b] = v
            live_in[b].push(r)
            work.push(b)
        }
        for work.len > 0 {
            let b = work[work.len - 1]
            work.truncate(work.len - 1)
            for p in preds[b] {
                if left[p] != v {
                    left[p] = v
                    live_out[p].push(r)
                }
                if defines[p] != v && entered[p] != v {
                    entered[p] = v
                    live_in[p].push(r)
                    work.push(p)
                }
            }
        }
    }
    for i, mb in f.blocks {
        mb.live_in = live_in[i]
        mb.live_out = live_out[i]
    }
}

fn block_predecessors(f: *Mfunc) -> [][]i64 {
    let index: [*Mblock: i64] = [:]
    var preds: [][]i64 = []
    for i, mb in f.blocks {
        index[mb] = i
        preds.push([])
    }
    for i, mb in f.blocks {
        for s in mb.succs {
            preds[index[s] ?? panic("successor outside the function")].push(i)
        }
    }
    preds
}

fn occurrences(f: *Mfunc) -> Occurrences {
    var seen = Occurrences {}
    var used_at: []i64 = []
    var defined_at: []i64 = []
    for _ in f.vregs {
        seen.exposed.push([])
        seen.defined.push([])
        used_at.push(-1)
        defined_at.push(-1)
    }
    for i, mb in f.blocks {
        for st in mb.steps {
            for r in st.uses {
                if defined_at[r.id] != i && used_at[r.id] != i {
                    used_at[r.id] = i
                    seen.exposed[r.id].push(i)
                }
            }
            for r in st.defs {
                if defined_at[r.id] != i {
                    defined_at[r.id] = i
                    seen.defined[r.id].push(i)
                }
            }
        }
    }
    seen
}

fn build_ranges(f: *Mfunc) {
    for r in f.vregs {
        r.ranges = []
    }
    var open: []i64 = []
    for _ in f.vregs {
        open.push(-1)
    }
    var i = f.blocks.len - 1
    for i >= 0 {
        f.build_block_ranges(f.blocks[i], mut open)
        i -= 1
    }
    for r in f.vregs {
        r.ranges = reversed(r.ranges)
    }
}

fn reversed(list: []Segment) -> []Segment {
    var out: []Segment = []
    var i = list.len - 1
    for i >= 0 {
        out.push(list[i])
        i -= 1
    }
    out
}

fn build_block_ranges(f: *Mfunc, mb: *Mblock, mut open: []i64) {
    var touched = slices.clone(mb.live_out)
    for r in touched {
        open[r.id] = mb.end
    }
    var i = mb.steps.len - 1
    for i >= 0 {
        let st = mb.steps[i]
        for d in st.defs {
            let end = open[d.id]
            if end >= 0 {
                d.add_range(st.pos, end)
                open[d.id] = -1
            } else {
                d.add_range(st.pos, st.pos + 1)
            }
        }
        for u in st.uses {
            if open[u.id] < 0 {
                open[u.id] = st.pos
                touched.push(u)
            }
        }
        i -= 1
    }
    for r in touched {
        let end = open[r.id]
        if end >= 0 {
            r.add_range(mb.start, end)
            open[r.id] = -1
        }
    }
}

fn is_call(ins: *Instr) -> bool {
    ir.is_call(ins.op) && ins.literal == none
}

fn preserves_registers(ins: *Instr) -> bool {
    if ins.op != OpRuntime {
        return false
    }
    let rt = ins.value.runtime ?? return false
    ir.runtime_convention(rt) == CallGrow
}

fn mark_call_crossings(f: *Mfunc) {
    var clobbering: []i64 = []
    var preserving: []i64 = []
    var vector_clobbering: []i64 = []
    for mb in f.blocks {
        for ins in mb.instrs {
            if ins.clobbers_vectors() {
                vector_clobbering.push(ins.pos)
            }
            if ins.preserves_registers() {
                preserving.push(ins.pos)
            } else if ins.is_call() {
                clobbering.push(ins.pos)
            }
        }
    }
    for r in f.vregs {
        r.crosses_preserving = r.crosses_any(preserving)
        if r.home != none {
            r.crosses_call = r.crosses_any(vector_clobbering)
            continue
        }
        r.crosses_call = r.crosses_any(clobbering) || (r.crosses_preserving && !r.scalar)
    }
    f.settle_returned()
}

fn settle_returned(f: *Mfunc) {
    var stops: []i64 = []
    for mb in f.blocks {
        for ins in mb.instrs {
            if ir.is_call(ins.op) {
                stops.push(ins.pos)
                ins.keep_returned()
            }
        }
    }
    for r in f.vregs {
        if r.returned >= 0 && r.crosses_any(stops) {
            r.returned = -1
        }
    }
}

fn keep_returned(ins: *Instr) {
    var reach = 1 << 62
    if ins.op == OpCall && ins.literal == none {
        var stack = ins.args.len - arg_count
        if ir.is_indirect(ins.value) {
            stack -= 1
        }
        reach = 8 * max_int(0, stack)
    }
    for a in ins.args {
        if a.returned >= 0 && a.returned < reach {
            a.returned = -1
        }
    }
}

fn crosses_any(r: *Vreg, calls: []i64) -> bool {
    if calls.len == 0 {
        return false
    }
    for s in r.ranges {
        let i = slices.lower_bound(calls, s.start + 1)
        if i < calls.len && calls[i] < s.end {
            return true
        }
    }
    false
}

fn in_frame(r: *Vreg) -> bool {
    r.spill >= 0 || (r.arrival >= 0 && r.reg == "")
}

fn is_param(ins: *Instr) -> bool {
    ins.op == OpParam
}

struct Allocator {
    saved: []str
    caller: []str
    integers: []str
    floats: []str
    vectors: []str
    assigned: [][]*Vreg = []
    soonest: i64 = 1 << 62
    weighed: bool = false
    slots: [][]*Vreg = []
    slot_ends: []i64 = []
    used: []bool = []
    mode: i64
}

struct Placement {
    reg: str
    spill: i64
}

struct Outcome {
    alloc: *Allocator
    placed: []Placement = []
    cost: f64 = 0.0
}

struct Allocation {
    spills: i64
    saved: []str
}

fn spill_cost(mode: i64, r: *Vreg) -> f64 {
    let weight = f64(r.weight)
    let length = f64(r.length)
    match mode {
        0 => weight
        1 => weight / length
        _ => weight / sqrt(length)
    }
}

fn measure(r: *Vreg) {
    r.length = 0
    for s in r.ranges {
        r.length += s.end - s.start
    }
}

fn allocation_order(f: *Mfunc) -> []*Vreg {
    var order: []*Vreg = []
    for r in f.vregs {
        if r.ranges.len > 0 && !r.settled_in_memory() {
            r.measure()
            order.push(r)
        }
    }
    slices.sort_stable_by(mut order, fn(x: *Vreg, y: *Vreg) -> bool { x.first() < y.first() })
    order
}

fn settled_in_memory(r: *Vreg) -> bool {
    (r.arrival >= 0 || r.returned >= 0) && r.weight <= 2
}

fn place(f: *Mfunc, order: []*Vreg, mode: i64) -> Outcome {
    for r in order {
        r.reg = ""
        r.spill = -1
    }
    let a = new_allocator(mode)
    for r in order {
        a.assign(r)
    }
    var o = Outcome { alloc: a }
    for r in order {
        o.placed.push(Placement { reg: r.reg, spill: r.spill })
        if r.reg == "" {
            o.cost += f64(r.weight)
        }
    }
    for reg in abi_saved() {
        if a.used[register_slot(reg)] {
            o.cost += f64(save_cost)
        }
    }
    o
}

fn settled(best: Outcome?) -> bool {
    match best {
        some(b) => b.cost == 0.0 || !b.alloc.weighed
        none => false
    }
}

fn allocate(f: *Mfunc) -> Allocation {
    f.analyse()
    f.mark_light()
    f.weigh()
    let order = f.allocation_order()
    var best: Outcome? = none
    for mode in 0..spill_cost_modes {
        if settled(best) {
            break
        }
        let o = f.place(order, mode)
        match best {
            some(b) => {
                if o.cost < b.cost {
                    best = o
                }
            }
            none => {
                best = o
            }
        }
    }
    let chosen = best ?? panic("no allocation outcome")
    for i, r in order {
        r.reg = chosen.placed[i].reg
        r.spill = chosen.placed[i].spill
    }
    var saved: []str = []
    for r in abi_saved() {
        if chosen.alloc.used[register_slot(r)] {
            saved.push(r)
        }
    }
    Allocation { spills: chosen.alloc.slots.len, saved }
}

fn candidates(a: *Allocator, cur: *Vreg) -> []str {
    if cur.home != none {
        return a.vectors
    }
    if cur.float {
        return a.floats
    }
    if cur.crosses_call && cur.light {
        return []
    }
    if cur.crosses_call {
        return a.saved
    }
    if cur.light {
        return a.caller
    }
    a.integers
}

fn assign(a: *Allocator, cur: *Vreg) {
    a.expire(cur.first())
    if cur.clobbered() {
        a.spill(cur)
        return
    }
    let regs = a.candidates(cur)
    let preferred = a.preferred_fit(cur, regs)
    if preferred != "" {
        a.occupy(cur, preferred)
        return
    }
    let reg = a.first_fit(cur, regs)
    if reg != "" {
        a.occupy(cur, reg)
        return
    }
    a.displace(cur, regs)
}

fn preferred_fit(a: *Allocator, cur: *Vreg, regs: []str) -> str {
    if a.allowed_fit(cur, regs, cur.hint) {
        return cur.hint
    }
    for s in cur.sources {
        if a.allowed_fit(cur, regs, s.reg) {
            return s.reg
        }
    }
    for s in cur.sinks {
        if a.allowed_fit(cur, regs, s.reg) {
            return s.reg
        }
    }
    ""
}

fn clobbered(r: *Vreg) -> bool {
    (r.float || r.home != none) && (r.crosses_call || r.crosses_preserving)
}

fn allowed_fit(a: *Allocator, cur: *Vreg, regs: []str, reg: str) -> bool {
    reg != "" && slices.contains(regs, reg) && a.fits(cur, reg)
}

fn fits(a: *Allocator, cur: *Vreg, reg: str) -> bool {
    for r in a.assigned[register_slot(reg)] {
        if overlaps(cur.ranges, r.ranges) {
            return false
        }
    }
    true
}

fn sole_conflict(a: *Allocator, cur: *Vreg, reg: str) -> *Vreg? {
    var found: *Vreg? = none
    for r in a.assigned[register_slot(reg)] {
        if !overlaps(cur.ranges, r.ranges) {
            continue
        }
        if found != none {
            return none
        }
        found = r
    }
    found
}

fn first_fit(a: *Allocator, cur: *Vreg, regs: []str) -> str {
    var fallback = ""
    for reg in regs {
        if !a.fits(cur, reg) {
            continue
        }
        if cur.avoids(reg) {
            fallback = reg
            continue
        }
        return reg
    }
    fallback
}

fn avoids(r: *Vreg, reg: str) -> bool {
    let other = r.avoid ?? return false
    other.reg == reg
}

fn cheaper_to_spill(a: *Allocator, r: *Vreg, other: *Vreg) -> bool {
    a.weighed = true
    let x = spill_cost(a.mode, r)
    let y = spill_cost(a.mode, other)
    if x != y {
        return x < y
    }
    r.last() > other.last()
}

fn displace(a: *Allocator, cur: *Vreg, regs: []str) {
    var victim: *Vreg? = none
    for reg in regs {
        let found = a.sole_conflict(cur, reg) ?? continue
        match victim {
            some(v) => {
                if a.cheaper_to_spill(found, v) {
                    victim = found
                }
            }
            none => {
                victim = found
            }
        }
    }
    let v = victim ?? {
        a.spill(cur)
        return
    }
    if !a.cheaper_to_spill(v, cur) {
        a.spill(cur)
        return
    }
    let reg = v.reg
    a.unassign(v, reg)
    v.reg = ""
    a.spill(v)
    a.occupy(cur, reg)
}

fn expire(a: *Allocator, pos: i64) {
    if pos < a.soonest {
        return
    }
    a.soonest = 1 << 62
    for i in 0..a.assigned.len {
        a.expire_slot(i, pos)
    }
}

fn expire_slot(a: *Allocator, slot: i64, pos: i64) {
    var list = a.assigned[slot]
    var kept = 0
    for r in list {
        if r.last() > pos {
            list[kept] = r
            kept += 1
            a.soonest = min_int(a.soonest, r.last())
        }
    }
    if kept < list.len {
        list.truncate(kept)
        a.assigned[slot] = list
    }
}

fn unassign(a: *Allocator, v: *Vreg, reg: str) {
    let slot = register_slot(reg)
    var list = a.assigned[slot]
    var kept = 0
    for r in list {
        if r != v {
            list[kept] = r
            kept += 1
        }
    }
    list.truncate(kept)
    a.assigned[slot] = list
}

fn occupy(a: *Allocator, r: *Vreg, reg: str) {
    r.reg = reg
    a.used[register_slot(reg)] = true
    a.soonest = min_int(a.soonest, r.last())
    let slot = register_slot(reg)
    var list = a.assigned[slot]
    list.push(r)
    a.assigned[slot] = list
}

fn new_allocator(mode: i64) -> *Allocator {
    var assigned: [][]*Vreg = []
    var used: []bool = []
    for _ in 0..register_slots {
        assigned.push([])
        used.push(false)
    }
    new(Allocator { assigned, used, mode, saved: abi_saved(), caller: abi_caller(), integers: abi_integers(), floats: float_regs(), vectors: vector_regs() })
}

const register_slots = 24

fn register_slot(reg: str) -> i64 {
    let first = reg[0]
    if (first == 120 || first == 121) && reg.len >= 4 {
        var n = i64(reg[3]) - 48
        if reg.len == 5 {
            n = 10 * n + i64(reg[4]) - 48
        }
        if (first == 120 && n >= 2 && n <= 15) || (first == 121 && n >= 8 && n <= 15) {
            return 8 + n
        }
    }
    if first == 114 && reg.len == 2 && (reg[1] == 56 || reg[1] == 57) {
        return i64(reg[1]) - 53
    }
    if first == 114 && reg.len == 3 {
        let pair = i64(reg[1]) << 8 | i64(reg[2])
        match pair {
            0x6378 => return 0
            0x7369 => return 1
            0x6469 => return 2
            0x6278 => return 5
            0x3132 => return 6
            0x3133 => return 7
            0x3134 => return 8
            0x3135 => return 9
            _ => {}
        }
    }
    panic("register {reg} is not allocatable")
}

fn spill(a: *Allocator, r: *Vreg) {
    if r.home != none || r.arrival >= 0 || r.returned >= 0 {
        return
    }
    var slot = a.shared_slot(r)
    if slot < 0 {
        slot = a.vacant_slot(r)
    }
    if slot < 0 {
        slot = a.slots.len
        a.slots.push([])
        a.slot_ends.push(0)
    }
    r.spill = slot
    var occupants = a.slots[slot]
    occupants.push(r)
    a.slots[slot] = occupants
    a.slot_ends[slot] = max_int(a.slot_ends[slot], r.last())
}

fn vacant_slot(a: *Allocator, r: *Vreg) -> i64 {
    let start = r.first()
    for i, end in a.slot_ends {
        if end <= start {
            return i
        }
    }
    -1
}

fn shared_slot(a: *Allocator, r: *Vreg) -> i64 {
    for related in r.copy_peers {
        if related.spill < 0 || related.reg != "" {
            continue
        }
        let free = !slices.any(a.slots[related.spill], fn(occupant: *Vreg) -> bool { overlaps(occupant.ranges, r.ranges) })
        if free {
            return related.spill
        }
    }
    -1
}
