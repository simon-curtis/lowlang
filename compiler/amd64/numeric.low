import ir
import types
import std/text

fn max_int(a: i64, b: i64) -> i64 {
    if a > b { a } else { b }
}

fn min_int(a: i64, b: i64) -> i64 {
    if a < b { a } else { b }
}

fn dword_register(reg: str) -> str {
    match reg {
        "rax" => "eax"
        "rbx" => "ebx"
        "rcx" => "ecx"
        "rdx" => "edx"
        "rsi" => "esi"
        "rdi" => "edi"
        "r8" => "r8d"
        "r9" => "r9d"
        "r10" => "r10d"
        "r11" => "r11d"
        "r12" => "r12d"
        "r13" => "r13d"
        "r14" => "r14d"
        "r15" => "r15d"
        _ => ""
    }
}

fn word_register(reg: str) -> str {
    match reg {
        "rax" => "ax"
        "rbx" => "bx"
        "rcx" => "cx"
        "rdx" => "dx"
        "rsi" => "si"
        "rdi" => "di"
        "r8" => "r8w"
        "r9" => "r9w"
        "r10" => "r10w"
        "r11" => "r11w"
        "r12" => "r12w"
        "r13" => "r13w"
        "r14" => "r14w"
        "r15" => "r15w"
        _ => ""
    }
}

fn byte_register(reg: str) -> str {
    match reg {
        "rax" => "al"
        "rbx" => "bl"
        "rcx" => "cl"
        "rdx" => "dl"
        "rsi" => "sil"
        "rdi" => "dil"
        "r8" => "r8b"
        "r9" => "r9b"
        "r10" => "r10b"
        "r11" => "r11b"
        "r12" => "r12b"
        "r13" => "r13b"
        "r14" => "r14b"
        "r15" => "r15b"
        _ => ""
    }
}

fn narrow(reg: str, k: i64) -> str {
    match k {
        0 => dword_register(reg)
        1 => word_register(reg)
        _ => byte_register(reg)
    }
}

fn signed_condition(op: ir.Op) -> str {
    match op {
        OpEq => "e"
        OpNe => "ne"
        OpLt => "l"
        OpLe => "le"
        OpGt => "g"
        OpGe => "ge"
        _ => ""
    }
}

fn unsigned_condition(op: ir.Op) -> str {
    match op {
        OpEq => "e"
        OpNe => "ne"
        OpLt => "b"
        OpLe => "be"
        OpGt => "a"
        OpGe => "ae"
        _ => ""
    }
}

fn inverse(cond: str) -> str {
    match cond {
        "e" => "ne"
        "ne" => "e"
        "l" => "ge"
        "ge" => "l"
        "le" => "g"
        "g" => "le"
        "b" => "ae"
        "ae" => "b"
        "be" => "a"
        "a" => "be"
        "nz" => "z"
        "z" => "nz"
        _ => ""
    }
}

fn condition(v: *ir.Value) -> str {
    var signed = true
    match v.type {
        some(t) => {
            signed = !types.is_integer(t) || t.signed
        }
        none => {}
    }
    condition_of(v.op, signed)
}

fn condition_of(op: ir.Op, signed: bool) -> str {
    if signed {
        return signed_condition(op)
    }
    unsigned_condition(op)
}

fn is_float(t: *types.Type?) -> bool {
    match t {
        some(inner) => types.is_float(inner)
        none => false
    }
}

fn precision(t: *types.Type) -> str {
    if t.bits == 32 {
        return "s"
    }
    "d"
}

fn sub_register(bits: i64) -> i64 {
    match bits {
        16 => 1
        8 => 2
        _ => 0
    }
}

fn normalize(g: *Generator, loc: str, t: *types.Type?) {
    let ty = t ?? return
    if ty.bits == 0 || ty.bits == 64 {
        return
    }
    var reg = loc
    if !is_reg(loc) {
        g.move("r10", loc)
        reg = "r10"
    }
    g.emit(extension(reg, narrow(reg, sub_register(ty.bits)), ty))
    g.move(loc, reg)
}

fn extension(dst: str, src: str, t: *types.Type) -> str {
    if types.is_integer(t) && t.signed {
        return "movsxd {dst}, {src}"
    }
    if t.bits == 32 {
        return "mov {narrow(dst, 0)}, {src}"
    }
    "movzx {narrow(dst, 0)}, {src}"
}

fn arithmetic(g: *Generator, fr: *Frame, ins: *Instr) {
    let t = ins.value.type
    if is_float(t) {
        g.float_arithmetic(fr, ins)
        return
    }
    g.binary(fr, ins, binops(ins.op))
    if !word32(ins) {
        g.normalize(fr.loc(dest(ins)), t)
    }
}

fn word32(ins: *Instr) -> bool {
    match ins.value.type {
        some(t) => types.is_integer(t) && !t.signed && t.bits == 32
        none => false
    }
}

fn dword(loc: str) -> str {
    if is_reg(loc) {
        return narrow(loc, 0)
    }
    if is_mem(loc) {
        return text.replace(loc, "qword", "dword")
    }
    loc
}

fn sized(ins: *Instr, loc: str) -> str {
    if word32(ins) {
        return dword(loc)
    }
    loc
}

fn widens(from: *types.Type, to: *types.Type) -> bool {
    if !types.is_integer(from) || !types.is_integer(to) || to.bits == 0 || from.bits == 0 {
        return false
    }
    if !from.signed && !to.signed {
        return to.bits >= from.bits
    }
    if !from.signed {
        return to.bits > from.bits
    }
    to.signed && to.bits >= from.bits
}

fn negate(g: *Generator, fr: *Frame, ins: *Instr) {
    let t = ins.value.type
    if is_float(t) {
        g.float_negate(fr, ins)
        return
    }
    let dst = fr.loc(dest(ins))
    let work = g.work_register(dst)
    g.move(work, fr.loc(ins.args[0]))
    var operation = "neg"
    var operand = work
    if ins.op == OpCompl {
        operation = "not"
    }
    if word32(ins) {
        operand = dword(work)
    }
    g.emit("{operation} {operand}")
    if !word32(ins) {
        g.normalize(work, t)
    }
    g.move(dst, work)
}

fn divide(g: *Generator, fr: *Frame, ins: *Instr) {
    let t = ins.value.type
    if is_float(t) {
        g.arithmetic(fr, ins)
        return
    }
    let divisor = ins.args[1].konst
    let zero_possible = divisor == none || divisor == 0
    let minus_one_possible = divisor == none || divisor == -1
    let done = g.new_label()
    g.move("rax", fr.loc(ins.args[0]))
    g.move("r10", fr.loc(ins.args[1]))
    if zero_possible {
        g.emit("test r10, r10")
        g.emit("jz rt_panic_divzero")
    }
    var unsigned = false
    match t {
        some(ty) => {
            unsigned = !ty.signed
        }
        none => {}
    }
    if unsigned {
        g.emit("xor edx, edx")
        g.emit("div r10")
    } else {
        g.signed_divide(ins.op, done, minus_one_possible)
    }
    if ins.op == OpRem {
        g.emit("mov rax, rdx")
    }
    g.label(done)
    g.normalize("rax", t)
    g.move(fr.loc(dest(ins)), "rax")
}

fn signed_divide(g: *Generator, op: ir.Op, done: str, minus_one_possible: bool) {
    if !minus_one_possible {
        g.emit("cqo")
        g.emit("idiv r10")
        return
    }
    let normal = g.new_label()
    g.emit("cmp r10, -1")
    g.emit("jne {normal}")
    if op == OpDiv {
        g.emit("neg rax")
    } else {
        g.emit("xor eax, eax")
    }
    g.emit("jmp {done}")
    g.label(normal)
    g.emit("cqo")
    g.emit("idiv r10")
}

fn shift(g: *Generator, fr: *Frame, ins: *Instr) {
    let t = ins.value.type
    var op = "shl"
    if ins.op == OpShr {
        op = "shr"
        if types.must(t).signed {
            op = "sar"
        }
    }
    let dst = fr.loc(dest(ins))
    let count = ins.args[1]
    match count.konst {
        none => {
            g.move("r10", fr.loc(ins.args[0]))
            g.variable_shift(op, fr.loc(count))
            if op == "shl" {
                g.normalize("r10", t)
            }
            g.move(dst, "r10")
            return
        }
        some(_) => {}
    }
    let work = g.work_register(dst)
    g.move(work, fr.loc(ins.args[0]))
    let n = count.konst ?? 0
    if op == "shl" && word32(ins) && n >= 0 && n < 32 {
        g.emit("shl {dword(work)}, {n}")
    } else {
        g.constant_shift(op, work, n)
        if op == "shl" {
            g.normalize(work, t)
        }
    }
    g.move(dst, work)
}

fn constant_shift(g: *Generator, op: str, reg: str, n: i64) {
    if n >= 0 && n < 64 {
        g.emit("{op} {reg}, {n}")
        return
    }
    g.overshift(op, reg)
}

fn variable_shift(g: *Generator, op: str, count: str) {
    let big = g.new_label()
    let done = g.new_label()
    g.move("r11", "rcx")
    if count != "rcx" {
        g.emit("mov rcx, {count}")
    }
    g.emit("cmp rcx, 63")
    g.emit("ja {big}")
    g.emit("{op} r10, cl")
    g.emit("jmp {done}")
    g.label(big)
    g.overshift(op, "r10")
    g.label(done)
    g.move("rcx", "r11")
}

fn overshift(g: *Generator, op: str, reg: str) {
    if op == "sar" {
        g.emit("sar {reg}, 63")
        return
    }
    g.emit("xor {narrow(reg, 0)}, {narrow(reg, 0)}")
}

fn compare_values(g: *Generator, fr: *Frame, ins: *Instr) {
    let t = ins.value.type
    if !is_float(t) {
        g.compare(fr, ins.args[0], ins.args[1])
        var cond = condition(ins.value)
        if ins.negated {
            cond = inverse(cond)
        }
        g.emit("set{cond} al")
    } else {
        g.float_compare(fr, ins)
    }
    g.emit("movzx eax, al")
    g.move(fr.loc(dest(ins)), "rax")
}

fn convert(g: *Generator, fr: *Frame, ins: *Instr) {
    let from = types.must(ins.value.from)
    let to = types.must(ins.value.type)
    let src = fr.loc(ins.args[0])
    let dst = fr.loc(dest(ins))
    if types.is_integer(from) && types.is_integer(to) && widens(from, to) {
        g.move(dst, src)
    } else if types.is_integer(from) && types.is_integer(to) {
        g.move("r10", src)
        g.normalize("r10", to)
        g.move(dst, "r10")
    } else if is_u64(from) {
        g.unsigned_to_float(src, dst, to)
    } else if types.is_integer(from) {
        g.integer_to_float(src, dst, to)
    } else if is_u64(to) {
        g.float_to_unsigned(fr, ins.args[0], dst, from)
    } else if types.is_integer(to) {
        g.float_to_integer(fr, ins.args[0], dst, from, to)
    } else {
        g.float_to_float(fr, ins.args[0], dst, from, to)
    }
}

fn is_u64(t: *types.Type) -> bool {
    t.kind == IntKind && t.bits == 64 && !t.signed
}

fn is_i64(t: *types.Type) -> bool {
    t.kind == IntKind && t.bits == 64 && t.signed
}

fn is_u8(t: *types.Type) -> bool {
    t.kind == IntKind && t.bits == 8 && !t.signed
}

fn is_f32(t: *types.Type) -> bool {
    t.kind == FloatKind && t.bits == 32
}

fn mul_high(g: *Generator, fr: *Frame, ins: *Instr) {
    g.move("rax", fr.loc(ins.args[0]))
    var factor = fr.loc(ins.args[1])
    if !is_reg(factor) {
        g.move("r10", factor)
        factor = "r10"
    }
    var signed = false
    match ins.value.type {
        some(t) => {
            signed = t.signed
        }
        none => {}
    }
    if signed {
        g.emit("imul {factor}")
    } else {
        g.emit("mul {factor}")
    }
    g.move(fr.loc(dest(ins)), "rdx")
}

fn widths(bits: i64) -> str? {
    match bits {
        8 => "byte"
        16 => "word"
        32 => "dword"
        _ => none
    }
}

fn width_name(bits: i64) -> str {
    widths(bits) ?? ""
}

fn emit_load(g: *Generator, fr: *Frame, ins: *Instr) {
    let t = ins.value.type
    let memory = fr.frame_address(ins.args[0])
    let dst = fr.loc(dest(ins))
    if is_xmm(dst) {
        g.float_load(dst, t, memory)
        return
    }
    if t == none {
        g.move(dst, "qword ptr {memory}")
        return
    }
    let ty = types.must(t)
    var reg = dst
    if !is_reg(dst) {
        reg = "r10"
    }
    let access = "{width_name(ty.bits)} ptr {memory}"
    g.emit(extension(reg, access, ty))
    g.move(dst, reg)
}

fn emit_store(g: *Generator, fr: *Frame, ins: *Instr) {
    let t = ins.value.type
    let memory = fr.frame_address(ins.args[0])
    var value = fr.loc(ins.args[1])
    if is_xmm(value) {
        if g.float_store(memory, ins, value) {
            return
        }
        g.move("rax", value)
        value = "rax"
    }
    if is_mem(value) {
        g.move("rax", value)
        value = "rax"
    }
    var width = "qword"
    match t {
        some(ty) => {
            width = width_name(ty.bits)
            if is_reg(value) {
                value = narrow(value, sub_register(ty.bits))
            }
        }
        none => {}
    }
    g.emit("mov {width} ptr {memory}, {value}")
}
