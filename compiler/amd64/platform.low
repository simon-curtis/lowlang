import ir
import target
import std/builder
import std/slices

const sysv_vector_regs = 8

pub enum Platform {
    Sysv = 0
    Win64 = 1
}

pub fn new_platform(os: target.OS) -> Platform {
    if os == Windows {
        return Win64
    }
    Sysv
}

fn sysv_int_regs() -> []str {
    ["rdi", "rsi", "rdx", "rcx", "r8", "r9"]
}

pub fn platform_os(p: Platform) -> target.OS {
    match p {
        Sysv => target.OS.Linux
        Win64 => target.OS.Windows
    }
}

fn platform_entry(p: Platform) -> str {
    match p {
        Sysv => elf_entry_symbol
        Win64 => pe_entry_symbol
    }
}

fn platform_header(p: Platform) -> str {
    match p {
        Sysv => linux_header()
        Win64 => windows_header()
    }
}

fn platform_runtime(p: Platform) -> str {
    match p {
        Sysv => linux_runtime()
        Win64 => windows_runtime()
    }
}

fn platform_classify(p: Platform, sig: *ir.CSig) -> *CPlan {
    match p {
        Sysv => sysv_plan(sig)
        Win64 => win64_plan(sig)
    }
}

fn platform_int_regs(p: Platform) -> []str {
    match p {
        Sysv => sysv_int_regs()
        Win64 => win64_int_regs()
    }
}

fn platform_vector_regs(p: Platform) -> i64 {
    match p {
        Sysv => sysv_vector_regs
        Win64 => win64_int_regs().len
    }
}

fn platform_register_slots(p: Platform) -> i64 {
    match p {
        Sysv => 0
        Win64 => win64_int_regs().len
    }
}

fn platform_preserved_vectors(p: Platform) -> []str {
    match p {
        Sysv => []
        Win64 => win_preserved_vectors()
    }
}

fn platform_thunk_saved(p: Platform) -> []str {
    match p {
        Sysv => abi_saved()
        Win64 => slices.concat(abi_saved(), ["rdi", "rsi"])
    }
}

fn platform_positional(p: Platform) -> bool {
    p == Win64
}

fn platform_syscall(p: Platform, g: *Generator) {
    match p {
        Sysv => g.emit("syscall")
        Win64 => g.emit("call rt_panic_syscall")
    }
}

fn platform_variadic_count(p: Platform, g: *Generator, plan: *CPlan) {
    if p == Sysv {
        g.emit("mov eax, {plan.vectors}")
    }
}

fn platform_reserve(p: Platform, g: *Generator, size: i64) {
    if p == Sysv || size < page_size {
        if size > 0 {
            g.emit("sub rsp, {size}")
        }
        return
    }
    let probe = g.new_label()
    g.emit("lea r11, [rsp-{size}]")
    g.label(probe)
    g.emit("sub rsp, {page_size}")
    g.emit("test qword ptr [rsp], rsp")
    g.emit("cmp rsp, r11")
    g.emit("ja {probe}")
    g.emit("mov rsp, r11")
}

fn platform_external_target(p: Platform, symbol: str) -> str {
    match p {
        Sysv => symbol
        Win64 => "qword ptr [rip+{import_symbol(symbol)}]"
    }
}

fn platform_symbol_address(p: Platform, symbol: str) -> str {
    match p {
        Sysv => "qword ptr [rip+{symbol}@GOTPCREL]"
        Win64 => "qword ptr [rip+{import_symbol(symbol)}]"
    }
}

fn platform_imports(p: Platform, mut out: builder.Builder, prog: *ir.Program) {
    if p == Win64 {
        write_imports(mut out, prog)
    }
}

fn platform_dynamic(p: Platform, prog: *ir.Program) -> bool {
    if p == Sysv {
        return ir.libraries(prog).len > 0
    }
    false
}

fn platform_shims(p: Platform, g: *Generator, symbols: []str) {
    if p == Win64 {
        return
    }
    for symbol in symbols {
        match symbol {
            "atexit" => g.shim(symbol, "__cxa_atexit", ["xor esi, esi", "xor edx, edx"])
            "at_quick_exit" => g.shim(symbol, "__cxa_at_quick_exit", ["xor esi, esi"])
            _ => {}
        }
    }
}
