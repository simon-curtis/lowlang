import ir
import std/slices

const max_return_predecessors = 4

fn bare_return(mb: *Mblock) -> bool {
    mb.kind == Ret && mb.instrs.len == 0 && mb.copies.len == 0 && !mb.poll
}

fn returns_directly(mb: *Mblock) -> bool {
    mb.kind == Plain && !mb.poll && mb.succs.len == 1
}

fn duplicate_returns(f: *Mfunc) {
    let preds = f.predecessors()
    for ret in slices.clone(f.blocks) {
        let from = preds[ret] ?? []
        if !ret.bare_return() || from.len < 2 || from.len > max_return_predecessors {
            continue
        }
        if !slices.any(from, fn(p: *Mblock) -> bool { p.returns_directly() }) {
            continue
        }
        for p in from {
            if p.returns_directly() {
                p.return_instead(ret)
            }
        }
        let after = f.predecessors()
        if (after[ret] ?? []).len == 0 {
            f.blocks = slices.filter(f.blocks, fn(mb: *Mblock) -> bool { mb != ret })
        }
    }
}

fn return_instead(p: *Mblock, ret: *Mblock) {
    var sources: [*Vreg: *Vreg] = [:]
    for c in p.copies {
        sources[c.dst] = c.src
    }
    p.results = []
    for r in ret.results {
        push(mut p.results, sources[r] ?? r)
    }
    p.copies = []
    p.kind = Ret
    p.succs = []
}
