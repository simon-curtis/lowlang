import ir
import std/slices

fn returns_in_registers(ins: *Instr) -> bool {
    match ins.op {
        OpRuntime => true
        OpSyscall => true
        OpCall => abi_returns_in_registers(ir.result_words(ir.call_signature(ins.value)))
        _ => false
    }
}

fn pin_results(f: *Mfunc) {
    for mb in f.blocks {
        for i, ins in mb.instrs {
            if ins.returns_in_registers() {
                mb.pin_chain(i)
            }
        }
    }
}

fn pin_chain(mb: *Mblock, call: i64) {
    var end = call + 1
    var results: []*Instr = []
    for end < mb.instrs.len && mb.instrs[end].op == OpResult && mb.instrs[end].call == mb.instrs[call].value {
        push(mut results, mb.instrs[end])
        end += 1
    }
    let registers = abi_results()
    for ins in results {
        let k = ins.value.aux
        let dst = dest(ins)
        if k < registers.len && !dst.float && ins.value.uses == 1 && mb.consumes(end, dst) {
            dst.pinned = registers[k]
        }
    }
}

fn consumes(mb: *Mblock, next: i64, r: *Vreg) -> bool {
    if next < mb.instrs.len {
        return mb.instrs[next].instr_consumes(r)
    }
    !mb.poll && mb.terminator_consumes(r)
}

fn instr_consumes(ins: *Instr, r: *Vreg) -> bool {
    let at = slices.index(ins.args, r) ?? return false
    match ins.op {
        OpAdd => !is_float(ins.value.type)
        OpSub => !is_float(ins.value.type)
        OpMul => !is_float(ins.value.type)
        OpAnd => !is_float(ins.value.type)
        OpOr => !is_float(ins.value.type)
        OpXor => !is_float(ins.value.type)
        OpNot => !is_float(ins.value.type)
        OpNeg => !is_float(ins.value.type)
        OpCompl => !is_float(ins.value.type)
        OpStore => at == 1
        OpCall => true
        OpRuntime => true
        OpSyscall => true
        _ => false
    }
}

fn terminator_consumes(mb: *Mblock, r: *Vreg) -> bool {
    match mb.kind {
        Ret => return slices.contains(mb.results, r)
        If => return mb.control == r || slices.contains(mb.compare, r)
        _ => {}
    }
    slices.any(mb.copies, fn(c: *PhiCopy) -> bool { c.src == r })
}
