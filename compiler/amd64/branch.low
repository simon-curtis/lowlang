import ir
import std/slices

const max_threading_rounds = 4

fn simplify_branches(f: *Mfunc) {
    var round = 0
    for round < max_threading_rounds && f.thread_branches() {
        round += 1
    }
    f.peel_negations()
}

fn thread_branches(f: *Mfunc) -> bool {
    let s = new_selector(f)
    var preds = f.predecessors()
    var threaded = false
    for b in slices.clone(f.blocks) {
        if !s.threadable(b) {
            continue
        }
        for m in slices.clone(preds[b] ?? []) {
            if f.thread_predecessor(preds, m, b) {
                threaded = true
                preds = f.predecessors()
            }
        }
    }
    if threaded {
        f.drop_unreachable()
    }
    threaded
}

fn threadable(s: *Selector, b: *Mblock) -> bool {
    let control = b.control ?? return false
    if b.kind != If || b.fused != none || b.poll || control.fixed() {
        return false
    }
    if b.instrs.len != 0 || b.heads.len != 0 || b.copies.len != 0 {
        return false
    }
    s.use_count(control) == 1 && s.defs[control] == none
}

fn thread_predecessor(f: *Mfunc, preds: [*Mblock: []*Mblock], m: *Mblock, b: *Mblock) -> bool {
    if m == b || m.kind != Plain || m.succs.len != 1 || m.succs[0] != b || m.heads.len != 0 || m.copies.len != 1 {
        return false
    }
    let c = m.copies[0]
    let control = b.control ?? return false
    if c.dst != control {
        return false
    }
    m.copies = []
    match known_truth(preds, m, c.src) {
        some(taken) => {
            m.succs = [b.succs[taken]]
            return true
        }
        none => {}
    }
    m.kind = If
    m.control = c.src
    m.succs = slices.clone(b.succs)
    true
}

fn known_truth(preds: [*Mblock: []*Mblock], m: *Mblock, r: *Vreg) -> i64? {
    match r.konst {
        some(n) => {
            if n != 0 {
                return 0
            }
            return 1
        }
        none => {}
    }
    let from = preds[m] ?? []
    if from.len != 1 {
        return none
    }
    let p = from[0]
    if p.kind != If || p.fused != none || p.control != r || p.succs.len != 2 || p.succs[0] == p.succs[1] {
        return none
    }
    slices.index(p.succs, m) ?? -1
}

fn drop_unreachable(f: *Mfunc) {
    let reached = f.reach(f.blocks[0], none)
    f.blocks = slices.filter(f.blocks, fn(mb: *Mblock) -> bool { reached[mb] ?? false })
}

fn peel_negations(f: *Mfunc) {
    let s = new_selector(f)
    for mb in f.blocks {
        if mb.kind == If && mb.fused == none && mb.control != none {
            mb.peel_control(s)
        }
    }
}

fn peel_control(mb: *Mblock, s: *Selector) {
    for mb.instrs.len > 0 {
        let last = mb.instrs[mb.instrs.len - 1]
        let control = mb.control ?? return
        if last.dst != control || s.use_count(control) != 1 {
            return
        }
        if last.op == OpNot {
            mb.control = last.args[0]
            let first = mb.succs[0]
            mb.succs[0] = mb.succs[1]
            mb.succs[1] = first
        } else if ir.is_compare(last.op) {
            mb.fused = last.value
            mb.compare = slices.clone(last.args)
            mb.control = none
        } else {
            return
        }
        truncate(mut mb.instrs, mb.instrs.len - 1)
        if mb.fused != none {
            return
        }
    }
}

fn negate_compares(s: *Selector) {
    for mb in s.func.blocks {
        var local: [*Vreg: *Instr] = [:]
        for ins in mb.instrs {
            match ins.dst {
                some(d) => {
                    local[d] = ins
                }
                none => {}
            }
            if ins.op == OpNot {
                s.negate_compare(ins, local[ins.args[0]])
            }
        }
    }
}

fn negate_compare(s: *Selector, not: *Instr, target: *Instr?) {
    let found = target ?? return
    if !ir.is_compare(found.op) || s.use_count(not.args[0]) != 1 {
        return
    }
    found.dst = not.dst
    found.negated = !found.negated
    s.defs[dest(not)] = found
    s.dead[not] = true
}
