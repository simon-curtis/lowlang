import asm

const maps_symbol = "rt_maps"
const quad = 8

struct MapRef {
    symbol: str
    at: i64
    map: StackMap
}

fn maps_chunk(refs: []MapRef) -> asm.Chunk {
    var bytes: []u8 = []
    var fixups: []asm.ChunkFixup = []
    push_quad(mut bytes, refs.len)
    var position = quad + 2 * quad * refs.len
    for i, r in refs {
        let entry = quad + 2 * quad * i
        fixups.push(asm.ChunkFixup { offset: entry, kind: asm.abs64, symbol: r.symbol, addend: r.at })
        fixups.push(asm.ChunkFixup { offset: entry + quad, kind: asm.abs64, symbol: maps_symbol, addend: position })
        push_quad(mut bytes, 0)
        push_quad(mut bytes, 0)
        position += quad + quad * r.map.offsets.len
    }
    for r in refs {
        var count = r.map.offsets.len
        if r.map.segment {
            count = -1
        }
        push_quad(mut bytes, count)
        for offset in r.map.offsets {
            push_quad(mut bytes, offset)
        }
    }
    let symbols = [asm.ChunkSymbol { name: maps_symbol, offset: 0, defined: true, global: true }]
    asm.Chunk { section: ".rodata", align: quad, bytes, fixups, symbols }
}

fn push_quad(mut bytes: []u8, value: i64) {
    for i in 0..quad {
        bytes.push(u8(value >> (8 * i)))
    }
}
