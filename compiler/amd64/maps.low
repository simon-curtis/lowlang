import asm
import std/io

const maps_symbol = "rt_maps"
const quad = 8

struct MapRef {
    symbol: str
    at: i64
    map: StackMap
}

fn maps_chunk(refs: []MapRef) -> asm.Chunk {
    var fixups: []asm.ChunkFixup = []
    var position = quad + 2 * quad * refs.len
    for i, r in refs {
        let entry = quad + 2 * quad * i
        fixups.push(asm.ChunkFixup { offset: entry, kind: asm.abs64, symbol: r.symbol, addend: r.at })
        fixups.push(asm.ChunkFixup { offset: entry + quad, kind: asm.abs64, symbol: maps_symbol, addend: position })
        position += 3 * quad + quad * r.map.offsets.len
    }
    let bytes = io.buffer(position)
    io.set_le64(bytes, 0, refs.len)
    var at = quad + 2 * quad * refs.len
    for r in refs {
        var count = r.map.offsets.len
        if r.map.segment {
            count = -1
        }
        io.set_le64(bytes, at, count)
        at += quad
        for offset in r.map.offsets {
            io.set_le64(bytes, at, offset)
            at += quad
        }
        io.set_le64(bytes, at, r.map.low)
        io.set_le64(bytes, at + quad, r.map.high)
        at += 2 * quad
    }
    let symbols = [asm.ChunkSymbol { name: maps_symbol, offset: 0, defined: true, global: true }]
    asm.Chunk { section: ".rodata", align: quad, bytes, fixups, symbols }
}

fn literals_chunk(chunks: []DataChunk) -> asm.Chunk {
    var data: []u8 = []
    var symbols: []asm.ChunkSymbol = []
    for c in chunks {
        if c.literal {
            symbols.push(asm.ChunkSymbol { name: c.key, offset: data.len, defined: true })
            io.append(mut data, bytes(c.text))
        }
    }
    asm.Chunk { section: ".rodata", bytes: data, symbols }
}
