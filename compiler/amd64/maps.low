import asm
import std/io

const maps_symbol = "rt_maps"
const quad = 8

struct MapRef {
    symbol: str
    at: i64
    map: StackMap
}

struct MapTable {
    first: [i64: i64] = [:]
    next: []i64 = []
    maps: []StackMap = []
}

fn maps_chunk(refs: []MapRef) -> asm.Chunk {
    let t = new(MapTable {})
    var slots: []i64 = []
    for r in refs {
        slots.push(t.place_map(r.map))
    }
    var positions: []i64 = []
    var position = quad + 2 * quad * refs.len
    for m in t.maps {
        positions.push(position)
        position += 3 * quad + quad * m.offsets.len
    }
    var fixups: []asm.ChunkFixup = []
    for i, r in refs {
        let entry = quad + 2 * quad * i
        fixups.push(asm.ChunkFixup { offset: entry, kind: asm.abs64, symbol: r.symbol, addend: r.at })
        fixups.push(asm.ChunkFixup { offset: entry + quad, kind: asm.abs64, symbol: maps_symbol, addend: positions[slots[i]] })
    }
    let bytes = io.buffer(position)
    io.set_le64(bytes, 0, refs.len)
    var at = quad + 2 * quad * refs.len
    for m in t.maps {
        io.set_le64(bytes, at, map_count(m))
        at += quad
        for offset in m.offsets {
            io.set_le64(bytes, at, offset)
            at += quad
        }
        io.set_le64(bytes, at, m.low)
        io.set_le64(bytes, at + quad, m.high)
        at += 2 * quad
    }
    let symbols = [asm.ChunkSymbol { name: maps_symbol, offset: 0, defined: true, global: true }]
    asm.Chunk { section: ".rodata", align: quad, bytes, fixups, symbols }
}

fn place_map(t: *MapTable, m: StackMap) -> i64 {
    let hash = map_hash(m)
    var at = t.first[hash] ?? -1
    for at >= 0 {
        if same_map(t.maps[at], m) {
            return at
        }
        at = t.next[at]
    }
    let placed = t.maps.len
    t.next.push(t.first[hash] ?? -1)
    t.first[hash] = placed
    t.maps.push(m)
    placed
}

fn map_count(m: StackMap) -> i64 {
    if m.segment {
        return -1
    }
    m.offsets.len
}

fn map_hash(m: StackMap) -> i64 {
    var h = ((map_count(m) * 1000003) ^ m.low) * 1000003 ^ m.high
    for offset in m.offsets {
        h = (h * 1000003) ^ offset
    }
    h
}

fn same_map(a: StackMap, b: StackMap) -> bool {
    if map_count(a) != map_count(b) || a.low != b.low || a.high != b.high {
        return false
    }
    for i, offset in a.offsets {
        if b.offsets[i] != offset {
            return false
        }
    }
    true
}

fn literals_chunk(chunks: []DataChunk) -> asm.Chunk {
    var data: []u8 = []
    var symbols: []asm.ChunkSymbol = []
    for c in chunks {
        if c.literal {
            symbols.push(asm.ChunkSymbol { name: c.key, offset: data.len, defined: true })
            io.append(mut data, bytes(c.text))
        }
    }
    asm.Chunk { section: ".rodata", bytes: data, symbols }
}
