import ast
import std/text

pub struct StdFunction {
    pub path: str
    pub name: str
    pub params: []str
    pub result: str
    pub body: str
}

fn std_duplicate(l: *Linter, f: *ast.File, decl: *ast.Func) -> bool {
    if !decl.declared() {
        return false
    }
    let s = shape_of(decl) ?? return false
    for entry in std_functions() {
        if entry.body != s.body || !fits(entry, s) || inside(f, entry.path) {
            continue
        }
        report(l, decl.pos, "use-std", "{decl.name} repeats {entry.path}.{entry.name}; {how_to_call(f, decl, entry)}")
        return true
    }
    false
}

fn fits(entry: StdFunction, s: Shape) -> bool {
    if entry.params.len != s.params.len {
        return false
    }
    var bound: [str: str] = [:]
    for i, want in entry.params {
        if !bind(mut bound, want, s.params[i]) {
            return false
        }
    }
    bind(mut bound, entry.result, s.result)
}

fn bind(mut bound: [str: str], want: str, got: str) -> bool {
    if !type_parameter(want) {
        return want == got
    }
    match bound[want] {
        some(earlier) => earlier == got
        none => {
            bound[want] = got
            true
        }
    }
}

fn type_parameter(t: str) -> bool {
    t.len > 1 && t[0] == 'T' && t[1] >= '0' && t[1] <= '9'
}

fn inside(f: *ast.File, path: str) -> bool {
    let slash = text.last_index(f.path, "/")
    let dir = if slash < 0 { "" } else { f.path[0..slash] }
    dir == path || text.ends_with(dir, "/{path}")
}

fn how_to_call(f: *ast.File, decl: *ast.Func, entry: StdFunction) -> str {
    var args: []str = []
    for p in decl.params {
        args.push(p.name)
    }
    let listed = text.join(args, ", ")
    for imported in f.imports {
        if imported.path == entry.path {
            return "call {imported.alias}.{entry.name}({listed})"
        }
    }
    let alias = entry.path[text.last_index(entry.path, "/") + 1..]
    "import {entry.path} and call {alias}.{entry.name}({listed})"
}
