import ast
import diag

fn param_names(linter: *Linter, params: []*ast.Param) {
    for param in params {
        linter.check_name(param.pos, param.name)
    }
}

fn bound_names(linter: *Linter, node: ast.Node) {
    match node {
        Param(param) => linter.check_name(param.pos, param.name)
        FieldPattern(field) => {
            if !field.shorthand {
                linter.binding_name(field.bind)
            }
        }
        Pattern(pattern) => linter.pattern_names(pattern)
        SelectCase(case) => linter.check_name(case.pos, case.name)
        Stmt(stmt) => {
            match stmt {
                Let(binding) => linter.check_name(binding.pos, binding.name)
                ForIn(loop) => linter.loop_names(loop)
                _ => {}
            }
        }
        _ => {}
    }
}

fn binding_name(linter: *Linter, bound: *ast.Binding?) {
    let binding = bound ?? return
    linter.check_name(binding.pos, binding.name)
}

fn pattern_names(linter: *Linter, pattern: *ast.Pattern) {
    if pattern.local != none {
        linter.check_name(pattern.pos, pattern.name)
    }
    for binding in pattern.bindings {
        linter.check_name(binding.pos, binding.name)
    }
}

fn loop_names(linter: *Linter, loop: *ast.ForIn) {
    linter.check_name(loop.pos, loop.position)
    if one_letter(loop.key) && one_letter(loop.value) {
        linter.report(loop.pos, "one-letter-name", "{loop.key} and {loop.value} are one-letter names; name each for what it holds")
        return
    }
    linter.check_name(loop.pos, loop.key)
    linter.check_name(loop.pos, loop.value)
}

fn check_name(linter: *Linter, pos: diag.Pos, text: str) {
    if one_letter(text) {
        linter.report(pos, "one-letter-name", "{text} is a one-letter name; name it for what it holds")
    }
}

fn one_letter(text: str) -> bool {
    text.len == 1 && text != "_"
}
