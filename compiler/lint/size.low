import ast
import types

const large_struct_words = 64

fn struct_words(l: *Linter, decl: *ast.StructDecl) {
    if decl.c || decl.type_params.len > 0 {
        return
    }
    let t = decl.type ?? return
    let words = types.size(t)
    if words < large_struct_words {
        return
    }
    report(l, decl.pos, "large-struct", "{decl.name} is {words} words ({8 * words} bytes), and every copy of it moves all of them; split it into smaller structs, or hold its larger parts behind a pointer")
}
