import ast

fn style(linter: *Linter, source: *ast.File) {
    for decl in source.funcs {
        let body = decl.body ?? continue
        if decl.source().derived {
            continue
        }
        linter.param_names(decl.params)
        ast.inspect(ast.Node.Expr(ast.Expr.Block(body)), fn(node: ast.Node) -> bool { linter.style_visit(node) })
    }
    for decl in source.structs {
        linter.struct_words(decl)
        let on_drop = decl.on_drop ?? continue
        ast.inspect(ast.Node.Stmt(on_drop), fn(node: ast.Node) -> bool { linter.style_visit(node) })
    }
}

fn style_visit(linter: *Linter, node: ast.Node) -> bool {
    linter.bound_names(node)
    match node {
        Expr(expr) => {
            match expr {
                Call(call) => linter.receiver_call(call)
                _ => {}
            }
        }
        _ => {}
    }
    true
}
