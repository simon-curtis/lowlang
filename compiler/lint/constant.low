import ast
import builtin
import lexer
import types

const prefer_const = "prefer-const"

fn constant_func(l: *Linter, f: *ast.Func) {
    if !returns_constant(f) {
        return
    }
    report(l, f.pos, prefer_const, "{f.name} returns the same value on every call; use const {f.name}: {ast.type_text(f.result)} = … and drop the () where it is called")
}

fn returns_constant(f: *ast.Func) -> bool {
    if !f.declared() || f.external != none || f.as_value || f.callback {
        return false
    }
    if f.type_params.len > 0 || f.params.len > 0 || f.result == none || f.error != none {
        return false
    }
    let ret = f.ret_type ?? return false
    let body = f.body ?? return false
    if !scalar(ret) || body.stmts.len > 0 {
        return false
    }
    let tail = body.tail ?? return false
    constant(tail)
}

fn scalar(t: *types.Type) -> bool {
    t.is_integer() || t.is_float() || t.kind == BoolKind || t.kind == StrKind
}

fn constant(e: ast.Expr) -> bool {
    match e {
        IntLit(n) => true
        FloatLit(n) => true
        StrLit(n) => true
        BoolLit(n) => true
        Ident(n) => n.constant != none
        Selector(n) => n.constant != none
        Unary(n) => folded_unary(n.op) && constant(n.x)
        Binary(n) => constant_binary(n)
        Call(n) => n.builtin == builtin.ID.Convert && numeric_arg(n.args[0]) && constant(n.args[0])
        _ => false
    }
}

fn constant_binary(e: *ast.Binary) -> bool {
    let spine = ast.left_spine(e)
    for link in spine {
        if !folded_binary(link.op) || !constant(link.y) {
            return false
        }
    }
    constant(spine[spine.len - 1].x)
}

fn numeric_arg(e: ast.Expr) -> bool {
    let t = ast.type_of(e) ?? return false
    t.is_number()
}

fn folded_unary(op: lexer.Kind) -> bool {
    match op {
        Minus => true
        Tilde => true
        Not => true
        _ => false
    }
}

fn folded_binary(op: lexer.Kind) -> bool {
    match op {
        Plus => true
        Minus => true
        Star => true
        Slash => true
        Percent => true
        Amp => true
        Pipe => true
        Caret => true
        Shl => true
        Shr => true
        Eq => true
        NotEq => true
        Lt => true
        LtEq => true
        Gt => true
        GtEq => true
        AndAnd => true
        OrOr => true
        _ => false
    }
}
