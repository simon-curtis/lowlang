import ast
import diag
import std/text

const unreachable_note = "this code never runs; the statement before it always leaves the block"

fn unreachable(l: *Linter, b: *ast.Block) {
    for i, s in b.stmts {
        if !diverges(s) {
            continue
        }
        if i + 1 < b.stmts.len {
            report(l, ast.stmt_position(b.stmts[i + 1]), "unreachable", unreachable_note)
            return
        }
        let tail = b.tail ?? return
        report(l, ast.position(tail), "unreachable", unreachable_note)
        return
    }
}

fn diverges(s: ast.Stmt) -> bool {
    match s {
        Return(n) => true
        Fail(n) => true
        Break(n) => true
        Continue(n) => true
        ExprStmt(n) => {
            let t = ast.type_of(n.x) ?? return false
            t.is_never()
        }
        _ => false
    }
}

fn dropped_result(l: *Linter, s: *ast.ExprStmt) {
    let c = called(s.x) ?? return
    let t = ast.type_of(s.x) ?? return
    if t.is_void() || t.is_never() {
        return
    }
    report(l, c.pos, "dropped-result", "the {t.text()} this call returns is dropped; write let _ = … to discard it on purpose")
}

fn called(e: ast.Expr) -> *ast.Call? {
    match e {
        Call(c) => c
        Try(t) => called(t.x)
        _ => none
    }
}

fn prefer_let(l: *Linter, s: *ast.Let) {
    if !s.mutable {
        return
    }
    match s.pattern {
        some(p) => {
            if pattern_assigned(p) {
                return
            }
        }
        none => {
            let local = s.local ?? return
            if local.assigned {
                return
            }
        }
    }
    let d = diag.warning(s.pos, "prefer-let", "nothing changes this var; declare it with let")
    l.offer(d, let_fix(s.pos))
}

fn let_fix(at: diag.Pos) -> diag.Fix? {
    let line = diag.line_text(at) ?? return none
    let col = at.pos_col() - 1
    if col < 0 || col > line.len || !text.starts_with(line[col..], "var ") {
        return none
    }
    diag.Fix { title: "Declare it with let", safe: true, edits: [diag.Edit { pos: at, end: at.at_col(at.pos_col() + 3), text: "let" }] }
}

fn pattern_assigned(p: *ast.StructPattern) -> bool {
    for f in p.fields {
        match f.nested {
            some(nested) => {
                if pattern_assigned(nested) {
                    return true
                }
            }
            none => {
                let bind = f.bind ?? continue
                let local = bind.local ?? return true
                if local.assigned {
                    return true
                }
            }
        }
    }
    false
}
