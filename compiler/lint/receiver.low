import ast
import builtin
import types

struct Forward {
    target: *ast.Func
    index: i64
}

struct Effect {
    direct: bool = false
    forwards: []Forward = []
}

struct EffectScan {
    indices: [*ast.Local: i64] = [:]
    effects: []*Effect = []
}

fn receiver_call(linter: *Linter, call: *ast.Call) {
    if call.prepended || call.args.len == 0 {
        return
    }
    let callee = match call.callee {
        Ident(found) => found
        _ => return
    }
    let target = call.target ?? return
    if target.body == none || !linter.changes_first(target) || shadowed_by_field(call.args[0], callee.name) {
        return
    }
    let written = argument_text(call.args[0])
    let receiver = argument_text(unmarked(call.args[0]))
    let rest = if call.args.len > 1 { ", …" } else { "" }
    let passed = if call.args.len > 1 { "…" } else { "" }
    linter.report(call.pos, "receiver-call", "{callee.name} changes its first argument; call it on that argument: {receiver}.{callee.name}({passed}), not {callee.name}({written}{rest})")
}

fn shadowed_by_field(first: ast.Expr, name: str) -> bool {
    let held = ast.type_of(first) ?? return false
    held.struct_of().field(name) != none
}

fn unmarked(argument: ast.Expr) -> ast.Expr {
    match argument {
        Ref(marked) => marked.x
        _ => argument
    }
}

fn argument_text(argument: ast.Expr) -> str {
    match argument {
        Ref(marked) => "mut {argument_text(marked.x)}"
        _ => {
            let shown = subject_of(argument)
            if shown.ok { shown.text } else { "x" }
        }
    }
}

fn changes_first(linter: *Linter, target: *ast.Func) -> bool {
    match linter.changing[target] {
        some(known) => return known
        none => {}
    }
    let found = linter.reaches_change(Forward { target, index: 0 })
    linter.changing[target] = found
    found
}

fn reaches_change(linter: *Linter, start: Forward) -> bool {
    var seen: [*ast.Func: [i64: bool]] = [:]
    var pending: []Forward = [start]
    for {
        let next = pending.pop() ?? return false
        if seen.visited(next) {
            continue
        }
        let effects = linter.effects_of(next.target)
        if next.index >= effects.len {
            return true
        }
        let effect = effects[next.index]
        if effect.direct {
            return true
        }
        for forward in effect.forwards {
            pending.push(forward)
        }
    }
}

fn visited(mut seen: [*ast.Func: [i64: bool]], forward: Forward) -> bool {
    let indices = seen[forward.target] ?? [:]
    if indices[forward.index] != none {
        return true
    }
    indices[forward.index] = true
    seen[forward.target] = indices
    false
}

fn effects_of(linter: *Linter, target: *ast.Func) -> []*Effect {
    match linter.effects[target] {
        some(known) => return known
        none => {}
    }
    let scan = new(EffectScan {})
    for index, local in target.param_locals {
        scan.indices[local] = index
        scan.effects.push(new(Effect {}))
    }
    match target.body {
        some(body) => ast.inspect(ast.Node.Expr(ast.Expr.Block(body)), fn(node: ast.Node) -> bool { scan.effect_visit(node) })
        none => scan.unknown_body(target)
    }
    linter.effects[target] = scan.effects
    scan.effects
}

fn unknown_body(scan: *EffectScan, target: *ast.Func) {
    for index, local in target.param_locals {
        scan.effects[index].direct = is_pointer(local.type)
    }
}

fn effect_visit(scan: *EffectScan, node: ast.Node) -> bool {
    match node {
        Stmt(stmt) => {
            match stmt {
                Assign(assign) => scan.mark_direct(assign.target)
                _ => {}
            }
        }
        Expr(expr) => {
            match expr {
                Ref(marked) => scan.mark_direct(marked.x)
                Call(call) => scan.passed_on(call)
                _ => {}
            }
        }
        _ => {}
    }
    true
}

fn mark_direct(scan: *EffectScan, written: ast.Expr) {
    let effect = scan.effect_at(written) ?? return
    effect.direct = true
}

fn passed_on(scan: *EffectScan, call: *ast.Call) {
    if call.builtin != builtin.ID.None || call.call_variant() != none {
        return
    }
    for index, argument in call.args {
        if !is_pointer(ast.type_of(argument)) {
            continue
        }
        let effect = scan.effect_at(argument) ?? continue
        match call.target {
            some(target) => effect.forwards.push(Forward { target, index })
            none => { effect.direct = true }
        }
    }
}

fn effect_at(scan: *EffectScan, reached: ast.Expr) -> *Effect? {
    let local = root(reached) ?? return none
    let index = scan.indices[local] ?? return none
    scan.effects[index]
}

fn root(reached: ast.Expr) -> *ast.Local? {
    var current = reached
    for {
        current = match current {
            Ident(found) => return found.ident_local()
            Selector(inner) => inner.x
            Index(inner) => inner.x
            Slicing(inner) => inner.x
            Receiver(inner) => inner.x
            Ref(inner) => inner.x
            Unary(inner) => inner.x
            _ => return none
        }
    }
    none
}

fn is_pointer(held: *types.Type?) -> bool {
    let found = held ?? return false
    found.kind == types.Kind.PointerKind
}
