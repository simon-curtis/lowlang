import ast
import diag
import lexer
import std/slices
import std/text

const prefer_match = "prefer-match"

const min_tests = 2

struct Chain {
    links: []*ast.If
    tail: ast.Expr?
}

struct Comparison {
    subject: str
    arm: str
}

struct Subject {
    text: str
    ok: bool
}

fn if_chain(l: *Linter, head: *ast.If) {
    if l.chained[head] != none {
        return
    }
    let c = chain(l, head)
    if c.tail == none || c.links.len < min_tests {
        return
    }
    var subject = ""
    var arms: []str = []
    for i, link in c.links {
        let test = compared(link.cond) ?? return
        if i > 0 && test.subject != subject {
            return
        }
        subject = test.subject
        push(mut arms, test.arm)
    }
    suggest_match(l, head.pos, "this if chain tests", subject, arms)
}

fn chain(l: *Linter, head: *ast.If) -> Chain {
    var links: []*ast.If = [head]
    var cur = head
    for {
        let otherwise = cur.otherwise ?? return Chain { links, tail: none }
        match otherwise {
            If(next) => {
                l.chained[next] = true
                push(mut links, next)
                cur = next
            }
            _ => return Chain { links, tail: otherwise }
        }
    }
}

fn guard_clauses(l: *Linter, body: *ast.Block) {
    var end = body.stmts.len
    if body.tail == none {
        if end == 0 || !returns_value(body.stmts[end - 1]) {
            return
        }
        end -= 1
    }
    var subject = ""
    var arms: []str = []
    var pos = body.pos
    for end > 0 {
        let link = guard(body.stmts[end - 1]) ?? break
        let test = compared(link.cond) ?? break
        if arms.len > 0 && test.subject != subject {
            break
        }
        subject = test.subject
        push(mut arms, test.arm)
        pos = link.pos
        end -= 1
    }
    if arms.len < min_tests {
        return
    }
    slices.reverse(mut arms)
    suggest_match(l, pos, "these guard clauses test", subject, arms)
}

fn guard(s: ast.Stmt) -> *ast.If? {
    let e = match s {
        ExprStmt(x) => x.x
        _ => return none
    }
    let i: *ast.If? = match e {
        If(n) => n
        _ => none
    }
    let link = i ?? return none
    if link.otherwise != none || link.then.tail != none || link.then.stmts.len != 1 {
        return none
    }
    if !returns_value(link.then.stmts[0]) {
        return none
    }
    link
}

fn returns_value(s: ast.Stmt) -> bool {
    match s {
        Return(r) => r.value != none
        _ => false
    }
}

fn suggest_match(l: *Linter, pos: diag.Pos, what: str, subject: str, arms: []str) {
    var cases: []str = []
    for a in arms {
        push(mut cases, "{a} => …")
    }
    report(l, pos, prefer_match, "{what} {subject} against {text.join(arms, ", ")}; use match {subject} {{ {text.join(cases, ", ")}, _ => … }}")
}

fn compared(cond: ast.Expr) -> Comparison? {
    let b: *ast.Binary? = match cond {
        Binary(n) => n
        _ => none
    }
    let node = b ?? return none
    let op = comparison_operator(node.op) ?? return none
    match constant_of(node.y) {
        some(k) => return comparison(node.x, op, k)
        none => {}
    }
    let k = constant_of(node.x) ?? return none
    comparison(node.y, flipped(op), k)
}

fn comparison(subject: ast.Expr, op: str, constant: str) -> Comparison? {
    if constant_of(subject) != none {
        return none
    }
    let s = subject_of(subject)
    if !s.ok {
        return none
    }
    if op == "==" {
        return Comparison { subject: s.text, arm: constant }
    }
    Comparison { subject: s.text, arm: "{op} {constant}" }
}

fn comparison_operator(k: lexer.Kind) -> str? {
    match k {
        Eq => "=="
        NotEq => "!="
        Lt => "<"
        LtEq => "<="
        Gt => ">"
        GtEq => ">="
        _ => none
    }
}

fn flipped(op: str) -> str {
    match op {
        "<" => ">"
        "<=" => ">="
        ">" => "<"
        ">=" => "<="
        _ => op
    }
}

fn constant_of(e: ast.Expr) -> str? {
    match e {
        IntLit(n) => {
            if n.char {
                return diag.quote_char(u32(n.value))
            }
            "{n.value}"
        }
        StrLit(n) => diag.quote(n.value)
        Ident(n) => {
            if n.variant != none || n.constant != none {
                return n.name
            }
            none
        }
        Selector(n) => {
            if n.constant != none {
                let x = subject_of(n.x)
                return "{x.text}.{n.name}"
            }
            if n.variant != none {
                return n.name
            }
            none
        }
        _ => none
    }
}

fn subject_of(e: ast.Expr) -> Subject {
    match e {
        Ident(n) => Subject { text: n.name, ok: n.variant == none && !n.null }
        IntLit(n) => Subject { text: "{n.value}", ok: true }
        Selector(n) => {
            let x = subject_of(n.x)
            Subject { text: "{x.text}.{n.name}", ok: x.ok && n.variant == none }
        }
        Index(n) => {
            let x = subject_of(n.x)
            if !x.ok {
                return Subject { text: "", ok: false }
            }
            let i = subject_of(n.index)
            Subject { text: "{x.text}[{i.text}]", ok: i.ok }
        }
        Unary(n) => {
            if n.op != lexer.Kind.Star {
                return Subject { text: "", ok: false }
            }
            let x = subject_of(n.x)
            Subject { text: "*{x.text}", ok: x.ok }
        }
        _ => Subject { text: "", ok: false }
    }
}
