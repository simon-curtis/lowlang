import ast
import diag
import lexer
import std/text

const prefer_match = "prefer-match"

const min_constants = 2

struct Chain {
    links: []*ast.If
    tail: ast.Expr?
}

struct Comparison {
    subject: str
    constant: str
}

struct Subject {
    text: str
    ok: bool
}

fn if_chain(l: *Linter, head: *ast.If) {
    if l.chained[head] != none {
        return
    }
    let c = chain(l, head)
    if c.tail == none || c.links.len < min_constants {
        return
    }
    var subject = ""
    var arms: []str = []
    for i, link in c.links {
        let test = compared(link.cond) ?? return
        if i > 0 && test.subject != subject {
            return
        }
        subject = test.subject
        push(mut arms, test.constant)
    }
    suggest_match(l, head.pos, subject, arms)
}

fn chain(l: *Linter, head: *ast.If) -> Chain {
    var links: []*ast.If = [head]
    var cur = head
    for {
        let otherwise = cur.otherwise ?? return Chain { links, tail: none }
        match otherwise {
            If(next) => {
                l.chained[next] = true
                push(mut links, next)
                cur = next
            }
            _ => return Chain { links, tail: otherwise }
        }
    }
}

fn suggest_match(l: *Linter, pos: diag.Pos, subject: str, constants: []str) {
    var cases: []str = []
    for c in constants {
        push(mut cases, "{c} => …")
    }
    report(l, pos, prefer_match, "this if chain tests {subject} against {text.join(constants, ", ")}; use match {subject} {{ {text.join(cases, ", ")}, _ => … }}")
}

fn compared(cond: ast.Expr) -> Comparison? {
    let b: *ast.Binary? = match cond {
        Binary(n) => n
        _ => none
    }
    let node = b ?? return none
    if node.op != lexer.Kind.Eq {
        return none
    }
    var value = node.y
    var other = node.x
    var constant = ""
    match constant_of(value) {
        some(k) => { constant = k }
        none => {
            value = node.x
            other = node.y
            match constant_of(value) {
                some(k) => { constant = k }
                none => return none
            }
        }
    }
    if constant_of(other) != none {
        return none
    }
    let subject = subject_of(other)
    if !subject.ok {
        return none
    }
    Comparison { subject: subject.text, constant }
}

fn constant_of(e: ast.Expr) -> str? {
    match e {
        IntLit(n) => {
            if n.char {
                return diag.quote_char(u32(n.value))
            }
            "{n.value}"
        }
        StrLit(n) => diag.quote(n.value)
        Ident(n) => {
            if n.variant != none || n.constant != none {
                return n.name
            }
            none
        }
        Selector(n) => {
            if n.constant != none {
                let x = subject_of(n.x)
                return "{x.text}.{n.name}"
            }
            if n.variant != none {
                return n.name
            }
            none
        }
        _ => none
    }
}

fn subject_of(e: ast.Expr) -> Subject {
    match e {
        Ident(n) => Subject { text: n.name, ok: n.variant == none && !n.null }
        IntLit(n) => Subject { text: "{n.value}", ok: true }
        Selector(n) => {
            let x = subject_of(n.x)
            Subject { text: "{x.text}.{n.name}", ok: x.ok && n.variant == none }
        }
        Index(n) => {
            let x = subject_of(n.x)
            if !x.ok {
                return Subject { text: "", ok: false }
            }
            let i = subject_of(n.index)
            Subject { text: "{x.text}[{i.text}]", ok: i.ok }
        }
        Unary(n) => {
            if n.op != lexer.Kind.Star {
                return Subject { text: "", ok: false }
            }
            let x = subject_of(n.x)
            Subject { text: "*{x.text}", ok: x.ok }
        }
        _ => Subject { text: "", ok: false }
    }
}
