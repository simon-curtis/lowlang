import ast
import diag
import lexer
import std/slices
import std/text

const min_tests = 2

struct Chain {
    links: []*ast.If
    tail: ast.Expr?
}

struct Comparison {
    subject: str
    arm: str
}

struct Subject {
    text: str
    ok: bool
}

struct Shared {
    subject: str
    arms: []str
}

fn if_chain(l: *Linter, head: *ast.If) {
    if l.chained[head] != none {
        return
    }
    let c = chain(l, head)
    if c.tail == none || c.links.len < min_tests {
        return
    }
    var tests: [][]Comparison = []
    for link in c.links {
        let found = candidates(link.cond)
        if found.len == 0 {
            return
        }
        tests.push(found)
    }
    let s = shared(tests) ?? return
    suggest_match(l, head.pos, "this if chain tests", s)
}

fn chain(l: *Linter, head: *ast.If) -> Chain {
    var links: []*ast.If = [head]
    var cur = head
    for {
        let otherwise = cur.otherwise ?? return Chain { links, tail: none }
        match otherwise {
            If(next) => {
                l.chained[next] = true
                links.push(next)
                cur = next
            }
            _ => return Chain { links, tail: otherwise }
        }
    }
}

fn guard_clauses(l: *Linter, body: *ast.Block) {
    var end = body.stmts.len
    if body.tail == none {
        if end == 0 || !returns_value(body.stmts[end - 1]) {
            return
        }
        end -= 1
    }
    var tests: [][]Comparison = []
    var pos = body.pos
    for end > 0 {
        let link = guard(body.stmts[end - 1]) ?? break
        let found = candidates(link.cond)
        if found.len == 0 {
            break
        }
        tests.push(found)
        if shared(tests) == none {
            tests.truncate(tests.len - 1)
            break
        }
        pos = link.pos
        end -= 1
    }
    if tests.len < min_tests {
        return
    }
    slices.reverse(mut tests)
    let s = shared(tests) ?? return
    suggest_match(l, pos, "these guard clauses test", s)
}

fn shared(tests: [][]Comparison) -> Shared? {
    for first in tests[0] {
        let arms = arms_for(tests, first.subject) ?? continue
        return Shared { subject: first.subject, arms }
    }
    none
}

fn arms_for(tests: [][]Comparison, subject: str) -> []str? {
    var arms: []str = []
    for found in tests {
        let arm = arm_of(found, subject) ?? return none
        arms.push(arm)
    }
    arms
}

fn arm_of(found: []Comparison, subject: str) -> str? {
    for c in found {
        if c.subject == subject {
            return c.arm
        }
    }
    none
}

fn guard(s: ast.Stmt) -> *ast.If? {
    let e = match s {
        ExprStmt(x) => x.x
        _ => return none
    }
    let i: *ast.If? = match e {
        If(n) => n
        _ => none
    }
    let link = i ?? return none
    if link.otherwise != none || link.then.tail != none || link.then.stmts.len != 1 {
        return none
    }
    if !returns_value(link.then.stmts[0]) {
        return none
    }
    link
}

fn returns_value(s: ast.Stmt) -> bool {
    match s {
        Return(r) => r.value != none
        _ => false
    }
}

fn suggest_match(l: *Linter, pos: diag.Pos, what: str, s: Shared) {
    var cases: []str = []
    for a in s.arms {
        cases.push("{a} => …")
    }
    report(l, pos, "prefer-match", "{what} {s.subject} against {text.join(s.arms, ", ")}; use match {s.subject} {{ {text.join(cases, ", ")}, _ => … }}")
}

fn candidates(cond: ast.Expr) -> []Comparison {
    let b: *ast.Binary? = match cond {
        Binary(n) => n
        _ => none
    }
    let node = b ?? return []
    let op = comparison_operator(node.op) ?? return []
    match constant_of(node.y) {
        some(k) => return against(node.x, op, k)
        none => {}
    }
    match constant_of(node.x) {
        some(k) => return against(node.y, flipped(op), k)
        none => {}
    }
    let x = subject_of(node.x)
    let y = subject_of(node.y)
    if !x.ok || !y.ok || x.text == y.text {
        return []
    }
    [operand_arm(x.text, op, y.text), operand_arm(y.text, flipped(op), x.text)]
}

fn against(subject: ast.Expr, op: str, constant: str) -> []Comparison {
    if constant_of(subject) != none {
        return []
    }
    let s = subject_of(subject)
    if !s.ok {
        return []
    }
    if op == "==" {
        return [Comparison { subject: s.text, arm: constant }]
    }
    [Comparison { subject: s.text, arm: "{op} {constant}" }]
}

fn operand_arm(subject: str, op: str, operand: str) -> Comparison {
    if op == "==" {
        return Comparison { subject, arm: "({operand})" }
    }
    Comparison { subject, arm: "{op} {operand}" }
}

fn comparison_operator(k: lexer.Kind) -> str? {
    match k {
        Eq => "=="
        NotEq => "!="
        Lt => "<"
        LtEq => "<="
        Gt => ">"
        GtEq => ">="
        _ => none
    }
}

fn flipped(op: str) -> str {
    match op {
        "<" => ">"
        "<=" => ">="
        ">" => "<"
        ">=" => "<="
        _ => op
    }
}

fn constant_of(e: ast.Expr) -> str? {
    match e {
        IntLit(n) => {
            if n.char {
                return diag.quote_char(u32(n.value))
            }
            "{n.value}"
        }
        StrLit(n) => diag.quote(n.value)
        Ident(n) => {
            if n.ident_variant() != none || n.ident_constant() != none {
                return n.name
            }
            none
        }
        Selector(n) => {
            if n.selector_constant() != none {
                let x = subject_of(n.x)
                return "{x.text}.{n.name}"
            }
            if n.selector_variant() != none {
                return n.name
            }
            none
        }
        _ => none
    }
}

fn subject_of(e: ast.Expr) -> Subject {
    match e {
        Ident(n) => Subject { text: n.name, ok: n.ident_variant() == none && !n.null }
        IntLit(n) => Subject { text: "{n.value}", ok: true }
        Selector(n) => {
            let x = subject_of(n.x)
            Subject { text: "{x.text}.{n.name}", ok: x.ok && n.selector_variant() == none }
        }
        Index(n) => {
            let x = subject_of(n.x)
            if !x.ok {
                return Subject { text: "", ok: false }
            }
            let i = subject_of(n.index)
            Subject { text: "{x.text}[{i.text}]", ok: i.ok }
        }
        Unary(n) => {
            if n.op != lexer.Kind.Star {
                return Subject { text: "", ok: false }
            }
            let x = subject_of(n.x)
            Subject { text: "*{x.text}", ok: x.ok }
        }
        _ => Subject { text: "", ok: false }
    }
}
