import ast
import diag
import std/text

pub enum Rules {
    Compile
    All
}

pub fn run(files: []*ast.File, rules: Rules, each: fn(i64, fn(i64)), unloaded: fn(str) -> [str: bool]) -> []*diag.Diagnostic {
    var found: [][]*diag.Diagnostic = []
    var decls: [][]Decl = []
    for _ in files {
        found.push([])
        decls.push([])
    }
    each(files.len, fn(i: i64) {
        let l = new(Linter {})
        file(l, files[i])
        if rules == Rules.All {
            l.style(files[i])
        }
        found[i] = l.warnings
        decls[i] = file_decls(files[i])
    })
    var warnings = unused_decls(files, decls, each, unloaded)
    for list in found {
        for w in list {
            warnings.push(w)
        }
    }
    diag.sort(mut warnings)
    warnings
}

struct Linter {
    warnings: []*diag.Diagnostic = []
    reported: [str: bool] = [:]
    chained: [*ast.If: bool] = [:]
    effects: [*ast.Func: []*Effect] = [:]
    changing: [*ast.Func: bool] = [:]
}

fn file(l: *Linter, f: *ast.File) {
    for decl in f.funcs {
        let body = decl.body ?? continue
        if decl.source().derived || std_duplicate(l, f, decl) {
            continue
        }
        constant_func(l, decl)
        guard_clauses(l, body)
        ast.inspect(ast.Node.Expr(ast.Expr.Block(body)), fn(n: ast.Node) -> bool { visit(l, n) })
    }
    for decl in f.structs {
        let on_drop = decl.on_drop ?? continue
        ast.inspect(ast.Node.Stmt(on_drop), fn(n: ast.Node) -> bool { visit(l, n) })
    }
}

fn visit(l: *Linter, n: ast.Node) -> bool {
    match n {
        Expr(e) => {
            match e {
                If(i) => if_chain(l, i)
                Block(b) => {
                    relays(l, b)
                    unreachable(l, b)
                }
                Call(c) => method_call(l, c)
                _ => {}
            }
        }
        Stmt(s) => {
            match s {
                Let(n) => prefer_let(l, n)
                ExprStmt(n) => dropped_result(l, n)
                _ => {}
            }
        }
        _ => {}
    }
    true
}

fn method_call(l: *Linter, c: *ast.Call) {
    if c.prepended {
        return
    }
    let name = match c.builtin {
        Push => "push"
        Pop => "pop"
        Truncate => "truncate"
        Delete => "delete"
        _ => return
    }
    let d = diag.warning(c.pos, "method-call", "call {name} on its first argument: x.{name}(…), not {name}(mut x, …)")
    l.offer(d, method_fix(c.pos, name))
}

fn offer(l: *Linter, d: *diag.Diagnostic, fix: diag.Fix?) {
    match fix {
        some(f) => d.fixes.push(f)
        none => {}
    }
    l.warned(d)
}

fn method_fix(at: diag.Pos, name: str) -> diag.Fix? {
    let line = diag.line_text(at) ?? return none
    let start = at.pos_col() - 1
    let opening = "{name}(mut "
    if start < 0 || start > line.len || !text.starts_with(line[start..], opening) {
        return none
    }
    let first = start + opening.len
    let close = argument_end(line, first) ?? return none
    let receiver = text.trim(line[first..close])
    if line[close] == ')' {
        return some(method_edit(at, close + 1, "{receiver}.{name}()"))
    }
    var next = close + 1
    for next < line.len && line[next] == ' ' {
        next += 1
    }
    some(method_edit(at, next, "{receiver}.{name}("))
}

fn method_edit(at: diag.Pos, end: i64, replacement: str) -> diag.Fix {
    let edit = diag.Edit { pos: at, end: at.at_col(end + 1), text: replacement }
    diag.Fix { title: "Call it as a method", safe: true, edits: [edit] }
}

fn argument_end(line: str, from: i64) -> i64? {
    var depth = 0
    for i in from..line.len {
        let c = line[i]
        if c == '"' || c == '\'' {
            return none
        }
        if c == '(' || c == '[' || c == '{' {
            depth += 1
        } else if depth > 0 && (c == ')' || c == ']' || c == '}') {
            depth -= 1
        } else if depth == 0 && (c == ',' || c == ')') {
            return i
        }
    }
    none
}

fn report(l: *Linter, pos: diag.Pos, rule: str, msg: str) {
    l.warned(diag.warning(pos, rule, msg))
}

fn warned(l: *Linter, d: *diag.Diagnostic) {
    let key = diag.text(d.pos)
    if l.reported[key] != none {
        return
    }
    l.reported[key] = true
    l.warnings.push(d)
}
