import ast
import diag
import std/slices

pub struct Warning {
    pub pos: diag.Pos
    pub rule: str
    pub msg: str
}

pub fn string(w: Warning) -> str {
    "{diag.text(w.pos)}: warning: {w.msg} [{w.rule}]"
}

pub fn run(files: []*ast.File) -> []Warning {
    let l = new(Linter {})
    for f in files {
        file(l, f)
    }
    slices.sort_stable_by(mut l.warnings, fn(a: Warning, b: Warning) -> bool { compare(a, b) < 0 })
    l.warnings
}

fn compare(a: Warning, b: Warning) -> i64 {
    if a.pos.file != b.pos.file {
        return if a.pos.file < b.pos.file { -1 } else { 1 }
    }
    if a.pos.line != b.pos.line {
        return if a.pos.line < b.pos.line { -1 } else { 1 }
    }
    if a.pos.col != b.pos.col {
        return if a.pos.col < b.pos.col { -1 } else { 1 }
    }
    0
}

struct Linter {
    warnings: []Warning = []
    reported: [str: bool] = [:]
    chained: [*ast.If: bool] = [:]
}

fn file(l: *Linter, f: *ast.File) {
    for decl in f.funcs {
        let body = decl.body ?? continue
        if decl.source().derived {
            continue
        }
        constant_func(l, decl)
        ast.inspect(ast.Node.Expr(ast.Expr.Block(body)), fn(n: ast.Node) -> bool { visit(l, n) })
    }
    for decl in f.structs {
        let on_drop = decl.on_drop ?? continue
        ast.inspect(ast.Node.Stmt(on_drop), fn(n: ast.Node) -> bool { visit(l, n) })
    }
}

fn visit(l: *Linter, n: ast.Node) -> bool {
    match n {
        Expr(e) => {
            match e {
                If(i) => if_chain(l, i)
                Block(b) => relays(l, b)
                _ => {}
            }
        }
        _ => {}
    }
    true
}

fn report(l: *Linter, pos: diag.Pos, rule: str, msg: str) {
    let key = diag.text(pos)
    if l.reported[key] != none {
        return
    }
    l.reported[key] = true
    push(mut l.warnings, Warning { pos, rule, msg })
}
