import ast
import diag
import std/slices

pub struct Warning {
    pub pos: diag.Pos
    pub rule: str
    pub msg: str
}

pub fn string(w: Warning) -> str {
    "{diag.text(w.pos)}: warning: {w.msg} [{w.rule}]"
}

pub fn run(files: []*ast.File) -> []Warning {
    let l = new(Linter {})
    for f in files {
        file(l, f)
    }
    slices.sort_stable_by(mut l.warnings, fn(a: Warning, b: Warning) -> bool { compare(a, b) < 0 })
    l.warnings
}

fn compare(a: Warning, b: Warning) -> i64 {
    if a.pos.pos_file() != b.pos.pos_file() {
        return if a.pos.pos_file() < b.pos.pos_file() { -1 } else { 1 }
    }
    if a.pos.pos_line() != b.pos.pos_line() {
        return if a.pos.pos_line() < b.pos.pos_line() { -1 } else { 1 }
    }
    if a.pos.pos_col() != b.pos.pos_col() {
        return if a.pos.pos_col() < b.pos.pos_col() { -1 } else { 1 }
    }
    0
}

struct Linter {
    warnings: []Warning = []
    reported: [str: bool] = [:]
    chained: [*ast.If: bool] = [:]
}

fn file(l: *Linter, f: *ast.File) {
    for decl in f.funcs {
        let body = decl.body ?? continue
        if decl.source().derived || std_duplicate(l, f, decl) {
            continue
        }
        constant_func(l, decl)
        guard_clauses(l, body)
        ast.inspect(ast.Node.Expr(ast.Expr.Block(body)), fn(n: ast.Node) -> bool { visit(l, n) })
    }
    for decl in f.structs {
        let on_drop = decl.on_drop ?? continue
        ast.inspect(ast.Node.Stmt(on_drop), fn(n: ast.Node) -> bool { visit(l, n) })
    }
}

fn visit(l: *Linter, n: ast.Node) -> bool {
    match n {
        Expr(e) => {
            match e {
                If(i) => if_chain(l, i)
                Block(b) => relays(l, b)
                Call(c) => method_call(l, c)
                _ => {}
            }
        }
        _ => {}
    }
    true
}

fn method_call(l: *Linter, c: *ast.Call) {
    if c.prepended {
        return
    }
    let name = match c.builtin {
        Push => "push"
        Pop => "pop"
        Truncate => "truncate"
        Delete => "delete"
        _ => return
    }
    report(l, c.pos, "method-call", "call {name} on its first argument: x.{name}(…), not {name}(mut x, …)")
}

fn report(l: *Linter, pos: diag.Pos, rule: str, msg: str) {
    let key = diag.text(pos)
    if l.reported[key] != none {
        return
    }
    l.reported[key] = true
    l.warnings.push(Warning { pos, rule, msg })
}
