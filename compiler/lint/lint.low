import ast
import diag

pub enum Rules {
    Compile
    All
}

pub fn run(files: []*ast.File, rules: Rules, each: fn(i64, fn(i64))) -> []*diag.Diagnostic {
    var found: [][]*diag.Diagnostic = []
    for _ in files {
        found.push([])
    }
    each(files.len, fn(i: i64) {
        let l = new(Linter {})
        file(l, files[i])
        if rules == Rules.All {
            l.style(files[i])
        }
        found[i] = l.warnings
    })
    var warnings: []*diag.Diagnostic = []
    for list in found {
        for w in list {
            warnings.push(w)
        }
    }
    diag.sort(mut warnings)
    warnings
}

struct Linter {
    warnings: []*diag.Diagnostic = []
    reported: [str: bool] = [:]
    chained: [*ast.If: bool] = [:]
    effects: [*ast.Func: []*Effect] = [:]
    changing: [*ast.Func: bool] = [:]
}

fn file(l: *Linter, f: *ast.File) {
    for decl in f.funcs {
        let body = decl.body ?? continue
        if decl.source().derived || std_duplicate(l, f, decl) {
            continue
        }
        constant_func(l, decl)
        guard_clauses(l, body)
        ast.inspect(ast.Node.Expr(ast.Expr.Block(body)), fn(n: ast.Node) -> bool { visit(l, n) })
    }
    for decl in f.structs {
        let on_drop = decl.on_drop ?? continue
        ast.inspect(ast.Node.Stmt(on_drop), fn(n: ast.Node) -> bool { visit(l, n) })
    }
}

fn visit(l: *Linter, n: ast.Node) -> bool {
    match n {
        Expr(e) => {
            match e {
                If(i) => if_chain(l, i)
                Block(b) => relays(l, b)
                Call(c) => method_call(l, c)
                _ => {}
            }
        }
        _ => {}
    }
    true
}

fn method_call(l: *Linter, c: *ast.Call) {
    if c.prepended {
        return
    }
    let name = match c.builtin {
        Push => "push"
        Pop => "pop"
        Truncate => "truncate"
        Delete => "delete"
        _ => return
    }
    report(l, c.pos, "method-call", "call {name} on its first argument: x.{name}(…), not {name}(mut x, …)")
}

fn report(l: *Linter, pos: diag.Pos, rule: str, msg: str) {
    let key = diag.text(pos)
    if l.reported[key] != none {
        return
    }
    l.reported[key] = true
    l.warnings.push(diag.warning(pos, rule, msg))
}
