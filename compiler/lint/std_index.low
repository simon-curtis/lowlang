fn std_functions() -> []StdFunction {
    [
        StdFunction { path: "std/http", name: "status_text", params: ["i64"], result: "str", body: "(200 == x0) ? \"OK\" ; (404 == x0) ? \"Not Found\" ; (500 == x0) ? \"Internal Server Error\" ; (100 == x0) ? \"Continue\" ; (101 == x0) ? \"Switching Protocols\" ; (201 == x0) ? \"Created\" ; (202 == x0) ? \"Accepted\" ; (204 == x0) ? \"No Content\" ; (206 == x0) ? \"Partial Content\" ; (301 == x0) ? \"Moved Permanently\" ; (302 == x0) ? \"Found\" ; (303 == x0) ? \"See Other\" ; (304 == x0) ? \"Not Modified\" ; (307 == x0) ? \"Temporary Redirect\" ; (308 == x0) ? \"Permanent Redirect\" ; (400 == x0) ? \"Bad Request\" ; (401 == x0) ? \"Unauthorized\" ; (403 == x0) ? \"Forbidden\" ; (405 == x0) ? \"Method Not Allowed\" ; (407 == x0) ? \"Proxy Authentication Required\" ; (408 == x0) ? \"Request Timeout\" ; (409 == x0) ? \"Conflict\" ; (411 == x0) ? \"Length Required\" ; (413 == x0) ? \"Content Too Large\" ; (414 == x0) ? \"URI Too Long\" ; (415 == x0) ? \"Unsupported Media Type\" ; (416 == x0) ? \"Range Not Satisfiable\" ; (417 == x0) ? \"Expectation Failed\" ; (422 == x0) ? \"Unprocessable Content\" ; (426 == x0) ? \"Upgrade Required\" ; (429 == x0) ? \"Too Many Requests\" ; (431 == x0) ? \"Request Header Fields Too Large\" ; (501 == x0) ? \"Not Implemented\" ; (502 == x0) ? \"Bad Gateway\" ; (503 == x0) ? \"Service Unavailable\" ; (504 == x0) ? \"Gateway Timeout\" ; (505 == x0) ? \"HTTP Version Not Supported\" ; \"\"" }
        StdFunction { path: "std/math", name: "abs", params: ["T0"], result: "T0", body: "(x0 < 0) ? (-x0) ; x0" }
        StdFunction { path: "std/math", name: "min", params: ["T0", "T0"], result: "T0", body: "(x1 < x0) ? x1 ; x0" }
        StdFunction { path: "std/math", name: "max", params: ["T0", "T0"], result: "T0", body: "(x0 < x1) ? x1 ; x0" }
        StdFunction { path: "std/math", name: "clamp", params: ["T0", "T0", "T0"], result: "T0", body: "(x0 < x1) ? x1 ; (x2 < x0) ? x2 ; x0" }
        StdFunction { path: "std/math", name: "compare", params: ["T0", "T0"], result: "i64", body: "(x0 < x1) ? -1 ; (x1 < x0) ? 1 ; 0" }
        StdFunction { path: "std/quic/wire", name: "varint_size", params: ["i64"], result: "i64", body: "(x0 < 0) ? 8 ; (x0 < 64) ? 1 ; (x0 < 16384) ? 2 ; (x0 < 1073741824) ? 4 ; 8" }
        StdFunction { path: "std/text", name: "lower_byte", params: ["u8"], result: "u8", body: "((65 <= x0) && (x0 <= 90)) ? (x0 + 32) ; x0" }
        StdFunction { path: "std/text", name: "upper_byte", params: ["u8"], result: "u8", body: "((97 <= x0) && (x0 <= 122)) ? (x0 - 32) ; x0" }
        StdFunction { path: "std/text", name: "lead_len", params: ["u8"], result: "i64", body: "(240 <= x0) ? 4 ; (224 <= x0) ? 3 ; (192 <= x0) ? 2 ; 1" }
        StdFunction { path: "std/text", name: "char_len", params: ["u32"], result: "i64", body: "(x0 < 128) ? 1 ; (x0 < 2048) ? 2 ; (x0 < 65536) ? 3 ; 4" }
    ]
}
