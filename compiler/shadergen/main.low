import emit
import shaders
import std/file
import std/io
import std/os
import std/process

enum Error {
    Failed(message: str)
}

fn main() {
    let arguments = os.args()[1..]
    if arguments.len != 1 {
        emit.eprint("usage: shadergen <shader directory>")
        os.exit(2)
    }
    run(arguments[0]) catch {
        Failed(message) => {
            emit.eprint("shadergen: {message}")
            os.exit(1)
        }
    }
}

fn run(dir: str) ! Error {
    let stages = shaders.stages(dir) catch {
        e => fail Failed("open {dir}: {emit.io_message(e)}")
    }
    for stage in stages {
        compile_stage(dir, stage)?
    }
    let sum = shaders.sum(dir) catch {
        e => fail Failed("open {dir}: {emit.io_message(e)}")
    }
    let path = file.child_path(dir, shaders.sum_file)
    file.write_text_mode(path, sum, 0o644) catch {
        e => fail Failed("open {path}: {emit.io_message(e)}")
    }
}

fn compile_stage(dir: str, stage: str) ! Error {
    let source = file.child_path(dir, stage)
    let output = file.child_path(dir, shaders.binary(stage))
    let arguments = ["-O", "--target-env={shaders.target_env}", source, "-o", output]
    let command = process.command("glslc", arguments)
    using child = process.start(command) catch {
        NotFound => fail Failed("glslc {stage}: exec: \"glslc\": executable file not found in $PATH")
        e => fail Failed("glslc {stage}: {emit.io_message(e)}")
    }
    let status = process.wait(child) catch {
        e => fail Failed("glslc {stage}: {emit.io_message(e)}")
    }
    if !process.success(status) {
        fail Failed("glslc {stage}: {describe_exit(status)}")
    }
}

fn describe_exit(status: process.Exit) -> str {
    match status {
        Exited(code) => "exit status {code}"
        Signaled(signal) => "signal: {signal}"
    }
}
