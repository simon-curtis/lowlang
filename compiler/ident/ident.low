import check
import diag
import lexer
import types

pub struct Reserved {
    builtins: [str: bool]
}

pub fn reserved() -> Reserved {
    let universe = types.new_universe(fn(t: *types.Type) ! diag.Error {})
    let names: [str: bool] = [:]
    for b in check.builtins(universe) {
        names[b.name] = true
    }
    Reserved { builtins: names }
}

pub fn ident(r: Reserved, name: str) -> str {
    if lexer.is_keyword(name) || r.builtins[name] != none {
        return "{name}_"
    }
    name
}
