import std/slices
import std/text

fn report(benchmarks: []str, languages: []Language, results: [str: *Entry]) {
    let baseline = languages[0].name
    print("| Benchmark | Language | Build | Binary | Median | Min | CPU | Peak RSS | vs {baseline} |")
    print("|---|---|--:|--:|--:|--:|--:|--:|--:|")
    var failures: []str = []
    for bench in benchmarks {
        let base = results[result_key(bench, baseline)]
        for lang in languages {
            let e = results[result_key(bench, lang.name)] ?? failed_entry("not measured")
            print(row(e, bench, lang.name, base))
            if e.message != "" {
                push(mut failures, "{bench}/{lang.name}: {e.message}")
            }
        }
    }
    for f in failures {
        print("\n{f}")
    }
}

fn row(e: *Entry, bench: str, lang: str, base: *Entry?) -> str {
    if e.message != "" {
        return "| {bench} | {lang} | failed | | | | | | |"
    }
    let walls = wall_times(e)
    let cpus = cpu_times(e)
    let cells = [
        bench
        lang
        format_duration(e.build)
        bytesize(e.size)
        format_duration(median(walls))
        format_duration(minimum(walls))
        format_duration(median(cpus))
        bytesize(peak_rss(e))
        ratio(e, base)
    ]
    "| {text.join(cells, " | ")} |"
}

fn wall_times(e: *Entry) -> []i64 {
    var values: []i64 = []
    for s in e.samples {
        push(mut values, s.wall)
    }
    values
}

fn cpu_times(e: *Entry) -> []i64 {
    var values: []i64 = []
    for s in e.samples {
        push(mut values, s.cpu)
    }
    values
}

fn peak_rss(e: *Entry) -> i64 {
    var peak = 0
    for s in e.samples {
        if s.rss > peak {
            peak = s.rss
        }
    }
    peak
}

fn minimum(values: []i64) -> i64 {
    var smallest = values[0]
    for v in values {
        if v < smallest {
            smallest = v
        }
    }
    smallest
}

fn ratio(e: *Entry, base: *Entry?) -> str {
    let reference = base ?? return "-"
    if reference.message != "" {
        return "-"
    }
    let mine = median(wall_times(e))
    let theirs = median(wall_times(reference))
    "{text.fixed(f64(mine) / f64(theirs), 2)}x"
}

fn median(values: []i64) -> i64 {
    var sorted = values
    slices.sort(mut sorted)
    let mid = sorted.len / 2
    if sorted.len % 2 == 1 {
        return sorted[mid]
    }
    (sorted[mid - 1] + sorted[mid]) / 2
}

fn format_duration(d: i64) -> str {
    if d < 1000000000 {
        return "{text.fixed(f64(d) / 1000000.0, 1)} ms"
    }
    "{text.fixed(f64(d) / 1000000000.0, 2)} s"
}

fn bytesize(n: i64) -> str {
    let mb = 1048576
    if n < mb {
        return "{text.fixed(f64(n) / 1024.0, 0)} KB"
    }
    "{text.fixed(f64(n) / f64(mb), 1)} MB"
}
