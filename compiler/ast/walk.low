pub enum Node {
    File(*File)
    Import(*Import)
    StructDecl(*StructDecl)
    FieldDecl(*FieldDecl)
    EnumDecl(*EnumDecl)
    VariantDecl(*VariantDecl)
    Const(*Const)
    Func(*Func)
    Param(*Param)
    TypeParam(*TypeParam)
    TypeName(*TypeName)
    Pattern(*Pattern)
    Binding(*Binding)
    SelectCase(*SelectCase)
    FieldInit(*FieldInit)
    StructPattern(*StructPattern)
    FieldPattern(*FieldPattern)
    Stmt(Stmt)
    Expr(Expr)
}

pub fn inspect(n: Node, visit: fn(Node) -> bool) {
    if !visit(n) {
        return
    }
    match n {
        File(f) => walk_file(f, visit)
        Import(i) => {}
        StructDecl(d) => {
            walk_type_params(d.type_params, visit)
            for f in d.fields {
                inspect(FieldDecl(f), visit)
            }
            match d.on_drop {
                some(s) => inspect(Stmt(s), visit)
                none => {}
            }
        }
        FieldDecl(f) => {
            walk_type_name(f.type_name, visit)
            walk_expr(f.default, visit)
        }
        EnumDecl(d) => {
            walk_type_params(d.type_params, visit)
            for v in d.variants {
                inspect(VariantDecl(v), visit)
            }
        }
        VariantDecl(v) => walk_type_names(v.fields, visit)
        Const(k) => {
            walk_type_name(k.type_name, visit)
            inspect(Expr(k.value), visit)
        }
        Func(f) => {
            walk_type_params(f.type_params, visit)
            walk_params(f.params, visit)
            walk_type_name(f.result, visit)
            walk_type_name(f.error, visit)
            walk_block(f.body, visit)
        }
        Param(p) => walk_type_name(p.type_name, visit)
        TypeParam(p) => {}
        TypeName(t) => {
            walk_type_name(t.key, visit)
            walk_type_name(t.elem, visit)
            walk_type_name(t.result, visit)
            walk_type_name(t.error, visit)
            walk_type_names(t.args, visit)
            walk_type_names(t.params, visit)
        }
        Pattern(p) => {
            walk_expr(p.test, visit)
            for b in p.bindings {
                inspect(Binding(b), visit)
            }
        }
        Binding(b) => {}
        SelectCase(c) => {
            walk_expr(c.chan, visit)
            walk_expr(c.value, visit)
            inspect(Expr(c.body), visit)
        }
        FieldInit(f) => inspect(Expr(f.value), visit)
        StructPattern(p) => {
            for f in p.fields {
                inspect(FieldPattern(f), visit)
            }
        }
        FieldPattern(f) => {
            walk_pattern(f.nested, visit)
            match f.bind {
                some(b) => inspect(Binding(b), visit)
                none => {}
            }
        }
        Stmt(s) => walk_stmt(s, visit)
        Expr(e) => walk_children(e, visit)
    }
}

fn walk_stmt(s: Stmt, visit: fn(Node) -> bool) {
    match s {
        Let(n) => {
            walk_pattern(n.pattern, visit)
            walk_type_name(n.type_name, visit)
            inspect(Expr(n.value), visit)
        }
        Assign(n) => {
            inspect(Expr(n.target), visit)
            inspect(Expr(n.value), visit)
        }
        ExprStmt(n) => inspect(Expr(n.x), visit)
        For(n) => {
            walk_expr(n.cond, visit)
            walk_block(n.body, visit)
        }
        Break(n) => {}
        Continue(n) => {}
        Return(n) => walk_expr(n.value, visit)
        Fail(n) => inspect(Expr(n.value), visit)
        Defer(n) => inspect(Stmt(n.body), visit)
        Spawn(n) => {
            match n.body {
                some(body) => inspect(Expr(Block(body)), visit)
                none => inspect(Expr(Call(n.call)), visit)
            }
        }
        Send(n) => {
            inspect(Expr(n.chan), visit)
            inspect(Expr(n.value), visit)
        }
        ForIn(n) => {
            walk_pattern(n.pattern, visit)
            inspect(Expr(n.iter), visit)
            walk_expr(n.end, visit)
            walk_block(n.body, visit)
        }
    }
}

fn walk_children(e: Expr, visit: fn(Node) -> bool) {
    match e {
        Block(n) => {
            for s in n.stmts {
                inspect(Stmt(s), visit)
            }
            walk_expr(n.tail, visit)
        }
        IntLit(n) => {}
        FloatLit(n) => {}
        StrLit(n) => {}
        BoolLit(n) => {}
        Ident(n) => {}
        Subject(n) => {}
        Select(n) => {
            for c in n.cases {
                inspect(SelectCase(c), visit)
            }
        }
        Selector(n) => inspect(Expr(n.x), visit)
        StructLit(n) => {
            walk_type_names(n.type_args, visit)
            for f in n.fields {
                inspect(FieldInit(f), visit)
            }
        }
        Ref(n) => inspect(Expr(n.x), visit)
        Index(n) => {
            inspect(Expr(n.x), visit)
            inspect(Expr(n.index), visit)
        }
        Instance(n) => {
            inspect(Expr(n.x), visit)
            walk_type_names(n.types, visit)
            walk_expr(n.fallback, visit)
        }
        Closure(n) => {
            walk_params(n.params, visit)
            walk_type_name(n.result, visit)
            walk_type_name(n.error, visit)
            walk_block(n.body, visit)
        }
        Slicing(n) => {
            inspect(Expr(n.x), visit)
            walk_expr(n.lo, visit)
            walk_expr(n.hi, visit)
        }
        SliceLit(n) => walk_exprs(n.elems, visit)
        MapLit(n) => {
            walk_exprs(n.keys, visit)
            walk_exprs(n.values, visit)
        }
        Interp(n) => {
            for part in n.parts {
                inspect(Expr(part.x), visit)
            }
        }
        Unary(n) => inspect(Expr(n.x), visit)
        Binary(n) => {
            inspect(Expr(n.x), visit)
            inspect(Expr(n.y), visit)
        }
        Call(n) => {
            inspect(Expr(n.callee), visit)
            walk_exprs(n.args, visit)
        }
        If(n) => {
            inspect(Expr(n.cond), visit)
            walk_block(n.then, visit)
            walk_expr(n.otherwise, visit)
        }
        Match(n) => {
            inspect(Expr(n.x), visit)
            walk_arms(n.arms, visit)
        }
        Try(n) => inspect(Expr(n.x), visit)
        Catch(n) => {
            inspect(Expr(n.x), visit)
            walk_arms(n.arms, visit)
            match n.map {
                some(map) => inspect(Expr(Call(map)), visit)
                none => {}
            }
        }
        Or(n) => {
            inspect(Expr(n.x), visit)
            inspect(Expr(n.fallback), visit)
        }
        Receiver(n) => inspect(Expr(n.x), visit)
    }
}

fn walk_expr(e: Expr?, visit: fn(Node) -> bool) {
    match e {
        some(x) => inspect(Expr(x), visit)
        none => {}
    }
}

fn walk_exprs(list: []Expr, visit: fn(Node) -> bool) {
    for e in list {
        inspect(Expr(e), visit)
    }
}

fn walk_pattern(p: *StructPattern?, visit: fn(Node) -> bool) {
    match p {
        some(pattern) => inspect(StructPattern(pattern), visit)
        none => {}
    }
}

fn walk_block(b: *Block?, visit: fn(Node) -> bool) {
    match b {
        some(block) => inspect(Expr(Block(block)), visit)
        none => {}
    }
}

fn walk_arms(arms: []*Arm, visit: fn(Node) -> bool) {
    for a in arms {
        inspect(Pattern(a.pattern), visit)
        inspect(Expr(a.body), visit)
    }
}

fn walk_file(f: *File, visit: fn(Node) -> bool) {
    for imp in f.imports {
        inspect(Import(imp), visit)
    }
    for d in f.structs {
        inspect(StructDecl(d), visit)
    }
    for d in f.enums {
        inspect(EnumDecl(d), visit)
    }
    for d in f.consts {
        inspect(Const(d), visit)
    }
    for func in f.declared_funcs() {
        inspect(Func(func), visit)
    }
}

fn walk_params(params: []*Param, visit: fn(Node) -> bool) {
    for p in params {
        inspect(Param(p), visit)
    }
}

fn walk_type_params(params: []*TypeParam, visit: fn(Node) -> bool) {
    for p in params {
        inspect(TypeParam(p), visit)
    }
}

fn walk_type_name(t: *TypeName?, visit: fn(Node) -> bool) {
    match t {
        some(name) => inspect(TypeName(name), visit)
        none => {}
    }
}

fn walk_type_names(list: []*TypeName, visit: fn(Node) -> bool) {
    for t in list {
        inspect(TypeName(t), visit)
    }
}
