pub enum Node {
    File(*File)
    Import(*Import)
    StructDecl(*StructDecl)
    FieldDecl(*FieldDecl)
    EnumDecl(*EnumDecl)
    VariantDecl(*VariantDecl)
    Const(*Const)
    Func(*Func)
    Param(*Param)
    TypeParam(*TypeParam)
    TypeName(*TypeName)
    Pattern(*Pattern)
    Binding(*Binding)
    SelectCase(*SelectCase)
    FieldInit(*FieldInit)
    StructPattern(*StructPattern)
    FieldPattern(*FieldPattern)
    Stmt(Stmt)
    Expr(Expr)
}

struct Visitor {
    visit: fn(Node) -> bool
}

pub fn inspect(n: Node, visit: fn(Node) -> bool) {
    let w = new(Visitor { visit })
    walk(n, w)
}

fn walk(n: Node, w: *Visitor) {
    if !w.visit(n) {
        return
    }
    match n {
        File(f) => walk_file(f, w)
        Import(i) => {}
        StructDecl(d) => {
            walk_type_params(d.type_params, w)
            for f in d.fields {
                walk(FieldDecl(f), w)
            }
            match d.on_drop {
                some(s) => walk(Stmt(s), w)
                none => {}
            }
        }
        FieldDecl(f) => {
            walk_type_name(f.type_name, w)
            walk_expr(f.default, w)
        }
        EnumDecl(d) => {
            walk_type_params(d.type_params, w)
            for v in d.variants {
                walk(VariantDecl(v), w)
            }
        }
        VariantDecl(v) => walk_type_names(v.fields, w)
        Const(k) => {
            walk_type_name(k.type_name, w)
            walk(Expr(k.value), w)
        }
        Func(f) => {
            walk_type_params(f.type_params, w)
            walk_params(f.params, w)
            walk_type_name(f.result, w)
            walk_type_name(f.error, w)
            walk_block(f.body, w)
        }
        Param(p) => walk_type_name(p.type_name, w)
        TypeParam(p) => {}
        TypeName(t) => {
            walk_type_name(t.key, w)
            walk_type_name(t.elem, w)
            walk_type_name(t.result, w)
            walk_type_name(t.error, w)
            walk_type_names(t.args, w)
            walk_type_names(t.params, w)
        }
        Pattern(p) => {
            walk_expr(p.test, w)
            for b in p.bindings {
                walk(Binding(b), w)
            }
        }
        Binding(b) => {}
        SelectCase(c) => {
            walk_expr(c.chan, w)
            walk_expr(c.value, w)
            walk(Expr(c.body), w)
        }
        FieldInit(f) => walk(Expr(f.value), w)
        StructPattern(p) => {
            for f in p.fields {
                walk(FieldPattern(f), w)
            }
        }
        FieldPattern(f) => {
            walk_pattern(f.nested, w)
            match f.bind {
                some(b) => walk(Binding(b), w)
                none => {}
            }
        }
        Stmt(s) => walk_stmt(s, w)
        Expr(e) => walk_children(e, w)
    }
}

fn walk_stmt(s: Stmt, w: *Visitor) {
    match s {
        Let(n) => {
            walk_pattern(n.pattern, w)
            walk_type_name(n.type_name, w)
            walk(Expr(n.value), w)
        }
        Assign(n) => {
            walk(Expr(n.target), w)
            walk(Expr(n.value), w)
        }
        ExprStmt(n) => walk(Expr(n.x), w)
        For(n) => {
            walk_expr(n.cond, w)
            walk_block(n.body, w)
        }
        Break(n) => {}
        Continue(n) => {}
        Return(n) => walk_expr(n.value, w)
        Fail(n) => walk(Expr(n.value), w)
        Defer(n) => walk(Stmt(n.body), w)
        Spawn(n) => {
            match n.body {
                some(body) => walk(Expr(Block(body)), w)
                none => walk(Expr(Call(n.call)), w)
            }
        }
        Send(n) => {
            walk(Expr(n.chan), w)
            walk(Expr(n.value), w)
        }
        ForIn(n) => {
            walk_pattern(n.pattern, w)
            walk(Expr(n.iter), w)
            walk_expr(n.end, w)
            walk_block(n.body, w)
        }
    }
}

fn walk_children(e: Expr, w: *Visitor) {
    match e {
        Block(n) => {
            for s in n.stmts {
                walk(Stmt(s), w)
            }
            walk_expr(n.tail, w)
        }
        IntLit(n) => {}
        FloatLit(n) => {}
        StrLit(n) => {}
        BoolLit(n) => {}
        Ident(n) => {}
        Subject(n) => {}
        Select(n) => {
            for c in n.cases {
                walk(SelectCase(c), w)
            }
        }
        Selector(n) => walk(Expr(n.x), w)
        StructLit(n) => {
            walk_type_names(n.type_args, w)
            for f in n.fields {
                walk(FieldInit(f), w)
            }
        }
        Ref(n) => walk(Expr(n.x), w)
        Index(n) => {
            walk(Expr(n.x), w)
            walk(Expr(n.index), w)
        }
        Instance(n) => {
            walk(Expr(n.x), w)
            walk_type_names(n.types, w)
            walk_expr(n.fallback, w)
        }
        Closure(n) => {
            walk_params(n.params, w)
            walk_type_name(n.result, w)
            walk_type_name(n.error, w)
            walk_block(n.body, w)
        }
        Slicing(n) => {
            walk(Expr(n.x), w)
            walk_expr(n.lo, w)
            walk_expr(n.hi, w)
        }
        SliceLit(n) => walk_exprs(n.elems, w)
        MapLit(n) => {
            walk_exprs(n.keys, w)
            walk_exprs(n.values, w)
        }
        Interp(n) => {
            for part in n.parts {
                walk(Expr(part.x), w)
            }
        }
        Unary(n) => walk(Expr(n.x), w)
        Binary(n) => walk_binary(n, w)
        Call(n) => {
            walk(Expr(n.callee), w)
            walk_exprs(n.args, w)
        }
        If(n) => walk_if_chain(n, w)
        Match(n) => {
            walk(Expr(n.x), w)
            walk_arms(n.arms, w)
        }
        Try(n) => walk(Expr(n.x), w)
        Catch(n) => {
            walk(Expr(n.x), w)
            walk_arms(n.arms, w)
            match n.map {
                some(map) => walk(Expr(Call(map)), w)
                none => {}
            }
        }
        Or(n) => {
            walk(Expr(n.x), w)
            walk(Expr(n.fallback), w)
        }
        When(n) => {
            walk(Expr(n.x), w)
            walk(Expr(n.cond), w)
        }
        Region(n) => walk_block(n.body, w)
        Receiver(n) => walk(Expr(n.x), w)
    }
}

fn walk_binary(e: *Binary, w: *Visitor) {
    var spine: []*Binary = [e]
    var cur = e
    for {
        match cur.x {
            Binary(next) => {
                if !w.visit(Expr(Binary(next))) {
                    break
                }
                push(mut spine, next)
                cur = next
            }
            _ => {
                walk(Expr(cur.x), w)
                break
            }
        }
    }
    for k in 0..spine.len {
        walk(Expr(spine[spine.len - 1 - k].y), w)
    }
}

fn walk_if_chain(e: *If, w: *Visitor) {
    var cur = e
    for {
        walk(Expr(cur.cond), w)
        walk_block(cur.then, w)
        let otherwise = cur.otherwise ?? return
        match otherwise {
            If(next) => {
                if !w.visit(Expr(otherwise)) {
                    return
                }
                cur = next
            }
            _ => {
                walk(Expr(otherwise), w)
                return
            }
        }
    }
}

fn walk_expr(e: Expr?, w: *Visitor) {
    match e {
        some(x) => walk(Expr(x), w)
        none => {}
    }
}

fn walk_exprs(list: []Expr, w: *Visitor) {
    for e in list {
        walk(Expr(e), w)
    }
}

fn walk_pattern(p: *StructPattern?, w: *Visitor) {
    match p {
        some(pattern) => walk(StructPattern(pattern), w)
        none => {}
    }
}

fn walk_block(b: *Block?, w: *Visitor) {
    match b {
        some(block) => walk(Expr(Block(block)), w)
        none => {}
    }
}

fn walk_arms(arms: []*Arm, w: *Visitor) {
    for a in arms {
        walk(Pattern(a.pattern), w)
        walk(Expr(a.body), w)
    }
}

fn walk_file(f: *File, w: *Visitor) {
    for imp in f.imports {
        walk(Import(imp), w)
    }
    for d in f.structs {
        walk(StructDecl(d), w)
    }
    for d in f.enums {
        walk(EnumDecl(d), w)
    }
    for d in f.consts {
        walk(Const(d), w)
    }
    for func in f.declared_funcs() {
        walk(Func(func), w)
    }
}

fn walk_params(params: []*Param, w: *Visitor) {
    for p in params {
        walk(Param(p), w)
    }
}

fn walk_type_params(params: []*TypeParam, w: *Visitor) {
    for p in params {
        walk(TypeParam(p), w)
    }
}

fn walk_type_name(t: *TypeName?, w: *Visitor) {
    match t {
        some(name) => walk(TypeName(name), w)
        none => {}
    }
}

fn walk_type_names(list: []*TypeName, w: *Visitor) {
    for t in list {
        walk(TypeName(t), w)
    }
}
