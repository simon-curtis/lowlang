pub fn left_spine(e: *Binary) -> []*Binary {
    var spine: []*Binary = [e]
    var cur = e
    for {
        match cur.x {
            Binary(next) => {
                push(mut spine, next)
                cur = next
            }
            _ => break
        }
    }
    spine
}

pub fn else_chain(e: *If) -> []*If {
    var chain: []*If = [e]
    var cur = e
    for {
        let otherwise = cur.otherwise ?? break
        match otherwise {
            If(next) => {
                push(mut chain, next)
                cur = next
            }
            _ => break
        }
    }
    chain
}
