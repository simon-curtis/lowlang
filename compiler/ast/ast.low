import builtin
import diag
import lexer
import types

pub struct File {
    pub path: str = ""
    pub module: str = ""
    pub imports: []*Import = []
    pub externs: []*Extern = []
    pub enums: []*EnumDecl = []
    pub structs: []*StructDecl = []
    pub consts: []*Const = []
    pub funcs: []*Func = []
}

pub struct Const {
    pub name: str
    pub doc: str = ""
    pub exported: bool = false
    pub file: *File? = none
    pub type_name: *TypeName? = none
    pub value: Expr
    pub text: str = ""
    pub folded: Expr? = none
    pub pos: diag.Pos
}

pub fn const_of(e: Expr) -> *Const? {
    match e {
        Ident(n) => n.constant
        Selector(n) => n.constant
        _ => none
    }
}

pub fn literal(e: Expr) -> Expr {
    let k = const_of(e) ?? return e
    k.folded ?? panic("constant {k.name} is not folded")
}

pub struct Extern {
    pub library: str
    pub funcs: []*Func = []
    pub pos: diag.Pos
}

pub struct Defer {
    pub body: Stmt
    pub pos: diag.Pos
}

pub struct Spawn {
    pub call: *Call
    pub body: *Block? = none
    pub pos: diag.Pos
}

pub struct Send {
    pub chan: Expr
    pub value: Expr
    pub pos: diag.Pos
}

pub enum SelectKind {
    RecvCase
    SendCase
    AfterCase
    ElseCase
}

pub struct SelectCase {
    pub kind: SelectKind = RecvCase
    pub chan: Expr? = none
    pub value: Expr? = none
    pub name: str = ""
    pub local: *Local? = none
    pub body: Expr
    pub pos: diag.Pos
}

pub struct Select {
    pub type: *types.Type? = none
    pub cases: []*SelectCase = []
    pub pos: diag.Pos
}

pub struct Import {
    pub alias: str
    pub path: str
    pub pos: diag.Pos
}

pub fn imported(f: *File, alias: str) -> str? {
    for imp in f.imports {
        if imp.alias == alias {
            return imp.path
        }
    }
    none
}

pub struct TypeName {
    pub module: str = ""
    pub name: str = ""
    pub is_pointer: bool = false
    pub is_slice: bool = false
    pub is_optional: bool = false
    pub is_map: bool = false
    pub key: *TypeName? = none
    pub args: []*TypeName = []
    pub is_func: bool = false
    pub is_c_func: bool = false
    pub params: []*TypeName = []
    pub muts: []bool = []
    pub result: *TypeName? = none
    pub error: *TypeName? = none
    pub elem: *TypeName? = none
    pub pos: diag.Pos
}

pub struct TypeParam {
    pub name: str
    pub constraints: []str = []
    pub pos: diag.Pos
}

pub struct EnumDecl {
    pub name: str
    pub doc: str = ""
    pub type_params: []*TypeParam = []
    pub exported: bool = false
    pub file: *File? = none
    pub variants: []*VariantDecl = []
    pub pos: diag.Pos
    pub type: *types.Type? = none
}

pub struct VariantDecl {
    pub name: str
    pub doc: str = ""
    pub fields: []*TypeName = []
    pub labels: []str = []
    pub index: *IntLit? = none
    pub pos: diag.Pos
}

pub struct StructDecl {
    pub name: str
    pub doc: str = ""
    pub on_drop: Stmt? = none
    pub type_params: []*TypeParam = []
    pub c: bool = false
    pub exported: bool = false
    pub file: *File? = none
    pub fields: []*FieldDecl = []
    pub pos: diag.Pos
    pub type: *types.Type? = none
}

pub struct FieldDecl {
    pub name: str
    pub doc: str = ""
    pub exported: bool = false
    pub type_name: *TypeName
    pub default: Expr? = none
    pub pos: diag.Pos
}

pub struct Param {
    pub name: str
    pub mutable: bool = false
    pub type_name: *TypeName? = none
    pub pos: diag.Pos
}

pub struct Func {
    pub name: str = ""
    pub doc: str = ""
    pub type_params: []*TypeParam = []
    pub template: *Func? = none
    pub type_args: []*types.Type = []
    pub exported: bool = false
    pub file: *File? = none
    pub external: *Extern? = none
    pub symbol: str = ""
    pub variadic: bool = false
    pub closure: *Closure? = none
    pub as_value: bool = false
    pub callback: bool = false
    pub params: []*Param = []
    pub result: *TypeName? = none
    pub error: *TypeName? = none
    pub body: *Block? = none
    pub pos: diag.Pos
    pub param_types: []*types.Type = []
    pub ret_type: *types.Type? = none
    pub param_locals: []*Local = []
    pub bound: [str: *types.Type] = [:]
    pub trusted: bool = false
    pub derived: bool = false
}

pub fn declared(f: *Func) -> bool {
    f.template == none && f.closure == none
}

pub fn source(f: *Func) -> *Func {
    f.template ?? f
}

pub fn declared_funcs(f: *File) -> []*Func {
    var out: []*Func = []
    for e in f.externs {
        for func in e.funcs {
            push(mut out, func)
        }
    }
    for func in f.funcs {
        if func.declared() {
            push(mut out, func)
        }
    }
    out
}

pub struct Local {
    pub name: str
    pub type: *types.Type? = none
    pub mutable: bool = false
    pub param: bool = false
    pub ref: bool = false
    pub addressed: bool = false
    pub captured: bool = false
    pub assigned: bool = false
    pub owner: *Func? = none
    pub flag: *Local? = none
}

pub enum Stmt {
    Let(*Let)
    Assign(*Assign)
    ExprStmt(*ExprStmt)
    For(*For)
    Break(*Break)
    Continue(*Continue)
    Return(*Return)
    Fail(*Fail)
    Defer(*Defer)
    Spawn(*Spawn)
    Send(*Send)
    ForIn(*ForIn)
}

pub enum Expr {
    Block(*Block)
    IntLit(*IntLit)
    FloatLit(*FloatLit)
    StrLit(*StrLit)
    BoolLit(*BoolLit)
    Ident(*Ident)
    Selector(*Selector)
    StructLit(*StructLit)
    Ref(*Ref)
    Index(*Index)
    Instance(*Instance)
    Closure(*Closure)
    Slicing(*Slicing)
    SliceLit(*SliceLit)
    Interp(*Interp)
    MapLit(*MapLit)
    Unary(*Unary)
    Binary(*Binary)
    Call(*Call)
    If(*If)
    Match(*Match)
    Select(*Select)
    Subject(*Subject)
    Receiver(*Receiver)
    Try(*Try)
    Catch(*Catch)
    Or(*Or)
    When(*When)
    Region(*Region)
}

pub struct Block {
    pub type: *types.Type? = none
    pub stmts: []Stmt = []
    pub tail: Expr? = none
    pub pos: diag.Pos
}

pub struct Let {
    pub name: str = ""
    pub pattern: *StructPattern? = none
    pub mutable: bool = false
    pub is_using: bool = false
    pub type_name: *TypeName? = none
    pub value: Expr
    pub pos: diag.Pos
    pub local: *Local? = none
    pub release: Stmt? = none
}

pub struct Assign {
    pub target: Expr
    pub op: lexer.Kind
    pub value: Expr
    pub pos: diag.Pos
    pub entry: *Index? = none
    pub release: Stmt? = none
    pub flag: *Local? = none
    pub splat: bool = false
}

pub struct ExprStmt {
    pub x: Expr
}

pub struct For {
    pub label: str = ""
    pub cond: Expr? = none
    pub body: *Block
    pub pos: diag.Pos
}

pub struct Break {
    pub label: str = ""
    pub depth: i64 = 0
    pub pos: diag.Pos
}

pub struct Continue {
    pub label: str = ""
    pub depth: i64 = 0
    pub pos: diag.Pos
}

pub struct Return {
    pub value: Expr? = none
    pub pos: diag.Pos
}

pub struct Fail {
    pub value: Expr
    pub pos: diag.Pos
}

pub struct IntLit {
    pub type: *types.Type? = none
    pub value: i64
    pub char: bool = false
    pub wide: bool = false
    pub pos: diag.Pos
}

pub struct FloatLit {
    pub type: *types.Type? = none
    pub value: f64
    pub pos: diag.Pos
}

pub struct StrLit {
    pub type: *types.Type? = none
    pub value: str
    pub pos: diag.Pos
}

pub struct BoolLit {
    pub type: *types.Type? = none
    pub value: bool
    pub pos: diag.Pos
}

pub struct Ident {
    pub type: *types.Type? = none
    pub name: str
    pub pos: diag.Pos
    pub local: *Local? = none
    pub variant: *types.Variant? = none
    pub null: bool = false
    pub func: *Func? = none
    pub constant: *Const? = none
    pub moved: bool = false
}

pub struct Selector {
    pub type: *types.Type? = none
    pub x: Expr
    pub name: str
    pub pos: diag.Pos
    pub variant: *types.Variant? = none
    pub field: *types.Field? = none
    pub reference: *types.Field? = none
    pub property: builtin.ID = None
    pub func: *Func? = none
    pub constant: *Const? = none
}

pub struct Closure {
    pub type: *types.Type? = none
    pub params: []*Param = []
    pub result: *TypeName? = none
    pub error: *TypeName? = none
    pub body: *Block
    pub inline: bool = false
    pub pos: diag.Pos
    pub func: *Func? = none
    pub captures: []*Local = []
}

pub struct Instance {
    pub type: *types.Type? = none
    pub x: Expr
    pub types: []*TypeName = []
    pub fallback: Expr? = none
    pub pos: diag.Pos
}

pub struct Index {
    pub type: *types.Type? = none
    pub x: Expr
    pub index: Expr
    pub pos: diag.Pos
}

pub struct Slicing {
    pub type: *types.Type? = none
    pub x: Expr
    pub lo: Expr? = none
    pub hi: Expr? = none
    pub pos: diag.Pos
}

pub struct SliceLit {
    pub type: *types.Type? = none
    pub elems: []Expr = []
    pub read_only: bool = false
    pub pos: diag.Pos
}

pub struct MapLit {
    pub type: *types.Type? = none
    pub keys: []Expr = []
    pub values: []Expr = []
    pub read_only: bool = false
    pub pos: diag.Pos
}

pub struct Interp {
    pub type: *types.Type? = none
    pub parts: []*InterpPart = []
    pub pos: diag.Pos
}

pub struct InterpPart {
    pub x: Expr
    pub spec: *Spec? = none
    pub render: *Func? = none
}

pub struct ForIn {
    pub label: str = ""
    pub key: str = ""
    pub value: str = ""
    pub pattern: *StructPattern? = none
    pub key_local: *Local? = none
    pub value_local: *Local? = none
    pub iter: Expr
    pub end: Expr? = none
    pub body: *Block
    pub pos: diag.Pos
}

pub struct Ref {
    pub type: *types.Type? = none
    pub x: Expr
    pub pos: diag.Pos
}

pub struct Receiver {
    pub type: *types.Type? = none
    pub x: Expr
}

pub struct StructLit {
    pub type: *types.Type? = none
    pub module: str = ""
    pub name: str
    pub type_args: []*TypeName = []
    pub fields: []*FieldInit = []
    pub pos: diag.Pos
}

pub enum FieldForm {
    FieldWritten
    FieldShorthand
    FieldImplied
}

pub struct FieldInit {
    pub name: str
    pub value: Expr
    pub pos: diag.Pos
    pub form: FieldForm = FieldWritten
    pub field: *types.Field? = none
}

pub struct Unary {
    pub type: *types.Type? = none
    pub op: lexer.Kind
    pub x: Expr
    pub pos: diag.Pos
}

pub struct Binary {
    pub type: *types.Type? = none
    pub op: lexer.Kind
    pub x: Expr
    pub y: Expr
    pub splat_x: bool = false
    pub splat_y: bool = false
    pub pos: diag.Pos
}

pub struct Call {
    pub type: *types.Type? = none
    pub callee: Expr
    pub args: []Expr = []
    pub pos: diag.Pos
    pub prepended: bool = false
    pub target: *Func? = none
    pub render: *Func? = none
    pub builtin: builtin.ID = None
    pub variant: *types.Variant? = none
    pub embed: str = ""
    pub size: i64 = 0
    pub digest: u64 = 0
    pub dir: *MapLit? = none
}

pub struct If {
    pub type: *types.Type? = none
    pub cond: Expr
    pub then: *Block
    pub otherwise: Expr? = none
    pub pos: diag.Pos
}

pub struct Pattern {
    pub name: str = ""
    pub bindings: []*Binding = []
    pub test: Expr? = none
    pub pos: diag.Pos
    pub variant: *types.Variant? = none
    pub local: *Local? = none
}

pub struct StructPattern {
    pub fields: []*FieldPattern = []
    pub pos: diag.Pos
    pub type: *types.Type? = none
    pub temp: *Local? = none
}

pub struct FieldPattern {
    pub name: str
    pub pos: diag.Pos
    pub shorthand: bool = false
    pub bind: *Binding? = none
    pub nested: *StructPattern? = none
    pub field: *types.Field? = none
    pub source: Expr? = none
}

pub struct Subject {
    pub type: *types.Type? = none
    pub pos: diag.Pos
}

pub struct Binding {
    pub name: str
    pub pos: diag.Pos
    pub local: *Local? = none
}

pub struct Arm {
    pub pattern: *Pattern
    pub body: Expr
}

pub struct Match {
    pub type: *types.Type? = none
    pub x: Expr
    pub arms: []*Arm = []
    pub pos: diag.Pos
}

pub struct Try {
    pub type: *types.Type? = none
    pub x: Expr
    pub pos: diag.Pos
}

pub struct Catch {
    pub type: *types.Type? = none
    pub x: Expr
    pub arms: []*Arm = []
    pub map: *Call? = none
    pub pos: diag.Pos
}

pub struct Or {
    pub type: *types.Type? = none
    pub x: Expr
    pub fallback: Expr
    pub pos: diag.Pos
}

pub struct When {
    pub type: *types.Type? = none
    pub x: Expr
    pub cond: Expr
    pub pos: diag.Pos
}

pub struct Region {
    pub type: *types.Type? = none
    pub body: *Block
    pub copy: *Func? = none
    pub pos: diag.Pos
}

pub fn stmt_position(s: Stmt) -> diag.Pos {
    match s {
        Let(n) => n.pos
        Assign(n) => n.pos
        ExprStmt(n) => position(n.x)
        For(n) => n.pos
        Break(n) => n.pos
        Continue(n) => n.pos
        Return(n) => n.pos
        Fail(n) => n.pos
        Defer(n) => n.pos
        Spawn(n) => n.pos
        Send(n) => n.pos
        ForIn(n) => n.pos
    }
}

pub fn position(e: Expr) -> diag.Pos {
    match e {
        Block(n) => n.pos
        IntLit(n) => n.pos
        FloatLit(n) => n.pos
        StrLit(n) => n.pos
        BoolLit(n) => n.pos
        Ident(n) => n.pos
        Selector(n) => n.pos
        StructLit(n) => n.pos
        Ref(n) => n.pos
        Index(n) => n.pos
        Instance(n) => n.pos
        Closure(n) => n.pos
        Slicing(n) => n.pos
        SliceLit(n) => n.pos
        Interp(n) => n.pos
        MapLit(n) => n.pos
        Unary(n) => n.pos
        Binary(n) => n.pos
        Call(n) => n.pos
        If(n) => n.pos
        Match(n) => n.pos
        Select(n) => n.pos
        Subject(n) => n.pos
        Receiver(n) => position(n.x)
        Try(n) => n.pos
        Catch(n) => n.pos
        Or(n) => n.pos
        When(n) => n.pos
        Region(n) => n.pos
    }
}

pub fn type_of(e: Expr) -> *types.Type? {
    match e {
        Block(n) => n.type
        IntLit(n) => n.type
        FloatLit(n) => n.type
        StrLit(n) => n.type
        BoolLit(n) => n.type
        Ident(n) => n.type
        Selector(n) => n.type
        StructLit(n) => n.type
        Ref(n) => n.type
        Index(n) => n.type
        Instance(n) => n.type
        Closure(n) => n.type
        Slicing(n) => n.type
        SliceLit(n) => n.type
        Interp(n) => n.type
        MapLit(n) => n.type
        Unary(n) => n.type
        Binary(n) => n.type
        Call(n) => n.type
        If(n) => n.type
        Match(n) => n.type
        Select(n) => n.type
        Subject(n) => n.type
        Receiver(n) => n.type
        Try(n) => n.type
        Catch(n) => n.type
        Or(n) => n.type
        When(n) => n.type
        Region(n) => n.type
    }
}

pub fn set_type(e: Expr, t: *types.Type?) {
    match e {
        Block(n) => { n.type = t }
        IntLit(n) => { n.type = t }
        FloatLit(n) => { n.type = t }
        StrLit(n) => { n.type = t }
        BoolLit(n) => { n.type = t }
        Ident(n) => { n.type = t }
        Selector(n) => { n.type = t }
        StructLit(n) => { n.type = t }
        Ref(n) => { n.type = t }
        Index(n) => { n.type = t }
        Instance(n) => { n.type = t }
        Closure(n) => { n.type = t }
        Slicing(n) => { n.type = t }
        SliceLit(n) => { n.type = t }
        Interp(n) => { n.type = t }
        MapLit(n) => { n.type = t }
        Unary(n) => { n.type = t }
        Binary(n) => { n.type = t }
        Call(n) => { n.type = t }
        If(n) => { n.type = t }
        Match(n) => { n.type = t }
        Select(n) => { n.type = t }
        Subject(n) => { n.type = t }
        Receiver(n) => { n.type = t }
        Try(n) => { n.type = t }
        Catch(n) => { n.type = t }
        Or(n) => { n.type = t }
        When(n) => { n.type = t }
        Region(n) => { n.type = t }
    }
}
