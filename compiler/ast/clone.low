pub fn clone_func(f: *Func) -> *Func {
    let c = new(*f)
    c.params = clone_params(f.params)
    c.result = clone_type(f.result)
    c.error = clone_type(f.error)
    c.body = clone_optional_block(f.body)
    c.param_types = []
    c.ret_type = none
    c.param_locals = []
    c
}

pub fn clone_stmt(s: Stmt) -> Stmt {
    match s {
        Let(n) => {
            let c = new(*n)
            c.pattern = clone_struct_pattern(n.pattern)
            c.type_name = clone_type(n.type_name)
            c.value = clone_expr(n.value)
            c.release = clone_optional_stmt(n.release)
            Let(c)
        }
        Assign(n) => {
            let c = new(*n)
            c.target = clone_expr(n.target)
            c.value = clone_expr(n.value)
            match n.entry {
                some(entry) => {
                    c.entry = clone_index(entry)
                }
                none => {}
            }
            c.release = clone_optional_stmt(n.release)
            Assign(c)
        }
        ExprStmt(n) => ExprStmt(new(ExprStmt { x: clone_expr(n.x) }))
        For(n) => {
            let c = new(*n)
            c.cond = clone_optional(n.cond)
            c.body = clone_block(n.body)
            For(c)
        }
        Break(n) => Break(new(*n))
        Continue(n) => Continue(new(*n))
        Return(n) => Return(new(Return { value: clone_optional(n.value), pos: n.pos }))
        Fail(n) => Fail(new(Fail { value: clone_expr(n.value), pos: n.pos }))
        Defer(n) => Defer(new(Defer { body: clone_stmt(n.body), pos: n.pos }))
        Spawn(n) => Spawn(new(Spawn { call: clone_call(n.call), body: clone_optional_block(n.body), pos: n.pos }))
        Send(n) => Send(new(Send { chan: clone_expr(n.chan), value: clone_expr(n.value), pos: n.pos }))
        ForIn(n) => {
            let c = new(*n)
            c.pattern = clone_struct_pattern(n.pattern)
            c.iter = clone_expr(n.iter)
            c.end = clone_optional(n.end)
            c.body = clone_block(n.body)
            ForIn(c)
        }
    }
}

pub fn clone_expr(e: Expr) -> Expr {
    match e {
        Block(n) => Block(clone_block(n))
        IntLit(n) => IntLit(new(*n))
        FloatLit(n) => FloatLit(new(*n))
        StrLit(n) => StrLit(new(*n))
        BoolLit(n) => BoolLit(new(*n))
        Ident(n) => Ident(new(*n))
        Selector(n) => {
            let c = new(*n)
            c.x = clone_expr(n.x)
            Selector(c)
        }
        StructLit(n) => {
            let c = new(*n)
            c.type_args = clone_types(n.type_args)
            c.fields = []
            for f in n.fields {
                let field = new(*f)
                field.value = clone_expr(f.value)
                push(mut c.fields, field)
            }
            StructLit(c)
        }
        Ref(n) => {
            let c = new(*n)
            c.x = clone_expr(n.x)
            Ref(c)
        }
        Index(n) => Index(clone_index(n))
        Instance(n) => {
            let c = new(*n)
            c.x = clone_expr(n.x)
            c.types = clone_types(n.types)
            c.fallback = clone_optional(n.fallback)
            Instance(c)
        }
        Closure(n) => {
            let c = new(*n)
            c.params = clone_params(n.params)
            c.result = clone_type(n.result)
            c.error = clone_type(n.error)
            c.body = clone_block(n.body)
            c.captures = copy_locals(n.captures)
            Closure(c)
        }
        Slicing(n) => {
            let c = new(*n)
            c.x = clone_expr(n.x)
            c.lo = clone_optional(n.lo)
            c.hi = clone_optional(n.hi)
            Slicing(c)
        }
        SliceLit(n) => {
            let c = new(*n)
            c.elems = clone_exprs(n.elems)
            SliceLit(c)
        }
        Interp(n) => {
            let c = new(*n)
            c.parts = []
            for part in n.parts {
                push(mut c.parts, new(InterpPart { x: clone_expr(part.x), spec: clone_spec(part.spec), render: part.render }))
            }
            Interp(c)
        }
        MapLit(n) => {
            let c = new(*n)
            c.keys = clone_exprs(n.keys)
            c.values = clone_exprs(n.values)
            MapLit(c)
        }
        Unary(n) => {
            let c = new(*n)
            c.x = clone_expr(n.x)
            Unary(c)
        }
        Binary(n) => clone_binary(n)
        Call(n) => Call(clone_call(n))
        If(n) => clone_if_chain(n)
        Match(n) => {
            let c = new(*n)
            c.x = clone_expr(n.x)
            c.arms = clone_arms(n.arms)
            Match(c)
        }
        Select(n) => {
            let c = new(*n)
            c.cases = []
            for k in n.cases {
                let case = new(*k)
                case.chan = clone_optional(k.chan)
                case.value = clone_optional(k.value)
                case.body = clone_expr(k.body)
                push(mut c.cases, case)
            }
            Select(c)
        }
        Subject(n) => Subject(new(*n))
        Receiver(n) => Receiver(new(Receiver { type: n.type, x: clone_expr(n.x) }))
        Try(n) => {
            let c = new(*n)
            c.x = clone_expr(n.x)
            Try(c)
        }
        Catch(n) => {
            let c = new(*n)
            c.x = clone_expr(n.x)
            c.arms = clone_arms(n.arms)
            match n.map {
                some(map) => {
                    c.map = clone_call(map)
                }
                none => {}
            }
            Catch(c)
        }
        Or(n) => {
            let c = new(*n)
            c.x = clone_expr(n.x)
            c.fallback = clone_expr(n.fallback)
            Or(c)
        }
        When(n) => {
            let c = new(*n)
            c.x = clone_expr(n.x)
            c.cond = clone_expr(n.cond)
            When(c)
        }
    }
}

fn clone_binary(n: *Binary) -> Expr {
    let spine = left_spine(n)
    var x = clone_expr(spine[spine.len - 1].x)
    var i = spine.len
    for i > 0 {
        i = i - 1
        let c = new(*spine[i])
        c.x = x
        c.y = clone_expr(spine[i].y)
        x = Binary(c)
    }
    x
}

fn clone_if_chain(n: *If) -> Expr {
    let chain = else_chain(n)
    var otherwise = clone_optional(chain[chain.len - 1].otherwise)
    var cloned = n
    var i = chain.len
    for i > 0 {
        i = i - 1
        let c = new(*chain[i])
        c.cond = clone_expr(chain[i].cond)
        c.then = clone_block(chain[i].then)
        c.otherwise = otherwise
        otherwise = If(c)
        cloned = c
    }
    If(cloned)
}

fn clone_optional(e: Expr?) -> Expr? {
    match e {
        some(x) => clone_expr(x)
        none => none
    }
}

fn clone_optional_stmt(s: Stmt?) -> Stmt? {
    match s {
        some(x) => clone_stmt(x)
        none => none
    }
}

fn clone_exprs(list: []Expr) -> []Expr {
    var out: []Expr = []
    for e in list {
        push(mut out, clone_expr(e))
    }
    out
}

fn copy_locals(list: []*Local) -> []*Local {
    var out: []*Local = []
    for l in list {
        push(mut out, l)
    }
    out
}

fn clone_block(b: *Block) -> *Block {
    let c = new(*b)
    c.stmts = []
    for s in b.stmts {
        push(mut c.stmts, clone_stmt(s))
    }
    c.tail = clone_optional(b.tail)
    c
}

fn clone_optional_block(b: *Block?) -> *Block? {
    match b {
        some(block) => clone_block(block)
        none => none
    }
}

fn clone_index(n: *Index) -> *Index {
    let c = new(*n)
    c.x = clone_expr(n.x)
    c.index = clone_expr(n.index)
    c
}

fn clone_call(n: *Call) -> *Call {
    let c = new(*n)
    c.callee = clone_expr(n.callee)
    c.args = clone_exprs(n.args)
    c
}

fn clone_arms(arms: []*Arm) -> []*Arm {
    var out: []*Arm = []
    for a in arms {
        let pattern = new(*a.pattern)
        pattern.bindings = clone_bindings(a.pattern.bindings)
        pattern.test = clone_optional(a.pattern.test)
        push(mut out, new(Arm { pattern, body: clone_expr(a.body) }))
    }
    out
}

fn clone_bindings(list: []*Binding) -> []*Binding {
    var out: []*Binding = []
    for b in list {
        push(mut out, new(*b))
    }
    out
}

fn clone_struct_pattern(p: *StructPattern?) -> *StructPattern? {
    let pattern = p ?? return none
    let c = new(*pattern)
    c.fields = []
    for f in pattern.fields {
        let field = new(*f)
        match f.bind {
            some(bind) => {
                field.bind = new(*bind)
            }
            none => {}
        }
        field.nested = clone_struct_pattern(f.nested)
        field.source = clone_optional(f.source)
        push(mut c.fields, field)
    }
    c
}

fn clone_params(params: []*Param) -> []*Param {
    var out: []*Param = []
    for p in params {
        let c = new(*p)
        c.type_name = clone_type(p.type_name)
        push(mut out, c)
    }
    out
}

fn clone_type(t: *TypeName?) -> *TypeName? {
    let name = t ?? return none
    let c = new(*name)
    c.key = clone_type(name.key)
    c.args = clone_types(name.args)
    c.params = clone_types(name.params)
    c.result = clone_type(name.result)
    c.error = clone_type(name.error)
    c.elem = clone_type(name.elem)
    c
}

fn clone_types(list: []*TypeName) -> []*TypeName {
    var out: []*TypeName = []
    for t in list {
        let c = clone_type(t) ?? continue
        push(mut out, c)
    }
    out
}

fn clone_spec(s: *Spec?) -> *Spec? {
    let spec = s ?? return none
    let c = new(*spec)
    match spec.format {
        some(format) => {
            c.format = new(*format)
        }
        none => {}
    }
    c
}
