import diag
import std/text

pub const decimal_format: u8 = 'd'
pub const hex_format: u8 = 'x'
pub const upper_hex_format: u8 = 'X'
pub const binary_format: u8 = 'b'
pub const fixed_format: u8 = 'f'
pub const scientific_format: u8 = 'e'
pub const grouped_format: u8 = 'n'
pub const picture_format: u8 = 'p'

pub struct Format {
    pub kind: u8 = 0
    pub text: str
    pub pos: diag.Pos
    pub precision: i64 = 0
    pub explicit: bool = false
    pub min_int: i64 = 0
    pub min_frac: i64 = 0
    pub max_frac: i64 = 0
    pub group: bool = false
}

pub struct Spec {
    pub width: i64 = 0
    pub width_pos: diag.Pos = diag.Pos {}
    pub format: *Format? = none
}

pub fn parse_spec(source: str, pos: diag.Pos) -> *Spec ! diag.Error {
    let spec = new(Spec {})
    var format = text.trim_prefix(source, ":")
    var format_pos = pos
    format_pos.col += 1
    if text.starts_with(source, ",") {
        let parts = text.cut(source[1..], ":")
        let width = parts.before
        var width_pos = pos
        width_pos.col += 1 + width.len - text.trim_start(width).len
        let value = parse_width(width) ?? fail At(width_pos, "invalid width {diag.quote(text.trim(width))}")
        spec.width = value
        spec.width_pos = width_pos
        if !parts.found {
            return spec
        }
        format = parts.after
        format_pos = pos
        format_pos.col += 2 + width.len
    }
    let parsed = parse_format(format, format_pos) ?? fail At(format_pos, "invalid format {diag.quote(format)}")
    spec.format = parsed
    spec
}

pub fn integer_only(f: *Format) -> bool {
    f.kind == decimal_format || f.kind == hex_format || f.kind == upper_hex_format || f.kind == binary_format
}

fn parse_width(source: str) -> i64? {
    let trimmed = text.trim(source)
    let digits = text.trim_prefix(trimmed, "-")
    if !text.is_digits(digits) {
        return none
    }
    let width = text.parse_int(trimmed) or return none
    if width == 0 {
        return none
    }
    width
}

fn parse_format(source: str, pos: diag.Pos) -> *Format? {
    if source == "" {
        return none
    }
    let f = new(Format { text: source, pos })
    let letter = source[0]
    var ok = false
    if letter >= 'a' && letter <= 'z' || letter >= 'A' && letter <= 'Z' {
        ok = f.standard(source)
    } else {
        ok = f.picture(source)
    }
    if !ok {
        return none
    }
    f
}

fn standard(f: *Format, source: str) -> bool {
    let kind = source[0]
    let known = kind == decimal_format || kind == hex_format || kind == upper_hex_format || kind == binary_format
    if !known && kind != fixed_format && kind != scientific_format && kind != grouped_format {
        return false
    }
    f.kind = kind
    let rest = source[1..]
    if rest == "" {
        return true
    }
    if !text.is_digits(rest) || rest.len > 4 {
        return false
    }
    let precision = text.parse_int(rest) or return false
    if precision > 99 {
        return false
    }
    f.precision = precision
    f.explicit = true
    true
}

fn only(source: str, allowed: str) -> bool {
    for i in 0..source.len {
        if text.index_byte(allowed, source[i]) < 0 {
            return false
        }
    }
    true
}

fn count_byte(source: str, c: u8) -> i64 {
    var n = 0
    for i in 0..source.len {
        if source[i] == c {
            n += 1
        }
    }
    n
}

fn picture(f: *Format, source: str) -> bool {
    if !only(source, "0#,.") || count_byte(source, '.') > 1 {
        return false
    }
    let parts = text.cut(source, ".")
    if count_byte(source, '0') + count_byte(source, '#') == 0 {
        return false
    }
    f.kind = picture_format
    f.min_int = count_byte(parts.before, '0')
    f.min_frac = count_byte(parts.after, '0')
    f.max_frac = f.min_frac + count_byte(parts.after, '#')
    f.group = grouped(parts.before)
    true
}

fn grouped(whole: str) -> bool {
    var first = -1
    var last = -1
    for i in 0..whole.len {
        if whole[i] == '0' || whole[i] == '#' {
            if first < 0 {
                first = i
            }
            last = i
        }
    }
    if first < 0 {
        return false
    }
    text.index_byte(whole[first..last + 1], ',') >= 0
}
