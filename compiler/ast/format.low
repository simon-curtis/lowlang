import std/builder
import std/text
import types

pub fn type_text(target: *TypeName?) -> str {
    let t = target ?? return ""
    if t.is_optional {
        return "{type_text(t.elem)}?"
    }
    if t.is_pointer {
        return "*{type_text(t.elem)}"
    }
    if t.is_slice {
        return "[]{type_text(t.elem)}"
    }
    if t.is_map {
        return "[{type_text(t.key)}: {type_text(t.elem)}]"
    }
    if t.is_func {
        return t.func_text()
    }
    var name = t.name
    if t.module != "" {
        name = "{t.module}.{t.name}"
    }
    if t.args.len > 0 {
        name = "{name}[{type_names(t.args)}]"
    }
    name
}

fn func_text(t: *TypeName) -> str {
    var params: []str = []
    for i, p in t.params {
        if i < t.muts.len && t.muts[i] {
            push(mut params, "mut {type_text(p)}")
        } else {
            push(mut params, type_text(p))
        }
    }
    let prefix = if t.is_c_func { "extern fn" } else { "fn" }
    "{prefix}({text.join(params, ", ")}){results(t.result, t.error)}"
}

pub fn type_names(list: []*TypeName) -> str {
    text.join(type_texts(list), ", ")
}

fn type_texts(list: []*TypeName) -> []str {
    var texts: []str = []
    for t in list {
        push(mut texts, type_text(t))
    }
    texts
}

pub fn results(result: *TypeName?, error: *TypeName?) -> str {
    var b = builder.builder()
    if result != none {
        b.write(" -> ")
        b.write(type_text(result))
    }
    if error != none {
        b.write(" ! ")
        b.write(type_text(error))
    }
    b.to_str()
}

pub fn type_param_text(p: *TypeParam) -> str {
    if p.constraints.len == 0 {
        return p.name
    }
    "{p.name}: {text.join(p.constraints, " + ")}"
}

pub fn type_params(params: []*TypeParam) -> str {
    if params.len == 0 {
        return ""
    }
    var texts: []str = []
    for p in params {
        push(mut texts, type_param_text(p))
    }
    "[{text.join(texts, ", ")}]"
}

pub fn variant_text(v: *VariantDecl) -> str {
    var head = v.name
    if v.fields.len > 0 {
        head = "{v.name}({type_names(v.fields)})"
    }
    let index = v.index ?? return head
    "{head} = {index.value}"
}

pub fn param_text(p: *Param) -> str {
    if p.mutable {
        return "mut {p.name}: {type_text(p.type_name)}"
    }
    "{p.name}: {type_text(p.type_name)}"
}

pub struct SignatureParts {
    pub head: str
    pub params: []str
    pub tail: str
}

pub fn func_text_of(f: *Func) -> str {
    let parts = f.parts(false)
    "{parts.head}{text.join(parts.params, ", ")}{parts.tail}"
}

pub fn signature(f: *Func) -> str {
    let parts = f.signature_parts()
    "{parts.head}{text.join(parts.params, ", ")}{parts.tail}"
}

pub fn signature_parts(f: *Func) -> SignatureParts {
    f.source().parts(true)
}

fn parts(f: *Func, resolved: bool) -> SignatureParts {
    var params: []str = []
    for i, p in f.params {
        if resolved && i < f.param_types.len {
            push(mut params, "{p.name}: {types.param_text(f.param_types[i], p.mutable)}")
        } else {
            push(mut params, param_text(p))
        }
    }
    if f.variadic {
        push(mut params, "...")
    }
    var b = builder.builder()
    if f.external != none {
        b.write("extern ")
    }
    b.write("fn {f.name}{type_params(f.type_params)}(")
    var tail = results(f.result, f.error)
    if resolved {
        match f.ret_type {
            some(ret) => {
                tail = types.return_text(ret)
            }
            none => {}
        }
    }
    SignatureParts { head: b.to_str(), params, tail: "){tail}" }
}

pub fn const_text(k: *Const) -> str {
    let t = k.const_type_text()
    if t != "" {
        return "const {k.name}: {t} = {k.text}"
    }
    "const {k.name} = {k.text}"
}

fn const_type_text(k: *Const) -> str {
    match k.folded {
        some(folded) => types.text(types.must(type_of(folded)))
        none => type_text(k.type_name)
    }
}

pub fn struct_text(d: *StructDecl) -> str {
    d.render_struct(false)
}

pub fn struct_interface(d: *StructDecl) -> str {
    d.render_struct(true)
}

fn render_struct(d: *StructDecl, public: bool) -> str {
    var b = builder.builder()
    if d.c {
        b.write("extern ")
    }
    if public {
        b.write("pub ")
    }
    b.write("struct {d.name}{type_params(d.type_params)} {{\n")
    var hidden = false
    for f in d.fields {
        if public && !f.exported {
            hidden = true
        } else if public {
            write_doc(mut b, f.doc)
            b.write("    pub {f.name}: {type_text(f.type_name)}\n")
        } else {
            b.write("    {f.name}: {type_text(f.type_name)}\n")
        }
    }
    if hidden {
        b.write("    ...\n")
    }
    b.write("}}")
    b.to_str()
}

pub fn enum_text(d: *EnumDecl) -> str {
    d.render_enum(false)
}

pub fn enum_interface(d: *EnumDecl) -> str {
    d.render_enum(true)
}

fn render_enum(d: *EnumDecl, public: bool) -> str {
    var b = builder.builder()
    if public {
        b.write("pub ")
    }
    b.write("enum {d.name}{type_params(d.type_params)} {{\n")
    for v in d.variants {
        if public {
            write_doc(mut b, v.doc)
        }
        b.write("    {variant_text(v)}\n")
    }
    b.write("}}")
    b.to_str()
}

fn write_doc(mut b: builder.Builder, doc: str) {
    if doc == "" {
        return
    }
    var lines = text.split(doc, '\n')
    if lines[lines.len - 1] == "" {
        lines = lines[..lines.len - 1]
    }
    for line in lines {
        var written = "    /// {line}"
        for written.len > 0 && written[written.len - 1] == ' ' {
            written = written[..written.len - 1]
        }
        b.write(written)
        b.write("\n")
    }
}

pub fn variant_params(v: *VariantDecl) -> []str {
    type_texts(v.fields)
}
