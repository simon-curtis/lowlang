import std/semver
import std/text

pub struct Range {
    pub written: str
    low: semver.Version
    high: semver.Version? = none
    exact: bool = false
}

struct Partial {
    parts: []i64
}

pub fn parse_range(written: str) -> Range? {
    let s = text.trim(written)
    if text.starts_with(s, "=") {
        let v = semver.parse(s[1..]) or return none
        return Range { written, low: v, exact: true }
    }
    if text.starts_with(s, "~") {
        let p = partial(s[1..]) ?? return none
        return Range { written, low: p.lowest(), high: p.tilde_bound() }
    }
    var rest = s
    if text.starts_with(s, "^") {
        rest = s[1..]
    }
    let p = partial(rest) ?? return none
    Range { written, low: p.lowest(), high: p.caret_bound() }
}

fn partial(s: str) -> Partial? {
    let pieces = text.split(s, '.')
    if pieces.len == 0 || pieces.len > 3 {
        return none
    }
    var parts: []i64 = []
    for piece in pieces {
        let n = text.parse_int(piece) or return none
        if n < 0 || piece.len == 0 {
            return none
        }
        parts.push(n)
    }
    Partial { parts }
}

fn part(p: Partial, i: i64) -> i64 {
    if i < p.parts.len {
        return p.parts[i]
    }
    0
}

fn lowest(p: Partial) -> semver.Version {
    semver.Version { major: p.part(0), minor: p.part(1), patch: p.part(2) }
}

fn caret_bound(p: Partial) -> semver.Version {
    let major = p.part(0)
    let minor = p.part(1)
    if major > 0 || p.parts.len == 1 {
        return semver.Version { major: major + 1, minor: 0, patch: 0 }
    }
    if minor > 0 || p.parts.len == 2 {
        return semver.Version { major: 0, minor: minor + 1, patch: 0 }
    }
    semver.Version { major: 0, minor: 0, patch: p.part(2) + 1 }
}

fn tilde_bound(p: Partial) -> semver.Version {
    if p.parts.len == 1 {
        return semver.Version { major: p.part(0) + 1, minor: 0, patch: 0 }
    }
    semver.Version { major: p.part(0), minor: p.part(1) + 1, patch: 0 }
}

pub fn accepts(r: Range, v: semver.Version) -> bool {
    if r.exact {
        return semver.compare(v, r.low) == 0
    }
    if v.pre.len > 0 {
        return false
    }
    let high = r.high ?? return false
    semver.compare(v, r.low) >= 0 && semver.compare(v, high) < 0
}
