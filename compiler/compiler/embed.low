import ast
import check
import std/hash
import std/path
import std/slices
import std/text

pub struct Embedder {
    std: *Std
    docs: *Overlay
    loader: *Loader
    paths: []str = []
    data: [str: []u8] = [:]
    digests: [str: u64] = [:]
    sizes: [str: i64] = [:]
    disk_bytes: i64 = 0
    ahead: [str: Ahead] = [:]
}

struct Wanted {
    file: *ast.File
    name: str
}

/// Reads the files that each loaded file outside `std/` names in an `embed` call, on the job runner, so the checker finds them read.
pub fn read_named_ahead(e: *Embedder, files: []*ast.File) {
    var wanted: []Wanted = []
    for f in files {
        if is_std(f.module) {
            continue
        }
        for name in e.loader.embeds[f.path] ?? [] {
            wanted.push(Wanted { file: f, name })
        }
    }
    e.loader.embeds = [:]
    var found: []Ahead = []
    for _ in wanted {
        found.push(Ahead { abs: "" })
    }
    let docs = e.docs
    let each = docs.jobs.each
    each(wanted.len, fn(i: i64) {
        let w = wanted[i]
        if confined_tree(e, w.file) != "" {
            return
        }
        let abs = absolute_path(docs, wanted_name(e, w.file, w.name)) or return
        let data = read(docs, abs) or return
        found[i] = Ahead { abs, data, digest: hash.wyhash(data, 0) }
    })
    for i, w in wanted {
        if found[i].abs != "" {
            e.ahead[request_key(w.file, w.name)] = found[i]
        }
    }
}

struct Ahead {
    abs: str
    data: []u8? = none
    digest: u64 = 0
}

pub fn resolve(e: *Embedder, f: *ast.File, name: str) -> check.Embedded ! check.EmbedError {
    if is_std(f.module) {
        return std_file(e, f, name)?
    }
    disk_file(e, f, name)?
}

fn disk_file(e: *Embedder, f: *ast.File, name: str) -> check.Embedded ! check.EmbedError {
    let request = request_key(f, name)
    let ahead = e.ahead[request] ?? Ahead { abs: disk_target(e, f, wanted_name(e, f, name))? }
    e.ahead.delete(request)
    let abs = ahead.abs
    let data = ahead.data ?? read(e.docs, abs)?
    var digest = ahead.digest
    if ahead.data == none {
        digest = hash.wyhash(data, 0)
    }
    if e.data[abs] == none && e.digests[abs] == none {
        e.paths.push(abs)
    }
    if e.docs.overlay_holds(abs) {
        return hold(e, abs, data)
    }
    if e.digests[abs] == none {
        e.disk_bytes += data.len
    }
    e.digests[abs] = digest
    e.sizes[abs] = data.len
    check.Embedded { path: abs, data, digest }
}

fn request_key(f: *ast.File, name: str) -> str {
    "{f.path}\0{name}"
}

fn wanted_name(e: *Embedder, f: *ast.File, name: str) -> str {
    if e.docs.disk.rooted(name) {
        return name
    }
    path.join([path.dir(f.path), name])
}

fn confined_tree(e: *Embedder, f: *ast.File) -> str {
    let owner = e.loader.owners[f.module] ?? return ""
    owner.confined
}

fn disk_target(e: *Embedder, f: *ast.File, wanted: str) -> str ! check.EmbedError {
    let abs = absolute_path(e.docs, wanted) catch {
        err => fail check.EmbedError.Failed(message(err))
    }
    let tree = confined_tree(e, f)
    if tree == "" {
        return abs
    }
    keep_inside(e.docs, tree, abs)?
    abs
}

fn keep_inside(docs: *Overlay, tree: str, abs: str) ! check.EmbedError {
    let root = absolute_path(docs, tree) catch {
        err => fail check.EmbedError.Failed(message(err))
    }
    if !inside(docs, root, abs) {
        fail check.EmbedError.Failed("{abs} is outside the dependency tree {root}")
    }
    let real = docs.disk.real
    let real_root = real(root) catch {
        err => fail check.EmbedError.Failed("resolve {root}: {reason(err)}")
    }
    let real_abs = real(abs) catch {
        NotFound => return
        err => fail check.EmbedError.Failed("resolve {abs}: {reason(err)}")
    }
    if !inside(docs, real_root, real_abs) {
        fail check.EmbedError.Failed("{abs} resolves to {real_abs}, outside the dependency tree {real_root}")
    }
}

fn inside(docs: *Overlay, root: str, name: str) -> bool {
    let keyed = path_key(docs.disk.drives, name)
    let keyed_root = path_key(docs.disk.drives, root)
    within(keyed, keyed_root) != none
}

fn std_file(e: *Embedder, f: *ast.File, name: str) -> check.Embedded ! check.EmbedError {
    let key = path.join([path.dir(f.path), name])
    let contents = std_file_data(e.std, key) ?? fail check.EmbedError.Missing
    hold(e, key, bytes(contents))
}

pub fn list(e: *Embedder, f: *ast.File, name: str) -> []str ! check.EmbedError {
    if is_std(f.module) {
        let key = path.join([path.dir(f.path), name])
        return list_std_files(e.std, key)?
    }
    let wanted = wanted_name(e, f, name)
    let abs = disk_target(e, f, wanted)?
    let names = list_files(e.docs, abs)?
    if confined_tree(e, f) == "" {
        read_ahead(e, f, name, abs, names)
    }
    names
}

fn read_ahead(e: *Embedder, f: *ast.File, name: str, dir: str, names: []str) {
    var found: []Ahead = []
    var keys: []str = []
    for name in names {
        found.push(Ahead { abs: "" })
        keys.push("")
    }
    let docs = e.docs
    let each = docs.jobs.each
    each(names.len, fn(i: i64) {
        keys[i] = request_key(f, path.join([name, names[i]]))
        let abs = path.join([dir, names[i]])
        found[i] = Ahead { abs }
        let data = read(docs, abs) or return
        found[i] = Ahead { abs, data, digest: hash.wyhash(data, 0) }
    })
    for i, key in keys {
        e.ahead[key] = found[i]
    }
}

fn list_std_files(s: *Std, root: str) -> []str ! check.EmbedError {
    var inside = ""
    if root != "std" {
        inside = text.strip_prefix(root, "std/") ?? fail check.EmbedError.Missing
    }
    if !has_dir(s.dirs, root) {
        if s.files[inside] != none {
            fail check.EmbedError.Failed("not a directory")
        }
        fail check.EmbedError.Missing
    }
    var prefix = ""
    if inside != "" {
        prefix = "{inside}/"
    }
    var names: []str = []
    for name in s.files {
        if text.starts_with(name, prefix) {
            names.push(name[prefix.len..])
        }
    }
    slices.sort(mut names)
    names
}

fn list_files(docs: *Overlay, root: str) -> []str ! check.EmbedError {
    let info = overlay_stat(docs, root) catch {
        NotFound => fail check.EmbedError.Missing
        err => fail check.EmbedError.Failed("stat {root}: {reason(err)}")
    }
    if !info.dir {
        fail check.EmbedError.Failed("not a directory")
    }
    overlay_files(docs, root) catch {
        err => fail check.EmbedError.Failed("open {root}: {reason(err)}")
    }
}

fn read(docs: *Overlay, name: str) -> []u8 ! check.EmbedError {
    overlay_read_bytes(docs, name) catch {
        NotFound => fail check.EmbedError.Missing
        IsDir => fail check.EmbedError.Failed("read {name}: is a directory")
        err => fail check.EmbedError.Failed("open {name}: {reason(err)}")
    }
}

/// Returns the bytes of every embedded file, reading each file outside `std/` again.
pub fn embedded(e: *Embedder) -> [str: []u8] ! Error {
    var all: [str: []u8] = [:]
    for name, data in e.data {
        all[name] = data
    }
    for name, digest in e.digests {
        let data = read(e.docs, name) catch {
            Missing => fail Error.Failed("embedded file {name} was removed during the build")
            Failed(msg) => fail Error.Failed(msg)
        }
        if hash.wyhash(data, 0) != digest {
            fail Error.Failed("embedded file {name} changed during the build")
        }
        all[name] = data
    }
    all
}

fn hold(e: *Embedder, key: str, data: []u8) -> check.Embedded {
    e.data[key] = data
    check.Embedded { path: key, data, digest: hash.wyhash(data, 0) }
}
