import ast
import check
import std/path
import std/slices
import std/text

pub struct Embedder {
    std: *Std
    docs: *Overlay
    paths: []str = []
    data: [str: []u8] = [:]
}

pub fn resolve(e: *Embedder, f: *ast.File, name: str) -> check.Embedded ! check.EmbedError {
    if is_std(f.module) {
        return std_file(e, f, name)?
    }
    disk_file(e, f, name)?
}

fn disk_file(e: *Embedder, f: *ast.File, name: str) -> check.Embedded ! check.EmbedError {
    var target_name = name
    if !rooted(name) {
        target_name = path.join([path.dir(f.path), name])
    }
    let abs = absolute_path(target_name) catch {
        err => fail check.EmbedError.Failed(message(err))
    }
    let data = read(e.docs, abs)?
    var known = false
    for p in e.paths {
        if p == abs {
            known = true
        }
    }
    if !known {
        push(mut e.paths, abs)
    }
    hold(e, abs, data)
}

fn std_file(e: *Embedder, f: *ast.File, name: str) -> check.Embedded ! check.EmbedError {
    let key = path.join([path.dir(f.path), name])
    let contents = std_file_data(e.std, key) ?? fail check.EmbedError.Missing
    hold(e, key, bytes(contents))
}

pub fn list(e: *Embedder, f: *ast.File, name: str) -> []str ! check.EmbedError {
    if is_std(f.module) {
        let key = path.join([path.dir(f.path), name])
        return list_std_files(e.std, key)?
    }
    var target_name = name
    if !rooted(name) {
        target_name = path.join([path.dir(f.path), name])
    }
    let abs = absolute_path(target_name) catch {
        err => fail check.EmbedError.Failed(message(err))
    }
    list_files(e.docs, abs)?
}

fn list_std_files(s: *Std, root: str) -> []str ! check.EmbedError {
    var inside = ""
    if root != "std" {
        inside = text.strip_prefix(root, "std/") ?? fail check.EmbedError.Missing
    }
    if !has_dir(s.dirs, root) {
        if s.files[inside] != none {
            fail check.EmbedError.Failed("not a directory")
        }
        fail check.EmbedError.Missing
    }
    var prefix = ""
    if inside != "" {
        prefix = "{inside}/"
    }
    var names: []str = []
    for name in s.files {
        if text.starts_with(name, prefix) {
            push(mut names, name[prefix.len..])
        }
    }
    slices.sort(mut names)
    names
}

fn list_files(docs: *Overlay, root: str) -> []str ! check.EmbedError {
    let info = overlay_stat(docs, root) catch {
        NotFound => fail check.EmbedError.Missing
        err => fail check.EmbedError.Failed("stat {root}: {reason(err)}")
    }
    if !info.dir {
        fail check.EmbedError.Failed("not a directory")
    }
    overlay_files(docs, root) catch {
        err => fail check.EmbedError.Failed("open {root}: {reason(err)}")
    }
}

fn read(docs: *Overlay, name: str) -> []u8 ! check.EmbedError {
    overlay_read_bytes(docs, name) catch {
        NotFound => fail check.EmbedError.Missing
        IsDir => fail check.EmbedError.Failed("read {name}: is a directory")
        err => fail check.EmbedError.Failed("open {name}: {reason(err)}")
    }
}

fn hold(e: *Embedder, key: str, data: []u8) -> check.Embedded {
    e.data[key] = data
    check.Embedded { path: key, data }
}
