import amd64
import asm
import ir
import link
import target
import std/file
import std/io

pub struct Built {
    pub funcs: [str: str]
    pub symbols: [str: i64]
    pub table: *amd64.FuncTable?
}

struct Toolchain {
    assembler: asm.Options
    linker: fn(asm.Object, []str) -> link.Image ! Error
}

fn toolchain(platform: target.OS) -> Toolchain {
    match platform {
        Linux => Toolchain { assembler: asm.Options { align_branches: true }, linker: link_elf }
        Windows => Toolchain { assembler: asm.Options { clang_layout: true }, linker: link_pe }
    }
}

pub fn assembler(platform: target.OS) -> asm.Options {
    toolchain(platform).assembler
}

pub fn unit_assembler(u: *Unit) -> asm.Options {
    var options = assembler(amd64.platform_os(u.platform))
    options.embeds = u.embeds
    options
}

pub fn generate(unit: *Unit) -> amd64.Output ! Error {
    let table = new_table(unit)
    generate_with(unit, table)?
}

pub fn generate_with(unit: *Unit, table: *amd64.FuncTable?) -> amd64.Output ! Error {
    let program = unit.program ?? panic("unit without a program")
    amd64.generate(program, unit.platform, table) catch Backend
}

pub fn build(unit: *Unit, output: str) -> Built ! Error {
    let table = new_table(unit)
    let out = generate_with(unit, table)?
    let options = unit_assembler(unit)
    let object = asm.assemble(out.asm, options) catch Assemble
    let program = unit.program ?? panic("unit without a program")
    let libraries = ir.libraries(program)
    let chain = toolchain(amd64.platform_os(unit.platform))
    let linker = chain.linker
    let image = linker(object, libraries)?
    write_executable(output, image.bytes)?
    Built { funcs: out.funcs, symbols: image.symbols, table }
}

pub fn patch(b: Built, unit: *Unit, table: *amd64.FuncTable, changed: []str, suffix: str, base: i64) -> link.PatchImage ! Error {
    let program = unit.program ?? panic("unit without a program")
    let source = amd64.generate_patch(program, unit.platform, changed, table, suffix)
    let options = unit_assembler(unit)
    let object = asm.assemble(source, options) catch Assemble
    link.patch(object, base, b.symbols) catch Link
}

fn link_elf(object: asm.Object, libraries: []str) -> link.Image ! Error {
    if libraries.len == 0 {
        return link.static(object) catch Link
    }
    let resolver = link.Resolver { dirs: link.system_dirs() }
    let resolved = link.resolve(resolver, libraries) catch Link
    link.dynamic(object, resolved) catch Link
}

fn link_pe(object: asm.Object, libraries: []str) -> link.Image ! Error {
    let bytes = link.pe(object) catch Link
    link.Image { bytes }
}

fn write_executable(output: str, image: []u8) ! Error {
    remove_existing(output) catch {
        e => fail Error.Failed("replace {output}: remove {output}: {reason(e)}")
    }
    file.write_file_mode(output, image, 0o755) catch {
        e => fail Error.Failed("write {output}: open {output}: {reason(e)}")
    }
}

fn remove_existing(output: str) ! io.Error {
    file.remove(output) catch {
        NotFound => return
        IsDir => {
            file.remove_dir(output) catch {
                NotFound => return
                e => fail e
            }
        }
        e => fail e
    }
}
