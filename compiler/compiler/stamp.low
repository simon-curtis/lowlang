import diag

const stamp_file = "std/buildinfo/buildinfo.low"

pub struct Stamp {
    pub revision: str
    pub time: i64
}

pub fn unstamped(root: str) -> Stamp {
    Stamp { revision: "", time: 0 }
}

fn stamped_source(d: Disk, root: str) -> str {
    let stamp_of = d.stamp
    let s = stamp_of(root)
    let revision = diag.quote(s.revision)
    "pub const revision = {revision}\npub const time: i64 = {s.time}\n"
}
