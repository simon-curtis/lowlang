import ir
import target

pub struct Profile {
    pub platform: target.OS = target.OS.Linux
    pub optimise: bool = false
    pub hot: bool = false
}

pub fn release(platform: target.OS) -> Profile {
    Profile { platform, optimise: true }
}

pub fn dev() -> Profile {
    Profile { hot: true }
}

pub fn analyse(path: str, profile: Profile, docs: *Overlay, runner: ir.Runner) -> *Unit ! Error {
    let unit = check(path, profile.platform, docs)?
    lower(unit, profile, runner)
    unit
}

pub fn lower(u: *Unit, profile: Profile, runner: ir.Runner) {
    u.profile = profile
    u.program = ir.build(u.universe, u.files, profile.optimise, runner)
}
