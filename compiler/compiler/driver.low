import ir
import target

pub struct Profile {
    pub platform: target.OS = target.OS.Linux
    pub optimise: bool = false
    pub hot: bool = false
    pub gui: bool = false
}

pub fn release(platform: target.OS) -> Profile {
    Profile { platform, optimise: true }
}

pub fn dev(platform: target.OS) -> Profile {
    Profile { platform, hot: true }
}

pub fn analyse(path: str, profile: Profile, docs: *Overlay, runner: ir.Runner) -> *Unit ! Error {
    let unit = check(path, profile.platform, docs)?
    lower(unit, profile, runner)
    unit
}

pub fn analyse_tests(module_path: str, profile: Profile, docs: *Overlay, runner: ir.Runner) -> *Unit ! Error {
    let unit = check_tests(module_path, profile.platform, docs)?
    lower(unit, profile, runner)
    unit
}

pub fn lower(u: *Unit, profile: Profile, runner: ir.Runner) {
    let program = lower_flat(u, profile, runner)
    ir.materialise(program, runner)
}

pub fn lower_flat(u: *Unit, profile: Profile, runner: ir.Runner) -> *ir.Program {
    u.profile = profile
    let program = ir.build(u.universe, u.files, profile.optimise, runner)
    u.program = program
    program
}
