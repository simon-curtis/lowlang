import amd64
import asm
import ir
import target

pub struct Profile {
    pub platform: target.OS = target.OS.Linux
    pub optimise: bool = false
    pub hot: bool = false
}

pub fn release(platform: target.OS) -> Profile {
    Profile { platform, optimise: true }
}

pub fn dev() -> Profile {
    Profile { hot: true }
}

pub fn analyse(path: str, profile: Profile) -> *Unit ! Error {
    let unit = check(path, profile.platform)?
    lower(unit, profile)
    unit
}

fn lower(u: *Unit, profile: Profile) {
    u.profile = profile
    u.platform = amd64.new_platform(profile.platform)
    u.program = ir.build(u.universe, u.files, profile.optimise)
}

fn new_table(u: *Unit) -> *amd64.FuncTable? {
    if !u.profile.hot {
        return none
    }
    let program = u.program ?? panic("unit without a program")
    amd64.new_func_table(program)
}

pub fn assembler(platform: target.OS) -> asm.Options {
    if platform == target.OS.Windows {
        return asm.Options { clang_layout: true }
    }
    asm.Options { align_branches: true }
}

pub fn unit_assembler(u: *Unit) -> asm.Options {
    var options = assembler(amd64.platform_os(u.platform))
    options.embeds = u.embeds
    options
}

pub fn generate(unit: *Unit) -> amd64.Output ! Error {
    let table = new_table(unit)
    generate_with(unit, table)?
}

pub fn generate_with(unit: *Unit, table: *amd64.FuncTable?) -> amd64.Output ! Error {
    let program = unit.program ?? panic("unit without a program")
    amd64.generate(program, unit.platform, table) catch Backend
}
