import ast
import diag
import std/path
import std/text

struct Project {
    prefix: str
    dir: str
    modules: str
    confined: str = ""
    deps: []*Project = []
}

struct Placed {
    name: str
    dir: str
}

fn main_project(l: *Loader) ! Error {
    let main = new(Project { prefix: "", dir: l.root, modules: modules_dir(l.root, l.manifest) })
    l.main = main
    l.attach(main, l.manifest)?
}

fn attach(l: *Loader, p: *Project, manifest: *Manifest?) ! Error {
    let m = manifest ?? return
    unmarked_modules(l.docs, p.dir, m)?
    for d in m.deps {
        let dep = l.dependency(p, d)?
        p.deps.push(dep)
    }
}

fn dependency(l: *Loader, from: *Project, d: Dependency) -> *Project ! Error {
    if !d.local {
        let dir = l.cached_dependency(d)?
        return l.project_at(d, d.source, dir, dir)?
    }
    let dir = local_dir(from.dir, d.source)
    let info = overlay_stat(l.docs, dir) catch {
        _ => fail Error.Diag(diag.Error.At(d.pos, "dependency", "{d.source}: no such directory"))
    }
    if !info.dir {
        fail Error.Diag(diag.Error.At(d.pos, "dependency", "{d.source}: not a directory"))
    }
    l.project_at(d, path.base(dir), dir, from.confined)?
}

fn cached_dependency(l: *Loader, d: Dependency) -> str ! Error {
    if !l.lock_read {
        l.lock = read_lock(l.docs, l.root)?
        l.lock_read = true
    }
    let held = l.lock[d.source] ?? fail not_fetched(d)
    if l.docs.disk.cache == "" {
        fail not_fetched(d)
    }
    let dir = cached_dir(l.docs.disk.cache, d.source, held.commit)
    if !overlay_exists(l.docs, dir) {
        fail not_fetched(d)
    }
    dir
}

fn not_fetched(d: Dependency) -> Error {
    Error.Diag(diag.Error.At(d.pos, "dependency", "{d.source} is not fetched; low build, low run and low test fetch it"))
}

fn project_at(l: *Loader, d: Dependency, prefix: str, dir: str, confined: str) -> *Project ! Error {
    match l.projects[prefix] {
        some(known) => {
            if known.dir != dir {
                fail Error.Diag(diag.Error.At(d.pos, "dependency", "dependency {prefix} is both {known.dir} and {dir}"))
            }
            return known
        }
        none => {}
    }
    let manifest = project_manifest(l.docs, dir)?
    let p = new(Project { prefix, dir, modules: modules_dir(dir, manifest), confined })
    l.projects[prefix] = p
    l.attach(p, manifest)?
    p
}

fn project_of(l: *Loader, module_name: str) -> *Project {
    l.owners[module_name] ?? l.main ?? panic("a loader without a main project")
}

fn place(l: *Loader, from: *Project, imp: *ast.Import) -> Placed ! Error {
    if is_std(imp.path) {
        return Placed { name: imp.path, dir: imp.path }
    }
    let own = path.join([from.modules, imp.path])
    for dep in from.deps {
        let rest = within(imp.path, dep.prefix) ?? continue
        if overlay_exists(l.docs, own) {
            fail Error.Diag(diag.Error.At(imp.pos, "dependency", "{imp.path} is both a module of this project and of the dependency {dep.prefix}"))
        }
        return l.owned(dep, imp.path, path.join([dep.modules, rest]))
    }
    var name = imp.path
    if from.prefix != "" {
        name = "{from.prefix}/{imp.path}"
    }
    l.owned(from, name, own)
}

fn in_main(l: *Loader, module_name: str) -> bool {
    match l.owners[module_name] {
        some(p) => p.prefix == ""
        none => true
    }
}

fn owned(l: *Loader, p: *Project, name: str, dir: str) -> Placed {
    l.owners[name] = p
    l.dirs[name] = dir
    Placed { name, dir }
}

fn within(import_path: str, prefix: str) -> str? {
    if import_path == prefix {
        return ""
    }
    text.strip_prefix(import_path, "{prefix}/")
}
