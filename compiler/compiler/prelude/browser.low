extern "wasm" {
    fn __wasm_stack_pointer() -> i64 = "stack_pointer"
    fn __wasm_stack_top() -> i64 = "stack_top"
    fn __wasm_cells_start() -> i64 = "cells_start"
    fn __wasm_cells_end() -> i64 = "cells_end"
    fn __wasm_heap_start() -> i64 = "heap_start"
    fn __wasm_memory_end() -> i64 = "memory_end"
    fn __wasm_memory_grow(pages: i64) -> i64 = "memory_grow"
    fn __wasm_fill(at: i64, byte: i64, n: i64) = "fill"
    fn __wasm_copy(to: i64, from: i64, n: i64) = "copy"
    fn __wasm_stress_words() -> i64 = "stress_words"
}

const __rt_page_shift = 16
const __rt_page_bytes = 65536
const __rt_page_mask = 65535
const __rt_meta_pages = 9
const __rt_table = 4096
const __rt_class_count = 18
const __rt_small_limit = 16384
const __rt_collect_floor = 4194304
const __rt_max_words = 268435456
const __rt_max_grow_bytes = 2147483648
const __rt_pin_capacity = 65536
const __rt_pin_pages = 8
const __rt_mark_page_entries = 8192
const __rt_poison = 165
const __rt_stress_shift = 6
const __rt_low_word = 4294967295

const __rt_at_init = 0
const __rt_at_pages = 8
const __rt_at_since = 16
const __rt_at_live = 24
const __rt_at_hint = 32
const __rt_at_pin_count = 40
const __rt_at_pin_table = 48
const __rt_at_stress = 56
const __rt_at_stress_words = 64
const __rt_at_hold = 72
const __rt_at_context = 80
const __rt_at_mark_base = 88
const __rt_at_mark_top = 96
const __rt_at_mark_cap = 104
const __rt_at_mark_pages = 112
const __rt_at_classes = 512
const __rt_at_lists = 1024

const __rt_kind_small = 1
const __rt_kind_head = 2
const __rt_kind_tail = 3
const __rt_kind_meta = 4
const __rt_scan_bit = 16
const __rt_live_bit = 32
const __rt_mark_bit = 64

fn __rt_get(at: i64) -> i64 {
    let p: ptr[i64] = ptr(at)
    load(p)
}

fn __rt_set(at: i64, v: i64) {
    let p: ptr[i64] = ptr(at)
    store(p, v)
}

fn __rt_get32(at: i64) -> i64 {
    let p: ptr[u32] = ptr(at)
    i64(load(p))
}

fn __rt_set32(at: i64, v: i64) {
    let p: ptr[u32] = ptr(at)
    store(p, u32(v))
}

fn __rt_entry(heap: i64, page: i64) -> i64 {
    __rt_get(heap + __rt_table + page * 8)
}

fn __rt_set_entry(heap: i64, page: i64, e: i64) {
    __rt_set(heap + __rt_table + page * 8, e)
}

fn __rt_run_length(e: i64) -> i64 {
    (e >> 16) & __rt_low_word
}

fn __rt_page_base(heap: i64, page: i64) -> i64 {
    heap + (page << __rt_page_shift)
}

fn __rt_class_bytes(class: i64) -> i64 {
    match class {
        0 => 16
        1 => 32
        2 => 48
        3 => 64
        4 => 96
        5 => 128
        6 => 192
        7 => 256
        8 => 384
        9 => 512
        10 => 768
        11 => 1024
        12 => 1536
        13 => 2048
        14 => 3072
        15 => 4096
        16 => 8192
        _ => 16384
    }
}

fn __rt_class_of(bytes: i64) -> i64 {
    if bytes <= 64 {
        return (bytes + 15) / 16 - 1
    }
    if bytes <= 128 {
        return if bytes <= 96 { 4 } else { 5 }
    }
    if bytes <= 256 {
        return if bytes <= 192 { 6 } else { 7 }
    }
    if bytes <= 512 {
        return if bytes <= 384 { 8 } else { 9 }
    }
    if bytes <= 1024 {
        return if bytes <= 768 { 10 } else { 11 }
    }
    if bytes <= 2048 {
        return if bytes <= 1536 { 12 } else { 13 }
    }
    if bytes <= 4096 {
        return if bytes <= 3072 { 14 } else { 15 }
    }
    if bytes <= 8192 {
        return 16
    }
    17
}

fn __rt_slot_size(heap: i64, class: i64) -> i64 {
    __rt_get(heap + __rt_at_classes + class * 24)
}

fn __rt_slot_header(heap: i64, class: i64) -> i64 {
    __rt_get(heap + __rt_at_classes + class * 24 + 8)
}

fn __rt_slot_count(heap: i64, class: i64) -> i64 {
    __rt_get(heap + __rt_at_classes + class * 24 + 16)
}

fn __rt_list_at(heap: i64, class: i64, scan: i64) -> i64 {
    heap + __rt_at_lists + (class * 2 + scan) * 8
}

fn __rt_describe_class(heap: i64, class: i64) {
    let size = __rt_class_bytes(class)
    let bitmap = ((__rt_page_bytes / size + 63) / 64) * 8
    let header = 2 * bitmap
    let at = heap + __rt_at_classes + class * 24
    __rt_set(at, size)
    __rt_set(at + 8, header)
    __rt_set(at + 16, (__rt_page_bytes - header) / size)
}

fn __rt_init(heap: i64) {
    if __rt_get(heap + __rt_at_init) != 0 {
        return
    }
    __rt_set(heap + __rt_at_init, 1)
    __rt_set(heap + __rt_at_pages, (__wasm_memory_end() - heap) >> __rt_page_shift)
    __rt_set(heap + __rt_at_hint, __rt_meta_pages)
    __rt_set(heap + __rt_at_stress_words, __wasm_stress_words())
    for page in 0..__rt_meta_pages {
        __rt_set_entry(heap, page, __rt_kind_meta)
    }
    for class in 0..__rt_class_count {
        __rt_describe_class(heap, class)
    }
}

fn __rt_note_free(heap: i64, page: i64) {
    if page < __rt_get(heap + __rt_at_hint) {
        __rt_set(heap + __rt_at_hint, page)
    }
}

fn __rt_release(heap: i64, page: i64, count: i64) {
    for k in 0..count {
        __rt_set_entry(heap, page + k, 0)
    }
    __rt_note_free(heap, page)
}

fn __rt_claim(heap: i64, first: i64, start: i64, count: i64) -> i64 {
    var hint = first
    if start == first {
        hint = start + count
    }
    __rt_set(heap + __rt_at_hint, hint)
    start
}

fn __rt_pages(heap: i64, count: i64) -> i64 {
    let pages = __rt_get(heap + __rt_at_pages)
    var page = __rt_get(heap + __rt_at_hint)
    var start = page
    var run = 0
    var first = -1
    for page < pages {
        let e = __rt_entry(heap, page)
        if e != 0 {
            run = 0
            if e & 15 == __rt_kind_head {
                page += __rt_run_length(e)
            } else {
                page += 1
            }
            continue
        }
        if first < 0 {
            first = page
        }
        if run == 0 {
            start = page
        }
        run += 1
        if run == count {
            return __rt_claim(heap, first, start, count)
        }
        page += 1
    }
    if run == 0 {
        start = pages
    }
    if first < 0 {
        first = start
    }
    if __wasm_memory_grow(count - run) < 0 {
        return -1
    }
    __rt_set(heap + __rt_at_pages, pages + count - run)
    __rt_claim(heap, first, start, count)
}

fn __rt_refill(heap: i64, class: i64, scan: i64) -> bool {
    let page = __rt_pages(heap, 1)
    if page < 0 {
        return false
    }
    let base = __rt_page_base(heap, page)
    let header = __rt_slot_header(heap, class)
    let size = __rt_slot_size(heap, class)
    let list = __rt_list_at(heap, class, scan)
    __rt_set_entry(heap, page, __rt_kind_small | (scan << 4) | (class << 8))
    __wasm_fill(base, 0, header)
    var head = __rt_get(list)
    var index = __rt_slot_count(heap, class) - 1
    for index >= 0 {
        let object = base + header + index * size
        __rt_set(object, head)
        head = object
        index -= 1
    }
    __rt_set(list, head)
    true
}

fn __rt_take_small(heap: i64, bytes: i64, scan: i64) -> i64 {
    let class = __rt_class_of(bytes)
    let list = __rt_list_at(heap, class, scan)
    if __rt_get(list) == 0 && !__rt_refill(heap, class, scan) {
        return 0
    }
    let object = __rt_get(list)
    __rt_set(list, __rt_get(object))
    let base = object - ((object - heap) & __rt_page_mask)
    let header = __rt_slot_header(heap, class)
    let size = __rt_slot_size(heap, class)
    let index = (object - base - header) / size
    let at = base + (index >> 6) * 8
    __rt_set(at, __rt_get(at) | (1 << (index & 63)))
    __wasm_fill(object, 0, size)
    __rt_set(heap + __rt_at_since, __rt_get(heap + __rt_at_since) + size)
    object
}

fn __rt_take_large(heap: i64, bytes: i64, scan: i64) -> i64 {
    let count = (bytes + __rt_page_mask) >> __rt_page_shift
    let page = __rt_pages(heap, count)
    if page < 0 {
        return 0
    }
    __rt_set_entry(heap, page, __rt_kind_head | (scan << 4) | __rt_live_bit | (count << 16))
    for k in 1..count {
        __rt_set_entry(heap, page + k, __rt_kind_tail | (page << 16))
    }
    let base = __rt_page_base(heap, page)
    let size = count << __rt_page_shift
    __wasm_fill(base, 0, size)
    __rt_set(heap + __rt_at_since, __rt_get(heap + __rt_at_since) + size)
    base
}

fn __rt_take(heap: i64, bytes: i64, scan: i64) -> i64 {
    if bytes <= __rt_small_limit {
        return __rt_take_small(heap, bytes, scan)
    }
    __rt_take_large(heap, bytes, scan)
}

fn __rt_pace(heap: i64, words: i64) {
    let stress = __rt_get(heap + __rt_at_stress_words)
    if stress > 0 {
        let since = __rt_get(heap + __rt_at_stress) + words
        var interval = stress
        let proportional = __rt_get(heap + __rt_at_live) >> __rt_stress_shift
        if proportional > interval {
            interval = proportional
        }
        if since >= interval {
            __rt_collect()
            return
        }
        __rt_set(heap + __rt_at_stress, since)
        return
    }
    var limit = __rt_get(heap + __rt_at_live)
    if limit < __rt_collect_floor {
        limit = __rt_collect_floor
    }
    if __rt_get(heap + __rt_at_since) > limit {
        __rt_collect()
    }
}

fn __rt_alloc(words: i64, scan: i64) -> i64 {
    if words > __rt_max_words || words < 0 {
        panic("out of memory")
    }
    var count = words
    if count == 0 {
        count = 1
    }
    let heap = __wasm_heap_start()
    __rt_init(heap)
    __rt_pace(heap, count)
    var object = __rt_take(heap, count * 8, scan)
    if object == 0 {
        __rt_collect()
        object = __rt_take(heap, count * 8, scan)
        if object == 0 {
            panic("out of memory")
        }
    }
    object
}

fn __rt_grow(old: i64, used: i64, size: i64, scan: i64) -> i64 {
    if size > __rt_max_grow_bytes || size < 0 {
        panic("out of memory")
    }
    let heap = __wasm_heap_start()
    __rt_set(heap + __rt_at_hold, old)
    let fresh = __rt_alloc((size + 7) >> 3, scan)
    __rt_set(heap + __rt_at_hold, 0)
    if used > 0 {
        __wasm_copy(fresh, old, used)
    }
    fresh
}

fn __rt_widen_marks(heap: i64) {
    let old_pages = __rt_get(heap + __rt_at_mark_pages)
    let old_base = __rt_get(heap + __rt_at_mark_base)
    let top = __rt_get(heap + __rt_at_mark_top)
    let pages = old_pages * 2
    let page = __rt_pages(heap, pages)
    if page < 0 {
        panic("out of memory")
    }
    for k in 0..pages {
        __rt_set_entry(heap, page + k, __rt_kind_meta)
    }
    let base = __rt_page_base(heap, page)
    __wasm_copy(base, old_base, top * 8)
    __rt_release(heap, (old_base - heap) >> __rt_page_shift, old_pages)
    __rt_set(heap + __rt_at_mark_base, base)
    __rt_set(heap + __rt_at_mark_cap, pages * __rt_mark_page_entries)
    __rt_set(heap + __rt_at_mark_pages, pages)
}

fn __rt_push(heap: i64, object: i64) {
    let top = __rt_get(heap + __rt_at_mark_top)
    if top == __rt_get(heap + __rt_at_mark_cap) {
        __rt_widen_marks(heap)
    }
    __rt_set(__rt_get(heap + __rt_at_mark_base) + top * 8, object)
    __rt_set(heap + __rt_at_mark_top, top + 1)
}

fn __rt_begin_marks(heap: i64) {
    let page = __rt_pages(heap, 1)
    if page < 0 {
        panic("out of memory")
    }
    __rt_set_entry(heap, page, __rt_kind_meta)
    __rt_set(heap + __rt_at_mark_base, __rt_page_base(heap, page))
    __rt_set(heap + __rt_at_mark_top, 0)
    __rt_set(heap + __rt_at_mark_cap, __rt_mark_page_entries)
    __rt_set(heap + __rt_at_mark_pages, 1)
}

fn __rt_end_marks(heap: i64) {
    let base = __rt_get(heap + __rt_at_mark_base)
    __rt_release(heap, (base - heap) >> __rt_page_shift, __rt_get(heap + __rt_at_mark_pages))
}

fn __rt_mark_small(heap: i64, w: i64, page: i64, e: i64) {
    let class = (e >> 8) & 255
    let base = __rt_page_base(heap, page)
    let header = __rt_slot_header(heap, class)
    let offset = w - base
    if offset < header {
        return
    }
    let size = __rt_slot_size(heap, class)
    let index = (offset - header) / size
    if index >= __rt_slot_count(heap, class) {
        return
    }
    let word = (index >> 6) * 8
    let bit = 1 << (index & 63)
    if __rt_get(base + word) & bit == 0 {
        return
    }
    let marks = base + (header >> 1) + word
    let held = __rt_get(marks)
    if held & bit != 0 {
        return
    }
    __rt_set(marks, held | bit)
    if e & __rt_scan_bit != 0 {
        __rt_push(heap, base + header + index * size)
    }
}

fn __rt_mark_large(heap: i64, head: i64, e: i64) {
    if e & __rt_live_bit == 0 || e & __rt_mark_bit != 0 {
        return
    }
    __rt_set_entry(heap, head, e | __rt_mark_bit)
    if e & __rt_scan_bit != 0 {
        __rt_push(heap, __rt_page_base(heap, head))
    }
}

fn __rt_mark_word(heap: i64, w: i64) {
    if w < heap + __rt_meta_pages * __rt_page_bytes {
        return
    }
    if w >= heap + (__rt_get(heap + __rt_at_pages) << __rt_page_shift) {
        return
    }
    let page = (w - heap) >> __rt_page_shift
    let e = __rt_entry(heap, page)
    let kind = e & 15
    if kind == __rt_kind_small {
        __rt_mark_small(heap, w, page, e)
    } else if kind == __rt_kind_head {
        __rt_mark_large(heap, page, e)
    } else if kind == __rt_kind_tail {
        let head = __rt_run_length(e)
        __rt_mark_large(heap, head, __rt_entry(heap, head))
    }
}

fn __rt_scan_range(heap: i64, from: i64, to: i64) {
    var at = from
    for at < to {
        __rt_mark_word(heap, __rt_get(at))
        at += 8
    }
}

fn __rt_scan_object(heap: i64, object: i64) {
    let page = (object - heap) >> __rt_page_shift
    let e = __rt_entry(heap, page)
    var size = __rt_run_length(e) << __rt_page_shift
    if e & 15 == __rt_kind_small {
        size = __rt_slot_size(heap, (e >> 8) & 255)
    }
    __rt_scan_range(heap, object, object + size)
}

fn __rt_drain(heap: i64) {
    for __rt_get(heap + __rt_at_mark_top) > 0 {
        let top = __rt_get(heap + __rt_at_mark_top) - 1
        __rt_set(heap + __rt_at_mark_top, top)
        __rt_scan_object(heap, __rt_get(__rt_get(heap + __rt_at_mark_base) + top * 8))
    }
}

fn __rt_mark_roots(heap: i64) {
    __rt_scan_range(heap, __wasm_stack_pointer(), __wasm_stack_top())
    __rt_scan_range(heap, __wasm_cells_start(), __wasm_cells_end())
    let table = __rt_get(heap + __rt_at_pin_table)
    if table != 0 {
        __rt_scan_range(heap, table, table + __rt_get(heap + __rt_at_pin_count) * 8)
    }
    __rt_mark_word(heap, __rt_get(heap + __rt_at_hold))
    __rt_mark_word(heap, __rt_get(heap + __rt_at_context))
}

fn __rt_population(bits: i64) -> i64 {
    var count = 0
    var rest = bits
    for rest != 0 {
        rest = rest & (rest - 1)
        count += 1
    }
    count
}

fn __rt_sweep_small(heap: i64, page: i64, e: i64) {
    let class = (e >> 8) & 255
    let scan = (e >> 4) & 1
    let base = __rt_page_base(heap, page)
    let header = __rt_slot_header(heap, class)
    let size = __rt_slot_size(heap, class)
    let count = __rt_slot_count(heap, class)
    let marks = base + (header >> 1)
    let bitmap_words = (count + 63) >> 6
    var survivors = 0
    for word in 0..bitmap_words {
        let held = __rt_get(marks + word * 8)
        __rt_set(base + word * 8, held)
        __rt_set(marks + word * 8, 0)
        survivors += __rt_population(held)
    }
    let stress = __rt_get(heap + __rt_at_stress_words) > 0
    if survivors == 0 {
        if stress {
            __wasm_fill(base + header, __rt_poison, count * size)
        }
        __rt_release(heap, page, 1)
        return
    }
    let live = heap + __rt_at_live
    __rt_set(live, __rt_get(live) + survivors * size)
    let list = __rt_list_at(heap, class, scan)
    var head = __rt_get(list)
    var index = count - 1
    for index >= 0 {
        if __rt_get(base + (index >> 6) * 8) & (1 << (index & 63)) == 0 {
            let object = base + header + index * size
            if stress {
                __wasm_fill(object + 8, __rt_poison, size - 8)
            }
            __rt_set(object, head)
            head = object
        }
        index -= 1
    }
    __rt_set(list, head)
}

fn __rt_sweep_large(heap: i64, head: i64) {
    let e = __rt_entry(heap, head)
    let count = __rt_run_length(e)
    if e & __rt_mark_bit != 0 {
        __rt_set_entry(heap, head, e - __rt_mark_bit)
        let live = heap + __rt_at_live
        __rt_set(live, __rt_get(live) + (count << __rt_page_shift))
        return
    }
    if __rt_get(heap + __rt_at_stress_words) > 0 {
        __wasm_fill(__rt_page_base(heap, head), __rt_poison, count << __rt_page_shift)
    }
    __rt_release(heap, head, count)
}

fn __rt_sweep(heap: i64) {
    let pages = __rt_get(heap + __rt_at_pages)
    let lists = __rt_class_count * 2
    for list in 0..lists {
        __rt_set(heap + __rt_at_lists + list * 8, 0)
    }
    __rt_set(heap + __rt_at_live, 0)
    __rt_set(heap + __rt_at_hint, pages)
    var page = pages - 1
    for page >= __rt_meta_pages {
        let e = __rt_entry(heap, page)
        let kind = e & 15
        if kind == __rt_kind_small {
            __rt_sweep_small(heap, page, e)
        } else if kind == __rt_kind_head {
            __rt_sweep_large(heap, page)
        } else if kind == __rt_kind_tail {
            page = __rt_run_length(e)
            __rt_sweep_large(heap, page)
        } else if kind == 0 {
            __rt_note_free(heap, page)
        }
        page -= 1
    }
}

fn __rt_collect() {
    let heap = __wasm_heap_start()
    __rt_init(heap)
    __rt_begin_marks(heap)
    __rt_mark_roots(heap)
    __rt_drain(heap)
    __rt_sweep(heap)
    __rt_end_marks(heap)
    __rt_set(heap + __rt_at_since, 0)
    __rt_set(heap + __rt_at_stress, 0)
}

fn __rt_pin_table(heap: i64) -> i64 {
    var table = __rt_get(heap + __rt_at_pin_table)
    if table != 0 {
        return table
    }
    let page = __rt_pages(heap, __rt_pin_pages)
    if page < 0 {
        panic("out of memory")
    }
    for k in 0..__rt_pin_pages {
        __rt_set_entry(heap, page + k, __rt_kind_meta)
    }
    table = __rt_page_base(heap, page)
    __rt_set(heap + __rt_at_pin_table, table)
    table
}

fn __rt_pin(w: i64) {
    let heap = __wasm_heap_start()
    __rt_init(heap)
    let table = __rt_pin_table(heap)
    let count = __rt_get(heap + __rt_at_pin_count)
    if count >= __rt_pin_capacity {
        panic("too many pins")
    }
    __rt_set(table + count * 8, w)
    __rt_set(heap + __rt_at_pin_count, count + 1)
}

fn __rt_unpin(w: i64) {
    let heap = __wasm_heap_start()
    let table = __rt_get(heap + __rt_at_pin_table)
    var at = __rt_get(heap + __rt_at_pin_count)
    for at > 0 {
        at -= 1
        if __rt_get(table + at * 8) == w {
            let last = __rt_get(heap + __rt_at_pin_count) - 1
            __rt_set(table + at * 8, __rt_get(table + last * 8))
            __rt_set(heap + __rt_at_pin_count, last)
            return
        }
    }
}

fn __rt_lock(at: i64) {
    if __rt_get32(at) != 0 {
        panic("every green thread is blocked forever")
    }
    __rt_set32(at, 1)
}

fn __rt_unlock(at: i64) {
    __rt_set32(at, 0)
}

fn __rt_cas(at: i64, old: i64, next: i64) -> i64 {
    if __rt_get(at) != old {
        return 0
    }
    __rt_set(at, next)
    1
}

fn __rt_context() -> i64 {
    __rt_get(__wasm_heap_start() + __rt_at_context)
}

fn __rt_set_context(w: i64) {
    __rt_set(__wasm_heap_start() + __rt_at_context, w)
}

fn __rt_has_context() -> i64 {
    if __rt_context() != 0 {
        return 1
    }
    0
}

fn __rt_lock_thread() {
}

fn __rt_unlock_thread() {
}

fn __rt_listed_before(locks: i64, index: i64) -> bool {
    let target = __rt_get(locks + index * 8)
    for earlier in 0..index {
        if __rt_get(locks + earlier * 8) == target {
            return true
        }
    }
    false
}

fn __rt_lock_all(locks: i64, n: i64) {
    for index in 0..n {
        if !__rt_listed_before(locks, index) {
            __rt_lock(__rt_get(locks + index * 8))
        }
    }
}

fn __rt_unlock_all(locks: i64, n: i64) {
    for index in 0..n {
        __rt_unlock(__rt_get(locks + index * 8))
    }
}
