import ast
import diag
import parser
import target
import std/io
import std/path
import std/slices
import std/text

const module_file = "low.mod"
const examples_dir = "examples"

pub enum Error {
    Diag(diag.Error)
    Prelude(msg: str)
    Failed(msg: str)
}

pub fn message(e: Error) -> str {
    match e {
        Diag(inner) => diag.message(inner)
        Prelude(msg) => msg
        Failed(msg) => msg
    }
}

pub struct Std {
    files: [str: str]
    dirs: [str: []Entry]
}

pub fn new_std() -> *Std {
    let files = embed_dir("../../std")
    let dirs: [str: []Entry] = ["std": []]
    for name in files {
        index_std_file(dirs, name)
    }
    for dir in dirs {
        var entries = dirs[dir] ?? []
        slices.sort_by(mut entries, fn(a: Entry, b: Entry) -> bool { a.name < b.name })
        dirs[dir] = entries
    }
    new(Std { files, dirs })
}

fn index_std_file(dirs: [str: []Entry], name: str) {
    var dir = "std"
    let parts = text.split(name, '/')
    for i, part in parts {
        let child = "{dir}/{part}"
        if i == parts.len - 1 {
            add_std_entry(dirs, dir, Entry { name: part, dir: false, link: false, regular: true })
        } else if !has_dir(dirs, child) {
            add_std_entry(dirs, dir, Entry { name: part, dir: true, link: false, regular: false })
            dirs[child] = []
        }
        dir = child
    }
}

fn has_dir(dirs: [str: []Entry], name: str) -> bool {
    match dirs[name] {
        some(_) => true
        none => false
    }
}

fn add_std_entry(dirs: [str: []Entry], dir: str, entry: Entry) {
    var held = dirs[dir] ?? []
    push(mut held, entry)
    dirs[dir] = held
}

fn std_file_data(s: *Std, key: str) -> str? {
    let inside = text.strip_prefix(key, "std/") ?? return none
    s.files[inside]
}

fn is_std(module: str) -> bool {
    module == "std" || text.starts_with(module, "std/")
}

pub fn reason(e: io.Error) -> str {
    match e {
        NotFound => "no such file or directory"
        Denied => "permission denied"
        NotDir => "not a directory"
        IsDir => "is a directory"
        Exists => "file exists"
        NotEmpty => "directory not empty"
        Invalid => "invalid argument"
        Os(code) => "errno {code}"
        _ => "input/output error"
    }
}

fn failed(op: str, name: str, e: io.Error) -> Error {
    Error.Failed("{op} {name}: {reason(e)}")
}

struct Tree {
    privileged: bool
    std: *Std
    docs: *Overlay
}

struct Listing {
    files: []str
    absent: bool
}

struct Directory {
    entries: []Entry
    absent: bool
}

fn read_dir(t: Tree, dir: str) -> Directory ! Error {
    if t.privileged {
        let found = t.std.dirs[dir] ?? return Directory { entries: [], absent: true }
        return Directory { entries: found, absent: false }
    }
    let found = overlay_read_dir(t.docs, dir) catch {
        NotFound => return Directory { entries: [], absent: true }
        NotDir => fail Error.Failed("readdirent {dir}: not a directory")
        e => fail failed("open", dir, e)
    }
    Directory { entries: found, absent: false }
}

fn sources(t: Tree, dir: str, platform: target.OS) -> Listing ! Error {
    let entries = read_dir(t, dir)?
    var sorted = entries.entries
    slices.sort_by(mut sorted, fn(a: Entry, b: Entry) -> bool { a.name < b.name })
    var files: []str = []
    for entry in sorted {
        if builds(entry, platform) {
            push(mut files, path.join([dir, entry.name]))
        }
    }
    Listing { files, absent: entries.absent }
}

fn builds(entry: Entry, platform: target.OS) -> bool {
    !entry.dir && text.ends_with(entry.name, ".low") && target.builds(platform, entry.name)
}

fn parse(t: Tree, name: str) -> *ast.File ! Error {
    let src = read_source(t, name)?
    let f = parse_source(src, name, t.privileged)?
    f.path = name
    f
}

pub fn parse_file(docs: *Overlay, name: str) -> *ast.File ! Error {
    let src = read_disk(docs, name)?
    let f = parse_source(src, name, false)?
    f.path = name
    f
}

fn read_source(t: Tree, name: str) -> str ! Error {
    if t.privileged {
        return std_file_data(t.std, name) ?? fail Error.Failed("open {name}: no such file or directory")
    }
    read_disk(t.docs, name)?
}

fn read_disk(docs: *Overlay, name: str) -> str ! Error {
    overlay_read(docs, name) catch {
        e => fail failed("open", name, e)
    }
}

pub fn parse_source(src: str, name: str, privileged: bool) -> *ast.File ! Error {
    parser.parse_source(src, diag.start(name), privileged) catch Diag
}

pub fn root(docs: *Overlay, dir: str) -> str? {
    let getcwd = docs.disk.cwd
    let cwd = getcwd() or return none
    var d = absolute(cwd, dir)
    for true {
        if overlay_exists(docs, path.join([d, module_file])) {
            return d
        }
        let parent = path.dir(d)
        if parent == d {
            return none
        }
        d = parent
    }
    none
}

fn absolute(cwd: str, name: str) -> str {
    if path.is_absolute(name) {
        return path.clean(name)
    }
    if has_drive(name) {
        return name
    }
    path.join([cwd, name])
}

fn rooted(name: str) -> bool {
    path.is_absolute(name) || has_drive(name)
}

fn has_drive(name: str) -> bool {
    target.host() == target.OS.Windows && name.len >= 3 && name[1] == ':' && (name[2] == '/' || name[2] == '\\')
}

pub fn absolute_path(docs: *Overlay, name: str) -> str ! Error {
    let getcwd = docs.disk.cwd
    let cwd = getcwd() catch {
        e => fail failed("getwd", "", e)
    }
    absolute(cwd, name)
}

struct Edge {
    from: str
    to: str
    pos: diag.Pos
}

pub struct Loader {
    root: str = ""
    platform: target.OS
    std: *Std
    docs: *Overlay
    files: []*ast.File = []
    sources: []str = []
    edges: [str: []Edge] = [:]
    parents: [str: str] = [:]
    pending: []Edge = []
    loaded: [str: bool] = [:]
}

pub fn load_modules(entry_path: str, platform: target.OS, std: *Std, docs: *Overlay) -> *Loader ! Error {
    let l = new(Loader { platform, std, docs })
    let disk = Tree { privileged: false, std, docs }
    let info = overlay_stat(docs, entry_path) catch {
        e => fail failed("stat", entry_path, e)
    }
    var dir = path.dir(entry_path)
    var entry: []str = [entry_path]
    if info.dir {
        dir = entry_path
        let listing = sources(disk, entry_path, platform)?
        entry = listing.files
        if entry.len == 0 {
            fail Error.Failed("{entry_path}: no .low files")
        }
    }
    l.root = dir
    match root(docs, dir) {
        some(found) => {
            l.root = found
        }
        none => {}
    }
    module(l, "", entry)?
    var head = 0
    for head < l.pending.len {
        let next = l.pending[head]
        head += 1
        imported(l, next)?
    }
    cycles(l)?
    l
}

pub fn module_names(l: *Loader) -> []str {
    var names: []str = []
    for name in l.loaded {
        if name != "" {
            push(mut names, name)
        }
    }
    slices.sort(mut names)
    names
}

pub fn user_files(l: *Loader) -> []*ast.File {
    var out: []*ast.File = []
    for f in l.files {
        if !is_std(f.module) {
            push(mut out, f)
        }
    }
    out
}

fn tree_of(l: *Loader, module_name: str) -> Tree {
    Tree { privileged: is_std(module_name), std: l.std, docs: l.docs }
}

fn imported(l: *Loader, e: Edge) ! Error {
    if l.loaded[e.to] != none {
        return
    }
    for part in text.split(e.to, '/') {
        if part == examples_dir {
            fail Error.Diag(diag.Error.At(e.pos, "cannot import {e.to}: an examples directory holds programs, not modules"))
        }
    }
    if !target.has_os(l.platform) && e.to == "std/sys" {
        let chain = import_chain(l, e)
        fail Error.Diag(diag.Error.At(e.pos, "{target.string(l.platform)} has no operating system, so std/sys cannot be imported: {chain}"))
    }
    l.parents[e.to] = e.from
    let source = tree_of(l, e.to)
    var dir = e.to
    var place = "the standard library"
    if !source.privileged {
        dir = path.join([l.root, e.to])
        place = dir
    }
    let listing = sources(source, dir, l.platform)?
    if listing.absent || listing.files.len == 0 {
        fail Error.Diag(diag.Error.At(e.pos, "cannot find module {e.to} in {place}"))
    }
    module(l, e.to, listing.files)?
}

fn import_chain(l: *Loader, e: Edge) -> str {
    var names: []str = [display(e.to)]
    var at = e.from
    for true {
        push(mut names, display(at))
        match l.parents[at] {
            some(parent) => {
                at = parent
            }
            none => break
        }
    }
    var reversed: []str = []
    var i = names.len - 1
    for i >= 0 {
        push(mut reversed, names[i])
        i -= 1
    }
    text.join(reversed, " -> ")
}

fn check_externs(l: *Loader, f: *ast.File, privileged: bool) ! Error {
    if target.has_os(l.platform) {
        return
    }
    for x in f.externs {
        if x.library == "m" || ((x.library == "low" || x.library == "wasm") && privileged) {
            continue
        }
        fail Error.Diag(diag.Error.At(x.pos, "{target.string(l.platform)} has no library {diag.quote(x.library)}; a browser program can declare only extern {diag.quote("m")}"))
    }
}

fn module(l: *Loader, name: str, files: []str) ! Error {
    l.loaded[name] = true
    l.edges[name] = []
    let source = tree_of(l, name)
    for file_name in files {
        let f = parse(source, file_name)?
        f.module = name
        check_externs(l, f, source.privileged)?
        push(mut l.files, f)
        if !source.privileged {
            push(mut l.sources, file_name)
        }
        link_imports(l, f)?
    }
}

fn link_imports(l: *Loader, f: *ast.File) ! Error {
    var seen: [str: bool] = [:]
    for imp in f.imports {
        if seen[imp.alias] != none {
            fail Error.Diag(diag.Error.At(imp.pos, "module name {imp.alias} imported twice"))
        }
        seen[imp.alias] = true
        let e = Edge { from: f.module, to: imp.path, pos: imp.pos }
        var held = l.edges[f.module] ?? []
        push(mut held, e)
        l.edges[f.module] = held
        push(mut l.pending, e)
    }
}

struct Cycles {
    state: [str: i64] = [:]
    stack: []str = []
}

fn cycles(l: *Loader) ! Error {
    let c = new(Cycles {})
    visit(l, c, "")?
}

fn visit(l: *Loader, c: *Cycles, module_name: str) ! Error {
    c.state[module_name] = 1
    push(mut c.stack, module_name)
    for e in l.edges[module_name] ?? [] {
        let state = c.state[e.to] ?? 0
        if state == 1 {
            var cycle: []str = []
            var at = 0
            for i, m in c.stack {
                if m == e.to {
                    at = i
                    break
                }
            }
            for i in at..c.stack.len {
                push(mut cycle, display(c.stack[i]))
            }
            push(mut cycle, display(e.to))
            fail Error.Diag(diag.Error.At(e.pos, "import cycle: {text.join(cycle, " -> ")}"))
        }
        if state == 0 {
            visit(l, c, e.to)?
        }
    }
    c.stack = c.stack[0..c.stack.len - 1]
    c.state[module_name] = 2
}

fn display(module_name: str) -> str {
    if module_name == "" {
        return "main"
    }
    module_name
}
