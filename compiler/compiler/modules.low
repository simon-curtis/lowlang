import ast
import diag
import parser
import target
import std/io
import std/path
import std/slices
import std/text

const module_file = "low.mod"
const examples_dir = "examples"

pub enum Error {
    Diag(diag.Error)
    Prelude(msg: str)
    Failed(msg: str)
}

pub fn message(e: Error) -> str {
    match e {
        Diag(inner) => diag.message(inner)
        Prelude(msg) => msg
        Failed(msg) => msg
    }
}

pub struct Std {
    files: [str: str]
    dirs: [str: []Entry]
}

pub fn new_std() -> *Std {
    let files = embed_dir("../../std")
    let dirs: [str: []Entry] = ["std": []]
    for name in files {
        index_std_file(dirs, name)
    }
    for dir in dirs {
        var entries = dirs[dir] ?? []
        slices.sort_by(mut entries, fn(a: Entry, b: Entry) -> bool { a.name < b.name })
        dirs[dir] = entries
    }
    new(Std { files, dirs })
}

fn index_std_file(dirs: [str: []Entry], name: str) {
    var dir = "std"
    let parts = text.split(name, '/')
    for i, part in parts {
        let child = "{dir}/{part}"
        if i == parts.len - 1 {
            add_std_entry(dirs, dir, Entry { name: part, dir: false, link: false, regular: true })
        } else if !has_dir(dirs, child) {
            add_std_entry(dirs, dir, Entry { name: part, dir: true, link: false, regular: false })
            dirs[child] = []
        }
        dir = child
    }
}

fn has_dir(dirs: [str: []Entry], name: str) -> bool {
    match dirs[name] {
        some(_) => true
        none => false
    }
}

fn add_std_entry(dirs: [str: []Entry], dir: str, entry: Entry) {
    var held = dirs[dir] ?? []
    held.push(entry)
    dirs[dir] = held
}

fn std_file_data(s: *Std, key: str) -> str? {
    let inside = text.strip_prefix(key, "std/") ?? return none
    s.files[inside]
}

fn is_std(module: str) -> bool {
    module == "std" || text.starts_with(module, "std/")
}

pub fn reason(e: io.Error) -> str {
    match e {
        NotFound => "no such file or directory"
        Denied => "permission denied"
        NotDir => "not a directory"
        IsDir => "is a directory"
        Exists => "file exists"
        NotEmpty => "directory not empty"
        NoSpace => "no space left on device"
        Invalid => "invalid argument"
        Os(code) => "errno {code}"
        _ => "input/output error"
    }
}

fn failed(op: str, name: str, e: io.Error) -> Error {
    Error.Failed("{op} {name}: {reason(e)}")
}

struct Tree {
    privileged: bool
    std: *Std
    docs: *Overlay
    root: str
}

struct Listing {
    files: []str
    absent: bool
}

struct Directory {
    entries: []Entry
    absent: bool
}

fn read_dir(t: Tree, dir: str) -> Directory ! Error {
    if t.privileged {
        let found = t.std.dirs[dir] ?? return Directory { entries: [], absent: true }
        return Directory { entries: found, absent: false }
    }
    let found = overlay_read_dir(t.docs, dir) catch {
        NotFound => return Directory { entries: [], absent: true }
        NotDir => fail Error.Failed("readdirent {dir}: not a directory")
        e => fail failed("open", dir, e)
    }
    Directory { entries: found, absent: false }
}

fn sources(t: Tree, dir: str, platform: target.OS, tests: bool) -> Listing ! Error {
    let entries = read_dir(t, dir)?
    var sorted = entries.entries
    slices.sort_by(mut sorted, fn(a: Entry, b: Entry) -> bool { a.name < b.name })
    var files: []str = []
    for entry in sorted {
        if builds(entry, platform, tests) {
            files.push(path.join([dir, entry.name]))
        }
    }
    Listing { files, absent: entries.absent }
}

/// Reports whether the directory `dir` holds a `.low` file that a build for `platform` reads; a missing directory holds none.
pub fn holds_sources(docs: *Overlay, dir: str, platform: target.OS) -> bool ! Error {
    let entries = overlay_read_dir(docs, dir) catch {
        NotFound => return false
        NotDir => return false
        e => fail failed("open", dir, e)
    }
    entries.any(fn(entry) builds(entry, platform, false))
}

fn builds(entry: Entry, platform: target.OS, tests: bool) -> bool {
    !entry.dir && entry.name != manifest_file && text.ends_with(entry.name, ".low") && target.builds(platform, entry.name) && (tests || !target.is_test(entry.name))
}

fn parse(t: Tree, name: str) -> *ast.File ! Error {
    let src = read_source(t, name)?
    let f = parse_source(src, name, t.privileged)?
    f.path = name
    f
}

pub fn parse_file(docs: *Overlay, name: str) -> *ast.File ! Error {
    let src = read_disk(docs, name)?
    let f = parse_source(src, name, false)?
    f.path = name
    f
}

fn read_source(t: Tree, name: str) -> str ! Error {
    if t.privileged {
        if name == stamp_file && t.root != "" {
            return stamped_source(t.docs.disk, t.root)
        }
        return std_file_data(t.std, name) ?? fail Error.Failed("open {name}: no such file or directory")
    }
    read_disk(t.docs, name)?
}

fn read_disk(docs: *Overlay, name: str) -> str ! Error {
    overlay_read(docs, name) catch {
        e => fail failed("open", name, e)
    }
}

pub fn parse_source(src: str, name: str, privileged: bool) -> *ast.File ! Error {
    parser.parse_source(src, diag.file_start(name, src), privileged) catch Diag
}

pub fn root(docs: *Overlay, dir: str) -> str? {
    let getcwd = docs.disk.cwd
    let cwd = getcwd() or return none
    var d = docs.disk.absolute(cwd, dir)
    for true {
        if overlay_exists(docs, path.join([d, manifest_file])) || overlay_exists(docs, path.join([d, module_file])) {
            return d
        }
        d = docs.disk.parent(d) ?? return none
    }
    none
}

fn parent(d: Disk, dir: str) -> str? {
    var up = path.dir(dir)
    if d.drives && up.len == 2 && has_drive_letter(up) {
        up = "{up}/"
    }
    if up == dir || !d.rooted(up) {
        return none
    }
    up
}

pub fn absolute(d: Disk, cwd: str, name: str) -> str {
    let keyed = path_key(d.drives, name)
    if d.rooted(keyed) {
        return keyed
    }
    path_key(d.drives, path.join([cwd, keyed]))
}

fn rooted(d: Disk, name: str) -> bool {
    path.is_absolute(name) || d.has_drive(name)
}

fn has_drive(d: Disk, name: str) -> bool {
    d.drives && name.len >= 3 && name[1] == ':' && (name[2] == '/' || name[2] == '\\')
}

pub fn absolute_path(docs: *Overlay, name: str) -> str ! Error {
    let getcwd = docs.disk.cwd
    let cwd = getcwd() catch {
        e => fail failed("getwd", "", e)
    }
    docs.disk.absolute(cwd, name)
}

struct Edge {
    from: str
    to: str
    pos: diag.Pos
}

pub struct Loader {
    root: str = ""
    platform: target.OS
    std: *Std
    docs: *Overlay
    files: []*ast.File = []
    sources: []str = []
    edges: [str: []Edge] = [:]
    parents: [str: str] = [:]
    pending: []Edge = []
    loaded: [str: bool] = [:]
    tested: Tested? = none
    manifest: *Manifest? = none
    main: *Project? = none
    lock: [str: Locked] = [:]
    lock_read: bool = false
    projects: [str: *Project] = [:]
    owners: [str: *Project] = [:]
    dirs: [str: str] = [:]
    prepared: [str: Parsed] = [:]
    embeds: [str: []str] = [:]
}

pub fn load_modules(entry_path: str, platform: target.OS, std: *Std, docs: *Overlay) -> *Loader ! Error {
    let l = new(Loader { platform, std, docs })
    let disk = Tree { privileged: false, std, docs, root: "" }
    let info = overlay_stat(docs, entry_path) catch {
        e => fail failed("stat", entry_path, e)
    }
    var dir = path.dir(entry_path)
    var entry: []str = [entry_path]
    if info.dir {
        dir = entry_path
        let listing = sources(disk, entry_path, platform, false)?
        entry = listing.files
        if entry.len == 0 {
            fail Error.Failed("{entry_path}: no .low files")
        }
    }
    l.root = root(docs, dir) ?? dir
    l.manifest = project_manifest(docs, l.root)?
    main_project(l)?
    module(l, "", entry, false)?
    drain(l)?
    l
}

fn drain(l: *Loader) ! Error {
    var head = 0
    var ready = 0
    for head < l.pending.len {
        if head == ready {
            l.prefetch(head)
            ready = l.pending.len
        }
        let next = l.pending[head]
        head += 1
        imported(l, next)?
    }
    cycles(l)?
}

pub fn module_names(l: *Loader) -> []str {
    var names: []str = []
    for name in l.loaded {
        if name != "" {
            names.push(name)
        }
    }
    slices.sort(mut names)
    names
}

pub fn user_files(l: *Loader) -> []*ast.File {
    var out: []*ast.File = []
    for f in l.files {
        if !is_std(f.module) && l.in_main(f.module) {
            out.push(f)
        }
    }
    out
}

fn tree_of(l: *Loader, module_name: str) -> Tree {
    Tree { privileged: is_std(module_name), std: l.std, docs: l.docs, root: l.root }
}

fn imported(l: *Loader, e: Edge) ! Error {
    if l.loaded[e.to] != none {
        return
    }
    for part in text.split(e.to, '/') {
        if part == examples_dir {
            fail Error.Diag(diag.Error.At(e.pos, "import-examples", "cannot import {e.to}: an examples directory holds programs, not modules"))
        }
    }
    if !target.has_os(l.platform) && e.to == "std/sys" {
        let chain = import_chain(l, e)
        fail Error.Diag(diag.Error.At(e.pos, "target-unsupported", "{target.string(l.platform)} has no operating system, so std/sys cannot be imported: {chain}"))
    }
    l.parents[e.to] = e.from
    match l.tested {
        some(t) => {
            if t.name == e.to {
                load_tested(l, t)?
                return
            }
        }
        none => {}
    }
    let at = place_of(l, e.to)
    let listing = sources(at.source, at.dir, l.platform, false)?
    if listing.absent || listing.files.len == 0 {
        fail Error.Diag(diag.Error.At(e.pos, "unknown-module", "cannot find module {e.to} in {at.label}"))
    }
    module(l, e.to, listing.files, false)?
}

struct Place {
    source: Tree
    dir: str
    label: str
}

fn place_of(l: *Loader, name: str) -> Place {
    let source = tree_of(l, name)
    if source.privileged {
        return Place { source, dir: name, label: "the standard library" }
    }
    let dir = l.dirs[name] ?? panic("module {name} was never placed")
    Place { source, dir, label: dir }
}

fn is_tested(l: *Loader, name: str) -> bool {
    match l.tested {
        some(t) => t.name == name
        none => false
    }
}

struct Parsed {
    file: *ast.File? = none
    error: Error? = none
    unread: bool = false
    embeds: []str = []
}

struct Unparsed {
    name: str
    source: Tree
}

fn prefetch(l: *Loader, from: i64) {
    var wanted: []Unparsed = []
    var seen: [str: bool] = [:]
    for e in l.pending[from..] {
        if l.loaded[e.to] != none || seen[e.to] != none || l.is_tested(e.to) {
            continue
        }
        seen[e.to] = true
        let at = place_of(l, e.to)
        let listing = sources(at.source, at.dir, l.platform, false) or continue
        l.gather(at.source, listing.files, mut wanted)
    }
    l.parse_all(wanted)
}

fn prepare_sources(l: *Loader, source: Tree, files: []str) {
    var wanted: []Unparsed = []
    l.gather(source, files, mut wanted)
    l.parse_all(wanted)
}

fn gather(l: *Loader, source: Tree, files: []str, mut wanted: []Unparsed) {
    for name in files {
        if l.prepared[name] != none {
            continue
        }
        wanted.push(Unparsed { name, source })
    }
}

fn parse_all(l: *Loader, wanted: []Unparsed) {
    var results: []Parsed = []
    for _ in wanted {
        results.push(Parsed {})
    }
    let each = l.docs.jobs.each
    each(wanted.len, fn(i: i64) {
        results[i] = parse_unparsed(wanted[i])
    })
    for i, w in wanted {
        if !results[i].unread {
            l.prepared[w.name] = results[i]
        }
        if results[i].embeds.len > 0 {
            l.embeds[w.name] = results[i].embeds
        }
    }
}

fn parse_unparsed(w: Unparsed) -> Parsed {
    let src = read_source(w.source, w.name) or return Parsed { unread: true }
    let f = parse_source(src, w.name, w.source.privileged) catch {
        e => return Parsed { error: e }
    }
    f.path = w.name
    if w.source.privileged {
        return Parsed { file: f }
    }
    Parsed { file: f, embeds: embed_names(src) }
}

fn embed_names(src: str) -> []str {
    var names: []str = []
    var at = 0
    for at < src.len {
        let found = text.index(src[at..], "embed(\"")
        if found < 0 {
            break
        }
        let call = at + found
        let start = call + 7
        let end = text.index_byte(src[start..], '"')
        if end < 0 {
            break
        }
        let name = src[start..start + end]
        if (call == 0 || !name_byte(src[call - 1])) && plain_path(name) {
            names.push(name)
        }
        at = start + end + 1
    }
    names
}

fn name_byte(c: u8) -> bool {
    (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'
}

fn plain_path(name: str) -> bool {
    if name.len == 0 {
        return false
    }
    for i in 0..name.len {
        let c = name[i]
        if c == '\\' || c == '{' || c == '}' || c == '\n' {
            return false
        }
    }
    true
}

fn parse_prepared(l: *Loader, source: Tree, name: str) -> *ast.File ! Error {
    let ready = l.prepared[name] ?? return parse(source, name)?
    l.prepared.delete(name)
    match ready.error {
        some(e) => fail e
        none => {}
    }
    ready.file ?? panic("a prepared source has no file")
}

fn import_chain(l: *Loader, e: Edge) -> str {
    var names: []str = [display(e.to)]
    var at = e.from
    for true {
        names.push(display(at))
        match l.parents[at] {
            some(parent) => {
                at = parent
            }
            none => break
        }
    }
    var reversed: []str = []
    var i = names.len - 1
    for i >= 0 {
        reversed.push(names[i])
        i -= 1
    }
    text.join(reversed, " -> ")
}

fn check_externs(l: *Loader, f: *ast.File, privileged: bool) ! Error {
    if target.has_os(l.platform) {
        return
    }
    for x in f.externs {
        if x.library == "m" || ((x.library == "low" || x.library == "wasm") && privileged) {
            continue
        }
        fail Error.Diag(diag.Error.At(x.pos, "target-unsupported", "{target.string(l.platform)} has no library {diag.quote(x.library)}; a browser program can declare only extern {diag.quote("m")}"))
    }
}

fn open_module(l: *Loader, name: str) {
    l.loaded[name] = true
    l.edges[name] = []
}

fn module(l: *Loader, name: str, files: []str, tests: bool) ! Error {
    open_module(l, name)
    let source = tree_of(l, name)
    l.prepare_sources(source, files)
    var parsed: []*ast.File = []
    for file_name in files {
        let f = l.parse_prepared(source, file_name)?
        f.module = name
        check_externs(l, f, source.privileged)?
        l.files.push(f)
        parsed.push(f)
        if !source.privileged {
            l.sources.push(file_name)
        }
        let counted = !(tests && target.is_test(path.base(file_name)))
        link_imports(l, f, counted)?
    }
    check_top_level(name, parsed)?
}

fn check_top_level(name: str, parsed: []*ast.File) ! Error {
    var holder: *ast.File? = none
    var declared_main = false
    for f in parsed {
        for func in f.funcs {
            declared_main = declared_main || (func.name == "main" && !func.top_level)
        }
    }
    for f in parsed {
        let code = top_level_code(f) ?? continue
        if name != "" && name != tested_root {
            fail Error.Diag(diag.Error.At(code.pos, "top-level", "statements outside a function are allowed only in the entry module, not in {name}"))
        }
        if declared_main {
            fail Error.Diag(diag.Error.At(code.pos, "top-level", "a module with statements outside a function cannot also declare fn main"))
        }
        match holder {
            some(first) => fail Error.Diag(diag.Error.At(code.pos, "top-level", "statements outside a function are already in {path.base(first.path)}; one file of a module holds them"))
            none => { holder = f }
        }
    }
}

fn top_level_code(f: *ast.File) -> *ast.Func? {
    for func in f.funcs {
        if func.top_level {
            return func
        }
    }
    none
}

fn link_imports(l: *Loader, f: *ast.File, counted: bool) ! Error {
    let from = l.project_of(f.module)
    var seen: [str: bool] = [:]
    for imp in f.imports {
        if seen[imp.alias] != none {
            fail Error.Diag(diag.Error.At(imp.pos, "duplicate-import", "module name {imp.alias} imported twice"))
        }
        seen[imp.alias] = true
        let placed = l.place(from, imp)?
        imp.path = placed.name
        let e = Edge { from: f.module, to: placed.name, pos: imp.pos }
        if counted {
            var held = l.edges[f.module] ?? []
            held.push(e)
            l.edges[f.module] = held
        }
        l.pending.push(e)
    }
}

struct Cycles {
    state: [str: i64] = [:]
    stack: []str = []
}

fn cycles(l: *Loader) ! Error {
    let c = new(Cycles {})
    visit(l, c, "")?
    for name in l.loaded {
        if c.state[name] == none {
            visit(l, c, name)?
        }
    }
}

fn visit(l: *Loader, c: *Cycles, module_name: str) ! Error {
    c.state[module_name] = 1
    c.stack.push(module_name)
    for e in l.edges[module_name] ?? [] {
        let state = c.state[e.to] ?? 0
        if state == 1 {
            var cycle: []str = []
            var at = 0
            for i, m in c.stack {
                if m == e.to {
                    at = i
                    break
                }
            }
            for i in at..c.stack.len {
                cycle.push(display(c.stack[i]))
            }
            cycle.push(display(e.to))
            fail Error.Diag(diag.Error.At(e.pos, "import-cycle", "import cycle: {text.join(cycle, " -> ")}"))
        }
        if state == 0 {
            visit(l, c, e.to)?
        }
    }
    c.stack = c.stack[0..c.stack.len - 1]
    c.state[module_name] = 2
}

fn display(module_name: str) -> str {
    if module_name == "" {
        return "main"
    }
    module_name
}
