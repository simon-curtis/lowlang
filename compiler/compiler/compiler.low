import amd64
import ast
import check
import ir
import lint
import prelude
import target
import types
import std/file
import std/path

pub struct Unit {
    pub files: []*ast.File
    pub universe: *types.Universe
    pub sources: []str
    pub embeds: [str: []u8]
    pub warnings: []lint.Warning
    pub profile: Profile = Profile {}
    pub platform: amd64.Platform = amd64.Platform.Sysv
    pub program: *ir.Program? = none
}

pub fn check(entry_path: str, platform: target.OS) -> *Unit ! Error {
    let prelude_file = parse_prelude()?
    let modules = load_modules(entry_path, platform)?
    var files: []*ast.File = [prelude_file]
    for f in modules.files {
        push(mut files, f)
    }
    let embedder = new(Embedder {})
    let resolver = resolver_of(embedder)
    let lister = lister_of(embedder)
    let universe = check.check(files, resolver, lister) catch Diag
    var sources = modules.sources
    for p in embedder.paths {
        push(mut sources, p)
    }
    let warnings = lint.run(user_files(modules))
    new(Unit { files, universe, sources, embeds: embedder.data, warnings })
}

fn resolver_of(e: *Embedder) -> fn(*ast.File, str) -> check.Embedded ! check.EmbedError {
    fn(f: *ast.File, name: str) -> check.Embedded ! check.EmbedError {
        resolve(e, f, name)?
    }
}

fn lister_of(e: *Embedder) -> fn(*ast.File, str) -> []str ! check.EmbedError {
    fn(f: *ast.File, name: str) -> []str ! check.EmbedError {
        list(e, f, name)?
    }
}

fn parse_prelude() -> *ast.File ! Error {
    let location = path.join([path.dir(std_root()), "prelude.low"])
    let src = file.read_text(location) catch {
        err => fail failed("open", location, err)
    }
    let f = parse_source(src, "prelude.low", true)?
    prelude.validate(f) catch {
        err => fail Error.Prelude(prelude.message(err))
    }
    f
}
