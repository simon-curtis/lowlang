import ast
import check
import ir
import lint
import prelude
import target
import types

pub struct Unit {
    pub files: []*ast.File
    pub universe: *types.Universe
    pub sources: []str
    pub embeds: [str: []u8]
    pub warnings: []lint.Warning
    pub profile: Profile = Profile {}
    pub program: *ir.Program? = none
}

pub struct Checked {
    pub unit: *Unit? = none
    pub error: Error? = none
    pub files: []*ast.File = []
}

pub fn check(entry_path: str, platform: target.OS, docs: *Overlay) -> *Unit ! Error {
    let std = new_std()
    check_in(entry_path, platform, std, docs)?
}

pub fn check_in(entry_path: str, platform: target.OS, std: *Std, docs: *Overlay) -> *Unit ! Error {
    let checked = check_overlay(entry_path, platform, std, docs)
    match checked.error {
        some(e) => fail e
        none => checked.unit ?? panic("a check without an error has no unit")
    }
}

pub fn check_overlay(entry_path: str, platform: target.OS, std: *Std, docs: *Overlay) -> *Checked {
    let prelude_file = parse_prelude() catch {
        e => return rejected(e, [])
    }
    let modules = load_modules(entry_path, platform, std, docs) catch {
        e => return rejected(e, [])
    }
    var files: []*ast.File = [prelude_file]
    for f in modules.files {
        push(mut files, f)
    }
    let embedder = new(Embedder { std, docs })
    let resolver = resolver_of(embedder)
    let lister = lister_of(embedder)
    let universe = check.check(files, resolver, lister) catch {
        e => return rejected(Error.Diag(e), files)
    }
    var sources = modules.sources
    for p in embedder.paths {
        push(mut sources, p)
    }
    let warnings = lint.run(user_files(modules))
    let unit = new(Unit { files, universe, sources, embeds: embedder.data, warnings })
    new(Checked { unit })
}

fn rejected(e: Error, files: []*ast.File) -> *Checked {
    new(Checked { error: e, files })
}

fn resolver_of(e: *Embedder) -> fn(*ast.File, str) -> check.Embedded ! check.EmbedError {
    fn(f: *ast.File, name: str) -> check.Embedded ! check.EmbedError {
        resolve(e, f, name)?
    }
}

fn lister_of(e: *Embedder) -> fn(*ast.File, str) -> []str ! check.EmbedError {
    fn(f: *ast.File, name: str) -> []str ! check.EmbedError {
        list(e, f, name)?
    }
}

pub fn parse_prelude() -> *ast.File ! Error {
    let src = embed("prelude/prelude.low")
    let f = parse_source(src, "prelude.low", true)?
    prelude.validate(f) catch {
        err => fail Error.Prelude(prelude.message(err))
    }
    f
}
