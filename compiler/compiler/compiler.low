import ast
import check
import ir
import lint
import prelude
import target
import types

pub struct Unit {
    pub files: []*ast.File
    pub universe: *types.Universe
    pub sources: []str
    pub embeds: [str: []u8]
    pub warnings: []lint.Warning
    pub profile: Profile = Profile {}
    pub program: *ir.Program? = none
    pub manifest: *Manifest? = none
    pub jobs: ir.Runner
}

pub struct Checked {
    pub unit: *Unit? = none
    pub error: Error? = none
    pub files: []*ast.File = []
}

pub fn check(entry_path: str, platform: target.OS, docs: *Overlay) -> *Unit ! Error {
    let std = new_std()
    check_in(entry_path, platform, std, docs)?
}

pub fn check_in(entry_path: str, platform: target.OS, std: *Std, docs: *Overlay) -> *Unit ! Error {
    let checked = check_overlay(entry_path, platform, std, docs)
    accepted(checked)?
}

pub fn check_tests(module_path: str, platform: target.OS, docs: *Overlay) -> *Unit ! Error {
    let std = new_std()
    let checked = check_tests_in(module_path, platform, std, docs)
    accepted(checked)?
}

fn accepted(checked: *Checked) -> *Unit ! Error {
    match checked.error {
        some(e) => fail e
        none => checked.unit ?? panic("a check without an error has no unit")
    }
}

pub fn check_library(entry_path: str, platform: target.OS, docs: *Overlay) -> *Unit ! Error {
    let std = new_std()
    let checked = check_entry(entry_path, platform, std, docs, false)
    accepted(checked)?
}

pub fn check_overlay(entry_path: str, platform: target.OS, std: *Std, docs: *Overlay) -> *Checked {
    check_entry(entry_path, platform, std, docs, true)
}

fn check_entry(entry_path: str, platform: target.OS, std: *Std, docs: *Overlay, main_required: bool) -> *Checked {
    ir.mark(docs.jobs, "load")
    let runtime = runtime_files(platform) catch {
        e => return rejected(e, [])
    }
    let modules = load_modules(entry_path, platform, std, docs) catch {
        e => return rejected(e, [])
    }
    check_modules(runtime, modules, platform, std, docs, main_required)
}

pub fn check_tests_in(module_path: str, platform: target.OS, std: *Std, docs: *Overlay) -> *Checked {
    ir.mark(docs.jobs, "load")
    let runtime = runtime_files(platform) catch {
        e => return rejected(e, [])
    }
    let modules = load_tests(module_path, platform, std, docs) catch {
        e => return rejected(e, [])
    }
    check_modules(runtime, modules, platform, std, docs, true)
}

fn runtime_files(platform: target.OS) -> []*ast.File ! Error {
    let prelude_file = parse_prelude()?
    if target.has_os(platform) {
        return [prelude_file]
    }
    let runtime_file = parse_browser_runtime()?
    [prelude_file, runtime_file]
}

fn check_modules(runtime: []*ast.File, modules: *Loader, platform: target.OS, std: *Std, docs: *Overlay, main_required: bool) -> *Checked {
    var files = runtime
    for f in modules.files {
        files.push(f)
    }
    let embedder = new(Embedder { std, docs })
    let resolver = resolver_of(embedder)
    let lister = lister_of(embedder)
    ir.mark(docs.jobs, "check")
    let universe = check.check(files, platform, main_required, resolver, lister) catch {
        e => return rejected(Error.Diag(e), files)
    }
    var sources = modules.sources
    for p in embedder.paths {
        sources.push(p)
    }
    ir.mark(docs.jobs, "lint")
    let warnings = lint.run(user_files(modules))
    let unit = new(Unit { files, universe, sources, embeds: embedder.data, warnings, manifest: modules.manifest, jobs: docs.jobs })
    new(Checked { unit })
}

fn rejected(e: Error, files: []*ast.File) -> *Checked {
    new(Checked { error: e, files })
}

fn resolver_of(e: *Embedder) -> fn(*ast.File, str) -> check.Embedded ! check.EmbedError {
    fn(f: *ast.File, name: str) -> check.Embedded ! check.EmbedError {
        resolve(e, f, name)?
    }
}

fn lister_of(e: *Embedder) -> fn(*ast.File, str) -> []str ! check.EmbedError {
    fn(f: *ast.File, name: str) -> []str ! check.EmbedError {
        list(e, f, name)?
    }
}

pub fn parse_browser_runtime() -> *ast.File ! Error {
    let src = embed("prelude/browser.low")
    parse_source(src, "browser.low", true)?
}

pub fn parse_prelude() -> *ast.File ! Error {
    let src = embed("prelude/prelude.low")
    let f = parse_source(src, "prelude.low", true)?
    prelude.validate(f) catch {
        err => fail Error.Prelude(prelude.message(err))
    }
    f
}
