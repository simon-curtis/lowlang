import std/file
import std/io
import std/path
import std/slices

pub struct Overlay {
    pub files: [str: str] = [:]
}

pub fn new_overlay() -> *Overlay {
    new(Overlay {})
}

pub fn overlay_put(o: *Overlay, name: str, contents: str) {
    o.files[path.clean(name)] = contents
}

pub fn overlay_drop(o: *Overlay, name: str) {
    delete(mut o.files, path.clean(name))
}

pub fn overlay_copy(o: *Overlay) -> *Overlay {
    let copy = new_overlay()
    for name in o.files {
        copy.files[name] = o.files[name] ?? ""
    }
    copy
}

pub fn overlay_read(o: *Overlay, name: str) -> str ! io.Error {
    match o.files[path.clean(name)] {
        some(held) => held
        none => file.read_text(name)?
    }
}

pub fn overlay_read_bytes(o: *Overlay, name: str) -> []u8 ! io.Error {
    match o.files[path.clean(name)] {
        some(held) => bytes(held)
        none => file.read_file(name)?
    }
}

pub fn overlay_stat(o: *Overlay, name: str) -> file.Info ! io.Error {
    match o.files[path.clean(name)] {
        some(held) => file.Info { size: held.len, mode: 0o644, dir: false, modified: 0, regular: true }
        none => file.stat(name)?
    }
}

pub fn overlay_exists(o: *Overlay, name: str) -> bool {
    overlay_stat(o, name) or return false
    true
}

pub fn overlay_read_dir(o: *Overlay, name: str) -> []file.Entry ! io.Error {
    let dir = path.clean(name)
    var held: []file.Entry = []
    for held_path in o.files {
        if path.dir(held_path) == dir {
            push(mut held, file.Entry { name: path.base(held_path), dir: false, link: false, regular: true })
        }
    }
    let disk = disk_entries(dir, held.len > 0)?
    var entries: []file.Entry = []
    for entry in disk {
        if !named_in(held, entry.name) {
            push(mut entries, entry)
        }
    }
    for entry in held {
        push(mut entries, entry)
    }
    slices.sort_by(mut entries, fn(a: file.Entry, b: file.Entry) -> bool { a.name < b.name })
    entries
}

fn disk_entries(dir: str, held: bool) -> []file.Entry ! io.Error {
    file.read_dir_info(dir) catch {
        NotFound => {
            if !held {
                fail NotFound
            }
            []
        }
        e => fail e
    }
}

fn named_in(entries: []file.Entry, name: str) -> bool {
    for entry in entries {
        if entry.name == name {
            return true
        }
    }
    false
}

pub fn overlay_files(o: *Overlay, root: str) -> []str ! io.Error {
    var names: []str = []
    collect_files(o, root, "", mut names)?
    slices.sort(mut names)
    names
}

fn collect_files(o: *Overlay, root: str, inside: str, mut names: []str) ! io.Error {
    var dir = root
    if inside != "" {
        dir = "{root}/{inside}"
    }
    for entry in overlay_read_dir(o, dir)? {
        var found = entry.name
        if inside != "" {
            found = "{inside}/{entry.name}"
        }
        if entry.dir {
            collect_files(o, root, found, mut names)?
        } else if entry.regular {
            push(mut names, found)
        }
    }
}
