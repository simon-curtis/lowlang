import ir
import std/io
import std/path
import std/slices
import std/text

pub struct Entry {
    pub name: str
    pub dir: bool
    pub link: bool
    pub regular: bool
}

pub struct Info {
    pub size: i64
    pub dir: bool
    pub regular: bool
}

pub struct Disk {
    pub read: fn(str) -> []u8 ! io.Error
    pub stat: fn(str) -> Info ! io.Error
    pub list: fn(str) -> []Entry ! io.Error
    pub real: fn(str) -> str ! io.Error
    pub cwd: fn() -> str ! io.Error
    pub drives: bool
    /// The directory that holds fetched dependencies, or empty when there is none.
    pub cache: str
    /// The checkout of the package index, or empty when there is none.
    pub index: str = ""
    pub stamp: fn(str) -> Stamp
}

pub struct Overlay {
    pub disk: Disk
    pub jobs: ir.Runner
    pub files: [str: str] = [:]
}

pub fn new_overlay(disk: Disk, jobs: ir.Runner) -> *Overlay {
    new(Overlay { disk, jobs })
}

fn drive_letter(c: u8) -> bool {
    (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
}

/// Reports whether `name` starts with a drive letter and a colon that ends the name or is followed by a `/` or `\`.
pub fn has_drive_letter(name: str) -> bool {
    name.len >= 2 && drive_letter(name[0]) && name[1] == ':' && (name.len == 2 || name[2] == '/' || name[2] == '\\')
}

fn upper_drive(name: str) -> str {
    if !has_drive_letter(name) {
        return name
    }
    let letter = text.upper(name[..1])
    "{letter}{name[1..]}"
}

/// Returns the form of `name` that two spellings of one file share.
///
/// Without `drives` that is `path.clean`. With `drives` the separators are `/`, a drive letter is upper case, and a UNC name keeps its leading `//`.
pub fn path_key(drives: bool, name: str) -> str {
    if !drives {
        return path.clean(name)
    }
    let slashed = text.replace(name, "\\", "/")
    if text.starts_with(slashed, "//") {
        let share = path.clean(slashed[2..])
        return "//{share}"
    }
    let cleaned = path.clean(upper_drive(slashed))
    upper_drive(cleaned)
}

fn overlay_key(o: *Overlay, name: str) -> str {
    path_key(o.disk.drives, name)
}

pub fn overlay_put(o: *Overlay, name: str, contents: str) {
    o.files[overlay_key(o, name)] = contents
}

pub fn overlay_drop(o: *Overlay, name: str) {
    o.files.delete(overlay_key(o, name))
}

pub fn overlay_copy(o: *Overlay) -> *Overlay {
    let copy = new_overlay(o.disk, o.jobs)
    for name in o.files {
        copy.files[name] = o.files[name] ?? ""
    }
    copy
}

fn held(o: *Overlay, name: str) -> str? {
    if o.files.len == 0 {
        return none
    }
    o.files[overlay_key(o, name)]
}

pub fn overlay_read(o: *Overlay, name: str) -> str ! io.Error {
    match o.held(name) {
        some(contents) => contents
        none => {
            let data = overlay_read_bytes(o, name)?
            str(data)
        }
    }
}

fn overlay_holds(o: *Overlay, name: str) -> bool {
    o.held(name) != none
}

pub fn overlay_read_bytes(o: *Overlay, name: str) -> []u8 ! io.Error {
    match o.held(name) {
        some(contents) => bytes(contents)
        none => {
            let read = o.disk.read
            read(name)?
        }
    }
}

pub fn overlay_stat(o: *Overlay, name: str) -> Info ! io.Error {
    match o.held(name) {
        some(contents) => Info { size: contents.len, dir: false, regular: true }
        none => {
            let stat = o.disk.stat
            stat(name)?
        }
    }
}

pub fn overlay_exists(o: *Overlay, name: str) -> bool {
    overlay_stat(o, name) or return false
    true
}

pub fn overlay_read_dir(o: *Overlay, name: str) -> []Entry ! io.Error {
    let dir = overlay_key(o, name)
    var held: []Entry = []
    for held_path in o.files {
        if path.dir(held_path) == dir {
            held.push(Entry { name: path.base(held_path), dir: false, link: false, regular: true })
        }
    }
    let disk = disk_entries(o, dir, held.len > 0)?
    var entries: []Entry = []
    for entry in disk {
        if !named_in(held, entry.name) {
            entries.push(entry)
        }
    }
    for entry in held {
        entries.push(entry)
    }
    slices.sort_by(mut entries, fn(a: Entry, b: Entry) -> bool { a.name < b.name })
    entries
}

fn disk_entries(o: *Overlay, dir: str, held: bool) -> []Entry ! io.Error {
    let list = o.disk.list
    list(dir) catch {
        NotFound => {
            if !held {
                fail NotFound
            }
            []
        }
        e => fail e
    }
}

fn named_in(entries: []Entry, name: str) -> bool {
    entries.any(fn(entry) entry.name == name)
}

struct DirListing {
    entries: []Entry = []
    failure: io.Error? = none
}

pub fn overlay_files(o: *Overlay, root: str) -> []str ! io.Error {
    var names: []str = []
    var level: []str = [root]
    for level.len > 0 {
        var deeper: []str = []
        for i, listing in list_level(o, level) {
            match listing.failure {
                some(e) => fail e
                none => {}
            }
            for entry in listing.entries {
                let found = "{level[i]}/{entry.name}"
                if entry.dir {
                    deeper.push(found)
                } else if entry.regular {
                    names.push(found[root.len + 1..])
                }
            }
        }
        level = deeper
    }
    slices.sort(mut names)
    names
}

fn list_level(o: *Overlay, level: []str) -> []DirListing {
    var listings: []DirListing = []
    for _ in level {
        listings.push(DirListing {})
    }
    let each = o.jobs.each
    each(level.len, fn(i: i64) {
        let entries = overlay_read_dir(o, level[i]) catch {
            e => {
                listings[i] = DirListing { failure: e }
                return
            }
        }
        listings[i] = DirListing { entries }
    })
    listings
}
