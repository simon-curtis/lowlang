import std/io
import std/path
import std/slices
import std/text

pub struct Entry {
    pub name: str
    pub dir: bool
    pub link: bool
    pub regular: bool
}

pub struct Info {
    pub size: i64
    pub dir: bool
    pub regular: bool
}

pub struct Disk {
    pub read: fn(str) -> []u8 ! io.Error
    pub stat: fn(str) -> Info ! io.Error
    pub list: fn(str) -> []Entry ! io.Error
    pub cwd: fn() -> str ! io.Error
    pub drives: bool
}

pub struct Overlay {
    pub disk: Disk
    pub files: [str: str] = [:]
}

pub fn new_overlay(disk: Disk) -> *Overlay {
    new(Overlay { disk })
}

fn drive_letter(c: u8) -> bool {
    (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
}

/// Reports whether `name` starts with a drive letter and a colon that ends the name or is followed by a `/` or `\`.
pub fn has_drive_letter(name: str) -> bool {
    name.len >= 2 && drive_letter(name[0]) && name[1] == ':' && (name.len == 2 || name[2] == '/' || name[2] == '\\')
}

fn upper_drive(name: str) -> str {
    if !has_drive_letter(name) {
        return name
    }
    let letter = text.upper(name[..1])
    "{letter}{name[1..]}"
}

/// Returns the form of `name` that two spellings of one file share.
///
/// Without `drives` that is `path.clean`. With `drives` the separators are `/`, a drive letter is upper case, and a UNC name keeps its leading `//`.
pub fn path_key(drives: bool, name: str) -> str {
    if !drives {
        return path.clean(name)
    }
    let slashed = text.replace(name, "\\", "/")
    if text.starts_with(slashed, "//") {
        let share = path.clean(slashed[2..])
        return "//{share}"
    }
    let cleaned = path.clean(upper_drive(slashed))
    upper_drive(cleaned)
}

fn overlay_key(o: *Overlay, name: str) -> str {
    path_key(o.disk.drives, name)
}

pub fn overlay_put(o: *Overlay, name: str, contents: str) {
    o.files[overlay_key(o, name)] = contents
}

pub fn overlay_drop(o: *Overlay, name: str) {
    delete(mut o.files, overlay_key(o, name))
}

pub fn overlay_copy(o: *Overlay) -> *Overlay {
    let copy = new_overlay(o.disk)
    for name in o.files {
        copy.files[name] = o.files[name] ?? ""
    }
    copy
}

pub fn overlay_read(o: *Overlay, name: str) -> str ! io.Error {
    match o.files[overlay_key(o, name)] {
        some(held) => held
        none => {
            let data = overlay_read_bytes(o, name)?
            str(data)
        }
    }
}

pub fn overlay_read_bytes(o: *Overlay, name: str) -> []u8 ! io.Error {
    match o.files[overlay_key(o, name)] {
        some(held) => bytes(held)
        none => {
            let read = o.disk.read
            read(name)?
        }
    }
}

pub fn overlay_stat(o: *Overlay, name: str) -> Info ! io.Error {
    match o.files[overlay_key(o, name)] {
        some(held) => Info { size: held.len, dir: false, regular: true }
        none => {
            let stat = o.disk.stat
            stat(name)?
        }
    }
}

pub fn overlay_exists(o: *Overlay, name: str) -> bool {
    overlay_stat(o, name) or return false
    true
}

pub fn overlay_read_dir(o: *Overlay, name: str) -> []Entry ! io.Error {
    let dir = overlay_key(o, name)
    var held: []Entry = []
    for held_path in o.files {
        if path.dir(held_path) == dir {
            push(mut held, Entry { name: path.base(held_path), dir: false, link: false, regular: true })
        }
    }
    let disk = disk_entries(o, dir, held.len > 0)?
    var entries: []Entry = []
    for entry in disk {
        if !named_in(held, entry.name) {
            push(mut entries, entry)
        }
    }
    for entry in held {
        push(mut entries, entry)
    }
    slices.sort_by(mut entries, fn(a: Entry, b: Entry) -> bool { a.name < b.name })
    entries
}

fn disk_entries(o: *Overlay, dir: str, held: bool) -> []Entry ! io.Error {
    let list = o.disk.list
    list(dir) catch {
        NotFound => {
            if !held {
                fail NotFound
            }
            []
        }
        e => fail e
    }
}

fn named_in(entries: []Entry, name: str) -> bool {
    entries.any(fn(entry) entry.name == name)
}

pub fn overlay_files(o: *Overlay, root: str) -> []str ! io.Error {
    var names: []str = []
    collect_files(o, root, "", mut names)?
    slices.sort(mut names)
    names
}

fn collect_files(o: *Overlay, root: str, inside: str, mut names: []str) ! io.Error {
    var dir = root
    if inside != "" {
        dir = "{root}/{inside}"
    }
    for entry in overlay_read_dir(o, dir)? {
        var found = entry.name
        if inside != "" {
            found = "{inside}/{entry.name}"
        }
        if entry.dir {
            collect_files(o, root, found, mut names)?
        } else if entry.regular {
            push(mut names, found)
        }
    }
}
