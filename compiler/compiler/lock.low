import std/path
import std/text

pub const lock_file = "build.lock"
const hash_prefix = "h1:"

/// One dependency recorded in `build.lock`: the source, the tagged version, the commit the tag names and the content hash of the commit's tree.
pub struct Locked {
    pub source: str
    pub version: str
    pub commit: str
    pub hash: str
}

/// Returns the location of the cached tree of `source` at `commit` below `cache`.
pub fn cached_dir(cache: str, source: str, commit: str) -> str {
    path.join([cache, "deps", "{source}@{commit}"])
}

/// Reads the `build.lock` of the project at `root`, keyed by source. A project without one has an empty lock.
pub fn read_lock(docs: *Overlay, root: str) -> [str: Locked] ! Error {
    let lock_path = path.join([root, lock_file])
    if !overlay_exists(docs, lock_path) {
        let empty: [str: Locked] = [:]
        return empty
    }
    let content = overlay_read(docs, lock_path) catch {
        e => fail failed("read", lock_path, e)
    }
    parse_lock(content, lock_path)?
}

/// Parses the lines of a `build.lock`, each `source version commit hash`. `lock_path` names the file in errors.
pub fn parse_lock(content: str, lock_path: str) -> [str: Locked] ! Error {
    var held: [str: Locked] = [:]
    for i, line in text.lines(content) {
        let fields = text.fields(line)
        if fields.len == 0 {
            continue
        }
        let at = "{lock_path}:{i + 1}"
        if fields.len != 4 {
            fail Error.Failed("{at}: expected source, version, commit and hash")
        }
        if !is_commit(fields[2]) {
            fail Error.Failed("{at}: {fields[2]} is not a commit")
        }
        if !text.starts_with(fields[3], hash_prefix) {
            fail Error.Failed("{at}: {fields[3]} is not a {hash_prefix} hash")
        }
        held[fields[0]] = Locked { source: fields[0], version: fields[1], commit: fields[2], hash: fields[3] }
    }
    held
}

/// Returns the text of a `build.lock` holding `entries`, one line each in the order given.
pub fn format_lock(entries: []Locked) -> str {
    var lines: []str = []
    for e in entries {
        lines.push("{e.source} {e.version} {e.commit} {e.hash}\n")
    }
    text.join(lines, "")
}

/// Reports whether `s` is a commit name: 40 or 64 lower-case hexadecimal digits.
pub fn is_commit(s: str) -> bool {
    if s.len != 40 && s.len != 64 {
        return false
    }
    var i = 0
    for i < s.len {
        let c = s[i]
        if text.hex_digit(c) < 0 || (c >= 'A' && c <= 'F') {
            return false
        }
        i += 1
    }
    true
}
