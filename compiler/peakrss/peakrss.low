import std/io
import std/process

const sample_interval_ms = 1

pub struct Measured {
    pub exit: process.Exit
    pub stdout: str
    pub stderr: str
    pub peak_kb: i64
}

struct Collected {
    data: []u8
    done: chan[bool]
}

struct Sampler {
    peak_kb: i64
    stop: chan[bool]
    done: chan[bool]
}

pub fn run(command: process.Command) -> Measured ! io.Error {
    using child = process.start(command)?
    let out = new(Collected { data: [], done: chan[bool](1) })
    let err = new(Collected { data: [], done: chan[bool](1) })
    collect_from(child.handle.stdout, out)
    collect_from(child.handle.stderr, err)
    let sampler = new(Sampler { peak_kb: 0, stop: chan[bool](), done: chan[bool](1) })
    spawn sample(child.handle.pid, sampler)
    process.wait_exit_on(child.handle)?
    close(sampler.stop)
    <-sampler.done
    <-out.done
    <-err.done
    let exit = process.wait(child)?
    Measured { exit, stdout: str(out.data), stderr: str(err.data), peak_kb: sampler.peak_kb }
}

fn collect_from(stream: io.Stream?, into: *Collected) {
    match stream {
        some(s) => {
            spawn collect(s, into)
        }
        none => {
            into.done <- true
        }
    }
}

fn collect(stream: io.Stream, into: *Collected) {
    let buffer = io.buffer(65536)
    for {
        let n = stream.read(buffer) or break
        if n == 0 {
            break
        }
        io.append(mut into.data, buffer[..n])
    }
    stream.close()
    into.done <- true
}

fn sample(pid: i64, sampler: *Sampler) {
    for {
        let kb = high_water_kb(pid)
        if kb > sampler.peak_kb {
            sampler.peak_kb = kb
        }
        let stopped = select {
            <-sampler.stop => true
            after(sample_interval_ms) => false
        }
        if stopped {
            break
        }
    }
    sampler.done <- true
}
