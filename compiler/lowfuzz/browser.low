import wasm
import std/file
import std/process

struct Browser {
    node: str = ""
    host: str = ""
    dir: str = ""
}

fn prepare_browser(enabled: bool) -> Browser {
    if !enabled {
        return Browser {}
    }
    let node = match process.find("node") {
        some(found) => found
        none => {
            print("node is not on PATH: browser/wasm32 builds are skipped")
            return Browser {}
        }
    }
    let dir = file.temp_dir("lowfuzz-host-") catch {
        e => {
            print("browser/wasm32 builds are skipped: {e}")
            return Browser {}
        }
    }
    let host = file.child_path(dir, "host.mjs")
    file.write_file(host, bytes(wasm.host_script())) catch {
        e => {
            print("browser/wasm32 builds are skipped: {e}")
            file.remove_all(dir) or {}
            return Browser {}
        }
    }
    Browser { node, host, dir }
}

fn release_browser(b: Browser) {
    if b.dir != "" {
        file.remove_all(b.dir) or {}
    }
}
