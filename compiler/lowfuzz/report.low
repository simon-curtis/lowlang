import std/file
import std/io
import std/maps
import std/sync

enum SaveError {
    Create(dir: str, error: io.Error)
    Write(path: str, error: io.Error)
}

fn save_message(e: SaveError) -> str {
    match e {
        Create(dir, error) => "create {dir}: {error}"
        Write(path, error) => "write {path}: {error}"
    }
}

struct Report {
    mu: sync.Mutex
    dir: str
    cases: i64
    skipped: i64
    seen: [str: i64]
    stems: [str: i64]
}

fn new_report(dir: str) -> *Report {
    let mu = sync.mutex()
    new(Report { mu, dir, cases: 0, skipped: 0, seen: [:], stems: [:] })
}

fn case_ran(r: *Report) {
    sync.lock(r.mu)
    r.cases += 1
    sync.unlock(r.mu)
}

fn case_skipped(r: *Report) {
    sync.lock(r.mu)
    r.skipped += 1
    sync.unlock(r.mu)
}

fn claim(r: *Report, signature: str) -> bool {
    sync.lock(r.mu)
    let count = (r.seen[signature] ?? 0) + 1
    r.seen[signature] = count
    sync.unlock(r.mu)
    count == 1
}

fn announce(r: *Report, message: str) {
    sync.lock(r.mu)
    print(message)
    sync.unlock(r.mu)
}

struct Found {
    seed: i64
    class: str
    detail: str
    original: str
    reduced: str
}

fn unique_stem(r: *Report, stem: str) -> str {
    sync.lock(r.mu)
    let count = (r.stems[stem] ?? 0) + 1
    r.stems[stem] = count
    sync.unlock(r.mu)
    if count == 1 {
        return stem
    }
    "{stem}-{count}"
}

fn save(r: *Report, found: Found) -> str ! SaveError {
    file.mkdir_all(r.dir) catch {
        e => fail Create(r.dir, e)
    }
    let stem = unique_stem(r, "{found.class}-{found.seed}")
    let path = file.child_path(r.dir, "{stem}.low")
    write_file(path, found.reduced)?
    write_file(file.child_path(r.dir, "{stem}.txt"), "{found.detail}\n")?
    if found.original != found.reduced {
        write_file(file.child_path(r.dir, "{stem}.full.low"), found.original)?
    }
    path
}

fn write_file(path: str, content: str) ! SaveError {
    file.write_text(path, content) catch {
        e => fail Write(path, e)
    }
}

fn summary(r: *Report) {
    sync.lock(r.mu)
    print("{r.cases} cases, {r.skipped} skipped, {r.seen.len} distinct findings")
    for signature in maps.sorted_keys(r.seen) {
        let count = r.seen[signature] ?? 0
        print("  {count,4}  {signature}")
    }
    sync.unlock(r.mu)
}

fn failed(r: *Report) -> bool {
    sync.lock(r.mu)
    let any = r.seen.len > 0
    sync.unlock(r.mu)
    any
}
