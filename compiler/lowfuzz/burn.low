import std/os
import std/process
import signals = std/os/signal

fn burn(parent: i64) {
    var spins = 0
    for os.ppid() == parent {
        for _ in 0..50000000 {
            spins += 1
        }
    }
    os.exit(0)
}

fn start_burners(executable: str, count: i64) -> []*process.ChildHandle {
    var handles: []*process.ChildHandle = []
    for _ in 0..count {
        let command = process.Command {
            program: executable
            args: ["__burn"]
            stdin: process.Stdio.Null
            stdout: process.Stdio.Null
            stderr: process.Stdio.Null
        }
        let handle = process.start_handle(command) or continue
        push(mut handles, handle)
    }
    handles
}

fn stop_burners(handles: []*process.ChildHandle) {
    for handle in handles {
        process.kill_on(handle, signals.Signal.Kill) or {}
        process.wait_exit_on(handle) or {}
    }
}
