import ir

const panic_status = 2
const error_status = 1
const float_two_63: i64 = 0x43E0000000000000
const float_minus_two_63: i64 = -4332462841530417152
const low_word: i64 = 0xffffffff

fn helper(g: *Generator, params: i64, results: i64, locals: i64, c: *Code) -> i64 {
    let type = signature(g.m, words(params), words(results))
    let body = Body { type, locals: words(locals), code: c.finish() }
    define(g.m, body)
}

fn define_helpers(g: *Generator) {
    g.helpers.die = g.define_die()
    g.helpers.panic_msg = g.define_failure(g.string_address("panic: "), panic_status)
    g.helpers.error = g.define_failure(g.string_address("error: "), error_status)
    g.helpers.panic_index = g.define_panic("index out of range")
    g.helpers.panic_divzero = g.define_panic("integer divide by zero")
    g.helpers.panic_stack = g.define_panic("stack overflow")
    g.helpers.print_str = g.define_print_str()
    g.helpers.memmove = g.define_memmove()
    g.helpers.str_eq = g.define_str_eq()
    g.helpers.mulhi_u = g.define_mulhi_u()
    g.helpers.mulhi_s = g.define_mulhi_s()
    g.helpers.f2i = g.define_f2i()
    g.helpers.f2u = g.define_f2u()
}

fn write_pair(g: *Generator, c: *Code, fd: i64, ptr: i64, len: i64) {
    c.i32_const(fd)
    c.local_get(ptr)
    c.address()
    c.local_get(len)
    c.length()
    c.call(g.host.write)
}

fn write_newline(g: *Generator, c: *Code, fd: i64) {
    c.i32_const(fd)
    c.i32_const(g.string_address("\n") - address_bias)
    c.i32_const(1)
    c.call(g.host.write)
}

fn define_die(g: *Generator) -> i64 {
    let c = new_code()
    g.write_pair(c, 2, 0, 1)
    g.write_pair(c, 2, 2, 3)
    g.write_newline(c, 2)
    c.local_get(4)
    c.length()
    c.call(g.host.exit)
    c.op(op_unreachable)
    g.helper(5, 0, 0, c)
}

fn define_failure(g: *Generator, prefix: i64, status: i64) -> i64 {
    let c = new_code()
    c.i64_const(prefix)
    c.i64_const(7)
    c.local_get(0)
    c.local_get(1)
    c.i64_const(status)
    c.call(g.helpers.die)
    g.helper(2, 0, 0, c)
}

fn define_panic(g: *Generator, msg: str) -> i64 {
    let c = new_code()
    c.i64_const(g.string_address(msg))
    c.i64_const(msg.len)
    c.call(g.helpers.panic_msg)
    g.helper(0, 0, 0, c)
}

fn define_print_str(g: *Generator) -> i64 {
    let c = new_code()
    g.write_pair(c, 1, 0, 1)
    g.write_newline(c, 1)
    g.helper(2, 0, 0, c)
}

fn define_memmove(g: *Generator) -> i64 {
    let c = new_code()
    c.local_get(2)
    c.op(op_i64_eqz)
    c.open(op_if)
    c.op(op_return)
    c.op(op_end)
    c.local_get(0)
    c.address()
    c.local_get(1)
    c.address()
    c.local_get(2)
    c.length()
    c.memory_copy()
    g.helper(3, 0, 0, c)
}

fn define_str_eq(g: *Generator) -> i64 {
    let a = 0
    let a_len = 1
    let b = 2
    let b_len = 3
    let at = 4
    let c = new_code()
    c.local_get(a_len)
    c.local_get(b_len)
    c.op(op_i64_ne)
    c.open(op_if)
    c.i64_const(0)
    c.op(op_return)
    c.op(op_end)
    c.open(op_block)
    c.open(op_loop)
    c.local_get(at)
    c.local_get(a_len)
    c.op(op_i64_ge_u)
    c.index_op(op_br_if, 1)
    c.local_get(a)
    c.local_get(at)
    c.op(op_i64_add)
    c.address()
    c.memory(op_i64_load8_u, 0)
    c.local_get(b)
    c.local_get(at)
    c.op(op_i64_add)
    c.address()
    c.memory(op_i64_load8_u, 0)
    c.op(op_i64_ne)
    c.open(op_if)
    c.i64_const(0)
    c.op(op_return)
    c.op(op_end)
    c.local_get(at)
    c.i64_const(1)
    c.op(op_i64_add)
    c.local_set(at)
    c.br(0)
    c.op(op_end)
    c.op(op_end)
    c.i64_const(1)
    g.helper(4, 1, 1, c)
}

fn half(c: *Code, value: i64, high: bool) {
    c.local_get(value)
    if high {
        c.i64_const(32)
        c.op(op_i64_shr_u)
    } else {
        c.i64_const(low_word)
        c.op(op_i64_and)
    }
}

fn product(c: *Code, x: i64, x_high: bool, y: i64, y_high: bool) {
    half(c, x, x_high)
    half(c, y, y_high)
    c.op(op_i64_mul)
}

fn define_mulhi_u(g: *Generator) -> i64 {
    let a = 0
    let b = 1
    let cross_ab = 2
    let cross_ba = 3
    let c = new_code()
    product(c, a, false, b, true)
    c.local_set(cross_ab)
    product(c, a, true, b, false)
    c.local_set(cross_ba)
    product(c, a, true, b, true)
    half(c, cross_ab, true)
    c.op(op_i64_add)
    half(c, cross_ba, true)
    c.op(op_i64_add)
    product(c, a, false, b, false)
    c.i64_const(32)
    c.op(op_i64_shr_u)
    half(c, cross_ab, false)
    c.op(op_i64_add)
    half(c, cross_ba, false)
    c.op(op_i64_add)
    c.i64_const(32)
    c.op(op_i64_shr_u)
    c.op(op_i64_add)
    g.helper(2, 1, 2, c)
}

fn define_mulhi_s(g: *Generator) -> i64 {
    let c = new_code()
    c.local_get(0)
    c.local_get(1)
    c.call(g.helpers.mulhi_u)
    c.local_get(1)
    c.local_get(0)
    c.i64_const(63)
    c.op(op_i64_shr_s)
    c.op(op_i64_and)
    c.op(op_i64_sub)
    c.local_get(0)
    c.local_get(1)
    c.i64_const(63)
    c.op(op_i64_shr_s)
    c.op(op_i64_and)
    c.op(op_i64_sub)
    g.helper(2, 1, 0, c)
}

fn float_helper(g: *Generator, c: *Code) -> i64 {
    let type = signature(g.m, [f64_type], [i64_type])
    let body = Body { type, code: c.finish() }
    define(g.m, body)
}

fn define_f2i(g: *Generator) -> i64 {
    let c = new_code()
    c.local_get(0)
    c.f64_const(float_minus_two_63)
    c.op(op_f64_ge)
    c.local_get(0)
    c.f64_const(float_two_63)
    c.op(op_f64_lt)
    c.op(op_i32_and)
    c.open_typed(op_if, i64_type)
    c.local_get(0)
    c.op(op_i64_trunc_f64_s)
    c.op(op_else)
    c.i64_const(ir.min_i64)
    c.op(op_end)
    g.float_helper(c)
}

fn define_f2u(g: *Generator) -> i64 {
    let c = new_code()
    c.local_get(0)
    c.f64_const(float_two_63)
    c.op(op_f64_ge)
    c.open_typed(op_if, i64_type)
    c.local_get(0)
    c.f64_const(float_two_63)
    c.op(op_f64_sub)
    c.call(g.helpers.f2i)
    c.i64_const(ir.min_i64)
    c.op(op_i64_xor)
    c.op(op_else)
    c.local_get(0)
    c.call(g.helpers.f2i)
    c.op(op_end)
    g.float_helper(c)
}
