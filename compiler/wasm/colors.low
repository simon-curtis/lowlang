import ir

struct Use {
    block: i64
    phi: bool
}

struct Colors {
    def_block: []i64
    uses: [][]Use
    live_in: [][]i64
    live_out: [][]i64
    in_mark: []i64
    out_mark: []i64
    color: []i64
    used: []bool = []
    last: []i64
    dying: []i64
}

fn filled(n: i64, value: i64) -> []i64 {
    var out: []i64 = []
    for _ in 0..n {
        push(mut out, value)
    }
    out
}

fn empty_lists(n: i64) -> [][]i64 {
    var out: [][]i64 = []
    for _ in 0..n {
        push(mut out, [])
    }
    out
}

fn colored(v: *ir.Value) -> bool {
    ir.has_result(v.op) && v.op != OpParam
}

fn color_values(l: *Lowering) -> i64 {
    let values = l.locals.len
    let blocks = l.dom.nodes.len
    var uses: [][]Use = []
    for _ in 0..values {
        push(mut uses, [])
    }
    let k = new(Colors {
        def_block: filled(values, -1)
        uses
        live_in: empty_lists(blocks)
        live_out: empty_lists(blocks)
        in_mark: filled(blocks, -1)
        out_mark: filled(blocks, -1)
        color: filled(values, -1)
        last: filled(values, -1)
        dying: filled(values, -1)
    })
    k.collect_uses(l)
    for id in 0..values {
        if k.def_block[id] >= 0 {
            k.propagate(l, id)
        }
    }
    let order = preorder(l.dom)
    for node in order {
        k.color_block(l, node)
    }
    for id, c in k.color {
        if c >= 0 {
            l.locals[id] = l.f.param_words + c
        }
    }
    k.used.len
}

fn add_use(k: *Colors, a: *ir.Value, block: i64, phi: bool) {
    if !colored(a) {
        return
    }
    var list = k.uses[a.id]
    push(mut list, Use { block, phi })
    k.uses[a.id] = list
}

fn collect_uses(k: *Colors, l: *Lowering) {
    for node, b in l.dom.nodes {
        for v in b.values {
            if colored(v) {
                k.def_block[v.id] = node
            }
            if v.op == OpPhi {
                for j, a in v.args {
                    let pred = l.rpo(b.preds[j])
                    if pred >= 0 {
                        k.add_use(a, pred, true)
                    }
                }
                continue
            }
            for a in v.args {
                k.add_use(a, node, false)
            }
        }
        for r in end_uses(b) {
            k.add_use(r, node, false)
        }
    }
}

fn end_uses(b: *ir.Block) -> []*ir.Value {
    match b.control {
        some(c) => return [c]
        none => {}
    }
    b.results
}

fn propagate(k: *Colors, l: *Lowering, id: i64) {
    let home = k.def_block[id]
    var work: []i64 = []
    for u in k.uses[id] {
        if u.phi {
            k.mark_out(u.block, id)
            if u.block != home {
                k.mark_in(u.block, id, mut work)
            }
        } else if u.block != home {
            k.mark_in(u.block, id, mut work)
        }
    }
    for work.len > 0 {
        let node = work[work.len - 1]
        truncate(mut work, work.len - 1)
        for p in l.dom.nodes[node].preds {
            let pred = l.rpo(p)
            if pred < 0 {
                continue
            }
            k.mark_out(pred, id)
            if pred != home {
                k.mark_in(pred, id, mut work)
            }
        }
    }
}

fn mark_out(k: *Colors, node: i64, id: i64) {
    if k.out_mark[node] == id {
        return
    }
    k.out_mark[node] = id
    var list = k.live_out[node]
    push(mut list, id)
    k.live_out[node] = list
}

fn mark_in(k: *Colors, node: i64, id: i64, mut work: []i64) {
    if k.in_mark[node] == id {
        return
    }
    k.in_mark[node] = id
    var list = k.live_in[node]
    push(mut list, id)
    k.live_in[node] = list
    push(mut work, node)
}

fn preorder(d: *ir.Dominators) -> []i64 {
    var order: []i64 = []
    var stack: []i64 = [0]
    for stack.len > 0 {
        let node = stack[stack.len - 1]
        truncate(mut stack, stack.len - 1)
        push(mut order, node)
        let children = d.children[node]
        var at = children.len - 1
        for at >= 0 {
            push(mut stack, children[at])
            at -= 1
        }
    }
    order
}

fn take(k: *Colors) -> i64 {
    for i, busy in k.used {
        if !busy {
            k.used[i] = true
            return i
        }
    }
    push(mut k.used, true)
    k.used.len - 1
}

fn release(k: *Colors, id: i64) {
    let c = k.color[id]
    if c >= 0 {
        k.used[c] = false
    }
}

fn color_block(k: *Colors, l: *Lowering, node: i64) {
    for i in 0..k.used.len {
        k.used[i] = false
    }
    for id in k.live_in[node] {
        k.used[k.color[id]] = true
    }
    for id in k.live_out[node] {
        k.dying[id] = node
    }
    let b = l.dom.nodes[node]
    let end = b.values.len
    for i, v in b.values {
        if v.op == OpPhi {
            continue
        }
        for a in v.args {
            k.last[a.id] = i
        }
    }
    for r in end_uses(b) {
        k.last[r.id] = end
    }
    for i, v in b.values {
        if v.op == OpPhi {
            k.color[v.id] = k.take()
            continue
        }
        if v.op == OpResult {
            continue
        }
        for a in v.args {
            if k.dies(a, node, i) {
                k.release(a.id)
            }
        }
        if ir.is_call(v.op) {
            k.color_results(l, v, node, i)
        } else if colored(v) {
            k.color[v.id] = k.take()
            if k.dies(v, node, i) {
                k.release(v.id)
            }
        }
    }
}

fn dies(k: *Colors, v: *ir.Value, node: i64, at: i64) -> bool {
    colored(v) && k.dying[v.id] != node && k.last[v.id] <= at
}

fn color_results(k: *Colors, l: *Lowering, call: *ir.Value, node: i64, at: i64) {
    let results = l.results[call.id] ?? []
    for r in results {
        k.color[r.id] = k.take()
    }
    for r in results {
        if k.dies(r, node, at) {
            k.release(r.id)
        }
    }
}
