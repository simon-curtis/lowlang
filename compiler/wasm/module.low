import std/builder

pub const i32_type: u8 = 0x7f
pub const i64_type: u8 = 0x7e
pub const f32_type: u8 = 0x7d
pub const f64_type: u8 = 0x7c

const funcref_type: u8 = 0x70
const func_form: u8 = 0x60
const page_size = 65536

const section_type: u8 = 1
const section_import: u8 = 2
const section_function: u8 = 3
const section_table: u8 = 4
const section_memory: u8 = 5
const section_global: u8 = 6
const section_export: u8 = 7
const section_element: u8 = 9
const section_code: u8 = 10
const section_data: u8 = 11

const kind_func: u8 = 0
const kind_memory: u8 = 2

pub struct Signature {
    pub params: []u8
    pub results: []u8
}

struct Import {
    module: str
    name: str
    type: i64
}

pub struct Body {
    pub type: i64
    pub locals: []u8 = []
    pub code: []u8 = []
}

struct Export {
    name: str
    kind: u8
    index: i64
}

pub struct Module {
    types: []Signature = []
    type_index: [str: i64] = [:]
    imports: []Import = []
    bodies: []Body = []
    globals: []i64 = []
    exports: []Export = []
    pub table: []i64 = []
    pub data: []u8 = []
    pub data_offset: i64 = 0
    pub memory_bytes: i64 = 0
}

pub fn new_module() -> *Module {
    new(Module {})
}

fn signature_key(s: Signature) -> str {
    var out = builder.builder()
    out.write_bytes(s.params)
    out.write_byte('>')
    out.write_bytes(s.results)
    out.to_str()
}

pub fn signature(m: *Module, params: []u8, results: []u8) -> i64 {
    let s = Signature { params, results }
    let key = signature_key(s)
    match m.type_index[key] {
        some(index) => return index
        none => {}
    }
    let index = m.types.len
    push(mut m.types, s)
    m.type_index[key] = index
    index
}

pub fn words(n: i64) -> []u8 {
    var out: []u8 = []
    for _ in 0..n {
        push(mut out, i64_type)
    }
    out
}

pub fn import_func(m: *Module, module: str, name: str, type: i64) -> i64 {
    if m.bodies.len > 0 {
        panic("wasm: import {module}.{name} after a function body")
    }
    push(mut m.imports, Import { module, name, type })
    m.imports.len - 1
}

pub fn next_func(m: *Module) -> i64 {
    m.imports.len + m.bodies.len
}

pub fn define(m: *Module, body: Body) -> i64 {
    let index = next_func(m)
    push(mut m.bodies, body)
    index
}

pub fn replace(m: *Module, index: i64, body: Body) {
    m.bodies[index - m.imports.len] = body
}

pub fn global(m: *Module, init: i64) -> i64 {
    push(mut m.globals, init)
    m.globals.len - 1
}

pub fn export_function(m: *Module, name: str, index: i64) {
    push(mut m.exports, Export { name, kind: kind_func, index })
}

pub fn export_memory(m: *Module, name: str) {
    push(mut m.exports, Export { name, kind: kind_memory, index: 0 })
}

pub fn table_slot(m: *Module, func: i64) -> i64 {
    push(mut m.table, func)
    m.table.len
}

pub fn uleb(mut out: builder.Builder, n: u64) {
    var rest = n
    for {
        let low = u8(rest & 0x7f)
        rest = rest >> 7
        if rest == 0 {
            out.write_byte(low)
            return
        }
        out.write_byte(low | 0x80)
    }
}

pub fn sleb(mut out: builder.Builder, n: i64) {
    var rest = n
    for {
        let low = u8(rest & 0x7f)
        rest = rest >> 7
        let sign = (low & 0x40) != 0
        if (rest == 0 && !sign) || (rest == -1 && sign) {
            out.write_byte(low)
            return
        }
        out.write_byte(low | 0x80)
    }
}

fn name(mut out: builder.Builder, s: str) {
    uleb(mut out, u64(s.len))
    out.write(s)
}

fn valtypes(mut out: builder.Builder, list: []u8) {
    uleb(mut out, u64(list.len))
    out.write_bytes(list)
}

fn section(mut out: builder.Builder, id: u8, payload: builder.Builder) {
    out.write_byte(id)
    uleb(mut out, u64(payload.len()))
    out.write_bytes(payload.to_bytes())
}

pub fn encode(m: *Module) -> []u8 {
    var out = builder.builder()
    out.write_bytes([0, 'a', 's', 'm', 1, 0, 0, 0])
    section(mut out, section_type, m.type_section())
    section(mut out, section_import, m.import_section())
    section(mut out, section_function, m.function_section())
    section(mut out, section_table, m.table_section())
    section(mut out, section_memory, m.memory_section())
    section(mut out, section_global, m.global_section())
    section(mut out, section_export, m.export_section())
    section(mut out, section_element, m.element_section())
    section(mut out, section_code, m.code_section())
    section(mut out, section_data, m.data_section())
    out.to_bytes()
}

fn type_section(m: *Module) -> builder.Builder {
    var out = builder.builder()
    uleb(mut out, u64(m.types.len))
    for s in m.types {
        out.write_byte(func_form)
        valtypes(mut out, s.params)
        valtypes(mut out, s.results)
    }
    out
}

fn import_section(m: *Module) -> builder.Builder {
    var out = builder.builder()
    uleb(mut out, u64(m.imports.len))
    for i in m.imports {
        name(mut out, i.module)
        name(mut out, i.name)
        out.write_byte(kind_func)
        uleb(mut out, u64(i.type))
    }
    out
}

fn function_section(m: *Module) -> builder.Builder {
    var out = builder.builder()
    uleb(mut out, u64(m.bodies.len))
    for b in m.bodies {
        uleb(mut out, u64(b.type))
    }
    out
}

fn table_section(m: *Module) -> builder.Builder {
    var out = builder.builder()
    uleb(mut out, 1)
    out.write_byte(funcref_type)
    out.write_byte(0)
    uleb(mut out, u64(m.table.len + 1))
    out
}

fn memory_section(m: *Module) -> builder.Builder {
    var out = builder.builder()
    uleb(mut out, 1)
    out.write_byte(0)
    uleb(mut out, u64((m.memory_bytes + page_size - 1) / page_size))
    out
}

fn global_section(m: *Module) -> builder.Builder {
    var out = builder.builder()
    uleb(mut out, u64(m.globals.len))
    for init in m.globals {
        out.write_byte(i64_type)
        out.write_byte(1)
        out.write_byte(op_i64_const)
        sleb(mut out, init)
        out.write_byte(op_end)
    }
    out
}

fn export_section(m: *Module) -> builder.Builder {
    var out = builder.builder()
    uleb(mut out, u64(m.exports.len))
    for e in m.exports {
        name(mut out, e.name)
        out.write_byte(e.kind)
        uleb(mut out, u64(e.index))
    }
    out
}

fn element_section(m: *Module) -> builder.Builder {
    var out = builder.builder()
    uleb(mut out, 1)
    out.write_byte(0)
    out.write_byte(op_i32_const)
    sleb(mut out, 1)
    out.write_byte(op_end)
    uleb(mut out, u64(m.table.len))
    for f in m.table {
        uleb(mut out, u64(f))
    }
    out
}

fn code_section(m: *Module) -> builder.Builder {
    var out = builder.builder()
    uleb(mut out, u64(m.bodies.len))
    for b in m.bodies {
        let encoded = encode_body(b)
        uleb(mut out, u64(encoded.len()))
        out.write_bytes(encoded.to_bytes())
    }
    out
}

fn encode_body(b: Body) -> builder.Builder {
    var runs = builder.builder()
    var count = 0
    var at = 0
    for at < b.locals.len {
        var end = at
        for end < b.locals.len && b.locals[end] == b.locals[at] {
            end += 1
        }
        uleb(mut runs, u64(end - at))
        runs.write_byte(b.locals[at])
        count += 1
        at = end
    }
    var out = builder.builder()
    uleb(mut out, u64(count))
    out.write_bytes(runs.to_bytes())
    out.write_bytes(b.code)
    out
}

fn data_section(m: *Module) -> builder.Builder {
    var out = builder.builder()
    uleb(mut out, 1)
    out.write_byte(0)
    out.write_byte(op_i32_const)
    sleb(mut out, m.data_offset)
    out.write_byte(op_end)
    uleb(mut out, u64(m.data.len))
    out.write_bytes(m.data)
    out
}
