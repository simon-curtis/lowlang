import std/file
import std/io
import std/text
import std/time/duration

pub const stdout_ext = ".out"
pub const stderr_ext = ".err"
pub const max_rss_ext = ".maxrss"
pub const max_time_ext = ".maxtime"
pub const libraries_ext = ".needed"
pub const tags_ext = ".tags"
pub const warnings_ext = ".warn"
pub const target_ext = ".target"
pub const compile_error_ext = ".err"
pub const source_ext = ".low"

const tag_simd = "simd"
const tag_linux_only = "linux-only"
const tag_alone = "alone"

pub enum Error {
    Io(path: str, error: io.Error)
    Invalid(message: str)
}

pub fn message(e: Error) -> str {
    match e {
        Io(path, error) => "{path}: {error}"
        Invalid(text) => text
    }
}

pub struct Sidecars {
    pub stdout: str = ""
    pub stderr: str = ""
    pub panics: bool = false
    pub max_rss_kb: i64 = 0
    pub max_time_ns: i64 = 0
    pub libraries: []str = []
    pub simd: bool = false
    pub linux_only: bool = false
    pub alone: bool = false
}

pub struct Sidecar {
    pub content: str
    pub present: bool
}

struct Wanted {
    ext: str
    content: str
    wanted: bool
}

pub fn base(path: str) -> str {
    text.trim_suffix(path, source_ext)
}

pub const browser_page_limit_variable = "LOW_WASM_MAX_PAGES"

const browser_page_kb = 64

fn lazily_committed(name: str) -> bool {
    name == "heap_lazy_zero" || name == "region_reuse" || name == "rt_heap_release" || name == "ssa_fill_memory"
}

pub fn browser_page_environment(name: str, s: Sidecars) -> [str: str] {
    if s.max_rss_kb == 0 || lazily_committed(name) {
        return [:]
    }
    let pages = s.max_rss_kb / browser_page_kb
    [browser_page_limit_variable: "{pages}"]
}

pub fn windows(s: Sidecars) -> bool {
    !s.linux_only && s.libraries.len == 0
}

pub fn read_sidecar(path: str, ext: str) -> Sidecar ! Error {
    let sidecar_path = "{base(path)}{ext}"
    let content = file.read_text(sidecar_path) catch {
        NotFound => return Sidecar { content: "", present: false }
        e => fail Io(sidecar_path, e)
    }
    Sidecar { content, present: true }
}

pub fn read_target(path: str, fallback: str) -> str ! Error {
    let sidecar = read_sidecar(path, target_ext)?
    if !sidecar.present {
        return fallback
    }
    let name = text.trim(sidecar.content)
    if name == "" {
        fail Invalid("{base(path)}{target_ext}: empty target")
    }
    name
}

pub fn read(path: str) -> Sidecars ! Error {
    let stdout = read_sidecar(path, stdout_ext)?
    let stderr = read_sidecar(path, stderr_ext)?
    var s = Sidecars { stdout: stdout.content, stderr: stderr.content, panics: stderr.present }
    read_max_rss(path, mut s)?
    read_max_time(path, mut s)?
    read_libraries(path, mut s)?
    read_tags(path, mut s)?
    s
}

fn read_max_rss(path: str, mut s: Sidecars) ! Error {
    let sidecar = read_sidecar(path, max_rss_ext)?
    if !sidecar.present {
        return
    }
    let trimmed = text.trim(sidecar.content)
    s.max_rss_kb = text.parse_int(trimmed) or fail Invalid("{base(path)}{max_rss_ext}: invalid number {text.quote(trimmed)}")
}

fn read_max_time(path: str, mut s: Sidecars) ! Error {
    let sidecar = read_sidecar(path, max_time_ext)?
    if !sidecar.present {
        return
    }
    let trimmed = text.trim(sidecar.content)
    let limit = duration.parse(trimmed) or fail Invalid("{base(path)}{max_time_ext}: invalid duration {text.quote(trimmed)}")
    s.max_time_ns = duration.saturating_nanos(limit)
}

fn read_libraries(path: str, mut s: Sidecars) ! Error {
    let sidecar = read_sidecar(path, libraries_ext)?
    if !sidecar.present {
        return
    }
    s.libraries = text.fields(sidecar.content)
}

fn read_tags(path: str, mut s: Sidecars) ! Error {
    let sidecar = read_sidecar(path, tags_ext)?
    if !sidecar.present {
        return
    }
    for tag in text.fields(sidecar.content) {
        match tag {
            tag_simd => {
                s.simd = true
            }
            tag_linux_only => {
                s.linux_only = true
            }
            tag_alone => {
                s.alone = true
            }
            _ => fail Invalid("{base(path)}{tags_ext}: unknown tag {text.quote(tag)}")
        }
    }
}

pub fn write(s: Sidecars, path: str) ! Error {
    let stem = base(path)
    for item in wanted_files(s) {
        if !item.wanted {
            continue
        }
        let target = "{stem}{item.ext}"
        file.write_text(target, item.content) catch {
            e => fail Io(target, e)
        }
    }
}

fn wanted_files(s: Sidecars) -> []Wanted {
    let libraries = text.join(s.libraries, "\n")
    [
        Wanted { ext: stdout_ext, content: s.stdout, wanted: s.stdout != "" }
        Wanted { ext: stderr_ext, content: s.stderr, wanted: s.panics }
        Wanted { ext: max_rss_ext, content: "{s.max_rss_kb}\n", wanted: s.max_rss_kb > 0 }
        Wanted { ext: max_time_ext, content: "{duration_text(s.max_time_ns)}\n", wanted: s.max_time_ns > 0 }
        Wanted { ext: libraries_ext, content: "{libraries}\n", wanted: s.libraries.len > 0 }
        Wanted { ext: tags_ext, content: tag_lines(s), wanted: s.simd || s.linux_only || s.alone }
    ]
}

fn tag_lines(s: Sidecars) -> str {
    var tags: []str = []
    if s.simd {
        push(mut tags, tag_simd)
    }
    if s.linux_only {
        push(mut tags, tag_linux_only)
    }
    if s.alone {
        push(mut tags, tag_alone)
    }
    let joined = text.join(tags, "\n")
    "{joined}\n"
}

pub fn duration_text(ns: i64) -> str {
    if ns == 0 {
        return "0s"
    }
    if ns < 1000 {
        return "{ns}ns"
    }
    if ns < 1000000 {
        return "{scaled(ns, 1000)}µs"
    }
    if ns < 1000000000 {
        return "{scaled(ns, 1000000)}ms"
    }
    let seconds = scaled(ns % 60000000000, 1000000000)
    let whole_minutes = ns / 60000000000
    if whole_minutes == 0 {
        return "{seconds}s"
    }
    let minutes = whole_minutes % 60
    let hours = whole_minutes / 60
    if hours == 0 {
        return "{minutes}m{seconds}s"
    }
    "{hours}h{minutes}m{seconds}s"
}

fn scaled(value: i64, unit: i64) -> str {
    let whole = value / unit
    var fraction = value % unit
    if fraction == 0 {
        return "{whole}"
    }
    var digits = ""
    var scale = unit / 10
    for scale > 0 && fraction > 0 {
        digits = "{digits}{fraction / scale}"
        fraction %= scale
        scale /= 10
    }
    "{whole}.{digits}"
}
