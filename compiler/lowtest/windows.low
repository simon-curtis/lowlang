import fixture
fn require_windows_host(count: i64) ! Fault {
    if !windows_host {
        fail Skipped("runs Windows binaries, which need a Windows host", count)
    }
}

fn check_windows(ctx: Context, program: Program, sidecars: fixture.Sidecars, scratch: str) -> []str {
    let binary = "{scratch}/main.exe"
    build_binary(ctx.low, program.path, binary, windows_target, sidecars) catch {
        f => return [describe(f)]
    }
    let invocation = Invocation { program: binary, args: [] }
    let got = execute(invocation) catch {
        e => return [describe(Fault.Io(binary, e))]
    }
    var problems = compare_run(sidecars, got, "")
    append_all(mut problems, check_limits(sidecars, got, ""))
    if sidecars.stderr != "" && got.stderr == "" {
        problems.push(rerun_note(binary))
    }
    problems
}

fn rerun_note(binary: str) -> str {
    let again = execute(Invocation { program: binary, args: [] }) catch {
        e => return "rerun failed: {e}"
    }
    "rerun: {describe_exit(again.exit)}, stderr {again.stderr.len} bytes"
}
