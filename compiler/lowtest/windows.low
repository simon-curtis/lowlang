import fixture
fn require_windows_host(count: i64) ! Fault {
    if !windows_host {
        fail Skipped("runs Windows binaries, which need a Windows host", count)
    }
}

fn check_windows(ctx: Context, program: Program, sidecars: fixture.Sidecars, scratch: str) -> []str {
    let binary = "{scratch}/main.exe"
    build_binary(ctx.low, program.path, binary, windows_target) catch {
        f => return [describe(f)]
    }
    let invocation = Invocation { program: binary, args: [] }
    let got = execute(invocation) catch {
        e => return [describe(Fault.Io(binary, e))]
    }
    compare_run(sidecars, got, "")
}
