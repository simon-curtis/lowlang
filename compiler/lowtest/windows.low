import std/process
import std/text
import builders = std/builder

const wine_diagnostic = "wine client error:"

struct Launcher {
    program: str
    extra_env: [str: str]
    wine: bool
}

fn windows_launcher() -> Launcher ! Fault {
    if windows_host {
        return Launcher { program: "", extra_env: [:], wine: false }
    }
    let wine = process.find("wine") ?? fail Unavailable("wine is not installed", 0)
    let environment = ["WINEDEBUG": "-all", "DISPLAY": "", "WAYLAND_DISPLAY": ""]
    start_wine_server(environment)
    let boot = Invocation { program: wine, args: ["wineboot", "--init"], extra_env: environment, limit_ms: compile_limit_ms }
    let initialised = execute(boot) catch {
        e => fail Io(wine, e)
    }
    if !process.success(initialised.exit) {
        let exit = describe_exit(initialised.exit)
        let output = excerpt(text.trim(initialised.stderr))
        fail Invalid("initialise the wine prefix ({exit}): {output}")
    }
    Launcher { program: wine, extra_env: environment, wine: true }
}

fn start_wine_server(environment: [str: str]) {
    let started = run_detached("wineserver", ["--persistent=60"], environment) or process.Exit.Exited(0)
}

fn launch(launcher: Launcher, binary: str) -> Captured ! Fault {
    let invocation = if launcher.wine {
        Invocation { program: launcher.program, args: [binary], extra_env: launcher.extra_env }
    } else {
        Invocation { program: binary, args: [] }
    }
    let result = execute(invocation) catch {
        e => fail Io(binary, e)
    }
    if !launcher.wine {
        return result
    }
    let program_stderr = without_wine_diagnostics(result.stderr)
    Captured {
        exit: result.exit
        stdout: result.stdout
        stderr: program_stderr
        elapsed_ns: result.elapsed_ns
        peak_kb: result.peak_kb
        timed_out: result.timed_out
    }
}

fn without_wine_diagnostics(stderr: str) -> str {
    var kept = builders.builder()
    var rest = stderr
    for rest.len > 0 {
        let newline = text.index_byte(rest, '\n')
        let stop = if newline < 0 { rest.len } else { newline + 1 }
        let line = rest[..stop]
        if !text.starts_with(line, wine_diagnostic) {
            builders.write(mut kept, line)
        }
        rest = rest[stop..]
    }
    builders.to_str(kept)
}

fn check_windows(ctx: Context, launcher: Launcher, program: Program, sidecars: Sidecars, scratch: str) -> []str {
    let binary = "{scratch}/main.exe"
    build_binary(ctx.low, program.path, binary, windows_target) catch {
        f => return [describe(f)]
    }
    let got = launch(launcher, binary) catch {
        f => return [describe(f)]
    }
    compare_run(sidecars, got, "")
}
