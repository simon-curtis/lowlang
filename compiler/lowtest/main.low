import std/file
import std/flag
import std/io
import std/os
import std/process
import std/slices

const usage = "usage: lowtest <path-to-low-binary> [run|examples|fail|lint|windows|browser]... [-filter substring]"

enum Error {
    Usage
    Flag(flag.Error)
    UnknownSuite(name: str)
    NoCompiler(path: str)
    Scratch(io.Error)
}

fn main() {
    let failed = run(os.args()[1..]) catch {
        e => report(e)
    }
    if failed {
        os.exit(1)
    }
}

fn report(e: Error) -> bool {
    match e {
        Usage => print(usage)
        Flag(inner) => print("{describe_flag(inner)}\n{usage}")
        UnknownSuite(name) => print("unknown suite {name}\n{usage}")
        NoCompiler(path) => print("{path}: no such executable")
        Scratch(inner) => print("create the scratch directory: {inner}")
    }
    true
}

fn describe_flag(e: flag.Error) -> str {
    match e {
        Unknown(name) => "unknown flag {name}"
        Missing(name) => "flag {name} needs a value"
        Invalid(name, value) => "invalid value {value} for flag {name}"
    }
}

fn run(args: []str) -> bool ! Error {
    let specs = [flag.Spec { name: "filter", help: "run only programs whose suite/name contains this text" }]
    let parsed = flag.parse(specs, args) catch Flag
    if parsed.rest.len == 0 {
        fail Usage
    }
    let low = parsed.rest[0]
    if process.find(low) == none {
        fail NoCompiler(low)
    }
    let wanted = parsed.rest[1..]
    for name in wanted {
        if !slices.contains(suite_names(), name) {
            fail UnknownSuite(name)
        }
    }
    let root = os.getcwd() catch {
        e => fail Scratch(e)
    }
    let work = file.temp_dir("lowtest-") catch {
        e => fail Scratch(e)
    }
    defer file.remove_all(work) or {}
    let ctx = Context { low, root, work, filter: flag.get(parsed, "filter") }
    run_suites(ctx, wanted)
}

fn run_suites(ctx: Context, wanted: []str) -> bool {
    var failed = false
    for suite in suite_names() {
        if wanted.len > 0 && !slices.contains(wanted, suite) {
            continue
        }
        let tally = run_suite(ctx, suite)
        var line = "{suite}: {tally.passed} passed, {tally.failed} failed, {tally.skipped} skipped"
        if tally.unsupported > 0 {
            line = "{line}, {tally.unsupported} unsupported by the back end"
        }
        print(line)
        if tally.failed > 0 {
            failed = true
        }
    }
    failed
}
