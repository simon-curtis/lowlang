import fixture
import std/process
import std/slices
import std/text

const browser_target = "browser/wasm32"
const loader_rejection = "browser/wasm32 has no "
const back_end_rejection = "browser/wasm32:"

fn out_of_memory_without_a_collector() -> []str {
    ["region_freed", "region_reuse"]
}

fn require_node(count: i64) ! Fault {
    if process.find("node") == none {
        fail Skipped("runs WebAssembly under node, which is not on PATH", count)
    }
}

fn browser_task_list(ctx: Context) -> []Task ! Fault {
    let run = read_programs("testdata/run")?
    let examples = read_examples(std_directory)?
    let selected = matching(ctx, "browser", slices.concat(run, examples))
    require_node(selected.len)?
    let cases = read_cases(selected)?
    var tasks: []Task = []
    for c in cases {
        let check = fn(scratch: str) -> Verdict { check_browser(ctx, c.program, c.sidecars, scratch) }
        push(mut tasks, Task { name: c.program.name, exclusive: c.sidecars.alone, check })
    }
    tasks
}

fn check_browser(ctx: Context, program: Program, sidecars: fixture.Sidecars, scratch: str) -> Verdict {
    if slices.contains(out_of_memory_without_a_collector(), program.name) {
        return skipped_verdict(Skip.Excluded)
    }
    let binary = "{scratch}/main.wasm"
    let built = run_compiler(ctx.low, ["build", program.path, "-o", binary, "-target", browser_target]) catch {
        f => return checked([describe(f)])
    }
    if !process.success(built.exit) {
        return build_verdict(built)
    }
    let invocation = Invocation { program: ctx.low, args: ["run", program.path, "-target", browser_target] }
    var got = execute(invocation) catch {
        e => return checked([describe(Fault.Io(ctx.low, e))])
    }
    got.stderr = without_warnings(got.stderr)
    checked(compare_run(sidecars, got, ""))
}

fn without_warnings(stderr: str) -> str {
    var kept: []str = []
    for line in text.lines(stderr) {
        if !text.contains(line, ": warning: ") {
            push(mut kept, line)
        }
    }
    if kept.len == 0 {
        return ""
    }
    "{text.join(kept, "\n")}\n"
}

fn build_verdict(built: Captured) -> Verdict {
    let message = text.trim(built.stderr)
    if text.contains(message, loader_rejection) {
        return skipped_verdict(Skip.Excluded)
    }
    if text.contains(message, back_end_rejection) {
        return skipped_verdict(Skip.Unsupported)
    }
    let exit = describe_exit(built.exit)
    checked(["build failed ({exit}): {excerpt(message)}"])
}
