import fixture
import std/file
import std/os
import std/sync
import std/text

const std_directory = "std"

struct Context {
    low: str
    root: str
    work: str
    filter: str
}

struct Task {
    name: str
    exclusive: bool
    check: fn(str) -> Verdict
}

enum Skip {
    Not
    Excluded
    Unsupported
}

struct Verdict {
    problems: []str
    skip: Skip = Skip.Not
}

struct Result {
    name: str
    problems: []str
    skip: Skip = Skip.Not
}

struct Tally {
    passed: i64
    failed: i64
    skipped: i64
    unsupported: i64 = 0
}

struct Case {
    program: Program
    sidecars: fixture.Sidecars
}

fn suite_names() -> []str {
    ["run", "examples", "fail", "lint", "windows", "browser"]
}

fn run_suite(ctx: Context, suite: str) -> Tally {
    let tasks = tasks_for(ctx, suite) catch {
        Skipped(message, count) => return skipped(suite, message, count)
        f => return broken(suite, f)
    }
    run_tasks(ctx, suite, tasks)
}

fn tasks_for(ctx: Context, suite: str) -> []Task ! Fault {
    match suite {
        "run" => run_task_list(ctx)
        "examples" => example_task_list(ctx)
        "fail" => fail_task_list(ctx)
        "lint" => lint_task_list(ctx)
        "windows" => windows_task_list(ctx)
        _ => browser_task_list(ctx)
    }
}

fn matching(ctx: Context, suite: str, programs: []Program) -> []Program {
    var kept: []Program = []
    for program in programs {
        if text.contains("{suite}/{program.name}", ctx.filter) {
            push(mut kept, program)
        }
    }
    kept
}

fn read_cases(programs: []Program) -> []Case ! Fault {
    var cases: []Case = []
    for program in programs {
        let sidecars = read_sidecars(program.path)?
        push(mut cases, Case { program, sidecars })
    }
    cases
}

fn require_linux_host(count: i64) ! Fault {
    if windows_host {
        fail Skipped("runs Linux binaries, which need a Linux host", count)
    }
}

fn run_task_list(ctx: Context) -> []Task ! Fault {
    let programs = read_programs("testdata/run")?
    let selected = matching(ctx, "run", programs)
    require_linux_host(selected.len)?
    let cases = read_cases(selected)?
    var tasks: []Task = []
    for c in cases {
        let exclusive = c.sidecars.alone || c.sidecars.max_rss_kb > 0 || c.sidecars.max_time_ns > 0
        let check = fn(scratch: str) -> Verdict { checked(check_run(ctx, c.program, c.sidecars, scratch)) }
        push(mut tasks, Task { name: c.program.name, exclusive, check })
    }
    tasks
}

fn example_task_list(ctx: Context) -> []Task ! Fault {
    let programs = read_examples(std_directory)?
    let selected = matching(ctx, "examples", programs)
    require_linux_host(selected.len)?
    let cases = read_cases(selected)?
    var tasks: []Task = []
    for c in cases {
        let check = fn(scratch: str) -> Verdict { checked(check_example(ctx, c.program, c.sidecars, scratch)) }
        push(mut tasks, Task { name: c.program.name, exclusive: false, check })
    }
    tasks
}

fn fail_task_list(ctx: Context) -> []Task ! Fault {
    let programs = read_programs("testdata/fail")?
    var tasks: []Task = []
    for program in matching(ctx, "fail", programs) {
        let check = fn(scratch: str) -> Verdict { checked(check_fail(ctx, program, scratch)) }
        push(mut tasks, Task { name: program.name, exclusive: false, check })
    }
    tasks
}

fn lint_task_list(ctx: Context) -> []Task ! Fault {
    let programs = read_programs("testdata/lint")?
    var tasks: []Task = []
    for program in matching(ctx, "lint", programs) {
        let check = fn(scratch: str) -> Verdict { checked(check_lint(ctx, program)) }
        push(mut tasks, Task { name: program.name, exclusive: false, check })
    }
    tasks
}

fn windows_task_list(ctx: Context) -> []Task ! Fault {
    let run = read_programs("testdata/run")?
    let windows = read_programs("testdata/windows")?
    let examples = read_examples(std_directory)?
    let candidates = matching(ctx, "windows", windows_programs(run, windows, examples))
    let cases = read_cases(candidates)?
    var buildable: []Case = []
    for c in cases {
        if fixture.windows(c.sidecars) {
            push(mut buildable, c)
        }
    }
    require_windows_host(buildable.len)?
    var tasks: []Task = []
    for c in buildable {
        let check = fn(scratch: str) -> Verdict { checked(check_windows(ctx, c.program, c.sidecars, scratch)) }
        push(mut tasks, Task { name: c.program.name, exclusive: c.sidecars.alone, check })
    }
    tasks
}

fn skipped(suite: str, message: str, count: i64) -> Tally {
    print("{suite}: skipped: {message}")
    Tally { passed: 0, failed: 0, skipped: count }
}

fn broken(suite: str, f: Fault) -> Tally {
    let message = describe(f)
    print("FAIL {suite}: {message}")
    Tally { passed: 0, failed: 1, skipped: 0 }
}

fn run_tasks(ctx: Context, suite: str, tasks: []Task) -> Tally {
    var results: []Result = []
    for task in tasks {
        push(mut results, Result { name: task.name, problems: [] })
    }
    for i, task in tasks {
        if task.exclusive {
            results[i] = run_task(ctx, suite, i, task)
        }
    }
    let group = sync.wait_group()
    let permits = sync.semaphore(os.cpu_count())
    for i, task in tasks {
        if !task.exclusive {
            sync.add(group, 1)
            spawn run_parallel(ctx, suite, i, task, results, permits, group)
        }
    }
    sync.wait(group)
    tally(suite, results)
}

fn run_parallel(ctx: Context, suite: str, index: i64, task: Task, results: []Result, permits: sync.Semaphore, group: sync.WaitGroup) {
    sync.acquire(permits)
    results[index] = run_task(ctx, suite, index, task)
    sync.release(permits)
    sync.done(group)
}

fn run_task(ctx: Context, suite: str, index: i64, task: Task) -> Result {
    let scratch = "{ctx.work}/{suite}-{index}"
    file.mkdir_all(scratch) catch {
        e => return Result { name: task.name, problems: ["{scratch}: {e}"] }
    }
    let verdict = task.check(scratch)
    file.remove_all(scratch) or {}
    Result { name: task.name, problems: verdict.problems, skip: verdict.skip }
}

fn checked(problems: []str) -> Verdict {
    Verdict { problems }
}

fn skipped_verdict(skip: Skip) -> Verdict {
    Verdict { problems: [], skip }
}

fn tally(suite: str, results: []Result) -> Tally {
    var passed = 0
    var failed = 0
    var skipped = 0
    var unsupported = 0
    for result in results {
        if result.skip == Skip.Excluded {
            skipped += 1
        } else if result.skip == Skip.Unsupported {
            unsupported += 1
        } else if result.problems.len == 0 {
            passed += 1
        } else {
            failed += 1
            let joined = text.join(result.problems, "; ")
            print("FAIL {suite}/{result.name}: {joined}")
        }
    }
    Tally { passed, failed, skipped, unsupported }
}
