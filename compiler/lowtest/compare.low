import fixture
import std/os/signal
import std/process
import std/text

const window_before = 40
const window_length = 160
const fault_prefix = "fault: "

fn describe_exit(e: process.Exit) -> str {
    match e {
        Exited(code) => describe_status(code)
        Signaled(s) => "signal {signal.number(s)}"
    }
}

fn describe_status(code: i64) -> str {
    if code >= 0 && code <= 255 {
        return "exit status {code}"
    }
    let word = u32(code)
    "exit status {code} (0x{word:x})"
}

fn first_difference(a: str, b: str) -> i64 {
    let shared = if a.len < b.len { a.len } else { b.len }
    for i in 0..shared {
        if a[i] != b[i] {
            return i
        }
    }
    shared
}

fn window(s: str, from: i64) -> str {
    let start = if from < s.len { from } else { s.len }
    let end = if start + window_length < s.len { start + window_length } else { s.len }
    let lead = if start > 0 { "..." } else { "" }
    let trail = if end < s.len { "..." } else { "" }
    "{lead}{text.quote(s[start..end])}{trail}"
}

fn mismatch(stream: str, got: str, want: str) -> str {
    let at = first_difference(got, want)
    let from = if at > window_before { at - window_before } else { 0 }
    let got_window = window(got, from)
    let want_window = window(want, from)
    "{stream} differs at byte {at} (got {got.len} bytes, want {want.len}): got {got_window}, want {want_window}"
}

fn fault_reports(stderr: str) -> []str {
    var reports: []str = []
    for line in text.lines(stderr) {
        if text.starts_with(line, fault_prefix) {
            reports.push(line)
        }
    }
    reports
}

fn without_fault_reports(stderr: str) -> str {
    var kept: []str = []
    for line in text.lines(stderr) {
        if !text.starts_with(line, fault_prefix) {
            kept.push(line)
        }
    }
    if kept.len == 0 {
        return ""
    }
    "{text.join(kept, "\n")}\n"
}

fn compare_run(want: fixture.Sidecars, got: Captured, label: str) -> []str {
    var problems: []str = []
    if got.timed_out {
        problems.push("{label}timed out after {run_limit_ms / 1000}s")
    }
    if got.stdout != want.stdout {
        let difference = mismatch("stdout", got.stdout, want.stdout)
        problems.push("{label}{difference}")
    }
    let reports = fault_reports(got.stderr)
    let stderr = if reports.len > 0 { without_fault_reports(got.stderr) } else { got.stderr }
    if stderr != want.stderr {
        let difference = mismatch("stderr", stderr, want.stderr)
        problems.push("{label}{difference}")
    }
    let panicked = !process.success(got.exit)
    let exit = describe_exit(got.exit)
    if panicked != want.panics {
        problems.push("{label}{exit}, expected panic {want.panics}")
    } else if problems.len > 0 {
        problems.push("{label}{exit}")
    }
    if problems.len > 0 {
        for report in reports {
            problems.push("{label}{report}")
        }
    }
    problems
}

fn check_limits(want: fixture.Sidecars, got: Captured, label: str) -> []str {
    var problems: []str = []
    if want.max_rss_kb > 0 && got.peak_kb > want.max_rss_kb {
        problems.push("{label}peak memory {got.peak_kb} KB exceeds {want.max_rss_kb} KB")
    }
    if want.max_time_ns > 0 && got.elapsed_ns > want.max_time_ns {
        problems.push("{label}run took {got.elapsed_ns / 1000000} ms, limit {want.max_time_ns / 1000000} ms")
    }
    problems
}

fn compare_text(what: str, got: str, want: str) -> []str {
    if got == want {
        return []
    }
    [mismatch(what, got, want)]
}
