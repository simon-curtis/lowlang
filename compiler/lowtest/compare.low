import std/os/signal
import std/process
import std/text

const window_before = 40
const window_length = 160

fn describe_exit(e: process.Exit) -> str {
    match e {
        Exited(code) => "exit status {code}"
        Signaled(s) => "signal {signal.number(s)}"
    }
}

fn first_difference(a: str, b: str) -> i64 {
    let shared = if a.len < b.len { a.len } else { b.len }
    for i in 0..shared {
        if a[i] != b[i] {
            return i
        }
    }
    shared
}

fn window(s: str, from: i64) -> str {
    let start = if from < s.len { from } else { s.len }
    let end = if start + window_length < s.len { start + window_length } else { s.len }
    let lead = if start > 0 { "..." } else { "" }
    let trail = if end < s.len { "..." } else { "" }
    "{lead}{text.quote(s[start..end])}{trail}"
}

fn mismatch(stream: str, got: str, want: str) -> str {
    let at = first_difference(got, want)
    let from = if at > window_before { at - window_before } else { 0 }
    let got_window = window(got, from)
    let want_window = window(want, from)
    "{stream} differs at byte {at} (got {got.len} bytes, want {want.len}): got {got_window}, want {want_window}"
}

fn compare_run(want: Sidecars, got: Captured, label: str) -> []str {
    var problems: []str = []
    if got.timed_out {
        push(mut problems, "{label}timed out after {run_limit_ms / 1000}s")
    }
    if got.stdout != want.stdout {
        let difference = mismatch("stdout", got.stdout, want.stdout)
        push(mut problems, "{label}{difference}")
    }
    if got.stderr != want.stderr {
        let difference = mismatch("stderr", got.stderr, want.stderr)
        push(mut problems, "{label}{difference}")
    }
    let panicked = !process.success(got.exit)
    if panicked != want.panics {
        let exit = describe_exit(got.exit)
        push(mut problems, "{label}{exit}, expected panic {want.panics}")
    }
    problems
}

fn check_limits(want: Sidecars, got: Captured, label: str) -> []str {
    var problems: []str = []
    if want.max_rss_kb > 0 && got.peak_kb > want.max_rss_kb {
        push(mut problems, "{label}peak memory {got.peak_kb} KB exceeds {want.max_rss_kb} KB")
    }
    if want.max_time_ns > 0 && got.elapsed_ns > want.max_time_ns {
        push(mut problems, "{label}run took {got.elapsed_ns / 1000000} ms, limit {want.max_time_ns / 1000000} ms")
    }
    problems
}

fn compare_text(what: str, got: str, want: str) -> []str {
    if got == want {
        return []
    }
    [mismatch(what, got, want)]
}
