import std/os

extern "kernel32" {
    fn GetEnabledXStateFeatures() -> u64
}

const windows_host = true

fn announce_host() {
    let processor = os.env("PROCESSOR_IDENTIFIER") ?? "unknown processor"
    let features = GetEnabledXStateFeatures()
    print("windows host: {processor}, enabled xstate features 0x{features:x}")
}
