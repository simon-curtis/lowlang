import fixture
import std/file
import std/process
import std/text

const linux_target = "linux/amd64"
const windows_target = "windows/amd64"
const message_limit = 600

fn run_compiler(low: str, args: []str) -> Captured ! Fault {
    let invocation = Invocation { program: low, args, limit_ms: compile_limit_ms }
    execute(invocation) catch {
        e => fail Io(low, e)
    }
}

fn build_args(path: str, output: str, target: str, sidecars: fixture.Sidecars) -> []str {
    var args = ["build", path, "-o", output, "--target", target]
    if sidecars.debug {
        args.push("-c")
        args.push("debug")
    }
    args
}

fn build_binary(low: str, path: str, output: str, target: str, sidecars: fixture.Sidecars) ! Fault {
    build_with(low, build_args(path, output, target, sidecars))?
}

fn build_mapped(low: str, path: str, output: str, map_path: str, sidecars: fixture.Sidecars) ! Fault {
    var args = build_args(path, output, linux_target, sidecars)
    args.push("--map")
    args.push(map_path)
    build_with(low, args)?
}

fn build_with(low: str, args: []str) ! Fault {
    let result = run_compiler(low, args)?
    if !process.success(result.exit) {
        let exit = describe_exit(result.exit)
        let message = excerpt(text.trim(result.stderr))
        fail Invalid("build failed ({exit}): {message}")
    }
}

fn has_vector_code(map_path: str) -> bool ! Fault {
    let listing = file.read_text(map_path) catch {
        e => fail Io(map_path, e)
    }
    let symbols: [str: bool] = [:]
    for line in text.lines(listing) {
        symbols[text.cut(line, " ").after] = true
    }
    for symbol in symbols {
        if !text.ends_with(symbol, ".avx512") {
            continue
        }
        let stub = text.trim_suffix(symbol, ".avx512")
        if symbols[stub] != none && symbols["{stub}.avx2"] != none && symbols["{stub}.sse2"] != none {
            return true
        }
    }
    false
}

fn excerpt(s: str) -> str {
    if s.len <= message_limit {
        return s
    }
    "{s[..message_limit]}... ({s.len} bytes)"
}
