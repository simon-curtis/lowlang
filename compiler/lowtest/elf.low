import fixture
import std/file
import std/io
import std/slices

const header_size = 64
const program_header_size = 56
const dynamic_entry_size = 16
const type_load = 1
const type_dynamic = 2
const type_interp = 3
const tag_null = 0
const tag_needed = 1
const tag_string_table = 5

struct Linking {
    libraries: []str
    interpreter: bool
}

struct Segment {
    kind: i64
    offset: i64
    address: i64
    size: i64
}

fn read_linking(path: str) -> Linking ! Fault {
    let image = file.read_file(path) catch {
        e => fail Io(path, e)
    }
    if image.len < header_size || image[0] != 0x7f || image[1] != 'E' || image[2] != 'L' || image[3] != 'F' {
        fail Invalid("{path}: not an ELF file")
    }
    let segments = read_segments(image)
    var linking = Linking { libraries: [], interpreter: false }
    for segment in segments {
        if segment.kind == type_interp {
            linking.interpreter = true
        }
        if segment.kind == type_dynamic {
            linking.libraries = read_needed(path, image, segments, segment)?
        }
    }
    slices.sort(mut linking.libraries)
    linking
}

fn read_segments(image: []u8) -> []Segment {
    let table = io.le64(image, 0x20)
    let count = io.le16(image, 0x38)
    var segments: []Segment = []
    for i in 0..count {
        let at = table + i * program_header_size
        if at + program_header_size > image.len {
            break
        }
        push(mut segments, Segment {
            kind: io.le32(image, at)
            offset: io.le64(image, at + 8)
            address: io.le64(image, at + 16)
            size: io.le64(image, at + 32)
        })
    }
    segments
}

fn file_offset(segments: []Segment, address: i64) -> i64? {
    for segment in segments {
        if segment.kind == type_load && address >= segment.address && address < segment.address + segment.size {
            return segment.offset + address - segment.address
        }
    }
    none
}

fn read_needed(path: str, image: []u8, segments: []Segment, dynamic: Segment) -> []str ! Fault {
    var string_table = -1
    var needed: []i64 = []
    var at = dynamic.offset
    for at + dynamic_entry_size <= image.len && at < dynamic.offset + dynamic.size {
        let tag = io.le64(image, at)
        let value = io.le64(image, at + 8)
        if tag == tag_null {
            break
        }
        if tag == tag_needed {
            push(mut needed, value)
        }
        if tag == tag_string_table {
            string_table = file_offset(segments, value) ?? fail Invalid("{path}: string table outside the loaded segments")
        }
        at += dynamic_entry_size
    }
    var libraries: []str = []
    for name_offset in needed {
        if string_table < 0 {
            fail Invalid("{path}: needed libraries without a string table")
        }
        push(mut libraries, read_name(image, string_table + name_offset))
    }
    libraries
}

fn read_name(image: []u8, start: i64) -> str {
    var end = start
    for end < image.len && image[end] != 0 {
        end += 1
    }
    str(image[start..end])
}

fn check_linking(want: fixture.Sidecars, binary: str) -> []str {
    let linking = read_linking(binary) catch {
        f => return [describe(f)]
    }
    if want.libraries.len == 0 {
        if linking.libraries.len > 0 || linking.interpreter {
            return ["expected a static binary, found shared libraries {linking.libraries}"]
        }
        return []
    }
    if !slices.equal(linking.libraries, want.libraries) {
        return ["shared libraries {linking.libraries}, want {want.libraries}"]
    }
    []
}
