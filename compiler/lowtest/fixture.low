import std/file
import std/io
import std/slices
import std/text
import std/time/duration
import paths = std/path

const source_extension = ".low"

enum Fault {
    Io(path: str, error: io.Error)
    Invalid(message: str)
    Skipped(message: str, count: i64)
}

struct Sidecars {
    stdout: str
    stderr: str
    panics: bool
    max_rss_kb: i64
    max_time_ns: i64
    libraries: []str
    simd: bool
    linux_only: bool
    alone: bool
}

struct Program {
    name: str
    path: str
}

struct Sidecar {
    content: str
    present: bool
}

fn describe(f: Fault) -> str {
    match f {
        Io(path, error) => "{path}: {error}"
        Invalid(message) => message
        Skipped(message, _) => message
    }
}

fn base(path: str) -> str {
    text.trim_suffix(path, source_extension)
}

fn windows_build(s: Sidecars) -> bool {
    !s.linux_only && s.libraries.len == 0
}

fn read_sidecar(path: str, extension: str) -> Sidecar ! Fault {
    let sidecar_path = "{base(path)}{extension}"
    let content = file.read_text(sidecar_path) catch {
        NotFound => return Sidecar { content: "", present: false }
        e => fail Io(sidecar_path, e)
    }
    Sidecar { content, present: true }
}

fn read_sidecars(path: str) -> Sidecars ! Fault {
    let stdout = read_sidecar(path, ".out")?
    let stderr = read_sidecar(path, ".err")?
    let max_rss_kb = read_max_rss(path)?
    let max_time_ns = read_max_time(path)?
    let libraries = read_libraries(path)?
    var sidecars = Sidecars {
        stdout: stdout.content
        stderr: stderr.content
        panics: stderr.present
        max_rss_kb
        max_time_ns
        libraries
        simd: false
        linux_only: false
        alone: false
    }
    read_tags(path, mut sidecars)?
    sidecars
}

fn read_max_rss(path: str) -> i64 ! Fault {
    let sidecar = read_sidecar(path, ".maxrss")?
    if !sidecar.present {
        return 0
    }
    text.parse_int(text.trim(sidecar.content)) or fail Invalid("{base(path)}.maxrss: invalid number")
}

fn read_max_time(path: str) -> i64 ! Fault {
    let sidecar = read_sidecar(path, ".maxtime")?
    if !sidecar.present {
        return 0
    }
    let limit = duration.parse(text.trim(sidecar.content)) or fail Invalid("{base(path)}.maxtime: invalid duration")
    duration.saturating_nanos(limit)
}

fn read_libraries(path: str) -> []str ! Fault {
    let sidecar = read_sidecar(path, ".needed")?
    text.fields(sidecar.content)
}

fn read_tags(path: str, mut sidecars: Sidecars) ! Fault {
    let sidecar = read_sidecar(path, ".tags")?
    for tag in text.fields(sidecar.content) {
        match tag {
            "simd" => {
                sidecars.simd = true
            }
            "linux-only" => {
                sidecars.linux_only = true
            }
            "alone" => {
                sidecars.alone = true
            }
            _ => fail Invalid("{base(path)}.tags: unknown tag {text.quote(tag)}")
        }
    }
}

fn read_programs(dir: str) -> []Program ! Fault {
    var entries = file.read_dir_info(dir) catch {
        e => fail Io(dir, e)
    }
    slices.sort_by(mut entries, fn(a: file.Entry, b: file.Entry) -> bool { a.name < b.name })
    var programs: []Program = []
    for entry in entries {
        if entry.dir || text.ends_with(entry.name, source_extension) {
            push(mut programs, Program { name: base(entry.name), path: file.child_path(dir, entry.name) })
        }
    }
    if programs.len == 0 {
        fail Invalid("no programs in {dir}")
    }
    programs
}

fn read_examples(std_dir: str) -> []Program ! Fault {
    var programs: []Program = []
    file.walk(std_dir, fn(v: file.Visit) -> file.Step {
        if is_example(v) {
            let name = base(text.trim_prefix(v.path, "{std_dir}/"))
            push(mut programs, Program { name, path: v.path })
        }
        file.Step.Continue
    }) catch {
        e => fail Io(std_dir, e)
    }
    if programs.len == 0 {
        fail Invalid("no std examples in {std_dir}")
    }
    programs
}

fn is_example(v: file.Visit) -> bool {
    v.regular && text.ends_with(v.name, source_extension) && paths.base(paths.dir(v.path)) == "examples"
}

fn windows_programs(run: []Program, windows: []Program, examples: []Program) -> []Program {
    slices.concat(slices.concat(run, windows), examples)
}

fn relative(message: str, absolute: str) -> str {
    let without_directory = text.replace(message, "{absolute}/", "")
    text.replace(without_directory, "{absolute}:", "")
}
