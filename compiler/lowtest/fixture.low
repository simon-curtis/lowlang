import fixture
import std/file
import std/io
import std/slices
import std/text
import paths = std/path

enum Fault {
    Io(path: str, error: io.Error)
    Invalid(message: str)
    Skipped(message: str, count: i64)
}

struct Program {
    name: str
    path: str
}

fn describe(f: Fault) -> str {
    match f {
        Io(path, error) => "{path}: {error}"
        Invalid(message) => message
        Skipped(message, _) => message
    }
}

fn from_fixture(e: fixture.Error) -> Fault {
    match e {
        Io(path, error) => Fault.Io(path, error)
        Invalid(message) => Fault.Invalid(message)
    }
}

fn read_sidecars(path: str) -> fixture.Sidecars ! Fault {
    fixture.read(path) catch {
        e => fail from_fixture(e)
    }
}

fn read_sidecar(path: str, extension: str) -> fixture.Sidecar ! Fault {
    fixture.read_sidecar(path, extension) catch {
        e => fail from_fixture(e)
    }
}

fn read_target(path: str, fallback: str) -> str ! Fault {
    fixture.read_target(path, fallback) catch {
        e => fail from_fixture(e)
    }
}

fn read_programs(dir: str) -> []Program ! Fault {
    var entries = file.read_dir_info(dir) catch {
        e => fail Io(dir, e)
    }
    slices.sort_by(mut entries, fn(a: file.Entry, b: file.Entry) -> bool { a.name < b.name })
    var programs: []Program = []
    for entry in entries {
        if entry.dir || text.ends_with(entry.name, fixture.source_ext) {
            push(mut programs, Program { name: fixture.base(entry.name), path: file.child_path(dir, entry.name) })
        }
    }
    if programs.len == 0 {
        fail Invalid("no programs in {dir}")
    }
    programs
}

fn read_examples(std_dir: str) -> []Program ! Fault {
    var programs: []Program = []
    file.walk(std_dir, fn(v: file.Visit) -> file.Step {
        if is_example(v) {
            let name = fixture.base(text.trim_prefix(v.path, "{std_dir}/"))
            push(mut programs, Program { name, path: v.path })
        }
        file.Step.Continue
    }) catch {
        e => fail Io(std_dir, e)
    }
    if programs.len == 0 {
        fail Invalid("no std examples in {std_dir}")
    }
    programs
}

fn is_example(v: file.Visit) -> bool {
    v.regular && text.ends_with(v.name, fixture.source_ext) && paths.base(paths.dir(v.path)) == "examples"
}

fn windows_programs(run: []Program, windows: []Program, examples: []Program) -> []Program {
    slices.concat(slices.concat(run, windows), examples)
}

fn relative(message: str, absolute: str) -> str {
    let without_directory = text.replace(message, "{absolute}/", "")
    text.replace(without_directory, "{absolute}:", "")
}
