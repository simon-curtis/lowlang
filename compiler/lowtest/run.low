import fixture
import std/process
import std/text

const simd_environment = "LOW_SIMD"
const simd_value = "sse2"

fn append_all(mut into: []str, more: []str) {
    for item in more {
        push(mut into, item)
    }
}

fn check_run(ctx: Context, program: Program, sidecars: fixture.Sidecars, scratch: str) -> []str {
    var problems: []str = []
    check_vector_tag(ctx, program, sidecars, mut problems) catch {
        f => push(mut problems, describe(f))
    }
    run_linux(ctx, program, sidecars, scratch, mut problems) catch {
        f => push(mut problems, describe(f))
    }
    problems
}

fn check_example(ctx: Context, program: Program, sidecars: fixture.Sidecars, scratch: str) -> []str {
    var problems: []str = []
    let binary = "{scratch}/main"
    build_binary(ctx.low, program.path, binary, linux_target) catch {
        f => return [describe(f)]
    }
    run_once(sidecars, binary, [:], "", mut problems) catch {
        f => push(mut problems, describe(f))
    }
    problems
}

fn check_vector_tag(ctx: Context, program: Program, sidecars: fixture.Sidecars, mut problems: []str) ! Fault {
    let vector = has_vector_code(ctx.low, program.path)?
    if vector != sidecars.simd {
        push(mut problems, "program has vector code {vector}, but its .tags file says simd {sidecars.simd}")
    }
}

fn run_linux(ctx: Context, program: Program, sidecars: fixture.Sidecars, scratch: str, mut problems: []str) ! Fault {
    let binary = "{scratch}/main"
    build_binary(ctx.low, program.path, binary, linux_target)?
    run_once(sidecars, binary, [:], "", mut problems)?
    if sidecars.simd {
        let label = "{simd_environment}={simd_value}: "
        run_once(sidecars, binary, [simd_environment: simd_value], label, mut problems)?
    }
    append_all(mut problems, check_linking(sidecars, binary))
}

fn run_once(sidecars: fixture.Sidecars, binary: str, extra_env: [str: str], label: str, mut problems: []str) ! Fault {
    let invocation = Invocation {
        program: binary
        args: []
        extra_env
        limit_ms: run_limit_ms
        measure_memory: sidecars.max_rss_kb > 0
    }
    let got = execute(invocation) catch {
        e => fail Io(binary, e)
    }
    append_all(mut problems, compare_run(sidecars, got, label))
    append_all(mut problems, check_limits(sidecars, got, label))
}

fn check_fail(ctx: Context, program: Program, scratch: str) -> []str {
    let want = read_sidecar(program.path, ".err") catch {
        f => return [describe(f)]
    }
    if !want.present {
        return ["missing .err fixture"]
    }
    let absolute = "{ctx.root}/{program.path}"
    let output = "{scratch}/main"
    let result = run_compiler(ctx.low, ["build", absolute, "-o", output, "-target", linux_target]) catch {
        f => return [describe(f)]
    }
    if process.success(result.exit) {
        return ["compiled without error"]
    }
    let got = relative(text.trim_suffix(result.stderr, "\n"), absolute)
    compare_text("error", got, text.trim(want.content))
}

fn check_lint(ctx: Context, program: Program) -> []str {
    let want = read_sidecar(program.path, ".warn") catch {
        f => return [describe(f)]
    }
    let absolute = "{ctx.root}/{program.path}"
    let result = run_compiler(ctx.low, ["lint", absolute, "-target", linux_target]) catch {
        f => return [describe(f)]
    }
    let got = relative(text.trim_suffix(result.stderr, "\n"), absolute)
    var problems = compare_text("warnings", got, text.trim(want.content))
    let warned = result.exit == process.Exit.Exited(1)
    let clean = result.exit == process.Exit.Exited(0)
    if !warned && !clean {
        let exit = describe_exit(result.exit)
        push(mut problems, "lint ended with {exit}")
    }
    problems
}
