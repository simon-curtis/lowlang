import fixture
import std/file
import std/process
import std/slices
import std/text

const simd_environment = "LOW_SIMD"
const simd_baseline = "sse2"
const simd_avx512 = "avx512"
const cpu_info_path = "/proc/cpuinfo"

fn avx512_flags() -> []str {
    ["avx512f", "avx512vl", "avx512bw", "avx512dq"]
}

fn host_has_avx512() -> bool {
    let info = file.read_text(cpu_info_path) or return false
    for line in text.lines(info) {
        if !text.starts_with(line, "flags") {
            continue
        }
        let present = text.fields(line)
        for flag in avx512_flags() {
            if !slices.contains(present, flag) {
                return false
            }
        }
        return true
    }
    false
}

fn describe_avx512(available: bool) -> str {
    let flags = text.join(avx512_flags(), " ")
    if available {
        return "simd programs also run with {simd_environment}={simd_avx512}: the host lists {flags}"
    }
    "simd programs do not run with {simd_environment}={simd_avx512}: the host does not list {flags}"
}

fn append_all(mut into: []str, more: []str) {
    for item in more {
        into.push(item)
    }
}

fn check_run(ctx: Context, program: Program, sidecars: fixture.Sidecars, scratch: str) -> []str {
    var problems: []str = []
    run_linux(ctx, program, sidecars, scratch, mut problems) catch {
        f => problems.push(describe(f))
    }
    problems
}

fn check_example(ctx: Context, program: Program, sidecars: fixture.Sidecars, scratch: str) -> []str {
    var problems: []str = []
    let binary = "{scratch}/main"
    build_binary(ctx.low, program.path, binary, linux_target, sidecars) catch {
        f => return [describe(f)]
    }
    run_once(sidecars, binary, [:], "", mut problems) catch {
        f => problems.push(describe(f))
    }
    problems
}

fn check_vector_tag(map_path: str, sidecars: fixture.Sidecars, mut problems: []str) ! Fault {
    let vector = has_vector_code(map_path)?
    if vector != sidecars.simd {
        problems.push("program has vector code {vector}, but its .tags file says simd {sidecars.simd}")
    }
}

fn run_linux(ctx: Context, program: Program, sidecars: fixture.Sidecars, scratch: str, mut problems: []str) ! Fault {
    let binary = "{scratch}/main"
    let map_path = "{scratch}/main.map"
    build_mapped(ctx.low, program.path, binary, map_path, sidecars)?
    check_vector_tag(map_path, sidecars, mut problems)?
    run_once(sidecars, binary, [:], "", mut problems)?
    if sidecars.simd {
        run_with_simd(sidecars, binary, simd_baseline, mut problems)?
    }
    if sidecars.simd && ctx.avx512 {
        run_with_simd(sidecars, binary, simd_avx512, mut problems)?
    }
    append_all(mut problems, check_linking(sidecars, binary))
}

fn run_with_simd(sidecars: fixture.Sidecars, binary: str, tier: str, mut problems: []str) ! Fault {
    let label = "{simd_environment}={tier}: "
    run_once(sidecars, binary, [simd_environment: tier], label, mut problems)?
}

fn run_once(sidecars: fixture.Sidecars, binary: str, extra_env: [str: str], label: str, mut problems: []str) ! Fault {
    let invocation = Invocation {
        program: binary
        args: []
        extra_env
        limit_ms: run_limit_ms
        measure_memory: sidecars.max_rss_kb > 0
    }
    let got = execute(invocation) catch {
        e => fail Io(binary, e)
    }
    append_all(mut problems, compare_run(sidecars, got, label))
    append_all(mut problems, check_limits(sidecars, got, label))
}

fn check_fail(ctx: Context, program: Program, scratch: str) -> []str {
    let want = read_sidecar(program.path, ".err") catch {
        f => return [describe(f)]
    }
    if !want.present {
        return ["missing .err fixture"]
    }
    let platform = read_target(program.path, linux_target) catch {
        f => return [describe(f)]
    }
    let absolute = "{ctx.root}/{program.path}"
    let output = "{scratch}/main"
    let result = run_compiler(ctx.low, ["build", absolute, "-o", output, "--target", platform]) catch {
        f => return [describe(f)]
    }
    if process.success(result.exit) {
        return ["compiled without error"]
    }
    let got = relative(text.trim_suffix(result.stderr, "\n"), absolute)
    compare_text("error", got, text.trim(want.content))
}

fn check_lint(ctx: Context, program: Program) -> []str {
    let want = read_sidecar(program.path, ".warn") catch {
        f => return [describe(f)]
    }
    let absolute = "{ctx.root}/{program.path}"
    let result = run_compiler(ctx.low, ["lint", absolute, "--target", linux_target]) catch {
        f => return [describe(f)]
    }
    let got = relative(text.trim_suffix(result.stderr, "\n"), absolute)
    var problems = compare_text("warnings", got, text.trim(want.content))
    let warned = result.exit == process.Exit.Exited(1)
    let clean = result.exit == process.Exit.Exited(0)
    if !warned && !clean {
        let exit = describe_exit(result.exit)
        problems.push("lint ended with {exit}")
    }
    problems
}
