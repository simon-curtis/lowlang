import std/process
import std/text

const linux_target = "linux/amd64"
const windows_target = "windows/amd64"
const message_limit = 600

fn run_compiler(low: str, args: []str) -> Captured ! Fault {
    let invocation = Invocation { program: low, args, limit_ms: compile_limit_ms }
    execute(invocation) catch {
        e => fail Io(low, e)
    }
}

fn build_binary(low: str, path: str, output: str, target: str) ! Fault {
    let args = ["build", path, "-o", output, "-target", target]
    let result = run_compiler(low, args)?
    if !process.success(result.exit) {
        let exit = describe_exit(result.exit)
        let message = excerpt(text.trim(result.stderr))
        fail Invalid("build failed ({exit}): {message}")
    }
}

fn has_vector_code(low: str, path: str) -> bool ! Fault {
    let result = run_compiler(low, ["ir", path, "-target", linux_target])?
    if !process.success(result.exit) {
        let exit = describe_exit(result.exit)
        let message = excerpt(text.trim(result.stderr))
        fail Invalid("ir failed ({exit}): {message}")
    }
    for line in text.lines(result.stdout) {
        if is_vector_value(line) {
            return true
        }
    }
    false
}

fn is_vector_value(line: str) -> bool {
    let trimmed = text.trim_start(line)
    let at = text.index(trimmed, " = vector")
    at > 1 && trimmed[0] == 'v' && text.is_digits(trimmed[1..at])
}

fn excerpt(s: str) -> str {
    if s.len <= message_limit {
        return s
    }
    "{s[..message_limit]}... ({s.len} bytes)"
}
