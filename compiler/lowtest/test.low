import std/process
import std/text

fn check_test(ctx: Context, program: Program) -> []str {
    let want = read_test_sidecars(program.path) catch {
        f => return [describe(f)]
    }
    let absolute = "{ctx.root}/{program.path}"
    var module = absolute
    if want.module != "" {
        module = "{absolute}/{want.module}"
    }
    var args = ["test", module, "-notime"]
    append_all(mut args, want.args)
    let result = run_compiler(ctx.low, args) catch {
        f => return [describe(f)]
    }
    let stdout = relative(result.stdout, absolute)
    let stderr = relative(result.stderr, absolute)
    var problems = compare_text("stdout", stdout, want.stdout)
    append_all(mut problems, compare_text("stderr", stderr, want.stderr))
    let expected = process.Exit.Exited(want.status)
    if result.exit != expected {
        let exit = describe_exit(result.exit)
        push(mut problems, "{exit}, expected exit status {want.status}")
    }
    problems
}
