import compiler
import lexer
import target
import std/builder
import std/slices

fn dump_check_command(mut out: builder.Builder, path: str, flags: []str) ! compiler.Error {
    let unit = compiler.check(path, platform_of(flags))?
    for f in unit.files {
        line(mut out, 0, "", "File {lexer.quote(f.path)}{named("module", f.module)}")
        dump_file(mut out, f)
    }
    for source in unit.sources {
        line(mut out, 0, "", "Source {lexer.quote(source)}")
    }
    for w in unit.warnings {
        line(mut out, 0, "", "Warning {at(w.pos)} rule={w.rule} msg={lexer.quote(w.msg)}")
    }
}

fn platform_of(flags: []str) -> target.OS {
    if slices.contains(flags, "-windows") {
        return target.OS.Windows
    }
    target.OS.Linux
}
