import asm
import lexer
import link
import std/builder
import std/file
import std/slices
import std/text

fn dump_patch_command(mut out: builder.Builder, args: []str) ! Error {
    let options = parse_link_flags(args)?
    if options.paths.len != 3 {
        fail Usage
    }
    let source_path = options.paths[0]
    let src = file.read_text(source_path) or fail Read(source_path)
    let base = text.parse_int(options.paths[1]) catch {
        _ => fail Usage
    }
    let running = read_running(options.paths[2])?
    var opts = options.opts
    opts.align_branches = true
    let object = asm.assemble(src, opts) catch Assemble
    let image = link.patch(object, base, running) catch Link
    out.write("address {image.address}\n")
    out.write("code ")
    write_hex(mut out, image.code)
    out.write("\n")
    var names: []str = []
    for name in image.symbols {
        push(mut names, name)
    }
    slices.sort(mut names)
    for name in names {
        let quoted = lexer.quote(name)
        let value = image.symbols[name] ?? 0
        out.write("symbol {quoted} {value}\n")
    }
}

fn read_running(path: str) -> [str: i64] ! Error {
    let data = file.read_text(path) or fail Read(path)
    var running: [str: i64] = [:]
    for line in text.split(data, '\n') {
        let fields = text.fields(line)
        if fields.len != 2 {
            continue
        }
        let address = text.parse_int(fields[1]) catch {
            _ => fail Usage
        }
        running[fields[0]] = address
    }
    running
}
