import ast
import diag
import lexer
import std/builder
import std/text

fn line(mut out: builder.Builder, depth: i64, label: str, head: str) {
    out.write(text.repeat("  ", depth))
    out.write(label)
    out.write(head)
    out.write("\n")
}

fn at(p: diag.Pos) -> str {
    "{p.line}:{p.col}"
}

fn flag(name: str, on: bool) -> str {
    if !on {
        return ""
    }
    " {name}"
}

fn named(name: str, value: str) -> str {
    if value == "" {
        return ""
    }
    " {name}={value}"
}

fn quoted(name: str, value: str) -> str {
    if value == "" {
        return ""
    }
    " {name}={lexer.quote(value)}"
}

fn dump_file(mut out: builder.Builder, f: *ast.File) {
    for n in f.imports {
        line(mut out, 0, "", "Import {at(n.pos)} alias={n.alias} path={n.path}")
    }
    for n in f.externs {
        line(mut out, 0, "", "Extern {at(n.pos)} library={lexer.quote(n.library)}")
        for func in n.funcs {
            dump_func(mut out, 1, func)
        }
    }
    for n in f.enums {
        line(mut out, 0, "", "Enum {at(n.pos)} name={n.name}{flag("pub", n.exported)}{quoted("doc", n.doc)}{typed("type", n.type)}")
        dump_type_params(mut out, 1, n.type_params)
        for v in n.variants {
            dump_variant(mut out, 1, v)
        }
        dump_layout(mut out, 1, n.type)
    }
    for n in f.structs {
        dump_struct(mut out, n)
    }
    for n in f.consts {
        line(mut out, 0, "", "Const {at(n.pos)} name={n.name}{flag("pub", n.exported)}{quoted("doc", n.doc)}{quoted("text", n.text)}")
        dump_type(mut out, 1, "type: ", n.type_name)
        dump_expr(mut out, 1, "value: ", n.value)
        dump_optional(mut out, 1, "folded: ", n.folded)
    }
    for n in f.funcs {
        dump_func(mut out, 0, n)
    }
}

fn dump_struct(mut out: builder.Builder, n: *ast.StructDecl) {
    line(mut out, 0, "", "Struct {at(n.pos)} name={n.name}{flag("pub", n.exported)}{flag("c", n.c)}{quoted("doc", n.doc)}{typed("type", n.type)}")
    dump_type_params(mut out, 1, n.type_params)
    match n.on_drop {
        some(s) => dump_stmt(mut out, 1, "drop: ", s)
        none => {}
    }
    for field in n.fields {
        line(mut out, 1, "", "Field {at(field.pos)} name={field.name}{flag("pub", field.exported)}{quoted("doc", field.doc)}")
        dump_type(mut out, 2, "type: ", field.type_name)
        dump_optional(mut out, 2, "default: ", field.default)
    }
    dump_layout(mut out, 1, n.type)
}

fn dump_func(mut out: builder.Builder, depth: i64, f: *ast.Func) {
    var head = builder.builder()
    head.write("Func {at(f.pos)} name={f.name}")
    head.write(flag("pub", f.exported))
    head.write(flag("extern", f.external != none))
    head.write(flag("variadic", f.variadic))
    head.write(named("symbol", f.symbol))
    head.write(quoted("doc", f.doc))
    head.write(func_ref("template", f.template))
    head.write(type_list("type_args", f.type_args))
    head.write(flag("closure", f.closure != none))
    head.write(flag("as_value", f.as_value))
    head.write(flag("callback", f.callback))
    head.write(type_list("param_types", f.param_types))
    head.write(typed("ret", f.ret_type))
    head.write(bound(f.bound))
    head.write(flag("trusted", f.trusted))
    head.write(flag("derived", f.derived))
    line(mut out, depth, "", head.to_str())
    dump_type_params(mut out, depth + 1, f.type_params)
    dump_params(mut out, depth + 1, f.params)
    dump_locals(mut out, depth + 1, "param_local: ", f.param_locals)
    dump_type(mut out, depth + 1, "result: ", f.result)
    dump_type(mut out, depth + 1, "error: ", f.error)
    match f.body {
        some(body) => dump_block(mut out, depth + 1, "body: ", body)
        none => {}
    }
}

fn dump_type_params(mut out: builder.Builder, depth: i64, params: []*ast.TypeParam) {
    for p in params {
        line(mut out, depth, "", "TypeParam {at(p.pos)} name={p.name}{named("constraints", text.join(p.constraints, "+"))}")
    }
}

fn dump_params(mut out: builder.Builder, depth: i64, params: []*ast.Param) {
    for p in params {
        line(mut out, depth, "", "Param {at(p.pos)} name={p.name}{flag("mut", p.mutable)}")
        dump_type(mut out, depth + 1, "type: ", p.type_name)
    }
}

fn dump_variant(mut out: builder.Builder, depth: i64, v: *ast.VariantDecl) {
    var labels = ""
    if v.labels.len > 0 {
        labels = " labels={text.join(v.labels, ",")}"
    }
    line(mut out, depth, "", "Variant {at(v.pos)} name={v.name}{labels}{quoted("doc", v.doc)}")
    for field in v.fields {
        dump_type(mut out, depth + 1, "field: ", field)
    }
    match v.index {
        some(index) => dump_expr(mut out, depth + 1, "index: ", IntLit(index))
        none => {}
    }
}

fn dump_type(mut out: builder.Builder, depth: i64, label: str, target: *ast.TypeName?) {
    let t = target ?? return
    var muts = builder.builder()
    for m in t.muts {
        muts.write_byte(if m { 'm' } else { '-' })
    }
    var head = builder.builder()
    head.write("Type {at(t.pos)}{named("module", t.module)}{named("name", t.name)}")
    head.write(flag("pointer", t.is_pointer))
    head.write(flag("slice", t.is_slice))
    head.write(flag("optional", t.is_optional))
    head.write(flag("map", t.is_map))
    head.write(flag("func", t.is_func))
    head.write(flag("cfunc", t.is_c_func))
    head.write(named("muts", muts.to_str()))
    line(mut out, depth, label, head.to_str())
    dump_type(mut out, depth + 1, "key: ", t.key)
    for arg in t.args {
        dump_type(mut out, depth + 1, "arg: ", arg)
    }
    for param in t.params {
        dump_type(mut out, depth + 1, "param: ", param)
    }
    dump_type(mut out, depth + 1, "result: ", t.result)
    dump_type(mut out, depth + 1, "error: ", t.error)
    dump_type(mut out, depth + 1, "elem: ", t.elem)
}

fn dump_block(mut out: builder.Builder, depth: i64, label: str, b: *ast.Block) {
    line(mut out, depth, label, "Block {at(b.pos)}{typed("type", b.type)}")
    for s in b.stmts {
        dump_stmt(mut out, depth + 1, "", s)
    }
    dump_optional(mut out, depth + 1, "tail: ", b.tail)
}

fn dump_struct_pattern(mut out: builder.Builder, depth: i64, label: str, target: *ast.StructPattern?) {
    let p = target ?? return
    line(mut out, depth, label, "StructPattern {at(p.pos)}{typed("type", p.type)}{local("temp", p.temp)}")
    for field in p.fields {
        line(mut out, depth + 1, "", "FieldPattern {at(field.pos)} name={field.name}{flag("shorthand", field.shorthand)}{field_ref("field", field.field)}")
        match field.bind {
            some(bind) => dump_binding(mut out, depth + 2, "bind: ", bind)
            none => {}
        }
        dump_struct_pattern(mut out, depth + 2, "nested: ", field.nested)
        dump_optional(mut out, depth + 2, "source: ", field.source)
    }
}

fn dump_binding(mut out: builder.Builder, depth: i64, label: str, b: *ast.Binding) {
    line(mut out, depth, label, "Binding {at(b.pos)} name={b.name}{local("local", b.local)}")
}

fn dump_stmt(mut out: builder.Builder, depth: i64, label: str, target: ast.Stmt) {
    match target {
        Let(s) => {
            line(mut out, depth, label, "Let {at(s.pos)}{named("name", s.name)}{flag("mut", s.mutable)}{flag("using", s.is_using)}{local("local", s.local)}")
            dump_struct_pattern(mut out, depth + 1, "pattern: ", s.pattern)
            dump_type(mut out, depth + 1, "type: ", s.type_name)
            dump_expr(mut out, depth + 1, "value: ", s.value)
            dump_optional_stmt(mut out, depth + 1, "release: ", s.release)
        }
        Assign(s) => {
            line(mut out, depth, label, "Assign {at(s.pos)} op={lexer.kind_text(s.op)}{flag("splat", s.splat)}{local("flag", s.flag)}")
            dump_expr(mut out, depth + 1, "target: ", s.target)
            dump_expr(mut out, depth + 1, "value: ", s.value)
            match s.entry {
                some(entry) => dump_expr(mut out, depth + 1, "entry: ", Index(entry))
                none => {}
            }
            dump_optional_stmt(mut out, depth + 1, "release: ", s.release)
        }
        ExprStmt(s) => {
            line(mut out, depth, label, "ExprStmt")
            dump_expr(mut out, depth + 1, "x: ", s.x)
        }
        For(s) => {
            line(mut out, depth, label, "For {at(s.pos)}{named("label", s.label)}")
            dump_optional(mut out, depth + 1, "cond: ", s.cond)
            dump_block(mut out, depth + 1, "body: ", s.body)
        }
        Break(s) => line(mut out, depth, label, "Break {at(s.pos)}{named("label", s.label)}{number("depth", s.depth)}")
        Continue(s) => line(mut out, depth, label, "Continue {at(s.pos)}{named("label", s.label)}{number("depth", s.depth)}")
        Return(s) => {
            line(mut out, depth, label, "Return {at(s.pos)}")
            dump_optional(mut out, depth + 1, "value: ", s.value)
        }
        Fail(s) => {
            line(mut out, depth, label, "Fail {at(s.pos)}")
            dump_expr(mut out, depth + 1, "value: ", s.value)
        }
        Defer(s) => {
            line(mut out, depth, label, "Defer {at(s.pos)}")
            dump_stmt(mut out, depth + 1, "body: ", s.body)
        }
        Spawn(s) => {
            line(mut out, depth, label, "Spawn {at(s.pos)}")
            dump_expr(mut out, depth + 1, "call: ", Call(s.call))
            match s.body {
                some(body) => dump_block(mut out, depth + 1, "body: ", body)
                none => {}
            }
        }
        Send(s) => {
            line(mut out, depth, label, "Send {at(s.pos)}")
            dump_expr(mut out, depth + 1, "chan: ", s.chan)
            dump_expr(mut out, depth + 1, "value: ", s.value)
        }
        ForIn(s) => {
            var head = builder.builder()
            head.write("ForIn {at(s.pos)}{named("label", s.label)}{named("key", s.key)}{named("value", s.value)}")
            head.write(local("key_local", s.key_local))
            head.write(local("value_local", s.value_local))
            line(mut out, depth, label, head.to_str())
            dump_struct_pattern(mut out, depth + 1, "pattern: ", s.pattern)
            dump_expr(mut out, depth + 1, "iter: ", s.iter)
            dump_optional(mut out, depth + 1, "end: ", s.end)
            dump_block(mut out, depth + 1, "body: ", s.body)
        }
    }
}

fn dump_optional_stmt(mut out: builder.Builder, depth: i64, label: str, target: ast.Stmt?) {
    match target {
        some(s) => dump_stmt(mut out, depth, label, s)
        none => {}
    }
}

fn dump_exprs(mut out: builder.Builder, depth: i64, label: str, list: []ast.Expr) {
    for e in list {
        dump_expr(mut out, depth, label, e)
    }
}

fn dump_optional(mut out: builder.Builder, depth: i64, label: str, target: ast.Expr?) {
    match target {
        some(e) => dump_expr(mut out, depth, label, e)
        none => {}
    }
}

fn dump_arms(mut out: builder.Builder, depth: i64, arms: []*ast.Arm) {
    for arm in arms {
        let p = arm.pattern
        line(mut out, depth, "", "Arm {at(p.pos)}{named("name", p.name)}{variant_ref(p.variant)}{local("local", p.local)}")
        for b in p.bindings {
            dump_binding(mut out, depth + 1, "", b)
        }
        dump_optional(mut out, depth + 1, "test: ", p.test)
        dump_expr(mut out, depth + 1, "body: ", arm.body)
    }
}

fn dump_spec(mut out: builder.Builder, depth: i64, target: *ast.Spec?) {
    let s = target ?? return
    line(mut out, depth, "", "Spec width={s.width} at={at(s.width_pos)}")
    let f = s.format ?? return
    var head = builder.builder()
    head.write("Format {at(f.pos)} kind={i64(f.kind)} text={lexer.quote(f.text)} precision={f.precision}")
    head.write(flag("explicit", f.explicit))
    head.write(" min_int={f.min_int} min_frac={f.min_frac} max_frac={f.max_frac}")
    head.write(flag("group", f.group))
    line(mut out, depth + 1, "", head.to_str())
}

fn field_form(form: ast.FieldForm) -> i64 {
    match form {
        FieldWritten => 0
        FieldShorthand => 1
        FieldImplied => 2
    }
}

fn select_kind(kind: ast.SelectKind) -> i64 {
    match kind {
        RecvCase => 0
        SendCase => 1
        AfterCase => 2
        ElseCase => 3
    }
}

fn dump_struct_lit(mut out: builder.Builder, depth: i64, label: str, e: *ast.StructLit) {
    line(mut out, depth, label, "StructLit {at(e.pos)}{named("module", e.module)} name={e.name}{typed("type", e.type)}")
    for arg in e.type_args {
        dump_type(mut out, depth + 1, "type_arg: ", arg)
    }
    for field in e.fields {
        line(mut out, depth + 1, "", "FieldInit {at(field.pos)} name={field.name} form={field_form(field.form)}{field_ref("field", field.field)}")
        dump_expr(mut out, depth + 2, "value: ", field.value)
    }
}

fn dump_select(mut out: builder.Builder, depth: i64, label: str, e: *ast.Select) {
    line(mut out, depth, label, "Select {at(e.pos)}{typed("type", e.type)}")
    for c in e.cases {
        line(mut out, depth + 1, "", "SelectCase {at(c.pos)} kind={select_kind(c.kind)}{named("name", c.name)}{local("local", c.local)}")
        dump_optional(mut out, depth + 2, "chan: ", c.chan)
        dump_optional(mut out, depth + 2, "value: ", c.value)
        dump_expr(mut out, depth + 2, "body: ", c.body)
    }
}

fn dump_ident(mut out: builder.Builder, depth: i64, label: str, e: *ast.Ident) {
    var head = builder.builder()
    head.write("Ident {at(e.pos)} name={e.name}{typed("type", e.type)}")
    head.write(local("local", e.local))
    head.write(variant_ref(e.variant))
    head.write(flag("null", e.null))
    head.write(func_ref("func", e.func))
    head.write(const_ref(e.constant))
    head.write(flag("moved", e.moved))
    line(mut out, depth, label, head.to_str())
}

fn dump_selector(mut out: builder.Builder, depth: i64, label: str, e: *ast.Selector) {
    var head = builder.builder()
    head.write("Selector {at(e.pos)} name={e.name}{typed("type", e.type)}")
    head.write(variant_ref(e.variant))
    head.write(field_ref("field", e.field))
    head.write(field_ref("reference", e.reference))
    head.write(builtin_ref("property", e.property))
    head.write(func_ref("func", e.func))
    head.write(const_ref(e.constant))
    line(mut out, depth, label, head.to_str())
    dump_expr(mut out, depth + 1, "x: ", e.x)
}

fn dump_call(mut out: builder.Builder, depth: i64, label: str, e: *ast.Call) {
    var head = builder.builder()
    head.write("Call {at(e.pos)}{flag("prepended", e.prepended)}{typed("type", e.type)}")
    head.write(func_ref("target", e.target))
    head.write(func_ref("render", e.render))
    head.write(builtin_ref("builtin", e.builtin))
    head.write(variant_ref(e.variant))
    head.write(quoted("embed", e.embed))
    head.write(number("size", e.size))
    if e.digest != 0 {
        head.write(" digest={e.digest}")
    }
    line(mut out, depth, label, head.to_str())
    dump_expr(mut out, depth + 1, "fn: ", e.callee)
    dump_exprs(mut out, depth + 1, "arg: ", e.args)
}

fn dump_expr(mut out: builder.Builder, depth: i64, label: str, target: ast.Expr) {
    match target {
        Block(e) => dump_block(mut out, depth, label, e)
        IntLit(e) => line(mut out, depth, label, "IntLit {at(e.pos)} value={e.value}{flag("char", e.char)}{flag("wide", e.wide)}{typed("type", e.type)}")
        FloatLit(e) => line(mut out, depth, label, "FloatLit {at(e.pos)} bits={text.float_bits(e.value)}{typed("type", e.type)}")
        StrLit(e) => line(mut out, depth, label, "StrLit {at(e.pos)} value={lexer.quote(e.value)}{typed("type", e.type)}")
        BoolLit(e) => line(mut out, depth, label, "BoolLit {at(e.pos)} value={e.value}{typed("type", e.type)}")
        Ident(e) => dump_ident(mut out, depth, label, e)
        Selector(e) => dump_selector(mut out, depth, label, e)
        StructLit(e) => dump_struct_lit(mut out, depth, label, e)
        Ref(e) => {
            line(mut out, depth, label, "Ref {at(e.pos)}{typed("type", e.type)}")
            dump_expr(mut out, depth + 1, "x: ", e.x)
        }
        Index(e) => {
            line(mut out, depth, label, "Index {at(e.pos)}{typed("type", e.type)}")
            dump_expr(mut out, depth + 1, "x: ", e.x)
            dump_expr(mut out, depth + 1, "index: ", e.index)
        }
        Instance(e) => {
            line(mut out, depth, label, "Instance {at(e.pos)}{typed("type", e.type)}")
            dump_expr(mut out, depth + 1, "x: ", e.x)
            for t in e.types {
                dump_type(mut out, depth + 1, "type: ", t)
            }
            dump_optional(mut out, depth + 1, "fallback: ", e.fallback)
        }
        Closure(e) => {
            line(mut out, depth, label, "Closure {at(e.pos)}{flag("inline", e.inline)}{typed("type", e.type)}{func_ref("func", e.func)}")
            dump_params(mut out, depth + 1, e.params)
            dump_locals(mut out, depth + 1, "capture: ", e.captures)
            dump_type(mut out, depth + 1, "result: ", e.result)
            dump_type(mut out, depth + 1, "error: ", e.error)
            dump_block(mut out, depth + 1, "body: ", e.body)
        }
        Slicing(e) => {
            line(mut out, depth, label, "Slicing {at(e.pos)}{typed("type", e.type)}")
            dump_expr(mut out, depth + 1, "x: ", e.x)
            dump_optional(mut out, depth + 1, "lo: ", e.lo)
            dump_optional(mut out, depth + 1, "hi: ", e.hi)
        }
        SliceLit(e) => {
            line(mut out, depth, label, "SliceLit {at(e.pos)}{flag("read_only", e.read_only)}{typed("type", e.type)}")
            dump_exprs(mut out, depth + 1, "", e.elems)
        }
        Interp(e) => {
            line(mut out, depth, label, "Interp {at(e.pos)}{typed("type", e.type)}")
            for part in e.parts {
                dump_expr(mut out, depth + 1, "part: ", part.x)
                dump_spec(mut out, depth + 2, part.spec)
                match part.render {
                    some(render) => line(mut out, depth + 2, "", "Render {lexer.quote(func_name(render))}")
                    none => {}
                }
            }
        }
        MapLit(e) => {
            line(mut out, depth, label, "MapLit {at(e.pos)}{flag("read_only", e.read_only)}{typed("type", e.type)}")
            for i, key in e.keys {
                dump_expr(mut out, depth + 1, "key: ", key)
                dump_expr(mut out, depth + 1, "value: ", e.values[i])
            }
        }
        Unary(e) => {
            line(mut out, depth, label, "Unary {at(e.pos)} op={lexer.kind_text(e.op)}{typed("type", e.type)}")
            dump_expr(mut out, depth + 1, "x: ", e.x)
        }
        Binary(e) => {
            line(mut out, depth, label, "Binary {at(e.pos)} op={lexer.kind_text(e.op)}{flag("splat_x", e.splat_x)}{flag("splat_y", e.splat_y)}{typed("type", e.type)}")
            dump_expr(mut out, depth + 1, "x: ", e.x)
            dump_expr(mut out, depth + 1, "y: ", e.y)
        }
        Call(e) => dump_call(mut out, depth, label, e)
        If(e) => {
            line(mut out, depth, label, "If {at(e.pos)}{typed("type", e.type)}")
            dump_expr(mut out, depth + 1, "cond: ", e.cond)
            dump_block(mut out, depth + 1, "then: ", e.then)
            dump_optional(mut out, depth + 1, "else: ", e.otherwise)
        }
        Match(e) => {
            line(mut out, depth, label, "Match {at(e.pos)}{typed("type", e.type)}")
            dump_expr(mut out, depth + 1, "x: ", e.x)
            dump_arms(mut out, depth + 1, e.arms)
        }
        Select(e) => dump_select(mut out, depth, label, e)
        Subject(e) => line(mut out, depth, label, "Subject {at(e.pos)}{typed("type", e.type)}")
        Receiver(e) => {
            line(mut out, depth, label, "Receiver{typed("type", e.type)}")
            dump_expr(mut out, depth + 1, "x: ", e.x)
        }
        Try(e) => {
            line(mut out, depth, label, "Try {at(e.pos)}{typed("type", e.type)}")
            dump_expr(mut out, depth + 1, "x: ", e.x)
        }
        Catch(e) => {
            line(mut out, depth, label, "Catch {at(e.pos)}{typed("type", e.type)}")
            dump_expr(mut out, depth + 1, "x: ", e.x)
            dump_arms(mut out, depth + 1, e.arms)
            match e.map {
                some(map) => dump_expr(mut out, depth + 1, "map: ", Call(map))
                none => {}
            }
        }
        Or(e) => {
            line(mut out, depth, label, "Or {at(e.pos)}{typed("type", e.type)}")
            dump_expr(mut out, depth + 1, "x: ", e.x)
            dump_expr(mut out, depth + 1, "fallback: ", e.fallback)
        }
        When(e) => {
            line(mut out, depth, label, "When {at(e.pos)}{typed("type", e.type)}")
            dump_expr(mut out, depth + 1, "x: ", e.x)
            dump_expr(mut out, depth + 1, "cond: ", e.cond)
        }
    }
}
