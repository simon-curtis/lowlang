import ast
import builtin
import lexer
import std/builder
import std/slices
import std/text
import types

fn typed(name: str, target: *types.Type?) -> str {
    let t = target ?? return ""
    " {name}={lexer.quote(types.text(t))}"
}

fn type_texts(list: []*types.Type) -> []str {
    var texts: []str = []
    for t in list {
        push(mut texts, types.text(t))
    }
    texts
}

fn type_list(name: str, list: []*types.Type) -> str {
    if list.len == 0 {
        return ""
    }
    " {name}={lexer.quote(text.join(type_texts(list), ", "))}"
}

fn local_text(l: *ast.Local) -> str {
    var b = builder.builder()
    b.write(l.name)
    match l.type {
        some(t) => b.write(" {types.text(t)}")
        none => {}
    }
    b.write(flag("mutable", l.mutable))
    b.write(flag("param", l.param))
    b.write(flag("ref", l.ref))
    b.write(flag("addressed", l.addressed))
    b.write(flag("captured", l.captured))
    b.write(flag("assigned", l.assigned))
    match l.owner {
        some(owner) => b.write(" owner={func_name(owner)}")
        none => {}
    }
    match l.flag {
        some(flagged) => b.write(" flag={flagged.name}")
        none => {}
    }
    b.to_str()
}

fn local(name: str, target: *ast.Local?) -> str {
    let l = target ?? return ""
    " {name}={lexer.quote(local_text(l))}"
}

fn func_name(f: *ast.Func) -> str {
    var b = builder.builder()
    match f.file {
        some(file) => {
            if file.module != "" {
                b.write("{file.module}.")
            }
        }
        none => {}
    }
    b.write(f.name)
    if f.type_args.len > 0 {
        b.write("[{text.join(type_texts(f.type_args), ", ")}]")
    }
    b.to_str()
}

fn func_ref(name: str, target: *ast.Func?) -> str {
    let f = target ?? return ""
    " {name}={lexer.quote(func_name(f))}"
}

fn const_ref(target: *ast.Const?) -> str {
    let k = target ?? return ""
    " const={k.name}"
}

fn variant_ref(target: *types.Variant?) -> str {
    let v = target ?? return ""
    " variant={v.name}#{v.tag}"
}

fn field_ref(name: str, target: *types.Field?) -> str {
    let f = target ?? return ""
    " {name}={f.name}@{f.bytes}"
}

fn builtin_ref(name: str, id: builtin.ID) -> str {
    if id == builtin.ID.None {
        return ""
    }
    " {name}={id.index}"
}

fn number(name: str, n: i64) -> str {
    if n == 0 {
        return ""
    }
    " {name}={n}"
}

fn bound(bindings: [str: *types.Type]) -> str {
    if bindings.len == 0 {
        return ""
    }
    var names: []str = []
    for name, t in bindings {
        push(mut names, name)
    }
    slices.sort(mut names)
    var texts: []str = []
    for name in names {
        let t = bindings[name] ?? continue
        push(mut texts, "{name}={types.text(t)}")
    }
    " bound={lexer.quote(text.join(texts, ", "))}"
}

fn dump_layout(mut out: builder.Builder, depth: i64, target: *types.Type?) {
    let t = target ?? return
    line(mut out, depth, "", "Layout {lexer.quote(types.text(t))} bytes={t.bytes} align={t.align} size={types.size(t)}")
    for f in t.fields {
        line(mut out, depth + 1, "", "field {f.name}@{f.bytes}{flag("pub", f.exported)}{typed("type", f.type)}")
    }
    for v in t.variants {
        var offsets: []str = []
        for offset in v.offsets {
            push(mut offsets, "{offset}")
        }
        var head = builder.builder()
        head.write("variant {v.name}#{v.tag} index={v.index}")
        head.write(type_list("fields", v.fields))
        head.write(named("labels", text.join(v.labels, ",")))
        head.write(named("offsets", text.join(offsets, ",")))
        line(mut out, depth + 1, "", head.to_str())
    }
}

fn dump_locals(mut out: builder.Builder, depth: i64, label: str, list: []*ast.Local) {
    for l in list {
        line(mut out, depth, label, local_text(l))
    }
}
