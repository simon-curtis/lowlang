import regex
import std/builder
import std/text

fn dump_regex_command(mut out: builder.Builder, src: str) {
    for pattern in text.split(text.trim_suffix(src, "\n"), '\n') {
        dump_regex(mut out, pattern)
    }
}

fn dump_regex(mut out: builder.Builder, pattern: str) {
    let prog = regex.compile(pattern) catch {
        e => {
            out.write("error: {regex.message(e)}\n---\n")
            return
        }
    }
    let source = regex.generate("__regex_test", pattern, prog)
    out.write(source)
    out.write("---\n")
}
