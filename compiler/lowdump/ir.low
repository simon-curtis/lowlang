import compiler
import ir
import std/builder
import std/slices

fn dump_ir_command(mut out: builder.Builder, path: str, flags: []str) ! compiler.Error {
    let unit = compiler.check(path, platform_of(flags))?
    let optimise = !slices.contains(flags, "-unoptimised")
    let program = ir.build(unit.universe, unit.files, optimise)
    for f in program.funcs {
        ir.write_func(mut out, f)
    }
}
