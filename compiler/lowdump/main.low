import diag
import lexer
import std/builder
import std/file
import std/os
import std/sys
import std/text

const usage = "usage:\n  lowdump tokens [-privileged] <file.low>"

enum Error {
    Usage
    Read(path: str)
    Compile(diag.Error)
}

fn main() {
    var out = builder.builder()
    let failure = run(mut out, os.args()[1..]) catch {
        e => describe(e)
    }
    write_all(1, out.to_bytes())
    if failure != "" {
        write_all(2, bytes("{failure}\n"))
        os.exit(1)
    }
}

fn describe(e: Error) -> str {
    match e {
        Usage => usage
        Read(path) => "open {path}: no such file or directory"
        Compile(inner) => diag.message(inner)
    }
}

fn write_all(fd: i64, data: []u8) {
    var rest = data
    for rest.len > 0 {
        let n = sys.try_write(fd, rest) or return
        rest = rest[n..]
    }
}

fn run(mut out: builder.Builder, args: []str) -> str ! Error {
    if args.len < 2 {
        fail Usage
    }
    let privileged = args[1] == "-privileged"
    let path = args[args.len - 1]
    let src = file.read_text(path) or fail Read(path)
    match args[0] {
        "tokens" => {
            let tokens = lexer.lex(src, diag.start(path), privileged) catch Compile
            dump_tokens(mut out, tokens, 0)
        }
        _ => fail Usage
    }
    ""
}

fn dump_tokens(mut out: builder.Builder, tokens: []lexer.Token, depth: i64) {
    let indent = text.repeat(" ", depth)
    for t in tokens {
        out.write("{indent}{t.pos.line}:{t.pos.col} {t.start}-{t.end} {lexer.kind_text(t.kind)}")
        if t.text != "" {
            out.write(" text={lexer.quote(t.text)}")
        }
        if t.kind == lexer.Kind.Char {
            out.write(" char={t.char}")
        }
        if t.doc_at.line != 0 {
            out.write(" doc={t.doc_at.line}:{t.doc_at.col} {lexer.quote(t.doc)}")
        }
        out.write("\n")
        for part in t.parts {
            if !part.expr {
                out.write("{indent}  part text={lexer.quote(part.text)}\n")
                continue
            }
            out.write("{indent}  part expr")
            if part.spec_pos.line != 0 {
                out.write(" spec={lexer.quote(part.spec)} at {part.spec_pos.line}:{part.spec_pos.col}")
            }
            out.write("\n")
            dump_tokens(mut out, part.tokens, depth + 4)
        }
    }
}
