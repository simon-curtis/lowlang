import asm
import compiler
import diag
import lexer
import parser
import std/builder
import std/file
import std/os
import std/sys

const usage = "usage:\n  lowdump tokens [-privileged] <file.low>\n  lowdump ast [-privileged] <file.low>\n  lowdump check [-windows] <file.low|dir>\n  lowdump object [-clang] [-align-branches] <file.s>\n  lowdump regex <patterns.txt>"

enum Error {
    Usage
    Read(path: str)
    Compile(diag.Error)
    Assemble(asm.Error)
    Check(compiler.Error)
}

fn main() {
    var out = builder.builder()
    let failure = run(mut out, os.args()[1..]) catch {
        e => describe(e)
    }
    write_all(1, out.to_bytes())
    if failure != "" {
        write_all(2, bytes("{failure}\n"))
        os.exit(1)
    }
}

fn describe(e: Error) -> str {
    match e {
        Usage => usage
        Read(path) => "open {path}: no such file or directory"
        Compile(inner) => diag.message(inner)
        Assemble(inner) => asm.message(inner)
        Check(inner) => compiler.message(inner)
    }
}

fn write_all(fd: i64, data: []u8) {
    var rest = data
    for rest.len > 0 {
        let n = sys.try_write(fd, rest) or return
        rest = rest[n..]
    }
}

fn run(mut out: builder.Builder, args: []str) -> str ! Error {
    if args.len < 2 {
        fail Usage
    }
    let privileged = args[1] == "-privileged"
    let path = args[args.len - 1]
    if args[0] == "check" {
        dump_check_command(mut out, path, args[1..args.len - 1]) catch Check
        return ""
    }
    let src = file.read_text(path) or fail Read(path)
    match args[0] {
        "tokens" => {
            let tokens = lexer.lex(src, diag.start(path), privileged) catch Compile
            dump_tokens(mut out, tokens, 0)
        }
        "ast" => {
            let f = parser.parse_source(src, diag.start(path), privileged) catch Compile
            dump_file(mut out, f)
        }
        "object" => dump_object_command(mut out, src, args[1..args.len - 1])?
        "regex" => dump_regex_command(mut out, src)
        _ => fail Usage
    }
    ""
}
