import asm
import link
import std/file

struct LinkOptions {
    windows: bool = false
    opts: asm.Options
    libraries: []str = []
    dirs: []str
    paths: []str = []
}

fn parse_link_flags(args: []str) -> LinkOptions ! Error {
    var opts = asm.Options {}
    var windows = false
    var libraries: []str = []
    var dirs = link.system_dirs()
    var custom_dirs = false
    var paths: []str = []
    var i = 0
    for i < args.len {
        match args[i] {
            "-windows" => {
                windows = true
            }
            "-embed" => {
                i += 1
                if i == args.len {
                    fail Usage
                }
                embed_flag(mut opts, args[i])?
            }
            "-lib" => {
                i += 1
                if i == args.len {
                    fail Usage
                }
                push(mut libraries, args[i])
            }
            "-libdir" => {
                i += 1
                if i == args.len {
                    fail Usage
                }
                if !custom_dirs {
                    dirs = []
                    custom_dirs = true
                }
                push(mut dirs, args[i])
            }
            _ => {
                push(mut paths, args[i])
            }
        }
        i += 1
    }
    LinkOptions { windows, opts, libraries, dirs, paths }
}

fn dump_link_command(args: []str) ! Error {
    let options = parse_link_flags(args)?
    if options.paths.len != 2 {
        fail Usage
    }
    let source_path = options.paths[0]
    let output_path = options.paths[1]
    let src = file.read_text(source_path) or fail Read(source_path)
    var opts = options.opts
    if options.windows {
        opts.clang_layout = true
    } else {
        opts.align_branches = true
    }
    let object = asm.assemble(src, opts) catch Assemble
    let bytes = link_object(object, options)?
    file.write_file_mode(output_path, bytes, 0o755) or fail Write(output_path)
}

fn link_object(object: asm.Object, options: LinkOptions) -> []u8 ! Error {
    if options.windows {
        return link.pe(object) catch Link
    }
    if options.libraries.len == 0 {
        let image = link.static(object) catch Link
        return image.bytes
    }
    let resolver = link.Resolver { dirs: options.dirs }
    let resolved = link.resolve(resolver, options.libraries) catch Link
    let image = link.dynamic(object, resolved) catch Link
    image.bytes
}
