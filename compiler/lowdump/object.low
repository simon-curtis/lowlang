import asm
import lexer
import std/builder
import std/file
import std/text

fn dump_object_command(mut out: builder.Builder, src: str, flags: []str) ! Error {
    var opts = asm.Options {}
    var i = 0
    for i < flags.len {
        match flags[i] {
            "-clang" => {
                opts.clang_layout = true
            }
            "-align-branches" => {
                opts.align_branches = true
            }
            "-embed" => {
                i += 1
                if i == flags.len {
                    fail Usage
                }
                embed_flag(mut opts, flags[i])?
            }
            _ => fail Usage
        }
        i += 1
    }
    let object = asm.assemble(src, opts) catch Assemble
    dump_object(mut out, object)
}

fn embed_flag(mut opts: asm.Options, value: str) ! Error {
    let eq = text.index_byte(value, '=')
    if eq < 0 {
        fail Usage
    }
    let name = value[0..eq]
    let path = value[eq + 1..]
    let data = file.read_file(path) or fail Read(path)
    opts.embeds[name] = data
}

fn dump_object(mut out: builder.Builder, object: asm.Object) {
    for sec in object.sections {
        let name = lexer.quote(sec.name)
        let flags = asm.flags_text(sec.flags)
        out.write("section {name} flags={flags} align={sec.align} nobits={sec.nobits} size={sec.size}\n")
        out.write("  data ")
        write_hex(mut out, sec.data)
        out.write("\n")
        for f in sec.fixups {
            let kind = asm.fixup_kind_text(f.kind)
            let symbol = lexer.quote(f.symbol)
            out.write("  fixup offset={f.offset} kind={kind} symbol={symbol} addend={f.addend} line={f.line}\n")
        }
    }
    for sym in object.symbols {
        let name = lexer.quote(sym.name)
        out.write("symbol {name} section={sym.section} value={sym.value} global={sym.global}\n")
    }
}

fn write_hex(mut out: builder.Builder, data: []u8) {
    for c in data {
        out.write_byte(text.digit_char(i64(c >> 4)))
        out.write_byte(text.digit_char(i64(c & 15)))
    }
}
