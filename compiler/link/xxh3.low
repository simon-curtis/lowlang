import std/io

const xxh_prime32x1: u64 = 0x9E3779B1
const xxh_prime32x2: u64 = 0x85EBCA77
const xxh_prime32x3: u64 = 0xC2B2AE3D
const xxh_prime64x1: u64 = 0x9E3779B185EBCA87
const xxh_prime64x2: u64 = 0xC2B2AE3D27D4EB4F
const xxh_prime64x3: u64 = 0x165667B19E3779F9
const xxh_prime64x4: u64 = 0x85EBCA77C2B2AE63
const xxh_prime64x5: u64 = 0x27D4EB2F165667C5
const xxh_mix1: u64 = 0x165667919E3779F9

const xxh_stripe = 64
const xxh_secret_step = 8
const xxh_secret_merge = 11
const xxh_secret_last = 7

fn xxh_secret() -> []u8 {
    [
        0xb8, 0xfe, 0x6c, 0x39, 0x23, 0xa4, 0x4b, 0xbe, 0x7c, 0x01, 0x81, 0x2c, 0xf7, 0x21, 0xad, 0x1c,
        0xde, 0xd4, 0x6d, 0xe9, 0x83, 0x90, 0x97, 0xdb, 0x72, 0x40, 0xa4, 0xa4, 0xb7, 0xb3, 0x67, 0x1f,
        0xcb, 0x79, 0xe6, 0x4e, 0xcc, 0xc0, 0xe5, 0x78, 0x82, 0x5a, 0xd0, 0x7d, 0xcc, 0xff, 0x72, 0x21,
        0xb8, 0x08, 0x46, 0x74, 0xf7, 0x43, 0x24, 0x8e, 0xe0, 0x35, 0x90, 0xe6, 0x81, 0x3a, 0x26, 0x4c,
        0x3c, 0x28, 0x52, 0xbb, 0x91, 0xc3, 0x00, 0xcb, 0x88, 0xd0, 0x65, 0x8b, 0x1b, 0x53, 0x2e, 0xa3,
        0x71, 0x64, 0x48, 0x97, 0xa2, 0x0d, 0xf9, 0x4e, 0x38, 0x19, 0xef, 0x46, 0xa9, 0xde, 0xac, 0xd8,
        0xa8, 0xfa, 0x76, 0x3f, 0xe3, 0x9c, 0x34, 0x3f, 0xf9, 0xdc, 0xbb, 0xc7, 0xc7, 0x0b, 0x4f, 0x1d,
        0x8a, 0x51, 0xe0, 0x4b, 0xcd, 0xb4, 0x59, 0x31, 0xc8, 0x9f, 0x7e, 0xc9, 0xd9, 0x78, 0x73, 0x64,
        0xea, 0xc5, 0xac, 0x83, 0x34, 0xd3, 0xeb, 0xc3, 0xc5, 0x81, 0xa0, 0xff, 0xfa, 0x13, 0x63, 0xeb,
        0x17, 0x0d, 0xdd, 0x51, 0xb7, 0xf0, 0xda, 0x49, 0xd3, 0x16, 0x55, 0x26, 0x29, 0xd4, 0x68, 0x9e,
        0x2b, 0x16, 0xbe, 0x58, 0x7d, 0x47, 0xa1, 0xfc, 0x8f, 0xf8, 0xb8, 0xd1, 0x7a, 0xd0, 0x31, 0xce,
        0x45, 0xcb, 0x3a, 0x8f, 0x95, 0x16, 0x04, 0x28, 0xaf, 0xd7, 0xfb, 0xca, 0xbb, 0x4b, 0x40, 0x7e
    ]
}

fn new_xxh_accumulator() -> []u64 {
    [
        xxh_prime32x3, xxh_prime64x1, xxh_prime64x2, xxh_prime64x3,
        xxh_prime64x4, xxh_prime32x2, xxh_prime64x5, xxh_prime32x1
    ]
}

fn xxh_stripe_round(acc: []u64, input: []u8, input_at: i64, secret: []u8, secret_at: i64) {
    for i in 0..8 {
        let value = io.u64_le(input, input_at + 8 * i)
        let key = value ^ io.u64_le(secret, secret_at + 8 * i)
        acc[i ^ 1] += value
        acc[i] += (key & 0xFFFFFFFF) * (key >> 32)
    }
}

fn xxh_scramble(acc: []u64, secret: []u8, secret_at: i64) {
    for i in 0..8 {
        var value = acc[i]
        value ^= value >> 47
        value ^= io.u64_le(secret, secret_at + 8 * i)
        acc[i] = value * xxh_prime32x1
    }
}

fn mul_high(a: u64, b: u64) -> u64 {
    let a_low = a & 0xFFFFFFFF
    let a_high = a >> 32
    let b_low = b & 0xFFFFFFFF
    let b_high = b >> 32
    let low_low = a_low * b_low
    let low_high = a_low * b_high
    let high_low = a_high * b_low
    let high_high = a_high * b_high
    let middle = (low_low >> 32) + (low_high & 0xFFFFFFFF) + (high_low & 0xFFFFFFFF)
    high_high + (low_high >> 32) + (high_low >> 32) + (middle >> 32)
}

fn xxh_merge(acc: []u64, secret: []u8, secret_at: i64, start: u64) -> u64 {
    var result = start
    for i in 0..4 {
        let low = acc[2 * i] ^ io.u64_le(secret, secret_at + 16 * i)
        let high = acc[2 * i + 1] ^ io.u64_le(secret, secret_at + 16 * i + 8)
        let hi = mul_high(low, high)
        let lo = low * high
        result += hi ^ lo
    }
    result ^= result >> 37
    result *= xxh_mix1
    result ^ result >> 32
}

pub fn xxh3_long(data: []u8) -> u64 {
    let secret = xxh_secret()
    let acc = new_xxh_accumulator()
    let stripes_per_block = (secret.len - xxh_stripe) / xxh_secret_step
    let block_size = xxh_stripe * stripes_per_block
    let blocks = (data.len - 1) / block_size
    for b in 0..blocks {
        let block_at = b * block_size
        for s in 0..stripes_per_block {
            xxh_stripe_round(acc, data, block_at + s * xxh_stripe, secret, s * xxh_secret_step)
        }
        xxh_scramble(acc, secret, secret.len - xxh_stripe)
    }
    let tail_at = blocks * block_size
    let stripes = (data.len - 1 - tail_at) / xxh_stripe
    for s in 0..stripes {
        xxh_stripe_round(acc, data, tail_at + s * xxh_stripe, secret, s * xxh_secret_step)
    }
    xxh_stripe_round(acc, data, data.len - xxh_stripe, secret, secret.len - xxh_stripe - xxh_secret_last)
    xxh_merge(acc, secret, xxh_secret_merge, u64(data.len) * xxh_prime64x1)
}
