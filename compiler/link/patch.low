import asm
import std/io

pub struct PatchImage {
    pub address: i64
    pub code: []u8
    pub symbols: [str: i64]
}

struct PlacedPatch {
    sections: []*Section
    symbols: [str: i64]
}

pub fn patch(obj: asm.Object, base: i64, running: [str: i64]) -> PatchImage ! Error {
    let placed = place_patch(obj, base)?
    if placed.sections.len == 0 {
        fail PatchEmpty
    }
    let address = placed.sections[0].addr
    let end = section_end(placed.sections[placed.sections.len - 1])
    let image = io.buffer(end - address)
    var spaces: []*FixupSpace = []
    for s in placed.sections {
        io.copy(image[s.addr - address..], s.input.data)
        let space = new(FixupSpace {
            name: s.input.name,
            addr: s.addr,
            offset: s.addr - address,
            size: s.size,
            fixups: s.input.fixups
        })
        push(mut spaces, space)
    }
    let format = patch_format(placed.symbols, running)
    relocate(format, image, spaces)?
    PatchImage { address, code: image, symbols: placed.symbols }
}

fn place_patch(obj: asm.Object, base: i64) -> PlacedPatch ! Error {
    let l = new_linker(obj)
    collect_sections(l)
    for s in l.sections {
        if s.class != class_text && s.class != class_rodata {
            fail PatchSection(s.input.name)
        }
    }
    order_sections(l)
    let address = align_up(base, max_align(l.sections))
    let c = new(Cursor { off: 0, addr: address })
    for s in l.sections {
        place(c, s)
    }
    var symbols: [str: i64] = [:]
    for sym in obj.symbols {
        match resolve_symbol(l, sym) {
            some(value) => {
                symbols[sym.name] = value.value
            }
            none => {}
        }
    }
    PlacedPatch { sections: l.sections, symbols }
}

fn patch_format(defined: [str: i64], running: [str: i64]) -> FixupFormat {
    FixupFormat {
        supports: patch_supports,
        target: fn(space: *FixupSpace, f: asm.Fixup) -> i64? ! Error { patch_target(defined, running, f)? }
    }
}

fn patch_supports(kind: i64) -> bool {
    !asm.fixup_image_relative(kind) && !asm.fixup_got(kind)
}

fn patch_target(defined: [str: i64], running: [str: i64], f: asm.Fixup) -> i64? ! Error {
    match defined[f.symbol] {
        some(address) => return address
        none => {}
    }
    running[f.symbol]
}
