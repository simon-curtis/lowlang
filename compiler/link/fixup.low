import asm
import std/io
import std/slices
import std/text

struct FixupSpace {
    name: str
    addr: i64
    offset: i64
    size: i64
    fixups: []asm.Fixup
}

struct FixupFormat {
    supports: fn(i64) -> bool
    target: fn(*FixupSpace, asm.Fixup) -> i64? ! Error
}

fn relocate(format: FixupFormat, image: []u8, spaces: []*FixupSpace) ! Error {
    var undefined: [str: bool] = [:]
    for space in spaces {
        for f in space.fixups {
            match format.target(space, f)? {
                some(address) => apply_fixup(format, image, space, f, address)?
                none => {
                    undefined[f.symbol] = true
                }
            }
        }
    }
    undefined_symbols_error(undefined)?
}

fn undefined_symbols_error(undefined: [str: bool]) ! Error {
    if undefined.len == 0 {
        return
    }
    var names: []str = []
    for name in undefined {
        push(mut names, name)
    }
    slices.sort(mut names)
    fail Undefined(text.join(names, ", "))
}

fn apply_fixup(format: FixupFormat, image: []u8, space: *FixupSpace, f: asm.Fixup, address: i64) ! Error {
    let width = asm.fixup_width(f.kind)
    let kind = asm.fixup_kind_text(f.kind)
    if width == 0 || !format.supports(f.kind) {
        fail Unsupported(kind, f.symbol, space.name)
    }
    if f.offset < 0 || f.offset + width > space.size {
        fail Outside(kind, f.symbol, space.name)
    }
    let place = space.addr + f.offset
    var value = address + f.addend
    if asm.fixup_pc_relative(f.kind) {
        value -= place
    }
    if !asm.fixup_fits(f.kind, value) {
        let signedness = if asm.fixup_signed(f.kind) { "signed" } else { "unsigned" }
        fail OutOfRange(kind, f.symbol, space.name, f.offset, value, signedness)
    }
    let at = space.offset + f.offset
    if width == 8 {
        io.set_le64(image, at, value)
        return
    }
    io.set_le32(image, at, value)
}

fn entry_address(symbol: str, lookup: fn(str) -> i64?) -> i64 ! Error {
    match lookup(symbol) {
        some(address) => address
        none => fail EntryUndefined(symbol)
    }
}
