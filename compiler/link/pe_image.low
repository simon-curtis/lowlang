import std/io

const pe_linker_major = 14
const pe_version_major = 6

const pe_dll_characteristics = pe_dll_high_entropy_va | pe_dll_dynamic_base | pe_dll_nx_compat | pe_dll_terminal_server_aware
const pe_file_characteristics = pe_file_executable_image | pe_file_large_address_aware

fn pe_signature() -> []u8 {
    [0x50, 0x45, 0, 0]
}

fn pe_dos_stub() -> []u8 {
    [
        0x4d, 0x5a, 0x78, 0x00, 0x01, 0x00, 0x00, 0x00, 0x04, 0x00, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
        0x40, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
        0x78, 0x00, 0x00, 0x00, 0x0e, 0x1f, 0xba, 0x0e, 0x00, 0xb4, 0x09, 0xcd,
        0x21, 0xb8, 0x01, 0x4c, 0xcd, 0x21, 0x54, 0x68, 0x69, 0x73, 0x20, 0x70,
        0x72, 0x6f, 0x67, 0x72, 0x61, 0x6d, 0x20, 0x63, 0x61, 0x6e, 0x6e, 0x6f,
        0x74, 0x20, 0x62, 0x65, 0x20, 0x72, 0x75, 0x6e, 0x20, 0x69, 0x6e, 0x20,
        0x44, 0x4f, 0x53, 0x20, 0x6d, 0x6f, 0x64, 0x65, 0x2e, 0x24, 0x00, 0x00
    ]
}

struct PeSizes {
    code: i64 = 0
    initialized: i64 = 0
    uninitialized: i64 = 0
    base_of_code: i64 = 0
}

fn pe_sizes(l: *PeLinker) -> PeSizes {
    var sizes = PeSizes {}
    for s in l.sections {
        if pe_section_is_code(s) {
            if sizes.code == 0 {
                sizes.base_of_code = s.rva
            }
            sizes.code += s.raw_size
        } else if s.chars & pe_scn_cnt_initialized_data != 0 {
            sizes.initialized += s.raw_size
        } else {
            sizes.uninitialized += align_up(s.virtual_size, pe_file_align)
        }
    }
    sizes
}

fn pe_directory_table(l: *PeLinker) -> []DataDirectory {
    var dirs: []DataDirectory = []
    for _ in 0..pe_data_directories {
        push(mut dirs, DataDirectory {})
    }
    let debug = pe_debug_chunk(l)
    dirs[pe_dir_debug] = DataDirectory { virtual_address: chunk_rva(debug), size: debug.size }
    match pe_prefix_span(l, import_descriptors) {
        some(span) => {
            dirs[pe_dir_import] = span
        }
        none => {}
    }
    match pe_prefix_span(l, import_addresses) {
        some(span) => {
            dirs[pe_dir_iat] = span
        }
        none => {}
    }
    if l.sites.len > 0 {
        let last = l.sections[l.sections.len - 1]
        dirs[pe_dir_base_reloc] = DataDirectory { virtual_address: last.rva, size: last.virtual_size }
    }
    dirs
}

fn pe_debug_chunk(l: *PeLinker) -> *PeChunk {
    match l.debug {
        some(c) => c
        none => panic("link: missing debug chunk")
    }
}

fn pe_write_headers(l: *PeLinker, image: []u8, entry: i64, timestamp: i64) {
    let sizes = pe_sizes(l)
    var encoded: []u8 = []
    io.append(mut encoded, pe_dos_stub())
    io.append(mut encoded, pe_signature())
    let file_header = PeFileHeader {
        number_of_sections: l.sections.len,
        time_date_stamp: timestamp,
        size_of_optional_header: pe_optional_header_size,
        characteristics: pe_file_characteristics
    }
    append_pe_file_header(mut encoded, file_header)
    let optional = PeOptionalHeader {
        size_of_code: sizes.code,
        size_of_initialized_data: sizes.initialized,
        size_of_uninitialized_data: sizes.uninitialized,
        address_of_entry_point: entry,
        base_of_code: sizes.base_of_code,
        image_base: pe_image_base,
        section_alignment: pe_section_align,
        file_alignment: pe_file_align,
        major_operating_system_version: pe_version_major,
        major_subsystem_version: pe_version_major,
        size_of_image: l.image_size,
        size_of_headers: l.header_size,
        dll_characteristics: pe_dll_characteristics,
        size_of_stack_reserve: pe_stack_reserve,
        size_of_stack_commit: pe_stack_commit,
        size_of_heap_reserve: pe_heap_reserve,
        size_of_heap_commit: pe_heap_commit,
        directories: pe_directory_table(l)
    }
    append_pe_optional_header(mut encoded, optional)
    for s in l.sections {
        append_pe_section_header(mut encoded, pe_section_header(s))
    }
    io.copy(image, encoded)
}

fn pe_section_header(s: *PeSection) -> PeSectionHeader {
    PeSectionHeader {
        name: s.name,
        virtual_size: s.virtual_size,
        virtual_address: s.rva,
        size_of_raw_data: s.raw_size,
        pointer_to_raw_data: s.raw_offset,
        characteristics: s.chars
    }
}

fn pe_stamp(l: *PeLinker, image: []u8, entry: i64) {
    let hash = xxh3_long(image)
    let timestamp = i64(hash & 0xFFFFFFFF)
    pe_write_headers(l, image, entry, timestamp)
    let debug = pe_debug_entry(timestamp)
    let at = chunk_file_offset(pe_debug_chunk(l))
    io.copy(image[at..], debug)
}
