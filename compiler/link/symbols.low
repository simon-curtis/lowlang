import asm
import std/text

struct SymbolValue {
    value: i64 = 0
    section: *Section? = none
    absolute: bool = false
    undefined: bool = false
    kind: i64 = 0
}

struct LinkerSymbol {
    name: str
    value: SymbolValue
}

struct EmittedSymbols {
    locals: []LinkerSymbol = []
    globals: []LinkerSymbol = []
}

fn resolve_symbols(l: *Linker) {
    for sym in l.obj.symbols {
        match resolve_symbol(l, sym) {
            some(value) => {
                l.symbols[sym.name] = value
            }
            none => {}
        }
    }
    for defined in boundary_symbols(l) {
        match l.symbols[defined.name] {
            some(_) => {}
            none => {
                l.symbols[defined.name] = defined.value
            }
        }
    }
}

fn resolve_symbol(l: *Linker, sym: asm.Symbol) -> SymbolValue? {
    match sym.section {
        asm.section_undefined => none
        asm.section_absolute => SymbolValue { value: sym.value, absolute: true }
        _ => match l.by_input[sym.section] {
            some(s) => SymbolValue { value: s.addr + sym.value, section: s }
            none => none
        }
    }
}

fn boundary_symbols(l: *Linker) -> []LinkerSymbol {
    var last_data: *Section? = none
    var last_loaded: *Section? = none
    var first_bss: *Section? = none
    for s in l.sections {
        if s.class == class_tbss {
            continue
        }
        last_loaded = s
        if s.class == class_bss && first_bss == none {
            first_bss = s
        }
        if s.class != class_bss {
            last_data = s
        }
    }
    let loaded = last_loaded ?? return []
    let edata = end_of(required(last_data))
    var bss_start = edata
    match first_bss {
        some(first) => {
            bss_start = SymbolValue { value: first.addr, section: first }
        }
        none => {}
    }
    let end = end_of(loaded)
    [
        LinkerSymbol { name: bound_bss_start, value: bss_start },
        LinkerSymbol { name: bound_edata, value: edata },
        LinkerSymbol { name: bound_end, value: end }
    ]
}

fn end_of(s: *Section) -> SymbolValue {
    SymbolValue { value: section_end(s), section: s }
}

fn tls_start(l: *Linker) -> i64 {
    for seg in l.segments {
        if seg.kind == pt_tls {
            return seg.addr
        }
    }
    0
}

fn is_tls(v: SymbolValue) -> bool {
    match v.section {
        some(s) => s.class == class_tdata || s.class == class_tbss
        none => false
    }
}

fn symbol_index_of(v: SymbolValue) -> i64 {
    if v.undefined {
        return shn_undef
    }
    match v.section {
        some(s) => {
            if v.absolute {
                return shn_abs
            }
            s.index
        }
        none => shn_abs
    }
}

fn emitted_value(l: *Linker, v: SymbolValue) -> i64 {
    if is_tls(v) {
        return v.value - tls_start(l)
    }
    v.value
}

fn emitted_symbols(l: *Linker) -> EmittedSymbols {
    var locals: []LinkerSymbol = []
    var globals: []LinkerSymbol = []
    for sym in l.obj.symbols {
        if text.starts_with(sym.name, ".L") {
            continue
        }
        match resolve_symbol(l, sym) {
            some(value) => {
                let entry = LinkerSymbol { name: sym.name, value }
                if sym.global {
                    push(mut globals, entry)
                } else {
                    push(mut locals, entry)
                }
            }
            none => {
                append_imported(l, mut globals, sym.name)
            }
        }
    }
    let own = object_defined(l)
    for defined in boundary_symbols(l) {
        if own[defined.name] ?? false {
            continue
        }
        push(mut globals, defined)
    }
    match l.dyn {
        some(d) => {
            for table in table_symbols(d) {
                push(mut locals, table)
            }
        }
        none => {}
    }
    EmittedSymbols { locals, globals }
}

fn append_imported(l: *Linker, mut globals: []LinkerSymbol, name: str) {
    let d = l.dyn ?? return
    let imported = d.by_symbol[name] ?? return
    let value = SymbolValue { undefined: true, kind: imported.kind }
    let entry = LinkerSymbol { name: versioned_name(imported), value }
    push(mut globals, entry)
}

fn object_defined(l: *Linker) -> [str: bool] {
    var defined: [str: bool] = [:]
    for sym in l.obj.symbols {
        if sym.section != asm.section_undefined {
            defined[sym.name] = true
        }
    }
    defined
}

fn defined_names(l: *Linker) -> [str: bool] {
    var defined = object_defined(l)
    for boundary in boundary_symbols(l) {
        defined[boundary.name] = true
    }
    defined
}

fn addresses(l: *Linker) -> [str: i64] {
    var out: [str: i64] = [:]
    for name, value in l.symbols {
        if !text.starts_with(name, ".L") {
            out[name] = emitted_value(l, value)
        }
    }
    match l.dyn {
        some(d) => {
            for table in table_symbols(d) {
                out[table.name] = emitted_value(l, table.value)
            }
        }
        none => {}
    }
    out
}
