import asm
import std/io

fn apply_sections(l: *Linker, image: []u8) ! Error {
    var spaces: []*FixupSpace = []
    for s in l.sections {
        if s.input.nobits {
            continue
        }
        io.copy(image[s.off..], s.input.data)
        let space = new(FixupSpace { name: s.input.name, addr: s.addr, offset: s.off, size: s.size, fixups: s.input.fixups })
        push(mut spaces, space)
    }
    relocate(elf_format(l), image, spaces)?
}

fn elf_format(l: *Linker) -> FixupFormat {
    FixupFormat {
        supports: supports,
        target: fn(space: *FixupSpace, f: asm.Fixup) -> i64? ! Error { target(l, space, f)? }
    }
}

fn supports(kind: i64) -> bool {
    !asm.fixup_image_relative(kind)
}

fn target(l: *Linker, space: *FixupSpace, f: asm.Fixup) -> i64? ! Error {
    let kind = asm.fixup_kind_text(f.kind)
    if asm.fixup_got(f.kind) {
        return got_target(l, space, f)?
    }
    match l.symbols[f.symbol] {
        some(sym) => return sym.value
        none => {}
    }
    match l.dyn {
        some(d) => {
            match plt_address(d, f.symbol) {
                some(address) => {
                    if f.kind == asm.plt32 {
                        return address
                    }
                }
                none => {}
            }
            if imports(d, f.symbol) {
                fail NeedsCopy(kind, f.symbol, space.name)
            }
        }
        none => {}
    }
    none
}

fn got_target(l: *Linker, space: *FixupSpace, f: asm.Fixup) -> i64? ! Error {
    match l.dyn {
        some(d) => got_address(d, f.symbol)
        none => fail GotInStatic(asm.fixup_kind_text(f.kind), f.symbol, space.name)
    }
}
