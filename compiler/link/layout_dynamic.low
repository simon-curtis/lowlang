const got_plt_reserved = 24
const max_relro_passes = 8
const unwind_align = 8

fn layout_dynamic(l: *Linker, d: *DynamicLink) {
    let header = sections_of(l, [class_interp, class_hash, class_gnu_hash, class_dynsym, class_dynstr, class_versym, class_verneed, class_rela_dyn, class_rela_plt])
    let text = sections_of(l, [class_plt, class_plt_got, class_text])
    let rodata = sections_of(l, [class_rodata])
    let relro = sections_of(l, [class_tdata, class_tbss, class_dynamic, class_got])
    let writable = sections_of(l, [class_tdata, class_tbss, class_dynamic, class_got, class_got_plt, class_data, class_bss])
    let tls = sections_of(l, [class_tdata, class_tbss])

    var count = 7
    for present in [text.len > 0, rodata.len > 0, tls.len > 0] {
        if present {
            count += 1
        }
    }
    let headers = header_size + count * phdr_size
    let c = new(Cursor { off: headers, addr: base_address + headers })

    var loads: []Segment = []
    let head = header_segment(c, header)
    push(mut loads, head)
    if text.len > 0 {
        align_to_page(c)
        let seg = load_segment(c, text, pf_r | pf_x)
        push(mut loads, seg)
    }
    if rodata.len > 0 {
        align_to_page(c)
        let loaded = load_segment(c, rodata, pf_r)
        let seg = unwind_padded(c, loaded)
        push(mut loads, seg)
    }
    let rw = new(relro_start(d, *c, relro))
    let seg = load_segment(rw, writable, pf_r | pf_w)
    push(mut loads, seg)
    l.file_end = rw.off

    let phdr_bytes = count * phdr_size
    let phdr = Segment {
        kind: pt_phdr, flags: pf_r, off: header_size, addr: base_address + header_size,
        file_size: phdr_bytes, mem_size: phdr_bytes, align: 8
    }
    push(mut l.segments, phdr)
    let interp = interp_segment(header[0])
    push(mut l.segments, interp)
    for load in loads {
        push(mut l.segments, load)
    }
    let dynamic = dynamic_segment(d)
    push(mut l.segments, dynamic)
    if tls.len > 0 {
        let seg = tls_segment(tls)
        push(mut l.segments, seg)
    }
    let stack = Segment { kind: pt_gnu_stack, flags: pf_r | pf_w, align: 16 }
    push(mut l.segments, stack)
    let relro_seg = relro_segment(d, relro)
    push(mut l.segments, relro_seg)
}

fn unwind_padded(c: *Cursor, seg: Segment) -> Segment {
    align_to(c, unwind_align)
    var padded = seg
    padded.file_size = c.addr - seg.addr
    padded.mem_size = padded.file_size
    padded
}

fn header_segment(c: *Cursor, members: []*Section) -> Segment {
    var seg = load_segment(c, members, pf_r)
    seg.off = 0
    seg.addr = base_address
    let last = members[members.len - 1]
    seg.file_size = section_end(last) - base_address
    seg.mem_size = seg.file_size
    seg
}

fn interp_segment(interp: *Section) -> Segment {
    Segment {
        kind: pt_interp, flags: pf_r, off: interp.off, addr: interp.addr,
        file_size: interp.size, mem_size: interp.size, align: 1
    }
}

fn dynamic_segment(d: *DynamicLink) -> Segment {
    let dynamic = required(d.sections.dynamic)
    Segment {
        kind: pt_dynamic, flags: pf_r | pf_w, off: dynamic.off, addr: dynamic.addr,
        file_size: dynamic.size, mem_size: dynamic.size, align: dynamic.align
    }
}

fn relro_segment(d: *DynamicLink, relro: []*Section) -> Segment {
    let first = relro[0]
    let size = relro_end(d, relro) - first.addr
    Segment {
        kind: pt_gnu_relro, flags: pf_r, off: first.off, addr: first.addr,
        file_size: size, mem_size: size, align: 1
    }
}

fn relro_end(d: *DynamicLink, relro: []*Section) -> i64 {
    var end = 0
    for s in relro {
        if s.class != class_tbss {
            end = section_end(s)
        }
    }
    let got_plt = required(d.sections.got_plt)
    align_up(end, got_plt.align) + got_plt_reserved
}

fn relro_start(d: *DynamicLink, start: Cursor, relro: []*Section) -> Cursor {
    let floor = align_up(start.addr, page_size)
    var c = start
    for _ in 0..max_relro_passes {
        let trial = new(c)
        for s in relro {
            place(trial, s)
        }
        let gap = (page_size - relro_end(d, relro) % page_size) % page_size
        if gap == 0 {
            break
        }
        c.off += gap
        c.addr += gap
    }
    if c.addr - max_align(relro) < floor {
        c.addr += page_size
    }
    c
}
