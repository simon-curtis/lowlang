import std/io

const rsrc_name = ".rsrc"
const rt_icon = 3
const rt_group_icon = 14
const rt_version = 16
const rt_manifest = 24
const resource_language = 0x409
const resource_subdirectory = 0x80000000
const resource_directory_size = 16
const resource_entry_size = 8
const resource_data_entry_size = 16
const resource_data_align = 8
const ico_header_size = 6
const ico_entry_size = 16
const group_entry_header_size = 12

/// One image of an icon: the first 12 bytes of its `.ico` directory entry and the image bytes, a PNG or a DIB.
pub struct IconImage {
    pub header: []u8
    pub image: []u8
}

/// The images of a Windows `.ico` file, in the file's order.
pub struct Icon {
    pub images: []IconImage = []
}

/// One entry of the string table of an image's version information, such as `CompanyName`.
pub struct VersionString {
    pub key: str
    pub value: str
}

/// What a Windows image carries in its `.rsrc` section; empty fields add nothing.
pub struct Resources {
    /// The `.ico` file whose images become the image's icon, which Explorer, a shortcut and a pinned taskbar button show.
    pub icon: []u8 = []
    /// The XML application manifest, written as it is.
    pub manifest: []u8 = []
    /// The version information strings. `FileVersion` and `ProductVersion` also give the numeric file and product version of the fixed part, from their leading dotted numbers.
    pub strings: []VersionString = []
}

/// Options of a Windows image that `pe` and `pe_symbols` write.
pub struct PeOptions {
    /// Links the image with the GUI subsystem in place of the console subsystem.
    pub gui: bool = false
    pub resources: Resources = Resources {}
}

/// Checks that `r` can be written as the resources of an image, failing with the error that `pe` would.
pub fn check_resources(r: Resources) ! Error {
    resource_items(r)?
}

/// Reads the images of the `.ico` file `data`.
///
/// It fails with `BadIcon` when `data` is not an icon file, holds no image, or names an image outside the file.
pub fn read_icon(data: []u8) -> Icon ! Error {
    if data.len < ico_header_size || io.le16(data, 0) != 0 || io.le16(data, 2) != 1 {
        fail BadIcon("not an .ico file")
    }
    let count = io.le16(data, 4)
    if count == 0 {
        fail BadIcon("the icon holds no image")
    }
    if ico_header_size + count * ico_entry_size > data.len {
        fail BadIcon("the icon directory runs past the end of the file")
    }
    var images: []IconImage = []
    for i in 0..count {
        let at = ico_header_size + i * ico_entry_size
        let size = io.le32(data, at + 8)
        let offset = io.le32(data, at + 12)
        if size == 0 || offset + size > data.len {
            fail BadIcon("image {i + 1} lies outside the file")
        }
        images.push(IconImage { header: data[at..at + group_entry_header_size], image: data[offset..offset + size] })
    }
    Icon { images }
}

struct Resource {
    kind: i64
    name: i64
    data: []u8
}

struct ResourceTree {
    data: []u8
    data_entries: []i64
}

fn pe_add_resources(l: *PeLinker) ! Error {
    let items = resource_items(l.wanted)?
    if items.len == 0 {
        return
    }
    let tree = resource_tree(items)
    let c = new(PeChunk { name: rsrc_name, data: tree.data, size: tree.data.len, align: 4, chars: pe_read_only_data })
    l.resources = some(c)
    l.resource_entries = tree.data_entries
    l.chunks.push(c)
}

fn pe_place_resources(l: *PeLinker) {
    let c = l.resources ?? return
    let base = chunk_rva(c)
    for at in l.resource_entries {
        io.set_le32(c.data, at, io.le32(c.data, at) + base)
    }
}

fn resource_items(r: Resources) -> []Resource ! Error {
    var items: []Resource = []
    if r.icon.len > 0 {
        let icon = read_icon(r.icon)?
        for i, image in icon.images {
            items.push(Resource { kind: rt_icon, name: i + 1, data: image.image })
        }
        items.push(Resource { kind: rt_group_icon, name: 1, data: icon_group(icon) })
    }
    if r.strings.len > 0 {
        items.push(Resource { kind: rt_version, name: 1, data: version_info(r.strings)? })
    }
    if r.manifest.len > 0 {
        check_manifest(r.manifest)?
        items.push(Resource { kind: rt_manifest, name: 1, data: r.manifest })
    }
    items
}

fn count_kind(items: []Resource, kind: i64) -> i64 {
    var count = 0
    for item in items {
        if item.kind == kind {
            count += 1
        }
    }
    count
}

fn directory_size(entries: i64) -> i64 {
    resource_directory_size + entries * resource_entry_size
}

fn resource_tree(items: []Resource) -> ResourceTree {
    var kinds: []i64 = []
    for item in items {
        if kinds.len == 0 || kinds[kinds.len - 1] != item.kind {
            kinds.push(item.kind)
        }
    }
    var names_at: []i64 = []
    var at = directory_size(kinds.len)
    for kind in kinds {
        names_at.push(at)
        at += directory_size(count_kind(items, kind))
    }
    let languages = at
    let entries = languages + items.len * directory_size(1)
    var out: []u8 = []
    put_directory(mut out, kinds.len)
    for i, kind in kinds {
        put_entry(mut out, kind, names_at[i] | resource_subdirectory)
    }
    var next = 0
    for kind in kinds {
        let count = count_kind(items, kind)
        put_directory(mut out, count)
        for i in next..next + count {
            put_entry(mut out, items[i].name, (languages + i * directory_size(1)) | resource_subdirectory)
        }
        next += count
    }
    for i in 0..items.len {
        put_directory(mut out, 1)
        put_entry(mut out, resource_language, entries + i * resource_data_entry_size)
    }
    var data_entries: []i64 = []
    var offset = align_up(entries + items.len * resource_data_entry_size, resource_data_align)
    for item in items {
        data_entries.push(out.len)
        io.put_le32(mut out, offset)
        io.put_le32(mut out, item.data.len)
        io.put_le32(mut out, 0)
        io.put_le32(mut out, 0)
        offset = align_up(offset + item.data.len, resource_data_align)
    }
    for item in items {
        pad_to(mut out, align_up(out.len, resource_data_align))
        io.append(mut out, item.data)
    }
    ResourceTree { data: out, data_entries }
}

fn icon_group(icon: Icon) -> []u8 {
    var out: []u8 = []
    io.put_le16(mut out, 0)
    io.put_le16(mut out, 1)
    io.put_le16(mut out, icon.images.len)
    for i, image in icon.images {
        io.append(mut out, image.header)
        io.put_le16(mut out, i + 1)
    }
    out
}

fn put_directory(mut out: []u8, ids: i64) {
    io.put_le32(mut out, 0)
    io.put_le32(mut out, 0)
    io.put_le16(mut out, 0)
    io.put_le16(mut out, 0)
    io.put_le16(mut out, 0)
    io.put_le16(mut out, ids)
}

fn put_entry(mut out: []u8, id: i64, target: i64) {
    io.put_le32(mut out, id)
    io.put_le32(mut out, target)
}

fn pad_to(mut out: []u8, size: i64) {
    for out.len < size {
        out.push(0)
    }
}
