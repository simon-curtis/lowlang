import std/io

const rsrc_name = ".rsrc"
const rt_icon = 3
const rt_group_icon = 14
const resource_language = 0x409
const resource_subdirectory = 0x80000000
const resource_directory_size = 16
const resource_entry_size = 8
const resource_data_entry_size = 16
const resource_data_align = 8
const ico_header_size = 6
const ico_entry_size = 16
const group_entry_header_size = 12

/// One image of an icon: the first 12 bytes of its `.ico` directory entry and the image bytes, a PNG or a DIB.
pub struct IconImage {
    pub header: []u8
    pub image: []u8
}

/// The images of a Windows `.ico` file, in the file's order.
pub struct Icon {
    pub images: []IconImage = []
}

/// Options of a Windows image that `pe` and `pe_symbols` write.
pub struct PeOptions {
    /// Links the image with the GUI subsystem in place of the console subsystem.
    pub gui: bool = false
    /// The `.ico` file whose images become the image's icon, which Explorer, a shortcut and a pinned taskbar button show; empty for no icon.
    pub icon: []u8 = []
}

/// Reads the images of the `.ico` file `data`.
///
/// It fails with `BadIcon` when `data` is not an icon file, holds no image, or names an image outside the file.
pub fn read_icon(data: []u8) -> Icon ! Error {
    if data.len < ico_header_size || io.le16(data, 0) != 0 || io.le16(data, 2) != 1 {
        fail BadIcon("not an .ico file")
    }
    let count = io.le16(data, 4)
    if count == 0 {
        fail BadIcon("the icon holds no image")
    }
    if ico_header_size + count * ico_entry_size > data.len {
        fail BadIcon("the icon directory runs past the end of the file")
    }
    var images: []IconImage = []
    for i in 0..count {
        let at = ico_header_size + i * ico_entry_size
        let size = io.le32(data, at + 8)
        let offset = io.le32(data, at + 12)
        if size == 0 || offset + size > data.len {
            fail BadIcon("image {i + 1} lies outside the file")
        }
        images.push(IconImage { header: data[at..at + group_entry_header_size], image: data[offset..offset + size] })
    }
    Icon { images }
}

struct ResourceTree {
    data: []u8
    data_entries: []i64
}

fn pe_add_resources(l: *PeLinker) ! Error {
    if l.icon.len == 0 {
        return
    }
    let tree = resource_tree(read_icon(l.icon)?)
    let c = new(PeChunk { name: rsrc_name, data: tree.data, size: tree.data.len, align: 4, chars: pe_read_only_data })
    l.resources = some(c)
    l.resource_entries = tree.data_entries
    l.chunks.push(c)
}

fn pe_place_resources(l: *PeLinker) {
    let c = l.resources ?? return
    let base = chunk_rva(c)
    for at in l.resource_entries {
        io.set_le32(c.data, at, io.le32(c.data, at) + base)
    }
}

fn resource_tree(icon: Icon) -> ResourceTree {
    let count = icon.images.len
    let icon_types = resource_directory_size + 2 * resource_entry_size
    let group_types = icon_types + resource_directory_size + count * resource_entry_size
    let languages = group_types + resource_directory_size + resource_entry_size
    let language_size = resource_directory_size + resource_entry_size
    let entries = languages + (count + 1) * language_size
    var blobs: [][]u8 = []
    for image in icon.images {
        blobs.push(image.image)
    }
    blobs.push(icon_group(icon))
    var out: []u8 = []
    put_directory(mut out, 2)
    put_entry(mut out, rt_icon, icon_types | resource_subdirectory)
    put_entry(mut out, rt_group_icon, group_types | resource_subdirectory)
    put_directory(mut out, count)
    for i in 0..count {
        put_entry(mut out, i + 1, (languages + i * language_size) | resource_subdirectory)
    }
    put_directory(mut out, 1)
    put_entry(mut out, 1, (languages + count * language_size) | resource_subdirectory)
    for i in 0..count + 1 {
        put_directory(mut out, 1)
        put_entry(mut out, resource_language, entries + i * resource_data_entry_size)
    }
    var data_entries: []i64 = []
    var offset = align_up(entries + blobs.len * resource_data_entry_size, resource_data_align)
    for blob in blobs {
        data_entries.push(out.len)
        io.put_le32(mut out, offset)
        io.put_le32(mut out, blob.len)
        io.put_le32(mut out, 0)
        io.put_le32(mut out, 0)
        offset = align_up(offset + blob.len, resource_data_align)
    }
    for blob in blobs {
        pad_to(mut out, align_up(out.len, resource_data_align))
        io.append(mut out, blob)
    }
    ResourceTree { data: out, data_entries }
}

fn icon_group(icon: Icon) -> []u8 {
    var out: []u8 = []
    io.put_le16(mut out, 0)
    io.put_le16(mut out, 1)
    io.put_le16(mut out, icon.images.len)
    for i, image in icon.images {
        io.append(mut out, image.header)
        io.put_le16(mut out, i + 1)
    }
    out
}

fn put_directory(mut out: []u8, ids: i64) {
    io.put_le32(mut out, 0)
    io.put_le32(mut out, 0)
    io.put_le16(mut out, 0)
    io.put_le16(mut out, 0)
    io.put_le16(mut out, 0)
    io.put_le16(mut out, ids)
}

fn put_entry(mut out: []u8, id: i64, target: i64) {
    io.put_le32(mut out, id)
    io.put_le32(mut out, target)
}

fn pad_to(mut out: []u8, size: i64) {
    for out.len < size {
        out.push(0)
    }
}
