import std/io

const elfclass64 = 2
const elfdata2lsb = 1
const ev_current = 1
const et_exec = 2
const et_dyn = 3
const em_x86_64 = 62
const eh_ident_size = 16

const pt_load = 1
const pt_dynamic = 2
const pt_interp = 3
const pt_phdr = 6
const pt_tls = 7
const pt_gnu_stack = 0x6474e551
const pt_gnu_relro = 0x6474e552

const pf_x = 1
const pf_w = 2
const pf_r = 4

const sht_null = 0
const sht_progbits = 1
const sht_symtab = 2
const sht_strtab = 3
const sht_rela = 4
const sht_hash = 5
const sht_dynamic = 6
const sht_nobits = 8
const sht_dynsym = 11
const sht_gnu_hash = 0x6ffffff6
const sht_gnu_verdef = 0x6ffffffd
const sht_gnu_verneed = 0x6ffffffe
const sht_gnu_versym = 0x6fffffff

const shf_write = 1
const shf_alloc = 2
const shf_execinstr = 4
const shf_info_link = 0x40
const shf_tls = 0x400

const stb_local = 0
const stb_global = 1
const stb_weak = 2

const stt_notype = 0
const stt_object = 1
const stt_func = 2
const stt_file = 4
const stt_tls = 6
const stt_gnu_ifunc = 10

const shn_undef = 0
const shn_abs = 0xfff1

const dt_null = 0
const dt_needed = 1
const dt_pltrelsz = 2
const dt_pltgot = 3
const dt_hash = 4
const dt_strtab = 5
const dt_symtab = 6
const dt_rela = 7
const dt_relasz = 8
const dt_relaent = 9
const dt_strsz = 10
const dt_syment = 11
const dt_soname = 14
const dt_debug = 21
const dt_pltrel = 20
const dt_jmprel = 23
const dt_gnu_hash = 0x6ffffef5
const dt_versym = 0x6ffffff0
const dt_verneed = 0x6ffffffe
const dt_verneednum = 0x6fffffff

const r_x86_64_glob_dat = 6
const r_x86_64_jmp_slot = 7

const header_size = 64
const phdr_size = 56
const shdr_size = 64
const sym_size = 24
const rela_size = 24
const dyn_entry_size = 16

fn st_info(bind: i64, kind: i64) -> i64 {
    bind << 4 | kind & 0xf
}

struct Sym64 {
    name: i64 = 0
    info: i64 = 0
    shndx: i64 = 0
    value: i64 = 0
}

struct Header64 {
    kind: i64
    machine: i64
    version: i64
    entry: i64
    phoff: i64
    shoff: i64
    ehsize: i64
    phentsize: i64
    phnum: i64
    shentsize: i64
    shnum: i64
    shstrndx: i64
}

struct Prog64 {
    kind: i64
    flags: i64
    off: i64
    vaddr: i64
    filesz: i64
    memsz: i64
    align: i64
}

struct Section64 {
    name: i64 = 0
    kind: i64 = 0
    flags: i64 = 0
    addr: i64 = 0
    off: i64 = 0
    size: i64 = 0
    link: i64 = 0
    info: i64 = 0
    addralign: i64 = 0
    entsize: i64 = 0
}

fn append_sym64(mut out: []u8, s: Sym64) {
    io.put_le(mut out, s.name, 4)
    io.put_le(mut out, s.info, 1)
    io.put_le(mut out, 0, 1)
    io.put_le(mut out, s.shndx, 2)
    io.put_le(mut out, s.value, 8)
    io.put_le(mut out, 0, 8)
}

fn append_header64(mut out: []u8, h: Header64) {
    io.put_le(mut out, 0x7f, 1)
    io.put_le(mut out, 'E', 1)
    io.put_le(mut out, 'L', 1)
    io.put_le(mut out, 'F', 1)
    io.put_le(mut out, elfclass64, 1)
    io.put_le(mut out, elfdata2lsb, 1)
    io.put_le(mut out, ev_current, 1)
    io.put_le(mut out, 0, eh_ident_size - 7)
    io.put_le(mut out, h.kind, 2)
    io.put_le(mut out, h.machine, 2)
    io.put_le(mut out, h.version, 4)
    io.put_le(mut out, h.entry, 8)
    io.put_le(mut out, h.phoff, 8)
    io.put_le(mut out, h.shoff, 8)
    io.put_le(mut out, 0, 4)
    io.put_le(mut out, h.ehsize, 2)
    io.put_le(mut out, h.phentsize, 2)
    io.put_le(mut out, h.phnum, 2)
    io.put_le(mut out, h.shentsize, 2)
    io.put_le(mut out, h.shnum, 2)
    io.put_le(mut out, h.shstrndx, 2)
}

fn append_prog64(mut out: []u8, p: Prog64) {
    io.put_le(mut out, p.kind, 4)
    io.put_le(mut out, p.flags, 4)
    io.put_le(mut out, p.off, 8)
    io.put_le(mut out, p.vaddr, 8)
    io.put_le(mut out, p.vaddr, 8)
    io.put_le(mut out, p.filesz, 8)
    io.put_le(mut out, p.memsz, 8)
    io.put_le(mut out, p.align, 8)
}

fn append_section64(mut out: []u8, s: Section64) {
    io.put_le(mut out, s.name, 4)
    io.put_le(mut out, s.kind, 4)
    io.put_le(mut out, s.flags, 8)
    io.put_le(mut out, s.addr, 8)
    io.put_le(mut out, s.off, 8)
    io.put_le(mut out, s.size, 8)
    io.put_le(mut out, s.link, 4)
    io.put_le(mut out, s.info, 4)
    io.put_le(mut out, s.addralign, 8)
    io.put_le(mut out, s.entsize, 8)
}

const pe_file_header_size = 20
const pe_optional_header_size = 240
const pe_section_header_size = 40
const pe_signature_size = 4
const pe_data_directories = 16
const pe_machine_amd64 = 0x8664
const pe_magic_plus64 = 0x20b
const pe_subsystem_cui = 3

const pe_scn_cnt_code = 0x20
const pe_scn_cnt_initialized_data = 0x40
const pe_scn_cnt_uninitialized_data = 0x80
const pe_scn_mem_discardable = 0x02000000
const pe_scn_mem_execute = 0x20000000
const pe_scn_mem_read = 0x40000000
const pe_scn_mem_write = 0x80000000

const pe_file_executable_image = 0x2
const pe_file_large_address_aware = 0x20
const pe_dll_high_entropy_va = 0x20
const pe_dll_dynamic_base = 0x40
const pe_dll_nx_compat = 0x100
const pe_dll_terminal_server_aware = 0x8000

const pe_dir_import = 1
const pe_dir_base_reloc = 5
const pe_dir_debug = 6
const pe_dir_iat = 12

struct DataDirectory {
    virtual_address: i64 = 0
    size: i64 = 0
}

struct PeFileHeader {
    number_of_sections: i64
    time_date_stamp: i64
    size_of_optional_header: i64
    characteristics: i64
}

struct PeOptionalHeader {
    size_of_code: i64
    size_of_initialized_data: i64
    size_of_uninitialized_data: i64
    address_of_entry_point: i64
    base_of_code: i64
    image_base: i64
    section_alignment: i64
    file_alignment: i64
    major_operating_system_version: i64
    major_subsystem_version: i64
    size_of_image: i64
    size_of_headers: i64
    dll_characteristics: i64
    size_of_stack_reserve: i64
    size_of_stack_commit: i64
    size_of_heap_reserve: i64
    size_of_heap_commit: i64
    directories: []DataDirectory
}

struct PeSectionHeader {
    name: str
    virtual_size: i64
    virtual_address: i64
    size_of_raw_data: i64
    pointer_to_raw_data: i64
    characteristics: i64
}

fn append_pe_file_header(mut out: []u8, h: PeFileHeader) {
    io.put_le(mut out, pe_machine_amd64, 2)
    io.put_le(mut out, h.number_of_sections, 2)
    io.put_le(mut out, h.time_date_stamp, 4)
    io.put_le(mut out, 0, 4)
    io.put_le(mut out, 0, 4)
    io.put_le(mut out, h.size_of_optional_header, 2)
    io.put_le(mut out, h.characteristics, 2)
}

fn append_pe_optional_header(mut out: []u8, h: PeOptionalHeader) {
    io.put_le(mut out, pe_magic_plus64, 2)
    io.put_le(mut out, pe_linker_major, 1)
    io.put_le(mut out, 0, 1)
    io.put_le(mut out, h.size_of_code, 4)
    io.put_le(mut out, h.size_of_initialized_data, 4)
    io.put_le(mut out, h.size_of_uninitialized_data, 4)
    io.put_le(mut out, h.address_of_entry_point, 4)
    io.put_le(mut out, h.base_of_code, 4)
    io.put_le(mut out, h.image_base, 8)
    io.put_le(mut out, h.section_alignment, 4)
    io.put_le(mut out, h.file_alignment, 4)
    io.put_le(mut out, h.major_operating_system_version, 2)
    io.put_le(mut out, 0, 2)
    io.put_le(mut out, 0, 2)
    io.put_le(mut out, 0, 2)
    io.put_le(mut out, h.major_subsystem_version, 2)
    io.put_le(mut out, 0, 2)
    io.put_le(mut out, 0, 4)
    io.put_le(mut out, h.size_of_image, 4)
    io.put_le(mut out, h.size_of_headers, 4)
    io.put_le(mut out, 0, 4)
    io.put_le(mut out, pe_subsystem_cui, 2)
    io.put_le(mut out, h.dll_characteristics, 2)
    io.put_le(mut out, h.size_of_stack_reserve, 8)
    io.put_le(mut out, h.size_of_stack_commit, 8)
    io.put_le(mut out, h.size_of_heap_reserve, 8)
    io.put_le(mut out, h.size_of_heap_commit, 8)
    io.put_le(mut out, 0, 4)
    io.put_le(mut out, pe_data_directories, 4)
    for d in h.directories {
        io.put_le(mut out, d.virtual_address, 4)
        io.put_le(mut out, d.size, 4)
    }
}

fn append_pe_section_header(mut out: []u8, h: PeSectionHeader) {
    for i in 0..8 {
        if i < h.name.len {
            push(mut out, h.name[i])
        } else {
            push(mut out, 0)
        }
    }
    io.put_le(mut out, h.virtual_size, 4)
    io.put_le(mut out, h.virtual_address, 4)
    io.put_le(mut out, h.size_of_raw_data, 4)
    io.put_le(mut out, h.pointer_to_raw_data, 4)
    io.put_le(mut out, 0, 4)
    io.put_le(mut out, 0, 4)
    io.put_le(mut out, 0, 2)
    io.put_le(mut out, 0, 2)
    io.put_le(mut out, h.characteristics, 4)
}
