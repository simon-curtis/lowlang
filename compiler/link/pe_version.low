import std/io
import std/unicode
import std/unicode/utf16
import std/xml

const version_language = "040904B0"
const version_translation = 0x04B00409
const version_signature = 0xFEEF04BD
const version_structure = 0x00010000
const version_flags_mask = 0x3F
const version_os_nt_windows32 = 0x00040004
const version_type_app = 1
const version_fixed_size = 52
const version_binary = 0
const version_text = 1
const version_align = 4
const version_part_limit = 0xFFFF
const version_size_limit = 0xFFFF
const version_parts = 4
const manifest_root = "assembly"

fn check_manifest(data: []u8) ! Error {
    let root = xml.parse(data) catch {
        Malformed(line, column, message) => fail BadManifest("{line}:{column}: {message}")
        Limit(line, column, message) => fail BadManifest("{line}:{column}: {message}")
        Unsupported(message) => fail BadManifest(message)
    }
    if root.name.local != manifest_root {
        fail BadManifest("the root element is {root.name.local}, not {manifest_root}")
    }
}

fn version_info(strings: []VersionString) -> []u8 ! Error {
    check_strings(strings)?
    let file = leading_numbers(version_string(strings, "FileVersion"))
    let product = leading_numbers(version_string(strings, "ProductVersion"))
    check_parts(file, "FileVersion")?
    check_parts(product, "ProductVersion")?
    var fixed: []u8 = []
    io.put_le32(mut fixed, version_signature)
    io.put_le32(mut fixed, version_structure)
    io.put_le32(mut fixed, file[0] << 16 | file[1])
    io.put_le32(mut fixed, file[2] << 16 | file[3])
    io.put_le32(mut fixed, product[0] << 16 | product[1])
    io.put_le32(mut fixed, product[2] << 16 | product[3])
    io.put_le32(mut fixed, version_flags_mask)
    io.put_le32(mut fixed, 0)
    io.put_le32(mut fixed, version_os_nt_windows32)
    io.put_le32(mut fixed, version_type_app)
    io.put_le32(mut fixed, 0)
    io.put_le32(mut fixed, 0)
    io.put_le32(mut fixed, 0)
    let info = version_node("VS_VERSION_INFO", version_binary, version_fixed_size, fixed, join_nodes([string_file_info(strings), var_file_info()]))
    if info.len > version_size_limit {
        fail BadVersion("", "the version information is {info.len} bytes, over the {version_size_limit} a version block can hold")
    }
    info
}

fn check_strings(strings: []VersionString) ! Error {
    for i, s in strings {
        if s.key == "" {
            fail BadVersion("", "a version string has no key")
        }
        for earlier in strings[..i] {
            if earlier.key == s.key {
                fail BadVersion(s.key, "the key is given twice")
            }
        }
    }
}

fn version_string(strings: []VersionString, key: str) -> str {
    for s in strings {
        if s.key == key {
            return s.value
        }
    }
    ""
}

fn leading_numbers(value: str) -> []i64 {
    var parts: []i64 = []
    var current = 0
    var digits = 0
    for i in 0..value.len {
        let c = value[i]
        if c >= '0' && c <= '9' {
            if current <= version_part_limit {
                current = current * 10 + i64(c - '0')
            }
            digits += 1
            continue
        }
        if c != '.' || digits == 0 {
            break
        }
        parts.push(current)
        current = 0
        digits = 0
    }
    if digits > 0 {
        parts.push(current)
    }
    for parts.len < version_parts {
        parts.push(0)
    }
    parts[..version_parts]
}

fn check_parts(parts: []i64, key: str) ! Error {
    for part in parts {
        if part > version_part_limit {
            fail BadVersion(key, "a number of the version is over {version_part_limit}")
        }
    }
}

fn string_file_info(strings: []VersionString) -> []u8 {
    var entries: [][]u8 = []
    for s in strings {
        let value = wide_text(s.value)
        entries.push(version_node(s.key, version_text, value.len / 2, value, []))
    }
    let table = version_node(version_language, version_text, 0, [], join_nodes(entries))
    version_node("StringFileInfo", version_text, 0, [], table)
}

fn var_file_info() -> []u8 {
    var translation: []u8 = []
    io.put_le32(mut translation, version_translation)
    let node = version_node("Translation", version_binary, translation.len, translation, [])
    version_node("VarFileInfo", version_text, 0, [], node)
}

fn wide_text(s: str) -> []u8 {
    utf16.encode_bytes("{s}\0", unicode.Order.Little, false)
}

fn join_nodes(nodes: [][]u8) -> []u8 {
    var out: []u8 = []
    for i, node in nodes {
        if i > 0 {
            pad_to(mut out, align_up(out.len, version_align))
        }
        io.append(mut out, node)
    }
    out
}

fn version_node(key: str, kind: i64, value_length: i64, value: []u8, children: []u8) -> []u8 {
    var out: []u8 = []
    io.put_le16(mut out, 0)
    io.put_le16(mut out, value_length)
    io.put_le16(mut out, kind)
    io.append(mut out, wide_text(key))
    pad_to(mut out, align_up(out.len, version_align))
    io.append(mut out, value)
    if children.len > 0 {
        pad_to(mut out, align_up(out.len, version_align))
        io.append(mut out, children)
    }
    io.set_le16(out, 0, out.len)
    out
}
