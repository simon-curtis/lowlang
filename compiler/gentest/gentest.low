import compiler
import link
import native
import target
import std/file
import std/process
import std/testing

pub struct Program {
    pub file: str
    pub contents: []u8
}

pub fn library_available(name: str) -> bool {
    let resolver = link.Resolver { dirs: link.system_dirs() }
    let found = link.resolve(resolver, [name]) or {
        return false
    }
    found.len > 0
}

pub fn build_directory(t: *testing.T, dir: str, files: []Program, platform: target.OS) -> str {
    for f in files {
        file.write_file_mode(file.child_path(dir, f.file), f.contents, 0o644) catch {
            e => t.fatal("{f.file}: {e}")
        }
    }
    let profile = compiler.release(platform)
    let unit = native.analyse(dir, profile) catch {
        e => {
            t.fatal(native.message(e))
            return ""
        }
    }
    let binary = file.child_path(dir, "program")
    let built = native.build(unit, binary) catch {
        e => {
            t.fatal(native.message(e))
            return ""
        }
    }
    binary
}

pub fn run_binary(t: *testing.T, binary: str) -> str {
    let command = process.command(binary, [])
    let output = process.run(command, []) catch {
        e => {
            t.fatal("{binary}: {e}")
            return ""
        }
    }
    let combined = "{str(output.stdout)}{str(output.stderr)}"
    if !process.success(output.status) {
        t.fatal("{binary} failed\n{combined}")
    }
    combined
}
