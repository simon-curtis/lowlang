import compiler
import std/file
import std/path
import std/semver
import std/text

const yanked_flag = "yanked"
const hash_prefix = "h1:"

/// One version in the index file of a package: the tag, the commit the tag names, the content hash of the commit's tree as `build.lock` holds it, and whether the version is yanked.
pub struct Entry {
    pub tag: str
    pub commit: str
    pub hash: str
    pub yanked: bool
}

fn index_file(index: str, source: str) -> str ! Error {
    if index == "" {
        fail Failed("there is no package index; set LOW_INDEX to a checkout of one")
    }
    if !is_source(source) {
        fail Failed("{source} is not a repository path such as github.com/acme/ui")
    }
    for part in text.split(source, '/') {
        if text.starts_with(part, ".") {
            fail Failed("{source} is not a repository path such as github.com/acme/ui")
        }
    }
    path.join([index, source])
}

fn format_entry(e: Entry) -> str {
    if e.yanked {
        return "{e.tag} {e.commit} {e.hash} {yanked_flag}"
    }
    "{e.tag} {e.commit} {e.hash}"
}

fn parse_entries(content: str, at: str) -> []Entry ! Error {
    var found: []Entry = []
    for i, line in text.lines(content) {
        let fields = text.fields(line)
        if fields.len == 0 {
            continue
        }
        let here = "{at}:{i + 1}"
        if fields.len != 3 && !(fields.len == 4 && fields[3] == yanked_flag) {
            fail Failed("{here}: expected tag, commit and hash, then {yanked_flag} for a yanked version")
        }
        semver.parse(fields[0]) or fail Failed("{here}: {fields[0]} is not a semantic version")
        if !compiler.is_commit(fields[1]) {
            fail Failed("{here}: {fields[1]} is not a commit")
        }
        if !text.starts_with(fields[2], hash_prefix) {
            fail Failed("{here}: {fields[2]} is not a {hash_prefix} hash")
        }
        found.push(Entry { tag: fields[0], commit: fields[1], hash: fields[2], yanked: fields.len == 4 })
    }
    found
}

fn read_entries(location: str) -> []Entry ! Error {
    if !file.exists(location) {
        return []
    }
    let content = file.read_text(location) catch {
        e => fail Failed("read {location}: {e}")
    }
    parse_entries(content, location)?
}

fn indexed(r: *Resolution, source: str) -> []Tag? ! Error {
    let index = r.docs.disk.index
    if index == "" {
        return none
    }
    let location = index_file(index, source)?
    if !file.exists(location) {
        return none
    }
    var tags: []Tag = []
    for e in read_entries(location)? {
        let version = semver.parse(e.tag) or continue
        tags.push(Tag { version, name: e.tag, commit: e.commit, hash: e.hash, yanked: e.yanked })
    }
    newest_first(mut tags)
    tags
}
