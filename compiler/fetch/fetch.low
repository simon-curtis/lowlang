import compiler
import diag
import std/archive/tar
import std/base64
import std/builder
import std/crypto/hash
import std/file
import std/path
import std/process
import std/semver
import std/slices
import std/text

pub enum Error {
    Manifest(compiler.Error)
    Failed(msg: str)
}

pub fn message(e: Error) -> str {
    match e {
        Manifest(inner) => compiler.message(inner)
        Failed(msg) => msg
    }
}

struct Tag {
    version: semver.Version
    name: str
    commit: str
}

struct Want {
    range: compiler.Range
    pos: diag.Pos
}

struct Resolution {
    docs: *compiler.Overlay
    root: str
    cache: str
    update: bool
    locked: [str: compiler.Locked]
    chosen: [str: compiler.Locked] = [:]
    wants: [str: []Want] = [:]
    tags: [str: []Tag] = [:]
    walked: [str: bool] = [:]
}

/// Resolves the version-control dependencies of the project at `root` and of every dependency, places each chosen commit in the module cache of `docs` and writes `build.lock` when the resolution changes. With `update`, each source moves to the newest version its ranges accept.
pub fn sync(docs: *compiler.Overlay, root: str, update: bool) ! Error {
    let manifest = compiler.project_manifest(docs, root) catch Manifest
    let m = manifest ?? return
    let locked = compiler.read_lock(docs, root) catch Manifest
    let r = new(Resolution { docs, root, cache: docs.disk.cache, update, locked })
    r.walked[root] = true
    r.walk(root, m)?
    let entries = r.entries()
    let previous = r.locked_entries()
    if update || !same_entries(entries, previous) {
        write_lock(root, entries)?
    }
}

fn walk(r: *Resolution, dir: str, m: *compiler.Manifest) ! Error {
    for d in m.deps {
        if d.local {
            r.local(compiler.local_dir(dir, d.source))?
            continue
        }
        check_source(d)?
        let range = compiler.parse_range(d.range) ?? fail Failed("{diag.text(d.pos)}: {d.range} is not a version range")
        var held = r.wants[d.source] ?? []
        held.push(Want { range, pos: d.pos })
        r.wants[d.source] = held
        r.choose(d.source)?
    }
}

fn check_source(d: compiler.Dependency) ! Error {
    var valid = d.source != "" && !text.contains(d.source, "\\") && !text.contains(d.source, ":") && !text.contains(d.source, "@")
    for part in text.split(d.source, '/') {
        if part == "" || part == "." || part == ".." {
            valid = false
        }
    }
    if !valid {
        fail Failed("{diag.text(d.pos)}: {d.source} is not a repository path such as github.com/acme/ui")
    }
}

fn local(r: *Resolution, dir: str) ! Error {
    if r.walked[dir] != none {
        return
    }
    r.walked[dir] = true
    let manifest = compiler.project_manifest(r.docs, dir) catch Manifest
    let m = manifest ?? return
    r.walk(dir, m)?
}

fn choose(r: *Resolution, source: str) ! Error {
    let picked = r.pick(source)?
    match r.chosen[source] {
        some(previous) => {
            if previous.commit == picked.commit {
                return
            }
        }
        none => {}
    }
    let placed = r.place(picked)?
    r.chosen[source] = placed
    let dir = compiler.cached_dir(r.cache, source, placed.commit)
    let manifest = compiler.project_manifest(r.docs, dir) catch Manifest
    let m = manifest ?? return
    r.walk(dir, m)?
}

fn pick(r: *Resolution, source: str) -> compiler.Locked ! Error {
    let wants = r.wants[source] ?? []
    if !r.update {
        match r.locked[source] {
            some(held) => {
                if satisfies(wants, held.version) {
                    return held
                }
            }
            none => {}
        }
    }
    let tags = r.tags_of(source)?
    for tag in tags {
        if satisfies(wants, tag.name) {
            return compiler.Locked { source, version: tag.name, commit: tag.commit, hash: "" }
        }
    }
    var ranges: []str = []
    for w in wants {
        ranges.push("{w.range.written} at {diag.text(w.pos)}")
    }
    fail Failed("no tagged version of {source} satisfies {text.join(ranges, ", ")}")
}

fn satisfies(wants: []Want, version: str) -> bool {
    let v = semver.parse(version) or return false
    for w in wants {
        if !compiler.accepts(w.range, v) {
            return false
        }
    }
    true
}

fn tags_of(r: *Resolution, source: str) -> []Tag ! Error {
    match r.tags[source] {
        some(known) => return known
        none => {}
    }
    let listed = git(["ls-remote", "--tags", url_of(source)])?
    let found = parse_tags(listed)
    r.unmoved(source, found)?
    r.tags[source] = found
    found
}

fn unmoved(r: *Resolution, source: str, found: []Tag) ! Error {
    let held = r.locked[source] ?? return
    for tag in found {
        if tag.name == held.version && tag.commit != held.commit {
            fail Failed("{source}: tag {tag.name} moved from {held.commit} to {tag.commit}; a published version never changes")
        }
    }
}

fn parse_tags(listed: str) -> []Tag {
    var commits: [str: str] = [:]
    var peeled: [str: str] = [:]
    for line in text.lines(listed) {
        let fields = text.fields(line)
        if fields.len != 2 {
            continue
        }
        let name = text.strip_prefix(fields[1], "refs/tags/") ?? continue
        if text.ends_with(name, "^{{}}") {
            peeled[name[0..name.len - 3]] = fields[0]
        } else {
            commits[name] = fields[0]
        }
    }
    var tags: []Tag = []
    for name in commits {
        let version = semver.parse(name) or continue
        let commit = peeled[name] ?? commits[name] ?? continue
        tags.push(Tag { version, name, commit })
    }
    slices.sort_by(mut tags, fn(a: Tag, b: Tag) -> bool { semver.compare(a.version, b.version) > 0 })
    tags
}

fn url_of(source: str) -> str {
    "https://{source}"
}

fn place(r: *Resolution, picked: compiler.Locked) -> compiler.Locked ! Error {
    if r.cache == "" {
        fail Failed("{picked.source}: there is no module cache; set LOW_CACHE to a directory")
    }
    let tree = compiler.cached_dir(r.cache, picked.source, picked.commit)
    let expected = r.expected_hash(picked)
    var tree_hash = expected
    if !file.is_dir(tree) {
        tree_hash = materialise(r.cache, picked, expected)?
    } else if expected == "" {
        tree_hash = hash_tree(tree)?
    }
    compiler.Locked { source: picked.source, version: picked.version, commit: picked.commit, hash: tree_hash }
}

fn expected_hash(r: *Resolution, picked: compiler.Locked) -> str {
    let held = r.locked[picked.source] ?? return ""
    if held.commit != picked.commit {
        return ""
    }
    held.hash
}

fn materialise(cache: str, picked: compiler.Locked, expected: str) -> str ! Error {
    let mirror = ensure_mirror(cache, picked.source, picked.commit)?
    let tree = compiler.cached_dir(cache, picked.source, picked.commit)
    let parent = path.dir(tree)
    make_dir(parent)?
    let archived = run_git(["-c", "core.autocrlf=false", "-c", "core.eol=lf", "--git-dir", mirror, "archive", "--format=tar", picked.commit])?
    let staging = staging_dir(parent, "{path.base(tree)}.tmp-*")?
    defer file.remove_all(staging) or {}
    require_plain_entries(archived.stdout, picked)?
    tar.extract(archived.stdout, staging) catch {
        e => fail Failed("extract {picked.source} {picked.version}: {e}")
    }
    let actual = hash_tree(staging)?
    if expected != "" && actual != expected {
        fail Failed("{picked.source} {picked.version}: build.lock holds {expected} but the fetched tree hashes to {actual}")
    }
    adopt(staging, tree)?
    actual
}

fn require_plain_entries(archive: []u8, picked: compiler.Locked) ! Error {
    let r = tar.bytes_reader(archive)
    for {
        let found = tar.next(r) catch {
            e => fail Failed("read the archive of {picked.source} {picked.version}: {e}")
        }
        let entry = found ?? break
        let what = match entry.kind {
            File => continue
            Dir => continue
            Symlink => "a symbolic link"
            Hardlink => "a hard link"
            Other => "neither a file nor a directory"
        }
        fail Failed("{picked.source} {picked.version}: {entry.name} is {what}; a dependency tree holds only files and directories")
    }
}

fn ensure_mirror(cache: str, source: str, commit: str) -> str ! Error {
    let mirror = path.join([cache, "git", source])
    if file.is_dir(mirror) {
        let present = git_succeeds(["--git-dir", mirror, "cat-file", "-e", "{commit}^{{commit}}"])?
        if !present {
            git(["--git-dir", mirror, "fetch", "--quiet", "origin"])?
        }
        return mirror
    }
    let parent = path.dir(mirror)
    make_dir(parent)?
    let staging = staging_dir(parent, "{path.base(mirror)}.tmp-*")?
    defer file.remove_all(staging) or {}
    git(["clone", "--quiet", "--mirror", url_of(source), staging])?
    adopt(staging, mirror)?
    mirror
}

fn make_dir(dir: str) ! Error {
    file.mkdir_all(dir) catch {
        e => fail Failed("create {dir}: {e}")
    }
}

fn staging_dir(parent: str, pattern: str) -> str ! Error {
    file.temp_dir_pattern(parent, pattern) catch {
        e => fail Failed("create a directory in {parent}: {e}")
    }
}

fn adopt(staging: str, target: str) ! Error {
    file.rename(staging, target) catch {
        e => {
            if !file.is_dir(target) {
                fail Failed("move {staging} to {target}: {e}")
            }
        }
    }
}

fn hash_tree(dir: str) -> str ! Error {
    var names: []str = []
    list_files(dir, "", mut names)?
    slices.sort(mut names)
    var summary = builder.builder()
    for name in names {
        let location = "{dir}/{name}"
        let data = file.read_file(location) catch {
            e => fail Failed("read {location}: {e}")
        }
        let sum = hash.sum(hash.sha256(), data)
        builder.write(mut summary, "{text.encode_hex(sum)}  {name}\n")
    }
    let total = hash.sum(hash.sha256(), builder.to_bytes(summary))
    "h1:{base64.encode(total)}"
}

fn list_files(root: str, inside: str, mut names: []str) ! Error {
    var dir = root
    if inside != "" {
        dir = "{root}/{inside}"
    }
    let listing = file.read_dir_info(dir) catch {
        e => fail Failed("list {dir}: {e}")
    }
    for entry in listing {
        var found = entry.name
        if inside != "" {
            found = "{inside}/{entry.name}"
        }
        if entry.dir {
            list_files(root, found, mut names)?
        } else if entry.regular {
            names.push(found)
        }
    }
}

fn run_git(args: []str) -> process.Output ! Error {
    let command = process.command("git", args)
    let out = process.run(command, []) catch {
        e => fail Failed("git: {e}")
    }
    let printed = text.join(args, " ")
    match out.status {
        Exited(code) => {
            if code != 0 {
                let detail = text.trim(str(out.stderr))
                fail Failed("git {printed} exited with status {code}: {detail}")
            }
        }
        Signaled(_) => fail Failed("git {printed} was ended by a signal")
    }
    out
}

fn git(args: []str) -> str ! Error {
    let out = run_git(args)?
    str(out.stdout)
}

fn git_succeeds(args: []str) -> bool ! Error {
    let command = process.command("git", args)
    let out = process.run(command, []) catch {
        e => fail Failed("git: {e}")
    }
    process.success(out.status)
}

fn entries(r: *Resolution) -> []compiler.Locked {
    var out: []compiler.Locked = []
    for _, held in r.chosen {
        out.push(held)
    }
    slices.sort_by(mut out, fn(a: compiler.Locked, b: compiler.Locked) -> bool { a.source < b.source })
    out
}

fn locked_entries(r: *Resolution) -> []compiler.Locked {
    var out: []compiler.Locked = []
    for _, held in r.locked {
        out.push(held)
    }
    slices.sort_by(mut out, fn(a: compiler.Locked, b: compiler.Locked) -> bool { a.source < b.source })
    out
}

fn same_entries(a: []compiler.Locked, b: []compiler.Locked) -> bool {
    if a.len != b.len {
        return false
    }
    for i, e in a {
        let other = b[i]
        if e.source != other.source || e.version != other.version || e.commit != other.commit || e.hash != other.hash {
            return false
        }
    }
    true
}

fn write_lock(root: str, entries: []compiler.Locked) ! Error {
    let lock_path = path.join([root, compiler.lock_file])
    let content = compiler.format_lock(entries)
    file.write_text(lock_path, content) catch {
        e => fail Failed("write {lock_path}: {e}")
    }
}
