import compiler
import diag
import std/file
import std/path
import std/process
import std/semver
import std/slices
import std/text

pub const lock_file = "build.lock"

pub enum Error {
    Manifest(compiler.Error)
    Failed(msg: str)
}

pub fn message(e: Error) -> str {
    match e {
        Manifest(inner) => compiler.message(inner)
        Failed(msg) => msg
    }
}

pub struct Locked {
    pub source: str
    pub version: str
    pub commit: str
}

struct Tag {
    version: semver.Version
    name: str
    commit: str
}

struct Want {
    range: compiler.Range
    pos: diag.Pos
}

struct Resolution {
    docs: *compiler.Overlay
    root: str
    update: bool
    locked: [str: Locked]
    chosen: [str: Locked] = [:]
    wants: [str: []Want] = [:]
    tags: [str: []Tag] = [:]
    walked: [str: bool] = [:]
}

pub fn sync(docs: *compiler.Overlay, root: str, update: bool) ! Error {
    let manifest = compiler.project_manifest(docs, root) catch Manifest
    let m = manifest ?? return
    let lock_path = path.join([root, lock_file])
    let locked = read_lock(lock_path)?
    let r = new(Resolution { docs, root, update, locked })
    r.walked[root] = true
    r.walk(root, m)?
    let entries = r.entries()
    let previous = r.locked_entries()
    if update || !same_entries(entries, previous) {
        write_lock(lock_path, entries)?
    }
}

fn walk(r: *Resolution, dir: str, m: *compiler.Manifest) ! Error {
    for d in m.deps {
        if d.local {
            r.local(compiler.local_dir(dir, d.source))?
            continue
        }
        let range = compiler.parse_range(d.range) ?? fail Failed("{diag.text(d.pos)}: {d.range} is not a version range")
        var held = r.wants[d.source] ?? []
        held.push(Want { range, pos: d.pos })
        r.wants[d.source] = held
        r.choose(d.source)?
    }
}

fn local(r: *Resolution, dir: str) ! Error {
    if r.walked[dir] != none {
        return
    }
    r.walked[dir] = true
    let manifest = compiler.project_manifest(r.docs, dir) catch Manifest
    let m = manifest ?? return
    r.walk(dir, m)?
}

fn choose(r: *Resolution, source: str) ! Error {
    let picked = r.pick(source)?
    match r.chosen[source] {
        some(previous) => {
            if previous.commit == picked.commit {
                return
            }
        }
        none => {}
    }
    r.chosen[source] = picked
    let dir = compiler.fetched_dir(r.root, source)
    checkout(source, dir, picked.commit)?
    let manifest = compiler.project_manifest(r.docs, dir) catch Manifest
    let m = manifest ?? return
    r.walk(dir, m)?
}

fn pick(r: *Resolution, source: str) -> Locked ! Error {
    let wants = r.wants[source] ?? []
    if !r.update {
        match r.locked[source] {
            some(held) => {
                if satisfies(wants, held.version) {
                    return held
                }
            }
            none => {}
        }
    }
    let tags = r.tags_of(source)?
    for tag in tags {
        if satisfies(wants, tag.name) {
            return Locked { source, version: tag.name, commit: tag.commit }
        }
    }
    var ranges: []str = []
    for w in wants {
        ranges.push("{w.range.written} at {diag.text(w.pos)}")
    }
    fail Failed("no tagged version of {source} satisfies {text.join(ranges, ", ")}")
}

fn satisfies(wants: []Want, version: str) -> bool {
    let v = semver.parse(version) or return false
    for w in wants {
        if !compiler.accepts(w.range, v) {
            return false
        }
    }
    true
}

fn tags_of(r: *Resolution, source: str) -> []Tag ! Error {
    match r.tags[source] {
        some(known) => return known
        none => {}
    }
    let listed = git(["ls-remote", "--tags", url_of(source)], "")?
    let found = parse_tags(listed)
    r.tags[source] = found
    found
}

fn parse_tags(listed: str) -> []Tag {
    var commits: [str: str] = [:]
    var peeled: [str: str] = [:]
    for line in text.lines(listed) {
        let fields = text.fields(line)
        if fields.len != 2 {
            continue
        }
        let name = text.strip_prefix(fields[1], "refs/tags/") ?? continue
        if text.ends_with(name, "^{{}}") {
            peeled[name[0..name.len - 3]] = fields[0]
        } else {
            commits[name] = fields[0]
        }
    }
    var tags: []Tag = []
    for name in commits {
        let version = semver.parse(name) or continue
        let commit = peeled[name] ?? commits[name] ?? continue
        tags.push(Tag { version, name, commit })
    }
    slices.sort_by(mut tags, fn(a: Tag, b: Tag) -> bool { semver.compare(a.version, b.version) > 0 })
    tags
}

fn url_of(source: str) -> str {
    "https://{source}"
}

fn checkout(source: str, dir: str, commit: str) ! Error {
    if file.is_dir(dir) {
        let head = git(["-C", dir, "rev-parse", "HEAD"], "")?
        if text.trim(head) == commit {
            return
        }
        git(["-C", dir, "fetch", "--quiet", "--tags", "origin"], "")?
    } else {
        file.mkdir_all(path.dir(dir)) catch {
            e => fail Failed("create {path.dir(dir)}: {e}")
        }
        git(["clone", "--quiet", "--no-checkout", url_of(source), dir], "")?
    }
    git(["-C", dir, "checkout", "--quiet", "--detach", commit], "")?
}

fn git(args: []str, input: str) -> str ! Error {
    let command = process.command("git", args)
    let out = process.run(command, bytes(input)) catch {
        e => fail Failed("git: {e}")
    }
    let printed = text.join(args, " ")
    match out.status {
        Exited(code) => {
            if code != 0 {
                let detail = text.trim(str(out.stderr))
                fail Failed("git {printed} exited with status {code}: {detail}")
            }
        }
        Signaled(_) => fail Failed("git {printed} was ended by a signal")
    }
    str(out.stdout)
}

fn entries(r: *Resolution) -> []Locked {
    var out: []Locked = []
    for _, held in r.chosen {
        out.push(held)
    }
    slices.sort_by(mut out, fn(a: Locked, b: Locked) -> bool { a.source < b.source })
    out
}

fn locked_entries(r: *Resolution) -> []Locked {
    var out: []Locked = []
    for _, held in r.locked {
        out.push(held)
    }
    slices.sort_by(mut out, fn(a: Locked, b: Locked) -> bool { a.source < b.source })
    out
}

fn same_entries(a: []Locked, b: []Locked) -> bool {
    if a.len != b.len {
        return false
    }
    for i, e in a {
        let other = b[i]
        if e.source != other.source || e.version != other.version || e.commit != other.commit {
            return false
        }
    }
    true
}

fn read_lock(lock_path: str) -> [str: Locked] ! Error {
    var held: [str: Locked] = [:]
    if !file.exists(lock_path) {
        return held
    }
    let content = file.read_text(lock_path) catch {
        e => fail Failed("read {lock_path}: {e}")
    }
    for i, line in text.lines(content) {
        let fields = text.fields(line)
        if fields.len == 0 {
            continue
        }
        if fields.len != 3 {
            fail Failed("{lock_path}:{i + 1}: expected source, version and commit")
        }
        held[fields[0]] = Locked { source: fields[0], version: fields[1], commit: fields[2] }
    }
    held
}

fn write_lock(lock_path: str, entries: []Locked) ! Error {
    var lines: []str = []
    for e in entries {
        lines.push("{e.source} {e.version} {e.commit}\n")
    }
    let content = text.join(lines, "")
    file.write_text(lock_path, content) catch {
        e => fail Failed("write {lock_path}: {e}")
    }
}
