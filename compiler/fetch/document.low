import compiler
import target
import std/file
import std/path
import std/slices
import std/text

/// One version in the package index with the public API of the modules of its tree, as `compiler.document` reads them. Each module's `path` is the path it is imported by: the source for the modules directory itself and the source and a `/` before the module's directory below it.
pub struct Release {
    pub tag: str
    pub commit: str
    pub hash: str
    pub yanked: bool
    pub modules: []*compiler.ModuleDoc
}

/// A package of the package index with its versions, newest first. A yanked version is listed like any other.
pub struct Package {
    pub source: str
    pub releases: []Release
}

/// Documents every version of every package in the package index of `docs`, in the order of the sources.
///
/// Each version's tree comes from the module cache, fetched and checked against the index's hash when it is not there yet. A source is a file of the index with a directory above it, so a file at the top of the checkout is not a package. An absent or unset index lists no package. The modules are those of the tree that an import reaches: the directories that hold `.low` files for `platform` other than tests, skipping `testdata`, `examples` and directories that start with `.` or `_`, inside the `modules` directory of its `build.low`.
pub fn document_index(docs: *compiler.Overlay, platform: target.OS) -> []Package ! Error {
    let index = docs.disk.index
    if index == "" || !file.is_dir(index) {
        return []
    }
    let r = new(Resolution { docs, root: "", cache: docs.disk.cache, update: false, locked: [:] })
    var found: []Package = []
    for source in indexed_sources(index)? {
        let tags = r.indexed(source)? ?? []
        var releases: []Release = []
        for tag in tags {
            let picked = compiler.Locked { source, version: tag.name, commit: tag.commit, hash: tag.hash }
            r.place(picked)?
            let tree = compiler.cached_dir(r.cache, source, tag.commit)
            let modules = documented(docs, tree, source, tag, platform)?
            releases.push(Release { tag: tag.name, commit: tag.commit, hash: tag.hash, yanked: tag.yanked, modules })
        }
        found.push(Package { source, releases })
    }
    found
}

fn indexed_sources(index: str) -> []str ! Error {
    let root = path.clean(index)
    var found: []str = []
    let visit = fn(v: file.Visit) -> file.Step {
        if v.dir {
            if v.depth > 0 && text.starts_with(v.name, ".") {
                return file.Step.Skip
            }
            return file.Step.Continue
        }
        let source = text.strip_prefix(v.path, "{root}/") ?? v.path
        if v.regular && text.contains(source, "/") {
            found.push(source)
        }
        file.Step.Continue
    }
    file.walk(root, visit) catch {
        e => fail Failed("list {index}: {e}")
    }
    slices.sort(mut found)
    found
}

fn documented(docs: *compiler.Overlay, tree: str, source: str, tag: Tag, platform: target.OS) -> []*compiler.ModuleDoc ! Error {
    let at = "{source} {tag.name}"
    let manifest = compiler.project_manifest(docs, tree) catch Manifest
    let base = compiler.modules_dir(tree, manifest)
    let all = compiler.document(tree, platform, docs) catch {
        e => fail Failed("{at}: {compiler.message(e)}")
    }
    let built = modules_of(tree, platform)?
    var kept: []*compiler.ModuleDoc = []
    for m in all {
        let dir = path.join([tree, m.path])
        if !slices.contains(built, dir) {
            continue
        }
        if dir == base {
            m.path = source
        } else {
            let below = text.strip_prefix(dir, "{base}/") ?? continue
            m.path = "{source}/{below}"
        }
        kept.push(m)
    }
    kept
}
