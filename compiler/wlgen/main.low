import emit
import std/file
import std/flag
import std/os

enum Failure {
    Usage(message: str)
    Failed(message: str)
}

fn flag_specs() -> []flag.Spec {
    [flag.Spec { name: "o", help: "output .low file" }]
}

fn main() {
    command(os.args()[1..]) catch {
        Usage(message) => {
            emit.eprint(message)
            os.exit(2)
        }
        Failed(message) => {
            emit.eprint("wlgen: {message}")
            os.exit(1)
        }
    }
}

fn command(arguments: []str) ! Failure {
    let specs = flag_specs()
    let program = os.args()[0]
    let parsed = flag.parse(specs, arguments) catch {
        e => fail Usage(emit.flag_failure(program, specs, e))
    }
    let output = flag.get(parsed, "o")
    if output == "" || parsed.rest.len == 0 {
        fail Usage("usage: wlgen -o out.low protocol.xml...")
    }
    run(output, parsed.rest) catch {
        Failed(message) => fail Failed(message)
    }
}

fn run(output: str, paths: []str) ! Error {
    var protocols: []Protocol = []
    for path in paths {
        let data = file.read_file(path) catch {
            e => fail Failed("open {path}: {emit.io_message(e)}")
        }
        let protocol = parse(data) catch {
            Failed(message) => fail Failed("{path}: {message}")
        }
        push(mut protocols, protocol)
    }
    let source = generate(protocols)?
    file.write_text_mode(output, source, 0o644) catch {
        e => fail Failed("open {output}: {emit.io_message(e)}")
    }
}
