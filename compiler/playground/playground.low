import compiler
import ir
import lint
import target
import wasm
import std/builder
import std/io
import std/stdio

const entry = "main.low"

enum Error {
    Input(io.Error)
    Output(io.Error)
    Front(compiler.Error)
    Back(wasm.Error)
}

fn main() {
    compile() catch {
        e => {
            let line = describe(e)
            emit(bytes("{line}\n"))
            stdio.exit(1)
        }
    }
}

fn compile() ! Error {
    let source = io.read_all(stdio.stdin()) catch Input
    let docs = compiler.new_overlay(sourceless())
    compiler.overlay_put(docs, entry, str(source))
    let profile = compiler.release(target.OS.Browser)
    let jobs = ir.sequential()
    let unit = compiler.analyse(entry, profile, docs, jobs) catch Front
    report(unit)
    let program = unit.program ?? panic("unit without a program")
    let image = wasm.generate(program, unit.embeds) catch Back
    io.write_all(stdio.stdout(), image) catch Output
}

fn describe(e: Error) -> str {
    match e {
        Input(inner) => "read standard input: {inner}"
        Output(inner) => "write standard output: {inner}"
        Front(inner) => compiler.message(inner)
        Back(inner) => wasm.message(inner)
    }
}

fn report(unit: *compiler.Unit) {
    var b = builder.builder()
    for w in unit.warnings {
        b.write("{lint.string(w)}\n")
    }
    emit(b.to_bytes())
}

fn emit(data: []u8) {
    io.write_all(stdio.stderr(), data) catch {
        _ => {}
    }
}

fn sourceless() -> compiler.Disk {
    compiler.Disk { read: absent_file, stat: absent_info, list: absent_dir, cwd: root, drives: false }
}

fn absent_file(name: str) -> []u8 ! io.Error {
    fail io.Error.NotFound
}

fn absent_info(name: str) -> compiler.Info ! io.Error {
    fail io.Error.NotFound
}

fn absent_dir(name: str) -> []compiler.Entry ! io.Error {
    fail io.Error.NotFound
}

fn root() -> str ! io.Error {
    ""
}
