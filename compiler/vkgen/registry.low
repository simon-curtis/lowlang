import emit
import std/compress/deflate
import std/file
import std/regex
import std/slices
import std/text
import std/xml

const gzip_limit = 1073741824

pub struct Registry {
    pub types: []Type
    pub enums: []Enums
    pub commands: []Command
    pub features: []Feature
    pub extensions: []Extension
}

pub struct Type {
    pub category: str = ""
    pub name: str = ""
    pub alias: str = ""
    pub api: str = ""
    pub requires: str = ""
    pub bit_values: str = ""
    pub inner: str = ""
    pub members: []Member = []
    pub name_inside: str = ""
    pub proto_name: str = ""
}

pub struct Member {
    pub values: str = ""
    pub optional: str = ""
    pub length: str = ""
    pub api: str = ""
    pub inner: str = ""
}

pub struct Enums {
    pub name: str = ""
    pub kind: str = ""
    pub bit_width: str = ""
    pub values: []Enum = []
}

pub struct Enum {
    pub name: str = ""
    pub value: str = ""
    pub bit_pos: str = ""
    pub alias: str = ""
    pub api: str = ""
    pub kind: str = ""
    pub extends: str = ""
    pub offset: str = ""
    pub ext_number: str = ""
    pub dir: str = ""
}

pub struct Command {
    pub name: str = ""
    pub alias: str = ""
    pub api: str = ""
    pub proto: Member = Member {}
    pub params: []Param = []
}

pub struct Param {
    pub optional: str = ""
    pub length: str = ""
    pub api: str = ""
    pub inner: str = ""
}

pub struct Feature {
    pub api: str = ""
    pub name: str = ""
    pub requires: []Require = []
}

pub struct Extension {
    pub name: str = ""
    pub number: str = ""
    pub requires: []Require = []
}

pub struct Require {
    pub api: str = ""
    pub enums: []Enum = []
}

pub struct Decl {
    pub constant: bool = false
    pub type: str = ""
    pub stars: i64 = 0
    pub name: str = ""
    pub dims: []str = []
    pub bit_field: bool = false
}

pub struct Evaluated {
    pub value: i64
    pub ok: bool
}

pub fn read_registry(path: str) -> Registry ! Error {
    var data = file.read_file(path) catch {
        e => fail Failed("open {path}: {emit.io_message(e)}")
    }
    if text.ends_with(path, ".gz") {
        data = deflate.gzip_decompress(data, gzip_limit) catch {
            e => fail Failed("{path}: {emit.io_message(e)}")
        }
    }
    parse(data)?
}

fn parse(data: []u8) -> Registry ! Error {
    let root = xml.parse(data) catch {
        e => fail Failed(emit.xml_message(e))
    }
    var r = Registry { types: [], enums: [], commands: [], features: [], extensions: [] }
    for section in xml.children(root, "types") {
        for element in xml.children(section, "type") {
            push(mut r.types, read_type(element))
        }
    }
    for element in xml.children(root, "enums") {
        push(mut r.enums, read_enums(element))
    }
    for section in xml.children(root, "commands") {
        for element in xml.children(section, "command") {
            push(mut r.commands, read_command(element))
        }
    }
    for element in xml.children(root, "feature") {
        push(mut r.features, read_feature(element))
    }
    for section in xml.children(root, "extensions") {
        for element in xml.children(section, "extension") {
            push(mut r.extensions, read_extension(element))
        }
    }
    if r.types.len == 0 || r.commands.len == 0 {
        fail Failed("not a Vulkan registry: no types or commands")
    }
    r
}

fn attribute(e: *xml.Element, name: str) -> str {
    emit.attribute_text(e, name)
}

fn last_text(elements: []*xml.Element) -> str {
    if elements.len == 0 {
        return ""
    }
    xml.text(elements[elements.len - 1])
}

fn read_type(e: *xml.Element) -> Type {
    var members: []Member = []
    for element in xml.children(e, "member") {
        push(mut members, read_member(element))
    }
    var proto_names: []*xml.Element = []
    for proto in xml.children(e, "proto") {
        for name in xml.children(proto, "name") {
            push(mut proto_names, name)
        }
    }
    Type {
        category: attribute(e, "category")
        name: attribute(e, "name")
        alias: attribute(e, "alias")
        api: attribute(e, "api")
        requires: attribute(e, "requires")
        bit_values: attribute(e, "bitvalues")
        inner: emit.inner_xml(e)
        members
        name_inside: last_text(xml.children(e, "name"))
        proto_name: last_text(proto_names)
    }
}

fn read_member(e: *xml.Element) -> Member {
    Member {
        values: attribute(e, "values")
        optional: attribute(e, "optional")
        length: attribute(e, "len")
        api: attribute(e, "api")
        inner: emit.inner_xml(e)
    }
}

fn read_enums(e: *xml.Element) -> Enums {
    var values: []Enum = []
    for element in xml.children(e, "enum") {
        push(mut values, read_enum(element))
    }
    Enums { name: attribute(e, "name"), kind: attribute(e, "type"), bit_width: attribute(e, "bitwidth"), values }
}

fn read_enum(e: *xml.Element) -> Enum {
    Enum {
        name: attribute(e, "name")
        value: attribute(e, "value")
        bit_pos: attribute(e, "bitpos")
        alias: attribute(e, "alias")
        api: attribute(e, "api")
        kind: attribute(e, "type")
        extends: attribute(e, "extends")
        offset: attribute(e, "offset")
        ext_number: attribute(e, "extnumber")
        dir: attribute(e, "dir")
    }
}

fn read_command(e: *xml.Element) -> Command {
    var proto = Member {}
    for element in xml.children(e, "proto") {
        proto = read_member(element)
    }
    var params: []Param = []
    for element in xml.children(e, "param") {
        push(mut params, read_param(element))
    }
    Command { name: attribute(e, "name"), alias: attribute(e, "alias"), api: attribute(e, "api"), proto, params }
}

fn read_param(e: *xml.Element) -> Param {
    Param {
        optional: attribute(e, "optional")
        length: attribute(e, "len")
        api: attribute(e, "api")
        inner: emit.inner_xml(e)
    }
}

fn read_requires(e: *xml.Element) -> []Require {
    var requires: []Require = []
    for element in xml.children(e, "require") {
        var enums: []Enum = []
        for item in xml.children(element, "enum") {
            push(mut enums, read_enum(item))
        }
        let api = attribute(element, "api")
        push(mut requires, Require { api, enums })
    }
    requires
}

fn read_feature(e: *xml.Element) -> Feature {
    Feature { api: attribute(e, "api"), name: attribute(e, "name"), requires: read_requires(e) }
}

fn read_extension(e: *xml.Element) -> Extension {
    Extension { name: attribute(e, "name"), number: attribute(e, "number"), requires: read_requires(e) }
}

pub fn for_vulkan(api: str) -> bool {
    if api == "" {
        return true
    }
    text.split(api, ',').contains("vulkan")
}

fn remove_comments(inner: str) -> str {
    let comments = regex.generated("(?s)<comment>.*?</comment>")
    regex.replace_all(comments, inner, fn(m: regex.Match) -> str { "" })
}

pub fn parse_decl(inner: str) -> Decl ! Error {
    let stripped = remove_comments(inner)
    let type_tag = regex.generated("<type[^>]*>(.*?)</type>")
    let name_tag = regex.generated("<name[^>]*>(.*?)</name>")
    let type_match = regex.find(type_tag, stripped) ?? fail Failed("cannot parse declaration {text.quote(inner)}")
    let name_match = regex.find(name_tag, stripped) ?? fail Failed("cannot parse declaration {text.quote(inner)}")
    let type_name = regex.group(type_match, 1) ?? ""
    let name = regex.group(name_match, 1) ?? ""
    let before = stripped[..regex.start(type_match)]
    let between_from = regex.end(type_match)
    let between_to = regex.start(name_match)
    if between_to < between_from {
        fail Failed("cannot parse declaration {text.quote(inner)}")
    }
    let rest = stripped[regex.end(name_match)..]
    Decl {
        constant: text.contains(before, "const")
        type: type_name
        stars: text.count(stripped[between_from..between_to], "*")
        name
        dims: dimensions(rest)
        bit_field: text.starts_with(text.trim(rest), ":")
    }
}

fn dimensions(rest: str) -> []str {
    let pattern = regex.generated("\\[(?:<enum>(.*?)</enum>|(\\d+))\\]")
    var dims: []str = []
    for m in regex.find_all(pattern, rest) {
        let named = regex.group(m, 1) ?? ""
        if named != "" {
            push(mut dims, named)
        } else {
            push(mut dims, regex.group(m, 2) ?? "")
        }
    }
    dims
}

fn atoi(s: str) -> i64 ! Error {
    text.parse_int(s) catch {
        Overflow => fail Failed("strconv.Atoi: parsing {text.quote(s)}: value out of range")
        _ => fail Failed("strconv.Atoi: parsing {text.quote(s)}: invalid syntax")
    }
}

pub fn enum_value(e: Enum, extension: i64) -> Evaluated ! Error {
    if e.alias != "" {
        return Evaluated { value: 0, ok: false }
    }
    if e.bit_pos != "" {
        let pos = atoi(e.bit_pos)?
        if pos < 0 {
            fail Failed("negative shift amount {pos}")
        }
        let one: i64 = 1
        let value = if pos >= 64 { 0 } else { one << pos }
        return Evaluated { value, ok: true }
    }
    if e.offset != "" {
        var ext = extension
        if e.ext_number != "" {
            ext = atoi(e.ext_number)?
        }
        let offset = text.parse_int(e.offset) catch {
            Overflow => fail Failed("strconv.ParseInt: parsing {text.quote(e.offset)}: value out of range")
            _ => fail Failed("strconv.ParseInt: parsing {text.quote(e.offset)}: invalid syntax")
        }
        let magnitude = 1000000000 + (ext - 1) * 1000 + offset
        return Evaluated { value: if e.dir == "-" { 0 - magnitude } else { magnitude }, ok: true }
    }
    if e.value != "" {
        let value = parse_number(e.value)?
        return Evaluated { value, ok: true }
    }
    Evaluated { value: 0, ok: false }
}

fn trim_parentheses(s: str) -> str {
    var from = 0
    var to = s.len
    for from < to && (s[from] == '(' || s[from] == ')') {
        from += 1
    }
    for to > from && (s[to - 1] == '(' || s[to - 1] == ')') {
        to -= 1
    }
    s[from..to]
}

struct Radix {
    digits: str
    base: i64
}

fn radix_of(s: str) -> Radix {
    if s.len > 2 && s[0] == '0' {
        let marker = s[1]
        if marker == 'x' || marker == 'X' {
            return Radix { digits: s[2..], base: 16 }
        }
        if marker == 'b' || marker == 'B' {
            return Radix { digits: s[2..], base: 2 }
        }
        if marker == 'o' || marker == 'O' {
            return Radix { digits: s[2..], base: 8 }
        }
    }
    if s.len > 1 && s[0] == '0' {
        return Radix { digits: s[1..], base: 8 }
    }
    Radix { digits: s, base: 10 }
}

fn magnitude(s: str) -> u64 ! text.ParseError {
    let radix = radix_of(s)
    text.parse_u64(radix.digits, radix.base)?
}

fn signed_integer(s: str) -> i64 ! text.ParseError {
    let negative = text.starts_with(s, "-")
    let unsigned = if negative || text.starts_with(s, "+") { s[1..] } else { s }
    let value = magnitude(unsigned)?
    let limit: u64 = 0x7FFFFFFFFFFFFFFF
    if negative {
        if value > limit + 1 {
            fail Overflow
        }
        return 0 - i64(value)
    }
    if value > limit {
        fail Overflow
    }
    i64(value)
}

fn integer_failure(s: str, e: text.ParseError) -> Error {
    let reason = match e {
        Overflow => "value out of range"
        _ => "invalid syntax"
    }
    Failed("strconv.ParseInt: parsing {text.quote(s)}: {reason}")
}

pub fn parse_number(spelling: str) -> i64 ! Error {
    var s = trim_parentheses(spelling)
    let invert = text.starts_with(s, "~")
    s = text.trim_prefix(s, "~")
    for suffix in ["ULL", "LL", "UL", "U", "L"] {
        if text.ends_with(s, suffix) {
            s = text.trim_suffix(s, suffix)
            break
        }
    }
    if text.contains(s, ".") || text.starts_with(s, "\"") {
        fail Failed("not an integer: {spelling}")
    }
    var value = signed_integer(s) catch {
        first => {
            let unsigned = magnitude(s) catch {
                _ => fail integer_failure(s, first)
            }
            i64(unsigned)
        }
    }
    if invert {
        value = 0 - value - 1
    }
    value
}
