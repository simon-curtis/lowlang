import emit
import std/file
import std/flag
import std/os

enum Failure {
    Usage(message: str)
    Failed(message: str)
}

fn flag_specs() -> []flag.Spec {
    [
        flag.Spec { name: "o", help: "output directory for vulkan.low and one vulkan_<system>.low per target" }
        flag.Spec { name: "registry", help: "vk.xml or vk.xml.gz" }
        flag.Spec { name: "select", help: "selection list of extensions, commands, types and libraries" }
    ]
}

fn main() {
    execute(os.args()[1..]) catch {
        Usage(message) => {
            emit.eprint(message)
            os.exit(2)
        }
        Failed(message) => {
            emit.eprint("vkgen: {message}")
            os.exit(1)
        }
    }
}

fn execute(arguments: []str) ! Failure {
    let specs = flag_specs()
    let program = os.args()[0]
    let parsed = flag.parse(specs, arguments) catch {
        e => fail Usage(emit.flag_failure(program, specs, e))
    }
    let output = flag.get(parsed, "o")
    let registry = flag.get(parsed, "registry")
    let selection = flag.get(parsed, "select")
    if output == "" || registry == "" || selection == "" {
        fail Usage("usage: vkgen -registry vk.xml.gz -select vulkan.list -o directory")
    }
    run(output, registry, selection) catch {
        Failed(message) => fail Failed(message)
    }
}

fn run(output: str, registry_path: str, selection_path: str) ! Error {
    let reg = read_registry(registry_path)?
    let source = file.read_text(selection_path) catch {
        e => fail Failed("open {selection_path}: {emit.io_message(e)}")
    }
    let sel = parse_selection(source)?
    let files = generate(reg, sel)?
    file.mkdir_all_mode(output, 0o755) catch {
        e => fail Failed("mkdir {output}: {emit.io_message(e)}")
    }
    for f in files {
        let path = file.child_path(output, f.name)
        file.write_text_mode(path, f.source, 0o644) catch {
            e => fail Failed("open {path}: {emit.io_message(e)}")
        }
    }
}
