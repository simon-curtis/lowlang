import emit
import std/file
import std/flag
import std/os
import std/path
import std/protobuf/proto
import std/text

enum Failure {
    Usage(message: str)
    Failed(message: str)
}

fn flag_specs() -> []flag.Spec {
    [
        flag.Spec { name: "I", help: "comma-separated directories that imports are resolved against", fallback: "." },
        flag.Spec { name: "o", help: "directory the generated modules are written to" },
        flag.Spec { name: "module", help: "import path of the output directory, when it is not the project root" },
    ]
}

fn main() {
    command(os.args()[1..]) catch {
        Usage(message) => {
            emit.eprint(message)
            os.exit(2)
        }
        Failed(message) => {
            emit.eprint("protogen: {message}")
            os.exit(1)
        }
    }
}

fn command(arguments: []str) ! Failure {
    let specs = flag_specs()
    let program = os.args()[0]
    let parsed = flag.parse(specs, arguments) catch {
        e => fail Usage(emit.flag_failure(program, specs, e))
    }
    let output = flag.get(parsed, "o")
    if output == "" || parsed.rest.len == 0 {
        fail Usage("usage: protogen [-I dir,...] [-module path] -o outdir file.proto...")
    }
    let roots = text.split(flag.get(parsed, "I"), ',')
    let options = proto.Options { module: flag.get(parsed, "module") }
    run(parsed.rest, roots, output, options)?
}

fn run(paths: []str, roots: []str, output: str, options: proto.Options) ! Failure {
    let set = proto.read_files(paths, roots, file.read_text) catch {
        e => fail Failed(proto.message(e))
    }
    let outputs = proto.generate(set, options) catch {
        e => fail Failed(proto.message(e))
    }
    for o in outputs {
        write_output(output, o)?
    }
}

fn write_output(output: str, o: proto.Output) ! Failure {
    let target = path.join([output, o.path])
    file.mkdir_all(path.dir(target)) catch {
        e => fail Failed("create {path.dir(target)}: {emit.io_message(e)}")
    }
    file.write_text_mode(target, o.text, 0o644) catch {
        e => fail Failed("write {target}: {emit.io_message(e)}")
    }
}
