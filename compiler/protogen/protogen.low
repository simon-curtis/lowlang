import compiler
import std/file
import std/path
import std/protobuf/proto

pub enum Error {
    Failed(message: str)
}

pub struct Config {
    pub files: []str
    pub roots: []str
    pub output: str
    pub module: str
}

pub fn run(config: Config) ! Error {
    let set = proto.read_files(config.files, config.roots, file.read_text) catch {
        e => fail Failed(proto.message(e))
    }
    let outputs = proto.generate(set, proto.Options { module: config.module }) catch {
        e => fail Failed(proto.message(e))
    }
    for o in outputs {
        write_output(config.output, o)?
    }
}

fn write_output(output: str, o: proto.Output) ! Error {
    let target = path.join([output, o.path])
    file.mkdir_all(path.dir(target)) catch {
        e => fail Failed("create {path.dir(target)}: {compiler.reason(e)}")
    }
    file.write_text_mode(target, o.text, 0o644) catch {
        e => fail Failed("write {target}: {compiler.reason(e)}")
    }
}
