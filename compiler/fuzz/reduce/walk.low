import fuzz/model

struct Walker {
    target: i64
    seen: i64
}

struct ListVisitor {
    visit: fn(mut []model.Stmt) -> bool
}

struct SlotVisitor {
    visit: fn(mut model.Expr) -> bool
}

fn counting() -> *Walker {
    new(Walker { target: -1, seen: 0 })
}

fn hit(w: *Walker) -> bool {
    let reached = w.seen == w.target
    w.seen += 1
    reached
}

fn each_list(p: *model.Program, visit: fn(mut []model.Stmt) -> bool) -> bool {
    let v = new(ListVisitor { visit })
    for f in p.funcs {
        if lists_in(mut f.body, v) {
            return true
        }
    }
    lists_in(mut p.main, v)
}

fn lists_in(mut list: []model.Stmt, v: *ListVisitor) -> bool {
    if v.visit(mut list) {
        return true
    }
    for s in list {
        if lists_in_stmt(s, v) {
            return true
        }
    }
    false
}

fn lists_in_stmt(s: model.Stmt, v: *ListVisitor) -> bool {
    match s {
        IfStmt(n) => {
            if lists_in(mut n.then, v) {
                return true
            }
            lists_in(mut n.otherwise, v)
        }
        Range(n) => lists_in(mut n.body, v)
        While(n) => lists_in(mut n.body, v)
        _ => false
    }
}

pub fn each_slot(p: *model.Program, visit: fn(mut model.Expr) -> bool) -> bool {
    let v = new(SlotVisitor { visit })
    for f in p.funcs {
        if stmt_slots(f.body, v) || slots_in(mut f.tail, v) {
            return true
        }
    }
    stmt_slots(p.main, v)
}

fn stmt_slots(stmts: []model.Stmt, v: *SlotVisitor) -> bool {
    for s in stmts {
        if stmt_slot(s, v) {
            return true
        }
    }
    false
}

fn stmt_slot(s: model.Stmt, v: *SlotVisitor) -> bool {
    match s {
        Let(n) => slots_in(mut n.init, v)
        Assign(n) => slots_in(mut n.value, v)
        IfStmt(n) => slots_in(mut n.cond, v) || stmt_slots(n.then, v) || stmt_slots(n.otherwise, v)
        Range(n) => slots_in(mut n.lo, v) || slots_in(mut n.hi, v) || stmt_slots(n.body, v)
        While(n) => while_slots(n, v)
        Return(n) => slots_in(mut n.value, v)
        Print(n) => slots_in(mut n.value, v)
        _ => false
    }
}

fn while_slots(n: *model.While, v: *SlotVisitor) -> bool {
    match n.cond {
        some(c) => {
            var slot = c
            let found = slots_in(mut slot, v)
            n.cond = some(slot)
            if found {
                return true
            }
        }
        none => {}
    }
    stmt_slots(n.body, v)
}

fn slots_in(mut e: model.Expr, v: *SlotVisitor) -> bool {
    if v.visit(mut e) {
        return true
    }
    match e {
        Unary(x) => slots_in(mut x.x, v)
        Binary(x) => slots_in(mut x.l, v) || slots_in(mut x.r, v)
        Convert(x) => slots_in(mut x.x, v)
        IfExpr(x) => slots_in(mut x.cond, v) || slots_in(mut x.then, v) || slots_in(mut x.otherwise, v)
        Math(x) => slots_in(mut x.x, v)
        Call(x) => call_slots(x, v)
        _ => false
    }
}

fn call_slots(x: *model.Call, v: *SlotVisitor) -> bool {
    for i in 0..x.args.len {
        if slots_in(mut x.args[i], v) {
            return true
        }
    }
    false
}
