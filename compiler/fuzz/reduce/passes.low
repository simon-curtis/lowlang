import fuzz/model
import std/math
import std/slices
import std/text

fn passes() -> []fn(*model.Program, *Walker) {
    [remove_funcs, remove_params, remove_stmts, unwrap_stmts, simplify_loops, simplify_exprs, shrink_literals]
}

fn deleted[T](xs: []T, start: i64, end: i64) -> []T {
    let head = xs[..start]
    let tail = xs[end..]
    slices.concat(head, tail)
}

fn remove_funcs(p: *model.Program, w: *Walker) {
    var called: [str: bool] = [:]
    each_slot(p, fn(mut e: model.Expr) -> bool {
        match e {
            Call(c) => {
                called[c.callee] = true
            }
            _ => {}
        }
        false
    })
    for i, f in p.funcs {
        if called[f.name] ?? false {
            continue
        }
        if hit(w) {
            p.funcs = deleted(p.funcs, i, i + 1)
            return
        }
    }
}

fn is_variable(e: model.Expr, name: str) -> bool {
    match e {
        Var(v) => v.name == name
        _ => false
    }
}

fn uses_variable(f: *model.Func, name: str) -> bool {
    var used = false
    let single = new(model.Program { funcs: [f], main: [] })
    each_slot(single, fn(mut e: model.Expr) -> bool {
        if is_variable(e, name) {
            used = true
        }
        used
    })
    used
}

fn drop_param(p: *model.Program, f: *model.Func, index: i64) {
    f.params = deleted(f.params, index, index + 1)
    each_slot(p, fn(mut e: model.Expr) -> bool {
        match e {
            Call(c) => {
                if c.callee == f.name {
                    c.args = deleted(c.args, index, index + 1)
                }
            }
            _ => {}
        }
        false
    })
}

fn remove_params(p: *model.Program, w: *Walker) {
    for f in p.funcs {
        for j, param in f.params {
            if uses_variable(f, param.name) {
                continue
            }
            if hit(w) {
                drop_param(p, f, j)
                return
            }
        }
    }
}

fn remove_stmts(p: *model.Program, w: *Walker) {
    each_list(p, fn(mut list: []model.Stmt) -> bool { remove_chunks(w, mut list) })
}

fn remove_chunks(w: *Walker, mut list: []model.Stmt) -> bool {
    let n = list.len
    var size = n
    for size >= 1 {
        var start = 0
        for start < n {
            let end = math.min(start + size, n)
            if hit(w) {
                list = deleted(list, start, end)
                return true
            }
            start += size
        }
        size /= 2
    }
    false
}

fn splice(mut list: []model.Stmt, i: i64, body: []model.Stmt) {
    let head = list[..i]
    let tail = list[i + 1..]
    let front = slices.concat(head, body)
    list = slices.concat(front, tail)
}

fn unwrap_stmts(p: *model.Program, w: *Walker) {
    each_list(p, fn(mut list: []model.Stmt) -> bool { unwrap_list(w, mut list) })
}

fn unwrap_list(w: *Walker, mut list: []model.Stmt) -> bool {
    for i, s in list {
        if unwrap_at(mut list, i, s, w) {
            return true
        }
    }
    false
}

fn unwrap_at(mut list: []model.Stmt, i: i64, s: model.Stmt, w: *Walker) -> bool {
    match s {
        IfStmt(n) => {
            if hit(w) {
                splice(mut list, i, n.then)
                return true
            }
            if n.otherwise.len == 0 {
                return false
            }
            if hit(w) {
                splice(mut list, i, n.otherwise)
                return true
            }
            if hit(w) {
                n.otherwise = []
                return true
            }
            false
        }
        Range(n) => {
            if hit(w) {
                splice(mut list, i, n.body)
                return true
            }
            false
        }
        While(n) => {
            if hit(w) {
                splice(mut list, i, n.body)
                return true
            }
            false
        }
        _ => false
    }
}

fn simplify_loops(p: *model.Program, w: *Walker) {
    each_list(p, fn(mut list: []model.Stmt) -> bool { simplify_list(w, list) })
}

fn simplify_list(w: *Walker, list: []model.Stmt) -> bool {
    for s in list {
        match s {
            While(n) => {
                if simplify_loop(w, n) {
                    return true
                }
            }
            _ => {}
        }
    }
    false
}

fn has_cond(n: *model.While) -> bool {
    match n.cond {
        some(_) => true
        none => false
    }
}

fn simplify_loop(w: *Walker, n: *model.While) -> bool {
    if n.bound > 1 && hit(w) {
        n.bound = 1
        return true
    }
    if has_cond(n) && hit(w) {
        n.cond = none
        return true
    }
    false
}

fn zero(kind: model.Kind) -> model.Expr {
    model.Expr.Lit(new(model.Lit { kind }))
}

fn one(kind: model.Kind) -> model.Expr {
    if model.is_float(kind) {
        return model.Expr.Lit(new(model.Lit { kind, float: 1.0 }))
    }
    model.Expr.Lit(new(model.Lit { kind, bits: 1 }))
}

fn operands(e: model.Expr) -> []model.Expr {
    match e {
        Unary(n) => [n.x]
        Binary(n) => [n.l, n.r]
        Convert(n) => [n.x]
        IfExpr(n) => [n.then, n.otherwise]
        Math(n) => [n.x]
        _ => []
    }
}

fn candidates(e: model.Expr) -> []model.Expr {
    let kind = model.expr_type(e)
    var out = [zero(kind)]
    for operand in operands(e) {
        if model.expr_type(operand) == kind {
            push(mut out, operand)
        }
    }
    push(mut out, one(kind))
    out
}

fn is_literal(e: model.Expr) -> bool {
    match e {
        Lit(_) => true
        _ => false
    }
}

fn simplify_exprs(p: *model.Program, w: *Walker) {
    each_slot(p, fn(mut e: model.Expr) -> bool { simplify_slot(w, mut e) })
}

fn simplify_slot(w: *Walker, mut e: model.Expr) -> bool {
    if is_literal(e) {
        return false
    }
    for c in candidates(e) {
        if hit(w) {
            e = c
            return true
        }
    }
    false
}

fn literal_with(l: *model.Lit, bits: u64, f: f64) -> model.Expr {
    model.Expr.Lit(new(model.Lit { kind: l.kind, bits, float: f }))
}

fn truncated(v: f64) -> f64 {
    if v < 0.0 {
        return -floor(-v)
    }
    floor(v)
}

fn has_sign(v: f64) -> bool {
    text.float_bits(v) >> 63 == 1
}

fn smaller(l: *model.Lit) -> []model.Expr {
    var out: []model.Expr = []
    if l.kind == model.Kind.Bool {
        if l.bits != 0 {
            push(mut out, literal_with(l, 0, 0.0))
        }
        return out
    }
    if model.is_float(l.kind) {
        if l.float != 0.0 || has_sign(l.float) {
            push(mut out, literal_with(l, 0, 0.0))
        }
        let magnitude = if l.float < 0.0 { -l.float } else { l.float }
        if magnitude > 1.0 {
            push(mut out, literal_with(l, 0, 1.0))
        }
        let t = truncated(l.float)
        if t != l.float && t != 0.0 {
            push(mut out, literal_with(l, 0, t))
        }
        return out
    }
    if l.bits != 0 {
        push(mut out, literal_with(l, 0, 0.0))
    }
    if l.bits > 1 {
        push(mut out, literal_with(l, 1, 0.0))
        push(mut out, literal_with(l, l.bits >> 1, 0.0))
    }
    out
}

fn shrink_literals(p: *model.Program, w: *Walker) {
    each_slot(p, fn(mut e: model.Expr) -> bool { shrink_slot(w, mut e) })
}

fn shrink_slot(w: *Walker, mut e: model.Expr) -> bool {
    match e {
        Lit(lit) => {
            for c in smaller(lit) {
                if hit(w) {
                    e = c
                    return true
                }
            }
            false
        }
        _ => false
    }
}
