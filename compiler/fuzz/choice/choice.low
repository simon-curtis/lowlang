pub struct Source {
    rng: *Rng?
    bytes: []u8
    pos: i64
}

pub fn from_seed(seed: i64) -> *Source {
    let rng = new_rng(seed)
    new(Source { rng, bytes: [], pos: 0 })
}

pub fn from_bytes(data: []u8) -> *Source {
    new(Source { rng: none, bytes: data, pos: 0 })
}

pub fn uint64(s: *Source) -> u64 {
    match s.rng {
        some(r) => return rng_uint64(r)
        none => {}
    }
    var word: u64 = 0
    var taken = 0
    for taken < 8 && s.pos + taken < s.bytes.len {
        word |= u64(s.bytes[s.pos + taken]) << (8 * taken)
        taken += 1
    }
    s.pos += taken
    word
}

pub fn intn(s: *Source, n: i64) -> i64 {
    if n <= 1 {
        return 0
    }
    match s.rng {
        some(r) => return rng_intn(r, n)
        none => {}
    }
    if n <= 256 {
        return byte_choice(s) % n
    }
    i64(uint64(s) % u64(n))
}

fn byte_choice(s: *Source) -> i64 {
    if s.pos >= s.bytes.len {
        return 0
    }
    let b = s.bytes[s.pos]
    s.pos += 1
    i64(b)
}

pub fn boolean(s: *Source) -> bool {
    intn(s, 2) == 1
}

pub fn chance(s: *Source, percent: i64) -> bool {
    intn(s, 100) < percent
}

pub fn range(s: *Source, lo: i64, hi: i64) -> i64 {
    lo + intn(s, hi - lo + 1)
}

pub fn pick[T](s: *Source, items: []T) -> T {
    items[intn(s, items.len)]
}
