const rng_len = 607
const rng_tap = 273
const int32_max = 2147483647
const default_seed = 89482311

struct Rng {
    tap: i64
    feed: i64
    vec: []i64
}

fn seedrand(x: i64) -> i64 {
    let hi = x / 44488
    let lo = x % 44488
    let next = 48271 * lo - 3399 * hi
    if next < 0 {
        return next + int32_max
    }
    next
}

fn new_rng(seed: i64) -> *Rng {
    var reduced = seed % int32_max
    if reduced < 0 {
        reduced += int32_max
    }
    if reduced == 0 {
        reduced = default_seed
    }
    let table = cooked()
    var vec: []i64 = []
    var x = reduced
    for i in -20..rng_len {
        x = seedrand(x)
        if i >= 0 {
            var u = x << 40
            x = seedrand(x)
            u ^= x << 20
            x = seedrand(x)
            u ^= x
            u ^= table[i]
            push(mut vec, u)
        }
    }
    new(Rng { tap: 0, feed: rng_len - rng_tap, vec })
}

fn rng_uint64(r: *Rng) -> u64 {
    r.tap -= 1
    if r.tap < 0 {
        r.tap += rng_len
    }
    r.feed -= 1
    if r.feed < 0 {
        r.feed += rng_len
    }
    let x = r.vec[r.feed] + r.vec[r.tap]
    r.vec[r.feed] = x
    u64(x)
}

fn rng_int63(r: *Rng) -> i64 {
    let masked: u64 = rng_uint64(r) & 0x7FFFFFFFFFFFFFFF
    i64(masked)
}

fn rng_int31(r: *Rng) -> i64 {
    rng_int63(r) >> 32
}

fn rng_int31n(r: *Rng, n: i64) -> i64 {
    if n & (n - 1) == 0 {
        return rng_int31(r) & (n - 1)
    }
    let limit = int32_max - (2147483648 % n)
    var v = rng_int31(r)
    for v > limit {
        v = rng_int31(r)
    }
    v % n
}

fn rng_int63n(r: *Rng, n: i64) -> i64 {
    if n & (n - 1) == 0 {
        return rng_int63(r) & (n - 1)
    }
    let top: u64 = 0x8000000000000000
    let limit = i64(0x7FFFFFFFFFFFFFFF - top % u64(n))
    var v = rng_int63(r)
    for v > limit {
        v = rng_int63(r)
    }
    v % n
}

fn rng_intn(r: *Rng, n: i64) -> i64 {
    if n <= int32_max {
        return rng_int31n(r, n)
    }
    rng_int63n(r, n)
}
