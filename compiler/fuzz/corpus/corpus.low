import fixture
import fuzz/model
import std/crypto/hash
import std/file
import std/io

pub enum Error {
    Create(error: io.Error)
    Write(error: io.Error)
    Sidecar(error: fixture.Error)
}

pub fn message(e: Error) -> str {
    match e {
        Create(error) => "create fixture directory: {error}"
        Write(error) => "write fixture: {error}"
        Sidecar(error) => fixture.message(error)
    }
}

pub struct Fixture {
    pub sidecars: fixture.Sidecars
    pub name: str
    pub source: str
}

pub fn from_program(p: *model.Program, outcome: model.Outcome) -> Fixture {
    let source = model.to_string(p)
    let sum = hash.sum(hash.sha256(), bytes(source))
    let name = "fuzz_{hex_prefix(sum, 4)}"
    let sidecars = fixture.Sidecars {
        stdout: outcome.stdout
        stderr: model.stderr(outcome)
        panics: outcome.panic_message != ""
    }
    Fixture { sidecars, name, source }
}

fn hex_prefix(data: []u8, count: i64) -> str {
    var out = ""
    for i in 0..count {
        out = "{out}{hex_byte(data[i])}"
    }
    out
}

fn hex_byte(v: u8) -> str {
    let digits = "0123456789abcdef"
    let high = digits[i64(v >> 4)..i64(v >> 4) + 1]
    let low = digits[i64(v & 15)..i64(v & 15) + 1]
    "{high}{low}"
}

pub fn write(f: Fixture, dir: str) -> str ! Error {
    file.mkdir_all(dir) catch {
        e => fail Create(e)
    }
    let path = file.child_path(dir, "{f.name}{fixture.source_ext}")
    file.write_text(path, f.source) catch {
        e => fail Write(e)
    }
    fixture.write(f.sidecars, path) catch {
        e => fail Sidecar(e)
    }
    path
}
