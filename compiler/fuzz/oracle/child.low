import std/cancel
import std/io
import std/process
import signals = std/os/signal

enum Ending {
    Exited
    TimedOut
    Cancelled
}

struct Captured {
    exit: process.Exit
    stdout: str
    stderr: str
    ending: Ending
}

struct Collected {
    data: []u8
    done: chan[bool]
}

fn capture(ctx: *cancel.Token, program: str, args: []str, limit_ms: i64) -> Captured ! io.Error {
    let command = process.Command {
        program
        args
        stdin: process.Stdio.Null
        stdout: process.Stdio.Piped
        stderr: process.Stdio.Piped
        group: true
    }
    using child = process.start(command)?
    let out = new(Collected { data: [], done: chan[bool](1) })
    let err = new(Collected { data: [], done: chan[bool](1) })
    collect_from(child.handle.stdout, out)
    collect_from(child.handle.stderr, err)
    let ending = wait_for_exit(ctx, child.handle, limit_ms)
    <-out.done
    <-err.done
    let exit = process.wait(child)?
    Captured { exit, stdout: str(out.data), stderr: str(err.data), ending }
}

fn collect_from(stream: io.Stream?, into: *Collected) {
    match stream {
        some(s) => {
            spawn collect(s, into)
        }
        none => {
            into.done <- true
        }
    }
}

fn collect(stream: io.Stream, into: *Collected) {
    let buffer = io.buffer(65536)
    for {
        let n = stream.read(buffer) or break
        if n == 0 {
            break
        }
        io.append(mut into.data, buffer[..n])
    }
    stream.close()
    into.done <- true
}

fn wait_for_exit(ctx: *cancel.Token, handle: *process.ChildHandle, limit_ms: i64) -> Ending {
    let exited = chan[bool](1)
    spawn await_exit(handle, exited)
    select {
        <-exited => Ending.Exited
        after(limit_ms) => stop_child(handle, exited, Ending.TimedOut)
        <-cancel.done(ctx) => stop_child(handle, exited, Ending.Cancelled)
    }
}

fn stop_child(handle: *process.ChildHandle, exited: chan[bool], ending: Ending) -> Ending {
    process.kill_on(handle, signals.Signal.Kill) or {}
    <-exited
    ending
}

fn await_exit(handle: *process.ChildHandle, exited: chan[bool]) {
    process.wait_exit_on(handle) or {}
    exited <- true
}

fn signal_text(exit: process.Exit) -> str {
    match exit {
        Exited(code) => ""
        Signaled(signal) => "signal: {signals.name(signal)}"
    }
}

fn exit_status(exit: process.Exit) -> i64 {
    match exit {
        Exited(code) => code
        Signaled(signal) => -1
    }
}
