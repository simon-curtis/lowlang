import compiler
import fixture
import fuzz/model
import target
import std/cancel
import std/file
import std/text

pub const class_ice = "ice"
pub const class_reject = "reject"
pub const class_link = "link"
pub const class_timeout = "timeout"
pub const class_harness = "harness"
pub const class_generator = "generator"
pub const class_reference = "reference-mismatch"
pub const class_differential = "release-dev-mismatch"

const exit_reject = 3
const exit_link = 4
const build_limit_ms = 600000

pub enum Mode {
    Release
    Dev
}

pub fn mode_name(m: Mode) -> str {
    match m {
        Release => "release"
        Dev => "dev"
    }
}

fn mode_profile(name: str) -> compiler.Profile {
    if name == "dev" {
        return compiler.dev()
    }
    compiler.release(target.OS.Linux)
}

pub struct Finding {
    pub class: str
    pub detail: str
    pub source: str
}

pub fn signature(f: Finding) -> str {
    let detail = mask_digits(first_line(f.detail))
    "{f.class}:{detail}"
}

fn is_word(b: u8) -> bool {
    b == '_' || (b >= '0' && b <= '9') || (b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z')
}

fn is_digit(b: u8) -> bool {
    b >= '0' && b <= '9'
}

fn mask_digits(s: str) -> str {
    let data = bytes(s)
    var out: []u8 = []
    var i = 0
    for i < data.len {
        if !is_digit(data[i]) {
            push(mut out, data[i])
            i += 1
            continue
        }
        var end = i
        for end < data.len && is_digit(data[end]) {
            end += 1
        }
        let word_before = i > 0 && is_word(data[i - 1])
        let word_after = end < data.len && is_word(data[end])
        if word_before || word_after {
            for j in i..end {
                push(mut out, data[j])
            }
        } else {
            push(mut out, '#')
        }
        i = end
    }
    str(out)
}

pub struct Result {
    pub stdout: str = ""
    pub stderr: str = ""
    pub exit: i64 = 0
    pub signal: str = ""
}

pub fn expected(o: model.Outcome) -> Result {
    Result { stdout: o.stdout, stderr: model.stderr(o), exit: model.exit_code(o) }
}

pub struct Runner {
    pub timeout_ms: i64
    pub executable: str
}

pub fn reproduces(r: Runner, wanted: str, budget: i64) -> fn(*cancel.Token, *model.Program) -> bool {
    fn(ctx: *cancel.Token, p: *model.Program) -> bool { reproduced(r, wanted, budget, ctx, p) }
}

fn reproduced(r: Runner, wanted: str, budget: i64, ctx: *cancel.Token, p: *model.Program) -> bool {
    let outcome = model.run(p, budget) or return false
    let source = model.to_string(p)
    for f in check(r, ctx, source, outcome) {
        if signature(f) == wanted {
            return true
        }
    }
    false
}

enum Fault {
    Stage(class: str, detail: str)
    Other(message: str)
}

struct ModeResult {
    mode: Mode
    result: Result
}

pub fn check(r: Runner, ctx: *cancel.Token, source: str, expected_outcome: model.Outcome) -> []Finding {
    let want = expected(expected_outcome)
    var findings: []Finding = []
    var ran: []ModeResult = []
    for mode in [Mode.Release, Mode.Dev] {
        let got = execute(r, ctx, source, mode) catch {
            fault => {
                push(mut findings, failure(mode, fault, source))
                continue
            }
        }
        push(mut ran, ModeResult { mode, result: got })
    }
    if ran.len == 2 {
        let diff = describe(ran[0].result, ran[1].result)
        if diff != "" {
            push(mut findings, Finding { class: class_differential, detail: diff, source })
        }
    }
    for m in ran {
        let diff = describe(want, m.result)
        if diff != "" {
            let detail = "{mode_name(m.mode)}: {diff}"
            push(mut findings, Finding { class: class_reference, detail, source })
        }
    }
    findings
}

fn failure(mode: Mode, fault: Fault, source: str) -> Finding {
    match fault {
        Stage(class, detail) => Finding { class, detail: "{mode_name(mode)}: {detail}", source }
        Other(message) => Finding { class: class_harness, detail: "{mode_name(mode)}: {message}", source }
    }
}

fn execute(r: Runner, ctx: *cancel.Token, source: str, mode: Mode) -> Result ! Fault {
    let dir = file.temp_dir("lowfuzz-") catch {
        e => fail Other("{e}")
    }
    defer file.remove_all(dir) or {}
    let binary = file.child_path(dir, "main")
    build(r, ctx, dir, binary, source, mode)?
    run(r, ctx, binary)?
}

fn build(r: Runner, ctx: *cancel.Token, dir: str, binary: str, source: str, mode: Mode) ! Fault {
    let path = file.child_path(dir, "main.low")
    file.write_text(path, source) catch {
        e => fail Other("{e}")
    }
    let args = ["__build", mode_name(mode), path, binary]
    let done = capture(ctx, r.executable, args, build_limit_ms) catch {
        e => fail Other("{e}")
    }
    check_ending(done.ending, "build: ", build_limit_ms)?
    let status = exit_status(done.exit)
    let output = text.trim(done.stdout)
    if status == 0 {
        return
    }
    if status == exit_reject {
        let message = text.replace(output, "{dir}/", "")
        fail Stage(class_reject, message)
    }
    if status == exit_link {
        fail Stage(class_link, output)
    }
    let detail = crash_detail(done)
    fail Stage(class_ice, detail)
}

fn check_ending(ending: Ending, prefix: str, limit_ms: i64) ! Fault {
    match ending {
        TimedOut => {
            let limit = fixture.duration_text(limit_ms * 1000000)
            fail Stage(class_timeout, "{prefix}no exit within {limit}")
        }
        Cancelled => fail Other("cancelled")
        Exited => {}
    }
}

fn crash_detail(done: Captured) -> str {
    let line = first_line(text.trim(done.stderr))
    if line != "" {
        return line
    }
    let signal = signal_text(done.exit)
    if signal != "" {
        return signal
    }
    "exit {exit_status(done.exit)}"
}

fn run(r: Runner, ctx: *cancel.Token, binary: str) -> Result ! Fault {
    let done = capture(ctx, binary, [], r.timeout_ms) catch {
        e => fail Other("{e}")
    }
    check_ending(done.ending, "", r.timeout_ms)?
    Result { stdout: done.stdout, stderr: done.stderr, exit: exit_status(done.exit), signal: signal_text(done.exit) }
}

pub fn build_main(args: []str) -> i64 {
    let profile = mode_profile(args[0])
    let unit = compiler.analyse(args[1], profile) catch {
        e => return report_failure(exit_reject, compiler.message(e))
    }
    compiler.build(unit, args[2]) catch {
        e => return report_failure(exit_link, compiler.message(e))
    }
    0
}

fn report_failure(code: i64, message: str) -> i64 {
    print(message)
    code
}

fn describe(want: Result, got: Result) -> str {
    if want.signal != got.signal {
        return "signal {text.quote(got.signal)}, want {text.quote(want.signal)}"
    }
    if want.exit != got.exit {
        return "exit {got.exit}, want {want.exit}"
    }
    if want.stdout != got.stdout {
        return "stdout {first_difference(want.stdout, got.stdout)}"
    }
    if want.stderr != got.stderr {
        return "stderr {text.quote(got.stderr)}, want {text.quote(want.stderr)}"
    }
    ""
}

fn first_difference(want: str, got: str) -> str {
    let want_lines = text.split(want, 10)
    let got_lines = text.split(got, 10)
    let count = if want_lines.len > got_lines.len { want_lines.len } else { got_lines.len }
    for i in 0..count {
        var w = ""
        var g = ""
        if i < want_lines.len {
            w = want_lines[i]
        }
        if i < got_lines.len {
            g = got_lines[i]
        }
        if w != g {
            return "line {i + 1} is {text.quote(g)}, want {text.quote(w)}"
        }
    }
    "identical"
}

fn first_line(s: str) -> str {
    let at = text.index_byte(s, 10)
    if at < 0 {
        return s
    }
    s[..at]
}
