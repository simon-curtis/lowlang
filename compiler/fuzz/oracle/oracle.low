import compiler
import fixture
import fuzz/model
import native
import std/slices
import target
import std/cancel
import std/file
import std/io
import std/math
import std/os
import std/text

pub const class_ice = "ice"
pub const class_reject = "reject"
pub const class_link = "link"
pub const class_timeout = "timeout"
pub const class_harness = "harness"
pub const class_generator = "generator"
pub const class_reference = "reference-mismatch"
pub const class_differential = "release-dev-mismatch"
pub const class_browser = "browser-mismatch"
pub const class_fault = "runtime-fault"
pub const class_panic = "unexpected-panic"

const exit_reject = 3
const exit_link = 4
const build_limit_ms = 600000

pub enum Mode {
    Release
    Dev
    Browser
}

pub fn mode_name(m: Mode) -> str {
    match m {
        Release => "release"
        Dev => "dev"
        Browser => "browser"
    }
}

fn artifact_name(m: Mode) -> str {
    match m {
        Browser => "main.wasm"
        _ => "main"
    }
}

fn mode_profile(name: str) -> compiler.Profile {
    match name {
        "dev" => compiler.dev(target.host())
        "browser" => compiler.release(target.OS.Browser)
        _ => compiler.release(target.OS.Linux)
    }
}

pub struct Finding {
    pub class: str
    pub detail: str
    pub source: str
}

pub fn signature(f: Finding) -> str {
    let detail = mask_digits(first_line(f.detail))
    "{f.class}:{detail}"
}

fn is_word(b: u8) -> bool {
    b == '_' || (b >= '0' && b <= '9') || (b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z')
}

fn is_digit(b: u8) -> bool {
    b >= '0' && b <= '9'
}

fn mask_digits(s: str) -> str {
    let data = bytes(s)
    var out: []u8 = []
    var i = 0
    for i < data.len {
        if !is_digit(data[i]) {
            push(mut out, data[i])
            i += 1
            continue
        }
        var end = i
        for end < data.len && is_digit(data[end]) {
            end += 1
        }
        let word_before = i > 0 && is_word(data[i - 1])
        let word_after = end < data.len && is_word(data[end])
        if word_before || word_after {
            for j in i..end {
                push(mut out, data[j])
            }
        } else {
            push(mut out, '#')
        }
        i = end
    }
    str(out)
}

pub struct Result {
    pub stdout: str = ""
    pub stderr: str = ""
    pub exit: i64 = 0
    pub signal: str = ""
}

pub fn expected(o: model.Outcome) -> Result {
    Result { stdout: o.stdout, stderr: model.stderr(o), exit: model.exit_code(o) }
}

/// The environment one run of a compiled program gets.
pub struct Condition {
    pub name: str
    /// Runs with `LOW_GC=stress`.
    pub stress: bool = false
    /// Runs with `LOW_SIMD=sse2`.
    pub sse2: bool = false
    /// Pins the run to this many CPUs with `taskset`, or leaves it unpinned when 0.
    pub cpus: i64 = 0
}

pub enum ConditionError {
    Unknown(word: str)
}

pub fn condition_message(e: ConditionError) -> str {
    match e {
        Unknown(word) => "unknown condition {text.quote(word)}: want plain, stress, sse2 or cpusN joined by +"
    }
}

/// Parses a comma-separated list of conditions, each a `+`-joined set of `plain`, `stress`, `sse2` and `cpusN`.
pub fn parse_conditions(spec: str) -> []Condition ! ConditionError {
    var out: []Condition = []
    for name in text.split(spec, ',') {
        var c = Condition { name }
        for word in text.split(name, '+') {
            if word == "stress" {
                c.stress = true
            } else if word == "sse2" {
                c.sse2 = true
            } else if text.starts_with(word, "cpus") {
                c.cpus = text.parse_int(word[4..]) catch {
                    e => fail Unknown(word)
                }
            } else if word != "plain" {
                fail Unknown(word)
            }
        }
        push(mut out, c)
    }
    out
}

pub struct Runner {
    pub timeout_ms: i64
    pub executable: str
    pub node: str = ""
    pub host: str = ""
    /// The conditions each native build runs under, in turn. Empty means one plain run.
    pub conditions: []Condition = []
    /// How many times each native build runs under every condition.
    pub repeats: i64 = 1
}

fn conditions_of(r: Runner) -> []Condition {
    if r.conditions.len == 0 {
        return [Condition { name: "plain" }]
    }
    r.conditions
}

fn varied(r: Runner) -> bool {
    r.conditions.len > 0 || r.repeats > 1
}

pub fn reproduces(r: Runner, wanted: str, budget: i64) -> fn(*cancel.Token, *model.Program) -> bool {
    fn(ctx: *cancel.Token, p: *model.Program) -> bool { reproduced(r, wanted, budget, ctx, p) }
}

fn reproduced(r: Runner, wanted: str, budget: i64, ctx: *cancel.Token, p: *model.Program) -> bool {
    let outcome = model.run(p, budget) or return false
    let source = model.to_string(p)
    var modes: []Mode = []
    for m in [Mode.Release, Mode.Dev] {
        if text.contains(wanted, ":{mode_name(m)}: ") {
            push(mut modes, m)
        }
    }
    if modes.len == 0 {
        modes = [Mode.Release, Mode.Dev]
    }
    check_modes(r, ctx, source, outcome, modes).any(fn(f) signature(f) == wanted)
}

enum Fault {
    Stage(class: str, detail: str)
    Other(message: str)
}

struct ModeResult {
    mode: Mode
    result: Result
}

pub fn check(r: Runner, ctx: *cancel.Token, source: str, expected_outcome: model.Outcome) -> []Finding {
    check_modes(r, ctx, source, expected_outcome, [Mode.Release, Mode.Dev])
}

fn check_modes(r: Runner, ctx: *cancel.Token, source: str, expected_outcome: model.Outcome, modes: []Mode) -> []Finding {
    var findings: []Finding = []
    var ran: []ModeResult = []
    for mode in modes {
        let got = exercise(r, ctx, source, mode, expected_outcome, mut findings) catch {
            fault => {
                push(mut findings, failure(mode, fault, source))
                continue
            }
        }
        push(mut ran, ModeResult { mode, result: got })
    }
    let faulted = findings.any(fn(f) f.class == class_fault || f.class == class_panic)
    if ran.len == 2 && !expected_outcome.overflow && !faulted {
        let diff = describe(ran[0].result, ran[1].result)
        if diff != "" {
            push(mut findings, Finding { class: class_differential, detail: diff, source })
        }
    }
    if r.node != "" && ran.len > 0 && ran[0].mode == Mode.Release && !expected_outcome.overflow && !expected_outcome.system {
        check_browser(r, ctx, source, ran[0].result, mut findings)
    }
    findings
}

struct Verdict {
    class: str = ""
    detail: str = ""
}

fn line_with(s: str, prefix: str) -> str {
    for line in text.split(s, 10) {
        if text.starts_with(line, prefix) {
            return line
        }
    }
    ""
}

const overflow_message = "stack overflow"
const fault_message = "invalid memory access"

fn overflowed(want: Result, got: Result) -> bool {
    if got.exit != 2 || !text.starts_with(want.stdout, got.stdout) || !text.contains(got.stderr, overflow_message) {
        return false
    }
    var rest = text.replace(got.stderr, "panic: ", "")
    rest = text.replace(rest, overflow_message, "")
    text.trim(rest) == ""
}

fn panic_summary(stderr: str) -> str {
    for message in [fault_message, overflow_message] {
        if text.contains(stderr, message) {
            return "panic: {message}"
        }
    }
    line_with(stderr, "panic: ")
}

fn hex_field(line: str, name: str) -> u64 {
    let at = text.index(line, "{name} 0x")
    if at < 0 {
        return 0
    }
    var v: u64 = 0
    for b in bytes(line[at + name.len + 3..]) {
        let digit = text.hex_digit(b)
        if digit < 0 {
            break
        }
        v = v << 4 | u64(digit)
    }
    v
}

/// Says where a `fault:` line puts the stack pointer: on no green thread, below the green thread's stack, or inside it.
fn fault_place(line: str) -> str {
    if line == "" {
        return ""
    }
    let stack = hex_field(line, "stack")
    if stack == 0 {
        return ", on no green thread"
    }
    if hex_field(line, "sp") < stack {
        return ", sp below the stack"
    }
    ", on a green thread"
}

fn fault_line(stderr: str) -> str {
    let at = text.index(stderr, "fault: address ")
    if at < 0 {
        return ""
    }
    let rest = stderr[at..]
    let end = text.index(rest, "\n")
    if end < 0 {
        return rest
    }
    rest[..end]
}

fn judge(want: Result, got: Result, overflow: bool) -> Verdict {
    let fault = fault_line(got.stderr)
    let panic = panic_summary(got.stderr)
    if got.signal != want.signal {
        return Verdict { class: class_fault, detail: "{got.signal}{fault_place(fault)}\n{fault}" }
    }
    if fault != "" {
        return Verdict { class: class_fault, detail: "{panic}{fault_place(fault)}\n{fault}" }
    }
    if overflow && overflowed(want, got) {
        return Verdict {}
    }
    let diff = describe(want, got)
    if diff == "" {
        return Verdict {}
    }
    if panic != "" && got.stderr != want.stderr {
        return Verdict { class: class_panic, detail: "{panic}\n{diff}" }
    }
    Verdict { class: class_reference, detail: diff }
}

fn located(r: Runner, detail: str, cond: Condition, index: i64) -> str {
    if !varied(r) {
        return detail
    }
    "{detail}\ncondition {cond.name}, run {index}"
}

fn exercise(r: Runner, ctx: *cancel.Token, source: str, mode: Mode, expected_outcome: model.Outcome, mut findings: []Finding) -> Result ! Fault {
    let dir = file.temp_dir("lowfuzz-") catch {
        e => fail Other("{e}")
    }
    defer file.remove_all(dir) or {}
    let binary = file.child_path(dir, artifact_name(mode))
    build(r, ctx, dir, binary, source, mode)?
    let want = expected(expected_outcome)
    let conditions = conditions_of(r)
    var first = Result {}
    for rep in 0..math.max(1, r.repeats) {
        for at, cond in conditions {
            let index = rep * conditions.len + at
            let got = run(r, ctx, binary, mode, cond, index) catch {
                Stage(class, detail) => fail Stage(class, located(r, detail, cond, index))
                e => fail e
            }
            if index == 0 {
                first = got
            }
            let verdict = judge(want, got, expected_outcome.overflow)
            if verdict.class != "" {
                let detail = located(r, "{mode_name(mode)}: {verdict.detail}", cond, index)
                push(mut findings, Finding { class: verdict.class, detail, source })
                return first
            }
        }
    }
    first
}

fn check_browser(r: Runner, ctx: *cancel.Token, source: str, release: Result, mut findings: []Finding) {
    let got = browser_run(r, ctx, source) catch {
        fault => {
            push(mut findings, failure(Mode.Browser, fault, source))
            return
        }
    }
    let diff = describe_browser(release, got)
    if diff != "" {
        push(mut findings, Finding { class: class_browser, detail: "browser: {diff}", source })
    }
}

fn browser_run(r: Runner, ctx: *cancel.Token, source: str) -> Result ! Fault {
    let dir = file.temp_dir("lowfuzz-") catch {
        e => fail Other("{e}")
    }
    defer file.remove_all(dir) or {}
    let binary = file.child_path(dir, artifact_name(Mode.Browser))
    build(r, ctx, dir, binary, source, Mode.Browser)?
    run(r, ctx, binary, Mode.Browser, Condition { name: "plain" }, 0)?
}

fn failure(mode: Mode, fault: Fault, source: str) -> Finding {
    match fault {
        Stage(class, detail) => Finding { class, detail: "{mode_name(mode)}: {detail}", source }
        Other(message) => Finding { class: class_harness, detail: "{mode_name(mode)}: {message}", source }
    }
}

fn build(r: Runner, ctx: *cancel.Token, dir: str, binary: str, source: str, mode: Mode) ! Fault {
    let path = file.child_path(dir, "main.low")
    file.write_text(path, source) catch {
        e => fail Other("{e}")
    }
    let args = ["__build", mode_name(mode), path, binary]
    let done = capture(ctx, r.executable, args, none, build_limit_ms) catch {
        e => fail Other("{e}")
    }
    check_ending(done.ending, "build: ", build_limit_ms)?
    let status = exit_status(done.exit)
    let output = text.trim(done.stdout)
    if status == 0 {
        return
    }
    if status == exit_reject {
        let message = text.replace(output, "{dir}/", "")
        fail Stage(class_reject, message)
    }
    if status == exit_link {
        fail Stage(class_link, output)
    }
    let detail = crash_detail(done)
    fail Stage(class_ice, detail)
}

fn check_ending(ending: Ending, prefix: str, limit_ms: i64) ! Fault {
    match ending {
        TimedOut => {
            let limit = fixture.duration_text(limit_ms * 1000000)
            fail Stage(class_timeout, "{prefix}no exit within {limit}")
        }
        Cancelled => fail Other("cancelled")
        Exited => {}
    }
}

fn crash_detail(done: Captured) -> str {
    let line = first_line(text.trim(done.stderr))
    if line != "" {
        return line
    }
    let signal = signal_text(done.exit)
    if signal != "" {
        return signal
    }
    "exit {exit_status(done.exit)}"
}

fn run(r: Runner, ctx: *cancel.Token, binary: str, mode: Mode, cond: Condition, index: i64) -> Result ! Fault {
    let done = capture_run(r, ctx, binary, mode, cond, index) catch {
        e => fail Other("{e}")
    }
    check_ending(done.ending, "", r.timeout_ms)?
    Result { stdout: done.stdout, stderr: done.stderr, exit: exit_status(done.exit), signal: signal_text(done.exit) }
}

fn capture_run(r: Runner, ctx: *cancel.Token, binary: str, mode: Mode, cond: Condition, index: i64) -> Captured ! io.Error {
    if mode == Mode.Browser {
        return capture(ctx, r.node, [r.host, binary], none, r.timeout_ms)
    }
    let env = condition_env(cond)
    if cond.cpus == 0 {
        return capture(ctx, binary, [], env, r.timeout_ms)
    }
    let cpus = cpu_list(os.cpu_count(), cond.cpus, index)
    capture(ctx, "taskset", ["-c", cpus, binary], env, r.timeout_ms)?
}

fn condition_env(cond: Condition) -> [str: str]? {
    if !cond.stress && !cond.sse2 {
        return none
    }
    var env = os.environment()
    if cond.stress {
        env["LOW_GC"] = "stress"
    }
    if cond.sse2 {
        env["LOW_SIMD"] = "sse2"
    }
    env
}

fn cpu_list(total: i64, count: i64, index: i64) -> str {
    var cpus: []str = []
    for i in 0..math.min(count, total) {
        push(mut cpus, "{(index * count + i) % total}")
    }
    text.join(cpus, ",")
}

pub fn build_main(args: []str) -> i64 {
    let profile = mode_profile(args[0])
    let unit = native.analyse(args[1], profile) catch {
        e => return report_failure(exit_reject, native.message(e))
    }
    native.build(unit, args[2]) catch {
        e => return report_failure(exit_link, native.message(e))
    }
    0
}

fn report_failure(code: i64, message: str) -> i64 {
    print(message)
    code
}

fn describe(want: Result, got: Result) -> str {
    if want.signal != got.signal {
        return "signal {text.quote(got.signal)}, want {text.quote(want.signal)}"
    }
    if want.exit != got.exit {
        return "exit {got.exit}, want {want.exit}"
    }
    if want.stdout != got.stdout {
        return "stdout {first_difference(want.stdout, got.stdout)}"
    }
    if want.stderr != got.stderr {
        return "stderr {text.quote(got.stderr)}, want {text.quote(want.stderr)}"
    }
    ""
}

fn describe_browser(want: Result, got: Result) -> str {
    if want.exit != got.exit {
        return "exit {got.exit}, native release {want.exit}"
    }
    if want.stdout != got.stdout {
        return "stdout {first_difference(want.stdout, got.stdout)}"
    }
    ""
}

fn first_difference(want: str, got: str) -> str {
    let want_lines = text.split(want, 10)
    let got_lines = text.split(got, 10)
    let count = if want_lines.len > got_lines.len { want_lines.len } else { got_lines.len }
    for i in 0..count {
        var w = ""
        var g = ""
        if i < want_lines.len {
            w = want_lines[i]
        }
        if i < got_lines.len {
            g = got_lines[i]
        }
        if w != g {
            return "line {i + 1} is {text.quote(g)}, want {text.quote(w)}"
        }
    }
    "identical"
}

fn first_line(s: str) -> str {
    let at = text.index_byte(s, 10)
    if at < 0 {
        return s
    }
    s[..at]
}
