import fuzz/choice
import fuzz/model

enum StmtKind {
    StmtLet
    StmtAssign
    StmtIf
    StmtRange
    StmtWhile
    StmtJump
    StmtReturn
    StmtPrint
}

struct StmtWeight {
    kind: StmtKind
    weight: i64
}

fn stmt_weights() -> []StmtWeight {
    [
        StmtWeight { kind: StmtKind.StmtLet, weight: 25 }
        StmtWeight { kind: StmtKind.StmtAssign, weight: 20 }
        StmtWeight { kind: StmtKind.StmtIf, weight: 15 }
        StmtWeight { kind: StmtKind.StmtRange, weight: 8 }
        StmtWeight { kind: StmtKind.StmtWhile, weight: 6 }
        StmtWeight { kind: StmtKind.StmtJump, weight: 8 }
        StmtWeight { kind: StmtKind.StmtReturn, weight: 4 }
        StmtWeight { kind: StmtKind.StmtPrint, weight: 6 }
    ]
}

fn block(g: *Generator, nest: i64, count: i64) -> []model.Stmt {
    let saved = g.vars.len
    var stmts: []model.Stmt = []
    for _ in 0..count {
        push(mut stmts, stmt(g, nest))
    }
    truncate(mut g.vars, saved)
    stmts
}

fn pick_stmt(g: *Generator, nest: i64) -> StmtKind {
    let table = stmt_weights()
    for {
        var total = 0
        for w in table {
            total += w.weight
        }
        var n = choice.intn(g.src, total)
        for w in table {
            if n >= w.weight {
                n -= w.weight
                continue
            }
            if allowed(g, w.kind, nest) {
                return w.kind
            }
            break
        }
    }
    StmtKind.StmtPrint
}

fn allowed(g: *Generator, kind: StmtKind, nest: i64) -> bool {
    match kind {
        StmtAssign => mutable_vars(g).len > 0
        StmtIf => nest < g.cfg.max_nest
        StmtRange => nest < g.cfg.max_nest
        StmtWhile => nest < g.cfg.max_nest
        StmtJump => g.loops.len > 0
        _ => true
    }
}

fn stmt(g: *Generator, nest: i64) -> model.Stmt {
    match pick_stmt(g, nest) {
        StmtLet => let_stmt(g)
        StmtAssign => assign(g)
        StmtIf => if_stmt(g, nest)
        StmtRange => range_stmt(g, nest)
        StmtWhile => while_stmt(g, nest)
        StmtJump => jump(g)
        StmtReturn => return_stmt(g)
        StmtPrint => print_stmt(g)
    }
}

fn return_stmt(g: *Generator) -> model.Stmt {
    let cond = expr(g, model.Kind.Bool, 2)
    let value = expr(g, g.result, 2)
    let ret = model.Stmt.Return(new(model.Return { value }))
    model.Stmt.IfStmt(new(model.IfStmt { cond, then: [ret] }))
}

fn print_stmt(g: *Generator) -> model.Stmt {
    let value = printable(g)
    model.Stmt.Print(new(model.Print { value }))
}

fn printable(g: *Generator) -> model.Expr {
    let kind = pick_kind(g, true)
    let x = expr(g, kind, 2)
    if model.is_float(kind) {
        return clamp(g, x, model.Kind.I64)
    }
    x
}

fn let_stmt(g: *Generator) -> model.Stmt {
    let kind = pick_kind(g, true)
    let init = expr(g, kind, g.cfg.max_expr)
    let name = fresh(g, "v")
    let mutable = choice.boolean(g.src)
    push(mut g.vars, Variable { name, kind, mutable })
    model.Stmt.Let(new(model.Let { name, kind, mutable, init }))
}

fn assign(g: *Generator) -> model.Stmt {
    let target = choice.pick(g.src, mutable_vars(g))
    let op = assign_op(g, target.kind)
    let value = operand(g, op, target.kind, g.cfg.max_expr)
    model.Stmt.Assign(new(model.Assign { name: target.name, kind: target.kind, op, value }))
}

fn assign_op(g: *Generator, kind: model.Kind) -> model.Op {
    if kind == model.Kind.Bool {
        return model.Op.Set
    }
    if model.is_float(kind) {
        return choice.pick(g.src, [model.Op.Set, model.Op.Add, model.Op.Sub, model.Op.Mul, model.Op.Div])
    }
    choice.pick(g.src, [
        model.Op.Set
        model.Op.Add
        model.Op.Sub
        model.Op.Mul
        model.Op.Div
        model.Op.Rem
        model.Op.And
        model.Op.Or
        model.Op.Xor
        model.Op.Shl
        model.Op.Shr
    ])
}

fn operand(g: *Generator, op: model.Op, kind: model.Kind, depth: i64) -> model.Expr {
    if op == model.Op.Div || op == model.Op.Rem {
        return divisor(g, kind, depth)
    }
    if model.is_shift(op) {
        return shift_count(g, depth)
    }
    expr(g, kind, depth)
}

fn if_stmt(g: *Generator, nest: i64) -> model.Stmt {
    let cond = expr(g, model.Kind.Bool, 3)
    let then_count = choice.range(g.src, 1, 3)
    let then = block(g, nest + 1, then_count)
    var otherwise: []model.Stmt = []
    if choice.boolean(g.src) {
        let else_count = choice.range(g.src, 1, 3)
        otherwise = block(g, nest + 1, else_count)
    }
    model.Stmt.IfStmt(new(model.IfStmt { cond, then, otherwise }))
}

fn bound(g: *Generator, kind: model.Kind) -> model.Expr {
    if choice.boolean(g.src) {
        let limit = u64(choice.intn(g.src, 8))
        return lit_expr(kind, limit)
    }
    let l = expr(g, kind, 2)
    let r = lit_expr(kind, 7)
    binary_expr(model.Op.And, l, r)
}

fn loop_id(g: *Generator) -> i64 {
    g.loop_ids += 1
    g.loop_ids
}

fn range_stmt(g: *Generator, nest: i64) -> model.Stmt {
    let kind = pick_int(g)
    let id = loop_id(g)
    let variable = fresh(g, "i")
    let lo = bound(g, kind)
    let hi = bound(g, kind)
    let saved = g.vars.len
    push(mut g.vars, Variable { name: variable, kind, mutable: false })
    push(mut g.loops, id)
    let body_count = choice.range(g.src, 1, 4)
    let body = block(g, nest + 1, body_count)
    truncate(mut g.loops, g.loops.len - 1)
    truncate(mut g.vars, saved)
    model.Stmt.Range(new(model.Range { id, variable, kind, lo, hi, body }))
}

fn while_stmt(g: *Generator, nest: i64) -> model.Stmt {
    let id = loop_id(g)
    let counter = fresh(g, "w")
    let limit = choice.range(g.src, 1, 6)
    var cond: model.Expr? = none
    if choice.chance(g.src, 60) {
        cond = expr(g, model.Kind.Bool, 2)
    }
    push(mut g.loops, id)
    let body_count = choice.range(g.src, 1, 4)
    let body = block(g, nest + 1, body_count)
    truncate(mut g.loops, g.loops.len - 1)
    model.Stmt.While(new(model.While { id, counter, bound: limit, cond, body }))
}

fn jump(g: *Generator) -> model.Stmt {
    var target = g.loops[g.loops.len - 1]
    if choice.chance(g.src, 35) {
        target = choice.pick(g.src, g.loops)
    }
    let cond = expr(g, model.Kind.Bool, 2)
    let is_continue = choice.boolean(g.src)
    let leave = model.Stmt.Jump(new(model.Jump { target, is_continue }))
    model.Stmt.IfStmt(new(model.IfStmt { cond, then: [leave] }))
}
