import fuzz/choice
import fuzz/model
import std/text

fn int_ops() -> []model.Op {
    [model.Op.Add, model.Op.Sub, model.Op.Mul, model.Op.And, model.Op.Or, model.Op.Xor]
}

fn float_ops() -> []model.Op {
    [model.Op.Add, model.Op.Sub, model.Op.Mul, model.Op.Div]
}

fn compare_ops() -> []model.Op {
    [model.Op.Eq, model.Op.Ne, model.Op.Lt, model.Op.Le, model.Op.Gt, model.Op.Ge]
}

fn float_values() -> []f64 {
    [0.0, 0.5, 1.0, 1.5, 2.0, 3.0, 10.0, 0.1, 0.3, 100.25, 1000.0, 65536.0, 12345.678, 1e9, 1e-6, 16777217.0]
}

fn expr(g: *Generator, kind: model.Kind, depth: i64) -> model.Expr {
    if depth <= 0 || choice.chance(g.src, 15) {
        return leaf(g, kind)
    }
    if kind == model.Kind.Bool {
        return bool_expr(g, depth)
    }
    if model.is_float(kind) {
        return float_expr(g, kind, depth)
    }
    int_expr(g, kind, depth)
}

fn leaf(g: *Generator, kind: model.Kind) -> model.Expr {
    let candidates = vars_of(g, kind, false)
    if candidates.len > 0 && choice.chance(g.src, 65) {
        let v = choice.pick(g.src, candidates)
        return model.Expr.Var(new(model.Var { name: v.name, kind: v.kind }))
    }
    literal(g, kind)
}

fn literal(g: *Generator, kind: model.Kind) -> model.Expr {
    if kind == model.Kind.Bool {
        let bit = u64(choice.intn(g.src, 2))
        return lit_expr(model.Kind.Bool, bit)
    }
    if model.is_float(kind) {
        return float_lit(g, kind)
    }
    int_lit(g, kind)
}

fn float_lit(g: *Generator, kind: model.Kind) -> model.Expr {
    var v = choice.pick(g.src, float_values())
    if choice.chance(g.src, 30) {
        v = -v
    }
    if v == 0.0 && choice.chance(g.src, 30) {
        v = text.float_from_bits(0x8000000000000000)
    }
    if kind == model.Kind.F32 {
        v = f64(f32(v))
    }
    model.Expr.Lit(new(model.Lit { kind, float: v }))
}

fn boundaries(kind: model.Kind) -> []u64 {
    let mask = model.mask(kind)
    let half = mask >> 1
    let alternating: u64 = 0x5555555555555555
    let inverse: u64 = 0xAAAAAAAAAAAAAAAA
    [0, 1, 2, mask, mask - 1, half, half + 1, half - 1, alternating & mask, inverse & mask]
}

fn int_lit(g: *Generator, kind: model.Kind) -> model.Expr {
    var bits: u64 = 0
    let n = choice.intn(g.src, 10)
    if n < 4 {
        bits = u64(choice.intn(g.src, 12))
        if model.signed(kind) && choice.chance(g.src, 30) {
            bits = -bits
        }
    } else if n < 7 {
        bits = choice.pick(g.src, boundaries(kind))
    } else {
        bits = choice.uint64(g.src)
    }
    let wrapped = model.wrap(kind, bits)
    lit_expr(kind, wrapped)
}

fn int_expr(g: *Generator, kind: model.Kind, depth: i64) -> model.Expr {
    let n = choice.intn(g.src, 20)
    if n < 8 {
        let op = choice.pick(g.src, int_ops())
        let l = expr(g, kind, depth - 1)
        let r = expr(g, kind, depth - 1)
        return binary_expr(op, l, r)
    }
    if n < 10 {
        let op = choice.pick(g.src, [model.Op.Div, model.Op.Rem])
        let l = expr(g, kind, depth - 1)
        let r = divisor(g, kind, depth - 1)
        return binary_expr(op, l, r)
    }
    if n < 13 {
        let op = choice.pick(g.src, [model.Op.Shl, model.Op.Shr])
        let l = expr(g, kind, depth - 1)
        let r = shift_count(g, depth - 1)
        return binary_expr(op, l, r)
    }
    if n < 14 {
        let x = expr(g, kind, depth - 1)
        return unary_expr(model.Op.Neg, x)
    }
    if n < 15 {
        let x = expr(g, kind, depth - 1)
        return unary_expr(model.Op.Compl, x)
    }
    if n < 17 {
        return convert(g, kind, depth - 1)
    }
    if n < 18 {
        return if_expr(g, kind, depth - 1)
    }
    call_or(g, kind, depth - 1)
}

fn float_expr(g: *Generator, kind: model.Kind, depth: i64) -> model.Expr {
    let n = choice.intn(g.src, 14)
    if n < 6 {
        let op = choice.pick(g.src, float_ops())
        let l = expr(g, kind, depth - 1)
        let r = expr(g, kind, depth - 1)
        return binary_expr(op, l, r)
    }
    if n < 7 {
        let x = expr(g, kind, depth - 1)
        return unary_expr(model.Op.Neg, x)
    }
    if n < 9 {
        let op = choice.pick(g.src, [model.MathOp.Sqrt, model.MathOp.Floor])
        let x = expr(g, kind, depth - 1)
        return model.Expr.Math(new(model.Math { op, x }))
    }
    if n < 11 {
        return convert(g, kind, depth - 1)
    }
    if n < 12 {
        return if_expr(g, kind, depth - 1)
    }
    call_or(g, kind, depth - 1)
}

fn bool_expr(g: *Generator, depth: i64) -> model.Expr {
    let n = choice.intn(g.src, 10)
    if n < 5 {
        let kind = pick_numeric(g)
        let op = choice.pick(g.src, compare_ops())
        let l = expr(g, kind, depth - 1)
        let r = expr(g, kind, depth - 1)
        return binary_expr(op, l, r)
    }
    if n < 7 {
        let op = choice.pick(g.src, [model.Op.LogAnd, model.Op.LogOr])
        let l = expr(g, model.Kind.Bool, depth - 1)
        let r = expr(g, model.Kind.Bool, depth - 1)
        return binary_expr(op, l, r)
    }
    if n < 8 {
        let x = expr(g, model.Kind.Bool, depth - 1)
        return unary_expr(model.Op.Not, x)
    }
    if n < 9 {
        return if_expr(g, model.Kind.Bool, depth - 1)
    }
    call_or(g, model.Kind.Bool, depth - 1)
}

fn if_expr(g: *Generator, kind: model.Kind, depth: i64) -> model.Expr {
    let cond = expr(g, model.Kind.Bool, depth)
    let then = expr(g, kind, depth)
    let otherwise = expr(g, kind, depth)
    conditional(cond, then, otherwise)
}

fn call_or(g: *Generator, kind: model.Kind, depth: i64) -> model.Expr {
    var callees: []*model.Func = []
    for f in g.funcs {
        if f.result == kind {
            push(mut callees, f)
        }
    }
    if callees.len == 0 || choice.chance(g.src, 40) {
        return leaf(g, kind)
    }
    let f = choice.pick(g.src, callees)
    var args: []model.Expr = []
    for p in f.params {
        push(mut args, expr(g, p.kind, depth))
    }
    model.Expr.Call(new(model.Call { callee: f.name, result: kind, args }))
}

fn divisor(g: *Generator, kind: model.Kind, depth: i64) -> model.Expr {
    let raw = expr(g, kind, depth)
    if model.is_float(kind) || (g.cfg.panics && choice.chance(g.src, 15)) {
        return raw
    }
    let one = lit_expr(kind, 1)
    binary_expr(model.Op.Or, raw, one)
}

fn shift_count(g: *Generator, depth: i64) -> model.Expr {
    let kind = pick_int(g)
    if choice.boolean(g.src) {
        let count = choice.intn(g.src, model.bits(kind) + 3)
        let wrapped = model.wrap(kind, u64(count))
        return lit_expr(kind, wrapped)
    }
    expr(g, kind, depth)
}

fn convert(g: *Generator, to: model.Kind, depth: i64) -> model.Expr {
    let from = pick_numeric(g)
    let x = expr(g, from, depth)
    if model.is_float(from) && model.is_int(to) {
        return clamp(g, x, to)
    }
    convert_expr(to, x)
}

fn clamp(g: *Generator, x: model.Expr, to: model.Kind) -> model.Expr {
    let from = model.expr_type(x)
    let name = "clamp_{model.kind_name(from)}_{model.kind_name(to)}"
    if g.helpers[name] == none {
        g.helpers[name] = clamp_helper(name, from, to)
    }
    model.Expr.Call(new(model.Call { callee: name, result: to, args: [x] }))
}

fn clamp_helper(name: str, from: model.Kind, to: model.Kind) -> *model.Func {
    var limit = model.exp2(model.bits(to))
    var low = -1.0
    if model.signed(to) {
        limit = model.exp2(model.bits(to) - 1)
        low = -limit
    }
    let x = model.Expr.Var(new(model.Var { name: "x", kind: from }))
    let low_bound = float_bound(from, low)
    let high_bound = float_bound(from, limit)
    let above = binary_expr(model.Op.Gt, x, low_bound)
    let below = binary_expr(model.Op.Lt, x, high_bound)
    let in_range = binary_expr(model.Op.LogAnd, above, below)
    let converted = convert_expr(to, x)
    let fallback = lit_expr(to, 0)
    let tail = conditional(in_range, converted, fallback)
    let param = model.Param { name: "x", kind: from }
    new(model.Func { name, params: [param], result: to, body: [], tail })
}

fn float_bound(kind: model.Kind, v: f64) -> model.Expr {
    var bound = v
    if kind == model.Kind.F32 {
        bound = f64(f32(v))
    }
    model.Expr.Lit(new(model.Lit { kind, float: bound }))
}
