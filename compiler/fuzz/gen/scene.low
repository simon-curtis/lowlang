import fuzz/choice
import fuzz/model
import std/math
import std/slices

fn quiet_functions(g: *Generator) {
    g.quiet = true
    let count = choice.range(g.src, 0, 2)
    for i in 0..count {
        let name = "q{i}"
        function(g, name, 2)
        g.quiet_funcs[name] = true
    }
    g.quiet = false
}

fn add_stages(g: *Generator, mut main: []model.Stmt) {
    let count = choice.range(g.src, 1, g.cfg.max_stages)
    for _ in 0..count {
        let at = choice.range(g.src, 0, main.len)
        let st = model.Stmt.Stage(stage(g))
        let head = slices.concat(main[..at], [st])
        main = slices.concat(head, main[at..])
    }
}

fn stage(g: *Generator) -> *model.Stage {
    let count = choice.range(g.src, 1, g.cfg.max_scenes)
    var scenes: []*model.Scene = []
    for _ in 0..count {
        push(mut scenes, scene(g))
    }
    new(model.Stage { scenes })
}

fn work_expr(g: *Generator) -> model.Expr {
    g.vars = [Variable { name: "x", kind: model.Kind.I64, mutable: false }]
    g.loops = []
    g.quiet = true
    let e = expr(g, model.Kind.I64, g.cfg.max_expr)
    g.quiet = false
    e
}

fn sized(g: *Generator, s: model.Span) -> i64 {
    let width = s.hi - s.lo
    if width <= 64 {
        return choice.range(g.src, s.lo, s.hi)
    }
    var limit = 1
    for limit < width && choice.chance(g.src, 80) {
        limit *= 4
    }
    s.lo + choice.intn(g.src, math.min(limit, width) + 1)
}

fn depth(g: *Generator, level: i64, threads: i64, hi: i64) -> i64 {
    let safe = model.stack_bytes / 2 / model.frame_ceiling(level) - threads - 1
    if choice.chance(g.src, 70) {
        return choice.range(g.src, 1, math.max(1, safe))
    }
    let most = model.stack_bytes / model.frame_floor(level) + 8
    math.min(hi, choice.range(g.src, math.max(1, safe), most))
}

fn scene(g: *Generator) -> *model.Scene {
    let kind = choice.pick(g.src, model.scene_kinds())
    let limits = model.scene_limits(kind)
    g.scene_ids += 1
    let work = work_expr(g)
    let threads = sized(g, limits.threads)
    let capacity = sized(g, limits.capacity)
    let delay = sized(g, limits.delay)
    var items = 0
    if kind == model.SceneKind.DeepStack {
        items = depth(g, capacity, threads, limits.items.hi)
    } else {
        items = sized(g, limits.items)
    }
    new(model.Scene { kind, id: g.scene_ids, work, threads, items, capacity, delay })
}
