import fuzz/choice
import fuzz/model
import std/maps

pub struct Config {
    pub funcs: i64
    pub max_expr: i64
    pub max_block: i64
    pub max_nest: i64
    pub panics: bool
}

pub fn default_config() -> Config {
    Config { funcs: 6, max_expr: 4, max_block: 6, max_nest: 3, panics: false }
}

struct Variable {
    name: str
    kind: model.Kind
    mutable: bool
}

struct Weight {
    kind: model.Kind
    weight: i64
}

struct Generator {
    src: *choice.Source
    cfg: Config
    funcs: []*model.Func
    helpers: [str: *model.Func]
    vars: []Variable
    loops: []i64
    names: i64
    loop_ids: i64
    result: model.Kind
}

pub fn generate(src: *choice.Source, cfg: Config) -> *model.Program {
    let g = new(Generator { src, cfg, funcs: [], helpers: [:], vars: [], loops: [], names: 0, loop_ids: 0, result: model.Kind.I64 })
    let count = choice.range(src, 1, cfg.funcs)
    for i in 0..count {
        function(g, i)
    }
    let main = main_block(g)
    var funcs: []*model.Func = []
    for name in maps.sorted_keys(g.helpers) {
        push(mut funcs, g.helpers[name] ?? panic("helper vanished"))
    }
    for f in g.funcs {
        push(mut funcs, f)
    }
    new(model.Program { funcs, main })
}

fn function(g: *Generator, index: i64) {
    g.vars = []
    g.loops = []
    g.result = pick_kind(g, true)
    let param_count = choice.range(g.src, 0, 4)
    var params: []model.Param = []
    for i in 0..param_count {
        let kind = pick_kind(g, true)
        let param = model.Param { name: "p{i}", kind }
        push(mut params, param)
        push(mut g.vars, Variable { name: param.name, kind: param.kind, mutable: false })
    }
    let body_count = choice.range(g.src, 1, g.cfg.max_block)
    let body = block(g, 0, body_count)
    let tail = expr(g, g.result, g.cfg.max_expr)
    let f = new(model.Func { name: "f{index}", params, result: g.result, body, tail })
    push(mut g.funcs, f)
}

fn main_block(g: *Generator) -> []model.Stmt {
    var stmts: []model.Stmt = []
    for f in g.funcs {
        let calls = choice.range(g.src, 1, 3)
        for _ in 0..calls {
            var args: []model.Expr = []
            for p in f.params {
                push(mut args, literal(g, p.kind))
            }
            let call = model.Expr.Call(new(model.Call { callee: f.name, result: f.result, args }))
            for s in observe(g, call) {
                push(mut stmts, s)
            }
        }
    }
    stmts
}

fn observe(g: *Generator, call: model.Expr) -> []model.Stmt {
    if !model.is_float(model.expr_type(call)) {
        return [model.Stmt.Print(new(model.Print { value: call }))]
    }
    let clamped = clamp(g, call, model.Kind.I64)
    let nan_check = binary_expr(model.Op.Ne, call, call)
    [model.Stmt.Print(new(model.Print { value: clamped })), model.Stmt.Print(new(model.Print { value: nan_check }))]
}

fn weights(with_bool: bool) -> []Weight {
    var out = [
        Weight { kind: model.Kind.I64, weight: 6 }
        Weight { kind: model.Kind.I32, weight: 4 }
        Weight { kind: model.Kind.U64, weight: 4 }
        Weight { kind: model.Kind.U32, weight: 4 }
        Weight { kind: model.Kind.U16, weight: 2 }
        Weight { kind: model.Kind.U8, weight: 4 }
        Weight { kind: model.Kind.F64, weight: 2 }
        Weight { kind: model.Kind.F32, weight: 2 }
    ]
    if with_bool {
        push(mut out, Weight { kind: model.Kind.Bool, weight: 2 })
    }
    out
}

fn pick_kind(g: *Generator, with_bool: bool) -> model.Kind {
    let table = weights(with_bool)
    var total = 0
    for w in table {
        total += w.weight
    }
    var n = choice.intn(g.src, total)
    for w in table {
        if n < w.weight {
            return w.kind
        }
        n -= w.weight
    }
    model.Kind.I64
}

fn pick_int(g: *Generator) -> model.Kind {
    choice.pick(g.src, model.int_kinds())
}

fn pick_numeric(g: *Generator) -> model.Kind {
    for {
        let k = pick_kind(g, false)
        if k != model.Kind.Bool {
            return k
        }
    }
    model.Kind.I64
}

fn fresh(g: *Generator, prefix: str) -> str {
    g.names += 1
    "{prefix}_{g.names}"
}

fn vars_of(g: *Generator, kind: model.Kind, mutable_only: bool) -> []Variable {
    var found: []Variable = []
    for v in g.vars {
        if v.kind == kind && (!mutable_only || v.mutable) {
            push(mut found, v)
        }
    }
    found
}

fn mutable_vars(g: *Generator) -> []Variable {
    var found: []Variable = []
    for v in g.vars {
        if v.mutable {
            push(mut found, v)
        }
    }
    found
}

fn lit_expr(kind: model.Kind, bits: u64) -> model.Expr {
    model.Expr.Lit(new(model.Lit { kind, bits }))
}

fn unary_expr(op: model.Op, x: model.Expr) -> model.Expr {
    model.Expr.Unary(new(model.Unary { op, x }))
}

fn binary_expr(op: model.Op, l: model.Expr, r: model.Expr) -> model.Expr {
    model.Expr.Binary(new(model.Binary { op, l, r }))
}

fn convert_expr(to: model.Kind, x: model.Expr) -> model.Expr {
    model.Expr.Convert(new(model.Convert { to, x }))
}

fn conditional(cond: model.Expr, then: model.Expr, otherwise: model.Expr) -> model.Expr {
    model.Expr.IfExpr(new(model.IfExpr { cond, then, otherwise }))
}
