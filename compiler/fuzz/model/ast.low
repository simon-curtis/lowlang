pub enum Op {
    Set = 0
    Add = 1
    Sub = 2
    Mul = 3
    Div = 4
    Rem = 5
    And = 6
    Or = 7
    Xor = 8
    Shl = 9
    Shr = 10
    Eq = 11
    Ne = 12
    Lt = 13
    Le = 14
    Gt = 15
    Ge = 16
    LogAnd = 17
    LogOr = 18
    Neg = 19
    Compl = 20
    Not = 21
}

pub fn symbol(o: Op) -> str {
    match o {
        Set => "="
        Add => "+"
        Sub => "-"
        Mul => "*"
        Div => "/"
        Rem => "%"
        And => "&"
        Or => "|"
        Xor => "^"
        Shl => "<<"
        Shr => ">>"
        Eq => "=="
        Ne => "!="
        Lt => "<"
        Le => "<="
        Gt => ">"
        Ge => ">="
        LogAnd => "&&"
        LogOr => "||"
        Neg => "-"
        Compl => "~"
        Not => "!"
    }
}

pub fn is_compare(o: Op) -> bool {
    o.index >= Op.Eq.index && o.index <= Op.Ge.index
}

pub fn is_shift(o: Op) -> bool {
    o == Op.Shl || o == Op.Shr
}

pub fn is_logical(o: Op) -> bool {
    o == Op.LogAnd || o == Op.LogOr
}

pub enum MathOp {
    Sqrt = 0
    Floor = 1
}

pub fn math_name(m: MathOp) -> str {
    match m {
        Sqrt => "sqrt"
        Floor => "floor"
    }
}

pub enum Expr {
    Lit(*Lit)
    Var(*Var)
    Unary(*Unary)
    Binary(*Binary)
    Convert(*Convert)
    IfExpr(*IfExpr)
    Call(*Call)
    Math(*Math)
}

pub struct Lit {
    pub kind: Kind
    pub bits: u64 = 0
    pub float: f64 = 0.0
}

pub struct Var {
    pub name: str
    pub kind: Kind
}

pub struct Unary {
    pub op: Op
    pub x: Expr
}

pub struct Binary {
    pub op: Op
    pub l: Expr
    pub r: Expr
}

pub struct Convert {
    pub to: Kind
    pub x: Expr
}

pub struct IfExpr {
    pub cond: Expr
    pub then: Expr
    pub otherwise: Expr
}

pub struct Call {
    pub callee: str
    pub result: Kind
    pub args: []Expr
}

pub struct Math {
    pub op: MathOp
    pub x: Expr
}

pub fn expr_type(e: Expr) -> Kind {
    match e {
        Lit(x) => x.kind
        Var(x) => x.kind
        Unary(x) => unary_type(x)
        Binary(x) => binary_type(x)
        Convert(x) => x.to
        IfExpr(x) => expr_type(x.then)
        Call(x) => x.result
        Math(x) => expr_type(x.x)
    }
}

fn unary_type(e: *Unary) -> Kind {
    if e.op == Op.Not {
        return Kind.Bool
    }
    expr_type(e.x)
}

fn binary_type(e: *Binary) -> Kind {
    if is_compare(e.op) || is_logical(e.op) {
        return Kind.Bool
    }
    expr_type(e.l)
}

pub enum Stmt {
    Let(*Let)
    Assign(*Assign)
    IfStmt(*IfStmt)
    Range(*Range)
    While(*While)
    Jump(*Jump)
    Return(*Return)
    Print(*Print)
}

pub struct Let {
    pub name: str
    pub kind: Kind
    pub mutable: bool
    pub init: Expr
}

pub struct Assign {
    pub name: str
    pub kind: Kind
    pub op: Op
    pub value: Expr
}

pub struct IfStmt {
    pub cond: Expr
    pub then: []Stmt
    pub otherwise: []Stmt = []
}

pub struct Range {
    pub id: i64
    pub variable: str
    pub kind: Kind
    pub lo: Expr
    pub hi: Expr
    pub body: []Stmt
}

pub struct While {
    pub id: i64
    pub counter: str
    pub bound: i64
    pub cond: Expr?
    pub body: []Stmt
}

pub struct Jump {
    pub target: i64
    pub is_continue: bool
}

pub struct Return {
    pub value: Expr
}

pub struct Print {
    pub value: Expr
}

pub struct Param {
    pub name: str
    pub kind: Kind
}

pub struct Func {
    pub name: str
    pub params: []Param
    pub result: Kind
    pub body: []Stmt
    pub tail: Expr
}

pub struct Program {
    pub funcs: []*Func
    pub main: []Stmt
}
