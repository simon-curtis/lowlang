pub enum Kind {
    I64 = 0
    I32 = 1
    U64 = 2
    U32 = 3
    U16 = 4
    U8 = 5
    F64 = 6
    F32 = 7
    Bool = 8
}

pub fn int_kinds() -> []Kind {
    [Kind.I64, Kind.I32, Kind.U64, Kind.U32, Kind.U16, Kind.U8]
}

pub fn kind_name(k: Kind) -> str {
    match k {
        I64 => "i64"
        I32 => "i32"
        U64 => "u64"
        U32 => "u32"
        U16 => "u16"
        U8 => "u8"
        F64 => "f64"
        F32 => "f32"
        Bool => "bool"
    }
}

pub fn bits(k: Kind) -> i64 {
    match k {
        I64 => 64
        I32 => 32
        U64 => 64
        U32 => 32
        U16 => 16
        U8 => 8
        F64 => 64
        F32 => 32
        Bool => 1
    }
}

pub fn is_int(k: Kind) -> bool {
    k.index <= Kind.U8.index
}

pub fn is_float(k: Kind) -> bool {
    k == Kind.F64 || k == Kind.F32
}

pub fn signed(k: Kind) -> bool {
    k == Kind.I64 || k == Kind.I32
}

pub fn mask(k: Kind) -> u64 {
    let width = bits(k)
    if width >= 64 {
        return ~u64(0)
    }
    (u64(1) << width) - 1
}

pub fn wrap(k: Kind, v: u64) -> u64 {
    v & mask(k)
}

pub fn extend(k: Kind, v: u64) -> i64 {
    let wrapped = wrap(k, v)
    let width = bits(k)
    if signed(k) && width < 64 && wrapped >> (width - 1) == 1 {
        return i64(wrapped | ~mask(k))
    }
    i64(wrapped)
}

pub fn min_signed(k: Kind) -> i64 {
    -1 << (bits(k) - 1)
}
