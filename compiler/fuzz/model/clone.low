pub fn clone_program(p: *Program) -> *Program {
    var funcs: []*Func = []
    for f in p.funcs {
        push(mut funcs, clone_func(f))
    }
    let main = clone_stmts(p.main)
    new(Program { funcs, main })
}

pub fn clone_func(f: *Func) -> *Func {
    let c = new(*f)
    c.params = clone_params(f.params)
    c.body = clone_stmts(f.body)
    c.tail = clone_expr(f.tail)
    c
}

fn clone_params(params: []Param) -> []Param {
    var out: []Param = []
    for p in params {
        push(mut out, p)
    }
    out
}

fn clone_stmts(stmts: []Stmt) -> []Stmt {
    var out: []Stmt = []
    for s in stmts {
        push(mut out, clone_stmt(s))
    }
    out
}

fn clone_stmt(s: Stmt) -> Stmt {
    match s {
        Let(n) => {
            let c = new(*n)
            c.init = clone_expr(n.init)
            Let(c)
        }
        Assign(n) => {
            let c = new(*n)
            c.value = clone_expr(n.value)
            Assign(c)
        }
        IfStmt(n) => {
            let cond = clone_expr(n.cond)
            let then = clone_stmts(n.then)
            let otherwise = clone_stmts(n.otherwise)
            IfStmt(new(IfStmt { cond, then, otherwise }))
        }
        Range(n) => {
            let c = new(*n)
            c.lo = clone_expr(n.lo)
            c.hi = clone_expr(n.hi)
            c.body = clone_stmts(n.body)
            Range(c)
        }
        While(n) => {
            let c = new(*n)
            c.cond = clone_optional_expr(n.cond)
            c.body = clone_stmts(n.body)
            While(c)
        }
        Jump(n) => Jump(new(*n))
        Return(n) => {
            let value = clone_expr(n.value)
            Return(new(Return { value }))
        }
        Print(n) => {
            let value = clone_expr(n.value)
            Print(new(Print { value }))
        }
    }
}

fn clone_optional_expr(e: Expr?) -> Expr? {
    match e {
        some(x) => clone_expr(x)
        none => none
    }
}

fn clone_expr(e: Expr) -> Expr {
    match e {
        Lit(n) => Lit(new(*n))
        Var(n) => Var(new(*n))
        Unary(n) => {
            let x = clone_expr(n.x)
            Unary(new(Unary { op: n.op, x }))
        }
        Binary(n) => {
            let l = clone_expr(n.l)
            let r = clone_expr(n.r)
            Binary(new(Binary { op: n.op, l, r }))
        }
        Convert(n) => {
            let x = clone_expr(n.x)
            Convert(new(Convert { to: n.to, x }))
        }
        IfExpr(n) => {
            let cond = clone_expr(n.cond)
            let then = clone_expr(n.then)
            let otherwise = clone_expr(n.otherwise)
            IfExpr(new(IfExpr { cond, then, otherwise }))
        }
        Call(n) => {
            let args = clone_args(n.args)
            Call(new(Call { callee: n.callee, result: n.result, args }))
        }
        Math(n) => {
            let x = clone_expr(n.x)
            Math(new(Math { op: n.op, x }))
        }
    }
}

fn clone_args(args: []Expr) -> []Expr {
    var out: []Expr = []
    for a in args {
        push(mut out, clone_expr(a))
    }
    out
}
