import std/maps
import std/slices
import std/text

fn scene_imports(k: SceneKind) -> []str {
    match k {
        SelectReady => ["std/sync"]
        Cancel => ["std/atomic", "std/cancel", "std/sync"]
        Churn => ["std/atomic", "std/sync"]
        PipeIO => ["std/sys"]
        Mutex => ["std/sync"]
        Sleepers => ["std/atomic", "std/sync"]
        Pinned => ["std/sync"]
        _ => []
    }
}

fn templates() -> [str: str] {
    var out: [str: str] = [:]
    var name = ""
    var body: []str = []
    for line in text.split(embed("scenes.txt"), 10) {
        if !text.starts_with(line, "== ") {
            push(mut body, line)
            continue
        }
        if name != "" {
            out[name] = text.join(body, "\n")
        }
        name = line[3..]
        body = []
    }
    out[name] = text.trim(text.join(body, "\n"))
    out
}

/// Returns every stage in `stmts`, in program order.
pub fn stages_in(stmts: []Stmt) -> []*Stage {
    var out: []*Stage = []
    collect_stages(stmts, mut out)
    out
}

fn collect_stages(stmts: []Stmt, mut out: []*Stage) {
    for s in stmts {
        match s {
            Stage(n) => push(mut out, n)
            IfStmt(n) => {
                collect_stages(n.then, mut out)
                collect_stages(n.otherwise, mut out)
            }
            Range(n) => collect_stages(n.body, mut out)
            While(n) => collect_stages(n.body, mut out)
            _ => {}
        }
    }
}

fn print_imports(pr: *Printer, stages: []*Stage) {
    var wanted: [str: bool] = [:]
    for st in stages {
        for s in st.scenes {
            for path in scene_imports(s.kind) {
                wanted[path] = true
            }
        }
    }
    for path in maps.sorted_keys(wanted) {
        pr.out.write("import {path}\n")
    }
    if wanted.len > 0 {
        pr.out.write("\n")
    }
}

fn pad_name(level: i64) -> str {
    match level {
        0 => "Pad8"
        1 => "Pad64"
        2 => "Pad512"
        _ => "Pad4096"
    }
}

fn pad_path(level: i64, field: str) -> str {
    text.repeat(".{field}", level + 1)
}

fn scene_text(template: str, s: *Scene) -> str {
    var out = text.replace(template, "@S", "s{s.id}")
    out = text.replace(out, "@U", "S{s.id}")
    out = text.replace(out, "@T", "{s.threads}")
    out = text.replace(out, "@N", "{s.items}")
    out = text.replace(out, "@C", "{s.capacity}")
    out = text.replace(out, "@D", "{s.delay}")
    if s.kind != SceneKind.DeepStack {
        return out
    }
    out = text.replace(out, "@P", pad_name(s.capacity))
    out = text.replace(out, "@F", pad_path(s.capacity, "a"))
    text.replace(out, "@L", pad_path(s.capacity, "h"))
}

fn print_scenes(pr: *Printer, stages: []*Stage) {
    if stages.len == 0 {
        return
    }
    let sections = templates()
    var shared = false
    var padded = false
    for st in stages {
        shared = shared || st.scenes.len > 1
        padded = padded || st.scenes.any(fn(s) s.kind == SceneKind.DeepStack)
    }
    if shared {
        pr.out.write("{sections["run"] ?? ""}\n\n")
    }
    if padded {
        pr.out.write("{sections["pads"] ?? ""}\n\n")
    }
    for st in stages {
        for s in st.scenes {
            print_scene(pr, sections[scene_name(s.kind)] ?? "", s)
        }
    }
}

fn print_scene(pr: *Printer, template: str, s: *Scene) {
    pr.out.write("fn s{s.id}_work(x: i64) -> i64 {{\n    ")
    print_expr(pr, s.work, some(Kind.I64))
    pr.out.write("\n}}\n\n{scene_text(template, s)}\n\n")
}

fn print_stage(pr: *Printer, st: *Stage) {
    if st.scenes.len == 1 {
        pr.out.write("print(s{st.scenes[0].id}())\n")
        return
    }
    for i, s in st.scenes {
        if i > 0 {
            indent(pr)
        }
        pr.out.write("let s{s.id}_out = chan[i64](1)\n")
        indent(pr)
        pr.out.write("spawn scene_run(s{s.id}, s{s.id}_out)\n")
    }
    for s in st.scenes {
        indent(pr)
        pr.out.write("print((<-s{s.id}_out) ?? 0)\n")
    }
}
