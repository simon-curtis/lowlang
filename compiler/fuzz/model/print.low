import std/builder
import std/text

struct Printer {
    out: builder.Builder
    depth: i64
    result: Kind
    labelled: [i64: bool]
    loops: []i64
}

struct Wants {
    left: Kind?
    right: Kind?
}

pub fn to_string(p: *Program) -> str {
    let out = builder.builder()
    let pr = new(Printer { out, depth: 0, result: Kind.I64, labelled: [:], loops: [] })
    for f in p.funcs {
        print_function(pr, f)
        pr.out.write("\n")
    }
    pr.out.write("fn main() {{\n")
    pr.depth = 1
    print_block(pr, p.main)
    pr.out.write("}}\n")
    pr.out.to_str()
}

fn print_function(pr: *Printer, f: *Func) {
    pr.labelled = [:]
    find_labels(pr, f.body)
    pr.result = f.result
    var params: []str = []
    for param in f.params {
        push(mut params, "{param.name}: {kind_name(param.kind)}")
    }
    let joined = text.join(params, ", ")
    pr.out.write("fn {f.name}({joined}) -> {kind_name(f.result)} {{\n")
    pr.depth = 1
    print_block(pr, f.body)
    indent(pr)
    print_expr(pr, f.tail, some(f.result))
    pr.out.write("\n}}\n")
    pr.depth = 0
}

fn find_labels(pr: *Printer, stmts: []Stmt) {
    for s in stmts {
        match s {
            IfStmt(n) => {
                find_labels(pr, n.then)
                find_labels(pr, n.otherwise)
            }
            Range(n) => find_loop_labels(pr, n.id, n.body)
            While(n) => find_loop_labels(pr, n.id, n.body)
            Jump(n) => {
                if pr.loops.len > 0 && n.target != pr.loops[pr.loops.len - 1] {
                    pr.labelled[n.target] = true
                }
            }
            _ => {}
        }
    }
}

fn find_loop_labels(pr: *Printer, id: i64, body: []Stmt) {
    push(mut pr.loops, id)
    find_labels(pr, body)
    truncate(mut pr.loops, pr.loops.len - 1)
}

fn indent(pr: *Printer) {
    for _ in 0..pr.depth {
        pr.out.write("    ")
    }
}

fn print_block(pr: *Printer, stmts: []Stmt) {
    for s in stmts {
        print_stmt(pr, s)
    }
}

fn nested(pr: *Printer, stmts: []Stmt) {
    pr.depth += 1
    print_block(pr, stmts)
    pr.depth -= 1
}

fn label(pr: *Printer, id: i64) {
    if pr.labelled[id] ?? false {
        pr.out.write("L{id}: ")
    }
}

fn print_stmt(pr: *Printer, s: Stmt) {
    indent(pr)
    match s {
        Let(n) => {
            let keyword = if n.mutable { "var" } else { "let" }
            pr.out.write("{keyword} {n.name}: {kind_name(n.kind)} = ")
            print_expr(pr, n.init, some(n.kind))
            pr.out.write("\n")
        }
        Assign(n) => {
            var want: Kind? = some(n.kind)
            if is_shift(n.op) {
                want = none
            }
            var sym = symbol(n.op)
            if n.op != Op.Set {
                sym = "{sym}="
            }
            pr.out.write("{n.name} {sym} ")
            print_expr(pr, n.value, want)
            pr.out.write("\n")
        }
        IfStmt(n) => print_if(pr, n)
        Range(n) => {
            label(pr, n.id)
            pr.out.write("for {n.variable} in (")
            print_expr(pr, n.lo, none)
            pr.out.write(")..(")
            print_expr(pr, n.hi, none)
            pr.out.write(") {{\n")
            loop_body(pr, n.id, n.body)
        }
        While(n) => print_while(pr, n)
        Jump(n) => {
            let word = if n.is_continue { "continue" } else { "break" }
            pr.out.write(word)
            if pr.loops.len == 0 || pr.loops[pr.loops.len - 1] != n.target {
                pr.out.write(" L{n.target}")
            }
            pr.out.write("\n")
        }
        Return(n) => {
            pr.out.write("return ")
            print_expr(pr, n.value, some(pr.result))
            pr.out.write("\n")
        }
        Print(n) => {
            pr.out.write("print(")
            print_expr(pr, n.value, none)
            pr.out.write(")\n")
        }
    }
}

fn print_if(pr: *Printer, s: *IfStmt) {
    pr.out.write("if ")
    print_expr(pr, s.cond, none)
    pr.out.write(" {{\n")
    nested(pr, s.then)
    indent(pr)
    if s.otherwise.len == 0 {
        pr.out.write("}}\n")
        return
    }
    pr.out.write("}} else {{\n")
    nested(pr, s.otherwise)
    indent(pr)
    pr.out.write("}}\n")
}

fn print_while(pr: *Printer, s: *While) {
    pr.out.write("var {s.counter}: i64 = 0\n")
    indent(pr)
    label(pr, s.id)
    pr.out.write("for {s.counter} < {s.bound}")
    match s.cond {
        some(c) => {
            pr.out.write(" && ")
            print_expr(pr, c, none)
        }
        none => {}
    }
    pr.out.write(" {{\n")
    pr.depth += 1
    indent(pr)
    pr.out.write("{s.counter} += 1\n")
    pr.depth -= 1
    loop_body(pr, s.id, s.body)
}

fn loop_body(pr: *Printer, id: i64, body: []Stmt) {
    push(mut pr.loops, id)
    nested(pr, body)
    truncate(mut pr.loops, pr.loops.len - 1)
    indent(pr)
    pr.out.write("}}\n")
}

fn is_lit(e: Expr) -> bool {
    match e {
        Lit(_) => true
        _ => false
    }
}

fn sibling_wants(kind: Kind, l: Expr, r: Expr) -> Wants {
    if is_lit(l) && !is_lit(r) {
        return Wants { left: some(kind), right: none }
    }
    if is_lit(r) && !is_lit(l) {
        return Wants { left: none, right: some(kind) }
    }
    Wants { left: none, right: none }
}

fn print_expr(pr: *Printer, e: Expr, want: Kind?) {
    match e {
        Lit(n) => print_lit(pr, n, want)
        Var(n) => pr.out.write(n.name)
        Unary(n) => {
            pr.out.write("({symbol(n.op)}")
            print_expr(pr, n.x, none)
            pr.out.write(")")
        }
        Binary(n) => print_binary(pr, n)
        Convert(n) => {
            pr.out.write("{kind_name(n.to)}(")
            print_expr(pr, n.x, none)
            pr.out.write(")")
        }
        IfExpr(n) => {
            pr.out.write("(if ")
            print_expr(pr, n.cond, none)
            pr.out.write(" {{ ")
            print_expr(pr, n.then, none)
            pr.out.write(" }} else {{ ")
            print_expr(pr, n.otherwise, none)
            pr.out.write(" }})")
        }
        Call(n) => print_call(pr, n)
        Math(n) => {
            pr.out.write("{math_name(n.op)}(")
            print_expr(pr, n.x, none)
            pr.out.write(")")
        }
    }
}

fn print_call(pr: *Printer, e: *Call) {
    pr.out.write(e.callee)
    pr.out.write("(")
    for i, a in e.args {
        if i > 0 {
            pr.out.write(", ")
        }
        print_expr(pr, a, some(expr_type(a)))
    }
    pr.out.write(")")
}

fn print_binary(pr: *Printer, e: *Binary) {
    var left_want: Kind? = none
    var right_want: Kind? = none
    if !is_logical(e.op) && !is_shift(e.op) {
        let wants = sibling_wants(expr_type(e.l), e.l, e.r)
        left_want = wants.left
        right_want = wants.right
    }
    pr.out.write("(")
    print_expr(pr, e.l, left_want)
    pr.out.write(" {symbol(e.op)} ")
    print_expr(pr, e.r, right_want)
    pr.out.write(")")
}

fn print_lit(pr: *Printer, e: *Lit, want: Kind?) {
    if e.kind == Kind.Bool {
        pr.out.write(if e.bits != 0 { "true" } else { "false" })
    } else if is_float(e.kind) {
        float_lit(pr, e, want)
    } else {
        int_lit(pr, e, want)
    }
}

fn bare(kind: Kind, want: Kind?) -> bool {
    match want {
        some(w) => w == kind
        none => kind == Kind.I64 || kind == Kind.F64
    }
}

fn negative_float(v: f64) -> bool {
    text.float_bits(v) >> 63 == 1
}

fn plain_decimal(v: f64) -> str {
    let shortest = "{v}"
    let at = text.index_byte(shortest, 'e')
    if at < 0 {
        return shortest
    }
    let mantissa = shortest[..at]
    let signed_exponent = text.trim_prefix(shortest[at + 1..], "+")
    let exponent = text.parse_int(signed_exponent) or 0
    let dot = text.index_byte(mantissa, '.')
    var digits = mantissa
    var point = mantissa.len
    if dot >= 0 {
        digits = "{mantissa[..dot]}{mantissa[dot + 1..]}"
        point = dot
    }
    point += exponent
    if point <= 0 {
        let zeros = text.repeat("0", -point)
        return "0.{zeros}{digits}"
    }
    if point >= digits.len {
        let zeros = text.repeat("0", point - digits.len)
        return "{digits}{zeros}"
    }
    "{digits[..point]}.{digits[point..]}"
}

fn float_lit(pr: *Printer, e: *Lit, want: Kind?) {
    let negative = negative_float(e.float)
    let magnitude = if negative { -e.float } else { e.float }
    var digits = plain_decimal(magnitude)
    if !text.contains(digits, ".") {
        digits = "{digits}.0"
    }
    if negative {
        digits = "(-{digits})"
    }
    if bare(e.kind, want) {
        pr.out.write(digits)
        return
    }
    pr.out.write("{kind_name(e.kind)}({digits})")
}

fn int_lit(pr: *Printer, e: *Lit, want: Kind?) {
    if bare(e.kind, want) && !composite_minimum(e) {
        pr.out.write(int_text(e.kind, e.bits, true))
    } else if e.kind == Kind.U64 && e.bits > 9223372036854775807 {
        pr.out.write("(~u64({~e.bits}))")
    } else {
        pr.out.write("{kind_name(e.kind)}({int_text(e.kind, e.bits, false)})")
    }
}

fn composite_minimum(e: *Lit) -> bool {
    e.kind != Kind.I64 && signed(e.kind) && extend(e.kind, e.bits) == min_signed(e.kind)
}

fn int_text(kind: Kind, bits: u64, bare_context: bool) -> str {
    if !signed(kind) {
        return "{wrap(kind, bits)}"
    }
    let v = extend(kind, bits)
    var minimum = min_signed(Kind.I64)
    if bare_context {
        minimum = min_signed(kind)
    }
    if v >= 0 {
        return "{v}"
    }
    if v == minimum {
        return "(-{-(v + 1)} - 1)"
    }
    "(-{-v})"
}
