import std/builder

pub struct Lines {
    out: builder.Builder
}

pub fn lines() -> Lines {
    Lines { out: builder.builder() }
}

pub fn line(mut l: Lines, text: str) {
    builder.write(mut l.out, text)
    builder.write_byte(mut l.out, '\n')
}

pub fn string(l: Lines) -> str {
    builder.to_str(l.out)
}
