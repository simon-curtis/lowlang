import std/builder
import std/flag
import std/slices

pub struct Flag {
    pub name: str
    pub kind: str
    pub help: str
    pub default_text: str = ""
}

fn flag_name(f: Flag) -> str {
    f.name
}

pub fn flags_of(specs: []flag.Spec) -> []Flag {
    var flags: []Flag = []
    for s in specs {
        push(mut flags, Flag { name: s.name, kind: "string", help: s.help })
    }
    flags
}

pub fn flag_failure(program: str, specs: []flag.Spec, e: flag.Error) -> str {
    typed_flag_failure(program, flags_of(specs), e)
}

pub fn typed_flag_failure(program: str, flags: []Flag, e: flag.Error) -> str {
    let reason = match e {
        Unknown(name) => "flag provided but not defined: -{name}"
        Missing(name) => "flag needs an argument: -{name}"
        Invalid(name, value) => "invalid value \"{value}\" for flag -{name}: parse error"
    }
    "{reason}\n{flag_usage(program, flags)}"
}

fn flag_usage(program: str, flags: []Flag) -> str {
    var out = builder.builder()
    builder.write(mut out, "Usage of {program}:")
    var ordered = flags
    slices.sort_by_key(mut ordered, flag_name)
    for f in ordered {
        let suffix = if f.default_text == "" { "" } else { " (default {f.default_text})" }
        builder.write(mut out, "\n  -{f.name} {f.kind}\n    \t{f.help}{suffix}")
    }
    builder.to_str(out)
}
