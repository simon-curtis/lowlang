import std/builder
import std/text
import std/xml

pub fn xml_message(e: xml.Error) -> str {
    match e {
        Malformed(line, column, message) => "XML syntax error on line {line}: {message}"
        Limit(line, column, message) => "XML syntax error on line {line}: {message}"
        Unsupported(message) => message
    }
}

pub fn attribute_text(e: *xml.Element, name: str) -> str {
    xml.attribute(e, name) ?? ""
}

pub fn inner_xml(e: *xml.Element) -> str {
    var out = builder.builder()
    for n in e.children {
        match n {
            Element(c) => builder.write(mut out, xml.serialize(c, false))
            Text(v) => builder.write(mut out, escape(v))
            CData(v) => builder.write(mut out, "<![CDATA[{v}]]>")
            Comment(v) => builder.write(mut out, "<!--{v}-->")
            Instruction(target, data) => builder.write(mut out, "<?{target} {data}?>")
        }
    }
    builder.to_str(out)
}

fn escape(s: str) -> str {
    let amp = text.replace(s, "&", "&amp;")
    let lt = text.replace(amp, "<", "&lt;")
    text.replace(lt, ">", "&gt;")
}
