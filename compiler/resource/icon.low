import std/io

const icon_header_size = 6
const icon_entry_size = 16
const icon_type = 1
const icon_largest = 256
const dib_header_size = 40
const png_signature_low = 0x474e5089
const png_signature_high = 0x0a1a0a0d
const png_header_size = 26

struct IconImage {
    width: i64
    height: i64
    colors: i64
    planes: i64
    bits: i64
    data: []u8
}

fn icon_images(file: []u8) -> []IconImage ! Error {
    if file.len < icon_header_size {
        fail Icon("the file is shorter than an icon header")
    }
    if io.le16(file, 0) != 0 || io.le16(file, 2) != icon_type {
        fail Icon("the file is not an .ico file")
    }
    let count = io.le16(file, 4)
    if count == 0 {
        fail Icon("the file holds no images")
    }
    if file.len < icon_header_size + count * icon_entry_size {
        fail Icon("the directory is cut short")
    }
    var images: []IconImage = []
    for i in 0..count {
        images.push(icon_image(file, i)?)
    }
    images
}

fn icon_image(file: []u8, index: i64) -> IconImage ! Error {
    let at = icon_header_size + index * icon_entry_size
    let size = io.le32(file, at + 8)
    let offset = io.le32(file, at + 12)
    if size == 0 || offset + size > file.len {
        fail Icon("image {index + 1} lies outside the file")
    }
    let data = file[offset..offset + size]
    let colors = i64(file[at + 2])
    if is_png(data) {
        return png_image(data, colors, index)?
    }
    dib_image(data, colors, index)?
}

fn is_png(data: []u8) -> bool {
    data.len >= 8 && io.le32(data, 0) == png_signature_low && io.le32(data, 4) == png_signature_high
}

fn png_channels(color_type: i64) -> i64 {
    match color_type {
        0 => 1
        2 => 3
        3 => 1
        4 => 2
        6 => 4
        _ => 0
    }
}

fn png_image(data: []u8, colors: i64, index: i64) -> IconImage ! Error {
    if data.len < png_header_size {
        fail Icon("image {index + 1} is a PNG without a header")
    }
    let width = io.be32(data, 16)
    let height = io.be32(data, 20)
    let channels = png_channels(i64(data[25]))
    if channels == 0 {
        fail Icon("image {index + 1} has an unknown PNG colour type")
    }
    sized_image(IconImage { width, height, colors, planes: 1, bits: i64(data[24]) * channels, data }, index)?
}

fn dib_image(data: []u8, colors: i64, index: i64) -> IconImage ! Error {
    if data.len < dib_header_size || io.le32(data, 0) != dib_header_size {
        fail Icon("image {index + 1} is neither a PNG nor a BMP with a 40 byte header")
    }
    let width = io.le32(data, 4)
    let height = io.le32(data, 8) / 2
    sized_image(IconImage { width, height, colors, planes: io.le16(data, 12), bits: io.le16(data, 14), data }, index)?
}

fn sized_image(image: IconImage, index: i64) -> IconImage ! Error {
    let fits = image.width >= 1 && image.width <= icon_largest && image.height >= 1 && image.height <= icon_largest
    if !fits {
        fail Icon("image {index + 1} is {image.width} by {image.height}, and an icon image is 1 to {icon_largest} pixels on each side")
    }
    image
}

fn icon_group(images: []IconImage) -> []u8 {
    var out: []u8 = []
    io.put_le(mut out, 0, 2)
    io.put_le(mut out, icon_type, 2)
    io.put_le(mut out, images.len, 2)
    for i, image in images {
        io.put_le(mut out, image.width % icon_largest, 1)
        io.put_le(mut out, image.height % icon_largest, 1)
        io.put_le(mut out, image.colors, 1)
        io.put_le(mut out, 0, 1)
        io.put_le(mut out, image.planes, 2)
        io.put_le(mut out, image.bits, 2)
        io.put_le(mut out, image.data.len, 4)
        io.put_le(mut out, i + 1, 2)
    }
    out
}
