import diag
import std/io

const resource_type_icon = 3
const resource_type_group_icon = 14
const resource_type_version = 16
const resource_type_manifest = 24
const resource_name_first = 1
const resource_language = 0x0409
const resource_directory_size = 16
const resource_directory_entry_size = 8
const resource_data_entry_size = 16
const resource_data_align = 8
const resource_subdirectory = 0x80000000

pub enum Error {
    Icon(cause: str)
    Version(number: str)
}

pub fn message(e: Error) -> str {
    match e {
        Icon(cause) => "icon: {cause}"
        Version(number) => "version {diag.quote(number)} is not a semantic version"
    }
}

fn align_up(value: i64, align: i64) -> i64 {
    (value + align - 1) / align * align
}

pub struct FileInfo {
    pub key: str
    pub value: str
}

pub struct Resources {
    pub icon: []u8 = []
    pub manifest: []u8 = []
    pub version: str = ""
    pub info: []FileInfo = []
}

pub fn empty(r: Resources) -> bool {
    r.icon.len == 0 && r.manifest.len == 0 && r.version == "" && r.info.len == 0
}

struct Resource {
    kind: i64
    name: i64
    data: []u8
}

struct ResourcePlan {
    items: []Resource
    kinds: []i64
    kind_at: []i64
    language_at: []i64
    entry_at: []i64
    data_at: []i64
    size: i64
}

fn resource_items(r: Resources) -> []Resource ! Error {
    var items: []Resource = []
    if r.icon.len > 0 {
        let images = icon_images(r.icon)?
        for i, image in images {
            items.push(Resource { kind: resource_type_icon, name: i + 1, data: image.data })
        }
        items.push(Resource { kind: resource_type_group_icon, name: resource_name_first, data: icon_group(images) })
    }
    if r.version != "" || r.info.len > 0 {
        items.push(Resource { kind: resource_type_version, name: resource_name_first, data: version_info(r)? })
    }
    if r.manifest.len > 0 {
        items.push(Resource { kind: resource_type_manifest, name: resource_name_first, data: r.manifest })
    }
    items
}

fn directory_size(entries: i64) -> i64 {
    resource_directory_size + entries * resource_directory_entry_size
}

fn count_kind(items: []Resource, kind: i64) -> i64 {
    var count = 0
    for item in items {
        if item.kind == kind {
            count += 1
        }
    }
    count
}

fn plan_resources(items: []Resource) -> ResourcePlan {
    var kinds: []i64 = []
    for item in items {
        if kinds.len == 0 || kinds[kinds.len - 1] != item.kind {
            kinds.push(item.kind)
        }
    }
    var p = ResourcePlan { items, kinds, kind_at: [], language_at: [], entry_at: [], data_at: [], size: directory_size(kinds.len) }
    for kind in kinds {
        p.kind_at.push(p.size)
        p.size += directory_size(count_kind(items, kind))
    }
    for _ in items {
        p.language_at.push(p.size)
        p.size += directory_size(1)
    }
    for _ in items {
        p.entry_at.push(p.size)
        p.size += resource_data_entry_size
    }
    for item in items {
        p.size = align_up(p.size, resource_data_align)
        p.data_at.push(p.size)
        p.size += item.data.len
    }
    p
}

fn put_directory(mut out: []u8, entries: i64) {
    io.put_le(mut out, 0, 4)
    io.put_le(mut out, 0, 4)
    io.put_le(mut out, 0, 2)
    io.put_le(mut out, 0, 2)
    io.put_le(mut out, 0, 2)
    io.put_le(mut out, entries, 2)
}

fn put_directory_entry(mut out: []u8, id: i64, target: i64) {
    io.put_le(mut out, id, 4)
    io.put_le(mut out, target, 4)
}

fn pad_to(mut out: []u8, at: i64) {
    for out.len < at {
        out.push(0)
    }
}

pub fn section(r: Resources, rva: i64) -> []u8 ! Error {
    let p = plan_resources(resource_items(r)?)
    var out: []u8 = []
    put_directory(mut out, p.kinds.len)
    for i, kind in p.kinds {
        put_directory_entry(mut out, kind, p.kind_at[i] | resource_subdirectory)
    }
    var first = 0
    for i, kind in p.kinds {
        let count = count_kind(p.items, kind)
        put_directory(mut out, count)
        for j in first..first + count {
            put_directory_entry(mut out, p.items[j].name, p.language_at[j] | resource_subdirectory)
        }
        first += count
    }
    for i, _ in p.items {
        put_directory(mut out, 1)
        put_directory_entry(mut out, resource_language, p.entry_at[i])
    }
    for i, item in p.items {
        io.put_le(mut out, rva + p.data_at[i], 4)
        io.put_le(mut out, item.data.len, 4)
        io.put_le(mut out, 0, 4)
        io.put_le(mut out, 0, 4)
    }
    for i, item in p.items {
        pad_to(mut out, p.data_at[i])
        io.append(mut out, item.data)
    }
    out
}
