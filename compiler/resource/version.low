import std/semver
import std/io
import std/text
import std/unicode
import std/unicode/utf16

const version_language = "040904B0"
const version_translation = 0x04B00409
const version_signature = 0xFEEF04BD
const version_struct_version = 0x00010000
const version_file_flags_mask = 0x3F
const version_os_nt_windows32 = 0x00040004
const version_type_app = 1
const version_fixed_size = 52
const version_text = 1
const version_binary = 0
const version_align = 4
const version_part_mask = 0xFFFF
const version_parts = 4

fn version_info(r: Resources) -> []u8 ! Error {
    let strings = version_strings(r)?
    let file = version_parts_of(strings, "FileVersion")
    let product = version_parts_of(strings, "ProductVersion")
    var fixed: []u8 = []
    io.put_le(mut fixed, version_signature, 4)
    io.put_le(mut fixed, version_struct_version, 4)
    io.put_le(mut fixed, file[0] << 16 | file[1], 4)
    io.put_le(mut fixed, file[2] << 16 | file[3], 4)
    io.put_le(mut fixed, product[0] << 16 | product[1], 4)
    io.put_le(mut fixed, product[2] << 16 | product[3], 4)
    io.put_le(mut fixed, version_file_flags_mask, 4)
    io.put_le(mut fixed, 0, 4)
    io.put_le(mut fixed, version_os_nt_windows32, 4)
    io.put_le(mut fixed, version_type_app, 4)
    io.put_le(mut fixed, 0, 4)
    io.put_le(mut fixed, 0, 4)
    io.put_le(mut fixed, 0, 4)
    let children = [string_file_info(strings), var_file_info()]
    version_node("VS_VERSION_INFO", version_binary, version_fixed_size, fixed, join_nodes(children))
}

fn version_strings(r: Resources) -> []FileInfo ! Error {
    var strings: []FileInfo = []
    if r.version != "" {
        let v = semver.parse(r.version) catch {
            _ => fail Version(r.version)
        }
        let number = "{v.major}.{v.minor}.{v.patch}.0"
        strings.push(FileInfo { key: "FileVersion", value: number })
        strings.push(FileInfo { key: "ProductVersion", value: number })
    }
    for entry in r.info {
        set_string(mut strings, entry)
    }
    strings
}

fn set_string(mut strings: []FileInfo, entry: FileInfo) {
    for i, s in strings {
        if s.key == entry.key {
            strings[i] = entry
            return
        }
    }
    strings.push(entry)
}

fn version_parts_of(strings: []FileInfo, key: str) -> []i64 {
    var parts: []i64 = []
    for s in strings {
        if s.key != key {
            continue
        }
        for piece in text.split(s.value, '.') {
            let n = text.parse_int(piece) or break
            parts.push(n & version_part_mask)
        }
    }
    for parts.len < version_parts {
        parts.push(0)
    }
    parts[..version_parts]
}

fn string_file_info(strings: []FileInfo) -> []u8 {
    var entries: [][]u8 = []
    for s in strings {
        let value = wide_text(s.value)
        entries.push(version_node(s.key, version_text, value.len / 2, value, []))
    }
    let table = version_node(version_language, version_text, 0, [], join_nodes(entries))
    version_node("StringFileInfo", version_text, 0, [], table)
}

fn var_file_info() -> []u8 {
    var translation: []u8 = []
    io.put_le(mut translation, version_translation, 4)
    let var_node = version_node("Translation", version_binary, translation.len, translation, [])
    version_node("VarFileInfo", version_text, 0, [], var_node)
}

fn wide_text(s: str) -> []u8 {
    utf16.encode_bytes("{s}\0", unicode.Order.Little, false)
}

fn join_nodes(nodes: [][]u8) -> []u8 {
    var out: []u8 = []
    for i, node in nodes {
        if i > 0 {
            pad_version(mut out)
        }
        io.append(mut out, node)
    }
    out
}

fn pad_version(mut out: []u8) {
    pad_to(mut out, align_up(out.len, version_align))
}

fn version_node(key: str, kind: i64, value_length: i64, value: []u8, children: []u8) -> []u8 {
    var out: []u8 = []
    io.put_le(mut out, 0, 2)
    io.put_le(mut out, value_length, 2)
    io.put_le(mut out, kind, 2)
    io.append(mut out, wide_text(key))
    pad_version(mut out)
    io.append(mut out, value)
    if children.len > 0 {
        pad_version(mut out)
        io.append(mut out, children)
    }
    out[0] = u8(out.len)
    out[1] = u8(out.len >> 8)
    out
}
