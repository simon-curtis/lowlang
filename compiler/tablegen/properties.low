import std/slices
import std/text

const code_points = 0x110000
const props_shift = 7
const case_shift = 7
const props_block_mask = (1 << props_shift) - 1
const case_block_mask = (1 << case_shift) - 1
const max_record_id = 0xFFFF
const fold_from = 0x40000
const fold_to = 0xE0000
const fold_gap = fold_to - fold_from

const case_upper = 0
const case_lower = 1
const case_title = 2
const case_fields = 3

const props_record_size = word_size
const case_field_width = word_size
const case_record_size = case_fields * case_field_width
const special_code_offset = 0
const special_reference_offset = special_code_offset + word_size
const special_length_offset = special_reference_offset + u16_width
const special_field_stride = 2 * u16_width
const special_size = special_reference_offset + case_fields * special_field_stride
const special_pool_unit = word_size

pub const property_layout_file = "property_layout.low"

pub fn property_tables() -> []str {
    [
        "props_index.bin", "props_blocks.bin", "props_records.bin"
        "case_index.bin", "case_blocks.bin", "case_records.bin"
        "special.bin", "special_pool.bin"
    ]
}

fn category_names() -> []str {
    [
        "Cn", "Lu", "Ll", "Lt", "Lm", "Lo", "Mn", "Mc", "Me", "Nd", "Nl", "No", "Pc", "Pd", "Ps"
        "Pe", "Pi", "Pf", "Po", "Sm", "Sc", "Sk", "So", "Zs", "Zl", "Zp", "Cc", "Cf", "Cs", "Co"
    ]
}

fn width_names() -> []str {
    ["N", "A", "F", "H", "Na", "W"]
}

fn script_names() -> []str {
    [
        "Unknown", "Common", "Inherited", "Latin", "Greek", "Cyrillic", "Armenian", "Hebrew", "Arabic"
        "Syriac", "Thaana", "Devanagari", "Bengali", "Gurmukhi", "Gujarati", "Tamil", "Telugu", "Kannada"
        "Malayalam", "Sinhala", "Thai", "Lao", "Tibetan", "Myanmar", "Georgian", "Hangul", "Ethiopic"
        "Khmer", "Mongolian", "Hiragana", "Katakana", "Bopomofo", "Han"
    ]
}

fn break_names() -> []str {
    [
        "Other", "CR", "LF", "Control", "Extend", "ZWJ", "Regional_Indicator", "Prepend", "SpacingMark"
        "L", "V", "T", "LV", "LVT"
    ]
}

fn conjunct_names() -> []str {
    ["None", "Consonant", "Linker", "Extend"]
}

const category_mask = 0x1F
const width_mask = 7
const script_mask = 63
const break_mask = 15
const conjunct_mask = 3
const category_shift = 0
const width_shift = 5
const script_shift = 8
const break_shift = 14
const conjunct_shift = 18
const pictograph_shift = 20
const space_shift = 21
const xid_start_shift = 22
const xid_continue_shift = 23
const pictograph_flag = 1 << pictograph_shift
const space_flag = 1 << space_shift
const xid_start_flag = 1 << xid_start_shift
const xid_continue_flag = 1 << xid_continue_shift

struct CaseDeltas {
    upper: i64
    lower: i64
    title: i64
}

struct Casing {
    lower: []i64
    upper: []i64
    title: []i64
}

struct PropertyDatabase {
    range_start: i64
    props: []u32
    deltas: []CaseDeltas
    special: [i64: Casing]
}

struct Step {
    file: str
    handle: fn(i64, i64, []str) ! Error
}

fn generate_properties(dir: str, output: str) ! Error {
    let no_deltas = CaseDeltas { upper: 0, lower: 0, title: 0 }
    var props: []u32 = []
    var deltas: []CaseDeltas = []
    for i in 0..code_points {
        push(mut props, 0)
        push(mut deltas, no_deltas)
    }
    let db = new(PropertyDatabase { range_start: 0, props, deltas, special: [:] })
    let steps = [
        Step { file: "UnicodeData.txt", handle: fn(first: i64, last: i64, fields: []str) ! Error { read_unicode_data(db, first, last, fields)? } }
        Step { file: "EastAsianWidth.txt", handle: fn(first: i64, last: i64, fields: []str) ! Error { read_width(db, first, last, fields)? } }
        Step { file: "Scripts.txt", handle: fn(first: i64, last: i64, fields: []str) ! Error { read_script(db, first, last, fields)? } }
        Step { file: "GraphemeBreakProperty.txt", handle: fn(first: i64, last: i64, fields: []str) ! Error { read_break(db, first, last, fields)? } }
        Step { file: "emoji-data.txt", handle: fn(first: i64, last: i64, fields: []str) ! Error { read_pictographic(db, first, last, fields)? } }
        Step { file: "PropList.txt", handle: fn(first: i64, last: i64, fields: []str) ! Error { read_space(db, first, last, fields)? } }
        Step { file: "DerivedCoreProperties.txt", handle: fn(first: i64, last: i64, fields: []str) ! Error { read_derived(db, first, last, fields)? } }
    ]
    for step in steps {
        each_range("{dir}/{step.file}", step.handle)?
    }
    each_line("{dir}/SpecialCasing.txt", fn(fields: []str) ! Error { read_special(db, fields)? })?
    let sections = property_sections(db)?
    write_sections(output, sections)?
}

fn each_range(path: str, handle: fn(i64, i64, []str) ! Error) ! Error {
    each_line(path, fn(fields: []str) ! Error {
        let cut = text.cut(fields[0], "..")
        var last = cut.before
        if cut.found {
            last = cut.after
        }
        let from = parse_code(cut.before)?
        let to = parse_code(last)?
        handle(from, to, fields[1..])?
    })?
}

fn index_of(names: []str, name: str) -> i64 ! Error {
    slices.index(names, name) ?? fail Failed("unknown value {text.quote(name)}")
}

fn set_field(db: *PropertyDatabase, first: i64, last: i64, mask: u32, shift: i64, value: u32) {
    for c in first..last + 1 {
        db.props[c] = db.props[c] & ~(mask << shift) | value << shift
    }
}

fn set_flag(db: *PropertyDatabase, first: i64, last: i64, flag: u32) {
    for c in first..last + 1 {
        db.props[c] |= flag
    }
}

fn parse_delta(field: str, c: i64) -> i64 ! Error {
    if field == "" {
        return 0
    }
    let to = parse_code(field)?
    to - c
}

fn read_unicode_data(db: *PropertyDatabase, start: i64, end: i64, fields: []str) ! Error {
    if fields.len < 14 {
        let digits = text.pad_left(text.hex(start), 4, 48)
        fail Failed("short UnicodeData line for {text.upper(digits)}")
    }
    var first = start
    if text.ends_with(fields[0], "First>") {
        db.range_start = first
        return
    }
    if text.ends_with(fields[0], "Last>") {
        first = db.range_start
    }
    let category = index_of(category_names(), fields[1])?
    set_field(db, first, end, u32(category_mask), category_shift, u32(category))
    let upper = parse_delta(fields[11], first)?
    let lower = parse_delta(fields[12], first)?
    let title = parse_delta(fields[13], first)?
    db.deltas[first] = CaseDeltas { upper, lower, title }
}

fn read_width(db: *PropertyDatabase, first: i64, last: i64, fields: []str) ! Error {
    let width = index_of(width_names(), fields[0])?
    set_field(db, first, last, u32(width_mask), width_shift, u32(width))
}

fn read_script(db: *PropertyDatabase, first: i64, last: i64, fields: []str) ! Error {
    var script = slices.index(script_names(), fields[0]) ?? script_names().len
    set_field(db, first, last, u32(script_mask), script_shift, u32(script))
}

fn read_break(db: *PropertyDatabase, first: i64, last: i64, fields: []str) ! Error {
    let kind = index_of(break_names(), fields[0])?
    set_field(db, first, last, u32(break_mask), break_shift, u32(kind))
}

fn read_pictographic(db: *PropertyDatabase, first: i64, last: i64, fields: []str) ! Error {
    if fields[0] == "Extended_Pictographic" {
        set_flag(db, first, last, u32(pictograph_flag))
    }
}

fn read_space(db: *PropertyDatabase, first: i64, last: i64, fields: []str) ! Error {
    if fields[0] == "White_Space" {
        set_flag(db, first, last, u32(space_flag))
    }
}

fn read_derived(db: *PropertyDatabase, first: i64, last: i64, fields: []str) ! Error {
    match fields[0] {
        == "XID_Start" => set_flag(db, first, last, u32(xid_start_flag))
        == "XID_Continue" => set_flag(db, first, last, u32(xid_continue_flag))
        == "InCB" => {
            let kind = index_of(conjunct_names(), fields[1])?
            set_field(db, first, last, u32(conjunct_mask), conjunct_shift, u32(kind))
        }
        _ => {}
    }
}

fn read_special(db: *PropertyDatabase, fields: []str) ! Error {
    if fields.len != 5 || fields[4] != "" {
        return
    }
    let c = parse_code(fields[0])?
    let lower = parse_codes(fields[1])?
    let title = parse_codes(fields[2])?
    let upper = parse_codes(fields[3])?
    db.special[c] = Casing { lower, upper, title }
}

struct Trie {
    index: []u8
    blocks: []u8
    records: []u8
}

fn fold_planes[R](per_code: []R, is_zero: fn(R) -> bool) -> []R ! Error {
    for i in fold_from..fold_to {
        if !is_zero(per_code[i]) {
            fail Failed("code points between U+{text.upper(text.hex(fold_from))} and U+{text.upper(text.hex(fold_to))} are not all default")
        }
    }
    var folded = slices.clone(per_code[..fold_from])
    for v in per_code[fold_to..] {
        push(mut folded, v)
    }
    folded
}

fn build_record_trie[R](all: []R, shift: i64, zero: R, key: fn(R) -> str, encode: fn(R) -> []u8) -> Trie ! Error {
    var out = Trie { index: [], blocks: [], records: [] }
    let per_code = fold_planes(all, fn(v: R) -> bool { key(v) == key(zero) })?
    var limit = per_code.len
    for limit > 0 && key(per_code[limit - 1]) == key(zero) {
        limit -= 1
    }
    let size = 1 << shift
    var records = [zero]
    let ids: [str: i64] = [key(zero): 0]
    let seen: [str: i64] = [:]
    var stage2: [][]u8 = []
    var start = 0
    for start < limit {
        var block: []u8 = []
        for i in 0..size {
            var r = zero
            if start + i < limit {
                r = per_code[start + i]
            }
            let r_key = key(r)
            var id = ids[r_key] ?? -1
            if id < 0 {
                id = records.len
                ids[r_key] = id
                push(mut records, r)
            }
            if id > max_record_id {
                fail Failed("record ids overflow 16 bits")
            }
            append_u16(mut block, id)
        }
        let block_key = str(block)
        var index = seen[block_key] ?? -1
        if index < 0 {
            index = stage2.len
            seen[block_key] = index
            push(mut stage2, block)
        }
        if index > max_record_id {
            fail Failed("block index overflows 16 bits")
        }
        append_u16(mut out.index, index)
        start += size
    }
    for block in stage2 {
        for b in block {
            push(mut out.blocks, b)
        }
    }
    for r in records {
        for b in encode(r) {
            push(mut out.records, b)
        }
    }
    out
}

struct SpecialTable {
    entries: []u8
    pooled: []u8
}

fn special_table(db: *PropertyDatabase) -> SpecialTable ! Error {
    var codes: []i64 = []
    for c in db.special {
        push(mut codes, c)
    }
    slices.sort(mut codes)
    let pool = new(SequencePool { data: [], offsets: [:] })
    var entries: []u8 = []
    for c in codes {
        let entry = db.special[c] ?? Casing { lower: [], upper: [], title: [] }
        let encoded = encode_special(pool, c, entry)?
        for b in encoded {
            push(mut entries, b)
        }
    }
    SpecialTable { entries, pooled: pool.data }
}

fn encode_special(p: *SequencePool, c: i64, entry: Casing) -> []u8 ! Error {
    var out = zeros(special_size)
    put_u32(mut out, special_code_offset, c)
    let sequences = [entry.upper, entry.lower, entry.title]
    for field, seq in sequences {
        let key = pool_add(p, seq)?
        let reference = special_reference_offset + field * special_field_stride
        put_u16(mut out, reference, pool_reference(p, key))
        put_u16(mut out, special_length_offset + field * special_field_stride, seq.len)
    }
    out
}

fn delta_key(d: CaseDeltas) -> str {
    "{d.upper},{d.lower},{d.title}"
}

fn encode_delta(d: CaseDeltas) -> []u8 {
    var out: []u8 = []
    append_u32(mut out, d.upper)
    append_u32(mut out, d.lower)
    append_u32(mut out, d.title)
    out
}

fn property_sections(db: *PropertyDatabase) -> []Section ! Error {
    let props = build_record_trie(db.props, props_shift, u32(0), fn(v: u32) -> str { "{v}" }, fn(v: u32) -> []u8 {
        var out: []u8 = []
        append_u32(mut out, i64(v))
        out
    })?
    let no_deltas = CaseDeltas { upper: 0, lower: 0, title: 0 }
    let deltas = build_record_trie(db.deltas, case_shift, no_deltas, delta_key, encode_delta)?
    let special = special_table(db)?
    var sections = named_sections(property_tables(), [
        props.index, props.blocks, props.records
        deltas.index, deltas.blocks, deltas.records
        special.entries, special.pooled
    ])
    let layout = bytes(property_layout_source())
    push(mut sections, Section { name: property_layout_file, data: layout })
    sections
}

pub fn property_layout_source() -> str {
    var constants = [
        low_constant("props_block_shift", props_shift, LowType.Int)
        low_constant("props_block_mask", props_block_mask, LowType.Word)
        low_constant("props_record_size", props_record_size, LowType.Int)
        low_constant("case_block_shift", case_shift, LowType.Int)
        low_constant("case_block_mask", case_block_mask, LowType.Word)
        low_constant("case_record_size", case_record_size, LowType.Int)
        low_constant("case_field_width", case_field_width, LowType.Int)
        low_constant("case_upper_field", case_upper, LowType.Int)
        low_constant("case_lower_field", case_lower, LowType.Int)
        low_constant("case_title_field", case_title, LowType.Int)
        low_constant("special_size", special_size, LowType.Int)
        low_constant("special_code_offset", special_code_offset, LowType.Int)
        low_constant("special_reference_offset", special_reference_offset, LowType.Int)
        low_constant("special_length_offset", special_length_offset, LowType.Int)
        low_constant("special_field_stride", special_field_stride, LowType.Int)
        low_constant("special_pool_unit", special_pool_unit, LowType.Int)
        low_constant("fold_from", fold_from, LowType.CodePoint)
        low_constant("fold_to", fold_to, LowType.CodePoint)
        low_constant("fold_gap", fold_gap, LowType.CodePoint)
        low_constant("property_category_shift", category_shift, LowType.Int)
        low_constant("property_category_mask", category_mask, LowType.Word)
        low_constant("property_width_shift", width_shift, LowType.Int)
        low_constant("property_width_mask", width_mask, LowType.Word)
        low_constant("property_script_shift", script_shift, LowType.Int)
        low_constant("property_script_mask", script_mask, LowType.Word)
        low_constant("property_break_shift", break_shift, LowType.Int)
        low_constant("property_break_mask", break_mask, LowType.Word)
        low_constant("property_conjunct_shift", conjunct_shift, LowType.Int)
        low_constant("property_conjunct_mask", conjunct_mask, LowType.Word)
        low_constant("property_pictographic_shift", pictograph_shift, LowType.Int)
        low_constant("property_space_shift", space_shift, LowType.Int)
        low_constant("property_identifier_start_shift", xid_start_shift, LowType.Int)
        low_constant("property_identifier_continue_shift", xid_continue_shift, LowType.Int)
    ]
    for c in class_constants("category_", category_names(), LowType.Word) {
        push(mut constants, c)
    }
    for c in class_constants("width_", width_names(), LowType.Word) {
        push(mut constants, c)
    }
    for c in class_constants("break_", break_names(), LowType.Int) {
        push(mut constants, c)
    }
    for c in class_constants("conjunct_", conjunct_names(), LowType.Int) {
        push(mut constants, c)
    }
    layout_source(constants, property_tables())
}
