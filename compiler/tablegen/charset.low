import emit
import std/builder
import std/file
import std/slices
import std/text

const single_byte_entries = 128
const single_byte_base = 0x80
const unmapped_reverse = 0xFFFFFFFF
const ranges_name = "gb18030-ranges"

fn generate_charset(dir: str, output: str) ! Error {
    let paths = index_paths(dir)?
    var tables: []u8 = []
    var names = builder.builder()
    var sections: []Section = []
    for path in paths {
        let base = index_name(path)
        let entries = read_index(path)?
        if base == ranges_name {
            let ranges = ranges_block(entries)
            sections.push(Section { name: "{base}.bin", data: ranges })
            continue
        }
        if !single_byte(entries) {
            let multi_byte = multi_byte_block(base, entries)?
            sections.push(Section { name: "{base}.bin", data: multi_byte })
            continue
        }
        let block = single_byte_block(base, entries)?
        for b in block {
            tables.push(b)
        }
        builder.write(mut names, "{base}\n")
    }
    sections.push(Section { name: "tables.bin", data: tables })
    sections.push(Section { name: "tables.txt", data: names.to_bytes() })
    write_sections(output, sections)?
}

fn index_name(path: str) -> str {
    let stem = text.trim_prefix(path_base(path), "index-")
    text.trim_suffix(stem, ".txt")
}

fn index_paths(dir: str) -> []str ! Error {
    let entries = file.list(dir) catch {
        e => fail Failed("open {dir}: {emit.io_message(e)}")
    }
    var paths: []str = []
    for name in entries {
        if text.starts_with(name, "index-") && text.ends_with(name, ".txt") {
            paths.push(file.child_path(dir, name))
        }
    }
    slices.sort(mut paths)
    paths
}

fn parse_decimal(s: str) -> i64 ! Error {
    text.parse_int(s) or fail Failed("strconv.Atoi: parsing {text.quote(s)}: invalid syntax")
}

fn read_index(path: str) -> [i64: i64] ! Error {
    let data = read_source(path)?
    let entries: [i64: i64] = [:]
    for raw in text.split(data, '\n') {
        let line = text.cut(raw, "#").before
        let fields = text.fields(line)
        if fields.len == 0 {
            continue
        }
        if fields.len < 2 {
            fail Failed("{path_base(path)}: short line {text.quote(line)}")
        }
        let pointer = parse_decimal(fields[0])?
        let code = parse_code(text.trim_prefix(fields[1], "0x"))?
        entries[pointer] = code
    }
    entries
}

fn single_byte(entries: [i64: i64]) -> bool {
    for pointer, _ in entries {
        if pointer >= single_byte_entries {
            return false
        }
    }
    true
}

struct Pair {
    code: i64
    b: i64
}

fn single_byte_block(base: str, entries: [i64: i64]) -> []u8 ! Error {
    var reverse: []Pair = []
    var block: []u8 = []
    for p in 0..single_byte_entries {
        let code = entries[p] ?? 0
        if code > 0xFFFF {
            fail Failed("index-{base}.txt: pointer {p} is outside the BMP")
        }
        append_u16(mut block, code)
        if code != 0 {
            reverse.push(Pair { code, b: p + single_byte_base })
        }
    }
    slices.sort_by(mut reverse, fn(a: Pair, b: Pair) -> bool { a.code < b.code })
    for r in reverse {
        append_u32(mut block, r.code << 8 | r.b)
    }
    for _ in reverse.len..single_byte_entries {
        append_u32(mut block, unmapped_reverse)
    }
    block
}

fn multi_byte_block(base: str, entries: [i64: i64]) -> []u8 ! Error {
    var count = 0
    var width = 2
    var reverse: []Pair = []
    for pointer, code in entries {
        if pointer > 0xFFFF || code == 0 {
            fail Failed("index-{base}.txt: pointer {pointer} cannot be stored")
        }
        if pointer >= count {
            count = pointer + 1
        }
        if code > 0xFFFF {
            width = 4
        }
        reverse.push(Pair { code, b: pointer })
    }
    slices.sort_by(mut reverse, fn(a: Pair, b: Pair) -> bool { a.code < b.code || a.code == b.code && a.b < b.b })
    var block: []u8 = []
    append_u32(mut block, count)
    append_u32(mut block, width)
    for p in 0..count {
        let code = entries[p] ?? 0
        if width == 4 {
            append_u32(mut block, code)
        } else {
            append_u16(mut block, code)
        }
    }
    for r in reverse {
        append_u16(mut block, r.b)
    }
    block
}

fn ranges_block(entries: [i64: i64]) -> []u8 {
    var pointers: []i64 = []
    for pointer, _ in entries {
        pointers.push(pointer)
    }
    slices.sort(mut pointers)
    var block: []u8 = []
    for p in pointers {
        append_u32(mut block, p)
        append_u32(mut block, entries[p] ?? 0)
    }
    block
}
