import emit
import std/builder
import std/file
import std/slices
import std/text

const single_byte_entries = 128
const single_byte_base = 0x80

fn generate_charset(dir: str, output: str) ! Error {
    let paths = index_paths(dir)?
    var tables: []u8 = []
    var names = builder.builder()
    for path in paths {
        let file_name = path_base(path)
        let stem = text.trim_prefix(file_name, "index-")
        let base = text.trim_suffix(stem, ".txt")
        let block = single_byte_block(path)?
        for b in block {
            push(mut tables, b)
        }
        builder.write(mut names, "{base}\n")
    }
    write_sections(output, [
        Section { name: "tables.bin", data: tables }
        Section { name: "tables.txt", data: names.to_bytes() }
    ])?
}

fn index_paths(dir: str) -> []str ! Error {
    let entries = file.list(dir) catch {
        e => fail Failed("open {dir}: {emit.io_message(e)}")
    }
    var paths: []str = []
    for name in entries {
        if text.starts_with(name, "index-") && text.ends_with(name, ".txt") {
            push(mut paths, file.child_path(dir, name))
        }
    }
    slices.sort(mut paths)
    paths
}

fn parse_decimal(s: str) -> i64 ! Error {
    text.parse_int(s) or fail Failed("strconv.Atoi: parsing {text.quote(s)}: invalid syntax")
}

fn read_index(path: str) -> [i64: i64] ! Error {
    let data = read_source(path)?
    let entries: [i64: i64] = [:]
    for raw in text.split(data, '\n') {
        let line = text.cut(raw, "#").before
        let fields = text.fields(line)
        if fields.len == 0 {
            continue
        }
        if fields.len < 2 {
            fail Failed("{path_base(path)}: short line {text.quote(line)}")
        }
        let pointer = parse_decimal(fields[0])?
        let code = parse_code(text.trim_prefix(fields[1], "0x"))?
        entries[pointer] = code
    }
    entries
}

struct Pair {
    code: i64
    b: i64
}

fn single_byte_block(path: str) -> []u8 ! Error {
    let entries = read_index(path)?
    if entries.len != single_byte_entries {
        fail Failed("{path_base(path)}: {entries.len} entries, want {single_byte_entries}")
    }
    var reverse: []Pair = []
    var block: []u8 = []
    for p in 0..single_byte_entries {
        let code = entries[p] ?? fail Failed("{path_base(path)}: pointer {p} is missing or outside the BMP")
        if code > 0xFFFF {
            fail Failed("{path_base(path)}: pointer {p} is missing or outside the BMP")
        }
        append_u16(mut block, code)
        push(mut reverse, Pair { code, b: p + single_byte_base })
    }
    slices.sort_by(mut reverse, fn(a: Pair, b: Pair) -> bool { a.code < b.code })
    for r in reverse {
        append_u32(mut block, r.code << 8 | r.b)
    }
    block
}
