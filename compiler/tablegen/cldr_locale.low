import emit
import std/builder
import std/slices
import std/text
import std/xml

struct Slot {
    present: bool
    text: str
}

struct Collector {
    groups: [i64: []Slot]
    specs: []GroupSpec
    numbering: []str
    currencies: []str
}

fn fresh_slots(size: i64) -> []Slot {
    var slots: []Slot = []
    for i in 0..size {
        slots.push(Slot { present: false, text: "" })
    }
    slots
}

fn put_slot(c: *Collector, group: str, offset: i64, index: i64, value: str) {
    let id = group_base(c.specs, group) + offset
    let size = group_size(c.specs, group)
    let slots = c.groups[id] ?? fresh_slots(size)
    slots[index] = Slot { present: true, text: value }
    c.groups[id] = slots
}

fn pick(e: *xml.Element?, step: str) -> *xml.Element? {
    let parent = e ?? return none
    let cut = text.cut(step, "@")
    for c in xml.children(parent, cut.before) {
        if cut.found && emit.attribute_text(c, "type") != cut.after {
            continue
        }
        return c
    }
    none
}

fn walk(e: *xml.Element?, steps: []str) -> *xml.Element? {
    var current = e
    for step in steps {
        current = pick(current, step)
    }
    current
}

fn draft_skipped(e: *xml.Element) -> bool {
    let d = xml.attribute(e, "draft") ?? ""
    d == "unconfirmed" || d == "provisional"
}

const inherit_marker = "↑↑↑"

fn value_text(e: *xml.Element) -> str? {
    if draft_skipped(e) {
        return none
    }
    let v = xml.text(e)
    if v == inherit_marker {
        return none
    }
    v
}

fn plain_value(parent: *xml.Element?, name: str, kind: str?, count: str?) -> str? {
    let p = parent ?? return none
    for c in xml.children(p, name) {
        if xml.attribute(c, "alt") != kind {
            continue
        }
        if count != none && xml.attribute(c, "count") != count {
            continue
        }
        if count == none && xml.attribute(c, "count") != none {
            continue
        }
        return value_text(c)
    }
    none
}

fn first_value(parent: *xml.Element?, name: str) -> str? {
    plain_value(parent, name, none, none)
}

fn numbering_index(c: *Collector, id: str) -> i64 {
    for i, n in c.numbering {
        if n == id {
            return i
        }
    }
    -1
}

fn currency_index(c: *Collector, code: str) -> i64 {
    for i, n in c.currencies {
        if n == code {
            return i
        }
    }
    -1
}

fn category_slot(name: str) -> i64 {
    match name {
        "zero" => 0
        "one" => 1
        "two" => 2
        "few" => 3
        "many" => 4
        "other" => 5
        _ => -1
    }
}

fn symbol_slot(name: str) -> i64 {
    match name {
        "decimal" => 0
        "group" => 1
        "list" => 2
        "percentSign" => 3
        "plusSign" => 4
        "minusSign" => 5
        "exponential" => 6
        "superscriptingExponent" => 7
        "perMille" => 8
        "infinity" => 9
        "nan" => 10
        "timeSeparator" => 11
        "currencyDecimal" => 12
        "currencyGroup" => 13
        "approximatelySign" => 14
        _ => -1
    }
}

fn put_symbols(c: *Collector, numbers: *xml.Element) {
    for s in xml.children(numbers, "symbols") {
        let ns = numbering_index(c, emit.attribute_text(s, "numberSystem"))
        if ns < 0 {
            continue
        }
        for e in xml.children(s, "*") {
            let slot = symbol_slot(e.name.local)
            if slot < 0 || xml.attribute(e, "alt") != none {
                continue
            }
            let v = value_text(e) ?? continue
            put_slot(c, "symbols", ns, slot, v)
        }
    }
}

fn pattern_of(format: *xml.Element?) -> str? {
    plain_value(format, "pattern", none, none)
}

fn put_compact(c: *Collector, group: str, ns: i64, length: *xml.Element?, format_name: str, standard_only: bool) {
    let parent = length ?? return
    for format in xml.children(parent, format_name) {
        if standard_only && (xml.attribute(format, "type") ?? "standard") != "standard" {
            continue
        }
        for p in xml.children(format, "pattern") {
            if xml.attribute(p, "alt") != none {
                continue
            }
            let magnitude = emit.attribute_text(p, "type")
            let category = category_slot(emit.attribute_text(p, "count"))
            if category < 0 {
                continue
            }
            let digits = magnitude.len - 1
            if digits < 3 || digits > 19 {
                continue
            }
            let v = value_text(p) ?? continue
            put_slot(c, group, ns, (digits - 3) * 6 + category, v)
        }
    }
}

fn length_of(parent: *xml.Element, name: str, kind: str?) -> *xml.Element? {
    for l in xml.children(parent, name) {
        if xml.attribute(l, "type") == kind {
            return l
        }
    }
    none
}

fn put_formats(c: *Collector, numbers: *xml.Element) {
    for set in xml.children(numbers, "decimalFormats") {
        let ns = numbering_index(c, emit.attribute_text(set, "numberSystem"))
        if ns < 0 {
            continue
        }
        let standard = length_of(set, "decimalFormatLength", none)
        let value = pattern_of(pick(standard, "decimalFormat"))
        match value {
            some(v) => put_slot(c, "formats", ns, 0, v)
            none => {}
        }
        put_compact(c, "compact_short", ns, length_of(set, "decimalFormatLength", "short"), "decimalFormat", false)
        put_compact(c, "compact_long", ns, length_of(set, "decimalFormatLength", "long"), "decimalFormat", false)
    }
    for set in xml.children(numbers, "percentFormats") {
        let ns = numbering_index(c, emit.attribute_text(set, "numberSystem"))
        if ns < 0 {
            continue
        }
        let value = pattern_of(pick(length_of(set, "percentFormatLength", none), "percentFormat"))
        match value {
            some(v) => put_slot(c, "formats", ns, 1, v)
            none => {}
        }
    }
    for set in xml.children(numbers, "currencyFormats") {
        let ns = numbering_index(c, emit.attribute_text(set, "numberSystem"))
        if ns < 0 {
            continue
        }
        let standard = length_of(set, "currencyFormatLength", none)
        if standard != none {
            let parent = standard ?? set
            for f in xml.children(parent, "currencyFormat") {
                let kind = xml.attribute(f, "type") ?? "standard"
                let v = pattern_of(f) ?? continue
                if kind == "standard" {
                    put_slot(c, "formats", ns, 2, v)
                } else if kind == "accounting" {
                    put_slot(c, "formats", ns, 3, v)
                }
            }
        }
        for u in xml.children(set, "unitPattern") {
            let category = category_slot(emit.attribute_text(u, "count"))
            let v = value_text(u) ?? continue
            if category >= 0 {
                put_slot(c, "formats", ns, 4 + category, v)
            }
        }
        put_compact(c, "compact_currency", ns, length_of(set, "currencyFormatLength", "short"), "currencyFormat", true)
        let spacing = pick(set, "currencySpacing")
        if spacing != none {
            put_spacing(c, spacing)
        }
    }
}

fn put_spacing(c: *Collector, spacing: *xml.Element?) {
    let names = ["currencyMatch", "surroundingMatch", "insertBetween"]
    let sides = ["beforeCurrency", "afterCurrency"]
    for s, side in sides {
        let node = pick(spacing, side)
        for n, name in names {
            let v = first_value(node, name) ?? continue
            put_slot(c, "numbering", 0, 5 + s * 3 + n, v)
        }
    }
}

fn put_currencies(c: *Collector, numbers: *xml.Element) {
    for set in xml.children(numbers, "currencies") {
        for cur in xml.children(set, "currency") {
            let index = currency_index(c, emit.attribute_text(cur, "type"))
            if index < 0 {
                continue
            }
            match plain_value(cur, "symbol", none, none) {
                some(v) => put_slot(c, "currency", index, 0, v)
                none => {}
            }
            match plain_value(cur, "symbol", "narrow", none) {
                some(v) => put_slot(c, "currency", index, 1, v)
                none => {}
            }
            match plain_value(cur, "displayName", none, none) {
                some(v) => put_slot(c, "currency", index, 2, v)
                none => {}
            }
            for name in text.fields("zero one two few many other") {
                match plain_value(cur, "displayName", none, name) {
                    some(v) => put_slot(c, "currency", index, 3 + category_slot(name), v)
                    none => {}
                }
            }
        }
    }
}

fn put_numbers(c: *Collector, root: *xml.Element) {
    let numbers = xml.child(root, "numbers") ?? return
    match first_value(numbers, "defaultNumberingSystem") {
        some(v) => put_slot(c, "numbering", 0, 0, v)
        none => {}
    }
    let other = pick(numbers, "otherNumberingSystems")
    let kinds = ["native", "traditional", "finance"]
    for i, k in kinds {
        match first_value(other, k) {
            some(v) => put_slot(c, "numbering", 0, 1 + i, v)
            none => {}
        }
    }
    match first_value(numbers, "minimumGroupingDigits") {
        some(v) => put_slot(c, "numbering", 0, 4, v)
        none => {}
    }
    put_symbols(c, numbers)
    put_formats(c, numbers)
    put_currencies(c, numbers)
}

fn month_slot(name: str) -> i64 {
    (text.parse_int(name) or 0) - 1
}

fn weekday_slot(name: str) -> i64 {
    match name {
        "sun" => 0
        "mon" => 1
        "tue" => 2
        "wed" => 3
        "thu" => 4
        "fri" => 5
        "sat" => 6
        _ => -1
    }
}

fn period_slot(name: str) -> i64 {
    let names = text.fields("am pm midnight noon morning1 morning2 afternoon1 afternoon2 evening1 evening2 night1 night2")
    for i, n in names {
        if n == name {
            return i
        }
    }
    -1
}

fn width_slot(name: str) -> i64 {
    match name {
        "wide" => 0
        "abbreviated" => 1
        "narrow" => 2
        "short" => 3
        _ => -1
    }
}

fn context_slot(name: str) -> i64 {
    match name {
        "format" => 0
        "stand-alone" => 1
        _ => -1
    }
}

fn put_names(c: *Collector, calendar: *xml.Element, spec: NameSpec) {
    let container = xml.child(calendar, spec.container) ?? return
    for ctx in xml.children(container, spec.context) {
        let ci = context_slot(emit.attribute_text(ctx, "type"))
        if ci < 0 {
            continue
        }
        for w in xml.children(ctx, spec.width) {
            let wi = width_slot(emit.attribute_text(w, "type"))
            if wi < 0 || wi >= spec.widths {
                continue
            }
            put_name_items(c, w, spec, (ci * spec.widths + wi) * spec.count)
        }
    }
}

fn put_name_items(c: *Collector, width: *xml.Element, spec: NameSpec, base: i64) {
    for it in xml.children(width, spec.item) {
        if xml.attribute(it, "alt") != none {
            continue
        }
        let si = name_slot(spec.group, emit.attribute_text(it, "type"))
        if si < 0 {
            continue
        }
        let v = value_text(it) ?? continue
        put_slot(c, spec.group, 0, base + si, v)
    }
}

struct NameSpec {
    group: str
    container: str
    context: str
    width: str
    item: str
    widths: i64
    count: i64
}

fn name_specs() -> []NameSpec {
    [
        NameSpec { group: "months", container: "months", context: "monthContext", width: "monthWidth", item: "month", widths: 3, count: 12 }
        NameSpec { group: "days", container: "days", context: "dayContext", width: "dayWidth", item: "day", widths: 4, count: 7 }
        NameSpec { group: "quarters", container: "quarters", context: "quarterContext", width: "quarterWidth", item: "quarter", widths: 3, count: 4 }
        NameSpec { group: "day_periods", container: "dayPeriods", context: "dayPeriodContext", width: "dayPeriodWidth", item: "dayPeriod", widths: 3, count: 12 }
    ]
}

fn name_slot(group: str, name: str) -> i64 {
    match group {
        "months" => month_slot(name)
        "days" => weekday_slot(name)
        "quarters" => quarter_slot(name)
        _ => period_slot(name)
    }
}

fn quarter_slot(name: str) -> i64 {
    (text.parse_int(name) or 0) - 1
}

fn put_eras(c: *Collector, calendar: *xml.Element) {
    let eras = pick(calendar, "eras") ?? return
    let containers = ["eraNames", "eraAbbr", "eraNarrow"]
    for i, name in containers {
        for set in xml.children(eras, name) {
            for e in xml.children(set, "era") {
                if xml.attribute(e, "alt") != none {
                    continue
                }
                let t = text.parse_int(emit.attribute_text(e, "type")) or continue
                if t < 0 || t > 1 {
                    continue
                }
                let v = value_text(e) ?? continue
                put_slot(c, "eras", 0, i * 2 + t, v)
            }
        }
    }
}

fn put_formats_of_length(c: *Collector, calendar: *xml.Element, container: str, length: str, format: str, base: i64) {
    let lengths = ["full", "long", "medium", "short"]
    let set = pick(calendar, container) ?? return
    for l in xml.children(set, length) {
        var index = -1
        for i, name in lengths {
            if name == emit.attribute_text(l, "type") {
                index = i
            }
        }
        if index < 0 {
            continue
        }
        for f in xml.children(l, format) {
            let kind = xml.attribute(f, "type")
            if format == "dateTimeFormat" {
                var offset = 0
                if kind == "atTime" {
                    offset = 4
                } else if kind != none && kind != "standard" {
                    continue
                }
                let v = pattern_of(f) ?? continue
                put_slot(c, "date_formats", 0, base + offset + index, v)
                continue
            }
            if kind != none && kind != "standard" {
                continue
            }
            let v = pattern_of(f) ?? continue
            put_slot(c, "date_formats", 0, base + index, v)
        }
    }
}

fn put_available(c: *Collector, calendar: *xml.Element) {
    let formats = walk(calendar, ["dateTimeFormats", "availableFormats"]) ?? return
    var out = builder.builder()
    for item in xml.children(formats, "dateFormatItem") {
        if xml.attribute(item, "alt") != none || xml.attribute(item, "count") != none {
            continue
        }
        let v = value_text(item) ?? continue
        builder.write(mut out, "{emit.attribute_text(item, "id")}\t{v}\n")
    }
    if builder.len(out) > 0 {
        put_slot(c, "date_available", 0, 0, builder.to_str(out))
    }
}

fn put_intervals(c: *Collector, calendar: *xml.Element) {
    let formats = walk(calendar, ["dateTimeFormats", "intervalFormats"]) ?? return
    match plain_value(formats, "intervalFormatFallback", none, none) {
        some(v) => put_slot(c, "date_interval", 0, 0, v)
        none => {}
    }
    var out = builder.builder()
    for item in xml.children(formats, "intervalFormatItem") {
        for d in xml.children(item, "greatestDifference") {
            if xml.attribute(d, "alt") != none {
                continue
            }
            let v = value_text(d) ?? continue
            builder.write(mut out, "{emit.attribute_text(item, "id")}\t{emit.attribute_text(d, "id")}\t{v}\n")
        }
    }
    if builder.len(out) > 0 {
        put_slot(c, "date_interval", 0, 1, builder.to_str(out))
    }
}

fn put_zone_format(c: *Collector, dates: *xml.Element) {
    let zones = pick(dates, "timeZoneNames") ?? return
    let simple = ["gmtFormat", "gmtZeroFormat", "hourFormat", "fallbackFormat"]
    let slots = [0, 1, 2, 6]
    for i, name in simple {
        match first_value(zones, name) {
            some(v) => put_slot(c, "zone_format", 0, slots[i], v)
            none => {}
        }
    }
    for r in xml.children(zones, "regionFormat") {
        let kind = xml.attribute(r, "type")
        var slot = 3
        if kind == "daylight" {
            slot = 4
        } else if kind == "standard" {
            slot = 5
        }
        let v = value_text(r) ?? continue
        put_slot(c, "zone_format", 0, slot, v)
    }
}

fn field_slot(name: str) -> i64 {
    let names = text.fields("second minute hour day week month quarter year")
    for i, n in names {
        if n == name {
            return i
        }
    }
    -1
}

fn put_fields(c: *Collector, dates: *xml.Element) {
    let fields = pick(dates, "fields") ?? return
    for f in xml.children(fields, "field") {
        var name = emit.attribute_text(f, "type")
        var width = 0
        if text.ends_with(name, "-short") {
            name = text.trim_suffix(name, "-short")
            width = 1
        } else if text.ends_with(name, "-narrow") {
            name = text.trim_suffix(name, "-narrow")
            width = 2
        }
        let field = field_slot(name)
        if field < 0 {
            continue
        }
        let group = field * width_count + width
        match first_value(f, "displayName") {
            some(v) => put_slot(c, "relative", group, 0, v)
            none => {}
        }
        for r in xml.children(f, "relative") {
            let n = text.parse_int(emit.attribute_text(r, "type")) or continue
            if n < -2 || n > 2 {
                continue
            }
            let v = value_text(r) ?? continue
            put_slot(c, "relative", group, 3 + n, v)
        }
        for rt in xml.children(f, "relativeTime") {
            let future = emit.attribute_text(rt, "type") == "future"
            for p in xml.children(rt, "relativeTimePattern") {
                let category = category_slot(emit.attribute_text(p, "count"))
                if category < 0 {
                    continue
                }
                let v = value_text(p) ?? continue
                put_slot(c, "relative", group, 6 + (if future { 0 } else { 6 }) + category, v)
            }
        }
    }
}

fn put_dates(c: *Collector, root: *xml.Element) {
    let dates = xml.child(root, "dates") ?? return
    let calendars = pick(dates, "calendars")
    let calendar = pick(calendars, "calendar@gregorian")
    match calendar {
        some(cal) => {
            for spec in name_specs() {
                put_names(c, cal, spec)
            }
            put_eras(c, cal)
            put_formats_of_length(c, cal, "dateFormats", "dateFormatLength", "dateFormat", 0)
            put_formats_of_length(c, cal, "timeFormats", "timeFormatLength", "timeFormat", 4)
            put_formats_of_length(c, cal, "dateTimeFormats", "dateTimeFormatLength", "dateTimeFormat", 8)
            put_available(c, cal)
            put_intervals(c, cal)
        }
        none => {}
    }
    put_zone_format(c, dates)
    put_fields(c, dates)
}

fn list_type_slot(name: str) -> i64 {
    let names = text.fields("standard standard-short standard-narrow or or-short or-narrow unit unit-short unit-narrow")
    for i, n in names {
        if n == name {
            return i
        }
    }
    -1
}

fn list_part_slot(name: str) -> i64 {
    match name {
        "2" => 0
        "start" => 1
        "middle" => 2
        "end" => 3
        _ => -1
    }
}

fn put_lists(c: *Collector, root: *xml.Element) {
    let lists = xml.child(root, "listPatterns") ?? return
    for l in xml.children(lists, "listPattern") {
        let t = list_type_slot(xml.attribute(l, "type") ?? "standard")
        if t < 0 {
            continue
        }
        for p in xml.children(l, "listPatternPart") {
            let part = list_part_slot(emit.attribute_text(p, "type"))
            if part < 0 {
                continue
            }
            let v = value_text(p) ?? continue
            put_slot(c, "lists", 0, t * 4 + part, v)
        }
    }
}

fn collect_locale(c: *Collector, root: *xml.Element) {
    put_numbers(c, root)
    put_dates(c, root)
    put_lists(c, root)
}

fn encode_group(slots: []Slot) -> []u8 {
    var used = slots.len
    for used > 0 && !slots[used - 1].present {
        used -= 1
    }
    var out: []u8 = []
    put_varint(mut out, used)
    for i in 0..used {
        let s = slots[i]
        if !s.present {
            out.push(0)
            continue
        }
        put_varint(mut out, s.text.len + 1)
        text.append(mut out, s.text)
    }
    out
}

fn encode_blob(c: *Collector) -> []u8 {
    var ids: []i64 = []
    for id in c.groups {
        ids.push(id)
    }
    slices.sort(mut ids)
    var bodies: []u8 = []
    var offsets: []i64 = []
    let header = 2 + ids.len * 6
    for id in ids {
        offsets.push(header + bodies.len)
        for b in encode_group(c.groups[id] ?? []) {
            bodies.push(b)
        }
    }
    var out: []u8 = []
    append_u16(mut out, ids.len)
    for i, id in ids {
        append_u16(mut out, id)
        append_u32(mut out, offsets[i])
    }
    for b in bodies {
        out.push(b)
    }
    out
}
