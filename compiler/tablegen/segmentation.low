import std/slices
import std/text

const word_shift = 5
const sentence_shift = 5
const line_shift = 5
const word_class_mask = 31
const sentence_class_mask = 15
const line_class_mask = 63
const word_pictographic_shift = 5
const line_wide_shift = 6
const line_extended_shift = 7
const line_initial_shift = 8
const line_final_shift = 9
const line_record_size = 2

const general_unassigned = 0
const general_mark = 1
const general_initial = 2
const general_final = 3
const general_assigned = 4

pub const segmentation_layout_file = "segmentation_layout.low"

pub fn segmentation_tables() -> []str {
    [
        "word_index.bin", "word_blocks.bin", "word_records.bin"
        "sentence_index.bin", "sentence_blocks.bin", "sentence_records.bin"
        "line_index.bin", "line_blocks.bin", "line_records.bin"
    ]
}

fn word_names() -> []str {
    [
        "Other", "CR", "LF", "Newline", "Extend", "ZWJ", "Regional_Indicator", "Format", "Katakana"
        "Hebrew_Letter", "ALetter", "Single_Quote", "Double_Quote", "MidNumLet", "MidLetter", "MidNum"
        "Numeric", "ExtendNumLet", "WSegSpace"
    ]
}

fn sentence_names() -> []str {
    [
        "Other", "CR", "LF", "Extend", "Sep", "Format", "Sp", "Lower", "Upper", "OLetter", "Numeric"
        "ATerm", "SContinue", "STerm", "Close"
    ]
}

fn line_names() -> []str {
    [
        "AL", "AK", "AP", "AS", "B2", "BA", "BB", "BK", "CB", "CL", "CM", "CP", "CR", "EB", "EM", "EX"
        "GL", "H2", "H3", "HH", "HL", "HY", "ID", "IN", "IS", "JL", "JT", "JV", "LF", "NL", "NS", "NU"
        "OP", "PO", "PR", "QU", "RI", "SP", "SY", "VF", "VI", "WJ", "ZW", "ZWJ"
    ]
}

fn line_source_names() -> []str {
    var names = slices.clone(line_names())
    for name in ["AI", "SG", "XX", "SA", "CJ"] {
        names.push(name)
    }
    names
}

struct Segmentation {
    range_start: i64
    word: []u8
    sentence: []u8
    line: []u8
    general: []u8
    wide: []bool
    pictographic: []bool
}

fn filled(value: i64) -> []u8 {
    var out: []u8 = []
    for i in 0..code_points {
        out.push(u8(value))
    }
    out
}

fn generate_segmentation(dir: str, output: str) ! Error {
    var flags: []bool = []
    for i in 0..code_points {
        flags.push(false)
    }
    let unknown_line = index_of(line_source_names(), "XX")?
    let db = new(Segmentation {
        range_start: 0
        word: filled(0)
        sentence: filled(0)
        line: filled(unknown_line)
        general: filled(general_unassigned)
        wide: slices.clone(flags)
        pictographic: slices.clone(flags)
    })
    each_line("{dir}/UnicodeData.txt", fn(fields: []str) ! Error { read_general(db, fields)? })?
    each_range("{dir}/WordBreakProperty.txt", fn(first: i64, last: i64, fields: []str) ! Error { read_word_class(db, first, last, fields)? })?
    each_range("{dir}/SentenceBreakProperty.txt", fn(first: i64, last: i64, fields: []str) ! Error { read_sentence_class(db, first, last, fields)? })?
    each_range("{dir}/LineBreak.txt", fn(first: i64, last: i64, fields: []str) ! Error { read_line_class(db, first, last, fields)? })?
    each_range("{dir}/EastAsianWidth.txt", fn(first: i64, last: i64, fields: []str) ! Error { read_wide(db, first, last, fields)? })?
    each_range("{dir}/emoji-data.txt", fn(first: i64, last: i64, fields: []str) ! Error { read_extended(db, first, last, fields)? })?
    let sections = segmentation_sections(db)?
    write_sections(output, sections)?
}

fn assign(mut values: []u8, first: i64, last: i64, value: i64) {
    for c in first..last + 1 {
        values[c] = u8(value)
    }
}

fn general_class(category: str) -> i64 {
    match category {
        == "Mn" => general_mark
        == "Mc" => general_mark
        == "Pi" => general_initial
        == "Pf" => general_final
        _ => general_assigned
    }
}

fn read_general(db: *Segmentation, fields: []str) ! Error {
    if fields.len < 3 {
        fail Failed("short UnicodeData line {fields}")
    }
    let code = parse_code(fields[0])?
    var first = code
    if text.ends_with(fields[1], "First>") {
        db.range_start = code
        return
    }
    if text.ends_with(fields[1], "Last>") {
        first = db.range_start
    }
    assign(mut db.general, first, code, general_class(fields[2]))
}

fn read_word_class(db: *Segmentation, first: i64, last: i64, fields: []str) ! Error {
    let class = index_of(word_names(), fields[0])?
    assign(mut db.word, first, last, class)
}

fn read_sentence_class(db: *Segmentation, first: i64, last: i64, fields: []str) ! Error {
    let class = index_of(sentence_names(), fields[0])?
    assign(mut db.sentence, first, last, class)
}

fn read_line_class(db: *Segmentation, first: i64, last: i64, fields: []str) ! Error {
    let class = index_of(line_source_names(), fields[0])?
    assign(mut db.line, first, last, class)
}

fn read_wide(db: *Segmentation, first: i64, last: i64, fields: []str) ! Error {
    let width = fields[0]
    if width != "F" && width != "W" && width != "H" {
        return
    }
    for c in first..last + 1 {
        db.wide[c] = true
    }
}

fn read_extended(db: *Segmentation, first: i64, last: i64, fields: []str) ! Error {
    if fields[0] != "Extended_Pictographic" {
        return
    }
    for c in first..last + 1 {
        db.pictographic[c] = true
    }
}

fn line_resolution(mark: bool) -> []i64 ! Error {
    var resolved: []i64 = []
    for name in line_source_names() {
        let target = match name {
            == "AI" => "AL"
            == "SG" => "AL"
            == "XX" => "AL"
            == "SA" => if mark { "CM" } else { "AL" }
            == "CJ" => "NS"
            _ => name
        }
        resolved.push(index_of(line_names(), target)?)
    }
    resolved
}

fn word_record(db: *Segmentation, c: i64) -> u32 {
    var record = u32(db.word[c])
    if db.pictographic[c] {
        record |= 1 << word_pictographic_shift
    }
    record
}

fn line_record(db: *Segmentation, c: i64, marks: []i64, others: []i64, quotation: i64) -> u32 {
    let general = i64(db.general[c])
    let source = i64(db.line[c])
    let class = if general == general_mark { marks[source] } else { others[source] }
    var record = u32(class)
    if db.wide[c] {
        record |= 1 << line_wide_shift
    }
    if db.pictographic[c] && general == general_unassigned {
        record |= 1 << line_extended_shift
    }
    if class == quotation && general == general_initial {
        record |= 1 << line_initial_shift
    }
    if class == quotation && general == general_final {
        record |= 1 << line_final_shift
    }
    record
}

fn byte_record(v: u32) -> []u8 {
    [u8(v)]
}

fn short_record(v: u32) -> []u8 {
    var out: []u8 = []
    append_u16(mut out, i64(v))
    out
}

fn value_key(v: u32) -> str {
    "{v}"
}

fn segmentation_sections(db: *Segmentation) -> []Section ! Error {
    var words: []u32 = []
    var sentences: []u32 = []
    var lines: []u32 = []
    let marks = line_resolution(true)?
    let others = line_resolution(false)?
    let quotation = index_of(line_names(), "QU")?
    for c in 0..code_points {
        words.push(word_record(db, c))
        sentences.push(u32(db.sentence[c]))
        lines.push(line_record(db, c, marks, others, quotation))
    }
    let word = build_record_trie(words, word_shift, u32(0), value_key, byte_record)?
    let sentence = build_record_trie(sentences, sentence_shift, u32(0), value_key, byte_record)?
    let line = build_record_trie(lines, line_shift, u32(0), value_key, short_record)?
    var sections = named_sections(segmentation_tables(), [
        word.index, word.blocks, word.records
        sentence.index, sentence.blocks, sentence.records
        line.index, line.blocks, line.records
    ])
    let layout = bytes(segmentation_layout_source())
    sections.push(Section { name: segmentation_layout_file, data: layout })
    sections
}

pub fn segmentation_layout_source() -> str {
    var constants = [
        low_constant("word_block_shift", word_shift, LowType.Int)
        low_constant("word_block_mask", (1 << word_shift) - 1, LowType.Word)
        low_constant("word_class_mask", word_class_mask, LowType.Word)
        low_constant("word_pictographic_shift", word_pictographic_shift, LowType.Int)
        low_constant("sentence_block_shift", sentence_shift, LowType.Int)
        low_constant("sentence_block_mask", (1 << sentence_shift) - 1, LowType.Word)
        low_constant("sentence_class_mask", sentence_class_mask, LowType.Word)
        low_constant("line_block_shift", line_shift, LowType.Int)
        low_constant("line_block_mask", (1 << line_shift) - 1, LowType.Word)
        low_constant("line_class_mask", line_class_mask, LowType.Word)
        low_constant("line_record_size", line_record_size, LowType.Int)
        low_constant("line_wide_shift", line_wide_shift, LowType.Int)
        low_constant("line_extended_shift", line_extended_shift, LowType.Int)
        low_constant("line_initial_shift", line_initial_shift, LowType.Int)
        low_constant("line_final_shift", line_final_shift, LowType.Int)
    ]
    for c in class_constants("word_", word_names(), LowType.Int) {
        constants.push(c)
    }
    for c in class_constants("sentence_", sentence_names(), LowType.Int) {
        constants.push(c)
    }
    for c in class_constants("line_", line_names(), LowType.Int) {
        constants.push(c)
    }
    layout_source(constants, segmentation_tables())
}
