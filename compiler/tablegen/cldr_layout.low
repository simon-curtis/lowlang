import emit
import std/text

pub const locale_layout_file = "layout.low"

struct GroupSpec {
    name: str
    size: i64
    count: i64
}

const field_count = 8
const width_count = 3

fn group_specs(numbering_systems: i64, currencies: i64) -> []GroupSpec {
    [
        GroupSpec { name: "numbering", size: 16, count: 1 }
        GroupSpec { name: "symbols", size: 15, count: numbering_systems }
        GroupSpec { name: "formats", size: 10, count: numbering_systems }
        GroupSpec { name: "compact_short", size: 102, count: numbering_systems }
        GroupSpec { name: "compact_long", size: 102, count: numbering_systems }
        GroupSpec { name: "compact_currency", size: 102, count: numbering_systems }
        GroupSpec { name: "currency", size: 9, count: currencies }
        GroupSpec { name: "months", size: 72, count: 1 }
        GroupSpec { name: "days", size: 56, count: 1 }
        GroupSpec { name: "quarters", size: 24, count: 1 }
        GroupSpec { name: "day_periods", size: 72, count: 1 }
        GroupSpec { name: "eras", size: 6, count: 1 }
        GroupSpec { name: "date_formats", size: 16, count: 1 }
        GroupSpec { name: "date_available", size: 1, count: 1 }
        GroupSpec { name: "date_interval", size: 2, count: 1 }
        GroupSpec { name: "zone_format", size: 8, count: 1 }
        GroupSpec { name: "relative", size: 18, count: field_count * width_count }
        GroupSpec { name: "lists", size: 36, count: 1 }
    ]
}

fn group_base(specs: []GroupSpec, name: str) -> i64 {
    var base = 0
    for s in specs {
        if s.name == name {
            return base
        }
        base += s.count
    }
    -1
}

fn group_size(specs: []GroupSpec, name: str) -> i64 {
    for s in specs {
        if s.name == name {
            return s.size
        }
    }
    -1
}

pub fn locale_tables() -> []str {
    [
        "locales.txt", "likely.txt", "alias.txt", "parents.txt", "week.txt", "numsys.txt", "currency.txt", "dayperiod.txt",
        "plural_cardinal.bin", "plural_ordinal.bin", "plural_range.bin",
        "collate_root.bin", "collate_han.bin", "collate_scripts.bin", "collate_ccc.bin", "collate_rules.txt"
    ]
}

pub fn locale_layout_source(numbering_systems: i64, currencies: i64) -> str {
    let specs = group_specs(numbering_systems, currencies)
    var out = emit.lines()
    var base = 0
    for s in specs {
        emit.line(mut out, "/// The group number of the first `{s.name}` group.")
        emit.line(mut out, "pub const group_{s.name} = {base}")
        base += s.count
    }
    emit.line(mut out, "/// The number of numbering systems in `numsys.txt`.")
    emit.line(mut out, "pub const numbering_system_count = {numbering_systems}")
    emit.line(mut out, "/// The number of currency codes in `currency.txt`.")
    emit.line(mut out, "pub const currency_code_count = {currencies}")
    emit.line(mut out, "")
    for table in locale_tables() {
        let name = text.replace(text.trim_suffix(text.trim_suffix(table, ".bin"), ".txt"), "-", "_")
        emit.line(mut out, "/// Returns the contents of `{table}`.")
        emit.line(mut out, "pub fn {name}_table() -> str {{ embed({text.quote(table)}) }}")
    }
    emit.string(out)
}
