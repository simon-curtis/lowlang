import emit
import std/file
import std/os
import std/text

pub enum Error {
    Usage
    Failed(message: str)
}

struct Command {
    name: str
    arguments: str
    run: fn([]str) ! Error
}

fn commands() -> []Command {
    [
        Command { name: "unicode", arguments: "<ucd directory> <output directory>", run: source_and_output(generate_unicode) }
        Command { name: "properties", arguments: "<ucd directory> <output directory>", run: source_and_output(generate_properties) }
        Command { name: "charset", arguments: "<index directory> <output directory>", run: source_and_output(generate_charset) }
        Command { name: "entities", arguments: "<entities.json> <output directory>", run: source_and_output(generate_entities) }
        Command { name: "pow10", arguments: "<output directory>", run: output_only(generate_pow10) }
        Command { name: "tzdata", arguments: "<zoneinfo directory with tzdata.zi> <output directory>", run: source_and_output(generate_tzdata) }
    ]
}

fn source_and_output(generate: fn(str, str) ! Error) -> fn([]str) ! Error {
    fn(paths: []str) ! Error {
        generate(paths[0], paths[1])?
    }
}

fn output_only(generate: fn(str) ! Error) -> fn([]str) ! Error {
    fn(paths: []str) ! Error {
        generate(paths[0])?
    }
}

fn parameters(c: Command) -> i64 {
    text.fields(c.arguments).len
}

fn main() {
    run(os.args()[1..]) catch {
        Usage => {
            emit.eprint(usage_text())
            os.exit(2)
        }
        Failed(message) => {
            emit.eprint("tablegen: {message}")
            os.exit(1)
        }
    }
}

fn usage_text() -> str {
    var lines: []str = []
    for i, c in commands() {
        let prefix = if i == 0 { "usage:" } else { "       " }
        push(mut lines, "{prefix} tablegen {c.name} {c.arguments}")
    }
    text.join(lines, "\n")
}

fn run(arguments: []str) ! Error {
    if arguments.len == 0 {
        fail Usage
    }
    for c in commands() {
        if c.name != arguments[0] {
            continue
        }
        if arguments.len - 1 != parameters(c) {
            fail Usage
        }
        c.run(arguments[1..])?
        return
    }
    fail Failed("unknown command {text.quote(arguments[0])}")
}

pub struct Section {
    pub name: str
    pub data: []u8
}

fn write_sections(dir: str, sections: []Section) ! Error {
    for s in sections {
        let path = "{dir}/{s.name}"
        file.write_file_mode(path, s.data, 0o644) catch {
            e => fail Failed("open {path}: {emit.io_message(e)}")
        }
        print("{s.name}: {s.data.len} bytes")
    }
}

fn read_source(path: str) -> str ! Error {
    file.read_text(path) catch {
        e => fail Failed("open {path}: {emit.io_message(e)}")
    }
}

fn path_base(path: str) -> str {
    let cut = text.last_cut(path, "/")
    if cut.found { cut.after } else { path }
}

fn zeros(n: i64) -> []u8 {
    var out: []u8 = []
    for i in 0..n {
        push(mut out, 0)
    }
    out
}

fn put_u16(mut out: []u8, at: i64, v: i64) {
    out[at] = u8(v)
    out[at + 1] = u8(v >> 8)
}

fn put_u32(mut out: []u8, at: i64, v: i64) {
    out[at] = u8(v)
    out[at + 1] = u8(v >> 8)
    out[at + 2] = u8(v >> 16)
    out[at + 3] = u8(v >> 24)
}

fn append_u16(mut out: []u8, v: i64) {
    push(mut out, u8(v))
    push(mut out, u8(v >> 8))
}

fn append_u32(mut out: []u8, v: i64) {
    push(mut out, u8(v))
    push(mut out, u8(v >> 8))
    push(mut out, u8(v >> 16))
    push(mut out, u8(v >> 24))
}
