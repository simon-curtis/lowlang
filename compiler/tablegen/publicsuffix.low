import std/slices
import std/text

const suffix_label_offset = 0
const suffix_label_length_offset = suffix_label_offset + word_size
const suffix_flags_offset = suffix_label_length_offset + 1
const suffix_first_child_offset = suffix_flags_offset + 1
const suffix_child_count_offset = suffix_first_child_offset + u16_width
const suffix_node_size = suffix_child_count_offset + u16_width
const suffix_rule_flag = 1
const suffix_wildcard_flag = 2
const suffix_exception_flag = 4
const suffix_private_shift = 3
const suffix_max_nodes = 0xFFFF

pub const suffix_layout_file = "suffix_layout.low"

pub fn suffix_tables() -> []str {
    ["suffix_nodes.bin", "suffix_labels.bin", "suffix_version.bin"]
}

struct SuffixNode {
    label: str
    flags: i64
    children: [str: i64]
}

struct SuffixTrie {
    nodes: []SuffixNode
    version: str
    commit: str
}

struct SuffixSection {
    private: bool
}

fn new_suffix_node(label: str) -> SuffixNode {
    SuffixNode { label, flags: 0, children: [:] }
}

fn generate_publicsuffix(source: str, output: str) ! Error {
    let data = read_source(source)?
    let trie = suffix_trie(data)?
    var node_bytes: []u8 = []
    let labels = new(TextPool { data: [], offsets: [:] })
    var order: []i64 = [0]
    var at = 0
    for at < order.len {
        let node = trie.nodes[order[at]]
        let first = order.len
        var names: []str = []
        for name, id in node.children {
            names.push(name)
        }
        slices.sort(mut names)
        for name in names {
            order.push(node.children[name] ?? 0)
        }
        if order.len > suffix_max_nodes {
            fail Failed("the list has more than {suffix_max_nodes} nodes")
        }
        let label_at = pool_text(labels, node.label)?
        append_u32(mut node_bytes, label_at)
        node_bytes.push(u8(node.label.len))
        node_bytes.push(u8(node.flags))
        append_u16(mut node_bytes, first)
        append_u16(mut node_bytes, names.len)
        at += 1
    }
    let version = bytes("{trie.version}\n{trie.commit}")
    var sections = named_sections(suffix_tables(), [node_bytes, labels.data, version])
    sections.push(Section { name: suffix_layout_file, data: bytes(suffix_layout_source()) })
    write_sections(output, sections)?
}

fn suffix_trie(data: str) -> SuffixTrie ! Error {
    var trie = SuffixTrie { nodes: [new_suffix_node("")], version: "", commit: "" }
    var section = ""
    var rules = 0
    for raw in text.lines(data) {
        let line = text.trim(raw)
        if line == "" {
            continue
        }
        if text.starts_with(line, "//") {
            let comment = text.trim(text.trim_prefix(line, "//"))
            match comment {
                == "===BEGIN ICANN DOMAINS===" => {
                    section = "icann"
                }
                == "===BEGIN PRIVATE DOMAINS===" => {
                    section = "private"
                }
                == "===END ICANN DOMAINS===" || == "===END PRIVATE DOMAINS===" => {
                    section = ""
                }
                _ => {}
            }
            if text.starts_with(comment, "VERSION:") {
                trie.version = text.trim(text.trim_prefix(comment, "VERSION:"))
            }
            if text.starts_with(comment, "COMMIT:") {
                trie.commit = text.trim(text.trim_prefix(comment, "COMMIT:"))
            }
            continue
        }
        if section == "" {
            fail Failed("rule {text.quote(line)} is outside the ICANN and private sections")
        }
        add_suffix_rule(mut trie, text.fields(line)[0], section == "private")?
        rules += 1
    }
    if rules == 0 || trie.version == "" || trie.commit == "" {
        fail Failed("the list has no rules, or no VERSION or COMMIT line")
    }
    trie
}

fn add_suffix_rule(mut trie: SuffixTrie, rule: str, private: bool) ! Error {
    var name = rule
    var flag = suffix_rule_flag
    if text.starts_with(name, "!") {
        name = text.trim_prefix(name, "!")
        flag = suffix_exception_flag
    } else if text.starts_with(name, "*.") {
        name = text.trim_prefix(name, "*.")
        flag = suffix_wildcard_flag
    }
    var node = 0
    let labels = text.split(name, '.')
    var i = labels.len
    for i > 0 {
        i -= 1
        let label = labels[i]
        if label == "" || label.len > 0xFF || text.contains(label, "*") || text.contains(label, "!") || text.lower(label) != label {
            fail Failed("rule {text.quote(rule)} is not valid")
        }
        match trie.nodes[node].children[label] {
            some(child) => {
                node = child
            }
            none => {
                trie.nodes.push(new_suffix_node(label))
                let child = trie.nodes.len - 1
                trie.nodes[node].children[label] = child
                node = child
            }
        }
    }
    trie.nodes[node].flags |= flag
    if private {
        trie.nodes[node].flags |= flag << suffix_private_shift
    }
}

pub fn suffix_layout_source() -> str {
    let constants = [
        low_constant("node_size", suffix_node_size, LowType.Int)
        low_constant("node_label_offset", suffix_label_offset, LowType.Int)
        low_constant("node_label_length_offset", suffix_label_length_offset, LowType.Int)
        low_constant("node_flags_offset", suffix_flags_offset, LowType.Int)
        low_constant("node_first_child_offset", suffix_first_child_offset, LowType.Int)
        low_constant("node_child_count_offset", suffix_child_count_offset, LowType.Int)
        low_constant("rule_flag", suffix_rule_flag, LowType.Int)
        low_constant("wildcard_flag", suffix_wildcard_flag, LowType.Int)
        low_constant("exception_flag", suffix_exception_flag, LowType.Int)
        low_constant("private_shift", suffix_private_shift, LowType.Int)
    ]
    layout_source(constants, suffix_tables())
}
