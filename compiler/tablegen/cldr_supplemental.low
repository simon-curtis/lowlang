import emit
import std/builder
import std/file
import std/slices
import std/text
import std/xml

fn load_xml(path: str) -> *xml.Element ! Error {
    let data = file.read_file(path) catch {
        e => fail Failed("open {path}: {emit.io_message(e)}")
    }
    xml.parse(data) catch {
        e => fail Failed("{path}: {emit.xml_message(e)}")
    }
}

fn tag_key(s: str) -> str {
    text.replace(s, "_", "-")
}

fn sorted_lines(lines: []str) -> str {
    var copy = slices.clone(lines)
    slices.sort(mut copy)
    var out = builder.builder()
    for line in copy {
        builder.write(mut out, line)
        builder.write_byte(mut out, '\n')
    }
    builder.to_str(out)
}

fn likely_section(common: str) -> Section ! Error {
    let root = load_xml(file.child_path(common, "supplemental/likelySubtags.xml"))?
    var lines: []str = []
    for set in xml.children(root, "likelySubtags") {
        for e in xml.children(set, "likelySubtag") {
            let from = tag_key(emit.attribute_text(e, "from"))
            let to = tag_key(emit.attribute_text(e, "to"))
            lines.push("{from} {to}")
        }
    }
    Section { name: "likely.txt", data: bytes(sorted_lines(lines)) }
}

fn alias_lines(root: *xml.Element, element: str, kind: str, mut lines: []str) {
    for meta in xml.children(root, "metadata") {
        for group in xml.children(meta, "alias") {
            for e in xml.children(group, element) {
                let replacement = emit.attribute_text(e, "replacement")
                if replacement == "" {
                    continue
                }
                let from = tag_key(emit.attribute_text(e, "type"))
                let to = text.join(text.fields(tag_key(replacement)), ",")
                lines.push("{kind}:{from} {to}")
            }
        }
    }
}

fn alias_section(common: str) -> Section ! Error {
    let root = load_xml(file.child_path(common, "supplemental/supplementalMetadata.xml"))?
    var lines: []str = []
    alias_lines(root, "languageAlias", "l", mut lines)
    alias_lines(root, "scriptAlias", "s", mut lines)
    alias_lines(root, "territoryAlias", "t", mut lines)
    alias_lines(root, "variantAlias", "v", mut lines)
    Section { name: "alias.txt", data: bytes(sorted_lines(lines)) }
}

fn parent_section(common: str) -> Section ! Error {
    let root = load_xml(file.child_path(common, "supplemental/supplementalData.xml"))?
    var lines: []str = []
    for set in xml.children(root, "parentLocales") {
        for p in xml.children(set, "parentLocale") {
            let parent = tag_key(emit.attribute_text(p, "parent"))
            for child in text.fields(emit.attribute_text(p, "locales")) {
                lines.push("{tag_key(child)} {parent}")
            }
        }
    }
    Section { name: "parents.txt", data: bytes(sorted_lines(lines)) }
}

fn week_lines(root: *xml.Element, mut lines: []str) {
    for data in xml.children(root, "weekData") {
        for e in xml.children(data, "minDays") {
            for t in text.fields(emit.attribute_text(e, "territories")) {
                lines.push("m:{t} {emit.attribute_text(e, "count")}")
            }
        }
        for e in xml.children(data, "firstDay") {
            if xml.attribute(e, "alt") != none {
                continue
            }
            for t in text.fields(emit.attribute_text(e, "territories")) {
                lines.push("f:{t} {emit.attribute_text(e, "day")}")
            }
        }
        for e in xml.children(data, "weekendStart") {
            if xml.attribute(e, "alt") != none {
                continue
            }
            for t in text.fields(emit.attribute_text(e, "territories")) {
                lines.push("s:{t} {emit.attribute_text(e, "day")}")
            }
        }
        for e in xml.children(data, "weekendEnd") {
            if xml.attribute(e, "alt") != none {
                continue
            }
            for t in text.fields(emit.attribute_text(e, "territories")) {
                lines.push("e:{t} {emit.attribute_text(e, "day")}")
            }
        }
    }
    for data in xml.children(root, "timeData") {
        for e in xml.children(data, "hours") {
            let allowed = text.join(text.fields(emit.attribute_text(e, "allowed")), ",")
            for r in text.fields(emit.attribute_text(e, "regions")) {
                lines.push("h:{tag_key(r)} {emit.attribute_text(e, "preferred")} {allowed}")
            }
        }
    }
}

fn week_section(common: str) -> Section ! Error {
    let root = load_xml(file.child_path(common, "supplemental/supplementalData.xml"))?
    var lines: []str = []
    week_lines(root, mut lines)
    Section { name: "week.txt", data: bytes(sorted_lines(lines)) }
}

fn numbering_section(common: str) -> Section ! Error {
    let root = load_xml(file.child_path(common, "supplemental/numberingSystems.xml"))?
    var lines: []str = []
    for set in xml.children(root, "numberingSystems") {
        for e in xml.children(set, "numberingSystem") {
            if emit.attribute_text(e, "type") != "numeric" {
                continue
            }
            lines.push("{emit.attribute_text(e, "id")} {emit.attribute_text(e, "digits")}")
        }
    }
    slices.sort(mut lines)
    var out = builder.builder()
    for i, line in lines {
        let cut = text.cut(line, " ")
        builder.write(mut out, "{cut.before} {i} {cut.after}\n")
    }
    Section { name: "numsys.txt", data: bytes(builder.to_str(out)) }
}

fn numbering_ids(section: Section) -> []str {
    var ids: []str = []
    for line in text.lines(str(section.data)) {
        ids.push(text.fields(line)[0])
    }
    ids
}

struct Fraction {
    digits: str
    rounding: str
    cash_digits: str
    cash_rounding: str
}

fn currency_codes_of(root: *xml.Element) -> []str {
    var codes: []str = []
    for numbers in xml.children(root, "numbers") {
        for set in xml.children(numbers, "currencies") {
            for c in xml.children(set, "currency") {
                codes.push(emit.attribute_text(c, "type"))
            }
        }
    }
    codes
}

fn currency_section(common: str) -> Section ! Error {
    let root = load_xml(file.child_path(common, "supplemental/supplementalData.xml"))?
    let fractions: [str: Fraction] = [:]
    for data in xml.children(root, "currencyData") {
        for set in xml.children(data, "fractions") {
            for e in xml.children(set, "info") {
                let digits = emit.attribute_text(e, "digits")
                let rounding = emit.attribute_text(e, "rounding")
                fractions[emit.attribute_text(e, "iso4217")] = Fraction {
                    digits,
                    rounding,
                    cash_digits: xml.attribute(e, "cashDigits") ?? digits,
                    cash_rounding: xml.attribute(e, "cashRounding") ?? rounding
                }
            }
        }
    }
    let en = load_xml(file.child_path(common, "main/en.xml"))?
    var codes = currency_codes_of(en)
    for code in fractions {
        if code != "DEFAULT" && !slices.contains(codes, code) {
            codes.push(code)
        }
    }
    slices.sort(mut codes)
    let fallback = fractions["DEFAULT"] ?? Fraction { digits: "2", rounding: "0", cash_digits: "2", cash_rounding: "0" }
    var out = builder.builder()
    for i, code in codes {
        let f = fractions[code] ?? fallback
        builder.write(mut out, "{code} {i} {f.digits} {f.rounding} {f.cash_digits} {f.cash_rounding}\n")
    }
    Section { name: "currency.txt", data: bytes(builder.to_str(out)) }
}

fn clock_minutes(s: str) -> i64 {
    let cut = text.cut(s, ":")
    (text.parse_int(cut.before) or 0) * 60 + (text.parse_int(cut.after) or 0)
}

fn day_period_section(common: str) -> Section ! Error {
    let root = load_xml(file.child_path(common, "supplemental/dayPeriods.xml"))?
    var lines: []str = []
    for set in xml.children(root, "dayPeriodRuleSet") {
        if xml.attribute(set, "type") != none {
            continue
        }
        for g in xml.children(set, "dayPeriodRules") {
            let locales = text.fields(emit.attribute_text(g, "locales"))
            for locale in locales {
                for rule in xml.children(g, "dayPeriodRule") {
                    let at = xml.attribute(rule, "at")
                    var from = 0
                    var before = 0
                    match at {
                        some(v) => {
                            from = clock_minutes(v)
                            before = from
                        }
                        none => {
                            from = clock_minutes(emit.attribute_text(rule, "from"))
                            before = clock_minutes(emit.attribute_text(rule, "before"))
                        }
                    }
                    let order = lines.len
                    lines.push("{tag_key(locale)} {text.pad_left("{order}", 6, '0')} {emit.attribute_text(rule, "type")} {from} {before}")
                }
            }
        }
    }
    var cleaned: []str = []
    for line in sorted_lines(lines) |> text.lines() {
        let f = text.fields(line)
        cleaned.push("{f[0]} {f[2]} {f[3]} {f[4]}")
    }
    var out = builder.builder()
    for line in cleaned {
        builder.write(mut out, line)
        builder.write_byte(mut out, '\n')
    }
    Section { name: "dayperiod.txt", data: bytes(builder.to_str(out)) }
}
