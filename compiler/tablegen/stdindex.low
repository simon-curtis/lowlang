import diag
import emit
import lint
import parser
import std/builder
import std/file
import std/text

const std_index_file = "std_index.low"

fn generate_std_index(std_dir: str, output: str) ! Error {
    let source = std_index_source(std_dir)?
    write_sections(output, [Section { name: std_index_file, data: bytes(source) }])?
}

pub fn std_index_source(std_dir: str) -> str ! Error {
    var entries: []lint.StdFunction = []
    let sources = std_sources(std_dir)?
    for path in sources {
        let below = text.trim_prefix(directory_of(path), std_dir)
        index_file(mut entries, path, "std{below}")?
    }
    var b = builder.builder()
    b.write("fn std_functions() -> []StdFunction {{\n    [\n")
    for entry in entries {
        b.write("        {entry_literal(entry)}\n")
    }
    b.write("    ]\n}}\n")
    b.to_str()
}

fn std_sources(std_dir: str) -> []str ! Error {
    var paths: []str = []
    file.walk(std_dir, fn(v: file.Visit) -> file.Step {
        if v.dir {
            return if v.name == "examples" { file.Step.Skip } else { file.Step.Continue }
        }
        if text.ends_with(v.name, ".low") && !text.ends_with(v.name, "_test.low") {
            paths.push(v.path)
        }
        file.Step.Continue
    }) catch {
        e => fail Failed("walk {std_dir}: {emit.io_message(e)}")
    }
    paths
}

fn directory_of(path: str) -> str {
    let cut = text.last_cut(path, "/")
    if cut.found { cut.before } else { "" }
}

fn index_file(mut entries: []lint.StdFunction, path: str, module: str) ! Error {
    let source = read_source(path)?
    let parsed = parser.parse_source(source, diag.start(path), true) catch {
        e => fail Failed("parse {path}: {diag.message(e)}")
    }
    for f in parsed.funcs {
        if !f.exported {
            continue
        }
        let s = lint.shape_of(f) ?? continue
        if !indexable(s) {
            continue
        }
        entries.push(lint.StdFunction { path: module, name: f.name, params: s.params, result: s.result, body: s.body })
    }
}

fn indexable(s: lint.Shape) -> bool {
    for t in s.params {
        if !plain_type(t) {
            return false
        }
    }
    plain_type(s.result)
}

fn plain_type(t: str) -> bool {
    match t {
        "i64" => true
        "i32" => true
        "u64" => true
        "u32" => true
        "u16" => true
        "u8" => true
        "f64" => true
        "f32" => true
        "bool" => true
        "str" => true
        _ => t.len > 1 && t[0] == 'T' && text.is_digits(t[1..])
    }
}

fn entry_literal(entry: lint.StdFunction) -> str {
    var params: []str = []
    for p in entry.params {
        params.push(literal(p))
    }
    "StdFunction {{ path: {literal(entry.path)}, name: {literal(entry.name)}, params: [{text.join(params, ", ")}], result: {literal(entry.result)}, body: {literal(entry.body)} }}"
}

fn literal(s: str) -> str {
    let quoted = diag.quote(s)
    let opened = text.replace(quoted, "{{", "{{{{")
    text.replace(opened, "}}", "}}}}")
}
