import emit
import std/builder
import std/file
import std/process
import std/slices
import std/text

const tzdata_source = "tzdata.zi"
const version_tag = "# version "

fn generate_tzdata(source: str, output: str) ! Error {
    let input = file.child_path(source, tzdata_source)
    let version = tzdata_version(input)?
    let compiled = file.temp_dir("tzdata") catch {
        e => fail Failed("{emit.io_message(e)}")
    }
    defer file.remove_all(compiled) or {}
    let command = process.command("zic", ["-b", "slim", "-d", compiled, input])
    let result = process.run(command, []) catch {
        NotFound => fail Failed("zic: exec: \"zic\": executable file not found in $PATH")
        e => fail Failed("zic: {emit.io_message(e)}")
    }
    if !process.success(result.status) {
        fail Failed("zic: {describe_exit(result.status)}\n{str(result.stdout)}{str(result.stderr)}")
    }
    let files: [str: str] = [:]
    read_zones(compiled, "", files)?
    let packed = pack_zones(files)
    write_sections(output, [
        Section { name: "index.txt", data: packed.index }
        Section { name: "zones.bin", data: packed.data }
        Section { name: "version.txt", data: bytes("{version}\n") }
    ])?
}

fn describe_exit(status: process.Exit) -> str {
    match status {
        Exited(code) => "exit status {code}"
        Signaled(signal) => "signal: {signal}"
    }
}

fn tzdata_version(path: str) -> str ! Error {
    let data = read_source(path)?
    for line in text.lines(data) {
        let version = text.strip_prefix(line, version_tag) ?? continue
        return text.trim(version)
    }
    fail Failed("{path} has no version line")
}

fn read_zones(root: str, relative: str, files: [str: str]) ! Error {
    let dir = if relative == "" { root } else { file.child_path(root, relative) }
    let entries = file.read_dir_info(dir) catch {
        e => fail Failed("open {dir}: {emit.io_message(e)}")
    }
    for entry in entries {
        let name = if relative == "" { entry.name } else { "{relative}/{entry.name}" }
        if entry.dir {
            read_zones(root, name, files)?
            continue
        }
        let path = file.child_path(root, name)
        let raw = file.read_file(path) catch {
            e => fail Failed("open {path}: {emit.io_message(e)}")
        }
        let data = str(raw)
        if text.starts_with(data, "TZif") {
            files[name] = data
        }
    }
}

struct Span {
    offset: i64
    length: i64
}

struct Packed {
    index: []u8
    data: []u8
}

fn pack_zones(files: [str: str]) -> Packed {
    var names: []str = []
    for name in files {
        push(mut names, name)
    }
    slices.sort(mut names)
    let placed: [str: Span] = [:]
    var data = builder.builder()
    var index = builder.builder()
    builder.write_byte(mut index, '\n')
    for name in names {
        let body = files[name] ?? ""
        var at = placed[body] ?? Span { offset: -1, length: 0 }
        if at.offset < 0 {
            at = Span { offset: builder.len(data), length: body.len }
            placed[body] = at
            builder.write(mut data, body)
        }
        builder.write(mut index, "{name} {at.offset} {at.length}\n")
    }
    Packed { index: builder.to_bytes(index), data: builder.to_bytes(data) }
}
