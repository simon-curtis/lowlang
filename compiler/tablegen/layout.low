import emit
import std/text

enum LowType {
    Int
    Word
    CodePoint
}

struct LayoutConstant {
    name: str
    value: i64
    kind: LowType
}

fn low_type_name(kind: LowType) -> str {
    match kind {
        Int => "i64"
        Word => "u32"
        CodePoint => "u32"
    }
}

fn low_type_value(kind: LowType, value: i64) -> str {
    match kind {
        Int => "{value}"
        Word => "{value}"
        CodePoint => "0x{text.upper(text.hex(value))}"
    }
}

fn low_constant(name: str, value: i64, kind: LowType) -> LayoutConstant {
    LayoutConstant { name, value, kind }
}

fn class_constants(prefix: str, names: []str, kind: LowType) -> []LayoutConstant {
    var constants: []LayoutConstant = []
    for i, name in names {
        push(mut constants, low_constant("{prefix}{text.lower(name)}", i, kind))
    }
    constants
}

fn layout_source(constants: []LayoutConstant, tables: []str) -> str {
    var out = emit.lines()
    for c in constants {
        let value = low_type_value(c.kind, c.value)
        if c.kind == LowType.Int {
            emit.line(mut out, "const {c.name} = {value}")
            continue
        }
        emit.line(mut out, "const {c.name}: {low_type_name(c.kind)} = {value}")
    }
    emit.line(mut out, "")
    for table in tables {
        let name = text.trim_suffix(table, ".bin")
        emit.line(mut out, "fn {name}_table() -> str {{ embed({text.quote(table)}) }}")
    }
    emit.string(out)
}

fn named_sections(names: []str, data: [][]u8) -> []Section {
    var sections: []Section = []
    for i, name in names {
        push(mut sections, Section { name, data: data[i] })
    }
    sections
}
