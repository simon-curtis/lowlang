import std/json
import std/slices
import std/text

const max_entity_name = 32
const entity_name_offset = 0
const entity_name_length_offset = entity_name_offset + u16_width
const entity_value_offset = entity_name_length_offset + 1
const entity_value_length_offset = entity_value_offset + u16_width
const entity_size = entity_value_length_offset + 1

pub const entity_layout_file = "entity_layout.low"

pub fn entity_tables() -> []str {
    ["entity_index.bin", "entity_names.bin", "entity_values.bin"]
}

fn generate_entities(source: str, output: str) ! Error {
    let data = read_source(source)?
    let table = entity_table(data)?
    var names = keys_of(table)
    slices.sort(mut names)
    var index: []u8 = []
    var name_bytes: []u8 = []
    var value_bytes: []u8 = []
    for name in names {
        let bare = text.trim_prefix(name, "&")
        let value = table[name] ?? ""
        if bare.len > max_entity_name || value.len > 0xFF {
            fail Failed("entity {name} exceeds the table's limits")
        }
        let encoded = encode_entity(name_bytes.len, bare.len, value_bytes.len, value.len)
        for b in encoded {
            push(mut index, b)
        }
        text.append(mut name_bytes, bare)
        text.append(mut value_bytes, value)
    }
    if name_bytes.len > 0xFFFF || value_bytes.len > 0xFFFF {
        fail Failed("entity names or values overflow 16-bit offsets")
    }
    var sections = named_sections(entity_tables(), [index, name_bytes, value_bytes])
    let layout = bytes(entity_layout_source())
    push(mut sections, Section { name: entity_layout_file, data: layout })
    write_sections(output, sections)?
}

fn keys_of(table: [str: str]) -> []str {
    var names: []str = []
    for name, value in table {
        push(mut names, name)
    }
    names
}

fn entity_table(data: str) -> [str: str] ! Error {
    let root = json.parse(bytes(data)) catch {
        e => fail Failed("{e}")
    }
    let members = match root {
        Object(members) => members
        _ => fail Failed("json: cannot unmarshal into Go value of type map[string]main.entity")
    }
    let table: [str: str] = [:]
    for m in members {
        table[m.name] = match m.value {
            Object(_) => json.field_text(m.value, "characters") ?? ""
            _ => fail Failed("json: cannot unmarshal into Go struct field .{m.name} of type main.entity")
        }
    }
    table
}

fn encode_entity(name_at: i64, name_length: i64, value_at: i64, value_length: i64) -> []u8 {
    var out: []u8 = []
    append_u16(mut out, name_at)
    push(mut out, u8(name_length))
    append_u16(mut out, value_at)
    push(mut out, u8(value_length))
    out
}

pub fn entity_layout_source() -> str {
    let constants = [
        low_constant("max_entity_name", max_entity_name, LowType.Int)
        low_constant("entity_size", entity_size, LowType.Int)
        low_constant("entity_name_offset", entity_name_offset, LowType.Int)
        low_constant("entity_name_length_offset", entity_name_length_offset, LowType.Int)
        low_constant("entity_value_offset", entity_value_offset, LowType.Int)
        low_constant("entity_value_length_offset", entity_value_length_offset, LowType.Int)
    ]
    layout_source(constants, entity_tables())
}
