import std/slices
import std/text

const fold_entry_size = 8
const word_entry_size = 8

pub const class_layout_file = "class_layout.low"

pub fn class_tables() -> []str {
    ["fold_orbits.bin", "word_ranges.bin"]
}

fn word_categories() -> []str {
    ["Lu", "Ll", "Lt", "Lm", "Lo", "Mn", "Mc", "Me", "Nd", "Pc"]
}

fn word_properties() -> []str {
    ["Alphabetic", "Join_Control"]
}

struct ClassDatabase {
    word: []bool
    range_start: i64
    folds: [i64: i64]
}

fn generate_classes(dir: str, output: str) ! Error {
    let db = new(ClassDatabase { word: slices.repeat([false], code_points), range_start: 0, folds: [:] })
    each_line("{dir}/UnicodeData.txt", fn(fields: []str) ! Error { read_word_category(db, fields)? })?
    each_range("{dir}/DerivedCoreProperties.txt", fn(first: i64, last: i64, fields: []str) ! Error { read_word_property(db, first, last, fields) })?
    each_range("{dir}/PropList.txt", fn(first: i64, last: i64, fields: []str) ! Error { read_word_property(db, first, last, fields) })?
    each_line("{dir}/CaseFolding.txt", fn(fields: []str) ! Error { read_simple_folding(db, fields)? })?
    let sections = class_sections(db)?
    write_sections(output, sections)?
}

fn mark_word(db: *ClassDatabase, first: i64, last: i64) {
    for c in first..last + 1 {
        db.word[c] = true
    }
}

fn read_word_category(db: *ClassDatabase, fields: []str) ! Error {
    if fields.len < 3 {
        fail Failed("short UnicodeData line {fields}")
    }
    let c = parse_code(fields[0])?
    if text.ends_with(fields[1], "First>") {
        db.range_start = c
        return
    }
    var first = c
    if text.ends_with(fields[1], "Last>") {
        first = db.range_start
    }
    if slices.index(word_categories(), fields[2]) != none {
        mark_word(db, first, c)
    }
}

fn read_word_property(db: *ClassDatabase, first: i64, last: i64, fields: []str) {
    if slices.index(word_properties(), fields[0]) != none {
        mark_word(db, first, last)
    }
}

fn read_simple_folding(db: *ClassDatabase, fields: []str) ! Error {
    if fields.len < 3 {
        fail Failed("short CaseFolding line {fields}")
    }
    if fields[1] != "C" && fields[1] != "S" {
        return
    }
    let c = parse_code(fields[0])?
    let mapping = parse_codes(fields[2])?
    if mapping.len != 1 {
        fail Failed("simple case folding of {fields[0]} maps to {mapping.len} code points")
    }
    db.folds[c] = mapping[0]
}

fn word_ranges(db: *ClassDatabase) -> []u8 {
    var out: []u8 = []
    var c = 0
    for c < code_points {
        if !db.word[c] {
            c += 1
            continue
        }
        let first = c
        for c < code_points && db.word[c] {
            c += 1
        }
        append_u32(mut out, first)
        append_u32(mut out, c - 1)
    }
    out
}

fn fold_orbits(db: *ClassDatabase) -> []u8 ! Error {
    let groups: [i64: []i64] = [:]
    for c in db.folds {
        let target = db.folds[c] ?? c
        if db.folds[target] != none {
            fail Failed("simple case folding of {text.hex(c)} reaches {text.hex(target)}, which folds again")
        }
        var members = groups[target] ?? [target]
        members.push(c)
        groups[target] = members
    }
    let next: [i64: i64] = [:]
    var codes: []i64 = []
    for target in groups {
        var members = groups[target] ?? []
        slices.sort(mut members)
        for i, c in members {
            next[c] = members[(i + 1) % members.len]
            codes.push(c)
        }
    }
    slices.sort(mut codes)
    var out: []u8 = []
    for c in codes {
        append_u32(mut out, c)
        append_u32(mut out, next[c] ?? c)
    }
    out
}

fn class_sections(db: *ClassDatabase) -> []Section ! Error {
    let orbits = fold_orbits(db)?
    var sections = named_sections(class_tables(), [orbits, word_ranges(db)])
    sections.push(Section { name: class_layout_file, data: bytes(class_layout_source()) })
    sections
}

pub fn class_layout_source() -> str {
    let constants = [
        low_constant("fold_entry_size", fold_entry_size, LowType.Int)
        low_constant("word_entry_size", word_entry_size, LowType.Int)
    ]
    layout_source(constants, class_tables())
}
