import std/big
import std/builder
import std/text

const pow10_min = -348
const pow10_max = 347

struct Pow10Entry {
    hi: u64
    lo: u64
}

fn generate_pow10(output: str) ! Error {
    let sections = pow10_sections()?
    write_sections(output, sections)?
}

pub fn pow10_sections() -> []Section ! Error {
    let entries = pow10_entries()?
    var data: []u8 = []
    for e in entries {
        append_u64(mut data, e.hi)
        append_u64(mut data, e.lo)
    }
    [
        Section { name: "pow10.bin", data }
        Section { name: "pow10_prelude.low", data: bytes(pow10_source(entries)) }
    ]
}

fn append_u64(mut out: []u8, v: u64) {
    for shift in 0..8 {
        push(mut out, u8(v >> u64(8 * shift)))
    }
}

fn big_failure(e: big.Error) -> Error {
    Failed("big: {e}")
}

fn pow10_entries() -> []Pow10Entry ! Error {
    let one = big.one()
    let ten = big.from_i64(10)
    let b1p64 = big.shl(one, 64)
    let limit = big.shl(one, 128)
    var entries: []Pow10Entry = []
    for e in pow10_min..pow10_max + 1 {
        var num = one
        var den = one
        if e >= 0 {
            num = big.pow(ten, u64(e))
        } else {
            den = big.pow(ten, u64(-e))
        }
        for big.cmp(num, big.mul(limit, den)) < 0 {
            num = big.shl(num, 1)
        }
        for big.cmp(num, big.mul(limit, den)) >= 0 {
            den = big.shl(den, 1)
        }
        let whole = big.divmod(num, den) catch big_failure
        let split = big.divmod(whole.quotient, b1p64) catch big_failure
        var high = big.to_u64(split.quotient) catch big_failure
        var low = big.to_u64(split.remainder) catch big_failure
        if !big.is_zero(whole.remainder) {
            low += 1
            if low == 0 {
                high += 1
            }
        }
        if low != 0 {
            high += 1
            low = 0 - low
        }
        push(mut entries, Pow10Entry { hi: high, lo: low })
    }
    entries
}

fn pow10_source(entries: []Pow10Entry) -> str {
    var out = builder.builder()
    builder.write(mut out, pow10_function("__pow10_hi", entries, fn(e: Pow10Entry) -> u64 { e.hi }))
    builder.write(mut out, "\n")
    builder.write(mut out, pow10_function("__pow10_lo", entries, fn(e: Pow10Entry) -> u64 { e.lo }))
    builder.to_str(out)
}

fn hex_word(v: u64) -> str {
    var digits: []u8 = []
    text.append_hex(mut digits, i64(v), 16, false)
    "0x{str(digits)}"
}

fn pow10_function(name: str, entries: []Pow10Entry, field: fn(Pow10Entry) -> u64) -> str {
    let per_line = 4
    var out = builder.builder()
    builder.write(mut out, "fn {name}(i: i64) -> u64 {{\n    let t: []u64 = [\n")
    var start = 0
    for start < entries.len {
        let end = if start + per_line < entries.len { start + per_line } else { entries.len }
        var words: []str = []
        for e in entries[start..end] {
            push(mut words, hex_word(field(e)))
        }
        var line = text.join(words, ", ")
        if end < entries.len {
            line = "{line},"
        }
        builder.write(mut out, "        {line}\n")
        start += per_line
    }
    builder.write(mut out, "    ]\n    t[i]\n}}\n")
    builder.to_str(out)
}
