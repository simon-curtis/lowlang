import emit
import std/builder
import std/file
import std/slices
import std/text
import std/xml

const collate_key_bits = 21
const implicit_han_start = 0xFB3F
const implicit_unassigned_start = 0xFBC0

struct RootEntry {
    key: i64
    flags: i64
    first_ce: i64
    ce_count: i64
}

struct RootTable {
    entries: []RootEntry
    pool: []u8
    pool_count: i64
}

struct ParsedLine {
    key: i64
    cps: []i64
    ces: []str
}

fn pack_key(cps: []i64) -> i64 {
    var key = 0
    for i, c in cps {
        key = key | (c << (i * collate_key_bits))
    }
    key
}

fn hex_value(s: str) -> i64 {
    text.parse_radix(s, 16) or 0
}

fn parse_ces(s: str) -> []str {
    var out: []str = []
    var at = 0
    for at < s.len {
        let open = text.index(s[at..], "[")
        if open < 0 {
            break
        }
        let from = at + open
        let close = text.index(s[from..], "]")
        if close < 0 {
            break
        }
        out.push(s[from + 1..from + close])
        at = from + close + 1
    }
    out
}

fn parse_line(line: str) -> ParsedLine? {
    let trimmed = text.trim(line)
    if trimmed == "" || trimmed[0] == '#' || trimmed[0] == '@' {
        return none
    }
    let body = text.cut(trimmed, "#").before
    let cut = text.cut(body, ";")
    var cps: []i64 = []
    for f in text.fields(cut.before) {
        cps.push(hex_value(f))
    }
    let ces = parse_ces(cut.after)
    ParsedLine { key: pack_key(cps), cps, ces }
}

fn weight_text(ce: str) -> str {
    let variable = ce.len > 0 && ce[0] == '*'
    let fields = text.split(ce[1..], '.')
    let t = hex_value(fields[2]) | if variable { 0x8000 } else { 0 }
    "{hex_value(fields[0])} {hex_value(fields[1])} {t}"
}

fn append_ce(mut pool: []u8, weights: str) {
    let f = text.fields(weights)
    append_u16(mut pool, text.parse_int(f[0]) or 0)
    append_u16(mut pool, text.parse_int(f[1]) or 0)
    append_u16(mut pool, text.parse_int(f[2]) or 0)
}

fn root_table(common: str) -> RootTable ! Error {
    let path = file.child_path(common, "uca/allkeys_CLDR.txt")
    let source = read_source(path)?
    var order: []str = []
    let parsed: [str: ParsedLine] = [:]
    for line in text.lines(source) {
        let p = parse_line(line) ?? continue
        let id = text.pad_left("{p.key}", 20, '0')
        order.push(id)
        parsed[id] = p
    }
    slices.sort(mut order)
    let starts: [i64: bool] = [:]
    for id in order {
        let p = parsed[id] ?? continue
        if p.cps.len > 1 {
            starts[pack_key(p.cps[..p.cps.len - 1])] = true
        }
    }
    let offsets: [str: i64] = [:]
    var table = RootTable { entries: [], pool: [], pool_count: 0 }
    for id in order {
        let p = parsed[id] ?? continue
        var weights: []str = []
        for ce in p.ces {
            weights.push(weight_text(ce))
        }
        let signature = text.join(weights, ",")
        var first = offsets[signature] ?? -1
        if first < 0 {
            first = table.pool_count
            offsets[signature] = first
            for w in weights {
                append_ce(mut table.pool, w)
            }
            table.pool_count += weights.len
        }
        let flags = if starts[p.key] ?? false { 1 } else { 0 }
        table.entries.push(RootEntry { key: p.key, flags, first_ce: first, ce_count: weights.len })
    }
    table
}

fn root_section(table: RootTable) -> Section {
    var out: []u8 = []
    append_u32(mut out, table.entries.len)
    for e in table.entries {
        append_u32(mut out, e.key & 0xFFFFFFFF)
        append_u32(mut out, e.key >> 32)
        append_u32(mut out, e.first_ce)
        out.push(u8(e.ce_count))
        out.push(u8(e.flags))
        append_u16(mut out, 0)
    }
    for b in table.pool {
        out.push(b)
    }
    Section { name: "collate_root.bin", data: out }
}

fn han_section(common: str) -> Section ! Error {
    let path = file.child_path(common, "uca/FractionalUCA.txt")
    let source = read_source(path)?
    var out: []u8 = []
    for line in text.lines(source) {
        if !text.starts_with(line, "[Unified_Ideograph ") {
            continue
        }
        let body = text.trim_suffix(text.trim_prefix(line, "[Unified_Ideograph "), "]")
        for range in text.fields(body) {
            let cut = text.cut(range, "..")
            let first = hex_value(cut.before)
            let last = if cut.found { hex_value(cut.after) } else { first }
            append_u32(mut out, first)
            append_u32(mut out, last)
        }
    }
    if out.len == 0 {
        fail Failed("{path}: no Unified_Ideograph line")
    }
    Section { name: "collate_han.bin", data: out }
}

struct ScriptGroup {
    start: i64
    code: str
}

fn script_code(label: str) -> str {
    match label {
        "SPACE" => "Zspc"
        "PUNCTUATION" => "Zpct"
        "SYMBOL" => "Zsym"
        "CURRENCY" => "Zcur"
        "DIGIT" => "Zdig"
        "LATIN" => "Latn"
        "GREEK" => "Grek"
        "CYRILLIC" => "Cyrl"
        "GEORGIAN" => "Geor"
        "ARMENIAN" => "Armn"
        "HEBREW" => "Hebr"
        "ARABIC" => "Arab"
        "ETHIOPIC" => "Ethi"
        "DEVANAGARI" => "Deva"
        "BENGALI" => "Beng"
        "GURMUKHI" => "Guru"
        "GUJARATI" => "Gujr"
        "ORIYA" => "Orya"
        "TAMIL" => "Taml"
        "TELUGU" => "Telu"
        "KANNADA" => "Knda"
        "MALAYALAM" => "Mlym"
        "SINHALA" => "Sinh"
        "THAI" => "Thai"
        "LAO" => "Laoo"
        "TIBETAN" => "Tibt"
        "MYANMAR" => "Mymr"
        "KHMER" => "Khmr"
        "MONGOLIAN" => "Mong"
        "CHEROKEE" => "Cher"
        "HANGUL" => "Hang"
        "HIRAGANA" => "Kana"
        "KATAKANA" => "Kana"
        "HAN" => "Hani"
        _ => "Zzzz"
    }
}

fn fractional_key(primary: str) -> str {
    var bytes = ""
    for f in text.fields(primary) {
        bytes = "{bytes}{f}"
    }
    text.pad_right(bytes, 8, '0')
}

fn script_groups(common: str) -> []ScriptGroup ! Error {
    let path = file.child_path(common, "uca/FractionalUCA.txt")
    let source = read_source(path)?
    var entries: []str = []
    var markers: []str = []
    for line in text.lines(source) {
        let trimmed = text.trim(line)
        if trimmed == "" || trimmed[0] == '#' || trimmed[0] == '[' || trimmed[0] == '@' {
            continue
        }
        let sides = text.cut(trimmed, "#")
        let fractional = parse_ces(text.cut(sides.before, ";").after)
        if fractional.len == 0 {
            continue
        }
        let primary = text.trim(text.cut(fractional[0], ",").before)
        if primary == "" {
            continue
        }
        let key = fractional_key(primary)
        if text.starts_with(trimmed, "FDD1 ") {
            let label = text.cut(text.trim(sides.after), " first primary").before
            markers.push("{key} {label}")
            continue
        }
        let weights = parse_ces(sides.after)
        if weights.len == 0 {
            continue
        }
        let uca = hex_value(text.trim_prefix(text.cut(weights[0], ".").before, "*"))
        if uca == 0 {
            continue
        }
        entries.push("{key} {text.pad_left("{uca}", 6, '0')}")
    }
    slices.sort(mut entries)
    var groups: []ScriptGroup = []
    for m in markers {
        let cut = text.cut(m, " ")
        if cut.after == "unassigned" {
            continue
        }
        if cut.after == "HAN" {
            groups.push(ScriptGroup { start: implicit_han_start, code: script_code(cut.after) })
            continue
        }
        let at = first_at_or_after(entries, cut.before)
        if at >= entries.len {
            continue
        }
        let start = text.parse_int(text.trim_prefix(text.cut(entries[at], " ").after, "0")) or 0
        groups.push(ScriptGroup { start, code: script_code(cut.after) })
    }
    groups.push(ScriptGroup { start: implicit_unassigned_start, code: "Zunk" })
    groups
}

fn first_at_or_after(entries: []str, key: str) -> i64 {
    var lo = 0
    var hi = entries.len
    for lo < hi {
        let mid = (lo + hi) / 2
        if text.cut(entries[mid], " ").before < key {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    lo
}

fn scripts_section(common: str) -> Section ! Error {
    let groups = script_groups(common)?
    var out: []u8 = []
    var previous = -1
    for g in groups {
        if g.start == previous {
            continue
        }
        previous = g.start
        append_u32(mut out, g.start)
        for i in 0..4 {
            out.push(g.code[i])
        }
    }
    Section { name: "collate_scripts.bin", data: out }
}

fn class_section(unicode_data: str) -> Section ! Error {
    let source = read_source(unicode_data)?
    var out: []u8 = []
    var start = -1
    var end = -1
    var class = 0
    for line in text.lines(source) {
        let f = text.split(line, ';')
        if f.len < 4 {
            continue
        }
        let c = hex_value(f[0])
        let k = text.parse_int(f[3]) or 0
        if k == 0 {
            continue
        }
        if start >= 0 && c == end + 1 && k == class {
            end = c
            continue
        }
        if start >= 0 {
            append_u32(mut out, start)
            append_u32(mut out, end)
            append_u32(mut out, class)
        }
        start = c
        end = c
        class = k
    }
    if start >= 0 {
        append_u32(mut out, start)
        append_u32(mut out, end)
        append_u32(mut out, class)
    }
    Section { name: "collate_ccc.bin", data: out }
}

fn clean_rules(source: str) -> str {
    var out = builder.builder()
    var quoted = false
    var comment = false
    var escaped = false
    var space = true
    for i in 0..source.len {
        let c = source[i]
        if comment {
            if c == '\n' {
                comment = false
            }
            continue
        }
        if escaped {
            escaped = false
            builder.write_byte(mut out, c)
            space = false
            continue
        }
        if !quoted && c == '#' {
            comment = true
            continue
        }
        if c == '\\' {
            escaped = true
            builder.write_byte(mut out, c)
            space = false
            continue
        }
        if c == '\'' {
            quoted = !quoted
        }
        if !quoted && (c == ' ' || c == '\t' || c == '\n' || c == '\r') {
            if !space {
                builder.write_byte(mut out, ' ')
                space = true
            }
            continue
        }
        builder.write_byte(mut out, c)
        space = false
    }
    text.trim(builder.to_str(out))
}

struct RuleSets {
    texts: [str: str]
    keys: []str
}

fn collect_rules(common: str) -> RuleSets ! Error {
    let dir = file.child_path(common, "collation")
    let names = file.list(dir) catch {
        e => fail Failed("open {dir}: {emit.io_message(e)}")
    }
    var sets = RuleSets { texts: [:], keys: [] }
    for name in names {
        if !text.ends_with(name, ".xml") {
            continue
        }
        let stem = text.trim_suffix(name, ".xml")
        if stem == "zh" {
            continue
        }
        let root = load_xml(file.child_path(dir, name))?
        let id = if stem == "root" { "root" } else { canonical_id(stem) }
        for c in xml.children(xml.child(root, "collations") ?? continue, "collation") {
            if emit.attribute_text(c, "alt") != "" {
                continue
            }
            let type = emit.attribute_text(c, "type")
            let cr = xml.child(c, "cr") ?? continue
            let key = "{id}/{type}"
            sets.texts[key] = clean_rules(xml.text(cr))
            sets.keys.push(key)
        }
    }
    sets
}

fn import_key(tag: str) -> str {
    let cut = text.cut(tag, "-u-co-")
    let id = if cut.before == "und" { "root" } else { canonical_id(cut.before) }
    let kind = if cut.after == "" { "standard" } else { cut.after }
    "{id}/{kind}"
}

fn expand_rules(sets: RuleSets, rules: str, depth: i64) -> str? {
    if depth > 8 {
        return none
    }
    var out = rules
    for {
        let at = text.index(out, "[import ")
        if at < 0 {
            return out
        }
        let close = text.index(out[at..], "]")
        if close < 0 {
            return none
        }
        let tag = text.trim(out[at + 8..at + close])
        let target = sets.texts[import_key(tag)] ?? return none
        let inner = expand_rules(sets, target, depth + 1) ?? return none
        out = "{out[..at]}{inner}{out[at + close + 1..]}"
    }
    out
}

fn rules_section(common: str) -> Section ! Error {
    let sets = collect_rules(common)?
    var lines: []str = []
    for key in sets.keys {
        if text.starts_with(key, "root/") {
            continue
        }
        let rules = sets.texts[key] ?? continue
        let expanded = expand_rules(sets, rules, 0) ?? continue
        if expanded == "" {
            continue
        }
        lines.push("{key} {expanded}")
    }
    Section { name: "collate_rules.txt", data: bytes(sorted_lines(lines)) }
}

fn generate_collate(common: str, ucd: str, dir: str) ! Error {
    let table = root_table(common)?
    var sections: []Section = []
    sections.push(root_section(table))
    sections.push(han_section(common)?)
    sections.push(scripts_section(common)?)
    sections.push(class_section(file.child_path(ucd, "UnicodeData.txt"))?)
    sections.push(rules_section(common)?)
    write_sections(dir, sections)?
}
