import ast
import diag
import types

pub struct Query {
    pub program: Program
    pub index: *Index
    pub occ: *Occurrence
}

pub struct VariantMatch {
    pub decl: *ast.EnumDecl
    pub variant: *ast.VariantDecl
}

pub fn callee_query(q: *Query, call: *ast.Call) -> *Query {
    var anchor = Anchor.Other
    match call.callee {
        Ident(n) => {
            anchor = Anchor.Ident(n)
        }
        Selector(n) => {
            anchor = Anchor.Selector(n)
        }
        _ => {}
    }
    let occ = new(Occurrence { pos: q.occ.pos, name: q.occ.name, anchor, local: q.occ.local, parent: q.occ.parent })
    new(Query { program: q.program, index: q.index, occ })
}

fn query_file(q: *Query) -> *ast.File {
    q.index.file
}

fn query_module(q: *Query, alias: str) -> str? {
    if alias == "" {
        return query_file(q).module
    }
    ast.imported(query_file(q), alias)
}

fn declared_type(q: *Query, alias: str, name: str) -> *TypeDecl? {
    let module = query_module(q, alias) ?? return none
    find_type_decl(q.program, module, name)
}

fn same_type(decl: *types.Type?, t: *types.Type?) -> bool {
    let d = decl ?? return false
    let found = t ?? return false
    if d == found {
        return true
    }
    match found.origin {
        some(origin) => d == origin
        none => false
    }
}

pub fn struct_decl(q: *Query, t: *types.Type?) -> *ast.StructDecl? {
    let held = t ?? return none
    let s = types.struct_of(held)
    for f in program_files(q.program) {
        for d in f.structs {
            if same_type(d.type, s) {
                return d
            }
        }
    }
    none
}

pub fn variant_decl(q: *Query, t: *types.Type?, name: str) -> VariantMatch? {
    var fallback: VariantMatch? = none
    for f in program_files(q.program) {
        for d in f.enums {
            for v in d.variants {
                if v.name != name {
                    continue
                }
                if same_type(d.type, t) {
                    return VariantMatch { decl: d, variant: v }
                }
                if fallback == none {
                    fallback = VariantMatch { decl: d, variant: v }
                }
            }
        }
    }
    fallback
}

pub fn module_target(q: *Query, module: str) -> Target? {
    let files = module_files(q.program, module)
    if files.len == 0 {
        return none
    }
    Target { file_path: files[0].path, pos: diag.Pos { line: 1, col: 1 } }
}

pub fn resolve(q: *Query) -> Referent {
    match q.occ.anchor {
        Call(n) => resolve_call(q, n)
        Ident(n) => resolve_ident(q, n)
        Selector(n) => resolve_selector(q, n)
        StructLit(n) => named(q, n.module, n.name, Referent.Nothing)
        TypeName(n) => named(q, n.module, n.name, Referent.Spelled(ast.type_text(n)))
        FieldInit(n) => field_referent(q, q.occ.parent, n.name, n.field)
        FieldPattern(n) => field_referent(q, q.occ.parent, n.name, n.field)
        Qualifier(alias) => imported_referent(q, alias)
        Pattern(n) => resolve_pattern(q, n)
        Binding(n) => local_referent(q, n.local)
        Import(n) => Referent.Import(q, n.path)
        _ => declaration(q)
    }
}

fn resolve_call(q: *Query, n: *ast.Call) -> Referent {
    let target = n.target
    match target {
        some(f) => return Referent.Func(f)
        none => {}
    }
    let variant = n.variant
    match variant {
        some(v) => return variant_referent(q, ast.type_of(ast.Expr.Call(n)), v.name, v)
        none => {}
    }
    let callee = resolve(callee_query(q, n))
    let words = builtin_signature(q.program.tables, n)
    if words != "" {
        return Referent.Described(new(callee), words)
    }
    callee
}

fn resolve_ident(q: *Query, n: *ast.Ident) -> Referent {
    let local = n.local
    match local {
        some(l) => return local_referent(q, l)
        none => {}
    }
    let constant = n.constant
    match constant {
        some(k) => return Referent.Const(k)
        none => {}
    }
    let func = n.func
    match func {
        some(f) => return Referent.Func(f)
        none => {}
    }
    let variant = n.variant
    match variant {
        some(v) => return variant_referent(q, n.type, n.name, v)
        none => {}
    }
    let decl = declared_type(q, "", n.name)
    match decl {
        some(d) => return Referent.Type(d)
        none => {}
    }
    let module = ast.imported(query_file(q), n.name)
    match module {
        some(m) => return Referent.Import(q, m)
        none => {}
    }
    Referent.Value(n.name, n.type)
}

fn resolve_selector(q: *Query, n: *ast.Selector) -> Referent {
    let constant = n.constant
    match constant {
        some(k) => return Referent.Const(k)
        none => {}
    }
    let func = n.func
    match func {
        some(f) => return Referent.Func(f)
        none => {}
    }
    let field = n.field
    match field {
        some(_) => return field_referent(q, ast.type_of(n.x), n.name, field)
        none => {}
    }
    let variant = n.variant
    match variant {
        some(v) => return variant_referent(q, n.type, n.name, v)
        none => {}
    }
    Referent.Value(n.name, n.type)
}

fn resolve_pattern(q: *Query, n: *ast.Pattern) -> Referent {
    let local = n.local
    match local {
        some(l) => return local_referent(q, l)
        none => {}
    }
    variant_referent(q, q.occ.parent, n.name, n.variant)
}

fn named(q: *Query, alias: str, name: str, unresolved: Referent) -> Referent {
    let decl = declared_type(q, alias, name)
    match decl {
        some(d) => Referent.Type(d)
        none => unresolved
    }
}

fn imported_referent(q: *Query, alias: str) -> Referent {
    let module = ast.imported(query_file(q), alias)
    match module {
        some(m) => Referent.Import(q, m)
        none => Referent.Nothing
    }
}

fn local_referent(q: *Query, l: *ast.Local?) -> Referent {
    match l {
        some(found) => Referent.Local(q, found)
        none => Referent.Nothing
    }
}

fn field_referent(q: *Query, owner: *types.Type?, name: str, field: *types.Field?) -> Referent {
    Referent.Field(q, owner, name, field)
}

fn variant_referent(q: *Query, enum_type: *types.Type?, name: str, variant: *types.Variant?) -> Referent {
    Referent.Variant(q, enum_type, name, variant)
}

fn declaration(q: *Query) -> Referent {
    let self = Target { file_path: query_file(q).path, pos: q.occ.pos }
    match q.occ.anchor {
        Const(n) => owned(self, Referent.Const(n))
        Func(n) => owned(self, Referent.Func(n))
        StructDecl(n) => owned(self, Referent.Type(struct_type_decl(n)))
        EnumDecl(n) => owned(self, Referent.Type(enum_type_decl(n)))
        FieldDecl(n) => owned(self, field_referent(q, q.occ.parent, n.name, none))
        VariantDecl(n) => owned(self, variant_referent(q, q.occ.parent, n.name, none))
        TypeParam(n) => owned(self, Referent.Spelled(ast.type_param_text(n)))
        Let(_) => owned(self, local_referent(q, q.occ.local))
        Param(_) => owned(self, local_referent(q, q.occ.local))
        ForIn(_) => owned(self, local_referent(q, q.occ.local))
        SelectCase(_) => owned(self, local_referent(q, q.occ.local))
        _ => Referent.Nothing
    }
}

fn owned(at: Target, inner: Referent) -> Referent {
    Referent.Own(new(inner), at)
}
