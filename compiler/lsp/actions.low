import ast
import check
import compiler
import diag
import std/builder
import std/path
import std/text

struct Owner {
    result: *ast.TypeName? = none
    body: *ast.Block
}

struct TrySite {
    node: *ast.Try
    owner: Owner
}

struct Collector {
    sites: []TrySite = []
}

struct Offer {
    uri: str
    version: i64
    snippets: bool
    text: Text
}

pub fn code_actions(s: *Server, p: RangeParams) -> str {
    let file_path = path_of(p.uri)
    let file = server_parsed(s, file_path) ?? return encode_actions([])
    let t = server_text(s, file_path)
    let start = p.range.start
    let request = Rewrite { server: s, uri: p.uri, file_path, file, text: t, line: start.line }
    var actions = rewrites(request)
    let version = s.versions[file_path]
    let o = Offer { uri: p.uri, version: version ?? 0, snippets: s.snippet_edits && version != none, text: t }
    var fixed: []diag.Pos = []
    for d in current_findings(s, file_path) {
        if d.pos.pos_line() != start.line + 1 || d.fixes.len == 0 {
            continue
        }
        fixed.push(d.pos)
        for i, fix in d.fixes {
            match o.action(fix, i == 0 && fix.placeholder == "") {
                some(a) => actions.push(a)
                none => {}
            }
        }
    }
    let col = byte_col(t, start.line, start.character) + 1
    let site = nearest_try(try_sites(file), start.line + 1, col) ?? return encode_actions(actions)
    if fixed_at(fixed, site.node.pos) {
        return encode_actions(actions)
    }
    for fix in check.handling_fixes(site.node.pos, site.owner.body.pos, none, site.owner.result != none) {
        match o.action(fix, false) {
            some(a) => actions.push(a)
            none => {}
        }
    }
    encode_actions(actions)
}

fn current_findings(s: *Server, file_path: str) -> []*diag.Diagnostic {
    let found = state_of(s, file_path).found
    let docs = found.docs ?? return []
    let compiled = compiler.overlay_read(docs, file_path) or return []
    let current = compiler.overlay_read(s.docs, file_path) or return []
    if compiled != current {
        return []
    }
    var here: []*diag.Diagnostic = []
    for d in found.list {
        if path.clean(located(d.pos, found.document).pos_file()) == file_path {
            here.push(d)
        }
    }
    here
}

fn fixed_at(fixed: []diag.Pos, p: diag.Pos) -> bool {
    for at in fixed {
        if at.pos_line() == p.pos_line() && at.pos_col() == p.pos_col() {
            return true
        }
    }
    false
}

fn action(o: Offer, fix: diag.Fix, preferred: bool) -> CodeAction? {
    if fix.edits.len == 0 {
        return none
    }
    let home = fix.edits[0].pos.pos_file()
    var edits: []TextEdit = []
    for edit in fix.edits {
        if edit.pos.pos_file() != home || edit.end.pos_file() != home {
            return none
        }
        edits.push(TextEdit { range: Range { start: position_of(o.text, edit.pos), end: position_of(o.text, edit.end) }, new_text: edit.text })
    }
    var change = WorkspaceEdit { changes: [o.uri: edits] }
    if o.snippets && fix.placeholder != "" && fix.edits.len == 1 {
        change = o.snippet_edit(fix.edits[0], fix.placeholder)
    }
    CodeAction { title: fix.title, kind: "quickfix", is_preferred: preferred, edit: change }
}

fn snippet_edit(o: Offer, edit: diag.Edit, placeholder: str) -> WorkspaceEdit {
    let line = text_line(o.text, edit.pos.pos_line() - 1)
    let before = line[..lesser(edit.pos.pos_col() - 1, line.len)]
    let body = snippet_escape(edit.text)
    let mark = snippet_escape(placeholder)
    let at = text.last_index(body, mark)
    let value = if at < 0 { body } else { "{body[..at]}$0{body[at + mark.len..]}" }
    let snippet = StringValue { kind: "snippet", value: "{snippet_escape(before)}{value}" }
    let range = Range { start: Position { line: edit.pos.pos_line() - 1 }, end: position_of(o.text, edit.end) }
    let document = TextDocumentEdit { uri: o.uri, version: o.version, edits: [SnippetTextEdit { range, snippet }] }
    WorkspaceEdit { document_changes: [document] }
}

fn snippet_escape(s: str) -> str {
    var b = builder.with_capacity(s.len)
    for i in 0..s.len {
        let c = s[i]
        if c == '\\' || c == '$' || c == '}' {
            b.write_byte('\\')
        }
        b.write_byte(c)
    }
    b.to_str()
}

fn try_sites(file: *ast.File) -> []TrySite {
    let collector = new(Collector {})
    for f in file.funcs {
        let body = f.body ?? continue
        collector.collect_tries(Owner { result: f.result, body })
    }
    collector.sites
}

fn collect_visit(collector: *Collector, o: Owner, n: ast.Node) -> bool {
    match n {
        Expr(e) => {
            match e {
                Try(node) => {
                    let site = TrySite { node, owner: o }
                    collector.sites.push(site)
                }
                Closure(c) => {
                    collector.collect_tries(Owner { result: c.result, body: c.body })
                    return false
                }
                _ => {}
            }
        }
        _ => {}
    }
    true
}

fn collect_tries(collector: *Collector, o: Owner) {
    ast.inspect(ast.Node.Expr(ast.Expr.Block(o.body)), fn(n: ast.Node) -> bool { collector.collect_visit(o, n) })
}

fn nearest_try(sites: []TrySite, line: i64, col: i64) -> TrySite? {
    var following: TrySite? = none
    var last: TrySite? = none
    for s in sites {
        if s.node.pos.pos_line() != line {
            continue
        }
        match last {
            some(held) => {
                if s.node.pos.pos_col() > held.node.pos.pos_col() {
                    last = s
                }
            }
            none => {
                last = s
            }
        }
        if s.node.pos.pos_col() < col {
            continue
        }
        match following {
            some(held) => {
                if s.node.pos.pos_col() < held.node.pos.pos_col() {
                    following = s
                }
            }
            none => {
                following = s
            }
        }
    }
    if following != none {
        return following
    }
    last
}
