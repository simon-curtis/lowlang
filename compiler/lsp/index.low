import ast
import diag
import types

pub enum Anchor {
    Import(*ast.Import)
    StructDecl(*ast.StructDecl)
    EnumDecl(*ast.EnumDecl)
    FieldDecl(*ast.FieldDecl)
    VariantDecl(*ast.VariantDecl)
    TypeParam(*ast.TypeParam)
    Const(*ast.Const)
    Func(*ast.Func)
    Param(*ast.Param)
    TypeName(*ast.TypeName)
    Qualifier(alias: str)
    Let(*ast.Let)
    ForIn(*ast.ForIn)
    Ident(*ast.Ident)
    Selector(*ast.Selector)
    Call(*ast.Call)
    StructLit(*ast.StructLit)
    FieldInit(*ast.FieldInit)
    Pattern(*ast.Pattern)
    Binding(*ast.Binding)
    SelectCase(*ast.SelectCase)
    FieldPattern(*ast.FieldPattern)
    Other
}

pub struct Occurrence {
    pub pos: diag.Pos
    pub name: str
    pub anchor: Anchor
    pub local: *ast.Local? = none
    pub parent: *types.Type? = none
}

pub struct Index {
    pub file: *ast.File
    pub text: Text
    pub occurrences: []*Occurrence = []
    pub declarations: [*ast.Local: i64] = [:]
}

pub struct Indexed {
    pub path: str = ""
    pub src: str = ""
    pub index: *Index? = none
}

pub fn indexed_matches(i: Indexed, name: str, file: *ast.File, src: str) -> *Index? {
    let held = i.index ?? return none
    if i.path == name && held.file == file && i.src == src {
        return held
    }
    none
}

struct Indexer {
    index: *Index
    locals: [*ast.Param: *ast.Local] = [:]
    field_parents: [*ast.FieldDecl: *types.Type] = [:]
    variant_parents: [*ast.VariantDecl: *types.Type] = [:]
    init_parents: [*ast.FieldInit: *types.Type] = [:]
    pattern_field_parents: [*ast.FieldPattern: *types.Type] = [:]
    pattern_parents: [*ast.Pattern: *types.Type] = [:]
    shorthand: [*ast.Ident: bool] = [:]
    shorthand_binding: [*ast.Binding: bool] = [:]
}

pub fn new_index(file: *ast.File, t: Text) -> *Index {
    let x = new(Index { file, text: t })
    let b = new(Indexer { index: x })
    ast.inspect(ast.Node.File(file), fn(n: ast.Node) -> bool { visit(b, n) })
    for i, o in x.occurrences {
        let local = o.local ?? continue
        if x.declarations[local] == none {
            x.declarations[local] = i
        }
    }
    x
}

pub fn index_at(x: *Index, line: i64, byte_col: i64) -> *Occurrence? {
    for o in x.occurrences {
        let start = o.pos.col - 1
        if o.pos.line - 1 == line && byte_col >= start && byte_col <= start + o.name.len {
            return o
        }
    }
    none
}

pub fn index_declaration(x: *Index, l: *ast.Local) -> *Occurrence? {
    let i = x.declarations[l] ?? return none
    x.occurrences[i]
}

fn add_occurrence(b: *Indexer, o: Occurrence) {
    push(mut b.index.occurrences, new(o))
}

fn declared(b: *Indexer, at: diag.Pos, name: str, anchor: Anchor, local: *ast.Local?) {
    let pos = name_after(b.index.text, at, name)
    add_occurrence(b, Occurrence { pos, name, anchor, local })
}

fn bind_params(b: *Indexer, params: []*ast.Param, locals: []*ast.Local) {
    for i, p in params {
        if i < locals.len {
            b.locals[p] = locals[i]
        }
    }
}

fn visit(b: *Indexer, n: ast.Node) -> bool {
    match n {
        Import(i) => declared(b, i.pos, i.path, Anchor.Import(i), none)
        StructDecl(d) => {
            declared(b, d.pos, d.name, Anchor.StructDecl(d), none)
            let owner = d.type
            match owner {
                some(t) => {
                    for f in d.fields {
                        b.field_parents[f] = t
                    }
                }
                none => {}
            }
        }
        EnumDecl(d) => {
            declared(b, d.pos, d.name, Anchor.EnumDecl(d), none)
            let owner = d.type
            match owner {
                some(t) => {
                    for v in d.variants {
                        b.variant_parents[v] = t
                    }
                }
                none => {}
            }
        }
        FieldDecl(f) => add_occurrence(b, Occurrence { pos: f.pos, name: f.name, anchor: Anchor.FieldDecl(f), parent: b.field_parents[f] })
        VariantDecl(v) => add_occurrence(b, Occurrence { pos: v.pos, name: v.name, anchor: Anchor.VariantDecl(v), parent: b.variant_parents[v] })
        TypeParam(p) => add_occurrence(b, Occurrence { pos: p.pos, name: p.name, anchor: Anchor.TypeParam(p) })
        Const(k) => declared(b, k.pos, k.name, Anchor.Const(k), none)
        Func(f) => {
            declared(b, f.pos, f.name, Anchor.Func(f), none)
            bind_params(b, f.params, f.param_locals)
        }
        Param(p) => add_occurrence(b, Occurrence { pos: p.pos, name: p.name, anchor: Anchor.Param(p), local: b.locals[p] })
        TypeName(t) => type_name(b, t)
        StructPattern(p) => {
            let owner = p.type
            match owner {
                some(t) => {
                    for f in p.fields {
                        b.pattern_field_parents[f] = t
                    }
                }
                none => {}
            }
        }
        FieldPattern(f) => field_pattern(b, f)
        Binding(bind) => {
            if b.shorthand_binding[bind] == none {
                add_occurrence(b, Occurrence { pos: bind.pos, name: bind.name, anchor: Anchor.Binding(bind), local: bind.local })
            }
        }
        SelectCase(c) => {
            if c.name != "" {
                add_occurrence(b, Occurrence { pos: c.pos, name: c.name, anchor: Anchor.SelectCase(c), local: c.local })
            }
        }
        FieldInit(f) => {
            if f.form != ast.FieldForm.FieldImplied {
                add_occurrence(b, Occurrence { pos: f.pos, name: f.name, anchor: Anchor.FieldInit(f), parent: b.init_parents[f] })
            }
        }
        Pattern(p) => pattern(b, p)
        Stmt(s) => visit_stmt(b, s)
        Expr(e) => visit_expr(b, e)
        _ => {}
    }
    true
}

fn visit_stmt(b: *Indexer, s: ast.Stmt) {
    match s {
        Let(n) => {
            if n.pattern == none {
                declared(b, n.pos, n.name, Anchor.Let(n), n.local)
            }
        }
        ForIn(n) => for_in(b, n)
        _ => {}
    }
}

fn visit_expr(b: *Indexer, e: ast.Expr) {
    match e {
        Closure(n) => {
            let f = n.func
            match f {
                some(g) => bind_params(b, n.params, g.param_locals)
                none => {}
            }
        }
        Ident(n) => {
            if b.shorthand[n] == none {
                add_occurrence(b, Occurrence { pos: n.pos, name: n.name, anchor: Anchor.Ident(n) })
            }
        }
        Selector(n) => add_occurrence(b, Occurrence { pos: n.pos, name: n.name, anchor: Anchor.Selector(n) })
        Call(n) => callee(b, n)
        StructLit(n) => struct_lit(b, n)
        Match(n) => patterns(b, n.arms, ast.type_of(n.x))
        Catch(n) => patterns(b, n.arms, error_of(ast.type_of(n.x)))
        _ => {}
    }
}

fn type_name(b: *Indexer, t: *ast.TypeName) {
    if t.name == "" {
        return
    }
    var pos = t.pos
    if t.module != "" {
        add_occurrence(b, Occurrence { pos, name: t.module, anchor: Anchor.Qualifier(t.module) })
        pos.col += t.module.len + 1
    }
    add_occurrence(b, Occurrence { pos, name: t.name, anchor: Anchor.TypeName(t) })
}

fn for_in(b: *Indexer, s: *ast.ForIn) {
    var pos = s.pos
    if s.key != "" {
        pos = name_after(b.index.text, pos, s.key)
        add_occurrence(b, Occurrence { pos, name: s.key, anchor: Anchor.ForIn(s), local: s.key_local })
        pos.col += s.key.len
    }
    if s.pattern == none {
        declared(b, pos, s.value, Anchor.ForIn(s), s.value_local)
    }
}

fn field_pattern(b: *Indexer, f: *ast.FieldPattern) {
    var local: *ast.Local? = none
    if f.shorthand {
        let bound = f.bind
        match bound {
            some(bind) => {
                b.shorthand_binding[bind] = true
                local = bind.local
            }
            none => {}
        }
    }
    add_occurrence(b, Occurrence { pos: f.pos, name: f.name, anchor: Anchor.FieldPattern(f), local, parent: b.pattern_field_parents[f] })
}

fn callee(b: *Indexer, e: *ast.Call) {
    match e.callee {
        Ident(fn_ident) => add_occurrence(b, Occurrence { pos: fn_ident.pos, name: fn_ident.name, anchor: Anchor.Call(e) })
        Selector(fn_selector) => add_occurrence(b, Occurrence { pos: fn_selector.pos, name: fn_selector.name, anchor: Anchor.Call(e) })
        _ => {}
    }
}

fn struct_lit(b: *Indexer, e: *ast.StructLit) {
    add_occurrence(b, Occurrence { pos: e.pos, name: e.name, anchor: Anchor.StructLit(e) })
    let owner = e.type
    for f in e.fields {
        match owner {
            some(t) => {
                b.init_parents[f] = t
            }
            none => {}
        }
        if f.form == ast.FieldForm.FieldShorthand {
            match f.value {
                Ident(i) => {
                    b.shorthand[i] = true
                }
                _ => {}
            }
        }
    }
}

fn error_of(t: *types.Type?) -> *types.Type? {
    let found = t ?? return none
    if found.kind == types.Kind.ResultKind {
        return found.err
    }
    found
}

fn patterns(b: *Indexer, arms: []*ast.Arm, scrutinee: *types.Type?) {
    let held = scrutinee ?? return
    for a in arms {
        b.pattern_parents[a.pattern] = held
    }
}

fn pattern(b: *Indexer, p: *ast.Pattern) {
    if p.test != none {
        return
    }
    if p.local != none {
        add_occurrence(b, Occurrence { pos: p.pos, name: p.name, anchor: Anchor.Pattern(p), local: p.local })
        return
    }
    add_occurrence(b, Occurrence { pos: p.pos, name: p.name, anchor: Anchor.Pattern(p), parent: b.pattern_parents[p] })
}
