import ast
import compiler
import types

pub struct Failure {
    pub site: str = ""
    pub line: i64 = 0
    pub col: i64 = 0
    pub result: *types.Type? = none
    pub docs: *compiler.Overlay? = none
    pub present: bool = false
}

pub struct EntryState {
    pub unit: *compiler.Unit? = none
    pub docs: *compiler.Overlay? = none
    pub fresh: bool = false
    pub failure: Failure = Failure {}
    pub published: []str = []
}

pub fn entry_program(e: *EntryState, tables: *Tables) -> Program {
    Program { unit: e.unit, tables }
}

pub fn compiled_text(e: *EntryState, name: str) -> Text {
    let docs = e.docs ?? return Text {}
    let src = compiler.overlay_read(docs, name) or return Text {}
    new_text(src)
}
