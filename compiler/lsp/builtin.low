import ast
import check
import diag
import types
import std/text

pub fn new_tables() -> *Tables {
    let u = types.new_universe(fn(t: *types.Type) ! diag.Error {})
    let list = check.builtins(u)
    let index: [str: *check.Builtin] = [:]
    for b in list {
        index[b.name] = b
    }
    new(Tables { list, index })
}

fn type_label(t: *types.Type?) -> str {
    match t {
        some(found) => types.text(found)
        none => "<nil>"
    }
}

pub fn builtin_signature(tables: *Tables, call: *ast.Call) -> str {
    let id = identifier(call) ?? return ""
    if id.local != none || id.func != none || id.variant != none {
        return ""
    }
    let ret = ast.type_of(ast.Expr.Call(call)) ?? return ""
    let b = tables.index[id.name] ?? return ""
    if b.kind != check.BuiltinKind.FunctionBuiltin && b.kind != check.BuiltinKind.TypeBuiltin {
        return ""
    }
    var params: []str = []
    for i, arg in call.args {
        push(mut params, builtin_param(arg, b, i))
    }
    var result = ""
    if !types.is_void(ret) {
        result = " -> {types.text(ret)}"
    }
    let joined = text.join(params, ", ")
    "fn {id.name}({joined}){result}"
}

fn identifier(call: *ast.Call) -> *ast.Ident? {
    match call.callee {
        Ident(n) => n
        _ => none
    }
}

fn builtin_param(arg: ast.Expr, b: *check.Builtin, i: i64) -> str {
    let name = check.param_name(b, i)
    let label = type_label(ast.type_of(arg))
    match arg {
        Ref(_) => "mut {name}: {label}"
        _ => "{name}: {label}"
    }
}
