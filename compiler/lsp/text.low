import diag
import std/builder
import std/path
import std/text

pub struct Text {
    pub lines: []str = []
}

pub fn new_text(src: str) -> Text {
    Text { lines: text.split(src, '\n') }
}

pub fn text_line(t: Text, n: i64) -> str {
    if n < 0 || n >= t.lines.len {
        return ""
    }
    t.lines[n]
}

fn clamp(n: i64, low: i64, high: i64) -> i64 {
    if n < low {
        return low
    }
    if n > high {
        return high
    }
    n
}

pub fn utf16_col(t: Text, line: i64, byte_col: i64) -> i64 {
    let src = text_line(t, line)
    let stop = clamp(byte_col, 0, src.len)
    var units = 0
    for c in src[..stop] {
        units += utf16_len(c)
    }
    units
}

pub fn byte_col(t: Text, line: i64, utf16: i64) -> i64 {
    let src = text_line(t, line)
    var units = 0
    for i, c in src {
        if units >= utf16 {
            return i
        }
        units += utf16_len(c)
    }
    src.len
}

fn utf16_len(c: u32) -> i64 {
    if c >= 0x10000 {
        return 2
    }
    1
}

pub fn position_of(t: Text, p: diag.Pos) -> Position {
    let line = p.line - 1
    Position { line, character: utf16_col(t, line, p.col - 1) }
}

pub fn span(t: Text, p: diag.Pos, length: i64) -> Range {
    let end = diag.Pos { file: p.file, line: p.line, col: p.col + length }
    Range { start: position_of(t, p), end: position_of(t, end) }
}

pub fn word(t: Text, p: diag.Pos) -> Range {
    let src = text_line(t, p.line - 1)
    let start = clamp(p.col - 1, 0, src.len)
    var end = start
    for end < src.len && is_word(src[end]) {
        end += 1
    }
    if end == start {
        end = clamp(start + 1, 0, src.len)
    }
    let length = if end - start > 1 { end - start } else { 1 }
    span(t, p, length)
}

pub fn name_after(t: Text, p: diag.Pos, name: str) -> diag.Pos {
    let src = text_line(t, p.line - 1)
    var from = clamp(p.col - 1, 0, src.len)
    for {
        let i = text.index(src[from..], name)
        if i < 0 {
            return p
        }
        let at = from + i
        let end = at + name.len
        let before = at == 0 || !is_word(src[at - 1])
        let after = end == src.len || !is_word(src[end])
        if before && after {
            return diag.Pos { file: p.file, line: p.line, col: at + 1 }
        }
        from = at + 1
    }
}

pub fn is_word(c: u8) -> bool {
    c == '_' || c >= 0x80 || (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9')
}

fn unescape(s: str) -> str? {
    var out: []u8 = []
    var i = 0
    for i < s.len {
        let c = s[i]
        if c == '%' {
            if i + 2 >= s.len {
                return none
            }
            let high = text.hex_digit(s[i + 1])
            let low = text.hex_digit(s[i + 2])
            if high < 0 || low < 0 {
                return none
            }
            push(mut out, u8(high * 16 + low))
            i += 3
        } else {
            push(mut out, c)
            i += 1
        }
    }
    str(out)
}

fn has_control(s: str) -> bool {
    for i in 0..s.len {
        if s[i] < 0x20 || s[i] == 0x7f {
            return true
        }
    }
    false
}

struct FileUri {
    host: str
    path: str
}

fn parse_file_uri(uri: str) -> FileUri? {
    if has_control(uri) || uri.len < 5 {
        return none
    }
    if !text.equal_fold(uri[..5], "file:") {
        return none
    }
    var rest = uri[5..]
    let hash = text.index_byte(rest, '#')
    if hash >= 0 {
        rest = rest[..hash]
    }
    let query = text.index_byte(rest, '?')
    if query >= 0 {
        rest = rest[..query]
    }
    var host = ""
    if text.starts_with(rest, "//") {
        let after = rest[2..]
        let slash = text.index_byte(after, '/')
        var authority = after
        rest = ""
        if slash >= 0 {
            authority = after[..slash]
            rest = after[slash..]
        }
        let at = text.last_index_byte(authority, '@')
        if at >= 0 {
            authority = authority[at + 1..]
        }
        host = authority
    } else if !text.starts_with(rest, "/") {
        return FileUri { host: "", path: "" }
    }
    let decoded = unescape(rest) ?? return none
    FileUri { host, path: decoded }
}

pub fn path_of(uri: str) -> str {
    let parsed = parse_file_uri(uri) ?? return uri
    var p = parsed.path
    if parsed.host != "" && parsed.host != "localhost" {
        p = "//{parsed.host}{p}"
    }
    path.clean(p)
}

fn unreserved(c: u8) -> bool {
    (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '-' || c == '_' || c == '.' || c == '~'
}

fn path_safe(c: u8) -> bool {
    unreserved(c) || c == '$' || c == '&' || c == '+' || c == ',' || c == '/' || c == ':' || c == ';' || c == '=' || c == '@'
}

fn escape_path(p: str) -> str {
    var out = builder.builder()
    for i in 0..p.len {
        let c = p[i]
        if path_safe(c) {
            out.write_byte(c)
        } else {
            var hex: []u8 = []
            text.append_hex(mut hex, i64(c), 2, true)
            let digits = str(hex)
            out.write("%{digits}")
        }
    }
    out.to_str()
}

pub fn uri_of(file_path: str) -> str {
    if file_path == "" {
        return "file:"
    }
    "file://{escape_path(file_path)}"
}
