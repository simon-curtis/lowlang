import ast
import check
import types

struct ReceiverHome {
    module: str
    foreign: bool
}

struct Called {
    type: *types.Type? = none
    rest: []u8 = []
}

struct Head {
    type: *types.Type? = none
    suffixes: []u8 = []
    rest: []Segment = []
}

fn receiver_home(t: *types.Type, current: str) -> ReceiverHome {
    var home = types.struct_of(t)
    match home.origin {
        some(origin) => {
            home = origin
        }
        none => {}
    }
    ReceiverHome { module: home.module, foreign: home.module != current }
}

fn apply_suffix(c: *Cursor, t: *types.Type?, suffix: u8) -> *types.Type? {
    let held = t ?? return none
    if suffix == '(' && held.kind == types.Kind.FuncKind {
        return held.ret
    }
    if suffix == '[' {
        let unit = c.program.unit ?? return none
        return check.index_type(unit.universe, held) catch {
            _ => none
        }
    }
    if suffix == '?' && held.kind == types.Kind.ResultKind {
        return held.ok
    }
    none
}

fn called(f: *ast.Func?, suffixes: []u8) -> Called {
    let declared = f ?? return Called {}
    if suffixes.len == 0 || suffixes[0] != '(' {
        return Called {}
    }
    Called { type: declared.ret_type, rest: suffixes[1..] }
}

fn head(c: *Cursor, segments: []Segment) -> Head {
    let file = c.file ?? return Head {}
    let first = segments[0]
    let local = find_local(c, first.name)
    match local {
        some(l) => return Head { type: l.type, suffixes: first.suffixes, rest: segments[1..] }
        none => {}
    }
    let module = ast.imported(file, first.name)
    match module {
        some(path) => {
            if segment_plain(first) && segments.len > 1 {
                let f = find_function(c.program, path, segments[1].name, true)
                let r = called(f, segments[1].suffixes)
                return Head { type: r.type, suffixes: r.rest, rest: segments[2..] }
            }
        }
        none => {}
    }
    let f = find_function(c.program, file.module, first.name, false)
    let r = called(f, first.suffixes)
    Head { type: r.type, suffixes: r.rest, rest: segments[1..] }
}

fn method(c: *Cursor, t: *types.Type, name: str) -> *ast.Func? {
    let file = c.file ?? return none
    let own = find_function(c.program, file.module, name, false)
    if own != none {
        return own
    }
    let home = receiver_home(t, file.module)
    if home.foreign {
        let foreign = find_function(c.program, home.module, name, true)
        if foreign != none {
            return foreign
        }
    }
    for imp in file.imports {
        let f = find_function(c.program, imp.path, name, true) ?? continue
        if check.takes_first(f, t) {
            return f
        }
    }
    none
}

fn module_methods(c: *Cursor, module: str, t: *types.Type, public: bool) {
    for f in module_files(c.program, module) {
        for fn_decl in ast.declared_funcs(f) {
            if (fn_decl.exported || !public) && check.takes_first(fn_decl, t) {
                add_item(c, fn_decl.name, completion_method, ast.signature(fn_decl))
            }
        }
    }
}

fn methods(c: *Cursor, t: *types.Type) {
    let file = c.file ?? return
    module_methods(c, file.module, t, false)
    let home = receiver_home(t, file.module)
    if home.foreign {
        module_methods(c, home.module, t, true)
    }
    for imp in file.imports {
        module_methods(c, imp.path, t, true)
    }
    for l in scope(c) {
        let held = l.type ?? continue
        if held.kind == types.Kind.FuncKind && held.params.len > 0 && types.accepts(held.params[0], t) {
            add_item(c, l.name, completion_method, types.text(held))
        }
    }
    for b in c.program.tables.list {
        if b.kind == check.BuiltinKind.FunctionBuiltin && check.receives(b, t.kind) {
            add_item(c, b.name, completion_method, "builtin")
        }
    }
}

fn type_of(c: *Cursor, segments: []Segment) -> *types.Type? {
    let start = head(c, segments)
    var t = start.type
    var suffixes = start.suffixes
    var rest = start.rest
    for {
        for s in suffixes {
            t = apply_suffix(c, t, s)
        }
        let held = t ?? return none
        if rest.len == 0 {
            return t
        }
        let next = rest[0]
        let field = types.field(types.struct_of(held), next.name)
        match field {
            some(f) => {
                t = f.type
                suffixes = next.suffixes
                rest = rest[1..]
                continue
            }
            none => {}
        }
        let m = method(c, held, next.name) ?? return none
        if !check.takes_first(m, held) {
            return none
        }
        let r = called(m, next.suffixes)
        t = r.type
        suffixes = r.rest
        rest = rest[1..]
    }
}
