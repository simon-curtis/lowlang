import ast
import types
import std/text

pub enum Referent {
    Nothing
    Spelled(words: str)
    Value(name: str, type: *types.Type?)
    Described(inner: *Referent, words: str)
    Own(inner: *Referent, at: Target)
    Func(*ast.Func)
    Const(*ast.Const)
    Import(q: *Query, module: str)
    Type(*TypeDecl)
    Local(q: *Query, local: *ast.Local)
    Field(q: *Query, owner: *types.Type?, name: str, field: *types.Field?)
    Variant(q: *Query, enum_type: *types.Type?, name: str, variant: *types.Variant?)
}

pub fn referent_target(r: Referent) -> Target? {
    match r {
        Nothing => none
        Spelled(_) => none
        Value(_, _) => none
        Described(inner, _) => referent_target(*inner)
        Own(_, at) => at
        Func(f) => func_target(f)
        Const(k) => const_target(k)
        Import(q, module) => module_target(q, module)
        Type(decl) => type_decl_target(decl)
        Local(q, local) => local_target(q, local)
        Field(q, owner, name, _) => field_target(q, owner, name)
        Variant(q, enum_type, name, _) => variant_target(q, enum_type, name)
    }
}

pub fn referent_hover(r: Referent) -> str {
    match r {
        Nothing => ""
        Spelled(words) => words
        Value(name, t) => value_hover(name, t)
        Described(_, words) => words
        Own(inner, _) => referent_hover(*inner)
        Func(f) => ast.signature(f)
        Const(k) => ast.const_text(k)
        Import(_, module) => "import {module}"
        Type(decl) => decl.text
        Local(q, local) => local_hover(q, local)
        Field(q, owner, name, field) => field_hover(owner, name, field)
        Variant(q, enum_type, name, variant) => variant_hover(enum_type, name, variant)
    }
}

pub fn referent_doc(r: Referent) -> str {
    match r {
        Described(inner, _) => referent_doc(*inner)
        Own(inner, _) => referent_doc(*inner)
        Func(f) => ast.source(f).doc
        Const(k) => k.doc
        Type(decl) => decl.doc
        Field(q, owner, name, _) => field_doc(q, owner, name)
        Variant(q, enum_type, name, _) => variant_doc(q, enum_type, name)
        _ => ""
    }
}

fn value_hover(name: str, t: *types.Type?) -> str {
    match t {
        some(found) => "{name}: {types.text(found)}"
        none => ""
    }
}

fn func_target(fn_decl: *ast.Func) -> Target? {
    let f = ast.source(fn_decl)
    let home = f.file ?? return none
    if home.path == "" {
        return none
    }
    Target { file_path: home.path, pos: f.pos, name: f.name }
}

fn const_target(k: *ast.Const) -> Target? {
    let home = k.file ?? return none
    if home.path == "" {
        return none
    }
    Target { file_path: home.path, pos: k.pos, name: k.name }
}

fn local_target(q: *Query, l: *ast.Local) -> Target? {
    let d = index_declaration(q.index, l) ?? return none
    Target { file_path: q.index.file.path, pos: d.pos }
}

fn is_using(q: *Query, l: *ast.Local) -> bool {
    let d = index_declaration(q.index, l) ?? return false
    match d.anchor {
        Let(n) => n.is_using
        _ => false
    }
}

fn local_hover(q: *Query, l: *ast.Local) -> str {
    var keyword = "let "
    let scoped = is_using(q, l)
    if scoped && l.mutable {
        keyword = "using var "
    } else if scoped {
        keyword = "using "
    } else if l.param && l.ref {
        keyword = "mut "
    } else if l.param {
        keyword = ""
    } else if l.mutable {
        keyword = "var "
    }
    match l.type {
        some(t) => "{keyword}{l.name}: {types.text(t)}"
        none => "{keyword}{l.name}"
    }
}

fn typed_field(owner: *types.Type?, name: str, field: *types.Field?) -> *types.Field? {
    if field != none {
        return field
    }
    let t = owner ?? return none
    types.field(types.struct_of(t), name)
}

fn field_decl(q: *Query, owner: *types.Type?, name: str) -> *ast.FieldDecl? {
    let d = struct_decl(q, owner) ?? return none
    for f in d.fields {
        if f.name == name {
            return f
        }
    }
    none
}

fn field_target(q: *Query, owner: *types.Type?, name: str) -> Target? {
    let f = field_decl(q, owner, name) ?? return none
    let d = struct_decl(q, owner) ?? return none
    let home = d.file ?? return none
    Target { file_path: home.path, pos: f.pos }
}

fn field_hover(owner: *types.Type?, name: str, field: *types.Field?) -> str {
    let f = typed_field(owner, name, field) ?? return ""
    "{name}: {types.text(f.type)}"
}

fn field_doc(q: *Query, owner: *types.Type?, name: str) -> str {
    let f = field_decl(q, owner, name) ?? return ""
    f.doc
}

fn variant_target(q: *Query, enum_type: *types.Type?, name: str) -> Target? {
    let found = variant_decl(q, enum_type, name) ?? return none
    let home = found.decl.file ?? return none
    Target { file_path: home.path, pos: found.variant.pos }
}

fn variant_hover(enum_type: *types.Type?, name: str, variant: *types.Variant?) -> str {
    var found = variant
    if found == none {
        let e = enum_type ?? return ""
        found = types.variant(e, name)
    }
    let v = found ?? return ""
    var fields: []str = []
    for f in v.fields {
        push(mut fields, types.text(f))
    }
    var label = v.name
    match enum_type {
        some(e) => {
            if e.kind == types.Kind.EnumKind {
                label = "{e.name}.{v.name}"
            }
        }
        none => {}
    }
    if fields.len == 0 {
        return label
    }
    let joined = text.join(fields, ", ")
    "{label}({joined})"
}

fn variant_doc(q: *Query, enum_type: *types.Type?, name: str) -> str {
    let found = variant_decl(q, enum_type, name) ?? return ""
    found.variant.doc
}
