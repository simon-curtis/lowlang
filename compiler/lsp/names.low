import ast
import compiler
import target
import std/path
import std/sys

pub struct Definition {
    pub path: str
    pub line: i64
    pub column: i64
    pub local: bool
}

pub struct Name {
    pub line: i64
    pub column: i64
    pub name: str
    pub hover: str = ""
    pub doc: str = ""
    pub definition: Definition? = none
    pub first: i64? = none
}

struct Naming {
    server: *Server
    program: Program
    index: *Index
    path: str
    names: []*Name = []
    located: [i64: Location] = [:]
    primary: [str: i64] = [:]
    shared: [str: i64] = [:]
}

fn naming_query(n: *Naming, o: *Occurrence) -> *Query {
    new(Query { program: n.program, index: n.index, occ: o })
}

fn describe(n: *Naming, at: i64, o: *Occurrence) {
    let r = resolve(naming_query(n, o))
    let name = new(Name { line: o.pos.line, column: o.pos.col, name: o.name, hover: referent_hover(r), doc: referent_doc(r) })
    match referent_target(r) {
        some(tg) => describe_target(n, name, at, tg)
        none => {}
    }
    push(mut n.names, name)
}

fn describe_target(n: *Naming, name: *Name, at: i64, tg: Target) {
    let where = server_locate(n.server, tg)
    let start = where.range.start
    let local = path.clean(tg.file_path) == n.path
    let column = byte_col(server_text(n.server, tg.file_path), start.line, start.character) + 1
    name.definition = Definition { path: tg.file_path, line: start.line + 1, column, local }
    n.located[at] = where
    let key = location_key(where)
    if n.primary[key] == none {
        n.primary[key] = at
    }
}

fn share(n: *Naming, at: i64, o: *Occurrence) {
    let anchor = shorthand_anchor(o) ?? return
    let other = new(Occurrence { pos: o.pos, name: o.name, anchor, local: o.local, parent: o.parent })
    let tg = referent_target(resolve(naming_query(n, other))) ?? return
    let where = server_locate(n.server, tg)
    let current = n.located[at] ?? Location {}
    let key = location_key(where)
    if n.shared[key] == none && !same_location(where, current) {
        n.shared[key] = at
    }
}

fn group(n: *Naming) {
    for at, name in n.names {
        let where = n.located[at] ?? continue
        let key = location_key(where)
        var first = n.primary[key] ?? 0
        let other = n.shared[key]
        match other {
            some(shared) => {
                if shared < first {
                    first = shared
                }
            }
            none => {}
        }
        name.first = first
    }
}

pub fn names(source: str, platform: target.OS, docs: *compiler.Overlay) -> []*Name ! compiler.Error {
    let file_path = path.clean(source)
    let server = new_server(sys.stream(0), sys.stream(1), docs)
    let unit = compiler.check_in(file_path, platform, server.std, server.docs)?
    let program = Program { unit, tables: server.tables }
    let file = file_at(program, file_path) ?? return []
    let index = new_index(file, server_text(server, file_path))
    let n = new(Naming { server, program, index, path: file_path })
    for at, o in index.occurrences {
        describe(n, at, o)
    }
    for at, o in index.occurrences {
        share(n, at, o)
    }
    group(n)
    n.names
}
