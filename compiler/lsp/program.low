import ast
import check
import compiler
import diag
import std/path

pub struct Tables {
    pub list: []*check.Builtin
    pub index: [str: *check.Builtin]
}

pub struct Program {
    pub unit: *compiler.Unit? = none
    pub tables: *Tables
}

pub fn program_files(p: Program) -> []*ast.File {
    var files: []*ast.File = []
    let unit = p.unit ?? return files
    for f in unit.files {
        if f.path != "" {
            push(mut files, f)
        }
    }
    files
}

pub fn module_files(p: Program, module: str) -> []*ast.File {
    var files: []*ast.File = []
    for f in program_files(p) {
        if f.module == module {
            push(mut files, f)
        }
    }
    files
}

pub fn file_at(p: Program, name: str) -> *ast.File? {
    for f in program_files(p) {
        if path.clean(f.path) == name {
            return f
        }
    }
    none
}

pub struct TypeDecl {
    pub name: str
    pub doc: str
    pub file_path: str
    pub pos: diag.Pos
    pub text: str
    pub decl: *ast.EnumDecl? = none
}

fn path_of_file(f: *ast.File?) -> str {
    match f {
        some(file) => file.path
        none => ""
    }
}

pub fn struct_type_decl(d: *ast.StructDecl) -> *TypeDecl {
    new(TypeDecl { name: d.name, doc: d.doc, file_path: path_of_file(d.file), pos: d.pos, text: ast.struct_text(d) })
}

pub fn enum_type_decl(d: *ast.EnumDecl) -> *TypeDecl {
    new(TypeDecl { name: d.name, doc: d.doc, file_path: path_of_file(d.file), pos: d.pos, text: ast.enum_text(d), decl: d })
}

pub fn type_decl_target(d: *TypeDecl) -> Target {
    Target { file_path: d.file_path, pos: d.pos, name: d.name }
}

pub fn find_type_decl(p: Program, module: str, name: str) -> *TypeDecl? {
    for f in module_files(p, module) {
        for d in f.structs {
            if d.name == name {
                return struct_type_decl(d)
            }
        }
        for d in f.enums {
            if d.name == name {
                return enum_type_decl(d)
            }
        }
    }
    none
}

pub fn find_enum_decl(p: Program, module: str, name: str) -> *ast.EnumDecl? {
    let decl = find_type_decl(p, module, name) ?? return none
    decl.decl
}

pub fn find_function(p: Program, module: str, name: str, public: bool) -> *ast.Func? {
    for f in module_files(p, module) {
        for fn_decl in ast.declared_funcs(f) {
            if fn_decl.name == name && (fn_decl.exported || !public) {
                return fn_decl
            }
        }
    }
    none
}

pub struct Target {
    pub file_path: str = ""
    pub pos: diag.Pos = diag.Pos {}
    pub name: str = ""
}
