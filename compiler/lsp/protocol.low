import diag
import std/builder
import std/io
import std/json
import std/serde
import std/slices
import std/text
import std/unicode

pub const symbol_namespace = 3
pub const symbol_field = 8
pub const symbol_enum = 10
pub const symbol_function = 12
pub const symbol_constant = 14
pub const symbol_enum_member = 22
pub const symbol_struct = 23
pub const message_error = 1
pub const severity_error = 1
pub const severity_warning = 2
pub const sync_full = 1
pub const method_not_found = -32601
pub const invalid_params = -32602
pub const request_failed = -32803
pub const hint_type = 1

pub struct Request {
    pub id: str? = none
    pub method: str = ""
    pub params: json.Value = json.Value.Null
}

pub struct Position {
    pub line: i64 = 0
    pub character: i64 = 0
}

pub struct Range {
    pub start: Position = Position {}
    pub end: Position = Position {}
}

pub struct Location {
    pub uri: str = ""
    pub range: Range = Range {}
}

pub struct Diagnostic {
    pub range: Range = Range {}
    pub severity: i64 = 0
    pub source: str = ""
    pub message: str = ""
}

pub struct DocumentSymbol {
    pub name: str = ""
    pub detail: str = ""
    pub kind: i64 = 0
    pub range: Range = Range {}
    pub selection_range: Range = Range {}
    pub children: []DocumentSymbol = []
}

pub struct CompletionItem {
    pub label: str = ""
    pub kind: i64 = 0
    pub detail: str = ""
}

pub struct TextEdit {
    pub range: Range = Range {}
    pub new_text: str = ""
}

pub struct StringValue {
    pub kind: str = ""
    pub value: str = ""
}

pub struct SnippetTextEdit {
    pub range: Range = Range {}
    pub snippet: StringValue = StringValue {}
}

pub struct TextDocumentEdit {
    pub uri: str = ""
    pub version: i64 = 0
    pub edits: []SnippetTextEdit = []
}

pub struct WorkspaceEdit {
    pub changes: [str: []TextEdit] = [:]
    pub document_changes: []TextDocumentEdit = []
}

pub struct CodeAction {
    pub title: str = ""
    pub kind: str = ""
    pub is_preferred: bool = false
    pub edit: WorkspaceEdit = WorkspaceEdit {}
}

pub struct InlayHint {
    pub position: Position = Position {}
    pub label: str = ""
    pub kind: i64 = 0
}

pub struct SymbolInformation {
    pub name: str = ""
    pub kind: i64 = 0
    pub location: Location = Location {}
    pub container_name: str = ""
}

pub struct ParameterInformation {
    pub start: i64 = 0
    pub end: i64 = 0
}

pub struct SignatureInformation {
    pub label: str = ""
    pub parameters: []ParameterInformation = []
}

pub struct SignatureHelp {
    pub signatures: []SignatureInformation = []
    pub active_signature: i64 = 0
    pub active_parameter: i64 = 0
}

pub struct Hover {
    pub value: str = ""
    pub range: Range = Range {}
}

pub struct PositionParams {
    pub uri: str = ""
    pub position: Position = Position {}
}

pub struct ReferenceParams {
    pub uri: str = ""
    pub position: Position = Position {}
    pub include_declaration: bool = false
}

pub struct RenameParams {
    pub uri: str = ""
    pub position: Position = Position {}
    pub new_name: str = ""
}

pub struct DidOpenParams {
    pub uri: str = ""
    pub version: i64 = 0
    pub text: str = ""
}

pub struct DidChangeParams {
    pub uri: str = ""
    pub version: i64 = 0
    pub texts: []str = []
}

pub struct DocumentParams {
    pub uri: str = ""
}

pub struct RangeParams {
    pub uri: str = ""
    pub range: Range = Range {}
}

pub struct WorkspaceSymbolParams {
    pub query: str = ""
}

pub struct InitializeParams {
    pub refresh_support: bool = false
    pub snippet_support: bool = false
}

pub enum DecodeError {
    Invalid(msg: str)
}

pub fn decode_message(e: DecodeError) -> str {
    match e {
        Invalid(msg) => msg
    }
}

pub fn quote_json(s: str) -> str {
    var out = builder.with_capacity(s.len + 2)
    out.write_byte('"')
    var i = 0
    for i < s.len {
        let r = unicode.decode_rune(s, i)
        if unicode.is_invalid(r) {
            out.write("\\ufffd")
            i += 1
            continue
        }
        quote_rune(mut out, r.code)
        i += r.size
    }
    out.write_byte('"')
    out.to_str()
}

fn quote_rune(mut out: builder.Builder, c: u32) {
    if c == '"' || c == '\\' {
        out.write_byte('\\')
        out.write_byte(u8(c))
    } else if c == '\n' {
        out.write("\\n")
    } else if c == '\r' {
        out.write("\\r")
    } else if c == '\t' {
        out.write("\\t")
    } else if c == 8 {
        out.write("\\b")
    } else if c == 12 {
        out.write("\\f")
    } else if c < 0x20 || c == '<' || c == '>' || c == '&' || c == 0x2028 || c == 0x2029 {
        var hex: []u8 = []
        text.append_hex(mut hex, i64(c), 4, false)
        let digits = str(hex)
        out.write("\\u{digits}")
    } else {
        out.write_char(c)
    }
}

fn put_int(w: *json.Writer, name: str, n: i64) {
    json.property(w, name)
    json.integer(w, n)
}

fn put_bool(w: *json.Writer, name: str, v: bool) {
    json.property(w, name)
    json.boolean(w, v)
}

fn put_str(w: *json.Writer, name: str, s: str) {
    json.property(w, name)
    let quoted = quote_json(s)
    json.raw(w, quoted)
}

fn str_value(w: *json.Writer, s: str) {
    let quoted = quote_json(s)
    json.raw(w, quoted)
}

fn write_position(w: *json.Writer, p: Position) {
    json.start_object(w)
    put_int(w, "line", p.line)
    put_int(w, "character", p.character)
    json.end_object(w)
}

fn write_range(w: *json.Writer, r: Range) {
    json.start_object(w)
    json.property(w, "start")
    write_position(w, r.start)
    json.property(w, "end")
    write_position(w, r.end)
    json.end_object(w)
}

fn write_location(w: *json.Writer, l: Location) {
    json.start_object(w)
    put_str(w, "uri", l.uri)
    json.property(w, "range")
    write_range(w, l.range)
    json.end_object(w)
}

fn write_diagnostic(w: *json.Writer, d: Diagnostic) {
    json.start_object(w)
    json.property(w, "range")
    write_range(w, d.range)
    put_int(w, "severity", d.severity)
    put_str(w, "source", d.source)
    put_str(w, "message", d.message)
    json.end_object(w)
}

fn write_symbol(w: *json.Writer, s: DocumentSymbol) {
    json.start_object(w)
    put_str(w, "name", s.name)
    if s.detail != "" {
        put_str(w, "detail", s.detail)
    }
    put_int(w, "kind", s.kind)
    json.property(w, "range")
    write_range(w, s.range)
    json.property(w, "selectionRange")
    write_range(w, s.selection_range)
    if s.children.len > 0 {
        json.property(w, "children")
        write_symbols(w, s.children)
    }
    json.end_object(w)
}

fn write_symbols(w: *json.Writer, symbols: []DocumentSymbol) {
    json.start_array(w)
    for s in symbols {
        write_symbol(w, s)
    }
    json.end_array(w)
}

fn write_text_edit(w: *json.Writer, e: TextEdit) {
    json.start_object(w)
    json.property(w, "range")
    write_range(w, e.range)
    put_str(w, "newText", e.new_text)
    json.end_object(w)
}

fn write_snippet_edit(w: *json.Writer, e: SnippetTextEdit) {
    json.start_object(w)
    json.property(w, "range")
    write_range(w, e.range)
    json.property(w, "snippet")
    json.start_object(w)
    put_str(w, "kind", e.snippet.kind)
    put_str(w, "value", e.snippet.value)
    json.end_object(w)
    json.end_object(w)
}

fn write_document_edit(w: *json.Writer, d: TextDocumentEdit) {
    json.start_object(w)
    json.property(w, "textDocument")
    json.start_object(w)
    put_str(w, "uri", d.uri)
    put_int(w, "version", d.version)
    json.end_object(w)
    json.property(w, "edits")
    json.start_array(w)
    for e in d.edits {
        write_snippet_edit(w, e)
    }
    json.end_array(w)
    json.end_object(w)
}

fn write_edit(w: *json.Writer, e: WorkspaceEdit) {
    json.start_object(w)
    if e.changes.len > 0 {
        json.property(w, "changes")
        json.start_object(w)
        var uris: []str = []
        for uri in e.changes {
            push(mut uris, uri)
        }
        slices.sort(mut uris)
        for uri in uris {
            json.property(w, uri)
            json.start_array(w)
            for edit in e.changes[uri] ?? [] {
                write_text_edit(w, edit)
            }
            json.end_array(w)
        }
        json.end_object(w)
    }
    if e.document_changes.len > 0 {
        json.property(w, "documentChanges")
        json.start_array(w)
        for d in e.document_changes {
            write_document_edit(w, d)
        }
        json.end_array(w)
    }
    json.end_object(w)
}

pub fn encode_diagnostics(uri: str, diagnostics: []Diagnostic) -> str {
    let w = json.writer(0)
    json.start_object(w)
    put_str(w, "uri", uri)
    json.property(w, "diagnostics")
    json.start_array(w)
    for d in diagnostics {
        write_diagnostic(w, d)
    }
    json.end_array(w)
    json.end_object(w)
    json.written_text(w)
}

pub fn encode_log(kind: i64, message: str) -> str {
    let w = json.writer(0)
    json.start_object(w)
    put_int(w, "type", kind)
    put_str(w, "message", message)
    json.end_object(w)
    json.written_text(w)
}

pub fn encode_hover(h: Hover) -> str {
    let w = json.writer(0)
    json.start_object(w)
    json.property(w, "contents")
    json.start_object(w)
    put_str(w, "kind", "markdown")
    put_str(w, "value", h.value)
    json.end_object(w)
    json.property(w, "range")
    write_range(w, h.range)
    json.end_object(w)
    json.written_text(w)
}

pub fn encode_location(l: Location) -> str {
    let w = json.writer(0)
    write_location(w, l)
    json.written_text(w)
}

pub fn encode_locations(list: []Location) -> str {
    let w = json.writer(0)
    json.start_array(w)
    for l in list {
        write_location(w, l)
    }
    json.end_array(w)
    json.written_text(w)
}

pub fn encode_symbols(symbols: []DocumentSymbol) -> str {
    let w = json.writer(0)
    write_symbols(w, symbols)
    json.written_text(w)
}

pub fn encode_workspace_symbols(list: []SymbolInformation) -> str {
    let w = json.writer(0)
    json.start_array(w)
    for s in list {
        json.start_object(w)
        put_str(w, "name", s.name)
        put_int(w, "kind", s.kind)
        json.property(w, "location")
        write_location(w, s.location)
        if s.container_name != "" {
            put_str(w, "containerName", s.container_name)
        }
        json.end_object(w)
    }
    json.end_array(w)
    json.written_text(w)
}

pub fn encode_completion(items: []CompletionItem) -> str {
    let w = json.writer(0)
    json.start_object(w)
    put_bool(w, "isIncomplete", false)
    json.property(w, "items")
    if items.len == 0 {
        json.null(w)
    } else {
        json.start_array(w)
        for item in items {
            json.start_object(w)
            put_str(w, "label", item.label)
            put_int(w, "kind", item.kind)
            if item.detail != "" {
                put_str(w, "detail", item.detail)
            }
            json.end_object(w)
        }
        json.end_array(w)
    }
    json.end_object(w)
    json.written_text(w)
}

pub fn encode_signature_help(h: SignatureHelp) -> str {
    let w = json.writer(0)
    json.start_object(w)
    json.property(w, "signatures")
    json.start_array(w)
    for s in h.signatures {
        json.start_object(w)
        put_str(w, "label", s.label)
        json.property(w, "parameters")
        json.start_array(w)
        for p in s.parameters {
            json.start_object(w)
            json.property(w, "label")
            json.start_array(w)
            json.integer(w, p.start)
            json.integer(w, p.end)
            json.end_array(w)
            json.end_object(w)
        }
        json.end_array(w)
        json.end_object(w)
    }
    json.end_array(w)
    put_int(w, "activeSignature", h.active_signature)
    put_int(w, "activeParameter", h.active_parameter)
    json.end_object(w)
    json.written_text(w)
}

pub fn encode_edit(e: WorkspaceEdit) -> str {
    let w = json.writer(0)
    write_edit(w, e)
    json.written_text(w)
}

pub fn encode_hints(hints: []InlayHint) -> str {
    let w = json.writer(0)
    json.start_array(w)
    for h in hints {
        json.start_object(w)
        json.property(w, "position")
        write_position(w, h.position)
        put_str(w, "label", h.label)
        put_int(w, "kind", h.kind)
        json.end_object(w)
    }
    json.end_array(w)
    json.written_text(w)
}

pub fn encode_actions(actions: []CodeAction) -> str {
    let w = json.writer(0)
    json.start_array(w)
    for a in actions {
        json.start_object(w)
        put_str(w, "title", a.title)
        put_str(w, "kind", a.kind)
        if a.is_preferred {
            put_bool(w, "isPreferred", true)
        }
        json.property(w, "edit")
        write_edit(w, a.edit)
        json.end_object(w)
    }
    json.end_array(w)
    json.written_text(w)
}

fn put_strings(w: *json.Writer, name: str, items: []str) {
    json.property(w, name)
    json.start_array(w)
    for item in items {
        str_value(w, item)
    }
    json.end_array(w)
}

pub fn encode_initialize() -> str {
    let w = json.writer(0)
    json.start_object(w)
    json.property(w, "capabilities")
    json.start_object(w)
    json.property(w, "textDocumentSync")
    json.start_object(w)
    put_bool(w, "openClose", true)
    put_int(w, "change", sync_full)
    json.property(w, "save")
    json.start_object(w)
    put_bool(w, "includeText", false)
    json.end_object(w)
    json.end_object(w)
    put_bool(w, "hoverProvider", true)
    put_bool(w, "definitionProvider", true)
    put_bool(w, "referencesProvider", true)
    put_bool(w, "renameProvider", true)
    put_bool(w, "documentSymbolProvider", true)
    json.property(w, "completionProvider")
    json.start_object(w)
    put_strings(w, "triggerCharacters", ["."])
    json.end_object(w)
    json.property(w, "signatureHelpProvider")
    json.start_object(w)
    put_strings(w, "triggerCharacters", ["(", ","])
    put_strings(w, "retriggerCharacters", [","])
    json.end_object(w)
    put_bool(w, "inlayHintProvider", true)
    put_bool(w, "workspaceSymbolProvider", true)
    put_bool(w, "codeActionProvider", true)
    json.end_object(w)
    json.property(w, "serverInfo")
    json.start_object(w)
    put_str(w, "name", "low")
    json.end_object(w)
    json.end_object(w)
    json.written_text(w)
}

fn id_text(id: str?) -> str {
    id ?? "null"
}

pub fn response_body(id: str?, result: str) -> str {
    let w = json.writer(0)
    json.start_object(w)
    put_str(w, "jsonrpc", "2.0")
    json.property(w, "id")
    json.raw(w, id_text(id))
    json.property(w, "result")
    json.raw(w, result)
    json.end_object(w)
    json.written_text(w)
}

pub fn error_body(id: str?, code: i64, message: str) -> str {
    let w = json.writer(0)
    json.start_object(w)
    put_str(w, "jsonrpc", "2.0")
    json.property(w, "id")
    json.raw(w, id_text(id))
    json.property(w, "error")
    json.start_object(w)
    put_int(w, "code", code)
    put_str(w, "message", message)
    json.end_object(w)
    json.end_object(w)
    json.written_text(w)
}

pub fn notification_body(method: str, params: str) -> str {
    let w = json.writer(0)
    json.start_object(w)
    put_str(w, "jsonrpc", "2.0")
    put_str(w, "method", method)
    json.property(w, "params")
    json.raw(w, params)
    json.end_object(w)
    json.written_text(w)
}

pub fn server_request_body(id: i64, method: str) -> str {
    let w = json.writer(0)
    json.start_object(w)
    put_str(w, "jsonrpc", "2.0")
    put_int(w, "id", id)
    put_str(w, "method", method)
    json.end_object(w)
    json.written_text(w)
}

struct Decoder {
    owner: str
}

fn kind_text(v: json.Value) -> str {
    match v {
        Null => "null"
        Bool(_) => "bool"
        Int(_) => "number"
        Float(_) => "number"
        Str(_) => "string"
        Array(_) => "array"
        Object(_) => "object"
    }
}

fn mismatch(d: Decoder, v: json.Value, path: str, go_type: str) -> DecodeError {
    var kind = kind_text(v)
    match v {
        Float(_) => {
            if go_type == "int" {
                kind = "number {json.stringify(v, 0)}"
            }
        }
        _ => {}
    }
    DecodeError.Invalid("json: cannot unmarshal {kind} into Go struct field {d.owner}.{path} of type {go_type}")
}

fn member(v: json.Value, name: str) -> json.Value {
    var found = json.Value.Null
    match v {
        Object(members) => {
            for m in members {
                if text.equal_fold(m.name, name) {
                    found = m.value
                }
            }
        }
        _ => {}
    }
    found
}

fn join_path(path: str, name: str) -> str {
    if path == "" {
        return name
    }
    "{path}.{name}"
}

fn decode_str(d: Decoder, v: json.Value, path: str) -> str ! DecodeError {
    match v {
        Null => ""
        Str(s) => s
        _ => fail mismatch(d, v, path, "string")
    }
}

fn decode_int(d: Decoder, v: json.Value, path: str) -> i64 ! DecodeError {
    match v {
        Null => 0
        Int(n) => n
        _ => fail mismatch(d, v, path, "int")
    }
}

fn decode_bool(d: Decoder, v: json.Value, path: str) -> bool ! DecodeError {
    match v {
        Null => false
        Bool(b) => b
        _ => fail mismatch(d, v, path, "bool")
    }
}

fn check_object(d: Decoder, v: json.Value, path: str, go_type: str) ! DecodeError {
    match v {
        Null => {}
        Object(_) => {}
        _ => fail mismatch(d, v, path, go_type)
    }
}

fn decode_position(d: Decoder, v: json.Value, path: str) -> Position ! DecodeError {
    check_object(d, v, path, "lsp.Position")?
    let line = decode_int(d, member(v, "line"), join_path(path, "line"))?
    let character = decode_int(d, member(v, "character"), join_path(path, "character"))?
    Position { line, character }
}

fn decode_range(d: Decoder, v: json.Value, path: str) -> Range ! DecodeError {
    check_object(d, v, path, "lsp.Range")?
    let start = decode_position(d, member(v, "start"), join_path(path, "start"))?
    let end = decode_position(d, member(v, "end"), join_path(path, "end"))?
    Range { start, end }
}

fn decode_document(d: Decoder, v: json.Value, path: str) -> str ! DecodeError {
    check_object(d, v, path, "lsp.TextDocumentIdentifier")?
    decode_str(d, member(v, "uri"), join_path(path, "uri"))?
}

fn top(owner: str, v: json.Value) -> Decoder ! DecodeError {
    match v {
        Null => {}
        Object(_) => {}
        _ => {
            let kind = kind_text(v)
            fail DecodeError.Invalid("json: cannot unmarshal {kind} into Go value of type lsp.{owner}")
        }
    }
    Decoder { owner }
}

pub fn decode_position_params(v: json.Value) -> PositionParams ! DecodeError {
    let d = top("TextDocumentPositionParams", v)?
    let uri = decode_document(d, member(v, "textDocument"), "textDocument")?
    let position = decode_position(d, member(v, "position"), "position")?
    PositionParams { uri, position }
}

pub fn decode_reference_params(v: json.Value) -> ReferenceParams ! DecodeError {
    let d = top("ReferenceParams", v)?
    let uri = decode_document(d, member(v, "textDocument"), "textDocument")?
    let position = decode_position(d, member(v, "position"), "position")?
    let context = member(v, "context")
    check_object(d, context, "context", "lsp.ReferenceContext")?
    let include = decode_bool(d, member(context, "includeDeclaration"), "context.includeDeclaration")?
    ReferenceParams { uri, position, include_declaration: include }
}

pub fn decode_rename_params(v: json.Value) -> RenameParams ! DecodeError {
    let d = top("RenameParams", v)?
    let uri = decode_document(d, member(v, "textDocument"), "textDocument")?
    let position = decode_position(d, member(v, "position"), "position")?
    let new_name = decode_str(d, member(v, "newName"), "newName")?
    RenameParams { uri, position, new_name }
}

pub fn decode_open_params(v: json.Value) -> DidOpenParams ! DecodeError {
    let d = top("DidOpenParams", v)?
    let item = member(v, "textDocument")
    check_object(d, item, "textDocument", "lsp.TextDocumentItem")?
    let uri = decode_str(d, member(item, "uri"), "textDocument.uri")?
    let version = decode_int(d, member(item, "version"), "textDocument.version")?
    let body = decode_str(d, member(item, "text"), "textDocument.text")?
    DidOpenParams { uri, version, text: body }
}

pub fn decode_change_params(v: json.Value) -> DidChangeParams ! DecodeError {
    let d = top("DidChangeParams", v)?
    let item = member(v, "textDocument")
    check_object(d, item, "textDocument", "lsp.VersionedTextDocumentIdentifier")?
    let uri = decode_str(d, member(item, "uri"), "textDocument.uri")?
    let version = decode_int(d, member(item, "version"), "textDocument.version")?
    var texts: []str = []
    let changes = member(v, "contentChanges")
    match changes {
        Null => {}
        Array(items) => {
            for i, change in items {
                match change {
                    Null => push(mut texts, "")
                    Object(_) => {
                        let body = decode_str(d, member(change, "text"), "contentChanges.text")?
                        push(mut texts, body)
                    }
                    _ => {
                        let kind = kind_text(change)
                        fail DecodeError.Invalid("json: cannot unmarshal {kind} into DidChangeParams.contentChanges.{i} of type lsp.ContentChange")
                    }
                }
            }
        }
        _ => fail mismatch(d, changes, "contentChanges", "[]lsp.ContentChange")
    }
    DidChangeParams { uri, version, texts }
}

pub fn decode_document_params(v: json.Value) -> DocumentParams ! DecodeError {
    let d = top("DocumentParams", v)?
    let uri = decode_document(d, member(v, "textDocument"), "textDocument")?
    DocumentParams { uri }
}

pub fn decode_range_params(owner: str, v: json.Value) -> RangeParams ! DecodeError {
    let d = top(owner, v)?
    let uri = decode_document(d, member(v, "textDocument"), "textDocument")?
    let range = decode_range(d, member(v, "range"), "range")?
    RangeParams { uri, range }
}

pub fn decode_workspace_symbol_params(v: json.Value) -> WorkspaceSymbolParams ! DecodeError {
    let d = top("WorkspaceSymbolParams", v)?
    let query = decode_str(d, member(v, "query"), "query")?
    WorkspaceSymbolParams { query }
}

pub fn decode_initialize_params(v: json.Value) -> InitializeParams ! DecodeError {
    let d = top("InitializeParams", v)?
    let capabilities = member(v, "capabilities")
    check_object(d, capabilities, "capabilities", "lsp.ClientCapabilities")?
    let workspace = member(capabilities, "workspace")
    check_object(d, workspace, "capabilities.workspace", "lsp.WorkspaceClient")?
    let hint = member(workspace, "inlayHint")
    check_object(d, hint, "capabilities.workspace.inlayHint", "lsp.InlayHintClient")?
    let refresh = decode_bool(d, member(hint, "refreshSupport"), "capabilities.workspace.inlayHint.refreshSupport")?
    let edit = member(workspace, "workspaceEdit")
    check_object(d, edit, "capabilities.workspace.workspaceEdit", "lsp.WorkspaceEditClient")?
    let snippet = decode_bool(d, member(edit, "snippetEditSupport"), "capabilities.workspace.workspaceEdit.snippetEditSupport")?
    InitializeParams { refresh_support: refresh, snippet_support: snippet }
}

pub struct Wire {
    pub reader: *io.Reader
    pub out: io.Stream
}

pub enum ReadError {
    Closed
    Failed(msg: str)
}

pub fn read_error_message(e: ReadError) -> str {
    match e {
        Closed => "end of input"
        Failed(msg) => msg
    }
}

pub fn new_wire(input: io.Stream, out: io.Stream) -> Wire {
    Wire { reader: io.reader(input), out }
}

fn read_length(wire: Wire) -> i64 ! ReadError {
    var length: str? = none
    var first = true
    for {
        let line = io.read_line(wire.reader) catch {
            Eof => {
                if first {
                    fail ReadError.Closed
                }
                fail ReadError.Failed("unexpected EOF")
            }
            e => fail ReadError.Failed("read header: {io_text(e)}")
        }
        first = false
        if line == "" {
            break
        }
        let colon = text.index_byte(line, ':')
        if colon < 0 {
            fail ReadError.Failed("malformed MIME header: missing colon: {diag.quote(line)}")
        }
        let key = line[..colon]
        if text.equal_fold(key, "Content-Length") && length == none {
            length = text.trim(line[colon + 1..])
        }
    }
    let raw = length ?? ""
    text.parse_int(raw) catch {
        e => fail ReadError.Failed("invalid Content-Length: strconv.Atoi: parsing {quote_json(raw)}: invalid syntax")
    }
}

fn io_text(e: io.Error) -> str {
    match e {
        Eof => "EOF"
        TooLarge => "header too large"
        _ => "input error"
    }
}

fn read_body(wire: Wire) -> []u8 ! ReadError {
    let length = read_length(wire)?
    if length < 0 {
        fail ReadError.Failed("invalid Content-Length: negative")
    }
    io.read_exact(wire.reader, length) catch {
        Eof => fail ReadError.Failed("unexpected EOF")
        e => fail ReadError.Failed("read body: {io_text(e)}")
    }
}

fn find_id(body: []u8) -> str? {
    let r = json.reader(body)
    json.read(r) or return none
    var found: str? = none
    for {
        let more = json.read(r) or return found
        if !more {
            return found
        }
        if json.token(r) != json.Token.PropertyName || json.depth(r) != 1 {
            continue
        }
        let name = json.get_string(r) or return found
        let before = json.position(r)
        json.read(r) or return found
        let is_id = text.equal_fold(name, "id")
        if is_id {
            found = raw_id(r, body, before)
        }
        json.skip(r) or return found
    }
    found
}

fn raw_id(r: *json.Reader, body: []u8, before: i64) -> str? {
    let token = json.token(r)
    if token == json.Token.String {
        let s = json.get_string(r) or return none
        return quote_json(s)
    }
    if token == json.Token.StartObject || token == json.Token.StartArray {
        json.skip(r) or return none
        let after = json.position(r)
        let whole = json.parse(body[before..after]) or return none
        return json.stringify(whole, 0)
    }
    let raw = json.value_bytes(r)
    str(raw)
}

pub fn read_request(wire: Wire) -> Request ! ReadError {
    let body = read_body(wire)?
    let root = json.parse(body) catch {
        e => fail ReadError.Failed("invalid message: {parse_failure(e)}")
    }
    match root {
        Object(_) => {}
        _ => {
            let kind = kind_text(root)
            fail ReadError.Failed("invalid message: json: cannot unmarshal {kind} into Go value of type lsp.request")
        }
    }
    let method_value = member(root, "method")
    var method = ""
    match method_value {
        Null => {}
        Str(s) => {
            method = s
        }
        _ => {
            let kind = kind_text(method_value)
            fail ReadError.Failed("invalid message: json: cannot unmarshal {kind} into Go struct field request.method of type string")
        }
    }
    let id = find_id(body)
    Request { id, method, params: member(root, "params") }
}

fn parse_failure(e: serde.Error) -> str {
    match e {
        Syntax(at, message) => "{message} at offset {at}"
        _ => "invalid JSON"
    }
}

pub fn write_message(wire: Wire, body: str) ! io.Error {
    let header = "Content-Length: {body.len}\r\n\r\n"
    io.write_str(wire.out, "{header}{body}")?
}
