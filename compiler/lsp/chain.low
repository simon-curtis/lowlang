pub struct Segment {
    pub name: str
    pub suffixes: []u8 = []
}

pub fn segment_plain(s: Segment) -> bool {
    s.suffixes.len == 0
}

struct Group {
    start: i64
    open: u8
}

fn prepended_byte(head: u8, rest: []u8) -> []u8 {
    var out: []u8 = [head]
    for b in rest {
        push(mut out, b)
    }
    out
}

fn prepended_segment(head: Segment, rest: []Segment) -> []Segment {
    var out: []Segment = [head]
    for s in rest {
        push(mut out, s)
    }
    out
}

fn skip_group(src: str, end: i64) -> Group {
    let shut = src[end - 1]
    var open: u8 = '('
    if shut == ']' {
        open = '['
    }
    var depth = 0
    var i = end - 1
    for i >= 0 {
        let c = src[i]
        if c == shut {
            depth += 1
        } else if c == open {
            depth -= 1
            if depth == 0 {
                return Group { start: i, open }
            }
        }
        i -= 1
    }
    Group { start: -1, open }
}

struct Trailing {
    suffixes: []u8
    end: i64
}

fn trailing(src: str, from: i64) -> Trailing? {
    var suffixes: []u8 = []
    var end = from
    for end > 0 {
        let c = src[end - 1]
        if c == ')' || c == ']' {
            let group = skip_group(src, end)
            if group.start < 0 {
                return none
            }
            suffixes = prepended_byte(group.open, suffixes)
            end = group.start
        } else if c == '?' {
            suffixes = prepended_byte('?', suffixes)
            end -= 1
        } else {
            break
        }
    }
    Trailing { suffixes, end }
}

pub fn segments_before(src: str, from: i64) -> []Segment? {
    var segments: []Segment = []
    var end = from
    for {
        let tail = trailing(src, end) ?? return none
        let suffixes = tail.suffixes
        end = tail.end
        var start = end
        for start > 0 && is_word(src[start - 1]) {
            start -= 1
        }
        if start == end {
            return none
        }
        segments = prepended_segment(Segment { name: src[start..end], suffixes }, segments)
        if start == 0 || src[start - 1] != '.' {
            return segments
        }
        end = start - 1
    }
}

pub fn callee_chain(segments: []Segment) -> []str {
    var names: []str = []
    for i, s in segments {
        let last = i == segments.len - 1
        let indexed = s.suffixes.len == 1 && s.suffixes[0] == '['
        if !segment_plain(s) && !(last && indexed) {
            return []
        }
        push(mut names, s.name)
    }
    names
}
