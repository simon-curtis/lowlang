import ast
import diag
import std/path
import std/unicode
import std/text

pub fn outline(file: *ast.File, t: Text) -> []DocumentSymbol {
    var symbols: []DocumentSymbol = []
    for e in file.externs {
        let item = extern_symbol(e, t)
        push(mut symbols, item)
    }
    for d in file.structs {
        let item = struct_symbol(d, t)
        push(mut symbols, item)
    }
    for d in file.enums {
        let item = enum_symbol(d, t)
        push(mut symbols, item)
    }
    for k in file.consts {
        let item = const_symbol(k, t)
        push(mut symbols, item)
    }
    for f in ast.declared_funcs(file) {
        if f.external == none {
            let item = func_symbol(f, t)
            push(mut symbols, item)
        }
    }
    symbols
}

fn symbol(t: Text, pos: diag.Pos, name: str, detail: str, kind: i64) -> DocumentSymbol {
    let covered = span(t, pos, name.len)
    DocumentSymbol { name, detail, kind, range: covered, selection_range: covered }
}

fn func_symbol(f: *ast.Func, t: Text) -> DocumentSymbol {
    let pos = name_after(t, f.pos, f.name)
    symbol(t, pos, f.name, ast.signature(f), symbol_function)
}

fn const_symbol(k: *ast.Const, t: Text) -> DocumentSymbol {
    let pos = name_after(t, k.pos, k.name)
    symbol(t, pos, k.name, ast.const_text(k), symbol_constant)
}

fn extern_symbol(e: *ast.Extern, t: Text) -> DocumentSymbol {
    var s = symbol(t, e.pos, "extern", "", symbol_namespace)
    s.name = "extern {diag.quote(e.library)}"
    for f in e.funcs {
        let item = func_symbol(f, t)
        push(mut s.children, item)
    }
    s
}

fn struct_symbol(d: *ast.StructDecl, t: Text) -> DocumentSymbol {
    let pos = name_after(t, d.pos, d.name)
    var s = symbol(t, pos, d.name, "struct", symbol_struct)
    for f in d.fields {
        let item = symbol(t, f.pos, f.name, ast.type_text(f.type_name), symbol_field)
        push(mut s.children, item)
    }
    s
}

fn enum_symbol(d: *ast.EnumDecl, t: Text) -> DocumentSymbol {
    let pos = name_after(t, d.pos, d.name)
    var s = symbol(t, pos, d.name, "enum", symbol_enum)
    for v in d.variants {
        let item = symbol(t, v.pos, v.name, ast.variant_text(v), symbol_enum_member)
        push(mut s.children, item)
    }
    s
}

struct SymbolSearch {
    query: str
    seen: [str: bool] = [:]
    found: []SymbolInformation = []
}

fn add_symbol(w: *SymbolSearch, name: str, kind: i64, loc: Location, container: str) {
    let key = location_key(loc)
    if !text.contains(unicode.lower(name), w.query) || w.seen[key] != none {
        return
    }
    w.seen[key] = true
    let found = SymbolInformation { name, kind, location: loc, container_name: container }
    push(mut w.found, found)
}

struct SymbolFile {
    uri: str
    text: Text
}

fn symbol_at(f: SymbolFile, pos: diag.Pos, name: str) -> Location {
    let start = name_after(f.text, pos, name)
    Location { uri: f.uri, range: word(f.text, start) }
}

fn search_file(w: *SymbolSearch, f: *ast.File, t: Text) {
    let sf = SymbolFile { uri: uri_of(f.path), text: t }
    var container = f.module
    if container == "" {
        container = path.base(f.path)
    }
    for fn_decl in ast.declared_funcs(f) {
        add_symbol(w, fn_decl.name, symbol_function, symbol_at(sf, fn_decl.pos, fn_decl.name), container)
    }
    for k in f.consts {
        add_symbol(w, k.name, symbol_constant, symbol_at(sf, k.pos, k.name), container)
    }
    for d in f.structs {
        add_symbol(w, d.name, symbol_struct, symbol_at(sf, d.pos, d.name), container)
    }
    for d in f.enums {
        add_symbol(w, d.name, symbol_enum, symbol_at(sf, d.pos, d.name), container)
        for v in d.variants {
            add_symbol(w, v.name, symbol_enum_member, symbol_at(sf, v.pos, v.name), d.name)
        }
    }
}

pub fn workspace_symbols(s: *Server, p: WorkspaceSymbolParams) -> str {
    let w = new(SymbolSearch { query: unicode.lower(p.query) })
    for entry in s.entries {
        let state = s.entries[entry] ?? continue
        for f in program_files(entry_program(state, s.tables)) {
            search_file(w, f, server_text(s, f.path))
        }
    }
    encode_workspace_symbols(w.found)
}
