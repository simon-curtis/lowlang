import ast
import types
import std/io

pub fn inlay_hints(s: *Server, p: RangeParams) -> str {
    var hints: []InlayHint = []
    let file_path = path_of(p.uri)
    let file = server_checked(s, file_path) ?? return encode_hints(hints)
    let state = state_of(s, file_path)
    if !state.fresh {
        return encode_hints(hints)
    }
    let x = new_index(file, server_text(s, file_path))
    for o in x.occurrences {
        if !inferred(o) {
            continue
        }
        let local = o.local ?? continue
        let t = local.type ?? continue
        let line = o.pos.line - 1
        if line < p.range.start.line || line > p.range.end.line {
            continue
        }
        var end = o.pos
        end.col += o.name.len
        let hint = InlayHint { position: position_of(x.text, end), label: ": {types.text(t)}", kind: hint_type }
        push(mut hints, hint)
    }
    encode_hints(hints)
}

fn inferred(o: *Occurrence) -> bool {
    if o.local == none {
        return false
    }
    match o.anchor {
        Let(n) => n.type_name == none
        ForIn(_) => true
        _ => false
    }
}

pub fn refresh_hints(s: *Server) ! io.Error {
    if !s.hint_refresh {
        return
    }
    s.requests += 1
    let body = server_request_body(s.requests, "workspace/inlayHint/refresh")
    write_message(s.wire, body)?
}
