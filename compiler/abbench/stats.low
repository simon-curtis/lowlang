import std/slices

const resamples = 2000

struct Interval {
    estimate: f64
    low: f64
    high: f64
}

fn median(values: []f64) -> f64 {
    if values.len == 0 {
        return 0.0
    }
    var sorted: []f64 = []
    for v in values {
        sorted.push(v)
    }
    slices.sort(mut sorted)
    let middle = sorted.len / 2
    if sorted.len % 2 == 1 {
        return sorted[middle]
    }
    (sorted[middle - 1] + sorted[middle]) / 2.0
}

fn quantile(sorted: []f64, q: f64) -> f64 {
    let last = sorted.len - 1
    let at = i64(q * f64(last))
    sorted[at]
}

struct Random {
    state: u64
}

fn next_index(r: *Random, n: i64) -> i64 {
    var x = r.state
    x = x ^ (x << 13)
    x = x ^ (x >> 7)
    x = x ^ (x << 17)
    r.state = x
    i64(x % u64(n))
}

fn ratio_interval(ratios: []f64) -> Interval {
    let estimate = median(ratios)
    if ratios.len < 2 {
        return Interval { estimate, low: estimate, high: estimate }
    }
    let r = new(Random { state: 0x9E3779B97F4A7C15 })
    var medians: []f64 = []
    var sample: []f64 = []
    for _ in 0..resamples {
        sample.truncate(0)
        for _ in 0..ratios.len {
            let pick = r.next_index(ratios.len)
            sample.push(ratios[pick])
        }
        medians.push(median(sample))
    }
    slices.sort(mut medians)
    let low = quantile(medians, 0.025)
    let high = quantile(medians, 0.975)
    Interval { estimate, low, high }
}

fn spread(values: []f64) -> f64 {
    if values.len < 4 {
        return 0.0
    }
    var sorted: []f64 = []
    for v in values {
        sorted.push(v)
    }
    slices.sort(mut sorted)
    let middle = median(sorted)
    if middle == 0.0 {
        return 0.0
    }
    (quantile(sorted, 0.75) - quantile(sorted, 0.25)) / middle
}
