import compiler
import std/perf
import std/process
import std/time

const peak_metric = "peak resident"

struct Probe {
    pid: i64
    started: i64
    cycles: perf.Counter?
    instructions: perf.Counter?
}

fn measurable(c: process.Command) -> process.Command ! Error {
    perf.held(c) catch {
        e => fail Failed("{c.program}: {compiler.reason(e)}")
    }
}

fn counting(pid: i64, s: perf.Source) -> perf.Counter? {
    let c = perf.counter(pid, s) or return none
    c
}

fn probe(pid: i64) -> Probe ! Error {
    perf.await_held(pid) catch {
        e => fail Failed("process {pid} did not start: {compiler.reason(e)}")
    }
    let cycles = counting(pid, perf.cycles())
    let instructions = counting(pid, perf.instructions())
    let started = time.monotonic()
    perf.release(pid) catch {
        e => fail Failed("process {pid} did not start: {compiler.reason(e)}")
    }
    Probe { pid, started, cycles, instructions }
}

fn began(p: Probe, launched: i64) -> i64 {
    p.started
}

fn counted(c: perf.Counter?) -> i64 {
    perf.count(c ?? return 0) or 0
}

fn read_usage(p: Probe) -> Reading {
    var found = Reading { cycles: counted(p.cycles), instructions: counted(p.instructions) }
    let used = perf.usage(p.pid) ?? return found
    found.cpu = used.user + used.kernel
    found.peak = used.peak_resident
    found
}

fn restrict_cpus(mask: u64) ! Error {
    perf.restrict_cpus(mask) catch {
        _ => fail Failed("cannot set the affinity mask {mask}")
    }
}
