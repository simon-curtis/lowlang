import emit
import std/file
import std/filepath
import std/flag
import std/os
import std/process
import std/text
import std/time

enum Error {
    Misuse(message: str)
    Failed(message: str)
}

struct Reading {
    wall: i64 = 0
    cpu: i64 = 0
    cycles: i64 = 0
    peak_private: i64 = 0
}

struct Config {
    a: str
    b: str
    runs: i64
    warmup: i64
    affinity: i64
    dir: str
    same: str
    template: []str
}

struct Metric {
    name: str
    unit: str
    scale: f64
    read: fn(Reading) -> i64
}

fn flag_specs() -> []flag.Spec {
    [
        flag.Spec { name: "a", help: "the program that replaces {{exe}} on side a" }
        flag.Spec { name: "b", help: "the program that replaces {{exe}} on side b" }
        flag.Spec { name: "runs", help: "timed runs of each side, at least 5", fallback: "15" }
        flag.Spec { name: "warmup", help: "untimed runs of each side before the timed runs", fallback: "1" }
        flag.Spec { name: "affinity", help: "hexadecimal mask of the CPUs every run may use" }
        flag.Spec { name: "dir", help: "the directory the command runs in" }
        flag.Spec { name: "same", help: "a file the command writes, with {{side}} in its path and relative to -dir, that must be byte-identical on both sides" }
    ]
}

fn usage_text() -> str {
    let program = os.args()[0]
    "usage: {program} -a program -b program [flags] -- command with {{exe}} and {{side}}...\n{flag.usage(flag_specs())}"
}

fn main() {
    run_command(os.args()[1..]) catch {
        Misuse(message) => {
            emit.eprint(message)
            os.exit(2)
        }
        Failed(message) => {
            emit.eprint("abbench: {message}")
            os.exit(1)
        }
    }
}

fn run_command(arguments: []str) ! Error {
    let config = parse_config(arguments)?
    if config.affinity != 0 {
        restrict_cpus(config.affinity)?
    }
    let readings = compare(config)?
    report(config, readings)
}

fn parse_config(arguments: []str) -> Config ! Error {
    let parsed = flag.parse(flag_specs(), arguments) catch {
        _ => fail Misuse(usage_text())
    }
    let runs = flag.number(parsed, "runs") catch {
        _ => fail Misuse(usage_text())
    }
    let warmup = flag.number(parsed, "warmup") catch {
        _ => fail Misuse(usage_text())
    }
    let a = flag.get(parsed, "a")
    let b = flag.get(parsed, "b")
    if a == "" || b == "" || parsed.rest.len == 0 || runs < 5 || warmup < 0 {
        fail Misuse(usage_text())
    }
    let mask = flag.get(parsed, "affinity")
    let affinity = parse_hex(mask) ?? fail Misuse("-affinity {mask} is not a hexadecimal mask")
    Config { a, b, runs, warmup, affinity, dir: flag.get(parsed, "dir"), same: flag.get(parsed, "same"), template: parsed.rest }
}

fn parse_hex(spelled: str) -> i64? {
    let digits = text.trim_prefix(text.trim_prefix(spelled, "0x"), "0X")
    var value = 0
    for c in digits.bytes() {
        let digit = hex_digit(c) ?? return none
        value = value * 16 + digit
    }
    value
}

fn hex_digit(c: u8) -> i64? {
    if c >= '0' && c <= '9' {
        return i64(c - '0')
    }
    if c >= 'a' && c <= 'f' {
        return i64(c - 'a') + 10
    }
    if c >= 'A' && c <= 'F' {
        return i64(c - 'A') + 10
    }
    none
}

struct Readings {
    a: []Reading
    b: []Reading
}

fn compare(config: Config) -> Readings ! Error {
    let checked = config.same != ""
    if checked {
        clear_same(config)
    }
    for i in 0..config.warmup {
        emit.eprint("warmup {i + 1}/{config.warmup}")
        measure(config, "a")?
        measure(config, "b")?
    }
    if checked && config.warmup > 0 {
        check_same(config)?
    }
    var a: []Reading = []
    var b: []Reading = []
    for i in 0..config.runs {
        emit.eprint("run {i + 1}/{config.runs}")
        if i % 2 == 0 {
            a.push(measure(config, "a")?)
            b.push(measure(config, "b")?)
        } else {
            b.push(measure(config, "b")?)
            a.push(measure(config, "a")?)
        }
    }
    if checked {
        check_same(config)?
    }
    Readings { a, b }
}

fn expand(word: str, config: Config, side: str) -> str {
    let program = if side == "a" { config.a } else { config.b }
    let named = text.replace(word, "{{exe}}", program)
    text.replace(named, "{{side}}", side)
}

fn command_for(config: Config, side: str) -> process.Command {
    var args: []str = []
    for word in config.template[1..] {
        args.push(expand(word, config, side))
    }
    let program = expand(config.template[0], config, side)
    var c = process.command(program, args)
    c.dir = config.dir
    c.stdin = Null
    c.stdout = Null
    c.stderr = Null
    c
}

fn measure(config: Config, side: str) -> Reading ! Error {
    let c = command_for(config, side)
    let start = time.monotonic()
    let handle = process.start_handle(c) catch {
        e => fail Failed("{side}: {c.program}: {emit.io_message(e)}")
    }
    using child = process.adopt(handle)
    let p = probe(handle.pid)?
    process.wait_exit_on(handle) catch {
        e => fail Failed("{side}: {emit.io_message(e)}")
    }
    let wall = time.monotonic() - start
    var found = read_usage(p)
    found.wall = wall
    let exit = process.wait(child) catch {
        e => fail Failed("{side}: {emit.io_message(e)}")
    }
    if !process.success(exit) {
        fail Failed("{side}: {c.program} {exit_text(exit)}")
    }
    found
}

fn exit_text(e: process.Exit) -> str {
    match e {
        Exited(code) => "exited with status {code}"
        Signaled(_) => "ended on a signal"
    }
}

fn same_path(config: Config, side: str) -> str {
    let named = text.replace(config.same, "{{side}}", side)
    if config.dir == "" || filepath.is_absolute(named) {
        return named
    }
    file.child_path(config.dir, named)
}

fn clear_same(config: Config) {
    for side in ["a", "b"] {
        let stale = same_path(config, side)
        file.remove(stale) or {}
    }
}

fn check_same(config: Config) ! Error {
    let first = same_path(config, "a")
    let second = same_path(config, "b")
    let left = file.read_file(first) catch {
        e => fail Failed("{first}: {emit.io_message(e)}")
    }
    let right = file.read_file(second) catch {
        e => fail Failed("{second}: {emit.io_message(e)}")
    }
    if str(left) != str(right) {
        fail Failed("{first} and {second} differ")
    }
    emit.eprint("{first} and {second} are identical")
}

fn metrics() -> []Metric {
    [
        Metric { name: "wall", unit: "ms", scale: 1000000.0, read: fn(r) r.wall }
        Metric { name: "cpu", unit: "ms", scale: 1000000.0, read: fn(r) r.cpu }
        Metric { name: "cycles", unit: "G", scale: 1000000000.0, read: fn(r) r.cycles }
        Metric { name: "peak private", unit: "MB", scale: 1048576.0, read: fn(r) r.peak_private }
    ]
}

fn values(readings: []Reading, m: Metric) -> []f64 {
    var out: []f64 = []
    for r in readings {
        out.push(f64(m.read(r)))
    }
    out
}

fn ratios(a: []f64, b: []f64) -> []f64 {
    var out: []f64 = []
    for i in 0..a.len {
        if a[i] > 0.0 {
            out.push(b[i] / a[i])
        }
    }
    out
}

fn verdict(i: Interval) -> str {
    if i.high < 1.0 {
        return "b lower"
    }
    if i.low > 1.0 {
        return "b higher"
    }
    "no difference"
}

fn report(config: Config, readings: Readings) ! Error {
    print("a: {config.a}")
    print("b: {config.b}")
    print("{config.runs} runs of each side, alternating ab and ba")
    print("")
    let header = [cell("metric", 14, false), cell("a median", 14, true), cell("a spread", 10, true), cell("b median", 14, true), cell("b spread", 10, true), cell("b/a", 8, true), cell("95% interval", 20, true), "  verdict"]
    print(text.join(header, ""))
    for m in metrics() {
        let a = values(readings.a, m)
        let b = values(readings.b, m)
        let paired = ratios(a, b)
        if paired.len == 0 {
            continue
        }
        let interval = ratio_interval(paired)
        let row = [
            cell(m.name, 14, false)
            cell("{text.fixed(median(a) / m.scale, 3)} {m.unit}", 14, true)
            cell(percent(spread(a)), 10, true)
            cell("{text.fixed(median(b) / m.scale, 3)} {m.unit}", 14, true)
            cell(percent(spread(b)), 10, true)
            cell(text.fixed(interval.estimate, 4), 8, true)
            cell("{text.fixed(interval.low, 4)}..{text.fixed(interval.high, 4)}", 20, true)
            "  {verdict(interval)}"
        ]
        print(text.join(row, ""))
    }
}

fn percent(x: f64) -> str {
    "{text.fixed(x * 100.0, 1)}%"
}

fn cell(s: str, width: i64, right: bool) -> str {
    if right {
        return text.pad_left(s, width, ' ')
    }
    text.pad_right(s, width, ' ')
}
