import std/process

extern "kernel32" {
    fn GetCurrentProcess() -> i64
    fn OpenProcess(access: u32, inherit: i32, pid: u32) -> i64
    fn CloseHandle(handle: i64) -> i32
    fn GetProcessTimes(process: i64, mut creation: u64, mut exit: u64, mut kernel: u64, mut user: u64) -> i32
    fn QueryProcessCycleTime(process: i64, mut cycles: u64) -> i32
    fn K32GetProcessMemoryInfo(process: i64, mut counters: MemoryCounters, size: u32) -> i32
    fn SetProcessAffinityMask(process: i64, mask: u64) -> i32
}

extern struct MemoryCounters {
    size: u32
    faults: u32
    peak_working: i64
    working: i64
    quota_peak_paged: i64
    quota_paged: i64
    quota_peak_nonpaged: i64
    quota_nonpaged: i64
    pagefile: i64
    peak_pagefile: i64
    private: i64
}

const memory_counters_size: u32 = 80
const filetime_unit = 100
const query_access: u32 = 0x1410

const peak_metric = "peak private"

struct Probe {
    handle: i64
}

fn measurable(c: process.Command) -> process.Command ! Error {
    c
}

fn probe(pid: i64) -> Probe ! Error {
    let handle = OpenProcess(query_access, 0, u32(pid))
    if handle == 0 {
        fail Failed("cannot open process {pid} for measurement")
    }
    Probe { handle }
}

fn began(p: Probe, launched: i64) -> i64 {
    launched
}

fn read_usage(p: Probe) -> Reading {
    var found = Reading {}
    var creation: u64 = 0
    var exit: u64 = 0
    var kernel: u64 = 0
    var user: u64 = 0
    if GetProcessTimes(p.handle, mut creation, mut exit, mut kernel, mut user) != 0 {
        found.cpu = i64(kernel + user) * filetime_unit
    }
    var cycles: u64 = 0
    if QueryProcessCycleTime(p.handle, mut cycles) != 0 {
        found.cycles = i64(cycles)
    }
    var counters = MemoryCounters { size: memory_counters_size, faults: 0, peak_working: 0, working: 0, quota_peak_paged: 0, quota_paged: 0, quota_peak_nonpaged: 0, quota_nonpaged: 0, pagefile: 0, peak_pagefile: 0, private: 0 }
    if K32GetProcessMemoryInfo(p.handle, mut counters, memory_counters_size) != 0 {
        found.peak = counters.peak_pagefile
    }
    let _ = CloseHandle(p.handle)
    found
}

fn restrict_cpus(mask: u64) ! Error {
    if SetProcessAffinityMask(GetCurrentProcess(), mask) == 0 {
        fail Failed("cannot set the affinity mask {mask}")
    }
}
