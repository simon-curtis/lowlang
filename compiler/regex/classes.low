const fold_entry_size = 8
const word_entry_size = 8

fn fold_orbits_table() -> str {
    embed("../../std/regex/fold_orbits.bin")
}

fn word_ranges_table() -> str {
    embed("../../std/regex/word_ranges.bin")
}

fn table_u32(table: str, at: i64) -> u32 {
    u32(table[at]) | u32(table[at + 1]) << 8 | u32(table[at + 2]) << 16 | u32(table[at + 3]) << 24
}

fn orbit_count(table: str) -> i64 {
    table.len / fold_entry_size
}

fn orbit_code(table: str, i: i64) -> u32 {
    table_u32(table, i * fold_entry_size)
}

fn orbit_from(table: str, code: u32) -> i64 {
    var lo = 0
    var hi = orbit_count(table)
    for lo < hi {
        let mid = (lo + hi) / 2
        if orbit_code(table, mid) < code {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    lo
}

fn orbit_next(table: str, c: u32) -> u32 {
    let i = orbit_from(table, c)
    if i < orbit_count(table) && orbit_code(table, i) == c {
        return table_u32(table, i * fold_entry_size + 4)
    }
    c
}

fn fold(ranges: []Range) -> []Range {
    let table = fold_orbits_table()
    let count = orbit_count(table)
    var out: []Range = []
    for r in ranges {
        out.push(r)
        var i = orbit_from(table, r.lo)
        for i < count && orbit_code(table, i) <= r.hi {
            let c = orbit_code(table, i)
            var member = orbit_next(table, c)
            for member != c {
                out.push(Range { lo: member, hi: member })
                member = orbit_next(table, member)
            }
            i += 1
        }
    }
    normalize(out)
}

fn word() -> []Range {
    let table = word_ranges_table()
    var out: []Range = []
    var at = 0
    for at < table.len {
        out.push(Range { lo: table_u32(table, at), hi: table_u32(table, at + 4) })
        at += word_entry_size
    }
    out
}
