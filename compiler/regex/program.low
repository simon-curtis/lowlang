const max_program = 100000

pub enum Op {
    Char
    Class
    Split
    Jump
    Save
    Check
    Done
}

pub struct Inst {
    pub op: Op
    pub c: u32 = 0
    pub ranges: []Range = []
    pub x: i64 = 0
    pub y: i64 = 0
    pub look: Look = TextStart
}

pub struct Program {
    pub insts: []Inst
    pub groups: i64
}

pub fn compile(pattern: str) -> Program ! Error {
    let parsed = parse(pattern)?
    let a = new(Assembler { code: [Inst { op: Save, x: 0 }] })
    a.node(parsed.root)?
    a.emit(Inst { op: Save, x: 1 })?
    a.emit(Inst { op: Done })?
    Program { insts: a.code, groups: parsed.groups }
}

struct Assembler {
    code: []Inst
}

fn emit(a: *Assembler, inst: Inst) -> i64 ! Error {
    if a.code.len >= max_program {
        fail invalid(0, "pattern too large")
    }
    push(mut a.code, inst)
    a.code.len - 1
}

fn node(a: *Assembler, n: Node) ! Error {
    match n {
        Empty => {}
        Literal(c) => {
            a.emit(Inst { op: Char, c })?
        }
        Set(ranges) => {
            a.emit(Inst { op: Class, ranges })?
        }
        Assert(look) => {
            a.emit(Inst { op: Check, look })?
        }
        Capture(index, body) => {
            a.emit(Inst { op: Save, x: 2 * index })?
            a.node(*body)?
            a.emit(Inst { op: Save, x: 2 * index + 1 })?
        }
        Concat(items) => {
            for item in items {
                a.node(item)?
            }
        }
        Alternate(branches) => {
            a.alternate(branches)?
        }
        Repeat(body, min, max, greedy) => {
            if max < 0 {
                a.unbounded(*body, min, greedy)?
            } else {
                a.bounded(*body, min, max, greedy)?
            }
        }
    }
}

fn alternate(a: *Assembler, branches: []Node) ! Error {
    var exits: []i64 = []
    for i, option in branches {
        if i == branches.len - 1 {
            a.node(option)?
            continue
        }
        let split = a.emit(Inst { op: Split })?
        a.node(option)?
        let exit = a.emit(Inst { op: Jump })?
        push(mut exits, exit)
        a.code[split] = Inst { op: Split, x: split + 1, y: a.code.len }
    }
    for exit in exits {
        a.code[exit] = Inst { op: Jump, x: a.code.len }
    }
}

fn bounded(a: *Assembler, body: Node, low: i64, high: i64, greedy: bool) ! Error {
    for _ in 0..low {
        a.node(body)?
    }
    var splits: []i64 = []
    for _ in 0..high - low {
        let split = a.emit(Inst { op: Split })?
        push(mut splits, split)
        a.node(body)?
    }
    for split in splits {
        a.code[split] = branch(split + 1, a.code.len, greedy)
    }
}

fn unbounded(a: *Assembler, body: Node, low: i64, greedy: bool) ! Error {
    for _ in 1..low {
        a.node(body)?
    }
    var skip = -1
    if low == 0 {
        skip = a.emit(Inst { op: Split })?
    }
    let loop = a.code.len
    a.node(body)?
    let back = a.emit(Inst { op: Split })?
    a.code[back] = branch(loop, a.code.len, greedy)
    if skip >= 0 {
        a.code[skip] = branch(loop, a.code.len, greedy)
    }
}

fn branch(more: i64, out: i64, greedy: bool) -> Inst {
    if greedy {
        return Inst { op: Split, x: more, y: out }
    }
    Inst { op: Split, x: out, y: more }
}
