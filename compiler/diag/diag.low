pub struct Pos {
    pub file: str = ""
    pub line: i64 = 0
    pub col: i64 = 0
}

pub enum Error {
    At(pos: Pos, msg: str)
}

pub fn start(file: str) -> Pos {
    Pos { file, line: 1, col: 1 }
}

pub fn text(p: Pos) -> str {
    if p.file == "" {
        return "{p.line}:{p.col}"
    }
    "{p.file}:{p.line}:{p.col}"
}

pub fn message(e: Error) -> str {
    match e {
        At(pos, msg) => "{text(pos)}: {msg}"
    }
}
