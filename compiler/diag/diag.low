import std/slices

pub const error_limit = 50

pub struct Source {
    pub name: str = ""
    pub text: str = ""
}

pub struct Pos {
    origin_of: *Source
    packed: i64 = 0
}

pub fn source(name: str) -> *Source {
    new(Source { name })
}

pub fn pos_in(src: *Source, line: i64, col: i64) -> Pos {
    Pos { origin_of: src, packed: line << 32 | (col & 0xFFFFFFFF) }
}

pub fn nowhere() -> Pos {
    pos_in(source(""), 0, 0)
}

pub fn origin(p: Pos) -> *Source {
    p.origin_of
}

pub fn pos_file(p: Pos) -> str {
    p.origin_of.name
}

pub fn pos_line(p: Pos) -> i64 {
    p.packed >> 32
}

pub fn pos_col(p: Pos) -> i64 {
    (p.packed << 32) >> 32
}

pub fn at_col(p: Pos, col: i64) -> Pos {
    pos_in(p.origin_of, p.pos_line(), col)
}

pub enum Severity {
    Error
    Warning
}

pub struct Edit {
    pub pos: Pos
    pub end: Pos
    pub text: str
}

pub struct Fix {
    pub title: str
    pub safe: bool = false
    pub edits: []Edit = []
    /// The text of the last edit an editor selects for the author to replace, or empty.
    pub placeholder: str = ""
}

pub struct Related {
    pub pos: Pos
    pub label: str
}

pub struct Diagnostic {
    pub code: str
    pub severity: Severity = Severity.Error
    pub pos: Pos
    pub end: Pos
    pub msg: str
    pub related: []Related = []
    pub fixes: []Fix = []
}

pub enum Error {
    At(pos: Pos, code: str, msg: str)
    Reported(list: []*Diagnostic)
}

pub fn error(pos: Pos, code: str, msg: str) -> *Diagnostic {
    new(Diagnostic { code, pos, end: token_end(pos), msg })
}

pub fn warning(pos: Pos, code: str, msg: str) -> *Diagnostic {
    new(Diagnostic { code, severity: Severity.Warning, pos, end: token_end(pos), msg })
}

pub fn start(file: str) -> Pos {
    pos_in(source(file), 1, 1)
}

pub fn file_start(file: str, src: str) -> Pos {
    pos_in(new(Source { name: file, text: src }), 1, 1)
}

pub fn line_text(p: Pos) -> str? {
    if p.origin_of.text == "" {
        return none
    }
    source_line(p.origin_of.text, p.pos_line())
}

pub fn token_end(p: Pos) -> Pos {
    let line = line_text(p) ?? return p
    let start = p.pos_col() - 1
    if start < 0 || start >= line.len {
        return p
    }
    p.at_col(token_after(line, start) + 1)
}

fn source_line(src: str, number: i64) -> str? {
    var line = 1
    var from = 0
    for i in 0..src.len {
        if line == number {
            break
        }
        if src[i] == '\n' {
            line += 1
            from = i + 1
        }
    }
    if line != number {
        return none
    }
    var close = from
    for close < src.len && src[close] != '\n' {
        close += 1
    }
    src[from..close]
}

fn token_after(line: str, start: i64) -> i64 {
    var end = start
    for end < line.len && is_word(line[end]) {
        end += 1
    }
    if end > start {
        return end
    }
    if line[start] == '"' {
        return quoted_end(line, start)
    }
    end = start + 1
    for end < line.len && line[end] & 0xC0 == 0x80 {
        end += 1
    }
    end
}

fn quoted_end(line: str, start: i64) -> i64 {
    var i = start + 1
    for i < line.len {
        match line[i] {
            '\\' => { i += 2 }
            '"' => return i + 1
            _ => { i += 1 }
        }
    }
    line.len
}

pub fn is_word(c: u8) -> bool {
    c == '_' || c >= 0x80 || (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9')
}

pub fn text(p: Pos) -> str {
    if p.pos_file() == "" {
        return "{p.pos_line()}:{p.pos_col()}"
    }
    "{p.pos_file()}:{p.pos_line()}:{p.pos_col()}"
}

pub fn diagnostics(e: Error) -> []*Diagnostic {
    match e {
        At(pos, code, msg) => [error(pos, code, msg)]
        Reported(list) => list
    }
}

pub fn first(e: Error) -> *Diagnostic {
    diagnostics(e)[0]
}

pub fn line(d: *Diagnostic) -> str {
    let suffix = if d.code == "" { "" } else { " [{d.code}]" }
    match d.severity {
        Error => "{text(d.pos)}: {d.msg}{suffix}"
        Warning => "{text(d.pos)}: warning: {d.msg}{suffix}"
    }
}

pub fn message(e: Error) -> str {
    var all = ""
    for i, d in diagnostics(e) {
        all = if i == 0 { line(d) } else { "{all}\n{line(d)}" }
    }
    all
}

pub fn sort(mut list: []*Diagnostic) {
    slices.sort_stable_by(mut list, fn(a: *Diagnostic, b: *Diagnostic) -> bool { before(a.pos, b.pos) })
}

fn before(a: Pos, b: Pos) -> bool {
    if a.pos_file() != b.pos_file() {
        return a.pos_file() < b.pos_file()
    }
    if a.pos_line() != b.pos_line() {
        return a.pos_line() < b.pos_line()
    }
    a.pos_col() < b.pos_col()
}
