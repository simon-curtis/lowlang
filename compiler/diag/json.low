import std/json

pub fn json_line(d: *Diagnostic, module: str) -> str {
    var members = [json.text_member("event", "diagnostic")]
    if module != "" {
        members.push(json.text_member("module", module))
    }
    members.push(json.text_member("code", d.code))
    members.push(json.text_member("severity", severity_text(d.severity)))
    add_position(mut members, "", d.pos)
    add_position(mut members, "end_", d.end)
    members.push(json.text_member("message", d.msg))
    var related: []json.Value = []
    for r in d.related {
        var at = [json.text_member("label", r.label)]
        add_position(mut at, "", r.pos)
        related.push(json.object_value(at))
    }
    members.push(json.array_member("related", related))
    var fixes: []json.Value = []
    for f in d.fixes {
        fixes.push(fix_value(f))
    }
    members.push(json.array_member("fixes", fixes))
    "{json.stringify(json.object_value(members), 0)}\n"
}

pub fn severity_text(s: Severity) -> str {
    match s {
        Error => "error"
        Warning => "warning"
    }
}

fn fix_value(f: Fix) -> json.Value {
    var edits: []json.Value = []
    for e in f.edits {
        var members: []json.Member = []
        add_position(mut members, "", e.pos)
        add_position(mut members, "end_", e.end)
        members.push(json.text_member("text", e.text))
        edits.push(json.object_value(members))
    }
    json.object_value([json.text_member("title", f.title), json.bool_member("safe", f.safe), json.array_member("edits", edits)])
}

fn add_position(mut members: []json.Member, prefix: str, p: Pos) {
    if prefix == "" {
        members.push(json.text_member("file", p.pos_file()))
    }
    members.push(json.int_member("{prefix}line", p.pos_line()))
    members.push(json.int_member("{prefix}column", p.pos_col()))
}
