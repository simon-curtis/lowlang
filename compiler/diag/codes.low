pub struct Code {
    pub name: str
    pub severity: Severity
    pub meaning: str
    pub example: str
}

pub fn codes() -> []Code {
    [
        Code { name: "ambiguous", severity: Severity.Error, meaning: "A method call matches functions in more than one imported module.", example: "`xs.first()` where two imported modules declare `first` for `xs`'s type" }
        Code { name: "argument-type", severity: Severity.Error, meaning: "A builtin is given an argument of a type it does not take.", example: "`str(42)`" }
        Code { name: "arity", severity: Severity.Error, meaning: "A call, variant or pattern has the wrong number of arguments or fields.", example: "`fn f(a: i64) {{}}` then `f(1, 2)`" }
        Code { name: "bind-type", severity: Severity.Error, meaning: "A binding is given a value that cannot be stored, such as `void`.", example: "`let x = print(\"a\")`" }
        Code { name: "bound-twice", severity: Severity.Error, meaning: "A destructuring pattern binds one name twice.", example: "`let {{ x: v, y: v }} = point`, where `point` has fields `x` and `y`" }
        Code { name: "break-outside", severity: Severity.Error, meaning: "`break` or `continue` appears outside a loop.", example: "`fn main() {{ break }}`" }
        Code { name: "builtin-name", severity: Severity.Error, meaning: "A function or constant takes the name of a builtin.", example: "`fn print(x: i64) {{}}`" }
        Code { name: "c-callback", severity: Severity.Error, meaning: "A function passed to C as a callback has a parameter or result C cannot pass.", example: "`extern` callback taking a `str`" }
        Code { name: "capture", severity: Severity.Error, meaning: "A closure captures a `mut` parameter.", example: "`fn f(mut n: i64) {{ let g = fn() {{ n += 1 }} }}`" }
        Code { name: "catch-form", severity: Severity.Error, meaning: "`catch` is followed by something other than arms or a mapper.", example: "`parse(s) catch 0`" }
        Code { name: "char-literal", severity: Severity.Error, meaning: "A character literal is empty, invalid UTF-8 or holds more than one character.", example: "`'ab'`" }
        Code { name: "closure-result", severity: Severity.Error, meaning: "A closure that uses `?` or `fail` does not declare its result.", example: "`import std/text` then `let f = fn(s: str) text.parse_int(s)?`" }
        Code { name: "const-cycle", severity: Severity.Error, meaning: "A constant's value refers to itself.", example: "`const a = a + 1`" }
        Code { name: "const-in-function", severity: Severity.Error, meaning: "`const` appears inside a function body.", example: "`fn main() {{ const n = 1 }}`" }
        Code { name: "const-pattern", severity: Severity.Error, meaning: "A match arm names a constant and binds fields.", example: "`limit(x) => x` where `limit` is a constant" }
        Code { name: "const-type", severity: Severity.Error, meaning: "A constant's value is not a number, bool or str.", example: "`const xs = [1, 2]`" }
        Code { name: "constraint", severity: Severity.Error, meaning: "A type argument does not satisfy the constraint on its parameter.", example: "`max[bool](a, b)` where `max` needs `Ordered`" }
        Code { name: "conversion", severity: Severity.Error, meaning: "A value cannot be converted to the requested type.", example: "`i64(\"a\")`" }
        Code { name: "default-cycle", severity: Severity.Error, meaning: "A field default refers to itself.", example: "`struct S {{ a: i64 = S {{}}.a }}`" }
        Code { name: "defer", severity: Severity.Error, meaning: "A deferred statement nests `defer`, leaves its scope or returns.", example: "`defer {{ return }}`" }
        Code { name: "dependency", severity: Severity.Error, meaning: "A `build.low` dependency is missing, unfetched or clashes with another.", example: "`build.local(\"vendor/shapes\")` in `build.low` with no `vendor/shapes` directory" }
        Code { name: "derive", severity: Severity.Error, meaning: "Derived serialization cannot be generated for a type or field.", example: "`json.encode(f)` where `f` is a function value" }
        Code { name: "destructure", severity: Severity.Error, meaning: "A destructuring pattern is applied to a value that is not a struct.", example: "`let {{ x }} = 1`" }
        Code { name: "division-by-zero", severity: Severity.Error, meaning: "A constant expression divides by zero.", example: "`const n = 1 / 0`" }
        Code { name: "doc-comment", severity: Severity.Error, meaning: "A `///` comment is not followed by a declaration, field or variant.", example: "`/// note` at the end of a file" }
        Code { name: "drop-binding", severity: Severity.Error, meaning: "A value with `drop` is bound with `let`, or a value without `drop` with `using`.", example: "`let f = file.open(p)?` where the file has `drop`" }
        Code { name: "dropped-result", severity: Severity.Warning, meaning: "A call's result is dropped without `let _ =`.", example: "`text.trim(s)` written as a statement" }
        Code { name: "duplicate-arm", severity: Severity.Error, meaning: "A match has two arms for one variant.", example: "`A => 1` written twice in one `match`" }
        Code { name: "duplicate-field", severity: Severity.Error, meaning: "A struct literal or pattern names one field twice.", example: "`struct P {{ x: i64 }}` then `let p = P {{ x: 1, x: 2 }}`" }
        Code { name: "duplicate-import", severity: Severity.Error, meaning: "Two imports in one file use the same name.", example: "`import std/text` then `import text = std/path`" }
        Code { name: "embed", severity: Severity.Error, meaning: "`embed` or `embed_dir` is given something other than an existing path literal.", example: "`embed(\"missing.txt\")`" }
        Code { name: "empty-interpolation", severity: Severity.Error, meaning: "A string holds `{{}}` with nothing inside.", example: "`\"a {{}} b\"`" }
        Code { name: "empty-pattern", severity: Severity.Error, meaning: "A destructuring pattern has no fields.", example: "`struct P {{ x: i64 }}` then `let {{}} = P {{ x: 1 }}`" }
        Code { name: "empty-type", severity: Severity.Error, meaning: "A struct has no fields or an enum has no variants.", example: "`struct Empty {{}}`" }
        Code { name: "error-type", severity: Severity.Error, meaning: "An error type is not an enum.", example: "`fn f() ! i64 {{}}`" }
        Code { name: "escape", severity: Severity.Error, meaning: "An escape sequence in a string or character literal is malformed.", example: "`\"\\q\"`" }
        Code { name: "extern-name", severity: Severity.Error, meaning: "An `extern` library or C symbol name is invalid.", example: "`extern \"lib c\" {{ }}`" }
        Code { name: "extern-type", severity: Severity.Error, meaning: "An `extern` declaration uses a type C cannot pass.", example: "`extern \"c\" {{ fn puts(s: str) -> i32 }}`" }
        Code { name: "field-tag", severity: Severity.Error, meaning: "A field tag is not a plain string literal.", example: "`struct P {{ x: i64 \"{{1}}\" }}`" }
        Code { name: "float-literal", severity: Severity.Error, meaning: "A float literal cannot be read or does not fit `f64`.", example: "`1e999`" }
        Code { name: "fork-arity", severity: Severity.Error, meaning: "A `fork` has more or fewer branches than the `let` has names.", example: "`let a, b = fork {{ 1, 2, 3 }}`" }
        Code { name: "fork-exit", severity: Severity.Error, meaning: "`return`, `break`, `continue` or a `catch` mapping leaves a fork branch.", example: "a branch that runs `return 1`" }
        Code { name: "fork-let", severity: Severity.Error, meaning: "`fork` is written without a `let` of one name for each branch, or such a `let` has no `fork`.", example: "`let a = fork {{ 1, 2 }}`" }
        Code { name: "fork-sibling", severity: Severity.Error, meaning: "A fork branch reads a name the same `let` binds.", example: "`let a, b = fork {{ 1, a + 1 }}`" }
        Code { name: "fork-void", severity: Severity.Error, meaning: "A name other than `_` is given to a fork branch that produces no value.", example: "`let a, b = fork {{ print(1), 2 }}`" }
        Code { name: "fork-write", severity: Severity.Error, meaning: "A fork branch changes a local it captures.", example: "`var n = 0` then a branch that runs `n = 5`" }
        Code { name: "format-spec", severity: Severity.Error, meaning: "A format spec in an interpolation is malformed.", example: "`\"{{x:q}}\"`" }
        Code { name: "format-type", severity: Severity.Error, meaning: "A value cannot be formatted with the given spec.", example: "`\"{{true:x}}\"`" }
        Code { name: "has-drop", severity: Severity.Error, meaning: "A value with `drop` is copied where it would be dropped twice: captured, spawned, stored or destructured.", example: "`spawn worker(conn)` where `conn` has `drop`" }
        Code { name: "immutable", severity: Severity.Error, meaning: "A `let`, `const` or non-`mut` parameter is assigned or passed as `mut`.", example: "`let n = 1` then `n = 2`" }
        Code { name: "import-cycle", severity: Severity.Error, meaning: "Modules import each other in a cycle.", example: "`a` imports `b` and `b` imports `a`" }
        Code { name: "import-examples", severity: Severity.Error, meaning: "An import names a directory under `examples`.", example: "`import examples/hello`" }
        Code { name: "import-order", severity: Severity.Error, meaning: "An import follows a declaration.", example: "`fn f() {{}}` then `import std/text`" }
        Code { name: "import-path", severity: Severity.Error, meaning: "An import path or name is not written as identifiers.", example: "`import color-names`" }
        Code { name: "infer-type", severity: Severity.Error, meaning: "A type cannot be inferred and needs an annotation.", example: "`let xs = []`" }
        Code { name: "infinite-size", severity: Severity.Error, meaning: "A struct or enum contains itself by value.", example: "`struct Node {{ next: Node }}`" }
        Code { name: "instance-limit", severity: Severity.Error, meaning: "A generic is instantiated with too many distinct type arguments.", example: "a generic function called at thousands of types" }
        Code { name: "kernel-construct", severity: Severity.Error, meaning: "A kernel, or a function it calls, uses a construct a kernel cannot run.", example: "`kernel fn k(id: u32, mut out: u32[]) {{ print(id) }}`" }
        Code { name: "kernel-device", severity: Severity.Error, meaning: "A kernel given to `launch` uses something its device build cannot hold.", example: "`launch(k, 1, pair, mut out)` where `k` takes the struct `pair` by value" }
        Code { name: "kernel-literal", severity: Severity.Error, meaning: "A number literal in a kernel takes a 64-bit type because its context gives it none.", example: "`kernel fn k(id: u32, mut out: f32[]) {{ let half = 0.5 }}`" }
        Code { name: "kernel-recursion", severity: Severity.Error, meaning: "A function a kernel calls reaches itself.", example: "`fn depth(n: u32) -> u32 {{ depth(n) }}` called from a kernel" }
        Code { name: "kernel-signature", severity: Severity.Error, meaning: "A kernel has type parameters, a result, a `mut` parameter that is not a slice, or no `u32` index as its first parameter.", example: "`kernel fn k(a: f32, mut out: f32[]) {{}}`" }
        Code { name: "kernel-type", severity: Severity.Error, meaning: "A kernel, or a function it calls, holds a value of a type a kernel cannot hold.", example: "`kernel fn k(id: u32, src: u8[], mut out: u32[]) {{}}`" }
        Code { name: "label-shadow", severity: Severity.Error, meaning: "A loop label repeats the label of an enclosing loop.", example: "`outer: for {{ outer: for {{ }} }}`" }
        Code { name: "label-target", severity: Severity.Error, meaning: "A label is not followed by a `for` loop.", example: "`outer: print(1)`" }
        Code { name: "large-struct", severity: Severity.Warning, meaning: "A struct is large enough that every copy is costly.", example: "a struct of 64 or more words" }
        Code { name: "launch-kernel", severity: Severity.Error, meaning: "The first argument of `launch` is not the name of a kernel.", example: "`fn plain(id: u32) {{}}` then `launch(plain, 4)`" }
        Code { name: "loop-bindings", severity: Severity.Error, meaning: "A `for` loop binds more names than its iterable gives.", example: "`for a, b in 0..3 {{}}`" }
        Code { name: "main-signature", severity: Severity.Error, meaning: "`main` takes parameters or returns a value.", example: "`fn main(x: i64) {{}}`" }
        Code { name: "main-use", severity: Severity.Error, meaning: "A function, drop or field default uses what the statements outside a function produce.", example: "`fn f() {{ main() }}` beside top-level statements" }
        Code { name: "manifest", severity: Severity.Error, meaning: "A `build.low` holds something its reader does not accept.", example: "`version(\"one\")` in `build.low`" }
        Code { name: "map-key", severity: Severity.Error, meaning: "A map key type is not an integer, bool, str or pointer.", example: "`let m: [f64: i64] = [:]`" }
        Code { name: "match-pattern", severity: Severity.Error, meaning: "A match arm's pattern does not fit the subject.", example: "`enum E {{ A }}` then `match E.A {{ _(x) => 1 }}`" }
        Code { name: "match-subject", severity: Severity.Error, meaning: "The match subject is used outside a match arm.", example: "a value arm written outside `match`" }
        Code { name: "match-type", severity: Severity.Error, meaning: "A `match` subject has no value.", example: "`match print(\"a\") {{ _ => 1 }}`" }
        Code { name: "method-call", severity: Severity.Warning, meaning: "`push`, `pop`, `truncate` or `delete` is called as a function on a `mut` argument.", example: "`var xs = [1]` then `push(mut xs, 2)`" }
        Code { name: "missing-arms", severity: Severity.Error, meaning: "A `match` does not cover every variant.", example: "`match c {{ Red => 1 }}` on a three-colour enum" }
        Code { name: "missing-fields", severity: Severity.Error, meaning: "A struct literal leaves out fields that have no default.", example: "`struct P {{ x: i64 }}` then `let p = P {{}}`" }
        Code { name: "missing-main", severity: Severity.Error, meaning: "A program has no `main` and no statements outside a function.", example: "`fn f() {{}}` as the whole program" }
        Code { name: "missing-mut", severity: Severity.Error, meaning: "An argument to a `mut` parameter is not written with `mut`.", example: "`xs.push(1)` written as `push(xs, 1)`" }
        Code { name: "missing-return", severity: Severity.Error, meaning: "`return` without a value in a function that returns one.", example: "`fn f() -> i64 {{ return }}`" }
        Code { name: "module-shadowed", severity: Severity.Error, meaning: "A local hides a module of the same name.", example: "`import std/time` then `fn stamp(time: i64) -> i64 {{ time.now_nanos() }}`" }
        Code { name: "move-borrowed", severity: Severity.Error, meaning: "A value is moved while it is borrowed.", example: "moving `buf` while a slice of it is alive" }
        Code { name: "move-field", severity: Severity.Error, meaning: "A field with `drop` is moved out of its struct.", example: "`using f = owner.file` where `owner` is bound with `using` and `file` has `drop`" }
        Code { name: "mut-aliased", severity: Severity.Error, meaning: "One variable is passed as `mut` twice in one call.", example: "`fn swap(mut a: i64, mut b: i64) {{}}` then `var n = 1` then `swap(mut n, mut n)`" }
        Code { name: "mut-position", severity: Severity.Error, meaning: "`mut` appears where it is not an argument to a `mut` parameter.", example: "`var n = 1` then `print(mut n)`" }
        Code { name: "name-clash", severity: Severity.Error, meaning: "A function or constant has the name of a type or function.", example: "`fn i64() {{}}`" }
        Code { name: "no-error-type", severity: Severity.Error, meaning: "`fail`, `?` or a `catch` mapper is used in a function without an error type.", example: "`import std/text` then `fn main() {{ text.parse_int(\"1\")? }}`" }
        Code { name: "not-assignable", severity: Severity.Error, meaning: "An assignment target or `mut` argument is not a place.", example: "`fn f() -> i64 {{ 1 }}` then `f() = 2`" }
        Code { name: "not-callable", severity: Severity.Error, meaning: "A value that is not a function is called.", example: "`let n = 1` then `n()`" }
        Code { name: "not-constant", severity: Severity.Error, meaning: "A constant uses something other than literals, constants, operators and numeric conversions.", example: "`fn three() -> i64 {{ 3 }}` then `const x = three()`" }
        Code { name: "not-generic", severity: Severity.Error, meaning: "Type arguments are given to something that is not generic.", example: "`let x: i64[str] = 1`" }
        Code { name: "not-indexable", severity: Severity.Error, meaning: "A value that cannot be indexed or sliced is indexed.", example: "`let n = 1` then `print(n[0])`" }
        Code { name: "not-iterable", severity: Severity.Error, meaning: "A `for` loop iterates over a value that is not a range, slice, str, map or channel.", example: "`for x in true {{}}`" }
        Code { name: "not-pointer", severity: Severity.Error, meaning: "A value that is not a pointer is dereferenced.", example: "`*1`" }
        Code { name: "not-result", severity: Severity.Error, meaning: "`?`, `catch` or `or` is applied to a value that cannot fail.", example: "`1?`" }
        Code { name: "not-struct", severity: Severity.Error, meaning: "A struct literal names a type that is not a struct.", example: "`i64 {{ a: 1 }}`" }
        Code { name: "number-separator", severity: Severity.Error, meaning: "A `_` in a number is not between two digits.", example: "`1__000`" }
        Code { name: "one-letter-name", severity: Severity.Warning, meaning: "A binding has a one-letter name.", example: "`let n = 1`" }
        Code { name: "operand-type", severity: Severity.Error, meaning: "An operator is applied to a type it does not support.", example: "`print(true + true)`" }
        Code { name: "optional-optional", severity: Severity.Error, meaning: "`??` ends a line, which continues the expression.", example: "`let x: i64? = none ??` with the right side on the next line" }
        Code { name: "overflow", severity: Severity.Error, meaning: "A literal or constant does not fit its type.", example: "`let b: u8 = 256`" }
        Code { name: "pattern-annotation", severity: Severity.Error, meaning: "A destructuring pattern has a type annotation.", example: "`struct P {{ x: i64 }}` then `let {{ x }}: P = P {{ x: 1 }}`" }
        Code { name: "pipe-target", severity: Severity.Error, meaning: "The right side of `|>` is not a function or a call.", example: "`x |> 1`" }
        Code { name: "prefer-const", severity: Severity.Warning, meaning: "A function returns the same value on every call.", example: "`fn limit() -> i64 {{ 10 }}`" }
        Code { name: "prefer-let", severity: Severity.Warning, meaning: "A `var` is never assigned or passed as `mut`.", example: "`var n = 1` then `print(n)`" }
        Code { name: "prefer-loop-label", severity: Severity.Warning, meaning: "A flag relays a `break` to an enclosing loop.", example: "`done = true` then `break`, tested by the outer loop" }
        Code { name: "prefer-match", severity: Severity.Warning, meaning: "An `if` chain compares one subject against several values.", example: "`let c = 1` then `if c == 1 {{ print(1) }} else if c == 2 {{ print(2) }} else {{ print(3) }}`" }
        Code { name: "private", severity: Severity.Error, meaning: "A private name of another module is used.", example: "`import std/text` then `text.first_in_range(\"a\", 0, 1)`" }
        Code { name: "propagate-type", severity: Severity.Error, meaning: "`?` passes an error of one enum from a function whose error type is another.", example: "`parse(s)?` in a function declared `! ReadError`" }
        Code { name: "pub-extern", severity: Severity.Error, meaning: "An `extern` block is marked `pub`.", example: "`pub extern \"c\" {{}}`" }
        Code { name: "rebound", severity: Severity.Error, meaning: "A binding repeats a name already bound in the same scope.", example: "`let n = 1` then `let n = 2`" }
        Code { name: "receiver-call", severity: Severity.Warning, meaning: "A function that changes its first argument is not called on that argument.", example: "`fn grow(mut xs: i64[]) {{ xs.push(1) }}` then `var xs = [1]` then `grow(mut xs)`" }
        Code { name: "redeclared", severity: Severity.Error, meaning: "A name is declared twice in one scope: a type, function, constant, field, variant, parameter or drop.", example: "`fn f() {{}}` then `fn f() {{}}`" }
        Code { name: "regex", severity: Severity.Error, meaning: "A generated regex call is not given one valid pattern literal.", example: "`import std/regex` then `let re = regex.generated(\"(a\")`" }
        Code { name: "region-escape", severity: Severity.Error, meaning: "Code in a region stores a value made there in a place declared outside it, or grows such a place.", example: "`var kept: i64[] = []` then `region {{ kept.push(1) }}`" }
        Code { name: "region-exit", severity: Severity.Error, meaning: "`return`, `break`, `continue` or `?` leaves a region.", example: "`region {{ return 1 }}`" }
        Code { name: "region-result", severity: Severity.Error, meaning: "A region returns a value that holds region memory it cannot copy out.", example: "`let f = region {{ fn() -> i64 {{ 1 }} }}`" }
        Code { name: "reserved-name", severity: Severity.Error, meaning: "A name starts with `__`.", example: "`fn __f() {{}}`" }
        Code { name: "return-type", severity: Severity.Error, meaning: "A function body produces a type other than its declared result.", example: "`fn f() -> i64 {{ \"a\" }}`" }
        Code { name: "return-value", severity: Severity.Error, meaning: "`return` has a value in a function that returns nothing.", example: "`fn f() {{ return 1 }}`" }
        Code { name: "select-else", severity: Severity.Error, meaning: "A `select` has more than one `else`.", example: "two `else` arms in one `select`" }
        Code { name: "spawn-call", severity: Severity.Error, meaning: "`spawn` is not followed by a function call.", example: "`spawn 1`" }
        Code { name: "spawn-mut", severity: Severity.Error, meaning: "`spawn` is given a `mut` argument.", example: "`spawn fill(mut xs)`" }
        Code { name: "spawn-write", severity: Severity.Error, meaning: "A spawned closure changes a local it captures.", example: "`var n = 0` then `spawn fn() {{ n = 5 }}()`" }
        Code { name: "target-unsupported", severity: Severity.Error, meaning: "The target lacks what the program uses: system calls, `std/sys` or a C library.", example: "`__syscall(1)` built for `browser/wasm32`" }
        Code { name: "test-signature", severity: Severity.Error, meaning: "A test function is not declared `fn test_name(t: *testing.T)`.", example: "`fn test_add() {{}}` in a `_test.low` file" }
        Code { name: "top-level", severity: Severity.Error, meaning: "Statements outside a function are in the wrong place or beside `fn main`.", example: "top-level statements in a file that also declares `fn main`" }
        Code { name: "type-arguments", severity: Severity.Error, meaning: "Type arguments are not followed by a call.", example: "`id[i64]` used as a value" }
        Code { name: "type-arity", severity: Severity.Error, meaning: "A generic type or function is given the wrong number of type arguments.", example: "`let c = chan[i64, str](1)`" }
        Code { name: "type-as-value", severity: Severity.Error, meaning: "A generic type is used as a value.", example: "`struct Box[T] {{ v: T }}` then `let b = Box.v`" }
        Code { name: "type-mismatch", severity: Severity.Error, meaning: "A value has a type other than the one expected.", example: "`let n: i64 = \"a\"`" }
        Code { name: "unexpected-character", severity: Severity.Error, meaning: "The source holds a character no token starts with.", example: "`1 $ 2`" }
        Code { name: "unexpected-token", severity: Severity.Error, meaning: "The parser expected one token and found another.", example: "`fn main( {{}}`" }
        Code { name: "unhandled-error", severity: Severity.Error, meaning: "A result that can fail is used without `?`, `catch` or `or`.", example: "`parse(s)` as a statement" }
        Code { name: "unknown-constraint", severity: Severity.Error, meaning: "A type parameter names a constraint that does not exist.", example: "`fn f[T: Sortable](x: T) {{}}`" }
        Code { name: "unknown-field", severity: Severity.Error, meaning: "A struct has no field of the given name.", example: "`struct P {{ x: i64 }}` then `print(P {{ x: 1 }}.z)`" }
        Code { name: "unknown-label", severity: Severity.Error, meaning: "`break` or `continue` names a label no enclosing loop has.", example: "`for i in 0..3 {{ break outer }}`" }
        Code { name: "unknown-module", severity: Severity.Error, meaning: "An import or qualified name refers to a module that does not exist.", example: "`import std/nope`" }
        Code { name: "unknown-name", severity: Severity.Error, meaning: "A name is not declared.", example: "`print(y)`" }
        Code { name: "unknown-type", severity: Severity.Error, meaning: "A type is not declared.", example: "`fn f(x: Nope) {{}}`" }
        Code { name: "unknown-variant", severity: Severity.Error, meaning: "An enum has no variant of the given name.", example: "`enum Color {{ Red }}` then `print(Color.Purple)`" }
        Code { name: "unmatched-brace", severity: Severity.Error, meaning: "A `}}` in a string has no `{{` before it.", example: "`\"a }} b\"`" }
        Code { name: "unreachable", severity: Severity.Warning, meaning: "A statement follows one that always leaves the block.", example: "`return 1` then `print(2)`" }
        Code { name: "unreachable-arm", severity: Severity.Error, meaning: "A match arm follows an arm that matches everything.", example: "`_ => 0` followed by `A => 1` in one `match`" }
        Code { name: "unterminated-interpolation", severity: Severity.Error, meaning: "A `{{` in a string is not closed.", example: "`\"a {{1 + 2\"`" }
        Code { name: "unterminated-string", severity: Severity.Error, meaning: "A string literal is not closed on its line.", example: "`\"abc`" }
        Code { name: "unused-function", severity: Severity.Warning, meaning: "A private function, constant, struct or enum is not used anywhere in its module.", example: "`fn helper() {{}}` that nothing calls" }
        Code { name: "unused-import", severity: Severity.Error, meaning: "An imported module is never used in the file.", example: "`import std/text` with no use of `text`" }
        Code { name: "unused-label", severity: Severity.Error, meaning: "A loop label is never used.", example: "`outer: for i in 0..3 {{ print(i) }}`" }
        Code { name: "unused-local", severity: Severity.Error, meaning: "A local binding is never read; `_` and names starting with `_` are exempt.", example: "`let n = 1` and nothing reads `n`" }
        Code { name: "use-after-move", severity: Severity.Error, meaning: "A value with `drop` is used after it was moved, or may have been.", example: "`take(f)` twice, where `f` has `drop`" }
        Code { name: "use-std", severity: Severity.Warning, meaning: "A function repeats one in the standard library.", example: "a hand-written `trim` that matches `text.trim`" }
        Code { name: "using-pattern", severity: Severity.Error, meaning: "`using` is followed by a destructuring pattern.", example: "`using {{ x }} = p`" }
        Code { name: "using-position", severity: Severity.Error, meaning: "`using` appears in a deferred statement or a drop.", example: "`defer {{ using f = open() }}` where `open` returns a value with `drop`" }
        Code { name: "variadic-position", severity: Severity.Error, meaning: "`...` is not the last parameter of an `extern` function.", example: "`extern \"c\" {{ fn printf(..., fmt: ptr) -> i32 }}`" }
        Code { name: "variadic-value", severity: Severity.Error, meaning: "A variadic `extern` function is used as a value.", example: "`extern \"c\" {{ fn printf(fmt: ptr, ...) -> i32 }}` then `let f = printf`" }
        Code { name: "variant-index", severity: Severity.Error, meaning: "Variant indexes are missing on some variants, or `.index` is used without them.", example: "`enum E {{ A = 1, B }}`" }
    ]
}

pub fn lookup(name: str) -> Code? {
    for c in codes() {
        if c.name == name {
            return c
        }
    }
    none
}
