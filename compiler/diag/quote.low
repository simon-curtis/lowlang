import std/builder
import std/unicode

fn printable(c: u32) -> bool {
    if c == ' ' {
        return true
    }
    unicode.is_letter(c) || unicode.is_mark(c) || unicode.is_number(c) || unicode.is_punct(c) || unicode.is_symbol(c)
}

fn write_escaped(mut b: builder.Builder, c: u32, quote: u8) {
    if c == u32(quote) || c == '\\' {
        b.write_byte('\\')
        b.write_byte(u8(c))
        return
    }
    if printable(c) {
        b.write_char(c)
        return
    }
    match c {
        7 => b.write("\\a")
        8 => b.write("\\b")
        12 => b.write("\\f")
        '\n' => b.write("\\n")
        '\r' => b.write("\\r")
        '\t' => b.write("\\t")
        11 => b.write("\\v")
        _ => {
            if c < ' ' || c == 0x7F {
                b.write("\\x{c:x2}")
            } else if c < 0x10000 {
                b.write("\\u{c:x4}")
            } else {
                b.write("\\U{c:x8}")
            }
        }
    }
}

pub fn quote(s: str) -> str {
    var b = builder.with_capacity(s.len + 2)
    b.write_byte('"')
    var at = 0
    for at < s.len {
        let r = unicode.decode_rune(s, at)
        if unicode.is_invalid(r) && !(at + 2 < s.len && s[at] == 0xEF && s[at + 1] == 0xBF && s[at + 2] == 0xBD) {
            b.write("\\x{s[at]:x2}")
            at += 1
            continue
        }
        let size = if r.code == 0xFFFD { 3 } else { r.size }
        write_escaped(mut b, r.code, '"')
        at += size
    }
    b.write_byte('"')
    b.to_str()
}

pub fn quote_char(c: u32) -> str {
    var b = builder.with_capacity(6)
    b.write_byte('\'')
    write_escaped(mut b, c, '\'')
    b.write_byte('\'')
    b.to_str()
}
