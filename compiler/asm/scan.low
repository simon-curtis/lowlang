struct Scanner {
    text: str
    pos: i64 = 0
}

fn is_digit(c: u8) -> bool {
    c >= '0' && c <= '9'
}

fn is_letter(c: u8) -> bool {
    c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z'
}

fn is_ident_start(c: u8) -> bool {
    is_letter(c) || c == '_' || c == '.' || c == '$'
}

fn is_ident_char(c: u8) -> bool {
    is_ident_start(c) || is_digit(c)
}

fn is_hex_digit(c: u8) -> bool {
    is_digit(c) || c >= 'a' && c <= 'f' || c >= 'A' && c <= 'F'
}

fn is_space(c: u8) -> bool {
    c == ' ' || c == '\t' || c == '\n' || c == 11 || c == 12 || c == '\r'
}

fn trim_space(s: str) -> str {
    var start = 0
    var end = s.len
    for start < end && is_space(s[start]) {
        start += 1
    }
    for end > start && is_space(s[end - 1]) {
        end -= 1
    }
    s[start..end]
}

fn skip_space(s: *Scanner) {
    for s.pos < s.text.len && (s.text[s.pos] == ' ' || s.text[s.pos] == '\t') {
        s.pos += 1
    }
}

fn peek(s: *Scanner) -> u8 {
    if s.pos < s.text.len {
        return s.text[s.pos]
    }
    0
}

fn peek_at(s: *Scanner, offset: i64) -> u8 {
    if s.pos + offset < s.text.len {
        return s.text[s.pos + offset]
    }
    0
}

fn at_end(s: *Scanner) -> bool {
    skip_space(s)
    s.pos >= s.text.len || s.text[s.pos] == '#'
}

fn accept(s: *Scanner, c: u8) -> bool {
    skip_space(s)
    if s.pos < s.text.len && s.text[s.pos] == c {
        s.pos += 1
        return true
    }
    false
}

fn ident(s: *Scanner) -> str {
    let start = s.pos
    for s.pos < s.text.len && is_ident_char(s.text[s.pos]) {
        s.pos += 1
    }
    s.text[start..s.pos]
}

fn rest(s: *Scanner) -> str {
    s.text[s.pos..]
}

fn plain_int(s: *Scanner) -> i64? {
    let start = s.pos
    var negative = false
    if peek(s) == '-' {
        negative = true
        s.pos += 1
    }
    let digits = s.pos
    var n: u64 = 0
    for s.pos < s.text.len && is_digit(s.text[s.pos]) {
        n = n * 10 + u64(s.text[s.pos] - '0')
        s.pos += 1
    }
    let count = s.pos - digits
    var after = s.pos
    for after < s.text.len && (s.text[after] == ' ' || s.text[after] == '\t') {
        after += 1
    }
    let terminated = after >= s.text.len || s.text[after] == ',' || s.text[after] == '#'
    let plain = count > 0 && count < 19 && (s.text[digits] != '0' || count == 1) && terminated
    if !plain {
        s.pos = start
        return none
    }
    if negative {
        return -i64(n)
    }
    i64(n)
}
