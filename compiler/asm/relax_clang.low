fn relax_clang(a: *Assembler, b: *SecBuilder) {
    estimate_addresses(a, b)
    for grow_unreachable(a, b) {
        estimate_addresses(a, b)
    }
}

fn grow_unreachable(a: *Assembler, b: *SecBuilder) -> bool {
    var grew = false
    for f in b.frags {
        if f.kind != Jump || f.form != jump_short || fits_short(aim(a, f)) {
            continue
        }
        f.form = jump_near
        f.size = jump_size(f)
        grew = true
    }
    grew
}
