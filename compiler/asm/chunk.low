import std/io
import diag
import std/text

const chunk_start = "\t.p2align 5\n"
const chunk_align = 32
const local_prefix = ".L"

pub struct ChunkFixup {
    pub offset: i64
    pub kind: i64
    pub symbol: str
    pub addend: i64 = 0
    pub branch: bool = false
}

pub struct ChunkSymbol {
    pub name: str
    pub offset: i64 = 0
    pub defined: bool = false
    pub global: bool = false
}

pub struct Chunk {
    pub section: str = ""
    pub align: i64 = 1
    pub bytes: []u8 = []
    pub fixups: []ChunkFixup = []
    pub symbols: []ChunkSymbol = []
    pub marks: []i64 = []
    pub after_data: bool = false
    pub ends_data: bool = false
}

pub enum Piece {
    Text(source: str)
    Block(chunk: Chunk)
}

pub fn assemble_chunk(env: *Env, source: str, wanted: []str, after_data: bool) -> Chunk ! Error {
    let a = new_assembler(env)
    a.chunk = true
    if !text.starts_with(source, chunk_start) {
        fail failure(a, "a chunk must start with .p2align {chunk_align}")
    }
    if after_data {
        a.cur.last = Directive
    }
    run(a, source)?
    let b = chunk_section(a)?
    check_pinned(a, b)?
    chunk_of(a, b, wanted, after_data)?
}

fn chunk_section(a: *Assembler) -> *SecBuilder ! Error {
    if a.sec_order.len != 3 {
        fail failure(a, "a chunk stays in the .text section")
    }
    for b in a.sec_order {
        if b.sec.name != ".text" && (b.sec.data.len != 0 || b.sec.size != 0) {
            fail failure(a, "a chunk stays in the .text section")
        }
    }
    a.sections[".text"] ?? panic("chunk without a text section")
}

fn check_pinned(a: *Assembler, b: *SecBuilder) ! Error {
    for f in b.frags {
        if f.kind == Jump && f.form == jump_forced && !f.pinned {
            a.line = f.line
            let name = a.sym_order[f.sym].name
            fail failure(a, "branch to {name} leaves the chunk and needs {{disp32}}")
        }
    }
}

fn chunk_of(a: *Assembler, b: *SecBuilder, wanted: []str, after_data: bool) -> Chunk ! Error {
    var chunk = Chunk {
        section: ".text",
        align: chunk_align,
        bytes: b.sec.data,
        after_data,
        ends_data: b.last == Directive
    }
    var next = 0
    for f in b.sec.fixups {
        var branch = false
        if next < b.branches.len && b.branches[next] == f.offset {
            branch = true
            next += 1
        }
        chunk.fixups.push(ChunkFixup { offset: f.offset, kind: f.kind, symbol: f.symbol, addend: f.addend, branch })
    }
    for sym in a.sym_order {
        if text.starts_with(sym.name, local_prefix) || sym.state == sym_absolute {
            continue
        }
        var entry = ChunkSymbol { name: sym.name, global: sym.global }
        if sym.state == sym_label {
            entry.defined = true
            entry.offset = address(a, sym)
        }
        chunk.symbols.push(entry)
    }
    for name in wanted {
        let sym = a.syms[name] ?? fail failure(a, "label {name} is not defined")
        if sym.state != sym_label {
            fail failure(a, "label {name} is not defined")
        }
        chunk.marks.push(address(a, sym))
    }
    chunk
}

pub fn assemble_pieces(env: *Env, pieces: []Piece) -> Object ! Error {
    complete(stage(env), pieces, in_order)?
}

/// An assembly that takes its pieces in turn.
pub struct Staged {
    a: *Assembler
    failure: Error? = none
}

pub fn stage(env: *Env) -> *Staged {
    new(Staged { a: new_assembler(env) })
}

/// Assembles `source` as the next piece of `s`, whose failure `complete` reports.
pub fn stage_text(s: *Staged, source: str) {
    run_frame(s.a, new(Frame { text: source, main: true })) catch {
        e => { s.failure = e }
    }
}

fn in_order(count: i64, job: fn(i64)) {
    for i in 0..count {
        job(i)
    }
}

/// Assembles `pieces` after the pieces `s` holds, reading the files of `.incbin` directives through `each`.
pub fn complete(s: *Staged, pieces: []Piece, each: fn(i64, fn(i64))) -> Object ! Error {
    match s.failure {
        some(e) => fail e
        none => {}
    }
    let a = s.a
    reserve_text(a, pieces)
    for i, piece in pieces {
        pieces[i] = Text("")
        match piece {
            Text(source) => run_frame(a, new(Frame { text: source, main: true }))?
            Block(chunk) => add_chunk(a, chunk)?
        }
    }
    fill_awaited(a, each)?
    finish(a)?
    object(a)
}

fn reserve_text(a: *Assembler, pieces: []Piece) {
    match a.sections[".text"] {
        some(b) => {
            var total = b.sec.data.len
            for piece in pieces {
                match piece {
                    Block(chunk) => {
                        if chunk.section == ".text" {
                            total += chunk.bytes.len + chunk.align
                        }
                    }
                    Text(_) => {}
                }
            }
            var room = io.buffer(total)
            room.truncate(0)
            append_bytes(mut room, b.sec.data)
            b.sec.data = room
        }
        none => {}
    }
}

fn add_chunk(a: *Assembler, chunk: Chunk) ! Error {
    section(a, chunk.section, section_defaults(chunk.section))
    let b = a.cur
    if b.sec.nobits {
        fail failure(a, "a chunk cannot go in the nobits section {b.sec.name}")
    }
    var power = 0
    for (1 << power) < chunk.align {
        power += 1
    }
    emit_align(a, power, 0)?
    if exec(b) {
        add_code(a, b, chunk)?
    } else {
        add_data(a, b, chunk)?
    }
}

fn add_code(a: *Assembler, b: *SecBuilder, chunk: Chunk) ! Error {
    if (b.last == Directive) != chunk.after_data {
        fail failure(a, "a chunk assembled after {entry_name(chunk.after_data)} follows {entry_name(b.last == Directive)}")
    }
    let base = b.sec.data.len
    let frag = current_frag(b)
    append_bytes(mut b.sec.data, chunk.bytes)
    define_chunk_symbols(a, b, chunk, base, frag)?
    for f in chunk.fixups {
        let sym = lookup(a, f.symbol)
        let size = fixup_width(f.kind)
        add_fixup(b, TextFixup { at: base + f.offset, size, kind: f.kind, sym: sym.index, addend: f.addend, line: a.line, branch: f.branch })
    }
    start_frag(b)
    b.last = Other
    if chunk.ends_data {
        b.last = Directive
    }
}

fn entry_name(data: bool) -> str {
    if data {
        return "data"
    }
    "an instruction"
}

fn add_data(a: *Assembler, b: *SecBuilder, chunk: Chunk) ! Error {
    let base = b.sec.data.len
    append_bytes(mut b.sec.data, chunk.bytes)
    define_chunk_symbols(a, b, chunk, base, 0)?
    for f in chunk.fixups {
        b.sec.fixups.push(Fixup { offset: base + f.offset, kind: f.kind, symbol: f.symbol, addend: f.addend, line: a.line })
    }
}

fn define_chunk_symbols(a: *Assembler, b: *SecBuilder, chunk: Chunk, base: i64, frag: i64) ! Error {
    for s in chunk.symbols {
        let sym = lookup(a, s.name)
        if s.global {
            sym.global = true
        }
        if !s.defined {
            continue
        }
        if sym.state != sym_undefined {
            fail failure(a, "symbol {s.name} is already defined")
        }
        sym.state = sym_label
        sym.section = b.index
        sym.value = base + s.offset
        sym.frag = frag
    }
}
