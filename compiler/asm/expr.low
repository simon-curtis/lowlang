import diag
const got_symbol = "_GLOBAL_OFFSET_TABLE_"

const rank_additive = 1
const rank_bitwise = 2
const rank_multiply = 3

const uint64_max: u64 = 18446744073709551615

fn binary_rank(op: str) -> i64 {
    match op {
        "*" => rank_multiply
        "/" => rank_multiply
        "%" => rank_multiply
        "<<" => rank_multiply
        ">>" => rank_multiply
        "|" => rank_bitwise
        "&" => rank_bitwise
        "^" => rank_bitwise
        "+" => rank_additive
        "-" => rank_additive
        _ => 0
    }
}

fn peek_operator(a: *Assembler) -> str {
    let s = a.sc
    skip_space(s)
    let c = peek(s)
    match c {
        '*' => return s.text[s.pos..s.pos + 1]
        '/' => return s.text[s.pos..s.pos + 1]
        '%' => return s.text[s.pos..s.pos + 1]
        '|' => return s.text[s.pos..s.pos + 1]
        '&' => return s.text[s.pos..s.pos + 1]
        '^' => return s.text[s.pos..s.pos + 1]
        '+' => return s.text[s.pos..s.pos + 1]
        '-' => return s.text[s.pos..s.pos + 1]
        '<' => {
            if peek_at(s, 1) == c {
                return s.text[s.pos..s.pos + 2]
            }
        }
        '>' => {
            if peek_at(s, 1) == c {
                return s.text[s.pos..s.pos + 2]
            }
        }
        _ => {}
    }
    ""
}

fn parse_expr(a: *Assembler) -> Value ! Error {
    parse_rank(a, rank_additive)?
}

fn parse_rank(a: *Assembler, min_rank: i64) -> Value ! Error {
    var left = parse_unary(a)?
    for {
        let op = peek_operator(a)
        let rank = binary_rank(op)
        if rank == 0 || rank < min_rank {
            return left
        }
        a.sc.pos += op.len
        let right = parse_rank(a, rank + 1)?
        left = binary(a, op, left, right)?
    }
    left
}

fn binary(a: *Assembler, op: str, l: Value, r: Value) -> Value ! Error {
    if op == "+" {
        return combine(a, l, r)?
    }
    if op == "-" {
        let negative = negated(r)
        return combine(a, l, negative)?
    }
    if !is_const(l) || !is_const(r) {
        fail failure(a, "operator {op} needs constant operands")
    }
    let x = l.add
    let y = r.add
    match op {
        "*" => return Value { add: x * y }
        "/" => {
            if y == 0 {
                fail failure(a, "division by zero")
            }
            return Value { add: x / y }
        }
        "%" => {
            if y == 0 {
                fail failure(a, "division by zero")
            }
            return Value { add: x % y }
        }
        "<<" => return Value { add: x << y }
        ">>" => return Value { add: x >> y }
        "|" => return Value { add: x | y }
        "&" => return Value { add: x & y }
        _ => {}
    }
    Value { add: x ^ y }
}

fn combine(a: *Assembler, l: Value, r: Value) -> Value ! Error {
    match value_plus(l, r) {
        some(sum) => return sum
        none => fail failure(a, "expression has too many symbols")
    }
}

fn parse_unary(a: *Assembler) -> Value ! Error {
    let s = a.sc
    skip_space(s)
    match peek(s) {
        '-' => {
            s.pos += 1
            let v = parse_unary(a)?
            return negated(v)
        }
        '+' => {
            s.pos += 1
            return parse_unary(a)?
        }
        '~' => {
            s.pos += 1
            let v = parse_unary(a)?
            if !is_const(v) {
                fail failure(a, "operator ~ needs a constant operand")
            }
            return Value { add: ~v.add }
        }
        '(' => {
            s.pos += 1
            let v = parse_expr(a)?
            if !accept(s, ')') {
                fail failure(a, "missing )")
            }
            return v
        }
        _ => {}
    }
    parse_primary(a)?
}

fn parse_primary(a: *Assembler) -> Value ! Error {
    let s = a.sc
    let c = peek(s)
    if is_digit(c) {
        return parse_number(a)?
    }
    if is_ident_start(c) {
        let name = ident(s)
        return symbol_value(a, name)?
    }
    fail failure(a, "unexpected {diag.quote(rest(s))} in expression")
}

fn symbol_value(a: *Assembler, name: str) -> Value ! Error {
    let sym = lookup(a, name)
    if sym.state == sym_absolute {
        return Value { add: sym.value }
    }
    var v = Value { sym: name }
    let s = a.sc
    if peek(s) == '@' {
        s.pos += 1
        let suffix = ident(s)
        v.reloc = reloc_suffix(a, suffix)?
    }
    v
}

fn reloc_suffix(a: *Assembler, name: str) -> i64 ! Error {
    match name {
        "GOTPCREL" => {
            lookup(a, got_symbol)
            return reloc_gotpcrel
        }
        "IMGREL" => return reloc_img_rel
        "PLT" => return reloc_plt
        _ => {}
    }
    fail failure(a, "unknown relocation suffix @{name}")
}

struct ParsedUint {
    value: i64 = 0
    problem: str = ""
}

fn parse_uint_text(digits: str, base: i64) -> ParsedUint {
    let cutoff = uint64_max / u64(base) + 1
    var n: u64 = 0
    for i in 0..digits.len {
        let d = digit_value(digits[i]) ?? return ParsedUint { problem: "invalid syntax" }
        if d >= base {
            return ParsedUint { problem: "invalid syntax" }
        }
        if n >= cutoff {
            return ParsedUint { problem: "value out of range" }
        }
        n = n * u64(base)
        let next = n + u64(d)
        if next < n {
            return ParsedUint { problem: "value out of range" }
        }
        n = next
    }
    ParsedUint { value: i64(n) }
}

fn bad_number(a: *Assembler, what: str, func: str, text: str, problem: str) -> Error {
    let quote = diag.quote(text)
    failure_wrap(a, "{what} {quote}", "strconv.{func}: parsing {quote}: {problem}")
}

fn parse_number(a: *Assembler) -> Value ! Error {
    let s = a.sc
    let start = s.pos
    if peek(s) == '0' && (peek_at(s, 1) == 'x' || peek_at(s, 1) == 'X') && is_hex_digit(peek_at(s, 2)) {
        s.pos += 2
        return Value { add: digits(a, 16)? }
    }
    if peek(s) == '0' && (peek_at(s, 1) == 'b' || peek_at(s, 1) == 'B') && (peek_at(s, 2) == '0' || peek_at(s, 2) == '1') {
        s.pos += 2
        return Value { add: digits(a, 2)? }
    }
    for is_digit(peek(s)) {
        s.pos += 1
    }
    let text = s.text[start..s.pos]
    let next = peek(s)
    if (next == 'b' || next == 'f') && !is_ident_char(peek_at(s, 1)) {
        s.pos += 1
        return local_label_ref(a, text, next == 'f')?
    }
    if text.len > 1 && text[0] == '0' {
        let parsed = parse_uint_text(text, 8)
        if parsed.problem != "" {
            fail bad_number(a, "bad octal number", "ParseUint", text, parsed.problem)
        }
        return Value { add: parsed.value }
    }
    let parsed = parse_uint_text(text, 10)
    if parsed.problem != "" {
        fail bad_number(a, "bad number", "ParseUint", text, parsed.problem)
    }
    Value { add: parsed.value }
}

fn digits(a: *Assembler, base: i64) -> i64 ! Error {
    let s = a.sc
    var n: i64 = 0
    var count = 0
    for {
        let d = digit_value(peek(s)) ?? break
        if d >= base {
            break
        }
        n = n * base + d
        s.pos += 1
        count += 1
    }
    if count == 0 {
        fail failure(a, "missing digits")
    }
    n
}

fn digit_value(c: u8) -> i64? {
    if is_digit(c) {
        return i64(c - '0')
    }
    if c >= 'a' && c <= 'f' {
        return i64(c - 'a') + 10
    }
    if c >= 'A' && c <= 'F' {
        return i64(c - 'A') + 10
    }
    none
}

fn local_label_ref(a: *Assembler, text: str, forward: bool) -> Value ! Error {
    let parsed = parse_uint_text(text, 10)
    if parsed.problem != "" || parsed.value < 0 {
        let problem = if parsed.problem != "" { parsed.problem } else { "value out of range" }
        fail bad_number(a, "bad local label", "Atoi", text, problem)
    }
    let n = parsed.value
    var count = a.numeric_labels[n] ?? 0
    if forward {
        count += 1
    } else if count == 0 {
        fail failure(a, "local label {n}b has no definition")
    }
    let name = local_label_name(n, count)
    lookup(a, name)
    Value { sym: name }
}

fn const_expr(a: *Assembler) -> i64 ! Error {
    let v = parse_expr(a)?
    if !is_const(v) {
        fail failure(a, "expression is not a constant")
    }
    v.add
}
