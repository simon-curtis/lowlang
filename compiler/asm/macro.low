import diag
import std/builder
import std/text

struct Macro {
    name: str
    params: []str
    body: str
}

fn define_macro(a: *Assembler) ! Error {
    let s = a.sc
    skip_space(s)
    let name = ident(s)
    if name == "" {
        fail failure(a, ".macro needs a name")
    }
    let source = rest(s)
    var fields: []str = []
    var start = -1
    for i in 0..source.len {
        let c = source[i]
        if c == ',' || c == ' ' || c == '\t' {
            if start >= 0 {
                push(mut fields, source[start..i])
                start = -1
            }
        } else if start < 0 {
            start = i
        }
    }
    if start >= 0 {
        push(mut fields, source[start..])
    }
    for field in fields {
        if text.index_byte(field, ':') >= 0 || text.index_byte(field, '=') >= 0 {
            fail failure(a, "macro parameter {diag.quote(field)} uses an unsupported qualifier")
        }
    }
    let body = macro_body(a)?
    a.macros[name] = new(Macro { name, params: fields, body })
}

fn macro_body(a: *Assembler) -> str ! Error {
    let f = a.frame
    let start = f.pos
    var depth = 0
    for {
        let line_start = f.pos
        let line = frame_next(f) ?? fail failure(a, "missing .endm")
        if f.main {
            a.line += 1
        }
        match first_word(line) {
            ".macro" => {
                depth += 1
            }
            ".endm" => {
                if depth == 0 {
                    return f.text[start..line_start]
                }
                depth -= 1
            }
            _ => {}
        }
    }
    ""
}

fn first_word(line: str) -> str {
    var start = 0
    for start < line.len && (line[start] == ' ' || line[start] == '\t') {
        start += 1
    }
    let trimmed = line[start..]
    for i in 0..trimmed.len {
        if trimmed[i] == ' ' || trimmed[i] == '\t' {
            return trimmed[..i]
        }
    }
    trimmed
}

fn expand(a: *Assembler, m: *Macro) ! Error {
    let args = macro_args(a)
    if args.len > m.params.len {
        fail failure(a, "macro {m.name} takes {m.params.len} arguments, got {args.len}")
    }
    if a.macro_depth >= max_macro_depth {
        fail failure(a, "macro {m.name} nests too deeply")
    }
    a.macro_runs += 1
    let body = substitute(m, args, a.macro_runs)
    a.macro_depth += 1
    run_frame(a, new(Frame { text: body }))?
    a.macro_depth -= 1
}

fn macro_args(a: *Assembler) -> []str {
    let source = trim_space(rest(a.sc))
    if source == "" {
        return []
    }
    var parts = text.split(source, ',')
    for i in 0..parts.len {
        parts[i] = trim_space(parts[i])
    }
    parts
}

fn macro_param(m: *Macro, name: str) -> i64? {
    for i, p in m.params {
        if p == name {
            return i
        }
    }
    none
}

fn substitute(m: *Macro, args: []str, run: i64) -> str {
    var body = m.body
    if text.index_byte(body, '\\') < 0 {
        return body
    }
    var out = builder.with_capacity(body.len + 16)
    for body.len > 0 {
        let slash = text.index_byte(body, '\\')
        if slash < 0 {
            out.write(body)
            break
        }
        out.write(body[..slash])
        body = body[slash + 1..]
        body = expand_escape(m, mut out, body, args, run)
    }
    out.to_str()
}

fn expand_escape(m: *Macro, mut out: builder.Builder, body: str, args: []str, run: i64) -> str {
    if text.starts_with(body, "@") {
        out.write("{run}")
        return body[1..]
    }
    if text.starts_with(body, "()") {
        return body[2..]
    }
    var end = 0
    for end < body.len && (is_letter(body[end]) || is_digit(body[end]) || body[end] == '_') {
        end += 1
    }
    let index = macro_param(m, body[..end]) ?? -1
    if index < 0 {
        out.write_byte('\\')
        return body
    }
    if index < args.len {
        out.write(args[index])
    }
    body[end..]
}
