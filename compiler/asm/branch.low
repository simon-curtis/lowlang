fn needs_plt(a: *Assembler, sym: *Sym) -> bool {
    sym.state == sym_undefined || sym.global
}

fn assemble_branch(a: *Assembler, mnemonic: str, ops: []Operand) -> bool ! Error {
    if ops.len != 1 || ops[0].kind != OpImm {
        return false
    }
    match mnemonic {
        "call" => {
            call(a, ops[0])?
        }
        "jmp" => {
            relaxable_jump(a, op_jmp_short, false, ops[0])?
        }
        _ => {
            let code = a.jumps[mnemonic] ?? return false
            relaxable_jump(a, op_jcc_short + code, true, ops[0])?
        }
    }
    true
}

struct BranchTarget {
    sym: *Sym
    off: i64
}

fn branch_target(a: *Assembler, op: Operand) -> BranchTarget ! Error {
    let v = op.value
    if v.sym == "" || v.neg != "" || op.size != 0 {
        fail failure(a, "unsupported branch target")
    }
    BranchTarget { sym: lookup(a, v.sym), off: v.add }
}

fn relaxable_jump(a: *Assembler, opcode: i64, cond: bool, op: Operand) ! Error {
    if op.value.reloc != reloc_none {
        fail failure(a, "unsupported relocation on a jump")
    }
    let target = branch_target(a, op)?
    add_branch_padding(a, opcode)
    add_jump(a.cur, opcode, cond, target.sym, target.off, a.line)
}

fn call(a: *Assembler, op: Operand) ! Error {
    let target = branch_target(a, op)?
    let sym = target.sym
    let off = target.off
    var kind = pc32
    if op.value.reloc == reloc_plt {
        kind = plt32
    } else if op.value.reloc != reloc_none {
        fail failure(a, "unsupported relocation on a call")
    } else if off == 0 && needs_plt(a, sym) {
        kind = plt32
    }
    let b = a.cur
    let at = b.sec.data.len
    push(mut b.sec.data, u8(op_call_near))
    for _ in 0..4 {
        push(mut b.sec.data, 0)
    }
    add_fixup(b, TextFixup { at: at + 1, size: 4, kind, sym: sym.index, addend: off - 4, line: a.line })
}
