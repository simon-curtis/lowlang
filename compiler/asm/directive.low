import diag
import std/builder
import std/file
import std/io
import std/text

fn directive(a: *Assembler, name: str) ! Error {
    match name {
        ".quad" => data_list(a, 8)?
        ".long" => data_list(a, 4)?
        ".short" => data_list(a, 2)?
        ".byte" => data_list(a, 1)?
        ".zero" => zero_fill(a)?
        ".space" => zero_fill(a)?
        ".p2align" => align_directive(a)?
        ".set" => set_symbol(a)?
        ".globl" => globals(a)?
        ".global" => globals(a)?
        ".text" => {
            default_section(a, name)
            expect_end(a)?
        }
        ".data" => {
            default_section(a, name)
            expect_end(a)?
        }
        ".bss" => {
            default_section(a, name)
            expect_end(a)?
        }
        ".section" => section_directive(a)?
        ".double" => double_list(a)?
        ".ascii" => string_list(a, false)?
        ".asciz" => string_list(a, true)?
        ".incbin" => incbin(a)?
        ".intel_syntax" => intel_syntax(a)?
        ".macro" => define_macro(a)?
        _ => {
            if !conditional(a, name)? {
                fail failure(a, "unsupported directive {name}")
            }
        }
    }
}

fn expect_end(a: *Assembler) ! Error {
    if !at_end(a.sc) {
        fail failure(a, "unexpected {diag.quote(rest(a.sc))}")
    }
}

fn intel_syntax(a: *Assembler) ! Error {
    let operand = trim_space(rest(a.sc))
    if operand != "noprefix" {
        fail failure(a, ".intel_syntax supports only noprefix, got {diag.quote(operand)}")
    }
}

fn align_directive(a: *Assembler) ! Error {
    let s = a.sc
    let power = const_expr(a)?
    var max = 0
    if accept(s, ',') {
        skip_space(s)
        if peek(s) != ',' {
            fail failure(a, ".p2align with a fill value is not supported")
        }
        s.pos += 1
        max = const_expr(a)?
    }
    emit_align(a, power, max)?
    expect_end(a)?
}

fn mark_constant_data(a: *Assembler) {
    if exec(a.cur) {
        a.cur.last = Directive
    }
}

fn data_list(a: *Assembler, size: i64) ! Error {
    let s = a.sc
    mark_constant_data(a)
    for {
        skip_space(s)
        match plain_int(s) {
            some(n) => emit_const(a, size, n)?
            none => {
                let v = parse_expr(a)?
                emit_value(a, size, v)?
            }
        }
        if !accept(s, ',') {
            break
        }
    }
    expect_end(a)?
}

fn zero_fill(a: *Assembler) ! Error {
    mark_constant_data(a)
    let n = const_expr(a)?
    var fill = 0
    if accept(a.sc, ',') {
        fill = const_expr(a)?
    }
    emit_zero(a, n, u8(fill))?
    expect_end(a)?
}

fn set_symbol(a: *Assembler) ! Error {
    let s = a.sc
    skip_space(s)
    let name = ident(s)
    if name == "" || !accept(s, ',') {
        fail failure(a, "malformed .set")
    }
    let v = parse_expr(a)?
    if !is_const(v) {
        fail failure(a, ".set {name} needs a constant value")
    }
    define_constant(a, name, v.add)?
    expect_end(a)?
}

fn globals(a: *Assembler) ! Error {
    let s = a.sc
    for {
        skip_space(s)
        let name = ident(s)
        if name == "" {
            fail failure(a, ".globl needs a symbol")
        }
        lookup(a, name).global = true
        if !accept(s, ',') {
            break
        }
    }
    expect_end(a)?
}

fn section_directive(a: *Assembler) ! Error {
    let s = a.sc
    skip_space(s)
    let name = ident(s)
    if name == "" {
        fail failure(a, ".section needs a name")
    }
    var spec = section_defaults(name)
    if accept(s, ',') {
        let letters = string_literal(a)?
        spec = SectionSpec { flags: section_flags(a, letters)? }
        for accept(s, ',') {
            skip_space(s)
            if peek(s) != '@' {
                fail failure(a, "unexpected {diag.quote(rest(s))} in .section")
            }
            s.pos += 1
            let type_name = ident(s)
            spec.nobits = section_type(a, type_name)?
        }
    }
    section(a, name, spec)
    expect_end(a)?
}

fn section_flag_letter(letter: u32) -> i64? {
    match letter {
        'a' => flag_alloc
        'w' => flag_write
        'x' => flag_exec
        'T' => flag_tls
        'r' => flag_read_only
        'd' => 0
        _ => none
    }
}

fn section_flags(a: *Assembler, letters: str) -> i64 ! Error {
    var flags = 0
    for letter in letters {
        match section_flag_letter(letter) {
            some(flag) => {
                flags |= flag
            }
            none => fail failure(a, "unsupported section flag {diag.quote_char(letter)}")
        }
    }
    flags
}

fn section_type(a: *Assembler, name: str) -> bool ! Error {
    match name {
        "nobits" => return true
        "progbits" => return false
        _ => {}
    }
    fail failure(a, "unsupported section type @{name}")
}

fn double_list(a: *Assembler) ! Error {
    let s = a.sc
    mark_constant_data(a)
    for {
        skip_space(s)
        let start = s.pos
        scan_float(a)
        let literal = s.text[start..s.pos]
        let bits = parse_double(a, literal)?
        emit_const(a, 8, bits)?
        if !accept(s, ',') {
            break
        }
    }
    expect_end(a)?
}

fn parse_double(a: *Assembler, literal: str) -> i64 ! Error {
    let quote = diag.quote(literal)
    let f = text.parse_float(literal) catch {
        _ => fail bad_float(a, quote, "invalid syntax")
    }
    if f > 1.7976931348623157e308 || f < -1.7976931348623157e308 {
        fail bad_float(a, quote, "value out of range")
    }
    i64(text.float_bits(f))
}

fn bad_float(a: *Assembler, quote: str, problem: str) -> Error {
    failure_wrap(a, "bad floating point value {quote}", "strconv.ParseFloat: parsing {quote}: {problem}")
}

fn scan_float(a: *Assembler) {
    let s = a.sc
    let sign = peek(s)
    if sign == '-' || sign == '+' {
        s.pos += 1
    }
    for is_digit(peek(s)) || peek(s) == '.' {
        s.pos += 1
    }
    let exponent = peek(s)
    if exponent == 'e' || exponent == 'E' {
        s.pos += 1
        let exponent_sign = peek(s)
        if exponent_sign == '-' || exponent_sign == '+' {
            s.pos += 1
        }
        for is_digit(peek(s)) {
            s.pos += 1
        }
    }
}

fn string_list(a: *Assembler, terminate: bool) ! Error {
    let s = a.sc
    mark_constant_data(a)
    for {
        let literal = string_literal(a)?
        emit_string(a, literal)?
        if terminate {
            emit_const(a, 1, 0)?
        }
        if !accept(s, ',') {
            break
        }
    }
    expect_end(a)?
}

fn string_literal(a: *Assembler) -> str ! Error {
    let s = a.sc
    skip_space(s)
    if peek(s) != '"' {
        fail failure(a, "expected a string, got {diag.quote(rest(s))}")
    }
    s.pos += 1
    let start = s.pos
    for s.pos < s.text.len && s.text[s.pos] != '"' && s.text[s.pos] != '\\' {
        s.pos += 1
    }
    if peek(s) == '"' {
        let literal = s.text[start..s.pos]
        s.pos += 1
        return literal
    }
    escaped_string(a, start)?
}

fn escaped_string(a: *Assembler, start: i64) -> str ! Error {
    let s = a.sc
    var out = builder.builder()
    out.write(s.text[start..s.pos])
    for s.pos < s.text.len {
        let c = s.text[s.pos]
        s.pos += 1
        match c {
            '"' => return out.to_str()
            '\\' => {
                let escaped = escape_byte(a)?
                out.write_byte(escaped)
            }
            _ => out.write_byte(c)
        }
    }
    fail failure(a, "unterminated string")
}

fn escape_byte(a: *Assembler) -> u8 ! Error {
    let s = a.sc
    if s.pos >= s.text.len {
        fail failure(a, "unterminated string")
    }
    let c = s.text[s.pos]
    s.pos += 1
    match c {
        'n' => return '\n'
        't' => return '\t'
        'r' => return '\r'
        'b' => return 8
        'f' => return 12
        '\\' => return c
        '"' => return c
        'x' => return numeric_escape(a, 16, 2)
        _ => {}
    }
    if c >= '0' && c <= '7' {
        s.pos -= 1
        return numeric_escape(a, 8, 3)
    }
    let shown = text.from_char(u32(c))
    fail failure(a, "unknown escape \\{shown}")
}

fn numeric_escape(a: *Assembler, base: i64, max_digits: i64) -> u8 {
    let s = a.sc
    var n: i64 = 0
    for _ in 0..max_digits {
        let d = digit_value(peek(s)) ?? break
        if d >= base {
            break
        }
        n = n * base + d
        s.pos += 1
    }
    u8(n)
}

fn incbin(a: *Assembler) ! Error {
    mark_constant_data(a)
    let path = string_literal(a)?
    let data = included(a, path)?
    emit_bytes(a, data)?
    expect_end(a)?
}

fn included(a: *Assembler, path: str) -> []u8 ! Error {
    match a.opts.embeds[path] {
        some(data) => return data
        none => {}
    }
    let data = file.read_file(path) catch {
        e => fail failure_wrap(a, "cannot read .incbin {diag.quote(path)}", read_error(path, e))
    }
    data
}

fn read_error(path: str, e: io.Error) -> str {
    match e {
        NotFound => "open {path}: no such file or directory"
        Denied => "open {path}: permission denied"
        IsDir => "read {path}: is a directory"
        NotDir => "open {path}: not a directory"
        _ => "open {path}: input/output error"
    }
}
