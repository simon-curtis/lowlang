const short_reach_forward = 128
const short_reach_backward = -127

fn aim(a: *Assembler, f: *Frag) -> i64 {
    f.off + address(a, a.sym_order[f.sym]) - (f.addr + f.fix)
}

fn fits_short(distance: i64) -> bool {
    distance < 0 && distance >= short_reach_backward || distance >= 0 && distance <= short_reach_forward
}

fn layout(a: *Assembler, b: *SecBuilder) ! Error {
    measure_frags(b)
    classify(b)
    if a.opts.clang_layout {
        relax_clang(a, b)
    } else {
        for relax_segment(a, b)? {
        }
    }
    let open = open_frag(b)
    b.sec.size = open.addr + open.fix
}

fn relax_segment(a: *Assembler, b: *SecBuilder) -> bool ! Error {
    estimate_addresses(a, b)
    var limit = b.frags.len * b.frags.len
    var iteration = 1
    for relax_pass(a, b, iteration)? {
        limit -= 1
        if limit <= 0 {
            fail failure(a, "addresses in section {b.sec.name} do not converge")
        }
        iteration += 1
    }
    var changed = false
    for f in b.frags {
        if f.last != f.addr {
            f.last = f.addr
            changed = true
        }
    }
    changed
}

fn estimate_addresses(a: *Assembler, b: *SecBuilder) {
    var address = 0
    var region = 0
    for f in b.frags {
        f.region = region
        f.pass = 0
        f.addr = address
        address += f.fix
        match f.kind {
            Align => {
                address += align_padding(f, address)
                region += 1
            }
            Jump => {
                address += estimate_jump(a, b, f)
            }
            Padding => {
                address += pad_of(b, f).length
            }
            Fused => {
                address += pad_of(b, f).length
            }
            Prefix => {
                address += pad_of(b, f).length
            }
            _ => {}
        }
    }
}

fn estimate_jump(a: *Assembler, b: *SecBuilder, f: *Frag) -> i64 {
    if f.form == jump_short && must_stay_long(a, b, a.sym_order[f.sym]) {
        f.form = jump_forced
        f.size = jump_size(f)
    }
    f.size
}

fn must_stay_long(a: *Assembler, b: *SecBuilder, sym: *Sym) -> bool {
    sym.state != sym_label || sym.section != b.index
}

fn relax_pass(a: *Assembler, b: *SecBuilder, iteration: i64) -> bool ! Error {
    var stretch = 0
    var stretched = false
    for k in 0..b.frags.len {
        let f = b.frags[k]
        f.pass = iteration
        let was = f.addr
        f.addr += stretch
        var growth = 0
        match f.kind {
            Align => {
                growth = align_growth(a, f, was)
            }
            Jump => {
                growth = jump_growth(a, b, f, stretch)
            }
            Padding => {
                growth = padding_growth(a, b, f)?
            }
            Fused => {
                growth = padding_growth(a, b, f)?
            }
            Prefix => {
                growth = prefix_growth(a, b, k, stretch)
            }
            _ => {}
        }
        if growth != 0 {
            stretch += growth
            stretched = true
        }
    }
    stretched
}

fn align_growth(a: *Assembler, f: *Frag, was: i64) -> i64 {
    let fix = f.fix
    let before = align_padding(f, was + fix)
    let after = align_padding(f, f.addr + fix)
    after - before
}

fn jump_growth(a: *Assembler, b: *SecBuilder, f: *Frag, stretch: i64) -> i64 {
    if f.form != jump_short {
        return 0
    }
    let sym_frag = b.frags[a.sym_order[f.sym].frag]
    var distance = aim(a, f)
    if stretch != 0 && sym_frag.pass != f.pass {
        if stretch < 0 || sym_frag.region == f.region {
            distance += stretch
        } else if distance < 0 {
            return 0
        }
    }
    if fits_short(distance) {
        return 0
    }
    f.form = jump_near
    f.size = jump_size(f)
    f.size - short_jump_size
}
