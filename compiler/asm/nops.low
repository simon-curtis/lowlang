const max_nop_size = 11
const max_clang_nop_size = 10
const max_nop_run = 7
const plain_nop: u8 = 0x90
const short_jump_over_max = 127
const operand_size_prefix: u8 = 0x66
const cs_segment_prefix: u8 = 0x2E

fn append_nop(mut out: []u8, size: i64) {
    if size == 1 {
        out.push(plain_nop)
        return
    }
    if size == 2 {
        out.push(operand_size_prefix)
        out.push(plain_nop)
        return
    }
    match size {
        6 => out.push(operand_size_prefix)
        9 => out.push(operand_size_prefix)
        10 => {
            out.push(operand_size_prefix)
            out.push(cs_segment_prefix)
        }
        11 => {
            out.push(operand_size_prefix)
            out.push(operand_size_prefix)
            out.push(cs_segment_prefix)
        }
        _ => {}
    }
    out.push(0x0F)
    out.push(0x1F)
    match size {
        3 => out.push(0x00)
        4 => {
            out.push(0x40)
            out.push(0x00)
        }
        5 => {
            out.push(0x44)
            out.push(0x00)
            out.push(0x00)
        }
        6 => {
            out.push(0x44)
            out.push(0x00)
            out.push(0x00)
        }
        7 => {
            out.push(0x80)
            append_fill(mut out, 4, 0)
        }
        _ => {
            out.push(0x84)
            append_fill(mut out, 5, 0)
        }
    }
}

fn append_nops(mut out: []u8, count: i64, normal: bool) {
    var left = count
    if !normal {
        out.push(plain_nop)
        left -= 1
    }
    if left / max_nop_size > max_nop_run {
        left = append_jump_over_nops(mut out, left)
    }
    let rest = left % max_nop_size
    if rest != 0 {
        append_nop(mut out, rest)
        left -= rest
    }
    for left > 0 {
        append_nop(mut out, max_nop_size)
        left -= max_nop_size
    }
}

fn append_jump_over_nops(mut out: []u8, count: i64) -> i64 {
    let disp = count - 2
    if disp <= short_jump_over_max {
        out.push(u8(op_jmp_short))
        out.push(u8(disp))
        return disp
    }
    let rest = count - (1 + 4)
    out.push(u8(op_jmp_near))
    append_int(mut out, 4, rest)
    rest
}

fn append_clang_layout(mut out: []u8, count: i64) {
    var left = count
    for left > max_clang_nop_size {
        append_nop(mut out, max_clang_nop_size)
        left -= max_clang_nop_size
    }
    if left > 0 {
        append_nop(mut out, left)
    }
}
