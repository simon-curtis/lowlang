const max_nop_size = 11
const max_clang_nop_size = 10
const max_nop_run = 7
const plain_nop: u8 = 0x90
const short_jump_over_max = 127

fn nop_patterns() -> [][]u8 {
    [
        [0x90],
        [0x66, 0x90],
        [0x0F, 0x1F, 0x00],
        [0x0F, 0x1F, 0x40, 0x00],
        [0x0F, 0x1F, 0x44, 0x00, 0x00],
        [0x66, 0x0F, 0x1F, 0x44, 0x00, 0x00],
        [0x0F, 0x1F, 0x80, 0x00, 0x00, 0x00, 0x00],
        [0x0F, 0x1F, 0x84, 0x00, 0x00, 0x00, 0x00, 0x00],
        [0x66, 0x0F, 0x1F, 0x84, 0x00, 0x00, 0x00, 0x00, 0x00],
        [0x66, 0x2E, 0x0F, 0x1F, 0x84, 0x00, 0x00, 0x00, 0x00, 0x00],
        [0x66, 0x66, 0x2E, 0x0F, 0x1F, 0x84, 0x00, 0x00, 0x00, 0x00, 0x00]
    ]
}

fn append_nops(mut out: []u8, count: i64, normal: bool) {
    let patterns = nop_patterns()
    var left = count
    if !normal {
        push(mut out, plain_nop)
        left -= 1
    }
    if left / max_nop_size > max_nop_run {
        left = append_jump_over_nops(mut out, left)
    }
    let rest = left % max_nop_size
    if rest != 0 {
        append_bytes(mut out, patterns[rest - 1])
        left -= rest
    }
    let longest = patterns[max_nop_size - 1]
    for left > 0 {
        append_bytes(mut out, longest)
        left -= max_nop_size
    }
}

fn append_jump_over_nops(mut out: []u8, count: i64) -> i64 {
    let disp = count - 2
    if disp <= short_jump_over_max {
        push(mut out, u8(op_jmp_short))
        push(mut out, u8(disp))
        return disp
    }
    let rest = count - (1 + 4)
    push(mut out, u8(op_jmp_near))
    append_int(mut out, 4, rest)
    rest
}

fn append_clang_layout(mut out: []u8, count: i64) {
    let patterns = nop_patterns()
    let longest = patterns[max_clang_nop_size - 1]
    var left = count
    for left > max_clang_nop_size {
        append_bytes(mut out, longest)
        left -= max_clang_nop_size
    }
    if left > 0 {
        append_bytes(mut out, patterns[left - 1])
    }
}
