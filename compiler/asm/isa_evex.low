struct EvexOp {
    name: str
    prefix: i64
    space: i64
    opcode: i64
    w: bool
    bcst: i64
}

fn evex_op(name: str, prefix: i64, space: i64, opcode: i64, w: bool, bcst: i64) -> EvexOp {
    EvexOp { name, prefix, space, opcode, w, bcst }
}

fn evex_form(op: EvexOp, slots: []Slot) -> Form {
    var f = new_form(op.opcode, slots).evex_encoded().pfx(op.prefix).in_space(op.space).broadcasts(op.bcst)
    if op.w {
        f = f.vex_w1()
    }
    f
}

fn add_evex(b: *IsaBuilder) {
    add_evex_three_operand(b)
    add_evex_compares(b)
    add_evex_shifts(b)
    add_evex_moves(b)
    add_evex_lane_conversions(b)
    add_evex_broadcasts(b)
    add_evex_widths(b)
}

fn evex_three_operand() -> []EvexOp {
    [
        evex_op("vaddps", 0, space_0f, 0x58, false, 4),
        evex_op("vaddpd", 0x66, space_0f, 0x58, true, 8),
        evex_op("vmulps", 0, space_0f, 0x59, false, 4),
        evex_op("vmulpd", 0x66, space_0f, 0x59, true, 8),
        evex_op("vsubps", 0, space_0f, 0x5C, false, 4),
        evex_op("vsubpd", 0x66, space_0f, 0x5C, true, 8),
        evex_op("vminps", 0, space_0f, 0x5D, false, 4),
        evex_op("vminpd", 0x66, space_0f, 0x5D, true, 8),
        evex_op("vdivps", 0, space_0f, 0x5E, false, 4),
        evex_op("vdivpd", 0x66, space_0f, 0x5E, true, 8),
        evex_op("vmaxps", 0, space_0f, 0x5F, false, 4),
        evex_op("vmaxpd", 0x66, space_0f, 0x5F, true, 8),
        evex_op("vpaddb", 0x66, space_0f, 0xFC, false, 0),
        evex_op("vpaddw", 0x66, space_0f, 0xFD, false, 0),
        evex_op("vpaddd", 0x66, space_0f, 0xFE, false, 4),
        evex_op("vpaddq", 0x66, space_0f, 0xD4, true, 8),
        evex_op("vpsubb", 0x66, space_0f, 0xF8, false, 0),
        evex_op("vpsubw", 0x66, space_0f, 0xF9, false, 0),
        evex_op("vpsubd", 0x66, space_0f, 0xFA, false, 4),
        evex_op("vpsubq", 0x66, space_0f, 0xFB, true, 8),
        evex_op("vpmullw", 0x66, space_0f, 0xD5, false, 0),
        evex_op("vpmulld", 0x66, space_0f38, 0x40, false, 4),
        evex_op("vpmullq", 0x66, space_0f38, 0x40, true, 8),
        evex_op("vpandd", 0x66, space_0f, 0xDB, false, 4),
        evex_op("vpandq", 0x66, space_0f, 0xDB, true, 8),
        evex_op("vpandnd", 0x66, space_0f, 0xDF, false, 4),
        evex_op("vpandnq", 0x66, space_0f, 0xDF, true, 8),
        evex_op("vpord", 0x66, space_0f, 0xEB, false, 4),
        evex_op("vporq", 0x66, space_0f, 0xEB, true, 8),
        evex_op("vpxord", 0x66, space_0f, 0xEF, false, 4),
        evex_op("vpxorq", 0x66, space_0f, 0xEF, true, 8),
        evex_op("vpminsd", 0x66, space_0f38, 0x39, false, 4),
        evex_op("vpminsq", 0x66, space_0f38, 0x39, true, 8),
        evex_op("vpminub", 0x66, space_0f, 0xDA, false, 0),
        evex_op("vpminuw", 0x66, space_0f38, 0x3A, false, 0),
        evex_op("vpminud", 0x66, space_0f38, 0x3B, false, 4),
        evex_op("vpminuq", 0x66, space_0f38, 0x3B, true, 8),
        evex_op("vpmaxsd", 0x66, space_0f38, 0x3D, false, 4),
        evex_op("vpmaxsq", 0x66, space_0f38, 0x3D, true, 8),
        evex_op("vpmaxub", 0x66, space_0f, 0xDE, false, 0),
        evex_op("vpmaxuw", 0x66, space_0f38, 0x3E, false, 0),
        evex_op("vpmaxud", 0x66, space_0f38, 0x3F, false, 4),
        evex_op("vpmaxuq", 0x66, space_0f38, 0x3F, true, 8),
        evex_op("vpshufb", 0x66, space_0f38, 0x00, false, 0),
        evex_op("vpblendmb", 0x66, space_0f38, 0x66, false, 0),
        evex_op("vpblendmw", 0x66, space_0f38, 0x66, true, 0),
        evex_op("vpblendmd", 0x66, space_0f38, 0x64, false, 4),
        evex_op("vpblendmq", 0x66, space_0f38, 0x64, true, 8)
    ]
}

fn add_evex_three_operand(b: *IsaBuilder) {
    for op in evex_three_operand() {
        isa_add(b, op.name, [evex_form(op, [evec(), evec(), evecm()]).rr(r1, r3).nds(r2)])
    }
    let ternary = [
        evex_op("vpternlogd", 0x66, space_0f3a, 0x25, false, 4),
        evex_op("vpternlogq", 0x66, space_0f3a, 0x25, true, 8)
    ]
    for op in ternary {
        isa_add(b, op.name, [evex_form(op, [evec(), evec(), evecm(), imm(slot_imm8)]).rr(r1, r3).nds(r2).with_imm(r4)])
    }
}

fn add_evex_compares(b: *IsaBuilder) {
    let fixed = [
        evex_op("vpcmpeqb", 0x66, space_0f, 0x74, false, 0),
        evex_op("vpcmpeqw", 0x66, space_0f, 0x75, false, 0),
        evex_op("vpcmpeqd", 0x66, space_0f, 0x76, false, 4),
        evex_op("vpcmpeqq", 0x66, space_0f38, 0x29, true, 8),
        evex_op("vpcmpgtb", 0x66, space_0f, 0x64, false, 0),
        evex_op("vpcmpgtw", 0x66, space_0f, 0x65, false, 0),
        evex_op("vpcmpgtd", 0x66, space_0f, 0x66, false, 4),
        evex_op("vpcmpgtq", 0x66, space_0f38, 0x37, true, 8)
    ]
    for op in fixed {
        isa_add(b, op.name, [evex_form(op, [kreg(), evec(), evecm()]).rr(r1, r3).nds(r2)])
    }
    let predicated = [
        evex_op("vpcmpb", 0x66, space_0f3a, 0x3F, false, 0),
        evex_op("vpcmpub", 0x66, space_0f3a, 0x3E, false, 0),
        evex_op("vpcmpw", 0x66, space_0f3a, 0x3F, true, 0),
        evex_op("vpcmpuw", 0x66, space_0f3a, 0x3E, true, 0),
        evex_op("vpcmpd", 0x66, space_0f3a, 0x1F, false, 4),
        evex_op("vpcmpud", 0x66, space_0f3a, 0x1E, false, 4),
        evex_op("vpcmpq", 0x66, space_0f3a, 0x1F, true, 8),
        evex_op("vpcmpuq", 0x66, space_0f3a, 0x1E, true, 8),
        evex_op("vcmpps", 0, space_0f, 0xC2, false, 4),
        evex_op("vcmppd", 0x66, space_0f, 0xC2, true, 8)
    ]
    for op in predicated {
        isa_add(b, op.name, [evex_form(op, [kreg(), evec(), evecm(), imm(slot_imm8)]).rr(r1, r3).nds(r2).with_imm(r4)])
    }
}

fn add_evex_shifts(b: *IsaBuilder) {
    let shifts = [
        evex_op("vpsllw", 0x66, space_0f, 0xF1, false, 0),
        evex_op("vpslld", 0x66, space_0f, 0xF2, false, 0),
        evex_op("vpsllq", 0x66, space_0f, 0xF3, true, 0),
        evex_op("vpsrlw", 0x66, space_0f, 0xD1, false, 0),
        evex_op("vpsrld", 0x66, space_0f, 0xD2, false, 0),
        evex_op("vpsrlq", 0x66, space_0f, 0xD3, true, 0),
        evex_op("vpsrad", 0x66, space_0f, 0xE2, false, 0),
        evex_op("vpsraq", 0x66, space_0f, 0xE2, true, 0)
    ]
    for op in shifts {
        isa_add(b, op.name, [evex_form(op, [evec(), evec(), exmmm(16)]).compressed(16).rr(r1, r3).nds(r2)])
    }
}

fn add_evex_moves(b: *IsaBuilder) {
    let moves = [
        evex_op("vmovdqa32", 0x66, space_0f, 0x6F, false, 0),
        evex_op("vmovdqa64", 0x66, space_0f, 0x6F, true, 0),
        evex_op("vmovdqu8", 0xF2, space_0f, 0x6F, false, 0),
        evex_op("vmovdqu16", 0xF2, space_0f, 0x6F, true, 0),
        evex_op("vmovdqu32", 0xF3, space_0f, 0x6F, false, 0),
        evex_op("vmovdqu64", 0xF3, space_0f, 0x6F, true, 0)
    ]
    for op in moves {
        var store = op
        store.opcode = 0x7F
        isa_add(b, op.name, [
            evex_form(op, [evec(), evecm()]).rr(r1, r2),
            evex_form(store, [evecm(), evec()]).rr(r2, r1)
        ])
    }
}

fn add_evex_lane_conversions(b: *IsaBuilder) {
    let to_vector = [
        evex_op("vpmovm2b", 0xF3, space_0f38, 0x28, false, 0),
        evex_op("vpmovm2w", 0xF3, space_0f38, 0x28, true, 0),
        evex_op("vpmovm2d", 0xF3, space_0f38, 0x38, false, 0),
        evex_op("vpmovm2q", 0xF3, space_0f38, 0x38, true, 0)
    ]
    for op in to_vector {
        isa_add(b, op.name, [evex_form(op, [evec(), kreg()]).without_mask().rr(r1, r2)])
    }
    let to_mask = [
        evex_op("vpmovb2m", 0xF3, space_0f38, 0x29, false, 0),
        evex_op("vpmovw2m", 0xF3, space_0f38, 0x29, true, 0),
        evex_op("vpmovd2m", 0xF3, space_0f38, 0x39, false, 0),
        evex_op("vpmovq2m", 0xF3, space_0f38, 0x39, true, 0)
    ]
    for op in to_mask {
        isa_add(b, op.name, [evex_form(op, [kreg(), evec()]).without_mask().rr(r1, r2)])
    }
}

struct LaneBroadcast {
    name: str
    from_vector: i64
    from_gp: i64
    size: i64
}

fn add_evex_broadcasts(b: *IsaBuilder) {
    let lanes = [
        LaneBroadcast { name: "vpbroadcastb", from_vector: 0x78, from_gp: 0x7A, size: 1 },
        LaneBroadcast { name: "vpbroadcastw", from_vector: 0x79, from_gp: 0x7B, size: 2 },
        LaneBroadcast { name: "vpbroadcastd", from_vector: 0x58, from_gp: 0x7C, size: 4 },
        LaneBroadcast { name: "vpbroadcastq", from_vector: 0x59, from_gp: 0x7C, size: 8 }
    ]
    for l in lanes {
        let wide = l.size == 8
        var gp_size = 4
        if wide {
            gp_size = 8
        }
        let source = evex_op(l.name, 0x66, space_0f38, l.from_vector, wide, 0)
        let register = evex_op(l.name, 0x66, space_0f38, l.from_gp, wide, 0)
        isa_add(b, l.name, [
            evex_form(source, [evec(), exmmm(l.size)]).compressed(l.size).rr(r1, r2),
            evex_form(register, [evec(), gp(gp_size)]).rr(r1, r2)
        ])
    }
}

struct MaskWidth {
    suffix: str
    size: i64
    prefix: i64
    w: bool
    gp_prefix: i64
}

fn mask_widths() -> []MaskWidth {
    [
        MaskWidth { suffix: "b", size: 1, prefix: 0x66, w: false, gp_prefix: 0x66 },
        MaskWidth { suffix: "w", size: 2, prefix: 0, w: false, gp_prefix: 0 },
        MaskWidth { suffix: "d", size: 4, prefix: 0x66, w: true, gp_prefix: 0xF2 },
        MaskWidth { suffix: "q", size: 8, prefix: 0, w: true, gp_prefix: 0xF2 }
    ]
}

struct MaskOp {
    name: str
    opcode: i64
}

fn mask_form(opcode: i64, slots: []Slot, prefix: i64, w: bool) -> Form {
    var f = new_form(opcode, slots).vex_encoded().pfx(prefix).in_space(space_0f)
    if w {
        f = f.vex_w1()
    }
    f
}

fn add_mask(b: *IsaBuilder) {
    for m in mask_widths() {
        add_mask_moves(b, m)
        add_mask_logic(b, m)
    }
}

fn add_mask_moves(b: *IsaBuilder, m: MaskWidth) {
    var gp_size = 4
    if m.size == 8 {
        gp_size = 8
    }
    let gp_w = m.size == 8
    isa_add(b, "kmov{m.suffix}", [
        mask_form(0x90, [kreg(), kregm(m.size)], m.prefix, m.w).rr(r1, r2),
        mask_form(0x91, [mem(m.size), kreg()], m.prefix, m.w).rr(r2, r1),
        mask_form(0x92, [kreg(), gp(gp_size)], m.gp_prefix, gp_w).rr(r1, r2),
        mask_form(0x93, [gp(gp_size), kreg()], m.gp_prefix, gp_w).rr(r1, r2)
    ])
}

fn add_mask_logic(b: *IsaBuilder, m: MaskWidth) {
    let binary = [
        MaskOp { name: "kand", opcode: 0x41 },
        MaskOp { name: "kandn", opcode: 0x42 },
        MaskOp { name: "kor", opcode: 0x45 },
        MaskOp { name: "kxnor", opcode: 0x46 },
        MaskOp { name: "kxor", opcode: 0x47 }
    ]
    for op in binary {
        isa_add(b, "{op.name}{m.suffix}", [mask_form(op.opcode, [kreg(), kreg(), kreg()], m.prefix, m.w).vex_l256_only().rr(r1, r3).nds(r2)])
    }
    let unary = [
        MaskOp { name: "knot", opcode: 0x44 },
        MaskOp { name: "kortest", opcode: 0x98 },
        MaskOp { name: "ktest", opcode: 0x99 }
    ]
    for op in unary {
        isa_add(b, "{op.name}{m.suffix}", [mask_form(op.opcode, [kreg(), kreg()], m.prefix, m.w).rr(r1, r2)])
    }
}

fn add_evex_widths(b: *IsaBuilder) {
    let extend = evex_op("vpmovzxbw", 0x66, space_0f38, 0x30, false, 0)
    let narrow = evex_op("vpmovwb", 0xF3, space_0f38, 0x30, false, 0)
    isa_add(b, extend.name, [
        evex_form(extend, [epart(16), epart(16)]).rr(r1, r2),
        evex_form(extend, [epart(32), epart(16)]).rr(r1, r2),
        evex_form(extend, [epart(64), epart(32)]).rr(r1, r2)
    ])
    isa_add(b, narrow.name, [
        evex_form(narrow, [epart(16), epart(16)]).rr(r2, r1),
        evex_form(narrow, [epart(16), epart(32)]).rr(r2, r1),
        evex_form(narrow, [epart(32), epart(64)]).rr(r2, r1)
    ])
    let extract = evex_op("vextracti64x4", 0x66, space_0f3a, 0x3B, true, 0)
    let insert = evex_op("vinserti64x4", 0x66, space_0f3a, 0x3A, true, 0)
    isa_add(b, extract.name, [evex_form(extract, [epart(32), epart(64), imm(slot_imm8)]).rr(r2, r1).with_imm(r3)])
    isa_add(b, insert.name, [evex_form(insert, [epart(64), epart(64), epart(32), imm(slot_imm8)]).rr(r1, r3).nds(r2).with_imm(r4)])
}
