const class_none = 0
const class_gp8 = 1
const class_gp8_high = 2
const class_gp16 = 3
const class_gp32 = 4
const class_gp64 = 5
const class_xmm = 6
const class_ymm = 7
const class_segment = 8
const class_ip = 9

const reg_none = 0
const reg_count = 108

const first_high_byte = 65
const first_xmm = 69
const first_ymm = 85
const first_segment = 101
const reg_rip = 107

fn gp_name(n: i64, width: i64) -> str {
    if n < 8 {
        return match n {
            0 => gp_name_a(width)
            1 => gp_name_c(width)
            2 => gp_name_d(width)
            3 => gp_name_b(width)
            4 => gp_name_sp(width)
            5 => gp_name_bp(width)
            6 => gp_name_si(width)
            _ => gp_name_di(width)
        }
    }
    let suffix = match width {
        0 => "b"
        1 => "w"
        2 => "d"
        _ => ""
    }
    "r{n}{suffix}"
}

fn gp_name_a(width: i64) -> str {
    match width {
        0 => "al"
        1 => "ax"
        2 => "eax"
        _ => "rax"
    }
}

fn gp_name_c(width: i64) -> str {
    match width {
        0 => "cl"
        1 => "cx"
        2 => "ecx"
        _ => "rcx"
    }
}

fn gp_name_d(width: i64) -> str {
    match width {
        0 => "dl"
        1 => "dx"
        2 => "edx"
        _ => "rdx"
    }
}

fn gp_name_b(width: i64) -> str {
    match width {
        0 => "bl"
        1 => "bx"
        2 => "ebx"
        _ => "rbx"
    }
}

fn gp_name_sp(width: i64) -> str {
    match width {
        0 => "spl"
        1 => "sp"
        2 => "esp"
        _ => "rsp"
    }
}

fn gp_name_bp(width: i64) -> str {
    match width {
        0 => "bpl"
        1 => "bp"
        2 => "ebp"
        _ => "rbp"
    }
}

fn gp_name_si(width: i64) -> str {
    match width {
        0 => "sil"
        1 => "si"
        2 => "esi"
        _ => "rsi"
    }
}

fn gp_name_di(width: i64) -> str {
    match width {
        0 => "dil"
        1 => "di"
        2 => "edi"
        _ => "rdi"
    }
}

fn high_byte_name(i: i64) -> str {
    match i {
        0 => "ah"
        1 => "ch"
        2 => "dh"
        _ => "bh"
    }
}

fn segment_name(i: i64) -> str {
    match i {
        0 => "es"
        1 => "cs"
        2 => "ss"
        3 => "ds"
        4 => "fs"
        _ => "gs"
    }
}

fn reg_class(r: i64) -> i64 {
    if r == reg_none {
        return class_none
    }
    if r < first_high_byte {
        return match (r - 1) / 16 {
            0 => class_gp8
            1 => class_gp16
            2 => class_gp32
            _ => class_gp64
        }
    }
    if r < first_xmm {
        return class_gp8_high
    }
    if r < first_ymm {
        return class_xmm
    }
    if r < first_segment {
        return class_ymm
    }
    if r < reg_rip {
        return class_segment
    }
    class_ip
}

fn reg_num(r: i64) -> i64 {
    if r == reg_none {
        return 0
    }
    if r < first_high_byte {
        return (r - 1) % 16
    }
    if r < first_xmm {
        return 4 + r - first_high_byte
    }
    if r < first_ymm {
        return r - first_xmm
    }
    if r < first_segment {
        return r - first_ymm
    }
    if r < reg_rip {
        return r - first_segment
    }
    0
}

fn reg_name(r: i64) -> str {
    if r == reg_none {
        return ""
    }
    if r < first_high_byte {
        return gp_name((r - 1) % 16, (r - 1) / 16)
    }
    if r < first_xmm {
        return high_byte_name(r - first_high_byte)
    }
    if r < first_ymm {
        return "xmm{r - first_xmm}"
    }
    if r < first_segment {
        return "ymm{r - first_ymm}"
    }
    if r < reg_rip {
        return segment_name(r - first_segment)
    }
    "rip"
}

fn build_reg_by_name() -> [str: i64] {
    var by_name: [str: i64] = [:]
    for i in 1..reg_count {
        by_name[reg_name(i)] = i
    }
    by_name
}

fn lookup_reg(a: *Assembler, name: str) -> i64 {
    a.reg_by_name[name] ?? reg_none
}
