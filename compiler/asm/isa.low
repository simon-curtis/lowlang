const max_form_slots = 4

const slot_none = 0
const slot_gp = 1
const slot_gp_mem = 2
const slot_mem = 3
const slot_acc = 4
const slot_cl = 5
const slot_imm8 = 6
const slot_imm8s = 7
const slot_imm_osz = 8
const slot_imm64 = 9
const slot_imm_one = 10
const slot_xmm = 11
const slot_xmm_mem = 12
const slot_ymm = 13
const slot_vec = 14
const slot_vec_mem = 15

struct Slot {
    kind: i64 = 0
    size: i64 = 0
}

const r1 = 1
const r2 = 2
const r3 = 3
const r4 = 4

const space_base = 0
const space_0f = 1
const space_0f38 = 2
const space_0f3a = 3

const width_fixed = 0
const width_opcode = 1
const width_size = 2

const size8 = 1
const size16 = 2
const size32 = 4
const size64 = 8
const size_all = 15

const fuse_none = 0
const fuse_test_and = 1
const fuse_alu_cmp = 2
const fuse_inc_dec = 3

struct Form {
    slots: []Slot = []
    count: i64 = 0
    prefix: i64 = 0
    space: i64 = 0
    opcode: i64 = 0
    tail: i64 = 0
    has_tail: bool = false
    modrm: bool = false
    digit: i64 = 0
    reg: i64 = 0
    rm: i64 = 0
    vvvv: i64 = 0
    is4: i64 = 0
    imm: i64 = 0
    plus_reg: i64 = 0
    width: i64 = 0
    sizes: i64 = 0
    rex_w: bool = false
    no_w: bool = false
    vex: bool = false
    vex_w: bool = false
    vex_l256: bool = false
    swap: i64 = 0
    fuse: i64 = 0
    branch: bool = false
}

fn new_form(opcode: i64, slots: []Slot) -> Form {
    Form { slots, count: slots.len, opcode, sizes: size_all }
}

fn pfx(f: Form, b: i64) -> Form {
    var g = f
    g.prefix = b
    g
}

fn in_space(f: Form, space: i64) -> Form {
    var g = f
    g.space = space
    g
}

fn rr(f: Form, reg: i64, rm: i64) -> Form {
    var g = f
    g.modrm = true
    g.reg = reg
    g.rm = rm
    g
}

fn ext(f: Form, digit: i64, rm: i64) -> Form {
    var g = f
    g.modrm = true
    g.digit = digit
    g.rm = rm
    g
}

fn plus(f: Form, r: i64) -> Form {
    var g = f
    g.plus_reg = r
    g
}

fn with_imm(f: Form, r: i64) -> Form {
    var g = f
    g.imm = r
    g
}

fn by_opcode(f: Form) -> Form {
    var g = f
    g.width = width_opcode
    g
}

fn by_size(f: Form) -> Form {
    var g = f
    g.width = width_size
    g
}

fn only(f: Form, mask: i64) -> Form {
    var g = f
    g.sizes = mask
    g
}

fn w(f: Form) -> Form {
    var g = f
    g.rex_w = true
    g
}

fn default64(f: Form) -> Form {
    var g = f
    g.no_w = true
    g.sizes = size64
    g
}

fn tail_byte(f: Form, b: i64) -> Form {
    var g = f
    g.tail = b
    g.has_tail = true
    g
}

fn vex_encoded(f: Form) -> Form {
    var g = f
    g.vex = true
    g
}

fn vex_w1(f: Form) -> Form {
    var g = f
    g.vex_w = true
    g
}

fn vex_l256_only(f: Form) -> Form {
    var g = f
    g.vex_l256 = true
    g
}

fn nds(f: Form, r: i64) -> Form {
    var g = f
    g.vvvv = r
    g
}

fn fourth(f: Form, r: i64) -> Form {
    var g = f
    g.is4 = r
    g
}

fn swap_to(f: Form, opcode: i64) -> Form {
    var g = f
    g.swap = opcode
    g
}

fn fusing(f: Form, class: i64) -> Form {
    var g = f
    g.fuse = class
    g
}

fn branching(f: Form) -> Form {
    var g = f
    g.branch = true
    g
}

fn gp(size: i64) -> Slot {
    Slot { kind: slot_gp, size }
}

fn gpm(size: i64) -> Slot {
    Slot { kind: slot_gp_mem, size }
}

fn mem(size: i64) -> Slot {
    Slot { kind: slot_mem, size }
}

fn xmm() -> Slot {
    Slot { kind: slot_xmm }
}

fn xmmm(size: i64) -> Slot {
    Slot { kind: slot_xmm_mem, size }
}

fn vec() -> Slot {
    Slot { kind: slot_vec }
}

fn vecm() -> Slot {
    Slot { kind: slot_vec_mem }
}

fn imm(kind: i64) -> Slot {
    Slot { kind }
}

fn accumulator() -> Slot {
    Slot { kind: slot_acc }
}

fn count_cl() -> Slot {
    Slot { kind: slot_cl }
}

fn ymm_reg() -> Slot {
    Slot { kind: slot_ymm }
}

struct Condition {
    name: str
    code: i64
}

fn condition(name: str, code: i64) -> Condition {
    Condition { name, code }
}

fn conditions() -> []Condition {
    [
        condition("o", 0),
        condition("no", 1),
        condition("b", 2),
        condition("c", 2),
        condition("nae", 2),
        condition("ae", 3),
        condition("nb", 3),
        condition("nc", 3),
        condition("e", 4),
        condition("z", 4),
        condition("ne", 5),
        condition("nz", 5),
        condition("be", 6),
        condition("na", 6),
        condition("a", 7),
        condition("nbe", 7),
        condition("s", 8),
        condition("ns", 9),
        condition("p", 10),
        condition("pe", 10),
        condition("np", 11),
        condition("po", 11),
        condition("l", 12),
        condition("nge", 12),
        condition("ge", 13),
        condition("nl", 13),
        condition("le", 14),
        condition("ng", 14),
        condition("g", 15),
        condition("nle", 15)
    ]
}

fn build_conditional_jumps() -> [str: i64] {
    var jumps: [str: i64] = [:]
    for c in conditions() {
        jumps["j{c.name}"] = c.code
    }
    jumps
}

struct IsaBuilder {
    forms: [str: []Form]
}

fn isa_add(b: *IsaBuilder, name: str, forms: []Form) {
    var existing = b.forms[name] ?? []
    for f in forms {
        push(mut existing, f)
    }
    b.forms[name] = existing
}

fn build_isa() -> [str: []Form] {
    let b = new(IsaBuilder { forms: [:] })
    add_integer_alu(b)
    add_moves(b)
    add_unary(b)
    add_shifts(b)
    add_bits(b)
    add_conditionals(b)
    add_control(b)
    add_fixed(b)
    add_sse(b)
    add_vex(b)
    b.forms
}

struct AluOp {
    name: str
    base: i64
    digit: i64
    fuse: i64
}

fn alu_op(name: str, base: i64, digit: i64, fuse: i64) -> AluOp {
    AluOp { name, base, digit, fuse }
}

struct UnaryOp {
    name: str
    opcode: i64
    digit: i64
}

fn unary_op(name: str, opcode: i64, digit: i64) -> UnaryOp {
    UnaryOp { name, opcode, digit }
}

struct ShiftOp {
    name: str
    digit: i64
}

fn shift_op(name: str, digit: i64) -> ShiftOp {
    ShiftOp { name, digit }
}

struct BitTest {
    name: str
    reg: i64
    digit: i64
}

fn bit_test(name: str, reg: i64, digit: i64) -> BitTest {
    BitTest { name, reg, digit }
}

struct SseMove {
    name: str
    prefix: i64
    load: i64
    store: i64
    mem: i64
}

fn sse_move(name: str, prefix: i64, load: i64, store: i64, mem: i64) -> SseMove {
    SseMove { name, prefix, load, store, mem }
}

struct SseOp {
    name: str
    prefix: i64
    opcode: i64
    mem: i64
}

fn sse_op(name: str, prefix: i64, opcode: i64, mem: i64) -> SseOp {
    SseOp { name, prefix, opcode, mem }
}

struct ConvertOp {
    name: str
    prefix: i64
    opcode: i64
    mem: i64
}

fn convert_op(name: str, prefix: i64, opcode: i64, mem: i64) -> ConvertOp {
    ConvertOp { name, prefix, opcode, mem }
}

struct PackedOp {
    name: str
    opcode: i64
}

fn packed_op(name: str, opcode: i64) -> PackedOp {
    PackedOp { name, opcode }
}

struct VexOp {
    name: str
    prefix: i64
    space: i64
    opcode: i64
}

fn vex_op(name: str, prefix: i64, space: i64, opcode: i64) -> VexOp {
    VexOp { name, prefix, space, opcode }
}

struct VexMove {
    name: str
    prefix: i64
}

fn vex_move(name: str, prefix: i64) -> VexMove {
    VexMove { name, prefix }
}

fn add_integer_alu(b: *IsaBuilder) {
    let alu = [
        alu_op("add", 0x00, 0, fuse_alu_cmp),
        alu_op("or", 0x08, 1, fuse_none),
        alu_op("adc", 0x10, 2, fuse_none),
        alu_op("sbb", 0x18, 3, fuse_none),
        alu_op("and", 0x20, 4, fuse_test_and),
        alu_op("sub", 0x28, 5, fuse_alu_cmp),
        alu_op("xor", 0x30, 6, fuse_none),
        alu_op("cmp", 0x38, 7, fuse_alu_cmp)
    ]
    for op in alu {
        isa_add(b, op.name, [
            new_form(op.base, [gpm(0), gp(0)]).by_opcode().rr(r2, r1).fusing(op.fuse),
            new_form(op.base+2, [gp(0), gpm(0)]).by_opcode().rr(r1, r2).fusing(op.fuse),
            new_form(0x83, [gpm(0), imm(slot_imm8s)]).by_size().only(size16|size32|size64).ext(op.digit, r1).with_imm(r2).fusing(op.fuse),
            new_form(op.base+4, [accumulator(), imm(slot_imm_osz)]).by_opcode().with_imm(r2).fusing(op.fuse),
            new_form(0x80, [gpm(0), imm(slot_imm_osz)]).by_opcode().ext(op.digit, r1).with_imm(r2).fusing(op.fuse)
        ])
    }
    isa_add(b, "test", [
        new_form(0x84, [gpm(0), gp(0)]).by_opcode().rr(r2, r1).fusing(fuse_test_and),
        new_form(0x84, [gp(0), mem(0)]).by_opcode().rr(r1, r2).fusing(fuse_test_and),
        new_form(0xA8, [accumulator(), imm(slot_imm_osz)]).by_opcode().with_imm(r2).fusing(fuse_test_and),
        new_form(0xF6, [gpm(0), imm(slot_imm_osz)]).by_opcode().ext(0, r1).with_imm(r2).fusing(fuse_test_and)
    ])
}

fn add_moves(b: *IsaBuilder) {
    isa_add(b, "mov", [
        new_form(0x88, [gpm(0), gp(0)]).by_opcode().rr(r2, r1),
        new_form(0x8A, [gp(0), gpm(0)]).by_opcode().rr(r1, r2),
        new_form(0xB0, [gp(1), imm(slot_imm8)]).plus(r1).with_imm(r2),
        new_form(0xB8, [gp(0), imm(slot_imm_osz)]).by_size().only(size16|size32).plus(r1).with_imm(r2),
        new_form(0xC6, [gpm(0), imm(slot_imm_osz)]).by_opcode().ext(0, r1).with_imm(r2),
        new_form(0xB8, [gp(0), imm(slot_imm64)]).by_size().only(size64).plus(r1).with_imm(r2)
    ])
    isa_add(b, "movzx", [
        new_form(0xB6, [gp(0), gpm(1)]).in_space(space_0f).by_size().only(size16|size32|size64).rr(r1, r2),
        new_form(0xB7, [gp(0), gpm(2)]).in_space(space_0f).by_size().only(size32|size64).rr(r1, r2)
    ])
    isa_add(b, "movsx", [
        new_form(0xBE, [gp(0), gpm(1)]).in_space(space_0f).by_size().only(size16|size32|size64).rr(r1, r2),
        new_form(0xBF, [gp(0), gpm(2)]).in_space(space_0f).by_size().only(size32|size64).rr(r1, r2)
    ])
    isa_add(b, "movsxd", [new_form(0x63, [gp(0), gpm(4)]).by_size().only(size64).rr(r1, r2)])
    isa_add(b, "lea", [new_form(0x8D, [gp(0), mem(0)]).by_size().only(size16|size32|size64).rr(r1, r2)])
    isa_add(b, "xchg", [
        new_form(0x86, [gpm(0), gp(0)]).by_opcode().rr(r2, r1),
        new_form(0x86, [gp(0), mem(0)]).by_opcode().rr(r1, r2)
    ])
    isa_add(b, "cmpxchg", [new_form(0xB0, [gpm(0), gp(0)]).in_space(space_0f).by_opcode().rr(r2, r1)])
    isa_add(b, "push", [
        new_form(0x50, [gp(8)]).default64().plus(r1),
        new_form(0xFF, [gpm(8)]).default64().ext(6, r1)
    ])
    isa_add(b, "pop", [
        new_form(0x58, [gp(8)]).default64().plus(r1),
        new_form(0x8F, [gpm(8)]).default64().ext(0, r1)
    ])
}

fn add_unary(b: *IsaBuilder) {
    let unary = [
        unary_op("not", 0xF6, 2),
        unary_op("neg", 0xF6, 3),
        unary_op("mul", 0xF6, 4),
        unary_op("div", 0xF6, 6),
        unary_op("idiv", 0xF6, 7)
    ]
    for u in unary {
        isa_add(b, u.name, [new_form(u.opcode, [gpm(0)]).by_opcode().ext(u.digit, r1)])
    }
    isa_add(b, "inc", [new_form(0xFE, [gpm(0)]).by_opcode().ext(0, r1).fusing(fuse_inc_dec)])
    isa_add(b, "dec", [new_form(0xFE, [gpm(0)]).by_opcode().ext(1, r1).fusing(fuse_inc_dec)])
    isa_add(b, "imul", [
        new_form(0xF6, [gpm(0)]).by_opcode().ext(5, r1),
        new_form(0xAF, [gp(0), gpm(0)]).in_space(space_0f).by_size().only(size16|size32|size64).rr(r1, r2),
        new_form(0x6B, [gp(0), gpm(0), imm(slot_imm8s)]).by_size().only(size16|size32|size64).rr(r1, r2).with_imm(r3),
        new_form(0x69, [gp(0), gpm(0), imm(slot_imm_osz)]).by_size().only(size16|size32|size64).rr(r1, r2).with_imm(r3),
        new_form(0x6B, [gp(0), imm(slot_imm8s)]).by_size().only(size16|size32|size64).rr(r1, r1).with_imm(r2),
        new_form(0x69, [gp(0), imm(slot_imm_osz)]).by_size().only(size16|size32|size64).rr(r1, r1).with_imm(r2)
    ])
}

fn add_shifts(b: *IsaBuilder) {
    let shifts = [
        shift_op("rol", 0),
        shift_op("ror", 1),
        shift_op("shl", 4),
        shift_op("shr", 5),
        shift_op("sar", 7)
    ]
    for s in shifts {
        isa_add(b, s.name, [
            new_form(0xD0, [gpm(0), imm(slot_imm_one)]).by_opcode().ext(s.digit, r1),
            new_form(0xC0, [gpm(0), imm(slot_imm8)]).by_opcode().ext(s.digit, r1).with_imm(r2),
            new_form(0xD2, [gpm(0), count_cl()]).by_opcode().ext(s.digit, r1)
        ])
    }
}

fn add_bits(b: *IsaBuilder) {
    let tests = [
        bit_test("bt", 0xA3, 4),
        bit_test("bts", 0xAB, 5),
        bit_test("btr", 0xB3, 6),
        bit_test("btc", 0xBB, 7)
    ]
    let wide = size16 | size32 | size64
    for t in tests {
        isa_add(b, t.name, [
            new_form(t.reg, [gpm(0), gp(0)]).in_space(space_0f).by_size().only(wide).rr(r2, r1),
            new_form(0xBA, [gpm(0), imm(slot_imm8)]).in_space(space_0f).by_size().only(wide).ext(t.digit, r1).with_imm(r2)
        ])
    }
    isa_add(b, "bsf", [new_form(0xBC, [gp(0), gpm(0)]).in_space(space_0f).by_size().only(wide).rr(r1, r2)])
    isa_add(b, "bsr", [new_form(0xBD, [gp(0), gpm(0)]).in_space(space_0f).by_size().only(wide).rr(r1, r2)])
    isa_add(b, "popcnt", [new_form(0xB8, [gp(0), gpm(0)]).pfx(0xF3).in_space(space_0f).by_size().only(wide).rr(r1, r2)])
    isa_add(b, "rdrand", [new_form(0xC7, [gp(0)]).in_space(space_0f).by_size().only(wide).ext(6, r1)])
}

fn add_conditionals(b: *IsaBuilder) {
    let wide = size16 | size32 | size64
    for c in conditions() {
        isa_add(b, "set{c.name}", [new_form(0x90+c.code, [gpm(1)]).in_space(space_0f).ext(0, r1)])
        isa_add(b, "cmov{c.name}", [new_form(0x40+c.code, [gp(0), gpm(0)]).in_space(space_0f).by_size().only(wide).rr(r1, r2)])
    }
}

fn add_control(b: *IsaBuilder) {
    isa_add(b, "call", [new_form(0xFF, [gpm(8)]).default64().ext(2, r1).branching()])
    isa_add(b, "jmp", [new_form(0xFF, [gpm(8)]).default64().ext(4, r1).branching()])
    isa_add(b, "ret", [new_form(0xC3, []).branching()])
}

fn add_fixed(b: *IsaBuilder) {
    isa_add(b, "nop", [new_form(0x90, [])])
    isa_add(b, "hlt", [new_form(0xF4, [])])
    isa_add(b, "leave", [new_form(0xC9, [])])
    isa_add(b, "syscall", [new_form(0x05, []).in_space(space_0f)])
    isa_add(b, "cpuid", [new_form(0xA2, []).in_space(space_0f)])
    isa_add(b, "rdtsc", [new_form(0x31, []).in_space(space_0f)])
    isa_add(b, "pause", [new_form(0x90, []).pfx(0xF3)])
    isa_add(b, "ud2", [new_form(0x0B, []).in_space(space_0f)])
    isa_add(b, "cqo", [new_form(0x99, []).w()])
    isa_add(b, "cld", [new_form(0xFC, [])])
    isa_add(b, "std", [new_form(0xFD, [])])
    isa_add(b, "mfence", [new_form(0xAE, []).in_space(space_0f).tail_byte(0xF0)])
    isa_add(b, "xgetbv", [new_form(0x01, []).in_space(space_0f).tail_byte(0xD0)])
    isa_add(b, "stosq", [new_form(0xAB, []).w()])
    isa_add(b, "movsb", [new_form(0xA4, [])])
    isa_add(b, "cmpsb", [new_form(0xA6, [])])
    isa_add(b, "prefetcht0", [new_form(0x18, [mem(0)]).in_space(space_0f).ext(1, r1)])
}

fn add_sse(b: *IsaBuilder) {
    add_sse_moves(b)
    add_sse_arithmetic(b)
    add_sse_conversions(b)
    add_sse_packed(b)
}

fn add_sse_moves(b: *IsaBuilder) {
    let moves = [
        sse_move("movaps", 0, 0x28, 0x29, 16),
        sse_move("movups", 0, 0x10, 0x11, 16),
        sse_move("movdqa", 0x66, 0x6F, 0x7F, 16),
        sse_move("movdqu", 0xF3, 0x6F, 0x7F, 16),
        sse_move("movss", 0xF3, 0x10, 0x11, 4),
        sse_move("movsd", 0xF2, 0x10, 0x11, 8)
    ]
    for m in moves {
        isa_add(b, m.name, [
            new_form(m.load, [xmm(), xmmm(m.mem)]).pfx(m.prefix).in_space(space_0f).rr(r1, r2),
            new_form(m.store, [xmmm(m.mem), xmm()]).pfx(m.prefix).in_space(space_0f).rr(r2, r1)
        ])
    }
    isa_add(b, "movd", [
        new_form(0x6E, [xmm(), gpm(4)]).pfx(0x66).in_space(space_0f).rr(r1, r2),
        new_form(0x7E, [gpm(4), xmm()]).pfx(0x66).in_space(space_0f).rr(r2, r1)
    ])
    isa_add(b, "movq", [
        new_form(0x7E, [xmm(), xmmm(8)]).pfx(0xF3).in_space(space_0f).rr(r1, r2),
        new_form(0xD6, [xmmm(8), xmm()]).pfx(0x66).in_space(space_0f).rr(r2, r1),
        new_form(0x6E, [xmm(), gp(8)]).pfx(0x66).in_space(space_0f).w().rr(r1, r2),
        new_form(0x7E, [gp(8), xmm()]).pfx(0x66).in_space(space_0f).w().rr(r2, r1)
    ])
    isa_add(b, "movmskpd", [new_form(0x50, [gp(4), xmm()]).pfx(0x66).in_space(space_0f).rr(r1, r2)])
    isa_add(b, "movmskps", [new_form(0x50, [gp(4), xmm()]).in_space(space_0f).rr(r1, r2)])
    isa_add(b, "pmovmskb", [new_form(0xD7, [gp(4), xmm()]).pfx(0x66).in_space(space_0f).rr(r1, r2)])
}

fn add_sse_arithmetic(b: *IsaBuilder) {
    let ops = [
        sse_op("addps", 0, 0x58, 16),
        sse_op("addpd", 0x66, 0x58, 16),
        sse_op("addss", 0xF3, 0x58, 4),
        sse_op("addsd", 0xF2, 0x58, 8),
        sse_op("mulps", 0, 0x59, 16),
        sse_op("mulpd", 0x66, 0x59, 16),
        sse_op("mulss", 0xF3, 0x59, 4),
        sse_op("mulsd", 0xF2, 0x59, 8),
        sse_op("subps", 0, 0x5C, 16),
        sse_op("subpd", 0x66, 0x5C, 16),
        sse_op("subss", 0xF3, 0x5C, 4),
        sse_op("subsd", 0xF2, 0x5C, 8),
        sse_op("minps", 0, 0x5D, 16),
        sse_op("minpd", 0x66, 0x5D, 16),
        sse_op("maxps", 0, 0x5F, 16),
        sse_op("maxpd", 0x66, 0x5F, 16),
        sse_op("divps", 0, 0x5E, 16),
        sse_op("divpd", 0x66, 0x5E, 16),
        sse_op("divss", 0xF3, 0x5E, 4),
        sse_op("divsd", 0xF2, 0x5E, 8),
        sse_op("sqrtss", 0xF3, 0x51, 4),
        sse_op("sqrtsd", 0xF2, 0x51, 8),
        sse_op("ucomiss", 0, 0x2E, 4),
        sse_op("ucomisd", 0x66, 0x2E, 8),
        sse_op("xorps", 0, 0x57, 16),
        sse_op("cvtss2sd", 0xF3, 0x5A, 4),
        sse_op("cvtsd2ss", 0xF2, 0x5A, 8)
    ]
    for op in ops {
        isa_add(b, op.name, [new_form(op.opcode, [xmm(), xmmm(op.mem)]).pfx(op.prefix).in_space(space_0f).rr(r1, r2)])
    }
    isa_add(b, "roundsd", [new_form(0x0B, [xmm(), xmmm(8), imm(slot_imm8)]).pfx(0x66).in_space(space_0f3a).rr(r1, r2).with_imm(r3)])
    isa_add(b, "roundss", [new_form(0x0A, [xmm(), xmmm(4), imm(slot_imm8)]).pfx(0x66).in_space(space_0f3a).rr(r1, r2).with_imm(r3)])
    isa_add(b, "cmppd", [new_form(0xC2, [xmm(), xmmm(16), imm(slot_imm8)]).pfx(0x66).in_space(space_0f).rr(r1, r2).with_imm(r3)])
    isa_add(b, "cmpps", [new_form(0xC2, [xmm(), xmmm(16), imm(slot_imm8)]).in_space(space_0f).rr(r1, r2).with_imm(r3)])
    isa_add(b, "pshufd", [new_form(0x70, [xmm(), xmmm(16), imm(slot_imm8)]).pfx(0x66).in_space(space_0f).rr(r1, r2).with_imm(r3)])
}

fn add_sse_conversions(b: *IsaBuilder) {
    let convert = [
        convert_op("cvtsd2si", 0xF2, 0x2D, 8),
        convert_op("cvttsd2si", 0xF2, 0x2C, 8),
        convert_op("cvttss2si", 0xF3, 0x2C, 4)
    ]
    let narrow = size32 | size64
    for c in convert {
        isa_add(b, c.name, [new_form(c.opcode, [gp(0), xmmm(c.mem)]).pfx(c.prefix).in_space(space_0f).by_size().only(narrow).rr(r1, r2)])
    }
    isa_add(b, "cvtsi2sd", [new_form(0x2A, [xmm(), gpm(0)]).pfx(0xF2).in_space(space_0f).by_size().only(narrow).rr(r1, r2)])
    isa_add(b, "cvtsi2ss", [new_form(0x2A, [xmm(), gpm(0)]).pfx(0xF3).in_space(space_0f).by_size().only(narrow).rr(r1, r2)])
}

fn add_sse_packed(b: *IsaBuilder) {
    let packed = [
        packed_op("packsswb", 0x63),
        packed_op("paddb", 0xFC),
        packed_op("paddw", 0xFD),
        packed_op("paddd", 0xFE),
        packed_op("paddq", 0xD4),
        packed_op("pand", 0xDB),
        packed_op("pandn", 0xDF),
        packed_op("por", 0xEB),
        packed_op("pxor", 0xEF),
        packed_op("pcmpeqb", 0x74),
        packed_op("pcmpeqw", 0x75),
        packed_op("pcmpeqd", 0x76),
        packed_op("pcmpgtb", 0x64),
        packed_op("pcmpgtw", 0x65),
        packed_op("pcmpgtd", 0x66),
        packed_op("pmaxub", 0xDE),
        packed_op("pminub", 0xDA),
        packed_op("pmullw", 0xD5),
        packed_op("psllw", 0xF1),
        packed_op("pslld", 0xF2),
        packed_op("psllq", 0xF3),
        packed_op("psrlw", 0xD1),
        packed_op("psrld", 0xD2),
        packed_op("psrlq", 0xD3),
        packed_op("psrad", 0xE2),
        packed_op("psubb", 0xF8),
        packed_op("psubw", 0xF9),
        packed_op("psubd", 0xFA),
        packed_op("psubq", 0xFB),
        packed_op("punpcklbw", 0x60),
        packed_op("punpcklwd", 0x61),
        packed_op("punpcklqdq", 0x6C)
    ]
    for p in packed {
        isa_add(b, p.name, [new_form(p.opcode, [xmm(), xmmm(16)]).pfx(0x66).in_space(space_0f).rr(r1, r2)])
    }
}

fn add_vex(b: *IsaBuilder) {
    add_vex_moves(b)
    add_vex_three_operand(b)
    add_vex_misc(b)
}

fn add_vex_moves(b: *IsaBuilder) {
    let moves = [
        vex_move("vmovdqa", 0x66),
        vex_move("vmovdqu", 0xF3)
    ]
    for m in moves {
        isa_add(b, m.name, [
            new_form(0x6F, [vec(), vecm()]).vex_encoded().pfx(m.prefix).in_space(space_0f).rr(r1, r2).swap_to(0x7F),
            new_form(0x7F, [vecm(), vec()]).vex_encoded().pfx(m.prefix).in_space(space_0f).rr(r2, r1)
        ])
    }
}

fn add_vex_three_operand(b: *IsaBuilder) {
    let ops = [
        vex_op("vaddps", 0, space_0f, 0x58),
        vex_op("vaddpd", 0x66, space_0f, 0x58),
        vex_op("vmulps", 0, space_0f, 0x59),
        vex_op("vmulpd", 0x66, space_0f, 0x59),
        vex_op("vsubps", 0, space_0f, 0x5C),
        vex_op("vsubpd", 0x66, space_0f, 0x5C),
        vex_op("vminps", 0, space_0f, 0x5D),
        vex_op("vminpd", 0x66, space_0f, 0x5D),
        vex_op("vdivps", 0, space_0f, 0x5E),
        vex_op("vdivpd", 0x66, space_0f, 0x5E),
        vex_op("vmaxps", 0, space_0f, 0x5F),
        vex_op("vmaxpd", 0x66, space_0f, 0x5F),
        vex_op("vpacksswb", 0x66, space_0f, 0x63),
        vex_op("vpaddb", 0x66, space_0f, 0xFC),
        vex_op("vpaddw", 0x66, space_0f, 0xFD),
        vex_op("vpaddd", 0x66, space_0f, 0xFE),
        vex_op("vpaddq", 0x66, space_0f, 0xD4),
        vex_op("vpand", 0x66, space_0f, 0xDB),
        vex_op("vpandn", 0x66, space_0f, 0xDF),
        vex_op("vpor", 0x66, space_0f, 0xEB),
        vex_op("vpxor", 0x66, space_0f, 0xEF),
        vex_op("vpcmpeqb", 0x66, space_0f, 0x74),
        vex_op("vpcmpeqw", 0x66, space_0f, 0x75),
        vex_op("vpcmpeqd", 0x66, space_0f, 0x76),
        vex_op("vpcmpeqq", 0x66, space_0f38, 0x29),
        vex_op("vpcmpgtb", 0x66, space_0f, 0x64),
        vex_op("vpcmpgtw", 0x66, space_0f, 0x65),
        vex_op("vpcmpgtd", 0x66, space_0f, 0x66),
        vex_op("vpcmpgtq", 0x66, space_0f38, 0x37),
        vex_op("vpmaxsd", 0x66, space_0f38, 0x3D),
        vex_op("vpmaxub", 0x66, space_0f, 0xDE),
        vex_op("vpmaxuw", 0x66, space_0f38, 0x3E),
        vex_op("vpmaxud", 0x66, space_0f38, 0x3F),
        vex_op("vpminsd", 0x66, space_0f38, 0x39),
        vex_op("vpminub", 0x66, space_0f, 0xDA),
        vex_op("vpminud", 0x66, space_0f38, 0x3B),
        vex_op("vpminuw", 0x66, space_0f38, 0x3A),
        vex_op("vpmulld", 0x66, space_0f38, 0x40),
        vex_op("vpmullw", 0x66, space_0f, 0xD5),
        vex_op("vpshufb", 0x66, space_0f38, 0x00),
        vex_op("vpsubb", 0x66, space_0f, 0xF8),
        vex_op("vpsubw", 0x66, space_0f, 0xF9),
        vex_op("vpsubd", 0x66, space_0f, 0xFA),
        vex_op("vpsubq", 0x66, space_0f, 0xFB)
    ]
    for op in ops {
        isa_add(b, op.name, [new_form(op.opcode, [vec(), vec(), vecm()]).vex_encoded().pfx(op.prefix).in_space(op.space).rr(r1, r3).nds(r2)])
    }
    let shifts = [
        vex_op("vpsllw", 0x66, space_0f, 0xF1),
        vex_op("vpslld", 0x66, space_0f, 0xF2),
        vex_op("vpsllq", 0x66, space_0f, 0xF3),
        vex_op("vpsrlw", 0x66, space_0f, 0xD1),
        vex_op("vpsrld", 0x66, space_0f, 0xD2),
        vex_op("vpsrlq", 0x66, space_0f, 0xD3),
        vex_op("vpsrad", 0x66, space_0f, 0xE2)
    ]
    for op in shifts {
        isa_add(b, op.name, [new_form(op.opcode, [vec(), vec(), xmmm(16)]).vex_encoded().pfx(op.prefix).in_space(op.space).rr(r1, r3).nds(r2)])
    }
    isa_add(b, "vcmppd", [new_form(0xC2, [vec(), vec(), vecm(), imm(slot_imm8)]).vex_encoded().pfx(0x66).in_space(space_0f).rr(r1, r3).nds(r2).with_imm(r4)])
    isa_add(b, "vcmpps", [new_form(0xC2, [vec(), vec(), vecm(), imm(slot_imm8)]).vex_encoded().in_space(space_0f).rr(r1, r3).nds(r2).with_imm(r4)])
    isa_add(b, "vpblendvb", [new_form(0x4C, [vec(), vec(), vecm(), vec()]).vex_encoded().pfx(0x66).in_space(space_0f3a).rr(r1, r3).nds(r2).fourth(r4)])
}

fn add_vex_misc(b: *IsaBuilder) {
    isa_add(b, "vzeroupper", [new_form(0x77, []).vex_encoded().in_space(space_0f)])
    isa_add(b, "vextracti128", [new_form(0x39, [xmmm(16), ymm_reg(), imm(slot_imm8)]).vex_encoded().pfx(0x66).in_space(space_0f3a).vex_l256_only().rr(r2, r1).with_imm(r3)])
    isa_add(b, "vmovq", [new_form(0x6E, [xmm(), gp(8)]).vex_encoded().pfx(0x66).in_space(space_0f).vex_w1().rr(r1, r2)])
    isa_add(b, "vmovmskpd", [new_form(0x50, [gp(4), vec()]).vex_encoded().pfx(0x66).in_space(space_0f).rr(r1, r2)])
    isa_add(b, "vmovmskps", [new_form(0x50, [gp(4), vec()]).vex_encoded().in_space(space_0f).rr(r1, r2)])
    isa_add(b, "vpmovmskb", [new_form(0xD7, [gp(4), vec()]).vex_encoded().pfx(0x66).in_space(space_0f).rr(r1, r2)])
    isa_add(b, "vpbroadcastb", [new_form(0x78, [vec(), xmmm(1)]).vex_encoded().pfx(0x66).in_space(space_0f38).rr(r1, r2)])
    isa_add(b, "vpbroadcastw", [new_form(0x79, [vec(), xmmm(2)]).vex_encoded().pfx(0x66).in_space(space_0f38).rr(r1, r2)])
    isa_add(b, "vpbroadcastd", [new_form(0x58, [vec(), xmmm(4)]).vex_encoded().pfx(0x66).in_space(space_0f38).rr(r1, r2)])
    isa_add(b, "vpbroadcastq", [new_form(0x59, [vec(), xmmm(8)]).vex_encoded().pfx(0x66).in_space(space_0f38).rr(r1, r2)])
}

