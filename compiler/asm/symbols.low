import std/text

const sym_undefined = 0
const sym_label = 1
const sym_absolute = 2

struct Sym {
    name: str
    index: i64 = 0
    state: i64 = 0
    section: i64 = -1
    value: i64 = 0
    frag: i64 = 0
    global: bool = false
}

fn lookup(a: *Assembler, name: str) -> *Sym {
    match a.syms[name] {
        some(sym) => return sym
        none => {}
    }
    let sym = new(Sym { name, index: a.sym_order.len })
    a.syms[name] = sym
    push(mut a.sym_order, sym)
    sym
}

fn define_label(a: *Assembler, name: str) ! Error {
    let sym = lookup(a, name)
    if sym.state != sym_undefined {
        fail failure(a, "symbol {name} is already defined")
    }
    sym.state = sym_label
    sym.section = a.cur.index
    let at = mark(a.cur)
    sym.value = at.value
    sym.frag = at.frag
}

fn local_label_name(n: i64, count: i64) -> str {
    let separator = text.from_char(2)
    ".L{n}{separator}{count}"
}

fn define_numeric_label(a: *Assembler, n: i64) ! Error {
    a.numeric_labels[n] += 1
    let name = local_label_name(n, a.numeric_labels[n] ?? 0)
    define_label(a, name)?
}

fn define_constant(a: *Assembler, name: str, value: i64) ! Error {
    let sym = lookup(a, name)
    if sym.state == sym_label {
        fail failure(a, "symbol {name} is already defined as a label")
    }
    sym.state = sym_absolute
    sym.value = value
}
