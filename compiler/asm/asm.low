import std/builder

pub struct Options {
    pub align_branches: bool = false
    pub clang_layout: bool = false
    pub embeds: [str: []u8] = [:]
}

pub struct Object {
    pub sections: []Section = []
    pub symbols: []Symbol = []
}

pub const flag_alloc = 1
pub const flag_write = 2
pub const flag_exec = 4
pub const flag_tls = 8
pub const flag_read_only = 16

pub fn flags_has(f: i64, flag: i64) -> bool {
    f & flag != 0
}

pub fn flags_text(f: i64) -> str {
    var letters = builder.builder()
    if flags_has(f, flag_alloc) {
        letters.write_byte('a')
    }
    if flags_has(f, flag_write) {
        letters.write_byte('w')
    }
    if flags_has(f, flag_exec) {
        letters.write_byte('x')
    }
    if flags_has(f, flag_tls) {
        letters.write_byte('T')
    }
    if flags_has(f, flag_read_only) {
        letters.write_byte('r')
    }
    letters.to_str()
}

pub struct Section {
    pub name: str
    pub flags: i64 = 0
    pub align: i64 = 0
    pub data: []u8 = []
    pub nobits: bool = false
    pub size: i64 = 0
    pub fixups: []Fixup = []
}

pub const section_undefined = -1
pub const section_absolute = -2

pub struct Symbol {
    pub name: str
    pub section: i64 = 0
    pub value: i64 = 0
    pub global: bool = false
}

pub const abs64 = 1
pub const abs32 = 2
pub const abs32s = 3
pub const pc32 = 4
pub const plt32 = 5
pub const gotpcrel = 6
pub const gotpcrelx = 7
pub const rex_gotpcrelx = 8
pub const img_rel32 = 9

struct FixupProperties {
    name: str = ""
    width: i64 = 0
    signed: bool = false
    pc_relative: bool = false
    got: bool = false
    image_rel: bool = false
}

fn fixup_properties(k: i64) -> FixupProperties {
    match k {
        abs64 => FixupProperties { name: "Abs64", width: 8 }
        abs32 => FixupProperties { name: "Abs32", width: 4 }
        abs32s => FixupProperties { name: "Abs32S", width: 4, signed: true }
        pc32 => FixupProperties { name: "PC32", width: 4, signed: true, pc_relative: true }
        plt32 => FixupProperties { name: "PLT32", width: 4, signed: true, pc_relative: true }
        gotpcrel => FixupProperties { name: "GOTPCREL", width: 4, signed: true, pc_relative: true, got: true }
        gotpcrelx => FixupProperties { name: "GOTPCRELX", width: 4, signed: true, pc_relative: true, got: true }
        rex_gotpcrelx => FixupProperties { name: "REX_GOTPCRELX", width: 4, signed: true, pc_relative: true, got: true }
        img_rel32 => FixupProperties { name: "ImgRel32", width: 4, image_rel: true }
        _ => FixupProperties {}
    }
}

pub fn fixup_kind_text(k: i64) -> str {
    let name = fixup_properties(k).name
    if name != "" {
        return name
    }
    "FixupKind({k})"
}

pub fn fixup_width(k: i64) -> i64 {
    fixup_properties(k).width
}

pub fn fixup_signed(k: i64) -> bool {
    fixup_properties(k).signed
}

pub fn fixup_pc_relative(k: i64) -> bool {
    fixup_properties(k).pc_relative
}

pub fn fixup_got(k: i64) -> bool {
    fixup_properties(k).got
}

pub fn fixup_image_relative(k: i64) -> bool {
    fixup_properties(k).image_rel
}

pub fn fixup_fits(k: i64, value: i64) -> bool {
    if fixup_width(k) != 4 {
        return true
    }
    if fixup_signed(k) {
        return value >= -2147483648 && value <= 2147483647
    }
    value >= 0 && value <= 4294967295
}

pub struct Fixup {
    pub offset: i64 = 0
    pub kind: i64 = 0
    pub symbol: str = ""
    pub addend: i64 = 0
    pub line: i64 = 0
}

pub enum Error {
    At(line: i64, message: str)
}

pub fn message(e: Error) -> str {
    match e {
        At(line, message) => "asm: line {line}: {message}"
    }
}

pub fn assemble(source: str, opts: Options) -> Object ! Error {
    let a = new_assembler(opts)
    run(a, source)?
    object(a)
}

fn run(a: *Assembler, source: str) ! Error {
    run_frame(a, new(Frame { text: source, main: true }))?
    finish(a)?
}

fn failure(a: *Assembler, message: str) -> Error {
    At(a.line, message)
}

fn failure_wrap(a: *Assembler, message: str, cause: str) -> Error {
    At(a.line, "{message}: {cause}")
}

