import diag
import std/text

const max_macro_depth = 64

struct Assembler {
    opts: Options
    syms: [str: *Sym]
    sym_order: []*Sym
    sections: [str: *SecBuilder]
    sec_order: []*SecBuilder
    cur: *SecBuilder
    macros: [str: *Macro]
    macro_runs: i64 = 0
    macro_depth: i64 = 0
    conds: []*Cond = []
    numeric_labels: [i64: i64]
    pending: []PendingDifference = []
    frame: *Frame
    sc: *Scanner
    line: i64 = 0
    isa: [str: []Form]
    jumps: [str: i64]
    reg_by_name: [str: i64]
}

struct Cond {
    active: bool = false
    taken: bool = false
    parent_active: bool = false
}

struct Frame {
    text: str
    pos: i64 = 0
    main: bool = false
}

fn new_assembler(opts: Options) -> *Assembler {
    let a = new(Assembler {
        opts,
        syms: [:],
        sym_order: [],
        sections: [:],
        sec_order: [],
        cur: new(SecBuilder { sec: Section { name: "" }, index: 0 }),
        macros: [:],
        numeric_labels: [:],
        frame: new(Frame { text: "", main: true }),
        sc: new(Scanner { text: "" }),
        isa: build_isa(),
        jumps: build_conditional_jumps(),
        reg_by_name: build_reg_by_name()
    })
    default_section(a, ".text")
    default_section(a, ".data")
    default_section(a, ".bss")
    a.cur = a.sections[".text"] ?? a.cur
    a
}

fn frame_next(f: *Frame) -> str? {
    if f.pos >= f.text.len {
        return none
    }
    let rest = f.text[f.pos..]
    let end = text.index_byte(rest, '\n')
    var line = rest
    if end < 0 {
        f.pos = f.text.len
    } else {
        line = rest[..end]
        f.pos += end + 1
    }
    let n = line.len
    if n > 0 && line[n - 1] == '\r' {
        line = line[..n - 1]
    }
    line
}

fn run_frame(a: *Assembler, f: *Frame) ! Error {
    let saved = a.frame
    a.frame = f
    for {
        let line = frame_next(f) ?? break
        if f.main {
            a.line += 1
        }
        process_line(a, line)?
    }
    a.frame = saved
}

fn process_line(a: *Assembler, line: str) ! Error {
    a.sc = new(Scanner { text: line })
    if !active(a) {
        skip_line(a)?
        return
    }
    for statement(a)? {
    }
}

fn skip_line(a: *Assembler) ! Error {
    let s = a.sc
    skip_space(s)
    if peek(s) == '.' {
        let name = ident(s)
        conditional(a, name)?
    }
}

fn statement(a: *Assembler) -> bool ! Error {
    let s = a.sc
    if at_end(s) {
        return false
    }
    if is_digit(peek(s)) {
        return numeric_label(a)?
    }
    if !is_ident_start(peek(s)) {
        fail failure(a, "unexpected {diag.quote(rest(s))}")
    }
    let name = ident(s)
    if peek(s) == ':' {
        s.pos += 1
        define_label(a, name)?
        return true
    }
    if name[0] == '.' {
        directive(a, name)?
    } else {
        match a.macros[name] {
            some(m) => expand(a, m)?
            none => instruction(a, name)?
        }
    }
    false
}

fn numeric_label(a: *Assembler) -> bool ! Error {
    let s = a.sc
    let start = s.pos
    for is_digit(peek(s)) {
        s.pos += 1
    }
    let digits = s.text[start..s.pos]
    if peek(s) != ':' {
        fail failure(a, "unexpected {diag.quote(s.text[start..])}")
    }
    s.pos += 1
    var n = 0
    for i in 0..digits.len {
        n = n * 10 + i64(digits[i] - '0')
    }
    define_numeric_label(a, n)?
    true
}

fn active(a: *Assembler) -> bool {
    a.conds.len == 0 || a.conds[a.conds.len - 1].active
}

fn conditional(a: *Assembler, name: str) -> bool ! Error {
    match name {
        ".if" => {
            let parent = active(a)
            let c = new(Cond { parent_active: parent })
            if parent {
                let value = const_expr(a)?
                c.active = value != 0
                c.taken = c.active
            }
            push(mut a.conds, c)
        }
        ".else" => {
            let top = top_cond(a)?
            top.active = top.parent_active && !top.taken
            top.taken = top.taken || top.active
        }
        ".endif" => {
            top_cond(a)?
            truncate(mut a.conds, a.conds.len - 1)
        }
        _ => return false
    }
    true
}

fn top_cond(a: *Assembler) -> *Cond ! Error {
    if a.conds.len == 0 {
        fail failure(a, "conditional directive without .if")
    }
    a.conds[a.conds.len - 1]
}
