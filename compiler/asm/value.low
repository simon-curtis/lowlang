const reloc_none = 0
const reloc_gotpcrel = 1
const reloc_img_rel = 2
const reloc_plt = 3

struct Value {
    sym: str = ""
    neg: str = ""
    add: i64 = 0
    reloc: i64 = 0
}

fn is_const(v: Value) -> bool {
    v.sym == "" && v.neg == "" && v.reloc == reloc_none
}

fn negated(v: Value) -> Value {
    Value { sym: v.neg, neg: v.sym, add: -v.add, reloc: v.reloc }
}

fn value_plus(v: Value, o: Value) -> Value? {
    var sum = Value { add: v.add + o.add }
    if v.reloc != reloc_none && o.reloc != reloc_none {
        return none
    }
    sum.reloc = v.reloc | o.reloc
    var positives = [v.sym, o.sym]
    var negatives = [v.neg, o.neg]
    for i in 0..2 {
        let p = positives[i]
        if p == "" {
            continue
        }
        for j in 0..2 {
            if negatives[j] == p {
                positives[i] = ""
                negatives[j] = ""
                break
            }
        }
    }
    sum.sym = positives[0]
    sum.neg = negatives[0]
    if sum.sym == "" {
        sum.sym = positives[1]
    } else if positives[1] != "" {
        return none
    }
    if sum.neg == "" {
        sum.neg = negatives[1]
    } else if negatives[1] != "" {
        return none
    }
    sum
}
