enum FragKind {
    Fixed
    Jump
    Align
    Padding
    Fused
    Prefix
}

const jump_short = 0
const jump_near = 1
const jump_forced = 2

const short_jump_size = 1
const near_jump_size = 4
const near_cond_size = 5

const op_jmp_short = 0xEB
const op_jmp_near = 0xE9
const op_jcc_short = 0x70
const op_jcc_near = 0x80
const op_call_near = 0xE8
const op_two_byte = 0x0F
const jcc_near_bias = 0x10

enum LastKind {
    Other
    Directive
}

struct Frag {
    addr: i64 = 0
    last: i64 = 0
    off: i64 = 0
    sym: i64 = -1
    start: i64 = 0
    fix: i64 = 0
    size: i64 = 0
    max: i64 = 0
    line: i64 = 0
    pass: i64 = 0
    region: i64 = 0
    pad: i64 = 0
    kind: FragKind = Fixed
    form: i64 = 0
    cond: bool = false
    normal: bool = false
    power: i64 = 0
}

struct TextFixup {
    at: i64 = 0
    size: i64 = 0
    kind: i64 = 0
    sym: i64 = -1
    neg: i64 = -1
    addend: i64 = 0
    line: i64 = 0
}

fn open_frag(b: *SecBuilder) -> *Frag {
    b.frags[b.frags.len - 1]
}

fn start_frag(b: *SecBuilder) {
    push(mut b.frags, new(Frag { start: b.sec.data.len }))
}

fn add_jump(b: *SecBuilder, opcode: i64, cond: bool, sym: *Sym, off: i64, line: i64) {
    push(mut b.sec.data, u8(opcode))
    let f = open_frag(b)
    f.kind = Jump
    f.cond = cond
    f.sym = sym.index
    f.off = off
    f.size = short_jump_size
    f.line = line
    f.normal = b.last == Other
    start_frag(b)
}

fn add_align(b: *SecBuilder, power: i64, max: i64, line: i64) {
    let f = open_frag(b)
    f.kind = Align
    f.power = power
    f.max = max
    f.line = line
    f.normal = b.last == Other
    start_frag(b)
}

fn add_fixup(b: *SecBuilder, f: TextFixup) {
    push(mut b.fixups, f)
}

fn current_frag(b: *SecBuilder) -> i64 {
    b.frags.len - 1
}

fn measure_frags(b: *SecBuilder) {
    for k in 0..b.frags.len {
        var end = b.sec.data.len
        if k + 1 < b.frags.len {
            end = b.frags[k + 1].start
        }
        b.frags[k].fix = end - b.frags[k].start
    }
}

fn jump_size(f: *Frag) -> i64 {
    if f.cond {
        return near_cond_size
    }
    near_jump_size
}

fn align_padding(f: *Frag, address: i64) -> i64 {
    let mask = (1 << f.power) - 1
    let pad = (address + mask) & ~mask - address
    if f.max != 0 && pad > f.max {
        return 0
    }
    pad
}
