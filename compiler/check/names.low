import diag
import lexer

fn fixed_builtin(c: *Checker, name: str) -> *Builtin? {
    let b = c.builtins[name] ?? return none
    if b.shadowable || b.kind == TypeBuiltin {
        return none
    }
    b
}

pub fn declaration_name_error(c: *Checker, name: str) -> str? {
    if lexer.is_keyword(name) {
        return "{diag.quote(name)} is a keyword"
    }
    if fixed_builtin(c, name) != none {
        return "{diag.quote(name)} is a builtin"
    }
    if reserved_type(c, name) {
        return "{diag.quote(name)} is a builtin type"
    }
    none
}
