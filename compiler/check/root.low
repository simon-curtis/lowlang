import ast
import lexer
import types

struct Root {
    local: *ast.Local? = none
    offset: i64 = 0
}

struct Borrowed {
    root: Root
    bytes: i64
}

fn overlaps(a: Borrowed, b: Borrowed) -> bool {
    let la = a.root.local ?? return false
    let lb = b.root.local ?? return false
    la == lb && a.root.offset < b.root.offset + b.bytes && b.root.offset < a.root.offset + a.bytes
}

struct Rooted {
    root: Root
    ok: bool
}

fn typed(e: ast.Expr) -> *types.Type {
    ast.type_of(e) ?? panic("expression has no type after checking")
}

fn root_of(e: ast.Expr) -> Rooted {
    let nowhere = Rooted { root: Root {}, ok: false }
    match e {
        Receiver(n) => root_of(n.x)
        Ident(n) => {
            match n.local {
                some(l) => Rooted { root: Root { local: l }, ok: true }
                none => nowhere
            }
        }
        Selector(n) => {
            let field = n.field ?? return nowhere
            if typed(n.x).kind == PointerKind {
                return Rooted { root: Root {}, ok: true }
            }
            let base = root_of(n.x)
            if !base.ok {
                return nowhere
            }
            Rooted { root: Root { local: base.root.local, offset: base.root.offset + field.bytes }, ok: true }
        }
        Index(n) => {
            if typed(n.x).kind == SliceKind {
                return Rooted { root: Root {}, ok: true }
            }
            nowhere
        }
        Unary(n) => {
            if n.op == lexer.Kind.Star {
                return Rooted { root: Root {}, ok: true }
            }
            nowhere
        }
        _ => nowhere
    }
}
