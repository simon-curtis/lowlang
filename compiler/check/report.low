import ast
import diag
import types

pub struct Outcome {
    pub universe: *types.Universe
    pub warnings: []*diag.Diagnostic
}

fn report(c: *Checker, d: *diag.Diagnostic) {
    c.reported.push(d)
    if d.severity == diag.Severity.Error {
        c.errors += 1
    }
}

fn warn(c: *Checker, pos: diag.Pos, code: str, msg: str) {
    c.report(diag.warning(pos, code, msg))
}

fn reported() -> diag.Error {
    diag.Error.Reported([])
}

struct Mark {
    ctx: FuncContext
    subjects: i64
}

fn mark(c: *Checker) -> Mark {
    Mark { ctx: c.ctx, subjects: c.subjects.len }
}

fn recovered(c: *Checker, saved: Mark, e: diag.Error) ! diag.Error {
    c.ctx = saved.ctx
    c.subjects.truncate(saved.subjects)
    if c.stopped {
        fail e
    }
    for d in diag.diagnostics(e) {
        c.report(d)
    }
    if c.errors >= c.max_errors {
        c.stopped = true
        fail reported()
    }
}

fn checked_function(c: *Checker, f: *ast.Func) ! diag.Error {
    let saved = mark(c)
    let moving = c.moving.len
    let marking = c.marking.len
    function(c, f) catch {
        e => {
            c.moving.truncate(moving)
            c.marking.truncate(marking)
            c.failed[f] = true
            if f.ret_type == none {
                f.ret_type = c.universe.void
            }
            recovered(c, saved, e)?
        }
    }
}

fn template_failed(c: *Checker, f: *ast.Func) -> bool {
    let template = f.template ?? return false
    c.failed[template] != none
}

fn poison(c: *Checker, s: ast.Stmt) {
    match s {
        Let(n) => {
            match n.pattern {
                some(p) => poison_pattern(c, p)
                none => poison_name(c, n.name)
            }
        }
        _ => {}
    }
}

fn poison_pattern(c: *Checker, p: *ast.StructPattern) {
    for f in p.fields {
        match f.nested {
            some(nested) => poison_pattern(c, nested)
            none => {
                match f.bind {
                    some(b) => poison_name(c, b.name)
                    none => {}
                }
            }
        }
    }
}

fn poison_name(c: *Checker, name: str) {
    if name == "" || name == "_" {
        return
    }
    c.poisoned[declare(c, name, c.universe.void, false)] = true
}

fn finish(c: *Checker, fatal: diag.Error?) -> []*diag.Diagnostic ! diag.Error {
    match fatal {
        some(e) => {
            for d in diag.diagnostics(e) {
                c.report(d)
            }
        }
        none => {}
    }
    var errors: []*diag.Diagnostic = []
    var warnings: []*diag.Diagnostic = []
    var seen: [str: bool] = [:]
    for d in c.reported {
        let key = diag.line(d)
        if seen[key] != none {
            continue
        }
        seen[key] = true
        match d.severity {
            Error => errors.push(d)
            Warning => warnings.push(d)
        }
    }
    if errors.len > 0 || fatal != none {
        diag.sort(mut errors)
        if errors.len > c.max_errors {
            errors.truncate(c.max_errors)
        }
        fail Reported(errors)
    }
    diag.sort(mut warnings)
    warnings
}
