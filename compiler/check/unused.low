import ast
import diag

struct Bound {
    local: *ast.Local
    pos: diag.Pos
}

struct Overwritten {
    local: *ast.Local
    read: bool
}

fn module_path(c: *Checker, alias: str) -> str? {
    for imp in c.ctx.file.imports {
        if imp.alias == alias {
            c.used_imports[imp] = true
            return imp.path
        }
    }
    none
}

fn use_module(c: *Checker, path: str) {
    for imp in c.ctx.file.imports {
        if imp.path == path {
            c.used_imports[imp] = true
        }
    }
}

fn binding(c: *Checker, l: *ast.Local, pos: diag.Pos) {
    if l.name.len > 0 && l.name[0] != '_' {
        c.bindings.push(Bound { local: l, pos })
    }
}

fn rebound(c: *Checker, name: str, pos: diag.Pos) {
    if name != "_" && declared_here(c, name) {
        c.report_once(diag.error(pos, "rebound", "{name} is already bound in this scope; give the second binding its own name"))
    }
}

fn overwritten(c: *Checker, s: *ast.Assign) -> Overwritten? {
    let id = match s.target {
        Ident(id) => id
        _ => return none
    }
    let l = find(c, id.name) ?? return none
    Overwritten { local: l, read: l.read }
}

fn forget_read(c: *Checker, before: Overwritten?) {
    let o = before ?? return
    o.local.read = o.read
}

fn spawn_write(c: *Checker, l: *ast.Local, pos: diag.Pos) {
    var i = c.ctx.closures.len - 1
    for i >= 0 && c.ctx.closures[i].func != l.owner {
        if c.spawned[c.ctx.closures[i]] != none {
            c.report_once(diag.error(pos, "spawn-write", "a spawned closure cannot change {l.name}, which it captures; send the value over a channel"))
            return
        }
        i -= 1
    }
}

fn spawn_write_root(c: *Checker, e: ast.Expr, pos: diag.Pos) {
    let l = root_of(e).root.local ?? return
    c.spawn_write(l, pos)
}

fn unused(c: *Checker, files: []*ast.File) {
    let tainted = c.tainted_files()
    for b in c.bindings {
        if b.local.read || derived_owner(b.local) || in_tainted(tainted, b.local) {
            continue
        }
        let d = diag.error(b.pos, "unused-local", "{b.local.name} is never read; remove it or name it _")
        offer(d, discard_fix(b))
        c.report_once(d)
    }
    for f in files {
        if tainted[f] != none {
            continue
        }
        for imp in f.imports {
            if c.used_imports[imp] != none {
                continue
            }
            let d = diag.error(imp.pos, "unused-import", "{imp.path} is imported but never used")
            offer(d, import_fix(imp))
            c.report_once(d)
        }
    }
}

fn tainted_files(c: *Checker) -> [*ast.File: bool] {
    let files: [*ast.File: bool] = [:]
    for f, _ in c.failed {
        files[f.file ?? continue] = true
    }
    for l, _ in c.poisoned {
        files[owner_file(l) ?? continue] = true
    }
    files
}

fn in_tainted(tainted: [*ast.File: bool], l: *ast.Local) -> bool {
    let file = owner_file(l) ?? return false
    tainted[file] != none
}

fn owner_file(l: *ast.Local) -> *ast.File? {
    let owner = l.owner ?? return none
    let template = owner.template ?? return owner.file
    template.file
}

fn derived_owner(l: *ast.Local) -> bool {
    let owner = l.owner ?? return false
    owner.source().derived
}

fn report_once(c: *Checker, d: *diag.Diagnostic) {
    let key = "{d.code} {diag.text(d.pos)}"
    if c.reported_at[key] != none {
        return
    }
    c.reported_at[key] = true
    c.report(d)
}
