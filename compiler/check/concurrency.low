import ast
import builtin
import diag
import types

fn channel_operand(c: *Checker, e: ast.Expr) -> *types.Type ! diag.Error {
    let t = plain(c, e, none)?
    if t.kind != ChanKind {
        fail At(ast.position(e), "expected a channel, found {t.text()}")
    }
    t
}

fn make_chan(c: *Checker, e: *ast.Call, inst: *ast.Instance) ! diag.Error {
    if e.args.len == 1 {
        integer(c, e.args[0])?
    }
    e.builtin = builtin.ID.Chan
    let elem = contained(c, inst.types[0], "a channel")?
    e.type = c.universe.channel(elem)?
}

fn send(c: *Checker, s: *ast.Send) ! diag.Error {
    let t = channel_operand(c, s.chan)?
    expect_type(c, s.value, t.elem_of())?
}

fn spawn_stmt(c: *Checker, s: *ast.Spawn) ! diag.Error {
    c.spawns += 1
    let call = s.call
    let block_node = new(ast.Block { pos: s.pos })
    var lets: []*ast.Let = []
    let bind_arg = fn(x: ast.Expr, name: str) -> ast.Expr ! diag.Error {
        match x {
            Ref(r) => fail At(ast.position(x), "spawn cannot pass mut arguments")
            _ => {}
        }
        let l = new(ast.Let { name, value: x, pos: ast.position(x) })
        push(mut lets, l)
        push(mut block_node.stmts, ast.Stmt.Let(l))
        ast.Expr.Ident(new(ast.Ident { name, pos: ast.position(x) }))
    }
    if !named_func(c, call.callee) {
        call.callee = bind_arg(call.callee, "__spawn{c.spawns}_fn")?
    }
    for i, arg in call.args {
        call.args[i] = bind_arg(arg, "__spawn{c.spawns}_{i}")?
    }
    let closure_node = new(ast.Closure { body: new(ast.Block { tail: ast.Expr.Call(call), pos: s.pos }), pos: s.pos })
    let entry = new(ast.Ident { name: "__spawn", pos: s.pos })
    let start = new(ast.ExprStmt { x: ast.Expr.Call(new(ast.Call { callee: ast.Expr.Ident(entry), args: [ast.Expr.Closure(closure_node)], pos: s.pos })) })
    push(mut block_node.stmts, ast.Stmt.ExprStmt(start))
    s.body = block_node
    push_scope(c)
    for l in lets {
        let t = bind(c, l)?
        if droppable(c, t) {
            fail At(l.pos, "spawn cannot take {t.text()}; it has drop")
        }
    }
    stmt(c, ast.Stmt.ExprStmt(start))?
    block_node.type = c.universe.void
    pop_scope(c)
}

fn named_func(c: *Checker, x: ast.Expr) -> bool {
    match x {
        Ident(n) => find(c, n.name) == none
        Selector(n) => {
            match n.x {
                Ident(id) => is_module(c, id.name)
                _ => false
            }
        }
        Instance(n) => named_func(c, n.x)
        _ => false
    }
}

fn case_chan(sc: *ast.SelectCase) -> ast.Expr {
    sc.chan ?? panic("select case has no channel")
}

fn case_value(sc: *ast.SelectCase) -> ast.Expr {
    sc.value ?? panic("select case has no value")
}

fn select_expr(c: *Checker, e: *ast.Select, want: *types.Type?) ! diag.Error {
    var result = c.universe.never
    var elses = 0
    for sc in e.cases {
        push_scope(c)
        match sc.kind {
            RecvCase => {
                let t = channel_operand(c, case_chan(sc))?
                if sc.name != "" {
                    let received = c.universe.optional(t.elem_of())?
                    sc.local = declare(c, sc.name, received, false)
                }
            }
            SendCase => {
                let t = channel_operand(c, case_chan(sc))?
                expect_type(c, case_value(sc), t.elem_of())?
            }
            AfterCase => integer(c, case_value(sc))?
            ElseCase => {
                elses += 1
                if elses > 1 {
                    fail At(sc.pos, "select has more than one else")
                }
            }
        }
        let body_type = expr(c, sc.body, want)?
        result = unify(c, result, body_type)
        pop_scope(c)
    }
    e.type = result
}
