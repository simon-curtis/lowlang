import ast
import diag
import types

struct FuncContext {
    func: *ast.Func? = none
    file: *ast.File
    bound: [str: *types.Type] = [:]
    scopes: [][str: *ast.Local] = []
    loops: []*Loop = []
    closures: []*ast.Closure = []
    abstract: bool = false
    deferring: bool = false
    dropping: bool = false
}

fn enter(c: *Checker, next: FuncContext, run: fn() ! diag.Error) ! diag.Error {
    let saved = c.ctx
    c.ctx = next
    run()?
    c.ctx = saved
}

fn within(c: *Checker, file: *ast.File, bound: [str: *types.Type], run: fn() ! diag.Error) ! diag.Error {
    var next = c.ctx
    next.file = file
    next.bound = bound
    enter(c, next, run)?
}

struct DeclSource {
    file: *ast.File
    bound: [str: *types.Type]
    clone: bool
    abstract: bool
}

fn source_of(c: *Checker, st: *types.Type, generic: bool) -> DeclSource {
    DeclSource { file: c.ctx.file, bound: c.ctx.bound, clone: generic, abstract: types.abstract(st) }
}

fn context(s: DeclSource) -> FuncContext {
    FuncContext { file: s.file, bound: s.bound, abstract: s.abstract }
}
