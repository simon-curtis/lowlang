import ast
import diag
import lexer
import types
import std/text

fn is_vector(t: *types.Type) -> bool {
    t.kind == VectorKind
}

fn arithmetic(want: *types.Type?) -> *types.Type? {
    let w = unwrap(want) ?? return none
    if w.is_number() || is_vector(w) {
        return w
    }
    none
}

fn vector_operator(c: *Checker, op: lexer.Kind, t: *types.Type, pos: diag.Pos) ! diag.Error {
    let lane = t.elem_of()
    match op {
        Percent => fail At(pos, "operator % is not defined on {t.text()}")
        Slash => {
            if !lane.is_float() {
                fail At(pos, "operator / on vectors requires float lanes, found {t.text()}")
            }
        }
        Shl => vector_shift(c, op, t, pos)?
        Shr => vector_shift(c, op, t, pos)?
        _ => {}
    }
}

fn vector_shift(c: *Checker, op: lexer.Kind, t: *types.Type, pos: diag.Pos) ! diag.Error {
    if !t.elem_of().is_integer() {
        fail At(pos, "operator {lexer.kind_text(op)} on vectors requires integer lanes, found {t.text()}")
    }
}

fn vector_unary(c: *Checker, e: *ast.Unary, t: *types.Type) ! diag.Error {
    if e.op != lexer.Kind.Minus && e.op != lexer.Kind.Tilde {
        fail At(e.pos, "operator {lexer.kind_text(e.op)} is not defined on {t.text()}")
    }
    if e.op == lexer.Kind.Tilde && t.elem_of().is_float() {
        fail At(e.pos, "operator ~ on vectors requires integer lanes, found {t.text()}")
    }
    e.type = t
}

fn vector_cast(c: *Checker, e: *ast.Call, to: *types.Type) ! diag.Error {
    let from = plain(c, e.args[0], none)?
    if !is_vector(from) || from.bits != to.bits {
        fail At(ast.position(e.args[0]), "cannot convert {from.text()} to {to.text()}; vector casts keep the width")
    }
    e.type = to
}

fn vector_argument(c: *Checker, e: ast.Expr, want: *types.Type?) -> *types.Type ! diag.Error {
    let t = plain(c, e, want)?
    if !is_vector(t) && t.kind != ParamKind {
        fail At(ast.position(e), "expected a vector, found {t.text()}")
    }
    match want {
        some(w) => {
            if t != w && w.kind != ParamKind {
                fail At(ast.position(e), "expected {w.text()}, found {t.text()}")
            }
        }
        none => {}
    }
    t
}

fn vector_result(c: *Checker, b: *Builtin, e: *ast.Call, want: *types.Type?) -> *types.Type ! diag.Error {
    let w = want ?? fail At(e.pos, "{b.name} needs an expected vector type")
    if !is_vector(w) && w.kind != ParamKind {
        fail At(e.pos, "{b.name} needs an expected vector type")
    }
    w
}

fn vector_load(c: *Checker, b: *Builtin, e: *ast.Call, want: *types.Type?) ! diag.Error {
    vector_source(c, e.args[0])?
    integer(c, e.args[1])?
    e.type = vector_result(c, b, e, want)?
}

fn vector_store(c: *Checker, e: *ast.Call) ! diag.Error {
    vector_source(c, e.args[0])?
    integer(c, e.args[1])?
    vector_argument(c, e.args[2], none)?
    e.type = c.universe.void
}

fn vector_splat(c: *Checker, b: *Builtin, e: *ast.Call, want: *types.Type?) ! diag.Error {
    let v = vector_result(c, b, e, want)?
    plain(c, e.args[0], lane_of(v))?
    e.type = v
}

fn vector_mask(c: *Checker, e: *ast.Call) ! diag.Error {
    vector_argument(c, e.args[0], none)?
    e.type = c.universe.u64
}

fn vector_pair(c: *Checker, e: *ast.Call) ! diag.Error {
    let t = vector_argument(c, e.args[0], none)?
    vector_argument(c, e.args[1], t)?
    e.type = t
}

fn vector_shuffle(c: *Checker, e: *ast.Call) ! diag.Error {
    vector_pair(c, e)?
    let t = e.type ?? panic("vector shuffle has no type")
    if is_vector(t) && t.elem_of() != c.universe.u8 {
        fail At(e.pos, "shuffle needs u8 lanes, found {t.text()}")
    }
}

fn vector_select(c: *Checker, e: *ast.Call) ! diag.Error {
    let t = vector_argument(c, e.args[0], none)?
    vector_argument(c, e.args[1], t)?
    vector_argument(c, e.args[2], t)?
    e.type = t
}

fn vector_lane(c: *Checker, e: *ast.Call, want: *types.Type?) ! diag.Error {
    let t = vector_argument(c, e.args[0], none)?
    integer(c, e.args[1])?
    if is_vector(t) {
        e.type = t.elem_of()
    } else if want != none {
        e.type = want
    } else {
        e.type = t
    }
}

fn vector_with(c: *Checker, e: *ast.Call) ! diag.Error {
    let t = vector_argument(c, e.args[0], none)?
    integer(c, e.args[1])?
    plain(c, e.args[2], lane_of(t))?
    e.type = t
}

fn lane_of(t: *types.Type) -> *types.Type? {
    if is_vector(t) {
        return t.elem
    }
    none
}

fn vector_splat_operand(c: *Checker, s: *ast.Assign, t: *types.Type) ! diag.Error {
    var want = t
    if literal(s.value) {
        want = t.elem_of()
    }
    let value = plain(c, s.value, want)?
    if value == t {
        return
    }
    if t.elem_of().accepts(value) {
        s.splat = true
        return
    }
    fail At(ast.position(s.value), "cannot apply {lexer.kind_text(s.op)} with {value.text()} to {t.text()}")
}

fn forwarded(c: *Checker, e: *ast.Call, f: *ast.Func) {
    let file = f.file ?? return
    let body = f.body ?? return
    if file.module != "std/simd" || body.stmts.len != 0 {
        return
    }
    let tail = body.tail ?? return
    let inner = match tail {
        Call(n) => n
        _ => return
    }
    let id = match inner.callee {
        Ident(n) => n
        _ => return
    }
    if !text.starts_with(id.name, "__") || inner.args.len != f.params.len {
        return
    }
    for i, arg in inner.args {
        match arg {
            Ident(name) => {
                if name.name != f.params[i].name {
                    return
                }
            }
            _ => return
        }
    }
    match lookup_builtin(c, id.name) {
        some(b) => { e.builtin = b.id }
        none => {}
    }
}

fn vector_source(c: *Checker, e: ast.Expr) ! diag.Error {
    let t = plain(c, e, none)?
    if t != c.universe.str && t.kind != SliceKind {
        fail At(ast.position(e), "vectors load from and store to slices or str, found {t.text()}")
    }
}
