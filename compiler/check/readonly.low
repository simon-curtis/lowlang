import ast
import builtin

struct ReadScan {
    skip_index: [*ast.Index: bool] = [:]
    skip_selector: [*ast.Selector: bool] = [:]
    reads: [*ast.Ident: bool] = [:]
    idents: []*ast.Ident = []
    lets: []*ast.Let = []
}

fn mark_read_only(c: *Checker, f: *ast.Func) {
    let scan = new(ReadScan {})
    let body = f.body ?? panic("function {f.name} has no body")
    ast.inspect(ast.Node.Expr(ast.Expr.Block(body)), fn(n: ast.Node) -> bool { visit(scan, n) })
    let uses: [*ast.Local: i64] = [:]
    let reads: [*ast.Local: i64] = [:]
    for id in scan.idents {
        let l = id.local ?? continue
        uses[l] = (uses[l] ?? 0) + 1
        if scan.reads[id] != none {
            reads[l] = (reads[l] ?? 0) + 1
        }
    }
    for l in scan.lets {
        let local = l.local ?? continue
        if (uses[local] ?? 0) == (reads[local] ?? 0) {
            mark_literal(l.value)
        }
    }
}

fn visit(s: *ReadScan, n: ast.Node) -> bool {
    match n {
        Expr(e) => visit_expr(s, e)
        Stmt(st) => visit_stmt(s, st)
        _ => {}
    }
    true
}

fn visit_expr(s: *ReadScan, e: ast.Expr) {
    match e {
        Ident(i) => push(mut s.idents, i)
        Ref(r) => mark_write(s, r.x)
        Index(i) => {
            if s.skip_index[i] == none {
                mark_read(s, i.x)
            }
        }
        Selector(sel) => {
            if sel.property != builtin.ID.None && s.skip_selector[sel] == none {
                mark_read(s, sel.x)
            }
        }
        _ => {}
    }
}

fn visit_stmt(s: *ReadScan, st: ast.Stmt) {
    match st {
        Let(l) => {
            if l.local != none && is_literal(l.value) {
                push(mut s.lets, l)
            }
        }
        Assign(a) => mark_write(s, a.target)
        ForIn(f) => mark_read(s, f.iter)
        _ => {}
    }
}

fn mark_write(s: *ReadScan, e: ast.Expr) {
    var current = e
    for {
        match current {
            Selector(x) => {
                s.skip_selector[x] = true
                current = x.x
            }
            Index(x) => {
                s.skip_index[x] = true
                current = x.x
            }
            Receiver(x) => { current = x.x }
            _ => return
        }
    }
}

fn mark_read(s: *ReadScan, x: ast.Expr) {
    match x {
        Ident(i) => { s.reads[i] = true }
        SliceLit(l) => { l.read_only = true }
        MapLit(m) => { m.read_only = true }
        _ => {}
    }
}

fn is_literal(e: ast.Expr) -> bool {
    match e {
        SliceLit(l) => true
        MapLit(m) => true
        _ => false
    }
}

fn mark_literal(e: ast.Expr) {
    match e {
        SliceLit(l) => { l.read_only = true }
        MapLit(m) => { m.read_only = true }
        _ => {}
    }
}
