import ast
import diag
import types

struct FieldSource {
    source: DeclSource
    decl: *ast.FieldDecl
    owner: str
}

fn record_default(c: *Checker, d: *ast.StructDecl, st: *types.Type, fd: *ast.FieldDecl, f: *types.Field) {
    if fd.default == none {
        return
    }
    c.field_sources[f] = new(FieldSource { source: source_of(c, st, d.type_params.len > 0), decl: fd, owner: st.name })
}

fn default_of(c: *Checker, f: *types.Field) -> ast.Expr? ! diag.Error {
    match c.defaults[f] {
        some(e) => return e
        none => {}
    }
    let src = c.field_sources[f] ?? return none
    let written = src.decl.default ?? panic("field {f.name} has a default source without a default")
    if c.checking_default[f] != none {
        fail At(ast.position(written), "the default of {src.owner}.{f.name} refers to itself")
    }
    c.checking_default[f] = true
    var e = written
    if src.source.clone {
        e = ast.clone_expr(e)
    }
    var next = context(src.source)
    next.func = new(ast.Func { name: "{src.owner}..{src.decl.name}", file: src.source.file, pos: diag.Pos {}, ret_type: c.universe.void })
    enter(c, next, fn() ! diag.Error {
        push_scope(c)
        expect_type(c, e, f.type)?
    })?
    c.defaults[f] = e
    e
}

fn check_defaults(c: *Checker, files: []*ast.File) ! diag.Error {
    for file in files {
        c.ctx.file = file
        for d in file.structs {
            for f in decl_type(d.type).fields {
                default_of(c, f)?
            }
        }
    }
}
