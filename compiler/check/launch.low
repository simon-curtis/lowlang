import ast
import diag
import types

fn launch_ident(name: str, pos: diag.Pos) -> ast.Expr {
    ast.Expr.Ident(new(ast.Ident { name, pos }))
}

fn launch_kernel(c: *Checker, e: ast.Expr) -> *ast.Func ! diag.Error {
    let _ = plain(c, e, none)?
    let named: *ast.Func? = match e {
        Ident(x) => x.ident_func()
        Selector(x) => x.selector_func()
        _ => none
    }
    let k = named ?? fail At(ast.position(e), "launch-kernel", "launch takes a kernel fn as its first argument")
    if !k.kernel {
        fail At(ast.position(e), "launch-kernel", "launch takes a kernel fn, and {k.name} is not one")
    }
    k
}

fn launch_let(c: *Checker, made: *ast.Launch, name: str, value: ast.Expr, t: *types.Type) {
    let pos = ast.position(value)
    let l = new(ast.Let { name, value, pos })
    l.local = declare(c, name, t, false)
    made.lets.push(ast.Stmt.Let(l))
}

fn launch_call(c: *Checker, e: *ast.Call) ! diag.Error {
    let k = launch_kernel(c, e.args[0])?
    let given = e.args.len - 2
    if given != k.params.len - 1 {
        fail At(e.pos, "arity", "kernel {k.name} takes {plural(k.params.len - 1, "argument")} after its index, found {given}")
    }
    c.launches += 1
    let frame = "__launch{c.launches}"
    let pos = e.pos
    let index = "{frame}_index"
    let convert = new(ast.Call { callee: launch_ident("u32", pos), args: [launch_ident(index, pos)], pos })
    var passed: []ast.Expr = [ast.Expr.Call(convert)]
    let made = new(ast.Launch { kernel: k, made: launch_ident(frame, pos) })
    expect_type(c, e.args[1], c.universe.u32)?
    launch_let(c, made, "{frame}_count", e.args[1], c.universe.u32)
    let body = new(ast.Block { pos })
    for i in 1..k.params.len {
        let arg = e.args[i + 1]
        argument(c, arg, k, i)?
        let name = "{frame}_{i}"
        let held = match arg {
            Ref(r) => r.x
            _ => arg
        }
        launch_let(c, made, name, held, k.param_types[i])
        let operand = launch_ident(name, pos)
        let _ = plain(c, operand, none)?
        made.operands.push(operand)
        if !k.params[i].mutable {
            passed.push(launch_ident(name, pos))
            continue
        }
        let written = "{name}_written"
        body.stmts.push(ast.Stmt.Let(new(ast.Let { name: written, mutable: true, value: launch_ident(name, pos), pos })))
        passed.push(ast.Expr.Ref(new(ast.Ref { x: launch_ident(written, pos), pos })))
    }
    exclusive(c, e.args[2..])?
    body.tail = ast.Expr.Call(new(ast.Call { callee: ast.clone_expr(e.args[0]), args: passed, pos }))
    let taken = new(ast.Param { name: index, type_name: new(ast.TypeName { name: "i64", pos }), pos })
    let run = ast.Expr.Closure(new(ast.Closure { params: [taken], body, pos }))
    let start = new(ast.Call { callee: launch_ident("__launch", pos), args: [launch_ident("{frame}_count", pos), run], pos })
    made.made = ast.Expr.Call(start)
    e.type = plain(c, made.made, none)?
    e.call_extra().launch = made
    k.launched = true
}
