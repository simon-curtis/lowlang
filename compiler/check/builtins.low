import ast
import builtin
import diag
import types
import std/text

pub enum BuiltinKind {
    FunctionBuiltin
    TypeBuiltin
    ConstantBuiltin
    PropertyBuiltin
}

const mut_marker = "mut "

fn no_handler(c: *Checker, b: *Builtin, e: *ast.Call, want: *types.Type?) ! diag.Error {
    panic("builtin {b.name} has no handler")
}

fn no_construct(c: *Checker, e: *ast.Call, inst: *ast.Instance) ! diag.Error {
    panic("builtin has no constructor")
}

fn no_resolve(c: *Checker, t: *ast.TypeName) -> *types.Type ! diag.Error {
    panic("builtin {t.name} has no type resolver")
}

fn no_constant(c: *Checker, e: *ast.Ident, want: *types.Type?) ! diag.Error {
    panic("builtin {e.name} is not a constant")
}

pub struct Builtin {
    pub id: builtin.ID = builtin.ID.None
    pub name: str
    pub kind: BuiltinKind = FunctionBuiltin
    pub shadowable: bool = false
    pub receivers: []types.Kind = []
    pub params: []str = []
    pub optional: i64 = 0
    pub type_args: i64 = 0
    pub type: *types.Type? = none
    has_handler: bool = false
    handler: fn(*Checker, *Builtin, *ast.Call, *types.Type?) ! diag.Error = no_handler
    has_construct: bool = false
    construct: fn(*Checker, *ast.Call, *ast.Instance) ! diag.Error = no_construct
    has_resolve: bool = false
    resolve: fn(*Checker, *ast.TypeName) -> *types.Type ! diag.Error = no_resolve
    has_constant: bool = false
    constant: fn(*Checker, *ast.Ident, *types.Type?) ! diag.Error = no_constant
}

pub fn is_public(b: *Builtin) -> bool {
    !text.starts_with(b.name, "__")
}

pub fn is_mut(b: *Builtin, i: i64) -> bool {
    i < b.params.len && text.starts_with(b.params[i], mut_marker)
}

pub fn param_name(b: *Builtin, i: i64) -> str {
    if i >= b.params.len {
        return "value"
    }
    text.trim_prefix(b.params[i], mut_marker)
}

pub fn receives(b: *Builtin, kind: types.Kind) -> bool {
    for k in b.receivers {
        if k == kind {
            return true
        }
    }
    false
}

pub fn reads(b: *Builtin, t: *types.Type) -> bool {
    b.kind == PropertyBuiltin && receives(b, t.kind) && (b.id != builtin.ID.Index || t.indexed)
}

fn builtin_index(u: *types.Universe) -> [str: *Builtin] {
    let index: [str: *Builtin] = [:]
    for b in builtins(u) {
        index[b.name] = b
    }
    index
}

pub fn lookup_builtin(c: *Checker, name: str) -> *Builtin? {
    c.builtins[name]
}

fn reserved_type(c: *Checker, name: str) -> bool {
    let b = c.builtins[name] ?? return false
    b.kind == TypeBuiltin
}

fn bare(h: fn(*Checker, *ast.Call) ! diag.Error) -> fn(*Checker, *Builtin, *ast.Call, *types.Type?) ! diag.Error {
    fn(c: *Checker, b: *Builtin, e: *ast.Call, want: *types.Type?) ! diag.Error { h(c, e)? }
}

fn wanted(h: fn(*Checker, *ast.Call, *types.Type?) ! diag.Error) -> fn(*Checker, *Builtin, *ast.Call, *types.Type?) ! diag.Error {
    fn(c: *Checker, b: *Builtin, e: *ast.Call, want: *types.Type?) ! diag.Error { h(c, e, want)? }
}

fn named_handler(h: fn(*Checker, *Builtin, *ast.Call) ! diag.Error) -> fn(*Checker, *Builtin, *ast.Call, *types.Type?) ! diag.Error {
    fn(c: *Checker, b: *Builtin, e: *ast.Call, want: *types.Type?) ! diag.Error { h(c, b, e)? }
}

fn function_builtin(id: builtin.ID, name: str, params: []str, handler: fn(*Checker, *Builtin, *ast.Call, *types.Type?) ! diag.Error) -> *Builtin {
    new(Builtin { id, name, params, handler, has_handler: true })
}

fn method_builtin(b: *Builtin, shadowable: bool, receivers: []types.Kind) -> *Builtin {
    b.shadowable = shadowable
    b.receivers = receivers
    b
}

fn optional_params(b: *Builtin, optional: i64) -> *Builtin {
    b.optional = optional
    b
}

fn shadowable_builtin(b: *Builtin) -> *Builtin {
    b.shadowable = true
    b
}

pub fn builtins(u: *types.Universe) -> []*Builtin {
    var list: []*Builtin = [
        function_builtin(builtin.ID.Print, "print", ["value"], bare(print_call)),
        function_builtin(builtin.ID.New, "new", ["value"], wanted(allocate)),
        function_builtin(builtin.ID.Panic, "panic", ["message"], bare(panic_call)),
        method_builtin(function_builtin(builtin.ID.Push, "push", ["mut xs", "value"], named_handler(push_call)), false, [types.Kind.SliceKind]),
        method_builtin(function_builtin(builtin.ID.Pop, "pop", ["mut xs"], named_handler(pop_call)), true, [types.Kind.SliceKind]),
        method_builtin(function_builtin(builtin.ID.Truncate, "truncate", ["mut xs", "n"], named_handler(truncate_call)), true, [types.Kind.SliceKind]),
        method_builtin(function_builtin(builtin.ID.Delete, "delete", ["mut m", "key"], bare(delete_entry)), false, [types.Kind.MapKind]),
        function_builtin(builtin.ID.Bytes, "bytes", ["s"], bare(bytes_call)),
        function_builtin(builtin.ID.Cstr, "cstr", ["s"], bare(cstr_call)),
        function_builtin(builtin.ID.View, "view", ["p", "n"], named_handler(view_call)),
        function_builtin(builtin.ID.Load, "load", ["p"], named_handler(load_call)),
        function_builtin(builtin.ID.Store, "store", ["p", "value"], named_handler(store_call)),
        function_builtin(builtin.ID.Pin, "pin", ["value"], bare(pin_call)),
        function_builtin(builtin.ID.Unpin, "unpin", ["p"], bare(unpin_call)),
        function_builtin(builtin.ID.Embed, "embed", ["path"], bare(embed_call)),
        function_builtin(builtin.ID.EmbedDir, "embed_dir", ["path"], bare(embed_dir_call)),
        function_builtin(builtin.ID.Sqrt, "sqrt", ["x"], math),
        function_builtin(builtin.ID.Floor, "floor", ["x"], math),
        function_builtin(builtin.ID.Exp, "exp", ["x"], math),
        method_builtin(function_builtin(builtin.ID.Close, "close", ["c"], bare(close_call)), true, [types.Kind.ChanKind]),
        shadowable_builtin(function_builtin(builtin.ID.Sleep, "sleep", ["ms"], bare(wait_call))),
        shadowable_builtin(function_builtin(builtin.ID.WaitReadable, "wait_readable", ["fd"], bare(wait_call))),
        shadowable_builtin(function_builtin(builtin.ID.WaitWritable, "wait_writable", ["fd"], bare(wait_call))),
    ]
    for b in private_builtins() {
        push(mut list, b)
    }
    for b in type_builtins(u) {
        push(mut list, b)
    }
    for b in derived_builtins() {
        push(mut list, b)
    }
    push(mut list, new(Builtin { id: builtin.ID.Len, name: "len", kind: PropertyBuiltin, shadowable: true, receivers: [types.Kind.SliceKind, types.Kind.MapKind, types.Kind.StrKind], type: u.i64 }))
    push(mut list, new(Builtin { id: builtin.ID.Index, name: "index", kind: PropertyBuiltin, shadowable: true, receivers: [types.Kind.EnumKind], type: u.i64 }))
    push(mut list, new(Builtin { name: "true", kind: ConstantBuiltin, shadowable: true, type: u.bool }))
    push(mut list, new(Builtin { name: "false", kind: ConstantBuiltin, shadowable: true, type: u.bool }))
    push(mut list, new(Builtin { name: "none", kind: ConstantBuiltin, shadowable: true, has_constant: true, constant: none_constant }))
    push(mut list, new(Builtin { name: "null", kind: ConstantBuiltin, shadowable: true, has_constant: true, constant: null_constant }))
    list
}

fn private_builtins() -> []*Builtin {
    [
        function_builtin(builtin.ID.StrRaw, "__str_raw", ["address", "len"], bare(str_raw_call)),
        function_builtin(builtin.ID.SlicePtr, "__slice_ptr", ["xs"], bare(slice_ptr_call)),
        function_builtin(builtin.ID.Bits, "__bits", ["x"], bare(bits_call)),
        function_builtin(builtin.ID.StrView, "__str_view", ["b"], bare(str_view_call)),
        function_builtin(builtin.ID.Extend, "__extend", ["mut b", "s"], bare(extend_call)),
        function_builtin(builtin.ID.ExtendBy, "__extend_by", ["mut b", "n"], bare(extend_by_call)),
        function_builtin(builtin.ID.Hash, "__hash", ["value"], bare(hash_call)),
        function_builtin(builtin.ID.Zero, "__zero", [], wanted(zero_call)),
        optional_params(function_builtin(builtin.ID.Syscall, "__syscall", ["number", "a", "b", "c", "d", "e", "f"], bare(syscall)), 6),
        function_builtin(builtin.ID.MulHi, "__mulhi", ["a", "b"], bare(mulhi_call)),
        function_builtin(builtin.ID.Make, "__make", ["n"], wanted(make_call)),
        function_builtin(builtin.ID.Memmove, "__memmove", ["dst", "src"], bare(memmove_call)),
        function_builtin(builtin.ID.Ctz, "__ctz", ["x"], bare(ctz_call)),
        function_builtin(builtin.ID.ClockNanos, "__clock_nanos", ["clock"], bare(clock_nanos_call)),
        function_builtin(builtin.ID.HashSeed, "__hash_seed", ["which"], bare(hash_seed_call)),
        function_builtin(builtin.ID.Argc, "__argc", [], bare(argc_call)),
        function_builtin(builtin.ID.Argv, "__argv", ["i"], bare(argv_call)),
        function_builtin(builtin.ID.Envv, "__envv", ["i"], bare(argv_call)),
        function_builtin(builtin.ID.Render, "__render", ["value"], bare(render_call)),
        function_builtin(builtin.ID.RenderInto, "__render_into", ["mut b", "mut path", "value"], bare(render_into_call)),
        function_builtin(builtin.ID.Address, "__address", ["p"], bare(address_call)),
        function_builtin(builtin.ID.Serialize, "__serialize", ["value", "w"], bare(serialize_call)),
        function_builtin(builtin.ID.SerializeInto, "__serialize_into", ["w", "mut path", "value"], bare(serialize_into_call)),
        function_builtin(builtin.ID.Spawn, "__spawn", ["f"], bare(spawn_call)),
        function_builtin(builtin.ID.Current, "__current", [], bare(current_call)),
        function_builtin(builtin.ID.Park, "__park", [], bare(park_call)),
        function_builtin(builtin.ID.Ready, "__ready", ["t"], bare(ready_call)),
        function_builtin(builtin.ID.Lock, "__lock", ["mut word"], bare(lock_call)),
        function_builtin(builtin.ID.Unlock, "__unlock", ["mut word"], bare(lock_call)),
        function_builtin(builtin.ID.Cas, "__cas", ["mut word", "old", "new"], bare(cas_call)),
        function_builtin(builtin.ID.Context, "__context", [], wanted(context_call)),
        function_builtin(builtin.ID.SetContext, "__set_context", ["p"], bare(set_context_call)),
        function_builtin(builtin.ID.HasContext, "__has_context", [], bare(has_context_call)),
        function_builtin(builtin.ID.LockThread, "__lock_thread", [], bare(lock_thread_call)),
        function_builtin(builtin.ID.UnlockThread, "__unlock_thread", [], bare(lock_thread_call)),
        function_builtin(builtin.ID.VLoad, "__vload", ["src", "at"], vector_load),
        function_builtin(builtin.ID.VStore, "__vstore", ["dst", "at", "v"], bare(vector_store)),
        function_builtin(builtin.ID.VSplat, "__vsplat", ["x"], vector_splat),
        function_builtin(builtin.ID.VMask, "__vmask", ["v"], bare(vector_mask)),
        function_builtin(builtin.ID.VShuffle, "__vshuffle", ["v", "order"], bare(vector_shuffle)),
        function_builtin(builtin.ID.VSelect, "__vselect", ["mask", "a", "b"], bare(vector_select)),
        function_builtin(builtin.ID.VMin, "__vmin", ["a", "b"], bare(vector_pair)),
        function_builtin(builtin.ID.VMax, "__vmax", ["a", "b"], bare(vector_pair)),
        function_builtin(builtin.ID.VLane, "__vlane", ["v", "i"], wanted(vector_lane)),
        function_builtin(builtin.ID.VWith, "__vwith", ["v", "i", "x"], bare(vector_with)),
    ]
}

fn derived_builtins() -> []*Builtin {
    [
        new(Builtin { name: "__deserialize", params: ["r"], type_args: 1, has_construct: true, construct: deserialize_call }),
        new(Builtin { name: "__schema", type_args: 1, has_construct: true, construct: schema_call }),
    ]
}

fn type_builtins(u: *types.Universe) -> []*Builtin {
    let value = ["value"]
    var list: []*Builtin = [
        new(Builtin { id: builtin.ID.Convert, name: "ptr", kind: TypeBuiltin, params: value, has_handler: true, handler: bare(ptr_conversion), has_resolve: true, resolve: resolve_raw }),
        new(Builtin { id: builtin.ID.Chan, name: "chan", kind: TypeBuiltin, params: ["capacity"], optional: 1, type_args: 1, has_construct: true, construct: make_chan, has_resolve: true, resolve: resolve_chan }),
    ]
    for declared_type in u.builtin_types() {
        let t = declared_type.type
        let entry = new(Builtin { name: declared_type.name, kind: TypeBuiltin, type: t })
        if t.kind == VectorKind {
            entry.id = builtin.ID.VectorCast
            entry.params = value
            entry.has_handler = true
            entry.handler = vector_caster(t)
        } else if t == u.str {
            entry.id = builtin.ID.Str
            entry.params = value
            entry.has_handler = true
            entry.handler = bare(str_call)
        } else if t.is_number() {
            entry.id = builtin.ID.Convert
            entry.params = value
            entry.has_handler = true
            entry.handler = converter(t)
        }
        push(mut list, entry)
    }
    list
}

fn ptr_conversion(c: *Checker, e: *ast.Call) ! diag.Error {
    let raw = c.universe.raw(none)?
    convert(c, e, raw)?
}

fn converter(to: *types.Type) -> fn(*Checker, *Builtin, *ast.Call, *types.Type?) ! diag.Error {
    fn(c: *Checker, b: *Builtin, e: *ast.Call, want: *types.Type?) ! diag.Error { convert(c, e, to)? }
}

fn vector_caster(to: *types.Type) -> fn(*Checker, *Builtin, *ast.Call, *types.Type?) ! diag.Error {
    fn(c: *Checker, b: *Builtin, e: *ast.Call, want: *types.Type?) ! diag.Error { vector_cast(c, e, to)? }
}

fn declared(c: *Checker, name: str) -> bool {
    let home = local(c)
    let bound = c.ctx.bound[name] != none
    home.funcs[name] != none || home.consts[name] != none || home.generics[name] != none || bound || find(c, name) != none
}

fn builtin_named(c: *Checker, name: str) -> *Builtin? {
    let b = c.builtins[name] ?? return none
    if b.shadowable && declared(c, name) {
        return none
    }
    b
}

fn call_builtin(c: *Checker, b: *Builtin, e: *ast.Call, want: *types.Type?) ! diag.Error {
    arity(c, b, e)?
    e.builtin = b.id
    borrow_muts(c, b, e)?
    let handler = b.handler
    handler(c, b, e, want)?
}

fn borrow_muts(c: *Checker, b: *Builtin, e: *ast.Call) ! diag.Error {
    for i, arg in e.args {
        let describe = "{param_name(b, i)} of {b.name}"
        let r = mut_argument(c, arg, is_mut(b, i), describe)?
        match r {
            some(ref_arg) => { borrow_in_place(c, ref_arg)? }
            none => {}
        }
    }
}

fn type_arity(c: *Checker, b: *Builtin, inst: *ast.Instance) ! diag.Error {
    if inst.types.len != b.type_args {
        fail At(inst.pos, "{b.name} takes {plural(b.type_args, "type argument")}, found {inst.types.len}")
    }
}

fn arity(c: *Checker, b: *Builtin, e: *ast.Call) ! diag.Error {
    let most = b.params.len
    let least = most - b.optional
    let found = e.args.len
    if found >= least && found <= most {
        return
    }
    fail At(e.pos, "{b.name} takes {argument_count(least, most)}, found {found}")
}

fn argument_count(least: i64, most: i64) -> str {
    if least != most {
        return "{least} to {most} arguments"
    }
    if most == 0 {
        return "no arguments"
    }
    if most == 1 {
        return "1 argument"
    }
    "{most} arguments"
}

fn callable(c: *Checker, name: str) -> bool {
    match c.builtins[name] {
        some(b) => {
            if !b.shadowable {
                return true
            }
        }
        none => {}
    }
    declared(c, name)
}

fn first_mut(c: *Checker, f: ast.Expr) -> bool ! diag.Error {
    match f {
        Ident(id) => {
            match builtin_named(c, id.name) {
                some(b) => return is_mut(b, 0)
                none => {}
            }
            if find(c, id.name) != none {
                return false
            }
            let target = local_func(c, id.name) ?? return false
            return target.params.len > 0 && target.params[0].mutable
        }
        Selector(sel) => {
            match sel.x {
                Ident(id) => {
                    if !is_module(c, id.name) {
                        return false
                    }
                    let target = imported_func(c, id.name, sel.name, sel.pos)?
                    return target.params.len > 0 && target.params[0].mutable
                }
                _ => return false
            }
        }
        _ => return false
    }
}

fn builtin_type(c: *Checker, b: *Builtin, t: *ast.TypeName) -> *types.Type ! diag.Error {
    if b.has_resolve {
        let resolver = b.resolve
        return resolver(c, t)?
    }
    if t.args.len > 0 {
        fail At(t.pos, "{t.name} is not generic")
    }
    b.type ?? panic("builtin type {b.name} has no type")
}

fn resolve_chan(c: *Checker, t: *ast.TypeName) -> *types.Type ! diag.Error {
    if t.args.len != 1 {
        fail At(t.pos, "chan takes 1 type argument")
    }
    let elem = contained(c, t.args[0], "a channel")?
    c.universe.channel(elem)?
}

fn resolve_raw(c: *Checker, t: *ast.TypeName) -> *types.Type ! diag.Error {
    if t.args.len == 0 {
        return c.universe.raw(none)?
    }
    if t.args.len == 1 {
        let elem = contained(c, t.args[0], "a ptr")?
        return c.universe.raw(elem)?
    }
    fail At(t.pos, "ptr takes at most 1 type argument")
}

fn none_constant(c: *Checker, e: *ast.Ident, want: *types.Type?) ! diag.Error {
    fail At(e.pos, "cannot infer the type of none; annotate the binding")
}

fn null_constant(c: *Checker, e: *ast.Ident, want: *types.Type?) ! diag.Error {
    e.null = true
    e.type = c.universe.raw(none)?
    match unwrap(want) {
        some(w) => {
            if w.kind == RawKind {
                e.type = w
            }
        }
        none => {}
    }
}

fn bytes_call(c: *Checker, e: *ast.Call) ! diag.Error {
    expect_type(c, e.args[0], c.universe.str)?
    e.type = c.universe.slice(c.universe.u8)?
}

fn str_call(c: *Checker, e: *ast.Call) ! diag.Error {
    e.type = c.universe.str
    let t = plain(c, e.args[0], none)?
    if t.kind == RawKind {
        c_string(c, e.args[0], t)?
        return
    }
    let bytes_type = c.universe.slice(c.universe.u8)?
    if t != bytes_type {
        fail At(ast.position(e.args[0]), "str takes []u8 or ptr[u8], found {t.text()}")
    }
}

fn cstr_call(c: *Checker, e: *ast.Call) ! diag.Error {
    expect_type(c, e.args[0], c.universe.str)?
    e.type = c.universe.raw(c.universe.u8)?
}

fn view_call(c: *Checker, b: *Builtin, e: *ast.Call) ! diag.Error {
    let elem = typed_raw(c, e.args[0], b.name)?
    integer(c, e.args[1])?
    e.type = c.universe.slice(elem)?
}

fn load_call(c: *Checker, b: *Builtin, e: *ast.Call) ! diag.Error {
    e.type = typed_raw(c, e.args[0], b.name)?
}

fn store_call(c: *Checker, b: *Builtin, e: *ast.Call) ! diag.Error {
    let elem = typed_raw(c, e.args[0], b.name)?
    expect_type(c, e.args[1], elem)?
    e.type = c.universe.void
}

fn pin_call(c: *Checker, e: *ast.Call) ! diag.Error {
    let t = plain(c, e.args[0], none)?
    if t.kind != PointerKind && t.kind != SliceKind && t.kind != MapKind && t != c.universe.str {
        fail At(ast.position(e.args[0]), "pin takes a pointer, slice, map or str, found {t.text()}")
    }
    e.type = c.universe.raw(none)?
}

fn unpin_call(c: *Checker, e: *ast.Call) ! diag.Error {
    let t = plain(c, e.args[0], none)?
    if t.kind != RawKind {
        fail At(ast.position(e.args[0]), "unpin takes the ptr returned by pin, found {t.text()}")
    }
    e.type = c.universe.void
}

fn close_call(c: *Checker, e: *ast.Call) ! diag.Error {
    channel_operand(c, e.args[0])?
    e.type = c.universe.void
}

fn wait_call(c: *Checker, e: *ast.Call) ! diag.Error {
    integer(c, e.args[0])?
    e.type = c.universe.void
}

fn bits_call(c: *Checker, e: *ast.Call) ! diag.Error {
    let t = plain(c, e.args[0], none)?
    e.type = c.universe.i64
    if t == c.universe.f32 {
        e.type = c.universe.u32
    } else if t != c.universe.f64 {
        fail At(e.pos, "__bits requires a float")
    }
}

fn str_raw_call(c: *Checker, e: *ast.Call) ! diag.Error {
    integer(c, e.args[0])?
    integer(c, e.args[1])?
    e.type = c.universe.str
}

fn slice_ptr_call(c: *Checker, e: *ast.Call) ! diag.Error {
    let t = plain(c, e.args[0], none)?
    if t == c.universe.str {
        e.type = c.universe.raw(c.universe.u8)?
    } else if t.kind == SliceKind {
        e.type = c.universe.raw(t.elem)?
    } else {
        fail At(e.pos, "__slice_ptr requires a slice or str")
    }
}

fn ctz_call(c: *Checker, e: *ast.Call) ! diag.Error {
    expect_type(c, e.args[0], c.universe.u64)?
    e.type = c.universe.i64
}

fn clock_nanos_call(c: *Checker, e: *ast.Call) ! diag.Error {
    expect_type(c, e.args[0], c.universe.i64)?
    e.type = c.universe.i64
}

fn hash_seed_call(c: *Checker, e: *ast.Call) ! diag.Error {
    match e.args[0] {
        IntLit(lit) => {
            if lit.value < 0 || lit.value > 1 {
                fail At(e.pos, "__hash_seed takes the literal 0 or 1")
            }
        }
        _ => fail At(e.pos, "__hash_seed takes the literal 0 or 1")
    }
    expect_type(c, e.args[0], c.universe.i64)?
    e.type = c.universe.u64
}

fn argc_call(c: *Checker, e: *ast.Call) ! diag.Error {
    e.type = c.universe.i64
}

fn argv_call(c: *Checker, e: *ast.Call) ! diag.Error {
    expect_type(c, e.args[0], c.universe.i64)?
    e.type = c.universe.raw(c.universe.u8)?
}

fn mulhi_call(c: *Checker, e: *ast.Call) ! diag.Error {
    expect_type(c, e.args[0], c.universe.u64)?
    expect_type(c, e.args[1], c.universe.u64)?
    e.type = c.universe.u64
}

fn make_call(c: *Checker, e: *ast.Call, want: *types.Type?) ! diag.Error {
    let w = want ?? fail At(e.pos, "__make needs an expected slice type")
    if w.kind != SliceKind {
        fail At(e.pos, "__make needs an expected slice type")
    }
    integer(c, e.args[0])?
    e.type = w
}

fn memmove_call(c: *Checker, e: *ast.Call) ! diag.Error {
    let dst = plain(c, e.args[0], none)?
    if dst.kind != SliceKind {
        fail At(ast.position(e.args[0]), "__memmove needs a slice, found {dst.text()}")
    }
    let src = plain(c, e.args[1], dst)?
    if !dst.accepts(src) && (dst.elem != c.universe.u8 || src != c.universe.str) {
        fail At(ast.position(e.args[1]), "expected {dst.text()}, found {src.text()}")
    }
    e.type = c.universe.i64
}

fn extend_call(c: *Checker, e: *ast.Call) ! diag.Error {
    let bytes_type = c.universe.slice(c.universe.u8)?
    mut_of(c, e, 0, bytes_type)?
    expect_type(c, e.args[1], c.universe.str)?
    e.type = c.universe.void
}

fn extend_by_call(c: *Checker, e: *ast.Call) ! diag.Error {
    let bytes_type = c.universe.slice(c.universe.u8)?
    mut_of(c, e, 0, bytes_type)?
    expect_type(c, e.args[1], c.universe.i64)?
    e.type = c.universe.i64
}

fn str_view_call(c: *Checker, e: *ast.Call) ! diag.Error {
    let bytes_type = c.universe.slice(c.universe.u8)?
    expect_type(c, e.args[0], bytes_type)?
    e.type = c.universe.str
}

fn hash_call(c: *Checker, e: *ast.Call) ! diag.Error {
    let t = plain(c, e.args[0], none)?
    if !t.hashable() {
        fail At(ast.position(e.args[0]), "__hash requires a hashable value, found {t.text()}")
    }
    e.type = c.universe.i64
}

fn zero_call(c: *Checker, e: *ast.Call, want: *types.Type?) ! diag.Error {
    let w = want ?? fail At(e.pos, "__zero needs an expected type")
    e.type = w
}

fn context_call(c: *Checker, e: *ast.Call, want: *types.Type?) ! diag.Error {
    let w = want ?? fail At(e.pos, "__context needs an expected pointer type")
    if w.kind != PointerKind {
        fail At(e.pos, "__context needs an expected pointer type")
    }
    e.type = w
}

fn set_context_call(c: *Checker, e: *ast.Call) ! diag.Error {
    let t = plain(c, e.args[0], none)?
    if t.kind != PointerKind {
        fail At(ast.position(e.args[0]), "__set_context needs a pointer, found {t.text()}")
    }
    e.type = c.universe.void
}

fn has_context_call(c: *Checker, e: *ast.Call) ! diag.Error {
    e.type = c.universe.bool
}

fn spawn_call(c: *Checker, e: *ast.Call) ! diag.Error {
    let t = plain(c, e.args[0], none)?
    if t.kind != FuncKind || t.c || t.params.len > 0 {
        fail At(e.pos, "__spawn takes a function value with no parameters")
    }
    e.type = c.universe.void
}

fn current_call(c: *Checker, e: *ast.Call) ! diag.Error {
    e.type = c.universe.raw(none)?
}

fn park_call(c: *Checker, e: *ast.Call) ! diag.Error {
    e.type = c.universe.void
}

fn lock_thread_call(c: *Checker, e: *ast.Call) ! diag.Error {
    e.type = c.universe.void
}

fn ready_call(c: *Checker, e: *ast.Call) ! diag.Error {
    let raw = c.universe.raw(none)?
    expect_type(c, e.args[0], raw)?
    e.type = c.universe.void
}

fn lock_call(c: *Checker, e: *ast.Call) ! diag.Error {
    let word = mut_of(c, e, 0, c.universe.i64)?
    address(c, word)
    e.type = c.universe.void
}

fn cas_call(c: *Checker, e: *ast.Call) ! diag.Error {
    let word = mut_of(c, e, 0, c.universe.i64)?
    address(c, word)
    expect_type(c, e.args[1], c.universe.i64)?
    expect_type(c, e.args[2], c.universe.i64)?
    e.type = c.universe.bool
}

fn panic_call(c: *Checker, e: *ast.Call) ! diag.Error {
    expect_type(c, e.args[0], c.universe.str)?
    e.type = c.universe.never
}
