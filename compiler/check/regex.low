import ast
import diag
import parser
import regex
import std/hash
import std/path

fn generated_call() -> str {
    "{path.base(regex.module)}.{regex.generator}"
}

fn generates_regex(c: *Checker, alias: str, name: str) -> bool {
    let module = c.ctx.file.imported(alias) ?? ""
    module == regex.module && name == regex.generator
}

fn generated_regex(c: *Checker, e: *ast.Call) ! diag.Error {
    if e.args.len != 1 {
        fail At(e.pos, "{generated_call()} takes 1 argument, found {e.args.len}")
    }
    let lit = match e.args[0] {
        StrLit(s) => s
        _ => fail At(ast.position(e.args[0]), "{generated_call()} needs a string literal pattern")
    }
    let key = "regex:{lit.value}"
    var target = c.derived[key]
    if target == none {
        let made = generate_regex(c, lit)?
        c.derived[key] = made
        target = made
    }
    let f = target ?? panic("generated regex is missing")
    e.args = []
    e.target = f
    e.type = f.ret_type
}

fn generate_regex(c: *Checker, lit: *ast.StrLit) -> *ast.Func ! diag.Error {
    let prog = regex.compile(lit.value) catch {
        err => fail At(lit.pos, "invalid regex {regex.message(err)}")
    }
    let module = scope(c, regex.module)
    let name = regex_name(lit.value, module)
    let source = regex.generate(name, lit.value, prog)
    let file = parser.parse_source(source, diag.start("<{name}>"), true) catch {
        err => panic("generated regex {diag.quote(lit.value)} does not parse: {diag.message(err)}\n{source}")
    }
    let home = module.home ?? panic("module {regex.module} has no home file")
    for f in file.funcs {
        f.file = home
        module.funcs[f.name] = f
    }
    within(c, home, [:], fn() ! diag.Error {
        for f in file.funcs {
            signature(c, f)?
        }
    })?
    for f in file.funcs {
        push(mut home.funcs, f)
        push(mut c.pending, f)
    }
    module.funcs[name] ?? panic("generated regex {name} is not declared")
}

fn regex_name(pattern: str, module: *Scope) -> str {
    let digest = hash.fnv1a_64(bytes(pattern))
    let base = "__regex_{digest:x16}"
    var name = base
    var n = 1
    for module.funcs[name] != none {
        name = "{base}_{n}"
        n += 1
    }
    name
}
