import diag
import prelude
import types

enum Phase {
    Declaring = 0
    Laid = 1
    Ready = 2
}

fn advance(c: *Checker, next: Phase) ! diag.Error {
    c.phase = next
    let queued = c.waiting[next.index] ?? []
    c.waiting.delete(next.index)
    for run in queued {
        run()?
    }
}

fn when(c: *Checker, at: Phase, run: fn() ! diag.Error) ! diag.Error {
    if c.phase.index >= at.index {
        run()?
        return
    }
    var queued = c.waiting[at.index] ?? []
    queued.push(run)
    c.waiting[at.index] = queued
}

fn settle_optionals(c: *Checker) ! diag.Error {
    let pending = c.unsized_optionals
    c.unsized_optionals = []
    var waiting: []*types.Type = []
    for t in pending {
        if t.elem_of().size() > 0 {
            layout(c, t, diag.nowhere())?
        } else {
            waiting.push(t)
        }
    }
    for t in waiting {
        c.unsized_optionals.push(t)
    }
}

fn created(c: *Checker, t: *types.Type) ! diag.Error {
    if t.kind == ResultKind {
        when(c, Laid, fn() ! diag.Error { layout(c, t, diag.nowhere()) })?
    } else if t.optional {
        c.unsized_optionals.push(t)
        settle_optionals(c)?
    } else if t.kind == MapKind {
        instantiate_ops(c, t, prelude.Role.MapOp, [t.key_of(), t.elem_of()])?
    } else if t.kind == ChanKind {
        instantiate_ops(c, t, prelude.Role.ChanOp, [t.elem_of()])?
    }
}
