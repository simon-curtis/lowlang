import ast
import regex
import std/path
import types

pub struct GeneratedSignature {
    pub name: str
    pub signature: str
}

pub fn generated_regex_signature() -> GeneratedSignature {
    GeneratedSignature { name: regex.generator, signature: "fn {regex.generator}(pattern: str) -> {path.base(regex.module)}.{regex.result}" }
}

pub fn takes_first(f: *ast.Func, t: *types.Type) -> bool {
    if f.param_types.len == 0 {
        return false
    }
    let inf = new(Inference { params: f.type_args, bound: [:] })
    unify_types(inf, f.param_types[0], t)
}
