import std/text

const unlimited = -1

struct Option {
    name: str
    letter: str = ""
    hint: str = ""
    help: str
    fallback: str = ""
}

struct Command {
    name: str
    summary: str
    operands: str
    about: str
    options: []Option
    least: i64
    most: i64
    stops: bool
    execute: fn(Parsed) ! Error
}

struct Parsed {
    command: str
    values: [str: str]
    operands: []str
}

struct Scanner {
    spec: Command
    args: []str
    at: i64
    values: [str: str]
    operands: []str
}

fn help_option() -> Option {
    Option { name: "help", letter: "h", help: "Show this help" }
}

fn is_set(p: Parsed, name: str) -> bool {
    p.values[name] != none
}

fn given(p: Parsed, name: str) -> str? {
    p.values[name]
}

fn given_or(p: Parsed, name: str, fallback: str) -> str {
    p.values[name] ?? fallback
}

fn required(p: Parsed, name: str) -> str ! Error {
    let value = given(p, name) ?? fail usage_error(p, "missing option --{name}")
    if value == "" {
        fail option_error(p.command, name, "needs a value")
    }
    value
}

fn operand_or(p: Parsed, index: i64, fallback: str) -> str {
    if index < p.operands.len {
        return p.operands[index]
    }
    fallback
}

fn operands_from(p: Parsed, index: i64) -> []str {
    if index < p.operands.len {
        return p.operands[index..]
    }
    []
}

fn usage_error(p: Parsed, message: str) -> Error {
    Error.Usage(p.command, message)
}

fn option_error(command: str, name: str, message: str) -> Error {
    Error.Usage(command, "option --{name} {message}")
}

fn invalid_value(command: str, name: str, raw: str) -> Error {
    Error.Usage(command, "invalid value '{raw}' for --{name}")
}

fn find_long(spec: Command, name: str) -> Option? {
    for o in spec.options {
        if o.name == name {
            return o
        }
    }
    none
}

fn find_short(spec: Command, letter: str) -> Option? {
    for o in spec.options {
        if o.letter == letter {
            return o
        }
    }
    none
}

fn parse_command(spec: Command, args: []str) -> Parsed ! Error {
    let s = new(Scanner { spec, args, at: 0, values: [:], operands: [] })
    for s.at < args.len && s.values["help"] == none {
        scan_argument(s)?
    }
    let parsed = Parsed { command: spec.name, values: s.values, operands: s.operands }
    if !is_set(parsed, "help") {
        check_operands(parsed, spec)?
    }
    parsed
}

fn check_operands(p: Parsed, spec: Command) ! Error {
    if p.operands.len < spec.least {
        fail usage_error(p, "missing operand")
    }
    if spec.most != unlimited && p.operands.len > spec.most {
        fail usage_error(p, "unexpected operand '{p.operands[spec.most]}'")
    }
}

fn scan_error(s: *Scanner, message: str) -> Error {
    Error.Usage(s.spec.name, message)
}

fn take_rest(s: *Scanner) {
    for s.at < s.args.len {
        s.operands.push(s.args[s.at])
        s.at += 1
    }
}

fn scan_argument(s: *Scanner) ! Error {
    let arg = s.args[s.at]
    s.at += 1
    if arg == "--" {
        take_rest(s)
        return
    }
    if arg == "-" || !text.starts_with(arg, "-") {
        s.operands.push(arg)
        if s.spec.stops {
            take_rest(s)
        }
        return
    }
    if text.starts_with(arg, "--") {
        scan_long(s, arg)?
        return
    }
    scan_cluster(s, arg)?
}

struct Inline {
    name: str
    value: str?
}

fn split_inline(body: str) -> Inline {
    let eq = text.index_byte(body, '=')
    if eq < 0 {
        return Inline { name: body, value: none }
    }
    Inline { name: body[..eq], value: some(body[eq + 1..]) }
}

fn unknown_option(s: *Scanner, arg: str) -> Error {
    scan_error(s, "unknown option {arg}")
}

fn scan_long(s: *Scanner, arg: str) ! Error {
    let split = split_inline(arg[2..])
    let opt = find_long(s.spec, split.name) ?? fail unknown_option(s, arg)
    if opt.hint != "" {
        s.values[opt.name] = split.value ?? next_value(s, opt)?
        return
    }
    if split.value != none {
        fail option_error(s.spec.name, opt.name, "takes no value")
    }
    s.values[opt.name] = ""
}

fn scan_cluster(s: *Scanner, arg: str) ! Error {
    let body = arg[1..]
    var i = 0
    for i < body.len {
        let opt = find_short(s.spec, body[i..i + 1]) ?? fail unknown_option(s, arg)
        i += 1
        if opt.hint == "" {
            s.values[opt.name] = ""
            continue
        }
        let attached = body[i..]
        if attached != "" {
            s.values[opt.name] = attached
            return
        }
        s.values[opt.name] = next_value(s, opt)?
        return
    }
}

fn next_value(s: *Scanner, opt: Option) -> str ! Error {
    if s.at >= s.args.len {
        fail option_error(s.spec.name, opt.name, "needs a value")
    }
    let value = s.args[s.at]
    s.at += 1
    value
}
