import compiler
import target
import std/file
import std/io
import std/path
import std/slices
import std/text

const walk_marker = "..."
const std_root = "std"

struct Selector {
    platform: target.OS
    cwd: str
    standard: []str
}

struct Module {
    label: str
    place: str
    dir: str
    file: str
    line: i64
}

fn select_modules(s: Selector, written: []str) -> []Module ! Error {
    var found: []Module = []
    for argument in written {
        let expanded = expand(s, argument)?
        for m in expanded {
            push(mut found, m)
        }
    }
    found
}

fn expand(s: Selector, argument: str) -> []Module ! Error {
    if argument == walk_marker || text.ends_with(argument, "/{walk_marker}") {
        return walked(s, argument)?
    }
    let colon = text.last_index_byte(argument, ':')
    if colon > 0 {
        let file_part = argument[..colon]
        let line_part = argument[colon + 1..]
        if text.ends_with(file_part, ".low") && text.is_digits(line_part) {
            let located = at_line(s, file_part, line_part)?
            return [located]
        }
    }
    [named(s, argument, argument)]
}

fn is_std_path(cleaned: str) -> bool {
    cleaned == std_root || text.starts_with(cleaned, "{std_root}/")
}

fn absolute(s: Selector, place: str) -> str {
    compiler.absolute(s.cwd, place)
}

fn named(s: Selector, label: str, place: str) -> Module {
    let cleaned = path.clean(place)
    if is_std_path(cleaned) {
        return Module { label, place: cleaned, dir: "", file: "", line: 0 }
    }
    Module { label, place, dir: absolute(s, cleaned), file: "", line: 0 }
}

fn at_line(s: Selector, file_part: str, line_part: str) -> Module ! Error {
    let line = text.parse_int(line_part) or fail usage_failure("{file_part}:{line_part}: not a line number")
    let place = path.dir(file_part)
    var m = named(s, place, place)
    m.file = absolute(s, file_part)
    m.line = line
    m
}

fn walked(s: Selector, argument: str) -> []Module ! Error {
    let root = path.clean(text.trim_suffix(argument, walk_marker))
    var found: []Module = []
    if is_std_path(root) {
        for place in s.standard {
            if place == root || text.starts_with(place, "{root}/") {
                push(mut found, named(s, place, place))
            }
        }
        return found
    }
    let directories = test_directories(root, s.platform) catch {
        e => fail usage_failure("{argument}: {e}")
    }
    for directory in directories {
        push(mut found, named(s, directory, directory))
    }
    found
}

fn test_directories(root: str, platform: target.OS) -> []str ! io.Error {
    var found: []str = []
    let visit = fn(v: file.Visit) -> file.Step {
        if v.dir {
            return visit_directory(v)
        }
        if v.regular && compiler.is_test_source(v.name, platform) {
            let directory = path.clean(path.dir(v.path))
            if !slices.contains(found, directory) {
                push(mut found, directory)
            }
        }
        file.Step.Continue
    }
    file.walk(root, visit)?
    slices.sort(mut found)
    found
}

fn visit_directory(v: file.Visit) -> file.Step {
    if v.depth > 0 && left_out(v.name) {
        return file.Step.Skip
    }
    file.Step.Continue
}

fn left_out(name: str) -> bool {
    name == "testdata" || name == "examples" || text.starts_with(name, ".") || text.starts_with(name, "_")
}

fn has_test_files(s: Selector, m: Module) -> bool {
    if m.dir == "" {
        return slices.contains(s.standard, m.place)
    }
    let names = file.list(m.dir) or return true
    for name in names {
        if compiler.is_test_source(name, s.platform) {
            return true
        }
    }
    false
}

fn shown(s: Selector, place: str) -> str {
    text.strip_prefix(place, "{s.cwd}/") ?? place
}
