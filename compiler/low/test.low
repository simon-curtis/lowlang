import compiler
import target
import std/path

fn test_command(module_path: str, flags: []str) ! Error {
    let dir = scratch_directory("low-test-")?
    defer remove_directory(dir)
    let platform = target.host()
    let profile = compiler.release(platform)
    let unit = compiler.analyse_tests(module_path, profile) catch Compile
    report(unit)
    let binary = path.join([dir, target.executable(platform, "tests")])
    compiler.build(unit, binary) catch Compile
    let status = run_binary(binary, flags)?
    if status != 0 {
        fail Exit(status)
    }
}
