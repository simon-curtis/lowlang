import hot
import std/cancel
import std/os/signal

fn dev_command(source: str) ! Error {
    let stdout = hot.Sink.Descriptor(1)
    let stderr = hot.Sink.Descriptor(2)
    let session = hot.new_session(source, stdout, stderr) catch {
        e => fail Failed(hot.message(e))
    }
    defer hot.close_session(session)
    let interrupt = [signal.Signal.Interrupt]
    using interrupts = signal.notify(interrupt) catch {
        e => fail Failed("watch for interrupts: {e}")
    }
    let token = cancel.token()
    spawn cancel_on_interrupt(interrupts.handle, token)
    hot.run(session, token) catch {
        Cancelled => {}
        e => fail Failed(hot.message(e))
    }
}

fn cancel_on_interrupt(handle: signal.WatchHandle, token: *cancel.Token) {
    signal.wait_for_on(handle) or return
    cancel.cancel(token)
}
