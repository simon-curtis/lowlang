import compiler
import fetch
import native
import std/file
import std/path
import std/process
import std/text

struct Hooks {
    dir: str = ""
    warnings: []str = []
    pre_build: []compiler.Hook = []
    post_build: []compiler.Hook = []
}

fn entry_directory(docs: *compiler.Overlay, source: str) -> str ! Error {
    let full = compiler.absolute_path(docs, source) catch Front
    if file.is_dir(full) {
        return full
    }
    path.dir(full)
}

fn project_root(docs: *compiler.Overlay, source: str) -> str? ! Error {
    let dir = entry_directory(docs, source)?
    let root = compiler.root(docs, dir) ?? return none
    if !file.exists(path.join([root, compiler.manifest_file])) {
        return none
    }
    root
}

fn fetch_project(source: str, update: bool) -> []str ! Error {
    let docs = native.overlay()
    let root = project_root(docs, source)? ?? return []
    fetch.sync(docs, root, update) catch Fetch
}

fn warn_each(warnings: []str) {
    for w in warnings {
        note_stderr("warning: {w}")
    }
}

struct Declared {
    root: str = ""
    programs: []compiler.Program = []
}

fn declared_programs(docs: *compiler.Overlay, source: str) -> Declared ! Error {
    let root = project_root(docs, source)? ?? return Declared {}
    let manifest = compiler.project_manifest(docs, root) catch Front
    let m = manifest ?? return Declared {}
    let programs = compiler.project_programs(docs, root, m) catch Front
    Declared { root, programs }
}

fn declared_resources(docs: *compiler.Overlay, source: str) -> compiler.Resources ! Error {
    let root = project_root(docs, source)? ?? return compiler.Resources {}
    let manifest = compiler.project_manifest(docs, root) catch Front
    let m = manifest ?? return compiler.Resources {}
    compiler.project_resources(docs, root, m) catch Front
}

fn same_directory(docs: *compiler.Overlay, a: str, b: str) -> bool {
    let drives = docs.disk.drives
    let left = compiler.path_key(drives, a)
    let right = compiler.path_key(drives, b)
    if drives {
        return text.equal_fold(left, right)
    }
    left == right
}

fn project_hooks(source: str) -> Hooks ! Error {
    let docs = native.overlay()
    let root = project_root(docs, source)? ?? return Hooks {}
    let warnings = fetch.sync(docs, root, false) catch Fetch
    let manifest = compiler.project_manifest(docs, root) catch Front
    let m = manifest ?? return Hooks {}
    Hooks { dir: root, warnings, pre_build: m.pre_build, post_build: m.post_build }
}

fn before(h: Hooks) ! Error {
    h.run_each("pre_build", h.pre_build)?
}

fn after(h: Hooks) ! Error {
    h.run_each("post_build", h.post_build)?
}

fn run_each(h: Hooks, stage: str, hooks: []compiler.Hook) ! Error {
    for hook in hooks {
        h.run_hook(stage, hook)?
    }
}

fn run_hook(h: Hooks, stage: str, hook: compiler.Hook) ! Error {
    var command = process.command(hook.program, hook.args)
    command.dir = h.dir
    using child = process.start(command) catch {
        e => fail Failed("{stage} {hook.program}: {e}")
    }
    let exit = process.wait(child) catch {
        e => fail Failed("{stage} {hook.program}: {e}")
    }
    match exit {
        Exited(code) => {
            if code != 0 {
                fail Failed("{stage} {hook.program} exited with status {code}")
            }
        }
        Signaled(_) => fail Failed("{stage} {hook.program} was ended by a signal")
    }
}

fn update_command(dir: str) ! Error {
    let docs = native.overlay()
    let root = project_root(docs, dir)? ?? fail Failed("{dir} is not in a project with a build.low")
    fetch.sync(docs, root, true) catch Fetch
}
