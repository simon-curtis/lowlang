import compiler
import fetch
import resource
import native
import target
import std/file
import std/path
import std/process

struct Project {
    dir: str = ""
    pre_build: []compiler.Hook = []
    post_build: []compiler.Hook = []
    icon: str = ""
    app_manifest: str = ""
    version: str = ""
    file_info: []resource.FileInfo = []
}

fn project_root(docs: *compiler.Overlay, source: str) -> str? ! Error {
    let full = compiler.absolute_path(docs, source) catch Front
    var dir = full
    if !file.is_dir(full) {
        dir = path.dir(full)
    }
    let root = compiler.root(docs, dir) ?? return none
    if !file.exists(path.join([root, compiler.manifest_file])) {
        return none
    }
    root
}

fn fetch_project(source: str, update: bool) ! Error {
    let docs = native.overlay()
    let root = project_root(docs, source)? ?? return
    fetch.sync(docs, root, update) catch Fetch
}

fn load_project(source: str) -> Project ! Error {
    let docs = native.overlay()
    let root = project_root(docs, source)? ?? return Project {}
    fetch.sync(docs, root, false) catch Fetch
    let manifest = compiler.project_manifest(docs, root) catch Front
    let m = manifest ?? return Project {}
    Project {
        dir: root
        pre_build: m.pre_build
        post_build: m.post_build
        icon: in_project(root, m.icon)
        app_manifest: in_project(root, m.app_manifest)
        version: m.version
        file_info: m.file_info
    }
}

fn in_project(root: str, file: str) -> str {
    if file == "" {
        return ""
    }
    path.join([root, file])
}

fn resources(p: Project, opts: Options) -> resource.Resources ! Error {
    if opts.platform != target.OS.Windows {
        return resource.Resources {}
    }
    let icon = read_resource(flag_or(opts.icon, p.icon))?
    let manifest = read_resource(flag_or(opts.app_manifest, p.app_manifest))?
    resource.Resources { icon, manifest, version: p.version, info: p.file_info }
}

fn flag_or(flag: str, declared: str) -> str {
    if flag != "" {
        return flag
    }
    declared
}

fn read_resource(name: str) -> []u8 ! Error {
    if name == "" {
        return []
    }
    file.read_file(name) catch {
        e => fail Failed("read {name}: {e}")
    }
}

fn before(p: Project) ! Error {
    p.run_each("pre_build", p.pre_build)?
}

fn after(p: Project) ! Error {
    p.run_each("post_build", p.post_build)?
}

fn run_each(p: Project, stage: str, hooks: []compiler.Hook) ! Error {
    for hook in hooks {
        p.run_hook(stage, hook)?
    }
}

fn run_hook(p: Project, stage: str, hook: compiler.Hook) ! Error {
    var command = process.command(hook.program, hook.args)
    command.dir = p.dir
    using child = process.start(command) catch {
        e => fail Failed("{stage} {hook.program}: {e}")
    }
    let exit = process.wait(child) catch {
        e => fail Failed("{stage} {hook.program}: {e}")
    }
    match exit {
        Exited(code) => {
            if code != 0 {
                fail Failed("{stage} {hook.program} exited with status {code}")
            }
        }
        Signaled(_) => fail Failed("{stage} {hook.program} was ended by a signal")
    }
}

fn update_command(args: []str) ! Error {
    if args.len > 1 {
        fail Usage
    }
    var dir = "."
    if args.len == 1 {
        dir = args[0]
    }
    let docs = native.overlay()
    let root = project_root(docs, dir)? ?? fail Failed("{dir} is not in a project with a build.low")
    fetch.sync(docs, root, true) catch Fetch
}
