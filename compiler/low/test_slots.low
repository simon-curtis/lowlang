import std/file
import std/io
import std/os
import std/path
import std/sync
import std/time
import std/time/duration

const first_poll_ms = 10
const last_poll_ms = 50
const builds_per_cpu = 4

struct Slots {
    dir: str
    count: i64
    turn: sync.Mutex
}

fn machine_slots(cache: str, kind: str, count: i64) -> *Slots? {
    if cache == "" {
        return none
    }
    let dir = path.join([cache, "slots", kind])
    file.mkdir_all(dir) or return none
    new(Slots { dir, count, turn: sync.mutex() })
}

fn test_slots(cache: str) -> *Slots? {
    machine_slots(cache, "test", os.cpu_count())
}

fn build_slots(cache: str) -> *Slots? {
    let count = os.cpu_count() / builds_per_cpu
    let at_least_one = if count < 1 { 1 } else { count }
    machine_slots(cache, "build", at_least_one)
}

fn take_slot(slots: *Slots) -> file.File ! io.Error {
    sync.lock(slots.turn)
    defer sync.unlock(slots.turn)
    let start = os.pid() % slots.count
    var wait_ms = first_poll_ms
    for {
        for step in 0..slots.count {
            let name = path.join([slots.dir, "{(start + step) % slots.count}"])
            using slot = file.update(name)?
            if file.try_lock(slot, true)? {
                return slot
            }
        }
        time.sleep_for(duration.milliseconds(wait_ms))
        if wait_ms < last_poll_ms {
            wait_ms = wait_ms * 2
        }
    }
}
