import fetch
import native

fn publish_command(source: str, version: str) ! Error {
    let docs = native.overlay()
    let entry = fetch.publish(docs, source, version) catch Fetch
    write_all(1, bytes("published {source} {entry.tag} {entry.commit}\n"))
}

fn yank_command(source: str, version: str, undo: bool) ! Error {
    let docs = native.overlay()
    let entry = fetch.yank(docs, source, version, undo) catch Fetch
    var verb = "yanked"
    if undo {
        verb = "unyanked"
    }
    write_all(1, bytes("{verb} {source} {entry.tag}\n"))
}
