import lsp
import target
import std/text

fn names_command(source: str, platform: target.OS) ! Error {
    let found = lsp.names(source, platform) catch Compile
    let encoded = names_json(found)
    write_all(1, bytes("{encoded}\n"))
}

fn names_json(found: []*lsp.Name) -> str {
    var elements: []str = []
    for n in found {
        push(mut elements, name_json(n))
    }
    "[{text.join(elements, ",")}]"
}

fn name_json(n: *lsp.Name) -> str {
    var fields: []str = [member("line", "{n.line}"), member("column", "{n.column}"), member("name", string(n.name))]
    if n.hover != "" {
        push(mut fields, member("hover", string(n.hover)))
    }
    if n.doc != "" {
        push(mut fields, member("doc", string(n.doc)))
    }
    match n.definition {
        some(d) => push(mut fields, member("definition", definition_json(d)))
        none => {}
    }
    match n.first {
        some(first) => push(mut fields, member("first", "{first}"))
        none => {}
    }
    "{{{text.join(fields, ",")}}}"
}

fn definition_json(d: lsp.Definition) -> str {
    let fields = [member("path", string(d.path)), member("line", "{d.line}"), member("column", "{d.column}"), member("local", "{d.local}")]
    "{{{text.join(fields, ",")}}}"
}

fn member(name: str, value: str) -> str {
    "\"{name}\":{value}"
}
