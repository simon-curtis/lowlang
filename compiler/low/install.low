import native
import target
import std/file
import std/os

struct Installed {
    staged: str
    installed: str
    aside: str
}

fn install_command(programs: []str, opts: Options) ! Error {
    let host = target.host()
    let bin = bin_directory()?
    file.mkdir_all(bin) catch {
        e => fail Failed("create {bin}: {e}")
    }
    var builds: []Build = []
    var places: []Installed = []
    var named: [str: str] = [:]
    for program in programs {
        let name = program_name(program, host)?
        match named[name] {
            some(other) => fail Failed("{other} and {program} both install as {name}")
            none => {}
        }
        named[name] = program
        let installed = file.child_path(bin, name)
        let place = Installed { staged: "{installed}.new", installed, aside: "{installed}.old" }
        file.remove(place.aside) or {}
        builds.push(Build { program, output: place.staged })
        places.push(place)
    }
    let jobs = native.runner()
    build_programs(builds, opts, jobs)?
    for place in places {
        place.replace_executable()?
    }
}

fn bin_directory() -> str ! Error {
    let explicit = os.env("LOW_BIN") ?? ""
    if explicit != "" {
        return explicit
    }
    let home = os.home_dir() ?? fail Failed("set LOW_BIN to the directory low install writes to")
    "{home}/.low/bin"
}

fn replace_executable(p: Installed) ! Error {
    file.rename(p.staged, p.installed) or {
        file.rename(p.installed, p.aside) catch {
            e => fail Failed("move {p.installed} aside: {e}")
        }
        file.rename(p.staged, p.installed) catch {
            e => fail Failed("install {p.installed}: {e}")
        }
    }
}
