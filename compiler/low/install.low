import compiler
import native
import target
import std/file
import std/os
import std/path

fn install_command(args: []str) ! Error {
    if args.len > 1 {
        fail Usage
    }
    var dir = "."
    if args.len == 1 {
        dir = args[0]
    }
    let programs = install_targets(dir)?
    let bin = bin_directory()?
    file.mkdir_all(bin) catch {
        e => fail Failed("create {bin}: {e}")
    }
    var named: [str: str] = [:]
    for program in programs {
        let name = path.base(program)
        match named[name] {
            some(other) => fail Failed("{other} and {program} both install as {name}")
            none => {}
        }
        named[name] = program
    }
    for program in programs {
        install_program(program, bin)?
    }
}

fn install_targets(dir: str) -> []str ! Error {
    let docs = native.overlay()
    let full = compiler.absolute_path(docs, dir) catch Front
    let manifest = compiler.project_manifest(docs, full) catch Front
    let m = manifest ?? return [full]
    if m.installs.len == 0 {
        return [full]
    }
    var programs: []str = []
    for each in m.installs {
        programs.push(compiler.absolute(docs.disk, full, each))
    }
    programs
}

fn bin_directory() -> str ! Error {
    let explicit = os.env("LOW_BIN") ?? ""
    if explicit != "" {
        return explicit
    }
    let home = os.home_dir() ?? fail Failed("set LOW_BIN to the directory low install writes to")
    "{home}/.low/bin"
}

fn install_program(program: str, bin: str) ! Error {
    let host = target.host()
    let installed = file.child_path(bin, target.executable(host, path.base(program)))
    let staged = "{installed}.new"
    let aside = "{installed}.old"
    file.remove(aside) or {}
    build_command(program, Options { output: staged, platform: host })?
    replace_executable(staged, installed, aside)?
    write_all(1, bytes("installed {installed}\n"))
}

fn replace_executable(staged: str, installed: str, aside: str) ! Error {
    file.rename(staged, installed) or {
        file.rename(installed, aside) catch {
            e => fail Failed("move {installed} aside: {e}")
        }
        file.rename(staged, installed) catch {
            e => fail Failed("install {installed}: {e}")
        }
    }
}
