import compiler
import native
import target
import std/file
import std/os
import std/path

struct Installed {
    staged: str
    installed: str
    aside: str
}

fn install_command(args: []str) ! Error {
    if args.len > 1 {
        fail Usage
    }
    var dir = "."
    if args.len == 1 {
        dir = args[0]
    }
    let programs = install_targets(dir)?
    let bin = bin_directory()?
    file.mkdir_all(bin) catch {
        e => fail Failed("create {bin}: {e}")
    }
    let host = target.host()
    var builds: []Build = []
    var places: []Installed = []
    for program in programs {
        let installed = file.child_path(bin, target.executable(host, path.base(program)))
        let place = Installed { staged: "{installed}.new", installed, aside: "{installed}.old" }
        file.remove(place.aside) or {}
        builds.push(Build { program, output: place.staged })
        places.push(place)
    }
    build_programs(dir, builds, Options { platform: host })?
    for place in places {
        place.replace_executable()?
        write_all(1, bytes("installed {place.installed}\n"))
    }
}

fn install_targets(dir: str) -> []str ! Error {
    let declared = declared_programs(dir)?
    match declared {
        some(programs) => programs
        none => {
            let docs = native.overlay()
            let full = compiler.absolute_path(docs, dir) catch Front
            [full]
        }
    }
}

fn bin_directory() -> str ! Error {
    let explicit = os.env("LOW_BIN") ?? ""
    if explicit != "" {
        return explicit
    }
    let home = os.home_dir() ?? fail Failed("set LOW_BIN to the directory low install writes to")
    "{home}/.low/bin"
}

fn replace_executable(p: Installed) ! Error {
    file.rename(p.staged, p.installed) or {
        file.rename(p.installed, p.aside) catch {
            e => fail Failed("move {p.installed} aside: {e}")
        }
        file.rename(p.staged, p.installed) catch {
            e => fail Failed("install {p.installed}: {e}")
        }
    }
}
