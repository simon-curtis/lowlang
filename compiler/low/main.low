import compiler
import ir
import lint
import lsp
import native
import target
import std/builder
import std/file
import std/os
import std/path
import std/process
import std/sys
import std/text

enum Error {
    Usage
    Compile(native.Error)
    Front(compiler.Error)
    Target(target.ParseError)
    Failed(msg: str)
    Exit(code: i64)
}

struct Options {
    output: str = ""
    platform: target.OS
}

fn usage() -> str {
    let choices = target.choices()
    var b = builder.builder()
    b.write("usage:\n")
    b.write("  low build <file.low> [-o output] [-target {choices}]\n")
    b.write("  low run <file.low>\n")
    b.write("  low asm <file.low> [-target {choices}]\n")
    b.write("  low ir <file.low> [-target {choices}]\n")
    b.write("  low lint <file.low> [-target {choices}]\n")
    b.write("  low doc <dir|std> [-target {choices}]\n")
    b.write("  low names <file.low> [-target {choices}]\n")
    b.write("  low dev <file.low>\n")
    b.write("  low lsp\n")
    b.write("  low version")
    b.to_str()
}

fn version() -> str {
    text.trim(embed("version.txt"))
}

fn main() {
    run(os.args()[1..]) catch {
        Exit(code) => os.exit(code)
        e => exit_with(e)
    }
}

fn exit_with(e: Error) {
    let line = describe(e)
    write_all(2, bytes("{line}\n"))
    os.exit(1)
}

fn describe(e: Error) -> str {
    match e {
        Usage => usage()
        Compile(inner) => native.message(inner)
        Front(inner) => compiler.message(inner)
        Target(inner) => target.message(inner)
        Failed(msg) => msg
        Exit(code) => "exit status {code}"
    }
}

fn write_all(fd: i64, data: []u8) {
    var rest = data
    for rest.len > 0 {
        let n = sys.try_write(fd, rest) or return
        rest = rest[n..]
    }
}

fn run(args: []str) ! Error {
    if args.len == 1 && args[0] == "lsp" {
        let docs = native.overlay()
        lsp.serve_stdio(docs) catch {
            e => fail Error.Failed(lsp.serve_message(e))
        }
        return
    }
    if args.len == 1 && args[0] == "version" {
        write_all(1, bytes("{version()}\n"))
        return
    }
    if args.len < 2 {
        fail Usage
    }
    let cmd = args[0]
    let source = args[1]
    if cmd == "asm" || cmd == "ir" || cmd == "build" {
        let opts = parse_options(args[2..], cmd == "build")?
        compile_command(cmd, source, opts)?
        return
    }
    if cmd == "lint" || cmd == "doc" || cmd == "names" {
        let opts = parse_options(args[2..], false)?
        if cmd == "lint" {
            lint_command(source, opts.platform)?
            return
        }
        if cmd == "names" {
            names_command(source, opts.platform)?
            return
        }
        doc_command(source, opts.platform)?
        return
    }
    if cmd == "run" {
        if args.len != 2 {
            fail Usage
        }
        build_and_run(source)?
        return
    }
    if cmd == "dev" {
        if args.len != 2 {
            fail Usage
        }
        dev_command(source)?
        return
    }
    fail Usage
}

fn parse_options(args: []str, output: bool) -> Options ! Error {
    var opts = Options { platform: target.host() }
    var rest = args
    for rest.len > 0 {
        if rest.len < 2 {
            fail Usage
        }
        if rest[0] == "-o" && output {
            opts.output = rest[1]
        } else if rest[0] == "-target" {
            opts.platform = target.parse(rest[1]) catch Target
        } else {
            fail Usage
        }
        rest = rest[2..]
    }
    opts
}

fn lint_command(source: str, platform: target.OS) ! Error {
    let docs = native.overlay()
    let unit = compiler.check(source, platform, docs) catch Front
    report(unit)
    if unit.warnings.len > 0 {
        fail Exit(1)
    }
}

fn report(unit: *compiler.Unit) {
    var b = builder.builder()
    for w in unit.warnings {
        b.write("{lint.string(w)}\n")
    }
    write_all(2, b.to_bytes())
}

fn analyse(source: str, platform: target.OS) -> *compiler.Unit ! Error {
    let profile = compiler.release(platform)
    let unit = native.analyse(source, profile) catch Compile
    report(unit)
    unit
}

fn compile_command(cmd: str, source: str, opts: Options) ! Error {
    let unit = analyse(source, opts.platform)?
    if cmd == "ir" {
        let program = unit.program ?? panic("unit without a program")
        var out = builder.builder()
        for f in program.funcs {
            ir.write_func(mut out, f)
        }
        write_all(1, out.to_bytes())
        return
    }
    if cmd == "asm" {
        let generated = native.generate(unit) catch Compile
        write_all(1, bytes(generated.asm))
        return
    }
    var output = opts.output
    if output == "" {
        output = default_output(source, opts.platform)
    }
    native.build(unit, output) catch Compile
}

fn default_output(source: str, platform: target.OS) -> str {
    let name = text.trim_suffix(path.base(source), path.ext(source))
    target.executable(platform, name)
}

fn build_and_run(source: str) ! Error {
    let dir = file.temp_dir("low-run-") catch {
        e => fail Failed("create temporary directory: {e}")
    }
    let status = run_built(dir, source) catch {
        e => {
            remove_directory(dir)
            fail e
        }
    }
    remove_directory(dir)
    if status != 0 {
        fail Exit(status)
    }
}

fn remove_directory(dir: str) {
    file.remove_all(dir) catch {
        _ => {}
    }
}

fn run_built(dir: str, source: str) -> i64 ! Error {
    let platform = target.host()
    let binary = path.join([dir, target.executable(platform, "main")])
    let unit = analyse(source, platform)?
    native.build(unit, binary) catch Compile
    let command = process.command(binary, [])
    using child = process.start(command) catch {
        e => fail Failed("start {binary}: {e}")
    }
    let exit = process.wait(child) catch {
        e => fail Failed("wait {binary}: {e}")
    }
    match exit {
        Exited(code) => code
        Signaled(_) => -1
    }
}
