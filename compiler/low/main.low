import compiler
import fetch
import ir
import resource
import lint
import lsp
import native
import parallel
import target
import timeline
import wasm
import std/buildinfo
import std/builder
import std/file
import std/os
import std/path
import std/process
import std/sys
import std/text
import std/time/calendar

enum Error {
    Usage
    Compile(native.Error)
    Front(compiler.Error)
    Target(target.ParseError)
    Fetch(fetch.Error)
    Failed(msg: str)
    Exit(code: i64)
}

struct Options {
    output: str = ""
    platform: target.OS
    optimise: bool = true
    gui: bool = false
    trace: str = ""
    map: str = ""
    icon: str = ""
    app_manifest: str = ""
    resources: resource.Resources = resource.Resources {}
}

struct Tracing {
    jobs: ir.Runner
    finish: fn() ! Error
}

fn usage() -> str {
    let choices = target.choices()
    var b = builder.builder()
    b.write("usage:\n")
    b.write("  low build [-o output] [-target {choices}] [-subsystem console|gui] [-icon file.ico] [-manifest file.manifest] [-c release|debug] [-trace file.json] [-map file] [file.low|dir]\n")
    b.write("  low run [-target {target.string(target.host())}|{target.string(target.OS.Browser)}] [-c release|debug] [-trace file.json] [file.low|dir] [args...]\n")
    b.write("  low test [dir|dir/...|std/module|std/...|file_test.low:line]... [-run text] [-skip text] [-list] [-v] [-notime] [-count n] [-shuffle seed] [-failfast] [-json] [-timeout ms] [-jobs n] [-update] [-nocache]\n")
    b.write("  low install [-c release|debug] [file.low|dir]...\n")
    b.write("  low update [dir]\n")
    b.write("  low asm <file.low> [-target {choices}] [-trace file.json]\n")
    b.write("  low ir <file.low> [-target {choices}] [-trace file.json]\n")
    b.write("  low lint <file.low> [-target {choices}]\n")
    b.write("  low doc <dir|std> [-target {choices}]\n")
    b.write("  low names <file.low> [-target {choices}]\n")
    b.write("  low dev <file.low>\n")
    b.write("  low lsp\n")
    b.write("  low version")
    b.to_str()
}

fn version() -> str {
    let release = text.trim(embed("version.txt"))
    if release != "dev" || buildinfo.revision.len < 12 {
        return release
    }
    let commit = buildinfo.revision[..12]
    let built = built_at(buildinfo.time)
    "dev+{commit} ~ {built}"
}

fn built_at(seconds: i64) -> str {
    let date = calendar.civil_from_days(seconds / 86400)
    let minutes = seconds % 86400 / 60
    let hour = minutes / 60
    let minute = minutes % 60
    "{date.year:d4}/{date.month:d2}/{date.day:d2} {hour:d2}:{minute:d2}"
}

fn main() {
    run(os.args()[1..]) catch {
        Exit(code) => os.exit(code)
        e => exit_with(e)
    }
}

fn exit_with(e: Error) {
    let line = describe(e)
    write_all(2, bytes("{line}\n"))
    os.exit(1)
}

fn describe(e: Error) -> str {
    match e {
        Usage => usage()
        Compile(inner) => native.message(inner)
        Front(inner) => compiler.message(inner)
        Target(inner) => target.message(inner)
        Fetch(inner) => fetch.message(inner)
        Failed(msg) => msg
        Exit(code) => "exit status {code}"
    }
}

fn write_all(fd: i64, data: []u8) {
    var rest = data
    for rest.len > 0 {
        let n = sys.try_write(fd, rest) or return
        rest = rest[n..]
    }
}

fn run(args: []str) ! Error {
    if args.len == 1 && args[0] == "lsp" {
        let docs = native.overlay()
        docs.disk.stamp = compiler.unstamped
        lsp.serve_stdio(docs) catch {
            e => fail Error.Failed(lsp.serve_message(e))
        }
        return
    }
    if args.len >= 1 && args[0] == "install" {
        install_command(args[1..])?
        return
    }
    if args.len >= 1 && args[0] == "update" {
        update_command(args[1..])?
        return
    }
    if args.len == 1 && args[0] == "version" {
        write_all(1, bytes("{version()}\n"))
        return
    }
    if args.len >= 1 && args[0] == "test" {
        test_command(args[1..])?
        return
    }
    if args.len >= 1 && args[0] == "build" {
        let targets = split_targets(args[1..])
        if targets.paths.len > 1 {
            fail Failed("low build takes one program; low install takes several")
        }
        let opts = parse_options(targets.options, true, true)?
        build_command(targets.paths[0], opts)?
        return
    }
    if args.len >= 1 && args[0] == "run" {
        let split = split_arguments(args[1..])
        let opts = parse_options(split.options, false, true)?
        build_and_run(split.source, opts, split.program)?
        return
    }
    if args.len < 2 {
        fail Usage
    }
    let cmd = args[0]
    let source = args[1]
    if cmd == "asm" || cmd == "ir" {
        let opts = parse_options(args[2..], false, true)?
        compile_command(cmd, source, opts)?
        return
    }
    if cmd == "lint" || cmd == "doc" || cmd == "names" {
        let opts = parse_options(args[2..], false, false)?
        if cmd == "lint" {
            lint_command(source, opts.platform)?
            return
        }
        if cmd == "names" {
            names_command(source, opts.platform)?
            return
        }
        doc_command(source, opts.platform)?
        return
    }
    if cmd == "dev" {
        if args.len != 2 {
            fail Usage
        }
        dev_command(source)?
        return
    }
    fail Usage
}

struct RunArguments {
    options: []str
    source: str
    program: []str
}

fn split_arguments(args: []str) -> RunArguments {
    var i = 0
    for i + 1 < args.len && text.starts_with(args[i], "-") {
        i += 2
    }
    if i >= args.len {
        return RunArguments { options: args, source: ".", program: [] }
    }
    RunArguments { options: args[..i], source: args[i], program: args[i + 1..] }
}

fn parse_options(args: []str, build: bool, compiles: bool) -> Options ! Error {
    var opts = Options { platform: target.host() }
    var subsystem = ""
    var rest = args
    for rest.len > 0 {
        if rest.len < 2 {
            fail Usage
        }
        if rest[0] == "-o" && build {
            opts.output = rest[1]
        } else if rest[0] == "-subsystem" && build {
            subsystem = rest[1]
        } else if rest[0] == "-icon" && build {
            opts.icon = rest[1]
        } else if rest[0] == "-manifest" && build {
            opts.app_manifest = rest[1]
        } else if rest[0] == "-target" {
            opts.platform = target.parse(rest[1]) catch Target
        } else if rest[0] == "-c" {
            opts.optimise = configuration(rest[1])?
        } else if rest[0] == "-map" && build {
            opts.map = rest[1]
        } else if rest[0] == "-trace" && compiles {
            opts.trace = rest[1]
        } else {
            fail Usage
        }
        rest = rest[2..]
    }
    opts.gui = parse_subsystem(subsystem, opts.platform)?
    opts
}

fn parse_subsystem(name: str, platform: target.OS) -> bool ! Error {
    if name == "" {
        return false
    }
    if name != "console" && name != "gui" {
        fail Failed("unknown subsystem {name}, expected console or gui")
    }
    if platform != target.OS.Windows {
        fail Failed("-subsystem applies only to the windows/amd64 target")
    }
    name == "gui"
}

fn lint_command(source: str, platform: target.OS) ! Error {
    let docs = native.overlay()
    let unit = compiler.check_library(source, platform, docs) catch Front
    report(unit)
    if unit.warnings.len > 0 {
        fail Exit(1)
    }
}

fn report(unit: *compiler.Unit) {
    var b = builder.builder()
    for w in unit.warnings {
        b.write("{lint.string(w)}\n")
    }
    write_all(2, b.to_bytes())
}

fn configuration(name: str) -> bool ! Error {
    match name {
        "release" => true
        "debug" => false
        _ => fail Failed("unknown configuration {name}; use release or debug")
    }
}

fn tracing(path: str) -> Tracing {
    if path == "" {
        return Tracing { jobs: native.runner(), finish: untraced }
    }
    let trace = parallel.new_trace()
    let finish = fn() ! Error {
        write_trace(trace, path)?
    }
    Tracing { jobs: native.traced(trace), finish }
}

fn untraced() ! Error {}

fn write_trace(trace: *parallel.Trace, path: str) ! Error {
    parallel.finish(trace)
    let json = timeline.chrome(trace)
    file.write_file(path, bytes(json)) catch {
        e => fail Failed("write {path}: {e}")
    }
    let summary = timeline.summary(trace)
    write_all(2, bytes(summary))
}

fn analyse(source: str, opts: Options, jobs: ir.Runner) -> *compiler.Unit ! Error {
    let profile = compiler.Profile { platform: opts.platform, optimise: opts.optimise, gui: opts.gui, symbols: opts.map != "", resources: opts.resources }
    let unit = native.analyse_flat(source, profile, jobs) catch Compile
    report(unit)
    unit
}

fn compile_command(cmd: str, source: str, opts: Options) ! Error {
    let traced = tracing(opts.trace)
    inspect_command(cmd, source, opts, traced.jobs)?
    let finish = traced.finish
    finish()?
}

fn inspect_command(cmd: str, source: str, opts: Options, jobs: ir.Runner) ! Error {
    let unit = analyse(source, opts, jobs)?
    if cmd == "ir" {
        let program = unit.program ?? panic("unit without a program")
        ir.materialise(program, jobs)
        var out = builder.builder()
        for f in program.funcs {
            ir.write_func(mut out, f)
        }
        write_all(1, out.to_bytes())
        return
    }
    if cmd == "asm" {
        let generated = native.generate(unit) catch Compile
        write_all(1, bytes(generated.asm))
    }
}

fn build_command(source: str, opts: Options) ! Error {
    var output = opts.output
    let slashed = text.ends_with(output, "/") || text.ends_with(output, "\\")
    if slashed {
        file.mkdir_all(output) catch {
            e => fail Failed("create {output}: {e}")
        }
    }
    if output == "" || slashed || file.is_dir(output) {
        let name = program_name(source, opts.platform)?
        output = file.child_path(output, name)
    }
    let traced = tracing(opts.trace)
    let builds = [Build { program: source, output }]
    build_programs(builds, opts, traced.jobs)?
    let finish = traced.finish
    finish()?
}

fn default_output(source: str, platform: target.OS) -> str {
    let name = text.trim_suffix(path.base(source), path.ext(source))
    target.executable(platform, name)
}

fn build_and_run(source: str, opts: Options, program_args: []str) ! Error {
    let host = target.host()
    if opts.platform != host && target.native(opts.platform) {
        fail Failed("cannot run {target.string(opts.platform)} programs on {target.string(host)}")
    }
    let dir = scratch_directory("low-run-")?
    defer remove_directory(dir)
    let status = run_built(dir, source, opts, program_args)?
    if status != 0 {
        fail Exit(status)
    }
}

fn scratch_directory(prefix: str) -> str ! Error {
    file.temp_dir(prefix) catch {
        e => fail Failed("create temporary directory: {e}")
    }
}

fn remove_directory(dir: str) {
    file.remove_all(dir) catch {
        _ => {}
    }
}

fn run_built(dir: str, source: str, opts: Options, program_args: []str) -> i64 ! Error {
    let binary = path.join([dir, target.executable(opts.platform, "main")])
    let traced = tracing(opts.trace)
    let builds = [Build { program: source, output: binary }]
    build_programs(builds, opts, traced.jobs)?
    let finish = traced.finish
    finish()?
    let command = runner(dir, binary, opts.platform, program_args)?
    using child = process.start(command) catch {
        e => fail Failed("start {command.program}: {e}")
    }
    let exit = process.wait(child) catch {
        e => fail Failed("wait {command.program}: {e}")
    }
    match exit {
        Exited(code) => code
        Signaled(_) => -1
    }
}

fn runner(dir: str, binary: str, platform: target.OS, program_args: []str) -> process.Command ! Error {
    if target.native(platform) {
        return process.command(binary, program_args)
    }
    let script = path.join([dir, "host.mjs"])
    let source = wasm.host_script()
    file.write_file(script, bytes(source)) catch {
        e => fail Failed("write {script}: {e}")
    }
    var node_args = [script, binary]
    for arg in program_args {
        node_args.push(arg)
    }
    process.command("node", node_args)
}
