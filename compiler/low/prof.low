import prof

const default_interval = 1
const default_depth = 64
const default_top = 40
const default_event = "cycles"

const prof_about = "Runs a program and reports where its cycles, or the events of --event, go by category, by function and by function with its callees; a Linux program is sampled with every process it starts and named from its own symbols, and a Windows program needs the map of 'low build --map'. Options end at the program, and every argument after it goes to the program."

fn prof_option_table() -> []Option {
    [
        Option { name: "map", hint: "file", help: "The symbol map that 'low build --map' wrote for a Windows program, which needs it" }
        Option { name: "event", hint: "name", help: "What to sample: cycles, instructions, cache-misses, branch-misses, cpu-clock, faults or switches; a Windows program is sampled by cycles", fallback: default_event }
        Option { name: "interval", hint: "ms", help: "Milliseconds between samples", fallback: "{default_interval}" }
        Option { name: "depth", hint: "n", help: "Most callers recorded per sample", fallback: "{default_depth}" }
        Option { name: "top", hint: "n", help: "Functions listed in each table", fallback: "{default_top}" }
        Option { name: "folded", hint: "file", help: "Write the folded stacks to this file, one per line with its weight" }
        Option { name: "callers", hint: "function", help: "Also list the call chains that reach this function" }
    ]
}

fn symbol_map(p: Parsed) -> str ! Error {
    if prof.needs_map || given(p, "map") != none {
        return required(p, "map")
    }
    ""
}

fn prof_main(p: Parsed) ! Error {
    let config = prof.Config {
        map: symbol_map(p)?
        event: given_or(p, "event", default_event)
        interval_ms: at_least(p, "interval", default_interval, 1)?
        depth: at_least(p, "depth", default_depth, 0)?
        top: at_least(p, "top", default_top, 1)?
        folded: given_or(p, "folded", "")
        callers: given_or(p, "callers", "")
        command: p.operands
        note: note_stderr
    }
    let profile = prof.run(config) catch {
        Failed(message) => fail Error.Failed("low prof: {message}")
    }
    write_all(1, bytes(profile))
}
