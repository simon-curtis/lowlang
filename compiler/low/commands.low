import compiler
import diag
import lsp
import native
import target
import std/slices
import std/text

const default_config = "release"
const program_operands = "[file.low|dir]"

fn commands() -> []Command {
    [
        define("build", "Compile a program to an executable", program_operands, build_about, [output_option(), target_option(), subsystem_option(), config_option(), map_option(), trace_option(), json_option(), max_errors_option()], 0, 1, build_main)
        stopping(define("run", "Compile and run a program", "{program_operands} [args...]", run_about, [run_target_option(), config_option(), trace_option(), json_option(), max_errors_option()], 0, unlimited, run_main))
        define("test", "Build and run the tests of modules", test_operands, test_about, test_option_table(), 0, unlimited, test_main)
        define("install", "Build programs and install their executables", "{program_operands}...", install_about, [host_target_option(), config_option()], 0, unlimited, install_main)
        define("update", "Fetch the newest versions of the dependencies", "[dir]", update_about, [], 0, 1, update_main)
        define("publish", "Add a tagged version to the package index", "<source> <version>", publish_about, [], 2, 2, publish_main)
        define("yank", "Withdraw a version of a package from new resolutions", "<source> <version>", yank_about, [undo_option()], 2, 2, yank_main)
        define("asm", "Print the assembly of a program", "<file.low>", "Prints the assembly that a program compiles to.", [target_option(), config_option(), trace_option(), json_option(), max_errors_option()], 1, 1, asm_main)
        define("ir", "Print the optimised SSA form of a program", "<file.low>", "Prints the optimised SSA form that a program compiles to.", [target_option(), config_option(), trace_option(), json_option(), max_errors_option()], 1, 1, ir_main)
        define("lint", "Type-check a program and print its warnings", "<file.low|dir>", lint_about, [target_option(), json_option(), max_errors_option()], 1, 1, lint_main)
        define("fix", "Apply the safe fixes of errors and warnings", "[file.low|dir]...", fix_about, [target_option(), dry_run_option()], 0, unlimited, fix_main)
        define("doc", "Print the public API of modules as JSON", "<dir|std|index>", "Prints the public API of every module under a directory, of the standard library for std, or of every version of every package in the package index that LOW_INDEX names for index, as JSON.", [target_option()], 1, 1, doc_main)
        define("explain", "Print the meaning of a diagnostic code", "<code>", explain_about, [], 1, 1, explain_main)
        define("names", "Print every name in a file as JSON", "<file.low>", "Prints every name in a file as JSON, with its hover text, its definition and the other names that refer to the same definition.", [target_option()], 1, 1, names_main)
        define("dev", "Run a program and patch it on save", "<file.low>", dev_about, [], 1, 1, dev_main)
        stopping(define("prof", "Report where a program spends its cycles, memory growth or waits", "<program> [args...]", prof_about, prof_option_table(), 1, unlimited, prof_main))
        stopping(define("abbench", "Compare two programs on one command", "<command> [args...]", abbench_about, abbench_option_table(), 1, unlimited, abbench_main))
        define("protogen", "Generate Low modules from .proto files", "<file.proto>...", protogen_about, protogen_option_table(), 1, unlimited, protogen_main)
        define("lsp", "Serve the language server protocol", "", "Serves the language server protocol on standard input and output for the editor extensions.", [], 0, 0, lsp_main)
        define("version", "Print the version", "", "Prints the release, or for a build from source the commit and the build time.", [], 0, 0, version_main)
        define("help", "Show the help of a command", "[command]", "Shows the options of a command, or the list of commands when none is named.", [], 0, 1, help_main)
    ]
}

fn root_command() -> Command {
    let version_option = Option { name: "version", letter: "V", help: "Print the version" }
    Command { name: "", summary: "", operands: "<command>", about: "", options: [help_option(), version_option], least: 0, most: unlimited, stops: true, execute: dispatch }
}

fn find_command(name: str) -> Command? {
    for c in commands() {
        if c.name == name {
            return c
        }
    }
    none
}

fn define(name: str, summary: str, operands: str, about: str, options: []Option, least: i64, most: i64, execute: fn(Parsed) ! Error) -> Command {
    let all = slices.concat(options, [help_option()])
    Command { name, summary, operands, about, options: all, least, most, stops: false, execute }
}

fn stopping(c: Command) -> Command {
    var spec = c
    spec.stops = true
    spec
}

fn alternatives(names: []str) -> str {
    let last = names.len - 1
    let head = text.join(names[..last], ", ")
    "{head} or {names[last]}"
}

fn output_option() -> Option {
    Option { name: "output", letter: "o", hint: "path", help: "Write the executable here; a directory keeps the default name" }
}

fn json_option() -> Option {
    Option { name: "json", help: "Write each error and warning as one JSON object per line" }
}

fn target_option() -> Option {
    Option { name: "target", hint: "os/arch", help: alternatives(target.names()), fallback: "the host" }
}

fn runs_here(platform: target.OS) -> bool {
    platform == target.host() || !target.native(platform)
}

fn runnable_names() -> []str {
    var names: []str = []
    for platform in target.all() {
        if runs_here(platform) {
            names.push(target.string(platform))
        }
    }
    names
}

fn run_target_option() -> Option {
    Option { name: "target", hint: "os/arch", help: alternatives(runnable_names()), fallback: "the host" }
}

fn host_target_option() -> Option {
    Option { name: "target", hint: "os/arch", help: "{target.string(target.host())} only" }
}

fn subsystem_option() -> Option {
    Option { name: "subsystem", hint: "name", help: "console or gui; Windows only", fallback: "the build.low declaration, else console" }
}

fn config_option() -> Option {
    Option { name: "config", letter: "c", hint: "name", help: "release or debug", fallback: default_config }
}

fn undo_option() -> Option {
    Option { name: "undo", help: "Make the version available again" }
}

fn map_option() -> Option {
    Option { name: "map", hint: "file", help: "Write every symbol with its address to this file" }
}

fn dry_run_option() -> Option {
    Option { name: "dry-run", help: "Print the changes as a unified diff and write nothing" }
}

fn max_errors_option() -> Option {
    Option { name: "max-errors", hint: "n", help: "Stop checking after this many errors", fallback: "{diag.error_limit}" }
}

fn trace_option() -> Option {
    Option { name: "trace", hint: "file.json", help: "Write a Chrome trace of the compilation to this file and a timing summary to standard error" }
}

const build_about = "Compiles a program, a file or a module directory, to a native executable, or to a WebAssembly module for browser/wasm32, and runs the build hooks of a project around the build. With no operand it takes the current directory when that holds sources, else the one program that build.low declares; the executable is named after the program and written to the current directory."

const run_about = "Compiles a program and runs it, under node for browser/wasm32; with no operand it takes the current directory when that holds sources, else the one program that build.low declares. Options end at the program, and every argument after it goes to the program."

const test_operands = "[module|dir/...|file_test.low:line]..."

const test_about = "Builds the tests of each module and runs every test in its own process, in parallel, with a timeout. A module is a directory, looked up below the project's modules directory when the current directory has no such path, std/module or file_test.low:line for the test at that line, and dir/... or std/... names every module below it that has tests."

const install_about = "Builds each program and places its executable in the LOW_BIN directory, named as low build names it. With no operand it installs the current directory when that holds sources, else every program that build.low declares."

const explain_about = "Prints the severity, meaning and an example of the diagnostic code that ends an error or warning in brackets, such as break-outside."

const update_about = "Resolves the version-control dependencies of a project again to the newest versions their ranges accept, fetches them into the module cache and rewrites build.lock."

const publish_about = "Adds a tagged version of a package to the package index that LOW_INDEX names and commits it there. The tag is read from https://<source>, its tree must resolve and type-check, and a version already listed is never changed."

const yank_about = "Marks a version of a package in the package index as yanked, so new resolutions skip it and a build.lock that holds it warns, or with --undo as available again. Only the flag of its line changes."

const fix_about = "Type-checks each program or library module, the current directory when none is named, and applies the safe fixes of its errors and warnings, checking again until none is left. The standard library and fetched dependencies never change."

const lint_about = "Type-checks a program or a library module and prints its warnings. The exit status is 1 when there are any."

const dev_about = "Runs a program and patches changed functions into it on save. Changing main, the layout of a type or the signature of a function restarts it."

fn compile_options(p: Parsed) -> Options ! Error {
    let platform = platform_option(p)?
    Options {
        output: given_or(p, "output", "")
        platform
        optimise: configuration(p)?
        subsystem: chosen_subsystem(p, platform)?
        trace: given_or(p, "trace", "")
        map: given_or(p, "map", "")
        json: is_set(p, "json")
        max_errors: at_least(p, "max-errors", diag.error_limit, 1)?
    }
}

fn platform_option(p: Parsed) -> target.OS ! Error {
    match given(p, "target") {
        some(named) => target.parse(named) catch {
            e => fail usage_error(p, target.message(e))
        }
        none => target.host()
    }
}

fn configuration(p: Parsed) -> bool ! Error {
    let name = given_or(p, "config", default_config)
    match name {
        "release" => true
        "debug" => false
        _ => fail usage_error(p, "unknown configuration '{name}'; use release or debug")
    }
}

fn chosen_subsystem(p: Parsed, platform: target.OS) -> Subsystem ! Error {
    let name = given(p, "subsystem") ?? return Subsystem.Declared
    let chosen = match name {
        "console" => Subsystem.Console
        "gui" => Subsystem.Gui
        _ => fail usage_error(p, "unknown subsystem '{name}'; use console or gui")
    }
    if platform != target.OS.Windows {
        fail option_error(p.command, "subsystem", "applies only to the windows/amd64 target")
    }
    chosen
}

fn build_main(p: Parsed) ! Error {
    let opts = compile_options(p)?
    let sources = default_sources(p.operands, opts.platform, p.command, false)?
    build_command(sources[0], opts) catch {
        e => fail diagnosed(opts.json, e)
    }
}

fn run_main(p: Parsed) ! Error {
    let opts = compile_options(p)?
    let sources = default_sources(p.operands, opts.platform, p.command, false)?
    build_and_run(sources[0], opts, operands_from(p, 1)) catch {
        e => fail diagnosed(opts.json, e)
    }
}

fn test_main(p: Parsed) ! Error {
    let options = parse_test_options(p)?
    test_command(options)?
}

fn install_main(p: Parsed) ! Error {
    let opts = compile_options(p)?
    if opts.platform != target.host() {
        fail option_error(p.command, "target", "must be {target.string(target.host())}")
    }
    let programs = default_sources(p.operands, opts.platform, p.command, true)?
    install_command(programs, opts)?
}

fn update_main(p: Parsed) ! Error {
    update_command(operand_or(p, 0, "."))?
}

fn publish_main(p: Parsed) ! Error {
    publish_command(p.operands[0], p.operands[1])?
}

fn yank_main(p: Parsed) ! Error {
    yank_command(p.operands[0], p.operands[1], is_set(p, "undo"))?
}

fn asm_main(p: Parsed) ! Error {
    let opts = compile_options(p)?
    compile_command("asm", p.operands[0], opts) catch {
        e => fail diagnosed(opts.json, e)
    }
}

fn ir_main(p: Parsed) ! Error {
    let opts = compile_options(p)?
    compile_command("ir", p.operands[0], opts) catch {
        e => fail diagnosed(opts.json, e)
    }
}

fn lint_main(p: Parsed) ! Error {
    let json = is_set(p, "json")
    lint_command(p.operands[0], platform_option(p)?, json, at_least(p, "max-errors", diag.error_limit, 1)?) catch {
        e => fail diagnosed(json, e)
    }
}

fn fix_main(p: Parsed) ! Error {
    var paths = p.operands
    if paths.len == 0 {
        paths = ["."]
    }
    fix_command(paths, platform_option(p)?, is_set(p, "dry-run"))?
}

fn doc_main(p: Parsed) ! Error {
    doc_command(p.operands[0], platform_option(p)?)?
}

fn names_main(p: Parsed) ! Error {
    names_command(p.operands[0], platform_option(p)?)?
}

fn dev_main(p: Parsed) ! Error {
    dev_command(p.operands[0])?
}

fn lsp_main(p: Parsed) ! Error {
    let docs = native.overlay()
    docs.disk.stamp = compiler.unstamped
    lsp.serve_stdio(docs) catch {
        e => fail Error.Failed(lsp.serve_message(e))
    }
}

fn explain_main(p: Parsed) ! Error {
    let name = p.operands[0]
    let code = diag.lookup(name) ?? fail usage_error(p, "unknown diagnostic code '{name}'")
    write_all(1, bytes("{code.name} ({diag.severity_text(code.severity)})\n{code.meaning}\nExample: {code.example}\n"))
}

fn version_main(p: Parsed) ! Error {
    write_all(1, bytes("{version()}\n"))
}

fn help_main(p: Parsed) ! Error {
    if p.operands.len == 0 {
        write_help(1, top_help())
        return
    }
    let name = p.operands[0]
    let spec = find_command(name) ?? fail Error.Usage("", "unknown command '{name}'")
    write_help(1, command_help(spec))
}

fn dispatch(p: Parsed) ! Error {
    if is_set(p, "version") {
        run_command(p, "version", p.operands)?
        return
    }
    if is_set(p, "help") || p.operands.len == 0 {
        write_help(1, top_help())
        return
    }
    run_command(p, p.operands[0], p.operands[1..])?
}

fn run_command(p: Parsed, name: str, args: []str) ! Error {
    let spec = find_command(name) ?? fail usage_error(p, "unknown command '{name}'")
    let parsed = parse_command(spec, args)?
    if is_set(parsed, "help") {
        write_help(1, command_help(spec))
        return
    }
    let execute = spec.execute
    execute(parsed)?
}
