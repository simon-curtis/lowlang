import std/builder
import std/text

const diff_context = 3

struct DiffLine {
    mark: u8
    text: str
    old_line: i64
    new_line: i64
}

fn unified_diff(name: str, before: str, after: str) -> str {
    let ops = line_ops(lines_of(before), lines_of(after))
    var b = builder.builder()
    b.write("--- a/{name}\n+++ b/{name}\n")
    var i = 0
    for i < ops.len {
        if ops[i].mark == ' ' {
            i += 1
            continue
        }
        let first = if i > diff_context { i - diff_context } else { 0 }
        var last = i
        var j = i
        for j < ops.len && j <= last + 2 * diff_context {
            if ops[j].mark != ' ' {
                last = j
            }
            j += 1
        }
        let end = if last + diff_context + 1 < ops.len { last + diff_context + 1 } else { ops.len }
        b.write(hunk(ops[first..end]))
        i = end
    }
    b.to_str()
}

fn lines_of(s: str) -> []str {
    if text.ends_with(s, "\n") {
        return text.split(s[..s.len - 1], '\n')
    }
    text.split(s, '\n')
}

fn hunk(ops: []DiffLine) -> str {
    var old_count = 0
    var new_count = 0
    var old_start = 0
    var new_start = 0
    for op in ops {
        if op.mark != '+' {
            if old_count == 0 {
                old_start = op.old_line
            }
            old_count += 1
        }
        if op.mark != '-' {
            if new_count == 0 {
                new_start = op.new_line
            }
            new_count += 1
        }
    }
    var b = builder.builder()
    b.write("@@ -{range_text(old_start, old_count, ops[0].old_line)} +{range_text(new_start, new_count, ops[0].new_line)} @@\n")
    for op in ops {
        b.write_byte(op.mark)
        b.write("{op.text}\n")
    }
    b.to_str()
}

fn range_text(start: i64, count: i64, before: i64) -> str {
    if count == 0 {
        return "{before - 1},0"
    }
    "{start},{count}"
}

fn line_ops(old: []str, new: []str) -> []DiffLine {
    var prefix = 0
    for prefix < old.len && prefix < new.len && old[prefix] == new[prefix] {
        prefix += 1
    }
    var suffix = 0
    for suffix < old.len - prefix && suffix < new.len - prefix && old[old.len - 1 - suffix] == new[new.len - 1 - suffix] {
        suffix += 1
    }
    let a = old[prefix..old.len - suffix]
    let c = new[prefix..new.len - suffix]
    let width = c.len + 1
    var lengths: []i64 = []
    for _ in 0..(a.len + 1) * width {
        lengths.push(0)
    }
    var x = a.len - 1
    for x >= 0 {
        var y = c.len - 1
        for y >= 0 {
            lengths[x * width + y] = if a[x] == c[y] { lengths[(x + 1) * width + y + 1] + 1 } else if lengths[(x + 1) * width + y] >= lengths[x * width + y + 1] { lengths[(x + 1) * width + y] } else { lengths[x * width + y + 1] }
            y -= 1
        }
        x -= 1
    }
    var ops: []DiffLine = []
    for k in 0..prefix {
        ops.push(DiffLine { mark: ' ', text: old[k], old_line: k + 1, new_line: k + 1 })
    }
    var i = 0
    var j = 0
    for i < a.len || j < c.len {
        if i < a.len && j < c.len && a[i] == c[j] {
            ops.push(DiffLine { mark: ' ', text: a[i], old_line: prefix + i + 1, new_line: prefix + j + 1 })
            i += 1
            j += 1
        } else if i < a.len && (j == c.len || lengths[(i + 1) * width + j] >= lengths[i * width + j + 1]) {
            ops.push(DiffLine { mark: '-', text: a[i], old_line: prefix + i + 1, new_line: prefix + j + 1 })
            i += 1
        } else {
            ops.push(DiffLine { mark: '+', text: c[j], old_line: prefix + i + 1, new_line: prefix + j + 1 })
            j += 1
        }
    }
    for k in 0..suffix {
        let at_old = old.len - suffix + k
        let at_new = new.len - suffix + k
        ops.push(DiffLine { mark: ' ', text: old[at_old], old_line: at_old + 1, new_line: at_new + 1 })
    }
    ops
}
