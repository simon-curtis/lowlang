import abbench
import std/text

const default_runs = 15
const default_warmup = 1

const abbench_about = "Runs a command with each of two programs, alternating the order, and reports the paired ratios of wall time, CPU time, cycles, instructions and peak memory, leaving out what the host does not count. In the command, {{exe}} is the program of each side and {{side}} is a or b, and options end at the command."

fn abbench_option_table() -> []Option {
    [
        Option { name: "a", letter: "a", hint: "program", help: "The program that replaces {{exe}} on side a; required" }
        Option { name: "b", letter: "b", hint: "program", help: "The program that replaces {{exe}} on side b; required" }
        Option { name: "runs", hint: "n", help: "Timed runs of each side, at least 5", fallback: "{default_runs}" }
        Option { name: "warmup", hint: "n", help: "Untimed runs of each side before the timed runs", fallback: "{default_warmup}" }
        Option { name: "affinity", hint: "mask", help: "Hexadecimal mask of the CPUs every run may use" }
        Option { name: "dir", hint: "path", help: "The directory the command runs in" }
        Option { name: "same", hint: "file", help: "A file the command writes, with {{side}} in its path and relative to --dir, that must be byte-identical on both sides" }
    ]
}

fn affinity_mask(p: Parsed) -> u64? ! Error {
    let raw = given(p, "affinity") ?? return none
    let digits = text.trim_prefix(text.trim_prefix(raw, "0x"), "0X")
    let mask = text.parse_u64(digits, 16) or fail invalid_value(p.command, "affinity", raw)
    if mask == 0 {
        fail invalid_value(p.command, "affinity", raw)
    }
    some(mask)
}

fn abbench_main(p: Parsed) ! Error {
    let config = abbench.Config {
        a: required(p, "a")?
        b: required(p, "b")?
        runs: at_least(p, "runs", default_runs, 5)?
        warmup: at_least(p, "warmup", default_warmup, 0)?
        affinity: affinity_mask(p)?
        dir: given_or(p, "dir", "")
        same: given_or(p, "same", "")
        command: p.operands
        note: note_stderr
    }
    let comparison = abbench.run(config) catch {
        Failed(message) => fail Error.Failed("low abbench: {message}")
    }
    write_all(1, bytes(comparison))
}
