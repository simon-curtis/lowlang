import protogen
import std/text

const default_include = "."

const protogen_about = "Generates one Low module for each .proto file with std/protobuf/proto, and for each file it imports, under the output directory. A file is read from the first include directory that holds it."

fn protogen_option_table() -> []Option {
    [
        Option { name: "include", letter: "I", hint: "dir,...", help: "Comma-separated directories that imports are resolved against", fallback: default_include }
        Option { name: "module", hint: "path", help: "Import path of the output directory, when it is not the project root" }
        Option { name: "output", letter: "o", hint: "dir", help: "Directory the generated modules are written to; required" }
    ]
}

fn protogen_main(p: Parsed) ! Error {
    let config = protogen.Config {
        files: p.operands
        roots: text.split(given_or(p, "include", default_include), ',')
        output: required(p, "output")?
        module: given_or(p, "module", "")
    }
    protogen.run(config) catch {
        Failed(message) => fail Error.Failed("low protogen: {message}")
    }
}
