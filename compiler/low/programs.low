import compiler
import diag
import ir
import link
import native
import target
import std/builder
import std/file
import std/slices
import std/text

struct Build {
    program: str
    output: str
}

fn default_sources(given: []str, platform: target.OS, command: str, several: bool) -> []str ! Error {
    if given.len > 0 {
        return given
    }
    let docs = native.overlay()
    let here = compiler.absolute_path(docs, ".") catch Front
    let holds = compiler.holds_sources(docs, here, platform) catch Front
    if holds {
        return ["."]
    }
    let declared = declared_programs(docs, here)?
    var paths: []str = []
    var names: []str = []
    for p in declared.programs {
        paths.push(p.dir)
        names.push(text.trim_prefix(p.dir, "{declared.root}/"))
    }
    if paths.len == 0 {
        return ["."]
    }
    if !several && paths.len > 1 {
        let listed = text.join(names, ", ")
        fail Failed("low {command} takes one program and this project declares {listed}; name one")
    }
    paths
}

fn windowed(program: str, opts: Options) -> bool ! Error {
    if opts.subsystem != Subsystem.Declared {
        return opts.subsystem == Subsystem.Gui
    }
    let docs = native.overlay()
    let declared = declared_programs(docs, program)?
    if opts.platform != target.OS.Windows {
        return false
    }
    let dir = entry_directory(docs, program)?
    declared.programs.any(fn(p) p.gui && same_directory(docs, p.dir, dir))
}

fn program_icon(program: str, opts: Options) -> []u8 ! Error {
    let icon = declared_icon(native.overlay(), program)? ?? return []
    link.read_icon(icon.data) catch {
        BadIcon(reason) => fail Front(compiler.Error.Diag(diag.Error.At(icon.pos, "icon: {reason}")))
        e => fail Failed(link.message(e))
    }
    if opts.platform != target.OS.Windows {
        return []
    }
    icon.data
}

fn program_name(source: str, platform: target.OS) -> str ! Error {
    let docs = native.overlay()
    let full = compiler.absolute_path(docs, source) catch Front
    default_output(full, platform)
}

struct Placed {
    address: i64
    name: str
}

fn write_map(symbols: [str: i64], output: str) ! Error {
    var placed: []Placed = []
    for name, address in symbols {
        placed.push(Placed { address, name })
    }
    slices.sort_by(mut placed, fn(x, y) x.address < y.address || x.address == y.address && x.name < y.name)
    var out = builder.builder()
    for p in placed {
        if p.address < 0 {
            out.write("-{text.hex(-p.address)} {p.name}\n")
        } else {
            out.write("{text.hex(p.address)} {p.name}\n")
        }
    }
    file.write_file(output, out.to_bytes()) catch {
        e => fail Failed("write {output}: {e}")
    }
}

fn build_programs(builds: []Build, opts: Options, jobs: ir.Runner) ! Error {
    ir.mark(jobs, "hooks.before")
    var projects: []Hooks = []
    var seen: [str: bool] = [:]
    for b in builds {
        let hooks = project_hooks(b.program)?
        if hooks.dir != "" && seen[hooks.dir] == none {
            seen[hooks.dir] = true
            projects.push(hooks)
        }
    }
    for hooks in projects {
        hooks.before()?
    }
    for b in builds {
        let gui = windowed(b.program, opts)?
        let icon = program_icon(b.program, opts)?
        let unit = analyse(b.program, opts, gui, icon, jobs)?
        let built = native.build(unit, b.output) catch Compile
        if opts.map != "" {
            write_map(built.symbols, opts.map)?
        }
    }
    ir.mark(jobs, "hooks.after")
    for hooks in projects {
        hooks.after()?
    }
}
