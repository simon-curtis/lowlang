import compiler
import ir
import native
import target
import std/text

struct Build {
    program: str
    output: str
}

struct Targets {
    paths: []str
    options: []str
}

fn split_targets(args: []str) -> Targets {
    var t = Targets { paths: [], options: [] }
    var i = 0
    for i < args.len {
        if text.starts_with(args[i], "-") && i + 1 < args.len {
            t.options.push(args[i])
            t.options.push(args[i + 1])
            i += 2
            continue
        }
        t.paths.push(args[i])
        i += 1
    }
    if t.paths.len == 0 {
        t.paths.push(".")
    }
    t
}

fn program_name(source: str, platform: target.OS) -> str ! Error {
    let docs = native.overlay()
    let full = compiler.absolute_path(docs, source) catch Front
    default_output(full, platform)
}

fn build_programs(builds: []Build, opts: Options, jobs: ir.Runner) ! Error {
    ir.mark(jobs, "hooks.before")
    var projects: []Hooks = []
    var seen: [str: bool] = [:]
    for b in builds {
        let hooks = project_hooks(b.program)?
        if hooks.dir != "" && seen[hooks.dir] == none {
            seen[hooks.dir] = true
            projects.push(hooks)
        }
    }
    for hooks in projects {
        hooks.before()?
    }
    for b in builds {
        let unit = analyse(b.program, opts, jobs)?
        native.build(unit, b.output) catch Compile
    }
    ir.mark(jobs, "hooks.after")
    for hooks in projects {
        hooks.after()?
    }
}
