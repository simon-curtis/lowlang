import compiler
import native
import std/path

struct Build {
    program: str
    output: str
}

fn declared_programs(dir: str) -> []str? ! Error {
    let docs = native.overlay()
    let full = compiler.absolute_path(docs, dir) catch Front
    let manifest = compiler.project_manifest(docs, full) catch Front
    let m = manifest ?? return none
    if m.installs.len == 0 {
        return none
    }
    var programs: []str = []
    var named: [str: str] = [:]
    for each in m.installs {
        let program = compiler.absolute(docs.disk, full, each)
        let name = path.base(program)
        match named[name] {
            some(other) => fail Failed("{other} and {program} are both named {name}")
            none => {}
        }
        named[name] = program
        programs.push(program)
    }
    programs
}

fn build_programs(source: str, builds: []Build, opts: Options) ! Error {
    var projects: []Hooks = []
    var seen: [str: bool] = [:]
    var sources = [source]
    for b in builds {
        sources.push(b.program)
    }
    for each in sources {
        let hooks = project_hooks(each)?
        if hooks.dir != "" && seen[hooks.dir] == none {
            seen[hooks.dir] = true
            projects.push(hooks)
        }
    }
    for hooks in projects {
        hooks.before()?
    }
    for b in builds {
        let unit = analyse(b.program, opts)?
        native.build(unit, b.output) catch Compile
    }
    for hooks in projects {
        hooks.after()?
    }
}
