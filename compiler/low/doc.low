import compiler
import target
import std/builder
import std/text

fn doc_command(dir: str, platform: target.OS) ! Error {
    let modules = compiler.document(dir, platform) catch Compile
    let encoded = modules_json(modules)
    write_all(1, bytes("{encoded}\n"))
}

fn modules_json(modules: []*compiler.ModuleDoc) -> str {
    if modules.len == 0 {
        return "null"
    }
    var elements: []str = []
    for m in modules {
        let element = module_json(m, 1)
        push(mut elements, element)
    }
    array(elements, 0)
}

fn module_json(m: *compiler.ModuleDoc, depth: i64) -> str {
    var imports: []str = []
    for imp in m.imports {
        push(mut imports, import_json(imp, depth + 2))
    }
    var items: []str = []
    for item in m.items {
        push(mut items, item_json(item, depth + 2))
    }
    var examples: []str = []
    for example in m.examples {
        push(mut examples, example_json(example, depth + 2))
    }
    let fields = [
        text_field("path", m.path),
        field("imports", array(imports, depth + 1)),
        field("items", array(items, depth + 1)),
        field("examples", array(examples, depth + 1)),
    ]
    object(fields, depth)
}

fn import_json(imp: compiler.ImportDoc, depth: i64) -> str {
    let fields = [text_field("path", imp.path), text_field("alias", imp.alias)]
    object(fields, depth)
}

fn item_json(item: compiler.ItemDoc, depth: i64) -> str {
    var fields: []str = [text_field("kind", item.kind), text_field("name", item.name)]
    if item.receiver != "" {
        push(mut fields, text_field("receiver", item.receiver))
    }
    push(mut fields, text_field("text", item.text))
    if item.doc != "" {
        push(mut fields, text_field("doc", item.doc))
    }
    push(mut fields, text_field("file", item.file))
    push(mut fields, field("line", "{item.line}"))
    object(fields, depth)
}

fn example_json(example: compiler.ExampleDoc, depth: i64) -> str {
    let fields = [
        text_field("name", example.name),
        text_field("source", example.source),
        text_field("output", example.output),
    ]
    object(fields, depth)
}

fn text_field(name: str, value: str) -> str {
    field(name, string(value))
}

fn field(name: str, value: str) -> str {
    "\"{name}\": {value}"
}

fn object(fields: []str, depth: i64) -> str {
    let inner = text.repeat("  ", depth + 1)
    let outer = text.repeat("  ", depth)
    let body = text.join(fields, ",\n{inner}")
    "{{\n{inner}{body}\n{outer}}}"
}

fn array(elements: []str, depth: i64) -> str {
    if elements.len == 0 {
        return "[]"
    }
    let inner = text.repeat("  ", depth + 1)
    let outer = text.repeat("  ", depth)
    let body = text.join(elements, ",\n{inner}")
    "[\n{inner}{body}\n{outer}]"
}

fn string(s: str) -> str {
    var b = builder.builder()
    b.write_byte('"')
    for i, c in s {
        write_json_char(mut b, s, i, c)
    }
    b.write_byte('"')
    b.to_str()
}

fn write_json_char(mut b: builder.Builder, s: str, at: i64, c: u32) {
    match c {
        '"' => b.write("\\\"")
        '\\' => b.write("\\\\")
        0x08 => b.write("\\b")
        0x0c => b.write("\\f")
        '\n' => b.write("\\n")
        '\r' => b.write("\\r")
        '\t' => b.write("\\t")
        '<' => b.write("\\u003c")
        '>' => b.write("\\u003e")
        '&' => b.write("\\u0026")
        0x2028 => b.write("\\u2028")
        0x2029 => b.write("\\u2029")
        0xfffd => write_replacement(mut b, s, at)
        _ => write_plain_char(mut b, c)
    }
}

fn write_replacement(mut b: builder.Builder, s: str, at: i64) {
    if at + 3 <= s.len && s[at] == 0xef && s[at + 1] == 0xbf && s[at + 2] == 0xbd {
        b.write_char(0xfffd)
        return
    }
    b.write("\\ufffd")
}

fn write_plain_char(mut b: builder.Builder, c: u32) {
    if c < 0x20 {
        b.write("\\u00{c:x2}")
        return
    }
    b.write_char(c)
}
