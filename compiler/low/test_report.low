import std/builder
import std/json
import std/text

struct Counts {
    failed: i64 = 0
    crashed: i64 = 0
    timed_out: i64 = 0
    build_failed: i64 = 0
    passed: i64 = 0
    skipped: i64 = 0
    not_run: i64 = 0
}

struct Reporter {
    options: TestOptions
    selector: Selector
    total: *Counts
}

fn tally(c: *Counts, v: Verdict) {
    match v {
        Passed => {
            c.passed += 1
        }
        Failed => {
            c.failed += 1
        }
        Skipped => {
            c.skipped += 1
        }
        Crashed => {
            c.crashed += 1
        }
        TimedOut => {
            c.timed_out += 1
        }
        NotRun => {
            c.not_run += 1
        }
    }
}

fn merge(total: *Counts, part: *Counts) {
    total.failed += part.failed
    total.crashed += part.crashed
    total.timed_out += part.timed_out
    total.build_failed += part.build_failed
    total.passed += part.passed
    total.skipped += part.skipped
    total.not_run += part.not_run
}

fn failures(c: *Counts) -> i64 {
    c.failed + c.crashed + c.timed_out
}

fn is_clean(c: *Counts) -> bool {
    failures(c) == 0 && c.build_failed == 0 && c.not_run == 0
}

fn counts_text(c: *Counts) -> str {
    var parts: []str = []
    if c.failed > 0 {
        push(mut parts, "{c.failed} failed")
    }
    if c.crashed > 0 {
        push(mut parts, "{c.crashed} crashed")
    }
    if c.timed_out > 0 {
        push(mut parts, "{c.timed_out} timed out")
    }
    if c.build_failed > 0 {
        push(mut parts, "{c.build_failed} build failed")
    }
    push(mut parts, "{c.passed} passed")
    if c.skipped > 0 {
        push(mut parts, "{c.skipped} skipped")
    }
    if c.not_run > 0 {
        push(mut parts, "{c.not_run} not run")
    }
    text.join(parts, ", ")
}

fn duration_text(nanos: i64) -> str {
    "{text.fixed(f64(nanos) / 1000000.0, 2)}ms"
}

fn timing_text(options: TestOptions, nanos: i64) -> str {
    if options.notime {
        return ""
    }
    " ({duration_text(nanos)})"
}

fn verbatim(mut b: builder.Builder, body: str) {
    b.write(body)
    if body.len > 0 && body[body.len - 1] != '\n' {
        b.write("\n")
    }
}

fn indented(mut b: builder.Builder, body: str) {
    for line in text.lines(body) {
        b.write("    {line}\n")
    }
}

fn is_abnormal(v: Verdict) -> bool {
    v == Verdict.Crashed || v == Verdict.TimedOut
}

fn write_job(mut b: builder.Builder, r: Reporter, job: *Job) {
    let broken = is_failure(job.verdict)
    let shown_anyway = r.options.verbose && job.verdict != Verdict.NotRun
    if !broken && !shown_anyway {
        return
    }
    if is_abnormal(job.verdict) {
        let cause = if job.verdict == Verdict.Crashed { "crashed: {job.detail}" } else { job.detail }
        b.write("--- FAIL: {job.name} ({cause})\n")
        indented(mut b, job.stdout)
    } else {
        verbatim(mut b, job.stdout)
    }
    indented(mut b, job.stderr)
    if broken {
        b.write("    rerun: low test {job.built.module.label} -run {job.name}\n")
    }
}

fn module_text(r: Reporter, built: *Built, counts: *Counts, elapsed_ns: i64) -> str {
    let label = built.module.label
    var b = builder.builder()
    match built.state {
        Untested => {
            b.write("?    {label} [no test files]\n")
        }
        Broken => {
            b.write("FAIL {label} [build failed]\n")
        }
        Ready => {
            for job in built.jobs {
                write_job(mut b, r, job)
            }
            let prefix = if is_clean(counts) { "ok   " } else { "FAIL " }
            let timing = timing_text(r.options, elapsed_ns)
            b.write("{prefix}{label} {counts_text(counts)}{timing}\n")
        }
    }
    b.to_str()
}

fn verdict_name(v: Verdict) -> str {
    match v {
        Passed => "pass"
        Failed => "fail"
        Skipped => "skip"
        Crashed => "crash"
        TimedOut => "timeout"
        NotRun => "not_run"
    }
}

fn open_event(name: str) -> *json.Writer {
    let w = json.writer(0)
    json.start_object(w)
    json_text(w, "event", name)
    w
}

fn close_event(w: *json.Writer) -> str {
    json.end_object(w)
    "{json.written_text(w)}\n"
}

fn json_text(w: *json.Writer, name: str, value: str) {
    json.property(w, name)
    json.string_value(w, value)
}

fn json_number(w: *json.Writer, name: str, value: i64) {
    json.property(w, name)
    json.integer(w, value)
}

fn json_flag(w: *json.Writer, name: str, value: bool) {
    json.property(w, name)
    json.boolean(w, value)
}

fn json_counts(w: *json.Writer, c: *Counts) {
    json_number(w, "failed", c.failed)
    json_number(w, "crashed", c.crashed)
    json_number(w, "timed_out", c.timed_out)
    json_number(w, "build_failed", c.build_failed)
    json_number(w, "passed", c.passed)
    json_number(w, "skipped", c.skipped)
    json_number(w, "not_run", c.not_run)
}

fn json_timing(w: *json.Writer, options: TestOptions, nanos: i64) {
    if !options.notime {
        json_number(w, "elapsed_ns", nanos)
    }
}

fn test_event(r: Reporter, job: *Job) -> str {
    let w = open_event("test")
    json_text(w, "module", job.built.module.label)
    json_text(w, "test", job.name)
    json_text(w, "file", shown(r.selector, job.file))
    json_number(w, "line", job.line)
    json_text(w, "result", verdict_name(job.verdict))
    if is_abnormal(job.verdict) {
        json_text(w, "detail", job.detail)
    }
    json_text(w, "output", "{job.stdout}{job.stderr}")
    json_timing(w, r.options, job.elapsed_ns)
    close_event(w)
}

fn build_event(built: *Built) -> str {
    let w = open_event("build")
    json_text(w, "module", built.module.label)
    json_flag(w, "ok", built.state == BuildState.Ready)
    if built.state == BuildState.Broken {
        json_text(w, "error", built.message)
    }
    close_event(w)
}

fn module_event(r: Reporter, built: *Built, counts: *Counts, elapsed_ns: i64) -> str {
    let w = open_event("module")
    json_text(w, "module", built.module.label)
    json_text(w, "result", module_result(built, counts))
    json_counts(w, counts)
    json_timing(w, r.options, elapsed_ns)
    close_event(w)
}

fn module_result(built: *Built, counts: *Counts) -> str {
    match built.state {
        Untested => "no_test_files"
        Broken => "build_failed"
        Ready => {
            if is_clean(counts) {
                return "ok"
            }
            "fail"
        }
    }
}

fn module_events(r: Reporter, built: *Built, counts: *Counts, elapsed_ns: i64) -> str {
    var b = builder.builder()
    if built.state != BuildState.Untested {
        b.write(build_event(built))
    }
    for job in built.jobs {
        b.write(test_event(r, job))
    }
    b.write(module_event(r, built, counts, elapsed_ns))
    b.to_str()
}

fn module_span(built: *Built) -> i64 {
    var first = 0
    var last = 0
    for job in built.jobs {
        if job.ended == 0 {
            continue
        }
        if first == 0 || job.began < first {
            first = job.began
        }
        if job.ended > last {
            last = job.ended
        }
    }
    last - first
}

fn report_module(r: Reporter, built: *Built) {
    for job in built.jobs {
        <-job.done
    }
    let counts = new(Counts {})
    for job in built.jobs {
        tally(counts, job.verdict)
    }
    let elapsed_ns = module_span(built)
    let rendered = if r.options.json {
        module_events(r, built, counts, elapsed_ns)
    } else {
        module_text(r, built, counts, elapsed_ns)
    }
    if built.state == BuildState.Broken {
        counts.build_failed += 1
    }
    merge(r.total, counts)
    write_all(1, bytes(rendered))
}

fn summary_line(r: Reporter, elapsed_ns: i64) -> str {
    let c = r.total
    if r.options.json {
        let w = open_event("summary")
        json_text(w, "result", if is_clean(c) { "pass" } else { "fail" })
        json_counts(w, c)
        json_timing(w, r.options, elapsed_ns)
        return close_event(w)
    }
    let verdict = if is_clean(c) { "PASS" } else { "FAIL" }
    let timing = timing_text(r.options, elapsed_ns)
    "{verdict}  {counts_text(c)}{timing}\n"
}

fn shuffle_line(options: TestOptions, seed: i64) -> str {
    if options.json {
        let w = open_event("shuffle")
        json_number(w, "seed", seed)
        return close_event(w)
    }
    "shuffle seed {seed}\n"
}

fn listing_text(r: Reporter, built: *Built) -> str {
    var b = builder.builder()
    for test in built.tests {
        if r.options.json {
            let w = open_event("list")
            json_text(w, "module", built.module.label)
            json_text(w, "test", test.name)
            json_text(w, "file", shown(r.selector, test.file))
            json_number(w, "line", test.line)
            b.write(close_event(w))
        } else {
            b.write("{built.module.label} {test.name} {shown(r.selector, test.file)}:{test.line}\n")
        }
    }
    b.to_str()
}
