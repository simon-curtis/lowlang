import context
import native

const context_operands = "<module.name|file.low:line[:col]>"

const context_about = "Prints what an edit to one definition needs: its source, the signature, doc comment and place of everything it names in the order of first reference, the imports of its file and the modules it names without importing them, and with --callers every place that names it. The definition is module.name, module.Type.member or file.low:line[:col], where a module is a directory, std/name or an import path of the current project."

const refs_about = "Prints every place in the project that names a definition, as file:line:column and the line, sorted by file and position. The definition is named as for low context."

fn context_option_table() -> []Option {
    [
        target_option()
        Option { name: "depth", hint: "n", help: "Levels of references to follow from the definition", fallback: "1" }
        Option { name: "budget", hint: "tokens", help: "Drop uses from the deepest level up until the output fits, and list what was cut" }
        Option { name: "callers", help: "Also list every place in the project that names the definition, with the definition around it" }
        json_option()
    ]
}

fn json_option() -> Option {
    Option { name: "json", help: "Write one JSON object per line" }
}

fn context_main(p: Parsed) ! Error {
    let config = context.Config {
        target: p.operands[0]
        platform: platform_option(p)?
        depth: at_least(p, "depth", 1, 1)?
        budget: token_budget(p)?
        callers: is_set(p, "callers")
        json: is_set(p, "json")
    }
    let found = context.context(native.overlay(), config) catch {
        e => fail Error.Failed(context.message(e))
    }
    write_all(1, bytes(found))
}

fn token_budget(p: Parsed) -> i64 ! Error {
    if !is_set(p, "budget") {
        return 0
    }
    at_least(p, "budget", 0, 1)?
}

fn refs_main(p: Parsed) ! Error {
    let found = context.refs(native.overlay(), p.operands[0], platform_option(p)?, is_set(p, "json")) catch {
        e => fail Error.Failed(context.message(e))
    }
    write_all(1, bytes(found))
}
