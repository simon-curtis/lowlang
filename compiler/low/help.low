import std/builder
import std/term
import std/text

const line_limit = 80
const indent = 2
const gap = 4

struct Word {
    text: str
    dim: bool
}

struct Row {
    left: str
    words: []Word
}

struct Filler {
    lines: []str
    line: str
    width: i64
}

fn heading(s: str) -> str {
    term.bold(s)
}

fn accent(s: str) -> str {
    term.fg(term.Colour.Cyan, s)
}

fn muted(s: str) -> str {
    term.dim(s)
}

fn plain_words(s: str) -> []Word {
    var words: []Word = []
    for w in text.fields(s) {
        words.push(Word { text: w, dim: false })
    }
    words
}

fn described_words(help: str, fallback: str) -> []Word {
    var words = plain_words(help)
    if fallback == "" {
        return words
    }
    words.push(Word { text: "(default: {fallback})", dim: true })
    words
}

fn place_word(f: *Filler, w: Word, room: i64) {
    let width = text.char_count(w.text)
    var shown = w.text
    if w.dim {
        shown = muted(w.text)
    }
    if f.width == 0 {
        f.line = shown
        f.width = width
        return
    }
    if f.width + 1 + width > room {
        f.lines.push(f.line)
        f.line = shown
        f.width = width
        return
    }
    f.line = "{f.line} {shown}"
    f.width += 1 + width
}

fn wrap_words(words: []Word, room: i64) -> []str {
    let f = new(Filler { lines: [], line: "", width: 0 })
    for w in words {
        place_word(f, w, room)
    }
    if f.width > 0 {
        f.lines.push(f.line)
    }
    f.lines
}

fn row_text(r: Row, column: i64) -> str {
    let lines = wrap_words(r.words, line_limit - column)
    let used = indent + term.visible_width(r.left)
    var b = builder.builder()
    b.write("{text.repeat(" ", indent)}{r.left}")
    for i, line in lines {
        if i == 0 {
            b.write(text.repeat(" ", column - used))
        } else {
            b.write("\n{text.repeat(" ", column)}")
        }
        b.write(line)
    }
    b.to_str()
}

fn render_rows(rows: []Row) -> str {
    var widest = 0
    for r in rows {
        let width = term.visible_width(r.left)
        if width > widest {
            widest = width
        }
    }
    let column = indent + widest + gap
    var lines: []str = []
    for r in rows {
        lines.push(row_text(r, column))
    }
    text.join(lines, "\n")
}

fn option_label(o: Option) -> str {
    var label = "    "
    if o.letter != "" {
        label = "{accent("-" + o.letter)}, "
    }
    label = "{label}{accent("--" + o.name)}"
    if o.hint != "" {
        label = "{label} {muted("<" + o.hint + ">")}"
    }
    label
}

fn option_rows(options: []Option) -> []Row {
    var rows: []Row = []
    for o in options {
        rows.push(Row { left: option_label(o), words: described_words(o.help, o.fallback) })
    }
    rows
}

fn command_rows() -> []Row {
    var rows: []Row = []
    for c in commands() {
        rows.push(Row { left: accent(c.name), words: plain_words(c.summary) })
    }
    rows
}

fn variable_row(name: str, help: str) -> Row {
    Row { left: accent(name), words: plain_words(help) }
}

fn environment_rows() -> []Row {
    [
        variable_row("LOW_BIN", "Directory 'low install' writes to (default ~/.low/bin)")
        variable_row("LOW_CACHE", "Directory for fetched modules and cached test results")
        variable_row("NO_COLOR", "Turn coloured output off")
    ]
}

fn section(title: str, body: str) -> str {
    "{heading(title)}\n{body}"
}

fn top_help() -> str {
    let title = heading("Low {version()}")
    let usage = "{heading("Usage:")} low <command> [options] [arguments]"
    let commands_section = section("Commands:", render_rows(command_rows()))
    let options_section = section("Options:", render_rows(option_rows(root_command().options)))
    let environment_section = section("Environment:", render_rows(environment_rows()))
    let hint = "Run 'low help <command>' for the options of a command."
    let parts = [title, usage, commands_section, options_section, environment_section, hint]
    "{text.join(parts, "\n\n")}\n"
}

fn usage_line(spec: Command) -> str {
    var line = "{heading("Usage:")} low {spec.name} [options]"
    if spec.operands != "" {
        line = "{line} {spec.operands}"
    }
    line
}

fn command_help(spec: Command) -> str {
    let about = text.join(wrap_words(plain_words(spec.about), line_limit), "\n")
    let options = section("Options:", render_rows(option_rows(spec.options)))
    let parts = [usage_line(spec), about, options]
    "{text.join(parts, "\n\n")}\n"
}

fn usage_report(command: str, message: str) -> str {
    match find_command(command) {
        some(spec) => "low {command}: {message}\n{usage_line(spec)}\nTry 'low {command} --help' for more information.\n"
        none => "low: {message}\nTry 'low --help' for more information.\n"
    }
}

fn write_help(fd: i64, styled: str) {
    var shown = styled
    if !term.colour_enabled(fd) {
        shown = term.strip(styled)
    }
    write_all(fd, bytes(shown))
}
