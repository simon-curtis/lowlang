import compiler
import diag
import native
import target
import std/testing
import std/text

enum BuildState {
    Ready
    Broken
    Untested
}

struct Listed {
    name: str
    file: str
    line: i64
}

struct Caches {
    results: *Cache?
    programs: *Programs?
}

struct Built {
    module: Module
    state: BuildState
    binary: str
    message: str
    diagnostics: []*diag.Diagnostic = []
    tests: []Listed
    jobs: []*Job
    digest: str = ""
    cache: *Cache? = none
    program_cached: bool = false
}

fn compile_tests(s: Selector, live: *Live, programs: *Programs?, built: *Built) ! Error {
    let place = built.module.place
    if !text.starts_with(place, "std/") {
        fetch_project(place, false)?
    }
    match programs {
        some(held) => compile_remembered(s, live, held, built)?
        none => {
            compile_program(live, place, built.binary, s.platform, s.disk)?
        }
    }
}

fn compile_program(live: *Live, place: str, binary: str, platform: target.OS, disk: compiler.Disk) -> str ! Error {
    let slots = live.builds ?? return compile_held(place, binary, platform, disk)?
    using slot = take_slot(slots) or return compile_held(place, binary, platform, disk)?
    compile_held(place, binary, platform, disk)?
}

fn compile_held(place: str, binary: str, platform: target.OS, disk: compiler.Disk) -> str ! Error {
    let profile = compiler.release(platform)
    let unit = native.analyse_tests(place, profile, disk) catch Compile
    let warnings = warnings_text(unit)
    write_all(2, bytes(warnings))
    native.build(unit, binary) catch Compile
    warnings
}

fn compile_remembered(s: Selector, live: *Live, programs: *Programs, built: *Built) ! Error {
    let slot = programs.program_slot(built.module, s.platform)
    match programs.recall(slot) {
        some(remembered) => {
            if place_program(remembered.location, built.binary) {
                write_all(2, bytes(remembered.warnings))
                built.digest = remembered.digest
                built.program_cached = true
                return
            }
        }
        none => {}
    }
    let seen = new_seen(s.disk, s.cwd)
    let warnings = compile_program(live, built.module.place, built.binary, s.platform, seen.recording())?
    built.digest = digest_binary(built.binary)
    programs.remember_program(slot, built.module, built.binary, built.digest, warnings, seen)
}

fn prepare_module(s: Selector, live: *Live, options: TestOptions, caches: Caches, m: Module, binary: str) -> *Built {
    let built = new(Built { module: m, state: BuildState.Untested, binary, message: "", tests: [], jobs: [] })
    if !has_test_files(s, m) {
        return built
    }
    compile_tests(s, live, caches.programs, built) catch {
        e => {
            built.diagnostics = diagnostics_of(e) ?? []
            fail_build(built, describe(e))
            return built
        }
    }
    built.state = BuildState.Ready
    attach_cache(built, caches.results)
    built.tests = list_module(live, built, options.timeout_ms) catch {
        e => {
            fail_build(built, describe(e))
            return built
        }
    }
    built
}

fn fail_build(built: *Built, message: str) {
    built.state = BuildState.Broken
    built.message = message
    write_all(2, bytes("{message}\n"))
}

fn is_chosen(options: TestOptions, name: str) -> bool {
    testing.selected(options.run, name) && !(options.skip != "" && testing.selected(options.skip, name))
}

fn chosen_tests(s: Selector, options: TestOptions, m: Module, listed: []Listed) -> []Listed ! Error {
    var candidates = listed
    if m.file != "" {
        candidates = [at_or_before(s, m, listed)?]
    }
    var chosen: []Listed = []
    for test in candidates {
        if is_chosen(options, test.name) {
            chosen.push(test)
        }
    }
    chosen
}

fn at_or_before(s: Selector, m: Module, listed: []Listed) -> Listed ! Error {
    var best: Listed? = none
    for test in listed {
        if absolute(s, test.file) == m.file && test.line <= m.line {
            best = pick_later(best, test)
        }
    }
    best ?? fail usage_failure("{shown(s, m.file)}:{m.line}: no test at or before that line")
}

fn pick_later(best: Listed?, test: Listed) -> Listed? {
    match best {
        some(held) => {
            if held.line > test.line {
                return held
            }
            test
        }
        none => test
    }
}
