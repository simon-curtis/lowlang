import compiler
import target
import std/testing

enum BuildState {
    Ready
    Broken
    Untested
}

struct Listed {
    name: str
    file: str
    line: i64
}

struct Built {
    module: Module
    state: BuildState
    binary: str
    message: str
    tests: []Listed
    jobs: []*Job
}

fn compile_tests(place: str, binary: str, platform: target.OS) ! Error {
    let profile = compiler.release(platform)
    let unit = compiler.analyse_tests(place, profile) catch Compile
    report(unit)
    compiler.build(unit, binary) catch Compile
}

fn prepare_module(s: Selector, live: *Live, options: TestOptions, m: Module, binary: str) -> *Built {
    let built = new(Built { module: m, state: BuildState.Untested, binary, message: "", tests: [], jobs: [] })
    if !has_test_files(s, m) {
        return built
    }
    compile_tests(m.place, binary, s.platform) catch {
        e => {
            fail_build(built, describe(e))
            return built
        }
    }
    built.state = BuildState.Ready
    built.tests = list_module(live, built, options.timeout_ms) catch {
        e => {
            fail_build(built, describe(e))
            return built
        }
    }
    built
}

fn fail_build(built: *Built, message: str) {
    built.state = BuildState.Broken
    built.message = message
    write_all(2, bytes("{message}\n"))
}

fn is_chosen(options: TestOptions, name: str) -> bool {
    testing.selected(options.run, name) && !(options.skip != "" && testing.selected(options.skip, name))
}

fn chosen_tests(s: Selector, options: TestOptions, m: Module, listed: []Listed) -> []Listed ! Error {
    var candidates = listed
    if m.file != "" {
        candidates = [at_or_before(s, m, listed)?]
    }
    var chosen: []Listed = []
    for test in candidates {
        if is_chosen(options, test.name) {
            push(mut chosen, test)
        }
    }
    chosen
}

fn at_or_before(s: Selector, m: Module, listed: []Listed) -> Listed ! Error {
    var best: Listed? = none
    for test in listed {
        if absolute(s, test.file) == m.file && test.line <= m.line {
            best = pick_later(best, test)
        }
    }
    best ?? fail usage_failure("{shown(s, m.file)}:{m.line}: no test at or before that line")
}

fn pick_later(best: Listed?, test: Listed) -> Listed? {
    match best {
        some(held) => {
            if held.line > test.line {
                return held
            }
            test
        }
        none => test
    }
}
