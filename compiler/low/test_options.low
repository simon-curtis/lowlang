import std/os
import std/text

const default_timeout_ms = 30000
const default_count = 1
const default_target = "./..."

struct TestOptions {
    paths: []str
    run: str
    skip: str
    list: bool
    verbose: bool
    notime: bool
    count: i64
    shuffle: i64?
    failfast: bool
    json: bool
    timeout_ms: i64
    jobs: i64
    update: bool
    nocache: bool
}

fn test_option_table() -> []Option {
    [
        Option { name: "run", hint: "text", help: "Run only the tests whose name contains this text; separate subtest levels with /" }
        Option { name: "skip", hint: "text", help: "Leave out the top-level tests whose name contains this text" }
        Option { name: "list", help: "Print the selected tests and run nothing" }
        Option { name: "verbose", letter: "v", help: "Show the output of every test" }
        Option { name: "notime", help: "Leave durations out of the report" }
        Option { name: "count", hint: "n", help: "Runs of each test, each in its own process", fallback: "{default_count}" }
        Option { name: "shuffle", hint: "seed", help: "Start the tests in the order this seed gives" }
        Option { name: "failfast", help: "Start no more tests after one fails" }
        Option { name: "json", help: "Write one JSON object per line" }
        Option { name: "timeout", hint: "ms", help: "Milliseconds before a test is killed, 0 for no limit", fallback: "{default_timeout_ms}" }
        Option { name: "jobs", letter: "j", hint: "n", help: "Tests running at once", fallback: "{os.cpu_count()}" }
        Option { name: "update", help: "Rewrite golden files instead of comparing them" }
        Option { name: "nocache", help: "Build every program and run every test instead of reusing cached ones" }
    ]
}

fn usage_failure(message: str) -> Error {
    Error.Usage("test", message)
}

fn number_option(p: Parsed, name: str, fallback: i64) -> i64 ! Error {
    let raw = given(p, name) ?? return fallback
    text.parse_int(raw) or fail invalid_value(p.command, name, raw)
}

fn at_least(p: Parsed, name: str, fallback: i64, least: i64) -> i64 ! Error {
    let value = number_option(p, name, fallback)?
    if value < least {
        fail option_error(p.command, name, "needs at least {least}")
    }
    value
}

fn shuffle_seed(p: Parsed) -> i64? ! Error {
    if !is_set(p, "shuffle") {
        return none
    }
    let seed = number_option(p, "shuffle", 0)?
    some(seed)
}

fn parse_test_options(p: Parsed) -> TestOptions ! Error {
    var paths = p.operands
    if paths.len == 0 {
        paths = [default_target]
    }
    TestOptions {
        paths
        run: given_or(p, "run", "")
        skip: given_or(p, "skip", "")
        list: is_set(p, "list")
        verbose: is_set(p, "verbose")
        notime: is_set(p, "notime")
        count: at_least(p, "count", default_count, 1)?
        shuffle: shuffle_seed(p)?
        failfast: is_set(p, "failfast")
        json: is_set(p, "json")
        timeout_ms: at_least(p, "timeout", default_timeout_ms, 0)?
        jobs: at_least(p, "jobs", os.cpu_count(), 1)?
        update: is_set(p, "update")
        nocache: is_set(p, "nocache")
    }
}
