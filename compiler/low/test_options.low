import std/flag
import std/os

const default_timeout_ms = 30000
const default_target = "./..."

struct TestOptions {
    paths: []str
    run: str
    skip: str
    list: bool
    verbose: bool
    notime: bool
    count: i64
    shuffle: i64?
    failfast: bool
    json: bool
    timeout_ms: i64
    jobs: i64
    update: bool
}

fn test_specs() -> []flag.Spec {
    [
        flag.Spec { name: "run", help: "run only the tests whose name contains this text; separate subtest levels with /" }
        flag.Spec { name: "skip", help: "leave out the top-level tests whose name contains this text" }
        flag.Spec { name: "list", help: "print the selected tests and run nothing", boolean: true }
        flag.Spec { name: "v", help: "show the output of every test", boolean: true }
        flag.Spec { name: "notime", help: "leave durations out of the report", boolean: true }
        flag.Spec { name: "count", help: "runs of each test, each in its own process", fallback: "1" }
        flag.Spec { name: "shuffle", help: "start the tests in the order this seed gives" }
        flag.Spec { name: "failfast", help: "start no more tests after one fails", boolean: true }
        flag.Spec { name: "json", help: "write one JSON object per line", boolean: true }
        flag.Spec { name: "timeout", help: "milliseconds before a test is killed, 0 for no limit", fallback: "{default_timeout_ms}" }
        flag.Spec { name: "jobs", help: "tests running at once", fallback: "{os.cpu_count()}" }
        flag.Spec { name: "update", help: "rewrite golden files instead of comparing them", boolean: true }
    ]
}

fn usage_failure(message: str) -> Error {
    write_all(2, bytes("low test: {message}\n"))
    Error.Exit(2)
}

fn flag_failure(e: flag.Error) -> Error {
    let message = match e {
        Unknown(name) => "unknown flag -{name}"
        Missing(name) => "flag -{name} needs a value"
        Invalid(name, value) => "flag -{name} cannot take {value}"
    }
    let failure = usage_failure(message)
    let help = flag.usage(test_specs())
    write_all(2, bytes(help))
    failure
}

fn number_flag(parsed: flag.Parsed, name: str) -> i64 ! Error {
    flag.number(parsed, name) catch {
        e => fail flag_failure(e)
    }
}

fn at_least(parsed: flag.Parsed, name: str, least: i64) -> i64 ! Error {
    let value = number_flag(parsed, name)?
    if value < least {
        fail usage_failure("flag -{name} needs at least {least}")
    }
    value
}

fn parse_test_options(args: []str) -> TestOptions ! Error {
    let parsed = flag.parse(test_specs(), args) catch {
        e => fail flag_failure(e)
    }
    var paths = parsed.rest
    if paths.len == 0 {
        paths = [default_target]
    }
    var shuffle: i64? = none
    if flag.get(parsed, "shuffle") != "" {
        let seed = number_flag(parsed, "shuffle")?
        shuffle = some(seed)
    }
    let count = at_least(parsed, "count", 1)?
    let timeout_ms = at_least(parsed, "timeout", 0)?
    let jobs = at_least(parsed, "jobs", 1)?
    TestOptions {
        paths
        run: flag.get(parsed, "run")
        skip: flag.get(parsed, "skip")
        list: flag.enabled(parsed, "list")
        verbose: flag.enabled(parsed, "v")
        notime: flag.enabled(parsed, "notime")
        count
        shuffle
        failfast: flag.enabled(parsed, "failfast")
        json: flag.enabled(parsed, "json")
        timeout_ms
        jobs
        update: flag.enabled(parsed, "update")
    }
}
