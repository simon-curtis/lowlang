const exp_max = 0x40862E42FEFA39EF
const exp_min = -4573606559926636463
const exp_log2e = 0x3FF71547652B82FE
const exp_ln2_high = 0x3FE62E42FEE00000
const exp_ln2_low = 0x3DEA39EF35793C76
const exp_infinity = 0x7FF0000000000000
const exp_bias = 1023
const exp_fraction_bits = 52

fn exp_coefficients() -> []i64 {
    [
        0x3DE6124613A86D09, 0x3E21EED8EFF8D898, 0x3E5AE64567F544E4, 0x3E927E4FB7789F5C,
        0x3EC71DE3A556C734, 0x3EFA01A01A01A01A, 0x3F2A01A01A01A01A, 0x3F56C16C16C16C17,
        0x3F81111111111111, 0x3FA5555555555555, 0x3FC5555555555555, 0x3FE0000000000000,
        0x3FF0000000000000, 0x3FF0000000000000,
    ]
}

fn product(l: *Lowering, a: u32, b: u32) -> u32 {
    let id = l.m.value(op_f_mul, l.float_type(64), [a, b])
    l.exact(id)
    id
}

fn power_of_two(l: *Lowering, exponent: u32) -> u32 {
    let biased = l.make(op_i_add, exponent, l.whole(exp_bias))
    l.to_float(l.make(op_shift_left_logical, biased, l.whole(exp_fraction_bits)), 64)
}

fn exponential(l: *Lowering, bits: u32) -> u32 {
    let double = l.float_type(64)
    let x = l.to_float(bits, 64)
    let unordered = l.m.value(op_is_nan, l.bool_type, [x])
    let above = l.test(op_f_ord_greater_than, x, l.float_constant(64, exp_max))
    let below = l.test(op_f_ord_greater_than, l.float_constant(64, exp_min), x)
    let outside = l.test(op_logical_or, unordered, l.test(op_logical_or, above, below))
    let safe = l.pick(double, outside, l.float_constant(64, 0), x)
    let scaled = l.extension(double, glsl_round_even, l.product(safe, l.float_constant(64, exp_log2e)))
    let count = l.m.value(op_convert_f_to_s, l.word_type, [scaled])
    let whole_part = l.m.value(op_convert_s_to_f, double, [count])
    var rest = l.m.value(op_f_sub, double, [safe, l.product(whole_part, l.float_constant(64, exp_ln2_high))])
    l.exact(rest)
    rest = l.m.value(op_f_sub, double, [rest, l.product(whole_part, l.float_constant(64, exp_ln2_low))])
    l.exact(rest)
    let coefficients = exp_coefficients()
    var sum = l.float_constant(64, coefficients[0])
    for coefficient in coefficients[1..] {
        sum = l.m.value(op_f_add, double, [l.product(sum, rest), l.float_constant(64, coefficient)])
        l.exact(sum)
    }
    let lower = l.make(op_shift_right_arithmetic, count, l.whole(1))
    let upper = l.make(op_i_sub, count, lower)
    sum = l.product(sum, l.power_of_two(lower))
    sum = l.product(sum, l.power_of_two(upper))
    let finite = l.pick(l.word_type, below, l.whole(0), l.from_float(sum, 64))
    let bounded = l.pick(l.word_type, above, l.whole(exp_infinity), finite)
    l.pick(l.word_type, unordered, bits, bounded)
}
