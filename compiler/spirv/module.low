struct Section {
    words: []u32 = []
}

fn put(s: *Section, op: u32, operands: []u32) {
    s.words.push(u32(operands.len + 1) << 16 | op)
    for w in operands {
        s.words.push(w)
    }
}

fn blank(s: *Section, at: i64, count: i64) {
    for i in at..at + count {
        s.words[i] = nop
    }
}

struct Module {
    next: u32 = 1
    header: *Section
    decorations: *Section
    declarations: *Section
    entry: *Section
    locals: *Section
    code: *Section
    declared: [str: u32] = [:]
}

fn new_module() -> *Module {
    new(Module {
        header: new(Section {})
        decorations: new(Section {})
        declarations: new(Section {})
        entry: new(Section {})
        locals: new(Section {})
        code: new(Section {})
    })
}

fn fresh(m: *Module) -> u32 {
    let id = m.next
    m.next += 1
    id
}

fn declare(m: *Module, key: str, op: u32, operands: []u32) -> u32 {
    match m.declared[key] {
        some(id) => return id
        none => {}
    }
    let id = m.fresh()
    var all: []u32 = []
    all.push(id)
    for w in operands {
        all.push(w)
    }
    m.declarations.put(op, all)
    m.declared[key] = id
    id
}

fn typed(m: *Module, key: str, op: u32, type: u32, operands: []u32) -> u32 {
    match m.declared[key] {
        some(id) => return id
        none => {}
    }
    let id = m.fresh()
    var all: []u32 = []
    all.push(type)
    all.push(id)
    for w in operands {
        all.push(w)
    }
    m.declarations.put(op, all)
    m.declared[key] = id
    id
}

fn value(m: *Module, op: u32, type: u32, operands: []u32) -> u32 {
    let id = m.fresh()
    var all: []u32 = []
    all.push(type)
    all.push(id)
    for w in operands {
        all.push(w)
    }
    m.code.put(op, all)
    id
}

fn name_words(name: str) -> []u32 {
    var words: []u32 = []
    var at = 0
    for at <= name.len {
        var word: u32 = 0
        for k in 0..4 {
            if at + k < name.len {
                word = word | u32(name[at + k]) << u32(8 * k)
            }
        }
        words.push(word)
        at += 4
    }
    words
}

fn encode(m: *Module) -> []u8 {
    var out: []u8 = []
    var words: []u32 = []
    words.push(magic)
    words.push(version)
    words.push(0)
    words.push(m.next)
    words.push(0)
    for s in [m.header, m.decorations, m.declarations, m.entry, m.locals, m.code] {
        for w in s.words {
            words.push(w)
        }
    }
    for w in words {
        out.push(u8(w & 0xFF))
        out.push(u8(w >> 8 & 0xFF))
        out.push(u8(w >> 16 & 0xFF))
        out.push(u8(w >> 24))
    }
    out
}
