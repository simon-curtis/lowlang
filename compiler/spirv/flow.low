import ir

enum Task {
    Tree(node: i64)
    Within(node: i64, at: i64)
    Body(node: i64)
    Moves(from: i64, to: i64)
    Branch(from: i64, to: i64)
    OpenBlock(node: i64)
    CloseBlock(node: i64)
    OpenLoop(node: i64)
    CloseLoop(node: i64)
    Label(id: u32)
    Dead(id: u32)
    Test(code: i64, held: u32, then: u32, otherwise: u32, merge: u32)
    Arrive(dest: i64, live: bool, carried: i64)
}

struct Frame {
    loop: bool
    node: i64
    merge: u32
    next: u32 = 0
    header: u32 = 0
    escapes: []i64 = []
    stores: []i64 = []
    tainted: bool = false
}

const to_merge = 0
const to_continue = 1
const to_after = 2
const store_words = 3

struct Dest {
    kind: i64
    frame: i64
    node: i64
}

fn rpo(l: *Lowering, b: *ir.Block) -> i64 {
    l.dom.index[b] ?? -1
}

fn contains(l: *Lowering, loop: i64, node: i64) -> bool {
    l.loops[loop].body[l.dom.nodes[node]] ?? false
}

fn is_local(l: *Lowering, node: i64, from: i64) -> bool {
    let loop = l.inner[from]
    loop < 0 || l.contains(loop, node)
}

fn owner(l: *Lowering, from: i64, node: i64) -> i64 {
    var loop = l.inner[from]
    for l.parent[loop] >= 0 && !l.contains(l.parent[loop], node) {
        loop = l.parent[loop]
    }
    loop
}

fn nest(l: *Lowering) {
    let n = l.dom.nodes.len
    l.loops = ir.loops(l.dom)
    for _ in 0..n {
        l.inner.push(-1)
        l.loop_at.push(-1)
    }
    for i, found in l.loops {
        l.loop_at[l.rpo(found.header)] = i
        l.around.push([])
        l.parent.push(-1)
        for node in 0..n {
            if l.inner[node] < 0 && l.contains(i, node) {
                l.inner[node] = i
            }
        }
    }
    for i, found in l.loops {
        let header = l.rpo(found.header)
        for j in i + 1..l.loops.len {
            if l.contains(j, header) {
                l.parent[i] = j
                break
            }
        }
    }
}

fn shape(l: *Lowering) ! Error {
    if !ir.is_reducible(l.dom) {
        fail Unsupported("irreducible control flow in kernel {l.k.name}")
    }
    let n = l.dom.nodes.len
    var forward: []i64 = []
    for _ in 0..n {
        forward.push(0)
        l.merge.push(false)
        l.header.push(false)
        l.merges.push([])
        l.frame_at.push(-1)
    }
    for i, b in l.dom.nodes {
        if b.kind == ir.Kind.Switch {
            fail Unsupported("a jump table in kernel {l.k.name}")
        }
        for s in b.succs {
            if b.kind == ir.Kind.If && b.succs[0].id == b.succs[1].id && starts_with_phi(s) {
                fail Unsupported("a branch whose arms both enter one block with phis in kernel {l.k.name}")
            }
            let to = l.rpo(s)
            if to > i {
                forward[to] += 1
                continue
            }
            l.header[to] = true
        }
    }
    l.nest()
    for i in 0..n {
        l.merge[i] = forward[i] >= 2
    }
    var at = n - 1
    for at >= 1 {
        if l.merge[at] {
            let from = l.dom.idom[at]
            if l.is_local(at, from) {
                l.merges[from].push(at)
            } else {
                l.around[l.owner(from, at)].push(at)
            }
        }
        at -= 1
    }
}

fn starts_with_phi(b: *ir.Block) -> bool {
    b.values.len > 0 && b.values[0].op == ir.Op.OpPhi
}

fn push_tasks(l: *Lowering, list: []Task) {
    var at = list.len - 1
    for at >= 0 {
        l.tasks.push(list[at])
        at -= 1
    }
}

fn flow(l: *Lowering) ! Error {
    l.shape()?
    l.tasks.push(Task.Tree(0))
    for l.tasks.len > 0 {
        let task = l.tasks[l.tasks.len - 1]
        l.tasks.truncate(l.tasks.len - 1)
        l.run(task)?
    }
}

fn run(l: *Lowering, task: Task) ! Error {
    match task {
        Tree(node) => l.tree(node)
        Within(node, at) => l.within(node, at)
        Body(node) => l.body(node)?
        Moves(from, to) => l.arm_moves(l.dom.nodes[from], l.dom.nodes[to])?
        Branch(from, to) => l.branch(from, to)
        OpenBlock(node) => l.open_block(node)
        CloseBlock(node) => l.close_block(node)
        OpenLoop(node) => l.open_loop(node)
        CloseLoop(node) => l.close_loop(node)
        Label(id) => l.emit(op_label, [id])
        Dead(id) => {
            l.emit(op_label, [id])
            l.emit(op_unreachable, [])
        }
        Test(code, held, then, otherwise, merge) => {
            let matches = l.test(op_i_equal, held, l.half(code))
            l.emit(op_selection_merge, [merge, 0])
            l.emit(op_branch_conditional, [matches, then, otherwise])
            l.emit(op_label, [then])
        }
        Arrive(dest, live, carried) => l.arrive(dest, live, carried)
    }
}

fn tree(l: *Lowering, node: i64) {
    if !l.header[node] {
        l.tasks.push(Task.Within(node, 0))
        return
    }
    let outside = l.around[l.loop_at[node]]
    var list: []Task = []
    for exit in outside {
        list.push(Task.OpenBlock(exit))
    }
    list.push(Task.OpenLoop(node))
    list.push(Task.Within(node, 0))
    list.push(Task.CloseLoop(node))
    var at = outside.len - 1
    for at >= 0 {
        list.push(Task.CloseBlock(outside[at]))
        at -= 1
    }
    l.push_tasks(list)
}

fn within(l: *Lowering, node: i64, at: i64) {
    let list = l.merges[node]
    if at >= list.len {
        l.tasks.push(Task.Body(node))
        return
    }
    let next = list[at]
    l.push_tasks([Task.OpenBlock(next), Task.Within(node, at + 1), Task.CloseBlock(next)])
}

fn open_block(l: *Lowering, node: i64) {
    let merge = l.m.fresh()
    let inside = l.m.fresh()
    l.emit(op_selection_merge, [merge, 0])
    l.emit(op_switch, [l.half(0), inside])
    l.emit(op_label, [inside])
    l.frame_at[node] = l.frames.len
    l.frames.push(new(Frame { loop: false, node, merge }))
}

fn open_loop(l: *Lowering, node: i64) {
    let header = l.m.fresh()
    let inside = l.m.fresh()
    let merge = l.m.fresh()
    let next = l.m.fresh()
    l.emit(op_branch, [header])
    l.emit(op_label, [header])
    l.emit(op_loop_merge, [merge, next, 0])
    l.emit(op_branch, [inside])
    l.emit(op_label, [inside])
    l.frame_at[node] = l.frames.len
    l.frames.push(new(Frame { loop: true, node, merge, next, header }))
}

fn close_frame(l: *Lowering) -> *Frame {
    let top = l.frames.len - 1
    let f = l.frames[top]
    l.frames.truncate(top)
    l.frame_at[f.node] = -1
    f
}

fn close_block(l: *Lowering, node: i64) {
    let f = l.close_frame()
    l.emit(op_label, [f.merge])
    l.dispatch(f, node)
}

fn close_loop(l: *Lowering, node: i64) {
    let f = l.close_frame()
    if f.node != node {
        panic("spirv: the loop frame of node {node} closes node {f.node}")
    }
    l.emit(op_label, [f.next])
    l.emit(op_branch, [f.header])
    l.emit(op_label, [f.merge])
    l.dispatch(f, -1)
}

fn route_variable(l: *Lowering) -> u32 {
    if l.route == 0 {
        l.route = l.local_from(l.half_type, l.half(0))
    }
    l.route
}

fn dispatch(l: *Lowering, f: *Frame, normal: i64) {
    if f.escapes.len == 0 {
        if normal < 0 {
            l.emit(op_unreachable, [])
            return
        }
        l.tasks.push(Task.Tree(normal))
        return
    }
    if f.escapes.len == 1 && normal < 0 {
        if f.tainted {
            l.tasks.push(Task.Arrive(f.escapes[0], true, -1))
            return
        }
        l.carried.push(f.stores)
        l.tasks.push(Task.Arrive(f.escapes[0], false, l.carried.len - 1))
        return
    }
    let held = l.m.value(op_load, l.half_type, [l.route_variable()])
    var list: []Task = []
    var dead: []u32 = []
    for i, dest in f.escapes {
        if i == f.escapes.len - 1 && normal < 0 {
            list.push(Task.Arrive(dest, true, -1))
            break
        }
        let then = l.m.fresh()
        let otherwise = l.m.fresh()
        let merge = l.m.fresh()
        list.push(Task.Test(dest + 1, held, then, otherwise, merge))
        list.push(Task.Arrive(dest, true, -1))
        list.push(Task.Label(otherwise))
        dead.push(merge)
    }
    if normal >= 0 {
        list.push(Task.Tree(normal))
    }
    var at = dead.len - 1
    for at >= 0 {
        list.push(Task.Dead(dead[at]))
        at -= 1
    }
    l.push_tasks(list)
}

fn settle_route(l: *Lowering, live: bool, carried: i64) {
    if live {
        l.emit(op_store, [l.route_variable(), l.half(0)])
        return
    }
    if carried < 0 {
        return
    }
    for at in l.carried[carried] {
        l.m.code.blank(at, store_words)
    }
}

fn arrive(l: *Lowering, dest: i64, live: bool, carried: i64) {
    let d = l.dests[dest]
    if d.kind == to_after && l.frame_at[d.frame] < 0 {
        l.settle_route(live, carried)
        l.tasks.push(Task.Tree(d.node))
        return
    }
    l.route_to(dest, false, live, carried)
}

fn dest_of(l: *Lowering, kind: i64, frame: i64, node: i64) -> i64 {
    let key = (frame * (l.dom.nodes.len + 1) + node) * 3 + kind
    match l.dest_at[key] {
        some(at) => return at
        none => {}
    }
    l.dests.push(Dest { kind, frame, node })
    l.dest_at[key] = l.dests.len - 1
    l.dests.len - 1
}

fn innermost_loop(l: *Lowering) -> i64 {
    var at = l.frames.len - 1
    for at >= 0 && !l.frames[at].loop {
        at -= 1
    }
    at
}

fn route_to(l: *Lowering, dest: i64, fresh: bool, live: bool, carried: i64) {
    let d = l.dests[dest]
    let top = l.frames.len - 1
    let loop = l.innermost_loop()
    let target = l.frame_at[d.frame]
    if target < 0 {
        panic("spirv: a branch in kernel {l.k.name} leaves for a frame that is not open")
    }
    if (d.kind == to_merge && target == top) || (d.kind == to_continue && target == loop) {
        l.settle_route(live, carried)
        let f = l.frames[target]
        l.emit(op_branch, [if d.kind == to_merge { f.merge } else { f.next }])
        return
    }
    var hop = top
    if loop >= 0 && (loop > target || d.kind != to_merge) {
        hop = loop
    }
    let f = l.frames[hop]
    if fresh {
        f.stores.push(l.m.code.words.len)
        l.emit(op_store, [l.route_variable(), l.half(dest + 1)])
    } else if live {
        f.tainted = true
    } else if carried >= 0 {
        for at in l.carried[carried] {
            f.stores.push(at)
        }
    }
    var seen = false
    for e in f.escapes {
        if e == dest {
            seen = true
        }
    }
    if !seen {
        f.escapes.push(dest)
    }
    l.emit(op_branch, [f.merge])
}

fn branch(l: *Lowering, from: i64, to: i64) {
    if to <= from {
        l.route_to(l.dest_of(to_continue, to, 0), true, false, -1)
        return
    }
    if l.merge[to] {
        l.route_to(l.dest_of(to_merge, to, 0), true, false, -1)
        return
    }
    if l.is_local(to, from) {
        l.tasks.push(Task.Tree(to))
        return
    }
    let loop = l.owner(from, to)
    l.route_to(l.dest_of(to_after, l.rpo(l.loops[loop].header), to), true, false, -1)
}

fn condition(l: *Lowering, v: *ir.Value) -> u32 ! Error {
    match l.truths[v.id] {
        some(id) => return id
        none => {}
    }
    l.test(op_i_not_equal, l.get(v)?, l.whole(0))
}

fn enter(l: *Lowering, b: *ir.Block) {
    l.current = b.id
    l.loaded = [:]
    l.truths = [:]
    for v in b.values {
        if v.op != ir.Op.OpPhi {
            break
        }
        let variable = l.vals[v.id].variable
        let id = l.m.value(op_load, l.word_type, [variable])
        l.vals[v.id] = Val { known: true, id, home: b.id, variable }
    }
}

fn phi_moves(l: *Lowering, from: *ir.Block, to: *ir.Block) ! Error {
    var at = -1
    for i, p in to.preds {
        if p.id == from.id && at < 0 {
            at = i
        }
    }
    var moved: []u32 = []
    var into: []u32 = []
    for v in to.values {
        if v.op != ir.Op.OpPhi {
            break
        }
        if at < 0 || at >= v.args.len {
            fail Unsupported("a phi without a value for one of its predecessors in kernel {l.k.name}")
        }
        moved.push(l.get(v.args[at])?)
        into.push(l.vals[v.id].variable)
    }
    for i, variable in into {
        l.emit(op_store, [variable, moved[i]])
    }
}

fn arm_moves(l: *Lowering, from: *ir.Block, to: *ir.Block) ! Error {
    l.caching = false
    l.phi_moves(from, to)?
    l.caching = true
}

fn body(l: *Lowering, node: i64) ! Error {
    let b = l.dom.nodes[node]
    l.enter(b)
    for v in b.values {
        l.lower(v)?
    }
    match b.kind {
        Plain => {
            let next = b.succs[0]
            l.phi_moves(b, next)?
            l.tasks.push(Task.Branch(node, l.rpo(next)))
        }
        If => {
            let passes = l.condition(b.control ?? panic("if without a control value"))?
            let then = l.m.fresh()
            let otherwise = l.m.fresh()
            let merge = l.m.fresh()
            l.emit(op_selection_merge, [merge, 0])
            l.emit(op_branch_conditional, [passes, then, otherwise])
            let first = l.rpo(b.succs[0])
            let second = l.rpo(b.succs[1])
            l.push_tasks([
                Task.Label(then), Task.Moves(node, first), Task.Branch(node, first), Task.Label(otherwise), Task.Moves(node, second),
                Task.Branch(node, second), Task.Dead(merge),
            ])
        }
        Ret => l.emit(op_return, [])
        Unreachable => l.emit(op_unreachable, [])
        Switch => fail Unsupported("a jump table in kernel {l.k.name}")
    }
}
