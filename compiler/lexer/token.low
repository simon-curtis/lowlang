import diag

pub enum Kind {
    EOF
    Newline
    Ident
    Int
    Float
    Char
    String

    Fn
    Let
    Var
    If
    Else
    For
    Break
    Continue
    Return
    True
    False
    Enum
    Match
    Fail
    Catch
    Or
    Struct
    Mut
    In
    Import
    Pub
    Extern
    Defer
    Spawn
    Select
    Using
    Drop
    Const

    LParen
    RParen
    LBracket
    RBracket
    DotDot
    Ellipsis
    LBrace
    RBrace
    Comma
    Colon
    Arrow
    FatArrow
    Dot
    Question
    Coalesce
    LArrow
    PipeArrow

    Assign
    PlusAssign
    MinusAssign
    StarAssign
    SlashAssign
    PercentAssign
    AmpAssign
    PipeAssign
    CaretAssign
    ShlAssign
    ShrAssign

    Plus
    Minus
    Star
    Slash
    Percent
    Amp
    Pipe
    Caret
    Tilde
    Shl
    Shr
    Not
    AndAnd
    OrOr
    Eq
    NotEq
    Lt
    LtEq
    Gt
    GtEq
}

pub struct Spelling {
    pub text: str
    pub kind: Kind
}

pub fn keyword_spellings() -> []Spelling {
    [
        Spelling { text: "fn", kind: Fn }, Spelling { text: "let", kind: Let }, Spelling { text: "var", kind: Var },
        Spelling { text: "if", kind: If }, Spelling { text: "else", kind: Else }, Spelling { text: "for", kind: For },
        Spelling { text: "break", kind: Break }, Spelling { text: "continue", kind: Continue },
        Spelling { text: "return", kind: Return }, Spelling { text: "true", kind: True },
        Spelling { text: "false", kind: False }, Spelling { text: "enum", kind: Enum },
        Spelling { text: "match", kind: Match }, Spelling { text: "fail", kind: Fail },
        Spelling { text: "catch", kind: Catch }, Spelling { text: "or", kind: Or },
        Spelling { text: "struct", kind: Struct }, Spelling { text: "mut", kind: Mut }, Spelling { text: "in", kind: In },
        Spelling { text: "import", kind: Import }, Spelling { text: "pub", kind: Pub },
        Spelling { text: "extern", kind: Extern }, Spelling { text: "defer", kind: Defer },
        Spelling { text: "spawn", kind: Spawn }, Spelling { text: "select", kind: Select },
        Spelling { text: "using", kind: Using }, Spelling { text: "drop", kind: Drop },
        Spelling { text: "const", kind: Const },
    ]
}

pub fn operator_spellings() -> []Spelling {
    [
        Spelling { text: "...", kind: Ellipsis }, Spelling { text: "<<=", kind: ShlAssign },
        Spelling { text: ">>=", kind: ShrAssign }, Spelling { text: "??", kind: Coalesce },
        Spelling { text: "<-", kind: LArrow }, Spelling { text: "|>", kind: PipeArrow },
        Spelling { text: "->", kind: Arrow }, Spelling { text: "=>", kind: FatArrow },
        Spelling { text: "%=", kind: PercentAssign }, Spelling { text: "&=", kind: AmpAssign },
        Spelling { text: "|=", kind: PipeAssign }, Spelling { text: "^=", kind: CaretAssign },
        Spelling { text: "<<", kind: Shl }, Spelling { text: ">>", kind: Shr },
        Spelling { text: "+=", kind: PlusAssign }, Spelling { text: "-=", kind: MinusAssign },
        Spelling { text: "*=", kind: StarAssign }, Spelling { text: "/=", kind: SlashAssign },
        Spelling { text: "&&", kind: AndAnd }, Spelling { text: "||", kind: OrOr }, Spelling { text: "==", kind: Eq },
        Spelling { text: "!=", kind: NotEq }, Spelling { text: "<=", kind: LtEq }, Spelling { text: ">=", kind: GtEq },
        Spelling { text: "..", kind: DotDot }, Spelling { text: "(", kind: LParen }, Spelling { text: ")", kind: RParen },
        Spelling { text: "[", kind: LBracket }, Spelling { text: "]", kind: RBracket },
        Spelling { text: "{{", kind: LBrace }, Spelling { text: "}}", kind: RBrace },
        Spelling { text: ",", kind: Comma }, Spelling { text: ":", kind: Colon }, Spelling { text: ".", kind: Dot },
        Spelling { text: "?", kind: Question }, Spelling { text: "=", kind: Assign }, Spelling { text: "+", kind: Plus },
        Spelling { text: "-", kind: Minus }, Spelling { text: "*", kind: Star }, Spelling { text: "/", kind: Slash },
        Spelling { text: "%", kind: Percent }, Spelling { text: "!", kind: Not }, Spelling { text: "<", kind: Lt },
        Spelling { text: ">", kind: Gt }, Spelling { text: "&", kind: Amp }, Spelling { text: "|", kind: Pipe },
        Spelling { text: "^", kind: Caret }, Spelling { text: "~", kind: Tilde },
    ]
}

fn description(k: Kind) -> str? {
    match k {
        EOF => "end of file"
        Newline => "newline"
        Ident => "identifier"
        Int => "integer"
        Float => "float"
        Char => "character"
        String => "string"
        _ => none
    }
}

fn spelled(table: []Spelling, k: Kind) -> str? {
    for s in table {
        if s.kind == k {
            return s.text
        }
    }
    none
}

pub fn kind_text(k: Kind) -> str {
    description(k) ?? spelled(keyword_spellings(), k) ?? spelled(operator_spellings(), k) ?? "Kind"
}

pub fn keyword(text: str) -> Kind? {
    match text {
        "fn" => Kind.Fn
        "let" => Let
        "var" => Var
        "if" => If
        "else" => Else
        "for" => For
        "break" => Break
        "continue" => Continue
        "return" => Return
        "true" => True
        "false" => False
        "enum" => Enum
        "match" => Match
        "fail" => Fail
        "catch" => Catch
        "or" => Or
        "struct" => Struct
        "mut" => Mut
        "in" => In
        "import" => Import
        "pub" => Pub
        "extern" => Extern
        "defer" => Defer
        "spawn" => Spawn
        "select" => Select
        "using" => Using
        "drop" => Drop
        "const" => Const
        _ => none
    }
}

pub fn operator(k: Kind) -> Kind {
    match k {
        PlusAssign => Plus
        MinusAssign => Minus
        StarAssign => Star
        SlashAssign => Slash
        PercentAssign => Percent
        AmpAssign => Amp
        PipeAssign => Pipe
        CaretAssign => Caret
        ShlAssign => Shl
        ShrAssign => Shr
        _ => k
    }
}

pub fn assignment(k: Kind) -> bool {
    k == Assign || operator(k) != k
}

pub const after = "after"
pub const when = "when"

pub fn contextual_keywords() -> []str {
    [after, when]
}

pub fn is_keyword(name: str) -> bool {
    keyword(name) != none
}

pub struct Part {
    pub text: str = ""
    pub expr: bool = false
    pub tokens: []Token = []
    pub spec: str = ""
    pub spec_pos: diag.Pos = diag.Pos {}
}

pub struct Token {
    pub kind: Kind
    pub text: str = ""
    pub char: u32 = 0
    pub parts: []Part = []
    pub pos: diag.Pos
    pub start: i64 = 0
    pub end: i64 = 0
    pub doc: str = ""
    pub doc_at: diag.Pos = diag.Pos {}
}
