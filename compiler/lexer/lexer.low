import diag
import std/builder
import std/text
import std/unicode

struct Lexer {
    src: str
    source: *diag.Source
    off: i64 = 0
    from: i64 = 0
    line: i64
    col: i64
    last: Kind = Newline
    tokens: []Lexeme = []
    extras: []Extra = []
    doc: []str = []
    doc_at: diag.Pos = diag.nowhere()
    privileged: bool
    operators: []Spelling
}

pub fn lex(src: str, at: diag.Pos, privileged: bool) -> []Token ! diag.Error {
    let tokens = scan(src, at, privileged)?
    tokens.expand()
}

pub fn scan(src: str, at: diag.Pos, privileged: bool) -> Tokens ! diag.Error {
    lex_with(src, at, privileged, operator_spellings())?
}

fn lex_with(src: str, at: diag.Pos, privileged: bool, operators: []Spelling) -> Tokens ! diag.Error {
    let l = new(Lexer { src, source: at.origin(), line: at.pos_line(), col: at.pos_col(), privileged, operators })
    for {
        l.skip_space()
        if l.off >= l.src.len {
            l.emit_newline(l.pos())
            l.emit(EOF, l.pos())
            return l.scanned()
        }
        l.next()?
    }
    l.scanned()
}

fn scanned(l: *Lexer) -> Tokens {
    Tokens { source: l.source, src: l.src, lexemes: l.tokens, extras: l.extras }
}

fn pos(l: *Lexer) -> diag.Pos {
    diag.pos_in(l.source, l.line, l.col)
}

fn peek(l: *Lexer, ahead: i64) -> u8 {
    if l.off + ahead >= l.src.len {
        return 0
    }
    l.src[l.off + ahead]
}

fn advance(l: *Lexer) -> u8 {
    let c = l.src[l.off]
    l.off += 1
    if c == '\n' {
        l.line += 1
        l.col = 1
    } else {
        l.col += 1
    }
    c
}

fn emit(l: *Lexer, kind: Kind, at: diag.Pos) {
    l.emit_with(kind, at, 0, Extra {})
}

fn emit_text(l: *Lexer, kind: Kind, at: diag.Pos, value: str) {
    l.emit_with(kind, at, 0, Extra { has_text: true, text: value })
}

fn emit_with(l: *Lexer, kind: Kind, at: diag.Pos, char: u32, extra: Extra) {
    var e = extra
    if kind != Newline && l.doc.len > 0 {
        e.doc = text.join(l.doc, "\n")
        e.doc_at = l.doc_at
        l.doc = []
    }
    var index: i32 = -1
    if e.has_text || e.doc != "" {
        index = i32(l.extras.len)
        l.extras.push(e)
    }
    let lexeme = Lexeme { kind, start: i32(l.from), end: i32(l.off), line: i32(at.pos_line()), col: i32(at.pos_col()), char, extra: index }
    l.tokens.push(lexeme)
    l.last = kind
}

fn ends_statement(k: Kind) -> bool {
    match k {
        Ident => true
        Int => true
        Float => true
        Char => true
        String => true
        True => true
        False => true
        Break => true
        Continue => true
        Return => true
        RParen => true
        RBrace => true
        RBracket => true
        Question => true
        _ => false
    }
}

fn emit_newline(l: *Lexer, p: diag.Pos) {
    if ends_statement(l.last) {
        l.emit(Newline, p)
    }
}

fn continued(l: *Lexer) -> bool {
    let src = l.src
    var at = l.off
    for at < src.len {
        let c = src[at]
        if c == ' ' || c == '\t' || c == '\r' || c == '\n' {
            at += 1
        } else if c == '/' && at + 1 < src.len && src[at + 1] == '/' {
            for at < src.len && src[at] != '\n' {
                at += 1
            }
        } else if c == '|' {
            return at + 1 < src.len && src[at + 1] == '>'
        } else if c == '.' {
            return at + 1 >= src.len || src[at + 1] != '.'
        } else {
            return false
        }
    }
    false
}

fn skip_space(l: *Lexer) {
    for l.off < l.src.len {
        let c = l.peek(0)
        if c == ' ' || c == '\t' || c == '\r' {
            l.advance()
        } else if c == '/' && l.peek(1) == '/' {
            l.comment()
        } else {
            return
        }
    }
}

fn comment(l: *Lexer) {
    let start = l.off
    let at = l.pos()
    for l.off < l.src.len && l.peek(0) != '\n' {
        l.advance()
    }
    let line = l.src[start..l.off]
    if !text.starts_with(line, "///") {
        return
    }
    let body = line[3..]
    if text.starts_with(body, "/") || !l.line_start(start) {
        return
    }
    if l.doc.len == 0 {
        l.doc_at = at
    }
    l.doc.push(text.trim_suffix(text.trim_prefix(body, " "), "\r"))
}

fn line_start(l: *Lexer, from: i64) -> bool {
    var at = from
    for at > 0 {
        at -= 1
        let c = l.src[at]
        if c == '\n' {
            return true
        }
        if c != ' ' && c != '\t' {
            return false
        }
    }
    true
}

fn next(l: *Lexer) ! diag.Error {
    let start = l.pos()
    l.from = l.off
    let c = l.peek(0)
    if c == '\n' {
        if !l.continued() {
            l.emit_newline(start)
        }
        l.advance()
    } else if is_letter(c) {
        l.ident(start)?
    } else if is_digit(c) {
        l.number(start)?
    } else if c == '"' {
        l.string(start)?
    } else if c == '\'' {
        l.char(start)?
    } else {
        l.symbol(start)?
    }
}

fn ident(l: *Lexer, start: diag.Pos) ! diag.Error {
    let from = l.off
    for l.off < l.src.len && (is_letter(l.peek(0)) || is_digit(l.peek(0))) {
        l.advance()
    }
    let name = l.src[from..l.off]
    if text.starts_with(name, "__") && !l.privileged {
        fail At(start, "reserved-name", "names starting with __ are reserved")
    }
    l.emit(keyword(name) ?? Ident, start)
}

fn number(l: *Lexer, start: diag.Pos) ! diag.Error {
    let from = l.off
    var kind = Kind.Int
    if l.peek(0) == '0' && (l.peek(1) == 'x' || l.peek(1) == 'b' || l.peek(1) == 'o') {
        l.advance()
        l.advance()
        l.digits(is_hex_digit)
        l.emit_number(kind, from, start, is_hex_digit)?
        return
    }
    l.digits(is_digit)
    if l.peek(0) == '.' && is_digit(l.peek(1)) {
        kind = Float
        l.advance()
        l.digits(is_digit)
    }
    let e = l.peek(0)
    if e == 'e' || e == 'E' {
        kind = Float
        l.advance()
        let sign = l.peek(0)
        if sign == '+' || sign == '-' {
            l.advance()
        }
        l.digits(is_digit)
    }
    l.emit_number(kind, from, start, is_digit)?
}

fn digits(l: *Lexer, accept: fn(u8) -> bool) {
    for l.off < l.src.len && (accept(l.peek(0)) || l.peek(0) == '_') {
        l.advance()
    }
}

fn emit_number(l: *Lexer, kind: Kind, from: i64, start: diag.Pos, digit: fn(u8) -> bool) ! diag.Error {
    let raw = l.src[from..l.off]
    var separated = false
    for i in 0..raw.len {
        if raw[i] != '_' {
            continue
        }
        separated = true
        if i == 0 || i == raw.len - 1 || !digit(raw[i - 1]) || !digit(raw[i + 1]) {
            fail At(start, "number-separator", "_ in a number must sit between two digits")
        }
    }
    if !separated {
        l.emit(kind, start)
        return
    }
    let digits = text.replace(raw, "_", "")
    l.emit_text(kind, start, digits)
}

fn escape_value(letter: u8) -> u8? {
    match letter {
        'n' => '\n'
        't' => '\t'
        'r' => '\r'
        '0' => 0
        '\\' => '\\'
        '"' => '"'
        '\'' => '\''
        _ => none
    }
}

fn escape_letter(c: u8) -> u8? {
    match c {
        '\n' => 'n'
        '\t' => 't'
        '\r' => 'r'
        0 => '0'
        '\\' => '\\'
        '"' => '"'
        '\'' => '\''
        _ => none
    }
}

pub fn quote(s: str) -> str {
    var b = builder.with_capacity(s.len + 2)
    b.write_byte('"')
    var at = 0
    for at < s.len {
        at += write_quoted(mut b, s, at)
    }
    b.write_byte('"')
    b.to_str()
}

fn write_quoted(mut b: builder.Builder, s: str, at: i64) -> i64 {
    let c = s[at]
    match escape_letter(c) {
        some(letter) => {
            b.write_byte('\\')
            b.write_byte(letter)
            return 1
        }
        none => {}
    }
    if c == '{' || c == '}' {
        b.write_byte(c)
        b.write_byte(c)
        return 1
    }
    if c < 0x20 || c == 0x7F {
        b.write("\\x{c:x2}")
        return 1
    }
    if c < 0x80 {
        b.write_byte(c)
        return 1
    }
    let r = unicode.decode_rune(s, at)
    if r.code == 0xFFFD && r.size == 1 {
        b.write("\\x{c:x2}")
        return 1
    }
    for i in at..at + r.size {
        b.write_byte(s[i])
    }
    r.size
}

fn unterminated(l: *Lexer) -> bool {
    l.off >= l.src.len || l.peek(0) == '\n'
}

struct Escaped {
    code: u32
    raw: bool
}

fn escape(l: *Lexer, mut b: builder.Builder) ! diag.Error {
    let e = l.escape_code()?
    if e.raw {
        b.write_byte(u8(e.code))
    } else {
        b.write_char(e.code)
    }
}

fn escape_code(l: *Lexer) -> Escaped ! diag.Error {
    let at = l.pos()
    l.advance()
    if l.unterminated() {
        fail At(at, "escape", "unterminated escape sequence")
    }
    let letter = l.advance()
    match letter {
        'x' => return Escaped { code: l.hex_digits(at, 2)?, raw: true }
        'u' => {
            if !l.unterminated() && l.peek(0) == '{' {
                return l.braced_escape(at)?
            }
            return l.unicode_escape(at, 4)?
        }
        'U' => return l.unicode_escape(at, 8)?
        _ => {}
    }
    let e = escape_value(letter) ?? fail At(at, "escape", "unknown escape sequence")
    Escaped { code: u32(e), raw: true }
}

fn unicode_escape(l: *Lexer, at: diag.Pos, width: i64) -> Escaped ! diag.Error {
    let code = l.hex_digits(at, width)?
    scalar_escape(at, code)?
}

fn braced_escape(l: *Lexer, at: diag.Pos) -> Escaped ! diag.Error {
    l.advance()
    var value: i64 = 0
    var digits = 0
    for !l.unterminated() && is_hex_digit(l.peek(0)) {
        if digits == 6 {
            fail At(at, "escape", "escape sequence takes at most 6 hex digits")
        }
        value = value * 16 + hex_value(l.advance())
        digits += 1
    }
    if digits == 0 {
        fail At(at, "escape", "escape sequence needs 1 to 6 hex digits")
    }
    if l.unterminated() || l.peek(0) != '}' {
        fail At(at, "escape", "escape sequence needs a closing }}")
    }
    l.advance()
    scalar_escape(at, u32(value))?
}

fn scalar_escape(at: diag.Pos, code: u32) -> Escaped ! diag.Error {
    if (code >= 0xD800 && code <= 0xDFFF) || code > 0x10FFFF {
        fail At(at, "escape", "escape sequence is not a Unicode scalar value")
    }
    Escaped { code, raw: false }
}

fn hex_digits(l: *Lexer, at: diag.Pos, width: i64) -> u32 ! diag.Error {
    var value: i64 = 0
    for _ in 0..width {
        if l.unterminated() || !is_hex_digit(l.peek(0)) {
            fail At(at, "escape", "escape sequence needs {width} hex digits")
        }
        value = value * 16 + hex_value(l.advance())
    }
    u32(value)
}

fn hex_value(c: u8) -> i64 {
    if c >= '0' && c <= '9' {
        return i64(c) - 48
    }
    if c >= 'a' && c <= 'f' {
        return i64(c) - 87
    }
    i64(c) - 55
}

fn string(l: *Lexer, start: diag.Pos) ! diag.Error {
    l.advance()
    var parts: []Part = []
    var b = builder.builder()
    for {
        if l.unterminated() {
            fail At(start, "unterminated-string", "unterminated string")
        }
        let c = l.peek(0)
        let following = l.peek(1)
        if c == '"' {
            l.advance()
            l.emit_string(start, parts, b.to_str())
            return
        } else if (c == '{' && following == '{') || (c == '}' && following == '}') {
            l.advance()
            b.write_byte(l.advance())
        } else if c == '}' {
            fail At(l.pos(), "unmatched-brace", "unmatched }} in string; write }}}}")
        } else if c == '{' {
            parts.push(Part { text: b.to_str() })
            b.reset()
            let part = l.interpolation()?
            parts.push(part)
        } else if c == '\\' {
            l.escape(mut b)?
        } else {
            b.write_byte(l.advance())
        }
    }
}

fn emit_string(l: *Lexer, start: diag.Pos, parts: []Part, tail: str) {
    if parts.len == 0 {
        l.emit_text(String, start, tail)
        return
    }
    var all = parts
    all.push(Part { text: tail })
    l.emit_with(String, start, 0, Extra { has_text: true, parts: all })
}

fn interpolation(l: *Lexer) -> Part ! diag.Error {
    let open = l.pos()
    l.advance()
    let at = l.pos()
    var from = l.off
    let stop = l.expression_end(open)?
    let source = l.src[from..l.off]
    if text.trim(source) == "" {
        fail At(open, "empty-interpolation", "empty interpolation")
    }
    let tokens = lex_with(source, at, l.privileged, l.operators)?
    var part = Part { expr: true, tokens }
    if stop != '}' {
        part.spec_pos = l.pos()
        from = l.off
        l.spec_end(open)?
        part.spec = l.src[from..l.off]
    }
    l.advance()
    part
}

fn expression_end(l: *Lexer, open: diag.Pos) -> u8 ! diag.Error {
    var depth = 0
    for {
        if l.unterminated() {
            fail At(open, "unterminated-interpolation", "unterminated interpolation")
        }
        let c = l.peek(0)
        if c == '(' || c == '[' || c == '{' {
            depth += 1
        } else if c == ')' || c == ']' {
            depth = if depth > 0 { depth - 1 } else { 0 }
        } else if c == '}' {
            if depth == 0 {
                return c
            }
            depth -= 1
        } else if c == ',' || c == ':' {
            if depth == 0 {
                return c
            }
        } else if c == '"' || c == '\'' {
            l.skip_quoted(open)?
            continue
        }
        l.advance()
    }
    0
}

fn spec_end(l: *Lexer, open: diag.Pos) ! diag.Error {
    for l.peek(0) != '}' {
        if l.unterminated() {
            fail At(open, "unterminated-interpolation", "unterminated interpolation")
        }
        l.advance()
    }
}

fn skip_quoted(l: *Lexer, open: diag.Pos) ! diag.Error {
    let quote = l.advance()
    for {
        if l.unterminated() {
            fail At(open, "unterminated-interpolation", "unterminated interpolation")
        }
        let c = l.advance()
        if c == quote {
            return
        }
        if c == '\\' && !l.unterminated() {
            l.advance()
        }
    }
}

fn char(l: *Lexer, start: diag.Pos) ! diag.Error {
    l.advance()
    var code: u32 = 0
    if l.unterminated() || l.peek(0) == '\'' {
        fail At(start, "char-literal", "empty character literal")
    } else if l.peek(0) == '\\' {
        code = l.escape_code()?.code
    } else {
        let r = unicode.decode_rune(l.src, l.off)
        if r.code == 0xFFFD {
            fail At(start, "char-literal", "invalid UTF-8 in character literal")
        }
        for _ in 0..r.size {
            l.advance()
        }
        code = r.code
    }
    if l.unterminated() || l.peek(0) != '\'' {
        fail At(start, "char-literal", "character literal must hold one character")
    }
    l.advance()
    l.emit_with(Char, start, code, Extra {})
}

fn symbol(l: *Lexer, start: diag.Pos) ! diag.Error {
    let rest = l.src[l.off..]
    let first = rest[0]
    for op in l.operators {
        if op.text[0] != first || !text.starts_with(rest, op.text) {
            continue
        }
        for _ in 0..op.text.len {
            l.advance()
        }
        l.emit(op.kind, start)
        return
    }
    fail At(start, "unexpected-character", "unexpected character {quote_byte(l.peek(0))}")
}

fn quote_byte(c: u8) -> str {
    match c {
        '\'' => "'\\''"
        '\\' => "'\\\\'"
        7 => "'\\a'"
        8 => "'\\b'"
        12 => "'\\f'"
        '\n' => "'\\n'"
        '\r' => "'\\r'"
        '\t' => "'\\t'"
        11 => "'\\v'"
        _ => {
            if c < 0x20 || c == 0x7F {
                "'\\x{c:x2}'"
            } else if c >= 0x80 && c < 0xA1 || c == 0xAD {
                "'\\u{c:x4}'"
            } else {
                "'{text.from_char(u32(c))}'"
            }
        }
    }
}

fn is_letter(c: u8) -> bool {
    c == '_' || (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
}

fn is_hex_digit(c: u8) -> bool {
    is_digit(c) || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F')
}

fn is_digit(c: u8) -> bool {
    c >= '0' && c <= '9'
}
