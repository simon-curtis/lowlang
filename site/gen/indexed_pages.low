import std/builder
import std/path
import std/text

fn source_folder(source: str) -> str {
    "{packages_folder}{source}/"
}

fn version_folder(source: str, version: Version) -> str {
    "{source_folder(source)}{version.tag}/"
}

fn newest_listed(package: Indexed) -> Version? {
    for version in package.versions {
        if !version.yanked {
            return version
        }
    }
    none
}

fn short_commit(commit: str) -> str {
    if commit.len > 7 {
        return commit[..7]
    }
    commit
}

fn version_places(source: str, version: Version, std_modules: Module[], root: str) -> [str: Place] {
    var places = module_places(std_modules, "{root}{packages_folder}")
    for module in version.modules {
        let inside = text.strip_prefix(module.path, "{source}/") ?? continue
        places[inside] = Place { href: page_file(module.path), names: type_names_of(module) }
    }
    places
}

fn back_link(href: str, label: str) -> str {
    "<p class=\"back\"><a href=\"{href}\">{escape(label)}</a></p>"
}

fn module_list(version: Version) -> str {
    var rows: str[] = []
    for module in version.modules {
        rows.push("<li><a href=\"{page_file(module.path)}\"><code>{escape(module.path)}</code></a> <span class=\"text-sm\">{module.items.len} items</span></li>")
    }
    "<ul>\n{text.join(rows, "\n")}\n</ul>\n"
}

fn version_row(version: Version, newest: Version?) -> str {
    var marks: str[] = []
    if version.yanked {
        marks.push("yanked")
    }
    match newest {
        some(found) => {
            if found.tag == version.tag {
                marks.push("default")
            }
        }
        none => {}
    }
    var note = ""
    if marks.len > 0 {
        note = " <span class=\"text-sm\">{text.join(marks, ", ")}</span>"
    }
    "<li><a href=\"{version.tag}/index.html\"><code>{escape(version.tag)}</code></a>{note} <span class=\"text-sm\">{short_commit(version.commit)}, {version.modules.len} modules</span></li>"
}

fn package_document(chrome: Chrome, package: Indexed) -> str {
    let newest = newest_listed(package)
    var rows: str[] = []
    for version in package.versions {
        rows.push(version_row(version, newest))
    }
    var out = builder.builder()
    out.write("<pre><code>{low_unchecked("import {package.source}")}</code></pre>\n")
    var description = "{package.source}: {package.versions.len} versions, all yanked."
    match newest {
        some(found) => {
            out.write("<p>The default version is <a href=\"{found.tag}/index.html\"><code>{escape(found.tag)}</code></a>, the newest one that has not been yanked.</p>\n")
            description = "{package.source}: {package.versions.len} versions, default {found.tag}."
        }
        none => out.write("<p>Every version of this package is yanked.</p>\n")
    }
    out.write(section_heading("versions", "Versions"))
    out.write("<ul>\n{text.join(rows, "\n")}\n</ul>\n")
    match newest {
        some(found) => {
            out.write(section_heading("modules", "Modules"))
            out.write(module_list(found))
        }
        none => {}
    }
    let page = Page { path: "{source_folder(package.source)}index.html" }
    let sidebar = "<div class=\"space-y-8\">\n{back_link("{root_of(page)}{packages_folder}index.html", "← packages")}\n</div>"
    layout(chrome, Page { path: page.path, heading: package.source, title: "{package.source}: Low packages", description, current: packages_area, sidebar, body: out.to_str() })
}

fn version_document(chrome: Chrome, package: Indexed, version: Version) -> str {
    var out = builder.builder()
    out.write("<pre><code>{low_unchecked("import {package.source}")}</code></pre>\n")
    if version.yanked {
        out.write("<p><strong>Yanked.</strong> New projects will not resolve to this version. A project whose <code>build.lock</code> already names it still builds, with a warning.</p>\n")
    }
    out.write("<p>Commit <code>{short_commit(version.commit)}</code>, tree hash <code>{escape(version.hash)}</code>.</p>\n")
    out.write(section_heading("modules", "Modules"))
    out.write(module_list(version))
    let sidebar = "<div class=\"space-y-8\">\n{back_link("../index.html", "← {package.source}")}\n</div>"
    let heading = "{package.source} {version.tag}"
    layout(chrome, Page { path: "{version_folder(package.source, version)}index.html", heading, title: "{heading}: Low packages", description: "{heading}: {version.modules.len} modules.", current: packages_area, sidebar, body: out.to_str() })
}

fn write_version(site: str, chrome: Chrome, std_modules: Module[], package: Indexed, version: Version, listed: bool, library: Library, search: *SearchIndex) ! BuildError {
    let folder = version_folder(package.source, version)
    let target = path.join([site, folder])
    make_directories(target)?
    write_text(path.join([target, "index.html"]), version_document(chrome, package, version))?
    let places = version_places(package.source, version, std_modules, root_of(Page { path: "{folder}index.html" }))
    let back = "← {package.source} {version.tag}"
    for module in version.modules {
        let placement = Placement { path: "{folder}{page_file(module.path)}", places, back_href: "index.html", back_label: back, title: "{module.path} {version.tag}: Low packages", lead: "The {module.path} module of {package.source} {version.tag}.", verified: false }
        let page = package_page(module, "", "", placement, [:], library)
        let document = page_document(chrome, page)?
        if listed {
            register_package(page, search)
        }
        write_text(path.join([target, page_file(module.path)]), document)?
    }
}

fn write_indexed(site: str, chrome: Chrome, std_modules: Module[], packages: Indexed[], library: Library, search: *SearchIndex) ! BuildError {
    for package in packages {
        let newest = newest_listed(package)
        make_directories(path.join([site, source_folder(package.source)]))?
        write_text(path.join([site, source_folder(package.source), "index.html"]), package_document(chrome, package))?
        var description = ""
        match newest {
            some(found) => {
                description = "{package.versions.len} versions, default {found.tag}"
            }
            none => {}
        }
        add_page(search, PageEntry { title: package.source, area: packages_area, href: "{source_folder(package.source)}index.html", description, text: "" })
        for version in package.versions {
            var listed = false
            match newest {
                some(found) => {
                    listed = found.tag == version.tag
                }
                none => {}
            }
            write_version(site, chrome, std_modules, package, version, listed, library, search)?
        }
    }
}

fn package_row(package: Indexed) -> str {
    let newest = newest_listed(package)
    var detail = "{package.versions.len} versions, all yanked"
    match newest {
        some(found) => {
            detail = "{package.versions.len} versions, default {escape(found.tag)}"
        }
        none => {}
    }
    let searchable = escape(text.lower(package.source))
    let lines = [
        "<li class=\"module\" data-categories=\"\" data-search=\"{searchable}\">",
        "<a class=\"hit\" href=\"{package.source}/index.html\"><code>{escape(package.source)}</code></a> ",
        "<span class=\"text-sm\">{detail}</span></li>",
    ]
    text.join(lines, "")
}
