import std/builder
import std/maps
import std/markdown
import std/path
import std/slices
import std/text

const docs_area = "Docs"
const home_file = "index.html"
const summary_limit = 200
const section_script = "sections.js"
const fragment_link = "<a href=\"#"

struct DocPage {
    title: str
    depth: i64
    file: str
    blocks: markdown.Block[]
    body: str = ""
    description: str = ""
}

struct Headings {
    named: [str: HeadingTarget[]]
    anchors: [str: HeadingTarget[]]
}

struct HeadingTarget {
    page: i64
    href: str
}

fn slug(raw: str) -> str {
    let lowered = text.lower(raw)
    var out = builder.with_capacity(lowered.len)
    var dash = false
    for at in 0..lowered.len {
        let c = lowered[at]
        if (c >= 'a' && c <= 'z') || is_digit_byte(c) {
            if dash && out.len() > 0 {
                out.write_byte('-')
            }
            dash = false
            out.write_byte(c)
        } else {
            dash = true
        }
    }
    out.to_str()
}

fn heading_level(block: markdown.Block) -> i64 {
    match block {
        Heading(level, _, _) => level
        _ => 0
    }
}

fn heading_raw(block: markdown.Block) -> str {
    match block {
        Heading(_, raw, _) => raw
        _ => ""
    }
}

fn doc_chapters(design: markdown.Block[]) -> DocPage[] {
    var pages: DocPage[] = []
    for block in design {
        if heading_level(block) == 2 {
            let title = heading_raw(block)
            pages.push(DocPage { title, depth: 2, file: "{slug(title)}.html", blocks: [] })
        } else if pages.len > 0 {
            pages[pages.len - 1].blocks.push(block)
        }
    }
    pages
}

fn doc_preamble(design: markdown.Block[]) -> markdown.Block[] {
    var blocks: markdown.Block[] = []
    for block in design {
        let level = heading_level(block)
        if level == 2 {
            break
        }
        if level == 0 {
            blocks.push(block)
        }
    }
    blocks
}

fn without_titles(source: markdown.Block[]) -> markdown.Block[] {
    var blocks: markdown.Block[] = []
    for block in source {
        if heading_level(block) != 1 {
            blocks.push(block)
        }
    }
    blocks
}

fn doc_pages(design: markdown.Block[], editors: markdown.Block[], roadmap: str) -> DocPage[] {
    var pages = [DocPage { title: "Documentation", depth: 1, file: home_file, blocks: doc_preamble(design) }]
    for chapter in doc_chapters(design) {
        pages.push(chapter)
    }
    pages.push(DocPage { title: "Editors", depth: 1, file: "editors.html", blocks: without_titles(editors) })
    pages.push(DocPage { title: "Roadmap", depth: 1, file: "roadmap.html", blocks: [], body: roadmap })
    pages
}

fn add_target(mut index: [str: HeadingTarget[]], key: str, target: HeadingTarget) {
    var found = index[key] ?? []
    found.push(target)
    index[key] = found
}

fn heading_index(pages: DocPage[]) -> [str: HeadingTarget[]] {
    var index: [str: HeadingTarget[]] = [:]
    for number, page in pages {
        if page.depth == 2 {
            add_target(mut index, "## {page.title}", HeadingTarget { page: number, href: page.file })
        }
        for block in page.blocks {
            let level = heading_level(block)
            if level == 0 {
                continue
            }
            let raw = heading_raw(block)
            let hashes = text.repeat("#", level)
            add_target(mut index, "{hashes} {raw}", HeadingTarget { page: number, href: "{page.file}#{slug(raw)}" })
        }
    }
    index
}

fn heading_href(index: [str: HeadingTarget[]], key: str, number: i64, title: str) -> str ! BuildError {
    let found = index[key] ?? []
    var candidates: HeadingTarget[] = []
    for target in found {
        if target.page == number {
            candidates.push(target)
        }
    }
    if candidates.len == 0 {
        candidates = found
    }
    if candidates.len != 1 {
        fail Content("docs", "{title} references {key}, which names {found.len} headings")
    }
    candidates[0].href
}

fn anchor_index(pages: DocPage[]) -> [str: HeadingTarget[]] {
    var index: [str: HeadingTarget[]] = [:]
    for number, page in pages {
        if page.file != home_file {
            add_target(mut index, slug(page.title), HeadingTarget { page: number, href: page.file })
        }
        for block in page.blocks {
            if heading_level(block) == 0 {
                continue
            }
            let id = slug(heading_raw(block))
            add_target(mut index, id, HeadingTarget { page: number, href: "{page.file}#{id}" })
        }
    }
    index
}

fn across_pages(anchors: [str: HeadingTarget[]], title: str, folder: str, html: str) -> str ! BuildError {
    let parts = text.split_str(html, fragment_link)
    var out = builder.with_capacity(html.len)
    out.write(parts[0])
    for part in parts[1..] {
        let fragment = part[..text.index_byte(part, '"')]
        var href = "#{fragment}"
        if text.starts_with(part[fragment.len..], "\">") && !text.contains(html, "id=\"{fragment}\"") {
            href = "{folder}{heading_href(anchors, fragment, -1, title)?}"
        }
        out.write("<a href=\"{href}")
        out.write(part[fragment.len..])
    }
    out.to_str()
}

fn is_reference(source: str) -> bool {
    var hashes = 0
    for hashes < source.len && source[hashes] == '#' {
        hashes += 1
    }
    if hashes < 2 || hashes > 6 || hashes + 1 >= source.len || source[hashes] != ' ' {
        return false
    }
    space_width(source, hashes + 1) == 0
}

fn named(raw: str) -> str? {
    if raw.len < 3 || raw[0] != '`' || raw[raw.len - 1] != '`' {
        return none
    }
    let name = raw[1..raw.len - 1]
    if word_end(name, 0) != name.len {
        return none
    }
    name
}

fn bind_name(mut entries: [str: str], name: str?, href: str) {
    match name {
        some(found) => {
            entries[found] = href
        }
        none => {}
    }
}

fn builtin_pages(chapters: DocPage[]) -> [str: str] ! BuildError {
    let chapter = slices.find(chapters, fn(page) page.title == "Builtins") ?? fail Message("docs/design.md has no Builtins chapter")
    let page = "{docs_folder}{chapter.file}"
    var entries: [str: str] = [:]
    var section = ""
    for block in chapter.blocks {
        match block {
            Heading(_, raw, _) => {
                section = slug(raw)
                bind_name(mut entries, named(raw), "{page}#{section}")
            }
            Table(table) => {
                for row in table.rows {
                    bind_name(mut entries, named(row[0].raw), "{page}#{section}")
                }
            }
            _ => {}
        }
    }
    entries
}

fn prelude_of(html: str) -> Prelude? {
    let opening = "<!-- prelude"
    if !text.starts_with(html, opening) {
        return none
    }
    var at = opening.len
    if at < html.len && html[at] == ' ' {
        at += 1
    }
    let path_start = at
    for at < html.len && space_width(html, at) == 0 {
        at += rune_size(html, at)
    }
    if at >= html.len || html[at] != '\n' {
        return none
    }
    let rest = html[at + 1..]
    let close = text.index(rest, "-->")
    if close < 0 {
        return none
    }
    var body = rest[..close]
    if text.ends_with(body, "\n") {
        body = body[..body.len - 1]
    }
    Prelude { path: html[path_start..at], text: body }
}

fn hidden_prelude(block: markdown.Block) -> Prelude? {
    match block {
        Html(source) => prelude_of(source)
        _ => none
    }
}

fn enlist_fence(batch: *Batch, page: DocPage, block: markdown.Block, preludes: Prelude[]) {
    match block {
        Code(lang, _, source) => {
            if lang != "low" || maps.has(batch.docs, source) {
                return
            }
            let first = text.split(source, '\n')[0]
            batch.docs[source] = enlist(batch, program(source, preludes), "{page.title}: {first}")
        }
        _ => {}
    }
}

fn collect_docs(batch: *Batch, pages: DocPage[]) {
    for page in pages {
        var preludes: Prelude[] = []
        for block in page.blocks {
            let hidden = hidden_prelude(block)
            match hidden {
                some(found) => {
                    preludes.push(found)
                    continue
                }
                none => {}
            }
            enlist_fence(batch, page, block, preludes)
            preludes = []
        }
    }
}

fn lead_text(content: markdown.Inline[]) -> str {
    trim_space(collapse_space(markdown.plain_text(content)))
}

fn complete_sentences(lead: str) -> str {
    if !text.ends_with(lead, ":") {
        return lead
    }
    let end = text.last_index(lead, ". ")
    if end < 0 {
        return ""
    }
    lead[..end + 1]
}

fn first_paragraph(blocks: markdown.Block[]) -> markdown.Inline[]? {
    for block in blocks {
        match block {
            Paragraph(content) => {
                return content
            }
            _ => {}
        }
    }
    none
}

fn page_description(page: DocPage) -> str {
    match first_paragraph(page.blocks) {
        some(content) => {
            let sentences = complete_sentences(lead_text(content))
            if sentences.len > 0 {
                return summary(sentences, summary_limit)
            }
        }
        none => {}
    }
    "{page.title} in the Low documentation."
}

fn doc_heading(depth: i64, level: i64, raw: str, inner: str) -> str {
    let shown = level - depth + 1
    let id = slug(raw)
    "<h{shown} id=\"{id}\"><a href=\"#{id}\">{inner}</a></h{shown}>\n"
}

fn doc_html(r: markdown.Renderer, source: str) -> str {
    let hidden = prelude_of(source)
    match hidden {
        some(_) => ""
        none => source
    }
}

fn doc_table(r: markdown.Renderer, table: markdown.Table) -> str {
    let labelled = table.header.len > 2
    var head = builder.builder()
    for cell in table.header {
        let inner = markdown.render_inline(r, cell.content)
        head.write("<th scope=\"col\">{inner}</th>")
    }
    var rows: str[] = []
    for row in table.rows {
        var cells = builder.builder()
        for column, cell in row {
            var label = ""
            if labelled && column < table.header.len {
                label = " data-label=\"{escape(table.header[column].raw)}\""
            }
            let inner = markdown.render_inline(r, cell.content)
            cells.write("<td{label}>{inner}</td>")
        }
        rows.push("<tr>{cells.to_str()}</tr>")
    }
    let lines = ["<div class=\"overflow-x-auto\"><table>", "<thead><tr>{head.to_str()}</tr></thead>", "<tbody>", text.join(rows, "\n"), "</tbody>", "</table></div>"]
    "{text.join(lines, "\n")}\n"
}

fn module_href(library: Library, packages: str, source: str) -> str? {
    let module = library.modules[source]
    match module {
        some(_) => "{packages}{page_file(source)}"
        none => none
    }
}

fn reference_span(index: [str: HeadingTarget[]], library: Library, packages: str, title: str, number: i64, source: str) -> str ! BuildError {
    let code = codespan(source)
    if is_reference(source) {
        let href = heading_href(index, source, number, title)?
        return "<a href=\"{href}\">{code}</a>"
    }
    let module = module_href(library, packages, source)
    match module {
        some(href) => "<a href=\"{href}\">{code}</a>"
        none => code
    }
}

fn render_doc(page: DocPage, number: i64, library: Library, snippets: [str: Checked], index: [str: HeadingTarget[]], anchors: [str: HeadingTarget[]]) -> str ! BuildError {
    let linker = new(Linker { library, root: root_of(Page { path: "{docs_folder}{page.file}" }), snippets: 0 })
    var problems: BuildError[] = []
    let renderer = markdown.Renderer {
        code_block: code_renderer(linker, snippets),
        code_span: fn(r, source) {
            reference_span(index, library, "../{packages_folder}", page.title, number, source) catch {
                cause => {
                    problems.push(cause)
                    codespan(source)
                }
            }
        },
        heading: fn(r, level, raw, inner) doc_heading(page.depth, level, raw, inner),
        html_block: doc_html,
        table: doc_table,
    }
    let html = markdown.render(renderer, page.blocks)
    if problems.len > 0 {
        fail problems[0]
    }
    across_pages(anchors, page.title, "", html)
}

fn contents_list(pages: DocPage[]) -> str {
    var items: str[] = []
    for page in pages {
        if page.file != home_file {
            items.push("<li><a href=\"{page.file}\">{escape(page.title)}</a></li>")
        }
    }
    "<ul>\n{text.join(items, "\n")}\n</ul>\n"
}

fn render_docs(pages: DocPage[], library: Library, snippets: [str: Checked]) -> DocPage[] ! BuildError {
    let index = heading_index(pages)
    let anchors = anchor_index(pages)
    let contents = contents_list(pages)
    var rendered: DocPage[] = []
    for number, page in pages {
        var body = page.body
        if body.len == 0 {
            body = render_doc(page, number, library, snippets, index, anchors)?
        }
        if page.file == home_file {
            body = "{body}{contents}"
        }
        rendered.push(DocPage { title: page.title, depth: page.depth, file: page.file, blocks: page.blocks, body, description: page_description(page) })
    }
    rendered
}

fn section_links(body: str) -> str[] {
    var items: str[] = []
    for heading in headings(body) {
        if body[heading.start + 2] != '2' {
            continue
        }
        let id = identifier_of(heading.attributes) ?? continue
        items.push("<li><a href=\"#{id}\">{escape(plain(heading.inner))}</a></li>")
    }
    if items.len < 2 {
        return []
    }
    items
}

fn sidebar_entry(entry: DocPage, page: DocPage) -> str {
    if entry.file != page.file {
        return "<li><a href=\"{entry.file}\">{escape(entry.title)}</a></li>"
    }
    let current = "<a aria-current=\"page\" href=\"{entry.file}\">{escape(entry.title)}</a>"
    let sections = section_links(page.body)
    if sections.len == 0 {
        return "<li>{current}</li>"
    }
    "<li>{current}\n<ul class=\"sublist\">\n{text.join(sections, "\n")}\n</ul>\n</li>"
}

fn doc_sidebar(page: DocPage, pages: DocPage[]) -> str {
    var items: str[] = []
    for entry in pages {
        items.push(sidebar_entry(entry, page))
    }
    "<ul class=\"sidelist\">\n{text.join(items, "\n")}\n</ul>"
}

fn doc_outline(body: str) -> str {
    let sections = section_links(body)
    if sections.len == 0 {
        return ""
    }
    "<p class=\"label\">On this page</p>\n<ul>\n{text.join(sections, "\n")}\n</ul>"
}

fn doc_document(chrome: Chrome, page: DocPage, pages: DocPage[]) -> str {
    var title = "{page.title}: Low documentation"
    if page.file == home_file {
        title = "Low documentation"
    }
    layout(chrome, Page { path: "{docs_folder}{page.file}", heading: page.title, title, description: page.description, current: docs_area, sidebar: doc_sidebar(page, pages), outline: doc_outline(page.body), body: page.body, scripts: [section_script] })
}

fn write_docs(root: str, chrome: Chrome, pages: DocPage[], search: *SearchIndex) ! BuildError {
    for page in pages {
        add_document(search, Document { title: page.title, area: docs_area, path: "{docs_folder}{page.file}", description: page.description, html: page.body })
    }
    let folder = path.join([root, "site", docs_folder])
    remove_tree(folder)?
    make_directories(folder)?
    for page in pages {
        write_text(path.join([folder, page.file]), doc_document(chrome, page, pages))?
    }
}
