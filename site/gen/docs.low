import std/builder
import std/maps
import std/markdown
import std/path
import std/slices
import std/text

const docs_area = "Docs"
const home_file = "index.html"
const summary_limit = 200

struct DocPage {
    title: str
    depth: i64
    file: str
    blocks: []markdown.Block
    body: str = ""
    description: str = ""
}

struct HeadingTarget {
    page: i64
    href: str
}

fn slug(raw: str) -> str {
    let lowered = text.lower(raw)
    var out = builder.with_capacity(lowered.len)
    var dash = false
    for at in 0..lowered.len {
        let c = lowered[at]
        if (c >= 'a' && c <= 'z') || is_digit_byte(c) {
            if dash && out.len() > 0 {
                out.write_byte('-')
            }
            dash = false
            out.write_byte(c)
        } else {
            dash = true
        }
    }
    out.to_str()
}

fn heading_level(block: markdown.Block) -> i64 {
    match block {
        Heading(level, _, _) => level
        _ => 0
    }
}

fn heading_raw(block: markdown.Block) -> str {
    match block {
        Heading(_, raw, _) => raw
        _ => ""
    }
}

fn doc_chapters(design: []markdown.Block) -> []DocPage {
    var pages: []DocPage = []
    for block in design {
        if heading_level(block) == 2 {
            let title = heading_raw(block)
            push(mut pages, DocPage { title, depth: 2, file: "{slug(title)}.html", blocks: [] })
        } else if pages.len > 0 {
            push(mut pages[pages.len - 1].blocks, block)
        }
    }
    pages
}

fn doc_preamble(design: []markdown.Block) -> []markdown.Block {
    var blocks: []markdown.Block = []
    for block in design {
        let level = heading_level(block)
        if level == 2 {
            break
        }
        if level == 0 {
            push(mut blocks, block)
        }
    }
    blocks
}

fn without_titles(source: []markdown.Block) -> []markdown.Block {
    var blocks: []markdown.Block = []
    for block in source {
        if heading_level(block) != 1 {
            push(mut blocks, block)
        }
    }
    blocks
}

fn doc_pages(design: []markdown.Block, editors: []markdown.Block, roadmap: str) -> []DocPage {
    var pages = [DocPage { title: "Documentation", depth: 1, file: home_file, blocks: doc_preamble(design) }]
    for chapter in doc_chapters(design) {
        push(mut pages, chapter)
    }
    push(mut pages, DocPage { title: "Editors", depth: 1, file: "editors.html", blocks: without_titles(editors) })
    push(mut pages, DocPage { title: "Roadmap", depth: 1, file: "roadmap.html", blocks: [], body: roadmap })
    pages
}

fn add_target(mut index: [str: []HeadingTarget], key: str, target: HeadingTarget) {
    var found = index[key] ?? []
    push(mut found, target)
    index[key] = found
}

fn heading_index(pages: []DocPage) -> [str: []HeadingTarget] {
    var index: [str: []HeadingTarget] = [:]
    for number, page in pages {
        if page.depth == 2 {
            add_target(mut index, "## {page.title}", HeadingTarget { page: number, href: page.file })
        }
        for block in page.blocks {
            let level = heading_level(block)
            if level == 0 {
                continue
            }
            let raw = heading_raw(block)
            let hashes = text.repeat("#", level)
            add_target(mut index, "{hashes} {raw}", HeadingTarget { page: number, href: "{page.file}#{slug(raw)}" })
        }
    }
    index
}

fn heading_href(index: [str: []HeadingTarget], key: str, number: i64, title: str) -> str ! BuildError {
    let found = index[key] ?? []
    var candidates: []HeadingTarget = []
    for target in found {
        if target.page == number {
            push(mut candidates, target)
        }
    }
    if candidates.len == 0 {
        candidates = found
    }
    if candidates.len != 1 {
        fail Content("docs", "{title} references {key}, which names {found.len} headings")
    }
    candidates[0].href
}

fn is_reference(source: str) -> bool {
    var hashes = 0
    for hashes < source.len && source[hashes] == '#' {
        hashes += 1
    }
    if hashes < 2 || hashes > 6 || hashes + 1 >= source.len || source[hashes] != ' ' {
        return false
    }
    space_width(source, hashes + 1) == 0
}

fn named(raw: str) -> str? {
    if raw.len < 3 || raw[0] != '`' || raw[raw.len - 1] != '`' {
        return none
    }
    let name = raw[1..raw.len - 1]
    if word_end(name, 0) != name.len {
        return none
    }
    name
}

fn bind_name(mut entries: [str: str], name: str?, href: str) {
    match name {
        some(found) => {
            entries[found] = href
        }
        none => {}
    }
}

fn builtin_pages(chapters: []DocPage) -> [str: str] ! BuildError {
    let chapter = slices.find(chapters, fn(page) page.title == "Builtins") ?? fail Message("docs/design.md has no Builtins chapter")
    let page = "{docs_folder}{chapter.file}"
    var entries: [str: str] = [:]
    var section = ""
    for block in chapter.blocks {
        match block {
            Heading(_, raw, _) => {
                section = slug(raw)
                bind_name(mut entries, named(raw), "{page}#{section}")
            }
            Table(table) => {
                for row in table.rows {
                    bind_name(mut entries, named(row[0].raw), "{page}#{section}")
                }
            }
            _ => {}
        }
    }
    entries
}

fn prelude_of(html: str) -> Prelude? {
    let opening = "<!-- prelude"
    if !text.starts_with(html, opening) {
        return none
    }
    var at = opening.len
    if at < html.len && html[at] == ' ' {
        at += 1
    }
    let path_start = at
    for at < html.len && space_width(html, at) == 0 {
        at += rune_size(html, at)
    }
    if at >= html.len || html[at] != '\n' {
        return none
    }
    let rest = html[at + 1..]
    let close = text.index(rest, "-->")
    if close < 0 {
        return none
    }
    var body = rest[..close]
    if text.ends_with(body, "\n") {
        body = body[..body.len - 1]
    }
    Prelude { path: html[path_start..at], text: body }
}

fn hidden_prelude(block: markdown.Block) -> Prelude? {
    match block {
        Html(source) => prelude_of(source)
        _ => none
    }
}

fn enlist_fence(batch: *Batch, page: DocPage, block: markdown.Block, preludes: []Prelude) {
    match block {
        Code(lang, _, source) => {
            if lang != "low" || maps.has(batch.docs, source) {
                return
            }
            let first = text.split(source, '\n')[0]
            batch.docs[source] = enlist(batch, program(source, preludes), "{page.title}: {first}")
        }
        _ => {}
    }
}

fn collect_docs(batch: *Batch, pages: []DocPage) {
    for page in pages {
        var preludes: []Prelude = []
        for block in page.blocks {
            let hidden = hidden_prelude(block)
            match hidden {
                some(found) => {
                    push(mut preludes, found)
                    continue
                }
                none => {}
            }
            enlist_fence(batch, page, block, preludes)
            preludes = []
        }
    }
}

fn flush_run(mut tokens: []str, mut run: str) {
    if run.len > 0 {
        push(mut tokens, run)
        run = ""
    }
}

fn token_text(node: markdown.Inline) -> str {
    match node {
        Escape(value) => value
        Code(value) => value
        Emphasis(children) => markdown.plain_text(children)
        Strong(children) => markdown.plain_text(children)
        Strikethrough(children) => markdown.plain_text(children)
        Link(_, _, children) => markdown.plain_text(children)
        Image(_, _, alt) => markdown.plain_text(alt)
        Autolink(_, label) => label
        Html(value) => value
        _ => ""
    }
}

fn lead_text(content: []markdown.Inline) -> str {
    var tokens: []str = []
    var run = ""
    for node in content {
        match node {
            Text(value) => {
                run = "{run}{value}"
            }
            Entity(raw, _) => {
                run = "{run}{raw}"
            }
            SoftBreak => {
                run = "{run}\n"
            }
            _ => {
                flush_run(mut tokens, mut run)
                push(mut tokens, token_text(node))
            }
        }
    }
    flush_run(mut tokens, mut run)
    let joined = text.join(tokens, " ")
    trim_space(collapse_space(joined))
}

fn first_paragraph(blocks: []markdown.Block) -> []markdown.Inline? {
    for block in blocks {
        match block {
            Paragraph(content) => {
                return content
            }
            _ => {}
        }
    }
    none
}

fn page_description(page: DocPage) -> str {
    let lead = first_paragraph(page.blocks)
    match lead {
        some(content) => utf16_prefix(lead_text(content), summary_limit)
        none => "{page.title} in the Low documentation."
    }
}

fn doc_heading(depth: i64, level: i64, raw: str, inner: str) -> str {
    let shown = level - depth + 1
    let id = slug(raw)
    "<h{shown} id=\"{id}\"><a href=\"#{id}\">{inner}</a></h{shown}>\n"
}

fn doc_html(r: markdown.Renderer, source: str) -> str {
    let hidden = prelude_of(source)
    match hidden {
        some(_) => ""
        none => source
    }
}

fn doc_table(r: markdown.Renderer, table: markdown.Table) -> str {
    let labelled = table.header.len > 2
    var head = builder.builder()
    for cell in table.header {
        let inner = markdown.render_inline(r, cell.content)
        head.write("<th scope=\"col\">{inner}</th>")
    }
    var rows: []str = []
    for row in table.rows {
        var cells = builder.builder()
        for column, cell in row {
            var label = ""
            if labelled && column < table.header.len {
                label = " data-label=\"{escape(table.header[column].raw)}\""
            }
            let inner = markdown.render_inline(r, cell.content)
            cells.write("<td{label}>{inner}</td>")
        }
        push(mut rows, "<tr>{cells.to_str()}</tr>")
    }
    let lines = ["<div class=\"overflow-x-auto\"><table>", "<thead><tr>{head.to_str()}</tr></thead>", "<tbody>", text.join(rows, "\n"), "</tbody>", "</table></div>"]
    "{text.join(lines, "\n")}\n"
}

fn reference_span(index: [str: []HeadingTarget], page: DocPage, number: i64, source: str) -> str ! BuildError {
    let code = codespan(source)
    if !is_reference(source) {
        return code
    }
    let href = heading_href(index, source, number, page.title)?
    "<a href=\"{href}\">{code}</a>"
}

fn render_doc(page: DocPage, number: i64, library: Library, snippets: [str: Checked], index: [str: []HeadingTarget]) -> str ! BuildError {
    let linker = new(Linker { library, root: root_of(Page { path: "{docs_folder}{page.file}" }), snippets: 0 })
    var problems: []BuildError = []
    let renderer = markdown.Renderer {
        code_block: code_renderer(linker, snippets),
        code_span: fn(r, source) {
            reference_span(index, page, number, source) catch {
                cause => {
                    push(mut problems, cause)
                    codespan(source)
                }
            }
        },
        heading: fn(r, level, raw, inner) doc_heading(page.depth, level, raw, inner),
        html_block: doc_html,
        table: doc_table,
    }
    let html = markdown.render(renderer, page.blocks)
    if problems.len > 0 {
        fail problems[0]
    }
    html
}

fn contents_list(pages: []DocPage) -> str {
    var items: []str = []
    for page in pages {
        if page.file != home_file {
            push(mut items, "<li><a href=\"{page.file}\">{escape(page.title)}</a></li>")
        }
    }
    "<ul>\n{text.join(items, "\n")}\n</ul>\n"
}

fn render_docs(pages: []DocPage, library: Library, snippets: [str: Checked]) -> []DocPage ! BuildError {
    let index = heading_index(pages)
    let contents = contents_list(pages)
    var rendered: []DocPage = []
    for number, page in pages {
        var body = page.body
        if body.len == 0 {
            body = render_doc(page, number, library, snippets, index)?
        }
        if page.file == home_file {
            body = "{body}{contents}"
        }
        push(mut rendered, DocPage { title: page.title, depth: page.depth, file: page.file, blocks: page.blocks, body, description: page_description(page) })
    }
    rendered
}

fn doc_sidebar(page: DocPage, pages: []DocPage) -> str {
    var items: []str = []
    for entry in pages {
        var style = " class=\"hover:underline hover:underline-offset-4\""
        if entry.file == page.file {
            style = " class=\"font-bold underline underline-offset-4\" aria-current=\"page\""
        }
        push(mut items, "<li><a{style} href=\"{entry.file}\">{escape(entry.title)}</a></li>")
    }
    "<ul class=\"sidelist\">\n{text.join(items, "\n")}\n</ul>"
}

fn doc_document(chrome: Chrome, page: DocPage, pages: []DocPage) -> str {
    var title = "{page.title}: Low documentation"
    if page.file == home_file {
        title = "Low documentation"
    }
    layout(chrome, Page { path: "{docs_folder}{page.file}", heading: page.title, title, description: page.description, current: docs_area, sidebar: doc_sidebar(page, pages), body: page.body })
}

fn write_docs(root: str, chrome: Chrome, pages: []DocPage, search: *SearchIndex) ! BuildError {
    for page in pages {
        add_document(search, Document { title: page.title, area: docs_area, path: "{docs_folder}{page.file}", description: page.description, html: page.body })
    }
    let folder = path.join([root, "site", docs_folder])
    remove_tree(folder)?
    make_directories(folder)?
    for page in pages {
        write_text(path.join([folder, page.file]), doc_document(chrome, page, pages))?
    }
}
