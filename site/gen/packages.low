import std/json
import std/process
import std/text

struct Import {
    path: str
    alias: str
}

struct Item {
    kind: str
    name: str
    receiver: str = ""
    text: str
    doc: str = ""
    file: str
    line: i64
}

struct Example {
    name: str
    source: str
    output: str
}

struct Module {
    path: str
    imports: Import[]
    items: Item[]
    examples: Example[]
}

struct Version {
    tag: str
    commit: str
    hash: str
    yanked: bool
    modules: Module[]
}

struct Indexed {
    source: str
    versions: Version[]
}

struct Members {
    types: Item[]
    constants: Item[]
    functions: Item[]
}

fn standard_modules(binary: str, root: str) -> Module[] ! BuildError {
    var command = process.command(binary, ["doc", "std", "--target", check_target])
    command.dir = root
    let output = run_command(command)?
    if !process.success(output.status) {
        fail Command("low doc std", failure_detail(output))
    }
    json.deserialize[Module[]](output.stdout) catch {
        cause => fail Data("low doc std", "unreadable output: {cause}")
    }
}

fn indexed_packages(binary: str, root: str) -> Indexed[] ! BuildError {
    var command = process.command(binary, ["doc", "index", "--target", check_target])
    command.dir = root
    let output = run_command(command)?
    if !process.success(output.status) {
        fail Command("low doc index", failure_detail(output))
    }
    json.deserialize[Indexed[]](output.stdout) catch {
        cause => fail Data("low doc index", "unreadable output: {cause}")
    }
}

fn members(module: Module) -> Members {
    var found = Members { types: [], constants: [], functions: [] }
    for item in module.items {
        if item.kind == "struct" || item.kind == "enum" {
            found.types.push(item)
        } else if item.kind == "const" {
            found.constants.push(item)
        } else if item.kind == "fn" && item.receiver == "" {
            found.functions.push(item)
        }
    }
    found
}

fn example_anchor(example: Example) -> str {
    "example-{example.name}"
}

fn example_source(example: Example) -> str {
    text.trim_end(example.source)
}

fn summary(content: str, limit: i64) -> str {
    if utf16_length(content) <= limit {
        return content
    }
    var units = 0
    var at = 0
    var cut = -1
    var sentence = -1
    for at < content.len && units <= limit {
        if content[at] == ' ' {
            cut = at
            if at > 0 && content[at - 1] == '.' {
                sentence = at
            }
        }
        let size = rune_size(content, at)
        units += if size == 4 { 2 } else { 1 }
        at += size
    }
    if sentence > 0 {
        return content[..sentence]
    }
    if cut < 0 {
        return "{content[..content.len - rune_size_before(content, content.len)]}…"
    }
    "{content[..cut]}…"
}

fn rune_size_before(content: str, end: i64) -> i64 {
    var start = end - 1
    for start > 0 && content[start] & 0xC0 == 0x80 {
        start -= 1
    }
    end - start
}

fn tags(module_path: str) -> str {
    var links: str[] = []
    for name in categories(module_path) {
        links.push("<a class=\"tag\" href=\"index.html?category={name}\">#{name}</a>")
    }
    text.join(links, " ")
}
