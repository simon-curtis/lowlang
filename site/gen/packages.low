import std/json
import std/process
import std/text

struct Import {
    path: str
    alias: str
}

struct Item {
    kind: str
    name: str
    receiver: str = ""
    text: str
    doc: str = ""
    file: str
    line: i64
}

struct Example {
    name: str
    source: str
    output: str
}

struct Module {
    path: str
    imports: []Import
    items: []Item
    examples: []Example
}

struct Members {
    types: []Item
    constants: []Item
    functions: []Item
}

fn standard_modules(binary: str, root: str) -> []Module ! BuildError {
    var command = process.command(binary, ["doc", "std", "-target", check_target])
    command.dir = root
    let output = run_command(command)?
    if !process.success(output.status) {
        fail Command("low doc std", failure_detail(output))
    }
    json.deserialize[[]Module](output.stdout) catch {
        cause => fail Data("low doc std", "unreadable output: {cause}")
    }
}

fn members(module: Module) -> Members {
    var found = Members { types: [], constants: [], functions: [] }
    for item in module.items {
        if item.kind == "struct" || item.kind == "enum" {
            push(mut found.types, item)
        } else if item.kind == "const" {
            push(mut found.constants, item)
        } else if item.kind == "fn" && item.receiver == "" {
            push(mut found.functions, item)
        }
    }
    found
}

fn example_anchor(example: Example) -> str {
    "example-{example.name}"
}

fn example_source(example: Example) -> str {
    text.trim_end(example.source)
}

fn summary(content: str, limit: i64) -> str {
    if utf16_length(content) <= limit {
        return content
    }
    var units = 0
    var at = 0
    var cut = -1
    for at < content.len && units <= limit {
        if content[at] == ' ' {
            cut = at
        }
        let size = rune_size(content, at)
        units += if size == 4 { 2 } else { 1 }
        at += size
    }
    if cut < 0 {
        return "{content[..content.len - rune_size_before(content, content.len)]}…"
    }
    "{content[..cut]}…"
}

fn rune_size_before(content: str, end: i64) -> i64 {
    var start = end - 1
    for start > 0 && content[start] & 0xC0 == 0x80 {
        start -= 1
    }
    end - start
}

fn tags(module_path: str) -> str {
    var links: []str = []
    for name in categories(module_path) {
        push(mut links, "<a class=\"tag\" href=\"index.html?category={name}\">#{name}</a>")
    }
    text.join(links, " ")
}
