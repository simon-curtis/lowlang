import std/builder
import std/slices
import std/text

struct PageEntry {
    title: str
    area: str
    href: str
    description: str
    text: str
}

struct SectionEntry {
    page: i64
    kind: str
    name: str
    href: str
    signature: str
    text: str
}

struct SearchIndex {
    pages: []PageEntry
    sections: []SectionEntry
}

struct Document {
    title: str
    area: str
    path: str
    description: str
    html: str
}

struct Heading {
    start: i64
    end: i64
    attributes: str
    inner: str
}

fn block_tags() -> []str {
    ["p", "li", "ul", "ol", "tr", "td", "th", "table", "pre", "div", "section", "h1", "h2", "h3", "h4", "h5", "h6", "br"]
}

fn block_tag_end(html: str, at: i64) -> i64 {
    var name_start = at + 1
    if name_start < html.len && html[name_start] == '/' {
        name_start += 1
    }
    let name_end = word_end(html, name_start)
    if !slices.contains(block_tags(), html[name_start..name_end]) {
        return -1
    }
    let close = text.index_byte(html[name_end..], '>')
    if close < 0 {
        return -1
    }
    name_end + close + 1
}

fn blocks_to_spaces(html: str) -> str {
    var out = builder.with_capacity(html.len)
    var at = 0
    for at < html.len {
        if html[at] == '<' {
            let end = block_tag_end(html, at)
            if end >= 0 {
                out.write(" ")
                at = end
                continue
            }
        }
        out.write_byte(html[at])
        at += 1
    }
    out.to_str()
}

fn collapse_space(source: str) -> str {
    var out = builder.with_capacity(source.len)
    var at = 0
    for at < source.len {
        let blank = space_end(source, at)
        if blank > at {
            out.write(" ")
            at = blank
        } else {
            out.write_byte(source[at])
            at += 1
        }
    }
    out.to_str()
}

fn plain(html: str) -> str {
    let spaced = blocks_to_spaces(html)
    let stripped = text_of(spaced)
    let collapsed = collapse_space(stripped)
    trim_space(collapsed)
}

fn heading_at(html: str, at: i64) -> Heading? {
    if !text.starts_with(html[at..], "<h") || at + 3 > html.len {
        return none
    }
    let level = html[at + 2]
    if level < '2' || level > '4' {
        return none
    }
    let attributes_start = at + 3
    if attributes_start < html.len && is_word_byte(html[attributes_start]) {
        return none
    }
    let tag_close = text.index_byte(html[attributes_start..], '>')
    if tag_close < 0 {
        return none
    }
    let inner_start = attributes_start + tag_close + 1
    let level_text = text.from_char(u32(level))
    let closing = "</h{level_text}>"
    let inner_length = text.index(html[inner_start..], closing)
    if inner_length < 0 {
        return none
    }
    Heading {
        start: at,
        end: inner_start + inner_length + closing.len,
        attributes: html[attributes_start..attributes_start + tag_close],
        inner: html[inner_start..inner_start + inner_length],
    }
}

fn headings(html: str) -> []Heading {
    var found: []Heading = []
    var at = 0
    for at < html.len {
        let heading = heading_at(html, at)
        match heading {
            some(item) => {
                push(mut found, item)
                at = item.end
            }
            none => {
                at += 1
            }
        }
    }
    found
}

fn identifier_of(attributes: str) -> str? {
    var at = 0
    for at < attributes.len {
        let start = text.index(attributes[at..], "id=\"")
        if start < 0 {
            return none
        }
        let value_start = at + start + 4
        let boundary_ok = at + start == 0 || !is_word_byte(attributes[at + start - 1])
        if boundary_ok {
            let close = text.index_byte(attributes[value_start..], '"')
            if close < 0 {
                return none
            }
            return attributes[value_start..value_start + close]
        }
        at = value_start
    }
    none
}

fn add_page(index: *SearchIndex, entry: PageEntry) -> i64 {
    push(mut index.pages, entry)
    index.pages.len - 1
}

fn add_section(index: *SearchIndex, entry: SectionEntry) {
    push(mut index.sections, entry)
}

fn add_document(index: *SearchIndex, document: Document) {
    let found = headings(document.html)
    var lead_end = document.html.len
    if found.len > 0 {
        lead_end = found[0].start
    }
    let page = add_page(index, PageEntry { title: document.title, area: document.area, href: document.path, description: document.description, text: plain(document.html[..lead_end]) })
    for position, heading in found {
        var end = document.html.len
        if position + 1 < found.len {
            end = found[position + 1].start
        }
        let identifier = identifier_of(heading.attributes)
        var href = document.path
        match identifier {
            some(anchor) => {
                href = "{document.path}#{anchor}"
            }
            none => {}
        }
        add_section(index, SectionEntry { page, kind: "section", name: plain(heading.inner), href, signature: "", text: plain(document.html[heading.end..end]) })
    }
}

fn quote_json(mut out: builder.Builder, value: str) {
    out.write_byte('"')
    for i in 0..value.len {
        let c = value[i]
        match c {
            '"' => out.write("\\\"")
            '\\' => out.write("\\\\")
            '\n' => out.write("\\n")
            '\r' => out.write("\\r")
            '\t' => out.write("\\t")
            0x08 => out.write("\\b")
            0x0C => out.write("\\f")
            _ => {
                if c < 0x20 {
                    out.write("\\u00")
                    let digits = text.hex(i64(c))
                    out.write(text.pad_left(digits, 2, '0'))
                } else {
                    out.write_byte(c)
                }
            }
        }
    }
    out.write_byte('"')
}

fn index_json(index: *SearchIndex) -> str {
    var out = builder.builder()
    out.write("{{\"pages\":[")
    for position, entry in index.pages {
        if position > 0 {
            out.write(",")
        }
        out.write("[")
        quote_json(mut out, entry.title)
        out.write(",")
        quote_json(mut out, entry.area)
        out.write(",")
        quote_json(mut out, entry.href)
        out.write(",")
        quote_json(mut out, entry.description)
        out.write(",")
        quote_json(mut out, entry.text)
        out.write("]")
    }
    out.write("],\"sections\":[")
    for position, entry in index.sections {
        if position > 0 {
            out.write(",")
        }
        out.write("[{entry.page},")
        quote_json(mut out, entry.kind)
        out.write(",")
        quote_json(mut out, entry.name)
        out.write(",")
        quote_json(mut out, entry.href)
        out.write(",")
        quote_json(mut out, entry.signature)
        out.write(",")
        quote_json(mut out, entry.text)
        out.write("]")
    }
    out.write("]}}")
    out.to_str()
}

fn write_index(index: *SearchIndex, location: str) -> str ! BuildError {
    write_text(location, index_json(index))?
    "{index.sections.len} sections from {index.pages.len} pages"
}
