import std/markdown
import std/text

struct Library {
    modules: [str: Module]
    builtins: [str: str]
}

struct Located {
    module_path: str
    file_name: str
}

struct Linker {
    library: Library
    root: str
    snippets: i64
}

fn page_file(module_path: str) -> str {
    let dashed = text.replace(module_path, "/", "-")
    "{dashed}.html"
}

fn item_anchor(item: Item) -> str {
    if item.receiver == "" {
        return item.name
    }
    "{item.receiver}.{item.name}"
}

fn library_of(modules: []Module, builtins: [str: str]) -> Library {
    var by_path: [str: Module] = [:]
    for module in modules {
        by_path[module.path] = module
    }
    Library { modules: by_path, builtins }
}

fn is_word_text(part: str) -> bool {
    part.len > 0 && word_end(part, 0) == part.len
}

fn is_library_file(part: str) -> bool {
    text.ends_with(part, ".low") && is_word_text(part[..part.len - 4])
}

fn standard_tail(parts: []str, start: i64) -> bool {
    if parts[start] != "std" || !is_library_file(parts[parts.len - 1]) {
        return false
    }
    for index in start + 1..parts.len - 1 {
        if !is_word_text(parts[index]) {
            return false
        }
    }
    start < parts.len - 1
}

fn locate(target_path: str) -> Located? {
    let parts = text.split(target_path, '/')
    for start in 0..parts.len {
        if standard_tail(parts, start) {
            let module_path = text.join(parts[start..parts.len - 1], "/")
            return Located { module_path, file_name: parts[parts.len - 1] }
        }
    }
    none
}

fn library_page(library: Library, target: Target) -> str? {
    let located = locate(target.path) ?? return none
    let module = library.modules[located.module_path] ?? return none
    var enclosing = -1
    for index, item in module.items {
        if item.file != located.file_name || item.line > target.line {
            continue
        }
        if enclosing < 0 || module.items[enclosing].line < item.line {
            enclosing = index
        }
    }
    let page = "{packages_folder}{page_file(located.module_path)}"
    if enclosing < 0 {
        return page
    }
    "{page}#{item_anchor(module.items[enclosing])}"
}

fn builtin_page(library: Library, name: str) -> str? {
    library.builtins[name]
}

fn word_at(source: str, offset: i64) -> str {
    source[offset..word_end(source, offset)]
}

fn linked_page(linker: *Linker, checked: Checked, source: str, offset: i64) -> str? {
    let target = checked.definitions[offset]
    match target {
        some(found) => {
            if found.local {
                return none
            }
            library_page(linker.library, found)
        }
        none => builtin_page(linker.library, word_at(source, offset))
    }
}

fn code_span_hook(r: markdown.Renderer, source: str) -> str {
    codespan(source)
}

fn code_span_renderer() -> markdown.Renderer {
    markdown.Renderer { code_span: code_span_hook }
}

fn code_body(linker: *Linker, snippets: [str: Checked], lang: str, source: str) -> str {
    if lang != "low" {
        return escape(source)
    }
    let checked = snippets[source]
    match checked {
        some(found) => low(source, linker_facts(linker, found, source))
        none => low_unchecked(source)
    }
}

fn code_renderer(linker: *Linker, snippets: [str: Checked]) -> fn(markdown.Renderer, str, str) -> str {
    fn(r, lang, source) {
        let body = code_body(linker, snippets, lang, source)
        "<pre><code>{body}</code></pre>\n"
    }
}

fn linker_facts(linker: *Linker, checked: Checked, source: str) -> Facts {
    linker.snippets += 1
    var links: [i64: str] = [:]
    var anchors: [i64: str] = [:]
    for offset in words(source) {
        let page = linked_page(linker, checked, source, offset)
        match page {
            some(found) => {
                links[offset] = "{linker.root}{found}"
            }
            none => {
                let target = checked.definitions[offset] ?? continue
                if target.local && target.offset >= 0 && target.offset != offset {
                    let id = "snippet{linker.snippets}-{target.offset}"
                    links[offset] = "#{id}"
                    anchors[target.offset] = id
                }
            }
        }
    }
    Facts { hovers: checked.hovers, references: checked.references, links, anchors }
}
