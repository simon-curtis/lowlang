import std/unicode

fn is_digit_byte(c: u8) -> bool {
    c >= '0' && c <= '9'
}

fn is_upper_byte(c: u8) -> bool {
    c >= 'A' && c <= 'Z'
}

fn is_word_byte(c: u8) -> bool {
    (c >= 'a' && c <= 'z') || is_upper_byte(c) || is_digit_byte(c) || c == '_'
}

fn is_word_start_byte(c: u8) -> bool {
    (c >= 'a' && c <= 'z') || is_upper_byte(c) || c == '_'
}

fn word_end(s: str, from: i64) -> i64 {
    var at = from
    for at < s.len && is_word_byte(s[at]) {
        at += 1
    }
    at
}

fn is_unicode_space(code: u32) -> bool {
    code == 0xA0 || code == 0x1680 || (code >= 0x2000 && code <= 0x200A) || code == 0x2028 || code == 0x2029 || code == 0x202F || code == 0x205F || code == 0x3000 || code == 0xFEFF
}

fn space_width(s: str, at: i64) -> i64 {
    let c = s[at]
    if c < 0x80 {
        if c == ' ' || (c >= 9 && c <= 13) {
            return 1
        }
        return 0
    }
    let rune = unicode.decode_rune(s, at)
    if is_unicode_space(rune.code) {
        return rune.size
    }
    0
}

fn space_end(s: str, from: i64) -> i64 {
    var at = from
    for at < s.len {
        let width = space_width(s, at)
        if width == 0 {
            break
        }
        at += width
    }
    at
}

fn is_blank(s: str) -> bool {
    space_end(s, 0) == s.len
}

fn trim_space(s: str) -> str {
    let start = space_end(s, 0)
    var end = s.len
    for end > start {
        var back = end - 1
        for back > start && s[back] & 0xC0 == 0x80 {
            back -= 1
        }
        if space_width(s, back) == 0 {
            break
        }
        end = back
    }
    s[start..end]
}

fn rune_size(s: str, at: i64) -> i64 {
    unicode.decode_rune(s, at).size
}

fn utf16_length(s: str) -> i64 {
    var units = 0
    var at = 0
    for at < s.len {
        let rune = unicode.decode_rune(s, at)
        units += if rune.code >= 0x10000 { 2 } else { 1 }
        at += rune.size
    }
    units
}

fn utf16_prefix(s: str, limit: i64) -> str {
    var units = 0
    var at = 0
    for at < s.len {
        let rune = unicode.decode_rune(s, at)
        let width = if rune.code >= 0x10000 { 2 } else { 1 }
        if units + width > limit {
            break
        }
        units += width
        at += rune.size
    }
    s[..at]
}
