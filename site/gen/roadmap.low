import std/http
import std/json
import std/markdown
import std/os
import std/text

const github_api = "https://api.github.com"
const roadmap_label = "roadmap"
const next_relation = "rel=\"next\""

struct SubIssues {
    total: i64
}

struct Issue {
    number: i64
    title: str
    body: str?
    html_url: str
    state: str
    pull_request: json.Value?
    sub_issues_summary: SubIssues?
}

struct Task {
    number: i64
    title: str
    body: str
    url: str
    done: bool
    items: []Task
}

struct Fetched {
    issues: []Issue
    next: str
}

fn roadmap_client() -> *http.Client {
    var configured = http.client().with_user_agent("low-site-build").with_header("Accept", "application/vnd.github+json").with_header("X-GitHub-Api-Version", "2022-11-28")
    let token = os.env("GITHUB_TOKEN") ?? ""
    if token.len > 0 {
        configured = configured.with_header("Authorization", "Bearer {token}")
    }
    http.build(configured)
}

fn next_link(header: str) -> str {
    var at = 0
    for at < header.len {
        let open = text.index_byte(header[at..], '<')
        if open < 0 {
            return ""
        }
        let start = at + open + 1
        let close = text.index_byte(header[start..], '>')
        if close < 0 {
            return ""
        }
        let after = start + close + 1
        var cursor = after
        if cursor < header.len && header[cursor] == ';' {
            cursor = space_end(header, cursor + 1)
            if text.starts_with(header[cursor..], next_relation) {
                return header[start..start + close]
            }
        }
        at = after
    }
    ""
}

fn fetch_page(client: *http.Client, url: str) -> Fetched ! BuildError {
    let response = http.get(client, url) catch {
        cause => fail Message("roadmap: cannot reach {url}: {cause}")
    }
    if response.status < 200 || response.status > 299 {
        fail Message("roadmap: {url} answered {response.status} {http.status_text(response.status)}")
    }
    let issues = http.json[[]Issue](response) catch {
        cause => fail Message("roadmap: {url} returned unreadable JSON: {cause}")
    }
    let link = http.header_value(response, "link") ?? ""
    Fetched { issues, next: next_link(link) }
}

fn fetch_all(client: *http.Client, url: str) -> []Issue ! BuildError {
    var issues: []Issue = []
    var address = url
    for address != "" {
        let page = fetch_page(client, address)?
        for issue in page.issues {
            push(mut issues, issue)
        }
        address = page.next
    }
    issues
}

fn sub_issue_total(issue: Issue) -> i64 {
    let summary = issue.sub_issues_summary
    match summary {
        some(found) => found.total
        none => 0
    }
}

fn describe_issue(client: *http.Client, issue: Issue) -> Task ! BuildError {
    var items: []Task = []
    if sub_issue_total(issue) > 0 {
        let address = "{github_api}/repos/{repository_path}/issues/{issue.number}/sub_issues?per_page=100"
        let children = fetch_all(client, address)?
        for child in children {
            let described = describe_issue(client, child)?
            push(mut items, described)
        }
    }
    Task { number: issue.number, title: issue.title, body: issue.body ?? "", url: issue.html_url, done: issue.state == "closed", items }
}

fn is_pull_request(issue: Issue) -> bool {
    let marker = issue.pull_request
    match marker {
        some(_) => true
        none => false
    }
}

fn fetch_roadmap() -> []Task ! BuildError {
    let client = roadmap_client()
    let address = "{github_api}/repos/{repository_path}/issues?labels={roadmap_label}&state=all&sort=created&direction=asc&per_page=100"
    let issues = fetch_all(client, address)?
    var items: []Task = []
    for issue in issues {
        if is_pull_request(issue) {
            continue
        }
        let described = describe_issue(client, issue)?
        push(mut items, described)
    }
    if items.len == 0 {
        fail Message("roadmap: {repository_path} has no issues labelled {roadmap_label}")
    }
    items
}

fn literal_html(r: markdown.Renderer, source: str) -> str {
    escape(source)
}

fn summary_renderer() -> markdown.Renderer {
    markdown.Renderer { code_span: code_span_hook, html_inline: literal_html }
}

fn roadmap_entry(item: Task) -> str {
    var badge = ""
    if item.done {
        badge = " <span class=\"font-mono text-xs font-semibold uppercase\">Done</span>"
    }
    var body = ""
    let summary = trim_space(item.body)
    if summary.len > 0 {
        let inline = markdown.render_inline(summary_renderer(), markdown.parse_inline(summary))
        body = "\n<p>{inline}</p>"
    }
    var nested = ""
    if item.items.len > 0 {
        nested = "\n{roadmap_list(item.items)}"
    }
    "<li><a href=\"{escape(item.url)}\">{escape(item.title)}</a>{badge}{body}{nested}</li>"
}

fn roadmap_list(items: []Task) -> str {
    var entries: []str = []
    for item in items {
        push(mut entries, roadmap_entry(item))
    }
    "<ol>\n{text.join(entries, "\n")}\n</ol>"
}

fn roadmap_html(items: []Task) -> str {
    let intro = "<p>The roadmap is the <a href=\"{repository}/issues?q=label%3A{roadmap_label}\">issues labelled <code>{roadmap_label}</code></a> on GitHub, with each item's sub-issues nested beneath it.</p>"
    "{intro}\n{roadmap_list(items)}\n"
}
