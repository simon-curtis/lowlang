import std/builder
import std/path
import std/text

const block_open = "<pre class=\"code\""
const block_language = "data-lang=\"low\""
const block_body = "<code>"
const block_close = "</code></pre>"
const examples_placeholder = "{{{{examples}}}}"

struct Block {
    body_start: i64
    body_end: i64
    end: i64
}

struct Content {
    page: Page
    html: str
    blocks: []Block
}

fn landing_pages() -> []Page {
    [
        Page {
            path: "index.html",
            title: "Low: a compiled language with enums and typed errors",
            description: "A compiled, garbage-collected language with green threads, enums and typed errors. It builds small static binaries for Linux and Windows.",
            current: "Overview",
            kind: "website",
            scripts: ["copy.js", "hover.js"],
        },
        Page { path: "404.html", title: "Page not found: Low", error: true },
    ]
}

fn block_at(html: str, from: i64) -> Block? {
    var at = from
    for at < html.len {
        let found = text.index(html[at..], block_open)
        if found < 0 {
            return none
        }
        let start = at + found
        let tag_close = text.index(html[start..], ">")
        if tag_close < 0 {
            return none
        }
        let tag = html[start..start + tag_close]
        let body_start = start + tag_close + 1
        if text.contains(tag, block_language) && text.starts_with(html[body_start..], block_body) {
            let content_start = body_start + block_body.len
            let close = text.index(html[content_start..], block_close)
            if close < 0 {
                return none
            }
            let content_end = content_start + close
            return Block { body_start: content_start, body_end: content_end, end: content_end + block_close.len }
        }
        at = start + block_open.len
    }
    none
}

fn find_blocks(html: str) -> []Block {
    var blocks: []Block = []
    var at = 0
    for at < html.len {
        let block = block_at(html, at) ?? break
        push(mut blocks, block)
        at = block.end
    }
    blocks
}

fn load_pages(root: str) -> []Content ! BuildError {
    var contents: []Content = []
    for page in landing_pages() {
        let location = path.join([root, "site", "content", page.path])
        let html = read_text(location)?
        push(mut contents, Content { page, html, blocks: find_blocks(html) })
    }
    contents
}

fn block_source(content: Content, block: Block) -> str {
    text_of(content.html[block.body_start..block.body_end])
}

fn block_label(content: Content, source: str) -> str {
    let lines = text.split(trim_space(source), '\n')
    "{content.page.path}: {lines[0]}"
}

fn collect_landing(batch: *Batch, contents: []Content) {
    for content in contents {
        for block in content.blocks {
            let source = block_source(content, block)
            enlist(batch, program(source, []), block_label(content, source))
        }
    }
}

fn paint_blocks(content: Content, checked: []Checked, linker: *Linker) -> str {
    var out = builder.with_capacity(content.html.len)
    var at = 0
    for index, block in content.blocks {
        let source = block_source(content, block)
        let facts = linker_facts(linker, checked[index], source)
        out.write(content.html[at..block.body_start])
        out.write(low(source, facts))
        at = block.body_end
    }
    out.write(content.html[at..])
    out.to_str()
}

fn with_examples(painted: str, examples: str) -> str {
    let at = text.index(painted, examples_placeholder)
    if at < 0 {
        return painted
    }
    "{painted[..at]}{examples}{painted[at + examples_placeholder.len..]}"
}

fn render_page(chrome: Chrome, content: Content, checked: []Checked, groups: []ExampleGroup, snippets: [str: Checked], library: Library, search: *SearchIndex) -> str ! BuildError {
    let page = content.page
    let linker = new(Linker { library, root: root_of(page), snippets: 0 })
    let painted = paint_blocks(content, checked, linker)
    let examples = examples_section(groups, snippets, linker)?
    let body = with_examples(painted, examples)
    if !page.error {
        let expanded = expand(body)?
        add_document(search, Document { title: page.current, area: page.current, path: page.path, description: page.description, html: expanded })
    }
    panels(chrome, Page { path: page.path, title: page.title, description: page.description, kind: page.kind, error: page.error, current: page.current, scripts: page.scripts, body })
}

fn write_page(root: str, page: Page, document: str) ! BuildError {
    write_text(path.join([root, "site", page.path]), document)?
}
