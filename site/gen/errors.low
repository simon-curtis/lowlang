import std/io

enum BuildError {
    Io(action: str, path: str, cause: io.Error)
    Command(program: str, detail: str)
    Data(source: str, detail: str)
    Content(page: str, detail: str)
    Message(text: str)
    Snippets(count: i64, report: str)
}

fn describe(e: BuildError) -> str {
    match e {
        Io(action, path, cause) => "{action} {path}: {cause}"
        Command(program, detail) => "{program}: {detail}"
        Data(source, detail) => "{source}: {detail}"
        Content(page, detail) => "{page}: {detail}"
        Message(text) => text
        Snippets(count, report) => "{count} snippets fail to check:\n{report}"
    }
}
