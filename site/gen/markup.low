import std/builder
import std/text

struct Entity {
    reference: str
    character: str
}

fn entities() -> []Entity {
    [
        Entity { reference: "&lt;", character: "<" },
        Entity { reference: "&gt;", character: ">" },
        Entity { reference: "&quot;", character: "\"" },
        Entity { reference: "&#39;", character: "'" },
        Entity { reference: "&amp;", character: "&" },
    ]
}

fn escape(source: str) -> str {
    var out = builder.with_capacity(source.len + 16)
    for i in 0..source.len {
        let c = source[i]
        match c {
            '&' => out.write("&amp;")
            '<' => out.write("&lt;")
            '>' => out.write("&gt;")
            '"' => out.write("&quot;")
            _ => out.write_byte(c)
        }
    }
    out.to_str()
}

fn entity_at(source: str, at: i64) -> Entity? {
    let rest = source[at..]
    for entity in entities() {
        if text.starts_with(rest, entity.reference) {
            return entity
        }
    }
    none
}

fn unescape(source: str) -> str {
    var out = builder.with_capacity(source.len)
    var at = 0
    for at < source.len {
        let entity = entity_at(source, at)
        match entity {
            some(found) => {
                out.write(found.character)
                at += found.reference.len
            }
            none => {
                out.write_byte(source[at])
                at += 1
            }
        }
    }
    out.to_str()
}

fn strip_tags(html: str) -> str {
    var out = builder.with_capacity(html.len)
    var at = 0
    for at < html.len {
        if html[at] == '<' && at + 1 < html.len && html[at + 1] != '>' {
            let close = text.index_byte(html[at + 1..], '>')
            if close >= 0 {
                at += close + 2
                continue
            }
        }
        out.write_byte(html[at])
        at += 1
    }
    out.to_str()
}

fn text_of(html: str) -> str {
    let stripped = strip_tags(html)
    unescape(stripped)
}
