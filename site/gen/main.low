import std/markdown
import std/os
import std/path
import std/sys
import std/text
import std/time

fn parse_source(root: str, relative: str) -> []markdown.Block ! BuildError {
    let source = read_text(path.join([root, relative]))?
    markdown.parse(source)
}

fn render_landing(root: str, chrome: Chrome, contents: []Content, results: []Checked, modules: []Module, snippets: [str: Checked], library: Library, search: *SearchIndex) -> str ! BuildError {
    var counts: []str = []
    var cursor = 0
    for content in contents {
        let end = cursor + content.blocks.len
        let document = render_page(chrome, content, results[cursor..end], modules, snippets, library, search)?
        write_page(root, content.page, document)?
        push(mut counts, "{content.page.path} {content.blocks.len}")
        cursor = end
    }
    text.join(counts, ", ")
}

fn generate(checker: *Checker, root: str) ! BuildError {
    let started = time.monotonic()
    let modules = standard_modules(checker.binary, root)?
    let design = parse_source(root, "docs/design.md")?
    let editors = parse_source(root, "editors/README.md")?
    let builtins = builtin_pages(doc_chapters(design))?
    let library = library_of(modules, builtins)
    verify_categories(modules)?
    let roadmap = fetch_roadmap()?
    let contents = load_pages(root)?
    let pages = doc_pages(design, editors, roadmap_html(roadmap))
    let batch = new_batch()
    collect_docs(batch, pages)
    collect_packages(batch, modules)
    let landing_start = batch.jobs.len
    collect_landing(batch, contents)
    let results = check_all(checker, batch.jobs)?
    let doc_snippets = resolved(batch.docs, results)
    let package_snippets = resolved(batch.packages, results)
    let commit = head_commit(root)?
    let chrome = Chrome { commit }
    let search = new(SearchIndex { pages: [], sections: [] })
    let rendered = render_docs(pages, library, doc_snippets)?
    write_docs(root, chrome, rendered, search)?
    write_packages(root, chrome, modules, design, package_snippets, library, search)?
    let counts = render_landing(root, chrome, contents, results[landing_start..], modules, package_snippets, library, search)?
    let indexed = write_index(search, path.join([root, "site", "search.json"]))?
    verify(checker)?
    let elapsed = (time.monotonic() - started) / 1000000
    print("docs: {rendered.len} pages")
    print("packages: {modules.len} modules")
    print("pages: {counts}")
    print("search: {indexed}")
    print("snippets checked: {batch.jobs.len}")
    print("elapsed: {elapsed} ms")
}

fn build() ! BuildError {
    let root = repository_root()?
    let checker = start_checker(root)?
    generate(checker, root) catch {
        cause => {
            stop_checker(checker) or {}
            fail cause
        }
    }
    stop_checker(checker)?
}

fn report(message: str) {
    let data = bytes("build: {message}\n")
    sys.write_all(2, data) or {}
}

fn main() {
    build() catch {
        cause => {
            report(describe(cause))
            os.exit(1)
        }
    }
}
