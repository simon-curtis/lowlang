import std/file
import std/path
import std/slices
import std/testing
import std/text

const color = "example.com/acme/color"

fn module_of(module_path: str, items: Item[]) -> Module {
    Module { path: module_path, imports: [Import { path: "std/json", alias: "json" }, Import { path: "label", alias: "label" }], items, examples: [] }
}

fn color_module() -> Module {
    let items = [
        Item { kind: "struct", name: "Color", text: "pub struct Color {{\n    pub name: str\n}}", doc: "A named colour.", file: "color.low", line: 3 },
        Item { kind: "fn", name: "encode", receiver: "Color", text: "pub fn encode(c: Color) -> str", doc: "Encodes a colour.", file: "color.low", line: 9 },
        Item { kind: "fn", name: "red", text: "pub fn red() -> Color", file: "color.low", line: 12 },
        Item { kind: "fn", name: "parse", text: "pub fn parse(v: json.Value) -> Color", file: "color.low", line: 15 },
    ]
    var module = module_of(color, items)
    module.examples = [Example { name: "basic", source: "fn main() {{\n    print(1)\n}}\n", output: "1\n" }]
    module
}

fn label_module() -> Module {
    module_of("{color}/label", [Item { kind: "fn", name: "label", text: "pub fn label(name: str) -> str", file: "label.low", line: 1 }])
}

fn json_module() -> Module {
    module_of("std/json", [Item { kind: "struct", name: "Value", text: "pub struct Value {{\n    ...\n}}", doc: "A JSON value.", file: "json.low", line: 1 }])
}

fn release(tag: str, yanked: bool) -> Version {
    Version { tag, commit: "0123456789abcdef0123456789abcdef01234567", hash: "h1:abc", yanked, modules: [color_module(), label_module()] }
}

struct Site {
    dir: str
    search: *SearchIndex
}

fn generate_site(t: *testing.T, packages: Indexed[]) -> Site {
    let dir = file.temp_dir("low-site-test-") catch {
        e => {
            t.fatal("create a directory: {testing.format(e)}")
            return Site { dir: "", search: new(SearchIndex { pages: [], sections: [] }) }
        }
    }
    let search = new(SearchIndex { pages: [], sections: [] })
    let library = Library { modules: [:], builtins: [:] }
    write_indexed(dir, Chrome { commit: "abc" }, [json_module()], packages, library, search) catch {
        e => t.fatal("write_indexed: {describe(e)}")
    }
    Site { dir, search }
}

fn page_text(t: *testing.T, site: Site, relative: str) -> str {
    let location = path.join([site.dir, relative])
    file.read_text(location) catch {
        e => {
            t.fatal("read {location}: {testing.format(e)}")
            ""
        }
    }
}

fn search_hrefs(site: Site) -> str[] {
    var hrefs: str[] = []
    for page in site.search.pages {
        hrefs.push(page.href)
    }
    hrefs
}

fn test_every_version_and_module_gets_a_page_and_the_landing_lists_the_versions(t: *testing.T) {
    let packages = [Indexed { source: color, versions: [release("v1.2.0", true), release("v1.1.0", false), release("v1.0.0", false)] }]
    let site = generate_site(t, packages)
    defer file.remove_all(site.dir) or {}
    let landing = page_text(t, site, "packages/{color}/index.html")
    t.is_true(text.contains(landing, "The default version is <a href=\"v1.1.0/index.html\">"))
    t.is_true(text.contains(landing, "<a href=\"v1.2.0/index.html\"><code>v1.2.0</code></a> <span class=\"text-sm\">yanked</span>"))
    t.is_true(text.contains(landing, "<a href=\"v1.1.0/index.html\"><code>v1.1.0</code></a> <span class=\"text-sm\">default</span>"))
    t.is_true(text.contains(landing, "<a href=\"v1.0.0/index.html\"><code>v1.0.0</code></a> <span class=\"text-sm\">0123456"))
    for tag in ["v1.2.0", "v1.1.0", "v1.0.0"] {
        let overview = page_text(t, site, "packages/{color}/{tag}/index.html")
        t.is_true(text.contains(overview, "<a href=\"example.com-acme-color-label.html\">"))
        let root = page_text(t, site, "packages/{color}/{tag}/example.com-acme-color.html")
        t.is_true(text.contains(root, "<h3 id=\"Color.encode\"") || text.contains(root, "<h4 id=\"Color.encode\""))
        t.is_true(text.contains(root, "<a href=\"../../../../../packages/std-json.html\"><code>std/json</code></a>"))
        t.is_true(text.contains(root, "href=\"../../../../../packages/std-json.html#Value\""))
        t.is_true(text.contains(root, "<a href=\"example.com-acme-color-label.html\"><code>label</code></a>"))
    }
    t.is_true(text.contains(page_text(t, site, "packages/{color}/v1.2.0/index.html"), "<strong>Yanked.</strong>"))
    t.is_false(text.contains(page_text(t, site, "packages/{color}/v1.1.0/index.html"), "Yanked."))
}

fn test_search_lists_the_package_and_the_modules_of_its_default_version_only(t: *testing.T) {
    let packages = [Indexed { source: color, versions: [release("v1.2.0", true), release("v1.1.0", false), release("v1.0.0", false)] }]
    let site = generate_site(t, packages)
    defer file.remove_all(site.dir) or {}
    let folder = "packages/{color}"
    t.equal(text.join(search_hrefs(site), "\n"), "{folder}/index.html\n{folder}/v1.1.0/example.com-acme-color.html\n{folder}/v1.1.0/example.com-acme-color-label.html")
    var names: str[] = []
    for section in site.search.sections {
        names.push(section.name)
    }
    t.is_true(slices.contains(names, "Color.encode"))
    t.is_true(slices.contains(names, "basic"))
    t.is_true(slices.contains(names, "label.label"))
}

fn test_a_package_whose_versions_are_all_yanked_has_no_default(t: *testing.T) {
    let packages = [Indexed { source: color, versions: [release("v1.1.0", true), release("v1.0.0", true)] }]
    let site = generate_site(t, packages)
    defer file.remove_all(site.dir) or {}
    let landing = page_text(t, site, "packages/{color}/index.html")
    t.is_true(text.contains(landing, "Every version of this package is yanked."))
    t.is_false(text.contains(landing, "default"))
    t.equal(text.join(search_hrefs(site), "\n"), "packages/{color}/index.html")
    t.is_true(file.exists(path.join([site.dir, "packages/{color}/v1.1.0/index.html"])))
}

fn test_the_index_page_lists_packages_only_when_the_index_has_some(t: *testing.T) {
    let chrome = Chrome { commit: "abc" }
    let without = index_document(chrome, [color_module()], [:], [])
    t.is_false(text.contains(without, "low doc index"))
    t.is_true(text.contains(without, "Filter 1 modules\""))
    let packages = [Indexed { source: color, versions: [release("v1.1.0", false)] }]
    let with = index_document(chrome, [color_module()], [:], packages)
    t.is_true(text.contains(with, "<a class=\"hit\" href=\"{color}/index.html\"><code>{color}</code></a> <span class=\"text-sm\">1 versions, default v1.1.0</span>"))
    t.is_true(text.contains(with, "Filter 1 modules and 1 packages\""))
}
