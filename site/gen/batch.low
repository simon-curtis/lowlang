import std/maps

struct Batch {
    jobs: []Job
    docs: [str: i64]
    packages: [str: i64]
    examples: [str: i64]
}

fn new_batch() -> *Batch {
    new(Batch { jobs: [], docs: [:], packages: [:], examples: [:] })
}

fn enlist(batch: *Batch, source: Program, label: str) -> i64 {
    push(mut batch.jobs, Job { program: source, label })
    batch.jobs.len - 1
}

fn resolved(slots: [str: i64], results: []Checked) -> [str: Checked] {
    var checked: [str: Checked] = [:]
    for source in maps.keys(slots) {
        let slot = slots[source] ?? continue
        checked[source] = results[slot]
    }
    checked
}
