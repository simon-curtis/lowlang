import std/builder
import std/maps
import std/markdown
import std/path
import std/slices
import std/text

const packages_area = "Packages"
const label_class = "mb-2 text-sm font-semibold uppercase tracking-wide"
const github_icon = "<svg class=\"size-5\" viewBox=\"0 0 16 16\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z\"/></svg>"

struct PackagePage {
    module: Module
    description: str
    types: []Item
    constants: []Item
    functions: []Item
    type_names: []str
    exports: [str: []str]
    library: Library
    snippets: [str: Checked]
    linker: *Linker
    root: str
}

struct Group {
    note: bool
    indent: i64
    lines: []str
}

struct Comment {
    indent: i64
    text: str
}

struct SideLink {
    name: str
    id: str
}

fn inline_html(source: str) -> str {
    markdown.render_inline(code_span_renderer(), markdown.parse_inline(source))
}

fn block_html(source: str) -> str {
    markdown.render(code_span_renderer(), markdown.parse(source))
}

fn page_path(module: Module) -> str {
    "{packages_folder}{page_file(module.path)}"
}

fn module_exports(modules: []Module) -> [str: []str] {
    var exports: [str: []str] = [:]
    for module in modules {
        var names: []str = []
        for item in members(module).types {
            push(mut names, item.name)
        }
        exports[module.path] = names
    }
    exports
}

fn package_page(module: Module, description: str, exports: [str: []str], snippets: [str: Checked], library: Library) -> PackagePage {
    let found = members(module)
    var type_names: []str = []
    for item in found.types {
        push(mut type_names, item.name)
    }
    let page = Page { path: "{packages_folder}{page_file(module.path)}" }
    let root = root_of(page)
    let linker = new(Linker { library, root, snippets: 0 })
    PackagePage { module, description, types: found.types, constants: found.constants, functions: found.functions, type_names, exports, library, snippets, linker, root }
}

fn local_target(page: PackagePage, name: str) -> str? {
    if slices.contains(page.type_names, name) {
        return "#{name}"
    }
    let builtin = builtin_page(page.library, name)
    match builtin {
        some(found) => "{page.root}{found}"
        none => none
    }
}

fn imported_target(page: PackagePage, alias: str, name: str) -> str? {
    for entry in page.module.imports {
        if entry.alias == alias {
            let names = page.exports[entry.path] ?? []
            if slices.contains(names, name) {
                return page_file(entry.path)
            }
            return none
        }
    }
    none
}

fn alias_before(source: str, offset: i64) -> str? {
    if offset == 0 || source[offset - 1] != '.' {
        return none
    }
    let end = offset - 1
    var start = end
    for start > 0 && is_word_byte(source[start - 1]) {
        start -= 1
    }
    if start == end {
        return none
    }
    source[start..end]
}

fn signature_facts(page: PackagePage, source: str) -> Facts {
    var links: [i64: str] = [:]
    var modules: []str = []
    for offset in words(source) {
        let name = word_at(source, offset)
        if !is_type_name(name) {
            continue
        }
        let alias = alias_before(source, offset)
        match alias {
            some(found) => {
                let target = imported_target(page, found, name)
                match target {
                    some(file) => {
                        links[offset - found.len - 1] = file
                        links[offset] = "{file}#{name}"
                        if !slices.contains(modules, found) {
                            push(mut modules, found)
                        }
                    }
                    none => {}
                }
            }
            none => {
                let target = local_target(page, name)
                match target {
                    some(href) => {
                        links[offset] = href
                    }
                    none => {}
                }
            }
        }
    }
    linked(links, modules)
}

fn comment_of(line: str) -> Comment? {
    var at = 0
    for at < line.len && line[at] == ' ' {
        at += 1
    }
    if !text.starts_with(line[at..], "///") {
        return none
    }
    var start = at + 3
    if start < line.len && line[start] == ' ' {
        start += 1
    }
    Comment { indent: at, text: line[start..] }
}

fn note_groups(source: str) -> []Group {
    var groups: []Group = []
    for line in text.split(source, '\n') {
        var note = false
        var indent = 0
        var content = line
        let found = comment_of(line)
        match found {
            some(comment) => {
                note = true
                indent = comment.indent
                content = comment.text
            }
            none => {}
        }
        let last = groups.len - 1
        if groups.len > 0 && groups[last].note == note && groups[last].indent == indent {
            push(mut groups[last].lines, content)
        } else {
            push(mut groups, Group { note, indent, lines: [content] })
        }
    }
    groups
}

fn split_paragraphs(source: str) -> []str {
    var paragraphs: []str = []
    var current: []str = []
    for line in text.split(source, '\n') {
        if line == "" {
            if current.len > 0 {
                push(mut paragraphs, text.join(current, "\n"))
                current = []
            }
        } else {
            push(mut current, line)
        }
    }
    if current.len > 0 || paragraphs.len == 0 {
        push(mut paragraphs, text.join(current, "\n"))
    }
    paragraphs
}

fn note_html(indent: i64, lines: []str) -> str {
    let joined = trim_space(text.join(lines, "\n"))
    var paragraphs = builder.builder()
    for paragraph in split_paragraphs(joined) {
        paragraphs.write("<span>{inline_html(paragraph)}</span>")
    }
    "<span class=\"note pl-[{indent}ch]\"><span>{paragraphs.to_str()}</span></span>"
}

fn signature_html(page: PackagePage, source: str) -> str {
    var groups = builder.builder()
    for group in note_groups(source) {
        if group.note {
            groups.write(note_html(group.indent, group.lines))
        } else {
            let code = text.join(group.lines, "\n")
            groups.write(low(code, signature_facts(page, code)))
        }
    }
    "<pre class=\"signature\"><code>{groups.to_str()}</code></pre>\n"
}

fn heading_html(page: PackagePage, id: str, name: str, depth: i64, target: str, place: str) -> str {
    let link = "{std_source}/{page.module.path}/{target}"
    let view = "<a class=\"-m-3 shrink-0 p-3 no-underline opacity-60 hover:opacity-100\" href=\"{link}\" title=\"{escape(place)}\" aria-label=\"{escape(place)} on GitHub\">{github_icon}</a>"
    "<h{depth} id=\"{id}\" class=\"flex items-center justify-between gap-4\"><a href=\"#{id}\">{escape(name)}</a>{view}</h{depth}>\n"
}

fn doc_blocks_html(page: PackagePage, source: str) -> str {
    let renderer = markdown.Renderer { code_block: code_renderer(page.linker, page.snippets), code_span: code_span_hook }
    markdown.render(renderer, markdown.parse(source))
}

fn item_html(page: PackagePage, item: Item, depth: i64) -> str {
    let target = "{item.file}#L{item.line}"
    let place = "{item.file}:{item.line}"
    let heading = heading_html(page, item_anchor(item), item.name, depth, target, place)
    var doc = ""
    if item.doc != "" {
        doc = doc_blocks_html(page, item.doc)
    }
    "<section class=\"item\">\n{heading}{signature_html(page, item.text)}{doc}</section>\n"
}

fn example_html(page: PackagePage, example: Example) -> str ! BuildError {
    let place = "examples/{example.name}.low"
    let heading = heading_html(page, example_anchor(example), example.name, 3, place, place)
    let source = example_source(example)
    let checked = page.snippets[source] ?? fail Content(page.module.path, "example {example.name} was not checked")
    let facts = linker_facts(page.linker, checked, source)
    let code = "<pre><code>{low(source, facts)}</code></pre>\n"
    var output = ""
    if example.output != "" {
        output = "<p class=\"text-sm font-semibold uppercase tracking-wide\">Output</p>\n<pre><code>{escape(text.trim_end(example.output))}</code></pre>\n"
    }
    "<section class=\"item\">\n{heading}{code}{output}</section>\n"
}

fn methods_of(page: PackagePage, owner: Item) -> []Item {
    var methods: []Item = []
    for item in page.module.items {
        if item.receiver == owner.name {
            push(mut methods, item)
        }
    }
    methods
}

fn section_heading(id: str, title: str) -> str {
    "<h2 id=\"{id}\"><a href=\"#{id}\">{title}</a></h2>\n"
}

fn import_links(module: Module) -> str {
    var seen: []str = []
    var links: []str = []
    for entry in module.imports {
        if !slices.contains(seen, entry.path) {
            push(mut seen, entry.path)
            push(mut links, "<a href=\"{page_file(entry.path)}\"><code>{entry.path}</code></a>")
        }
    }
    text.join(links, ", ")
}

fn body_html(page: PackagePage) -> str ! BuildError {
    let module = page.module
    var out = builder.builder()
    out.write("<p>{tags(module.path)}</p>\n")
    let import_line = low_unchecked("import {module.path}")
    out.write("<pre><code>{import_line}</code></pre>\n")
    if page.description != "" {
        out.write("<p>{page.description}</p>\n")
    }
    let imports = import_links(module)
    if imports != "" {
        out.write("<p>Imports {imports}.</p>\n")
    }
    if module.examples.len > 0 {
        out.write(section_heading("examples", "Examples"))
        for example in module.examples {
            let entry = example_html(page, example)?
            out.write(entry)
        }
    }
    if page.types.len > 0 {
        out.write(section_heading("types", "Types"))
        for item in page.types {
            out.write(item_html(page, item, 3))
            for method in methods_of(page, item) {
                out.write(item_html(page, method, 4))
            }
        }
    }
    if page.constants.len > 0 {
        out.write(section_heading("constants", "Constants"))
        for item in page.constants {
            out.write(item_html(page, item, 3))
        }
    }
    if page.functions.len > 0 {
        out.write(section_heading("functions", "Functions"))
        for item in page.functions {
            out.write(item_html(page, item, 3))
        }
    }
    out.to_str()
}

fn side_list(links: []SideLink) -> str {
    var items: []str = []
    for link in links {
        push(mut items, "<li><a class=\"hover:underline hover:underline-offset-4\" href=\"#{link.id}\">{escape(link.name)}</a></li>")
    }
    "<ul class=\"sidelist\">\n{text.join(items, "\n")}\n</ul>"
}

fn item_links(items: []Item) -> []SideLink {
    var links: []SideLink = []
    for item in items {
        push(mut links, SideLink { name: item.name, id: item.name })
    }
    links
}

fn side_group(title: str, links: []SideLink) -> str {
    "<p class=\"{label_class}\">{title}</p>\n{side_list(links)}"
}

fn sidebar_html(page: PackagePage) -> str {
    var groups: []str = []
    if page.module.examples.len > 0 {
        var links: []SideLink = []
        for example in page.module.examples {
            push(mut links, SideLink { name: example.name, id: example_anchor(example) })
        }
        push(mut groups, side_group("Examples", links))
    }
    if page.types.len > 0 {
        push(mut groups, side_group("Types", item_links(page.types)))
    }
    if page.constants.len > 0 {
        push(mut groups, side_group("Constants", item_links(page.constants)))
    }
    if page.functions.len > 0 {
        push(mut groups, side_group("Functions", item_links(page.functions)))
    }
    let back = "<p class=\"font-bold\"><a class=\"hover:underline hover:underline-offset-4\" href=\"index.html\">← std</a></p>"
    "<div class=\"space-y-8\">\n{back}\n{text.join(groups, "\n")}\n</div>"
}

fn page_document(chrome: Chrome, page: PackagePage) -> str ! BuildError {
    let module_path = page.module.path
    var source = "The {module_path} module of the Low standard library."
    if page.description != "" {
        source = text_of(page.description)
    }
    let body = body_html(page)?
    layout(chrome, Page { path: page_path(page.module), heading: module_path, title: "{module_path}: Low packages", description: summary(source, 200), current: packages_area, sidebar: sidebar_html(page), body })
}

fn module_alias(module_path: str) -> str {
    let cut = text.last_index_byte(module_path, '/')
    module_path[cut + 1..]
}

fn entry_signature(code: str) -> str {
    let collapsed = trim_space(collapse_space(code))
    text.trim_prefix(collapsed, "pub ")
}

fn section_entry(page: PackagePage, number: i64, item: Item) -> SectionEntry {
    var code: []str = []
    var notes: []str = []
    for line in text.split(item.text, '\n') {
        let found = comment_of(line)
        match found {
            some(comment) => {
                push(mut notes, comment.text)
            }
            none => {
                push(mut code, line)
            }
        }
    }
    let doc = block_html(item.doc)
    let fields = inline_html(text.join(notes, " "))
    var kind = item.kind
    var name = "{module_alias(page.module.path)}.{item.name}"
    if item.receiver != "" {
        kind = "method"
        name = item_anchor(item)
    }
    SectionEntry { page: number, kind, name, href: "{page_path(page.module)}#{item_anchor(item)}", signature: entry_signature(text.join(code, " ")), text: plain("{doc} {fields}") }
}

fn register_package(page: PackagePage, search: *SearchIndex) {
    var description = ""
    if page.description != "" {
        description = plain(page.description)
    }
    let number = add_page(search, PageEntry { title: page.module.path, area: packages_area, href: page_path(page.module), description, text: "" })
    for example in page.module.examples {
        let flat = collapse_space(example_source(example))
        add_section(search, SectionEntry { page: number, kind: "example", name: example.name, href: "{page_path(page.module)}#{example_anchor(example)}", signature: "", text: flat })
    }
    var listed: []Item = []
    for item in page.types {
        push(mut listed, item)
    }
    for item in page.types {
        for method in methods_of(page, item) {
            push(mut listed, method)
        }
    }
    for item in page.constants {
        push(mut listed, item)
    }
    for item in page.functions {
        push(mut listed, item)
    }
    for item in listed {
        add_section(search, section_entry(page, number, item))
    }
}

fn std_path(raw: str) -> str? {
    if raw.len < 5 || !text.starts_with(raw, "`std") || raw[raw.len - 1] != '`' {
        return none
    }
    let name = raw[1..raw.len - 1]
    for at in 0..name.len {
        if !is_word_byte(name[at]) && name[at] != '/' {
            return none
        }
    }
    name
}

fn collect_descriptions(blocks: []markdown.Block, mut about: [str: str]) {
    for block in blocks {
        match block {
            Table(table) => {
                for row in table.rows {
                    let found = std_path(row[0].raw)
                    match found {
                        some(module_path) => {
                            about[module_path] = inline_html(row[1].raw)
                        }
                        none => {}
                    }
                }
            }
            List(list) => {
                for item in list.items {
                    collect_descriptions(item.blocks, mut about)
                }
            }
            Quote(children) => collect_descriptions(children, mut about)
            _ => {}
        }
    }
}

fn descriptions(design: []markdown.Block) -> [str: str] {
    var about: [str: str] = [:]
    collect_descriptions(design, mut about)
    about
}

fn module_paths(modules: []Module) -> []str {
    var paths: []str = []
    for module in modules {
        push(mut paths, module.path)
    }
    paths
}

fn verify_categories(modules: []Module) ! BuildError {
    let paths = module_paths(modules)
    var uncategorised: []str = []
    for module_path in paths {
        if categories(module_path).len == 0 {
            push(mut uncategorised, module_path)
        }
    }
    if uncategorised.len > 0 {
        fail Message("packages without a category: {text.join(uncategorised, ", ")}")
    }
    let orphans = orphaned(paths)
    if orphans.len > 0 {
        fail Message("categories for packages that do not exist: {text.join(orphans, ", ")}")
    }
}

fn imports_module(source: str, module_path: str) -> bool {
    for line in text.split(source, '\n') {
        if !text.starts_with(line, "import ") {
            continue
        }
        let rest = line[7..]
        if rest == module_path {
            return true
        }
        let name_end = word_end(rest, 0)
        if name_end > 0 && text.starts_with(rest[name_end..], " = ") && rest[name_end + 3..] == module_path {
            return true
        }
    }
    false
}

fn enlist_documented(batch: *Batch, module: Module, item: Item, block: markdown.Block) {
    match block {
        Code(lang, _, source) => {
            if lang != "low" || maps.has(batch.packages, source) {
                return
            }
            var preludes: []Prelude = []
            if !imports_module(source, module.path) {
                preludes = [Prelude { path: "", text: "import {module.path}" }]
            }
            batch.packages[source] = enlist(batch, program(source, preludes), "{module.path} {item_anchor(item)}")
        }
        _ => {}
    }
}

fn collect_packages(batch: *Batch, modules: []Module) {
    for module in modules {
        for item in module.items {
            for block in markdown.parse(item.doc) {
                enlist_documented(batch, module, item, block)
            }
        }
        for example in module.examples {
            let source = example_source(example)
            batch.packages[source] = enlist(batch, program(source, []), "{module.path} examples/{example.name}.low")
        }
    }
}

fn index_row(module: Module, about: [str: str]) -> str {
    var summary_text = ""
    let described = about[module.path]
    match described {
        some(html) => {
            summary_text = summary(text_of(html), 160)
        }
        none => {}
    }
    let kinds = text.join(categories(module.path), " ")
    let searchable = escape(text.lower("{module.path} {summary_text}"))
    var detail = ""
    if summary_text != "" {
        detail = "<br>{escape(summary_text)}"
    }
    let lines = [
        "<li class=\"module\" data-categories=\"{kinds}\" data-search=\"{searchable}\">",
        "<a class=\"hit\" href=\"{page_file(module.path)}\"><code>{module.path}</code></a> ",
        "<span class=\"text-sm\">{module.items.len} items</span>{detail}",
        "<span class=\"mt-4 flex flex-wrap gap-x-2 gap-y-5\">{tags(module.path)}</span></li>",
    ]
    text.join(lines, "")
}

fn index_document(chrome: Chrome, modules: []Module, about: [str: str]) -> str {
    var bar: []str = []
    for name in all_categories(module_paths(modules)) {
        push(mut bar, "<a class=\"tag\" href=\"?category={name}\" data-category=\"{name}\">#{name}</a>")
    }
    var rows: []str = []
    for module in modules {
        push(mut rows, index_row(module, about))
    }
    let lines = [
        "<p>The packages that ship with Low, extracted from their source by <code>low doc std</code>. Each page lists a module's public types, the functions that take them as their first argument, its public constants and its other public functions.</p>",
        "<label class=\"mt-6 block\"><span class=\"sr-only\">Filter modules</span><input id=\"filter\" type=\"search\" placeholder=\"Filter {modules.len} modules\" class=\"w-full border px-3 py-2\"></label>",
        "<nav class=\"tags\" aria-label=\"Categories\">",
        "<a class=\"tag\" href=\"index.html\" data-category=\"\">all</a>",
        text.join(bar, "\n"),
        "</nav>",
        "<ul id=\"modules\" class=\"mt-10 list-none space-y-6 pl-0\">",
        text.join(rows, "\n"),
        "</ul>",
    ]
    let body = "{text.join(lines, "\n")}\n"
    let sidebar = "<ul class=\"sidelist\">\n<li><a class=\"font-bold underline underline-offset-4\" aria-current=\"page\" href=\"index.html\">std</a></li>\n</ul>"
    layout(chrome, Page { path: "{packages_folder}index.html", heading: "std", title: "Low packages", description: "The Low standard library: {modules.len} modules.", current: packages_area, sidebar, body, scripts: ["filter.js"] })
}

fn write_packages(root: str, chrome: Chrome, modules: []Module, design: []markdown.Block, snippets: [str: Checked], library: Library, search: *SearchIndex) ! BuildError {
    let about = descriptions(design)
    let exports = module_exports(modules)
    let folder = path.join([root, "site", packages_folder])
    remove_tree(folder)?
    make_directories(folder)?
    write_text(path.join([folder, "index.html"]), index_document(chrome, modules, about))?
    for module in modules {
        let page = package_page(module, about[module.path] ?? "", exports, snippets, library)
        let document = page_document(chrome, page)?
        register_package(page, search)
        write_text(path.join([folder, page_file(module.path)]), document)?
    }
}
