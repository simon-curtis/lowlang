import std/file
import std/os
import std/path
import std/process
import std/text

fn read_text(location: str) -> str ! BuildError {
    file.read_text(location) catch {
        cause => fail Io("read", location, cause)
    }
}

fn write_text(location: str, content: str) ! BuildError {
    file.write_text(location, content) catch {
        cause => fail Io("write", location, cause)
    }
}

fn make_directories(location: str) ! BuildError {
    file.mkdir_all(location) catch {
        cause => fail Io("create", location, cause)
    }
}

fn remove_tree(location: str) ! BuildError {
    file.remove_all(location) catch {
        cause => fail Io("remove", location, cause)
    }
}

fn run_command(command: process.Command) -> process.Output ! BuildError {
    process.run(command, []) catch {
        cause => fail Command(command.program, "{cause}")
    }
}

fn failure_detail(output: process.Output) -> str {
    let message = text.trim(str(output.stderr))
    if message.len > 0 {
        return message
    }
    match output.status {
        Exited(code) => "exited with {code}"
        Signaled(_) => "killed by a signal"
    }
}

fn command_output(command: process.Command) -> str ! BuildError {
    let output = run_command(command)?
    if !process.success(output.status) {
        fail Command(command.program, failure_detail(output))
    }
    str(output.stdout)
}

fn slashed(location: str) -> str {
    text.replace(location, "\\", "/")
}

fn working_directory() -> str ! BuildError {
    let location = os.getcwd() catch {
        cause => fail Io("locate", "the working directory", cause)
    }
    slashed(location)
}

fn repository_root() -> str ! BuildError {
    var folder = working_directory()?
    for {
        if file.exists(path.join([folder, "go.mod"])) {
            return folder
        }
        let parent = path.dir(folder)
        if parent == folder {
            fail Content("repository", "no go.mod in the working directory or any folder above it")
        }
        folder = parent
    }
}
