import std/http

const linux_asset = "low-linux-amd64"
const windows_asset = "low-windows-amd64.exe"

struct Asset {
    name: str
    size: i64
}

struct Release {
    assets: Asset[]
}

struct Downloads {
    linux: str
    windows: str
}

fn megabytes(size: i64) -> str {
    let tenths = (size + 50000) / 100000
    "{tenths / 10}.{tenths % 10} MB"
}

fn asset_size(release: Release, name: str) -> str ! BuildError {
    for asset in release.assets {
        if asset.name == name {
            return megabytes(asset.size)
        }
    }
    fail Message("release: the latest release has no asset named {name}")
}

fn fetch_downloads() -> Downloads ! BuildError {
    let url = "{github_api}/repos/{repository_path}/releases/latest"
    let response = http.get(github_client(), url) catch {
        cause => fail Message("release: cannot reach {url}: {cause}")
    }
    if response.status < 200 || response.status > 299 {
        fail Message("release: {url} answered {response.status} {http.status_text(response.status)}")
    }
    let release = http.json[Release](response) catch {
        cause => fail Message("release: {url} returned unreadable JSON: {cause}")
    }
    Downloads { linux: asset_size(release, linux_asset)?, windows: asset_size(release, windows_asset)? }
}
