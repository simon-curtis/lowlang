import std/builder
import std/slices
import std/text

const grid = "wrap row grid grid-cols-[minmax(0,1fr)] lg:grid-cols-[16rem_minmax(0,1fr)]"
const search_script = "search.js"
const hover_script = "hover.js"
const github_icon = "<svg class=\"size-5\" viewBox=\"0 0 16 16\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z\"/></svg>"

struct Page {
    path: str = ""
    title: str = ""
    description: str = ""
    error: bool = false
    current: str = ""
    heading: str = ""
    sidebar: str = ""
    outline: str = ""
    body: str = ""
    scripts: str[] = []
}

struct Section {
    name: str
    path: str
}

struct Chrome {
    commit: str
}

fn sections() -> Section[] {
    [
        Section { name: "Overview", path: "index.html" },
        Section { name: "Docs", path: "{docs_folder}index.html" },
        Section { name: "Packages", path: "{packages_folder}index.html" },
        Section { name: "Playground", path: "{playground_folder}index.html" },
    ]
}

fn root_of(page: Page) -> str {
    if page.error {
        return "/"
    }
    text.repeat("../", text.count(page.path, "/"))
}

fn navigation(root: str, current: str) -> str {
    var links: str[] = []
    for section in sections() {
        let marker = if section.name == current { " aria-current=\"page\"" } else { "" }
        links.push("<a{marker} href=\"{root}{section.path}\">{section.name}</a>")
    }
    text.join(links, "\n")
}

fn address(page_path: str) -> str {
    if page_path == "index.html" {
        return "{origin}/"
    }
    "{origin}/{page_path}"
}

fn discovery_lines(page: Page) -> str[] {
    if page.error {
        return ["<meta name=\"robots\" content=\"noindex\">"]
    }
    [
        "<meta name=\"description\" content=\"{escape(page.description)}\">",
        "<meta property=\"og:type\" content=\"video.other\">",
        "<meta property=\"og:site_name\" content=\"Low\">",
        "<meta property=\"og:title\" content=\"{escape(page.title)}\">",
        "<meta property=\"og:description\" content=\"{escape(page.description)}\">",
        "<meta property=\"og:url\" content=\"{address(page.path)}\">",
        "<meta property=\"og:image\" content=\"{origin}/og-image.png\">",
        "<meta property=\"og:image:secure_url\" content=\"{origin}/og-image.png\">",
        "<meta property=\"og:image:type\" content=\"image/png\">",
        "<meta property=\"og:image:width\" content=\"1200\">",
        "<meta property=\"og:image:height\" content=\"630\">",
        "<meta property=\"og:image:alt\" content=\"The Low mark and name over its tagline\">",
        "<meta property=\"og:video\" content=\"{origin}/og-video.mp4\">",
        "<meta property=\"og:video:secure_url\" content=\"{origin}/og-video.mp4\">",
        "<meta property=\"og:video:type\" content=\"video/mp4\">",
        "<meta property=\"og:video:width\" content=\"1200\">",
        "<meta property=\"og:video:height\" content=\"630\">",
        "<meta name=\"twitter:card\" content=\"summary_large_image\">",
        "<meta name=\"twitter:image:alt\" content=\"The Low mark and name over its tagline\">",
        "<link rel=\"canonical\" href=\"{address(page.path)}\">",
    ]
}

fn font_preloads(page: Page) -> str[] {
    var fonts = ["inter"]
    if !page.error {
        fonts.push("jetbrains-mono")
    }
    var preloads: str[] = []
    for font in fonts {
        preloads.push("<link rel=\"preload\" href=\"/src/fonts/{font}.woff2\" as=\"font\" type=\"font/woff2\" crossorigin>")
    }
    preloads
}

fn head(page: Page) -> str {
    var lines = ["<meta charset=\"utf-8\">", "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">", "<title>{escape(page.title)}</title>"]
    for line in discovery_lines(page) {
        lines.push(line)
    }
    lines.push("<meta name=\"theme-color\" content=\"#f5f5f3\">")
    lines.push("<link rel=\"icon\" href=\"/favicon.ico\" sizes=\"48x48\">")
    lines.push("<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">")
    lines.push("<link rel=\"apple-touch-icon\" href=\"/apple-touch-icon.png\">")
    lines.push("<link rel=\"manifest\" href=\"/site.webmanifest\">")
    for line in font_preloads(page) {
        lines.push(line)
    }
    lines.push("<link rel=\"stylesheet\" href=\"/src/style.css\">")
    text.join(lines, "\n")
}

fn masthead(root: str, current: str) -> str {
    let find = "<button class=\"find\" type=\"button\" aria-haspopup=\"dialog\" aria-keyshortcuts=\"Control+K Meta+K /\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"m20 20-4-4\"/></svg>Search<kbd>Ctrl K</kbd></button>"
    let lines = [
        "<header class=\"masthead\">",
        "<div class=\"wrap\">",
        "<a class=\"brand\" href=\"{root}index.html\"><span class=\"mark size-5\" aria-hidden=\"true\"></span>Low</a>",
        "<nav class=\"menu\">",
        navigation(root, current),
        "</nav>",
        find,
        "<a class=\"repo\" href=\"{repository}\" aria-label=\"Low on GitHub\">{github_icon}</a>",
        "</div>",
        "</header>",
    ]
    text.join(lines, "\n")
}

fn footer(chrome: Chrome, root: str) -> str {
    var short = chrome.commit
    if short.len > 7 {
        short = short[..7]
    }
    var pages: str[] = []
    for section in sections() {
        pages.push("<li><a href=\"{root}{section.path}\">{section.name}</a></li>")
    }
    let lines = [
        "<footer class=\"footer\">",
        "<div class=\"wrap row\">",
        "<div>",
        "<a class=\"brand\" href=\"{root}index.html\"><span class=\"mark size-5\" aria-hidden=\"true\"></span>Low</a>",
        "<p class=\"built\">Built from <a href=\"{repository}/commit/{chrome.commit}\">{short}</a></p>",
        "</div>",
        "<nav aria-label=\"Footer\">",
        "<div><p class=\"label\">Site</p><ul>",
        text.join(pages, "\n"),
        "</ul></div>",
        "<div><p class=\"label\">Project</p><ul>",
        "<li><a href=\"{repository}\">GitHub</a></li>",
        "<li><a href=\"{repository}/releases\">Releases</a></li>",
        "<li><a href=\"{root}{docs_folder}roadmap.html\">Roadmap</a></li>",
        "</ul></div>",
        "</nav>",
        "</div>",
        "</footer>",
    ]
    text.join(lines, "\n")
}

fn palette() -> str {
    let lines = [
        "<dialog class=\"palette\" aria-label=\"Search the site\">",
        "<input type=\"text\" role=\"combobox\" aria-expanded=\"true\" aria-controls=\"palette-results\" aria-autocomplete=\"list\" aria-label=\"Search the site\" placeholder=\"Search docs and packages\" autocomplete=\"off\" spellcheck=\"false\">",
        "<p class=\"palette-status\" role=\"status\"></p>",
        "<ul id=\"palette-results\" role=\"listbox\" aria-label=\"Results\"></ul>",
        "<p class=\"palette-keys\" aria-hidden=\"true\"><span><kbd>↑</kbd><kbd>↓</kbd> move</span><span><kbd>Enter</kbd> open</span><span><kbd>Esc</kbd> close</span></p>",
        "</dialog>",
    ]
    text.join(lines, "\n")
}

fn script_tags(scripts: str[]) -> str {
    var out = builder.builder()
    for script in scripts {
        out.write("<script type=\"module\" src=\"/src/{script}\"></script>\n")
    }
    out.write("<script type=\"module\" src=\"/src/{search_script}\"></script>\n")
    out.to_str()
}

fn shell(chrome: Chrome, page: Page, content: str) -> str {
    let root = root_of(page)
    var out = builder.builder()
    out.write_line("<!doctype html>")
    out.write_line("<html lang=\"en\">")
    out.write_line("<head>")
    out.write_line(head(page))
    out.write_line("</head>")
    out.write_line("<body>")
    out.write_line("<a class=\"skip\" href=\"#main\">Skip to content</a>")
    out.write_line(masthead(root, page.current))
    out.write_line("")
    out.write_line(content)
    out.write_line(footer(chrome, root))
    out.write_line(palette())
    var scripts = page.scripts
    if has_runnable(content) {
        scripts = slices.concat(scripts, [run_script])
    }
    out.write(script_tags(scripts))
    out.write_line("</body>")
    out.write_line("</html>")
    out.to_str()
}

fn placeholder_value(name: str) -> str? {
    match name {
        "origin" => origin
        "repository" => repository
        "words" => word_attributes()
        _ => none
    }
}

fn expand(body: str) -> str ! BuildError {
    var out = builder.with_capacity(body.len)
    var at = 0
    for at < body.len {
        if text.starts_with(body[at..], "{{{{") {
            let name_end = word_end(body, at + 2)
            if name_end > at + 2 && text.starts_with(body[name_end..], "}}}}") {
                let name = body[at + 2..name_end]
                let value = placeholder_value(name) ?? fail Content("placeholder", "unknown placeholder {{{{{name}}}}}")
                out.write(value)
                at = name_end + 2
                continue
            }
        }
        out.write_byte(body[at])
        at += 1
    }
    out.to_str()
}

fn layout(chrome: Chrome, page: Page) -> str {
    let sidebar_label = escape(page.current)
    let heading = text.replace(escape(page.heading), "/", "/<wbr>")
    let lines = [
        "<div class=\"{grid}\">",
        "<nav class=\"sidebar\" aria-label=\"{sidebar_label}\">",
        page.sidebar,
        "</nav>",
        "<main class=\"page\" id=\"main\">",
        "<div class=\"prose\">",
        "<h1>{heading}</h1>",
    ]
    var outline = ""
    if page.outline != "" {
        outline = "<nav class=\"toc\" aria-label=\"On this page\">\n{page.outline}\n</nav>\n"
    }
    let content = "{text.join(lines, "\n")}\n{page.body}</div>\n{outline}</main>\n</div>"
    var scripts = [hover_script]
    for script in page.scripts {
        scripts.push(script)
    }
    shell(chrome, Page { path: page.path, title: page.title, description: page.description, error: page.error, current: page.current, scripts }, content)
}

fn bands(chrome: Chrome, page: Page) -> str ! BuildError {
    let expanded = expand(page.body)?
    shell(chrome, page, "<main id=\"main\">\n{expanded}</main>")
}
