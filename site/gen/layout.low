import std/builder
import std/text

const grid = "wrap grid grid-cols-[minmax(0,1fr)] gap-x-16 gap-y-10 pt-36 pb-24 sm:pt-28 lg:grid-cols-[13rem_minmax(0,1fr)]"
const search_script = "search.js"
const hover_script = "hover.js"

struct Page {
    path: str = ""
    title: str = ""
    description: str = ""
    kind: str = "article"
    error: bool = false
    current: str = ""
    heading: str = ""
    sidebar: str = ""
    body: str = ""
    scripts: []str = []
}

struct Section {
    name: str
    path: str
}

struct Chrome {
    commit: str
}

fn sections() -> []Section {
    [
        Section { name: "Overview", path: "index.html" },
        Section { name: "Docs", path: "{docs_folder}index.html" },
        Section { name: "Packages", path: "{packages_folder}index.html" },
    ]
}

fn root_of(page: Page) -> str {
    if page.error {
        return "/"
    }
    text.repeat("../", text.count(page.path, "/"))
}

fn navigation(root: str, current: str) -> str {
    var links: []str = []
    for section in sections() {
        let marker = if section.name == current { " aria-current=\"page\"" } else { "" }
        push(mut links, "<a{marker} href=\"{root}{section.path}\">{section.name}</a>")
    }
    text.join(links, "\n")
}

fn address(page_path: str) -> str {
    if page_path == "index.html" {
        return "{origin}/"
    }
    "{origin}/{page_path}"
}

fn discovery_lines(page: Page) -> []str {
    if page.error {
        return ["<meta name=\"robots\" content=\"noindex\">"]
    }
    [
        "<meta name=\"description\" content=\"{escape(page.description)}\">",
        "<meta property=\"og:type\" content=\"{page.kind}\">",
        "<meta property=\"og:title\" content=\"{escape(page.title)}\">",
        "<meta property=\"og:description\" content=\"{escape(page.description)}\">",
        "<meta property=\"og:url\" content=\"{address(page.path)}\">",
        "<meta property=\"og:image\" content=\"{origin}/og-image.png\">",
        "<meta name=\"twitter:card\" content=\"summary_large_image\">",
        "<link rel=\"canonical\" href=\"{address(page.path)}\">",
    ]
}

fn font_preloads(page: Page) -> []str {
    var fonts = ["inter"]
    if !page.error {
        push(mut fonts, "jetbrains-mono")
    }
    var preloads: []str = []
    for font in fonts {
        push(mut preloads, "<link rel=\"preload\" href=\"/src/fonts/{font}.woff2\" as=\"font\" type=\"font/woff2\" crossorigin>")
    }
    preloads
}

fn head(page: Page) -> str {
    var lines = ["<meta charset=\"utf-8\">", "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">", "<title>{escape(page.title)}</title>"]
    for line in discovery_lines(page) {
        push(mut lines, line)
    }
    push(mut lines, "<meta name=\"theme-color\" content=\"#f5f5f3\">")
    push(mut lines, "<link rel=\"icon\" href=\"/favicon.ico\" sizes=\"48x48\">")
    push(mut lines, "<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">")
    push(mut lines, "<link rel=\"apple-touch-icon\" href=\"/apple-touch-icon.png\">")
    push(mut lines, "<link rel=\"manifest\" href=\"/site.webmanifest\">")
    for line in font_preloads(page) {
        push(mut lines, line)
    }
    push(mut lines, "<link rel=\"stylesheet\" href=\"/src/style.css\">")
    text.join(lines, "\n")
}

fn masthead(root: str, current: str) -> str {
    let find = "<button class=\"find\" type=\"button\" aria-haspopup=\"dialog\" aria-keyshortcuts=\"Control+K Meta+K /\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"m20 20-4-4\"/></svg>Search<kbd>Ctrl K</kbd></button>"
    let lines = [
        "<header class=\"masthead\">",
        "<div class=\"wrap\">",
        "<a class=\"brand\" href=\"{root}index.html\"><span class=\"mark size-5\" aria-hidden=\"true\"></span>Low</a>",
        "<nav class=\"menu\">",
        navigation(root, current),
        "</nav>",
        find,
        "<a class=\"repo\" href=\"{repository}\">GitHub</a>",
        "</div>",
        "</header>",
    ]
    text.join(lines, "\n")
}

fn footer(chrome: Chrome) -> str {
    var short = chrome.commit
    if short.len > 7 {
        short = short[..7]
    }
    let lines = [
        "<footer class=\"footer\">",
        "<div class=\"wrap\">",
        "Built from <a href=\"{repository}/commit/{chrome.commit}\">{short}</a>",
        "</div>",
        "</footer>",
    ]
    text.join(lines, "\n")
}

fn palette() -> str {
    let lines = [
        "<dialog class=\"palette\" aria-label=\"Search the site\">",
        "<input type=\"text\" role=\"combobox\" aria-expanded=\"true\" aria-controls=\"palette-results\" aria-autocomplete=\"list\" aria-label=\"Search the site\" placeholder=\"Search docs and packages\" autocomplete=\"off\" spellcheck=\"false\">",
        "<p class=\"palette-status\" role=\"status\"></p>",
        "<ul id=\"palette-results\" role=\"listbox\" aria-label=\"Results\"></ul>",
        "<p class=\"palette-keys\" aria-hidden=\"true\"><span><kbd>↑</kbd><kbd>↓</kbd> move</span><span><kbd>Enter</kbd> open</span><span><kbd>Esc</kbd> close</span></p>",
        "</dialog>",
    ]
    text.join(lines, "\n")
}

fn script_tags(scripts: []str) -> str {
    var out = builder.builder()
    for script in scripts {
        out.write("<script type=\"module\" src=\"/src/{script}\"></script>\n")
    }
    out.write("<script type=\"module\" src=\"/src/{search_script}\"></script>\n")
    out.to_str()
}

fn shell(chrome: Chrome, page: Page, content: str) -> str {
    let root = root_of(page)
    var out = builder.builder()
    out.write_line("<!doctype html>")
    out.write_line("<html lang=\"en\">")
    out.write_line("<head>")
    out.write_line(head(page))
    out.write_line("</head>")
    out.write_line("<body>")
    out.write_line("<a class=\"skip\" href=\"#main\">Skip to content</a>")
    out.write_line(masthead(root, page.current))
    out.write_line("")
    out.write_line(content)
    out.write_line(footer(chrome))
    out.write_line(palette())
    out.write(script_tags(page.scripts))
    out.write_line("</body>")
    out.write_line("</html>")
    out.to_str()
}

fn placeholder_value(name: str) -> str? {
    match name {
        "origin" => origin
        "repository" => repository
        _ => none
    }
}

fn expand(body: str) -> str ! BuildError {
    var out = builder.with_capacity(body.len)
    var at = 0
    for at < body.len {
        if text.starts_with(body[at..], "{{{{") {
            let name_end = word_end(body, at + 2)
            if name_end > at + 2 && text.starts_with(body[name_end..], "}}}}") {
                let name = body[at + 2..name_end]
                let value = placeholder_value(name) ?? fail Content("placeholder", "unknown placeholder {{{{{name}}}}}")
                out.write(value)
                at = name_end + 2
                continue
            }
        }
        out.write_byte(body[at])
        at += 1
    }
    out.to_str()
}

fn layout(chrome: Chrome, page: Page) -> str {
    let sidebar_label = escape(page.current)
    let heading = text.replace(escape(page.heading), "/", "/<wbr>")
    let lines = [
        "<div class=\"{grid}\">",
        "<nav class=\"sidebar\" aria-label=\"{sidebar_label}\">",
        page.sidebar,
        "</nav>",
        "<main class=\"prose\" id=\"main\">",
        "<h1>{heading}</h1>",
    ]
    let content = "{text.join(lines, "\n")}\n{page.body}</main>\n</div>"
    var scripts = [hover_script]
    for script in page.scripts {
        push(mut scripts, script)
    }
    shell(chrome, Page { path: page.path, title: page.title, description: page.description, kind: page.kind, error: page.error, current: page.current, scripts }, content)
}

fn panels(chrome: Chrome, page: Page) -> str ! BuildError {
    let expanded = expand(page.body)?
    shell(chrome, page, "<main id=\"main\">\n{expanded}</main>")
}
