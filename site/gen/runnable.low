import std/text

const program_marker = "data-program=\""
const run_script = "run.js"

fn runnable(block: str, checked: Checked) -> str {
    if checked.runnable == "" {
        return block
    }
    "<div class=\"runnable\" {program_marker}{escape(checked.runnable)}\">\n{block}</div>\n"
}

fn runnable_block(block: str, checked: Checked?) -> str {
    match checked {
        some(found) => runnable(block, found)
        none => block
    }
}

fn has_runnable(content: str) -> bool {
    text.contains(content, program_marker)
}
