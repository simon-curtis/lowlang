import std/file
import std/markdown
import std/maps
import std/path
import std/slices
import std/text

const examples_folder = "docs/examples"
const embed_marker = "embed(\""

struct ExampleProgram {
    file: str
    source: str
    description: str
}

struct ExampleGroup {
    folder: str
    title: str
    introduction: str
    programs: []ExampleProgram
}

fn folder_of(relative: str) -> str {
    let folder = path.dir(relative)
    if folder == "." {
        return ""
    }
    folder
}

fn example_files(root: str) -> []str ! BuildError {
    let base = path.join([root, examples_folder])
    let pattern = "{base}/**/*.low"
    let found = file.glob(pattern)
    if found.len == 0 {
        fail Content("examples", "no programs match {pattern}")
    }
    var relatives: []str = []
    for location in found {
        let slashes = slashed(location)
        push(mut relatives, slashes[base.len + 1..])
    }
    relatives
}

fn readme_blocks(root: str, folder: str) -> []markdown.Block ! BuildError {
    let relative = path.join([examples_folder, folder, "README.md"])
    if !file.exists(path.join([root, relative])) {
        return []
    }
    parse_source(root, relative)?
}

fn group_title(blocks: []markdown.Block, folder: str) -> str {
    for block in blocks {
        match block {
            Heading(level, _, content) => {
                if level == 1 {
                    return markdown.plain_text(content)
                }
            }
            _ => {}
        }
    }
    if folder == "" {
        return examples_folder
    }
    folder
}

fn group_introduction(blocks: []markdown.Block) -> str {
    let lead = first_paragraph(blocks)
    match lead {
        some(content) => {
            let html = markdown.render_inline(code_span_renderer(), content)
            "<p class=\"mt-4 text-lg\">{html}</p>"
        }
        none => ""
    }
}

fn links_to(content: []markdown.Inline, target: str) -> bool {
    for node in content {
        match node {
            Link(href, _, children) => {
                if href == target || links_to(children, target) {
                    return true
                }
            }
            Emphasis(children) => {
                if links_to(children, target) {
                    return true
                }
            }
            Strong(children) => {
                if links_to(children, target) {
                    return true
                }
            }
            _ => {}
        }
    }
    false
}

fn row_description(row: []markdown.Cell, file_name: str) -> str? {
    for cell in row {
        if links_to(cell.content, file_name) {
            let last = row[row.len - 1]
            return text.trim(markdown.plain_text(last.content))
        }
    }
    none
}

fn table_description(table: markdown.Table, file_name: str) -> str? {
    for row in table.rows {
        let found = row_description(row, file_name)
        match found {
            some(description) => {
                return description
            }
            none => {}
        }
    }
    none
}

fn program_description(blocks: []markdown.Block, file_name: str) -> str {
    for block in blocks {
        match block {
            Table(table) => {
                let found = table_description(table, file_name)
                match found {
                    some(description) => {
                        return description
                    }
                    none => {}
                }
            }
            _ => {}
        }
    }
    ""
}

fn load_program(root: str, relative: str, blocks: []markdown.Block) -> ExampleProgram ! BuildError {
    let location = path.join([root, examples_folder, relative])
    let content = read_text(location)?
    let source = text.trim_end(content)
    let description = program_description(blocks, path.base(relative))
    ExampleProgram { file: relative, source, description }
}

fn load_group(root: str, folder: str, files: []str) -> ExampleGroup ! BuildError {
    let blocks = readme_blocks(root, folder)?
    var programs: []ExampleProgram = []
    for relative in files {
        let loaded = load_program(root, relative, blocks)?
        push(mut programs, loaded)
    }
    ExampleGroup { folder, title: group_title(blocks, folder), introduction: group_introduction(blocks), programs }
}

fn load_examples(root: str) -> []ExampleGroup ! BuildError {
    let files = example_files(root)?
    var by_folder: [str: []str] = [:]
    for relative in files {
        let folder = folder_of(relative)
        var members = by_folder[folder] ?? []
        push(mut members, relative)
        by_folder[folder] = members
    }
    var folders = maps.keys(by_folder)
    slices.sort(mut folders)
    var groups: []ExampleGroup = []
    for folder in folders {
        let members = by_folder[folder] ?? []
        let group = load_group(root, folder, members)?
        push(mut groups, group)
    }
    groups
}

fn embedded_files(source: str) -> []Prelude {
    var files: []Prelude = []
    var at = 0
    for at < source.len {
        let found = text.index(source[at..], embed_marker)
        if found < 0 {
            break
        }
        let start = at + found + embed_marker.len
        let length = text.index(source[start..], "\"")
        if length < 0 {
            break
        }
        push(mut files, Prelude { path: source[start..start + length], text: "" })
        at = start + length
    }
    files
}

fn collect_examples(batch: *Batch, groups: []ExampleGroup) {
    for group in groups {
        for item in group.programs {
            let files = embedded_files(item.source)
            let checked_program = program(item.source, files)
            batch.examples[item.source] = enlist(batch, checked_program, "{examples_folder}/{item.file}")
        }
    }
}

fn example_entry(item: ExampleProgram, snippets: [str: Checked], linker: *Linker, first: bool) -> str ! BuildError {
    let checked = snippets[item.source] ?? fail Content("examples", "{item.file} was not checked")
    let facts = linker_facts(linker, checked, item.source)
    let block = "<pre class=\"code\" tabindex=\"0\"><code>{low(item.source, facts)}</code></pre>"
    let code = runnable(block, checked)
    let open = if first { " open" } else { "" }
    let name = escape(path.base(item.file))
    let description = escape(item.description)
    let href = escape("{repository}/blob/main/{examples_folder}/{item.file}")
    let lines = [
        "<details class=\"example\" name=\"examples\"{open}>",
        "<summary><span>{name}</span><span class=\"example-note\">{description}</span></summary>",
        "<div class=\"example-body\">",
        code,
        "<p class=\"label\"><a class=\"link\" href=\"{href}\">View {name} on GitHub</a></p>",
        "</div>",
        "</details>",
    ]
    text.join(lines, "\n")
}

fn group_section(group: ExampleGroup, snippets: [str: Checked], linker: *Linker, first: bool) -> str ! BuildError {
    let title = escape(group.title)
    var parts = ["<h3 class=\"sub mt-8\">{title}</h3>", group.introduction]
    for index, item in group.programs {
        let entry = example_entry(item, snippets, linker, first && index == 0)?
        push(mut parts, entry)
    }
    text.join(parts, "\n")
}

fn examples_section(groups: []ExampleGroup, snippets: [str: Checked], linker: *Linker) -> str ! BuildError {
    var sections: []str = []
    for index, group in groups {
        let section = group_section(group, snippets, linker, index == 0)?
        push(mut sections, section)
    }
    let joined = text.join(sections, "\n")
    let tree = "{repository}/tree/main/{examples_folder}"
    "{joined}\n<p class=\"mt-10 text-lg\">Every program is in <a class=\"link\" href=\"{tree}\">{examples_folder}</a> on GitHub, and the standard library is in the <a class=\"link\" href=\"{packages_folder}index.html\">packages index</a>.</p>"
}
