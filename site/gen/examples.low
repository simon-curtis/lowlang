import std/text

struct Pick {
    module_path: str
    name: str
}

fn picks() -> []Pick {
    [
        Pick { module_path: "std/net", name: "line_server" },
        Pick { module_path: "std/http", name: "json_api" },
        Pick { module_path: "std/json", name: "typed" },
        Pick { module_path: "std/sync", name: "worker_pool" },
        Pick { module_path: "std/slices", name: "daily_sales" },
        Pick { module_path: "std/flag", name: "cli" },
    ]
}

fn picked_example(modules: []Module, pick: Pick) -> Example ! BuildError {
    for module in modules {
        if module.path != pick.module_path {
            continue
        }
        for example in module.examples {
            if example.name == pick.name {
                return example
            }
        }
    }
    fail Content("examples", "{pick.module_path} has no example {pick.name}")
}

fn example_entry(pick: Pick, example: Example, snippets: [str: Checked], linker: *Linker, first: bool) -> str ! BuildError {
    let source = example_source(example)
    let checked = snippets[source] ?? fail Content("examples", "{pick.module_path} {pick.name} was not checked")
    let facts = linker_facts(linker, checked, source)
    let page = "{packages_folder}{page_file(pick.module_path)}"
    let output = escape(text.trim_end(example.output))
    let open = if first { " open" } else { "" }
    let module_name = escape(pick.module_path)
    let pick_name = escape(pick.name)
    let code = low(source, facts)
    let anchor = example_anchor(example)
    let lines = [
        "<details class=\"example\" name=\"examples\"{open}>",
        "<summary><span>{pick_name}</span><code>{module_name}</code></summary>",
        "<div class=\"example-body\">",
        "<pre class=\"code\" tabindex=\"0\"><code>{code}</code></pre>",
        "<div>",
        "<p class=\"label\">Output</p>",
        "<pre class=\"code\" tabindex=\"0\"><code>{output}</code></pre>",
        "<p class=\"mt-6\"><a class=\"link\" href=\"{page}#{anchor}\">{module_name}</a></p>",
        "</div>",
        "</div>",
        "</details>",
    ]
    text.join(lines, "\n")
}

fn example_total(modules: []Module) -> i64 {
    var total = 0
    for module in modules {
        total += module.examples.len
    }
    total
}

fn examples_section(modules: []Module, snippets: [str: Checked], linker: *Linker) -> str ! BuildError {
    var entries: []str = []
    for index, pick in picks() {
        let example = picked_example(modules, pick)?
        let entry = example_entry(pick, example, snippets, linker, index == 0)?
        push(mut entries, entry)
    }
    let total = example_total(modules)
    let joined = text.join(entries, "\n")
    "{joined}\n<p class=\"mt-10 text-lg\">The standard library holds {total} examples, each a program that runs. <a class=\"link\" href=\"{packages_folder}index.html\">Browse packages</a></p>"
}
