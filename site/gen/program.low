import std/builder
import std/slices
import std/text

struct Prelude {
    path: str
    text: str
}

struct Line {
    text: str
    source: i64
}

struct Unit {
    declares: bool
    lines: []Line
}

struct Position {
    row: i64
    column: i64
}

struct Program {
    source: str
    text: str
    files: []Prelude
    rows: []i64
    sources: []i64
    starts: []i64
    runs: bool
}

fn starts_with_keyword(rest: str, word: str) -> bool {
    text.starts_with(rest, word) && word.len < rest.len && space_width(rest, word.len) > 0
}

fn starts_function(rest: str) -> bool {
    if !text.starts_with(rest, "fn") {
        return false
    }
    let blank = space_end(rest, 2)
    blank > 2 && blank < rest.len && is_word_byte(rest[blank])
}

fn starts_declaration(rest: str) -> bool {
    for word in ["struct", "enum", "const", "import", "extern"] {
        if starts_with_keyword(rest, word) {
            return true
        }
    }
    starts_function(rest)
}

fn is_declaration(line: str) -> bool {
    if text.starts_with(line, "///") {
        return true
    }
    var rest = line
    if starts_with_keyword(line, "pub") {
        rest = line[space_end(line, 3)..]
    }
    starts_declaration(rest)
}

fn is_continuation(line: str) -> bool {
    if line.len == 0 {
        return true
    }
    let c = line[0]
    space_width(line, 0) > 0 || c == '}' || c == ')' || c == ']'
}

fn units(lines: []str, first: i64) -> []Unit {
    var groups: []Unit = []
    for index, line in lines {
        if groups.len == 0 || !is_continuation(line) {
            push(mut groups, Unit { declares: is_declaration(line), lines: [] })
        }
        let last = groups.len - 1
        push(mut groups[last].lines, Line { text: line, source: index - first })
    }
    groups
}

fn elision_follows(source: str, from: i64) -> bool {
    var at = from
    for at < source.len {
        let c = source[at]
        if c == '\n' || c == '\r' || c == '}' {
            return true
        }
        let width = space_width(source, at)
        if width == 0 {
            return false
        }
        at += width
    }
    true
}

fn elision_end(source: str, from: i64) -> i64 {
    if text.starts_with(source[from..], "...") && elision_follows(source, from + 3) {
        return from + 3
    }
    -1
}

fn elide(source: str) -> str {
    var out = builder.with_capacity(source.len)
    var at = 0
    for at < source.len {
        let blank_end = space_end(source, at)
        let at_line_start = at == 0 || source[at - 1] == '\n'
        if at_line_start && elision_end(source, blank_end) >= 0 {
            out.write(source[at..blank_end])
            out.write("for {{}}")
            at = elision_end(source, blank_end)
            continue
        }
        if source[at] == '{' {
            let inner_end = space_end(source, at + 1)
            if elision_end(source, inner_end) >= 0 {
                out.write(source[at..inner_end])
                out.write("for {{}}")
                at = elision_end(source, inner_end)
                continue
            }
        }
        out.write_byte(source[at])
        at += 1
    }
    out.to_str()
}

fn hidden_lines(preludes: []Prelude) -> []str {
    var parts: []str = []
    for prelude in preludes {
        if prelude.path == "" {
            push(mut parts, prelude.text)
        }
    }
    let code = text.join(parts, "\n")
    if code.len == 0 {
        return []
    }
    text.split(code, '\n')
}

fn declares_main(line: Line) -> bool {
    text.starts_with(line.text, "fn main(")
}

fn has_body(statements: []Line) -> bool {
    for line in statements {
        if !is_blank(line.text) {
            return true
        }
    }
    false
}

fn external_files(preludes: []Prelude) -> []Prelude {
    var files: []Prelude = []
    for prelude in preludes {
        if prelude.path != "" {
            push(mut files, prelude)
        }
    }
    files
}

fn line_starts(source_lines: []str) -> []i64 {
    var starts: []i64 = []
    var start = 0
    for line in source_lines {
        push(mut starts, start)
        start += line.len + 1
    }
    starts
}

fn program(source: str, preludes: []Prelude) -> Program {
    var hidden = hidden_lines(preludes)
    var head = ""
    if hidden.len > 0 && text.ends_with(hidden[hidden.len - 1], "{{") {
        head = hidden[hidden.len - 1]
        truncate(mut hidden, hidden.len - 1)
    }
    let elided = elide(source)
    let groups = units(slices.concat(hidden, text.split(elided, '\n')), hidden.len)
    var declarations: []Line = []
    var statements: []Line = []
    for group in groups {
        if group.declares {
            declarations = slices.concat(declarations, group.lines)
        } else {
            statements = slices.concat(statements, group.lines)
        }
    }
    var output = declarations
    var runs = slices.any(declarations, declares_main)
    if has_body(statements) {
        var open = head
        if open == "" {
            open = if slices.any(declarations, declares_main) { "fn snippet() {{" } else { "fn main() {{" }
        }
        runs = runs || text.starts_with(open, "fn main(")
        push(mut output, Line { text: open, source: -1 })
        output = slices.concat(output, statements)
        push(mut output, Line { text: "}}", source: -1 })
    } else if !slices.any(declarations, declares_main) {
        push(mut output, Line { text: "fn main() {{}}", source: -1 })
    }
    let source_lines = text.split(source, '\n')
    var rows = slices.repeat([-1], source_lines.len)
    var sources = slices.repeat([-1], output.len)
    var rendered = builder.builder()
    for row, line in output {
        rendered.write_line(line.text)
        if line.source >= 0 && line.source < rows.len {
            rows[line.source] = row
            sources[row] = line.source
        }
    }
    let files = external_files(preludes)
    Program { source, text: rendered.to_str(), files, rows, sources, starts: line_starts(source_lines), runs: runs && files.len == 0 }
}

fn line_of(p: Program, offset: i64) -> i64 {
    var first = 0
    var last = p.starts.len - 1
    for first < last {
        let middle = (first + last + 1) / 2
        if p.starts[middle] <= offset {
            first = middle
        } else {
            last = middle - 1
        }
    }
    first
}

fn position(p: Program, offset: i64) -> Position {
    let line = line_of(p, offset)
    Position { row: p.rows[line], column: offset - p.starts[line] }
}

fn offset_at(p: Program, row: i64, column: i64) -> i64 {
    if row < 0 || row >= p.sources.len {
        return -1
    }
    let line = p.sources[row]
    if line < 0 {
        return -1
    }
    p.starts[line] + column
}
