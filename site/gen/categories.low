import std/slices

struct Prefix {
    path: str
    names: []str
}

fn prefixes() -> []Prefix {
    [
        Prefix { path: "std/archive", names: ["compression"] },
        Prefix { path: "std/compress", names: ["compression"] },
        Prefix { path: "std/crypto", names: ["crypto"] },
        Prefix { path: "std/hash", names: ["crypto"] },
        Prefix { path: "std/rand", names: ["crypto"] },
        Prefix { path: "std/tls", names: ["crypto", "net"] },
        Prefix { path: "std/webauthn", names: ["crypto", "web"] },
        Prefix { path: "std/ascii85", names: ["encoding"] },
        Prefix { path: "std/base32", names: ["encoding"] },
        Prefix { path: "std/base58", names: ["encoding"] },
        Prefix { path: "std/base64", names: ["encoding"] },
        Prefix { path: "std/charset", names: ["encoding", "text"] },
        Prefix { path: "std/unicode", names: ["encoding", "text"] },
        Prefix { path: "std/bson", names: ["formats"] },
        Prefix { path: "std/cbor", names: ["formats"] },
        Prefix { path: "std/csv", names: ["formats"] },
        Prefix { path: "std/dotenv", names: ["formats"] },
        Prefix { path: "std/ini", names: ["formats"] },
        Prefix { path: "std/json", names: ["formats"] },
        Prefix { path: "std/msgpack", names: ["formats"] },
        Prefix { path: "std/properties", names: ["formats"] },
        Prefix { path: "std/protobuf", names: ["formats"] },
        Prefix { path: "std/serde", names: ["formats"] },
        Prefix { path: "std/toml", names: ["formats"] },
        Prefix { path: "std/xml", names: ["formats"] },
        Prefix { path: "std/yaml", names: ["formats"] },
        Prefix { path: "std/net", names: ["net"] },
        Prefix { path: "std/quic", names: ["net"] },
        Prefix { path: "std/socks", names: ["net"] },
        Prefix { path: "std/http", names: ["net", "web"] },
        Prefix { path: "std/uri", names: ["net", "web"] },
        Prefix { path: "std/header", names: ["net", "web"] },
        Prefix { path: "std/mail", names: ["net"] },
        Prefix { path: "std/smtp", names: ["net"] },
        Prefix { path: "std/cdp", names: ["net"] },
        Prefix { path: "std/web", names: ["web"] },
        Prefix { path: "std/html", names: ["web", "formats"] },
        Prefix { path: "std/mime", names: ["web"] },
        Prefix { path: "std/multipart", names: ["web"] },
        Prefix { path: "std/template", names: ["web", "text"] },
        Prefix { path: "std/sql", names: ["database"] },
        Prefix { path: "std/orm", names: ["database"] },
        Prefix { path: "std/redis", names: ["database", "net"] },
        Prefix { path: "std/atomic", names: ["concurrency"] },
        Prefix { path: "std/cancel", names: ["concurrency"] },
        Prefix { path: "std/pipe", names: ["concurrency", "io"] },
        Prefix { path: "std/sync", names: ["concurrency"] },
        Prefix { path: "std/singleflight", names: ["concurrency"] },
        Prefix { path: "std/ratelimit", names: ["concurrency"] },
        Prefix { path: "std/retry", names: ["concurrency"] },
        Prefix { path: "std/io", names: ["io"] },
        Prefix { path: "std/stdio", names: ["io", "os"] },
        Prefix { path: "std/sys", names: ["io", "os"] },
        Prefix { path: "std/file", names: ["io", "os"] },
        Prefix { path: "std/os", names: ["os"] },
        Prefix { path: "std/process", names: ["os"] },
        Prefix { path: "std/term", names: ["os"] },
        Prefix { path: "std/flag", names: ["os"] },
        Prefix { path: "std/path", names: ["os"] },
        Prefix { path: "std/time", names: ["time"] },
        Prefix { path: "std/text", names: ["text"] },
        Prefix { path: "std/markdown", names: ["text"] },
        Prefix { path: "std/regex", names: ["text"] },
        Prefix { path: "std/builder", names: ["text"] },
        Prefix { path: "std/big", names: ["math"] },
        Prefix { path: "std/math", names: ["math"] },
        Prefix { path: "std/simd", names: ["math"] },
        Prefix { path: "std/bits", names: ["data"] },
        Prefix { path: "std/container", names: ["data"] },
        Prefix { path: "std/maps", names: ["data"] },
        Prefix { path: "std/slices", names: ["data"] },
        Prefix { path: "std/uuid", names: ["data"] },
        Prefix { path: "std/semver", names: ["data"] },
        Prefix { path: "std/image", names: ["media"] },
        Prefix { path: "std/ui", names: ["ui"] },
        Prefix { path: "std/log", names: ["observability"] },
        Prefix { path: "std/otel", names: ["observability"] },
        Prefix { path: "std/testing", names: ["testing"] },
    ]
}

fn covers(prefix: str, module_path: str) -> bool {
    module_path == prefix || (module_path.len > prefix.len && module_path[..prefix.len] == prefix && module_path[prefix.len] == '/')
}

fn categories(module_path: str) -> []str {
    var best_length = -1
    var best: []str = []
    for prefix in prefixes() {
        if covers(prefix.path, module_path) && prefix.path.len > best_length {
            best_length = prefix.path.len
            best = prefix.names
        }
    }
    best
}

fn orphaned(module_paths: []str) -> []str {
    var orphans: []str = []
    for prefix in prefixes() {
        var found = false
        for module_path in module_paths {
            if covers(prefix.path, module_path) {
                found = true
                break
            }
        }
        if !found {
            push(mut orphans, prefix.path)
        }
    }
    orphans
}

fn all_categories(module_paths: []str) -> []str {
    var names: []str = []
    for module_path in module_paths {
        for name in categories(module_path) {
            if !slices.contains(names, name) {
                push(mut names, name)
            }
        }
    }
    slices.sort(mut names)
    names
}
