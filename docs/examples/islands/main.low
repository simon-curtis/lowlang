    islands.stroke_icon("<circle cx='9' cy='8' r='3.5'/><path d='M2.5 20c0-3.6 2.9-6 6.5-6s6.5 2.4 6.5 6'/><path d='M16 4.6a3.5 3.5 0 0 1 0 6.8'/><path d='M18.5 14.3c1.9.7 3 2.5 3 5.7'/>")
}

fn palette_icon() -> svg.Icon {
    islands.stroke_icon("<path d='M12 3a9 9 0 1 0 0 18c1.1 0 1.7-.8 1.7-1.7 0-.5-.2-.9-.5-1.3-.3-.3-.5-.7-.5-1.2 0-.9.7-1.6 1.6-1.6H17a4 4 0 0 0 4-4C21 6.5 17 3 12 3Z'/><circle cx='7.5' cy='11' r='1'/><circle cx='10.5' cy='7' r='1'/><circle cx='15' cy='7.5' r='1'/>")
}

fn inbox_icon() -> svg.Icon {
    islands.stroke_icon("<path d='M3 13l3-8h12l3 8'/><path d='M3 13v6h18v-6h-5.5a3.5 3.5 0 0 1-7 0Z'/>")
}

fn panel_icon() -> svg.Icon {
    islands.stroke_icon("<rect x='3' y='4' width='18' height='16' rx='2'/><path d='M15 4v16'/>")
}

fn trash_icon() -> svg.Icon {
    islands.stroke_icon("<path d='M4 7h16'/><path d='M9 7V4h6v3'/><path d='M6 7l1 13h10l1-13'/><path d='M10 11v5M14 11v5'/>")
}

fn archive_icon() -> svg.Icon {
    islands.stroke_icon("<rect x='3' y='4' width='18' height='4' rx='1'/><path d='M5 8v11h14V8'/><path d='M10 12h4'/>")
}

fn open_icon() -> svg.Icon {
    islands.stroke_icon("<path d='M9 5h10v10'/><path d='M19 5 5 19'/>")
}

fn mark_image(th: islands.Theme) -> image.Image {
    let side = 96
    let centre = f32(side) / 2.0
    let radius = centre * 10.0 / 12.0
    let img = image.create(side, side, Rgba8)
    let accent = th.scheme.accent
    let red = u8((accent >> 16) & 255)
    let green = u8((accent >> 8) & 255)
    let blue = u8(accent & 255)
    for y in 0..side {
        for x in 0..side {
            let dx = f32(x) + 0.5 - centre
            let dy = f32(y) + 0.5 - centre
            let cover = math.clamp(radius - sqrt(dx * dx + dy * dy) + 0.5, 0.0, 1.0)
            let alpha = u8(floor(cover * 255.0 + 0.5))
            img.set(x, y, image.Rgba { r: red, g: green, b: blue, a: alpha })
        }
    }
    img
}

fn now_ms() -> i64 {
    time.monotonic() / 1000000
}

fn step(d: Demo) {
    var motion = d.motion.get()
    let moving = islands.tick(mut motion, false, now_ms())
    d.motion.set(motion)
    if moving {
        ui.after(d.cx, 16, fn() step(d))
    }
}

fn slide_to(d: Demo, target: f32) {
    var motion = d.motion.get()
    islands.set_slide(mut motion, target, now_ms())
    d.motion.set(motion)
    step(d)
}

fn show_details(d: Demo, id: str) {
    d.detail.set(id)
    slide_to(d, 1.0)
}

fn hide_details(d: Demo) {
    slide_to(d, 0.0)
}

fn toggle_details(d: Demo) {
    if d.motion.get().value > 0.5 {
        hide_details(d)
        return
    }
    var id = d.detail.get()
    if id == "" {
        id = d.people.get()[0].id
    }
    show_details(d, id)
}

fn contains_id(ids: []str, id: str) -> bool {
    for found in ids {
        if found == id {
            return true
        }
    }
    false
}

fn toggle_tick(d: Demo, id: str) {
    d.ticked.update(fn(ids: []str) -> []str {
        var out: []str = []
        for found in ids {
            if found != id {
                out.push(found)
            }
        }
        if out.len == ids.len {
            out.push(id)
        }
        out
    })
}

fn set_archived(d: Demo, id: str, archived: bool) {
    d.people.update(fn(all: []Person) -> []Person {
        var out: []Person = []
        for p in all {
            var kept = p
            if p.id == id {
                kept.archived = archived
            }
            out.push(kept)
        }
        out
    })
}

fn remove_person(d: Demo, id: str) {
    d.people.update(fn(all: []Person) -> []Person {
        var out: []Person = []
        for p in all {
            if p.id != id {
                out.push(p)
            }
        }
        out
    })
    if d.detail.get() == id {
        hide_details(d)
    }
}

fn find_person(d: Demo, id: str) -> Person? {
    for p in d.people.get() {
        if p.id == id {
            return p
        }
    }
    none
}

fn theme_of(d: Demo) -> islands.Theme {
    islands.theme(d.scheme.get(), d.face.get(), d.code_size.get())
}

fn open_picker(d: Demo, at: geometry.Point) {
    let p = islands.picker_state(d.cx, "scheme", "Search colour schemes", "No colour scheme matches")
    var choices: []islands.Choice = []
    for s in islands.schemes() {
        choices.push(islands.choice(s.name, s.label, "", s.name))
    }
    islands.load_choices(p, choices, d.scheme.get())
    d.picker_at.set(at)
    d.picker.set(p)
}

fn close_picker(d: Demo) {
    let none_open: islands.Picker? = none
    d.picker.set(none_open)
    d.cx.blur()
}

fn scheme_label(d: Demo) -> str {
    let name = d.scheme.get()
    for s in islands.schemes() {
        if s.name == name {
            return s.label
        }
    }
    name
}

fn ask_to_delete(d: Demo, id: str) {
    d.doomed.set(id)
    islands.focus_confirm(d.cx)
}

fn row_menu(d: Demo, p: Person) -> []islands.MenuItem {
    let id = p.id
    let archive_label = if p.archived { "Restore" } else { "Archive" }
    [
        islands.menu_item("Open details", open_icon(), fn() show_details(d, id))
        islands.menu_item(archive_label, archive_icon(), fn() set_archived(d, id, !p.archived))
        islands.menu_item("Delete", trash_icon(), fn() ask_to_delete(d, id)).separated().with_danger(true)
    ]
}

fn open_menu(d: Demo, at: geometry.Point, p: Person) {
    let items = row_menu(d, p)
    islands.show_menu(d.menu, at, items)
}

fn status_colour(status: str) -> geometry.Color {
    match status {
        "Online" => islands.ok()
        "Away" => islands.warn()
        _ => islands.faint()
    }
}

fn person_row(d: Demo, th: islands.Theme, p: Person) -> ui.Element {
    let id = p.id
    let shown = d.detail.get() == id && d.motion.get().value > 0.0
    let face = islands.face(p.name, p.colour, p.id, none)
    let label = ui.div().column().flex_1().min_width(0.0).children([
        ui.text(p.name).font_weight(500)
        ui.text(p.role).text_size(islands.size_caption()).text_color(islands.muted())
    ])
    let ticked = contains_id(d.ticked.get(), id)
    let box = islands.checkbox(th, "tick-{id}", "", ticked, fn(e: ui.ClickEvent) toggle_tick(d, id))
    islands.list_row("row-{id}", shown).width_full().height(52.0).gap(12.0)
        .on_click(fn(e: ui.ClickEvent) show_details(d, id))
        .on_mouse_down(Right, fn(e: ui.MouseEvent) open_menu(d, e.position, p))
        .children([box, islands.avatar(d.cx, face, 32.0), label, islands.pill(p.status, status_colour(p.status))])
}

fn count_of(d: Demo, archived: bool) -> i64 {
    var n = 0
    for p in d.people.get() {
        if p.archived == archived {
            n += 1
        }
    }
    n
}

fn people_tabs(d: Demo, th: islands.Theme) -> ui.Element {
    let active = d.tab.get() == 0
    let strip = islands.tabs([
        islands.tab(th, "tab-active", "Active {count_of(d, false)}", active, fn(e: ui.ClickEvent) d.tab.set(0))
        islands.tab(th, "tab-archived", "Archived {count_of(d, true)}", !active, fn(e: ui.ClickEvent) d.tab.set(1))
    ])
    let toggle = islands.toggle_button(th, "details-toggle", panel_icon(), d.motion.get().value > 0.5, "Details panel", fn(e: ui.ClickEvent) toggle_details(d))
    ui.div().items_center().height(islands.header_height()).shrink(0.0).padding_x(16.0).border_edges(geometry.Edges { bottom: 1.0 }, islands.border_colour()).children([strip, ui.div().flex_1(), toggle])
}

fn person_rows(d: Demo, th: islands.Theme) -> ui.Element {
    let archived = d.tab.get() == 1
    var rows: []ui.Element = []
    for p in d.people.get() {
        if p.archived == archived {
            rows.push(person_row(d, th, p))
        }
    }
    if rows.len == 0 {
        return islands.empty_state(inbox_icon(), "Nobody here", "People you archive show up in this list.")
    }
    ui.div().id("people-list").column().flex_1().min_height(0.0).overflow_y_scroll().padding(8.0).gap(2.0).children(rows)
}

fn detail_panel(d: Demo, th: islands.Theme) -> ui.Element {
    let reveal = d.motion.get().value
    let panel_width = 300.0 * reveal
    let shown = find_person(d, d.detail.get())
    var content = ui.div()
    match shown {
        some(p) => {
            let face = islands.face(p.name, p.colour, p.id, none)
            let close = islands.icon_button("details-close", islands.window_close_icon(), "Close", fn(e: ui.ClickEvent) hide_details(d))
            let head = ui.div().items_center().gap(12.0).children([islands.avatar(d.cx, face, 48.0), ui.div().column().flex_1().children([ui.text(p.name).font_weight(600), ui.text(p.role).text_color(islands.muted())]), close])
            let status = ui.div().column().gap(6.0).children([islands.field_label("Status"), ui.div().child(islands.pill(p.status, status_colour(p.status)))])
            let code = ui.div().column().gap(6.0).children([islands.field_label("Identifier"), ui.text(p.id).font_family(islands.code_family(th)).text_size(islands.code_pixels(th))])
            content = ui.div().column().gap(16.0).padding(16.0).width(300.0).shrink(0.0).children([head, status, code])
        }
        none => {}
    }
    ui.div().width(panel_width).shrink(0.0).overflow_hidden().border_edges(geometry.Edges { left: if reveal > 0.0 { 1.0 } else { 0.0 } }, islands.border_colour()).child(content)
}

fn people_page(d: Demo, th: islands.Theme) -> ui.Element {
    let left = ui.div().column().flex_1().min_width(0.0).children([people_tabs(d, th), person_rows(d, th)])
    ui.div().flex_1().min_height(0.0).children([left, detail_panel(d, th)])
}

fn size_segments(d: Demo) -> ui.Element {
    var items: []ui.Element = []
    for s in islands.code_sizes() {
        items.push(islands.segment("size-{s}", "{s}", s == d.code_size.get(), fn(e: ui.ClickEvent) d.code_size.set(s)))
    }
    islands.segmented(items)
}

fn face_segments(d: Demo) -> ui.Element {
    var items: []ui.Element = []
    for f in islands.code_faces() {
        let name = f.name
        items.push(islands.segment("face-{name}", f.label, name == d.face.get(), fn(e: ui.ClickEvent) d.face.set(name)))
    }
    islands.segmented(items)
}

fn code_sample(th: islands.Theme) -> ui.Element {
    let lines = "fn main() {{\n    print(\"hello, islands\")\n}}"
    ui.div().padding(12.0).rounded(islands.radius()).background(islands.control()).font_family(islands.code_family(th)).text_size(islands.code_pixels(th)).line_height(islands.code_line_height(th.code_size)).text_color(islands.syntax_plain()).child(ui.text(lines))
}

fn appearance_page(d: Demo, th: islands.Theme) -> ui.Element {
    let chooser = islands.dropdown("scheme-drop", palette_icon(), scheme_label(d), "Choose a colour scheme", fn(e: ui.ClickEvent) open_picker(d, e.position))
    let intro = ui.text("Pick a colour scheme and a code face. The window redraws as you choose.").text_color(islands.muted())
    let scheme_group = ui.div().column().gap(6.0).children([islands.field_label("Colour scheme"), ui.div().child(chooser)])
    let face_group = ui.div().column().gap(6.0).children([islands.field_label("Code face"), ui.div().child(face_segments(d))])
    let size_group = ui.div().column().gap(6.0).children([islands.field_label("Code size"), ui.div().child(size_segments(d))])
    let sample_group = ui.div().column().gap(6.0).children([islands.field_label("Preview"), code_sample(th)])
    ui.div().column().flex_1().gap(20.0).padding(24.0).overflow_y_scroll().children([intro, scheme_group, face_group, size_group, sample_group])
}

fn inbox_page() -> ui.Element {
    ui.div().flex_1().child(islands.empty_state(inbox_icon(), "Nothing in the inbox", "New messages arrive here."))
}

fn page_rail(d: Demo) -> ui.Element {
    let at = d.page.get()
    islands.rail().children([
        islands.rail_button("rail-people", people_icon(), at == 0, "People", fn(e: ui.ClickEvent) d.page.set(0))
        islands.rail_button("rail-appearance", palette_icon(), at == 1, "Appearance", fn(e: ui.ClickEvent) d.page.set(1))
        islands.rail_button("rail-inbox", inbox_icon(), at == 2, "Inbox", fn(e: ui.ClickEvent) d.page.set(2))
    ])
}

fn status_bar(d: Demo) -> ui.Element {
    let total = d.people.get().len
    let ticked = d.ticked.get().len
    ui.div().items_center().height(islands.status_height()).shrink(0.0).padding_x(12.0).gap(16.0).border_edges(geometry.Edges { top: 1.0 }, islands.border_colour()).text_size(islands.size_small()).text_color(islands.muted()).children([
        ui.text("{total} people, {ticked} ticked")
        ui.div().flex_1()
        ui.text("Colour scheme")
        islands.keys("ctrl+k")
    ])
}

fn page_body(d: Demo, th: islands.Theme) -> ui.Element {
    let at = d.page.get()
    if at == 0 {
        return people_page(d, th)
    }
    if at == 1 {
        return appearance_page(d, th)
    }
    inbox_page()
}

fn content(d: Demo, th: islands.Theme) -> ui.Element {
    let main_column = ui.div().column().flex_1().min_width(0.0).children([page_body(d, th), status_bar(d)])
    ui.div().size_full().children([page_rail(d), main_column])
}

fn layers(d: Demo, th: islands.Theme) -> []ui.Element {
    var out: []ui.Element = []
    out.push(islands.context_menu(d.menu))
    match d.picker.get() {
        some(p) => {
            let at = d.picker_at.get()
            let chosen = fn(key: str) {
                d.scheme.set(key)
                close_picker(d)
            }
            let dismissed = fn() close_picker(d)
            let body = islands.picker(th, p, chosen, dismissed)
            let spec = ui.Anchor { position: at, snap: true, margin: 4.0 }
            let placed = ui.anchored(spec).child(body)
            out.push(ui.deferred(placed).priority(2))
        }
        none => {}
    }
    let doomed = d.doomed.get()
    if doomed != "" {
        match find_person(d, doomed) {
            some(p) => {
                let detail = "{p.name}, {p.role}\nThis removes them from every list."
                let confirmed = fn() {
                    remove_person(d, doomed)
                    d.doomed.set("")
                }
                let dismissed = fn() d.doomed.set("")
                out.push(islands.confirm_dialog(th, "Delete {p.name}?", detail, "Delete", confirmed, dismissed))
            }
            none => {}
        }
    }
    out
}

fn window_view(d: Demo) -> ui.Element {
    let th = theme_of(d)
    let mark = islands.brand(d.mark, false)
    let body = content(d, th)
    let window = islands.tool_window(th, d.cx, d.backdrop, "Islands", mark, body)
    var parts: []ui.Element = [window]
    for layer in layers(d, th) {
        parts.push(layer)
    }
    ui.div().relative().size_full().children(parts)
}

fn demo(cx: ui.Context) -> Demo {
    let th = islands.theme("pink", "jetbrains", 13)
    let none_open: islands.Picker? = none
    Demo {
        cx
        backdrop: islands.backdrop(cx)
        mark: cx.render_image(mark_image(th))
        people: cx.signal(roster())
        page: cx.signal(0)
        tab: cx.signal(0)
        ticked: cx.signal(["ada"])
        detail: cx.signal("")
        scheme: cx.signal("pink")
        face: cx.signal("jetbrains")
        code_size: cx.signal(13)
        picker: cx.signal(none_open)
        picker_at: cx.signal(geometry.Point {})
        menu: islands.menu_state(cx)
        doomed: cx.signal("")
        motion: cx.signal(islands.slide(0.0))
    }
}

fn start(d: Demo) {
    d.cx.on_app_action("scheme.pick", fn() {
        d.page.set(1)
        open_picker(d, geometry.point(120.0, 120.0))
    })
    d.cx.bind("ctrl-k", "scheme.pick", "") or {
        print("ctrl-k is not bound")
    }
    ui.bind_field_keys(d.cx) or {
        print("text keys are not bound")
    }
}

fn main() ! ui.Error {
    let options = ui.Options { title: "Islands", width: 1000, height: 680, decorations: platform.Decorations.Client, background: islands.canvas() }
    using app = ui.open(options)?
    islands.load_fonts(app.cx) or {
        print("the bundled fonts could not be read; system fonts are used")
    }
    let d = demo(app.cx)
    start(d)
    app.run(fn() -> ui.Element { window_view(d) })?
}
