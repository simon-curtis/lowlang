import std/image
import std/math
import std/time
import std/ui
import std/ui/geometry
import std/ui/islands
import std/ui/platform
import std/ui/svg

struct Person {
    id: str
    name: str
    role: str
    colour: str
    status: str
    archived: bool
}

struct Demo {
    cx: ui.Context
    backdrop: islands.Backdrop
    mark: ui.RenderImage
    people: ui.Signal[[]Person]
    page: ui.Signal[i64]
    tab: ui.Signal[i64]
    ticked: ui.Signal[[]str]
    detail: ui.Signal[str]
    scheme: ui.Signal[str]
    face: ui.Signal[str]
    code_size: ui.Signal[i64]
    picker: ui.Signal[islands.Picker?]
    picker_at: ui.Signal[geometry.Point]
    menu: islands.Menu
    doomed: ui.Signal[str]
    motion: ui.Signal[islands.Slide]
}

fn roster() -> []Person {
    [
        Person { id: "ada", name: "Ada Lovelace", role: "Analyst", colour: "#ec4899", status: "Online", archived: false }
        Person { id: "alan", name: "Alan Turing", role: "Cryptanalyst", colour: "#3b82f6", status: "Away", archived: false }
        Person { id: "grace", name: "Grace Hopper", role: "Compiler author", colour: "#10b981", status: "Online", archived: false }
        Person { id: "linus", name: "Linus Torvalds", role: "Kernel maintainer", colour: "#f59e0b", status: "Away", archived: false }
        Person { id: "margaret", name: "Margaret Hamilton", role: "Flight software", colour: "#8b5cf6", status: "Online", archived: false }
        Person { id: "dennis", name: "Dennis Ritchie", role: "Language designer", colour: "#14b8a6", status: "Offline", archived: true }
        Person { id: "ken", name: "Ken Thompson", role: "Systems programmer", colour: "#ef4444", status: "Offline", archived: true }
    ]
}

