import std/file
import std/io
import std/os
import std/ssh
import std/ssh/daemon
import std/stdio
import std/sys

fn complain(message: str) {
    let err = stdio.stderr()
    io.write_all(err, bytes("sshd: {message}\n")) or {}
    stdio.exit(1)
}

fn describe(e: daemon.Error) -> str {
    match e {
        UnknownKeyword(at, keyword) => "line {at}: unsupported keyword {keyword}"
        BadValue(at, keyword) => "line {at}: unsupported value for {keyword}"
        HostKey(path) => "cannot load host key {path}"
        NoHostKey => "no HostKey configured"
        Unseparated(reason) => "cannot separate privilege: {reason}"
    }
}

fn hung_up(e: ssh.Error) -> bool {
    match e {
        Io(cause) => cause == io.Error.Eof
        _ => false
    }
}

fn main() {
    let args = os.args()
    if args.len == 2 && args[1] == "sftp-server" {
        daemon.serve_sftp() or complain("sftp failed")
        return
    }
    if args.len == 2 && args[1] == "connection" {
        daemon.serve_separated() catch {
            e => {
                if !hung_up(e) {
                    complain("connection: {e}")
                }
            }
        }
        return
    }
    var path = "/etc/ssh/sshd_config"
    var check_only = false
    var i = 1
    for i < args.len {
        if args[i] == "-t" {
            check_only = true
        } else if args[i] == "-f" && i + 1 < args.len {
            i += 1
            path = args[i]
        } else {
            complain("usage: sshd [-t] [-f config]")
        }
        i += 1
    }
    let content = file.read_text(path) or {
        complain("cannot read {path}")
        return
    }
    let settings = daemon.parse_config(content) catch {
        e => {
            complain("{path}: {describe(e)}")
            return
        }
    }
    let executable = os.executable() or {
        complain("cannot find its own executable")
        return
    }
    var d = daemon.prepare(settings, executable) catch {
        e => {
            complain(describe(e))
            return
        }
    }
    if sys.euid() == 0 {
        d.separation = daemon.separation_for(executable) catch {
            e => {
                complain(describe(e))
                return
            }
        }
    }
    if check_only {
        return
    }
    daemon.serve(d, daemon.server_config(d)) catch {
        e => complain("listen: {e}")
    }
}
