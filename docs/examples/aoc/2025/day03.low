import std/slices
import std/text

fn digit_value(c: u8) -> i64 {
    i64(c) - i64('0')
}

fn best_joltage(bank: str, count: i64) -> i64 {
    var total = 0
    var from = 0
    for picked in 0..count {
        let last_start = bank.len - (count - picked)
        var best_at = from
        for i in from..last_start + 1 {
            if bank[i] > bank[best_at] {
                best_at = i
            }
        }
        total = total * 10 + digit_value(bank[best_at])
        from = best_at + 1
    }
    total
}

fn total_joltage(input: str, count: i64) -> i64 {
    text.lines(input)
        .map(fn(line) text.trim(line))
        .filter(fn(bank) bank.len >= count)
        .map(fn(bank) best_joltage(bank, count))
        .sum()
}

fn part1(input: str) -> i64 {
    total_joltage(input, 2)
}

fn part2(input: str) -> i64 {
    total_joltage(input, 12)
}

fn main() {
    let input = embed("input/day03.txt")
    print("part 1: {part1(input)}")
    print("part 2: {part2(input)}")
}
