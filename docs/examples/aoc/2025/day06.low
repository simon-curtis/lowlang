import std/math
import std/slices
import std/text

struct Span {
    left: i64
    right: i64
}

struct Worksheet {
    numbers: []str
    operators: str
    spans: []Span
}

fn cell(row: str, col: i64) -> u8 {
    if col < row.len { row[col] } else { ' ' }
}

fn segment(row: str, span: Span) -> str {
    let right = math.min(span.right, row.len)
    if span.left >= right { "" } else { row[span.left..right] }
}

fn blank_column(rows: []str, col: i64) -> bool {
    rows.all(fn(row) cell(row, col) == ' ')
}

fn find_spans(rows: []str, width: i64) -> []Span {
    var spans: []Span = []
    var left = -1
    for col in 0..width + 1 {
        let separator = col == width || blank_column(rows, col)
        if !separator && left < 0 {
            left = col
        } else if separator && left >= 0 {
            push(mut spans, Span { left, right: col })
            left = -1
        }
    }
    spans
}

fn drop_blank_tail(rows: []str) -> []str {
    var count = rows.len
    for count > 0 && text.trim(rows[count - 1]).len == 0 {
        count -= 1
    }
    rows[..count]
}

fn parse_worksheet(input: str) -> Worksheet {
    let rows = drop_blank_tail(text.lines(input))
    let width = rows.map(fn(row) row.len).max() ?? 0
    let numbers = rows[..rows.len - 1]
    let operators = rows[rows.len - 1]
    Worksheet { numbers, operators, spans: find_spans(rows, width) }
}

fn operator_of(sheet: Worksheet, span: Span) -> u8 {
    for col in span.left..span.right {
        let c = cell(sheet.operators, col)
        if c == '*' || c == '+' {
            return c
        }
    }
    '+'
}

fn combine(operator: u8, values: []i64) -> i64 {
    if operator == '*' {
        values.fold(1, fn(product, value) product * value)
    } else {
        values.sum()
    }
}

fn row_numbers(sheet: Worksheet, span: Span) -> []i64 ! text.ParseError {
    var values: []i64 = []
    let pieces = sheet.numbers
        .map(fn(row) text.trim(segment(row, span)))
        .filter(fn(piece) piece.len > 0)
    for piece in pieces {
        push(mut values, text.parse_int(piece)?)
    }
    values
}

fn column_number(sheet: Worksheet, col: i64) -> i64? {
    let digits = sheet.numbers
        .map(fn(row) cell(row, col))
        .filter(fn(c) c >= '0' && c <= '9')
    if digits.len == 0 {
        none
    } else {
        digits.fold(0, fn(value, c) value * 10 + i64(c - '0'))
    }
}

fn column_numbers(sheet: Worksheet, span: Span) -> []i64 {
    var values: []i64 = []
    for col in span.left..span.right {
        let value = column_number(sheet, col)
        match value {
            some(v) => push(mut values, v)
            none => {}
        }
    }
    values
}

fn part1(sheet: Worksheet) -> i64 ! text.ParseError {
    var total = 0
    for span in sheet.spans {
        let values = row_numbers(sheet, span)?
        total += combine(operator_of(sheet, span), values)
    }
    total
}

fn part2(sheet: Worksheet) -> i64 {
    sheet.spans
        .map(fn(span) combine(operator_of(sheet, span), column_numbers(sheet, span)))
        .sum()
}

fn main() ! text.ParseError {
    let sheet = parse_worksheet(embed("input/day06.txt"))
    let first = part1(sheet)?
    print("part 1: {first}")
    print("part 2: {part2(sheet)}")
}
