import std/maps
import std/math
import std/slices
import std/text

struct Range {
    lo: i64
    hi: i64
}

fn parse_range(piece: str) -> Range ! text.ParseError {
    let bounds = text.split(piece, '-')
    let lo = text.parse_int(text.trim(bounds[0]))?
    let hi = text.parse_int(text.trim(bounds[1]))?
    Range { lo, hi }
}

fn non_blank_pieces(input: str) -> []str {
    text.split(text.trim(input), ',')
        .map(fn(piece) text.trim(piece))
        .filter(fn(piece) piece.len > 0)
}

fn parse_ranges(input: str) -> []Range ! text.ParseError {
    var ranges: []Range = []
    for piece in non_blank_pieces(input) {
        push(mut ranges, parse_range(piece)?)
    }
    ranges
}

fn digit_count(n: i64) -> i64 {
    var count = 0
    var rest = n
    for rest > 0 {
        rest /= 10
        count += 1
    }
    count
}

fn ceil_div(a: i64, b: i64) -> i64 {
    (a + b - 1) / b
}

fn repeat_counts(length: i64, pairs_only: bool) -> []i64 {
    var counts: []i64 = []
    for count in 2..length + 1 {
        if length % count == 0 && (!pairs_only || count == 2) {
            push(mut counts, count)
        }
    }
    counts
}

fn add_repeated(seen: [i64: bool], range: Range, length: i64, count: i64) {
    let period = length / count
    let multiplier = (math.ipow(10, length) - 1) / (math.ipow(10, period) - 1)
    let first = math.max(ceil_div(range.lo, multiplier), math.ipow(10, period - 1))
    let last = math.min(range.hi / multiplier, math.ipow(10, period) - 1)
    for base in first..last + 1 {
        seen[base * multiplier] = true
    }
}

fn invalid_ids(ranges: []Range, pairs_only: bool) -> [i64: bool] {
    var seen: [i64: bool] = [:]
    for range in ranges {
        for length in digit_count(range.lo)..digit_count(range.hi) + 1 {
            for count in repeat_counts(length, pairs_only) {
                add_repeated(seen, range, length, count)
            }
        }
    }
    seen
}

fn part1(ranges: []Range) -> i64 {
    invalid_ids(ranges, true).keys().sum()
}

fn part2(ranges: []Range) -> i64 {
    invalid_ids(ranges, false).keys().sum()
}

fn main() ! text.ParseError {
    let ranges = parse_ranges(embed("input/day02.txt"))?
    print("part 1: {part1(ranges)}")
    print("part 2: {part2(ranges)}")
}
