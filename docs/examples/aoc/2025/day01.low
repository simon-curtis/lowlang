import std/slices
import std/text

fn dial_size() -> i64 {
    100
}

fn dial_start() -> i64 {
    50
}

fn non_blank_lines(input: str) -> []str {
    text.lines(input)
        .map(fn(line) text.trim(line))
        .filter(fn(line) line.len > 0)
}

fn parse_turn(line: str) -> i64 ! text.ParseError {
    let distance = text.parse_int(line[1..])?
    if line[0] == 'L' {
        -distance
    } else {
        distance
    }
}

fn parse_turns(input: str) -> []i64 ! text.ParseError {
    var turns: []i64 = []
    for line in non_blank_lines(input) {
        push(mut turns, parse_turn(line)?)
    }
    turns
}

fn wrap(position: i64) -> i64 {
    ((position % dial_size()) + dial_size()) % dial_size()
}

fn zero_clicks(position: i64, turn: i64) -> i64 {
    if turn >= 0 {
        (position + turn) / dial_size()
    } else {
        let mirrored = wrap(-position)
        (mirrored - turn) / dial_size()
    }
}

fn part1(input: str) -> i64 ! text.ParseError {
    parse_turns(input)?
        .scan(dial_start(), fn(position, turn) wrap(position + turn))
        .count(fn(position) position == 0)
}

fn part2(input: str) -> i64 ! text.ParseError {
    let turns = parse_turns(input)?
    let positions = turns.scan(dial_start(), fn(position, turn) wrap(position + turn))
    [dial_start()]
        .concat(positions)
        .zip(turns)
        .map(fn(step) zero_clicks(step.first, step.second))
        .sum()
}

fn main() ! text.ParseError {
    let input = embed("input/day01.txt")
    print("part 1: {part1(input)?}")
    print("part 2: {part2(input)?}")
}
