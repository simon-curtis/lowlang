import std/slices
import std/text

struct Manifold {
    splitters_hit: i64
    timelines: i64
}

fn blank_row(width: i64) -> []i64 {
    [0].repeat(width)
}

fn add_beams(mut beams: []i64, column: i64, count: i64) {
    if column >= 0 && column < beams.len {
        beams[column] += count
    }
}

fn start_beams(first_row: str) -> []i64 {
    var beams = blank_row(first_row.len)
    let start = text.index_byte(first_row, 'S')
    if start >= 0 {
        beams[start] = 1
    }
    beams
}

fn drop_row(beams: []i64, row: str, mut splitters_hit: i64) -> []i64 {
    var next = blank_row(beams.len)
    for column, count in beams {
        if count == 0 {
            continue
        }
        if column < row.len && row[column] == '^' {
            splitters_hit += 1
            add_beams(mut next, column - 1, count)
            add_beams(mut next, column + 1, count)
        } else {
            add_beams(mut next, column, count)
        }
    }
    next
}

fn simulate(input: str) -> Manifold {
    let rows = text.lines(input)
    if rows.len == 0 {
        return Manifold { splitters_hit: 0, timelines: 0 }
    }
    var beams = start_beams(rows[0])
    var splitters_hit = 0
    for row_index in 1..rows.len {
        beams = drop_row(beams, rows[row_index], mut splitters_hit)
    }
    Manifold { splitters_hit, timelines: beams.sum() }
}

fn part1(input: str) -> i64 {
    simulate(input).splitters_hit
}

fn part2(input: str) -> i64 {
    simulate(input).timelines
}

fn main() {
    let input = embed("input/day07.txt")
    print("part 1: {part1(input)}")
    print("part 2: {part2(input)}")
}
