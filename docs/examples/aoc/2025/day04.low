import std/slices
import std/text

struct Grid {
    width: i64
    height: i64
    rolls: []bool
}

fn parse_grid(input: str) -> Grid {
    let rows = text.lines(input)
        .map(fn(line) text.trim(line))
        .filter(fn(row) row.len > 0)
    let width = if rows.len > 0 { rows[0].len } else { 0 }
    var rolls: []bool = []
    for row in rows {
        for x in 0..width {
            push(mut rolls, x < row.len && row[x] == '@')
        }
    }
    Grid { width, height: rows.len, rolls }
}

fn roll_at(grid: Grid, x: i64, y: i64) -> bool {
    x >= 0 && x < grid.width && y >= 0 && y < grid.height && grid.rolls[y * grid.width + x]
}

fn neighbour_rolls(grid: Grid, x: i64, y: i64) -> i64 {
    var count = 0
    for dy in -1..2 {
        for dx in -1..2 {
            if (dx != 0 || dy != 0) && roll_at(grid, x + dx, y + dy) {
                count += 1
            }
        }
    }
    count
}

fn is_accessible(grid: Grid, x: i64, y: i64) -> bool {
    roll_at(grid, x, y) && neighbour_rolls(grid, x, y) < 4
}

fn count_accessible(grid: Grid) -> i64 {
    var count = 0
    for y in 0..grid.height {
        for x in 0..grid.width {
            if is_accessible(grid, x, y) {
                count += 1
            }
        }
    }
    count
}

fn remove_round(grid: Grid) -> i64 {
    var doomed: []i64 = []
    for y in 0..grid.height {
        for x in 0..grid.width {
            if is_accessible(grid, x, y) {
                push(mut doomed, y * grid.width + x)
            }
        }
    }
    for cell in doomed {
        grid.rolls[cell] = false
    }
    doomed.len
}

fn remove_all(grid: Grid) -> i64 {
    var total = 0
    for {
        let removed = remove_round(grid)
        if removed == 0 {
            return total
        }
        total += removed
    }
}

fn part1(input: str) -> i64 {
    count_accessible(parse_grid(input))
}

fn part2(input: str) -> i64 {
    remove_all(parse_grid(input))
}

fn main() {
    let input = embed("input/day04.txt")
    print("part 1: {part1(input)}")
    print("part 2: {part2(input)}")
}
