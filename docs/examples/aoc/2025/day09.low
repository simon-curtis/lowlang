import std/math
import std/slices
import std/text

struct Tile {
    x: i64
    y: i64
}

enum Cell {
    Free
    Boundary
    Outside
}

struct Lattice {
    xs: []i64
    ys: []i64
    width: i64
    height: i64
    cells: []Cell
}

fn parse_tiles(input: str) -> []Tile ! text.ParseError {
    var tiles: []Tile = []
    let lines = text.lines(input)
        .map(fn(line) text.trim(line))
        .filter(fn(line) line.len > 0)
    for line in lines {
        let parts = text.split(line, ',')
        let x = text.parse_int(text.trim(parts[0]))?
        let y = text.parse_int(text.trim(parts[1]))?
        push(mut tiles, Tile { x, y })
    }
    tiles
}

fn area(a: Tile, b: Tile) -> i64 {
    (math.abs(a.x - b.x) + 1) * (math.abs(a.y - b.y) + 1)
}

fn part1(tiles: []Tile) -> i64 {
    var best = 0
    for i, a in tiles {
        for b in tiles[i + 1..] {
            best = math.max(best, area(a, b))
        }
    }
    best
}

fn sorted_distinct(values: []i64) -> []i64 {
    var sorted = slices.clone(values)
    slices.sort(mut sorted)
    slices.unique(sorted)
}

fn cell_of(axis: []i64, coordinate: i64) -> i64 {
    2 * slices.lower_bound(axis, coordinate) + 1
}

fn index_of(lattice: Lattice, cx: i64, cy: i64) -> i64 {
    cy * lattice.width + cx
}

fn mark_edge(lattice: Lattice, from: Tile, to: Tile) {
    let x0 = cell_of(lattice.xs, math.min(from.x, to.x))
    let x1 = cell_of(lattice.xs, math.max(from.x, to.x))
    let y0 = cell_of(lattice.ys, math.min(from.y, to.y))
    let y1 = cell_of(lattice.ys, math.max(from.y, to.y))
    for cy in y0..y1 + 1 {
        for cx in x0..x1 + 1 {
            lattice.cells[index_of(lattice, cx, cy)] = Boundary
        }
    }
}

fn visit(lattice: Lattice, mut pending: []i64, cx: i64, cy: i64) {
    if cx < 0 || cy < 0 || cx >= lattice.width || cy >= lattice.height {
        return
    }
    let at = index_of(lattice, cx, cy)
    if lattice.cells[at] == Free {
        lattice.cells[at] = Outside
        push(mut pending, at)
    }
}

fn flood_outside(lattice: Lattice) {
    var pending: []i64 = []
    visit(lattice, mut pending, 0, 0)
    for {
        let at = pop(mut pending) ?? break
        let cx = at % lattice.width
        let cy = at / lattice.width
        visit(lattice, mut pending, cx - 1, cy)
        visit(lattice, mut pending, cx + 1, cy)
        visit(lattice, mut pending, cx, cy - 1)
        visit(lattice, mut pending, cx, cy + 1)
    }
}

fn build_lattice(tiles: []Tile) -> Lattice {
    let axis_x = sorted_distinct(tiles.map(fn(tile) tile.x))
    let axis_y = sorted_distinct(tiles.map(fn(tile) tile.y))
    let width = 2 * axis_x.len + 1
    let height = 2 * axis_y.len + 1
    let cells = slices.repeat([Cell.Free], width * height)
    let lattice = Lattice { xs: axis_x, ys: axis_y, width, height, cells }
    for i, tile in tiles {
        mark_edge(lattice, tile, tiles[(i + 1) % tiles.len])
    }
    flood_outside(lattice)
    lattice
}

fn has_tiles(axis: []i64, cell: i64) -> bool {
    if cell % 2 == 1 || cell == 0 || cell == 2 * axis.len {
        return true
    }
    let k = cell / 2 - 1
    axis[k + 1] - axis[k] > 1
}

fn blocks_rectangles(lattice: Lattice, cx: i64, cy: i64) -> bool {
    lattice.cells[index_of(lattice, cx, cy)] == Outside && has_tiles(lattice.xs, cx) && has_tiles(lattice.ys, cy)
}

fn outside_prefix(lattice: Lattice) -> []i64 {
    let stride = lattice.width + 1
    var prefix = slices.repeat([0], stride * (lattice.height + 1))
    for cy in 0..lattice.height {
        for cx in 0..lattice.width {
            let outside = if blocks_rectangles(lattice, cx, cy) { 1 } else { 0 }
            prefix[(cy + 1) * stride + cx + 1] = outside + prefix[cy * stride + cx + 1] + prefix[(cy + 1) * stride + cx] - prefix[cy * stride + cx]
        }
    }
    prefix
}

fn outside_count(prefix: []i64, stride: i64, x0: i64, y0: i64, x1: i64, y1: i64) -> i64 {
    prefix[(y1 + 1) * stride + x1 + 1] - prefix[y0 * stride + x1 + 1] - prefix[(y1 + 1) * stride + x0] + prefix[y0 * stride + x0]
}

fn part2(tiles: []Tile) -> i64 {
    let lattice = build_lattice(tiles)
    let prefix = outside_prefix(lattice)
    let stride = lattice.width + 1
    var best = 0
    for i, a in tiles {
        for b in tiles[i + 1..] {
            let x0 = cell_of(lattice.xs, math.min(a.x, b.x))
            let x1 = cell_of(lattice.xs, math.max(a.x, b.x))
            let y0 = cell_of(lattice.ys, math.min(a.y, b.y))
            let y1 = cell_of(lattice.ys, math.max(a.y, b.y))
            if outside_count(prefix, stride, x0, y0, x1, y1) == 0 {
                best = math.max(best, area(a, b))
            }
        }
    }
    best
}

fn main() ! text.ParseError {
    let tiles = parse_tiles(embed("input/day09.txt"))?
    print("part 1: {part1(tiles)}")
    print("part 2: {part2(tiles)}")
}
