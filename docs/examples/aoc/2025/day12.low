import std/math
import std/slices
import std/text

enum InputError {
    BadNumber
    BadShape
    BadRegion
    ShapeOutOfOrder
}

struct Cell {
    x: i64
    y: i64
}

struct Shape {
    area: i64
    block: i64
    orientations: [][]Cell
}

struct Region {
    width: i64
    height: i64
    counts: []i64
}

struct Puzzle {
    shapes: []Shape
    regions: []Region
}

struct Search {
    width: i64
    height: i64
    grid: []bool
    remaining: []i64
    shapes: []Shape
}

fn parse_number(s: str) -> i64 ! InputError {
    text.parse_int(text.trim(s)) catch {
        _ => fail BadNumber
    }
}

fn is_region_line(line: str) -> bool {
    text.index_byte(line, 'x') >= 0
}

fn parse_region(line: str) -> Region ! InputError {
    let sides = text.cut(line, ":")
    if !sides.found {
        fail BadRegion
    }
    let size = text.cut(sides.before, "x")
    if !size.found {
        fail BadRegion
    }
    var counts: []i64 = []
    for word in text.fields(sides.after) {
        push(mut counts, parse_number(word)?)
    }
    Region { width: parse_number(size.before)?, height: parse_number(size.after)?, counts }
}

fn parse_cells(rows: []str) -> []Cell ! InputError {
    var cells: []Cell = []
    for y, row in rows {
        for x in 0..row.len {
            if row[x] == '#' {
                push(mut cells, Cell { x, y })
            } else if row[x] != '.' {
                fail BadShape
            }
        }
    }
    cells
}

fn move_cell(cell: Cell, flip: bool, turns: i64) -> Cell {
    var x = cell.x
    var y = cell.y
    if flip {
        x = -x
    }
    for turn in 0..turns {
        let turned_x = -y
        y = x
        x = turned_x
    }
    Cell { x, y }
}

fn transform(cells: []Cell, flip: bool, turns: i64) -> []Cell {
    cells.map(fn(cell) move_cell(cell, flip, turns))
}

fn in_scan_order(cells: []Cell) -> []Cell {
    let xs = cells.map(fn(cell) cell.x)
    let ys = cells.map(fn(cell) cell.y)
    let min_x = xs.min() ?? 0
    let min_y = ys.min() ?? 0
    let max_x = xs.max() ?? 0
    let max_y = ys.max() ?? 0
    let box_width = max_x - min_x + 1
    var present: [i64: bool] = [:]
    for cell in cells {
        present[(cell.y - min_y) * box_width + (cell.x - min_x)] = true
    }
    var ordered: []Cell = []
    for y in 0..max_y - min_y + 1 {
        for x in 0..box_width {
            if present[y * box_width + x] != none {
                push(mut ordered, Cell { x, y })
            }
        }
    }
    ordered
}

fn from_first_cell(cells: []Cell) -> []Cell {
    let first = cells[0]
    cells.map(fn(cell) Cell { x: cell.x - first.x, y: cell.y - first.y })
}

fn distinct_orientations(cells: []Cell) -> [][]Cell {
    var seen: [str: bool] = [:]
    var orientations: [][]Cell = []
    for flip in [false, true] {
        for turns in 0..4 {
            let oriented = from_first_cell(in_scan_order(transform(cells, flip, turns)))
            let key = "{oriented}"
            if seen[key] == none {
                seen[key] = true
                push(mut orientations, oriented)
            }
        }
    }
    orientations
}

fn block_size(cells: []Cell) -> i64 {
    cells.map(fn(cell) math.max(cell.x, cell.y) + 1).max() ?? 0
}

fn make_shape(rows: []str) -> Shape ! InputError {
    let cells = parse_cells(rows)?
    if cells.len == 0 {
        fail BadShape
    }
    Shape { area: cells.len, block: block_size(cells), orientations: distinct_orientations(cells) }
}

fn parse_puzzle(input: str) -> Puzzle ! InputError {
    let lines = text.lines(input)
    var shapes: []Shape = []
    var regions: []Region = []
    var next = 0
    for next < lines.len {
        let line = text.trim(lines[next])
        next += 1
        if line.len == 0 {
            continue
        }
        if is_region_line(line) {
            push(mut regions, parse_region(line)?)
            continue
        }
        if !text.ends_with(line, ":") || parse_number(line[..line.len - 1])? != shapes.len {
            fail ShapeOutOfOrder
        }
        var rows: []str = []
        for next < lines.len && text.trim(lines[next]).len > 0 {
            push(mut rows, text.trim(lines[next]))
            next += 1
        }
        push(mut shapes, make_shape(rows)?)
    }
    if regions.any(fn(region) region.counts.len > shapes.len) {
        fail BadRegion
    }
    Puzzle { shapes, regions }
}

fn fits(search: Search, anchor: i64, cells: []Cell) -> bool {
    let anchor_x = anchor % search.width
    let anchor_y = anchor / search.width
    for cell in cells {
        let x = anchor_x + cell.x
        let y = anchor_y + cell.y
        if x < 0 || x >= search.width || y >= search.height {
            return false
        }
        if search.grid[y * search.width + x] {
            return false
        }
    }
    true
}

fn mark(search: Search, anchor: i64, cells: []Cell, occupied: bool) {
    let anchor_x = anchor % search.width
    let anchor_y = anchor / search.width
    for cell in cells {
        search.grid[(anchor_y + cell.y) * search.width + anchor_x + cell.x] = occupied
    }
}

fn first_free(search: Search, from: i64) -> i64 {
    var at = from
    for at < search.grid.len && search.grid[at] {
        at += 1
    }
    at
}

fn place_all(search: Search, anchor: i64, waste_left: i64, presents_left: i64) -> bool {
    for kind, shape in search.shapes {
        if kind >= search.remaining.len || search.remaining[kind] == 0 {
            continue
        }
        for cells in shape.orientations {
            if !fits(search, anchor, cells) {
                continue
            }
            mark(search, anchor, cells, true)
            search.remaining[kind] -= 1
            let solved = solve(search, anchor + 1, waste_left, presents_left - 1)
            search.remaining[kind] += 1
            mark(search, anchor, cells, false)
            if solved {
                return true
            }
        }
    }
    false
}

fn solve(search: Search, from: i64, waste_left: i64, presents_left: i64) -> bool {
    if presents_left == 0 {
        return true
    }
    let anchor = first_free(search, from)
    if anchor >= search.grid.len {
        return false
    }
    if place_all(search, anchor, waste_left, presents_left) {
        return true
    }
    waste_left > 0 && solve(search, anchor + 1, waste_left - 1, presents_left)
}

fn present_area(shapes: []Shape, region: Region) -> i64 {
    region.counts
        .zip(shapes)
        .map(fn(entry) entry.first * entry.second.area)
        .sum()
}

fn present_count(region: Region) -> i64 {
    region.counts.sum()
}

fn widest_block(shapes: []Shape) -> i64 {
    shapes.fold(1, fn(widest, shape) math.max(widest, shape.block))
}

fn all_fit_by_search(shapes: []Shape, region: Region, waste: i64) -> bool {
    let grid = [false].repeat(region.width * region.height)
    let remaining = region.counts.clone()
    let search = Search { width: region.width, height: region.height, grid, remaining, shapes }
    solve(search, 0, waste, present_count(region))
}

fn all_fit(shapes: []Shape, region: Region) -> bool {
    let waste = region.width * region.height - present_area(shapes, region)
    if waste < 0 {
        return false
    }
    let block = widest_block(shapes)
    if (region.width / block) * (region.height / block) >= present_count(region) {
        return true
    }
    all_fit_by_search(shapes, region, waste)
}

fn part1(input: str) -> i64 ! InputError {
    let puzzle = parse_puzzle(input)?
    puzzle.regions.count(fn(region) all_fit(puzzle.shapes, region))
}

fn main() ! InputError {
    let input = embed("input/day12.txt")
    print("part 1: {part1(input)?}")
}
