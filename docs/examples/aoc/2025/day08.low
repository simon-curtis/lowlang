import std/slices
import std/text

struct Box {
    x: i64
    y: i64
    z: i64
}

struct Edge {
    distance: i64
    a: i64
    b: i64
}

struct Circuits {
    parent: []i64
    size: []i64
    count: i64
}

fn parse_box(line: str) -> Box ! text.ParseError {
    let parts = text.split(line, ',')
    if parts.len != 3 {
        fail Empty
    }
    let x = text.parse_int(text.trim(parts[0]))?
    let y = text.parse_int(text.trim(parts[1]))?
    let z = text.parse_int(text.trim(parts[2]))?
    Box { x, y, z }
}

fn parse_boxes(input: str) -> []Box ! text.ParseError {
    var boxes: []Box = []
    let lines = text.lines(input).filter(fn(line) text.trim(line).len > 0)
    for line in lines {
        push(mut boxes, parse_box(line)?)
    }
    boxes
}

fn squared_distance(p: Box, q: Box) -> i64 {
    let dx = p.x - q.x
    let dy = p.y - q.y
    let dz = p.z - q.z
    dx * dx + dy * dy + dz * dz
}

fn closer(p: Edge, q: Edge) -> bool {
    if p.distance != q.distance {
        return p.distance < q.distance
    }
    if p.a != q.a {
        return p.a < q.a
    }
    p.b < q.b
}

fn sorted_edges(boxes: []Box) -> []Edge {
    var edges: []Edge = []
    for a in 0..boxes.len {
        for b in a + 1..boxes.len {
            push(mut edges, Edge { distance: squared_distance(boxes[a], boxes[b]), a, b })
        }
    }
    slices.sort_by(mut edges, closer)
    edges
}

fn separate_circuits(count: i64) -> Circuits {
    var parent: []i64 = []
    var size: []i64 = []
    for i in 0..count {
        push(mut parent, i)
        push(mut size, 1)
    }
    Circuits { parent, size, count }
}

fn root_of(circuits: Circuits, box: i64) -> i64 {
    var at = box
    for circuits.parent[at] != at {
        circuits.parent[at] = circuits.parent[circuits.parent[at]]
        at = circuits.parent[at]
    }
    at
}

fn connect(mut circuits: Circuits, edge: Edge) {
    var a = root_of(circuits, edge.a)
    var b = root_of(circuits, edge.b)
    if a == b {
        return
    }
    if circuits.size[a] < circuits.size[b] {
        let swapped = a
        a = b
        b = swapped
    }
    circuits.parent[b] = a
    circuits.size[a] += circuits.size[b]
    circuits.count -= 1
}

fn connection_limit(boxes: []Box) -> i64 {
    if boxes.len < 100 { 10 } else { 1000 }
}

fn circuit_sizes(circuits: Circuits) -> []i64 {
    var sizes: []i64 = []
    for box in 0..circuits.parent.len {
        if circuits.parent[box] == box {
            push(mut sizes, circuits.size[box])
        }
    }
    sizes
}

fn largest_three_product(sizes: []i64) -> i64 {
    var ordered = slices.clone(sizes)
    slices.sort(mut ordered)
    slices.reverse(mut ordered)
    ordered
        .take(3)
        .fold(1, fn(product, size) product * size)
}

fn part1(boxes: []Box) -> i64 {
    var circuits = separate_circuits(boxes.len)
    let edges = sorted_edges(boxes)
    for edge in slices.take(edges, connection_limit(boxes)) {
        connect(mut circuits, edge)
    }
    largest_three_product(circuit_sizes(circuits))
}

fn part2(boxes: []Box) -> i64 {
    var circuits = separate_circuits(boxes.len)
    if circuits.count < 2 {
        return 0
    }
    for edge in sorted_edges(boxes) {
        connect(mut circuits, edge)
        if circuits.count == 1 {
            return boxes[edge.a].x * boxes[edge.b].x
        }
    }
    0
}

fn main() ! text.ParseError {
    let boxes = parse_boxes(embed("input/day08.txt"))?
    print("part 1: {part1(boxes)}")
    print("part 2: {part2(boxes)}")
}
