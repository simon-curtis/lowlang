import std/math
import std/slices
import std/text

enum PuzzleError {
    BadNumber
    Unsolvable
}

struct Machine {
    lights: i64
    buttons: [][]i64
    targets: []i64
}

struct System {
    rows: [][]i64
    pivot_columns: []i64
    free_columns: []i64
    solvable: bool
}

fn number(s: str) -> i64 ! PuzzleError {
    text.parse_int(s) catch {
        _ => fail BadNumber
    }
}

fn parse_numbers(list: str) -> []i64 ! PuzzleError {
    var numbers: []i64 = []
    for piece in text.split(list, ',') {
        push(mut numbers, number(piece)?)
    }
    numbers
}

fn inner(token: str) -> str {
    token[1..token.len - 1]
}

fn parse_lights(pattern: str) -> i64 {
    var lights = 0
    for i in 0..pattern.len {
        if pattern[i] == '#' {
            lights |= 1 << i
        }
    }
    lights
}

fn parse_machine(line: str) -> Machine ! PuzzleError {
    let tokens = text.fields(line)
    var buttons: [][]i64 = []
    for token in tokens[1..tokens.len - 1] {
        push(mut buttons, parse_numbers(inner(token))?)
    }
    Machine {
        lights: parse_lights(inner(tokens[0])),
        buttons: buttons,
        targets: parse_numbers(inner(tokens[tokens.len - 1]))?,
    }
}

fn parse_machines(input: str) -> []Machine ! PuzzleError {
    var machines: []Machine = []
    let lines = text.lines(input)
        .map(fn(line) text.trim(line))
        .filter(fn(line) line.len > 0)
    for line in lines {
        push(mut machines, parse_machine(line)?)
    }
    machines
}

fn button_mask(button: []i64) -> i64 {
    button.fold(0, fn(mask, light) mask | (1 << light))
}

fn lights_after(masks: []i64, subset: i64) -> i64 {
    var lights = 0
    for i, mask in masks {
        if (subset >> i) & 1 == 1 {
            lights ^= mask
        }
    }
    lights
}

fn presses_in(subset: i64) -> i64 {
    var presses = 0
    var remaining = subset
    for remaining != 0 {
        presses += remaining & 1
        remaining >>= 1
    }
    presses
}

fn fewest_toggles(machine: Machine) -> i64 ! PuzzleError {
    let masks = slices.map(machine.buttons, button_mask)
    var best = -1
    for subset in 0..(1 << masks.len) {
        if lights_after(masks, subset) == machine.lights {
            let presses = presses_in(subset)
            if best < 0 || presses < best {
                best = presses
            }
        }
    }
    if best < 0 {
        fail Unsolvable
    }
    best
}

fn build_matrix(machine: Machine) -> [][]i64 {
    var rows: [][]i64 = []
    for counter, target in machine.targets {
        var row = machine.buttons.map(fn(button) if button.contains(counter) { 1 } else { 0 })
        push(mut row, target)
        push(mut rows, row)
    }
    rows
}

fn find_pivot_row(rows: [][]i64, from: i64, column: i64) -> i64? {
    for r in from..rows.len {
        if rows[r][column] != 0 {
            return r
        }
    }
    none
}

fn combine(row: []i64, pivot_row: []i64, column: i64) -> []i64 {
    let pivot_value = pivot_row[column]
    let factor = row[column]
    let combined = row
        .zip(pivot_row)
        .map(fn(pair) pair.first * pivot_value - pair.second * factor)
    let divisor = combined.fold(0, math.gcd)
    if divisor > 1 {
        combined.map(fn(value) value / divisor)
    } else {
        combined
    }
}

fn eliminate(mut rows: [][]i64, pivot: i64, column: i64) {
    for r in 0..rows.len {
        if r != pivot && rows[r][column] != 0 {
            rows[r] = combine(rows[r], rows[pivot], column)
        }
    }
}

fn is_consistent(rows: [][]i64, from: i64) -> bool {
    rows[from..].all(fn(row) row[row.len - 1] == 0)
}

fn reduce(machine: Machine) -> System {
    var rows = build_matrix(machine)
    var pivot_columns: []i64 = []
    var free_columns: []i64 = []
    var rank = 0
    for column in 0..machine.buttons.len {
        match find_pivot_row(rows, rank, column) {
            some(pivot_row) => {
                slices.swap(mut rows, rank, pivot_row)
                eliminate(mut rows, rank, column)
                push(mut pivot_columns, column)
                rank += 1
            }
            none => push(mut free_columns, column)
        }
    }
    System {
        rows: rows[..rank],
        pivot_columns: pivot_columns,
        free_columns: free_columns,
        solvable: is_consistent(rows, rank),
    }
}

fn press_limit(machine: Machine, button: i64) -> i64 {
    machine.buttons[button]
        .map(fn(counter) machine.targets[counter])
        .min() ?? 0
}

fn remainder_after_free(system: System, row: []i64, assignment: []i64) -> i64 {
    system.free_columns
        .zip(assignment)
        .fold(row[row.len - 1], fn(remainder, free) remainder - row[free.first] * free.second)
}

fn total_presses(system: System, assignment: []i64) -> i64 {
    var total = slices.sum(assignment)
    for r, row in system.rows {
        let remainder = remainder_after_free(system, row, assignment)
        let pivot_value = row[system.pivot_columns[r]]
        if remainder % pivot_value != 0 || remainder / pivot_value < 0 {
            return -1
        }
        total += remainder / pivot_value
    }
    total
}

fn can_be_completed(system: System, limits: []i64, assignment: []i64, assigned: i64) -> bool {
    for r, row in system.rows {
        var lowest = row[row.len - 1]
        var highest = lowest
        for k, column in system.free_columns {
            let coefficient = row[column]
            if k < assigned {
                lowest -= coefficient * assignment[k]
                highest -= coefficient * assignment[k]
            } else if coefficient > 0 {
                lowest -= coefficient * limits[k]
            } else {
                highest -= coefficient * limits[k]
            }
        }
        let pivot_value = row[system.pivot_columns[r]]
        if (pivot_value > 0 && highest < 0) || (pivot_value < 0 && lowest > 0) {
            return false
        }
    }
    true
}

fn search(system: System, limits: []i64, depth: i64, chosen: i64, mut assignment: []i64, mut best: i64) {
    if depth == system.free_columns.len {
        let total = total_presses(system, assignment)
        if total >= 0 && (best < 0 || total < best) {
            best = total
        }
        return
    }
    let limit = limits[depth]
    for value in 0..limit + 1 {
        if best >= 0 && chosen + value >= best {
            break
        }
        assignment[depth] = value
        if !can_be_completed(system, limits, assignment, depth + 1) {
            continue
        }
        search(system, limits, depth + 1, chosen + value, mut assignment, mut best)
    }
}

fn fewest_increments(machine: Machine) -> i64 ! PuzzleError {
    let system = reduce(machine)
    if !system.solvable {
        fail Unsolvable
    }
    let limits = system.free_columns.map(fn(column) press_limit(machine, column))
    var assignment = [0].repeat(system.free_columns.len)
    var best = -1
    search(system, limits, 0, 0, mut assignment, mut best)
    if best < 0 {
        fail Unsolvable
    }
    best
}

fn part1(input: str) -> i64 ! PuzzleError {
    var total = 0
    for machine in parse_machines(input)? {
        total += fewest_toggles(machine)?
    }
    total
}

fn part2(input: str) -> i64 ! PuzzleError {
    var total = 0
    for machine in parse_machines(input)? {
        total += fewest_increments(machine)?
    }
    total
}

fn main() ! PuzzleError {
    let input = embed("input/day10.txt")
    print("part 1: {part1(input)?}")
    print("part 2: {part2(input)?}")
}
