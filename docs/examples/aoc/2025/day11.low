import std/slices
import std/text

fn parse_devices(input: str) -> [str: []str] {
    var devices: [str: []str] = [:]
    for line in text.lines(input) {
        let parts = text.cut(text.trim(line), ":")
        if parts.found {
            devices[text.trim(parts.before)] = text.fields(parts.after)
        }
    }
    devices
}

fn paths_between(devices: [str: []str], memo: [str: i64], from: str, to: str) -> i64 {
    if from == to {
        return 1
    }
    let known = memo[from]
    if known != none {
        return known ?? 0
    }
    let total = (devices[from] ?? [])
        .map(fn(next) paths_between(devices, memo, next, to))
        .sum()
    memo[from] = total
    total
}

fn count_paths(devices: [str: []str], from: str, to: str) -> i64 {
    let memo: [str: i64] = [:]
    paths_between(devices, memo, from, to)
}

fn count_through(devices: [str: []str], first: str, second: str) -> i64 {
    count_paths(devices, "svr", first) * count_paths(devices, first, second) * count_paths(devices, second, "out")
}

fn part1(input: str) -> i64 {
    count_paths(parse_devices(input), "you", "out")
}

fn part2(input: str) -> i64 {
    let devices = parse_devices(input)
    count_through(devices, "dac", "fft") + count_through(devices, "fft", "dac")
}

fn main() {
    let input = embed("input/day11.txt")
    print("part 1: {part1(input)}")
    print("part 2: {part2(input)}")
}
