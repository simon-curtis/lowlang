import std/slices
import std/text

struct Range {
    first: i64
    last: i64
}

struct Inventory {
    ranges: []Range
    ids: []i64
}

fn parse_range(line: str) -> Range ! text.ParseError {
    let bounds = text.cut(line, "-")
    Range {
        first: text.parse_int(bounds.before)?,
        last: text.parse_int(bounds.after)?,
    }
}

fn parse_inventory(input: str) -> Inventory ! text.ParseError {
    var inventory = Inventory { ranges: [], ids: [] }
    var reading_ranges = true
    for line in text.lines(input) {
        let trimmed = text.trim(line)
        if trimmed.len == 0 {
            reading_ranges = false
        } else if reading_ranges {
            push(mut inventory.ranges, parse_range(trimmed)?)
        } else {
            push(mut inventory.ids, text.parse_int(trimmed)?)
        }
    }
    inventory
}

fn covers(range: Range, id: i64) -> bool {
    id >= range.first && id <= range.last
}

fn is_covered(ranges: []Range, id: i64) -> bool {
    ranges.any(fn(range) covers(range, id))
}

fn merge_ranges(ranges: []Range) -> []Range {
    var ordered = slices.clone(ranges)
    slices.sort_by(mut ordered, fn(a: Range, b: Range) -> bool { a.first < b.first })
    var merged: []Range = []
    for range in ordered {
        if merged.len > 0 && range.first <= merged[merged.len - 1].last + 1 {
            if range.last > merged[merged.len - 1].last {
                merged[merged.len - 1].last = range.last
            }
        } else {
            push(mut merged, range)
        }
    }
    merged
}

fn size(range: Range) -> i64 {
    range.last - range.first + 1
}

fn part1(input: str) -> i64 ! text.ParseError {
    let inventory = parse_inventory(input)?
    inventory.ids.count(fn(id) is_covered(inventory.ranges, id))
}

fn part2(input: str) -> i64 ! text.ParseError {
    let inventory = parse_inventory(input)?
    merge_ranges(inventory.ranges).map(size).sum()
}

fn main() ! text.ParseError {
    let input = embed("input/day05.txt")
    print("part 1: {part1(input)?}")
    print("part 2: {part2(input)?}")
}
