#!/usr/bin/env bash
set -euo pipefail

main=refs/remotes/$1/main
git rev-parse -q --verify "$main" >/dev/null || exit 0
changes=$(dirname "$0")/changes
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [[ $local_sha =~ ^0+$ ]] && continue
    base=$main
    if [ "$remote_ref" = refs/heads/main ] && [[ ! $remote_sha =~ ^0+$ ]] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
        base=$remote_sha
    fi
    "$changes" "$base" "$local_sha" || status=1
done
exit $status
