#!/usr/bin/env bash
set -euo pipefail

if [ $# -ne 2 ]; then
    echo "usage: .githooks/changes <base> <head>" >&2
    exit 2
fi

head=$(git rev-parse --verify "$2^{commit}")
base=$(git merge-base "$1" "$head")
range=$base..$head
changed=$(git diff --name-only "$range")
added=$(git diff --name-only --diff-filter=A "$range")
waived=$(git log --format='%(trailers:key=Waive,valueonly)' "$range")
status=0

report() {
    local rule=$1 message=$2 items=$3
    printf 'changes: %s: %s\n%s\n' "$rule" "$message" "$(sed 's/^/  /' <<<"$items")" >&2
    printf "  Add a 'Waive: %s' trailer to a commit message when the rule does not apply.\n" "$rule" >&2
    status=1
}

waived() {
    grep -qx "$1" <<<"$waived"
}

commits_touching() {
    local types=$1 paths=$2 sha subject type
    while read -r sha subject; do
        type=${subject%%[(:!]*}
        [[ $type =~ ^($types)$ ]] || continue
        if git diff-tree --no-commit-id --name-only -r "$sha" | grep -E "$paths" >/dev/null; then
            printf '%s %s\n' "${sha:0:8}" "$subject"
        fi
    done < <(git log --no-merges --format='%H %s' "$range")
}

check_fixture() {
    waived fixture && return
    grep -qE '^(testdata/|compiler/tests/)|_test\.low$' <<<"$changed" && return
    local hits
    hits=$(commits_touching 'feat|fix' '^compiler/(lexer|parser|check)/')
    [ -z "$hits" ] || report fixture "these commits change the front end, and no fixture or test changes with them" "$hits"
}

check_docs() {
    waived docs && return
    grep -qx 'docs/design.md' <<<"$changed" && return
    local hits
    hits=$(commits_touching 'feat' '^compiler/(lexer|parser)/|^compiler/check/builtins\.low$')
    [ -z "$hits" ] || report docs "these commits change the language, and docs/design.md does not change with them" "$hits"
}

new_std_modules() {
    local dir
    grep -E '^std/.+\.low$' <<<"$added" | grep -vE '_test\.low$|/examples/' | xargs -r -n1 dirname | sort -u |
        while read -r dir; do
            git ls-tree --name-only "$base" -- "$dir/" | grep '\.low$' >/dev/null || printf '%s\n' "$dir"
        done
}

check_std_modules() {
    waived std-module && return
    local dir missing="" design
    design=$(git show "$head:docs/design.md")
    while read -r dir; do
        [ -n "$dir" ] || continue
        git ls-tree -r --name-only "$head" -- "$dir/examples/" | grep '\.low$' >/dev/null || missing+="$dir has no examples/ program"$'\n'
        grep -qF "| \`$dir\` |" <<<"$design" || missing+="$dir has no row in the docs/design.md module table"$'\n'
    done < <(new_std_modules)
    [ -z "$missing" ] || report std-module "a new standard library module needs an example and a row in the module table" "${missing%$'\n'}"
}

check_example_readmes() {
    waived example-readme && return
    local file readme missing=""
    while read -r file; do
        [ -n "$file" ] || continue
        readme=$(dirname "$file")/README.md
        git show "$head:$readme" 2>/dev/null | grep -F "($(basename "$file"))" >/dev/null || missing+="$readme does not link $(basename "$file")"$'\n'
    done < <(grep -E '^docs/examples/.+\.low$' <<<"$added" || true)
    [ -z "$missing" ] || report example-readme "a new example needs a link in its folder's README.md" "${missing%$'\n'}"
}

check_fixture
check_docs
check_std_modules
check_example_readmes
exit $status
