struct Node {
    next: *Node?
    value: i64
}

struct Pair {
    a: i64
    b: i64
}

fn buffer(n: i64, seed: i64) -> str {
    var b: []u8 = []
    for i in 0..n {
        push(mut b, u8(97 + (i * 31 + seed) % 26))
    }
    str(b)
}

fn chain(n: i64) -> *Node? {
    var head: *Node? = none
    for i in 0..n {
        head = new(Node { next: head, value: i })
    }
    head
}

fn total(head: *Node?) -> i64 {
    var sum = 0
    var cur = head
    for {
        match cur {
            some(n) => {
                sum += n.value
                cur = n.next
            }
            none => break
        }
    }
    sum
}

fn views(source: str, count: i64) -> []str {
    var out: []str = []
    let span = source.len - 64
    for k in 0..count {
        let off = (k * 7919) % span
        push(mut out, source[off..off + 1 + k % 40])
    }
    out
}

fn weight(list: []str) -> i64 {
    var sum = 0
    for s in list {
        sum += s.len + i64(s[0])
    }
    sum
}

fn churn(rounds: i64) -> i64 {
    var sum = 0
    for i in 0..rounds {
        let p = new(Pair { a: i, b: 1 })
        sum += p.a + p.b
        if i % 64 == 0 {
            var scratch: []i64 = []
            for k in 0..48 {
                push(mut scratch, k + i)
            }
            sum += scratch[47]
        }
    }
    sum
}

fn main() {
    let first = buffer(32 * 1024 * 1024, 1)
    let second = buffer(32 * 1024 * 1024, 2)
    let a = views(first, 150000)
    let b = views(second, 150000)
    let list = chain(500000)

    var names: [str: i64] = [:]
    for i in 0..150000 {
        names["key-{i}"] = i
    }
    var numbers: [i64: i64] = [:]
    for i in 0..200000 {
        numbers[i * 3] = i
    }

    print(churn(120000000))

    var hits = 0
    for i in 0..150000 {
        hits += names["key-{i}"] ?? 0
    }
    print(first.len + second.len)
    print(weight(a) + weight(b))
    print(total(list))
    print(hits)
    print(numbers.len)
}
