fn escapes(cr: f64, ci: f64, limit: i64) -> bool {
    var zr = 0.0
    var zi = 0.0
    for i in 0..limit {
        let tr = zr * zr - zi * zi + cr
        zi = 2.0 * zr * zi + ci
        zr = tr
        if zr * zr + zi * zi > 4.0 {
            return true
        }
    }
    false
}

fn main() {
    let size = 2000
    let scale = 2.0 / f64(size)
    var inside = 0
    for y in 0..size {
        let ci = f64(y) * scale - 1.0
        for x in 0..size {
            let cr = f64(x) * scale - 1.5
            if !escapes(cr, ci, 50) {
                inside += 1
            }
        }
    }
    print(inside)
}
