fn main() {
    var counts: [str: i64] = [:]
    var length = 0
    for i in 0..1000000 {
        let word = "w{i % 5000}-{i % 7}"
        length += word.len
        counts[word] += 1
    }
    var points = 0
    var matches = 0
    for word, count in counts {
        for c in word {
            points += i64(c)
        }
        if word == "w42-0" {
            matches += count
        }
    }
    print(counts.len)
    print(length)
    print(points)
    print(matches)
}
