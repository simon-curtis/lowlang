fn apply_all(xs: []i64, f: fn(i64) -> i64) -> i64 {
    var total = 0
    for x in xs {
        total += f(x)
    }
    var low_bits = 0
    for x in xs {
        low_bits += f(x) & 1
    }
    total + low_bits
}

fn count_if(xs: []i64, keep: fn(i64) -> bool) -> i64 {
    var n = 0
    for x in xs {
        if keep(x) {
            n += 1
        }
    }
    var rest = 0
    for x in xs {
        if !keep(x) {
            rest += 2
        }
    }
    n + rest
}

fn main() {
    var xs: []i64 = []
    for i in 0..2000 {
        push(mut xs, i)
    }
    var total = 0
    var hits = 0
    for round in 0..5000 {
        total += apply_all(xs, fn(x: i64) -> i64 { x * 3 + 1 })
        total += apply_all(xs, fn(x: i64) -> i64 { (x ^ round) & 1023 })
        total += apply_all(xs, fn(x: i64) -> i64 { x >> 1 })
        hits += count_if(xs, fn(x: i64) -> bool { x % 7 == 0 })
        hits += count_if(xs, fn(x: i64) -> bool { x > round % 2000 })
    }
    print(total)
    print(hits)
}
