import std/json
import std/os
import std/text

fn document(records: i64) -> []u8 {
    var doc: []u8 = []
    text.append(mut doc, "[")
    for i in 0..records {
        if i > 0 {
            text.append(mut doc, ",")
        }
        let active = if i % 3 == 0 { "true" } else { "false" }
        text.append(mut doc, "{{\"id\":{i},\"name\":\"user-{i}\",\"email\":\"user{i}@example.org\",")
        text.append(mut doc, "\"score\":{i}.5,\"active\":{active},\"tags\":[\"alpha\",\"beta\",\"tag-{i % 97}\"],")
        text.append(mut doc, "\"address\":{{\"street\":\"{i} Main Street\",\"zip\":{10000 + i % 9000},\"geo\":[{i % 90}.25,-{i % 180}.75]}},")
        text.append(mut doc, "\"note\":null}}")
    }
    text.append(mut doc, "]")
    doc
}

fn visit(v: json.Value) -> i64 {
    match v {
        Null => 1
        Bool(value) => 1
        Int(value) => 1 + value
        Float(value) => 1 + i64(value)
        Str(value) => 1 + value.len
        Array(items) => {
            var total = 1
            for item in items {
                total += visit(item)
            }
            total
        }
        Object(members) => {
            var total = 1
            for m in members {
                total += m.name.len + visit(m.value)
            }
            total
        }
    }
}

fn decode(data: []u8, rounds: i64) -> i64 {
    var total = 0
    for r in 0..rounds {
        let v = json.parse(data) catch {
            _ => return -1
        }
        total += visit(v)
    }
    total
}

fn worker(data: []u8, rounds: i64, results: chan[i64]) {
    results <- decode(data, rounds)
}

fn workers() -> i64 {
    let args = os.args()
    if args.len > 1 {
        return text.parse_int(args[1]) catch {
            _ => 4
        }
    }
    4
}

fn main() {
    let rounds = 512
    let w = workers()
    let data = document(2000)
    let results = chan[i64]()
    for k in 0..w {
        spawn worker(data, rounds / w, results)
    }
    var sum = 0
    for k in 0..w {
        sum += (<-results) ?? 0
    }
    print(data.len)
    print(sum)
}
