import std/os
import std/text

struct Pair {
    a: i64
    b: i64
}

fn allocate(n: i64, seed: i64) -> i64 {
    var sum = 0
    var keep = new(Pair { a: seed, b: 0 })
    for i in 0..n {
        let p = new(Pair { a: i, b: seed })
        sum += p.a + p.b
        keep = p
    }
    sum + keep.a
}

fn worker(n: i64, seed: i64, results: chan[i64]) {
    results <- allocate(n, seed)
}

fn workers() -> i64 {
    let args = os.args()
    if args.len > 1 {
        return text.parse_int(args[1]) catch {
            _ => 4
        }
    }
    4
}

fn main() {
    let total = 100000000
    let w = workers()
    let results = chan[i64]()
    for k in 0..w {
        spawn worker(total / w, k, results)
    }
    var sum = 0
    for k in 0..w {
        sum += (<-results) ?? 0
    }
    print(sum)
}
