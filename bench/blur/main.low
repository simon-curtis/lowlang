import std/gpu
import std/os
import std/parallel
import std/slices
import std/time

const width = 3840
const height = 2160
const rounds = 5

fn tap(pixel: u32, weight: u32, shift: u32) -> u32 {
    (pixel >> shift & 0xFF) * weight
}

fn blend(far_before: u32, before: u32, centre: u32, after: u32, far_after: u32) -> u32 {
    var out: u32 = 0
    for channel in 0..4 {
        let shift = u32(channel) * 8
        let sum = tap(far_before, 1, shift) + tap(before, 4, shift) + tap(centre, 6, shift) + tap(after, 4, shift) + tap(far_after, 1, shift)
        out |= ((sum + 8) >> 4) << shift
    }
    out
}

fn clamped(at: i64, limit: u32) -> i64 {
    if at < 0 {
        return 0
    }
    if at >= i64(limit) {
        return i64(limit) - 1
    }
    at
}

kernel fn blur_rows(id: u32, w: u32, src: u32[], mut dst: u32[]) {
    let x = i64(id % w)
    let row = i64(id) - x
    dst[id] = blend(src[row + clamped(x - 2, w)], src[row + clamped(x - 1, w)], src[row + x], src[row + clamped(x + 1, w)], src[row + clamped(x + 2, w)])
}

kernel fn blur_columns(id: u32, w: u32, h: u32, src: u32[], mut dst: u32[]) {
    let x = i64(id % w)
    let y = i64(id / w)
    let stride = i64(w)
    dst[id] = blend(src[clamped(y - 2, h) * stride + x], src[clamped(y - 1, h) * stride + x], src[y * stride + x], src[clamped(y + 1, h) * stride + x], src[clamped(y + 2, h) * stride + x])
}

struct Timing {
    first: i64 = 0
    best: i64 = 0
    rounds: i64 = 0
}

fn record(mut timing: Timing, began: i64) {
    let took = time.monotonic() - began
    if timing.rounds == 0 {
        timing.first = took
    }
    if timing.rounds == 1 || timing.rounds > 1 && took < timing.best {
        timing.best = took
    }
    timing.rounds += 1
}

fn report(timing: Timing) -> str {
    "first {timing.first / 1000000} ms, then {timing.best / 1000000} ms"
}

fn image() -> u32[] {
    var pixels: u32[] = []
    var state: u32 = 12345
    for _ in 0..width * height {
        state = state * 1664525 + 1013904223
        pixels.push(state)
    }
    pixels
}

fn checksum(pixels: u32[]) -> u64 {
    var sum: u64 = 14695981039346656037
    for pixel in pixels {
        sum = (sum ^ u64(pixel)) * 1099511628211
    }
    sum
}

fn on_cpu(passes: launch[]) -> Timing {
    var timing = Timing {}
    for _ in 0..rounds {
        let began = time.monotonic()
        for pass in passes {
            gpu.run_on_cpu(pass)
        }
        timing.record(began)
    }
    timing
}

fn on_device(device: gpu.Device, passes: launch[]) -> Timing ! gpu.Error {
    var timing = Timing {}
    for _ in 0..rounds {
        let began = time.monotonic()
        for pass in passes {
            gpu.run(device, pass)?
        }
        timing.record(began)
    }
    timing
}

fn on_one(info: gpu.Info, passes: launch[]) -> Timing ! gpu.Error {
    using device = gpu.open_on(info.index)?
    on_device(device, passes)?
}

fn main() {
    let src = image()
    var middle = slices.repeat([u32(0)], src.len)
    var out = slices.repeat([u32(0)], src.len)
    let count = u32(src.len)
    let passes = [launch(blur_rows, count, u32(width), src, mut middle), launch(blur_columns, count, u32(width), u32(height), middle, mut out)]
    let cpu = on_cpu(passes)
    let wanted = checksum(out)
    print("{width}x{height}, checksum {wanted}")
    print("cpu, {parallel.cpus()} threads: {report(cpu)}")
    let found = gpu.devices() catch {
        failure => {
            print("no device: {gpu.describe(failure)}")
            return
        }
    }
    if found.len == 0 {
        print("no device")
    }
    for info in found {
        slices.fill(mut out, 0)
        let timing = on_one(info, passes) catch {
            failure => {
                print("{info.name}: {gpu.describe(failure)}")
                os.exit(1)
                return
            }
        }
        print("{info.name}: {report(timing)}")
        if checksum(out) != wanted {
            print("{info.name} and the CPU give different pixels")
            os.exit(1)
        }
    }
}
