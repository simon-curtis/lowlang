fn main() {
    let n = 1000000
    var m: [i64: i64] = [:]
    for i in 0..n {
        m[i * 7] = i
    }
    var hits = 0
    var sum = 0
    for k in 0..n * 2 {
        let v = m[k] ?? -1
        if v >= 0 {
            hits += 1
            sum += v
        }
    }
    for i in 0..n {
        if i % 2 == 0 {
            delete(mut m, i * 7)
        }
    }
    for i in 0..n / 2 {
        m[i * 7 + 1] = i
    }
    var total = 0
    for k, v in m {
        total += k + v
    }
    print(hits)
    print(sum)
    print(m.len)
    print(total)
}
