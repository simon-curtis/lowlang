fn echo(input: chan[i64], output: chan[i64]) {
    for v in input {
        output <- v + 1
    }
    close(output)
}

fn produce(jobs: chan[i64], n: i64) {
    for i in 0..n {
        jobs <- i
    }
    close(jobs)
}

fn work(jobs: chan[i64], results: chan[i64]) {
    var sum = 0
    for j in jobs {
        sum += j * 2
    }
    results <- sum
}

fn main() {
    let ping = chan[i64]()
    let pong = chan[i64]()
    spawn echo(ping, pong)
    var x = 0
    for i in 0..500000 {
        ping <- x
        x = (<-pong) ?? 0
    }
    close(ping)
    print(x)

    let workers = 4
    let jobs = chan[i64](128)
    let results = chan[i64]()
    spawn produce(jobs, 2000000)
    for w in 0..workers {
        spawn work(jobs, results)
    }
    var total = 0
    for w in 0..workers {
        total += (<-results) ?? 0
    }
    print(total)
}
