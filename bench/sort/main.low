fn quicksort[T](xs: []T, lo: i64, hi: i64, less: fn(T, T) -> bool) {
    if hi - lo < 2 {
        return
    }
    let pivot = xs[lo + (hi - lo) / 2]
    var i = lo
    var j = hi - 1
    for i <= j {
        for less(xs[i], pivot) {
            i += 1
        }
        for less(pivot, xs[j]) {
            j -= 1
        }
        if i <= j {
            let t = xs[i]
            xs[i] = xs[j]
            xs[j] = t
            i += 1
            j -= 1
        }
    }
    quicksort(xs, lo, j + 1, less)
    quicksort(xs, i, hi, less)
}

fn main() {
    let n = 3000000
    var xs: []i64 = []
    var seed = 42
    for i in 0..n {
        seed = (seed * 1103515245 + 12345) & 0x7fffffff
        push(mut xs, seed)
    }
    quicksort(xs, 0, xs.len, fn(a: i64, b: i64) -> bool { a < b })
    var unsorted = 0
    var checksum = 0
    for i in 0..n {
        if i > 0 && xs[i - 1] > xs[i] {
            unsorted += 1
        }
        if i % 1000 == 0 {
            checksum += xs[i]
        }
    }
    print(unsorted)
    print(checksum)
}
