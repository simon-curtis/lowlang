import std/os
import std/text

struct Pair {
    a: i64
    b: i64
}

fn allocate(n: i64) -> i64 {
    var sum = 0
    var keep = new(Pair { a: 0, b: 0 })
    for i in 0..n {
        let p = new(Pair { a: i, b: 1 })
        sum += p.a + p.b
        keep = p
    }
    sum + keep.a
}

fn control(n: i64) -> i64 {
    var sum = 0
    var keep = Pair { a: 0, b: 0 }
    for i in 0..n {
        let p = Pair { a: i, b: 1 }
        sum += p.a + p.b
        keep = p
    }
    sum + keep.a
}

fn main() {
    let n = 100000000
    let args = os.args()
    if args.len > 1 && args[1] == "control" {
        print(control(n))
    } else {
        print(allocate(n))
    }
}
