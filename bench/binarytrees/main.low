struct Tree {
    left: *Tree?
    right: *Tree?
}

fn make(depth: i64) -> *Tree {
    if depth == 0 {
        new(Tree { left: none, right: none })
    } else {
        new(Tree { left: make(depth - 1), right: make(depth - 1) })
    }
}

fn check(t: *Tree) -> i64 {
    let left = match t.left {
        some(l) => check(l)
        none => 0
    }
    let right = match t.right {
        some(r) => check(r)
        none => 0
    }
    1 + left + right
}

fn main() {
    let maxDepth = 18
    let stretch = maxDepth + 1
    print("stretch tree of depth {stretch}\t check: {check(make(stretch))}")
    let longLived = make(maxDepth)
    var depth = 4
    for depth <= maxDepth {
        let iterations = 1 << (maxDepth - depth + 4)
        var sum = 0
        for i in 0..iterations {
            sum += check(make(depth))
        }
        print("{iterations}\t trees of depth {depth}\t check: {sum}")
        depth += 2
    }
    print("long lived tree of depth {maxDepth}\t check: {check(longLived)}")
}
