struct Body {
    x: f64
    y: f64
    z: f64
    vx: f64
    vy: f64
    vz: f64
    mass: f64
}

fn system() -> []Body {
    let pi = 3.141592653589793
    let solar = 4.0 * pi * pi
    let days = 365.24
    var bodies: []Body = []
    push(mut bodies, Body { x: 0.0, y: 0.0, z: 0.0, vx: 0.0, vy: 0.0, vz: 0.0, mass: solar })
    push(mut bodies, Body {
        x: 4.84143144246472090e+00
        y: -1.16032004402742839e+00
        z: -1.03622044471123109e-01
        vx: 1.66007664274403694e-03 * days
        vy: 7.69901118419740425e-03 * days
        vz: -6.90460016972063023e-05 * days
        mass: 9.54791938424326609e-04 * solar
    })
    push(mut bodies, Body {
        x: 8.34336671824457987e+00
        y: 4.12479856412430479e+00
        z: -4.03523417114321381e-01
        vx: -2.76742510726862411e-03 * days
        vy: 4.99852801234917238e-03 * days
        vz: 2.30417297573763929e-05 * days
        mass: 2.85885980666130812e-04 * solar
    })
    push(mut bodies, Body {
        x: 1.28943695621391310e+01
        y: -1.51111514016986312e+01
        z: -2.23307578892655734e-01
        vx: 2.96460137564761618e-03 * days
        vy: 2.37847173959480950e-03 * days
        vz: -2.96589568540237556e-05 * days
        mass: 4.36624404335156298e-05 * solar
    })
    push(mut bodies, Body {
        x: 1.53796971148509165e+01
        y: -2.59193146099879641e+01
        z: 1.79258772950371181e-01
        vx: 2.68067772490389322e-03 * days
        vy: 1.62824170038242295e-03 * days
        vz: -9.51592254519715870e-05 * days
        mass: 5.15138902046611451e-05 * solar
    })
    var px = 0.0
    var py = 0.0
    var pz = 0.0
    for b in bodies {
        px += b.vx * b.mass
        py += b.vy * b.mass
        pz += b.vz * b.mass
    }
    bodies[0].vx = -px / solar
    bodies[0].vy = -py / solar
    bodies[0].vz = -pz / solar
    bodies
}

fn advance(bodies: []Body, dt: f64) {
    let n = bodies.len
    for i in 0..n {
        for j in i + 1..n {
            let dx = bodies[i].x - bodies[j].x
            let dy = bodies[i].y - bodies[j].y
            let dz = bodies[i].z - bodies[j].z
            let d2 = dx * dx + dy * dy + dz * dz
            let mag = dt / (d2 * sqrt(d2))
            let mi = bodies[i].mass * mag
            let mj = bodies[j].mass * mag
            bodies[i].vx -= dx * mj
            bodies[i].vy -= dy * mj
            bodies[i].vz -= dz * mj
            bodies[j].vx += dx * mi
            bodies[j].vy += dy * mi
            bodies[j].vz += dz * mi
        }
    }
    for i in 0..n {
        bodies[i].x += dt * bodies[i].vx
        bodies[i].y += dt * bodies[i].vy
        bodies[i].z += dt * bodies[i].vz
    }
}

fn energy(bodies: []Body) -> f64 {
    var e = 0.0
    let n = bodies.len
    for i in 0..n {
        let b = bodies[i]
        e += 0.5 * b.mass * (b.vx * b.vx + b.vy * b.vy + b.vz * b.vz)
        for j in i + 1..n {
            let o = bodies[j]
            let dx = b.x - o.x
            let dy = b.y - o.y
            let dz = b.z - o.z
            e -= b.mass * o.mass / sqrt(dx * dx + dy * dy + dz * dz)
        }
    }
    e
}

fn main() {
    let bodies = system()
    print(i64(floor(energy(bodies) * 1000000000.0)))
    for step in 0..5000000 {
        advance(bodies, 0.01)
    }
    print(i64(floor(energy(bodies) * 1000000000.0)))
}
