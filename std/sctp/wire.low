import std/io
import checksum = std/hash

const header_size = 12
const chunk_header = 4

const chunk_data = 0
const chunk_init = 1
const chunk_init_ack = 2
const chunk_sack = 3
const chunk_heartbeat = 4
const chunk_heartbeat_ack = 5
const chunk_abort = 6
const chunk_shutdown = 7
const chunk_shutdown_ack = 8
const chunk_cookie_echo = 10
const chunk_cookie_ack = 11
const chunk_shutdown_complete = 14
const chunk_reconfig = 130
const chunk_forward_tsn = 192

const flag_end = 1
const flag_begin = 2
const flag_unordered = 4
const flag_reflected = 1

const param_heartbeat_info = 1
const param_state_cookie = 7
const param_supported_extensions = 0x8008
const param_forward_tsn_supported = 0xC000

const param_outgoing_reset = 13
const param_reconfig_response = 16

const modulus = 4294967296

struct Chunk {
    kind: i64
    flags: i64
    body: u8[]
}

struct Packet {
    source: i64
    destination: i64
    tag: i64
    chunks: Chunk[]
}

struct Param {
    kind: i64
    value: u8[]
}

struct Init {
    tag: i64
    window: i64
    outbound: i64
    inbound: i64
    tsn: i64
    params: Param[]
}

struct Sack {
    cumulative: i64
    window: i64
    gaps: i64[]
    duplicates: i64[]
}

struct Fragment {
    tsn: i64
    stream: i64
    ssn: i64
    ppid: i64
    flags: i64
    payload: u8[]
}

struct Forward {
    tsn: i64
    streams: i64[]
}

fn pad4(n: i64) -> i64 {
    (n + 3) & ~3
}

fn pad_to(mut out: u8[], length: i64) {
    for {
        if !(out.len < length) {
            break
        }
        out.push(0)
    }
}

fn checksum_of(data: u8[]) -> i64 {
    let c = checksum.crc32c_new()
    checksum.crc32_update(c, data[..8])
    checksum.crc32_update(c, [0, 0, 0, 0])
    checksum.crc32_update(c, data[12..])
    i64(checksum.crc32_sum(c))
}

fn encode_packet(p: Packet) -> u8[] {
    var out: u8[] = []
    io.put_be16(mut out, p.source)
    io.put_be16(mut out, p.destination)
    io.put_be32(mut out, p.tag)
    io.put_be32(mut out, 0)
    for c in p.chunks {
        out.push(u8(c.kind))
        out.push(u8(c.flags))
        io.put_be16(mut out, chunk_header + c.body.len)
        io.append(mut out, c.body)
        pad_to(mut out, pad4(out.len))
    }
    let sum = checksum_of(out)
    out[8] = u8(sum)
    out[9] = u8(sum >> 8)
    out[10] = u8(sum >> 16)
    out[11] = u8(sum >> 24)
    out
}

fn parse_packet(data: u8[]) -> Packet ! io.Error {
    if data.len < header_size + chunk_header {
        fail Malformed
    }
    let stored = io.le32(data, 8)
    if stored != checksum_of(data) {
        fail Malformed
    }
    var chunks: Chunk[] = []
    var at = header_size
    for {
        if !(at < data.len) {
            break
        }
        if data.len - at < chunk_header {
            fail Malformed
        }
        let length = io.be16(data, at + 2)
        if length < chunk_header || at + length > data.len {
            fail Malformed
        }
        chunks.push(Chunk { kind: i64(data[at]), flags: i64(data[at + 1]), body: data[at + chunk_header..at + length] })
        at += pad4(length)
    }
    Packet { source: io.be16(data, 0), destination: io.be16(data, 2), tag: io.be32(data, 4), chunks }
}

fn encode_params(mut out: u8[], params: Param[]) {
    for p in params {
        io.put_be16(mut out, p.kind)
        io.put_be16(mut out, 4 + p.value.len)
        io.append(mut out, p.value)
        pad_to(mut out, pad4(out.len))
    }
}

fn parse_params(data: u8[]) -> Param[] ! io.Error {
    var params: Param[] = []
    var at = 0
    for {
        if !(at < data.len) {
            break
        }
        if data.len - at < 4 {
            fail Malformed
        }
        let length = io.be16(data, at + 2)
        if length < 4 || at + length > data.len {
            fail Malformed
        }
        params.push(Param { kind: io.be16(data, at), value: data[at + 4..at + length] })
        at += pad4(length)
    }
    params
}

fn find_param(params: Param[], kind: i64) -> u8[]? {
    for p in params {
        if p.kind == kind {
            return p.value
        }
    }
    none
}

fn encode_init(i: Init) -> u8[] {
    var out: u8[] = []
    io.put_be32(mut out, i.tag)
    io.put_be32(mut out, i.window)
    io.put_be16(mut out, i.outbound)
    io.put_be16(mut out, i.inbound)
    io.put_be32(mut out, i.tsn)
    encode_params(mut out, i.params)
    out
}

fn parse_init(body: u8[]) -> Init ! io.Error {
    if body.len < 16 {
        fail Malformed
    }
    Init {
        tag: io.be32(body, 0)
        window: io.be32(body, 4)
        outbound: io.be16(body, 8)
        inbound: io.be16(body, 10)
        tsn: io.be32(body, 12)
        params: parse_params(body[16..])?
    }
}

fn encode_data(f: Fragment) -> Chunk {
    var body: u8[] = []
    io.put_be32(mut body, f.tsn)
    io.put_be16(mut body, f.stream)
    io.put_be16(mut body, f.ssn)
    io.put_be32(mut body, f.ppid)
    io.append(mut body, f.payload)
    Chunk { kind: chunk_data, flags: f.flags, body }
}

fn parse_data(c: Chunk) -> Fragment ! io.Error {
    if c.body.len < 13 {
        fail Malformed
    }
    Fragment {
        tsn: io.be32(c.body, 0)
        stream: io.be16(c.body, 4)
        ssn: io.be16(c.body, 6)
        ppid: io.be32(c.body, 8)
        flags: c.flags
        payload: c.body[12..]
    }
}

fn encode_sack(s: Sack) -> Chunk {
    var body: u8[] = []
    io.put_be32(mut body, s.cumulative)
    io.put_be32(mut body, s.window)
    io.put_be16(mut body, s.gaps.len / 2)
    io.put_be16(mut body, s.duplicates.len)
    for g in s.gaps {
        io.put_be16(mut body, g)
    }
    for d in s.duplicates {
        io.put_be32(mut body, d)
    }
    Chunk { kind: chunk_sack, flags: 0, body }
}

fn parse_sack(c: Chunk) -> Sack ! io.Error {
    if c.body.len < 12 {
        fail Malformed
    }
    let gap_count = io.be16(c.body, 8)
    let duplicate_count = io.be16(c.body, 10)
    if c.body.len < 12 + gap_count * 4 + duplicate_count * 4 {
        fail Malformed
    }
    var gaps: i64[] = []
    for i in 0..gap_count * 2 {
        gaps.push(io.be16(c.body, 12 + i * 2))
    }
    var duplicates: i64[] = []
    for i in 0..duplicate_count {
        duplicates.push(io.be32(c.body, 12 + gap_count * 4 + i * 4))
    }
    Sack { cumulative: io.be32(c.body, 0), window: io.be32(c.body, 4), gaps, duplicates }
}

fn encode_forward(f: Forward) -> Chunk {
    var body: u8[] = []
    io.put_be32(mut body, f.tsn)
    for s in f.streams {
        io.put_be16(mut body, s >> 16)
        io.put_be16(mut body, s & 0xFFFF)
    }
    Chunk { kind: chunk_forward_tsn, flags: 0, body }
}

fn parse_forward(c: Chunk) -> Forward ! io.Error {
    if c.body.len < 4 || (c.body.len - 4) % 4 != 0 {
        fail Malformed
    }
    var streams: i64[] = []
    var at = 4
    for {
        if !(at < c.body.len) {
            break
        }
        streams.push(io.be16(c.body, at) << 16 | io.be16(c.body, at + 2))
        at += 4
    }
    Forward { tsn: io.be32(c.body, 0), streams }
}

fn wrap(n: i64) -> i64 {
    n & (modulus - 1)
}

fn unwrap(wire: i64, reference: i64) -> i64 {
    var delta = wrap(wire - reference)
    if delta >= modulus / 2 {
        delta -= modulus
    }
    reference + delta
}
