import std/io

const data_overhead = 16

fn weight(s: *Sent) -> i64 {
    s.payload.len + data_overhead
}

fn max_payload(a: *Assoc) -> i64 {
    (a.config.mtu - header_size - data_overhead) & ~3
}

fn outbound_of(a: *Assoc, id: i64) -> *Outbound {
    match a.outbound[id] {
        some(s) => return s
        none => {}
    }
    let s = new(Outbound { next_ssn: 0 })
    a.outbound[id] = s
    s
}

/// Queues `data` as one message on `stream` and sends what the windows allow.
///
/// `delivery` chooses ordered or unordered delivery and the limits of partial reliability, which apply only when the peer supports FORWARD-TSN. Fails with `NotConnected` unless the association is established, with `TooLarge` when `data` exceeds `Config.max_message_size` and with `Invalid` for an empty message or a stream the association does not have.
pub fn send(a: *Assoc, now: i64, stream: i64, ppid: i64, data: u8[], delivery: Delivery) ! io.Error {
    if a.stage != Stage.Established {
        fail NotConnected
    }
    if data.len == 0 || stream < 0 || stream >= a.config.streams {
        fail Invalid
    }
    if data.len > a.config.max_message_size {
        fail TooLarge
    }
    let reliable = !a.peer_forward
    let message = new(Outgoing {
        stream
        unordered: !delivery.ordered
        ssn: 0
        max_retransmits: if reliable { -1 } else { delivery.max_retransmits }
        expires: if reliable || delivery.lifetime < 0 { -1 } else { now + delivery.lifetime }
        abandoned: false
    })
    let size = max_payload(a)
    var at = 0
    for {
        let end = if data.len - at > size { at + size } else { data.len }
        var flags = 0
        if at == 0 {
            flags |= flag_begin
        }
        if end == data.len {
            flags |= flag_end
        }
        if !delivery.ordered {
            flags |= flag_unordered
        }
        a.queue.push(new(Sent {
            tsn: 0
            stream
            ssn: 0
            ppid
            flags
            payload: data[at..end]
            message
            sent_at: -1
            retransmits: 0
            acked: false
            abandoned: false
            retransmit: false
            in_flight: false
            misses: 0
        }))
        at = end
        if at >= data.len {
            break
        }
    }
    flush_output(a, now)
}

fn resetting(a: *Assoc, stream: i64) -> bool {
    let r = a.reset ?? return false
    for s in r.streams {
        if s == stream {
            return true
        }
    }
    false
}

fn number(a: *Assoc, s: *Sent) {
    if (s.flags & flag_unordered) != 0 {
        return
    }
    if (s.flags & flag_begin) != 0 {
        let o = outbound_of(a, s.stream)
        s.message.ssn = o.next_ssn
        o.next_ssn = (o.next_ssn + 1) & 0xFFFF
    }
    s.ssn = s.message.ssn
}

fn can_send(a: *Assoc, size: i64) -> bool {
    a.flight == 0 || (a.flight + size <= a.cwnd && size <= a.rwnd)
}

fn transmit(a: *Assoc, s: *Sent, now: i64) {
    if s.sent_at < 0 {
        s.sent_at = now
    } else {
        s.retransmits += 1
    }
    add_chunk(a, encode_data(Fragment { tsn: wrap(s.tsn), stream: s.stream, ssn: s.ssn, ppid: s.ppid, flags: s.flags, payload: s.payload }))
    s.in_flight = true
    s.retransmit = false
    a.flight += weight(s)
    a.rwnd = if a.rwnd > weight(s) { a.rwnd - weight(s) } else { 0 }
    if a.rtx_at < 0 {
        a.rtx_at = now + a.rto
    }
}

fn abandon(a: *Assoc, m: *Outgoing) {
    m.abandoned = true
    for s in a.outstanding {
        if s.message == m && !s.acked && !s.abandoned {
            s.abandoned = true
            s.retransmit = false
            if s.in_flight {
                s.in_flight = false
                a.flight -= weight(s)
            }
        }
    }
    check_forward(a)
}

fn check_forward(a: *Assoc) {
    var point = a.acked_cum
    var any = false
    for s in a.outstanding {
        if s.abandoned {
            point = s.tsn
            any = true
        } else if s.acked {
            point = s.tsn
        } else {
            break
        }
    }
    if any && point > a.advanced {
        a.advanced = point
        a.forward_due = true
    }
}

fn send_forward(a: *Assoc, now: i64) {
    let latest: [i64: i64] = [:]
    for s in a.outstanding {
        if s.tsn > a.advanced {
            break
        }
        if s.abandoned && (s.flags & flag_unordered) == 0 {
            latest[s.stream] = s.ssn
        }
    }
    var streams: i64[] = []
    for stream, ssn in latest {
        streams.push(stream << 16 | ssn)
    }
    add_chunk(a, encode_forward(Forward { tsn: wrap(a.advanced), streams }))
    a.forward_due = false
    if a.rtx_at < 0 {
        a.rtx_at = now + a.rto
    }
}

fn send_pending(a: *Assoc, now: i64) {
    if a.sack_due {
        send_sack(a)
    }
    if a.forward_due {
        send_forward(a, now)
    }
    for s in a.outstanding {
        if s.retransmit && !s.acked && !s.abandoned {
            if !can_send(a, weight(s)) {
                break
            }
            transmit(a, s, now)
        }
    }
    for {
        if a.queue.len == 0 {
            break
        }
        let s = a.queue[0]
        if s.message.expires >= 0 && now > s.message.expires && !s.message.abandoned {
            abandon(a, s.message)
        }
        if s.message.abandoned {
            a.queue = a.queue[1..]
            continue
        }
        if resetting(a, s.stream) || !can_send(a, weight(s)) {
            break
        }
        a.queue = a.queue[1..]
        number(a, s)
        s.tsn = a.next_tsn
        a.next_tsn += 1
        a.outstanding.push(s)
        transmit(a, s, now)
    }
    try_send_reset(a, now)
}

fn mark_retransmit(a: *Assoc, s: *Sent) {
    if s.acked || s.abandoned {
        return
    }
    if s.in_flight {
        s.in_flight = false
        a.flight -= weight(s)
    }
    let m = s.message
    if m.max_retransmits >= 0 && s.retransmits >= m.max_retransmits {
        abandon(a, m)
    } else {
        s.retransmit = true
    }
}

fn expire_messages(a: *Assoc, now: i64) {
    for s in a.outstanding {
        let m = s.message
        if !s.acked && !s.abandoned && m.expires >= 0 && now > m.expires {
            abandon(a, m)
        }
    }
}

fn has_unacked(a: *Assoc) -> bool {
    for s in a.outstanding {
        if !s.acked && !s.abandoned {
            return true
        }
    }
    false
}

fn tick_retransmission(a: *Assoc, now: i64) {
    if a.rtx_at < 0 || now < a.rtx_at {
        return
    }
    if !has_unacked(a) && a.advanced <= a.acked_cum {
        a.rtx_at = -1
        return
    }
    a.errors += 1
    if a.errors > a.config.max_retransmissions {
        fail_with(a, "the peer stopped acknowledging data")
        return
    }
    let half = a.cwnd / 2
    a.ssthresh = if half > 4 * a.config.mtu { half } else { 4 * a.config.mtu }
    a.cwnd = a.config.mtu
    a.partial_acked = 0
    a.recovery = a.next_tsn - 1
    backoff(a)
    for s in a.outstanding {
        mark_retransmit(a, s)
    }
    if a.advanced > a.acked_cum {
        a.forward_due = true
    }
    a.rtx_at = now + a.rto
}

fn update_rtt(a: *Assoc, sample: i64) {
    if a.srtt == 0 {
        a.srtt = sample
        a.rttvar = sample / 2
    } else {
        let delta = if a.srtt > sample { a.srtt - sample } else { sample - a.srtt }
        a.rttvar = (3 * a.rttvar + delta) / 4
        a.srtt = (7 * a.srtt + sample) / 8
    }
    var rto = a.srtt + 4 * a.rttvar
    if rto < a.config.rto_min {
        rto = a.config.rto_min
    }
    if rto > a.config.rto_max {
        rto = a.config.rto_max
    }
    a.rto = rto
}

fn on_sack(a: *Assoc, c: Chunk, now: i64) {
    let sack = parse_sack(c) or return
    acknowledge(a, sack, now)
}

fn acknowledge(a: *Assoc, sack: Sack, now: i64) {
    let cum = unwrap(sack.cumulative, a.acked_cum)
    if cum < a.acked_cum || cum >= a.next_tsn {
        return
    }
    let flight_before = a.flight
    let advanced = cum > a.acked_cum
    var newly_cumulative = 0
    var newly_highest = a.acked_cum
    var sample = -1
    for {
        if a.outstanding.len == 0 || a.outstanding[0].tsn > cum {
            break
        }
        let s = a.outstanding[0]
        a.outstanding = a.outstanding[1..]
        if s.in_flight {
            a.flight -= weight(s)
            newly_cumulative += weight(s)
            s.in_flight = false
        }
        if !s.acked && !s.abandoned && s.retransmits == 0 && s.sent_at >= 0 {
            sample = now - s.sent_at
        }
        s.acked = true
        newly_highest = s.tsn
    }
    var block = 0
    for s in a.outstanding {
        for {
            if block >= sack.gaps.len || s.tsn <= cum + sack.gaps[block + 1] {
                break
            }
            block += 2
        }
        if block < sack.gaps.len && s.tsn >= cum + sack.gaps[block] && !s.acked {
            s.acked = true
            s.retransmit = false
            if s.in_flight {
                s.in_flight = false
                a.flight -= weight(s)
            }
            if !s.abandoned && s.retransmits == 0 && s.sent_at >= 0 {
                sample = now - s.sent_at
            }
            if s.tsn > newly_highest {
                newly_highest = s.tsn
            }
        }
    }
    a.acked_cum = cum
    if sample >= 0 {
        update_rtt(a, sample)
    }
    var cut = false
    for s in a.outstanding {
        if s.tsn < newly_highest && !s.acked && !s.abandoned {
            s.misses += 1
            if s.misses == 3 {
                mark_retransmit(a, s)
                cut = true
            }
        }
    }
    if cut && cum >= a.recovery {
        let half = a.cwnd / 2
        a.ssthresh = if half > 4 * a.config.mtu { half } else { 4 * a.config.mtu }
        a.cwnd = a.ssthresh
        a.partial_acked = 0
        a.recovery = a.next_tsn - 1
    }
    if advanced && !cut && cum >= a.recovery && newly_cumulative > 0 && flight_before + a.config.mtu > a.cwnd {
        if a.cwnd <= a.ssthresh {
            a.cwnd += if newly_cumulative < a.config.mtu { newly_cumulative } else { a.config.mtu }
        } else {
            a.partial_acked += newly_cumulative
            if a.partial_acked >= a.cwnd {
                a.partial_acked -= a.cwnd
                a.cwnd += a.config.mtu
            }
        }
    }
    a.rwnd = if sack.window > a.flight { sack.window - a.flight } else { 0 }
    if advanced || newly_highest > cum {
        a.errors = 0
    }
    check_forward(a)
    if !has_unacked(a) && a.advanced <= a.acked_cum {
        a.rtx_at = -1
    } else if advanced {
        a.rtx_at = now + a.rto
    }
}
