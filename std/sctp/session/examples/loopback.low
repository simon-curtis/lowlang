import std/sctp
import std/sctp/session

fn main() {
    let to_client = chan[u8[]](64)
    let to_server = chan[u8[]](64)
    using client = session.open(sctp.Config { client: true }, session.Transport { send: fn(p) { to_server <- p }, incoming: to_client })
    using server = session.open(sctp.Config { client: false }, session.Transport { send: fn(p) { to_client <- p }, incoming: to_server })
    session.wait_connected(client.handle) or return
    session.wait_connected(server.handle) or return
    print("connected")
    session.send(client.handle, 1, 51, bytes("ping"), sctp.Delivery {}) or return
    let message = session.receive(server.handle) or return
    print("server received {str(message.data)} on stream {message.stream}")
    session.send(server.handle, 1, 53, bytes("pong"), sctp.Delivery { ordered: false }) or return
    let reply = session.receive(client.handle) or return
    print("client received {str(reply.data)} with ppid {reply.ppid}")
    session.close_session(client.handle)
}
