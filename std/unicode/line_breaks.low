const line_none = -1
const dotted_circle: u32 = 0x25CC

/// A position in a string where a line may end.
pub struct LineBreak {
    /// The byte index of the position: the line ends before the character that starts there, or at the end of the string.
    pub at: i64
    /// Whether the line must end here, after a hard line break or at the end of the text, and not only may.
    pub mandatory: bool
}

enum Opportunity {
    Prohibited
    Allowed
    Mandatory
}

struct Glyph {
    class: i64
    wide: bool
    extended: bool
    initial: bool
    final: bool
    dotted: bool
}

struct Line {
    raw: i64
    last: Glyph
    before: i64
    before_plain: bool
    aksara: bool
    before_aksara: bool
    anchor: i64
    anchor_initial: bool
    number: i64
    regional: i64
}

struct Ahead {
    class: i64
    wide: bool
    after: i64
}

fn line_glyph(c: u32) -> Glyph {
    let p = line_props(c)
    let class = i64(p & line_class_mask)
    Glyph {
        class
        wide: p >> line_wide_shift & 1 == 1
        extended: p >> line_extended_shift & 1 == 1
        initial: p >> line_initial_shift & 1 == 1
        final: p >> line_final_shift & 1 == 1
        dotted: c == dotted_circle
    }
}

fn line_plain_letter() -> Glyph {
    Glyph { class: line_al, wide: false, extended: false, initial: false, final: false, dotted: false }
}

fn line_nothing() -> Glyph {
    Glyph { class: line_none, wide: false, extended: false, initial: false, final: false, dotted: false }
}

fn is_line_hard(class: i64) -> bool {
    class == line_bk || class == line_cr || class == line_lf || class == line_nl
}

fn is_line_mark(class: i64) -> bool {
    class == line_cm || class == line_zwj
}

fn line_takes_marks(class: i64) -> bool {
    class != line_none && !is_line_hard(class) && class != line_sp && class != line_zw
}

fn is_line_alphabetic(class: i64) -> bool {
    class == line_al || class == line_hl
}

fn is_line_hangul(class: i64) -> bool {
    class == line_jl || class == line_jv || class == line_jt || class == line_h2 || class == line_h3
}

fn is_line_hyphen(class: i64) -> bool {
    class == line_hy || class == line_hh
}

fn is_line_prefix_or_postfix(class: i64) -> bool {
    class == line_pr || class == line_po
}

fn is_line_pictograph_class(class: i64) -> bool {
    class == line_id || class == line_eb || class == line_em
}

fn is_line_aksara_start(class: i64) -> bool {
    class == line_ak || class == line_as
}

fn is_line_quote_context(class: i64) -> bool {
    match class {
        line_none => true
        line_bk => true
        line_cr => true
        line_lf => true
        line_nl => true
        line_op => true
        line_qu => true
        line_gl => true
        line_sp => true
        line_zw => true
        _ => false
    }
}

fn is_line_hyphen_context(class: i64) -> bool {
    match class {
        line_none => true
        line_bk => true
        line_cr => true
        line_lf => true
        line_nl => true
        line_sp => true
        line_zw => true
        line_cb => true
        line_gl => true
        _ => false
    }
}

fn line_ends_final_quote(class: i64) -> bool {
    match class {
        line_none => true
        line_sp => true
        line_gl => true
        line_wj => true
        line_cl => true
        line_qu => true
        line_cp => true
        line_ex => true
        line_is => true
        line_sy => true
        line_bk => true
        line_cr => true
        line_lf => true
        line_nl => true
        line_zw => true
        _ => false
    }
}

fn line_look_ahead(s: str, from: i64) -> Ahead {
    var at = from
    for at < s.len {
        let r = decode_rune(s, at)
        let g = line_glyph(r.code)
        at += r.size
        if !is_line_mark(g.class) {
            return Ahead { class: g.class, wide: g.wide, after: at }
        }
    }
    Ahead { class: line_none, wide: false, after: s.len }
}

fn line_absorbs(st: Line, class: i64) -> bool {
    is_line_mark(class) && line_takes_marks(st.last.class)
}

fn line_numeric_before_break(st: Line, n: i64) -> bool {
    let x = st.last.class
    if n == line_po || n == line_pr {
        if st.number == 1 || st.number == 2 {
            return true
        }
    }
    if n == line_nu && (x == line_po || x == line_pr || x == line_hy || x == line_is || st.number == 1) {
        return true
    }
    false
}

fn line_opening_number(st: Line, s: str, after: i64, n: i64) -> bool {
    let x = st.last.class
    if n != line_op || !is_line_prefix_or_postfix(x) {
        return false
    }
    let first = line_look_ahead(s, after)
    if first.class == line_nu {
        return true
    }
    first.class == line_is && line_look_ahead(s, first.after).class == line_nu
}

fn line_korean_joins(x: i64, n: i64) -> bool {
    if x == line_jl {
        return n == line_jl || n == line_jv || n == line_h2 || n == line_h3
    }
    if x == line_jv || x == line_h2 {
        return n == line_jv || n == line_jt
    }
    (x == line_jt || x == line_h3) && n == line_jt
}

fn line_aksara_joins(st: Line, s: str, after: i64, g: Glyph) -> bool {
    let x = st.last.class
    let n = g.class
    let next_aksara = is_line_aksara_start(n) || g.dotted
    if x == line_ap && next_aksara {
        return true
    }
    if st.aksara && (n == line_vf || n == line_vi) {
        return true
    }
    if x == line_vi && st.before_aksara && (n == line_ak || g.dotted) {
        return true
    }
    st.aksara && next_aksara && line_look_ahead(s, after).class == line_vf
}

fn line_quote_joins(st: Line, s: str, after: i64, g: Glyph) -> bool {
    let x = st.last
    let n = g.class
    if n == line_qu && !g.initial {
        return true
    }
    if x.class == line_qu && !x.final {
        return true
    }
    if n == line_qu && !x.wide {
        return true
    }
    if n == line_qu {
        let ahead = line_look_ahead(s, after)
        if ahead.class == line_none || !ahead.wide {
            return true
        }
    }
    x.class == line_qu && (!g.wide || st.before_plain)
}

fn line_hyphen_joins(st: Line, n: i64) -> bool {
    let x = st.last.class
    if !is_line_hyphen(x) {
        return false
    }
    if is_line_hyphen_context(st.before) && is_line_alphabetic(n) {
        return true
    }
    st.before == line_hl && n != line_hl
}

fn is_line_prohibited(st: Line, s: str, after: i64, g: Glyph) -> bool {
    let x = st.last.class
    let n = g.class
    if n == line_wj || x == line_wj || x == line_gl {
        return true
    }
    if n == line_gl && x != line_sp && x != line_ba && x != line_hy && x != line_hh {
        return true
    }
    if n == line_cl || n == line_cp || n == line_ex || n == line_sy {
        return true
    }
    if st.anchor == line_op || st.anchor_initial {
        return true
    }
    if g.final && n == line_qu && line_ends_final_quote(line_look_ahead(s, after).class) {
        return true
    }
    if x == line_sp && n == line_is && line_look_ahead(s, after).class == line_nu {
        return false
    }
    if n == line_is {
        return true
    }
    if (st.anchor == line_cl || st.anchor == line_cp) && n == line_ns {
        return true
    }
    if st.anchor == line_b2 && n == line_b2 {
        return true
    }
    if x == line_sp {
        return false
    }
    if line_quote_joins(st, s, after, g) {
        return true
    }
    if n == line_cb || x == line_cb {
        return false
    }
    if line_hyphen_joins(st, n) {
        return true
    }
    if n == line_ba || n == line_hh || n == line_hy || n == line_ns || x == line_bb {
        return true
    }
    if (x == line_sy && n == line_hl) || n == line_in {
        return true
    }
    if (is_line_alphabetic(x) && n == line_nu) || (x == line_nu && is_line_alphabetic(n)) {
        return true
    }
    if (x == line_pr && is_line_pictograph_class(n)) || (is_line_pictograph_class(x) && n == line_po) {
        return true
    }
    if (is_line_prefix_or_postfix(x) && is_line_alphabetic(n)) || (is_line_alphabetic(x) && is_line_prefix_or_postfix(n)) {
        return true
    }
    if line_numeric_before_break(st, n) || line_opening_number(st, s, after, n) {
        return true
    }
    if line_korean_joins(x, n) || (is_line_hangul(x) && n == line_po) || (x == line_pr && is_line_hangul(n)) {
        return true
    }
    if is_line_alphabetic(x) && is_line_alphabetic(n) {
        return true
    }
    if line_aksara_joins(st, s, after, g) {
        return true
    }
    if x == line_is && is_line_alphabetic(n) {
        return true
    }
    if (is_line_alphabetic(x) || x == line_nu) && n == line_op && !g.wide {
        return true
    }
    if x == line_cp && !st.last.wide && (is_line_alphabetic(n) || n == line_nu) {
        return true
    }
    if x == line_ri && n == line_ri && st.regional % 2 == 1 {
        return true
    }
    n == line_em && (x == line_eb || st.last.extended)
}

fn line_opportunity(st: Line, s: str, after: i64, raw: Glyph) -> Opportunity {
    let prev = st.raw
    if prev == line_bk || prev == line_lf || prev == line_nl {
        return Opportunity.Mandatory
    }
    if prev == line_cr {
        return if raw.class == line_lf { Opportunity.Prohibited } else { Opportunity.Mandatory }
    }
    if is_line_hard(raw.class) || raw.class == line_sp || raw.class == line_zw {
        return Opportunity.Prohibited
    }
    if st.anchor == line_zw {
        return Opportunity.Allowed
    }
    if prev == line_zwj || line_absorbs(st, raw.class) {
        return Opportunity.Prohibited
    }
    let g = if is_line_mark(raw.class) { line_plain_letter() } else { raw }
    if is_line_prohibited(st, s, after, g) {
        return Opportunity.Prohibited
    }
    Opportunity.Allowed
}

fn line_number_state(st: Line, class: i64) -> i64 {
    if class == line_nu {
        return 1
    }
    if st.number == 1 && (class == line_sy || class == line_is) {
        return 1
    }
    if st.number == 1 && (class == line_cl || class == line_cp) {
        return 2
    }
    0
}

fn line_advance(mut st: Line, raw: Glyph) {
    st.raw = raw.class
    if line_absorbs(st, raw.class) {
        return
    }
    let g = if is_line_mark(raw.class) { line_plain_letter() } else { raw }
    let previous = st.last
    st.before = previous.class
    st.before_plain = previous.class == line_none || !previous.wide
    st.before_aksara = st.aksara
    st.aksara = is_line_aksara_start(g.class) || g.dotted
    if g.class != line_sp {
        st.anchor = g.class
        st.anchor_initial = g.initial && is_line_quote_context(previous.class)
    }
    st.number = line_number_state(st, g.class)
    st.regional = if g.class == line_ri { st.regional + 1 } else { 0 }
    st.last = g
}

fn line_state() -> Line {
    Line {
        raw: line_none
        last: line_nothing()
        before: line_none
        before_plain: true
        aksara: false
        before_aksara: false
        anchor: line_none
        anchor_initial: false
        number: 0
        regional: 0
    }
}

/// Returns the positions in `s` where a line may end, in increasing order, following the default rules of Unicode Standard Annex 14.
/// A position is mandatory after a hard line break (line feed, carriage return not followed by a line feed, vertical tab, form feed, next line, line separator and paragraph separator) and at the end of the text, and is otherwise an opportunity that a line wrapper may take or leave. The start of the text is not a position, and the result is empty for an empty string.
pub fn line_breaks(s: str) -> []LineBreak {
    var out: []LineBreak = []
    var st = line_state()
    var i = 0
    for i < s.len {
        let r = decode_rune(s, i)
        let raw = line_glyph(r.code)
        if i > 0 {
            let found = line_opportunity(st, s, i + r.size, raw)
            match found {
                Mandatory => push(mut out, LineBreak { at: i, mandatory: true })
                Allowed => push(mut out, LineBreak { at: i, mandatory: false })
                Prohibited => {}
            }
        }
        line_advance(mut st, raw)
        i += r.size
    }
    if s.len > 0 {
        push(mut out, LineBreak { at: s.len, mandatory: true })
    }
    out
}

/// Returns the pieces of `s` between the positions of `line_breaks`, each ending where a line may end.
/// A piece keeps its trailing spaces and line break. The pieces are slices of `s` and joining them gives `s` back.
pub fn line_segments(s: str) -> []str {
    var out: []str = []
    var at = 0
    for b in line_breaks(s) {
        push(mut out, s[at..b.at])
        at = b.at
    }
    out
}
