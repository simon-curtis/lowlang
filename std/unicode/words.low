const word_start = -1

struct Word {
    raw: i64
    last: i64
    before: i64
    regional: i64
}

fn word_class(p: u32) -> i64 {
    i64(p & word_class_mask)
}

fn word_pictographic(p: u32) -> bool {
    p >> word_pictographic_shift & 1 == 1
}

fn is_word_newline(class: i64) -> bool {
    class == word_cr || class == word_lf || class == word_newline
}

fn is_word_ignored(class: i64) -> bool {
    class == word_extend || class == word_format || class == word_zwj
}

fn is_letter_class(class: i64) -> bool {
    class == word_aletter || class == word_hebrew_letter
}

fn is_mid_letter(class: i64) -> bool {
    class == word_midletter || class == word_midnumlet || class == word_single_quote
}

fn is_mid_number(class: i64) -> bool {
    class == word_midnum || class == word_midnumlet || class == word_single_quote
}

fn next_word_class(s: str, from: i64) -> i64 {
    var at = from
    for at < s.len {
        let r = decode_rune(s, at)
        let class = word_class(word_props(r.code))
        if !is_word_ignored(class) {
            return class
        }
        at += r.size
    }
    word_start
}

fn word_joins(st: Word, s: str, after: i64, p: u32) -> bool {
    let next = word_class(p)
    let raw = st.raw
    if raw == word_cr && next == word_lf {
        return true
    }
    if is_word_newline(raw) || is_word_newline(next) {
        return false
    }
    if raw == word_zwj && word_pictographic(p) {
        return true
    }
    if raw == word_wsegspace && next == word_wsegspace {
        return true
    }
    if is_word_ignored(next) {
        return true
    }
    let last = st.last
    if is_letter_class(last) {
        if is_letter_class(next) || next == word_numeric || next == word_extendnumlet {
            return true
        }
        if is_mid_letter(next) && is_letter_class(next_word_class(s, after)) {
            return true
        }
    }
    if is_mid_letter(last) && is_letter_class(st.before) && is_letter_class(next) {
        return true
    }
    if last == word_hebrew_letter {
        if next == word_single_quote {
            return true
        }
        if next == word_double_quote && next_word_class(s, after) == word_hebrew_letter {
            return true
        }
    }
    if last == word_double_quote && st.before == word_hebrew_letter && next == word_hebrew_letter {
        return true
    }
    if last == word_numeric {
        if next == word_numeric || is_letter_class(next) || next == word_extendnumlet {
            return true
        }
        if is_mid_number(next) && next_word_class(s, after) == word_numeric {
            return true
        }
    }
    if is_mid_number(last) && st.before == word_numeric && next == word_numeric {
        return true
    }
    if last == word_katakana && (next == word_katakana || next == word_extendnumlet) {
        return true
    }
    if last == word_extendnumlet && (is_letter_class(next) || next == word_numeric || next == word_katakana || next == word_extendnumlet) {
        return true
    }
    last == word_regional_indicator && next == word_regional_indicator && st.regional % 2 == 1
}

fn word_advance(mut st: Word, class: i64) {
    st.raw = class
    let absorbed = is_word_ignored(class) && st.last != word_start && !is_word_newline(st.last)
    if absorbed {
        return
    }
    st.before = st.last
    st.last = class
    st.regional = if class == word_regional_indicator { st.regional + 1 } else { 0 }
}

/// Returns the byte index where the word segment that starts at `at` in `s` ends.
/// Segments follow Unicode Standard Annex 29: runs of letters, digits and the punctuation that joins them, Katakana runs, horizontal whitespace runs, regional-indicator pairs and emoji zero-width-joiner sequences stay together, and every other character is a segment of its own. `at` must be the start of a segment. The last segment ends at `s.len`.
pub fn word_end(s: str, at: i64) -> i64 {
    var st = Word { raw: word_start, last: word_start, before: word_start, regional: 0 }
    var i = at
    for i < s.len {
        let r = decode_rune(s, i)
        let p = word_props(r.code)
        if i > at && !word_joins(st, s, i + r.size, p) {
            return i
        }
        word_advance(mut st, word_class(p))
        i += r.size
    }
    s.len
}

/// Returns the word segments of `s` as substrings.
/// Spaces and punctuation are segments too. The pieces are slices of `s` and joining them gives `s` back.
pub fn words(s: str) -> str[] {
    var out: str[] = []
    var at = 0
    for at < s.len {
        let end = word_end(s, at)
        out.push(s[at..end])
        at = end
    }
    out
}

/// Returns the number of word segments in `s`.
pub fn word_count(s: str) -> i64 {
    var count = 0
    var at = 0
    for at < s.len {
        at = word_end(s, at)
        count += 1
    }
    count
}
