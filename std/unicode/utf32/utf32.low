import std/io
import std/text
import std/unicode

/// Why a UTF-32 conversion failed.
pub enum Error {
    /// A value is not a Unicode scalar value: it is a surrogate or above `0x10FFFF`. `at` is its index in the code point slice, not a byte offset.
    InvalidCodePoint(at: i64)
    /// The byte input is not a multiple of 4 bytes long.
    BadLength
}

/// Returns the code points of `s` as a slice of `u32`.
/// Each byte of `s` that is not valid UTF-8 becomes `0xFFFD`.
pub fn encode(s: str) -> []u32 {
    var out: []u32 = []
    for c in s {
        push(mut out, c)
    }
    out
}

/// Decodes code points into a string, replacing each invalid value with U+FFFD.
pub fn decode_lossy(cs: []u32) -> str {
    var out: []u8 = []
    for c in cs {
        let point = if text.is_scalar(c) { c } else { 0xFFFD }
        text.append_char(mut out, point)
    }
    __str_view(out)
}

/// Decodes code points into a string.
/// Fails with `InvalidCodePoint` at the index of the first surrogate or value above `0x10FFFF`.
pub fn decode(cs: []u32) -> str ! Error {
    var out: []u8 = []
    for i, c in cs {
        if !text.is_scalar(c) {
            fail InvalidCodePoint(i)
        }
        text.append_char(mut out, c)
    }
    __str_view(out)
}

fn word_at(data: []u8, at: i64, order: unicode.Order) -> u32 {
    match order {
        Little => io.u32_le(data, at)
        Big => io.u32_be(data, at)
    }
}

fn append_word(mut out: []u8, c: u32, order: unicode.Order) {
    match order {
        Little => io.put_le32(mut out, i64(c))
        Big => io.put_be32(mut out, i64(c))
    }
}

/// Returns the bytes of `cs` in the given byte `order`, four bytes per code point and without a byte order mark.
pub fn to_bytes(cs: []u32, order: unicode.Order) -> []u8 {
    var out: []u8 = []
    for c in cs {
        append_word(mut out, c, order)
    }
    out
}

fn words_of(data: []u8, order: unicode.Order) -> []u32 {
    var out: []u32 = []
    var at = 0
    for at + 3 < data.len {
        push(mut out, word_at(data, at, order))
        at += 4
    }
    out
}

/// Reads code points from `data` in the given byte `order`.
/// A byte order mark is not interpreted and values are not validated. Fails with `BadLength` when `data.len` is not a multiple of 4.
pub fn from_bytes(data: []u8, order: unicode.Order) -> []u32 ! Error {
    if data.len % 4 != 0 {
        fail BadLength
    }
    words_of(data, order)
}

/// Returns `s` encoded as UTF-32 bytes in the given byte `order`, preceded by a byte order mark when `bom` is `true`.
/// Each byte of `s` that is not valid UTF-8 becomes U+FFFD.
pub fn encode_bytes(s: str, order: unicode.Order, bom: bool) -> []u8 {
    var out: []u8 = []
    if bom {
        append_word(mut out, 0xFEFF, order)
    }
    for c in s {
        append_word(mut out, c, order)
    }
    out
}

fn payload(data: []u8) -> []u8 {
    if unicode.bom_order(data, 4) != none {
        return data[4..]
    }
    data
}

/// Decodes UTF-32 bytes into a string.
/// A leading byte order mark is removed, and it selects its own byte order over `order`. Without one, `order` applies. Fails with `BadLength` when the bytes after the mark are not a multiple of 4 and with `InvalidCodePoint` for a surrogate or a value above `0x10FFFF`.
pub fn decode_bytes(data: []u8, order: unicode.Order) -> str ! Error {
    let actual = unicode.bom_order(data, 4) ?? order
    let words = from_bytes(payload(data), actual)?
    decode(words)
}

/// Decodes UTF-32 bytes into a string, replacing invalid input with U+FFFD.
/// The byte order mark is handled as in `decode_bytes`. Each invalid value and a trailing partial code point become one U+FFFD.
pub fn decode_bytes_lossy(data: []u8, order: unicode.Order) -> str {
    let actual = unicode.bom_order(data, 4) ?? order
    let body = payload(data)
    let decoded = decode_lossy(words_of(body, actual))
    if body.len % 4 != 0 {
        return "{decoded}{text.from_char(0xFFFD)}"
    }
    decoded
}
