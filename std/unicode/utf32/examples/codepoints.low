import std/text
import std/unicode
import std/unicode/utf32

fn describe(e: utf32.Error) -> str {
    match e {
        InvalidCodePoint(at) => "invalid code point at index {at}"
        BadLength => "length is not a multiple of 4"
    }
}

fn reversed(s: str) -> str {
    var cs = utf32.encode(s)
    var i = 0
    var j = cs.len - 1
    for i < j {
        let tmp = cs[i]
        cs[i] = cs[j]
        cs[j] = tmp
        i += 1
        j -= 1
    }
    utf32.decode_lossy(cs)
}

fn read_bytes(label: str, data: []u8) {
    let decoded = utf32.decode_bytes(data, unicode.Order.Little) catch {
        e => {
            print("{label}: {describe(e)}")
            return
        }
    }
    print("{label}: {decoded}")
}

/// Treats text as an array of code points to reverse it, then decodes UTF-32 byte streams with and without a byte order mark and with invalid values.
fn main() {
    print(reversed("naïve 日本 😀"))

    let word = "Zoë😀"
    let plain = utf32.encode_bytes(word, unicode.Order.Big, false)
    let marked = utf32.encode_bytes(word, unicode.Order.Big, true)
    print(text.encode_hex(plain))
    print(text.encode_hex(marked))

    read_bytes("big endian read as little", plain)
    read_bytes("mark picks the order", marked)

    let truncated = plain[..plain.len - 1]
    read_bytes("truncated", truncated)

    let surrogate = utf32.to_bytes([u32(0x41), 0xD800], unicode.Order.Little)
    read_bytes("surrogate", surrogate)
    let lossy = utf32.decode_bytes_lossy(surrogate, unicode.Order.Little)
    print("lossy: {lossy}")

    let too_big = [u32(0x61), 0x110000]
    let fixed = utf32.decode_lossy(too_big)
    print(fixed)
    let checked = utf32.decode(too_big) catch {
        e => {
            print(describe(e))
            return
        }
    }
    print(checked)
}
