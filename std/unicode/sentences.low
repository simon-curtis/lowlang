const sentence_start = -1
const terminator_none = 0
const terminator_aterm = 1
const terminator_sterm = 2
const stage_terminator = 0
const stage_closed = 1
const stage_spaced = 2

struct Sentence {
    raw: i64
    last: i64
    before: i64
    terminator: i64
    stage: i64
}

fn sentence_class(p: u32) -> i64 {
    i64(p & sentence_class_mask)
}

fn is_paragraph_separator(class: i64) -> bool {
    class == sentence_sep || class == sentence_cr || class == sentence_lf
}

fn is_sentence_ignored(class: i64) -> bool {
    class == sentence_extend || class == sentence_format
}

fn is_sentence_terminator(class: i64) -> bool {
    class == sentence_aterm || class == sentence_sterm
}

fn lower_follows(s: str, from: i64) -> bool {
    var at = from
    for at < s.len {
        let r = decode_rune(s, at)
        let class = sentence_class(sentence_props(r.code))
        if class == sentence_lower {
            return true
        }
        if class == sentence_oletter || class == sentence_upper || is_paragraph_separator(class) || is_sentence_terminator(class) {
            return false
        }
        at += r.size
    }
    false
}

fn sentence_joins(st: Sentence, s: str, at: i64, next: i64) -> bool {
    let raw = st.raw
    if raw == sentence_cr && next == sentence_lf {
        return true
    }
    if is_paragraph_separator(raw) {
        return false
    }
    if is_sentence_ignored(next) {
        return true
    }
    let last = st.last
    if last == sentence_aterm && next == sentence_numeric {
        return true
    }
    if last == sentence_aterm && next == sentence_upper && (st.before == sentence_upper || st.before == sentence_lower) {
        return true
    }
    let terminated = st.terminator != terminator_none
    if st.terminator == terminator_aterm && lower_follows(s, at) {
        return true
    }
    if terminated && (next == sentence_scontinue || is_sentence_terminator(next)) {
        return true
    }
    let closes = next == sentence_close && st.stage <= stage_closed
    if terminated && (closes || next == sentence_sp || is_paragraph_separator(next)) {
        return true
    }
    !terminated
}

fn next_terminator(st: Sentence, class: i64) -> i64 {
    match class {
        sentence_aterm => terminator_aterm
        sentence_sterm => terminator_sterm
        sentence_close => if st.stage <= stage_closed { st.terminator } else { terminator_none }
        sentence_sp => st.terminator
        _ => terminator_none
    }
}

fn next_stage(st: Sentence, class: i64) -> i64 {
    match class {
        sentence_aterm => stage_terminator
        sentence_sterm => stage_terminator
        sentence_close => stage_closed
        sentence_sp => stage_spaced
        _ => st.stage
    }
}

fn sentence_advance(mut st: Sentence, class: i64) {
    st.raw = class
    let absorbed = is_sentence_ignored(class) && st.last != sentence_start && !is_paragraph_separator(st.last)
    if absorbed {
        return
    }
    let terminator = next_terminator(st, class)
    st.stage = next_stage(st, class)
    st.terminator = terminator
    st.before = st.last
    st.last = class
}

/// Returns the byte index where the sentence that starts at `at` in `s` ends.
/// Sentences follow Unicode Standard Annex 29: a terminator, any closing punctuation and spaces after it, and a paragraph separator belong to the sentence they end, except that a full stop before a digit, between capital letters or before lowercase text does not end it. `at` must be the start of a sentence. The last sentence ends at `s.len`.
pub fn sentence_end(s: str, at: i64) -> i64 {
    var st = Sentence { raw: sentence_start, last: sentence_start, before: sentence_start, terminator: terminator_none, stage: stage_terminator }
    var i = at
    for i < s.len {
        let r = decode_rune(s, i)
        let class = sentence_class(sentence_props(r.code))
        if i > at && !sentence_joins(st, s, i, class) {
            return i
        }
        sentence_advance(mut st, class)
        i += r.size
    }
    s.len
}

/// Returns the sentences of `s` as substrings.
/// Each sentence keeps its trailing spaces and paragraph separator. The pieces are slices of `s` and joining them gives `s` back.
pub fn sentences(s: str) -> str[] {
    var out: str[] = []
    var at = 0
    for at < s.len {
        let end = sentence_end(s, at)
        out.push(s[at..end])
        at = end
    }
    out
}

/// Returns the number of sentences in `s`.
pub fn sentence_count(s: str) -> i64 {
    var count = 0
    var at = 0
    for at < s.len {
        at = sentence_end(s, at)
        count += 1
    }
    count
}
