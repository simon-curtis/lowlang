import std/io

fn folded_record(index: str, blocks: str, shift: i64, mask: u32, c: u32) -> i64 {
    match c {
        >= fold_to => trie_record(index, blocks, shift, mask, c - fold_gap)
        >= fold_from => 0
        _ => trie_record(index, blocks, shift, mask, c)
    }
}

fn word_props(c: u32) -> u32 {
    let id = folded_record(word_index_table(), word_blocks_table(), word_block_shift, word_block_mask, c)
    u32(word_records_table()[id])
}

fn sentence_props(c: u32) -> u32 {
    let id = folded_record(sentence_index_table(), sentence_blocks_table(), sentence_block_shift, sentence_block_mask, c)
    u32(sentence_records_table()[id])
}

fn line_props(c: u32) -> u32 {
    let id = folded_record(line_index_table(), line_blocks_table(), line_block_shift, line_block_mask, c)
    u32(io.u16_le_str(line_records_table(), id * line_record_size))
}
