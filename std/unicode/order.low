/// The byte order of UTF-16 code units and UTF-32 code points in a byte stream.
pub enum Order {
    /// The least significant byte of each unit comes first.
    Little
    /// The most significant byte of each unit comes first.
    Big
}

fn zeros_at(data: []u8, from: i64, to: i64) -> bool {
    for i in from..to {
        if data[i] != 0 {
            return false
        }
    }
    true
}

/// Returns the byte order that the byte order mark at the start of `data` selects, or `none` when there is no mark.
/// `width` is the size of one unit in bytes: `2` for UTF-16, where the mark is `FF FE` or `FE FF`, and `4` for UTF-32, where it is `FF FE 00 00` or `00 00 FE FF`.
pub fn bom_order(data: []u8, width: i64) -> Order? {
    if data.len < width {
        return none
    }
    let lead = width - 2
    if data[lead] == 0xFE && data[lead + 1] == 0xFF && zeros_at(data, 0, lead) {
        return Order.Big
    }
    if data[0] == 0xFF && data[1] == 0xFE && zeros_at(data, 2, width) {
        return Order.Little
    }
    none
}
