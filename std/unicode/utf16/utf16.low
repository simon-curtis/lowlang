import std/io
import std/text
import std/unicode

/// Why a UTF-16 conversion failed.
pub enum Error {
    /// A surrogate code unit has no partner. `at` is its index in the code unit slice, not a byte offset.
    LoneSurrogate(at: i64)
    /// The byte input has an odd number of bytes, so its last byte is not a whole code unit.
    OddLength
}

/// A code point decoded from UTF-16 together with the number of code units it took.
pub struct Unit {
    /// The decoded code point, or `0xFFFD` for a lone surrogate or an out-of-range position.
    pub code: u32
    /// The number of code units consumed: `1` or `2`, or `0` when the position is out of range.
    pub size: i64
}

/// Returns whether `u` is a surrogate code unit, in `0xD800` to `0xDFFF`.
pub fn is_surrogate(u: u16) -> bool {
    u >= 0xD800 && u < 0xE000
}

/// Returns whether `u` is a high (leading) surrogate, in `0xD800` to `0xDBFF`.
pub fn is_high_surrogate(u: u16) -> bool {
    u >= 0xD800 && u < 0xDC00
}

/// Returns whether `u` is a low (trailing) surrogate, in `0xDC00` to `0xDFFF`.
pub fn is_low_surrogate(u: u16) -> bool {
    u >= 0xDC00 && u < 0xE000
}

/// Returns the code point that the surrogate pair `high` and `low` encodes.
/// `high` must be a high surrogate and `low` a low surrogate; other values give a meaningless result.
pub fn join(high: u16, low: u16) -> u32 {
    0x10000 + ((u32(high) - 0xD800) << 10) + (u32(low) - 0xDC00)
}

/// A `\uXXXX` escape decoded by `decode_escape`.
pub struct Escape {
    /// The code point. A surrogate pair of two escapes gives the supplementary code point, and a surrogate with no partner keeps its own value.
    pub code: u32
    /// The number of bytes the escape used after its `\u`: `4` for one escape and `10` for a pair.
    pub length: i64
    /// Whether `code` is a surrogate with no partner.
    pub lone: bool
}

/// Decodes the `\uXXXX` escape whose four hexadecimal digits start at index `at` of `s`, just after its `\u`.
/// A high surrogate followed by a `\uXXXX` low surrogate is joined into one code point. The result reports a lone surrogate and leaves the policy to the caller.
///
/// Fails with `BadDigit` at the index of the first byte of the first escape that is not a hexadecimal digit, or at `s.len` when it runs past the end.
pub fn decode_escape(s: str, at: i64) -> Escape ! text.ParseError {
    let first = u16(text.parse_hex_at(s, at, 4)?)
    if !is_surrogate(first) {
        return Escape { code: u32(first), length: 4, lone: false }
    }
    if is_high_surrogate(first) && at + 10 <= s.len && s[at + 4] == '\\' && s[at + 5] == 'u' {
        let second = text.parse_hex_at(s, at + 6, 4) or return Escape { code: u32(first), length: 4, lone: true }
        if is_low_surrogate(u16(second)) {
            return Escape { code: join(first, u16(second)), length: 10, lone: false }
        }
    }
    Escape { code: u32(first), length: 4, lone: true }
}

/// Decodes the code point that starts at index `at` of `units`.
/// A surrogate pair gives a supplementary code point with size `2`. A surrogate with no partner gives `0xFFFD` with size `1`, and an index outside `units` gives `0xFFFD` with size `0`.
pub fn decode_rune(units: []u16, at: i64) -> Unit {
    if at < 0 || at >= units.len {
        return Unit { code: 0xFFFD, size: 0 }
    }
    let first = units[at]
    if !is_surrogate(first) {
        return Unit { code: u32(first), size: 1 }
    }
    if is_high_surrogate(first) && at + 1 < units.len && is_low_surrogate(units[at + 1]) {
        return Unit { code: join(first, units[at + 1]), size: 2 }
    }
    Unit { code: 0xFFFD, size: 1 }
}

/// Appends the UTF-16 encoding of the code point `c` to `out`.
/// A supplementary code point becomes a surrogate pair. A surrogate or a value above `0x10FFFF` is written as `0xFFFD`.
pub fn encode_rune(mut out: []u16, c: u32) {
    if !text.is_scalar(c) {
        push(mut out, 0xFFFD)
        return
    }
    if c < 0x10000 {
        push(mut out, u16(c))
        return
    }
    let offset = c - 0x10000
    push(mut out, u16(0xD800 + (offset >> 10)))
    push(mut out, u16(0xDC00 + (offset & 0x3FF)))
}

/// Returns the UTF-16 code units of `s`.
/// Each byte of `s` that is not valid UTF-8 becomes `0xFFFD`.
pub fn encode(s: str) -> []u16 {
    var out: []u16 = []
    for c in s {
        encode_rune(mut out, c)
    }
    out
}

/// Decodes UTF-16 code units into a string, replacing each lone surrogate with U+FFFD.
pub fn decode_lossy(units: []u16) -> str {
    var out: []u8 = []
    var at = 0
    for at < units.len {
        let r = decode_rune(units, at)
        text.append_char(mut out, r.code)
        at += r.size
    }
    __str_view(out)
}

/// Decodes UTF-16 code units into a string.
/// Fails with `LoneSurrogate` at the index of the first surrogate that has no partner.
pub fn decode(units: []u16) -> str ! Error {
    var out: []u8 = []
    var at = 0
    for at < units.len {
        let r = decode_rune(units, at)
        if is_surrogate(units[at]) && r.size == 1 {
            fail LoneSurrogate(at)
        }
        text.append_char(mut out, r.code)
        at += r.size
    }
    __str_view(out)
}

fn unit_at(data: []u8, at: i64, order: unicode.Order) -> u16 {
    match order {
        Little => io.u16_le(data, at)
        Big => io.u16_be(data, at)
    }
}

/// Returns the bytes of `units` in the given byte `order`, two bytes per unit and without a byte order mark.
pub fn to_bytes(units: []u16, order: unicode.Order) -> []u8 {
    var out: []u8 = []
    for u in units {
        match order {
            Little => io.put_le16(mut out, i64(u))
            Big => io.put_be16(mut out, i64(u))
        }
    }
    out
}

/// Reads UTF-16 code units from `data` in the given byte `order`, ignoring a trailing odd byte.
/// A byte order mark is not interpreted.
pub fn units(data: []u8, order: unicode.Order) -> []u16 {
    var out: []u16 = []
    var at = 0
    for at + 1 < data.len {
        push(mut out, unit_at(data, at, order))
        at += 2
    }
    out
}

/// Reads UTF-16 code units from `data` in the given byte `order`.
/// A byte order mark is not interpreted. Fails with `OddLength` when `data.len` is odd.
pub fn from_bytes(data: []u8, order: unicode.Order) -> []u16 ! Error {
    if data.len % 2 != 0 {
        fail OddLength
    }
    units(data, order)
}

/// Returns `s` encoded as UTF-16 bytes in the given byte `order`, preceded by a byte order mark when `bom` is `true`.
/// Each byte of `s` that is not valid UTF-8 becomes U+FFFD.
pub fn encode_bytes(s: str, order: unicode.Order, bom: bool) -> []u8 {
    var units: []u16 = []
    if bom {
        push(mut units, 0xFEFF)
    }
    for c in s {
        encode_rune(mut units, c)
    }
    to_bytes(units, order)
}

fn payload(data: []u8) -> []u8 {
    if unicode.bom_order(data, 2) != none {
        return data[2..]
    }
    data
}

/// Decodes UTF-16 bytes into a string.
/// A leading byte order mark is removed, and it selects its own byte order over `order`: `FF FE` for little-endian and `FE FF` for big-endian. Without one, `order` applies. Fails with `OddLength` when the bytes after the mark are an odd number and with `LoneSurrogate` when a surrogate has no partner.
pub fn decode_bytes(data: []u8, order: unicode.Order) -> str ! Error {
    let actual = unicode.bom_order(data, 2) ?? order
    let units = from_bytes(payload(data), actual)?
    decode(units)
}

/// Decodes UTF-16 bytes into a string, replacing invalid input with U+FFFD.
/// The byte order mark is handled as in `decode_bytes`. Each lone surrogate and a trailing odd byte become one U+FFFD.
pub fn decode_bytes_lossy(data: []u8, order: unicode.Order) -> str {
    let actual = unicode.bom_order(data, 2) ?? order
    let body = payload(data)
    let decoded = decode_lossy(units(body, actual))
    if body.len % 2 == 1 {
        return "{decoded}{text.from_char(0xFFFD)}"
    }
    decoded
}
