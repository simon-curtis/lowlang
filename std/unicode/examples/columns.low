import std/text
import std/unicode

fn pad(s: str, width: i64) -> str {
    let gap = width - unicode.text_width(s)
    "{s}{text.repeat(" ", if gap > 0 { gap } else { 0 })}"
}

fn clip(s: str, clusters: i64) -> str {
    let parts = unicode.graphemes(s)
    if parts.len <= clusters {
        return s
    }
    var out = ""
    for part in parts[..clusters - 1] {
        out += part
    }
    "{out}…"
}

/// Aligns a table by terminal columns, clips text at grapheme cluster boundaries, and labels characters by category and script.
fn main() {
    let acute = unicode.encode_rune(0x301)
    let names = ["Ada", "日本語", "Zoe{acute}"]
    for name in names {
        let clusters = unicode.grapheme_count(name)
        print("|{pad(name, 8)}| {unicode.text_width(name)} columns, {clusters} clusters, {name.len} bytes")
    }

    for sample in ["👍🏽", "🇬🇧", "👨‍👩‍👧"] {
        print("{sample} is {unicode.grapheme_count(sample)} cluster of {text.char_count(sample)} code points")
    }

    let family = "👨‍👩‍👧 family"
    print(clip(family, 4))
    print(clip("Zoe{acute}!", 3))
    print(clip("🇬🇧🇫🇷🇩🇪", 2))

    for c in "aÄ1 ,€Ωж日{acute}" {
        let category = unicode.category_code(unicode.category(c))
        let script = unicode.script(c)
        print("U+{c:X4} {category} {script} width {unicode.display_width(c)}")
    }
}
