import std/text
import std/unicode

fn wrap(s: str, width: i64) -> []str {
    var lines: []str = []
    var line = ""
    for piece in unicode.line_segments(s) {
        let visible = text.trim_suffix(text.trim_suffix(piece, "\n"), " ")
        if line != "" && unicode.text_width(line) + unicode.text_width(visible) > width {
            push(mut lines, text.trim_suffix(line, " "))
            line = ""
        }
        line = "{line}{piece}"
    }
    push(mut lines, text.trim_suffix(text.trim_suffix(line, "\n"), " "))
    lines
}

/// Splits text into sentences, words and line break opportunities, and wraps a paragraph at line break opportunities.
fn main() {
    let paragraph = "Rivera paid $3.50 for the well-known report. It was 12,500 words long! Nobody finished it."
    for sentence in unicode.sentences(paragraph) {
        print("sentence: {text.trim(sentence)}")
    }

    var tokens: []str = []
    for word in unicode.words("Don't stop, e.g. 3.14 or example.com") {
        if unicode.is_alphanumeric(unicode.decode_rune(word, 0).code) {
            push(mut tokens, word)
        }
    }
    print("words: {text.join(tokens, " | ")}")

    for line in wrap(paragraph, 28) {
        print("|{line}|")
    }

    var marks: []str = []
    for b in unicode.line_breaks("first line\nsecond line") {
        let mark = if b.mandatory { "!" } else { "?" }
        push(mut marks, "{b.at}{mark}")
    }
    print("breaks: {text.join(marks, " ")}")
}
