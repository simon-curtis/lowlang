import std/slices
import std/testing
import std/text

fn test_sender_report_with_a_block_has_the_layout_of_rfc_3550(t: *testing.T) {
    let report = SenderReport {
        ssrc: 0x01020304
        ntp_seconds: 0xE5000000
        ntp_fraction: 0x80000000
        rtp_timestamp: 0x00001000
        packets: 10
        octets: 1200
        reports: [ReportBlock { ssrc: 0x0A0B0C0D, fraction_lost: 25, lost: -2, highest_sequence: 0x00010005, jitter: 7, last_sender_report: 0x11223344, delay_since_last_sender_report: 65536 }]
    }
    let wire = marshal_rtcp([Rtcp.Sender(report)]) or panic("marshal")
    let framed = hex("81c8000c" + "01020304" + "e5000000" + "80000000" + "00001000" + "0000000a" + "000004b0" + "0a0b0c0d" + "19fffffe" + "00010005" + "00000007" + "11223344" + "00010000")
    testing.error_if(t, !slices.equal(wire, framed), "wire {text.encode_hex(wire)}")
    let back = parse_rtcp(wire) or panic("parse")
    match back[0] {
        Sender(r) => {
            testing.error_if(t, r.ssrc != 0x01020304 || r.ntp_seconds != 0xE5000000 || r.packets != 10 || r.octets != 1200, "sender info")
            testing.error_if(t, r.reports.len != 1 || r.reports[0].lost != -2 || r.reports[0].fraction_lost != 25 || r.reports[0].highest_sequence != 0x00010005, "block")
        }
        _ => testing.error(t, "not a sender report")
    }
}

fn test_compound_packet_round_trip(t: *testing.T) {
    let packets: Rtcp[] = [
        Rtcp.Receiver(ReceiverReport { ssrc: 1, reports: [ReportBlock { ssrc: 2 }, ReportBlock { ssrc: 3, lost: 0x7FFFFF }] })
        Rtcp.Description(SourceDescription { chunks: [SdesChunk { ssrc: 1, items: [SdesItem { kind: sdes_cname, text: "user@host" }, SdesItem { kind: 2, text: "n" }] }] })
        Rtcp.Nack(GenericNack { sender: 1, media: 2, lost: [100, 101, 103, 116, 117, 65535, 0, 5000] })
        Rtcp.Pli(PictureLoss { sender: 1, media: 2 })
        Rtcp.Feedback(FeedbackMessage { kind: type_payload_feedback, format: 15, sender: 1, media: 0, fci: bytes("REMB") })
        Rtcp.Bye(Goodbye { sources: [1, 2], reason: "done" })
        Rtcp.Other(RawPacket { kind: 204, count: 3, body: [1, 2, 3, 4] })
    ]
    let wire = marshal_rtcp(packets) or panic("marshal")
    testing.error_if(t, wire.len % 4 != 0, "length")
    let back = parse_rtcp(wire) or panic("parse")
    testing.error_if(t, back.len != 7, "packets {back.len}")
    match back[0] {
        Receiver(r) => testing.error_if(t, r.reports.len != 2 || r.reports[1].lost != 0x7FFFFF, "receiver blocks")
        _ => testing.error(t, "first is not a receiver report")
    }
    match back[1] {
        Description(d) => {
            testing.error_if(t, d.chunks.len != 1 || d.chunks[0].items.len != 2, "chunks")
            testing.error_if(t, d.chunks[0].items[0].text != "user@host" || d.chunks[0].items[1].text != "n", "items")
        }
        _ => testing.error(t, "second is not a description")
    }
    match back[2] {
        Nack(n) => testing.error_if(t, !slices.equal(n.lost, [100, 101, 103, 116, 117, 65535, 0, 5000]), "lost {n.lost}")
        _ => testing.error(t, "third is not a NACK")
    }
    match back[3] {
        Pli(p) => testing.error_if(t, p.sender != 1 || p.media != 2, "pli")
        _ => testing.error(t, "fourth is not a PLI")
    }
    match back[4] {
        Feedback(f) => testing.error_if(t, f.format != 15 || str(f.fci) != "REMB", "feedback")
        _ => testing.error(t, "fifth is not a feedback message")
    }
    match back[5] {
        Bye(g) => testing.error_if(t, !slices.equal(g.sources, [1, 2]) || g.reason != "done", "bye")
        _ => testing.error(t, "sixth is not a goodbye")
    }
    match back[6] {
        Other(o) => testing.error_if(t, o.kind != 204 || o.count != 3, "other")
        _ => testing.error(t, "seventh is not raw")
    }
}

fn test_generic_nack_packs_a_run_into_one_entry(t: *testing.T) {
    let wire = marshal_rtcp([Rtcp.Nack(GenericNack { sender: 1, media: 2, lost: [0x1000, 0x1001, 0x1003, 0x1010] })]) or panic("marshal")
    testing.error_if(t, text.encode_hex(wire) != "81cd0003" + "00000001" + "00000002" + "10008005", "wire {text.encode_hex(wire)}")
}

fn test_picture_loss_layout(t: *testing.T) {
    let wire = marshal_rtcp([Rtcp.Pli(PictureLoss { sender: 0x11111111, media: 0x22222222 })]) or panic("marshal")
    testing.error_if(t, text.encode_hex(wire) != "81ce0002" + "11111111" + "22222222", "wire {text.encode_hex(wire)}")
}

fn test_padding_of_the_last_packet_is_removed(t: *testing.T) {
    let wire = hex("a1ce0003" + "00000001" + "00000002" + "00000004")
    let back = parse_rtcp(wire) or panic("parse")
    match back[0] {
        Pli(p) => testing.error_if(t, p.sender != 1 || p.media != 2, "pli")
        _ => testing.error(t, "not a PLI")
    }
}

fn refuses(wire: u8[]) -> bool {
    parse_rtcp(wire) catch {
        _ => return true
    }
    false
}

fn test_malformed_rtcp_is_refused(t: *testing.T) {
    let cases: [str: str] = [
        "short": "81c800"
        "version 1": "41c80000"
        "length past the end": "81c8000c00000001"
        "sender report without sender info": "80c80001" + "00000001"
        "block count past the report": "82c90001" + "00000001"
        "padding count zero": "a1ce0003" + "00000001" + "00000002" + "00000000"
        "padding past the packet": "a1ce0003" + "00000001" + "00000002" + "000000ff"
        "trailing bytes": "81ce0002" + "00000001" + "00000002" + "deadbeef"
        "description without terminator": "81ca0001" + "00000001"
        "item past the chunk": "81ca0002" + "00000001" + "01ff6162"
        "feedback without ssrcs": "81cd0000"
    ]
    for name, h in cases {
        testing.error_if(t, !refuses(hex(h)), name)
    }
}

fn test_marshal_rejects_what_has_no_wire_form(t: *testing.T) {
    testing.error_if(t, !refuses_marshal_rtcp(Rtcp.Nack(GenericNack { sender: 1, media: 2, lost: [] })), "empty NACK")
    testing.error_if(t, !refuses_marshal_rtcp(Rtcp.Feedback(FeedbackMessage { kind: 206, format: 4, sender: 1, media: 2, fci: [1, 2, 3] })), "fci not in words")
    testing.error_if(t, !refuses_marshal_rtcp(Rtcp.Description(SourceDescription { chunks: [SdesChunk { ssrc: 1, items: [SdesItem { kind: 1, text: text.join(slices.repeat(["x"], 256), "") }] }] })), "long item")
}

fn refuses_marshal_rtcp(p: Rtcp) -> bool {
    marshal_rtcp([p]) catch {
        _ => return true
    }
    false
}
