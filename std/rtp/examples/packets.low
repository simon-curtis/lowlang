import std/rtp

fn main() {
    let packet = rtp.Packet {
        marker: true
        payload_type: 111
        sequence: 65535
        timestamp: 960
        ssrc: 0x1234
        extensions: [rtp.Extension { id: 1, data: [0x30] }]
        payload: bytes("opus frame")
    }
    let wire = rtp.marshal(packet) or return
    print("{wire.len} bytes, {rtp.classify(wire)}")
    let back = rtp.parse(wire) or return
    print("sequence {back.sequence}, payload {str(back.payload)}, audio level {(rtp.find_extension(back, 1) ?? [])[0]}")
    print("0 follows 65535: {rtp.sequence_after(0, back.sequence)}")
    let compound = rtp.marshal_rtcp([
        rtp.Rtcp.Receiver(rtp.ReceiverReport { ssrc: 0x5678, reports: [rtp.ReportBlock { ssrc: 0x1234, fraction_lost: 64, lost: 3, highest_sequence: 65537 }] })
        rtp.Rtcp.Description(rtp.SourceDescription { chunks: [rtp.SdesChunk { ssrc: 0x5678, items: [rtp.SdesItem { kind: rtp.sdes_cname, text: "listener" }] }] })
        rtp.Rtcp.Nack(rtp.GenericNack { sender: 0x5678, media: 0x1234, lost: [65534, 65535, 1] })
    ]) or return
    print("{compound.len} bytes, {rtp.classify(compound)}")
    let parsed = rtp.parse_rtcp(compound) or return
    for p in parsed {
        match p {
            Receiver(r) => print("receiver report: lost {r.reports[0].lost}, highest {r.reports[0].highest_sequence}")
            Description(d) => print("cname {d.chunks[0].items[0].text}")
            Nack(n) => print("nack {n.lost}")
            _ => print("other")
        }
    }
}
