import std/slices
import std/testing
import std/text

fn hex(s: str) -> u8[] {
    text.decode_hex(s) or panic("hex")
}

fn test_parse_the_packet_of_rfc_7714(t: *testing.T) {
    let wire = hex("8040f17b8041f8d35501a0b247616c6c69612065737420" + "6f6d6e697320646976697361" + "20696e207061727465732074726573")
    let p = parse(wire) or panic("parse")
    testing.error_if(t, p.payload_type != 64, "payload type {p.payload_type}")
    testing.error_if(t, p.sequence != 0xf17b, "sequence {p.sequence}")
    testing.error_if(t, p.timestamp != 0x8041f8d3, "timestamp {p.timestamp}")
    testing.error_if(t, p.ssrc != 0x5501a0b2, "ssrc {p.ssrc}")
    testing.error_if(t, str(p.payload) != "Gallia est omnis divisa in partes tres", "payload {str(p.payload)}")
    testing.error_if(t, p.marker || p.extension_profile != 0 || p.padding != 0, "flags")
    testing.error_if(t, (header_length(wire) or 0) != 12, "header length")
}

fn test_round_trip_with_contributors_extensions_and_padding(t: *testing.T) {
    let p = Packet {
        marker: true
        payload_type: 111
        sequence: 65535
        timestamp: 0xFFFFFFFF
        ssrc: 0x01020304
        csrc: [7, 0xAABBCCDD]
        extensions: [Extension { id: 1, data: [1, 2, 3] }, Extension { id: 14, data: bytes("0123456789abcdef") }]
        payload: [9, 8, 7]
        padding: 5
    }
    let wire = marshal(p) or panic("marshal")
    testing.error_if(t, wire[0] != 0xB2, "flags byte {wire[0]}")
    testing.error_if(t, wire[wire.len - 1] != 5, "padding count")
    let q = parse(wire) or panic("parse")
    testing.error_if(t, !q.marker || q.payload_type != 111 || q.sequence != 65535 || q.timestamp != 0xFFFFFFFF, "fixed fields")
    testing.error_if(t, !slices.equal(q.csrc, [7, 0xAABBCCDD]), "csrc")
    testing.error_if(t, q.extension_profile != profile_one_byte, "profile {q.extension_profile}")
    testing.error_if(t, q.extensions.len != 2 || !slices.equal(find_extension(q, 1) ?? [], [1, 2, 3]), "extensions")
    testing.error_if(t, str(find_extension(q, 14) ?? []) != "0123456789abcdef", "sixteen byte element")
    testing.error_if(t, !slices.equal(q.payload, [9, 8, 7]) || q.padding != 5, "payload and padding")
}

fn test_two_byte_extension_when_an_element_does_not_fit_the_one_byte_form(t: *testing.T) {
    let long: u8[] = slices.repeat([u8(0xAB)], 40)
    let p = Packet { payload_type: 96, sequence: 1, timestamp: 2, ssrc: 3, extensions: [Extension { id: 20, data: long }, Extension { id: 2, data: [] }] }
    let wire = marshal(p) or panic("marshal")
    let q = parse(wire) or panic("parse")
    testing.error_if(t, q.extension_profile != profile_two_byte, "profile {q.extension_profile}")
    testing.error_if(t, !slices.equal(find_extension(q, 20) ?? [], long), "long element")
    testing.error_if(t, q.extensions.len != 2 || find_extension(q, 2) == none, "empty element")
}

fn test_unknown_extension_profile_is_kept_whole(t: *testing.T) {
    let wire = hex("90600001000000020000000312340001deadbeef01020304")
    let p = parse(wire) or panic("parse")
    testing.error_if(t, p.extension_profile != 0x1234 || p.extensions.len != 1 || p.extensions[0].id != 0, "block")
    testing.error_if(t, !slices.equal(p.extensions[0].data, hex("deadbeef")), "block data")
    testing.error_if(t, !slices.equal(marshal(p) or [], wire), "round trip")
}

fn refuses_parse(wire: u8[]) -> bool {
    parse(wire) catch {
        _ => return true
    }
    false
}

fn refuses_marshal(p: Packet) -> bool {
    marshal(p) catch {
        _ => return true
    }
    false
}

fn test_malformed_packets_are_refused(t: *testing.T) {
    let cases: [str: str] = [
        "short": "800000"
        "version 1": "406000010000000200000003"
        "csrc past the end": "826000010000000200000003"
        "extension past the end": "906000010000000200000003bede0002"
        "zero padding count": "a0600001000000020000000300"
        "padding larger than the payload": "a06000010000000200000003ff"
        "one byte element past the block": "906000010000000200000003bede00013f000000"
    ]
    for name, h in cases {
        testing.error_if(t, !refuses_parse(hex(h)), name)
    }
}

fn test_marshal_refuses_what_does_not_fit(t: *testing.T) {
    let base = Packet { payload_type: 96, sequence: 1, timestamp: 2, ssrc: 3 }
    var many = base
    many.csrc = slices.repeat([1], 16)
    var wide = base
    wide.payload_type = 128
    var bad = base
    bad.extension_profile = profile_one_byte
    bad.extensions = [Extension { id: 15, data: [1] }]
    var late = base
    late.sequence = 0x10000
    var source = base
    source.csrc = [0x100000000]
    var raw = base
    raw.extension_profile = 0x1234
    raw.extensions = [Extension { id: 0, data: [1, 2, 3] }]
    testing.error_if(t, !refuses_marshal(many), "sixteen contributors")
    testing.error_if(t, !refuses_marshal(wide), "payload type 128")
    testing.error_if(t, !refuses_marshal(bad), "identifier 15 in the one-byte form")
    testing.error_if(t, !refuses_marshal(raw), "raw block that is not whole words")
    testing.error_if(t, !refuses_marshal(late), "sequence number 65536")
    testing.error_if(t, !refuses_marshal(source), "contributing source of 33 bits")
}

fn test_sequence_numbers_wrap(t: *testing.T) {
    testing.error_if(t, !sequence_after(0, 65535), "0 after 65535")
    testing.error_if(t, sequence_after(65535, 0), "65535 after 0")
    testing.error_if(t, sequence_after(7, 7), "7 after 7")
    testing.error_if(t, !sequence_after(100, 99), "100 after 99")
}

fn test_demultiplexing_by_the_first_byte(t: *testing.T) {
    let cases: [str: Kind] = [
        "00010000": Kind.Stun
        "16fefd00": Kind.Dtls
        "8060": Kind.Rtp
        "80c8": Kind.Rtcp
        "81cd": Kind.Rtcp
        "8100": Kind.Rtp
        "4000": Kind.Unknown
        "f000": Kind.Unknown
    ]
    for h, want in cases {
        let got = classify(hex(h))
        testing.error_if(t, got != want, "{h}")
    }
    testing.error_if(t, classify([]) != Kind.Unknown, "empty")
}
