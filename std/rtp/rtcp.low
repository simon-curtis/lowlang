import std/io

/// The packet type of a sender report.
pub const type_sender_report = 200

/// The packet type of a receiver report.
pub const type_receiver_report = 201

/// The packet type of a source description.
pub const type_source_description = 202

/// The packet type of a goodbye.
pub const type_goodbye = 203

/// The packet type of the transport layer feedback of RFC 4585, which carries Generic NACK.
pub const type_transport_feedback = 205

/// The packet type of the payload-specific feedback of RFC 4585, which carries Picture Loss Indication.
pub const type_payload_feedback = 206

/// The SDES item type of the canonical name.
pub const sdes_cname = 1

/// One reception report block of a sender or receiver report (RFC 3550 section 6.4.1).
pub struct ReportBlock {
    /// The source the block reports on.
    pub ssrc: i64
    /// The fraction of packets lost since the previous report, in 256ths.
    pub fraction_lost: i64 = 0
    /// The cumulative number of packets lost, a signed 24-bit value.
    pub lost: i64 = 0
    /// The extended highest sequence number received: the cycle count above the 16-bit sequence number.
    pub highest_sequence: i64 = 0
    /// The interarrival jitter in timestamp units.
    pub jitter: i64 = 0
    /// The middle 32 bits of the NTP timestamp of the last sender report from the source.
    pub last_sender_report: i64 = 0
    /// The delay since that report in 65536ths of a second.
    pub delay_since_last_sender_report: i64 = 0
}

/// A sender report (RFC 3550 section 6.4.1).
pub struct SenderReport {
    /// The sender's synchronization source.
    pub ssrc: i64
    /// The whole seconds of the NTP timestamp.
    pub ntp_seconds: i64
    /// The fraction of a second of the NTP timestamp in 2^-32 seconds.
    pub ntp_fraction: i64
    /// The RTP timestamp that corresponds to the NTP timestamp.
    pub rtp_timestamp: i64
    /// The packets the sender has sent.
    pub packets: i64
    /// The payload octets the sender has sent.
    pub octets: i64
    /// The reception reports.
    pub reports: ReportBlock[] = []
}

/// A receiver report (RFC 3550 section 6.4.2).
pub struct ReceiverReport {
    /// The reporter's synchronization source.
    pub ssrc: i64
    /// The reception reports.
    pub reports: ReportBlock[] = []
}

/// One SDES item: a type and its text.
pub struct SdesItem {
    /// The item type, `sdes_cname` for the canonical name.
    pub kind: i64
    /// The value, at most 255 bytes.
    pub text: str
}

/// The items that describe one source.
pub struct SdesChunk {
    /// The source described, a synchronization or contributing source.
    pub ssrc: i64
    /// The items in wire order.
    pub items: SdesItem[]
}

/// A source description (RFC 3550 section 6.5).
pub struct SourceDescription {
    /// The chunks, at most 31.
    pub chunks: SdesChunk[]
}

/// A goodbye (RFC 3550 section 6.6).
pub struct Goodbye {
    /// The sources that leave, at most 31.
    pub sources: i64[]
    /// The reason, at most 255 bytes, or empty.
    pub reason: str = ""
}

/// A Generic NACK (RFC 4585 section 6.2.1) in its expanded form.
pub struct GenericNack {
    /// The source of the feedback.
    pub sender: i64
    /// The media source whose packets were lost.
    pub media: i64
    /// The sequence numbers of the lost packets. `marshal_rtcp` packs consecutive ones into a packet identifier and a 16-bit bitmask.
    pub lost: i64[]
}

/// A Picture Loss Indication (RFC 4585 section 6.3.1).
pub struct PictureLoss {
    /// The source of the feedback.
    pub sender: i64
    /// The media source whose picture was lost.
    pub media: i64
}

/// A feedback message other than Generic NACK and PLI, with its control information unparsed.
pub struct FeedbackMessage {
    /// `type_transport_feedback` or `type_payload_feedback`.
    pub kind: i64
    /// The 5-bit feedback message type.
    pub format: i64
    /// The source of the feedback.
    pub sender: i64
    /// The media source the feedback concerns.
    pub media: i64
    /// The feedback control information, a multiple of four bytes.
    pub fci: u8[]
}

/// A packet of a type this module does not read, kept as it came.
pub struct RawPacket {
    /// The packet type.
    pub kind: i64
    /// The 5-bit count or format field.
    pub count: i64
    /// The bytes after the 4-byte header, a multiple of four.
    pub body: u8[]
}

/// One RTCP packet.
pub enum Rtcp {
    /// A sender report.
    Sender(report: SenderReport)
    /// A receiver report.
    Receiver(report: ReceiverReport)
    /// A source description.
    Description(report: SourceDescription)
    /// A goodbye.
    Bye(report: Goodbye)
    /// A Generic NACK.
    Nack(report: GenericNack)
    /// A Picture Loss Indication.
    Pli(report: PictureLoss)
    /// A feedback message of another type.
    Feedback(report: FeedbackMessage)
    /// A packet of an unknown type.
    Other(report: RawPacket)
}

fn parse_blocks(body: u8[], at: i64, count: i64) -> ReportBlock[] ! io.Error {
    if body.len < at + 24 * count {
        fail Malformed
    }
    var out: ReportBlock[] = []
    for i in 0..count {
        let b = at + 24 * i
        var lost = io.be24(body, b + 5)
        if lost >= 0x800000 {
            lost -= 0x1000000
        }
        out.push(ReportBlock {
            ssrc: io.be32(body, b)
            fraction_lost: i64(body[b + 4])
            lost
            highest_sequence: io.be32(body, b + 8)
            jitter: io.be32(body, b + 12)
            last_sender_report: io.be32(body, b + 16)
            delay_since_last_sender_report: io.be32(body, b + 20)
        })
    }
    out
}

fn parse_description(body: u8[], count: i64) -> SourceDescription ! io.Error {
    var chunks: SdesChunk[] = []
    var at = 0
    for _ in 0..count {
        if body.len < at + 4 {
            fail Malformed
        }
        let ssrc = io.be32(body, at)
        at += 4
        var items: SdesItem[] = []
        for {
            if at >= body.len {
                fail Malformed
            }
            let kind = i64(body[at])
            if kind == 0 {
                at = (at + 4) / 4 * 4
                break
            }
            if at + 2 > body.len {
                fail Malformed
            }
            let size = i64(body[at + 1])
            if at + 2 + size > body.len {
                fail Malformed
            }
            items.push(SdesItem { kind, text: str(body[at + 2..at + 2 + size]) })
            at += 2 + size
        }
        chunks.push(SdesChunk { ssrc, items })
    }
    SourceDescription { chunks }
}

fn parse_goodbye(body: u8[], count: i64) -> Goodbye ! io.Error {
    if body.len < 4 * count {
        fail Malformed
    }
    var sources: i64[] = []
    for i in 0..count {
        sources.push(io.be32(body, 4 * i))
    }
    var reason = ""
    let at = 4 * count
    if body.len > at {
        let size = i64(body[at])
        if at + 1 + size > body.len {
            fail Malformed
        }
        reason = str(body[at + 1..at + 1 + size])
    }
    Goodbye { sources, reason }
}

fn parse_nack(body: u8[]) -> GenericNack ! io.Error {
    var lost: i64[] = []
    var at = 8
    for at + 4 <= body.len {
        let pid = io.be16(body, at)
        let mask = io.be16(body, at + 2)
        lost.push(pid)
        for bit in 0..16 {
            if (mask >> bit) & 1 != 0 {
                lost.push((pid + bit + 1) & 0xFFFF)
            }
        }
        at += 4
    }
    GenericNack { sender: io.be32(body, 0), media: io.be32(body, 4), lost }
}

fn parse_feedback(kind: i64, format: i64, body: u8[]) -> Rtcp ! io.Error {
    if body.len < 8 {
        fail Malformed
    }
    if kind == type_transport_feedback && format == 1 {
        return Rtcp.Nack(parse_nack(body)?)
    }
    if kind == type_payload_feedback && format == 1 && body.len == 8 {
        return Rtcp.Pli(PictureLoss { sender: io.be32(body, 0), media: io.be32(body, 4) })
    }
    Rtcp.Feedback(FeedbackMessage { kind, format, sender: io.be32(body, 0), media: io.be32(body, 4), fci: body[8..] })
}

fn parse_packet(kind: i64, count: i64, body: u8[]) -> Rtcp ! io.Error {
    if kind == type_sender_report {
        if body.len < 24 {
            fail Malformed
        }
        return Rtcp.Sender(SenderReport {
            ssrc: io.be32(body, 0)
            ntp_seconds: io.be32(body, 4)
            ntp_fraction: io.be32(body, 8)
            rtp_timestamp: io.be32(body, 12)
            packets: io.be32(body, 16)
            octets: io.be32(body, 20)
            reports: parse_blocks(body, 24, count)?
        })
    }
    if kind == type_receiver_report {
        if body.len < 4 {
            fail Malformed
        }
        return Rtcp.Receiver(ReceiverReport { ssrc: io.be32(body, 0), reports: parse_blocks(body, 4, count)? })
    }
    if kind == type_source_description {
        return Rtcp.Description(parse_description(body, count)?)
    }
    if kind == type_goodbye {
        return Rtcp.Bye(parse_goodbye(body, count)?)
    }
    if kind == type_transport_feedback || kind == type_payload_feedback {
        return parse_feedback(kind, count, body)
    }
    Rtcp.Other(RawPacket { kind, count, body })
}

/// Reads the RTCP packets of `data`, which must be exactly one compound packet or datagram.
///
/// Fails with `Malformed` when the version is not 2, a length runs past the end, a packet is shorter than its type needs, or the padding count is zero or larger than the packet. A packet of a type this module does not read becomes `Other`. Byte slices share the bytes of `data`.
pub fn parse_rtcp(data: u8[]) -> Rtcp[] ! io.Error {
    if data.len < 4 {
        fail Malformed
    }
    var out: Rtcp[] = []
    var at = 0
    for at < data.len {
        if data.len - at < 4 || data[at] >> 6 != 2 {
            fail Malformed
        }
        let end = at + 4 + 4 * io.be16(data, at + 2)
        if end > data.len {
            fail Malformed
        }
        var body = data[at + 4..end]
        if data[at] & 0x20 != 0 {
            let pad = if body.len > 0 { i64(body[body.len - 1]) } else { 0 }
            if pad == 0 || pad > body.len {
                fail Malformed
            }
            body = body[..body.len - pad]
        }
        out.push(parse_packet(i64(data[at + 1]), i64(data[at] & 0x1F), body)?)
        at = end
    }
    out
}

fn put_header(mut out: u8[], count: i64, kind: i64) -> i64 {
    out.push(u8(0x80 | count))
    out.push(u8(kind))
    io.put_be16(mut out, 0)
    out.len - 4
}

fn finish(mut out: u8[], start: i64) {
    io.set_be16(out, start + 2, (out.len - start) / 4 - 1)
}

fn put_blocks(mut out: u8[], reports: ReportBlock[]) {
    for r in reports {
        io.put_be32(mut out, r.ssrc)
        out.push(u8(r.fraction_lost))
        io.put_be24(mut out, r.lost & 0xFFFFFF)
        io.put_be32(mut out, r.highest_sequence)
        io.put_be32(mut out, r.jitter)
        io.put_be32(mut out, r.last_sender_report)
        io.put_be32(mut out, r.delay_since_last_sender_report)
    }
}

fn put_padded_text(mut out: u8[], start: i64) {
    for (out.len - start) % 4 != 0 {
        out.push(0)
    }
}

fn put_description(mut out: u8[], d: SourceDescription) ! io.Error {
    if d.chunks.len > 31 {
        fail Invalid
    }
    let start = put_header(mut out, d.chunks.len, type_source_description)
    for c in d.chunks {
        let chunk = out.len
        io.put_be32(mut out, c.ssrc)
        for item in c.items {
            if item.text.len > 255 || item.kind < 1 || item.kind > 255 {
                fail Invalid
            }
            out.push(u8(item.kind))
            out.push(u8(item.text.len))
            io.append(mut out, bytes(item.text))
        }
        out.push(0)
        put_padded_text(mut out, chunk)
    }
    finish(mut out, start)
}

fn put_goodbye(mut out: u8[], g: Goodbye) ! io.Error {
    if g.sources.len > 31 || g.reason.len > 255 {
        fail Invalid
    }
    let start = put_header(mut out, g.sources.len, type_goodbye)
    for s in g.sources {
        io.put_be32(mut out, s)
    }
    if g.reason.len > 0 {
        let text = out.len
        out.push(u8(g.reason.len))
        io.append(mut out, bytes(g.reason))
        put_padded_text(mut out, text)
    }
    finish(mut out, start)
}

fn put_nack(mut out: u8[], n: GenericNack) ! io.Error {
    if n.lost.len == 0 {
        fail Invalid
    }
    let start = put_header(mut out, 1, type_transport_feedback)
    io.put_be32(mut out, n.sender)
    io.put_be32(mut out, n.media)
    var i = 0
    for i < n.lost.len {
        let pid = n.lost[i] & 0xFFFF
        var mask = 0
        i += 1
        for i < n.lost.len {
            let delta = (n.lost[i] - pid) & 0xFFFF
            if delta < 1 || delta > 16 {
                break
            }
            mask |= 1 << (delta - 1)
            i += 1
        }
        io.put_be16(mut out, pid)
        io.put_be16(mut out, mask)
    }
    finish(mut out, start)
}

fn put_packet(mut out: u8[], p: Rtcp) ! io.Error {
    match p {
        Sender(r) => {
            if r.reports.len > 31 {
                fail Invalid
            }
            let start = put_header(mut out, r.reports.len, type_sender_report)
            io.put_be32(mut out, r.ssrc)
            io.put_be32(mut out, r.ntp_seconds)
            io.put_be32(mut out, r.ntp_fraction)
            io.put_be32(mut out, r.rtp_timestamp)
            io.put_be32(mut out, r.packets)
            io.put_be32(mut out, r.octets)
            put_blocks(mut out, r.reports)
            finish(mut out, start)
        }
        Receiver(r) => {
            if r.reports.len > 31 {
                fail Invalid
            }
            let start = put_header(mut out, r.reports.len, type_receiver_report)
            io.put_be32(mut out, r.ssrc)
            put_blocks(mut out, r.reports)
            finish(mut out, start)
        }
        Description(d) => put_description(mut out, d)?
        Bye(g) => put_goodbye(mut out, g)?
        Nack(n) => put_nack(mut out, n)?
        Pli(l) => {
            let start = put_header(mut out, 1, type_payload_feedback)
            io.put_be32(mut out, l.sender)
            io.put_be32(mut out, l.media)
            finish(mut out, start)
        }
        Feedback(f) => {
            if f.fci.len % 4 != 0 || f.format < 0 || f.format > 31 {
                fail Invalid
            }
            let start = put_header(mut out, f.format, f.kind)
            io.put_be32(mut out, f.sender)
            io.put_be32(mut out, f.media)
            io.append(mut out, f.fci)
            finish(mut out, start)
        }
        Other(o) => {
            if o.body.len % 4 != 0 || o.count < 0 || o.count > 31 {
                fail Invalid
            }
            let start = put_header(mut out, o.count, o.kind)
            io.append(mut out, o.body)
            finish(mut out, start)
        }
    }
}

/// Returns the wire form of the compound packet `packets`.
///
/// Fails with `Invalid` when a count exceeds its 5-bit field, a text exceeds 255 bytes, a Generic NACK lists no packet, or a body is not a multiple of four bytes. Padding is never added.
pub fn marshal_rtcp(packets: Rtcp[]) -> u8[] ! io.Error {
    var out: u8[] = []
    for p in packets {
        put_packet(mut out, p)?
    }
    out
}
