/// What a datagram on a socket shared by ICE, DTLS and media is, by the rules of RFC 7983 and RFC 5761.
pub enum Kind {
    /// A STUN message, first byte 0 to 3.
    Stun
    /// A DTLS record, first byte 20 to 63.
    Dtls
    /// An RTP packet, first byte 128 to 191 with a packet type outside 192 to 223.
    Rtp
    /// An RTCP packet, first byte 128 to 191 with a packet type of 192 to 223.
    Rtcp
    /// Anything else, including TURN channel data and ZRTP.
    Unknown
}

/// Returns what `datagram` is.
pub fn classify(datagram: u8[]) -> Kind {
    if datagram.len == 0 {
        return Kind.Unknown
    }
    let first = datagram[0]
    if first < 4 {
        return Kind.Stun
    }
    if first >= 20 && first <= 63 {
        return Kind.Dtls
    }
    if first >= 128 && first <= 191 {
        if datagram.len >= 2 && datagram[1] >= 192 && datagram[1] <= 223 {
            return Kind.Rtcp
        }
        return Kind.Rtp
    }
    Kind.Unknown
}
