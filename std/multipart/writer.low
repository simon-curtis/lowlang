import std/crypto
import std/header
import std/io
import std/text

/// Builds a multipart body in memory.
///
/// Made by `writer` or `writer_with`. Add parts, then call `finish` for the body and `content_type` for the header that goes with it.
pub struct Writer {
    boundary: str
    out: []u8
    generated: bool
    finished: bool
}

/// Returns a writer with a random 48-character boundary.
///
/// The boundary is random, so the data of a part is not searched for it.
pub fn writer() -> *Writer {
    let boundary = text.encode_hex(crypto.random(24))
    new(Writer { boundary, out: [], generated: true, finished: false })
}

/// Returns a writer that uses `boundary`.
///
/// Fails with `BadBoundary` when it is invalid. `write_part` then fails with `BoundaryInData` for data that contains the boundary.
pub fn writer_with(boundary: str) -> *Writer ! Error {
    check_boundary(boundary)?
    new(Writer { boundary, out: [], generated: false, finished: false })
}

/// Returns the boundary of the writer.
pub fn boundary(w: *Writer) -> str {
    w.boundary
}

/// Returns the `multipart/form-data` content type with the boundary of the writer.
pub fn content_type(w: *Writer) -> str {
    content_type_as(w, "form-data")
}

/// Returns the `multipart/` content type with `subtype` and the boundary of the writer.
///
/// The boundary is quoted when it holds a byte that is not allowed in a bare token.
pub fn content_type_as(w: *Writer, subtype: str) -> str {
    for i in 0..w.boundary.len {
        if !header.token_byte(w.boundary[i]) {
            return "multipart/{subtype}; boundary={header.quote(w.boundary)}"
        }
    }
    "multipart/{subtype}; boundary={w.boundary}"
}

/// Adds a part with `headers` and `data`.
///
/// Fails with `Finished` after `finish`, with `InvalidHeader` for a header that is not valid, and with `BoundaryInData` when the boundary was chosen and the data contains it. Nothing is added when it fails.
pub fn write_part(w: *Writer, headers: []header.Header, data: []u8) ! Error {
    if w.finished {
        fail Error.Finished
    }
    for h in headers {
        if !header.valid(h) {
            fail Error.InvalidHeader
        }
    }
    if !w.generated && text.contains(__str_view(data), "--{w.boundary}") {
        fail Error.BoundaryInData
    }
    text.append(mut w.out, "--{w.boundary}\r\n")
    for h in headers {
        text.append(mut w.out, "{h.name}: {h.value}\r\n")
    }
    text.append(mut w.out, "\r\n")
    io.append(mut w.out, data)
    text.append(mut w.out, "\r\n")
}

/// Adds a `form-data` text field called `name`.
///
/// Fails like `write_part`.
pub fn write_field(w: *Writer, name: str, value: str) ! Error {
    write_form_part(w, name, none, "", bytes(value))?
}

/// Adds a `form-data` file field with a `filename` and `content_type`, which defaults to `application/octet-stream` when empty.
///
/// Fails like `write_part`.
pub fn write_file(w: *Writer, name: str, filename: str, content_type: str, data: []u8) ! Error {
    write_form_part(w, name, some(filename), content_type, data)?
}

/// Adds a `form-data` part called `name` with `data`, as `write_field` and `write_file` do.
///
/// A `filename` of `none` makes a plain field, which has a `Content-Type` only when `content_type` is not empty. A file name makes a file field, whose `content_type` defaults to `application/octet-stream` when empty. Fails like `write_part`.
pub fn write_form_part(w: *Writer, name: str, filename: str?, content_type: str, data: []u8) ! Error {
    var disposition = "form-data; name={header.quote(name)}"
    var kind = content_type
    match filename {
        some(f) => {
            disposition = "{disposition}; filename={header.quote(f)}"
            if kind == "" {
                kind = "application/octet-stream"
            }
        }
        none => {}
    }
    var fields: []header.Header = []
    header.add(mut fields, "Content-Disposition", disposition)
    if kind != "" {
        header.add(mut fields, "Content-Type", kind)
    }
    write_part(w, fields, data)?
}

/// Ends the body with the closing boundary and returns it.
///
/// It is safe to call again, and returns the same bytes. Adding a part afterwards fails with `Finished`.
pub fn finish(w: *Writer) -> []u8 {
    if !w.finished {
        text.append(mut w.out, "--{w.boundary}--\r\n")
        w.finished = true
    }
    w.out
}
