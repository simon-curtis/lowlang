import std/arrow
import std/file
import std/parquet
import std/path

fn run() ! parquet.Error {
    let schema = arrow.Schema { fields: [
        arrow.Field { name: "city", data_type: arrow.DataType.Utf8, nullable: false },
        arrow.Field { name: "people", data_type: arrow.DataType.Int(32, true) },
        arrow.Field { name: "area", data_type: arrow.DataType.Decimal(8, 2) },
    ] }
    let rows = [
        [parquet.Value.Text("Lyon"), parquet.Value.Int(522250), parquet.Value.Decimal("47.87")],
        [parquet.Value.Text("Nice"), parquet.Value.Null, parquet.Value.Decimal("71.92")],
        [parquet.Value.Text("Metz"), parquet.Value.Int(118634), parquet.Value.Null],
    ]
    let dir = file.temp_dir("low-parquet") catch {
        e => fail parquet.Error.Io(e)
    }
    let target = path.join([dir, "cities.parquet"])
    let data = parquet.write_rows(schema, rows, parquet.WriterOptions { compression: parquet.Codec.Gzip })?
    file.write_file(target, data) catch {
        e => fail parquet.Error.Io(e)
    }

    let f = parquet.open(target, parquet.ReaderOptions {})?
    for row in parquet.read_rows(f, [])? {
        var parts: []str = []
        for v in row {
            push(mut parts, parquet.diagnostic(v))
        }
        print("{parts[0]} {parts[1]} {parts[2]}")
    }
    file.remove(target) catch {
        e => fail parquet.Error.Io(e)
    }
    file.remove_dir(dir) catch {
        e => fail parquet.Error.Io(e)
    }
}

fn main() {
    run() catch {
        e => print(parquet.message(e))
    }
}
