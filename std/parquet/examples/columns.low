import std/arrow
import std/io
import std/parquet
import std/text

fn build() -> arrow.Batch ! arrow.Error {
    let ids = arrow.builder(arrow.DataType.Int(64, true))?
    let names = arrow.builder(arrow.DataType.Utf8)?
    let tag_item = new(arrow.Field { name: "element", data_type: arrow.DataType.Utf8 })
    let tags = arrow.builder(arrow.DataType.List(tag_item))?
    let tag_values = arrow.child(tags, 0)?

    arrow.append_int(ids, 1)?
    arrow.append_str(names, "ada")?
    arrow.append_str(tag_values, "math")?
    arrow.append_str(tag_values, "engines")?
    arrow.end_list(tags)?

    arrow.append_int(ids, 2)?
    arrow.append_null(names)?
    arrow.append_null(tags)?

    arrow.append_int(ids, 3)?
    arrow.append_str(names, "grace")?
    arrow.end_list(tags)?

    let schema = arrow.Schema { fields: [
        arrow.Field { name: "id", data_type: arrow.DataType.Int(64, true), nullable: false },
        arrow.Field { name: "name", data_type: arrow.DataType.Utf8 },
        arrow.Field { name: "tags", data_type: arrow.DataType.List(tag_item) },
    ] }
    let columns = [arrow.finish(ids)?, arrow.finish(names)?, arrow.finish(tags)?]
    arrow.Batch { schema, length: 3, columns }
}

fn run() ! parquet.Error {
    let batch = build() catch {
        e => fail parquet.Error.Mismatch(arrow.message(e))
    }
    let options = parquet.WriterOptions { compression: parquet.Codec.Zstd, row_group_rows: 2 }
    let data = parquet.write_bytes(batch.schema, [batch], options)?
    print("file starts with {str(data[..4])} and is non-empty: {data.len > 0}")

    let f = parquet.open_bytes(data, parquet.ReaderOptions {})?
    let md = parquet.metadata(f)
    print("{md.num_rows} rows in {md.row_groups.len} row groups, written by {md.created_by}")
    for c in parquet.columns(f) {
        print("leaf {text.join(c.path, ".")} max definition {c.max_def} max repetition {c.max_rep}")
    }
    for g, rg in md.row_groups {
        let chunk = rg.columns[0]
        let low = if chunk.statistics.has_range { "{io.le64(chunk.statistics.min, 0)}" } else { "none" }
        print("group {g}: {rg.num_rows} rows, ids from {low}")
    }
    let picked = parquet.select_row_groups(f, "id", 3, 10)?
    print("groups that may hold an id from 3 to 10: {picked.len}")
    for b in parquet.read_batches(f, ["name", "tags"])? {
        for c in b.columns {
            print(arrow.diagnostic(c))
        }
    }
}

fn main() {
    run() catch {
        e => print(parquet.message(e))
    }
}
