import std/arrow
import std/io

/// The error returned by reading and writing Parquet files.
pub enum Error {
    /// The input is not a valid Parquet file. `at` is the file offset of the offending bytes, or `-1` when the problem is in a value that has no offset, and `message` says what is wrong.
    Invalid(at: i64, message: str)
    /// The file or a page ends before the bytes its metadata promises. `at` is the offset where bytes were missing.
    Truncated(at: i64)
    /// A length, count or nesting depth in the input exceeds a limit. `message` names it.
    TooLarge(message: str)
    /// The file uses a feature this module does not implement, `feature`.
    Unsupported(feature: str)
    /// A value, schema or option does not fit what it is given to; `message` says why.
    Mismatch(message: str)
    /// The CRC-32 of the page that starts at `at` does not match the page.
    Checksum(at: i64)
    /// Reading or writing the file failed.
    Io(error: io.Error)
}

/// Returns a one-line description of `e`.
pub fn message(e: Error) -> str {
    match e {
        Invalid(at, m) => if at >= 0 { "{m} at offset {at}" } else { m }
        Truncated(at) => "input ends at offset {at}"
        TooLarge(m) => "{m} exceeds a limit"
        Unsupported(f) => "unsupported: {f}"
        Mismatch(m) => "does not fit: {m}"
        Checksum(at) => "page checksum mismatch at offset {at}"
        Io(error) => "i/o error: {error}"
    }
}

/// How a leaf column stores its values.
pub enum Physical {
    /// One bit per value.
    Boolean = 0
    /// A 32-bit little-endian integer.
    Int32 = 1
    /// A 64-bit little-endian integer.
    Int64 = 2
    /// A 96-bit timestamp of nanoseconds in the day then a Julian day number.
    Int96 = 3
    /// A 32-bit IEEE float.
    Float = 4
    /// A 64-bit IEEE float.
    Double = 5
    /// Bytes of any length.
    ByteArray = 6
    /// Bytes of the fixed length the column declares.
    FixedLenByteArray = 7
}

/// Whether a field is always present, may be absent, or repeats.
pub enum Repetition {
    /// Exactly one value.
    Required = 0
    /// Zero or one value.
    Optional = 1
    /// Any number of values.
    Repeated = 2
}

/// The compression of a column chunk's pages.
pub enum Codec {
    /// Stored as they are.
    Uncompressed = 0
    /// Snappy block format.
    Snappy = 1
    /// A gzip stream.
    Gzip = 2
    /// LZO, which this module does not read.
    Lzo = 3
    /// A Brotli stream.
    Brotli = 4
    /// The deprecated Hadoop-framed LZ4, which this module does not read.
    Lz4 = 5
    /// A Zstandard frame.
    Zstd = 6
    /// A raw LZ4 block.
    Lz4Raw = 7
}

/// How the values of a page are encoded.
pub enum Encoding {
    /// Values back to back in their physical layout.
    Plain = 0
    /// A dictionary page encoded as `Plain`, the form version 1 files give `RleDictionary` pages.
    PlainDictionary = 2
    /// Run-length and bit-packed hybrid.
    Rle = 3
    /// The deprecated bit-packed level encoding.
    BitPacked = 4
    /// Deltas of integers in bit-packed miniblocks.
    DeltaBinaryPacked = 5
    /// The lengths of byte arrays as `DeltaBinaryPacked`, then their bytes.
    DeltaLengthByteArray = 6
    /// Prefix lengths and suffixes of byte arrays.
    DeltaByteArray = 7
    /// Indices into a dictionary page as `Rle`.
    RleDictionary = 8
    /// The bytes of floats split by significance.
    ByteStreamSplit = 9
}

/// The meaning a column's values carry beyond their physical type.
pub enum Logical {
    /// Only the physical type.
    None
    /// UTF-8 text in a byte array.
    String
    /// An enumeration name as UTF-8 text.
    Enum
    /// A 16-byte UUID.
    Uuid
    /// JSON text in a byte array.
    Json
    /// BSON in a byte array.
    Bson
    /// A half-precision float in two bytes.
    Float16
    /// Days since the Unix epoch in an `Int32`.
    Date
    /// An integer of `bits` 8, 16, 32 or 64, `signed` or not.
    Int(bits: i64, signed: bool)
    /// A decimal of `precision` digits with `scale` of them after the point.
    Decimal(precision: i64, scale: i64)
    /// A time of day in `unit`; `utc` says whether it is adjusted to UTC.
    Time(unit: arrow.TimeUnit, utc: bool)
    /// A count of `unit` since the Unix epoch; `utc` says whether it is adjusted to UTC.
    Timestamp(unit: arrow.TimeUnit, utc: bool)
    /// A 12-byte interval of months, days and milliseconds.
    Interval
    /// A column whose values are all null, whatever its physical type.
    Unknown
}

/// The nested shape a group carries.
pub enum Shape {
    /// A plain group, read as a struct, or a leaf.
    Plain
    /// A list, whose element is the group's repeated child or that child's only field.
    List
    /// A map of the key and the value of its repeated child.
    Map
}

/// A field of the schema: a leaf with a physical type or a group of children.
pub struct Node {
    /// The field name.
    pub name: str
    /// Whether the field is required, optional or repeated.
    pub repetition: Repetition = Repetition.Required
    /// The physical type of a leaf. Unused by a group.
    pub physical: Physical = Physical.Int32
    /// The byte width of a `FixedLenByteArray` leaf.
    pub length: i64 = 0
    /// The logical type of a leaf.
    pub logical: Logical = Logical.None
    /// The shape of a group.
    pub shape: Shape = Shape.Plain
    /// Whether the field is a leaf.
    pub leaf: bool = true
    /// The fields of a group.
    pub children: Node[] = []
    /// The field id, or `-1` when absent.
    pub field_id: i64 = -1
    /// The number of optional and repeated fields on the path to this field, including itself.
    pub def_level: i64 = 0
    /// The number of repeated fields on the path to this field, including itself.
    pub rep_level: i64 = 0
}

/// The schema of a file: the top-level fields under an unnamed root.
pub struct Schema {
    /// The top-level fields.
    pub fields: Node[]
}

/// A leaf column of the schema.
pub struct Column {
    /// The position among the leaf columns, in file order.
    pub index: i64
    /// The field names from the top level to the leaf.
    pub path: str[]
    /// The leaf field.
    pub node: Node
    /// The largest definition level, the number of optional and repeated fields on the path.
    pub max_def: i64
    /// The largest repetition level, the number of repeated fields on the path.
    pub max_rep: i64
}

/// Minimum, maximum and counts a writer recorded for a column chunk.
pub struct Statistics {
    /// Whether `min` and `max` are present. The range comes from `min_value` and `max_value` when the file declares a type-defined column order for the column, and otherwise from the older `min` and `max` for boolean, signed integer and floating point columns. Other ranges are dropped because their ordering is not defined.
    pub has_range: bool = false
    /// The smallest value in the column's plain encoding (little-endian for numbers, raw bytes for byte arrays).
    pub min: u8[] = []
    /// The largest value in the same encoding.
    pub max: u8[] = []
    /// The number of nulls, or `-1` when not recorded.
    pub null_count: i64 = -1
    /// The number of distinct values, or `-1` when not recorded.
    pub distinct_count: i64 = -1
}

/// A column chunk of a row group.
pub struct ColumnChunk {
    /// The field names from the top level to the leaf.
    pub path: str[]
    /// The physical type.
    pub physical: Physical
    /// The compression of the chunk's pages.
    pub codec: Codec
    /// The encodings of the chunk's pages.
    pub encodings: Encoding[]
    /// The number of values, nulls included.
    pub num_values: i64
    /// The size of the chunk's pages in the file, headers included.
    pub total_compressed: i64
    /// The size of the chunk's pages once decompressed, headers included.
    pub total_uncompressed: i64
    /// The file offset of the first data page.
    pub data_page_offset: i64
    /// The file offset of the dictionary page, or `-1` for none.
    pub dictionary_page_offset: i64 = -1
    /// The statistics, empty when the writer gave none.
    pub statistics: Statistics = Statistics {}
}

/// A set of rows stored together, one column chunk per leaf column.
pub struct RowGroup {
    /// The number of rows.
    pub num_rows: i64
    /// The size of the row group's column chunks once decompressed.
    pub total_byte_size: i64
    /// The column chunks in leaf column order.
    pub columns: ColumnChunk[]
}

/// The footer of a file.
pub struct Metadata {
    /// The format version.
    pub version: i64
    /// The schema.
    pub schema: Schema
    /// The number of rows in the file.
    pub num_rows: i64
    /// The row groups.
    pub row_groups: RowGroup[]
    /// Key and value metadata of the file.
    pub key_value: [str: str] = [:]
    /// The name of the writer that produced the file.
    pub created_by: str = ""
}

/// A value of a row.
pub enum Value {
    /// An absent value.
    Null
    /// A boolean.
    Bool(v: bool)
    /// A signed integer, a date, a time, a timestamp or a duration in its unit.
    Int(v: i64)
    /// An unsigned 64-bit integer.
    Uint(v: u64)
    /// A float of any width.
    Float(v: f64)
    /// A decimal as text.
    Decimal(text: str)
    /// UTF-8 text.
    Text(v: str)
    /// Bytes.
    Bytes(v: u8[])
    /// The elements of a list.
    List(items: Value[])
    /// The values of a struct in field order.
    Struct(fields: Value[])
    /// The keys and values of a map, in order.
    Map(keys: Value[], values: Value[])
}
