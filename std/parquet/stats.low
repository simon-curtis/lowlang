import std/io
import std/text

fn raw_at(v: Values, k: i64) -> u8[] {
    match v.physical {
        ByteArray => v.data[v.offsets[k]..v.offsets[k + 1]]
        _ => {
            let w = fixed_width(v.physical, v.length)
            v.fixed[k * w..(k + 1) * w]
        }
    }
}

fn signed_word(raw: u8[], width: i64) -> i64 {
    if width == 4 {
        let v = io.le32(raw, 0) & 0xFFFFFFFF
        if v < 2147483648 {
            return v
        }
        return v - 4294967296
    }
    io.le64(raw, 0)
}

fn compare_bytes(a: u8[], b: u8[], signed_lead: bool) -> i64 {
    let common = if a.len < b.len { a.len } else { b.len }
    for k in 0..common {
        var x = i64(a[k])
        var y = i64(b[k])
        if k == 0 && signed_lead {
            x = if x >= 128 { x - 256 } else { x }
            y = if y >= 128 { y - 256 } else { y }
        }
        if x != y {
            return if x < y { -1 } else { 1 }
        }
    }
    if a.len == b.len {
        return 0
    }
    if a.len < b.len { -1 } else { 1 }
}

fn float_width(node: Node) -> i64 {
    match node.physical {
        Float => 4
        Double => 8
        FixedLenByteArray => if is_float16(node) { 2 } else { 0 }
        _ => 0
    }
}

fn half_value(raw: u8[]) -> f64 {
    let bits = io.u16_le(raw, 0)
    let sign = u64(bits >> 15) << 63
    let exponent = (bits >> 10) & 31
    let fraction = bits & 1023
    if exponent == 0 {
        let magnitude = f64(fraction) * 5.960464477539063e-8
        return if sign != 0 { -magnitude } else { magnitude }
    }
    if exponent == 31 {
        let payload = u64(fraction) << 42
        return text.float_from_bits(sign | 0x7FF0000000000000 | payload)
    }
    text.float_from_bits(sign | u64(exponent + 1008) << 52 | u64(fraction) << 42)
}

fn float_of(width: i64, raw: u8[]) -> f64 {
    match width {
        == 2 => half_value(raw)
        == 4 => f64(text.float32_from_bits(u32(io.le32(raw, 0))))
        _ => text.float_from_bits(u64(io.le64(raw, 0)))
    }
}

fn order_of(node: Node, a: u8[], b: u8[]) -> i64 {
    match node.physical {
        Boolean => i64(a[0]) - i64(b[0])
        Int32 => compare_integers(node, a, b, 4)
        Int64 => compare_integers(node, a, b, 8)
        Float => compare_floats(4, a, b)
        Double => compare_floats(8, a, b)
        ByteArray => compare_bytes(a, b, false)
        _ => {
            match node.logical {
                Decimal(_, _) => compare_bytes(a, b, true)
                Float16 => compare_floats(2, a, b)
                _ => compare_bytes(a, b, false)
            }
        }
    }
}

fn compare_integers(node: Node, a: u8[], b: u8[], width: i64) -> i64 {
    if unsigned_logical(node) {
        let x = u64(unsigned_word(a, width))
        let y = u64(unsigned_word(b, width))
        if x == y {
            return 0
        }
        return if x < y { -1 } else { 1 }
    }
    let x = signed_word(a, width)
    let y = signed_word(b, width)
    if x == y {
        return 0
    }
    if x < y { -1 } else { 1 }
}

fn unsigned_word(raw: u8[], width: i64) -> i64 {
    if width == 4 {
        return io.le32(raw, 0) & 0xFFFFFFFF
    }
    io.le64(raw, 0)
}

fn compare_floats(width: i64, a: u8[], b: u8[]) -> i64 {
    let x = float_of(width, a)
    let y = float_of(width, b)
    if x == y {
        return 0
    }
    if x < y { -1 } else { 1 }
}

fn is_nan_value(width: i64, raw: u8[]) -> bool {
    if width == 0 {
        return false
    }
    let x = float_of(width, raw)
    x != x
}

fn zero_bytes(width: i64, negative: bool) -> u8[] {
    match width {
        == 2 => little_bytes(if negative { 0x8000 } else { 0 }, 2)
        == 4 => little_bytes(if negative { 0x80000000 } else { 0 }, 4)
        _ => little_bytes(if negative { i64(1) << 63 } else { 0 }, 8)
    }
}

fn is_zero_value(width: i64, raw: u8[]) -> bool {
    width != 0 && float_of(width, raw) == 0.0
}

fn column_statistics(node: Node, v: Values, nulls: i64) -> Statistics {
    var s = Statistics { null_count: nulls }
    if node.physical == Physical.Int96 {
        return s
    }
    let width = float_width(node)
    var low: u8[] = []
    var high: u8[] = []
    var found = false
    for k in 0..v.count {
        let raw = raw_at(v, k)
        if is_nan_value(width, raw) {
            continue
        }
        if !found {
            low = raw
            high = raw
            found = true
            continue
        }
        if order_of(node, raw, low) < 0 {
            low = raw
        }
        if order_of(node, raw, high) > 0 {
            high = raw
        }
    }
    if !found {
        return s
    }
    if is_zero_value(width, low) {
        low = zero_bytes(width, true)
    }
    if is_zero_value(width, high) {
        high = zero_bytes(width, false)
    }
    s.has_range = true
    s.min = low
    s.max = high
    s
}

fn is_float16(node: Node) -> bool {
    match node.logical {
        Float16 => true
        _ => false
    }
}
