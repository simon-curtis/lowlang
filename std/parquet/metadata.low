import std/arrow
import std/io

const max_children = 1 << 20

fn physical_of(n: i64, at: i64) -> Physical ! Error {
    match n {
        == 0 => Physical.Boolean
        == 1 => Physical.Int32
        == 2 => Physical.Int64
        == 3 => Physical.Int96
        == 4 => Physical.Float
        == 5 => Physical.Double
        == 6 => Physical.ByteArray
        == 7 => Physical.FixedLenByteArray
        _ => fail Invalid(at, "the physical type {n} is not defined")
    }
}

fn repetition_of(n: i64, at: i64) -> Repetition ! Error {
    match n {
        == 0 => Repetition.Required
        == 1 => Repetition.Optional
        == 2 => Repetition.Repeated
        _ => fail Invalid(at, "the repetition {n} is not defined")
    }
}

fn codec_of(n: i64, at: i64) -> Codec ! Error {
    match n {
        == 0 => Codec.Uncompressed
        == 1 => Codec.Snappy
        == 2 => Codec.Gzip
        == 3 => Codec.Lzo
        == 4 => Codec.Brotli
        == 5 => Codec.Lz4
        == 6 => Codec.Zstd
        == 7 => Codec.Lz4Raw
        _ => fail Invalid(at, "the codec {n} is not defined")
    }
}

fn encoding_of(n: i64, at: i64) -> Encoding ! Error {
    match n {
        == 0 => Encoding.Plain
        == 2 => Encoding.PlainDictionary
        == 3 => Encoding.Rle
        == 4 => Encoding.BitPacked
        == 5 => Encoding.DeltaBinaryPacked
        == 6 => Encoding.DeltaLengthByteArray
        == 7 => Encoding.DeltaByteArray
        == 8 => Encoding.RleDictionary
        == 9 => Encoding.ByteStreamSplit
        _ => fail Invalid(at, "the encoding {n} is not defined")
    }
}

fn unit_of(fields: TField[]) -> arrow.TimeUnit {
    let unit = get_struct(fields, 2)
    if has_field(unit, 3) {
        return arrow.TimeUnit.Nanosecond
    }
    if has_field(unit, 2) {
        return arrow.TimeUnit.Microsecond
    }
    arrow.TimeUnit.Millisecond
}

fn logical_of(fields: TField[]) -> Logical {
    if has_field(fields, 1) {
        return Logical.String
    }
    if has_field(fields, 4) {
        return Logical.Enum
    }
    if has_field(fields, 5) {
        let d = get_struct(fields, 5)
        return Logical.Decimal(get_int(d, 2, 0), get_int(d, 1, 0))
    }
    if has_field(fields, 6) {
        return Logical.Date
    }
    if has_field(fields, 7) {
        let t = get_struct(fields, 7)
        return Logical.Time(unit_of(t), get_bool(t, 1, false))
    }
    if has_field(fields, 8) {
        let t = get_struct(fields, 8)
        return Logical.Timestamp(unit_of(t), get_bool(t, 1, false))
    }
    if has_field(fields, 10) {
        let i = get_struct(fields, 10)
        return Logical.Int(get_int(i, 1, 32), get_bool(i, 2, true))
    }
    if has_field(fields, 11) {
        return Logical.Unknown
    }
    if has_field(fields, 12) {
        return Logical.Json
    }
    if has_field(fields, 13) {
        return Logical.Bson
    }
    if has_field(fields, 14) {
        return Logical.Uuid
    }
    if has_field(fields, 15) {
        return Logical.Float16
    }
    Logical.None
}

fn is_none(l: Logical) -> bool {
    match l {
        None => true
        _ => false
    }
}

fn logical_from_converted(c: i64, precision: i64, scale: i64) -> Logical {
    match c {
        == 0 => Logical.String
        == 4 => Logical.Enum
        == 5 => Logical.Decimal(precision, scale)
        == 6 => Logical.Date
        == 7 => Logical.Time(arrow.TimeUnit.Millisecond, true)
        == 8 => Logical.Time(arrow.TimeUnit.Microsecond, true)
        == 9 => Logical.Timestamp(arrow.TimeUnit.Millisecond, true)
        == 10 => Logical.Timestamp(arrow.TimeUnit.Microsecond, true)
        == 11 => Logical.Int(8, false)
        == 12 => Logical.Int(16, false)
        == 13 => Logical.Int(32, false)
        == 14 => Logical.Int(64, false)
        == 15 => Logical.Int(8, true)
        == 16 => Logical.Int(16, true)
        == 17 => Logical.Int(32, true)
        == 18 => Logical.Int(64, true)
        == 19 => Logical.Json
        == 20 => Logical.Bson
        == 21 => Logical.Interval
        _ => Logical.None
    }
}

fn shape_of(converted: i64, logical: TField[]) -> Shape {
    if converted == 3 || has_field(logical, 3) {
        return Shape.List
    }
    if converted == 1 || converted == 2 || has_field(logical, 2) {
        return Shape.Map
    }
    Shape.Plain
}

struct Cursor {
    items: Thrift[]
    next: i64
}

fn read_node(c: *Cursor, parent_def: i64, parent_rep: i64, depth: i64) -> Node ! Error {
    if depth > max_depth {
        fail TooLarge("schema nesting")
    }
    if c.next >= c.items.len {
        fail Invalid(-1, "the schema ends before its last group's children")
    }
    let e = as_struct(c.items[c.next])
    c.next += 1
    let name = get_text(e, 4)
    let converted = get_int(e, 6, -1)
    let logical_fields = get_struct(e, 10)
    let children = get_int(e, 5, 0)
    let repetition = repetition_of(get_int(e, 3, 0), -1)?
    var def = parent_def
    var rep = parent_rep
    if repetition == Repetition.Optional {
        def += 1
    }
    if repetition == Repetition.Repeated {
        def += 1
        rep += 1
    }
    if has_field(e, 1) {
        var logical = logical_of(logical_fields)
        if is_none(logical) && converted >= 0 {
            logical = logical_from_converted(converted, get_int(e, 8, 0), get_int(e, 7, 0))
        }
        return Node {
            name
            repetition
            physical: physical_of(get_int(e, 1, 0), -1)?
            length: get_int(e, 2, 0)
            logical
            field_id: get_int(e, 9, -1)
            def_level: def
            rep_level: rep
        }
    }
    if children < 0 || children > max_children || children > c.items.len - c.next {
        fail Invalid(-1, "a schema group claims {children} children")
    }
    var kids: Node[] = []
    for _ in 0..children {
        let k = read_node(c, def, rep, depth + 1)?
        kids.push(k)
    }
    Node {
        name
        repetition
        shape: shape_of(converted, logical_fields)
        leaf: false
        children: kids
        field_id: get_int(e, 9, -1)
        def_level: def
        rep_level: rep
    }
}

fn read_schema(items: Thrift[]) -> Schema ! Error {
    if items.len == 0 {
        fail Invalid(-1, "the file has no schema")
    }
    let c = new(Cursor { items, next: 0 })
    let root = as_struct(items[0])
    let count = get_int(root, 5, 0)
    c.next = 1
    if count < 0 || count > items.len - 1 {
        fail Invalid(-1, "the schema root claims {count} children")
    }
    var fields: Node[] = []
    for _ in 0..count {
        let n = read_node(c, 0, 0, 1)?
        fields.push(n)
    }
    if c.next != items.len {
        fail Invalid(-1, "the schema has elements after its last field")
    }
    Schema { fields }
}

fn signed_order(n: Node) -> bool {
    match n.physical {
        Boolean => true
        Int32 => !unsigned_logical(n)
        Int64 => !unsigned_logical(n)
        Float => true
        Double => true
        _ => false
    }
}

fn unsigned_logical(n: Node) -> bool {
    match n.logical {
        Int(_, signed) => !signed
        _ => false
    }
}

fn read_statistics(fields: TField[], node: Node, ordered: bool) -> Statistics {
    if fields.len == 0 {
        return Statistics {}
    }
    var s = Statistics { null_count: get_int(fields, 3, -1), distinct_count: get_int(fields, 4, -1) }
    if ordered && has_field(fields, 6) && has_field(fields, 5) {
        s.has_range = true
        s.min = get_bytes(fields, 6)
        s.max = get_bytes(fields, 5)
    } else if signed_order(node) && has_field(fields, 2) && has_field(fields, 1) {
        s.has_range = true
        s.min = get_bytes(fields, 2)
        s.max = get_bytes(fields, 1)
    }
    s
}

fn read_chunk(v: Thrift, node: Node, ordered: bool) -> ColumnChunk ! Error {
    let chunk = as_struct(v)
    if has_field(chunk, 8) || has_field(chunk, 9) {
        fail Unsupported("an encrypted column")
    }
    let m = get_struct(chunk, 3)
    if m.len == 0 {
        fail Invalid(-1, "a column chunk has no metadata")
    }
    if has_field(chunk, 1) {
        fail Unsupported("a column chunk stored in another file")
    }
    var path: str[] = []
    for p in get_list(m, 3) {
        path.push(as_text(p))
    }
    var encodings: Encoding[] = []
    for e in get_list(m, 2) {
        let known = encoding_of(as_int(e), -1)?
        encodings.push(known)
    }
    ColumnChunk {
        path
        physical: physical_of(get_int(m, 1, 0), -1)?
        codec: codec_of(get_int(m, 4, 0), -1)?
        encodings
        num_values: get_int(m, 5, 0)
        total_compressed: get_int(m, 7, 0)
        total_uncompressed: get_int(m, 6, 0)
        data_page_offset: get_int(m, 9, 0)
        dictionary_page_offset: if has_field(m, 11) { get_int(m, 11, -1) } else { -1 }
        statistics: read_statistics(get_struct(m, 12), node, ordered)
    }
}

fn parse_row_group(v: Thrift, leaves: Column[], orders: Thrift[]) -> RowGroup ! Error {
    let g = as_struct(v)
    let chunks = get_list(g, 1)
    if chunks.len != leaves.len {
        fail Invalid(-1, "a row group has {chunks.len} column chunks for {leaves.len} columns")
    }
    var columns: ColumnChunk[] = []
    for i, c in chunks {
        let ordered = i < orders.len && has_field(as_struct(orders[i]), 1)
        let chunk = read_chunk(c, leaves[i].node, ordered)?
        columns.push(chunk)
    }
    RowGroup { num_rows: get_int(g, 3, 0), total_byte_size: get_int(g, 2, 0), columns }
}

fn read_metadata(data: u8[], base: i64) -> Metadata ! Error {
    let f = parse_struct(data, base)?
    if has_field(f, 8) {
        fail Unsupported("an encrypted file")
    }
    let schema = read_schema(get_list(f, 2))?
    let leaves = leaf_columns(schema)
    let orders = get_list(f, 7)
    var groups: RowGroup[] = []
    for g in get_list(f, 4) {
        let rg = parse_row_group(g, leaves, orders)?
        groups.push(rg)
    }
    var pairs: [str: str] = [:]
    for kv in get_list(f, 5) {
        let e = as_struct(kv)
        pairs[get_text(e, 1)] = get_text(e, 2)
    }
    Metadata { version: get_int(f, 1, 1), schema, num_rows: get_int(f, 3, 0), row_groups: groups, key_value: pairs, created_by: get_text(f, 6) }
}

fn int_of(p: Physical) -> i64 {
    match p {
        Boolean => 0
        Int32 => 1
        Int64 => 2
        Int96 => 3
        Float => 4
        Double => 5
        ByteArray => 6
        FixedLenByteArray => 7
    }
}

fn codec_int(c: Codec) -> i64 {
    match c {
        Uncompressed => 0
        Snappy => 1
        Gzip => 2
        Lzo => 3
        Brotli => 4
        Lz4 => 5
        Zstd => 6
        Lz4Raw => 7
    }
}

fn encoding_int(e: Encoding) -> i64 {
    match e {
        Plain => 0
        PlainDictionary => 2
        Rle => 3
        BitPacked => 4
        DeltaBinaryPacked => 5
        DeltaLengthByteArray => 6
        DeltaByteArray => 7
        RleDictionary => 8
        ByteStreamSplit => 9
    }
}

fn repetition_int(r: Repetition) -> i64 {
    match r {
        Required => 0
        Optional => 1
        Repeated => 2
    }
}

fn unit_struct(unit: arrow.TimeUnit) -> Thrift {
    let which = match unit {
        Millisecond => 1
        Microsecond => 2
        _ => 3
    }
    Thrift.Struct([TField { id: which, value: Thrift.Struct([]) }])
}

fn logical_struct(l: Logical) -> TField[] {
    match l {
        None => []
        String => [TField { id: 1, value: Thrift.Struct([]) }]
        Enum => [TField { id: 4, value: Thrift.Struct([]) }]
        Uuid => [TField { id: 14, value: Thrift.Struct([]) }]
        Json => [TField { id: 12, value: Thrift.Struct([]) }]
        Bson => [TField { id: 13, value: Thrift.Struct([]) }]
        Float16 => [TField { id: 15, value: Thrift.Struct([]) }]
        Date => [TField { id: 6, value: Thrift.Struct([]) }]
        Interval => []
        Unknown => [TField { id: 11, value: Thrift.Struct([]) }]
        Int(bits, signed) => [TField { id: 10, value: Thrift.Struct([TField { id: 1, value: Thrift.Byte(bits) }, TField { id: 2, value: Thrift.Bool(signed) }]) }]
        Decimal(precision, scale) => [TField { id: 5, value: Thrift.Struct([TField { id: 1, value: Thrift.I32(scale) }, TField { id: 2, value: Thrift.I32(precision) }]) }]
        Time(unit, utc) => [TField { id: 7, value: Thrift.Struct([TField { id: 1, value: Thrift.Bool(utc) }, TField { id: 2, value: unit_struct(unit) }]) }]
        Timestamp(unit, utc) => [TField { id: 8, value: Thrift.Struct([TField { id: 1, value: Thrift.Bool(utc) }, TField { id: 2, value: unit_struct(unit) }]) }]
    }
}

fn converted_of(l: Logical) -> i64 {
    match l {
        String => 0
        Enum => 4
        Decimal(_, _) => 5
        Date => 6
        Time(unit, _) => match unit {
            Millisecond => 7
            Microsecond => 8
            _ => -1
        }
        Timestamp(unit, _) => match unit {
            Millisecond => 9
            Microsecond => 10
            _ => -1
        }
        Int(bits, signed) => match bits {
            == 8 => if signed { 15 } else { 11 }
            == 16 => if signed { 16 } else { 12 }
            == 32 => if signed { 17 } else { 13 }
            _ => if signed { 18 } else { 14 }
        }
        Json => 19
        Bson => 20
        Interval => 21
        _ => -1
    }
}

fn node_elements(n: Node, mut out: Thrift[]) {
    var f: TField[] = []
    if n.leaf {
        f.push(TField { id: 1, value: Thrift.I32(int_of(n.physical)) })
        if n.physical == Physical.FixedLenByteArray {
            f.push(TField { id: 2, value: Thrift.I32(n.length) })
        }
    }
    f.push(TField { id: 3, value: Thrift.I32(repetition_int(n.repetition)) })
    f.push(TField { id: 4, value: Thrift.Binary(bytes(n.name)) })
    if !n.leaf {
        f.push(TField { id: 5, value: Thrift.I32(n.children.len) })
    }
    var converted = converted_of(n.logical)
    var logical = logical_struct(n.logical)
    if !n.leaf {
        match n.shape {
            List => {
                converted = 3
                logical = [TField { id: 3, value: Thrift.Struct([]) }]
            }
            Map => {
                converted = 1
                logical = [TField { id: 2, value: Thrift.Struct([]) }]
            }
            Plain => {}
        }
    }
    if converted >= 0 {
        f.push(TField { id: 6, value: Thrift.I32(converted) })
    }
    match n.logical {
        Decimal(precision, scale) => {
            f.push(TField { id: 7, value: Thrift.I32(scale) })
            f.push(TField { id: 8, value: Thrift.I32(precision) })
        }
        _ => {}
    }
    if n.field_id >= 0 {
        f.push(TField { id: 9, value: Thrift.I32(n.field_id) })
    }
    if logical.len > 0 {
        f.push(TField { id: 10, value: Thrift.Struct(logical) })
    }
    out.push(Thrift.Struct(f))
    for c in n.children {
        node_elements(c, mut out)
    }
}

fn statistics_struct(s: Statistics) -> TField[] {
    var f: TField[] = []
    if s.null_count >= 0 {
        f.push(TField { id: 3, value: Thrift.I64(s.null_count) })
    }
    if s.distinct_count >= 0 {
        f.push(TField { id: 4, value: Thrift.I64(s.distinct_count) })
    }
    if s.has_range {
        f.push(TField { id: 5, value: Thrift.Binary(s.max) })
        f.push(TField { id: 6, value: Thrift.Binary(s.min) })
    }
    f
}

fn chunk_struct(c: ColumnChunk) -> Thrift {
    var encodings: Thrift[] = []
    for e in c.encodings {
        encodings.push(Thrift.I32(encoding_int(e)))
    }
    var path: Thrift[] = []
    for p in c.path {
        path.push(Thrift.Binary(bytes(p)))
    }
    var m: TField[] = []
    m.push(TField { id: 1, value: Thrift.I32(int_of(c.physical)) })
    m.push(TField { id: 2, value: Thrift.List(encodings) })
    m.push(TField { id: 3, value: Thrift.List(path) })
    m.push(TField { id: 4, value: Thrift.I32(codec_int(c.codec)) })
    m.push(TField { id: 5, value: Thrift.I64(c.num_values) })
    m.push(TField { id: 6, value: Thrift.I64(c.total_uncompressed) })
    m.push(TField { id: 7, value: Thrift.I64(c.total_compressed) })
    m.push(TField { id: 9, value: Thrift.I64(c.data_page_offset) })
    if c.dictionary_page_offset >= 0 {
        m.push(TField { id: 11, value: Thrift.I64(c.dictionary_page_offset) })
    }
    let stats = statistics_struct(c.statistics)
    if stats.len > 0 {
        m.push(TField { id: 12, value: Thrift.Struct(stats) })
    }
    let start = if c.dictionary_page_offset >= 0 { c.dictionary_page_offset } else { c.data_page_offset }
    Thrift.Struct([TField { id: 2, value: Thrift.I64(start) }, TField { id: 3, value: Thrift.Struct(m) }])
}

fn count_leaves(n: Node) -> i64 {
    if n.leaf {
        return 1
    }
    var total = 0
    for c in n.children {
        total += count_leaves(c)
    }
    total
}

fn write_metadata(m: Metadata) -> u8[] {
    var elements: Thrift[] = []
    elements.push(Thrift.Struct([
        TField { id: 4, value: Thrift.Binary(bytes("schema")) },
        TField { id: 5, value: Thrift.I32(m.schema.fields.len) },
    ]))
    for n in m.schema.fields {
        node_elements(n, mut elements)
    }
    var groups: Thrift[] = []
    for g in m.row_groups {
        var chunks: Thrift[] = []
        for c in g.columns {
            chunks.push(chunk_struct(c))
        }
        var total = 0
        for c in g.columns {
            total += c.total_compressed
        }
        groups.push(Thrift.Struct([
            TField { id: 1, value: Thrift.List(chunks) },
            TField { id: 2, value: Thrift.I64(g.total_byte_size) },
            TField { id: 3, value: Thrift.I64(g.num_rows) },
            TField { id: 6, value: Thrift.I64(total) },
        ]))
    }
    var f: TField[] = []
    f.push(TField { id: 1, value: Thrift.I32(m.version) })
    f.push(TField { id: 2, value: Thrift.List(elements) })
    f.push(TField { id: 3, value: Thrift.I64(m.num_rows) })
    f.push(TField { id: 4, value: Thrift.List(groups) })
    if m.key_value.len > 0 {
        var keys: str[] = []
        for k in m.key_value {
            keys.push(k)
        }
        var pairs: Thrift[] = []
        for k in keys {
            pairs.push(Thrift.Struct([
                TField { id: 1, value: Thrift.Binary(bytes(k)) },
                TField { id: 2, value: Thrift.Binary(bytes(m.key_value[k] ?? "")) },
            ]))
        }
        f.push(TField { id: 5, value: Thrift.List(pairs) })
    }
    if m.created_by != "" {
        f.push(TField { id: 6, value: Thrift.Binary(bytes(m.created_by)) })
    }
    var orders: Thrift[] = []
    for n in m.schema.fields {
        for _ in 0..count_leaves(n) {
            orders.push(Thrift.Struct([TField { id: 1, value: Thrift.Struct([]) }]))
        }
    }
    f.push(TField { id: 7, value: Thrift.List(orders) })
    encode_struct(f)
}

struct PageHeader {
    kind: i64
    uncompressed: i64
    compressed: i64
    crc: i64
    has_crc: bool
    num_values: i64
    num_nulls: i64
    num_rows: i64
    encoding: Encoding
    def_encoding: Encoding
    rep_encoding: Encoding
    def_length: i64
    rep_length: i64
    is_compressed: bool
    size: i64
}

fn read_page_header(data: u8[], base: i64) -> PageHeader ! Error {
    let s = source(data, base)
    let f = read_struct(s, 0)?
    let kind = get_int(f, 1, -1)
    var h = PageHeader {
        kind
        uncompressed: get_int(f, 2, -1)
        compressed: get_int(f, 3, -1)
        crc: get_int(f, 4, 0) & 0xFFFFFFFF
        has_crc: has_field(f, 4)
        num_values: 0
        num_nulls: 0
        num_rows: 0
        encoding: Encoding.Plain
        def_encoding: Encoding.Rle
        rep_encoding: Encoding.Rle
        def_length: 0
        rep_length: 0
        is_compressed: true
        size: s.pos
    }
    if h.uncompressed < 0 || h.compressed < 0 {
        fail Invalid(base, "a page header has a negative size")
    }
    match kind {
        == 0 => {
            let d = get_struct(f, 5)
            h.num_values = get_int(d, 1, 0)
            h.encoding = encoding_of(get_int(d, 2, 0), base)?
            h.def_encoding = encoding_of(get_int(d, 3, 3), base)?
            h.rep_encoding = encoding_of(get_int(d, 4, 3), base)?
        }
        == 2 => {
            let d = get_struct(f, 7)
            h.num_values = get_int(d, 1, 0)
            h.encoding = encoding_of(get_int(d, 2, 0), base)?
        }
        == 3 => {
            let d = get_struct(f, 8)
            h.num_values = get_int(d, 1, 0)
            h.num_nulls = get_int(d, 2, 0)
            h.num_rows = get_int(d, 3, 0)
            h.encoding = encoding_of(get_int(d, 4, 0), base)?
            h.def_length = get_int(d, 5, 0)
            h.rep_length = get_int(d, 6, 0)
            h.is_compressed = get_bool(d, 7, true)
        }
        _ => {}
    }
    h
}

fn write_page_header(h: PageHeader) -> u8[] {
    var f: TField[] = []
    f.push(TField { id: 1, value: Thrift.I32(h.kind) })
    f.push(TField { id: 2, value: Thrift.I32(h.uncompressed) })
    f.push(TField { id: 3, value: Thrift.I32(h.compressed) })
    if h.has_crc {
        var crc = h.crc
        if crc >= 2147483648 {
            crc -= 4294967296
        }
        f.push(TField { id: 4, value: Thrift.I32(crc) })
    }
    match h.kind {
        == 0 => f.push(TField { id: 5, value: Thrift.Struct([
            TField { id: 1, value: Thrift.I32(h.num_values) },
            TField { id: 2, value: Thrift.I32(encoding_int(h.encoding)) },
            TField { id: 3, value: Thrift.I32(encoding_int(h.def_encoding)) },
            TField { id: 4, value: Thrift.I32(encoding_int(h.rep_encoding)) },
        ]) })
        == 2 => f.push(TField { id: 7, value: Thrift.Struct([
            TField { id: 1, value: Thrift.I32(h.num_values) },
            TField { id: 2, value: Thrift.I32(encoding_int(h.encoding)) },
        ]) })
        _ => f.push(TField { id: 8, value: Thrift.Struct([
            TField { id: 1, value: Thrift.I32(h.num_values) },
            TField { id: 2, value: Thrift.I32(h.num_nulls) },
            TField { id: 3, value: Thrift.I32(h.num_rows) },
            TField { id: 4, value: Thrift.I32(encoding_int(h.encoding)) },
            TField { id: 5, value: Thrift.I32(h.def_length) },
            TField { id: 6, value: Thrift.I32(h.rep_length) },
            TField { id: 7, value: Thrift.Bool(h.is_compressed) },
        ]) })
    }
    encode_struct(f)
}
