/// Names the project.
pub fn title(name: str) {
    print("title {name}")
}

/// Gives the project's version, a semantic version such as `0.3.0`.
pub fn version(number: str) {
    print("version {number}")
}

/// Embeds the icon file at `path`, relative to this file, in the Windows executable, with every image the `.ico` holds. Builds for other targets ignore it, and `-icon` replaces it.
pub fn icon(path: str) {
    print("icon {path}")
}

/// Embeds the application manifest at `path`, relative to this file, in the Windows executable. Builds for other targets ignore it, and `-manifest` replaces it.
pub fn manifest(path: str) {
    print("manifest {path}")
}

/// Sets the string `key` of the version information in the Windows executable, such as `CompanyName`, `ProductName` or `LegalCopyright`. A later call with the same `key` replaces an earlier one, and `FileVersion` and `ProductVersion` replace the values taken from `version`. Builds for other targets ignore it.
pub fn file_info(key: str, value: str) {
    print("file_info {key} {value}")
}

/// Declares a dependency on the project in the repository at `source`, such as `github.com/acme/ui`, at the newest tagged version that `range` accepts.
///
/// `range` is `^1.2`, `~1.2.3`, `=1.2.3` or a bare version, which means `^`.
pub fn dep(source: str, range: str) {
    print("dep {source} {range}")
}

/// Declares a dependency on the project in the directory `dir`, relative to this file. `dir` may name the project's `build.low` instead.
pub fn local(dir: str) {
    print("local {dir}")
}

/// Runs `program` with `args` in the project directory before each build.
pub fn pre_build(program: str, args: str[]) {
    print("pre_build {program} {args}")
}

/// Runs `program` with `args` in the project directory after each successful build.
pub fn post_build(program: str, args: str[]) {
    print("post_build {program} {args}")
}
