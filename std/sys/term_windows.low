import std/io

extern "kernel32" {
    fn GetConsoleMode(h: i64, mut mode: u32) -> i32
    fn SetConsoleMode(h: i64, mode: u32) -> i32
    fn GetNumberOfConsoleInputEvents(h: i64, mut count: u32) -> i32
    fn GetConsoleScreenBufferInfo(h: i64, info: ptr) -> i32
}

const line_input: u32 = 0x2
const echo_input: u32 = 0x4
const processed_input: u32 = 0x1
const terminal_input: u32 = 0x200
const terminal_output: u32 = 0x4

fn console_mode(fd: i64) -> u32 ! io.Error {
    var mode: u32 = 0
    if GetConsoleMode(handle(fd), mut mode) == 0 {
        fail Unsupported
    }
    mode
}

fn is_input(fd: i64) -> bool {
    var count: u32 = 0
    GetNumberOfConsoleInputEvents(handle(fd), mut count) != 0
}

/// Returns whether the descriptor `fd` refers to a terminal.
pub fn is_terminal(fd: i64) -> bool {
    var mode: u32 = 0
    GetConsoleMode(handle(fd), mut mode) != 0
}

/// Returns the settings of the terminal on `fd`.
///
/// Fails with `Unsupported` if `fd` is not a terminal.
pub fn termios(fd: i64) -> Termios ! io.Error {
    let mode = console_mode(fd)?
    let settings = io.buffer(5)
    io.set_le32(settings, 0, i64(mode))
    settings[4] = if is_input(fd) { 1 } else { 0 }
    Termios { settings }
}

/// Applies `t` to the terminal on `fd`.
///
/// With `drain` set the change waits until pending output has been sent. Fails with `Unsupported` if `fd` is not a terminal.
pub fn set_termios(fd: i64, t: Termios, drain: bool) ! io.Error {
    console_mode(fd)?
    checked(SetConsoleMode(handle(fd), u32(io.le32(t.settings, 0))))?
}

/// Returns whether `t` has line buffering and echo both turned off.
pub fn is_raw(t: Termios) -> bool {
    if t.settings[4] == 0 {
        return false
    }
    u32(io.le32(t.settings, 0)) & (line_input | echo_input) == 0
}

/// Returns a copy of `t` in raw mode.
///
/// Raw mode turns off line buffering, echo, signal-generating keys, flow control and input and output translation, uses 8-bit characters, and makes reads return after one byte.
pub fn raw_mode(t: Termios) -> Termios {
    let settings = io.buffer(5)
    var mode = u32(io.le32(t.settings, 0))
    if t.settings[4] == 1 {
        mode = (mode & ~(line_input | echo_input | processed_input)) | terminal_input
    } else {
        mode = mode | terminal_output
    }
    io.set_le32(settings, 0, i64(mode))
    settings[4] = t.settings[4]
    Termios { settings }
}

fn screen_size(h: i64) -> WindowSize? {
    let info = io.buffer(22)
    if GetConsoleScreenBufferInfo(h, __slice_ptr(info)) == 0 {
        return none
    }
    let left = io.le16(info, 10)
    let top = io.le16(info, 12)
    let right = io.le16(info, 14)
    let bottom = io.le16(info, 16)
    some(WindowSize { columns: right - left + 1, rows: bottom - top + 1 })
}

/// Returns the size of the terminal on `fd`.
///
/// Fails with `Unsupported` if `fd` is not a terminal.
pub fn window_size(fd: i64) -> WindowSize ! io.Error {
    console_mode(fd)?
    match screen_size(handle(fd)) {
        some(size) => return size
        none => {}
    }
    match screen_size(handle(1)) {
        some(size) => size
        none => fail Unsupported
    }
}

/// Sets the size of the terminal on `fd` to `size`.
///
/// Fails with `Unsupported` if `fd` is not a terminal.
pub fn set_window_size(fd: i64, size: WindowSize) ! io.Error {
    fail Unsupported
}

/// Opens a new pseudoterminal and returns its master and slave sides.
///
/// The caller closes both descriptors. Fails with the system error if `/dev/ptmx` or the slave device cannot be opened.
pub fn open_pty() -> PtyPair ! io.Error {
    fail Unsupported
}
