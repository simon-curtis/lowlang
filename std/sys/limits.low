/// The soft and hard value of a resource limit, as `prlimit64` stores them.
pub struct Rlimit {
    /// The value the kernel enforces, where a negative number means no limit.
    pub soft: i64
    /// The ceiling the soft value can be raised to, where a negative number means no limit.
    pub hard: i64
}

/// The CPU and memory limits a Windows job object puts on the process.
pub struct JobLimits {
    /// The number of CPUs of processing time the job may use, or `none` when the job has no hard CPU cap.
    pub cpus: f64?
    /// The most memory in bytes that the process or the job may commit, or `none` when neither is limited.
    pub memory: i64?
}
