const lock_word = 0
const enabled_word = 1
const fd_word = 2

fn record_words() -> i64[] {
    let words: ptr[i64] = __static_block()
    view(words, 4)
}

/// Starts logging the inputs the process reads to the descriptor number `fd`, or stops logging when `fd` is negative.
///
/// Leaving a descriptor that is logging writes the line `redirect 0 ` to it, so a reader of that log knows it is incomplete.
///
/// Each event is one line `<op> <len> <name>` ending in a newline, where `len` is the decimal byte length of `name`, so a name with spaces or newlines stays parseable. The operations are `open`, `stat` (`stat`, `access`, `statfs` and `inotify_add`), `list` (`list_dir`), `readlink`, `exec` (`fork_exec`, named by its program path), `chdir`, `getenv` (`std/os` `env`, named by the variable) and `environ` (`std/os` `environment`, with an empty name). A name is recorded as the caller passed it. The caller keeps `fd` open while logging is on and closes it itself.
pub fn record_inputs(fd: i64) {
    let words = record_words()
    __lock(mut words[lock_word])
    if words[enabled_word] != 0 && words[fd_word] != fd {
        write_all(words[fd_word], bytes("redirect 0 \n")) or {}
    }
    words[fd_word] = fd
    words[enabled_word] = if fd >= 0 { 1 } else { 0 }
    __unlock(mut words[lock_word])
}

/// Logs one input event of kind `op` on `name` when `record_inputs` has turned logging on, and does nothing otherwise.
///
/// The line is written with one call while a lock that does not yield is held, so lines from several threads never interleave. A failed write is ignored.
pub fn record(op: str, name: str) {
    let words = record_words()
    if words[enabled_word] == 0 {
        return
    }
    let line = bytes("{op} {name.len} {name}\n")
    __lock(mut words[lock_word])
    if words[enabled_word] != 0 {
        write_all(words[fd_word], line) or {}
    }
    __unlock(mut words[lock_word])
}
