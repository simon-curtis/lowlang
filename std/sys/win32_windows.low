import std/io

extern "kernel32" {
    fn GetLastError() -> u32
    fn GetStdHandle(which: u32) -> i64
    fn CloseHandle(h: i64) -> i32
    fn GetFileType(h: i64) -> u32
    fn ReadFile(h: i64, buf: ptr, n: u32, mut done: u32, overlapped: ptr) -> i32
    fn WriteFile(h: i64, buf: ptr, n: u32, mut done: u32, overlapped: ptr) -> i32
    fn MultiByteToWideChar(page: u32, flags: u32, text: ptr, n: i32, wide: ptr, chars: i32) -> i32
    fn WideCharToMultiByte(page: u32, flags: u32, wide: ptr, chars: i32, text: ptr, n: i32, fallback: ptr, used: ptr) -> i32
    fn GetCurrentProcess() -> i64
    fn GetCurrentProcessId() -> u32
    fn DuplicateHandle(from_process: i64, h: i64, to_process: i64, mut copy: i64, access: u32, inherit: i32, options: u32) -> i32
}

const utf8_page: u32 = 65001
const invalid_handle = -1

fn handle(fd: i64) -> i64 {
    if fd >= 0 && fd <= 2 {
        return GetStdHandle(u32(-10 - fd))
    }
    socket_of(fd)
}

fn socket_of(fd: i64) -> i64 {
    fd & 0xFFFFFFFF
}

fn event_of(fd: i64) -> i64 {
    fd >> 32
}

fn wide(s: str) -> []u8 {
    let text = cstr(s)
    let chars = MultiByteToWideChar(utf8_page, 0, text, -1, null, 0)
    let out = io.buffer(2 * i64(chars) + 2)
    MultiByteToWideChar(utf8_page, 0, text, -1, __slice_ptr(out), chars)
    out
}

fn wide_units(units: []u8) -> []u8 {
    var out: []u8 = []
    io.append(mut out, units)
    push(mut out, 0)
    push(mut out, 0)
    out
}

fn narrow(units: ptr, chars: i64) -> str {
    if chars <= 0 {
        return ""
    }
    let n = WideCharToMultiByte(utf8_page, 0, units, i32(chars), null, 0, null, null)
    let out = io.buffer(i64(n))
    WideCharToMultiByte(utf8_page, 0, units, i32(chars), __slice_ptr(out), n, null, null)
    str(out)
}

fn narrow_buffer(units: []u8, chars: i64) -> str {
    narrow(__slice_ptr(units), chars)
}

fn wide_length(units: []u8, from: i64) -> i64 {
    var end = from
    for end + 1 < units.len && (units[end] != 0 || units[end + 1] != 0) {
        end += 2
    }
    (end - from) / 2
}

fn win_error(code: i64) -> io.Error {
    match code {
        2 => NotFound
        3 => NotFound
        5 => Denied
        6 => NotConnected
        32 => Denied
        33 => Denied
        39 => NoSpace
        50 => Unsupported
        53 => NotFound
        80 => Exists
        87 => Invalid
        109 => BrokenPipe
        112 => NoSpace
        123 => Invalid
        145 => NotEmpty
        161 => Invalid
        183 => Exists
        206 => TooLarge
        232 => BrokenPipe
        267 => NotDir
        1314 => Denied
        1460 => TimedOut
        4390 => Invalid
        10013 => Denied
        10022 => Invalid
        10035 => WouldBlock
        10036 => WouldBlock
        10038 => NotConnected
        10040 => TooLarge
        10042 => Unsupported
        10045 => Unsupported
        10047 => Unsupported
        10048 => AddrInUse
        10049 => AddrUnavailable
        10050 => Unreachable
        10051 => Unreachable
        10053 => Aborted
        10054 => Reset
        10055 => NoSpace
        10057 => NotConnected
        10058 => NotConnected
        10060 => TimedOut
        10061 => Refused
        10064 => Unreachable
        10065 => Unreachable
        _ => Os(code)
    }
}

fn last_error() -> io.Error {
    win_error(i64(GetLastError()))
}

fn checked(ok: i32) ! io.Error {
    if ok == 0 {
        fail last_error()
    }
}

fn opened(h: i64) -> i64 ! io.Error {
    if h == invalid_handle || h == 0 {
        fail last_error()
    }
    h
}
