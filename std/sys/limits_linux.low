import std/io

/// Returns the limit of the resource number `resource` for this process.
///
/// `resource` is a Linux `RLIMIT_` number. Fails with `Invalid` for a number the kernel does not know and with `Unsupported` on Windows, which has no resource limits.
pub fn get_rlimit(resource: i64) -> Rlimit ! io.Error {
    let old = io.buffer(16)
    io.syscall_result(__syscall(302, 0, resource, 0, __slice_ptr(old)))?
    Rlimit { soft: io.le64(old, 0), hard: io.le64(old, 8) }
}

/// Sets the soft and hard values of the resource number `resource` for this process.
///
/// Fails with `Invalid` when `limit.soft` exceeds `limit.hard` or `resource` is unknown, with `Denied` when `limit.hard` raises the hard value without the privilege to do so, and with `Unsupported` on Windows.
pub fn set_rlimit(resource: i64, limit: Rlimit) ! io.Error {
    let request = io.buffer(16)
    io.set_le64(request, 0, limit.soft)
    io.set_le64(request, 8, limit.hard)
    io.syscall_result(__syscall(302, 0, resource, __slice_ptr(request), 0))?
}

/// Returns the limits a Windows job object puts on the process.
///
/// Fails with `Unsupported` where the system has no job objects, as Linux has none, and when the process belongs to no job. `cpus` is `none` when the job has no hard CPU cap or the system does not report one.
pub fn job_limits() -> JobLimits ! io.Error {
    fail Unsupported
}
