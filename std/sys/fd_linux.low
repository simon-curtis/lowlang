import std/io

/// Closes the descriptor number `fd`.
///
/// A negative number stands for no descriptor and is ignored. Errors from the kernel are ignored, because nothing can be done about a descriptor that failed to close.
pub fn close_fd(fd: i64) {
    if fd >= 0 {
        __syscall(3, fd)
    }
}

/// Reads once from the descriptor number `fd` without waiting.
///
/// Fails with `WouldBlock` when `fd` is non-blocking and has no data. An interrupted read is repeated. On Windows a read from an overlapped pipe parks the green thread until it completes instead of failing with `WouldBlock`.
pub fn try_read(fd: i64, buf: u8[]) -> i64 ! io.Error {
    for {
        let r = __syscall(0, fd, __slice_ptr(buf), buf.len)
        if r != -4 {
            return io.syscall_result(r)
        }
    }
}

/// Writes once to the descriptor number `fd` without waiting.
///
/// Fails with `WouldBlock` when `fd` is non-blocking and cannot take output. An interrupted write is repeated. On Windows a write to an overlapped pipe parks the green thread until it completes instead of failing with `WouldBlock`.
pub fn try_write(fd: i64, data: u8[]) -> i64 ! io.Error {
    for {
        let r = __syscall(1, fd, __slice_ptr(data), data.len)
        if r != -4 {
            return io.syscall_result(r)
        }
    }
}

/// Makes the descriptor number `fd` non-blocking.
///
/// On Windows only a socket becomes non-blocking; a pipe or file stays as it was made, and a pipe from `pipe(true)` or `pipe_for_child` is already overlapped.
pub fn set_nonblocking(fd: i64) ! io.Error {
    let flags = io.syscall_result(__syscall(72, fd, 3))?
    io.syscall_result(__syscall(72, fd, 4, flags | 0x800))?
}

/// Takes the descriptor that a parent process left open for this one under the number `fd`, as `Launch.keep` does, and returns the number to use it by. It is marked closed on `exec`, so it is taken once and no child of this process receives it.
///
/// On Linux the number returned is `fd`. On Windows `fd` must be a socket, and the number returned differs from `fd`. Fails with `Invalid` when `fd` is already closed on `exec`, as a descriptor this process opened or took is, and with the system error when it is not open.
pub fn take_inherited(fd: i64) -> i64 ! io.Error {
    let flags = io.syscall_result(__syscall(72, fd, 1))?
    if flags & 1 != 0 {
        fail Invalid
    }
    io.syscall_result(__syscall(72, fd, 2, flags | 1))?
    fd
}

/// Returns the read end and the write end of a new pipe, both closed on `exec`.
///
/// The ends are non-blocking when `nonblocking` is `true` and blocking otherwise. On Windows the non-blocking ends are overlapped handles that park the green thread on a read or write, and the blocking ones are anonymous pipe handles.
pub fn pipe(nonblocking: bool) -> Pair ! io.Error {
    let fds = io.buffer(8)
    let flags = if nonblocking { 0x80800 } else { 0x80000 }
    io.syscall_result(__syscall(293, __slice_ptr(fds), flags))?
    Pair { first: io.le32(fds, 0), second: io.le32(fds, 4) }
}

/// Opens the existing named pipe at `path`, such as `\\.\pipe\openssh-ssh-agent`, for reading and writing, and returns its non-blocking descriptor number.
///
/// Reads and writes on the descriptor park the green thread, and a descriptor takes one read or write at a time. A pipe whose instances are all busy is retried every 20 milliseconds for a second, and then fails with `TimedOut`. The server cannot impersonate the caller beyond identifying it. Fails with `NotFound` when no such pipe exists and with `Unsupported` on Linux.
pub fn open_pipe(path: str) -> i64 ! io.Error {
    fail Unsupported
}

/// Creates one instance of the named pipe at `path`, which only the current user can open, and returns its non-blocking descriptor number.
///
/// `path` is a name such as `\\.\pipe\app`. The instance waits for a client until `accept_pipe` returns, and the caller makes the next instance before it hands the connected one on, so a client finds a pipe to open. With `first` set the call fails with `Denied` when another process has already made an instance of that name, which stops another program from standing in for the server. The pipe refuses clients on other machines. Fails with `Unsupported` on Linux.
pub fn listen_pipe(path: str, first: bool) -> i64 ! io.Error {
    fail Unsupported
}

/// Parks the green thread until a client opens the pipe instance that `h` views.
///
/// Returns at once when a client connected before the call. Fails with `NotConnected` when the view is closed, including while the call is waiting. The instance is then connected, and reads and writes on `h.fd` serve that client. Fails with `Unsupported` on Linux.
pub fn accept_pipe(h: FdHandle) ! io.Error {
    fail Unsupported
}

/// Returns a pipe for one standard stream of a child process: the end the parent keeps is non-blocking and the end the child receives is blocking.
///
/// The parent holds the write end, `second`, when `input` is `true`, and the read end, `first`, otherwise. Both ends are closed on `exec`.
pub fn pipe_for_child(input: bool) -> Pair ! io.Error {
    let ends = pipe(false)?
    set_nonblocking(if input { ends.second } else { ends.first }) catch {
        e => {
            close_fd(ends.first)
            close_fd(ends.second)
            fail e
        }
    }
    ends
}

fn interrupt(fd: i64) {}

/// Returns whether the descriptor number `fd` has data to read or has reached end of input, without waiting.
pub fn readable_now(fd: i64) -> bool {
    let p = io.buffer(8)
    io.set_le32(p, 0, fd)
    p[4] = 1
    __syscall(7, __slice_ptr(p), 1, 0) > 0
}

/// Parks the green thread until the descriptor number `fd` may have input or has reached end of input.
///
/// Can return before input arrives, so the caller reads and waits again.
pub fn wait_input(fd: i64) {
    wait_readable(fd)
}

fn wait_output(fd: i64) {
    wait_writable(fd)
}
