import std/io

fn level_of(option: SocketOption) -> i64 {
    match option {
        ReuseAddr => 1
        ReusePort => 1
        KeepAlive => 1
        ReceiveBuffer => 1
        SendBuffer => 1
        NoDelay => 6
        KeepIdle => 6
        KeepInterval => 6
        KeepCount => 6
        MulticastTtl4 => 0
        MulticastLoop4 => 0
        MulticastTtl6 => 41
        MulticastLoop6 => 41
        MulticastInterface6 => 41
        Error => 1
    }
}

fn number_of(option: SocketOption) -> i64 {
    match option {
        ReuseAddr => 2
        ReusePort => 15
        KeepAlive => 9
        ReceiveBuffer => 8
        SendBuffer => 7
        NoDelay => 1
        KeepIdle => 4
        KeepInterval => 5
        KeepCount => 6
        MulticastTtl4 => 33
        MulticastLoop4 => 34
        MulticastTtl6 => 18
        MulticastLoop6 => 19
        MulticastInterface6 => 17
        Error => 4
    }
}

const max_fds = 253
const control_size = 1040
const message_size = 72 + control_size

fn membership_request(group: u8[], index: i64) -> u8[] {
    var request: u8[] = []
    io.append(mut request, group)
    if group.len == 4 {
        io.put_be32(mut request, 0)
    }
    let tail = io.buffer(4)
    io.set_le32(tail, 0, index)
    io.append(mut request, tail)
    request
}

fn address_value(b: u8[]) -> i64 {
    i64(__slice_ptr(b))
}

fn set_bytes(fd: i64, level: i64, option: i64, value: u8[]) ! io.Error {
    io.syscall_result(__syscall(54, fd, level, option, __slice_ptr(value), value.len))?
}

/// Makes a non-blocking socket closed on `exec` and returns its descriptor.
///
/// `family` is the address family number of the addresses the socket will use.
pub fn socket(family: i64, kind: SocketKind) -> i64 ! io.Error {
    let type_code = match kind {
        Streaming => 1
        Datagrams => 2
    }
    io.syscall_result(__syscall(41, family, type_code | 0x80800, 0))
}

/// Returns two connected, unnamed stream sockets, non-blocking and closed on `exec`.
///
/// They are Unix stream sockets on Linux and a pair of loopback TCP sockets on Windows.
pub fn socketpair() -> Pair ! io.Error {
    let fds = io.buffer(8)
    io.syscall_result(__syscall(53, 1, 0x80801, 0, __slice_ptr(fds)))?
    Pair { first: io.le32(fds, 0), second: io.le32(fds, 4) }
}

/// Returns a second descriptor for the socket `fd`, closed on `exec`, that carries writes so a writer waits for buffer space while a reader waits on `fd`.
///
/// On Linux it is a duplicate of `fd`. On Windows it is a duplicate of the socket with its own event. The caller closes it with `close_fd`.
pub fn write_view(fd: i64) -> i64 ! io.Error {
    io.syscall_result(__syscall(72, fd, 1030, 0))
}

/// Sets the integer socket option `option` of the socket `fd` to `value`.
pub fn set_option(fd: i64, option: SocketOption, value: i64) ! io.Error {
    let v = io.buffer(4)
    io.set_le32(v, 0, value)
    set_bytes(fd, level_of(option), number_of(option), v)?
}

/// Returns the integer socket option `option` of the socket `fd`.
pub fn get_option(fd: i64, option: SocketOption) -> i64 ! io.Error {
    let v = io.buffer(4)
    let size = io.buffer(4)
    io.set_le32(size, 0, 4)
    io.syscall_result(__syscall(55, fd, level_of(option), number_of(option), __slice_ptr(v), __slice_ptr(size)))?
    io.le32(v, 0)
}

/// Binds the socket `fd` to the network interface `device`.
pub fn bind_device(fd: i64, device: str) ! io.Error {
    let name = bytes(device)
    set_bytes(fd, 1, 25, name)?
}

/// Binds the socket `fd` to `address`, given in the system's socket address layout.
pub fn bind(fd: i64, address: u8[]) ! io.Error {
    io.syscall_result(__syscall(49, fd, __slice_ptr(address), address.len))?
}

/// Marks the socket `fd` as listening with a queue of `backlog` waiting connections.
pub fn listen(fd: i64, backlog: i64) ! io.Error {
    io.syscall_result(__syscall(50, fd, backlog))?
}

/// Returns the address the socket `fd` is bound to, in the system's socket address layout.
pub fn local_address(fd: i64) -> u8[] ! io.Error {
    let buf = io.buffer(128)
    let size = io.buffer(4)
    io.set_le32(size, 0, 128)
    io.syscall_result(__syscall(51, fd, __slice_ptr(buf), __slice_ptr(size)))?
    address_of(buf, io.le32(size, 0))
}

/// Takes the next waiting connection from the listening socket `fd`.
///
/// Fails with `WouldBlock` when none is waiting. An interrupted call and a connection reset before it was accepted are skipped.
pub fn accept(fd: i64) -> Accepted ! io.Error {
    let buf = io.buffer(128)
    let size = io.buffer(4)
    for {
        io.set_le32(size, 0, 128)
        let r = __syscall(288, fd, __slice_ptr(buf), __slice_ptr(size), 0x80800)
        if r != -4 && r != -103 {
            let accepted = io.syscall_result(r)?
            return Accepted { fd: accepted, address: address_of(buf, io.le32(size, 0)) }
        }
    }
}

/// Starts connecting the socket `fd` to `address` and returns whether the connection is complete.
///
/// Returns `false` while the connection is in progress; wait for `fd` to become writable and call `finish_connect`. Fails with `WouldBlock` when a Unix socket's listener has a full queue, which no later event announces, so the caller tries again.
pub fn connect(fd: i64, address: u8[]) -> bool ! io.Error {
    for {
        let r = __syscall(42, fd, __slice_ptr(address), address.len)
        if r == -115 {
            return false
        }
        if r != -4 {
            io.syscall_result(r)?
            return true
        }
    }
}

/// Reports how a connection started by `connect` ended.
///
/// Fails with the error the connection met, such as `Refused`.
pub fn finish_connect(fd: i64) ! io.Error {
    let code = get_option(fd, Error)?
    if code != 0 {
        fail io.errno(code)
    }
}

/// Shuts down the socket `fd` in the direction `how`.
pub fn shutdown(fd: i64, how: Shutdown) ! io.Error {
    let direction = match how {
        Sending => 1
        Both => 2
    }
    io.syscall_result(__syscall(48, fd, direction))?
}

/// Receives up to `buf.len` bytes from the socket `fd` and returns the count, or `0` at end of input.
///
/// Fails with `WouldBlock` when nothing has arrived. An interrupted call is repeated.
pub fn recv(fd: i64, buf: u8[]) -> i64 ! io.Error {
    for {
        let r = __syscall(45, fd, __slice_ptr(buf), buf.len, 0, 0, 0)
        if r != -4 {
            return io.syscall_result(r)
        }
    }
}

/// Receives one datagram into `buf` from the socket `fd`.
///
/// A datagram longer than `buf` is truncated. Fails with `WouldBlock` when nothing has arrived. An interrupted call is repeated.
pub fn recv_from(fd: i64, buf: u8[]) -> Received ! io.Error {
    let address = io.buffer(128)
    let size = io.buffer(4)
    for {
        io.set_le32(size, 0, 128)
        let r = __syscall(45, fd, __slice_ptr(buf), buf.len, 0, __slice_ptr(address), __slice_ptr(size))
        if r != -4 {
            let n = io.syscall_result(r)?
            return Received { size: n, address: address_of(address, io.le32(size, 0)) }
        }
    }
}

/// Sends a prefix of `data` on the connected socket `fd` and returns how many bytes were sent.
///
/// A peer that has closed the connection gives `BrokenPipe` or `Reset` and never raises `SIGPIPE`. Fails with `WouldBlock` when the send buffer is full. An interrupted call is repeated.
pub fn send(fd: i64, data: u8[]) -> i64 ! io.Error {
    for {
        let r = __syscall(44, fd, __slice_ptr(data), data.len, 0x4000, 0, 0)
        if r != -4 {
            return io.syscall_result(r)
        }
    }
}

/// Receives up to `buf.len` bytes from the Unix socket `fd` together with the descriptors passed with them by `SCM_RIGHTS`.
///
/// The descriptors are closed on `exec` and belong to the caller. Fails with `WouldBlock` when nothing has arrived and with `Malformed` when the kernel dropped descriptors because the control buffer was too small, after closing those it delivered. An interrupted call is repeated.
pub fn recv_with_fds(fd: i64, buf: u8[]) -> ReceivedFds ! io.Error {
    let message = io.buffer(message_size)
    let base = i64(__slice_ptr(message))
    io.set_le64(message, 16, base + 56)
    io.set_le64(message, 24, 1)
    io.set_le64(message, 32, base + 72)
    io.set_le64(message, 40, control_size)
    io.set_le64(message, 56, i64(__slice_ptr(buf)))
    io.set_le64(message, 64, buf.len)
    for {
        io.set_le64(message, 40, control_size)
        let r = __syscall(47, fd, __slice_ptr(message), 0x40000000)
        if r != -4 {
            let n = io.syscall_result(r)?
            let fds = received_descriptors(message)
            if io.le32(message, 48) & 8 != 0 {
                for received in fds {
                    __syscall(3, received)
                }
                fail Malformed
            }
            return ReceivedFds { size: n, fds }
        }
    }
}

fn received_descriptors(message: u8[]) -> i64[] {
    var fds: i64[] = []
    let used = io.le64(message, 40)
    var at = 72
    let end = 72 + used
    for at + 16 <= end {
        let length = io.le64(message, at)
        if length < 16 {
            break
        }
        if io.le32(message, at + 8) == 1 && io.le32(message, at + 12) == 1 {
            var data = at + 16
            for data + 4 <= at + length {
                fds.push(io.le32(message, data))
                data += 4
            }
        }
        at += (length + 7) & ~7
    }
    fds
}

/// Sends a prefix of `data` on the connected Unix socket `fd` with the descriptors `fds` attached through `SCM_RIGHTS` and returns how many bytes were sent.
///
/// The descriptors are delivered with the first byte sent, so a caller that sends the rest of `data` in later calls passes no descriptors to them. At least one byte of `data` is sent whenever `fds` is not empty. A peer that has closed the connection gives `BrokenPipe` or `Reset` and never raises `SIGPIPE`. Fails with `WouldBlock` when the send buffer is full and with `Invalid` when `fds` holds more than 253 descriptors. An interrupted call is repeated.
pub fn send_with_fds(fd: i64, data: u8[], fds: i64[]) -> i64 ! io.Error {
    if fds.len == 0 {
        return send(fd, data)
    }
    if fds.len > max_fds {
        fail Invalid
    }
    let length = 16 + fds.len * 4
    let space = 16 + ((fds.len * 4 + 7) & ~7)
    let message = io.buffer(72 + space)
    let base = i64(__slice_ptr(message))
    io.set_le64(message, 16, base + 56)
    io.set_le64(message, 24, 1)
    io.set_le64(message, 32, base + 72)
    io.set_le64(message, 40, space)
    io.set_le64(message, 56, i64(__slice_ptr(data)))
    io.set_le64(message, 64, data.len)
    io.set_le64(message, 72, length)
    io.set_le32(message, 80, 1)
    io.set_le32(message, 84, 1)
    for i, descriptor in fds {
        io.set_le32(message, 88 + i * 4, descriptor)
    }
    for {
        let r = __syscall(46, fd, __slice_ptr(message), 0x4000)
        if r != -4 {
            return io.syscall_result(r)
        }
    }
}

/// Sends `data` as one datagram from the socket `fd` to `address` and returns the number of bytes sent.
///
/// Fails with `WouldBlock` when the send buffer is full. An interrupted call is repeated.
pub fn send_to(fd: i64, data: u8[], address: u8[]) -> i64 ! io.Error {
    for {
        let r = __syscall(44, fd, __slice_ptr(data), data.len, 0x4000, __slice_ptr(address), address.len)
        if r != -4 {
            return io.syscall_result(r)
        }
    }
}

/// Sends `data` as one datagram from the Unix socket `fd` to `address` together with the descriptor `passed`, and returns the number of bytes sent.
///
/// The receiver gets its own descriptor for the same open file. `data` can be empty. Fails with `WouldBlock` when the send buffer is full and with `Unsupported` on Windows. An interrupted call is repeated.
pub fn send_to_with_fd(fd: i64, data: u8[], address: u8[], passed: i64) -> i64 ! io.Error {
    let name = io.buffer(address.len)
    io.copy(name, address)
    let base = io.buffer(16)
    io.set_le64(base, 0, address_value(data))
    io.set_le64(base, 8, data.len)
    let control = io.buffer(24)
    io.set_le64(control, 0, 20)
    io.set_le32(control, 8, 1)
    io.set_le32(control, 12, 1)
    io.set_le32(control, 16, passed)
    let header = io.buffer(56)
    io.set_le64(header, 0, address_value(name))
    io.set_le32(header, 8, name.len)
    io.set_le64(header, 16, address_value(base))
    io.set_le64(header, 24, 1)
    io.set_le64(header, 32, address_value(control))
    io.set_le64(header, 40, 24)
    for {
        let r = __syscall(46, fd, __slice_ptr(header), 0x4000)
        if r != -4 {
            return io.syscall_result(r)
        }
    }
}

/// Receives one datagram into `buf` from the Unix socket `fd` and returns the descriptor that came with it, if any.
///
/// A datagram longer than `buf` is truncated. Fails with `WouldBlock` when nothing has arrived and with `Unsupported` on Windows. An interrupted call is repeated.
pub fn recv_from_with_fd(fd: i64, buf: u8[]) -> ReceivedWithFd ! io.Error {
    let address = io.buffer(128)
    let base = io.buffer(16)
    io.set_le64(base, 0, address_value(buf))
    io.set_le64(base, 8, buf.len)
    let control = io.buffer(24)
    let header = io.buffer(56)
    for {
        io.set_le64(header, 0, address_value(address))
        io.set_le32(header, 8, 128)
        io.set_le64(header, 16, address_value(base))
        io.set_le64(header, 24, 1)
        io.set_le64(header, 32, address_value(control))
        io.set_le64(header, 40, 24)
        let r = __syscall(47, fd, __slice_ptr(header), 0x40000000)
        if r != -4 {
            let n = io.syscall_result(r)?
            var passed = -1
            if io.le64(header, 40) >= 20 && io.le32(control, 8) == 1 && io.le32(control, 12) == 1 {
                passed = io.le32(control, 16)
            }
            return ReceivedWithFd { size: n, address: address_of(address, io.le32(header, 8)), descriptor: passed }
        }
    }
}

/// Returns the process id, user id and group id of the peer of the Unix socket `fd`, as recorded when the connection was made.
pub fn peer_credentials(fd: i64) -> Credentials ! io.Error {
    let v = io.buffer(12)
    let size = io.buffer(4)
    io.set_le32(size, 0, 12)
    io.syscall_result(__syscall(55, fd, 1, 17, __slice_ptr(v), __slice_ptr(size)))?
    Credentials { pid: io.le32(v, 0), uid: io.le32(v, 4), gid: io.le32(v, 8) }
}

/// Returns the kernel index of the network interface `name`.
///
/// Fails with `Invalid` if `name` is empty or, on Linux, longer than 15 bytes; Windows has no length limit. Fails with `NotFound` if there is no such interface.
pub fn interface_index(name: str) -> i64 ! io.Error {
    if name.len == 0 || name.len > 15 {
        fail Invalid
    }
    let probe_fd = socket(2, Datagrams)?
    using probe = own(probe_fd)
    let request = io.buffer(40)
    let label = bytes(name)
    io.copy(request, label)
    let r = __syscall(16, probe.handle.fd, 0x8933, __slice_ptr(request))
    if r == -19 {
        fail NotFound
    }
    io.syscall_result(r)?
    io.le32(request, 16)
}

const netlink_header = 16
const netlink_buffer = 65536
const netlink_new_link = 16
const netlink_get_link = 18
const netlink_new_address = 20
const netlink_get_address = 22
const netlink_error = 2
const netlink_done = 3
const netlink_dump_request = 0x301
const link_name_attribute = 3
const address_attribute = 1
const local_attribute = 2
const link_attributes_at = 32
const address_attributes_at = 24

fn netlink_request(kind: i64) -> u8[] {
    var request: u8[] = []
    io.put_le32(mut request, 20)
    io.put_le16(mut request, kind)
    io.put_le16(mut request, netlink_dump_request)
    io.put_le32(mut request, 1)
    io.put_le32(mut request, 0)
    io.put_le32(mut request, 0)
    request
}

fn netlink_receive(fd: i64, buf: u8[]) -> i64 ! io.Error {
    for {
        let r = __syscall(45, fd, __slice_ptr(buf), buf.len, 0, 0, 0)
        if r != -4 {
            let n = io.syscall_result(r)?
            if n == 0 {
                fail NotConnected
            }
            return n
        }
    }
}

fn netlink_dump(fd: i64, kind: i64) -> u8[][] ! io.Error {
    let request = netlink_request(kind)
    io.syscall_result(__syscall(44, fd, __slice_ptr(request), request.len, 0, 0, 0))?
    let buf = io.buffer(netlink_buffer)
    var messages: u8[][] = []
    for {
        let n = netlink_receive(fd, buf)?
        var at = 0
        for at + netlink_header <= n {
            let size = io.le32(buf, at)
            if size < netlink_header || at + size > n {
                fail Invalid
            }
            let message_type = io.le16(buf, at + 4)
            if message_type == netlink_done {
                return messages
            }
            if message_type == netlink_error {
                let code = io.le32(buf, at + netlink_header)
                if code != 0 {
                    io.syscall_result(code - 4294967296)?
                }
            }
            let message = io.buffer(size)
            io.copy(message, buf[at..at + size])
            messages.push(message)
            at += (size + 3) / 4 * 4
        }
    }
}

fn netlink_attribute(message: u8[], from: i64, wanted: i64) -> u8[] {
    var at = from
    for at + 4 <= message.len {
        let size = io.le16(message, at)
        if size < 4 || at + size > message.len {
            break
        }
        if (io.le16(message, at + 2) & 0x3fff) == wanted {
            return message[at + 4..at + size]
        }
        at += (size + 3) / 4 * 4
    }
    []
}

fn link_name(message: u8[]) -> str {
    let raw = netlink_attribute(message, link_attributes_at, link_name_attribute)
    var end = raw.len
    for end > 0 && raw[end - 1] == 0 {
        end -= 1
    }
    str(raw[..end])
}

fn message_address(message: u8[]) -> InterfaceAddress {
    let family = i64(message[16])
    let want = match family {
        2 => 4
        10 => 16
        _ => 0
    }
    var ip = netlink_attribute(message, address_attributes_at, local_attribute)
    if ip.len != want {
        ip = netlink_attribute(message, address_attributes_at, address_attribute)
    }
    if ip.len != want {
        ip = []
    }
    InterfaceAddress { ip, prefix: i64(message[17]) }
}

fn addresses_of(messages: u8[][], index: i64) -> InterfaceAddress[] {
    var found: InterfaceAddress[] = []
    for message in messages {
        if io.le16(message, 4) != netlink_new_address || io.le32(message, 20) != index {
            continue
        }
        let address = message_address(message)
        if address.ip.len > 0 {
            found.push(address)
        }
    }
    found
}

/// Returns the network interfaces of this machine with their addresses.
///
/// On Linux it asks rtnetlink for the links and addresses; an address with a peer, as on a point-to-point link, is reported as the local address. On Windows it reads `GetAdaptersAddresses` for the adapters and their unicast addresses. Blocks the OS thread while it reads the system's tables.
pub fn interfaces() -> Interface[] ! io.Error {
    let socket_fd = io.syscall_result(__syscall(41, 16, 0x80003, 0))?
    using netlink = own(socket_fd)
    let links = netlink_dump(netlink.handle.fd, netlink_get_link)?
    let addresses = netlink_dump(netlink.handle.fd, netlink_get_address)?
    var found: Interface[] = []
    for message in links {
        if io.le16(message, 4) != netlink_new_link {
            continue
        }
        let index = io.le32(message, 20)
        let flags = io.le32(message, 24)
        let entry = Interface {
            name: link_name(message)
            index
            up: (flags & 0x1) != 0
            loopback: (flags & 0x8) != 0
            multicast: (flags & 0x1000) != 0
            addresses: addresses_of(addresses, index)
        }
        found.push(entry)
    }
    found
}

/// Joins or leaves the multicast `group` on the UDP socket `fd`.
///
/// `group` is 4 bytes for IPv4 or 16 for IPv6. `index` is the interface index, or `0` to let the system choose.
pub fn change_membership(fd: i64, group: u8[], index: i64, join: bool) ! io.Error {
    let request = membership_request(group, index)
    if group.len == 4 {
        set_bytes(fd, 0, if join { 35 } else { 36 }, request)?
        return
    }
    set_bytes(fd, 41, if join { 20 } else { 21 }, request)?
}

/// Sets the interface IPv4 multicast datagrams from the socket `fd` leave through to the interface with kernel index `index`, or to the system's choice when `index` is `0`.
pub fn set_multicast_interface4(fd: i64, index: i64) ! io.Error {
    let request = membership_request([0, 0, 0, 0], index)
    set_bytes(fd, 0, 32, request)?
}

/// Parks the green thread until the socket `fd` may be ready to read, or to write when `writable` is set.
///
/// Can return before the socket is ready, and returns when another green thread shuts the socket down, so the caller repeats its operation and waits again.
pub fn wait_socket(fd: i64, writable: bool) {
    if writable {
        wait_writable(fd)
    } else {
        wait_readable(fd)
    }
}
