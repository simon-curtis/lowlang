import std/io

/// The dimensions of a terminal window in character cells.
pub struct WindowSize {
    /// The number of columns.
    pub columns: i64
    /// The number of rows.
    pub rows: i64
}

/// A snapshot of the settings of a terminal, as `termios` reads them and `set_termios` applies them.
pub struct Termios {
    settings: []u8
}

/// The two sides of a pseudoterminal.
pub struct PtyPair {
    /// The descriptor of the master side.
    pub master: i64
    /// The descriptor of the slave side.
    pub slave: i64
    /// The device path of the slave side, such as `/dev/pts/3`.
    pub path: str
}
