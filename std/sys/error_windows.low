import std/io

extern "kernel32" {
    fn FormatMessageW(flags: u32, source: ptr, id: u32, language: u32, buf: ptr, size: u32, arguments: ptr) -> u32
}

const format_from_system: u32 = 0x1000
const format_ignore_inserts: u32 = 0x200
const message_chars = 1024

/// Returns the operating system's message text for the error number `code`, such as `No such file or directory` for 2 on Linux and `The system cannot find the path specified.` for 3 on Windows.
///
/// On Linux the text is the `strerror` text of glibc for the numbers 1 to 133, held in a table because the program links no C library. On Windows it comes from `FormatMessageW` in the user's language with the trailing line break removed. A number the system has no text for gives `Unknown error ` and the number.
pub fn error_message(code: i64) -> str {
    let units = io.buffer(2 * message_chars)
    let chars = FormatMessageW(format_from_system | format_ignore_inserts, null, u32(code), 0, __slice_ptr(units), u32(message_chars), null)
    let text = narrow(__slice_ptr(units), i64(chars))
    if text.len == 0 {
        return "Unknown error {code}"
    }
    var end = text.len
    for end > 0 && (text[end - 1] == '\n' || text[end - 1] == '\r' || text[end - 1] == ' ') {
        end -= 1
    }
    text[..end]
}
