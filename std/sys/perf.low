/// A performance event of the Linux kernel, as `perf_event_open` takes it.
pub struct PerfEvent {
    /// The event class: `0` for a hardware event and `1` for a software event.
    pub kind: i64
    /// The event within its class.
    pub config: i64
    /// The samples to take each second on each processor, or `0`.
    pub rate: i64 = 0
    /// The events between two samples, or `0`. An event with neither a rate nor a period counts without sampling.
    pub period: i64 = 0
    /// The most callers recorded with each sample.
    pub depth: i64 = 0
    /// Whether events in the kernel are measured as well.
    pub kernel: bool = true
}

/// The resources a child process and the descendants it waited for used.
pub struct ChildUsage {
    /// The processor time spent in user code, in nanoseconds.
    pub user: i64
    /// The processor time spent in the kernel, in nanoseconds.
    pub kernel: i64
    /// The largest resident set of any one of the processes, in bytes.
    pub peak_resident: i64
    /// The page faults taken.
    pub faults: i64
    /// The times a thread left a processor, by blocking or by preemption.
    pub switches: i64
}
