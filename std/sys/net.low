import std/io

/// The kind of socket `socket` makes.
pub enum SocketKind {
    /// A reliable byte stream, as TCP and Unix stream sockets provide.
    Streaming
    /// Unreliable datagrams, as UDP provides.
    Datagrams
}

/// Which direction `shutdown` closes.
pub enum Shutdown {
    /// The sending direction; the peer reads end of input once it has the data sent so far.
    Sending
    /// Both directions; operations waiting on the socket return.
    Both
}

/// A socket option with an integer value, for `set_option` and `get_option`.
pub enum SocketOption {
    /// Lets a restarted program bind a port still in `TIME_WAIT`.
    ReuseAddr
    /// Lets several sockets bind the same port.
    ReusePort
    /// Whether keep-alive probes are sent on a TCP connection.
    KeepAlive
    /// The receive buffer size in bytes.
    ReceiveBuffer
    /// The send buffer size in bytes.
    SendBuffer
    /// Whether a TCP connection sends small writes at once.
    NoDelay
    /// The idle seconds before the first keep-alive probe.
    KeepIdle
    /// The seconds between keep-alive probes.
    KeepInterval
    /// The number of unanswered probes after which a connection is dropped.
    KeepCount
    /// The time to live of outgoing IPv4 multicast datagrams.
    MulticastTtl4
    /// Whether outgoing IPv4 multicast datagrams are delivered to this host too.
    MulticastLoop4
    /// The hop limit of outgoing IPv6 multicast datagrams.
    MulticastTtl6
    /// Whether outgoing IPv6 multicast datagrams are delivered to this host too.
    MulticastLoop6
    /// The interface index outgoing IPv6 multicast datagrams leave through.
    MulticastInterface6
    /// The error number pending on the socket, which reading clears. Read it with `get_option`; setting it fails.
    Error
}

/// A connection taken from a listening socket by `accept`.
pub struct Accepted {
    /// The descriptor of the connection, non-blocking and closed on `exec`.
    pub fd: i64
    /// The address of the peer in the system's socket address layout.
    pub address: []u8
}

/// A datagram received by `recv_from`.
pub struct Received {
    /// The number of bytes written into the buffer.
    pub size: i64
    /// The address of the sender in the system's socket address layout.
    pub address: []u8
}

/// The identity of the process at the other end of a Unix socket.
pub struct Credentials {
    /// The process id.
    pub pid: i64
    /// The user id.
    pub uid: i64
    /// The group id.
    pub gid: i64
}

fn address_of(buf: []u8, size: i64) -> []u8 {
    let length = if size < buf.len { size } else { buf.len }
    buf[..length]
}
