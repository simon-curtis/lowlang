import std/io

/// A copyable view of an open descriptor and the guard that coordinates its closing.
///
/// Copies of an `FdHandle` refer to the same descriptor. Once any copy is closed, every operation on the view fails with `NotConnected`, so a closed descriptor is never reached after the kernel reuses its number. Reads and writes park the green thread while the descriptor is non-blocking and not ready.
pub struct FdHandle {
    /// The operating system file descriptor.
    pub fd: i64
    guard: *io.Guard
}

/// An owned descriptor that closes itself when dropped.
///
/// `handle` is the copyable view for passing the descriptor to other green threads, and `detach` hands the descriptor over so that dropping the owner leaves it open.
pub struct Fd {
    /// The copyable view of the descriptor.
    pub handle: FdHandle
    detached: bool = false
    drop {
        if !detached {
            close_on(handle)
        }
    }
}

/// Returns a view of the open descriptor `fd`, which the view's owner closes.
///
/// A negative `fd` makes a view whose closing does nothing.
pub fn wrap(fd: i64) -> FdHandle {
    wrap_with(fd, fn() {})
}

/// Returns a view of the open descriptor `fd` whose closing first runs `wake`.
///
/// `wake` unblocks operations that are waiting on the descriptor, for example by shutting a socket down.
pub fn wrap_with(fd: i64, wake: fn()) -> FdHandle {
    FdHandle { fd, guard: io.guard(wake, fn() { close_fd(fd) }) }
}

/// Returns the `Fd` that owns the descriptor behind `h`, which closes it when dropped.
pub fn adopt(h: FdHandle) -> Fd {
    Fd { handle: h }
}

/// Returns an `Fd` that owns the open descriptor number `fd` and closes it when dropped.
pub fn own(fd: i64) -> Fd {
    Fd { handle: wrap(fd) }
}

/// Stops `f` from closing the descriptor when dropped, and returns its view.
///
/// The caller must close the descriptor with `close_on`.
pub fn detach(mut f: Fd) -> FdHandle {
    f.detached = true
    f.handle
}

/// Registers a use of the descriptor behind `h` and returns the lease that ends it when dropped.
///
/// Fails with `NotConnected` once the descriptor has been closed, so a closed descriptor is never reached. Operations on the descriptor number `h.fd` that other `sys` functions perform hold a lease for their duration.
pub fn enter(h: FdHandle) -> io.Lease ! io.Error {
    return io.enter(h.guard)
}

/// Closes the descriptor owned by `f`. Does the same as `close_on` on its handle.
pub fn close(f: Fd) {
    close_on(f.handle)
}

/// Closes the descriptor that `h` views.
///
/// Later operations on `h` or its copies fail with `NotConnected`. The descriptor is released immediately, or when the last operation in flight returns. Closing twice does nothing.
pub fn close_on(h: FdHandle) {
    io.retire(h.guard)
}

/// Reads up to `buf.len` bytes from the descriptor number `fd` and returns the count, or `0` at end of input.
///
/// Parks the green thread while `fd` is non-blocking and has no data. An interrupted read is repeated.
pub fn read(fd: i64, buf: []u8) -> i64 ! io.Error {
    for {
        let n = try_read(fd, buf) catch {
            WouldBlock => -1
            e => fail e
        }
        if n >= 0 {
            return n
        }
        wait_input(fd)
    }
}

/// Writes a prefix of `data` to the descriptor number `fd` and returns how many bytes were written, which can be fewer than `data.len`.
///
/// Parks the green thread while `fd` is non-blocking and cannot take more output. An interrupted write is repeated.
pub fn write(fd: i64, data: []u8) -> i64 ! io.Error {
    for {
        let n = try_write(fd, data) catch {
            WouldBlock => -1
            e => fail e
        }
        if n >= 0 {
            return n
        }
        wait_output(fd)
    }
}

/// Writes all of `data` to the descriptor number `fd`, repeating `write` until nothing remains.
///
/// Fails with the first error a write returns, after which part of `data` may have been written.
pub fn write_all(fd: i64, data: []u8) ! io.Error {
    let s = stream(fd)
    io.write_all(s, data)?
}

/// Returns an `io.Stream` over the descriptor number `fd`.
///
/// Closing the stream does nothing; the owner of `fd` closes it.
pub fn stream(fd: i64) -> io.Stream {
    io.Stream {
        read: fn(buf) { read(fd, buf) }
        write: fn(data) { write(fd, data) }
        close: fn() {}
    }
}

/// Reads from the descriptor that `h` views, as `read` does.
///
/// Fails with `NotConnected` when the descriptor has been closed.
pub fn read_on(h: FdHandle, buf: []u8) -> i64 ! io.Error {
    using lease = io.enter(h.guard)?
    return read(h.fd, buf)
}

/// Writes to the descriptor that `h` views, as `write` does.
///
/// Fails with `NotConnected` when the descriptor has been closed.
pub fn write_on(h: FdHandle, data: []u8) -> i64 ! io.Error {
    using lease = io.enter(h.guard)?
    return write(h.fd, data)
}

/// Writes all of `data` to the descriptor that `h` views, as `write_all` does.
///
/// Fails with `NotConnected` when the descriptor has been closed.
pub fn write_all_on(h: FdHandle, data: []u8) ! io.Error {
    let s = stream_on(h)
    io.write_all(s, data)?
}

/// Returns an `io.Stream` over the descriptor that `h` views.
///
/// Closing the stream closes the descriptor. The stream is safe to copy and use from other green threads.
pub fn stream_on(h: FdHandle) -> io.Stream {
    io.Stream {
        read: fn(buf) { read_on(h, buf) }
        write: fn(data) { write_on(h, data) }
        close: fn() { close_on(h) }
    }
}

/// A pair of descriptor numbers made by `pipe` or `socketpair`.
pub struct Pair {
    /// The read end of a pipe, or the first socket.
    pub first: i64
    /// The write end of a pipe, or the second socket.
    pub second: i64
}
