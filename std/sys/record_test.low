import std/file
import std/testing
import std/text

const missing_program = "record-test-missing-program"

fn log_line(op: str, name: str) -> str {
    "{op} {name.len} {name}\n"
}

fn exec_missing() {
    let spawned = fork_exec(Launch { path: missing_program, argv: [missing_program], envp: [] }) catch { _ => return }
    close_on(spawned.pidfd)
}

fn test_record_inputs_logs_each_kind_of_input(t: *testing.T) {
    let dir = file.temp_dir("record") or panic("temp dir")
    let log = "{dir}/inputs.log"
    let data = "{dir}/data.txt"
    let spaced = "{dir}/odd name\nsecond line"
    let before = "{dir}/before"
    let after = "{dir}/after"
    let link = "{dir}/no-link"
    file.write_text(data, "x") or panic("write")
    let out = open(log, Open.Truncate, 0o644) or panic("open log")
    access(before, Access.Present)
    record_inputs(out.fd)
    let opened = open(data, Open.Read, 0) or panic("open data")
    close_on(opened)
    stat(data, true) or panic("stat")
    access(spaced, Access.Present)
    statfs(dir) or panic("statfs")
    list_dir(dir) or panic("list")
    readlink(link) or ""
    exec_missing()
    record_inputs(-1)
    access(after, Access.Present)
    close_on(out)
    let got = file.read_text(log) or panic("read log")
    testing.contains(t, got, log_line("open", data))
    testing.contains(t, got, log_line("stat", data))
    testing.contains(t, got, log_line("stat", spaced))
    testing.contains(t, got, log_line("stat", dir))
    testing.contains(t, got, log_line("list", dir))
    testing.contains(t, got, log_line("readlink", link))
    testing.contains(t, got, log_line("exec", missing_program))
    testing.is_false(t, text.contains(got, before))
    testing.is_false(t, text.contains(got, after))
    file.remove_all(dir) or panic("remove")
}

fn test_record_writes_one_line_per_event(t: *testing.T) {
    let dir = file.temp_dir("record-lines") or panic("temp dir")
    let log = "{dir}/inputs.log"
    let out = open(log, Open.Truncate, 0o644) or panic("open log")
    record_inputs(out.fd)
    record("getenv", "HOME")
    record("environ", "")
    record("chdir", "a b\nc")
    record_inputs(-1)
    record("getenv", "ignored")
    close_on(out)
    let got = file.read_text(log) or panic("read log")
    t.equal(got, "getenv 4 HOME\nenviron 0 \nchdir 5 a b\nc\nredirect 0 \n")
    file.remove_all(dir) or panic("remove")
}
