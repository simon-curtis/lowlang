import std/io

extern "kernel32" {
    fn IsProcessInJob(process: i64, job: i64, mut result: i32) -> i32
    fn QueryInformationJobObject(job: i64, class: i32, info: ptr, size: u32, returned: ptr) -> i32
    fn GetSystemInfo(info: ptr)
}

const job_extended_limit_class: i32 = 9
const job_cpu_rate_class: i32 = 15
const extended_limit_size = 144
const cpu_rate_size = 16
const limit_process_memory = 0x100
const limit_job_memory = 0x200
const cpu_rate_enabled = 1
const cpu_rate_hard_cap = 4
const cpu_rate_scale = 10000.0

fn smallest(a: i64?, b: i64?) -> i64? {
    match a {
        some(x) => match b {
            some(y) => if x < y { x } else { y }
            none => x
        }
        none => b
    }
}

fn memory_limit() -> i64? ! io.Error {
    let info = io.buffer(extended_limit_size)
    checked(QueryInformationJobObject(0, job_extended_limit_class, __slice_ptr(info), u32(extended_limit_size), null))?
    let flags = io.le32(info, 16)
    var process: i64? = none
    var job: i64? = none
    if flags & limit_process_memory != 0 {
        process = io.le64(info, 112)
    }
    if flags & limit_job_memory != 0 {
        job = io.le64(info, 120)
    }
    smallest(process, job)
}

fn processor_count() -> i64 {
    let info = io.buffer(48)
    GetSystemInfo(__slice_ptr(info))
    io.le32(info, 32)
}

fn cpu_limit() -> f64? {
    let info = io.buffer(cpu_rate_size)
    if QueryInformationJobObject(0, job_cpu_rate_class, __slice_ptr(info), u32(cpu_rate_size), null) == 0 {
        return none
    }
    let flags = io.le32(info, 0)
    if flags & cpu_rate_enabled == 0 || flags & cpu_rate_hard_cap == 0 {
        return none
    }
    f64(io.le32(info, 4)) / cpu_rate_scale * f64(processor_count())
}

/// Returns the limits a Windows job object puts on the process.
///
/// Fails with `Unsupported` where the system has no job objects, as Linux has none, and when the process belongs to no job. `cpus` is `none` when the job has no hard CPU cap or the system does not report one.
pub fn job_limits() -> JobLimits ! io.Error {
    var inside: i32 = 0
    checked(IsProcessInJob(GetCurrentProcess(), 0, mut inside))?
    if inside == 0 {
        fail Unsupported
    }
    let memory = memory_limit()?
    let cpus = cpu_limit()
    JobLimits { cpus, memory }
}

/// Returns the limit of the resource number `resource` for this process.
///
/// `resource` is a Linux `RLIMIT_` number. Fails with `Invalid` for a number the kernel does not know and with `Unsupported` on Windows, which has no resource limits.
pub fn get_rlimit(resource: i64) -> Rlimit ! io.Error {
    fail Unsupported
}

/// Sets the soft and hard values of the resource number `resource` for this process.
///
/// Fails with `Invalid` when `limit.soft` exceeds `limit.hard` or `resource` is unknown, with `Denied` when `limit.hard` raises the hard value without the privilege to do so, and with `Unsupported` on Windows.
pub fn set_rlimit(resource: i64, limit: Rlimit) ! io.Error {
    fail Unsupported
}
