import std/io

/// Opens the performance event `e` on the process `pid` and returns its descriptor, which is closed on `exec`.
///
/// The event starts disabled and the kernel enables it when the process next executes a program; it then covers every thread and process the measured one starts. `cpu` names the processor whose activity is measured, and `-1` measures the process wherever it runs, which only an event that counts without sampling allows. A sampling event records the instruction address, the process and thread, the time, the period and the user call chain of each sample, and the programs each process executes and maps, for `map_file` to read through the descriptor. An event with a fixed period records the processor in place of the period, because the kernel samples every software event when it is asked for both. Fails with `Denied` when `/proc/sys/kernel/perf_event_paranoid` keeps the caller from measuring the process or the kernel, `Unsupported` when the machine does not count the event and `Invalid` for a rate above `/proc/sys/kernel/perf_event_max_sample_rate` or an event with both a rate and a period. On Windows it always fails with `Unsupported`.
pub fn perf_open(e: PerfEvent, pid: i64, cpu: i64) -> i64 ! io.Error {
    fail Unsupported
}

/// Returns the number of events the counting event `fd` has seen, summed over every thread and process it covers that has ended and the measured one. On Windows it always fails with `Unsupported`.
pub fn perf_count(fd: i64) -> i64 ! io.Error {
    fail Unsupported
}

/// Returns what the child process `pid` and the descendants it waited for used, or `none` while the child runs.
///
/// The child stays unreaped, so the call can be repeated and the child still has to be waited for. On Windows it always returns `none`.
pub fn child_usage(pid: i64) -> ChildUsage? {
    none
}

/// Restricts the OS thread `thread`, and every thread and process it starts afterwards, to the processors whose bits are set in `mask`.
///
/// `thread` is a thread id as `/proc/self/task` lists them, and `0` is the calling OS thread. Fails with `Invalid` when `mask` names no processor the thread may run on and `Os(3)` when the thread has ended. On Windows it always fails with `Unsupported`.
pub fn set_affinity(thread: i64, mask: u64) ! io.Error {
    fail Unsupported
}
