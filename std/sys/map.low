/// How a mapping may be accessed.
pub enum MapMode {
    /// Read only. Writing to the memory faults.
    ReadOnly
    /// Readable and writable, and writes reach the file and every other shared mapping of it.
    Shared
    /// Readable and writable, and writes are private copies that never reach the file.
    Private
}

/// What the system is told about how a mapping will be used.
pub enum MapAdvice {
    /// No particular pattern.
    Normal
    /// Accesses are in no particular order.
    Random
    /// Accesses run from low addresses to high.
    Sequential
    /// The pages will be needed soon.
    WillNeed
    /// The pages will not be needed soon.
    DontNeed
}

/// Whether `sync_view` waits for the write to finish.
pub enum MapSync {
    /// Returns when the data has been written.
    Wait
    /// Starts the write and returns at once.
    Queue
}

/// A region of address space that `map_file` or `map_memory` created, until `unmap_view` releases it.
///
/// The bytes are outside the garbage collector's heap, so the collector neither scans nor frees them.
pub struct MapView {
    /// The address of the first byte, which is a multiple of the page size.
    pub address: i64
    /// The number of bytes `address` spans, which `unmap_view` releases.
    pub span: i64
    /// The handle `sync_view` flushes on Windows, and `-1` where the system call needs none.
    file: i64
}
