import std/io

const protect_read = 1
const protect_write = 2
const flag_shared = 1
const flag_private = 2
const flag_anonymous = 0x20
const page_size = 4096

fn protection(mode: MapMode) -> i64 {
    match mode {
        ReadOnly => protect_read
        Shared => protect_read | protect_write
        Private => protect_read | protect_write
    }
}

fn sharing(mode: MapMode) -> i64 {
    match mode {
        ReadOnly => flag_shared
        Shared => flag_shared
        Private => flag_private
    }
}

fn map_error(r: i64) -> io.Error {
    match -r {
        12 => TooLarge
        19 => Unsupported
        _ => io.errno(-r)
    }
}

fn mapped(r: i64, length: i64) -> MapView ! io.Error {
    if r < 0 && r > -4096 {
        fail map_error(r)
    }
    MapView { address: r, span: length, file: -1 }
}

/// Returns the granularity that the offset given to `map_file` must be a multiple of.
pub fn map_granularity() -> i64 {
    page_size
}

/// Maps `length` bytes of the file behind `fd`, starting at `offset`, and returns the mapping.
///
/// `offset` must be a multiple of `map_granularity()`. The mapping stays valid after `fd` is closed. Fails with `Denied` when the file was not opened for what `mode` needs, `Invalid` for an `offset` that is not aligned or a `length` of zero, `Unsupported` for a descriptor that cannot be mapped, such as a pipe, and `TooLarge` when the address space is exhausted.
pub fn map_file(fd: i64, mode: MapMode, offset: i64, length: i64) -> MapView ! io.Error {
    let r = __syscall(9, 0, length, protection(mode), sharing(mode), fd, offset)
    mapped(r, length)?
}

/// Maps `length` bytes of zeroed memory that no file backs and returns the mapping.
///
/// Fails with `Invalid` for a `length` of zero and `TooLarge` when the address space is exhausted.
pub fn map_memory(mode: MapMode, length: i64) -> MapView ! io.Error {
    let r = __syscall(9, 0, length, protection(mode), sharing(mode) | flag_anonymous, -1, 0)
    mapped(r, length)?
}

/// Writes the pages of the view that changed to the file behind it.
///
/// `Wait` returns once the data is written and `Queue` starts the write. A view that no file backs has nothing to write.
pub fn sync_view(v: MapView, how: MapSync) ! io.Error {
    let flags = match how {
        Wait => 4
        Queue => 1
    }
    io.syscall_result(__syscall(26, v.address, v.span, flags))?
}

/// Tells the system how the pages of the view will be used.
///
/// On Linux the advice goes to `madvise`, and `DontNeed` makes a `Private` view lose its changes, so that the next read returns the file's bytes or zeros, and leaves the content of a `Shared` view intact. On Windows `WillNeed` prefetches the pages and the other advice does nothing.
pub fn advise_view(v: MapView, advice: MapAdvice) ! io.Error {
    let code = match advice {
        Normal => 0
        Random => 1
        Sequential => 2
        WillNeed => 3
        DontNeed => 4
    }
    io.syscall_result(__syscall(28, v.address, v.span, code))?
}

/// Releases the view.
///
/// Slices over its bytes must not be used afterwards.
pub fn unmap_view(v: MapView) {
    __syscall(11, v.address, v.span)
}
