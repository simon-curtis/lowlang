import std/io

/// The disposition of a signal that `set_disposition` installs.
pub enum Disposition {
    /// The system default for the signal.
    Default
    /// The signal is ignored.
    Ignore
}

/// A signal action, as the kernel stores it for each signal.
pub struct Action {
    /// The address of the handler, or `0` for the default and `1` for ignore.
    pub handler: i64
    /// The action flags.
    pub flags: i64
    /// The address of the code that returns from the handler.
    pub restorer: i64
    /// The set of signals blocked while the handler runs.
    pub mask: i64
}

/// How a child process ended, as `reap` reports it.
pub struct Reaped {
    /// Whether the process ended by itself, as opposed to by a signal.
    pub exited: bool
    /// The exit status when `exited` is `true`, and the signal number otherwise.
    pub value: i64
}

/// The outcome of `fork_exec`.
pub struct Spawned {
    /// The process id of the child.
    pub pid: i64
    /// The process descriptor of the child, which becomes readable when the child ends.
    pub pidfd: FdHandle
    /// The descriptor that addresses the child's process group for `kill_group`: a job object on Windows when `fork_exec` was asked for a group, and an absent descriptor otherwise.
    ///
    /// The caller closes it with `close_on`. Closing it ends every process of the group on Windows, and does not end the group on Linux.
    pub group: FdHandle
    /// The error the child met while changing directory or executing the program, or `none` when the program started.
    ///
    /// The child has exited with status 127 when this is set, and the caller must still reap it.
    pub failure: io.Error?
}

/// The session a child of `fork_exec` runs in.
pub enum Session {
    /// The child stays in the caller's session.
    Same
    /// The child leads a new session with no controlling terminal.
    New
    /// The child leads a new session whose controlling terminal is its standard input, which must be a terminal.
    Terminal
}

/// The user and groups a child of `fork_exec` runs as.
pub struct Identity {
    /// The real, effective and saved user id.
    pub uid: i64
    /// The real, effective and saved group id.
    pub gid: i64
    /// The supplementary group ids.
    pub groups: i64[] = []
}

/// What `fork_exec` starts and how.
pub struct Launch {
    /// The path of the program.
    pub path: str
    /// The whole argument vector, `argv[0]` first.
    pub argv: str[]
    /// The complete environment as `name=value` entries.
    pub envp: str[]
    /// The working directory of the child. An empty string keeps the caller's.
    pub dir: str = ""
    /// Whether the child starts its own process group. On Windows the group is a job object that holds the child and every process it starts, so the child starts suspended, joins the job and then runs; this needs Windows 8 or later when the caller is itself in a job. A grouped child also ends when the caller ends for any reason: on Linux the kernel sends it `SIGKILL` through `PR_SET_PDEATHSIG`, which reaches the child alone, and on Windows the job object has `JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE`, so the system ends every process of the job when it closes the job's handle.
    pub group: bool = false
    /// Whether a console program started on Windows gets a console that has no window. Other targets ignore it.
    pub windowless: bool = false
    /// The descriptor the child receives as standard input. A negative one leaves the caller's.
    pub stdin: i64 = -1
    /// The descriptor the child receives as standard output. A negative one leaves the caller's.
    pub stdout: i64 = -1
    /// The descriptor the child receives as standard error. A negative one leaves the caller's.
    pub stderr: i64 = -1
    /// The descriptors that stay open in the child under their own numbers, besides its standard streams. Every other descriptor of the caller is closed in the child, which takes each kept one with `take_inherited`. On Windows they must be sockets.
    pub keep: i64[] = []
    /// The session the child runs in. A new session is also a new process group. Windows supports only `Same`.
    pub session: Session = Same
    /// The user and groups the child runs as, or `none` for the caller's. Windows supports only `none`.
    pub identity: Identity? = none
    /// The directory the child makes its root before it changes user, then working in its `/` until `dir` is applied inside it, or the empty string to keep the caller's root. Windows supports only the empty string.
    pub root: str = ""
    /// A descriptor open on the program, which the child runs with `execveat` in place of `path`, so it runs a program `root` hides; `path` still names it in `argv[0]`. A negative one runs `path`. Windows supports only a negative one.
    pub program: i64 = -1
}
