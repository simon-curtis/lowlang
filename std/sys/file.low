import std/io

/// How `open` opens a path.
///
/// Every mode closes the descriptor on `exec`.
pub enum Open {
    /// Read only.
    Read
    /// Write only, creating the file with the given mode or truncating it to zero length.
    Truncate
    /// Write only at the end, creating the file with the given mode.
    Append
    /// Read and write, creating the file with the given mode and keeping its content.
    Update
    /// Read only, and the path must be a directory.
    Directory
    /// A descriptor that only names the path, usable for `readlink` of `/proc/self/fd/N` and for nothing else.
    Locate
    /// Read and write a file that must not exist, created with the given mode.
    Fresh
    /// Write only a file that must not exist and is not a symbolic link, created with the given mode.
    FreshNoFollow
    /// Read and write an existing file or device.
    ReadWrite
    /// Read and write a terminal device without making it the controlling terminal.
    Terminal
}

/// What `access` tests for.
pub enum Access {
    /// The path is present.
    Present
    /// The path is present and the caller may execute it.
    Executable
}

/// The advisory lock `lock` takes or releases.
pub enum LockKind {
    /// A lock no other descriptor may share.
    Exclusive
    /// A lock other shared holders may hold too.
    Shared
    /// Releases the lock this descriptor holds.
    Unlock
}

/// The position an offset given to `seek` is measured from.
pub enum Seek {
    /// The beginning of the file.
    FromStart
    /// The current position.
    FromCurrent
    /// The end of the file.
    FromEnd
}

/// The kind of a file system object.
pub enum Kind {
    /// A regular file.
    Regular
    /// A directory.
    Dir
    /// A symbolic link.
    Symlink
    /// Anything else, such as a socket or a device.
    Other
}

/// The attributes of a file as `fstat` and `stat` report them.
pub struct Stat {
    /// The kind of object.
    pub kind: Kind
    /// The size in bytes.
    pub size: i64
    /// The permission bits, including setuid, setgid and sticky, without the file type bits.
    pub mode: i64
    /// The numeric ID of the owning user.
    pub uid: i64
    /// The numeric ID of the owning group.
    pub gid: i64
    /// The ID of the device that holds the file.
    pub device: i64
    /// The inode number.
    pub inode: i64
    /// The access time in whole seconds since the Unix epoch.
    pub accessed: i64
    /// The modification time in whole seconds since the Unix epoch.
    pub modified: i64
}

/// The capacity figures of a file system, as `statfs` reports them.
pub struct Usage {
    /// The size of the file system in bytes.
    pub total: i64
    /// The unused space in bytes, including space reserved for the superuser.
    pub free: i64
    /// The unused space in bytes that an unprivileged process can use.
    pub available: i64
    /// The total number of inodes.
    pub files: i64
    /// The number of unused inodes.
    pub files_free: i64
}

/// An entry of a directory as `list_dir` reports it.
pub struct DirEntry {
    /// The entry's name.
    pub name: str
    /// The kind of the entry itself, or `none` when the file system does not record it.
    pub kind: Kind?
}
