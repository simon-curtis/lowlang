import std/text

/// Why an Ascii85 or Z85 operation failed.
pub enum Error {
    /// A byte is not valid in the alphabet. `at` is its index in the input.
    BadCharacter(at: i64)
    /// The input length is not valid: a final group of one character for `decode`, a length that is not a multiple of 4 for `encode_z85` or of 5 for `decode_z85`.
    BadLength
    /// The `<~` and `~>` delimiters are not both present, or nothing is left between them for the frame to hold.
    BadFrame
    /// A group of five characters encodes a value above `0xFFFFFFFF`. `at` is the index of the group's last character for `decode`, and of its first for `decode_z85`.
    Overflow(at: i64)
}

struct Span {
    start: i64
    end: i64
}

const z85_alphabet = "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ.-:+=^!/*?&<>()[]{{}}@%$#"

fn group_value(data: []u8, at: i64, size: i64) -> u64 {
    var v: u64 = 0
    for i in 0..4 {
        let b = if i < size { u64(data[at + i]) } else { 0 }
        v = v << 8 | b
    }
    v
}

fn digit(v: u64, position: i64) -> i64 {
    var q = v
    for _ in 0..4 - position {
        q = q / 85
    }
    i64(q % 85)
}

fn push_group(mut out: []u8, v: u64, count: i64) {
    for i in 0..count {
        push(mut out, u8(digit(v, i)) + '!')
    }
}

fn push_bytes(mut out: []u8, v: u64, count: i64) {
    for k in 0..count {
        push(mut out, u8(v >> u64(24 - 8 * k)))
    }
}

fn encode_groups(data: []u8) -> str {
    var out: []u8 = []
    var i = 0
    for i < data.len {
        let size = if data.len - i < 4 { data.len - i } else { 4 }
        let v = group_value(data, i, size)
        if size == 4 && v == 0 {
            push(mut out, 'z')
        } else {
            push_group(mut out, v, size + 1)
        }
        i += size
    }
    __str_view(out)
}

fn is_space(c: u8) -> bool {
    c == ' ' || c == '\n' || c == '\r' || c == '\t' || c == 0x0B || c == 0x0C
}

fn framed(s: str) -> Span ! Error {
    var start = 0
    var end = s.len
    for start < end && is_space(s[start]) {
        start += 1
    }
    for end > start && is_space(s[end - 1]) {
        end -= 1
    }
    let opened = end - start >= 2 && s[start] == '<' && s[start + 1] == '~'
    let closed = end - start >= 2 && s[end - 2] == '~' && s[end - 1] == '>'
    if opened != closed {
        fail BadFrame
    }
    if !opened {
        return Span { start: 0, end: s.len }
    }
    if end - start < 4 {
        fail BadFrame
    }
    Span { start: start + 2, end: end - 2 }
}

fn finish(mut out: []u8, v: u64, filled: i64, at: i64) ! Error {
    if filled == 1 {
        fail BadLength
    }
    var value = v
    for _ in filled..5 {
        value = value * 85 + 84
    }
    if value > 0xFFFFFFFF {
        fail Overflow(at)
    }
    push_bytes(mut out, value, filled - 1)
}

/// Returns `data` encoded as Ascii85 without delimiters.
/// Each group of four bytes becomes five characters in `!` to `u`, and a group of four zero bytes becomes `z`. A final group of `n` bytes gives `n + 1` characters.
pub fn encode(data: []u8) -> str {
    encode_groups(data)
}

/// Returns `data` encoded as Ascii85 inside the Adobe `<~` and `~>` delimiters.
pub fn encode_adobe(data: []u8) -> str {
    "<~{encode_groups(data)}~>"
}

/// Decodes Ascii85 text, with or without the Adobe `<~` and `~>` delimiters.
/// Whitespace is ignored, including around the delimiters. `z` stands for four zero bytes and is valid only between groups. A final partial group of 2 to 4 characters yields one byte fewer than its length.
///
/// Fails with `BadFrame` when only one delimiter is present, with `BadCharacter` at the index in `s` of a byte outside `!` to `u`, with `BadLength` when the final group has one character, and with `Overflow` when a group exceeds `0xFFFFFFFF`.
pub fn decode(s: str) -> []u8 ! Error {
    let span = framed(s)?
    var out: []u8 = []
    var v: u64 = 0
    var filled = 0
    var last = span.start
    for i in span.start..span.end {
        let c = s[i]
        if is_space(c) {
            continue
        }
        if c == 'z' && filled == 0 {
            push_bytes(mut out, 0, 4)
            continue
        }
        if c < '!' || c > 'u' {
            fail BadCharacter(i)
        }
        v = v * 85 + u64(c - '!')
        filled += 1
        last = i
        if filled == 5 {
            if v > 0xFFFFFFFF {
                fail Overflow(i)
            }
            push_bytes(mut out, v, 4)
            v = 0
            filled = 0
        }
    }
    if filled > 0 {
        finish(mut out, v, filled, last)?
    }
    out
}

/// Returns `data` encoded as Z85 (ZeroMQ), which uses the 85-character alphabet `0-9a-zA-Z.-:+=^!/*?&<>()[]{}@%$#`.
/// Fails with `BadLength` when `data.len` is not a multiple of 4.
pub fn encode_z85(data: []u8) -> str ! Error {
    if data.len % 4 != 0 {
        fail BadLength
    }
    let alphabet = z85_alphabet
    var out: []u8 = []
    var i = 0
    for i < data.len {
        let v = group_value(data, i, 4)
        for k in 0..5 {
            push(mut out, alphabet[digit(v, k)])
        }
        i += 4
    }
    __str_view(out)
}

/// Decodes Z85 text.
/// The length must be a multiple of 5 and whitespace is not skipped. Fails with `BadLength` otherwise, with `BadCharacter` at the index of the first byte outside the alphabet, and with `Overflow` when a group exceeds `0xFFFFFFFF`.
pub fn decode_z85(s: str) -> []u8 ! Error {
    if s.len % 5 != 0 {
        fail BadLength
    }
    let alphabet = z85_alphabet
    var out: []u8 = []
    var i = 0
    for i < s.len {
        var v: u64 = 0
        for k in 0..5 {
            let d = text.index_byte(alphabet, s[i + k])
            if d < 0 {
                fail BadCharacter(i + k)
            }
            v = v * 85 + u64(d)
        }
        if v > 0xFFFFFFFF {
            fail Overflow(i)
        }
        push_bytes(mut out, v, 4)
        i += 5
    }
    out
}
