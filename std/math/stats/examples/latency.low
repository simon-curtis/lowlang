import std/math/stats
import std/text

struct Sample {
    requests_per_second: f64
    latency_ms: f64
}

fn ms(x: f64) -> str {
    "{text.fixed(x, 2)} ms"
}

fn report(samples: Sample[]) ! stats.Error {
    var load: f64[] = []
    var latency: f64[] = []
    for s in samples {
        load.push(s.requests_per_second)
        latency.push(s.latency_ms)
    }
    print("samples {latency.len}")
    print("mean {ms(stats.mean(latency)?)}")
    print("median {ms(stats.median(latency)?)}")
    print("standard deviation {ms(stats.stddev(latency)?)}")
    print("range {ms(stats.min(latency)?)} to {ms(stats.max(latency)?)}")
    let tail = stats.quantiles(latency, [0.5, 0.9, 0.99])?
    print("p50 {ms(tail[0])}, p90 {ms(tail[1])}, p99 {ms(tail[2])}")
    print("correlation with load {text.fixed(stats.correlation(load, latency)?, 3)}")

    let h = stats.histogram(latency, 4)?
    for i, count in h.counts {
        print("{text.fixed(h.edges[i], 1)} to {text.fixed(h.edges[i + 1], 1)}: {text.repeat("#", count)}")
    }
    let buckets = stats.histogram_edges(latency, [0.0, 20.0, 50.0, 100.0])?
    print("under 20 ms, 20 to 50 ms, 50 ms and over: {buckets.counts}")
}

fn main() {
    let samples = [
        Sample { requests_per_second: 100.0, latency_ms: 12.0 },
        Sample { requests_per_second: 150.0, latency_ms: 14.5 },
        Sample { requests_per_second: 200.0, latency_ms: 15.0 },
        Sample { requests_per_second: 250.0, latency_ms: 19.0 },
        Sample { requests_per_second: 300.0, latency_ms: 24.0 },
        Sample { requests_per_second: 350.0, latency_ms: 31.0 },
        Sample { requests_per_second: 400.0, latency_ms: 45.0 },
        Sample { requests_per_second: 450.0, latency_ms: 72.0 },
    ]
    report(samples) or print("report failed")
    let none: Sample[] = []
    report(none) or print("no samples")
}
