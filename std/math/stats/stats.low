import std/math
import std/slices

/// Why a statistic could not be computed.
pub enum Error {
    /// The input has no values.
    Empty
    /// The input has fewer values than the statistic needs, such as one value for a sample variance.
    TooShort
    /// Two inputs that must pair up have different lengths.
    Mismatch
    /// An input value, or the result, is `nan` or infinite.
    NotFinite
    /// A quantile is outside `0` to `1`, or a percentile outside `0` to `100`.
    Range
    /// A histogram has fewer than one bin.
    Bins
    /// Histogram edges are fewer than two or not strictly increasing.
    Edges
    /// A correlation is undefined because one input has zero variance.
    ZeroVariance
}

/// The bin counts of a set of values.
pub struct Histogram {
    /// The bin boundaries in increasing order. Bin `i` covers `edges[i]` up to `edges[i + 1]`.
    pub edges: f64[]
    /// The number of values in each bin, one fewer than `edges`.
    pub counts: i64[]
}

struct Extent {
    lo: f64
    hi: f64
}

struct Accumulator {
    total: f64
    carry: f64
}

fn accumulate(mut a: Accumulator, x: f64) {
    let t = a.total + x
    if math.abs(a.total) >= math.abs(x) {
        a.carry += (a.total - t) + x
    } else {
        a.carry += (x - t) + a.total
    }
    a.total = t
}

fn value(a: Accumulator) -> f64 {
    a.total + a.carry
}

fn finite(x: f64) -> f64 ! Error {
    if math.is_nan(x) || math.is_inf(x) {
        fail NotFinite
    }
    x
}

fn check(xs: f64[]) ! Error {
    for x in xs {
        finite(x)?
    }
}

fn require(xs: f64[], count: i64) ! Error {
    if xs.len == 0 {
        fail Empty
    }
    if xs.len < count {
        fail TooShort
    }
    check(xs)?
}

fn average(xs: f64[]) -> f64 {
    var a = Accumulator { total: 0.0, carry: 0.0 }
    for x in xs {
        accumulate(mut a, x)
    }
    value(a) / f64(xs.len)
}

fn squares(xs: f64[]) -> f64 {
    let m = average(xs)
    var a = Accumulator { total: 0.0, carry: 0.0 }
    var drift = Accumulator { total: 0.0, carry: 0.0 }
    for x in xs {
        let d = x - m
        accumulate(mut a, d * d)
        accumulate(mut drift, d)
    }
    value(a) - value(drift) * value(drift) / f64(xs.len)
}

fn products(xs: f64[], ys: f64[]) -> f64 {
    let mx = average(xs)
    let my = average(ys)
    var a = Accumulator { total: 0.0, carry: 0.0 }
    var drift_x = Accumulator { total: 0.0, carry: 0.0 }
    var drift_y = Accumulator { total: 0.0, carry: 0.0 }
    for i in 0..xs.len {
        let dx = xs[i] - mx
        let dy = ys[i] - my
        accumulate(mut a, dx * dy)
        accumulate(mut drift_x, dx)
        accumulate(mut drift_y, dy)
    }
    value(a) - value(drift_x) * value(drift_y) / f64(xs.len)
}

fn pair(xs: f64[], ys: f64[], count: i64) ! Error {
    if xs.len != ys.len {
        fail Mismatch
    }
    require(xs, count)?
    check(ys)?
}

fn extent(xs: f64[]) -> Extent {
    var e = Extent { lo: xs[0], hi: xs[0] }
    for x in xs {
        if x < e.lo {
            e.lo = x
        }
        if x > e.hi {
            e.hi = x
        }
    }
    e
}

fn sorted_copy(xs: f64[]) -> f64[] {
    var copy = slices.clone(xs)
    slices.sort(mut copy)
    copy
}

fn lerp(a: f64, b: f64, t: f64) -> f64 {
    let d = b - a
    if math.is_inf(d) {
        return a * (1.0 - t) + b * t
    }
    if t >= 0.5 {
        return b - d * (1.0 - t)
    }
    a + d * t
}

fn interpolate(sorted: f64[], q: f64) -> f64 ! Error {
    if !(q >= 0.0 && q <= 1.0) {
        fail Range
    }
    let h = q * f64(sorted.len - 1)
    let lo = i64(floor(h))
    let hi = math.min(lo + 1, sorted.len - 1)
    finite(lerp(sorted[lo], sorted[hi], h - f64(lo)))?
}

/// Returns the sum of `xs` by Neumaier compensated summation, which keeps the rounding error of each addition instead of letting it accumulate.
///
/// The sum of no values is `0`. Fails with `NotFinite` when a value or the sum is `nan` or infinite.
pub fn sum(xs: f64[]) -> f64 ! Error {
    check(xs)?
    var a = Accumulator { total: 0.0, carry: 0.0 }
    for x in xs {
        accumulate(mut a, x)
    }
    finite(value(a))?
}

/// Returns the arithmetic mean of `xs`, computed from the compensated sum.
///
/// Fails with `Empty` for no values and with `NotFinite` when a value or the result is `nan` or infinite.
pub fn mean(xs: f64[]) -> f64 ! Error {
    require(xs, 1)?
    finite(average(xs))?
}

/// Returns the median of `xs`: the middle value of the sorted values, or the midpoint of the two middle values when there is an even count.
///
/// `xs` is not modified. Fails with `Empty` for no values and with `NotFinite` for a `nan` or infinite value.
pub fn median(xs: f64[]) -> f64 ! Error {
    quantile(xs, 0.5)?
}

/// Returns the smallest value of `xs`.
///
/// Fails with `Empty` for no values and with `NotFinite` for a `nan` or infinite value.
pub fn min(xs: f64[]) -> f64 ! Error {
    require(xs, 1)?
    extent(xs).lo
}

/// Returns the largest value of `xs`.
///
/// Fails with `Empty` for no values and with `NotFinite` for a `nan` or infinite value.
pub fn max(xs: f64[]) -> f64 ! Error {
    require(xs, 1)?
    extent(xs).hi
}

/// Returns the sample variance of `xs`, the sum of squared deviations from the mean divided by `n - 1`.
///
/// The deviations are summed with compensation and corrected for the rounding error of the mean. Fails with `Empty` for no values, with `TooShort` for one value and with `NotFinite` for a `nan` or infinite value or result.
pub fn variance(xs: f64[]) -> f64 ! Error {
    require(xs, 2)?
    finite(math.max(squares(xs), 0.0) / f64(xs.len - 1))?
}

/// Returns the population variance of `xs`, the sum of squared deviations from the mean divided by `n`.
///
/// Fails with `Empty` for no values and with `NotFinite` for a `nan` or infinite value or result. One value has variance `0`.
pub fn population_variance(xs: f64[]) -> f64 ! Error {
    require(xs, 1)?
    finite(math.max(squares(xs), 0.0) / f64(xs.len))?
}

/// Returns the sample standard deviation of `xs`, the square root of `variance`.
///
/// Fails with the errors of `variance`.
pub fn stddev(xs: f64[]) -> f64 ! Error {
    sqrt(variance(xs)?)
}

/// Returns the population standard deviation of `xs`, the square root of `population_variance`.
///
/// Fails with the errors of `population_variance`.
pub fn population_stddev(xs: f64[]) -> f64 ! Error {
    sqrt(population_variance(xs)?)
}

/// Returns the quantile `q` of `xs`, with `q` from `0` (the minimum) to `1` (the maximum).
///
/// The method is linear interpolation between the closest ranks, the default of `numpy.quantile`: with the values sorted, the position is `q * (n - 1)` and the result lies between the values on either side of it in proportion to the fractional part. `xs` need not be sorted and is not modified. Fails with `Empty` for no values, with `Range` when `q` is outside `0` to `1` or is `nan` and with `NotFinite` for a `nan` or infinite value.
pub fn quantile(xs: f64[], q: f64) -> f64 ! Error {
    require(xs, 1)?
    interpolate(sorted_copy(xs), q)?
}

/// Returns the percentile `p` of `xs`, with `p` from `0` to `100`, as `quantile(xs, p / 100)`.
///
/// Fails with `Range` when `p` is outside `0` to `100` or is `nan`, and otherwise with the errors of `quantile`.
pub fn percentile(xs: f64[], p: f64) -> f64 ! Error {
    if !(p >= 0.0 && p <= 100.0) {
        fail Range
    }
    quantile(xs, p / 100.0)?
}

/// Returns the quantile of `xs` for each entry of `qs`, sorting `xs` once.
///
/// The result has one value per entry of `qs`, in the same order, each computed as by `quantile`. Fails like `quantile`.
pub fn quantiles(xs: f64[], qs: f64[]) -> f64[] ! Error {
    require(xs, 1)?
    let sorted = sorted_copy(xs)
    var out: f64[] = []
    for q in qs {
        let value = interpolate(sorted, q)?
        out.push(value)
    }
    out
}

/// Returns the sample covariance of `xs` and `ys`, the sum of the products of their deviations from the means divided by `n - 1`.
///
/// Fails with `Mismatch` when the lengths differ, with `Empty` for no values, with `TooShort` for one value and with `NotFinite` for a `nan` or infinite value or result.
pub fn covariance(xs: f64[], ys: f64[]) -> f64 ! Error {
    pair(xs, ys, 2)?
    finite(products(xs, ys) / f64(xs.len - 1))?
}

/// Returns the population covariance of `xs` and `ys`, the sum of the products of their deviations from the means divided by `n`.
///
/// Fails with `Mismatch` when the lengths differ, with `Empty` for no values and with `NotFinite` for a `nan` or infinite value or result.
pub fn population_covariance(xs: f64[], ys: f64[]) -> f64 ! Error {
    pair(xs, ys, 1)?
    finite(products(xs, ys) / f64(xs.len))?
}

/// Returns the Pearson correlation coefficient of `xs` and `ys`, a value from `-1` to `1`.
///
/// Fails with `Mismatch` when the lengths differ, with `Empty` for no values, with `TooShort` for one value, with `ZeroVariance` when either input is constant and with `NotFinite` for a `nan` or infinite value or result.
pub fn correlation(xs: f64[], ys: f64[]) -> f64 ! Error {
    pair(xs, ys, 2)?
    let sxx = math.max(squares(xs), 0.0)
    let syy = math.max(squares(ys), 0.0)
    if sxx == 0.0 || syy == 0.0 {
        fail ZeroVariance
    }
    let r = finite(products(xs, ys) / (sqrt(sxx) * sqrt(syy)))?
    math.clamp(r, -1.0, 1.0)
}

fn bin_of(edges: f64[], x: f64) -> i64 {
    var lo = 0
    var hi = edges.len - 1
    for hi - lo > 1 {
        let mid = lo + (hi - lo) / 2
        if x >= edges[mid] {
            lo = mid
        } else {
            hi = mid
        }
    }
    lo
}

fn uniform_edges(lo: f64, hi: f64, bins: i64) -> f64[] {
    var edges: f64[] = []
    let step = (hi - lo) / f64(bins)
    for i in 0..bins {
        edges.push(lo + f64(i) * step)
    }
    edges.push(hi)
    edges
}

fn valid_edges(edges: f64[]) ! Error {
    if edges.len < 2 {
        fail Edges
    }
    check(edges)?
    for i in 1..edges.len {
        if edges[i] <= edges[i - 1] {
            fail Edges
        }
    }
}

fn tally(xs: f64[], edges: f64[]) -> Histogram {
    let last = edges.len - 1
    var counts: i64[] = []
    for _ in 0..last {
        counts.push(0)
    }
    for x in xs {
        if x < edges[0] || x > edges[last] {
            continue
        }
        counts[bin_of(edges, x)] += 1
    }
    Histogram { edges: slices.clone(edges), counts }
}

/// Returns the histogram of `xs` with `bins` equal-width bins between its minimum and its maximum.
///
/// The edges are the minimum, then steps of `(max - min) / bins`, then the maximum. Every bin is closed on the left and open on the right except the last, which includes the maximum, as in `numpy.histogram`. When every value is equal the range is widened by `0.5` on each side, as `numpy.histogram` does. Fails with `Bins` when `bins` is less than `1`, with `Empty` for no values, with `NotFinite` for a `nan` or infinite value or width, and with `Edges` when the range is too narrow to hold `bins` distinct edges, as when every value is `1e20` or `bins` is `10` for values one unit in the last place apart.
pub fn histogram(xs: f64[], bins: i64) -> Histogram ! Error {
    if bins < 1 {
        fail Bins
    }
    require(xs, 1)?
    var range = extent(xs)
    if range.lo == range.hi {
        range.lo -= 0.5
        range.hi += 0.5
    }
    let _ = finite(range.hi - range.lo)?
    let edges = uniform_edges(range.lo, range.hi, bins)
    valid_edges(edges)?
    tally(xs, edges)
}

/// Returns the histogram of `xs` over the bins between consecutive `edges`.
///
/// Bin `i` holds the values from `edges[i]` up to but not including `edges[i + 1]`, and the last bin also holds its upper edge. Values outside the first and last edge are not counted, and `xs` may be empty. Fails with `Edges` when there are fewer than two edges or they are not strictly increasing, and with `NotFinite` for a `nan` or infinite value or edge.
pub fn histogram_edges(xs: f64[], edges: f64[]) -> Histogram ! Error {
    valid_edges(edges)?
    check(xs)?
    tally(xs, edges)
}
