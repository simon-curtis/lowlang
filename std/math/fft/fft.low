import std/math
import std/math/complex
import std/slices

fn bins(n: i64) -> i64 {
    if n == 0 {
        return 0
    }
    n / 2 + 1
}

fn is_power_of_two(n: i64) -> bool {
    n > 0 && n & (n - 1) == 0
}

fn next_power_of_two(n: i64) -> i64 {
    var p = 1
    for p < n {
        p <<= 1
    }
    p
}

fn twiddles(n: i64) -> complex.Complex[] {
    var table: complex.Complex[] = []
    for k in 0..n / 2 {
        let angle = -math.tau * f64(k) / f64(n)
        let w = complex.Complex { re: math.cos(angle), im: math.sin(angle) }
        table.push(w)
    }
    table
}

fn radix2(xs: complex.Complex[]) -> complex.Complex[] {
    let n = xs.len
    var out: complex.Complex[] = []
    for _ in 0..n {
        out.push(complex.Complex { re: 0.0, im: 0.0 })
    }
    var bits = 0
    var span = 1
    for span < n {
        span <<= 1
        bits += 1
    }
    for i in 0..n {
        var reversed = 0
        for b in 0..bits {
            if i >> b & 1 == 1 {
                reversed |= 1 << (bits - 1 - b)
            }
        }
        out[reversed] = xs[i]
    }
    let table = twiddles(n)
    var size = 2
    for size <= n {
        let half = size / 2
        let stride = n / size
        var start = 0
        for start < n {
            for k in 0..half {
                let w = table[k * stride]
                let a = out[start + k]
                let b = complex.mul(w, out[start + k + half])
                out[start + k] = complex.add(a, b)
                out[start + k + half] = complex.sub(a, b)
            }
            start += size
        }
        size <<= 1
    }
    out
}

fn chirp(n: i64) -> complex.Complex[] {
    var table: complex.Complex[] = []
    let period = 2 * n
    for k in 0..n {
        let angle = -math.pi * f64(k * k % period) / f64(n)
        let w = complex.Complex { re: math.cos(angle), im: math.sin(angle) }
        table.push(w)
    }
    table
}

fn bluestein(xs: complex.Complex[]) -> complex.Complex[] {
    let n = xs.len
    let m = next_power_of_two(2 * n - 1)
    let w = chirp(n)
    let zero = complex.Complex { re: 0.0, im: 0.0 }
    var a: complex.Complex[] = []
    var b: complex.Complex[] = []
    for _ in 0..m {
        a.push(zero)
        b.push(zero)
    }
    for k in 0..n {
        a[k] = complex.mul(xs[k], w[k])
        b[k] = complex.conj(w[k])
        if k > 0 {
            b[m - k] = complex.conj(w[k])
        }
    }
    let product = radix2(a)
    let kernel = radix2(b)
    var spectrum: complex.Complex[] = []
    for i in 0..m {
        spectrum.push(complex.conj(complex.mul(product[i], kernel[i])))
    }
    let back = radix2(spectrum)
    var out: complex.Complex[] = []
    for k in 0..n {
        let c = complex.scale(complex.conj(back[k]), 1.0 / f64(m))
        out.push(complex.mul(c, w[k]))
    }
    out
}

/// Returns the discrete Fourier transform `X[k] = sum over j of x[j] * exp(-2 * pi * i * j * k / n)` of `xs`.
///
/// A power-of-two length uses an iterative radix-2 transform and any other length uses Bluestein's algorithm, which rewrites the transform as a convolution evaluated with power-of-two transforms, so every length takes `O(n log n)` time. Twiddle factors come from `cos` and `sin` directly, not from a recurrence. An empty input gives an empty result and `xs` is not modified.
pub fn forward(xs: complex.Complex[]) -> complex.Complex[] {
    if xs.len <= 1 {
        return slices.clone(xs)
    }
    if is_power_of_two(xs.len) {
        return radix2(xs)
    }
    bluestein(xs)
}

/// Returns the inverse discrete Fourier transform of `xs`, `x[j] = (1 / n) * sum over k of X[k] * exp(2 * pi * i * j * k / n)`, so that `inverse(forward(xs))` returns `xs` up to rounding.
///
/// Any length is accepted as for `forward`. An empty input gives an empty result.
pub fn inverse(xs: complex.Complex[]) -> complex.Complex[] {
    var conjugated: complex.Complex[] = []
    for x in xs {
        conjugated.push(complex.conj(x))
    }
    let transformed = forward(conjugated)
    var out: complex.Complex[] = []
    for x in transformed {
        out.push(complex.scale(complex.conj(x), 1.0 / f64(xs.len)))
    }
    out
}

/// Returns the first `n / 2 + 1` bins of the discrete Fourier transform of the real signal `xs`, the bins from frequency zero to the Nyquist frequency.
///
/// The remaining bins of the full transform are the conjugates of these in reverse order, so nothing is lost. The result matches `numpy.fft.rfft`. An empty input gives an empty result.
pub fn forward_real(xs: f64[]) -> complex.Complex[] {
    var promoted: complex.Complex[] = []
    for x in xs {
        promoted.push(complex.Complex { re: x, im: 0.0 })
    }
    let full = forward(promoted)
    var out: complex.Complex[] = []
    for k in 0..bins(xs.len) {
        out.push(full[k])
    }
    out
}

/// Returns the real signal of length `n` whose first `n / 2 + 1` transform bins are `spectrum`, the inverse of `forward_real`.
///
/// The imaginary part of the first bin, and of the last when `n` is even, is ignored, as in `numpy.fft.irfft`. Panics when `n` is negative or `spectrum` does not have `n / 2 + 1` bins, none for `n` of `0`.
pub fn inverse_real(spectrum: complex.Complex[], n: i64) -> f64[] {
    if n < 0 || spectrum.len != bins(n) {
        panic("fft: the spectrum must have n / 2 + 1 bins")
    }
    var full: complex.Complex[] = []
    for k in 0..n {
        if k <= n / 2 {
            full.push(spectrum[k])
        } else {
            full.push(complex.conj(spectrum[n - k]))
        }
    }
    if n > 0 {
        full[0].im = 0.0
    }
    if n > 0 && n % 2 == 0 {
        full[n / 2].im = 0.0
    }
    var out: f64[] = []
    for x in inverse(full) {
        out.push(x.re)
    }
    out
}
