import std/math
import std/math/complex
import std/math/fft
import std/text

fn main() {
    let rate = 100.0
    let n = 100
    var signal: []f64 = []
    for i in 0..n {
        let t = f64(i) / rate
        push(mut signal, 3.0 * math.sin(math.tau * 5.0 * t) + 1.5 * math.cos(math.tau * 12.0 * t) + 0.5)
    }

    let spectrum = fft.forward_real(signal)
    print("{n} samples give {spectrum.len} bins, {text.fixed(rate / f64(n), 1)} Hz apart")
    for k, bin in spectrum {
        let amplitude = complex.abs(bin) / f64(n) * 2.0
        if amplitude > 0.01 {
            print("{text.fixed(f64(k) * rate / f64(n), 1)} Hz: amplitude {text.fixed(amplitude, 3)}")
        }
    }

    let restored = fft.inverse_real(spectrum, n)
    var worst = 0.0
    for i in 0..n {
        worst = math.max(worst, math.abs(restored[i] - signal[i]))
    }
    print("round trip error below 1e-9: {worst < 1e-9}")

    let a = [complex.complex(1.0, 0.0), complex.complex(2.0, 0.0), complex.complex(3.0, 0.0)]
    let b = [complex.complex(0.0, 0.0), complex.complex(1.0, 0.0), complex.complex(0.5, 0.0)]
    let fa = fft.forward(a)
    let fb = fft.forward(b)
    var product: []complex.Complex = []
    for k in 0..a.len {
        push(mut product, complex.mul(fa[k], fb[k]))
    }
    var cells: []str = []
    for z in fft.inverse(product) {
        push(mut cells, text.fixed(z.re, 3))
    }
    let joined = text.join(cells, " ")
    print("circular convolution of 1 2 3 and 0 1 0.5: {joined}")
}
