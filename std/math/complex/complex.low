import std/math
import std/text

/// A complex number `re + im * i` with `f64` parts.
///
/// Arithmetic follows IEEE 754 for the parts: overflow gives infinities and an undefined result gives `nan`. Two values are equal with `==` when both parts are equal.
pub struct Complex {
    /// The real part.
    pub re: f64
    /// The imaginary part.
    pub im: f64
}

/// A complex number in polar form.
pub struct Polar {
    /// The distance from the origin, never negative for a value `polar` returns.
    pub radius: f64
    /// The angle from the positive real axis in radians, in the range `-pi` to `pi` for a value `polar` returns.
    pub angle: f64
}

/// Returns the complex number with real part `re` and imaginary part `im`.
pub fn complex(re: f64, im: f64) -> Complex {
    Complex { re, im }
}

/// Returns `a + b`.
pub fn add(a: Complex, b: Complex) -> Complex {
    Complex { re: a.re + b.re, im: a.im + b.im }
}

/// Returns `a - b`.
pub fn sub(a: Complex, b: Complex) -> Complex {
    Complex { re: a.re - b.re, im: a.im - b.im }
}

/// Returns `a * b`.
pub fn mul(a: Complex, b: Complex) -> Complex {
    Complex { re: a.re * b.re - a.im * b.im, im: a.re * b.im + a.im * b.re }
}

/// Returns `a / b` by Smith's method, which scales by the larger part of `b` so that the intermediate products do not overflow or underflow when the quotient is representable.
///
/// Dividing by zero divides each part of `a` by zero, which gives an infinity for a nonzero part and `nan` for a zero part.
pub fn div(a: Complex, b: Complex) -> Complex {
    if b.re == 0.0 && b.im == 0.0 {
        return Complex { re: a.re / b.re, im: a.im / b.re }
    }
    if math.abs(b.re) >= math.abs(b.im) {
        let ratio = b.im / b.re
        let scale = b.re + b.im * ratio
        return Complex { re: (a.re + a.im * ratio) / scale, im: (a.im - a.re * ratio) / scale }
    }
    let ratio = b.re / b.im
    let scale = b.re * ratio + b.im
    Complex { re: (a.re * ratio + a.im) / scale, im: (a.im * ratio - a.re) / scale }
}

/// Returns `-z`.
pub fn neg(z: Complex) -> Complex {
    Complex { re: -z.re, im: -z.im }
}

/// Returns `z` with both parts multiplied by the real number `k`.
pub fn scale(z: Complex, k: f64) -> Complex {
    Complex { re: z.re * k, im: z.im * k }
}

/// Returns the complex conjugate of `z`, which has the imaginary part negated.
pub fn conj(z: Complex) -> Complex {
    Complex { re: z.re, im: -z.im }
}

/// Returns the magnitude of `z`, computed with `hypot` so that it does not overflow for a representable result.
pub fn abs(z: Complex) -> f64 {
    math.hypot(z.re, z.im)
}

/// Returns the argument of `z`, its angle from the positive real axis in radians in the range `-pi` to `pi`.
///
/// The argument of zero is `0`.
pub fn arg(z: Complex) -> f64 {
    math.atan2(z.im, z.re)
}

/// Returns `z` as a radius and an angle.
pub fn polar(z: Complex) -> Polar {
    Polar { radius: abs(z), angle: arg(z) }
}

/// Returns the complex number with magnitude `radius` and argument `angle`, which is `radius * (cos(angle) + i * sin(angle))`.
pub fn rect(radius: f64, angle: f64) -> Complex {
    Complex { re: radius * math.cos(angle), im: radius * math.sin(angle) }
}

/// Returns `e` raised to the power `z`.
pub fn cexp(z: Complex) -> Complex {
    rect(exp(z.re), z.im)
}

/// Returns the principal natural logarithm of `z`, which has an imaginary part in the range `-pi` to `pi`.
///
/// The logarithm of zero has a real part of negative infinity.
pub fn clog(z: Complex) -> Complex {
    Complex { re: math.log(abs(z)), im: arg(z) }
}

/// Returns the principal square root of `z`, the root with a non-negative real part.
///
/// For a negative real `z` the sign of the imaginary part of the result follows the sign of the imaginary part of `z`, so the square root of `-4` is `2i` and of `-4 - 0i` is `-2i`.
pub fn csqrt(z: Complex) -> Complex {
    if z.re == 0.0 && z.im == 0.0 {
        return Complex { re: 0.0, im: z.im }
    }
    let t = sqrt(math.abs(z.re) / 2.0 + abs(z) / 2.0)
    let negative = text.float_bits(z.im) >> 63 == 1
    if z.re >= 0.0 {
        return Complex { re: t, im: z.im / (2.0 * t) }
    }
    if negative {
        return Complex { re: math.abs(z.im) / (2.0 * t), im: -t }
    }
    Complex { re: math.abs(z.im) / (2.0 * t), im: t }
}

/// Returns `z` raised to the complex power `w`, as `exp(w * log(z))` with the principal logarithm.
///
/// Any `z` raised to zero is `1`, and zero raised to a power with a positive real part is `0`.
pub fn cpow(z: Complex, w: Complex) -> Complex {
    if w.re == 0.0 && w.im == 0.0 {
        return Complex { re: 1.0, im: 0.0 }
    }
    if z.re == 0.0 && z.im == 0.0 {
        if w.re > 0.0 {
            return Complex { re: 0.0, im: 0.0 }
        }
        return Complex { re: math.infinity, im: math.nan }
    }
    cexp(mul(w, clog(z)))
}

/// Returns `z` raised to the integer power `n` by repeated squaring, which is exact for small integer parts where `cpow` rounds.
///
/// A negative `n` gives the reciprocal of the positive power, and `n` of zero gives `1`.
pub fn pow_int(z: Complex, n: i64) -> Complex {
    var result = Complex { re: 1.0, im: 0.0 }
    var base = z
    var k = u64(n)
    if n < 0 {
        k = u64(0) - k
    }
    for k > 0 {
        if k & 1 == 1 {
            result = mul(result, base)
        }
        base = mul(base, base)
        k >>= 1
    }
    if n < 0 {
        return div(Complex { re: 1.0, im: 0.0 }, result)
    }
    result
}

fn part(x: f64, places: i64) -> str {
    if places < 0 {
        return text.float_decimal(x)
    }
    text.fixed(x, places)
}

fn signed(x: f64, places: i64) -> str {
    if math.is_nan(x) {
        return "+NaN"
    }
    if text.float_bits(x) >> 63 == 1 {
        return part(x, places)
    }
    "+{part(x, places)}"
}

/// Returns `z` as text such as `1.5+2.0i` or `-3.0-0.25i`, with each part in the shortest decimal form that reads back as the same `f64`.
///
/// A `nan` part prints as `NaN` and an infinite part as `inf` or `-inf`.
pub fn format(z: Complex) -> str {
    "{part(z.re, -1)}{signed(z.im, -1)}i"
}

/// Returns `z` as text such as `1.50+2.00i`, with each part rounded to `places` digits after the decimal point as by `text.fixed`.
///
/// A negative `places` is treated as `0`.
pub fn format_fixed(z: Complex, places: i64) -> str {
    let digits = math.max(places, 0)
    "{part(z.re, digits)}{signed(z.im, digits)}i"
}
