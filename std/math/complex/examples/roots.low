import std/math
import std/math/complex
import std/text

fn tidy(x: f64) -> f64 {
    if math.abs(x) < 1e-9 {
        return 0.0
    }
    x
}

fn show(z: complex.Complex) -> str {
    complex.format_fixed(complex.complex(tidy(z.re), tidy(z.im)), 3)
}

fn quadratic(a: f64, b: f64, c: f64) {
    let discriminant = complex.complex(b * b - 4.0 * a * c, 0.0)
    let root = complex.csqrt(discriminant)
    let denominator = complex.complex(2.0 * a, 0.0)
    let first = complex.div(complex.sub(complex.complex(-b, 0.0), root), denominator)
    let second = complex.div(complex.add(complex.complex(-b, 0.0), root), denominator)
    print("{a}x^2 + {b}x + {c} = 0 has roots {show(first)} and {show(second)}")
}

fn main() {
    quadratic(1.0, -3.0, 2.0)
    quadratic(1.0, 2.0, 5.0)
    quadratic(2.0, 0.0, 8.0)

    let n = 6
    var total = complex.complex(0.0, 0.0)
    for k in 0..n {
        let root = complex.rect(1.0, math.tau * f64(k) / f64(n))
        total = complex.add(total, root)
        print("root {k} of unity: {show(root)}, sixth power {show(complex.pow_int(root, n))}")
    }
    print("sum of the roots: {show(total)}")

    let z = complex.complex(3.0, 4.0)
    let p = complex.polar(z)
    print("z = {complex.format(z)}, |z| = {p.radius}, arg z = {text.fixed(p.angle, 4)}")
    print("conjugate {complex.format(complex.conj(z))}, product with it {complex.format(complex.mul(z, complex.conj(z)))}")
    print("e^(i pi) = {show(complex.cexp(complex.complex(0.0, math.pi)))}")
    print("log(-1) = {show(complex.clog(complex.complex(-1.0, 0.0)))}")
    print("i^i = {show(complex.cpow(complex.complex(0.0, 1.0), complex.complex(0.0, 1.0)))}")
    print("(1e300 + 1e300i) / (1e300 + 1e300i) = {complex.format(complex.div(complex.complex(1e300, 1e300), complex.complex(1e300, 1e300)))}")
}
