import std/math/matrix
import std/text

fn row(m: matrix.Matrix, r: i64) -> str {
    var cells: []str = []
    for c in 0..m.cols {
        push(mut cells, text.fixed(matrix.get(m, r, c), 3))
    }
    text.join(cells, " ")
}

fn show(label: str, m: matrix.Matrix) {
    print("{label}:")
    for r in 0..m.rows {
        print("  {row(m, r)}")
    }
}

fn invert_or_report(m: matrix.Matrix) {
    let inverse = matrix.inverse(m) catch {
        Singular => {
            print("matrix is singular, determinant {text.fixed(matrix.determinant(m), 1)}")
            return
        }
    }
    show("inverse", inverse)
}

fn main() {
    let a = matrix.from_rows([[2.0, 1.0, 1.0], [4.0, -6.0, 0.0], [-2.0, 7.0, 2.0]])
    print("determinant {text.fixed(matrix.determinant(a), 3)}")
    let x = matrix.solve(a, [5.0, -2.0, 9.0]) or return
    let parts = [text.fixed(x[0], 3), text.fixed(x[1], 3), text.fixed(x[2], 3)]
    print("solution {text.join(parts, " ")}")
    let inverse = matrix.inverse(a) or return
    show("inverse", inverse)
    show("a times its inverse", matrix.multiply(a, inverse))

    let f = matrix.lu(a) or return
    show("lower", matrix.lower(f))
    show("upper", matrix.upper(f))
    print("row order {f.pivots}")

    invert_or_report(matrix.from_rows([[1.0, 2.0], [2.0, 4.0]]))

    let design = matrix.from_rows([[1.0, 1.0], [1.0, 2.0], [1.0, 3.0], [1.0, 4.0], [1.0, 5.0]])
    let observed = [2.2, 2.8, 4.5, 3.7, 5.5]
    let fit = matrix.least_squares(design, observed) or return
    print("line of best fit: y = {text.fixed(fit[0], 3)} + {text.fixed(fit[1], 3)} x")

    let f2 = matrix.qr(design)
    show("r factor", f2.r)
    let rebuilt = matrix.multiply(f2.q, f2.r)
    print("q times r, first row: {row(rebuilt, 0)}")
}
