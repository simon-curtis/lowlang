import std/math
import std/slices

const epsilon = 2.220446049250313e-16

/// Why a factorisation or a solve failed.
pub enum Error {
    /// The matrix is singular: elimination met a pivot that is exactly zero, or a least-squares column is linearly dependent on the earlier ones to within rounding.
    Singular
}

/// A dense matrix of `f64` stored row by row.
///
/// Element `(r, c)` is `data[r * cols + c]`. Both dimensions are at least `1`. Assigning or passing a matrix shares its `data`, as for a slice; `clone` copies it. Functions that take a matrix of the wrong shape, and `get` and `set` with an index outside it, panic with a message that starts with `matrix:`, as `std/slices` does for misuse. Only a singular matrix is an error value.
pub struct Matrix {
    /// The number of rows.
    pub rows: i64
    /// The number of columns.
    pub cols: i64
    /// The elements in row-major order, `rows * cols` of them.
    pub data: f64[]
}

/// An LU factorisation with partial pivoting: `P * A = L * U`.
pub struct LU {
    /// `L` below the diagonal, without its unit diagonal, and `U` on and above the diagonal.
    pub factors: Matrix
    /// Row `i` of `P * A` is row `pivots[i]` of `A`.
    pub pivots: i64[]
    /// `1` when an even number of row swaps was made and `-1` when odd.
    pub sign: f64
}

/// A thin QR factorisation by Householder reflections: `A = Q * R`.
pub struct QR {
    /// The `rows` by `cols` matrix `Q`, whose columns are orthonormal.
    pub q: Matrix
    /// The `cols` by `cols` upper triangular matrix `R`.
    pub r: Matrix
}

fn require_shape(rows: i64, cols: i64) {
    if rows < 1 || cols < 1 {
        panic("matrix: dimensions must be at least 1")
    }
}

fn require_square(m: Matrix) {
    if m.rows != m.cols {
        panic("matrix: the matrix must be square")
    }
}

fn require_same(a: Matrix, b: Matrix) {
    if a.rows != b.rows || a.cols != b.cols {
        panic("matrix: the matrices must have the same shape")
    }
}

fn require_index(m: Matrix, r: i64, c: i64) {
    if r < 0 || r >= m.rows || c < 0 || c >= m.cols {
        panic("matrix: index out of range")
    }
}

/// Returns a matrix of `rows` by `cols` zeros.
///
/// Panics when either dimension is less than `1`.
pub fn zeros(rows: i64, cols: i64) -> Matrix {
    require_shape(rows, cols)
    var data: f64[] = []
    for _ in 0..rows * cols {
        data.push(0.0)
    }
    Matrix { rows, cols, data }
}

/// Returns the `n` by `n` identity matrix.
///
/// Panics when `n` is less than `1`.
pub fn identity(n: i64) -> Matrix {
    let m = zeros(n, n)
    for i in 0..n {
        m.data[i * n + i] = 1.0
    }
    m
}

/// Returns a matrix of `rows` by `cols` holding a copy of `data` in row-major order.
///
/// Panics when a dimension is less than `1` or `data` does not hold exactly `rows * cols` values.
pub fn from_data(rows: i64, cols: i64, data: f64[]) -> Matrix {
    require_shape(rows, cols)
    if data.len != rows * cols {
        panic("matrix: data length must equal rows * cols")
    }
    Matrix { rows, cols, data: slices.clone(data) }
}

/// Returns a matrix whose rows are copies of the slices in `rows`.
///
/// Panics when there are no rows, a row is empty or the rows differ in length.
pub fn from_rows(rows: f64[][]) -> Matrix {
    if rows.len == 0 {
        panic("matrix: dimensions must be at least 1")
    }
    let cols = rows[0].len
    var data: f64[] = []
    for row in rows {
        if row.len != cols {
            panic("matrix: the rows must have the same length")
        }
        for x in row {
            data.push(x)
        }
    }
    from_data(rows.len, cols, data)
}

/// Returns a copy of `m` that shares no storage with it.
pub fn clone(m: Matrix) -> Matrix {
    Matrix { rows: m.rows, cols: m.cols, data: slices.clone(m.data) }
}

/// Returns the element of `m` in row `r` and column `c`, both counted from `0`.
///
/// Panics when the position is outside `m`.
pub fn get(m: Matrix, r: i64, c: i64) -> f64 {
    require_index(m, r, c)
    m.data[r * m.cols + c]
}

/// Sets the element of `m` in row `r` and column `c`, both counted from `0`, to `v`.
///
/// Panics when the position is outside `m`.
pub fn set(mut m: Matrix, r: i64, c: i64, v: f64) {
    require_index(m, r, c)
    m.data[r * m.cols + c] = v
}

/// Returns the transpose of `m`, which has `cols` rows and `rows` columns.
pub fn transpose(m: Matrix) -> Matrix {
    let t = zeros(m.cols, m.rows)
    for r in 0..m.rows {
        for c in 0..m.cols {
            t.data[c * m.rows + r] = m.data[r * m.cols + c]
        }
    }
    t
}

/// Returns the element-wise sum of `a` and `b`.
///
/// Panics when the shapes differ.
pub fn add(a: Matrix, b: Matrix) -> Matrix {
    require_same(a, b)
    let out = zeros(a.rows, a.cols)
    for i in 0..a.data.len {
        out.data[i] = a.data[i] + b.data[i]
    }
    out
}

/// Returns the element-wise difference `a - b`.
///
/// Panics when the shapes differ.
pub fn sub(a: Matrix, b: Matrix) -> Matrix {
    require_same(a, b)
    let out = zeros(a.rows, a.cols)
    for i in 0..a.data.len {
        out.data[i] = a.data[i] - b.data[i]
    }
    out
}

/// Returns `m` with every element multiplied by `k`.
pub fn scale(m: Matrix, k: f64) -> Matrix {
    let out = zeros(m.rows, m.cols)
    for i in 0..m.data.len {
        out.data[i] = m.data[i] * k
    }
    out
}

/// Returns the matrix product `a * b`, which has `a.rows` rows and `b.cols` columns.
///
/// Panics when `a.cols` differs from `b.rows`.
pub fn multiply(a: Matrix, b: Matrix) -> Matrix {
    if a.cols != b.rows {
        panic("matrix: the columns of the left matrix must equal the rows of the right")
    }
    let out = zeros(a.rows, b.cols)
    for i in 0..a.rows {
        for k in 0..a.cols {
            let x = a.data[i * a.cols + k]
            for j in 0..b.cols {
                out.data[i * b.cols + j] += x * b.data[k * b.cols + j]
            }
        }
    }
    out
}

/// Returns the product of `m` and the column vector `x`, which has `m.rows` entries.
///
/// Panics when `x` does not have `m.cols` entries.
pub fn multiply_vector(m: Matrix, x: f64[]) -> f64[] {
    if x.len != m.cols {
        panic("matrix: the vector length must equal the columns of the matrix")
    }
    var out: f64[] = []
    for r in 0..m.rows {
        var total = 0.0
        for c in 0..m.cols {
            total += m.data[r * m.cols + c] * x[c]
        }
        out.push(total)
    }
    out
}

fn swap_rows(mut m: Matrix, a: i64, b: i64) {
    for c in 0..m.cols {
        let t = m.data[a * m.cols + c]
        m.data[a * m.cols + c] = m.data[b * m.cols + c]
        m.data[b * m.cols + c] = t
    }
}

/// Returns the LU factorisation of the square matrix `m` with partial pivoting.
///
/// Each step takes the row with the largest absolute value in the column as the pivot, the first such row on a tie. Fails with `Singular` when the best pivot is exactly zero, so a matrix that is singular only up to rounding factorises and gives large results. Panics when `m` is not square. `m` is not modified.
pub fn lu(m: Matrix) -> LU ! Error {
    require_square(m)
    let n = m.rows
    var f = clone(m)
    var pivots: i64[] = []
    for i in 0..n {
        pivots.push(i)
    }
    var sign = 1.0
    for k in 0..n {
        var best = k
        for i in k + 1..n {
            if math.abs(f.data[i * n + k]) > math.abs(f.data[best * n + k]) {
                best = i
            }
        }
        if f.data[best * n + k] == 0.0 {
            fail Singular
        }
        if best != k {
            swap_rows(mut f, k, best)
            slices.swap(mut pivots, k, best)
            sign = -sign
        }
        let pivot = f.data[k * n + k]
        for i in k + 1..n {
            let factor = f.data[i * n + k] / pivot
            f.data[i * n + k] = factor
            for j in k + 1..n {
                f.data[i * n + j] -= factor * f.data[k * n + j]
            }
        }
    }
    LU { factors: f, pivots, sign }
}

/// Returns the unit lower triangular factor `L` of `f`.
pub fn lower(f: LU) -> Matrix {
    let n = f.factors.rows
    let l = identity(n)
    for r in 0..n {
        for c in 0..r {
            l.data[r * n + c] = f.factors.data[r * n + c]
        }
    }
    l
}

/// Returns the upper triangular factor `U` of `f`.
pub fn upper(f: LU) -> Matrix {
    let n = f.factors.rows
    let u = zeros(n, n)
    for r in 0..n {
        for c in r..n {
            u.data[r * n + c] = f.factors.data[r * n + c]
        }
    }
    u
}

/// Returns the permutation matrix `P` of `f`, for which `P * A = L * U`.
pub fn permutation(f: LU) -> Matrix {
    let n = f.factors.rows
    let p = zeros(n, n)
    for i in 0..n {
        p.data[i * n + f.pivots[i]] = 1.0
    }
    p
}

/// Returns the determinant of the matrix `f` factorises, the product of the diagonal of `U` with the sign of the permutation.
pub fn lu_determinant(f: LU) -> f64 {
    let n = f.factors.rows
    var d = f.sign
    for i in 0..n {
        d *= f.factors.data[i * n + i]
    }
    d
}

/// Returns the solution `x` of `A * x = b` for the matrix `f` factorises, by forward and back substitution.
///
/// Panics when `b` does not have one entry per row of the matrix.
pub fn lu_solve(f: LU, b: f64[]) -> f64[] {
    let n = f.factors.rows
    if b.len != n {
        panic("matrix: the right-hand side must have one entry per row")
    }
    var x: f64[] = []
    for i in 0..n {
        var total = b[f.pivots[i]]
        for j in 0..i {
            total -= f.factors.data[i * n + j] * x[j]
        }
        x.push(total)
    }
    for i in 0..n {
        let row = n - 1 - i
        var total = x[row]
        for j in row + 1..n {
            total -= f.factors.data[row * n + j] * x[j]
        }
        x[row] = total / f.factors.data[row * n + row]
    }
    x
}

/// Returns the determinant of the square matrix `m`, which is exactly `0` when `lu` finds `m` singular.
///
/// Panics when `m` is not square.
pub fn determinant(m: Matrix) -> f64 {
    let f = lu(m) or return 0.0
    lu_determinant(f)
}

/// Returns the solution `x` of `a * x = b` by LU decomposition.
///
/// Fails with `Singular` as `lu` does. Panics when `a` is not square or `b` does not have one entry per row of `a`.
pub fn solve(a: Matrix, b: f64[]) -> f64[] ! Error {
    let f = lu(a)?
    lu_solve(f, b)
}

/// Returns the inverse of the square matrix `m`, found by solving against each column of the identity.
///
/// Fails with `Singular` as `lu` does. Panics when `m` is not square.
pub fn inverse(m: Matrix) -> Matrix ! Error {
    let f = lu(m)?
    let n = m.rows
    let out = zeros(n, n)
    for c in 0..n {
        var unit: f64[] = []
        for r in 0..n {
            if r == c {
                unit.push(1.0)
            } else {
                unit.push(0.0)
            }
        }
        let column = lu_solve(f, unit)
        for r in 0..n {
            out.data[r * n + c] = column[r]
        }
    }
    out
}

struct Reflector {
    v: f64[]
    beta: f64
    alpha: f64
}

fn reflector(r: Matrix, k: i64) -> Reflector {
    var v: f64[] = []
    for _ in 0..r.rows {
        v.push(0.0)
    }
    var tail = 0.0
    for i in k + 1..r.rows {
        v[i] = r.data[i * r.cols + k]
        tail += v[i] * v[i]
    }
    let head = r.data[k * r.cols + k]
    if tail == 0.0 {
        return Reflector { v, beta: 0.0, alpha: head }
    }
    let norm = sqrt(head * head + tail)
    var alpha = 0.0 - norm
    if head < 0.0 {
        alpha = norm
    }
    v[k] = head - alpha
    Reflector { v, beta: 2.0 / (v[k] * v[k] + tail), alpha }
}

fn reflect(mut m: Matrix, h: Reflector, k: i64, first: i64, last: i64) {
    for j in first..last {
        var dot = 0.0
        for i in k..m.rows {
            dot += h.v[i] * m.data[i * m.cols + j]
        }
        let s = h.beta * dot
        for i in k..m.rows {
            m.data[i * m.cols + j] -= s * h.v[i]
        }
    }
}

/// Returns the thin QR factorisation of `m` by Householder reflections.
///
/// Each reflection takes `alpha = -sign(m[k][k]) * norm` for the diagonal entry, so the diagonal of `R` has the signs that LAPACK and `numpy.linalg.qr` give. A column that is already zero below the diagonal is left alone. A rank-deficient `m` factorises without error; `least_squares` reports it. Panics when `m` has fewer rows than columns. `m` is not modified.
pub fn qr(m: Matrix) -> QR {
    if m.rows < m.cols {
        panic("matrix: QR needs at least as many rows as columns")
    }
    let n = m.cols
    var work = clone(m)
    var steps: Reflector[] = []
    for k in 0..n {
        let h = reflector(work, k)
        if h.beta != 0.0 {
            reflect(mut work, h, k, k + 1, n)
            work.data[k * n + k] = h.alpha
            for i in k + 1..m.rows {
                work.data[i * n + k] = 0.0
            }
        }
        steps.push(h)
    }
    var q = zeros(m.rows, n)
    for i in 0..n {
        q.data[i * n + i] = 1.0
    }
    for i in 0..n {
        let k = n - 1 - i
        reflect(mut q, steps[k], k, 0, n)
    }
    let r = zeros(n, n)
    for i in 0..n {
        for j in i..n {
            r.data[i * n + j] = work.data[i * n + j]
        }
    }
    QR { q, r }
}

/// Returns the vector `x` that minimises the Euclidean norm of `a * x - b`, by QR decomposition and back substitution.
///
/// For a square `a` this is the solution of `a * x = b`. Fails with `Singular` when a diagonal entry of `R` is no larger than `max(rows, cols) * 2.220446049250313e-16` times the largest one, which is when a column depends linearly on the earlier ones to within rounding. Panics when `a` has fewer rows than columns or `b` does not have one entry per row.
pub fn least_squares(a: Matrix, b: f64[]) -> f64[] ! Error {
    if b.len != a.rows {
        panic("matrix: the right-hand side must have one entry per row")
    }
    let f = qr(a)
    let n = a.cols
    var largest = 0.0
    for i in 0..n {
        largest = math.max(largest, math.abs(f.r.data[i * n + i]))
    }
    let threshold = f64(math.max(a.rows, a.cols)) * epsilon * largest
    var x: f64[] = []
    for j in 0..n {
        var total = 0.0
        for i in 0..a.rows {
            total += f.q.data[i * n + j] * b[i]
        }
        x.push(total)
    }
    for i in 0..n {
        let row = n - 1 - i
        let diagonal = f.r.data[row * n + row]
        if math.abs(diagonal) <= threshold {
            fail Singular
        }
        var total = x[row]
        for j in row + 1..n {
            total -= f.r.data[row * n + j] * x[j]
        }
        x[row] = total / diagonal
    }
    x
}
