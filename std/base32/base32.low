import std/text

/// Why a Base32 decode failed.
pub enum Error {
    /// A byte of the input is not in the alphabet. `at` is its index in the input.
    BadCharacter(at: i64)
    /// The length of the input, ignoring trailing `=`, cannot come from a whole number of bytes.
    BadLength
}

const standard = "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567"
const extended = "0123456789ABCDEFGHIJKLMNOPQRSTUV"

fn encode_with(data: []u8, alphabet: str, padded: bool) -> str {
    var out: []u8 = []
    var buffer: u64 = 0
    var bits = 0
    for b in data {
        buffer = buffer << 8 | u64(b)
        bits += 8
        for bits >= 5 {
            bits -= 5
            push(mut out, alphabet[i64(buffer >> u64(bits) & 31)])
        }
    }
    if bits > 0 {
        push(mut out, alphabet[i64(buffer << u64(5 - bits) & 31)])
    }
    if padded {
        for out.len % 8 != 0 {
            push(mut out, '=')
        }
    }
    __str_view(out)
}

fn value(alphabet: str, c: u8) -> i64 {
    let upper = text.upper_byte(c)
    for i in 0..alphabet.len {
        if alphabet[i] == upper {
            return i
        }
    }
    -1
}

fn decode_with(s: str, alphabet: str) -> []u8 ! Error {
    var end = s.len
    for end > 0 && s[end - 1] == '=' {
        end -= 1
    }
    let tail = end % 8
    if tail == 1 || tail == 3 || tail == 6 {
        fail BadLength
    }
    var out: []u8 = []
    var buffer: u64 = 0
    var bits = 0
    for i in 0..end {
        let v = value(alphabet, s[i])
        if v < 0 {
            fail BadCharacter(i)
        }
        buffer = buffer << 5 | u64(v)
        bits += 5
        if bits >= 8 {
            bits -= 8
            push(mut out, u8(buffer >> u64(bits) & 0xFF))
        }
    }
    out
}

/// Returns `data` encoded as Base32 with the RFC 4648 alphabet `A-Z2-7`, padded with `=` to a multiple of 8 characters.
pub fn encode(data: []u8) -> str {
    encode_with(data, standard, true)
}

/// Returns `data` encoded as Base32 with the RFC 4648 alphabet `A-Z2-7` and no `=` padding.
pub fn encode_unpadded(data: []u8) -> str {
    encode_with(data, standard, false)
}

/// Decodes RFC 4648 Base32 text, with or without `=` padding.
/// Lowercase letters are accepted. Any number of trailing `=` is stripped before decoding, so an `=` anywhere else is a `BadCharacter`.
///
/// Fails with `BadLength` when the unpadded length leaves a remainder of 1, 3 or 6 characters modulo 8, and with `BadCharacter` at the index of the first byte outside the alphabet. Bits left over in the last character are ignored.
pub fn decode(s: str) -> []u8 ! Error {
    decode_with(s, standard)?
}

/// Returns `data` encoded as Base32 with the extended hex alphabet `0-9A-V`, padded with `=` to a multiple of 8 characters.
pub fn encode_hex(data: []u8) -> str {
    encode_with(data, extended, true)
}

/// Decodes Base32 text written with the extended hex alphabet `0-9A-V`, with or without `=` padding.
/// The failure cases, trailing padding and case handling are those of `decode`.
pub fn decode_hex(s: str) -> []u8 ! Error {
    decode_with(s, extended)?
}
