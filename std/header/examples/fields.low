import std/header
import std/text

fn dump(headers: []header.Header) {
    for h in headers {
        print("  {h.name}: {h.value}")
    }
}

/// Builds the headers of a response, reads the parameters of an upload's `Content-Disposition` and rejects a header that could split the response.
fn main() {
    var headers: []header.Header = []
    header.add(mut headers, "Content-Type", "text/plain; charset=utf-8")
    header.add(mut headers, "Set-Cookie", "a=1")
    header.add(mut headers, "set-cookie", "b=2")
    header.set(mut headers, "content-type", "application/json")
    header.set(mut headers, "Cache-Control", "no-store")

    print("type {header.get(headers, "CONTENT-TYPE") ?? "-"}")
    print("cookies {text.join(header.values(headers, "Set-Cookie"), " | ")}")
    print("has etag {header.has(headers, "ETag")}")
    let kept = header.remove(headers, "set-cookie")
    print("after remove, {kept.len} of {headers.len} headers remain")
    dump(kept)

    let upload = header.parse_value("form-data; name=\"avatar\"; filename=\"my \\\"best\\\" photo.png\"; filename*=UTF-8''na%C3%AFve.png")
    print("kind {upload.main}")
    print("field {header.param(upload, "NAME") ?? "-"}")
    print("file {header.param(upload, "filename") ?? "-"}")
    print("size {header.param(upload, "size") ?? "-"}")

    let name = "report \"final\".pdf"
    print("attachment; filename={header.quote(name)}")
    print("quoted line break {header.quote("a\r\nSet-Cookie: x")}")

    let injected = header.Header { name: "X-Note", value: "ok\r\nSet-Cookie: stolen=1" }
    let plain = header.Header { name: "X-Note", value: "ok" }
    print("injected valid {header.valid(injected)}")
    print("plain valid {header.valid(plain)}")
    print("token {header.token("X-Request-Id")} {header.token("bad name")}")
}
