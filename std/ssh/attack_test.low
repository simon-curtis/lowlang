import std/io
import std/net
import std/testing

fn read_failure(l: *Link) -> str {
    let payload = read_packet(l) catch {
        e => return error_name(e)
    }
    ""
}

fn tampered_packet(p: Pair, offset_from_end: bool, index: i64) -> u8[] {
    let packet = seal(p.client.outbound, p.client.out_seq, [80, 1, 2, 3, 4, 5, 6, 7, 8, 9]) or panic("seal")
    let at = if offset_from_end { packet.len - 1 - index } else { index }
    packet[at] ^= 1
    packet
}

fn test_flipped_body_and_tag_bytes_fail_authentication(t: *testing.T) {
    let combinations = [
        Algorithms { ciphers: ["chacha20-poly1305@openssh.com"] }
        Algorithms { ciphers: ["aes128-gcm@openssh.com"] }
        Algorithms { ciphers: ["aes256-gcm@openssh.com"] }
        Algorithms { ciphers: ["aes128-ctr"], macs: ["hmac-sha2-256-etm@openssh.com"] }
        Algorithms { ciphers: ["aes256-ctr"], macs: ["hmac-sha2-512-etm@openssh.com"] }
    ]
    for algorithms in combinations {
        let name = algorithms.ciphers[0]
        testing.sub(t, name, fn(t) {
            for flip in [0, 20] {
                using ends = net.socketpair() or panic("socketpair")
                let p = handshake_both(algorithms, algorithms, [signer_for("ed25519")], ends)
                testing.require(t, p.client.failure == none && p.server.failure == none)
                let packet = tampered_packet(p, true, flip)
                write_all(p.client, packet) or panic("write")
                let failure = read_failure(p.server)
                testing.error_if(t, failure != "MacFailed", "flipping byte {flip} from the end gave {failure}")
            }
        })
    }
}

fn test_untampered_packet_is_accepted(t: *testing.T) {
    using ends = net.socketpair() or panic("socketpair")
    let a = Algorithms { ciphers: ["aes256-gcm@openssh.com"] }
    let p = handshake_both(a, a, [signer_for("ed25519")], ends)
    let packet = seal(p.client.outbound, p.client.out_seq, [80, 1, 2]) or panic("seal")
    write_all(p.client, packet) or panic("write")
    testing.error_if(t, read_failure(p.server) != "", "an intact packet must open")
}

fn test_oversized_packet_is_refused(t: *testing.T) {
    using ends = net.socketpair() or panic("socketpair")
    let a = Algorithms { ciphers: ["aes256-gcm@openssh.com"] }
    let p = handshake_both(a, a, [signer_for("ed25519")], ends)
    testing.require(t, p.client.failure == none && p.server.failure == none)
    write_all(p.client, [0x7f, 0xff, 0xff, 0xf0, 1, 2, 3, 4]) or panic("write")
    let failure = read_failure(p.server)
    testing.error_if(t, failure != "TooLarge", "oversized length gave {failure}")
}

fn test_oversized_packet_before_keys(t: *testing.T) {
    using ends = net.socketpair() or panic("socketpair")
    let server = new_link(net.stream(ends.second), setup_for(false, Algorithms {}, [signer_for("ed25519")]))
    let done = chan[bool](1)
    spawn run_handshake(server, done)
    let attacker = new_link(net.stream(ends.first), setup_for(true, Algorithms {}, []))
    exchange_versions(attacker) or panic("versions")
    write_all(attacker, [0x7f, 0xff, 0xff, 0xf0, 1, 2, 3, 4]) or panic("write")
    let finished = <-done
    testing.error_if(t, failed_with(server) != "TooLarge", "got {failed_with(server)}")
}

fn test_strict_kex_rejects_ignore_during_exchange(t: *testing.T) {
    using ends = net.socketpair() or panic("socketpair")
    let server = new_link(net.stream(ends.second), setup_for(false, Algorithms {}, [signer_for("ed25519")]))
    let done = chan[bool](1)
    spawn run_handshake(server, done)
    let attacker = new_link(net.stream(ends.first), setup_for(true, Algorithms {}, []))
    exchange_versions(attacker) or panic("versions")
    begin_kex(attacker) or panic("kexinit")
    send_direct(attacker, [msg_ignore, 0, 0, 0, 0]) or panic("ignore")
    let finished = <-done
    testing.error_if(t, failed_with(server) != "StrictKex", "got {failed_with(server)}")
}

fn test_strict_kex_rejects_a_first_packet_that_is_not_kexinit(t: *testing.T) {
    using ends = net.socketpair() or panic("socketpair")
    let server = new_link(net.stream(ends.second), setup_for(false, Algorithms {}, [signer_for("ed25519")]))
    let done = chan[bool](1)
    spawn run_handshake(server, done)
    let attacker = new_link(net.stream(ends.first), setup_for(true, Algorithms {}, []))
    exchange_versions(attacker) or panic("versions")
    send_direct(attacker, [msg_ignore, 0, 0, 0, 0]) or panic("ignore")
    let finished = <-done
    testing.error_if(t, failed_with(server) != "StrictKex", "got {failed_with(server)}")
}

fn test_sequence_numbers_restart_at_newkeys(t: *testing.T) {
    using ends = net.socketpair() or panic("socketpair")
    let p = handshake_both(Algorithms {}, Algorithms {}, [signer_for("ed25519")], ends)
    testing.error_if(t, !p.client.strict || !p.server.strict, "strict key exchange must be negotiated")
    testing.error_if(t, p.client.out_seq != 0, "client sequence after NEWKEYS: {p.client.out_seq}")
    testing.error_if(t, p.server.in_seq != 0, "server received sequence after NEWKEYS: {p.server.in_seq}")
}

fn test_bad_version_line(t: *testing.T) {
    using ends = net.socketpair() or panic("socketpair")
    let server = new_link(net.stream(ends.second), setup_for(false, Algorithms {}, [signer_for("ed25519")]))
    let done = chan[bool](1)
    spawn run_handshake(server, done)
    io.write_all(net.stream(ends.first), bytes("SSH-1.5-ancient\r\n")) or panic("write")
    let finished = <-done
    testing.error_if(t, failed_with(server) != "BadVersion", "got {failed_with(server)}")
}
