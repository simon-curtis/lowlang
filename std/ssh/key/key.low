import std/base64
import std/crypto/ecdsa
import std/crypto/hash
import std/crypto/rsa
import std/io
import std/ssh/wire
import std/text

/// The failures of parsing and using SSH keys.
pub enum Error {
    /// The text or binary encoding of a key, signature or file is not well formed.
    Malformed
    /// The key type, curve, cipher or KDF is not supported.
    Unsupported
    /// An argument is not valid for the operation.
    Invalid
    /// The private key is encrypted and no passphrase was given.
    Encrypted
    /// The passphrase does not decrypt the private key.
    WrongPassphrase
    /// A file or the random source failed.
    Io(cause: io.Error)
    /// No trusted authority signed the certificate.
    Untrusted
    /// The certificate is not valid at the checked time.
    Expired
    /// The certificate does not list the principal.
    Principal
}

/// The key material of an SSH public key.
pub enum Material {
    /// An Ed25519 public key of 32 bytes.
    Ed25519(public: u8[])
    /// An ECDSA public key on P-256 or P-384 as an uncompressed SEC1 point.
    Ecdsa(curve: ecdsa.Curve, point: u8[])
    /// An RSA public key.
    Rsa(key: rsa.PublicKey)
}

/// An SSH public key.
pub struct PublicKey {
    /// The key type name as it appears on the wire, such as `ssh-ed25519`, `ecdsa-sha2-nistp256`, `ssh-rsa` or the `-cert-v01@openssh.com` name of a certificate.
    pub kind: str
    /// The key material. For a certificate it is the key the certificate vouches for.
    pub material: Material
    /// The wire encoding of the key, which for a certificate is the whole certificate.
    pub blob: u8[]
    /// The certificate when `kind` names one; see `parse_certificate`.
    pub certificate: *Certificate?
}

/// An OpenSSH certificate (PROTOCOL.certkeys) binding a public key to identity, principals and a validity window under a CA signature.
pub struct Certificate {
    /// The random nonce that makes the certificate unique.
    pub nonce: u8[]
    /// The certified key.
    pub key: PublicKey
    /// The serial number the CA assigned.
    pub serial: u64
    /// Whether the certificate is for a user (`1`) or a host (`2`).
    pub cert_type: i64
    /// The free-form identity recorded for logging.
    pub key_id: str
    /// The user names or host names the certificate is valid for. Empty means any.
    pub principals: str[]
    /// The first second, as a Unix time, at which the certificate is valid.
    pub valid_after: u64
    /// The first second, as a Unix time, at which the certificate stops being valid. `0xFFFFFFFFFFFFFFFF` means never.
    pub valid_before: u64
    /// The critical options as name and data pairs, in the encoded order.
    pub critical_options: Option[]
    /// The extensions as name and data pairs, in the encoded order.
    pub extensions: Option[]
    /// The CA public key that signed the certificate.
    pub signature_key: PublicKey
    /// The CA's signature blob.
    pub signature: u8[]
    /// The signed part of the certificate encoding.
    pub signed: u8[]
}

/// A name and its data in a certificate's critical options or extensions.
pub struct Option {
    /// The option name, such as `force-command` or `permit-pty`.
    pub name: str
    /// The option's data, already unwrapped from its inner `string` when it has one.
    pub data: u8[]
}

/// The certificate type of a user certificate.
pub const user_certificate = 1

/// The certificate type of a host certificate.
pub const host_certificate = 2

const cert_suffix = "-cert-v01@openssh.com"

fn bad(e: io.Error) -> Error {
    Malformed
}

/// Returns whether `kind` is a certificate key type name.
pub fn is_certificate_kind(kind: str) -> bool {
    text.ends_with(kind, cert_suffix)
}

/// Returns the plain key type name that a certificate type name wraps, or `kind` itself.
pub fn base_kind(kind: str) -> str {
    text.trim_suffix(kind, cert_suffix)
}

fn curve_name(curve: ecdsa.Curve) -> str {
    match curve {
        P256 => "nistp256"
        P384 => "nistp384"
    }
}

fn ecdsa_kind(curve: ecdsa.Curve) -> str {
    "ecdsa-sha2-{curve_name(curve)}"
}

/// Returns the key type name of key material, such as `ssh-ed25519`.
pub fn kind_of(m: Material) -> str {
    match m {
        Ed25519(_) => "ssh-ed25519"
        Ecdsa(curve, _) => ecdsa_kind(curve)
        Rsa(_) => "ssh-rsa"
    }
}

fn rsa_bits(n: u8[]) -> i64 {
    var top = n[0]
    var bits = 8 * (n.len - 1)
    for top != 0 {
        bits += 1
        top >>= 1
    }
    bits
}

fn read_material(kind: str, r: *wire.Reader) -> Material ! Error {
    match base_kind(kind) {
        "ssh-ed25519" => {
            let public = wire.read_string(r) catch bad
            if public.len != 32 {
                fail Malformed
            }
            Material.Ed25519(public)
        }
        "ecdsa-sha2-nistp256" => ecdsa_material(ecdsa.Curve.P256, r)?
        "ecdsa-sha2-nistp384" => ecdsa_material(ecdsa.Curve.P384, r)?
        "ssh-rsa" => {
            let e = wire.read_mpint(r) catch bad
            let n = wire.read_mpint(r) catch bad
            if n.len == 0 || e.len == 0 {
                fail Malformed
            }
            let bits = rsa_bits(n)
            if bits < 2048 || bits > 8192 || (n[n.len - 1] & 1) == 0 || (e[e.len - 1] & 1) == 0 || (e.len == 1 && e[0] == 1) {
                fail Unsupported
            }
            Material.Rsa(rsa.PublicKey { n, e })
        }
        _ => fail Unsupported
    }
}

fn ecdsa_material(curve: ecdsa.Curve, r: *wire.Reader) -> Material ! Error {
    let name = wire.read_str(r) catch bad
    if name != curve_name(curve) {
        fail Malformed
    }
    let point = wire.read_string(r) catch bad
    match ecdsa.coordinates(curve, point) {
        some(_) => {}
        none => fail Malformed
    }
    Material.Ecdsa(curve, point)
}

/// Parses the wire encoding of a public key or certificate: a `string` key type followed by the key's fields.
///
/// Fails with `Malformed` for a truncated or inconsistent encoding, with `Unsupported` for a key type, curve or RSA size (below 2048 or above 8192 bits) that this module does not handle.
pub fn parse_blob(blob: u8[]) -> PublicKey ! Error {
    let r = wire.reader(blob)
    let kind = wire.read_str(r) catch bad
    if is_certificate_kind(kind) {
        return parse_certificate(blob)?
    }
    let material = read_material(kind, r)?
    wire.finish(r) catch bad
    PublicKey { kind, material, blob, certificate: none }
}

fn read_options(data: u8[], with_inner: bool) -> Option[] ! Error {
    let r = wire.reader(data)
    var out: Option[] = []
    var last = ""
    for wire.left(r) > 0 {
        let name = wire.read_str(r) catch bad
        if out.len > 0 && name <= last {
            fail Malformed
        }
        last = name
        var value = wire.read_string(r) catch bad
        if with_inner && value.len > 0 {
            let inner = wire.reader(value)
            value = wire.read_string(inner) catch bad
            wire.finish(inner) catch bad
        }
        out.push(Option { name, data: value })
    }
    out
}

/// Parses an OpenSSH certificate blob and returns it as a public key whose `certificate` is set.
///
/// The CA signature is not checked; `check_certificate` does that together with the principal and the validity window. Fails with `Malformed` and `Unsupported` as `parse_blob` does.
pub fn parse_certificate(blob: u8[]) -> PublicKey ! Error {
    let r = wire.reader(blob)
    let kind = wire.read_str(r) catch bad
    if !is_certificate_kind(kind) {
        fail Malformed
    }
    let nonce = wire.read_string(r) catch bad
    let material = read_material(kind, r)?
    let serial = wire.read_u64(r) catch bad
    let cert_type = wire.read_u32(r) catch bad
    if cert_type != user_certificate && cert_type != host_certificate {
        fail Malformed
    }
    let key_id = wire.read_str(r) catch bad
    let principal_data = wire.read_string(r) catch bad
    let pr = wire.reader(principal_data)
    var principals: str[] = []
    for wire.left(pr) > 0 {
        principals.push(wire.read_str(pr) catch bad)
    }
    let valid_after = wire.read_u64(r) catch bad
    let valid_before = wire.read_u64(r) catch bad
    let critical_data = wire.read_string(r) catch bad
    let extension_data = wire.read_string(r) catch bad
    let _ = wire.read_string(r) catch bad
    let signature_key_blob = wire.read_string(r) catch bad
    let signed_end = wire.offset(r)
    let signature = wire.read_string(r) catch bad
    wire.finish(r) catch bad
    let critical_options = read_options(critical_data, true)?
    let extensions = read_options(extension_data, false)?
    let signature_key = parse_blob(signature_key_blob)?
    if signature_key.certificate != none {
        fail Malformed
    }
    let subject = PublicKey { kind: base_kind(kind), material, blob: [], certificate: none }
    let cert = new(Certificate {
        nonce
        key: subject
        serial
        cert_type
        key_id
        principals
        valid_after
        valid_before
        critical_options
        extensions
        signature_key
        signature
        signed: blob[..signed_end]
    })
    PublicKey { kind, material, blob, certificate: cert }
}

/// Returns the lines-form text of `k`: the key type, the Base64 of its blob and, when `comment` is not empty, the comment, as in an `authorized_keys` or `.pub` file without a trailing newline.
pub fn format_line(k: PublicKey, comment: str) -> str {
    let encoded = base64.encode(k.blob)
    if comment.len == 0 {
        return "{k.kind} {encoded}"
    }
    "{k.kind} {encoded} {comment}"
}

/// Returns the `SHA256:` fingerprint of `k`, the unpadded Base64 of the SHA-256 of its blob, as `ssh-keygen -l` prints it.
pub fn fingerprint(k: PublicKey) -> str {
    let digest = hash.sum(hash.sha256(), k.blob)
    "SHA256:{base64.encode_unpadded(digest)}"
}

/// Returns whether `a` and `b` are the same key: the same type and the same blob.
pub fn equal(a: PublicKey, b: PublicKey) -> bool {
    a.kind == b.kind && hash.equal(a.blob, b.blob)
}

/// Parses one public key line: a key type, a Base64 blob and an optional comment.
///
/// Returns the key and the comment. The key type on the line must match the one inside the blob. Fails with `Malformed` for a missing field, invalid Base64 or a mismatch, and with `Unsupported` as `parse_blob` does.
pub fn parse_line(line: str) -> ParsedLine ! Error {
    let fields = text.fields(line)
    if fields.len < 2 {
        fail Malformed
    }
    let blob = base64.decode(fields[1]) or fail Malformed
    let k = parse_blob(blob)?
    if k.kind != fields[0] {
        fail Malformed
    }
    var comment = ""
    if fields.len > 2 {
        let at = text.index(line, fields[1]) + fields[1].len
        comment = text.trim(line[at..])
    }
    ParsedLine { key: k, comment }
}

/// A public key line split into its key and comment.
pub struct ParsedLine {
    /// The key on the line.
    pub key: PublicKey
    /// The text after the key, or the empty string.
    pub comment: str
}
