import std/file
import std/testing
import std/text

const inside_window = 1800000000

fn read_vector(name: str) -> str {
    file.read_text("{vectors}/{name}") catch { e => panic("read {name}: {e}") }
}

fn key_of(name: str) -> PublicKey {
    let parsed = parse_line(read_vector("{name}.pub")) or panic("parse {name}.pub")
    parsed.key
}

fn plain_entries() -> KnownHost[] {
    parse_known_hosts(read_vector("known_hosts_plain")) or panic("parse known_hosts_plain")
}

fn status_name(s: HostStatus) -> str {
    match s {
        Trusted => "Trusted"
        Unknown => "Unknown"
        Mismatch => "Mismatch"
        Revoked => "Revoked"
    }
}

fn marker_name(m: Marker) -> str {
    match m {
        Plain => "plain"
        CertAuthority => "cert-authority"
        Revoked => "revoked"
    }
}

fn entry_line(e: KnownHost) -> str {
    "{marker_name(e.marker)} {text.join(e.patterns, ",")} {e.key.kind} {e.comment}"
}

fn status_of(entries: KnownHost[], host: str, port: i64, k: PublicKey) -> str {
    status_name(check_host_key(entries, host, port, k, inside_window))
}

fn test_plain_known_hosts(t: *testing.T) {
    let entries = plain_entries()
    testing.error_if(t, entries.len != 5, "entry count {entries.len}")
    let expected = [
        "plain example.test ssh-ed25519 "
        "plain [example.test]:2222 ecdsa-sha2-nistp256 port-comment"
        "plain *.wild.test,!bad.wild.test ssh-rsa "
        "cert-authority *.ca.test ssh-ed25519 "
        "revoked revoked.test ecdsa-sha2-nistp384 "
    ]
    for i in 0..expected.len {
        testing.error_if(t, entry_line(entries[i]) != expected[i], "entry {i}: {entry_line(entries[i])}")
    }
    testing.error_if(t, status_of(entries, "example.test", 22, key_of("ed25519")) != "Trusted", "listed host")
    testing.error_if(t, status_of(entries, "EXAMPLE.test", 22, key_of("ed25519")) != "Trusted", "case folded host")
    testing.error_if(t, status_of(entries, "example.test", 22, key_of("ed25519_encrypted")) != "Mismatch", "changed key")
    testing.error_if(t, status_of(entries, "example.test", 22, key_of("ecdsa256")) != "Unknown", "other key type")
    testing.error_if(t, status_of(entries, "unlisted.test", 22, key_of("ed25519")) != "Unknown", "unlisted host")
    testing.error_if(t, status_of(entries, "example.test", 2222, key_of("ecdsa256")) != "Trusted", "bracketed port form")
    testing.error_if(t, status_of(entries, "example.test", 2223, key_of("ecdsa256")) != "Unknown", "other port")
    testing.error_if(t, entries[1].comment != "port-comment", "comment")
}

fn test_wildcards_and_negation(t: *testing.T) {
    let entries = plain_entries()
    let rsa = key_of("rsa2048")
    testing.error_if(t, status_of(entries, "good.wild.test", 22, rsa) != "Trusted", "wildcard")
    testing.error_if(t, status_of(entries, "bad.wild.test", 22, rsa) != "Unknown", "negated name")
    testing.error_if(t, status_of(entries, "wild.test", 22, rsa) != "Unknown", "wildcard needs the dot")
}

fn test_revoked(t: *testing.T) {
    let entries = plain_entries()
    testing.error_if(t, status_of(entries, "revoked.test", 22, key_of("ecdsa384")) != "Revoked", "revoked key")
    testing.error_if(t, status_of(entries, "revoked.test", 22, key_of("ecdsa256")) != "Unknown", "other key for the revoked host")
}

fn test_cert_authority(t: *testing.T) {
    let entries = plain_entries()
    let cert = key_of("hostca-cert")
    testing.error_if(t, status_of(entries, "a.ca.test", 22, cert) != "Trusted", "certificate signed by the authority")
    testing.error_if(t, status_of(entries, "b.ca.test", 22, cert) != "Mismatch", "certificate for another host")
    testing.error_if(t, status_of(entries, "other.test", 22, cert) != "Unknown", "no authority for the host")
    let outside = check_host_key(entries, "a.ca.test", 22, cert, 1500000000)
    testing.error_if(t, status_name(outside) != "Mismatch", "certificate not yet valid")
}

fn test_hashed_known_hosts(t: *testing.T) {
    let entries = parse_known_hosts(read_vector("known_hosts_hashed")) or panic("parse hashed")
    testing.error_if(t, entries.len != 2, "entry count")
    testing.error_if(t, status_of(entries, "hashed.test", 22, key_of("ed25519")) != "Trusted", "hashed host")
    testing.error_if(t, status_of(entries, "hashed.test", 2222, key_of("ecdsa256")) != "Trusted", "hashed host with port")
    testing.error_if(t, status_of(entries, "other.test", 22, key_of("ed25519")) != "Unknown", "other host")
}

fn test_host_label(t: *testing.T) {
    testing.error_if(t, host_label("Example.TEST", 22) != "example.test", "default port label {host_label("Example.TEST", 22)}")
    testing.error_if(t, host_label("example.test", 2222) != "[example.test]:2222", "other port label {host_label("example.test", 2222)}")
}

fn test_hash_host_matches_ssh_keygen(t: *testing.T) {
    let entries = parse_known_hosts(read_vector("known_hosts_hashed")) or panic("parse hashed")
    let again = hash_host("hashed.test", entries[0].salt)
    let first = text.fields(read_vector("known_hosts_hashed"))
    testing.error_if(t, again != first[0], "hash_host differs from ssh-keygen -H: {again}")
}

fn test_known_hosts_line_round_trip(t: *testing.T) {
    let k = key_of("ed25519")
    let hashed = known_hosts_line("round.test", 22, k, [1, 2, 3, 4])
    let plain = known_hosts_line("round.test", 2200, k, [])
    let entries = parse_known_hosts("{hashed}\n{plain}\n") or panic("parse")
    testing.error_if(t, entries.len != 2, "entry count")
    testing.error_if(t, status_of(entries, "round.test", 22, k) != "Trusted", "hashed line")
    testing.error_if(t, status_of(entries, "round.test", 2200, k) != "Trusted", "plain line")
    testing.error_if(t, !text.starts_with(plain, "[round.test]:2200 ssh-ed25519 "), "line form")
}

fn test_malformed_known_hosts(t: *testing.T) {
    for line in ["host", "host ssh-ed25519", "@bogus host ssh-ed25519 AAAA", "|1|a|b ssh-ed25519 AAAA", "host ssh-ed25519 !!!!"] {
        let failed = parse_known_hosts(line) catch { e => return_marker() }
        testing.error_if(t, failed.len != 0, "accepted {line}")
    }
}

fn return_marker() -> KnownHost[] {
    []
}

fn test_verifier_callbacks(t: *testing.T) {
    let entries = plain_entries()
    let verify = known_hosts_verifier(entries, "example.test", 22)
    testing.error_if(t, !verify(key_of("ed25519")), "listed key")
    testing.error_if(t, verify(key_of("ed25519_encrypted")), "changed key")
    testing.error_if(t, verify(key_of("ecdsa256")), "unknown key")
}

fn test_trust_on_first_use(t: *testing.T) {
    let dir = file.temp_dir("ssh-known-hosts") or panic("temp dir")
    let path = "{dir}/known_hosts"
    let first = trust_on_first_use(path, "tofu.test", 22)
    testing.error_if(t, !first(key_of("ed25519")), "first use")
    testing.error_if(t, !first(key_of("ed25519")), "second use")
    testing.error_if(t, first(key_of("ed25519_encrypted")), "changed key")
    let written = file.read_text(path) or panic("read")
    testing.error_if(t, text.count(written, "\n") != 1, "one line written: {written}")
    let entries = parse_known_hosts(written) or panic("parse")
    testing.error_if(t, status_of(entries, "tofu.test", 22, key_of("ed25519")) != "Trusted", "written line")
    let other = trust_on_first_use(path, "tofu2.test", 22)
    testing.error_if(t, !other(key_of("ecdsa256")), "second host")
    let both = parse_known_hosts(file.read_text(path) or panic("read")) or panic("parse")
    testing.error_if(t, both.len != 2, "two lines")
    file.remove_all(dir) or panic("remove")
}

fn test_authorized_keys(t: *testing.T) {
    let entries = parse_authorized_keys(read_vector("authorized_keys")) or panic("parse authorized_keys")
    testing.error_if(t, entries.len != 4, "entry count {entries.len}")
    let plain = find_authorized(entries, key_of("ed25519")) ?? panic("plain key missing")
    testing.error_if(t, plain.options.len != 0 || plain.comment != "plain-user", "plain entry")
    let restricted = find_authorized(entries, key_of("ecdsa256")) ?? panic("restricted key missing")
    testing.error_if(t, authorized_option(restricted, "command")[0] != "/bin/echo \"hi\"", "command option")
    testing.error_if(t, authorized_option(restricted, "from")[0] != "10.0.0.*,!10.0.0.9", "from option")
    testing.error_if(t, authorized_option(restricted, "environment").len != 2, "repeated option")
    testing.error_if(t, authorized_option(restricted, "environment")[1] != "B=2", "second environment")
    var written = ""
    for o in restricted.options {
        written = "{written}{o.name}={o.value};"
    }
    let expected = "command=/bin/echo \"hi\";no-pty=;from=10.0.0.*,!10.0.0.9;environment=A=1;environment=B=2;"
    testing.error_if(t, written != expected, "options in order: {written}")
    testing.error_if(t, !has_authorized_option(restricted, "no-pty"), "flag option")
    testing.error_if(t, has_authorized_option(restricted, "no-agent-forwarding"), "absent option")
    let authority = find_authorized(entries, key_of("ca")) ?? panic("authority missing")
    testing.error_if(t, !has_authorized_option(authority, "cert-authority"), "cert-authority")
    testing.error_if(t, authorized_option(authority, "principals")[0] != "alice,bob", "principals")
    let bare = find_authorized(entries, key_of("rsa2048")) ?? panic("bare key missing")
    testing.error_if(t, bare.comment != "", "no comment")
    let unlisted = match find_authorized(entries, key_of("host")) {
        some(_) => true
        none => false
    }
    testing.error_if(t, unlisted, "unlisted key")
}

fn test_malformed_authorized_keys(t: *testing.T) {
    for line in ["no-pty", "command=\"unterminated ssh-ed25519 AAAA", "ssh-ed25519 !!!!"] {
        let failed = parse_authorized_keys(line) catch { e => return_authorized() }
        testing.error_if(t, failed.len != 0, "accepted {line}")
    }
}

fn return_authorized() -> Authorized[] {
    []
}
