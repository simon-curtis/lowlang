import std/ssh/wire

/// The critical options `check_certificate` accepts: it leaves them to the caller, which applies `force-command` and `source-address` from `Certificate.critical_options`.
fn known_critical_option(name: str) -> bool {
    name == "force-command" || name == "source-address"
}

fn signature_algorithm(blob: u8[]) -> str ! Error {
    let r = wire.reader(blob)
    wire.read_str(r) catch bad
}

/// Reports whether `ca` made the signature on the certificate `k`.
///
/// Returns `false` for a key that is not a certificate and for a signature made with SHA-1 (`ssh-rsa`).
pub fn certificate_signed_by(k: PublicKey, ca: PublicKey) -> bool {
    let cert = match k.certificate {
        some(c) => c
        none => return false
    }
    let algorithm = signature_algorithm(cert.signature) or return false
    verify(ca, algorithm, cert.signed, cert.signature)
}

/// Checks the certificate `k` for use as a certificate of type `cert_type` for `principal` at the Unix time `now`, issued by one of `authorities`.
///
/// The checks are: `k` is a certificate of type `user_certificate` or `host_certificate` as asked, one of the `authorities` signed it, `now` lies in `[valid_after, valid_before)`, `principal` is among the certificate's principals when it lists any (an empty list matches every principal, as PROTOCOL.certkeys defines), and every critical option is one the caller evaluates, `force-command` or `source-address`.
///
/// Fails with `Invalid` when `k` is not a certificate or has the wrong type, `Untrusted` when no authority signed it, `Expired` outside the validity window, `Principal` when `principal` is not listed and `Unsupported` for an unknown critical option.
pub fn check_certificate(k: PublicKey, authorities: PublicKey[], principal: str, cert_type: i64, now: i64) ! Error {
    let cert = match k.certificate {
        some(c) => c
        none => fail Invalid
    }
    if cert.cert_type != cert_type {
        fail Invalid
    }
    var signed = false
    for ca in authorities {
        if certificate_signed_by(k, ca) {
            signed = true
            break
        }
    }
    if !signed {
        fail Untrusted
    }
    if now < 0 || u64(now) < cert.valid_after || u64(now) >= cert.valid_before {
        fail Expired
    }
    if cert.principals.len > 0 && !wire.has_name(cert.principals, principal) {
        fail Principal
    }
    for option in cert.critical_options {
        if !known_critical_option(option.name) {
            fail Unsupported
        }
    }
}
