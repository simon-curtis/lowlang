import std/ssh/key
import std/text

const user_line = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAINshurYp1Wu9x1GgCqY91YRqVR5c91dnQsAIFNqPvTU/ plain"

fn authorized_file() -> str {
    let lines = [
        "# deploy keys"
        "command=\"/usr/bin/backup\",no-pty,from=\"10.0.0.*\" {user_line}"
    ]
    text.join(lines, "\n")
}

fn main() {
    let parsed = key.parse_line(user_line) or panic("parse")
    print("kind: {parsed.key.kind}")
    print("fingerprint: {key.fingerprint(parsed.key)}")
    print("comment: {parsed.comment}")
    let entries = key.parse_authorized_keys(authorized_file()) or panic("authorized_keys")
    let entry = key.find_authorized(entries, parsed.key) ?? panic("key not authorized")
    print("command: {key.authorized_option(entry, "command")[0]}")
    print("from: {key.authorized_option(entry, "from")[0]}")
    print("no-pty: {key.has_authorized_option(entry, "no-pty")}")
    print("agent forwarding allowed: {!key.has_authorized_option(entry, "no-agent-forwarding")}")
    let hosts = "example.test {user_line}"
    let known = key.parse_known_hosts(hosts) or panic("known_hosts")
    print("example.test: {key.check_host_key(known, "example.test", 22, parsed.key, 0)}")
    print("other.test: {key.check_host_key(known, "other.test", 22, parsed.key, 0)}")
}
