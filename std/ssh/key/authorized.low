import std/text

/// An option on an `authorized_keys` line, such as `command="/bin/true"` or `no-pty`.
pub struct AuthorizedOption {
    /// The option name, lower case.
    pub name: str
    /// The unquoted value, or the empty string for an option without one.
    pub value: str
}

/// A line of an `authorized_keys` file.
pub struct Authorized {
    /// The authorised key. A certificate authority is authorised with the option `cert-authority`.
    pub key: PublicKey
    /// The text after the key.
    pub comment: str
    /// The options before the key, in the order written.
    pub options: AuthorizedOption[]
}

fn is_key_kind(token: str) -> bool {
    text.starts_with(token, "ssh-") || text.starts_with(token, "ecdsa-sha2-") || text.starts_with(token, "sk-") || is_certificate_kind(token)
}

fn is_supported_kind(token: str) -> bool {
    let kind = base_kind(token)
    kind == "ssh-ed25519" || kind == "ssh-rsa" || kind == "ecdsa-sha2-nistp256" || kind == "ecdsa-sha2-nistp384"
}

fn options_end(line: str) -> i64 ! Error {
    var quoted = false
    var i = 0
    for i < line.len {
        let c = line[i]
        if c == '\\' && quoted {
            i += 2
            continue
        }
        if c == '"' {
            quoted = !quoted
        } else if !quoted && (c == ' ' || c == '\t') {
            return i
        }
        i += 1
    }
    if quoted {
        fail Malformed
    }
    i
}

fn parse_options(text_of: str) -> AuthorizedOption[] ! Error {
    var out: AuthorizedOption[] = []
    var name = ""
    var value = ""
    var in_value = false
    var quoted = false
    var i = 0
    for i <= text_of.len {
        let at_end = i == text_of.len
        let c = if at_end { ',' } else { text_of[i] }
        if !at_end && quoted && c == '\\' && i + 1 < text_of.len && text_of[i + 1] == '"' {
            value = "{value}\""
            i += 2
            continue
        }
        if !at_end && c == '"' {
            if !in_value {
                fail Malformed
            }
            quoted = !quoted
            i += 1
            continue
        }
        if !quoted && c == ',' {
            if name.len == 0 {
                fail Malformed
            }
            out.push(AuthorizedOption { name: text.lower(name), value })
            name = ""
            value = ""
            in_value = false
            i += 1
            continue
        }
        if !quoted && !in_value && c == '=' {
            in_value = true
            i += 1
            continue
        }
        if in_value {
            value = "{value}{text_of[i..i + 1]}"
        } else {
            name = "{name}{text_of[i..i + 1]}"
        }
        i += 1
    }
    out
}

/// Parses the text of an `authorized_keys` file.
///
/// Blank lines and lines starting with `#` are skipped. A line is optional comma-separated options, which may hold quoted values, then a key type, a Base64 blob and an optional comment. A line whose key type is not supported (such as `sk-ssh-ed25519@openssh.com`) is skipped, as OpenSSH skips keys it cannot use. Fails with `Malformed` for a line that cannot be parsed.
pub fn parse_authorized_keys(data: str) -> Authorized[] ! Error {
    var out: Authorized[] = []
    for raw in text.lines(data) {
        let line = text.trim(raw)
        if line.len == 0 || line[0] == '#' {
            continue
        }
        let end = options_end(line)?
        let first = line[..end]
        var options: AuthorizedOption[] = []
        var rest = line
        if !is_key_kind(first) {
            options = parse_options(first)?
            rest = text.trim(line[end..])
        }
        let fields = text.fields(rest)
        if fields.len < 2 {
            fail Malformed
        }
        if !is_supported_kind(fields[0]) {
            continue
        }
        let parsed = parse_line(rest)?
        out.push(Authorized { key: parsed.key, comment: parsed.comment, options })
    }
    out
}

/// Returns the first entry whose key is `k`.
pub fn find_authorized(entries: Authorized[], k: PublicKey) -> Authorized? {
    for entry in entries {
        if equal(entry.key, k) {
            return entry
        }
    }
    none
}

/// Returns the values of the options of `entry` named `name`, in the order written. Options without a value give the empty string.
pub fn authorized_option(entry: Authorized, name: str) -> str[] {
    var out: str[] = []
    for option in entry.options {
        if option.name == name {
            out.push(option.value)
        }
    }
    out
}

/// Returns whether `entry` has the option `name`.
pub fn has_authorized_option(entry: Authorized, name: str) -> bool {
    for option in entry.options {
        if option.name == name {
            return true
        }
    }
    false
}
