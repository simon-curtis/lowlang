import std/crypto
import std/crypto/x509
import std/net
import std/ssh
import std/ssh/key
import std/text

fn run_command(h: *ssh.ChannelHandle, command: str) {
    let words = text.fields(command)
    if words[0] == "echo" {
        ssh.write_on(h, bytes("{text.join(words[1..], " ")}\n")) or return
        ssh.send_exit_status_on(h, 0) or return
        return
    }
    ssh.write_stderr_on(h, bytes("{words[0]}: command not found\n")) or return
    ssh.send_exit_status_on(h, 127) or return
}

fn handle_session(inc: ssh.Incoming) {
    using ch = ssh.accept(inc) or return
    for {
        let next = ssh.next_request_on(ch.handle)
        let req = match next {
            some(r) => r
            none => return
        }
        if req.kind != "exec" {
            ssh.answer_on(ch.handle, req, false) or return
            continue
        }
        let command = ssh.parse_exec(req) or return
        ssh.answer_on(ch.handle, req, true) or return
        run_command(ch.handle, command)
        ssh.close_write_on(ch.handle) or return
        return
    }
}

fn handle_channel(inc: ssh.Incoming) {
    if inc.kind == "session" {
        handle_session(inc)
        return
    }
    ssh.reject(inc, ssh.open_unknown_channel_type, "only sessions")
}

fn server_config() -> ssh.ServerConfig {
    let host = key.signer(x509.PrivateKey.Ed25519(crypto.random(32))) or panic("host key")
    let auth = ssh.ServerAuth {
        methods: ["password"]
        password: fn(user, password) { user == "alice" && password == "correct horse" }
    }
    ssh.ServerConfig { host_keys: [host], auth, channels: handle_channel }
}

fn report(conn: ssh.Connection, command: str) {
    let result = ssh.exec(conn, command) or panic("exec")
    print("{command}: status {result.status.code}, stdout {text.trim(str(result.stdout))}, stderr {text.trim(str(result.stderr))}")
}

fn main() {
    using listener = net.listen("127.0.0.1", 0) or panic("listen")
    spawn ssh.serve_on(listener.handle, server_config())
    let config = ssh.ClientConfig {
        user: "alice"
        verify_host_key: ssh.accept_any_host_key()
        auth: [ssh.AuthMethod.Password("correct horse")]
    }
    using conn = ssh.dial("127.0.0.1", listener.handle.addr.port, config) or panic("dial")
    report(conn, "echo hello from the server")
    report(conn, "uptime")
}
