import std/testing

fn numbers(xs: i64[]) -> str {
    "{xs}"
}

fn words(xs: str[]) -> str {
    "{xs}"
}

fn test_parses_a_typical_file(t: *testing.T) {
    let s = parse_config("# comment\nport 2222\nPort=2223\nHostKey /etc/ssh/ssh_host_ed25519_key\nPermitRootLogin no\nPermitRootLogin yes\nPasswordAuthentication no\nAuthorizedKeysFile .ssh/authorized_keys %h/.ssh/extra none\nLoginGraceTime 1m30s\nMaxStartups 3:50:9\nAcceptEnv LANG\nAcceptEnv LC_*\nAllowUsers alice bob\nBanner \"/etc/issue net\"\nSubsystem sftp internal-sftp\nAllowTcpForwarding local\nUsePAM no\n") or panic("parse")
    testing.error_if(t, numbers(s.ports) != numbers([2222, 2223]), "ports {s.ports}")
    testing.error_if(t, s.root_login != RootLogin.No, "the first PermitRootLogin should win")
    testing.error_if(t, s.password_authentication, "PasswordAuthentication")
    testing.error_if(t, words(s.authorized_keys) != words([".ssh/authorized_keys", "%h/.ssh/extra"]), "authorized keys {s.authorized_keys}")
    testing.error_if(t, s.login_grace != 90, "login grace {s.login_grace}")
    testing.error_if(t, numbers(s.startups) != numbers([3, 50, 9]), "startups {s.startups}")
    testing.error_if(t, words(s.accept_env) != words(["LANG", "LC_*"]), "accept env {s.accept_env}")
    testing.error_if(t, words(s.allow_users) != words(["alice", "bob"]), "allow users {s.allow_users}")
    testing.error_if(t, s.banner != "/etc/issue net", "banner {s.banner}")
    testing.error_if(t, words(s.sftp) != words(["internal-sftp"]), "sftp {s.sftp}")
    testing.error_if(t, !s.local_forwarding, "AllowTcpForwarding local")
}

fn test_an_empty_file_gives_the_defaults(t: *testing.T) {
    let s = parse_config("") or panic("parse")
    testing.error_if(t, numbers(s.ports) != numbers([22]) || s.root_login != RootLogin.KeyOnly || !s.strict_modes || s.max_auth_tries != 6 || s.local_forwarding || !s.permit_tty, "defaults")
}

fn test_accepts_ipv6_listen_addresses_and_patterns(t: *testing.T) {
    let s = parse_config("ListenAddress ::1\nAllowUsers adm* ?ob\n") or panic("parse")
    testing.error_if(t, words(s.listen) != words(["::1"]) || words(s.allow_users) != words(["adm*", "?ob"]), "{s.listen} {s.allow_users}")
}

fn refusal(content: str) -> Error? {
    let _ = parse_config(content) catch {
        e => return e
    }
    none
}

fn test_refuses_what_it_cannot_honour(t: *testing.T) {
    match refusal("Port 22\nMatch User alice\n") ?? panic("accepted Match") {
        UnknownKeyword(at, keyword) => testing.error_if(t, at != 2 || keyword != "match", "{at} {keyword}")
        other => testing.error(t, "Match: {other}")
    }
    for content in ["Include /etc/ssh/sshd_config.d/*.conf", "Ciphers aes128-ctr"] {
        testing.error_if(t, refusal(content) == none, "accepted {content}")
    }
    for content in ["UsePAM yes", "X11Forwarding yes", "PermitEmptyPasswords yes", "Subsystem other /bin/x", "Port -1", "MaxStartups 9:50:3", "LoginGraceTime 2x", "PasswordAuthentication maybe", "Banner \"unterminated", "AllowTcpForwarding yes", "AllowTcpForwarding remote", "MaxAuthTries 0", "ListenAddress 192.0.2.1:22", "ListenAddress [::1]:22", "Subsystem sftp internal-sftp -l INFO", "AllowUsers !root", "DenyUsers alice@192.0.2.1", "AllowGroups wheel,staff", "AcceptEnv LC_[A-Z]*"] {
        match refusal(content) ?? panic("accepted {content}") {
            BadValue(at, keyword) => testing.error_if(t, at != 1, "{content}: line {at}")
            other => testing.error(t, "{content}: {other}")
        }
    }
}
