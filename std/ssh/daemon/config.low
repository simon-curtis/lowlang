import std/text

/// An error in an `sshd_config` file.
pub enum Error {
    /// The keyword on `line` is not one this server knows. `Match` and `Include` are among them.
    UnknownKeyword(line: i64, keyword: str)
    /// The keyword on `line` has a value this server does not support or cannot parse.
    BadValue(line: i64, keyword: str)
    /// A host key could not be loaded.
    HostKey(path: str)
    /// The configuration names no host key.
    NoHostKey
    /// Privilege cannot be separated, for the reason given.
    Unseparated(reason: str)
}

/// Who may log in as root, as `PermitRootLogin` says.
pub enum RootLogin {
    /// Root logs in with any method.
    Yes
    /// Root logs in with a public key only.
    KeyOnly
    /// Root may not log in.
    No
}

/// The settings of the server, as an `sshd_config` file gives them.
pub struct Settings {
    /// The ports to listen on (`Port`).
    pub ports: i64[] = [22]
    /// The addresses to listen on (`ListenAddress`); empty listens on every IPv4 and IPv6 address.
    pub listen: str[] = []
    /// The paths of the host keys (`HostKey`).
    pub host_keys: str[] = []
    /// `PermitRootLogin`.
    pub root_login: RootLogin = KeyOnly
    /// `PasswordAuthentication`.
    pub password_authentication: bool = true
    /// `PubkeyAuthentication`.
    pub pubkey_authentication: bool = true
    /// `AuthorizedKeysFile`, with `%h` for the home directory, `%u` for the user name and `%%` for `%`. A relative path is taken from the home directory.
    pub authorized_keys: str[] = [".ssh/authorized_keys"]
    /// `LoginGraceTime`, in seconds.
    pub login_grace: i64 = 120
    /// `MaxStartups` as start, rate and full.
    pub startups: i64[] = [10, 30, 100]
    /// `MaxAuthTries`, at least 1.
    pub max_auth_tries: i64 = 6
    /// `AcceptEnv`, as patterns where `*` matches any run of characters and `?` one character.
    pub accept_env: str[] = []
    /// `AllowUsers`, as patterns like `AcceptEnv`'s; empty allows every user.
    pub allow_users: str[] = []
    /// `DenyUsers`, as patterns.
    pub deny_users: str[] = []
    /// `AllowGroups`, as patterns; empty allows every group.
    pub allow_groups: str[] = []
    /// `DenyGroups`, as patterns.
    pub deny_groups: str[] = []
    /// The file `Banner` names, or the empty string for none.
    pub banner: str = ""
    /// The command of `Subsystem sftp`: `internal-sftp` for this server's own, a program and its arguments, or empty for none.
    pub sftp: str[] = []
    /// `StrictModes`.
    pub strict_modes: bool = true
    /// `PermitTTY`.
    pub permit_tty: bool = true
    /// Whether `AllowTcpForwarding local` lets a client open connections from the server with `direct-tcpip`. Remote forwarding, which would listen as root, is refused, so the default is `no` where OpenSSH's is `yes`.
    pub local_forwarding: bool = false
    /// `PidFile`, or the empty string for none.
    pub pid_file: str = ""
}

fn words_of(line: str) -> str[] ! Error {
    var out: str[] = []
    var i = 0
    for i < line.len {
        let c = line[i]
        if c == ' ' || c == '\t' || (c == '=' && out.len == 1) {
            i += 1
            continue
        }
        if c == '"' {
            var end = i + 1
            for end < line.len && line[end] != '"' {
                end += 1
            }
            if end >= line.len {
                fail BadValue(0, "quote")
            }
            out.push(line[i + 1..end])
            i = end + 1
            continue
        }
        var end = i
        for end < line.len && line[end] != ' ' && line[end] != '\t' && !(line[end] == '=' && out.len == 0) {
            end += 1
        }
        out.push(line[i..end])
        i = end
    }
    out
}

fn yes_no(value: str, n: i64, keyword: str) -> bool ! Error {
    match text.lower(value) {
        "yes" => true
        "no" => false
        _ => fail BadValue(n, keyword)
    }
}

fn only_no(value: str, n: i64, keyword: str) ! Error {
    if yes_no(value, n, keyword)? {
        fail BadValue(n, keyword)
    }
}

fn seconds(value: str, n: i64, keyword: str) -> i64 ! Error {
    var total = 0
    var digits = 0
    for c in bytes(value) {
        if c >= '0' && c <= '9' {
            digits = digits * 10 + i64(c - '0')
            continue
        }
        let unit = match c {
            's' => 1
            'm' => 60
            'h' => 3600
            'd' => 86400
            'w' => 604800
            _ => fail BadValue(n, keyword)
        }
        total += digits * unit
        digits = 0
    }
    total + digits
}

fn number(value: str, n: i64, keyword: str) -> i64 ! Error {
    let v = text.parse_int(value) or fail BadValue(n, keyword)
    if v < 0 {
        fail BadValue(n, keyword)
    }
    v
}

fn patterns(args: str[], n: i64, keyword: str) -> str[] ! Error {
    for a in args {
        for c in bytes(a) {
            if c == '!' || c == '@' || c == '[' || c == '\\' || c == ',' {
                fail BadValue(n, keyword)
            }
        }
    }
    args
}

fn listen_address(value: str, n: i64) -> str ! Error {
    let colons = text.count(value, ":")
    if text.contains(value, "[") || colons == 1 {
        fail BadValue(n, "listenaddress")
    }
    value
}

fn startups(value: str, n: i64) -> i64[] ! Error {
    let parts = text.split(value, ':')
    if parts.len == 1 {
        let full = number(parts[0], n, "maxstartups")?
        return [full, 100, full]
    }
    if parts.len != 3 {
        fail BadValue(n, "maxstartups")
    }
    let start = number(parts[0], n, "maxstartups")?
    let rate = number(parts[1], n, "maxstartups")?
    let full = number(parts[2], n, "maxstartups")?
    if start > full || rate > 100 {
        fail BadValue(n, "maxstartups")
    }
    [start, rate, full]
}

fn root_login(value: str, n: i64) -> RootLogin ! Error {
    match text.lower(value) {
        "yes" => RootLogin.Yes
        "no" => RootLogin.No
        "prohibit-password" => RootLogin.KeyOnly
        "without-password" => RootLogin.KeyOnly
        _ => fail BadValue(n, "permitrootlogin")
    }
}

fn apply(mut s: Settings, keyword: str, args: str[], n: i64, seen: [str: bool]) ! Error {
    if args.len == 0 {
        fail BadValue(n, keyword)
    }
    let value = args[0]
    let first = seen[keyword] == none
    match keyword {
        "port" => {
            if first {
                s.ports = []
            }
            s.ports.push(number(value, n, keyword)?)
        }
        "listenaddress" => s.listen.push(listen_address(value, n)?)
        "hostkey" => s.host_keys.push(value)
        "permitrootlogin" => {
            s.root_login = root_login(value, n)?
        }
        "passwordauthentication" => {
            s.password_authentication = yes_no(value, n, keyword)?
        }
        "pubkeyauthentication" => {
            s.pubkey_authentication = yes_no(value, n, keyword)?
        }
        "authorizedkeysfile" => {
            s.authorized_keys = []
            for a in args {
                if a != "none" {
                    s.authorized_keys.push(a)
                }
            }
        }
        "logingracetime" => {
            s.login_grace = seconds(value, n, keyword)?
        }
        "maxstartups" => {
            s.startups = startups(value, n)?
        }
        "maxauthtries" => {
            s.max_auth_tries = number(value, n, keyword)?
            if s.max_auth_tries == 0 {
                fail BadValue(n, keyword)
            }
        }
        "acceptenv" => {
            for a in patterns(args, n, keyword)? {
                s.accept_env.push(a)
            }
        }
        "allowusers" => {
            for a in patterns(args, n, keyword)? {
                s.allow_users.push(a)
            }
        }
        "denyusers" => {
            for a in patterns(args, n, keyword)? {
                s.deny_users.push(a)
            }
        }
        "allowgroups" => {
            for a in patterns(args, n, keyword)? {
                s.allow_groups.push(a)
            }
        }
        "denygroups" => {
            for a in patterns(args, n, keyword)? {
                s.deny_groups.push(a)
            }
        }
        "banner" => {
            s.banner = "" when value == "none" else value
        }
        "subsystem" => {
            if text.lower(value) != "sftp" || args.len < 2 || (args[1] == "internal-sftp" && args.len > 2) {
                fail BadValue(n, keyword)
            }
            s.sftp = args[1..]
        }
        "strictmodes" => {
            s.strict_modes = yes_no(value, n, keyword)?
        }
        "permittty" => {
            s.permit_tty = yes_no(value, n, keyword)?
        }
        "allowtcpforwarding" => {
            let v = text.lower(value)
            if v != "no" && v != "local" {
                fail BadValue(n, keyword)
            }
            s.local_forwarding = v == "local"
        }
        "pidfile" => {
            s.pid_file = "" when value == "none" else value
        }
        "permitemptypasswords" => only_no(value, n, keyword)?
        "usepam" => only_no(value, n, keyword)?
        "x11forwarding" => only_no(value, n, keyword)?
        "allowagentforwarding" => only_no(value, n, keyword)?
        "permituserenvironment" => only_no(value, n, keyword)?
        "kbdinteractiveauthentication" => only_no(value, n, keyword)?
        "challengeresponseauthentication" => only_no(value, n, keyword)?
        "printmotd" => only_no(value, n, keyword)?
        _ => fail UnknownKeyword(n, keyword)
    }
}

/// Parses the text of an `sshd_config` file.
///
/// Keywords are case-insensitive, a value may be quoted, and `#` starts a comment line. As in OpenSSH the first value of a keyword wins, except for keywords that list values, which add up. Fails with `UnknownKeyword` for a keyword this server does not implement, `Match` and `Include` among them, and with `BadValue` for a value it cannot honour, such as `UsePAM yes`, `AllowTcpForwarding yes`, a negated or `user@host` pattern, or a `ListenAddress` with a port, so a setting is never silently ignored.
pub fn parse_config(content: str) -> Settings ! Error {
    var s = Settings {}
    var seen: [str: bool] = [:]
    for i, raw in text.lines(content) {
        let line = text.trim(raw)
        if line.len == 0 || line[0] == '#' {
            continue
        }
        let words = words_of(line) catch {
            e => fail BadValue(i + 1, "quote")
        }
        let keyword = text.lower(words[0])
        let lists = keyword == "port" || keyword == "listenaddress" || keyword == "hostkey" || keyword == "acceptenv" || text.ends_with(keyword, "users") || text.ends_with(keyword, "groups")
        if seen[keyword] != none && !lists {
            continue
        }
        apply(mut s, keyword, words[1..], i + 1, seen)?
        seen[keyword] = true
    }
    s
}
