import std/ssh/daemon

fn describe(e: daemon.Error) -> str {
    match e {
        UnknownKeyword(at, keyword) => "line {at}: {keyword} is not supported"
        BadValue(at, keyword) => "line {at}: this value of {keyword} is not supported"
        HostKey(path) => "cannot load {path}"
        NoHostKey => "no host key"
        Unseparated(reason) => reason
    }
}

fn check(content: str) {
    let s = daemon.parse_config(content) catch {
        e => {
            print("refused: {describe(e)}")
            return
        }
    }
    print("ports {s.ports}, root login {s.root_login}, passwords {s.password_authentication}, users {s.allow_users}, grace {s.login_grace}s, sftp {s.sftp}")
}

fn main() {
    check("Port 22\nPort 2222\nPermitRootLogin no\nPasswordAuthentication no\nAllowUsers alice deploy-*\nLoginGraceTime 1m\nSubsystem sftp internal-sftp\n")
    check("Port 22\nUsePAM yes\n")
    check("Match User alice\n    PasswordAuthentication yes\n")
}
