import std/crypto
import std/crypto/aead
import std/crypto/cipher
import std/crypto/hash
import std/io
import std/ssh/wire

const max_packet = 262144

enum Mode {
    Plain
    Chacha
    Gcm
    Ctr
}

struct CipherSpec {
    name: str
    key_len: i64
    iv_len: i64
    block: i64
    tag_len: i64
    mode: Mode
}

struct MacSpec {
    name: str
    key_len: i64
    hash: hash.Algorithm
}

fn cipher_spec(name: str) -> CipherSpec? {
    match name {
        "chacha20-poly1305@openssh.com" => CipherSpec { name, key_len: 64, iv_len: 0, block: 8, tag_len: 16, mode: Mode.Chacha }
        "aes256-gcm@openssh.com" => CipherSpec { name, key_len: 32, iv_len: 12, block: 16, tag_len: 16, mode: Mode.Gcm }
        "aes128-gcm@openssh.com" => CipherSpec { name, key_len: 16, iv_len: 12, block: 16, tag_len: 16, mode: Mode.Gcm }
        "aes256-ctr" => CipherSpec { name, key_len: 32, iv_len: 16, block: 16, tag_len: 0, mode: Mode.Ctr }
        "aes128-ctr" => CipherSpec { name, key_len: 16, iv_len: 16, block: 16, tag_len: 0, mode: Mode.Ctr }
        _ => none
    }
}

fn mac_spec(name: str) -> MacSpec? {
    match name {
        "hmac-sha2-512-etm@openssh.com" => MacSpec { name, key_len: 64, hash: hash.sha512() }
        "hmac-sha2-256-etm@openssh.com" => MacSpec { name, key_len: 32, hash: hash.sha256() }
        _ => none
    }
}

struct Protection {
    mode: Mode
    block: i64
    tag_len: i64
    main_key: []u8
    length_key: []u8
    sealer: aead.Aead?
    fixed_iv: []u8
    counter: []u8
    aes: *cipher.Block?
    mac_key: []u8
    mac_hash: hash.Algorithm
}

fn plain() -> *Protection {
    new(Protection {
        mode: Mode.Plain
        block: 8
        tag_len: 0
        main_key: []
        length_key: []
        sealer: none
        fixed_iv: []
        counter: []
        aes: none
        mac_key: []
        mac_hash: hash.sha256()
    })
}

fn protection(spec: CipherSpec, mac: MacSpec?, key: []u8, iv: []u8, mac_key: []u8) -> *Protection ! Error {
    let p = plain()
    p.mode = spec.mode
    p.block = spec.block
    p.tag_len = spec.tag_len
    match spec.mode {
        Chacha => {
            p.main_key = key[..32]
            p.length_key = key[32..64]
        }
        Gcm => {
            p.sealer = aead.aes_gcm(key) catch Io
            p.fixed_iv = iv[..4]
            p.counter = iv[4..12]
        }
        Ctr => {
            let m = match mac {
                some(chosen) => chosen
                none => fail Unsupported
            }
            p.aes = cipher.aes(key) or fail Unsupported
            p.counter = io.buffer(16)
            io.copy(p.counter, iv)
            p.mac_key = mac_key
            p.mac_hash = m.hash
            p.tag_len = m.hash.size
        }
        Plain => {}
    }
    p
}

fn advance(counter: []u8, by: i64) {
    var carry = by
    var i = counter.len - 1
    for i >= 0 && carry > 0 {
        let sum = i64(counter[i]) + (carry & 0xFF)
        counter[i] = u8(sum)
        carry = (carry >> 8) + (sum >> 8)
        i -= 1
    }
}

fn nonce_for(seq: i64) -> []u8 {
    var nonce: []u8 = [0, 0, 0, 0]
    io.put_be64(mut nonce, seq)
    nonce
}

fn gcm_nonce(p: *Protection) -> []u8 {
    var nonce: []u8 = []
    io.append(mut nonce, p.fixed_iv)
    io.append(mut nonce, p.counter)
    nonce
}

fn sequence_bytes(seq: i64) -> []u8 {
    var out: []u8 = []
    io.put_be32(mut out, seq & 0xFFFFFFFF)
    out
}

fn padding_for(p: *Protection, payload: i64) -> i64 {
    let align = p.block
    let counted = if p.mode == Mode.Plain { 5 + payload } else { 1 + payload }
    var pad = align - counted % align
    if pad < 4 {
        pad += align
    }
    pad
}

fn seal(p: *Protection, seq: i64, payload: []u8) -> []u8 ! Error {
    let pad = padding_for(p, payload.len)
    var body: []u8 = [u8(pad)]
    io.append(mut body, payload)
    io.append(mut body, crypto.random(pad))
    var head: []u8 = []
    io.put_be32(mut head, body.len)
    var out: []u8 = []
    match p.mode {
        Plain => {
            io.append(mut out, head)
            io.append(mut out, body)
        }
        Chacha => {
            let nonce = nonce_for(seq)
            let sealed_head = aead.chacha20_xor(p.length_key, 0, nonce, head) catch Io
            let sealed_body = aead.chacha20_xor(p.main_key, 1, nonce, body) catch Io
            let poly_key = aead.chacha20_block(p.main_key, 0, nonce)[..32]
            var authed: []u8 = []
            io.append(mut authed, sealed_head)
            io.append(mut authed, sealed_body)
            let tag = aead.poly1305(poly_key, authed) catch Io
            io.append(mut out, authed)
            io.append(mut out, tag)
        }
        Gcm => {
            let sealer = match p.sealer {
                some(s) => s
                none => fail Unsupported
            }
            let sealed = sealer.seal(gcm_nonce(p), body, head)
            advance(p.counter, 1)
            io.append(mut out, head)
            io.append(mut out, sealed)
        }
        Ctr => {
            let block = match p.aes {
                some(b) => b
                none => fail Unsupported
            }
            let encrypted = cipher.ctr(block, p.counter, body) or fail Unsupported
            advance(p.counter, body.len / 16)
            var authed: []u8 = []
            io.append(mut authed, sequence_bytes(seq))
            io.append(mut authed, head)
            io.append(mut authed, encrypted)
            let tag = hash.hmac(p.mac_hash, p.mac_key, authed)
            io.append(mut out, head)
            io.append(mut out, encrypted)
            io.append(mut out, tag)
        }
    }
    out
}

fn check_length(p: *Protection, length: i64) ! Error {
    if length > max_packet {
        fail TooLarge
    }
    let aligned = if p.mode == Mode.Plain { length + 4 } else { length }
    if length < 5 || aligned % p.block != 0 {
        fail Malformed
    }
}

fn unpad(body: []u8) -> []u8 ! Error {
    let pad = i64(body[0])
    if pad < 4 || pad + 1 > body.len {
        fail Malformed
    }
    body[1..body.len - pad]
}

fn take_bytes(r: *io.Reader, n: i64) -> []u8 ! Error {
    io.read_exact(r, n) catch Io
}

fn open(p: *Protection, seq: i64, r: *io.Reader) -> []u8 ! Error {
    let head = take_bytes(r, 4)?
    match p.mode {
        Plain => {
            let length = io.be32(head, 0)
            check_length(p, length)?
            unpad(take_bytes(r, length)?)?
        }
        Chacha => {
            let nonce = nonce_for(seq)
            let plain_head = aead.chacha20_xor(p.length_key, 0, nonce, head) catch Io
            let length = io.be32(plain_head, 0)
            check_length(p, length)?
            let rest = take_bytes(r, length + 16)?
            let poly_key = aead.chacha20_block(p.main_key, 0, nonce)[..32]
            var authed: []u8 = []
            io.append(mut authed, head)
            io.append(mut authed, rest[..length])
            let expected = aead.poly1305(poly_key, authed) catch Io
            if !hash.equal(expected, rest[length..]) {
                fail MacFailed
            }
            let body = aead.chacha20_xor(p.main_key, 1, nonce, rest[..length]) catch Io
            unpad(body)?
        }
        Gcm => {
            let length = io.be32(head, 0)
            check_length(p, length)?
            let sealed = take_bytes(r, length + 16)?
            let opener = match p.sealer {
                some(s) => s
                none => fail Unsupported
            }
            let body = opener.open(gcm_nonce(p), sealed, head) or fail MacFailed
            advance(p.counter, 1)
            unpad(body)?
        }
        Ctr => {
            let length = io.be32(head, 0)
            check_length(p, length)?
            let encrypted = take_bytes(r, length)?
            let tag = take_bytes(r, p.tag_len)?
            var authed: []u8 = []
            io.append(mut authed, sequence_bytes(seq))
            io.append(mut authed, head)
            io.append(mut authed, encrypted)
            let expected = hash.hmac(p.mac_hash, p.mac_key, authed)
            if !hash.equal(expected, tag) {
                fail MacFailed
            }
            let block = match p.aes {
                some(b) => b
                none => fail Unsupported
            }
            let body = cipher.ctr(block, p.counter, encrypted) or fail Unsupported
            advance(p.counter, length / 16)
            unpad(body)?
        }
    }
}
