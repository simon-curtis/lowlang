import std/crypto
import std/io
import std/ssh/wire

/// The algorithms a side offers for a connection, each list in order of preference.
///
/// An empty list selects the module's default for that kind: `default_kex`, `default_host_keys`, `default_ciphers` or `default_macs`.
pub struct Algorithms {
    /// The key exchange methods, such as `curve25519-sha256`.
    pub kex: str[] = []
    /// The host key algorithms, such as `ssh-ed25519`, or `ssh-ed25519-cert-v01@openssh.com` for a host certificate. A server offers only the ones its host keys sign with; a client accepts host certificates only when it lists their names.
    pub host_keys: str[] = []
    /// The ciphers, such as `chacha20-poly1305@openssh.com`.
    pub ciphers: str[] = []
    /// The MACs, which only the non-AEAD ciphers use, such as `hmac-sha2-256-etm@openssh.com`.
    pub macs: str[] = []
}

/// Returns the default key exchange methods in order of preference: `mlkem768x25519-sha256`, `curve25519-sha256`, `ecdh-sha2-nistp256`, `ecdh-sha2-nistp384`, `diffie-hellman-group16-sha512` and `diffie-hellman-group14-sha256`.
pub fn default_kex() -> str[] {
    [
        "mlkem768x25519-sha256"
        "curve25519-sha256"
        "ecdh-sha2-nistp256"
        "ecdh-sha2-nistp384"
        "diffie-hellman-group16-sha512"
        "diffie-hellman-group14-sha256"
    ]
}

/// Returns the default host key algorithms in order of preference: `ssh-ed25519`, `ecdsa-sha2-nistp256`, `ecdsa-sha2-nistp384`, `rsa-sha2-512` and `rsa-sha2-256`.
pub fn default_host_keys() -> str[] {
    ["ssh-ed25519", "ecdsa-sha2-nistp256", "ecdsa-sha2-nistp384", "rsa-sha2-512", "rsa-sha2-256"]
}

/// Returns the default ciphers in order of preference: `chacha20-poly1305@openssh.com`, `aes256-gcm@openssh.com`, `aes128-gcm@openssh.com`, `aes256-ctr` and `aes128-ctr`.
pub fn default_ciphers() -> str[] {
    [
        "chacha20-poly1305@openssh.com"
        "aes256-gcm@openssh.com"
        "aes128-gcm@openssh.com"
        "aes256-ctr"
        "aes128-ctr"
    ]
}

/// Returns the default MACs in order of preference: `hmac-sha2-512-etm@openssh.com` and `hmac-sha2-256-etm@openssh.com`.
pub fn default_macs() -> str[] {
    ["hmac-sha2-512-etm@openssh.com", "hmac-sha2-256-etm@openssh.com"]
}

struct Proposal {
    kex: str[]
    host_keys: str[]
    ciphers_out: str[]
    ciphers_in: str[]
    macs_out: str[]
    macs_in: str[]
    compression_out: str[]
    compression_in: str[]
    first_follows: bool
}

fn proposal_for(a: Algorithms, client: bool, initial: bool) -> Proposal {
    var kex: str[] = if a.kex.len > 0 { a.kex } else { default_kex() }
    if initial {
        var markers: str[] = []
        for name in kex {
            markers.push(name)
        }
        markers.push(if client { "ext-info-c" } else { "ext-info-s" })
        markers.push(if client { "kex-strict-c-v00@openssh.com" } else { "kex-strict-s-v00@openssh.com" })
        kex = markers
    }
    let ciphers = if a.ciphers.len > 0 { a.ciphers } else { default_ciphers() }
    let macs = if a.macs.len > 0 { a.macs } else { default_macs() }
    let host_keys = if a.host_keys.len > 0 { a.host_keys } else { default_host_keys() }
    Proposal {
        kex
        host_keys
        ciphers_out: ciphers
        ciphers_in: ciphers
        macs_out: macs
        macs_in: macs
        compression_out: ["none"]
        compression_in: ["none"]
        first_follows: false
    }
}

fn encode_proposal(p: Proposal) -> u8[] {
    var out: u8[] = [20]
    io.append(mut out, crypto.random(16))
    wire.put_names(mut out, p.kex)
    wire.put_names(mut out, p.host_keys)
    wire.put_names(mut out, p.ciphers_out)
    wire.put_names(mut out, p.ciphers_in)
    wire.put_names(mut out, p.macs_out)
    wire.put_names(mut out, p.macs_in)
    wire.put_names(mut out, p.compression_out)
    wire.put_names(mut out, p.compression_in)
    wire.put_names(mut out, [])
    wire.put_names(mut out, [])
    wire.put_bool(mut out, p.first_follows)
    wire.put_u32(mut out, 0)
    out
}

fn decode_proposal(payload: u8[]) -> Proposal ! Error {
    let r = wire.reader(payload)
    let kind = wire.read_u8(r) catch Io
    if kind != 20 {
        fail Malformed
    }
    wire.read_bytes(r, 16) catch Io
    let kex = wire.read_names(r) catch Io
    let host_keys = wire.read_names(r) catch Io
    let ciphers_out = wire.read_names(r) catch Io
    let ciphers_in = wire.read_names(r) catch Io
    let macs_out = wire.read_names(r) catch Io
    let macs_in = wire.read_names(r) catch Io
    let compression_out = wire.read_names(r) catch Io
    let compression_in = wire.read_names(r) catch Io
    wire.read_names(r) catch Io
    wire.read_names(r) catch Io
    let first_follows = wire.read_bool(r) catch Io
    wire.read_u32(r) catch Io
    wire.finish(r) catch Io
    Proposal { kex, host_keys, ciphers_out, ciphers_in, macs_out, macs_in, compression_out, compression_in, first_follows }
}

struct Negotiated {
    kex: KexSpec
    host_key: str
    cipher_out: CipherSpec
    cipher_in: CipherSpec
    mac_out: MacSpec?
    mac_in: MacSpec?
    strict: bool
    ext_info: bool
    discard_next: bool
}

fn first_common(client: str[], server: str[]) -> str? {
    for name in client {
        if wire.has_name(server, name) {
            return name
        }
    }
    none
}

fn choose(kind: str, client: str[], server: str[]) -> str ! Error {
    match first_common(client, server) {
        some(name) => name
        none => fail NoCommonAlgorithm(kind)
    }
}

fn choose_kex(client: str[], server: str[]) -> KexSpec ! Error {
    for name in client {
        if wire.has_name(server, name) {
            match kex_spec(name) {
                some(spec) => return spec
                none => {}
            }
        }
    }
    fail NoCommonAlgorithm("kex")
}

fn negotiate(local: Proposal, peer: Proposal, client: bool) -> Negotiated ! Error {
    let mine = if client { local } else { peer }
    let theirs = if client { peer } else { local }
    let kex = choose_kex(mine.kex, theirs.kex)?
    let kex_name = kex.name
    let host_key = choose("host key", mine.host_keys, theirs.host_keys)?
    let c2s = choose("cipher", mine.ciphers_out, theirs.ciphers_out)?
    let s2c = choose("cipher", mine.ciphers_in, theirs.ciphers_in)?
    let _ = choose("compression", mine.compression_out, theirs.compression_out)?
    let _ = choose("compression", mine.compression_in, theirs.compression_in)?
    let spec_c2s = cipher_spec(c2s) ?? fail Invalid
    let spec_s2c = cipher_spec(s2c) ?? fail Invalid
    var mac_c2s: MacSpec? = none
    var mac_s2c: MacSpec? = none
    if spec_c2s.mode == Mode.Ctr {
        mac_c2s = mac_spec(choose("mac", mine.macs_out, theirs.macs_out)?)
    }
    if spec_s2c.mode == Mode.Ctr {
        mac_s2c = mac_spec(choose("mac", mine.macs_in, theirs.macs_in)?)
    }
    let strict = wire.has_name(mine.kex, "kex-strict-c-v00@openssh.com") && wire.has_name(theirs.kex, "kex-strict-s-v00@openssh.com")
    let ext_info = if client { wire.has_name(theirs.kex, "ext-info-s") } else { wire.has_name(mine.kex, "ext-info-c") }
    let peer_first_kex = if peer.kex.len > 0 { peer.kex[0] } else { "" }
    let peer_first_host = if peer.host_keys.len > 0 { peer.host_keys[0] } else { "" }
    let guessed = peer_first_kex == kex_name && peer_first_host == host_key
    Negotiated {
        kex
        host_key
        cipher_out: if client { spec_c2s } else { spec_s2c }
        cipher_in: if client { spec_s2c } else { spec_c2s }
        mac_out: if client { mac_c2s } else { mac_s2c }
        mac_in: if client { mac_s2c } else { mac_c2s }
        strict
        ext_info
        discard_next: peer.first_follows && !guessed
    }
}
