import std/io
import std/text
import std/unicode

/// A cursor over the bytes of one SSH message, reading the data types of RFC 4251 section 5.
///
/// Used through a pointer made by `reader`. Every read fails with `Malformed` when the message ends early.
pub struct Reader {
    data: []u8
    at: i64
}

/// Returns a reader positioned at the start of `data`.
pub fn reader(data: []u8) -> *Reader {
    new(Reader { data, at: 0 })
}

/// Returns the number of bytes not yet read.
pub fn left(r: *Reader) -> i64 {
    r.data.len - r.at
}

/// Returns the number of bytes read so far.
pub fn offset(r: *Reader) -> i64 {
    r.at
}

/// Returns the bytes not yet read without consuming them.
pub fn rest(r: *Reader) -> []u8 {
    r.data[r.at..]
}

/// Reads `n` raw bytes. The result shares the message's memory.
///
/// Fails with `Malformed` when `n` is negative or fewer than `n` bytes remain.
pub fn read_bytes(r: *Reader, n: i64) -> []u8 ! io.Error {
    if n < 0 || left(r) < n {
        fail Malformed
    }
    let out = r.data[r.at..r.at + n]
    r.at += n
    out
}

/// Reads one byte.
pub fn read_u8(r: *Reader) -> i64 ! io.Error {
    i64(read_bytes(r, 1)?[0])
}

/// Reads a boolean byte; any non-zero value is `true`.
pub fn read_bool(r: *Reader) -> bool ! io.Error {
    read_u8(r)? != 0
}

/// Reads a big-endian `uint32`.
pub fn read_u32(r: *Reader) -> i64 ! io.Error {
    io.be32(read_bytes(r, 4)?, 0)
}

/// Reads a big-endian `uint64`, which is returned as a `u64`.
pub fn read_u64(r: *Reader) -> u64 ! io.Error {
    io.u64_be(read_bytes(r, 8)?, 0)
}

/// Reads a `string`: a `uint32` length and that many bytes. The result shares the message's memory.
pub fn read_string(r: *Reader) -> []u8 ! io.Error {
    let n = read_u32(r)?
    read_bytes(r, n)
}

/// Reads a `string` as text, copying it. Fails with `Malformed` when the bytes are not valid UTF-8.
pub fn read_str(r: *Reader) -> str ! io.Error {
    let raw = read_string(r)?
    let s = str(raw)
    if !unicode.utf8_valid(s) {
        fail Malformed
    }
    s
}

/// Reads an `mpint` that must be non-negative and minimally encoded, and returns its big-endian magnitude without leading zeros.
///
/// Fails with `Malformed` for a negative number or an encoding with a superfluous leading zero byte.
pub fn read_mpint(r: *Reader) -> []u8 ! io.Error {
    let raw = read_string(r)?
    if raw.len == 0 {
        return raw
    }
    if raw[0] & 0x80 != 0 {
        fail Malformed
    }
    if raw[0] == 0 {
        if raw.len == 1 || raw[1] & 0x80 == 0 {
            fail Malformed
        }
        return raw[1..]
    }
    raw
}

/// Reads a `name-list`: comma-separated names in a `string`. An empty list is an empty slice.
///
/// Fails with `Malformed` for an empty name between two commas or a name that is not US-ASCII.
pub fn read_names(r: *Reader) -> []str ! io.Error {
    let raw = read_str(r)?
    if raw.len == 0 {
        return []
    }
    let names = text.split(raw, ',')
    for name in names {
        if name.len == 0 {
            fail Malformed
        }
        for c in name {
            if c >= 0x80 {
                fail Malformed
            }
        }
    }
    names
}

/// Fails with `Malformed` unless every byte of the message has been read.
pub fn finish(r: *Reader) ! io.Error {
    if left(r) != 0 {
        fail Malformed
    }
}

/// Appends a big-endian `uint32`.
pub fn put_u32(mut out: []u8, v: i64) {
    io.put_be32(mut out, v)
}

/// Appends a big-endian `uint64`.
pub fn put_u64(mut out: []u8, v: u64) {
    io.put_be64(mut out, i64(v))
}

/// Appends a boolean byte.
pub fn put_bool(mut out: []u8, v: bool) {
    push(mut out, if v { 1 } else { 0 })
}

/// Appends a `string`: the `uint32` length of `data` followed by `data`.
pub fn put_string(mut out: []u8, data: []u8) {
    io.put_be32(mut out, data.len)
    io.append(mut out, data)
}

/// Appends the text `s` as a `string`.
pub fn put_str(mut out: []u8, s: str) {
    io.put_be32(mut out, s.len)
    text.append(mut out, s)
}

/// Appends the non-negative big-endian integer `magnitude` as an `mpint`, dropping leading zeros and adding the zero byte that keeps the number positive.
pub fn put_mpint(mut out: []u8, magnitude: []u8) {
    var at = 0
    for at < magnitude.len && magnitude[at] == 0 {
        at += 1
    }
    let digits = magnitude[at..]
    if digits.len == 0 {
        io.put_be32(mut out, 0)
        return
    }
    if digits[0] & 0x80 != 0 {
        io.put_be32(mut out, digits.len + 1)
        push(mut out, 0)
    } else {
        io.put_be32(mut out, digits.len)
    }
    io.append(mut out, digits)
}

/// Appends `names` as a `name-list`.
pub fn put_names(mut out: []u8, names: []str) {
    put_str(mut out, text.join(names, ","))
}

/// Returns whether `names` contains `name`.
pub fn has_name(names: []str, name: str) -> bool {
    for n in names {
        if n == name {
            return true
        }
    }
    false
}
