import std/crypto
import std/crypto/ecdsa
import std/crypto/x509
import std/net
import std/slices
import std/ssh/key
import std/testing
import std/text

struct Pair {
    client: *Link
    server: *Link
}

fn signer_for(kind: str) -> key.Signer {
    let private = match kind {
        "ed25519" => x509.PrivateKey.Ed25519(crypto.random(32))
        _ => x509.PrivateKey.Ed25519(crypto.random(32))
    }
    key.signer(private) or panic("signer")
}

fn setup_for(client: bool, algorithms: Algorithms, signers: key.Signer[]) -> Setup {
    Setup {
        client
        algorithms
        signers
        verify: fn(k) { true }
        rekey_bytes: 1073741824
        rekey_millis: 3600000
    }
}

fn run_handshake(l: *Link, done: chan[bool]) {
    handshake(l) catch {
        e => {
            l.failure = e
        }
    }
    done <- true
}

fn handshake_both(client_algorithms: Algorithms, server_algorithms: Algorithms, signers: key.Signer[], ends: net.ConnPair) -> Pair {
    let client = new_link(net.stream(ends.first), setup_for(true, client_algorithms, signers))
    let server = new_link(net.stream(ends.second), setup_for(false, server_algorithms, signers))
    let done = chan[bool](2)
    spawn run_handshake(client, done)
    spawn run_handshake(server, done)
    let a = <-done
    let b = <-done
    Pair { client, server }
}

fn failed_with(l: *Link) -> str {
    match l.failure {
        some(e) => error_name(e)
        none => ""
    }
}

fn round_trip(t: *testing.T, p: Pair) {
    testing.require(t, p.client.failure == none)
    testing.require(t, p.server.failure == none)
    send(p.client, [80, 1, 2, 3]) or panic("client send")
    let got = next_message(p.server) or [0]
    testing.error_if(t, !slices.equal(got, [80, 1, 2, 3]), "client to server message")
    send(p.server, [81, 9, 8]) or panic("server send")
    let back = next_message(p.client) or [0]
    testing.error_if(t, !slices.equal(back, [81, 9, 8]), "server to client message")
}

fn exercise(t: *testing.T, name: str, client: Algorithms, server: Algorithms) {
    testing.sub(t, name, fn(t) {
        using ends = net.socketpair() or panic("socketpair")
        let signers = [signer_for("ed25519")]
        let p = handshake_both(client, server, signers, ends)
        round_trip(t, p)
        close_link(p.client)
        close_link(p.server)
    })
}

fn test_kex_methods(t: *testing.T) {
    for name in ["curve25519-sha256", "curve25519-sha256@libssh.org", "ecdh-sha2-nistp256", "ecdh-sha2-nistp384", "diffie-hellman-group14-sha256", "diffie-hellman-group16-sha512", "mlkem768x25519-sha256"] {
        let a = Algorithms { kex: [name] }
        exercise(t, name, a, a)
    }
}

fn test_ciphers(t: *testing.T) {
    for name in ["chacha20-poly1305@openssh.com", "aes128-gcm@openssh.com", "aes256-gcm@openssh.com", "aes128-ctr", "aes256-ctr"] {
        let a = Algorithms { ciphers: [name] }
        exercise(t, name, a, a)
    }
}

fn test_macs(t: *testing.T) {
    for name in ["hmac-sha2-256-etm@openssh.com", "hmac-sha2-512-etm@openssh.com"] {
        let a = Algorithms { ciphers: ["aes256-ctr"], macs: [name] }
        exercise(t, name, a, a)
    }
}
