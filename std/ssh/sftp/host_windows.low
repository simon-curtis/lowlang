import std/text

const forbidden = "<>:\"|?*"

fn client_path(path: str) -> str {
    text.replace(path, "\\", "/")
}

fn is_letter(c: u8) -> bool {
    (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
}

fn link_target(target: str) -> str {
    let portable = client_path(target)
    if portable.len >= 2 && portable[1] == ':' && is_letter(portable[0]) {
        return portable[2..]
    }
    portable
}

fn device_stem(part: str) -> str {
    var end = part.len
    let dot = text.index_byte(part, '.')
    if dot >= 0 {
        end = dot
    }
    var stem = part[..end]
    for stem.len > 0 && stem[stem.len - 1] == ' ' {
        stem = stem[..stem.len - 1]
    }
    text.lower(stem)
}

fn numbered_device(stem: str, prefix: str) -> bool {
    if !text.starts_with(stem, prefix) {
        return false
    }
    let suffix = stem[prefix.len..]
    let digit = suffix.len == 1 && suffix[0] >= '1' && suffix[0] <= '9'
    let superscript = suffix.len == 2 && suffix[0] == 0xC2 && (suffix[1] == 0xB9 || suffix[1] == 0xB2 || suffix[1] == 0xB3)
    digit || superscript
}

fn device_name(part: str) -> bool {
    let stem = device_stem(part)
    if stem == "con" || stem == "prn" || stem == "aux" || stem == "nul" || stem == "conin$" || stem == "conout$" {
        return true
    }
    numbered_device(stem, "com") || numbered_device(stem, "lpt")
}

fn valid_part(part: str) -> bool {
    for i in 0..part.len {
        if part[i] < 32 || text.contains(forbidden, part[i..i + 1]) {
            return false
        }
    }
    let last = part[part.len - 1]
    if last == '.' || last == ' ' {
        return false
    }
    !device_name(part)
}
