import std/file
import std/net
import std/testing

fn test_windows_path_forms_stay_inside_the_root(t: *testing.T) {
    let parent = file.temp_dir("sftp-windows-paths") or panic("temp dir")
    let root = "{parent}/root"
    file.mkdir(root) or panic("mkdir root")
    file.write_text("{parent}/secret.txt", "outside") or panic("secret")
    file.write_text("{root}/inside.txt", "inside") or panic("inside")
    using ends = net.socketpair() or panic("socketpair")
    spawn serve_in(net.stream(ends.second), root)
    using client = connect(net.stream(ends.first)) or panic("connect")
    let c = client.handle
    for path in ["..\\secret.txt", "..\\..\\secret.txt", "a\\..\\..\\secret.txt", "\\..\\secret.txt", "{parent}\\secret.txt", "C:\\Windows\\win.ini", "C:secret.txt", "\\\\?\\C:\\Windows\\win.ini", "\\\\localhost\\c$\\Windows\\win.ini", "inside.txt:stream", "inside.txt::$DATA", "NUL", "nul.txt", "COM1", "con", "AUX.log", "LPT9", "CONIN$", "inside.txt.", "inside.txt ", "..."] {
        expect_failure(t, "read of {path}", "NotFound", read_failure(c, path))
    }
    let backslashes = read_file(c, "\\inside.txt") or panic("backslash from the root")
    testing.error_if(t, str(backslashes) != "inside", "a leading backslash starts at the root: {str(backslashes)}")
    let nested = read_file(c, "x\\..\\inside.txt") or panic("backslash dot-dot")
    testing.error_if(t, str(nested) != "inside", "a backslash dot-dot stays inside: {str(nested)}")
    testing.error_if(t, !file.exists("{parent}/secret.txt"), "the file outside the root is gone")
    file.remove_all(parent) or panic("remove")
}

fn test_windows_links_cannot_leave_the_root(t: *testing.T) {
    let parent = file.temp_dir("sftp-windows-links") or panic("temp dir")
    let root = "{parent}/root"
    file.mkdir(root) or panic("mkdir root")
    file.write_text("{parent}/secret.txt", "outside") or panic("secret")
    file.mkdir("{parent}/outside") or panic("outside")
    file.write_text("{parent}/outside/data.txt", "outside data") or panic("data")
    file.symlink("..\\secret.txt", "{root}/backslash_escape") catch {
        e => testing.skip(t, "symbolic links cannot be created")
    }
    file.symlink("{parent}\\secret.txt", "{root}/absolute_escape") or panic("link")
    file.symlink("{parent}\\outside", "{root}/directory_escape") or panic("link")
    file.symlink("..\\..\\..\\..\\Windows\\win.ini", "{root}/deep_escape") or panic("link")
    using ends = net.socketpair() or panic("socketpair")
    spawn serve_in(net.stream(ends.second), root)
    using client = connect(net.stream(ends.first)) or panic("connect")
    let c = client.handle
    for path in ["backslash_escape", "absolute_escape", "deep_escape", "directory_escape\\data.txt", "directory_escape/data.txt"] {
        expect_failure(t, "read of {path}", "NotFound", read_failure(c, path))
    }
    expect_failure(t, "write through an absolute link", "NotFound", write_failure(c, "absolute_escape"))
    let secret = file.read_text("{parent}/secret.txt") or panic("secret read")
    testing.error_if(t, secret != "outside", "a link let a write reach outside: {secret}")
    expect_failure(t, "listing through an escaping link", "NotFound", list_failure(c, "directory_escape"))
    let link = read_link(c, "backslash_escape") or panic("read_link")
    testing.error_if(t, link != "../secret.txt", "read_link text {link}")
    file.remove_all(parent) or panic("remove")
}
