import std/crypto
import std/crypto/x509
import std/file
import std/net
import std/ssh
import std/ssh/key
import std/ssh/sftp
import std/text

fn server_config(root: str) -> ssh.ServerConfig {
    let host = key.signer(x509.PrivateKey.Ed25519(crypto.random(32))) or panic("host key")
    let auth = ssh.ServerAuth {
        methods: ["password"]
        password: fn(user, password) { password == "correct horse" }
    }
    ssh.ServerConfig { host_keys: [host], auth, channels: sftp.handler(root) }
}

fn main() {
    let root = file.temp_dir("sftp-upload") or panic("temp dir")
    using listener = net.listen("127.0.0.1", 0) or panic("listen")
    spawn ssh.serve_on(listener.handle, server_config(root))
    let config = ssh.ClientConfig {
        user: "alice"
        verify_host_key: ssh.accept_any_host_key()
        auth: [ssh.AuthMethod.Password("correct horse")]
    }
    using conn = ssh.dial("127.0.0.1", listener.handle.addr.port, config) or panic("dial")
    using client = sftp.open(conn) or panic("sftp")
    let c = client.handle
    sftp.mkdir(c, "reports", 0o755) or panic("mkdir")
    sftp.write_file(c, "reports/q1.txt", bytes("revenue up"), 0o644) or panic("upload")
    sftp.write_file(c, "reports/q2.txt", bytes("revenue flat"), 0o644) or panic("upload")
    for entry in sftp.list(c, "reports") or panic("list") {
        let size = entry.attrs.size ?? 0
        print("{entry.name}: {size} bytes")
    }
    let back = sftp.read_file(c, "reports/q2.txt") or panic("download")
    print("q2: {text.trim(str(back))}")
    let on_disk = file.read_text("{root}/reports/q1.txt") or panic("disk")
    print("q1 on the server's disk: {on_disk}")
    let escape = sftp.read_file(c, "../../etc/passwd") catch {
        e => bytes("")
    }
    print("outside the root: {escape.len} bytes")
    file.remove_all(root) or panic("remove")
}
