import std/io
import std/ssh/wire

const fxp_init: u8 = 1
const fxp_version: u8 = 2
const fxp_open: u8 = 3
const fxp_close: u8 = 4
const fxp_read: u8 = 5
const fxp_write: u8 = 6
const fxp_lstat: u8 = 7
const fxp_fstat: u8 = 8
const fxp_setstat: u8 = 9
const fxp_fsetstat: u8 = 10
const fxp_opendir: u8 = 11
const fxp_readdir: u8 = 12
const fxp_remove: u8 = 13
const fxp_mkdir: u8 = 14
const fxp_rmdir: u8 = 15
const fxp_realpath: u8 = 16
const fxp_stat: u8 = 17
const fxp_rename: u8 = 18
const fxp_readlink: u8 = 19
const fxp_symlink: u8 = 20
const fxp_status: u8 = 101
const fxp_handle: u8 = 102
const fxp_data: u8 = 103
const fxp_name: u8 = 104
const fxp_attrs: u8 = 105
const fxp_extended: u8 = 200
const fxp_extended_reply: u8 = 201

const status_ok = 0
const status_eof = 1
const status_no_such_file = 2
const status_permission_denied = 3
const status_failure = 4
const status_bad_message = 5
const status_no_connection = 6
const status_connection_lost = 7
const status_op_unsupported = 8

const attr_size = 1
const attr_uidgid = 2
const attr_permissions = 4
const attr_acmodtime = 8
const attr_extended = 0x80000000

const open_read = 1
const open_write = 2
const open_append = 4
const open_create = 8
const open_truncate = 16
const open_exclusive = 32

const protocol_version = 3
const max_packet = 262144
const default_read_length = 32768
const default_write_length = 32768
const type_mask = 0o170000
const type_dir = 0o040000
const type_regular = 0o100000
const type_symlink = 0o120000

/// The failures of the SFTP client and server.
pub enum Error {
    /// The channel or stream failed.
    Io(cause: io.Error)
    /// The server answered that the file does not exist.
    NotFound
    /// The server answered that the operation is not permitted.
    PermissionDenied
    /// The server answered with a general failure and this message.
    Failure(message: str)
    /// The peer did not understand a message.
    BadMessage
    /// The server does not support the operation or extension.
    Unsupported
    /// The connection to the server was lost.
    Closed
    /// The peer sent a message that is not valid in the protocol.
    Protocol
    /// An argument is not valid for the operation.
    Invalid
}

/// The attributes of a file. A field that is `none` was not sent or is not to be changed.
pub struct Attrs {
    /// The size in bytes.
    pub size: i64? = none
    /// The numeric owner.
    pub uid: i64? = none
    /// The numeric group.
    pub gid: i64? = none
    /// The permission bits together with the file type bits, as `st_mode` holds them.
    pub permissions: i64? = none
    /// The access time in seconds since the Unix epoch.
    pub accessed: i64? = none
    /// The modification time in seconds since the Unix epoch.
    pub modified: i64? = none
}

/// An entry of a directory listing.
pub struct Entry {
    /// The file name without a directory.
    pub name: str
    /// The `ls -l` style line the server made for the entry.
    pub long_name: str
    /// The entry's attributes.
    pub attrs: Attrs
}

/// How `open_file` opens a file.
pub struct OpenFlags {
    /// Allows reads.
    pub read: bool = false
    /// Allows writes.
    pub write: bool = false
    /// Makes every write go to the end of the file.
    pub append: bool = false
    /// Creates the file when it does not exist.
    pub create: bool = false
    /// Truncates an existing file to zero length.
    pub truncate: bool = false
    /// Fails when the file exists and `create` is set.
    pub exclusive: bool = false
}

/// Returns whether `a` describes a directory.
pub fn is_dir(a: Attrs) -> bool {
    (a.permissions ?? 0) & type_mask == type_dir
}

/// Returns whether `a` describes a regular file.
pub fn is_regular(a: Attrs) -> bool {
    (a.permissions ?? 0) & type_mask == type_regular
}

/// Returns whether `a` describes a symbolic link.
pub fn is_symlink(a: Attrs) -> bool {
    (a.permissions ?? 0) & type_mask == type_symlink
}

fn flag_bits(f: OpenFlags) -> i64 {
    var bits = 0
    if f.read {
        bits |= open_read
    }
    if f.write {
        bits |= open_write
    }
    if f.append {
        bits |= open_append
    }
    if f.create {
        bits |= open_create
    }
    if f.truncate {
        bits |= open_truncate
    }
    if f.exclusive {
        bits |= open_exclusive
    }
    bits
}

fn flags_of(bits: i64) -> OpenFlags {
    OpenFlags {
        read: bits & open_read != 0
        write: bits & open_write != 0
        append: bits & open_append != 0
        create: bits & open_create != 0
        truncate: bits & open_truncate != 0
        exclusive: bits & open_exclusive != 0
    }
}

fn malformed(e: io.Error) -> Error {
    BadMessage
}

fn put_attrs(mut out: []u8, a: Attrs) {
    var flags = 0
    if a.size != none {
        flags |= attr_size
    }
    if a.uid != none && a.gid != none {
        flags |= attr_uidgid
    }
    if a.permissions != none {
        flags |= attr_permissions
    }
    if a.accessed != none && a.modified != none {
        flags |= attr_acmodtime
    }
    wire.put_u32(mut out, flags)
    if flags & attr_size != 0 {
        wire.put_u64(mut out, u64(a.size ?? 0))
    }
    if flags & attr_uidgid != 0 {
        wire.put_u32(mut out, a.uid ?? 0)
        wire.put_u32(mut out, a.gid ?? 0)
    }
    if flags & attr_permissions != 0 {
        wire.put_u32(mut out, a.permissions ?? 0)
    }
    if flags & attr_acmodtime != 0 {
        wire.put_u32(mut out, a.accessed ?? 0)
        wire.put_u32(mut out, a.modified ?? 0)
    }
}

fn read_attrs(r: *wire.Reader) -> Attrs ! Error {
    let flags = wire.read_u32(r) catch malformed
    var a = Attrs {}
    if flags & attr_size != 0 {
        let size = wire.read_u64(r) catch malformed
        a.size = i64(size)
    }
    if flags & attr_uidgid != 0 {
        a.uid = wire.read_u32(r) catch malformed
        a.gid = wire.read_u32(r) catch malformed
    }
    if flags & attr_permissions != 0 {
        a.permissions = wire.read_u32(r) catch malformed
    }
    if flags & attr_acmodtime != 0 {
        a.accessed = wire.read_u32(r) catch malformed
        a.modified = wire.read_u32(r) catch malformed
    }
    if flags & attr_extended != 0 {
        let count = wire.read_u32(r) catch malformed
        if count > 1024 {
            fail BadMessage
        }
        for i in 0..count {
            wire.read_string(r) catch malformed
            wire.read_string(r) catch malformed
        }
    }
    a
}

fn status_error(code: i64, message: str) -> Error {
    match code {
        status_no_such_file => NotFound
        status_permission_denied => PermissionDenied
        status_bad_message => BadMessage
        status_no_connection => Closed
        status_connection_lost => Closed
        status_op_unsupported => Unsupported
        _ => Failure(message)
    }
}

fn read_packet(r: *io.Reader) -> []u8 ! Error {
    let header = io.read_exact(r, 4) catch Io
    let size = io.be32(header, 0)
    if size < 1 || size > max_packet {
        fail Protocol
    }
    io.read_exact(r, size) catch Io
}

fn frame(payload: []u8) -> []u8 {
    var out: []u8 = []
    wire.put_u32(mut out, payload.len)
    io.append(mut out, payload)
    out
}
