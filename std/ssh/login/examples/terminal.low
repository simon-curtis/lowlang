import std/crypto
import std/crypto/x509
import std/file
import std/io
import std/net
import std/ssh
import std/ssh/key
import std/ssh/login
import std/sys
import std/text

fn account(home: str) -> login.Account {
    login.Account { name: "guest", uid: sys.euid(), gid: sys.egid(), home, shell: "/bin/sh" }
}

fn server_config(home: str) -> ssh.ServerConfig {
    let host = key.signer(x509.PrivateKey.Ed25519(crypto.random(32))) or panic("host key")
    let auth = ssh.ServerAuth { methods: ["password"], password: fn(user, password) { user == "guest" && password == "guest" } }
    let sessions = login.Config { account: fn(name) { account(home) } }
    ssh.ServerConfig { host_keys: [host], auth, channels: login.handler(sessions) }
}

fn read_all(h: *ssh.ChannelHandle) -> str {
    var out = ""
    let buf = io.buffer(4096)
    for {
        let n = ssh.read_on(h, buf) or 0
        if n == 0 {
            return text.replace(out, "\r", "")
        }
        out = out + str(buf[..n])
    }
}

fn main() {
    let home = file.temp_dir("guest") or panic("home")
    defer file.remove_all(home) or {}
    using listener = net.listen("127.0.0.1", 0) or panic("listen")
    spawn ssh.serve_on(listener.handle, server_config(home))
    let client = ssh.ClientConfig { user: "guest", verify_host_key: ssh.accept_any_host_key(), auth: [ssh.AuthMethod.Password("guest")] }
    using conn = ssh.dial("127.0.0.1", listener.handle.addr.port, client) or panic("dial")

    let piped = ssh.exec(conn, "echo $USER; [ -t 0 ] || echo no terminal; exit 7") or panic("exec")
    print("piped: {text.join(text.lines(str(piped.stdout)), ", ")}; status {piped.status.code}")

    using ch = ssh.open_session(conn) or panic("session")
    ssh.pty_on(ch.handle, ssh.Pty { term: "xterm", columns: 100, rows: 30 }) or panic("pty")
    ssh.exec_on(ch.handle, "stty size; [ -t 0 ] && echo on a terminal; echo $TERM") or panic("exec")
    print("pty: {text.join(text.lines(read_all(ch.handle)), ", ")}; status {ssh.wait_exit_on(ch.handle).code}")
}
