import std/io
import std/ssh/key

/// The failures of SSH connections, authentication, channels and requests.
pub enum Error {
    /// The underlying stream or a local resource failed.
    Io(cause: io.Error)
    /// A key or key file could not be used.
    Key(cause: key.Error)
    /// The peer sent a message that is not well formed.
    Malformed
    /// The peer sent a message that is not allowed in the current state.
    Protocol
    /// The peer's identification string is not SSH 2.0.
    BadVersion
    /// The two sides share no algorithm of the named kind: `kex`, `host key`, `cipher` or `mac`.
    NoCommonAlgorithm(kind: str)
    /// The key exchange failed: an invalid public value or a shared secret that is not acceptable.
    KeyExchange
    /// The host key callback refused the server's key.
    HostKeyRejected
    /// The server's signature over the exchange hash does not verify.
    BadSignature
    /// A packet failed authentication.
    MacFailed
    /// A packet is larger than the packet size limit.
    TooLarge
    /// A message arrived that strict key exchange forbids, or the first packet was not a key exchange init.
    StrictKex
    /// The peer ended the connection with a disconnect message.
    Disconnected(code: i64, reason: str)
    /// Every authentication method failed or none remained.
    AuthFailed
    /// The connection or channel is closed.
    Closed
    /// The peer refused to open the channel, with the reason code and text.
    ChannelRefused(code: i64, reason: str)
    /// The peer answered a request with failure.
    RequestRefused
    /// An argument is not valid for the operation.
    Invalid
    /// The operation is not supported.
    Unsupported
    /// The operation did not finish in time.
    TimedOut
    /// The transport failed while a client was connecting, in `phase`. `cause` is `TimedOut` when `ClientConfig.handshake_timeout` passed, `Eof` when the peer closed the stream, or the error of the stream.
    Handshake(phase: Phase, cause: io.Error)
}

/// The stage of connecting that a `Handshake` failure interrupted.
///
/// The other failures of a connecting client name their stage by their own variant: `BadVersion` for the version exchange, `NoCommonAlgorithm`, `KeyExchange`, `BadSignature` and `StrictKex` for the key exchange, `HostKeyRejected` for the host key check and `AuthFailed` for authentication.
pub enum Phase {
    /// Opening the TCP connection in `dial`.
    Connect
    /// Exchanging the identification strings.
    VersionExchange
    /// Negotiating algorithms, exchanging keys and verifying the host key.
    KeyExchange
    /// Authenticating the user.
    Authentication
}

/// The disconnect reason codes of RFC 4253 section 11.1.
pub const disconnect_protocol_error = 2

/// The disconnect reason code for a failed key exchange.
pub const disconnect_key_exchange_failed = 3

/// The disconnect reason code for a message authentication failure.
pub const disconnect_mac_error = 5

/// The disconnect reason code for an unsupported service.
pub const disconnect_service_not_available = 7

/// The disconnect reason code for authentication that is exhausted.
pub const disconnect_no_more_auth_methods = 14

/// The disconnect reason code for a user's own ending of the connection.
pub const disconnect_by_application = 11
