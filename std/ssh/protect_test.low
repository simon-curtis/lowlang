import std/file
import std/io
import std/process
import std/testing
import std/text

struct Vector {
    cipher: str
    mac: str
    key: []u8
    iv: []u8
    mac_key: []u8
    seq: i64
    packet: []u8
    payload: []u8
}

fn unhex(s: str) -> []u8 {
    text.decode_hex(s) or panic("hex {s}")
}

fn packet_vectors() -> []Vector {
    let content = file.read_text("{vectors}/packets.txt") or panic("read packets.txt")
    var out: []Vector = []
    for row in text.lines(content) {
        if row.len == 0 {
            continue
        }
        let f = text.split(row, '|')
        let seq = text.parse_int(f[5]) or panic("seq")
        push(mut out, Vector { cipher: f[0], mac: f[1], key: unhex(f[2]), iv: unhex(f[3]), mac_key: unhex(f[4]), seq, packet: unhex(f[6]), payload: unhex(f[7]) })
    }
    out
}

fn protection_for(v: Vector) -> *Protection {
    let spec = cipher_spec(v.cipher) ?? panic("cipher {v.cipher}")
    protection(spec, mac_spec(v.mac), v.key, v.iv, v.mac_key) or panic("protection")
}

fn test_python_cryptography_packets_open(t: *testing.T) {
    var current = plain()
    var last = ""
    for v in packet_vectors() {
        let id = "{v.cipher} {v.mac} {text.encode_hex(v.key)}"
        if id != last || v.cipher == "chacha20-poly1305@openssh.com" {
            current = protection_for(v)
            last = id
        }
        let opened = open(current, v.seq, io.bytes_reader(v.packet)) catch {
            e => {
                testing.error_if(t, true, "{v.cipher} {v.mac} seq {v.seq}: {error_name(e)}")
                continue
            }
        }
        testing.error_if(t, text.encode_hex(opened) != text.encode_hex(v.payload), "{v.cipher} {v.mac} seq {v.seq}: payload differs")
    }
}

fn test_python_cryptography_opens_our_packets(t: *testing.T) {
    if process.find("python3") == none {
        testing.skip(t, "python3 is not installed")
    }
    let probe = process.run(process.command("python3", ["-I", "-c", "import cryptography"]), []) or panic("python3")
    if !process.success(probe.status) {
        testing.skip(t, "the python cryptography package is not installed")
    }
    let payload = text.decode_hex("5e00112233445566778899aabbccddeeff") or panic("hex")
    let cases = [
        ["chacha20-poly1305@openssh.com", "-", "7"]
        ["aes128-gcm@openssh.com", "-", "0"]
        ["aes256-gcm@openssh.com", "-", "0"]
        ["aes128-ctr", "hmac-sha2-256-etm@openssh.com", "0"]
        ["aes256-ctr", "hmac-sha2-512-etm@openssh.com", "0"]
    ]
    for c in cases {
        testing.sub(t, "{c[0]} {c[1]}", fn(t) {
            let spec = cipher_spec(c[0]) ?? panic("cipher")
            let mac = mac_spec(c[1])
            let key = filled(spec.key_len, 11)
            let iv: []u8 = filled(spec.iv_len, 12)
            let mac_key: []u8 = filled(if c[1] == "-" { 0 } else { 64 }, 13)
            let iv_hex = text.encode_hex(iv)
            let p = protection(spec, mac, key, iv, mac_key) or panic("protection")
            let seq = text.parse_int(c[2]) or panic("seq")
            let packet = seal(p, seq, payload) or panic("seal")
            let out = process.run(process.command("python3", ["-I", "{vectors}/open_packet.py", c[0], c[1], text.encode_hex(key), iv_hex, text.encode_hex(mac_key), c[2], text.encode_hex(packet)]), []) or panic("python3")
            testing.error_if(t, !process.success(out.status), "python3 refused the packet: {str(out.stderr)}")
            testing.error_if(t, text.trim(str(out.stdout)) != text.encode_hex(payload), "python3 read {str(out.stdout)}")
        })
    }
}

fn filled(n: i64, seed: i64) -> []u8 {
    var out = io.buffer(n)
    for i in 0..n {
        out[i] = u8(seed + i * 5)
    }
    out
}
