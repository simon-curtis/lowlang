import std/io
import std/os
import std/testing

fn fails_with(wanted: Error, connect_with: fn() -> Agent ! Error) -> bool {
    using a = connect_with() catch {
        e => return e == wanted
    }
    false
}

fn test_connect_pageant_has_no_agent_on_linux(t: *testing.T) {
    testing.error_if(t, !fails_with(NoAgent, connect_pageant), "Pageant does not exist on Linux")
}

fn test_connect_any_without_ssh_auth_sock_has_no_agent(t: *testing.T) {
    os.unset_env("SSH_AUTH_SOCK") or panic("unset SSH_AUTH_SOCK")
    testing.error_if(t, !fails_with(NoAgent, connect_any), "an unset SSH_AUTH_SOCK leaves no agent to try")
}

fn test_connect_any_reports_a_missing_socket(t: *testing.T) {
    os.set_env("SSH_AUTH_SOCK", "/nonexistent/low-agent.sock") or panic("set SSH_AUTH_SOCK")
    testing.error_if(t, !fails_with(Io(io.Error.NotFound), connect_any), "a missing socket fails with NotFound")
}
