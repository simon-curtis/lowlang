import std/os
import std/testing

fn reached_default_pipe() -> bool {
    using a = connect_env() catch {
        NoAgent => return false
        e => return true
    }
    true
}

fn missing_pipe_is_not_found(path: str) -> bool {
    using a = connect(path) catch {
        Io(NotFound) => return true
        e => return false
    }
    false
}

fn test_connect_env_falls_back_to_the_openssh_pipe(t: *testing.T) {
    os.unset_env("SSH_AUTH_SOCK") or panic("unset SSH_AUTH_SOCK")
    testing.error_if(t, !reached_default_pipe(), "an unset SSH_AUTH_SOCK must try the default pipe")
}

fn test_missing_pipe_is_not_found(t: *testing.T) {
    testing.error_if(t, !missing_pipe_is_not_found("\\\\.\\pipe\\low-no-such-agent"), "a pipe that does not exist must fail with NotFound")
}
