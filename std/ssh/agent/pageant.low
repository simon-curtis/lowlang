import std/io

struct Relay {
    transact: fn(u8[]) -> u8[] ! io.Error
    request: u8[]
    reply: u8[]
    taken: i64
}

fn relay_write(r: *Relay, data: u8[]) -> i64 ! io.Error {
    io.append(mut r.request, data)
    if r.request.len < 4 {
        return data.len
    }
    let size = io.be32(r.request, 0)
    if size < 1 || size > max_message {
        fail Invalid
    }
    if r.request.len < 4 + size {
        return data.len
    }
    if r.request.len > 4 + size {
        fail Invalid
    }
    let frame = r.request
    r.request = []
    r.reply = r.transact(frame)?
    r.taken = 0
    data.len
}

fn relay_read(r: *Relay, buf: u8[]) -> i64 {
    let n = io.copy(buf, r.reply[r.taken..])
    r.taken += n
    n
}

fn pageant_stream(transact: fn(u8[]) -> u8[] ! io.Error) -> io.Stream {
    let r = new(Relay { transact, request: [], reply: [], taken: 0 })
    io.Stream {
        read: fn(buf) { relay_read(r, buf) }
        write: fn(data) { relay_write(r, data) }
        close: fn() {}
    }
}
