import std/io
import std/testing

struct Exchange {
    seen: u8[][]
}

fn answer_with_no_identities(seen: *Exchange) -> fn(u8[]) -> u8[] ! io.Error {
    fn(frame) {
        seen.seen.push(frame)
        [0, 0, 0, 5, msg_identities_answer, 0, 0, 0, 0]
    }
}

fn test_pageant_request_and_reply_are_framed_like_an_agent_stream(t: *testing.T) {
    let seen = new(Exchange { seen: [] })
    using a = agent_over(pageant_stream(answer_with_no_identities(seen)))
    let first = identities(a) or panic("identities")
    let second = identities(a) or panic("identities again")
    testing.error_if(t, first.len != 0 || second.len != 0, "the agent holds no keys")
    testing.error_if(t, seen.seen.len != 2, "each request is one exchange, got {seen.seen.len}")
    testing.equal_slice(t, seen.seen[0], [0, 0, 0, 1, msg_request_identities])
}

fn test_pageant_waits_for_the_whole_frame(t: *testing.T) {
    let seen = new(Exchange { seen: [] })
    let stream = pageant_stream(answer_with_no_identities(seen))
    stream.write([0, 0]) or panic("write")
    stream.write([0, 2, msg_sign_request]) or panic("write")
    testing.error_if(t, seen.seen.len != 0, "a frame that is not complete is not sent")
    stream.write([0]) or panic("write")
    testing.error_if(t, seen.seen.len != 1, "the last byte completes the frame")
    var reply = io.buffer(3)
    let n = stream.read(reply) or panic("read")
    testing.error_if(t, n != 3, "a read returns what the buffer holds, got {n}")
    let rest = io.buffer(16)
    let m = stream.read(rest) or panic("read the rest")
    testing.error_if(t, m != 6, "the reply is 4 bytes of length and 5 of body, got {m} after 3")
    let end = stream.read(rest) or panic("read at end")
    testing.error_if(t, end != 0, "a read after the reply is 0")
}

fn test_pageant_rejects_a_frame_that_cannot_be_an_agent_message(t: *testing.T) {
    let seen = new(Exchange { seen: [] })
    let stream = pageant_stream(answer_with_no_identities(seen))
    stream.write([255, 255, 255, 255]) catch {
        e => testing.expect_error(t, e, io.Error.Invalid, 0)
    }
}

fn test_pageant_rejects_bytes_after_the_frame(t: *testing.T) {
    let seen = new(Exchange { seen: [] })
    let stream = pageant_stream(answer_with_no_identities(seen))
    stream.write([0, 0, 0, 1, msg_request_identities, 0]) catch {
        e => testing.expect_error(t, e, io.Error.Invalid, 0)
    }
}
