import std/io
import std/net
import std/ssh/key

/// The settings of an SSH server.
pub struct ServerConfig {
    /// The host keys. A key of each type the server should offer is listed; the signature algorithms the server offers come from these.
    pub host_keys: key.Signer[]
    /// The authentication callbacks. By default the server accepts no one.
    pub auth: ServerAuth = ServerAuth {}
    /// Handles each channel the client opens, on its own green thread. It must call `accept` or `reject` on the channel; by default every channel is refused.
    pub channels: fn(Incoming) = reject_all
    /// Handles each global request, such as `tcpip-forward`, on the connection's reader. By default every request fails.
    pub global: fn(GlobalRequest) -> GlobalAnswer = deny_global
    /// The algorithms offered, by kind; an empty list takes the module's default.
    pub algorithms: Algorithms = Algorithms {}
    /// The bytes sent and received under one set of keys that trigger a new key exchange. The default is 1 GiB.
    pub rekey_bytes: i64 = 1073741824
    /// The seconds under one set of keys that trigger a new key exchange. The default is one hour.
    pub rekey_seconds: i64 = 3600
}

fn reject_all(inc: Incoming) {
    reject(inc, open_administratively_prohibited, "channel not permitted")
}

fn deny_global(request: GlobalRequest) -> GlobalAnswer {
    GlobalAnswer {}
}

fn server_setup(config: ServerConfig) -> Setup {
    Setup {
        client: false
        algorithms: config.algorithms
        signers: config.host_keys
        verify: fn(k) { true }
        rekey_bytes: config.rekey_bytes
        rekey_millis: config.rekey_seconds * 1000
    }
}

/// Runs the SSH handshake and authentication over `stream` as a server and returns the connection.
///
/// The connection's reader runs on its own green thread and hands each channel the client opens to `config.channels`. The stream is closed when this fails and when the connection ends. Fails with `NoCommonAlgorithm`, `StrictKex`, `AuthFailed` and the other errors of the handshake.
pub fn serve_stream(stream: io.Stream, config: ServerConfig) -> Connection ! Error {
    if config.host_keys.len == 0 {
        fail Invalid
    }
    let l = new_link(stream, server_setup(config))
    handshake(l) catch {
        e => {
            close_link(l)
            fail e
        }
    }
    let user = server_authenticate(l, config.auth) catch {
        e => {
            close_link(l)
            fail e
        }
    }
    let c = new_connection(l, false, user, config.channels, config.global)
    spawn run_reader(c)
    Connection { handle: c }
}

fn serve_one(h: net.ConnHandle, config: ServerConfig) {
    using tcp = net.adopt(h)
    using conn = serve_stream(net.stream_on(h), config) or return
    wait_on(conn.handle)
}

/// Accepts connections on `listener` and serves each on its own green thread with `serve_stream`, until the listener is closed.
///
/// A connection that fails its handshake or authentication is closed and does not stop the loop.
pub fn serve(listener: net.Listener, config: ServerConfig) {
    serve_on(listener.handle, config)
}

/// Accepts connections on the listener view `h` as `serve` does. A green thread can run it while the `Listener` that owns the socket stays with its creator, which closes it to stop the loop.
pub fn serve_on(h: net.ListenerHandle, config: ServerConfig) {
    for {
        let accepted = net.accept_handle(h) catch {
            e => {
                return
            }
        }
        spawn serve_one(accepted, config)
    }
}
