import std/xml

fn report(e: xml.Error) -> str {
    match e {
        Malformed(line, column, message) => "line {line}, column {column}: {message}"
        Limit(line, column, message) => "limit at line {line}, column {column}: {message}"
        Unsupported(message) => "unsupported: {message}"
    }
}

/// Reads a namespaced feed into a tree, lists its entries and serializes an edited entry.
fn main() {
    let source = "<?xml version=\"1.0\"?>\n<feed xmlns=\"http://www.w3.org/2005/Atom\" xmlns:dc=\"http://purl.org/dc/elements/1.1/\">\n  <title>Release notes</title>\n  <entry id=\"1\"><title>Faster builds</title><dc:creator>ada</dc:creator><summary>Builds take &lt; 1s &amp; use less memory.</summary></entry>\n  <entry id=\"2\"><title>New <![CDATA[<b>docs</b>]]></title><link rel=\"alternate\" href=\"https://example.com/2\"/></entry>\n</feed>\n"
    let feed = xml.parse(bytes(source)) catch {
        e => {
            print(report(e))
            return
        }
    }

    print("root {xml.qualified(feed.name)} in {feed.name.namespace}")
    let title = xml.child(feed, "title") ?? feed
    print("feed title {xml.text(title)}")
    for entry in xml.children(feed, "entry") {
        print("entry {xml.attribute(entry, "id") ?? "?"}: {xml.text(xml.child(entry, "title") ?? entry)}")
    }

    let creator = xml.find(feed, "entry/creator") ?? feed
    print("creator {xml.qualified(creator.name)} {xml.text(creator)}")
    let second = xml.children(feed, "entry")[1]
    let link = xml.find(second, "link") ?? second
    print("link {xml.attribute(link, "href") ?? "-"}")
    print("missing {xml.find(feed, "entry/author/name") == none}")

    let first = xml.children(feed, "entry")[0]
    print(xml.serialize(first, true))

    let broken = xml.parse(bytes("<a><b></a>")) catch {
        e => {
            print(report(e))
            return
        }
    }
    print(xml.qualified(broken.name))
}
