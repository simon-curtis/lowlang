import std/xml

/// Builds a sitemap with the streaming writer, which escapes text and attributes and indents element-only content.
fn main() {
    let urls = [["https://example.com/", "daily"], ["https://example.com/q?a=1&b=2", "weekly"]]

    let w = xml.writer(true)
    xml.write_declaration(w)
    xml.write_comment(w, " generated ")
    xml.start_element(w, "urlset")
    xml.write_namespace(w, "", "http://www.sitemaps.org/schemas/sitemap/0.9")
    for entry in urls {
        xml.start_element(w, "url")
        xml.write_attribute(w, "freq", entry[1])
        xml.start_element(w, "loc")
        xml.write_text(w, entry[0])
        xml.end_element(w)
        xml.end_element(w)
    }
    xml.start_element(w, "note")
    xml.write_text(w, "1 < 2 & 3 > 2")
    xml.write_cdata(w, "<raw>")
    xml.end_element(w)
    xml.start_element(w, "empty")
    xml.end_element(w)
    print(xml.finish(w))
}
