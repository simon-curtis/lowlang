import std/simd
import strings = std/text

fn doctype(r: *Reader) -> Token ! Error {
    r.pos += 9
    let start = r.pos
    require_space(r)?
    scan_name(r)?
    let spaced = skip_space(r)
    if spaced && (at_text(r, "SYSTEM") || at_text(r, "PUBLIC")) {
        external_id(r)?
        r.undeclared_allowed = true
        skip_space(r)
    }
    var end = r.pos
    if r.pos < r.data.len && r.data[r.pos] == '[' {
        r.pos += 1
        internal_subset(r)?
        end = r.pos
        skip_space(r)
    }
    expect(r, ">")?
    Doctype(strings.trim(__str_view(r.data[start..end])))
}

fn quoted(r: *Reader) -> str ! Error {
    if r.pos >= r.data.len || (r.data[r.pos] != '"' && r.data[r.pos] != '\'') {
        fail malformed(r, "expected a quoted literal")
    }
    let from = r.pos + 1
    let to = simd.find_byte(r.data, from, r.data.len, r.data[r.pos])
    if to < 0 {
        r.pos = r.data.len
        fail malformed(r, "unterminated literal")
    }
    check_chars(r, from, to)?
    r.pos = to + 1
    __str_view(r.data[from..to])
}

fn external_id(r: *Reader) ! Error {
    if at_text(r, "SYSTEM") {
        r.pos += 6
        require_space(r)?
        quoted(r)?
        return
    }
    expect(r, "PUBLIC")?
    require_space(r)?
    public_literal(r)?
    require_space(r)?
    quoted(r)?
}

fn public_literal(r: *Reader) ! Error {
    let at = r.pos
    let id = quoted(r)?
    for c in id {
        if !public_char(c) {
            r.pos = at
            fail malformed(r, "illegal character in public identifier")
        }
    }
}

fn public_char(c: u32) -> bool {
    (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || strings.index_byte(" \n-'()+,./:=?;!*#@$_%", u8(c)) >= 0 && c < 0x80
}

fn internal_subset(r: *Reader) ! Error {
    for {
        skip_space(r)
        if r.pos >= r.data.len {
            fail malformed(r, "unterminated internal subset")
        }
        let c = r.data[r.pos]
        if c == ']' {
            r.pos += 1
            return
        }
        if c == '%' {
            r.pos += 1
            scan_name(r)?
            expect(r, ";")?
            r.undeclared_allowed = true
            r.declarations_skipped = true
        } else if at_text(r, "<!ENTITY") {
            entity_declaration(r)?
        } else if at_text(r, "<!ATTLIST") {
            attribute_list(r)?
        } else if at_text(r, "<!ELEMENT") {
            element_declaration(r)?
        } else if at_text(r, "<!NOTATION") {
            notation_declaration(r)?
        } else if at_text(r, "<!--") {
            comment(r)?
        } else if at_text(r, "<?") {
            instruction(r)?
        } else {
            fail malformed(r, "unexpected content in the internal subset")
        }
    }
}

fn element_declaration(r: *Reader) ! Error {
    r.pos += 9
    require_space(r)?
    scan_name(r)?
    require_space(r)?
    if at_text(r, "EMPTY") {
        r.pos += 5
    } else if at_text(r, "ANY") {
        r.pos += 3
    } else {
        expect(r, "(")?
        skip_space(r)
        if at_text(r, "#PCDATA") {
            mixed(r)?
        } else {
            group(r, 1)?
        }
    }
    skip_space(r)
    expect(r, ">")?
}

fn mixed(r: *Reader) ! Error {
    r.pos += 7
    var names = false
    for {
        skip_space(r)
        if at_text(r, ")") {
            r.pos += 1
            break
        }
        expect(r, "|")?
        skip_space(r)
        scan_name(r)?
        names = true
    }
    if names {
        expect(r, "*")?
    } else if at_text(r, "*") {
        r.pos += 1
    }
}

fn group(r: *Reader, nesting: i64) ! Error {
    if nesting > 64 {
        fail limit(r, "content model nested deeper than 64")
    }
    particle(r, nesting)?
    var separator: u8 = 0
    for {
        skip_space(r)
        if r.pos >= r.data.len {
            fail malformed(r, "unterminated content model")
        }
        let c = r.data[r.pos]
        if c == ')' {
            r.pos += 1
            break
        }
        if (c != '|' && c != ',') || (separator != 0 && c != separator) {
            fail malformed(r, "expected '|', ',' or ')' in content model")
        }
        separator = c
        r.pos += 1
        skip_space(r)
        particle(r, nesting)?
    }
    occurrence(r)
}

fn particle(r: *Reader, nesting: i64) ! Error {
    if at_text(r, "(") {
        r.pos += 1
        skip_space(r)
        return group(r, nesting + 1)
    }
    scan_name(r)?
    occurrence(r)
}

fn occurrence(r: *Reader) {
    if r.pos < r.data.len && (r.data[r.pos] == '?' || r.data[r.pos] == '*' || r.data[r.pos] == '+') {
        r.pos += 1
    }
}

fn notation_declaration(r: *Reader) ! Error {
    r.pos += 10
    require_space(r)?
    scan_name(r)?
    require_space(r)?
    if at_text(r, "PUBLIC") {
        r.pos += 6
        require_space(r)?
        public_literal(r)?
        let spaced = skip_space(r)
        if spaced && r.pos < r.data.len && (r.data[r.pos] == '"' || r.data[r.pos] == '\'') {
            quoted(r)?
        }
    } else {
        expect(r, "SYSTEM")?
        require_space(r)?
        quoted(r)?
    }
    skip_space(r)
    expect(r, ">")?
}

fn entity_declaration(r: *Reader) ! Error {
    r.pos += 8
    require_space(r)?
    var parameter = false
    if r.pos < r.data.len && r.data[r.pos] == '%' {
        parameter = true
        r.pos += 1
        require_space(r)?
    }
    let at = r.pos
    let name = scan_name(r)?
    if strings.index_byte(name, ':') >= 0 {
        r.pos = at
        fail malformed(r, "colon in entity name")
    }
    require_space(r)?
    var e = Entity { value: [], external: false, unparsed: false, expanding: false }
    if r.pos < r.data.len && (r.data[r.pos] == '"' || r.data[r.pos] == '\'') {
        e.value = entity_value(r)?
    } else {
        external_id(r)?
        e.external = true
        let spaced = skip_space(r)
        if spaced && at_text(r, "NDATA") {
            if parameter {
                fail malformed(r, "parameter entity cannot be unparsed")
            }
            r.pos += 5
            require_space(r)?
            scan_name(r)?
            e.unparsed = true
        }
    }
    skip_space(r)
    expect(r, ">")?
    if !parameter && !r.declarations_skipped && predefined(name) == 0 && r.entities[name] == none {
        r.entities[name] = new(e)
    }
}

fn entity_value(r: *Reader) -> []u8 ! Error {
    let d = r.data
    let quote = d[r.pos]
    r.pos += 1
    var out = buffer(64)
    for {
        if r.pos >= d.len {
            fail malformed(r, "unterminated entity value")
        }
        let c = d[r.pos]
        if c == quote {
            r.pos += 1
            return contents(out)
        }
        if c == '%' {
            fail malformed(r, "parameter entity reference inside a declaration in the internal subset")
        }
        if c == '&' {
            let from = r.pos
            let ref = reference(r)?
            if ref.name == "" {
                put_code(mut out, ref.code)
            } else {
                put_bytes(mut out, d[from..r.pos])
            }
            continue
        }
        if c < 0x20 && c != '\t' && c != '\n' {
            fail malformed(r, "illegal character")
        }
        if c < 0x80 {
            put(mut out, c)
            r.pos += 1
        } else {
            let ch = decode_utf8(d, r.pos)
            if ch.size == 0 || !legal_char(ch.code) {
                fail malformed(r, "illegal character")
            }
            put_bytes(mut out, d[r.pos..r.pos + ch.size])
            r.pos += ch.size
        }
    }
}

fn attribute_list(r: *Reader) ! Error {
    r.pos += 9
    require_space(r)?
    let element = scan_name(r)?
    var declared: []Declared = r.declared[element] ?? []
    for {
        let spaced = skip_space(r)
        if r.pos < r.data.len && r.data[r.pos] == '>' {
            r.pos += 1
            break
        }
        if !spaced {
            fail malformed(r, "expected whitespace in attribute list declaration")
        }
        let name = scan_name(r)?
        require_space(r)?
        var tokenized = true
        if r.pos < r.data.len && r.data[r.pos] == '(' {
            enumeration(r)?
        } else {
            let kind = scan_name(r)?
            if kind == "CDATA" {
                tokenized = false
            } else if kind == "NOTATION" {
                require_space(r)?
                enumeration(r)?
            } else if kind != "ID" && kind != "IDREF" && kind != "IDREFS" && kind != "ENTITY" && kind != "ENTITIES" && kind != "NMTOKEN" && kind != "NMTOKENS" {
                fail malformed(r, "unknown attribute type {kind}")
            }
        }
        require_space(r)?
        var value: str? = none
        if at_text(r, "#REQUIRED") {
            r.pos += 9
        } else if at_text(r, "#IMPLIED") {
            r.pos += 8
        } else {
            if at_text(r, "#FIXED") {
                r.pos += 6
                require_space(r)?
            }
            let raw = attribute_value(r)?
            value = if tokenized { collapse(raw) } else { raw }
        }
        var known = false
        for d in declared {
            if d.name == name {
                known = true
            }
        }
        if !known && !r.declarations_skipped {
            push(mut declared, Declared { name, value, tokenized })
        }
    }
    if declared.len > 0 {
        r.declared[element] = declared
    }
}

fn enumeration(r: *Reader) ! Error {
    r.pos += 1
    for {
        skip_space(r)
        if r.pos >= r.data.len {
            fail malformed(r, "unterminated enumeration")
        }
        let c = r.data[r.pos]
        if c < 0x80 && r.names[c] == 0 {
            fail malformed(r, "expected a name token")
        }
        for r.pos < r.data.len && (r.data[r.pos] >= 0x80 || r.names[r.data[r.pos]] != 0) {
            r.pos += 1
        }
        skip_space(r)
        if r.pos < r.data.len && r.data[r.pos] == ')' {
            r.pos += 1
            return
        }
        expect(r, "|")?
    }
}

fn collapse(value: str) -> str {
    var out = buffer(value.len)
    var gap = false
    for i in 0..value.len {
        let c = value[i]
        if c == ' ' {
            gap = out.n > 0
            continue
        }
        if gap {
            put(mut out, ' ')
            gap = false
        }
        put(mut out, c)
    }
    if out.n == value.len {
        return value
    }
    __str_view(contents(out))
}
