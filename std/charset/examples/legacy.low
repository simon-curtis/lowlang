import std/charset
import std/text

fn read_text(data: []u8, fallback: str) -> str {
    var label = fallback
    var skip = 0
    match charset.detect_bom(data) {
        some(bom) => {
            label = bom.name
            skip = bom.len
        }
        none => {}
    }
    let decoded = charset.decode(label, data[skip..]) catch {
        UnknownEncoding => {
            return "unknown encoding {label}"
        }
        Malformed(at) => {
            return "{label}: malformed at byte {at}"
        }
        Unmappable(at, c) => {
            return "{label}: unmappable {c} at {at}"
        }
    }
    "{label}: {decoded}"
}

fn write_text(label: str, s: str) {
    let data = charset.encode(label, s) catch {
        Unmappable(at, c) => {
            print("{label}: code point {c} at byte {at} has no representation")
            return
        }
        e => {
            print("{label}: {e}")
            return
        }
    }
    print("{label}: {text.encode_hex(data)}")
}

/// Reads text in several legacy encodings by byte order mark or fallback label, then writes UTF-8 back to Latin-1 and Windows-1252.
fn main() {
    let quoted = text.decode_hex("93636166e9942c208035") or bytes("")
    print(read_text(quoted, "cp1252"))
    let city = text.decode_hex("6b6fb3") or bytes("")
    print(read_text(city, "latin1"))
    print(read_text(city, "iso-8859-2"))

    let cyrillic = text.decode_hex("f0d2c9d7c5d4") or bytes("")
    print(read_text(cyrillic, "koi8-r"))
    print(read_text(cyrillic, "windows-1251"))

    let utf16 = text.decode_hex("fffe48006900") or bytes("")
    print(read_text(utf16, "utf-8"))
    let utf8 = text.decode_hex("efbbbf48c3a9") or bytes("")
    print(read_text(utf8, "latin1"))
    let broken = text.decode_hex("48c3") or bytes("")
    print(read_text(broken, "utf8"))
    print(read_text(broken, "ebcdic"))

    let name = charset.canonical(" UTF8 ") ?? "none"
    let ascii = charset.canonical("us-ascii") ?? "none"
    let unknown = charset.canonical("klingon") ?? "none"
    print("{name} {ascii} {unknown}")

    let cafe = "café, 5€"
    write_text("iso-8859-1", cafe)
    write_text("windows-1252", cafe)
    let replaced = charset.encode_replace("iso-8859-1", cafe, "?") or bytes("")
    print("iso-8859-1 with replacement: {text.encode_hex(replaced)}")
    let windows = charset.windows_1252(0x80)
    print("windows-1252 0x80 is U+{text.hex(i64(windows))}")
}
