import std/cbor
import std/serde
import std/text

struct Reading {
    sensor: str
    celsius: f64
    samples: []i64
    raw: []u8
    note: str?
}

fn describe(e: serde.Error) -> str {
    match e {
        Syntax(at, message) => "syntax error at {at}: {message}"
        Mismatch(expected, at) => "expected {expected} at value {at}"
        Missing(field) => "missing field {field}"
        UnknownVariant(name) => "unknown variant {name}"
        Range(at) => "number out of range at value {at}"
        TooDeep => "nested too deeply"
        TooLarge => "too large"
    }
}

fn entry(key: str, value: cbor.Value) -> cbor.Entry {
    cbor.Entry { key: cbor.Value.Text(key), value }
}

fn attempt(label: str, entries: []cbor.Entry) {
    let data = cbor.encode(cbor.Value.Map(entries))
    let reading = cbor.deserialize[Reading](data) catch {
        e => {
            print("{label}: {describe(e)}")
            return
        }
    }
    print("{label}: {reading.sensor} {reading.celsius} {reading.samples} {reading.note ?? "no note"}")
}

/// Serialises a struct to CBOR and reads it back, then decodes maps with an extra field, a missing field, a wrong type and an out of range number.
fn main() {
    let reading = Reading { sensor: "boiler", celsius: 71.5, samples: [70, 71, -72], raw: [1, 2, 3], note: none }
    let data = cbor.serialize(reading)
    print("{data.len} bytes: {text.encode_hex(data)}")

    let tree = cbor.decode(data) or cbor.Value.Null
    print(cbor.diagnostic(tree))

    let back = cbor.deserialize[Reading](data) catch {
        e => {
            print(describe(e))
            return
        }
    }
    print("{back.sensor} {back.celsius} {back.samples} {text.encode_hex(back.raw)} {back.note ?? "no note"}")

    let samples = cbor.Value.Array([cbor.integer(1), cbor.integer(2)])
    let raw = cbor.Value.Bytes([9])
    attempt("extra field", [
        entry("sensor", cbor.Value.Text("pump")),
        entry("celsius", cbor.integer(40)),
        entry("samples", samples),
        entry("raw", raw),
        entry("unit", cbor.Value.Text("C")),
    ])
    attempt("missing samples", [
        entry("sensor", cbor.Value.Text("pump")),
        entry("celsius", cbor.integer(40)),
        entry("raw", raw),
    ])
    attempt("wrong type", [
        entry("sensor", cbor.integer(7)),
        entry("celsius", cbor.integer(40)),
        entry("samples", samples),
        entry("raw", raw),
    ])
    attempt("out of range", [
        entry("sensor", cbor.Value.Text("pump")),
        entry("celsius", cbor.integer(40)),
        entry("samples", cbor.Value.Array([cbor.Value.Unsigned(0xFFFFFFFFFFFFFFFF)])),
        entry("raw", raw),
    ])
}
