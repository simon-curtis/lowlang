import std/cbor
import std/text

fn entry(key: str, value: cbor.Value) -> cbor.Entry {
    cbor.Entry { key: cbor.Value.Text(key), value }
}

/// Encodes the same map in two entry orders to show deterministic output, then reads values, tags and a sequence back.
fn main() {
    let a = cbor.Value.Map([entry("a", cbor.integer(1)), entry("b", cbor.Value.Array([cbor.integer(2), cbor.integer(3)]))])
    let b = cbor.Value.Map([entry("b", cbor.Value.Array([cbor.integer(2), cbor.integer(3)])), entry("a", cbor.integer(1))])
    let encoded = cbor.encode(a)
    print(text.encode_hex(encoded))
    let reordered = cbor.encode(b)
    print(text.encode_hex(reordered))

    let decoded = cbor.decode(encoded) or cbor.Value.Null
    print(cbor.diagnostic(decoded))
    let key = cbor.Value.Text("b")
    let found = cbor.get(decoded, key) ?? cbor.Value.Null
    print(cbor.diagnostic(found))

    let epoch = 1363896240
    let seconds = new(cbor.integer(epoch))
    let stamp = cbor.Value.Tag(1, seconds)
    let numbers = cbor.Value.Array([cbor.integer(-500), cbor.Value.Float(1.5), cbor.Value.Float(1.1), cbor.Value.Float(100000.0), stamp])
    let packed = cbor.encode(numbers)
    print(text.encode_hex(packed))
    let numbers_back = cbor.decode(packed) or cbor.Value.Null
    print(cbor.diagnostic(numbers_back))

    let indefinite = text.decode_hex("5f42010243030405ff") or bytes("")
    let joined = cbor.decode(indefinite) or cbor.Value.Null
    print(cbor.diagnostic(joined))

    let sequence = text.decode_hex("010203") or bytes("")
    var rest = sequence
    for rest.len > 0 {
        let item = cbor.decode_first(rest, cbor.Options {}) or break
        print(cbor.diagnostic(item.value))
        rest = rest[item.length..]
    }

    let duplicate = text.decode_hex("a2616101616102") or bytes("")
    let failed = cbor.decode(duplicate) catch {
        e => {
            print("duplicate key: {e}")
            return
        }
    }
    print(cbor.diagnostic(failed))
}
