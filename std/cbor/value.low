import std/text

/// A CBOR data item (RFC 8949).
///
/// Decoding resolves indefinite-length strings, arrays and maps into their definite equivalents, and `encode` always writes definite lengths.
pub enum Value {
    /// An unsigned integer (major type 0), `0` to `2^64 - 1`.
    Unsigned(value: u64)
    /// A negative integer (major type 1). The integer is `-1 - value`, so `value` `0` is `-1` and the smallest integer is `-2^64`.
    Negative(value: u64)
    /// A byte string (major type 2).
    Bytes(data: []u8)
    /// A UTF-8 text string (major type 3). The decoder rejects invalid UTF-8.
    Text(value: str)
    /// An array (major type 4).
    Array(items: []Value)
    /// A map (major type 5), kept as entries in order. Keys can be any value; the decoder rejects a map with two keys that encode to the same bytes.
    Map(entries: []Entry)
    /// A tagged item (major type 6): the tag `number` and the item it applies to. Tags are kept as they are and given no meaning by `std/cbor`.
    Tag(number: u64, content: *Value)
    /// A simple value (major type 7) other than `false`, `true`, `null` and `undefined`. Valid numbers are `0` to `19` and `32` to `255`.
    Simple(value: u8)
    /// The simple values `false` and `true` (`0xF4`, `0xF5`).
    Bool(value: bool)
    /// The simple value `null` (`0xF6`).
    Null
    /// The simple value `undefined` (`0xF7`).
    Undefined
    /// A floating point number. The decoder turns half, single and double precision floats into an `f64`; `encode` writes the shortest of the three that holds the value exactly.
    Float(value: f64)
}

/// A key and value pair of a `Map`.
pub struct Entry {
    /// The key. It can be any `Value`.
    pub key: Value
    /// The value for the key.
    pub value: Value
}

/// Returns the integer `n` as an `Unsigned` or a `Negative` value.
pub fn integer(n: i64) -> Value {
    if n < 0 {
        return Negative(u64(-1 - n))
    }
    Unsigned(u64(n))
}

/// Returns the value of an `Unsigned` or `Negative` that fits an `i64`, and `none` for any other value, including integers outside that range.
pub fn as_integer(v: Value) -> i64? {
    match v {
        Unsigned(n) => if n > 0x7FFFFFFFFFFFFFFF { none } else { i64(n) }
        Negative(n) => if n > 0x7FFFFFFFFFFFFFFF { none } else { -1 - i64(n) }
        _ => none
    }
}

/// Returns the value of the first entry of the map `v` whose key equals `key`, or `none` when `v` is not a `Map` or has no such entry.
///
/// Keys are equal when their deterministic encodings are the same bytes, so an `Unsigned` and a `Float` with the same number are different keys.
pub fn get(v: Value, key: Value) -> Value? {
    let wanted = __str_view(encode(key))
    match v {
        Map(entries) => {
            for e in entries {
                if __str_view(encode(e.key)) == wanted {
                    return e.value
                }
            }
            none
        }
        _ => none
    }
}

/// Returns the diagnostic notation of `v` (RFC 8949, section 8) on one line, for logs and tests.
///
/// Maps print as `{key: value}`, arrays as `[...]`, a tag as `number(content)`, byte strings as `h'hex'`, simple values as `simple(n)` and the others as `true`, `false`, `null` and `undefined`. Text is quoted with `\"` and `\\` escaped and every character outside printable ASCII written as `\uXXXX`, using a surrogate pair above `U+FFFF`. Floats print as `NaN`, `Infinity`, `-Infinity` or a decimal that always contains a `.`. Integers print in decimal, including `Negative` down to `-18446744073709551616`.
pub fn diagnostic(v: Value) -> str {
    var out: []u8 = []
    describe(mut out, v)
    __str_view(out)
}

fn describe(mut out: []u8, v: Value) {
    match v {
        Unsigned(n) => text.append(mut out, "{n}")
        Negative(n) => text.append(mut out, negative_text(n))
        Bytes(data) => text.append(mut out, "h'{text.encode_hex(data)}'")
        Text(s) => text.append(mut out, text.quote_ascii(s))
        Array(items) => {
            push(mut out, '[')
            for i, item in items {
                if i > 0 {
                    text.append(mut out, ", ")
                }
                describe(mut out, item)
            }
            push(mut out, ']')
        }
        Map(entries) => {
            push(mut out, '{')
            for i, e in entries {
                if i > 0 {
                    text.append(mut out, ", ")
                }
                describe(mut out, e.key)
                text.append(mut out, ": ")
                describe(mut out, e.value)
            }
            push(mut out, '}')
        }
        Tag(number, content) => {
            text.append(mut out, "{number}(")
            describe(mut out, *content)
            push(mut out, ')')
        }
        Simple(n) => text.append(mut out, "simple({n})")
        Bool(b) => text.append(mut out, if b { "true" } else { "false" })
        Null => text.append(mut out, "null")
        Undefined => text.append(mut out, "undefined")
        Float(x) => text.append(mut out, text.float_diagnostic(x))
    }
}

fn negative_text(n: u64) -> str {
    if n == 0xFFFFFFFFFFFFFFFF {
        return "-18446744073709551616"
    }
    "-{n + 1}"
}
