import std/text

/// How an insert reports the key the database generated.
pub enum KeyReturn {
    /// The insert reports no key.
    Skipped
    /// A `RETURNING` clause after the values.
    Returning
    /// An `OUTPUT INSERTED` clause before the values.
    Output
    /// No clause: the key is read afterwards with `SELECT LAST_INSERT_ID()` on the same connection.
    LastInsertId
}

/// How a `SELECT` limits and skips rows.
pub enum Paging {
    /// `LIMIT n` and `OFFSET n`, each written only when it applies.
    Limit
    /// `LIMIT n OFFSET n`, written together, so an unlimited page is `LIMIT -1`.
    LimitOffset
    /// `OFFSET n ROWS` and `FETCH NEXT n ROWS ONLY`, which need an `ORDER BY`.
    OffsetFetch
    /// `LIMIT n OFFSET n`, written together, so an unlimited page is `LIMIT 18446744073709551615`.
    LimitUnbounded
}

/// How an insert that meets an existing key updates the row instead.
pub enum Upsert {
    /// `ON CONFLICT (keys) DO UPDATE SET column = EXCLUDED.column`.
    OnConflict
    /// `ON DUPLICATE KEY UPDATE column = VALUES(column)`.
    OnDuplicateKey
    /// The dialect has no clause that `upsert_clause` writes.
    Absent
}

/// What a lock statement takes as its resource.
pub enum LockKey {
    /// The dialect has no session lock.
    Absent
    /// A 64-bit integer.
    Number
    /// A text name.
    Name
}

/// How `CREATE TABLE` is made to do nothing when the table exists.
pub enum TableGuard {
    /// `CREATE TABLE IF NOT EXISTS`.
    IfNotExists
    /// An `IF OBJECT_ID(...) IS NULL` test before `CREATE TABLE`.
    ObjectId
}

/// The column types a dialect uses for the shapes of data `std/orm` and `std/sql/migrate` store.
pub struct ColumnTypes {
    /// A boolean.
    pub boolean: str
    /// An integer of at most 16 bits.
    pub small: str
    /// An integer of at most 32 bits.
    pub medium: str
    /// A 64-bit integer.
    pub large: str
    /// A 64-bit unsigned integer.
    pub unsigned_large: str
    /// A 32-bit float.
    pub single: str
    /// A 64-bit float.
    pub double: str
    /// A text string of any length.
    pub text: str
    /// A text string short enough to be a key.
    pub short_text: str
    /// A binary string.
    pub binary: str
    /// A value drawn from a fixed set of names.
    pub enumeration: str
    /// A structured value stored as JSON.
    pub document: str
    /// A 64-bit integer key the database generates, without the `PRIMARY KEY` clause.
    pub identity: str
}

/// The statements that take and release a session lock.
pub struct Lock {
    /// What the statements take as their resource.
    pub key: LockKey
    /// The statement that waits for the lock, with the resource as its first parameter and, when it reports a status, a negative first column for a lock that was not granted. Empty when `key` is `Absent`.
    pub acquire: str
    /// The statement that releases the lock, with the resource as its first parameter. Empty when `key` is `Absent`.
    pub release: str
}

/// Everything that differs between the databases the drivers speak to: placeholders, identifier quotes, column types, generated keys, paging, DDL, locks, the OpenTelemetry system name and the default port.
///
/// `postgres`, `sqlserver`, `sqlite`, `mysql` and `mariadb` build the five dialects. Every connection carries its own, and `std/orm` and `std/sql/migrate` read it.
pub struct Dialect {
    /// The `db.system.name` that OpenTelemetry reports for the database.
    pub system: str
    /// The port a driver connects to when `Options.port` is `0`; `0` for a database with no port.
    pub default_port: i64
    /// The text before the one-based parameter number in a placeholder, or the whole placeholder when `numbered_placeholders` is `false`.
    pub placeholder_prefix: str
    /// Whether a placeholder carries its parameter number. When `false` the parameters bind in the order the placeholders appear.
    pub numbered_placeholders: bool
    /// The character that opens a quoted identifier.
    pub open_quote: u8
    /// The character that closes a quoted identifier, doubled when it occurs in the name.
    pub close_quote: u8
    /// How an insert reports the generated key.
    pub key_return: KeyReturn
    /// How a `SELECT` is paged.
    pub paging: Paging
    /// The column types.
    pub types: ColumnTypes
    /// How an insert updates an existing row.
    pub upsert: Upsert
    /// How `CREATE TABLE` is made conditional.
    pub table_guard: TableGuard
    /// The session lock statements.
    pub lock: Lock
    /// The statement that starts a transaction holding the write lock, or empty when `begin` already does.
    pub begin_write: str
}

/// Returns the PostgreSQL dialect, with `$1` placeholders and `"name"` identifiers.
pub fn postgres() -> Dialect {
    let prefix = "$"
    Dialect {
        system: "postgresql"
        default_port: 5432
        placeholder_prefix: prefix
        numbered_placeholders: true
        open_quote: '"'
        close_quote: '"'
        key_return: Returning
        paging: Limit
        types: ColumnTypes {
            boolean: "boolean"
            small: "smallint"
            medium: "integer"
            large: "bigint"
            unsigned_large: "numeric(20, 0)"
            single: "real"
            double: "double precision"
            text: "text"
            short_text: "text"
            binary: "bytea"
            enumeration: "text"
            document: "jsonb"
            identity: "bigint GENERATED BY DEFAULT AS IDENTITY"
        }
        upsert: OnConflict
        table_guard: IfNotExists
        lock: Lock {
            key: Number
            acquire: "SELECT pg_advisory_lock({prefix}1)"
            release: "SELECT pg_advisory_unlock({prefix}1)"
        }
        begin_write: ""
    }
}

/// Returns the Microsoft SQL Server dialect, with `@p1` placeholders and `[name]` identifiers.
pub fn sqlserver() -> Dialect {
    let prefix = "@p"
    Dialect {
        system: "microsoft.sql_server"
        default_port: 1433
        placeholder_prefix: prefix
        numbered_placeholders: true
        open_quote: '['
        close_quote: ']'
        key_return: Output
        paging: OffsetFetch
        types: ColumnTypes {
            boolean: "bit"
            small: "smallint"
            medium: "integer"
            large: "bigint"
            unsigned_large: "numeric(20, 0)"
            single: "real"
            double: "float"
            text: "nvarchar(max)"
            short_text: "nvarchar(450)"
            binary: "varbinary(max)"
            enumeration: "nvarchar(200)"
            document: "nvarchar(max)"
            identity: "bigint IDENTITY(1, 1)"
        }
        upsert: Absent
        table_guard: ObjectId
        lock: Lock {
            key: Name
            acquire: "DECLARE @status INT; EXEC @status = sp_getapplock @Resource = {prefix}1, @LockMode = 'Exclusive', @LockOwner = 'Session', @LockTimeout = -1; SELECT @status"
            release: "EXEC sp_releaseapplock @Resource = {prefix}1, @LockOwner = 'Session'"
        }
        begin_write: ""
    }
}

/// Returns the SQLite dialect, with `?1` placeholders and `"name"` identifiers.
pub fn sqlite() -> Dialect {
    Dialect {
        system: "sqlite"
        default_port: 0
        placeholder_prefix: "?"
        numbered_placeholders: true
        open_quote: '"'
        close_quote: '"'
        key_return: Skipped
        paging: LimitOffset
        types: ColumnTypes {
            boolean: "INTEGER"
            small: "INTEGER"
            medium: "INTEGER"
            large: "INTEGER"
            unsigned_large: "TEXT"
            single: "REAL"
            double: "REAL"
            text: "TEXT"
            short_text: "TEXT"
            binary: "BLOB"
            enumeration: "TEXT"
            document: "TEXT"
            identity: "INTEGER"
        }
        upsert: OnConflict
        table_guard: IfNotExists
        lock: Lock { key: Absent, acquire: "", release: "" }
        begin_write: "BEGIN IMMEDIATE"
    }
}

fn mysql_types() -> ColumnTypes {
    ColumnTypes {
        boolean: "BOOLEAN"
        small: "SMALLINT"
        medium: "INT"
        large: "BIGINT"
        unsigned_large: "BIGINT UNSIGNED"
        single: "FLOAT"
        double: "DOUBLE"
        text: "LONGTEXT"
        short_text: "VARCHAR(255)"
        binary: "LONGBLOB"
        enumeration: "VARCHAR(200)"
        document: "JSON"
        identity: "BIGINT AUTO_INCREMENT"
    }
}

fn mysql_lock() -> Lock {
    Lock {
        key: Name
        acquire: "SELECT COALESCE(GET_LOCK(SHA1(?), 0), 0) - 1"
        release: "SELECT RELEASE_LOCK(SHA1(?))"
    }
}

/// Returns the MySQL dialect, with `?` placeholders and backtick-quoted identifiers.
pub fn mysql() -> Dialect {
    Dialect {
        system: "mysql"
        default_port: 3306
        placeholder_prefix: "?"
        numbered_placeholders: false
        open_quote: '`'
        close_quote: '`'
        key_return: LastInsertId
        paging: LimitUnbounded
        types: mysql_types()
        upsert: OnDuplicateKey
        table_guard: IfNotExists
        lock: mysql_lock()
        begin_write: ""
    }
}

/// Returns the MariaDB dialect, which is the MySQL dialect with `RETURNING` for generated keys.
pub fn mariadb() -> Dialect {
    Dialect {
        system: "mariadb"
        default_port: 3306
        placeholder_prefix: "?"
        numbered_placeholders: false
        open_quote: '`'
        close_quote: '`'
        key_return: Returning
        paging: LimitUnbounded
        types: mysql_types()
        upsert: OnDuplicateKey
        table_guard: IfNotExists
        lock: mysql_lock()
        begin_write: ""
    }
}

/// Returns the placeholder for the parameter at the zero-based `index`: `$1` for PostgreSQL, `@p1` for SQL Server and `?1` for SQLite when `index` is `0`, and `?` for MySQL and MariaDB whatever `index` is.
pub fn placeholder(d: Dialect, index: i64) -> str {
    if d.numbered_placeholders {
        return "{d.placeholder_prefix}{index + 1}"
    }
    d.placeholder_prefix
}

/// Returns the identifier quoted for the dialect, with each closing quote character in the name doubled.
pub fn quote_identifier(d: Dialect, name: str) -> str {
    var out: []u8 = []
    push(mut out, d.open_quote)
    for i in 0..name.len {
        if name[i] == d.close_quote {
            push(mut out, d.close_quote)
        }
        push(mut out, name[i])
    }
    push(mut out, d.close_quote)
    __str_view(out)
}

/// Returns the statement that creates the table `name` with `columns` unless it exists. `columns` is the text between the parentheses, and `name` is quoted for the dialect.
pub fn create_table_if_missing(d: Dialect, name: str, columns: str) -> str {
    let quoted = quote_identifier(d, name)
    match d.table_guard {
        IfNotExists => "CREATE TABLE IF NOT EXISTS {quoted} ({columns})"
        ObjectId => "IF OBJECT_ID(N'{name}', N'U') IS NULL CREATE TABLE {quoted} ({columns})"
    }
}

/// Returns the clause that makes an insert update the existing row, to append to the `INSERT` statement.
///
/// `keys` are the columns that identify the row and `updates` the columns to overwrite with the inserted values; each is quoted for the dialect. On PostgreSQL and SQLite the clause is ` ON CONFLICT ("id") DO UPDATE SET "name" = EXCLUDED."name"`, on MySQL and MariaDB ` ON DUPLICATE KEY UPDATE name = VALUES(name)` with the names quoted, where `keys` is not used. Returns an empty string when `d.upsert` is `Absent`.
pub fn upsert_clause(d: Dialect, keys: []str, updates: []str) -> str {
    var assignments: []str = []
    match d.upsert {
        OnConflict => {
            var targets: []str = []
            for k in keys {
                push(mut targets, quote_identifier(d, k))
            }
            for u in updates {
                let q = quote_identifier(d, u)
                push(mut assignments, "{q} = EXCLUDED.{q}")
            }
            " ON CONFLICT ({text.join(targets, ", ")}) DO UPDATE SET {text.join(assignments, ", ")}"
        }
        OnDuplicateKey => {
            for u in updates {
                let q = quote_identifier(d, u)
                push(mut assignments, "{q} = VALUES({q})")
            }
            " ON DUPLICATE KEY UPDATE {text.join(assignments, ", ")}"
        }
        Absent => ""
    }
}
