import std/io
import std/net
import std/sql
import std/sql/mysql
import std/text

const server_capabilities = 0x1BFA20F

fn frame(sequence: i64, body: []u8) -> []u8 {
    var b: []u8 = []
    io.put_le24(mut b, body.len)
    push(mut b, u8(sequence))
    io.append(mut b, body)
    b
}

fn greeting() -> []u8 {
    var b: []u8 = [10]
    text.append(mut b, "8.4.0-example")
    push(mut b, 0)
    io.put_le32(mut b, 7)
    for i in 0..8 {
        push(mut b, u8(i + 1))
    }
    push(mut b, 0)
    io.put_le16(mut b, server_capabilities & 0xFFFF)
    push(mut b, 45)
    io.put_le16(mut b, 2)
    io.put_le16(mut b, server_capabilities >> 16)
    push(mut b, 21)
    for _ in 0..10 {
        push(mut b, 0)
    }
    for i in 8..20 {
        push(mut b, u8(i + 1))
    }
    push(mut b, 0)
    text.append(mut b, "mysql_native_password")
    push(mut b, 0)
    b
}

fn ok(status: i64) -> []u8 {
    var b: []u8 = [0, 0, 0]
    io.put_le16(mut b, status)
    io.put_le16(mut b, 0)
    push(mut b, 0)
    b
}

fn lenenc_text(mut b: []u8, s: str) {
    push(mut b, u8(s.len))
    text.append(mut b, s)
}

fn column(name: str, kind: i64) -> []u8 {
    var b: []u8 = []
    for part in ["def", "shop", "users", "users", name, name] {
        lenenc_text(mut b, part)
    }
    push(mut b, 0x0c)
    io.put_le16(mut b, 45)
    io.put_le32(mut b, 255)
    push(mut b, u8(kind))
    io.put_le16(mut b, 0)
    push(mut b, 0)
    io.put_le16(mut b, 0)
    b
}

fn row(id: str, name: str) -> []u8 {
    var b: []u8 = []
    lenenc_text(mut b, id)
    lenenc_text(mut b, name)
    b
}

fn answer(w: io.Stream, sequence: i64, packets: [][]u8) ! io.Error {
    var at = sequence
    for p in packets {
        io.write_all(w, frame(at, p))?
        at += 1
    }
}

fn read_packet(r: *io.Reader) -> []u8 ! io.Error {
    let header = io.read_exact(r, 4)?
    io.read_exact(r, io.le24(header, 0))?
}

fn serve(h: net.ListenerHandle) {
    let accepted = net.accept_handle(h) or return
    using conn = net.adopt(accepted)
    let s = net.stream(conn)
    let r = io.reader(s)
    answer(s, 0, [greeting()]) or return
    read_packet(r) or return
    answer(s, 2, [ok(2)]) or return
    for {
        let command = read_packet(r) or return
        match command[0] {
            1 => return
            3 => {
                if text.starts_with(str(command[1..]), "SELECT") {
                    let names = [column("id", 8), column("name", 253)]
                    answer(s, 1, [[2], names[0], names[1], row("1", "Ada"), row("2", "Alan"), [0xFE, 0, 0, 2, 0, 0, 0]]) or return
                } else {
                    answer(s, 1, [ok(2)]) or return
                }
            }
            _ => answer(s, 1, [ok(2)]) or return
        }
    }
}

fn run() ! io.Error {
    using l = net.listen("127.0.0.1", 0)?
    spawn serve(l.handle)
    let st = mysql.state()
    let o = sql.Options { host: "127.0.0.1", port: l.handle.addr.port, user: "app", database: "shop", timeout: 5000 }
    using c = mysql.connect_with(o, mysql.Config { session: st }) catch {
        e => {
            print("connect failed: {e}")
            return
        }
    }
    print("server {st.server}, mariadb {st.mariadb}, thread {st.connection_id}, schema {st.schema}")
    print("dialect {c.handle.dialect.system}, placeholder {sql.placeholder(c.handle.dialect, 3)}")
    let rows = c.handle.query("SELECT id, name FROM users WHERE age >= 18", []) catch {
        e => {
            print("query failed: {e}")
            return
        }
    }
    for r in rows.rows {
        print("row {r[0]} {r[1]}")
    }
}

/// Connects to a server that runs in the same program, as a MySQL client would reach a real one, and reads the connection state and a result set. The server answers the login and one query from the wire format directly.
fn main() {
    run() catch {
        e => print("failed: {e}")
    }
}
