import std/crypto/ed25519
import std/crypto/hash
import std/crypto/rsa
import std/crypto/x509
import std/io
import std/sql

fn exclusive_or(a: u8[], b: u8[]) -> u8[] {
    let out: u8[] = __make(a.len)
    for i in 0..a.len {
        out[i] = a[i] ^ b[i]
    }
    out
}

fn native_scramble(password: str, nonce: u8[]) -> u8[] {
    if password.len == 0 {
        let empty: u8[] = []
        return empty
    }
    let a = hash.sha1()
    let first = hash.sum(a, bytes(password))
    let second = hash.sum(a, first)
    let d = a.digest()
    d.update(nonce[..20])
    d.update(second)
    exclusive_or(first, d.finish())
}

fn sha2_scramble(password: str, nonce: u8[]) -> u8[] {
    if password.len == 0 {
        let empty: u8[] = []
        return empty
    }
    let a = hash.sha256()
    let first = hash.sum(a, bytes(password))
    let second = hash.sum(a, first)
    let d = a.digest()
    d.update(second)
    d.update(nonce[..20])
    exclusive_or(first, d.finish())
}

fn ed25519_signature(password: str, nonce: u8[]) -> u8[] {
    ed25519.sign(bytes(password), nonce)
}

fn clear_password(password: str) -> u8[] {
    var out = bytes(password)
    out.push(0)
    out
}

fn masked_password(password: str, nonce: u8[]) -> u8[] {
    let plain = clear_password(password)
    let out: u8[] = __make(plain.len)
    for i in 0..plain.len {
        out[i] = plain[i] ^ nonce[i % nonce.len]
    }
    out
}

fn sealed_password(pem: u8[], password: str, nonce: u8[]) -> u8[] ! sql.Error {
    let blocks = x509.pem_blocks(__str_view(pem), "PUBLIC KEY")
    if blocks.len == 0 {
        fail Protocol
    }
    let key = rsa.parse_public_key_info(blocks[0]) or fail Unsupported
    let empty: u8[] = []
    rsa.encrypt_oaep(key, hash.sha1(), empty, masked_password(password, nonce)) or fail Unsupported
}

fn first_response(plugin: str, password: str, nonce: u8[], secure: bool) -> u8[] ! sql.Error {
    match plugin {
        "mysql_native_password" => native_scramble(password, nonce)
        "caching_sha2_password" => sha2_scramble(password, nonce)
        "client_ed25519" => ed25519_signature(password, nonce)
        "sha256_password" => {
            if secure {
                return clear_password(password)
            }
            if password.len == 0 {
                return [0]
            }
            [1]
        }
        "mysql_clear_password" => {
            if !secure {
                fail Unsupported
            }
            clear_password(password)
        }
        _ => fail Unsupported
    }
}
