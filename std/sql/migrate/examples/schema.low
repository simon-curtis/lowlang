import std/sql
import std/sql/migrate
import std/sql/sqlite

const create_users = "-- +up\nCREATE TABLE users (id INTEGER PRIMARY KEY, email TEXT NOT NULL);\n-- +down\nDROP TABLE users;\n"

const index_email = "-- +up\nCREATE UNIQUE INDEX users_email ON users (email);\nINSERT INTO users (email) VALUES ('root@example.com');\n-- +down\nDROP INDEX users_email;\n"

const add_age = "-- +up\nALTER TABLE users ADD COLUMN age INTEGER;\n-- +down\nALTER TABLE users DROP COLUMN age;\n"

fn state_name(s: migrate.State) -> str {
    match s {
        Applied => "applied"
        Pending => "pending"
        Drifted => "drifted"
        Unknown => "unknown"
    }
}

fn report(c: sql.Connection, p: migrate.Plan) ! migrate.Error {
    for e in migrate.status(c, p)? {
        print("  {e.version} {e.name}: {state_name(e.state)}")
    }
}

/// Applies migrations written as `-- +up` and `-- +down` text, reverts one, then edits an applied migration to trigger drift detection.
fn main() ! migrate.Error {
    using c = sqlite.connect(sql.Options { database: ":memory:" }) catch Sql
    let migrations = [
        migrate.from_text(1, "create_users", create_users)?
        migrate.from_text(2, "index_email", index_email)?
        migrate.from_text(3, "add_age", add_age)?
    ]
    let p = migrate.plan(migrations)

    print("applied {migrate.up_to(c, p, 2)?}")
    report(c, p)?

    print("applied {migrate.up(c, p)?}")
    print("applied again {migrate.up(c, p)?}")

    print("reverted {migrate.down(c, p, 1)?}")
    report(c, p)?

    let edited = migrate.plan([
        migrations[0]
        migrate.from_text(2, "index_email", "-- +up\nCREATE INDEX users_email ON users (email);")?
    ])
    migrate.up(c, edited) catch {
        Drift(version) => {
            print("version {version} changed after it was applied")
            []
        }
        e => fail e
    }
}
