import std/file
import std/slices
import std/text

struct Builder {
    section: i64
    seen_up: bool
    block: bool
    current: []str
    up: []str
    down: []str
}

fn finish(b: *Builder) {
    if b.current.len == 0 {
        return
    }
    let statement = text.join(b.current, "\n")
    b.current = []
    if b.section == 1 {
        push(mut b.up, statement)
    } else {
        push(mut b.down, statement)
    }
}

fn switch_to(b: *Builder, section: i64) ! Error {
    if b.block {
        fail Syntax(0)
    }
    finish(b)
    b.section = section
    if section == 1 {
        b.seen_up = true
    }
}

fn is_comment(line: str) -> bool {
    text.starts_with(line, "--")
}

fn consume(b: *Builder, number: i64, raw: str) ! Error {
    let line = text.trim(raw)
    if line == "-- +up" {
        switch_to(b, 1) or fail Syntax(number)
        return
    }
    if line == "-- +down" {
        switch_to(b, 2) or fail Syntax(number)
        return
    }
    if line == "-- +begin" {
        if b.section == 0 || b.block {
            fail Syntax(number)
        }
        finish(b)
        b.block = true
        return
    }
    if line == "-- +end" {
        if !b.block {
            fail Syntax(number)
        }
        b.block = false
        finish(b)
        return
    }
    if b.section == 0 {
        if line.len == 0 || is_comment(line) {
            return
        }
        fail Syntax(number)
    }
    if b.block {
        push(mut b.current, text.trim_end(raw))
        return
    }
    if line.len == 0 || (b.current.len == 0 && is_comment(line)) {
        return
    }
    push(mut b.current, text.trim_end(raw))
    if text.ends_with(line, ";") {
        finish(b)
    }
}

/// Parses migration text into a `Migration` with the given `version` and `name`.
///
/// The text has an `-- +up` section and an optional `-- +down` section. Statements end at a line that ends in `;`, and may span lines. A statement containing semicolons, such as a function body, goes between `-- +begin` and `-- +end` lines, which makes everything between them one statement. Blank lines and comments between statements are dropped, and a final statement without `;` is kept. Fails with `Syntax` at the offending line for text before `-- +up`, a missing `-- +up`, a misplaced `-- +begin` or `-- +end`, a section change inside a block, or a block left open.
pub fn from_text(version: i64, name: str, source: str) -> Migration ! Error {
    let b = new(Builder { section: 0, seen_up: false, block: false, current: [], up: [], down: [] })
    let lines = text.lines(source)
    for i, raw in lines {
        consume(b, i + 1, raw)?
    }
    if b.block {
        fail Syntax(lines.len)
    }
    finish(b)
    if !b.seen_up {
        fail Syntax(1)
    }
    Migration { version, name, up: b.up, down: b.down }
}

fn file_parts(name: str) -> Migration ! Error {
    let stem = text.strip_suffix(name, ".sql") ?? ""
    let at = text.index_byte(stem, '_')
    if stem.len == 0 || at < 1 || at == stem.len - 1 {
        fail BadName(name)
    }
    let version = text.parse_uint(stem[..at], 10) or fail BadName(name)
    Migration { version, name: stem[at + 1..], up: [], down: [] }
}

fn load_file(dir: str, name: str) -> Migration ! Error {
    let parts = file_parts(name)?
    let source = file.read_text("{dir}/{name}") catch Io
    from_text(parts.version, parts.name, source)?
}

/// Reads every `NNN_name.sql` file in `dir` as a migration and returns them in ascending version order.
///
/// `NNN` is the version and `name` the label, split at the first underscore. Files without the `.sql` suffix are ignored and subdirectories are not searched. Fails with `BadName` for a file that does not fit the pattern, `Duplicate` for a repeated version, `Syntax` for malformed text and `Io` when the directory or a file cannot be read.
pub fn load_dir(dir: str) -> []Migration ! Error {
    let names = file.list(dir) catch Io
    var found: []Migration = []
    var seen: [i64: bool] = [:]
    for name in names {
        if !text.ends_with(name, ".sql") {
            continue
        }
        let m = load_file(dir, name)?
        if seen[m.version] != none {
            fail Duplicate(m.version)
        }
        seen[m.version] = true
        push(mut found, m)
    }
    slices.sort_by_key(mut found, fn(m: Migration) -> i64 { m.version })
    found
}
