import std/testing

fn typmod(precision: i64, scale: i64) -> i64 {
    ((precision << 16) | (scale & 0x7FF)) + 4
}

fn test_numeric_modifier_gives_precision_and_scale(t: *testing.T) {
    let c = column_of("n", 1700, "numeric", typmod(10, 3))
    t.equal(c.precision, 10)
    t.equal(c.scale, 3)
    t.equal(c.length, 0)
    let whole = column_of("n", 1700, "numeric", typmod(38, 0))
    t.equal(whole.precision, 38)
    t.equal(whole.scale, 0)
}

fn test_numeric_scale_can_be_negative(t: *testing.T) {
    let c = column_of("n", 1700, "numeric", typmod(5, -2))
    t.equal(c.precision, 5)
    t.equal(c.scale, -2)
}

fn test_numeric_without_a_modifier_reports_nothing(t: *testing.T) {
    let c = column_of("n", 1700, "numeric", -1)
    t.equal(c.precision, 0)
    t.equal(c.scale, 0)
}

fn test_character_modifier_gives_the_length(t: *testing.T) {
    t.equal(column_of("v", 1043, "varchar", 14).length, 10)
    t.equal(column_of("v", 1042, "bpchar", 5).length, 1)
    t.equal(column_of("v", 1043, "varchar", -1).length, -1)
    t.equal(column_of("v", 1042, "bpchar", -1).length, -1)
    t.equal(column_of("v", 25, "text", -1).length, 0)
}

fn test_time_types_report_their_fractional_digits_as_scale(t: *testing.T) {
    t.equal(column_of("t", 1083, "time", 0).scale, 0)
    t.equal(column_of("t", 1083, "time", 3).scale, 3)
    t.equal(column_of("t", 1266, "timetz", 2).scale, 2)
    t.equal(column_of("t", 1114, "timestamp", 0).scale, 0)
    t.equal(column_of("t", 1114, "timestamp", 6).scale, 6)
    t.equal(column_of("t", 1184, "timestamptz", 4).scale, 4)
}

fn test_time_types_without_a_modifier_report_six_digits(t: *testing.T) {
    t.equal(column_of("t", 1114, "timestamp", -1).scale, 6)
    t.equal(column_of("t", 1184, "timestamptz", -1).scale, 6)
    t.equal(column_of("t", 1083, "time", -1).scale, 6)
}

fn test_interval_modifier_keeps_the_precision_in_the_low_bits(t: *testing.T) {
    t.equal(column_of("i", 1186, "interval", 3).scale, 3)
    t.equal(column_of("i", 1186, "interval", 0x0A0002).scale, 2)
    t.equal(column_of("i", 1186, "interval", 0x0AFFFF).scale, 6)
    t.equal(column_of("i", 1186, "interval", -1).scale, 6)
}

fn test_other_types_report_no_modifier_detail(t: *testing.T) {
    let c = column_of("i", 23, "int4", 7)
    t.equal(c.precision, 0)
    t.equal(c.scale, 0)
    t.equal(c.length, 0)
}
