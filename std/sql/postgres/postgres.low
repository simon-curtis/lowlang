import std/base64
import std/crypto
import std/crypto/md5
import std/io
import std/net
import std/sql
import std/sql/driver
import std/text
import std/tls

struct Conn {
    stream: io.Stream
    reader: *io.Reader
    status: u8
    iso_dates: bool
    server_text: bool
    process: i64
    secret: u8[]
    cancel: fn(i64, u8[])
    requested: bool
    types: [i64: TypeInfo]
    statements: [str: str]
    seen: [str: i64[]]
    parsing: str
    parsing_name: str
    counter: i64
    session: *driver.Session
}

const statement_capacity = 64
const seen_capacity = 256
const each_batch = 512

fn abandon(c: *Conn, timed_out: bool) -> sql.Error {
    if !c.session.closed {
        c.session.closed = true
        if timed_out {
            c.cancel(c.process, c.secret)
        }
        c.stream.close()
    }
    if timed_out { sql.Error.Timeout } else { sql.Error.Closed }
}

fn send(c: *Conn, data: u8[]) ! sql.Error {
    io.write_all(c.stream, data) catch {
        TimedOut => fail abandon(c, true)
        _ => fail abandon(c, false)
    }
}

fn read_byte(c: *Conn) -> u8 ! sql.Error {
    io.read_byte(c.reader) catch {
        TimedOut => fail abandon(c, true)
        _ => fail abandon(c, false)
    }
}

fn receive(c: *Conn) -> Message ! sql.Error {
    let kind = read_byte(c)?
    var length = 0
    for _ in 0..4 {
        length = length << 8 | i64(read_byte(c)?)
    }
    if length < 4 || length > max_message {
        abandon(c, false)
        fail Protocol
    }
    let body = io.read_exact(c.reader, length - 4) catch {
        TimedOut => fail abandon(c, true)
        _ => fail abandon(c, false)
    }
    Message { kind, body, at: 0 }
}

fn parameter_status(c: *Conn, mut m: Message) ! sql.Error {
    let name = cstring(mut m)?
    let value = cstring(mut m)?
    if name == "DateStyle" {
        c.iso_dates = text.starts_with(value, "ISO")
    }
    driver.setting(c.session, name, value)
}

fn ready(c: *Conn, mut m: Message) ! sql.Error {
    let status = byte_of(mut m)?
    if status != 'I' && status != 'T' && status != 'E' {
        fail Protocol
    }
    c.status = status
    c.parsing = ""
    c.requested = false
}

fn background(c: *Conn, mut m: Message) -> bool ! sql.Error {
    if m.kind == 'S' {
        parameter_status(c, mut m)?
        return true
    }
    if m.kind == 'N' {
        let d = diagnostic(mut m, sql.Level.Info)?
        driver.report(c.session, d)
        return true
    }
    if m.kind == 'A' {
        let process = int32(mut m)?
        let channel = cstring(mut m)?
        let payload = cstring(mut m)?
        c.session.notice(sql.Notice.Notification(channel, payload, process))
        return true
    }
    false
}

struct Exchange {
    batch: i64
    columns: sql.Column[]
    kinds: Kind[]
    parameters: str[]
    inferred: i64[]
    errors: sql.Diagnostic[]
    failure: sql.Error?
    stopped: bool
    synced: bool
    count: i64
}

fn columns_of(c: *Conn, mut m: Message, x: *Exchange) ! sql.Error {
    let n = int16(mut m)?
    let columns: sql.Column[] = __make(n)
    let kinds: Kind[] = __make(n)
    for i in 0..n {
        let name = cstring(mut m)?
        let table = i64(u32(int32(mut m)?))
        let number = signed16(mut m)?
        let oid = i64(u32(int32(mut m)?))
        take(mut m, 2)?
        let modifier = int32(mut m)?
        if int16(mut m)? != 0 {
            fail Protocol
        }
        let info = c.types[oid] ?? TypeInfo { name: "{oid}", kind: Textual }
        var column = column_of(name, oid, info.name, modifier)
        column.table = table
        column.number = number
        columns[i] = column
        kinds[i] = info.kind
    }
    x.columns = columns
    x.kinds = kinds
}

fn type_name(c: *Conn, oid: i64) -> str {
    match c.types[oid] {
        some(info) => info.name
        none => "{oid}"
    }
}

fn parameters_of(c: *Conn, mut m: Message, x: *Exchange) ! sql.Error {
    let n = int16(mut m)?
    let names: str[] = __make(n)
    let oids: i64[] = __make(n)
    for i in 0..n {
        let oid = i64(u32(int32(mut m)?))
        oids[i] = oid
        names[i] = type_name(c, oid)
    }
    x.parameters = names
    x.inferred = oids
}

fn row_of(c: *Conn, mut m: Message, x: *Exchange) -> sql.Value[] ! sql.Error {
    let n = int16(mut m)?
    if n != x.kinds.len {
        fail Protocol
    }
    let row: sql.Value[] = __make(n)
    for i in 0..n {
        let size = int32(mut m)?
        if size < 0 {
            row[i] = sql.Value.Null
            continue
        }
        let raw = __str_view(take(mut m, size)?)
        if c.server_text {
            row[i] = sql.Value.Text(raw)
            continue
        }
        let kind = x.kinds[i]
        if !c.iso_dates && (kind == Day || kind == Stamp || kind == StampZone) {
            fail Conversion
        }
        row[i] = decode(kind, raw)?
    }
    row
}

fn sync(c: *Conn, x: *Exchange) ! sql.Error {
    if x.synced {
        return
    }
    x.synced = true
    var b: u8[] = []
    put_empty(mut b, 'S')
    send(c, b)?
}

fn more(c: *Conn, x: *Exchange) ! sql.Error {
    var b: u8[] = []
    put_execute(mut b, x.batch)
    put_empty(mut b, 'H')
    send(c, b)?
}

fn on_row(c: *Conn, mut m: Message, x: *Exchange, sink: fn(sql.Event) -> bool) ! sql.Error {
    if x.stopped {
        return
    }
    let row = row_of(c, mut m, x) catch {
        Conversion => {
            x.failure = sql.Error.Conversion
            x.stopped = true
            return
        }
        _ => fail Protocol
    }
    if !sink(sql.Event.Row(row)) {
        x.stopped = true
    }
}

fn on_error(c: *Conn, mut m: Message, x: *Exchange) ! sql.Error {
    let d = diagnostic(mut m, sql.Level.Failure)?
    driver.report(c.session, d)
    x.errors.push(d)
    if d.level == sql.Level.Fatal {
        abandon(c, false)
        fail sql.Error.Server(x.errors)
    }
    if d.code == "26000" {
        c.statements = [:]
    }
    x.stopped = true
    sync(c, x)?
}

fn on_copy_in(c: *Conn) ! sql.Error {
    var b: u8[] = []
    put_copy_fail(mut b, "COPY FROM STDIN is not supported")
    send(c, b)?
}

fn on_columns(c: *Conn, mut m: Message, x: *Exchange, sink: fn(sql.Event) -> bool) ! sql.Error {
    columns_of(c, mut m, x)?
    if !x.stopped && !sink(sql.Event.Columns(x.columns)) {
        x.stopped = true
    }
}

fn on_complete(c: *Conn, mut m: Message, x: *Exchange, sink: fn(sql.Event) -> bool) ! sql.Error {
    let count = command_count(cstring(mut m)?)
    x.count += count ?? 0
    if !x.stopped && !sink(sql.Event.Done(count)) {
        x.stopped = true
    }
    sync(c, x)?
}

fn on_suspended(c: *Conn, x: *Exchange) ! sql.Error {
    if x.stopped {
        sync(c, x)?
    } else if c.session.cancelled {
        x.failure = sql.Error.Cancelled
        x.stopped = true
        sync(c, x)?
    } else {
        more(c, x)?
    }
}

fn interrupted(errors: sql.Diagnostic[]) -> bool {
    for d in errors {
        if d.code == "57014" {
            return true
        }
    }
    false
}

fn outcome(c: *Conn, x: *Exchange) -> i64 ! sql.Error {
    if x.errors.len > 0 {
        if c.session.cancelled && interrupted(x.errors) {
            fail Cancelled
        }
        fail sql.Error.Server(x.errors)
    }
    match x.failure {
        some(e) => fail e
        none => x.count
    }
}

fn new_exchange(batch: i64) -> *Exchange {
    new(Exchange { batch, columns: [], kinds: [], parameters: [], inferred: [], errors: [], failure: none, stopped: false, synced: batch == 0, count: 0 })
}

fn drive(c: *Conn, batch: i64, sink: fn(sql.Event) -> bool) -> i64 ! sql.Error {
    new_exchange(batch).run(c, sink)
}

fn run(x: *Exchange, c: *Conn, sink: fn(sql.Event) -> bool) -> i64 ! sql.Error {
    for {
        var m = receive(c)?
        let k = m.kind
        if k == 'Z' {
            ready(c, mut m)?
            return outcome(c, x)?
        } else if k == 'D' {
            on_row(c, mut m, x, sink)?
        } else if k == 'T' {
            on_columns(c, mut m, x, sink)?
        } else if k == 'C' {
            on_complete(c, mut m, x, sink)?
        } else if k == 'E' {
            on_error(c, mut m, x)?
        } else if k == 's' {
            on_suspended(c, x)?
        } else if k == 'I' {
            sync(c, x)?
        } else if k == '1' {
            if c.parsing.len > 0 {
                c.statements[c.parsing] = c.parsing_name
            }
        } else if k == 't' {
            parameters_of(c, mut m, x)?
        } else if k == 'G' || k == 'W' {
            on_copy_in(c)?
        } else if k == '2' || k == '3' || k == 'n' || k == 'H' || k == 'd' || k == 'c' {
            continue
        } else if !background(c, mut m)? {
            fail Protocol
        }
    }
}

fn checked(sql_text: str) ! sql.Error {
    if text.index_byte(sql_text, 0) >= 0 {
        fail Conversion
    }
}

fn dispatch(c: *Conn, data: u8[]) ! sql.Error {
    if c.session.cancelled {
        fail Cancelled
    }
    c.requested = true
    send(c, data)?
}

fn simple(c: *Conn, sql_text: str) ! sql.Error {
    checked(sql_text)?
    var b: u8[] = []
    put_query(mut b, sql_text)
    dispatch(c, b)?
}

fn statement_key(sql_text: str, oids: i64[]) -> str {
    var key: u8[] = []
    for oid in oids {
        text.append(mut key, "{oid},")
    }
    key.push(0)
    text.append(mut key, sql_text)
    __str_view(key)
}

struct Declared {
    oids: i64[]
    reparse: bool
}

fn typed(oids: i64[]) -> bool {
    for oid in oids {
        if oid != 0 {
            return true
        }
    }
    false
}

fn infer(c: *Conn, sql_text: str, oids: i64[]) -> Declared ! sql.Error {
    let open: i64[] = __make(oids.len)
    var b: u8[] = []
    put_parse(mut b, "", sql_text, open)
    put_describe_statement(mut b, "")
    put_empty(mut b, 'S')
    dispatch(c, b)?
    let x = new_exchange(0)
    x.run(c, driver.ignore_event)?
    let declared: i64[] = __make(oids.len)
    var reparse = false
    for i, oid in oids {
        if oid == 0 || i >= x.inferred.len {
            continue
        }
        let found = x.inferred[i]
        if found == text_oid || found == unknown_oid {
            declared[i] = oid
            reparse = true
        }
    }
    Declared { oids: declared, reparse }
}

fn parse_unnamed(c: *Conn, mut b: u8[], key: str, sql_text: str, oids: i64[]) -> str ! sql.Error {
    if c.seen.len >= seen_capacity {
        c.seen = [:]
    }
    var declared = Declared { oids, reparse: true }
    if typed(oids) {
        declared = infer(c, sql_text, oids)?
    }
    c.seen[key] = declared.oids
    if declared.reparse {
        put_parse(mut b, "", sql_text, declared.oids)
    }
    ""
}

fn prepare(c: *Conn, mut b: u8[], sql_text: str, oids: i64[]) -> str ! sql.Error {
    let key = statement_key(sql_text, oids)
    match c.statements[key] {
        some(name) => return name
        none => {}
    }
    let declared = match c.seen[key] {
        some(known) => known
        none => return parse_unnamed(c, mut b, key, sql_text, oids)?
    }
    if c.statements.len >= statement_capacity {
        for old, name in c.statements {
            put_close_statement(mut b, name)
            c.statements.delete(old)
            break
        }
    }
    c.counter += 1
    let name = "lowlang_{c.counter}"
    put_parse(mut b, name, sql_text, declared)
    c.parsing = key
    c.parsing_name = name
    name
}

fn extended(c: *Conn, sql_text: str, values: sql.Value[], batch: i64) ! sql.Error {
    checked(sql_text)?
    if values.len > 65535 {
        fail Conversion
    }
    let p = parameters(values)?
    var b: u8[] = []
    let name = prepare(c, mut b, sql_text, p.oids)?
    put_bind(mut b, name, p)
    put_describe_portal(mut b)
    put_execute(mut b, batch)
    put_empty(mut b, if batch == 0 { 'S' } else { 'H' })
    dispatch(c, b)?
}

fn start(c: *Conn, sql_text: str, values: sql.Value[]) ! sql.Error {
    if values.len == 0 {
        simple(c, sql_text)?
    } else {
        extended(c, sql_text, values, 0)?
    }
}

fn query(c: *Conn, sql_text: str, values: sql.Value[]) -> sql.Rows ! sql.Error {
    start(c, sql_text, values)?
    driver.collect(fn(sink) ! sql.Error { drive(c, 0, sink)? })
}

fn execute(c: *Conn, sql_text: str, values: sql.Value[]) -> i64 ! sql.Error {
    start(c, sql_text, values)?
    drive(c, 0, driver.ignore_event)
}

fn each(c: *Conn, sql_text: str, values: sql.Value[], visit: fn(sql.Column[], sql.Value[]) -> bool) ! sql.Error {
    extended(c, sql_text, values, each_batch)?
    drive(c, each_batch, driver.rows(visit))?
}

fn stream(c: *Conn, sql_text: str, values: sql.Value[], sink: fn(sql.Event) -> bool) ! sql.Error {
    start(c, sql_text, values)?
    drive(c, 0, sink)?
}

fn stream_prepared(c: *Conn, sql_text: str, values: sql.Value[], sink: fn(sql.Event) -> bool) ! sql.Error {
    extended(c, sql_text, values, 0)?
    drive(c, 0, sink)?
}

fn describe(c: *Conn, sql_text: str) -> sql.Description ! sql.Error {
    checked(sql_text)?
    var b: u8[] = []
    put_parse(mut b, "", sql_text, [])
    put_describe_statement(mut b, "")
    put_empty(mut b, 'S')
    dispatch(c, b)?
    let x = new_exchange(0)
    x.run(c, driver.ignore_event)?
    sql.Description { columns: x.columns, parameters: x.parameters }
}

fn commit(c: *Conn) ! sql.Error {
    if c.status == 'E' {
        execute(c, "ROLLBACK", [])?
        fail sql.server_error("25P02", "current transaction is aborted; rolled back instead of committed")
    }
    execute(c, "COMMIT", [])?
}

fn fatal(e: sql.Error) -> bool {
    match e {
        Protocol => true
        _ => false
    }
}

fn terminate(c: *Conn) {
    if c.session.closed {
        return
    }
    c.session.closed = true
    if !c.session.busy {
        var b: u8[] = []
        put_empty(mut b, 'X')
        io.write_all(c.stream, b) or {}
    }
    c.stream.close()
}

fn authenticate(c: *Conn, o: sql.Options) ! sql.Error {
    send(c, startup_message(o))?
    var exchange: *Scram? = none
    var verified = false
    for {
        var m = receive(c)?
        if m.kind == 'R' {
            let code = int32(mut m)?
            match code {
                0 => {
                    if exchange != none && !verified {
                        fail Authentication
                    }
                }
                3 => send(c, password_message(o.password))?
                5 => {
                    let salt = take(mut m, 4)?
                    send(c, password_message(md5_password(o.user, o.password, salt)))?
                }
                10 => {
                    var offered = false
                    for {
                        let mechanism = cstring(mut m)?
                        if mechanism.len == 0 {
                            break
                        }
                        offered = offered || mechanism == "SCRAM-SHA-256"
                    }
                    if !offered {
                        fail Unsupported
                    }
                    let s = scram(o.user, o.password, base64.encode(crypto.random(18)))
                    exchange = s
                    send(c, sasl_initial("SCRAM-SHA-256", scram_first(s)))?
                }
                11 => {
                    match exchange {
                        some(s) => {
                            let reply = scram_final(s, __str_view(rest(mut m)))?
                            send(c, sasl_response(reply))?
                        }
                        none => fail Protocol
                    }
                }
                12 => {
                    match exchange {
                        some(s) => scram_verify(s, __str_view(rest(mut m)))?
                        none => fail Protocol
                    }
                    verified = true
                }
                _ => fail Unsupported
            }
        } else if m.kind == 'E' {
            let d = diagnostic(mut m, sql.Level.Failure)?
            driver.report(c.session, d)
            fail sql.Error.Server([d])
        } else if m.kind == 'K' {
            c.process = int32(mut m)?
            c.secret = rest(mut m)
        } else if m.kind == 'Z' {
            ready(c, mut m)?
            return
        } else if m.kind != 'v' && !background(c, mut m)? {
            fail Protocol
        }
    }
}

fn interrupt(c: *Conn) {
    if c.requested {
        c.cancel(c.process, c.secret)
    }
}

fn open(s: io.Stream, o: sql.Options, cancel: fn(i64, u8[])) -> sql.Connection ! sql.Error {
    let c = new(Conn {
        stream: s
        reader: io.reader(s)
        status: 'I'
        iso_dates: true
        server_text: o.server_text
        process: 0
        secret: []
        cancel
        requested: false
        types: type_table()
        statements: [:]
        seen: [:]
        parsing: ""
        parsing_name: ""
        counter: 0
        session: driver.session()
    })
    let abandoned = fn() { abandon(c, false) }
    let closed = fn() { terminate(c) }
    driver.establish(c.session, fatal, abandoned, closed, fn() ! sql.Error { authenticate(c, o)? })?
    let raw = sql.ConnectionHandle {
        dialect: sql.postgres()
        query: fn(sql_text, values) -> sql.Rows ! sql.Error { query(c, sql_text, values) }
        each: fn(sql_text, values, visit) ! sql.Error { each(c, sql_text, values, visit)? }
        stream: fn(sql_text, values, sink) ! sql.Error { stream(c, sql_text, values, sink)? }
        execute: fn(sql_text, values) -> i64 ! sql.Error { execute(c, sql_text, values) }
        describe: fn(sql_text) -> sql.Description ! sql.Error { describe(c, sql_text) }
        stream_prepared: fn(sql_text, values, sink) ! sql.Error { stream_prepared(c, sql_text, values, sink)? }
        begin: fn() ! sql.Error { execute(c, "BEGIN", [])? }
        commit: fn() ! sql.Error { commit(c)? }
        rollback: fn() ! sql.Error { execute(c, "ROLLBACK", [])? }
        cancel: fn() { interrupt(c) }
        on_notice: driver.listener(c.session)
        close: closed
    }
    driver.connection(c.session, fatal, abandoned, "std/sql/postgres", o, raw)
}

fn dial(o: sql.Options) -> net.Conn ! sql.Error {
    using conn = driver.dial(o, sql.postgres())?
    net.set_read_timeout(conn, o.timeout)
    net.set_write_timeout(conn, o.timeout)
    conn
}

fn canceller(o: sql.Options) -> fn(i64, u8[]) {
    fn(process: i64, secret: u8[]) {
        using conn = driver.dial(o, sql.postgres()) or return
        net.write_all(conn, cancel_request(process, secret)) or {}
    }
}

/// Connects to a PostgreSQL server over plain TCP, using `o.host` and `o.port` (`5432` by default), and authenticates as `o.user` to `o.database`.
///
/// A `Null` or `Text` parameter is left to the server to type. Any other `sql.Value` is declared as the server infers it from the statement, so `Int(21)` binds into the `int4` of `twice($1)`; where the server infers only `text` or `unknown`, as in `SELECT $1`, it is declared as its own type (`Int` as `int8`, `Float` as `float8`). The first call of a statement with such a parameter pays one extra round trip to learn the types; later calls reuse them and the prepared statement cache. Values are sent as text, so the server parses them into the type it chose.
///
/// `cancel` and a call that times out send a cancel request to the server over a new connection; a timeout then closes the connection and `cancel` leaves it usable. A call stopped by `cancel` fails with `sql.Error.Cancelled`. Every notice, warning, error and notification the server sends reaches the function set with `on_notice`. Passwords are sent in cleartext, as an MD5 hash or through SCRAM-SHA-256, as the server requests. Returns `sql.Error.Connect` when the connection cannot be made, `sql.Error.Timeout` when it exceeds `o.timeout`, `sql.Error.Authentication` when the login fails, `sql.Error.Unsupported` for an authentication method the driver lacks and `sql.Error.Server` when the server rejects the startup. Dropping the returned `sql.Connection` closes the socket.
///
/// ```low
/// import std/sql
///
/// using c = postgres.connect(sql.Options { host: "db.internal", user: "app", database: "shop" }) or return
/// let rows = c.handle.query("SELECT name FROM users WHERE age >= $1", [Int(18)]) or return
/// print(rows.rows.len)
/// ```
pub fn connect(o: sql.Options) -> sql.Connection ! sql.Error {
    using var conn = dial(o)?
    let handle = net.detach(mut conn)
    open(net.stream_on(handle), o, canceller(o))
}

/// Connects over a stream that is already connected, such as a Unix socket or a tunnel, and authenticates as `connect` does.
///
/// `o.host`, `o.port` and `o.timeout` are not used to dial. The stream has no cancel channel to the server, so a timed out call closes the stream and `cancel` does not interrupt the server: a call fails with `sql.Error.Cancelled` only when `cancel` ran before the request was sent, between the batches of `each`, or when the server stops the statement with SQLSTATE `57014` after `cancel`. Fails like `connect` after the dial.
pub fn connect_stream(s: io.Stream, o: sql.Options) -> sql.Connection ! sql.Error {
    open(s, o, fn(process: i64, secret: u8[]) {})
}

/// Connects to a PostgreSQL server and upgrades the connection to TLS with the `SSLRequest` exchange before authenticating. `config` sets the TLS options; an empty `server_name` is replaced with `o.host`.
///
/// Returns `sql.Error.Unsupported` when the server answers that it does not do TLS and `sql.Error.Protocol` for any other answer. Timeouts and `cancel` act as in `connect`, with the cancel request sent over a new plain TCP connection. Otherwise fails like `connect`.
pub fn connect_tls(o: sql.Options, config: tls.Config) -> sql.Connection ! sql.Error {
    using var conn = dial(o)?
    let answer: u8[] = __make(1)
    let n = negotiate(conn, answer) catch {
        TimedOut => fail Timeout
        _ => fail Connect
    }
    if n != 1 || answer[0] != 'S' {
        if n == 1 && answer[0] == 'N' {
            fail Unsupported
        }
        fail Protocol
    }
    var named = config
    if named.server_name.len == 0 {
        named.server_name = o.host
    }
    let lower = net.stream(conn)
    let session = tls.client_handle(lower, named) catch {
        TimedOut => fail Timeout
        _ => fail Connect
    }
    net.detach(mut conn)
    open(tls.stream_on(session), o, canceller(o))
}

fn negotiate(conn: net.Conn, answer: u8[]) -> i64 ! io.Error {
    net.write_all(conn, ssl_request())?
    net.read(conn, answer)
}

fn md5_password(user: str, password: str, salt: u8[]) -> str {
    let inner = text.encode_hex(md5.sum(bytes("{password}{user}")))
    var salted = bytes(inner)
    io.append(mut salted, salt)
    "md5{text.encode_hex(md5.sum(salted))}"
}
