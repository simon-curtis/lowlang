import std/sql
import std/testing
import std/text

fn count_of(tag: str) -> i64 {
    command_count(tag) ?? -1
}

fn test_commands_with_a_count_report_it(t: *testing.T) {
    t.equal(count_of("SELECT 3"), 3)
    t.equal(count_of("INSERT 0 5"), 5)
    t.equal(count_of("UPDATE 12"), 12)
    t.equal(count_of("DELETE 1"), 1)
    t.equal(count_of("MERGE 4"), 4)
    t.equal(count_of("COPY 7"), 7)
    t.equal(count_of("FETCH 2"), 2)
    t.equal(count_of("MOVE 9"), 9)
}

fn test_a_command_that_matched_no_rows_reports_zero(t: *testing.T) {
    t.equal(count_of("UPDATE 0"), 0)
    t.equal(count_of("INSERT 0 0"), 0)
    t.equal(count_of("SELECT 0"), 0)
    t.equal(count_of("DELETE 0"), 0)
}

fn test_commands_without_a_count_report_none(t: *testing.T) {
    t.is_none(command_count("CREATE TABLE"))
    t.is_none(command_count("SET"))
    t.is_none(command_count("BEGIN"))
    t.is_none(command_count("COMMIT"))
    t.is_none(command_count("DROP TABLE"))
    t.is_none(command_count("ALTER TABLE"))
    t.is_none(command_count("CREATE INDEX"))
    t.is_none(command_count("TRUNCATE TABLE"))
    t.is_none(command_count("SHOW"))
    t.is_none(command_count(""))
}

fn test_a_number_in_another_command_is_not_a_count(t: *testing.T) {
    t.is_none(command_count("CREATE SEQUENCE 5"))
    t.is_none(command_count("SAVEPOINT 3"))
}

fn test_a_count_command_without_a_number_reports_none(t: *testing.T) {
    t.is_none(command_count("SELECT"))
    t.is_none(command_count("UPDATE x"))
}

fn startup_text(o: sql.Options) -> str {
    var out: u8[] = []
    for b in startup_message(o) {
        out.push(if b == 0 { ' ' } else { b })
    }
    str(out)
}

fn test_startup_sets_an_iso_date_style_by_default(t: *testing.T) {
    t.contains(startup_text(sql.Options { user: "u" }), "DateStyle ISO, YMD")
}

fn test_startup_leaves_the_date_style_to_the_server_for_server_text(t: *testing.T) {
    let shown = startup_text(sql.Options { user: "u", server_text: true })
    t.is_false(text.contains(shown, "DateStyle"))
    t.contains(shown, "client_encoding UTF8")
}
