import std/net
import std/otel
import std/sql

/// The state of one driver connection that every call checks: whether a call is running, whether it was cancelled, whether the connection is closed, and where its notices go.
pub struct Session {
    /// Whether a call is running on the connection.
    pub busy: bool
    /// Whether `cancel` was called during the running call. Cleared when the next call starts.
    pub cancelled: bool
    /// Whether the connection is closed.
    pub closed: bool
    /// The function that receives the connection's notices.
    pub notice: fn(sql.Notice)
}

/// Returns a session for a connection that is open and idle, whose notices are discarded.
pub fn session() -> *Session {
    new(Session { busy: false, cancelled: false, closed: false, notice: ignore_notice })
}

/// A notice function that discards the notice.
pub fn ignore_notice(n: sql.Notice) {}

/// Returns the `on_notice` function for a session, which replaces the function that receives its notices.
pub fn listener(s: *Session) -> fn(fn(sql.Notice)) {
    fn(receive: fn(sql.Notice)) {
        s.notice = receive
    }
}

/// Passes a diagnostic the server sent to the session's notice function.
pub fn report(s: *Session, d: sql.Diagnostic) {
    s.notice(sql.Notice.Message(d))
}

/// Passes a session setting the server reported as changed to the session's notice function.
pub fn setting(s: *Session, name: str, value: str) {
    s.notice(sql.Notice.Setting(name, value))
}

/// The number of microseconds in a day, the unit of `sql.Value.Time`, `Timestamp` and `TimestampTz`.
pub const micros_per_day = 86400000000

/// An event callback that ignores the event and continues.
pub fn ignore_event(e: sql.Event) -> bool {
    true
}

/// Returns an event callback that passes each row with its columns to `visit` and stops when `visit` returns `false`.
pub fn rows(visit: fn(sql.Column[], sql.Value[]) -> bool) -> fn(sql.Event) -> bool {
    var columns: sql.Column[] = []
    fn(e: sql.Event) -> bool {
        match e {
            Columns(described) => {
                columns = described
                true
            }
            Row(values) => visit(columns, values)
            Done(_) => true
        }
    }
}

/// Runs `run` with an event callback that buffers the result, and returns the last result set with the count of the statement that ended it.
///
/// A call that returns no result set gives no columns, no rows and a count of `0`.
pub fn collect(run: fn(fn(sql.Event) -> bool) ! sql.Error) -> sql.Rows ! sql.Error {
    var result = sql.Rows { columns: [], rows: [] }
    var open = false
    run(fn(e) -> bool {
        match e {
            Columns(described) => {
                result = sql.Rows { columns: described, rows: [] }
                open = true
            }
            Row(values) => result.rows.push(values)
            Done(count) => {
                if open {
                    result.count = count ?? 0
                    open = false
                }
            }
        }
        true
    })?
    result
}

fn port_of(o: sql.Options, d: sql.Dialect) -> i64 {
    if o.port == 0 { d.default_port } else { o.port }
}

/// Opens a TCP connection to `o.host` at the dialect's port within `o.timeout`.
///
/// Fails with `sql.Error.Timeout` when the dial times out and `sql.Error.Connect` otherwise.
pub fn dial(o: sql.Options, d: sql.Dialect) -> net.Conn ! sql.Error {
    net.dial_within(o.host, port_of(o, d), o.timeout) catch {
        TimedOut => fail Timeout
        _ => fail Connect
    }
}

fn guarded[T](s: *Session, fatal: fn(sql.Error) -> bool, abandon: fn(), work: fn() -> T ! sql.Error) -> T ! sql.Error {
    if s.closed {
        fail Closed
    }
    if s.busy {
        fail Busy
    }
    s.cancelled = false
    s.busy = true
    defer s.busy = false
    work() catch {
        e => {
            if fatal(e) {
                abandon()
            }
            fail e
        }
    }
}

fn guarded_unit(s: *Session, fatal: fn(sql.Error) -> bool, abandon: fn(), work: fn() ! sql.Error) ! sql.Error {
    guarded(s, fatal, abandon, fn() -> bool ! sql.Error {
        work()?
        true
    })?
}

/// Runs `work` as a call on the session, failing with `Busy` or `Closed` first and abandoning the connection when `fatal` accepts the error it returns.
///
/// A driver uses it for the operations that are not part of the `sql.ConnectionHandle`.
pub fn call(s: *Session, fatal: fn(sql.Error) -> bool, abandon: fn(), work: fn() ! sql.Error) ! sql.Error {
    guarded_unit(s, fatal, abandon, work)?
}

/// Runs the login exchange `handshake` as a call on the session and, when it fails, calls `terminate` before returning the error.
pub fn establish(s: *Session, fatal: fn(sql.Error) -> bool, abandon: fn(), terminate: fn(), handshake: fn() ! sql.Error) ! sql.Error {
    guarded_unit(s, fatal, abandon, handshake) catch {
        e => {
            terminate()
            fail e
        }
    }
}

fn cancel_running(s: *Session, interrupt: fn()) {
    if s.closed || !s.busy || s.cancelled {
        return
    }
    s.cancelled = true
    interrupt()
}

fn guard(s: *Session, fatal: fn(sql.Error) -> bool, abandon: fn(), raw: sql.ConnectionHandle) -> sql.ConnectionHandle {
    var guard_handle = raw
    guard_handle.query = fn(text, values) -> sql.Rows ! sql.Error {
        guarded(s, fatal, abandon, fn() -> sql.Rows ! sql.Error { raw.query(text, values) })
    }
    guard_handle.each = fn(text, values, visit) ! sql.Error {
        guarded_unit(s, fatal, abandon, fn() ! sql.Error { raw.each(text, values, visit)? })?
    }
    guard_handle.stream = fn(text, values, receive) ! sql.Error {
        guarded_unit(s, fatal, abandon, fn() ! sql.Error { raw.stream(text, values, receive)? })?
    }
    guard_handle.execute = fn(text, values) -> i64 ! sql.Error {
        guarded(s, fatal, abandon, fn() -> i64 ! sql.Error { raw.execute(text, values) })
    }
    guard_handle.describe = fn(text) -> sql.Description ! sql.Error {
        guarded(s, fatal, abandon, fn() -> sql.Description ! sql.Error { raw.describe(text) })
    }
    guard_handle.stream_prepared = fn(text, values, receive) ! sql.Error {
        guarded_unit(s, fatal, abandon, fn() ! sql.Error { raw.stream_prepared(text, values, receive)? })?
    }
    guard_handle.begin = fn() ! sql.Error {
        guarded_unit(s, fatal, abandon, fn() ! sql.Error { raw.begin()? })?
    }
    guard_handle.commit = fn() ! sql.Error {
        guarded_unit(s, fatal, abandon, fn() ! sql.Error { raw.commit()? })?
    }
    guard_handle.rollback = fn() ! sql.Error {
        guarded_unit(s, fatal, abandon, fn() ! sql.Error { raw.rollback()? })?
    }
    guard_handle.cancel = fn() {
        cancel_running(s, raw.cancel)
    }
    guard_handle
}

/// Returns `raw` with every `query`, `each`, `stream`, `execute` and `stream_prepared` recorded as an OpenTelemetry database call under `scope`, tagged with the database `o.database`, the server `o.host` and the server's port, `o.port` or the dialect's default when `o.port` is `0`.
///
/// Every driver applies it once to the handle it returns, so a connection from any driver is traced the same way.
pub fn traced(raw: sql.ConnectionHandle, scope: str, o: sql.Options) -> sql.ConnectionHandle {
    otel.instrument_sql(raw, scope, o.database, o.host, port_of(o, raw.dialect))
}

/// Returns the owning `sql.Connection` for a driver's `raw` handle: guarded by the session, traced under `scope` and closed when dropped.
///
/// The guarded `cancel` calls `raw.cancel` only while a call runs and only once per call, after setting `Session.cancelled`, so a driver's `cancel` acts on a running call.
pub fn connection(s: *Session, fatal: fn(sql.Error) -> bool, abandon: fn(), scope: str, o: sql.Options, raw: sql.ConnectionHandle) -> sql.Connection {
    let guarded_handle = guard(s, fatal, abandon, raw)
    let handle = traced(guarded_handle, scope, o)
    sql.adopt(handle)
}
