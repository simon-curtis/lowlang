import std/sql
import std/sql/sqlite

fn cell(v: sql.Value) -> str {
    match v {
        Int(n) => "{n}"
        Float(x) => "{x}"
        Text(s) => s
        _ => "?"
    }
}

fn show(rows: sql.Rows) {
    for row in rows.rows {
        var line = ""
        for i, v in row {
            line = "{line}{if i > 0 { " " } else { "" }}{rows.columns[i].name}={cell(v)}"
        }
        print(line)
    }
}

/// Records payments in an in-memory database, totals them per account and shows a rolled back batch.
fn main() ! sql.Error {
    using db = sqlite.open(":memory:")?
    sqlite.exec(db, "CREATE TABLE payments (id INTEGER PRIMARY KEY, account TEXT NOT NULL, cents INTEGER NOT NULL CHECK (cents > 0))")?

    let insert = "INSERT INTO payments (account, cents) VALUES (?, ?)"
    sqlite.begin_immediate(db)?
    sqlite.execute(db, insert, [Text("rent"), Int(120000)])?
    sqlite.execute(db, insert, [Text("food"), Int(8450)])?
    sqlite.execute(db, insert, [Text("food"), Int(1275)])?
    sqlite.commit(db)?
    print("last id {sqlite.last_insert_id(db)}")

    sqlite.begin(db)?
    sqlite.execute(db, insert, [Text("food"), Int(-5)]) catch {
        Server(code, message) => {
            print("rejected: {message}")
            0
        }
        e => fail e
    }
    sqlite.rollback(db)?

    show(sqlite.query(db, "SELECT account, count(*) AS payments, sum(cents) AS total FROM payments GROUP BY account ORDER BY account", [])?)

    sqlite.each(db, "SELECT id, cents FROM payments WHERE cents < ? ORDER BY id", [Int(10000)], fn(columns: []sql.Column, row: []sql.Value) -> bool {
        print("small payment {cell(row[0])}: {cell(row[1])}")
        true
    })?
}
