0490:1252 21514:1252"
}

fn sql_collation_code_pages() -> str {
    "30:437 31:437 32:437 33:437 34:437 35:437 40:850 41:850 42:850 43:850 44:850 45:850 49:850 50:1252 51:1252 52:1252 53:1252 54:1252 55:850 56:850 57:850 58:850 59:850 60:850 61:850 71:1252 72:1252 73:1252 74:1252 75:1252 80:1250 81:1250 82:1250 83:1250 84:1250 85:1250 86:1250 87:1250 88:1250 89:1250 90:1250 91:1250 92:1250 93:1250 94:1250 95:1250 96:1250 97:1250 98:1250 104:1251 105:1251 106:1251 107:1251 108:1251 112:1253 113:1253 114:1253 120:1253 121:1253 122:1253 124:1253 128:1254 129:1254 130:1254 136:1255 137:1255 138:1255 144:1256 145:1256 146:1256 152:1257 153:1257 154:1257 155:1257 156:1257 157:1257 158:1257 159:1257 160:1257 183:1252 184:1252 185:1252 186:1252 192:932 193:932 194:949 195:949 196:950 197:950 198:936 199:936 200:932 201:949 202:950 203:936 204:874 205:874 206:874 210:1252 211:1252 212:1252 213:1252 214:1252 215:1252 216:1252 217:1252 218:1252 219:1252"
}

fn code_page_label(code_page: str) -> str {
    match code_page {
        "0" => "ascii"
        "437" => "IBM437"
        "850" => "IBM850"
        "874" => "windows-874"
        "932" => "Shift_JIS"
        "936" => "GBK"
        "949" => "EUC-KR"
        "950" => "Big5"
        _ => "windows-{code_page}"
    }
}

fn charset_name(c: Charset) -> str {
    match c {
        Wide => "wide"
        Utf8 => "utf8"
        CodePage(label) => label
        Ascii => "ascii"
    }
}

fn collation_bytes(lcid: i64, flags: u8, sort: i64) -> u8[] {
    [u8(lcid & 0xFF), u8(lcid >> 8 & 0xFF), u8(lcid >> 16 & 0x0F) | 0x30, flags | 0x10, u8(sort)]
}

fn charset_name_of(lcid: i64, flags: u8, sort: i64) -> str {
    let collation = collation_bytes(lcid, flags, sort)
    let charset = charset_of(collation)
    charset_name(charset)
}

fn narrow_text(lcid: i64, sort: i64, raw: u8[]) -> str {
    var t = type_of(0xA7, Short, 10, "varchar")
    let collation = collation_bytes(lcid, 0, sort)
    t.charset = charset_of(collation)
    text_value(t, raw) catch {
        Conversion => "conversion"
        _ => "other"
    }
}

fn check_code_pages(t: *testing.T, table: str, sort_ids: bool) {
    for entry in text.split(table, ' ') {
        let fields = text.split(entry, ':')
        let key = text.parse_int(fields[0]) or -1
        let lcid = if sort_ids { 1033 } else { key }
        let sort = if sort_ids { key } else { 0 }
        let got = charset_name_of(lcid, 0, sort)
        let want = code_page_label(fields[1])
        if got != want {
            t.error("sort {sort} lcid {lcid}: got {got}, want {want}")
        }
    }
}

fn test_windows_collations_decode_in_the_code_page_of_their_lcid(t: *testing.T) {
    check_code_pages(t, windows_collation_code_pages(), false)
}

fn test_sql_collations_decode_in_the_code_page_of_their_sort_id(t: *testing.T) {
    check_code_pages(t, sql_collation_code_pages(), true)
}

fn test_sort_variant_bits_of_the_lcid_keep_the_language_code_page(t: *testing.T) {
    t.equal(charset_name_of(0x10411, 0, 0), "Shift_JIS")
    t.equal(charset_name_of(0x20804, 0, 0), "GBK")
    t.equal(charset_name_of(0x30404, 0, 0), "Big5")
}

fn test_utf8_flag_wins_over_the_code_page(t: *testing.T) {
    t.equal(charset_name_of(0x0411, 0x04, 0), "utf8")
}

fn test_ascii_text_reads_without_a_code_page(t: *testing.T) {
    t.equal(narrow_text(0x0439, 0, [0x61]), "a")
    t.equal(narrow_text(0x0439, 0, [0xE9]), "conversion")
}

fn test_narrow_text_decodes_in_the_collation_code_page(t: *testing.T) {
    t.equal(narrow_text(0x0408, 0, [0xC1, 0xE8]), "Αθ")
    t.equal(narrow_text(0x0411, 0, [0x93, 0xFA, 0x96, 0x7B]), "日本")
    t.equal(narrow_text(0x0804, 0, [0xD6, 0xD0, 0xCE, 0xC4]), "中文")
    t.equal(narrow_text(0x0404, 0, [0xA4, 0xA4, 0xA4, 0xE5]), "中文")
    t.equal(narrow_text(0x0412, 0, [0xC7, 0xD1, 0xB1, 0xB9]), "한국")
    t.equal(narrow_text(1033, 59, [0x86, 0x94]), "åö")
}

fn test_byte_a_code_page_leaves_unassigned_fails_conversion(t: *testing.T) {
    t.equal(narrow_text(0x0408, 0, [0xAA]), "conversion")
}
