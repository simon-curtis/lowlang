import std/io
import std/sql
import std/testing

fn us(mut b: u8[], s: str) {
    let units = utf16_bytes(s)
    io.put_le16(mut b, units.len / 2)
    io.append(mut b, units)
}

fn bv(mut b: u8[], s: str) {
    let units = utf16_bytes(s)
    b.push(u8(units.len / 2))
    io.append(mut b, units)
}

fn body(number: i64, state: i64, class: i64, message: str, server: str, procedure: str, line: i64) -> u8[] {
    var b: u8[] = []
    io.put_le32(mut b, number)
    b.push(u8(state))
    b.push(u8(class))
    us(mut b, message)
    bv(mut b, server)
    bv(mut b, procedure)
    io.put_le32(mut b, line)
    b
}

fn level_name(l: sql.Level) -> str {
    match l {
        Info => "Info"
        Warning => "Warning"
        Failure => "Failure"
        Fatal => "Fatal"
    }
}

fn test_diagnostic_carries_every_field_of_the_token(t: *testing.T) {
    let d = diagnostic(body(208, 1, 16, "Invalid object name 'x'.", "DB01", "load_x", 7)) catch {
        _ => sql.Diagnostic { level: sql.Level.Info, code: "", message: "" }
    }
    t.equal(d.code, "208")
    t.equal(d.state, 1)
    t.equal(d.class, 16)
    t.equal(d.message, "Invalid object name 'x'.")
    t.equal(d.server, "DB01")
    t.equal(d.procedure, "load_x")
    t.equal(d.line, 7)
    t.equal(level_name(d.level), "Failure")
}

fn test_diagnostic_numbers_are_signed(t: *testing.T) {
    let d = diagnostic(body(-5, 0, 0, "", "", "", -1)) catch {
        _ => sql.Diagnostic { level: sql.Level.Info, code: "", message: "" }
    }
    t.equal(d.code, "-5")
    t.equal(d.line, -1)
}

fn test_severity_class_sets_the_level(t: *testing.T) {
    t.equal(level_name(level_of(0)), "Info")
    t.equal(level_name(level_of(10)), "Info")
    t.equal(level_name(level_of(11)), "Failure")
    t.equal(level_name(level_of(19)), "Failure")
    t.equal(level_name(level_of(20)), "Fatal")
    t.equal(level_name(level_of(25)), "Fatal")
}

fn parses(data: u8[]) -> bool ! sql.Error {
    diagnostic(data)?
    true
}

fn rejected(data: u8[]) -> bool {
    let ok = parses(data) catch {
        _ => false
    }
    !ok
}

fn test_truncated_diagnostic_is_a_protocol_error(t: *testing.T) {
    let whole = body(1, 1, 16, "abc", "srv", "", 1)
    for n in 0..whole.len {
        if !rejected(whole[..n]) {
            t.error("a diagnostic cut to {n} of {whole.len} bytes was accepted")
        }
    }
}

fn test_integrated_login_sets_the_security_flag_and_carries_the_token(t: *testing.T) {
    let token: u8[] = [1, 2, 3, 4, 5]
    let login = login_message(sql.Options { user: "ignored", password: "ignored", database: "shop" }, "db", true, token)
    t.equal(login[25] & 0x80, 0x80)
    t.equal(io.le32(login, 0), login.len)
    let at = io.le16(login, 78)
    let size = io.le16(login, 80)
    t.equal(size, 5)
    t.equal_slice(login[at..at + size], token)
    t.equal(io.le16(login, 42), 0)
    t.equal(io.le16(login, 46), 0)
    t.equal(io.le32(login, 90), 0)
    let extension = io.le16(login, 56)
    t.equal(io.le32(login, extension), extension + 4)
    t.equal(extension, at + size)
}

fn test_password_login_has_no_security_flag_and_an_empty_sspi_field(t: *testing.T) {
    let login = login_message(sql.Options { user: "u", password: "p" }, "db", false, [])
    t.equal(login[25] & 0x80, 0)
    t.equal(io.le16(login, 80), 0)
    t.equal(io.le32(login, 90), 0)
    t.equal(io.le32(login, 0), login.len)
}
