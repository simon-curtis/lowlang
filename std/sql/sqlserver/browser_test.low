import std/sql
import std/testing

fn reply_of(data: str) -> u8[] {
    var out: u8[] = [0x05, u8(data.len & 0xFF), u8(data.len >> 8)]
    for i in 0..data.len {
        out.push(data[i])
    }
    out
}

fn port_text(reply: u8[], instance: str) -> str {
    let port = browser_port_of(reply, instance) catch {
        Connect => return "Connect"
        _ => return "other"
    }
    "{port}"
}

fn single() -> str {
    "ServerName;DB01;InstanceName;SQL2022;IsClustered;No;Version;16.0.1000.6;tcp;49721;;"
}

fn several() -> str {
    "ServerName;DB01;InstanceName;SQLEXPRESS;IsClustered;No;Version;16.0.1000.6;np;\\\\DB01\\pipe\\MSSQL$SQLEXPRESS\\sql\\query;;ServerName;DB01;InstanceName;SQL2022;IsClustered;No;Version;16.0.1000.6;tcp;49721;np;\\\\DB01\\pipe\\x;;ServerName;DB01;InstanceName;OTHER;IsClustered;No;Version;15.0.2000.5;tcp;50123;;"
}

fn test_request_names_the_instance_after_the_unicast_byte(t: *testing.T) {
    t.equal_slice(browser_request("SQL2022"), [0x04, 'S', 'Q', 'L', '2', '0', '2', '2', 0])
}

fn test_reply_gives_the_tcp_port_of_the_instance(t: *testing.T) {
    t.equal(port_text(reply_of(single()), "SQL2022"), "49721")
}

fn test_instance_names_match_without_regard_to_case(t: *testing.T) {
    t.equal(port_text(reply_of(single()), "sql2022"), "49721")
}

fn test_reply_with_several_instances_gives_the_port_of_the_named_one(t: *testing.T) {
    t.equal(port_text(reply_of(several()), "SQL2022"), "49721")
    t.equal(port_text(reply_of(several()), "other"), "50123")
}

fn test_instance_without_a_tcp_entry_fails(t: *testing.T) {
    t.equal(port_text(reply_of(several()), "SQLEXPRESS"), "Connect")
}

fn test_unknown_instance_fails(t: *testing.T) {
    t.equal(port_text(reply_of(single()), "NOPE"), "Connect")
}

fn test_reply_with_another_first_byte_fails(t: *testing.T) {
    var reply = reply_of(single())
    reply[0] = 0x04
    t.equal(port_text(reply, "SQL2022"), "Connect")
}

fn test_reply_shorter_than_its_size_fails(t: *testing.T) {
    let reply = reply_of(single())
    t.equal(port_text(reply[..reply.len - 4], "SQL2022"), "Connect")
    t.equal(port_text([0x05], "SQL2022"), "Connect")
    t.equal(port_text([], "SQL2022"), "Connect")
}

fn test_port_outside_the_tcp_range_fails(t: *testing.T) {
    t.equal(port_text(reply_of("InstanceName;A;tcp;0;;"), "A"), "Connect")
    t.equal(port_text(reply_of("InstanceName;A;tcp;65536;;"), "A"), "Connect")
    t.equal(port_text(reply_of("InstanceName;A;tcp;http;;"), "A"), "Connect")
    t.equal(port_text(reply_of("InstanceName;A;tcp;65535;;"), "A"), "65535")
}

fn test_host_splits_at_the_backslash(t: *testing.T) {
    let target = target_of("db.internal\\SQLEXPRESS")
    t.equal(target.host, "db.internal")
    t.equal(target.instance, "SQLEXPRESS")
}

fn test_host_without_an_instance_is_unchanged(t: *testing.T) {
    let target = target_of("db.internal")
    t.equal(target.host, "db.internal")
    t.equal(target.instance, "")
}

fn test_dot_and_local_name_localhost(t: *testing.T) {
    t.equal(target_of(".\\SQLEXPRESS").host, "localhost")
    t.equal(target_of("(LOCAL)\\X").host, "localhost")
    t.equal(target_of(".").host, "localhost")
}

fn test_named_replaces_only_the_host(t: *testing.T) {
    let o = named(sql.Options { host: "db.internal\\SQL2022", port: 4000, user: "u" })
    t.equal(o.host, "db.internal")
    t.equal(o.port, 4000)
    t.equal(o.user, "u")
}

fn test_located_keeps_a_given_port_without_asking_the_browser(t: *testing.T) {
    let o = located(sql.Options { host: "db.internal\\SQL2022", port: 4000 }) catch {
        _ => sql.Options {}
    }
    t.equal(o.host, "db.internal")
    t.equal(o.port, 4000)
}
