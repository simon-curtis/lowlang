fn code_page_in(ranges: CodePageRange[], key: i64) -> str {
    for r in ranges {
        if key >= r.first && key <= r.last {
            return r.label
        }
    }
    ""
}

fn locale_code_page(lcid: i64) -> str {
    let exact = code_page_in(locale_code_pages(), lcid)
    if exact != "" {
        return exact
    }
    code_page_in(language_code_pages(), lcid & 0x3FF)
}

fn charset_of(collation: u8[]) -> Charset {
    let info = io.le32(collation, 0)
    if info >> 26 & 1 == 1 {
        return Utf8
    }
    let sort = i64(collation[4])
    let label = if sort != 0 { code_page_in(sort_code_pages(), sort) } else { locale_code_page(info & 0xFFFF) }
    if label == "" { Ascii } else { CodePage(label) }
}
