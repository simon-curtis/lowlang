import std/io
import std/sql
import std/testing

fn little(v: i64, n: i64) -> u8[] {
    var out: u8[] = []
    for i in 0..n {
        out.push(u8(v >> (8 * i)))
    }
    out
}

fn joined(parts: u8[][]) -> u8[] {
    var out: u8[] = []
    for p in parts {
        io.append(mut out, p)
    }
    out
}

fn temporal(id: u8, scale: i64) -> Type {
    var t = type_of(id, Byte, 0, "")
    t.scale = scale
    t
}

fn shown(v: sql.Value) -> str {
    match v {
        Text(s) => s
        Timestamp(micros) => "Timestamp({micros})"
        TimestampTz(micros) => "TimestampTz({micros})"
        Time(micros) => "Time({micros})"
        _ => "other"
    }
}

fn converted(t: Type, raw: u8[], exact: bool) -> str {
    let v = convert(t, raw, exact) catch {
        _ => sql.Value.Null
    }
    shown(v)
}

fn datetime2_raw(units: i64, days: i64, scale: i64) -> u8[] {
    joined([little(units, clock_size(scale)), little(days, 3)])
}

fn offset_raw(units: i64, days: i64, minutes: i64, scale: i64) -> u8[] {
    joined([little(units, clock_size(scale)), little(days, 3), little(minutes, 2)])
}

fn test_datetime2_keeps_every_fractional_digit(t: *testing.T) {
    let raw = datetime2_raw(110451234567, 738886, 7)
    t.equal(converted(temporal(0x2A, 7), raw, true), "2024-01-02 03:04:05.1234567")
    t.equal(converted(temporal(0x2A, 7), raw, false), "Timestamp(1704164645123456)")
}

fn test_datetime2_pads_to_its_scale(t: *testing.T) {
    t.equal(converted(temporal(0x2A, 7), datetime2_raw(110451000000, 738886, 7), true), "2024-01-02 03:04:05.1000000")
    t.equal(converted(temporal(0x2A, 3), datetime2_raw(11045007, 738886, 3), true), "2024-01-02 03:04:05.007")
    t.equal(converted(temporal(0x2A, 0), datetime2_raw(11045, 738886, 0), true), "2024-01-02 03:04:05")
}

fn test_time_is_written_without_a_date(t: *testing.T) {
    t.equal(converted(temporal(0x29, 7), little(110451234567, 5), true), "03:04:05.1234567")
    t.equal(converted(temporal(0x29, 3), little(11045123, 4), true), "03:04:05.123")
    t.equal(converted(temporal(0x29, 0), little(86399, 3), true), "23:59:59")
    t.equal(converted(temporal(0x29, 7), little(110451234567, 5), false), "Time(11045123456)")
}

fn test_datetimeoffset_is_written_in_its_local_time(t: *testing.T) {
    let east = offset_raw(776451234567, 738885, 330, 7)
    t.equal(converted(temporal(0x2B, 7), east, true), "2024-01-02 03:04:05.1234567 +05:30")
    t.equal(converted(temporal(0x2B, 7), east, false), "TimestampTz(1704144845123456)")
}

fn test_datetimeoffset_with_a_negative_offset_crosses_midnight(t: *testing.T) {
    let west = offset_raw(10800, 738886, -480, 0)
    t.equal(converted(temporal(0x2B, 0), west, true), "2024-01-01 19:00:00 -08:00")
    let utc = offset_raw(10800, 738886, 0, 0)
    t.equal(converted(temporal(0x2B, 0), utc, true), "2024-01-02 03:00:00 +00:00")
    let late = offset_raw(86399, 738886, 59, 0)
    t.equal(converted(temporal(0x2B, 0), late, true), "2024-01-03 00:58:59 +00:59")
}

fn test_sql_variant_follows_the_exact_setting(t: *testing.T) {
    let raw = joined([[0x2A, 1, 7], datetime2_raw(110451234567, 738886, 7)])
    let exact = variant_value(raw, true) catch {
        _ => sql.Value.Null
    }
    t.equal(shown(exact), "2024-01-02 03:04:05.1234567")
    let decoded = variant_value(raw, false) catch {
        _ => sql.Value.Null
    }
    t.equal(shown(decoded), "Timestamp(1704164645123456)")
}

fn test_exact_text_rejects_a_value_of_the_wrong_size(t: *testing.T) {
    let rejected = exact_text(temporal(0x2A, 7), [1, 2, 3]) catch {
        _ => "rejected"
    }
    t.equal(rejected, "rejected")
}

fn typed(id: u8, shape: Shape, size: i64, name: str) -> Type {
    type_of(id, shape, size, name)
}

fn test_columns_report_precision_scale_and_length(t: *testing.T) {
    var numeric = typed(0x6C, Byte, 17, "numeric")
    numeric.precision = 38
    numeric.scale = 10
    let n = column_of("n", numeric)
    t.equal(n.precision, 38)
    t.equal(n.scale, 10)
    t.equal(n.length, 0)

    let stamp = column_of("d", temporal(0x2A, 7))
    t.equal(stamp.scale, 7)
    t.equal(stamp.precision, 0)

    t.equal(column_of("v", typed(0xE7, Short, 20, "nvarchar")).length, 10)
    t.equal(column_of("v", typed(0xEF, Short, 8, "nchar")).length, 4)
    t.equal(column_of("v", typed(0xA7, Short, 20, "varchar")).length, 20)
    t.equal(column_of("v", typed(0xAF, Short, 5, "char")).length, 5)
    t.equal(column_of("v", typed(0xA5, Short, 16, "varbinary")).length, 16)
    t.equal(column_of("v", typed(0xAD, Short, 4, "binary")).length, 4)
}

fn test_unbounded_columns_report_minus_one(t: *testing.T) {
    t.equal(column_of("v", typed(0xE7, Partial, 0xFFFF, "nvarchar")).length, -1)
    t.equal(column_of("v", typed(0xA7, Partial, 0xFFFF, "varchar")).length, -1)
    t.equal(column_of("v", typed(0xA5, Partial, 0xFFFF, "varbinary")).length, -1)
    t.equal(column_of("v", typed(0xF1, Partial, 0, "xml")).length, -1)
    t.equal(column_of("v", typed(0x23, Long, 0x7FFFFFFF, "text")).length, -1)
    t.equal(column_of("v", typed(0x63, Long, 0x7FFFFFFE, "ntext")).length, -1)
    t.equal(column_of("v", typed(0x22, Long, 0x7FFFFFFF, "image")).length, -1)
}

fn test_other_columns_report_no_length(t: *testing.T) {
    let c = column_of("i", typed(0x38, Fixed, 4, "int"))
    t.equal(c.length, 0)
    t.equal(c.precision, 0)
    t.equal(c.scale, 0)
}
