import std/io
import std/sql
import std/sql/driver
import std/sync
import std/testing

struct Sink {
    written: u8[]
}

fn conn_on(sink: *Sink) -> *Conn {
    let s = io.Stream {
        read: fn(buf) -> i64 ! io.Error { 0 }
        write: fn(data) -> i64 ! io.Error {
            io.append(mut sink.written, data)
            data.len
        }
        close: fn() {}
    }
    new(Conn {
        stream: s
        reader: io.reader(s)
        payload: []
        at: 0
        last: true
        packet_size: initial_packet_size
        transaction: __make(8)
        timeout: 0
        reading: false
        read_started: 0
        timed_out: false
        guard: sync.mutex()
        sent: false
        attention: false
        logged_in: true
        challenged: false
        challenge: []
        session: driver.session()
    })
}

fn kinds(written: u8[]) -> u8[] {
    var out: u8[] = []
    var at = 0
    for at < written.len {
        out.push(written[at])
        at += io.be16(written, at + 2)
    }
    out
}

fn cancelled(c: *Conn) -> bool {
    transmit(c, packet_batch, batch_message("SELECT 1", c.transaction)) catch {
        Cancelled => return true
        _ => return false
    }
    false
}

fn test_a_request_cancelled_before_it_is_sent_writes_nothing(t: *testing.T) {
    let sink = new(Sink { written: [] })
    let c = conn_on(sink)
    c.session.cancelled = true
    t.is_true(cancelled(c))
    t.equal(sink.written.len, 0)
    t.is_false(c.sent)
}

fn test_a_request_is_written_and_marked_sent(t: *testing.T) {
    let sink = new(Sink { written: [] })
    let c = conn_on(sink)
    t.is_false(cancelled(c))
    t.equal_slice(kinds(sink.written), [packet_batch])
    t.is_true(c.sent)
}

fn test_cancel_with_no_request_sent_writes_nothing(t: *testing.T) {
    let sink = new(Sink { written: [] })
    let c = conn_on(sink)
    interrupt(c)
    t.equal(sink.written.len, 0)
    t.is_false(c.attention)
}

fn test_cancel_of_a_sent_request_writes_one_attention(t: *testing.T) {
    let sink = new(Sink { written: [] })
    let c = conn_on(sink)
    cancelled(c)
    interrupt(c)
    interrupt(c)
    t.equal_slice(kinds(sink.written), [packet_batch, packet_attention])
    t.is_true(c.attention)
}

fn test_a_finished_response_is_not_cancelled(t: *testing.T) {
    let sink = new(Sink { written: [] })
    let c = conn_on(sink)
    cancelled(c)
    t.is_true(finished(c))
    interrupt(c)
    t.equal_slice(kinds(sink.written), [packet_batch])
    t.is_false(c.sent)
}

fn test_a_response_waits_for_an_outstanding_attention(t: *testing.T) {
    let sink = new(Sink { written: [] })
    let c = conn_on(sink)
    cancelled(c)
    interrupt(c)
    t.is_false(finished(c))
    t.is_true(c.sent)
    acknowledge(c)
    t.is_true(finished(c))
    t.is_false(c.sent)
}

fn test_a_cancel_of_a_closed_connection_writes_nothing(t: *testing.T) {
    let sink = new(Sink { written: [] })
    let c = conn_on(sink)
    cancelled(c)
    c.session.closed = true
    interrupt(c)
    t.equal_slice(kinds(sink.written), [packet_batch])
}
