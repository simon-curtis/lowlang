import std/sql
import std/testing

fn env_body(kind: u8, value: str, old: str) -> u8[] {
    var body: u8[] = [kind]
    bv_text(mut body, value)
    bv_text(mut body, old)
    body
}

fn bv_text(mut b: u8[], s: str) {
    let units = utf16_bytes(s)
    b.push(u8(units.len / 2))
    for u in units {
        b.push(u)
    }
}

fn token_of(body: u8[]) -> u8[] {
    var out: u8[] = [u8(body.len & 0xFF), u8(body.len >> 8)]
    for b in body {
        out.push(b)
    }
    out
}

fn settings_after(c: *Conn, body: u8[]) -> str[] ! sql.Error {
    var seen: str[] = []
    c.session.notice = fn(n: sql.Notice) {
        match n {
            Setting(name, value) => seen.push("{name}={value}")
            _ => seen.push("other")
        }
    }
    c.payload = token_of(body)
    c.at = 0
    c.last = true
    env_change(c)?
    seen
}

fn drained(c: *Conn, body: u8[]) -> str[] {
    settings_after(c, body) catch {
        _ => ["failed"]
    }
}

fn test_a_database_change_is_reported_as_a_setting(t: *testing.T) {
    let sink = new(Sink { written: [] })
    let c = conn_on(sink)
    t.equal_slice(drained(c, env_body(1, "tempdb", "shop")), ["database=tempdb"])
}

fn test_a_language_change_is_reported_as_a_setting(t: *testing.T) {
    let sink = new(Sink { written: [] })
    let c = conn_on(sink)
    t.equal_slice(drained(c, env_body(2, "Deutsch", "us_english")), ["language=Deutsch"])
}

fn test_other_environment_changes_are_not_reported(t: *testing.T) {
    let sink = new(Sink { written: [] })
    let c = conn_on(sink)
    t.equal_slice(drained(c, env_body(3, "iso_1", "")), [])
    t.equal_slice(drained(c, env_body(7, "x", "")), [])
}

fn test_a_truncated_database_change_is_a_protocol_error(t: *testing.T) {
    let sink = new(Sink { written: [] })
    let c = conn_on(sink)
    let body: u8[] = [1, 9, 't', 0]
    t.equal_slice(drained(c, body), ["failed"])
}
