import std/io
import std/math
import std/net
import std/sql
import std/text
import std/time

const browser_port = 1434
const browser_request_instance: u8 = 0x04
const browser_response: u8 = 0x05
const max_port = 65535

struct Target {
    host: str
    instance: str
}

fn target_of(host: str) -> Target {
    let at = text.index_byte(host, '\\')
    let bare = if at < 0 { host } else { host[..at] }
    let instance = if at < 0 { "" } else { host[at + 1..] }
    let name = if bare == "." || text.equal_fold(bare, "(local)") { "localhost" } else { bare }
    Target { host: name, instance }
}

fn named(o: sql.Options) -> sql.Options {
    let target = target_of(o.host)
    var out = o
    out.host = target.host
    out
}

fn located(o: sql.Options) -> sql.Options ! sql.Error {
    let target = target_of(o.host)
    var out = o
    out.host = target.host
    if target.instance.len > 0 && o.port == 0 {
        out.port = instance_port(target.host, target.instance, o.timeout)?
    }
    out
}

fn browser_request(instance: str) -> u8[] {
    var b: u8[] = [browser_request_instance]
    text.append(mut b, instance)
    b.push(0)
    b
}

fn browser_port_of(reply: u8[], instance: str) -> i64 ! sql.Error {
    if reply.len < 3 || reply[0] != browser_response {
        fail Connect
    }
    let size = io.le16(reply, 1)
    if size > reply.len - 3 {
        fail Connect
    }
    let data = str(reply[3..3 + size])
    for block in text.split_str(data, ";;") {
        let parts = text.split(block, ';')
        var matching = false
        var i = 0
        for i + 1 < parts.len {
            let key = parts[i]
            let value = parts[i + 1]
            if text.equal_fold(key, "InstanceName") {
                matching = text.equal_fold(value, instance)
            } else if matching && text.equal_fold(key, "tcp") {
                let port = text.parse_int(value) or fail Connect
                if port < 1 || port > max_port {
                    fail Connect
                }
                return port
            }
            i += 2
        }
    }
    fail Connect
}

fn bind_for(ip: u8[]) -> net.Socket ! sql.Error {
    net.bind_udp(if net.v6(ip) { "::" } else { "" }, 0) catch {
        _ => fail Connect
    }
}

fn ask_browser(ip: u8[], instance: str, timeout: i64) -> i64 ! sql.Error {
    let server = net.Addr { ip, port: browser_port }
    using s = bind_for(ip)?
    net.send_to(s, browser_request(instance), server) catch {
        _ => fail Connect
    }
    let deadline = time.monotonic() + timeout * 1000000
    let buf = io.buffer(65535)
    for {
        if timeout > 0 {
            let remaining = (deadline - time.monotonic()) / 1000000
            if remaining <= 0 {
                fail Timeout
            }
            net.set_receive_timeout(s, remaining)
        }
        let packet = net.receive_from(s, buf) catch {
            TimedOut => fail Timeout
            _ => fail Connect
        }
        if net.format(packet.from) == net.format(server) {
            return browser_port_of(buf[..packet.size], instance)?
        }
    }
}

fn instance_port(host: str, instance: str, timeout: i64) -> i64 ! sql.Error {
    let addresses = net.lookup(host) catch {
        _ => fail Connect
    }
    let share = if timeout > 0 && addresses.len > 0 { math.max(timeout / addresses.len, 1) } else { timeout }
    var last = sql.Error.Connect
    for ip in addresses {
        let port = ask_browser(ip, instance, share) catch {
            e => {
                last = e
                continue
            }
        }
        return port
    }
    fail last
}
