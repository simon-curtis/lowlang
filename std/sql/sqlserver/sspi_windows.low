import std/io
import std/sql

extern "secur32" {
    fn AcquireCredentialsHandleW(principal: ptr, package: ptr, usage: u32, logon: ptr, auth: ptr, key_fn: ptr, key_arg: ptr, credential: ptr, expiry: ptr) -> i32
    fn InitializeSecurityContextW(credential: ptr, context: ptr, target: ptr, requested: u32, reserved: u32, representation: u32, input: ptr, reserved2: u32, new_context: ptr, output: ptr, attributes: ptr, expiry: ptr) -> i32
    fn DeleteSecurityContext(context: ptr) -> i32
    fn FreeCredentialsHandle(credential: ptr) -> i32
    fn FreeContextBuffer(buffer: ptr) -> i32
}

const credential_use_outbound: u32 = 2
const native_representation: u32 = 0x10
const request_flags: u32 = 0x91C
const buffer_token = 2
const status_continue_needed = 0x90312

struct Sspi {
    credential: u8[]
    context: u8[]
    target: u8[]
    acquired: bool
    opened: bool
}

fn wide_z(s: str) -> u8[] {
    var out: u8[] = []
    io.append(mut out, utf16_bytes(s))
    out.push(0)
    out.push(0)
    out
}

fn status_code(status: i32) -> i64 {
    i64(status) & 0xFFFFFFFF
}

fn sspi_begin(target: str) -> *Sspi ! sql.Error {
    let s = new(Sspi { credential: io.buffer(16), context: io.buffer(16), target: wide_z(target), acquired: false, opened: false })
    let package = wide_z("Negotiate")
    let expiry = io.buffer(8)
    let package_at = pin(package)
    let credential_at = pin(s.credential)
    let expiry_at = pin(expiry)
    let status = AcquireCredentialsHandleW(null, package_at, credential_use_outbound, null, null, null, null, credential_at, expiry_at)
    unpin(expiry_at)
    unpin(credential_at)
    unpin(package_at)
    if status != 0 {
        fail Authentication
    }
    s.acquired = true
    s
}

fn sspi_token(s: *Sspi, input: u8[]) -> u8[] ! sql.Error {
    let in_buffer = io.buffer(16)
    let in_desc = io.buffer(16)
    let out_buffer = io.buffer(16)
    let out_desc = io.buffer(16)
    let attributes = io.buffer(4)
    let expiry = io.buffer(8)
    let credential_at = pin(s.credential)
    let context_at = pin(s.context)
    let target_at = pin(s.target)
    let in_buffer_at = pin(in_buffer)
    let in_desc_at = pin(in_desc)
    let out_buffer_at = pin(out_buffer)
    let out_desc_at = pin(out_desc)
    let attributes_at = pin(attributes)
    let expiry_at = pin(expiry)
    var input_at: ptr = null
    var offered: ptr = null
    if input.len > 0 {
        input_at = pin(input)
        offered = in_desc_at
    }
    io.set_le32(in_buffer, 0, input.len)
    io.set_le32(in_buffer, 4, buffer_token)
    io.set_le64(in_buffer, 8, i64(input_at))
    io.set_le32(in_desc, 4, 1)
    io.set_le64(in_desc, 8, i64(in_buffer_at))
    io.set_le32(out_buffer, 4, buffer_token)
    io.set_le32(out_desc, 4, 1)
    io.set_le64(out_desc, 8, i64(out_buffer_at))
    var current: ptr = null
    if s.opened {
        current = context_at
    }
    let status = InitializeSecurityContextW(credential_at, current, target_at, request_flags, 0, native_representation, offered, 0, context_at, out_desc_at, attributes_at, expiry_at)
    if input.len > 0 {
        unpin(input_at)
    }
    unpin(expiry_at)
    unpin(attributes_at)
    unpin(out_desc_at)
    unpin(out_buffer_at)
    unpin(in_desc_at)
    unpin(in_buffer_at)
    unpin(target_at)
    unpin(context_at)
    unpin(credential_at)
    let code = status_code(status)
    var token: u8[] = []
    let address = io.le64(out_buffer, 8)
    if address != 0 {
        io.append(mut token, bytes(__str_raw(address, io.le32(out_buffer, 0))))
        FreeContextBuffer(ptr(address))
    }
    if code != 0 && code != status_continue_needed {
        fail Authentication
    }
    s.opened = true
    token
}

fn sspi_end(s: *Sspi) {
    if s.opened {
        let context_at = pin(s.context)
        DeleteSecurityContext(context_at)
        unpin(context_at)
    }
    if s.acquired {
        let credential_at = pin(s.credential)
        FreeCredentialsHandle(credential_at)
        unpin(credential_at)
    }
}
