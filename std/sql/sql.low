/// A database value, used both as a statement parameter and as a cell in a result row.
///
/// Which variants a driver returns depends on the database: SQLite only produces `Null`, `Int`, `Float`, `Text` and `Bytes`, and stores the other variants as integers, text or blobs when they are bound. A driver fails with `Error.Conversion` when it cannot represent a parameter.
pub enum Value {
    /// SQL `NULL`.
    Null
    /// A boolean.
    Bool(value: bool)
    /// A 64-bit signed integer.
    Int(value: i64)
    /// A 64-bit floating point number.
    Float(value: f64)
    /// An exact decimal number as its decimal digits in text form, for example `"12.50"`.
    Decimal(digits: str)
    /// A text string.
    Text(value: str)
    /// A binary string.
    Bytes(value: u8[])
    /// A UUID as its 16 raw bytes.
    Uuid(value: u8[])
    /// A calendar date as the number of days since 1970-01-01.
    Date(days: i64)
    /// A time of day as the number of microseconds since midnight.
    Time(micros: i64)
    /// A date and time without a zone as the number of microseconds since 1970-01-01 00:00:00.
    Timestamp(micros: i64)
    /// A date and time in UTC as the number of microseconds since 1970-01-01 00:00:00 UTC.
    TimestampTz(micros: i64)
}

/// The error the SQL drivers return, which `std/sql/pool` wraps in `pool.Error.Sql`.
pub enum Error {
    /// The connection could not be established.
    Connect
    /// The server rejected the login or the authentication exchange failed.
    Authentication
    /// The connection is closed.
    Closed
    /// Connecting, reading or writing did not finish within `Options.timeout`.
    Timeout
    /// The server sent data the driver does not understand. The driver abandons the connection.
    Protocol
    /// The server or the statement needs a feature the driver does not support, such as an unsupported authentication method or TLS negotiation.
    Unsupported
    /// A value cannot be converted to or from its database representation, or the parameter count does not match the statement.
    Conversion
    /// The connection is in use by another call, or the SQLite database is locked.
    Busy
    /// The call was stopped by the connection's `cancel`. The connection stays usable.
    Cancelled
    /// The server reported one or more errors. `errors` holds every error the call received, in the order the server sent them, and is never empty.
    Server(errors: Diagnostic[])
}

/// Returns a `Server` error holding one `Failure` diagnostic with `code` and `message`.
pub fn server_error(code: str, message: str) -> Error {
    Error.Server([Diagnostic { level: Level.Failure, code, message }])
}

/// How serious a `Diagnostic` is.
pub enum Level {
    /// An informational message: SQL Server `PRINT` and severity 10 and below, PostgreSQL `DEBUG`, `LOG`, `INFO` and `NOTICE`.
    Info
    /// A warning: PostgreSQL `WARNING`.
    Warning
    /// An error that fails the statement and leaves the connection usable: SQL Server severity 11 to 19, PostgreSQL `ERROR`, and every MySQL, MariaDB and SQLite error.
    Failure
    /// An error that ends the session: SQL Server severity 20 and above, PostgreSQL `FATAL` and `PANIC`.
    Fatal
}

/// A message from the server: an error, a warning or an informational message.
///
/// `level`, `code` and `message` are set on every database. The other fields hold what the protocol provides and stay empty or `0` otherwise.
pub struct Diagnostic {
    /// How serious the message is.
    pub level: Level
    /// The SQLSTATE on PostgreSQL, MySQL and MariaDB, the message number on SQL Server and the extended result code on SQLite.
    pub code: str
    /// The server's text.
    pub message: str
    /// The server's own name for the severity: PostgreSQL's non-localised severity, such as `NOTICE` or `ERROR`. Empty on the other databases.
    pub severity: str = ""
    /// The SQL Server severity class, from `0` to `25`.
    pub class: i64 = 0
    /// The SQL Server error state.
    pub state: i64 = 0
    /// The name of the SQL Server that sent the message.
    pub server: str = ""
    /// The SQL Server stored procedure or remote procedure call that raised the message.
    pub procedure: str = ""
    /// The line in the SQL Server batch or procedure that raised the message, counted from `1`.
    pub line: i64 = 0
    /// The PostgreSQL character position in the statement text where the error was found, counted from `1`.
    pub position: i64 = 0
    /// The PostgreSQL secondary message.
    pub detail: str = ""
    /// The PostgreSQL suggestion for fixing the problem.
    pub hint: str = ""
    /// The PostgreSQL call stack where the message was raised, one entry per line.
    pub context: str = ""
    /// The text of an internally generated PostgreSQL command, such as a PL/pgSQL statement, that failed.
    pub internal_query: str = ""
    /// The position in `internal_query` where the error was found, counted from `1`.
    pub internal_position: i64 = 0
    /// The PostgreSQL schema of the object the error concerns.
    pub schema: str = ""
    /// The PostgreSQL table the error concerns.
    pub table: str = ""
    /// The PostgreSQL column the error concerns.
    pub column: str = ""
    /// The PostgreSQL data type the error concerns.
    pub data_type: str = ""
    /// The PostgreSQL constraint the error concerns.
    pub constraint: str = ""
    /// The PostgreSQL source file that raised the message.
    pub file: str = ""
    /// The line in `file` that raised the message.
    pub file_line: i64 = 0
    /// The PostgreSQL source routine that raised the message.
    pub routine: str = ""
}

/// Something the server sent that is not part of a result: a diagnostic or a notification.
pub enum Notice {
    /// A diagnostic the server sent during a call. Errors arrive here as well as in the call's `Error.Server`.
    Message(diagnostic: Diagnostic)
    /// A PostgreSQL `NOTIFY` on a channel the session listens to: the channel, the payload and the process id of the sending session.
    Notification(channel: str, payload: str, process: i64)
    /// A session setting the server reports as changed, such as `database` or `language` on SQL Server and `TimeZone`, `DateStyle` or `application_name` on PostgreSQL. `name` is the server's name for the setting and `value` its new value. It arrives in the order the server sent it relative to the rows of the call that read it. Settings the server reports while the connection logs in are not delivered, because `on_notice` can only be set once the connection exists.
    Setting(name: str, value: str)
}

/// One step of a statement's results, as `ConnectionHandle.stream` reports them.
pub enum Event {
    /// A result set starts with these columns. Each later `Row` belongs to it.
    Columns(columns: Column[])
    /// A row of the current result set, with one `Value` per column.
    Row(values: Value[])
    /// A statement finished. `count` is the number of rows the server reported it returned or affected, `some(0)` for a statement that matched no rows, and `none` when the server reported no count for the statement, as for SQL Server `SET` and DDL statements or the PostgreSQL command `CREATE TABLE`.
    Done(count: i64?)
}

/// A column of a result set.
pub struct Column {
    /// The column name or alias as the database reports it.
    pub name: str
    /// The database's name for the column type, empty when the database reports none.
    pub kind: str
    /// The number of significant digits of a `decimal` or `numeric` column, `0` when the column has none or the database does not report it. SQL Server, PostgreSQL and MySQL report it; PostgreSQL reports `0` for a `numeric` without a declared precision.
    pub precision: i64 = 0
    /// The number of digits after the decimal point of a `decimal` or `numeric` column, and the number of fractional-second digits of a time, timestamp or interval column: SQL Server `time`, `datetime2` and `datetimeoffset`, PostgreSQL `time`, `timetz`, `timestamp`, `timestamptz` and `interval`, MySQL `time`, `datetime` and `timestamp`. `0` when the column has none or the database does not report it. A PostgreSQL time, timestamp or interval column without a declared precision reports `6`, the most the server stores.
    pub scale: i64 = 0
    /// The declared length of a character or binary column, `0` when the column has none or the database does not report it. SQL Server reports characters for `nchar` and `nvarchar` and bytes for `char`, `varchar`, `binary` and `varbinary`; PostgreSQL reports characters for `varchar` and `bpchar`; MySQL reports the column length of the server's column definition, which is in bytes of the column's character set. `-1` marks a column the declaration leaves unbounded: SQL Server `varchar(max)`, `nvarchar(max)`, `varbinary(max)`, `xml`, `text`, `ntext` and `image`, and PostgreSQL `varchar` and `bpchar` without a length.
    pub length: i64 = 0
    /// The OID of the table the column comes from, `0` when the column is not a table column or the database does not report it. PostgreSQL reports it.
    pub table: i64 = 0
    /// The column's attribute number in `table`, counted from `1` for the table's own columns and below `0` for a system column such as `ctid`. `0` when `table` is `0`.
    pub number: i64 = 0
}

/// What a statement would take and return, as `ConnectionHandle.describe` reports it.
pub struct Description {
    /// The columns of the result, empty for a statement that returns no rows.
    pub columns: Column[]
    /// The database's type name of each parameter, in order.
    pub parameters: str[]
}

/// A fully buffered result set.
pub struct Rows {
    /// The columns of the result. A query that returns no rows still reports them.
    pub columns: Column[]
    /// The rows in the order the database returned them; each row has one `Value` per column.
    pub rows: Value[][]
    /// The number of rows the server reported for the statement that produced the result, `0` when it reported none.
    pub count: i64 = 0
}

/// A copyable view of a database connection, made of closures.
///
/// Copies refer to the same connection and none of them owns it: `close` closes the connection for all of them. `std/orm` and `std/sql/pool` work in terms of this view. The `handle` field of a `Connection` is one.
pub struct ConnectionHandle {
    /// The dialect the connection speaks.
    pub dialect: Dialect
    /// Runs the statement with the parameters and returns all rows.
    pub query: fn(str, Value[]) -> Rows ! Error
    /// Runs the statement with the parameters and calls the callback for each row in turn, with the columns and the row. The callback returns `false` to stop early.
    pub each: fn(str, Value[], fn(Column[], Value[]) -> bool) ! Error
    /// Runs the statements with the parameters and calls the callback with every result set, row and statement end in the order the server sent them. The callback returns `false` to stop early.
    ///
    /// Without parameters, the text may hold several statements on SQL Server, PostgreSQL and MySQL. Result sets that completed before a server error have reached the callback by the time the call fails.
    pub stream: fn(str, Value[], fn(Event) -> bool) ! Error
    /// Runs the statement with the parameters, discards any rows and returns the number of rows affected.
    pub execute: fn(str, Value[]) -> i64 ! Error
    /// Parses the statement and returns its result columns and parameter types without running it. The text must hold one statement. PostgreSQL supports it; the other drivers fail with `Error.Unsupported`.
    pub describe: fn(str) -> Description ! Error = describe_unsupported
    /// Runs exactly one statement with the parameters as a prepared statement and calls the callback as `stream` does. Text holding more than one statement fails with the server's error, also without parameters, so text wrapped in a statement, such as a cursor declaration, cannot end it and run another. PostgreSQL supports it through its extended query protocol; the other drivers fail with `Error.Unsupported`.
    pub stream_prepared: fn(str, Value[], fn(Event) -> bool) ! Error = stream_prepared_unsupported
    /// Stops the call running on the connection, from any green thread, and does nothing when no call runs.
    ///
    /// The call fails with `Error.Cancelled` and the connection stays usable. A call the server finishes before the request reaches it returns its result.
    pub cancel: fn()
    /// Sets the function that receives the connection's notices, replacing the previous one. It runs on the green thread of the call that reads the notice, in the order the server sent it relative to the rows, and must not make a call on the connection.
    pub on_notice: fn(fn(Notice))
    /// Starts a transaction.
    pub begin: fn() ! Error
    /// Commits the current transaction.
    pub commit: fn() ! Error
    /// Rolls back the current transaction.
    pub rollback: fn() ! Error
    /// Closes the connection. A second call has no effect.
    pub close: fn()
}

fn describe_unsupported(text: str) -> Description ! Error {
    fail Unsupported
}

fn stream_prepared_unsupported(text: str, values: Value[], receive: fn(Event) -> bool) ! Error {
    fail Unsupported
}

/// An owned database connection that closes the underlying connection when dropped.
///
/// Its `handle` is the copyable view that `std/orm` and `std/sql/pool` work in terms of; `adopt` builds a `Connection` from one.
pub struct Connection {
    /// The copyable view of the connection.
    pub handle: ConnectionHandle
    drop {
        handle.close()
    }
}

/// Returns a `Connection` that owns the connection behind the handle, so that dropping it calls the handle's `close`.
pub fn adopt(h: ConnectionHandle) -> Connection {
    Connection { handle: h }
}

/// Runs the statements with the parameters through `h.stream` and returns every result set in order, each with the count the server reported for it.
///
/// A statement that returns no result set adds nothing. A call that fails returns only the error; `stream` delivers the result sets that completed before it.
pub fn query_all(h: ConnectionHandle, text: str, values: Value[]) -> Rows[] ! Error {
    var sets: Rows[] = []
    var open = false
    var columns: Column[] = []
    var rows: Value[][] = []
    h.stream(text, values, fn(e) -> bool {
        match e {
            Columns(described) => {
                if open {
                    sets.push(Rows { columns, rows })
                }
                open = true
                columns = described
                rows = []
            }
            Row(values) => rows.push(values)
            Done(count) => {
                if open {
                    sets.push(Rows { columns, rows, count: count ?? 0 })
                    open = false
                }
            }
        }
        true
    })?
    if open {
        sets.push(Rows { columns, rows })
    }
    sets
}

/// Rolls back the current transaction of `h` after `cause` and returns the error to report.
///
/// That is `cause` when the rollback succeeds and the rollback's own error when it fails, because the transaction may then still be open.
pub fn rolled_back(h: ConnectionHandle, cause: Error) -> Error {
    h.rollback() catch {
        e => return e
    }
    cause
}

/// The settings a driver's `connect` function takes.
pub struct Options {
    /// The server host name or address. Defaults to `"localhost"`.
    pub host: str = "localhost"
    /// The server port. `0`, the default, selects the dialect's `default_port`: `5432` for PostgreSQL, `1433` for SQL Server and `3306` for MySQL and MariaDB.
    pub port: i64 = 0
    /// The user name. Defaults to empty.
    pub user: str = ""
    /// The password. Defaults to empty.
    pub password: str = ""
    /// The database to use. Defaults to empty, which leaves the choice to the server. `std/sql/sqlite` reads it as the file path and ignores the other fields.
    pub database: str = ""
    /// The application name reported to the server. Defaults to `"lowlang"`.
    pub application: str = "lowlang"
    /// The timeout in milliseconds for connecting and for socket reads and writes. Defaults to `15000`. A timeout fails with `Error.Timeout`.
    pub timeout: i64 = 15000
    /// Whether values arrive as the server writes them. Defaults to `false`. PostgreSQL then passes every value that is not `NULL` as `Value.Text` holding exactly the text the server sent, undecoded, and does not set `DateStyle` at startup, so a script that changes `DateStyle` cannot fail a call. SQL Server passes `time`, `datetime2` and `datetimeoffset` values, also inside `sql_variant`, as `Value.Text` in the form the server writes: `hh:mm:ss`, `yyyy-mm-dd hh:mm:ss` and `yyyy-mm-dd hh:mm:ss +hh:mm`, each followed by as many fractional digits as the column's `scale`, where `datetimeoffset` is its own local time with its offset. Other SQL Server types are unchanged. MySQL and SQLite ignore it.
    pub server_text: bool = false
}
