import std/sql
import std/sql/sqlite
import std/text

fn page_query(d: sql.Dialect, table: str, key: str) -> str {
    let t = sql.quote_identifier(d, table)
    let k = sql.quote_identifier(d, key)
    let after = "{k} > {sql.placeholder(d, 0)}"
    match d.paging {
        Limit => "SELECT * FROM {t} WHERE {after} ORDER BY {k} LIMIT {sql.placeholder(d, 1)}"
        LimitOffset => "SELECT * FROM {t} WHERE {after} ORDER BY {k} LIMIT {sql.placeholder(d, 1)} OFFSET 0"
        OffsetFetch => "SELECT * FROM {t} WHERE {after} ORDER BY {k} OFFSET 0 ROWS FETCH NEXT {sql.placeholder(d, 1)} ROWS ONLY"
    }
}

fn names(h: sql.ConnectionHandle) -> str ! sql.Error {
    let rows = h.query(page_query(h.dialect, "order", "id"), [Int(1), Int(2)])?
    var found: []str = []
    for row in rows.rows {
        match row[1] {
            Text(s) => push(mut found, s)
            _ => {}
        }
    }
    text.join(found, ", ")
}

/// Builds one paging query for each dialect, then runs the SQLite form against a connection that reports its own dialect.
fn main() ! sql.Error {
    for d in [sql.postgres(), sql.sqlserver(), sql.sqlite()] {
        print("{d.system} port {d.default_port}")
        print("  {sql.create_table_if_missing(d, "order", "id {d.types.large} PRIMARY KEY")}")
        print("  {page_query(d, "order", "id")}")
    }

    using c = sqlite.connect(sql.Options { database: ":memory:" })?
    c.handle.execute(sql.create_table_if_missing(c.handle.dialect, "order", "id INTEGER PRIMARY KEY, item TEXT"), [])?
    for item in ["tea", "milk", "bread", "jam"] {
        c.handle.execute("INSERT INTO \"order\" (item) VALUES (?1)", [Text(item)])?
    }
    print("page after 1: {names(c.handle)?}")
}
