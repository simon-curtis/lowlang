import std/sql
import std/sql/sqlite

fn cell(v: sql.Value) -> str {
    match v {
        Int(n) => "{n}"
        Text(s) => s
        _ => "?"
    }
}

fn describe(e: sql.Error) -> str {
    match e {
        Cancelled => "cancelled"
        Server(errors) => {
            let d = errors[0]
            "server error {d.code}: {d.message}"
        }
        _ => "other"
    }
}

fn print_event(e: sql.Event) -> bool {
    match e {
        Columns(columns) => print("columns {columns.len}, first {columns[0].name}")
        Row(values) => print("row {cell(values[0])} {cell(values[1])}")
        Done(count) => print("done {count}")
    }
    true
}

/// Streams a result as events, reads every result set with its count, stops a call with `cancel` and reads the diagnostic of a failed statement, all through the `sql.ConnectionHandle` of an in-memory SQLite database.
fn main() ! sql.Error {
    using c = sqlite.connect(sql.Options { database: ":memory:" })?
    let h = c.handle
    h.execute("CREATE TABLE tasks (id INTEGER PRIMARY KEY, title TEXT NOT NULL UNIQUE)", [])?
    for title in ["write", "review", "ship", "rest"] {
        h.execute("INSERT INTO tasks (title) VALUES (?1)", [Text(title)])?
    }

    h.stream("SELECT id, title FROM tasks WHERE id <= ?1 ORDER BY id", [Int(2)], print_event)?
    h.stream("UPDATE tasks SET title = upper(title) WHERE id > ?1", [Int(2)], print_event)?

    let sets = sql.query_all(h, "SELECT title FROM tasks ORDER BY id", [])?
    for set in sets {
        print("set of {set.rows.len} rows, count {set.count}")
    }

    var seen = 0
    h.stream("SELECT id, title FROM tasks ORDER BY id", [], fn(e: sql.Event) -> bool {
        match e {
            Row(_) => {
                seen += 1
                if seen == 2 {
                    h.cancel()
                }
            }
            _ => {}
        }
        true
    }) catch {
        e => print("after {seen} rows: {describe(e)}")
    }

    h.execute("INSERT INTO tasks (title) VALUES (?1)", [Text("write")]) catch {
        e => {
            print(describe(e))
            0
        }
    }
    print("tasks {cell(h.query("SELECT count(*) FROM tasks", [])?.rows[0][0])}")
}
