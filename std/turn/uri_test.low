import std/io
import std/testing

fn parsed(t: *testing.T, uri: str, host: str, port: i64, transport: Transport) {
    let u = parse_uri(uri) catch {
        e => {
            testing.error(t, "{uri}: {e}")
            return
        }
    }
    testing.error_if(t, u.host != host || u.port != port || u.transport != transport, "{uri}: {u.host} {u.port} {u.transport}")
}

fn refused(t: *testing.T, uri: str, wanted: io.Error) {
    parse_uri(uri) catch {
        e => {
            testing.error_if(t, e != wanted, "{uri}: {e}, wanted {wanted}")
            return
        }
    }
    testing.error(t, "{uri} parsed")
}

fn test_turn_and_turns_uris_give_the_host_port_and_transport(t: *testing.T) {
    parsed(t, "turn:example.org", "example.org", 3478, Transport.Udp)
    parsed(t, "turn:example.org?transport=udp", "example.org", 3478, Transport.Udp)
    parsed(t, "TURN:example.org:8000?Transport=TCP", "example.org", 8000, Transport.Tcp)
    parsed(t, "turns:example.org", "example.org", 5349, Transport.Tls)
    parsed(t, "turns:192.0.2.1:443?transport=tcp", "192.0.2.1", 443, Transport.Tls)
    parsed(t, "turn:[2001:db8::1]:3479?transport=tcp", "2001:db8::1", 3479, Transport.Tcp)
    parsed(t, "turns:[::1]", "::1", 5349, Transport.Tls)
}

fn test_malformed_and_unsupported_uris_are_refused(t: *testing.T) {
    for uri in ["stun:example.org", "turn:", "turn::3478", "turn:example.org:0", "turn:example.org:65536", "turn:example.org:x", "turn:user@example.org", "turn:example.org/path", "turn:example.org?foo=bar", "turn:example.org?transport=", "turn:[::1", "turn:2001:db8::1", "example.org"] {
        refused(t, uri, io.Error.Malformed)
    }
    for uri in ["turns:example.org?transport=udp", "turn:example.org?transport=sctp"] {
        refused(t, uri, io.Error.Unsupported)
    }
}
