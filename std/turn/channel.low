import std/io

/// A ChannelData message (RFC 8656 section 12.4): data for the peer bound to a channel number.
pub struct ChannelData {
    /// The channel number, 0x4000 to 0x4FFF.
    pub number: i64
    /// The application data.
    pub data: u8[]
}

/// Returns whether `datagram` starts like a ChannelData message: its first byte is 64 to 79 (RFC 7983).
pub fn is_channel_data(datagram: u8[]) -> bool {
    datagram.len >= 4 && datagram[0] >= 0x40 && datagram[0] <= 0x4F
}

/// Returns the ChannelData message for `number` and `data`, padded to a multiple of four bytes, which UDP allows and TCP and TLS require (RFC 8656 section 12.5).
pub fn encode_channel_data(number: i64, data: u8[]) -> u8[] {
    var out: u8[] = []
    io.put_be16(mut out, number)
    io.put_be16(mut out, data.len)
    for b in data {
        out.push(b)
    }
    for out.len % 4 != 0 {
        out.push(0)
    }
    out
}

/// Reads a ChannelData message.
///
/// Fails with `Malformed` when the channel number is outside 0x4000 to 0x4FFF or the length runs past the datagram. Padding after the data is ignored.
pub fn parse_channel_data(datagram: u8[]) -> ChannelData ! io.Error {
    if !is_channel_data(datagram) {
        fail Malformed
    }
    let number = io.be16(datagram, 0)
    let length = io.be16(datagram, 2)
    if number > 0x4FFF || 4 + length > datagram.len {
        fail Malformed
    }
    ChannelData { number, data: datagram[4..4 + length] }
}

/// Splits the bytes of a TCP or TLS connection to a TURN server into the STUN and ChannelData messages they carry (RFC 8656 section 12.5).
///
/// A STUN message is its 20-byte header and the length it states; a ChannelData message is its 4-byte header and its length rounded up to four bytes, the padding a stream requires.
pub struct Framer {
    buffered: u8[]
}

/// Returns a framer with nothing buffered.
pub fn framer() -> *Framer {
    new(Framer { buffered: [] })
}

fn frame_size(head: u8[]) -> i64 ! io.Error {
    if head[0] >= 0x40 && head[0] <= 0x4F {
        return (4 + io.be16(head, 2) + 3) / 4 * 4
    }
    let length = io.be16(head, 2)
    if head[0] >= 0x40 || length % 4 != 0 {
        fail Malformed
    }
    20 + length
}

/// Adds `bytes` read from the stream and returns the messages they complete, in order, without the padding of a ChannelData message.
///
/// Fails with `Malformed` when a message starts with a byte that is neither STUN (0 to 63) nor ChannelData (64 to 79) or states a STUN length that is not a multiple of four. A stream has no way to find the next message after that, so the caller closes it.
pub fn feed(f: *Framer, bytes: u8[]) -> u8[][] ! io.Error {
    for b in bytes {
        f.buffered.push(b)
    }
    var out: u8[][] = []
    var at = 0
    for f.buffered.len - at >= 4 {
        let size = frame_size(f.buffered[at..])?
        if f.buffered.len - at < size {
            break
        }
        let length = if f.buffered[at] >= 0x40 { 4 + io.be16(f.buffered, at + 2) } else { size }
        out.push(f.buffered[at..at + length])
        at += size
    }
    f.buffered = f.buffered[at..]
    out
}

/// Returns the number of bytes held for a message that has not ended. At the end of the stream they are the start of a message the connection cut off.
pub fn partial(f: *Framer) -> i64 {
    f.buffered.len
}
