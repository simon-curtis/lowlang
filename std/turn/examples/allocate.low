import std/net
import std/stun
import std/turn

fn main() {
    let server = net.parse_addr("192.0.2.1:3478") or return
    let client = turn.client(turn.Config { server, username: "alice", password: "secret" })
    turn.start(client, 0)
    let request = stun.parse(turn.poll_transmit(client) ?? return) or return
    print("first request is an Allocate: {request.method == stun.allocate}, signed: {stun.find(request, stun.attr_message_integrity) != none}")
    print("retransmission due at {turn.next_timeout(client)} ms")

    let framed = turn.encode_channel_data(0x4000, bytes("hello"))
    let back = turn.parse_channel_data(framed) or return
    print("channel {back.number} carries {str(back.data)} in {framed.len} bytes")
}
