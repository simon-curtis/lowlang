import std/net
import std/stun
import std/turn

fn main() {
    let uri = turn.parse_uri("turns:turn.example.org?transport=tcp") or return
    print("{uri.host} port {uri.port} over {uri.transport}")
    let server = net.parse_addr("192.0.2.1:{uri.port}") or return
    let client = turn.client(turn.Config { server, transport: uri.transport, server_name: uri.host, username: "alice", password: "secret" })
    turn.start(client, 0)
    let allocate = turn.poll_transmit(client) ?? return
    print("Allocate sent once, answer due by {turn.next_timeout(client)} ms")

    var wire: u8[] = []
    for b in turn.encode_channel_data(0x4000, bytes("hi")) {
        wire.push(b)
    }
    for b in allocate {
        wire.push(b)
    }
    let splitter = turn.framer()
    let first = turn.feed(splitter, wire[..5]) or return
    let rest = turn.feed(splitter, wire[5..]) or return
    print("{first.len} messages from the first 5 bytes, {rest.len} from the rest, {turn.partial(splitter)} bytes left")
    let channel = turn.parse_channel_data(rest[0]) or return
    let message = stun.parse(rest[1]) or return
    print("channel {channel.number} carries {str(channel.data)}, then an Allocate: {message.method == stun.allocate}")
}
