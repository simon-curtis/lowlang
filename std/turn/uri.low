import std/io
import std/text

/// A TURN server named by a `turn:` or `turns:` URI (RFC 7065).
pub struct Uri {
    /// The host: a name, or an IP address without the brackets of an IPv6 literal.
    pub host: str
    /// The port, or when the URI names none 3478 for `turn:` and 5349 for `turns:`.
    pub port: i64
    /// `Udp` or `Tcp` for `turn:`, as `?transport=` asks with UDP the default, and `Tls` for `turns:`.
    pub transport: Transport
}

fn transport_of(secure: bool, query: str) -> Transport ! io.Error {
    if query.len == 0 {
        return if secure { Transport.Tls } else { Transport.Udp }
    }
    if !text.starts_with_fold(query, "transport=") {
        fail Malformed
    }
    let name = text.lower(query[10..])
    if name.len == 0 {
        fail Malformed
    }
    if name == "tcp" {
        return if secure { Transport.Tls } else { Transport.Tcp }
    }
    if name == "udp" && !secure {
        return Transport.Udp
    }
    fail Unsupported
}

fn port_of(digits: str) -> i64 ! io.Error {
    if digits.len == 0 || digits.len > 5 {
        fail Malformed
    }
    for b in bytes(digits) {
        if b < '0' || b > '9' {
            fail Malformed
        }
    }
    let port = text.parse_int(digits) or 0
    if port < 1 || port > 65535 {
        fail Malformed
    }
    port
}

/// Reads a `turn:` or `turns:` URI: `turn:host[:port][?transport=udp|tcp]` or `turns:host[:port][?transport=tcp]` (RFC 7065 section 3.1, RFC 8656 section 4.1).
///
/// The scheme and the transport are matched without regard to case, and an IPv6 host is written in brackets. The result gives `Config.server` its port and `Config.transport`, and its `host` is the name to resolve and to put in `Config.server_name`.
///
/// Fails with `Malformed` for another scheme, an empty host, user information, a path, a port outside 1 to 65535 or a query other than `transport=`, and with `Unsupported` for `turns:` over UDP, which is DTLS (RFC 7350), and for a transport other than UDP and TCP.
pub fn parse_uri(uri: str) -> Uri ! io.Error {
    let colon = text.index(uri, ":")
    if colon < 0 {
        fail Malformed
    }
    let scheme = text.lower(uri[..colon])
    if scheme != "turn" && scheme != "turns" {
        fail Malformed
    }
    let secure = scheme == "turns"
    var rest = uri[colon + 1..]
    let question = text.index(rest, "?")
    let query = if question >= 0 { rest[question + 1..] } else { "" }
    if question >= 0 {
        rest = rest[..question]
    }
    if text.index(rest, "@") >= 0 || text.index(rest, "/") >= 0 {
        fail Malformed
    }
    var host = rest
    var port = if secure { 5349 } else { 3478 }
    if text.starts_with(rest, "[") {
        let close = text.index(rest, "]")
        if close < 0 {
            fail Malformed
        }
        host = rest[1..close]
        let after = rest[close + 1..]
        if after.len > 0 {
            if !text.starts_with(after, ":") {
                fail Malformed
            }
            port = port_of(after[1..])?
        }
    } else {
        let at = text.index(rest, ":")
        if at >= 0 {
            host = rest[..at]
            port = port_of(rest[at + 1..])?
        }
    }
    if host.len == 0 || text.index(host, "[") >= 0 || text.index(host, "]") >= 0 {
        fail Malformed
    }
    let transport = transport_of(secure, query)?
    Uri { host, port, transport }
}
