import std/semver

fn parse_tag(tag: str) -> semver.Version? {
    let version = semver.parse(tag) catch {
        Empty => {
            print("skipped an empty tag")
            return none
        }
        Malformed(at) => {
            print("skipped {tag}: malformed at {at}")
            return none
        }
    }
    version
}

fn sorted(versions: []semver.Version) -> []semver.Version {
    var out = versions
    for i in 1..out.len {
        let current = out[i]
        var j = i
        for j > 0 && semver.less(current, out[j - 1]) {
            out[j] = out[j - 1]
            j -= 1
        }
        out[j] = current
    }
    out
}

/// Sorts release tags by precedence, finds the newest stable release and decides whether an installed version can move to it.
fn main() {
    let tags = ["v1.10.0", "1.2.0", "1.10.0-rc.2", "1.10.0-rc.10", "1.10.0-beta", "2.0.0-alpha.1", "1.9.9+build.7", "", "1.2", "01.2.3", "1.2.3-"]

    var versions: []semver.Version = []
    for tag in tags {
        let version = parse_tag(tag) ?? continue
        push(mut versions, version)
    }

    for v in sorted(versions) {
        print(semver.format(v))
    }

    var newest: semver.Version? = none
    for v in versions {
        if v.pre.len > 0 {
            continue
        }
        match newest {
            some(best) => {
                if semver.less(best, v) {
                    newest = v
                }
            }
            none => {
                newest = v
            }
        }
    }
    let latest = newest ?? semver.Version { major: 0, minor: 0, patch: 0 }
    print("newest stable: {semver.format(latest)}")

    let installed = semver.parse("1.9.9+local") or latest
    let order = semver.compare(installed, latest)
    print("compare {semver.format(installed)} with {semver.format(latest)}: {order}")
    let build_a = semver.parse("1.0.0+a") or latest
    let build_b = semver.parse("1.0.0+b") or latest
    let same = semver.compare(build_a, build_b)
    print("build metadata ignored: {same}")
    if installed.major == latest.major {
        print("minor upgrade")
    } else {
        print("major upgrade")
    }
}
