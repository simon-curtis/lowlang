extern "c" {
    fn read(fd: i32, buf: ptr, n: i64) -> i64
    fn write(fd: i32, buf: ptr, n: i64) -> i64
    fn errno_location() -> ptr[i32] = "__errno_location"
}

pub struct Reader {
    fd: i32 = 0
    buffer: []u8 = []
    start: i64 = 0
    end: i64 = 0
    done: bool = false
}

fn interrupted() -> bool {
    load(errno_location()) == 4
}

fn send(fd: i32, s: str) {
    var done = 0
    for done < s.len {
        let at = pin(s[done..s.len])
        let n = write(fd, at, s.len - done)
        unpin(at)
        if n > 0 {
            done += n
        } else if !interrupted() {
            return
        }
    }
}

pub fn out(s: str) {
    send(1, s)
}

pub fn err(s: str) {
    send(2, s)
}

pub fn err_line(s: str) {
    send(2, "{s}\n")
}

pub fn stdin() -> Reader {
    Reader {}
}

fn fill(mut r: Reader) -> bool {
    if r.done {
        return false
    }
    if r.start > 0 {
        let kept = r.end - r.start
        for i in 0..kept {
            r.buffer[i] = r.buffer[r.start + i]
        }
        r.start = 0
        r.end = kept
    }
    if r.end == r.buffer.len {
        for i in 0..max(r.buffer.len, 65536) {
            push(mut r.buffer, 0)
        }
    }
    for {
        let at = pin(r.buffer[r.end..r.buffer.len])
        let n = read(r.fd, at, r.buffer.len - r.end)
        unpin(at)
        if n > 0 {
            r.end += n
            return true
        }
        if n == 0 || !interrupted() {
            r.done = true
            return false
        }
    }
}

fn max(a: i64, b: i64) -> i64 {
    if a > b {
        return a
    }
    b
}

fn take(mut r: Reader, end: i64, next: i64) -> str {
    var stop = end
    if stop > r.start && r.buffer[stop - 1] == '\r' {
        stop -= 1
    }
    let line = str(r.buffer[r.start..stop])
    r.start = next
    line
}

pub fn read_line(mut r: Reader) -> str? {
    var scanned = 0
    for {
        for r.start + scanned < r.end {
            let at = r.start + scanned
            if r.buffer[at] == '\n' {
                return take(mut r, at, at + 1)
            }
            scanned += 1
        }
        if !fill(mut r) {
            if r.start < r.end {
                return take(mut r, r.end, r.end)
            }
            return none
        }
    }
}

pub fn read_all(mut r: Reader) -> str {
    for fill(mut r) {
    }
    let rest = str(r.buffer[r.start..r.end])
    r.start = r.end
    rest
}
