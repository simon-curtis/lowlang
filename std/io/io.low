import std/simd

/// The error type shared by the I/O, codec and protocol modules.
///
/// Operating system error numbers map onto the named variants through `errno`; numbers without a variant become `Os`.
pub enum Error {
    /// The file, directory or other named resource does not exist.
    NotFound
    /// The operation is not permitted.
    Denied
    /// The resource already exists.
    Exists
    /// A path component that must be a directory is not one.
    NotDir
    /// The operation does not apply to a directory.
    IsDir
    /// The directory still has entries.
    NotEmpty
    /// An argument or the input is not valid for the operation.
    Invalid
    /// The device has no space left.
    NoSpace
    /// The peer closed the pipe or connection before the write completed.
    BrokenPipe
    /// The address is already bound.
    AddrInUse
    /// The address cannot be bound on this host.
    AddrUnavailable
    /// The network or host cannot be reached.
    Unreachable
    /// The peer actively refused the connection.
    Refused
    /// The peer reset the connection.
    Reset
    /// The connection was aborted.
    Aborted
    /// The operation did not finish in time.
    TimedOut
    /// The resource is closed or was never connected.
    NotConnected
    /// The operation would block and the resource is non-blocking.
    WouldBlock
    /// The input ended before the operation was complete.
    Eof
    /// The input does not follow the expected format.
    Malformed
    /// The input exceeds the size the operation accepts.
    TooLarge
    /// The operation is not supported by this resource or platform.
    Unsupported
    /// An operating system error number that has no named variant.
    Os(code: i64)
}

/// A copyable view of a readable and writable resource, made of `read`, `write` and `close` closures.
///
/// Copies of a `Stream` refer to the same underlying resource.
pub struct Stream {
    /// Reads up to `len` bytes into the slice and returns the count, or `0` at end of input.
    pub read: fn([]u8) -> i64 ! Error
    /// Writes a prefix of the slice and returns how many bytes were written, which can be fewer than `len`.
    pub write: fn([]u8) -> i64 ! Error
    /// Closes the resource.
    pub close: fn()
}

/// Shared state that tracks the uses of a resource so a closed descriptor fails with `NotConnected` instead of reaching a reused one.
///
/// Made by `guard`; each use holds a `Lease` from `enter`, and `retire` stops new uses.
pub struct Guard {
    lock: i64
    users: i64
    closed: bool
    wake: fn()
    release: fn()
}

/// A scope token returned by `enter` that keeps a `Guard` in use.
///
/// Dropping the lease releases the use. When the guard has been retired and the last lease is dropped, the guard's `release` runs.
pub struct Lease {
    guard: *Guard
    drop leave(guard)
}

/// Returns a guard that coordinates use of a resource with its closing.
///
/// `wake` runs once when the guard is retired, to unblock operations that are waiting on the resource. `release` runs once when the guard is retired and no leases remain, and is where the resource is freed.
pub fn guard(wake: fn(), release: fn()) -> *Guard {
    new(Guard { lock: 0, users: 0, closed: false, wake, release })
}

/// Registers a use of the guarded resource and returns the lease that ends it when dropped.
///
/// Fails with `NotConnected` once the guard has been retired, so a closed descriptor is never reached.
pub fn enter(g: *Guard) -> Lease ! Error {
    __lock(mut g.lock)
    if g.closed {
        __unlock(mut g.lock)
        fail NotConnected
    }
    g.users += 1
    __unlock(mut g.lock)
    Lease { guard: g }
}

fn leave(g: *Guard) {
    __lock(mut g.lock)
    g.users -= 1
    let last = g.closed && g.users == 0
    __unlock(mut g.lock)
    if last {
        g.release()
    }
}

/// Closes the guard to new uses.
///
/// Runs `wake` so that blocked operations return, then runs `release` immediately if no lease is held, or when the last lease is dropped. Later calls do nothing.
pub fn retire(g: *Guard) {
    __lock(mut g.lock)
    if g.closed {
        __unlock(mut g.lock)
        return
    }
    g.closed = true
    let idle = g.users == 0
    __unlock(mut g.lock)
    g.wake()
    if idle {
        g.release()
    }
}

/// Returns the `Error` for a Linux error number.
///
/// Numbers without a named variant become `Os(code)`.
pub fn errno(code: i64) -> Error {
    match code {
        1 => Denied
        2 => NotFound
        11 => WouldBlock
        13 => Denied
        17 => Exists
        20 => NotDir
        21 => IsDir
        22 => Invalid
        28 => NoSpace
        32 => BrokenPipe
        39 => NotEmpty
        98 => AddrInUse
        99 => AddrUnavailable
        101 => Unreachable
        103 => Aborted
        104 => Reset
        107 => NotConnected
        110 => TimedOut
        111 => Refused
        113 => Unreachable
        _ => Os(code)
    }
}

/// Converts a raw system call return value into a result.
///
/// Returns `r` when it is not negative. A negative `r` is a negated error number and fails with `errno(-r)`.
pub fn syscall_result(r: i64) -> i64 ! Error {
    if r < 0 {
        fail errno(-r)
    }
    r
}

/// Returns a zeroed byte slice of length `n`.
pub fn buffer(n: i64) -> []u8 {
    __make(n)
}

/// Copies bytes from `src` into `dst` and returns the number copied, which is the smaller of the two lengths.
///
/// The slices can overlap.
pub fn copy(dst: []u8, src: []u8) -> i64 {
    __memmove(dst, src)
}

/// Appends the bytes of `src` to `dst`, growing it as needed.
pub fn append(mut dst: []u8, src: []u8) {
    __extend(mut dst, __str_view(src))
}

/// Returns the big-endian 16-bit unsigned integer at offset `at` in `b`.
pub fn be16(b: []u8, at: i64) -> i64 {
    i64(b[at]) << 8 | i64(b[at + 1])
}

/// Returns the big-endian 24-bit unsigned integer at offset `at` in `b`.
pub fn be24(b: []u8, at: i64) -> i64 {
    i64(b[at]) << 16 | be16(b, at + 1)
}

/// Returns the big-endian 32-bit unsigned integer at offset `at` in `b`.
pub fn be32(b: []u8, at: i64) -> i64 {
    be16(b, at) << 16 | be16(b, at + 2)
}

/// Returns the big-endian 64-bit integer at offset `at` in `b`.
///
/// Values of `2^63` and above wrap to negative.
pub fn be64(b: []u8, at: i64) -> i64 {
    be32(b, at) << 32 | be32(b, at + 4)
}

/// Returns the little-endian 16-bit unsigned integer at offset `at` in `b`.
pub fn le16(b: []u8, at: i64) -> i64 {
    i64(b[at]) | i64(b[at + 1]) << 8
}

/// Returns the little-endian 32-bit unsigned integer at offset `at` in `b`.
pub fn le32(b: []u8, at: i64) -> i64 {
    le16(b, at) | le16(b, at + 2) << 16
}

/// Returns the little-endian 64-bit integer at offset `at` in `b`.
///
/// Values of `2^63` and above wrap to negative.
pub fn le64(b: []u8, at: i64) -> i64 {
    le32(b, at) | le32(b, at + 4) << 32
}

/// Returns the little-endian 24-bit unsigned integer at offset `at` in `b`.
pub fn le24(b: []u8, at: i64) -> i64 {
    le16(b, at) | i64(b[at + 2]) << 16
}

/// Returns the big-endian 16-bit unsigned integer at offset `at` in `b` as a `u16`.
pub fn u16_be(b: []u8, at: i64) -> u16 {
    u16(b[at]) << 8 | u16(b[at + 1])
}

/// Returns the little-endian 16-bit unsigned integer at offset `at` in `b` as a `u16`.
pub fn u16_le(b: []u8, at: i64) -> u16 {
    u16(b[at]) | u16(b[at + 1]) << 8
}

/// Returns the big-endian 32-bit unsigned integer at offset `at` in `b` as a `u32`.
pub fn u32_be(b: []u8, at: i64) -> u32 {
    u32(b[at]) << 24 | u32(b[at + 1]) << 16 | u32(b[at + 2]) << 8 | u32(b[at + 3])
}

/// Returns the little-endian 32-bit unsigned integer at offset `at` in `b` as a `u32`.
pub fn u32_le(b: []u8, at: i64) -> u32 {
    u32(b[at]) | u32(b[at + 1]) << 8 | u32(b[at + 2]) << 16 | u32(b[at + 3]) << 24
}

/// Returns the big-endian 64-bit unsigned integer at offset `at` in `b` as a `u64`.
pub fn u64_be(b: []u8, at: i64) -> u64 {
    u64(u32_be(b, at)) << 32 | u64(u32_be(b, at + 4))
}

/// Returns the little-endian 64-bit unsigned integer at offset `at` in `b` as a `u64`.
pub fn u64_le(b: []u8, at: i64) -> u64 {
    u64(b[at]) | u64(b[at + 1]) << 8 | u64(b[at + 2]) << 16 | u64(b[at + 3]) << 24 | u64(b[at + 4]) << 32 | u64(b[at + 5]) << 40 | u64(b[at + 6]) << 48 | u64(b[at + 7]) << 56
}

/// Returns the little-endian 16-bit unsigned integer at offset `at` in the bytes of `s` as a `u16`.
pub fn u16_le_str(s: str, at: i64) -> u16 {
    u16(s[at]) | u16(s[at + 1]) << 8
}

/// Returns the little-endian 32-bit unsigned integer at offset `at` in the bytes of `s` as a `u32`.
pub fn u32_le_str(s: str, at: i64) -> u32 {
    u32(s[at]) | u32(s[at + 1]) << 8 | u32(s[at + 2]) << 16 | u32(s[at + 3]) << 24
}

/// Returns the little-endian 64-bit unsigned integer at offset `at` in the bytes of `s` as a `u64`.
pub fn u64_le_str(s: str, at: i64) -> u64 {
    u64(u32_le_str(s, at)) | u64(u32_le_str(s, at + 4)) << 32
}

/// Returns the big-endian unsigned integer of `width` bytes, from 1 to 8, at offset `at` in `b`.
pub fn uint_be(b: []u8, at: i64, width: i64) -> u64 {
    var v: u64 = 0
    for i in 0..width {
        v = v << 8 | u64(b[at + i])
    }
    v
}

/// Returns the little-endian unsigned integer of `width` bytes, from 1 to 8, at offset `at` in `b`.
pub fn uint_le(b: []u8, at: i64, width: i64) -> u64 {
    var v: u64 = 0
    for i in 0..width {
        v = v | u64(b[at + i]) << (8 * i)
    }
    v
}

/// Appends the low `size` bytes of `v` to `b` in big-endian order, for a `size` from 0 to 8.
pub fn put_be(mut b: []u8, v: i64, size: i64) {
    for i in 0..size {
        push(mut b, u8(v >> (8 * (size - 1 - i))))
    }
}

/// Appends the low `size` bytes of `v` to `b` in little-endian order, for a `size` from 0 to 8.
pub fn put_le(mut b: []u8, v: i64, size: i64) {
    for i in 0..size {
        push(mut b, u8(v >> (8 * i)))
    }
}

/// Appends the low 16 bits of `v` to `b` in little-endian order.
pub fn put_le16(mut b: []u8, v: i64) {
    push(mut b, u8(v))
    push(mut b, u8(v >> 8))
}

/// Appends the low 24 bits of `v` to `b` in little-endian order.
pub fn put_le24(mut b: []u8, v: i64) {
    put_le16(mut b, v)
    push(mut b, u8(v >> 16))
}

/// Appends the low 32 bits of `v` to `b` in little-endian order.
pub fn put_le32(mut b: []u8, v: i64) {
    put_le16(mut b, v)
    put_le16(mut b, v >> 16)
}

/// Appends the 64 bits of `v` to `b` in little-endian order.
pub fn put_le64(mut b: []u8, v: i64) {
    put_le32(mut b, v)
    put_le32(mut b, v >> 32)
}

/// Appends the low 16 bits of `v` to `b` in big-endian order.
pub fn put_be16(mut b: []u8, v: i64) {
    push(mut b, u8(v >> 8))
    push(mut b, u8(v))
}

/// Appends the low 24 bits of `v` to `b` in big-endian order.
pub fn put_be24(mut b: []u8, v: i64) {
    push(mut b, u8(v >> 16))
    put_be16(mut b, v)
}

/// Appends the low 32 bits of `v` to `b` in big-endian order.
pub fn put_be32(mut b: []u8, v: i64) {
    put_be16(mut b, v >> 16)
    put_be16(mut b, v)
}

/// Appends the 64 bits of `v` to `b` in big-endian order.
pub fn put_be64(mut b: []u8, v: i64) {
    put_be32(mut b, v >> 32)
    put_be32(mut b, v)
}

/// Stores the low 16 bits of `v` into `b` at offset `at` in big-endian order.
///
/// Overwrites existing bytes; `b` must already be long enough.
pub fn set_be16(b: []u8, at: i64, v: i64) {
    b[at] = u8(v >> 8)
    b[at + 1] = u8(v)
}

/// Stores the low 24 bits of `v` into `b` at offset `at` in big-endian order.
///
/// Overwrites existing bytes; `b` must already be long enough.
pub fn set_be24(b: []u8, at: i64, v: i64) {
    b[at] = u8(v >> 16)
    set_be16(b, at + 1, v)
}

/// Stores the low 32 bits of `v` into `b` at offset `at` in big-endian order.
///
/// Overwrites existing bytes; `b` must already be long enough.
pub fn set_be32(b: []u8, at: i64, v: i64) {
    set_be16(b, at, v >> 16)
    set_be16(b, at + 2, v)
}

/// Stores the 64 bits of `v` into `b` at offset `at` in big-endian order.
///
/// Overwrites existing bytes; `b` must already be long enough.
pub fn set_be64(b: []u8, at: i64, v: i64) {
    set_be32(b, at, v >> 32)
    set_be32(b, at + 4, v)
}

/// Stores the low 24 bits of `v` into `b` at offset `at` in little-endian order.
///
/// Overwrites existing bytes; `b` must already be long enough.
pub fn set_le24(b: []u8, at: i64, v: i64) {
    set_le16(b, at, v)
    b[at + 2] = u8(v >> 16)
}

/// Stores the low 16 bits of `v` into `b` at offset `at` in little-endian order.
///
/// Overwrites existing bytes; `b` must already be long enough.
pub fn set_le16(b: []u8, at: i64, v: i64) {
    b[at] = u8(v)
    b[at + 1] = u8(v >> 8)
}

/// Stores the low 32 bits of `v` into `b` at offset `at` in little-endian order.
///
/// Overwrites existing bytes; `b` must already be long enough.
pub fn set_le32(b: []u8, at: i64, v: i64) {
    set_le16(b, at, v)
    set_le16(b, at + 2, v >> 16)
}

/// Stores the 64 bits of `v` into `b` at offset `at` in little-endian order.
///
/// Overwrites existing bytes; `b` must already be long enough.
pub fn set_le64(b: []u8, at: i64, v: i64) {
    set_le32(b, at, v)
    set_le32(b, at + 4, v >> 32)
}

/// Writes all of `data` to the stream, calling `write` repeatedly until every byte is accepted.
///
/// Fails with the first error `write` returns; bytes written before the error are not reported.
pub fn write_all(s: Stream, data: []u8) ! Error {
    var rest = data
    for rest.len > 0 {
        let n = s.write(rest)?
        rest = rest[n..]
    }
}

/// Writes the bytes of `text` to the stream in full, as `write_all` does.
pub fn write_str(s: Stream, text: str) ! Error {
    write_all(s, bytes(text))?
}

/// Reads the stream until end of input and returns everything read.
///
/// Blocks until the stream reports end of input. Fails with the first error `read` returns, discarding the bytes read so far. Does not close the stream.
pub fn read_all(s: Stream) -> []u8 ! Error {
    var out: []u8 = []
    let chunk = buffer(16384)
    for {
        let n = s.read(chunk)?
        if n == 0 {
            break
        }
        append(mut out, chunk[..n])
    }
    out
}

/// A buffered reader over a `Stream` or a fixed byte slice, created by `reader` or `bytes_reader`.
///
/// Used through a pointer. Not safe for concurrent use.
pub struct Reader {
    stream: Stream
    buf: []u8
    start: i64
    end: i64
    fixed: bool
}

/// Returns a buffered reader over `s` with a 16384-byte buffer.
pub fn reader(s: Stream) -> *Reader {
    new(Reader { stream: s, buf: buffer(16384), start: 0, end: 0, fixed: false })
}

/// Returns a reader over the bytes in `data`, which reports end of input once they are consumed.
///
/// The reader reads `data` in place without copying it. Its stream rejects writes with `Unsupported`.
pub fn bytes_reader(data: []u8) -> *Reader {
    let exhausted = Stream {
        read: fn(buf) { 0 }
        write: fn(buf) -> i64 ! Error { fail Unsupported }
        close: fn() {}
    }
    new(Reader { stream: exhausted, buf: data, start: 0, end: data.len, fixed: true })
}

/// Returns the stream the reader reads from.
///
/// Bytes already buffered by the reader are not returned by the stream.
pub fn reader_stream(r: *Reader) -> Stream {
    r.stream
}

/// Returns the number of bytes buffered in the reader and available without reading the stream.
pub fn buffered(r: *Reader) -> i64 {
    r.end - r.start
}

/// Reads more bytes from the stream into the reader's buffer and returns the count, or `0` at end of input.
///
/// Blocks until the stream returns data. Buffered bytes that are not yet consumed are kept. Fails with `TooLarge` when the buffer is full of unconsumed bytes, and with any error the stream returns. A reader made by `bytes_reader` returns `0`.
pub fn fill(r: *Reader) -> i64 ! Error {
    if r.fixed {
        return 0
    }
    if r.start == r.end {
        r.start = 0
        r.end = 0
    }
    if r.end == r.buf.len {
        if r.start == 0 {
            fail TooLarge
        }
        let kept = r.end - r.start
        copy(r.buf, r.buf[r.start..r.end])
        r.start = 0
        r.end = kept
    }
    let n = r.stream.read(r.buf[r.end..])?
    r.end += n
    n
}

/// Reads up to the next line feed and returns the line without its terminator.
///
/// A `\r` directly before the `\n` is removed as well. The returned string is a copy. Blocks until a full line is available.
///
/// Fails with `Eof` when the input ends before a line feed, including when text without a terminator remains; that text stays buffered and can be read with `read_some`. Fails with `TooLarge` when a line does not fit in the 16384-byte buffer.
pub fn read_line(r: *Reader) -> str ! Error {
    var scanned = r.start
    for {
        let i = simd.find_byte(r.buf, scanned, r.end, '\n')
        if i >= 0 {
            var stop = i
            if stop > r.start && r.buf[stop - 1] == '\r' {
                stop -= 1
            }
            let line = str(r.buf[r.start..stop])
            r.start = i + 1
            return line
        }
        scanned = r.end - r.start
        if fill(r)? == 0 {
            fail Eof
        }
        scanned += r.start
    }
}

/// Reads up to `dst.len` bytes into `dst` and returns the count, or `0` at end of input.
///
/// Returns buffered bytes first. When nothing is buffered it blocks for one read of the stream, and a `dst` at least as long as the reader's buffer is read into directly, bypassing the buffer. Returns fewer bytes than requested when that is all that is available.
pub fn read_some(r: *Reader, dst: []u8) -> i64 ! Error {
    if r.start == r.end {
        if dst.len >= r.buf.len {
            return r.stream.read(dst)
        }
        if fill(r)? == 0 {
            return 0
        }
    }
    let n = copy(dst, r.buf[r.start..r.end])
    r.start += n
    n
}

/// Reads exactly `n` bytes and returns them in a new slice.
///
/// Blocks until `n` bytes have been read. Fails with `Eof` if the input ends first, in which case the bytes already read are discarded, and with any error the stream returns.
pub fn read_exact(r: *Reader, n: i64) -> []u8 ! Error {
    let out = buffer(n)
    if read_up_to(r, out)? < n {
        fail Eof
    }
    out
}

/// Reads into `dst` until it is full or the input ends, and returns the count read.
///
/// The count is smaller than `dst.len` only at end of input. Blocks until `dst` is full or the input ends. Fails with any error the stream returns, in which case the bytes already read are in `dst` but not reported.
pub fn read_up_to(r: *Reader, dst: []u8) -> i64 ! Error {
    var got = 0
    for got < dst.len {
        let n = read_some(r, dst[got..])?
        if n == 0 {
            break
        }
        got += n
    }
    got
}

/// Reads and returns the next byte.
///
/// Blocks until a byte is available. Fails with `Eof` at end of input.
pub fn read_byte(r: *Reader) -> u8 ! Error {
    if r.start == r.end && fill(r)? == 0 {
        fail Eof
    }
    let b = r.buf[r.start]
    r.start += 1
    b
}
