import std/io

struct Sink {
    data: []u8
}

fn memory_stream(sink: *Sink) -> io.Stream {
    io.Stream {
        read: fn(dst: []u8) -> i64 ! io.Error { fail Unsupported },
        write: fn(src: []u8) -> i64 ! io.Error {
            io.append(mut sink.data, src)
            src.len
        },
        close: fn() {}
    }
}

fn frame(kind: i64, payload: str) -> []u8 {
    var out: []u8 = []
    io.put_be16(mut out, kind)
    io.put_be32(mut out, 0)
    io.append(mut out, bytes(payload))
    io.set_be32(out, 2, payload.len)
    out
}

fn read_frames(data: []u8) ! io.Error {
    let r = io.bytes_reader(data)
    let banner = io.read_line(r)?
    print("banner: {banner}")
    for {
        let header = io.read_exact(r, 6) catch {
            Eof => break
            e => fail e
        }
        let kind = io.be16(header, 0)
        let size = io.be32(header, 2)
        let payload = io.read_exact(r, size)?
        print("frame kind {kind}, {size} bytes: {str(payload)}")
    }
}

/// Writes a banner line and length-prefixed frames through an in-memory stream, then parses them back with a buffered reader.
fn main() ! io.Error {
    let sink = new(Sink { data: [] })
    let out = memory_stream(sink)
    io.write_str(out, "frames v1\r\n")?
    io.write_all(out, frame(1, "hello"))?
    io.write_all(out, frame(2, "second frame"))?
    io.write_all(out, frame(300, ""))?
    print("{sink.data.len} bytes on the wire")
    read_frames(sink.data)?

    let truncated = sink.data[..sink.data.len - 7]
    print("truncated copy:")
    let cut = io.bytes_reader(truncated)
    io.read_line(cut)?
    for {
        let header = io.read_exact(cut, 6) catch { _ => break }
        let size = io.be32(header, 2)
        io.read_exact(cut, size) catch {
            Eof => {
                print("frame of {size} bytes ends early")
                break
            }
            e => fail e
        }
    }

    var word: []u8 = []
    io.put_le32(mut word, 0x11223344)
    io.put_be32(mut word, 0x11223344)
    print("first byte little endian {word[0]}, big endian {word[4]}, both read back as {io.le32(word, 0)} and {io.be32(word, 4)}, top three bytes {io.uint_be(word, 4, 3)}")
}
