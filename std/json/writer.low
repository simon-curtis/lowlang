import std/math
import std/text

/// A JSON text builder that appends to an internal buffer, made by `writer`.
///
/// Call `start_object`, `property`, the value functions and `end_object` in document order, then read the text with `written_text` or `written_bytes`. Commas, colons and indentation are added automatically. Strings are escaped: `"` and `\` with a backslash, newline, carriage return and tab as `\n`, `\r` and `\t`, and the other control characters below `0x20` as `\u00XX`. Everything else, including non-ASCII text and `/`, is written as it is; the text is not checked for UTF-8. The writer does not check that calls form a valid document.
pub struct Writer {
    out: []u8
    counts: []i64
    indent: i64
    pending_name: bool
}

/// Returns an empty writer.
///
/// `indent` is the number of spaces per nesting level. With `0` the text is compact, with no whitespace. With a positive value each member and element starts on its own line and a space follows each colon.
pub fn writer(indent: i64) -> *Writer {
    new(Writer { out: [], counts: [], indent, pending_name: false })
}

/// Returns the bytes written so far.
///
/// The slice views the writer's buffer, so it changes as more is written.
pub fn written_bytes(w: *Writer) -> []u8 {
    w.out
}

/// Returns the text written so far.
///
/// The string views the writer's buffer, so it changes as more is written.
pub fn written_text(w: *Writer) -> str {
    __str_view(w.out)
}

fn newline(w: *Writer) {
    if w.indent == 0 {
        return
    }
    push(mut w.out, '\n')
    for _ in 0..w.counts.len * w.indent {
        push(mut w.out, ' ')
    }
}

fn separate(w: *Writer) {
    if w.pending_name {
        w.pending_name = false
        return
    }
    if w.counts.len == 0 {
        return
    }
    let last = w.counts.len - 1
    if w.counts[last] > 0 {
        push(mut w.out, ',')
    }
    w.counts[last] += 1
    newline(w)
}

fn open_container(w: *Writer, c: u8) {
    separate(w)
    push(mut w.out, c)
    push(mut w.counts, 0)
}

fn close_container(w: *Writer, c: u8) {
    let had = w.counts[w.counts.len - 1] > 0
    truncate(mut w.counts, w.counts.len - 1)
    if had {
        newline(w)
    }
    push(mut w.out, c)
}

/// Opens an object with `{`.
pub fn start_object(w: *Writer) {
    open_container(w, '{')
}

/// Closes the innermost object with `}`.
pub fn end_object(w: *Writer) {
    close_container(w, '}')
}

/// Opens an array with `[`.
pub fn start_array(w: *Writer) {
    open_container(w, '[')
}

/// Closes the innermost array with `]`.
pub fn end_array(w: *Writer) {
    close_container(w, ']')
}

/// Writes the name of the next member of the current object. The value that follows is that member's value.
pub fn property(w: *Writer, name: str) {
    separate(w)
    quote(w, name)
    push(mut w.out, ':')
    if w.indent > 0 {
        push(mut w.out, ' ')
    }
    w.pending_name = true
}

/// Writes `s` as a JSON string.
pub fn string_value(w: *Writer, s: str) {
    separate(w)
    quote(w, s)
}

/// Writes `n` as a JSON number.
pub fn integer(w: *Writer, n: i64) {
    separate(w)
    text.append(mut w.out, "{n}")
}

/// Writes `n` as a JSON number.
pub fn unsigned(w: *Writer, n: u64) {
    separate(w)
    text.append(mut w.out, "{n}")
}

/// Writes `x` as a JSON number, or `null` when it is NaN or infinite, which JSON cannot represent.
pub fn float(w: *Writer, x: f64) {
    separate(w)
    if math.is_nan(x) || math.is_inf(x) {
        text.append(mut w.out, "null")
        return
    }
    text.append(mut w.out, "{x}")
}

/// Writes `true` or `false`.
pub fn boolean(w: *Writer, v: bool) {
    separate(w)
    text.append(mut w.out, if v { "true" } else { "false" })
}

/// Writes `null`.
pub fn null(w: *Writer) {
    separate(w)
    text.append(mut w.out, "null")
}

/// Writes `json` into the output as it is, in the place of a value.
///
/// The text is not checked or reindented, so it must be a complete valid JSON value.
pub fn raw(w: *Writer, json: str) {
    separate(w)
    text.append(mut w.out, json)
}

fn quote(w: *Writer, s: str) {
    push(mut w.out, '"')
    for i in 0..s.len {
        let c = s[i]
        if c == '"' || c == '\\' {
            push(mut w.out, '\\')
            push(mut w.out, c)
        } else if c == '\n' {
            text.append(mut w.out, "\\n")
        } else if c == '\r' {
            text.append(mut w.out, "\\r")
        } else if c == '\t' {
            text.append(mut w.out, "\\t")
        } else if c < 0x20 {
            text.append(mut w.out, "\\u")
            text.append_hex(mut w.out, i64(c), 4, false)
        } else {
            push(mut w.out, c)
        }
    }
    push(mut w.out, '"')
}
