import std/json/pointer
import std/regex
import std/text
import std/uri

fn alpha(c: u8) -> bool {
    c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z'
}

fn numeric(c: u8) -> bool {
    c >= '0' && c <= '9'
}

fn all_numeric(s: str) -> bool {
    for i in 0..s.len {
        if !numeric(s[i]) {
            return false
        }
    }
    true
}

fn number_of(s: str) -> i64 {
    text.parse_int(s) or 0
}

fn valid_format(name: str, s: str) -> bool {
    if name == "date-time" {
        return valid_date_time(s)
    }
    if name == "date" {
        return valid_date(s)
    }
    if name == "time" {
        return valid_time(s)
    }
    if name == "email" {
        return valid_email(s)
    }
    if name == "uuid" {
        return valid_uuid(s)
    }
    if name == "uri" {
        return valid_uri(s)
    }
    if name == "ipv4" {
        return valid_ipv4(s)
    }
    if name == "ipv6" {
        return valid_ipv6(s)
    }
    if name == "hostname" {
        return valid_hostname(s)
    }
    if name == "json-pointer" {
        return valid_pointer(s)
    }
    if name == "regex" {
        return valid_regex(s)
    }
    true
}

fn valid_pointer(s: str) -> bool {
    pointer.parse(s) or return false
    true
}

fn valid_regex(s: str) -> bool {
    regex.compile(s) or return false
    true
}

fn leap_year(year: i64) -> bool {
    year % 4 == 0 && (year % 100 != 0 || year % 400 == 0)
}

fn days_in_month(year: i64, month: i64) -> i64 {
    if month == 2 {
        return if leap_year(year) { 29 } else { 28 }
    }
    if month == 4 || month == 6 || month == 9 || month == 11 {
        return 30
    }
    31
}

fn valid_date(s: str) -> bool {
    if s.len != 10 || s[4] != '-' || s[7] != '-' {
        return false
    }
    let year = s[..4]
    let month = s[5..7]
    let day = s[8..]
    if !all_numeric(year) || !all_numeric(month) || !all_numeric(day) {
        return false
    }
    let m = number_of(month)
    let d = number_of(day)
    m >= 1 && m <= 12 && d >= 1 && d <= days_in_month(number_of(year), m)
}

fn valid_time(s: str) -> bool {
    if s.len < 9 || s[2] != ':' || s[5] != ':' {
        return false
    }
    let hour = s[..2]
    let minute = s[3..5]
    let second = s[6..8]
    if !all_numeric(hour) || !all_numeric(minute) || !all_numeric(second) {
        return false
    }
    let h = number_of(hour)
    let m = number_of(minute)
    let sec = number_of(second)
    if h > 23 || m > 59 || sec > 60 {
        return false
    }
    var i = 8
    if s[i] == '.' {
        i += 1
        let fraction = i
        for i < s.len && numeric(s[i]) {
            i += 1
        }
        if i == fraction {
            return false
        }
    }
    if i >= s.len {
        return false
    }
    let zone = s[i..]
    var shift = 0
    if zone == "Z" || zone == "z" {
        shift = 0
    } else if zone.len == 6 && (zone[0] == '+' || zone[0] == '-') && zone[3] == ':' && all_numeric(zone[1..3]) && all_numeric(zone[4..]) {
        let oh = number_of(zone[1..3])
        let om = number_of(zone[4..])
        if oh > 23 || om > 59 {
            return false
        }
        shift = oh * 60 + om
        if zone[0] == '-' {
            shift = -shift
        }
    } else {
        return false
    }
    if sec == 60 {
        let utc = ((h * 60 + m - shift) % 1440 + 1440) % 1440
        return utc == 23 * 60 + 59
    }
    true
}

fn valid_date_time(s: str) -> bool {
    if s.len < 11 {
        return false
    }
    let separator = s[10]
    if separator != 'T' && separator != 't' {
        return false
    }
    valid_date(s[..10]) && valid_time(s[11..])
}

fn valid_uuid(s: str) -> bool {
    if s.len != 36 {
        return false
    }
    for i in 0..s.len {
        if i == 8 || i == 13 || i == 18 || i == 23 {
            if s[i] != '-' {
                return false
            }
        } else if text.hex_digit(s[i]) < 0 {
            return false
        }
    }
    true
}

fn valid_ipv4(s: str) -> bool {
    let parts = text.split(s, '.')
    if parts.len != 4 {
        return false
    }
    for part in parts {
        if part.len == 0 || part.len > 3 || !all_numeric(part) {
            return false
        }
        if part.len > 1 && part[0] == '0' {
            return false
        }
        if number_of(part) > 255 {
            return false
        }
    }
    true
}

fn hex_group(s: str) -> bool {
    if s.len == 0 || s.len > 4 {
        return false
    }
    for i in 0..s.len {
        if text.hex_digit(s[i]) < 0 {
            return false
        }
    }
    true
}

fn ipv6_groups(part: str, last: bool) -> i64 {
    if part.len == 0 {
        return 0
    }
    let groups = text.split(part, ':')
    var count = 0
    for i, g in groups {
        if last && i == groups.len - 1 && text.contains(g, ".") {
            if !valid_ipv4(g) {
                return -1
            }
            count += 2
        } else if hex_group(g) {
            count += 1
        } else {
            return -1
        }
    }
    count
}

fn valid_ipv6(s: str) -> bool {
    let gap = text.index(s, "::")
    if gap < 0 {
        return ipv6_groups(s, true) == 8
    }
    let head = s[..gap]
    let tail = s[gap + 2..]
    if text.contains(tail, "::") {
        return false
    }
    let before = ipv6_groups(head, false)
    let after = ipv6_groups(tail, true)
    before >= 0 && after >= 0 && before + after <= 7
}

fn valid_hostname(s: str) -> bool {
    if s.len == 0 || s.len > 253 {
        return false
    }
    for label in text.split(s, '.') {
        if label.len == 0 || label.len > 63 {
            return false
        }
        if label[0] == '-' || label[label.len - 1] == '-' {
            return false
        }
        for i in 0..label.len {
            let c = label[i]
            if !(alpha(c) || numeric(c) || c == '-') {
                return false
            }
        }
    }
    true
}

fn atext(c: u8) -> bool {
    alpha(c) || numeric(c) || text.contains("!#$%&'*+/=?^_`{{|}}~-", text.from_char(u32(c)))
}

fn valid_local(s: str) -> bool {
    if s.len == 0 || s.len > 64 {
        return false
    }
    if s[0] == '"' {
        return valid_quoted(s)
    }
    for part in text.split(s, '.') {
        if part.len == 0 {
            return false
        }
        for i in 0..part.len {
            if !atext(part[i]) {
                return false
            }
        }
    }
    true
}

fn valid_quoted(s: str) -> bool {
    if s.len < 2 || s[s.len - 1] != '"' {
        return false
    }
    var i = 1
    for i < s.len - 1 {
        let c = s[i]
        if c == '\\' {
            i += 2
            continue
        }
        if c == '"' || c < 0x20 || c == 0x7F {
            return false
        }
        i += 1
    }
    i == s.len - 1
}

fn valid_domain(s: str) -> bool {
    if s.len > 2 && s[0] == '[' && s[s.len - 1] == ']' {
        let inner = s[1..s.len - 1]
        if text.starts_with(inner, "IPv6:") {
            return valid_ipv6(inner[5..])
        }
        return valid_ipv4(inner)
    }
    valid_hostname(s)
}

fn valid_email(s: str) -> bool {
    var at = -1
    if s.len > 0 && s[0] == '"' {
        var i = 1
        for i < s.len && s[i] != '"' {
            if s[i] == '\\' {
                i += 1
            }
            i += 1
        }
        if i + 1 < s.len && s[i + 1] == '@' {
            at = i + 1
        }
    } else {
        at = text.last_index_byte(s, '@')
    }
    if at <= 0 || at >= s.len - 1 {
        return false
    }
    valid_local(s[..at]) && valid_domain(s[at + 1..])
}

fn uri_char(c: u8) -> bool {
    alpha(c) || numeric(c) || text.contains("-._~:/?#[]@!$&'()*+,;=%", text.from_char(u32(c)))
}

fn valid_uri(s: str) -> bool {
    if uri.scheme_end(s) <= 0 {
        return false
    }
    var hashes = 0
    var i = 0
    for i < s.len {
        let c = s[i]
        if !uri_char(c) {
            return false
        }
        if c == '#' {
            hashes += 1
        }
        if c == '%' {
            if i + 2 >= s.len || text.hex_digit(s[i + 1]) < 0 || text.hex_digit(s[i + 2]) < 0 {
                return false
            }
            i += 2
        }
        i += 1
    }
    hashes <= 1
}
