import std/json

/// Parses a document into a `Value`, reads fields from it and builds a new document from members.
fn main() {
    let document = "{{\"name\": \"low\", \"version\": {{\"major\": 1, \"minor\": 4}}, \"authors\": [\"ada\", \"bob\"], \"stable\": true, \"ratio\": 0.5}}"
    let value = json.parse(bytes(document)) catch {
        Syntax(at, message) => {
            print("syntax error at byte {at}: {message}")
            return
        }
        _ => {
            print("unreadable")
            return
        }
    }

    let version = json.field(value, "version")
    print("name {json.text_of(value, "name")}")
    print("version {json.int_of(version, "major")}.{json.int_of(version, "minor")}")
    print("patch {json.field_int(version, "patch") ?? -1}")
    let second = json.at(json.field(value, "authors"), 1) ?? json.Value.Null
    match second {
        Str(author) => print("second author {author}")
        _ => print("no second author")
    }
    match json.field(value, "ratio") {
        Float(x) => print("ratio {x}")
        _ => print("ratio is not a float")
    }

    let release = json.object_value([
        json.text_member("name", json.text_of(value, "name")),
        json.int_member("major", json.int_of(version, "major") + 1),
        json.bool_member("stable", false),
        json.array_member("authors", [json.text_value("ada")]),
        json.object_member("build", [json.base64url_member("hash", [0xfb, 0xff])]),
    ])
    print(json.stringify(release, 0))
    print(json.stringify(release, 2))
    print(json.equal(release, value))
    print(json.equal(json.parse(bytes("[1, 2.0]")) or json.Value.Null, json.parse(bytes("[1.0, 2]")) or json.Value.Null))
}
