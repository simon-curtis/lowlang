import std/json
import std/serde

fn tally(data: []u8) -> i64 ! serde.Error {
    let r = json.reader(data)
    var total = 0
    var in_orders = false
    for json.read(r)? {
        if json.token(r) == PropertyName {
            let name = json.get_string(r)?
            if name == "orders" {
                in_orders = true
            } else if name == "total" && in_orders {
                json.read(r)?
                total += json.get_i64(r)?
            } else if name != "id" && name != "customer" {
                json.skip(r)?
            }
        }
    }
    total
}

/// Sums the `total` of every order in a document without building a tree, then writes a document with the streaming writer.
fn main() {
    let document = "{{\"shop\": \"corner\", \"meta\": {{\"total\": 999, \"tags\": [1, 2, 3]}}, \"orders\": [{{\"id\": 1, \"customer\": \"ada\", \"total\": 250, \"notes\": {{\"gift\": true}}}}, {{\"id\": 2, \"customer\": \"bob\", \"total\": 75}}]}}"
    let sum = tally(bytes(document)) catch {
        Syntax(at, message) => {
            print("syntax error at byte {at}: {message}")
            return
        }
        Mismatch(expected, at) => {
            print("expected {expected} at byte {at}")
            return
        }
        _ => {
            print("unreadable")
            return
        }
    }
    print("orders total {sum}")

    let w = json.writer(2)
    json.start_object(w)
    json.property(w, "customer")
    json.string_value(w, "ada \"the first\"")
    json.property(w, "lines")
    json.start_array(w)
    json.integer(w, 3)
    json.float(w, 2.5)
    json.boolean(w, true)
    json.null(w)
    json.end_array(w)
    json.property(w, "meta")
    json.raw(w, "{{\"packed\":[1,2]}}")
    json.end_object(w)
    print(json.written_text(w))

    let broken = tally(bytes("{{\"orders\": [{{\"total\": 1,}}]}}")) catch {
        Syntax(at, message) => {
            print("syntax error at byte {at}: {message}")
            return
        }
        _ => {
            print("unreadable")
            return
        }
    }
    print("orders total {broken}")
}
