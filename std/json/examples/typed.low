import std/json
import std/serde

enum Role {
    Admin
    Member(team: str)
}

struct Account {
    user_name: str
    login_count: i64
    role: Role
    nickname: str?
    tags: []str
    active: bool = true
}

fn problem(e: serde.Error) -> str {
    match e {
        Syntax(at, message) => "syntax error at byte {at}: {message}"
        Mismatch(expected, at) => "expected {expected} at byte {at}"
        Missing(field) => "missing field {field}"
        UnknownVariant(name) => "unknown variant {name}"
        Range(at) => "number out of range at byte {at}"
        TooDeep => "nested too deeply"
        TooLarge => "too large"
    }
}

fn decode(label: str, text: str) {
    let options = json.Options { naming: CamelCase }
    let account = json.deserialize_with[Account](bytes(text), options) catch {
        e => {
            print("{label}: {problem(e)}")
            return
        }
    }
    print("{label}: {account.user_name} logged in {account.login_count} times, {account.tags.len} tags, active={account.active}")
}

/// Round-trips a struct through JSON with camelCase member names and reports the errors of bad input.
fn main() {
    let account = Account {
        user_name: "ada",
        login_count: 42,
        role: Member("compilers"),
        nickname: none,
        tags: ["admin", "early"],
    }
    let options = json.Options { naming: CamelCase, indent: 2, omit_none: true }
    let text = json.serialize_with(account, options)
    print(text)
    print(json.serialize(Role.Admin))

    decode("round trip", text)
    decode("defaults", "{{\"userName\": \"bob\", \"loginCount\": 1, \"role\": \"Admin\", \"nickname\": null, \"tags\": [], \"extra\": [1, 2]}}")
    decode("missing", "{{\"userName\": \"bob\"}}")
    decode("wrong type", "{{\"userName\": 7}}")
    decode("unknown variant", "{{\"userName\": \"x\", \"loginCount\": 1, \"role\": \"Guest\", \"tags\": []}}")
    decode("truncated", "{{\"userName\": \"x\",")
}
