import std/json
import std/slices
import std/text

/// The error returned by the pointer functions (RFC 6901).
pub enum Error {
    /// The pointer text is malformed. `at` is the byte offset in the text where the problem is and `message` describes it.
    Syntax(at: i64, message: str)
    /// The pointer is well formed but the value it names does not exist: an object has no such member or an array no such index. `pointer` is the prefix of the pointer up to and including the token that failed.
    NotFound(pointer: str)
    /// A token does not suit the value it is applied to: the value is a string, number, boolean or `null`, or an array and the token is not an array index. `pointer` is the prefix up to and including the token.
    Mismatch(pointer: str)
    /// A removal named the whole document with the empty pointer.
    CannotRemoveRoot
}

enum Edit {
    Add
    Set
    Replace
    Remove
}

/// Returns `token` escaped for use in a pointer: `~` becomes `~0` and `/` becomes `~1`.
pub fn escape(token: str) -> str {
    token |> text.replace("~", "~0") |> text.replace("/", "~1")
}

/// Returns `token` with its `~0` and `~1` escapes decoded.
///
/// Fails with `Syntax` when a `~` is not followed by `0` or `1`.
pub fn unescape(token: str) -> str ! Error {
    unescape_at(token, 0)?
}

fn unescape_at(token: str, offset: i64) -> str ! Error {
    var out: []u8 = []
    var i = 0
    for i < token.len {
        let c = token[i]
        if c != '~' {
            push(mut out, c)
            i += 1
            continue
        }
        if i + 1 >= token.len {
            fail Syntax(offset + i, "~ must be followed by 0 or 1")
        }
        let next = token[i + 1]
        match next {
            '0' => push(mut out, '~')
            '1' => push(mut out, '/')
            _ => fail Syntax(offset + i, "~ must be followed by 0 or 1")
        }
        i += 2
    }
    str(out)
}

/// Splits `pointer` into its unescaped reference tokens.
///
/// The empty string is the whole document and has no tokens. Any other pointer starts with `/`, and each `/`-separated part is a token, so `/` is one empty token and `/a//b` has three. Fails with `Syntax` when the pointer does not start with `/` or a token has a bad escape.
pub fn parse(pointer: str) -> []str ! Error {
    var tokens: []str = []
    if pointer.len == 0 {
        return tokens
    }
    if pointer[0] != '/' {
        fail Syntax(0, "a pointer is empty or starts with /")
    }
    var offset = 1
    for raw in text.split(pointer[1..], '/') {
        let token = unescape_at(raw, offset)?
        push(mut tokens, token)
        offset += raw.len + 1
    }
    tokens
}

/// Returns the pointer for `tokens`, each escaped and preceded by `/`; no tokens give the empty string.
pub fn format(tokens: []str) -> str {
    var out: []u8 = []
    for token in tokens {
        text.append(mut out, "/")
        text.append(mut out, escape(token))
    }
    str(out)
}

fn array_index(token: str) -> i64? {
    if token.len == 0 || token.len > 18 {
        return none
    }
    if token.len > 1 && token[0] == '0' {
        return none
    }
    var n = 0
    for i in 0..token.len {
        let c = token[i]
        if c < '0' || c > '9' {
            return none
        }
        n = n * 10 + i64(c - '0')
    }
    n
}

fn member_index(members: []json.Member, name: str) -> i64 {
    for i, m in members {
        if m.name == name {
            return i
        }
    }
    -1
}

fn step(v: json.Value, token: str, at: str) -> json.Value ! Error {
    match v {
        Object(members) => {
            let i = member_index(members, token)
            if i < 0 {
                fail NotFound(at)
            }
            members[i].value
        }
        Array(items) => {
            let i = array_index(token) ?? fail Mismatch(at)
            if i >= items.len {
                fail NotFound(at)
            }
            items[i]
        }
        _ => fail Mismatch(at)
    }
}

/// Returns the value in `doc` that `pointer` names.
///
/// The empty pointer returns `doc`. An object member is found by name, using the first member of that name, and an array element by index: decimal digits with no leading zero, at most 18 of them. The `-` token never names an element when reading. Fails with `Syntax` for a malformed pointer, `NotFound` when a member or index does not exist and `Mismatch` when a token does not suit the value it is applied to.
pub fn get(doc: json.Value, pointer: str) -> json.Value ! Error {
    let tokens = parse(pointer)?
    var current = doc
    for i, token in tokens {
        let at = format(tokens[..i + 1])
        current = step(current, token, at)?
    }
    current
}

/// Returns whether `pointer` names a value in `doc`. It is `false` for a malformed pointer.
pub fn has(doc: json.Value, pointer: str) -> bool {
    get(doc, pointer) or return false
    true
}

/// Returns a copy of `doc` in which `pointer` names `value`.
///
/// On an object the member is replaced, or added at the end when it is missing. On an array an index below the length replaces that element, and an index equal to the length or `-` appends. The empty pointer returns `value`. The parent of the target must exist. `doc` is not changed, and the copy shares the parts that were not edited. Fails with `Syntax`, `NotFound` or `Mismatch` as `get` does.
pub fn set(doc: json.Value, pointer: str, value: json.Value) -> json.Value ! Error {
    edit(doc, pointer, Set, value)?
}

/// Returns a copy of `doc` with `value` added at `pointer`, as the RFC 6902 `add` operation does.
///
/// On an object the member is replaced when it exists and added at the end otherwise. On an array the value is inserted before the element at the index, which shifts the later elements, and an index equal to the length or `-` appends. The empty pointer returns `value`. The parent of the target must exist. `doc` is not changed. Fails with `Syntax`, `NotFound` or `Mismatch` as `get` does, and with `NotFound` for an array index past the length.
pub fn add(doc: json.Value, pointer: str, value: json.Value) -> json.Value ! Error {
    edit(doc, pointer, Add, value)?
}

/// Returns a copy of `doc` with the value at `pointer` replaced by `value`.
///
/// The target must exist and `-` never names an element. The empty pointer returns `value`. `doc` is not changed. Fails with `Syntax`, `NotFound` or `Mismatch` as `get` does.
pub fn replace(doc: json.Value, pointer: str, value: json.Value) -> json.Value ! Error {
    edit(doc, pointer, Replace, value)?
}

/// Returns a copy of `doc` without the value at `pointer`.
///
/// On an array the later elements move down. The target must exist and `-` never names an element. `doc` is not changed. Fails with `CannotRemoveRoot` for the empty pointer, and with `Syntax`, `NotFound` or `Mismatch` as `get` does.
pub fn remove(doc: json.Value, pointer: str) -> json.Value ! Error {
    edit(doc, pointer, Remove, json.Value.Null)?
}

fn edit(doc: json.Value, pointer: str, kind: Edit, value: json.Value) -> json.Value ! Error {
    let tokens = parse(pointer)?
    if tokens.len == 0 {
        if kind == Remove {
            fail CannotRemoveRoot
        }
        return value
    }
    update(doc, tokens, 0, kind, value)?
}

fn update(v: json.Value, tokens: []str, depth: i64, kind: Edit, value: json.Value) -> json.Value ! Error {
    let token = tokens[depth]
    let at = format(tokens[..depth + 1])
    if depth == tokens.len - 1 {
        return change(v, token, at, kind, value)?
    }
    match v {
        Object(members) => {
            let i = member_index(members, token)
            if i < 0 {
                fail NotFound(at)
            }
            let child = update(members[i].value, tokens, depth + 1, kind, value)?
            var out = slices.clone(members)
            out[i] = json.Member { name: token, value: child }
            json.Value.Object(out)
        }
        Array(items) => {
            let i = array_index(token) ?? fail Mismatch(at)
            if i >= items.len {
                fail NotFound(at)
            }
            let child = update(items[i], tokens, depth + 1, kind, value)?
            var out = slices.clone(items)
            out[i] = child
            json.Value.Array(out)
        }
        _ => fail Mismatch(at)
    }
}

fn change(v: json.Value, token: str, at: str, kind: Edit, value: json.Value) -> json.Value ! Error {
    match v {
        Object(members) => change_member(members, token, at, kind, value)?
        Array(items) => change_item(items, token, at, kind, value)?
        _ => fail Mismatch(at)
    }
}

fn change_member(members: []json.Member, token: str, at: str, kind: Edit, value: json.Value) -> json.Value ! Error {
    let i = member_index(members, token)
    var out = slices.clone(members)
    if kind == Remove {
        if i < 0 {
            fail NotFound(at)
        }
        slices.remove(mut out, i)
        return json.Value.Object(out)
    }
    let member = json.Member { name: token, value }
    if i >= 0 {
        out[i] = member
    } else if kind == Replace {
        fail NotFound(at)
    } else {
        push(mut out, member)
    }
    json.Value.Object(out)
}

fn change_item(items: []json.Value, token: str, at: str, kind: Edit, value: json.Value) -> json.Value ! Error {
    var out = slices.clone(items)
    if token == "-" {
        if kind == Add || kind == Set {
            push(mut out, value)
            return json.Value.Array(out)
        }
        fail NotFound(at)
    }
    let i = array_index(token) ?? fail Mismatch(at)
    if kind == Add {
        if i > items.len {
            fail NotFound(at)
        }
        slices.insert(mut out, i, value)
    } else if kind == Set && i == items.len {
        push(mut out, value)
    } else if i >= items.len {
        fail NotFound(at)
    } else if kind == Remove {
        slices.remove(mut out, i)
    } else {
        out[i] = value
    }
    json.Value.Array(out)
}

/// Returns the value that the relative pointer `reference` names, evaluated from the location `current` in `doc` (Relative JSON Pointer).
///
/// `reference` is a non-negative integer with no leading zero and at most nine digits, which says how many levels to go up from `current`, followed either by `#` or by a JSON pointer to follow from the level reached. With `#` the result is the key of that level as a `Str`, or its index as an `Int` when its parent is an array. Index offsets such as `1+1` are not supported. Fails with `Syntax` when the integer is missing or malformed, `NotFound` when it goes up past the root, and otherwise with the errors of `get`.
pub fn relative(doc: json.Value, current: str, reference: str) -> json.Value ! Error {
    var digits = 0
    for digits < reference.len && reference[digits] >= '0' && reference[digits] <= '9' {
        digits += 1
    }
    if digits == 0 || (digits > 1 && reference[0] == '0') || digits > 9 {
        fail Syntax(0, "a relative pointer starts with a non-negative integer")
    }
    let up = text.parse_int(reference[..digits]) or 0
    var tokens = parse(current)?
    if up > tokens.len {
        fail NotFound(current)
    }
    tokens = tokens[..tokens.len - up]
    let rest = reference[digits..]
    if rest == "#" {
        return key_of(doc, current, up)?
    }
    let base = format(tokens)
    get(doc, "{base}{rest}")?
}

fn key_of(doc: json.Value, current: str, up: i64) -> json.Value ! Error {
    let tokens = parse(current)?
    if up >= tokens.len {
        fail NotFound(current)
    }
    let owner = tokens[..tokens.len - up - 1]
    let key = tokens[tokens.len - up - 1]
    let parent = get(doc, format(owner))?
    match parent {
        Array(_) => json.Value.Int(array_index(key) ?? fail Mismatch(current))
        _ => json.Value.Str(key)
    }
}
