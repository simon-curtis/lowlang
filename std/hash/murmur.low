import std/bits
import std/io

fn fmix32(h: u32) -> u32 {
    var x = h
    x ^= x >> 16
    x *= 0x85EBCA6B
    x ^= x >> 13
    x *= 0xC2B2AE35
    x ^ x >> 16
}

fn fmix64(h: u64) -> u64 {
    var x = h
    x ^= x >> 33
    x *= 0xFF51AFD7ED558CCD
    x ^= x >> 33
    x *= 0xC4CEB9FE1A85EC53
    x ^ x >> 33
}

/// An incremental MurmurHash3 x86 32-bit state.
pub struct Murmur32 {
    h: u32
    buf: []u8
    held: i64
    total: i64
}

/// Returns a MurmurHash3 x86_32 state with the given `seed`.
pub fn murmur32_new(seed: u32) -> *Murmur32 {
    new(Murmur32 { h: seed, buf: __make(4), held: 0, total: 0 })
}

fn murmur32_mix(k: u32) -> u32 {
    bits.rotl32(k * 0xCC9E2D51, 15) * 0x1B873593
}

fn murmur32_block(m: *Murmur32, k: u32) {
    m.h = bits.rotl32(m.h ^ murmur32_mix(k), 13) * 5 + 0xE6546B64
}

/// Feeds `data` into the state `m`.
///
/// Input is processed in little-endian 4-byte blocks and a partial block is held until more data arrives, so splitting the input across calls does not change the hash.
pub fn murmur32_update(m: *Murmur32, data: []u8) {
    m.total += data.len
    var at = 0
    if m.held > 0 {
        let n = __memmove(m.buf[m.held..], data)
        m.held += n
        at = n
        if m.held < 4 {
            return
        }
        murmur32_block(m, io.u32_le(m.buf, 0))
        m.held = 0
    }
    for at + 4 <= data.len {
        murmur32_block(m, io.u32_le(data, at))
        at += 4
    }
    m.held = __memmove(m.buf, data[at..])
}

/// Returns the MurmurHash3 x86_32 hash of everything fed to `m` so far.
///
/// The state is not consumed; more data can be fed afterwards.
pub fn murmur32_sum(m: *Murmur32) -> u32 {
    var h = m.h
    var k: u32 = 0
    for i in 0..m.held {
        k |= u32(m.buf[i]) << u32(8 * i)
    }
    if m.held > 0 {
        h ^= murmur32_mix(k)
    }
    fmix32(h ^ u32(m.total))
}

/// Returns the MurmurHash3 x86_32 hash of `data` with the given `seed`.
///
/// MurmurHash3 is not cryptographic and is not keyed against adversarial input.
pub fn murmur3_32(data: []u8, seed: u32) -> u32 {
    let m = murmur32_new(seed)
    murmur32_update(m, data)
    murmur32_sum(m)
}

/// An incremental MurmurHash3 x64 128-bit state.
pub struct Murmur128 {
    h1: u64
    h2: u64
    buf: []u8
    held: i64
    total: i64
}

/// Returns a MurmurHash3 x64_128 state with the given 32-bit `seed`.
pub fn murmur128_new(seed: u32) -> *Murmur128 {
    new(Murmur128 { h1: u64(seed), h2: u64(seed), buf: __make(16), held: 0, total: 0 })
}

fn murmur128_mix1(k: u64) -> u64 {
    bits.rotl64(k * 0x87C37B91114253D5, 31) * 0x4CF5AD432745937F
}

fn murmur128_mix2(k: u64) -> u64 {
    bits.rotl64(k * 0x4CF5AD432745937F, 33) * 0x87C37B91114253D5
}

fn murmur128_block(m: *Murmur128, b: []u8, at: i64) {
    var h1 = m.h1
    var h2 = m.h2
    h1 = bits.rotl64(h1 ^ murmur128_mix1(io.u64_le(b, at)), 27)
    h1 = (h1 + h2) * 5 + 0x52DCE729
    h2 = bits.rotl64(h2 ^ murmur128_mix2(io.u64_le(b, at + 8)), 31)
    h2 = (h2 + h1) * 5 + 0x38495AB5
    m.h1 = h1
    m.h2 = h2
}

/// Feeds `data` into the state `m`.
///
/// Input is processed in little-endian 16-byte blocks and a partial block is held until more data arrives, so splitting the input across calls does not change the hash.
pub fn murmur128_update(m: *Murmur128, data: []u8) {
    m.total += data.len
    var at = 0
    if m.held > 0 {
        let n = __memmove(m.buf[m.held..], data)
        m.held += n
        at = n
        if m.held < 16 {
            return
        }
        murmur128_block(m, m.buf, 0)
        m.held = 0
    }
    for at + 16 <= data.len {
        murmur128_block(m, data, at)
        at += 16
    }
    m.held = __memmove(m.buf, data[at..])
}

fn murmur128_tail(m: *Murmur128, from: i64, to: i64) -> u64 {
    var k: u64 = 0
    var i = from
    for i < to && i < m.held {
        k |= u64(m.buf[i]) << u64(8 * (i - from))
        i += 1
    }
    k
}

/// Returns the MurmurHash3 x64_128 hash of everything fed to `m` so far.
///
/// The state is not consumed. `lo` holds the first 64 bits (`h1`) and `hi` the second (`h2`).
pub fn murmur128_sum(m: *Murmur128) -> Hash128 {
    var h1 = m.h1
    var h2 = m.h2
    if m.held > 8 {
        h2 ^= murmur128_mix2(murmur128_tail(m, 8, 16))
    }
    if m.held > 0 {
        h1 ^= murmur128_mix1(murmur128_tail(m, 0, 8))
    }
    let n = u64(m.total)
    h1 ^= n
    h2 ^= n
    h1 += h2
    h2 += h1
    h1 = fmix64(h1)
    h2 = fmix64(h2)
    h1 += h2
    h2 += h1
    Hash128 { lo: h1, hi: h2 }
}

/// Returns the MurmurHash3 x64_128 hash of `data` with the given 32-bit `seed`.
///
/// MurmurHash3 is not cryptographic and is not keyed against adversarial input.
pub fn murmur3_128(data: []u8, seed: u32) -> Hash128 {
    let m = murmur128_new(seed)
    murmur128_update(m, data)
    murmur128_sum(m)
}
