import std/io

fn wy_secret(i: i64) -> u64 {
    let secret: []u64 = [0x2D358DCCAA6C78A5, 0x8BB84B93962EACC9, 0x4B33A62ED433D4A3, 0x4D5A2DA51DE1AA47]
    secret[i]
}

fn wy_mix(a: u64, b: u64) -> u64 {
    __mulhi(a, b) ^ a * b
}

fn wy_read3(b: []u8, at: i64, n: i64) -> u64 {
    u64(b[at]) << 16 | u64(b[at + (n >> 1)]) << 8 | u64(b[at + n - 1])
}

/// Returns the 64-bit wyhash (final version 4 constants) of `data` with the given `seed`.
///
/// wyhash is fast and non-cryptographic and the seed is not a secret key.
pub fn wyhash(data: []u8, seed: u64) -> u64 {
    let len = data.len
    var s = seed ^ wy_mix(seed ^ wy_secret(0), wy_secret(1))
    var a: u64 = 0
    var b: u64 = 0
    var at = 0
    if len <= 16 {
        if len >= 4 {
            let far = len >> 3 << 2
            a = u64(io.u32_le(data, 0)) << 32 | u64(io.u32_le(data, far))
            b = u64(io.u32_le(data, len - 4)) << 32 | u64(io.u32_le(data, len - 4 - far))
        } else if len > 0 {
            a = wy_read3(data, 0, len)
        }
    } else {
        var left = len
        if left > 48 {
            var s1 = s
            var s2 = s
            for left > 48 {
                s = wy_mix(io.u64_le(data, at) ^ wy_secret(1), io.u64_le(data, at + 8) ^ s)
                s1 = wy_mix(io.u64_le(data, at + 16) ^ wy_secret(2), io.u64_le(data, at + 24) ^ s1)
                s2 = wy_mix(io.u64_le(data, at + 32) ^ wy_secret(3), io.u64_le(data, at + 40) ^ s2)
                at += 48
                left -= 48
            }
            s ^= s1 ^ s2
        }
        for left > 16 {
            s = wy_mix(io.u64_le(data, at) ^ wy_secret(1), io.u64_le(data, at + 8) ^ s)
            left -= 16
            at += 16
        }
        a = io.u64_le(data, at + left - 16)
        b = io.u64_le(data, at + left - 8)
    }
    a ^= wy_secret(1)
    b ^= s
    let lo = a * b
    let hi = __mulhi(a, b)
    wy_mix(lo ^ wy_secret(0) ^ u64(len), hi ^ wy_secret(1))
}
