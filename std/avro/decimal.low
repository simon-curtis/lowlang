import std/big
import std/text

/// Returns the decimal text of the number whose unscaled value is the big-endian two's complement `unscaled` and whose scale is `scale`.
///
/// `scale` digits follow the decimal point, so `[0x04, 0xD2]` with scale `2` is `12.34`. An empty `unscaled` is zero. A negative scale appends zeros.
pub fn decimal_text(unscaled: u8[], scale: i64) -> str {
    var negative = false
    var magnitude = big.zero()
    if unscaled.len > 0 {
        magnitude = big.from_bytes(unscaled)
        if unscaled[0] >= 0x80 {
            negative = true
            let top = big.shl(big.one(), 8 * unscaled.len)
            magnitude = big.sub(top, magnitude)
        }
    }
    var digits = big.to_str(magnitude, 10)
    if scale < 0 {
        digits = "{digits}{text.repeat("0", -scale)}"
    } else if scale > 0 {
        if digits.len <= scale {
            digits = "{text.repeat("0", scale - digits.len + 1)}{digits}"
        }
        let point = digits.len - scale
        digits = "{digits[..point]}.{digits[point..]}"
    }
    if negative {
        return "-{digits}"
    }
    digits
}

/// Returns the big-endian two's complement unscaled value of the decimal `source` at `scale`, in `size` bytes, or in as few bytes as hold it when `size` is `0`.
///
/// `source` is an optional `-` or `+`, digits, and optionally a point and digits; a fraction shorter than `scale` is padded with zeros. Fails with `Mismatch` when `source` is not a number, has more fraction digits than `scale`, or does not fit `size` bytes.
pub fn decimal_unscaled(source: str, scale: i64, size: i64) -> u8[] ! Error {
    var body = source
    var negative = false
    if body.len > 0 && (body[0] == '-' || body[0] == '+') {
        negative = body[0] == '-'
        body = body[1..]
    }
    var whole = body
    var fraction = ""
    let point = text.index_byte(body, '.')
    if point >= 0 {
        whole = body[..point]
        fraction = body[point + 1..]
    }
    if whole.len + fraction.len == 0 || !text.is_digits("{whole}{fraction}") {
        fail Mismatch("{text.quote(source)} is not a decimal number")
    }
    if fraction.len > scale {
        fail Mismatch("{text.quote(source)} has more than {scale} fraction digits")
    }
    let padded = "{whole}{fraction}{text.repeat("0", scale - fraction.len)}"
    let magnitude = big.parse(padded, 10) catch {
        _ => fail Mismatch("{text.quote(source)} is not a decimal number")
    }
    twos_complement(magnitude, negative, size)?
}

fn twos_complement(magnitude: big.Int, negative: bool, size: i64) -> u8[] ! Error {
    var width = size
    if width == 0 {
        var bits = big.bit_len(magnitude)
        if negative && !big.is_zero(magnitude) {
            bits = big.bit_len(big.sub(magnitude, big.one()))
        }
        width = (bits + 8) / 8
    }
    if !negative || big.is_zero(magnitude) {
        return big.to_bytes_sized(magnitude, width) catch {
            _ => fail Mismatch("the number does not fit {width} bytes")
        }
    }
    let limit = big.shl(big.one(), 8 * width - 1)
    if big.cmp(magnitude, limit) > 0 {
        fail Mismatch("the number does not fit {width} bytes")
    }
    let wrapped = big.sub(big.shl(big.one(), 8 * width), magnitude)
    big.to_bytes_sized(wrapped, width) catch {
        _ => fail Mismatch("the number does not fit {width} bytes")
    }
}
