{
  "type": "record",
  "name": "Reading",
  "namespace": "sensors",
  "fields": [
    {"name": "sensor", "type": "string"},
    {"name": "temperature", "type": "double", "aliases": ["celsius"]},
    {"name": "at", "type": {"type": "long", "logicalType": "timestamp-millis"}},
    {"name": "unit", "type": "string", "default": "C"}
  ]
}
