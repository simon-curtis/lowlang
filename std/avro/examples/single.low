import std/avro
import std/text

fn field(name: str, value: avro.Value) -> avro.Member {
    avro.Member { name, value }
}

fn run() ! avro.Error {
    let v1 = avro.parse(embed("reading.avsc"))?
    let v2 = avro.parse(embed("reading_v2.avsc"))?
    let store = avro.schema_store()
    let first = avro.register(store, v1)
    let second = avro.register(store, v2)
    print("v1 {avro.canonical(v1)}")
    print("fingerprints differ {first != second}")

    let reading = avro.Value.Record([
        field("sensor", avro.Value.Str("roof")),
        field("celsius", avro.Value.Float(21.5)),
        field("at", avro.Value.TimestampMillis(1700000000000)),
        field("note", avro.Value.Union(0, new(avro.Value.Null))),
    ])
    let message = avro.encode_single(v1, reading)?
    print("message {text.encode_hex(message)}")
    print("names the first schema {avro.single_fingerprint(message)? == first}")

    let same = avro.decode_single(store, message)?
    print(avro.diagnostic(same))
    let upgraded = avro.decode_single_resolved(store, v2, message)?
    print(avro.diagnostic(upgraded))

    let empty = avro.schema_store()
    let unknown = avro.decode_single(empty, message) catch {
        e => {
            print("without the schema: {avro.message(e)}")
            return
        }
    }
    print(avro.diagnostic(unknown))
}

fn main() {
    run() catch {
        e => print("error: {avro.message(e)}")
    }
}
