import std/avro
import std/io
import std/text

struct Reading {
    sensor: str
    celsius: f64
    at: i64
    note: str?
}

fn sync_marker() -> []u8 {
    var marker: []u8 = []
    for i in 0..16 {
        push(mut marker, u8(i))
    }
    marker
}

fn write_file(schema: *avro.Schema, readings: []Reading) -> []u8 ! avro.Error {
    var file: []u8 = []
    let sink: fn([]u8) ! io.Error = fn(chunk) { io.append(mut file, chunk) }
    let options = avro.WriterOptions { codec: avro.Codec.Deflate, sync: sync_marker() }
    let w = avro.file_writer(schema, sink, options)?
    for r in readings {
        avro.write_value(w, r)?
    }
    avro.finish(w)?
    file
}

fn run() ! avro.Error {
    let schema = avro.parse(embed("reading.avsc"))?
    let readings = [
        Reading { sensor: "roof", celsius: 21.5, at: 1700000000000, note: none },
        Reading { sensor: "cellar", celsius: 11.25, at: 1700000060000, note: some("damp") },
    ]
    let file = write_file(schema, readings)?
    print("file {file.len} bytes, schema {text.encode_hex(avro.fingerprint_md5(schema))}")

    let typed = avro.open_bytes(file, avro.ReaderOptions {})?
    let back = avro.read_values[Reading](typed) catch {
        _ => fail avro.Error.Invalid(0, "the file does not hold Reading values")
    }
    for r in back {
        print("{r.sensor} {r.celsius} {r.at} {r.note ?? "-"}")
    }

    let newer = avro.parse(embed("reading_v2.avsc"))?
    let options = avro.ReaderOptions { reader_schema: some(newer) }
    let evolved = avro.open_bytes(file, options)?
    for v in avro.read_all(evolved)? {
        print(avro.diagnostic(v))
    }
}

fn main() {
    run() catch {
        e => print("error: {avro.message(e)}")
    }
}
