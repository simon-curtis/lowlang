import digest = std/crypto/hash
import std/crypto/md5
import std/json
import std/text

fn quoted(s: str) -> str {
    json.stringify(json.Value.Str(s), 0)
}

fn canonical_into(mut out: u8[], s: *Schema, seen: [str: bool]) {
    match s.kind {
        Record => {
            if seen[s.name] != none {
                text.append(mut out, quoted(s.name))
                return
            }
            seen[s.name] = true
            text.append(mut out, "{{\"name\":{quoted(s.name)},\"type\":\"record\",\"fields\":[")
            for i, f in s.fields {
                if i > 0 {
                    out.push(',')
                }
                text.append(mut out, "{{\"name\":{quoted(f.name)},\"type\":")
                canonical_into(mut out, f.schema, seen)
                out.push('}')
            }
            text.append(mut out, "]}}")
        }
        Enum => {
            if seen[s.name] != none {
                text.append(mut out, quoted(s.name))
                return
            }
            seen[s.name] = true
            text.append(mut out, "{{\"name\":{quoted(s.name)},\"type\":\"enum\",\"symbols\":[")
            for i, sym in s.symbols {
                if i > 0 {
                    out.push(',')
                }
                text.append(mut out, quoted(sym))
            }
            text.append(mut out, "]}}")
        }
        Fixed => {
            if seen[s.name] != none {
                text.append(mut out, quoted(s.name))
                return
            }
            seen[s.name] = true
            text.append(mut out, "{{\"name\":{quoted(s.name)},\"type\":\"fixed\",\"size\":{s.size}}}")
        }
        Array => {
            text.append(mut out, "{{\"type\":\"array\",\"items\":")
            canonical_into(mut out, s.item ?? s, seen)
            out.push('}')
        }
        Map => {
            text.append(mut out, "{{\"type\":\"map\",\"values\":")
            canonical_into(mut out, s.item ?? s, seen)
            out.push('}')
        }
        Union => {
            out.push('[')
            for i, b in s.branches {
                if i > 0 {
                    out.push(',')
                }
                canonical_into(mut out, b, seen)
            }
            out.push(']')
        }
        _ => text.append(mut out, "\"{kind_name(s.kind)}\"")
    }
}

/// Returns the Parsing Canonical Form of `s`.
///
/// It is the schema JSON with only the attributes that affect parsing: `name`, `type`, `fields`, `symbols`, `items`, `values` and `size`, in that order, names fully qualified, no whitespace, and primitive types as bare strings. A named type met again is written as its name. Logical types, aliases, documentation and defaults are left out.
pub fn canonical(s: *Schema) -> str {
    var out: u8[] = []
    let seen: [str: bool] = [:]
    canonical_into(mut out, s, seen)
    str(out)
}

fn rabin_table() -> u64[] {
    let empty: u64 = 0xc15d213aa4d7a795
    var table: u64[] = []
    for i in 0..256 {
        var fp = u64(i)
        for _ in 0..8 {
            let mask: u64 = 0 - (fp & 1)
            fp = fp >> 1 ^ empty & mask
        }
        table.push(fp)
    }
    table
}

/// Returns the 64-bit Rabin fingerprint, CRC-64-AVRO, of `data`.
///
/// `fingerprint` applies it to the canonical form of a schema.
fn rabin(data: u8[]) -> u64 {
    let table = rabin_table()
    var fp: u64 = 0xc15d213aa4d7a795
    for b in data {
        fp = fp >> 8 ^ table[i64((fp ^ u64(b)) & 0xFF)]
    }
    fp
}

/// Returns the CRC-64-AVRO fingerprint of the canonical form of `s`, which single-object encoding stores.
pub fn fingerprint(s: *Schema) -> u64 {
    rabin(bytes(canonical(s)))
}

/// Returns the SHA-256 digest of the canonical form of `s`, 32 bytes.
pub fn fingerprint_sha256(s: *Schema) -> u8[] {
    digest.sum(digest.sha256(), bytes(canonical(s)))
}

/// Returns the MD5 digest of the canonical form of `s`, 16 bytes.
pub fn fingerprint_md5(s: *Schema) -> u8[] {
    md5.sum(bytes(canonical(s)))
}

fn logical_json(mut out: u8[], l: Logical) {
    match l {
        Plain => {}
        Decimal(precision, scale) => text.append(mut out, ",\"logicalType\":\"decimal\",\"precision\":{precision},\"scale\":{scale}")
        Uuid => text.append(mut out, ",\"logicalType\":\"uuid\"")
        Date => text.append(mut out, ",\"logicalType\":\"date\"")
        TimeMillis => text.append(mut out, ",\"logicalType\":\"time-millis\"")
        TimeMicros => text.append(mut out, ",\"logicalType\":\"time-micros\"")
        TimestampMillis => text.append(mut out, ",\"logicalType\":\"timestamp-millis\"")
        TimestampMicros => text.append(mut out, ",\"logicalType\":\"timestamp-micros\"")
        TimestampNanos => text.append(mut out, ",\"logicalType\":\"timestamp-nanos\"")
        LocalTimestampMillis => text.append(mut out, ",\"logicalType\":\"local-timestamp-millis\"")
        LocalTimestampMicros => text.append(mut out, ",\"logicalType\":\"local-timestamp-micros\"")
        LocalTimestampNanos => text.append(mut out, ",\"logicalType\":\"local-timestamp-nanos\"")
        Duration => text.append(mut out, ",\"logicalType\":\"duration\"")
    }
}

fn aliases_json(mut out: u8[], aliases: str[]) {
    if aliases.len == 0 {
        return
    }
    text.append(mut out, ",\"aliases\":[")
    for i, a in aliases {
        if i > 0 {
            out.push(',')
        }
        text.append(mut out, quoted(a))
    }
    out.push(']')
}

fn doc_json(mut out: u8[], doc: str) {
    if doc.len > 0 {
        text.append(mut out, ",\"doc\":{quoted(doc)}")
    }
}

fn full_json(mut out: u8[], s: *Schema, seen: [str: bool]) {
    match s.kind {
        Record => {
            if seen[s.name] != none {
                text.append(mut out, quoted(s.name))
                return
            }
            seen[s.name] = true
            text.append(mut out, "{{\"type\":\"record\",\"name\":{quoted(short_name(s.name))},\"namespace\":{quoted(namespace_of(s.name))}")
            doc_json(mut out, s.doc)
            aliases_json(mut out, s.aliases)
            text.append(mut out, ",\"fields\":[")
            for i, f in s.fields {
                if i > 0 {
                    out.push(',')
                }
                text.append(mut out, "{{\"name\":{quoted(f.name)}")
                doc_json(mut out, f.doc)
                aliases_json(mut out, f.aliases)
                text.append(mut out, ",\"type\":")
                full_json(mut out, f.schema, seen)
                match f.default {
                    some(d) => text.append(mut out, ",\"default\":{json.stringify(d, 0)}")
                    none => {}
                }
                out.push('}')
            }
            text.append(mut out, "]}}")
        }
        Enum => {
            if seen[s.name] != none {
                text.append(mut out, quoted(s.name))
                return
            }
            seen[s.name] = true
            text.append(mut out, "{{\"type\":\"enum\",\"name\":{quoted(short_name(s.name))},\"namespace\":{quoted(namespace_of(s.name))}")
            doc_json(mut out, s.doc)
            aliases_json(mut out, s.aliases)
            text.append(mut out, ",\"symbols\":[")
            for i, sym in s.symbols {
                if i > 0 {
                    out.push(',')
                }
                text.append(mut out, quoted(sym))
            }
            out.push(']')
            match s.default_symbol {
                some(d) => text.append(mut out, ",\"default\":{quoted(d)}")
                none => {}
            }
            out.push('}')
        }
        Fixed => {
            if seen[s.name] != none {
                text.append(mut out, quoted(s.name))
                return
            }
            seen[s.name] = true
            text.append(mut out, "{{\"type\":\"fixed\",\"name\":{quoted(short_name(s.name))},\"namespace\":{quoted(namespace_of(s.name))}")
            aliases_json(mut out, s.aliases)
            text.append(mut out, ",\"size\":{s.size}")
            logical_json(mut out, s.logical)
            out.push('}')
        }
        Array => {
            text.append(mut out, "{{\"type\":\"array\",\"items\":")
            full_json(mut out, s.item ?? s, seen)
            out.push('}')
        }
        Map => {
            text.append(mut out, "{{\"type\":\"map\",\"values\":")
            full_json(mut out, s.item ?? s, seen)
            out.push('}')
        }
        Union => {
            out.push('[')
            for i, b in s.branches {
                if i > 0 {
                    out.push(',')
                }
                full_json(mut out, b, seen)
            }
            out.push(']')
        }
        _ => {
            if s.logical == Logical.Plain {
                text.append(mut out, "\"{kind_name(s.kind)}\"")
            } else {
                text.append(mut out, "{{\"type\":\"{kind_name(s.kind)}\"")
                logical_json(mut out, s.logical)
                out.push('}')
            }
        }
    }
}

/// Returns `s` as schema JSON, keeping names, aliases, documentation, defaults, enum defaults and logical types.
///
/// A named type met again is written as its name. `parse` reads the result back into an equivalent schema.
pub fn to_json(s: *Schema) -> str {
    var out: u8[] = []
    let seen: [str: bool] = [:]
    full_json(mut out, s, seen)
    str(out)
}
