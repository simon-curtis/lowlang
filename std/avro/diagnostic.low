import std/json
import std/text

fn quote_text(s: str) -> str {
    json.stringify(json.Value.Str(s), 0)
}

/// Returns `v` as one line of text for tests and logs.
///
/// `null`, booleans and integers are written as themselves, a float as `f` and the 16 hexadecimal digits of its IEEE 754 bits, a string as a JSON string, `bytes` as `x"` and hexadecimal, an enum as its symbol in quotes, an array as `[a, b]`, and a map or record as `{"key": value}`. A union is the value of its branch, a decimal is `decimal(` and its text, and each other logical value is its name, a colon and its integer, such as `date:19000`; a UUID is `uuid:` and its text and a duration `duration:` and its three numbers.
pub fn diagnostic(v: Value) -> str {
    var out: []u8 = []
    write_diagnostic(mut out, v)
    str(out)
}

fn hex_u64(bits: u64) -> str {
    var digits: []u8 = []
    for i in 0..8 {
        push(mut digits, u8((bits >> u64(56 - 8 * i)) & 0xFF))
    }
    text.encode_hex(digits)
}

fn write_diagnostic(mut out: []u8, v: Value) {
    match v {
        Null => text.append(mut out, "null")
        Bool(b) => text.append(mut out, if b { "true" } else { "false" })
        Int(n) => text.append(mut out, "{n}")
        Float(x) => text.append(mut out, "f{hex_u64(text.float_bits(x))}")
        Bytes(data) => text.append(mut out, "x\"{text.encode_hex(data)}\"")
        Str(s) => text.append(mut out, quote_text(s))
        Enum(_, symbol) => text.append(mut out, quote_text(symbol))
        Array(items) => {
            push(mut out, '[')
            for i, item in items {
                if i > 0 {
                    text.append(mut out, ", ")
                }
                write_diagnostic(mut out, item)
            }
            push(mut out, ']')
        }
        Map(entries) => {
            push(mut out, '{')
            for i, e in entries {
                if i > 0 {
                    text.append(mut out, ", ")
                }
                text.append(mut out, "{quote_text(e.key)}: ")
                write_diagnostic(mut out, e.value)
            }
            push(mut out, '}')
        }
        Record(members) => {
            push(mut out, '{')
            for i, m in members {
                if i > 0 {
                    text.append(mut out, ", ")
                }
                text.append(mut out, "{quote_text(m.name)}: ")
                write_diagnostic(mut out, m.value)
            }
            push(mut out, '}')
        }
        Union(_, inner) => write_diagnostic(mut out, *inner)
        Decimal(unscaled, scale) => text.append(mut out, "decimal({decimal_text(unscaled, scale)})")
        Uuid(t) => text.append(mut out, "uuid:{t}")
        Date(n) => text.append(mut out, "date:{n}")
        TimeMillis(n) => text.append(mut out, "time-millis:{n}")
        TimeMicros(n) => text.append(mut out, "time-micros:{n}")
        TimestampMillis(n) => text.append(mut out, "timestamp-millis:{n}")
        TimestampMicros(n) => text.append(mut out, "timestamp-micros:{n}")
        TimestampNanos(n) => text.append(mut out, "timestamp-nanos:{n}")
        LocalTimestampMillis(n) => text.append(mut out, "local-timestamp-millis:{n}")
        LocalTimestampMicros(n) => text.append(mut out, "local-timestamp-micros:{n}")
        LocalTimestampNanos(n) => text.append(mut out, "local-timestamp-nanos:{n}")
        Duration(months, days, millis) => text.append(mut out, "duration:{months},{days},{millis}")
    }
}
