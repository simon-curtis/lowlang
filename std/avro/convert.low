import std/serde

fn leaf(tree: serde.Tree) -> serde.Shape[Value] {
    serde.Shape.Leaf(tree, 0)
}

fn shape(v: Value) -> serde.Shape[Value] {
    match v {
        Null => leaf(serde.Tree.Null)
        Bool(b) => leaf(serde.Tree.Bool(b))
        Int(n) => leaf(serde.Tree.Int(n))
        Float(x) => leaf(serde.Tree.Float(x))
        Bytes(data) => leaf(serde.Tree.Binary(data))
        Str(s) => leaf(serde.Tree.Text(s))
        Enum(_, symbol) => leaf(serde.Tree.Text(symbol))
        Array(items) => serde.Shape.Sequence(items, 0)
        Map(entries) => {
            var keys: Value[] = []
            var values: Value[] = []
            for e in entries {
                keys.push(Value.Str(e.key))
                values.push(e.value)
            }
            serde.Shape.Mapping(keys, values, 0)
        }
        Record(members) => {
            var keys: Value[] = []
            var values: Value[] = []
            for m in members {
                keys.push(Value.Str(m.name))
                values.push(m.value)
            }
            serde.Shape.Mapping(keys, values, 0)
        }
        Union(_, inner) => shape(*inner)
        Decimal(unscaled, scale) => leaf(serde.Tree.Text(decimal_text(unscaled, scale)))
        Uuid(t) => leaf(serde.Tree.Text(t))
        Date(n) => leaf(serde.Tree.Int(n))
        TimeMillis(n) => leaf(serde.Tree.Int(n))
        TimeMicros(n) => leaf(serde.Tree.Int(n))
        TimestampMillis(n) => leaf(serde.Tree.Int(n))
        TimestampMicros(n) => leaf(serde.Tree.Int(n))
        TimestampNanos(n) => leaf(serde.Tree.Int(n))
        LocalTimestampMillis(n) => leaf(serde.Tree.Int(n))
        LocalTimestampMicros(n) => leaf(serde.Tree.Int(n))
        LocalTimestampNanos(n) => leaf(serde.Tree.Int(n))
        Duration(months, days, millis) => {
            let keys = [Value.Str("months"), Value.Str("days"), Value.Str("millis")]
            let values = [Value.Int(months), Value.Int(days), Value.Int(millis)]
            serde.Shape.Mapping(keys, values, 0)
        }
    }
}

/// Converts the datum `v` into a `T` through `std/serde`.
///
/// A record is read as a struct by field name, an array as a slice, a map as a map, a union as the value of its branch (so a `null` branch is a `none` optional), an enum as its symbol, `bytes` and `fixed` as `u8[]`, and a `string` as `str`. A decimal is read as its decimal text, a UUID as its text, a date, time or timestamp as its integer, and a duration as a struct of `months`, `days` and `millis`. Fails with `serde.Error.Mismatch` when a value has another type, with `Range`, `Missing` and `UnknownVariant` as `serde.read` describes, and with `Syntax` when the value has nothing to read.
pub fn from_value[T](v: Value) -> T ! serde.Error {
    let root = serde.node_of(v, shape)
    serde.read(serde.tree_reader(root, false))
}

fn tree_kind(t: serde.Tree) -> str {
    match t {
        Null => "null"
        Bool(_) => "boolean"
        Int(_) => "integer"
        Uint(_) => "integer"
        Float(_) => "number"
        Text(_) => "string"
        Binary(_) => "bytes"
        Seq(_) => "sequence"
        Map(_) => "map"
        Overflow => "integer"
        Opaque => "opaque value"
    }
}

fn mismatch(s: *Schema, t: serde.Tree) -> Error {
    Mismatch("expected {kind_name(s.kind)}, found {tree_kind(t)}")
}

fn from_node(s: *Schema, node: serde.Node, depth: i64) -> Value ! Error {
    if depth > 256 {
        fail Mismatch("the value nests too deeply")
    }
    let tree = node.tree
    match s.kind {
        Null => {
            match tree {
                Null => Value.Null
                _ => fail mismatch(s, tree)
            }
        }
        Bool => {
            match tree {
                Bool(b) => Value.Bool(b)
                _ => fail mismatch(s, tree)
            }
        }
        Int => {
            match tree {
                Int(n) => {
                    if n < -2147483648 || n > 2147483647 {
                        fail Mismatch("{n} does not fit an int")
                    }
                    apply_logical(s, Value.Int(n))
                }
                _ => fail mismatch(s, tree)
            }
        }
        Long => {
            match tree {
                Int(n) => apply_logical(s, Value.Int(n))
                _ => fail mismatch(s, tree)
            }
        }
        Float => from_number(s, tree)?
        Double => from_number(s, tree)?
        Bytes => from_bytes(s, tree)?
        Fixed => from_bytes(s, tree)?
        String => {
            match tree {
                Text(t) => apply_logical(s, Value.Str(t))
                _ => fail mismatch(s, tree)
            }
        }
        Enum => {
            match tree {
                Text(sym) => {
                    for i, candidate in s.symbols {
                        if candidate == sym {
                            return Value.Enum(i, sym)
                        }
                    }
                    fail Mismatch("{sym} is not a symbol of {s.name}")
                }
                _ => fail mismatch(s, tree)
            }
        }
        Array => {
            match tree {
                Seq(items) => {
                    var out: Value[] = []
                    for i, item in items {
                        let v = from_node(s.item ?? s, item, depth + 1) catch {
                            Mismatch(m) => fail Mismatch("[{i}]: {m}")
                            e => fail e
                        }
                        out.push(v)
                    }
                    Value.Array(out)
                }
                _ => fail mismatch(s, tree)
            }
        }
        Map => {
            match tree {
                Map(members) => {
                    var out: Entry[] = []
                    for m in members {
                        let key = serde.key_text(m.key, 0) catch {
                            _ => fail Mismatch("a map key is not a scalar")
                        }
                        let v = from_node(s.item ?? s, m.value, depth + 1) catch {
                            Mismatch(text) => fail Mismatch("[{key}]: {text}")
                            e => fail e
                        }
                        out.push(Entry { key, value: v })
                    }
                    Value.Map(out)
                }
                _ => fail mismatch(s, tree)
            }
        }
        Record => {
            match tree {
                Map(members) => from_record(s, members, depth)?
                _ => fail mismatch(s, tree)
            }
        }
        Union => from_union(s, node, depth)?
    }
}

fn from_number(s: *Schema, tree: serde.Tree) -> Value ! Error {
    match tree {
        Float(x) => Value.Float(x)
        Int(n) => Value.Float(f64(n))
        _ => fail mismatch(s, tree)
    }
}

fn from_bytes(s: *Schema, tree: serde.Tree) -> Value ! Error {
    match tree {
        Binary(data) => {
            if s.kind == Kind.Fixed && data.len != s.size {
                fail Mismatch("{s.name} holds {s.size} bytes, found {data.len}")
            }
            apply_logical(s, Value.Bytes(data))
        }
        Text(t) => {
            match s.logical {
                Decimal(_, scale) => Value.Decimal(decimal_unscaled(t, scale, if s.kind == Kind.Fixed { s.size } else { 0 })?, scale)
                _ => fail mismatch(s, tree)
            }
        }
        Int(n) => {
            match s.logical {
                Decimal(_, scale) => Value.Decimal(decimal_unscaled("{n}", scale, if s.kind == Kind.Fixed { s.size } else { 0 })?, scale)
                _ => fail mismatch(s, tree)
            }
        }
        Map(members) => {
            if s.logical != Logical.Duration {
                fail mismatch(s, tree)
            }
            let parts: [str: i64] = [:]
            for m in members {
                let key = serde.key_text(m.key, 0) catch {
                    _ => fail Mismatch("a duration key is not a scalar")
                }
                match m.value.tree {
                    Int(n) => {
                        parts[key] = n
                    }
                    _ => fail Mismatch("a duration part is not an integer")
                }
            }
            Value.Duration(parts["months"] ?? 0, parts["days"] ?? 0, parts["millis"] ?? 0)
        }
        _ => fail mismatch(s, tree)
    }
}

fn from_record(s: *Schema, members: serde.Member[], depth: i64) -> Value ! Error {
    var out: Member[] = []
    for f in s.fields {
        var found: serde.Node? = none
        for m in members {
            let key = serde.key_text(m.key, 0) catch {
                _ => fail Mismatch("a record key is not a scalar")
            }
            if key == f.name {
                found = m.value
            }
        }
        match found {
            some(node) => {
                let v = from_node(f.schema, node, depth + 1) catch {
                    Mismatch(m) => fail Mismatch("{f.name}: {m}")
                    e => fail e
                }
                out.push(Member { name: f.name, value: v })
            }
            none => {
                let d = f.default ?? fail Mismatch("{f.name}: the value has no such member and the field has no default")
                out.push(Member { name: f.name, value: default_value(f.schema, d)? })
            }
        }
    }
    Value.Record(out)
}

fn from_union(s: *Schema, node: serde.Node, depth: i64) -> Value ! Error {
    for i, b in s.branches {
        let v = from_node(b, node, depth + 1) or continue
        return Value.Union(i, new(v))
    }
    fail Mismatch("no branch of the union accepts a {tree_kind(node.tree)}")
}

/// Converts `v` into the datum of `schema` that it stands for, through `std/serde`.
///
/// Structs and maps become records and maps (a record takes its fields from the keys of that name, with defaults for fields that are absent), slices become arrays, `u8[]` becomes `bytes` or `fixed`, and an optional becomes a union with `null`. A union takes the first branch that accepts the value. An enum variant without fields becomes the `enum` symbol of that name. A `decimal` takes decimal text or an integer, and a `duration` a struct of `months`, `days` and `millis`. Fails with `Mismatch`, naming the path, when a value does not fit the schema.
pub fn to_value[T](schema: *Schema, v: T) -> Value ! Error {
    let node = serde.to_tree(v)
    from_node(schema, node, 0)?
}

/// Encodes `v` as one datum of `schema`; the same as `encode` of `to_value`.
pub fn serialize[T](schema: *Schema, v: T) -> u8[] ! Error {
    let value = to_value(schema, v)?
    encode(schema, value)?
}

fn serde_error(e: Error) -> serde.Error {
    match e {
        Truncated(at) => serde.Error.Syntax(at, "input ends at offset {at}")
        Invalid(at, m) => serde.Error.Syntax(at, m)
        TooLarge(_) => serde.Error.TooLarge
        _ => serde.Error.Syntax(0, message(e))
    }
}

/// Decodes the datum of `schema` in `data` into a `T`; the same as `from_value` of `decode`.
///
/// A decoding error becomes `serde.Error.Syntax` carrying the byte offset and message, except that a limit becomes `serde.Error.TooLarge`.
pub fn deserialize[T](schema: *Schema, data: u8[]) -> T ! serde.Error {
    let v = decode(schema, data) catch serde_error
    from_value(v)?
}

/// Decodes `data`, written with the schema `writer`, as a `T` read with the schema `reader`; the same as `from_value` of `decode_resolved`.
pub fn deserialize_resolved[T](writer: *Schema, reader: *Schema, data: u8[]) -> T ! serde.Error {
    let v = decode_resolved(writer, reader, data) catch serde_error
    from_value(v)?
}
