import std/io

/// The error returned by Avro schema parsing, encoding, decoding and container files.
pub enum Error {
    /// A schema is not valid; `message` says why.
    Schema(message: str)
    /// The input ends before a value is complete. `at` is the offset where bytes were missing.
    Truncated(at: i64)
    /// The input is not valid Avro data for its schema. `at` is the offset of the offending bytes and `message` describes the problem.
    Invalid(at: i64, message: str)
    /// A length, count or nesting depth in the input exceeds an `Options` limit. `at` is the offset of the offending value.
    TooLarge(at: i64)
    /// A value does not fit the schema it is being encoded with; `message` names the path and the problem.
    Mismatch(message: str)
    /// The writer's schema cannot be resolved against the reader's; `message` names the path and the problem.
    Resolution(message: str)
    /// A container file names a compression codec that is not supported, `name`.
    Codec(name: str)
    /// A checksum, such as the CRC-32 of a Snappy block, does not match the data.
    Checksum
    /// Reading or writing a stream failed.
    Io(error: io.Error)
}

/// An Avro datum in memory.
///
/// `decode` builds one from binary data and a schema, and `encode` writes one. `int` and `long` are both `Int`, `float` and `double` are both `Float`, and `bytes` and `fixed` are both `Bytes`. A value whose schema carries a logical type decodes to the matching logical variant, and `encode` accepts either that variant or the underlying one.
pub enum Value {
    /// The `null` type.
    Null
    /// A `boolean`.
    Bool(value: bool)
    /// An `int` or `long`.
    Int(value: i64)
    /// A `float` or `double`. A `float` is held widened to 64 bits.
    Float(value: f64)
    /// `bytes` or `fixed`.
    Bytes(data: []u8)
    /// A `string`.
    Str(value: str)
    /// An enum symbol: its position in the schema's `symbols` and its text.
    Enum(index: i64, symbol: str)
    /// An array of values.
    Array(items: []Value)
    /// A map, as entries in the order they were stored. Keys are strings and may repeat.
    Map(entries: []Entry)
    /// A record: one member per field of the schema, in the schema's field order.
    Record(members: []Member)
    /// A union value: the position of the branch in the union's schema and a pointer to the value of that branch.
    Union(index: i64, value: *Value)
    /// The `decimal` logical type: the unscaled value as big-endian two's complement bytes and the scale.
    Decimal(unscaled: []u8, scale: i64)
    /// The `uuid` logical type, as its 36 character lower case text.
    Uuid(text: str)
    /// The `date` logical type: days since 1970-01-01.
    Date(days: i64)
    /// The `time-millis` logical type: milliseconds after midnight.
    TimeMillis(millis: i64)
    /// The `time-micros` logical type: microseconds after midnight.
    TimeMicros(micros: i64)
    /// The `timestamp-millis` logical type: milliseconds since the Unix epoch.
    TimestampMillis(millis: i64)
    /// The `timestamp-micros` logical type: microseconds since the Unix epoch.
    TimestampMicros(micros: i64)
    /// The `timestamp-nanos` logical type: nanoseconds since the Unix epoch.
    TimestampNanos(nanos: i64)
    /// The `local-timestamp-millis` logical type: milliseconds since 1970-01-01T00:00 in no time zone.
    LocalTimestampMillis(millis: i64)
    /// The `local-timestamp-micros` logical type: microseconds since 1970-01-01T00:00 in no time zone.
    LocalTimestampMicros(micros: i64)
    /// The `local-timestamp-nanos` logical type: nanoseconds since 1970-01-01T00:00 in no time zone.
    LocalTimestampNanos(nanos: i64)
    /// The `duration` logical type: months, days and milliseconds, each an unsigned 32-bit count.
    Duration(months: i64, days: i64, millis: i64)
}

/// A key and value pair of a `Value.Map`.
pub struct Entry {
    /// The key.
    pub key: str
    /// The value for the key.
    pub value: Value
}

/// A field name and value pair of a `Value.Record`.
pub struct Member {
    /// The field name.
    pub name: str
    /// The field value.
    pub value: Value
}

/// Returns a one-line description of `e`.
pub fn message(e: Error) -> str {
    match e {
        Schema(m) => "invalid schema: {m}"
        Truncated(at) => "input ends at offset {at}"
        Invalid(at, m) => "{m} at offset {at}"
        TooLarge(at) => "value at offset {at} exceeds a limit"
        Mismatch(m) => "value does not fit the schema: {m}"
        Resolution(m) => "schemas do not resolve: {m}"
        Codec(name) => "unsupported codec {name}"
        Checksum => "checksum mismatch"
        Io(error) => "i/o error: {error}"
    }
}
