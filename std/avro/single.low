import std/io

/// A set of schemas that single-object data can name, found by their fingerprint.
pub struct SchemaStore {
    schemas: [u64: *Schema]
}

/// Returns an empty `SchemaStore`.
pub fn schema_store() -> SchemaStore {
    SchemaStore { schemas: [:] }
}

/// Adds `schema` to `store` under the CRC-64-AVRO fingerprint of its canonical form and returns the fingerprint.
pub fn register(store: SchemaStore, schema: *Schema) -> u64 {
    let id = fingerprint(schema)
    store.schemas[id] = schema
    id
}

/// Returns the schema of `store` with the fingerprint `id`, or `none`.
pub fn lookup(store: SchemaStore, id: u64) -> *Schema? {
    store.schemas[id]
}

/// Encodes `v` as a single-object datum of `schema`: the marker `C3 01`, the 8 byte little-endian CRC-64-AVRO fingerprint of the schema's canonical form, then the binary encoding.
///
/// Fails like `encode`.
pub fn encode_single(schema: *Schema, v: Value) -> []u8 ! Error {
    var out: []u8 = [0xC3, 0x01]
    io.put_le64(mut out, i64(fingerprint(schema)))
    encode_into(mut out, schema, v)?
    out
}

/// Returns the fingerprint that the single-object datum `data` names.
///
/// Fails with `Truncated` when `data` is shorter than the 10 byte header and `Invalid` when the marker is not `C3 01`.
pub fn single_fingerprint(data: []u8) -> u64 ! Error {
    if data.len < 10 {
        fail Truncated(data.len)
    }
    if data[0] != 0xC3 || data[1] != 0x01 {
        fail Invalid(0, "not a single-object datum")
    }
    io.u64_le(data, 2)
}

/// Decodes the single-object datum `data` with the schema of `store` that its fingerprint names.
///
/// Fails with `Invalid` when the marker is wrong or no schema of `store` has the fingerprint, and otherwise like `decode`.
pub fn decode_single(store: SchemaStore, data: []u8) -> Value ! Error {
    let id = single_fingerprint(data)?
    let schema = lookup(store, id) ?? fail Invalid(2, "no schema is registered for the fingerprint {hex_u64(id)}")
    decode(schema, data[10..])?
}

/// Decodes the single-object datum `data`, which must have been written with `reader`'s own schema.
///
/// Fails with `Invalid` when the fingerprint is not that of `reader`, and otherwise like `decode`.
pub fn decode_single_with(reader: *Schema, data: []u8) -> Value ! Error {
    let id = single_fingerprint(data)?
    if id != fingerprint(reader) {
        fail Invalid(2, "the datum was written with another schema")
    }
    decode(reader, data[10..])?
}

/// Decodes the single-object datum `data` with the schema of `store` that its fingerprint names and resolves it to `reader`.
///
/// Fails like `decode_single` and `resolve`.
pub fn decode_single_resolved(store: SchemaStore, reader: *Schema, data: []u8) -> Value ! Error {
    let id = single_fingerprint(data)?
    let writer = lookup(store, id) ?? fail Invalid(2, "no schema is registered for the fingerprint {hex_u64(id)}")
    decode_resolved(writer, reader, data[10..])?
}
