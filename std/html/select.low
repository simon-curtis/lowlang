import std/text

fn fill_selected_content(root: *Node) {
    var pending: []*Node = [root]
    for pending.len > 0 {
        let top = pop(mut pending) ?? break
        var c = top.first_child
        for {
            match c {
                some(child) => {
                    if is_html(child, "select") {
                        fill_select(child)
                    }
                    match template_contents(child) {
                        some(contents) => push(mut pending, contents)
                        none => {}
                    }
                    c = descend(child, top)
                }
                none => break
            }
        }
    }
}

fn fill_select(menu: *Node) {
    if has_attr(menu, "multiple") || display_size(menu) != 1 {
        return
    }
    let target = first_named(menu, "selectedcontent") ?? return
    let option = selected_option(menu) ?? return
    for child in children(target) {
        remove(child)
    }
    for child in children(option) {
        link(target, clone(child, true), none)
    }
}

fn display_size(menu: *Node) -> i64 {
    let value = attr(menu, "size") ?? return 1
    var i = 0
    for i < value.len && space(value[i]) {
        i += 1
    }
    if i < value.len && value[i] == '+' {
        i += 1
    }
    var size = 0
    var digits = 0
    for i < value.len && value[i] >= '0' && value[i] <= '9' && size < 1000000 {
        size = size * 10 + text.digit(value[i], 10)
        digits += 1
        i += 1
    }
    if digits == 0 || size == 0 {
        return 1
    }
    size
}

fn first_named(root: *Node, name: str) -> *Node? {
    var c = root.first_child
    for {
        match c {
            some(child) => {
                if is_html(child, name) {
                    return child
                }
                c = descend(child, root)
            }
            none => return none
        }
    }
}

fn selected_option(menu: *Node) -> *Node? {
    var chosen: *Node? = none
    var first_enabled: *Node? = none
    for o in options_of(menu) {
        if has_attr(o, "selected") {
            chosen = o
        }
        if first_enabled == none && !option_disabled(o) {
            first_enabled = o
        }
    }
    chosen ?? first_enabled
}

fn options_of(menu: *Node) -> []*Node {
    var out: []*Node = []
    for child in children(menu) {
        if is_html(child, "option") {
            push(mut out, child)
        }
        if is_html(child, "optgroup") {
            for grand in children(child) {
                if is_html(grand, "option") {
                    push(mut out, grand)
                }
            }
        }
    }
    out
}

fn option_disabled(option: *Node) -> bool {
    if has_attr(option, "disabled") {
        return true
    }
    let group = option.parent ?? return false
    is_html(group, "optgroup") && has_attr(group, "disabled")
}
