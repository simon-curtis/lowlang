import std/slices
import std/text

struct Entry {
    element: *Node?
    tag: Tag
    prev: i64
    next: i64
    below: i64
    above: i64
    segment: i64
    outer: i64
    key: str
    live: bool
}

fn alloc_entry(p: *Parser, e: *Entry) -> i64 {
    match p.entry_free.pop() {
        some(id) => {
            p.entries[id] = e
            return id
        }
        none => {}
    }
    p.entries.push(e)
    p.entries.len - 1
}

fn noah_key(segment: i64, tag: Tag) -> str {
    if tag.attributes.len == 0 {
        return "{segment}|{tag.name.len}:{tag.name}"
    }
    var parts: str[] = []
    for a in tag.attributes {
        parts.push("{a.name.len}:{a.name}={a.value.len}:{a.value}")
    }
    slices.sort(mut parts)
    let joined = text.join(parts, ",")
    "{segment}|{tag.name.len}:{tag.name}|{joined}"
}

fn noah_add(p: *Parser, key: str, id: i64) {
    var queue: i64[] = p.noah[key] ?? []
    queue.push(id)
    p.noah[key] = queue
}

fn noah_remove(p: *Parser, key: str, id: i64) {
    let queue: i64[] = p.noah[key] ?? return
    var kept: i64[] = []
    for x in queue {
        if x != id {
            kept.push(x)
        }
    }
    if kept.len == 0 {
        p.noah.delete(key)
    } else {
        p.noah[key] = kept
    }
}

fn list_append(p: *Parser, id: i64) {
    let e = p.entries[id]
    e.prev = p.list_tail
    e.next = -1
    if p.list_tail >= 0 {
        p.entries[p.list_tail].next = id
    } else {
        p.list_head = id
    }
    p.list_tail = id
}

fn list_insert_after(p: *Parser, anchor: i64, id: i64) {
    if anchor < 0 {
        let e = p.entries[id]
        e.prev = -1
        e.next = p.list_head
        if p.list_head >= 0 {
            p.entries[p.list_head].prev = id
        } else {
            p.list_tail = id
        }
        p.list_head = id
        return
    }
    let a = p.entries[anchor]
    let e = p.entries[id]
    e.prev = anchor
    e.next = a.next
    if a.next >= 0 {
        p.entries[a.next].prev = id
    } else {
        p.list_tail = id
    }
    a.next = id
}

fn list_unlink(p: *Parser, id: i64) {
    let e = p.entries[id]
    if e.prev >= 0 {
        p.entries[e.prev].next = e.next
    } else {
        p.list_head = e.next
    }
    if e.next >= 0 {
        p.entries[e.next].prev = e.prev
    } else {
        p.list_tail = e.prev
    }
}

fn chain_attach(p: *Parser, id: i64) {
    let e = p.entries[id]
    let below = p.entry_chains[e.tag.name] ?? -1
    e.below = below
    e.above = -1
    if below >= 0 {
        p.entries[below].above = id
    }
    p.entry_chains[e.tag.name] = id
}

fn chain_detach(p: *Parser, id: i64) {
    let e = p.entries[id]
    if e.above >= 0 {
        p.entries[e.above].below = e.below
    } else if e.below >= 0 {
        p.entry_chains[e.tag.name] = e.below
    } else {
        p.entry_chains.delete(e.tag.name)
    }
    if e.below >= 0 {
        p.entries[e.below].above = e.above
    }
}

fn remove_entry(p: *Parser, id: i64) {
    let e = p.entries[id]
    match e.element {
        some(n) => {
            let slot = open_slot(p, n)
            if slot >= 0 && p.slots[slot].entry == id {
                p.slots[slot].entry = -1
            }
            chain_detach(p, id)
            noah_remove(p, e.key, id)
        }
        none => {}
    }
    list_unlink(p, id)
    e.live = false
    e.element = none
    e.key = ""
    p.entry_free.push(id)
}

fn insert_marker(p: *Parser) {
    p.segments += 1
    let id = alloc_entry(p, new(Entry {
        element: none,
        tag: Tag { name: "", attributes: [], self_closing: false },
        prev: -1,
        next: -1,
        below: -1,
        above: -1,
        segment: p.segments,
        outer: p.segment,
        key: "",
        live: true
    }))
    list_append(p, id)
    p.segment = p.segments
}

fn clear_formatting_to_marker(p: *Parser) {
    for p.list_tail >= 0 {
        let id = p.list_tail
        let e = p.entries[id]
        let marker = e.element == none
        let outer = e.outer
        remove_entry(p, id)
        if marker {
            p.segment = outer
            return
        }
    }
}

fn new_entry(p: *Parser, n: *Node, tag: Tag, key: str) -> i64 {
    alloc_entry(p, new(Entry {
        element: n,
        tag,
        prev: -1,
        next: -1,
        below: -1,
        above: -1,
        segment: p.segment,
        outer: -1,
        key,
        live: true
    }))
}

fn push_formatting(p: *Parser, n: *Node, tag: Tag) {
    let key = noah_key(p.segment, tag)
    let queue: i64[] = p.noah[key] ?? []
    if queue.len >= 3 {
        remove_entry(p, queue[0])
    }
    let id = new_entry(p, n, tag, key)
    list_append(p, id)
    chain_attach(p, id)
    noah_add(p, key, id)
    let slot = open_slot(p, n)
    if slot >= 0 {
        p.slots[slot].entry = id
    }
}

fn formatting_last(p: *Parser, name: str) -> i64 {
    let id = p.entry_chains[name] ?? -1
    if id < 0 {
        return -1
    }
    if p.entries[id].segment == p.segment {
        id
    } else {
        -1
    }
}

fn reconstruct_formatting(p: *Parser) {
    let last = p.list_tail
    if last < 0 {
        return
    }
    let tail = p.entries[last].element ?? return
    if is_open(p, tail) {
        return
    }
    var id = last
    for {
        let prev = p.entries[id].prev
        if prev < 0 {
            break
        }
        let earlier = p.entries[prev].element ?? break
        if is_open(p, earlier) {
            break
        }
        id = prev
    }
    for id >= 0 {
        let next = p.entries[id].next
        let entry = p.entries[id]
        if p.rebuild <= 0 {
            remove_entry(p, id)
        } else {
            p.rebuild -= 1
            let fresh = insert_html(p, entry.tag)
            entry.element = fresh
            p.slots[fresh.mark].entry = id
        }
        id = next
    }
}

fn adoption_agency(p: *Parser, subject: str) {
    if p.top >= 0 {
        let top = p.slots[p.top]
        if is_html(top.node, subject) && top.entry < 0 {
            pop_node(p)
            return
        }
    }
    var outer = 0
    for outer < 8 {
        outer += 1
        let fe_entry = formatting_last(p, subject)
        if fe_entry < 0 {
            any_other_end_tag(p, subject)
            return
        }
        let entry = p.entries[fe_entry]
        let formatting_tag = entry.tag
        let fe = entry.element ?? return
        let fe_slot = open_slot(p, fe)
        if fe_slot < 0 {
            report(p, "formatting element is not open")
            remove_entry(p, fe_entry)
            return
        }
        if !in_scope_slot(p, fe_slot, Scope.Default) {
            report(p, "formatting element is not in scope")
            return
        }
        if p.top != fe_slot {
            report(p, "misnested formatting element")
        }
        let block = furthest_block(p, fe_slot)
        if block < 0 {
            pop_until_slot(p, fe_slot)
            remove_entry(p, fe_entry)
            return
        }
        let ancestor = p.slots[p.slots[fe_slot].below].node
        let key = p.slots[fe_slot].key
        var anchor = entry.prev
        var moved = false
        var last = p.slots[block].node
        var cursor = block
        var same_top = -1
        var inner = 0
        for {
            inner += 1
            let at = p.slots[cursor].below
            if at == fe_slot {
                break
            }
            var in_list = p.slots[at].entry
            if inner > 3 && in_list >= 0 {
                if anchor == in_list {
                    anchor = p.entries[in_list].prev
                }
                remove_entry(p, in_list)
                in_list = -1
            }
            if in_list < 0 {
                remove_slot(p, at)
                continue
            }
            let listed = p.entries[in_list]
            let clone = create_element(Namespace.Html, listed.tag.name, make_attrs(listed.tag.attributes))
            listed.element = clone
            swap_node(p, at, clone)
            if !moved {
                anchor = in_list
                moved = true
            }
            link(clone, last, none)
            last = clone
            if same_top < 0 && p.slots[at].key == key {
                same_top = at
            }
            cursor = at
        }
        let place = appropriate_place(p, ancestor, false)
        link(place.parent, last, place.before)
        let fresh = create_element(Namespace.Html, formatting_tag.name, make_attrs(formatting_tag.attributes))
        let block_node = p.slots[block].node
        for child in children(block_node) {
            link(fresh, child, none)
        }
        link(block_node, fresh, none)
        remove_entry(p, fe_entry)
        let fresh_entry = new_entry(p, fresh, formatting_tag, noah_key(p.segment, formatting_tag))
        list_insert_after(p, anchor, fresh_entry)
        chain_attach(p, fresh_entry)
        noah_add(p, p.entries[fresh_entry].key, fresh_entry)
        let top_before = chain_top(p, key)
        let hint = if same_top >= 0 { same_top } else { live_chain(p, p.slots[fe_slot].same_below) }
        let as_top = top_before == fe_slot || (same_top >= 0 && top_before == same_top)
        remove_slot(p, fe_slot)
        let fresh_slot = open_insert_above(p, block, fresh, hint, as_top)
        p.slots[fresh_slot].entry = fresh_entry
    }
}
