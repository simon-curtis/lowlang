import std/text

/// The namespace of an element or an attribute.
pub enum Namespace {
    /// The HTML namespace, `http://www.w3.org/1999/xhtml`.
    Html
    /// The SVG namespace, `http://www.w3.org/2000/svg`.
    Svg
    /// The MathML namespace, `http://www.w3.org/1998/Math/MathML`.
    MathMl
    /// The XLink namespace, `http://www.w3.org/1999/xlink`, which only attributes use.
    Xlink
    /// The XML namespace, `http://www.w3.org/XML/1998/namespace`, which only attributes use.
    Xml
    /// The XMLNS namespace, `http://www.w3.org/2000/xmlns/`, which only attributes use.
    Xmlns
}

/// An attribute of an element.
pub struct Attr {
    /// The namespace of an attribute the parser adjusted in foreign content, such as `xlink:href`. `none` for every other attribute.
    pub namespace: Namespace?
    /// The prefix of a namespaced attribute, such as `xlink`. Empty when there is none.
    pub prefix: str
    /// The local name. HTML attribute names are lowercase; SVG and MathML names keep their adjusted case.
    pub name: str
    /// The value with character references decoded.
    pub value: str
}

/// An element.
///
/// Made by `create_element` or by the parser.
pub struct Element {
    /// The element's namespace.
    pub namespace: Namespace
    /// The local name: lowercase for HTML elements, and for SVG elements the adjusted case such as `foreignObject`.
    pub name: str
    /// The attributes in source order. A name appears once.
    pub attributes: []Attr
    contents: *Node?
}

/// What a node is, with the data that belongs to its kind.
pub enum Data {
    /// The root of a parsed document, with the quirks mode its document type declaration selects. A document made by `create_document` is in standards mode.
    Document(quirks: QuirksMode)
    /// The root of a fragment, and the holder of a `template` element's content.
    Fragment
    /// A document type declaration. A missing name or identifier is empty.
    Doctype(name: str, public_id: str, system_id: str)
    /// An element.
    Element(*Element)
    /// Character data.
    Text(str)
    /// A comment, without its delimiters.
    Comment(str)
    /// A processing instruction `<?target data?>`.
    Instruction(target: str, data: str)
}

/// A node of an HTML tree.
///
/// A node has a parent and an ordered list of children kept as first, last, previous and next links, so inserting, removing and moving a node is constant time. Read the links through `parent`, `first_child`, `last_child`, `previous_sibling` and `next_sibling`, and change them through `append_child`, `insert_before` and `remove`.
pub struct Node {
    /// What the node is.
    pub data: Data
    parent: *Node?
    first_child: *Node?
    last_child: *Node?
    previous: *Node?
    next: *Node?
    mark: i64
}

/// What `append_child` and `insert_before` report when they cannot make the change.
pub enum TreeError {
    /// The parent cannot have that child: only documents, fragments and elements have children, a document is never a child, and a node cannot be inserted into itself or one of its descendants.
    HierarchyRequest
    /// The reference node is not a child of the parent.
    NotFound
}

/// Returns the namespace URI of `ns`.
pub fn namespace_uri(ns: Namespace) -> str {
    match ns {
        Html => "http://www.w3.org/1999/xhtml"
        Svg => "http://www.w3.org/2000/svg"
        MathMl => "http://www.w3.org/1998/Math/MathML"
        Xlink => "http://www.w3.org/1999/xlink"
        Xml => "http://www.w3.org/XML/1998/namespace"
        Xmlns => "http://www.w3.org/2000/xmlns/"
    }
}

fn make(data: Data) -> *Node {
    new(Node { data, parent: none, first_child: none, last_child: none, previous: none, next: none, mark: -1 })
}

/// Returns an empty document.
pub fn create_document() -> *Node {
    make(Data.Document(QuirksMode.Standards))
}

/// Returns an empty fragment.
pub fn create_fragment() -> *Node {
    make(Data.Fragment)
}

/// Returns a detached element. A `template` element in the HTML namespace gets an empty content fragment.
pub fn create_element(namespace: Namespace, name: str, attributes: []Attr) -> *Node {
    let e = new(Element { namespace, name, attributes, contents: none })
    if namespace == Html && name == "template" {
        e.contents = make(Data.Fragment)
    }
    make(Data.Element(e))
}

/// Returns a detached text node.
pub fn create_text(content: str) -> *Node {
    make(Data.Text(content))
}

/// Returns a detached comment node.
pub fn create_comment(content: str) -> *Node {
    make(Data.Comment(content))
}

/// Returns a detached document type node.
pub fn create_doctype(name: str, public_id: str, system_id: str) -> *Node {
    make(Data.Doctype(name, public_id, system_id))
}

/// Returns a detached processing instruction node.
pub fn create_instruction(target: str, content: str) -> *Node {
    make(Data.Instruction(target, content))
}

/// Returns the parent of `n`, or `none` for a root and a detached node.
pub fn parent(n: *Node) -> *Node? {
    n.parent
}

/// Returns the first child of `n`, or `none` when it has none.
pub fn first_child(n: *Node) -> *Node? {
    n.first_child
}

/// Returns the last child of `n`, or `none` when it has none.
pub fn last_child(n: *Node) -> *Node? {
    n.last_child
}

/// Returns the sibling after `n`, or `none` when `n` is the last child or has no parent.
pub fn next_sibling(n: *Node) -> *Node? {
    n.next
}

/// Returns the sibling before `n`, or `none` when `n` is the first child or has no parent.
pub fn previous_sibling(n: *Node) -> *Node? {
    n.previous
}

/// Returns the children of `n` in order.
pub fn children(n: *Node) -> []*Node {
    var out: []*Node = []
    var c = n.first_child
    for {
        match c {
            some(child) => {
                push(mut out, child)
                c = child.next
            }
            none => break
        }
    }
    out
}

/// Returns the content fragment of a `template` element, or `none` for any other node.
pub fn template_contents(n: *Node) -> *Node? {
    match n.data {
        Element(e) => e.contents
        _ => none
    }
}

/// Returns the element data of `n`, or `none` when `n` is not an element.
pub fn element(n: *Node) -> *Element? {
    match n.data {
        Element(e) => e
        _ => none
    }
}

/// Returns `true` when `n` is an element.
pub fn is_element(n: *Node) -> bool {
    match n.data {
        Element => true
        _ => false
    }
}

/// Returns the local name of `n` when it is an element, and the empty string for every other node.
pub fn local_name(n: *Node) -> str {
    match n.data {
        Element(e) => e.name
        _ => ""
    }
}

/// Returns `true` when `n` is an element in the HTML namespace called `name`.
pub fn is_html(n: *Node, name: str) -> bool {
    match n.data {
        Element(e) => e.namespace == Html && e.name == name
        _ => false
    }
}

/// Returns the value of the attribute of `n` called `name`, or `none` when `n` is not an element or has none.
///
/// Only attributes without a namespace match; the comparison is exact.
pub fn attr(n: *Node, name: str) -> str? {
    match n.data {
        Element(e) => {
            for a in e.attributes {
                if a.name == name && a.prefix == "" {
                    return a.value
                }
            }
            none
        }
        _ => none
    }
}

/// Returns `true` when `n` is an element with an attribute called `name`.
pub fn has_attr(n: *Node, name: str) -> bool {
    attr(n, name) != none
}

/// Sets the attribute of `n` called `name` to `value`, adding it after the others when it is absent. Does nothing when `n` is not an element.
pub fn set_attr(n: *Node, name: str, value: str) {
    match n.data {
        Element(e) => {
            for i, a in e.attributes {
                if a.name == name && a.prefix == "" {
                    e.attributes[i] = Attr { namespace: a.namespace, prefix: a.prefix, name, value }
                    return
                }
            }
            push(mut e.attributes, Attr { namespace: none, prefix: "", name, value })
        }
        _ => {}
    }
}

/// Removes the attribute of `n` called `name`. Does nothing when there is none.
pub fn remove_attr(n: *Node, name: str) {
    match n.data {
        Element(e) => {
            var kept: []Attr = []
            for a in e.attributes {
                if a.name != name || a.prefix != "" {
                    push(mut kept, a)
                }
            }
            e.attributes = kept
        }
        _ => {}
    }
}

/// Returns `true` when `ancestor` is `n` or one of its ancestors.
pub fn contains(ancestor: *Node, n: *Node) -> bool {
    var current: *Node? = n
    for {
        match current {
            some(c) => {
                if c == ancestor {
                    return true
                }
                current = c.parent
            }
            none => return false
        }
    }
}

fn holds_children(n: *Node) -> bool {
    match n.data {
        Document => true
        Fragment => true
        Element => true
        _ => false
    }
}

fn encloses(child: *Node, parent: *Node) -> bool {
    if child.first_child == none {
        return child == parent
    }
    contains(child, parent)
}

fn is_document(n: *Node) -> bool {
    match n.data {
        Document => true
        _ => false
    }
}

/// Removes `n` from its parent. Does nothing when it has none.
pub fn remove(n: *Node) {
    let p = n.parent ?? return
    match n.previous {
        some(prev) => {
            prev.next = n.next
        }
        none => {
            p.first_child = n.next
        }
    }
    match n.next {
        some(following) => {
            following.previous = n.previous
        }
        none => {
            p.last_child = n.previous
        }
    }
    n.parent = none
    n.previous = none
    n.next = none
}

fn link(parent: *Node, child: *Node, reference: *Node?) {
    remove(child)
    child.parent = parent
    match reference {
        some(r) => {
            child.previous = r.previous
            child.next = r
            match r.previous {
                some(prev) => {
                    prev.next = child
                }
                none => {
                    parent.first_child = child
                }
            }
            r.previous = child
        }
        none => {
            child.previous = parent.last_child
            child.next = none
            match parent.last_child {
                some(last) => {
                    last.next = child
                }
                none => {
                    parent.first_child = child
                }
            }
            parent.last_child = child
        }
    }
}

/// Inserts `child` into `parent` before `reference`, or at the end when `reference` is `none`, and removes it from its old parent first.
///
/// Fails with `HierarchyRequest` when `parent` cannot hold `child` and with `NotFound` when `reference` is not a child of `parent`. A failed call changes nothing.
pub fn insert_before(parent: *Node, child: *Node, reference: *Node?) ! TreeError {
    if !holds_children(parent) || is_document(child) || encloses(child, parent) {
        fail HierarchyRequest
    }
    match reference {
        some(r) => {
            let owner = r.parent ?? fail NotFound
            if owner != parent {
                fail NotFound
            }
        }
        none => {}
    }
    link(parent, child, reference)
}

/// Appends `child` to `parent`, removing it from its old parent first. Fails as `insert_before` does.
pub fn append_child(parent: *Node, child: *Node) ! TreeError {
    insert_before(parent, child, none)?
}

/// Returns a copy of `n` without a parent. A deep copy also copies the descendants, and a `template` element's content is always copied.
pub fn clone(n: *Node, deep: bool) -> *Node {
    let copy = clone_data(n)
    if !deep {
        return copy
    }
    var source: *Node = n
    var target: *Node = copy
    var stack: []*Node = []
    var targets: []*Node = []
    for {
        var c = source.first_child
        for {
            match c {
                some(child) => {
                    let duplicate = clone_data(child)
                    link(target, duplicate, none)
                    if child.first_child != none {
                        push(mut stack, child)
                        push(mut targets, duplicate)
                    }
                    c = child.next
                }
                none => break
            }
        }
        match pop(mut stack) {
            some(next_source) => {
                source = next_source
                target = pop(mut targets) ?? copy
            }
            none => break
        }
    }
    copy
}

fn clone_data(n: *Node) -> *Node {
    match n.data {
        Element(e) => {
            var attributes: []Attr = []
            for a in e.attributes {
                push(mut attributes, a)
            }
            let copy = new(Element { namespace: e.namespace, name: e.name, attributes, contents: none })
            match e.contents {
                some(contents) => {
                    copy.contents = clone(contents, true)
                }
                none => {}
            }
            make(Data.Element(copy))
        }
        _ => make(n.data)
    }
}

/// Returns the concatenated text of the text nodes below `n`, in document order, or the text itself when `n` is a text node.
///
/// Comments, processing instructions and the content of `template` elements are left out.
pub fn text_content(n: *Node) -> str {
    match n.data {
        Text(content) => return content
        Comment(content) => return content
        Instruction(_, content) => return content
        _ => {}
    }
    var out: []u8 = []
    var c = n.first_child
    for {
        match c {
            some(child) => {
                match child.data {
                    Text(content) => text.append(mut out, content)
                    _ => {}
                }
                c = descend(child, n)
            }
            none => break
        }
    }
    __str_view(out)
}

fn following(n: *Node, root: *Node) -> *Node? {
    var current = n
    for {
        match current.next {
            some(sibling) => return sibling
            none => {
                let p = current.parent ?? return none
                if p == root {
                    return none
                }
                current = p
            }
        }
    }
}

fn descend(n: *Node, root: *Node) -> *Node? {
    match n.first_child {
        some(child) => child
        none => following(n, root)
    }
}
