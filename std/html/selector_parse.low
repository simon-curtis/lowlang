import std/text

const max_nesting = 32
const max_parts = 1000
const max_number = 1000000000

struct Scanner {
    source: str
    pos: i64
    depth: i64
    in_has: bool
}

struct Formula {
    a: i64
    b: i64
}

/// Compiles the selector list `source`.
///
/// The supported selectors are the type and universal selectors, `.class`, `#id`, attribute selectors with the operators `=`, `~=`, `|=`, `^=`, `$=` and `*=` and the `i` and `s` flags, the descendant, `>`, `+` and `~` combinators, selector lists, `:not()`, `:is()`, `:where()` and `:has()`, `:first-child`, `:last-child`, `:only-child`, `:nth-child()` and `:nth-last-child()` with an optional `of` selector list, the `-of-type` forms of those, `:empty`, `:root`, `:checked`, `:disabled` and `:enabled`.
///
/// Namespace prefixes, pseudo-elements, other pseudo-classes and a `:has()` inside `:has()` are errors, as are more than 1000 compound selectors in one complex selector and more than 32 nested functional pseudo-classes. `:is()` and `:where()` ignore an empty argument and an argument that is not a valid selector, so `:is(a, !)` is `:is(a)`. Fails with `Invalid` at the byte offset of the first problem.
pub fn compile(source: str) -> Selector ! SelectorError {
    var s = Scanner { source, pos: 0, depth: 0, in_has: false }
    skip_blank(mut s)
    let alternatives = parse_list(mut s)?
    if s.pos < source.len {
        fail unexpected(s)
    }
    Selector { alternatives }
}

fn unexpected(s: Scanner) -> SelectorError {
    var end = s.pos + 1
    for end < s.source.len && s.source[end] >= 128 && s.source[end] < 192 {
        end += 1
    }
    SelectorError.Invalid(s.pos, "unexpected {text.quote(s.source[s.pos..end])}")
}

fn at_end(s: Scanner) -> bool {
    s.pos >= s.source.len
}

fn look(s: Scanner) -> u8 {
    look_at(s, 0)
}

fn look_at(s: Scanner, offset: i64) -> u8 {
    let i = s.pos + offset
    if i < s.source.len { s.source[i] } else { 0 }
}

fn skip_blank(mut s: Scanner) -> bool {
    var spaced = false
    for !at_end(s) {
        let c = look(s)
        if space(c) || c == 12 {
            spaced = true
            s.pos += 1
        } else if c == '/' && look_at(s, 1) == '*' {
            let close = text.index(s.source[s.pos + 2..], "*/")
            s.pos = if close < 0 { s.source.len } else { s.pos + 2 + close + 2 }
        } else {
            break
        }
    }
    spaced
}

fn parse_list(mut s: Scanner) -> []Complex ! SelectorError {
    var list: []Complex = []
    for {
        let item = parse_complex(mut s)?
        push(mut list, item)
        skip_blank(mut s)
        if look(s) != ',' {
            break
        }
        s.pos += 1
        skip_blank(mut s)
    }
    list
}

fn parse_forgiving_list(mut s: Scanner) -> []Complex {
    var list: []Complex = []
    for {
        skip_blank(mut s)
        if at_end(s) || look(s) == ')' {
            break
        }
        if look(s) == ',' {
            s.pos += 1
            continue
        }
        let item = parse_forgiving_item(mut s)
        match item {
            some(complex) => push(mut list, complex)
            none => {}
        }
        skip_blank(mut s)
        if look(s) == ',' {
            s.pos += 1
        }
    }
    list
}

fn parse_forgiving_item(mut s: Scanner) -> Complex? {
    let start = s.pos
    let depth = s.depth
    let item = parse_complex(mut s) or {
        s.depth = depth
        s.pos = start
        skip_argument(mut s)
        return none
    }
    skip_blank(mut s)
    if !at_end(s) && look(s) != ',' && look(s) != ')' {
        skip_argument(mut s)
        return none
    }
    item
}

fn skip_argument(mut s: Scanner) {
    var depth = 0
    for !at_end(s) {
        let c = look(s)
        if c == '\\' {
            s.pos += 2
            continue
        }
        if c == '"' || c == '\'' {
            skip_quoted(mut s)
            continue
        }
        if c == '(' || c == '[' {
            depth += 1
        } else if c == ']' {
            depth -= 1
        } else if c == ')' {
            if depth == 0 {
                return
            }
            depth -= 1
        } else if c == ',' && depth == 0 {
            return
        }
        s.pos += 1
    }
}

fn skip_quoted(mut s: Scanner) {
    let quote = look(s)
    s.pos += 1
    for !at_end(s) && look(s) != quote {
        s.pos += if look(s) == '\\' { 2 } else { 1 }
    }
    s.pos += 1
    if s.pos > s.source.len {
        s.pos = s.source.len
    }
}

fn parse_relative_list(mut s: Scanner) -> []Relative ! SelectorError {
    var list: []Relative = []
    for {
        skip_blank(mut s)
        var link = Combinator.Descendant
        match look(s) {
            == '>' => {
                link = Combinator.Child
                s.pos += 1
            }
            == '+' => {
                link = Combinator.Next
                s.pos += 1
            }
            == '~' => {
                link = Combinator.Subsequent
                s.pos += 1
            }
            _ => {}
        }
        skip_blank(mut s)
        let complex = parse_complex(mut s)?
        push(mut list, Relative { link, complex })
        skip_blank(mut s)
        if look(s) != ',' {
            break
        }
        s.pos += 1
    }
    list
}

fn parse_complex(mut s: Scanner) -> Complex ! SelectorError {
    var parts: []Part = []
    var link = Combinator.Descendant
    for {
        let compound = parse_compound(mut s)?
        push(mut parts, Part { link, compound })
        if parts.len > max_parts {
            fail Invalid(s.pos, "too many compound selectors")
        }
        let spaced = skip_blank(mut s)
        if at_end(s) || look(s) == ',' || look(s) == ')' {
            break
        }
        match look(s) {
            == '>' => {
                link = Combinator.Child
                s.pos += 1
                skip_blank(mut s)
            }
            == '+' => {
                link = Combinator.Next
                s.pos += 1
                skip_blank(mut s)
            }
            == '~' => {
                link = Combinator.Subsequent
                s.pos += 1
                skip_blank(mut s)
            }
            _ => {
                if !spaced {
                    fail unexpected(s)
                }
                link = Combinator.Descendant
            }
        }
    }
    Complex { parts }
}

fn parse_compound(mut s: Scanner) -> []Simple ! SelectorError {
    var compound: []Simple = []
    let start = s.pos
    if look(s) == '*' {
        s.pos += 1
        push(mut compound, Simple.Universal)
        reject_namespace(s)?
    } else if ident_start(s, 0) {
        let name = read_ident(mut s)?
        push(mut compound, Simple.Type(name))
        reject_namespace(s)?
    } else if look(s) == '|' {
        fail Invalid(s.pos, "namespace prefixes are not supported")
    }
    for {
        match look(s) {
            == '#' => {
                s.pos += 1
                if !ident_start(s, 0) {
                    fail Invalid(s.pos, "expected an identifier after #")
                }
                let name = read_ident(mut s)?
                push(mut compound, Simple.Id(name))
            }
            == '.' => {
                s.pos += 1
                if !ident_start(s, 0) {
                    fail Invalid(s.pos, "expected an identifier after .")
                }
                let name = read_ident(mut s)?
                push(mut compound, Simple.Class(name))
            }
            == '[' => {
                let simple = parse_attribute(mut s)?
                push(mut compound, simple)
            }
            == ':' => parse_pseudo(mut s, mut compound)?
            _ => break
        }
    }
    if compound.len == 0 {
        fail Invalid(start, "expected a selector")
    }
    compound
}

fn reject_namespace(s: Scanner) ! SelectorError {
    if look(s) == '|' && look_at(s, 1) != '=' {
        fail Invalid(s.pos, "namespace prefixes are not supported")
    }
}

fn is_letter(c: u8) -> bool {
    (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
}

fn is_digit(c: u8) -> bool {
    c >= '0' && c <= '9'
}

fn is_hex(c: u8) -> bool {
    is_digit(c) || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F')
}

fn valid_escape(s: Scanner, offset: i64) -> bool {
    look_at(s, offset) == '\\' && look_at(s, offset + 1) != '\n'
}

fn ident_start(s: Scanner, offset: i64) -> bool {
    let c = look_at(s, offset)
    if is_letter(c) || c == '_' || c >= 128 {
        return true
    }
    if c == '\\' {
        return valid_escape(s, offset)
    }
    if c != '-' {
        return false
    }
    let n = look_at(s, offset + 1)
    is_letter(n) || n == '_' || n == '-' || n >= 128 || valid_escape(s, offset + 1)
}

fn name_char(s: Scanner) -> bool {
    let c = look(s)
    is_letter(c) || is_digit(c) || c == '_' || c == '-' || c >= 128 || valid_escape(s, 0)
}

fn read_ident(mut s: Scanner) -> str ! SelectorError {
    let start = s.pos
    var out: []u8 = []
    var escaped = false
    for !at_end(s) && name_char(s) {
        if look(s) == '\\' {
            if !escaped {
                text.append(mut out, s.source[start..s.pos])
                escaped = true
            }
            let c = read_escape(mut s)
            text.append_char(mut out, c)
        } else {
            let c = look(s)
            if escaped {
                push(mut out, c)
            }
            s.pos += 1
        }
    }
    if escaped { __str_view(out) } else { s.source[start..s.pos] }
}

fn read_escape(mut s: Scanner) -> u32 {
    s.pos += 1
    if at_end(s) {
        return 65533
    }
    if is_hex(look(s)) {
        var value: i64 = 0
        var digits = 0
        for digits < 6 && is_hex(look(s)) {
            value = value * 16 + text.hex_digit(look(s))
            s.pos += 1
            digits += 1
        }
        if look(s) == ' ' || look(s) == '\t' || look(s) == '\n' || look(s) == 12 {
            s.pos += 1
        } else if look(s) == '\r' {
            s.pos += 1
            if look(s) == '\n' {
                s.pos += 1
            }
        }
        if value == 0 || value > 1114111 || (value >= 55296 && value <= 57343) {
            return 65533
        }
        return u32(value)
    }
    var width = 1
    let lead = look(s)
    if lead >= 128 {
        width = text.lead_len(lead)
    }
    let r = text.chars(s.source[s.pos..s.pos + width])
    s.pos += width
    for c in r[0] {
        return c
    }
    65533
}

fn read_string(mut s: Scanner) -> str ! SelectorError {
    let quote = look(s)
    let start = s.pos
    s.pos += 1
    var out: []u8 = []
    for {
        if at_end(s) {
            fail Invalid(start, "unterminated string")
        }
        let c = look(s)
        if c == quote {
            s.pos += 1
            break
        }
        if c == '\n' {
            fail Invalid(s.pos, "unterminated string")
        }
        if c == '\\' {
            if s.pos + 1 >= s.source.len {
                fail Invalid(start, "unterminated string")
            }
            if look_at(s, 1) == '\n' {
                s.pos += 2
                continue
            }
            let r = read_escape(mut s)
            text.append_char(mut out, r)
            continue
        }
        push(mut out, c)
        s.pos += 1
    }
    __str_view(out)
}

fn parse_attribute(mut s: Scanner) -> Simple ! SelectorError {
    let open = s.pos
    s.pos += 1
    skip_blank(mut s)
    if !ident_start(s, 0) {
        if look(s) == '*' || look(s) == '|' {
            fail Invalid(s.pos, "namespace prefixes are not supported")
        }
        fail Invalid(s.pos, "expected an attribute name")
    }
    let name = read_ident(mut s)?
    reject_namespace(s)?
    skip_blank(mut s)
    if look(s) == ']' {
        s.pos += 1
        return Simple.Attribute(name, Operator.Exists, "", Folding.Default)
    }
    let op = parse_operator(mut s)?
    skip_blank(mut s)
    var value = ""
    if look(s) == '"' || look(s) == '\'' {
        value = read_string(mut s)?
    } else if ident_start(s, 0) {
        value = read_ident(mut s)?
    } else {
        fail Invalid(s.pos, "expected an attribute value")
    }
    skip_blank(mut s)
    var fold = Folding.Default
    let flag = look(s)
    if flag == 'i' || flag == 'I' {
        fold = Folding.Insensitive
        s.pos += 1
    } else if flag == 's' || flag == 'S' {
        fold = Folding.Sensitive
        s.pos += 1
    }
    skip_blank(mut s)
    if look(s) != ']' {
        if at_end(s) {
            fail Invalid(open, "unterminated attribute selector")
        }
        fail Invalid(s.pos, "expected ]")
    }
    s.pos += 1
    Simple.Attribute(name, op, value, fold)
}

fn parse_operator(mut s: Scanner) -> Operator ! SelectorError {
    let c = look(s)
    if c == '=' {
        s.pos += 1
        return Operator.Equals
    }
    if look_at(s, 1) != '=' {
        if at_end(s) {
            fail Invalid(s.pos, "unterminated attribute selector")
        }
        fail Invalid(s.pos, "expected an attribute operator")
    }
    let op = match c {
        == '~' => Operator.Includes
        == '|' => Operator.DashMatch
        == '^' => Operator.Prefix
        == '$' => Operator.Suffix
        == '*' => Operator.Substring
        _ => fail Invalid(s.pos, "expected an attribute operator")
    }
    s.pos += 2
    op
}

fn parse_pseudo(mut s: Scanner, mut compound: []Simple) ! SelectorError {
    let colon = s.pos
    s.pos += 1
    if look(s) == ':' {
        fail Invalid(colon, "pseudo-elements are not supported")
    }
    if !ident_start(s, 0) {
        fail Invalid(colon, "expected a pseudo-class name")
    }
    let name = text.lower(read_ident(mut s)?)
    if look(s) == '(' {
        s.pos += 1
        s.depth += 1
        if s.depth > max_nesting {
            fail Invalid(colon, "selectors nest too deeply")
        }
        let simple = parse_function(mut s, name, colon)?
        push(mut compound, simple)
        skip_blank(mut s)
        if look(s) != ')' {
            if at_end(s) {
                fail Invalid(colon, "unterminated :{name}(")
            }
            fail Invalid(s.pos, "expected )")
        }
        s.pos += 1
        s.depth -= 1
        return
    }
    match name {
        "first-child" => push(mut compound, Simple.Nth(0, 1, false, false, []))
        "last-child" => push(mut compound, Simple.Nth(0, 1, true, false, []))
        "only-child" => {
            push(mut compound, Simple.Nth(0, 1, false, false, []))
            push(mut compound, Simple.Nth(0, 1, true, false, []))
        }
        "first-of-type" => push(mut compound, Simple.Nth(0, 1, false, true, []))
        "last-of-type" => push(mut compound, Simple.Nth(0, 1, true, true, []))
        "only-of-type" => {
            push(mut compound, Simple.Nth(0, 1, false, true, []))
            push(mut compound, Simple.Nth(0, 1, true, true, []))
        }
        "empty" => push(mut compound, Simple.Empty)
        "root" => push(mut compound, Simple.Root)
        "checked" => push(mut compound, Simple.Checked)
        "disabled" => push(mut compound, Simple.Disabled)
        "enabled" => push(mut compound, Simple.Enabled)
        _ => fail Invalid(colon, "unknown pseudo-class :{name}")
    }
}

fn parse_function(mut s: Scanner, name: str, colon: i64) -> Simple ! SelectorError {
    skip_blank(mut s)
    match name {
        "not" => {
            let list = parse_list(mut s)?
            return Simple.Not(list)
        }
        "is" => {
            let list = parse_forgiving_list(mut s)
            return Simple.Is(list)
        }
        "where" => {
            let list = parse_forgiving_list(mut s)
            return Simple.Is(list)
        }
        "has" => {
            if s.in_has {
                fail Invalid(colon, ":has() cannot be nested in :has()")
            }
            s.in_has = true
            let list = parse_relative_list(mut s)?
            s.in_has = false
            return Simple.Has(list)
        }
        "nth-child" => return parse_nth(mut s, false, false, true)?
        "nth-last-child" => return parse_nth(mut s, true, false, true)?
        "nth-of-type" => return parse_nth(mut s, false, true, false)?
        "nth-last-of-type" => return parse_nth(mut s, true, true, false)?
        _ => fail Invalid(colon, "unknown pseudo-class :{name}")
    }
}

fn parse_nth(mut s: Scanner, last: bool, of_type: bool, allow_of: bool) -> Simple ! SelectorError {
    let f = parse_formula(mut s)?
    skip_blank(mut s)
    var filter: []Complex = []
    if allow_of && text.starts_with_fold(s.source[s.pos..], "of") && !name_char_at(s, 2) {
        s.pos += 2
        if !skip_blank(mut s) {
            fail Invalid(s.pos, "expected a selector after of")
        }
        filter = parse_list(mut s)?
    }
    Simple.Nth(f.a, f.b, last, of_type, filter)
}

fn name_char_at(s: Scanner, offset: i64) -> bool {
    let c = look_at(s, offset)
    is_letter(c) || is_digit(c) || c == '_' || c == '-' || c >= 128
}

fn read_digits(mut s: Scanner) -> i64 ! SelectorError {
    let start = s.pos
    var value: i64 = 0
    for is_digit(look(s)) {
        value = value * 10 + text.digit(look(s), 10)
        if value > max_number {
            fail Invalid(start, "number too large")
        }
        s.pos += 1
    }
    if s.pos == start {
        return -1
    }
    value
}

fn parse_formula(mut s: Scanner) -> Formula ! SelectorError {
    let start = s.pos
    if text.starts_with_fold(s.source[s.pos..], "odd") && !name_char_at(s, 3) {
        s.pos += 3
        return Formula { a: 2, b: 1 }
    }
    if text.starts_with_fold(s.source[s.pos..], "even") && !name_char_at(s, 4) {
        s.pos += 4
        return Formula { a: 2, b: 0 }
    }
    var sign = 1
    if look(s) == '+' {
        s.pos += 1
    } else if look(s) == '-' {
        sign = -1
        s.pos += 1
    }
    let digits = read_digits(mut s)?
    if look(s) != 'n' && look(s) != 'N' {
        if digits < 0 {
            fail Invalid(start, "expected an+b")
        }
        return Formula { a: 0, b: sign * digits }
    }
    s.pos += 1
    let a = sign * (if digits < 0 { 1 } else { digits })
    skip_blank(mut s)
    var offset_sign = 0
    if look(s) == '+' {
        offset_sign = 1
    } else if look(s) == '-' {
        offset_sign = -1
    }
    if offset_sign == 0 {
        return Formula { a, b: 0 }
    }
    s.pos += 1
    skip_blank(mut s)
    let b = read_digits(mut s)?
    if b < 0 {
        fail Invalid(s.pos, "expected a number after the sign")
    }
    Formula { a, b: offset_sign * b }
}
