import std/text

struct Frame {
    parent: *Node
    next: *Node?
    close: str
}

/// Returns the HTML serialization of the children of `n`, as `innerHTML` does.
///
/// A `template` element serializes its content. A void element such as `br` serializes as the empty string. Text is escaped except inside `script`, `style`, `xmp`, `iframe`, `noembed`, `noframes` and `plaintext`, where it is written as it is; `&`, `<`, `>` and U+00A0 become character references in text, and `"` as well in an attribute value.
pub fn inner_html(n: *Node) -> str {
    var out: u8[] = []
    write_inner(n, false, mut out)
    __str_view(out)
}

/// Returns the serialization of the children of `n` as `inner_html` writes it, with one more line feed after the start tag of a `pre`, `textarea` or `listing` element whose content begins with a line feed.
///
/// The parser drops the first line feed after those start tags, so parsing this text gives back the text of the element that `inner_html` would lose.
pub fn reparsable_html(n: *Node) -> str {
    var out: u8[] = []
    write_inner(n, true, mut out)
    __str_view(out)
}

/// Returns the HTML serialization of `n` and its descendants, as `outerHTML` does. A document and a fragment serialize as their children.
pub fn outer_html(n: *Node) -> str {
    var out: u8[] = []
    match n.data {
        Element(e) => {
            write_open(e, mut out)
            if !serializes_as_void(e) {
                write_inner(n, false, mut out)
                write_close(e, mut out)
            }
        }
        Document => write_inner(n, false, mut out)
        Fragment => write_inner(n, false, mut out)
        _ => write_leaf(n, raw_parent(n.parent), mut out)
    }
    __str_view(out)
}

fn write_inner(root: *Node, keep_newline: bool, mut out: u8[]) {
    let first = children_start(root) ?? return
    var parent = root
    var next: *Node? = first
    var frames: Frame[] = []
    for {
        match next {
            some(n) => {
                next = n.next
                match n.data {
                    Element(e) => {
                        write_open(e, mut out)
                        if !serializes_as_void(e) {
                            frames.push(Frame { parent, next, close: close_tag(e) })
                            parent = n
                            next = children_start(n)
                            if keep_newline && drops_leading_newline(e) && starts_with_newline(next) {
                                text.append(mut out, "\n")
                            }
                        }
                    }
                    _ => write_leaf(n, raw_parent(parent), mut out)
                }
            }
            none => {
                let frame = frames.pop() ?? break
                text.append(mut out, frame.close)
                parent = frame.parent
                next = frame.next
            }
        }
    }
}

fn drops_leading_newline(e: *Element) -> bool {
    if e.namespace != Namespace.Html {
        return false
    }
    match e.name {
        "pre" => true
        "textarea" => true
        "listing" => true
        _ => false
    }
}

fn starts_with_newline(first: *Node?) -> bool {
    let n = first ?? return false
    match n.data {
        Text(content) => content.len > 0 && content[0] == 10
        _ => false
    }
}

fn children_start(n: *Node) -> *Node? {
    match template_contents(n) {
        some(contents) => contents.first_child
        none => if serializes_as_void_node(n) { none } else { n.first_child }
    }
}

fn serializes_as_void_node(n: *Node) -> bool {
    match n.data {
        Element(e) => serializes_as_void(e)
        _ => false
    }
}

fn serializes_as_void(e: *Element) -> bool {
    if e.namespace != Namespace.Html {
        return false
    }
    match e.name {
        "area" => true
        "base" => true
        "basefont" => true
        "bgsound" => true
        "br" => true
        "col" => true
        "embed" => true
        "frame" => true
        "hr" => true
        "img" => true
        "input" => true
        "keygen" => true
        "link" => true
        "meta" => true
        "param" => true
        "source" => true
        "track" => true
        "wbr" => true
        _ => false
    }
}

fn raw_parent(p: *Node?) -> bool {
    let n = p ?? return false
    let e = element(n) ?? return false
    if e.namespace != Namespace.Html {
        return false
    }
    match e.name {
        "style" => true
        "script" => true
        "xmp" => true
        "iframe" => true
        "noembed" => true
        "noframes" => true
        "plaintext" => true
        _ => false
    }
}

fn write_leaf(n: *Node, raw: bool, mut out: u8[]) {
    match n.data {
        Text(content) => {
            if raw {
                text.append(mut out, content)
            } else {
                write_escaped(content, false, mut out)
            }
        }
        Comment(content) => text.append(mut out, "<!--{content}-->")
        Instruction(target, content) => text.append(mut out, "<?{target} {content}?>")
        Doctype(name, _, _) => text.append(mut out, "<!DOCTYPE {name}>")
        _ => {}
    }
}

fn close_tag(e: *Element) -> str {
    "</{e.name}>"
}

fn write_close(e: *Element, mut out: u8[]) {
    text.append(mut out, close_tag(e))
}

fn write_open(e: *Element, mut out: u8[]) {
    text.append(mut out, "<")
    text.append(mut out, e.name)
    for a in e.attributes {
        text.append(mut out, " ")
        text.append(mut out, serialized_name(a))
        text.append(mut out, "=\"")
        write_escaped(a.value, true, mut out)
        text.append(mut out, "\"")
    }
    text.append(mut out, ">")
}

fn serialized_name(a: Attr) -> str {
    let ns = a.namespace ?? return a.name
    match ns {
        Xml => "xml:{a.name}"
        Xmlns => if a.name == "xmlns" { "xmlns" } else { "xmlns:{a.name}" }
        Xlink => "xlink:{a.name}"
        _ => if a.prefix == "" { a.name } else { "{a.prefix}:{a.name}" }
    }
}

fn entity_for(s: str, i: i64, attribute: bool) -> str {
    match s[i] {
        '&' => "&amp;"
        '<' => "&lt;"
        '>' => "&gt;"
        '"' => if attribute { "&quot;" } else { "" }
        0xC2 => if i + 1 < s.len && s[i + 1] == 0xA0 { "&nbsp;" } else { "" }
        _ => ""
    }
}

fn write_escaped(s: str, attribute: bool, mut out: u8[]) {
    var run = 0
    var i = 0
    for i < s.len {
        let r = entity_for(s, i, attribute)
        if r == "" {
            i += 1
            continue
        }
        text.append(mut out, s[run..i])
        text.append(mut out, r)
        i += if r == "&nbsp;" { 2 } else { 1 }
        run = i
    }
    text.append(mut out, s[run..])
}
