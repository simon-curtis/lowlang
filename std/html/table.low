import std/text

fn clear_to_table_context(p: *Parser) {
    for p.top >= 0 {
        let name = html_name(current(p))
        if name == "table" || name == "template" || name == "html" {
            return
        }
        pop_node(p)
    }
}

fn clear_to_table_body_context(p: *Parser) {
    for p.top >= 0 {
        let name = html_name(current(p))
        if name == "tbody" || name == "tfoot" || name == "thead" || name == "template" || name == "html" {
            return
        }
        pop_node(p)
    }
}

fn clear_to_row_context(p: *Parser) {
    for p.top >= 0 {
        let name = html_name(current(p))
        if name == "tr" || name == "template" || name == "html" {
            return
        }
        pop_node(p)
    }
}

fn in_table(p: *Parser, token: Token) {
    match token {
        Text(content) => characters(p, content)
        Comment(data) => insert_comment(p, data)
        Instruction(target, data) => insert_instruction(p, target, data)
        Doctype => report(p, "unexpected document type declaration")
        StartTag(name, attributes, self_closing) => in_table_start(p, token, Tag { name, attributes, self_closing })
        EndTag(name) => in_table_end(p, token, name)
        End => in_body(p, token)
    }
}

fn in_table_start(p: *Parser, token: Token, tag: Tag) {
    match tag.name {
        "caption" => {
            clear_to_table_context(p)
            insert_marker(p)
            insert_html(p, tag)
            p.mode = Mode.InCaption
        }
        "colgroup" => {
            clear_to_table_context(p)
            insert_html(p, tag)
            p.mode = Mode.InColumnGroup
        }
        "col" => {
            clear_to_table_context(p)
            insert_plain(p, "colgroup")
            p.mode = Mode.InColumnGroup
            dispatch(p, token)
        }
        "tbody" => start_table_section(p, tag)
        "tfoot" => start_table_section(p, tag)
        "thead" => start_table_section(p, tag)
        "td" => start_table_cell(p, token)
        "th" => start_table_cell(p, token)
        "tr" => start_table_cell(p, token)
        "table" => {
            report(p, "nested table")
            if has_scope(p, "table", Scope.Table) {
                pop_until(p, "table")
                reset_mode(p)
                dispatch(p, token)
            }
        }
        "style" => in_head(p, token)
        "script" => in_head(p, token)
        "template" => in_head(p, token)
        "input" => {
            let kind = attribute(tag.attributes, "type") ?? ""
            if text.equal_fold(kind, "hidden") {
                report(p, "hidden input in table")
                insert_html(p, tag)
                pop_node(p)
            } else {
                in_table_default(p, token)
            }
        }
        "form" => {
            report(p, "form in table")
            if p.form == none || parsing_template_contents(p) {
                let n = insert_html(p, tag)
                if !parsing_template_contents(p) {
                    p.form = n
                }
                pop_node(p)
            }
        }
        _ => in_table_default(p, token)
    }
}

fn start_table_section(p: *Parser, tag: Tag) {
    clear_to_table_context(p)
    insert_html(p, tag)
    p.mode = Mode.InTableBody
}

fn start_table_cell(p: *Parser, token: Token) {
    clear_to_table_context(p)
    insert_plain(p, "tbody")
    p.mode = Mode.InTableBody
    dispatch(p, token)
}

fn in_table_end(p: *Parser, token: Token, name: str) {
    match name {
        "table" => {
            if has_scope(p, "table", Scope.Table) {
                pop_until(p, "table")
                reset_mode(p)
            } else {
                report(p, "unexpected table end tag")
            }
        }
        "body" => report(p, "unexpected end tag in table")
        "caption" => report(p, "unexpected end tag in table")
        "col" => report(p, "unexpected end tag in table")
        "colgroup" => report(p, "unexpected end tag in table")
        "html" => report(p, "unexpected end tag in table")
        "tbody" => report(p, "unexpected end tag in table")
        "td" => report(p, "unexpected end tag in table")
        "tfoot" => report(p, "unexpected end tag in table")
        "th" => report(p, "unexpected end tag in table")
        "thead" => report(p, "unexpected end tag in table")
        "tr" => report(p, "unexpected end tag in table")
        "template" => in_head(p, token)
        _ => in_table_default(p, token)
    }
}

fn in_table_default(p: *Parser, token: Token) {
    report(p, "unexpected token in table")
    p.foster = true
    in_body(p, token)
    p.foster = false
}

fn in_table_text(p: *Parser, token: Token) {
    match token {
        Text(content) => characters(p, content)
        _ => {
            let pending = __str_view(p.table_text)
            if !all_space(pending) {
                report(p, "unexpected text in table")
                p.foster = true
                body_text(p, pending)
                p.foster = false
            } else if pending.len > 0 {
                insert_text(p, pending)
            }
            p.table_text = []
            p.mode = p.original
            dispatch(p, token)
        }
    }
}

fn close_caption(p: *Parser) -> bool {
    if !has_scope(p, "caption", Scope.Table) {
        report(p, "unexpected caption end")
        return false
    }
    generate_implied(p, "")
    if !is_html(current(p), "caption") {
        report(p, "unclosed element in caption")
    }
    pop_until(p, "caption")
    clear_formatting_to_marker(p)
    p.mode = Mode.InTable
    true
}

fn in_caption(p: *Parser, token: Token) {
    match token {
        EndTag(name) => {
            match name {
                "caption" => {
                    close_caption(p)
                }
                "table" => {
                    if close_caption(p) {
                        dispatch(p, token)
                    }
                }
                "body" => report(p, "unexpected end tag in caption")
                "col" => report(p, "unexpected end tag in caption")
                "colgroup" => report(p, "unexpected end tag in caption")
                "html" => report(p, "unexpected end tag in caption")
                "tbody" => report(p, "unexpected end tag in caption")
                "td" => report(p, "unexpected end tag in caption")
                "tfoot" => report(p, "unexpected end tag in caption")
                "th" => report(p, "unexpected end tag in caption")
                "thead" => report(p, "unexpected end tag in caption")
                "tr" => report(p, "unexpected end tag in caption")
                _ => in_body(p, token)
            }
        }
        StartTag(name, _, _) => {
            match name {
                "caption" => caption_boundary(p, token)
                "col" => caption_boundary(p, token)
                "colgroup" => caption_boundary(p, token)
                "tbody" => caption_boundary(p, token)
                "td" => caption_boundary(p, token)
                "tfoot" => caption_boundary(p, token)
                "th" => caption_boundary(p, token)
                "thead" => caption_boundary(p, token)
                "tr" => caption_boundary(p, token)
                _ => in_body(p, token)
            }
        }
        _ => in_body(p, token)
    }
}

fn caption_boundary(p: *Parser, token: Token) {
    if close_caption(p) {
        dispatch(p, token)
    }
}

fn in_column_group(p: *Parser, token: Token) {
    match token {
        Text(content) => characters(p, content)
        Comment(data) => insert_comment(p, data)
        Instruction(target, data) => insert_instruction(p, target, data)
        Doctype => report(p, "unexpected document type declaration")
        StartTag(name, attributes, self_closing) => {
            match name {
                "html" => in_body(p, token)
                "col" => head_void(p, Tag { name, attributes, self_closing })
                "template" => in_head(p, token)
                _ => column_group_default(p, token)
            }
        }
        EndTag(name) => {
            match name {
                "colgroup" => {
                    if is_html(current(p), "colgroup") {
                        pop_node(p)
                        p.mode = Mode.InTable
                    } else {
                        report(p, "unexpected colgroup end tag")
                    }
                }
                "col" => report(p, "unexpected col end tag")
                "template" => in_head(p, token)
                _ => column_group_default(p, token)
            }
        }
        End => in_body(p, token)
    }
}

fn column_group_default(p: *Parser, token: Token) {
    if !is_html(current(p), "colgroup") {
        report(p, "unexpected token in column group")
        return
    }
    pop_node(p)
    p.mode = Mode.InTable
    dispatch(p, token)
}

fn in_table_body(p: *Parser, token: Token) {
    match token {
        StartTag(name, attributes, self_closing) => {
            match name {
                "tr" => {
                    clear_to_table_body_context(p)
                    insert_html(p, Tag { name, attributes, self_closing })
                    p.mode = Mode.InRow
                }
                "th" => start_row(p, token)
                "td" => start_row(p, token)
                "caption" => section_boundary(p, token)
                "col" => section_boundary(p, token)
                "colgroup" => section_boundary(p, token)
                "tbody" => section_boundary(p, token)
                "tfoot" => section_boundary(p, token)
                "thead" => section_boundary(p, token)
                _ => in_table(p, token)
            }
        }
        EndTag(name) => {
            match name {
                "tbody" => end_section(p, name)
                "tfoot" => end_section(p, name)
                "thead" => end_section(p, name)
                "table" => section_boundary(p, token)
                "body" => report(p, "unexpected end tag in table body")
                "caption" => report(p, "unexpected end tag in table body")
                "col" => report(p, "unexpected end tag in table body")
                "colgroup" => report(p, "unexpected end tag in table body")
                "html" => report(p, "unexpected end tag in table body")
                "td" => report(p, "unexpected end tag in table body")
                "th" => report(p, "unexpected end tag in table body")
                "tr" => report(p, "unexpected end tag in table body")
                _ => in_table(p, token)
            }
        }
        _ => in_table(p, token)
    }
}

fn start_row(p: *Parser, token: Token) {
    report(p, "cell outside row")
    clear_to_table_body_context(p)
    insert_plain(p, "tr")
    p.mode = Mode.InRow
    dispatch(p, token)
}

fn end_section(p: *Parser, name: str) {
    if !has_scope(p, name, Scope.Table) {
        report(p, "unexpected end tag in table body")
        return
    }
    clear_to_table_body_context(p)
    pop_node(p)
    p.mode = Mode.InTable
}

fn section_boundary(p: *Parser, token: Token) {
    if !has_table_section_in_scope(p) {
        report(p, "unexpected token in table body")
        return
    }
    clear_to_table_body_context(p)
    pop_node(p)
    p.mode = Mode.InTable
    dispatch(p, token)
}

fn in_row(p: *Parser, token: Token) {
    match token {
        StartTag(name, attributes, self_closing) => {
            match name {
                "th" => start_cell(p, Tag { name, attributes, self_closing })
                "td" => start_cell(p, Tag { name, attributes, self_closing })
                "caption" => row_boundary(p, token)
                "col" => row_boundary(p, token)
                "colgroup" => row_boundary(p, token)
                "tbody" => row_boundary(p, token)
                "tfoot" => row_boundary(p, token)
                "thead" => row_boundary(p, token)
                "tr" => row_boundary(p, token)
                _ => in_table(p, token)
            }
        }
        EndTag(name) => {
            match name {
                "tr" => {
                    if has_scope(p, "tr", Scope.Table) {
                        clear_to_row_context(p)
                        pop_node(p)
                        p.mode = Mode.InTableBody
                    } else {
                        report(p, "unexpected tr end tag")
                    }
                }
                "table" => row_boundary(p, token)
                "tbody" => row_section_end(p, token, name)
                "tfoot" => row_section_end(p, token, name)
                "thead" => row_section_end(p, token, name)
                "body" => report(p, "unexpected end tag in row")
                "caption" => report(p, "unexpected end tag in row")
                "col" => report(p, "unexpected end tag in row")
                "colgroup" => report(p, "unexpected end tag in row")
                "html" => report(p, "unexpected end tag in row")
                "td" => report(p, "unexpected end tag in row")
                "th" => report(p, "unexpected end tag in row")
                _ => in_table(p, token)
            }
        }
        _ => in_table(p, token)
    }
}

fn start_cell(p: *Parser, tag: Tag) {
    clear_to_row_context(p)
    insert_html(p, tag)
    p.mode = Mode.InCell
    insert_marker(p)
}

fn row_boundary(p: *Parser, token: Token) {
    if !has_scope(p, "tr", Scope.Table) {
        report(p, "unexpected token in row")
        return
    }
    clear_to_row_context(p)
    pop_node(p)
    p.mode = Mode.InTableBody
    dispatch(p, token)
}

fn row_section_end(p: *Parser, token: Token, name: str) {
    if !has_scope(p, name, Scope.Table) || !has_scope(p, "tr", Scope.Table) {
        report(p, "unexpected end tag in row")
        return
    }
    clear_to_row_context(p)
    pop_node(p)
    p.mode = Mode.InTableBody
    dispatch(p, token)
}

fn close_cell(p: *Parser) {
    generate_implied(p, "")
    let name = html_name(current(p))
    if name != "td" && name != "th" {
        report(p, "unclosed element in cell")
    }
    for p.top >= 0 {
        let n = current(p)
        pop_node(p)
        let popped = html_name(n)
        if popped == "td" || popped == "th" {
            break
        }
    }
    clear_formatting_to_marker(p)
    p.mode = Mode.InRow
}

fn in_cell(p: *Parser, token: Token) {
    match token {
        EndTag(name) => {
            match name {
                "td" => end_cell(p, name)
                "th" => end_cell(p, name)
                "body" => report(p, "unexpected end tag in cell")
                "caption" => report(p, "unexpected end tag in cell")
                "col" => report(p, "unexpected end tag in cell")
                "colgroup" => report(p, "unexpected end tag in cell")
                "html" => report(p, "unexpected end tag in cell")
                "table" => cell_section_end(p, token, name)
                "tbody" => cell_section_end(p, token, name)
                "tfoot" => cell_section_end(p, token, name)
                "thead" => cell_section_end(p, token, name)
                "tr" => cell_section_end(p, token, name)
                _ => in_body(p, token)
            }
        }
        StartTag(name, _, _) => {
            match name {
                "caption" => cell_boundary(p, token)
                "col" => cell_boundary(p, token)
                "colgroup" => cell_boundary(p, token)
                "tbody" => cell_boundary(p, token)
                "td" => cell_boundary(p, token)
                "tfoot" => cell_boundary(p, token)
                "th" => cell_boundary(p, token)
                "thead" => cell_boundary(p, token)
                "tr" => cell_boundary(p, token)
                _ => in_body(p, token)
            }
        }
        _ => in_body(p, token)
    }
}

fn end_cell(p: *Parser, name: str) {
    if !has_scope(p, name, Scope.Table) {
        report(p, "unexpected end tag in cell")
        return
    }
    generate_implied(p, "")
    if !is_html(current(p), name) {
        report(p, "unclosed element before end tag")
    }
    pop_until(p, name)
    clear_formatting_to_marker(p)
    p.mode = Mode.InRow
}

fn cell_boundary(p: *Parser, token: Token) {
    if !has_cell_in_table_scope(p) {
        report(p, "unexpected token in cell")
        return
    }
    close_cell(p)
    dispatch(p, token)
}

fn cell_section_end(p: *Parser, token: Token, name: str) {
    if !has_scope(p, name, Scope.Table) {
        report(p, "unexpected end tag in cell")
        return
    }
    close_cell(p)
    dispatch(p, token)
}

fn in_template(p: *Parser, token: Token) {
    match token {
        Text => in_body(p, token)
        Comment => in_body(p, token)
        Instruction => in_body(p, token)
        Doctype => in_body(p, token)
        StartTag(name, _, _) => {
            match name {
                "base" => in_head(p, token)
                "basefont" => in_head(p, token)
                "bgsound" => in_head(p, token)
                "link" => in_head(p, token)
                "meta" => in_head(p, token)
                "noframes" => in_head(p, token)
                "script" => in_head(p, token)
                "style" => in_head(p, token)
                "template" => in_head(p, token)
                "title" => in_head(p, token)
                "caption" => switch_template(p, Mode.InTable, token)
                "colgroup" => switch_template(p, Mode.InTable, token)
                "tbody" => switch_template(p, Mode.InTable, token)
                "tfoot" => switch_template(p, Mode.InTable, token)
                "thead" => switch_template(p, Mode.InTable, token)
                "col" => switch_template(p, Mode.InColumnGroup, token)
                "tr" => switch_template(p, Mode.InTableBody, token)
                "td" => switch_template(p, Mode.InRow, token)
                "th" => switch_template(p, Mode.InRow, token)
                _ => switch_template(p, Mode.InBody, token)
            }
        }
        EndTag(name) => {
            if name == "template" {
                in_head(p, token)
            } else {
                report(p, "unexpected end tag in template")
            }
        }
        End => {
            if !has_template(p) {
                return
            }
            report(p, "unexpected end of input in template")
            pop_until(p, "template")
            clear_formatting_to_marker(p)
            p.templates.pop()
            reset_mode(p)
            p.again = true
        }
    }
}

fn switch_template(p: *Parser, mode: Mode, token: Token) {
    p.templates.pop()
    p.templates.push(mode)
    p.mode = mode
    dispatch(p, token)
}
