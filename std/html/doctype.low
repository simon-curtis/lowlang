import std/simd
import std/text

struct Declaration {
    public_id: str?
    system_id: str?
    quirks: bool
    next: i64
}

fn doctype(t: *Tokenizer, from: i64) -> Token? {
    let s = t.input
    var i = skip_space(s, from)
    if i >= s.len {
        t.pos = s.len
        return Token.Doctype("", none, none, true)
    }
    if s[i] == '>' {
        t.pos = i + 1
        return Token.Doctype("", none, none, true)
    }
    let start = i
    for i < s.len && !space(s[i]) && s[i] != '>' {
        i += 1
    }
    let name = replace_null(text.lower(s[start..i]))
    var d = Declaration { public_id: none, system_id: none, quirks: false, next: s.len }
    i = skip_space(s, i)
    if i >= s.len {
        d.quirks = true
    } else if s[i] == '>' {
        d.next = i + 1
    } else {
        let keyword = prefix(s, i, 6)
        if text.equal_fold(keyword, "public") {
            identifier_part(s, i + 6, true, mut d)
        } else if text.equal_fold(keyword, "system") {
            identifier_part(s, i + 6, false, mut d)
        } else {
            d.quirks = true
            d.next = bogus_doctype(s, i)
        }
    }
    t.pos = d.next
    Token.Doctype(name, d.public_id, d.system_id, d.quirks)
}

fn identifier_part(s: str, at: i64, public: bool, mut d: Declaration) {
    let i = skip_space(s, at)
    if i >= s.len {
        d.quirks = true
        d.next = s.len
        return
    }
    let c = s[i]
    if c == '>' {
        d.quirks = true
        d.next = i + 1
        return
    }
    if c != '"' && c != '\'' {
        d.quirks = true
        d.next = bogus_doctype(s, i)
        return
    }
    read_identifier(s, i + 1, c, public, mut d)
}

fn read_identifier(s: str, start: i64, quote: u8, public: bool, mut d: Declaration) {
    var i = start
    for i < s.len && s[i] != quote && s[i] != '>' {
        i += 1
    }
    let value = replace_null(s[start..i])
    if public {
        d.public_id = value
    } else {
        d.system_id = value
    }
    if i >= s.len {
        d.quirks = true
        d.next = s.len
        return
    }
    if s[i] == '>' {
        d.quirks = true
        d.next = i + 1
        return
    }
    if public {
        after_public_identifier(s, i + 1, mut d)
    } else {
        after_system_identifier(s, i + 1, mut d)
    }
}

fn after_public_identifier(s: str, at: i64, mut d: Declaration) {
    let i = skip_space(s, at)
    if i >= s.len {
        d.quirks = true
        d.next = s.len
        return
    }
    let c = s[i]
    if c == '>' {
        d.next = i + 1
    } else if c == '"' || c == '\'' {
        read_identifier(s, i + 1, c, false, mut d)
    } else {
        d.quirks = true
        d.next = bogus_doctype(s, i)
    }
}

fn after_system_identifier(s: str, at: i64, mut d: Declaration) {
    let i = skip_space(s, at)
    if i >= s.len {
        d.quirks = true
        d.next = s.len
    } else if s[i] == '>' {
        d.next = i + 1
    } else {
        d.next = bogus_doctype(s, i)
    }
}

fn bogus_doctype(s: str, from: i64) -> i64 {
    let close = simd.find_byte_str(s, from, s.len, '>')
    if close < 0 {
        return s.len
    }
    close + 1
}
