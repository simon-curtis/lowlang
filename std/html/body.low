import std/text

fn body_text(p: *Parser, s: str) {
    var rest = s
    for rest.len > 0 {
        rest = body_characters(p, rest)
    }
}

fn in_body(p: *Parser, token: Token) {
    match token {
        Text(content) => body_text(p, content)
        Comment(data) => insert_comment(p, data)
        Instruction(target, data) => insert_instruction(p, target, data)
        Doctype => report(p, "unexpected document type declaration")
        StartTag(name, attributes, self_closing) => in_body_start(p, token, Tag { name, attributes, self_closing })
        EndTag(name) => in_body_end(p, token, name)
        End => {
            if p.templates.len > 0 {
                in_template(p, token)
            } else if unclosed_in_body(p) {
                report(p, "unexpected end of input")
            }
        }
    }
}

fn body_allowed_open(name: str) -> bool {
    match name {
        "tbody" => true
        "td" => true
        "tfoot" => true
        "th" => true
        "thead" => true
        "tr" => true
        "body" => true
        "html" => true
        _ => implied_end(name)
    }
}

fn merge_attributes(set: *NameSet, target: *Node, attributes: Attribute[]) {
    if set.node != target {
        set.node = target
        set.names = [:]
        match element(target) {
            some(e) => {
                for a in e.attributes {
                    if a.prefix == "" {
                        set.names[a.name] = true
                    }
                }
            }
            none => {}
        }
    }
    let e = element(target) ?? return
    for a in attributes {
        if set.names[a.name] == none {
            set.names[a.name] = true
            e.attributes.push(Attr { namespace: none, prefix: "", name: a.name, value: a.value })
        }
    }
}

fn in_body_start(p: *Parser, token: Token, tag: Tag) {
    match tag.name {
        "html" => {
            report(p, "unexpected html start tag")
            if !has_template(p) {
                merge_attributes(p.root_names, root_node(p), tag.attributes)
            }
        }
        "base" => in_head(p, token)
        "basefont" => in_head(p, token)
        "bgsound" => in_head(p, token)
        "link" => in_head(p, token)
        "meta" => in_head(p, token)
        "noframes" => in_head(p, token)
        "script" => in_head(p, token)
        "style" => in_head(p, token)
        "template" => in_head(p, token)
        "title" => in_head(p, token)
        "body" => start_body(p, tag)
        "frameset" => start_frameset(p, tag)
        "address" => start_block(p, tag)
        "article" => start_block(p, tag)
        "aside" => start_block(p, tag)
        "blockquote" => start_block(p, tag)
        "center" => start_block(p, tag)
        "details" => start_block(p, tag)
        "dialog" => start_block(p, tag)
        "dir" => start_block(p, tag)
        "div" => start_block(p, tag)
        "dl" => start_block(p, tag)
        "fieldset" => start_block(p, tag)
        "figcaption" => start_block(p, tag)
        "figure" => start_block(p, tag)
        "footer" => start_block(p, tag)
        "header" => start_block(p, tag)
        "hgroup" => start_block(p, tag)
        "main" => start_block(p, tag)
        "menu" => start_block(p, tag)
        "nav" => start_block(p, tag)
        "ol" => start_block(p, tag)
        "p" => start_block(p, tag)
        "search" => start_block(p, tag)
        "section" => start_block(p, tag)
        "summary" => start_block(p, tag)
        "ul" => start_block(p, tag)
        "h1" => start_heading(p, tag)
        "h2" => start_heading(p, tag)
        "h3" => start_heading(p, tag)
        "h4" => start_heading(p, tag)
        "h5" => start_heading(p, tag)
        "h6" => start_heading(p, tag)
        "pre" => start_pre(p, tag)
        "listing" => start_pre(p, tag)
        "form" => start_form(p, tag)
        "li" => start_list_item(p, tag)
        "dd" => start_definition(p, tag)
        "dt" => start_definition(p, tag)
        "plaintext" => {
            close_p_in_button_scope(p)
            insert_html(p, tag)
            switch_state(p.tk, State.Plain, "")
        }
        "button" => start_button(p, tag)
        "a" => start_anchor(p, tag)
        "b" => start_formatting(p, tag)
        "big" => start_formatting(p, tag)
        "code" => start_formatting(p, tag)
        "em" => start_formatting(p, tag)
        "font" => start_formatting(p, tag)
        "i" => start_formatting(p, tag)
        "s" => start_formatting(p, tag)
        "small" => start_formatting(p, tag)
        "strike" => start_formatting(p, tag)
        "strong" => start_formatting(p, tag)
        "tt" => start_formatting(p, tag)
        "u" => start_formatting(p, tag)
        "nobr" => start_nobr(p, tag)
        "applet" => start_marked(p, tag)
        "marquee" => start_marked(p, tag)
        "object" => start_marked(p, tag)
        "table" => start_table(p, tag)
        "area" => start_void(p, tag)
        "br" => start_void(p, tag)
        "embed" => start_void(p, tag)
        "img" => start_void(p, tag)
        "keygen" => start_void(p, tag)
        "wbr" => start_void(p, tag)
        "input" => start_input(p, tag)
        "param" => head_void(p, tag)
        "source" => head_void(p, tag)
        "track" => head_void(p, tag)
        "hr" => start_hr(p, tag)
        "image" => {
            report(p, "image start tag")
            in_body(p, Token.StartTag("img", tag.attributes, tag.self_closing))
        }
        "textarea" => start_textarea(p, tag)
        "xmp" => {
            close_p_in_button_scope(p)
            reconstruct_formatting(p)
            p.frameset_ok = false
            generic_text(p, tag, State.Raw)
        }
        "iframe" => {
            p.frameset_ok = false
            generic_text(p, tag, State.Raw)
        }
        "noembed" => generic_text(p, tag, State.Raw)
        "select" => start_select(p, tag)
        "option" => start_option(p, tag)
        "optgroup" => start_optgroup(p, tag)
        "rb" => start_ruby_block(p, tag)
        "rtc" => start_ruby_block(p, tag)
        "rp" => start_ruby_text(p, tag)
        "rt" => start_ruby_text(p, tag)
        "math" => start_foreign(p, tag, Namespace.MathMl)
        "svg" => start_foreign(p, tag, Namespace.Svg)
        "caption" => report(p, "unexpected table start tag")
        "col" => report(p, "unexpected table start tag")
        "colgroup" => report(p, "unexpected table start tag")
        "frame" => report(p, "unexpected frame start tag")
        "head" => report(p, "unexpected head start tag")
        "tbody" => report(p, "unexpected table start tag")
        "td" => report(p, "unexpected table start tag")
        "tfoot" => report(p, "unexpected table start tag")
        "th" => report(p, "unexpected table start tag")
        "thead" => report(p, "unexpected table start tag")
        "tr" => report(p, "unexpected table start tag")
        _ => {
            reconstruct_formatting(p)
            insert_html(p, tag)
        }
    }
}

fn start_body(p: *Parser, tag: Tag) {
    report(p, "unexpected body start tag")
    let body = second_node(p) ?? return
    if !is_html(body, "body") || has_template(p) {
        return
    }
    p.frameset_ok = false
    merge_attributes(p.body_names, body, tag.attributes)
}

fn start_frameset(p: *Parser, tag: Tag) {
    report(p, "unexpected frameset start tag")
    let body = second_node(p) ?? return
    if !is_html(body, "body") || !p.frameset_ok {
        return
    }
    remove(body)
    for p.depth > 1 {
        pop_node(p)
    }
    insert_html(p, tag)
    p.mode = Mode.InFrameset
}

fn start_block(p: *Parser, tag: Tag) {
    close_p_in_button_scope(p)
    insert_html(p, tag)
}

fn start_heading(p: *Parser, tag: Tag) {
    close_p_in_button_scope(p)
    if heading_name(html_name(current(p))) {
        report(p, "nested heading")
        pop_node(p)
    }
    insert_html(p, tag)
}

fn start_pre(p: *Parser, tag: Tag) {
    close_p_in_button_scope(p)
    insert_html(p, tag)
    p.skip_lf = true
    p.frameset_ok = false
}

fn start_form(p: *Parser, tag: Tag) {
    if p.form != none && !parsing_template_contents(p) {
        report(p, "nested form")
        return
    }
    close_p_in_button_scope(p)
    let n = insert_html(p, tag)
    if !parsing_template_contents(p) {
        p.form = n
    }
}

fn start_list_item(p: *Parser, tag: Tag) {
    p.frameset_ok = false
    if list_stop_name(p) == "li" {
        generate_implied(p, "li")
        if !is_html(current(p), "li") {
            report(p, "unclosed element before li")
        }
        pop_until(p, "li")
    }
    close_p_in_button_scope(p)
    insert_html(p, tag)
}

fn start_definition(p: *Parser, tag: Tag) {
    p.frameset_ok = false
    let name = list_stop_name(p)
    if name == "dd" || name == "dt" {
        generate_implied(p, name)
        if !is_html(current(p), name) {
            report(p, "unclosed element before dd or dt")
        }
        pop_until(p, name)
    }
    close_p_in_button_scope(p)
    insert_html(p, tag)
}

fn start_button(p: *Parser, tag: Tag) {
    if has_scope(p, "button", Scope.Default) {
        report(p, "nested button")
        generate_implied(p, "")
        pop_until(p, "button")
    }
    reconstruct_formatting(p)
    insert_html(p, tag)
    p.frameset_ok = false
}

fn start_anchor(p: *Parser, tag: Tag) {
    let existing = formatting_last(p, "a")
    if existing >= 0 {
        let n = p.entries[existing].element ?? return
        report(p, "nested anchor")
        adoption_agency(p, "a")
        if p.entries[existing].element == n {
            remove_entry(p, existing)
        }
        remove_open(p, n)
    }
    reconstruct_formatting(p)
    let n = insert_html(p, tag)
    push_formatting(p, n, tag)
}

fn start_formatting(p: *Parser, tag: Tag) {
    reconstruct_formatting(p)
    let n = insert_html(p, tag)
    push_formatting(p, n, tag)
}

fn start_nobr(p: *Parser, tag: Tag) {
    reconstruct_formatting(p)
    if has_scope(p, "nobr", Scope.Default) {
        report(p, "nested nobr")
        adoption_agency(p, "nobr")
        reconstruct_formatting(p)
    }
    let n = insert_html(p, tag)
    push_formatting(p, n, tag)
}

fn start_marked(p: *Parser, tag: Tag) {
    reconstruct_formatting(p)
    insert_html(p, tag)
    insert_marker(p)
    p.frameset_ok = false
}

fn start_table(p: *Parser, tag: Tag) {
    if p.quirks != QuirksMode.Quirks {
        close_p_in_button_scope(p)
    }
    insert_html(p, tag)
    p.frameset_ok = false
    p.mode = Mode.InTable
}

fn start_void(p: *Parser, tag: Tag) {
    reconstruct_formatting(p)
    insert_html(p, tag)
    pop_node(p)
    p.frameset_ok = false
}

fn context_is(p: *Parser, name: str) -> bool {
    match p.context {
        some(c) => is_html(c, name)
        none => false
    }
}

fn start_input(p: *Parser, tag: Tag) {
    if context_is(p, "select") {
        report(p, "unexpected input start tag")
        return
    }
    if has_scope(p, "select", Scope.Default) {
        report(p, "input in select")
        pop_until(p, "select")
    }
    reconstruct_formatting(p)
    insert_html(p, tag)
    pop_node(p)
    let kind = attribute(tag.attributes, "type") ?? ""
    if !text.equal_fold(kind, "hidden") {
        p.frameset_ok = false
    }
}

fn start_hr(p: *Parser, tag: Tag) {
    close_p_in_button_scope(p)
    if has_scope(p, "select", Scope.Default) {
        generate_implied(p, "")
        if has_scope(p, "option", Scope.Default) || has_scope(p, "optgroup", Scope.Default) {
            report(p, "hr inside option")
        }
    }
    insert_html(p, tag)
    pop_node(p)
    p.frameset_ok = false
}

fn start_textarea(p: *Parser, tag: Tag) {
    insert_html(p, tag)
    p.skip_lf = true
    switch_state(p.tk, State.Escapable, tag.name)
    p.original = p.mode
    p.frameset_ok = false
    p.mode = Mode.Text
}

fn start_select(p: *Parser, tag: Tag) {
    if context_is(p, "select") {
        report(p, "unexpected select start tag")
    } else if has_scope(p, "select", Scope.Default) {
        report(p, "nested select")
        pop_until(p, "select")
    } else {
        reconstruct_formatting(p)
        insert_html(p, tag)
        p.frameset_ok = false
    }
}

fn start_option(p: *Parser, tag: Tag) {
    if has_scope(p, "select", Scope.Default) {
        generate_implied(p, "optgroup")
        if has_scope(p, "option", Scope.Default) {
            report(p, "option inside option")
        }
    } else if is_html(current(p), "option") {
        pop_node(p)
    }
    reconstruct_formatting(p)
    insert_html(p, tag)
}

fn start_optgroup(p: *Parser, tag: Tag) {
    if has_scope(p, "select", Scope.Default) {
        generate_implied(p, "")
        if has_scope(p, "option", Scope.Default) || has_scope(p, "optgroup", Scope.Default) {
            report(p, "optgroup inside option")
        }
    } else if is_html(current(p), "option") {
        pop_node(p)
    }
    reconstruct_formatting(p)
    insert_html(p, tag)
}

fn start_ruby_block(p: *Parser, tag: Tag) {
    if has_scope(p, "ruby", Scope.Default) {
        generate_implied(p, "")
        if !is_html(current(p), "ruby") {
            report(p, "unclosed element in ruby")
        }
    }
    insert_html(p, tag)
}

fn start_ruby_text(p: *Parser, tag: Tag) {
    if has_scope(p, "ruby", Scope.Default) {
        generate_implied(p, "rtc")
        if !is_html(current(p), "rtc") && !is_html(current(p), "ruby") {
            report(p, "unclosed element in ruby")
        }
    }
    insert_html(p, tag)
}

fn start_foreign(p: *Parser, tag: Tag, ns: Namespace) {
    reconstruct_formatting(p)
    insert_foreign(p, tag, ns)
    if tag.self_closing {
        pop_node(p)
    }
}

fn in_body_end(p: *Parser, token: Token, name: str) {
    match name {
        "template" => in_head(p, token)
        "body" => {
            if end_body(p) {
                p.mode = Mode.AfterBody
            }
        }
        "html" => {
            if end_body(p) {
                p.mode = Mode.AfterBody
                dispatch(p, token)
            }
        }
        "address" => end_block(p, name)
        "article" => end_block(p, name)
        "aside" => end_block(p, name)
        "blockquote" => end_block(p, name)
        "button" => end_block(p, name)
        "center" => end_block(p, name)
        "details" => end_block(p, name)
        "dialog" => end_block(p, name)
        "dir" => end_block(p, name)
        "div" => end_block(p, name)
        "dl" => end_block(p, name)
        "fieldset" => end_block(p, name)
        "figcaption" => end_block(p, name)
        "figure" => end_block(p, name)
        "footer" => end_block(p, name)
        "header" => end_block(p, name)
        "hgroup" => end_block(p, name)
        "listing" => end_block(p, name)
        "main" => end_block(p, name)
        "menu" => end_block(p, name)
        "nav" => end_block(p, name)
        "ol" => end_block(p, name)
        "pre" => end_block(p, name)
        "search" => end_block(p, name)
        "section" => end_block(p, name)
        "select" => end_block(p, name)
        "summary" => end_block(p, name)
        "ul" => end_block(p, name)
        "form" => end_form(p)
        "p" => {
            if !has_scope(p, "p", Scope.Button) {
                report(p, "unexpected p end tag")
                insert_plain(p, "p")
            }
            close_p(p)
        }
        "li" => end_list_item(p)
        "dd" => end_definition(p, name)
        "dt" => end_definition(p, name)
        "h1" => end_heading(p, name)
        "h2" => end_heading(p, name)
        "h3" => end_heading(p, name)
        "h4" => end_heading(p, name)
        "h5" => end_heading(p, name)
        "h6" => end_heading(p, name)
        "a" => adoption_agency(p, name)
        "b" => adoption_agency(p, name)
        "big" => adoption_agency(p, name)
        "code" => adoption_agency(p, name)
        "em" => adoption_agency(p, name)
        "font" => adoption_agency(p, name)
        "i" => adoption_agency(p, name)
        "nobr" => adoption_agency(p, name)
        "s" => adoption_agency(p, name)
        "small" => adoption_agency(p, name)
        "strike" => adoption_agency(p, name)
        "strong" => adoption_agency(p, name)
        "tt" => adoption_agency(p, name)
        "u" => adoption_agency(p, name)
        "applet" => end_marked(p, name)
        "marquee" => end_marked(p, name)
        "object" => end_marked(p, name)
        "br" => {
            report(p, "unexpected br end tag")
            in_body(p, Token.StartTag("br", [], false))
        }
        _ => any_other_end_tag(p, name)
    }
}

fn end_body(p: *Parser) -> bool {
    if !has_scope(p, "body", Scope.Default) {
        report(p, "unexpected body end tag")
        return false
    }
    if unclosed_in_body(p) {
        report(p, "unclosed element at end of body")
    }
    true
}

fn end_block(p: *Parser, name: str) {
    if !has_scope(p, name, Scope.Default) {
        report(p, "unexpected end tag")
        return
    }
    generate_implied(p, "")
    if !is_html(current(p), name) {
        report(p, "unclosed element before end tag")
    }
    pop_until(p, name)
}

fn end_form(p: *Parser) {
    if !parsing_template_contents(p) {
        let node = p.form
        p.form = none
        let form = node ?? {
            report(p, "unexpected form end tag")
            return
        }
        if !has_node_in_scope(p, form, Scope.Default) {
            report(p, "unexpected form end tag")
            return
        }
        generate_implied(p, "")
        if current(p) != form {
            report(p, "unclosed element before form end tag")
        }
        remove_open(p, form)
        return
    }
    if !has_scope(p, "form", Scope.Default) {
        report(p, "unexpected form end tag")
        return
    }
    generate_implied(p, "")
    if !is_html(current(p), "form") {
        report(p, "unclosed element before form end tag")
    }
    pop_until(p, "form")
}

fn end_list_item(p: *Parser) {
    if !has_scope(p, "li", Scope.ListItem) {
        report(p, "unexpected li end tag")
        return
    }
    generate_implied(p, "li")
    if !is_html(current(p), "li") {
        report(p, "unclosed element before li end tag")
    }
    pop_until(p, "li")
}

fn end_definition(p: *Parser, name: str) {
    if !has_scope(p, name, Scope.Default) {
        report(p, "unexpected end tag")
        return
    }
    generate_implied(p, name)
    if !is_html(current(p), name) {
        report(p, "unclosed element before end tag")
    }
    pop_until(p, name)
}

fn end_heading(p: *Parser, name: str) {
    if !has_heading_in_scope(p) {
        report(p, "unexpected heading end tag")
        return
    }
    generate_implied(p, "")
    if !is_html(current(p), name) {
        report(p, "unclosed element before heading end tag")
    }
    pop_until_heading(p)
}

fn end_marked(p: *Parser, name: str) {
    if !has_scope(p, name, Scope.Default) {
        report(p, "unexpected end tag")
        return
    }
    generate_implied(p, "")
    if !is_html(current(p), name) {
        report(p, "unclosed element before end tag")
    }
    pop_until(p, name)
    clear_formatting_to_marker(p)
}
