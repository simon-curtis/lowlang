import std/html
import std/text

fn names(nodes: []*html.Node) -> str {
    var parts: []str = []
    for n in nodes {
        push(mut parts, html.attr(n, "id") ?? html.local_name(n))
    }
    text.join(parts, " ")
}

fn find(root: *html.Node, source: str) {
    let compiled = html.compile(source) catch {
        Invalid(at, message) => {
            print("{source}: error at {at}: {message}")
            return
        }
    }
    print("{source}: {names(html.query_all(root, compiled))}")
}

/// Compiles CSS selectors once and matches them against a parsed page.
fn main() {
    let page = html.parse("<main id=m><h1 id=title class='big top'>Fixtures</h1><ul id=list><li id=a class=on>Arsenal<li id=b>Brighton<li id=c class=on><a id=link href=https://example.com/c>Chelsea</a></ul><form><input id=x type=checkbox checked><input id=y disabled><select><option id=o1>1<option id=o2 selected>2</select></form></main>")
    let root = page.root

    find(root, "li")
    find(root, "ul > li.on")
    find(root, "li + li")
    find(root, "li ~ li:last-child")
    find(root, "li:nth-child(2n+1)")
    find(root, "li:nth-child(odd of .on)")
    find(root, "h1.big.top, #list")
    find(root, "a[href^=https][href$='/c' i]")
    find(root, "li:not(.on)")
    find(root, "ul:has(> li > a)")
    find(root, ":is(h1, li):first-child")
    find(root, ":checked")
    find(root, ":disabled")
    find(root, "input:enabled")
    find(root, "li:empty")
    find(root, "li[")
    find(root, "li:hover")
    find(root, "a b > ")

    let link = html.query(root, html.compile("#link") or return) ?? return
    let item = html.closest(link, html.compile("li") or return) ?? return
    print("closest li of link: {html.attr(item, "id") ?? ""}")
    print("link matches ul a: {html.matches(link, html.compile("ul a") or return)}")
}
