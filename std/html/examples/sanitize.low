import std/html

fn show(label: str, input: str, policy: html.Policy) {
    print("{label}: {html.sanitize(input, policy)}")
}

/// Cleans untrusted markup with the default policy and with one that lets through a few more elements.
fn main() {
    let policy = html.default_policy()
    show("script", "<p>Hello</p><script>alert(1)</script>", policy)
    show("handler", "<img src=/cat.png alt=cat onerror=alert(1)>", policy)
    show("url", "<a href=\" JaVa&Tab;Script:alert(1)\">bad</a> <a href=\"https://example.com/\">good</a> <a href=/local>local</a>", policy)
    show("srcset", "<img srcset=\"a.png 1x, javascript:alert(1) 2x\">", policy)
    show("unwrap", "<custom-box><font color=red>kept <b>text</b></font></custom-box>", policy)
    show("style", "<style>p {{ color: red }}</style><p style=\"x\" class=note>styled</p>", policy)
    show("foreign", "<svg><script>alert(1)</script></svg><math><mi>x</mi></math>done", policy)
    show("mutation", "<svg></p><style><a id=\"</style><img src=1 onerror=alert(1)>\">", policy)
    show("comment", "a<!-- b --><?pi c?>d", policy)

    var element_attributes: [str: str[]] = [:]
    for name, attributes in policy.element_attributes {
        element_attributes[name] = attributes
    }
    element_attributes["svg"] = ["viewbox"]
    element_attributes["path"] = ["d"]
    let drawing = html.Policy {
        elements: policy.elements,
        attributes: policy.attributes,
        element_attributes,
        url_schemes: policy.url_schemes,
        relative_urls: false,
        drop_content: policy.drop_content,
        svg_elements: ["svg", "path"],
        mathml_elements: []
    }
    show("svg", "<svg viewBox=\"0 0 1 1\" onload=alert(1)><path d=\"M0 0L1 1\"/><script>x</script></svg><a href=/local>l</a>", drawing)
}
