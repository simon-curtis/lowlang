import std/html
import std/text

/// Extracts the title, links and visible text from a page with the tokenizer, then escapes and unescapes text.
fn main() {
    let page = "<!DOCTYPE html>\n<html><head><title>Fish &amp; Chips</title><style>p {{ color: red }}</style></head>\n<body>\n<!-- navigation -->\n<a href=\"/menu?lang=en&amp;page=2\" class=nav>Menu</a>\n<p>Fried <b>cod</b> &lt; 10 minutes<br/>Salt &#38; vinegar</p>\n<script>if (a < b && c) {{ run() }}</script>\n<A HREF='https://example.com/' target=_blank>Home</A>\n</body></html>"

    let t = html.tokenizer(page)
    var links: []str = []
    var words: []str = []
    var hidden = false
    var title = ""
    var in_title = false
    for {
        match html.next(t) {
            Doctype(name, public_id, system_id) => print("doctype {name}")
            StartTag(name, attributes, self_closing) => {
                if name == "script" || name == "style" {
                    hidden = true
                }
                in_title = name == "title"
                if name == "a" {
                    push(mut links, html.attribute(attributes, "href") ?? "-")
                }
            }
            EndTag(name) => {
                if name == "script" || name == "style" {
                    hidden = false
                }
                in_title = false
            }
            Text(content) => {
                if in_title {
                    title = content
                } else if !hidden {
                    for word in text.fields(content) {
                        push(mut words, word)
                    }
                }
            }
            Comment(content) => print("comment [{content}]")
            End => break
        }
    }
    print("title {title}")
    print("links {text.join(links, ", ")}")
    print("text {text.join(words, " ")}")

    let user = "<script>alert(\"hi\" & 'bye')</script>"
    let safe = html.escape(user)
    print(safe)
    print(html.unescape(safe) == user)
    print(html.unescape("&copy; 2025 &#x41;&#66; &unknown; &lt"))
}
