import std/html

fn depth(n: *html.Node) -> i64 {
    var d = 0
    var current = html.parent(n)
    for {
        let p = current ?? break
        d += 1
        current = html.parent(p)
    }
    d
}

/// Parses misnested markup into the tree a browser builds, walks it and serializes it.
fn main() {
    let parsed = html.parse("<!DOCTYPE html><title>Menu</title><p>Fish <b>and <i>chips</b> with</i> peas<table><tr><td>cell<td>next</table><ul><li>one<li>two</ul>")
    print("quirks {parsed.quirks}")

    let everything = html.compile("*") or return
    for n in html.query_all(parsed.root, everything) {
        let pad = "  "
        var indent = ""
        for _ in 0..depth(n) {
            indent = "{indent}{pad}"
        }
        print("{indent}{html.local_name(n)}")
    }

    let body = html.query(parsed.root, html.compile("body") or return) ?? return
    print(html.inner_html(body))
    print(html.text_content(body))

    let fragment = html.parse_fragment(html.create_element(html.Namespace.Html, "table", []), "<tr><td>a<td>b")
    print(html.inner_html(fragment.root))

    let list = html.create_element(html.Namespace.Html, "ul", [])
    let item = html.create_element(html.Namespace.Html, "li", [])
    html.append_child(item, html.create_text("1 < 2 & \"3\"")) or return
    html.append_child(list, item) or return
    html.set_attr(item, "title", "a \"b\" & c")
    print(html.outer_html(list))
}
