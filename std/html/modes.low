import std/text

fn characters(p: *Parser, s: str) {
    var rest = s
    for rest.len > 0 {
        rest = consume(p, rest)
    }
}

fn consume(p: *Parser, s: str) -> str {
    match p.mode {
        Initial => {
            let n = space_prefix(s)
            if n > 0 {
                return s[n..]
            }
            report(p, "missing document type declaration")
            p.quirks = QuirksMode.Quirks
            p.mode = Mode.BeforeHtml
            s
        }
        BeforeHtml => {
            let n = space_prefix(s)
            if n > 0 {
                return s[n..]
            }
            create_html_root(p)
            p.mode = Mode.BeforeHead
            s
        }
        BeforeHead => {
            let n = space_prefix(s)
            if n > 0 {
                return s[n..]
            }
            p.head = insert_plain(p, "head")
            p.mode = Mode.InHead
            s
        }
        InHead => {
            let n = space_prefix(s)
            if n > 0 {
                insert_text(p, s[..n])
                return s[n..]
            }
            pop_node(p)
            p.mode = Mode.AfterHead
            s
        }
        InHeadNoscript => {
            let n = space_prefix(s)
            if n > 0 {
                insert_text(p, s[..n])
                return s[n..]
            }
            report(p, "unexpected text in noscript")
            pop_node(p)
            p.mode = Mode.InHead
            s
        }
        AfterHead => {
            let n = space_prefix(s)
            if n > 0 {
                insert_text(p, s[..n])
                return s[n..]
            }
            insert_plain(p, "body")
            p.frameset_ok = true
            p.mode = Mode.InBody
            s
        }
        InBody => body_characters(p, s)
        Text => {
            insert_text(p, s)
            ""
        }
        InTable => table_characters(p, s)
        InTableText => {
            let n = text_run(s)
            if n > 0 {
                text.append(mut p.table_text, s[..n])
            }
            let skipped = null_prefix(s[n..])
            s[n + skipped..]
        }
        InCaption => body_characters(p, s)
        InColumnGroup => {
            let n = space_prefix(s)
            if n > 0 {
                insert_text(p, s[..n])
                return s[n..]
            }
            if !is_html(current(p), "colgroup") {
                report(p, "unexpected text in column group")
                return s[word_prefix(s)..]
            }
            pop_node(p)
            p.mode = Mode.InTable
            s
        }
        InTableBody => table_characters(p, s)
        InRow => table_characters(p, s)
        InCell => body_characters(p, s)
        InTemplate => body_characters(p, s)
        AfterBody => {
            let n = space_prefix(s)
            if n > 0 {
                body_characters(p, s[..n])
                return s[n..]
            }
            report(p, "unexpected text after body")
            p.mode = Mode.InBody
            s
        }
        InFrameset => frameset_characters(p, s)
        AfterFrameset => frameset_characters(p, s)
        AfterAfterBody => {
            let n = space_prefix(s)
            if n > 0 {
                body_characters(p, s[..n])
                return s[n..]
            }
            report(p, "unexpected text after body")
            p.mode = Mode.InBody
            s
        }
        AfterAfterFrameset => {
            let n = space_prefix(s)
            if n > 0 {
                body_characters(p, s[..n])
                return s[n..]
            }
            report(p, "unexpected text after frameset")
            s[word_prefix(s)..]
        }
    }
}

fn frameset_characters(p: *Parser, s: str) -> str {
    let n = space_prefix(s)
    if n > 0 {
        insert_text(p, s[..n])
        return s[n..]
    }
    report(p, "unexpected text in frameset")
    s[word_prefix(s)..]
}

fn body_characters(p: *Parser, s: str) -> str {
    let skipped = null_prefix(s)
    if skipped > 0 {
        report(p, "null character")
        return s[skipped..]
    }
    let n = text_run(s)
    let run = s[..n]
    reconstruct_formatting(p)
    insert_text(p, run)
    if !all_space(run) {
        p.frameset_ok = false
    }
    s[n..]
}

fn table_characters(p: *Parser, s: str) -> str {
    let name = html_name(current(p))
    if name == "table" || name == "tbody" || name == "template" || name == "tfoot" || name == "thead" || name == "tr" {
        p.table_text.truncate(0)
        p.original = p.mode
        p.mode = Mode.InTableText
        return s
    }
    report(p, "unexpected text in table")
    p.foster = true
    var rest = s
    for rest.len > 0 {
        rest = body_characters(p, rest)
    }
    p.foster = false
    ""
}

fn create_html_root(p: *Parser) {
    let root = create_element(Namespace.Html, "html", [])
    link(p.document, root, none)
    open_push(p, root)
}

fn initial(p: *Parser, token: Token) {
    match token {
        Text(content) => characters(p, content)
        Comment(data) => insert_comment_at(document_place(p), data)
        Instruction(target, data) => insert_instruction_at(document_place(p), target, data)
        Doctype(name, public_id, system_id, force_quirks) => {
            if name != "html" || public_id != none || (system_id != none && system_id != "about:legacy-compat") {
                report(p, "unexpected document type declaration")
            }
            link(p.document, create_doctype(name, public_id ?? "", system_id ?? ""), none)
            p.quirks = quirks_for(name, public_id, system_id, force_quirks)
            p.mode = Mode.BeforeHtml
        }
        _ => {
            report(p, "missing document type declaration")
            p.quirks = QuirksMode.Quirks
            p.mode = Mode.BeforeHtml
            dispatch(p, token)
        }
    }
}

fn before_html(p: *Parser, token: Token) {
    match token {
        Text(content) => characters(p, content)
        Comment(data) => insert_comment_at(document_place(p), data)
        Instruction(target, data) => insert_instruction_at(document_place(p), target, data)
        Doctype => report(p, "unexpected document type declaration")
        StartTag(name, attributes, self_closing) => {
            if name == "html" {
                let root = create_element(Namespace.Html, "html", make_attrs(attributes))
                link(p.document, root, none)
                open_push(p, root)
                p.mode = Mode.BeforeHead
            } else {
                before_html_default(p, token)
            }
        }
        EndTag(name) => {
            if name == "head" || name == "body" || name == "html" || name == "br" {
                before_html_default(p, token)
            } else {
                report(p, "unexpected end tag")
            }
        }
        End => before_html_default(p, token)
    }
}

fn before_html_default(p: *Parser, token: Token) {
    create_html_root(p)
    p.mode = Mode.BeforeHead
    dispatch(p, token)
}

fn before_head(p: *Parser, token: Token) {
    match token {
        Text(content) => characters(p, content)
        Comment(data) => insert_comment(p, data)
        Instruction(target, data) => insert_instruction(p, target, data)
        Doctype => report(p, "unexpected document type declaration")
        StartTag(name, attributes, self_closing) => {
            if name == "html" {
                in_body(p, token)
            } else if name == "head" {
                p.head = insert_html(p, Tag { name, attributes, self_closing })
                p.mode = Mode.InHead
            } else {
                before_head_default(p, token)
            }
        }
        EndTag(name) => {
            if name == "head" || name == "body" || name == "html" || name == "br" {
                before_head_default(p, token)
            } else {
                report(p, "unexpected end tag")
            }
        }
        End => before_head_default(p, token)
    }
}

fn before_head_default(p: *Parser, token: Token) {
    p.head = insert_plain(p, "head")
    p.mode = Mode.InHead
    dispatch(p, token)
}

fn generic_text(p: *Parser, tag: Tag, state: State) {
    insert_html(p, tag)
    switch_state(p.tk, state, tag.name)
    p.original = p.mode
    p.mode = Mode.Text
}

fn head_void(p: *Parser, tag: Tag) {
    insert_html(p, tag)
    pop_node(p)
}

fn in_head(p: *Parser, token: Token) {
    match token {
        Text(content) => characters(p, content)
        Comment(data) => insert_comment(p, data)
        Instruction(target, data) => insert_instruction(p, target, data)
        Doctype => report(p, "unexpected document type declaration")
        StartTag(name, attributes, self_closing) => in_head_start(p, token, Tag { name, attributes, self_closing })
        EndTag(name) => in_head_end(p, token, name)
        End => in_head_default(p, token)
    }
}

fn in_head_start(p: *Parser, token: Token, tag: Tag) {
    match tag.name {
        "html" => in_body(p, token)
        "base" => head_void(p, tag)
        "basefont" => head_void(p, tag)
        "bgsound" => head_void(p, tag)
        "link" => head_void(p, tag)
        "meta" => head_void(p, tag)
        "title" => generic_text(p, tag, State.Escapable)
        "noscript" => {
            insert_html(p, tag)
            p.mode = Mode.InHeadNoscript
        }
        "noframes" => generic_text(p, tag, State.Raw)
        "style" => generic_text(p, tag, State.Raw)
        "script" => generic_text(p, tag, State.Script)
        "template" => start_template(p, tag)
        "head" => report(p, "unexpected head start tag")
        _ => in_head_default(p, token)
    }
}

fn in_head_end(p: *Parser, token: Token, name: str) {
    match name {
        "head" => {
            pop_node(p)
            p.mode = Mode.AfterHead
        }
        "body" => in_head_default(p, token)
        "html" => in_head_default(p, token)
        "br" => in_head_default(p, token)
        "template" => end_template(p)
        _ => report(p, "unexpected end tag")
    }
}

fn in_head_default(p: *Parser, token: Token) {
    pop_node(p)
    p.mode = Mode.AfterHead
    dispatch(p, token)
}

fn start_template(p: *Parser, tag: Tag) {
    insert_marker(p)
    p.frameset_ok = false
    p.mode = Mode.InTemplate
    p.templates.push(Mode.InTemplate)
    insert_html(p, tag)
}

fn end_template(p: *Parser) {
    if !has_template(p) {
        report(p, "unexpected template end tag")
        return
    }
    generate_thorough(p)
    if !is_html(current(p), "template") {
        report(p, "unclosed element in template")
    }
    pop_until(p, "template")
    clear_formatting_to_marker(p)
    p.templates.pop()
    reset_mode(p)
}

fn in_head_noscript(p: *Parser, token: Token) {
    match token {
        Doctype => report(p, "unexpected document type declaration")
        StartTag(name, attributes, self_closing) => {
            match name {
                "html" => in_body(p, token)
                "basefont" => in_head(p, token)
                "bgsound" => in_head(p, token)
                "link" => in_head(p, token)
                "meta" => in_head(p, token)
                "noframes" => in_head(p, token)
                "style" => in_head(p, token)
                "head" => report(p, "unexpected head start tag")
                "noscript" => report(p, "unexpected noscript start tag")
                _ => noscript_default(p, token)
            }
        }
        EndTag(name) => {
            if name == "noscript" {
                pop_node(p)
                p.mode = Mode.InHead
            } else if name == "br" {
                noscript_default(p, token)
            } else {
                report(p, "unexpected end tag")
            }
        }
        Text(content) => characters(p, content)
        Comment => in_head(p, token)
        Instruction => in_head(p, token)
        End => noscript_default(p, token)
    }
}

fn noscript_default(p: *Parser, token: Token) {
    report(p, "unexpected token in noscript")
    pop_node(p)
    p.mode = Mode.InHead
    dispatch(p, token)
}

fn after_head(p: *Parser, token: Token) {
    match token {
        Text(content) => characters(p, content)
        Comment(data) => insert_comment(p, data)
        Instruction(target, data) => insert_instruction(p, target, data)
        Doctype => report(p, "unexpected document type declaration")
        StartTag(name, attributes, self_closing) => {
            match name {
                "html" => in_body(p, token)
                "body" => {
                    insert_html(p, Tag { name, attributes, self_closing })
                    p.frameset_ok = false
                    p.mode = Mode.InBody
                }
                "frameset" => {
                    insert_html(p, Tag { name, attributes, self_closing })
                    p.mode = Mode.InFrameset
                }
                "base" => head_in_after_head(p, token)
                "basefont" => head_in_after_head(p, token)
                "bgsound" => head_in_after_head(p, token)
                "link" => head_in_after_head(p, token)
                "meta" => head_in_after_head(p, token)
                "noframes" => head_in_after_head(p, token)
                "script" => head_in_after_head(p, token)
                "style" => head_in_after_head(p, token)
                "template" => head_in_after_head(p, token)
                "title" => head_in_after_head(p, token)
                "head" => report(p, "unexpected head start tag")
                _ => after_head_default(p, token)
            }
        }
        EndTag(name) => {
            if name == "template" {
                in_head(p, token)
            } else if name == "body" || name == "html" || name == "br" {
                after_head_default(p, token)
            } else {
                report(p, "unexpected end tag")
            }
        }
        End => after_head_default(p, token)
    }
}

fn head_in_after_head(p: *Parser, token: Token) {
    report(p, "unexpected start tag after head")
    let head = p.head ?? return
    open_push(p, head)
    in_head(p, token)
    remove_open(p, head)
}

fn after_head_default(p: *Parser, token: Token) {
    insert_plain(p, "body")
    p.frameset_ok = true
    p.mode = Mode.InBody
    dispatch(p, token)
}

fn in_text(p: *Parser, token: Token) {
    match token {
        Text(content) => insert_text(p, content)
        EndTag => {
            pop_node(p)
            p.mode = p.original
        }
        End => {
            report(p, "unexpected end of input in text")
            pop_node(p)
            p.mode = p.original
            dispatch(p, token)
        }
        _ => {}
    }
}

fn after_body(p: *Parser, token: Token) {
    match token {
        Text(content) => characters(p, content)
        Comment(data) => insert_comment_at(root_place(p), data)
        Instruction(target, data) => insert_instruction_at(root_place(p), target, data)
        Doctype => report(p, "unexpected document type declaration")
        StartTag(name, _, _) => {
            if name == "html" {
                in_body(p, token)
            } else {
                after_body_default(p, token)
            }
        }
        EndTag(name) => {
            if name == "html" {
                if p.context != none {
                    report(p, "unexpected html end tag")
                } else {
                    p.mode = Mode.AfterAfterBody
                }
            } else {
                after_body_default(p, token)
            }
        }
        End => {}
    }
}

fn after_body_default(p: *Parser, token: Token) {
    report(p, "unexpected token after body")
    p.mode = Mode.InBody
    dispatch(p, token)
}

fn in_frameset(p: *Parser, token: Token) {
    match token {
        Text(content) => characters(p, content)
        Comment(data) => insert_comment(p, data)
        Instruction(target, data) => insert_instruction(p, target, data)
        Doctype => report(p, "unexpected document type declaration")
        StartTag(name, attributes, self_closing) => {
            match name {
                "html" => in_body(p, token)
                "frameset" => {
                    insert_html(p, Tag { name, attributes, self_closing })
                }
                "frame" => head_void(p, Tag { name, attributes, self_closing })
                "noframes" => in_head(p, token)
                _ => report(p, "unexpected start tag in frameset")
            }
        }
        EndTag(name) => {
            if name == "frameset" {
                if p.depth == 1 {
                    report(p, "unexpected frameset end tag")
                } else {
                    pop_node(p)
                    if p.context == none && !is_html(current(p), "frameset") {
                        p.mode = Mode.AfterFrameset
                    }
                }
            } else {
                report(p, "unexpected end tag in frameset")
            }
        }
        End => {
            if p.depth > 1 {
                report(p, "unexpected end of input in frameset")
            }
        }
    }
}

fn after_frameset(p: *Parser, token: Token) {
    match token {
        Text(content) => characters(p, content)
        Comment(data) => insert_comment(p, data)
        Instruction(target, data) => insert_instruction(p, target, data)
        Doctype => report(p, "unexpected document type declaration")
        StartTag(name, _, _) => {
            if name == "html" {
                in_body(p, token)
            } else if name == "noframes" {
                in_head(p, token)
            } else {
                report(p, "unexpected start tag after frameset")
            }
        }
        EndTag(name) => {
            if name == "html" {
                p.mode = Mode.AfterAfterFrameset
            } else {
                report(p, "unexpected end tag after frameset")
            }
        }
        End => {}
    }
}

fn after_after_body(p: *Parser, token: Token) {
    match token {
        Text(content) => characters(p, content)
        Comment(data) => insert_comment_at(document_place(p), data)
        Instruction(target, data) => insert_instruction_at(document_place(p), target, data)
        Doctype => in_body(p, token)
        StartTag(name, _, _) => {
            if name == "html" {
                in_body(p, token)
            } else {
                after_after_body_default(p, token)
            }
        }
        EndTag => after_after_body_default(p, token)
        End => {}
    }
}

fn after_after_body_default(p: *Parser, token: Token) {
    report(p, "unexpected token after body")
    p.mode = Mode.InBody
    dispatch(p, token)
}

fn after_after_frameset(p: *Parser, token: Token) {
    match token {
        Text(content) => characters(p, content)
        Comment(data) => insert_comment_at(document_place(p), data)
        Instruction(target, data) => insert_instruction_at(document_place(p), target, data)
        Doctype => in_body(p, token)
        StartTag(name, _, _) => {
            if name == "html" {
                in_body(p, token)
            } else if name == "noframes" {
                in_head(p, token)
            } else {
                report(p, "unexpected start tag after frameset")
            }
        }
        EndTag => report(p, "unexpected end tag after frameset")
        End => {}
    }
}
