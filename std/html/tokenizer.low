import std/charset
import std/io
import std/simd
import std/text

/// An attribute of a start tag.
pub struct Attribute {
    /// The attribute name, lowercased.
    pub name: str
    /// The attribute value with character references decoded. Empty for an attribute written without a value.
    pub value: str
}

/// One lexical unit of an HTML document.
///
/// The tokenizer does not build a tree and does not repair markup: it reports tags, text, comments, processing instructions and doctypes in source order.
pub enum Token {
    /// An opening tag. `name` is lowercased. `attributes` lists the attributes in source order; when a name repeats, the first occurrence is kept. `self_closing` is `true` when the tag ends in `/>`.
    ///
    /// After `script`, `style`, `xmp`, `iframe`, `noembed` and `noframes` the content up to the matching end tag is one raw `Text` token. After `title` and `textarea` it is one `Text` token with character references decoded. After `plaintext` the rest of the input is one `Text` token.
    StartTag(name: str, attributes: []Attribute, self_closing: bool)
    /// A closing tag. `name` is lowercased and any attributes are discarded.
    EndTag(name: str)
    /// Character data. In ordinary content and in `title` and `textarea`, `content` has character references decoded; inside raw text elements it is verbatim.
    ///
    /// A `<` that does not begin a tag, comment, declaration or processing instruction is part of the text.
    Text(content: str)
    /// A comment. `content` excludes the delimiters. Unknown declarations (`<!...>`), malformed end tags (`</ ...>`) and invalid processing instructions are reported as comments holding the text up to the next `>`.
    Comment(content: str)
    /// A processing instruction `<?target data?>` or `<?target data>`. `target` starts with a letter or `_` and holds letters, digits, `-` and `_`; `data` is the text after the spaces that follow the target, without the closing `?` of `?>`. A `<?` that does not begin a valid target, and the targets `xml` and `xml-stylesheet` in any case, are reported as comments.
    Instruction(target: str, data: str)
    /// A document type declaration. `name` is lowercased and empty when the declaration has none. `public_id` and `system_id` are `none` when absent. `force_quirks` is `true` when the declaration is malformed or cut off by the end of the input.
    Doctype(name: str, public_id: str?, system_id: str?, force_quirks: bool)
    /// The end of the input. Every call to `next` after the last token returns it again.
    End
}

enum State {
    Data
    Raw
    Escapable
    Script
    Plain
}

/// A cursor over an HTML document held in memory.
///
/// Create one with `tokenizer` and read tokens with `next`.
pub struct Tokenizer {
    input: str
    pos: i64
    mode: State
    closer: str
    driven: bool
    cdata: bool
}

/// Returns a tokenizer positioned at the start of `input`.
///
/// Carriage returns and carriage return and line feed pairs in `input` read as line feeds.
pub fn tokenizer(input: str) -> *Tokenizer {
    new(Tokenizer { input: normalize_newlines(input), pos: 0, mode: Data, closer: "", driven: false, cdata: false })
}

/// Returns the next token.
///
/// Returns `End` once the input is exhausted, and on every later call. A tag that is not closed before the end of the input is dropped, as is an empty end tag `</>`.
pub fn next(t: *Tokenizer) -> Token {
    for t.pos < t.input.len {
        match step(t) {
            some(token) => return token
            none => {}
        }
    }
    End
}

/// Returns the value of the first attribute called `name`, or `none` when there is none.
///
/// The comparison is exact; the tokenizer lowercases names, so pass `name` in lowercase.
pub fn attribute(attributes: []Attribute, name: str) -> str? {
    for a in attributes {
        if a.name == name {
            return a.value
        }
    }
    none
}

/// Escapes `s` for HTML text and attribute values.
///
/// `&`, `<`, `>`, `"` and `'` become `&amp;`, `&lt;`, `&gt;`, `&quot;` and `&#39;`. A string with none of them is returned as it is.
pub fn escape(s: str) -> str {
    var clean = true
    for i in 0..s.len {
        let ch = s[i]
        if ch == '&' || ch == '<' || ch == '>' || ch == '"' || ch == '\'' {
            clean = false
            break
        }
    }
    if clean {
        return s
    }
    var out: []u8 = []
    for i in 0..s.len {
        let ch = s[i]
        match ch {
            '&' => text.append(mut out, "&amp;")
            '<' => text.append(mut out, "&lt;")
            '>' => text.append(mut out, "&gt;")
            '"' => text.append(mut out, "&quot;")
            '\'' => text.append(mut out, "&#39;")
            _ => push(mut out, ch)
        }
    }
    __str_view(out)
}

/// Decodes the HTML character references in `s`: named references, decimal references such as `&#65;` and hexadecimal references such as `&#x41;`.
///
/// Named references without a closing `;` are decoded when they are one of the historic names. Numeric references to zero, surrogates and values above `U+10FFFF` become `U+FFFD`, and values from `0x80` to `0x9F` are read as Windows-1252. An unknown reference is left as written.
pub fn unescape(s: str) -> str {
    decode(s, false)
}

fn space(c: u8) -> bool {
    c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == 0x0C
}

fn alpha(c: u8) -> bool {
    (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
}

fn alnum(c: u8) -> bool {
    alpha(c) || (c >= '0' && c <= '9')
}

fn skip_space(s: str, from: i64) -> i64 {
    var i = from
    for i < s.len && space(s[i]) {
        i += 1
    }
    i
}

fn prefix(s: str, at: i64, n: i64) -> str {
    if at + n < s.len { s[at..at + n] } else { s[at..] }
}

fn step(t: *Tokenizer) -> Token? {
    match t.mode {
        Data => data(t)
        Raw => raw_text(t, false)
        Escapable => raw_text(t, true)
        Script => raw_text(t, false)
        Plain => {
            let content = t.input[t.pos..]
            t.pos = t.input.len
            Token.Text(replace_null(content))
        }
    }
}

fn normalize_newlines(s: str) -> str {
    let first = simd.find_byte_str(s, 0, s.len, '\r')
    if first < 0 {
        return s
    }
    var out: []u8 = []
    text.append(mut out, s[..first])
    var i = first
    for i < s.len {
        let c = s[i]
        if c == '\r' {
            push(mut out, '\n')
            if i + 1 < s.len && s[i + 1] == '\n' {
                i += 1
            }
        } else {
            push(mut out, c)
        }
        i += 1
    }
    __str_view(out)
}

fn replace_null(s: str) -> str {
    let first = simd.find_byte_str(s, 0, s.len, 0)
    if first < 0 {
        return s
    }
    var out: []u8 = []
    text.append(mut out, s[..first])
    for i in first..s.len {
        if s[i] == 0 {
            text.append_char(mut out, 0xFFFD)
        } else {
            push(mut out, s[i])
        }
    }
    __str_view(out)
}

fn switch_state(t: *Tokenizer, mode: State, closer: str) {
    t.mode = mode
    t.closer = closer
}

fn starts_markup(s: str, at: i64) -> bool {
    if at + 1 >= s.len {
        return false
    }
    let c = s[at + 1]
    alpha(c) || c == '!' || c == '?' || (c == '/' && at + 2 < s.len)
}

fn text_end(s: str, from: i64) -> i64 {
    var at = from
    for {
        at = simd.find_byte_str(s, at, s.len, '<')
        if at < 0 {
            return s.len
        }
        if starts_markup(s, at) {
            return at
        }
        at += 1
    }
}

fn data(t: *Tokenizer) -> Token? {
    let s = t.input
    if s[t.pos] == '<' && starts_markup(s, t.pos) {
        return markup(t)
    }
    let end = text_end(s, t.pos + 1)
    let content = s[t.pos..end]
    t.pos = end
    Token.Text(decode(content, false))
}

fn closing(s: str, from: i64, name: str) -> i64 {
    var at = from
    for {
        at = simd.find_byte_str(s, at, s.len, '<')
        if at < 0 {
            return s.len
        }
        let after = at + 2 + name.len
        if after < s.len && s[at + 1] == '/' && text.equal_fold(s[at + 2..after], name) && (space(s[after]) || s[after] == '/' || s[after] == '>') {
            return at
        }
        at += 1
    }
}

fn raw_text(t: *Tokenizer, escapable: bool) -> Token? {
    let end = if t.closer.len == 0 { t.input.len } else if t.mode == Script { script_end(t.input, t.pos, t.closer) } else { closing(t.input, t.pos, t.closer) }
    if end == t.pos {
        t.mode = Data
        return tag(t, end + 2, true)
    }
    let content = t.input[t.pos..end]
    t.pos = end
    if escapable {
        return Token.Text(replace_null(decode(content, false)))
    }
    Token.Text(replace_null(content))
}

fn markup(t: *Tokenizer) -> Token? {
    let s = t.input
    let c = s[t.pos + 1]
    if c == '/' {
        let d = s[t.pos + 2]
        if alpha(d) {
            return tag(t, t.pos + 2, true)
        }
        if d == '>' {
            t.pos += 3
            return none
        }
        return bogus_comment(t, t.pos + 2)
    }
    match c {
        '?' => instruction(t, t.pos + 2)
        '!' => declaration(t, t.pos + 2)
        _ => tag(t, t.pos + 1, false)
    }
}

fn tag(t: *Tokenizer, from: i64, end: bool) -> Token? {
    let s = t.input
    var i = from
    for i < s.len && !space(s[i]) && s[i] != '/' && s[i] != '>' {
        i += 1
    }
    let name = replace_null(text.lower(s[from..i]))
    var attributes: []Attribute = []
    var seen: [str: bool]? = none
    var self_closing = false
    for {
        if i >= s.len {
            t.pos = s.len
            return none
        }
        let c = s[i]
        if c == '>' {
            i += 1
            break
        }
        if c == '/' && i + 1 < s.len && s[i + 1] == '>' {
            self_closing = true
            i += 2
            break
        }
        if space(c) || c == '/' {
            i += 1
            continue
        }
        i = read_attribute(s, i, mut attributes, mut seen)
    }
    t.pos = i
    if end {
        return Token.EndTag(name)
    }
    if !t.driven {
        enter(t, name)
    }
    Token.StartTag(name, attributes, self_closing)
}

fn read_attribute(s: str, from: i64, mut attributes: []Attribute, mut seen: [str: bool]?) -> i64 {
    var i = from + 1
    for i < s.len && !space(s[i]) && s[i] != '/' && s[i] != '>' && s[i] != '=' {
        i += 1
    }
    let name = replace_null(text.lower(s[from..i]))
    var at = skip_space(s, i)
    var value = ""
    if at < s.len && s[at] == '=' {
        at = skip_space(s, at + 1)
        let quoted = at < s.len && (s[at] == '"' || s[at] == '\'')
        if quoted {
            let close = simd.find_byte_str(s, at + 1, s.len, s[at])
            let end = if close < 0 { s.len } else { close }
            value = replace_null(decode(s[at + 1..end], true))
            at = end + 1
        } else {
            let start = at
            for at < s.len && !space(s[at]) && s[at] != '>' {
                at += 1
            }
            value = replace_null(decode(s[start..at], true))
        }
    }
    if !repeated(attributes, seen, name) {
        push(mut attributes, Attribute { name, value })
        remember(attributes, mut seen)
    }
    at
}

fn repeated(attributes: []Attribute, seen: [str: bool]?, name: str) -> bool {
    match seen {
        some(names) => names[name] != none
        none => attribute(attributes, name) != none
    }
}

fn remember(attributes: []Attribute, mut seen: [str: bool]?) {
    match seen {
        some(names) => {
            names[attributes[attributes.len - 1].name] = true
        }
        none => {
            if attributes.len >= 8 {
                var names: [str: bool] = [:]
                for a in attributes {
                    names[a.name] = true
                }
                seen = names
            }
        }
    }
}

fn enter(t: *Tokenizer, name: str) {
    match name {
        "script" => switch_state(t, Script, name)
        "style" => switch_state(t, Raw, name)
        "xmp" => switch_state(t, Raw, name)
        "iframe" => switch_state(t, Raw, name)
        "noembed" => switch_state(t, Raw, name)
        "noframes" => switch_state(t, Raw, name)
        "title" => switch_state(t, Escapable, name)
        "textarea" => switch_state(t, Escapable, name)
        "plaintext" => switch_state(t, Plain, "")
        _ => {}
    }
}

fn declaration(t: *Tokenizer, from: i64) -> Token? {
    let s = t.input
    if text.starts_with(s[from..], "--") {
        return comment(t, from + 2)
    }
    if text.equal_fold(prefix(s, from, 7), "doctype") {
        return doctype(t, from + 7)
    }
    if t.cdata && text.starts_with(s[from..], "[CDATA[") {
        return cdata_section(t, from + 7)
    }
    bogus_comment(t, from)
}

fn cdata_section(t: *Tokenizer, from: i64) -> Token? {
    let s = t.input
    let end = text.index(s[from..], "]]>")
    if end < 0 {
        t.pos = s.len
        if from < s.len {
            return Token.Text(s[from..])
        }
        return none
    }
    t.pos = from + end + 3
    if end == 0 {
        return none
    }
    Token.Text(s[from..from + end])
}

fn instruction(t: *Tokenizer, from: i64) -> Token? {
    let s = t.input
    if from >= s.len {
        t.pos = s.len
        return none
    }
    if !alpha(s[from]) && s[from] != '_' {
        return bogus_comment(t, from - 1)
    }
    var i = from
    for i < s.len && (alnum(s[i]) || s[i] == '-' || s[i] == '_') {
        i += 1
    }
    if i >= s.len {
        t.pos = s.len
        return none
    }
    let target = s[from..i]
    let ends = space(s[i]) || s[i] == '?' || s[i] == '>'
    if !ends || text.equal_fold(target, "xml") || text.equal_fold(target, "xml-stylesheet") {
        return bogus_comment(t, from - 1)
    }
    let start = skip_space(s, i)
    let close = simd.find_byte_str(s, start, s.len, '>')
    if close < 0 {
        t.pos = s.len
        return none
    }
    t.pos = close + 1
    var data = s[start..close]
    if data.len > 0 && data[data.len - 1] == '?' {
        data = data[..data.len - 1]
    }
    Token.Instruction(target, data)
}

fn bogus_comment(t: *Tokenizer, from: i64) -> Token? {
    let s = t.input
    let close = simd.find_byte_str(s, from, s.len, '>')
    if close < 0 {
        t.pos = s.len
        return Token.Comment(replace_null(s[from..]))
    }
    t.pos = close + 1
    Token.Comment(replace_null(s[from..close]))
}

fn comment(t: *Tokenizer, from: i64) -> Token? {
    let s = t.input
    let rest = s[from..]
    if text.starts_with(rest, ">") {
        t.pos = from + 1
        return Token.Comment("")
    }
    if text.starts_with(rest, "->") {
        t.pos = from + 2
        return Token.Comment("")
    }
    var at = from
    for {
        let dash = text.index(s[at..], "--")
        if dash < 0 {
            t.pos = s.len
            return Token.Comment(replace_null(unterminated_comment(s, from)))
        }
        let close = at + dash
        let tail = s[close + 2..]
        if text.starts_with(tail, ">") {
            t.pos = close + 3
            return Token.Comment(replace_null(s[from..close]))
        }
        if text.starts_with(tail, "!>") {
            t.pos = close + 4
            return Token.Comment(replace_null(s[from..close]))
        }
        at = close + 1
    }
}

fn unterminated_comment(s: str, from: i64) -> str {
    let content = s[from..]
    for ending in ["--!", "--", "-"] {
        if text.ends_with(content, ending) {
            return content[..content.len - ending.len]
        }
    }
    content
}

fn decode(s: str, in_attribute: bool) -> str {
    var amp = simd.find_byte_str(s, 0, s.len, '&')
    if amp < 0 {
        return s
    }
    var out: []u8 = []
    var from = 0
    for amp >= 0 {
        text.append(mut out, s[from..amp])
        from = reference(s, amp, in_attribute, mut out)
        amp = simd.find_byte_str(s, from, s.len, '&')
    }
    text.append(mut out, s[from..])
    __str_view(out)
}

fn reference(s: str, at: i64, in_attribute: bool, mut out: []u8) -> i64 {
    if at + 1 < s.len && s[at + 1] == '#' {
        return numeric(s, at, mut out)
    }
    var run = at + 1
    for run < s.len && run - at <= max_entity_name && alnum(s[run]) {
        run += 1
    }
    let terminated = if run < s.len && s[run] == ';' { entity(s[at + 1..run + 1]) ?? "" } else { "" }
    if terminated.len > 0 {
        text.append(mut out, terminated)
        return run + 1
    }
    var end = run
    for end > at + 1 {
        let value = entity(s[at + 1..end]) ?? ""
        if value.len > 0 {
            if in_attribute && end < s.len && (s[end] == '=' || alnum(s[end])) {
                break
            }
            text.append(mut out, value)
            return end
        }
        end -= 1
    }
    push(mut out, '&')
    at + 1
}

fn digit_value(c: u8, hex: bool) -> i64 {
    let d = text.hex_digit(c)
    if hex || d < 10 {
        return d
    }
    -1
}

fn numeric(s: str, at: i64, mut out: []u8) -> i64 {
    var i = at + 2
    let hex = i < s.len && (s[i] == 'x' || s[i] == 'X')
    if hex {
        i += 1
    }
    let base: u32 = if hex { 16 } else { 10 }
    let start = i
    var value: u32 = 0
    for i < s.len {
        let d = digit_value(s[i], hex)
        if d < 0 {
            break
        }
        if value <= 0x10FFFF {
            value = value * base + u32(d)
        }
        i += 1
    }
    if i == start {
        push(mut out, '&')
        return at + 1
    }
    if i < s.len && s[i] == ';' {
        i += 1
    }
    text.append_char(mut out, character(value))
    i
}

fn character(v: u32) -> u32 {
    if v == 0 || !text.is_scalar(v) {
        return 0xFFFD
    }
    if v >= 0x80 && v < 0xA0 {
        return charset.windows_1252(u8(v))
    }
    v
}

fn entity(name: str) -> str? {
    let index = entity_index_table()
    let names = entity_names_table()
    var low = 0
    var high = index.len / entity_size
    for low < high {
        let middle = (low + high) / 2
        let at = middle * entity_size
        let name_at = i64(io.u16_le_str(index, at + entity_name_offset))
        let probe = names[name_at..name_at + i64(index[at + entity_name_length_offset])]
        if probe == name {
            let values = entity_values_table()
            let value_at = i64(io.u16_le_str(index, at + entity_value_offset))
            return values[value_at..value_at + i64(index[at + entity_value_length_offset])]
        }
        if probe < name {
            low = middle + 1
        } else {
            high = middle
        }
    }
    none
}
