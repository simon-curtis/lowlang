import std/text

/// Why a selector failed to compile.
pub enum SelectorError {
    /// The selector is malformed or uses an unsupported feature.
    ///
    /// `at` is the byte offset in the selector text and `message` describes the problem, such as `expected a selector`, `unknown pseudo-class :hover` or `unterminated string`.
    Invalid(at: i64, message: str)
}

/// A compiled selector list.
///
/// Made by `compile` once and matched against any number of nodes by `matches`, `closest`, `query` and `query_all`. A `Selector` is not changed by matching.
pub struct Selector {
    alternatives: Complex[]
}

enum Combinator {
    Descendant
    Child
    Next
    Subsequent
}

enum Operator {
    Exists
    Equals
    Includes
    DashMatch
    Prefix
    Suffix
    Substring
}

enum Folding {
    Default
    Insensitive
    Sensitive
}

enum Simple {
    Type(name: str)
    Universal
    Class(name: str)
    Id(name: str)
    Attribute(name: str, op: Operator, value: str, fold: Folding)
    Not(list: Complex[])
    Is(list: Complex[])
    Has(list: Relative[])
    Nth(a: i64, b: i64, last: bool, of_type: bool, filter: Complex[])
    Empty
    Root
    Checked
    Disabled
    Enabled
}

struct Part {
    link: Combinator
    compound: Simple[]
}

struct Complex {
    parts: Part[]
}

struct Relative {
    link: Combinator
    complex: Complex
}

/// Returns `true` when `n` is an element that `sel` selects.
///
/// The whole tree above `n` takes part in the match, so `div > p` matches a `p` whose parent is a `div` wherever the tree is rooted. A node that is not an element never matches.
pub fn matches(n: *Node, sel: Selector) -> bool {
    is_element(n) && match_list(sel.alternatives, n, is_quirks(n))
}

/// Returns `n` when `sel` selects it, otherwise its nearest ancestor that `sel` selects, or `none` when no element on the way up does.
pub fn closest(n: *Node, sel: Selector) -> *Node? {
    var current: *Node? = n
    for {
        let c = current ?? return none
        if matches(c, sel) {
            return c
        }
        current = c.parent
    }
}

/// Returns the first descendant of `root` in tree order that `sel` selects, or `none`.
///
/// `root` itself and the content of `template` elements are not searched.
pub fn query(root: *Node, sel: Selector) -> *Node? {
    var current = root.first_child
    for {
        let c = current ?? return none
        if matches(c, sel) {
            return c
        }
        current = descend(c, root)
    }
}

/// Returns every descendant of `root` that `sel` selects, in tree order.
///
/// `root` itself and the content of `template` elements are not searched.
pub fn query_all(root: *Node, sel: Selector) -> *Node[] {
    var out: *Node[] = []
    var current = root.first_child
    for {
        let c = current ?? break
        if matches(c, sel) {
            out.push(c)
        }
        current = descend(c, root)
    }
    out
}

fn match_list(list: Complex[], e: *Node, q: bool) -> bool {
    for c in list {
        if match_chain(c, c.parts.len - 1, e, none, Combinator.Descendant, q) {
            return true
        }
    }
    false
}

fn match_chain(c: Complex, i: i64, e: *Node, anchor: *Node?, lead: Combinator, q: bool) -> bool {
    let part = c.parts[i]
    if !match_compound(part.compound, e, q) {
        return false
    }
    if i == 0 {
        let a = anchor ?? return true
        return related(a, e, lead)
    }
    match part.link {
        Child => {
            let p = parent_element(e) ?? return false
            match_chain(c, i - 1, p, anchor, lead, q)
        }
        Descendant => {
            var p = parent_element(e)
            for {
                let x = p ?? return false
                if match_chain(c, i - 1, x, anchor, lead, q) {
                    return true
                }
                p = parent_element(x)
            }
        }
        Next => {
            let p = previous_element(e) ?? return false
            match_chain(c, i - 1, p, anchor, lead, q)
        }
        Subsequent => {
            var p = previous_element(e)
            for {
                let x = p ?? return false
                if match_chain(c, i - 1, x, anchor, lead, q) {
                    return true
                }
                p = previous_element(x)
            }
        }
    }
}

fn related(anchor: *Node, e: *Node, link: Combinator) -> bool {
    match link {
        Child => parent_element(e) == anchor
        Descendant => {
            var p = parent_element(e)
            for {
                let x = p ?? return false
                if x == anchor {
                    return true
                }
                p = parent_element(x)
            }
        }
        Next => previous_element(e) == anchor
        Subsequent => {
            var p = previous_element(e)
            for {
                let x = p ?? return false
                if x == anchor {
                    return true
                }
                p = previous_element(x)
            }
        }
    }
}

fn parent_element(n: *Node) -> *Node? {
    let p = n.parent ?? return none
    if is_element(p) { p } else { none }
}

fn previous_element(n: *Node) -> *Node? {
    var s = n.previous
    for {
        let x = s ?? return none
        if is_element(x) {
            return x
        }
        s = x.previous
    }
}

fn next_element(n: *Node) -> *Node? {
    var s = n.next
    for {
        let x = s ?? return none
        if is_element(x) {
            return x
        }
        s = x.next
    }
}

fn match_compound(compound: Simple[], e: *Node, q: bool) -> bool {
    for s in compound {
        if !match_simple(s, e, q) {
            return false
        }
    }
    true
}

fn match_simple(s: Simple, n: *Node, q: bool) -> bool {
    let e = element(n) ?? return false
    match s {
        Type(name) => if e.namespace == Namespace.Html { text.equal_fold(e.name, name) } else { e.name == name }
        Universal => true
        Class(name) => has_class(e, name, q)
        Id(name) => same_name(attr(n, "id") ?? "", name, q)
        Attribute(name, op, value, fold) => match_attribute(e, name, op, value, fold)
        Not(list) => !match_list(list, n, q)
        Is(list) => match_list(list, n, q)
        Has(list) => match_has(list, n, q)
        Nth(a, b, last, of_type, filter) => match_nth(n, e, a, b, last, of_type, filter, q)
        Empty => is_empty(n)
        Root => is_root(n)
        Checked => is_checked(n, e)
        Disabled => is_disabled(n, e)
        Enabled => is_enabled(n, e)
    }
}

fn is_quirks(n: *Node) -> bool {
    var top = n
    for {
        let p = top.parent ?? break
        top = p
    }
    match top.data {
        Document(quirks) => quirks == QuirksMode.Quirks
        _ => false
    }
}

fn same_name(a: str, b: str, quirks: bool) -> bool {
    if quirks { text.equal_fold(a, b) } else { a == b }
}

fn has_class(e: *Element, name: str, quirks: bool) -> bool {
    for a in e.attributes {
        if a.name == "class" && a.prefix == "" {
            return has_token(a.value, name, quirks)
        }
    }
    false
}

fn has_token(list: str, token: str, quirks: bool) -> bool {
    var i = 0
    for i < list.len {
        for i < list.len && space(list[i]) {
            i += 1
        }
        let start = i
        for i < list.len && !space(list[i]) {
            i += 1
        }
        if i > start && same_name(list[start..i], token, quirks) {
            return true
        }
    }
    false
}

fn folds_by_default(name: str) -> bool {
    match name {
        "accept-charset" => true
        "align" => true
        "alink" => true
        "axis" => true
        "bgcolor" => true
        "charset" => true
        "checked" => true
        "clear" => true
        "codetype" => true
        "color" => true
        "compact" => true
        "declare" => true
        "defer" => true
        "dir" => true
        "direction" => true
        "disabled" => true
        "enctype" => true
        "face" => true
        "frame" => true
        "hreflang" => true
        "http-equiv" => true
        "lang" => true
        "language" => true
        "link" => true
        "media" => true
        "method" => true
        "multiple" => true
        "nohref" => true
        "noresize" => true
        "noshade" => true
        "nowrap" => true
        "readonly" => true
        "rel" => true
        "rev" => true
        "rules" => true
        "scope" => true
        "scrolling" => true
        "selected" => true
        "shape" => true
        "target" => true
        "text" => true
        "type" => true
        "valign" => true
        "valuetype" => true
        "vlink" => true
        _ => false
    }
}

fn match_attribute(e: *Element, name: str, op: Operator, value: str, fold: Folding) -> bool {
    let html = e.namespace == Namespace.Html
    for a in e.attributes {
        if a.prefix != "" {
            continue
        }
        let same = if html { text.equal_fold(a.name, name) } else { a.name == name }
        if !same {
            continue
        }
        let insensitive = match fold {
            Insensitive => true
            Sensitive => false
            Default => html && folds_by_default(text.lower(name))
        }
        return match_value(a.value, op, value, insensitive)
    }
    false
}

fn match_value(actual: str, op: Operator, expected: str, insensitive: bool) -> bool {
    if op == Operator.Exists {
        return true
    }
    let have = if insensitive { text.lower(actual) } else { actual }
    let want = if insensitive { text.lower(expected) } else { expected }
    match op {
        Exists => true
        Equals => have == want
        Includes => want != "" && !has_space(want) && has_token(have, want, false)
        DashMatch => have == want || text.starts_with(have, "{want}-")
        Prefix => want != "" && text.starts_with(have, want)
        Suffix => want != "" && text.ends_with(have, want)
        Substring => want != "" && text.contains(have, want)
    }
}

fn has_space(s: str) -> bool {
    for i in 0..s.len {
        if space(s[i]) {
            return true
        }
    }
    false
}

fn match_has(list: Relative[], subject: *Node, q: bool) -> bool {
    for r in list {
        if match_relative(r, subject, q) {
            return true
        }
    }
    false
}

fn match_relative(r: Relative, subject: *Node, q: bool) -> bool {
    let last = r.complex.parts.len - 1
    match r.link {
        Child => return any_below(r, last, subject, subject, q)
        Descendant => return any_below(r, last, subject, subject, q)
        _ => {}
    }
    var s = next_element(subject)
    for {
        let x = s ?? return false
        if match_chain(r.complex, last, x, subject, r.link, q) || any_below(r, last, x, subject, q) {
            return true
        }
        s = next_element(x)
    }
}

fn any_below(r: Relative, last: i64, root: *Node, subject: *Node, q: bool) -> bool {
    var current = root.first_child
    for {
        let c = current ?? return false
        if is_element(c) && match_chain(r.complex, last, c, subject, r.link, q) {
            return true
        }
        current = descend(c, root)
    }
}

fn match_nth(n: *Node, e: *Element, a: i64, b: i64, last: bool, of_type: bool, filter: Complex[], q: bool) -> bool {
    if filter.len > 0 && !match_list(filter, n, q) {
        return false
    }
    var position = 1
    var s = if last { next_element(n) } else { previous_element(n) }
    for {
        let x = s ?? break
        if counts_as_sibling(x, e, of_type, filter, q) {
            position += 1
        }
        s = if last { next_element(x) } else { previous_element(x) }
    }
    nth_matches(a, b, position)
}

fn counts_as_sibling(x: *Node, e: *Element, of_type: bool, filter: Complex[], q: bool) -> bool {
    if of_type {
        let other = element(x) ?? return false
        return other.namespace == e.namespace && other.name == e.name
    }
    filter.len == 0 || match_list(filter, x, q)
}

fn nth_matches(a: i64, b: i64, position: i64) -> bool {
    if a == 0 {
        return position == b
    }
    let distance = position - b
    distance % a == 0 && distance / a >= 0
}

fn is_empty(n: *Node) -> bool {
    var c = n.first_child
    for {
        let x = c ?? return true
        match x.data {
            Element => return false
            Text(content) => {
                if content.len > 0 {
                    return false
                }
            }
            _ => {}
        }
        c = x.next
    }
}

fn is_root(n: *Node) -> bool {
    let p = n.parent ?? return false
    match p.data {
        Document => true
        _ => false
    }
}

fn is_checked(n: *Node, e: *Element) -> bool {
    if e.namespace != Namespace.Html {
        return false
    }
    if e.name == "option" {
        return has_attr(n, "selected")
    }
    if e.name != "input" || !has_attr(n, "checked") {
        return false
    }
    let kind = text.lower(attr(n, "type") ?? "")
    kind == "checkbox" || kind == "radio"
}

fn is_disableable(e: *Element) -> bool {
    if e.namespace != Namespace.Html {
        return false
    }
    match e.name {
        "button" => true
        "input" => true
        "select" => true
        "textarea" => true
        "optgroup" => true
        "option" => true
        "fieldset" => true
        _ => false
    }
}

fn is_enabled(n: *Node, e: *Element) -> bool {
    is_disableable(e) && !is_disabled(n, e)
}

fn is_disabled(n: *Node, e: *Element) -> bool {
    if !is_disableable(e) {
        return false
    }
    if has_attr(n, "disabled") {
        return true
    }
    match e.name {
        "optgroup" => false
        "option" => {
            let group = n.parent ?? return false
            is_html(group, "optgroup") && has_attr(group, "disabled")
        }
        _ => in_disabled_fieldset(n)
    }
}

fn in_disabled_fieldset(n: *Node) -> bool {
    var via = n
    var p = n.parent
    for {
        let a = p ?? return false
        if is_html(a, "fieldset") && has_attr(a, "disabled") && !is_first_legend(a, via) {
            return true
        }
        via = a
        p = a.parent
    }
}

fn is_first_legend(fieldset: *Node, child: *Node) -> bool {
    var c = fieldset.first_child
    for {
        let x = c ?? return false
        if is_html(x, "legend") {
            return x == child
        }
        c = x.next
    }
}
