import std/text

struct Slot {
    node: *Node
    key: str
    below: i64
    above: i64
    live: bool
    entry: i64
    same_below: i64
    bd: i64
    bl: i64
    bb: i64
    bt: i64
    sp: i64
    sp_below: i64
    ls: i64
    ls_below: i64
    rs: i64
    rs_below: i64
    hn: i64
    hn_below: i64
}

fn chain_key(n: *Node) -> str {
    let e = element(n) ?? return ""
    if e.namespace == Namespace.Html {
        e.name
    } else {
        "~{text.lower(e.name)}"
    }
}

fn list_exempt(n: *Node) -> bool {
    let name = html_name(n)
    name == "address" || name == "div" || name == "p"
}

fn reset_stop(n: *Node) -> bool {
    match html_name(n) {
        "td" => true
        "th" => true
        "tr" => true
        "tbody" => true
        "thead" => true
        "tfoot" => true
        "caption" => true
        "colgroup" => true
        "table" => true
        "template" => true
        "head" => true
        "body" => true
        "frameset" => true
        "html" => true
        _ => false
    }
}

fn allocate_slot(p: *Parser, s: *Slot) -> i64 {
    match pop(mut p.free) {
        some(id) => {
            p.slots[id] = s
            return id
        }
        none => {}
    }
    push(mut p.slots, s)
    p.slots.len - 1
}

fn make_slot(p: *Parser, n: *Node, below: i64) -> i64 {
    let s = new(Slot {
        node: n,
        key: chain_key(n),
        below,
        above: -1,
        live: true,
        entry: -1,
        same_below: -1,
        bd: -1,
        bl: -1,
        bb: -1,
        bt: -1,
        sp: -1,
        sp_below: -1,
        ls: -1,
        ls_below: -1,
        rs: -1,
        rs_below: -1,
        hn: -1,
        hn_below: -1
    })
    let id = allocate_slot(p, s)
    var bd = -1
    var bl = -1
    var bb = -1
    var bt = -1
    var sp = -1
    var ls = -1
    var rs = -1
    var hn = -1
    if below >= 0 {
        let b = p.slots[below]
        bd = b.bd
        bl = b.bl
        bb = b.bb
        bt = b.bt
        sp = b.sp
        ls = b.ls
        rs = b.rs
        hn = b.hn
    }
    s.bd = if boundary(n, Scope.Default) { id } else { bd }
    s.bl = if boundary(n, Scope.ListItem) { id } else { bl }
    s.bb = if boundary(n, Scope.Button) { id } else { bb }
    s.bt = if boundary(n, Scope.Table) { id } else { bt }
    let is_special = special(n)
    s.sp = if is_special { id } else { sp }
    s.sp_below = sp
    s.ls = if is_special && !list_exempt(n) { id } else { ls }
    s.ls_below = ls
    s.rs = if reset_stop(n) { id } else { rs }
    s.rs_below = rs
    s.hn = if is_html_namespace(n) { id } else { hn }
    s.hn_below = hn
    id
}

fn register_slot(p: *Parser, id: i64) {
    let s = p.slots[id]
    s.node.mark = id
    p.depth += 1
    if !body_allowed_open(html_name(s.node)) {
        p.unclosed += 1
    }
    if is_html(s.node, "template") {
        p.templates_open += 1
    }
}

fn live_chain(p: *Parser, id: i64) -> i64 {
    var x = id
    for x >= 0 && !p.slots[x].live {
        x = p.slots[x].same_below
    }
    x
}

fn chain_top(p: *Parser, key: str) -> i64 {
    let id = p.chains[key] ?? -1
    if id < 0 {
        return -1
    }
    let live = live_chain(p, id)
    if live != id {
        if live < 0 {
            delete(mut p.chains, key)
        } else {
            p.chains[key] = live
        }
    }
    live
}

fn open_push(p: *Parser, n: *Node) -> i64 {
    let id = make_slot(p, n, p.top)
    if p.top >= 0 {
        p.slots[p.top].above = id
    } else {
        p.bottom = id
    }
    p.top = id
    register_slot(p, id)
    let s = p.slots[id]
    s.same_below = chain_top(p, s.key)
    p.chains[s.key] = id
    id
}

fn open_insert_above(p: *Parser, after: i64, n: *Node, same_below: i64, as_top: bool) -> i64 {
    let id = make_slot(p, n, after)
    let s = p.slots[id]
    let a = p.slots[after]
    s.above = a.above
    if a.above >= 0 {
        p.slots[a.above].below = id
    } else {
        p.top = id
    }
    a.above = id
    register_slot(p, id)
    s.same_below = same_below
    if as_top {
        p.chains[s.key] = id
    }
    id
}

fn kill_slot(p: *Parser, id: i64, reuse: bool) {
    let s = p.slots[id]
    s.live = false
    p.depth -= 1
    if s.below >= 0 {
        p.slots[s.below].above = s.above
    } else {
        p.bottom = s.above
    }
    if s.above >= 0 {
        p.slots[s.above].below = s.below
    } else {
        p.top = s.below
    }
    if !body_allowed_open(html_name(s.node)) {
        p.unclosed -= 1
    }
    if is_html(s.node, "template") {
        p.templates_open -= 1
    }
    let head = p.chains[s.key] ?? -1
    if head == id {
        let next = live_chain(p, s.same_below)
        if next < 0 {
            delete(mut p.chains, s.key)
        } else {
            p.chains[s.key] = next
        }
    }
    if s.node.mark == id {
        s.node.mark = -1
    }
    if reuse {
        push(mut p.free, id)
    }
}

fn open_slot(p: *Parser, n: *Node) -> i64 {
    let m = n.mark
    if m >= 0 && m < p.slots.len {
        let s = p.slots[m]
        if s.live && s.node == n {
            return m
        }
    }
    -1
}

fn is_open(p: *Parser, n: *Node) -> bool {
    open_slot(p, n) >= 0
}

fn remove_open(p: *Parser, n: *Node) {
    let id = open_slot(p, n)
    if id >= 0 {
        kill_slot(p, id, false)
    }
}

fn remove_slot(p: *Parser, id: i64) {
    kill_slot(p, id, false)
}

fn swap_node(p: *Parser, id: i64, fresh: *Node) {
    let s = p.slots[id]
    if s.node.mark == id {
        s.node.mark = -1
    }
    s.node = fresh
    fresh.mark = id
}

fn current(p: *Parser) -> *Node {
    p.slots[p.top].node
}

fn root_node(p: *Parser) -> *Node {
    p.slots[p.bottom].node
}

fn second_node(p: *Parser) -> *Node? {
    if p.depth < 2 {
        return none
    }
    p.slots[p.slots[p.bottom].above].node
}

fn adjusted_current(p: *Parser) -> *Node? {
    if p.depth == 0 {
        return none
    }
    if p.depth == 1 && p.context != none {
        return p.context
    }
    current(p)
}

fn pop_node(p: *Parser) {
    if p.top >= 0 {
        kill_slot(p, p.top, true)
    }
}

fn pop_until(p: *Parser, name: str) {
    for p.top >= 0 {
        let n = current(p)
        pop_node(p)
        if is_html(n, name) {
            return
        }
    }
}

fn pop_until_slot(p: *Parser, id: i64) {
    for p.top >= 0 {
        let popped = p.top
        pop_node(p)
        if popped == id {
            return
        }
    }
}

fn pop_until_heading(p: *Parser) {
    for p.top >= 0 {
        let n = current(p)
        pop_node(p)
        if heading_name(html_name(n)) {
            return
        }
    }
}

fn has_template(p: *Parser) -> bool {
    p.templates_open > 0
}

fn parsing_template_contents(p: *Parser) -> bool {
    if has_template(p) {
        return true
    }
    match p.context {
        some(c) => is_html(c, "template")
        none => false
    }
}

fn unclosed_in_body(p: *Parser) -> bool {
    p.unclosed > 0
}

fn boundary_pointer(s: *Slot, scope: Scope) -> i64 {
    match scope {
        Default => s.bd
        ListItem => s.bl
        Button => s.bb
        Table => s.bt
    }
}

fn in_scope_slot(p: *Parser, id: i64, scope: Scope) -> bool {
    if p.top < 0 {
        return false
    }
    boundary_pointer(p.slots[id], scope) == boundary_pointer(p.slots[p.top], scope)
}

fn has_scope(p: *Parser, name: str, scope: Scope) -> bool {
    let id = chain_top(p, name)
    if id < 0 {
        return false
    }
    in_scope_slot(p, id, scope)
}

fn has_node_in_scope(p: *Parser, target: *Node, scope: Scope) -> bool {
    let id = open_slot(p, target)
    if id < 0 {
        return false
    }
    in_scope_slot(p, id, scope)
}

fn has_heading_in_scope(p: *Parser) -> bool {
    has_scope(p, "h1", Scope.Default) || has_scope(p, "h2", Scope.Default) || has_scope(p, "h3", Scope.Default) || has_scope(p, "h4", Scope.Default) || has_scope(p, "h5", Scope.Default) || has_scope(p, "h6", Scope.Default)
}

fn has_table_section_in_scope(p: *Parser) -> bool {
    has_scope(p, "tbody", Scope.Table) || has_scope(p, "thead", Scope.Table) || has_scope(p, "tfoot", Scope.Table)
}

fn has_cell_in_table_scope(p: *Parser) -> bool {
    has_scope(p, "td", Scope.Table) || has_scope(p, "th", Scope.Table)
}

fn nearest_special(p: *Parser, id: i64) -> i64 {
    var x = id
    for x >= 0 && !p.slots[x].live {
        x = p.slots[x].sp_below
    }
    x
}

fn nearest_stop(p: *Parser, id: i64) -> i64 {
    var x = id
    for x >= 0 && !p.slots[x].live {
        x = p.slots[x].ls_below
    }
    x
}

fn nearest_reset(p: *Parser, id: i64) -> i64 {
    var x = id
    for x >= 0 && !p.slots[x].live {
        x = p.slots[x].rs_below
    }
    x
}

fn nearest_html(p: *Parser, id: i64) -> i64 {
    var x = id
    for x >= 0 && !p.slots[x].live {
        x = p.slots[x].hn_below
    }
    x
}

fn list_stop_name(p: *Parser) -> str {
    if p.top < 0 {
        return ""
    }
    let id = nearest_stop(p, p.slots[p.top].ls)
    if id < 0 {
        return ""
    }
    html_name(p.slots[id].node)
}

fn list_stop_slot(p: *Parser) -> i64 {
    if p.top < 0 {
        return -1
    }
    nearest_stop(p, p.slots[p.top].ls)
}

fn furthest_block(p: *Parser, from: i64) -> i64 {
    var j = p.slots[from].above
    for j >= 0 {
        if special(p.slots[j].node) {
            return j
        }
        j = p.slots[j].above
    }
    -1
}

fn generate_implied(p: *Parser, except: str) {
    for p.top >= 0 {
        let name = html_name(current(p))
        if name == except || !implied_end(name) {
            return
        }
        pop_node(p)
    }
}

fn generate_thorough(p: *Parser) {
    for p.top >= 0 {
        if !thorough_end(html_name(current(p))) {
            return
        }
        pop_node(p)
    }
}

fn any_other_end_tag(p: *Parser, name: str) {
    let x = chain_top(p, name)
    if p.top < 0 {
        return
    }
    let stop = nearest_special(p, p.slots[p.top].sp)
    var found = false
    if x >= 0 {
        found = x == stop || nearest_special(p, p.slots[x].sp) == stop
    }
    if !found {
        report(p, "unexpected end tag")
        return
    }
    generate_implied(p, name)
    if p.top != x {
        report(p, "unclosed element before end tag")
    }
    pop_until_slot(p, x)
}

fn reset_mode(p: *Parser) {
    if p.top < 0 {
        p.mode = Mode.InBody
        return
    }
    var id = nearest_reset(p, p.slots[p.top].rs)
    for id >= 0 {
        let s = p.slots[id]
        let last = s.below < 0
        var node = s.node
        if last {
            match p.context {
                some(c) => {
                    node = c
                }
                none => {}
            }
        }
        let name = html_name(node)
        if name == "td" || name == "th" {
            if !last {
                p.mode = Mode.InCell
                return
            }
        } else if name == "tr" {
            p.mode = Mode.InRow
            return
        } else if name == "tbody" || name == "thead" || name == "tfoot" {
            p.mode = Mode.InTableBody
            return
        } else if name == "caption" {
            p.mode = Mode.InCaption
            return
        } else if name == "colgroup" {
            p.mode = Mode.InColumnGroup
            return
        } else if name == "table" {
            p.mode = Mode.InTable
            return
        } else if name == "template" {
            p.mode = p.templates[p.templates.len - 1]
            return
        } else if name == "head" {
            if !last {
                p.mode = Mode.InHead
                return
            }
        } else if name == "body" {
            p.mode = Mode.InBody
            return
        } else if name == "frameset" {
            p.mode = Mode.InFrameset
            return
        } else if name == "html" {
            if p.head == none {
                p.mode = Mode.BeforeHead
            } else {
                p.mode = Mode.AfterHead
            }
            return
        }
        if last {
            p.mode = Mode.InBody
            return
        }
        id = nearest_reset(p, s.rs_below)
    }
    p.mode = Mode.InBody
}
