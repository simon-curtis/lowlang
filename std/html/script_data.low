import std/text

enum ScriptState {
    Plain
    Escaped
    EscapedDash
    EscapedDashDash
    Double
    DoubleDash
    DoubleDashDash
}

fn closes_script(s: str, at: i64, name: str) -> bool {
    let after = at + 2 + name.len
    after < s.len && s[at + 1] == '/' && text.equal_fold(s[at + 2..after], name) && (space(s[after]) || s[after] == '/' || s[after] == '>')
}

fn letters_end(s: str, from: i64) -> i64 {
    var i = from
    for i < s.len && alpha(s[i]) {
        i += 1
    }
    i
}

fn script_end(s: str, from: i64, name: str) -> i64 {
    var state = ScriptState.Plain
    var i = from
    for i < s.len {
        let c = s[i]
        match state {
            Plain => {
                if c != '<' {
                    i += 1
                } else if closes_script(s, i, name) {
                    return i
                } else if text.starts_with(s[i..], "<!--") {
                    state = EscapedDashDash
                    i += 4
                } else {
                    i += 1
                }
            }
            Escaped => {
                if c == '-' {
                    state = EscapedDash
                    i += 1
                } else if c == '<' {
                    if closes_script(s, i, name) {
                        return i
                    }
                    let j = letters_end(s, i + 1)
                    if j > i + 1 && j < s.len && (space(s[j]) || s[j] == '/' || s[j] == '>') && text.equal_fold(s[i + 1..j], name) {
                        state = Double
                        i = j + 1
                    } else {
                        i += 1
                    }
                } else {
                    i += 1
                }
            }
            EscapedDash => {
                if c == '-' {
                    state = EscapedDashDash
                    i += 1
                } else if c == '<' {
                    state = Escaped
                } else {
                    state = Escaped
                    i += 1
                }
            }
            EscapedDashDash => {
                if c == '-' {
                    i += 1
                } else if c == '>' {
                    state = Plain
                    i += 1
                } else if c == '<' {
                    state = Escaped
                } else {
                    state = Escaped
                    i += 1
                }
            }
            Double => {
                if c == '-' {
                    state = DoubleDash
                    i += 1
                } else if c == '<' {
                    i = double_less_than(s, i, name, mut state)
                } else {
                    i += 1
                }
            }
            DoubleDash => {
                if c == '-' {
                    state = DoubleDashDash
                    i += 1
                } else if c == '<' {
                    state = Double
                    i = double_less_than(s, i, name, mut state)
                } else {
                    state = Double
                    i += 1
                }
            }
            DoubleDashDash => {
                if c == '-' {
                    i += 1
                } else if c == '>' {
                    state = Plain
                    i += 1
                } else if c == '<' {
                    state = Double
                    i = double_less_than(s, i, name, mut state)
                } else {
                    state = Double
                    i += 1
                }
            }
        }
    }
    s.len
}

fn double_less_than(s: str, at: i64, name: str, mut state: ScriptState) -> i64 {
    if at + 1 >= s.len || s[at + 1] != '/' {
        return at + 1
    }
    let j = letters_end(s, at + 2)
    if j < s.len && (space(s[j]) || s[j] == '/' || s[j] == '>') && text.equal_fold(s[at + 2..j], name) {
        state = Escaped
        return j + 1
    }
    j
}
