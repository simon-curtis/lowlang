import std/datachannel
import std/rtp
import std/sdp
import std/webrtc

fn trickle(from: webrtc.Handle, to: webrtc.Handle, tracks: chan[webrtc.RemoteTrack]) {
    for {
        let e = (<-from.events) ?? break
        match e {
            Candidate(value) => {
                webrtc.add_remote_candidate(to, value) or {}
            }
            Track(t) => {
                tracks <- t
            }
            _ => {}
        }
    }
}

fn exchange(offerer: webrtc.Handle, answerer: webrtc.Handle) -> sdp.Session? {
    let offer = webrtc.create_offer(offerer) or return none
    let answer = webrtc.create_answer(answerer, offer) or return none
    webrtc.apply_answer(offerer, answer) or return none
    answer
}

fn sections(s: sdp.Session) -> str {
    var out = ""
    for m in s.media {
        out = "{out} {sdp.mid(m) ?? "?"}={m.kind}/{sdp.direction_name(sdp.direction(s, m))}"
    }
    out
}

fn main() {
    using caller = webrtc.open(webrtc.Config { bind: ["127.0.0.1"] }) or return
    using callee = webrtc.open(webrtc.Config { bind: ["127.0.0.1"] }) or return
    let tracks = chan[webrtc.RemoteTrack](4)
    spawn trickle(caller.handle, callee.handle, chan[webrtc.RemoteTrack](4))
    spawn trickle(callee.handle, caller.handle, tracks)
    let first = exchange(caller.handle, callee.handle) ?? return
    print("first answer:{sections(first)}")
    webrtc.wait_connected(caller.handle) or return
    let chat = webrtc.create_data_channel(caller.handle, datachannel.Options { label: "chat" }) or return
    let accepted = (<-callee.handle.channels) ?? return

    let camera = webrtc.add_track(caller.handle, webrtc.Kind.Video, [webrtc.vp8()]) or return
    let second = exchange(caller.handle, callee.handle) ?? return
    print("after add_track:{sections(second)}")
    let video = (<-tracks) ?? return
    webrtc.send_rtp(camera, rtp.Packet { payload_type: 96, sequence: 1, timestamp: 0, ssrc: 0, payload: bytes("a frame") }) or return
    let frame = (<-video.packets) ?? return
    print("callee received {str(frame.payload)} on mid {video.mid}")

    webrtc.restart_ice(callee.handle) or return
    let third = exchange(callee.handle, caller.handle) ?? return
    print("after an ICE restart offered by the callee:{sections(third)}")
    datachannel.send_text(chat, "still here") or return
    let message = datachannel.receive(accepted) or return
    print("callee received {str(message.data)} on {accepted.label}")
}
