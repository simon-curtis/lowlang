import std/datachannel
import std/rtp
import std/sdp
import std/webrtc

fn trickle(from: webrtc.Handle, to: webrtc.Handle, tracks: chan[webrtc.RemoteTrack]) {
    for {
        let e = (<-from.events) ?? break
        match e {
            Candidate(value) => {
                webrtc.add_remote_candidate(to, value) or {}
            }
            Track(t) => {
                tracks <- t
            }
            _ => {}
        }
    }
}

fn main() {
    using caller = webrtc.open(webrtc.Config { bind: ["127.0.0.1"] }) or return
    using callee = webrtc.open(webrtc.Config { bind: ["127.0.0.1"] }) or return
    let microphone = webrtc.add_track(caller.handle, webrtc.Kind.Audio, [webrtc.opus()]) or return
    let offer = webrtc.create_offer(caller.handle) or return
    let answer = webrtc.create_answer(callee.handle, sdp.parse(sdp.format(offer)) or return) or return
    print("answer setup {sdp.get(answer.media[0].attributes, "setup") ?? "?"}, audio {sdp.direction_name(sdp.direction(answer, answer.media[0]))}")
    webrtc.apply_answer(caller.handle, answer) or return
    let heard = chan[webrtc.RemoteTrack](1)
    spawn trickle(caller.handle, callee.handle, chan[webrtc.RemoteTrack](1))
    spawn trickle(callee.handle, caller.handle, heard)
    webrtc.wait_connected(caller.handle) or return
    print("connected")

    let chat = webrtc.create_data_channel(caller.handle, datachannel.Options { label: "chat" }) or return
    datachannel.send_text(chat, "hello") or return
    let accepted = (<-callee.handle.channels) ?? return
    let message = datachannel.receive(accepted) or return
    print("callee received {str(message.data)} on {accepted.label}")

    let track = (<-heard) ?? return
    webrtc.send_rtp(microphone, rtp.Packet { payload_type: 111, sequence: 1, timestamp: 960, ssrc: 0, payload: bytes("20 ms of audio") }) or return
    let packet = (<-track.packets) ?? return
    print("callee received RTP {packet.sequence} on its {webrtc.kind_name(track.kind)} track: {str(packet.payload)}")
}
