import std/ice
import icesession = std/ice/session
import std/mdns
import std/sdp
import std/testing
import std/text

fn multicast_reaches_this_host(t: *testing.T) -> bool {
    using r = mdns.responder() catch {
        e => {
            testing.skip(t, "port 5353 cannot be shared: {e}")
            return false
        }
    }
    let name = mdns.random_name()
    mdns.publish(r.handle, mdns.Host { name, ip: [127, 0, 0, 1] })
    mdns.resolve(name, 2000) catch {
        e => {
            testing.skip(t, "multicast DNS does not reach this host: {e}")
            return false
        }
    }
    true
}

fn trickle(from: Handle, to: Handle, values: chan[str]) {
    for {
        let e = (<-from.events) ?? break
        match e {
            Candidate(value) => {
                values <- value
                add_remote_candidate(to, value) or {}
            }
            _ => {}
        }
    }
    close(values)
}

fn described_addresses(s: sdp.Session) -> str[] {
    var out: str[] = []
    for m in s.media {
        for value in sdp.candidates(m) {
            out.push(text.fields(value)[4])
        }
    }
    out
}

fn remote_kind(h: Handle) -> ice.Kind? {
    let link = h.core.ice ?? return none
    let pair = (icesession.selected(link) or none) ?? return none
    pair.remote.kind
}

fn test_host_candidates_go_by_mdns_names_and_are_resolved(t: *testing.T) {
    if !multicast_reaches_this_host(t) {
        return
    }
    using caller = open(Config { bind: ["127.0.0.1"], mdns: true }) or panic("open")
    using callee = open(Config { bind: ["127.0.0.1"], mdns: true }) or panic("open")
    let offer = create_offer(caller.handle) or panic("offer")
    let answer = create_answer(callee.handle, sdp.parse(sdp.format(offer)) or panic("parse")) or panic("answer")
    apply_answer(caller.handle, answer) or panic("apply")
    for address in described_addresses(offer) {
        testing.error_if(t, !mdns.is_local(address), "the offer names {address}")
    }
    testing.error_if(t, described_addresses(answer).len == 0, "the answer has no candidate")
    let trickled = chan[str](64)
    spawn trickle(caller.handle, callee.handle, trickled)
    spawn trickle(callee.handle, caller.handle, chan[str](64))
    wait_connected(caller.handle) or panic("connect")
    wait_connected(callee.handle) or panic("connect")
    for h in [caller.handle, callee.handle] {
        let kind = remote_kind(h)
        testing.error_if(t, kind != ice.Kind.Host, "the selected remote candidate is {kind}")
    }
    close_peer(caller.handle)
    for {
        let value = (<-trickled) ?? break
        let fields = text.fields(value)
        testing.error_if(t, fields[7] == "host" && !mdns.is_local(fields[4]), "a trickled host candidate names {fields[4]}")
    }
}
