import std/datachannel
import std/dtls
import dtlssession = std/dtls/session
import std/ice
import icesession = std/ice/session
import std/io
import std/mdns
import std/net
import std/rtp
import std/sctp
import sctpsession = std/sctp/session
import std/sdp
import std/srtp
import std/time

/// The connection state of a peer, as the W3C `RTCPeerConnectionState` names it.
pub enum State {
    /// No description has been applied that starts the transport.
    New = 0
    /// ICE, DTLS or SCTP is still connecting.
    Connecting = 1
    /// DTLS is up and, when a data channel section was negotiated, so is SCTP.
    Connected = 2
    /// ICE consent has gone stale; it may recover.
    Disconnected = 3
    /// ICE, DTLS or SCTP failed.
    Failed = 4
    /// `close_peer` was called or the peer was dropped.
    Closed = 5
}

/// The media type of a track.
pub enum Kind {
    /// An `m=audio` section.
    Audio
    /// An `m=video` section.
    Video
}

/// What a peer reports on `Handle.events`.
pub enum Event {
    /// A local candidate, the value of an `a=candidate` attribute, to send to the remote peer.
    Candidate(value: str)
    /// Gathering finished.
    GatheringComplete
    /// The connection state changed.
    StateChanged(state: State)
    /// A description announced a track the remote peer sends: a new media section, or a new synchronization source on one, which ends the track that section had.
    Track(track: RemoteTrack)
    /// ICE selected a candidate pair: after the first checks, and again after each ICE restart.
    Selected(local: ice.Candidate, remote: ice.Candidate)
}

/// Where the offer and answer exchange stands, as the W3C `RTCSignalingState` names it.
pub enum Signaling {
    /// No offer is outstanding: `create_offer` and `create_answer` may be called.
    Stable
    /// `create_offer` made an offer that awaits `apply_answer` or `rollback`.
    HaveLocalOffer
}

/// Why a description or a candidate was not applied.
pub enum Error {
    /// The peer has closed.
    Closed
    /// The call does not fit the offer and answer exchange: an offer is already outstanding, an answer or a rollback came without one, or a candidate came before any remote description.
    WrongState
    /// The remote description or candidate lacks something the peer needs or has a value it cannot use, named by `reason`.
    Invalid(reason: str)
    /// The sockets could not be opened.
    Unavailable(error: io.Error)
}

/// An RTP payload format of a track: one `a=rtpmap`, its `a=fmtp` and its `a=rtcp-fb` lines.
pub struct Codec {
    /// The payload type.
    pub payload_type: i64
    /// The encoding name, such as `opus` or `VP8`.
    pub name: str
    /// The RTP clock rate in hertz.
    pub clock_rate: i64
    /// The number of audio channels, 0 for video.
    pub channels: i64 = 0
    /// The `a=fmtp` parameters, or empty for none.
    pub parameters: str = ""
    /// The `a=rtcp-fb` values after the payload type, such as `nack` or `nack pli`.
    pub feedback: str[] = []
}

/// The settings of `open`.
pub struct Config {
    /// The STUN servers to ask for server-reflexive candidates.
    pub stun_servers: net.Addr[] = []
    /// The IP addresses to bind one UDP socket each on, in text form, or empty for the addresses of the host's interfaces.
    pub bind: str[] = []
    /// Whether the interface addresses include loopback addresses. Used only when `bind` is empty.
    pub loopback: bool = false
    /// Whether an offer carries a data channel section and an answer accepts one.
    pub data_channels: bool = true
    /// The SRTP protection profiles to offer in DTLS `use_srtp`, preferred first.
    pub srtp_profiles: i64[] = [srtp.profile_aead_aes_128_gcm, srtp.profile_aes128_cm_sha1_80]
    /// The largest DTLS datagram in bytes. SCTP packets are sized to fit one record of it.
    pub mtu: i64 = 1200
    /// The largest data channel message the peer accepts, stated in `a=max-message-size`.
    pub max_message_size: i64 = 262144
    /// The ICE settings: consent and keepalive, and `turn_servers` and `relay_only` for relayed candidates; `controlling`, `hosts` and `stun_servers` are set by the peer.
    pub ice: ice.Config = ice.Config { controlling: false }
    /// Whether host candidates are announced under random `.local` names that an mDNS responder on port 5353 answers for, as browsers announce theirs, so no description or `Event.Candidate` carries a local address.
    pub mdns: bool = false
}

/// A local track: a media section this peer sends RTP on, made by `add_track`.
pub struct Track {
    /// The media type.
    pub kind: Kind
    /// The synchronization source every packet sent on the track carries.
    pub ssrc: i64
    core: *Core
}

/// A track the remote peer sends, announced by `Event.Track`.
pub struct RemoteTrack {
    /// The media section identifier.
    pub mid: str
    /// The media type.
    pub kind: Kind
    /// The synchronization source the remote description names, or 0 when it names none and packets are matched by payload type.
    pub ssrc: i64
    /// The payload formats of the section.
    pub codecs: Codec[]
    /// The RTP packets that arrive for the track, decrypted. Closed when the peer ends; a packet that arrives while 256 wait is dropped.
    pub packets: chan[rtp.Packet]
}

/// A media section as `transceivers` reports it, the W3C `RTCRtpTransceiver`.
pub struct Transceiver {
    /// The media section identifier, empty until an offer or an answer places the section.
    pub mid: str
    /// The media type: `audio`, `video` or `application` for data channels.
    pub media: str
    /// The direction the next offer or answer asks for, set by `set_direction`.
    pub direction: sdp.Direction
    /// The direction the last exchange agreed, `inactive` before one.
    pub current: sdp.Direction
    /// Whether the section was rejected or stopped; it keeps its place at port 0.
    pub stopped: bool
    /// The synchronization source of the local track the section sends, or 0 for none.
    pub ssrc: i64
}

struct Local {
    kind: Kind
    ssrc: i64
    codecs: Codec[]
    track_id: str
}

struct Line {
    mid: str = ""
    media: str
    protocol: str
    formats: str[]
    data: bool = false
    track: i64 = -1
    used: bool = false
    wanted: sdp.Direction = sdp.Direction.SendRecv
    offered: sdp.Direction = sdp.Direction.Inactive
    current: sdp.Direction = sdp.Direction.Inactive
    codecs: Codec[] = []
    remote: RemoteTrack? = none
    negotiated: bool = false
    stopping: bool = false
    stopped: bool = false
}

enum Described {
    Done(session: sdp.Session)
    Refused(error: Error)
}

enum Command {
    AddTrack(kind: Kind, codecs: Codec[], reply: chan[Track])
    Offer(reply: chan[Described])
    Answer(offer: sdp.Session, reply: chan[Described])
    Accept(answer: sdp.Session, reply: chan[Error?])
    AddCandidate(value: str, reply: chan[Error?])
    Resolved(value: str?)
    EndCandidates(reply: chan[Error?])
    OpenChannel(options: datachannel.Options, reply: chan[Opened])
    SendRtp(ssrc: i64, packet: rtp.Packet, reply: chan[io.Error?])
    SendRtcp(packets: rtp.Rtcp[], reply: chan[io.Error?])
    Negotiated(ssrc: i64, reply: chan[Codec[]])
    RemoveTrack(ssrc: i64, reply: chan[bool])
    SetDirection(mid: str, direction: sdp.Direction, reply: chan[Error?])
    StopSection(mid: str, reply: chan[Error?])
    RestartIce(reply: chan[bool])
    Rollback(reply: chan[Error?])
    Transceivers(reply: chan[Transceiver[]])
    GetSignaling(reply: chan[Signaling])
    WaitConnected(reply: chan[State])
    ShutdownExpired(round: i64)
    Close
}

struct Opening {
    options: datachannel.Options
    reply: chan[Opened]
}

enum Opened {
    Ready(channel: datachannel.Channel)
    Refused(error: io.Error)
}

enum Step {
    Command(command: Command)
    Ice(event: ice.Event)
    IceEnded
    Datagram(datagram: icesession.Datagram)
    DatagramsEnded
    Dtls(event: dtls.Event)
    DtlsEnded
    Sctp(event: datachannel.Event)
    SctpEnded
    Ended
}

struct Core {
    config: Config
    identity: dtls.Identity
    fingerprint: str
    commands: chan[Command]
    events: chan[Event]
    channels: chan[datachannel.Channel]
    rtcp: chan[rtp.Rtcp[]]
    gone: chan[bool]
    stop: chan[bool]
    offering: bool
    negotiated: bool
    described: bool
    offered: i64
    next_mid: i64
    restart_wanted: bool
    state: State
    waiters: chan[State][]
    session_id: str
    version: i64
    ice: icesession.Handle?
    ice_events: chan[ice.Event]
    ice_incoming: chan[icesession.Datagram]
    ufrag: str
    pwd: str
    remote_ufrag: str
    remote_pwd: str
    dtls_client: bool
    remote_fingerprints: dtls.Fingerprint[]
    remote_candidates: [str: bool]
    resolving: i64
    remote_ended: bool
    responder: mdns.Handle?
    names: [str: str]
    data: bool
    remote_sctp_port: i64
    remote_max_message: i64
    dtls_in: chan[u8[]]
    dtls: dtlssession.Handle?
    dtls_events: chan[dtls.Event]
    dtls_up: bool
    srtp: srtp.Pair?
    channel_peer: datachannel.Handle?
    sctp_up: bool
    closing_peer: datachannel.Handle?
    closings: i64
    opening: Opening[]
    sctp_events: chan[datachannel.Event]
    tracks: Local[]
    lines: Line[]
    by_ssrc: [i64: i64]
}

/// The copyable view of a peer, used with every function of the module.
///
/// `events` carries candidates, state changes and remote tracks and drops an event when 256 wait. `channels` carries the data channels the remote peer opens and `rtcp` the RTCP packets it sends. All three close when the peer ends.
pub struct Handle {
    /// The peer's events.
    pub events: chan[Event]
    /// The data channels the remote peer opened.
    pub channels: chan[datachannel.Channel]
    /// The compound RTCP packets that arrive, decrypted; one that arrives while 256 wait is dropped.
    pub rtcp: chan[rtp.Rtcp[]]
    core: *Core
}

/// A WebRTC peer connection: the ICE agent and its sockets, DTLS, SRTP, SCTP and the data channels, closed when dropped.
pub struct Peer {
    /// The copyable view that every function of the module takes.
    pub handle: Handle
    drop stop_core(handle.core)
}

const record_overhead = 37
const unlimited_message = 1073741823
const default_remote_message = 65536
const resolve_wait = 5000
const shutdown_wait = 5000

/// Creates a peer with a new self-signed certificate and starts its green thread.
///
/// No socket is opened until `create_offer` or `create_answer` fixes the ICE role. Fails with the error of `dtls.generate_identity`.
pub fn open(config: Config) -> Peer ! io.Error {
    let now = time.now()
    let identity = dtls.generate_identity("WebRTC", now - 86400, now + 30 * 86400)?
    let print = dtls.fingerprint("sha-256", identity.certificate)?
    let core = new(Core {
        config
        identity
        fingerprint: dtls.format_fingerprint(print)
        commands: chan[Command](16)
        events: chan[Event](256)
        channels: chan[datachannel.Channel](64)
        rtcp: chan[rtp.Rtcp[]](256)
        gone: chan[bool]()
        stop: chan[bool]()
        offering: false
        negotiated: false
        described: false
        offered: 0
        next_mid: 0
        restart_wanted: false
        state: State.New
        waiters: []
        session_id: "{random_digits(18)}"
        version: 1
        ice: none
        ice_events: chan[ice.Event]()
        ice_incoming: chan[icesession.Datagram]()
        ufrag: ""
        pwd: ""
        remote_ufrag: ""
        remote_pwd: ""
        dtls_client: false
        remote_fingerprints: []
        remote_candidates: [:]
        resolving: 0
        remote_ended: false
        responder: none
        names: [:]
        data: false
        remote_sctp_port: 5000
        remote_max_message: default_remote_message
        dtls_in: chan[u8[]](256)
        dtls: none
        dtls_events: chan[dtls.Event]()
        dtls_up: false
        srtp: none
        channel_peer: none
        sctp_up: false
        closing_peer: none
        closings: 0
        opening: []
        sctp_events: chan[datachannel.Event]()
        tracks: []
        lines: []
        by_ssrc: [:]
    })
    spawn run(core)
    Peer { handle: Handle { events: core.events, channels: core.channels, rtcp: core.rtcp, core } }
}

fn set_state(c: *Core, s: State) {
    if c.state == s || c.state == State.Closed {
        return
    }
    c.state = s
    publish(c, Event.StateChanged(s))
    if s == State.Connected || s == State.Failed || s == State.Closed {
        for w in c.waiters {
            w <- s
        }
        c.waiters = []
    }
}

fn publish(c: *Core, e: Event) {
    select {
        c.events <- e => {}
        else => {}
    }
}

fn hold_ice(options: icesession.Options, reply: chan[icesession.Handle?], failure: chan[io.Error], stop: chan[bool]) {
    using s = icesession.open(options) catch {
        e => {
            failure <- e
            return
        }
    }
    reply <- s.handle
    <-stop
}

fn hold_responder(reply: chan[mdns.Handle], failure: chan[io.Error], stop: chan[bool]) {
    using r = mdns.responder() catch {
        e => {
            failure <- e
            return
        }
    }
    reply <- r.handle
    <-stop
}

fn open_responder(c: *Core) ! Error {
    let reply = chan[mdns.Handle](1)
    let failure = chan[io.Error](1)
    spawn hold_responder(reply, failure, c.stop)
    c.responder = select {
        r = <-reply => r ?? fail Closed
        e = <-failure => fail Unavailable(e ?? io.Error.NotConnected)
    }
}

fn open_ice(c: *Core, controlling: bool) ! Error {
    if c.config.mdns {
        open_responder(c)?
    }
    var config = c.config.ice
    config.controlling = controlling
    config.stun_servers = c.config.stun_servers
    let options = icesession.Options { config, bind: c.config.bind, loopback: c.config.loopback }
    let reply = chan[icesession.Handle?](1)
    let failure = chan[io.Error](1)
    spawn hold_ice(options, reply, failure, c.stop)
    let h = select {
        r = <-reply => r ?? none
        e = <-failure => fail Unavailable(e ?? io.Error.NotConnected)
    } ?? fail Closed
    c.ice = h
    c.ice_events = h.events
    c.ice_incoming = h.incoming
    let credentials = icesession.credentials(h) or fail Closed
    c.ufrag = credentials.ufrag
    c.pwd = credentials.pwd
    icesession.gather(h) or fail Closed
    set_state(c, State.Connecting)
}

fn hold_dtls(config: dtls.Config, transport: dtlssession.Transport, reply: chan[dtlssession.Handle], stop: chan[bool]) {
    using s = dtlssession.open(config, transport)
    reply <- s.handle
    <-stop
}

fn open_dtls(c: *Core, link: icesession.Handle) {
    let config = dtls.Config {
        client: c.dtls_client
        identity: c.identity
        fingerprints: c.remote_fingerprints
        srtp_profiles: c.config.srtp_profiles
        mtu: c.config.mtu
    }
    let transport = dtlssession.Transport {
        send: fn(d) {
            icesession.send(link, d) catch {
                _ => {}
            }
        }
        incoming: c.dtls_in
    }
    let reply = chan[dtlssession.Handle](1)
    spawn hold_dtls(config, transport, reply, c.stop)
    let h = (<-reply) ?? return
    c.dtls = h
    c.dtls_events = h.events
}

fn hold_channels(config: sctp.Config, transport: sctpsession.Transport, reply: chan[datachannel.Handle], stop: chan[bool]) {
    using p = datachannel.open(config, transport)
    reply <- p.handle
    <-stop
}

fn forward_channels(from: chan[datachannel.Channel], to: chan[datachannel.Channel]) {
    for {
        let channel = (<-from) ?? break
        to <- channel
    }
}

fn forward_sctp_events(from: chan[datachannel.Event], to: chan[datachannel.Event]) {
    for {
        let e = (<-from) ?? break
        to <- e
    }
    close(to)
}

fn open_channels(c: *Core, link: dtlssession.Handle) {
    abort_closing(c)
    let config = sctp.Config {
        client: c.dtls_client
        remote_port: c.remote_sctp_port
        mtu: c.config.mtu - record_overhead
        max_message_size: c.remote_max_message
    }
    let transport = sctpsession.Transport {
        send: fn(p) {
            dtlssession.send(link, p) catch {
                _ => {}
            }
        }
        incoming: link.data
    }
    let reply = chan[datachannel.Handle](1)
    spawn hold_channels(config, transport, reply, c.stop)
    let h = (<-reply) ?? return
    c.channel_peer = h
    c.sctp_events = chan[datachannel.Event](16)
    spawn forward_sctp_events(h.events, c.sctp_events)
    spawn forward_channels(h.incoming, c.channels)
}

fn stop_channels(c: *Core) {
    c.data = false
    if !c.sctp_up {
        end_channels(c)
        return
    }
    let h = c.channel_peer ?? return
    c.channel_peer = none
    c.sctp_up = false
    flush_opening(c)
    datachannel.shutdown_peer(h)
    c.closing_peer = h
    c.closings += 1
    spawn expire_shutdown(c, c.closings)
}

fn expire_shutdown(c: *Core, round: i64) {
    select {
        after(shutdown_wait) => {}
        <-c.gone => return
    }
    select {
        c.commands <- Command.ShutdownExpired(round) => {}
        <-c.gone => {}
    }
}

fn abort_closing(c: *Core) {
    let h = c.closing_peer ?? return
    datachannel.close_peer(h)
    c.closing_peer = none
}

fn end_channels(c: *Core) {
    abort_closing(c)
    let h = c.channel_peer ?? return
    datachannel.close_peer(h)
    c.channel_peer = none
    c.sctp_up = false
    flush_opening(c)
}

fn on_dtls_connected(c: *Core, link: dtlssession.Handle) {
    c.dtls_up = true
    let info = dtlssession.describe_session(link) or return
    if info.srtp_profile != 0 {
        let size = srtp.keying_material_size(info.srtp_profile) or 0
        let material = dtlssession.export_keying_material(link, "EXTRACTOR-dtls_srtp", size) or []
        c.srtp = srtp.from_dtls(info.srtp_profile, material, c.dtls_client) catch {
            _ => {
                set_state(c, State.Failed)
                return
            }
        }
    }
    if c.data {
        open_channels(c, link)
        return
    }
    set_state(c, State.Connected)
}

fn on_ice(c: *Core, e: ice.Event) {
    match e {
        LocalCandidate(candidate) => publish(c, Event.Candidate(candidate_value(c, candidate)))
        GatheringComplete => publish(c, Event.GatheringComplete)
        Selected(local, remote) => {
            publish(c, Event.Selected(local, remote))
            if c.dtls == none {
                let link = c.ice ?? return
                open_dtls(c, link)
            }
        }
        StateChanged(s) => match s {
            Disconnected => {
                if c.state == State.Connected {
                    set_state(c, State.Disconnected)
                }
            }
            Completed => {
                if c.state == State.Disconnected {
                    set_state(c, State.Connected)
                }
            }
            Failed => set_state(c, State.Failed)
            _ => {}
        }
    }
}

fn on_dtls(c: *Core, e: dtls.Event) {
    match e {
        Connected => {
            let link = c.dtls ?? return
            on_dtls_connected(c, link)
        }
        Failed(_) => set_state(c, State.Failed)
        Closed => set_state(c, State.Closed)
    }
}

fn on_sctp(c: *Core, e: datachannel.Event) {
    match e {
        Connected => {
            c.sctp_up = true
            flush_opening(c)
            set_state(c, State.Connected)
        }
        Failed(_) => {
            end_channels(c)
            if c.data && !c.offering && !data_stopping(c) {
                set_state(c, State.Failed)
            }
        }
        Closed => end_channels(c)
    }
}

fn on_datagram(c: *Core, d: icesession.Datagram) {
    match rtp.classify(d.data) {
        Dtls => {
            select {
                c.dtls_in <- d.data => {}
                else => {}
            }
        }
        Rtp => receive_rtp(c, d.data)
        Rtcp => receive_rtcp(c, d.data)
        _ => {}
    }
}

fn receive_rtp(c: *Core, data: u8[]) {
    let pair = c.srtp ?? return
    let plain = srtp.unprotect(pair.receive, data) catch {
        _ => return
    }
    let packet = rtp.parse(plain) catch {
        _ => return
    }
    let at = route(c, packet) ?? return
    let t = c.lines[at].remote ?? return
    select {
        t.packets <- packet => {}
        else => {}
    }
}

fn receive_rtcp(c: *Core, data: u8[]) {
    let pair = c.srtp ?? return
    let plain = srtp.unprotect_rtcp(pair.receive, data) catch {
        _ => return
    }
    let packets = rtp.parse_rtcp(plain) catch {
        _ => return
    }
    select {
        c.rtcp <- packets => {}
        else => {}
    }
}

fn carries(t: RemoteTrack, payload_type: i64) -> bool {
    for codec in t.codecs {
        if codec.payload_type == payload_type {
            return true
        }
    }
    false
}

fn route(c: *Core, p: rtp.Packet) -> i64? {
    match c.by_ssrc[p.ssrc] {
        some(at) => return at
        none => {}
    }
    for i, l in c.lines {
        let t = l.remote ?? continue
        if t.ssrc == 0 && carries(t, p.payload_type) {
            c.by_ssrc[p.ssrc] = i
            return i
        }
    }
    none
}

fn sending(c: *Core, ssrc: i64) -> bool {
    for l in c.lines {
        if l.track >= 0 && c.tracks[l.track].ssrc == ssrc && !l.stopped {
            return true
        }
    }
    false
}

fn send_rtp_now(c: *Core, ssrc: i64, packet: rtp.Packet) -> io.Error? {
    if !sending(c, ssrc) {
        return io.Error.NotConnected
    }
    let pair = c.srtp ?? return io.Error.NotConnected
    let link = c.ice ?? return io.Error.NotConnected
    var p = packet
    p.ssrc = ssrc
    let plain = rtp.marshal(p) catch {
        e => return e
    }
    let sealed = srtp.protect(pair.send, plain) catch {
        _ => return io.Error.Invalid
    }
    icesession.send(link, sealed) catch {
        e => return e
    }
    none
}

fn send_rtcp_now(c: *Core, packets: rtp.Rtcp[]) -> io.Error? {
    let pair = c.srtp ?? return io.Error.NotConnected
    let link = c.ice ?? return io.Error.NotConnected
    let plain = rtp.marshal_rtcp(packets) catch {
        e => return e
    }
    let sealed = srtp.protect_rtcp(pair.send, plain) catch {
        _ => return io.Error.Invalid
    }
    icesession.send(link, sealed) catch {
        e => return e
    }
    none
}

fn open_channel_now(c: *Core, options: datachannel.Options) -> Opened {
    let h = c.channel_peer ?? return Opened.Refused(io.Error.NotConnected)
    let channel = datachannel.open_channel(h, options) catch {
        e => return Opened.Refused(e)
    }
    Opened.Ready(channel)
}

fn open_channel_later(c: *Core, options: datachannel.Options, reply: chan[Opened]) {
    if c.channel_peer != none && !c.sctp_up {
        c.opening.push(Opening { options, reply })
        return
    }
    reply <- open_channel_now(c, options)
}

fn flush_opening(c: *Core) {
    for o in c.opening {
        o.reply <- open_channel_now(c, o.options)
    }
    c.opening = []
}

fn add_track_now(c: *Core, kind: Kind, codecs: Codec[]) -> Track {
    let ssrc = random_ssrc()
    c.tracks.push(Local { kind, ssrc, codecs, track_id: random_token(16) })
    let t = c.tracks.len - 1
    let reuse = reusable_line(c, kind)
    if reuse < 0 {
        c.lines.push(track_line(kind, t, codecs))
    } else {
        c.lines[reuse].track = t
        c.lines[reuse].used = true
        c.lines[reuse].wanted = with_send(c.lines[reuse].wanted)
    }
    Track { kind, ssrc, core: c }
}

fn track_of(c: *Core, ssrc: i64) -> i64 {
    for i, l in c.tracks {
        if l.ssrc == ssrc {
            return i
        }
    }
    -1
}

fn negotiated_codecs(c: *Core, ssrc: i64) -> Codec[] {
    let t = track_of(c, ssrc)
    if t < 0 { [] } else { c.tracks[t].codecs }
}

fn remove_track_now(c: *Core, ssrc: i64) {
    let t = track_of(c, ssrc)
    if t < 0 {
        return
    }
    for i, l in c.lines {
        if l.track == t {
            c.lines[i].track = -1
            c.lines[i].wanted = without_send(l.wanted)
            c.lines[i].stopping = l.stopping || l.mid.len == 0
        }
    }
}

fn set_direction_now(c: *Core, mid: str, d: sdp.Direction) -> Error? {
    let i = line_of(c, mid)
    if i < 0 || c.lines[i].data || c.lines[i].stopped {
        return Error.Invalid("no audio or video section {mid}")
    }
    c.lines[i].wanted = d
    none
}

fn stop_section_now(c: *Core, mid: str) -> Error? {
    let i = line_of(c, mid)
    if i < 0 {
        return Error.Invalid("no section {mid}")
    }
    c.lines[i].stopping = !c.lines[i].stopped
    none
}

fn transceivers_now(c: *Core) -> Transceiver[] {
    var out: Transceiver[] = []
    for l in c.lines {
        let ssrc = if l.track >= 0 { c.tracks[l.track].ssrc } else { 0 }
        out.push(Transceiver { mid: l.mid, media: l.media, direction: l.wanted, current: l.current, stopped: l.stopped, ssrc })
    }
    out
}

fn add_candidate_now(c: *Core, value: str) -> Error? {
    let link = c.ice ?? return Error.WrongState
    if !c.described {
        return Error.WrongState
    }
    add_remote(c, link, value)
}

fn end_candidates_now(c: *Core) -> Error? {
    let link = c.ice ?? return Error.WrongState
    end_remote(c, link)
    none
}

fn resolved_now(c: *Core, value: str?) {
    c.resolving -= 1
    let link = c.ice ?? return
    match value {
        some(v) => {
            add_remote(c, link, v)
        }
        none => {}
    }
    if c.resolving == 0 && c.remote_ended {
        end_remote(c, link)
    }
}

fn handle(c: *Core, command: Command) -> bool {
    match command {
        AddTrack(kind, codecs, reply) => {
            reply <- add_track_now(c, kind, codecs)
        }
        Offer(reply) => {
            reply <- offer_now(c)
        }
        Answer(offer, reply) => {
            reply <- answer_now(c, offer)
        }
        Accept(answer, reply) => {
            reply <- accept_now(c, answer)
        }
        AddCandidate(value, reply) => {
            reply <- add_candidate_now(c, value)
        }
        EndCandidates(reply) => {
            reply <- end_candidates_now(c)
        }
        Resolved(value) => resolved_now(c, value)
        OpenChannel(options, reply) => open_channel_later(c, options, reply)
        SendRtp(ssrc, packet, reply) => {
            reply <- send_rtp_now(c, ssrc, packet)
        }
        SendRtcp(packets, reply) => {
            reply <- send_rtcp_now(c, packets)
        }
        Negotiated(ssrc, reply) => {
            reply <- negotiated_codecs(c, ssrc)
        }
        RemoveTrack(ssrc, reply) => {
            remove_track_now(c, ssrc)
            reply <- true
        }
        SetDirection(mid, d, reply) => {
            reply <- set_direction_now(c, mid, d)
        }
        StopSection(mid, reply) => {
            reply <- stop_section_now(c, mid)
        }
        RestartIce(reply) => {
            c.restart_wanted = true
            reply <- true
        }
        Rollback(reply) => {
            reply <- rollback_now(c)
        }
        Transceivers(reply) => {
            reply <- transceivers_now(c)
        }
        GetSignaling(reply) => {
            reply <- if c.offering { Signaling.HaveLocalOffer } else { Signaling.Stable }
        }
        WaitConnected(reply) => {
            if c.state == State.Connected || c.state == State.Failed || c.state == State.Closed {
                reply <- c.state
            } else {
                c.waiters.push(reply)
            }
        }
        ShutdownExpired(round) => if round == c.closings {
            abort_closing(c)
        }
        Close => return false
    }
    true
}

fn next_step(c: *Core) -> Step {
    select {
        command = <-c.commands => match command {
            some(x) => Step.Command(x)
            none => Step.Ended
        }
        e = <-c.ice_events => match e {
            some(x) => Step.Ice(x)
            none => Step.IceEnded
        }
        d = <-c.ice_incoming => match d {
            some(x) => Step.Datagram(x)
            none => Step.DatagramsEnded
        }
        e = <-c.dtls_events => match e {
            some(x) => Step.Dtls(x)
            none => Step.DtlsEnded
        }
        e = <-c.sctp_events => match e {
            some(x) => Step.Sctp(x)
            none => Step.SctpEnded
        }
    }
}

fn run(c: *Core) {
    for {
        var running = true
        match next_step(c) {
            Command(command) => {
                running = handle(c, command)
            }
            Ice(e) => on_ice(c, e)
            IceEnded => {
                c.ice_events = chan[ice.Event]()
            }
            Datagram(d) => on_datagram(c, d)
            DatagramsEnded => {
                c.ice_incoming = chan[icesession.Datagram]()
            }
            Dtls(e) => on_dtls(c, e)
            DtlsEnded => {
                c.dtls_events = chan[dtls.Event]()
            }
            Sctp(e) => on_sctp(c, e)
            SctpEnded => {
                c.sctp_events = chan[datachannel.Event]()
            }
            Ended => {
                running = false
            }
        }
        if !running {
            break
        }
    }
    finish(c)
}

fn finish(c: *Core) {
    end_channels(c)
    match c.dtls {
        some(h) => dtlssession.close_session(h)
        none => {}
    }
    match c.ice {
        some(h) => icesession.close_session(h)
        none => {}
    }
    close(c.stop)
    set_state(c, State.Closed)
    for l in c.lines {
        match l.remote {
            some(t) => close(t.packets)
            none => {}
        }
    }
    close(c.events)
    close(c.channels)
    close(c.rtcp)
    close(c.gone)
}

fn stop_core(c: *Core) {
    select {
        c.commands <- Command.Close => {}
        <-c.gone => {}
    }
}

fn ask[T](c: *Core, command: Command, reply: chan[T]) -> T ! io.Error {
    select {
        c.commands <- command => {}
        <-c.gone => fail NotConnected
    }
    select {
        answer = <-reply => match answer {
            some(v) => v
            none => fail NotConnected
        }
        <-c.gone => fail NotConnected
    }
}

fn described(h: Handle, command: Command, reply: chan[Described]) -> sdp.Session ! Error {
    let answer = ask(h.core, command, reply) or fail Closed
    match answer {
        Done(session) => session
        Refused(error) => fail error
    }
}

fn applied(h: Handle, command: Command, reply: chan[Error?]) ! Error {
    let failure = ask(h.core, command, reply) or fail Closed
    match failure {
        some(e) => fail e
        none => {}
    }
}

/// Adds a local track of `kind` that sends with `codecs`, for the next `create_offer` or `create_answer` to describe.
///
/// The track takes the first audio or video section of its kind that a remote offer made and no track has sent on, which then asks to send as well; otherwise it gets a section of its own, which the next offer appends or the next remote offer's first new section of its kind takes. Fails with `NotConnected` once the peer has closed.
pub fn add_track(h: Handle, kind: Kind, codecs: Codec[]) -> Track ! io.Error {
    let reply = chan[Track](1)
    ask(h.core, Command.AddTrack(kind, codecs, reply), reply)?
}

/// Creates an offer and makes it the local description, which leaves the signalling state `HaveLocalOffer`: the negotiated media sections in their order and with their `mid`s, then one new section per local track without one, then a data channel section when `Config.data_channels` is set and no exchange has had one, all in one BUNDLE group.
///
/// The first offer opens the ICE sockets, and the peer is the controlling agent; every offer says `actpass`. After `restart_ice` the offer carries new ICE credentials and gathers again. A stopped or rejected section keeps its place at port 0. The offer carries the candidates gathered so far; the others arrive as `Event.Candidate`. Fails with `WrongState` while an offer is outstanding, with `Unavailable` when no socket could be opened and with `Closed` once the peer has closed.
pub fn create_offer(h: Handle) -> sdp.Session ! Error {
    let reply = chan[Described](1)
    described(h, Command.Offer(reply), reply)?
}

/// Applies `offer` as the remote description and returns the answer, which becomes the local description.
///
/// The first exchange opens the ICE sockets when no offer did, and the peer is the controlled agent; the answer takes the DTLS client role unless the offer said `active`, and later answers keep the role. The answer accepts one data channel section when `Config.data_channels` is set and gives each new audio or video section the first local track of its kind without a section that shares a codec, keeping the payload types of the offered codecs that share a name and clock rate with the track's. Each section sends when its track and its direction let it and the remote receives, and receives when its direction lets it and the remote sends. An offer whose ICE credentials changed restarts ICE here too. A section the peer cannot use, and one stopped with `stop_section`, is rejected with port 0. Fails with `Invalid` for an offer without ICE credentials or a fingerprint, with a changed fingerprint once DTLS is up, or whose sections do not start with the negotiated `mid`s in their order, with `WrongState` while this peer's own offer is outstanding (call `rollback` first), and as `create_offer` does.
pub fn create_answer(h: Handle, offer: sdp.Session) -> sdp.Session ! Error {
    let reply = chan[Described](1)
    described(h, Command.Answer(offer, reply), reply)?
}

/// Applies `answer` as the remote description of the offer `create_offer` made, which returns the signalling state to `Stable`.
///
/// Fails with `WrongState` when no offer is outstanding and with `Invalid` for an answer whose sections or `mid`s do not match the offer, that lacks ICE credentials or a fingerprint, or whose fingerprint changed once DTLS is up.
pub fn apply_answer(h: Handle, answer: sdp.Session) ! Error {
    let reply = chan[Error?](1)
    applied(h, Command.Accept(answer, reply), reply)?
}

/// Adds a remote candidate that arrived by trickle, the value of an `a=candidate` attribute with or without the `candidate:` prefix.
///
/// A candidate whose address is a `.local` name is added once mDNS resolves the name, and dropped when no answer comes within 5 seconds; a TCP candidate, another host name and a candidate of component 2 are skipped. Fails with `WrongState` before a remote description is applied and with `Invalid` for a value that is not a candidate.
pub fn add_remote_candidate(h: Handle, value: str) ! Error {
    let reply = chan[Error?](1)
    applied(h, Command.AddCandidate(value, reply), reply)?
}

/// Tells the peer the remote peer has no more candidates.
///
/// ICE hears of it once every `.local` name still being resolved has an answer or has timed out.
///
/// Fails with `WrongState` before the ICE sockets are open.
pub fn end_of_remote_candidates(h: Handle) ! Error {
    let reply = chan[Error?](1)
    applied(h, Command.EndCandidates(reply), reply)?
}

/// Waits until the state is `Connected`.
///
/// Fails with `Refused` when it becomes `Failed` and with `NotConnected` when the peer closes first.
pub fn wait_connected(h: Handle) ! io.Error {
    let reply = chan[State](1)
    let reached = ask(h.core, Command.WaitConnected(reply), reply)?
    match reached {
        Connected => {}
        Failed => fail Refused
        _ => fail NotConnected
    }
}

/// Opens a data channel with `options` over the negotiated SCTP association.
///
/// Waits while the association of a negotiated data channel section is still connecting, as after a later exchange adds the section. Fails with `NotConnected` before DTLS is up, when no data channel section was negotiated or its association ended, and once the peer has closed, and as `datachannel.open_channel` does.
pub fn create_data_channel(h: Handle, options: datachannel.Options) -> datachannel.Channel ! io.Error {
    let reply = chan[Opened](1)
    let answer = ask(h.core, Command.OpenChannel(options, reply), reply)?
    match answer {
        Ready(channel) => channel
        Refused(error) => fail error
    }
}

/// Returns the codecs negotiated for `t`, whose payload types its packets must carry: the track's own before negotiation and the answer's after.
///
/// Fails with `NotConnected` once the peer has closed.
pub fn codecs(t: Track) -> Codec[] ! io.Error {
    let reply = chan[Codec[]](1)
    ask(t.core, Command.Negotiated(t.ssrc, reply), reply)?
}

/// Encrypts `packet` with SRTP and sends it on the selected ICE pair, with the track's synchronization source in place of `packet.ssrc`.
///
/// Fails with `NotConnected` before DTLS has produced the SRTP keys, after `remove_track`, when the track's section is stopped and once the peer has closed, with `Invalid` when the packet does not encode or SRTP refuses it, and with the error of the socket.
pub fn send_rtp(t: Track, packet: rtp.Packet) ! io.Error {
    let reply = chan[io.Error?](1)
    let failure = ask(t.core, Command.SendRtp(t.ssrc, packet, reply), reply)?
    match failure {
        some(e) => fail e
        none => {}
    }
}

/// Encrypts `packets` as one compound SRTCP packet and sends it. Fails as `send_rtp` does.
pub fn send_rtcp(h: Handle, packets: rtp.Rtcp[]) ! io.Error {
    let reply = chan[io.Error?](1)
    let failure = ask(h.core, Command.SendRtcp(packets, reply), reply)?
    match failure {
        some(e) => fail e
        none => {}
    }
}

/// Stops `t` sending: its section stops asking to send, `sendrecv` becoming `recvonly` and `sendonly` becoming `inactive`, from the next exchange, and `send_rtp` on it fails from now on.
///
/// The section keeps its `mid`, and a later `add_track` does not reuse it. Fails with `NotConnected` once the peer has closed.
pub fn remove_track(t: Track) ! io.Error {
    let reply = chan[bool](1)
    ask(t.core, Command.RemoveTrack(t.ssrc, reply), reply)?
}

/// Sets the direction the audio or video section `mid` asks for from the next exchange, the W3C `RTCRtpTransceiver.direction`; a section without a track never offers to send.
///
/// Fails with `Invalid` for a `mid` no audio or video section has and for a stopped section, and with `Closed` once the peer has closed.
pub fn set_direction(h: Handle, mid: str, direction: sdp.Direction) ! Error {
    let reply = chan[Error?](1)
    applied(h, Command.SetDirection(mid, direction, reply), reply)?
}

/// Stops the section `mid`: the next offer or answer rejects it with port 0, after which its remote track ends, a data channel section shuts its association down, delivering what its channels queued before they end, and the section keeps its place.
///
/// Fails with `Invalid` for a `mid` no section has and with `Closed` once the peer has closed.
pub fn stop_section(h: Handle, mid: str) ! Error {
    let reply = chan[Error?](1)
    applied(h, Command.StopSection(mid, reply), reply)?
}

/// Asks the next `create_offer` to restart ICE (RFC 8445 section 9): the peer takes new credentials, forgets the remote candidates and gathers again, and the selected pair carries DTLS, SRTP and SCTP until the new checks select one, reported by `Event.Selected`.
///
/// A `rollback` of that offer keeps the new credentials, so the next answer or offer carries them. Fails with `NotConnected` once the peer has closed.
pub fn restart_ice(h: Handle) ! io.Error {
    let reply = chan[bool](1)
    ask(h.core, Command.RestartIce(reply), reply)?
}

/// Discards the outstanding local offer and returns the signalling state to `Stable`, so the peer can answer a remote offer that crossed it (glare).
///
/// Sections the offer added lose their `mid`s and a data channel section it added goes. Fails with `WrongState` when no offer is outstanding and with `Closed` once the peer has closed.
pub fn rollback(h: Handle) ! Error {
    let reply = chan[Error?](1)
    applied(h, Command.Rollback(reply), reply)?
}

/// Returns the media sections in their order, the negotiated ones first.
///
/// Fails with `NotConnected` once the peer has closed.
pub fn transceivers(h: Handle) -> Transceiver[] ! io.Error {
    let reply = chan[Transceiver[]](1)
    ask(h.core, Command.Transceivers(reply), reply)?
}

/// Returns the signalling state.
///
/// Fails with `NotConnected` once the peer has closed.
pub fn signaling(h: Handle) -> Signaling ! io.Error {
    let reply = chan[Signaling](1)
    ask(h.core, Command.GetSignaling(reply), reply)?
}

/// Closes the peer: the data channels, the SCTP association, DTLS with `close_notify` and the ICE sockets, in that order.
pub fn close_peer(h: Handle) {
    stop_core(h.core)
}
