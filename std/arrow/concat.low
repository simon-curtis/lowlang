import std/io

fn append_bits(mut out: u8[], at: i64, source: u8[], n: i64, all_set: bool) {
    for i in 0..n {
        let k = at + i
        if k & 7 == 0 {
            out.push(0)
        }
        let set = if all_set { true } else { bit_at(source, i) }
        if set {
            out[k >> 3] = out[k >> 3] | u8(1 << (k & 7))
        }
    }
}

fn joined_validity(a: Array, b: Array) -> u8[] {
    if a.null_count + b.null_count == 0 {
        return []
    }
    var out: u8[] = []
    append_bits(mut out, 0, a.validity, a.length, a.validity.len == 0)
    append_bits(mut out, a.length, b.validity, b.length, b.validity.len == 0)
    out
}

fn joined(a: u8[], b: u8[]) -> u8[] {
    var out = io.buffer(a.len + b.len)
    io.copy(out, a)
    io.copy(out[a.len..], b)
    out
}

fn joined_offsets(a: Array, b: Array, shift: i64, width: i64) -> u8[] {
    var out: u8[] = []
    io.append(mut out, a.buffers[0][..(a.length + 1) * width])
    for i in 1..b.length + 1 {
        io.put_le(mut out, read_signed(b.buffers[0], i * width, width) + shift, width)
    }
    out
}

fn check_offset_span(a: Array, total: i64) ! Error {
    let w = offset_width(a.data_type)
    if a.length > 0 && (read_signed(a.buffers[0], 0, w) != 0 || read_signed(a.buffers[0], a.length * w, w) != total) {
        fail Unsupported("joining dictionary values whose offsets do not span their data")
    }
}

fn concat_children(a: Array, b: Array) -> Array[] ! Error {
    var out: Array[] = []
    for k in 0..a.children.len {
        let c = concat(a.children[k], b.children[k])?
        out.push(c)
    }
    out
}

fn concat(a: Array, b: Array) -> Array ! Error {
    if type_name(a.data_type) != type_name(b.data_type) || a.children.len != b.children.len {
        fail Mismatch("joining {type_name(a.data_type)} with {type_name(b.data_type)}")
    }
    if a.length == 0 {
        return b
    }
    if b.length == 0 {
        return a
    }
    let length = a.length + b.length
    if length > max_length {
        fail TooLarge("array length")
    }
    var buffers: u8[][] = []
    var children: Array[] = []
    match a.data_type {
        Null => {}
        Bool => {
            var bits: u8[] = []
            append_bits(mut bits, 0, a.buffers[0], a.length, false)
            append_bits(mut bits, a.length, b.buffers[0], b.length, false)
            buffers.push(bits)
        }
        Utf8 => join_bytes(a, b, mut buffers)?
        LargeUtf8 => join_bytes(a, b, mut buffers)?
        Binary => join_bytes(a, b, mut buffers)?
        LargeBinary => join_bytes(a, b, mut buffers)?
        List(_) => {
            children = concat_children(a, b)?
            join_lists(a, b, mut buffers)?
        }
        LargeList(_) => {
            children = concat_children(a, b)?
            join_lists(a, b, mut buffers)?
        }
        Map(_, _) => {
            children = concat_children(a, b)?
            join_lists(a, b, mut buffers)?
        }
        FixedSizeList(_, _) => {
            children = concat_children(a, b)?
        }
        Struct(_) => {
            children = concat_children(a, b)?
        }
        Union(mode, _, _) => {
            children = concat_children(a, b)?
            buffers.push(joined(a.buffers[0][..a.length], b.buffers[0][..b.length]))
            if mode == UnionMode.Dense {
                var offsets: u8[] = []
                io.append(mut offsets, a.buffers[1][..a.length * 4])
                for i in 0..b.length {
                    let slot = union_slot(b, i)
                    io.put_le(mut offsets, slot.end + a.children[slot.start].length, 4)
                }
                buffers.push(offsets)
            }
        }
        Dictionary(_, _, _, _) => fail Unsupported("joining dictionary arrays")
        _ => {
            let w = value_width(a.data_type)
            buffers.push(joined(a.buffers[0][..a.length * w], b.buffers[0][..b.length * w]))
        }
    }
    Array { data_type: a.data_type, length, null_count: a.null_count + b.null_count, validity: joined_validity(a, b), buffers, children }
}

fn join_bytes(a: Array, b: Array, mut buffers: u8[][]) ! Error {
    let w = offset_width(a.data_type)
    check_offset_span(a, a.buffers[1].len)?
    check_offset_span(b, b.buffers[1].len)?
    buffers.push(joined_offsets(a, b, a.buffers[1].len, w))
    buffers.push(joined(a.buffers[1], b.buffers[1]))
}

fn join_lists(a: Array, b: Array, mut buffers: u8[][]) ! Error {
    let w = offset_width(a.data_type)
    check_offset_span(a, a.children[0].length)?
    check_offset_span(b, b.children[0].length)?
    buffers.push(joined_offsets(a, b, a.children[0].length, w))
}
