import std/io

/// The error returned by Arrow arrays, builders and the IPC stream and file formats.
pub enum Error {
    /// The input is not valid Arrow data. `at` is the offset of the offending bytes in the input, or `-1` when the problem is in a value that has no offset, and `message` says what is wrong.
    Invalid(at: i64, message: str)
    /// The input ends before a message, buffer or footer is complete. `at` is the offset where bytes were missing.
    Truncated(at: i64)
    /// A length, count or nesting depth in the input exceeds a limit. `message` names it.
    TooLarge(message: str)
    /// The input uses a feature this module does not implement, `feature`.
    Unsupported(feature: str)
    /// A value does not fit the type of the array or builder it is given to; `message` says why.
    Mismatch(message: str)
    /// Reading or writing a stream failed.
    Io(error: io.Error)
}

/// Returns a one-line description of `e`.
pub fn message(e: Error) -> str {
    match e {
        Invalid(at, m) => if at >= 0 { "{m} at offset {at}" } else { m }
        Truncated(at) => "input ends at offset {at}"
        TooLarge(m) => "{m} exceeds a limit"
        Unsupported(f) => "unsupported: {f}"
        Mismatch(m) => "value does not fit the type: {m}"
        Io(error) => "i/o error: {error}"
    }
}

/// The resolution of a time, timestamp or duration.
pub enum TimeUnit {
    /// Seconds.
    Second
    /// Milliseconds.
    Millisecond
    /// Microseconds.
    Microsecond
    /// Nanoseconds.
    Nanosecond
}

/// The resolution of a date.
pub enum DateUnit {
    /// Days since the Unix epoch, in 32 bits.
    Day
    /// Milliseconds since the Unix epoch, in 64 bits, a multiple of a day.
    Millisecond
}

/// The layout of an interval value.
pub enum IntervalUnit {
    /// A 32-bit count of months.
    YearMonth
    /// Two 32-bit counts, days and milliseconds.
    DayTime
    /// A 32-bit count of months, a 32-bit count of days and a 64-bit count of nanoseconds.
    MonthDayNano
}

/// How a union stores its members.
pub enum UnionMode {
    /// Every child has as many slots as the union and a slot is read from the child its type id selects.
    Sparse
    /// Each child holds only its own values and an offset buffer points into it.
    Dense
}

/// The logical type of an array and the layout of its buffers.
pub enum DataType {
    /// Only nulls; no buffers.
    Null
    /// One bit per value.
    Bool
    /// A fixed-width integer of `bits` 8, 16, 32 or 64, signed or unsigned.
    Int(bits: i64, signed: bool)
    /// A floating point number of `bits` 16, 32 or 64.
    Float(bits: i64)
    /// UTF-8 text with 32-bit offsets.
    Utf8
    /// UTF-8 text with 64-bit offsets.
    LargeUtf8
    /// Bytes with 32-bit offsets.
    Binary
    /// Bytes with 64-bit offsets.
    LargeBinary
    /// Bytes of one fixed `width`.
    FixedSizeBinary(width: i64)
    /// A 128-bit decimal of `precision` digits with `scale` of them after the point, stored as little-endian two's complement.
    Decimal(precision: i64, scale: i64)
    /// A date in the layout `unit` names.
    Date(unit: DateUnit)
    /// A time of day in `unit`: 32 bits for seconds and milliseconds, 64 for microseconds and nanoseconds.
    Time(unit: TimeUnit)
    /// A 64-bit count of `unit` since the Unix epoch, in the time zone `timezone`, empty for none.
    Timestamp(unit: TimeUnit, timezone: str)
    /// A 64-bit count of `unit`.
    Duration(unit: TimeUnit)
    /// An interval in the layout `unit` names.
    Interval(unit: IntervalUnit)
    /// Variable-length lists with 32-bit offsets of the child `item`.
    List(item: *Field)
    /// Variable-length lists with 64-bit offsets of the child `item`.
    LargeList(item: *Field)
    /// Lists of exactly `size` elements of the child `item`.
    FixedSizeList(item: *Field, size: i64)
    /// A record with one child per field.
    Struct(fields: Field[])
    /// A list of key and value pairs: `entries` is a struct field with the key then the value.
    Map(entries: *Field, keys_sorted: bool)
    /// A value of one of `fields`, selected by `type_ids`, which give each field's type id in the type id buffer.
    Union(mode: UnionMode, fields: Field[], type_ids: i64[])
    /// Integers of `index` that select values of the type `value`. The values are the array's `dictionary`, whose messages carry `id`.
    Dictionary(id: i64, index: *DataType, value: *DataType, ordered: bool)
}

/// A named, typed column of a schema or a child of a nested type.
pub struct Field {
    /// The name.
    pub name: str
    /// The type.
    pub data_type: DataType
    /// Whether the column may hold nulls. Defaults to `true`.
    pub nullable: bool = true
    /// Key and value metadata.
    pub metadata: [str: str] = [:]
}

/// The columns of a record batch, with key and value metadata.
pub struct Schema {
    /// The columns.
    pub fields: Field[]
    /// Key and value metadata of the schema.
    pub metadata: [str: str] = [:]
}

/// Returns the number of bits of `unit`'s time of day, 32 or 64.
pub fn time_bits(unit: TimeUnit) -> i64 {
    match unit {
        Second => 32
        Millisecond => 32
        Microsecond => 64
        Nanosecond => 64
    }
}

/// Returns the name of `unit`: `s`, `ms`, `us` or `ns`.
pub fn unit_name(unit: TimeUnit) -> str {
    match unit {
        Second => "s"
        Millisecond => "ms"
        Microsecond => "us"
        Nanosecond => "ns"
    }
}

/// Returns a short description of `t`, such as `int32` or `list<utf8>`.
pub fn type_name(t: DataType) -> str {
    match t {
        Null => "null"
        Bool => "bool"
        Int(bits, signed) => if signed { "int{bits}" } else { "uint{bits}" }
        Float(bits) => "float{bits}"
        Utf8 => "utf8"
        LargeUtf8 => "large_utf8"
        Binary => "binary"
        LargeBinary => "large_binary"
        FixedSizeBinary(width) => "fixed_size_binary[{width}]"
        Decimal(precision, scale) => "decimal128({precision}, {scale})"
        Date(unit) => match unit {
            Day => "date32"
            Millisecond => "date64"
        }
        Time(unit) => "time{time_bits(unit)}[{unit_name(unit)}]"
        Timestamp(unit, zone) => if zone.len == 0 { "timestamp[{unit_name(unit)}]" } else { "timestamp[{unit_name(unit)}, tz={zone}]" }
        Duration(unit) => "duration[{unit_name(unit)}]"
        Interval(unit) => match unit {
            YearMonth => "month_interval"
            DayTime => "day_time_interval"
            MonthDayNano => "month_day_nano_interval"
        }
        List(item) => "list<{type_name(item.data_type)}>"
        LargeList(item) => "large_list<{type_name(item.data_type)}>"
        FixedSizeList(item, size) => "fixed_size_list<{type_name(item.data_type)}>[{size}]"
        Struct(_) => "struct"
        Map(_, _) => "map"
        Union(mode, _, _) => match mode {
            Sparse => "sparse_union"
            Dense => "dense_union"
        }
        Dictionary(_, index, value, _) => "dictionary<{type_name(*value)}, {type_name(*index)}>"
    }
}

/// A column of values: a type, a length and the buffers that hold the values.
///
/// The buffers follow the Arrow columnar layout. `validity` is a bitmap with one bit per value, set when the value is not null, and is empty when `null_count` is `0`; `Null` and union arrays have none. `buffers` holds what the type stores next: the data of a fixed-width type (a bitmap for `Bool`); the offsets then the data of a binary or text type; the offsets of a list or map; the type ids then, for a dense union, the offsets of a union; the indices of a dictionary array. A struct, fixed-size list and `Null` array have no buffers of their own. Nested types keep their values in `children`, a dictionary array its values in `dictionary`. An array always starts at offset 0.
pub struct Array {
    /// The type.
    pub data_type: DataType
    /// The number of values.
    pub length: i64
    /// The number of null values.
    pub null_count: i64
    /// The validity bitmap, or empty.
    pub validity: u8[]
    /// The value buffers.
    pub buffers: u8[][]
    /// The child arrays of a nested type.
    pub children: Array[]
    /// The dictionary of a `Dictionary` array.
    pub dictionary: *Array? = none
}

/// A set of equal-length columns under a schema.
pub struct Batch {
    /// The schema.
    pub schema: Schema
    /// The number of rows.
    pub length: i64
    /// The columns, one per field of `schema`.
    pub columns: Array[]
}
