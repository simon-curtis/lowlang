import std/io
import std/unicode

struct Table {
    data: u8[]
    pos: i64
}

struct Vector {
    data: u8[]
    start: i64
    len: i64
}

fn need(data: u8[], at: i64, n: i64) ! Error {
    if at < 0 || n < 0 || at > data.len - n {
        fail Invalid(at, "a metadata read is outside the message")
    }
}

fn read_u8(data: u8[], at: i64) -> i64 ! Error {
    need(data, at, 1)?
    i64(data[at])
}

fn read_u16(data: u8[], at: i64) -> i64 ! Error {
    need(data, at, 2)?
    io.le16(data, at) & 0xFFFF
}

fn read_i16(data: u8[], at: i64) -> i64 ! Error {
    need(data, at, 2)?
    let v = io.le16(data, at) & 0xFFFF
    if v >= 32768 { v - 65536 } else { v }
}

fn read_u32(data: u8[], at: i64) -> i64 ! Error {
    need(data, at, 4)?
    io.le32(data, at) & 0xFFFFFFFF
}

fn read_i32(data: u8[], at: i64) -> i64 ! Error {
    need(data, at, 4)?
    let v = io.le32(data, at) & 0xFFFFFFFF
    if v >= 2147483648 { v - 4294967296 } else { v }
}

fn read_i64(data: u8[], at: i64) -> i64 ! Error {
    need(data, at, 8)?
    io.le64(data, at)
}

fn table_at(data: u8[], pos: i64) -> Table ! Error {
    let back = read_i32(data, pos)?
    let vtable = pos - back
    need(data, vtable, 4)?
    let size = read_u16(data, vtable)?
    if size < 4 || size % 2 != 0 {
        fail Invalid(vtable, "a vtable has a bad size")
    }
    need(data, vtable, size)?
    Table { data, pos }
}

fn root_table(data: u8[]) -> Table ! Error {
    let offset = read_u32(data, 0)?
    table_at(data, offset)?
}

fn slot_pos(t: Table, slot: i64) -> i64 ! Error {
    let vtable = t.pos - read_i32(t.data, t.pos)?
    let size = read_u16(t.data, vtable)?
    let at = 4 + 2 * slot
    if at + 2 > size {
        return -1
    }
    let offset = read_u16(t.data, vtable + at)?
    if offset == 0 {
        return -1
    }
    t.pos + offset
}

fn get_i64(t: Table, slot: i64, default: i64) -> i64 ! Error {
    let p = slot_pos(t, slot)?
    if p < 0 {
        return default
    }
    read_i64(t.data, p)?
}

fn get_i32(t: Table, slot: i64, default: i64) -> i64 ! Error {
    let p = slot_pos(t, slot)?
    if p < 0 {
        return default
    }
    read_i32(t.data, p)?
}

fn get_i16(t: Table, slot: i64, default: i64) -> i64 ! Error {
    let p = slot_pos(t, slot)?
    if p < 0 {
        return default
    }
    read_i16(t.data, p)?
}

fn get_u8(t: Table, slot: i64, default: i64) -> i64 ! Error {
    let p = slot_pos(t, slot)?
    if p < 0 {
        return default
    }
    read_u8(t.data, p)?
}

fn get_bool(t: Table, slot: i64, default: bool) -> bool ! Error {
    let p = slot_pos(t, slot)?
    if p < 0 {
        return default
    }
    read_u8(t.data, p)? != 0
}

fn get_table(t: Table, slot: i64) -> Table? ! Error {
    let p = slot_pos(t, slot)?
    if p < 0 {
        return none
    }
    let offset = read_u32(t.data, p)?
    table_at(t.data, p + offset)?
}

fn get_string(t: Table, slot: i64) -> str? ! Error {
    let p = slot_pos(t, slot)?
    if p < 0 {
        return none
    }
    let at = p + read_u32(t.data, p)?
    let n = read_u32(t.data, at)?
    need(t.data, at + 4, n)?
    let s = str(t.data[at + 4..at + 4 + n])
    if !unicode.utf8_valid(s) {
        fail Invalid(at, "a string is not UTF-8")
    }
    s
}

fn get_vector(t: Table, slot: i64, element: i64) -> Vector ! Error {
    let p = slot_pos(t, slot)?
    if p < 0 {
        return Vector { data: t.data, start: 0, len: 0 }
    }
    let at = p + read_u32(t.data, p)?
    let n = read_u32(t.data, at)?
    need(t.data, at + 4, n * element)?
    Vector { data: t.data, start: at + 4, len: n }
}

fn vector_table(v: Vector, i: i64) -> Table ! Error {
    let at = v.start + 4 * i
    let offset = read_u32(v.data, at)?
    table_at(v.data, at + offset)?
}

struct FbBuilder {
    bytes: u8[]
    slots: i64[]
    object_start: i64
    min_align: i64
}

fn fb_new() -> *FbBuilder {
    new(FbBuilder { bytes: [], slots: [], object_start: 0, min_align: 1 })
}

fn fb_prep(b: *FbBuilder, size: i64, extra: i64) {
    if size > b.min_align {
        b.min_align = size
    }
    let pad = (0 - (b.bytes.len + extra)) & (size - 1)
    for _ in 0..pad {
        b.bytes.push(0)
    }
}

fn fb_put(b: *FbBuilder, v: i64, size: i64) {
    var k = size - 1
    for k >= 0 {
        b.bytes.push(u8((v >> (8 * k)) & 0xFF))
        k -= 1
    }
}

fn fb_prepend(b: *FbBuilder, v: i64, size: i64) {
    fb_prep(b, size, 0)
    fb_put(b, v, size)
}

fn fb_refer(b: *FbBuilder, target: i64) -> i64 {
    fb_prep(b, 4, 0)
    b.bytes.len - target + 4
}

fn fb_string(b: *FbBuilder, s: str) -> i64 {
    fb_prep(b, 4, s.len + 1)
    b.bytes.push(0)
    var i = s.len - 1
    for i >= 0 {
        b.bytes.push(s[i])
        i -= 1
    }
    fb_put(b, s.len, 4)
    b.bytes.len
}

fn fb_start_vector(b: *FbBuilder, element: i64, n: i64, align: i64) {
    fb_prep(b, 4, element * n)
    fb_prep(b, align, element * n)
}

fn fb_end_vector(b: *FbBuilder, n: i64) -> i64 {
    fb_put(b, n, 4)
    b.bytes.len
}

fn fb_offsets(b: *FbBuilder, targets: i64[]) -> i64 {
    fb_start_vector(b, 4, targets.len, 4)
    var i = targets.len - 1
    for i >= 0 {
        let reference = fb_refer(b, targets[i])
        fb_put(b, reference, 4)
        i -= 1
    }
    fb_end_vector(b, targets.len)
}

fn fb_start_table(b: *FbBuilder, slots: i64) {
    b.slots = []
    for _ in 0..slots {
        b.slots.push(0)
    }
    b.object_start = b.bytes.len
}

fn fb_add(b: *FbBuilder, slot: i64, v: i64, default: i64, size: i64) {
    if v == default {
        return
    }
    fb_prepend(b, v, size)
    b.slots[slot] = b.bytes.len
}

fn fb_add_offset(b: *FbBuilder, slot: i64, target: i64) {
    let reference = fb_refer(b, target)
    fb_put(b, reference, 4)
    b.slots[slot] = b.bytes.len
}

fn fb_end_table(b: *FbBuilder) -> i64 {
    fb_prepend(b, 0, 4)
    let object = b.bytes.len
    var last = b.slots.len - 1
    for last >= 0 && b.slots[last] == 0 {
        last -= 1
    }
    var i = last
    for i >= 0 {
        var offset = 0
        if b.slots[i] != 0 {
            offset = object - b.slots[i]
        }
        fb_prepend(b, offset, 2)
        i -= 1
    }
    fb_prepend(b, object - b.object_start, 2)
    fb_prepend(b, (last + 1 + 2) * 2, 2)
    let vtable = b.bytes.len
    let at = object - 1
    let back = vtable - object
    for k in 0..4 {
        b.bytes[at - k] = u8((back >> (8 * k)) & 0xFF)
    }
    object
}

fn fb_finish(b: *FbBuilder, root: i64) -> u8[] {
    fb_prep(b, b.min_align, 4)
    let reference = fb_refer(b, root)
    fb_put(b, reference, 4)
    var out = io.buffer(b.bytes.len)
    for i in 0..b.bytes.len {
        out[i] = b.bytes[b.bytes.len - 1 - i]
    }
    out
}
