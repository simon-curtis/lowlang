const max_nesting: i64 = 64

fn time_unit_of(v: i64) -> TimeUnit ! Error {
    match v {
        == 0 => TimeUnit.Second
        == 1 => TimeUnit.Millisecond
        == 2 => TimeUnit.Microsecond
        == 3 => TimeUnit.Nanosecond
        _ => fail Invalid(-1, "{v} is not a time unit")
    }
}

fn time_unit_id(unit: TimeUnit) -> i64 {
    match unit {
        Second => 0
        Millisecond => 1
        Microsecond => 2
        Nanosecond => 3
    }
}

fn read_metadata(t: Table, slot: i64) -> [str: str] ! Error {
    var out: [str: str] = [:]
    let v = get_vector(t, slot, 4)?
    for i in 0..v.len {
        let entry = vector_table(v, i)?
        let key = get_string(entry, 0)? ?? ""
        out[key] = get_string(entry, 1)? ?? ""
    }
    out
}

fn read_children(t: Table, depth: i64) -> []Field ! Error {
    var out: []Field = []
    let v = get_vector(t, 5, 4)?
    for i in 0..v.len {
        push(mut out, read_field(vector_table(v, i)?, depth + 1)?)
    }
    out
}

fn single_child(children: []Field, what: str) -> *Field ! Error {
    if children.len != 1 {
        fail Invalid(-1, "a {what} has {children.len} children")
    }
    new(children[0])
}

fn read_type(id: i64, t: Table?, children: []Field) -> DataType ! Error {
    let body = t ?? Table { data: [], pos: 0 }
    match id {
        == 1 => DataType.Null
        == 2 => {
            let bits = get_i32(body, 0, 0)?
            if bits != 8 && bits != 16 && bits != 32 && bits != 64 {
                fail Invalid(-1, "an integer has {bits} bits")
            }
            DataType.Int(bits, get_bool(body, 1, false)?)
        }
        == 3 => {
            let precision = get_i16(body, 0, 0)?
            match precision {
                == 0 => DataType.Float(16)
                == 1 => DataType.Float(32)
                == 2 => DataType.Float(64)
                _ => fail Invalid(-1, "{precision} is not a float precision")
            }
        }
        == 4 => DataType.Binary
        == 5 => DataType.Utf8
        == 6 => DataType.Bool
        == 7 => {
            let width = get_i32(body, 2, 128)?
            if width != 128 {
                fail Unsupported("a decimal of {width} bits")
            }
            let precision = get_i32(body, 0, 0)?
            let scale = get_i32(body, 1, 0)?
            if precision < 1 || precision > 38 {
                fail Invalid(-1, "a decimal has precision {precision}")
            }
            DataType.Decimal(precision, scale)
        }
        == 8 => {
            match get_i16(body, 0, 1)? {
                == 0 => DataType.Date(DateUnit.Day)
                == 1 => DataType.Date(DateUnit.Millisecond)
                _ => fail Invalid(-1, "a date has an unknown unit")
            }
        }
        == 9 => {
            let unit = time_unit_of(get_i16(body, 0, 1)?)?
            let width = get_i32(body, 1, 32)?
            if width != time_bits(unit) {
                fail Invalid(-1, "a time of {unit_name(unit)} has {width} bits")
            }
            DataType.Time(unit)
        }
        == 10 => {
            let unit = time_unit_of(get_i16(body, 0, 0)?)?
            DataType.Timestamp(unit, get_string(body, 1)? ?? "")
        }
        == 11 => {
            match get_i16(body, 0, 0)? {
                == 0 => DataType.Interval(IntervalUnit.YearMonth)
                == 1 => DataType.Interval(IntervalUnit.DayTime)
                == 2 => DataType.Interval(IntervalUnit.MonthDayNano)
                _ => fail Invalid(-1, "an interval has an unknown unit")
            }
        }
        == 12 => DataType.List(single_child(children, "list")?)
        == 13 => DataType.Struct(children)
        == 14 => {
            let mode = if get_i16(body, 0, 0)? == 0 { UnionMode.Sparse } else { UnionMode.Dense }
            var ids: []i64 = []
            let v = get_vector(body, 1, 4)?
            for i in 0..v.len {
                push(mut ids, read_i32(v.data, v.start + 4 * i)?)
            }
            if ids.len == 0 {
                for i in 0..children.len {
                    push(mut ids, i)
                }
            }
            if ids.len != children.len {
                fail Invalid(-1, "a union has {ids.len} type ids for {children.len} children")
            }
            DataType.Union(mode, children, ids)
        }
        == 15 => {
            let width = get_i32(body, 0, 0)?
            if width < 0 {
                fail Invalid(-1, "a fixed size binary has width {width}")
            }
            DataType.FixedSizeBinary(width)
        }
        == 16 => {
            let size = get_i32(body, 0, 0)?
            if size < 0 {
                fail Invalid(-1, "a fixed size list has size {size}")
            }
            DataType.FixedSizeList(single_child(children, "fixed size list")?, size)
        }
        == 17 => {
            let entries = single_child(children, "map")?
            match entries.data_type {
                Struct(fields) => {
                    if fields.len != 2 {
                        fail Invalid(-1, "a map entry has {fields.len} fields")
                    }
                }
                _ => fail Invalid(-1, "a map entry is not a struct")
            }
            DataType.Map(entries, get_bool(body, 0, false)?)
        }
        == 18 => DataType.Duration(time_unit_of(get_i16(body, 0, 1)?)?)
        == 19 => DataType.LargeBinary
        == 20 => DataType.LargeUtf8
        == 21 => DataType.LargeList(single_child(children, "large list")?)
        == 22 => fail Unsupported("run-end encoded arrays")
        == 23 => fail Unsupported("binary view arrays")
        == 24 => fail Unsupported("string view arrays")
        == 25 => fail Unsupported("list view arrays")
        == 26 => fail Unsupported("large list view arrays")
        _ => fail Invalid(-1, "{id} is not a type")
    }
}

fn read_index_type(t: Table?) -> DataType ! Error {
    let body = t ?? return DataType.Int(32, true)
    let bits = get_i32(body, 0, 0)?
    if bits != 8 && bits != 16 && bits != 32 && bits != 64 {
        fail Invalid(-1, "a dictionary index has {bits} bits")
    }
    DataType.Int(bits, get_bool(body, 1, false)?)
}

fn read_field(t: Table, depth: i64) -> Field ! Error {
    if depth > max_nesting {
        fail TooLarge("schema nesting")
    }
    let name = get_string(t, 0)? ?? ""
    let nullable = get_bool(t, 1, false)?
    let id = get_u8(t, 2, 0)?
    let body = get_table(t, 3)?
    let children = read_children(t, depth)?
    let value = read_type(id, body, children)?
    var data_type = value
    let encoding = get_table(t, 4)?
    match encoding {
        some(e) => {
            if get_i16(e, 3, 0)? != 0 {
                fail Unsupported("a dictionary of another kind than a dense array")
            }
            let index = read_index_type(get_table(e, 1)?)?
            match index {
                Int(_, _) => {}
                _ => fail Invalid(-1, "a dictionary index is not an integer")
            }
            data_type = DataType.Dictionary(get_i64(e, 0, 0)?, new(index), new(value), get_bool(e, 2, false)?)
        }
        none => {}
    }
    Field { name, data_type, nullable, metadata: read_metadata(t, 6)? }
}

fn read_schema(t: Table) -> Schema ! Error {
    if get_i16(t, 0, 0)? != 0 {
        fail Unsupported("big-endian data")
    }
    var fields: []Field = []
    let v = get_vector(t, 1, 4)?
    for i in 0..v.len {
        push(mut fields, read_field(vector_table(v, i)?, 1)?)
    }
    Schema { fields, metadata: read_metadata(t, 2)? }
}

struct BatchMeta {
    length: i64
    node_lengths: []i64
    node_nulls: []i64
    buffer_offsets: []i64
    buffer_lengths: []i64
    codec: i64
}

fn read_batch_meta(t: Table) -> BatchMeta ! Error {
    var meta = BatchMeta { length: get_i64(t, 0, 0)?, node_lengths: [], node_nulls: [], buffer_offsets: [], buffer_lengths: [], codec: -1 }
    if meta.length < 0 {
        fail Invalid(-1, "a record batch has length {meta.length}")
    }
    let nodes = get_vector(t, 1, 16)?
    for i in 0..nodes.len {
        let at = nodes.start + 16 * i
        push(mut meta.node_lengths, read_i64(nodes.data, at)?)
        push(mut meta.node_nulls, read_i64(nodes.data, at + 8)?)
    }
    let buffers = get_vector(t, 2, 16)?
    for i in 0..buffers.len {
        let at = buffers.start + 16 * i
        push(mut meta.buffer_offsets, read_i64(buffers.data, at)?)
        push(mut meta.buffer_lengths, read_i64(buffers.data, at + 8)?)
    }
    match get_table(t, 3)? {
        some(c) => {
            if get_u8(c, 1, 0)? != 0 {
                fail Unsupported("a body compression method other than BUFFER")
            }
            let codec = get_u8(c, 0, 0)?
            if codec != 0 && codec != 1 {
                fail Unsupported("body compression codec {codec}")
            }
            meta.codec = codec
        }
        none => {}
    }
    meta
}

fn string_pairs(b: *FbBuilder, metadata: [str: str]) -> i64 {
    var entries: []i64 = []
    for key, value in metadata {
        let k = fb_string(b, key)
        let v = fb_string(b, value)
        fb_start_table(b, 2)
        fb_add_offset(b, 0, k)
        fb_add_offset(b, 1, v)
        push(mut entries, fb_end_table(b))
    }
    fb_offsets(b, entries)
}

struct TypeRef {
    id: i64
    offset: i64
}

fn empty_table(b: *FbBuilder) -> i64 {
    fb_start_table(b, 0)
    fb_end_table(b)
}

fn unit_table(b: *FbBuilder, unit: i64, default: i64) -> i64 {
    fb_start_table(b, 1)
    fb_add(b, 0, unit, default, 2)
    fb_end_table(b)
}

/// Returns the fields a schema lists below `t`: the item of a list, the entries of a map, the fields of a struct or union, and, for a dictionary, the children of its value type.
pub fn children_of(t: DataType) -> []Field {
    match t {
        List(item) => [*item]
        LargeList(item) => [*item]
        FixedSizeList(item, _) => [*item]
        Struct(fields) => fields
        Map(entries, _) => [*entries]
        Union(_, fields, _) => fields
        Dictionary(_, _, value, _) => children_of(*value)
        _ => []
    }
}

fn write_type(b: *FbBuilder, t: DataType) -> TypeRef {
    match t {
        Null => TypeRef { id: 1, offset: empty_table(b) }
        Bool => TypeRef { id: 6, offset: empty_table(b) }
        Int(bits, signed) => {
            fb_start_table(b, 2)
            fb_add(b, 0, bits, 0, 4)
            fb_add(b, 1, if signed { 1 } else { 0 }, 0, 1)
            TypeRef { id: 2, offset: fb_end_table(b) }
        }
        Float(bits) => {
            let precision = match bits {
                == 16 => 0
                == 32 => 1
                _ => 2
            }
            TypeRef { id: 3, offset: unit_table(b, precision, 0) }
        }
        Utf8 => TypeRef { id: 5, offset: empty_table(b) }
        LargeUtf8 => TypeRef { id: 20, offset: empty_table(b) }
        Binary => TypeRef { id: 4, offset: empty_table(b) }
        LargeBinary => TypeRef { id: 19, offset: empty_table(b) }
        FixedSizeBinary(width) => {
            fb_start_table(b, 1)
            fb_add(b, 0, width, 0, 4)
            TypeRef { id: 15, offset: fb_end_table(b) }
        }
        Decimal(precision, scale) => {
            fb_start_table(b, 3)
            fb_add(b, 0, precision, 0, 4)
            fb_add(b, 1, scale, 0, 4)
            fb_add(b, 2, 128, 128, 4)
            TypeRef { id: 7, offset: fb_end_table(b) }
        }
        Date(unit) => {
            let day = match unit {
                Day => 0
                Millisecond => 1
            }
            TypeRef { id: 8, offset: unit_table(b, day, 1) }
        }
        Time(unit) => {
            fb_start_table(b, 2)
            fb_add(b, 0, time_unit_id(unit), 1, 2)
            fb_add(b, 1, time_bits(unit), 32, 4)
            TypeRef { id: 9, offset: fb_end_table(b) }
        }
        Timestamp(unit, zone) => {
            var zone_offset = 0
            if zone.len > 0 {
                zone_offset = fb_string(b, zone)
            }
            fb_start_table(b, 2)
            fb_add(b, 0, time_unit_id(unit), 0, 2)
            if zone.len > 0 {
                fb_add_offset(b, 1, zone_offset)
            }
            TypeRef { id: 10, offset: fb_end_table(b) }
        }
        Duration(unit) => TypeRef { id: 18, offset: unit_table(b, time_unit_id(unit), 1) }
        Interval(unit) => {
            let id = match unit {
                YearMonth => 0
                DayTime => 1
                MonthDayNano => 2
            }
            TypeRef { id: 11, offset: unit_table(b, id, 0) }
        }
        List(_) => TypeRef { id: 12, offset: empty_table(b) }
        LargeList(_) => TypeRef { id: 21, offset: empty_table(b) }
        FixedSizeList(_, size) => {
            fb_start_table(b, 1)
            fb_add(b, 0, size, 0, 4)
            TypeRef { id: 16, offset: fb_end_table(b) }
        }
        Struct(_) => TypeRef { id: 13, offset: empty_table(b) }
        Map(_, sorted) => {
            fb_start_table(b, 1)
            fb_add(b, 0, if sorted { 1 } else { 0 }, 0, 1)
            TypeRef { id: 17, offset: fb_end_table(b) }
        }
        Union(mode, _, ids) => {
            fb_start_vector(b, 4, ids.len, 4)
            var i = ids.len - 1
            for i >= 0 {
                fb_prepend(b, ids[i], 4)
                i -= 1
            }
            let vector = fb_end_vector(b, ids.len)
            fb_start_table(b, 2)
            fb_add(b, 0, if mode == UnionMode.Dense { 1 } else { 0 }, 0, 2)
            fb_add_offset(b, 1, vector)
            TypeRef { id: 14, offset: fb_end_table(b) }
        }
        Dictionary(_, _, value, _) => write_type(b, *value)
    }
}

fn write_field(b: *FbBuilder, f: Field) -> i64 {
    let name = fb_string(b, f.name)
    var children: []i64 = []
    for child in children_of(f.data_type) {
        push(mut children, write_field(b, child))
    }
    let child_vector = fb_offsets(b, children)
    let metadata = string_pairs(b, f.metadata)
    var encoding = 0
    match f.data_type {
        Dictionary(id, index, _, ordered) => {
            let index_type = write_type(b, *index)
            fb_start_table(b, 4)
            fb_add(b, 0, id, 0, 8)
            fb_add_offset(b, 1, index_type.offset)
            fb_add(b, 2, if ordered { 1 } else { 0 }, 0, 1)
            encoding = fb_end_table(b)
        }
        _ => {}
    }
    let type_ref = write_type(b, f.data_type)
    fb_start_table(b, 7)
    fb_add_offset(b, 0, name)
    fb_add(b, 1, if f.nullable { 1 } else { 0 }, 0, 1)
    fb_add(b, 2, type_ref.id, 0, 1)
    fb_add_offset(b, 3, type_ref.offset)
    if encoding != 0 {
        fb_add_offset(b, 4, encoding)
    }
    fb_add_offset(b, 5, child_vector)
    if f.metadata.len > 0 {
        fb_add_offset(b, 6, metadata)
    }
    fb_end_table(b)
}

fn write_schema(b: *FbBuilder, s: Schema) -> i64 {
    var fields: []i64 = []
    for f in s.fields {
        push(mut fields, write_field(b, f))
    }
    let vector = fb_offsets(b, fields)
    let metadata = string_pairs(b, s.metadata)
    fb_start_table(b, 4)
    fb_add_offset(b, 1, vector)
    if s.metadata.len > 0 {
        fb_add_offset(b, 2, metadata)
    }
    fb_end_table(b)
}

fn write_message(b: *FbBuilder, header_type: i64, header: i64, body_length: i64) -> []u8 {
    fb_start_table(b, 5)
    fb_add(b, 0, 4, 0, 2)
    fb_add(b, 1, header_type, 0, 1)
    fb_add_offset(b, 2, header)
    fb_add(b, 3, body_length, 0, 8)
    let message = fb_end_table(b)
    fb_finish(b, message)
}

fn write_batch_meta(b: *FbBuilder, meta: BatchMeta) -> i64 {
    fb_start_vector(b, 16, meta.node_lengths.len, 8)
    var i = meta.node_lengths.len - 1
    for i >= 0 {
        fb_prepend(b, meta.node_nulls[i], 8)
        fb_prepend(b, meta.node_lengths[i], 8)
        i -= 1
    }
    let nodes = fb_end_vector(b, meta.node_lengths.len)
    fb_start_vector(b, 16, meta.buffer_offsets.len, 8)
    var j = meta.buffer_offsets.len - 1
    for j >= 0 {
        fb_prepend(b, meta.buffer_lengths[j], 8)
        fb_prepend(b, meta.buffer_offsets[j], 8)
        j -= 1
    }
    let buffers = fb_end_vector(b, meta.buffer_offsets.len)
    var compression = 0
    if meta.codec >= 0 {
        fb_start_table(b, 2)
        fb_add(b, 0, meta.codec, 0, 1)
        compression = fb_end_table(b)
    }
    fb_start_table(b, 5)
    fb_add(b, 0, meta.length, 0, 8)
    fb_add_offset(b, 1, nodes)
    fb_add_offset(b, 2, buffers)
    if meta.codec >= 0 {
        fb_add_offset(b, 3, compression)
    }
    fb_end_table(b)
}

struct Block {
    offset: i64
    metadata_length: i64
    body_length: i64
}

fn write_blocks(b: *FbBuilder, blocks: []Block) -> i64 {
    fb_start_vector(b, 24, blocks.len, 8)
    var i = blocks.len - 1
    for i >= 0 {
        fb_prepend(b, blocks[i].body_length, 8)
        fb_prepend(b, 0, 4)
        fb_prepend(b, blocks[i].metadata_length, 4)
        fb_prepend(b, blocks[i].offset, 8)
        i -= 1
    }
    fb_end_vector(b, blocks.len)
}

fn read_blocks(t: Table, slot: i64) -> []Block ! Error {
    var out: []Block = []
    let v = get_vector(t, slot, 24)?
    for i in 0..v.len {
        let at = v.start + 24 * i
        push(mut out, Block { offset: read_i64(v.data, at)?, metadata_length: read_i32(v.data, at + 8)?, body_length: read_i64(v.data, at + 16)? })
    }
    out
}

fn write_footer(s: Schema, dictionaries: []Block, batches: []Block) -> []u8 {
    let b = fb_new()
    let schema = write_schema(b, s)
    let dictionary_blocks = write_blocks(b, dictionaries)
    let batch_blocks = write_blocks(b, batches)
    fb_start_table(b, 5)
    fb_add(b, 0, 4, 0, 2)
    fb_add_offset(b, 1, schema)
    fb_add_offset(b, 2, dictionary_blocks)
    fb_add_offset(b, 3, batch_blocks)
    let footer = fb_end_table(b)
    fb_finish(b, footer)
}

fn write_dictionary_header(b: *FbBuilder, id: i64, batch: i64, delta: bool) -> i64 {
    fb_start_table(b, 3)
    fb_add(b, 0, id, 0, 8)
    fb_add_offset(b, 1, batch)
    fb_add(b, 2, if delta { 1 } else { 0 }, 0, 1)
    fb_end_table(b)
}
