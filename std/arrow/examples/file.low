import std/arrow
import std/io

fn schema() -> arrow.Schema {
    let kind = arrow.DataType.Dictionary(0, new(arrow.DataType.Int(8, true)), new(arrow.DataType.Utf8), false)
    arrow.Schema { fields: [
        arrow.Field { name: "kind", data_type: kind },
        arrow.Field { name: "price", data_type: arrow.DataType.Decimal(10, 2) },
    ], metadata: ["source": "example"] }
}

fn batch(rows: [][]str) -> arrow.Batch ! arrow.Error {
    let s = schema()
    let kinds = arrow.builder(s.fields[0].data_type)?
    let prices = arrow.builder(s.fields[1].data_type)?
    for row in rows {
        arrow.append_str(kinds, row[0])?
        arrow.append_decimal(prices, row[1])?
    }
    arrow.Batch { schema: s, length: rows.len, columns: [arrow.finish(kinds)?, arrow.finish(prices)?] }
}

fn run() ! arrow.Error {
    var bytes: []u8 = []
    let sink: fn([]u8) ! io.Error = fn(chunk) { io.append(mut bytes, chunk) }
    let w = arrow.file_writer(sink, schema(), arrow.WriterOptions { alignment: 64 })?
    arrow.write_batch(w, batch([["apple", "1.25"], ["pear", "0.80"], ["apple", "1.30"]])?)?
    arrow.write_batch(w, batch([["apple", "1.25"], ["pear", "2.00"], ["pear", "0.75"]])?)?
    arrow.close(w)?
    print("written counts every byte: {bytes.len == arrow.written(w)}")

    let f = arrow.open_file_bytes(bytes, arrow.ReaderOptions {})?
    print("{arrow.batch_count(f)} batches, source {arrow.file_schema(f).metadata["source"] ?? "?"}")
    let second = arrow.read_batch(f, 1)?
    for c in second.columns {
        print(arrow.diagnostic(c))
    }
}

fn main() {
    run() catch {
        e => print(arrow.message(e))
    }
}
