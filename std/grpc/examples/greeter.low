import std/grpc
import std/net

struct HelloRequest {
    name: str "1"
}

struct HelloReply {
    message: str "1"
}

fn say_hello(ctx: *grpc.Context, req: HelloRequest) -> HelloReply ! grpc.Error {
    if req.name == "" {
        fail grpc.error(InvalidArgument, "name is empty")
    }
    let lang = grpc.get(ctx.metadata, "x-lang") ?? "en"
    grpc.add(mut ctx.response_headers, "x-served-by", "greeter") or {}
    if lang == "fr" {
        return HelloReply { message: "Bonjour {req.name}" }
    }
    HelloReply { message: "Hello {req.name}" }
}

fn count_to(ctx: *grpc.Context, req: HelloRequest) ! grpc.Error {
    for i in 1..4 {
        grpc.write[HelloReply](ctx, HelloReply { message: "{req.name} {i}" })?
    }
}

fn serve(s: *grpc.Server, l: net.ListenerHandle) {
    grpc.serve_on(s, l) or {}
}

fn greet(ch: grpc.Channel, name: str, lang: str) {
    var metadata = grpc.Metadata {}
    grpc.add(mut metadata, "x-lang", lang) or {}
    let opts = grpc.CallOptions { timeout: 2000, metadata }
    let reply = grpc.unary[HelloRequest, HelloReply](ch, "/helloworld.Greeter/SayHello", HelloRequest { name }, opts) catch {
        e => {
            print("SayHello failed: {grpc.describe(e)}")
            return
        }
    }
    print("{reply.value.message} (served by {grpc.get(reply.headers, "x-served-by") ?? "?"})")
}

fn count(ch: grpc.Channel) {
    let stream = grpc.server_streaming[HelloRequest](ch, "/helloworld.Greeter/CountTo", HelloRequest { name: "step" }, grpc.CallOptions {}) catch {
        e => {
            print("CountTo failed: {grpc.describe(e)}")
            return
        }
    }
    defer grpc.close_stream(stream)
    for {
        let next = grpc.receive[HelloReply](stream) catch {
            e => {
                print("CountTo failed: {grpc.describe(e)}")
                return
            }
        }
        match next {
            some(reply) => print(reply.message)
            none => break
        }
    }
}

fn main() {
    using l = net.listen("127.0.0.1", 0) or {
        print("listen failed")
        return
    }
    let server = grpc.server(grpc.ServerOptions {})
    grpc.handle_unary[HelloRequest, HelloReply](server, "/helloworld.Greeter/SayHello", say_hello)
    grpc.handle_server_streaming[HelloRequest](server, "/helloworld.Greeter/CountTo", count_to)
    spawn serve(server, l.handle)
    let ch = grpc.dial("127.0.0.1:{l.handle.addr.port}", grpc.ChannelOptions {}) or {
        print("dial failed")
        return
    }
    greet(ch, "Ada", "en")
    greet(ch, "Zoé", "fr")
    greet(ch, "", "en")
    count(ch)
    grpc.close_channel(ch)
    grpc.shutdown(server, 0)
}
