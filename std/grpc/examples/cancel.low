import std/cancel
import std/grpc
import std/net

struct Tick {
    n: i64 "1"
}

fn ticks(stopped: chan[str], ctx: *grpc.Context, req: Tick) ! grpc.Error {
    for i in 0..1000000 {
        grpc.write[Tick](ctx, Tick { n: i }) catch {
            e => {
                stopped <- "handler stopped: {grpc.code_name(grpc.status_of(e).code)}"
                fail e
            }
        }
        if !cancel.pause(ctx.token, 5) {
            stopped <- "handler stopped: CANCELLED"
            fail grpc.error(Cancelled, "stopped")
        }
    }
}

fn serve(s: *grpc.Server, l: net.ListenerHandle) {
    grpc.serve_on(s, l) or {}
}

fn watch(ch: grpc.Channel, stopped: chan[str]) {
    let stream = grpc.server_streaming[Tick](ch, "/clock.Clock/Ticks", Tick { n: 0 }, grpc.CallOptions {}) catch {
        e => {
            print("Ticks failed: {grpc.describe(e)}")
            return
        }
    }
    defer grpc.close_stream(stream)
    for _ in 0..3 {
        let tick = grpc.receive[Tick](stream) catch {
            e => {
                print("Ticks failed: {grpc.describe(e)}")
                return
            }
        }
        match tick {
            some(t) => print("tick {t.n}")
            none => return
        }
    }
    grpc.cancel_stream(stream)
    let late = grpc.receive[Tick](stream) catch {
        e => {
            print("after cancel: {grpc.describe(e)}")
            print((<-stopped) ?? "handler still running")
            return
        }
    }
    print("after cancel: another message")
}

fn main() {
    using l = net.listen("127.0.0.1", 0) or {
        print("listen failed")
        return
    }
    let stopped = chan[str](1)
    let server = grpc.server(grpc.ServerOptions {})
    grpc.handle_server_streaming[Tick](server, "/clock.Clock/Ticks", fn(ctx: *grpc.Context, req: Tick) ! grpc.Error { ticks(stopped, ctx, req)? })
    spawn serve(server, l.handle)
    let ch = grpc.dial("127.0.0.1:{l.handle.addr.port}", grpc.ChannelOptions {}) or {
        print("dial failed")
        return
    }
    watch(ch, stopped)
    grpc.close_channel(ch)
    grpc.shutdown(server, 0)
}
