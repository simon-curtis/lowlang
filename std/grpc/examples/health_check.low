import std/grpc
import std/net

fn serve(s: *grpc.Server, l: net.ListenerHandle) {
    grpc.serve_on(s, l) or {}
}

fn ask(ch: grpc.Channel, service: str) {
    let status = grpc.check_health(ch, service, grpc.CallOptions { timeout: 1000 }) catch {
        e => {
            print("'{service}': {grpc.describe(e)}")
            return
        }
    }
    print("'{service}': {status}")
}

fn main() {
    using l = net.listen("127.0.0.1", 0) or {
        print("listen failed")
        return
    }
    let health = grpc.health()
    let server = grpc.server(grpc.ServerOptions {})
    grpc.register_health(server, health)
    spawn serve(server, l.handle)
    let ch = grpc.dial("127.0.0.1:{l.handle.addr.port}", grpc.ChannelOptions {}) or {
        print("dial failed")
        return
    }
    ask(ch, "")
    ask(ch, "db")
    grpc.set_health(health, "db", grpc.ServingStatus.NotServing)
    ask(ch, "db")
    grpc.set_all_not_serving(health)
    ask(ch, "")
    grpc.close_channel(ch)
    grpc.shutdown(server, 0)
}
