/// A canonical gRPC status code.
pub enum Code {
    /// The call succeeded.
    Ok = 0
    /// The call was cancelled, usually by the caller.
    Cancelled = 1
    /// An error that fits no other code, including a status code this package does not know.
    Unknown = 2
    /// The caller sent an argument that is invalid whatever the state of the system.
    InvalidArgument = 3
    /// The deadline passed before the call finished.
    DeadlineExceeded = 4
    /// A requested entity was not found.
    NotFound = 5
    /// An entity the caller tried to create exists already.
    AlreadyExists = 6
    /// The caller is known but may not do this.
    PermissionDenied = 7
    /// A resource, such as a quota, a message size limit or a stream limit, is exhausted.
    ResourceExhausted = 8
    /// The system is not in a state the call needs.
    FailedPrecondition = 9
    /// The call was aborted, typically by a concurrency conflict.
    Aborted = 10
    /// The call went past a valid range.
    OutOfRange = 11
    /// The method is not implemented or not enabled.
    Unimplemented = 12
    /// An invariant of the system is broken.
    Internal = 13
    /// The service is unavailable, which a retry with backoff may cure.
    Unavailable = 14
    /// Data was lost or corrupted.
    DataLoss = 15
    /// The caller has no valid credentials.
    Unauthenticated = 16
}

/// The outcome of a call: a code, a message for people and the details of `grpc-status-details-bin`.
///
/// A call that fails returns its `Status` inside `Error`.
pub struct Status {
    /// The status code.
    pub code: Code
    /// A message for people, as sent in `grpc-message`.
    pub message: str = ""
    /// The binary `google.rpc.Status` message of the `grpc-status-details-bin` trailer, or empty when there is none. On the server it is sent as given.
    pub details: []u8 = []
    /// The trailing metadata that came with the status on the client, and that a server handler adds to its trailers by failing with it.
    pub trailers: Metadata = Metadata {}
}

/// The error type of calls and handlers: a failed call with its `Status`.
pub enum Error {
    /// The call ended with a status other than `Ok`.
    Failed(status: Status)
}

/// Returns the code for the number `n`, or `Unknown` when `n` is not one of the 17 codes.
pub fn code_of(n: i64) -> Code {
    match n {
        0 => Ok
        1 => Cancelled
        3 => InvalidArgument
        4 => DeadlineExceeded
        5 => NotFound
        6 => AlreadyExists
        7 => PermissionDenied
        8 => ResourceExhausted
        9 => FailedPrecondition
        10 => Aborted
        11 => OutOfRange
        12 => Unimplemented
        13 => Internal
        14 => Unavailable
        15 => DataLoss
        16 => Unauthenticated
        _ => Unknown
    }
}

/// Returns the name of `c` as the gRPC documentation writes it, such as `NOT_FOUND`.
pub fn code_name(c: Code) -> str {
    match c {
        Ok => "OK"
        Cancelled => "CANCELLED"
        Unknown => "UNKNOWN"
        InvalidArgument => "INVALID_ARGUMENT"
        DeadlineExceeded => "DEADLINE_EXCEEDED"
        NotFound => "NOT_FOUND"
        AlreadyExists => "ALREADY_EXISTS"
        PermissionDenied => "PERMISSION_DENIED"
        ResourceExhausted => "RESOURCE_EXHAUSTED"
        FailedPrecondition => "FAILED_PRECONDITION"
        Aborted => "ABORTED"
        OutOfRange => "OUT_OF_RANGE"
        Unimplemented => "UNIMPLEMENTED"
        Internal => "INTERNAL"
        Unavailable => "UNAVAILABLE"
        DataLoss => "DATA_LOSS"
        Unauthenticated => "UNAUTHENTICATED"
    }
}

/// Returns a `Status` with `code` and `message` and no details or trailers.
pub fn status(code: Code, message: str) -> Status {
    Status { code, message }
}

/// Returns the error of a call that ends with `code` and `message`.
pub fn error(code: Code, message: str) -> Error {
    Failed(Status { code, message })
}

/// Returns the status inside `e`.
pub fn status_of(e: Error) -> Status {
    match e {
        Failed(s) => s
    }
}

/// Returns `e` as `CODE: message`, or just `CODE` when the message is empty.
pub fn describe(e: Error) -> str {
    let s = status_of(e)
    if s.message.len == 0 {
        return code_name(s.code)
    }
    "{code_name(s.code)}: {s.message}"
}

fn hex_digit(n: i64) -> u8 {
    if n < 10 { u8(48 + n) } else { u8(55 + n) }
}

fn hex_value(c: u8) -> i64 {
    if c >= '0' && c <= '9' {
        return i64(c) - 48
    }
    if c >= 'A' && c <= 'F' {
        return i64(c) - 55
    }
    if c >= 'a' && c <= 'f' {
        return i64(c) - 87
    }
    -1
}

/// Percent-encodes `message` for the `grpc-message` header: printable ASCII other than `%` stays and every other byte becomes `%` and two uppercase hexadecimal digits.
pub fn encode_message(message: str) -> str {
    var out: []u8 = []
    for i in 0..message.len {
        let c = message[i]
        if c >= 0x20 && c <= 0x7E && c != '%' {
            push(mut out, c)
        } else {
            push(mut out, '%')
            push(mut out, hex_digit(i64(c) >> 4))
            push(mut out, hex_digit(i64(c) & 15))
        }
    }
    str(out)
}

/// Decodes the percent-encoding of a `grpc-message` header. A `%` that is not followed by two hexadecimal digits stays as it is.
pub fn decode_message(encoded: str) -> str {
    var out: []u8 = []
    var i = 0
    for i < encoded.len {
        let c = encoded[i]
        if c == '%' && i + 2 < encoded.len && hex_value(encoded[i + 1]) >= 0 && hex_value(encoded[i + 2]) >= 0 {
            push(mut out, u8(hex_value(encoded[i + 1]) * 16 + hex_value(encoded[i + 2])))
            i += 3
        } else {
            push(mut out, c)
            i += 1
        }
    }
    str(out)
}

/// Returns the code a client reports for an HTTP response status when the response has no `grpc-status`: `INTERNAL` for 400, `UNAUTHENTICATED` for 401, `PERMISSION_DENIED` for 403, `UNIMPLEMENTED` for 404, `UNAVAILABLE` for 429, 502, 503 and 504, and `UNKNOWN` for everything else, 200 included.
pub fn code_of_http(status: i64) -> Code {
    match status {
        400 => Internal
        401 => Unauthenticated
        403 => PermissionDenied
        404 => Unimplemented
        429 => Unavailable
        502 => Unavailable
        503 => Unavailable
        504 => Unavailable
        _ => Unknown
    }
}

/// Returns the status of a stream the peer reset with the HTTP/2 error `code`: `INTERNAL` for `NO_ERROR`, `PROTOCOL_ERROR`, `INTERNAL_ERROR`, `FLOW_CONTROL_ERROR`, `SETTINGS_TIMEOUT`, `FRAME_SIZE_ERROR`, `COMPRESSION_ERROR`, `CONNECT_ERROR` and any code that is not defined, `UNAVAILABLE` for `REFUSED_STREAM`, `CANCELLED` for `CANCEL`, `RESOURCE_EXHAUSTED` for `ENHANCE_YOUR_CALM` and `PERMISSION_DENIED` for `INADEQUATE_SECURITY`.
pub fn status_of_reset(code: i64) -> Status {
    let text = "stream reset by peer with HTTP/2 error {code}"
    match code {
        7 => Status { code: Unavailable, message: text }
        8 => Status { code: Cancelled, message: text }
        11 => Status { code: ResourceExhausted, message: text }
        12 => Status { code: PermissionDenied, message: text }
        _ => Status { code: Internal, message: text }
    }
}
