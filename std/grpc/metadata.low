import std/base64
import std/header
import std/text

/// One metadata value under a key. Binary values, under keys that end in `-bin`, are arbitrary bytes; the others are printable ASCII.
pub struct Entry {
    /// The lowercase key.
    pub key: str
    /// The value as bytes.
    pub value: u8[]
}

/// Key-value metadata of a call, sent in request headers, response headers or trailers.
///
/// A key may hold several values, which keep the order they were added in. Keys are lowercase letters, digits, `-`, `_` and `.`. A key that ends in `-bin` holds binary values, sent base64-encoded. Names that gRPC or HTTP/2 own, `grpc-` names, pseudo-headers and the headers the protocol sets, are rejected. Build it with `add`, `add_bin` and `set`.
pub struct Metadata {
    /// The entries in the order they were added.
    pub entries: Entry[] = []
}

/// Why a key or value cannot be metadata.
pub enum MetadataError {
    /// The key is empty or has a character other than a lowercase letter, a digit, `-`, `_` and `.`.
    InvalidKey(key: str)
    /// An ASCII value has a byte outside `0x20` to `0x7E`, or leading or trailing space.
    InvalidValue(key: str)
    /// The key is one the protocol sets itself: it starts with `grpc-` or `:`, or it is `content-type`, `te`, `content-length`, `host`, `connection`, `keep-alive`, `transfer-encoding`, `upgrade` or `proxy-connection`.
    ReservedKey(key: str)
    /// An ASCII key was given with `add_bin`, or a `-bin` key with `add`.
    WrongKind(key: str)
}

fn is_bin(key: str) -> bool {
    text.ends_with(key, "-bin")
}

fn key_valid(key: str) -> bool {
    if key.len == 0 {
        return false
    }
    for i in 0..key.len {
        let c = key[i]
        let ok = c >= 'a' && c <= 'z' || c >= '0' && c <= '9' || c == '-' || c == '_' || c == '.'
        if !ok {
            return false
        }
    }
    true
}

fn protocol_name(key: str) -> bool {
    match key {
        == "content-type" => true
        == "te" => true
        == "content-length" => true
        == "host" => true
        == "connection" => true
        == "keep-alive" => true
        == "transfer-encoding" => true
        == "upgrade" => true
        == "proxy-connection" => true
        _ => false
    }
}

fn reserved(key: str) -> bool {
    text.starts_with(key, "grpc-") || protocol_name(key)
}

fn ascii_valid(value: str) -> bool {
    if value.len > 0 && (value[0] == ' ' || value[value.len - 1] == ' ') {
        return false
    }
    for i in 0..value.len {
        if value[i] < 0x20 || value[i] > 0x7E {
            return false
        }
    }
    true
}

fn checked_key(key: str) -> str ! MetadataError {
    let name = text.lower(key)
    if name.len > 0 && name[0] == ':' || reserved(name) {
        fail ReservedKey(name)
    }
    if !key_valid(name) {
        fail InvalidKey(name)
    }
    name
}

/// Adds the ASCII `value` under `key` after any values the key has. `key` is lowercased.
///
/// Fails with `ReservedKey`, `InvalidKey`, `InvalidValue` and `WrongKind` for a key that ends in `-bin`.
pub fn add(mut m: Metadata, key: str, value: str) ! MetadataError {
    let name = checked_key(key)?
    if is_bin(name) {
        fail WrongKind(name)
    }
    if !ascii_valid(value) {
        fail InvalidValue(name)
    }
    m.entries.push(Entry { key: name, value: bytes(value) })
}

/// Adds the binary `value` under `key`, which must end in `-bin`, after any values the key has.
///
/// Fails with `ReservedKey`, `InvalidKey` and `WrongKind` for a key that does not end in `-bin`.
pub fn add_bin(mut m: Metadata, key: str, value: u8[]) ! MetadataError {
    let name = checked_key(key)?
    if !is_bin(name) {
        fail WrongKind(name)
    }
    m.entries.push(Entry { key: name, value })
}

/// Replaces every value of `key` with the ASCII `value`. Fails as `add` does.
pub fn set(mut m: Metadata, key: str, value: str) ! MetadataError {
    let name = checked_key(key)?
    remove(mut m, name)
    add(mut m, name, value)?
}

/// Removes every value of `key`, ignoring case.
pub fn remove(mut m: Metadata, key: str) {
    let name = text.lower(key)
    var kept: Entry[] = []
    for e in m.entries {
        if e.key != name {
            kept.push(e)
        }
    }
    m.entries = kept
}

/// Returns the first value of `key` as text, or `none` when there is none. The key is lowercased first.
pub fn get(m: Metadata, key: str) -> str? {
    let name = text.lower(key)
    for e in m.entries {
        if e.key == name {
            return str(e.value)
        }
    }
    none
}

/// Returns every value of `key` as text, in order.
pub fn values(m: Metadata, key: str) -> str[] {
    let name = text.lower(key)
    var out: str[] = []
    for e in m.entries {
        if e.key == name {
            out.push(str(e.value))
        }
    }
    out
}

/// Returns every value of `key` as bytes, in order. For a key that ends in `-bin` they are the decoded values.
pub fn values_bin(m: Metadata, key: str) -> u8[][] {
    let name = text.lower(key)
    var out: u8[][] = []
    for e in m.entries {
        if e.key == name {
            out.push(e.value)
        }
    }
    out
}

/// Returns the first value of `key` as bytes, or `none` when there is none.
pub fn get_bin(m: Metadata, key: str) -> u8[]? {
    let all = values_bin(m, key)
    if all.len == 0 {
        return none
    }
    all[0]
}

/// Returns the distinct keys of `m` in the order they first appear.
pub fn keys(m: Metadata) -> str[] {
    var out: str[] = []
    var seen: [str: bool] = [:]
    for e in m.entries {
        if !(seen[e.key] ?? false) {
            seen[e.key] = true
            out.push(e.key)
        }
    }
    out
}

/// Returns the number of values in `m`.
pub fn count(m: Metadata) -> i64 {
    m.entries.len
}

/// Returns `m` followed by `other`.
pub fn merge(m: Metadata, other: Metadata) -> Metadata {
    var out: Entry[] = []
    for e in m.entries {
        out.push(e)
    }
    for e in other.entries {
        out.push(e)
    }
    Metadata { entries: out }
}

/// Returns the header fields that carry `m`: lowercase names, binary values base64-encoded without padding.
pub fn to_headers(m: Metadata) -> header.Header[] {
    var out: header.Header[] = []
    for e in m.entries {
        let value = if is_bin(e.key) { base64.encode_unpadded(e.value) } else { str(e.value) }
        out.push(header.Header { name: e.key, value })
    }
    out
}

fn skipped(name: str) -> bool {
    name.len == 0 || name[0] == ':' || text.starts_with(name, "grpc-") || protocol_name(name)
}

/// Returns the metadata in `headers`: every field except pseudo-headers, `grpc-` fields and the ones the protocol sets. A `-bin` value is split at commas and decoded from padded or unpadded base64, and a value that does not decode is dropped; other values are kept as received.
pub fn from_headers(headers: header.Header[]) -> Metadata {
    var out: Entry[] = []
    for h in headers {
        let name = text.lower(h.name)
        if skipped(name) || !key_valid(name) {
            continue
        }
        if !is_bin(name) {
            out.push(Entry { key: name, value: bytes(h.value) })
            continue
        }
        for part in text.split(h.value, ',') {
            let encoded = text.trim(part)
            let decoded = base64.decode_with(encoded, base64.standard, base64.Padding.Optional) or continue
            out.push(Entry { key: name, value: decoded })
        }
    }
    Metadata { entries: out }
}
