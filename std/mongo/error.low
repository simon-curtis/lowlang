import std/bson
import std/io

/// What a MongoDB call can fail with.
pub enum Error {
    /// A server could not be reached, or the TLS handshake with it failed.
    Connect
    /// The server rejected the credentials, or the authentication exchange was not completed.
    Authentication
    /// The client, or the connection it needed, is closed.
    Closed
    /// A call or a connection exceeded its time limit.
    Timeout
    /// The server sent data that is not valid wire protocol or a reply the driver cannot read.
    Protocol
    /// The server needs a feature the driver lacks, such as an authentication mechanism, or the driver needs a feature the server lacks.
    Unsupported
    /// An argument, a connection string or a document is not acceptable, before anything is sent. `message` says what.
    Invalid(message: str)
    /// No server in the topology matched the operation within `Options.server_selection_timeout`.
    Selection
    /// The server answered a command with `ok: 0`. `code` is the error code, `name` its `codeName`, `message` the `errmsg` and `labels` the `errorLabels`, such as `RetryableWriteError` or `TransientTransactionError`.
    Server(code: i64, name: str, message: str, labels: str[])
    /// A write in a batch failed. `index` is the position of the document or operation in the batch, `code` the error code (`11000` for a duplicate key) and `message` the server's text.
    Write(index: i64, code: i64, message: str)
    /// The writes were applied but the write concern was not satisfied.
    WriteConcern(code: i64, message: str)
}

/// Returns the error labels of `e`, empty unless it is `Server`.
pub fn labels(e: Error) -> str[] {
    match e {
        Server(_, _, _, l) => l
        _ => []
    }
}

/// Returns whether `e` carries the error label `label`.
pub fn has_label(e: Error, label: str) -> bool {
    for l in labels(e) {
        if l == label {
            return true
        }
    }
    false
}

fn invalid(e: bson.Error) -> Error {
    Error.Invalid(bson.message(e))
}

fn transport(e: io.Error) -> Error {
    match e {
        TimedOut => Error.Timeout
        Eof => Error.Closed
        NotConnected => Error.Closed
        BrokenPipe => Error.Closed
        Reset => Error.Closed
        Aborted => Error.Closed
        Malformed => Error.Protocol
        TooLarge => Error.Protocol
        _ => Error.Connect
    }
}
