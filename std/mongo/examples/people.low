import std/bson
import std/io
import std/mongo
import std/net

fn person(id: i64, name: str, age: i64) -> []bson.Field {
    [mongo.int_of("_id", id), mongo.text_of("name", name), mongo.int_of("age", age)]
}

fn hello_reply() -> []bson.Field {
    [
        mongo.bool_of("isWritablePrimary", true)
        mongo.int_of("maxBsonObjectSize", 16777216)
        mongo.int_of("maxMessageSizeBytes", 48000000)
        mongo.int_of("maxWriteBatchSize", 100000)
        mongo.int_of("minWireVersion", 0)
        mongo.int_of("maxWireVersion", 21)
        mongo.int_of("logicalSessionTimeoutMinutes", 30)
        mongo.double_of("ok", 1.0)
    ]
}

fn find_reply() -> []bson.Field {
    let batch = [bson.Value.Document(person(1, "Ada", 36)), bson.Value.Document(person(2, "Alan", 41))]
    let cursor = [mongo.array_of("firstBatch", batch), mongo.long_of("id", 0), mongo.text_of("ns", "shop.people")]
    [mongo.document_of("cursor", cursor), mongo.double_of("ok", 1.0)]
}

fn reply_to(command: str) -> []bson.Field {
    match command {
        "hello" => hello_reply()
        "insert" => [mongo.int_of("n", 2), mongo.double_of("ok", 1.0)]
        "find" => find_reply()
        _ => [mongo.double_of("ok", 1.0)]
    }
}

fn frame(to: i64, body: []bson.Field) -> []u8 {
    let encoded = bson.encode(body) or []
    var b: []u8 = []
    io.put_le32(mut b, 21 + encoded.len)
    io.put_le32(mut b, to + 100)
    io.put_le32(mut b, to)
    io.put_le32(mut b, 2013)
    io.put_le32(mut b, 0)
    push(mut b, 0)
    io.append(mut b, encoded)
    b
}

fn accept_all(h: net.ListenerHandle) {
    for {
        let accepted = net.accept_handle(h) or return
        spawn serve(accepted)
    }
}

fn serve(accepted: net.ConnHandle) {
    using conn = net.adopt(accepted)
    let r = io.reader(net.stream(conn))
    for {
        let head = io.read_exact(r, 16) or return
        let rest = io.read_exact(r, io.le32(head, 0) - 16) or return
        let size = io.le32(rest, 5)
        let command = bson.decode(rest[5..5 + size]) or return
        net.write_all(conn, frame(io.le32(head, 4), reply_to(command[0].name))) or return
    }
}

fn run() ! mongo.Error {
    using l = net.listen("127.0.0.1", 0) catch {
        _ => fail Connect
    }
    spawn accept_all(l.handle)
    using client = mongo.connect("mongodb://127.0.0.1:{l.handle.addr.port}/shop?directConnection=true")?
    let people = mongo.collection(mongo.database(client, "shop"), "people")
    let inserted = mongo.insert_many(people, [person(1, "Ada", 36), person(2, "Alan", 41)], mongo.InsertOptions {})?
    print("inserted {inserted.inserted_ids.len}")
    let cursor = mongo.find(people, [mongo.document_of("age", [mongo.int_of("$gte", 18)])], mongo.FindOptions { sort: [mongo.int_of("age", 1)] })?
    for d in mongo.all(cursor)? {
        print(bson.diagnostic(d))
    }
}

/// Connects to a server that runs in the same program, as a MongoDB client would reach a real one, inserts two documents and reads them back. The server answers the handshake, the insert and the find from the wire format directly, on one connection for commands and one for monitoring.
fn main() {
    run() catch {
        e => print("failed: {e}")
    }
}
