import std/testing

fn uri_outcome(connection: str) -> str {
    options_from(connection) catch {
        Invalid(message) => return "invalid {message}"
        Unsupported => return "unsupported"
        _ => return "other"
    }
    "ok"
}

fn parsed(connection: str) -> Options {
    options_from(connection) catch {
        _ => Options {}
    }
}

fn tls_verifies(o: Options) -> str {
    match o.tls {
        some(config) => "{config.verify}"
        none => "off"
    }
}

fn test_hosts_and_defaults(t: *testing.T) {
    let o = parsed("mongodb://a:1,b/db")
    t.equal(o.hosts.len, 2)
    t.equal(o.hosts[0], "a:1")
    t.equal(o.hosts[1], "b:27017")
    t.equal(o.database, "db")
    t.equal(o.username, "")
    t.equal(o.heartbeat, 10000)
    t.equal(o.max_pool_size, 100)
    t.equal(o.retry_reads, true)
    t.equal(o.retry_writes, true)
    t.equal(mode_name(o.read_preference.mode), "primary")
    t.equal(tls_verifies(o), "off")
}

fn test_no_path_and_ipv6(t: *testing.T) {
    let o = parsed("mongodb://[::1]:27018,[fe80::1]")
    t.equal(o.hosts.len, 2)
    t.equal(o.hosts[0], "[::1]:27018")
    t.equal(o.hosts[1], "[fe80::1]:27017")
    t.equal(o.database, "")
}

fn test_credentials(t: *testing.T) {
    let o = parsed("mongodb://us%40er:p%3Aw%2Fd%40@h/admin")
    t.equal(o.username, "us@er")
    t.equal(o.password, "p:w/d@")
    t.equal(o.hosts[0], "h:27017")
    let bare = parsed("mongodb://root@h")
    t.equal(bare.username, "root")
    t.equal(bare.password, "")
}

fn test_options(t: *testing.T) {
    let o = parsed("mongodb://h/?replicaSet=rs0&READPREFERENCE=secondaryPreferred&readPreferenceTags=dc:east,use:reporting&readPreferenceTags=dc:west&readPreferenceTags=&maxStalenessSeconds=120&w=majority&journal=true&wtimeoutMS=500&compressors=zstd,zlib&appName=app&authSource=other&authMechanism=SCRAM-SHA-1&directConnection=true&connectTimeoutMS=1&socketTimeoutMS=2&serverSelectionTimeoutMS=3&heartbeatFrequencyMS=4&localThresholdMS=5&maxPoolSize=6&maxIdleTimeMS=7&waitQueueTimeoutMS=8&zlibCompressionLevel=9&readConcernLevel=majority&retryReads=false&retryWrites=false")
    t.equal(o.replica_set, "rs0")
    t.equal(mode_name(o.read_preference.mode), "secondaryPreferred")
    t.equal(o.read_preference.tag_sets.len, 3)
    t.equal(o.read_preference.tag_sets[0].len, 2)
    t.equal(o.read_preference.tag_sets[0][1].name, "use")
    t.equal(o.read_preference.tag_sets[0][1].value, "reporting")
    t.equal(o.read_preference.tag_sets[1][0].value, "west")
    t.equal(o.read_preference.tag_sets[2].len, 0)
    t.equal(o.read_preference.max_staleness, 120)
    t.equal(o.write_concern.w, "majority")
    t.equal(o.write_concern.journal, some(true))
    t.equal(o.write_concern.timeout, 500)
    t.equal(o.compressors.len, 2)
    t.equal(o.compressors[0], "zstd")
    t.equal(o.compressors[1], "zlib")
    t.equal(o.app_name, "app")
    t.equal(o.auth_source, "other")
    t.equal(o.auth_mechanism, "SCRAM-SHA-1")
    t.equal(o.direct, true)
    t.equal(o.connect_timeout, 1)
    t.equal(o.socket_timeout, 2)
    t.equal(o.server_selection_timeout, 3)
    t.equal(o.heartbeat, 4)
    t.equal(o.local_threshold, 5)
    t.equal(o.max_pool_size, 6)
    t.equal(o.max_idle_time, 7)
    t.equal(o.wait_queue_timeout, 8)
    t.equal(o.compression_level, 9)
    t.equal(o.read_concern, "majority")
    t.equal(o.retry_reads, false)
    t.equal(o.retry_writes, false)
}

fn test_tls_choices(t: *testing.T) {
    t.equal(tls_verifies(parsed("mongodb://h/?tls=true")), "true")
    t.equal(tls_verifies(parsed("mongodb://h/?ssl=true&tlsInsecure=true")), "false")
    t.equal(tls_verifies(parsed("mongodb://h/?tls=true&tlsAllowInvalidCertificates=true")), "false")
    t.equal(tls_verifies(parsed("mongodb://h/?tls=false")), "off")
    t.equal(uri_outcome("mongodb://h/?tls=true&tlsCAFile=/nonexistent/ca.pem"), "invalid cannot read tlsCAFile /nonexistent/ca.pem")
}

fn test_invalid(t: *testing.T) {
    t.equal(uri_outcome("localhost"), "invalid a connection string starts with mongodb://")
    t.equal(uri_outcome("mongodb://"), "invalid the connection string has an empty host")
    t.equal(uri_outcome("mongodb://a,,b"), "invalid the connection string has an empty host")
    t.equal(uri_outcome("mongodb://h:0"), "invalid the port of h:0 is out of range")
    t.equal(uri_outcome("mongodb://h:70000"), "invalid the port of h:70000 is out of range")
    t.equal(uri_outcome("mongodb://:27017"), "invalid malformed host :27017")
    t.equal(uri_outcome("mongodb://@h"), "invalid the user name is empty")
    t.equal(uri_outcome("mongodb://h/?bogus=1"), "invalid unknown connection string option bogus")
    t.equal(uri_outcome("mongodb://h/?tls=maybe"), "invalid tls must be true or false")
    t.equal(uri_outcome("mongodb://h/?maxPoolSize=many"), "invalid maxPoolSize must be a whole number")
    t.equal(uri_outcome("mongodb://h/?compressors=lz4"), "invalid unknown compressor lz4")
    t.equal(uri_outcome("mongodb://h/?readPreference=nowhere"), "invalid unknown read preference nowhere")
    t.equal(uri_outcome("mongodb://h/?readPreferenceTags=dc"), "invalid readPreferenceTags needs name:value pairs")
    t.equal(uri_outcome("mongodb://h/?replicaSet"), "invalid the option replicaSet needs a name and a value")
}

fn test_unsupported(t: *testing.T) {
    t.equal(uri_outcome("mongodb+srv://cluster.example.net/db"), "unsupported")
    t.equal(uri_outcome("mongodb://h/?tlsCertificateKeyFile=/k.pem"), "unsupported")
    t.equal(uri_outcome("mongodb://h/?authMechanism=MONGODB-X509"), "unsupported")
    t.equal(uri_outcome("mongodb://h/?authMechanism=PLAIN"), "unsupported")
}

fn test_accepted(t: *testing.T) {
    t.equal(uri_outcome("mongodb://u:p@a:1,b:2/db?replicaSet=rs&w=1"), "ok")
    t.equal(uri_outcome("mongodb://h/?"), "ok")
    t.equal(uri_outcome("mongodb://h/?&&w=1&"), "ok")
}
