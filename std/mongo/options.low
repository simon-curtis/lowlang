import std/tls

/// Which servers of a replica set an operation may be read from.
pub enum ReadMode {
    /// Only the primary.
    Primary
    /// The primary, or a secondary when there is no primary.
    PrimaryPreferred
    /// Only a secondary.
    Secondary
    /// A secondary, or the primary when there is no secondary.
    SecondaryPreferred
    /// Any server within the latency window of the nearest.
    Nearest
}

/// A name and a value of a replica set member tag.
pub struct Tag {
    /// The tag name.
    pub name: str
    /// The tag value.
    pub value: str
}

/// A read preference: a mode, tag sets to match in order and a staleness bound for secondaries.
pub struct ReadPreference {
    /// The mode. Defaults to `Primary`.
    pub mode: ReadMode = ReadMode.Primary
    /// Tag sets tried in order; a server matches a set when it has every tag in it, and an empty set matches every server. Empty by default, which matches every server. Not allowed with `Primary`.
    pub tag_sets: Tag[][] = []
    /// The most seconds a secondary's data may lag behind the primary's, or `-1` for no bound. `connect` fails with `Invalid` for a value below `90`. Defaults to `-1`.
    pub max_staleness: i64 = -1
}

/// How many servers must acknowledge a write.
pub struct WriteConcern {
    /// The `w` value: a count such as `"2"`, `"majority"` or a tag set name. The empty string leaves it to the server default.
    pub w: str = ""
    /// Whether the write must reach the journal, or `none` for the server default.
    pub journal: bool? = none
    /// How many milliseconds the server waits for the acknowledgement, or `0` for no limit.
    pub timeout: i64 = 0
}

/// The settings of a `Client`. `options_from` fills them from a connection string; every field can also be set directly.
pub struct Options {
    /// The seed servers, as `host` or `host:port`; the port defaults to `27017`. A bracketed IPv6 address is `[::1]:27017`.
    pub hosts: str[] = []
    /// The database the connection string names, used by `Client.default_database`. Empty when there is none.
    pub database: str = ""
    /// The user name. Empty connects without authentication.
    pub username: str = ""
    /// The password.
    pub password: str = ""
    /// The database the user is defined in. Empty means `database` when set and `admin` otherwise.
    pub auth_source: str = ""
    /// `SCRAM-SHA-256` or `SCRAM-SHA-1`. Empty picks the strongest the server offers for the user.
    pub auth_mechanism: str = ""
    /// The application name sent to the server in the handshake and shown in its logs.
    pub app_name: str = ""
    /// TLS settings, or `none` for plain TCP. `server_name` defaults to the host of each server.
    pub tls: tls.Config? = none
    /// Wire compressors to offer, in order of preference, from `zstd`, `zlib` and `snappy`.
    pub compressors: str[] = []
    /// The deflate or zstd level used for outgoing messages when compression is negotiated.
    pub compression_level: i64 = 3
    /// The replica set name every server must report, or empty to accept any.
    pub replica_set: str = ""
    /// Whether to talk to the single named host without discovering the others. Needs exactly one host.
    pub direct: bool = false
    /// Milliseconds a TCP connect and handshake may take.
    pub connect_timeout: i64 = 10000
    /// Milliseconds a read or write on a connection may take, or `0` for no limit.
    pub socket_timeout: i64 = 0
    /// Milliseconds server selection waits for a suitable server.
    pub server_selection_timeout: i64 = 30000
    /// Milliseconds between checks of each server.
    pub heartbeat: i64 = 10000
    /// Milliseconds beyond the nearest server's round trip time within which servers count as equally near.
    pub local_threshold: i64 = 15
    /// The most connections per server in use and idle together.
    pub max_pool_size: i64 = 100
    /// Milliseconds an idle connection is kept, or `0` for ever.
    pub max_idle_time: i64 = 0
    /// Milliseconds a call waits for a pooled connection, or `0` for no limit.
    pub wait_queue_timeout: i64 = 0
    /// The default read preference.
    pub read_preference: ReadPreference = ReadPreference {}
    /// The default read concern level, such as `majority`, or empty for the server default.
    pub read_concern: str = ""
    /// The default write concern.
    pub write_concern: WriteConcern = WriteConcern {}
    /// Whether a read is retried once after a network error or a retryable server error.
    pub retry_reads: bool = true
    /// Whether a write is retried once after a network error or a retryable server error.
    pub retry_writes: bool = true
}

/// Returns the name of `m` as it appears in a connection string and in `$readPreference`.
pub fn mode_name(m: ReadMode) -> str {
    match m {
        Primary => "primary"
        PrimaryPreferred => "primaryPreferred"
        Secondary => "secondary"
        SecondaryPreferred => "secondaryPreferred"
        Nearest => "nearest"
    }
}
