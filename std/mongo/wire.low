import std/compress/deflate
import std/compress/snappy
import std/compress/zstd
import std/hash
import std/io

const op_msg = 2013
const op_compressed = 2012

const flag_checksum = 1
const flag_more_to_come = 2

const header_size = 16
const message_limit = 100663296

const compressor_none = 0
const compressor_snappy = 1
const compressor_zlib = 2
const compressor_zstd = 3

struct Sequence {
    identifier: str
    documents: u8[][]
}

struct Message {
    request_id: i64
    response_to: i64
    flags: i64
    body: u8[]
    sequences: Sequence[]
}

fn put_cstring(mut b: u8[], s: str) {
    io.append(mut b, bytes(s))
    b.push(0)
}

fn encode_message(m: Message, checksum: bool) -> u8[] {
    var b: u8[] = []
    io.put_le32(mut b, 0)
    io.put_le32(mut b, m.request_id)
    io.put_le32(mut b, m.response_to)
    io.put_le32(mut b, op_msg)
    var flags = m.flags
    if checksum {
        flags |= flag_checksum
    }
    io.put_le32(mut b, flags)
    b.push(0)
    io.append(mut b, m.body)
    for s in m.sequences {
        b.push(1)
        var size = 4 + s.identifier.len + 1
        for d in s.documents {
            size += d.len
        }
        io.put_le32(mut b, size)
        put_cstring(mut b, s.identifier)
        for d in s.documents {
            io.append(mut b, d)
        }
    }
    if checksum {
        io.put_le32(mut b, 0)
    }
    let total = b.len
    set_le32(b, 0, total)
    if checksum {
        let c = hash.crc32c_new()
        hash.crc32_update(c, b[..total - 4])
        set_le32(b, total - 4, i64(hash.crc32_sum(c)))
    }
    b
}

fn set_le32(b: u8[], at: i64, v: i64) {
    b[at] = u8(v & 255)
    b[at + 1] = u8((v >> 8) & 255)
    b[at + 2] = u8((v >> 16) & 255)
    b[at + 3] = u8((v >> 24) & 255)
}

fn read_frame(r: *io.Reader) -> u8[] ! Error {
    let header = io.read_exact(r, 4) catch {
        e => fail transport(e)
    }
    let length = io.le32(header, 0)
    if length < header_size || length > message_limit {
        fail Protocol
    }
    let rest = io.read_exact(r, length - 4) catch {
        e => fail transport(e)
    }
    var frame: u8[] = []
    io.append(mut frame, header)
    io.append(mut frame, rest)
    frame
}

fn compress_frame(frame: u8[], compressor: i64, level: i64) -> u8[] {
    let inner = frame[header_size..]
    if compressor < compressor_snappy || compressor > compressor_zstd {
        return frame
    }
    let packed = match compressor {
        1 => snappy.compress_block(inner)
        2 => deflate.zlib_compress(inner, level)
        _ => zstd.compress(inner, level)
    }
    var b: u8[] = []
    io.put_le32(mut b, 0)
    io.append(mut b, frame[4..12])
    io.put_le32(mut b, op_compressed)
    io.put_le32(mut b, io.le32(frame, 12))
    io.put_le32(mut b, inner.len)
    b.push(u8(compressor))
    io.append(mut b, packed)
    set_le32(b, 0, b.len)
    b
}

fn expand(frame: u8[]) -> u8[] ! Error {
    if frame.len < header_size + 9 {
        fail Protocol
    }
    let original = io.le32(frame, 16)
    let size = io.le32(frame, 20)
    let compressor = i64(frame[24])
    let packed = frame[25..]
    if size < 0 || size > message_limit {
        fail Protocol
    }
    if compressor < compressor_none || compressor > compressor_zstd {
        fail Unsupported
    }
    let inner = match compressor {
        0 => packed
        1 => snappy.decompress_block(packed, size) catch {
            e => fail Protocol
        }
        2 => deflate.zlib_decompress(packed, size) catch {
            e => fail Protocol
        }
        _ => zstd.decompress(packed, size) catch {
            e => fail Protocol
        }
    }
    if inner.len != size {
        fail Protocol
    }
    var b: u8[] = []
    io.put_le32(mut b, header_size + inner.len)
    io.append(mut b, frame[4..12])
    io.put_le32(mut b, original)
    io.append(mut b, inner)
    b
}

fn decode_message(frame: u8[]) -> Message ! Error {
    var whole = frame
    if io.le32(whole, 12) == op_compressed {
        whole = expand(whole)?
    }
    if io.le32(whole, 12) != op_msg || whole.len < header_size + 5 {
        fail Protocol
    }
    let flags = io.le32(whole, 16)
    if (flags & 0xFFFC) != 0 {
        fail Protocol
    }
    var end = whole.len
    if (flags & flag_checksum) != 0 {
        end -= 4
        let c = hash.crc32c_new()
        hash.crc32_update(c, whole[..end])
        if i64(hash.crc32_sum(c)) != io.le32(whole, end) {
            fail Protocol
        }
    }
    var at = header_size + 4
    var body: u8[] = []
    var have_body = false
    var sequences: Sequence[] = []
    for at < end {
        let kind = whole[at]
        at += 1
        if kind == 0 {
            if have_body || at + 4 > end {
                fail Protocol
            }
            let size = io.le32(whole, at)
            if size < 5 || at + size > end {
                fail Protocol
            }
            body = whole[at..at + size]
            have_body = true
            at += size
        } else if kind == 1 {
            if at + 4 > end {
                fail Protocol
            }
            let size = io.le32(whole, at)
            if size < 5 || at + size > end {
                fail Protocol
            }
            let section_end = at + size
            var cursor = at + 4
            var name_end = cursor
            for name_end < section_end && whole[name_end] != 0 {
                name_end += 1
            }
            if name_end >= section_end {
                fail Protocol
            }
            let identifier = str(whole[cursor..name_end])
            cursor = name_end + 1
            var documents: u8[][] = []
            for cursor < section_end {
                if cursor + 4 > section_end {
                    fail Protocol
                }
                let length = io.le32(whole, cursor)
                if length < 5 || cursor + length > section_end {
                    fail Protocol
                }
                documents.push(whole[cursor..cursor + length])
                cursor += length
            }
            sequences.push(Sequence { identifier, documents })
            at = section_end
        } else {
            fail Protocol
        }
    }
    if !have_body {
        fail Protocol
    }
    Message { request_id: io.le32(whole, 4), response_to: io.le32(whole, 8), flags, body, sequences }
}
