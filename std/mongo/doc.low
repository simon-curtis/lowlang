import std/bson

/// Returns the field `name` holding the string `value`.
pub fn text_of(name: str, value: str) -> bson.Field {
    bson.Field { name, value: bson.Value.Str(value) }
}

/// Returns the field `name` holding `value` as a 32-bit integer when it fits and as a 64-bit integer otherwise.
pub fn int_of(name: str, value: i64) -> bson.Field {
    if value >= -2147483648 && value <= 2147483647 {
        return bson.Field { name, value: bson.Value.Int32(i32(value)) }
    }
    bson.Field { name, value: bson.Value.Int64(value) }
}

/// Returns the field `name` holding `value` as a 64-bit integer.
pub fn long_of(name: str, value: i64) -> bson.Field {
    bson.Field { name, value: bson.Value.Int64(value) }
}

/// Returns the field `name` holding the double `value`.
pub fn double_of(name: str, value: f64) -> bson.Field {
    bson.Field { name, value: bson.Value.Double(value) }
}

/// Returns the field `name` holding the boolean `value`.
pub fn bool_of(name: str, value: bool) -> bson.Field {
    bson.Field { name, value: bson.Value.Bool(value) }
}

/// Returns the field `name` holding the embedded document `fields`.
pub fn document_of(name: str, fields: []bson.Field) -> bson.Field {
    bson.Field { name, value: bson.Value.Document(fields) }
}

/// Returns the field `name` holding the array `items`.
pub fn array_of(name: str, items: []bson.Value) -> bson.Field {
    bson.Field { name, value: bson.Value.Array(items) }
}

/// Returns the field `name` holding the strings `items` as an array.
pub fn texts_of(name: str, items: []str) -> bson.Field {
    var values: []bson.Value = []
    for s in items {
        push(mut values, bson.Value.Str(s))
    }
    bson.Field { name, value: bson.Value.Array(values) }
}

/// Returns the field `name` holding the documents `items` as an array.
pub fn documents_of(name: str, items: [][]bson.Field) -> bson.Field {
    var values: []bson.Value = []
    for d in items {
        push(mut values, bson.Value.Document(d))
    }
    bson.Field { name, value: bson.Value.Array(values) }
}

/// Returns the field `name` holding binary data of `subtype`.
pub fn binary_of(name: str, subtype: u8, data: []u8) -> bson.Field {
    bson.Field { name, value: bson.Value.Binary(subtype, data) }
}

/// Returns the field `name` holding the null value.
pub fn null_of(name: str) -> bson.Field {
    bson.Field { name, value: bson.Value.Null }
}

/// Returns the number in `v` as an integer: an `Int32`, an `Int64`, or a `Double` with no fractional part. `none` for any other value.
pub fn number(v: bson.Value) -> i64? {
    match v {
        Int32(n) => some(i64(n))
        Int64(n) => some(n)
        Double(x) => if x == f64(i64(x)) { some(i64(x)) } else { none }
        _ => none
    }
}

/// Returns the integer field `name`, or `none` when it is absent or not a number. See `number`.
pub fn get_int(fields: []bson.Field, name: str) -> i64? {
    match bson.get(fields, name) {
        some(v) => number(v)
        none => none
    }
}

/// Returns the string field `name`, or `none` when it is absent or not a string.
pub fn get_text(fields: []bson.Field, name: str) -> str? {
    match bson.get(fields, name) {
        some(v) => match v {
            Str(s) => some(s)
            _ => none
        }
        none => none
    }
}

/// Returns the boolean field `name`. A number counts as `true` when it is not zero. `none` when the field is absent or neither.
pub fn get_bool(fields: []bson.Field, name: str) -> bool? {
    match bson.get(fields, name) {
        some(v) => match v {
            Bool(b) => some(b)
            Int32(n) => some(n != 0)
            Int64(n) => some(n != 0)
            Double(x) => some(x != 0.0)
            _ => none
        }
        none => none
    }
}

/// Returns the embedded document `name`, or `none` when it is absent or not a document.
pub fn get_document(fields: []bson.Field, name: str) -> []bson.Field? {
    match bson.get(fields, name) {
        some(v) => match v {
            Document(d) => some(d)
            _ => none
        }
        none => none
    }
}

/// Returns the array `name`, or `none` when it is absent or not an array.
pub fn get_array(fields: []bson.Field, name: str) -> []bson.Value? {
    match bson.get(fields, name) {
        some(v) => match v {
            Array(a) => some(a)
            _ => none
        }
        none => none
    }
}

/// Returns the strings of the array `name`, skipping items that are not strings. Empty when the field is absent or not an array.
pub fn get_texts(fields: []bson.Field, name: str) -> []str {
    var out: []str = []
    match get_array(fields, name) {
        some(items) => {
            for v in items {
                match v {
                    Str(s) => push(mut out, s)
                    _ => {}
                }
            }
        }
        none => {}
    }
    out
}

/// Returns the documents of the array `name`, skipping items that are not documents. Empty when the field is absent or not an array.
pub fn get_documents(fields: []bson.Field, name: str) -> [][]bson.Field {
    var out: [][]bson.Field = []
    match get_array(fields, name) {
        some(items) => {
            for v in items {
                match v {
                    Document(d) => push(mut out, d)
                    _ => {}
                }
            }
        }
        none => {}
    }
    out
}

/// Returns a copy of `fields` followed by `extra`.
pub fn with_fields(fields: []bson.Field, extra: []bson.Field) -> []bson.Field {
    var out: []bson.Field = []
    for f in fields {
        push(mut out, f)
    }
    for f in extra {
        push(mut out, f)
    }
    out
}

/// Returns `fields` without any field called `name`.
pub fn without(fields: []bson.Field, name: str) -> []bson.Field {
    var out: []bson.Field = []
    for f in fields {
        if f.name != name {
            push(mut out, f)
        }
    }
    out
}
