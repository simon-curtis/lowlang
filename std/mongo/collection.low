import std/bson
import std/text

/// A database on a client, with the read preference, read concern and write concern its collections start with.
pub struct Database {
    /// The client the database belongs to.
    pub client: *ClientHandle
    /// The database name.
    pub name: str
    /// Where reads of its collections go. Defaults to the client's.
    pub read_preference: ReadPreference
    /// The read concern level of its collections. Defaults to the client's.
    pub read_concern: str
    /// The write concern of its collections. Defaults to the client's.
    pub write_concern: WriteConcern
}

/// A collection in a database. The read preference, read concern and write concern are copied from the `Database` and can be changed on the copy.
pub struct Collection {
    /// The client the collection belongs to.
    pub client: *ClientHandle
    /// The name of the database.
    pub database: str
    /// The collection name.
    pub name: str
    /// Where reads go.
    pub read_preference: ReadPreference
    /// The read concern level of reads, such as `majority`, or empty for the server default.
    pub read_concern: str
    /// The write concern of writes.
    pub write_concern: WriteConcern
}

/// Options shared by the operations that take few: the session to run in and a server-side time limit.
pub struct CallOptions {
    /// The session to run in, or `none` to use an implicit one.
    pub session: *Session? = none
    /// The most milliseconds the server works on the operation, or `0` for no limit.
    pub max_time: i64 = 0
}

/// Options of `find` and `find_one`.
pub struct FindOptions {
    /// The fields to return, as `{ field: 1 }` or `{ field: 0 }`. Empty returns whole documents.
    pub projection: bson.Field[] = []
    /// The sort order, as `{ field: 1 }` for ascending and `{ field: -1 }` for descending.
    pub sort: bson.Field[] = []
    /// How many matching documents to skip.
    pub skip: i64 = 0
    /// The most documents to return, or `0` for all.
    pub limit: i64 = 0
    /// How many documents the server sends in a batch, or `0` for its default.
    pub batch_size: i64 = 0
    /// The index to use: its name as a `Str` or its key pattern as a `Document`.
    pub hint: bson.Value? = none
    /// The collation document, or empty.
    pub collation: bson.Field[] = []
    /// The most milliseconds the server works on each batch, or `0` for no limit.
    pub max_time: i64 = 0
    /// Whether the server may use disk for a sort that does not fit in memory.
    pub allow_disk_use: bool = false
    /// The session to run in, or `none` to use an implicit one.
    pub session: *Session? = none
}

/// Options of `aggregate`.
pub struct AggregateOptions {
    /// How many documents the server sends in a batch, or `0` for its default.
    pub batch_size: i64 = 0
    /// Whether stages may write to disk.
    pub allow_disk_use: bool = false
    /// The index to use: its name as a `Str` or its key pattern as a `Document`.
    pub hint: bson.Value? = none
    /// The collation document, or empty.
    pub collation: bson.Field[] = []
    /// The most milliseconds the server works on the pipeline, or `0` for no limit.
    pub max_time: i64 = 0
    /// The session to run in, or `none` to use an implicit one.
    pub session: *Session? = none
}

/// Options of `count_documents`.
pub struct CountOptions {
    /// How many matching documents to skip before counting.
    pub skip: i64 = 0
    /// The most documents to count, or `0` for all.
    pub limit: i64 = 0
    /// The index to use: its name as a `Str` or its key pattern as a `Document`.
    pub hint: bson.Value? = none
    /// The collation document, or empty.
    pub collation: bson.Field[] = []
    /// The most milliseconds the server works, or `0` for no limit.
    pub max_time: i64 = 0
    /// The session to run in, or `none` to use an implicit one.
    pub session: *Session? = none
}

/// Options of `run_command`.
pub struct CommandOptions {
    /// Where the command goes. Defaults to the primary, whatever the database says.
    pub read_preference: ReadPreference = ReadPreference {}
    /// The session to run in, or `none` to use an implicit one.
    pub session: *Session? = none
}

/// An index: its keys and the properties that shape it.
pub struct IndexModel {
    /// The indexed fields, as `{ field: 1 }` for ascending, `{ field: -1 }` for descending, or a special type such as `"text"`.
    pub keys: bson.Field[]
    /// The index name. Empty derives it from the keys, as in `a_1_b_-1`.
    pub name: str = ""
    /// Whether the index rejects documents whose key duplicates another's.
    pub unique: bool = false
    /// Whether the index skips documents that lack the field.
    pub sparse: bool = false
    /// For a single date field, the seconds after which the server deletes the document, or `-1` for none.
    pub expire_after_seconds: i64 = -1
    /// Index only the documents that match this filter. Empty indexes every document.
    pub partial_filter: bson.Field[] = []
    /// The collation document, or empty.
    pub collation: bson.Field[] = []
}

/// Returns the database `name` of the client `c`.
pub fn database(c: Client, name: str) -> Database {
    database_on(c.handle, name)
}

/// Returns the database `name` of the client behind `h`.
pub fn database_on(h: *ClientHandle, name: str) -> Database {
    Database {
        client: h
        name
        read_preference: h.options.read_preference
        read_concern: h.options.read_concern
        write_concern: h.options.write_concern
    }
}

/// Returns the collection `name` of `d`.
pub fn collection(d: Database, name: str) -> Collection {
    Collection {
        client: d.client
        database: d.name
        name
        read_preference: d.read_preference
        read_concern: d.read_concern
        write_concern: d.write_concern
    }
}

fn read_op(c: Collection, body: bson.Field[], session: *Session?, keep: bool) -> Op {
    Op { db: c.database, body, pref: c.read_preference, read_concern: c.read_concern, reading: true, retry: true, session, keep }
}

fn optional_field(name: str, value: bson.Value?) -> bson.Field[] {
    match value {
        some(v) => [bson.Field { name, value: v }]
        none => []
    }
}

fn nonempty_field(name: str, fields: bson.Field[]) -> bson.Field[] {
    if fields.len == 0 {
        return []
    }
    [document_of(name, fields)]
}

fn positive_field(name: str, n: i64) -> bson.Field[] {
    if n <= 0 {
        return []
    }
    [int_of(name, n)]
}

fn flag_field(name: str, on: bool) -> bson.Field[] {
    if !on {
        return []
    }
    [bool_of(name, true)]
}

fn joined(parts: bson.Field[][]) -> bson.Field[] {
    var out: bson.Field[] = []
    for p in parts {
        for f in p {
            out.push(f)
        }
    }
    out
}

fn find_body(c: Collection, filter: bson.Field[], o: FindOptions, single: bool) -> bson.Field[] {
    joined([
        [text_of("find", c.name), document_of("filter", filter)]
        nonempty_field("projection", o.projection)
        nonempty_field("sort", o.sort)
        positive_field("skip", o.skip)
        positive_field("limit", o.limit)
        positive_field("batchSize", o.batch_size)
        optional_field("hint", o.hint)
        nonempty_field("collation", o.collation)
        positive_field("maxTimeMS", o.max_time)
        flag_field("allowDiskUse", o.allow_disk_use)
        flag_field("singleBatch", single)
    ])
}

/// Returns a cursor over the documents of `c` that match `filter`, an empty filter matching all of them.
///
/// Reads go to a server chosen by the read preference of `c`, and a network failure or a retryable server error before the first batch is retried once. The cursor stays on that server.
pub fn find(c: Collection, filter: bson.Field[], o: FindOptions) -> *Cursor ! Error {
    let single = o.limit == 1
    let op = read_op(c, find_body(c, filter, o, single), o.session, true)
    let reply = execute(c.client, op)?
    cursor_from(c.client, reply, c.database, c.name, o.batch_size, o.max_time, c.read_preference)?
}

/// Returns the first document of `c` that matches `filter`, or `none`.
pub fn find_one(c: Collection, filter: bson.Field[], o: FindOptions) -> bson.Field[]? ! Error {
    var limited = o
    limited.limit = 1
    let cursor = find(c, filter, limited)?
    let first = next(cursor) catch {
        e => {
            close_cursor(cursor)
            fail e
        }
    }
    close_cursor(cursor)
    first
}

fn is_write_stage(pipeline: bson.Field[][]) -> bool {
    if pipeline.len == 0 {
        return false
    }
    let last = pipeline[pipeline.len - 1]
    if last.len == 0 {
        return false
    }
    last[0].name == "$out" || last[0].name == "$merge"
}

/// Returns a cursor over the result of running `pipeline`, a list of stage documents, on `c`.
///
/// A pipeline that ends in `$out` or `$merge` writes, so it goes to the primary with the write concern of `c`, and it is not retried unless it was the first attempt that failed to reach a server.
pub fn aggregate(c: Collection, pipeline: bson.Field[][], o: AggregateOptions) -> *Cursor ! Error {
    var stages: bson.Value[] = []
    for stage in pipeline {
        stages.push(bson.Value.Document(stage))
    }
    let writes = is_write_stage(pipeline)
    var cursor_options: bson.Field[] = []
    if o.batch_size > 0 {
        cursor_options = [int_of("batchSize", o.batch_size)]
    }
    var body = joined([
        [text_of("aggregate", c.name), array_of("pipeline", stages), document_of("cursor", cursor_options)]
        flag_field("allowDiskUse", o.allow_disk_use)
        optional_field("hint", o.hint)
        nonempty_field("collation", o.collation)
        positive_field("maxTimeMS", o.max_time)
    ])
    var op = read_op(c, body, o.session, true)
    if writes {
        body = with_fields(body, concern_fields(o.session, c.write_concern))
        op = Op { db: c.database, body, write: true, retry: true, read_concern: c.read_concern, reading: true, session: o.session, keep: true }
    }
    let reply = execute(c.client, op)?
    var pref = c.read_preference
    if writes {
        pref = ReadPreference {}
    }
    cursor_from(c.client, reply, c.database, c.name, o.batch_size, o.max_time, pref)?
}

fn concern_fields(session: *Session?, wc: WriteConcern) -> bson.Field[] {
    if in_transaction(session) {
        return []
    }
    write_concern_fields(wc)
}

/// Returns how many documents of `c` match `filter`, by counting them on the server.
pub fn count_documents(c: Collection, filter: bson.Field[], o: CountOptions) -> i64 ! Error {
    var pipeline: bson.Field[][] = [[document_of("$match", filter)]]
    if o.skip > 0 {
        pipeline.push([int_of("$skip", o.skip)])
    }
    if o.limit > 0 {
        pipeline.push([int_of("$limit", o.limit)])
    }
    pipeline.push([document_of("$group", [int_of("_id", 1), document_of("n", [int_of("$sum", 1)])])])
    let options = AggregateOptions { hint: o.hint, collation: o.collation, max_time: o.max_time, session: o.session }
    let cursor = aggregate(c, pipeline, options)?
    let rows = all(cursor)?
    if rows.len == 0 {
        return 0
    }
    get_int(rows[0], "n") ?? fail Protocol
}

/// Returns the number of documents of `c` from its metadata, which is fast and may be off after an unclean shutdown or while chunks are moving in a sharded cluster.
pub fn estimated_document_count(c: Collection, o: CallOptions) -> i64 ! Error {
    let body = joined([[text_of("count", c.name)], positive_field("maxTimeMS", o.max_time)])
    let reply = execute(c.client, read_op(c, body, o.session, false))?
    get_int(reply.fields, "n") ?? fail Protocol
}

/// Returns the distinct values of `field` over the documents of `c` that match `filter`.
pub fn distinct(c: Collection, field: str, filter: bson.Field[], o: CallOptions) -> bson.Value[] ! Error {
    let body = joined([[text_of("distinct", c.name), text_of("key", field), document_of("query", filter)], positive_field("maxTimeMS", o.max_time)])
    let reply = execute(c.client, read_op(c, body, o.session, false))?
    get_array(reply.fields, "values") ?? fail Protocol
}

/// Runs the command `command`, whose first field names it, on `d` and returns the reply. A reply with `ok: 0` fails with `Server`.
pub fn run_command(d: Database, command: bson.Field[], o: CommandOptions) -> bson.Field[] ! Error {
    let op = Op { db: d.name, body: command, pref: o.read_preference, session: o.session }
    let reply = execute(d.client, op)?
    reply.fields
}

fn admin_op(c: Collection, body: bson.Field[], o: CallOptions) -> Op {
    Op { db: c.database, body: joined([body, positive_field("maxTimeMS", o.max_time)]), write: true, session: o.session }
}

fn execute_tolerating(h: *ClientHandle, op: Op, code: i64) ! Error {
    execute(h, op) catch {
        e => {
            match e {
                Server(c, _, _, _) => {
                    if c == code {
                        return
                    }
                }
                _ => {}
            }
            fail e
        }
    }
}

/// Drops `c` with its documents and indexes. A collection that does not exist is not an error.
pub fn drop_collection(c: Collection, o: CallOptions) ! Error {
    let body = joined([[text_of("drop", c.name)], concern_fields(o.session, c.write_concern)])
    execute_tolerating(c.client, admin_op(c, body, o), 26)?
}

/// Drops the database `d`.
pub fn drop_database(d: Database, o: CallOptions) ! Error {
    let body = joined([[int_of("dropDatabase", 1)], concern_fields(o.session, d.write_concern)])
    let op = Op { db: d.name, body, write: true, session: o.session }
    execute(d.client, op)?
}

/// Creates the collection `name` in `d`. `options` are fields of the `create` command, such as `capped` and `size`, or `validator`.
pub fn create_collection(d: Database, name: str, options: bson.Field[], o: CallOptions) ! Error {
    let body = joined([[text_of("create", name)], options, concern_fields(o.session, d.write_concern)])
    let op = Op { db: d.name, body, write: true, session: o.session }
    execute(d.client, op)?
}

/// Returns the names of the collections of `d`.
pub fn list_collection_names(d: Database, o: CallOptions) -> str[] ! Error {
    let body = [int_of("listCollections", 1), bool_of("nameOnly", true), document_of("cursor", [])]
    let op = Op { db: d.name, body, pref: d.read_preference, reading: false, retry: true, session: o.session, keep: true }
    let reply = execute(d.client, op)?
    let cursor = cursor_from(d.client, reply, d.name, "$cmd.listCollections", 0, 0, d.read_preference)?
    var names: str[] = []
    for row in all(cursor)? {
        match get_text(row, "name") {
            some(n) => {
                names.push(n)
            }
            none => {}
        }
    }
    names
}

/// Returns the names of the databases on the deployment `c` is connected to.
pub fn list_database_names(c: Client, o: CallOptions) -> str[] ! Error {
    let body = [int_of("listDatabases", 1), bool_of("nameOnly", true)]
    let op = Op { db: "admin", body, pref: c.handle.options.read_preference, retry: true, session: o.session }
    let reply = execute(c.handle, op)?
    var names: str[] = []
    for row in get_documents(reply.fields, "databases") {
        match get_text(row, "name") {
            some(n) => {
                names.push(n)
            }
            none => {}
        }
    }
    names
}

fn key_part(v: bson.Value) -> str {
    match v {
        Int32(n) => "{n}"
        Int64(n) => "{n}"
        Double(x) => "{x}"
        Str(s) => s
        _ => ""
    }
}

fn derived_name(keys: bson.Field[]) -> str {
    var parts: str[] = []
    for k in keys {
        parts.push("{k.name}_{key_part(k.value)}")
    }
    text.join(parts, "_")
}

fn index_document(m: IndexModel) -> bson.Field[] ! Error {
    if m.keys.len == 0 {
        fail Invalid("an index needs at least one key")
    }
    var name = m.name
    if name.len == 0 {
        name = derived_name(m.keys)
    }
    var fields: bson.Field[] = [document_of("key", m.keys), text_of("name", name)]
    if m.unique {
        fields.push(bool_of("unique", true))
    }
    if m.sparse {
        fields.push(bool_of("sparse", true))
    }
    if m.expire_after_seconds >= 0 {
        fields.push(int_of("expireAfterSeconds", m.expire_after_seconds))
    }
    for f in nonempty_field("partialFilterExpression", m.partial_filter) {
        fields.push(f)
    }
    for f in nonempty_field("collation", m.collation) {
        fields.push(f)
    }
    fields
}

/// Creates `models` on `c` and returns their names. Indexes that exist with the same definition are left as they are.
pub fn create_indexes(c: Collection, models: IndexModel[], o: CallOptions) -> str[] ! Error {
    if models.len == 0 {
        fail Invalid("no index to create")
    }
    var specs: bson.Field[][] = []
    var names: str[] = []
    for m in models {
        let spec = index_document(m)?
        specs.push(spec)
        names.push(get_text(spec, "name") ?? "")
    }
    let body = joined([[text_of("createIndexes", c.name), documents_of("indexes", specs)], concern_fields(o.session, c.write_concern)])
    let _ = execute(c.client, admin_op(c, body, o))?
    names
}

/// Creates the index `m` on `c` and returns its name.
pub fn create_index(c: Collection, m: IndexModel, o: CallOptions) -> str ! Error {
    let names = create_indexes(c, [m], o)?
    names[0]
}

/// Drops the index called `name` from `c`. Use `*` to drop every index but the one on `_id`.
pub fn drop_index(c: Collection, name: str, o: CallOptions) ! Error {
    let body = joined([[text_of("dropIndexes", c.name), text_of("index", name)], concern_fields(o.session, c.write_concern)])
    execute(c.client, admin_op(c, body, o))?
}

/// Returns a cursor over the index specifications of `c`, each with `name` and `key`.
pub fn list_indexes(c: Collection, o: CallOptions) -> *Cursor ! Error {
    let body = [text_of("listIndexes", c.name), document_of("cursor", [])]
    let op = Op { db: c.database, body, pref: c.read_preference, retry: true, session: o.session, keep: true }
    let reply = execute(c.client, op)?
    cursor_from(c.client, reply, c.database, c.name, 0, 0, c.read_preference)?
}
