import std/protobuf
import std/text

struct Phone {
    number: str "1"
    mobile: bool "2"
}

struct Contact {
    name: str "1"
    id: i32 "2"
    balance: i64 "3,sint"
    scores: u64[] "4"
    phones: Phone[] "5"
    rating: f64 "6"
}

/// Serializes a struct whose fields carry protobuf field numbers, reads it back, skips a field the struct does not declare and rejects truncated input.
fn main() {
    let contact = Contact {
        name: "Ada",
        id: -2,
        balance: -150,
        scores: [3, 270, 86942],
        phones: [Phone { number: "555-0100", mobile: true }, Phone { number: "555-0111", mobile: false }],
        rating: 4.5,
    }
    let data = protobuf.serialize(contact)
    print("{data.len} bytes: {text.encode_hex(data)}")

    let back = protobuf.deserialize[Contact](data) or panic("decode")
    print("{back.name} id {back.id} balance {back.balance} rating {back.rating}")
    print("scores {back.scores}")
    for p in back.phones {
        print("phone {p.number} mobile {p.mobile}")
    }

    var extended = data
    extended.push(0x98)
    extended.push(0x06)
    extended.push(0x07)
    let skipped = protobuf.deserialize[Contact](extended) or panic("decode with an unknown field")
    print("unknown field skipped: {skipped.name} {skipped.phones.len}")

    let truncated = protobuf.deserialize[Contact](data[..data.len - 1]) catch {
        e => {
            print("truncated input: {e}")
            return
        }
    }
    print(truncated.name)
}
