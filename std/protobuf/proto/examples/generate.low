import std/io
import std/protobuf/proto

fn source(name: str) -> str ! io.Error {
    match name {
        == "shop/order.proto" => "syntax = \"proto3\";\npackage shop.v1;\nimport \"shop/money.proto\";\nmessage Order {{\n  string id = 1;\n  repeated Line lines = 2;\n  shop.v1.Money total = 3;\n  message Line {{\n    string sku = 1;\n    uint32 quantity = 2;\n  }}\n}}\n"
        == "shop/money.proto" => "syntax = \"proto3\";\npackage shop.v1;\nmessage Money {{\n  string currency = 1;\n  sint64 cents = 2;\n}}\n"
        _ => fail io.Error.NotFound
    }
}

fn parse_text(path: str, text: str) {
    let file = proto.parse(path, text) catch {
        e => {
            print(proto.message(e))
            return
        }
    }
    print("{path}: {file.messages.len} messages")
}

/// Parses one `.proto` text, loads a file with its import through a reader that holds both in memory and prints the Low modules generated from them.
fn main() {
    let file = proto.parse("order.proto", "syntax = \"proto3\";\nmessage Ping {{ int32 id = 1; }}\n") catch {
        e => {
            print(proto.message(e))
            return
        }
    }
    for m in file.messages {
        print("message {m.name}")
        for f in m.fields {
            print("  field {f.name} = {f.number}")
        }
    }

    parse_text("bad.proto", "syntax = \"proto3\";\nmessage Ping {{ group Id = 1 {{}} }}\n")

    let set = proto.read_files(["shop/order.proto"], [""], source) catch {
        e => {
            print(proto.message(e))
            return
        }
    }
    let outputs = proto.generate(set, proto.Options { module: "gen" }) catch {
        e => {
            print(proto.message(e))
            return
        }
    }
    for o in outputs {
        print("--- {o.path}")
        print(o.text)
    }
}
