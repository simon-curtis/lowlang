message Ping
  field id = 1
bad.proto:2:16: groups are not supported
--- shop/money/money.low
pub struct Money {
    pub currency: str "1"
    pub cents: i64 "2,sint"
}

--- shop/order/order.low
import gen/shop/money

pub struct Order {
    pub id: str "1"
    pub lines: OrderLine[] "2"
    pub total: money.Money? "3"
}

pub struct OrderLine {
    pub sku: str "1"
    pub quantity: u32 "2"
}

