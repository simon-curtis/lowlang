import std/text

enum TokenKind {
    Ident
    Int
    Float
    Str
    Symbol
    End
}

struct Token {
    kind: TokenKind
    text: str
    pos: Pos
    start: i64
    end: i64
}

struct Scanner {
    file: str
    source: str
    at: i64
    line: i64
    column: i64
    tokens: []Token
}

fn scan_pos(s: *Scanner) -> Pos {
    Pos { file: s.file, line: s.line, column: s.column }
}

fn scan_peek(s: *Scanner, ahead: i64) -> u8 {
    if s.at + ahead >= s.source.len {
        return 0
    }
    s.source[s.at + ahead]
}

fn scan_advance(s: *Scanner) {
    if s.source[s.at] == '\n' {
        s.line += 1
        s.column = 1
    } else {
        s.column += 1
    }
    s.at += 1
}

fn scan_letter(c: u8) -> bool {
    c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c == '_'
}

fn scan_digit(c: u8) -> bool {
    c >= '0' && c <= '9'
}

fn scan_hex_digit(c: u8) -> bool {
    scan_digit(c) || c >= 'a' && c <= 'f' || c >= 'A' && c <= 'F'
}

fn scan_hex_value(c: u8) -> u32 {
    if scan_digit(c) {
        return u32(c - '0')
    }
    if c >= 'a' {
        return u32(c - 'a') + 10
    }
    u32(c - 'A') + 10
}

fn tokenize(file: str, source: str) -> []Token ! Error {
    let s = new(Scanner { file, source, at: 0, line: 1, column: 1, tokens: [] })
    for s.at < s.source.len {
        scan_token(s)?
    }
    let end = scan_pos(s)
    push(mut s.tokens, Token { kind: TokenKind.End, text: "", pos: end, start: s.at, end: s.at })
    s.tokens
}

fn scan_token(s: *Scanner) ! Error {
    let c = s.source[s.at]
    if c == ' ' || c == '\t' || c == '\n' || c == '\r' {
        scan_advance(s)
        return
    }
    if c == '/' && scan_peek(s, 1) == '/' {
        for s.at < s.source.len && s.source[s.at] != '\n' {
            scan_advance(s)
        }
        return
    }
    if c == '/' && scan_peek(s, 1) == '*' {
        scan_block_comment(s)?
        return
    }
    if scan_letter(c) {
        scan_word(s)
        return
    }
    if scan_digit(c) || c == '.' && scan_digit(scan_peek(s, 1)) {
        scan_number(s)?
        return
    }
    if c == '"' || c == '\'' {
        scan_string(s)?
        return
    }
    let pos = scan_pos(s)
    if c >= 0x80 || c < 0x20 || text.index_byte("{{}}[]()<>=;,.-+:/", c) < 0 {
        fail Error.Unexpected(pos, text.quote(s.source[s.at..s.at + 1]), "a token")
    }
    scan_advance(s)
    push(mut s.tokens, Token { kind: TokenKind.Symbol, text: s.source[s.at - 1..s.at], pos, start: s.at - 1, end: s.at })
}

fn scan_block_comment(s: *Scanner) ! Error {
    let pos = scan_pos(s)
    scan_advance(s)
    scan_advance(s)
    for s.at < s.source.len {
        if s.source[s.at] == '*' && scan_peek(s, 1) == '/' {
            scan_advance(s)
            scan_advance(s)
            return
        }
        scan_advance(s)
    }
    fail Error.Unterminated(pos, "comment")
}

fn scan_word(s: *Scanner) {
    let pos = scan_pos(s)
    let start = s.at
    for s.at < s.source.len && (scan_letter(s.source[s.at]) || scan_digit(s.source[s.at])) {
        scan_advance(s)
    }
    push(mut s.tokens, Token { kind: TokenKind.Ident, text: s.source[start..s.at], pos, start, end: s.at })
}

fn scan_number(s: *Scanner) ! Error {
    let pos = scan_pos(s)
    let start = s.at
    var float = false
    if s.source[s.at] == '0' && (scan_peek(s, 1) == 'x' || scan_peek(s, 1) == 'X') {
        scan_advance(s)
        scan_advance(s)
        for s.at < s.source.len && scan_hex_digit(s.source[s.at]) {
            scan_advance(s)
        }
    } else {
        for s.at < s.source.len && scan_digit(s.source[s.at]) {
            scan_advance(s)
        }
        if scan_peek(s, 0) == '.' {
            float = true
            scan_advance(s)
            for s.at < s.source.len && scan_digit(s.source[s.at]) {
                scan_advance(s)
            }
        }
        if scan_peek(s, 0) == 'e' || scan_peek(s, 0) == 'E' {
            float = true
            scan_advance(s)
            if scan_peek(s, 0) == '+' || scan_peek(s, 0) == '-' {
                scan_advance(s)
            }
            for s.at < s.source.len && scan_digit(s.source[s.at]) {
                scan_advance(s)
            }
        }
    }
    if s.at < s.source.len && (scan_letter(s.source[s.at]) || scan_digit(s.source[s.at])) {
        for s.at < s.source.len && (scan_letter(s.source[s.at]) || scan_digit(s.source[s.at])) {
            scan_advance(s)
        }
        fail Error.InvalidNumber(pos, s.source[start..s.at])
    }
    let kind = if float { TokenKind.Float } else { TokenKind.Int }
    push(mut s.tokens, Token { kind, text: s.source[start..s.at], pos, start, end: s.at })
}

fn scan_string(s: *Scanner) ! Error {
    let pos = scan_pos(s)
    let start = s.at
    let quote = s.source[s.at]
    scan_advance(s)
    var out: []u8 = []
    for {
        if s.at >= s.source.len || s.source[s.at] == '\n' {
            fail Error.Unterminated(pos, "string")
        }
        let c = s.source[s.at]
        if c == quote {
            scan_advance(s)
            break
        }
        if c == '\\' {
            scan_escape(s, mut out)?
            continue
        }
        push(mut out, c)
        scan_advance(s)
    }
    push(mut s.tokens, Token { kind: TokenKind.Str, text: str(out), pos, start, end: s.at })
}

fn scan_escape(s: *Scanner, mut out: []u8) ! Error {
    let pos = scan_pos(s)
    scan_advance(s)
    if s.at >= s.source.len {
        fail Error.Unterminated(pos, "string")
    }
    let c = s.source[s.at]
    let simple = match c {
        'a' => 7
        'b' => 8
        'f' => 12
        'n' => 10
        'r' => 13
        't' => 9
        'v' => 11
        '\\' => 92
        '\'' => 39
        '"' => 34
        '?' => 63
        _ => -1
    }
    if simple >= 0 {
        scan_advance(s)
        push(mut out, u8(simple))
        return
    }
    if c >= '0' && c <= '7' {
        var value: u32 = 0
        var digits = 0
        for digits < 3 && scan_peek(s, 0) >= '0' && scan_peek(s, 0) <= '7' {
            value = value * 8 + u32(scan_peek(s, 0) - '0')
            scan_advance(s)
            digits += 1
        }
        if value > 255 {
            fail Error.InvalidEscape(pos)
        }
        push(mut out, u8(value))
        return
    }
    if c == 'x' || c == 'X' {
        scan_advance(s)
        var value: u32 = 0
        var digits = 0
        for digits < 2 && scan_hex_digit(scan_peek(s, 0)) {
            value = value * 16 + scan_hex_value(scan_peek(s, 0))
            scan_advance(s)
            digits += 1
        }
        if digits == 0 {
            fail Error.InvalidEscape(pos)
        }
        push(mut out, u8(value))
        return
    }
    if c == 'u' || c == 'U' {
        scan_advance(s)
        let width = if c == 'u' { 4 } else { 8 }
        var value: u32 = 0
        for _ in 0..width {
            if !scan_hex_digit(scan_peek(s, 0)) {
                fail Error.InvalidEscape(pos)
            }
            value = value * 16 + scan_hex_value(scan_peek(s, 0))
            scan_advance(s)
        }
        if !text.is_scalar(value) {
            fail Error.InvalidEscape(pos)
        }
        text.append_char(mut out, value)
        return
    }
    fail Error.InvalidEscape(pos)
}
