import std/io

/// Where a construct starts in a `.proto` file: the file's path, the line and the column, counting from `1`.
pub struct Pos {
    /// The path the file was given or loaded under.
    pub file: str
    /// The line, from `1`.
    pub line: i64
    /// The column in bytes, from `1`.
    pub column: i64
}

/// The error returned when reading, loading or generating from `.proto` files fails.
pub enum Error {
    /// The next token is not what the grammar allows; `found` is its text, `expected` what could follow.
    Unexpected(at: Pos, found: str, expected: str)
    /// A string or a block comment is not closed; `what` is `string` or `comment`.
    Unterminated(at: Pos, what: str)
    /// A string holds an escape that protobuf does not define.
    InvalidEscape(at: Pos)
    /// A number does not read as an integer or float, or does not fit its type; `text` is its spelling.
    InvalidNumber(at: Pos, text: str)
    /// The `syntax` statement names a language this parser does not read, such as an edition; `name` is the value.
    InvalidSyntax(at: Pos, name: str)
    /// A proto2 `group` field. Groups are not supported.
    Group(at: Pos)
    /// A construct that proto3 does not allow, described by `message`.
    Proto3(at: Pos, message: str)
    /// A field number outside `1` to `536870911` or inside the reserved range `19000` to `19999`.
    FieldNumber(at: Pos, number: i64)
    /// A name or number defined twice in one scope; `kind` says which and `name` is the repeated name or number.
    Duplicate(at: Pos, kind: str, name: str)
    /// A field or enum value that uses a reserved number or name; `name` is the number or name.
    Reserved(at: Pos, name: str)
    /// A construct that is well formed but invalid, described by `message`: a map key of the wrong type, a label on a map or oneof field, an empty oneof.
    Invalid(at: Pos, message: str)
    /// A message or enum type name that no visible definition has.
    UnknownType(at: Pos, name: str)
    /// Messages nest deeper than the parser allows.
    TooDeep(at: Pos)
    /// An imported file is in none of the roots.
    NotFound(path: str)
    /// A file imports itself, directly or through other files.
    Cycle(path: str)
    /// Reading a file failed for a reason other than its absence.
    Read(path: str, failure: io.Error)
}

/// Returns the text of `e`, starting with `file:line:column` for an error that has a position.
pub fn message(e: Error) -> str {
    match e {
        Unexpected(at, found, expected) => "{place(at)}: unexpected {found}, expected {expected}"
        Unterminated(at, what) => "{place(at)}: unterminated {what}"
        InvalidEscape(at) => "{place(at)}: invalid escape sequence"
        InvalidNumber(at, text) => "{place(at)}: invalid number {text}"
        InvalidSyntax(at, name) => "{place(at)}: unsupported syntax {name}"
        Group(at) => "{place(at)}: groups are not supported"
        Proto3(at, message) => "{place(at)}: {message} in proto3"
        FieldNumber(at, number) => "{place(at)}: field number {number} is not allowed"
        Duplicate(at, kind, name) => "{place(at)}: {kind} {name} is defined twice"
        Reserved(at, name) => "{place(at)}: {name} is reserved"
        Invalid(at, message) => "{place(at)}: {message}"
        UnknownType(at, name) => "{place(at)}: unknown type {name}"
        TooDeep(at) => "{place(at)}: messages nest too deeply"
        NotFound(path) => "{path}: file not found"
        Cycle(path) => "{path}: import cycle"
        Read(path, failure) => "{path}: {failure}"
    }
}

fn place(at: Pos) -> str {
    "{at.file}:{at.line}:{at.column}"
}

/// The language version a file declares with `syntax`; a file without the statement is `Proto2`.
pub enum Syntax {
    /// `syntax = "proto2"`.
    Proto2
    /// `syntax = "proto3"`.
    Proto3
}

/// A protobuf scalar type.
pub enum Scalar {
    /// `double`.
    Double
    /// `float`.
    Float
    /// `int32`.
    Int32
    /// `int64`.
    Int64
    /// `uint32`.
    Uint32
    /// `uint64`.
    Uint64
    /// `sint32`.
    Sint32
    /// `sint64`.
    Sint64
    /// `fixed32`.
    Fixed32
    /// `fixed64`.
    Fixed64
    /// `sfixed32`.
    Sfixed32
    /// `sfixed64`.
    Sfixed64
    /// `bool`.
    Bool
    /// `string`.
    String
    /// `bytes`.
    Bytes
}

/// The type of a field, or the value type of a map field.
pub enum TypeRef {
    /// A scalar type.
    Builtin(kind: Scalar)
    /// A message or enum as written in the file; `read_files` replaces it with `Message` or `Enum`.
    Named(name: str)
    /// A message, by its full name: a leading `.`, the package, the enclosing messages and the name, as in `.google.protobuf.Timestamp`.
    Message(name: str)
    /// An enum, by its full name.
    Enum(name: str)
}

/// The type of a field: one value, or a map from a scalar key to a value.
pub enum FieldType {
    /// A field of one type; a repeated field is `Single` with the `Repeated` label.
    Single(of: TypeRef)
    /// A `map<key, value>` field, which is a repeated field of entry messages.
    Map(key: Scalar, value: TypeRef)
}

/// A field label.
pub enum Label {
    /// No label: a proto3 singular field.
    Implicit
    /// `optional`.
    Optional
    /// `required`, proto2 only.
    Required
    /// `repeated`.
    Repeated
}

/// A value on the right of `option` or inside `[...]`.
pub enum Constant {
    /// An identifier, such as an enum value name; `inf` and `nan` are `Float`.
    Ident(name: str)
    /// An integer that fits an `i64`, with its sign.
    Int(value: i64)
    /// An integer above the `i64` maximum.
    Uint(value: u64)
    /// A floating point number.
    Float(value: f64)
    /// A string, with adjacent literals joined and escapes decoded.
    Text(value: str)
    /// `true` or `false`.
    Bool(value: bool)
    /// A `{...}` text-format message, as the source text between the braces.
    Aggregate(text: str)
}

/// An option: its name as written, with a parenthesised extension name kept in its parentheses, as in `(my.ext).field`, and its value.
pub struct Option {
    /// The option name.
    pub name: str
    /// The option value.
    pub value: Constant
    /// Where the option starts.
    pub pos: Pos
}

/// An inclusive range of numbers, as in `reserved 9 to 11` and `extensions 100 to max`.
pub struct Range {
    /// The first number.
    pub first: i64
    /// The last number; a `max` is the largest number the construct allows.
    pub last: i64
}

/// The reserved numbers and names of a message or enum.
pub struct Reserved {
    /// The reserved numbers.
    pub ranges: []Range = []
    /// The reserved names.
    pub names: []str = []
}

/// A field of a message, or a member of a oneof.
pub struct Field {
    /// The field name.
    pub name: str
    /// The field number.
    pub number: i64
    /// The label.
    pub label: Label
    /// The type.
    pub type: FieldType
    /// The name of the oneof the field belongs to, or empty.
    pub oneof: str = ""
    /// The `default` option of a proto2 field.
    pub default: Constant? = none
    /// The `json_name` option, or empty.
    pub json_name: str = ""
    /// Every other option of the field, `packed` and `deprecated` included.
    pub options: []Option = []
    /// Where the field starts.
    pub pos: Pos
}

/// A oneof of a message. Its member fields are in `Message.fields` with `Field.oneof` set to its name.
pub struct Oneof {
    /// The oneof name.
    pub name: str
    /// The options in its body.
    pub options: []Option = []
    /// Where the oneof starts.
    pub pos: Pos
}

/// An `extend` block, which adds fields to the message `target`.
pub struct Extend {
    /// The extended message as written.
    pub target: str
    /// The extension fields.
    pub fields: []*Field = []
    /// Where the block starts.
    pub pos: Pos
}

/// A message definition.
pub struct Message {
    /// The message name.
    pub name: str
    /// The full name: a leading `.`, the package, the enclosing messages and the name. Set by `read_files`.
    pub full_name: str = ""
    /// The fields and oneof members in declaration order.
    pub fields: []*Field = []
    /// The oneofs in declaration order.
    pub oneofs: []Oneof = []
    /// The nested messages.
    pub messages: []*Message = []
    /// The nested enums.
    pub enums: []*Enum = []
    /// The reserved numbers and names.
    pub reserved: Reserved = Reserved {}
    /// The ranges named by `extensions`.
    pub extensions: []Range = []
    /// The `extend` blocks inside the message.
    pub extends: []*Extend = []
    /// The `option` statements in the body.
    pub options: []Option = []
    /// Where the message starts.
    pub pos: Pos
}

/// A value of an enum.
pub struct EnumValue {
    /// The value name.
    pub name: str
    /// The number, which may be negative.
    pub number: i64
    /// The options in `[...]`.
    pub options: []Option = []
    /// Where the value starts.
    pub pos: Pos
}

/// An enum definition.
pub struct Enum {
    /// The enum name.
    pub name: str
    /// The full name, as for `Message.full_name`.
    pub full_name: str = ""
    /// The values in declaration order.
    pub values: []EnumValue = []
    /// The reserved numbers and names.
    pub reserved: Reserved = Reserved {}
    /// Whether `option allow_alias = true` lets two values share a number.
    pub allow_alias: bool = false
    /// The `option` statements in the body.
    pub options: []Option = []
    /// Where the enum starts.
    pub pos: Pos
}

/// A method of a service.
pub struct Method {
    /// The method name.
    pub name: str
    /// The request message: as written after parsing and by full name once resolved.
    pub input: str
    /// The response message, in the same form.
    pub output: str
    /// Whether the request is `stream`.
    pub client_streaming: bool
    /// Whether the response is `stream`.
    pub server_streaming: bool
    /// The options in the method's body.
    pub options: []Option = []
    /// Where the method starts.
    pub pos: Pos
}

/// A service definition.
pub struct Service {
    /// The service name.
    pub name: str
    /// The full name, as for `Message.full_name`.
    pub full_name: str = ""
    /// The methods in declaration order.
    pub methods: []Method = []
    /// The `option` statements in the body.
    pub options: []Option = []
    /// Where the service starts.
    pub pos: Pos
}

/// An `import` statement.
pub struct Import {
    /// The imported path as written.
    pub path: str
    /// Whether it is `import public`.
    pub public: bool
    /// Whether it is `import weak`.
    pub weak: bool
    /// Where the statement starts.
    pub pos: Pos
}

/// A parsed `.proto` file.
pub struct File {
    /// The path the file was given or loaded under.
    pub path: str
    /// The declared syntax.
    pub syntax: Syntax
    /// The package, such as `google.protobuf`, or empty.
    pub package: str = ""
    /// The imports in order.
    pub imports: []Import = []
    /// The file-level `option` statements.
    pub options: []Option = []
    /// The top-level messages.
    pub messages: []*Message = []
    /// The top-level enums.
    pub enums: []*Enum = []
    /// The services.
    pub services: []*Service = []
    /// The top-level `extend` blocks.
    pub extends: []*Extend = []
}

/// A definition found by its full name.
pub enum Definition {
    /// A message.
    Message(*Message)
    /// An enum.
    Enumeration(*Enum)
}

/// A file and the files it needs, loaded and with every type name resolved.
pub struct Set {
    /// The files in dependency order: a file comes after every file it imports.
    pub files: []*File
    /// Every message and enum of every file by full name, with a leading `.`.
    pub types: [str: Definition]
    /// The path of the file that defines each full name in `types`.
    pub owners: [str: str]
}

/// The largest field number, `536870911`.
pub const max_field_number = 536870911
