fn check_seen[T](found: T?) -> bool {
    match found {
        some(_) => true
        none => false
    }
}

fn check_number_allowed(f: *Field) ! Error {
    if f.number < 1 || f.number > max_field_number || f.number >= 19000 && f.number <= 19999 {
        fail Error.FieldNumber(f.pos, f.number)
    }
}

fn check_reserved_number(r: Reserved, number: i64) -> bool {
    for range in r.ranges {
        if number >= range.first && number <= range.last {
            return true
        }
    }
    false
}

fn check_reserved_name(r: Reserved, name: str) -> bool {
    for reserved in r.names {
        if reserved == name {
            return true
        }
    }
    false
}

fn check_field(m: *Message, f: *Field, numbers: [i64: bool], names: [str: bool]) ! Error {
    check_number_allowed(f)?
    if check_reserved_number(m.reserved, f.number) {
        fail Error.Reserved(f.pos, "{f.number}")
    }
    if check_reserved_name(m.reserved, f.name) {
        fail Error.Reserved(f.pos, f.name)
    }
    if check_seen(numbers[f.number]) {
        fail Error.Duplicate(f.pos, "field number", "{f.number}")
    }
    if check_seen(names[f.name]) {
        fail Error.Duplicate(f.pos, "field", f.name)
    }
    for range in m.extensions {
        if f.number >= range.first && f.number <= range.last {
            fail Error.Invalid(f.pos, "field number {f.number} is in an extension range")
        }
    }
    numbers[f.number] = true
    names[f.name] = true
}

fn check_message(m: *Message) ! Error {
    let numbers: [i64: bool] = [:]
    let names: [str: bool] = [:]
    for f in m.fields {
        check_field(m, f, numbers, names)?
    }
    let types: [str: bool] = [:]
    for nested in m.messages {
        if check_seen(types[nested.name]) {
            fail Error.Duplicate(nested.pos, "type", nested.name)
        }
        types[nested.name] = true
    }
    for nested in m.enums {
        if check_seen(types[nested.name]) {
            fail Error.Duplicate(nested.pos, "type", nested.name)
        }
        types[nested.name] = true
    }
    let groups: [str: bool] = [:]
    for g in m.oneofs {
        if check_seen(groups[g.name]) {
            fail Error.Duplicate(g.pos, "oneof", g.name)
        }
        if check_seen(names[g.name]) {
            fail Error.Duplicate(g.pos, "field", g.name)
        }
        groups[g.name] = true
    }
}

fn check_enum(p: *Parser, e: *Enum) ! Error {
    let numbers: [i64: bool] = [:]
    let names: [str: bool] = [:]
    if e.values.len == 0 {
        fail Error.Invalid(e.pos, "an enum needs at least one value")
    }
    if p.syntax == Syntax.Proto3 && e.values.len > 0 && e.values[0].number != 0 {
        fail Error.Proto3(e.values[0].pos, "the first enum value must be zero")
    }
    for v in e.values {
        if check_reserved_number(e.reserved, v.number) {
            fail Error.Reserved(v.pos, "{v.number}")
        }
        if check_reserved_name(e.reserved, v.name) {
            fail Error.Reserved(v.pos, v.name)
        }
        if check_seen(names[v.name]) {
            fail Error.Duplicate(v.pos, "enum value", v.name)
        }
        if check_seen(numbers[v.number]) && !e.allow_alias {
            fail Error.Duplicate(v.pos, "enum number", "{v.number}")
        }
        numbers[v.number] = true
        names[v.name] = true
    }
}

fn check_file(file: *File) ! Error {
    let names: [str: bool] = [:]
    for m in file.messages {
        if check_seen(names[m.name]) {
            fail Error.Duplicate(m.pos, "type", m.name)
        }
        names[m.name] = true
    }
    for e in file.enums {
        if check_seen(names[e.name]) {
            fail Error.Duplicate(e.pos, "type", e.name)
        }
        names[e.name] = true
    }
    for s in file.services {
        if check_seen(names[s.name]) {
            fail Error.Duplicate(s.pos, "type", s.name)
        }
        names[s.name] = true
    }
}
