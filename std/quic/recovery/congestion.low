import std/slices

fn on_acked(r: *Recovery, acked: []Sent) {
    for p in acked {
        if !p.in_flight {
            continue
        }
        r.bytes_in_flight -= p.size
        if r.limited || p.time <= r.recovery_start_time {
            continue
        }
        if r.congestion_window < r.ssthresh {
            r.congestion_window += p.size
        } else {
            grow_avoidance(r, p.size)
        }
    }
}

fn grow_avoidance(r: *Recovery, acked_bytes: i64) {
    r.credit += acked_bytes
    for r.credit >= r.congestion_window {
        r.credit -= r.congestion_window
        r.congestion_window += r.max_datagram_size
    }
}

fn congestion_event(r: *Recovery, sent_time: i64, now: i64) {
    if sent_time <= r.recovery_start_time {
        return
    }
    r.recovery_start_time = now
    r.ssthresh = r.congestion_window / 2
    r.congestion_window = larger(r.ssthresh, minimum_window(r))
    r.credit = 0
}

fn on_lost(r: *Recovery, lost: []Sent, now: i64) {
    var last_loss = -1
    for p in lost {
        if p.in_flight {
            r.bytes_in_flight -= p.size
            last_loss = larger(last_loss, p.time)
        }
    }
    if last_loss >= 0 {
        congestion_event(r, last_loss, now)
    }
    if r.first_rtt_sample < 0 {
        return
    }
    var candidates: []Sent = []
    for p in lost {
        if p.ack_eliciting && p.time > r.first_rtt_sample {
            push(mut candidates, p)
        }
    }
    if persistent_congestion(r, candidates) {
        r.congestion_window = minimum_window(r)
        r.recovery_start_time = -1
        r.credit = 0
        r.reset_min_rtt = true
    }
}

fn persistent_congestion(r: *Recovery, lost: []Sent) -> bool {
    if lost.len < 2 {
        return false
    }
    let duration = (timer_base(r) + r.max_ack_delay) * 3
    var start = lost[0].time
    var previous = start
    for k in 1..lost.len {
        let t = lost[k].time
        if acked_between(r, previous, t) {
            start = t
        }
        if t - start > duration {
            return true
        }
        previous = t
    }
    false
}

fn acked_between(r: *Recovery, earlier: i64, later: i64) -> bool {
    r.acked_times.any(fn(t) t > earlier && t < later)
}
