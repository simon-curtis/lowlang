struct Probe {
    time: i64
    space: i64
}

fn earliest_loss(r: *Recovery) -> i64 {
    var best = -1
    for i in 0..3 {
        let t = r.spaces[i].loss_time
        if t >= 0 && (best < 0 || t < r.spaces[best].loss_time) {
            best = i
        }
    }
    best
}

fn backoff(r: *Recovery) -> i64 {
    1 << smaller(r.pto_count, 20)
}

fn pto_timer(r: *Recovery, now: i64) -> Probe {
    let factor = backoff(r)
    var duration = timer_base(r) * factor
    if total_eliciting(r) == 0 {
        let space = if r.has_handshake_keys { 1 } else { 0 }
        return Probe { time: now + duration, space }
    }
    var best = Probe { time: -1, space: 0 }
    for i in 0..3 {
        if r.spaces[i].eliciting == 0 {
            continue
        }
        if i == 2 {
            if !r.handshake_confirmed {
                return best
            }
            duration += r.max_ack_delay * factor
        }
        let t = r.spaces[i].last_eliciting + duration
        if best.time < 0 || t < best.time {
            best = Probe { time: t, space: i }
        }
    }
    best
}

fn set_timer(r: *Recovery, now: i64) {
    let loss = earliest_loss(r)
    if loss >= 0 {
        r.timer = r.spaces[loss].loss_time
        return
    }
    if r.amplification_blocked {
        r.timer = -1
        return
    }
    if total_eliciting(r) == 0 && validated(r) {
        r.timer = -1
        return
    }
    let pto = pto_timer(r, now)
    r.timer = pto.time
}
