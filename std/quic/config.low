import std/crypto/x509
import std/io
import std/net
import std/tls

/// The settings of a QUIC endpoint and of the connections it creates.
pub struct Config {
    /// The TLS configuration. `alpn` is required. A server also needs `certificates` and `key`.
    pub tls: tls.Config
    /// The idle timeout in milliseconds, after which a connection that has seen no traffic closes. 0 disables it.
    pub idle_timeout: i64 = 30000
    /// How long in milliseconds a handshake may take, until it is confirmed, before the connection is abandoned. A client's handshake is confirmed when the server's HANDSHAKE_DONE arrives. A value of 0 or less uses 10000.
    pub handshake_timeout: i64 = 10000
    /// The milliseconds between PING frames sent while a connection is idle. 0 sends none.
    pub keep_alive: i64 = 0
    /// The connection-level flow control limit, in bytes, advertised for data the peer may send.
    pub max_data: i64 = 16777216
    /// The flow control limit, in bytes, advertised for each stream.
    pub max_stream_data: i64 = 1048576
    /// The number of bidirectional streams the peer may open.
    pub max_streams: i64 = 100
    /// The number of unidirectional streams the peer may open.
    pub max_uni_streams: i64 = 100
    /// Whether a server validates client addresses with a Retry packet before it starts a connection.
    pub retry: bool = false
}

/// A snapshot of the transport counters of a connection.
pub struct Stats {
    /// The smoothed round trip time in nanoseconds.
    pub smoothed_rtt: i64
    /// The smallest round trip time observed, in nanoseconds.
    pub min_rtt: i64
    /// The congestion window in bytes.
    pub congestion_window: i64
    /// The bytes sent that are neither acknowledged nor declared lost.
    pub bytes_in_flight: i64
    /// The number of packets sent.
    pub packets_sent: i64
    /// The number of packets received and accepted.
    pub packets_received: i64
    /// The number of packets declared lost.
    pub packets_lost: i64
    /// The number of times this end has replaced its sending keys, whether it started the key update or followed the peer.
    pub key_updates: i64
}

/// A copyable view of an established QUIC connection.
///
/// Every copy refers to the same connection.
pub struct ConnectionHandle {
    /// The ALPN protocol that was negotiated.
    pub protocol: str
    /// The address of the peer.
    pub remote: net.Addr
    /// The local address of the socket.
    pub local: net.Addr
    /// Whether this end is the server.
    pub server: bool
    /// The named group code of the key exchange.
    pub group: i64
    /// The negotiated cipher suite.
    pub suite: tls.Suite
    /// The certificate chain of the peer, leaf first, and empty when the peer sent none.
    pub peer_certificates: []x509.Certificate
    /// The error code of the CONNECTION_CLOSE that ended the connection, valid once it has closed.
    pub close_code: i64
    /// The reason phrase of the CONNECTION_CLOSE that ended the connection, valid once it has closed.
    pub close_reason: str
    /// Whether the peer sent the CONNECTION_CLOSE, valid once the connection has closed.
    pub closed_by_peer: bool
    /// Whether the CONNECTION_CLOSE was of the application kind rather than the transport kind, valid once the connection has closed.
    pub application_close: bool
    terminal: io.Error?
    gone: chan[bool]
    commands: chan[Command]
    ready: chan[io.Error?]
}

/// A QUIC connection that its owner uses through `handle` and that closes when dropped.
pub struct Connection {
    /// The copyable view of the connection.
    pub handle: *ConnectionHandle
    detached: bool = false
    drop {
        if !detached {
            close_on(handle, 0, "")
        }
    }
}

/// A copyable view of one stream of a QUIC connection.
///
/// Every copy refers to the same stream. Streams are not closed when dropped: `finish` ends the sending side and `reset` and `stop` abandon the sending and receiving sides.
pub struct Stream {
    /// The stream ID, whose two low bits say who opened the stream (0 client, 1 server) and whether it is unidirectional (2).
    pub id: i64
    connection: *ConnectionHandle
}

/// The owner of a listening QUIC endpoint that closes it when dropped.
pub struct Listener {
    /// The copyable view of the listener.
    pub handle: *ListenerHandle
    drop close_listener_on(handle)
}

/// A copyable view of a listening QUIC endpoint.
///
/// Every copy refers to the same endpoint and its closed state.
pub struct ListenerHandle {
    /// The address the endpoint is bound to, with the actual port when port 0 was requested.
    pub addr: net.Addr
    /// The settings the listener was started with, which every accepted connection uses.
    pub config: Config
    endpoint: *Endpoint
}
