import std/crypto/x509
import std/io
import std/quic
import std/text
import std/tls

fn ca_pem() -> str {
    text.join([
        "-----BEGIN CERTIFICATE-----",
        "MIIBlzCCAT2gAwIBAgIUamZw5YUE3N8xyPIk10NvV2jWQ/4wCgYIKoZIzj0EAwIw",
        "GDEWMBQGA1UEAwwNTG93TGFuZ1Rlc3RDQTAgFw0yNjExMTAxNDQ0NTJaGA8yMTI2",
        "MTAxNzE0NDQ1MlowGDEWMBQGA1UEAwwNTG93TGFuZ1Rlc3RDQTBZMBMGByqGSM49",
        "AgEGCCqGSM49AwEHA0IABHm0nRPL/iaBRWIl9mLFeWl1ID9AHnilllsuOThYKxLG",
        "8qytKSYLpAr8cqJK6CYjPJ3ajyj+aH/J5Zj19eVx4O+jYzBhMB0GA1UdDgQWBBQi",
        "vPi+/Yq1XOqQKMDlheU799CEPjAfBgNVHSMEGDAWgBQivPi+/Yq1XOqQKMDlheU7",
        "99CEPjAPBgNVHRMBAf8EBTADAQH/MA4GA1UdDwEB/wQEAwICBDAKBggqhkjOPQQD",
        "AgNIADBFAiEA/edqUY05V9iMBnJnYdMUIGu8xBrkCbJUos18vqfxA44CIA568sqE",
        "GYAp8tJciC/AsO9Sqqh/7aoOvdtHumTHLkRu",
        "-----END CERTIFICATE-----",
    ], "\n")
}

fn server_pem() -> str {
    text.join([
        "-----BEGIN CERTIFICATE-----",
        "MIIBrTCCAVSgAwIBAgIUW+ZhH++PDmOEiX0jnTPIKcLrMpMwCgYIKoZIzj0EAwIw",
        "GDEWMBQGA1UEAwwNTG93TGFuZ1Rlc3RDQTAgFw0yNjExMTAxNDQ0NTJaGA8yMTI2",
        "MTAxNzE0NDQ1MlowFDESMBAGA1UEAwwJbG9jYWxob3N0MFkwEwYHKoZIzj0CAQYI",
        "KoZIzj0DAQcDQgAEgFlpfxCU6WwwpnHhZrQRRbkiezu5mqNaiu+yzTbwgnLXHZES",
        "4dqgbtz6WSPW7ZqNGEmVgvPoHY3raS7aZFpGMaN+MHwwGgYDVR0RBBMwEYIJbG9j",
        "YWxob3N0hwR/AAABMAkGA1UdEwQCMAAwEwYDVR0lBAwwCgYIKwYBBQUHAwEwHQYD",
        "VR0OBBYEFOngIXY415ALyHNMw7bRvopdgjdZMB8GA1UdIwQYMBaAFCK8+L79irVc",
        "6pAowOWF5Tv30IQ+MAoGCCqGSM49BAMCA0cAMEQCIBPuGqxzxpQeMQObaPJbTCLg",
        "wcnqq7Uop0LtreOnkhhbAiAGUBsHDN13VbSGuLphZcJu/grykPrPKjIBgy9K7YnR",
        "+g==",
        "-----END CERTIFICATE-----",
        "-----BEGIN PRIVATE KEY-----",
        "MIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQgiAV0Ac//nP73opk1",
        "UcNpo9/hVU69L6Z8UbyJ1XNAmh2hRANCAASAWWl/EJTpbDCmceFmtBFFuSJ7O7ma",
        "o1qK77LNNvCCctcdkRLh2qBu3PpZI9btmo0YSZWC8+gdjetpLtpkWkYx",
        "-----END PRIVATE KEY-----",
    ], "\n")
}

fn server_config() -> quic.Config ! io.Error {
    let pem = server_pem()
    let secure = tls.Config { certificates: x509.pem_certificates(pem), key: x509.pem_private_key(pem)?, alpn: ["echo"] }
    quic.Config { tls: secure }
}

fn client_config() -> quic.Config {
    var roots: []x509.Certificate = []
    for der in x509.pem_certificates(ca_pem()) {
        let cert = x509.parse(der) or continue
        push(mut roots, cert)
    }
    quic.Config { tls: tls.Config { roots, alpn: ["echo"] } }
}

fn echo(s: quic.Stream) {
    let channel = quic.stream(s)
    let data = io.read_all(channel) or return
    io.write_all(channel, bytes("echo: {str(data)}")) or return
    channel.close()
}

fn serve(h: *quic.ConnectionHandle) {
    for {
        let s = quic.accept_stream_on(h) or return
        spawn echo(s)
    }
}

/// Opens a QUIC connection to a loopback server and sends one message on each of two streams.
fn main() ! io.Error {
    using l = quic.listen("127.0.0.1", 0, server_config()?)?
    using client = quic.dial("127.0.0.1", l.handle.addr.port, client_config())?
    let peer = quic.accept_handle(l.handle)?
    spawn serve(peer)

    for message in ["first", "second"] {
        let s = quic.open_stream(client)?
        let channel = quic.stream(s)
        io.write_str(channel, message)?
        channel.close()
        print("stream {s.id}: {str(io.read_all(channel)?)}")
    }
    quic.close_connection(client, 0, "done")
}
