import std/io

/// The transport parameters of an endpoint (RFC 9000 section 18.2), with the protocol defaults for parameters that are not sent.
pub struct Parameters {
    /// The destination connection ID of the first Initial packet the client sent. Only a server sends it.
    pub original_destination_connection_id: []u8? = none
    /// The idle timeout in milliseconds, where 0 means no timeout. The default is 0.
    pub max_idle_timeout: i64 = 0
    /// The 16-byte stateless reset token for the connection ID the server chose in the handshake. Only a server sends it.
    pub stateless_reset_token: []u8? = none
    /// The largest UDP payload the endpoint accepts, at least 1200. The default is 65527.
    pub max_udp_payload_size: i64 = 65527
    /// The connection-wide limit on data the peer may send. The default is 0.
    pub initial_max_data: i64 = 0
    /// The initial data limit of a bidirectional stream the sender of the parameters opened. The default is 0.
    pub initial_max_stream_data_bidi_local: i64 = 0
    /// The initial data limit of a bidirectional stream the receiver of the parameters opened. The default is 0.
    pub initial_max_stream_data_bidi_remote: i64 = 0
    /// The initial data limit of a unidirectional stream. The default is 0.
    pub initial_max_stream_data_uni: i64 = 0
    /// The initial limit on bidirectional streams the peer may open, at most 2^60. The default is 0.
    pub initial_max_streams_bidi: i64 = 0
    /// The initial limit on unidirectional streams the peer may open, at most 2^60. The default is 0.
    pub initial_max_streams_uni: i64 = 0
    /// The exponent of the ACK delay unit, which is 2^exponent microseconds, at most 20. The default is 3.
    pub ack_delay_exponent: i64 = 3
    /// The longest delay in milliseconds before the endpoint acknowledges a packet, below 2^14. The default is 25.
    pub max_ack_delay: i64 = 25
    /// Whether the endpoint does not support connection migration. The default is false.
    pub disable_active_migration: bool = false
    /// The raw value of the preferred address parameter, which only a server sends: an IPv4 address and port, an IPv6 address and port, a connection ID and a stateless reset token.
    pub preferred_address: []u8? = none
    /// The most connection IDs the endpoint can store, at least 2. The default is 2.
    pub active_connection_id_limit: i64 = 2
    /// The source connection ID the endpoint put in its first Initial packet.
    pub initial_source_connection_id: []u8? = none
    /// The source connection ID of the Retry packet the server sent. Only a server that sent a Retry sends it.
    pub retry_source_connection_id: []u8? = none
}

fn put_parameter(mut out: []u8, id: i64, body: []u8) {
    put_varint(mut out, id)
    put_varint(mut out, body.len)
    io.append(mut out, body)
}

fn put_integer(mut out: []u8, id: i64, v: i64) {
    put_varint(mut out, id)
    put_varint(mut out, varint_size(v))
    put_varint(mut out, v)
}

fn put_optional(mut out: []u8, id: i64, body: []u8?) {
    match body {
        some(b) => put_parameter(mut out, id, b)
        none => {}
    }
}

/// Returns the extension body for `p`, the value of TLS extension `quic_transport_parameters` (RFC 9000 section 18).
///
/// Parameters equal to their default are omitted, and so are connection IDs and tokens that are `none`. Parameters appear in order of their identifiers. Panics when an integer is negative or above 2^62 - 1.
pub fn encode_parameters(p: Parameters) -> []u8 {
    var out: []u8 = []
    put_optional(mut out, 0x00, p.original_destination_connection_id)
    if p.max_idle_timeout != 0 {
        put_integer(mut out, 0x01, p.max_idle_timeout)
    }
    put_optional(mut out, 0x02, p.stateless_reset_token)
    if p.max_udp_payload_size != 65527 {
        put_integer(mut out, 0x03, p.max_udp_payload_size)
    }
    if p.initial_max_data != 0 {
        put_integer(mut out, 0x04, p.initial_max_data)
    }
    if p.initial_max_stream_data_bidi_local != 0 {
        put_integer(mut out, 0x05, p.initial_max_stream_data_bidi_local)
    }
    if p.initial_max_stream_data_bidi_remote != 0 {
        put_integer(mut out, 0x06, p.initial_max_stream_data_bidi_remote)
    }
    if p.initial_max_stream_data_uni != 0 {
        put_integer(mut out, 0x07, p.initial_max_stream_data_uni)
    }
    if p.initial_max_streams_bidi != 0 {
        put_integer(mut out, 0x08, p.initial_max_streams_bidi)
    }
    if p.initial_max_streams_uni != 0 {
        put_integer(mut out, 0x09, p.initial_max_streams_uni)
    }
    if p.ack_delay_exponent != 3 {
        put_integer(mut out, 0x0a, p.ack_delay_exponent)
    }
    if p.max_ack_delay != 25 {
        put_integer(mut out, 0x0b, p.max_ack_delay)
    }
    if p.disable_active_migration {
        let empty: []u8 = []
        put_parameter(mut out, 0x0c, empty)
    }
    put_optional(mut out, 0x0d, p.preferred_address)
    if p.active_connection_id_limit != 2 {
        put_integer(mut out, 0x0e, p.active_connection_id_limit)
    }
    put_optional(mut out, 0x0f, p.initial_source_connection_id)
    put_optional(mut out, 0x10, p.retry_source_connection_id)
    out
}

fn integer_of(body: []u8) -> i64 ! io.Error {
    let c = cursor(body)
    let v = varint(c)?
    if left(c) != 0 {
        fail Malformed
    }
    v
}

fn connection_id_of(body: []u8) -> []u8 ! io.Error {
    if body.len > 20 {
        fail Malformed
    }
    body
}

fn preferred_address_of(body: []u8) -> []u8 ! io.Error {
    if body.len < 25 {
        fail Malformed
    }
    let id_length = i64(body[24])
    if id_length < 1 || id_length > 20 || body.len != 25 + id_length + 16 {
        fail Malformed
    }
    body
}

fn apply_parameter(mut p: Parameters, id: i64, body: []u8) ! io.Error {
    match id {
        0x00 => {
            p.original_destination_connection_id = connection_id_of(body)?
        }
        0x01 => {
            p.max_idle_timeout = integer_of(body)?
        }
        0x02 => {
            if body.len != 16 {
                fail Malformed
            }
            p.stateless_reset_token = body
        }
        0x03 => {
            let v = integer_of(body)?
            if v < 1200 {
                fail Malformed
            }
            p.max_udp_payload_size = v
        }
        0x04 => {
            p.initial_max_data = integer_of(body)?
        }
        0x05 => {
            p.initial_max_stream_data_bidi_local = integer_of(body)?
        }
        0x06 => {
            p.initial_max_stream_data_bidi_remote = integer_of(body)?
        }
        0x07 => {
            p.initial_max_stream_data_uni = integer_of(body)?
        }
        0x08 => {
            let v = integer_of(body)?
            if v > 1152921504606846976 {
                fail Malformed
            }
            p.initial_max_streams_bidi = v
        }
        0x09 => {
            let v = integer_of(body)?
            if v > 1152921504606846976 {
                fail Malformed
            }
            p.initial_max_streams_uni = v
        }
        0x0a => {
            let v = integer_of(body)?
            if v > 20 {
                fail Malformed
            }
            p.ack_delay_exponent = v
        }
        0x0b => {
            let v = integer_of(body)?
            if v >= 16384 {
                fail Malformed
            }
            p.max_ack_delay = v
        }
        0x0c => {
            if body.len != 0 {
                fail Malformed
            }
            p.disable_active_migration = true
        }
        0x0d => {
            p.preferred_address = preferred_address_of(body)?
        }
        0x0e => {
            let v = integer_of(body)?
            if v < 2 {
                fail Malformed
            }
            p.active_connection_id_limit = v
        }
        0x0f => {
            p.initial_source_connection_id = connection_id_of(body)?
        }
        0x10 => {
            p.retry_source_connection_id = connection_id_of(body)?
        }
        _ => {}
    }
}

/// Parses the body of a `quic_transport_parameters` extension.
///
/// Parameters with unknown identifiers, including the reserved `31 * N + 27` ones, are ignored. Fails with `Malformed` for a truncated parameter, a duplicate identifier, an integer whose length does not match its encoding, `max_udp_payload_size` below 1200, `ack_delay_exponent` above 20, `max_ack_delay` of 2^14 or more, `active_connection_id_limit` below 2, either `initial_max_streams` above 2^60, a `stateless_reset_token` that is not 16 bytes, a connection ID above 20 bytes, a `disable_active_migration` with a value or a `preferred_address` that is not laid out as RFC 9000 section 18.2 gives. A connection maps `Malformed` to TRANSPORT_PARAMETER_ERROR. Byte slices in the result share `raw`.
pub fn decode_parameters(raw: []u8) -> Parameters ! io.Error {
    let c = cursor(raw)
    var p = Parameters {}
    var seen: [i64: bool] = [:]
    for left(c) > 0 {
        let id = varint(c)?
        let length = varint(c)?
        let body = take(c, length)?
        if seen[id] ?? false {
            fail Malformed
        }
        seen[id] = true
        apply_parameter(mut p, id, body)?
    }
    p
}
