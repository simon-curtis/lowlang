import std/io
import paths = std/path
import std/slices
import std/sys
import std/text

/// A directory entry returned by `read_dir_info`.
///
/// The kind flags describe the entry itself without following symbolic links. An entry that is none of `dir`, `link` and `regular` is another kind, such as a socket or device.
pub struct Entry {
    /// The entry's name within its directory.
    pub name: str
    /// Whether the entry is a directory.
    pub dir: bool
    /// Whether the entry is a symbolic link, even when it points to a directory.
    pub link: bool
    /// Whether the entry is a regular file.
    pub regular: bool
}

/// What `walk` does after a visit callback returns.
pub enum Step {
    /// Carries on, descending into the entry when it is a directory.
    Continue
    /// Does not descend into the entry; the walk carries on with its siblings.
    Skip
    /// Ends the walk; `walk` returns without an error.
    Stop
}

/// An entry reached by `walk`.
pub struct Visit {
    /// The path, made of the walk's root and the names down to this entry.
    pub path: str
    /// The name within the parent directory; for the root it is the last component of the root path.
    pub name: str
    /// The number of directories between the root and this entry, `0` for the root.
    pub depth: i64
    /// Whether the entry is a directory.
    pub dir: bool
    /// Whether the entry is a symbolic link; `walk` does not follow it.
    pub link: bool
    /// Whether the entry is a regular file.
    pub regular: bool
}

fn entry_of(dir: str, found: sys.DirEntry) -> Entry ! io.Error {
    let kind = found.kind ?? lstat_kind(child_path(dir, found.name))?
    Entry {
        name: found.name
        dir: kind == sys.Kind.Dir
        link: kind == sys.Kind.Symlink
        regular: kind == sys.Kind.Regular
    }
}

fn lstat_kind(path: str) -> sys.Kind ! io.Error {
    let st = sys.stat(path, false)?
    st.kind
}

/// Returns the entries of the directory `path`, without `.` and `..`.
///
/// The entries are in the order the file system returns them, not sorted. The kind comes from the directory record, or from `lstat` when the file system does not provide one. Fails with `NotFound` when `path` does not exist and `NotDir` when it is not a directory.
pub fn read_dir_info(path: str) -> []Entry ! io.Error {
    var entries: []Entry = []
    for found in sys.list_dir(path)? {
        let entry = entry_of(path, found)?
        push(mut entries, entry)
    }
    entries
}

fn sorted_entries(path: str) -> []Entry ! io.Error {
    var entries = read_dir_info(path)?
    slices.sort_by(mut entries, fn(a: Entry, b: Entry) -> bool { a.name < b.name })
    entries
}

fn walk_visit(v: Visit, visit: fn(Visit) -> Step) -> bool ! io.Error {
    let step = visit(v)
    match step {
        Stop => return false
        Skip => return true
        Continue => {}
    }
    if !v.dir {
        return true
    }
    for entry in sorted_entries(v.path)? {
        let child = Visit {
            path: child_path(v.path, entry.name)
            name: entry.name
            depth: v.depth + 1
            dir: entry.dir
            link: entry.link
            regular: entry.regular
        }
        let more = walk_visit(child, visit)?
        if !more {
            return false
        }
    }
    true
}

/// Calls `visit` for `root` and everything below it, depth first, with the entries of each directory in name order.
///
/// `visit` runs for a directory before its entries and its result decides whether to continue, skip the directory or stop; see `Step`. Symbolic links are reported and never followed, including a link at `root`. Fails with the error of `lstat` on `root` or of reading a directory.
pub fn walk(root: str, visit: fn(Visit) -> Step) ! io.Error {
    let meta = lstat(root)?
    let first = Visit { path: root, name: paths.base(root), depth: 0, dir: meta.dir, link: meta.link, regular: meta.regular }
    walk_visit(first, visit)?
}

fn has_meta(segment: str) -> bool {
    for i in 0..segment.len {
        let c = segment[i]
        if c == '*' || c == '?' || c == '[' || c == '\\' {
            return true
        }
    }
    false
}

fn entries_or_empty(base: str) -> []Entry {
    let dir = if base.len == 0 { "." } else { base }
    sorted_entries(dir) or []
}

fn glob_deep(base: str, segments: []str, index: i64, mut out: []str) {
    let last = index + 1 == segments.len
    if !last {
        glob_into(base, segments, index + 1, mut out)
    }
    for entry in entries_or_empty(base) {
        let next = child_path(base, entry.name)
        if last {
            push(mut out, next)
        }
        if entry.dir {
            glob_deep(next, segments, index, mut out)
        }
    }
}

fn glob_into(base: str, segments: []str, index: i64, mut out: []str) {
    if index == segments.len {
        if base.len > 0 {
            push(mut out, base)
        }
        return
    }
    let segment = segments[index]
    if segment == "**" {
        glob_deep(base, segments, index, mut out)
        return
    }
    if !has_meta(segment) {
        let next = child_path(base, segment)
        if lexists(next) {
            glob_into(next, segments, index + 1, mut out)
        }
        return
    }
    for entry in entries_or_empty(base) {
        if paths.matches(segment, entry.name) {
            glob_into(child_path(base, entry.name), segments, index + 1, mut out)
        }
    }
}

fn distinct(sorted: []str) -> []str {
    var out: []str = []
    for item in sorted {
        if out.len == 0 || out[out.len - 1] != item {
            push(mut out, item)
        }
    }
    out
}

/// Returns the paths that match the glob `pattern`, sorted and without duplicates.
///
/// Each `/`-separated segment is matched against directory entry names with `path.matches`, so `*`, `?`, `[...]` and `\` work and no segment treats a leading `.` specially. A segment `**` matches any number of nested directories, none included, and as the last segment matches every entry below. Symbolic links are not descended through `**`.
///
/// A relative pattern gives relative paths and an absolute one gives absolute paths. Unreadable directories contribute nothing, so a pattern with no match gives an empty slice, not an error.
pub fn glob(pattern: str) -> []str {
    var segments: []str = []
    for part in text.split(pattern, '/') {
        if part.len > 0 {
            push(mut segments, part)
        }
    }
    var found: []str = []
    let start = if paths.is_absolute(pattern) { "/" } else { "" }
    glob_into(start, segments, 0, mut found)
    slices.sort(mut found)
    distinct(found)
}
