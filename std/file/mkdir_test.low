import std/testing

fn test_mkdir_all_creates_every_missing_parent(t: *testing.T) {
    let base = temp_dir("mkdir-all") or panic("temp dir")
    let target = "{base}/a/b/c"
    mkdir_all(target) or panic("mkdir_all")
    testing.error_if(t, !is_dir("{base}/a/b"), "the middle directory is missing")
    testing.error_if(t, !is_dir(target), "the last directory is missing")
    mkdir_all(target) or panic("mkdir_all again")
    remove_all(base) or panic("remove")
}

fn test_mkdir_all_fails_below_a_file(t: *testing.T) {
    let base = temp_dir("mkdir-all-file") or panic("temp dir")
    write_text("{base}/plain", "x") or panic("write")
    var failed = false
    mkdir_all("{base}/plain/inner") catch {
        _ => { failed = true }
    }
    testing.error_if(t, !failed, "a directory was created below a file")
    remove_all(base) or panic("remove")
}

fn test_child_path_adds_one_separator(t: *testing.T) {
    t.equal(child_path("a", "b"), "a/b")
    t.equal(child_path("a/", "b"), "a/b")
    t.equal(child_path("", "b"), "b")
    t.equal(child_path("a", ""), "a")
}
