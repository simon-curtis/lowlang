import std/file
import std/io
import std/text

fn save(dir: str, name: str, body: str) ! io.Error {
    using var staged = file.temp_file(dir, "{name}.*.tmp")?
    file.write_str(staged.file, body)?
    file.sync(staged.file)?
    let path = file.keep(mut staged)
    file.rename(path, "{dir}/{name}")?
}

fn append_line(path: str, line: str) -> i64 ! io.Error {
    using log = file.append(path)?
    file.write_str(log, line)?
    file.info(log)?.size
}

fn tail(path: str, count: i64) -> str ! io.Error {
    using reader = file.open(path)?
    file.seek(reader, -count, file.Whence.End)?
    let buf = io.buffer(count)
    let n = file.read(reader, buf)?
    text.trim(str(buf[..n]))
}

/// Replaces a file by writing a temporary file beside it and renaming it into place, then appends to it and reads its tail back through a seek.
fn main() ! io.Error {
    let dir = file.temp_dir("save-")?
    let path = "{dir}/settings.conf"
    save(dir, "settings.conf", "colour=red\n")?
    save(dir, "settings.conf", "colour=blue\nsize=large\n")?

    let current = file.read_text(path)?
    print("settings: {text.lines(current).len} lines")
    print("entries: {file.list(dir)?}")

    let size = append_line(path, "mode=dark\n")?
    print("size after append: {size}")
    print("tail: {tail(path, 10)?}")

    file.remove_all(dir)?
}
