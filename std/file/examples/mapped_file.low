import std/file
import std/io
import std/text

fn stamp(path: str) ! io.Error {
    using f = file.update(path)?
    using page = file.map(f, file.MapMode.Shared, 0, 0)?
    let header = bytes("MAPPED")
    io.copy(page.data, header)
    file.sync_map(page, file.Flush.Wait)?
}

fn draft(path: str) ! io.Error {
    using f = file.open(path)?
    using copy = file.map(f, file.MapMode.Private, 0, 0)?
    io.copy(copy.data, bytes("DRAFT!"))
    print("private view: {str(copy.data[..6])}")
}

fn window(path: str) ! io.Error {
    using f = file.open(path)?
    using part = file.map(f, file.MapMode.ReadOnly, 6, 5)?
    file.advise_map(part, file.Advice.WillNeed)?
    print("window: {str(part.data)}")
}

/// Edits a file through a shared mapping, shows that a private mapping never reaches the file, and maps a byte range that does not start on a page boundary.
fn main() ! io.Error {
    let dir = file.temp_dir("mapped-")?
    let path = "{dir}/notes.txt"
    file.write_text(path, "hello world, mapped\n")?

    stamp(path)?
    print("file after shared write: {text.trim(file.read_text(path)?)}")
    draft(path)?
    print("file after private write: {text.trim(file.read_text(path)?)}")
    window(path)?

    using scratch = file.map_anonymous(file.MapMode.Private, 4096)?
    scratch.data[0] = 42
    print("anonymous: {scratch.data.len} bytes, first {scratch.data[0]}, last {scratch.data[4095]}")

    file.remove_all(dir)?
}
