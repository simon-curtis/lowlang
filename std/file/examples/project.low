import std/file
import std/io
import std/os
import std/text

fn relative(root: str, path: str) -> str {
    text.trim_prefix(text.trim_prefix(path, root), "/")
}

fn list_tree(root: str) ! io.Error {
    file.walk(root, fn(v: file.Visit) -> file.Step {
        if v.depth == 0 {
            return file.Step.Continue
        }
        if v.dir && v.name == "build" {
            return file.Step.Skip
        }
        let suffix = if v.dir { "/" } else { "" }
        print("{relative(root, v.path)}{suffix}")
        file.Step.Continue
    })?
}

/// Scaffolds a project in a temporary directory, clones it, walks it past `build`, matches sources with a relative glob and removes both trees.
fn main() ! io.Error {
    let root = file.temp_dir("project-")?
    let source = "{root}/app"
    file.mkdir_all("{source}/src/util")?
    file.mkdir_all("{source}/build")?
    file.write_text("{source}/README.md", "# app\n")?
    file.write_text("{source}/src/main.low", "main\n")?
    file.write_text("{source}/src/util/strings.low", "shout\n")?
    file.write_text("{source}/build/app.bin", "binary")?

    let clone = "{root}/clone"
    file.copy_dir(source, clone)?
    print("clone is a directory: {file.is_dir(clone)}")
    let readme = file.read_text("{clone}/README.md")?
    print("copied README: {readme.len} bytes")

    list_tree(clone)?

    let home = os.getcwd()?
    os.chdir(clone)?
    for path in file.glob("src/**/*.low") {
        print("source: {path}")
    }
    os.chdir(home)?

    file.remove_all(root)?
    print("removed: {!file.exists(root)}")
}
