import std/io
import std/testing

fn failure(base: str, read: fn(str) ! io.Error) -> str {
    read(base) catch {
        IsDir => return "IsDir"
        e => return "{e}"
    }
    "no error"
}

fn test_reading_a_directory_fails_with_is_dir(t: *testing.T) {
    let base = temp_dir("read-dir") or panic("temp dir")
    t.equal(failure(base, fn(p) { read_text(p)? }), "IsDir")
    t.equal(failure(base, fn(p) { read_file(p)? }), "IsDir")
    t.equal(failure(base, fn(p) {
        using f = open(p)?
        read(f, io.buffer(16))?
    }), "IsDir")
    remove_all(base) or panic("remove")
}
