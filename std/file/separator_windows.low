import std/text

fn is_separator(c: u8) -> bool {
    c == '/' || c == '\\'
}

fn is_drive(path: str, at: i64) -> bool {
    if at + 2 > path.len || path[at + 1] != ':' {
        return false
    }
    let letter = path[at] | 0x20
    letter >= 'a' && letter <= 'z'
}

fn component_end(path: str, from: i64) -> i64 {
    var end = from
    for end < path.len && !is_separator(path[end]) {
        end += 1
    }
    end
}

fn drive_root(path: str, at: i64) -> i64 {
    let end = at + 2
    if end < path.len && is_separator(path[end]) {
        return end + 1
    }
    end
}

fn unc_root(path: str, at: i64) -> i64 {
    let server = component_end(path, at)
    if server >= path.len {
        return path.len
    }
    let share = component_end(path, server + 1)
    if share < path.len {
        return share + 1
    }
    share
}

fn verbatim_root(path: str) -> i64 {
    if is_drive(path, 4) {
        return drive_root(path, 4)
    }
    if path.len >= 8 && is_separator(path[7]) && text.equal_fold(path[4..7], "UNC") {
        return unc_root(path, 8)
    }
    4
}

fn root_length(path: str) -> i64 {
    if path.len >= 2 && is_separator(path[0]) && is_separator(path[1]) {
        let marker = path.len >= 4 && (path[2] == '?' || path[2] == '.') && is_separator(path[3])
        if marker {
            return verbatim_root(path)
        }
        return unc_root(path, 2)
    }
    if is_drive(path, 0) {
        return drive_root(path, 0)
    }
    if path.len > 0 && is_separator(path[0]) {
        return 1
    }
    0
}
