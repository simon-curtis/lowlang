import std/testing
import std/text

struct RootCase {
    path: str
    want: i64
}

fn root_case_name(c: RootCase) -> str {
    text.quote(c.path)
}

fn test_root_length_skips_drive_and_share_prefixes(t: *testing.T) {
    let cases = [
        RootCase { path: "", want: 0 }
        RootCase { path: "a\\b", want: 0 }
        RootCase { path: "\\a", want: 1 }
        RootCase { path: "/a", want: 1 }
        RootCase { path: "C:", want: 2 }
        RootCase { path: "C:\\", want: 3 }
        RootCase { path: "c:/a", want: 3 }
        RootCase { path: "C:a", want: 2 }
        RootCase { path: "1:\\a", want: 0 }
        RootCase { path: "\\\\server", want: 8 }
        RootCase { path: "\\\\server\\share", want: 14 }
        RootCase { path: "\\\\server\\share\\a\\b", want: 15 }
        RootCase { path: "//server/share/a", want: 15 }
        RootCase { path: "\\\\?\\C:\\a", want: 7 }
        RootCase { path: "\\\\?\\UNC\\server\\share\\a", want: 21 }
        RootCase { path: "\\\\.\\pipe", want: 4 }
    ]
    t.table_of(cases, root_case_name, fn(st, c) {
        st.equal(root_length(c.path), c.want)
    })
}

fn test_mkdir_all_splits_on_backslash(t: *testing.T) {
    let base = temp_dir("mkdir-all-backslash") or panic("temp dir")
    let native = text.replace(base, "/", "\\")
    let target = "{native}\\outer\\inner"
    mkdir_all(target) or panic("mkdir_all")
    testing.error_if(t, !is_dir("{native}\\outer"), "the outer directory is missing")
    testing.error_if(t, !is_dir(target), "the inner directory is missing")
    remove_all(base) or panic("remove")
}

fn test_child_path_keeps_a_trailing_backslash(t: *testing.T) {
    t.equal(child_path("a\\", "b"), "a\\b")
    t.equal(child_path("a", "b"), "a/b")
}

fn test_temp_pattern_rejects_backslash(t: *testing.T) {
    let made = temp_dir_pattern("", "a\\b*") catch {
        _ => ""
    }
    testing.error_if(t, made.len > 0, "a pattern with a backslash was accepted")
}
