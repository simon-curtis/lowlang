import std/bson
import std/text

fn order_document(id: str, sku: str, quantity: i32) -> []bson.Field {
    let oid = bson.parse_object_id(id) or bson.Value.Null
    [
        bson.Field { name: "_id", value: oid },
        bson.Field { name: "sku", value: bson.Value.Str(sku) },
        bson.Field { name: "quantity", value: bson.Value.Int32(quantity) },
        bson.Field { name: "tags", value: bson.Value.Array([bson.Value.Str("gift"), bson.Value.Bool(true)]) },
        bson.Field { name: "shipping", value: bson.Value.Document([
            bson.Field { name: "city", value: bson.Value.Str("Leeds") },
            bson.Field { name: "weight", value: bson.Value.Double(1.5) },
        ]) },
    ]
}

fn report(e: bson.Error) {
    print(bson.message(e))
}

fn attempt(data: []u8) {
    let fields = bson.decode(data) catch {
        e => {
            report(e)
            return
        }
    }
    print("decoded {fields.len} fields")
}

/// Encodes two orders back to back, reads them from the byte stream one document at a time, and decodes damaged input.
fn main() {
    let first_order = order_document("507f1f77bcf86cd799439011", "A-100", 3)
    let second_order = order_document("507f1f77bcf86cd799439012", "B-205", 12)
    let first = bson.encode(first_order) or bytes("")
    let second = bson.encode(second_order) or bytes("")
    print("{first.len} and {second.len} bytes")
    print(text.encode_hex(first[..21]))

    var stream: []u8 = []
    for b in first {
        push(mut stream, b)
    }
    for b in second {
        push(mut stream, b)
    }

    var rest = stream
    for rest.len > 0 {
        let item = bson.decode_first(rest, bson.Options {}) catch {
            e => {
                report(e)
                return
            }
        }
        print(bson.diagnostic(item.fields))
        let sku = bson.get(item.fields, "sku") ?? bson.Value.Null
        match sku {
            Str(s) => print("sku {s}")
            _ => print("no sku")
        }
        rest = rest[item.length..]
    }

    attempt(stream)
    attempt(first[..40])
    let bad_bool = text.decode_hex("0900000008620002000000") or bytes("")
    attempt(bad_bool)
}
