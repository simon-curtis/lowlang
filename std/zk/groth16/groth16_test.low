import std/crypto/pairing
import std/testing

fn cube_circuit(c: *pairing.Curve, x: u64) -> *Builder {
    let b = builder(c)
    let out = b.input([x * x * x + x + 5])
    let w = b.secret([x])
    let square = b.product(w, w)
    let cube = b.product(square, w)
    b.constrain([b.term(cube), b.term(w), b.scaled(one(), 5)], [b.term(one())], [b.term(out)])
    b
}

fn test_round_trip(t: *testing.T) {
    for c in [pairing.bn254(), pairing.bls12_381()] {
        let b = cube_circuit(c, 3)
        let s = b.system()
        let pk = setup(c, s) or return t.fatal("setup")
        let proof = prove(c, pk, s, b.assignment()) or return t.fatal("prove")
        t.is_true(verify(c, pk.verifying, b.inputs_of(), proof))
        t.is_false(verify(c, pk.verifying, [[36]], proof))
    }
}
