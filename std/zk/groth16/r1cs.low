import std/crypto/nistec
import std/crypto/pairing

/// A variable of a constraint system: the constant one, a public input or a private value of the witness.
pub struct Variable {
    public: bool
    at: i64
}

/// A variable times a coefficient of the scalar field, one term of a linear combination.
pub struct Term {
    variable: Variable
    coefficient: u64[]
}

struct Entry {
    at: i64
    coefficient: u64[]
}

struct Row {
    a: Entry[]
    b: Entry[]
    c: Entry[]
}

struct Pending {
    a: Term[]
    b: Term[]
    c: Term[]
}

/// A rank-1 constraint system: rows `<a, z> <b, z> = <c, z>` over the assignment `z`, which holds the constant one, then the public inputs, then the private values.
pub struct System {
    /// The number of public inputs, not counting the constant one.
    pub inputs: i64
    /// The number of variables, counting the constant one.
    pub variables: i64
    rows: Row[]
}

/// Records the constraints of a circuit together with the values of its variables, so one pass over the circuit gives both the system and the assignment that satisfies it.
///
/// The values are kept in Montgomery form and converted with constant-time field arithmetic. To build only the system, for `setup`, give every variable a value such as zero.
pub struct Builder {
    curve: *pairing.Curve
    inputs: u64[][]
    witness: u64[][]
    pending: Pending[]
}

/// Returns an empty builder over the scalar field of `c`.
pub fn builder(c: *pairing.Curve) -> *Builder {
    new(Builder { curve: c, inputs: [c.fr.one], witness: [], pending: [] })
}

/// Returns the constant one, the variable at index zero of every assignment.
pub fn one() -> Variable {
    Variable { public: true, at: 0 }
}

fn montgomery(f: *nistec.Field, value: u64[]) -> u64[] {
    let out = nistec.element(f)
    __memmove(out, value)
    nistec.to_mont(f, out, out)
    out
}

/// Adds a public input with the plain integer `value`, least significant limb first, below the group order `r`.
///
/// Public inputs take the indices after the constant one in the order they are added, whatever order they are mixed with private values in.
pub fn input(b: *Builder, value: u64[]) -> Variable {
    b.inputs.push(montgomery(b.curve.fr, value))
    Variable { public: true, at: b.inputs.len - 1 }
}

/// Adds a private value of the witness, the plain integer `value`, least significant limb first, below the group order `r`.
pub fn secret(b: *Builder, value: u64[]) -> Variable {
    b.witness.push(montgomery(b.curve.fr, value))
    Variable { public: false, at: b.witness.len - 1 }
}

/// Returns the term `1 v`.
pub fn term(b: *Builder, v: Variable) -> Term {
    Term { variable: v, coefficient: b.curve.fr.one }
}

/// Returns the term `k v` for a small signed coefficient `k`.
pub fn scaled(b: *Builder, v: Variable, k: i64) -> Term {
    let f = b.curve.fr
    let magnitude = nistec.element(f)
    magnitude[0] = if k < 0 { u64(0 - k) } else { u64(k) }
    let out = montgomery(f, magnitude)
    if k < 0 {
        nistec.sub(f, out, nistec.element(f), out)
    }
    Term { variable: v, coefficient: out }
}

/// Adds the constraint `<a, z> <bs, z> = <cs, z>`, each side a linear combination of terms; an empty slice is zero.
pub fn constrain(b: *Builder, a: Term[], bs: Term[], cs: Term[]) {
    b.pending.push(Pending { a, b: bs, c: cs })
}

fn value_of(b: *Builder, v: Variable) -> u64[] {
    if v.public { b.inputs[v.at] } else { b.witness[v.at] }
}

/// Adds a private value holding `x y` and the constraint that says so, and returns it.
pub fn product(b: *Builder, x: Variable, y: Variable) -> Variable {
    let f = b.curve.fr
    let z = nistec.element(f)
    nistec.mul(f, z, value_of(b, x), value_of(b, y))
    b.witness.push(z)
    let out = Variable { public: false, at: b.witness.len - 1 }
    constrain(b, [term(b, x)], [term(b, y)], [term(b, out)])
    out
}

fn index_of(b: *Builder, v: Variable) -> i64 {
    if v.public { v.at } else { b.inputs.len + v.at }
}

fn entries(b: *Builder, terms: Term[]) -> Entry[] {
    var out: Entry[] = []
    for t in terms {
        out.push(Entry { at: index_of(b, t.variable), coefficient: t.coefficient })
    }
    out
}

/// Returns the constraint system recorded so far.
pub fn system(b: *Builder) -> System {
    var rows: Row[] = []
    for p in b.pending {
        rows.push(Row { a: entries(b, p.a), b: entries(b, p.b), c: entries(b, p.c) })
    }
    System { inputs: b.inputs.len - 1, variables: b.inputs.len + b.witness.len, rows }
}

/// Returns the assignment recorded so far as plain integers in the order of the system: the constant one, the public inputs, then the private values.
pub fn assignment(b: *Builder) -> u64[][] {
    let f = b.curve.fr
    var out: u64[][] = []
    for v in b.inputs {
        let plain = nistec.element(f)
        nistec.from_mont(f, plain, v)
        out.push(plain)
    }
    for v in b.witness {
        let plain = nistec.element(f)
        nistec.from_mont(f, plain, v)
        out.push(plain)
    }
    out
}

/// Returns the public inputs recorded so far as plain integers, without the constant one, as `verify` takes them.
pub fn inputs_of(b: *Builder) -> u64[][] {
    assignment(b)[1..b.inputs.len]
}
