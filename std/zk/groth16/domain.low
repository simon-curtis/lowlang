import std/crypto/limb
import std/crypto/nistec

struct Domain {
    size: i64
    log: i64
    root: u64[]
    root_inverse: u64[]
    size_inverse: u64[]
    shift: u64[]
}

fn small(f: *nistec.Field, value: u64) -> u64[] {
    let out = nistec.element(f)
    out[0] = value
    nistec.to_mont(f, out, out)
    out
}

fn shifted_right(a: u64[], bits: i64) -> u64[] {
    let out: u64[] = __make(a.len)
    for i in 0..a.len {
        let word = i + bits / 64
        let shift = bits % 64
        if word < a.len {
            out[i] = a[word] >> shift
            if shift > 0 && word + 1 < a.len {
                out[i] |= a[word + 1] << (64 - shift)
            }
        }
    }
    out
}

fn two_adicity(m: u64[]) -> i64 {
    var bits = 1
    for (m[bits / 64] >> (bits % 64)) & 1 == 0 {
        bits += 1
    }
    bits
}

fn is_residue(f: *nistec.Field, a: u64[], half: u64[]) -> bool {
    let t = nistec.element(f)
    nistec.power(f, t, a, half)
    limb.equal(t, f.one)
}

/// Returns a primitive `2^s`-th root of unity of `f`, where `2^s` is the largest power of two dividing `p - 1`, as `nqr^t` with `nqr` the smallest quadratic non-residue and `p - 1 = 2^s t`. This is the root snarkjs and ffjavascript use, so domains agree with theirs point for point.
fn two_adic_root(f: *nistec.Field) -> u64[] {
    let s = two_adicity(f.m)
    let half = shifted_right(f.m, 1)
    var candidate: u64 = 2
    for is_residue(f, small(f, candidate), half) {
        candidate += 1
    }
    let out = nistec.element(f)
    nistec.power(f, out, small(f, candidate), shifted_right(f.m, s))
    out
}

fn squared_times(f: *nistec.Field, a: u64[], times: i64) -> u64[] {
    let out = nistec.element(f)
    __memmove(out, a)
    for _ in 0..times {
        nistec.mul(f, out, out, out)
    }
    out
}

fn inverse_of(f: *nistec.Field, a: u64[]) -> u64[] {
    let out = nistec.element(f)
    nistec.invert(f, out, a)
    out
}

fn log2_ceiling(n: i64) -> i64 {
    var log = 0
    for (1 << log) < n {
        log += 1
    }
    log
}

/// Returns the smallest radix-2 domain with at least `count` points, with the primitive root of twice its size as `shift`, or `none` when twice its size exceeds the two-adicity of `f`.
fn domain(f: *nistec.Field, count: i64) -> Domain? {
    let log = log2_ceiling(count)
    let s = two_adicity(f.m)
    if log + 1 > s {
        return none
    }
    let top = two_adic_root(f)
    let shift = squared_times(f, top, s - log - 1)
    let root = squared_times(f, shift, 1)
    Domain {
        size: 1 << log
        log
        root
        root_inverse: inverse_of(f, root)
        size_inverse: inverse_of(f, small(f, u64(1 << log)))
        shift
    }
}

fn bit_reverse(values: u64[][], log: i64) {
    for i in 0..values.len {
        var j = 0
        for bit in 0..log {
            j |= ((i >> bit) & 1) << (log - 1 - bit)
        }
        if i < j {
            let t = values[i]
            values[i] = values[j]
            values[j] = t
        }
    }
}

fn butterflies(f: *nistec.Field, values: u64[][], start: i64, half: i64, step: u64[]) {
    let w = nistec.element(f)
    __memmove(w, f.one)
    let t = nistec.element(f)
    for j in start..start + half {
        let u = values[j]
        let v = values[j + half]
        nistec.mul(f, t, v, w)
        nistec.sub(f, v, u, t)
        nistec.add(f, u, u, t)
        nistec.mul(f, w, w, step)
    }
}

/// Replaces the coefficients `values` of a polynomial by its values at `root^i`, for `root` a primitive root of order `values.len`, a power of two.
fn transform(f: *nistec.Field, values: u64[][], root: u64[], log: i64) {
    bit_reverse(values, log)
    var half = 1
    for half < values.len {
        let step = squared_times(f, root, log - log2_ceiling(2 * half))
        var start = 0
        for start < values.len {
            butterflies(f, values, start, half, step)
            start += 2 * half
        }
        half *= 2
    }
}

fn evaluate(f: *nistec.Field, d: Domain, values: u64[][]) {
    transform(f, values, d.root, d.log)
}

fn interpolate(f: *nistec.Field, d: Domain, values: u64[][]) {
    transform(f, values, d.root_inverse, d.log)
    for v in values {
        nistec.mul(f, v, v, d.size_inverse)
    }
}

/// Replaces the values of a polynomial on the domain by its values at `shift root^i`, the odd points of the domain of twice the size.
fn to_odd_points(f: *nistec.Field, d: Domain, values: u64[][]) {
    interpolate(f, d, values)
    let power = nistec.element(f)
    __memmove(power, f.one)
    for v in values {
        nistec.mul(f, v, v, power)
        nistec.mul(f, power, power, d.shift)
    }
    evaluate(f, d, values)
}

/// Sets each element of `values` to its inverse with one field inversion. No element can be zero.
fn invert_all(f: *nistec.Field, values: u64[][]) {
    var prefix: u64[][] = []
    let running = nistec.element(f)
    __memmove(running, f.one)
    for v in values {
        let copy = nistec.element(f)
        __memmove(copy, running)
        prefix.push(copy)
        nistec.mul(f, running, running, v)
    }
    nistec.invert(f, running, running)
    var i = values.len - 1
    for i >= 0 {
        let inverse = nistec.element(f)
        nistec.mul(f, inverse, running, prefix[i])
        nistec.mul(f, running, running, values[i])
        __memmove(values[i], inverse)
        i -= 1
    }
}
