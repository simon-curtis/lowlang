import std/crypto/pairing
import std/zk/groth16

fn cubic(c: *pairing.Curve, x: u64) -> *groth16.Builder {
    let b = groth16.builder(c)
    let y = b.input([x * x * x + x + 5])
    let secret = b.secret([x])
    let square = b.product(secret, secret)
    let cube = b.product(square, secret)
    b.constrain([b.term(cube), b.term(secret), b.scaled(groth16.one(), 5)], [b.term(groth16.one())], [b.term(y)])
    b
}

fn show(c: *pairing.Curve, name: str) ! groth16.Error {
    let b = cubic(c, 3)
    let s = b.system()
    print("{name}: {s.variables} variables, {s.inputs} public input")

    print("  as circom files: {groth16.write_r1cs(c, s).len} bytes of .r1cs, {groth16.write_witness(c, b.assignment()).len} bytes of .wtns")

    let pk = groth16.setup(c, s)?
    let proof = groth16.prove(c, pk, s, b.assignment())?
    print("  proof that x^3 + x + 5 = 35 for a secret x: {groth16.verify(c, pk.verifying, b.inputs_of(), proof)}")
    print("  the same proof for 36: {groth16.verify(c, pk.verifying, [[36]], proof)}")

    let again = groth16.proof_from_json(c, groth16.proof_to_json(c, proof))?
    print("  after a round trip through snarkjs JSON: {groth16.verify(c, pk.verifying, b.inputs_of(), again)}")
}

fn main() ! groth16.Error {
    show(pairing.bn254(), "BN254")?
    show(pairing.bls12_381(), "BLS12-381")?
}
