import std/zk/goldilocks

fn put(mut out: u8[], v: u64) {
    for i in 0..8 {
        out.push(u8(v >> u64(8 * i)))
    }
}

fn put32(mut out: u8[], v: i64) {
    for i in 0..4 {
        out.push(u8(v >> u64(8 * i)))
    }
}

fn append(mut out: u8[], more: u8[]) {
    __extend(mut out, __str_view(more))
}

fn get(data: u8[], at: i64) -> u64 {
    var v: u64 = 0
    for i in 0..8 {
        v |= u64(data[at + i]) << u64(8 * i)
    }
    v
}

fn get32(data: u8[], at: i64) -> i64 {
    var v: i64 = 0
    for i in 0..4 {
        v |= i64(data[at + i]) << u64(8 * i)
    }
    v
}

fn elements(values: u64[]) -> u8[] {
    var out: u8[] = []
    for v in values {
        put(mut out, v)
    }
    out
}

fn ext_elements(values: goldilocks.Ext[]) -> u8[] {
    var out: u8[] = []
    for e in values {
        put(mut out, e.c0)
        put(mut out, e.c1)
        put(mut out, e.c2)
    }
    out
}

fn ext_at(values: u64[], i: i64) -> goldilocks.Ext {
    goldilocks.Ext { c0: values[3 * i], c1: values[3 * i + 1], c2: values[3 * i + 2] }
}
