import std/zk/goldilocks

fn magic() -> u8[] {
    [76, 83, 84, 75, 1]
}

struct Reader {
    data: u8[]
    at: i64
}

fn take(r: *Reader, n: i64) -> u8[] ! Error {
    if n < 0 || n > r.data.len - r.at {
        fail Malformed
    }
    let out = r.data[r.at..r.at + n]
    r.at += n
    out
}

fn read_count(r: *Reader, limit: i64) -> i64 ! Error {
    let n = get32(take(r, 4)?, 0)
    if n > limit {
        fail Malformed
    }
    n
}

fn read_element(r: *Reader) -> u64 ! Error {
    let v = get(take(r, 8)?, 0)
    if v >= goldilocks.modulus {
        fail Malformed
    }
    v
}

fn read_ext(r: *Reader, count: i64) -> goldilocks.Ext[] ! Error {
    var out: goldilocks.Ext[] = []
    for _ in 0..count {
        let c0 = read_element(r)?
        let c1 = read_element(r)?
        let c2 = read_element(r)?
        out.push(goldilocks.Ext { c0, c1, c2 })
    }
    out
}

fn copy_bytes(data: u8[]) -> u8[] {
    let out: u8[] = __make(data.len)
    __memmove(out, data)
    out
}

fn read_layer(r: *Reader, leaf_len: i64, limit: i64) -> Layer ! Error {
    let count = read_count(r, limit)?
    var leaves: u64[][] = []
    for _ in 0..count {
        var leaf: u64[] = []
        for _ in 0..leaf_len {
            leaf.push(read_element(r)?)
        }
        leaves.push(leaf)
    }
    let hashes = read_count(r, 64 * limit)?
    var siblings: u8[][] = []
    for _ in 0..hashes {
        siblings.push(copy_bytes(take(r, digest_size)?))
    }
    Layer { leaves, siblings }
}

fn write_layer(mut out: u8[], layer: Layer) {
    put32(mut out, layer.leaves.len)
    for leaf in layer.leaves {
        append(mut out, elements(leaf))
    }
    put32(mut out, layer.siblings.len)
    for s in layer.siblings {
        append(mut out, s)
    }
}

/// Returns the bytes of `proof`: a header naming the parameters and the shape of the `Air`, the roots, the out-of-domain values, the remainder polynomial, the nonce and the openings, every number as 8 little-endian bytes below the modulus and every count as 4.
///
/// The bytes carry no lengths that the `Air` and `params` do not fix except the number of openings and sibling hashes of each layer, so `read_proof` needs the same two to read them back. Fails with `Air` or `Params` when they are out of range.
pub fn write_proof(air: Air, params: Params, proof: Proof) -> u8[] ! Error {
    let l = layout(air, params)?
    var out: u8[] = []
    append(mut out, magic())
    append(mut out, header(air, l))
    append(mut out, proof.trace_root)
    append(mut out, proof.composition_root)
    append(mut out, ext_elements(proof.ood))
    for r in proof.fri_roots {
        append(mut out, r)
    }
    append(mut out, ext_elements(proof.remainder))
    put(mut out, proof.nonce)
    write_layer(mut out, proof.trace)
    write_layer(mut out, proof.composition)
    for layer in proof.fri {
        write_layer(mut out, layer)
    }
    out
}

/// Reads a proof for `air` and `params` from `data`.
///
/// Fails with `Malformed` when `data` is cut short, has bytes left over, has a count above what the parameters allow or a number that is not below the modulus, with `Mismatch` when the header names other parameters or another shape of `air`, and with `Air` or `Params` when those are out of range. A proof that reads is not yet checked: pass it to `verify`.
pub fn read_proof(air: Air, params: Params, data: u8[]) -> Proof ! Error {
    let l = layout(air, params)?
    let r = new(Reader { data, at: 0 })
    let prefix = take(r, magic().len)?
    if !bytes_equal(prefix, magic()) {
        fail Malformed
    }
    let expected = header(air, l)
    if !bytes_equal(take(r, expected.len)?, expected) {
        fail Mismatch
    }
    let trace_root = copy_bytes(take(r, digest_size)?)
    let composition_root = copy_bytes(take(r, digest_size)?)
    let ood = read_ext(r, 2 * l.width + l.columns)?
    var fri_roots: u8[][] = []
    for _ in 1..l.rounds {
        fri_roots.push(copy_bytes(take(r, digest_size)?))
    }
    let remainder = read_ext(r, l.remainder_len)?
    let nonce = read_element_any(r)?
    let limit = params.queries
    let trace = read_layer(r, 2 * l.width, limit)?
    let composition = read_layer(r, 6 * l.committed, limit)?
    var fri: Layer[] = []
    for _ in 1..l.rounds {
        fri.push(read_layer(r, 6, limit)?)
    }
    if r.at != data.len {
        fail Malformed
    }
    Proof { trace_root, composition_root, ood, fri_roots, remainder, nonce, trace, composition, fri }
}

fn read_element_any(r: *Reader) -> u64 ! Error {
    get(take(r, 8)?, 0)
}

fn bytes_equal(a: u8[], b: u8[]) -> bool {
    if a.len != b.len {
        return false
    }
    for i in 0..a.len {
        if a[i] != b[i] {
            return false
        }
    }
    true
}
