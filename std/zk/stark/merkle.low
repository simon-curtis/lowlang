import std/crypto/blake3
import std/crypto/hash

const digest_size = 32

struct Tree {
    leaves: i64
    nodes: u8[]
}

struct Pending {
    index: i64
    hash: u8[]
}

fn leaf_hash(values: u64[]) -> u8[] {
    var data: u8[] = [0]
    for v in values {
        put(mut data, v)
    }
    blake3.sum(data)
}

fn node_hash(left: u8[], right: u8[]) -> u8[] {
    var data: u8[] = [1]
    append(mut data, left)
    append(mut data, right)
    blake3.sum(data)
}

fn node_at(t: Tree, i: i64) -> u8[] {
    t.nodes[digest_size * i..digest_size * (i + 1)]
}

fn build(leaves: u64[][]) -> Tree {
    let count = leaves.len
    let nodes: u8[] = __make(2 * count * digest_size)
    let tree = Tree { leaves: count, nodes }
    for i in 0..count {
        __memmove(nodes[digest_size * (count + i)..digest_size * (count + i + 1)], leaf_hash(leaves[i]))
    }
    var i = count - 1
    for i >= 1 {
        __memmove(nodes[digest_size * i..digest_size * (i + 1)], node_hash(node_at(tree, 2 * i), node_at(tree, 2 * i + 1)))
        i -= 1
    }
    tree
}

fn root(t: Tree) -> u8[] {
    let out: u8[] = __make(digest_size)
    __memmove(out, node_at(t, 1))
    out
}

fn is_pair(level: i64[], i: i64) -> bool {
    i + 1 < level.len && level[i] % 2 == 0 && level[i + 1] == level[i] + 1
}

fn open(t: Tree, indices: i64[]) -> u8[][] {
    var level: i64[] = []
    for i in indices {
        level.push(t.leaves + i)
    }
    var siblings: u8[][] = []
    for level.len > 0 && level[0] > 1 {
        var parents: i64[] = []
        var i = 0
        for i < level.len {
            if is_pair(level, i) {
                i += 1
            } else {
                let sibling = node_at(t, level[i] ^ 1)
                let copy: u8[] = __make(digest_size)
                __memmove(copy, sibling)
                siblings.push(copy)
            }
            parents.push(level[i] / 2)
            i += 1
        }
        level = parents
    }
    siblings
}

fn authenticate(expected: u8[], leaves: i64, indices: i64[], hashes: u8[][], siblings: u8[][]) -> bool {
    if indices.len == 0 || indices.len != hashes.len || expected.len != digest_size {
        return false
    }
    var level: Pending[] = []
    for k in 0..indices.len {
        level.push(Pending { index: leaves + indices[k], hash: hashes[k] })
    }
    var used = 0
    for level[0].index > 1 {
        var parents: Pending[] = []
        var i = 0
        for i < level.len {
            let node = level[i]
            var left = node.hash
            var right = node.hash
            if i + 1 < level.len && node.index % 2 == 0 && level[i + 1].index == node.index + 1 {
                right = level[i + 1].hash
                i += 1
            } else {
                if used >= siblings.len {
                    return false
                }
                if node.index % 2 == 0 {
                    right = siblings[used]
                } else {
                    left = siblings[used]
                }
                used += 1
            }
            parents.push(Pending { index: node.index / 2, hash: node_hash(left, right) })
            i += 1
        }
        level = parents
    }
    used == siblings.len && hash.equal(level[0].hash, expected)
}
