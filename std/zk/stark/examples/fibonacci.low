import std/zk/airs
import std/zk/stark

fn describe(params: stark.Params) ! stark.Error {
    let steps = 1024
    let trace = airs.fibonacci_trace(steps)
    let result = airs.fibonacci_result(steps)
    let air = airs.fibonacci(steps, result)

    let level = stark.security(air, params)?
    print("zero knowledge {params.zero_knowledge}: blowup {params.blowup}, {params.queries} queries, {params.grinding_bits} grinding bits")
    print("  security in bits: {level.conjectured} conjectured, {level.proven_unique} proven unique, {level.proven_list} proven list")

    let proof = stark.prove(air, params, trace)?
    print("  the last of {steps} rows ends at {result}: {stark.verify(air, params, proof)}")
    print("  the same proof for {result + 1}: {stark.verify(airs.fibonacci(steps, result + 1), params, proof)}")

    let data = stark.write_proof(air, params, proof)?
    let again = stark.read_proof(air, params, data)?
    print("  after a round trip through bytes: {stark.verify(air, params, again)}")
    print("  with one byte changed: {changed(air, params, data)}")
}

fn changed(air: stark.Air, params: stark.Params, data: u8[]) -> str {
    var bad: u8[] = []
    for b in data {
        bad.push(b)
    }
    bad[data.len / 2] ^= 1
    let proof = stark.read_proof(air, params, bad) or return "unreadable"
    if stark.verify(air, params, proof) { "accepted" } else { "rejected" }
}

fn main() ! stark.Error {
    describe(stark.Params { blowup: 8, queries: 40, grinding_bits: 16, zero_knowledge: false })?
    describe(stark.Params { blowup: 16, queries: 30, grinding_bits: 16, zero_knowledge: true })?
}
