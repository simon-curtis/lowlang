import std/zk/airs
import std/zk/stark

fn main() ! stark.Error {
    let steps = 256
    let params = stark.Params { blowup: 8, queries: 40, grinding_bits: 16, zero_knowledge: true }

    let trace = airs.hash_chain_trace(steps, 123456789, 987654321)
    let left = trace[0][steps - 1]
    let right = trace[1][steps - 1]
    let air = airs.hash_chain(steps, left, right)
    print("a Feistel chain of {steps - 1} cubing rounds ends at ({left}, {right})")
    print("  constraint degrees: {stark.degree(air.transitions[0])} and {stark.degree(air.transitions[1])}")

    let level = stark.security(air, params)?
    print("  security in bits: {level.conjectured} conjectured, {level.proven_unique} proven unique, {level.proven_list} proven list")

    let proof = stark.prove(air, params, trace)?
    print("  proof that the output has a preimage: {stark.verify(air, params, proof)}")
    print("  the same proof for another output: {stark.verify(airs.hash_chain(steps, left + 1, right), params, proof)}")

    let other = stark.prove(air, params, trace)?
    print("  a second proof has other commitments: {!same(proof.trace_root, other.trace_root)}")
}

fn same(a: u8[], b: u8[]) -> bool {
    if a.len != b.len {
        return false
    }
    for i in 0..a.len {
        if a[i] != b[i] {
            return false
        }
    }
    true
}
