import std/zk/goldilocks

/// A polynomial expression over the trace, evaluated in the extension of the Goldilocks field.
///
/// Build expressions with `constant`, `current`, `next`, `periodic`, `add`, `sub`, `mul` and `pow`.
pub enum Expr {
    /// A field element below `goldilocks.modulus`.
    Const(u64)
    /// Column `c` of the row a constraint is checked at.
    Current(i64)
    /// Column `c` of the row after the one a constraint is checked at.
    Next(i64)
    /// The value of periodic column `i` at the row a constraint is checked at.
    Periodic(i64)
    /// The sum of two expressions.
    Add(*Expr, *Expr)
    /// The first expression minus the second.
    Sub(*Expr, *Expr)
    /// The product of two expressions.
    Mul(*Expr, *Expr)
}

/// The field element `value`.
pub fn constant(value: u64) -> Expr {
    Const(value)
}

/// Column `column` of the current row.
pub fn current(column: i64) -> Expr {
    Current(column)
}

/// Column `column` of the next row.
pub fn next(column: i64) -> Expr {
    Next(column)
}

/// Periodic column `index` of the `Air` at the current row.
pub fn periodic(index: i64) -> Expr {
    Periodic(index)
}

/// `a + b`.
pub fn add(a: Expr, b: Expr) -> Expr {
    Add(new(a), new(b))
}

/// `a - b`.
pub fn sub(a: Expr, b: Expr) -> Expr {
    Sub(new(a), new(b))
}

/// `a * b`.
pub fn mul(a: Expr, b: Expr) -> Expr {
    Mul(new(a), new(b))
}

/// `a` raised to the power `k`, which must be at least 1.
pub fn pow(a: Expr, k: i64) -> Expr {
    if k <= 1 {
        return a
    }
    let half = pow(a, k / 2)
    let square = mul(half, half)
    if k % 2 == 0 { square } else { mul(square, a) }
}

/// The value `value` of trace column `column` at row `row`, one of the public inputs of a statement.
pub struct Boundary {
    /// The trace column.
    pub column: i64
    /// The trace row, below `Air.steps`.
    pub row: i64
    /// The required value, below `goldilocks.modulus`.
    pub value: u64
}

/// An algebraic intermediate representation: what a trace of `steps` rows and `width` columns over the Goldilocks field must satisfy.
///
/// Every expression of `transitions` must be zero when `Current` is any row but the last and `Next` the row after it, and each `Boundary` fixes one cell. `periodic` holds columns that repeat: column `i` has the value `periodic[i][row % periodic[i].len]` at row `row`, and the length of each is a power of two that divides `steps`. The statement an `Air` proves is that a trace exists, so the boundary values are its public inputs.
pub struct Air {
    /// The number of trace columns.
    pub width: i64
    /// The number of trace rows, a power of two of at least 4.
    pub steps: i64
    /// The periodic columns, each one period of values below `goldilocks.modulus`.
    pub periodic: u64[][]
    /// The transition constraints.
    pub transitions: Expr[]
    /// The boundary constraints.
    pub boundaries: Boundary[]
}

/// Returns the degree of `e` in the trace columns, the largest number of `Current` and `Next` factors in one product, with periodic columns counted as constants.
pub fn degree(e: Expr) -> i64 {
    match e {
        Const(_) => 0
        Current(_) => 1
        Next(_) => 1
        Periodic(_) => 0
        Add(a, b) => max_of(degree(*a), degree(*b))
        Sub(a, b) => max_of(degree(*a), degree(*b))
        Mul(a, b) => degree(*a) + degree(*b)
    }
}

fn max_of(a: i64, b: i64) -> i64 {
    if a > b { a } else { b }
}

fn evaluate(e: Expr, current: goldilocks.Ext[], next: goldilocks.Ext[], periodic: goldilocks.Ext[]) -> goldilocks.Ext {
    match e {
        Const(v) => goldilocks.ext(v)
        Current(c) => current[c]
        Next(c) => next[c]
        Periodic(i) => periodic[i]
        Add(a, b) => goldilocks.ext_add(evaluate(*a, current, next, periodic), evaluate(*b, current, next, periodic))
        Sub(a, b) => goldilocks.ext_sub(evaluate(*a, current, next, periodic), evaluate(*b, current, next, periodic))
        Mul(a, b) => goldilocks.ext_mul(evaluate(*a, current, next, periodic), evaluate(*b, current, next, periodic))
    }
}

fn polynomial_degree(air: Air, e: Expr, trace_len: i64) -> i64 {
    match e {
        Const(_) => 0
        Current(_) => trace_len - 1
        Next(_) => trace_len - 1
        Periodic(i) => (air.periodic[i].len - 1) * (air.steps / air.periodic[i].len)
        Add(a, b) => max_of(polynomial_degree(air, *a, trace_len), polynomial_degree(air, *b, trace_len))
        Sub(a, b) => max_of(polynomial_degree(air, *a, trace_len), polynomial_degree(air, *b, trace_len))
        Mul(a, b) => polynomial_degree(air, *a, trace_len) + polynomial_degree(air, *b, trace_len)
    }
}

fn describe(mut out: u8[], e: Expr) {
    match e {
        Const(v) => {
            out.push(0)
            put(mut out, v)
        }
        Current(c) => {
            out.push(1)
            put(mut out, u64(c))
        }
        Next(c) => {
            out.push(2)
            put(mut out, u64(c))
        }
        Periodic(i) => {
            out.push(3)
            put(mut out, u64(i))
        }
        Add(a, b) => {
            out.push(4)
            describe(mut out, *a)
            describe(mut out, *b)
        }
        Sub(a, b) => {
            out.push(5)
            describe(mut out, *a)
            describe(mut out, *b)
        }
        Mul(a, b) => {
            out.push(6)
            describe(mut out, *a)
            describe(mut out, *b)
        }
    }
}

/// Returns a byte string that names `air` exactly, which the proof system binds into its transcript.
fn encode(air: Air) -> u8[] {
    var out: u8[] = []
    put(mut out, u64(air.width))
    put(mut out, u64(air.steps))
    put(mut out, u64(air.periodic.len))
    for column in air.periodic {
        put(mut out, u64(column.len))
        for v in column {
            put(mut out, v)
        }
    }
    put(mut out, u64(air.transitions.len))
    for e in air.transitions {
        describe(mut out, e)
    }
    put(mut out, u64(air.boundaries.len))
    for b in air.boundaries {
        put(mut out, u64(b.column))
        put(mut out, u64(b.row))
        put(mut out, b.value)
    }
    out
}

fn expression_valid(air: Air, e: Expr) -> bool {
    match e {
        Const(v) => v < goldilocks.modulus
        Current(c) => c >= 0 && c < air.width
        Next(c) => c >= 0 && c < air.width
        Periodic(i) => i >= 0 && i < air.periodic.len
        Add(a, b) => expression_valid(air, *a) && expression_valid(air, *b)
        Sub(a, b) => expression_valid(air, *a) && expression_valid(air, *b)
        Mul(a, b) => expression_valid(air, *a) && expression_valid(air, *b)
    }
}

fn power_of_two(n: i64) -> bool {
    n > 0 && n & (n - 1) == 0
}

/// Returns whether `air` is well formed: a width of at least 1, a number of steps that is a power of two of at least 4 and at most `2^26`, periodic columns whose lengths are powers of two dividing `steps`, and constraints that name only columns, periodic columns and cells that exist, with every constant canonical.
fn well_formed(air: Air) -> bool {
    if air.width < 1 || air.width > 1024 || !power_of_two(air.steps) || air.steps < 4 || air.steps > (1 << 26) {
        return false
    }
    for column in air.periodic {
        if !power_of_two(column.len) || air.steps % column.len != 0 {
            return false
        }
        for v in column {
            if v >= goldilocks.modulus {
                return false
            }
        }
    }
    for e in air.transitions {
        if !expression_valid(air, e) {
            return false
        }
    }
    for b in air.boundaries {
        if b.column < 0 || b.column >= air.width || b.row < 0 || b.row >= air.steps || b.value >= goldilocks.modulus {
            return false
        }
    }
    true
}

fn periodic_at(air: Air, row: i64) -> goldilocks.Ext[] {
    var out: goldilocks.Ext[] = []
    for column in air.periodic {
        out.push(goldilocks.ext(column[row % column.len]))
    }
    out
}

fn lift(values: u64[]) -> goldilocks.Ext[] {
    var out: goldilocks.Ext[] = []
    for v in values {
        out.push(goldilocks.ext(v))
    }
    out
}

fn row_of(trace: u64[][], row: i64) -> u64[] {
    var out: u64[] = []
    for column in trace {
        out.push(column[row])
    }
    out
}

fn satisfied(air: Air, trace: u64[][]) -> bool {
    for b in air.boundaries {
        if trace[b.column][b.row] != b.value {
            return false
        }
    }
    for row in 0..air.steps - 1 {
        let current = lift(row_of(trace, row))
        let next = lift(row_of(trace, row + 1))
        let per = periodic_at(air, row)
        for e in air.transitions {
            if !goldilocks.ext_is_zero(evaluate(e, current, next, per)) {
                return false
            }
        }
    }
    true
}
