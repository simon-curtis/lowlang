const extension_bits: f64 = 192.0
const collision_bits: i64 = 128
const grinding_floor: i64 = 80
const proximity_limit: i64 = 1000

/// The security level of a proof in bits.
pub struct Security {
    /// The conjectured level: `queries * log2(blowup)` plus the grinding bits once the queries alone give 80 bits, at most 191 for the 192-bit extension field minus one, and at most 128 for the collision resistance of the 256-bit Merkle hashes.
    pub conjectured: i64
    /// The level proven in the unique decoding regime, where a query catches a far word with probability `(1 + rate) / 2`.
    pub proven_unique: i64
    /// The level proven in the list decoding regime, the best over the proximity parameter `m` from 3 up.
    pub proven_list: i64
}

fn smaller(a: f64, b: f64) -> f64 {
    if a < b { a } else { b }
}

fn log2(x: f64) -> f64 {
    var mantissa = x
    var exponent = 0.0
    for mantissa >= 1.4142135623730951 {
        mantissa *= 0.5
        exponent += 1.0
    }
    for mantissa < 0.7071067811865476 {
        mantissa *= 2.0
        exponent -= 1.0
    }
    let z = (mantissa - 1.0) / (mantissa + 1.0)
    let square = z * z
    var term = z
    var sum = 0.0
    for k in 0..30 {
        sum += term / f64(2 * k + 1)
        term *= square
    }
    exponent + 2.0 * sum / 0.6931471805599453
}

fn ceil_of(x: f64) -> f64 {
    let down = floor(x)
    if down < x { down + 1.0 } else { down }
}

fn power7(x: f64) -> f64 {
    let square = x * x
    let fourth = square * square
    fourth * square * x
}

fn whole(x: f64) -> i64 {
    if x < 0.0 { 0 } else { i64(floor(x)) }
}

fn log_blowup(blowup: i64) -> i64 {
    bits_of(blowup)
}

fn unique_decoding(n: i64, blowup: i64, queries: i64, grinding: i64, rounds: i64) -> i64 {
    let lde = f64(n * blowup)
    let size = f64(n)
    let alpha = (1.0 + (size + 2.0) / lde) * 0.5
    let max_degree = f64(blowup) + 1.0
    var worst = extension_bits
    worst = smaller(worst, extension_bits - log2(max_degree * (size + 1.0) + (size - 1.0)))
    worst = smaller(worst, extension_bits - log2(lde))
    if rounds > 0 {
        worst = smaller(worst, extension_bits - log2(lde + 1.0))
    }
    worst = smaller(worst, f64(grinding) - f64(queries) * log2(alpha))
    min_i(whole(worst), collision_bits)
}

fn list_decoding_at(n: i64, blowup: i64, queries: i64, grinding: i64, m: f64) -> f64 {
    let lde = f64(n * blowup)
    let size = f64(n)
    let rho = 1.0 / f64(blowup)
    let alpha = (1.0 + 0.5 / m) * sqrt(rho)
    let max_degree = f64(blowup) + 1.0
    let list = m / (rho - 2.0 * m / lde)
    var worst = extension_bits - log2(list)
    worst = smaller(worst, extension_bits - log2(list * list * (max_degree * (size + 1.0) + (size - 1.0))))
    worst = smaller(worst, extension_bits - log2(power7(m + 0.5) / (3.0 * (rho * sqrt(rho))) * lde * lde))
    smaller(worst, f64(grinding) - f64(queries) * log2(alpha))
}

fn upper_proximity(n: i64) -> i64 {
    let size = f64(n)
    let bound = ceil_of(1.0 / (2.0 * (sqrt((size + 2.0) / size) - 1.0)))
    min_i(whole(bound), proximity_limit)
}

fn list_decoding(n: i64, blowup: i64, queries: i64, grinding: i64) -> i64 {
    var best = 0
    for m in 3..upper_proximity(n) {
        let rho = 1.0 / f64(blowup)
        if rho - 2.0 * f64(m) / f64(n * blowup) <= 0.0 {
            continue
        }
        let level = whole(list_decoding_at(n, blowup, queries, grinding, f64(m)))
        if level > best {
            best = level
        }
    }
    min_i(best, collision_bits)
}

fn min_i(a: i64, b: i64) -> i64 {
    if a < b { a } else { b }
}

fn levels(n: i64, blowup: i64, queries: i64, grinding: i64, rounds: i64) -> Security {
    var by_queries = queries * log_blowup(blowup)
    if by_queries >= grinding_floor {
        by_queries += grinding
    }
    let conjectured = min_i(min_i(192, by_queries) - 1, collision_bits)
    Security { conjectured, proven_unique: unique_decoding(n, blowup, queries, grinding, rounds), proven_list: list_decoding(n, blowup, queries, grinding) }
}

/// Returns the security level in bits of proofs for `air` with `params`, from the soundness analysis of ethSTARK (eprint 2021/582) and the proven bounds of eprint 2024/1553 that Winterfell applies, for the 192-bit cubic extension field, FRI folding by 2 and random linear combinations of the constraints and of the DEEP terms.
///
/// The conjectured level assumes the proximity gap conjecture for Reed-Solomon codes up to the capacity bound; the proven levels rest on the Johnson bound and the proximity gap theorems, so they are what a verifier can rely on without that conjecture. Proof of work counts toward a level only once the other terms leave room for it. With `params.zero_knowledge` the trace is longer, which the levels take into account. Fails with `Air` or `Params` when they are out of range.
pub fn security(air: Air, params: Params) -> Security ! Error {
    let l = layout(air, params)?
    levels(l.trace_len, params.blowup, params.queries, params.grinding_bits, l.rounds)
}
