import std/slices
import std/testing
import std/zk/goldilocks

fn fibonacci_air(steps: i64, result: u64) -> Air {
    Air {
        width: 2
        steps
        periodic: []
        transitions: [
            sub(next(0), current(1))
            sub(next(1), add(current(0), current(1)))
        ]
        boundaries: [
            Boundary { column: 0, row: 0, value: 1 }
            Boundary { column: 1, row: 0, value: 1 }
            Boundary { column: 1, row: steps - 1, value: result }
        ]
    }
}

fn fibonacci_trace(steps: i64) -> u64[][] {
    var a: u64[] = []
    var b: u64[] = []
    var x: u64 = 1
    var y: u64 = 1
    for _ in 0..steps {
        a.push(x)
        b.push(y)
        let s = goldilocks.add(x, y)
        x = y
        y = s
    }
    [a, b]
}

fn quick(zk: bool) -> Params {
    Params { blowup: 4, queries: 8, grinding_bits: 4, zero_knowledge: zk }
}

fn reads(air: Air, params: Params, data: u8[]) -> bool {
    read_proof(air, params, data) or return false
    true
}

fn test_prover_that_skips_the_checks_is_rejected(t: *testing.T) {
    let steps = 32
    let honest = fibonacci_trace(steps)
    let air = fibonacci_air(steps, honest[1][steps - 1])
    for zk in [false, true] {
        let params = quick(zk)
        let l = layout(air, params) or return t.fatal("layout")
        var forged = fibonacci_trace(steps)
        forged[0][steps / 2] = goldilocks.add(forged[0][steps / 2], 1)
        t.is_false(satisfied(air, forged))
        let proof = build_proof(air, l, forged, false) or return t.fatal("forged proof")
        t.is_false(verify(air, params, proof))
    }
}

fn test_values_must_be_canonical(t: *testing.T) {
    let trace = fibonacci_trace(16)
    let air = fibonacci_air(16, trace[1][15])
    let params = quick(false)
    let l = layout(air, params) or return t.fatal("layout")
    let proof = prove(air, params, trace) or return t.fatal("prove")
    let data = write_proof(air, params, proof) or return t.fatal("write")
    let at = magic().len + header(air, l).len + 2 * digest_size
    t.is_true(reads(air, params, data))
    let modulus_bytes: u8[] = [1, 0, 0, 0, 0xFF, 0xFF, 0xFF, 0xFF]
    let bad = slices.concat(slices.concat(data[..at], modulus_bytes), data[at + 8..])
    t.is_false(reads(air, params, bad))
    let below: u8[] = [0, 0, 0, 0, 0xFF, 0xFF, 0xFF, 0xFF]
    let fine = slices.concat(slices.concat(data[..at], below), data[at + 8..])
    t.is_true(reads(air, params, fine))
}

fn test_zero_knowledge_randomises_the_commitments(t: *testing.T) {
    let trace = fibonacci_trace(32)
    let air = fibonacci_air(32, trace[1][31])
    let a = prove(air, quick(true), trace) or return t.fatal("prove")
    let b = prove(air, quick(true), trace) or return t.fatal("prove")
    t.is_true(verify(air, quick(true), a))
    t.is_true(verify(air, quick(true), b))
    t.is_false(slices.equal(a.trace_root, b.trace_root))
    let c = prove(air, quick(false), trace) or return t.fatal("prove")
    let d = prove(air, quick(false), trace) or return t.fatal("prove")
    t.is_true(slices.equal(c.trace_root, d.trace_root))
}

