import std/crypto/blake3
import std/zk/goldilocks

struct Transcript {
    state: u8[]
}

fn start(seed: u8[]) -> *Transcript {
    var data: u8[] = []
    append(mut data, "low/zk/stark/1".bytes())
    append(mut data, seed)
    new(Transcript { state: blake3.sum(data) })
}

fn absorb(t: *Transcript, data: u8[]) {
    var buf: u8[] = [16]
    append(mut buf, t.state)
    put(mut buf, u64(data.len))
    append(mut buf, data)
    t.state = blake3.sum(buf)
}

fn tagged(t: *Transcript, tag: u8) -> u8[] {
    var buf: u8[] = [tag]
    append(mut buf, t.state)
    buf
}

fn next_word(t: *Transcript) -> u64 {
    let bytes = blake3.xof(tagged(t, 32), 8)
    t.state = blake3.sum(tagged(t, 33))
    get(bytes, 0)
}

fn challenge(t: *Transcript) -> u64 {
    for {
        let v = next_word(t)
        if v < goldilocks.modulus {
            return v
        }
    }
}

fn challenge_ext(t: *Transcript) -> goldilocks.Ext {
    let c0 = challenge(t)
    let c1 = challenge(t)
    let c2 = challenge(t)
    goldilocks.Ext { c0, c1, c2 }
}

fn challenge_index(t: *Transcript, bound: i64) -> i64 {
    i64(next_word(t) & u64(bound - 1))
}

fn meets(t: *Transcript, bits: i64, nonce: u64) -> bool {
    var buf = tagged(t, 48)
    put(mut buf, nonce)
    let digest = blake3.sum(buf)
    let top = u64(digest[0]) << 56 | u64(digest[1]) << 48 | u64(digest[2]) << 40 | u64(digest[3]) << 32 | u64(digest[4]) << 24 | u64(digest[5]) << 16 | u64(digest[6]) << 8 | u64(digest[7])
    bits == 0 || top >> u64(64 - bits) == 0
}

fn grind(t: *Transcript, bits: i64) -> u64 {
    var nonce: u64 = 0
    for !meets(t, bits, nonce) {
        nonce += 1
    }
    nonce
}
