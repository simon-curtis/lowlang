import std/crypto/blake3
import std/zk/goldilocks
import std/zk/stark

const constant_period = 16

fn cell(left: u64, right: u64) -> u64 {
    goldilocks.add(left, right)
}

/// Returns the `Air` of the Fibonacci sequence: two columns that start at 1 and 1, each row `(a, b)` followed by `(b, a + b)`, with `result` the second column of the last of `steps` rows.
///
/// `steps` must be a power of two of at least 4. Its constraints have degree 1.
pub fn fibonacci(steps: i64, result: u64) -> stark.Air {
    stark.Air {
        width: 2
        steps
        periodic: []
        transitions: [
            stark.sub(stark.next(0), stark.current(1))
            stark.sub(stark.next(1), stark.add(stark.current(0), stark.current(1)))
        ]
        boundaries: [
            stark.Boundary { column: 0, row: 0, value: 1 }
            stark.Boundary { column: 1, row: 0, value: 1 }
            stark.Boundary { column: 1, row: steps - 1, value: result }
        ]
    }
}

/// Returns the trace of `fibonacci` for `steps` rows, as columns.
pub fn fibonacci_trace(steps: i64) -> u64[][] {
    var a: u64[] = []
    var b: u64[] = []
    var x: u64 = 1
    var y: u64 = 1
    for _ in 0..steps {
        a.push(x)
        b.push(y)
        let next = cell(x, y)
        x = y
        y = next
    }
    [a, b]
}

/// Returns the value of the second column in the last row of `fibonacci_trace(steps)`.
pub fn fibonacci_result(steps: i64) -> u64 {
    fibonacci_trace(steps)[1][steps - 1]
}

/// Returns the 16 round constants of `hash_chain`, the first eight bytes of the BLAKE3 hash of `low/zk/airs/hash_chain` and the round number reduced modulo the field.
pub fn round_constants() -> u64[] {
    var out: u64[] = []
    for i in 0..constant_period {
        var data: u8[] = "low/zk/airs/hash_chain".bytes()
        data.push(u8(i))
        let digest = blake3.sum(data)
        var v: u64 = 0
        for k in 0..8 {
            v |= u64(digest[k]) << u64(8 * k)
        }
        out.push(v % goldilocks.modulus)
    }
    out
}

fn round(left: u64, right: u64, constant: u64) -> u64[] {
    let t = goldilocks.add(left, constant)
    let cube = goldilocks.mul(goldilocks.mul(t, t), t)
    [goldilocks.add(right, cube), left]
}

/// Returns the `Air` of a Feistel hash chain with a cubing round function: two columns `(l, r)` that each row become `(r + (l + k)^3, l)`, with `k` the round constant of that row taken from the 16 of `round_constants` in turn, and the last of `steps` rows equal to `(output_left, output_right)`.
///
/// The first row is not fixed, so the statement is knowledge of an input that the `steps - 1` rounds map to the output. Its constraints have degree 3 and use a periodic column. `steps` must be a power of two of at least 16.
pub fn hash_chain(steps: i64, output_left: u64, output_right: u64) -> stark.Air {
    let k = stark.periodic(0)
    let cube = stark.pow(stark.add(stark.current(0), k), 3)
    stark.Air {
        width: 2
        steps
        periodic: [round_constants()]
        transitions: [
            stark.sub(stark.next(0), stark.add(stark.current(1), cube))
            stark.sub(stark.next(1), stark.current(0))
        ]
        boundaries: [
            stark.Boundary { column: 0, row: steps - 1, value: output_left }
            stark.Boundary { column: 1, row: steps - 1, value: output_right }
        ]
    }
}

/// Returns the trace of `hash_chain` that starts at `(left, right)`, as columns.
pub fn hash_chain_trace(steps: i64, left: u64, right: u64) -> u64[][] {
    let constants = round_constants()
    var a: u64[] = []
    var b: u64[] = []
    var x = left
    var y = right
    for i in 0..steps {
        a.push(x)
        b.push(y)
        let next = round(x, y, constants[i % constant_period])
        x = next[0]
        y = next[1]
    }
    [a, b]
}
