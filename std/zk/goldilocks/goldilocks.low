/// The Goldilocks prime `2^64 - 2^32 + 1`.
pub const modulus: u64 = 0xFFFF_FFFF_0000_0001

/// A generator of the multiplicative group modulo `modulus`.
pub const generator: u64 = 7

/// The largest `k` for which the field has a subgroup of order `2^k`.
pub const two_adicity: i64 = 32

const epsilon: u64 = 0xFFFF_FFFF

/// An element of the cubic extension `F[x] / (x^3 - x - 1)` of the Goldilocks field, `c0 + c1 x + c2 x^2`, each coefficient below `modulus`.
pub struct Ext {
    /// The constant coefficient.
    pub c0: u64
    /// The coefficient of `x`.
    pub c1: u64
    /// The coefficient of `x^2`.
    pub c2: u64
}

/// Returns `a + b` modulo `modulus` for `a` and `b` below `modulus`.
pub fn add(a: u64, b: u64) -> u64 {
    var s = a + b
    if s < a {
        s += epsilon
    }
    if s >= modulus {
        s -= modulus
    }
    s
}

/// Returns `a - b` modulo `modulus` for `a` and `b` below `modulus`.
pub fn sub(a: u64, b: u64) -> u64 {
    var d = a - b
    if a < b {
        d -= epsilon
    }
    d
}

/// Returns `-a` modulo `modulus` for `a` below `modulus`.
pub fn neg(a: u64) -> u64 {
    if a == 0 { 0 } else { modulus - a }
}

/// Returns `a * b` modulo `modulus` for `a` and `b` below `modulus`.
pub fn mul(a: u64, b: u64) -> u64 {
    let lo = a * b
    let hi = __mulhi(a, b)
    let hi_hi = hi >> 32
    let hi_lo = hi & epsilon
    var t = lo - hi_hi
    if lo < hi_hi {
        t -= epsilon
    }
    var r = t + hi_lo * epsilon
    if r < t {
        r += epsilon
    }
    if r >= modulus {
        r -= modulus
    }
    r
}

/// Returns `a` raised to the power `e` modulo `modulus`.
pub fn pow(a: u64, e: u64) -> u64 {
    var result: u64 = 1
    var base = a
    var k = e
    for k > 0 {
        if k & 1 == 1 {
            result = mul(result, base)
        }
        base = mul(base, base)
        k >>= 1
    }
    result
}

/// Returns the inverse of `a` modulo `modulus`, or 0 for 0.
pub fn inv(a: u64) -> u64 {
    pow(a, modulus - 2)
}

/// Returns the inverses of `values`, which must all be nonzero, with one inversion and three multiplications per value.
pub fn batch_inv(values: u64[]) -> u64[] {
    let out: u64[] = __make(values.len)
    var running: u64 = 1
    for i in 0..values.len {
        out[i] = running
        running = mul(running, values[i])
    }
    var inverse = inv(running)
    var i = values.len
    for i > 0 {
        i -= 1
        out[i] = mul(out[i], inverse)
        inverse = mul(inverse, values[i])
    }
    out
}

/// Returns the root of unity of order `2^log` that every transform of this module uses, the root of order `2^two_adicity`, `0x64FD_D1A4_6201_E246`, squared `two_adicity - log` times. `log` must be in `0..=two_adicity`.
pub fn root_of_unity(log: i64) -> u64 {
    var root: u64 = 0x64FD_D1A4_6201_E246
    for _ in log..two_adicity {
        root = mul(root, root)
    }
    root
}

/// Returns `a` as an element of the extension.
pub fn ext(a: u64) -> Ext {
    Ext { c0: a, c1: 0, c2: 0 }
}

/// Returns `a + b` in the extension.
pub fn ext_add(a: Ext, b: Ext) -> Ext {
    Ext { c0: add(a.c0, b.c0), c1: add(a.c1, b.c1), c2: add(a.c2, b.c2) }
}

/// Returns `a - b` in the extension.
pub fn ext_sub(a: Ext, b: Ext) -> Ext {
    Ext { c0: sub(a.c0, b.c0), c1: sub(a.c1, b.c1), c2: sub(a.c2, b.c2) }
}

/// Returns `-a` in the extension.
pub fn ext_neg(a: Ext) -> Ext {
    Ext { c0: neg(a.c0), c1: neg(a.c1), c2: neg(a.c2) }
}

/// Returns `a * b` in the extension, with `x^3 = x + 1`.
pub fn ext_mul(a: Ext, b: Ext) -> Ext {
    let c0 = mul(a.c0, b.c0)
    let c1 = add(mul(a.c0, b.c1), mul(a.c1, b.c0))
    let c2 = add(add(mul(a.c0, b.c2), mul(a.c1, b.c1)), mul(a.c2, b.c0))
    let c3 = add(mul(a.c1, b.c2), mul(a.c2, b.c1))
    let c4 = mul(a.c2, b.c2)
    Ext { c0: add(c0, c3), c1: add(add(c1, c3), c4), c2: add(c2, c4) }
}

/// Returns `a * k` for a base field element `k`.
pub fn ext_scale(a: Ext, k: u64) -> Ext {
    Ext { c0: mul(a.c0, k), c1: mul(a.c1, k), c2: mul(a.c2, k) }
}

/// Returns whether `a` is zero.
pub fn ext_is_zero(a: Ext) -> bool {
    a.c0 == 0 && a.c1 == 0 && a.c2 == 0
}

/// Returns the inverse of `a`, or 0 for 0, from the cofactors of the matrix of multiplication by `a`.
pub fn ext_inv(a: Ext) -> Ext {
    let m00 = a.c0
    let m10 = a.c1
    let m20 = a.c2
    let m01 = a.c2
    let m11 = add(a.c0, a.c2)
    let m21 = a.c1
    let m02 = a.c1
    let m12 = add(a.c1, a.c2)
    let m22 = add(a.c0, a.c2)
    let k0 = sub(mul(m11, m22), mul(m12, m21))
    let k1 = sub(mul(m12, m20), mul(m10, m22))
    let k2 = sub(mul(m10, m21), mul(m11, m20))
    let det = add(add(mul(m00, k0), mul(m01, k1)), mul(m02, k2))
    let d = inv(det)
    Ext { c0: mul(k0, d), c1: mul(k1, d), c2: mul(k2, d) }
}

/// Returns `a` raised to the power `e` in the extension.
pub fn ext_pow(a: Ext, e: u64) -> Ext {
    var result = ext(1)
    var base = a
    var k = e
    for k > 0 {
        if k & 1 == 1 {
            result = ext_mul(result, base)
        }
        base = ext_mul(base, base)
        k >>= 1
    }
    result
}

/// Returns the inverses of `values`, which must all be nonzero, with one inversion and three multiplications per value.
pub fn ext_batch_inv(values: Ext[]) -> Ext[] {
    var out: Ext[] = []
    var running = ext(1)
    for v in values {
        out.push(running)
        running = ext_mul(running, v)
    }
    var inverse = ext_inv(running)
    var i = values.len
    for i > 0 {
        i -= 1
        out[i] = ext_mul(out[i], inverse)
        inverse = ext_mul(inverse, values[i])
    }
    out
}

/// Returns `sum coefficients[i] x^i` at the base field point `x`.
pub fn evaluate(coefficients: u64[], x: u64) -> u64 {
    var result: u64 = 0
    var i = coefficients.len
    for i > 0 {
        i -= 1
        result = add(mul(result, x), coefficients[i])
    }
    result
}

/// Returns `sum coefficients[i] x^i` at the extension point `x`, for coefficients in the extension.
pub fn ext_evaluate(coefficients: Ext[], x: Ext) -> Ext {
    var result = ext(0)
    var i = coefficients.len
    for i > 0 {
        i -= 1
        result = ext_add(ext_mul(result, x), coefficients[i])
    }
    result
}

/// Returns `sum coefficients[i] x^i` at the extension point `x`, for coefficients in the base field.
pub fn ext_evaluate_base(coefficients: u64[], x: Ext) -> Ext {
    var result = ext(0)
    var i = coefficients.len
    for i > 0 {
        i -= 1
        result = ext_add(ext_mul(result, x), ext(coefficients[i]))
    }
    result
}
