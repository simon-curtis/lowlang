import std/bits

/// The roots of unity of one power-of-two size, for the transforms of this module.
pub struct Twiddles {
    /// The number of points, a power of two up to `2^two_adicity`.
    pub size: i64
    forward: u64[]
    inverse: u64[]
    size_inverse: u64
}

fn powers(root: u64, count: i64) -> u64[] {
    let out: u64[] = __make(count)
    var x: u64 = 1
    for i in 0..count {
        out[i] = x
        x = mul(x, root)
    }
    out
}

/// Returns the roots of unity of order `size`, which must be a power of two in `1..=2^two_adicity`.
pub fn twiddles(size: i64) -> Twiddles {
    let log = bits.trailing_zeros(u64(size))
    let root = root_of_unity(log)
    Twiddles { size, forward: powers(root, size / 2), inverse: powers(inv(root), size / 2), size_inverse: inv(u64(size)) }
}

fn bit_reverse(a: u64[]) {
    let n = a.len
    var j = 0
    for i in 1..n {
        var bit = n >> 1
        for j & bit != 0 {
            j ^= bit
            bit >>= 1
        }
        j ^= bit
        if i < j {
            let t = a[i]
            a[i] = a[j]
            a[j] = t
        }
    }
}

fn transform(size: i64, roots: u64[], a: u64[]) {
    bit_reverse(a)
    var len = 2
    for len <= size {
        let half = len / 2
        let stride = size / len
        var start = 0
        for start < size {
            var k = 0
            for j in 0..half {
                let u = a[start + j]
                let v = mul(a[start + j + half], roots[k])
                a[start + j] = add(u, v)
                a[start + j + half] = sub(u, v)
                k += stride
            }
            start += len
        }
        len *= 2
    }
}

fn scale_powers(a: u64[], base: u64) {
    var x: u64 = 1
    for i in 0..a.len {
        a[i] = mul(a[i], x)
        x = mul(x, base)
    }
}

/// Replaces the coefficients `a` of a polynomial with its values at `w^0, w^1, ..` for `w` the root of unity of order `t.size`. `a.len` must be `t.size`.
pub fn ntt(t: Twiddles, a: u64[]) {
    transform(t.size, t.forward, a)
}

/// Replaces the values `a` at `w^0, w^1, ..` with the coefficients of the polynomial of degree below `t.size` through them, the inverse of `ntt`.
pub fn intt(t: Twiddles, a: u64[]) {
    transform(t.size, t.inverse, a)
    for i in 0..a.len {
        a[i] = mul(a[i], t.size_inverse)
    }
}

/// Replaces the coefficients `a` with the values at `shift * w^0, shift * w^1, ..`, a coset of the subgroup of order `t.size`.
pub fn coset_ntt(t: Twiddles, a: u64[], shift: u64) {
    scale_powers(a, shift)
    ntt(t, a)
}

/// Replaces the values `a` on the coset `shift * w^i` with the coefficients of the polynomial through them, the inverse of `coset_ntt`.
pub fn coset_intt(t: Twiddles, a: u64[], shift: u64) {
    intt(t, a)
    scale_powers(a, inv(shift))
}

fn lane(a: Ext[], k: i64) -> u64[] {
    let out: u64[] = __make(a.len)
    for i in 0..a.len {
        out[i] = match k {
            0 => a[i].c0
            1 => a[i].c1
            _ => a[i].c2
        }
    }
    out
}

fn lanes(a: Ext[], f: fn(u64[])) {
    let x = lane(a, 0)
    let y = lane(a, 1)
    let z = lane(a, 2)
    f(x)
    f(y)
    f(z)
    for i in 0..a.len {
        a[i] = Ext { c0: x[i], c1: y[i], c2: z[i] }
    }
}

/// `ntt` for coefficients in the extension, a transform of each of the three coefficients.
pub fn ext_ntt(t: Twiddles, a: Ext[]) {
    lanes(a, fn(x) ntt(t, x))
}

/// `intt` for values in the extension.
pub fn ext_intt(t: Twiddles, a: Ext[]) {
    lanes(a, fn(x) intt(t, x))
}

/// `coset_ntt` for coefficients in the extension.
pub fn ext_coset_ntt(t: Twiddles, a: Ext[], shift: u64) {
    lanes(a, fn(x) coset_ntt(t, x, shift))
}

/// `coset_intt` for values in the extension.
pub fn ext_coset_intt(t: Twiddles, a: Ext[], shift: u64) {
    lanes(a, fn(x) coset_intt(t, x, shift))
}
