import std/testing

fn test_batch_inverses(t: *testing.T) {
    var values: u64[] = []
    values.push(3)
    values.push(modulus - 1)
    values.push(12345678901)
    let inverses = batch_inv(values)
    for i in 0..values.len {
        t.is_true(mul(values[i], inverses[i]) == 1)
    }
    let xs = [Ext { c0: 5, c1: 6, c2: 7 }, Ext { c0: modulus - 1, c1: 0, c2: 1 }, Ext { c0: 0, c1: 1, c2: 0 }]
    let ext_inverses = ext_batch_inv(xs)
    for i in 0..xs.len {
        t.is_true(ext_mul(xs[i], ext_inverses[i]) == ext(1))
    }
}

fn test_extension_is_a_field(t: *testing.T) {
    let x = Ext { c0: 0, c1: 1, c2: 0 }
    let p1 = ext_pow(x, modulus)
    let p2 = ext_pow(p1, modulus)
    let p3 = ext_pow(p2, modulus)
    t.is_true(p1 != x)
    t.is_true(p3 == x)
    t.is_true(ext_mul(ext_mul(x, x), x) == ext_add(x, ext(1)))
}

