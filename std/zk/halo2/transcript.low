import std/crypto/blake2b
import std/crypto/pasta

/// The failure of a proof operation.
pub enum Error {
    /// The proof is cut short, has bytes left over, holds a field element at or above the modulus, or holds a point that is not on the curve or is the point at infinity.
    Malformed
    /// The proof is well formed and does not verify.
    Rejected
    /// The instance columns do not match the constraint system, or a column holds more values than its usable rows.
    Instance
    /// The constraint system, the assignment or the parameters are inconsistent, as when the circuit has fewer rows than the blinding factors need.
    Circuit
    /// The witness does not satisfy the constraint system, or a lookup input is not in its table.
    Unsatisfied
}

struct Transcript {
    curve: *pasta.Curve
    state: *blake2b.Hasher
    input: u8[]
    at: i64
    output: u8[]
}

fn reader(c: *pasta.Curve, proof: u8[]) -> *Transcript {
    new(Transcript { curve: c, state: blake2b.personalised(bytes("Halo2-Transcript")), input: proof, at: 0, output: [] })
}

fn writer(c: *pasta.Curve) -> *Transcript {
    reader(c, [])
}

fn common_point(t: *Transcript, p: pasta.Point) ! Error {
    let xy = pasta.coordinates(t.curve, p) ?? fail Malformed
    blake2b.update(t.state, [1])
    blake2b.update(t.state, pasta.field_to_bytes(t.curve.base, xy[0]))
    blake2b.update(t.state, pasta.field_to_bytes(t.curve.base, xy[1]))
}

fn common_scalar(t: *Transcript, s: u64[]) {
    blake2b.update(t.state, [2])
    blake2b.update(t.state, pasta.field_to_bytes(t.curve.scalar, s))
}

fn take(t: *Transcript, count: i64) -> u8[] ! Error {
    if t.at + count > t.input.len {
        fail Malformed
    }
    let out = t.input[t.at..t.at + count]
    t.at += count
    out
}

fn read_point(t: *Transcript) -> pasta.Point ! Error {
    let p = pasta.from_bytes(t.curve, take(t, 32)?) ?? fail Malformed
    common_point(t, p)?
    p
}

fn read_scalar(t: *Transcript) -> u64[] ! Error {
    let s = pasta.field_from_bytes(t.curve.scalar, take(t, 32)?) ?? fail Malformed
    common_scalar(t, s)
    s
}

fn write_point(t: *Transcript, p: pasta.Point) ! Error {
    common_point(t, p)?
    for b in pasta.to_bytes(t.curve, p) {
        t.output.push(b)
    }
}

fn write_scalar(t: *Transcript, s: u64[]) {
    common_scalar(t, s)
    for b in pasta.field_to_bytes(t.curve.scalar, s) {
        t.output.push(b)
    }
}

fn squeeze(t: *Transcript) -> u64[] {
    blake2b.update(t.state, [0])
    pasta.field_from_uniform(t.curve.scalar, blake2b.finalize(t.state))
}

fn finished(t: *Transcript) -> bool {
    t.at == t.input.len
}
