import std/crypto/nistec

/// The values a circuit assigns: what `keygen` and `prove` read. `fixed` holds the values of each fixed column and `advice` those of each advice column from row 0, `selectors` the rows where each selector is on, and `equalities` the equality constraints in the order they are made. Build one with a `Layouter`, or directly when the circuit names every cell itself.
pub struct Assignment {
    /// The values of each fixed column, from row 0; rows after the last value are zero.
    pub fixed: u64[][][]
    /// The values of each advice column, from row 0; rows after the last value are zero.
    pub advice: u64[][][]
    /// For each selector, whether it is on in each row from row 0; rows after the last are off.
    pub selectors: bool[][]
    /// The equality constraints, in the order they are made.
    pub equalities: Equal[]
}

/// Lays out the regions of a circuit as the `SimpleFloorPlanner` of `halo2_proofs` 0.3.0 does: each region starts at the first row at which none of the columns and selectors it uses is taken, the constants of a region go to the next free rows of the first constants column once the region is placed, and a table fills its column. Make one with `layouter`, assign cells through `region` and `end_region`, and take the result with `finish`.
pub struct Layouter {
    cs: *ConstraintSystem
    f: *nistec.Field
    usable: i64
    instances: u64[][][]
    out: Assignment
    starts: i64[]
    advice_next: i64[]
    fixed_next: i64[]
    selector_next: i64[]
    tables: i64[]
}

/// A cell a region assigned, with its value. It names the cell by its region and its row within the region, so it can be used in equality constraints once the region is placed, in its own region or in later ones.
pub struct AssignedCell {
    /// The column of the cell.
    pub column: Column
    /// The value assigned to the cell.
    pub value: u64[]
    region: i64
    offset: i64
}

enum Step {
    Value(Column, i64, u64[])
    Enable(Selector, i64)
    Copy(AssignedCell, AssignedCell)
    Public(AssignedCell, Column, i64)
    Constant(u64[], AssignedCell)
}

/// A region being assigned: a group of cells at row offsets from the start of the region, which the layouter places when `end_region` is called.
pub struct Region {
    layouter: *Layouter
    index: i64
    steps: Step[]
}

fn zero_columns(f: *nistec.Field, count: i64, rows: i64) -> u64[][][] {
    var out: u64[][][] = []
    for _ in 0..count {
        out.push(zeros(f, rows))
    }
    out
}

fn counters(count: i64) -> i64[] {
    var out: i64[] = []
    for _ in 0..count {
        out.push(0)
    }
    out
}

/// Returns a layouter for the circuit `cs` over the rows of `p`. `instances` holds the values of each instance column that `assign_advice_from_instance` reads; give `[]` where they are not known, as when deriving the key, and the cells read are zero.
pub fn layouter(p: *Params, cs: *ConstraintSystem, instances: u64[][][]) -> *Layouter {
    let f = p.curve.scalar
    let usable = p.n - (blinding_factors(cs) + 1)
    var selectors: bool[][] = []
    for _ in cs.selectors {
        var rows: bool[] = []
        for _ in 0..usable {
            rows.push(false)
        }
        selectors.push(rows)
    }
    new(Layouter {
        cs,
        f,
        usable,
        instances,
        out: Assignment {
            fixed: zero_columns(f, cs.fixed_columns, usable),
            advice: zero_columns(f, cs.advice_columns, usable),
            selectors,
            equalities: [],
        },
        starts: [],
        advice_next: counters(cs.advice_columns),
        fixed_next: counters(cs.fixed_columns),
        selector_next: counters(cs.selectors.len),
        tables: [],
    })
}

/// Returns the values the layouter assigned.
pub fn finish(l: *Layouter) -> Assignment {
    l.out
}

/// Starts a region. Assign its cells at offsets from 0 and place it with `end_region` before starting the next one.
pub fn region(l: *Layouter) -> *Region {
    new(Region { layouter: l, index: l.starts.len, steps: [] })
}

fn cell_in(r: *Region, column: Column, offset: i64, value: u64[]) -> AssignedCell {
    AssignedCell { column, value, region: r.index, offset }
}

/// Assigns `value` to the cell of the advice column `column` at `offset` in the region.
pub fn assign_advice(r: *Region, column: Column, offset: i64, value: u64[]) -> AssignedCell {
    r.steps.push(Value(column, offset, value))
    cell_in(r, column, offset, value)
}

/// Assigns `value` to the cell of the fixed column `column` at `offset` in the region.
pub fn assign_fixed(r: *Region, column: Column, offset: i64, value: u64[]) -> AssignedCell {
    r.steps.push(Value(column, offset, value))
    cell_in(r, column, offset, value)
}

/// Turns the selector `s` on in the row at `offset` in the region.
pub fn enable_selector(r: *Region, s: Selector, offset: i64) {
    r.steps.push(Enable(s, offset))
}

/// Constrains the cells `a` and `b` to hold the same value. Both columns must have equality enabled.
pub fn constrain_equal(r: *Region, a: AssignedCell, b: AssignedCell) {
    r.steps.push(Copy(a, b))
}

/// Constrains the cell `cell` to hold `value`, through a cell of the first constants column that the layouter assigns when it places the region.
pub fn constrain_constant(r: *Region, cell: AssignedCell, value: u64[]) {
    r.steps.push(Constant(value, cell))
}

/// Assigns the value of the cell `source` to the advice column `column` at `offset` in the region and constrains the two cells to be equal.
pub fn copy_advice(r: *Region, source: AssignedCell, column: Column, offset: i64) -> AssignedCell {
    let copy = assign_advice(r, column, offset, source.value)
    constrain_equal(r, copy, source)
    copy
}

/// Assigns the constant `value` to the advice column `column` at `offset` in the region and constrains the cell to it, as `constrain_constant` does.
pub fn assign_advice_from_constant(r: *Region, column: Column, offset: i64, value: u64[]) -> AssignedCell {
    let cell = assign_advice(r, column, offset, value)
    constrain_constant(r, cell, value)
    cell
}

/// Assigns the public input in `row` of the instance column `instance` to the advice column `column` at `offset` in the region and constrains the two cells to be equal.
pub fn assign_advice_from_instance(r: *Region, instance: Column, row: i64, column: Column, offset: i64) -> AssignedCell {
    let l = r.layouter
    var value = zero(l.f)
    if instance.index < l.instances.len && row >= 0 && row < l.instances[instance.index].len {
        value = l.instances[instance.index][row]
    }
    let cell = assign_advice(r, column, offset, value)
    r.steps.push(Public(cell, instance, row))
    cell
}

fn next_rows(l: *Layouter, kind: Kind) -> i64[] {
    match kind {
        Advice => l.advice_next
        Fixed => l.fixed_next
        Instance => []
    }
}

fn claim(l: *Layouter, kind: Kind, index: i64, row: i64) {
    match kind {
        Advice => { l.advice_next[index] = row }
        Fixed => { l.fixed_next[index] = row }
        Instance => {}
    }
}

fn region_start(l: *Layouter, steps: Step[]) -> i64 ! Error {
    var start = 0
    for step in steps {
        match step {
            Value(column, offset, _) => {
                let next = next_rows(l, column.kind)
                if column.index < 0 || column.index >= next.len || offset < 0 {
                    fail Circuit
                }
                start = max_of(start, next[column.index])
            }
            Enable(s, offset) => {
                if s.index < 0 || s.index >= l.selector_next.len || offset < 0 {
                    fail Circuit
                }
                start = max_of(start, l.selector_next[s.index])
            }
            _ => {}
        }
    }
    start
}

fn claim_rows(l: *Layouter, steps: Step[], end: i64) {
    for step in steps {
        match step {
            Value(column, _, _) => claim(l, column.kind, column.index, end)
            Enable(s, _) => { l.selector_next[s.index] = end }
            _ => {}
        }
    }
}

fn region_height(steps: Step[]) -> i64 {
    var height = 0
    for step in steps {
        match step {
            Value(_, offset, _) => { height = max_of(height, offset + 1) }
            Enable(_, offset) => { height = max_of(height, offset + 1) }
            _ => {}
        }
    }
    height
}

fn absolute(l: *Layouter, c: AssignedCell) -> Cell ! Error {
    if c.region < 0 || c.region >= l.starts.len {
        fail Circuit
    }
    let row = l.starts[c.region] + c.offset
    if row >= l.usable {
        fail Circuit
    }
    Cell { column: c.column, row }
}

fn put(l: *Layouter, column: Column, row: i64, value: u64[]) ! Error {
    if row >= l.usable {
        fail Circuit
    }
    match column.kind {
        Advice => { l.out.advice[column.index][row] = value }
        Fixed => { l.out.fixed[column.index][row] = value }
        Instance => { fail Circuit }
    }
}

fn copy_cells(l: *Layouter, a: Cell, b: Cell) {
    l.out.equalities.push(Equal { a, b })
}

/// Places the region `r` and assigns its cells, then assigns its constants to the first constants column, each constrained equal to the cell that asked for it.
/// Fails with `Circuit` when a cell falls beyond the usable rows, a column, selector or cell does not exist or belongs to a region not yet placed, a region assigns an instance column, or a region asks for a constant and the circuit has no constants column.
pub fn end_region(r: *Region) ! Error {
    let l = r.layouter
    if r.index != l.starts.len {
        fail Circuit
    }
    let start = region_start(l, r.steps)?
    l.starts.push(start)
    claim_rows(l, r.steps, start + region_height(r.steps))
    var constants: Step[] = []
    for step in r.steps {
        match step {
            Value(column, offset, value) => put(l, column, start + offset, value)?
            Enable(s, offset) => {
                if start + offset >= l.usable {
                    fail Circuit
                }
                l.out.selectors[s.index][start + offset] = true
            }
            Copy(a, b) => copy_cells(l, absolute(l, a)?, absolute(l, b)?)
            Public(cell, instance, row) => {
                if row < 0 || row >= l.usable {
                    fail Circuit
                }
                copy_cells(l, absolute(l, cell)?, Cell { column: instance, row })
            }
            Constant(_, _) => constants.push(step)
        }
    }
    if constants.len == 0 {
        return
    }
    if l.cs.constants.len == 0 {
        fail Circuit
    }
    let column = l.cs.constants[0]
    for step in constants {
        match step {
            Constant(value, cell) => {
                let row = l.fixed_next[column.index]
                put(l, column, row, value)?
                copy_cells(l, Cell { column, row }, absolute(l, cell)?)
                l.fixed_next[column.index] = row + 1
            }
            _ => {}
        }
    }
}

/// Constrains the cell `cell` to equal the public input in `row` of the instance column `instance`.
/// Fails with `Circuit` when the cell's region is not placed or a row falls beyond the usable rows.
pub fn constrain_instance(l: *Layouter, cell: AssignedCell, instance: Column, row: i64) ! Error {
    if row < 0 || row >= l.usable {
        fail Circuit
    }
    copy_cells(l, absolute(l, cell)?, Cell { column: instance, row })
}

/// Loads a lookup table into the fixed column `column`: `values` from row 0, and the first value in every usable row after them.
/// Fails with `Circuit` when `values` is empty or longer than the usable rows, the column is not a fixed column, or it already holds a table.
pub fn assign_table(l: *Layouter, column: Column, values: u64[][]) ! Error {
    if values.len == 0 || values.len > l.usable || kind_number(column.kind) != kind_number(Fixed) || column.index < 0 || column.index >= l.cs.fixed_columns {
        fail Circuit
    }
    for existing in l.tables {
        if existing == column.index {
            fail Circuit
        }
    }
    l.tables.push(column.index)
    for row in 0..l.usable {
        let value = if row < values.len { values[row] } else { values[0] }
        l.out.fixed[column.index][row] = value
    }
}
