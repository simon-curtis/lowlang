import std/crypto
import std/crypto/nistec
import std/crypto/pasta
import std/zk/halo2

struct Factoring {
    cs: *halo2.ConstraintSystem
    a: halo2.Column
    b: halo2.Column
    c: halo2.Column
    product: halo2.Column
    multiply: halo2.Selector
}

fn element(f: *nistec.Field, value: u64) -> u64[] {
    pasta.field_from_u64(f, value)
}

fn factoring() -> Factoring {
    let cs = halo2.constraint_system()
    let a = halo2.advice_column(cs)
    let b = halo2.advice_column(cs)
    let c = halo2.advice_column(cs)
    let product = halo2.instance_column(cs)
    halo2.enable_equality(cs, c)
    halo2.enable_equality(cs, product)
    let multiply = halo2.selector(cs)
    let constraint = halo2.sub(halo2.mul(halo2.query_advice(cs, a, 0), halo2.query_advice(cs, b, 0)), halo2.query_advice(cs, c, 0))
    halo2.create_gate(cs, [halo2.mul(halo2.query_selector(multiply), constraint)])
    Factoring { cs, a, b, c, product, multiply }
}

fn assign(params: *halo2.Params, circuit: Factoring, x: u64, y: u64) -> halo2.Assignment ! halo2.Error {
    let f = params.curve.scalar
    let l = halo2.layouter(params, circuit.cs, [])
    let r = halo2.region(l)
    halo2.enable_selector(r, circuit.multiply, 0)
    halo2.assign_advice(r, circuit.a, 0, element(f, x))
    halo2.assign_advice(r, circuit.b, 0, element(f, y))
    let out = halo2.assign_advice(r, circuit.c, 0, element(f, x * y))
    halo2.end_region(r)?
    halo2.constrain_instance(l, out, circuit.product, 0)?
    halo2.finish(l)
}

fn main() ! halo2.Error {
    let curve = pasta.vesta()
    let f = curve.scalar
    let params = halo2.params(curve, 4)
    let circuit = factoring()
    let pk = halo2.keygen(params, circuit.cs, assign(params, circuit, 0, 0)?)?
    print("circuit of {params.n} rows, degree {halo2.degree(circuit.cs)}")

    let fifteen = [[[element(f, 15)]]]
    let proof = halo2.prove(params, pk, [assign(params, circuit, 3, 5)?], fifteen, crypto.random)?
    print("proof of {proof.len} bytes that 15 has two factors known to the prover")
    print("  accepted for 15: {accepts(params, pk.vk, fifteen, proof)}")
    print("  accepted for 21: {accepts(params, pk.vk, [[[element(f, 21)]]], proof)}")
    print("  proving 3 * 4 = 15 fails: {refused(params, pk, [assign(params, circuit, 3, 4)?], fifteen)}")

    let both = [[[element(f, 15)]], [[element(f, 21)]]]
    let pair = halo2.prove(params, pk, [assign(params, circuit, 3, 5)?, assign(params, circuit, 3, 7)?], both, crypto.random)?
    print("one proof of {pair.len} bytes for 15 and 21: {accepts(params, pk.vk, both, pair)}")
}

fn accepts(params: *halo2.Params, vk: *halo2.VerifyingKey, instances: u64[][][][], proof: u8[]) -> bool {
    halo2.verify(params, vk, instances, proof) or return false
    true
}

fn refused(params: *halo2.Params, pk: *halo2.ProvingKey, circuits: halo2.Assignment[], instances: u64[][][][]) -> bool {
    halo2.prove(params, pk, circuits, instances, crypto.random) or return true
    false
}
