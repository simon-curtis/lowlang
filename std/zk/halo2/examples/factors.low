import std/crypto
import std/crypto/nistec
import std/crypto/pasta
import std/zk/halo2

struct Circuit {
    cs: *halo2.ConstraintSystem
    fixed: u64[][][]
    equalities: halo2.Equal[]
}

fn element(f: *nistec.Field, value: u64) -> u64[] {
    pasta.field_from_u64(f, value)
}

fn factoring(f: *nistec.Field) -> Circuit {
    let cs = halo2.constraint_system()
    let a = halo2.advice_column(cs)
    let b = halo2.advice_column(cs)
    let c = halo2.advice_column(cs)
    let q = halo2.fixed_column(cs)
    let product = halo2.instance_column(cs)
    halo2.enable_equality(cs, c)
    halo2.enable_equality(cs, product)
    let constraint = halo2.sub(halo2.mul(halo2.query_advice(cs, a, 0), halo2.query_advice(cs, b, 0)), halo2.query_advice(cs, c, 0))
    halo2.create_gate(cs, [halo2.mul(halo2.query_fixed(cs, q, 0), constraint)])
    Circuit {
        cs,
        fixed: [[element(f, 1)]],
        equalities: [halo2.Equal { a: halo2.Cell { column: c, row: 0 }, b: halo2.Cell { column: product, row: 0 } }],
    }
}

fn main() ! halo2.Error {
    let curve = pasta.vesta()
    let f = curve.scalar
    let params = halo2.params(curve, 4)
    let circuit = factoring(f)
    let pk = halo2.keygen(params, circuit.cs, circuit.fixed, circuit.equalities)?
    print("circuit of {params.n} rows, degree {halo2.degree(circuit.cs)}")

    let factors = [[element(f, 3)], [element(f, 5)], [element(f, 15)]]
    let product = [[element(f, 15)]]
    let proof = halo2.prove(params, pk, factors, product, crypto.random)?
    print("proof of {proof.len} bytes that 15 has two factors known to the prover")
    print("  accepted for 15: {accepts(params, pk.vk, product, proof)}")
    print("  accepted for 21: {accepts(params, pk.vk, [[element(f, 21)]], proof)}")

    let wrong = [[element(f, 3)], [element(f, 4)], [element(f, 15)]]
    print("  proving 3 * 4 = 15 fails: {refused(params, pk, wrong, product)}")
}

fn accepts(params: *halo2.Params, vk: *halo2.VerifyingKey, instances: u64[][][], proof: u8[]) -> bool {
    halo2.verify(params, vk, instances, proof) or return false
    true
}

fn refused(params: *halo2.Params, pk: *halo2.ProvingKey, advice: u64[][][], instances: u64[][][]) -> bool {
    halo2.prove(params, pk, advice, instances, crypto.random) or return true
    false
}
