import std/crypto/nistec

struct Plan {
    ids: i64[]
    set_of: i64[]
    members: i64[][]
    positions: i64[][]
    sets: u64[][][]
}

fn same_list(a: i64[], b: i64[]) -> bool {
    if a.len != b.len {
        return false
    }
    for i in 0..a.len {
        if a[i] != b[i] {
            return false
        }
    }
    true
}

fn position_of(list: i64[], value: i64) -> i64 {
    for i, v in list {
        if v == value {
            return i
        }
    }
    -1
}

fn sorted(values: i64[]) -> i64[] {
    var out: i64[] = []
    for v in values {
        out.push(v)
    }
    for i in 1..out.len {
        var j = i
        for j > 0 && out[j - 1] > out[j] {
            let held = out[j]
            out[j] = out[j - 1]
            out[j - 1] = held
            j -= 1
        }
    }
    out
}

fn point_position(points: u64[][], point: u64[]) -> i64 {
    for i, p in points {
        if same(p, point) {
            return i
        }
    }
    -1
}

fn plan(ids: i64[], points: u64[][]) -> Plan {
    var unique: u64[][] = []
    var query_point: i64[] = []
    var order: i64[] = []
    var members: i64[][] = []
    for q in 0..ids.len {
        var at = point_position(unique, points[q])
        if at < 0 {
            unique.push(points[q])
            at = unique.len - 1
        }
        query_point.push(at)
        var owner = position_of(order, ids[q])
        if owner < 0 {
            order.push(ids[q])
            members.push([])
            owner = order.len - 1
        }
        members[owner].push(q)
    }
    var set_keys: i64[][] = []
    var set_of: i64[] = []
    var positions: i64[][] = []
    for owner in 0..order.len {
        var indices: i64[] = []
        for q in members[owner] {
            indices.push(query_point[q])
        }
        let key = sorted(indices)
        var found = -1
        for s, existing in set_keys {
            if same_list(existing, key) {
                found = s
            }
        }
        if found < 0 {
            set_keys.push(key)
            found = set_keys.len - 1
        }
        set_of.push(found)
        var places: i64[] = []
        for index in indices {
            places.push(position_of(key, index))
        }
        positions.push(places)
    }
    var sets: u64[][][] = []
    for key in set_keys {
        var set_points: u64[][] = []
        for index in key {
            set_points.push(unique[index])
        }
        sets.push(set_points)
    }
    Plan { ids: order, set_of, members, positions, sets }
}

fn interpolate_at(f: *nistec.Field, points: u64[][], evals: u64[][], x: u64[]) -> u64[] {
    var out = zero(f)
    for j in 0..points.len {
        var numerator = one(f)
        var denominator = one(f)
        for m in 0..points.len {
            if m != j {
                numerator = prod(f, numerator, diff(f, x, points[m]))
                denominator = prod(f, denominator, diff(f, points[j], points[m]))
            }
        }
        out = sum(f, out, prod(f, evals[j], prod(f, numerator, inverse(f, denominator))))
    }
    out
}
