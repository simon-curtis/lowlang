import std/crypto/nistec
import std/crypto/pasta

fn sum(f: *nistec.Field, a: u64[], b: u64[]) -> u64[] {
    pasta.field_add(f, a, b)
}

fn diff(f: *nistec.Field, a: u64[], b: u64[]) -> u64[] {
    pasta.field_sub(f, a, b)
}

fn prod(f: *nistec.Field, a: u64[], b: u64[]) -> u64[] {
    pasta.field_mul(f, a, b)
}

fn square(f: *nistec.Field, a: u64[]) -> u64[] {
    pasta.field_square(f, a)
}

fn negate(f: *nistec.Field, a: u64[]) -> u64[] {
    pasta.field_neg(f, a)
}

fn inverse(f: *nistec.Field, a: u64[]) -> u64[] {
    pasta.field_invert(f, a)
}

fn zero(f: *nistec.Field) -> u64[] {
    pasta.field_zero(f)
}

fn one(f: *nistec.Field) -> u64[] {
    pasta.field_one(f)
}

fn number(f: *nistec.Field, value: i64) -> u64[] {
    pasta.field_from_u64(f, u64(value))
}

fn zeros(f: *nistec.Field, count: i64) -> u64[][] {
    var out: u64[][] = []
    for _ in 0..count {
        out.push(zero(f))
    }
    out
}

fn power(f: *nistec.Field, a: u64[], exponent: i64) -> u64[] {
    pasta.field_pow(f, a, [u64(exponent)])
}

fn is_zero(a: u64[]) -> bool {
    pasta.field_is_zero(a)
}

fn same(a: u64[], b: u64[]) -> bool {
    pasta.field_equal(a, b)
}
