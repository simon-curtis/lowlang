import std/crypto/blake2b
import std/crypto/nistec
import std/crypto/pasta
import std/text

fn join(parts: str[], separator: str) -> str {
    var out = ""
    for i, part in parts {
        if i == 0 {
            out = part
        } else {
            out = "{out}{separator}{part}"
        }
    }
    out
}

fn list(parts: str[]) -> str {
    "[{join(parts, ", ")}]"
}

fn hex_bytes(f: *nistec.Field, a: u64[]) -> str {
    let le = pasta.field_to_bytes(f, a)
    var be: u8[] = []
    var i = le.len - 1
    for i >= 0 {
        be.push(le[i])
        i -= 1
    }
    "0x{text.encode_hex(be)}"
}

fn pinned_query(kind: str, q: Query) -> str {
    "{kind} {{ query_index: {q.index}, column_index: {q.column}, rotation: Rotation({q.rotation}) }}"
}

fn pinned_expr(f: *nistec.Field, e: Expr) -> str {
    match e {
        Constant(v) => "Constant({hex_bytes(f, v)})"
        Fixed(q) => pinned_query("Fixed", q)
        Advice(q) => pinned_query("Advice", q)
        Instance(q) => pinned_query("Instance", q)
        Negated(a) => "Negated({pinned_expr(f, *a)})"
        Sum(a, b) => "Sum({pinned_expr(f, *a)}, {pinned_expr(f, *b)})"
        Product(a, b) => "Product({pinned_expr(f, *a)}, {pinned_expr(f, *b)})"
        Scaled(a, s) => "Scaled({pinned_expr(f, *a)}, {hex_bytes(f, s)})"
    }
}

fn kind_name(kind: Kind) -> str {
    match kind {
        Advice => "Advice"
        Fixed => "Fixed"
        Instance => "Instance"
    }
}

fn pinned_column(index: i64, kind: Kind) -> str {
    "Column {{ index: {index}, column_type: {kind_name(kind)} }}"
}

fn pinned_queries(queries: Rotated[], kind: Kind) -> str {
    var parts: str[] = []
    for q in queries {
        parts.push("({pinned_column(q.column, kind)}, Rotation({q.rotation}))")
    }
    list(parts)
}

fn pinned_expressions(f: *nistec.Field, exprs: Expr[]) -> str {
    var parts: str[] = []
    for e in exprs {
        parts.push(pinned_expr(f, e))
    }
    list(parts)
}

fn pinned_points(c: *pasta.Curve, points: pasta.Point[]) -> str {
    var parts: str[] = []
    for p in points {
        let xy = pasta.coordinates(c, p) ?? panic("the point at infinity cannot be pinned")
        parts.push("({hex_bytes(c.base, xy[0])}, {hex_bytes(c.base, xy[1])})")
    }
    list(parts)
}

fn pinned_constraint_system(f: *nistec.Field, cs: *ConstraintSystem) -> str {
    var gates: str[] = []
    for g in cs.gates {
        gates.push(pinned_expr(f, g))
    }
    var columns: str[] = []
    for column in cs.permutation {
        columns.push(pinned_column(column.index, column.kind))
    }
    var lookups: str[] = []
    for l in cs.lookups {
        lookups.push("Argument {{ input_expressions: {pinned_expressions(f, l.input)}, table_expressions: {pinned_expressions(f, l.table)} }}")
    }
    "PinnedConstraintSystem {{ num_fixed_columns: {cs.fixed_columns}, num_advice_columns: {cs.advice_columns}, num_instance_columns: {cs.instance_columns}, num_selectors: 0, gates: {list(gates)}, advice_queries: {pinned_queries(cs.advice_queries, Advice)}, instance_queries: {pinned_queries(cs.instance_queries, Instance)}, fixed_queries: {pinned_queries(cs.fixed_queries, Fixed)}, permutation: Argument {{ columns: {list(columns)} }}, lookups: {list(lookups)}, constants: [], minimum_degree: None }}"
}

/// Returns the description of the verifying key that `halo2_proofs` 0.3.0 hashes into the transcript: the Rust `Debug` text of its pinned form, with the moduli, the domain, the constraint system and the fixed and permutation commitments.
pub fn pinned(vk: *VerifyingKey) -> str {
    let c = vk.curve
    let d = vk.domain
    let domain = "PinnedEvaluationDomain {{ k: {d.k}, extended_k: {d.extended_k}, omega: {hex_bytes(c.scalar, d.omega)} }}"
    "PinnedVerificationKey {{ base_modulus: \"{hex_modulus(c.base)}\", scalar_modulus: \"{hex_modulus(c.scalar)}\", domain: {domain}, cs: {pinned_constraint_system(c.scalar, vk.cs)}, fixed_commitments: {pinned_points(c, vk.fixed_commitments)}, permutation: VerifyingKey {{ commitments: {pinned_points(c, vk.permutation_commitments)} }} }}"
}

fn hex_modulus(f: *nistec.Field) -> str {
    let minus_one = negate(f, one(f))
    let plain = pasta.field_to_plain(f, minus_one)
    var le: u8[] = []
    for limb in plain {
        for i in 0..8 {
            le.push(u8(limb >> u64(8 * i)))
        }
    }
    var be: u8[] = []
    var i = le.len - 1
    for i >= 0 {
        be.push(le[i])
        i -= 1
    }
    var carry = 1
    var j = be.len - 1
    for j >= 0 && carry > 0 {
        let total = i64(be[j]) + carry
        be[j] = u8(total & 255)
        carry = total >> 8
        j -= 1
    }
    "0x{text.encode_hex(be)}"
}

/// The scalar that stands for the verifying key in the transcript.
fn vk_representative(vk: *VerifyingKey) -> u64[] {
    let text = pinned(vk)
    let hasher = blake2b.personalised(bytes("Halo2-Verify-Key"))
    var length: u8[] = []
    for i in 0..8 {
        length.push(u8(text.len >> (8 * i)))
    }
    blake2b.update(hasher, length)
    blake2b.update(hasher, bytes(text))
    pasta.field_from_uniform(vk.curve.scalar, blake2b.finalize(hasher))
}
