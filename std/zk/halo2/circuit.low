import std/crypto/nistec

/// The kind of a column of the constraint system.
pub enum Kind {
    /// A column the prover fills with its witness.
    Advice
    /// A column fixed by the circuit.
    Fixed
    /// A column of public inputs.
    Instance
}

/// A column of one kind, numbered from 0 in the order its kind was added.
pub struct Column {
    /// The kind of the column.
    pub kind: Kind
    /// The number of the column among the columns of its kind.
    pub index: i64
}

/// A column read at a row offset: the cell `rotation` rows after the current one, wrapping around the `n` rows. `index` numbers the distinct queries of the kind in the order they were first made, and `column` is the column read.
pub struct Query {
    /// The number of the query among the queries of its kind.
    pub index: i64
    /// The number of the column that is read.
    pub column: i64
    /// The row offset of the cell that is read.
    pub rotation: i64
}

/// A selector: a fixed column of zeros and ones that switches gates on in the rows where a region enables it. `keygen` combines the selectors into fixed columns as `halo2_proofs` does. A simple selector may only multiply a gate's expression, never take part in a sum or a lookup, and selectors that are never on in the same row share a column; a complex selector may appear anywhere and gets a column of its own.
pub struct Selector {
    /// The number of the selector in the order selectors were added.
    pub index: i64
    /// Whether the selector is simple.
    pub simple: bool
}

/// A polynomial expression over cells of the columns. `Constant` and `Scaled` hold elements of the scalar field of the curve in Montgomery form; build expressions with `constant`, `query_selector`, `query_advice`, `query_fixed`, `query_instance`, `neg`, `add`, `sub`, `mul` and `scale`.
pub enum Expr {
    /// A field element.
    Constant(u64[])
    /// A selector, which `keygen` replaces with a query of the fixed column it is combined into.
    Selected(Selector)
    /// A cell of a fixed column.
    Fixed(Query)
    /// A cell of an advice column.
    Advice(Query)
    /// A cell of an instance column.
    Instance(Query)
    /// The negation of an expression.
    Negated(*Expr)
    /// The sum of two expressions.
    Sum(*Expr, *Expr)
    /// The product of two expressions.
    Product(*Expr, *Expr)
    /// An expression multiplied by a field element.
    Scaled(*Expr, u64[])
}

/// The field element `value`, in Montgomery form, as a constant expression.
pub fn constant(value: u64[]) -> Expr {
    Constant(value)
}

/// Returns `-a`.
pub fn neg(a: Expr) -> Expr {
    Negated(new(a))
}

/// Returns `a + b`.
pub fn add(a: Expr, b: Expr) -> Expr {
    Sum(new(a), new(b))
}

/// Returns `a - b`, built as `a + (-b)`.
pub fn sub(a: Expr, b: Expr) -> Expr {
    Sum(new(a), new(neg(b)))
}

/// Returns `a * b`.
pub fn mul(a: Expr, b: Expr) -> Expr {
    Product(new(a), new(b))
}

/// Returns `a` times the field element `factor`.
pub fn scale(a: Expr, factor: u64[]) -> Expr {
    Scaled(new(a), factor)
}

struct Rotated {
    column: i64
    rotation: i64
}

struct Lookup {
    input: Expr[]
    table: Expr[]
}

/// The columns, selectors, gates, queries, equality-enabled columns, constants columns and lookups of a circuit. Make one with `constraint_system`, add columns and constraints with the functions below, and assign the cells with a `Layouter` or an `Assignment`.
pub struct ConstraintSystem {
    fixed_columns: i64
    advice_columns: i64
    instance_columns: i64
    selectors: bool[]
    constants: Column[]
    gates: Expr[]
    advice_queries: Rotated[]
    instance_queries: Rotated[]
    fixed_queries: Rotated[]
    advice_query_counts: i64[]
    permutation: Column[]
    lookups: Lookup[]
}

/// Returns a constraint system with no columns.
pub fn constraint_system() -> *ConstraintSystem {
    new(ConstraintSystem {
        fixed_columns: 0,
        advice_columns: 0,
        instance_columns: 0,
        selectors: [],
        constants: [],
        gates: [],
        advice_queries: [],
        instance_queries: [],
        fixed_queries: [],
        advice_query_counts: [],
        permutation: [],
        lookups: [],
    })
}

/// Adds an advice column.
pub fn advice_column(cs: *ConstraintSystem) -> Column {
    cs.advice_columns += 1
    cs.advice_query_counts.push(0)
    Column { kind: Advice, index: cs.advice_columns - 1 }
}

/// Adds a fixed column.
pub fn fixed_column(cs: *ConstraintSystem) -> Column {
    cs.fixed_columns += 1
    Column { kind: Fixed, index: cs.fixed_columns - 1 }
}

/// Adds an instance column.
pub fn instance_column(cs: *ConstraintSystem) -> Column {
    cs.instance_columns += 1
    Column { kind: Instance, index: cs.instance_columns - 1 }
}

/// Adds a simple selector.
pub fn selector(cs: *ConstraintSystem) -> Selector {
    cs.selectors.push(true)
    Selector { index: cs.selectors.len - 1, simple: true }
}

/// Adds a complex selector.
pub fn complex_selector(cs: *ConstraintSystem) -> Selector {
    cs.selectors.push(false)
    Selector { index: cs.selectors.len - 1, simple: false }
}

/// Returns the selector `s` in the current row as an expression.
pub fn query_selector(s: Selector) -> Expr {
    Selected(s)
}

/// Makes the fixed column `column` hold the constants that regions assign with `assign_advice_from_constant` and `constrain_constant`, and enables equality on it. The layouter places constants in the first such column.
pub fn enable_constant(cs: *ConstraintSystem, column: Column) {
    for existing in cs.constants {
        if same_column(existing, column) {
            return
        }
    }
    cs.constants.push(column)
    enable_equality(cs, column)
}

fn query_index(queries: Rotated[], column: i64, rotation: i64) -> i64 {
    for i, q in queries {
        if q.column == column && q.rotation == rotation {
            return i
        }
    }
    -1
}

fn advice_query(cs: *ConstraintSystem, column: i64, rotation: i64) -> i64 {
    let found = query_index(cs.advice_queries, column, rotation)
    if found >= 0 {
        return found
    }
    cs.advice_queries.push(Rotated { column, rotation })
    cs.advice_query_counts[column] += 1
    cs.advice_queries.len - 1
}

fn instance_query(cs: *ConstraintSystem, column: i64, rotation: i64) -> i64 {
    let found = query_index(cs.instance_queries, column, rotation)
    if found >= 0 {
        return found
    }
    cs.instance_queries.push(Rotated { column, rotation })
    cs.instance_queries.len - 1
}

fn fixed_query(cs: *ConstraintSystem, column: i64, rotation: i64) -> i64 {
    let found = query_index(cs.fixed_queries, column, rotation)
    if found >= 0 {
        return found
    }
    cs.fixed_queries.push(Rotated { column, rotation })
    cs.fixed_queries.len - 1
}

/// Returns the cell of the advice column `column` that is `rotation` rows after the current row.
pub fn query_advice(cs: *ConstraintSystem, column: Column, rotation: i64) -> Expr {
    Advice(Query { index: advice_query(cs, column.index, rotation), column: column.index, rotation })
}

/// Returns the cell of the instance column `column` that is `rotation` rows after the current row.
pub fn query_instance(cs: *ConstraintSystem, column: Column, rotation: i64) -> Expr {
    Instance(Query { index: instance_query(cs, column.index, rotation), column: column.index, rotation })
}

/// Returns the cell of the fixed column `column` that is `rotation` rows after the current row.
pub fn query_fixed(cs: *ConstraintSystem, column: Column, rotation: i64) -> Expr {
    Fixed(Query { index: fixed_query(cs, column.index, rotation), column: column.index, rotation })
}

/// Lets cells of `column` be constrained equal to cells of other enabled columns.
pub fn enable_equality(cs: *ConstraintSystem, column: Column) {
    match column.kind {
        Advice => { advice_query(cs, column.index, 0) }
        Fixed => { fixed_query(cs, column.index, 0) }
        Instance => { instance_query(cs, column.index, 0) }
    }
    for existing in cs.permutation {
        if same_column(existing, column) {
            return
        }
    }
    cs.permutation.push(column)
}

fn same_column(a: Column, b: Column) -> bool {
    kind_number(a.kind) == kind_number(b.kind) && a.index == b.index
}

fn kind_number(kind: Kind) -> i64 {
    match kind {
        Advice => 0
        Fixed => 1
        Instance => 2
    }
}

/// Adds a gate: every expression of `constraints` must be zero in every usable row.
pub fn create_gate(cs: *ConstraintSystem, constraints: Expr[]) {
    for c in constraints {
        cs.gates.push(c)
    }
}

/// Adds a lookup argument: in every usable row the values of `input` must appear as a row of the values of `table`.
pub fn lookup(cs: *ConstraintSystem, input: Expr[], table: Expr[]) {
    cs.lookups.push(Lookup { input, table })
}

fn max_of(a: i64, b: i64) -> i64 {
    if a > b { a } else { b }
}

fn expr_degree(e: Expr) -> i64 {
    match e {
        Constant(_) => 0
        Selected(_) => 1
        Fixed(_) => 1
        Advice(_) => 1
        Instance(_) => 1
        Negated(a) => expr_degree(*a)
        Sum(a, b) => max_of(expr_degree(*a), expr_degree(*b))
        Product(a, b) => expr_degree(*a) + expr_degree(*b)
        Scaled(a, _) => expr_degree(*a)
    }
}

fn lookup_degree(l: Lookup) -> i64 {
    var input = 1
    for e in l.input {
        input = max_of(input, expr_degree(e))
    }
    var table = 1
    for e in l.table {
        table = max_of(table, expr_degree(e))
    }
    max_of(4, 2 + input + table)
}

/// Returns the degree of the constraint system: the largest degree of a gate, of a lookup argument (`2 + input + table`, at least 4) and of the permutation argument (3). The quotient polynomial is cut into `degree - 1` pieces.
pub fn degree(cs: *ConstraintSystem) -> i64 {
    var out = 3
    for l in cs.lookups {
        out = max_of(out, lookup_degree(l))
    }
    for g in cs.gates {
        out = max_of(out, expr_degree(g))
    }
    out
}

/// Returns the number of rows at the end of the circuit that hold random values in the advice columns: the largest number of queries of one advice column, at least 3, plus 2.
pub fn blinding_factors(cs: *ConstraintSystem) -> i64 {
    var most = 1
    if cs.advice_query_counts.len > 0 {
        most = 0
        for count in cs.advice_query_counts {
            most = max_of(most, count)
        }
    }
    max_of(3, most) + 2
}

/// Returns the smallest number of rows a circuit needs: the blinding factors and three more.
pub fn minimum_rows(cs: *ConstraintSystem) -> i64 {
    blinding_factors(cs) + 3
}

fn evaluate_expr(f: *nistec.Field, e: Expr, fixed: u64[][], advice: u64[][], instance: u64[][]) -> u64[] {
    match e {
        Constant(v) => v
        Selected(_) => panic("keygen replaces every selector")
        Fixed(q) => fixed[q.index]
        Advice(q) => advice[q.index]
        Instance(q) => instance[q.index]
        Negated(a) => negate(f, evaluate_expr(f, *a, fixed, advice, instance))
        Sum(a, b) => sum(f, evaluate_expr(f, *a, fixed, advice, instance), evaluate_expr(f, *b, fixed, advice, instance))
        Product(a, b) => prod(f, evaluate_expr(f, *a, fixed, advice, instance), evaluate_expr(f, *b, fixed, advice, instance))
        Scaled(a, s) => prod(f, evaluate_expr(f, *a, fixed, advice, instance), s)
    }
}
