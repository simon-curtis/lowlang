import std/crypto/pasta

struct Msm {
    params: *Params
    scalars: u64[][]
    points: pasta.Point[]
    g_scalars: u64[][]
    w_scalar: u64[]
    u_scalar: u64[]
}

fn empty_msm(p: *Params) -> *Msm {
    let f = p.curve.scalar
    new(Msm { params: p, scalars: [], points: [], g_scalars: zeros(f, p.n), w_scalar: zero(f), u_scalar: zero(f) })
}

fn append_term(m: *Msm, scalar: u64[], point: pasta.Point) {
    m.scalars.push(scalar)
    m.points.push(point)
}

fn add_constant_term(m: *Msm, constant: u64[]) {
    let f = m.params.curve.scalar
    m.g_scalars[0] = sum(f, m.g_scalars[0], constant)
}

fn add_to_g_scalars(m: *Msm, values: u64[][]) {
    let f = m.params.curve.scalar
    for i in 0..values.len {
        m.g_scalars[i] = sum(f, m.g_scalars[i], values[i])
    }
}

fn scale_msm(m: *Msm, factor: u64[]) {
    let f = m.params.curve.scalar
    for i in 0..m.scalars.len {
        m.scalars[i] = prod(f, m.scalars[i], factor)
    }
    for i in 0..m.g_scalars.len {
        m.g_scalars[i] = prod(f, m.g_scalars[i], factor)
    }
    m.w_scalar = prod(f, m.w_scalar, factor)
    m.u_scalar = prod(f, m.u_scalar, factor)
}

fn add_msm(m: *Msm, other: *Msm) {
    let f = m.params.curve.scalar
    for i in 0..other.scalars.len {
        append_term(m, other.scalars[i], other.points[i])
    }
    add_to_g_scalars(m, other.g_scalars)
    m.w_scalar = sum(f, m.w_scalar, other.w_scalar)
    m.u_scalar = sum(f, m.u_scalar, other.u_scalar)
}

fn msm_is_identity(m: *Msm) -> bool {
    let c = m.params.curve
    var out: u64[][] = []
    var bases: pasta.Point[] = []
    for i in 0..m.scalars.len {
        out.push(m.scalars[i])
        bases.push(m.points[i])
    }
    out.push(m.w_scalar)
    bases.push(m.params.w)
    out.push(m.u_scalar)
    bases.push(m.params.u)
    for i in 0..m.g_scalars.len {
        out.push(m.g_scalars[i])
        bases.push(m.params.g[i])
    }
    pasta.is_identity(pasta.msm(c, bases, out))
}
