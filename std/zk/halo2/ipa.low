import std/crypto/nistec
import std/crypto/pasta

fn compute_b(f: *nistec.Field, x: u64[], u: u64[][]) -> u64[] {
    var out = one(f)
    var current = x
    var i = u.len - 1
    for i >= 0 {
        out = prod(f, out, sum(f, one(f), prod(f, u[i], current)))
        current = square(f, current)
        i -= 1
    }
    out
}

fn compute_s(f: *nistec.Field, u: u64[][], init: u64[]) -> u64[][] {
    let v = zeros(f, 1 << u.len)
    v[0] = init
    var i = 0
    var j = u.len - 1
    for j >= 0 {
        let len = 1 << i
        for m in 0..len {
            v[len + m] = prod(f, v[m], u[j])
        }
        i += 1
        j -= 1
    }
    v
}

fn ipa_verify(p: *Params, msm: *Msm, t: *Transcript, x: u64[], v: u64[]) ! Error {
    let f = p.curve.scalar
    add_constant_term(msm, negate(f, v))
    let s_commitment = read_point(t)?
    let xi = squeeze(t)
    append_term(msm, xi, s_commitment)
    let z = squeeze(t)
    var left: pasta.Point[] = []
    var right: pasta.Point[] = []
    var u: u64[][] = []
    for _ in 0..p.k {
        left.push(read_point(t)?)
        right.push(read_point(t)?)
        u.push(squeeze(t))
    }
    var u_inv: u64[][] = []
    for challenge in u {
        u_inv.push(inverse(f, challenge))
    }
    for i in 0..p.k {
        append_term(msm, u_inv[i], left[i])
        append_term(msm, u[i], right[i])
    }
    let c = read_scalar(t)?
    let neg_c = negate(f, c)
    let last = read_scalar(t)?
    let b = compute_b(f, x, u)
    msm.u_scalar = sum(f, msm.u_scalar, prod(f, prod(f, neg_c, b), z))
    msm.w_scalar = sum(f, msm.w_scalar, negate(f, last))
    add_to_g_scalars(msm, compute_s(f, u, neg_c))
}

fn random_scalar(f: *nistec.Field, random: fn(i64) -> u8[]) -> u64[] {
    pasta.field_from_uniform(f, random(64))
}

fn inner_product(f: *nistec.Field, a: u64[][], b: u64[][]) -> u64[] {
    var out = zero(f)
    for i in 0..a.len {
        out = sum(f, out, prod(f, a[i], b[i]))
    }
    out
}

fn ipa_prove(p: *Params, t: *Transcript, random: fn(i64) -> u8[], poly: u64[][], blind: u64[], x: u64[]) ! Error {
    let c = p.curve
    let f = c.scalar
    var s_poly: u64[][] = []
    for _ in 0..p.n {
        s_poly.push(random_scalar(f, random))
    }
    s_poly[0] = diff(f, s_poly[0], evaluate(f, s_poly, x))
    let s_blind = random_scalar(f, random)
    write_point(t, commit(p, s_poly, s_blind))?
    let xi = squeeze(t)
    let z = squeeze(t)

    var values: u64[][] = []
    for i in 0..p.n {
        values.push(sum(f, prod(f, s_poly[i], xi), poly[i]))
    }
    let v = evaluate(f, values, x)
    values[0] = diff(f, values[0], v)
    var folded_blind = sum(f, prod(f, s_blind, xi), blind)

    var b: u64[][] = []
    var current = one(f)
    for _ in 0..p.n {
        b.push(current)
        current = prod(f, current, x)
    }
    var bases = p.g
    for round in 0..p.k {
        let half = 1 << (p.k - round - 1)
        let low_values = values[..half]
        let high_values = values[half..]
        let value_l = inner_product(f, high_values, b[..half])
        let value_r = inner_product(f, low_values, b[half..])
        let l_random = random_scalar(f, random)
        let r_random = random_scalar(f, random)
        let l_point = pasta.add(c, pasta.msm(c, bases[..half], high_values), pasta.msm(c, [p.u, p.w], [prod(f, value_l, z), l_random]))
        let r_point = pasta.add(c, pasta.msm(c, bases[half..], low_values), pasta.msm(c, [p.u, p.w], [prod(f, value_r, z), r_random]))
        write_point(t, l_point)?
        write_point(t, r_point)?
        let challenge = squeeze(t)
        let challenge_inv = inverse(f, challenge)
        var next_values: u64[][] = []
        var next_b: u64[][] = []
        var next_bases: pasta.Point[] = []
        for i in 0..half {
            next_values.push(sum(f, low_values[i], prod(f, high_values[i], challenge_inv)))
            next_b.push(sum(f, b[i], prod(f, b[i + half], challenge)))
            next_bases.push(pasta.add(c, bases[i], pasta.mul(c, bases[i + half], challenge)))
        }
        values = next_values
        b = next_b
        bases = next_bases
        folded_blind = sum(f, folded_blind, sum(f, prod(f, l_random, challenge_inv), prod(f, r_random, challenge)))
    }
    write_scalar(t, values[0])
    write_scalar(t, folded_blind)
}
