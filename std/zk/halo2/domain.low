import std/crypto/nistec
import std/crypto/pasta

/// The evaluation domain of a circuit of `2^k` rows: the powers of the root of unity `omega`, and the larger coset on which the quotient polynomial is computed.
struct Domain {
    f: *nistec.Field
    /// The base 2 logarithm of the number of rows.
    k: i64
    /// The number of rows.
    n: i64
    extended_k: i64
    /// The number of pieces the quotient polynomial is cut into, one less than the degree of the constraint system.
    quotient_degree: i64
    omega: u64[]
    omega_inv: u64[]
    extended_omega: u64[]
    extended_omega_inv: u64[]
    zeta: u64[]
    zeta_inv: u64[]
    delta: u64[]
    n_inv: u64[]
    extended_n_inv: u64[]
}

fn squared_times(f: *nistec.Field, a: u64[], times: i64) -> u64[] {
    var out = a
    for _ in 0..times {
        out = square(f, out)
    }
    out
}

/// Returns the domain of `2^k` rows for a constraint system of degree `degree`, over the scalar field of `c`.
fn domain(c: *pasta.Curve, degree: i64, k: i64) -> Domain {
    let f = c.scalar
    let quotient_degree = degree - 1
    var extended_k = k
    for (1 << extended_k) < (1 << k) * quotient_degree {
        extended_k += 1
    }
    let extended_omega = squared_times(f, pasta.field_root_of_unity(f), 32 - extended_k)
    let omega = squared_times(f, extended_omega, extended_k - k)
    new_domain(c, k, extended_k, quotient_degree, omega, extended_omega)
}

fn new_domain(c: *pasta.Curve, k: i64, extended_k: i64, quotient_degree: i64, omega: u64[], extended_omega: u64[]) -> Domain {
    let f = c.scalar
    Domain {
        f,
        k,
        n: 1 << k,
        extended_k,
        quotient_degree,
        omega,
        omega_inv: inverse(f, omega),
        extended_omega,
        extended_omega_inv: inverse(f, extended_omega),
        zeta: c.zeta,
        zeta_inv: square(f, c.zeta),
        delta: pasta.field_delta(f),
        n_inv: inverse(f, number(f, 1 << k)),
        extended_n_inv: inverse(f, number(f, 1 << extended_k)),
    }
}

/// Returns the number of points of the extended domain.
fn extended_len(d: Domain) -> i64 {
    1 << d.extended_k
}

fn bit_reverse(index: i64, bits: i64) -> i64 {
    var out = 0
    for i in 0..bits {
        if (index >> i) & 1 == 1 {
            out |= 1 << (bits - 1 - i)
        }
    }
    out
}

/// Returns the transform `out[j] = sum a[i] root^(i j)` of `a`, whose length is `2^bits`, for `root` of order `2^bits`.
fn fft(f: *nistec.Field, a: u64[][], root: u64[], bits: i64) -> u64[][] {
    let n = a.len
    var out: u64[][] = []
    for i in 0..n {
        out.push(a[bit_reverse(i, bits)])
    }
    var half = 1
    for half < n {
        let step = pasta.field_pow(f, root, [u64(n / (2 * half))])
        var start = 0
        for start < n {
            var twiddle = one(f)
            for j in 0..half {
                let t = prod(f, twiddle, out[start + j + half])
                let u = out[start + j]
                out[start + j] = sum(f, u, t)
                out[start + j + half] = diff(f, u, t)
                twiddle = prod(f, twiddle, step)
            }
            start += 2 * half
        }
        half *= 2
    }
    out
}

fn scaled(f: *nistec.Field, values: u64[][], factor: u64[]) -> u64[][] {
    var out: u64[][] = []
    for v in values {
        out.push(prod(f, v, factor))
    }
    out
}

/// Returns the coefficients of the polynomial that takes the values `values` on the powers of `omega`.
fn lagrange_to_coeff(d: Domain, values: u64[][]) -> u64[][] {
    scaled(d.f, fft(d.f, values, d.omega_inv, d.k), d.n_inv)
}

fn zeta_power(d: Domain, i: i64, inverse_powers: bool) -> u64[] {
    let r = i % 3
    if r == 0 {
        return one(d.f)
    }
    if (r == 1) != inverse_powers {
        return d.zeta
    }
    d.zeta_inv
}

/// Returns the values of the polynomial with coefficients `coeffs` on the extended domain, the coset `zeta` times the powers of the extended root of unity.
fn coeff_to_extended(d: Domain, coeffs: u64[][]) -> u64[][] {
    var a: u64[][] = []
    for i in 0..extended_len(d) {
        if i < coeffs.len {
            a.push(prod(d.f, coeffs[i], zeta_power(d, i, false)))
        } else {
            a.push(zero(d.f))
        }
    }
    fft(d.f, a, d.extended_omega, d.extended_k)
}

/// Returns the first `n * quotient_degree` coefficients of the polynomial whose values on the extended domain are `values`.
fn extended_to_coeff(d: Domain, values: u64[][]) -> u64[][] {
    let a = scaled(d.f, fft(d.f, values, d.extended_omega_inv, d.extended_k), d.extended_n_inv)
    var out: u64[][] = []
    for i in 0..d.n * d.quotient_degree {
        out.push(prod(d.f, a[i], zeta_power(d, i, true)))
    }
    out
}

/// Returns `values` divided by `X^n - 1` pointwise on the extended domain.
fn divide_by_vanishing(d: Domain, values: u64[][]) -> u64[][] {
    let f = d.f
    let ratio = 1 << (d.extended_k - d.k)
    var vanishing: u64[][] = []
    let step = power(f, d.extended_omega, d.n)
    var current = power(f, d.zeta, d.n)
    for _ in 0..ratio {
        vanishing.push(diff(f, current, one(f)))
        current = prod(f, current, step)
    }
    var out: u64[][] = []
    for i in 0..values.len {
        out.push(prod(f, values[i], inverse(f, vanishing[i % ratio])))
    }
    out
}

/// Returns `value * omega^rotation`.
fn rotate_omega(d: Domain, value: u64[], rotation: i64) -> u64[] {
    if rotation >= 0 {
        return prod(d.f, value, power(d.f, d.omega, rotation))
    }
    prod(d.f, value, power(d.f, d.omega_inv, -rotation))
}

/// Returns the Lagrange basis polynomial of row `row`, which may be negative to count from the last row, at `x` with `xn = x^n`.
fn lagrange_at(d: Domain, x: u64[], xn: u64[], row: i64) -> u64[] {
    let point = rotate_omega(d, one(d.f), row)
    let numerator = prod(d.f, prod(d.f, point, diff(d.f, xn, one(d.f))), d.n_inv)
    prod(d.f, numerator, inverse(d.f, diff(d.f, x, point)))
}

/// Returns the value at `x` of the polynomial with coefficients `coeffs`.
fn evaluate(f: *nistec.Field, coeffs: u64[][], x: u64[]) -> u64[] {
    var out = zero(f)
    var i = coeffs.len - 1
    for i >= 0 {
        out = sum(f, prod(f, out, x), coeffs[i])
        i -= 1
    }
    out
}

/// Returns the coefficients of `coeffs` divided by `X - point`, dropping the remainder.
fn divide_by_root(f: *nistec.Field, coeffs: u64[][], point: u64[]) -> u64[][] {
    let out = zeros(f, coeffs.len - 1)
    var carry = zero(f)
    var i = coeffs.len - 1
    for i > 0 {
        carry = sum(f, coeffs[i], prod(f, carry, point))
        out[i - 1] = carry
        i -= 1
    }
    out
}
