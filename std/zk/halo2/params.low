import std/crypto/pasta

/// The public parameters of the inner product argument over a curve: `2^k` generators `g`, their Lagrange form, and the blinding and inner product generators `w` and `u`, all derived from the hash to curve of the domain `Halo2-Parameters`.
pub struct Params {
    /// The curve the commitments live on, whose scalar field is the field of the circuit.
    pub curve: *pasta.Curve
    /// The base 2 logarithm of the number of rows.
    pub k: i64
    /// The number of rows, `2^k`.
    pub n: i64
    g: pasta.Point[]
    g_lagrange: pasta.Point[]
    w: pasta.Point
    u: pasta.Point
}

fn message(index: i64) -> u8[] {
    [0, u8(index), u8(index >> 8), u8(index >> 16), u8(index >> 24)]
}

fn point_fft(c: *pasta.Curve, a: pasta.Point[], root: u64[], bits: i64) -> pasta.Point[] {
    let n = a.len
    var out: pasta.Point[] = []
    for i in 0..n {
        out.push(a[bit_reverse(i, bits)])
    }
    var half = 1
    for half < n {
        let step = pasta.field_pow(c.scalar, root, [u64(n / (2 * half))])
        var start = 0
        for start < n {
            var twiddle = one(c.scalar)
            for j in 0..half {
                let t = pasta.mul(c, out[start + j + half], twiddle)
                let u = out[start + j]
                out[start + j] = pasta.add(c, u, t)
                out[start + j + half] = pasta.sub(c, u, t)
                twiddle = prod(c.scalar, twiddle, step)
            }
            start += 2 * half
        }
        half *= 2
    }
    out
}

/// Returns the parameters for circuits of `2^k` rows over `c`, where `k` is from 1 to 28.
pub fn params(c: *pasta.Curve, k: i64) -> *Params {
    let n = 1 << k
    var g: pasta.Point[] = []
    for i in 0..n {
        g.push(pasta.hash_to_curve(c, "Halo2-Parameters", message(i)))
    }
    let f = c.scalar
    let root = squared_times(f, pasta.field_root_of_unity(f), 32 - k)
    let transformed = point_fft(c, g, inverse(f, root), k)
    let n_inv = inverse(f, number(f, n))
    var g_lagrange: pasta.Point[] = []
    for p in transformed {
        g_lagrange.push(pasta.mul(c, p, n_inv))
    }
    let extra = pasta.normalize(c, [pasta.hash_to_curve(c, "Halo2-Parameters", [1]), pasta.hash_to_curve(c, "Halo2-Parameters", [2])])
    new(Params {
        curve: c,
        k,
        n,
        g: pasta.normalize(c, g),
        g_lagrange: pasta.normalize(c, g_lagrange),
        w: extra[0],
        u: extra[1],
    })
}

fn combine(p: *Params, values: u64[][], bases: pasta.Point[], blind: u64[]) -> pasta.Point {
    var scalars: u64[][] = []
    var points: pasta.Point[] = []
    for i in 0..values.len {
        scalars.push(values[i])
        points.push(bases[i])
    }
    scalars.push(blind)
    points.push(p.w)
    pasta.msm(p.curve, points, scalars)
}

/// Returns the commitment to the polynomial with coefficients `values` and blinding factor `blind`.
pub fn commit(p: *Params, values: u64[][], blind: u64[]) -> pasta.Point {
    combine(p, values, p.g, blind)
}

/// Returns the commitment to the polynomial with the values `values` on the powers of `omega`, with blinding factor `blind`.
pub fn commit_lagrange(p: *Params, values: u64[][], blind: u64[]) -> pasta.Point {
    combine(p, values, p.g_lagrange, blind)
}

/// Returns the serialisation of `p` as `halo2_proofs` writes it: `k` as 4 little-endian bytes, the `n` points `g`, the `n` points `g_lagrange`, then `w` and `u`, each as the 32-byte compressed point.
pub fn write_params(p: *Params) -> u8[] {
    var out: u8[] = [u8(p.k), u8(p.k >> 8), u8(p.k >> 16), u8(p.k >> 24)]
    for list in [p.g, p.g_lagrange, [p.w, p.u]] {
        for point in list {
            for b in pasta.to_bytes(p.curve, point) {
                out.push(b)
            }
        }
    }
    out
}

/// Returns the parameters that `data` holds, as `write_params` writes them, or fails with `Malformed` when `k` is not from 1 to 28, the length does not match `k` or a point does not decode. The generators are not recomputed, so parameters from a source that is not trusted must be compared with `params(c, k)`.
pub fn read_params(c: *pasta.Curve, data: u8[]) -> *Params ! Error {
    if data.len < 4 {
        fail Malformed
    }
    let k = i64(data[0]) | (i64(data[1]) << 8) | (i64(data[2]) << 16) | (i64(data[3]) << 24)
    if k < 1 || k > 28 {
        fail Malformed
    }
    let n = 1 << k
    if data.len != 4 + 32 * (2 * n + 2) {
        fail Malformed
    }
    var points: pasta.Point[] = []
    for i in 0..2 * n + 2 {
        let at = 4 + 32 * i
        points.push(pasta.from_bytes(c, data[at..at + 32]) ?? fail Malformed)
    }
    new(Params { curve: c, k, n, g: points[..n], g_lagrange: points[n..2 * n], w: points[2 * n], u: points[2 * n + 1] })
}
