import std/crypto/nistec
import std/crypto/pasta
import std/testing

struct Chip {
    cs: *ConstraintSystem
    constants: Column
    table: Column
    a: Column
    b: Column
    c: Column
    inst: Column
    s_mul: Selector
    s_add: Selector
}

fn chip() -> Chip {
    let cs = constraint_system()
    let constants = fixed_column(cs)
    let table = fixed_column(cs)
    let a = advice_column(cs)
    let b = advice_column(cs)
    let c = advice_column(cs)
    let inst = instance_column(cs)
    enable_constant(cs, constants)
    enable_constant(cs, constants)
    for column in [a, b, c, inst] {
        enable_equality(cs, column)
    }
    let s_mul = selector(cs)
    let s_add = selector(cs)
    let qa = query_advice(cs, a, 0)
    let qb = query_advice(cs, b, 0)
    let qc = query_advice(cs, c, 0)
    create_gate(cs, [mul(query_selector(s_mul), sub(mul(qa, qb), qc))])
    create_gate(cs, [mul(query_selector(s_add), sub(add(qa, qb), qc))])
    Chip { cs, constants, table, a, b, c, inst, s_mul, s_add }
}

fn rows(cells: Equal[]) -> str[] {
    var out: str[] = []
    for e in cells {
        out.push("{kind_name(e.a.column.kind)}{e.a.column.index}:{e.a.row}={kind_name(e.b.column.kind)}{e.b.column.index}:{e.b.row}")
    }
    out
}

fn test_regions_start_below_the_rows_their_columns_already_use(t: *testing.T) {
    let f = pasta.vesta().scalar
    let ch = chip()
    let l = layouter(params(pasta.vesta(), 4), ch.cs, [])
    let first = region(l)
    let x = assign_advice(first, ch.a, 0, number(f, 3))
    assign_advice(first, ch.a, 1, number(f, 4))
    end_region(first) or return t.fatal("first")
    let second = region(l)
    let y = assign_advice(second, ch.b, 0, number(f, 5))
    end_region(second) or return t.fatal("second")
    let third = region(l)
    enable_selector(third, ch.s_mul, 0)
    let copied = copy_advice(third, x, ch.a, 0)
    constrain_equal(third, y, assign_advice(third, ch.b, 0, number(f, 5)))
    assign_advice(third, ch.c, 0, number(f, 15))
    end_region(third) or return t.fatal("third")
    let done = finish(l)
    t.is_true(same(copied.value, number(f, 3)))
    t.is_true(same(done.advice[1][0], number(f, 5)))
    t.is_true(same(done.advice[0][2], number(f, 3)))
    t.is_true(same(done.advice[2][2], number(f, 15)))
    t.is_true(done.selectors[0][2] && !done.selectors[0][0])
    t.equal(rows(done.equalities).len, 2)
    t.equal(rows(done.equalities)[0], "Advice0:2=Advice0:0")
    t.equal(rows(done.equalities)[1], "Advice1:0=Advice1:2")
}

fn test_constants_go_to_the_first_constants_column_after_each_region(t: *testing.T) {
    let f = pasta.vesta().scalar
    let ch = chip()
    let l = layouter(params(pasta.vesta(), 4), ch.cs, [[number(f, 9)]])
    for value in [5, 7] {
        let r = region(l)
        enable_selector(r, ch.s_add, 0)
        let read = assign_advice_from_instance(r, ch.inst, 0, ch.a, 0)
        t.is_true(same(read.value, number(f, 9)))
        let five = assign_advice_from_constant(r, ch.b, 0, number(f, value))
        assign_advice(r, ch.c, 0, sum(f, read.value, five.value))
        end_region(r) or return t.fatal("region")
    }
    let done = finish(l)
    t.is_true(same(done.fixed[0][0], number(f, 5)) && same(done.fixed[0][1], number(f, 7)))
    let listed = rows(done.equalities)
    t.equal(listed.len, 4)
    t.equal(listed[0], "Advice0:0=Instance0:0")
    t.equal(listed[1], "Fixed0:0=Advice1:0")
    t.equal(listed[2], "Advice0:1=Instance0:0")
    t.equal(listed[3], "Fixed0:1=Advice1:1")
    t.equal(ch.cs.constants.len, 1)
}

fn test_a_constant_needs_a_constants_column(t: *testing.T) {
    let f = pasta.vesta().scalar
    let cs = constraint_system()
    let a = advice_column(cs)
    enable_equality(cs, a)
    let l = layouter(params(pasta.vesta(), 4), cs, [])
    let r = region(l)
    assign_advice_from_constant(r, a, 0, number(f, 1))
    t.is_true(placing_failure(r) == Circuit)
}

fn test_regions_refuse_cells_beyond_the_usable_rows_and_unplaced_cells(t: *testing.T) {
    let f = pasta.vesta().scalar
    let ch = chip()
    let p = params(pasta.vesta(), 4)
    let l = layouter(p, ch.cs, [])
    let tall = region(l)
    assign_advice(tall, ch.a, 10, number(f, 1))
    t.is_true(placing_failure(tall) == Circuit)
    let l2 = layouter(p, ch.cs, [])
    let early = region(l2)
    let cell = assign_advice(early, ch.a, 0, number(f, 1))
    t.is_true(instance_failure(l2, cell, ch.inst, 0) == Circuit)
    end_region(early) or return t.fatal("early")
    t.is_true(instance_failure(l2, cell, ch.inst, 10) == Circuit)
    t.is_true(instance_failure(l2, cell, ch.inst, 9) == none)
}

fn placing_failure(r: *Region) -> Error? {
    end_region(r) catch { e => return e }
    none
}

fn instance_failure(l: *Layouter, cell: AssignedCell, instance: Column, row: i64) -> Error? {
    constrain_instance(l, cell, instance, row) catch { e => return e }
    none
}

fn test_a_table_fills_its_column_with_its_first_value(t: *testing.T) {
    let f = pasta.vesta().scalar
    let ch = chip()
    let l = layouter(params(pasta.vesta(), 4), ch.cs, [])
    assign_table(l, ch.table, [number(f, 4), number(f, 6)]) or return t.fatal("table")
    let done = finish(l)
    t.equal(done.fixed[1].len, 10)
    t.is_true(same(done.fixed[1][1], number(f, 6)) && same(done.fixed[1][9], number(f, 4)))
    t.is_true(table_failure(l, ch.table, [number(f, 1)]) == Circuit)
    t.is_true(table_failure(l, ch.constants, []) == Circuit)
    t.is_true(table_failure(l, ch.a, [number(f, 1)]) == Circuit)
}

fn table_failure(l: *Layouter, column: Column, values: u64[][]) -> Error? {
    assign_table(l, column, values) catch { e => return e }
    none
}

fn on(rows: i64[], n: i64) -> bool[] {
    var out: bool[] = []
    for _ in 0..n {
        out.push(false)
    }
    for row in rows {
        out[row] = true
    }
    out
}

fn test_selectors_share_a_column_when_never_on_together_within_the_degree(t: *testing.T) {
    let f = pasta.vesta().scalar
    let cs = constraint_system()
    let a = advice_column(cs)
    let s1 = selector(cs)
    let s2 = selector(cs)
    let s3 = selector(cs)
    let s4 = selector(cs)
    let q = complex_selector(cs)
    let qa = query_advice(cs, a, 0)
    create_gate(cs, [mul(query_selector(s1), mul(qa, qa))])
    create_gate(cs, [mul(query_selector(s2), qa)])
    create_gate(cs, [mul(query_selector(s3), qa)])
    create_gate(cs, [mul(query_selector(s4), qa)])
    lookup(cs, [mul(query_selector(q), qa)], [qa])
    t.equal(degree(cs), 5)
    let compressed = compress_selectors(f, cs, [on([0], 8), on([1], 8), on([0], 8), on([2], 8), on([3], 8)])
    t.equal(compressed.columns.len, 3)
    t.equal(compressed.cs.fixed_columns, 3)
    t.equal(cs.fixed_columns, 0)
    t.equal(cs.fixed_queries.len, 0)
    t.is_true(same(compressed.columns[0][3], one(f)))
    t.is_true(same(compressed.columns[1][0], number(f, 1)) && same(compressed.columns[1][1], number(f, 2)) && same(compressed.columns[1][2], number(f, 3)))
    t.is_true(same(compressed.columns[2][0], one(f)))
    t.equal(degree(compressed.cs), 5)
    t.equal(expr_degree(compressed.cs.gates[0]), 5)
    t.equal(expr_degree(compressed.cs.gates[2]), 2)
}

fn test_keygen_refuses_a_simple_selector_in_a_sum_or_a_lookup(t: *testing.T) {
    let p = params(pasta.vesta(), 4)
    for misuse in 0..3 {
        let cs = constraint_system()
        let a = advice_column(cs)
        let s = selector(cs)
        let qa = query_advice(cs, a, 0)
        match misuse {
            0 => create_gate(cs, [add(query_selector(s), qa)])
            1 => create_gate(cs, [mul(query_selector(s), query_selector(s))])
            _ => lookup(cs, [mul(query_selector(s), qa)], [qa])
        }
        t.is_true(keygen_failure(p, cs, Assignment { fixed: [], advice: [], selectors: [[]], equalities: [] }) == Circuit)
    }
}
