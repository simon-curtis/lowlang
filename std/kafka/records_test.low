import std/io
import std/testing
import std/text

fn kafka_python_batch() -> u8[] {
    decoded("0000000000000000000000650000000002b0343b8a0000000000020000018bcfe568000000018bcfe5680affffffffffffffffffffffffffff000000032e000000046b310a68656c6c6f040468310476310468320016000a02010a776f726c64001e001404046b330102086f6e6c790278")
}

fn kafka_python_gzip_batch() -> u8[] {
    decoded("00000000000000000000007d00000000028a20b4940001000000020000018bcfe568000000018bcfe5680affffffffffffffffffffffffffff000000031f8b0800856d006b02ffdbc6ccc0c0c0926d388139233527277f18102c2c19862c65862c19460c620c5c4c8c5ce5f94539290c720c222c2cd9c68c4c1cf97939954c1500bb14bb20f9000000")
}

fn decoded(hex: str) -> u8[] {
    text.decode_hex(hex) catch {
        e => []
    }
}

fn expected_records() -> Record[] {
    [
        Record { offset: 0, timestamp: 1700000000000, key: some(bytes("k1")), value: some(bytes("hello")), headers: [Header { key: "h1", value: bytes("v1") }, Header { key: "h2", value: [] }] }
        Record { offset: 1, timestamp: 1700000000005, key: none, value: some(bytes("world")) }
        Record { offset: 2, timestamp: 1700000000010, key: some(bytes("k3")), value: none, headers: [Header { key: "only", value: bytes("x") }] }
    ]
}

fn same_record(t: *testing.T, got: Record, want: Record) {
    t.equal(got.offset, want.offset)
    t.equal(got.timestamp, want.timestamp)
    t.equal_slice(got.key ?? [0xEE], want.key ?? [0xEE])
    t.equal(got.key != none, want.key != none)
    t.equal_slice(got.value ?? [0xEE], want.value ?? [0xEE])
    t.equal(got.value != none, want.value != none)
    t.equal(got.headers.len, want.headers.len)
    for i, h in want.headers {
        if i < got.headers.len {
            t.equal(got.headers[i].key, h.key)
            t.equal_slice(got.headers[i].value, h.value)
        }
    }
}

fn same_records(t: *testing.T, got: Record[], want: Record[]) {
    t.equal(got.len, want.len)
    for i, r in want {
        if i < got.len {
            same_record(t, got[i], r)
        }
    }
}

fn decoded_records(t: *testing.T, data: u8[]) -> Record[] {
    decode_batches(data) catch {
        e => t.unexpected(e, no_records())
    }
}

fn no_records() -> Record[] {
    []
}

fn encoded(t: *testing.T, records: Record[], c: Compression) -> u8[] {
    encode_batch(records, c, 1700000000000) catch {
        e => t.unexpected(e, no_bytes())
    }
}

fn no_bytes() -> u8[] {
    []
}

fn without_leader_epoch(batch: u8[]) -> u8[] {
    var out = batch
    for i in 12..16 {
        out[i] = 0
    }
    out
}

fn test_crc32c_check_value(t: *testing.T) {
    t.equal(checksum(bytes("123456789")), 0xE3069283)
}

fn test_decodes_a_batch_built_by_kafka_python(t: *testing.T) {
    same_records(t, decoded_records(t, kafka_python_batch()), expected_records())
}

fn test_decodes_a_gzip_batch_built_by_kafka_python(t: *testing.T) {
    let records = decoded_records(t, kafka_python_gzip_batch())
    t.equal(records.len, 3)
    t.equal(records[0].offset, 0)
    t.equal(records[2].offset, 2)
    t.equal(str(records[0].value ?? []), "hello".repeat(40))
    t.equal(str(records[1].value ?? []), "world")
    t.is_none(records[2].value)
}

fn test_encodes_the_bytes_kafka_python_builds(t: *testing.T) {
    let batch = encoded(t, expected_records(), Compression.None)
    t.equal(text.encode_hex(without_leader_epoch(batch)), text.encode_hex(without_leader_epoch(kafka_python_batch())))
}

fn test_a_record_without_a_timestamp_takes_the_time_of_the_call(t: *testing.T) {
    let records = decoded_records(t, encoded(t, [Record { value: some(bytes("x")) }, Record { value: some(bytes("y")), timestamp: 1700000000500 }], Compression.None))
    t.equal(records[0].timestamp, 1700000000000)
    t.equal(records[1].timestamp, 1700000000500)
}

fn test_every_compression_round_trips(t: *testing.T) {
    var big: Record[] = []
    for i in 0..50 {
        big.push(Record { key: some(bytes("key-{i}")), value: some(bytes("value {i} ".repeat(20))), timestamp: 1700000000000 + i })
    }
    for c in [Compression.None, Compression.Gzip, Compression.Snappy, Compression.Lz4, Compression.Zstd] {
        let batch = encoded(t, big, c)
        t.equal(i64(batch[22]) & 7, compression_bits(c))
        let got = decoded_records(t, batch)
        t.equal(got.len, 50)
        t.equal(str(got[49].value ?? []), "value 49 ".repeat(20))
        t.equal(got[49].offset, 49)
    }
}

fn test_compressed_batches_are_smaller(t: *testing.T) {
    let big = [Record { value: some(bytes("abcdefgh".repeat(500))) }]
    let plain = encoded(t, big, Compression.None).len
    t.is_true(encoded(t, big, Compression.Gzip).len < plain / 4)
    t.is_true(encoded(t, big, Compression.Zstd).len < plain / 4)
}

fn test_the_checksum_catches_a_flipped_bit(t: *testing.T) {
    var batch = encoded(t, expected_records(), Compression.None)
    batch[batch.len - 3] ^= 1
    decode_batches(batch) catch {
        e => {
            t.equal(e, Error.Malformed)
            return
        }
    }
    t.error("a corrupt batch decoded")
}

fn test_an_empty_batch_is_rejected(t: *testing.T) {
    encode_batch([], Compression.None, 0) catch {
        e => {
            t.equal(e, Error.Argument)
            return
        }
    }
    t.error("an empty batch encoded")
}

fn test_a_cut_batch_at_the_end_is_dropped(t: *testing.T) {
    let first = encoded(t, expected_records(), Compression.None)
    let second = encoded(t, expected_records(), Compression.None)
    var wire = first
    io.append(mut wire, second[..second.len - 5])
    let got = decode_fetched(wire, 0) catch {
        e => t.unexpected(e, Fetched { records: [], next_offset: 0 })
    }
    t.equal(got.records.len, 3)
    t.equal(got.next_offset, 3)
}

fn test_records_below_the_requested_offset_are_dropped(t: *testing.T) {
    let got = decode_fetched(kafka_python_batch(), 2) catch {
        e => t.unexpected(e, Fetched { records: [], next_offset: 0 })
    }
    t.equal(got.records.len, 1)
    t.equal(got.records[0].offset, 2)
}

fn test_a_control_batch_advances_the_offset_without_records(t: *testing.T) {
    var batch = encoded(t, [Record { value: some(bytes("marker")) }], Compression.None)
    batch[21] = 0
    batch[22] = 0x20
    let crc = checksum(batch[21..])
    batch[17] = u8(crc >> 24)
    batch[18] = u8(crc >> 16 & 0xFF)
    batch[19] = u8(crc >> 8 & 0xFF)
    batch[20] = u8(crc & 0xFF)
    let got = decode_fetched(batch, 0) catch {
        e => t.unexpected(e, Fetched { records: [], next_offset: 0 })
    }
    t.equal(got.records.len, 0)
    t.equal(got.next_offset, 1)
}
