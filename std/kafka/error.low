/// The error type of the kafka module.
pub enum Error {
    /// A broker could not be reached.
    Connect
    /// The client or the connection is closed.
    Closed
    /// A connect, request or wait exceeded its time limit.
    Timeout
    /// A broker answered with a response that does not match the request, or at a point of the protocol where it is not valid.
    Protocol
    /// The bytes are not a valid Kafka message, record batch or varint.
    Malformed
    /// A record, batch or response is larger than a limit allows.
    TooLarge
    /// The TLS handshake failed.
    Tls
    /// A broker does not support an API version the client needs, a compression codec, or a SASL mechanism.
    Unsupported
    /// An argument is out of range, such as a partition below `0` or an empty topic name.
    Argument
    /// The broker refused the credentials. `message` is the broker's text or a description.
    Auth(message: str)
    /// A broker answered with a Kafka error code. `code` is the number, such as `3` for `UNKNOWN_TOPIC_OR_PARTITION`, and `name` its name from the protocol, or `"UNKNOWN"`.
    Broker(code: i64, name: str)
}

/// Returns the protocol name of the Kafka error `code`, such as `"NOT_LEADER_OR_FOLLOWER"` for `6`, or `"UNKNOWN"` for a code the client does not list.
pub fn error_name(code: i64) -> str {
    match code {
        -1 => "UNKNOWN_SERVER_ERROR"
        1 => "OFFSET_OUT_OF_RANGE"
        2 => "CORRUPT_MESSAGE"
        3 => "UNKNOWN_TOPIC_OR_PARTITION"
        5 => "LEADER_NOT_AVAILABLE"
        6 => "NOT_LEADER_OR_FOLLOWER"
        7 => "REQUEST_TIMED_OUT"
        8 => "BROKER_NOT_AVAILABLE"
        9 => "REPLICA_NOT_AVAILABLE"
        10 => "MESSAGE_TOO_LARGE"
        13 => "NETWORK_EXCEPTION"
        14 => "COORDINATOR_LOAD_IN_PROGRESS"
        15 => "COORDINATOR_NOT_AVAILABLE"
        16 => "NOT_COORDINATOR"
        17 => "INVALID_TOPIC_EXCEPTION"
        18 => "RECORD_LIST_TOO_LARGE"
        19 => "NOT_ENOUGH_REPLICAS"
        20 => "NOT_ENOUGH_REPLICAS_AFTER_APPEND"
        21 => "INVALID_REQUIRED_ACKS"
        22 => "ILLEGAL_GENERATION"
        23 => "INCONSISTENT_GROUP_PROTOCOL"
        24 => "INVALID_GROUP_ID"
        25 => "UNKNOWN_MEMBER_ID"
        26 => "INVALID_SESSION_TIMEOUT"
        27 => "REBALANCE_IN_PROGRESS"
        28 => "INVALID_COMMIT_OFFSET_SIZE"
        29 => "TOPIC_AUTHORIZATION_FAILED"
        30 => "GROUP_AUTHORIZATION_FAILED"
        31 => "CLUSTER_AUTHORIZATION_FAILED"
        33 => "UNSUPPORTED_SASL_MECHANISM"
        34 => "ILLEGAL_SASL_STATE"
        35 => "UNSUPPORTED_VERSION"
        36 => "TOPIC_ALREADY_EXISTS"
        37 => "INVALID_PARTITIONS"
        38 => "INVALID_REPLICATION_FACTOR"
        41 => "NOT_CONTROLLER"
        42 => "INVALID_REQUEST"
        43 => "UNSUPPORTED_FOR_MESSAGE_FORMAT"
        44 => "POLICY_VIOLATION"
        45 => "OUT_OF_ORDER_SEQUENCE_NUMBER"
        46 => "DUPLICATE_SEQUENCE_NUMBER"
        47 => "INVALID_PRODUCER_EPOCH"
        58 => "SASL_AUTHENTICATION_FAILED"
        72 => "LISTENER_NOT_FOUND"
        73 => "TOPIC_DELETION_DISABLED"
        74 => "FENCED_LEADER_EPOCH"
        75 => "UNKNOWN_LEADER_EPOCH"
        76 => "UNSUPPORTED_COMPRESSION_TYPE"
        79 => "MEMBER_ID_REQUIRED"
        82 => "FENCED_INSTANCE_ID"
        _ => "UNKNOWN"
    }
}

fn broker_error(code: i64) -> Error {
    Error.Broker(code, error_name(code))
}
