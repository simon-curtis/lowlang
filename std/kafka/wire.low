import std/io

struct Cursor {
    data: u8[]
    at: i64
}

fn cursor(data: u8[]) -> *Cursor {
    new(Cursor { data, at: 0 })
}

fn left(c: *Cursor) -> i64 {
    c.data.len - c.at
}

fn take(c: *Cursor, n: i64) -> u8[] ! Error {
    if n < 0 || n > left(c) {
        fail Malformed
    }
    let part = c.data[c.at..c.at + n]
    c.at += n
    part
}

fn take_i8(c: *Cursor) -> i64 ! Error {
    let b = take(c, 1)?
    let v = i64(b[0])
    if v >= 128 {
        return v - 256
    }
    v
}

fn take_i16(c: *Cursor) -> i64 ! Error {
    let v = io.be16(take(c, 2)?, 0)
    if v >= 32768 {
        return v - 65536
    }
    v
}

fn take_i32(c: *Cursor) -> i64 ! Error {
    let v = io.be32(take(c, 4)?, 0)
    if v >= 2147483648 {
        return v - 4294967296
    }
    v
}

fn take_i64(c: *Cursor) -> i64 ! Error {
    io.be64(take(c, 8)?, 0)
}

fn take_bool(c: *Cursor) -> bool ! Error {
    take_i8(c)? != 0
}

fn take_uvarint(c: *Cursor) -> u64 ! Error {
    var v: u64 = 0
    var shift = 0
    for shift < 70 {
        let b = take(c, 1)?[0]
        v = v | u64(b & 0x7F) << shift
        if b < 0x80 {
            return v
        }
        shift += 7
    }
    fail Malformed
}

fn take_uint(c: *Cursor) -> i64 ! Error {
    let v = take_uvarint(c)?
    if v > 2147483647 {
        fail Malformed
    }
    i64(v)
}

fn take_varlong(c: *Cursor) -> i64 ! Error {
    let v = take_uvarint(c)?
    i64(v >> 1) ^ -i64(v & 1)
}

fn take_varint(c: *Cursor) -> i64 ! Error {
    let v = take_varlong(c)?
    if v < -2147483648 || v > 2147483647 {
        fail Malformed
    }
    v
}

fn take_string(c: *Cursor) -> str ! Error {
    let n = take_i16(c)?
    if n < 0 {
        fail Malformed
    }
    str(take(c, n)?)
}

fn take_nullable_string(c: *Cursor) -> str? ! Error {
    let n = take_i16(c)?
    if n < 0 {
        return none
    }
    some(str(take(c, n)?))
}

fn take_compact_string(c: *Cursor) -> str ! Error {
    let n = take_uint(c)?
    if n == 0 {
        fail Malformed
    }
    str(take(c, n - 1)?)
}

fn take_compact_nullable_string(c: *Cursor) -> str? ! Error {
    let n = take_uint(c)?
    if n == 0 {
        return none
    }
    some(str(take(c, n - 1)?))
}

fn take_bytes(c: *Cursor) -> u8[]? ! Error {
    let n = take_i32(c)?
    if n < 0 {
        return none
    }
    some(take(c, n)?)
}

fn take_compact_bytes(c: *Cursor) -> u8[]? ! Error {
    let n = take_uint(c)?
    if n == 0 {
        return none
    }
    some(take(c, n - 1)?)
}

fn take_count(c: *Cursor) -> i64 ! Error {
    let n = take_i32(c)?
    if n > left(c) {
        fail Malformed
    }
    n
}

fn take_compact_count(c: *Cursor) -> i64 ! Error {
    let n = take_uint(c)?
    if n - 1 > left(c) {
        fail Malformed
    }
    n - 1
}

fn skip_tags(c: *Cursor) ! Error {
    let n = take_uint(c)?
    for i in 0..n {
        take_uint(c)?
        let size = take_uint(c)?
        take(c, size)?
    }
}

fn finish(c: *Cursor) ! Error {
    if left(c) != 0 {
        fail Malformed
    }
}

fn put_i8(mut b: u8[], v: i64) {
    b.push(u8(v))
}

fn put_i16(mut b: u8[], v: i64) {
    io.put_be16(mut b, v)
}

fn put_i32(mut b: u8[], v: i64) {
    io.put_be32(mut b, v)
}

fn put_i64(mut b: u8[], v: i64) {
    io.put_be64(mut b, v)
}

fn put_bool(mut b: u8[], v: bool) {
    b.push(if v { 1 } else { 0 })
}

fn put_uvarint(mut b: u8[], v: u64) {
    var x = v
    for x >= 0x80 {
        b.push(u8(x & 0x7F | 0x80))
        x = x >> 7
    }
    b.push(u8(x))
}

fn put_varlong(mut b: u8[], v: i64) {
    put_uvarint(mut b, u64((v << 1) ^ (v >> 63)))
}

fn put_string(mut b: u8[], s: str) {
    put_i16(mut b, s.len)
    io.append(mut b, bytes(s))
}

fn put_nullable_string(mut b: u8[], s: str?) {
    match s {
        some(v) => put_string(mut b, v)
        none => put_i16(mut b, -1)
    }
}

fn put_compact_string(mut b: u8[], s: str) {
    put_uvarint(mut b, u64(s.len + 1))
    io.append(mut b, bytes(s))
}

fn put_compact_nullable_string(mut b: u8[], s: str?) {
    match s {
        some(v) => put_compact_string(mut b, v)
        none => put_uvarint(mut b, 0)
    }
}

fn put_bytes(mut b: u8[], data: u8[]) {
    put_i32(mut b, data.len)
    io.append(mut b, data)
}

fn put_compact_bytes(mut b: u8[], data: u8[]) {
    put_uvarint(mut b, u64(data.len + 1))
    io.append(mut b, data)
}

fn put_compact_count(mut b: u8[], n: i64) {
    put_uvarint(mut b, u64(n + 1))
}

fn put_tags(mut b: u8[]) {
    b.push(0)
}
