import std/slices

/// A partition of a topic, as `assignment` lists the ones a consumer owns.
pub struct TopicPartition {
    /// The topic name.
    pub topic: str
    /// The partition number.
    pub partition: i64
}

struct Subscription {
    member: str
    topics: str[]
}

struct Owned {
    member: str
    owned: TopicPartition
}

fn encode_subscription(topics: str[]) -> u8[] {
    var b: u8[] = []
    put_i16(mut b, 0)
    put_i32(mut b, topics.len)
    for t in topics {
        put_string(mut b, t)
    }
    put_i32(mut b, -1)
    b
}

fn decode_subscription(data: u8[]) -> str[] ! Error {
    let c = cursor(data)
    let _ = take_i16(c)?
    let n = take_count(c)?
    var topics: str[] = []
    for i in 0..n {
        topics.push(take_string(c)?)
    }
    topics
}

fn encode_assignment(owned: TopicPartition[]) -> u8[] {
    var names: str[] = []
    for tp in owned {
        if !slices.contains(names, tp.topic) {
            names.push(tp.topic)
        }
    }
    var b: u8[] = []
    put_i16(mut b, 0)
    put_i32(mut b, names.len)
    for name in names {
        var parts: i64[] = []
        for tp in owned {
            if tp.topic == name {
                parts.push(tp.partition)
            }
        }
        put_string(mut b, name)
        put_i32(mut b, parts.len)
        for p in parts {
            put_i32(mut b, p)
        }
    }
    put_i32(mut b, -1)
    b
}

fn decode_assignment(data: u8[]) -> TopicPartition[] ! Error {
    if data.len == 0 {
        return []
    }
    let c = cursor(data)
    let _ = take_i16(c)?
    let n = take_count(c)?
    var out: TopicPartition[] = []
    for i in 0..n {
        let topic = take_string(c)?
        let count = take_count(c)?
        for j in 0..count {
            out.push(TopicPartition { topic, partition: take_i32(c)? })
        }
    }
    out
}

fn assign_range(subs: Subscription[], counts: [str: i64]) -> Owned[] {
    var topics: str[] = []
    for s in subs {
        for t in s.topics {
            if !slices.contains(topics, t) {
                topics.push(t)
            }
        }
    }
    slices.sort(mut topics)
    var out: Owned[] = []
    for topic in topics {
        let total = counts[topic] ?? 0
        var members: str[] = []
        for s in subs {
            if slices.contains(s.topics, topic) {
                members.push(s.member)
            }
        }
        if total == 0 || members.len == 0 {
            continue
        }
        slices.sort(mut members)
        let share = total / members.len
        let extra = total % members.len
        var next = 0
        for i, member in members {
            let take = share + (if i < extra { 1 } else { 0 })
            for p in next..next + take {
                out.push(Owned { member, owned: TopicPartition { topic, partition: p } })
            }
            next += take
        }
    }
    out
}
