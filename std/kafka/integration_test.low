import std/crypto
import std/net
import std/os
import std/testing
import std/text

/// These tests run against a real broker of Kafka 2.7 or later, such as `apache/kafka` started with KRaft whose advertised listener is the address the tests dial.
///
/// `LOW_KAFKA_ADDR` names a listener without authentication as `host:port`. Without it, or when nothing listens there, every test is skipped.
fn broker(t: *testing.T) -> Options {
    let addr = os.env("LOW_KAFKA_ADDR") ?? ""
    if addr.len == 0 {
        testing.skip(t, "LOW_KAFKA_ADDR is not set")
    }
    let at = text.last_index_byte(addr, ':')
    let port = text.parse_int(addr[at + 1..]) or 9092
    using probe = net.dial_within(addr[..at], port, 1000) catch {
        e => {
            testing.skip(t, "no broker at {addr}")
            panic("unreachable")
        }
    }
    Options { brokers: [addr], timeout: 15000, retry_backoff: 100 }
}

fn unique(prefix: str) -> str {
    "low.test.{prefix}.{text.encode_hex(crypto.random(6))}"
}

fn connected(t: *testing.T) -> Client {
    connect(broker(t)) catch {
        e => {
            t.fatal("connect failed: {testing.format(e)}")
            panic("unreachable")
        }
    }
}

fn topic_with(t: *testing.T, c: Client, partitions: i64) -> str {
    let name = unique("topic")
    create_topic(c, name, partitions, 1, [:]) catch {
        e => t.fatal("create_topic failed: {testing.format(e)}")
    }
    name
}

fn value(s: str) -> Record {
    Record { value: some(bytes(s)) }
}

fn text_of(r: Record) -> str {
    str(r.value ?? [])
}

fn produced(t: *testing.T, c: Client, topic: str, partition: i64, records: Record[]) -> i64 {
    produce(c, topic, partition, records, ProduceOptions {}) catch {
        e => {
            t.fatal("produce failed: {testing.format(e)}")
            panic("unreachable")
        }
    }
}

fn records_of(t: *testing.T, c: Client, topic: str, partition: i64, want: i64) -> Record[] {
    var out: Record[] = []
    var offset = 0
    for i in 0..50 {
        let got = fetch(c, topic, partition, offset, FetchOptions { max_wait: 200 }) catch {
            e => {
                t.fatal("fetch failed: {testing.format(e)}")
                panic("unreachable")
            }
        }
        for r in got.records {
            out.push(r)
        }
        offset = got.next_offset
        if out.len >= want {
            break
        }
    }
    out
}

fn test_connects_and_lists_the_cluster(t: *testing.T) {
    let c = connected(t)
    defer close(c)
    t.is_true(c.state.nodes.len >= 1)
}

fn test_topic_lifecycle(t: *testing.T) {
    let c = connected(t)
    defer close(c)
    let name = topic_with(t, c, 3)
    var topics: Topic[] = []
    for i in 0..50 {
        topics = metadata(c, [name]) or panic("metadata failed")
        if topics[0].error == 0 {
            break
        }
        sleep(100)
    }
    t.equal(topics.len, 1)
    t.equal(topics[0].partitions.len, 3)
    t.equal(topics[0].error, 0)
    t.is_true(slices_has(list_topics(c) or [], name))
    var code = 0
    create_topic(c, name, 1, 1, [:]) catch {
        e => {
            code = code_of(e)
        }
    }
    t.equal(code, 36)
    delete_topic(c, name) or panic("delete_topic failed")
    var gone = 0
    for i in 0..50 {
        gone = (metadata(c, [name]) or panic("metadata failed"))[0].error
        if gone == 3 {
            break
        }
        sleep(100)
    }
    t.equal(gone, 3)
}

fn slices_has(names: str[], name: str) -> bool {
    for n in names {
        if n == name {
            return true
        }
    }
    false
}

fn test_produce_and_fetch_round_trip(t: *testing.T) {
    let c = connected(t)
    defer close(c)
    let name = topic_with(t, c, 1)
    let first = produced(t, c, name, 0, [
        Record { key: some(bytes("k1")), value: some(bytes("v1")), headers: [Header { key: "h", value: bytes("x") }], timestamp: 1700000000000 }
        Record { key: none, value: none }
        value("v3")
    ])
    t.equal(first, 0)
    let got = records_of(t, c, name, 0, 3)
    t.equal(got.len, 3)
    t.equal(got[0].offset, 0)
    t.equal(str(got[0].key ?? []), "k1")
    t.equal(text_of(got[0]), "v1")
    t.equal(got[0].timestamp, 1700000000000)
    t.equal(got[0].headers.len, 1)
    t.equal(got[0].headers[0].key, "h")
    t.is_none(got[1].value)
    t.equal(text_of(got[2]), "v3")
    t.equal(produced(t, c, name, 0, [value("v4")]), 3)
    t.equal(list_offsets(c, name, 0, earliest) or -9, 0)
    t.equal(list_offsets(c, name, 0, latest) or -9, 4)
    delete_topic(c, name) or {}
}

fn test_every_compression_round_trips_through_a_broker(t: *testing.T) {
    let c = connected(t)
    defer close(c)
    let name = topic_with(t, c, 1)
    let codecs = [Compression.None, Compression.Gzip, Compression.Snappy, Compression.Lz4, Compression.Zstd]
    for i, codec in codecs {
        let body = text.repeat("compress me {i} ", 200)
        produce(c, name, 0, [value(body), value("{i}")], ProduceOptions { compression: codec }) catch {
            e => {
                t.fatal("produce with codec {i} failed: {testing.format(e)}")
                -1
            }
        }
    }
    let got = records_of(t, c, name, 0, 10)
    t.equal(got.len, 10)
    for i in 0..5 {
        t.equal(text_of(got[i * 2]), text.repeat("compress me {i} ", 200))
        t.equal(text_of(got[i * 2 + 1]), "{i}")
    }
    delete_topic(c, name) or {}
}

fn test_keyed_send_picks_the_partition_of_the_key(t: *testing.T) {
    let c = connected(t)
    defer close(c)
    let name = topic_with(t, c, 4)
    for i in 0..8 {
        let key = bytes("key-{i}")
        let sent = send(c, name, Record { key: some(key), value: some(bytes("v{i}")) }, ProduceOptions {}) or panic("send failed")
        t.equal(sent.partition, partition_for(key, 4))
        let got = records_of(t, c, name, sent.partition, 1)
        t.equal(str(got[got.len - 1].key ?? []), "key-{i}")
    }
    delete_topic(c, name) or {}
}

fn test_fetch_beyond_the_end_is_out_of_range(t: *testing.T) {
    let c = connected(t)
    defer close(c)
    let name = topic_with(t, c, 1)
    produced(t, c, name, 0, [value("only")])
    fetch(c, name, 0, 99, FetchOptions { max_wait: 100 }) catch {
        e => {
            t.equal(code_of(e), 1)
            delete_topic(c, name) or {}
            return
        }
    }
    t.error("the broker returned an offset beyond the log")
}

fn test_an_unknown_topic_fails_with_its_code(t: *testing.T) {
    let c = connected(t)
    defer close(c)
    fetch(c, unique("missing"), 0, 0, FetchOptions { max_wait: 100 }) catch {
        e => {
            t.equal(code_of(e), 3)
            return
        }
    }
    t.error("fetched a topic that does not exist")
}

fn drain(t: *testing.T, cn: Consumer, want: i64) -> Message[] {
    var out: Message[] = []
    for i in 0..40 {
        let got = poll(cn, 500) catch {
            e => {
                t.fatal("poll failed: {testing.format(e)}")
                panic("unreachable")
            }
        }
        for m in got {
            out.push(m)
        }
        if out.len >= want {
            break
        }
    }
    out
}

fn test_a_consumer_reads_commits_and_resumes(t: *testing.T) {
    let c = connected(t)
    defer close(c)
    let name = topic_with(t, c, 2)
    let group = unique("group")
    for i in 0..6 {
        produced(t, c, name, i % 2, [value("m{i}")])
    }
    let o = ConsumerOptions { group, topics: [name], reset: Reset.Earliest, session_timeout: 10000, heartbeat_interval: 1000 }
    let cn = subscribe(c, o) or panic("subscribe failed")
    t.equal(assignment(cn).len, 2)
    let first = drain(t, cn, 6)
    t.equal(first.len, 6)
    commit(cn) or panic("commit failed")
    t.equal(position(cn, name, 0) or -9, 3)
    unsubscribe(cn)
    produced(t, c, name, 1, [value("late")])
    let again = subscribe(c, o) or panic("second subscribe failed")
    let rest = drain(t, again, 1)
    t.equal(rest.len, 1)
    t.equal(text_of(rest[0].record), "late")
    seek(again, name, 1, 0) or panic("seek failed")
    t.equal(drain(t, again, 4).len, 4)
    unsubscribe(again)
    unsubscribe(again)
    delete_topic(c, name) or {}
}

fn test_two_consumers_split_the_partitions(t: *testing.T) {
    let c = connected(t)
    defer close(c)
    let name = topic_with(t, c, 4)
    let group = unique("pair")
    let o = ConsumerOptions { group, topics: [name], reset: Reset.Earliest, session_timeout: 10000, heartbeat_interval: 500, rebalance_timeout: 20000 }
    let a = subscribe(c, o) catch {
        e => {
            t.fatal("subscribe failed: {testing.format(e)}")
            panic("unreachable")
        }
    }
    t.equal(assignment(a).len, 4)
    let joined = chan[Consumer]()
    spawn join_second(c, o, joined)
    var b: Consumer? = none
    for i in 0..60 {
        poll(a, 250) or []
        select {
            got = <-joined => {
                b = got
            }
            after(1) => {}
        }
        if b != none {
            break
        }
    }
    let second = b ?? panic("the second consumer did not join")
    poll(a, 1000) or []
    t.equal(assignment(a).len, 2)
    t.equal(assignment(second).len, 2)
    unsubscribe(second)
    unsubscribe(a)
    delete_topic(c, name) or {}
}

fn join_second(c: Client, o: ConsumerOptions, out: chan[Consumer]) {
    let cn = subscribe(c, o) or return
    out <- cn
}

/// `LOW_KAFKA_SASL_ADDR` names a listener that enables PLAIN, SCRAM-SHA-256 and SCRAM-SHA-512 for the user `bob` with the password `bob-secret`, and the tests of the mechanisms are skipped without it.
fn secured(t: *testing.T, m: Mechanism) -> Options {
    let addr = os.env("LOW_KAFKA_SASL_ADDR") ?? ""
    if addr.len == 0 {
        testing.skip(t, "LOW_KAFKA_SASL_ADDR is not set")
    }
    Options { brokers: [addr], timeout: 15000, sasl: some(m) }
}

fn authenticates(t: *testing.T, m: Mechanism) {
    let c = connect(secured(t, m)) catch {
        e => {
            t.fatal("connect failed: {testing.format(e)}")
            panic("unreachable")
        }
    }
    defer close(c)
    t.is_true(c.state.nodes.len >= 1)
}

fn test_sasl_plain_authenticates(t: *testing.T) {
    authenticates(t, Mechanism.Plain("bob", "bob-secret"))
}

fn test_sasl_scram_sha_256_authenticates(t: *testing.T) {
    authenticates(t, Mechanism.Scram256("bob", "bob-secret"))
}

fn test_sasl_scram_sha_512_authenticates(t: *testing.T) {
    authenticates(t, Mechanism.Scram512("bob", "bob-secret"))
}

fn test_a_wrong_password_is_refused(t: *testing.T) {
    for m in [Mechanism.Plain("bob", "wrong"), Mechanism.Scram256("bob", "wrong")] {
        connect(secured(t, m)) catch {
            e => {
                match e {
                    Auth(message) => {}
                    _ => t.error("expected Auth, got {testing.format(e)}")
                }
                continue
            }
        }
        t.error("connected with a wrong password")
    }
}
