import std/testing

fn signed(v: i64) -> i64 {
    if v >= 2147483648 {
        return v - 4294967296
    }
    v
}

fn test_murmur2_matches_the_java_client(t: *testing.T) {
    t.equal(signed(murmur2(bytes("21"))), -973932308)
    t.equal(signed(murmur2(bytes("foobar"))), -790332482)
    t.equal(signed(murmur2(bytes("a-little-bit-long-string"))), -985981536)
    t.equal(signed(murmur2(bytes("a-little-bit-longer-string"))), -1486304829)
    t.equal(signed(murmur2(bytes("lkjh234lh9fiuh90y23oiuhsafujhadof229phr9h19h89h8"))), -58897971)
    t.equal(signed(murmur2([0x61, 0x62, 0x63])), 479470107)
}

fn test_partition_for_stays_in_range_and_is_stable(t: *testing.T) {
    for n in [1, 2, 7, 64] {
        for i in 0..50 {
            let p = partition_for(bytes("key-{i}"), n)
            t.is_true(p >= 0 && p < n)
            t.equal(p, partition_for(bytes("key-{i}"), n))
        }
    }
    t.equal(partition_for(bytes("21"), 10), 0)
    t.equal(partition_for(bytes("foobar"), 1000), 166)
}
