import std/io
import std/crypto
import std/crypto/hash
import std/crypto/sasl
import std/text

/// A SASL mechanism and its credentials, for `Options.sasl`.
///
/// The password travels in the clear with `Plain`, so use it with `Options.tls`.
pub enum Mechanism {
    /// SASL PLAIN (RFC 4616) with a user name and password.
    Plain(user: str, password: str)
    /// SCRAM-SHA-256 (RFC 7677), which proves the password without sending it and checks the broker's signature.
    Scram256(user: str, password: str)
    /// SCRAM-SHA-512, as `Scram256` with SHA-512.
    Scram512(user: str, password: str)
}

fn mechanism_name(m: Mechanism) -> str {
    match m {
        Plain(user, password) => "PLAIN"
        Scram256(user, password) => "SCRAM-SHA-256"
        Scram512(user, password) => "SCRAM-SHA-512"
    }
}

fn handshake(c: *Conn, name: str) ! Error {
    var body: u8[] = []
    put_string(mut body, name)
    let cur = call(c, api_sasl_handshake, v_sasl_handshake, false, body, c.timeout)?
    let code = take_i16(cur)?
    if code == 33 {
        fail Unsupported
    }
    check(code)?
}

fn authenticate_bytes(c: *Conn, token: u8[]) -> u8[] ! Error {
    var body: u8[] = []
    put_compact_bytes(mut body, token)
    put_tags(mut body)
    let cur = call(c, api_sasl_authenticate, v_sasl_authenticate, true, body, c.timeout)?
    let code = take_i16(cur)?
    let message = take_compact_nullable_string(cur)?
    let reply = take_compact_bytes(cur)? ?? []
    let _ = take_i64(cur)?
    skip_tags(cur)?
    if code == 58 {
        fail Auth(message ?? "authentication failed")
    }
    check(code)?
    reply
}

fn authenticate(c: *Conn, m: Mechanism) ! Error {
    handshake(c, mechanism_name(m))?
    match m {
        Plain(user, password) => authenticate_plain(c, user, password)?
        Scram256(user, password) => authenticate_scram(c, hash.sha256(), user, password)?
        Scram512(user, password) => authenticate_scram(c, hash.sha512(), user, password)?
    }
}

fn authenticate_plain(c: *Conn, user: str, password: str) ! Error {
    var token: u8[] = [0]
    io.append(mut token, bytes(user))
    token.push(0)
    io.append(mut token, bytes(password))
    authenticate_bytes(c, token)?
}

fn scram_failure(e: sasl.Error) -> Error {
    match e {
        Rejected => Auth("the broker rejected the SCRAM exchange")
        Unsupported => Unsupported
        Malformed => Protocol
    }
}

fn authenticate_scram(c: *Conn, algorithm: hash.Algorithm, user: str, password: str) ! Error {
    let state = sasl.start(algorithm, user, password, text.encode_hex(crypto.random(18)))
    let server_first = authenticate_bytes(c, bytes(sasl.first(state)))?
    let client_final = sasl.final(state, str(server_first)) catch { e => fail scram_failure(e) }
    let server_final = authenticate_bytes(c, bytes(client_final))?
    sasl.verify(state, str(server_final)) catch { e => fail scram_failure(e) }
}
