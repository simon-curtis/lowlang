import std/testing

fn tp(topic: str, partition: i64) -> TopicPartition {
    TopicPartition { topic, partition }
}

fn owned_by(owned: Owned[], member: str) -> str {
    var out: str[] = []
    for o in owned {
        if o.member == member {
            out.push("{o.owned.topic}-{o.owned.partition}")
        }
    }
    var text = ""
    for i, s in out {
        text = if i == 0 { s } else { "{text} {s}" }
    }
    text
}

fn test_subscription_round_trips_and_reads_the_classic_layout(t: *testing.T) {
    let encoded = encode_subscription(["a", "bc"])
    t.equal_slice(encoded, [0, 0, 0, 0, 0, 2, 0, 1, 97, 0, 2, 98, 99, 255, 255, 255, 255])
    t.equal_slice(decode_subscription(encoded) or [], ["a", "bc"])
}

fn test_a_subscription_with_owned_partitions_is_read_up_to_the_topics(t: *testing.T) {
    var v1 = encode_subscription(["a"])
    v1[1] = 1
    for b in [0, 0, 0, 1, 0, 1, 97, 0, 0, 0, 1, 0, 0, 0, 3] {
        v1.push(u8(b))
    }
    t.equal_slice(decode_subscription(v1) or [], ["a"])
}

fn test_a_truncated_subscription_is_malformed(t: *testing.T) {
    let encoded = encode_subscription(["topic"])
    decode_subscription(encoded[..8]) catch {
        e => {
            t.equal(e == Error.Malformed, true)
            return
        }
    }
    t.error("accepted a truncated subscription")
}

fn test_assignment_round_trips_and_groups_partitions_by_topic(t: *testing.T) {
    let encoded = encode_assignment([tp("a", 0), tp("b", 4), tp("a", 2)])
    t.equal_slice(encoded, [0, 0, 0, 0, 0, 2, 0, 1, 97, 0, 0, 0, 2, 0, 0, 0, 0, 0, 0, 0, 2, 0, 1, 98, 0, 0, 0, 1, 0, 0, 0, 4, 255, 255, 255, 255])
    let got = decode_assignment(encoded) or []
    t.equal(got.len, 3)
    t.equal(got[0].topic, "a")
    t.equal(got[1].partition, 2)
    t.equal(got[2].topic, "b")
}

fn test_an_empty_assignment_is_no_partitions(t: *testing.T) {
    t.equal((decode_assignment([]) or [tp("x", 1)]).len, 0)
    t.equal((decode_assignment(encode_assignment([])) or [tp("x", 1)]).len, 0)
}

fn test_range_assignment_matches_the_java_client_example(t: *testing.T) {
    let subs = [Subscription { member: "C1", topics: ["t0", "t1"] }, Subscription { member: "C0", topics: ["t0", "t1"] }]
    let owned = assign_range(subs, ["t0": 3, "t1": 3])
    t.equal(owned_by(owned, "C0"), "t0-0 t0-1 t1-0 t1-1")
    t.equal(owned_by(owned, "C1"), "t0-2 t1-2")
}

fn test_range_assignment_only_gives_a_topic_to_its_subscribers(t: *testing.T) {
    let subs = [Subscription { member: "a", topics: ["x"] }, Subscription { member: "b", topics: ["x", "y"] }, Subscription { member: "c", topics: ["y"] }]
    let owned = assign_range(subs, ["x": 4, "y": 3])
    t.equal(owned_by(owned, "a"), "x-0 x-1")
    t.equal(owned_by(owned, "b"), "x-2 x-3 y-0 y-1")
    t.equal(owned_by(owned, "c"), "y-2")
}

fn test_range_assignment_leaves_surplus_members_empty(t: *testing.T) {
    let subs = [Subscription { member: "a", topics: ["x"] }, Subscription { member: "b", topics: ["x"] }, Subscription { member: "c", topics: ["x"] }]
    let owned = assign_range(subs, ["x": 2])
    t.equal(owned_by(owned, "a"), "x-0")
    t.equal(owned_by(owned, "b"), "x-1")
    t.equal(owned_by(owned, "c"), "")
}

fn test_range_assignment_skips_a_missing_topic(t: *testing.T) {
    let owned = assign_range([Subscription { member: "a", topics: ["x", "gone"] }], ["x": 1])
    t.equal(owned.len, 1)
    t.equal(owned_by(owned, "a"), "x-0")
}
