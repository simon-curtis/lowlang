import std/testing
import std/text

struct VarlongCase {
    value: i64
    hex: str
}

fn varlong_name(c: VarlongCase) -> str {
    "{c.value}"
}

fn check_varlong(t: *testing.T, c: VarlongCase) {
    var out: u8[] = []
    put_varlong(mut out, c.value)
    t.equal(text.encode_hex(out), c.hex)
    let at = cursor(out)
    t.equal(take_varlong(at) catch { e => t.unexpected(e, 0) }, c.value)
    t.equal(left(at), 0)
}

fn test_varlong_zigzag(t: *testing.T) {
    let cases: VarlongCase[] = [
        VarlongCase { value: 0, hex: "00" }
        VarlongCase { value: -1, hex: "01" }
        VarlongCase { value: 1, hex: "02" }
        VarlongCase { value: -2, hex: "03" }
        VarlongCase { value: 63, hex: "7e" }
        VarlongCase { value: -64, hex: "7f" }
        VarlongCase { value: 64, hex: "8001" }
        VarlongCase { value: 300, hex: "d804" }
        VarlongCase { value: 2147483647, hex: "feffffff0f" }
        VarlongCase { value: -2147483648, hex: "ffffffff0f" }
        VarlongCase { value: 9223372036854775807, hex: "feffffffffffffffff01" }
        VarlongCase { value: -9223372036854775808, hex: "ffffffffffffffffff01" }
    ]
    t.table_of(cases, varlong_name, check_varlong)
}

fn test_unsigned_varint_vectors(t: *testing.T) {
    var out: u8[] = []
    put_uvarint(mut out, 0)
    put_uvarint(mut out, 127)
    put_uvarint(mut out, 128)
    put_uvarint(mut out, 16384)
    t.equal(text.encode_hex(out), "007f8001808001")
    let at = cursor(out)
    t.equal(take_uvarint(at) catch { e => t.unexpected(e, u64(99)) }, u64(0))
    t.equal(take_uvarint(at) catch { e => t.unexpected(e, u64(99)) }, u64(127))
    t.equal(take_uvarint(at) catch { e => t.unexpected(e, u64(99)) }, u64(128))
    t.equal(take_uvarint(at) catch { e => t.unexpected(e, u64(99)) }, u64(16384))
}

fn malformed_uvarint(c: *Cursor) -> bool {
    take_uvarint(c) catch {
        e => return e == Error.Malformed
    }
    false
}

fn malformed_varint(c: *Cursor) -> bool {
    take_varint(c) catch {
        e => return e == Error.Malformed
    }
    false
}

fn malformed_string(c: *Cursor) -> bool {
    take_string(c) catch {
        e => return e == Error.Malformed
    }
    false
}

fn malformed_compact_string(c: *Cursor) -> bool {
    take_compact_string(c) catch {
        e => return e == Error.Malformed
    }
    false
}

fn malformed_count(c: *Cursor) -> bool {
    take_count(c) catch {
        e => return e == Error.Malformed
    }
    false
}

fn malformed_compact_count(c: *Cursor) -> bool {
    take_compact_count(c) catch {
        e => return e == Error.Malformed
    }
    false
}

fn test_varint_rejects_an_overlong_encoding(t: *testing.T) {
    t.is_true(malformed_uvarint(cursor([0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x01])))
}

fn test_varint_rejects_a_value_past_32_bits(t: *testing.T) {
    var out: u8[] = []
    put_varlong(mut out, 2147483648)
    t.is_true(malformed_varint(cursor(out)))
}

fn test_fixed_width_integers_are_big_endian_and_signed(t: *testing.T) {
    var out: u8[] = []
    put_i8(mut out, -2)
    put_i16(mut out, -2)
    put_i32(mut out, -2)
    put_i64(mut out, -2)
    t.equal(text.encode_hex(out), "fefffefffffffefffffffffffffffe")
    let c = cursor(out)
    t.equal(take_i8(c) catch { e => t.unexpected(e, 0) }, -2)
    t.equal(take_i16(c) catch { e => t.unexpected(e, 0) }, -2)
    t.equal(take_i32(c) catch { e => t.unexpected(e, 0) }, -2)
    t.equal(take_i64(c) catch { e => t.unexpected(e, 0) }, -2)
    t.equal(left(c), 0)
}

fn test_strings_classic_and_compact(t: *testing.T) {
    var out: u8[] = []
    put_string(mut out, "ab")
    put_nullable_string(mut out, none)
    put_compact_string(mut out, "ab")
    put_compact_nullable_string(mut out, none)
    t.equal(text.encode_hex(out), "00026162ffff03616200")
    let c = cursor(out)
    let marker: str? = some("x")
    t.equal(take_string(c) catch { e => t.unexpected(e, "") }, "ab")
    t.is_none(take_nullable_string(c) catch { e => t.unexpected(e, marker) })
    t.equal(take_compact_string(c) catch { e => t.unexpected(e, "") }, "ab")
    t.is_none(take_compact_nullable_string(c) catch { e => t.unexpected(e, marker) })
}

fn test_bytes_classic_and_compact(t: *testing.T) {
    var out: u8[] = []
    put_bytes(mut out, [1, 2])
    put_compact_bytes(mut out, [3])
    t.equal(text.encode_hex(out), "0000000201020203")
    let c = cursor(out)
    let absent: u8[]? = none
    let first = take_bytes(c) catch { e => t.unexpected(e, absent) }
    let second = take_compact_bytes(c) catch { e => t.unexpected(e, absent) }
    t.equal_slice(first ?? [], [1, 2])
    t.equal_slice(second ?? [], [3])
}

fn test_a_length_past_the_end_is_malformed(t: *testing.T) {
    t.is_true(malformed_string(cursor([0, 5, 97])))
    t.is_true(malformed_compact_string(cursor([6, 97])))
    t.is_true(malformed_count(cursor([0x7f, 0xff, 0xff, 0xff])))
    t.is_true(malformed_compact_count(cursor([0x7f])))
}

fn test_tagged_fields_are_skipped(t: *testing.T) {
    let c = cursor([1, 0, 2, 0xAA, 0xBB, 7])
    skip_tags(c) catch { e => t.error("skip_tags failed: {e}") }
    t.equal(left(c), 1)
    var out: u8[] = []
    put_tags(mut out)
    t.equal_slice(out, [0])
}
