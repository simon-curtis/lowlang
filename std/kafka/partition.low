const murmur_seed = 0x9747B28C
const murmur_mult = 0x5BD1E995
const mask32 = 0xFFFFFFFF

fn mix(h: i64) -> i64 {
    (h * murmur_mult) & mask32
}

fn murmur2(data: u8[]) -> i64 {
    var h = (murmur_seed ^ data.len) & mask32
    let whole = data.len / 4
    for i in 0..whole {
        let at = i * 4
        var k = i64(data[at]) | (i64(data[at + 1]) << 8) | (i64(data[at + 2]) << 16) | (i64(data[at + 3]) << 24)
        k = mix(k)
        k = k ^ (k >> 24)
        k = mix(k)
        h = mix(h) ^ k
    }
    let rest = data.len & 3
    let tail = whole * 4
    if rest == 3 {
        h = h ^ (i64(data[tail + 2]) << 16)
    }
    if rest >= 2 {
        h = h ^ (i64(data[tail + 1]) << 8)
    }
    if rest >= 1 {
        h = mix(h ^ i64(data[tail]))
    }
    h = h ^ (h >> 13)
    h = mix(h)
    h ^ (h >> 15)
}

/// Returns the partition of a topic with `partitions` partitions that holds the records with `key`, by the murmur2 hash of the Java client, so a record sent here lands where a Java producer would put it.
///
/// `partitions` must be at least `1`.
pub fn partition_for(key: u8[], partitions: i64) -> i64 {
    (murmur2(key) & 0x7FFFFFFF) % partitions
}
