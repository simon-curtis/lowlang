fn test_metadata_lists_partitions_and_their_leaders(t: *testing.T) {
    using l = net.listen("127.0.0.1", 0) or panic("listen failed")
    let port = l.handle.addr.port
    started(t, l, standard(port, "events", 3))
    let c = dialled(t, port, fake_options(port))
    defer close(c)
    let topics = metadata(c, ["events"]) or panic("metadata failed")
    t.equal(topics.len, 1)
    t.equal(topics[0].name, "events")
    t.equal(topics[0].partitions.len, 3)
    t.equal(topics[0].partitions[2].id, 2)
    t.equal(topics[0].partitions[2].leader, 1)
    t.equal(topics[0].partitions[2].leader_epoch, 4)
    t.equal_slice(topics[0].partitions[2].replicas, [1])
    t.equal_slice(topics[0].partitions[2].isr, [1])
    t.equal_slice(list_topics(c) or [], ["events"])
}

fn test_list_offsets_asks_for_the_timestamp_and_returns_the_offset(t: *testing.T) {
    using l = net.listen("127.0.0.1", 0) or panic("listen failed")
    let port = l.handle.addr.port
    let f = started(t, l, fn(r: Request) -> Reply {
        match r.api {
            18 => say(versions_reply(-1))
            3 => say(metadata_reply(port, "events", 1, 0))
            2 => say(list_offsets_reply("events", 0, 0, 55))
            _ => say_nothing()
        }
    })
    let c = dialled(t, port, fake_options(port))
    defer close(c)
    t.equal(list_offsets(c, "events", 0, earliest) or -9, 55)
    let cur = cursor(requests_of(f, 2)[0].body)
    take_i32(cur) or 0
    take_i8(cur) or 0
    take_compact_count(cur) or 0
    take_compact_string(cur) or ""
    take_compact_count(cur) or 0
    t.equal(take_i32(cur) or 0, 0)
    take_i32(cur) or 0
    t.equal(take_i64(cur) or 0, -2)
}

fn test_create_and_delete_topic_send_their_requests(t: *testing.T) {
    using l = net.listen("127.0.0.1", 0) or panic("listen failed")
    let port = l.handle.addr.port
    let f = started(t, l, fn(r: Request) -> Reply {
        var b: u8[] = []
        match r.api {
            18 => say(versions_reply(-1))
            3 => say(metadata_reply(port, "events", 1, 0))
            19 => {
                put_i32(mut b, 0)
                put_compact_count(mut b, 1)
                put_compact_string(mut b, "made")
                put_i16(mut b, 36)
                put_compact_nullable_string(mut b, none)
                put_i32(mut b, 1)
                put_i16(mut b, 1)
                put_compact_count(mut b, 0)
                put_tags(mut b)
                put_tags(mut b)
                say(b)
            }
            20 => {
                put_i32(mut b, 0)
                put_compact_count(mut b, 1)
                put_compact_string(mut b, "made")
                put_i16(mut b, 0)
                put_tags(mut b)
                put_tags(mut b)
                say(b)
            }
            _ => say_nothing()
        }
    })
    let c = dialled(t, port, fake_options(port))
    defer close(c)
    var code = 0
    create_topic(c, "made", 3, 2, ["cleanup.policy": "compact"]) catch {
        e => {
            code = code_of(e)
        }
    }
    t.equal(code, 36)
    let cur = cursor(requests_of(f, 19)[0].body)
    t.equal(take_compact_count(cur) or 0, 1)
    t.equal(take_compact_string(cur) or "", "made")
    t.equal(take_i32(cur) or 0, 3)
    t.equal(take_i16(cur) or 0, 2)
    take_compact_count(cur) or 0
    t.equal(take_compact_count(cur) or 0, 1)
    t.equal(take_compact_string(cur) or "", "cleanup.policy")
    t.equal(take_compact_nullable_string(cur) or none, some("compact"))
    delete_topic(c, "made") or panic("delete failed")
    t.equal(requests_of(f, 20).len, 1)
    create_topic(c, "", 1, 1, [:]) catch {
        e => {
            t.equal(e == Error.Argument, true)
            return
        }
    }
    t.error("create_topic accepted an empty name")
}

fn sasl_server(port: i64, accept: bool, seen: *Tokens) -> fn(Request) -> Reply {
    fn(r: Request) -> Reply {
        var b: u8[] = []
        match r.api {
            18 => say(versions_reply(-1))
            17 => {
                put_i16(mut b, 0)
                put_i32(mut b, 1)
                put_string(mut b, "PLAIN")
                say(b)
            }
            36 => {
                let c = cursor(r.body)
                seen.token = take_compact_bytes(c) or none
                put_i16(mut b, if accept { 0 } else { 58 })
                put_compact_nullable_string(mut b, if accept { none } else { some("bad credentials") })
                put_compact_bytes(mut b, [])
                put_i64(mut b, 0)
                put_tags(mut b)
                say(b)
            }
            3 => say(metadata_reply(port, "events", 1, 0))
            _ => say_nothing()
        }
    }
}

struct Tokens {
    token: u8[]?
}

fn test_sasl_plain_sends_authzid_user_and_password(t: *testing.T) {
    using l = net.listen("127.0.0.1", 0) or panic("listen failed")
    let port = l.handle.addr.port
    let seen = new(Tokens { token: none })
    let f = started(t, l, sasl_server(port, true, seen))
    let c = connect(Options { brokers: ["127.0.0.1:{port}"], timeout: 2000, sasl: some(Mechanism.Plain("alice", "s3cret")) }) or panic("connect failed")
    close(c)
    t.equal_slice(seen.token ?? [], [0, 97, 108, 105, 99, 101, 0, 115, 51, 99, 114, 101, 116])
    t.equal_slice(apis_seen(f), [18, 17, 36, 3])
    let cur = cursor(requests_of(f, 17)[0].body)
    t.equal(take_string(cur) or "", "PLAIN")
}

fn test_sasl_refusal_is_auth_with_the_broker_message(t: *testing.T) {
    using l = net.listen("127.0.0.1", 0) or panic("listen failed")
    let port = l.handle.addr.port
    started(t, l, sasl_server(port, false, new(Tokens { token: none })))
    connect(Options { brokers: ["127.0.0.1:{port}"], timeout: 2000, sasl: some(Mechanism.Plain("alice", "nope")) }) catch {
        e => {
            match e {
                Auth(message) => t.equal(message, "bad credentials")
                _ => t.error("expected Auth")
            }
            return
        }
    }
    t.error("connected with refused credentials")
}

fn test_sasl_mechanism_the_broker_lacks_is_unsupported(t: *testing.T) {
    using l = net.listen("127.0.0.1", 0) or panic("listen failed")
    started(t, l, fn(r: Request) -> Reply {
        var b: u8[] = []
        if r.api == 17 {
            put_i16(mut b, 33)
            put_i32(mut b, 1)
            put_string(mut b, "PLAIN")
            return say(b)
        }
        say(versions_reply(-1))
    })
    connect(Options { brokers: ["127.0.0.1:{l.handle.addr.port}"], timeout: 2000, sasl: some(Mechanism.Scram512("a", "b")) }) catch {
        e => {
            t.equal(e == Error.Unsupported, true)
            return
        }
    }
    t.error("connected although the broker lacks the mechanism")
}

fn test_concurrent_calls_share_one_client(t: *testing.T) {
    using l = net.listen("127.0.0.1", 0) or panic("listen failed")
    let port = l.handle.addr.port
    let f = started(t, l, fn(r: Request) -> Reply {
        match r.api {
            18 => say(versions_reply(-1))
            3 => say(metadata_reply(port, "events", 1, 0))
            0 => say(produce_reply("events", 0, 0, 1))
            _ => say_nothing()
        }
    })
    let c = dialled(t, port, fake_options(port))
    defer close(c)
    let done = sync.wait_group()
    sync.add(done, 8)
    let failures = new(Counter { n: 0 })
    for i in 0..8 {
        spawn writer(c, done, failures)
    }
    sync.wait(done)
    t.equal(failures.n, 0)
    t.equal(requests_of(f, 0).len, 40)
}

fn writer(c: Client, done: sync.WaitGroup, failures: *Counter) {
    defer sync.done(done)
    for i in 0..5 {
        if (produce(c, "events", 0, [Record { value: some(bytes("x")) }], ProduceOptions {}) or -1) < 0 {
            failures.n += 1
        }
    }
}
