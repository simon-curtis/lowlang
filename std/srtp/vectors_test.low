import std/crypto/aead
import std/crypto/cipher
import std/io
import std/slices
import std/testing
import std/text

fn hex(s: str) -> u8[] {
    text.decode_hex(s) or panic("hex")
}

fn same(a: u8[], b: u8[]) -> bool {
    slices.equal(a, b)
}

fn direct_gcm(key: u8[]) -> *Context {
    let sealer = aead.aes_gcm(key) or panic("key")
    let suite = Suite { mode: Mode.Galois(sealer), salt: hex("517569642070726f2071756f") }
    new(Context { params: Params { key_size: key.len, salt_size: 12, rtp_tag: 16, gcm: true }, rtp: suite, rtcp: suite })
}

fn key128() -> u8[] {
    hex("000102030405060708090a0b0c0d0e0f")
}

fn key256() -> u8[] {
    hex("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f")
}

fn rfc7714_rtp() -> u8[] {
    join([hex("8040f17b8041f8d35501a0b2"), bytes("Gallia est omnis divisa in partes tres")])
}

fn rfc7714_rtcp() -> u8[] {
    hex("81c8000d4d6172734e5450314e545032525450200000042a0000e9304c756e61deadbeefdeadbeefdeadbeefdeadbeefdeadbeef")
}

fn test_key_derivation_of_rfc_3711_appendix_b3(t: *testing.T) {
    let key = hex("E1F97A0D3E018BE0D64FA32C06DE4139")
    let salt = hex("0EC675AD498AFEEBB6960B3AABE6")
    let cipher_key = derive(key, salt, label_rtp_key, 16) or panic("derive")
    let cipher_salt = derive(key, salt, label_rtp_salt, 14) or panic("derive")
    let auth_key = derive(key, salt, label_rtp_auth, 94) or panic("derive")
    testing.error_if(t, !same(cipher_key, hex("C61E7A93744F39EE10734AFE3FF7A087")), "cipher key {text.encode_hex(cipher_key)}")
    testing.error_if(t, !same(cipher_salt, hex("30CBBC08863D8C85D49DB34A9AE1")), "cipher salt {text.encode_hex(cipher_salt)}")
    let want = hex("CEBE321F6FF7716B6FD4AB49AF256A15" + "6D38BAA48F0A0ACF3C34E2359E6CDBCE" + "E049646C43D9327AD175578EF7227098" + "6371C10C9A369AC2F94A8C5FBCDDDC25" + "6D6E919A48B610EF17C2041E47403576" + "6B68642C59BBFC2F34DB60DBDFB2")
    testing.error_if(t, !same(auth_key, want), "auth key {text.encode_hex(auth_key)}")
}

fn test_aes_counter_keystream_of_rfc_3711_appendix_b2(t: *testing.T) {
    let block = cipher.aes(hex("2B7E151628AED2A6ABF7158809CF4F3C")) or panic("aes")
    let stream = cipher.ctr(block, hex("F0F1F2F3F4F5F6F7F8F9FAFBFCFD0000"), io.buffer(65282 * 16)) or panic("ctr")
    let blocks: [i64: str] = [
        0: "E03EAD0935C95E80E166B16DD92B4EB4"
        1: "D23513162B02D0F72A43A2FE4A5F97AB"
        2: "41E95B3BB0A2E8DD477901E4FCA894C0"
        0xFEFF: "EC8CDF7398607CB0F2D21675EA9EA1E4"
        0xFF00: "362B7C3C6773516318A077D7FC5073AE"
        0xFF01: "6A2CC3787889374FBEB4C81B17BA6C44"
    ]
    for n, want in blocks {
        testing.error_if(t, !same(stream[16 * n..16 * n + 16], hex(want)), "block {n}")
    }
}

fn test_aes_128_gcm_rtp_of_rfc_7714_section_16(t: *testing.T) {
    let sealed = hex("8040f17b8041f8d35501a0b2f24de3a3fb34de6cacba861c9d7e4bcabe633bd50d294e6f42a5f47a51c7d19b36de3adf8833899d7f27beb16a9152cf765ee4390cce")
    let out = protect(direct_gcm(key128()), rfc7714_rtp()) or panic("protect")
    testing.error_if(t, !same(out, sealed), "protect {text.encode_hex(out)}")
    let back = unprotect(direct_gcm(key128()), sealed) or panic("unprotect")
    testing.error_if(t, !same(back, rfc7714_rtp()), "unprotect {text.encode_hex(back)}")
}

fn test_aes_256_gcm_rtp_of_rfc_7714_section_16(t: *testing.T) {
    let sealed = hex("8040f17b8041f8d35501a0b232b1de78a822fe12ef9f78fa332e33aab18012389a58e2f3b50b2a0276ffae0f1ba63799b87b7aa3db36dfffd6b0f9bb7878d7a76c13")
    let out = protect(direct_gcm(key256()), rfc7714_rtp()) or panic("protect")
    testing.error_if(t, !same(out, sealed), "protect {text.encode_hex(out)}")
    let back = unprotect(direct_gcm(key256()), sealed) or panic("unprotect")
    testing.error_if(t, !same(back, rfc7714_rtp()), "unprotect {text.encode_hex(back)}")
}

fn test_aes_128_gcm_rtcp_encryption_of_rfc_7714_section_17(t: *testing.T) {
    let sealed = hex("81c8000d4d61727363e94885dcdab67ca727d7662f6b7e997ff5c0f76c06f32dc676a5f1730d6fda4ce09b4686303ded0bb9275bc84aa45896cf4d2fc5abf87245d9eade800005d4")
    let out = seal_rtcp(direct_gcm(key128()), rfc7714_rtcp(), 0x5d4) or panic("seal")
    testing.error_if(t, !same(out, sealed), "seal {text.encode_hex(out)}")
    let back = unprotect_rtcp(direct_gcm(key128()), sealed) or panic("unprotect")
    testing.error_if(t, !same(back, rfc7714_rtcp()), "unprotect {text.encode_hex(back)}")
}

fn test_aes_256_gcm_rtcp_decryption_of_rfc_7714_section_17(t: *testing.T) {
    let sealed = hex("81c8000d4d617273d50ae4d1f5ce5d304ba297e47d470c282c3ece5dbffe0a50a2eaa5c1110555be8415f658c61de0476f1b6fad1d1eb30c4446839f57ff6f6cb26ac3be800005d4")
    let back = unprotect_rtcp(direct_gcm(key256()), sealed) or panic("unprotect")
    testing.error_if(t, !same(back, rfc7714_rtcp()), "unprotect {text.encode_hex(back)}")
}

fn test_rtcp_tag_only_packets_of_rfc_7714_section_17(t: *testing.T) {
    let tagged128 = hex("81c8000d4d6172734e5450314e545032525450200000042a0000e9304c756e61deadbeefdeadbeefdeadbeefdeadbeefdeadbeef841dd9683dd78ec92ae58790125f62b3000005d4")
    let tagged256 = hex("81c8000d4d6172734e5450314e545032525450200000042a0000e9304c756e61deadbeefdeadbeefdeadbeefdeadbeefdeadbeef91db4afbfeee5a978fab4393ed2615fe000005d4")
    let a = unprotect_rtcp(direct_gcm(key128()), tagged128) or panic("128")
    let b = unprotect_rtcp(direct_gcm(key256()), tagged256) or panic("256")
    testing.error_if(t, !same(a, rfc7714_rtcp()) || !same(b, rfc7714_rtcp()), "plain packet")
    var forged = tagged128
    forged[forged.len - 20] = forged[forged.len - 20] ^ 1
    testing.error_if(t, rtcp_error(direct_gcm(key128()), forged) != Error.AuthFailed, "forged tag-only packet")
}

fn rtcp_error(c: *Context, packet: u8[]) -> Error? {
    unprotect_rtcp(c, packet) catch {
        e => return e
    }
    none
}

fn rtp_error(c: *Context, packet: u8[]) -> Error? {
    unprotect(c, packet) catch {
        e => return e
    }
    none
}

fn test_a_bit_flipped_anywhere_fails_authentication(t: *testing.T) {
    let sealed = protect(direct_gcm(key128()), rfc7714_rtp()) or panic("protect")
    for i in 0..sealed.len {
        let forged = slices.clone(sealed)
        forged[i] = forged[i] ^ 0x80
        testing.error_if(t, rtp_error(direct_gcm(key128()), forged) == none, "byte {i} accepted")
    }
}

struct Capture {
    profile: i64
    key: str
    salt: str
    sealed: str[]
    rtcp: str
}

fn libsrtp_plain() -> str[] {
    let zeros = "00000000000000000000000000000000"
    ["80e0fffe0000000012345678" + zeros, "8060ffff0000000812345678" + zeros, "806000000000001012345678" + zeros]
}

fn libsrtp_report() -> u8[] {
    hex("81c8000c12345678e500000080000000000010000000000a000004b00a0b0c0d19fffffe00010005000000071122334400010000")
}

fn libsrtp_captures() -> Capture[] {
    let cm80: str[] = [
        "80e0fffe00000000123456787a1c145cf322e23578356161139ead8af798b64315bde58c8d35"
        "8060ffff00000008123456783b6bbc7eeb4efdd7e409f7ba89339fa85250525a7ed3b29772d4"
        "806000000000001012345678a35b71b34fc7481d1489cf7ba2e7d456b0eb0182d80531e657a6"
    ]
    let cm_rtcp = "81c8000c12345678826a2b0104a1143a16960d079969f04797f647b5d8a008f52e9e23389bc926a0b4532386fd42769ae2a6cfce8000000196da219fcd91d092bc4a"
    var cm32: str[] = []
    for packet in cm80 {
        cm32.push(packet[..packet.len - 12])
    }
    [
        Capture { profile: profile_aes128_cm_sha1_80, key: "000102030405060708090a0b0c0d0e0f", salt: "101112131415161718191a1b1c1d", sealed: cm80, rtcp: cm_rtcp }
        Capture { profile: profile_aes128_cm_sha1_32, key: "000102030405060708090a0b0c0d0e0f", salt: "101112131415161718191a1b1c1d", sealed: cm32, rtcp: cm_rtcp }
        Capture {
            profile: profile_aead_aes_128_gcm
            key: "000102030405060708090a0b0c0d0e0f"
            salt: "101112131415161718191a1b"
            sealed: [
                "80e0fffe00000000123456787b176be489e99e31d3416e73c00b98b0dbf362d212fb46aab1696e49e1b97b95"
                "8060ffff0000000812345678e040903bd36de2f8ee3094646e90b4873e62a4ce6e1b693139a79dad6db42b46"
                "80600000000000101234567838736cff1d8c44d36a01a35c7019bb693804574072e9d28bcc0e870a83eac388"
            ]
            rtcp: "81c8000c123456785d6552194ab8f47f220d16d8c9863083475c100a3807d6cfa78054941b057e143527d093c0a5e91d0b80e8e971c7c81a95efc5e367e148e64129fd1880000001"
        }
        Capture {
            profile: profile_aead_aes_256_gcm
            key: "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f"
            salt: "202122232425262728292a2b"
            sealed: [
                "80e0fffe00000000123456780e5624ef2921baf89c67526c450a6a1f69be41cacfe50b10228196f1ea841bde"
                "8060ffff00000008123456784b8041f17e826f352dd155f2983d52e4e6dac94ec16713593ac21c03a22d84b1"
                "8060000000000010123456786148d7a9d34a3db3ea304cdbb61be8fdb51e42717369fd26d51a286b1bfefd98"
            ]
            rtcp: "81c8000c12345678df71577b4a0040f2f9a9ed161f82630f4d23fc5e723ec1cdb3bf57ba1308e55da90c61a88fc4eecafd148ac686c6b14357478ef1b2382f8acc140e6480000001"
        }
    ]
}

fn keyed(c: Capture) -> *Context {
    context(c.profile, hex(c.key), hex(c.salt)) or panic("context {c.profile}")
}

fn test_packets_sealed_by_libsrtp_across_the_rollover(t: *testing.T) {
    let plain = libsrtp_plain()
    for c in libsrtp_captures() {
        let receiver = keyed(c)
        let sender = keyed(c)
        for i, sealed in c.sealed {
            let opened = unprotect(receiver, hex(sealed)) or {
                testing.error(t, "profile {c.profile} packet {i} refused")
                continue
            }
            testing.error_if(t, !same(opened, hex(plain[i])), "profile {c.profile} packet {i} opened {text.encode_hex(opened)}")
            let out = protect(sender, hex(plain[i])) or panic("protect")
            testing.error_if(t, text.encode_hex(out) != sealed, "profile {c.profile} packet {i} sealed {text.encode_hex(out)}")
        }
        let report = unprotect_rtcp(receiver, hex(c.rtcp)) or {
            testing.error(t, "profile {c.profile} SRTCP refused")
            continue
        }
        testing.error_if(t, !same(report, libsrtp_report()), "profile {c.profile} report {text.encode_hex(report)}")
        let resealed = seal_rtcp(sender, libsrtp_report(), 1) or panic("seal")
        testing.error_if(t, text.encode_hex(resealed) != c.rtcp, "profile {c.profile} SRTCP {text.encode_hex(resealed)}")
    }
}
