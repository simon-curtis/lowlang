import std/dtls
import std/rtp
import std/srtp

fn flush(from: *dtls.Conn, to: *dtls.Conn, now: i64) {
    for {
        let datagram = dtls.poll_transmit(from) ?? break
        dtls.receive(to, datagram, now)
    }
}

fn keys(c: *dtls.Conn, client: bool) -> srtp.Pair ! srtp.Error {
    let profile = dtls.srtp_profile(c)
    let size = srtp.keying_material_size(profile)?
    let material = dtls.export_keying_material(c, "EXTRACTOR-dtls_srtp", size) or fail srtp.Error.InvalidKey
    srtp.from_dtls(profile, material, client)
}

fn refusal(c: *srtp.Context, packet: u8[]) -> str {
    srtp.unprotect(c, packet) catch {
        e => return "{e}"
    }
    "accepted"
}

fn main() {
    let client_identity = dtls.generate_identity("client", 1700000000, 4102444800) or return
    let server_identity = dtls.generate_identity("server", 1700000000, 4102444800) or return
    let client_print = dtls.fingerprint("sha-256", client_identity.certificate) or return
    let server_print = dtls.fingerprint("sha-256", server_identity.certificate) or return
    let profiles = [dtls.srtp_aead_aes_128_gcm, dtls.srtp_aes128_cm_sha1_80]
    let client = dtls.conn(dtls.Config { client: true, identity: client_identity, fingerprints: [server_print], srtp_profiles: profiles })
    let server = dtls.conn(dtls.Config { client: false, identity: server_identity, fingerprints: [client_print], srtp_profiles: profiles })
    dtls.start(client, 0)
    for round in 0..10 {
        flush(client, server, round)
        flush(server, client, round)
    }
    print("profile {dtls.srtp_profile(client)}")
    let caller = keys(client, true) or return
    let callee = keys(server, false) or return
    let frame = rtp.marshal(rtp.Packet { payload_type: 96, sequence: 1, timestamp: 3000, ssrc: 0xBEEF, payload: bytes("video frame") }) or return
    let sealed = srtp.protect(caller.send, frame) or return
    print("{frame.len} bytes sealed into {sealed.len}, {rtp.classify(sealed)}")
    let opened = srtp.unprotect(callee.receive, sealed) or return
    print("opened: {str((rtp.parse(opened) or return).payload)}")
    print("again: {refusal(callee.receive, sealed)}")
    let fresh = srtp.protect(caller.send, rtp.marshal(rtp.Packet { payload_type: 96, sequence: 2, timestamp: 6000, ssrc: 0xBEEF, payload: bytes("next") }) or return) or return
    fresh[fresh.len - 1] = fresh[fresh.len - 1] ^ 1
    print("tampered: {refusal(callee.receive, fresh)}")
    let report = rtp.marshal_rtcp([rtp.Rtcp.Pli(rtp.PictureLoss { sender: 0xCAFE, media: 0xBEEF })]) or return
    let control = srtp.protect_rtcp(callee.send, report) or return
    let back = srtp.unprotect_rtcp(caller.receive, control) or return
    print("picture loss reaches the sender: {(rtp.parse_rtcp(back) or return).len} packet")
}
