import std/text

/// The error returned when CSV text is malformed (RFC 4180).
pub enum Error {
    /// A quoted field is never closed before the end of the input.
    ///
    /// `line` is the line on which the field's opening quote appears, counting from `1`.
    UnterminatedQuote(line: i64)
    /// A `"` appears inside an unquoted field, or a closed quoted field is followed by something other than the separator or a line end.
    ///
    /// `line` is the line on which the offending field ends, counting from `1`.
    BareQuote(line: i64)
}

struct Scanner {
    src: str
    at: i64
    line: i64
    separator: u8
}

fn field(s: *Scanner) -> str ! Error {
    if s.at < s.src.len && s.src[s.at] == '"' {
        return quoted(s)
    }
    let start = s.at
    for s.at < s.src.len && s.src[s.at] != s.separator && s.src[s.at] != '\n' && s.src[s.at] != '\r' {
        if s.src[s.at] == '"' {
            fail BareQuote(s.line)
        }
        s.at += 1
    }
    s.src[start..s.at]
}

fn quoted(s: *Scanner) -> str ! Error {
    let line = s.line
    s.at += 1
    var out: []u8 = []
    for {
        if s.at >= s.src.len {
            fail UnterminatedQuote(line)
        }
        let c = s.src[s.at]
        if c == '"' {
            if s.at + 1 < s.src.len && s.src[s.at + 1] == '"' {
                push(mut out, '"')
                s.at += 2
                continue
            }
            s.at += 1
            if s.at < s.src.len && s.src[s.at] != s.separator && s.src[s.at] != '\n' && s.src[s.at] != '\r' {
                fail BareQuote(s.line)
            }
            return str(out)
        }
        if c == '\n' {
            s.line += 1
        }
        push(mut out, c)
        s.at += 1
    }
}

fn record(s: *Scanner) -> []str ! Error {
    var fields: []str = []
    for {
        push(mut fields, field(s)?)
        if s.at < s.src.len && s.src[s.at] == s.separator {
            s.at += 1
            continue
        }
        if s.at < s.src.len && s.src[s.at] == '\r' {
            s.at += 1
        }
        if s.at < s.src.len && s.src[s.at] == '\n' {
            s.at += 1
        }
        s.line += 1
        return fields
    }
}

/// Parses `src` into records of fields split on `separator`.
///
/// Records end at `\n`, `\r\n` or a lone `\r`; the final line end is optional. Empty lines are skipped, so they produce no record, while a line holding only spaces is a record with one field. Fields are not trimmed. A field that starts with `"` is quoted: it may hold the separator and line ends, and `""` stands for one `"`. Records may have different numbers of fields, and a trailing separator yields a final empty field. Empty input gives no records.
///
/// Fails with `UnterminatedQuote` or `BareQuote`, each carrying a line number.
pub fn parse_with(src: str, separator: u8) -> [][]str ! Error {
    let s = new(Scanner { src: src, at: 0, line: 1, separator: separator })
    var records: [][]str = []
    for s.at < src.len {
        if src[s.at] == '\n' || src[s.at] == '\r' {
            s.at += 1
            if src[s.at - 1] == '\n' {
                s.line += 1
            }
            continue
        }
        push(mut records, record(s)?)
    }
    records
}

/// Parses `src` as comma separated records.
///
/// Equivalent to `parse_with(src, ',')`.
pub fn parse(src: str) -> [][]str ! Error {
    parse_with(src, ',')?
}

fn needs_quotes(value: str, separator: u8) -> bool {
    for i in 0..value.len {
        let c = value[i]
        if c == separator || c == '"' || c == '\n' || c == '\r' {
            return true
        }
    }
    value.len > 0 && (value[0] == ' ' || value[value.len - 1] == ' ')
}

/// Appends one record to `out`, with fields joined by `separator` and a `\r\n` line end.
///
/// A field is quoted when it contains the separator, `"`, `\r` or `\n`, or starts or ends with a space; inside quotes each `"` is doubled. Other fields are written as they are. An empty `fields` slice appends only the line end.
pub fn append_record(mut out: []u8, fields: []str, separator: u8) {
    for i, value in fields {
        if i > 0 {
            push(mut out, separator)
        }
        if !needs_quotes(value, separator) {
            text.append(mut out, value)
            continue
        }
        push(mut out, '"')
        for j in 0..value.len {
            if value[j] == '"' {
                push(mut out, '"')
            }
            push(mut out, value[j])
        }
        push(mut out, '"')
    }
    text.append(mut out, "\r\n")
}

/// Formats `records` as CSV text with fields separated by `separator`.
///
/// Each record is written by `append_record`, so every record, including the last, ends with `\r\n`. Empty `records` gives an empty string.
pub fn format_with(records: [][]str, separator: u8) -> str {
    var out: []u8 = []
    for r in records {
        append_record(mut out, r, separator)
    }
    str(out)
}

/// Formats `records` as comma separated CSV text.
///
/// Equivalent to `format_with(records, ',')`.
pub fn format(records: [][]str) -> str {
    format_with(records, ',')
}
