import std/datachannel
import std/sctp
import std/sctp/session

fn main() {
    let to_client = chan[u8[]](64)
    let to_server = chan[u8[]](64)
    using client = datachannel.open(sctp.Config { client: true }, session.Transport { send: fn(p) { to_server <- p }, incoming: to_client })
    using server = datachannel.open(sctp.Config { client: false }, session.Transport { send: fn(p) { to_client <- p }, incoming: to_server })
    datachannel.wait_connected(client.handle) or return
    datachannel.wait_connected(server.handle) or return
    let chat = datachannel.open_channel(client.handle, datachannel.Options { label: "chat" }) or return
    print("client opened {chat.label} on stream {chat.id}")
    datachannel.send_text(chat, "hello") or return
    let accepted = (<-server.handle.incoming) ?? return
    print("server accepted {accepted.label} on stream {accepted.id}")
    let message = datachannel.receive(accepted) or return
    print("server received {str(message.data)}, text {message.text}")
    datachannel.send_binary(accepted, [1, 2, 3]) or return
    let reply = datachannel.receive(chat) or return
    print("client received {reply.data.len} bytes, text {reply.text}")
    datachannel.close_channel(chat)
    let closed = datachannel.receive(accepted) catch {
        _ => {
            print("server channel closed")
            return
        }
    }
    print("unexpected message of {closed.data.len} bytes")
}
