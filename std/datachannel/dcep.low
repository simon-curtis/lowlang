import std/io

const message_open: u8 = 3
const message_ack: u8 = 2
const open_header = 12

/// The payload protocol identifier of DCEP messages.
pub const ppid_dcep: i64 = 50
/// The payload protocol identifier of a text message.
pub const ppid_text: i64 = 51
/// The payload protocol identifier of a binary message.
pub const ppid_binary: i64 = 53
/// The payload protocol identifier of an empty text message, which is sent as one zero byte.
pub const ppid_text_empty: i64 = 56
/// The payload protocol identifier of an empty binary message, which is sent as one zero byte.
pub const ppid_binary_empty: i64 = 57

/// The reliability of a channel (RFC 8832 section 5.1).
pub enum Reliability {
    /// Every message is retransmitted until it arrives.
    Reliable = 0
    /// A message is retransmitted at most `Open.parameter` times.
    Retransmits = 1
    /// A message is abandoned `Open.parameter` milliseconds after it was queued.
    Timed = 2
}

/// A DATA_CHANNEL_OPEN message.
pub struct Open {
    /// How the channel retransmits.
    pub reliability: Reliability
    /// Whether messages arrive in the order they were sent.
    pub ordered: bool
    /// The channel priority, which the receiver may use to schedule its sends.
    pub priority: i64
    /// The retransmission count or the lifetime in milliseconds, according to `reliability`, and 0 for a reliable channel.
    pub parameter: i64
    /// The channel name, which may be empty.
    pub label: str
    /// The subprotocol name, which is empty when none is specified.
    pub protocol: str
}

/// Encodes `open` as the payload of a DCEP message.
pub fn encode_open(open: Open) -> u8[] {
    var out: u8[] = [message_open, u8(open.reliability.index | if open.ordered { 0 } else { 0x80 })]
    io.put_be16(mut out, open.priority)
    io.put_be32(mut out, open.parameter)
    let label = bytes(open.label)
    let protocol = bytes(open.protocol)
    io.put_be16(mut out, label.len)
    io.put_be16(mut out, protocol.len)
    io.append(mut out, label)
    io.append(mut out, protocol)
    out
}

/// The DATA_CHANNEL_ACK message.
pub fn encode_ack() -> u8[] {
    [message_ack]
}

/// Whether `payload` is a DATA_CHANNEL_ACK: a first byte of 2, whatever follows it, because peers pad the message to four bytes. Bytes after the message type are ignored, as some implementations pad the message.
pub fn is_ack(payload: u8[]) -> bool {
    payload.len >= 1 && payload[0] == message_ack
}

/// Parses a DATA_CHANNEL_OPEN payload.
///
/// Fails with `Invalid` when the payload is not an OPEN message, is shorter than its lengths state or holds an unknown channel type.
pub fn parse_open(payload: u8[]) -> Open ! io.Error {
    if payload.len < open_header || payload[0] != message_open {
        fail Invalid
    }
    let kind = payload[1]
    let reliability = match kind & 0x7F {
        0 => Reliability.Reliable
        1 => Reliability.Retransmits
        2 => Reliability.Timed
        _ => fail Invalid
    }
    let label_length = io.be16(payload, 8)
    let protocol_length = io.be16(payload, 10)
    if payload.len != open_header + label_length + protocol_length {
        fail Invalid
    }
    let split = open_header + label_length
    Open {
        reliability
        ordered: (kind & 0x80) == 0
        priority: io.be16(payload, 2)
        parameter: if reliability == Reliability.Reliable { 0 } else { io.be32(payload, 4) }
        label: str(payload[open_header..split])
        protocol: str(payload[split..])
    }
}
