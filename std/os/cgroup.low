import std/io
import std/sys
import std/text

const default_period = 100000

/// A mount from `/proc/self/mountinfo`.
pub struct Mount {
    /// The directory of the mounted file system that appears at `point`.
    pub root: str
    /// The path the file system is mounted at.
    pub point: str
    /// The file system type.
    pub fs: str
}

/// A control group in the unified hierarchy, found through the mount that exposes it.
pub struct Cgroup {
    /// The directory the cgroup2 file system is mounted at.
    pub mount: str
    /// The path of the group below `mount`, starting with `/`, where `/` is the mount's top group.
    pub path: str
}

/// A CPU bandwidth limit: the group may run `quota` microseconds in every `period` microseconds.
pub struct CpuLimit {
    /// The microseconds of CPU time the group may use in each period.
    pub quota: i64
    /// The length of a period in microseconds.
    pub period: i64
    /// The effective number of CPUs, which is `quota` divided by `period`.
    pub cpus: f64
}

/// The CPU and memory limits that apply to a process.
///
/// A field that is `none` has no limit, or for `memory_current` is not reported.
pub struct CgroupLimits {
    /// The CPU bandwidth limit of the nearest group that sets one.
    pub cpu: CpuLimit?
    /// The memory limit in bytes of the nearest group that sets one.
    pub memory_max: i64?
    /// The memory usage in bytes above which the group is throttled, from the nearest group that sets one.
    pub memory_high: i64?
    /// The memory in bytes the process's own group uses at present.
    pub memory_current: i64?
}

fn read_text(path: str) -> str ! io.Error {
    let opened = sys.open(path, sys.Open.Read, 0)?
    let stream = sys.stream_on(opened)
    defer stream.close()
    let content = io.read_all(stream)?
    str(content)
}

fn octal_digit(c: u8) -> bool {
    c >= '0' && c <= '7'
}

fn unescape(field: str) -> str {
    if text.index_byte(field, '\\') < 0 {
        return field
    }
    var out: u8[] = []
    var i = 0
    for i < field.len {
        let escaped = field[i] == '\\' && i + 3 < field.len && field[i + 1] <= '3' && octal_digit(field[i + 1]) && octal_digit(field[i + 2]) && octal_digit(field[i + 3])
        if escaped {
            out.push(u8((i64(field[i + 1] - '0') << 6) | (i64(field[i + 2] - '0') << 3) | i64(field[i + 3] - '0')))
            i += 4
        } else {
            out.push(field[i])
            i += 1
        }
    }
    str(out)
}

fn parse_mount(line: str) -> Mount? {
    let fields = text.fields(line)
    var dash = 6
    for dash < fields.len && fields[dash] != "-" {
        dash += 1
    }
    if dash + 2 >= fields.len {
        return none
    }
    Mount { root: unescape(fields[3]), point: unescape(fields[4]), fs: fields[dash + 1] }
}

/// Parses the text of `/proc/self/mountinfo` into its mounts, in file order.
///
/// Skips a line that has fewer than six fields before the `-` separator, no separator, or no file system type after it. Octal escapes such as `\040` in the root and the mount point are decoded. The file system type is a slice of `content`.
pub fn parse_mountinfo(content: str) -> Mount[] {
    var mounts: Mount[] = []
    for line in text.lines(content) {
        let mount = parse_mount(line) ?? continue
        mounts.push(mount)
    }
    mounts
}

fn cgroup2_path(proc_cgroup: str) -> str? {
    for line in text.lines(proc_cgroup) {
        if text.starts_with(line, "0::") && line.len > 3 && line[3] == '/' {
            return line[3..]
        }
    }
    none
}

fn below(root: str, path: str) -> str? {
    if root == "/" {
        return path
    }
    if path == root {
        return "/"
    }
    if text.starts_with(path, root) && path[root.len] == '/' {
        return path[root.len..]
    }
    none
}

/// Returns the control group that the text of `/proc/self/cgroup` names for the unified hierarchy, found through the cgroup2 mount in `mounts`, or `none`.
///
/// `none` means the process is not in a cgroup v2 hierarchy: the text has no `0::` entry, no cgroup2 mount is given, or no cgroup2 mount has the group below its root. The first mount that exposes the group is used.
pub fn locate_cgroup(proc_cgroup: str, mounts: Mount[]) -> Cgroup? {
    let path = cgroup2_path(proc_cgroup) ?? return none
    for mount in mounts {
        if mount.fs != "cgroup2" {
            continue
        }
        let relative = below(mount.root, path) ?? continue
        return Cgroup { mount: mount.point, path: relative }
    }
    none
}

fn parse_number(content: str) -> i64 ! io.Error {
    let value = text.parse_int(text.trim(content)) or fail Malformed
    if value < 0 {
        fail Malformed
    }
    value
}

/// Parses the text of a cgroup memory file such as `memory.max`, `memory.high` or `memory.current`.
///
/// Returns the number of bytes, or `none` for the word `max`, which is no limit. Surrounding white space is ignored. Fails with `Malformed` for any other text, including a negative number.
pub fn parse_memory_limit(content: str) -> i64? ! io.Error {
    let trimmed = text.trim(content)
    if trimmed == "max" {
        return none
    }
    parse_number(trimmed)?
}

/// Parses the text of `cpu.max`, which is a quota and an optional period in microseconds.
///
/// Returns `none` when the quota is the word `max`, which is no limit. A missing period is `100000`. Fails with `Malformed` for a quota or period that is not a positive number, or for more than two fields.
pub fn parse_cpu_max(content: str) -> CpuLimit? ! io.Error {
    let fields = text.fields(content)
    if fields.len == 0 || fields.len > 2 {
        fail Malformed
    }
    var period = default_period
    if fields.len == 2 {
        period = parse_number(fields[1])?
    }
    if period <= 0 {
        fail Malformed
    }
    if fields[0] == "max" {
        return none
    }
    let quota = parse_number(fields[0])?
    if quota <= 0 {
        fail Malformed
    }
    CpuLimit { quota, period, cpus: f64(quota) / f64(period) }
}

fn parent_path(path: str) -> str {
    let at = text.last_index(path, "/")
    if at <= 0 {
        return "/"
    }
    path[..at]
}

fn directory(c: Cgroup, path: str) -> str {
    if path == "/" {
        return c.mount
    }
    "{c.mount}{path}"
}

fn ancestry(c: Cgroup) -> str[] {
    var dirs: str[] = []
    var path = c.path
    for path.len > 1 && path[path.len - 1] == '/' {
        path = path[..path.len - 1]
    }
    for {
        dirs.push(directory(c, path))
        if path == "/" {
            return dirs
        }
        path = parent_path(path)
    }
}

fn controller_text(dir: str, name: str) -> str? ! io.Error {
    read_text("{dir}/{name}") catch {
        NotFound => return none
        e => fail e
    }
}

fn nearest_memory(dirs: str[], name: str) -> i64? ! io.Error {
    for dir in dirs {
        let content = controller_text(dir, name)? ?? continue
        let limit = parse_memory_limit(content)?
        if limit != none {
            return limit
        }
    }
    none
}

fn nearest_cpu(dirs: str[]) -> CpuLimit? ! io.Error {
    for dir in dirs {
        let content = controller_text(dir, "cpu.max")? ?? continue
        let limit = parse_cpu_max(content)?
        if limit != none {
            return limit
        }
    }
    none
}

fn own_memory(dir: str) -> i64? ! io.Error {
    let content = controller_text(dir, "memory.current")? ?? return none
    parse_memory_limit(content)?
}

/// Reads the limits of the control group `c` from the cgroup2 file system.
///
/// `cpu.max`, `memory.max` and `memory.high` are each taken from the nearest group, starting with `c` and walking up to the top group of the mount, whose file holds a limit. A file that is missing, because the controller is not enabled there or the group is the top one, and a value of `max` both pass to the parent. `memory.current` is read from `c` itself. Fails with `Malformed` for a file that holds text that does not parse, and with the system error of reading a file other than a missing one.
pub fn cgroup_limits_of(c: Cgroup) -> CgroupLimits ! io.Error {
    let dirs = ancestry(c)
    let cpu = nearest_cpu(dirs)?
    let memory_max = nearest_memory(dirs, "memory.max")?
    let memory_high = nearest_memory(dirs, "memory.high")?
    let memory_current = own_memory(dirs[0])?
    CgroupLimits { cpu, memory_max, memory_high, memory_current }
}

/// Returns the CPU and memory limits that apply to this process.
///
/// On Linux finds the process's group in `/proc/self/cgroup` and the cgroup2 mount in `/proc/self/mountinfo`, and reads the limits as `cgroup_limits_of` does. A field of `none` means no group sets that limit, which is different from the process not being in a cgroup v2 hierarchy: that fails with `Unsupported`, as does a process with the cgroup v1 hierarchy only. On Windows reads the limits of the job object the process belongs to: `cpu` is a hard CPU rate cap as an effective CPU count, `memory_max` the smaller of the process and job memory limits, and `memory_high` and `memory_current` are `none`; a process in no job fails with `Unsupported`. Fails with the system error when `/proc` cannot be read.
pub fn cgroup_limits() -> CgroupLimits ! io.Error {
    current_cgroup_limits()?
}
