import std/text

/// A group entry from `/etc/group`.
pub struct Group {
    /// The group name.
    pub name: str
    /// The numeric group id.
    pub gid: i64
    /// The login names of the users the entry lists as members.
    pub members: str[]
}

fn parse_user(line: str) -> User? {
    if text.starts_with(line, "#") {
        return none
    }
    let parts = text.split(line, ':')
    if parts.len < 7 {
        return none
    }
    let uid = text.parse_int(parts[2]) or return none
    let gid = text.parse_int(parts[3]) or return none
    User { name: parts[0], uid, gid, home: parts[5], shell: parts[6] }
}

fn parse_group_line(line: str) -> Group? {
    if text.starts_with(line, "#") {
        return none
    }
    let parts = text.split(line, ':')
    if parts.len < 4 {
        return none
    }
    let gid = text.parse_int(parts[2]) or return none
    var members: str[] = []
    for member in text.split(parts[3], ',') {
        if member.len > 0 {
            members.push(member)
        }
    }
    Group { name: parts[0], gid, members }
}

/// Parses the text of an `/etc/passwd` file into its entries, in file order.
///
/// Skips blank lines, lines that start with `#`, lines with fewer than seven fields and lines whose user or group id is not a number. The returned names, homes and shells are slices of `content`.
pub fn parse_passwd(content: str) -> User[] {
    var users: User[] = []
    for line in text.lines(content) {
        let user = parse_user(line) ?? continue
        users.push(user)
    }
    users
}

/// Parses the text of an `/etc/group` file into its entries, in file order.
///
/// Skips blank lines, lines that start with `#`, lines with fewer than four fields and lines whose group id is not a number. Empty names in the member list are dropped. The returned names are slices of `content`.
pub fn parse_group(content: str) -> Group[] {
    var groups: Group[] = []
    for line in text.lines(content) {
        let group = parse_group_line(line) ?? continue
        groups.push(group)
    }
    groups
}

fn users() -> User[] {
    parse_passwd(account_text("/etc/passwd"))
}

fn groups() -> Group[] {
    parse_group(account_text("/etc/group"))
}

/// Returns the `/etc/passwd` entry whose user id is `id`, or `none`.
///
/// Returns `none` as well when the file cannot be read, and always on Windows, which has no numeric user ids. Lines with fewer than seven fields or a non-numeric id are skipped. Reads the file on every call and blocks the OS thread while doing so.
pub fn lookup_user(id: i64) -> User? {
    for user in users() {
        if user.uid == id {
            return user
        }
    }
    none
}

/// Returns the first `/etc/passwd` entry whose login name is `name`, or `none`.
///
/// Returns `none` as well when the file cannot be read, and always on Windows. The comparison is exact. Reads the file on every call and blocks the OS thread while doing so.
pub fn lookup_user_name(name: str) -> User? {
    for user in users() {
        if user.name == name {
            return user
        }
    }
    none
}

/// Returns the `/etc/group` entry whose group id is `id`, or `none`.
///
/// Returns `none` as well when the file cannot be read, and always on Windows, which has no numeric group ids. Reads the file on every call and blocks the OS thread while doing so.
pub fn lookup_group(id: i64) -> Group? {
    for group in groups() {
        if group.gid == id {
            return group
        }
    }
    none
}

/// Returns the first `/etc/group` entry whose name is `name`, or `none`.
///
/// Returns `none` as well when the file cannot be read, and always on Windows. The comparison is exact. Reads the file on every call and blocks the OS thread while doing so.
pub fn lookup_group_name(name: str) -> Group? {
    for group in groups() {
        if group.name == name {
            return group
        }
    }
    none
}

/// Returns the `/etc/group` entries that list the login name `user` as a member, in file order.
///
/// A user's primary group, which `/etc/passwd` names by id, is included only when its entry lists the user. Returns an empty slice when the file cannot be read, and always on Windows. Reads the file on every call and blocks the OS thread while doing so.
pub fn supplementary_groups(user: str) -> Group[] {
    var out: Group[] = []
    for group in groups() {
        for member in group.members {
            if member == user {
                out.push(group)
                break
            }
        }
    }
    out
}

/// A password entry from `/etc/shadow`.
pub struct Shadow {
    /// The login name.
    pub name: str
    /// The `crypt(3)` hash. A hash that starts with `!` or `*`, or is empty, admits no password.
    pub hash: str
    /// The day of the last password change, counted from the Unix epoch, or `none` when the field is empty.
    pub changed: i64? = none
    /// The days after a change before the password expires, or `none` for no limit.
    pub max_days: i64? = none
    /// The days after the password expires before the account is disabled, or `none` for no limit.
    pub inactive_days: i64? = none
    /// The day the account expires, counted from the Unix epoch, or `none` for never.
    pub expires: i64? = none
}

fn day_field(field: str) -> i64? {
    if field.len == 0 {
        return none
    }
    text.parse_int(field) or none
}

fn parse_shadow_line(line: str) -> Shadow? {
    if text.starts_with(line, "#") {
        return none
    }
    let parts = text.split(line, ':')
    if parts.len < 9 {
        return none
    }
    Shadow { name: parts[0], hash: parts[1], changed: day_field(parts[2]), max_days: day_field(parts[4]), inactive_days: day_field(parts[6]), expires: day_field(parts[7]) }
}

/// Parses the text of an `/etc/shadow` file into its entries, in file order.
///
/// Skips blank lines, lines that start with `#` and lines with fewer than nine fields. A day field that is empty or not a number is `none`. The returned names and hashes are slices of `content`.
pub fn parse_shadow(content: str) -> Shadow[] {
    var entries: Shadow[] = []
    for line in text.lines(content) {
        let entry = parse_shadow_line(line) ?? continue
        entries.push(entry)
    }
    entries
}

/// Returns the `/etc/shadow` entry of the login name `name`, or `none`.
///
/// Returns `none` as well when the file cannot be read, which needs root, and always on Windows. Reads the file on every call and blocks the OS thread while doing so.
pub fn lookup_shadow(name: str) -> Shadow? {
    for entry in parse_shadow(account_text("/etc/shadow")) {
        if entry.name == name {
            return entry
        }
    }
    none
}

/// Returns whether the entry `s` lets its user log in with a password on day `today`, counted from the Unix epoch: the hash is not locked or empty, the account has not expired, and the password has not been expired for longer than its inactive period.
///
/// A password that has expired within the inactive period is accepted here; the caller can still ask for a new one.
pub fn shadow_usable(s: Shadow, today: i64) -> bool {
    if s.hash.len == 0 || text.starts_with(s.hash, "!") || text.starts_with(s.hash, "*") {
        return false
    }
    match s.expires {
        some(day) => {
            if day > 0 && today >= day {
                return false
            }
        }
        none => {}
    }
    let changed = s.changed ?? return true
    if changed == 0 {
        return true
    }
    let max = s.max_days ?? return true
    if max < 0 || max >= 99999 {
        return true
    }
    let inactive = s.inactive_days ?? return true
    today < changed + max + inactive
}
