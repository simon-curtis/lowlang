import std/file
import std/io

/// The path of the file of current logins.
pub const utmp_path = "/var/run/utmp"

/// The path of the file of every login and logout.
pub const wtmp_path = "/var/log/wtmp"

/// The size of one record, as glibc lays it out on x86-64.
pub const record_size = 384

/// What a record describes.
pub enum Kind {
    /// An unused record.
    Empty = 0
    /// A change of run level.
    RunLevel = 1
    /// The time the system booted.
    BootTime = 2
    /// The clock after a change.
    NewTime = 3
    /// The clock before a change.
    OldTime = 4
    /// A process `init` started.
    Init = 5
    /// A login prompt waiting on a terminal.
    Login = 6
    /// A user's session.
    User = 7
    /// A session that has ended.
    Dead = 8
    /// Process accounting.
    Accounting = 9
}

/// One utmp or wtmp record.
pub struct Entry {
    /// What the record describes.
    pub kind: Kind
    /// The process id of the session's leader.
    pub pid: i64 = 0
    /// The terminal without `/dev/`, such as `pts/3`, at most 32 bytes.
    pub line: str = ""
    /// The terminal's short id, at most 4 bytes, which identifies the record in utmp. `id_of` derives it from the line.
    pub id: str = ""
    /// The user name, at most 32 bytes.
    pub user: str = ""
    /// The remote host, at most 256 bytes.
    pub host: str = ""
    /// The session id.
    pub session: i64 = 0
    /// The time of the record, in seconds since the Unix epoch.
    pub seconds: i64 = 0
    /// The microseconds within `seconds`.
    pub micros: i64 = 0
    /// The remote address: 4 bytes for IPv4, 16 for IPv6, or empty.
    pub address: u8[] = []
}

/// Returns the terminal line of the device path `tty`, without a leading `/dev/`.
pub fn line_of(tty: str) -> str {
    tty[5..] when tty.len > 5 && tty[..5] == "/dev/" else tty
}

/// Returns the record id OpenSSH and `login` give the terminal line `line`: its last four bytes.
pub fn id_of(line: str) -> str {
    line[line.len - 4..] when line.len > 4 else line
}

fn put_text(buf: u8[], at: i64, size: i64, s: str) {
    let b = bytes(s)
    var n = b.len
    if n > size {
        n = size
    }
    for i in 0..n {
        buf[at + i] = b[i]
    }
}

fn text_at(buf: u8[], at: i64, size: i64) -> str {
    var end = at
    for end < at + size && buf[end] != 0 {
        end += 1
    }
    str(buf[at..end])
}

/// Returns the bytes of `e` as one record.
pub fn encode(e: Entry) -> u8[] {
    let buf = io.buffer(record_size)
    io.set_le16(buf, 0, e.kind.index)
    io.set_le32(buf, 4, e.pid)
    put_text(buf, 8, 32, e.line)
    put_text(buf, 40, 4, e.id)
    put_text(buf, 44, 32, e.user)
    put_text(buf, 76, 256, e.host)
    io.set_le32(buf, 336, e.session)
    io.set_le32(buf, 340, e.seconds)
    io.set_le32(buf, 344, e.micros)
    if e.address.len == 4 || e.address.len == 16 {
        for i, b in e.address {
            buf[348 + i] = b
        }
    }
    buf
}

fn kind_of(n: i64) -> Kind? {
    for k in [Kind.Empty, Kind.RunLevel, Kind.BootTime, Kind.NewTime, Kind.OldTime, Kind.Init, Kind.Login, Kind.User, Kind.Dead, Kind.Accounting] {
        if k.index == n {
            return k
        }
    }
    none
}

fn address_at(buf: u8[]) -> u8[] {
    var rest_zero = true
    for i in 352..364 {
        if buf[i] != 0 {
            rest_zero = false
        }
    }
    let v4 = buf[348..352]
    if !rest_zero {
        return buf[348..364]
    }
    if v4[0] == 0 && v4[1] == 0 && v4[2] == 0 && v4[3] == 0 {
        return []
    }
    v4
}

/// Returns the entry the record `buf` holds, or `none` when it is not `record_size` bytes or its kind is unknown.
pub fn decode(buf: u8[]) -> Entry? {
    if buf.len != record_size {
        return none
    }
    let kind = kind_of(io.le16(buf, 0)) ?? return none
    Entry {
        kind
        pid: io.le32(buf, 4)
        line: text_at(buf, 8, 32)
        id: text_at(buf, 40, 4)
        user: text_at(buf, 44, 32)
        host: text_at(buf, 76, 256)
        session: io.le32(buf, 336)
        seconds: io.le32(buf, 340) & 0xFFFFFFFF
        micros: io.le32(buf, 344)
        address: address_at(buf)
    }
}

/// Returns the entries of the utmp or wtmp file at `path`, in file order, skipping records whose kind is unknown and a short record at the end.
///
/// Fails with the error of reading the file.
pub fn read_entries(path: str) -> Entry[] ! io.Error {
    let data = file.read_file(path)?
    var out: Entry[] = []
    var at = 0
    for at + record_size <= data.len {
        match decode(data[at..at + record_size]) {
            some(e) => out.push(e)
            none => {}
        }
        at += record_size
    }
    out
}

fn holds_session(k: Kind) -> bool {
    k == Kind.Init || k == Kind.Login || k == Kind.User || k == Kind.Dead
}

fn slot_for(data: u8[], id: str) -> i64 {
    var at = 0
    for at + record_size <= data.len {
        match decode(data[at..at + record_size]) {
            some(old) => {
                if old.id == id && holds_session(old.kind) {
                    return at
                }
            }
            none => {}
        }
        at += record_size
    }
    at
}

/// Writes `e` to the utmp file at `path` in place of the session record with the same id, or at the end when there is none, as `pututline` does.
///
/// Writes the whole record at once. Fails with the error of opening, reading or writing the file. It does not take the `fcntl` lock glibc takes.
pub fn put(path: str, e: Entry) ! io.Error {
    let data = file.read_file(path) catch {
        io.Error.NotFound => []
        err => fail err
    }
    using f = file.update(path)?
    file.seek(f, slot_for(data, e.id), file.Whence.Start)?
    file.write_all(f, encode(e))?
}

/// Appends `e` to the wtmp file at `path`.
///
/// Fails with the error of opening or writing the file.
pub fn append(path: str, e: Entry) ! io.Error {
    using f = file.append(path)?
    file.write_all(f, encode(e))?
}
