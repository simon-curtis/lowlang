import std/file
import std/process
import std/testing
import std/text

fn session(id: str, kind: Kind, user: str) -> Entry {
    Entry { kind, pid: 4242, line: "pts/{id}", id: id_of("pts/{id}"), user, host: "192.0.2.7", seconds: 1764000000, micros: 5, address: [192, 0, 2, 7] }
}

fn test_long_fields_are_cut_to_their_size(t: *testing.T) {
    let e = Entry { kind: Kind.User, user: text.repeat("u", 40), host: text.repeat("h", 300) }
    let back = decode(encode(e)) ?? panic("decode")
    testing.error_if(t, back.user.len != 32 || back.host.len != 256, "lengths {back.user.len} {back.host.len}")
}

fn test_line_and_id(t: *testing.T) {
    testing.error_if(t, line_of("/dev/pts/12") != "pts/12", "line")
    testing.error_if(t, id_of("pts/12") != "s/12", "id")
    testing.error_if(t, id_of("tty") != "tty", "short id")
}

fn test_put_replaces_the_record_with_the_same_id(t: *testing.T) {
    let dir = file.temp_dir("utmp-test") or panic("temp dir")
    defer file.remove_all(dir) or {}
    let path = "{dir}/utmp"
    put(path, session("1", Kind.User, "alice")) or panic("put")
    put(path, session("2", Kind.User, "bob")) or panic("put")
    put(path, session("1", Kind.Dead, "")) or panic("put")
    let entries = read_entries(path) or panic("read")
    testing.fatal_if(t, entries.len != 2, "entries {entries.len}")
    testing.error_if(t, entries[0].kind != Kind.Dead || entries[1].user != "bob", "entries {entries}")
    append(path, session("3", Kind.User, "carol")) or panic("append")
    testing.error_if(t, (read_entries(path) or []).len != 3, "append")
}

fn test_who_and_last_read_the_records(t: *testing.T) {
    let who = process.find("who") ?? ""
    let last = process.find("last") ?? ""
    if who.len == 0 || last.len == 0 {
        testing.skip(t, "who or last is not installed")
    }
    let dir = file.temp_dir("utmp-tools") or panic("temp dir")
    defer file.remove_all(dir) or {}
    put("{dir}/utmp", session("9", Kind.User, "zed")) or panic("put")
    append("{dir}/wtmp", session("9", Kind.User, "zed")) or panic("append")
    let listed = process.run(process.Command { program: who, args: ["{dir}/utmp"], stdout: process.Stdio.Piped }, []) or panic("who")
    testing.error_if(t, !text.contains(str(listed.stdout), "zed") || !text.contains(str(listed.stdout), "pts/9"), "who printed {str(listed.stdout)}")
    let logins = process.run(process.Command { program: last, args: ["-f", "{dir}/wtmp"], stdout: process.Stdio.Piped }, []) or panic("last")
    testing.error_if(t, !text.contains(str(logins.stdout), "zed") || !text.contains(str(logins.stdout), "192.0.2.7"), "last printed {str(logins.stdout)}")
}
