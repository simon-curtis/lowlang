import std/file
import std/os/utmp

fn main() {
    let dir = file.temp_dir("utmp") or panic("temp dir")
    defer file.remove_all(dir) or {}
    let path = "{dir}/utmp"
    let line = utmp.line_of("/dev/pts/4")
    let login = utmp.Entry { kind: utmp.Kind.User, pid: 100, line, id: utmp.id_of(line), user: "alice", host: "203.0.113.5", seconds: 1764000000 }
    utmp.put(path, login) or panic("put")
    for e in utmp.read_entries(path) or [] {
        print("{e.kind} {e.user} on {e.line} from {e.host}")
    }
    let logout = utmp.Entry { kind: utmp.Kind.Dead, pid: 100, line, id: utmp.id_of(line), seconds: 1764003600 }
    utmp.put(path, logout) or panic("put")
    for e in utmp.read_entries(path) or [] {
        print("{e.kind} on {e.line}")
    }
}
