import std/testing

const sample = "root:!*:20000::::::\nalice:$6$salt$hash:20000:0:99999:7:::\n# comment\nbob:$y$j9T$x$y:19000:0:30:7:10::\ncarol::20000::::::\ndave:$6$s$h:20000:0:99999:7::19500:\nshort:x:1\n"

fn test_parse_shadow(t: *testing.T) {
    let entries = parse_shadow(sample)
    testing.fatal_if(t, entries.len != 5, "entries {entries.len}")
    testing.error_if(t, entries[1].name != "alice" || entries[1].hash != "$6$salt$hash" || entries[1].changed != some(20000), "alice {entries[1]}")
    testing.error_if(t, entries[2].max_days != some(30) || entries[2].inactive_days != some(10), "bob {entries[2]}")
    testing.error_if(t, entries[0].max_days != none, "root max")
}

fn test_shadow_usable(t: *testing.T) {
    let entries = parse_shadow(sample)
    let today = 20010
    testing.error_if(t, shadow_usable(entries[0], today), "a locked hash is usable")
    testing.error_if(t, !shadow_usable(entries[1], today), "alice is not usable")
    testing.error_if(t, shadow_usable(entries[2], today), "bob's password expired past its inactive period")
    testing.error_if(t, !shadow_usable(entries[2], 19035), "bob within the inactive period")
    testing.error_if(t, shadow_usable(entries[3], today), "an empty hash is usable")
    testing.error_if(t, shadow_usable(entries[4], today), "an expired account is usable")
}
