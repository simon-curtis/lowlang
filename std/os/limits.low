import std/io
import std/sys

/// A resource whose limit `getrlimit` and `setrlimit` read and change, named for the Linux `RLIMIT_` constants.
pub enum Resource {
    /// The CPU time in seconds.
    Cpu = 0
    /// The size in bytes of a file the process may create.
    FileSize = 1
    /// The size in bytes of the data segment.
    Data = 2
    /// The size in bytes of the main thread's stack.
    Stack = 3
    /// The size in bytes of a core dump.
    Core = 4
    /// The resident set size in bytes.
    ResidentSet = 5
    /// The number of processes of the real user.
    Processes = 6
    /// The number of open files.
    OpenFiles = 7
    /// The bytes of memory that can be locked.
    LockedMemory = 8
    /// The size in bytes of the address space.
    AddressSpace = 9
    /// The number of file locks and leases.
    FileLocks = 10
    /// The number of signals that can be pending for the real user.
    PendingSignals = 11
    /// The bytes in POSIX message queues of the real user.
    MessageQueue = 12
    /// The ceiling of the nice value, as `20 - nice`.
    Nice = 13
    /// The ceiling of the real-time priority.
    RealtimePriority = 14
    /// The microseconds a real-time task may run without blocking.
    RealtimeTime = 15
}

/// The soft and hard value of a resource limit.
pub struct Rlimit {
    /// The value the kernel enforces, or `none` for no limit.
    pub soft: i64?
    /// The ceiling the soft value can be raised to, or `none` for no limit.
    pub hard: i64?
}

fn finite(n: i64) -> i64? {
    if n < 0 {
        return none
    }
    n
}

fn raw(limit: i64?) -> i64 {
    limit ?? -1
}

/// Returns the soft and hard limit of `resource` for this process.
///
/// A value of `none` is no limit. Fails with `Unsupported` on Windows, which has no resource limits.
pub fn getrlimit(resource: Resource) -> Rlimit ! io.Error {
    let current = sys.get_rlimit(resource.index)?
    Rlimit { soft: finite(current.soft), hard: finite(current.hard) }
}

/// Sets the soft and hard limit of `resource` for this process.
///
/// A value of `none` is no limit. Lowering the soft value or the hard value is always allowed, and raising the hard value needs the privilege to do so. Fails with `Invalid` when the soft value exceeds the hard value, `Denied` when the hard value is raised without that privilege, and `Unsupported` on Windows.
pub fn setrlimit(resource: Resource, limit: Rlimit) ! io.Error {
    let request = sys.Rlimit { soft: raw(limit.soft), hard: raw(limit.hard) }
    sys.set_rlimit(resource.index, request)?
}
