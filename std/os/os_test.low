import std/file
import std/sys
import std/testing

fn test_env_environment_and_chdir_are_logged(t: *testing.T) {
    let dir = file.temp_dir("os-record") or panic("temp dir")
    let start = getcwd() or panic("getcwd")
    let log = "{dir}/inputs.log"
    let out = sys.open(log, sys.Open.Truncate, 0o644) or panic("open log")
    sys.record_inputs(out.fd)
    env("LOW_RECORD_PROBE")
    env("name with space\nand newline")
    environment()
    chdir(dir) or panic("chdir")
    chdir(start) or panic("chdir back")
    sys.record_inputs(-1)
    sys.close_on(out)
    let got = file.read_text(log) or panic("read log")
    testing.contains(t, got, "getenv 16 LOW_RECORD_PROBE\n")
    testing.contains(t, got, "getenv 27 name with space\nand newline\n")
    testing.contains(t, got, "environ 0 \n")
    testing.contains(t, got, "chdir {dir.len} {dir}\n")
    testing.contains(t, got, "chdir {start.len} {start}\n")
    file.remove_all(dir) or panic("remove")
}
