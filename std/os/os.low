import std/fs

extern "c" {
    fn getenv(name: ptr[u8]) -> ptr[u8]
    fn setenv(name: ptr[u8], value: ptr[u8], overwrite: i32) -> i32
    fn unsetenv(name: ptr[u8]) -> i32
    fn getpid() -> i32
    fn c_exit(code: i32) = "exit"
}

pub fn env(name: str) -> str? {
    let value = getenv(cstr(name))
    if value == null {
        return none
    }
    str(value)
}

pub fn set_env(name: str, value: str) {
    setenv(cstr(name), cstr(value), 1)
}

pub fn unset_env(name: str) {
    unsetenv(cstr(name))
}

pub fn pid() -> i64 {
    i64(getpid())
}

pub fn exit(code: i64) {
    c_exit(i32(code))
}

pub fn args() -> []str {
    let raw = fs.read_file("/proc/self/cmdline") catch {
        _ => ""
    }
    var out: []str = []
    var start = 0
    for i in 0..raw.len {
        if raw[i] == 0 {
            push(mut out, raw[start..i])
            start = i + 1
        }
    }
    out
}
