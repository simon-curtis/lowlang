import std/file
import std/io
import std/os

const membership = "0::/system.slice/app.service\n"
const mountinfo = "35 25 0:30 / /sys/fs/cgroup rw,nosuid,nodev,noexec,relatime shared:9 - cgroup2 cgroup2 rw,nsdelegate\n"

fn describe(limit: i64?) -> str {
    match limit {
        some(n) => "{n} bytes"
        none => "no limit"
    }
}

/// Finds a cgroup from the text of `/proc/self/cgroup` and `/proc/self/mountinfo`, then reads the limits of a group tree where the parent sets the memory limit and the child sets the CPU limit.
fn main() ! io.Error {
    let found = os.locate_cgroup(membership, os.parse_mountinfo(mountinfo)) ?? return
    print("group {found.path} under {found.mount}")

    let root = file.temp_dir("cgroup-")?
    file.mkdir_all("{root}/system.slice/app.service")?
    file.write_text("{root}/system.slice/memory.max", "268435456\n")?
    file.write_text("{root}/system.slice/app.service/memory.max", "max\n")?
    file.write_text("{root}/system.slice/app.service/cpu.max", "150000 100000\n")?
    file.write_text("{root}/system.slice/app.service/memory.current", "4096\n")?

    let limits = os.cgroup_limits_of(os.Cgroup { mount: root, path: found.path })?
    let cpu = limits.cpu ?? return
    print("cpus: {cpu.cpus} ({cpu.quota} every {cpu.period} microseconds)")
    print("memory.max: {describe(limits.memory_max)}")
    print("memory.high: {describe(limits.memory_high)}")
    print("memory.current: {describe(limits.memory_current)}")
    file.remove_all(root)?
}
