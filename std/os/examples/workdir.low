import std/file
import std/io
import std/os
import std/text

/// Runs work in a temporary working directory, resolves relative paths against it and restores the previous directory before cleaning up.
fn main() ! io.Error {
    print("arguments: {os.args().len}")
    print("process ids are positive: {os.pid() > 0 && os.ppid() >= 0}")
    print("cpus: {os.cpu_count() >= 1}")

    let home = os.getcwd()?
    let dir = file.temp_dir("workdir-")?
    os.chdir(dir)?
    print("moved: {os.getcwd()? != home}")

    file.write_text("note.txt", "relative path\n")?
    let note = file.read_text("note.txt")?
    print("note: {text.trim(note)}")
    print("note exists here: {file.exists("note.txt")}")

    os.chdir(home)?
    print("note exists after returning: {file.exists("note.txt")}")
    print("returned home: {os.getcwd()? == home}")

    os.chdir("missing-directory") or print("chdir to a missing directory failed")
    file.remove_all(dir)?
}
