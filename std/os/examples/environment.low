import std/io
import std/maps
import std/os
import std/text

fn port() -> i64 {
    let raw = os.env("DEMO_PORT") ?? return 8080
    text.parse_int(raw) or 8080
}

/// Reads settings from environment variables with defaults, overrides them with `set_env`, and lists every variable that carries the `DEMO_` prefix.
fn main() ! io.Error {
    print("port without a variable: {port()}")
    print("log level: {os.env("DEMO_LOG") ?? "info"}")

    os.set_env("DEMO_PORT", "9000")?
    os.set_env("DEMO_LOG", "")?
    os.set_env("DEMO_REGION", "eu-west")?
    print("port after set_env: {port()}")
    print("log level set empty: {os.env("DEMO_LOG") ?? "info"}")

    os.set_env("DEMO_PORT", "not a number")?
    print("port with a bad value: {port()}")

    os.unset_env("DEMO_LOG")?
    print("log level after unset_env: {os.env("DEMO_LOG") ?? "info"}")

    let vars = os.environment()
    for name in maps.sorted_keys(vars) {
        if text.starts_with(name, "DEMO_") {
            print("{name}={vars[name] ?? ""}")
        }
    }

    os.set_env("BAD=NAME", "x") or print("rejected a name with =")
}
