import std/file
import std/os

/// Reads a missing file and reports the failure the way the system describes it: the named `io.Error` variant, the operating system error number and the system's message text.
fn main() {
    file.read_text("missing-directory/file.txt") catch {
        e => {
            let code = os.error_code(e) ?? 0
            print("{e}: {os.error_message(code)} (os error {code})")
            ""
        }
    }
}
