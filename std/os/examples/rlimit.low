import std/io
import std/os

fn describe(limit: i64?) -> str {
    match limit {
        some(n) => "{n}"
        none => "unlimited"
    }
}

/// Lowers the soft limit on core dump size to zero, keeps the hard limit, and reads the limits back.
fn main() ! io.Error {
    let before = os.getrlimit(os.Resource.Core)?
    os.setrlimit(os.Resource.Core, os.Rlimit { soft: some(0), hard: before.hard })?
    let after = os.getrlimit(os.Resource.Core)?
    print("soft: {describe(after.soft)}")
    print("hard unchanged: {after.hard == before.hard}")
}
