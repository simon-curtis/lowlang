import std/os

const passwd = "root:x:0:0:root:/root:/bin/bash\ndaemon:x:1:1:daemon:/usr/sbin:/usr/sbin/nologin\n# disabled:x:5:5:::\nalice:x:1000:1000:Alice:/home/alice:/bin/zsh\n"
const groups = "root:x:0:\nstaff:x:50:alice,bob\nusers:x:100:alice\n"

fn find(users: []os.User, name: str) -> os.User? {
    for u in users {
        if u.name == name {
            return u
        }
    }
    none
}

/// Parses passwd and group text, which is what `lookup_user` and `lookup_group` read from `/etc`, and finds the groups a user belongs to.
fn main() {
    let users = os.parse_passwd(passwd)
    print("users: {users.len}")
    let alice = find(users, "alice") ?? return
    print("alice: uid {alice.uid}, gid {alice.gid}, home {alice.home}, shell {alice.shell}")

    for g in os.parse_group(groups) {
        var listed = false
        for member in g.members {
            if member == alice.name {
                listed = true
            }
        }
        print("group {g.name} ({g.gid}): {g.members.len} members, alice listed: {listed}")
    }
}
