import std/testing

fn test_error_message_is_the_system_text(t: *testing.T) {
    testing.equal(t, error_message(2), "No such file or directory")
    testing.equal(t, error_message(13), "Permission denied")
    testing.equal(t, error_message(111), "Connection refused")
}

fn test_error_message_names_an_unknown_number(t: *testing.T) {
    testing.equal(t, error_message(9999), "Unknown error 9999")
}
