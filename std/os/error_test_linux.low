import std/file
import std/io
import std/testing

fn test_error_message_is_the_system_text(t: *testing.T) {
    testing.equal(t, error_message(2), "No such file or directory")
    testing.equal(t, error_message(13), "Permission denied")
    testing.equal(t, error_message(111), "Connection refused")
}

fn test_error_message_names_an_unknown_number(t: *testing.T) {
    testing.equal(t, error_message(9999), "Unknown error 9999")
}

fn read_code(path: str) -> i64? {
    var code: i64? = none
    file.read_text(path) catch {
        e => {
            code = error_code(e)
            ""
        }
    }
    code
}

fn test_error_code_of_a_missing_path_is_enoent(t: *testing.T) {
    testing.equal(t, read_code("/nonexistent-error-code/file.txt") ?? 0, 2)
}

fn test_error_code_tells_apart_failures_that_share_a_variant(t: *testing.T) {
    testing.equal(t, error_code(io.errno(1)) ?? 0, 1)
    testing.equal(t, error_code(io.errno(13)) ?? 0, 13)
    testing.equal(t, read_code("/dev/null/below") ?? 0, 20)
}

fn test_error_code_of_an_unnamed_number_is_the_number(t: *testing.T) {
    testing.equal(t, error_code(io.errno(9999)) ?? 0, 9999)
}

fn test_error_code_is_none_for_an_error_the_system_did_not_return(t: *testing.T) {
    io.errno(2)
    t.is_true(error_code(io.Error.Eof) == none)
    t.is_true(error_code(io.Error.Denied) == none)
}

fn fail_on_another_thread(done: chan[bool]) {
    io.errno(13)
    done <- true
}

fn test_error_code_is_kept_per_green_thread(t: *testing.T) {
    let e = io.errno(2)
    let done = chan[bool](1)
    spawn fail_on_another_thread(done)
    <-done
    testing.equal(t, error_code(e) ?? 0, 2)
}
