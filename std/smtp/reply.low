import std/io
import std/mail
import std/slices
import std/text

/// A server reply: a three digit code and its text.
pub struct Reply {
    /// The reply code, from `100` to `599`.
    pub code: i64
    /// The text of each reply line, after the code and the separator. A single line reply has one entry.
    pub lines: []str
}

/// Bounds applied while reading replies.
pub struct Limits {
    /// The most lines accepted in one reply. A longer reply fails with `TooLarge`. Defaults to `1024`.
    pub lines: i64 = 1024
}

/// The capabilities a server announced in reply to `EHLO`.
pub struct Extensions {
    /// The text of the first line of the reply, which carries the server's greeting.
    pub greeting: str = ""
    /// The keyword of every announced extension in uppercase, in order, including those with their own fields.
    pub names: []str = []
    /// The authentication mechanisms in uppercase, collected from `AUTH` lines and `AUTH=` lines without duplicates.
    pub mechanisms: []str = []
    /// The largest message size in bytes the server accepts, or `0` when it announces no limit or none that parses.
    pub size: i64 = 0
    /// The server supports `STARTTLS`.
    pub starttls: bool = false
    /// The server supports `8BITMIME`.
    pub eight_bit_mime: bool = false
    /// The server supports `SMTPUTF8`.
    pub smtputf8: bool = false
    /// The server supports `PIPELINING`.
    pub pipelining: bool = false
    /// The server supports `ENHANCEDSTATUSCODES`.
    pub enhanced_codes: bool = false
}

/// The error type of the SMTP client.
pub enum Error {
    /// The connection could not be made, or the TLS handshake failed.
    Connect
    /// The connection is closed, or reading or writing failed.
    Closed
    /// The server did not respond within the configured timeout.
    Timeout
    /// The server sent a reply that is malformed or not valid at that point of the dialogue.
    Protocol
    /// A reply exceeded `Limits.lines` or the reader's line length limit.
    TooLarge
    /// The chosen mechanism would send the password over an unencrypted connection and `Options.insecure_auth` is not set.
    Insecure
    /// The message is larger than the size the server announced.
    MessageTooLarge
    /// The server does not offer `feature`, such as `STARTTLS`, `AUTH`, a named mechanism, `SMTPUTF8` or `8BITMIME`.
    Unsupported(feature: str)
    /// The server replied with a `4xx` code. The same request can succeed later.
    Transient(code: i64, message: str)
    /// The server replied with a `5xx` code. Repeating the request will fail again.
    Permanent(code: i64, message: str)
    /// The server rejected the credentials. `message` is the server's text.
    Auth(message: str)
    /// The message or envelope failed validation before anything was sent.
    Invalid(error: mail.Error)
}

/// Maps an I/O error onto the SMTP error type: `TimedOut` becomes `Timeout`, `TooLarge` stays `TooLarge`, `Malformed` becomes `Protocol` and everything else becomes `Closed`.
pub fn transport(e: io.Error) -> Error {
    match e {
        TimedOut => Timeout
        TooLarge => TooLarge
        Malformed => Protocol
        _ => Closed
    }
}

/// Returns the lines of `r` joined with `\n`.
pub fn text_of(r: Reply) -> str {
    text.join(r.lines, "\n")
}

/// Returns the first digit of the reply code: `2` success, `3` more input needed, `4` transient failure, `5` permanent failure.
pub fn family(r: Reply) -> i64 {
    r.code / 100
}

/// Returns whether the reply is a success, a `2xx` code.
pub fn positive(r: Reply) -> bool {
    family(r) == 2
}

/// Parses the first reply in `data`, with the default `Limits`.
///
/// See `parse_reply_with`.
pub fn parse_reply(data: []u8) -> Reply ! Error {
    parse_reply_with(data, Limits {})
}

/// Parses the first reply in `data`, which may span several lines such as `250-first` and `250 last`. Data after the reply is ignored.
///
/// Fails with `Protocol` when a code is not three digits from `100` to `599`, the codes of the lines differ, a separator is not a space or `-`, or the data ends before the last line, and with `TooLarge` when the reply has more than `limits.lines` lines.
pub fn parse_reply_with(data: []u8, limits: Limits) -> Reply ! Error {
    let r = io.bytes_reader(data)
    read_reply(r, limits) catch {
        Closed => fail Protocol
        e => fail e
    }
}

fn digit(c: u8) -> bool {
    c >= '0' && c <= '9'
}

fn code_of(line: str) -> i64 ! Error {
    if line.len < 3 {
        fail Protocol
    }
    if !digit(line[0]) || !digit(line[1]) || !digit(line[2]) {
        fail Protocol
    }
    let code = i64(line[0] - '0') * 100 + i64(line[1] - '0') * 10 + i64(line[2] - '0')
    if code < 100 || code > 599 {
        fail Protocol
    }
    code
}

fn more_follows(line: str) -> bool ! Error {
    if line.len == 3 {
        return false
    }
    if line[3] == ' ' {
        return false
    }
    if line[3] == '-' {
        return true
    }
    fail Protocol
}

fn body_of(line: str) -> str {
    if line.len > 4 {
        return line[4..]
    }
    ""
}

fn next_line(r: *io.Reader) -> str ! Error {
    io.read_line(r) catch transport
}

/// Reads one reply from `r`, which may span several lines.
///
/// Blocks until the last line arrives. Fails with `Protocol` for a malformed or inconsistent reply, `TooLarge` when it has more than `limits.lines` lines or a line over the reader's limit, `Timeout` when the stream times out, and `Closed` when the stream ends or fails first.
pub fn read_reply(r: *io.Reader, limits: Limits) -> Reply ! Error {
    var code = 0
    var lines: []str = []
    for {
        let line = next_line(r)?
        let this = code_of(line)?
        if lines.len == 0 {
            code = this
        } else if this != code {
            fail Protocol
        }
        if lines.len >= limits.lines {
            fail TooLarge
        }
        push(mut lines, body_of(line))
        let more = more_follows(line)?
        if !more {
            return Reply { code, lines }
        }
    }
}

fn keyword_of(line: str) -> str {
    let cut = text.cut(line, " ")
    text.upper(cut.before)
}

fn params_of(line: str) -> str {
    let cut = text.cut(line, " ")
    text.trim(cut.after)
}

fn size_of(param: str) -> i64 {
    let n = text.parse_int(param) or return 0
    if n < 0 { 0 } else { n }
}

fn add_mechanisms(mut e: Extensions, list: str) {
    for word in text.fields(list) {
        let name = text.upper(word)
        if !supports(e.mechanisms, name) {
            push(mut e.mechanisms, name)
        }
    }
}

fn apply_extension(mut e: Extensions, line: str) {
    let keyword = keyword_of(line)
    if keyword.len == 0 {
        return
    }
    push(mut e.names, keyword)
    if text.starts_with(keyword, "AUTH=") {
        add_mechanisms(mut e, keyword[5..])
        return
    }
    if keyword == "AUTH" {
        add_mechanisms(mut e, params_of(line))
    } else if keyword == "SIZE" {
        e.size = size_of(params_of(line))
    } else if keyword == "STARTTLS" {
        e.starttls = true
    } else if keyword == "8BITMIME" {
        e.eight_bit_mime = true
    } else if keyword == "SMTPUTF8" {
        e.smtputf8 = true
    } else if keyword == "PIPELINING" {
        e.pipelining = true
    } else if keyword == "ENHANCEDSTATUSCODES" {
        e.enhanced_codes = true
    }
}

/// Builds an `Extensions` from the reply to `EHLO`.
///
/// The first line becomes `greeting` and each further line is read as an extension keyword with parameters. Keywords are matched ignoring case, and unknown ones are only added to `names`.
pub fn parse_extensions(r: Reply) -> Extensions {
    var e = Extensions {}
    for i, line in r.lines {
        if i == 0 {
            e.greeting = line
            continue
        }
        apply_extension(mut e, line)
    }
    e
}

/// Returns whether the authentication mechanism `mechanism` is in `advertised`, ignoring case in `mechanism`.
///
/// `advertised` must hold uppercase names, as `Extensions.mechanisms` does.
pub fn supports(advertised: []str, mechanism: str) -> bool {
    slices.contains(advertised, text.upper(mechanism))
}
