import std/atomic
import std/math
import std/sync

struct Run {
    next: atomic.Int
    count: i64
    grain: i64
    job: fn(i64, i64)
    helpers: sync.WaitGroup
}

struct Failure[E] {
    guard: sync.Mutex
    lowest: atomic.Int
    error: E?
}

/// Returns the most green threads `each`, `chunks`, `try_each` and `map` run a job on at once: the number of CPUs the process may run on, and 1 for a target that runs one thread.
pub fn cpus() -> i64 {
    available()
}

/// Calls `job(i)` once for every `i` from 0 up to `count`, on at most `cpus()` green threads, and returns when every call has returned.
///
/// The calling green thread runs jobs too, so a job may call `each`. The order of the calls is not defined, and a `count` below 1 calls nothing. The indices are handed out in ranges of `count / (32 * cpus())`, at least 1; `chunks` takes the range size from the caller.
pub fn each(count: i64, job: fn(i64)) {
    chunks(count, even_grain(count), fn(start: i64, end: i64) {
        for i in start..end {
            job(i)
        }
    })
}

/// Splits the indices from 0 up to `count` into ranges of `grain` indices, the last one shorter when `grain` does not divide `count`, and calls `job(start, end)` once for each range on at most `cpus()` green threads. `end` is one past the last index of the range.
///
/// Returns when every call has returned. The calling green thread runs jobs too. The order of the calls is not defined. A `grain` below 1 counts as 1, and a `count` below 1 calls nothing.
pub fn chunks(count: i64, grain: i64, job: fn(i64, i64)) {
    if count <= 0 {
        return
    }
    let size = math.min(math.max(grain, 1), count)
    let run = Run { next: atomic.int(0), count, grain: size, job, helpers: sync.wait_group() }
    let threads = math.min(cpus(), (count + size - 1) / size)
    if threads > 1 {
        sync.add(run.helpers, threads - 1)
        for _ in 1..threads {
            spawn help(run)
        }
    }
    drain(run)
    sync.wait(run.helpers)
}

/// Calls `job(i)` for the indices from 0 up to `count` as `each` does, and returns the error of the lowest index whose call returned one, or `none` when no call did.
///
/// Every index below the one whose error is returned is called. An index above it may not be.
pub fn try_each[E](count: i64, job: fn(i64) -> E?) -> E? {
    let failure = new(Failure[E] { guard: sync.mutex(), lowest: atomic.int(count), error: none })
    chunks(count, even_grain(count), fn(start: i64, end: i64) {
        for i in start..end {
            if i > atomic.load_int(failure.lowest) {
                break
            }
            match job(i) {
                some(e) => {
                    record(failure, i, e)
                    break
                }
                none => {}
            }
        }
    })
    failure.error
}

/// Returns a slice holding `f(x)` for every `x` of `xs`, in the order of `xs`, calling `f` on at most `cpus()` green threads.
pub fn map[T, U](xs: T[], f: fn(T) -> U) -> U[] {
    var out: U[] = __make(xs.len)
    each(xs.len, fn(i: i64) {
        out[i] = f(xs[i])
    })
    out
}

fn even_grain(count: i64) -> i64 {
    count / (32 * cpus())
}

fn help(run: Run) {
    drain(run)
    sync.done(run.helpers)
}

fn drain(run: Run) {
    let job = run.job
    for {
        let start = atomic.add_int(run.next, run.grain) - run.grain
        if start >= run.count {
            return
        }
        job(start, math.min(start + run.grain, run.count))
    }
}

fn record[E](failure: *Failure[E], index: i64, error: E) {
    sync.lock(failure.guard)
    if index < atomic.load_int(failure.lowest) {
        atomic.store_int(failure.lowest, index)
        failure.error = some(error)
    }
    sync.unlock(failure.guard)
}
