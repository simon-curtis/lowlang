import std/parallel

fn is_prime(n: i64) -> bool {
    if n < 2 {
        return false
    }
    var d = 2
    for d * d <= n {
        if n % d == 0 {
            return false
        }
        d += 1
    }
    true
}

enum Invalid {
    Negative(at: i64, value: i64)
}

/// Counts primes in ranges on every CPU, maps a slice in order, and stops at the lowest bad input.
fn main() {
    let limit = 200000
    let width = 25000
    let counts = parallel.map([0, 1, 2, 3, 4, 5, 6, 7], fn(band: i64) -> i64 {
        var found = 0
        for n in band * width..(band + 1) * width {
            if is_prime(n) {
                found += 1
            }
        }
        found
    })
    var total = 0
    for band in 0..counts.len {
        print("{band * width} to {(band + 1) * width}: {counts[band]} primes")
        total += counts[band]
    }
    print("below {limit}: {total} primes")

    var sieve: bool[] = []
    for _ in 0..limit {
        sieve.push(false)
    }
    parallel.chunks(limit, 4096, fn(start: i64, end: i64) {
        for n in start..end {
            sieve[n] = is_prime(n)
        }
    })
    print("199999 is prime: {sieve[199999]}")

    let readings = [12, 7, -4, 9, -1, 3]
    let bad = parallel.try_each[Invalid](readings.len, fn(i: i64) -> Invalid? {
        if readings[i] < 0 {
            return some(Invalid.Negative(i, readings[i]))
        }
        none
    })
    match bad {
        some(e) => print("first bad reading: {e}")
        none => print("readings are valid")
    }
}
