import std/locale
import std/locale/data
import std/text

/// The conjunction a list is joined with.
pub enum Kind {
    /// "A, B, and C".
    And
    /// "A, B, or C".
    Or
    /// A list of measurements, "3 ft, 4 in".
    Unit
}

/// How much of the joining words a list keeps.
pub enum Width {
    /// The full words.
    Wide
    /// The abbreviated words.
    Short
    /// The least text.
    Narrow
}

fn fallback_types(kind: Kind, width: Width) -> i64[] {
    var order: i64[] = []
    match kind {
        And => {
            if width == Width.Narrow {
                order.push(2)
            }
            if width != Width.Wide {
                order.push(1)
            }
            order.push(0)
        }
        Or => {
            if width == Width.Narrow {
                order.push(5)
            }
            if width != Width.Wide {
                order.push(4)
            }
            order.push(3)
        }
        Unit => {
            if width == Width.Narrow {
                order.push(8)
            }
            if width == Width.Wide {
                order.push(6)
            }
            order.push(7)
            order.push(0)
        }
    }
    order
}

fn part(l: locale.Locale, kind: Kind, width: Width, part: i64) -> str {
    for t in fallback_types(kind, width) {
        match locale.entry(l, data.group_lists, t * 4 + part) {
            some(v) => return v
            none => {}
        }
    }
    "{{0}}, {{1}}"
}

fn join(pattern: str, first: str, second: str) -> str {
    let at_first = text.index(pattern, "{{0}}")
    let at_second = text.index(pattern, "{{1}}")
    if at_first < 0 || at_second < 0 {
        return "{first}{second}"
    }
    if at_first < at_second {
        return "{pattern[..at_first]}{first}{pattern[at_first + 3..at_second]}{second}{pattern[at_second + 3..]}"
    }
    "{pattern[..at_second]}{second}{pattern[at_second + 3..at_first]}{first}{pattern[at_first + 3..]}"
}

fn is_vowel(c: u8) -> bool {
    c == 'a' || c == 'e' || c == 'o' || c == 'u'
}

fn spanish_e(second: str) -> bool {
    let s = text.lower(second)
    if s.len >= 2 && s[0] == 'h' && s[1] == 'i' {
        return s.len < 3 || !is_vowel(s[2])
    }
    s.len >= 1 && s[0] == 'i'
}

fn spanish_u(second: str) -> bool {
    let s = text.lower(second)
    if s.len >= 1 && s[0] == 'o' {
        return true
    }
    if s.len >= 2 && s[0] == 'h' && s[1] == 'o' {
        return true
    }
    if s.len >= 1 && s[0] == '8' {
        return s.len == 1 || !text.is_digits(s[1..2])
    }
    s.len >= 2 && s[0] == '1' && s[1] == '1' && (s.len == 2 || !text.is_digits(s[2..3]))
}

fn hebrew_letter(c: u32) -> bool {
    c >= 0x5D0 && c <= 0x5EA
}

fn adjust(l: locale.Locale, pattern: str, second: str) -> str {
    if l.language == "es" {
        if pattern == "{{0}} y {{1}}" && spanish_e(second) {
            return "{{0}} e {{1}}"
        }
        if pattern == "{{0}} o {{1}}" && spanish_u(second) {
            return "{{0}} u {{1}}"
        }
    }
    if l.language == "he" && pattern == "{{0}} ו{{1}}" {
        for c in second {
            if !hebrew_letter(c) {
                return "{{0}} ו-{{1}}"
            }
            break
        }
    }
    pattern
}

fn joined(l: locale.Locale, pattern: str, first: str, second: str) -> str {
    join(adjust(l, pattern, second), first, second)
}

/// Joins `items` with the list patterns of `l`.
///
/// A list of none is empty and a list of one is the item. Two items use the locale's pair pattern; longer lists nest its start, middle and end patterns from the last item to the first, as UTS 35 describes. Spanish writes `e` for `y` before a word that starts with the sound `i` and `u` for `o` before `o`, and Hebrew writes a hyphen after the conjunction before a word that does not start with a Hebrew letter.
pub fn format(l: locale.Locale, items: str[], kind: Kind, width: Width) -> str {
    if items.len == 0 {
        return ""
    }
    if items.len == 1 {
        return items[0]
    }
    if items.len == 2 {
        return joined(l, part(l, kind, width, 0), items[0], items[1])
    }
    var tail = joined(l, part(l, kind, width, 3), items[items.len - 2], items[items.len - 1])
    var i = items.len - 3
    for i > 0 {
        tail = join(part(l, kind, width, 2), items[i], tail)
        i -= 1
    }
    join(part(l, kind, width, 1), items[0], tail)
}
