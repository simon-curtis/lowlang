import std/math
import std/text

/// Why decimal text could not be read.
pub enum Error {
    /// The text is empty.
    Empty
    /// The byte at `offset` does not belong in a number.
    Malformed(offset: i64)
    /// The exponent is outside 10000 in either direction.
    TooLarge
}

/// Whether a `Decimal` is a number, an infinity or not a number.
pub enum Kind {
    /// A finite number.
    Finite
    /// Positive or negative infinity, by `negative`.
    Infinite
    /// Not a number.
    NotANumber
}

/// How a discarded remainder moves the last kept digit, named as in ECMA-402.
pub enum Mode {
    /// Rounds toward positive infinity.
    Ceil
    /// Rounds toward negative infinity.
    Floor
    /// Rounds away from zero.
    Expand
    /// Rounds toward zero.
    Trunc
    /// Rounds to the nearest, a tie toward positive infinity.
    HalfCeil
    /// Rounds to the nearest, a tie toward negative infinity.
    HalfFloor
    /// Rounds to the nearest, a tie away from zero.
    HalfExpand
    /// Rounds to the nearest, a tie toward zero.
    HalfTrunc
    /// Rounds to the nearest, a tie to the even digit.
    HalfEven
}

/// A decimal number of any length: `digits` read as an integer, divided by 10 to the power `scale`.
///
/// `digits` has no leading zero, and is `0` for zero. A negative `scale` is a count of trailing zeros that `digits` leaves out. The `scale` of a parsed number is its count of visible fraction digits, so `1.50` has digits `150` and scale `2`. `negative` is also set for `-0`.
pub struct Decimal {
    /// Whether the value is finite, infinite or not a number.
    pub kind: Kind
    /// Whether the sign is negative.
    pub negative: bool
    /// The coefficient digits, ASCII `0` to `9`.
    pub digits: str
    /// The power of ten the coefficient is divided by.
    pub scale: i64
}

/// The digits of a `Decimal` on each side of the point, with the integer part padded to at least one digit.
pub struct Parts {
    /// The integer digits, with no leading zero unless the value is below one.
    pub integer: str
    /// The fraction digits, `scale` of them when `scale` is positive.
    pub fraction: str
}

fn make(negative: bool, digits: str, scale: i64) -> Decimal {
    var start = 0
    for start + 1 < digits.len && digits[start] == '0' {
        start += 1
    }
    Decimal { kind: Kind.Finite, negative, digits: digits[start..], scale }
}

/// Returns the number `0`.
pub fn zero() -> Decimal {
    make(false, "0", 0)
}

/// Returns infinity, negative when `negative`.
pub fn infinity(negative: bool) -> Decimal {
    Decimal { kind: Kind.Infinite, negative, digits: "0", scale: 0 }
}

/// Returns not-a-number.
pub fn nan() -> Decimal {
    Decimal { kind: Kind.NotANumber, negative: false, digits: "0", scale: 0 }
}

/// Returns `n` with scale `0`.
pub fn from_int(n: i64) -> Decimal {
    let magnitude = if n < 0 { u64(0) - u64(n) } else { u64(n) }
    make(n < 0, "{magnitude}", 0)
}

/// Returns the shortest decimal that reads back as `x`, with `0` as its scale for an integer and `NaN` or infinity for those values.
pub fn from_f64(x: f64) -> Decimal {
    if math.is_nan(x) {
        return nan()
    }
    if math.is_inf(x) {
        return infinity(x < 0.0)
    }
    parse("{x}") or zero()
}

/// Reads decimal text: an optional sign, digits with an optional point, and an optional `e` exponent, or `inf`, `infinity` and `nan` in any case.
pub fn parse(s: str) -> Decimal ! Error {
    let t = text.trim(s)
    if t == "" {
        fail Empty
    }
    var at = 0
    var negative = false
    if t[0] == '-' || t[0] == '+' {
        negative = t[0] == '-'
        at = 1
    }
    let word = text.lower(t[at..])
    if word == "inf" || word == "infinity" {
        return infinity(negative)
    }
    if word == "nan" {
        return nan()
    }
    var digits: u8[] = []
    var scale = 0
    var seen_point = false
    var any = false
    for at < t.len {
        let c = t[at]
        if c >= '0' && c <= '9' {
            digits.push(c)
            any = true
            if seen_point {
                scale += 1
            }
        } else if c == '.' && !seen_point {
            seen_point = true
        } else {
            break
        }
        at += 1
    }
    if !any {
        fail Malformed(at)
    }
    if at < t.len {
        if t[at] != 'e' && t[at] != 'E' {
            fail Malformed(at)
        }
        let exponent = text.parse_int(t[at + 1..]) or fail Malformed(at + 1)
        if exponent > 10000 || exponent < -10000 {
            fail TooLarge
        }
        scale -= exponent
    }
    make(negative, str(digits), scale)
}

/// Returns `d` with the sign flipped.
pub fn negate(d: Decimal) -> Decimal {
    var out = d
    out.negative = !d.negative
    out
}

/// Returns whether `d` is a finite zero.
pub fn is_zero(d: Decimal) -> bool {
    d.kind == Kind.Finite && d.digits == "0"
}

fn zeros(n: i64) -> str {
    text.repeat("0", n)
}

/// Returns the digits of `d` on each side of the point.
pub fn parts(d: Decimal) -> Parts {
    if d.scale <= 0 {
        if d.digits == "0" {
            return Parts { integer: "0", fraction: "" }
        }
        return Parts { integer: "{d.digits}{zeros(-d.scale)}", fraction: "" }
    }
    if d.scale >= d.digits.len {
        return Parts { integer: "0", fraction: "{zeros(d.scale - d.digits.len)}{d.digits}" }
    }
    let cut = d.digits.len - d.scale
    Parts { integer: d.digits[..cut], fraction: d.digits[cut..] }
}

/// Returns the number of digits before the point, counting `0` as one.
pub fn integer_digits(d: Decimal) -> i64 {
    parts(d).integer.len
}

/// Returns the position of the first nonzero digit counted from the point: the exponent `e` for which `d` is `m` times 10 to the power `e` with `m` from 1 to below 10, or `0` for zero.
pub fn magnitude(d: Decimal) -> i64 {
    if is_zero(d) {
        return 0
    }
    d.digits.len - 1 - d.scale
}

/// Returns `d` times 10 to the power `k`, keeping its digits.
pub fn shift(d: Decimal, k: i64) -> Decimal {
    var out = d
    out.scale = d.scale - k
    out
}

/// Returns `d` with trailing fraction zeros removed, so its scale is at least `0` unless `digits` carries the zeros.
pub fn strip_zeros(d: Decimal) -> Decimal {
    var digits = d.digits
    var scale = d.scale
    if digits == "0" {
        return make(d.negative, "0", 0)
    }
    for scale > 0 && digits[digits.len - 1] == '0' {
        digits = digits[..digits.len - 1]
        scale -= 1
    }
    make(d.negative, digits, scale)
}

/// Returns `d` with its scale raised to `scale` by appending zeros, or `d` when its scale is already at least that.
pub fn pad(d: Decimal, scale: i64) -> Decimal {
    if d.scale >= scale {
        return d
    }
    var out = d
    if d.digits != "0" {
        out.digits = "{d.digits}{zeros(scale - d.scale)}"
    }
    out.scale = scale
    out
}

fn increment_digits(digits: str) -> str {
    var out: u8[] = []
    for c in digits {
        out.push(u8(c))
    }
    var i = out.len
    for i > 0 {
        i -= 1
        if out[i] == '9' {
            out[i] = '0'
        } else {
            out[i] += 1
            return str(out)
        }
    }
    "1{str(out)}"
}

fn is_zero_text(s: str) -> bool {
    for c in s {
        if c != '0' {
            return false
        }
    }
    true
}

fn half_order(rest: str) -> i64 {
    if rest == "" {
        return -1
    }
    if rest[0] > '5' {
        return 1
    }
    if rest[0] < '5' {
        return -1
    }
    if is_zero_text(rest[1..]) { 0 } else { 1 }
}

fn away(mode: Mode, negative: bool, last: u8, order: i64, exact: bool) -> bool {
    if exact {
        return false
    }
    match mode {
        Ceil => !negative
        Floor => negative
        Expand => true
        Trunc => false
        HalfCeil => order > 0 || (order == 0 && !negative)
        HalfFloor => order > 0 || (order == 0 && negative)
        HalfExpand => order >= 0
        HalfTrunc => order > 0
        HalfEven => order > 0 || (order == 0 && (last - '0') % 2 == 1)
    }
}

struct Split {
    kept: str
    rest: str
}

fn split_at(d: Decimal, places: i64) -> Split {
    if d.scale <= places {
        if d.digits == "0" {
            return Split { kept: "0", rest: "" }
        }
        return Split { kept: "{d.digits}{zeros(places - d.scale)}", rest: "" }
    }
    let dropped = d.scale - places
    if dropped >= d.digits.len {
        return Split { kept: "0", rest: "{zeros(dropped - d.digits.len)}{d.digits}" }
    }
    Split { kept: d.digits[..d.digits.len - dropped], rest: d.digits[d.digits.len - dropped..] }
}

/// Returns `d` rounded to `places` digits after the point by `mode`, with scale exactly `places`.
///
/// `places` may be negative to round to tens, hundreds and so on. A number that is not finite is returned as it is.
pub fn round_places(d: Decimal, places: i64, mode: Mode) -> Decimal {
    if d.kind != Kind.Finite {
        return d
    }
    let split = split_at(d, places)
    var kept = split.kept
    let last = kept[kept.len - 1]
    if away(mode, d.negative, last, half_order(split.rest), is_zero_text(split.rest)) {
        kept = increment_digits(kept)
    }
    make(d.negative, kept, places)
}

/// Returns `d` rounded to `digits` significant digits by `mode`, with trailing zeros kept to show them.
///
/// A `digits` below one is read as one. Zero is returned padded to `digits` significant digits.
pub fn round_significant(d: Decimal, digits: i64, mode: Mode) -> Decimal {
    if d.kind != Kind.Finite {
        return d
    }
    let want = if digits < 1 { 1 } else { digits }
    if is_zero(d) {
        return pad(d, want - 1)
    }
    let first = round_places(d, want - 1 - magnitude(d), mode)
    let again = magnitude(first)
    if again != magnitude(d) {
        return round_places(first, want - 1 - again, mode)
    }
    first
}

struct Quotient {
    digits: str
    remainder: i64
}

fn divide_small(digits: str, divisor: i64) -> Quotient {
    var out: u8[] = []
    var rest = 0
    for c in digits {
        let cur = rest * 10 + i64(c - '0')
        out.push(u8(cur / divisor) + '0')
        rest = cur % divisor
    }
    Quotient { digits: str(out), remainder: rest }
}

fn reversed(out: u8[]) -> str {
    var flipped: u8[] = []
    var j = out.len
    for j > 0 {
        j -= 1
        flipped.push(out[j])
    }
    str(flipped)
}

fn multiply_small(digits: str, factor: i64) -> str {
    var out: u8[] = []
    var carry = 0
    var i = digits.len
    for i > 0 {
        i -= 1
        let cur = i64(digits[i] - '0') * factor + carry
        out.push(u8(cur % 10) + '0')
        carry = cur / 10
    }
    for carry > 0 {
        out.push(u8(carry % 10) + '0')
        carry = carry / 10
    }
    reversed(out)
}

fn add_small(digits: str, amount: i64) -> str {
    var value = amount
    var out: u8[] = []
    var i = digits.len
    var carry = 0
    for i > 0 || value > 0 || carry > 0 {
        var cur = carry + value % 10
        value = value / 10
        if i > 0 {
            i -= 1
            cur += i64(digits[i] - '0')
        }
        out.push(u8(cur % 10) + '0')
        carry = cur / 10
    }
    reversed(out)
}

fn increment_order(remainder: i64, increment: i64, fraction: str) -> i64 {
    let twice = remainder * 2
    if is_zero_text(fraction) {
        if twice == increment {
            return 0
        }
        return if twice < increment { -1 } else { 1 }
    }
    if twice >= increment {
        return 1
    }
    if twice == increment - 1 {
        return half_order(fraction)
    }
    -1
}

/// Returns `d` rounded by `mode` to a multiple of `increment` units of the digit `places` after the point, such as `5` units at `2` places for multiples of 0.05.
///
/// The result has scale `places`. An `increment` below two is the same as `round_places`.
pub fn round_increment(d: Decimal, places: i64, increment: i64, mode: Mode) -> Decimal {
    if d.kind != Kind.Finite || increment <= 1 {
        return round_places(d, places, mode)
    }
    let split = split_at(d, places)
    let divided = divide_small(split.kept, increment)
    let exact = divided.remainder == 0 && is_zero_text(split.rest)
    let order = increment_order(divided.remainder, increment, split.rest)
    let last = divided.digits[divided.digits.len - 1]
    var quotient = divided.digits
    if away(mode, d.negative, last, order, exact) {
        quotient = increment_digits(quotient)
    }
    make(d.negative, multiply_small(quotient, increment), places)
}

/// Returns the digits of `d` as text with a `.` between the integer and fraction parts, `-` first when negative, and exactly `scale` fraction digits when `scale` is positive.
pub fn text_of(d: Decimal) -> str {
    match d.kind {
        Infinite => return if d.negative { "-Infinity" } else { "Infinity" }
        NotANumber => return "NaN"
        Finite => {}
    }
    let p = parts(d)
    let sign = if d.negative { "-" } else { "" }
    if p.fraction == "" {
        return "{sign}{p.integer}"
    }
    "{sign}{p.integer}.{p.fraction}"
}
