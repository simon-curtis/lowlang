import std/locale
import std/locale/data
import std/locale/decimal

/// A plural category of CLDR.
pub enum Category {
    /// The category `zero`.
    Zero
    /// The category `one`.
    One
    /// The category `two`.
    Two
    /// The category `few`.
    Few
    /// The category `many`.
    Many
    /// The category `other`.
    Other
}

/// The operands that CLDR plural rules read, for the absolute value of a number.
///
/// An integer part longer than 18 digits keeps its low 18 digits.
pub struct Operands {
    /// The integer digits `i`.
    pub i: i64
    /// The count of visible fraction digits `v`.
    pub v: i64
    /// The visible fraction digits `f` as an integer.
    pub f: i64
    /// The count of fraction digits without trailing zeros `w`.
    pub w: i64
    /// The fraction digits without trailing zeros `t` as an integer.
    pub t: i64
    /// The compact decimal exponent `e`, which `c` also names.
    pub e: i64
}

/// Returns the name of `c` in CLDR: `zero`, `one`, `two`, `few`, `many` or `other`.
pub fn name(c: Category) -> str {
    match c {
        Zero => "zero"
        One => "one"
        Two => "two"
        Few => "few"
        Many => "many"
        Other => "other"
    }
}

/// Returns the category called `s`, or `Other` when `s` names none.
pub fn category(s: str) -> Category {
    match s {
        "zero" => Category.Zero
        "one" => Category.One
        "two" => Category.Two
        "few" => Category.Few
        "many" => Category.Many
        _ => Category.Other
    }
}

fn category_at(index: i64) -> Category {
    match index {
        0 => Category.Zero
        1 => Category.One
        2 => Category.Two
        3 => Category.Few
        4 => Category.Many
        _ => Category.Other
    }
}

fn tail_digits(s: str, count: i64) -> i64 {
    let start = if s.len > count { s.len - count } else { 0 }
    var value = 0
    for c in s[start..] {
        value = value * 10 + i64(c - '0')
    }
    value
}

/// Returns the operands of `d` for a number shown with the compact exponent `exponent`, which is `0` for plain notation.
///
/// `d` is the whole value, so the compact number `1.5c6` has `i` of `1500000` and an `e` of `6`: pass `decimal.shift(1.5, 6)` as `d`.
pub fn operands(d: decimal.Decimal, exponent: i64) -> Operands {
    let p = decimal.parts(d)
    var fraction = p.fraction
    var trimmed = fraction
    for trimmed.len > 0 && trimmed[trimmed.len - 1] == '0' {
        trimmed = trimmed[..trimmed.len - 1]
    }
    Operands {
        i: tail_digits(p.integer, 18),
        v: fraction.len,
        f: tail_digits(fraction, 18),
        w: trimmed.len,
        t: tail_digits(trimmed, 18),
        e: exponent
    }
}

/// Returns the operands of the whole number `n`.
pub fn operands_of_int(n: i64) -> Operands {
    operands(decimal.from_int(n), 0)
}

/// Returns the operands of the decimal text `s`, which may end in a compact exponent as `c` or `e` and a count, such as `1.5c6`.
///
/// Fails with `decimal.Error` when `s` is not a number.
pub fn operands_of_text(s: str) -> Operands ! decimal.Error {
    var mantissa = s
    var exponent = 0
    var at = -1
    for i, c in s {
        if c == 'c' || c == 'C' {
            at = i
        }
    }
    if at >= 0 {
        mantissa = s[..at]
        exponent = text_to_int(s[at + 1..])?
    }
    let d = decimal.parse(mantissa)?
    operands(decimal.shift(d, exponent), exponent)
}

fn text_to_int(s: str) -> i64 ! decimal.Error {
    var value = 0
    if s == "" {
        fail Malformed(0)
    }
    for i, c in s {
        if c < '0' || c > '9' {
            fail Malformed(i)
        }
        value = value * 10 + i64(c - '0')
    }
    value
}

struct Reader {
    code: str
    at: i64
}

fn take(r: *Reader) -> i64 {
    let b = i64(r.code[r.at])
    r.at += 1
    b
}

fn take_varint(r: *Reader) -> i64 {
    var value = 0
    var shift = 0
    for {
        let b = take(r)
        value = value | ((b & 0x7F) << shift)
        if b < 0x80 {
            break
        }
        shift += 7
    }
    value
}

fn operand_value(o: Operands, which: i64) -> i64 {
    match which {
        1 => o.i
        2 => o.v
        3 => o.w
        4 => o.f
        5 => o.t
        6 => o.e
        7 => o.e
        _ => o.i
    }
}

fn relation_holds(r: *Reader, o: Operands) -> bool {
    let head = take(r)
    let which = head & 7
    var value = operand_value(o, which)
    var integral = true
    if which == 0 {
        integral = o.f == 0
    }
    if head & 8 != 0 {
        let modulus = take_varint(r)
        value = value % modulus
    }
    let ranges = take(r)
    var inside = false
    for k in 0..ranges {
        let lo = take_varint(r)
        let hi = take_varint(r)
        if integral && value >= lo && value <= hi {
            inside = true
        }
    }
    inside != (head & 16 != 0)
}

fn term_holds(r: *Reader, o: Operands) -> bool {
    let count = take(r)
    var all = true
    for k in 0..count {
        if !relation_holds(r, o) {
            all = false
        }
    }
    all
}

fn condition_holds(code: str, o: Operands) -> bool {
    let r = new(Reader { code, at: 0 })
    let terms = take(r)
    if terms == 0 {
        return true
    }
    for k in 0..terms {
        if term_holds(r, o) {
            return true
        }
    }
    false
}

fn read_id(table: str, at: i64) -> str {
    let len = i64(table[at])
    table[at + 1..at + 1 + len]
}

fn skip_triples(table: str, at: i64) -> i64 {
    let count = i64(table[at])
    at + 1 + count * 3
}

fn skip_rules(table: str, at: i64) -> i64 {
    let count = i64(table[at])
    var cursor = at + 1
    for k in 0..count {
        let r = new(Reader { code: table, at: cursor + 1 })
        let len = take_varint(r)
        cursor = r.at + len
    }
    cursor
}

fn candidates(l: locale.Locale) -> []str {
    var ids: []str = []
    for id in locale.chain(l) {
        if id != "root" {
            push(mut ids, id)
        }
    }
    push(mut ids, l.language)
    push(mut ids, "root")
    ids
}

fn select_in(table: str, l: locale.Locale, o: Operands) -> Category {
    for id in candidates(l) {
        match find_rules(table, id) {
            some(at) => return run_rules(table, at, o)
            none => {}
        }
    }
    Category.Other
}

fn find_rules(table: str, id: str) -> i64? {
    var at = 0
    for at < table.len {
        let count = i64(table[at])
        at += 1
        var found = false
        for k in 0..count {
            let key = read_id(table, at)
            if key == id {
                found = true
            }
            at += 1 + key.len
        }
        if found {
            return at
        }
        at = skip_rules(table, at)
    }
    none
}

fn run_rules(table: str, at: i64, o: Operands) -> Category {
    let count = i64(table[at])
    var cursor = at + 1
    for k in 0..count {
        let which = i64(table[cursor])
        let r = new(Reader { code: table, at: cursor + 1 })
        let len = take_varint(r)
        let code = table[r.at..r.at + len]
        if condition_holds(code, o) {
            return category_at(which)
        }
        cursor = r.at + len
    }
    Category.Other
}

/// Returns the cardinal plural category of the number with operands `o` in `l`, such as `One` for 1 in English.
pub fn cardinal(l: locale.Locale, o: Operands) -> Category {
    select_in(data.plural_cardinal_table(), l, o)
}

/// Returns the ordinal plural category of the number with operands `o` in `l`, such as `Two` for 2 in English.
pub fn ordinal(l: locale.Locale, o: Operands) -> Category {
    select_in(data.plural_ordinal_table(), l, o)
}

/// Returns the cardinal category of `d` in `l`.
pub fn category_of(l: locale.Locale, d: decimal.Decimal) -> Category {
    cardinal(l, operands(d, 0))
}

/// Returns the category of the range from a number in category `start` to one in category `end` in `l`, such as `Other` for `1` to `5` in English.
///
/// A locale with no entry for the pair gives `Other`.
pub fn range(l: locale.Locale, start: Category, end: Category) -> Category {
    let table = data.plural_range_table()
    for id in candidates(l) {
        match find_range_group(table, id) {
            some(at) => return range_in(table, at, start, end)
            none => {}
        }
    }
    Category.Other
}

fn category_index(c: Category) -> i64 {
    match c {
        Zero => 0
        One => 1
        Two => 2
        Few => 3
        Many => 4
        Other => 5
    }
}

fn find_range_group(table: str, id: str) -> i64? {
    var at = 0
    for at < table.len {
        let count = i64(table[at])
        at += 1
        var found = false
        for k in 0..count {
            let key = read_id(table, at)
            if key == id {
                found = true
            }
            at += 1 + key.len
        }
        if found {
            return at
        }
        at = skip_triples(table, at)
    }
    none
}

fn range_in(table: str, at: i64, start: Category, end: Category) -> Category {
    let count = i64(table[at])
    for k in 0..count {
        let base = at + 1 + k * 3
        if i64(table[base]) == category_index(start) && i64(table[base + 1]) == category_index(end) {
            return category_at(i64(table[base + 2]))
        }
    }
    Category.Other
}
