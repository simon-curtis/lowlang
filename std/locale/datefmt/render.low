import std/builder
import std/locale
import std/locale/data
import std/locale/numfmt
import std/text

fn hour_in(letter: u8, hour: i64) -> i64 {
    match letter {
        'h' => (hour + 11) % 12 + 1
        'K' => hour % 12
        'k' => if hour == 0 { 24 } else { hour }
        _ => hour
    }
}

fn sunday_based(weekday: i64) -> i64 {
    weekday % 7
}

fn fraction_digits(nanosecond: i64, length: i64) -> str {
    var digits = "{nanosecond}"
    if digits.len < 9 {
        digits = "{text.repeat("0", 9 - digits.len)}{digits}"
    }
    var out = ""
    for i in 0..length {
        out = "{out}{if i < 9 { digits[i..i + 1] } else { "0" }}"
    }
    out
}

fn sign_of(offset: i64) -> str {
    if offset < 0 { "-" } else { "+" }
}

fn zone_pattern(l: locale.Locale, negative: bool) -> str {
    let pattern = locale.entry(l, data.group_zone_format, 2) ?? "+HH:mm;-HH:mm"
    let at = text.index(pattern, ";")
    if at < 0 {
        return pattern
    }
    if negative { pattern[at + 1..] } else { pattern[..at] }
}

fn hour_only(tokens: Token[]) -> Token[] {
    var out: Token[] = []
    for i, t in tokens {
        if t.kind == TokenKind.Field && t.letter == 'm' {
            break
        }
        let before_minutes = i + 1 < tokens.len && tokens[i + 1].kind == TokenKind.Field && tokens[i + 1].letter == 'm'
        if t.kind == TokenKind.Literal && before_minutes && i > 0 {
            continue
        }
        out.push(t)
    }
    out
}

fn localized_gmt(l: locale.Locale, offset: i64, short: bool) -> str {
    if offset == 0 {
        return locale.entry(l, data.group_zone_format, 1) ?? "GMT"
    }
    let magnitude = if offset < 0 { -offset } else { offset }
    let hours = magnitude / 3600
    let minutes = (magnitude % 3600) / 60
    var tokens = tokenize(zone_pattern(l, offset < 0), false)
    if short && minutes == 0 {
        tokens = hour_only(tokens)
    }
    var out = builder.builder()
    for t in tokens {
        if t.kind == TokenKind.Field && t.letter == 'H' {
            builder.write(mut out, pad(l, hours, if short { 1 } else { 2 }))
        } else if t.kind == TokenKind.Field && t.letter == 'm' {
            builder.write(mut out, pad(l, minutes, 2))
        } else if t.kind == TokenKind.Literal {
            builder.write(mut out, t.literal)
        }
    }
    let gmt = locale.entry(l, data.group_zone_format, 0) ?? "GMT{{0}}"
    text.replace(gmt, "{{0}}", builder.to_str(out))
}

fn iso_offset(offset: i64, extended: bool, with_minutes: bool, with_seconds: bool, zulu: bool) -> str {
    if offset == 0 && zulu {
        return "Z"
    }
    let magnitude = if offset < 0 { -offset } else { offset }
    let hours = magnitude / 3600
    let minutes = (magnitude % 3600) / 60
    let seconds = magnitude % 60
    let colon = if extended { ":" } else { "" }
    var out = "{sign_of(offset)}{text.pad_left("{hours}", 2, '0')}"
    if with_minutes || minutes != 0 || (with_seconds && seconds != 0) {
        out = "{out}{colon}{text.pad_left("{minutes}", 2, '0')}"
    }
    if with_seconds && seconds != 0 {
        out = "{out}{colon}{text.pad_left("{seconds}", 2, '0')}"
    }
    out
}

fn render_zone(l: locale.Locale, t: Token, m: Moment) -> str {
    let offset = m.offset
    match t.letter {
        'Z' => {
            if t.length <= 3 {
                return numfmt.localize_digits(l, iso_offset(offset, false, true, false, false))
            }
            if t.length == 4 {
                return localized_gmt(l, offset, false)
            }
            numfmt.localize_digits(l, iso_offset(offset, true, true, false, true))
        }
        'x' => {
            let with_minutes = t.length == 2 || t.length == 3 || t.length == 4 || t.length == 5
            let extended = t.length == 3 || t.length == 5
            numfmt.localize_digits(l, iso_offset(offset, extended, with_minutes && t.length > 1, t.length >= 4, false))
        }
        'X' => {
            let extended = t.length == 3 || t.length == 5
            numfmt.localize_digits(l, iso_offset(offset, extended, t.length > 1, t.length >= 4, true))
        }
        'V' => {
            if t.length == 2 && m.zone_id != "" {
                return m.zone_id
            }
            if t.length == 1 {
                return "unk"
            }
            localized_gmt(l, offset, false)
        }
        'O' => localized_gmt(l, offset, t.length == 1)
        _ => localized_gmt(l, offset, t.length < 4)
    }
}

fn render_field(l: locale.Locale, t: Token, m: Moment) -> str {
    let n = t.length
    let rule = week_rule(l)
    let sun = sunday_based(m.weekday)
    match t.letter {
        'G' => era_name(l, m.year > 0, n)
        'y' => {
            let era_year = if m.year > 0 { m.year } else { 1 - m.year }
            if n == 2 {
                return pad(l, era_year % 100, 2)
            }
            pad(l, era_year, n)
        }
        'u' => pad(l, m.year, n)
        'r' => pad(l, m.year, n)
        'Y' => {
            let w = week_of_year(m.year, m.day_of_year, sun, rule.first_day, rule.min_days)
            if n == 2 {
                return pad(l, w.year % 100, 2)
            }
            pad(l, w.year, n)
        }
        'Q' => if n <= 2 { pad(l, (m.month - 1) / 3 + 1, n) } else { quarter_name(l, (m.month - 1) / 3 + 1, n, false) }
        'q' => if n <= 2 { pad(l, (m.month - 1) / 3 + 1, n) } else { quarter_name(l, (m.month - 1) / 3 + 1, n, true) }
        'M' => if n <= 2 { pad(l, m.month, n) } else { month_name(l, m.month, n, false) }
        'L' => if n <= 2 { pad(l, m.month, n) } else { month_name(l, m.month, n, true) }
        'w' => pad(l, week_of_year(m.year, m.day_of_year, sun, rule.first_day, rule.min_days).number, n)
        'W' => pad(l, week_of_month(m.day, sun, rule.first_day, rule.min_days), n)
        'd' => pad(l, m.day, n)
        'D' => pad(l, m.day_of_year, n)
        'E' => weekday_name(l, sun, n, false)
        'e' => if n <= 2 { pad(l, (sun - rule.first_day + 7) % 7 + 1, n) } else { weekday_name(l, sun, n, false) }
        'c' => if n <= 2 { pad(l, (sun - rule.first_day + 7) % 7 + 1, n) } else { weekday_name(l, sun, n, true) }
        'a' => period_name(l, if m.hour < 12 { 0 } else { 1 }, n, false)
        'b' => {
            let exact = m.minute == 0 && m.second == 0 && m.nanosecond == 0
            if exact && m.hour == 12 {
                let noon = period_name(l, 3, n, false)
                if noon != "" {
                    return noon
                }
            }
            if exact && m.hour == 0 {
                let midnight = period_name(l, 2, n, false)
                if midnight != "" {
                    return midnight
                }
            }
            period_name(l, if m.hour < 12 { 0 } else { 1 }, n, false)
        }
        'B' => {
            let exact = m.second == 0 && m.nanosecond == 0
            let minutes = m.hour * 60 + m.minute
            let slot = flexible_period(l, minutes, exact)
            let named = period_name(l, slot, n, false)
            if named != "" {
                return named
            }
            let approximate = period_name(l, flexible_period(l, minutes, false), n, false)
            if approximate != "" { approximate } else { period_name(l, if m.hour < 12 { 0 } else { 1 }, n, false) }
        }
        'h' => pad(l, hour_in('h', m.hour), n)
        'H' => pad(l, m.hour, n)
        'K' => pad(l, hour_in('K', m.hour), n)
        'k' => pad(l, hour_in('k', m.hour), n)
        'm' => pad(l, m.minute, n)
        's' => pad(l, m.second, n)
        'S' => numfmt.localize_digits(l, fraction_digits(m.nanosecond, n))
        'A' => pad(l, ((m.hour * 60 + m.minute) * 60 + m.second) * 1000 + m.nanosecond / 1000000, n)
        _ => render_zone(l, t, m)
    }
}

fn render(l: locale.Locale, tokens: Token[], m: Moment) -> str {
    var out = builder.builder()
    for t in tokens {
        if t.kind == TokenKind.Field {
            builder.write(mut out, render_field(l, t, m))
        } else {
            builder.write(mut out, t.literal)
        }
    }
    builder.to_str(out)
}
