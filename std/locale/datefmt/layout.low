import std/builder
import std/locale
import std/time/pattern

fn padded_verb(length: i64, verb: str) -> str {
    if length == 1 { "%-{verb}" } else { "%{verb}" }
}

fn verb_of(t: Token) -> str? {
    match t.letter {
        'y' => if t.length == 2 { "%y" } else { "%Y" }
        == 'M' || == 'L' => if t.length <= 2 { padded_verb(t.length, "m") } else if t.length == 3 { "%b" } else { "%B" }
        'd' => padded_verb(t.length, "d")
        'E' => if t.length <= 3 { "%a" } else { "%A" }
        'H' => padded_verb(t.length, "H")
        'h' => padded_verb(t.length, "I")
        'm' => padded_verb(t.length, "M")
        's' => padded_verb(t.length, "S")
        'a' => "%p"
        _ => none
    }
}

fn layout_of(tokens: Token[]) -> str? {
    var out = builder.builder()
    for t in tokens {
        match t.kind {
            Field => {
                match verb_of(t) {
                    some(v) => builder.write(mut out, v)
                    none => return none
                }
            }
            Slot => return none
            Literal => {
                for c in t.literal {
                    if c == '%' {
                        builder.write(mut out, "%%")
                    } else {
                        builder.write_char(mut out, c)
                    }
                }
            }
        }
    }
    builder.to_str(out)
}

fn layout_checked(tokens: Token[]) -> str ! Error {
    match layout_of(tokens) {
        some(text) => text
        none => fail NoLayout(serialize(tokens))
    }
}

/// Returns the layouts of `l` that `%x`, `%X` and `%c` stand for in `pattern.compile_in`.
///
/// The date is the short date pattern, the time of day the medium time pattern and the date and time the medium date and medium time patterns joined as the locale joins them. Fields print with the digits `pattern` uses, so a locale whose numbering system is not Latin prints Latin digits. Fails with `NoLayout` when a pattern holds a field that has no layout verb, such as the era of Latin or the flexible day period of Traditional Chinese.
pub fn layouts(l: locale.Locale) -> pattern.Layouts ! Error {
    let date = layout_checked(standard_pattern(l, 0, Length.Short))?
    let time = layout_checked(standard_pattern(l, 4, Length.Medium))?
    var o = options()
    o.date_style = Length.Medium
    o.time_style = Length.Medium
    let both = layout_checked(style_tokens(l, o))?
    pattern.Layouts { date, time, date_time: both }
}

/// Returns the month, weekday and day period names of `l` for `pattern.render`.
///
/// Months and weekdays are the wide and abbreviated format names, and the day periods the abbreviated `am` and `pm`.
pub fn names(l: locale.Locale) -> pattern.Names {
    var months: str[] = []
    var short_months: str[] = []
    for m in 1..13 {
        months.push(month_name(l, m, 4, false))
        short_months.push(month_name(l, m, 3, false))
    }
    var weekdays: str[] = []
    var short_weekdays: str[] = []
    for d in 1..8 {
        weekdays.push(weekday_name(l, d % 7, 4, false))
        short_weekdays.push(weekday_name(l, d % 7, 3, false))
    }
    pattern.Names { months, short_months, weekdays, short_weekdays, am: period_name(l, 0, 3, false), pm: period_name(l, 1, 3, false) }
}
