import std/locale
import std/locale/data
import std/time/date
import std/time/datetime
import std/time/offset
import std/time/pattern
import std/time/timeofday
import std/time/zone
import std/time/zoned

/// How long a standard date or time pattern is.
pub enum Length {
    /// "Tuesday, March 5, 2024" and "3:45:30 PM Coordinated Universal Time".
    Full
    /// "March 5, 2024" and "3:45:30 PM UTC".
    Long
    /// "Mar 5, 2024" and "3:45:30 PM".
    Medium
    /// "3/5/24" and "3:45 PM".
    Short
}

/// The hour cycle a time is written in.
pub enum HourCycle {
    /// The `hc` key of the locale, or the locale's preference.
    Auto
    /// Hours `0` to `11` with a day period.
    H11
    /// Hours `1` to `12` with a day period.
    H12
    /// Hours `0` to `23`.
    H23
    /// Hours `1` to `24`.
    H24
}

/// Why a value could not be formatted.
pub enum Error {
    /// Neither a style nor a skeleton was given.
    EmptyRequest
    /// The pattern prints a date and the value has none.
    MissingDate
    /// The pattern prints a time and the value has none.
    MissingTime
    /// The pattern prints a time zone and the value has none.
    MissingZone
    /// The skeleton holds a character that is not a date field. `skeleton` is the text given.
    InvalidSkeleton(skeleton: str)
    /// A standard pattern has a field that no strftime verb prints. `pattern` is the CLDR pattern.
    NoLayout(pattern: str)
}

/// The calendar and clock fields of one value in the Gregorian calendar, with what it has of each.
pub struct Moment {
    /// The year, where `0` is 1 BC.
    pub year: i64
    /// The month from `1` to `12`.
    pub month: i64
    /// The day of the month.
    pub day: i64
    /// The weekday from `1` for Monday to `7` for Sunday.
    pub weekday: i64
    /// The day of the year from `1`.
    pub day_of_year: i64
    /// The hour from `0` to `23`.
    pub hour: i64
    /// The minute.
    pub minute: i64
    /// The second.
    pub second: i64
    /// The nanosecond within the second.
    pub nanosecond: i64
    /// Whether the year, month and day are set.
    pub has_date: bool
    /// Whether the hour, minute, second and nanosecond are set.
    pub has_time: bool
    /// Whether the offset is set.
    pub has_zone: bool
    /// The offset from UTC in seconds, positive to the east.
    pub offset: i64
    /// The name of the time zone, or empty when the value has only an offset.
    pub zone_id: str
}

/// What to print and how.
///
/// `skeleton` is a UTS 35 skeleton such as `yMMMd` or `jm`; when it is not empty it replaces both styles. Without a skeleton or a style the request is empty.
pub struct Options {
    /// The standard date pattern, or none.
    pub date_style: Length?
    /// The standard time pattern, or none.
    pub time_style: Length?
    /// A skeleton to match against the locale's patterns, or empty.
    pub skeleton: str
    /// The hour cycle to write the time in.
    pub hour_cycle: HourCycle
}

/// Returns options that request nothing yet.
pub fn options() -> Options {
    Options { date_style: none, time_style: none, skeleton: "", hour_cycle: HourCycle.Auto }
}

fn empty_moment() -> Moment {
    Moment {
        year: 1970,
        month: 1,
        day: 1,
        weekday: 4,
        day_of_year: 1,
        hour: 0,
        minute: 0,
        second: 0,
        nanosecond: 0,
        has_date: false,
        has_time: false,
        has_zone: false,
        offset: 0,
        zone_id: ""
    }
}

/// Returns the fields of the date `d`.
pub fn from_date(d: date.Date) -> Moment {
    var m = empty_moment()
    m.year = date.year(d)
    m.month = date.month_number(d)
    m.day = date.day(d)
    m.weekday = date.weekday_to_number(date.weekday(d))
    m.day_of_year = date.day_of_year(d)
    m.has_date = true
    m
}

/// Returns the fields of the time of day `t`.
pub fn from_time(t: timeofday.TimeOfDay) -> Moment {
    var m = empty_moment()
    m.hour = timeofday.hour(t)
    m.minute = timeofday.minute(t)
    m.second = timeofday.second(t)
    m.nanosecond = timeofday.nanosecond(t)
    m.has_time = true
    m
}

/// Returns the fields of the date and time `dt`.
pub fn from_datetime(dt: datetime.DateTime) -> Moment {
    var m = from_date(datetime.date(dt))
    let t = from_time(datetime.time(dt))
    m.hour = t.hour
    m.minute = t.minute
    m.second = t.second
    m.nanosecond = t.nanosecond
    m.has_time = true
    m
}

/// Returns the local fields of `z` with its offset and zone name.
pub fn from_zoned(z: zoned.Zoned) -> Moment {
    var m = from_datetime(zoned.datetime(z))
    m.offset = offset.seconds_of(zoned.offset(z))
    m.zone_id = zone.name(zoned.zone(z))
    m.has_zone = true
    m
}

fn hour_letter(l: locale.Locale, cycle: HourCycle) -> u8 {
    match cycle {
        H11 => 'K'
        H12 => 'h'
        H23 => 'H'
        H24 => 'k'
        Auto => preferred_hour(l)
    }
}

struct Request {
    skeleton: Skeleton
    hour: u8
}

fn is_hour_letter(c: u8) -> bool {
    c == 'h' || c == 'H' || c == 'K' || c == 'k'
}

fn with_hour_letter(tokens: Token[], letter: u8) -> Token[] {
    var out: Token[] = []
    for t in tokens {
        if t.kind == TokenKind.Field && is_hour_letter(t.letter) {
            out.push(field_token(letter, t.length))
        } else {
            out.push(t)
        }
    }
    out
}

fn resolve_skeleton(l: locale.Locale, text_skeleton: str, cycle: HourCycle) -> Request ! Error {
    var tokens = tokenize(text_skeleton, false)
    var resolved: Token[] = []
    var forced: u8 = 0
    for t in tokens {
        if t.kind != TokenKind.Field {
            fail InvalidSkeleton(text_skeleton)
        }
        if t.letter == 'j' || t.letter == 'J' || t.letter == 'C' {
            let letter = hour_letter(l, cycle)
            if cycle != HourCycle.Auto {
                forced = letter
            }
            resolved.push(field_token(letter, if t.length >= 2 { 2 } else { 1 }))
            continue
        }
        if is_hour_letter(t.letter) {
            forced = t.letter
        }
        if letter_info(t.letter, t.length) == none {
            fail InvalidSkeleton(text_skeleton)
        }
        resolved.push(t)
    }
    Request { skeleton: skeleton_of_tokens(resolved), hour: forced }
}

fn length_index(length: Length) -> i64 {
    match length {
        Full => 0
        Long => 1
        Medium => 2
        Short => 3
    }
}

fn standard_pattern(l: locale.Locale, base: i64, length: Length) -> Token[] {
    tokenize(locale.entry(l, data.group_date_formats, base + length_index(length)) ?? "", false)
}

fn without_period(tokens: Token[], cycle: u8) -> Token[] {
    var out: Token[] = []
    for t in tokens {
        if t.kind == TokenKind.Field && letter_info(t.letter, t.length) != none {
            let info = letter_info(t.letter, t.length) ?? Letter { field: 0, kind: 0 }
            if info.field == period_field {
                continue
            }
            if info.field == hour_field {
                out.push(field_token(cycle, t.length))
                continue
            }
        }
        out.push(t)
    }
    out
}

fn restyled(l: locale.Locale, tokens: Token[], cycle: u8) -> Token[] {
    let request = skeleton_of_tokens(without_period(tokens, cycle))
    with_hour_letter(best_tokens(l, request), cycle)
}

fn wants_cycle(l: locale.Locale, o: Options) -> bool {
    o.hour_cycle != HourCycle.Auto || l.hour_cycle != ""
}

fn time_tokens(l: locale.Locale, o: Options, length: Length) -> Token[] {
    let tokens = standard_pattern(l, 4, length)
    if wants_cycle(l, o) {
        return restyled(l, tokens, hour_letter(l, o.hour_cycle))
    }
    tokens
}

fn style_tokens(l: locale.Locale, o: Options) -> Token[] {
    let date_length = o.date_style ?? Length.Short
    let time_length = o.time_style ?? Length.Short
    if o.date_style != none && o.time_style != none {
        let date_tokens = standard_pattern(l, 0, date_length)
        let time_part = time_tokens(l, o, time_length)
        return substitute(tokenize(glue_pattern(l, length_index(date_length)), true), date_tokens, time_part)
    }
    if o.date_style != none {
        return standard_pattern(l, 0, date_length)
    }
    time_tokens(l, o, time_length)
}

fn resolve_tokens(l: locale.Locale, o: Options) -> Token[] ! Error {
    if o.skeleton != "" {
        let request = resolve_skeleton(l, o.skeleton, o.hour_cycle)?
        let matched = best_tokens(l, request.skeleton)
        if request.hour != 0 {
            return with_hour_letter(matched, request.hour)
        }
        return matched
    }
    if o.date_style == none && o.time_style == none {
        fail EmptyRequest
    }
    style_tokens(l, o)
}

fn needs(tokens: Token[], from: i64, to: i64) -> bool {
    for t in tokens {
        if t.kind != TokenKind.Field {
            continue
        }
        let info = letter_info(t.letter, t.length) ?? continue
        if info.field >= from && info.field <= to {
            return true
        }
    }
    false
}

fn check(tokens: Token[], m: Moment) ! Error {
    if needs(tokens, era_field, day_field) && !m.has_date {
        fail MissingDate
    }
    if needs(tokens, period_field, fraction_field) && !m.has_time {
        fail MissingTime
    }
    if needs(tokens, zone_field, zone_field) && !m.has_zone {
        fail MissingZone
    }
}

/// Returns the CLDR pattern `format` would use for `o` in `l`, such as `EEEE, MMMM d, y`.
///
/// A style gives the locale's standard pattern. A skeleton is matched against the locale's available formats as UTS 35 describes: the nearest format by field distance is adjusted to the lengths asked for, and fields it lacks are added from other formats or joined from separate date and time patterns. Fails with `EmptyRequest` when `o` asks for nothing and with `InvalidSkeleton` when the skeleton holds a character that is not a field.
pub fn pattern(l: locale.Locale, o: Options) -> str ! Error {
    let tokens = resolve_tokens(l, o)?
    serialize(tokens)
}

/// Formats `m` for `l` as `o` asks.
///
/// Month, weekday, era and day-period names, digits, hour cycle and week rules come from the locale. A time zone field prints the localized GMT offset form; zone names are not in the data. Fails with `MissingDate`, `MissingTime` or `MissingZone` when the pattern needs a part `m` lacks, and as `pattern` does.
pub fn format(l: locale.Locale, m: Moment, o: Options) -> str ! Error {
    let tokens = resolve_tokens(l, o)?
    check(tokens, m)?
    render(l, tokens, m)
}
