import std/locale
import std/locale/data
import std/text

struct Resolved {
    skeleton: Skeleton
    tokens: []Token
}

struct IntervalRule {
    skeleton: Skeleton
    pattern: []Token
}

fn era_of(m: Moment) -> i64 {
    if m.year > 0 { 1 } else { 0 }
}

fn greatest_difference(a: Moment, b: Moment) -> i64 {
    if a.has_date && b.has_date {
        if era_of(a) != era_of(b) {
            return era_field
        }
        if a.year != b.year {
            return year_field
        }
        if a.month != b.month {
            return month_field
        }
        if a.day != b.day {
            return day_field
        }
    }
    if a.has_time && b.has_time {
        if (a.hour / 12) != (b.hour / 12) {
            return period_field
        }
        if a.hour % 12 != b.hour % 12 {
            return hour_field
        }
        if a.minute != b.minute {
            return minute_field
        }
        if a.second != b.second {
            return second_field
        }
    }
    -1
}

fn field_level(field: i64) -> i64 {
    match field {
        == era_field => 0
        == year_field => 1
        == quarter_field => 2
        == month_field => 2
        == week_of_year_field => 3
        == week_of_month_field => 3
        == weekday_field => 3
        == day_of_year_field => 3
        == weekday_in_month_field => 3
        == day_field => 3
        == period_field => 4
        == hour_field => 5
        == minute_field => 6
        == second_field => 7
        == fraction_field => 8
        _ => 9
    }
}

fn is_ignored(skeleton: Skeleton, field: i64) -> bool {
    let level = field_level(field)
    for i in 0..field_count {
        if skeleton.letters[i] != 0 && i != zone_field && level <= field_level(i) {
            return false
        }
    }
    true
}

fn difference_letter(field: i64, hour: u8) -> str {
    match field {
        == era_field => "G"
        == year_field => "y"
        == month_field => "M"
        == day_field => "d"
        == period_field => "a"
        == hour_field => if hour == 'H' || hour == 'k' { "H" } else { "h" }
        == minute_field => "m"
        _ => "s"
    }
}

fn interval_rules(l: locale.Locale, letter: str) -> []IntervalRule {
    var out: []IntervalRule = []
    var seen: []str = []
    for blob in locale.entries(l, data.group_date_interval, 1) {
        for line in text.lines(blob) {
            let parts = text.split(line, '\t')
            if parts.len != 3 || parts[1] != letter || index_of(seen, parts[0]) >= 0 {
                continue
            }
            push(mut seen, parts[0])
            push(mut out, IntervalRule { skeleton: skeleton_of_tokens(tokenize(parts[0], false)), pattern: tokenize(parts[2], false) })
        }
    }
    out
}

fn same_letters(a: Skeleton, b: Skeleton) -> bool {
    for i in 0..field_count {
        if a.letters[i] != b.letters[i] {
            return false
        }
    }
    true
}

fn adjust_interval(tokens: []Token, request: Skeleton, matched: Skeleton) -> []Token {
    var out: []Token = []
    for t in tokens {
        if t.kind != TokenKind.Field {
            push(mut out, t)
            continue
        }
        match letter_info(t.letter, t.length) {
            some(info) => {
                if info.kind < 0 && t.letter == request.letters[info.field] {
                    for piece in adjust([t], request, matched) {
                        push(mut out, piece)
                    }
                } else if info.field == year_field && request.lengths[year_field] == 2 && t.letter == 'y' {
                    push(mut out, field_token('y', 2))
                } else {
                    push(mut out, t)
                }
            }
            none => push(mut out, t)
        }
    }
    out
}

fn interval_pattern(l: locale.Locale, request: Skeleton, field: i64) -> []Token? {
    let rules = interval_rules(l, difference_letter(field, request.letters[hour_field]))
    var best: IntervalRule? = none
    var best_value = 2147483647
    for r in rules {
        let d = distance(request, all_mask, r.skeleton)
        if d.missing != 0 || d.extra != 0 || d.value >= best_value || !same_letters(request, r.skeleton) {
            continue
        }
        best = r
        best_value = d.value
    }
    match best {
        some(r) => {
            if best_value == 0 {
                return r.pattern
            }
            adjust_interval(r.pattern, request, r.skeleton)
        }
        none => none
    }
}

struct Halves {
    first: []Token
    second: []Token
}

fn contains_letter(letters: []u8, c: u8) -> bool {
    for x in letters {
        if x == c {
            return true
        }
    }
    false
}

fn split_halves(tokens: []Token) -> Halves {
    var first: []Token = []
    var second: []Token = []
    var seen: []u8 = []
    var split = false
    for t in tokens {
        if !split && t.kind == TokenKind.Field && contains_letter(seen, t.letter) {
            split = true
        }
        if split {
            push(mut second, t)
        } else {
            push(mut first, t)
            if t.kind == TokenKind.Field {
                push(mut seen, t.letter)
            }
        }
    }
    Halves { first, second }
}

fn fallback_text(l: locale.Locale, first: str, second: str) -> str {
    let pattern = locale.entry(l, data.group_date_interval, 0) ?? "{{0}} - {{1}}"
    replace_in_order(pattern, first, second, "")
}

fn render_halves(l: locale.Locale, h: Halves, a: Moment, b: Moment) -> str {
    let one = render(l, h.first, a)
    let two = render(l, h.second, b)
    "{one}{two}"
}

fn masked(s: Skeleton, mask: i64) -> Skeleton {
    var out = empty_skeleton()
    for i in 0..field_count {
        if (mask & (1 << i)) != 0 {
            out.letters[i] = s.letters[i]
            out.lengths[i] = s.lengths[i]
            out.kinds[i] = s.kinds[i]
        }
    }
    out
}

fn glued_text(l: locale.Locale, request: Skeleton, date_text: str, time_text: str) -> str {
    let glue = glue_pattern(l, glue_style(request))
    replace_in_order(glue, time_text, date_text, "")
}

fn single_pair(l: locale.Locale, tokens: []Token, a: Moment, b: Moment) -> str {
    fallback_text(l, render(l, tokens, a), render(l, tokens, b))
}

fn dated_pair(l: locale.Locale, r: Resolved, a: Moment, b: Moment) -> str {
    single_pair(l, best_tokens(l, with_full_date(r.skeleton)), a, b)
}

fn format_one_kind(l: locale.Locale, request: Skeleton, tokens: []Token, field: i64, a: Moment, b: Moment) -> str {
    match interval_pattern(l, request, field) {
        some(p) => return render_halves(l, split_halves(p), a, b)
        none => {}
    }
    let extended = with_date_fields(request, field)
    if field_mask(extended) != field_mask(request) {
        match interval_pattern(l, extended, field) {
            some(p) => return render_halves(l, split_halves(p), a, b)
            none => {}
        }
    }
    single_pair(l, tokens, a, b)
}

fn format_both_kinds(l: locale.Locale, request: Skeleton, tokens: []Token, field: i64, a: Moment, b: Moment) -> str {
    if field_level(field) < field_level(period_field) {
        return single_pair(l, tokens, a, b)
    }
    let time_request = masked(request, time_mask)
    let date_tokens = best_tokens(l, masked(request, date_mask))
    let date_text = render(l, date_tokens, a)
    match interval_pattern(l, time_request, field) {
        some(p) => glued_text(l, request, date_text, render_halves(l, split_halves(p), a, b))
        none => {
            let time_tokens = best_tokens(l, time_request)
            glued_text(l, request, date_text, single_pair(l, time_tokens, a, b))
        }
    }
}

fn copy_skeleton(s: Skeleton) -> Skeleton {
    masked(s, all_mask)
}

fn set_numeric(mut s: Skeleton, field: i64, letter: u8) {
    s.letters[field] = letter
    s.lengths[field] = 1
    s.kinds[field] = numeric_kind(0, 1)
}

fn with_date_fields(request: Skeleton, field: i64) -> Skeleton {
    var out = copy_skeleton(request)
    let level = field_level(field)
    var largest = 9
    for i in 0..field_count {
        if request.letters[i] != 0 && (date_mask & (1 << i)) != 0 && field_level(i) < largest {
            largest = field_level(i)
        }
    }
    if level <= 1 && largest > 1 && out.letters[year_field] == 0 {
        set_numeric(mut out, year_field, 'y')
    }
    if level <= 2 && largest > 2 && out.letters[month_field] == 0 {
        set_numeric(mut out, month_field, 'M')
    }
    out
}

fn with_full_date(request: Skeleton) -> Skeleton {
    var out = copy_skeleton(request)
    set_numeric(mut out, year_field, 'y')
    set_numeric(mut out, month_field, 'M')
    set_numeric(mut out, day_field, 'd')
    out
}

fn resolve_range(l: locale.Locale, o: Options) -> Resolved ! Error {
    let tokens = resolve_tokens(l, o)?
    var skeleton = skeleton_of_tokens(tokens)
    skeleton.letters[period_field] = 0
    skeleton.lengths[period_field] = 0
    skeleton.kinds[period_field] = 0
    Resolved { skeleton, tokens }
}

/// Formats the span from `a` to `b` for `l` as `o` asks, such as the range from March 5 to March 10, 2024 written with the month and year once.
///
/// The pattern that `format` would print for one value gives the fields to keep, and the fields that differ choose the interval pattern. The interval patterns of the locale hold a field once when it is the same on both ends. The nearest pattern by field distance is adjusted to the lengths asked for. A pair with no pattern for its greatest differing field is the two single formats joined by the fallback pattern of the locale. A skeleton with a date and a time prints the date once when only the time differs. Values equal at every field of the pattern print once. Fails as `format` does.
pub fn format_range(l: locale.Locale, a: Moment, b: Moment, o: Options) -> str ! Error {
    let resolved = resolve_range(l, o)?
    check(resolved.tokens, a)?
    check(resolved.tokens, b)?
    let field = greatest_difference(a, b)
    if field < 0 || is_ignored(resolved.skeleton, field) {
        return render(l, resolved.tokens, a)
    }
    let mask = field_mask(resolved.skeleton)
    if (mask & date_mask) == 0 && field_level(field) < field_level(period_field) {
        return dated_pair(l, resolved, a, b)
    }
    if (mask & date_mask) != 0 && (mask & time_mask) != 0 {
        return format_both_kinds(l, resolved.skeleton, resolved.tokens, field, a, b)
    }
    format_one_kind(l, resolved.skeleton, resolved.tokens, field, a, b)
}
