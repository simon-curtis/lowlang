const field_count = 16
const era_field = 0
const year_field = 1
const quarter_field = 2
const month_field = 3
const week_of_year_field = 4
const week_of_month_field = 5
const weekday_field = 6
const day_of_year_field = 7
const weekday_in_month_field = 8
const day_field = 9
const period_field = 10
const hour_field = 11
const minute_field = 12
const second_field = 13
const fraction_field = 14
const zone_field = 15

const date_mask = 1023
const time_mask = 64512
const all_mask = 65535

const extra_distance = 65536
const missing_distance = 4096

struct Skeleton {
    letters: []u8
    lengths: []i64
    kinds: []i64
}

struct Letter {
    field: i64
    kind: i64
}

fn empty_skeleton() -> Skeleton {
    var letters: []u8 = []
    var lengths: []i64 = []
    var kinds: []i64 = []
    for i in 0..field_count {
        push(mut letters, 0)
        push(mut lengths, 0)
        push(mut kinds, 0)
    }
    Skeleton { letters, lengths, kinds }
}

fn text_kind(length: i64, offset: i64, shorter: bool) -> i64 {
    var base = -259
    if length == 4 {
        base = -260
    } else if length == 5 {
        base = -257
    } else if length >= 6 {
        base = if shorter { -258 } else { -257 }
    }
    base - offset * 16
}

fn numeric_kind(offset: i64, length: i64) -> i64 {
    256 + offset * 16 + length
}

fn numeric_or_text(length: i64, offset: i64) -> i64 {
    if length <= 2 {
        return numeric_kind(offset, length)
    }
    text_kind(length, offset, false)
}

fn zone_kind(letter: u8, length: i64) -> i64 {
    match letter {
        'z' => text_kind(if length >= 4 { 4 } else { 1 }, 0, false)
        'v' => text_kind(if length >= 4 { 4 } else { 1 }, 2, false)
        'Z' => if length <= 3 { text_kind(5, 1, false) } else if length == 4 { text_kind(4, 1, false) } else { text_kind(1, 1, false) }
        'O' => text_kind(if length >= 4 { 4 } else { 1 }, 1, false)
        'V' => text_kind(if length == 2 { 4 } else { 1 }, 1, false)
        _ => if length == 1 { text_kind(5, 1, false) } else if length == 2 { text_kind(1, 1, false) } else { text_kind(4, 1, false) }
    }
}

fn letter_info(c: u8, length: i64) -> Letter? {
    match c {
        'G' => Letter { field: era_field, kind: text_kind(length, 0, false) }
        'y' => Letter { field: year_field, kind: numeric_kind(0, length) }
        'Y' => Letter { field: year_field, kind: numeric_kind(1, length) }
        'u' => Letter { field: year_field, kind: numeric_kind(2, length) }
        'r' => Letter { field: year_field, kind: numeric_kind(3, length) }
        'Q' => Letter { field: quarter_field, kind: numeric_or_text(length, 0) }
        'q' => Letter { field: quarter_field, kind: numeric_or_text(length, 1) }
        'M' => Letter { field: month_field, kind: numeric_or_text(length, 0) }
        'L' => Letter { field: month_field, kind: numeric_or_text(length, 1) }
        'w' => Letter { field: week_of_year_field, kind: numeric_kind(0, length) }
        'W' => Letter { field: week_of_month_field, kind: numeric_kind(0, length) }
        'E' => Letter { field: weekday_field, kind: text_kind(length, 0, true) }
        'e' => Letter { field: weekday_field, kind: if length <= 2 { numeric_kind(1, length) } else { text_kind(length, 1, true) } }
        'c' => Letter { field: weekday_field, kind: if length <= 2 { numeric_kind(2, length) } else { text_kind(length, 2, true) } }
        'D' => Letter { field: day_of_year_field, kind: numeric_kind(0, length) }
        'F' => Letter { field: weekday_in_month_field, kind: numeric_kind(0, length) }
        'd' => Letter { field: day_field, kind: numeric_kind(0, length) }
        'g' => Letter { field: day_field, kind: numeric_kind(1, length) }
        'a' => Letter { field: period_field, kind: text_kind(length, 0, false) }
        'b' => Letter { field: period_field, kind: text_kind(length, 1, false) }
        'B' => Letter { field: period_field, kind: text_kind(length, 2, false) }
        'H' => Letter { field: hour_field, kind: numeric_kind(10, length) }
        'k' => Letter { field: hour_field, kind: numeric_kind(11, length) }
        'h' => Letter { field: hour_field, kind: numeric_kind(0, length) }
        'K' => Letter { field: hour_field, kind: numeric_kind(1, length) }
        'm' => Letter { field: minute_field, kind: numeric_kind(0, length) }
        's' => Letter { field: second_field, kind: numeric_kind(0, length) }
        'A' => Letter { field: second_field, kind: numeric_kind(1, length) }
        'S' => Letter { field: fraction_field, kind: numeric_kind(0, length) }
        'z' => Letter { field: zone_field, kind: zone_kind(c, length) }
        'v' => Letter { field: zone_field, kind: zone_kind(c, length) }
        'Z' => Letter { field: zone_field, kind: zone_kind(c, length) }
        'O' => Letter { field: zone_field, kind: zone_kind(c, length) }
        'V' => Letter { field: zone_field, kind: zone_kind(c, length) }
        'X' => Letter { field: zone_field, kind: zone_kind(c, length) }
        'x' => Letter { field: zone_field, kind: zone_kind(c, length) }
        _ => none
    }
}

fn skeleton_of_tokens(tokens: []Token) -> Skeleton {
    var s = empty_skeleton()
    for t in tokens {
        if t.kind != TokenKind.Field {
            continue
        }
        match letter_info(t.letter, t.length) {
            some(info) => {
                s.letters[info.field] = t.letter
                s.lengths[info.field] = t.length
                s.kinds[info.field] = info.kind
            }
            none => {}
        }
    }
    s
}

fn field_mask(s: Skeleton) -> i64 {
    var mask = 0
    for i in 0..field_count {
        if s.letters[i] != 0 {
            mask = mask | (1 << i)
        }
    }
    mask
}

struct Distance {
    value: i64
    missing: i64
    extra: i64
}

fn distance(request: Skeleton, include: i64, candidate: Skeleton) -> Distance {
    var value = 0
    var missing = 0
    var extra = 0
    for i in 0..field_count {
        let mine = if (include & (1 << i)) == 0 { 0 } else { request.kinds[i] }
        let other = candidate.kinds[i]
        if mine == other {
            continue
        }
        if mine == 0 {
            value += extra_distance
            extra = extra | (1 << i)
        } else if other == 0 {
            value += missing_distance
            missing = missing | (1 << i)
        } else {
            let d = mine - other
            value += if d < 0 { -d } else { d }
        }
    }
    Distance { value, missing, extra }
}

fn top_bit(mask: i64) -> i64 {
    var n = -1
    for i in 0..field_count {
        if (mask & (1 << i)) != 0 {
            n = i
        }
    }
    n
}
