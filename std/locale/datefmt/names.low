import std/locale
import std/locale/data
import std/locale/numfmt
import std/text

fn width_index(length: i64) -> i64 {
    if length == 4 {
        return 0
    }
    if length == 5 {
        return 2
    }
    1
}

fn widths_from(w: i64) -> i64[] {
    if w == 0 {
        return [0, 1, 2]
    }
    if w == 1 {
        return [1, 0, 2]
    }
    [2, 1, 0]
}

fn named(l: locale.Locale, group: i64, contexts: i64, widths: i64, count: i64, standalone: bool, width: i64, item: i64) -> str {
    let first = if standalone { 1 } else { 0 }
    for w in widths_from(width) {
        if w >= widths {
            continue
        }
        let preferred = (first * widths + w) * count
        let other = ((1 - first) * widths + w) * count
        match locale.entry_of_rows(l, group, preferred, other, count, item) {
            some(v) => return v
            none => {}
        }
    }
    ""
}

fn month_name(l: locale.Locale, month: i64, length: i64, standalone: bool) -> str {
    named(l, data.group_months, 2, 3, 12, standalone, width_index(length), month - 1)
}

fn quarter_name(l: locale.Locale, quarter: i64, length: i64, standalone: bool) -> str {
    named(l, data.group_quarters, 2, 3, 4, standalone, width_index(length), quarter - 1)
}

fn weekday_name(l: locale.Locale, sunday_based: i64, length: i64, standalone: bool) -> str {
    let first = if standalone { 1 } else { 0 }
    var wanted = width_index(length)
    if length >= 6 {
        wanted = 3
    }
    let order = if wanted == 3 { [3, 1, 0, 2] } else if wanted == 0 { [0, 1, 2] } else if wanted == 1 { [1, 0, 2] } else { [2, 1, 0] }
    for w in order {
        let preferred = (first * 4 + w) * 7
        let other = ((1 - first) * 4 + w) * 7
        match locale.entry_of_rows(l, data.group_days, preferred, other, 7, sunday_based) {
            some(v) => return v
            none => {}
        }
    }
    ""
}

fn era_name(l: locale.Locale, common: bool, length: i64) -> str {
    let kind = if common { 1 } else { 0 }
    for w in widths_from(width_index(length)) {
        match locale.entry(l, data.group_eras, w * 2 + kind) {
            some(v) => return v
            none => {}
        }
    }
    ""
}

fn period_name(l: locale.Locale, period: i64, length: i64, standalone: bool) -> str {
    let first = if standalone { 1 } else { 0 }
    for w in widths_from(width_index(length)) {
        let preferred = (first * 3 + w) * 12
        let other = ((1 - first) * 3 + w) * 12
        match locale.entry_of_rows(l, data.group_day_periods, preferred, other, 12, period) {
            some(v) => return v
            none => {}
        }
    }
    ""
}

fn flexible_period(l: locale.Locale, minutes: i64, exact: bool) -> i64 {
    let names = text.fields("am pm midnight noon morning1 morning2 afternoon1 afternoon2 evening1 evening2 night1 night2")
    var ids: str[] = []
    for id in locale.chain(l) {
        if id != "root" {
            ids.push(id)
        }
    }
    ids.push(l.language)
    ids.push("root")
    for id in ids {
        let rows = locale.lookup_all(data.dayperiod_table(), id)
        if rows.len == 0 {
            continue
        }
        for row in rows {
            let f = text.fields(row)
            if f.len < 3 {
                continue
            }
            let from = text.parse_int(f[1]) or continue
            let to = text.parse_int(f[2]) or continue
            let hit = match from {
                (to) => exact && minutes == from
                < to => minutes >= from && minutes < to
                _ => minutes >= from || minutes < to
            }
            if hit {
                for i, n in names {
                    if n == f[0] {
                        return i
                    }
                }
            }
        }
        break
    }
    if minutes < 720 { 0 } else { 1 }
}

fn pad(l: locale.Locale, n: i64, length: i64) -> str {
    var digits = "{n}"
    var sign = ""
    if n < 0 {
        sign = "-"
        digits = "{-n}"
    }
    if digits.len < length {
        digits = "{text.repeat("0", length - digits.len)}{digits}"
    }
    "{sign}{numfmt.localize_digits(l, digits)}"
}

struct Week {
    number: i64
    year: i64
}

fn is_leap(y: i64) -> bool {
    (y % 4 == 0 && y % 100 != 0) || y % 400 == 0
}

fn year_days(y: i64) -> i64 {
    if is_leap(y) { 366 } else { 365 }
}

fn weekday_of_jan_first(year: i64, day_of_year: i64, sunday_based: i64) -> i64 {
    ((sunday_based - (day_of_year - 1)) % 7 + 7) % 7
}

fn first_week_start(jan_first: i64, first_day: i64, min_days: i64) -> i64 {
    let offset = (jan_first - first_day + 7) % 7
    if 7 - offset >= min_days {
        return -offset
    }
    7 - offset
}

fn week_of_year(year: i64, day_of_year: i64, sunday_based: i64, first_day: i64, min_days: i64) -> Week {
    let jan_first = weekday_of_jan_first(year, day_of_year, sunday_based)
    let index = day_of_year - 1
    let start = first_week_start(jan_first, first_day, min_days)
    if index < start {
        let previous = year_days(year - 1)
        let previous_jan = ((jan_first - previous) % 7 + 7) % 7
        let previous_start = first_week_start(previous_jan, first_day, min_days)
        return Week { number: (previous + index - previous_start) / 7 + 1, year: year - 1 }
    }
    let length = year_days(year)
    let next_jan = (jan_first + length) % 7
    let next_start = length + first_week_start(next_jan, first_day, min_days)
    if index >= next_start {
        return Week { number: 1, year: year + 1 }
    }
    Week { number: (index - start) / 7 + 1, year }
}

fn week_of_month(day: i64, sunday_based: i64, first_day: i64, min_days: i64) -> i64 {
    let first_of_month = ((sunday_based - (day - 1)) % 7 + 7) % 7
    let start = first_week_start(first_of_month, first_day, min_days)
    let index = day - 1
    if index < start {
        return 0
    }
    (index - start) / 7 + 1
}

fn region_of(l: locale.Locale) -> str {
    if l.region != "" {
        return l.region
    }
    locale.maximize(l).region
}

struct WeekRule {
    first_day: i64
    min_days: i64
}

fn day_number(name: str) -> i64 {
    let names = text.fields("sun mon tue wed thu fri sat")
    for i, n in names {
        if n == name {
            return i
        }
    }
    1
}

fn week_rule(l: locale.Locale) -> WeekRule {
    let region = region_of(l)
    let first = locale.lookup(data.week_table(), "f:{region}") ?? locale.lookup(data.week_table(), "f:001") ?? "mon"
    let minimum = locale.lookup(data.week_table(), "m:{region}") ?? locale.lookup(data.week_table(), "m:001") ?? "1"
    WeekRule { first_day: day_number(first), min_days: text.parse_int(minimum) or 1 }
}

fn preferred_hour(l: locale.Locale) -> u8 {
    match l.hour_cycle {
        "h11" => return 'K'
        "h12" => return 'h'
        "h23" => return 'H'
        "h24" => return 'k'
        _ => {}
    }
    let region = region_of(l)
    let row = locale.lookup(data.week_table(), "h:{l.language}-{region}") ?? locale.lookup(data.week_table(), "h:{region}") ?? locale.lookup(data.week_table(), "h:001") ?? "H"
    let f = text.fields(row)
    if f.len == 0 {
        return 'H'
    }
    f[0][0]
}
