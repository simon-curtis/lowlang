import std/builder

enum TokenKind {
    Literal
    Field
    Slot
}

struct Token {
    kind: TokenKind
    letter: u8
    length: i64
    literal: str
    slot: i64
}

fn is_letter(c: u8) -> bool {
    (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
}

fn literal_token(s: str) -> Token {
    Token { kind: TokenKind.Literal, letter: 0, length: 0, literal: s, slot: 0 }
}

fn field_token(letter: u8, length: i64) -> Token {
    Token { kind: TokenKind.Field, letter, length, literal: "", slot: 0 }
}

fn slot_token(slot: i64) -> Token {
    Token { kind: TokenKind.Slot, letter: 0, length: 0, literal: "", slot }
}

fn flush_literal(mut out: Token[], mut pending: builder.Builder) {
    if builder.len(pending) > 0 {
        out.push(literal_token(builder.to_str(pending)))
        builder.reset(mut pending)
    }
}

fn tokenize(pattern: str, slots: bool) -> Token[] {
    var out: Token[] = []
    var pending = builder.builder()
    var i = 0
    for i < pattern.len {
        let c = pattern[i]
        if c == '\'' {
            if i + 1 < pattern.len && pattern[i + 1] == '\'' {
                builder.write_byte(mut pending, '\'')
                i += 2
                continue
            }
            i += 1
            for i < pattern.len {
                if pattern[i] == '\'' {
                    if i + 1 < pattern.len && pattern[i + 1] == '\'' {
                        builder.write_byte(mut pending, '\'')
                        i += 2
                        continue
                    }
                    i += 1
                    break
                }
                builder.write_byte(mut pending, pattern[i])
                i += 1
            }
            continue
        }
        if slots && c == '{' && i + 2 < pattern.len && pattern[i + 2] == '}' && (pattern[i + 1] == '0' || pattern[i + 1] == '1') {
            flush_literal(mut out, mut pending)
            out.push(slot_token(i64(pattern[i + 1]) - i64('0')))
            i += 3
            continue
        }
        if is_letter(c) {
            flush_literal(mut out, mut pending)
            var j = i
            for j < pattern.len && pattern[j] == c {
                j += 1
            }
            out.push(field_token(c, j - i))
            i = j
            continue
        }
        builder.write_byte(mut pending, c)
        i += 1
    }
    flush_literal(mut out, mut pending)
    out
}

fn needs_quotes(s: str) -> bool {
    for c in s {
        if c == '\'' || (c < 128 && is_letter(u8(c))) {
            return true
        }
    }
    false
}

fn serialize(tokens: Token[]) -> str {
    var out = builder.builder()
    for t in tokens {
        match t.kind {
            Field => builder.write(mut out, text_repeat(t.letter, t.length))
            Slot => builder.write(mut out, "{{{t.slot}}}")
            Literal => {
                if needs_quotes(t.literal) {
                    builder.write_byte(mut out, '\'')
                    for c in t.literal {
                        if c == '\'' {
                            builder.write(mut out, "''")
                        } else {
                            builder.write_char(mut out, c)
                        }
                    }
                    builder.write_byte(mut out, '\'')
                } else {
                    builder.write(mut out, t.literal)
                }
            }
        }
    }
    builder.to_str(out)
}

fn text_repeat(letter: u8, n: i64) -> str {
    var out = builder.builder()
    for i in 0..n {
        builder.write_byte(mut out, letter)
    }
    builder.to_str(out)
}

fn substitute(glue: Token[], date: Token[], time: Token[]) -> Token[] {
    var out: Token[] = []
    for t in glue {
        if t.kind == TokenKind.Slot {
            let part = if t.slot == 0 { time } else { date }
            for p in part {
                out.push(p)
            }
        } else {
            out.push(t)
        }
    }
    out
}
