import std/locale
import std/locale/data
import std/locale/numfmt
import std/text

struct Candidate {
    skeleton: Skeleton
    tokens: []Token
    order: i64
}

struct Found {
    candidate: Candidate
    missing: i64
    extra: i64
}

fn sorted(lines: []str) -> []str {
    var out: []str = []
    for line in lines {
        var at = out.len
        for at > 0 && out[at - 1] > line {
            at -= 1
        }
        insert_line(mut out, at, line)
    }
    out
}

fn insert_line(mut out: []str, at: i64, line: str) {
    push(mut out, line)
    var i = out.len - 1
    for i > at {
        out[i] = out[i - 1]
        i -= 1
    }
    out[at] = line
}

fn first_letter_order(s: Skeleton) -> i64 {
    for i in 0..field_count {
        let c = s.letters[i]
        if c != 0 {
            if c >= 'A' && c <= 'Z' {
                return i64(c) - i64('A')
            }
            return 26 + i64(c) - i64('a')
        }
    }
    52
}

fn skeleton_key(s: Skeleton) -> str {
    var out = ""
    for i in 0..field_count {
        if s.letters[i] != 0 {
            out = "{out}{text.from_char(u32(s.letters[i]))}{s.lengths[i]}"
        }
    }
    out
}

fn base_key(s: Skeleton) -> str {
    var out = ""
    for i in 0..field_count {
        if s.letters[i] != 0 {
            let kind = if s.kinds[i] > 0 { s.kinds[i] - s.lengths[i] } else { s.kinds[i] }
            out = "{out}{text.from_char(u32(s.letters[i]))}{kind}"
        }
    }
    out
}

struct Pool {
    items: []Candidate
    keys: []str
    specified: []str
}

fn index_of(keys: []str, key: str) -> i64 {
    for i, k in keys {
        if k == key {
            return i
        }
    }
    -1
}

fn add_derived(p: *Pool, skeleton: Skeleton, tokens: []Token) {
    let key = skeleton_key(skeleton)
    if index_of(p.keys, key) >= 0 {
        return
    }
    push(mut p.keys, key)
    push(mut p.items, Candidate { skeleton, tokens, order: first_letter_order(skeleton) })
}

fn add_specified(p: *Pool, skeleton: Skeleton, tokens: []Token) {
    let key = skeleton_key(skeleton)
    if index_of(p.specified, key) >= 0 {
        return
    }
    push(mut p.specified, key)
    let at = index_of(p.keys, key)
    if at < 0 {
        push(mut p.keys, key)
        push(mut p.items, Candidate { skeleton, tokens, order: first_letter_order(skeleton) })
        return
    }
    p.items[at] = Candidate { skeleton, tokens, order: first_letter_order(skeleton) }
}

fn canonical_letters() -> []str {
    ["G", "y", "Q", "M", "w", "W", "E", "D", "F", "d", "a", "H", "m", "s", "S", "v"]
}

fn add_available(l: locale.Locale, p: *Pool) {
    for blob in locale.entries(l, data.group_date_available, 0) {
        for line in sorted(text.lines(blob)) {
            let cut = text.cut(line, "\t")
            let skeleton = skeleton_of_tokens(tokenize(cut.before, false))
            add_specified(p, skeleton, tokenize(cut.after, false))
        }
    }
}

fn add_standard(l: locale.Locale, p: *Pool) {
    var bases: []str = []
    for slot in 0..8 {
        let pattern = locale.entry(l, data.group_date_formats, slot) ?? continue
        let tokens = tokenize(pattern, false)
        let skeleton = skeleton_of_tokens(tokens)
        if skeleton.letters[period_field] == 'a' {
            skeleton.letters[period_field] = 0
            skeleton.lengths[period_field] = 0
            skeleton.kinds[period_field] = 0
        }
        let base = base_key(skeleton)
        if index_of(bases, base) >= 0 {
            continue
        }
        push(mut bases, base)
        add_derived(p, skeleton, tokens)
    }
}

fn candidates(l: locale.Locale) -> []Candidate {
    let p = new(Pool { items: [], keys: [], specified: [] })
    for letter in canonical_letters() {
        let tokens = tokenize(letter, false)
        add_derived(p, skeleton_of_tokens(tokens), tokens)
    }
    add_standard(l, p)
    add_available(l, p)
    let out = p.items
    var ordered: []Candidate = []
    for rank in 0..53 {
        for c in out {
            if c.order == rank {
                push(mut ordered, c)
            }
        }
    }
    ordered
}

fn best_raw(all: []Candidate, request: Skeleton, include: i64) -> Found {
    var best = all[0]
    var best_value = 2147483647
    var missing = 0
    var extra = 0
    for c in all {
        let d = distance(request, include, c.skeleton)
        if d.value < best_value {
            best = c
            best_value = d.value
            missing = d.missing
            extra = d.extra
            if d.value == 0 {
                break
            }
        }
    }
    Found { candidate: best, missing, extra }
}

fn adjust(tokens: []Token, request: Skeleton, matched: Skeleton) -> []Token {
    var out: []Token = []
    for t in tokens {
        if t.kind != TokenKind.Field {
            push(mut out, t)
            continue
        }
        let known = letter_info(t.letter, t.length)
        if known == none {
            push(mut out, t)
            continue
        }
        let info = known ?? Letter { field: 0, kind: 0 }
        let requested_length = request.lengths[info.field]
        if requested_length == 0 {
            push(mut out, t)
            continue
        }
        let requested_letter = request.letters[info.field]
        var length = requested_length
        if info.field == minute_field || info.field == second_field {
            length = t.length
        } else if requested_letter != 'c' && requested_letter != 'e' {
            let skeleton_length = matched.lengths[info.field]
            let pattern_numeric = info.kind > 0
            let skeleton_numeric = matched.kinds[info.field] > 0
            if skeleton_length == requested_length || pattern_numeric != skeleton_numeric {
                length = t.length
            }
        }
        var letter = t.letter
        let keeps = info.field == hour_field || info.field == month_field || info.field == weekday_field || (info.field == year_field && requested_letter != 'Y')
        if !keeps {
            letter = requested_letter
        }
        push(mut out, field_token(letter, length))
    }
    out
}

fn append_format(field: i64) -> str {
    if field == era_field || field == year_field || field == weekday_field || field == zone_field {
        return "{{0}} {{1}}"
    }
    "{{0}} ({{2}}: {{1}})"
}

fn field_display_name(l: locale.Locale, field: i64) -> str {
    let fields = [second_field, minute_field, hour_field, day_field, week_of_year_field, month_field, quarter_field, year_field]
    for i, f in fields {
        if f == field {
            return locale.entry(l, data.group_relative + i * 3, 0) ?? ""
        }
    }
    ""
}

fn replace_in_order(pattern: str, first: str, second: str, name: str) -> str {
    let one = text.from_char(1)
    let two = text.from_char(2)
    var out = text.replace(pattern, "{{0}}", one)
    out = text.replace(out, "{{1}}", two)
    out = text.replace(out, "{{2}}", name)
    out = text.replace(out, one, first)
    text.replace(out, two, second)
}

fn best_appending(l: locale.Locale, all: []Candidate, request: Skeleton, wanted: i64) -> []Token {
    var empty: []Token = []
    if wanted == 0 {
        return empty
    }
    var found = best_raw(all, request, wanted)
    var result = adjust(found.candidate.tokens, request, found.candidate.skeleton)
    var missing = found.missing
    var last = 0
    for missing != 0 {
        if last == missing {
            break
        }
        if (missing & (second_mask() | fraction_mask())) == fraction_mask() && (wanted & (second_mask() | fraction_mask())) == (second_mask() | fraction_mask()) {
            result = fix_fraction(l, result, request.lengths[fraction_field])
            missing = missing - fraction_mask()
            continue
        }
        let before = missing
        found = best_raw(all, request, missing)
        let piece = adjust(found.candidate.tokens, request, found.candidate.skeleton)
        let covered = before - found.missing
        let top = top_bit(covered)
        let pattern = append_format(top)
        let first = serialize(result)
        let second = serialize(piece)
        result = tokenize(replace_in_order(pattern, first, second, field_display_name(l, top)), false)
        last = found.missing
        missing = found.missing
    }
    result
}

fn second_mask() -> i64 {
    1 << second_field
}

fn fraction_mask() -> i64 {
    1 << fraction_field
}

fn fix_fraction(l: locale.Locale, tokens: []Token, digits: i64) -> []Token {
    var out: []Token = []
    let point = numfmt.decimal_separator(l)
    for t in tokens {
        push(mut out, t)
        if t.kind == TokenKind.Field && t.letter == 's' {
            push(mut out, literal_token(point))
            push(mut out, field_token('S', digits))
        }
    }
    out
}

fn glue_style(request: Skeleton) -> i64 {
    let month_length = request.lengths[month_field]
    if month_length == 4 {
        if request.lengths[weekday_field] > 0 {
            return 0
        }
        return 1
    }
    if month_length == 3 {
        return 2
    }
    3
}

fn glue_pattern(l: locale.Locale, style: i64) -> str {
    locale.entry(l, data.group_date_formats, 12 + style) ?? locale.entry(l, data.group_date_formats, 8 + style) ?? "{{1}} {{0}}"
}

fn best_tokens(l: locale.Locale, request: Skeleton) -> []Token {
    let all = candidates(l)
    let found = best_raw(all, request, all_mask)
    if found.missing == 0 && found.extra == 0 {
        return adjust(found.candidate.tokens, request, found.candidate.skeleton)
    }
    let needed = field_mask(request)
    let date = best_appending(l, all, request, needed & date_mask)
    let time = best_appending(l, all, request, needed & time_mask)
    if date.len == 0 {
        return time
    }
    if time.len == 0 {
        return date
    }
    substitute(tokenize(glue_pattern(l, glue_style(request)), true), date, time)
}
