import std/locale
import std/locale/datefmt
import std/time/datetime

fn show(tag: str, m: datefmt.Moment, o: datefmt.Options) {
    let l = locale.parse(tag) or locale.root()
    print("{tag}: {datefmt.format(l, m, o) or "?"}")
}

fn main() {
    let start = datefmt.from_datetime(datetime.of(2024, 3, 5, 15, 45, 30, 0) or datetime.epoch())
    let end = datefmt.from_datetime(datetime.of(2024, 3, 10, 9, 5, 0, 0) or datetime.epoch())
    var long_date = datefmt.options()
    long_date.date_style = datefmt.Length.Full
    show("en", start, long_date)
    show("de", start, long_date)
    show("ja", start, long_date)
    var skeleton = datefmt.options()
    skeleton.skeleton = "yMMMdjm"
    show("en", start, skeleton)
    show("en-GB", start, skeleton)
    show("fr", start, skeleton)
    var month_day = datefmt.options()
    month_day.skeleton = "yMMMd"
    let range = datefmt.format_range(locale.parse("en") or locale.root(), start, end, month_day) or "?"
    print("en: {range}")
    let range_de = datefmt.format_range(locale.parse("de") or locale.root(), start, end, month_day) or "?"
    print("de: {range_de}")
}
