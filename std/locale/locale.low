import std/locale/data
import std/slices
import std/text

/// Why a locale identifier could not be read.
pub enum Error {
    /// The identifier is empty.
    Empty
    /// A subtag is malformed or out of place. `subtag` is the offending text.
    Malformed(subtag: str)
}

/// A BCP 47 language tag with the Unicode extension keys `nu`, `ca`, `co`, `hc` and `cu`, and the CLDR data that formatting reads.
///
/// `language` is `und` when the tag names none. `script` and `region` are empty when absent. The key fields are empty when the tag does not set them. `blobs` is the data of the locale and its parents, most specific first.
pub struct Locale {
    /// The lower-case language subtag.
    pub language: str
    /// The title-case script subtag, or empty.
    pub script: str
    /// The upper-case region subtag, or empty.
    pub region: str
    /// The lower-case variant subtags in sorted order.
    pub variants: str[]
    /// The `nu` key: the numbering system, such as `arab`, or empty.
    pub numbering: str
    /// The `ca` key: the calendar, or empty.
    pub calendar: str
    /// The `co` key: the collation type, or empty.
    pub collation: str
    /// The `hc` key: the hour cycle, one of `h11`, `h12`, `h23` and `h24`, or empty.
    pub hour_cycle: str
    /// The `cu` key: the currency code, lower case, or empty.
    pub currency: str
    /// The data blobs of the locale and its parents, most specific first.
    pub blobs: str[]
}

struct Subtags {
    parts: str[]
    at: i64
}

fn is_alpha(s: str) -> bool {
    if s.len == 0 {
        return false
    }
    for c in s {
        if !((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')) {
            return false
        }
    }
    true
}

fn is_alnum(s: str) -> bool {
    if s.len == 0 {
        return false
    }
    for c in s {
        if !((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9')) {
            return false
        }
    }
    true
}

fn is_language(s: str) -> bool {
    is_alpha(s) && ((s.len >= 2 && s.len <= 3) || (s.len >= 5 && s.len <= 8))
}

fn is_script(s: str) -> bool {
    is_alpha(s) && s.len == 4
}

fn is_region(s: str) -> bool {
    (is_alpha(s) && s.len == 2) || (text.is_digits(s) && s.len == 3)
}

fn is_variant(s: str) -> bool {
    if !is_alnum(s) {
        return false
    }
    if s.len >= 5 && s.len <= 8 {
        return true
    }
    s.len == 4 && s[0] >= '0' && s[0] <= '9'
}

fn title_case(s: str) -> str {
    if s.len == 0 {
        return s
    }
    "{text.upper(s[0..1])}{text.lower(s[1..])}"
}

fn empty_locale() -> Locale {
    Locale { language: "und", script: "", region: "", variants: [], numbering: "", calendar: "", collation: "", hour_cycle: "", currency: "", blobs: [] }
}

fn set_key(l: *Locale, key: str, value: str) {
    match key {
        "nu" => { l.numbering = value }
        "ca" => { l.calendar = value }
        "co" => { l.collation = value }
        "hc" => { l.hour_cycle = value }
        "cu" => { l.currency = value }
        _ => {}
    }
}

fn read_unicode_keys(s: *Subtags, l: *Locale) ! Error {
    for s.at < s.parts.len && s.parts[s.at].len != 1 {
        let key = s.parts[s.at]
        s.at += 1
        if key.len != 2 {
            continue
        }
        var values: str[] = []
        for s.at < s.parts.len && s.parts[s.at].len >= 3 {
            values.push(s.parts[s.at])
            s.at += 1
        }
        set_key(l, key, if values.len == 0 { "true" } else { text.join(values, "-") })
    }
}

fn parse_parts(tag: str) -> Locale ! Error {
    if text.trim(tag) == "" {
        fail Empty
    }
    let parts = text.split(text.lower(text.replace(tag, "_", "-")), '-')
    let s = new(Subtags { parts, at: 0 })
    let l = new(empty_locale())
    let first = parts[0]
    if first == "root" {
        s.at = 1
    } else if is_language(first) {
        l.language = first
        s.at = 1
    } else if first.len == 1 || is_script(first) || is_region(first) {
        s.at = 0
    } else {
        fail Malformed(first)
    }
    if s.at < parts.len && is_script(parts[s.at]) {
        l.script = title_case(parts[s.at])
        s.at += 1
    }
    if s.at < parts.len && is_region(parts[s.at]) {
        l.region = text.upper(parts[s.at])
        s.at += 1
    }
    var variants: str[] = []
    for s.at < parts.len && is_variant(parts[s.at]) {
        variants.push(parts[s.at])
        s.at += 1
    }
    for s.at < parts.len {
        let singleton = parts[s.at]
        if singleton == "x" {
            break
        }
        if singleton.len != 1 {
            fail Malformed(singleton)
        }
        s.at += 1
        if singleton == "u" {
            read_unicode_keys(s, l)?
            continue
        }
        for s.at < parts.len && parts[s.at].len != 1 {
            s.at += 1
        }
    }
    slices.sort(mut variants)
    l.variants = slices.unique(variants)
    *l
}

fn alias_target(kind: str, key: str) -> str? {
    match lookup(data.alias_table(), "{kind}:{key}") {
        some(v) => if v == "" { none } else { v }
        none => none
    }
}

fn apply_language_alias(l: *Locale) {
    var replacement = alias_target("l", l.language)
    if l.region != "" && replacement == none {
        replacement = alias_target("l", "{l.language}-{l.region}")
        if replacement != none {
            l.region = ""
        }
    }
    if replacement == none {
        for v in l.variants {
            replacement = alias_target("l", "{l.language}-{v}")
            if replacement != none {
                l.variants = slices.filter(l.variants, fn(x: str) -> bool { x != v })
                break
            }
        }
    }
    let target = replacement ?? return
    let first = text.split(text.replace(target, ",", " "), ' ')[0]
    let parts = text.split(first, '-')
    l.language = parts[0]
    for p in parts[1..] {
        if is_script(p) && l.script == "" {
            l.script = title_case(p)
        } else if is_region(p) && l.region == "" {
            l.region = text.upper(p)
        }
    }
}

fn apply_region_alias(l: *Locale) {
    let target = alias_target("t", l.region) ?? return
    let options = text.split(target, ',')
    if options.len == 1 {
        l.region = options[0]
        return
    }
    let likely = maximize_parts(l.language, "", "")
    for o in options {
        if o == likely.region {
            l.region = o
            return
        }
    }
    l.region = options[0]
}

fn canonicalize(l: *Locale) {
    apply_language_alias(l)
    if l.script != "" {
        match alias_target("s", l.script) {
            some(v) => { l.script = v }
            none => {}
        }
    }
    if l.region != "" {
        apply_region_alias(l)
    }
    var variants: str[] = []
    for v in l.variants {
        variants.push(alias_target("v", v) ?? v)
    }
    slices.sort(mut variants)
    l.variants = slices.unique(variants)
}

struct Likely {
    language: str
    script: str
    region: str
}

fn likely_lookup(key: str) -> Likely? {
    let value = lookup(data.likely_table(), key) ?? return none
    let parts = text.split(value, '-')
    var out = Likely { language: parts[0], script: "", region: "" }
    for p in parts[1..] {
        if is_script(p) {
            out.script = p
        } else if is_region(p) {
            out.region = p
        }
    }
    out
}

fn maximize_parts(language: str, script: str, region: str) -> Likely {
    let lang = if language == "" { "und" } else { language }
    var keys: str[] = []
    if script != "" && region != "" {
        keys.push("{lang}-{script}-{region}")
    }
    if region != "" {
        keys.push("{lang}-{region}")
    }
    if script != "" {
        keys.push("{lang}-{script}")
    }
    keys.push(lang)
    if script != "" {
        keys.push("und-{script}")
    }
    for key in keys {
        match likely_lookup(key) {
            some(found) => {
                return Likely {
                    language: if lang == "und" { found.language } else { lang },
                    script: if script == "" { found.script } else { script },
                    region: if region == "" { found.region } else { region }
                }
            }
            none => {}
        }
    }
    Likely { language: lang, script, region }
}

fn identifier_of(language: str, script: str, region: str, variants: str[]) -> str {
    var parts: str[] = [language]
    if script != "" {
        parts.push(script)
    }
    if region != "" {
        parts.push(region)
    }
    for v in variants {
        parts.push(v)
    }
    text.join(parts, "-")
}

fn has_file(id: str) -> bool {
    lookup(data.locales_table(), id) != none
}

fn parent_id(id: str) -> str {
    match lookup(data.parents_table(), id) {
        some(p) => return p
        none => {}
    }
    let cut = text.last_cut(id, "-")
    if cut.found { cut.before } else { "root" }
}

fn start_id(l: Locale) -> str {
    if l.language == "und" {
        return "root"
    }
    let own = identifier_of(l.language, l.script, l.region, l.variants)
    if has_file(own) {
        return own
    }
    let likely = maximize_parts(l.language, l.script, l.region)
    let full = identifier_of(likely.language, likely.script, likely.region, l.variants)
    if has_file(full) {
        return full
    }
    var at = full
    for at != "root" {
        if has_file(at) {
            return at
        }
        at = parent_id(at)
    }
    own
}

/// Returns the identifiers that serve `l`, most specific first and ending in `root`.
///
/// The first is the identifier of `l`, or its likely-subtags expansion when only that has a data file, such as `zh-Hant-TW` for `zh-TW`; when no data file serves `l` it is the identifier of `l`, which plural rules may still name. Each next one is the explicit CLDR parent of the previous one, or the previous one with its last subtag removed.
pub fn chain(l: Locale) -> str[] {
    var out: str[] = []
    var at = start_id(l)
    for at != "root" {
        out.push(at)
        at = parent_id(at)
    }
    out.push("root")
    out
}

/// Parses the BCP 47 tag `tag`, canonicalises it and loads the data of it and its parents.
///
/// Subtags are case-insensitive and `_` is read as `-`. The language, script, region and variant aliases of CLDR apply, so `iw` becomes `he` and `sh` becomes `sr-Latn`. The `-u-` keys `nu`, `ca`, `co`, `hc` and `cu` are kept and other extensions and private use subtags are dropped. This links the data of every locale; `parse_with` links only the data it is given.
pub fn parse(tag: str) -> Locale ! Error {
    let l = new(parse_parts(tag)?)
    canonicalize(l)
    var blobs: str[] = []
    for id in chain(*l) {
        match data.blob_by_id(id) {
            some(b) => blobs.push(b)
            none => {}
        }
    }
    l.blobs = blobs
    *l
}

/// Parses `tag` as `parse` does and attaches `blobs` as its data, taken from the generated `data.chain_<tag>` functions of `std/locale/data`.
///
/// Only the data that is passed in is linked into the program.
pub fn parse_with(tag: str, blobs: str[]) -> Locale ! Error {
    let l = new(parse_parts(tag)?)
    canonicalize(l)
    l.blobs = blobs
    *l
}

/// Returns the root locale, whose data is the CLDR defaults.
pub fn root() -> Locale {
    var l = empty_locale()
    l.blobs = [data.blob_root()]
    l
}

/// Returns `l` as a canonical BCP 47 tag, such as `de-CH-u-nu-arab`.
pub fn tag(l: Locale) -> str {
    let base = identifier_of(l.language, l.script, l.region, l.variants)
    var keys: str[] = []
    if l.calendar != "" {
        keys.push("ca-{l.calendar}")
    }
    if l.collation != "" {
        keys.push("co-{l.collation}")
    }
    if l.currency != "" {
        keys.push("cu-{l.currency}")
    }
    if l.hour_cycle != "" {
        keys.push("hc-{l.hour_cycle}")
    }
    if l.numbering != "" {
        keys.push("nu-{l.numbering}")
    }
    if keys.len == 0 {
        return base
    }
    "{base}-u-{text.join(keys, "-")}"
}

/// Returns `l` with its missing language, script and region filled in from the CLDR likely subtags, so `en` becomes `en-Latn-US`.
pub fn maximize(l: Locale) -> Locale {
    let found = maximize_parts(l.language, l.script, l.region)
    var out = l
    out.language = found.language
    out.script = found.script
    out.region = found.region
    out
}

/// Returns `l` with every subtag that the likely subtags would restore removed, so `en-Latn-US` becomes `en`.
pub fn minimize(l: Locale) -> Locale {
    let full = maximize_parts(l.language, l.script, l.region)
    var out = l
    let trials = [
        Likely { language: full.language, script: "", region: "" }
        Likely { language: full.language, script: "", region: full.region }
        Likely { language: full.language, script: full.script, region: "" }
    ]
    for t in trials {
        let back = maximize_parts(t.language, t.script, t.region)
        if back.language == full.language && back.script == full.script && back.region == full.region {
            out.language = t.language
            out.script = t.script
            out.region = t.region
            return out
        }
    }
    out.language = full.language
    out.script = full.script
    out.region = full.region
    out
}
