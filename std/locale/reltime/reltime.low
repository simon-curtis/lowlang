import std/locale
import std/locale/data
import std/locale/decimal
import std/locale/numfmt
import std/locale/plural
import std/text

/// The unit a relative time counts in.
pub enum Unit {
    /// Seconds.
    Second
    /// Minutes.
    Minute
    /// Hours.
    Hour
    /// Days.
    Day
    /// Weeks.
    Week
    /// Months.
    Month
    /// Quarters of a year.
    Quarter
    /// Years.
    Year
}

/// How much text a relative time keeps.
pub enum Width {
    /// "in 3 days".
    Long
    /// "in 3 days" or "in 3 mo.", as the locale abbreviates.
    Short
    /// The shortest form the locale has.
    Narrow
}

/// Whether a value with a word of its own, such as yesterday, uses it.
pub enum Numeric {
    /// Always a count: "1 day ago".
    Always
    /// The word when the locale has one: "yesterday".
    Auto
}

fn field_of(unit: Unit) -> i64 {
    match unit {
        Second => 0
        Minute => 1
        Hour => 2
        Day => 3
        Week => 4
        Month => 5
        Quarter => 6
        Year => 7
    }
}

fn widths(width: Width) -> []i64 {
    match width {
        Long => [0]
        Short => [1, 0]
        Narrow => [2, 1, 0]
    }
}

fn category_slot(c: plural.Category) -> i64 {
    match c {
        Zero => 0
        One => 1
        Two => 2
        Few => 3
        Many => 4
        Other => 5
    }
}

fn entry(l: locale.Locale, unit: Unit, width: Width, slot: i64) -> str? {
    for w in widths(width) {
        let group = data.group_relative + field_of(unit) * 3 + w
        match locale.entry(l, group, slot) {
            some(v) => return v
            none => {}
        }
    }
    none
}

fn word_for(l: locale.Locale, unit: Unit, width: Width, value: decimal.Decimal) -> str? {
    let p = decimal.parts(value)
    for c in p.fraction {
        if c != '0' {
            return none
        }
    }
    let n = text.parse_int(p.integer) or return none
    if n > 2 {
        return none
    }
    let signed = if value.negative { -n } else { n }
    entry(l, unit, width, 3 + signed)
}

fn counted(l: locale.Locale, unit: Unit, width: Width, value: decimal.Decimal) -> str ! numfmt.Error {
    let magnitude = decimal.Decimal { kind: value.kind, negative: false, digits: value.digits, scale: value.scale }
    let number = numfmt.format(l, magnitude, numfmt.options())?
    let category = plural.cardinal(l, plural.operands(magnitude, 0))
    let base = if value.negative { 12 } else { 6 }
    let pattern = entry(l, unit, width, base + category_slot(category)) ?? entry(l, unit, width, base + 5) ?? "{{0}}"
    text.replace(pattern, "{{0}}", number)
}

/// Formats `value` units from now for `l`: "in 3 days" for a positive value and "3 days ago" for a negative one.
///
/// A negative zero counts as past. With `Auto`, a whole value from `-2` to `2` that the locale has a word for is written with the word, such as "yesterday" or "next year"; any other value is a count. The count is written with the default number format of `l` and picks its plural form by the cardinal rules of `l`. Fails as `numfmt.format` does.
pub fn format(l: locale.Locale, value: decimal.Decimal, unit: Unit, numeric: Numeric, width: Width) -> str ! numfmt.Error {
    if numeric == Numeric.Auto {
        match word_for(l, unit, width, value) {
            some(w) => return w
            none => {}
        }
    }
    counted(l, unit, width, value)
}

/// Formats the whole number `n` as `format` does.
pub fn format_int(l: locale.Locale, n: i64, unit: Unit, numeric: Numeric, width: Width) -> str ! numfmt.Error {
    format(l, decimal.from_int(n), unit, numeric, width)
}
