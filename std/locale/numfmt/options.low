import std/locale/decimal

/// Why a number could not be formatted.
pub enum Error {
    /// The currency style needs a currency code, and `currency` is empty.
    MissingCurrency
    /// The code is not a currency of the data. `code` is the code given.
    UnknownCurrency(code: str)
    /// The digit options contradict each other, such as a minimum above its maximum.
    InvalidDigits
}

/// What the number stands for.
pub enum Style {
    /// A plain number.
    Decimal
    /// A ratio shown as a percentage, so `0.25` is `25%`.
    Percent
    /// An amount of the currency `Options.currency`.
    Currency
}

/// How the digits of the number are laid out.
pub enum Notation {
    /// All integer digits, grouped.
    Standard
    /// One integer digit and an exponent, as `1.2E5`.
    Scientific
    /// An exponent that is a multiple of three, as `120E3`.
    Engineering
    /// The locale's abbreviation of large numbers, as `120K` or `120 thousand`.
    Compact
}

/// Whether compact notation abbreviates or spells out the magnitude.
pub enum CompactDisplay {
    /// The short form, such as `1.2K`.
    Short
    /// The long form, such as `1.2 thousand`.
    Long
}

/// How a currency is shown.
pub enum CurrencyDisplay {
    /// The symbol of the locale, such as `US$`, or the code when the locale has none.
    Symbol
    /// The narrow symbol, such as `$`, or the symbol when there is no narrow one.
    NarrowSymbol
    /// The ISO 4217 code, such as `USD`.
    Code
    /// The plural name, such as `US dollars`.
    Name
}

/// How a negative amount of currency is written.
pub enum CurrencySign {
    /// With a minus sign.
    Standard
    /// In the accounting pattern of the locale, which is often in parentheses.
    Accounting
}

/// Which rounding the currency follows.
pub enum CurrencyUsage {
    /// The digits and rounding of ISO 4217 for ordinary amounts.
    Standard
    /// The digits and rounding of ISO 4217 for amounts in cash.
    Cash
}

/// When the sign is shown.
pub enum SignDisplay {
    /// A sign for negative numbers, and for negative zero.
    Auto
    /// A sign for every number.
    Always
    /// No sign.
    Never
    /// A sign for every number except zero.
    ExceptZero
    /// A sign for negative numbers, but not for negative zero.
    Negative
}

/// When digits are grouped.
pub enum Grouping {
    /// Group by the locale's minimum grouping digits, and in compact notation by at least two.
    Auto
    /// Group every number that has more digits than one group.
    Always
    /// Group only numbers that would leave at least two digits in the leading group.
    Min2
    /// Never group.
    Off
}

/// Whether trailing zero fraction digits stay when the number is whole.
pub enum TrailingZeros {
    /// Keep them.
    Auto
    /// Drop the fraction when it is all zeros.
    StripIfInteger
}

/// How `format` writes a number. `options` returns the defaults.
pub struct Options {
    /// What the number stands for.
    pub style: Style
    /// How the digits are laid out.
    pub notation: Notation
    /// Whether compact notation is short or long.
    pub compact_display: CompactDisplay
    /// The ISO 4217 code of the currency, required for the currency style.
    pub currency: str
    /// How the currency is shown.
    pub currency_display: CurrencyDisplay
    /// How a negative amount is written.
    pub currency_sign: CurrencySign
    /// Which digits and rounding the currency takes.
    pub currency_usage: CurrencyUsage
    /// When the sign is shown.
    pub sign_display: SignDisplay
    /// When digits are grouped.
    pub grouping: Grouping
    /// The least count of integer digits, padded with zeros.
    pub minimum_integer: i64
    /// The least count of fraction digits, or `-1` for the default of the style.
    pub minimum_fraction: i64
    /// The most count of fraction digits, or `-1` for the default of the style.
    pub maximum_fraction: i64
    /// The least count of significant digits, or `0` to round by fraction digits.
    pub minimum_significant: i64
    /// The most count of significant digits, or `0` to round by fraction digits.
    pub maximum_significant: i64
    /// How a discarded remainder rounds the number.
    pub rounding_mode: decimal.Mode
    /// The unit of rounding in the last fraction digit, such as `5` for multiples of 0.05 at two digits, or `1`.
    pub rounding_increment: i64
    /// Whether a whole number keeps its zero fraction digits.
    pub trailing_zeros: TrailingZeros
}

/// Returns the default options: a decimal in standard notation, rounded half to even, with up to three fraction digits.
pub fn options() -> Options {
    Options {
        style: Style.Decimal,
        notation: Notation.Standard,
        compact_display: CompactDisplay.Short,
        currency: "",
        currency_display: CurrencyDisplay.Symbol,
        currency_sign: CurrencySign.Standard,
        currency_usage: CurrencyUsage.Standard,
        sign_display: SignDisplay.Auto,
        grouping: Grouping.Auto,
        minimum_integer: 1,
        minimum_fraction: -1,
        maximum_fraction: -1,
        minimum_significant: 0,
        maximum_significant: 0,
        rounding_mode: decimal.Mode.HalfEven,
        rounding_increment: 1,
        trailing_zeros: TrailingZeros.Auto
    }
}
