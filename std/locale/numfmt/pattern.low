import std/builder
import std/text
import std/unicode

struct Affixes {
    positive_prefix: str
    positive_suffix: str
    negative_prefix: str
    negative_suffix: str
    explicit_negative: bool
}

struct NumberPart {
    minimum_integer: i64
    minimum_fraction: i64
    maximum_fraction: i64
    primary: i64
    secondary: i64
    zeros: i64
}

struct Pattern {
    affixes: Affixes
    number: NumberPart
}

struct Subpattern {
    prefix: str
    suffix: str
    number: NumberPart
}

fn is_number_byte(c: u8) -> bool {
    c == '#' || c == '0' || c == ',' || c == '.'
}

fn split_unquoted(pattern: str, sep: u8) -> str[] {
    var out: str[] = []
    var quoted = false
    var start = 0
    for i in 0..pattern.len {
        let c = pattern[i]
        if c == '\'' {
            quoted = !quoted
        } else if c == sep && !quoted {
            out.push(pattern[start..i])
            start = i + 1
        }
    }
    out.push(pattern[start..])
    out
}

fn number_bounds(sub: str) -> Bounds {
    var quoted = false
    var start = -1
    var end = sub.len
    for i in 0..sub.len {
        let c = sub[i]
        if c == '\'' {
            quoted = !quoted
            if start >= 0 {
                end = i
                break
            }
            continue
        }
        if quoted {
            continue
        }
        if is_number_byte(c) {
            if start < 0 {
                start = i
            }
        } else if start >= 0 {
            end = i
            break
        }
    }
    if start < 0 {
        return Bounds { start: sub.len, end: sub.len }
    }
    Bounds { start, end }
}

struct Bounds {
    start: i64
    end: i64
}

fn analyse_number(part: str) -> NumberPart {
    let cut = text.cut(part, ".")
    let integer = cut.before
    var zeros = 0
    var min_fraction = 0
    var max_fraction = 0
    for c in integer {
        if c == '0' {
            zeros += 1
        }
    }
    for c in cut.after {
        if c == '0' {
            min_fraction += 1
            max_fraction += 1
        } else if c == '#' {
            max_fraction += 1
        }
    }
    var primary = 0
    var secondary = 0
    let last = text.last_index_byte(integer, ',')
    if last >= 0 {
        primary = integer.len - last - 1
        let before = integer[..last]
        let previous = text.last_index_byte(before, ',')
        secondary = if previous >= 0 { before.len - previous - 1 } else { primary }
    }
    NumberPart { minimum_integer: zeros, minimum_fraction: min_fraction, maximum_fraction: max_fraction, primary, secondary, zeros }
}

fn parse_subpattern(sub: str) -> Subpattern {
    let b = number_bounds(sub)
    Subpattern { prefix: sub[..b.start], suffix: sub[b.end..], number: analyse_number(sub[b.start..b.end]) }
}

fn parse_pattern(pattern: str) -> Pattern {
    let halves = split_unquoted(pattern, ';')
    let positive = parse_subpattern(halves[0])
    if halves.len > 1 {
        let negative = parse_subpattern(halves[1])
        return Pattern {
            affixes: Affixes {
                positive_prefix: positive.prefix,
                positive_suffix: positive.suffix,
                negative_prefix: negative.prefix,
                negative_suffix: negative.suffix,
                explicit_negative: true
            },
            number: positive.number
        }
    }
    Pattern {
        affixes: Affixes {
            positive_prefix: positive.prefix,
            positive_suffix: positive.suffix,
            negative_prefix: "-{positive.prefix}",
            negative_suffix: positive.suffix,
            explicit_negative: false
        },
        number: positive.number
    }
}

struct Substitutions {
    currency: str
    code: str
    percent: str
    permille: str
    minus: str
    plus: str
}

struct Expanded {
    text: str
    starts_with_currency: bool
    ends_with_currency: bool
}

fn expand(raw: str, s: Substitutions) -> Expanded {
    var out = builder.builder()
    var quoted = false
    var starts = false
    var ends = false
    var first = true
    var currency_marks = 0
    for c in raw {
        if c == '¤' {
            currency_marks += 1
            continue
        }
        if currency_marks > 0 {
            let value = if currency_marks == 2 { s.code } else { s.currency }
            if first {
                starts = true
            }
            builder.write(mut out, value)
            currency_marks = 0
            ends = true
            first = false
        }
        if c == '\'' {
            if quoted {
                quoted = false
            } else {
                quoted = true
            }
            continue
        }
        ends = false
        first = false
        if quoted {
            builder.write(mut out, text.from_char(c))
        } else if c == '%' {
            builder.write(mut out, s.percent)
        } else if c == '‰' {
            builder.write(mut out, s.permille)
        } else if c == '-' {
            builder.write(mut out, s.minus)
        } else if c == '+' {
            builder.write(mut out, s.plus)
        } else {
            builder.write(mut out, text.from_char(c))
        }
    }
    if currency_marks > 0 {
        let value = if currency_marks == 2 { s.code } else { s.currency }
        if first {
            starts = true
        }
        builder.write(mut out, value)
        ends = true
    }
    Expanded { text: builder.to_str(out), starts_with_currency: starts, ends_with_currency: ends }
}

fn is_separator(c: u32) -> bool {
    let k = unicode.category(c)
    k == unicode.Category.SpaceSeparator || k == unicode.Category.LineSeparator || k == unicode.Category.ParagraphSeparator
}

fn spacing_applies(edge: u32) -> bool {
    !unicode.is_symbol(edge) && !is_separator(edge)
}

fn first_char(s: str) -> u32 {
    for c in s {
        return c
    }
    0
}

fn last_char(s: str) -> u32 {
    var last: u32 = 0
    for c in s {
        last = c
    }
    last
}
