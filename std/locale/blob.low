import std/locale/data

fn read_u16(b: str, at: i64) -> i64 {
    i64(b[at]) | (i64(b[at + 1]) << 8)
}

fn read_u32(b: str, at: i64) -> i64 {
    read_u16(b, at) | (read_u16(b, at + 2) << 16)
}

struct Varint {
    value: i64
    next: i64
}

fn read_varint(b: str, at: i64) -> Varint {
    var value = 0
    var shift = 0
    var i = at
    for {
        let byte = i64(b[i])
        i += 1
        value = value | ((byte & 0x7F) << shift)
        if byte < 0x80 {
            break
        }
        shift += 7
    }
    Varint { value, next: i }
}

fn find_group(blob: str, group: i64) -> i64 {
    if blob.len < 2 {
        return -1
    }
    var lo = 0
    var hi = read_u16(blob, 0)
    for lo < hi {
        let mid = (lo + hi) / 2
        let at = 2 + mid * 6
        let id = read_u16(blob, at)
        if id == group {
            return read_u32(blob, at + 2)
        }
        if id < group {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    -1
}

fn blob_entry(blob: str, group: i64, index: i64) -> str? {
    let at = find_group(blob, group)
    if at < 0 {
        return none
    }
    let used = read_varint(blob, at)
    if index >= used.value {
        return none
    }
    var cursor = used.next
    for i in 0..index {
        let len = read_varint(blob, cursor)
        cursor = len.next + if len.value > 0 { len.value - 1 } else { 0 }
    }
    let len = read_varint(blob, cursor)
    if len.value == 0 {
        return none
    }
    blob[len.next..len.next + len.value - 1]
}

/// Returns the entry `index` of the group `group` in the first of the locale's data blobs that holds it, or `none` when no blob has it.
///
/// A group number is `data.group_<name>` plus the position of the numbering system, currency or field within that group.
pub fn entry(l: Locale, group: i64, index: i64) -> str? {
    for blob in l.blobs {
        match blob_entry(blob, group, index) {
            some(v) => return v
            none => {}
        }
    }
    none
}

fn row_present(blob: str, group: i64, start: i64, span: i64) -> bool {
    for i in 0..span {
        if blob_entry(blob, group, start + i) != none {
            return true
        }
    }
    false
}

fn is_root_blob(blob: str) -> bool {
    blob == data.blob_root()
}

/// Returns the entry `offset` of the row of `span` entries starting at `preferred`, falling back to the same entry of the row starting at `other`.
///
/// The locale's own blobs are searched before the root blob. The `other` row is used before the root blob only when none of the locale's blobs holds any entry of the `preferred` row, as a stand-alone name stands in for an absent format name.
pub fn entry_of_rows(l: Locale, group: i64, preferred: i64, other: i64, span: i64, offset: i64) -> str? {
    var has_preferred = false
    for blob in l.blobs {
        if is_root_blob(blob) {
            continue
        }
        if row_present(blob, group, preferred, span) {
            has_preferred = true
        }
        match blob_entry(blob, group, preferred + offset) {
            some(v) => return v
            none => {}
        }
    }
    if !has_preferred {
        for blob in l.blobs {
            if is_root_blob(blob) {
                continue
            }
            match blob_entry(blob, group, other + offset) {
                some(v) => return v
                none => {}
            }
        }
    }
    for blob in l.blobs {
        if !is_root_blob(blob) {
            continue
        }
        match blob_entry(blob, group, preferred + offset) {
            some(v) => return v
            none => {}
        }
        match blob_entry(blob, group, other + offset) {
            some(v) => return v
            none => {}
        }
    }
    none
}

/// Returns the entry `index` of the group `group` from every data blob that holds it, most specific blob first.
pub fn entries(l: Locale, group: i64, index: i64) -> []str {
    var out: []str = []
    for blob in l.blobs {
        match blob_entry(blob, group, index) {
            some(v) => push(mut out, v)
            none => {}
        }
    }
    out
}
