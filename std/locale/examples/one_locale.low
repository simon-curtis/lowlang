import std/locale
import std/locale/data
import std/locale/numfmt
import std/locale/plural

fn main() {
    let german = locale.parse_with("de", data.chain_de()) or locale.root()
    var o = numfmt.options()
    o.style = numfmt.Style.Percent
    let ratio = numfmt.format_f64(german, 0.256, o) or "?"
    let count = numfmt.format_int(german, 1234567, numfmt.options()) or "?"
    let many = plural.name(plural.ordinal(german, plural.operands_of_int(3)))
    print("{locale.tag(german)} {count} {ratio} {many}")
}
