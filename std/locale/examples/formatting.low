import std/locale
import std/locale/decimal
import std/locale/list
import std/locale/numfmt
import std/locale/plural
import std/locale/reltime

fn show(tag: str) {
    let l = locale.parse(tag) or locale.root()
    var price = numfmt.options()
    price.style = numfmt.Style.Currency
    price.currency = "EUR"
    let amount = numfmt.format_f64(l, 1234567.891, price) or "?"
    let plain = numfmt.format_int(l, 1234567, numfmt.options()) or "?"
    let one = plural.name(plural.category_of(l, decimal.from_int(1)))
    let few = plural.name(plural.category_of(l, decimal.from_int(3)))
    let ago = reltime.format_int(l, -3, reltime.Unit.Day, reltime.Numeric.Always, reltime.Width.Long) or "?"
    let items = list.format(l, ["red", "green", "blue"], list.Kind.And, list.Width.Wide)
    print("{locale.tag(l)}: {plain} | {amount} | {one}/{few} | {ago} | {items}")
}

fn main() {
    show("en")
    show("de")
    show("fr")
    show("en-IN")
    show("ar")
    show("ja")
    let minimal = locale.minimize(locale.maximize(locale.parse("zh") or locale.root()))
    print("{locale.tag(locale.maximize(locale.parse("zh") or locale.root()))} {locale.tag(minimal)}")
}
