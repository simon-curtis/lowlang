import std/io
import std/locale/data

const common_secondary = 0x200000
const common_tertiary = 0x20000
const variable_flag = 0x8000

struct Ce {
    p: i64
    s: i64
    t: i64
    variable: bool
    upper: bool
}

fn word(s: str, at: i64) -> i64 {
    i64(io.u32_le_str(s, at))
}

fn half(s: str, at: i64) -> i64 {
    i64(io.u16_le_str(s, at))
}

fn root_count(table: str) -> i64 {
    word(table, 0)
}

fn root_key(table: str, i: i64) -> i64 {
    let at = 4 + i * 16
    word(table, at) | (word(table, at + 4) << 32)
}

fn root_find(table: str, key: i64) -> i64 {
    var lo = 0
    var hi = root_count(table)
    for lo < hi {
        let mid = (lo + hi) / 2
        let k = root_key(table, mid)
        if k == key {
            return mid
        }
        if k < key {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    -1
}

fn root_ces(table: str, i: i64) -> Ce[] {
    let at = 4 + i * 16
    let first = word(table, at + 8)
    let count = i64(table[at + 12])
    let base = 4 + root_count(table) * 16 + first * 6
    var out: Ce[] = []
    for k in 0..count {
        let o = base + k * 6
        let t = half(table, o + 4)
        out.push(Ce { p: half(table, o) << 16, s: half(table, o + 2) << 16, t: (t & 0x7FFF) << 16, variable: (t & variable_flag) != 0, upper: is_upper_tertiary(t & 0x7FFF) })
    }
    out
}

fn root_flags(table: str, i: i64) -> i64 {
    i64(table[4 + i * 16 + 13])
}

fn pack(cps: u32[]) -> i64 {
    var key = 0
    for i, c in cps {
        key = key | (i64(c) << (i * 21))
    }
    key
}

fn is_upper_tertiary(ter: i64) -> bool {
    match ter {
        8 => true
        9 => true
        10 => true
        11 => true
        12 => true
        14 => true
        17 => true
        18 => true
        29 => true
        _ => false
    }
}

fn implicit_ces(cp: i64) -> Ce[] {
    var high = 0xFBC0 + (cp >> 15)
    var low = (cp & 0x7FFF) | 0x8000
    if (cp >= 0x17000 && cp <= 0x187FF) || (cp >= 0x18D00 && cp <= 0x18D7F) {
        high = 0xFB00
        low = (cp - 0x17000) | 0x8000
    } else if (cp >= 0x18800 && cp <= 0x18AFF) || (cp >= 0x18D80 && cp <= 0x18DFF) {
        high = 0xFB01
        low = (cp - 0x18800) | 0x8000
    } else if cp >= 0x1B170 && cp <= 0x1B2FF {
        high = 0xFB02
        low = (cp - 0x1B170) | 0x8000
    } else if cp >= 0x18B00 && cp <= 0x18CFF {
        high = 0xFB03
        low = (cp - 0x18B00) | 0x8000
    } else if is_ideograph(cp) {
        let core = (cp >= 0x4E00 && cp <= 0x9FFF) || (cp >= 0xF900 && cp <= 0xFAFF)
        high = (if core { 0xFB40 } else { 0xFB80 }) + (cp >> 15)
    }
    [Ce { p: high << 16, s: common_secondary, t: common_tertiary, variable: false, upper: false }, Ce { p: low << 16, s: 0, t: 0, variable: false, upper: false }]
}

fn is_ideograph(cp: i64) -> bool {
    let table = data.collate_han_table()
    var at = 0
    for at < table.len {
        if cp >= word(table, at) && cp <= word(table, at + 4) {
            return true
        }
        at += 8
    }
    false
}

fn combining_class(cp: u32) -> i64 {
    if cp < 0x300 {
        return 0
    }
    let table = data.collate_ccc_table()
    var lo = 0
    var hi = table.len / 12
    for lo < hi {
        let mid = (lo + hi) / 2
        let at = mid * 12
        if i64(cp) < word(table, at) {
            hi = mid
        } else if i64(cp) > word(table, at + 4) {
            lo = mid + 1
        } else {
            return word(table, at + 8)
        }
    }
    0
}
