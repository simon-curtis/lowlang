import std/locale/data

const unassigned_code = "Zunk"
const others_token = "others"

struct Group {
    start: i64
    end: i64
    code: str
}

struct Reorder {
    starts: []i64
    ends: []i64
    shifts: []i64
}

fn no_reorder() -> Reorder {
    Reorder { starts: [], ends: [], shifts: [] }
}

fn script_groups() -> []Group {
    let table = data.collate_scripts_table()
    var out: []Group = []
    var at = 0
    for at < table.len {
        let start = word(table, at)
        let next = if at + 8 < table.len { word(table, at + 8) } else { 0x10000 }
        push(mut out, Group { start, end: next, code: table[at + 4..at + 8] })
        at += 8
    }
    out
}

fn is_special(code: str) -> bool {
    code == "Zspc" || code == "Zpct" || code == "Zsym" || code == "Zcur" || code == "Zdig"
}

fn token_code(token: str) -> str {
    match token {
        "space" => "Zspc"
        "punct" => "Zpct"
        "symbol" => "Zsym"
        "currency" => "Zcur"
        "digit" => "Zdig"
        _ => token
    }
}

fn is_listed(codes: []str, code: str) -> bool {
    for c in codes {
        if c == code {
            return true
        }
    }
    false
}

fn reorder_for(tokens: []str) -> Reorder {
    if tokens.len == 0 {
        return no_reorder()
    }
    let groups = script_groups()
    var codes: []str = []
    for t in tokens {
        push(mut codes, token_code(t))
    }
    var order: []Group = []
    var placed: [i64: bool] = [:]
    for g in groups {
        if is_special(g.code) && !is_listed(codes, g.code) {
            push(mut order, g)
            placed[g.start] = true
        }
    }
    var others_seen = false
    for code in codes {
        if code == others_token {
            others_seen = true
            for g in groups {
                if g.code != unassigned_code && !is_special(g.code) && !is_listed(codes, g.code) && (placed[g.start] ?? false) == false {
                    push(mut order, g)
                    placed[g.start] = true
                }
            }
            continue
        }
        for g in groups {
            if g.code == code && (placed[g.start] ?? false) == false {
                push(mut order, g)
                placed[g.start] = true
            }
        }
    }
    if !others_seen {
        for g in groups {
            if g.code != unassigned_code && (placed[g.start] ?? false) == false {
                push(mut order, g)
                placed[g.start] = true
            }
        }
    }
    var result = no_reorder()
    var position = groups[0].start
    for g in order {
        let shift = position - g.start
        if shift != 0 {
            push(mut result.starts, g.start)
            push(mut result.ends, g.end)
            push(mut result.shifts, shift)
        }
        position += g.end - g.start
    }
    result
}

fn reordered_primary(r: Reorder, p: i64) -> i64 {
    let high = p >> 16
    for i in 0..r.starts.len {
        if high >= r.starts[i] && high < r.ends[i] {
            return p + (r.shifts[i] << 16)
        }
    }
    p
}
