import std/locale
import std/locale/data
import std/slices
import std/unicode

/// How a variable element (white space and punctuation) takes part in the order.
pub enum Alternate {
    /// The setting of the locale's collation, which is `NonIgnorable` unless its rules say otherwise.
    Auto
    /// A variable element has a primary weight like any other character.
    NonIgnorable
    /// A variable element is ignored at the first three levels and compared at the fourth.
    Shifted
}

/// The deepest level at which two strings can differ.
pub enum Strength {
    /// The setting of the locale's collation, which is `Tertiary` unless its rules say otherwise.
    Auto
    /// Base letters only: `a` equals `A` and `á`.
    Primary
    /// Base letters and accents.
    Secondary
    /// Base letters, accents and case.
    Tertiary
    /// Adds the level at which `Shifted` variable elements are compared.
    Quaternary
    /// Adds a comparison of the decomposed code points, so that only canonically equivalent strings are equal.
    Identical
}

/// Whether lower-case or upper-case letters sort first among otherwise equal strings.
pub enum CaseFirst {
    /// The setting of the locale's collation, which is `Off` unless its rules say otherwise.
    Auto
    /// Upper case follows lower case as its tertiary weight orders it.
    Off
    /// Upper-case letters before lower-case and uncased letters, whatever their other weights.
    Upper
    /// Lower-case and uncased letters before upper-case letters, whatever their other weights.
    Lower
}

/// The direction in which the accent weights of a string are compared.
pub enum SecondaryOrder {
    /// The setting of the locale's collation, which is `Forwards` unless its rules say otherwise.
    Auto
    /// From the first accent to the last.
    Forwards
    /// From the last accent to the first, as in Canadian French.
    Backwards
}

/// The choices that change how strings compare.
pub struct Options {
    /// How variable elements are weighted.
    pub alternate: Alternate
    /// The deepest level compared.
    pub strength: Strength
    /// Whether lower case or upper case sorts first.
    pub case_first: CaseFirst
    /// The direction of accent comparison.
    pub secondary: SecondaryOrder
    /// Whether a run of ASCII digits compares by its numeric value, so that `"9"` sorts before `"10"`.
    pub numeric: bool
}

/// Returns options that take every choice from the locale's collation.
pub fn options() -> Options {
    Options { alternate: Alternate.Auto, strength: Strength.Auto, case_first: CaseFirst.Auto, secondary: SecondaryOrder.Auto, numeric: false }
}

/// Compares strings by the CLDR root collation of UTS #10, adjusted by the tailoring of a locale when one is given.
pub struct Collator {
    tailoring: Tailoring
    settings: Settings
}

fn strength_level(s: Strength, fallback: i64) -> i64 {
    match s {
        Auto => fallback
        Primary => level_primary
        Secondary => level_secondary
        Tertiary => level_tertiary
        Quaternary => level_quaternary
        Identical => level_identical
    }
}

fn build(t: Tailored, o: Options) -> Collator {
    let shifted = match o.alternate {
        Auto => t.shifted == 1
        NonIgnorable => false
        Shifted => true
    }
    let backwards = match o.secondary {
        Auto => t.backwards == 1
        Forwards => false
        Backwards => true
    }
    let case_first = match o.case_first {
        Auto => match t.case_first {
            2 => case_upper
            3 => case_lower
            _ => case_off
        }
        Off => case_off
        Upper => case_upper
        Lower => case_lower
    }
    let fallback = if t.strength == unset { level_tertiary } else { t.strength }
    let settings = Settings { shifted, strength: strength_level(o.strength, fallback), backwards, case_first, numeric: o.numeric, reorder: reorder_for(t.reorder) }
    Collator { tailoring: t.tailoring, settings }
}

/// Returns the collator of the CLDR root collation with the choices in `o`.
pub fn root(o: Options) -> Collator {
    build(compile_rules(""), o)
}

fn collation_type(l: locale.Locale) -> str {
    match l.collation {
        "" => "standard"
        "phonebk" => "phonebook"
        "trad" => "traditional"
        "dict" => "dictionary"
        "searchjl" => "search"
        _ => l.collation
    }
}

fn rules_of(l: locale.Locale) -> str {
    let table = data.collate_rules_table()
    let kind = collation_type(l)
    for id in locale.chain(l) {
        if id == "root" {
            break
        }
        match locale.lookup(table, "{id}/{kind}") {
            some(rules) => return rules
            none => {}
        }
        match locale.lookup(table, "{id}/standard") {
            some(rules) => return rules
            none => {}
        }
    }
    ""
}

/// Returns the collator for `l` with the choices in `o`.
///
/// The collation type is the `co` key of `l`, or `standard`. The tailoring is the CLDR rules of the first locale in the chain of `l` that has them for that type, or the root collation when none does.
pub fn for_locale(l: locale.Locale, o: Options) -> Collator {
    build(compile_rules(rules_of(l)), o)
}

/// Returns whether CLDR has tailoring rules for the collation type of `l` in `l` or one of its parents.
pub fn is_tailored(l: locale.Locale) -> bool {
    rules_of(l) != ""
}

fn runes_of(s: str) -> u32[] {
    var out: u32[] = []
    var at = 0
    for at < s.len {
        let r = unicode.decode_rune(s, at)
        out.push(r.code)
        at += r.size
    }
    out
}

/// Compares the code point sequences `a` and `b`, returning `-1`, `0` or `1`.
///
/// Surrogate code points are weighted like unassigned code points, so a sequence that `str` cannot hold compares too.
pub fn compare_runes(c: Collator, a: u32[], b: u32[]) -> i64 {
    let x = weights_of(c.tailoring, c.settings, a)
    let y = weights_of(c.tailoring, c.settings, b)
    compare_weights(c.settings, x, y)
}

/// Compares `a` and `b`, returning `-1` when `a` sorts first, `1` when `b` does and `0` when they are equal at the collator's strength.
///
/// Each invalid UTF-8 byte compares as U+FFFD.
pub fn compare(c: Collator, a: str, b: str) -> i64 {
    if a == b {
        return 0
    }
    compare_runes(c, runes_of(a), runes_of(b))
}

/// Returns whether `a` and `b` are equal at the collator's strength.
pub fn equal(c: Collator, a: str, b: str) -> bool {
    compare(c, a, b) == 0
}

/// Returns the sort key of the code point sequence `s`.
///
/// Each weight is four bytes, most significant first, and each level ends with four zero bytes. Comparing two keys byte by byte gives the result of `compare_runes`.
pub fn sort_key_runes(c: Collator, s: u32[]) -> u8[] {
    key_of(c.settings, weights_of(c.tailoring, c.settings, s))
}

/// Returns the sort key of `s`, which compares bytewise as `compare` compares strings.
pub fn sort_key(c: Collator, s: str) -> u8[] {
    sort_key_runes(c, runes_of(s))
}

/// Sorts `xs` in place by `compare`.
pub fn sort(c: Collator, mut xs: str[]) {
    slices.sort_by(mut xs, fn(a: str, b: str) -> bool { compare(c, a, b) < 0 })
}
