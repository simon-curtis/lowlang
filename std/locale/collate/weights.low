const level_primary = 1
const level_secondary = 2
const level_tertiary = 3
const level_quaternary = 4
const level_identical = 5

const lower_case_after = 0x1000000
const case_off = 0
const case_upper = 1
const case_lower = 2
const quaternary_common = 0xFFFF0000
const lowest_primary = 0x10000

struct Settings {
    shifted: bool
    strength: i64
    backwards: bool
    case_first: i64
    numeric: bool
    reorder: Reorder
}

struct Weights {
    l1: []i64
    l2: []i64
    l3: []i64
    l4: []i64
    normalized: []u32
}

fn weights_of(t: Tailoring, s: Settings, runes: []u32) -> Weights {
    let normalized = decomposed(runes)
    let ces = elements(t, s.numeric, normalized)
    var w = Weights { l1: [], l2: [], l3: [], l4: [], normalized }
    var after_variable = false
    for ce in ces {
        var p = reordered_primary(s.reorder, ce.p)
        var sec = ce.s
        var ter = ce.t
        var quat = 0
        if s.shifted && ce.variable {
            quat = p
            p = 0
            sec = 0
            ter = 0
            after_variable = true
        } else if s.shifted && p == 0 && after_variable {
            sec = 0
            ter = 0
        } else {
            if p != 0 {
                after_variable = false
            }
            if p == lowest_primary {
                quat = p
            } else if sec != 0 || ter != 0 {
                quat = quaternary_common
            }
        }
        if s.case_first != case_off && ter != 0 && ce.upper == (s.case_first == case_lower) {
            ter += lower_case_after
        }
        if p != 0 {
            push(mut w.l1, p)
        }
        if sec != 0 {
            push(mut w.l2, sec)
        }
        if ter != 0 {
            push(mut w.l3, ter)
        }
        if quat != 0 {
            push(mut w.l4, quat)
        }
    }
    w
}

fn compare_level(a: []i64, b: []i64, reversed: bool) -> i64 {
    let n = if a.len < b.len { a.len } else { b.len }
    for i in 0..n {
        let x = if reversed { a[a.len - 1 - i] } else { a[i] }
        let y = if reversed { b[b.len - 1 - i] } else { b[i] }
        if x != y {
            return if x < y { -1 } else { 1 }
        }
    }
    if a.len == b.len {
        return 0
    }
    if a.len < b.len { -1 } else { 1 }
}

fn compare_runes_of(a: []u32, b: []u32) -> i64 {
    let n = if a.len < b.len { a.len } else { b.len }
    for i in 0..n {
        if a[i] != b[i] {
            return if a[i] < b[i] { -1 } else { 1 }
        }
    }
    if a.len == b.len {
        return 0
    }
    if a.len < b.len { -1 } else { 1 }
}

fn compare_weights(s: Settings, x: Weights, y: Weights) -> i64 {
    var r = compare_level(x.l1, y.l1, false)
    if r != 0 || s.strength == level_primary {
        return r
    }
    r = compare_level(x.l2, y.l2, s.backwards)
    if r != 0 || s.strength == level_secondary {
        return r
    }
    r = compare_level(x.l3, y.l3, false)
    if r != 0 || s.strength == level_tertiary {
        return r
    }
    r = compare_level(x.l4, y.l4, false)
    if r != 0 || s.strength == level_quaternary {
        return r
    }
    compare_runes_of(x.normalized, y.normalized)
}

fn put_word(mut out: []u8, v: i64) {
    push(mut out, u8(v >> 24))
    push(mut out, u8(v >> 16))
    push(mut out, u8(v >> 8))
    push(mut out, u8(v))
}

fn put_level(mut out: []u8, level: []i64, reversed: bool) {
    for i in 0..level.len {
        put_word(mut out, if reversed { level[level.len - 1 - i] } else { level[i] })
    }
    put_word(mut out, 0)
}

fn key_of(s: Settings, w: Weights) -> []u8 {
    var out: []u8 = []
    put_level(mut out, w.l1, false)
    if s.strength >= level_secondary {
        put_level(mut out, w.l2, s.backwards)
    }
    if s.strength >= level_tertiary {
        put_level(mut out, w.l3, false)
    }
    if s.strength >= level_quaternary {
        put_level(mut out, w.l4, false)
    }
    if s.strength >= level_identical {
        for c in w.normalized {
            put_word(mut out, i64(c))
        }
    }
    out
}
