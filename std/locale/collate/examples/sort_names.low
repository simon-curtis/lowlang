import std/locale
import std/locale/collate
import std/text

fn sorted(tag: str, o: collate.Options) {
    let l = locale.parse(tag) or locale.root()
    var names = ["Zoë", "Ångström", "Zorro", "Aaron", "Äpfel", "Oscar", "Ödön", "Noah", "ñandú", "a10", "a2"]
    let c = collate.for_locale(l, o)
    collate.sort(c, mut names)
    print("{tag}: {text.join(names, ", ")}")
}

fn main() {
    sorted("en", collate.options())
    sorted("sv", collate.options())
    sorted("de", collate.options())
    var numeric = collate.options()
    numeric.numeric = true
    sorted("en", numeric)
    let c = collate.root(collate.options())
    print("{collate.compare(c, "cafe", "café")} {collate.equal(c, "a", "a")}")
    var ignore_case = collate.options()
    ignore_case.strength = collate.Strength.Secondary
    let loose = collate.root(ignore_case)
    print("{collate.equal(loose, "Straße", "STRASSE")} {collate.equal(loose, "résumé", "resume")}")
}
