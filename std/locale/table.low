fn line_start(table: str, at: i64) -> i64 {
    var i = at
    for i > 0 && table[i - 1] != '\n' {
        i -= 1
    }
    i
}

fn line_end(table: str, from: i64) -> i64 {
    var i = from
    for i < table.len && table[i] != '\n' {
        i += 1
    }
    i
}

fn key_end(table: str, start: i64, end: i64) -> i64 {
    var i = start
    for i < end && table[i] != ' ' {
        i += 1
    }
    i
}

fn compare_key(table: str, start: i64, end: i64, key: str) -> i64 {
    let k = key_end(table, start, end)
    let first = table[start..k]
    if first == key {
        return 0
    }
    if first < key { -1 } else { 1 }
}

fn first_line(table: str, key: str) -> i64 {
    var lo = 0
    var hi = table.len
    var found = -1
    for lo < hi {
        let mid = (lo + hi) / 2
        let start = line_start(table, mid)
        let end = line_end(table, start)
        let order = compare_key(table, start, end, key)
        if order < 0 {
            lo = end + 1
        } else {
            if order == 0 {
                found = start
            }
            hi = start
        }
    }
    found
}

/// Returns the text after the key on the first line of `table` that starts with `key` followed by a space or the end of the line.
///
/// A table is lines sorted bytewise, each starting with a key that holds no space. The result is empty when the line holds only the key, and `none` when no line has the key.
pub fn lookup(table: str, key: str) -> str? {
    let start = first_line(table, key)
    if start < 0 {
        return none
    }
    let end = line_end(table, start)
    let k = key_end(table, start, end)
    if k < end { table[k + 1..end] } else { "" }
}

/// Returns the text after the key on every line of `table` that starts with `key`, in table order.
pub fn lookup_all(table: str, key: str) -> str[] {
    var out: str[] = []
    var start = first_line(table, key)
    if start < 0 {
        return out
    }
    for start < table.len {
        let end = line_end(table, start)
        if compare_key(table, start, end, key) != 0 {
            break
        }
        let k = key_end(table, start, end)
        out.push(if k < end { table[k + 1..end] } else { "" })
        start = end + 1
    }
    out
}
