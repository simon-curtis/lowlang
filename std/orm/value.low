import std/json
import std/serde
import std/sql
import std/text

struct Recorder {
    names: []str
    values: []sql.Value
    depth: i64
    nested: *json.Writer?
    events: serde.Writer?
}

fn recorder(depth: i64) -> *Recorder {
    new(Recorder { names: [], values: [], depth, nested: none, events: none })
}

fn nested(r: *Recorder) -> serde.Writer {
    match r.events {
        some(e) => e
        none => {
            let w = json.writer(0)
            let e = json.events(w, Unchanged)
            r.nested = w
            r.events = e
            e
        }
    }
}

fn scalar(r: *Recorder, v: sql.Value, forward: fn(serde.Writer)) {
    if r.depth == 1 {
        push(mut r.values, v)
        return
    }
    forward(nested(r))
}

fn open(r: *Recorder, forward: fn(serde.Writer)) {
    if r.depth >= 1 {
        forward(nested(r))
    }
    r.depth += 1
}

fn shut(r: *Recorder, forward: fn(serde.Writer)) {
    r.depth -= 1
    if r.depth >= 1 {
        forward(nested(r))
    }
    if r.depth == 1 {
        match r.nested {
            some(w) => push(mut r.values, sql.Value.Text(json.written_text(w)))
            none => {}
        }
        r.nested = none
        r.events = none
    }
}

fn recording(r: *Recorder) -> serde.Writer {
    serde.Writer {
        null: fn() { scalar(r, sql.Value.Null, fn(w) { w.null() }) }
        boolean: fn(b) { scalar(r, sql.Value.Bool(b), fn(w) { w.boolean(b) }) }
        integer: fn(n) { scalar(r, sql.Value.Int(n), fn(w) { w.integer(n) }) }
        unsigned: fn(n) {
            let v = if n > 0x7FFFFFFFFFFFFFFF { sql.Value.Decimal("{n}") } else { sql.Value.Int(i64(n)) }
            scalar(r, v, fn(w) { w.unsigned(n) })
        }
        float: fn(x) { scalar(r, sql.Value.Float(x), fn(w) { w.float(x) }) }
        text: fn(s) { scalar(r, sql.Value.Text(s), fn(w) { w.text(s) }) }
        binary: fn(b) { scalar(r, sql.Value.Bytes(b), fn(w) { w.binary(b) }) }
        begin_seq: fn() { open(r, fn(w) { w.begin_seq() }) }
        end_seq: fn() { shut(r, fn(w) { w.end_seq() }) }
        begin_map: fn() { open(r, fn(w) { w.begin_map() }) }
        key: fn(k) { nested(r).key(k) }
        end_map: fn() { shut(r, fn(w) { w.end_map() }) }
        begin_struct: fn() { open(r, fn(w) { w.begin_struct() }) }
        field: fn(name) {
            if r.depth == 1 {
                push(mut r.names, name)
            } else {
                nested(r).field(name)
            }
        }
        end_struct: fn() { shut(r, fn(w) { w.end_struct() }) }
        unit_variant: fn(v) { scalar(r, sql.Value.Text(v), fn(w) { w.unit_variant(v) }) }
        begin_variant: fn(v) { open(r, fn(w) { w.begin_variant(v) }) }
        end_variant: fn() { shut(r, fn(w) { w.end_variant() }) }
    }
}

/// Returns the `sql.Value` that stores `v` in a column.
///
/// Booleans, integers, floats, strings and byte slices become the matching `Value` variants. A `u64` above the `i64` maximum becomes `Decimal`, a unit enum variant becomes `Text` holding its name, and `none` becomes `Null`. Structs, sequences, maps and enum variants with data become `Text` holding their JSON.
pub fn value_of[F](v: F) -> sql.Value {
    let r = recorder(1)
    serde.write(v, recording(r))
    if r.values.len == 0 { sql.Value.Null } else { r.values[0] }
}

struct Columns {
    names: []str
    values: []sql.Value
}

fn columns_of[T](v: T) -> Columns {
    let r = recorder(0)
    serde.write(v, recording(r))
    Columns { names: r.names, values: r.values }
}

fn text_of(v: sql.Value) -> str {
    match v {
        Null => "null"
        Bool(b) => if b { "true" } else { "false" }
        Int(n) => "{n}"
        Float(x) => "{x}"
        Decimal(d) => d
        Text(s) => s
        Bytes(b) => text.encode_hex(b)
        Uuid(b) => text.encode_hex(b)
        Date(d) => "{d}"
        Time(t) => "{t}"
        Timestamp(t) => "{t}"
        TimestampTz(t) => "{t}"
    }
}
