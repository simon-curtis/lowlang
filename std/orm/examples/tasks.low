import std/orm
import std/sql
import std/sql/sqlite

enum Status {
    Open
    Done
}

struct Task {
    id: i64
    title: str
    owner: str?
    priority: i32
    status: Status
    labels: []str
}

fn show(t: Task) {
    print("{t.id} {t.title} owner={t.owner ?? "-"} priority={t.priority} {t.status} labels={t.labels.len}")
}

/// Stores structs in a SQLite table, queries them with typed conditions and updates one inside a transaction.
fn main() ! sql.Error {
    using c = sqlite.connect(sql.Options { database: ":memory:" })?
    let db = c.handle
    let tasks = orm.table[Task]("tasks")
    orm.create_table(db, tasks)?

    orm.insert(db, tasks, Task { id: 0, title: "write docs", owner: "ada", priority: 2, status: Open, labels: ["docs"] })?
    orm.insert(db, tasks, Task { id: 0, title: "fix lexer", owner: none, priority: 5, status: Open, labels: ["bug", "parser"] })?
    orm.insert(db, tasks, Task { id: 0, title: "tag release", owner: "grace", priority: 1, status: Done, labels: [] })?

    let open = orm.filter(orm.from(tasks), orm.eq(Task.status, Open))
    print("open: {orm.count(db, open)?}")
    for t in orm.list(db, orm.order_by_desc(open, Task.priority))? {
        show(t)
    }

    let unassigned = orm.filter(orm.from(tasks), orm.is_null(Task.owner))
    print(orm.to_sql(db.dialect, unassigned))
    let found = orm.first(db, unassigned)? ?? fail sql.Error.Conversion
    show(found)

    orm.transaction(db, fn() ! sql.Error {
        var claimed = found
        claimed.owner = "ada"
        claimed.status = Done
        orm.update(db, tasks, claimed)?
    })?
    let after = orm.find(db, tasks, found.id)? ?? fail sql.Error.Conversion
    show(after)

    let removed = orm.delete_matching(db, orm.filter(orm.from(tasks), orm.lt(Task.priority, 2)))?
    print("removed {removed}, left {orm.count(db, orm.from(tasks))?}")
}
