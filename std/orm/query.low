import std/serde
import std/slices
import std/sql

/// A database table that stores values of type `T`, one column per field of `T`.
///
/// Fields of `T` map to columns of the same name. Scalars, strings, byte slices and unit enums are stored natively; other values, such as structs, sequences, maps and enum variants with data, are stored as JSON text.
pub struct Table[T] {
    /// The table name, quoted for the dialect when it is used.
    pub name: str
    /// The column that holds the primary key. Defaults to `id`.
    pub key: str = "id"
}

/// Returns the table `name` for `T`, with `id` as its key column.
pub fn table[T](name: str) -> Table[T] {
    Table { name }
}

/// How a column is compared with a value.
pub enum Op {
    /// The column equals the value.
    Eq
    /// The column differs from the value, rendered as `<>`.
    Ne
    /// The column is less than the value.
    Lt
    /// The column is less than or equal to the value.
    Le
    /// The column is greater than the value.
    Gt
    /// The column is greater than or equal to the value.
    Ge
    /// The column matches the value as a SQL `LIKE` pattern.
    Like
}

/// A condition on the rows of a table `T`, rendered into a `WHERE` clause with every value passed as a statement parameter.
///
/// Build conditions with `eq`, `lt`, `not`, the `All` and `Any` variants and the other functions of this module.
pub enum Condition[T] {
    /// The column compared with a value by `op`.
    Compare(column: str, op: Op, value: sql.Value)
    /// The column is `NULL`.
    IsNull(column: str)
    /// The column is not `NULL`.
    NotNull(column: str)
    /// The column equals one of the values. An empty list matches no row.
    OneOf(column: str, values: []sql.Value)
    /// Every part holds. An empty list matches every row.
    All(parts: []Condition[T])
    /// At least one part holds. An empty list matches no row.
    Any(parts: []Condition[T])
    /// The inner condition does not hold.
    Not(inner: *Condition[T])
    /// A SQL fragment in which each `?` is replaced by the next value as a parameter.
    ///
    /// A `?` with no value left stays in the text as written. The text itself is not checked or quoted.
    Raw(text: str, values: []sql.Value)
}

fn compare[T, F](f: serde.Field[T, F], op: Op, v: F) -> Condition[T] {
    Compare(f.name, op, value_of(v))
}

/// Returns the condition that field `f` equals `v`.
///
/// The value is converted as `value_of` does. A `none` value compares with `NULL` and matches no row; use `is_null` to test for it.
pub fn eq[T, F: Eq](f: serde.Field[T, F], v: F) -> Condition[T] {
    compare(f, Eq, v)
}

/// Returns the condition that field `f` differs from `v`.
///
/// Rows where the field is `NULL` do not match.
pub fn ne[T, F: Eq](f: serde.Field[T, F], v: F) -> Condition[T] {
    compare(f, Ne, v)
}

/// Returns the condition that field `f` is less than `v`.
pub fn lt[T, F: Ord](f: serde.Field[T, F], v: F) -> Condition[T] {
    compare(f, Lt, v)
}

/// Returns the condition that field `f` is less than or equal to `v`.
pub fn le[T, F: Ord](f: serde.Field[T, F], v: F) -> Condition[T] {
    compare(f, Le, v)
}

/// Returns the condition that field `f` is greater than `v`.
pub fn gt[T, F: Ord](f: serde.Field[T, F], v: F) -> Condition[T] {
    compare(f, Gt, v)
}

/// Returns the condition that field `f` is greater than or equal to `v`.
pub fn ge[T, F: Ord](f: serde.Field[T, F], v: F) -> Condition[T] {
    compare(f, Ge, v)
}

/// Returns the condition that string field `f` matches the SQL `LIKE` pattern `pattern`.
///
/// `%` matches any run of characters and `_` one character. Case sensitivity follows the database.
pub fn like[T](f: serde.Field[T, str], pattern: str) -> Condition[T] {
    Compare(f.name, Like, sql.Value.Text(pattern))
}

/// Returns the condition that the optional field `f` is `NULL`.
pub fn is_null[T, F](f: serde.Field[T, F?]) -> Condition[T] {
    IsNull(f.name)
}

/// Returns the condition that the optional field `f` is not `NULL`.
pub fn not_null[T, F](f: serde.Field[T, F?]) -> Condition[T] {
    NotNull(f.name)
}

/// Returns the condition that field `f` equals one of `values`.
///
/// An empty `values` matches no row.
pub fn one_of[T, F](f: serde.Field[T, F], values: []F) -> Condition[T] {
    var out: []sql.Value = []
    for v in values {
        push(mut out, value_of(v))
    }
    OneOf(f.name, out)
}

/// Returns the condition that `c` does not hold.
pub fn not[T](c: Condition[T]) -> Condition[T] {
    Not(new(c))
}

/// Returns a condition from the SQL fragment `text`, replacing each `?` with the next of `values` as a parameter.
///
/// The text is sent as written, so never build it from untrusted input; pass such input as `values`.
pub fn raw[T](text: str, values: []sql.Value) -> Condition[T] {
    Raw(text, values)
}

struct Order {
    column: str
    descending: bool
}

/// A select over a `Table[T]`, built from `from` by adding conditions, ordering and paging.
///
/// A `Query` is a copyable value; each function returns a changed copy and leaves its argument alone.
pub struct Query[T] {
    table: Table[T]
    filters: []Condition[T]
    orders: []Order
    count: i64
    offset: i64
}

/// Returns the query that selects every row of `t`, in database order and without limit.
pub fn from[T](t: Table[T]) -> Query[T] {
    Query { table: t, filters: [], orders: [], count: -1, offset: 0 }
}

/// Returns `q` with `c` added.
///
/// All conditions of a query must hold.
pub fn filter[T](q: Query[T], c: Condition[T]) -> Query[T] {
    var out = q
    var filters = slices.clone(q.filters)
    push(mut filters, c)
    out.filters = filters
    out
}

fn ordered[T](q: Query[T], column: str, descending: bool) -> Query[T] {
    var out = q
    var orders = slices.clone(q.orders)
    push(mut orders, Order { column, descending })
    out.orders = orders
    out
}

/// Returns `q` ordered by field `f` ascending, after any earlier ordering.
pub fn order_by[T, F](q: Query[T], f: serde.Field[T, F]) -> Query[T] {
    ordered(q, f.name, false)
}

/// Returns `q` ordered by field `f` descending, after any earlier ordering.
pub fn order_by_desc[T, F](q: Query[T], f: serde.Field[T, F]) -> Query[T] {
    ordered(q, f.name, true)
}

/// Returns `q` limited to `n` rows.
///
/// A negative `n` removes the limit. Without an ordering, which rows come first is up to the database.
pub fn take[T](q: Query[T], n: i64) -> Query[T] {
    var out = q
    out.count = n
    out
}

/// Returns `q` that skips the first `n` rows of the result.
///
/// A value of zero or less skips nothing.
pub fn skip[T](q: Query[T], n: i64) -> Query[T] {
    var out = q
    out.offset = n
    out
}

struct Statement {
    text: []u8
    values: []sql.Value
    dialect: sql.Dialect
}

fn statement(d: sql.Dialect) -> *Statement {
    new(Statement { text: [], values: [], dialect: d })
}

fn emit(s: *Statement, part: str) {
    __extend(mut s.text, part)
}

fn bind(s: *Statement, v: sql.Value) {
    emit(s, sql.placeholder(s.dialect, s.values.len))
    push(mut s.values, v)
}

fn name(s: *Statement, identifier: str) {
    emit(s, sql.quote_identifier(s.dialect, identifier))
}

fn op_text(op: Op) -> str {
    match op {
        Eq => " = "
        Ne => " <> "
        Lt => " < "
        Le => " <= "
        Gt => " > "
        Ge => " >= "
        Like => " LIKE "
    }
}

fn render[T](s: *Statement, c: Condition[T]) {
    match c {
        Compare(column, op, value) => {
            name(s, column)
            emit(s, op_text(op))
            bind(s, value)
        }
        IsNull(column) => {
            name(s, column)
            emit(s, " IS NULL")
        }
        NotNull(column) => {
            name(s, column)
            emit(s, " IS NOT NULL")
        }
        OneOf(column, values) => {
            if values.len == 0 {
                emit(s, "1 = 0")
                return
            }
            name(s, column)
            emit(s, " IN (")
            for i, v in values {
                if i > 0 {
                    emit(s, ", ")
                }
                bind(s, v)
            }
            emit(s, ")")
        }
        All(parts) => join_conditions(s, parts, " AND ", "1 = 1")
        Any(parts) => join_conditions(s, parts, " OR ", "1 = 0")
        Not(inner) => {
            emit(s, "NOT (")
            render(s, *inner)
            emit(s, ")")
        }
        Raw(text, values) => {
            var at = 0
            var next = 0
            for i in 0..text.len {
                if text[i] == '?' && next < values.len {
                    emit(s, text[at..i])
                    bind(s, values[next])
                    next += 1
                    at = i + 1
                }
            }
            emit(s, text[at..])
        }
    }
}

fn join_conditions[T](s: *Statement, parts: []Condition[T], separator: str, empty: str) {
    if parts.len == 0 {
        emit(s, empty)
        return
    }
    for i, p in parts {
        if i > 0 {
            emit(s, separator)
        }
        emit(s, "(")
        render(s, p)
        emit(s, ")")
    }
}

fn column_names[T]() -> []str {
    var out: []str = []
    for p in serde.schema[T]().fields {
        push(mut out, p.name)
    }
    out
}

fn where_clause[T](s: *Statement, q: Query[T]) {
    if q.filters.len > 0 {
        emit(s, " WHERE ")
        render(s, Condition.All(q.filters))
    }
}

fn from_where[T](s: *Statement, q: Query[T]) {
    emit(s, " FROM ")
    name(s, q.table.name)
    where_clause(s, q)
}

fn count_sql[T](d: sql.Dialect, q: Query[T]) -> *Statement {
    let s = statement(d)
    emit(s, "SELECT COUNT(*)")
    from_where(s, q)
    s
}

fn select_sql[T](d: sql.Dialect, q: Query[T]) -> *Statement {
    let s = statement(d)
    emit(s, "SELECT ")
    for i, c in column_names[T]() {
        if i > 0 {
            emit(s, ", ")
        }
        name(s, c)
    }
    from_where(s, q)
    if q.orders.len > 0 {
        emit(s, " ORDER BY ")
        for i, o in q.orders {
            if i > 0 {
                emit(s, ", ")
            }
            name(s, o.column)
            if o.descending {
                emit(s, " DESC")
            }
        }
    }
    let paged = q.count >= 0 || q.offset > 0
    match d.paging {
        Limit => {
            if q.count >= 0 {
                emit(s, " LIMIT {q.count}")
            }
            if q.offset > 0 {
                emit(s, " OFFSET {q.offset}")
            }
        }
        LimitOffset => {
            if paged {
                emit(s, " LIMIT {q.count} OFFSET {q.offset}")
            }
        }
        OffsetFetch => {
            if paged {
                if q.orders.len == 0 {
                    emit(s, " ORDER BY (SELECT NULL)")
                }
                emit(s, " OFFSET {q.offset} ROWS")
                if q.count >= 0 {
                    emit(s, " FETCH NEXT {q.count} ROWS ONLY")
                }
            }
        }
    }
    s
}

/// Returns the `SELECT` statement for `q` in dialect `d`, with placeholders in place of its values.
///
/// The values are not returned, so the text is for inspection. Paging is written as `LIMIT` and `OFFSET` on Postgres and SQLite, and as `OFFSET ... FETCH NEXT` on SQL Server, which gets `ORDER BY (SELECT NULL)` when the query has no ordering.
pub fn to_sql[T](d: sql.Dialect, q: Query[T]) -> str {
    __str_view(select_sql(d, q).text)
}
