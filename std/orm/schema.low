import std/otel
import std/serde
import std/slices
import std/sql

fn unit_enum(s: serde.Schema) -> bool {
    s.variants.all(fn(v) v.fields.len == 0)
}

fn column_type(d: sql.Dialect, s: serde.Schema) -> str {
    let types = d.types
    match s.kind {
        Bool => types.boolean
        Int => if s.bits > 32 { types.large } else if s.bits > 16 { types.medium } else { types.small }
        Uint => if s.bits == 64 { types.unsigned_large } else if s.bits > 16 { types.large } else { types.medium }
        Float => if s.bits == 32 { types.single } else { types.double }
        Text => types.text
        Binary => types.binary
        Optional => column_type(d, s.items[0])
        Enum => if unit_enum(s) { types.enumeration } else { types.document }
        _ => types.document
    }
}

fn nullable(s: serde.Schema) -> bool {
    match s.kind {
        Optional => true
        _ => false
    }
}

/// Returns the `CREATE TABLE` statement for `t` in dialect `d`.
///
/// Columns follow the fields of `T` and are `NOT NULL` unless the field is optional. The column types come from `d.types`. An integer key becomes an identity primary key; any other key becomes a plain `PRIMARY KEY` column, with the short text type for a string key. Booleans, integers, floats, strings and byte slices get native types, a 64-bit unsigned integer gets the unsigned type and an enum of unit variants the enumeration type. Every other field gets the document type: `jsonb` on Postgres, `nvarchar(max)` on SQL Server and `TEXT` on SQLite.
pub fn create_table_sql[T](d: sql.Dialect, t: Table[T]) -> str {
    let s = statement(d)
    emit(s, "CREATE TABLE ")
    name(s, t.name)
    emit(s, " (")
    for i, p in serde.schema[T]().fields {
        if i > 0 {
            emit(s, ", ")
        }
        name(s, p.name)
        emit(s, " ")
        let key = p.name == t.key
        if key && p.schema.kind == Int {
            emit(s, d.types.identity)
        } else if key && p.schema.kind == Text {
            emit(s, d.types.short_text)
        } else {
            emit(s, column_type(d, p.schema))
        }
        if key {
            emit(s, " PRIMARY KEY")
        } else if !nullable(p.schema) {
            emit(s, " NOT NULL")
        }
    }
    emit(s, ")")
    __str_view(s.text)
}

/// Creates the table for `t` on `db`.
///
/// Fails with the database error, including when the table already exists.
pub fn create_table[T](db: sql.ConnectionHandle, t: Table[T]) ! sql.Error {
    otel.sql_execute(db, "std/orm", "CREATE TABLE", t.name, create_table_sql(db.dialect, t), [])?
}

/// Drops the table of `t` on `db` if it exists.
pub fn drop_table[T](db: sql.ConnectionHandle, t: Table[T]) ! sql.Error {
    let s = statement(db.dialect)
    emit(s, "DROP TABLE IF EXISTS ")
    name(s, t.name)
    otel.sql_execute(db, "std/orm", "DROP TABLE", t.name, __str_view(s.text), [])?
}
