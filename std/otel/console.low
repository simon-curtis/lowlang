import std/io
import std/slices
import std/sys
import std/text

/// Returns a function that writes a line and a newline to standard error.
/// Short writes and interrupted writes are repeated, and a write that fails returns its error.
pub fn stderr_writer() -> fn(str) ! io.Error {
    fn(line: str) ! io.Error {
        let data = bytes("{line}\n")
        sys.write_all(2, data)?
    }
}

fn kind_name(k: Kind) -> str {
    match k {
        Internal => "internal"
        Server => "server"
        Client => "client"
        Producer => "producer"
        Consumer => "consumer"
    }
}

fn status_name(s: Status) -> str {
    match s {
        Unset => "unset"
        Ok => "ok"
        Failed(m) => "error({m})"
    }
}

fn with_attributes(head: str, attributes: []Attribute) -> str {
    if attributes.len == 0 {
        return head
    }
    "{head} {format_attributes(attributes)}"
}

/// Returns the lines that describe a span.
/// The first line is `span <scope> "<name>" <kind> trace=<id> span=<id> parent=<id or -> start=<ns> duration=<ns>ns status=<status>` followed by the attributes as `key=value`. Each event adds a line starting `  event` and each link a line starting `  link`.
pub fn format_span(d: *SpanData) -> []str {
    let parent = if valid(d.parent) { span_id_hex(d.parent) } else { "-" }
    var lines: []str = [with_attributes("span {d.scope.name} \"{d.name}\" {kind_name(d.kind)} trace={trace_id_hex(d.context)} span={span_id_hex(d.context)} parent={parent} start={d.start} duration={d.end - d.start}ns status={status_name(d.status)}", d.attributes)]
    for e in d.events {
        push(mut lines, with_attributes("  event \"{e.name}\" at={e.time}", e.attributes))
    }
    for l in d.links {
        push(mut lines, with_attributes("  link trace={trace_id_hex(l.context)} span={span_id_hex(l.context)}", l.attributes))
    }
    lines
}

fn temporality_name(t: Temporality) -> str {
    match t {
        Cumulative => "cumulative"
        Delta => "delta"
    }
}

/// Returns the lines that describe a metric.
/// The first line gives the scope, name, kind, temporality and unit, and each data point adds an indented line with its value, or for a histogram its count, sum, minimum, maximum and bucket counts, followed by its attributes. A gauge has no temporality.
pub fn format_metric(m: MetricData) -> []str {
    let kind = match m.kind {
        Sum => if m.monotonic { "sum monotonic" } else { "sum" }
        Gauge => "gauge"
        Histogram => "histogram"
    }
    let temporality = match m.kind {
        Gauge => ""
        _ => " {temporality_name(m.temporality)}"
    }
    var lines: []str = ["metric {m.scope.name} {m.name} {kind}{temporality} unit={m.unit}"]
    for p in m.points {
        let value = match m.kind {
            Histogram => {
                var counts: []str = []
                for b in p.buckets {
                    push(mut counts, "{b}")
                }
                "count={p.count} sum={p.sum} min={p.min} max={p.max} buckets=[{text.join(counts, ",")}]"
            }
            _ => if m.integer { "value={p.int_value}" } else { "value={p.double_value}" }
        }
        push(mut lines, with_attributes("  {value}", p.attributes))
    }
    lines
}

/// Returns the line that describes a log record: `log <scope> <severity> "<body>"`, then the trace and span ids when the record has a span, then the attributes.
pub fn format_log(d: *LogData) -> str {
    let correlation = if valid(d.context) { " trace={trace_id_hex(d.context)} span={span_id_hex(d.context)}" } else { "" }
    with_attributes("log {d.scope.name} {d.record.severity_text} \"{format_value(d.record.body)}\"{correlation}", d.record.attributes)
}

fn write_lines(write: fn(str) ! io.Error, lines: []str) -> bool {
    for line in lines {
        write(line) or return false
    }
    true
}

/// Returns an exporter that passes each line from `format_span` to `write`.
/// `export` returns `false` when `write` fails, after which the remaining lines of the batch are not written; `shutdown` does nothing.
pub fn console_span_exporter(write: fn(str) ! io.Error) -> SpanExporter {
    SpanExporter {
        export: fn(spans) -> bool {
            spans.all(fn(d) write_lines(write, format_span(d)))
        }
        shutdown: fn() {}
    }
}

/// Returns an exporter that passes each line from `format_metric` to `write`.
/// `export` returns `false` when `write` fails, after which the remaining lines of the batch are not written; `shutdown` does nothing.
pub fn console_metric_exporter(write: fn(str) ! io.Error) -> MetricExporter {
    MetricExporter {
        export: fn(batch) -> bool {
            batch.metrics.all(fn(m) write_lines(write, format_metric(m)))
        }
        shutdown: fn() {}
    }
}

/// Returns an exporter that passes the line from `format_log` for each record to `write`.
/// `export` returns `false` when `write` fails, after which the remaining records of the batch are not written; `shutdown` does nothing.
pub fn console_log_exporter(write: fn(str) ! io.Error) -> LogExporter {
    LogExporter {
        export: fn(logs) -> bool {
            for d in logs {
                write(format_log(d)) or return false
            }
            true
        }
        shutdown: fn() {}
    }
}
