import std/text

/// A telemetry attribute value.
pub enum Value {
    /// No value.
    Empty
    /// A string.
    Str(value: str)
    /// A boolean.
    Bool(value: bool)
    /// A signed 64-bit integer.
    Int(value: i64)
    /// A 64-bit floating-point number.
    Double(value: f64)
    /// A byte string.
    Bytes(value: []u8)
    /// A list of values.
    Array(values: []Value)
    /// A nested set of attributes.
    Map(entries: []Attribute)
}

/// A key with a `Value`.
pub struct Attribute {
    /// The attribute name.
    pub key: str
    /// The attribute value.
    pub value: Value
}

/// Returns an attribute holding any `Value`.
pub fn attr(key: str, value: Value) -> Attribute {
    Attribute { key, value }
}

/// Returns an attribute holding the string `value`.
pub fn string(key: str, value: str) -> Attribute {
    Attribute { key, value: Str(value) }
}

/// Returns an attribute holding the integer `value`.
pub fn int(key: str, value: i64) -> Attribute {
    Attribute { key, value: Int(value) }
}

/// Returns an attribute holding the boolean `value`.
pub fn boolean(key: str, value: bool) -> Attribute {
    Attribute { key, value: Bool(value) }
}

/// Returns an attribute holding the floating-point `value`.
pub fn double(key: str, value: f64) -> Attribute {
    Attribute { key, value: Double(value) }
}

/// Returns an attribute holding the bytes `value`.
pub fn blob(key: str, value: []u8) -> Attribute {
    Attribute { key, value: Bytes(value) }
}

/// Returns an attribute holding an array of the strings in `values`.
pub fn strings(key: str, values: []str) -> Attribute {
    var out: []Value = []
    for v in values {
        push(mut out, Value.Str(v))
    }
    Attribute { key, value: Array(out) }
}

/// Returns an attribute holding an array of the integers in `values`.
pub fn ints(key: str, values: []i64) -> Attribute {
    var out: []Value = []
    for v in values {
        push(mut out, Value.Int(v))
    }
    Attribute { key, value: Array(out) }
}

/// Returns the value of the first attribute named `key`, or `none` when there is none.
pub fn lookup(attributes: []Attribute, key: str) -> Value? {
    for a in attributes {
        if a.key == key {
            return a.value
        }
    }
    none
}

fn upsert(mut attributes: []Attribute, a: Attribute, limit: i64) -> bool {
    for i, existing in attributes {
        if existing.key == a.key {
            attributes[i] = a
            return true
        }
    }
    if attributes.len >= limit {
        return false
    }
    push(mut attributes, a)
    true
}

fn limited(attributes: []Attribute, limit: i64) -> []Attribute {
    var out: []Attribute = []
    for a in attributes {
        upsert(mut out, a, limit)
    }
    out
}

/// Returns a readable text form of `v`.
/// Empty is the empty string, bytes are hexadecimal, an array is `[a, b]` and a map is `{key=value ...}`.
pub fn format_value(v: Value) -> str {
    match v {
        Empty => ""
        Str(s) => s
        Bool(b) => "{b}"
        Int(n) => "{n}"
        Double(x) => "{x}"
        Bytes(b) => text.encode_hex(b)
        Array(values) => {
            var parts: []str = []
            for x in values {
                push(mut parts, format_value(x))
            }
            "[{text.join(parts, ", ")}]"
        }
        Map(entries) => "{{{format_attributes(entries)}}}"
    }
}

/// Returns the attributes as `key=value` pairs separated by spaces, formatted with `format_value`.
pub fn format_attributes(attributes: []Attribute) -> str {
    var parts: []str = []
    for a in attributes {
        push(mut parts, "{a.key}={format_value(a.value)}")
    }
    text.join(parts, " ")
}

fn identity_value(mut out: []u8, v: Value) {
    match v {
        Empty => push(mut out, 'e')
        Str(s) => {
            push(mut out, 's')
            text.append(mut out, "{s.len}:")
            text.append(mut out, s)
        }
        Bool(b) => push(mut out, if b { 'T' } else { 'F' })
        Int(n) => text.append(mut out, "i{n};")
        Double(x) => text.append(mut out, "d{text.float_bits(x)};")
        Bytes(b) => {
            text.append(mut out, "b{b.len}:")
            __extend(mut out, __str_view(b))
        }
        Array(values) => {
            text.append(mut out, "a{values.len}:")
            for x in values {
                identity_value(mut out, x)
            }
        }
        Map(entries) => {
            text.append(mut out, "m{entries.len}:")
            for a in sorted(entries) {
                text.append(mut out, "{a.key.len}:")
                text.append(mut out, a.key)
                identity_value(mut out, a.value)
            }
        }
    }
}

fn before(a: str, b: str) -> bool {
    let n = if a.len < b.len { a.len } else { b.len }
    for i in 0..n {
        if a[i] != b[i] {
            return a[i] < b[i]
        }
    }
    a.len < b.len
}

fn sorted(attributes: []Attribute) -> []Attribute {
    var out: []Attribute = []
    for a in attributes {
        push(mut out, a)
    }
    for i in 1..out.len {
        var j = i
        for j > 0 && before(out[j].key, out[j - 1].key) {
            let t = out[j]
            out[j] = out[j - 1]
            out[j - 1] = t
            j -= 1
        }
    }
    out
}

fn identity(attributes: []Attribute) -> str {
    var out: []u8 = []
    for a in sorted(attributes) {
        text.append(mut out, "{a.key.len}:")
        text.append(mut out, a.key)
        identity_value(mut out, a.value)
    }
    __str_view(out)
}
