import std/otel

struct Log {
    finished: []Finished
}

struct Finished {
    id: str
    parent: str
    name: str
    detail: str
}

fn collector(log: *Log) -> otel.SpanExporter {
    otel.SpanExporter {
        export: fn(spans) -> bool {
            for s in spans {
                let status = match s.status {
                    Unset => "unset"
                    Ok => "ok"
                    Failed(message) => "failed: {message}"
                }
                var detail = "status={status} {otel.format_attributes(s.attributes)}"
                for e in s.events {
                    detail = "{detail} | {e.name} {otel.format_attributes(e.attributes)}"
                }
                push(mut log.finished, Finished { id: otel.span_id_hex(s.context), parent: otel.span_id_hex(s.parent), name: s.name, detail })
            }
            true
        }
        shutdown: fn() {}
    }
}

fn name_of(done: []Finished, id: str) -> str {
    for f in done {
        if f.id == id {
            return f.name
        }
    }
    "(root)"
}

fn charge(card: str) -> bool {
    otel.span("charge", fn(s: otel.Span) -> bool {
        s.set_string("payment.card", card)
        if card == "expired" {
            s.record_exception("CardError", "card expired")
            s.set_status(otel.Status.Failed("declined"))
            return false
        }
        s.set_status(otel.Status.Ok)
        true
    })
}

fn checkout(card: str, items: i64) -> bool {
    otel.span("checkout", fn(s: otel.Span) -> bool {
        s.set_int("cart.items", items)
        otel.span("reserve", fn(r: otel.Span) { r.add_event("stock.checked", [otel.int("sku.count", items)]) })
        charge(card)
    })
}

/// Records nested spans through an in-memory exporter and prints the tree of what finished.
fn main() {
    let log = new(Log { finished: [] })
    let resource = new(otel.Resource { attributes: [otel.string("service.name", "shop")] })
    using sdk = otel.install(otel.Config { resource: some(resource), span_processors: [otel.simple_span_processor(collector(log))] })

    print("paid: {checkout("visa", 2)}")
    print("paid: {checkout("expired", 1)}")
    for f in log.finished {
        print("{f.name} under {name_of(log.finished, f.parent)}: {f.detail}")
    }
}
