import std/bits
import std/crypto/hash
import std/io

/// The failure of a BLAKE3 operation.
pub enum Error {
    /// The key is not 32 bytes.
    BadKey
}

struct Output {
    cv: []u32
    words: []u32
    counter: u64
    block_len: u32
    flags: u32
}

/// An incremental BLAKE3 hash computation.
///
/// Created by `hasher`, `keyed_hasher` or `derive_key_hasher`, fed with `update` and read with `finalize` or `finalize_at`.
pub struct Hasher {
    key: []u32
    cv: []u32
    chunk_counter: u64
    buf: []u8
    buf_len: i64
    blocks: i64
    flags: u32
    stack: []u32
    depth: i64
}

const chunk_start: u32 = 1
const chunk_end: u32 = 2
const parent: u32 = 4
const root: u32 = 8
const keyed_hash_flag: u32 = 16
const derive_key_context: u32 = 32
const derive_key_material: u32 = 64

fn initial_vector() -> []u32 {
    [0x6A09E667, 0xBB67AE85, 0x3C6EF372, 0xA54FF53A, 0x510E527F, 0x9B05688C, 0x1F83D9AB, 0x5BE0CD19]
}


fn mix(v: []u32, a: i64, b: i64, c: i64, d: i64, mx: u32, my: u32) {
    v[a] = v[a] + v[b] + mx
    v[d] = bits.rotr32(v[d] ^ v[a], 16)
    v[c] = v[c] + v[d]
    v[b] = bits.rotr32(v[b] ^ v[c], 12)
    v[a] = v[a] + v[b] + my
    v[d] = bits.rotr32(v[d] ^ v[a], 8)
    v[c] = v[c] + v[d]
    v[b] = bits.rotr32(v[b] ^ v[c], 7)
}

fn round(v: []u32, m: []u32) {
    mix(v, 0, 4, 8, 12, m[0], m[1])
    mix(v, 1, 5, 9, 13, m[2], m[3])
    mix(v, 2, 6, 10, 14, m[4], m[5])
    mix(v, 3, 7, 11, 15, m[6], m[7])
    mix(v, 0, 5, 10, 15, m[8], m[9])
    mix(v, 1, 6, 11, 12, m[10], m[11])
    mix(v, 2, 7, 8, 13, m[12], m[13])
    mix(v, 3, 4, 9, 14, m[14], m[15])
}

fn permute(m: []u32) {
    let order: []i64 = [2, 6, 3, 10, 7, 0, 4, 13, 1, 11, 12, 5, 9, 14, 15, 8]
    let copy: []u32 = __make(16)
    for i in 0..16 {
        copy[i] = m[order[i]]
    }
    for i in 0..16 {
        m[i] = copy[i]
    }
}

fn compress(cv: []u32, block: []u32, counter: u64, block_len: u32, flags: u32) -> []u32 {
    let iv = initial_vector()
    let v: []u32 = __make(16)
    let m: []u32 = __make(16)
    for i in 0..8 {
        v[i] = cv[i]
    }
    for i in 0..4 {
        v[8 + i] = iv[i]
    }
    for i in 0..16 {
        m[i] = block[i]
    }
    v[12] = u32(counter)
    v[13] = u32(counter >> 32)
    v[14] = block_len
    v[15] = flags
    for r in 0..7 {
        round(v, m)
        if r < 6 {
            permute(m)
        }
    }
    for i in 0..8 {
        v[i] ^= v[i + 8]
        v[i + 8] ^= cv[i]
    }
    v
}

fn chaining_value(o: Output) -> []u32 {
    let out = compress(o.cv, o.words, o.counter, o.block_len, o.flags)
    let cv: []u32 = __make(8)
    for i in 0..8 {
        cv[i] = out[i]
    }
    cv
}

fn block_words(buf: []u8, held: i64) -> []u32 {
    let words: []u32 = __make(16)
    let padded: []u8 = __make(64)
    __memmove(padded, buf[..held])
    for i in 0..16 {
        words[i] = io.u32_le(padded, 4 * i)
    }
    words
}

fn parent_output(left: []u32, right: []u32, key: []u32, flags: u32) -> Output {
    let words: []u32 = __make(16)
    for i in 0..8 {
        words[i] = left[i]
        words[8 + i] = right[i]
    }
    Output { cv: key, words, counter: 0, block_len: 64, flags: parent | flags }
}

fn start_flag(h: *Hasher) -> u32 {
    if h.blocks == 0 { chunk_start } else { 0 }
}

fn chunk_len(h: *Hasher) -> i64 {
    h.blocks * 64 + h.buf_len
}

fn chunk_output(h: *Hasher) -> Output {
    Output {
        cv: h.cv
        words: block_words(h.buf, h.buf_len)
        counter: h.chunk_counter
        block_len: u32(h.buf_len)
        flags: h.flags | start_flag(h) | chunk_end
    }
}

fn chunk_update(h: *Hasher, input: []u8) {
    var at = 0
    for at < input.len {
        if h.buf_len == 64 {
            let words = block_words(h.buf, 64)
            let out = compress(h.cv, words, h.chunk_counter, 64, h.flags | start_flag(h))
            for i in 0..8 {
                h.cv[i] = out[i]
            }
            h.blocks += 1
            h.buf_len = 0
        }
        let n = __memmove(h.buf[h.buf_len..], input[at..])
        h.buf_len += n
        at += n
    }
}

fn push_chunk_cv(h: *Hasher, cv: []u32, total_chunks: u64) {
    var carry = cv
    var remaining = total_chunks
    for remaining & 1 == 0 {
        h.depth -= 1
        let left: []u32 = __make(8)
        for i in 0..8 {
            left[i] = h.stack[h.depth * 8 + i]
        }
        carry = chaining_value(parent_output(left, carry, h.key, h.flags))
        remaining >>= 1
    }
    for i in 0..8 {
        h.stack[h.depth * 8 + i] = carry[i]
    }
    h.depth += 1
}

fn finish_chunk(h: *Hasher) {
    let cv = chaining_value(chunk_output(h))
    let total = h.chunk_counter + 1
    push_chunk_cv(h, cv, total)
    for i in 0..8 {
        h.cv[i] = h.key[i]
    }
    h.chunk_counter = total
    h.buf_len = 0
    h.blocks = 0
}

fn hasher_with(key: []u32, flags: u32) -> *Hasher {
    let cv: []u32 = __make(8)
    for i in 0..8 {
        cv[i] = key[i]
    }
    new(Hasher { key, cv, chunk_counter: 0, buf: __make(64), buf_len: 0, blocks: 0, flags, stack: __make(54 * 8), depth: 0 })
}

/// Returns a `Hasher` in the default hash mode.
pub fn hasher() -> *Hasher {
    hasher_with(initial_vector(), 0)
}

fn key_words(key: []u8) -> []u32 {
    let words: []u32 = __make(8)
    for i in 0..8 {
        words[i] = io.u32_le(key, 4 * i)
    }
    words
}

/// Returns a `Hasher` in keyed hash mode with the 32-byte `key`. Fails with `Error.BadKey` when `key` is not 32 bytes.
pub fn keyed_hasher(key: []u8) -> *Hasher ! Error {
    if key.len != 32 {
        fail BadKey
    }
    hasher_with(key_words(key), keyed_hash_flag)
}

/// Returns a `Hasher` in key derivation mode for `context`.
///
/// The key material is fed with `update`. `context` should be a fixed string that is unique to the application and purpose.
pub fn derive_key_hasher(context: str) -> *Hasher {
    let inner = hasher_with(initial_vector(), derive_key_context)
    update(inner, bytes(context))
    let context_key = finalize(inner, 32)
    hasher_with(key_words(context_key), derive_key_material)
}

/// Appends `data` to the input of `h`. It can be called any number of times, and empty `data` has no effect.
pub fn update(h: *Hasher, data: []u8) {
    var at = 0
    for at < data.len {
        if chunk_len(h) == 1024 {
            finish_chunk(h)
        }
        let want = 1024 - chunk_len(h)
        let take = if data.len - at < want { data.len - at } else { want }
        chunk_update(h, data[at..at + take])
        at += take
    }
}

fn root_output(h: *Hasher) -> Output {
    var out = chunk_output(h)
    var i = h.depth
    for i > 0 {
        i -= 1
        let left: []u32 = __make(8)
        for j in 0..8 {
            left[j] = h.stack[i * 8 + j]
        }
        out = parent_output(left, chaining_value(out), h.key, h.flags)
    }
    out
}

/// Returns `length` bytes of the extendable output of `h`, starting at byte `offset`.
///
/// `h` is not modified, so the call can be repeated and more input can be added afterwards. `offset` and `length` must not be negative.
pub fn finalize_at(h: *Hasher, offset: i64, length: i64) -> []u8 {
    let o = root_output(h)
    let out: []u8 = __make(length)
    var produced = 0
    var counter = u64(offset / 64)
    var skip = offset % 64
    for produced < length {
        let words = compress(o.cv, o.words, counter, o.block_len, o.flags | root)
        var i = skip
        for i < 64 && produced < length {
            out[produced] = u8(words[i / 4] >> u32(8 * (i % 4)))
            produced += 1
            i += 1
        }
        skip = 0
        counter += 1
    }
    out
}

/// Returns the first `length` bytes of the extendable output of `h`. A `length` of 32 is the standard BLAKE3 hash. `h` is not modified.
pub fn finalize(h: *Hasher, length: i64) -> []u8 {
    finalize_at(h, 0, length)
}

/// Returns an independent copy of `h` with the same mode and input so far.
pub fn clone(h: *Hasher) -> *Hasher {
    let c = hasher_with(h.key, h.flags)
    for i in 0..8 {
        c.cv[i] = h.cv[i]
    }
    c.chunk_counter = h.chunk_counter
    __memmove(c.buf, h.buf)
    c.buf_len = h.buf_len
    c.blocks = h.blocks
    __memmove(c.stack, h.stack)
    c.depth = h.depth
    c
}

/// Returns `length` bytes of the BLAKE3 extendable output for `data` in the default hash mode.
pub fn xof(data: []u8, length: i64) -> []u8 {
    let h = hasher()
    update(h, data)
    finalize(h, length)
}

/// Returns the 32-byte BLAKE3 hash of `data`.
pub fn sum(data: []u8) -> []u8 {
    xof(data, 32)
}

/// Returns the 32-byte BLAKE3 keyed hash of `data` under the 32-byte `key`. Fails with `Error.BadKey` when `key` is not 32 bytes.
pub fn keyed_hash(key: []u8, data: []u8) -> []u8 ! Error {
    let h = keyed_hasher(key)?
    update(h, data)
    finalize(h, 32)
}

/// Returns `length` bytes of key material derived from `material` under `context` with BLAKE3 key derivation mode.
pub fn derive_key(context: str, material: []u8, length: i64) -> []u8 {
    let h = derive_key_hasher(context)
    update(h, material)
    finalize(h, length)
}

fn digest_of(h: *Hasher) -> hash.Digest {
    hash.Digest {
        update: fn(data) { update(h, data) }
        finish: fn() -> []u8 { finalize(h, 32) }
        clone: fn() -> hash.Digest { digest_of(clone(h)) }
    }
}

fn new_digest() -> hash.Digest {
    digest_of(hasher())
}

/// Returns the `hash.Algorithm` for BLAKE3.
///
/// The name is `blake3`, the digest is 32 bytes and the block size is 64 bytes.
pub fn algorithm() -> hash.Algorithm {
    hash.Algorithm { name: "blake3", size: 32, block: 64, digest: new_digest }
}
