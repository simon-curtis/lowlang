import std/crypto/fhe/ring
import std/crypto/fhe/rlwe

fn same_shape(a: Ciphertext, b: Ciphertext) ! Error {
    if a.parts.len != b.parts.len || level(a) != level(b) {
        fail Error.Mismatch
    }
}

/// Returns an encryption of the sum of the plaintexts of `a` and `b`, which must be at one level with the same number of parts.
pub fn add(ctx: *Context, a: Ciphertext, b: Ciphertext) -> Ciphertext ! Error {
    same_shape(a, b)?
    var parts: ring.Poly[] = []
    for i in 0..a.parts.len {
        parts.push(ring.add(ctx.rlwe.q, a.parts[i], b.parts[i]))
    }
    Ciphertext { parts }
}

/// Returns an encryption of the difference of the plaintexts of `a` and `b`, which must be at one level with the same number of parts.
pub fn sub(ctx: *Context, a: Ciphertext, b: Ciphertext) -> Ciphertext ! Error {
    same_shape(a, b)?
    var parts: ring.Poly[] = []
    for i in 0..a.parts.len {
        parts.push(ring.sub(ctx.rlwe.q, a.parts[i], b.parts[i]))
    }
    Ciphertext { parts }
}

/// Returns an encryption of the negated plaintext of `a`.
pub fn negate(ctx: *Context, a: Ciphertext) -> Ciphertext {
    var parts: ring.Poly[] = []
    for p in a.parts {
        parts.push(ring.negate(ctx.rlwe.q, p))
    }
    Ciphertext { parts }
}

/// Returns an encryption of the plaintext of `a` plus the plaintext `p`.
pub fn add_plain(ctx: *Context, a: Ciphertext, p: Plaintext) -> Ciphertext {
    let lv = ctx.levels[level(a)]
    var parts: ring.Poly[] = [ring.add(lv.q, a.parts[0], scaled_plain(ctx, lv, p))]
    for i in 1..a.parts.len {
        parts.push(a.parts[i])
    }
    Ciphertext { parts }
}

/// Returns an encryption of the plaintext of `a` times the plaintext `p`, slot by slot when both are batched. The noise grows by about the size of `p` times the degree.
pub fn multiply_plain(ctx: *Context, a: Ciphertext, p: Plaintext) -> Ciphertext {
    let lv = ctx.levels[level(a)]
    let lifted = plain_lift(ctx, lv.q, p)
    ring.to_transform(lv.q, lifted)
    var parts: ring.Poly[] = []
    for part in a.parts {
        parts.push(ring.mul(lv.q, part, lifted))
    }
    Ciphertext { parts }
}

fn extended(lv: *Level, part: ring.Poly) -> ring.Poly {
    let coefficients = ring.clone(part)
    ring.from_transform(lv.q, coefficients)
    let aux = ring.extend(lv.to_aux, coefficients)
    ring.to_transform(lv.aux, aux)
    var residues: u64[][] = []
    for r in part.residues {
        residues.push(r)
    }
    for r in aux.residues {
        residues.push(r)
    }
    ring.Poly { residues }
}

fn scaled_down(lv: *Level, d: ring.Poly) -> ring.Poly {
    ring.from_transform(lv.joined, d)
    let in_aux = ring.Poly { residues: ring.scale(lv.product, d) }
    let back = ring.extend(lv.from_aux, in_aux)
    ring.to_transform(lv.q, back)
    back
}

/// Returns an encryption of the product of the plaintexts of `a` and `b`, two ciphertexts of two parts at one level, as three parts that decrypt under `1, s, s^2`.
///
/// This is the tensor product of Fan and Vercauteren computed with the method of Halevi, Polyakov and Shoup: both ciphertexts are extended exactly to the auxiliary primes, multiplied there, scaled by `t / Q` with rounding into the auxiliary primes and extended back. `relinearize` brings the result back to two parts.
pub fn multiply(ctx: *Context, a: Ciphertext, b: Ciphertext) -> Ciphertext ! Error {
    same_shape(a, b)?
    if a.parts.len != 2 {
        fail Error.Mismatch
    }
    let lv = ctx.levels[level(a)]
    let j = lv.joined
    let a0 = extended(lv, a.parts[0])
    let a1 = extended(lv, a.parts[1])
    let b0 = extended(lv, b.parts[0])
    let b1 = extended(lv, b.parts[1])
    let d0 = ring.mul(j, a0, b0)
    let d1 = ring.mul(j, a0, b1)
    ring.mul_add_into(j, d1, a1, b0)
    let d2 = ring.mul(j, a1, b1)
    Ciphertext { parts: [scaled_down(lv, d0), scaled_down(lv, d1), scaled_down(lv, d2)] }
}

/// Returns `c`, a ciphertext of three parts, as two parts that decrypt to the same plaintext, using the relinearization key.
pub fn relinearize(ctx: *Context, key: rlwe.SwitchingKey, c: Ciphertext) -> Ciphertext ! Error {
    if c.parts.len != 3 {
        fail Error.Mismatch
    }
    let pair = rlwe.relinearize(ctx.rlwe, key, c.parts[0], c.parts[1], c.parts[2], level(c))
    Ciphertext { parts: [pair.c0, pair.c1] }
}

/// Returns `multiply` followed by `relinearize`.
pub fn multiply_relinearize(ctx: *Context, key: rlwe.SwitchingKey, a: Ciphertext, b: Ciphertext) -> Ciphertext ! Error {
    relinearize(ctx, key, multiply(ctx, a, b)?)
}

fn apply_galois(ctx: *Context, keys: rlwe.GaloisKeys, c: Ciphertext, g: i64) -> Ciphertext ! Error {
    if c.parts.len != 2 {
        fail Error.Mismatch
    }
    let key = rlwe.galois_key(keys, g) ?? fail Error.MissingGaloisKey
    let pair = rlwe.apply_galois(ctx.rlwe, key, rlwe.Pair { c0: c.parts[0], c1: c.parts[1] }, g, level(c))
    Ciphertext { parts: [pair.c0, pair.c1] }
}

/// Returns `c` with both rows of its slots rotated `steps` places left, or right for a negative `steps`. The Galois keys must include `steps`.
pub fn rotate_rows(ctx: *Context, keys: rlwe.GaloisKeys, c: Ciphertext, steps: i64) -> Ciphertext ! Error {
    apply_galois(ctx, keys, c, rlwe.rotation_element(ctx.parameters.degree, steps))
}

/// Returns `c` with the two rows of its slots exchanged. The Galois keys must have been made with `swap`.
pub fn swap_rows(ctx: *Context, keys: rlwe.GaloisKeys, c: Ciphertext) -> Ciphertext ! Error {
    apply_galois(ctx, keys, c, rlwe.conjugation_element(ctx.parameters.degree))
}

/// Returns `c` at the next level down: each part divided by the last prime with rounding, which keeps the plaintext and the noise budget, less about the bits of the secret's norm, and makes later operations cheaper.
pub fn switch_down(ctx: *Context, c: Ciphertext) -> Ciphertext ! Error {
    if level(c) == 0 {
        fail Error.LowestLevel
    }
    var parts: ring.Poly[] = []
    for p in c.parts {
        parts.push(ring.divide_round_last_transform(ctx.rlwe.q, p))
    }
    Ciphertext { parts }
}
