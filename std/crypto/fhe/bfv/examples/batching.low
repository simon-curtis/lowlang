import std/crypto/fhe/bfv
import std/crypto/fhe/ring
import std/crypto/fhe/rlwe

fn show(ctx: *bfv.Context, keys: rlwe.Keys, label: str, c: bfv.Ciphertext) ! bfv.Error {
    let values = bfv.decode(ctx, bfv.decrypt(ctx, keys.secret, c))?
    print("{label}: {values[0]} {values[1]} {values[2]} {values[3]} ... {values[4095]} | {values[4096]} {values[4097]} (budget left: {bfv.noise_budget(ctx, keys.secret, c) > 0})")
}

/// Encrypts two vectors of 8192 integers modulo 65537 under the default 128-bit parameters, then adds, multiplies, rotates and swaps them while encrypted. Slots form two rows of 4096; the output shows the first four and the last slot of the first row and the first two of the second.
fn main() ! bfv.Error {
    let ctx = bfv.context(bfv.default_parameters())?
    let s = ring.stream()
    let keys = bfv.generate(ctx, s)
    let galois = bfv.galois_keys(ctx, keys.secret, [1], true, s)
    print("degree {ctx.parameters.degree}, {ring.bit_count(ctx.rlwe.q)}-bit ciphertext modulus, {bfv.slot_count(ctx)} slots")

    var xs: i64[] = []
    var ys: i64[] = []
    for i in 0..8192 {
        xs.push(i)
        ys.push(2)
    }
    let x = bfv.encrypt(ctx, keys.public, bfv.encode(ctx, xs)?, s)
    let y = bfv.encrypt(ctx, keys.public, bfv.encode(ctx, ys)?, s)
    show(ctx, keys, "x", x)?
    show(ctx, keys, "x + y", bfv.add(ctx, x, y)?)?
    let product = bfv.multiply_relinearize(ctx, keys.relinearization, x, y)?
    show(ctx, keys, "x * y", product)?
    show(ctx, keys, "(x * y)^2", bfv.multiply_relinearize(ctx, keys.relinearization, product, product)?)?
    show(ctx, keys, "x rotated left 1", bfv.rotate_rows(ctx, galois, x, 1)?)?
    show(ctx, keys, "rows swapped", bfv.swap_rows(ctx, galois, x)?)?
    show(ctx, keys, "x * y one level down", bfv.switch_down(ctx, product)?)?
}
