import std/crypto/fhe/ckks
import std/crypto/fhe/ring
import std/crypto/fhe/rlwe
import std/text

fn total(ctx: *ckks.Context, galois: rlwe.GaloisKeys, c: ckks.Ciphertext, steps: i64[]) -> ckks.Ciphertext ! ckks.Error {
    var acc = c
    for step in steps {
        acc = ckks.add(ctx, acc, ckks.rotate(ctx, galois, acc, step)?)?
    }
    acc
}

fn opened(ctx: *ckks.Context, keys: rlwe.Keys, c: ckks.Ciphertext) -> ckks.Complex[] {
    ckks.decode(ctx, ckks.decrypt(ctx, keys.secret, c))
}

fn show(label: str, values: ckks.Complex[]) {
    var parts = ""
    for v in values[..3] {
        parts = "{parts} ({text.fixed(v.re, 3)}, {text.fixed(v.im, 3)})"
    }
    print("{label}:{parts}")
}

/// Encrypts 4096 readings under the default 128-bit CKKS parameters and computes their mean and variance while encrypted: a squaring, then a sum over all slots by rotations of 1, 2, 4, ... 2048. Then multiplies, rotates and conjugates a vector of complex numbers.
fn main() ! ckks.Error {
    let ctx = ckks.context(ckks.default_parameters())?
    let n = ckks.slot_count(ctx)
    var steps: i64[] = []
    var step = 1
    for step < n {
        steps.push(step)
        step *= 2
    }
    let s = ring.stream()
    let keys = ckks.generate(ctx, s)
    let galois = ckks.galois_keys(ctx, keys.secret, steps, true, s)
    print("degree {ctx.parameters.degree}, {n} slots, scale 2^{ctx.parameters.scale_bits}")

    var readings: ckks.Complex[] = []
    var plain_sum = 0.0
    var plain_squares = 0.0
    for i in 0..n {
        let x = f64(i * 7 % 101) / 8.0
        readings.push(ckks.Complex { re: x, im: 0.0 })
        plain_sum += x
        plain_squares += x * x
    }
    let c = ckks.encrypt(ctx, keys.public, ckks.encode(ctx, readings)?, s)
    let sum = opened(ctx, keys, total(ctx, galois, c, steps)?)[0].re
    let square = ckks.multiply_rescale(ctx, keys.relinearization, c, c)?
    let squares = opened(ctx, keys, total(ctx, galois, square, steps)?)[0].re
    let mean = sum / f64(n)
    let plain_mean = plain_sum / f64(n)
    print("mean {text.fixed(mean, 3)}, in the clear {text.fixed(plain_mean, 3)}")
    print("variance {text.fixed(squares / f64(n) - mean * mean, 3)}, in the clear {text.fixed(plain_squares / f64(n) - plain_mean * plain_mean, 3)}")

    let z: ckks.Complex[] = [ckks.Complex { re: 1.5, im: 2.0 }, ckks.Complex { re: -0.25, im: 0.5 }, ckks.Complex { re: 3.0, im: -1.0 }, ckks.Complex { re: 0.125, im: 0.75 }]
    let w: ckks.Complex[] = [ckks.Complex { re: 2.0, im: 0.0 }, ckks.Complex { re: 0.0, im: 1.0 }, ckks.Complex { re: 0.5, im: 0.5 }, ckks.Complex { re: -1.0, im: 0.0 }]
    let cz = ckks.encrypt(ctx, keys.public, ckks.encode(ctx, z)?, s)
    let cw = ckks.encrypt(ctx, keys.public, ckks.encode(ctx, w)?, s)
    show("z", opened(ctx, keys, cz))
    show("z * w", opened(ctx, keys, ckks.multiply_rescale(ctx, keys.relinearization, cz, cw)?))
    show("z rotated left 1", opened(ctx, keys, ckks.rotate(ctx, galois, cz, 1)?))
    show("conjugate of z", opened(ctx, keys, ckks.conjugate(ctx, galois, cz)?))
    print("fresh precision above 20 bits: {ckks.precision(z, opened(ctx, keys, cz)) > 20.0}")
}
