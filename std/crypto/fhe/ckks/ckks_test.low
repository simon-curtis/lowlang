import std/crypto/fhe/ring
import std/crypto/fhe/rlwe
import std/crypto/hash
import std/testing

fn fixed(tag: u8) -> *ring.Stream {
    let seed: u8[] = __make(32)
    seed[0] = tag
    ring.seeded_stream(seed)
}

fn built(t: *testing.T, p: Parameters) -> *Context {
    context(p) catch {
        e => {
            t.fatal("context: {e}")
            panic("unreachable")
        }
    }
}

fn reference_values(count: i64) -> Complex[] {
    var values: Complex[] = []
    for i in 0..count {
        values.push(Complex { re: f64((i * 37) % 200 - 100) / 100.0, im: f64((i * 53) % 200 - 100) / 100.0 })
    }
    values
}

fn unit_interval(s: *ring.Stream) -> f64 {
    f64(ring.next_word(s) >> 11) / 9007199254740992.0 * 2.0 - 1.0
}

fn random_values(s: *ring.Stream, count: i64) -> Complex[] {
    var values: Complex[] = []
    for _ in 0..count {
        values.push(Complex { re: unit_interval(s), im: unit_interval(s) })
    }
    values
}

fn hex_digest(residues: u64[][]) -> str {
    var bytes: u8[] = []
    for r in residues {
        for c in r {
            for i in 0..8 {
                bytes.push(u8(c >> u64(8 * i) & 0xff))
            }
        }
    }
    let digits = "0123456789abcdef"
    var out = ""
    for b in hash.sum(hash.sha256(), bytes) {
        out = "{out}{digits[i64(b >> 4)..i64(b >> 4) + 1]}{digits[i64(b & 15)..i64(b & 15) + 1]}"
    }
    out
}

fn encoded(t: *testing.T, ctx: *Context, values: Complex[]) -> Plaintext {
    encode(ctx, values) catch {
        e => {
            t.fatal("encode: {e}")
            panic("unreachable")
        }
    }
}

fn opened(ctx: *Context, keys: rlwe.Keys, c: Ciphertext) -> Complex[] {
    decode(ctx, decrypt(ctx, keys.secret, c))
}

fn squares(values: Complex[]) -> Complex[] {
    var out: Complex[] = []
    for v in values {
        out.push(times(v, v))
    }
    out
}

fn rotated(values: Complex[], steps: i64) -> Complex[] {
    var out: Complex[] = []
    for i in 0..values.len {
        out.push(values[((i + steps) % values.len + values.len) % values.len])
    }
    out
}

fn fresh_error_bound(ctx: *Context) -> f64 {
    let n = f64(ctx.parameters.degree)
    12.0 * sqrt(n * (n / 18.0 + 1.0 / 6.0)) / default_scale(ctx)
}

fn bits_of(error: f64) -> f64 {
    -ring.ln(error) / ln2
}

fn test_encoding_matches_seal(t: *testing.T) {
    let primes = rlwe.chain_primes([50, 50], 16)
    t.equal_slice(primes, [u64(1125899906842177), 1125899906842273])
    let b = ring.basis(primes[..1], 16)
    var values: Complex[] = [Complex { re: 1.5, im: 0.0 }, Complex { re: -2.25, im: 0.5 }]
    for i in 0..6 {
        values.push(Complex { re: f64(i) * 0.125, im: -f64(i) * 0.0625 })
    }
    let coefficients = coefficients_of(encoder(16), values, 1073741824.0, 4611686018427387904.0) catch {
        e => return t.fatal("encode: {e}")
    }
    let p = ring.from_signed(b, coefficients)
    ring.to_transform(b, p)
    let seal: u64[] = [1060073454999897, 780169816437712, 600790698356153, 438250613290433, 139790078533194, 33573812015857, 188209185607859, 139877540505673, 183445693077710, 642250626831407, 75739093602595, 973430925443461, 406632697738150, 191978899315576, 149372734265996, 751815986950493]
    t.equal_slice(p.residues[0], seal)

    let ctx = built(t, default_parameters())
    var chain: u64[] = []
    for m in ctx.rlwe.full.moduli {
        chain.push(m.value)
    }
    t.equal_slice(chain, [u64(1152921504606748673), 1099510890497, 1099511480321, 1152921504606830593])
    let x = reference_values(slot_count(ctx))
    let px = encoded(t, ctx, x)
    t.equal(hex_digest(px.poly.residues), "355280f42dea48b1f943479b4823babb40c547955520573c2b4d641425186ca1")
    t.is_true(precision(x, decode(ctx, px)) >= 32.7)
}
