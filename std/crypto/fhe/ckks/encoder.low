import std/bits
import std/crypto/fhe/ring

/// A complex number.
pub struct Complex {
    /// The real part.
    pub re: f64
    /// The imaginary part.
    pub im: f64
}

fn plus(a: Complex, b: Complex) -> Complex {
    Complex { re: a.re + b.re, im: a.im + b.im }
}

fn minus(a: Complex, b: Complex) -> Complex {
    Complex { re: a.re - b.re, im: a.im - b.im }
}

fn times(a: Complex, b: Complex) -> Complex {
    Complex { re: a.re * b.re - a.im * b.im, im: a.re * b.im + a.im * b.re }
}

fn scaled(a: Complex, k: f64) -> Complex {
    Complex { re: a.re * k, im: a.im * k }
}

fn conjugated(a: Complex) -> Complex {
    Complex { re: a.re, im: -a.im }
}

struct Encoder {
    degree: i64
    slots: i64[]
    roots: Complex[]
    inverse_roots: Complex[]
}

fn reverse_bits(x: i64, width: i64) -> i64 {
    var out = 0
    var rest = x
    for _ in 0..width {
        out = out << 1 | rest & 1
        rest >>= 1
    }
    out
}

fn root(index: i64, order: i64) -> Complex {
    let t = ring.turn(index, order)
    Complex { re: t.cos, im: t.sin }
}

fn encoder(degree: i64) -> *Encoder {
    let width = bits.bit_length(u64(degree)) - 1
    let order = 2 * degree
    let half = degree / 2
    let slots: i64[] = __make(degree)
    var position = 1
    for i in 0..half {
        slots[i] = reverse_bits((position - 1) >> 1, width)
        slots[half + i] = reverse_bits((order - position - 1) >> 1, width)
        position = position * 3 & (order - 1)
    }
    var roots: Complex[] = [Complex { re: 1.0, im: 0.0 }]
    var inverse_roots: Complex[] = [Complex { re: 1.0, im: 0.0 }]
    for i in 1..degree {
        roots.push(root(reverse_bits(i, width), order))
        inverse_roots.push(conjugated(root(reverse_bits(i - 1, width) + 1, order)))
    }
    new(Encoder { degree, slots, roots, inverse_roots })
}

fn to_coefficients(e: *Encoder, values: Complex[], factor: f64) {
    var gap = 1
    var m = e.degree >> 1
    var k = 0
    for m > 1 {
        var offset = 0
        for _ in 0..m {
            k += 1
            let r = e.inverse_roots[k]
            for j in offset..offset + gap {
                let u = values[j]
                let v = values[j + gap]
                values[j] = plus(u, v)
                values[j + gap] = times(minus(u, v), r)
            }
            offset += gap << 1
        }
        gap <<= 1
        m >>= 1
    }
    let last = scaled(e.inverse_roots[k + 1], factor)
    for j in 0..gap {
        let u = values[j]
        let v = values[j + gap]
        values[j] = scaled(plus(u, v), factor)
        values[j + gap] = times(minus(u, v), last)
    }
}

fn to_slots(e: *Encoder, values: Complex[]) {
    var gap = e.degree >> 1
    var m = 1
    var k = 0
    for m < e.degree {
        var offset = 0
        for _ in 0..m {
            k += 1
            let r = e.roots[k]
            for j in offset..offset + gap {
                let u = values[j]
                let v = times(values[j + gap], r)
                values[j] = plus(u, v)
                values[j + gap] = minus(u, v)
            }
            offset += gap << 1
        }
        gap >>= 1
        m <<= 1
    }
}

fn rounded(x: f64) -> f64 {
    if x >= 0.0 {
        return floor(x + 0.5)
    }
    -floor(0.5 - x)
}

fn coefficients_of(e: *Encoder, values: Complex[], scale: f64, limit: f64) -> i64[] ! Error {
    let half = e.degree / 2
    if values.len > half {
        fail Error.TooManyValues
    }
    var spread: Complex[] = []
    for _ in 0..e.degree {
        spread.push(Complex { re: 0.0, im: 0.0 })
    }
    for i in 0..values.len {
        spread[e.slots[i]] = values[i]
        spread[e.slots[half + i]] = conjugated(values[i])
    }
    to_coefficients(e, spread, scale / f64(e.degree))
    var out: i64[] = []
    for v in spread {
        let x = rounded(v.re)
        if !(x < limit && x > -limit) {
            fail Error.ValueTooLarge
        }
        out.push(i64(x))
    }
    out
}

fn values_of(e: *Encoder, coefficients: f64[]) -> Complex[] {
    var spread: Complex[] = []
    for c in coefficients {
        spread.push(Complex { re: c, im: 0.0 })
    }
    to_slots(e, spread)
    var out: Complex[] = []
    for i in 0..e.degree / 2 {
        out.push(spread[e.slots[i]])
    }
    out
}
