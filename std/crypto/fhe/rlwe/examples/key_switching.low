import std/big
import std/crypto/fhe/ring
import std/crypto/fhe/rlwe

fn largest_bits(b: *ring.Basis, p: ring.Poly) -> i64 {
    var bits = 0
    for v in ring.compose(b, p) {
        let n = big.bit_len(big.abs(v))
        if n > bits {
            bits = n
        }
    }
    bits
}

/// Builds the ring of the default BFV parameters, encrypts zero under a public key and switches a random polynomial times one secret to a pair that decrypts under another. Both phases are small next to the 174-bit modulus.
fn main() {
    let degree = 8192
    let primes = rlwe.chain_primes([43, 43, 44, 44, 44], degree)
    let ctx = rlwe.context(primes[..4], primes[4], degree, 3.19)
    print("{ring.bit_count(ctx.q)}-bit ciphertext modulus, special prime {primes[4]}, at most {rlwe.max_modulus_bits(degree, Classical128)} bits for 128-bit security")

    let s = ring.stream()
    let sk = rlwe.secret_key(ctx, s)
    let zero = rlwe.encrypt_zero(ctx, rlwe.public_key(ctx, sk, s), s)
    print("encryption of zero has a phase under 16 bits: {largest_bits(ctx.q, rlwe.phase(ctx, sk, [zero.c0, zero.c1])) < 16}")

    let other = rlwe.secret_key(ctx, s)
    let other_secret = ring.from_signed(ctx.full, ring.ternary(ring.seeded_stream(fixed_seed()), degree))
    ring.to_transform(ctx.full, other_secret)
    let key = rlwe.switching_key(ctx, sk, other_secret, s)
    let d = ring.uniform(s, ctx.q)
    let switched = rlwe.switch_key(ctx, key, d, rlwe.top(ctx))
    let product = ring.clone(d)
    ring.to_transform(ctx.q, product)
    let expected = ring.mul(ctx.q, product, ring.Poly { residues: other_secret.residues[..4] })
    ring.from_transform(ctx.q, expected)
    let gap = ring.sub(ctx.q, rlwe.phase(ctx, sk, [switched.c0, switched.c1]), expected)
    print("switched pair decrypts to d * s' within 16 bits: {largest_bits(ctx.q, gap) < 16}")
    print("but not under another key: {largest_bits(ctx.q, ring.sub(ctx.q, rlwe.phase(ctx, other, [switched.c0, switched.c1]), expected)) > 160}")
}

fn fixed_seed() -> u8[] {
    [9, 9, 9, 9, 9, 9, 9, 9, 9, 9, 9, 9, 9, 9, 9, 9, 9, 9, 9, 9, 9, 9, 9, 9, 9, 9, 9, 9, 9, 9, 9, 9]
}
