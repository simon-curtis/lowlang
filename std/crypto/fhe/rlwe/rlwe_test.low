import std/big
import std/crypto/fhe/ring
import std/testing

fn test_chain_primes_match_seal(t: *testing.T) {
    t.equal_slice(chain_primes([43, 43, 44, 44, 44], 8192), [8796092792833, 8796092858369, 17592184717313, 17592185438209, 17592186028033])
    t.equal_slice(chain_primes([36, 36, 37], 4096), [68719230977, 68719403009, 137438822401])
    t.equal_slice(chain_primes([48, 48, 48, 48, 48, 48, 48, 48, 49], 16384), [281474972188673, 281474972418049, 281474974482433, 281474975367169, 281474975563777, 281474975662081, 281474976317441, 281474976546817, 562949952798721])
}

fn largest_magnitude(b: *ring.Basis, p: ring.Poly) -> i64 {
    var bits = 0
    for v in ring.compose(b, p) {
        let n = big.bit_len(big.abs(v))
        if n > bits {
            bits = n
        }
    }
    bits
}

fn test_key_switching_works_at_every_level(t: *testing.T) {
    let seed: u8[] = __make(32)
    seed[0] = 1
    let s = ring.seeded_stream(seed)
    let degree = 1024
    let primes = chain_primes([30, 30, 30, 31], degree)
    let ctx = context(primes[..3], primes[3], degree, 3.19)
    let sk = secret_key(ctx, s)
    let other = secret_key(ctx, s)
    let key = switching_key(ctx, sk, other.s, s)
    for level in 0..3 {
        let b = ring.slice(ctx.q, 0, level + 1)
        let d = ring.uniform(s, b)
        let switched = switch_key(ctx, key, d, level)
        let product = ring.clone(d)
        ring.to_transform(b, product)
        let expected = ring.mul(b, product, secret_at(ctx, other, level))
        let error = ring.sub(b, phase(ctx, sk, [switched.c0, switched.c1]), from_transform_copy(b, expected))
        t.is_true(largest_magnitude(b, error) <= 12)
        let wrong = ring.sub(b, phase(ctx, other, [switched.c0, switched.c1]), from_transform_copy(b, expected))
        t.is_true(largest_magnitude(b, wrong) >= 30 * (level + 1) - 4)
    }
}

fn from_transform_copy(b: *ring.Basis, p: ring.Poly) -> ring.Poly {
    let c = ring.clone(p)
    ring.from_transform(b, c)
    c
}

fn test_public_encryptions_of_zero_have_rounding_noise(t: *testing.T) {
    let seed: u8[] = __make(32)
    seed[0] = 2
    let s = ring.seeded_stream(seed)
    let degree = 4096
    let primes = chain_primes([36, 36, 37], degree)
    let ctx = context(primes[..2], primes[2], degree, 3.19)
    let sk = secret_key(ctx, s)
    let pk = public_key(ctx, sk, s)
    let zero = encrypt_zero(ctx, pk, s)
    let noise = largest_magnitude(ctx.q, phase(ctx, sk, [zero.c0, zero.c1]))
    t.is_true(noise <= 12)
}
