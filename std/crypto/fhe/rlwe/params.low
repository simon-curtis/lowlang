import std/crypto/fhe/ring

/// A classical security level of the HomomorphicEncryption.org standard for a uniform ternary secret and error of standard deviation 3.2.
pub enum Security {
    /// 128 bits.
    Classical128
    /// 192 bits.
    Classical192
    /// 256 bits.
    Classical256
}

/// Returns the largest number of bits the product of all primes, the special prime included, may have at degree `degree` for `level`, or `0` for a degree the standard does not list.
///
/// The bounds are Table 1 of the HomomorphicEncryption.org security standard (Albrecht et al., November 2018) for degrees 1024 to 32768, as Microsoft SEAL 4.1 lists them in `native/src/seal/util/hestdparms.h`.
pub fn max_modulus_bits(degree: i64, level: Security) -> i64 {
    let row = match level {
        Classical128 => [27, 54, 109, 218, 438, 881]
        Classical192 => [19, 37, 75, 152, 305, 611]
        Classical256 => [14, 29, 58, 118, 237, 476]
    }
    match degree {
        1024 => row[0]
        2048 => row[1]
        4096 => row[2]
        8192 => row[3]
        16384 => row[4]
        32768 => row[5]
        _ => 0
    }
}

/// Returns one prime of each size in `bits` that supports the transform of degree `degree`, the primes that Microsoft SEAL's `CoeffModulus::Create` picks for the same sizes.
///
/// For each size the primes are the largest of that size that are `1` modulo `2 * degree`; they are handed out smallest first to the positions of that size, in order.
pub fn chain_primes(bits: i64[], degree: i64) -> u64[] {
    let out: u64[] = __make(bits.len)
    for i in 0..bits.len {
        if out[i] != 0 {
            continue
        }
        var positions: i64[] = []
        for j in i..bits.len {
            if bits[j] == bits[i] {
                positions.push(j)
            }
        }
        let found = ring.ntt_primes(bits[i], positions.len, degree, [])
        for k in 0..positions.len {
            out[positions[k]] = found[positions.len - 1 - k]
        }
    }
    out
}
