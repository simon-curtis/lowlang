import std/crypto/aead
import std/testing

fn test_seeded_stream_is_the_chacha20_keystream(t: *testing.T) {
    let seed: u8[] = __make(32)
    for i in 0..32 {
        seed[i] = u8(i * 7 + 1)
    }
    let s = seeded_stream(seed)
    let nonce: u8[] = __make(12)
    for block in 0..20 {
        let expected = aead.chacha20_block(seed, u32(block), nonce)
        for w in 0..8 {
            var word: u64 = 0
            for i in 0..8 {
                word |= u64(expected[8 * w + i]) << u64(8 * i)
            }
            t.equal(next_word(s), word)
        }
    }
    let other: u8[] = __make(32)
    t.not_equal(next_word(seeded_stream(other)), next_word(seeded_stream(seed)))
}

fn moments(xs: i64[]) -> f64[] {
    var sum = 0.0
    var squares = 0.0
    for x in xs {
        sum += f64(x)
        squares += f64(x) * f64(x)
    }
    let mean = sum / f64(xs.len)
    [mean, squares / f64(xs.len) - mean * mean]
}

fn test_ternary_coefficients_are_balanced(t: *testing.T) {
    let xs = ternary(fixed_stream(8), 60000)
    let counts: i64[] = [0, 0, 0]
    for x in xs {
        t.is_true(x >= -1 && x <= 1)
        counts[x + 1] += 1
    }
    for c in counts {
        t.close_to(f64(c) / 60000.0, 1.0 / 3.0, 0.01)
    }
}

fn test_gaussians_have_the_requested_spread(t: *testing.T) {
    for sigma in [3.2, 20.0, 1099511627776.0] {
        let xs = gaussian(fixed_stream(10), 100000, sigma)
        let m = moments(xs)
        t.close_to(m[0] / sigma, 0.0, 0.02)
        t.close_to(m[1] / (sigma * sigma), 1.0, 0.03)
        if sigma < 64.0 {
            for x in xs {
                t.is_true(x <= i64(6.0 * sigma) && x >= -i64(6.0 * sigma))
            }
        }
    }
    let narrow = gaussian(fixed_stream(11), 200000, 3.2)
    var zeros = 0
    var ones = 0
    for x in narrow {
        if x == 0 {
            zeros += 1
        }
        if x == 1 {
            ones += 1
        }
    }
    t.close_to(f64(zeros) / 200000.0, 0.1247, 0.003)
    t.close_to(f64(ones) / 200000.0, 0.1187, 0.003)
}

fn test_turns_match_exact_angles(t: *testing.T) {
    let r = 0.7071067811865476
    let h = 0.8660254037844386
    let cases: f64[] = [
        0, 1, 1.0, 0.0,
        1, 8, r, r,
        1, 4, 0.0, 1.0,
        3, 8, -r, r,
        1, 2, -1.0, 0.0,
        5, 8, -r, -r,
        3, 4, 0.0, -1.0,
        7, 8, r, -r,
        1, 12, h, 0.5,
        5, 12, -h, 0.5,
        -1, 12, h, -0.5,
    ]
    for i in 0..cases.len / 4 {
        let turned = turn(i64(cases[4 * i]), i64(cases[4 * i + 1]))
        t.close_to(turned.cos, cases[4 * i + 2], 1e-15)
        t.close_to(turned.sin, cases[4 * i + 3], 1e-15)
    }
    let m = 65536
    for k in [1, 77, 1000, 30000, 65535] {
        let a = turn(k, m)
        let b = turn(3 * k + 5, m)
        let sum = turn(4 * k + 5, m)
        t.close_to(a.cos * b.cos - a.sin * b.sin, sum.cos, 1e-15)
        t.close_to(a.sin * b.cos + a.cos * b.sin, sum.sin, 1e-15)
        t.close_to(a.cos * a.cos + a.sin * a.sin, 1.0, 1e-15)
    }
}

fn test_logarithm_inverts_exp(t: *testing.T) {
    for x in [1.0, 0.5, 0.1, 1e-10, 0.999999, 1.0 / 9007199254740992.0, 0.75] {
        t.close_to(exp(ln(x)) / x, 1.0, 1e-14)
    }
    t.close_to(ln(1.0), 0.0, 1e-17)
}
