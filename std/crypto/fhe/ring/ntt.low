/// The negacyclic number-theoretic transform of degree `degree` modulo one prime.
///
/// `forward` maps the coefficients of a polynomial in `Z_q[X] / (X^degree + 1)` to its values at the odd powers of a primitive `2 * degree`-th root of unity, in bit-reversed order, so the product of two polynomials is the pointwise product of their transforms.
pub struct Ntt {
    /// The prime, which is `1` modulo `2 * degree`.
    pub modulus: Modulus
    /// The number of coefficients, a power of two.
    pub degree: i64
    /// The smallest primitive `2 * degree`-th root of unity, the one the transform evaluates at and the one Microsoft SEAL picks.
    pub root: u64
    roots: u64[]
    roots_shoup: u64[]
    inverse_roots: u64[]
    inverse_roots_shoup: u64[]
    degree_inverse: u64
    degree_inverse_shoup: u64
}

fn bit_reverse(x: i64, bits: i64) -> i64 {
    var r = 0
    for b in 0..bits {
        r |= (x >> b & 1) << (bits - 1 - b)
    }
    r
}

fn log2(n: i64) -> i64 {
    var bits = 0
    for 1 << bits < n {
        bits += 1
    }
    bits
}

fn primitive_root(m: Modulus, order: i64) -> u64 {
    let exponent = (m.value - 1) / u64(order)
    var x: u64 = 2
    for x < m.value {
        let candidate = power_mod(m, x, exponent)
        if power_mod(m, candidate, u64(order / 2)) == m.value - 1 {
            return smallest_odd_power(m, candidate, order)
        }
        x += 1
    }
    panic("ring.ntt: {m.value} has no root of unity of order {order}")
}

fn smallest_odd_power(m: Modulus, root: u64, order: i64) -> u64 {
    let square = mul_mod(m, root, root)
    var best = root
    var current = root
    for _ in 1..order / 2 {
        current = mul_mod(m, current, square)
        if current < best {
            best = current
        }
    }
    best
}

fn power_table(m: Modulus, root: u64, n: i64) -> u64[] {
    let bits = log2(n)
    let powers: u64[] = __make(n)
    var p: u64 = 1
    for i in 0..n {
        powers[bit_reverse(i, bits)] = p
        p = mul_mod(m, p, root)
    }
    powers
}

fn shoup_table(m: Modulus, table: u64[]) -> u64[] {
    let out: u64[] = __make(table.len)
    for i in 0..table.len {
        out[i] = shoup(m, table[i])
    }
    out
}

/// Returns the transform of degree `degree`, a power of two, modulo the prime `m`, which must be `1` modulo `2 * degree`.
pub fn ntt(m: Modulus, degree: i64) -> Ntt {
    if degree < 2 || degree & (degree - 1) != 0 || (m.value - 1) % u64(2 * degree) != 0 {
        panic("ring.ntt: {m.value} has no transform of degree {degree}")
    }
    let root = primitive_root(m, 2 * degree)
    let roots = power_table(m, root, degree)
    let inverse_roots = power_table(m, inverse_mod(m, root), degree)
    let degree_inverse = inverse_mod(m, u64(degree))
    Ntt {
        modulus: m,
        degree,
        root,
        roots,
        roots_shoup: shoup_table(m, roots),
        inverse_roots,
        inverse_roots_shoup: shoup_table(m, inverse_roots),
        degree_inverse,
        degree_inverse_shoup: shoup(m, degree_inverse),
    }
}

/// Replaces the reduced coefficients in `a` with their transform. `a` has `degree` elements.
pub fn forward(t: *Ntt, a: u64[]) {
    let m = t.modulus
    let q = m.value
    let n = t.degree
    var span = n
    var groups = 1
    for groups < n {
        span >>= 1
        for i in 0..groups {
            let start = 2 * i * span
            let w = t.roots[groups + i]
            let w_shoup = t.roots_shoup[groups + i]
            for j in start..start + span {
                let u = a[j]
                let v = mul_shoup(m, a[j + span], w, w_shoup)
                a[j] = below(u + v, q)
                a[j + span] = below(u - v + q, q)
            }
        }
        groups <<= 1
    }
}

/// Replaces the transform in `a` with the reduced coefficients it came from, undoing `forward`.
pub fn backward(t: *Ntt, a: u64[]) {
    let m = t.modulus
    let q = m.value
    let n = t.degree
    var span = 1
    var groups = n
    for groups > 1 {
        let half = groups >> 1
        var start = 0
        for i in 0..half {
            let w = t.inverse_roots[half + i]
            let w_shoup = t.inverse_roots_shoup[half + i]
            for j in start..start + span {
                let u = a[j]
                let v = a[j + span]
                a[j] = below(u + v, q)
                a[j + span] = mul_shoup(m, u - v + q, w, w_shoup)
            }
            start += 2 * span
        }
        span <<= 1
        groups = half
    }
    for j in 0..n {
        a[j] = mul_shoup(m, a[j], t.degree_inverse, t.degree_inverse_shoup)
    }
}
