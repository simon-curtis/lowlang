import std/big
import std/testing

fn wide_oracle(high: u64, low: u64, q: u64) -> u64 {
    let x = big.add(big.shl(big.from_u64(high), 64), big.from_u64(low))
    let r = big.modulo(x, big.from_u64(q)) catch {
        _ => panic("zero modulus")
    }
    big.to_u64(r) catch {
        _ => panic("residue too wide")
    }
}

fn test_wide_reduction_matches_big_integers(t: *testing.T) {
    let s = fixed_stream(7)
    let max: u64 = 0xffffffffffffffff
    for q in [(u64(1) << 61) - 1, 1152921504606830593, 1099511480321, 65537, 1 << 20, 3, 2] {
        let m = modulus(q)
        let edges: u64[] = [0, 1, q - 1, q, max]
        for high in edges {
            for low in edges {
                t.equal(reduce_wide(m, high, low), wide_oracle(high, low, q))
            }
        }
        for _ in 0..2000 {
            let high = next_word(s)
            let low = next_word(s)
            t.equal(reduce_wide(m, high, low), wide_oracle(high, low, q))
        }
        t.equal(reduce_signed(m, -1), q - 1)
        let top = wide_oracle(0, u64(1) << 63, q)
        t.equal(reduce_signed(m, -9223372036854775807 - 1), (q - top) % q)
    }
}

fn test_products_and_inverses_match_big_integers(t: *testing.T) {
    let s = fixed_stream(7)
    for q in [(u64(1) << 61) - 1, 1152921504606830593, 1099511480321, 65537] {
        let m = modulus(q)
        for _ in 0..2000 {
            let a = next_word(s) % q
            let b = next_word(s) % q
            let expected = wide_oracle(__mulhi(a, b), a * b, q)
            t.equal(mul_mod(m, a, b), expected)
            t.equal(mul_shoup(m, a, b, shoup(m, b)), expected)
            t.equal(add_mod(m, a, b), (a + b) % q)
            t.equal(sub_mod(m, a, b), (a + q - b) % q)
            if a != 0 {
                t.equal(mul_mod(m, a, inverse_mod(m, a)), 1)
            }
            let c = centre(m, a)
            t.equal(reduce_signed(m, c), a)
            t.is_true(c <= i64(q / 2) && c >= -i64(q / 2))
        }
    }
}

fn test_primality_matches_big_integers(t: *testing.T) {
    let strong_pseudoprimes: u64[] = [2047, 1373653, 25326001, 3215031751, 2152302898747, 3474749660383, 341550071728321, 561, 41041, 825265, 321197185, 1073741789 * 1073741783]
    for n in strong_pseudoprimes {
        t.equal(is_prime(n), big.is_probable_prime(big.from_u64(n), 40))
    }
    for n in 0..3000 {
        t.equal(is_prime(u64(n)), big.is_probable_prime(big.from_u64(u64(n)), 40))
    }
    t.is_true(is_prime((u64(1) << 61) - 1))
    t.is_true(!is_prime((u64(1) << 59) - 1))
}

fn test_transform_primes_have_the_requested_shape(t: *testing.T) {
    for degree in [1024, 8192, 32768] {
        let first = ntt_primes(60, 3, degree, [])
        let more = ntt_primes(60, 2, degree, first)
        var all = first
        for p in more {
            all.push(p)
        }
        t.equal(all.len, 5)
        for i in 0..all.len {
            let p = all[i]
            t.is_true(big.is_probable_prime(big.from_u64(p), 40))
            t.equal(p % u64(2 * degree), 1)
            t.equal(p >> 59, 1)
            for j in 0..i {
                t.is_true(all[j] != p)
            }
        }
        t.is_true(first[0] > first[1] && first[1] > first[2])
    }
}

fn test_transforms_use_the_smallest_primitive_root(t: *testing.T) {
    for case in [[97, 16], [12289, 1024], [65537, 4096]] {
        let q = u64(case[0])
        let degree = case[1]
        let m = modulus(q)
        var smallest: u64 = 0
        for x in 2..i64(q) {
            if power_mod(m, u64(x), u64(degree)) == q - 1 {
                smallest = u64(x)
                break
            }
        }
        t.equal(ntt(m, degree).root, smallest)
    }
}
