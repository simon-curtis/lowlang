import std/big

/// A residue number system basis: distinct primes `q_0..q_k` that each carry a negacyclic transform of one degree, so a polynomial modulo their product `Q` is held as one residue polynomial per prime.
pub struct Basis {
    /// The number of coefficients of every polynomial, a power of two.
    pub degree: i64
    /// The primes, in order.
    pub moduli: Modulus[]
    /// The transform of each prime.
    pub transforms: *Ntt[]
}

/// A polynomial in `Z_Q[X] / (X^degree + 1)` as one residue polynomial per prime of a `Basis`.
///
/// It holds either the coefficients or their transforms; which one is the caller's convention. A polynomial with fewer residues than the basis has primes uses the leading primes, so a polynomial at a lower level of a modulus chain works with the full basis.
pub struct Poly {
    /// The residues, `residues[i][j]` being coefficient or transform `j` modulo prime `i`.
    pub residues: u64[][]
}

/// Returns the basis of the distinct primes `primes`, each `1` modulo `2 * degree`, for polynomials of degree `degree`, a power of two.
///
/// Panics when a prime repeats or has no transform of that degree.
pub fn basis(primes: u64[], degree: i64) -> *Basis {
    var moduli: Modulus[] = []
    var transforms: *Ntt[] = []
    for i in 0..primes.len {
        for j in 0..i {
            if primes[j] == primes[i] {
                panic("ring.basis: {primes[i]} appears twice")
            }
        }
        let m = modulus(primes[i])
        moduli.push(m)
        transforms.push(new(ntt(m, degree)))
    }
    new(Basis { degree, moduli, transforms })
}

/// Returns the basis of the primes `from..to` of `b`, sharing its transforms.
pub fn slice(b: *Basis, from: i64, to: i64) -> *Basis {
    new(Basis { degree: b.degree, moduli: b.moduli[from..to], transforms: b.transforms[from..to] })
}

/// Returns the basis of the primes of `a` followed by the primes of `b`, sharing their transforms.
///
/// Panics when the degrees differ or a prime is in both.
pub fn join(a: *Basis, b: *Basis) -> *Basis {
    if a.degree != b.degree {
        panic("ring.join: degrees {a.degree} and {b.degree} differ")
    }
    var moduli: Modulus[] = []
    var transforms: *Ntt[] = []
    for i in 0..a.moduli.len {
        moduli.push(a.moduli[i])
        transforms.push(a.transforms[i])
    }
    for i in 0..b.moduli.len {
        for m in a.moduli {
            if m.value == b.moduli[i].value {
                panic("ring.join: {m.value} is in both bases")
            }
        }
        moduli.push(b.moduli[i])
        transforms.push(b.transforms[i])
    }
    new(Basis { degree: a.degree, moduli, transforms })
}

/// Returns the product `Q` of the primes of `b`.
pub fn product(b: *Basis) -> big.Int {
    var q = big.one()
    for m in b.moduli {
        q = big.mul(q, big.from_u64(m.value))
    }
    q
}

/// Returns the number of bits of the product of the primes of `b`.
pub fn bit_count(b: *Basis) -> i64 {
    big.bit_len(product(b))
}

fn residues(count: i64, degree: i64) -> u64[][] {
    var out: u64[][] = []
    for _ in 0..count {
        let r: u64[] = __make(degree)
        out.push(r)
    }
    out
}

/// Returns the zero polynomial with one residue per prime of `b`.
pub fn zero(b: *Basis) -> Poly {
    Poly { residues: residues(b.moduli.len, b.degree) }
}

/// Returns the zero polynomial with residues for the first `count` primes of `b`.
pub fn zero_at(b: *Basis, count: i64) -> Poly {
    Poly { residues: residues(count, b.degree) }
}

/// Returns the polynomial with the signed coefficients `coefficients`, reduced modulo each prime of `b`.
pub fn from_signed(b: *Basis, coefficients: i64[]) -> Poly {
    let p = zero(b)
    for i in 0..b.moduli.len {
        let m = b.moduli[i]
        let r = p.residues[i]
        for j in 0..b.degree {
            r[j] = reduce_signed(m, coefficients[j])
        }
    }
    p
}

/// Returns a copy of `p` that shares no residues with it.
pub fn clone(p: Poly) -> Poly {
    var out: u64[][] = []
    for r in p.residues {
        let c: u64[] = __make(r.len)
        for j in 0..r.len {
            c[j] = r[j]
        }
        out.push(c)
    }
    Poly { residues: out }
}

/// Returns `x + y` over the residues of `x`.
pub fn add(b: *Basis, x: Poly, y: Poly) -> Poly {
    let out = zero_at(b, x.residues.len)
    for i in 0..x.residues.len {
        let q = b.moduli[i].value
        let a = x.residues[i]
        let c = y.residues[i]
        let o = out.residues[i]
        for j in 0..b.degree {
            o[j] = below(a[j] + c[j], q)
        }
    }
    out
}

/// Adds `y` to `x` in place over the residues of `x`.
pub fn add_into(b: *Basis, x: Poly, y: Poly) {
    for i in 0..x.residues.len {
        let q = b.moduli[i].value
        let a = x.residues[i]
        let c = y.residues[i]
        for j in 0..b.degree {
            a[j] = below(a[j] + c[j], q)
        }
    }
}

/// Returns `x - y` over the residues of `x`.
pub fn sub(b: *Basis, x: Poly, y: Poly) -> Poly {
    let out = zero_at(b, x.residues.len)
    for i in 0..x.residues.len {
        let q = b.moduli[i].value
        let a = x.residues[i]
        let c = y.residues[i]
        let o = out.residues[i]
        for j in 0..b.degree {
            o[j] = below(a[j] - c[j] + q, q)
        }
    }
    out
}

/// Returns `-x`.
pub fn negate(b: *Basis, x: Poly) -> Poly {
    let out = zero_at(b, x.residues.len)
    for i in 0..x.residues.len {
        let m = b.moduli[i]
        let a = x.residues[i]
        let o = out.residues[i]
        for j in 0..b.degree {
            o[j] = negate_mod(m, a[j])
        }
    }
    out
}

/// Returns the product of the transforms `x` and `y`, coefficient by coefficient, over the residues of `x`.
pub fn mul(b: *Basis, x: Poly, y: Poly) -> Poly {
    let out = zero_at(b, x.residues.len)
    for i in 0..x.residues.len {
        let m = b.moduli[i]
        let a = x.residues[i]
        let c = y.residues[i]
        let o = out.residues[i]
        for j in 0..b.degree {
            o[j] = mul_mod(m, a[j], c[j])
        }
    }
    out
}

/// Adds the product of the transforms `x` and `y` to `acc` in place, over the residues of `acc`.
pub fn mul_add_into(b: *Basis, acc: Poly, x: Poly, y: Poly) {
    for i in 0..acc.residues.len {
        let m = b.moduli[i]
        let a = x.residues[i]
        let c = y.residues[i]
        let o = acc.residues[i]
        for j in 0..b.degree {
            o[j] = below(o[j] + mul_mod(m, a[j], c[j]), m.value)
        }
    }
}

/// Returns `x` times the integer `c`, which may be negative or larger than the primes.
pub fn mul_scalar(b: *Basis, x: Poly, c: i64) -> Poly {
    let out = zero_at(b, x.residues.len)
    for i in 0..x.residues.len {
        let m = b.moduli[i]
        let w = reduce_signed(m, c)
        let w_shoup = shoup(m, w)
        let a = x.residues[i]
        let o = out.residues[i]
        for j in 0..b.degree {
            o[j] = mul_shoup(m, a[j], w, w_shoup)
        }
    }
    out
}

/// Replaces the coefficients of every residue of `p` with their transforms.
pub fn to_transform(b: *Basis, p: Poly) {
    for i in 0..p.residues.len {
        forward(b.transforms[i], p.residues[i])
    }
}

/// Replaces the transforms of every residue of `p` with the coefficients they came from.
pub fn from_transform(b: *Basis, p: Poly) {
    for i in 0..p.residues.len {
        backward(b.transforms[i], p.residues[i])
    }
}

/// Returns the image of the coefficients `x` under the automorphism `X -> X^g`, for an odd `g`.
pub fn automorphism(b: *Basis, x: Poly, g: i64) -> Poly {
    let n = b.degree
    let mask = 2 * n - 1
    let out = zero_at(b, x.residues.len)
    for i in 0..x.residues.len {
        let m = b.moduli[i]
        let a = x.residues[i]
        let o = out.residues[i]
        for j in 0..n {
            let k = j * g & mask
            if k < n {
                o[k] = a[j]
            } else {
                o[k - n] = negate_mod(m, a[j])
            }
        }
    }
    out
}

/// Returns the slot permutation of the automorphism `X -> X^g` on transforms of degree `degree`: the transform of the image has `source[j]` of the input's transform at position `j`.
pub fn automorphism_table(degree: i64, g: i64) -> i64[] {
    let bits = log2(degree)
    let mask = 2 * degree - 1
    let table: i64[] = __make(degree)
    for j in 0..degree {
        let exponent = 2 * bit_reverse(j, bits) + 1
        let image = exponent * g & mask
        table[j] = bit_reverse((image - 1) >> 1, bits)
    }
    table
}

/// Returns the image of the transforms `x` under the automorphism whose `automorphism_table` is `table`.
pub fn permute(b: *Basis, x: Poly, table: i64[]) -> Poly {
    let out = zero_at(b, x.residues.len)
    for i in 0..x.residues.len {
        let a = x.residues[i]
        let o = out.residues[i]
        for j in 0..b.degree {
            o[j] = a[table[j]]
        }
    }
    out
}
