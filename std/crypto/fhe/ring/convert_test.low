import std/big
import std/slices
import std/testing

fn fixed_stream(tag: u8) -> *Stream {
    let seed: u8[] = __make(32)
    seed[0] = tag
    seeded_stream(seed)
}

fn schoolbook(m: Modulus, a: u64[], b: u64[]) -> u64[] {
    let n = a.len
    let out: u64[] = __make(n)
    for i in 0..n {
        for j in 0..n {
            let p = mul_mod(m, a[i], b[j])
            if i + j < n {
                out[i + j] = add_mod(m, out[i + j], p)
            } else {
                out[i + j - n] = sub_mod(m, out[i + j - n], p)
            }
        }
    }
    out
}

fn test_transform_multiplies_negacyclically(t: *testing.T) {
    let s = fixed_stream(1)
    for degree in [2, 4, 16, 128, 1024] {
        for bits in [20, 61] {
            let q = ntt_primes(bits, 1, degree, [])[0]
            let m = modulus(q)
            let plan = new(ntt(m, degree))
            let a = residues_below(s, degree, q)
            let b = residues_below(s, degree, q)
            let expected = schoolbook(m, a, b)
            let fa = slices.clone(a)
            let fb = slices.clone(b)
            forward(plan, fa)
            forward(plan, fb)
            for i in 0..degree {
                fa[i] = mul_mod(m, fa[i], fb[i])
            }
            backward(plan, fa)
            t.equal_slice(fa, expected)
        }
    }
}

fn residues_of(b: *Basis, values: big.Int[]) -> Poly {
    let p = zero(b)
    for i in 0..b.moduli.len {
        let q = big.from_u64(b.moduli[i].value)
        for c in 0..values.len {
            let r = big.modulo(values[c], q) catch {
                _ => panic("zero modulus")
            }
            p.residues[i][c] = big.to_u64(r) catch {
                _ => panic("residue too wide")
            }
        }
    }
    p
}

fn random_below(s: *Stream, bound: big.Int) -> big.Int {
    var x = big.zero()
    for _ in 0..(big.bit_len(bound) + 127) / 64 {
        x = big.add(big.shl(x, 64), big.from_u64(next_word(s)))
    }
    big.modulo(x, bound) catch {
        _ => panic("zero bound")
    }
}

fn centred_values(s: *Stream, q: big.Int, degree: i64) -> big.Int[] {
    let half = big.shr(q, 1)
    let margin = big.shr(q, 40)
    var out: big.Int[] = [big.zero(), big.one(), big.from_i64(-1), big.sub(half, margin), big.neg(big.sub(half, margin))]
    for out.len < degree {
        out.push(big.sub(random_below(s, big.sub(q, big.shl(margin, 1))), big.sub(half, margin)))
    }
    out
}

fn two_bases(degree: i64) -> *Basis {
    join(basis(ntt_primes(50, 3, degree, []), degree), basis(ntt_primes(61, 4, degree, []), degree))
}

fn test_extension_lifts_centred_values_exactly(t: *testing.T) {
    let s = fixed_stream(3)
    let degree = 64
    let all = two_bases(degree)
    let from = slice(all, 0, 3)
    let to = slice(all, 3, 7)
    let values = centred_values(s, product(from), degree)
    let lifted = extend(extension(from, to), residues_of(from, values))
    let expected = residues_of(to, values)
    for j in 0..4 {
        t.equal_slice(lifted.residues[j], expected.residues[j])
    }
    let back = extend(extension(to, from), expected)
    for j in 0..3 {
        t.equal_slice(back.residues[j], residues_of(from, values).residues[j])
    }
}

fn rounded_quotient(x: big.Int, numerator: big.Int, d: big.Int) -> big.Int {
    let twice = big.add(big.shl(big.mul(x, numerator), 1), d)
    let r = big.divmod_floor(twice, big.shl(d, 1)) catch {
        _ => panic("zero divisor")
    }
    r.quotient
}

fn residue_of(x: big.Int, m: u64) -> u64 {
    let r = big.modulo(x, big.from_u64(m)) catch {
        _ => panic("zero modulus")
    }
    big.to_u64(r) catch {
        _ => panic("residue too wide")
    }
}

fn test_scaling_rounds_like_big_integers(t: *testing.T) {
    let s = fixed_stream(4)
    let degree = 64
    let all = two_bases(degree)
    let q = slice(all, 0, 3)
    for plain in [u64(65537), 1 << 20, 2] {
        let values = centred_values(s, product(q), degree)
        let decrypt = scale(scaler(q, 3, plain, [modulus(plain)]), residues_of(q, values))
        for c in 0..degree {
            let expected = rounded_quotient(values[c], big.from_u64(plain), product(q))
            t.equal(decrypt[0][c], residue_of(expected, plain))
        }
    }
    let p = slice(all, 3, 7)
    let plain: u64 = 65537
    let values = centred_values(s, product(all), degree)
    let scaled = scale(scaler(all, 3, plain, p.moduli), residues_of(all, values))
    for c in 0..degree {
        let expected = rounded_quotient(values[c], big.from_u64(plain), product(q))
        for j in 0..4 {
            t.equal(scaled[j][c], residue_of(expected, p.moduli[j].value))
        }
    }
}

fn test_dropping_the_last_prime_rounds_the_quotient(t: *testing.T) {
    let s = fixed_stream(5)
    let degree = 64
    let all = two_bases(degree)
    let values = centred_values(s, product(all), degree)
    let last = big.from_u64(all.moduli[6].value)
    var want: big.Int[] = []
    for v in values {
        want.push(rounded_quotient(v, big.one(), last))
    }
    let below = slice(all, 0, 6)
    let x = residues_of(all, values)
    let dropped = divide_round_last(all, x)
    let reference = residues_of(below, want)
    for i in 0..6 {
        t.equal_slice(dropped.residues[i], reference.residues[i])
    }
    let transformed = clone(x)
    to_transform(all, transformed)
    let from_transforms = divide_round_last_transform(all, transformed)
    from_transform(below, from_transforms)
    for i in 0..6 {
        t.equal_slice(from_transforms.residues[i], reference.residues[i])
    }
    let composed = compose(below, dropped)
    for c in 0..degree {
        t.is_true(big.equal(composed[c], want[c]))
    }
}

fn test_automorphisms_respect_products_and_compose(t: *testing.T) {
    let s = fixed_stream(6)
    let degree = 256
    let b = basis(ntt_primes(40, 2, degree, []), degree)
    let x = uniform(s, b)
    let y = uniform(s, b)
    let fx = clone(x)
    let fy = clone(y)
    to_transform(b, fx)
    to_transform(b, fy)
    let product_coefficients = mul(b, fx, fy)
    from_transform(b, product_coefficients)
    for g in [3, 5, 2 * degree - 1, 25] {
        let image = automorphism(b, product_coefficients, g)
        let ax = automorphism(b, x, g)
        let ay = automorphism(b, y, g)
        to_transform(b, ax)
        to_transform(b, ay)
        let separately = mul(b, ax, ay)
        from_transform(b, separately)
        same_residues(t, image, separately)
        let permuted = permute(b, fx, automorphism_table(degree, g))
        from_transform(b, permuted)
        same_residues(t, permuted, automorphism(b, x, g))
    }
    let twice = automorphism(b, automorphism(b, x, 3), 5)
    same_residues(t, twice, automorphism(b, x, 15))
    let monomial: i64[] = __make(degree)
    monomial[1] = 1
    let image = automorphism(b, from_signed(b, monomial), degree + 1)
    let minus_one = from_signed(b, monomial)
    minus_one.residues[0][1] = b.moduli[0].value - 1
    minus_one.residues[1][1] = b.moduli[1].value - 1
    same_residues(t, image, minus_one)
}

fn same_residues(t: *testing.T, got: Poly, want: Poly) {
    t.equal(got.residues.len, want.residues.len)
    for i in 0..got.residues.len {
        t.equal_slice(got.residues[i], want.residues[i])
    }
}

fn residues_below(s: *Stream, count: i64, q: u64) -> u64[] {
    let out: u64[] = __make(count)
    for i in 0..count {
        out[i] = next_word(s) % q
    }
    out
}
