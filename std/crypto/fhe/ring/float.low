/// The cosine and sine of one angle.
pub struct Turn {
    /// The cosine.
    pub cos: f64
    /// The sine.
    pub sin: f64
}

const ln2 = 0.6931471805599453
const quarter_pi = 0.7853981633974483

fn float_from_bits(bits: u64) -> f64 {
    let cell: u64[] = [bits]
    let raw: ptr = __slice_ptr(cell)
    let typed: ptr[f64] = raw
    load(typed)
}

fn sin_series(x: f64) -> f64 {
    let x2 = x * x
    var term = x
    var sum = x
    for k in 1..12 {
        term = -term * x2 / f64((2 * k) * (2 * k + 1))
        sum += term
    }
    sum
}

fn cos_series(x: f64) -> f64 {
    let x2 = x * x
    var term = 1.0
    var sum = 1.0
    for k in 1..12 {
        term = -term * x2 / f64((2 * k - 1) * (2 * k))
        sum += term
    }
    sum
}

/// Returns the cosine and sine of `2 * pi * numerator / denominator`, for a positive `denominator` up to 2^60.
///
/// The angle is reduced to an eighth of a turn in integer arithmetic before the series run, so the results are within a few units in the last place for every numerator.
pub fn turn(numerator: i64, denominator: i64) -> Turn {
    let k = (numerator % denominator + denominator) % denominator
    let octant = (k * 8) / denominator
    let rest = k * 8 - octant * denominator
    let x = f64(rest) / f64(denominator) * quarter_pi
    let a = if octant & 1 == 0 { x } else { quarter_pi - x }
    let c = cos_series(a)
    let s = sin_series(a)
    match octant {
        0 => Turn { cos: c, sin: s }
        1 => Turn { cos: s, sin: c }
        2 => Turn { cos: -s, sin: c }
        3 => Turn { cos: -c, sin: s }
        4 => Turn { cos: -c, sin: -s }
        5 => Turn { cos: -s, sin: -c }
        6 => Turn { cos: s, sin: -c }
        _ => Turn { cos: c, sin: -s }
    }
}

/// Returns the natural logarithm of a positive, finite `x`, to within a few units in the last place.
pub fn ln(x: f64) -> f64 {
    let bits = u64(__bits(x))
    let exponent = i64(bits >> 52 & 0x7ff) - 1023
    let mantissa = float_from_bits(bits & 0xfffffffffffff | 0x3ff0000000000000)
    let s = (mantissa - 1.0) / (mantissa + 1.0)
    let s2 = s * s
    var power = s
    var sum = 0.0
    for k in 0..20 {
        sum += power / f64(2 * k + 1)
        power *= s2
    }
    f64(exponent) * ln2 + 2.0 * sum
}
