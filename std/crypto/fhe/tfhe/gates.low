import std/crypto/fhe/ring

/// A binary gate that takes two bits and costs one bootstrapping.
pub enum Gate {
    /// `a and b`.
    And
    /// `a or b`.
    Or
    /// `not (a and b)`.
    Nand
    /// `not (a or b)`.
    Nor
    /// `a xor b`.
    Xor
    /// `not (a xor b)`.
    Xnor
    /// `(not a) and b`.
    AndNy
    /// `a and (not b)`.
    AndYn
    /// `(not a) or b`.
    OrNy
    /// `a or (not b)`.
    OrYn
}

struct Combination {
    offset: u32
    a: i64
    b: i64
}

fn combination(g: Gate) -> Combination {
    match g {
        And => Combination { offset: 0 - eighth, a: 1, b: 1 }
        Or => Combination { offset: eighth, a: 1, b: 1 }
        Nand => Combination { offset: eighth, a: -1, b: -1 }
        Nor => Combination { offset: 0 - eighth, a: -1, b: -1 }
        Xor => Combination { offset: quarter, a: 2, b: 2 }
        Xnor => Combination { offset: 0 - quarter, a: -2, b: -2 }
        AndNy => Combination { offset: 0 - eighth, a: -1, b: 1 }
        AndYn => Combination { offset: 0 - eighth, a: 1, b: -1 }
        OrNy => Combination { offset: eighth, a: -1, b: 1 }
        OrYn => Combination { offset: eighth, a: 1, b: -1 }
    }
}

fn check(ctx: *Context, c: Ciphertext) {
    if c.a.len != ctx.parameters.lwe_size {
        panic("tfhe: a ciphertext has {c.a.len} mask elements, the instance has {ctx.parameters.lwe_size}")
    }
}

fn weigh(ctx: *Context, g: Gate, a: Ciphertext, b: Ciphertext) -> Ciphertext {
    check(ctx, a)
    check(ctx, b)
    let k = combination(g)
    let mask: u32[] = __make(a.a.len)
    for i in 0..mask.len {
        mask[i] = u32(k.a) * a.a[i] + u32(k.b) * b.a[i]
    }
    Ciphertext { a: mask, b: k.offset + u32(k.a) * a.b + u32(k.b) * b.b }
}

/// Returns the encryption of `g` applied to the bits `a` and `b`, a sum of the inputs with a fixed offset whose phase is bootstrapped back to `1/8` or `-1/8` of a turn with fresh noise.
///
/// The inputs must be fresh encryptions or outputs of gates, with phases within `1/16` of `1/8` or `-1/8`.
pub fn apply(ctx: *Context, cloud: *CloudKey, g: Gate, a: Ciphertext, b: Ciphertext) -> Ciphertext {
    bootstrap(ctx, cloud, weigh(ctx, g, a, b), eighth)
}

/// Returns the encryption of `not a`, the negation of the ciphertext, which costs no bootstrapping.
pub fn not(ctx: *Context, a: Ciphertext) -> Ciphertext {
    check(ctx, a)
    let mask: u32[] = __make(a.a.len)
    for i in 0..mask.len {
        mask[i] = 0 - a.a[i]
    }
    Ciphertext { a: mask, b: 0 - a.b }
}

/// Returns the encryption of `if selector then yes else no`, two bootstrappings and one key switch.
pub fn mux(ctx: *Context, cloud: *CloudKey, selector: Ciphertext, yes: Ciphertext, no: Ciphertext) -> Ciphertext {
    let when = bootstrap_extracted(ctx, cloud, weigh(ctx, Gate.And, selector, yes), eighth)
    let otherwise = bootstrap_extracted(ctx, cloud, weigh(ctx, Gate.AndNy, selector, no), eighth)
    let a: u32[] = __make(when.a.len)
    for i in 0..a.len {
        a[i] = when.a[i] + otherwise.a[i]
    }
    key_switch(ctx, cloud, Ciphertext { a, b: eighth + when.b + otherwise.b })
}
