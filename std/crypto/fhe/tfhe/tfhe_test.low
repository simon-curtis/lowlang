import std/crypto/fhe/ring
import std/testing

fn fixed(tag: u8) -> *ring.Stream {
    let seed: u8[] = __make(32)
    seed[0] = tag
    ring.seeded_stream(seed)
}

fn built(t: *testing.T, p: Parameters) -> *Context {
    context(p) catch {
        e => {
            t.fatal("context: {e}")
            panic("unreachable")
        }
    }
}

fn shape(lwe_size: i64, degree: i64, levels: i64, bits: i64, switch_levels: i64, switch_bits: i64, switch_sigma: f64, bootstrapping_sigma: f64) -> Parameters {
    Parameters {
        lwe_size,
        degree,
        gadget_levels: levels,
        gadget_bits: bits,
        key_switch_levels: switch_levels,
        key_switch_bits: switch_bits,
        key_switch_sigma: switch_sigma,
        bootstrapping_sigma,
    }
}

fn small(degree: i64) -> Parameters {
    shape(8, degree, 3, 7, 8, 2, 0.0, 0.0)
}

fn gadget(levels: i64, bits: i64) -> Parameters {
    shape(8, 16, levels, bits, 8, 2, 0.0, 0.0)
}

fn refusal(p: Parameters) -> str {
    let ctx = context(p) catch {
        e => return "{e}"
    }
    "built with degree {ctx.parameters.degree}"
}

fn test_default_parameters_are_the_reference_set(t: *testing.T) {
    let p = default_parameters()
    t.equal(p.lwe_size, 630)
    t.equal(p.degree, 1024)
    t.equal(p.gadget_levels, 3)
    t.equal(p.gadget_bits, 7)
    t.equal(p.key_switch_levels, 8)
    t.equal(p.key_switch_bits, 2)
    t.is_true(p.key_switch_sigma * 32768.0 == 1.0)
    t.is_true(p.bootstrapping_sigma * 33554432.0 == 1.0)
    t.equal(refusal(p), "built with degree 1024")
}

fn test_parameters_outside_the_limits_are_refused(t: *testing.T) {
    t.equal(refusal(small(1000)), "Degree")
    t.equal(refusal(small(1)), "Degree")
    t.equal(refusal(small(65536)), "Degree")
    t.equal(refusal(shape(0, 1024, 3, 7, 8, 2, 0.0, 0.0)), "LweSize")
    t.equal(refusal(gadget(0, 7)), "Gadget")
    t.equal(refusal(gadget(3, 17)), "Gadget")
    t.equal(refusal(gadget(5, 7)), "Gadget")
    t.equal(refusal(shape(8, 2048, 2, 16, 8, 2, 0.0, 0.0)), "ProductOverflow")
    t.equal(refusal(shape(8, 1024, 3, 7, 0, 2, 0.0, 0.0)), "KeySwitch")
    t.equal(refusal(shape(8, 1024, 3, 7, 16, 2, 0.0, 0.0)), "KeySwitch")
    t.equal(refusal(shape(8, 1024, 3, 7, 8, 2, -0.5, 0.0)), "Sigma")
    t.equal(refusal(shape(8, 1024, 3, 7, 8, 2, 0.0, 1.0)), "Sigma")
}

fn schoolbook(a: u32[], b: u32[]) -> u32[] {
    let n = a.len
    let out: u32[] = __make(n)
    for i in 0..n {
        for j in 0..n {
            let p = a[i] * b[j]
            if i + j < n {
                out[i + j] += p
            } else {
                out[i + j - n] -= p
            }
        }
    }
    out
}

fn uniform_poly(s: *ring.Stream, n: i64) -> u32[] {
    let out: u32[] = __make(n)
    fill_uniform(s, out, 0, n)
    out
}

fn digit_poly(s: *ring.Stream, n: i64, half: i64) -> u32[] {
    let out: u32[] = __make(n)
    for i in 0..n {
        out[i] = u32(i64(ring.next_word(s) % u64(2 * half)) - half)
    }
    out
}

fn test_torus_products_are_exact(t: *testing.T) {
    let s = fixed(1)
    for degree in [2, 16, 256, 1024] {
        let ctx = built(t, small(degree))
        let torus = uniform_poly(s, degree)
        torus[0] = 0x80000000
        torus[degree - 1] = 0x7fffffff
        let binary: u32[] = __make(degree)
        for i in 0..degree {
            binary[i] = u32(ring.next_word(s) >> 63)
        }
        t.equal_slice(multiply(ctx, torus, transformed(ctx, binary)), schoolbook(torus, binary))
        let digits = digit_poly(s, degree, 64)
        digits[0] = u32(-64)
        digits[degree - 1] = 63
        t.equal_slice(multiply(ctx, digits, transformed(ctx, torus)), schoolbook(digits, torus))
        let extremes: u32[] = __make(degree)
        let worst: u32[] = __make(degree)
        for i in 0..degree {
            extremes[i] = 0x80000000
            worst[i] = u32(-64)
        }
        t.equal_slice(multiply(ctx, worst, transformed(ctx, extremes)), schoolbook(worst, extremes))
    }
}

fn test_monomial_shifts_match_multiplication(t: *testing.T) {
    let s = fixed(2)
    let degree = 16
    let ctx = built(t, small(degree))
    let p = uniform_poly(s, degree)
    for k in 0..2 * degree {
        let x_k: u32[] = __make(degree)
        if k < degree {
            x_k[k] = 1
        } else {
            x_k[k - degree] = u32(-1)
        }
        let want = schoolbook(p, x_k)
        t.equal_slice(shifted(p, k), want)
        let minus_one = shifted(p, k)
        for j in 0..degree {
            minus_one[j] -= p[j]
        }
        let dst: u32[] = __make(degree)
        shift_minus_one(dst, p, k)
        t.equal_slice(dst, minus_one)
    }
}

fn signed_distance(a: u32, b: u32) -> i64 {
    i64(i32(a - b))
}

fn test_gadget_digits_are_balanced_and_round_to_nearest(t: *testing.T) {
    let s = fixed(3)
    for p in [gadget(3, 7), gadget(4, 8), gadget(2, 16), gadget(1, 3)] {
        let ctx = built(t, p)
        let x = uniform_poly(s, 16)
        x[0] = 0
        x[1] = 0x7fffffff
        x[2] = 0x80000000
        x[3] = 0xffffffff
        x[4] = 1
        var rows: u64[][] = []
        for _ in 0..p.gadget_levels {
            let row: u64[] = __make(16)
            rows.push(row)
        }
        decompose(ctx, x, rows, 0)
        let half = i64(1) << u64(p.gadget_bits - 1)
        let tolerance = if p.gadget_levels * p.gadget_bits == 32 { 0 } else { i64(1) << u64(31 - p.gadget_levels * p.gadget_bits) }
        for j in 0..16 {
            var rebuilt: u32 = 0
            for level in 0..p.gadget_levels {
                let d = i64(i32(lower(ctx, rows[level][j])))
                t.is_true(d >= -half && d < half)
                rebuilt += u32(d) << u32(32 - (level + 1) * p.gadget_bits)
            }
            let off = signed_distance(x[j], rebuilt)
            t.is_true(off >= -tolerance && off <= tolerance)
        }
    }
}

fn centred(x: u32) -> f64 {
    f64(i32(x)) / 4294967296.0
}

fn mean_and_variance(xs: f64[]) -> f64[] {
    var sum = 0.0
    for x in xs {
        sum += x
    }
    let mean = sum / f64(xs.len)
    var squares = 0.0
    for x in xs {
        squares += (x - mean) * (x - mean)
    }
    [mean, squares / f64(xs.len)]
}

fn test_torus_noise_has_the_requested_deviation(t: *testing.T) {
    let s = fixed(4)
    let count = 40000
    for sigma in [1.0 / 32768.0, 1.0 / 33554432.0] {
        let draws = noise(s, count, sigma)
        var xs: f64[] = []
        var beyond_two = 0
        var beyond_four = 0
        for d in draws {
            let x = centred(d)
            xs.push(x)
            if x > 2.0 * sigma || x < -2.0 * sigma {
                beyond_two += 1
            }
            if x > 4.0 * sigma || x < -4.0 * sigma {
                beyond_four += 1
            }
        }
        let stats = mean_and_variance(xs)
        t.is_true(stats[0] > -4.0 * sigma / sqrt(f64(count)) && stats[0] < 4.0 * sigma / sqrt(f64(count)))
        t.is_true(stats[1] / (sigma * sigma) > 0.96 && stats[1] / (sigma * sigma) < 1.04)
        let share = f64(beyond_two) / f64(count)
        t.is_true(share > 0.0455 - 0.006 && share < 0.0455 + 0.006)
        t.is_true(beyond_four < 8)
    }
    t.equal_slice(noise(s, 5, 0.0), [u32(0), 0, 0, 0, 0])
}

fn test_fresh_encryptions_decrypt_and_carry_the_deviation(t: *testing.T) {
    let ctx = built(t, default_parameters())
    let s = fixed(5)
    let secret = secret_key(ctx, s)
    let other = secret_key(ctx, s)
    var errors: f64[] = []
    var right_under_other = 0
    let count = 2000
    for i in 0..count {
        let bit = i % 3 == 0
        let c = encrypt(ctx, secret, bit, s)
        t.is_true(decrypt(secret, c) == bit)
        errors.push(centred(phase(secret, c) - (if bit { eighth } else { 0 - eighth })))
        if decrypt(other, c) == bit {
            right_under_other += 1
        }
    }
    let stats = mean_and_variance(errors)
    let sigma = ctx.parameters.key_switch_sigma
    t.is_true(stats[1] / (sigma * sigma) > 0.9 && stats[1] / (sigma * sigma) < 1.1)
    t.is_true(right_under_other > 880 && right_under_other < 1120)
    t.equal(decrypt(secret, constant(ctx, true)), true)
    t.equal(decrypt(secret, constant(ctx, false)), false)
    t.equal(phase(secret, constant(ctx, true)), eighth)
    t.equal(phase(other, constant(ctx, false)), 0 - eighth)
}

fn ring_phase(ctx: *Context, secret: *SecretKey, acc: Accumulator) -> u32[] {
    let product = multiply(ctx, acc.a, transformed(ctx, secret.ring_key))
    let out: u32[] = __make(acc.a.len)
    for j in 0..out.len {
        out[j] = acc.b[j] - product[j]
    }
    out
}

fn gadget_variance(ctx: *Context) -> f64 {
    let p = ctx.parameters
    let base = f64(i64(1) << u64(p.gadget_bits))
    f64(2 * p.gadget_levels * p.degree) * (base * base + 2.0) / 12.0 * p.bootstrapping_sigma * p.bootstrapping_sigma
}

fn rounding_variance(ctx: *Context) -> f64 {
    let p = ctx.parameters
    let ulp = 1.0 / f64(i64(1) << u64(p.gadget_levels * p.gadget_bits))
    (1.0 + f64(p.degree) / 2.0) * ulp * ulp / 12.0
}

fn key_switch_variance(ctx: *Context) -> f64 {
    let p = ctx.parameters
    let base = f64(i64(1) << u64(p.key_switch_bits))
    let ulp = 1.0 / f64(i64(1) << u64(p.key_switch_levels * p.key_switch_bits))
    let used = f64(p.degree * p.key_switch_levels) * (base - 1.0) / base
    used * p.key_switch_sigma * p.key_switch_sigma + f64(p.degree) / 2.0 * ulp * ulp / 12.0
}

fn between(t: *testing.T, label: str, measured: f64, predicted: f64, low: f64, high: f64) {
    t.error_if(measured < low * predicted || measured > high * predicted, "{label}: variance {measured} against the predicted {predicted}")
}

fn error_variance(errors: f64[]) -> f64 {
    var squares = 0.0
    for e in errors {
        squares += e * e
    }
    squares / f64(errors.len)
}

fn test_external_product_noise_matches_the_gadget(t: *testing.T) {
    let ctx = built(t, default_parameters())
    let p = ctx.parameters
    let s = fixed(6)
    let secret = secret_key(ctx, s)
    let key_hat = transformed(ctx, secret.ring_key)
    let w = workspace(ctx)
    for bit in 0..2 {
        let row = encrypt_ring_bit(ctx, key_hat, u32(bit), s)
        var errors: f64[] = []
        for round in 0..4 {
            let acc = new(Accumulator { a: uniform_poly(s, p.degree), b: uniform_poly(s, p.degree) })
            let before = ring_phase(ctx, secret, *acc)
            let k = 1 + round * 513
            external_step(ctx, w, row, acc, k)
            let after = ring_phase(ctx, secret, *acc)
            let moved: u32[] = __make(p.degree)
            shift_minus_one(moved, before, k)
            for j in 0..p.degree {
                errors.push(centred(after[j] - (before[j] + u32(bit) * moved[j])))
            }
        }
        between(t, "external product by {bit}", error_variance(errors), gadget_variance(ctx) + f64(bit) * rounding_variance(ctx), 0.9, 1.1)
    }
}

fn test_key_switch_noise_matches_the_key(t: *testing.T) {
    let ctx = built(t, default_parameters())
    let p = ctx.parameters
    let s = fixed(8)
    let secret = secret_key(ctx, s)
    let cloud = new(CloudKey { bootstrapping: [], key_switch: key_switch_key(ctx, secret, s) })
    var errors: f64[] = []
    for _ in 0..400 {
        let a = uniform_poly(s, p.degree)
        let message = u32(ring.next_word(s))
        let switched = key_switch(ctx, cloud, Ciphertext { a, b: mask_sum(secret.ring_key, a) + message })
        errors.push(centred(phase(secret, switched) - message))
    }
    between(t, "key switch", error_variance(errors), key_switch_variance(ctx), 0.8, 1.25)
}

fn test_blind_rotation_noise_matches_the_bootstrapping_key(t: *testing.T) {
    let ctx = built(t, default_parameters())
    let p = ctx.parameters
    let s = fixed(9)
    let secret = secret_key(ctx, s)
    let cloud = new(CloudKey { bootstrapping: bootstrapping_key(ctx, secret, s), key_switch: [] })
    var errors: f64[] = []
    var predicted = 0.0
    let rounds = 6
    for round in 0..rounds {
        let c = encrypt(ctx, secret, round % 2 == 0, s)
        let acc = blind_rotated(ctx, cloud, c, eighth)
        var nonzero = 0
        var ones = 0
        for i in 0..p.lwe_size {
            if mod_switch(ctx, c.a[i]) != 0 {
                nonzero += 1
                ones += i64(secret.lwe[i])
            }
        }
        let table: u32[] = __make(p.degree)
        for j in 0..p.degree {
            table[j] = eighth
        }
        let position = switched_phase(ctx, secret, c)
        let ideal = shifted(table, (2 * p.degree - position) % (2 * p.degree))
        let got = ring_phase(ctx, secret, *acc)
        for j in 0..p.degree {
            errors.push(centred(got[j] - ideal[j]))
        }
        predicted += f64(nonzero) * gadget_variance(ctx) + f64(ones) * rounding_variance(ctx)
        let extracted = extract(acc)
        let off = signed_distance(extracted.b - mask_sum(secret.ring_key, extracted.a), ideal[0])
        t.is_true(off < i64(eighth) / 2 && off > -i64(eighth) / 2)
    }
    between(t, "blind rotation", error_variance(errors), predicted / f64(rounds), 0.8, 1.25)
}

fn all_gates() -> Gate[] {
    [Gate.And, Gate.Or, Gate.Nand, Gate.Nor, Gate.Xor, Gate.Xnor, Gate.AndNy, Gate.AndYn, Gate.OrNy, Gate.OrYn]
}

fn truth(g: Gate, a: bool, b: bool) -> bool {
    match g {
        And => a && b
        Or => a || b
        Nand => !(a && b)
        Nor => !(a || b)
        Xor => a != b
        Xnor => a == b
        AndNy => !a && b
        AndYn => a && !b
        OrNy => !a || b
        OrYn => a || !b
    }
}

fn switched_phase(ctx: *Context, secret: *SecretKey, c: Ciphertext) -> i64 {
    var turned = mod_switch(ctx, c.b)
    for i in 0..ctx.parameters.lwe_size {
        turned -= mod_switch(ctx, c.a[i]) * i64(secret.lwe[i])
    }
    let full = 2 * ctx.parameters.degree
    (turned % full + full) % full
}

fn boundary_distance(ctx: *Context, turned: i64) -> i64 {
    let half = ctx.parameters.degree
    let r = turned % half
    if r < half - r { r } else { half - r }
}

struct Bits {
    fresh: Ciphertext[]
    refreshed: Ciphertext[]
}

fn bits_of(ctx: *Context, keys: KeySet, s: *ring.Stream) -> Bits {
    let fresh = [encrypt(ctx, keys.secret, false, s), encrypt(ctx, keys.secret, true, s)]
    let refreshed = [apply(ctx, keys.cloud, Gate.Or, fresh[0], fresh[0]), apply(ctx, keys.cloud, Gate.Or, fresh[1], fresh[1])]
    Bits { fresh, refreshed }
}

fn check_gates(t: *testing.T, tag: u8, gates: Gate[]) {
    let ctx = built(t, default_parameters())
    let s = fixed(tag)
    let keys = generate(ctx, s)
    let bits = bits_of(ctx, keys, s)
    let pools = [bits.fresh, bits.refreshed]
    let safe = ctx.parameters.degree / 8
    for g in gates {
        for x in 0..2 {
            for y in 0..2 {
                let a = pools[y][x]
                let b = pools[x][y]
                let before = boundary_distance(ctx, switched_phase(ctx, keys.secret, weigh(ctx, g, a, b)))
                t.error_if(before < safe, "{g} {x} {y}: {before} of {ctx.parameters.degree} before bootstrapping, below {safe}")
                let c = apply(ctx, keys.cloud, g, a, b)
                t.error_if(decrypt(keys.secret, c) != truth(g, x == 1, y == 1), "{g} {x} {y}: decrypted {decrypt(keys.secret, c)}")
                let after = boundary_distance(ctx, switched_phase(ctx, keys.secret, c))
                t.error_if(after < safe, "{g} {x} {y}: {after} of {ctx.parameters.degree} after bootstrapping, below {safe}")
            }
        }
    }
}

fn test_and_and_or_gates(t: *testing.T) {
    check_gates(t, 10, [Gate.And, Gate.Or])
}

fn test_nand_and_nor_gates(t: *testing.T) {
    check_gates(t, 11, [Gate.Nand, Gate.Nor])
}

fn test_xor_and_xnor_gates(t: *testing.T) {
    check_gates(t, 12, [Gate.Xor, Gate.Xnor])
}

fn test_and_gates_with_a_negated_input(t: *testing.T) {
    check_gates(t, 13, [Gate.AndNy, Gate.AndYn])
}

fn test_or_gates_with_a_negated_input(t: *testing.T) {
    check_gates(t, 14, [Gate.OrNy, Gate.OrYn])
}

fn check_mux(t: *testing.T, tag: u8, selector: bool) {
    let ctx = built(t, default_parameters())
    let s = fixed(tag)
    let keys = generate(ctx, s)
    let bits = bits_of(ctx, keys, s)
    let chosen = if selector { bits.refreshed[1] } else { bits.fresh[0] }
    for yes in 0..2 {
        for no in 0..2 {
            let c = mux(ctx, keys.cloud, chosen, bits.refreshed[yes], bits.fresh[no])
            let want = if selector { yes == 1 } else { no == 1 }
            t.error_if(decrypt(keys.secret, c) != want, "mux {selector} {yes} {no}: decrypted {decrypt(keys.secret, c)}")
            t.error_if(boundary_distance(ctx, switched_phase(ctx, keys.secret, c)) < ctx.parameters.degree / 8, "mux {selector} {yes} {no}: the output is too noisy")
        }
    }
}

fn test_mux_with_a_true_selector_returns_the_first_input(t: *testing.T) {
    check_mux(t, 15, true)
}

fn test_mux_with_a_false_selector_returns_the_second_input(t: *testing.T) {
    check_mux(t, 16, false)
}

fn test_gates_under_another_cloud_key_give_wrong_bits(t: *testing.T) {
    let ctx = built(t, default_parameters())
    let s = fixed(17)
    let keys = generate(ctx, s)
    let other = generate(ctx, s)
    let fresh = [encrypt(ctx, keys.secret, false, s), encrypt(ctx, keys.secret, true, s)]
    var right = 0
    var wrong = 0
    for round in 0..8 {
        let x = round % 2
        let y = round / 2 % 2
        let g = Gate.Xor
        let c = apply(ctx, other.cloud, g, fresh[x], fresh[y])
        if decrypt(keys.secret, c) == truth(g, x == 1, y == 1) {
            right += 1
        } else {
            wrong += 1
        }
    }
    t.is_true(wrong > 0 && right > 0)
}

struct Sum {
    bits: Ciphertext[]
    carry: Ciphertext
}

fn add_bits(ctx: *Context, cloud: *CloudKey, a: Ciphertext[], b: Ciphertext[]) -> Sum {
    var out: Ciphertext[] = []
    var carry = apply(ctx, cloud, Gate.And, a[0], b[0])
    out.push(apply(ctx, cloud, Gate.Xor, a[0], b[0]))
    for i in 1..a.len {
        let x = apply(ctx, cloud, Gate.Xor, a[i], b[i])
        out.push(apply(ctx, cloud, Gate.Xor, x, carry))
        carry = mux(ctx, cloud, x, carry, a[i])
    }
    Sum { bits: out, carry }
}

fn encrypt_number(ctx: *Context, secret: *SecretKey, value: i64, width: i64, s: *ring.Stream) -> Ciphertext[] {
    var out: Ciphertext[] = []
    for i in 0..width {
        out.push(encrypt(ctx, secret, value >> u64(i) & 1 == 1, s))
    }
    out
}

fn check_addition(t: *testing.T, tag: u8, x: i64, y: i64) {
    let ctx = built(t, default_parameters())
    let s = fixed(tag)
    let keys = generate(ctx, s)
    let sum = add_bits(ctx, keys.cloud, encrypt_number(ctx, keys.secret, x, 4, s), encrypt_number(ctx, keys.secret, y, 4, s))
    var got = 0
    for i in 0..4 {
        if decrypt(keys.secret, sum.bits[i]) {
            got += 1 << u64(i)
        }
    }
    if decrypt(keys.secret, sum.carry) {
        got += 16
    }
    t.equal(got, x + y)
}

fn test_four_bit_addition_carries_through_every_position(t: *testing.T) {
    check_addition(t, 18, 15, 1)
}

fn test_four_bit_addition_matches_clear_arithmetic(t: *testing.T) {
    check_addition(t, 19, 11, 7)
}
