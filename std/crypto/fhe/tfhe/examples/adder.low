import std/crypto/fhe/ring
import std/crypto/fhe/tfhe

const width = 4

fn encrypt_number(ctx: *tfhe.Context, secret: *tfhe.SecretKey, value: i64, s: *ring.Stream) -> tfhe.Ciphertext[] {
    var bits: tfhe.Ciphertext[] = []
    for i in 0..width {
        bits.push(tfhe.encrypt(ctx, secret, value >> u64(i) & 1 == 1, s))
    }
    bits
}

fn decrypt_number(secret: *tfhe.SecretKey, bits: tfhe.Ciphertext[]) -> i64 {
    var value = 0
    for i in 0..bits.len {
        if tfhe.decrypt(secret, bits[i]) {
            value += 1 << u64(i)
        }
    }
    value
}

fn add(ctx: *tfhe.Context, cloud: *tfhe.CloudKey, a: tfhe.Ciphertext[], b: tfhe.Ciphertext[]) -> tfhe.Ciphertext[] {
    var sum: tfhe.Ciphertext[] = [tfhe.apply(ctx, cloud, tfhe.Gate.Xor, a[0], b[0])]
    var carry = tfhe.apply(ctx, cloud, tfhe.Gate.And, a[0], b[0])
    for i in 1..a.len {
        let x = tfhe.apply(ctx, cloud, tfhe.Gate.Xor, a[i], b[i])
        sum.push(tfhe.apply(ctx, cloud, tfhe.Gate.Xor, x, carry))
        carry = tfhe.mux(ctx, cloud, x, carry, a[i])
    }
    sum.push(carry)
    sum
}

/// Adds two 4-bit numbers while they are encrypted, with a ripple-carry adder of encrypted gates: the cloud key evaluates the gates and never sees the bits, and each gate output is refreshed by a bootstrapping, so the noise does not grow along the carry chain.
fn main() ! tfhe.Error {
    let ctx = tfhe.context(tfhe.default_parameters())?
    let s = ring.stream()
    let keys = tfhe.generate(ctx, s)
    let x = 11
    let y = 7
    let sum = add(ctx, keys.cloud, encrypt_number(ctx, keys.secret, x, s), encrypt_number(ctx, keys.secret, y, s))
    print("{x} + {y} = {decrypt_number(keys.secret, sum)}")
    let inverted = tfhe.not(ctx, sum[1])
    print("bit 1 of the sum is {tfhe.decrypt(keys.secret, sum[1])}, its negation {tfhe.decrypt(keys.secret, inverted)}")
    let chosen = tfhe.mux(ctx, keys.cloud, sum[4], tfhe.constant(ctx, true), tfhe.constant(ctx, false))
    print("the sum overflows 4 bits: {tfhe.decrypt(keys.secret, chosen)}")
}
