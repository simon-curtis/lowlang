import std/crypto/der
import std/io

/// An extension of a certificate or certification request, in the form `Template.extensions` takes.
pub struct Extension {
    /// The object identifier in dotted form, such as `1.3.6.1.5.5.7.1.31`.
    pub id: str
    /// Whether the extension is marked critical.
    pub critical: bool = false
    /// The DER encoding of the extension value, the content of the `extnValue` octet string.
    pub value: u8[]
}

/// The contents of a certificate that `create_certificate` and `create_self_signed` write.
///
/// The certificate is X.509 version 3. Its subject alternative name extension is built from `dns_names` and `ip_addresses`, marked critical when `subject` is empty as RFC 5280 section 4.2.1.6 requires, and comes first; `extensions` follow in order.
pub struct Template {
    /// The serial number as a big-endian magnitude of 1 to 20 bytes that is not zero.
    pub serial: u8[]
    /// The common name of the subject, or the empty string for an empty subject name.
    pub subject: str = ""
    /// The start of the validity period in Unix seconds.
    pub not_before: i64
    /// The end of the validity period in Unix seconds.
    pub not_after: i64
    /// The `dNSName` entries of the subject alternative name extension.
    pub dns_names: str[] = []
    /// The `iPAddress` entries of the subject alternative name extension, each 4 or 16 bytes.
    pub ip_addresses: u8[][] = []
    /// Further extensions to write, none of which may repeat `2.5.29.17` when `dns_names` or `ip_addresses` is not empty.
    pub extensions: Extension[] = []
}

struct SignatureAlgorithm {
    scheme: i64
    identifier: u8[]
}

fn signature_algorithm(key: PrivateKey) -> SignatureAlgorithm ! io.Error {
    match key {
        Rsa(_) => SignatureAlgorithm { scheme: 0x0401, identifier: algorithm_with("1.2.840.113549.1.1.11", null())? }
        Ecdsa(k) => match k.curve {
            P256 => SignatureAlgorithm { scheme: 0x0403, identifier: algorithm_with("1.2.840.10045.4.3.2", [])? }
            P384 => SignatureAlgorithm { scheme: 0x0503, identifier: algorithm_with("1.2.840.10045.4.3.3", [])? }
        }
        Ed25519(_) => SignatureAlgorithm { scheme: 0x0807, identifier: algorithm_with(ed25519_oid, [])? }
    }
}

fn signed(key: PrivateKey, body: u8[]) -> u8[] ! io.Error {
    let algorithm = signature_algorithm(key)?
    let signature = sign(key, algorithm.scheme, body, SignatureRules.Tls12)?
    der.sequence([body, algorithm.identifier, der.bit_string(signature)])
}

fn name_der(common_name: str) -> u8[] ! io.Error {
    if common_name.len == 0 {
        return der.sequence([])
    }
    let kind = der.object_identifier("2.5.4.3")?
    let attribute = der.sequence([kind, der.utf8_string(common_name)])
    let set = der.set([attribute])
    der.sequence([set])
}

fn general_names_der(dns_names: str[], ip_addresses: u8[][]) -> u8[] ! io.Error {
    var names: u8[][] = []
    for name in dns_names {
        if name.len == 0 {
            fail Invalid
        }
        names.push(der.encode(0x82, bytes(name)))
    }
    for address in ip_addresses {
        if address.len != 4 && address.len != 16 {
            fail Invalid
        }
        names.push(der.encode(0x87, address))
    }
    der.sequence(names)
}

fn extension_der(e: Extension) -> u8[] ! io.Error {
    let id = der.object_identifier(e.id)?
    let value = der.octet_string(e.value)
    if e.critical {
        return der.sequence([id, [0x01, 0x01, 0xFF], value])
    }
    der.sequence([id, value])
}

fn subject_alt_name(dns_names: str[], ip_addresses: u8[][], critical: bool) -> u8[] ! io.Error {
    let value = general_names_der(dns_names, ip_addresses)?
    extension_der(Extension { id: "2.5.29.17", critical, value })?
}

fn serial_valid(serial: u8[]) -> bool {
    let digits = der.trim_zeros(serial)
    digits.len > 0 && digits.len <= 20 && (digits.len < 20 || digits[0] < 0x80)
}

fn extension_list(t: Template) -> u8[] ! io.Error {
    var parts: u8[][] = []
    if t.dns_names.len > 0 || t.ip_addresses.len > 0 {
        let names = subject_alt_name(t.dns_names, t.ip_addresses, t.subject.len == 0)?
        parts.push(names)
    }
    for e in t.extensions {
        if e.id == "2.5.29.17" && parts.len > 0 {
            fail Invalid
        }
        let encoded = extension_der(e)?
        parts.push(encoded)
    }
    der.sequence(parts)
}

/// Returns the DER certificate that `signer` issues for the public key `public_key_info` under `issuer`, with the contents of `template`.
///
/// `public_key_info` is a DER `SubjectPublicKeyInfo`, as `public_key_info` returns for a private key, and `issuer` is the DER `Name` of the issuing certificate, such as `Certificate.subject`. The signature algorithm follows the signer: RSA PKCS#1 v1.5 with SHA-256, ECDSA with SHA-256 on P-256 or SHA-384 on P-384, or Ed25519.
///
/// Fails with `Invalid` when the serial number is not 1 to 20 bytes that are not zero, `not_after` is before `not_before`, a time is outside the years 0001 to 9999, a DNS name is empty, an address is not 4 or 16 bytes, an extension repeats the subject alternative name or the signer cannot sign. Fails with `Malformed` for an object identifier that is not dotted decimal.
pub fn create_certificate(template: Template, public_key_info: u8[], signer: PrivateKey, issuer: u8[]) -> u8[] ! io.Error {
    if !serial_valid(template.serial) || template.not_after < template.not_before {
        fail Invalid
    }
    let algorithm = signature_algorithm(signer)?
    let version = der.encode(0xA0, der.integer([2]))
    let from = der.time_value(template.not_before)?
    let until = der.time_value(template.not_after)?
    let validity = der.sequence([from, until])
    let listed = extension_list(template)?
    let extensions = der.encode(0xA3, listed)
    let subject = name_der(template.subject)?
    let serial = der.integer(template.serial)
    let body = der.sequence([version, serial, algorithm.identifier, issuer, validity, subject, public_key_info, extensions])
    signed(signer, body)?
}

/// Returns the DER certificate that `key` issues for itself, with the contents of `template`.
///
/// The issuer is the subject name of `template`. See `create_certificate` for the signature algorithm and the failures.
pub fn create_self_signed(template: Template, key: PrivateKey) -> u8[] ! io.Error {
    let public = public_key_info(key)?
    let name = name_der(template.subject)?
    create_certificate(template, public, key, name)?
}

/// Returns the DER PKCS#10 certification request (RFC 2986) for `key`, signed with it.
///
/// The request has the common name `subject`, or an empty subject name when `subject` is empty, and, when `dns_names` or `ip_addresses` is not empty, an `extensionRequest` attribute (RFC 2985) holding the subject alternative name extension, marked critical when `subject` is empty. The signature algorithm follows the key as for `create_certificate`.
///
/// Fails with `Invalid` for an empty DNS name, an address that is not 4 or 16 bytes, or a key that cannot sign.
pub fn create_request(key: PrivateKey, subject: str, dns_names: str[], ip_addresses: u8[][]) -> u8[] ! io.Error {
    var attributes: u8[] = []
    if dns_names.len > 0 || ip_addresses.len > 0 {
        let names = subject_alt_name(dns_names, ip_addresses, subject.len == 0)?
        let extensions = der.sequence([names])
        let kind = der.object_identifier("1.2.840.113549.1.9.14")?
        attributes = der.sequence([kind, der.set([extensions])])
    }
    let name = name_der(subject)?
    let public = public_key_info(key)?
    let body = der.sequence([der.integer([0]), name, public, der.encode(0xA0, attributes)])
    signed(key, body)?
}
