import std/crypto/x509
import std/io
import std/text

fn root_pem() -> str {
    text.join([
        "-----BEGIN CERTIFICATE-----",
        "MIIBizCCATGgAwIBAgIBATAKBggqhkjOPQQDAjAaMRgwFgYDVQQDDA9FeGFtcGxl",
        "IFJvb3QgQ0EwIBcNMjAwMTAxMDAwMDAwWhgPMjA5OTEyMzEyMzU5NTlaMBoxGDAW",
        "BgNVBAMMD0V4YW1wbGUgUm9vdCBDQTBZMBMGByqGSM49AgEGCCqGSM49AwEHA0IA",
        "BNtIfBz4gGjFG+N29+wqmbevuxlzu74CINQej1eLVSoSO1HK9xZBYcwqrX4v1Bje",
        "s2hTGzIBX6uoHOxn+88zguCjZjBkMB0GA1UdDgQWBBSx7ETjrGtCwXXqmWdhFtC0",
        "xrjihzAfBgNVHSMEGDAWgBSx7ETjrGtCwXXqmWdhFtC0xrjihzASBgNVHRMBAf8E",
        "CDAGAQH/AgEAMA4GA1UdDwEB/wQEAwIBBjAKBggqhkjOPQQDAgNIADBFAiEA3GW4",
        "BzB590hzldi/u5cdEIPYRAsSePAOCuDd3TOkm54CID/q2bU1g1RnbPA8TyMD99cw",
        "FUCJQunZxUrddaAwKvt7",
        "-----END CERTIFICATE-----",
    ], "\n")
}

fn leaf_pem() -> str {
    text.join([
        "-----BEGIN CERTIFICATE-----",
        "MIIB5DCCAYqgAwIBAgIBAjAKBggqhkjOPQQDAjAaMRgwFgYDVQQDDA9FeGFtcGxl",
        "IFJvb3QgQ0EwIBcNMjAwMTAxMDAwMDAwWhgPMjA5OTEyMzEyMzU5NTlaMBsxGTAX",
        "BgNVBAMMEGFwaS5leGFtcGxlLnRlc3QwWTATBgcqhkjOPQIBBggqhkjOPQMBBwNC",
        "AASMnro+KI1gi4JPM/BfEUTJHFod5pT4DPjyD68VUEvWE/FrCUTrVsM3BhK7lmZj",
        "vSrnaJlDRS1Tc/wnbzrDnIVuo4G9MIG6MAwGA1UdEwEB/wQCMAAwDgYDVR0PAQH/",
        "BAQDAgeAMBMGA1UdJQQMMAoGCCsGAQUFBwMBMEUGA1UdEQQ+MDyCEGFwaS5leGFt",
        "cGxlLnRlc3SCFyouaW50ZXJuYWwuZXhhbXBsZS50ZXN0gglsb2NhbGhvc3SHBH8A",
        "AAEwHQYDVR0OBBYEFPlcx/g5qUR3keu0lMFfQ4BUbr0jMB8GA1UdIwQYMBaAFLHs",
        "ROOsa0LBdeqZZ2EW0LTGuOKHMAoGCCqGSM49BAMCA0gAMEUCIQDm29iKeZmku0Qe",
        "M1GCb0/+zBrGdvKlMlZEFk3yUDO1mQIgId2ADpPfaI4dBMyv3WBuT1DvtV+aDvej",
        "unjWXaN+fJo=",
        "-----END CERTIFICATE-----",
    ], "\n")
}

fn judge(label: str, leaf: x509.Certificate, roots: []x509.Certificate, host: str, now: i64) {
    let path = x509.verify_chain(leaf, [], roots, host, now) catch {
        Denied => {
            print("{label}: host does not match the certificate")
            return
        }
        Invalid => {
            print("{label}: no valid path")
            return
        }
        _ => {
            print("{label}: failed")
            return
        }
    }
    print("{label}: trusted through {path.len} certificates, ending at {path[path.len - 1].common_name}")
}

fn run() ! io.Error {
    let bundle = "{leaf_pem()}\n{root_pem()}\n"
    let blocks = x509.pem_certificates(bundle)
    print("{blocks.len} certificates in the bundle")

    let leaf = x509.parse(blocks[0])?
    let root = x509.parse(blocks[1])?
    print("leaf subject {leaf.common_name}, names {text.join(leaf.dns_names, ", ")}, {leaf.ip_addresses.len} address")
    print("leaf is a CA: {leaf.ca}, signed by root: {x509.check_signature(root, leaf)}")
    print("root is a CA: {root.ca}, path length {root.path_length ?? -1}, self-signed: {x509.check_signature(root, root)}")
    print("leaf key algorithm {leaf.public_key.algorithm}, curve {leaf.public_key.parameters}")

    let now = 1900000000
    judge("api host", leaf, [root], "api.example.test", now)
    judge("wildcard host", leaf, [root], "billing.internal.example.test", now)
    judge("wrong host", leaf, [root], "www.example.test", now)
    judge("loopback address", leaf, [root], "127.0.0.1", now)
    judge("year 2100", leaf, [root], "api.example.test", 4102444800)
    judge("no trusted roots", leaf, [], "api.example.test", now)
}

/// Parses a leaf and its root from a PEM bundle and verifies the chain at a fixed time for several hostnames, an expired clock and an empty trust store.
fn main() {
    run() catch {
        e => print("failed: {e}")
    }
}
