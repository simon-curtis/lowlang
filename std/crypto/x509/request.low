import std/crypto/der
import std/io

/// A parsed PKCS#10 certification request (RFC 2986).
///
/// `parse_request` produces it and keeps slices of the input, so the DER buffer must stay alive and unmodified for as long as the request is used.
pub struct Request {
    /// The complete DER encoding of the request.
    pub raw: u8[]
    /// The DER encoding of the `certificationRequestInfo`, the bytes that were signed.
    pub info: u8[]
    /// The DER encoding of the subject `Name`.
    pub subject: u8[]
    /// The first common name in the subject as UTF-8, or the empty string when there is none.
    pub common_name: str
    /// The public key the request is for.
    pub public_key: PublicKeyInfo
    /// The `dNSName` entries of the subject alternative name in the `extensionRequest` attribute. Empty when there is none.
    pub dns_names: str[]
    /// The `iPAddress` entries of the subject alternative name in the `extensionRequest` attribute as 4 or 16 raw bytes. Empty when there is none.
    pub ip_addresses: u8[][]
    /// The object identifier of the signature algorithm in dotted form.
    pub signature_algorithm: str
    /// The DER encoding of the signature algorithm parameters, or an empty slice when there are none.
    pub signature_parameters: u8[]
    /// The signature bytes, with the bit string's unused-bits octet removed.
    pub signature: u8[]
}

fn requested_extensions(value: u8[], mut r: Request) ! io.Error {
    let list = der.reader(value)
    let extensions = der.enter(list, 0x30)?
    der.finish(list)?
    for !der.done(extensions) {
        let ext = read_extension(extensions)?
        if ext.id == "2.5.29.17" {
            let names = general_names(ext.value)?
            r.dns_names = names.dns
            r.ip_addresses = names.ips
        }
    }
}

fn attributes(content: u8[], mut r: Request) ! io.Error {
    let d = der.reader(content)
    for !der.done(d) {
        let attribute = der.enter(d, 0x30)?
        let kind = der.expect(attribute, 0x06)?
        let values = der.enter(attribute, 0x31)?
        der.finish(attribute)?
        let id = der.oid(kind.content)?
        if id == "1.2.840.113549.1.9.14" {
            let first = der.read(values)?
            if first.tag != 0x30 {
                fail Malformed
            }
            requested_extensions(first.raw, mut r)?
        }
    }
}

/// Parses a DER PKCS#10 certification request.
///
/// Parsing is strict DER. Fails with `Malformed` for bad encodings, trailing bytes, a version other than `0`, or a signature algorithm outside the `AlgorithmIdentifier` form, and with `Unsupported` for a multi-octet tag. The signature is not verified; see `check_request_signature`.
pub fn parse_request(encoded: u8[]) -> Request ! io.Error {
    let outer = der.whole(encoded, 0x30)?
    let body = der.reader(outer.content)
    let info = der.expect(body, 0x30)?
    let algorithm = algorithm_id(body)?
    let signature_bits = der.expect(body, 0x03)?
    der.finish(body)?
    let t = der.reader(info.content)
    let version = der.expect(t, 0x02)?
    if der.small_int(version.content)? != 0 {
        fail Malformed
    }
    let subject = der.expect(t, 0x30)?
    let key = read_public_key_info(t)?
    let wrapper = der.enter(t, 0xA0)?
    der.finish(t)?
    let name = common_name(subject)?
    let signature = der.bits(signature_bits.content)?
    var r = Request {
        raw: outer.raw, info: info.raw, subject: subject.raw, common_name: name, public_key: key, dns_names: [],
        ip_addresses: [], signature_algorithm: algorithm.oid, signature_parameters: algorithm.parameters, signature,
    }
    attributes(wrapper.data, mut r)?
    r
}

/// Returns whether `r` carries a valid signature by its own public key, the proof of possession of RFC 2986 section 3.
///
/// The schemes are those of `check_signature`. Returns `false` for any other scheme or when verification fails.
pub fn check_request_signature(r: Request) -> bool {
    signed_by(r.public_key, r.signature_algorithm, r.signature_parameters, r.info, r.signature)
}
