import std/base64
import std/crypto/der
import std/crypto/ecdsa
import std/crypto/ed25519
import std/crypto/rsa
import std/io
import std/text

/// The kinds of private key `generate_private_key` makes.
pub enum KeyType {
    /// An ECDSA key on P-256.
    P256
    /// An ECDSA key on P-384.
    P384
    /// An Ed25519 key.
    Ed25519
}

/// Returns a new private key of `kind` from `std/crypto`'s random bytes.
pub fn generate_private_key(kind: KeyType) -> PrivateKey ! io.Error {
    match kind {
        P256 => ecdsa_key(ecdsa.Curve.P256)?
        P384 => ecdsa_key(ecdsa.Curve.P384)?
        Ed25519 => PrivateKey.Ed25519(ed25519.generate())
    }
}

fn ecdsa_key(curve: ecdsa.Curve) -> PrivateKey ! io.Error {
    let private = ecdsa.generate(curve)
    let public = ecdsa.public_key(curve, private)?
    PrivateKey.Ecdsa(ecdsa.Key { curve, private, public })
}

fn curve_oid(curve: ecdsa.Curve) -> str {
    match curve {
        P256 => der.prime256v1
        P384 => der.secp384r1
    }
}

fn null() -> u8[] {
    [0x05, 0x00]
}

fn algorithm_with(oid: str, parameters: u8[]) -> u8[] ! io.Error {
    let name = der.object_identifier(oid)?
    if parameters.len == 0 {
        return der.sequence([name])
    }
    der.sequence([name, parameters])
}

fn rsa_private_der(key: rsa.PrivateKey) -> u8[] {
    der.sequence([
        der.integer([0]), der.integer(key.n), der.integer(key.e), der.integer(key.d), der.integer(key.p),
        der.integer(key.q), der.integer(key.dp), der.integer(key.dq), der.integer(key.qinv),
    ])
}

/// Returns the DER `SubjectPublicKeyInfo` (RFC 5280 section 4.1.2.7) of the public key that belongs to `key`.
///
/// An RSA key gives `rsaEncryption` with `NULL` parameters and a PKCS#1 `RSAPublicKey`, an ECDSA key `id-ecPublicKey` with its named curve and the uncompressed point, and an Ed25519 key `id-Ed25519` (RFC 8410) with the 32 public key bytes.
pub fn public_key_info(key: PrivateKey) -> u8[] ! io.Error {
    match key {
        Rsa(k) => {
            let algorithm = algorithm_with(rsa_oid, null())?
            der.sequence([algorithm, der.bit_string(der.sequence([der.integer(k.n), der.integer(k.e)]))])
        }
        Ecdsa(k) => {
            let name = der.object_identifier(curve_oid(k.curve))?
            let algorithm = algorithm_with(ec_oid, name)?
            der.sequence([algorithm, der.bit_string(k.public)])
        }
        Ed25519(seed) => {
            let algorithm = algorithm_with(ed25519_oid, [])?
            der.sequence([algorithm, der.bit_string(ed25519.public_key(seed))])
        }
    }
}

/// Returns the DER PKCS#8 `PrivateKeyInfo` (RFC 5208) of `key`, which `parse_private_key` reads back.
///
/// An RSA key holds its PKCS#1 `RSAPrivateKey`, an ECDSA key a SEC 1 `ECPrivateKey` with the public point and the curve named in the algorithm parameters, and an Ed25519 key the octet string of its seed (RFC 8410).
pub fn private_key_der(key: PrivateKey) -> u8[] ! io.Error {
    match key {
        Rsa(k) => {
            let algorithm = algorithm_with(rsa_oid, null())?
            der.sequence([der.integer([0]), algorithm, der.octet_string(rsa_private_der(k))])
        }
        Ecdsa(k) => {
            let name = der.object_identifier(curve_oid(k.curve))?
            let algorithm = algorithm_with(ec_oid, name)?
            let inner = der.sequence([der.integer([1]), der.octet_string(k.private), der.encode(0xA1, der.bit_string(k.public))])
            der.sequence([der.integer([0]), algorithm, der.octet_string(inner)])
        }
        Ed25519(seed) => {
            let algorithm = algorithm_with(ed25519_oid, [])?
            der.sequence([der.integer([0]), algorithm, der.octet_string(der.octet_string(seed))])
        }
    }
}

/// Returns the DER SEC 1 `ECPrivateKey` (RFC 5915) of `key`, with the named curve and the public point.
pub fn sec1_private_key_der(key: ecdsa.Key) -> u8[] ! io.Error {
    let name = der.object_identifier(curve_oid(key.curve))?
    der.sequence([
        der.integer([1]), der.octet_string(key.private), der.encode(0xA0, name), der.encode(0xA1, der.bit_string(key.public)),
    ])
}

/// Returns `data` as a PEM block (RFC 7468) labelled `label`: Base64 in lines of 64 characters between `-----BEGIN label-----` and `-----END label-----` lines, each ending in a newline.
pub fn pem_encode(label: str, data: u8[]) -> str {
    let body = base64.encode(data)
    var out: u8[] = []
    text.append(mut out, "-----BEGIN {label}-----\n")
    var at = 0
    for at < body.len {
        let stop = if at + 64 < body.len { at + 64 } else { body.len }
        text.append(mut out, body[at..stop])
        out.push('\n')
        at = stop
    }
    text.append(mut out, "-----END {label}-----\n")
    str(out)
}

/// Returns the PEM text of the PKCS#8 encoding of `key`, labelled `PRIVATE KEY`, which `pem_private_key` reads back.
pub fn private_key_pem(key: PrivateKey) -> str ! io.Error {
    let encoded = private_key_der(key)?
    pem_encode("PRIVATE KEY", encoded)
}

/// Returns the PEM text of the DER certificate `der`, labelled `CERTIFICATE`.
pub fn certificate_pem(encoded: u8[]) -> str {
    pem_encode("CERTIFICATE", encoded)
}
