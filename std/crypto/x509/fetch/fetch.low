import std/base64
import std/crypto/x509
import std/http
import std/io
import std/uri

const small_request = 255
const largest_response = 33554432

/// Returns an HTTP client for revocation data: a 10 second limit per request, up to 3 redirects and no cookies.
///
/// Redirects are needed because a CRL distribution point commonly moves between hosts. The client verifies `https` servers against the system roots and never checks their revocation status.
pub fn client() -> *http.Client {
    http.client().with_timeout(10000).with_redirects(3).with_user_agent("low-x509").build()
}

fn body_of(response: http.Response) -> u8[] ! io.Error {
    if response.status != 200 {
        fail Invalid
    }
    if response.body.len > largest_response {
        fail TooLarge
    }
    response.body
}

fn send(request: http.Builder[http.Response]) -> u8[] ! io.Error {
    let response = http.send(request) catch {
        Connect(cause) => fail cause
        Tls(cause) => fail cause
        Timeout => fail TimedOut
        Protocol(cause) => fail cause
        Decode(cause) => fail cause
        Io(cause) => fail cause
        _ => fail Invalid
    }
    body_of(response)
}

fn get_url(url: str, request: u8[]) -> str {
    let encoded = uri.escape(base64.encode(request))
    if url.len > 0 && url[url.len - 1] == 0x2F {
        return "{url}{encoded}"
    }
    "{url}/{encoded}"
}

/// Sends the DER encoded OCSP `request` to the responder at `url` and returns the DER encoded response (RFC 6960 appendix A.1).
///
/// A request shorter than 255 bytes is sent with GET, the base64 form of the request percent-encoded as the last path segment of `url`, so that caches can serve it; a longer one is sent with POST and the content type `application/ocsp-request`. A status other than `200` fails with `Invalid`, a body over 32 MiB with `TooLarge`, and a failed connection or exchange with the underlying error, `TimedOut` for a request that ran out of time. The response is not interpreted; `parse_ocsp` and `ocsp_status` do that.
pub fn ocsp(c: *http.Client, url: str, request: u8[]) -> u8[] ! io.Error {
    if request.len < small_request {
        let target = get_url(url, request)
        let get = http.request(c, "GET", target).with_header("accept", "application/ocsp-response")
        return send(get)?
    }
    let post = http.request(c, "POST", url).with_header("accept", "application/ocsp-response").with_body(request, "application/ocsp-request")
    send(post)?
}

/// Returns the DER encoded certificate revocation list at `url`.
///
/// A status other than `200` fails with `Invalid`, a body over 32 MiB with `TooLarge`, and a failed connection or exchange with the underlying error. A list that a server sends PEM encoded is not converted; `parse_crl` rejects it.
pub fn crl(c: *http.Client, url: str) -> u8[] ! io.Error {
    let get = http.request(c, "GET", url).with_header("accept", "application/pkix-crl")
    send(get)?
}

/// Returns the `Fetcher` that `ocsp` and `crl` make over `c`, for `Revocation.fetcher`.
pub fn fetcher(c: *http.Client) -> x509.Fetcher {
    x509.Fetcher {
        ocsp: fn(url: str, request: u8[]) -> u8[] ! io.Error { ocsp(c, url, request) },
        crl: fn(url: str) -> u8[] ! io.Error { crl(c, url) },
    }
}
