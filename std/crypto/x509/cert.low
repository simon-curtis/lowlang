import std/crypto/der
import std/crypto/hash
import std/io
import std/unicode
import std/unicode/utf16
import std/unicode/utf32

/// The `SubjectPublicKeyInfo` of a certificate (RFC 5280 section 4.1.2.7): the key algorithm and the encoded key.
pub struct PublicKeyInfo {
    /// The algorithm object identifier in dotted form, such as `1.2.840.113549.1.1.1` for RSA, `1.2.840.10045.2.1` for elliptic curve keys and `1.3.101.112` for Ed25519.
    pub algorithm: str
    /// The object identifier in the algorithm parameters, such as the named curve of an elliptic curve key (`1.2.840.10045.3.1.7` for P-256), or the empty string when the parameters are absent or not an object identifier.
    pub parameters: str
    /// The bytes of the `subjectPublicKey` bit string: a DER `RSAPublicKey`, an uncompressed SEC 1 point or the 32 raw Ed25519 bytes, depending on `algorithm`.
    pub key: []u8
}

/// A parsed X.509 certificate (RFC 5280).
///
/// `parse` produces it and keeps slices of the input, so the DER buffer must stay alive and unmodified for as long as the certificate is used.
pub struct Certificate {
    /// The complete DER encoding of the certificate.
    pub raw: []u8
    /// The DER encoding of the `tbsCertificate`, the bytes the issuer signed.
    pub tbs: []u8
    /// The version as encoded: `0` for v1, `1` for v2 and `2` for v3.
    pub version: i64
    /// The content bytes of the serial number integer.
    pub serial: []u8
    /// The DER encoding of the issuer `Name`, comparable byte for byte with the `subject` of the issuing certificate.
    pub issuer: []u8
    /// The DER encoding of the subject `Name`.
    pub subject: []u8
    /// The first common name (`2.5.4.3`) in the subject as UTF-8, or the empty string when there is none.
    ///
    /// BMP and universal strings are converted to UTF-8; other string types are taken as they are.
    pub common_name: str
    /// The start of the validity period in Unix seconds.
    pub not_before: i64
    /// The end of the validity period in Unix seconds, inclusive.
    pub not_after: i64
    /// The object identifier of the signature algorithm in dotted form.
    pub signature_algorithm: str
    /// The DER encoding of the signature algorithm parameters, or an empty slice when there are none.
    pub signature_parameters: []u8
    /// The signature bytes, with the bit string's unused-bits octet removed.
    pub signature: []u8
    /// The subject public key.
    pub public_key: PublicKeyInfo
    /// The `dNSName` entries of the subject alternative name extension, in order. Empty when the extension is absent.
    pub dns_names: []str
    /// The `iPAddress` entries of the subject alternative name extension as 4 or 16 raw bytes. Empty when the extension is absent.
    pub ip_addresses: [][]u8
    /// Whether the basic constraints extension marks the certificate as a certificate authority. `false` when the extension is absent.
    pub ca: bool
    /// The `pathLenConstraint` of the basic constraints extension, or `none` when it is absent.
    pub path_length: i64?
    /// The key usage extension as a bit set, or `none` when the extension is absent.
    ///
    /// Bit `n` is set when the `n`th named bit of RFC 5280 section 4.2.1.3 is, counting from the most significant bit of the first byte: bit `0` is `digitalSignature` and bit `5` is `keyCertSign`.
    pub key_usage: i64?
    /// The object identifiers, in dotted form, of the extended key usage extension. Empty when the extension is absent.
    pub ext_key_usage: []str
    /// The object identifiers of critical extensions the parser does not interpret.
    ///
    /// Basic constraints, key usage, extended key usage and subject alternative name are interpreted. `verify_chain` rejects a certificate that lists any other critical extension.
    pub unhandled_critical: []str
}

struct AlgorithmId {
    raw: []u8
    oid: str
    parameters: []u8
}

fn algorithm_id(d: *der.Der) -> AlgorithmId ! io.Error {
    let e = der.expect(d, 0x30)?
    let inner = der.reader(e.content)
    let id = der.expect(inner, 0x06)?
    let name = der.oid(id.content)?
    var parameters: []u8 = []
    if !der.done(inner) {
        let p = der.read(inner)?
        parameters = p.raw
    }
    der.finish(inner)?
    AlgorithmId { raw: e.raw, oid: name, parameters }
}

fn public_key_info(d: *der.Der) -> PublicKeyInfo ! io.Error {
    let spki = der.enter(d, 0x30)?
    let algorithm = algorithm_id(spki)?
    let key_bits = der.expect(spki, 0x03)?
    der.finish(spki)?
    let key = der.bits(key_bits.content)?
    var parameters = ""
    if algorithm.parameters.len > 0 && algorithm.parameters[0] == 0x06 {
        let p = der.whole(algorithm.parameters, 0x06)?
        parameters = der.oid(p.content)?
    }
    PublicKeyInfo { algorithm: algorithm.oid, parameters, key }
}

fn bmp_text(content: []u8) -> str ! io.Error {
    let units = utf16.from_bytes(content, unicode.Order.Big) or fail Malformed
    utf16.decode(units) or fail Malformed
}

fn universal_text(content: []u8) -> str ! io.Error {
    let points = utf32.from_bytes(content, unicode.Order.Big) or fail Malformed
    utf32.decode(points) or fail Malformed
}

fn attribute_text(value: der.Element) -> str ! io.Error {
    if value.tag == 0x1E {
        return bmp_text(value.content)
    }
    if value.tag == 0x1C {
        return universal_text(value.content)
    }
    __str_view(value.content)
}

fn common_name(name: der.Element) -> str ! io.Error {
    let d = der.reader(name.content)
    var found = ""
    for !der.done(d) {
        let set = der.enter(d, 0x31)?
        for !der.done(set) {
            let attribute = der.enter(set, 0x30)?
            let kind = der.expect(attribute, 0x06)?
            let value = der.read(attribute)?
            der.finish(attribute)?
            let id = der.oid(kind.content)?
            if found.len == 0 && id == "2.5.4.3" {
                found = attribute_text(value)?
            }
        }
    }
    found
}

fn alt_names(mut c: Certificate, value: []u8) ! io.Error {
    let outer = der.whole(value, 0x30)?
    let d = der.reader(outer.content)
    for !der.done(d) {
        let name = der.read(d)?
        if name.tag == 0x82 {
            push(mut c.dns_names, __str_view(name.content))
        } else if name.tag == 0x87 {
            if name.content.len != 4 && name.content.len != 16 {
                fail Malformed
            }
            push(mut c.ip_addresses, name.content)
        }
    }
}

fn basic_constraints(mut c: Certificate, value: []u8) ! io.Error {
    let outer = der.whole(value, 0x30)?
    let d = der.reader(outer.content)
    if der.peek(d) == 0x01 {
        let flag = der.expect(d, 0x01)?
        c.ca = der.boolean(flag.content)?
    }
    if der.peek(d) == 0x02 {
        let length = der.expect(d, 0x02)?
        c.path_length = der.small_int(length.content)?
    }
    der.finish(d)?
}

fn purposes(value: []u8) -> []str ! io.Error {
    let outer = der.whole(value, 0x30)?
    let d = der.reader(outer.content)
    var out: []str = []
    for !der.done(d) {
        let id = der.expect(d, 0x06)?
        let name = der.oid(id.content)?
        push(mut out, name)
    }
    out
}

fn extension(mut c: Certificate, d: *der.Der, mut seen: [str: bool]) ! io.Error {
    let ext = der.enter(d, 0x30)?
    let id = der.expect(ext, 0x06)?
    let name = der.oid(id.content)?
    var critical = false
    if der.peek(ext) == 0x01 {
        let flag = der.expect(ext, 0x01)?
        critical = der.boolean(flag.content)?
    }
    let wrapped = der.expect(ext, 0x04)?
    der.finish(ext)?
    if seen[name] != none {
        fail Malformed
    }
    seen[name] = true
    let value = wrapped.content
    if name == "2.5.29.17" {
        alt_names(mut c, value)?
    } else if name == "2.5.29.19" {
        basic_constraints(mut c, value)?
    } else if name == "2.5.29.15" {
        let usage = der.whole(value, 0x03)?
        c.key_usage = der.named_bits(usage.content)?
    } else if name == "2.5.29.37" {
        c.ext_key_usage = purposes(value)?
    } else if critical {
        push(mut c.unhandled_critical, name)
    }
}

fn validity(d: *der.Der) -> []i64 ! io.Error {
    let v = der.enter(d, 0x30)?
    let start = der.read(v)?
    let end = der.read(v)?
    der.finish(v)?
    let from = der.time(start)?
    let until = der.time(end)?
    [from, until]
}

/// Parses a DER encoded X.509 certificate.
///
/// Parsing is strict DER. Fails with `Malformed` for bad encodings, trailing bytes, an empty serial number, a signature algorithm that differs between the outer and the signed part, a repeated extension, or extensions or unique identifiers in a version that does not allow them. Fails with `Unsupported` for a version above v3. The signature is not verified; see `check_signature` and `verify_chain`.
pub fn parse(encoded: []u8) -> Certificate ! io.Error {
    let outer = der.whole(encoded, 0x30)?
    let body = der.reader(outer.content)
    let tbs = der.expect(body, 0x30)?
    let algorithm = algorithm_id(body)?
    let signature_bits = der.expect(body, 0x03)?
    der.finish(body)?
    let t = der.reader(tbs.content)
    var version = 0
    if der.peek(t) == 0xA0 {
        let wrapper = der.enter(t, 0xA0)?
        let v = der.expect(wrapper, 0x02)?
        der.finish(wrapper)?
        version = der.small_int(v.content)?
        if version > 2 {
            fail Unsupported
        }
    }
    let serial = der.expect(t, 0x02)?
    if serial.content.len == 0 {
        fail Malformed
    }
    let inner = algorithm_id(t)?
    if !hash.equal(inner.raw, algorithm.raw) {
        fail Malformed
    }
    let issuer = der.expect(t, 0x30)?
    let period = validity(t)?
    let subject = der.expect(t, 0x30)?
    let key = public_key_info(t)?
    let subject_name = common_name(subject)?
    let signature = der.bits(signature_bits.content)?
    var c = Certificate {
        raw: outer.raw, tbs: tbs.raw, version, serial: serial.content, issuer: issuer.raw,
        subject: subject.raw, common_name: subject_name, not_before: period[0], not_after: period[1],
        signature_algorithm: algorithm.oid, signature_parameters: algorithm.parameters, signature,
        public_key: key, dns_names: [], ip_addresses: [], ca: false, path_length: none,
        key_usage: none, ext_key_usage: [], unhandled_critical: [],
    }
    for tag in [0x81, 0x82] {
        if der.peek(t) == tag {
            if version == 0 {
                fail Malformed
            }
            let unique = der.read(t)?
            der.bits(unique.content)?
        }
    }
    if der.peek(t) == 0xA3 {
        if version != 2 {
            fail Malformed
        }
        let wrapper = der.enter(t, 0xA3)?
        let list = der.enter(wrapper, 0x30)?
        der.finish(wrapper)?
        var seen: [str: bool] = [:]
        for !der.done(list) {
            extension(mut c, list, mut seen)?
        }
    }
    der.finish(t)?
    c
}
