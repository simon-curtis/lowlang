import std/io

extern "crypt32" {
    fn CertOpenSystemStoreA(provider: i64, name: ptr) -> i64
    fn CertEnumCertificatesInStore(store: i64, previous: i64) -> i64
    fn CertCloseStore(store: i64, flags: u32) -> i32
}

fn system_root_ders() -> [][]u8 {
    let store = CertOpenSystemStoreA(0, cstr("ROOT"))
    if store == 0 {
        return []
    }
    var out: [][]u8 = []
    var context = CertEnumCertificatesInStore(store, 0)
    for context != 0 {
        let header = bytes(__str_raw(context, 24))
        let encoded = io.le64(header, 8)
        let size = io.le32(header, 16)
        push(mut out, bytes(__str_raw(encoded, size)))
        context = CertEnumCertificatesInStore(store, context)
    }
    CertCloseStore(store, 0)
    out
}
