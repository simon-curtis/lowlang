import std/crypto
import std/crypto/hash
import std/crypto/limb
import field = std/crypto/curve25519
import edwards = std/crypto/edwards25519
import std/io

/// An element of the ristretto255 group (RFC 9496), a prime-order group of order `2^252 + 27742317777372353535851937790883648493` built on Curve25519.
///
/// An element is held as a point of the Edwards curve that stands for a coset of its eight-torsion subgroup; `equal` and `encode` give the same answer for any point of the coset.
pub struct Element {
    point: edwards.Point
}

struct SqrtRatio {
    was_square: u64
    root: field.Fe
}

fn sqrt_ad_minus_one() -> field.Fe {
    field.limbs(2241493124984347, 425987919032274, 2207028919301688, 1220490630685848, 974799131293748)
}

fn invsqrt_a_minus_d() -> field.Fe {
    field.limbs(278908739862762, 821645201101625, 8113234426968, 1777959178193151, 2118520810568447)
}

fn one_minus_d_sq() -> field.Fe {
    field.limbs(1136626929484150, 1998550399581263, 496427632559748, 118527312129759, 45110755273534)
}

fn d_minus_one_sq() -> field.Fe {
    field.limbs(1507062230895904, 1572317787530805, 683053064812840, 317374165784489, 1572899562415810)
}

fn negate_if(f: field.Fe, choice: u64) -> field.Fe {
    let negated = field.neg(f)
    field.choose(f, negated, choice)
}

fn absolute(f: field.Fe) -> field.Fe {
    negate_if(f, field.is_negative(f))
}

fn sqrt_ratio(u: field.Fe, v: field.Fe) -> SqrtRatio {
    let i = edwards.sqrt_minus_one()
    let v2 = field.square(v)
    let v3 = field.mul(v2, v)
    let v6 = field.square(v3)
    let v7 = field.mul(v6, v)
    let uv3 = field.mul(u, v3)
    let uv7 = field.mul(u, v7)
    let power = field.pow_p58(uv7)
    let root = field.mul(uv3, power)
    let root2 = field.square(root)
    let check = field.mul(v, root2)
    let minus_u = field.neg(u)
    let minus_u_i = field.mul(minus_u, i)
    let correct = field.same(check, u)
    let flipped = field.same(check, minus_u)
    let flipped_i = field.same(check, minus_u_i)
    let rotated = field.mul(i, root)
    let chosen = field.choose(root, rotated, flipped | flipped_i)
    SqrtRatio { was_square: correct | flipped, root: absolute(chosen) }
}

/// Returns the identity element.
pub fn identity() -> Element {
    Element { point: edwards.identity() }
}

/// Returns the canonical generator, the image of the Ed25519 base point.
pub fn generator() -> Element {
    Element { point: edwards.base() }
}

/// Returns the element that the 32-byte encoding `b` of RFC 9496 section 4.3.1 stands for, or `none` when `b` is not 32 bytes, is not the canonical little-endian encoding of a field element below `2^255 - 19`, is a negative field element, or is not the encoding of a group element.
///
/// The all-zero encoding of the identity is accepted.
pub fn decode(b: u8[]) -> Element? {
    if b.len != 32 {
        return none
    }
    let s = field.from_bytes(b)
    let encoded = field.to_bytes(s)
    let canonical: u64 = if hash.equal(encoded, b) { 1 } else { 0 }
    let one = field.one()
    let ss = field.square(s)
    let u1 = field.sub(one, ss)
    let u2 = field.add(one, ss)
    let u2_sqr = field.square(u2)
    let u1_sqr = field.square(u1)
    let d = edwards.curve_d()
    let d_u1 = field.mul(d, u1_sqr)
    let minus_d_u1 = field.neg(d_u1)
    let v = field.sub(minus_d_u1, u2_sqr)
    let v_u2 = field.mul(v, u2_sqr)
    let ratio = sqrt_ratio(one, v_u2)
    let den_x = field.mul(ratio.root, u2)
    let den_x_v = field.mul(den_x, v)
    let den_y = field.mul(ratio.root, den_x_v)
    let s_den_x = field.mul(s, den_x)
    let double_s_den_x = field.add(s_den_x, s_den_x)
    let x = absolute(double_s_den_x)
    let y = field.mul(u1, den_y)
    let t = field.mul(x, y)
    let zero = field.zero()
    let y_is_zero = field.same(y, zero)
    let negative = field.is_negative(s) | field.is_negative(t)
    let valid = canonical & ratio.was_square & (negative ^ 1) & (y_is_zero ^ 1)
    if valid == 0 {
        return none
    }
    let point = edwards.Point { x, y, z: one, t }
    Element { point }
}

/// Returns the 32-byte encoding of `e` of RFC 9496 section 4.3.2.
///
/// Elements that are equal have the same encoding, and `decode` of an encoding gives an element with that encoding.
pub fn encode(e: Element) -> u8[] {
    let p = e.point
    let i = edwards.sqrt_minus_one()
    let one = field.one()
    let z_plus_y = field.add(p.z, p.y)
    let z_minus_y = field.sub(p.z, p.y)
    let u1 = field.mul(z_plus_y, z_minus_y)
    let u2 = field.mul(p.x, p.y)
    let u2_sqr = field.square(u2)
    let u1_u2 = field.mul(u1, u2_sqr)
    let ratio = sqrt_ratio(one, u1_u2)
    let den1 = field.mul(ratio.root, u1)
    let den2 = field.mul(ratio.root, u2)
    let den12 = field.mul(den1, den2)
    let z_inv = field.mul(den12, p.t)
    let ix = field.mul(p.x, i)
    let iy = field.mul(p.y, i)
    let enchanted = field.mul(den1, invsqrt_a_minus_d())
    let t_z_inv = field.mul(p.t, z_inv)
    let rotate = field.is_negative(t_z_inv)
    let x = field.choose(p.x, iy, rotate)
    let y0 = field.choose(p.y, ix, rotate)
    let den_inv = field.choose(den2, enchanted, rotate)
    let x_z_inv = field.mul(x, z_inv)
    let y = negate_if(y0, field.is_negative(x_z_inv))
    let z_minus = field.sub(p.z, y)
    let s = field.mul(den_inv, z_minus)
    field.to_bytes(absolute(s))
}

/// Returns whether `a` and `b` are the same group element, by the equality test of RFC 9496 section 4.3.3.
pub fn equal(a: Element, b: Element) -> bool {
    let p = a.point
    let q = b.point
    let x1y2 = field.mul(p.x, q.y)
    let y1x2 = field.mul(p.y, q.x)
    let y1y2 = field.mul(p.y, q.y)
    let x1x2 = field.mul(p.x, q.x)
    (field.same(x1y2, y1x2) | field.same(y1y2, x1x2)) == 1
}

/// Returns the sum of `a` and `b`.
pub fn add(a: Element, b: Element) -> Element {
    let sum = edwards.add(a.point, b.point)
    Element { point: sum }
}

/// Returns the difference of `a` and `b`.
pub fn sub(a: Element, b: Element) -> Element {
    let minus_b = edwards.negate(b.point)
    let difference = edwards.add(a.point, minus_b)
    Element { point: difference }
}

/// Returns the additive inverse of `e`.
pub fn neg(e: Element) -> Element {
    let negated = edwards.negate(e.point)
    Element { point: negated }
}

/// Returns `scalar * e` for a 32-byte little-endian `scalar`, which is not required to be reduced.
///
/// The multiplication runs in a time that does not depend on the scalar and reads memory at addresses that do not depend on it, so a secret scalar is safe. The element is treated the same way.
pub fn multiply(e: Element, scalar: u8[]) -> Element {
    let table = edwards.multiples(e.point)
    let product = edwards.multiply(table, scalar)
    Element { point: product }
}

/// Returns `scalar * G` for the generator `G` and a 32-byte little-endian `scalar`, with the constant-time behaviour of `multiply`.
pub fn multiply_base(scalar: u8[]) -> Element {
    let g = generator()
    multiply(g, scalar)
}

fn map(b: u8[]) -> edwards.Point {
    let t = field.from_bytes(b)
    let i = edwards.sqrt_minus_one()
    let d = edwards.curve_d()
    let one = field.one()
    let minus_one = field.neg(one)
    let t2 = field.square(t)
    let r = field.mul(i, t2)
    let r_plus_one = field.add(r, one)
    let u = field.mul(r_plus_one, one_minus_d_sq())
    let rd = field.mul(r, d)
    let minus_one_minus_rd = field.sub(minus_one, rd)
    let r_plus_d = field.add(r, d)
    let v = field.mul(minus_one_minus_rd, r_plus_d)
    let ratio = sqrt_ratio(u, v)
    let st = field.mul(ratio.root, t)
    let s_prime = field.neg(absolute(st))
    let wasnt_square = ratio.was_square ^ 1
    let s = field.choose(ratio.root, s_prime, wasnt_square)
    let c = field.choose(minus_one, r, wasnt_square)
    let r_minus_one = field.sub(r, one)
    let c_r = field.mul(c, r_minus_one)
    let c_r_d = field.mul(c_r, d_minus_one_sq())
    let n = field.sub(c_r_d, v)
    let s_v = field.mul(s, v)
    let w0 = field.add(s_v, s_v)
    let w1 = field.mul(n, sqrt_ad_minus_one())
    let s2 = field.square(s)
    let w2 = field.sub(one, s2)
    let w3 = field.add(one, s2)
    let x = field.mul(w0, w3)
    let y = field.mul(w2, w1)
    let z = field.mul(w1, w3)
    let t_out = field.mul(w0, w2)
    edwards.Point { x, y, z, t: t_out }
}

/// Returns the element that the element derivation function of RFC 9496 section 4.3.4 gives for the 64 uniformly random bytes `b`, or `none` when `b` is not 64 bytes.
///
/// Each half of `b` is mapped to an element, with the top bit of its last byte ignored and the value reduced modulo `2^255 - 19`, and the two elements are added. Use it with the output of a hash such as `expand_message_xmd` of RFC 9380. The running time does not depend on the bytes.
pub fn from_uniform(b: u8[]) -> Element? {
    if b.len != 64 {
        return none
    }
    let p1 = map(b[..32])
    let p2 = map(b[32..])
    let sum = edwards.add(p1, p2)
    Element { point: sum }
}

fn zero_scalar() -> u8[] {
    __make(32)
}

fn one_scalar() -> u8[] {
    let out: u8[] = __make(32)
    out[0] = 1
    out
}

fn minus_one_scalar() -> u8[] {
    let out: u8[] = __make(32)
    io.set_le64(out, 0, 0x5812631a5cf5d3ec)
    io.set_le64(out, 8, 0x14def9dea2f79cd6)
    io.set_le64(out, 24, 0x1000000000000000)
    out
}

/// Returns the scalar of the 32-byte little-endian encoding `b`, or `none` when `b` is not 32 bytes or encodes an integer that is not below the group order.
///
/// The scalar is the same 32 bytes. The running time does not depend on the bytes.
pub fn scalar_from_bytes(b: u8[]) -> u8[]? {
    if b.len != 32 || !edwards.canonical(b) {
        return none
    }
    let out: u8[] = __make(32)
    __memmove(out, b)
    out
}

/// Returns the scalar that is the 64-byte little-endian integer `b` reduced modulo the group order, or `none` when `b` is not 64 bytes.
///
/// A uniformly random `b` gives a uniformly random scalar. The running time does not depend on the bytes.
pub fn scalar_from_wide(b: u8[]) -> u8[]? {
    edwards.reduce(b) when b.len == 64
}

/// Returns `(a + b) mod L` for 32-byte little-endian scalars below the group order `L`.
pub fn scalar_add(a: u8[], b: u8[]) -> u8[] {
    let one = one_scalar()
    edwards.mul_add(a, one, b)
}

/// Returns `(a - b) mod L` for 32-byte little-endian scalars below the group order `L`.
pub fn scalar_sub(a: u8[], b: u8[]) -> u8[] {
    let minus_one = minus_one_scalar()
    edwards.mul_add(minus_one, b, a)
}

/// Returns `(a * b) mod L` for 32-byte little-endian scalars below the group order `L`.
pub fn scalar_mul(a: u8[], b: u8[]) -> u8[] {
    let zero = zero_scalar()
    edwards.mul_add(a, b, zero)
}

/// Returns `(-a) mod L` for a 32-byte little-endian scalar below the group order `L`.
pub fn scalar_neg(a: u8[]) -> u8[] {
    let minus_one = minus_one_scalar()
    let zero = zero_scalar()
    edwards.mul_add(minus_one, a, zero)
}

/// Returns the inverse of `a` modulo the group order `L`, or zero for zero, as `a^(L - 2)`.
///
/// The squarings and multiplications follow the bits of the public exponent `L - 2`, so the running time does not depend on `a`.
pub fn scalar_invert(a: u8[]) -> u8[] {
    let minus_one = minus_one_scalar()
    let one = one_scalar()
    let exponent = scalar_sub(minus_one, one)
    var result = one_scalar()
    var bit = 252
    for bit >= 0 {
        result = scalar_mul(result, result)
        if (exponent[bit >> 3] >> u8(bit & 7)) & 1 == 1 {
            result = scalar_mul(result, a)
        }
        bit -= 1
    }
    result
}

/// Returns whether the scalar `a` is zero.
pub fn scalar_is_zero(a: u8[]) -> bool {
    let words = limb.from_bytes(a, 4)
    limb.is_zero(words)
}

/// Returns a uniformly random nonzero scalar, from 64 bytes of `random` in `std/crypto` reduced modulo the group order, redrawn in the negligible case that the result is zero.
pub fn scalar_random() -> u8[] {
    var wide = crypto.random(64)
    var s = edwards.reduce(wide)
    for scalar_is_zero(s) {
        wide = crypto.random(64)
        s = edwards.reduce(wide)
    }
    s
}
