import std/crypto/hash
import std/crypto/nistec

/// The error of hashing to a field.
pub enum Error {
    /// The requested output length is above `255` blocks of the hash or above 65535 bytes.
    Length
}

fn oversize_dst(alg: hash.Algorithm, dst: []u8) -> []u8 {
    let d = alg.digest()
    d.update(bytes("H2C-OVERSIZE-DST-"))
    d.update(dst)
    d.finish()
}

fn xor_into(out: []u8, a: []u8, b: []u8) {
    for i in 0..out.len {
        out[i] = a[i] ^ b[i]
    }
}

fn expand(alg: hash.Algorithm, msg: []u8, dst: []u8, length: i64) -> []u8 {
    let blocks = (length + alg.size - 1) / alg.size
    let tag = if dst.len > 255 { oversize_dst(alg, dst) } else { dst }
    let suffix: []u8 = __make(tag.len + 1)
    __memmove(suffix, tag)
    suffix[tag.len] = u8(tag.len)
    let zeros: []u8 = __make(alg.block)
    let size: []u8 = [u8(length >> 8), u8(length), 0]
    let d0 = alg.digest()
    d0.update(zeros)
    d0.update(msg)
    d0.update(size)
    d0.update(suffix)
    let b0 = d0.finish()
    let out: []u8 = __make(blocks * alg.size)
    var previous = b0
    let mixed: []u8 = __make(alg.size)
    for i in 1..blocks + 1 {
        if i == 1 {
            __memmove(mixed, b0)
        } else {
            xor_into(mixed, b0, previous)
        }
        let counter: []u8 = [u8(i)]
        let d = alg.digest()
        d.update(mixed)
        d.update(counter)
        d.update(suffix)
        previous = d.finish()
        __memmove(out[(i - 1) * alg.size..], previous)
    }
    out[..length]
}

fn within_limits(alg: hash.Algorithm, length: i64) -> bool {
    let blocks = (length + alg.size - 1) / alg.size
    length >= 0 && length <= 65535 && blocks <= 255
}

/// Returns `length` uniformly random bytes derived from `msg` and the domain separation tag `dst` with `expand_message_xmd` of RFC 9380 section 5.3.1 over the hash `alg`.
///
/// A `dst` longer than 255 bytes is hashed together with the prefix `H2C-OVERSIZE-DST-` and the hash is the tag used (section 5.3.3). `msg` and `dst` are treated as public data.
///
/// Fails with `Length` when `length` is negative, above 65535, or needs more than 255 blocks of `alg.size` bytes.
pub fn expand_message_xmd(alg: hash.Algorithm, msg: []u8, dst: []u8, length: i64) -> []u8 ! Error {
    if !within_limits(alg, length) {
        fail Length
    }
    expand(alg, msg, dst, length)
}

fn fields(f: *nistec.Field, alg: hash.Algorithm, msg: []u8, dst: []u8, count: i64) -> [][]u64 {
    let uniform = expand(alg, msg, dst, 48 * count)
    var out: [][]u64 = []
    for i in 0..count {
        let reduced = nistec.reduce_wide(f, uniform[48 * i..48 * (i + 1)])
        push(mut out, reduced)
    }
    out
}

/// Returns `count` elements of the field `f` derived from `msg` and `dst`, as plain integers in limbs, with `hash_to_field` of RFC 9380 section 5.2 using `expand_message_xmd` over `alg`.
///
/// Each element is the big-endian integer of `L = 48` bytes reduced modulo the modulus of `f`, which gives the 128-bit security level for a 256-bit modulus such as the P-256 prime or its group order. The reduction does not depend on the bytes. Fails with `Length` when `48 count` bytes are more than `expand_message_xmd` can give.
pub fn hash_to_field(f: *nistec.Field, alg: hash.Algorithm, msg: []u8, dst: []u8, count: i64) -> [][]u64 ! Error {
    if !within_limits(alg, 48 * count) {
        fail Length
    }
    fields(f, alg, msg, dst, count)
}
