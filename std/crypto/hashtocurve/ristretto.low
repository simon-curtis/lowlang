import std/crypto/hash
import std/crypto/ristretto255

/// Returns the ristretto255 element that `hash_to_ristretto255` of RFC 9380 appendix B gives for `msg` and the domain separation tag `dst`, with `expand_message_xmd` over SHA-512.
///
/// It expands `msg` to 64 bytes and applies the one-way map of RFC 9496 section 4.3.4. `msg` and `dst` are treated as public data.
pub fn hash_to_ristretto255(msg: []u8, dst: []u8) -> ristretto255.Element {
    let uniform = expand(hash.sha512(), msg, dst, 64)
    match ristretto255.from_uniform(uniform) {
        some(element) => element
        none => panic("a 64-byte string has an element")
    }
}

/// Returns the scalar that `HashToScalar` of RFC 9497 section 4.1 gives for `msg` and the domain separation tag `dst`: 64 bytes from `expand_message_xmd` over SHA-512, read as a little-endian integer and reduced modulo the group order, as 32 little-endian bytes.
///
/// The running time does not depend on the bytes of `msg`.
pub fn hash_to_ristretto255_scalar(msg: []u8, dst: []u8) -> []u8 {
    let uniform = expand(hash.sha512(), msg, dst, 64)
    match ristretto255.scalar_from_wide(uniform) {
        some(scalar) => scalar
        none => panic("a 64-byte string reduces to a scalar")
    }
}
