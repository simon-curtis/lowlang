import std/crypto/hash
import std/crypto/limb
import std/crypto/nistec

struct Sqrt {
    square: u64
    root: []u64
}

fn plus(f: *nistec.Field, a: []u64, b: []u64) -> []u64 {
    let out = nistec.element(f)
    nistec.add(f, out, a, b)
    out
}

fn minus(f: *nistec.Field, a: []u64, b: []u64) -> []u64 {
    let out = nistec.element(f)
    nistec.sub(f, out, a, b)
    out
}

fn times(f: *nistec.Field, a: []u64, b: []u64) -> []u64 {
    let out = nistec.element(f)
    nistec.mul(f, out, a, b)
    out
}

fn negated(f: *nistec.Field, a: []u64) -> []u64 {
    let zero = nistec.element(f)
    minus(f, zero, a)
}

fn small(f: *nistec.Field, value: u64) -> []u64 {
    let plain = nistec.element(f)
    plain[0] = value
    let out = nistec.element(f)
    nistec.to_mont(f, out, plain)
    out
}

fn pick(f: *nistec.Field, a: []u64, b: []u64, choice: u64) -> []u64 {
    let out = nistec.element(f)
    limb.choose(out, b, a, limb.mask_of(choice))
    out
}

fn equal_choice(a: []u64, b: []u64) -> u64 {
    var diff: u64 = 0
    for i in 0..a.len {
        diff |= a[i] ^ b[i]
    }
    limb.same(diff, 0)
}

fn sgn0(f: *nistec.Field, a: []u64) -> u64 {
    let plain = nistec.element(f)
    nistec.from_mont(f, plain, a)
    plain[0] & 1
}

fn sqrt_ratio(f: *nistec.Field, u: []u64, v: []u64) -> Sqrt {
    let c1 = nistec.hex_limbs("3fffffffc00000004000000000000000000000003fffffffffffffffffffffff")
    let c2_plain = nistec.hex_limbs("da538e3be1d89b99c978fc675180aab27b8d1ff84c55d5b62ccd3427e433c47f")
    let c2 = nistec.element(f)
    nistec.to_mont(f, c2, c2_plain)
    let v2 = times(f, v, v)
    let uv = times(f, u, v)
    let base = times(f, v2, uv)
    let power = nistec.element(f)
    nistec.power(f, power, base, c1)
    let y1 = times(f, power, uv)
    let y2 = times(f, y1, c2)
    let check = times(f, y1, y1)
    let scaled = times(f, check, v)
    let square = equal_choice(scaled, u)
    let root = pick(f, y2, y1, square)
    Sqrt { square, root }
}

/// Returns the point of P-256 that the simplified SWU map of RFC 9380 section 6.6.2 gives for the field element `u`, a plain integer below the field prime, for the suite P256_XMD:SHA-256_SSWU_ with `Z = -10`.
///
/// This is the straight-line procedure of Appendix F.2. Every step runs for every `u`, with masks instead of branches, so the running time and the memory accesses do not depend on `u`.
pub fn map_to_curve_p256(g: *nistec.Group, u: []u64) -> nistec.Point {
    let f = g.p
    let ten = small(f, 10)
    let z = negated(f, ten)
    let three = small(f, 3)
    let a = negated(f, three)
    let um = nistec.element(f)
    nistec.to_mont(f, um, u)
    let u2 = times(f, um, um)
    let tv1 = times(f, z, u2)
    let tv1_squared = times(f, tv1, tv1)
    let tv2 = plus(f, tv1_squared, tv1)
    let tv2_plus_one = plus(f, tv2, f.one)
    let tv3 = times(f, g.b, tv2_plus_one)
    let zero = nistec.element(f)
    let nonzero = equal_choice(tv2, zero) ^ 1
    let minus_tv2 = negated(f, tv2)
    let picked = pick(f, z, minus_tv2, nonzero)
    let tv4 = times(f, a, picked)
    let tv3_squared = times(f, tv3, tv3)
    let tv4_squared = times(f, tv4, tv4)
    let tv5 = times(f, a, tv4_squared)
    let sum = plus(f, tv3_squared, tv5)
    let numerator = times(f, sum, tv3)
    let tv6 = times(f, tv4_squared, tv4)
    let tv7 = times(f, g.b, tv6)
    let gx = plus(f, numerator, tv7)
    let x1 = times(f, tv1, tv3)
    let root = sqrt_ratio(f, gx, tv6)
    let tv1_u = times(f, tv1, um)
    let y1 = times(f, tv1_u, root.root)
    let x2 = pick(f, x1, tv3, root.square)
    let y2 = pick(f, y1, root.root, root.square)
    let sign_u = sgn0(f, um)
    let sign_y = sgn0(f, y2)
    let same_sign = sign_u ^ sign_y ^ 1
    let minus_y = negated(f, y2)
    let y3 = pick(f, minus_y, y2, same_sign)
    let inverse = nistec.element(f)
    nistec.invert(f, inverse, tv4)
    let x3 = times(f, x2, inverse)
    let one = nistec.element(f)
    __memmove(one, f.one)
    nistec.Point { x: x3, y: y3, z: one }
}

/// Returns the point of P-256 that `hash_to_curve` of RFC 9380 section 3 gives for `msg` and the domain separation tag `dst` under the suite P256_XMD:SHA-256_SSWU_RO_.
///
/// It maps two field elements from `hash_to_field` with `map_to_curve_p256` and adds the points; P-256 has cofactor 1, so no further clearing is needed. The point is the point at infinity only with negligible probability.
pub fn hash_to_curve_p256(g: *nistec.Group, msg: []u8, dst: []u8) -> nistec.Point {
    let u = fields(g.p, hash.sha256(), msg, dst, 2)
    let q0 = map_to_curve_p256(g, u[0])
    let q1 = map_to_curve_p256(g, u[1])
    nistec.point_add(g, q0, q0, q1)
    q0
}

/// Returns the scalar that `HashToScalar` of RFC 9497 section 4.3 gives for `msg` and the domain separation tag `dst`: `hash_to_field` with `L = 48`, `expand_message_xmd` over SHA-256 and the order of P-256 as the modulus, as 32 big-endian bytes.
///
/// The running time does not depend on the bytes of `msg`.
pub fn hash_to_scalar_p256(g: *nistec.Group, msg: []u8, dst: []u8) -> []u8 {
    let u = fields(g.n, hash.sha256(), msg, dst, 1)
    nistec.encode(u[0])
}
