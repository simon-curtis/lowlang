import std/crypto/hash
import std/crypto/hashtocurve
import std/crypto/nistec
import std/crypto/ristretto255
import std/text

fn hex(b: u8[]) -> str {
    text.encode_hex(b)
}

fn show_expansion() {
    let dst = bytes("QUUX-V01-CS02-with-expander-SHA256-128")
    let expanded = hashtocurve.expand_message_xmd(hash.sha256(), bytes("abc"), dst, 32) catch {
        Length => {
            print("length not supported")
            return
        }
    }
    print("expand_message_xmd {hex(expanded)}")
    let too_long = hashtocurve.expand_message_xmd(hash.sha256(), bytes("abc"), dst, 65536) catch {
        Length => {
            print("expand_message_xmd of 65536 bytes: length not supported")
            return
        }
    }
    print("expand_message_xmd of 65536 bytes: {too_long.len} bytes")
}

fn show_p256() {
    let curve = nistec.p256()
    let dst = bytes("QUUX-V01-CS02-with-P256_XMD:SHA-256_SSWU_RO_")
    let point = hashtocurve.hash_to_curve_p256(curve, bytes("abc"), dst)
    match nistec.affine(curve, point) {
        some(a) => print("P256 hash_to_curve {hex(nistec.encode_point(curve, a))}")
        none => print("P256 hash_to_curve is the point at infinity")
    }
    let scalar = hashtocurve.hash_to_scalar_p256(curve, bytes("abc"), dst)
    print("P256 hash_to_scalar {hex(scalar)}")
}

fn show_ristretto() {
    let dst = bytes("QUUX-V01-CS02-with-ristretto255_XMD:SHA-512_R255MAP_RO_")
    let element = hashtocurve.hash_to_ristretto255(bytes("abc"), dst)
    print("ristretto255 hash_to_group {hex(ristretto255.encode(element))}")
    let scalar = hashtocurve.hash_to_ristretto255_scalar(bytes("abc"), dst)
    print("ristretto255 hash_to_scalar {hex(scalar)}")
}

/// Expands, hashes to P-256 and hashes to ristretto255 the message `abc`. The expansion is the RFC 9380 K.1 vector and the P-256 point is the J.1.1 vector for `abc`.
fn main() {
    show_expansion()
    show_p256()
    show_ristretto()
}
