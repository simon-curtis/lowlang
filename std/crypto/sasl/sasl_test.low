import std/crypto/hash
import std/testing

fn failure_of(s: *Scram, server_first: str) -> Error? {
    final(s, server_first) catch {
        e => return some(e)
    }
    none
}

fn test_rfc5802_sha1(t: *testing.T) {
    let s = start(hash.sha1(), "user", "pencil", "fyko+d2lbbFgONRv9qkxdawL")
    t.equal(first(s), "n,,n=user,r=fyko+d2lbbFgONRv9qkxdawL")
    let reply = final(s, "r=fyko+d2lbbFgONRv9qkxdawL3rfcNHYJY1ZVvWVs7j,s=QSXCR+Q6sek8bf92,i=4096") catch {
        e => {
            t.error("final failed")
            ""
        }
    }
    t.equal(reply, "c=biws,r=fyko+d2lbbFgONRv9qkxdawL3rfcNHYJY1ZVvWVs7j,p=v0X8v3Bz2T0CJGbJQyF0X+HI4Ts=")
    verify(s, "v=rmF9pqV8S7suAoZWja4dJRkFsKQ=") catch {
        e => t.error("server signature rejected")
    }
}

fn test_rfc7677_sha256(t: *testing.T) {
    let s = start(hash.sha256(), "user", "pencil", "rOprNGfwEbeRWgbNEkqO")
    t.equal(first(s), "n,,n=user,r=rOprNGfwEbeRWgbNEkqO")
    let reply = final(s, "r=rOprNGfwEbeRWgbNEkqO%hvYDpWUa2RaTCAfuxFIlj)hNlF$k0,s=W22ZaJ0SNY7soEsUEjb6gQ==,i=4096") catch {
        e => {
            t.error("final failed")
            ""
        }
    }
    t.equal(reply, "c=biws,r=rOprNGfwEbeRWgbNEkqO%hvYDpWUa2RaTCAfuxFIlj)hNlF$k0,p=dHzbZapWIk4jUhN+Ute9ytag9zjfMHgsqmmiz7AndVQ=")
    verify(s, "v=6rriTRBi23WpRR/wtup+mMhUZUn/dB5nLTJRsjl95G4=") catch {
        e => t.error("server signature rejected")
    }
}

fn test_server_signature_checks(t: *testing.T) {
    let s = start(hash.sha256(), "user", "pencil", "rOprNGfwEbeRWgbNEkqO")
    var failed: Error? = none
    verify(s, "v=6rriTRBi23WpRR/wtup+mMhUZUn/dB5nLTJRsjl95G4=") catch {
        e => {
            failed = some(e)
        }
    }
    t.equal(failed, some(Error.Rejected))
    final(s, "r=rOprNGfwEbeRWgbNEkqO%hvYDpWUa2RaTCAfuxFIlj)hNlF$k0,s=W22ZaJ0SNY7soEsUEjb6gQ==,i=4096") or ""
    failed = none
    verify(s, "v=AAAATRBi23WpRR/wtup+mMhUZUn/dB5nLTJRsjl95G4=") catch {
        e => {
            failed = some(e)
        }
    }
    t.equal(failed, some(Error.Rejected))
    failed = none
    verify(s, "e=invalid-proof") catch {
        e => {
            failed = some(e)
        }
    }
    t.equal(failed, some(Error.Rejected))
    failed = none
    verify(s, "x=1") catch {
        e => {
            failed = some(e)
        }
    }
    t.equal(failed, some(Error.Malformed))
    failed = none
    verify(s, "v=!!") catch {
        e => {
            failed = some(e)
        }
    }
    t.equal(failed, some(Error.Malformed))
}

fn test_server_first_checks(t: *testing.T) {
    let s = start(hash.sha1(), "a,b=c", "x", "abc")
    t.equal(first(s), "n,,n=a=2Cb=3Dc,r=abc")
    t.equal(failure_of(s, "r=xyz,s=AAAA,i=1"), some(Error.Malformed))
    t.equal(failure_of(s, "r=abc,s=AAAA,i=1"), some(Error.Malformed))
    t.equal(failure_of(s, "r=abcdef,s=AAAA,i=0"), some(Error.Malformed))
    t.equal(failure_of(s, "r=abcdef,s=AAAA,i=x"), some(Error.Malformed))
    t.equal(failure_of(s, "r=abcdef,s=AAAA"), some(Error.Malformed))
    t.equal(failure_of(s, "r=abcdef,i=1"), some(Error.Malformed))
    t.equal(failure_of(s, "r=abcdef,s=!!,i=1"), some(Error.Malformed))
    t.equal(failure_of(s, "m=x,r=abcdef,s=AAAA,i=1"), some(Error.Unsupported))
    t.is_none(failure_of(s, "r=abcdef,s=AAAA,i=1"))
}

fn test_unverified_exchange_is_rejected(t: *testing.T) {
    let s = start(hash.sha1(), "u", "p", "abc")
    var failed: Error? = none
    verify(s, "v=AAAA") catch {
        e => {
            failed = some(e)
        }
    }
    t.equal(failed, some(Error.Rejected))
}
