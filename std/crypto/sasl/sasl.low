import std/base64
import std/crypto/hash
import std/crypto/password
import std/text

/// Why a SCRAM exchange stopped.
pub enum Error {
    /// A server message lacks an attribute, carries a malformed one, or its nonce does not extend the client nonce.
    Malformed
    /// The server demands a mandatory extension, announced by a leading `m=` attribute.
    Unsupported
    /// The server reported an `e=` error or its signature does not match the client's computation.
    Rejected
}

/// The state of one SCRAM exchange (RFC 5802, RFC 7677) over a hash: the secret, the client nonce, the client-first-message body and the server signature that `final` computes for `verify`.
pub struct Scram {
    algorithm: hash.Algorithm
    secret: str
    nonce: str
    first_bare: str
    server_signature: []u8
}

/// Starts a SCRAM exchange for `user` and the already prepared `secret` with the client `nonce`, using `algorithm` for the key derivation: `hash.sha256()` for SCRAM-SHA-256 and `hash.sha1()` for SCRAM-SHA-1. The `,` and `=` characters in `user` are escaped as `=2C` and `=3D`.
pub fn start(algorithm: hash.Algorithm, user: str, secret: str, nonce: str) -> *Scram {
    var name: []u8 = []
    for i in 0..user.len {
        match user[i] {
            ',' => text.append(mut name, "=2C")
            '=' => text.append(mut name, "=3D")
            _ => push(mut name, user[i])
        }
    }
    let first_bare = "n={__str_view(name)},r={nonce}"
    new(Scram { algorithm, secret, nonce, first_bare, server_signature: [] })
}

/// Returns the client-first-message to send to the server, `n,,n=<user>,r=<nonce>`.
pub fn first(s: *Scram) -> str {
    "n,,{s.first_bare}"
}

fn attribute(message: str, key: u8) -> str ! Error {
    for part in text.split(message, ',') {
        if part.len >= 2 && part[0] == key && part[1] == '=' {
            return part[2..]
        }
    }
    fail Malformed
}

/// Computes the client-final-message, with the proof, from the server-first-message `server_first`.
///
/// Fails with `Malformed` when `server_first` lacks the `r`, `s` or `i` attribute, when the server nonce does not extend the client nonce, or when the salt or iteration count is invalid, and with `Unsupported` when the server demands an extension. It records the signature `verify` expects.
pub fn final(s: *Scram, server_first: str) -> str ! Error {
    if server_first.len > 0 && server_first[0] == 'm' {
        fail Unsupported
    }
    let combined = attribute(server_first, 'r')?
    let encoded_salt = attribute(server_first, 's')?
    let count = attribute(server_first, 'i')?
    if combined.len <= s.nonce.len || !text.starts_with(combined, s.nonce) {
        fail Malformed
    }
    let iterations = text.parse_uint(count, 10) or fail Malformed
    if iterations < 1 {
        fail Malformed
    }
    let salt = base64.decode(encoded_salt) or fail Malformed
    let a = s.algorithm
    let salted = password.pbkdf2(a, bytes(s.secret), salt, iterations, a.size)
    let client_key = hash.hmac(a, salted, bytes("Client Key"))
    let stored_key = hash.sum(a, client_key)
    let without_proof = "c=biws,r={combined}"
    let auth = bytes("{s.first_bare},{server_first},{without_proof}")
    let proof = hash.hmac(a, stored_key, auth)
    for i in 0..proof.len {
        proof[i] ^= client_key[i]
    }
    let server_key = hash.hmac(a, salted, bytes("Server Key"))
    s.server_signature = hash.hmac(a, server_key, auth)
    "{without_proof},p={base64.encode(proof)}"
}

/// Checks the server-final-message `server_final` against the signature `final` computed.
///
/// Fails with `Rejected` when the server reports an `e=` error or the signature differs, and with `Malformed` when the message has no `v` attribute or it is not valid base64.
pub fn verify(s: *Scram, server_final: str) ! Error {
    if text.starts_with(server_final, "e=") {
        fail Rejected
    }
    let encoded = attribute(server_final, 'v')?
    let signature = base64.decode(encoded) or fail Malformed
    if s.server_signature.len == 0 || !hash.equal(signature, s.server_signature) {
        fail Rejected
    }
}
