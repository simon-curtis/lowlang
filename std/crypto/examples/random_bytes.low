import std/crypto
import std/sync
import std/text

fn worker(results: chan[str], group: sync.WaitGroup) {
    for _ in 0..4 {
        results <- text.encode_hex(crypto.random(16))
    }
    group.done()
}

/// Draws random bytes from several green threads at once and checks that every 16-byte token differs, then shows that a request of any size returns exactly that many bytes.
fn main() {
    let results = chan[str](64)
    let group = sync.wait_group()
    for _ in 0..8 {
        group.add(1)
        spawn worker(results, group)
    }
    group.wait()
    close(results)

    let seen: [str: bool] = [:]
    for token in results {
        seen[token] = true
    }
    print("8 threads drew 32 tokens, {seen.len} distinct")

    for n in [0, 1, 32, 4096, 100000] {
        print("random({n}) returned {crypto.random(n).len} bytes")
    }
}
