import std/crypto/limb
import std/crypto/nistec
import std/crypto/pairing

/// The ways an input to the EIP-196 and EIP-197 operations is rejected.
pub enum Error {
    /// A coordinate is not below the field prime.
    Coordinate
    /// The coordinates are not a point of the curve.
    NotOnCurve
    /// The point of `G2` is not in the subgroup of order `r`.
    NotInSubgroup
    /// The pairing input is not a whole number of 192-byte pairs.
    Length
}

fn padded(input: u8[], size: i64) -> u8[] {
    let out: u8[] = __make(size)
    __memmove(out, input)
    out
}

fn coordinate(c: *pairing.Curve, data: u8[]) -> u64[] ! Error {
    let raw = limb.from_bytes(data, c.l)
    if !nistec.below(raw, c.fp.m) {
        fail Coordinate
    }
    let out = nistec.element(c.fp)
    nistec.to_mont(c.fp, out, raw)
    out
}

fn plain_bytes(c: *pairing.Curve, a: u64[]) -> u8[] {
    let out = nistec.element(c.fp)
    nistec.from_mont(c.fp, out, a)
    nistec.encode(out)
}

/// Returns the point of `G1` in the 64 bytes `data`, `x || y` as 32-byte big-endian integers, where all zeros is the point at infinity.
///
/// Fails with `Coordinate` when a coordinate is not below the field prime and with `NotOnCurve` when the pair is not on the curve. `G1` is the whole curve, so there is no subgroup check.
pub fn decode_g1(c: *pairing.Curve, data: u8[]) -> pairing.Point ! Error {
    let x = coordinate(c, data[..32])?
    let y = coordinate(c, data[32..64])?
    if limb.is_zero(x) && limb.is_zero(y) {
        return pairing.g1_infinity(c)
    }
    let p = pairing.from_affine(c, x, y)
    if !pairing.on_curve(c, p) {
        fail NotOnCurve
    }
    p
}

/// Returns the 64-byte encoding `x || y` of a point of `G1`, all zeros for the point at infinity.
pub fn encode_g1(c: *pairing.Curve, p: pairing.Point) -> u8[] {
    let a = pairing.affine(c, p) ?? return __make(64)
    let out: u8[] = __make(64)
    __memmove(out, plain_bytes(c, a.x))
    __memmove(out[32..], plain_bytes(c, a.y))
    out
}

fn fp2_coordinate(c: *pairing.Curve, data: u8[]) -> u64[] ! Error {
    let imaginary = coordinate(c, data[..32])?
    let real = coordinate(c, data[32..64])?
    let out: u64[] = __make(2 * c.l)
    __memmove(out, real)
    __memmove(out[c.l..], imaginary)
    out
}

/// Returns the point of `G2` in the 128 bytes `data`: `x` then `y`, each an element `a + b i` of `Fp2` written as `b || a` in 32-byte big-endian integers, where all zeros is the point at infinity.
///
/// Fails with `Coordinate` when an integer is not below the field prime, `NotOnCurve` when the pair is not on the twist, and `NotInSubgroup` when the point is not in the subgroup of order `r`.
pub fn decode_g2(c: *pairing.Curve, data: u8[]) -> pairing.Point ! Error {
    let x = fp2_coordinate(c, data[..64])?
    let y = fp2_coordinate(c, data[64..128])?
    if limb.is_zero(x) && limb.is_zero(y) {
        return pairing.g2_infinity(c)
    }
    let p = pairing.from_affine(c, x, y)
    if !pairing.on_curve(c, p) {
        fail NotOnCurve
    }
    if !pairing.in_subgroup(c, p) {
        fail NotInSubgroup
    }
    p
}

/// Returns the 128-byte encoding of a point of `G2` that `decode_g2` reads, all zeros for the point at infinity.
pub fn encode_g2(c: *pairing.Curve, p: pairing.Point) -> u8[] {
    let a = pairing.affine(c, p) ?? return __make(128)
    let l = c.l
    let out: u8[] = __make(128)
    __memmove(out, plain_bytes(c, a.x[l..]))
    __memmove(out[32..], plain_bytes(c, a.x[..l]))
    __memmove(out[64..], plain_bytes(c, a.y[l..]))
    __memmove(out[96..], plain_bytes(c, a.y[..l]))
    out
}

/// Returns the result of the `ECADD` precompile of EIP-196 at address `0x06`: the 64-byte sum of the two points of `G1` in the first 128 bytes of `input`, which is padded with zeros when shorter and cut when longer.
pub fn ec_add(c: *pairing.Curve, input: u8[]) -> u8[] ! Error {
    let data = padded(input, 128)
    let a = decode_g1(c, data[..64])?
    let b = decode_g1(c, data[64..128])?
    encode_g1(c, pairing.add(c, a, b))
}

/// Returns the result of the `ECMUL` precompile of EIP-196 at address `0x07`: the 64-byte product of the point of `G1` in the first 64 bytes of `input` and the 32-byte big-endian scalar after it, with `input` padded with zeros when shorter and cut when longer. The scalar is not reduced.
pub fn ec_mul(c: *pairing.Curve, input: u8[]) -> u8[] ! Error {
    let data = padded(input, 96)
    let p = decode_g1(c, data[..64])?
    let scalar = limb.from_bytes(data[64..96], 4)
    encode_g1(c, pairing.mul(c, p, scalar))
}

/// Returns the result of the `ECPAIRING` precompile of EIP-197 at address `0x08`: 32 bytes holding `1` when the product of the pairings of the 192-byte pairs of `input`, each a point of `G1` then a point of `G2`, is `1`, and `0` otherwise. An empty input gives `1`.
///
/// Fails with `Length` when `input` is not a multiple of 192 bytes and with the errors of `decode_g1` and `decode_g2` for a bad point.
pub fn ec_pairing(c: *pairing.Curve, input: u8[]) -> u8[] ! Error {
    if input.len % 192 != 0 {
        fail Length
    }
    var ps: pairing.Point[] = []
    var qs: pairing.Point[] = []
    for i in 0..input.len / 192 {
        let at = 192 * i
        ps.push(decode_g1(c, input[at..at + 64])?)
        qs.push(decode_g2(c, input[at + 64..at + 192])?)
    }
    let out: u8[] = __make(32)
    if pairing.check(c, ps, qs) {
        out[31] = 1
    }
    out
}
