import std/crypto/bn254
import std/crypto/pairing
import std/text

fn scalar_bytes(value: u8) -> u8[] {
    var out: u8[] = []
    for _ in 0..31 {
        out.push(0)
    }
    out.push(value)
    out
}

fn joined(parts: u8[][]) -> u8[] {
    var out: u8[] = []
    for part in parts {
        for b in part {
            out.push(b)
        }
    }
    out
}

/// Calls the EIP-196 and EIP-197 precompiles the way an Ethereum contract does: it adds and multiplies points of G1 in their 64-byte encoding, then checks that `e(2 G1, 3 G2) e(-6 G1, G2) = 1` with one `ECPAIRING` call over two pairs.
fn main() ! bn254.Error {
    let c = pairing.bn254()
    let g1 = bn254.encode_g1(c, c.g1)
    let g2 = bn254.encode_g2(c, c.g2)
    let doubled = bn254.ec_add(c, joined([g1, g1]))?
    let two = bn254.ec_mul(c, joined([g1, scalar_bytes(2)]))?
    print("G1 + G1 {text.encode_hex(doubled)}")
    print("2 G1 matches: {text.encode_hex(two) == text.encode_hex(doubled)}")

    let six = bn254.decode_g1(c, bn254.ec_mul(c, joined([g1, scalar_bytes(6)]))?)?
    let minus_six = bn254.encode_g1(c, pairing.neg(c, six))
    let three = bn254.encode_g2(c, pairing.mul_public(c, c.g2, [3]))
    let holds = bn254.ec_pairing(c, joined([two, three, minus_six, g2]))?
    print("e(2 G1, 3 G2) e(-6 G1, G2) = 1: {text.encode_hex(holds)}")
    let fails = bn254.ec_pairing(c, joined([two, three, two, g2]))?
    print("e(2 G1, 3 G2) e(2 G1, G2) = 1: {text.encode_hex(fails)}")
    print("empty input: {text.encode_hex(bn254.ec_pairing(c, [])?)}")
}
