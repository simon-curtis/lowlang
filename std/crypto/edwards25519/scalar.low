import std/crypto/limb
import std/io

fn order() -> u64[] {
    [0x5812631a5cf5d3ed, 0x14def9dea2f79cd6, 0, 0x1000000000000000]
}

fn words(b: u8[]) -> u64[] {
    let out: u64[] = __make(b.len / 8)
    for i in 0..out.len {
        out[i] = io.u64_le(b, 8 * i)
    }
    out
}

fn scalar_bytes(w: u64[]) -> u8[] {
    let out: u8[] = __make(32)
    for i in 0..4 {
        io.set_le64(out, 8 * i, i64(w[i]))
    }
    out
}

fn reduce_words(wide: u64[]) -> u8[] {
    let l = order()
    let r: u64[] = __make(4)
    let t: u64[] = __make(4)
    var i = wide.len * 64 - 1
    for i >= 0 {
        let bit = wide[i >> 6] >> (i & 63) & 1
        r[3] = r[3] << 1 | r[2] >> 63
        r[2] = r[2] << 1 | r[1] >> 63
        r[1] = r[1] << 1 | r[0] >> 63
        r[0] = r[0] << 1 | bit
        let borrow = limb.sub(t, r, l)
        limb.choose(r, r, t, limb.mask_of(borrow))
        i -= 1
    }
    scalar_bytes(r)
}

/// Returns the little-endian integer `digest` reduced modulo the group order `L = 2^252 + 27742317777372353535851937790883648493`, as 32 little-endian bytes.
///
/// `digest` can have any length that is a multiple of 8 bytes; the 64 bytes of a SHA-512 digest are the usual case. The running time depends only on the length.
pub fn reduce(digest: u8[]) -> u8[] {
    let wide = words(digest)
    reduce_words(wide)
}

/// Returns `(a * b + c) mod L` as 32 little-endian bytes, for 32-byte little-endian `a`, `b` and `c`.
///
/// The running time does not depend on the values.
pub fn mul_add(a: u8[], b: u8[], c: u8[]) -> u8[] {
    let x = words(a)
    let y = words(b)
    let w: u64[] = __make(8)
    let addend = words(c)
    __memmove(w, addend)
    for i in 0..4 {
        var carry: u64 = 0
        for j in 0..4 {
            let lo = x[i] * y[j]
            let hi = __mulhi(x[i], y[j])
            let s1 = lo + w[i + j]
            let c1 = limb.carry(lo, w[i + j], s1)
            let s2 = s1 + carry
            let c2 = limb.carry(s1, carry, s2)
            w[i + j] = s2
            carry = hi + c1 + c2
        }
        w[i + 4] = carry
    }
    reduce_words(w)
}

/// Returns whether the 32 little-endian bytes `s` encode an integer below the group order `L`.
///
/// The running time does not depend on the bytes.
pub fn canonical(s: u8[]) -> bool {
    let scratch: u64[] = __make(4)
    limb.sub(scratch, words(s), order()) == 1
}
