import std/crypto/hash
import std/crypto/limb
import field = std/crypto/curve25519

/// A point of the twisted Edwards curve `-x^2 + y^2 = 1 + d x^2 y^2` over GF(2^255 - 19) in extended coordinates `(X : Y : Z : T)`, with `x = X / Z`, `y = Y / Z` and `X * Y = Z * T`.
pub struct Point {
    /// The `X` coordinate.
    pub x: field.Fe
    /// The `Y` coordinate.
    pub y: field.Fe
    /// The `Z` coordinate.
    pub z: field.Fe
    /// The `T` coordinate.
    pub t: field.Fe
}

/// A point prepared as the second operand of an addition: `Y + X`, `Y - X`, `2 Z` and `2 d T`.
pub struct Cached {
    sum: field.Fe
    diff: field.Fe
    z2: field.Fe
    t2d: field.Fe
}

/// Returns the curve constant `d = -121665 / 121666`.
pub fn curve_d() -> field.Fe {
    field.limbs(929955233495203, 466365720129213, 1662059464998953, 2033849074728123, 1442794654840575)
}

fn curve_d2() -> field.Fe {
    field.limbs(1859910466990425, 932731440258426, 1072319116312658, 1815898335770999, 633789495995903)
}

/// Returns a square root of `-1` in GF(2^255 - 19).
pub fn sqrt_minus_one() -> field.Fe {
    field.limbs(1718705420411056, 234908883556509, 2233514472574048, 2117202627021982, 765476049583133)
}

/// Returns the base point of Ed25519, with `y = 4/5` and an even `x`.
pub fn base() -> Point {
    Point {
        x: field.limbs(1738742601995546, 1146398526822698, 2070867633025821, 562264141797630, 587772402128613)
        y: field.limbs(1801439850948184, 1351079888211148, 450359962737049, 900719925474099, 1801439850948198)
        z: field.one()
        t: field.limbs(1841354044333475, 16398895984059, 755974180946558, 900171276175154, 1821297809914039)
    }
}

/// Returns the neutral element `(0, 1)`.
pub fn identity() -> Point {
    Point { x: field.zero(), y: field.one(), z: field.one(), t: field.zero() }
}

/// Returns the additive inverse of `p`.
pub fn negate(p: Point) -> Point {
    Point { x: field.neg(p.x), y: p.y, z: p.z, t: field.neg(p.t) }
}

/// Returns `p` prepared for `add_cached`.
pub fn cached(p: Point) -> Cached {
    Cached {
        sum: field.add(p.y, p.x)
        diff: field.sub(p.y, p.x)
        z2: field.add(p.z, p.z)
        t2d: field.mul(p.t, curve_d2())
    }
}

/// Returns the sum of `p` and the prepared point `q`, with the same cost for every pair of points, doubling included.
pub fn add_cached(p: Point, q: Cached) -> Point {
    let diff = field.sub(p.y, p.x)
    let sum = field.add(p.y, p.x)
    let a = field.mul(diff, q.diff)
    let b = field.mul(sum, q.sum)
    let c = field.mul(p.t, q.t2d)
    let d = field.mul(p.z, q.z2)
    let e = field.sub(b, a)
    let f = field.sub(d, c)
    let g = field.add(d, c)
    let h = field.add(b, a)
    Point { x: field.mul(e, f), y: field.mul(g, h), z: field.mul(f, g), t: field.mul(e, h) }
}

/// Returns the sum of `p` and `q`.
pub fn add(p: Point, q: Point) -> Point {
    add_cached(p, cached(q))
}

/// Returns `2 p`.
pub fn double(p: Point) -> Point {
    let a = field.square(p.x)
    let b = field.square(p.y)
    let zz = field.square(p.z)
    let c = field.add(zz, zz)
    let h = field.add(a, b)
    let xy = field.add(p.x, p.y)
    let xy2 = field.square(xy)
    let e = field.sub(h, xy2)
    let g = field.sub(a, b)
    let f = field.add(c, g)
    Point { x: field.mul(e, f), y: field.mul(g, h), z: field.mul(f, g), t: field.mul(e, h) }
}

/// Returns the table `0 p`, `1 p`, ..., `15 p` that `multiply` reads.
pub fn multiples(p: Point) -> Cached[] {
    let step = cached(p)
    var table: Cached[] = []
    var acc = identity()
    for _ in 0..16 {
        table.push(cached(acc))
        acc = add_cached(acc, step)
    }
    table
}

fn choose_cached(a: Cached, b: Cached, choice: u64) -> Cached {
    Cached {
        sum: field.choose(a.sum, b.sum, choice)
        diff: field.choose(a.diff, b.diff, choice)
        z2: field.choose(a.z2, b.z2, choice)
        t2d: field.choose(a.t2d, b.t2d, choice)
    }
}

fn lookup(table: Cached[], digit: u64) -> Cached {
    var out = table[0]
    for i in 1..16 {
        out = choose_cached(out, table[i], limb.same(u64(i), digit))
    }
    out
}

/// Returns `scalar * P` for the table `multiples(P)` and a 32-byte little-endian `scalar`.
///
/// The scalar is read in 4-bit windows through a table lookup that touches every entry, so the running time and the memory accesses do not depend on its value. A scalar of 2^256 or more is not reduced; its low 256 bits are used.
pub fn multiply(table: Cached[], scalar: u8[]) -> Point {
    var q = identity()
    var i = 63
    for i >= 0 {
        for _ in 0..4 {
            q = double(q)
        }
        let digit = u64(scalar[i >> 1] >> u8(4 * (i & 1))) & 15
        let entry = lookup(table, digit)
        q = add_cached(q, entry)
        i -= 1
    }
    q
}

/// Returns the 32-byte encoding of `p` of RFC 8032 section 5.1.2: the little-endian `y` coordinate with the sign of `x` in the top bit.
pub fn encode(p: Point) -> u8[] {
    let inverse = field.invert(p.z)
    let x = field.mul(p.x, inverse)
    let y = field.mul(p.y, inverse)
    let out = field.to_bytes(y)
    out[31] |= u8(field.is_negative(x) << 7)
    out
}

/// Returns the point that the 32-byte encoding `b` of RFC 8032 section 5.1.3 describes, or `none` when `b` is not 32 bytes, `y` is not below `2^255 - 19`, no point has that `y`, or the encoding asks for the negative of `x = 0`.
pub fn decode(b: u8[]) -> Point? {
    if b.len != 32 {
        return none
    }
    let encoded: u8[] = __make(32)
    __memmove(encoded, b)
    let sign = u64(encoded[31] >> 7)
    encoded[31] &= 127
    let y = field.from_bytes(encoded)
    let canonical = field.to_bytes(y)
    if !hash.equal(canonical, encoded) {
        return none
    }
    let yy = field.square(y)
    let u = field.sub(yy, field.one())
    let d = curve_d()
    let dyy = field.mul(d, yy)
    let v = field.add(dyy, field.one())
    let v2 = field.square(v)
    let v3 = field.mul(v2, v)
    let v6 = field.square(v3)
    let v7 = field.mul(v6, v)
    let uv3 = field.mul(u, v3)
    let uv7 = field.mul(u, v7)
    let root = field.pow_p58(uv7)
    var x = field.mul(uv3, root)
    let xx = field.square(x)
    let vxx = field.mul(v, xx)
    if !field.equal(vxx, u) {
        let minus_u = field.neg(u)
        if !field.equal(vxx, minus_u) {
            return none
        }
        x = field.mul(x, sqrt_minus_one())
    }
    if sign == 1 && field.equal(x, field.zero()) {
        return none
    }
    if field.is_negative(x) != sign {
        x = field.neg(x)
    }
    Point { x, y, z: field.one(), t: field.mul(x, y) }
}
