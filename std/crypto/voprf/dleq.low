import std/crypto/hash
import std/slices

struct Composites {
    m: []u8
    z: []u8
}

fn composite_seed(g: Group, context: []u8, b: []u8) -> []u8 {
    let seed_dst = tagged("Seed-", context)
    let transcript = slices.concat(frame(b), frame(seed_dst))
    hash.sum(g.hash, transcript)
}

fn composite_weight(g: Group, context: []u8, seed: []u8, i: i64, c: []u8, d: []u8) -> []u8 {
    let index = be16(i)
    let transcript = slices.flatten([frame(seed), index, frame(c), frame(d), bytes("Composite")])
    let dst = tagged("HashToScalar-", context)
    g.hash_to_scalar(transcript, dst)
}

fn compute_composites_fast(g: Group, context: []u8, k: []u8, b: []u8, c: [][]u8, d: [][]u8) -> Composites ! Error {
    let seed = composite_seed(g, context, b)
    var m = identity_element(g)
    for i in 0..c.len {
        let weight = composite_weight(g, context, seed, i, c[i], d[i])
        let scaled = g.mul(c[i], weight)?
        m = g.add(scaled, m)?
    }
    let z = g.mul(m, k)?
    Composites { m, z }
}

fn compute_composites(g: Group, context: []u8, b: []u8, c: [][]u8, d: [][]u8) -> Composites ! Error {
    let seed = composite_seed(g, context, b)
    var m = identity_element(g)
    var z = identity_element(g)
    for i in 0..c.len {
        let weight = composite_weight(g, context, seed, i, c[i], d[i])
        let scaled_c = g.mul(c[i], weight)?
        m = g.add(scaled_c, m)?
        let scaled_d = g.mul(d[i], weight)?
        z = g.add(scaled_d, z)?
    }
    Composites { m, z }
}

fn challenge(g: Group, context: []u8, b: []u8, m: []u8, z: []u8, t2: []u8, t3: []u8) -> []u8 {
    let transcript = slices.flatten([frame(b), frame(m), frame(z), frame(t2), frame(t3), bytes("Challenge")])
    let dst = tagged("HashToScalar-", context)
    g.hash_to_scalar(transcript, dst)
}

fn generate_proof(g: Group, context: []u8, k: []u8, a: []u8, b: []u8, c: [][]u8, d: [][]u8, r: []u8) -> []u8 ! Error {
    let composites = compute_composites_fast(g, context, k, b, c, d)?
    let t2 = g.mul(a, r)?
    let t3 = g.mul(composites.m, r)?
    let challenged = challenge(g, context, b, composites.m, composites.z, t2, t3)
    let product = g.scalar_mul(challenged, k)
    let s = g.scalar_sub(r, product)
    slices.concat(challenged, s)
}

fn verify_proof(g: Group, context: []u8, a: []u8, b: []u8, c: [][]u8, d: [][]u8, proof: []u8) -> bool ! Error {
    if proof.len != 2 * g.scalar_size {
        fail Deserialize
    }
    let proof_c = g.scalar(proof[..g.scalar_size])?
    let proof_s = g.scalar(proof[g.scalar_size..])?
    let composites = compute_composites(g, context, b, c, d)?
    let sa = g.mul(a, proof_s)?
    let cb = g.mul(b, proof_c)?
    let t2 = g.add(sa, cb)?
    let sm = g.mul(composites.m, proof_s)?
    let cz = g.mul(composites.z, proof_c)?
    let t3 = g.add(sm, cz)?
    let expected = challenge(g, context, b, composites.m, composites.z, t2, t3)
    hash.equal(expected, proof_c)
}
