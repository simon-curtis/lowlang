import std/crypto/hash
import std/slices

struct Group {
    element_size: i64
    scalar_size: i64
    hash: hash.Algorithm
    generator: []u8
    hash_to_group: fn([]u8, []u8) -> []u8
    hash_to_scalar: fn([]u8, []u8) -> []u8
    random_scalar: fn() -> []u8
    base_mul: fn([]u8) -> []u8
    mul: fn([]u8, []u8) -> []u8 ! Error
    add: fn([]u8, []u8) -> []u8 ! Error
    element: fn([]u8) -> []u8 ! Error
    scalar: fn([]u8) -> []u8 ! Error
    scalar_add: fn([]u8, []u8) -> []u8
    scalar_sub: fn([]u8, []u8) -> []u8
    scalar_mul: fn([]u8, []u8) -> []u8
    scalar_invert: fn([]u8) -> []u8
}

fn group_of(suite: Suite) -> Group {
    match suite {
        Ristretto255Sha512 => ristretto_group()
        P256Sha256 => p256_group()
    }
}

fn identifier(suite: Suite) -> str {
    match suite {
        Ristretto255Sha512 => "ristretto255-SHA512"
        P256Sha256 => "P256-SHA256"
    }
}

fn context_string(suite: Suite, mode: Mode) -> []u8 {
    let mode_byte: []u8 = [u8(mode.index)]
    slices.flatten([bytes("OPRFV1-"), mode_byte, bytes("-"), bytes(identifier(suite))])
}

fn tagged(label: str, context: []u8) -> []u8 {
    slices.concat(bytes(label), context)
}

fn be16(n: i64) -> []u8 {
    [u8(n >> 8), u8(n)]
}

fn frame(b: []u8) -> []u8 {
    let size = be16(b.len)
    slices.concat(size, b)
}

fn all_zero(b: []u8) -> bool {
    var acc: u8 = 0
    for byte in b {
        acc |= byte
    }
    acc == 0
}

fn identity_element(g: Group) -> []u8 {
    __make(g.element_size)
}

fn fits(b: []u8) -> bool {
    b.len < 65535
}
