import std/crypto/hash
import std/crypto/hashtocurve
import std/crypto/ristretto255

fn ristretto_group() -> Group {
    let generator = ristretto255.encode(ristretto255.generator())
    Group {
        element_size: 32
        scalar_size: 32
        hash: hash.sha512()
        generator
        hash_to_group: ristretto_hash_to_group
        hash_to_scalar: hashtocurve.hash_to_ristretto255_scalar
        random_scalar: ristretto255.scalar_random
        base_mul: ristretto_base_mul
        mul: ristretto_mul
        add: ristretto_add
        element: ristretto_element
        scalar: ristretto_scalar
        scalar_add: ristretto255.scalar_add
        scalar_sub: ristretto255.scalar_sub
        scalar_mul: ristretto255.scalar_mul
        scalar_invert: ristretto255.scalar_invert
    }
}

fn ristretto_hash_to_group(input: []u8, dst: []u8) -> []u8 {
    let element = hashtocurve.hash_to_ristretto255(input, dst)
    ristretto255.encode(element)
}

fn ristretto_base_mul(k: []u8) -> []u8 {
    let product = ristretto255.multiply_base(k)
    ristretto255.encode(product)
}

fn ristretto_decode(b: []u8) -> ristretto255.Element ! Error {
    match ristretto255.decode(b) {
        some(element) => element
        none => fail Deserialize
    }
}

fn ristretto_mul(e: []u8, k: []u8) -> []u8 ! Error {
    let element = ristretto_decode(e)?
    let product = ristretto255.multiply(element, k)
    ristretto255.encode(product)
}

fn ristretto_add(a: []u8, b: []u8) -> []u8 ! Error {
    let left = ristretto_decode(a)?
    let right = ristretto_decode(b)?
    let sum = ristretto255.add(left, right)
    ristretto255.encode(sum)
}

fn ristretto_element(b: []u8) -> []u8 ! Error {
    let element = ristretto_decode(b)?
    if ristretto255.equal(element, ristretto255.identity()) {
        fail Deserialize
    }
    b
}

fn ristretto_scalar(b: []u8) -> []u8 ! Error {
    match ristretto255.scalar_from_bytes(b) {
        some(scalar) => scalar
        none => fail Deserialize
    }
}
