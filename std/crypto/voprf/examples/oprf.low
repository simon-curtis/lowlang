import std/crypto/voprf
import std/text

fn describe(e: voprf.Error) -> str {
    match e {
        InvalidInput => "invalid input"
        Inverse => "no inverse"
        Verify => "proof does not verify"
        Deserialize => "bad encoding"
        DeriveKeyPair => "no key"
    }
}

fn hex(b: u8[]) -> str {
    text.encode_hex(b)
}

fn run(suite: voprf.Suite, name: str) ! voprf.Error {
    let seed = text.decode_hex("a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3") or []
    let pair = voprf.derive_key_pair(suite, voprf.Mode.Oprf, seed, bytes("test key"))?
    print("{name} private key {hex(pair.secret)}")

    let server = voprf.Server { suite, mode: voprf.Mode.Oprf, secret: pair.secret }
    let client = voprf.Client { suite, mode: voprf.Mode.Oprf, public: [] }
    let password = bytes("correct horse battery staple")
    let info: u8[] = []

    let request = voprf.blind(client, password, info)?
    let evaluation = voprf.blind_evaluate(server, [request.element], info)?
    let outputs = voprf.finalize(client, [request], evaluation, info)?
    print("{name} client output {hex(outputs[0])}")

    let direct = voprf.evaluate(server, password, info)?
    print("{name} server output {hex(direct)}")
    print("{name} outputs agree: {hex(direct) == hex(outputs[0])}")
}

/// Computes an oblivious PRF output for a password: the client blinds it, the server evaluates the blinded element without learning the password, and the client unblinds the result. The server can also compute the same output from the password directly.
fn main() {
    run(voprf.Suite.Ristretto255Sha512, "ristretto255") catch {
        e => print("ristretto255 failed: {describe(e)}")
    }
    run(voprf.Suite.P256Sha256, "p256") catch {
        e => print("p256 failed: {describe(e)}")
    }
}
