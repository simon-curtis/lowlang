import std/crypto/voprf
import std/text

fn describe(e: voprf.Error) -> str {
    match e {
        InvalidInput => "invalid input"
        Inverse => "no inverse"
        Verify => "proof does not verify"
        Deserialize => "bad encoding"
        DeriveKeyPair => "no key"
    }
}

fn hex(b: []u8) -> str {
    text.encode_hex(b)
}

fn outcome(client: voprf.Client, requests: []voprf.Request, evaluation: voprf.Evaluation, info: []u8) -> str {
    let outputs = voprf.finalize(client, requests, evaluation, info) catch {
        e => return describe(e)
    }
    "verified, {outputs.len} outputs"
}

fn run(suite: voprf.Suite, mode: voprf.Mode, name: str, info: []u8, flip_at: i64) ! voprf.Error {
    let seed = text.decode_hex("a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3a3") or []
    let pair = voprf.derive_key_pair(suite, mode, seed, bytes("test key"))?
    print("{name} public key {hex(pair.public)}")

    let server = voprf.Server { suite, mode, secret: pair.secret }
    let client = voprf.Client { suite, mode, public: pair.public }

    let first = voprf.blind(client, bytes("first input"), info)?
    let second = voprf.blind(client, bytes("second input"), info)?
    let requests = [first, second]
    let evaluation = voprf.blind_evaluate(server, [first.element, second.element], info)?
    print("{name} batched proof is {evaluation.proof.len} bytes for {evaluation.elements.len} elements")
    print("{name} honest server: {outcome(client, requests, evaluation, info)}")

    var forged: []u8 = []
    for byte in evaluation.proof {
        push(mut forged, byte)
    }
    forged[flip_at] ^= 1
    let tampered = voprf.Evaluation { elements: evaluation.elements, proof: forged }
    print("{name} flipped proof bit: {outcome(client, requests, tampered, info)}")

    let imposter = voprf.generate_key_pair(suite)
    let other = voprf.Server { suite, mode, secret: imposter.secret }
    let swapped = voprf.blind_evaluate(other, [first.element, second.element], info)?
    print("{name} other key: {outcome(client, requests, swapped, info)}")

    let outputs = voprf.finalize(client, requests, evaluation, info)?
    let expected = voprf.evaluate(server, bytes("second input"), info)?
    print("{name} second output matches direct evaluation: {hex(outputs[1]) == hex(expected)}")
}

/// Runs the verifiable protocol with a batch of two inputs under both suites. The server proves with one DLEQ proof that it used the key whose public key the client holds, and the client rejects a flipped proof bit and the answer of a server with another key. The POPRF run binds public input to the output.
fn main() {
    run(voprf.Suite.Ristretto255Sha512, voprf.Mode.Voprf, "voprf ristretto255", [], 0) catch {
        e => print("voprf ristretto255 failed: {describe(e)}")
    }
    run(voprf.Suite.P256Sha256, voprf.Mode.Poprf, "poprf p256", bytes("session 7"), 31) catch {
        e => print("poprf p256 failed: {describe(e)}")
    }
}
