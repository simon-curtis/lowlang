import std/crypto/hash
import std/crypto/hashtocurve
import std/crypto/nistec

fn p256_group() -> Group {
    let curve = nistec.p256()
    let generator = p256_encode(curve, curve.g)
    Group {
        element_size: 33
        scalar_size: 32
        hash: hash.sha256()
        generator
        hash_to_group: fn(input, dst) { p256_hash_to_group(curve, input, dst) }
        hash_to_scalar: fn(input, dst) { hashtocurve.hash_to_scalar_p256(curve, input, dst) }
        random_scalar: fn() { nistec.order_random(curve) }
        base_mul: fn(k) { p256_base_mul(curve, k) }
        mul: fn(e, k) { p256_mul(curve, e, k) }
        add: fn(a, b) { p256_add(curve, a, b) }
        element: fn(b) { p256_element(curve, b) }
        scalar: fn(b) { p256_scalar(curve, b) }
        scalar_add: fn(a, b) { nistec.order_add(curve, a, b) }
        scalar_sub: fn(a, b) { nistec.order_sub(curve, a, b) }
        scalar_mul: fn(a, b) { nistec.order_mul(curve, a, b) }
        scalar_invert: fn(a) { nistec.order_invert(curve, a) }
    }
}

fn p256_encode(curve: *nistec.Group, p: nistec.Point) -> u8[] {
    match nistec.compress(curve, p) {
        some(encoded) => encoded
        none => __make(33)
    }
}

fn p256_decode(curve: *nistec.Group, b: u8[]) -> nistec.Point ! Error {
    if b.len == 33 && all_zero(b) {
        return nistec.infinity(curve)
    }
    match nistec.decompress(curve, b) {
        some(point) => point
        none => fail Deserialize
    }
}

fn p256_hash_to_group(curve: *nistec.Group, input: u8[], dst: u8[]) -> u8[] {
    let point = hashtocurve.hash_to_curve_p256(curve, input, dst)
    p256_encode(curve, point)
}

fn p256_base_mul(curve: *nistec.Group, k: u8[]) -> u8[] {
    let product = nistec.scalar_mul(curve, curve.g, k)
    p256_encode(curve, product)
}

fn p256_mul(curve: *nistec.Group, e: u8[], k: u8[]) -> u8[] ! Error {
    let point = p256_decode(curve, e)?
    let product = nistec.scalar_mul(curve, point, k)
    p256_encode(curve, product)
}

fn p256_add(curve: *nistec.Group, a: u8[], b: u8[]) -> u8[] ! Error {
    let left = p256_decode(curve, a)?
    let right = p256_decode(curve, b)?
    let sum = nistec.infinity(curve)
    nistec.point_add(curve, sum, left, right)
    p256_encode(curve, sum)
}

fn p256_element(curve: *nistec.Group, b: u8[]) -> u8[] ! Error {
    match nistec.decompress(curve, b) {
        some(_) => b
        none => fail Deserialize
    }
}

fn p256_scalar(curve: *nistec.Group, b: u8[]) -> u8[] ! Error {
    match nistec.order_from_bytes(curve, b) {
        some(scalar) => scalar
        none => fail Deserialize
    }
}
