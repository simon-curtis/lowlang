struct Params {
    n: i64
    h: i64
    d: i64
    a: i64
    k: i64
    m: i64
    shake: bool
}

fn params(level: Level) -> Params {
    match level {
        Sha2_128s => Params { n: 16, h: 63, d: 7, a: 12, k: 14, m: 30, shake: false }
        Sha2_128f => Params { n: 16, h: 66, d: 22, a: 6, k: 33, m: 34, shake: false }
        Sha2_192s => Params { n: 24, h: 63, d: 7, a: 14, k: 17, m: 39, shake: false }
        Sha2_192f => Params { n: 24, h: 66, d: 22, a: 8, k: 33, m: 42, shake: false }
        Sha2_256s => Params { n: 32, h: 64, d: 8, a: 14, k: 22, m: 47, shake: false }
        Sha2_256f => Params { n: 32, h: 68, d: 17, a: 9, k: 35, m: 49, shake: false }
        Shake_128s => Params { n: 16, h: 63, d: 7, a: 12, k: 14, m: 30, shake: true }
        Shake_128f => Params { n: 16, h: 66, d: 22, a: 6, k: 33, m: 34, shake: true }
        Shake_192s => Params { n: 24, h: 63, d: 7, a: 14, k: 17, m: 39, shake: true }
        Shake_192f => Params { n: 24, h: 66, d: 22, a: 8, k: 33, m: 42, shake: true }
        Shake_256s => Params { n: 32, h: 64, d: 8, a: 14, k: 22, m: 47, shake: true }
        Shake_256f => Params { n: 32, h: 68, d: 17, a: 9, k: 35, m: 49, shake: true }
    }
}

fn height(p: Params) -> i64 {
    p.h / p.d
}

fn wots_len(p: Params) -> i64 {
    2 * p.n + 3
}

fn public_len(p: Params) -> i64 {
    2 * p.n
}

fn private_len(p: Params) -> i64 {
    4 * p.n
}

fn signature_len(p: Params) -> i64 {
    (1 + p.k * (1 + p.a) + p.h + p.d * wots_len(p)) * p.n
}

fn fors_bytes(p: Params) -> i64 {
    (p.k * p.a + 7) / 8
}

fn tree_bytes(p: Params) -> i64 {
    (p.h - height(p) + 7) / 8
}

fn leaf_bytes(p: Params) -> i64 {
    (height(p) + 7) / 8
}

fn to_int(bytes: u8[]) -> u64 {
    var out: u64 = 0
    for b in bytes {
        out = out << 8 | u64(b)
    }
    out
}

fn low_bits(x: u64, bits: i64) -> u64 {
    if bits >= 64 {
        return x
    }
    x & ((u64(1) << bits) - 1)
}

fn base_2b(x: u8[], b: i64, count: i64) -> i64[] {
    let out: i64[] = __make(count)
    var at = 0
    var bits = 0
    var total: u64 = 0
    for o in 0..count {
        for bits < b {
            total = total << 8 | u64(x[at])
            at += 1
            bits += 8
        }
        bits -= b
        out[o] = i64(total >> bits & ((u64(1) << b) - 1))
        total &= (u64(1) << bits) - 1
    }
    out
}
