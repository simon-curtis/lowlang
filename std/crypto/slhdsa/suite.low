import std/crypto/hash
import std/crypto/sha3
import std/io

struct Suite {
    n: i64
    f: fn(u8[], u8[]) -> u8[]
    h: fn(u8[], u8[]) -> u8[]
    prf: fn(u8[], u8[]) -> u8[]
    prf_msg: fn(u8[], u8[], u8[]) -> u8[]
    h_msg: fn(u8[], u8[], u8[]) -> u8[]
}

fn join(parts: u8[][]) -> u8[] {
    var out: u8[] = []
    for part in parts {
        io.append(mut out, part)
    }
    out
}

fn new_suite(p: Params, pk_seed: u8[]) -> Suite {
    if p.shake {
        return shake_suite(p, pk_seed)
    }
    sha2_suite(p, pk_seed)
}

fn shake_hash(n: i64, parts: u8[][]) -> u8[] {
    let x = sha3.shake256()
    for part in parts {
        sha3.absorb(x, part)
    }
    sha3.squeeze(x, n)
}

fn shake_suite(p: Params, pk_seed: u8[]) -> Suite {
    let n = p.n
    let m = p.m
    Suite {
        n,
        f: fn(adrs, x) shake_hash(n, [pk_seed, adrs, x]),
        h: fn(adrs, x) shake_hash(n, [pk_seed, adrs, x]),
        prf: fn(adrs, sk_seed) shake_hash(n, [pk_seed, adrs, sk_seed]),
        prf_msg: fn(sk_prf, opt_rand, message) shake_hash(n, [sk_prf, opt_rand, message]),
        h_msg: fn(r, pk_root, message) shake_hash(m, [r, pk_seed, pk_root, message]),
    }
}

fn padded_prefix(a: hash.Algorithm, pk_seed: u8[]) -> hash.Digest {
    let d = a.digest()
    d.update(pk_seed)
    let padding: u8[] = __make(a.block - pk_seed.len)
    d.update(padding)
    d
}

fn prefixed(base: hash.Digest, n: i64, adrs: u8[], x: u8[]) -> u8[] {
    let d = base.clone()
    d.update(compress(adrs))
    d.update(x)
    d.finish()[..n]
}

fn mgf1(a: hash.Algorithm, seed: u8[], length: i64) -> u8[] {
    var out: u8[] = []
    var counter = 0
    for out.len < length {
        let tail: u8[] = [u8(counter >> 24), u8(counter >> 16), u8(counter >> 8), u8(counter)]
        let input = join([seed, tail])
        let block = hash.sum(a, input)
        io.append(mut out, block)
        counter += 1
    }
    out[..length]
}

fn sha2_suite(p: Params, pk_seed: u8[]) -> Suite {
    let n = p.n
    let m = p.m
    let wide = if n == 16 { hash.sha256() } else { hash.sha512() }
    let small = padded_prefix(hash.sha256(), pk_seed)
    let large = if n == 16 { small } else { padded_prefix(hash.sha512(), pk_seed) }
    Suite {
        n,
        f: fn(adrs, x) prefixed(small, n, adrs, x),
        h: fn(adrs, x) prefixed(large, n, adrs, x),
        prf: fn(adrs, sk_seed) prefixed(small, n, adrs, sk_seed),
        prf_msg: fn(sk_prf, opt_rand, message) hash.hmac(wide, sk_prf, join([opt_rand, message]))[..n],
        h_msg: fn(r, pk_root, message) {
            let inner = hash.sum(wide, join([r, pk_seed, pk_root, message]))
            mgf1(wide, join([r, pk_seed, inner]), m)
        },
    }
}
