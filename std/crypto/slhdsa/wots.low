struct Context {
    p: Params
    s: Suite
    sk_seed: u8[]
}

fn chain(c: Context, x: u8[], start: i64, steps: i64, adrs: u8[]) -> u8[] {
    var tmp = x
    for j in start..start + steps {
        set_hash(adrs, j)
        tmp = c.s.f(adrs, tmp)
    }
    tmp
}

fn wots_digits(c: Context, m: u8[]) -> i64[] {
    var digits = base_2b(m, 4, 2 * c.p.n)
    var checksum = 0
    for d in digits {
        checksum += 15 - d
    }
    checksum <<= 4
    let encoded: u8[] = [u8(checksum >> 8), u8(checksum)]
    for d in base_2b(encoded, 4, 3) {
        digits.push(d)
    }
    digits
}

fn wots_secret(c: Context, adrs: u8[], index: i64) -> u8[] {
    let sk_adrs = copy_address(adrs)
    set_type(sk_adrs, kind_wots_prf)
    set_keypair(sk_adrs, get_keypair(adrs))
    set_chain(sk_adrs, index)
    c.s.prf(sk_adrs, c.sk_seed)
}

fn wots_compress(c: Context, adrs: u8[], tops: u8[][]) -> u8[] {
    let pk_adrs = copy_address(adrs)
    set_type(pk_adrs, kind_wots_pk)
    set_keypair(pk_adrs, get_keypair(adrs))
    c.s.h(pk_adrs, join(tops))
}

fn wots_pk_gen(c: Context, adrs: u8[]) -> u8[] {
    var tops: u8[][] = []
    for i in 0..wots_len(c.p) {
        let sk = wots_secret(c, adrs, i)
        set_chain(adrs, i)
        tops.push(chain(c, sk, 0, 15, adrs))
    }
    wots_compress(c, adrs, tops)
}

fn wots_sign(c: Context, m: u8[], adrs: u8[]) -> u8[] {
    let digits = wots_digits(c, m)
    var parts: u8[][] = []
    for i in 0..wots_len(c.p) {
        let sk = wots_secret(c, adrs, i)
        set_chain(adrs, i)
        parts.push(chain(c, sk, 0, digits[i], adrs))
    }
    join(parts)
}

fn wots_pk_from_sig(c: Context, sig: u8[], m: u8[], adrs: u8[]) -> u8[] {
    let n = c.p.n
    let digits = wots_digits(c, m)
    var tops: u8[][] = []
    for i in 0..wots_len(c.p) {
        set_chain(adrs, i)
        let start = sig[i * n..(i + 1) * n]
        tops.push(chain(c, start, digits[i], 15 - digits[i], adrs))
    }
    wots_compress(c, adrs, tops)
}
