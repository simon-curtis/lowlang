const kind_wots_hash = 0
const kind_wots_pk = 1
const kind_tree = 2
const kind_fors_tree = 3
const kind_fors_roots = 4
const kind_wots_prf = 5
const kind_fors_prf = 6

fn new_address() -> u8[] {
    let a: u8[] = __make(32)
    a
}

fn copy_address(a: u8[]) -> u8[] {
    let out: u8[] = __make(32)
    __memmove(out, a)
    out
}

fn put32(a: u8[], at: i64, v: i64) {
    a[at] = u8(v >> 24)
    a[at + 1] = u8(v >> 16)
    a[at + 2] = u8(v >> 8)
    a[at + 3] = u8(v)
}

fn get32(a: u8[], at: i64) -> i64 {
    i64(a[at]) << 24 | i64(a[at + 1]) << 16 | i64(a[at + 2]) << 8 | i64(a[at + 3])
}

fn set_layer(a: u8[], v: i64) {
    put32(a, 0, v)
}

fn set_tree(a: u8[], v: u64) {
    for i in 0..8 {
        a[15 - i] = u8(v >> (8 * i))
    }
}

fn set_type(a: u8[], t: i64) {
    put32(a, 16, t)
    for i in 20..32 {
        a[i] = 0
    }
}

fn set_keypair(a: u8[], v: i64) {
    put32(a, 20, v)
}

fn get_keypair(a: u8[]) -> i64 {
    get32(a, 20)
}

fn set_chain(a: u8[], v: i64) {
    put32(a, 24, v)
}

fn set_tree_height(a: u8[], v: i64) {
    put32(a, 24, v)
}

fn set_hash(a: u8[], v: i64) {
    put32(a, 28, v)
}

fn set_tree_index(a: u8[], v: i64) {
    put32(a, 28, v)
}

fn get_tree_index(a: u8[]) -> i64 {
    get32(a, 28)
}

fn compress(a: u8[]) -> u8[] {
    let out: u8[] = __make(22)
    out[0] = a[3]
    __memmove(out[1..9], a[8..16])
    out[9] = a[19]
    __memmove(out[10..22], a[20..32])
    out
}
