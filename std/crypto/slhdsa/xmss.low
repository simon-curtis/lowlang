import std/crypto/hash
import std/io

fn xmss_node(c: Context, i: i64, z: i64, adrs: []u8) -> []u8 {
    if z == 0 {
        set_type(adrs, kind_wots_hash)
        set_keypair(adrs, i)
        return wots_pk_gen(c, adrs)
    }
    let left = xmss_node(c, 2 * i, z - 1, adrs)
    let right = xmss_node(c, 2 * i + 1, z - 1, adrs)
    set_type(adrs, kind_tree)
    set_tree_height(adrs, z)
    set_tree_index(adrs, i)
    c.s.h(adrs, join([left, right]))
}

fn xmss_sign(c: Context, m: []u8, idx: i64, adrs: []u8) -> []u8 {
    var auth: [][]u8 = []
    for j in 0..height(c.p) {
        let sibling = (idx >> j) ^ 1
        push(mut auth, xmss_node(c, sibling, j, adrs))
    }
    set_type(adrs, kind_wots_hash)
    set_keypair(adrs, idx)
    let sig = wots_sign(c, m, adrs)
    join([sig, join(auth)])
}

fn xmss_pk_from_sig(c: Context, idx: i64, sig: []u8, m: []u8, adrs: []u8) -> []u8 {
    let n = c.p.n
    let wots_bytes = wots_len(c.p) * n
    set_type(adrs, kind_wots_hash)
    set_keypair(adrs, idx)
    var node = wots_pk_from_sig(c, sig[..wots_bytes], m, adrs)
    set_type(adrs, kind_tree)
    set_tree_index(adrs, idx)
    for k in 0..height(c.p) {
        set_tree_height(adrs, k + 1)
        let sibling = sig[wots_bytes + k * n..wots_bytes + (k + 1) * n]
        if (idx >> k) & 1 == 0 {
            set_tree_index(adrs, get_tree_index(adrs) / 2)
            node = c.s.h(adrs, join([node, sibling]))
        } else {
            set_tree_index(adrs, (get_tree_index(adrs) - 1) / 2)
            node = c.s.h(adrs, join([sibling, node]))
        }
    }
    node
}

fn ht_sign(c: Context, m: []u8, idx_tree: u64, idx_leaf: i64) -> []u8 {
    let p = c.p
    let adrs = new_address()
    var tree_index = idx_tree
    var leaf = idx_leaf
    set_tree(adrs, tree_index)
    var out: []u8 = []
    var sig = xmss_sign(c, m, leaf, adrs)
    io.append(mut out, sig)
    var root = xmss_pk_from_sig(c, leaf, sig, m, adrs)
    for j in 1..p.d {
        leaf = i64(low_bits(tree_index, height(p)))
        tree_index >>= height(p)
        set_layer(adrs, j)
        set_tree(adrs, tree_index)
        sig = xmss_sign(c, root, leaf, adrs)
        io.append(mut out, sig)
        if j < p.d - 1 {
            root = xmss_pk_from_sig(c, leaf, sig, root, adrs)
        }
    }
    out
}

fn ht_verify(c: Context, m: []u8, sig: []u8, idx_tree: u64, idx_leaf: i64, pk_root: []u8) -> bool {
    let p = c.p
    let layer_bytes = (wots_len(p) + height(p)) * p.n
    let adrs = new_address()
    var tree_index = idx_tree
    var leaf = idx_leaf
    set_tree(adrs, tree_index)
    var node = xmss_pk_from_sig(c, leaf, sig[..layer_bytes], m, adrs)
    for j in 1..p.d {
        leaf = i64(low_bits(tree_index, height(p)))
        tree_index >>= height(p)
        set_layer(adrs, j)
        set_tree(adrs, tree_index)
        node = xmss_pk_from_sig(c, leaf, sig[j * layer_bytes..(j + 1) * layer_bytes], node, adrs)
    }
    hash.equal(node, pk_root)
}
