import std/io

fn fors_secret(c: Context, adrs: []u8, idx: i64) -> []u8 {
    let sk_adrs = copy_address(adrs)
    set_type(sk_adrs, kind_fors_prf)
    set_keypair(sk_adrs, get_keypair(adrs))
    set_tree_height(sk_adrs, 0)
    set_tree_index(sk_adrs, idx)
    c.s.prf(sk_adrs, c.sk_seed)
}

fn fors_node(c: Context, i: i64, z: i64, adrs: []u8) -> []u8 {
    if z == 0 {
        let sk = fors_secret(c, adrs, i)
        set_tree_height(adrs, 0)
        set_tree_index(adrs, i)
        return c.s.f(adrs, sk)
    }
    let left = fors_node(c, 2 * i, z - 1, adrs)
    let right = fors_node(c, 2 * i + 1, z - 1, adrs)
    set_tree_height(adrs, z)
    set_tree_index(adrs, i)
    c.s.h(adrs, join([left, right]))
}

fn fors_sign(c: Context, md: []u8, adrs: []u8) -> []u8 {
    let p = c.p
    let indices = base_2b(md, p.a, p.k)
    var out: []u8 = []
    for i in 0..p.k {
        let leaf = i * (1 << p.a) + indices[i]
        io.append(mut out, fors_secret(c, adrs, leaf))
        for j in 0..p.a {
            let sibling = (indices[i] >> j) ^ 1
            let node = fors_node(c, i * (1 << (p.a - j)) + sibling, j, adrs)
            io.append(mut out, node)
        }
    }
    out
}

fn fors_pk_from_sig(c: Context, sig: []u8, md: []u8, adrs: []u8) -> []u8 {
    let p = c.p
    let n = p.n
    let indices = base_2b(md, p.a, p.k)
    let per_tree = (1 + p.a) * n
    var roots: [][]u8 = []
    for i in 0..p.k {
        let base = i * per_tree
        set_tree_height(adrs, 0)
        set_tree_index(adrs, i * (1 << p.a) + indices[i])
        var node = c.s.f(adrs, sig[base..base + n])
        for j in 0..p.a {
            set_tree_height(adrs, j + 1)
            let sibling = sig[base + (1 + j) * n..base + (2 + j) * n]
            if (indices[i] >> j) & 1 == 0 {
                set_tree_index(adrs, get_tree_index(adrs) / 2)
                node = c.s.h(adrs, join([node, sibling]))
            } else {
                set_tree_index(adrs, (get_tree_index(adrs) - 1) / 2)
                node = c.s.h(adrs, join([sibling, node]))
            }
        }
        push(mut roots, node)
    }
    let pk_adrs = copy_address(adrs)
    set_type(pk_adrs, kind_fors_roots)
    set_keypair(pk_adrs, get_keypair(adrs))
    c.s.h(pk_adrs, join(roots))
}
