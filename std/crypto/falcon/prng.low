import std/crypto/aead
import std/crypto/sha3
import std/io

struct Prng {
    buf: u8[]
    key: u32[]
    counter: u64
    at: i64
    state: u32[]
    block: u8[]
}

fn prng(source: *sha3.Shake) -> *Prng {
    let seed = sha3.squeeze(source, 56)
    let key: u32[] = __make(12)
    for i in 0..12 {
        key[i] = io.u32_le(seed, 4 * i)
    }
    let p = new(Prng { buf: __make(512), key, counter: io.u64_le(seed, 48), at: 0, state: __make(32), block: __make(64) })
    p.refill()
    p
}

fn refill(p: *Prng) {
    for u in 0..8 {
        let s = p.state
        for i in 0..12 {
            s[4 + i] = p.key[i]
        }
        s[14] ^= u32(p.counter)
        s[15] ^= u32(p.counter >> 32)
        aead.chacha20_state(s, p.block)
        p.counter += 1
        for v in 0..16 {
            for k in 0..4 {
                p.buf[(u << 2) + (v << 5) + k] = p.block[(v << 2) + k]
            }
        }
    }
    p.at = 0
}

fn next_u64(p: *Prng) -> u64 {
    if p.at >= p.buf.len - 9 {
        p.refill()
    }
    let u = p.at
    p.at = u + 8
    io.u64_le(p.buf, u)
}

fn next_u8(p: *Prng) -> u32 {
    let v = u32(p.buf[p.at])
    p.at += 1
    if p.at == p.buf.len {
        p.refill()
    }
    v
}
