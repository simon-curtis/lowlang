import std/crypto/falcon
import std/text

/// Signs a message with the Falcon-512 private key of the NIST known-answer file, first from a fixed seed, which gives the same signature on every run, then twice from fresh randomness, and verifies each signature.
fn main() {
    let f = text.fields(embed("falcon512_kat.txt"))
    let level = falcon.Level.Falcon512
    let public = text.decode_hex(f[0]) or return
    let private = text.decode_hex(f[3]) or return
    let message = bytes("attack at dawn")
    print("private key {private.len} bytes")

    let seed = bytes("a fixed 48-byte seed gives the same signature...")
    let fixed = falcon.sign(level, private, message, Given(seed)) or return
    print("signature from a fixed seed: {fixed.len} bytes, starting {text.encode_hex(fixed[..12])}")
    print("valid: {falcon.verify(level, public, message, fixed)}")
    print("valid for another message: {falcon.verify(level, public, bytes("attack at dusk"), fixed)}")

    let a = falcon.sign(level, private, message, Hedged) or return
    let b = falcon.sign(level, private, message, Hedged) or return
    print("hedged signatures valid: {falcon.verify(level, public, message, a) && falcon.verify(level, public, message, b)}")
    print("hedged signatures equal: {text.encode_hex(a) == text.encode_hex(b)}")

    let refused = falcon.sign(level, private[..100], message, Hedged) catch {
        e => bytes("truncated private key: {e}")
    }
    print(str(refused))
}
