import std/crypto/falcon
import std/slices
import std/text

/// Verifies a Falcon-512 signature from the NIST known-answer file, then shows what a changed message, signature, padding or key does.
fn main() {
    let f = text.fields(embed("falcon512_kat.txt"))
    let level = falcon.Level.Falcon512
    let public = text.decode_hex(f[0]) or return
    let message = text.decode_hex(f[1]) or return
    let signature = text.decode_hex(f[2]) or return
    print("public key {public.len} bytes, signature {signature.len} bytes, padded signature {falcon.signature_size(level)} bytes")
    print("valid: {falcon.verify(level, public, message, signature)}")

    var padded = slices.clone(signature)
    for padded.len < falcon.signature_size(level) {
        padded.push(0)
    }
    print("padded: {falcon.verify(level, public, message, padded)}")
    padded[padded.len - 1] = 1
    print("padded with a non-zero byte: {falcon.verify(level, public, message, padded)}")

    var other = slices.clone(message)
    other[0] ^= 1
    print("other message: {falcon.verify(level, public, other, signature)}")

    var corrupted = slices.clone(signature)
    corrupted[100] ^= 1
    print("corrupted signature: {falcon.verify(level, public, message, corrupted)}")
    print("truncated signature: {falcon.verify(level, public, message, signature[..100])}")

    var changed = slices.clone(public)
    changed[10] ^= 1
    print("corrupted public key: {falcon.verify(level, changed, message, signature)}")
    print("as Falcon-1024: {falcon.verify(falcon.Level.Falcon1024, public, message, signature)}")
}
