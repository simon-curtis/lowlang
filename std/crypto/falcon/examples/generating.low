import std/crypto/falcon
import std/text

/// Derives a Falcon-512 key pair from a fixed 48-byte seed, which gives the same keys on every run, signs a message with it and verifies the signature, then makes a fresh key pair from `crypto.random` and shows that it does not verify the first signature.
fn main() {
    let level = falcon.Level.Falcon512
    let seed = bytes("forty-eight bytes of seed derive one key pair...")
    let keys = falcon.generate_seeded(level, seed) or return
    print("public key {keys.public.len} bytes, starting {text.encode_hex(keys.public[..12])}")
    print("private key {keys.private.len} bytes, starting {text.encode_hex(keys.private[..12])}")

    let message = bytes("attack at dawn")
    let signature = falcon.sign(level, keys.private, message, Hedged) or return
    print("signature {signature.len} bytes, valid: {falcon.verify(level, keys.public, message, signature)}")

    let other = falcon.generate(level)
    print("valid under a fresh key pair: {falcon.verify(level, other.public, message, signature)}")

    let refused = falcon.generate_seeded(level, seed[..32]) catch {
        e => falcon.Keys { seed: [], public: bytes("32-byte seed: {e}"), private: [] }
    }
    print(str(refused.public))
}
