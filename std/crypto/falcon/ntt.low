import std/slices

fn power(base: i64, exponent: i64) -> i64 {
    var result = 1
    var b = base % q
    var e = exponent
    for e > 0 {
        if e & 1 == 1 {
            result = result * b % q
        }
        b = b * b % q
        e >>= 1
    }
    result
}

fn generator() -> i64 {
    var g = 2
    for power(g, 6144) == 1 || power(g, 4096) == 1 {
        g += 1
    }
    g
}

fn bit_reverse(a: i64[]) {
    let n = a.len
    var j = 0
    for i in 1..n {
        var bit = n >> 1
        for j & bit != 0 {
            j ^= bit
            bit >>= 1
        }
        j ^= bit
        if i < j {
            let t = a[i]
            a[i] = a[j]
            a[j] = t
        }
    }
}

fn cyclic(a: i64[], omega: i64) {
    let n = a.len
    bit_reverse(a)
    var len = 2
    for len <= n {
        let step = power(omega, n / len)
        let half = len / 2
        var start = 0
        for start < n {
            var w = 1
            for j in 0..half {
                let u = a[start + j]
                let v = a[start + j + half] * w % q
                a[start + j] = (u + v) % q
                a[start + j + half] = (u - v + q) % q
                w = w * step % q
            }
            start += len
        }
        len <<= 1
    }
}

fn twist(a: i64[], factor: i64) {
    var w = 1
    for i in 0..a.len {
        a[i] = a[i] * w % q
        w = w * factor % q
    }
}

fn negacyclic_multiply(a: i64[], b: i64[]) -> i64[] {
    let n = a.len
    let psi = power(generator(), (q - 1) / (2 * n))
    let omega = psi * psi % q
    let x = slices.clone(a)
    let y = slices.clone(b)
    twist(x, psi)
    twist(y, psi)
    cyclic(x, omega)
    cyclic(y, omega)
    for i in 0..n {
        x[i] = x[i] * y[i] % q
    }
    cyclic(x, power(omega, n - 1))
    twist(x, power(psi, 2 * n - 1))
    let n_inverse = power(n, q - 2)
    for i in 0..n {
        x[i] = x[i] * n_inverse % q
    }
    x
}
