import std/crypto/sha3
import std/io

fn max_bl_small(depth: i64) -> i64 {
    let t: i64[] = [1, 1, 2, 2, 4, 7, 14, 27, 53, 106, 209]
    t[depth]
}

fn max_bl_large(depth: i64) -> i64 {
    let t: i64[] = [2, 2, 5, 7, 12, 21, 40, 78, 157, 308]
    t[depth]
}

fn bitlength_avg(depth: i64) -> i64 {
    let t: i64[] = [4, 11, 24, 50, 102, 202, 401, 794, 1577, 3138, 6308]
    t[depth]
}

fn bitlength_std(depth: i64) -> i64 {
    let t: i64[] = [0, 1, 1, 1, 1, 2, 4, 5, 8, 13, 25]
    t[depth]
}

const depth_int_fg = 4

fn rng_u64(rng: *sha3.Shake) -> u64 {
    io.u64_le(sha3.squeeze(rng, 8), 0)
}

fn mkgauss(rng: *sha3.Shake, log_n: i64) -> i64 {
    let table: u64[] = [
        1283868770400643928, 6416574995475331444, 4078260278032692663,
        2353523259288686585, 1227179971273316331, 575931623374121527,
        242543240509105209, 91437049221049666, 30799446349977173,
        9255276791179340, 2478152334826140, 590642893610164,
        125206034929641, 23590435911403, 3948334035941,
        586753615614, 77391054539, 9056793210,
        940121950, 86539696, 7062824,
        510971, 32764, 1862,
        94, 4, 0
    ]
    let g = 1 << (10 - log_n)
    var val = 0
    for _ in 0..g {
        var r = rng_u64(rng)
        let neg = u32(r >> 63)
        r &= ~(u64(1) << 63)
        var f = u32((r - table[0]) >> 63)
        var v: u32 = 0
        r = rng_u64(rng)
        r &= ~(u64(1) << 63)
        for k in 1..table.len {
            let t = u32((r - table[k]) >> 63) ^ 1
            v |= u32(k) & (0 - (t & (f ^ 1)))
            f |= t
        }
        v = (v ^ (0 - neg)) + neg
        val += i64(i32(v))
    }
    val
}

fn poly_small_sqnorm(f: i64[]) -> u32 {
    var s: u32 = 0
    var ng: u32 = 0
    for z in f {
        s += u32(z * z)
        ng |= s
    }
    s | (0 - (ng >> 31))
}

fn poly_small_to_fp(x: f64[], f: i64[]) {
    for u in 0..f.len {
        x[u] = f64(f[u])
    }
}

fn half_product(dst: u32[], stride: i64, t1: u32[], hn: i64, p: u32, p0i: u32, r2: u32) {
    for v in 0..hn {
        let w0 = t1[v << 1]
        let w1 = t1[(v << 1) + 1]
        dst[v * stride] = modp_montymul(modp_montymul(w0, w1, p, p0i), r2, p, p0i)
    }
}

fn make_fg_step(data: u32[], log_n: i64, depth: i64, in_ntt: bool, out_ntt: bool) {
    let n = 1 << log_n
    let hn = n >> 1
    let slen = max_bl_small(depth)
    let tlen = max_bl_small(depth + 1)
    let primes = small_primes()
    let fd = 0
    let gd = fd + hn * tlen
    let fs = gd + hn * tlen
    let gs = fs + n * slen
    let gm: u32[] = __make(n)
    let igm: u32[] = __make(n)
    let t1: u32[] = __make(if n > slen { n } else { slen })
    __memmove(data[fs..], data[..2 * n * slen])
    for u in 0..slen {
        let p = primes[3 * u]
        let p0i = modp_ninv31(p)
        let r2 = modp_r2(p, p0i)
        modp_mkgm2(gm, igm, log_n, primes[3 * u + 1], p, p0i)
        for v in 0..n {
            t1[v] = data[fs + u + v * slen]
        }
        if !in_ntt {
            modp_ntt2(t1, gm, log_n, p, p0i)
        }
        half_product(data[fd + u..], tlen, t1, hn, p, p0i, r2)
        if in_ntt {
            modp_intt2_ext(data[fs + u..], slen, igm, log_n, p, p0i)
        }
        for v in 0..n {
            t1[v] = data[gs + u + v * slen]
        }
        if !in_ntt {
            modp_ntt2(t1, gm, log_n, p, p0i)
        }
        half_product(data[gd + u..], tlen, t1, hn, p, p0i, r2)
        if in_ntt {
            modp_intt2_ext(data[gs + u..], slen, igm, log_n, p, p0i)
        }
        if !out_ntt {
            modp_intt2_ext(data[fd + u..], tlen, igm, log_n - 1, p, p0i)
            modp_intt2_ext(data[gd + u..], tlen, igm, log_n - 1, p, p0i)
        }
    }
    zint_rebuild_crt(data[fs..], slen, slen, n, true, t1)
    zint_rebuild_crt(data[gs..], slen, slen, n, true, t1)
    for u in slen..tlen {
        let p = primes[3 * u]
        let p0i = modp_ninv31(p)
        let r2 = modp_r2(p, p0i)
        let rx = modp_rx(u32(slen), p, p0i, r2)
        modp_mkgm2(gm, igm, log_n, primes[3 * u + 1], p, p0i)
        for v in 0..n {
            t1[v] = zint_mod_small_signed(data[fs + v * slen..], slen, p, p0i, r2, rx)
        }
        modp_ntt2(t1, gm, log_n, p, p0i)
        half_product(data[fd + u..], tlen, t1, hn, p, p0i, r2)
        for v in 0..n {
            t1[v] = zint_mod_small_signed(data[gs + v * slen..], slen, p, p0i, r2, rx)
        }
        modp_ntt2(t1, gm, log_n, p, p0i)
        half_product(data[gd + u..], tlen, t1, hn, p, p0i, r2)
        if !out_ntt {
            modp_intt2_ext(data[fd + u..], tlen, igm, log_n - 1, p, p0i)
            modp_intt2_ext(data[gd + u..], tlen, igm, log_n - 1, p, p0i)
        }
    }
}

fn make_fg(data: u32[], f: i64[], g: i64[], log_n: i64, depth: i64, out_ntt: bool) {
    let n = 1 << log_n
    let primes = small_primes()
    let p = primes[0]
    for u in 0..n {
        data[u] = modp_set(f[u], p)
        data[n + u] = modp_set(g[u], p)
    }
    if depth == 0 && out_ntt {
        let p0i = modp_ninv31(p)
        let gm: u32[] = __make(n)
        let igm: u32[] = __make(n)
        modp_mkgm2(gm, igm, log_n, primes[1], p, p0i)
        modp_ntt2(data, gm, log_n, p, p0i)
        modp_ntt2(data[n..], gm, log_n, p, p0i)
        return
    }
    for d in 0..depth {
        make_fg_step(data, log_n - d, d, d != 0, d + 1 < depth || out_ntt)
    }
}

fn solve_ntru_deepest(log_n_top: i64, f: i64[], g: i64[], tmp: u32[]) -> bool {
    let len = max_bl_small(log_n_top)
    let fp = 2 * len
    make_fg(tmp[fp..], f, g, log_n_top, log_n_top, false)
    let t1: u32[] = __make(len)
    zint_rebuild_crt(tmp[fp..], len, len, 2, false, t1)
    if !zint_bezout(tmp[len..], tmp, tmp[fp..], tmp[fp + len..], len) {
        return false
    }
    zint_mul_small(tmp, len, 12289) == 0 && zint_mul_small(tmp[len..], len, 12289) == 0
}

fn power_of_half(dc: i64) -> f64 {
    var e = dc
    var pt = 0.5
    if e < 0 {
        e = -e
        pt = 2.0
    }
    var pdc = 1.0
    for e != 0 {
        if (e & 1) != 0 {
            pdc = pdc * pt
        }
        e >>= 1
        pt = pt * pt
    }
    pdc
}

fn reduce_residues(dst: u32[], src: u32[], count: i64, src_stride: i64, dst_stride: i64, len: i64, p: u32, p0i: u32, r2: u32, rx: u32) {
    for v in 0..count {
        dst[v * dst_stride] = zint_mod_small_signed(src[v * src_stride..], len, p, p0i, r2, rx)
    }
}

fn solve_ntru_intermediate(gm_fft: f64[], log_n_top: i64, f: i64[], g: i64[], depth: i64, tmp: u32[]) -> bool {
    let log_n = log_n_top - depth
    let n = 1 << log_n
    let hn = n >> 1
    let slen = max_bl_small(depth)
    let dlen = max_bl_small(depth + 1)
    let llen = max_bl_large(depth)
    let primes = small_primes()
    make_fg(tmp[2 * dlen * hn..], f, g, log_n_top, depth, true)
    let big_ft = 0
    let big_gt = n * llen
    let ft = 2 * n * llen
    __memmove(tmp[ft..], tmp[2 * dlen * hn..2 * dlen * hn + 2 * n * slen])
    let gt = ft + slen * n
    let fd = gt + slen * n
    __memmove(tmp[fd..], tmp[..2 * hn * dlen])
    let gd = fd + hn * dlen
    for u in 0..llen {
        let p = primes[3 * u]
        let p0i = modp_ninv31(p)
        let r2 = modp_r2(p, p0i)
        let rx = modp_rx(u32(dlen), p, p0i, r2)
        reduce_residues(tmp[big_ft + u..], tmp[fd..], hn, dlen, llen, dlen, p, p0i, r2, rx)
        reduce_residues(tmp[big_gt + u..], tmp[gd..], hn, dlen, llen, dlen, p, p0i, r2, rx)
    }
    let gm: u32[] = __make(n)
    let igm: u32[] = __make(n)
    let fx: u32[] = __make(n)
    let gx: u32[] = __make(n)
    let fp: u32[] = __make(hn)
    let gp: u32[] = __make(hn)
    let crt: u32[] = __make(llen)
    for u in 0..llen {
        let p = primes[3 * u]
        let p0i = modp_ninv31(p)
        let r2 = modp_r2(p, p0i)
        if u == slen {
            zint_rebuild_crt(tmp[ft..], slen, slen, n, true, crt)
            zint_rebuild_crt(tmp[gt..], slen, slen, n, true, crt)
        }
        modp_mkgm2(gm, igm, log_n, primes[3 * u + 1], p, p0i)
        if u < slen {
            for v in 0..n {
                fx[v] = tmp[ft + u + v * slen]
                gx[v] = tmp[gt + u + v * slen]
            }
            modp_intt2_ext(tmp[ft + u..], slen, igm, log_n, p, p0i)
            modp_intt2_ext(tmp[gt + u..], slen, igm, log_n, p, p0i)
        } else {
            let rx = modp_rx(u32(slen), p, p0i, r2)
            reduce_residues(fx, tmp[ft..], n, slen, 1, slen, p, p0i, r2, rx)
            reduce_residues(gx, tmp[gt..], n, slen, 1, slen, p, p0i, r2, rx)
            modp_ntt2(fx, gm, log_n, p, p0i)
            modp_ntt2(gx, gm, log_n, p, p0i)
        }
        for v in 0..hn {
            fp[v] = tmp[big_ft + u + v * llen]
            gp[v] = tmp[big_gt + u + v * llen]
        }
        modp_ntt2(fp, gm, log_n - 1, p, p0i)
        modp_ntt2(gp, gm, log_n - 1, p, p0i)
        for v in 0..hn {
            let x = big_ft + u + v * (llen << 1)
            let y = big_gt + u + v * (llen << 1)
            let m_fp = modp_montymul(fp[v], r2, p, p0i)
            let m_gp = modp_montymul(gp[v], r2, p, p0i)
            tmp[x] = modp_montymul(gx[(v << 1) + 1], m_fp, p, p0i)
            tmp[x + llen] = modp_montymul(gx[v << 1], m_fp, p, p0i)
            tmp[y] = modp_montymul(fx[(v << 1) + 1], m_gp, p, p0i)
            tmp[y + llen] = modp_montymul(fx[v << 1], m_gp, p, p0i)
        }
        modp_intt2_ext(tmp[big_ft + u..], llen, igm, log_n, p, p0i)
        modp_intt2_ext(tmp[big_gt + u..], llen, igm, log_n, p, p0i)
    }
    zint_rebuild_crt(tmp[big_ft..], llen, llen, n, true, crt)
    zint_rebuild_crt(tmp[big_gt..], llen, llen, n, true, crt)
    let rt1: f64[] = __make(n)
    let rt2: f64[] = __make(n)
    let rt3: f64[] = __make(n)
    let rt4: f64[] = __make(n)
    let rt5: f64[] = __make(hn)
    let k: i64[] = __make(n)
    var rlen = if slen > 10 { 10 } else { slen }
    poly_big_to_fp(rt3, tmp[ft + slen - rlen..], rlen, slen, log_n)
    poly_big_to_fp(rt4, tmp[gt + slen - rlen..], rlen, slen, log_n)
    let scale_fg = 31 * (slen - rlen)
    let minbl_fg = bitlength_avg(depth) - 6 * bitlength_std(depth)
    let maxbl_fg = bitlength_avg(depth) + 6 * bitlength_std(depth)
    fft(gm_fft, rt3, log_n)
    fft(gm_fft, rt4, log_n)
    poly_invnorm2_fft(rt5, rt3, rt4, n)
    poly_adj_fft(rt3, n)
    poly_adj_fft(rt4, n)
    var fg_len = llen
    var maxbl_big_fg = 31 * llen
    var scale_k = maxbl_big_fg - minbl_fg
    for true {
        rlen = if fg_len > 10 { 10 } else { fg_len }
        let scale_big_fg = 31 * (fg_len - rlen)
        poly_big_to_fp(rt1, tmp[big_ft + fg_len - rlen..], rlen, llen, log_n)
        poly_big_to_fp(rt2, tmp[big_gt + fg_len - rlen..], rlen, llen, log_n)
        fft(gm_fft, rt1, log_n)
        fft(gm_fft, rt2, log_n)
        poly_mul_fft(rt1, rt3, n)
        poly_mul_fft(rt2, rt4, n)
        poly_add(rt2, rt1, n)
        poly_mul_autoadj_fft(rt2, rt5, n)
        inverse_fft(gm_fft, rt2, log_n)
        let pdc = power_of_half(scale_k - scale_big_fg + scale_fg)
        for u in 0..n {
            let xv = rt2[u] * pdc
            if !(-2147483647.0 < xv) || !(xv < 2147483647.0) {
                return false
            }
            k[u] = rint(xv)
        }
        let sch = scale_k / 31
        let scl = u32(scale_k % 31)
        if depth <= depth_int_fg {
            poly_sub_scaled_ntt(tmp[big_ft..], fg_len, llen, tmp[ft..], slen, slen, k, sch, scl, log_n)
            poly_sub_scaled_ntt(tmp[big_gt..], fg_len, llen, tmp[gt..], slen, slen, k, sch, scl, log_n)
        } else {
            poly_sub_scaled(tmp[big_ft..], fg_len, llen, tmp[ft..], slen, slen, k, sch, scl, log_n)
            poly_sub_scaled(tmp[big_gt..], fg_len, llen, tmp[gt..], slen, slen, k, sch, scl, log_n)
        }
        let new_maxbl = scale_k + maxbl_fg + 10
        if new_maxbl < maxbl_big_fg {
            maxbl_big_fg = new_maxbl
            if fg_len * 31 >= maxbl_big_fg + 31 {
                fg_len -= 1
            }
        }
        if scale_k <= 0 {
            break
        }
        scale_k -= 25
        if scale_k < 0 {
            scale_k = 0
        }
    }
    if fg_len < slen {
        for u in 0..n {
            sign_extend(tmp[big_ft + u * llen..], fg_len, slen)
            sign_extend(tmp[big_gt + u * llen..], fg_len, slen)
        }
    }
    for u in 0..n << 1 {
        __memmove(tmp[u * slen..], tmp[u * llen..u * llen + slen])
    }
    true
}

fn sign_extend(x: u32[], from: i64, to: i64) {
    let sw = (0 - (x[from - 1] >> 30)) >> 1
    for v in from..to {
        x[v] = sw
    }
}

fn solve_ntru_binary_depth1(gm_fft: f64[], log_n_top: i64, f: i64[], g: i64[], tmp: u32[]) -> bool {
    let depth = 1
    let n_top = 1 << log_n_top
    let log_n = log_n_top - depth
    let n = 1 << log_n
    let hn = n >> 1
    let slen = max_bl_small(depth)
    let dlen = max_bl_small(depth + 1)
    let llen = max_bl_large(depth)
    let primes = small_primes()
    let fd = 0
    let gd = fd + dlen * hn
    let ft0 = gd + dlen * hn
    let gt0 = ft0 + llen * n
    for u in 0..llen {
        let p = primes[3 * u]
        let p0i = modp_ninv31(p)
        let r2 = modp_r2(p, p0i)
        let rx = modp_rx(u32(dlen), p, p0i, r2)
        reduce_residues(tmp[ft0 + u..], tmp[fd..], hn, dlen, llen, dlen, p, p0i, r2, rx)
        reduce_residues(tmp[gt0 + u..], tmp[gd..], hn, dlen, llen, dlen, p, p0i, r2, rx)
    }
    __memmove(tmp, tmp[ft0..ft0 + llen * n])
    __memmove(tmp[llen * n..], tmp[gt0..gt0 + llen * n])
    let big_ft = 0
    let big_gt = llen * n
    let ft = big_gt + llen * n
    let gt = ft + slen * n
    let gm: u32[] = __make(n_top)
    let igm: u32[] = __make(n_top)
    let fx: u32[] = __make(n_top)
    let gx: u32[] = __make(n_top)
    let fp: u32[] = __make(hn)
    let gp: u32[] = __make(hn)
    for u in 0..llen {
        let p = primes[3 * u]
        let p0i = modp_ninv31(p)
        let r2 = modp_r2(p, p0i)
        modp_mkgm2(gm, igm, log_n_top, primes[3 * u + 1], p, p0i)
        for v in 0..n_top {
            fx[v] = modp_set(f[v], p)
            gx[v] = modp_set(g[v], p)
        }
        modp_ntt2(fx, gm, log_n_top, p, p0i)
        modp_ntt2(gx, gm, log_n_top, p, p0i)
        var e = log_n_top
        for e > log_n {
            modp_poly_rec_res(fx, e, p, p0i, r2)
            modp_poly_rec_res(gx, e, p, p0i, r2)
            e -= 1
        }
        for v in 0..hn {
            fp[v] = tmp[big_ft + u + v * llen]
            gp[v] = tmp[big_gt + u + v * llen]
        }
        modp_ntt2(fp, gm, log_n - 1, p, p0i)
        modp_ntt2(gp, gm, log_n - 1, p, p0i)
        for v in 0..hn {
            let x = big_ft + u + v * (llen << 1)
            let y = big_gt + u + v * (llen << 1)
            let m_fp = modp_montymul(fp[v], r2, p, p0i)
            let m_gp = modp_montymul(gp[v], r2, p, p0i)
            tmp[x] = modp_montymul(gx[(v << 1) + 1], m_fp, p, p0i)
            tmp[x + llen] = modp_montymul(gx[v << 1], m_fp, p, p0i)
            tmp[y] = modp_montymul(fx[(v << 1) + 1], m_gp, p, p0i)
            tmp[y + llen] = modp_montymul(fx[v << 1], m_gp, p, p0i)
        }
        modp_intt2_ext(tmp[big_ft + u..], llen, igm, log_n, p, p0i)
        modp_intt2_ext(tmp[big_gt + u..], llen, igm, log_n, p, p0i)
        if u < slen {
            modp_intt2(fx, igm, log_n, p, p0i)
            modp_intt2(gx, igm, log_n, p, p0i)
            for v in 0..n {
                tmp[ft + u + v * slen] = fx[v]
                tmp[gt + u + v * slen] = gx[v]
            }
        }
    }
    let crt: u32[] = __make(llen)
    zint_rebuild_crt(tmp[big_ft..], llen, llen, n << 1, true, crt)
    zint_rebuild_crt(tmp[ft..], slen, slen, n << 1, true, crt)
    let rt1: f64[] = __make(n)
    let rt2: f64[] = __make(n)
    let rt3: f64[] = __make(n)
    let rt4: f64[] = __make(n)
    let rt5: f64[] = __make(n)
    let rt6: f64[] = __make(n)
    poly_big_to_fp(rt1, tmp[big_ft..], llen, llen, log_n)
    poly_big_to_fp(rt2, tmp[big_gt..], llen, llen, log_n)
    poly_big_to_fp(rt3, tmp[ft..], slen, slen, log_n)
    poly_big_to_fp(rt4, tmp[gt..], slen, slen, log_n)
    fft(gm_fft, rt1, log_n)
    fft(gm_fft, rt2, log_n)
    fft(gm_fft, rt3, log_n)
    fft(gm_fft, rt4, log_n)
    poly_add_muladj_fft(rt5, rt1, rt2, rt3, rt4, n)
    poly_invnorm2_fft(rt6, rt3, rt4, n)
    poly_mul_autoadj_fft(rt5, rt6, n)
    inverse_fft(gm_fft, rt5, log_n)
    for u in 0..n {
        let z = rt5[u]
        if !(z < two_63) || !(-two_63 < z) {
            return false
        }
        rt5[u] = f64(rint(z))
    }
    fft(gm_fft, rt5, log_n)
    poly_mul_fft(rt3, rt5, n)
    poly_mul_fft(rt4, rt5, n)
    poly_sub(rt1, rt3, n)
    poly_sub(rt2, rt4, n)
    inverse_fft(gm_fft, rt1, log_n)
    inverse_fft(gm_fft, rt2, log_n)
    for u in 0..n {
        tmp[u] = u32(rint(rt1[u]))
        tmp[n + u] = u32(rint(rt2[u]))
    }
    true
}

fn set_and_adjoint(t4: u32[], t5: u32[], f: i64[], p: u32) {
    let n = f.len
    t4[0] = modp_set(f[0], p)
    t5[0] = t4[0]
    for u in 1..n {
        t4[u] = modp_set(f[u], p)
        t5[n - u] = modp_set(-f[u], p)
    }
}

fn solve_ntru_binary_depth0(gm_fft: f64[], log_n: i64, f: i64[], g: i64[], tmp: u32[]) -> bool {
    let n = 1 << log_n
    let hn = n >> 1
    let primes = small_primes()
    let p = primes[0]
    let p0i = modp_ninv31(p)
    let r2 = modp_r2(p, p0i)
    let gm: u32[] = __make(n)
    let igm: u32[] = __make(n)
    modp_mkgm2(gm, igm, log_n, primes[1], p, p0i)
    let fp = tmp[..hn]
    let gp = tmp[hn..n]
    for u in 0..hn {
        fp[u] = modp_set(zint_one_to_plain(fp[u..]), p)
        gp[u] = modp_set(zint_one_to_plain(gp[u..]), p)
    }
    modp_ntt2(fp, gm, log_n - 1, p, p0i)
    modp_ntt2(gp, gm, log_n - 1, p, p0i)
    let ft: u32[] = __make(n)
    let gt: u32[] = __make(n)
    for u in 0..n {
        ft[u] = modp_set(f[u], p)
        gt[u] = modp_set(g[u], p)
    }
    modp_ntt2(ft, gm, log_n, p, p0i)
    modp_ntt2(gt, gm, log_n, p, p0i)
    var u = 0
    for u < n {
        let ft_a = ft[u]
        let ft_b = ft[u + 1]
        let gt_a = gt[u]
        let gt_b = gt[u + 1]
        let m_fp = modp_montymul(fp[u >> 1], r2, p, p0i)
        let m_gp = modp_montymul(gp[u >> 1], r2, p, p0i)
        ft[u] = modp_montymul(gt_b, m_fp, p, p0i)
        ft[u + 1] = modp_montymul(gt_a, m_fp, p, p0i)
        gt[u] = modp_montymul(ft_b, m_gp, p, p0i)
        gt[u + 1] = modp_montymul(ft_a, m_gp, p, p0i)
        u += 2
    }
    modp_intt2(ft, igm, log_n, p, p0i)
    modp_intt2(gt, igm, log_n, p, p0i)
    let big_fp = tmp[..n]
    let big_gp = tmp[n..2 * n]
    __memmove(big_fp, ft)
    __memmove(big_gp, gt)
    let t1: u32[] = __make(n)
    let t2: u32[] = __make(n)
    let t3: u32[] = __make(n)
    let t4: u32[] = __make(n)
    let t5: u32[] = __make(n)
    modp_ntt2(big_fp, gm, log_n, p, p0i)
    modp_ntt2(big_gp, gm, log_n, p, p0i)
    set_and_adjoint(t4, t5, f, p)
    modp_ntt2(t4, gm, log_n, p, p0i)
    modp_ntt2(t5, gm, log_n, p, p0i)
    for v in 0..n {
        let w = modp_montymul(t5[v], r2, p, p0i)
        t2[v] = modp_montymul(w, big_fp[v], p, p0i)
        t3[v] = modp_montymul(w, t4[v], p, p0i)
    }
    set_and_adjoint(t4, t5, g, p)
    modp_ntt2(t4, gm, log_n, p, p0i)
    modp_ntt2(t5, gm, log_n, p, p0i)
    for v in 0..n {
        let w = modp_montymul(t5[v], r2, p, p0i)
        t2[v] = modp_add(t2[v], modp_montymul(w, big_gp[v], p, p0i), p)
        t3[v] = modp_add(t3[v], modp_montymul(w, t4[v], p, p0i), p)
    }
    modp_intt2(t2, igm, log_n, p, p0i)
    modp_intt2(t3, igm, log_n, p, p0i)
    let num: f64[] = __make(n)
    let den: f64[] = __make(n)
    for v in 0..n {
        num[v] = f64(modp_norm(t2[v], p))
        den[v] = f64(modp_norm(t3[v], p))
    }
    fft(gm_fft, den, log_n)
    fft(gm_fft, num, log_n)
    poly_div_autoadj_fft(num, den, n)
    inverse_fft(gm_fft, num, log_n)
    for v in 0..n {
        t1[v] = modp_set(rint(num[v]), p)
        t4[v] = modp_set(f[v], p)
        t5[v] = modp_set(g[v], p)
    }
    modp_ntt2(t1, gm, log_n, p, p0i)
    modp_ntt2(t4, gm, log_n, p, p0i)
    modp_ntt2(t5, gm, log_n, p, p0i)
    for v in 0..n {
        let kw = modp_montymul(t1[v], r2, p, p0i)
        big_fp[v] = modp_sub(big_fp[v], modp_montymul(kw, t4[v], p, p0i), p)
        big_gp[v] = modp_sub(big_gp[v], modp_montymul(kw, t5[v], p, p0i), p)
    }
    modp_intt2(big_fp, igm, log_n, p, p0i)
    modp_intt2(big_gp, igm, log_n, p, p0i)
    for v in 0..n {
        big_fp[v] = u32(modp_norm(big_fp[v], p))
        big_gp[v] = u32(modp_norm(big_gp[v], p))
    }
    true
}

fn solve_ntru(gm_fft: f64[], log_n: i64, big_f: i64[], big_g: i64[], f: i64[], g: i64[], lim: i64) -> bool {
    let n = 1 << log_n
    let tmp: u32[] = __make(8 * n)
    if !solve_ntru_deepest(log_n, f, g, tmp) {
        return false
    }
    var depth = log_n
    for depth > 2 {
        depth -= 1
        if !solve_ntru_intermediate(gm_fft, log_n, f, g, depth, tmp) {
            return false
        }
    }
    if !solve_ntru_binary_depth1(gm_fft, log_n, f, g, tmp) || !solve_ntru_binary_depth0(gm_fft, log_n, f, g, tmp) {
        return false
    }
    if !poly_big_to_small(big_f, tmp, lim, log_n) || !poly_big_to_small(big_g, tmp[n..], lim, log_n) {
        return false
    }
    let primes = small_primes()
    let p = primes[0]
    let p0i = modp_ninv31(p)
    let gm: u32[] = __make(n)
    let igm: u32[] = __make(n)
    modp_mkgm2(gm, igm, log_n, primes[1], p, p0i)
    let ft: u32[] = __make(n)
    let gt: u32[] = __make(n)
    let big_ft: u32[] = __make(n)
    let big_gt: u32[] = __make(n)
    for u in 0..n {
        big_gt[u] = modp_set(big_g[u], p)
        ft[u] = modp_set(f[u], p)
        gt[u] = modp_set(g[u], p)
        big_ft[u] = modp_set(big_f[u], p)
    }
    modp_ntt2(ft, gm, log_n, p, p0i)
    modp_ntt2(gt, gm, log_n, p, p0i)
    modp_ntt2(big_ft, gm, log_n, p, p0i)
    modp_ntt2(big_gt, gm, log_n, p, p0i)
    let r = modp_montymul(12289, 1, p, p0i)
    for u in 0..n {
        let z = modp_sub(modp_montymul(ft[u], big_gt[u], p, p0i), modp_montymul(gt[u], big_ft[u], p, p0i), p)
        if z != r {
            return false
        }
    }
    true
}

fn poly_small_mkgauss(rng: *sha3.Shake, f: i64[], log_n: i64) {
    let n = f.len
    var mod2: i64 = 0
    var u = 0
    for u < n {
        let s = mkgauss(rng, log_n)
        if s < -127 || s > 127 {
            continue
        }
        if u == n - 1 {
            if (mod2 ^ (s & 1)) == 0 {
                continue
            }
        } else {
            mod2 ^= s & 1
        }
        f[u] = s
        u += 1
    }
}

struct Generated {
    basis: Basis
    h: i64[]
}

fn compute_public(f: i64[], g: i64[]) -> i64[]? {
    let t = transform(f.len)
    let h = forward(t, residues(g))
    let d = forward(t, residues(f))
    for i in 0..h.len {
        if d[i] == 0 {
            return none
        }
        h[i] = h[i] * power(d[i], q - 2) % q
    }
    backward(t, h)
    h
}

fn within(x: i64[], lim: i64) -> bool {
    for v in x {
        if v >= lim || v <= -lim {
            return false
        }
    }
    true
}

fn orthogonal_norm_small(gm: f64[], f: i64[], g: i64[], log_n: i64) -> bool {
    let n = f.len
    let rt1: f64[] = __make(n)
    let rt2: f64[] = __make(n)
    let rt3: f64[] = __make(n >> 1)
    poly_small_to_fp(rt1, f)
    poly_small_to_fp(rt2, g)
    fft(gm, rt1, log_n)
    fft(gm, rt2, log_n)
    poly_invnorm2_fft(rt3, rt1, rt2, n)
    poly_adj_fft(rt1, n)
    poly_adj_fft(rt2, n)
    poly_mulconst(rt1, 12289.0, n)
    poly_mulconst(rt2, 12289.0, n)
    poly_mul_autoadj_fft(rt1, rt3, n)
    poly_mul_autoadj_fft(rt2, rt3, n)
    inverse_fft(gm, rt1, log_n)
    inverse_fft(gm, rt2, log_n)
    var bnorm = 0.0
    for u in 0..n {
        bnorm = bnorm + rt1[u] * rt1[u]
        bnorm = bnorm + rt2[u] * rt2[u]
    }
    bnorm < 16822.4121
}

fn generate_key(s: Shape, rng: *sha3.Shake) -> Generated {
    let log_n = s.log_n
    let n = 1 << log_n
    let gm = fft_roots()
    for true {
        let f: i64[] = __make(n)
        let g: i64[] = __make(n)
        poly_small_mkgauss(rng, f, log_n)
        poly_small_mkgauss(rng, g, log_n)
        let lim = 1 << (s.fg_bits - 1)
        if !within(f, lim) || !within(g, lim) {
            continue
        }
        let normf = poly_small_sqnorm(f)
        let normg = poly_small_sqnorm(g)
        let norm = (normf + normg) | (0 - ((normf | normg) >> 31))
        if norm >= 16823 || !orthogonal_norm_small(gm, f, g, log_n) {
            continue
        }
        let h = compute_public(f, g) ?? continue
        let big_f: i64[] = __make(n)
        let big_g: i64[] = __make(n)
        if solve_ntru(gm, log_n, big_f, big_g, f, g, 127) {
            return Generated { basis: Basis { f, g, big_f, big_g }, h }
        }
    }
    Generated { basis: Basis { f: [], g: [], big_f: [], big_g: [] }, h: [] }
}
