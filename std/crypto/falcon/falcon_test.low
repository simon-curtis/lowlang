import std/slices
import std/testing

fn schoolbook(a: i64[], b: i64[]) -> i64[] {
    let n = a.len
    let out: i64[] = __make(n)
    for i in 0..n {
        for j in 0..n {
            let p = a[i] * b[j] % q
            if i + j < n {
                out[i + j] = (out[i + j] + p) % q
            } else {
                out[i + j - n] = (out[i + j - n] - p + q) % q
            }
        }
    }
    out
}

fn poly(n: i64, seed: i64) -> i64[] {
    let f: i64[] = __make(n)
    var x = seed
    for i in 0..n {
        x = (x * 6364136223846793005 + 1442695040888963407) >> 3 & 0x7fffff
        f[i] = x % q
    }
    f
}

fn compressed_by_bits(x: i64[]) -> u8[] {
    var out: u8[] = []
    var acc = 0
    var acc_len = 0
    for v in x {
        let m = if v < 0 { -v } else { v }
        var bits = [if v < 0 { 1 } else { 0 }]
        for k in 0..7 {
            bits.push(m >> (6 - k) & 1)
        }
        for k in 0..m >> 7 {
            bits.push(0)
        }
        bits.push(1)
        for bit in bits {
            acc = acc << 1 | bit
            acc_len += 1
            if acc_len == 8 {
                out.push(u8(acc))
                acc = 0
                acc_len = 0
            }
        }
    }
    if acc_len > 0 {
        out.push(u8(acc << (8 - acc_len)))
    }
    out
}

fn encode_public(h: i64[]) -> u8[] {
    var out: u8[] = []
    var acc = 0
    var acc_len = 0
    for v in h {
        acc = acc << 14 | v
        acc_len += 14
        for acc_len >= 8 {
            out.push(u8(acc >> (acc_len - 8)))
            acc_len -= 8
            acc &= (1 << acc_len) - 1
        }
    }
    if acc_len > 0 {
        out.push(u8(acc << (8 - acc_len)))
    }
    out
}

fn test_the_transform_multiplies_polynomials(t: *testing.T) {
    for n in [2, 8, 64, 512, 1024] {
        let a = poly(n, 1)
        let b = poly(n, 2)
        t.equal_slice(negacyclic_multiply(a, b), schoolbook(a, b))
    }
}

fn test_the_generator_has_full_order(t: *testing.T) {
    let g = generator()
    t.equal(power(g, q - 1), 1)
    t.require(power(g, 6144) != 1)
    t.require(power(g, 4096) != 1)
}

fn test_compressed_coefficients_round_trip(t: *testing.T) {
    let x: i64[] = [0, 1, -1, 127, -127, 128, -128, 255, 256, -2047, 2047, 0, 5, -300]
    let encoded = compressed_by_bits(x)
    let d = decode_compressed(encoded, x.len) ?? return
    t.equal_slice(d.coefficients, x)
    t.equal(d.length, encoded.len)
}

fn test_a_longer_buffer_reports_the_bytes_used(t: *testing.T) {
    let x: i64[] = [3, -4, 5, 600]
    var encoded = compressed_by_bits(x)
    let used = encoded.len
    encoded.push(0)
    encoded.push(0)
    let d = decode_compressed(encoded, 4) ?? return
    t.equal(d.length, used)
    t.equal_slice(d.coefficients, x)
}

fn test_negative_zero_is_rejected(t: *testing.T) {
    t.is_none(decode_compressed([0x80, 0x80], 1))
    t.is_some(decode_compressed([0x00, 0x80], 1))
}

fn test_a_coefficient_above_2047_is_rejected(t: *testing.T) {
    let long: u8[] = [0x7f, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x80]
    t.is_none(decode_compressed(long, 1))
    let at_limit = compressed_by_bits([2047])
    t.is_some(decode_compressed(at_limit, 1))
    let over = compressed_by_bits([2048])
    t.is_none(decode_compressed(over, 1))
    t.is_none(encode_compressed([2048]))
    t.equal_slice(encode_compressed([2047, -2047, 0, 300]) ?? [], compressed_by_bits([2047, -2047, 0, 300]))
}

fn test_non_zero_bits_after_the_last_coefficient_are_rejected(t: *testing.T) {
    let encoded = compressed_by_bits([5, -6, 7])
    t.is_some(decode_compressed(encoded, 3))
    var dirty = slices.clone(encoded)
    dirty[dirty.len - 1] |= 1
    t.is_none(decode_compressed(dirty, 3))
}

fn test_a_truncated_encoding_is_rejected(t: *testing.T) {
    let encoded = compressed_by_bits([1, 2, 3, 4, 700])
    t.is_none(decode_compressed(encoded[..encoded.len - 1], 5))
    t.is_none(decode_compressed([], 1))
}

fn test_public_keys_round_trip(t: *testing.T) {
    for n in [2, 4, 512] {
        let h = poly(n, 3)
        let encoded = encode_public(h)
        t.equal(encoded.len, (14 * n + 7) / 8)
        let d = decode_public(encoded, n) ?? return
        t.equal_slice(d, h)
    }
}

fn test_public_key_coefficients_must_be_below_the_modulus(t: *testing.T) {
    t.is_some(decode_public(encode_public([q - 1, 0]), 2))
    t.is_none(decode_public(encode_public([q, 0]), 2))
    t.is_none(decode_public(encode_public([0, 16383]), 2))
}

fn test_public_keys_need_the_exact_length_and_zero_padding_bits(t: *testing.T) {
    let encoded = encode_public([5, 6])
    t.equal(encoded.len, 4)
    t.is_none(decode_public(encoded[..3], 2))
    var dirty = slices.clone(encoded)
    dirty[3] |= 1
    t.is_none(decode_public(dirty, 2))
    var longer = slices.clone(encoded)
    longer.push(0)
    t.is_none(decode_public(longer, 2))
}

fn test_the_point_hash_gives_reduced_values(t: *testing.T) {
    let nonce: u8[] = __make(40)
    let c = hash_to_point(nonce, bytes("message"), 512)
    t.equal(c.len, 512)
    for v in c {
        t.require(v >= 0 && v < q)
    }
    let again = hash_to_point(nonce, bytes("message"), 512)
    t.equal_slice(c, again)
    let other = hash_to_point(nonce, bytes("messagf"), 512)
    var differs = false
    for i in 0..512 {
        if c[i] != other[i] {
            differs = true
        }
    }
    t.require(differs)
}

fn test_the_norm_bound_is_strict(t: *testing.T) {
    let s1: i64[] = [3, 0]
    let s2: i64[] = [4, 0]
    t.require(short_enough(s1, s2, 26))
    t.require(!short_enough(s1, s2, 25))
    t.require(short_enough([q - 3, 0], s2, 26))
}

fn test_trimmed_coefficients_decode_and_reject_the_lowest_value(t: *testing.T) {
    let six: i64[] = [1, -1, 31, -31]
    t.equal_slice(decode_trim([0x07, 0xf7, 0xe1], 0, 4, 6) ?? [], six)
    t.is_none(decode_trim([0x80], 0, 1, 6))
    t.is_none(decode_trim([0x05], 0, 1, 6))
    t.equal_slice(decode_trim([0x00, 0x81, 0x7f], 1, 2, 8) ?? [], [-127, 127])
    t.is_none(decode_trim([0x80], 0, 1, 8))
}
