fn fft(gm: f64[], f: f64[], log_n: i64) {
    let n = 1 << log_n
    let hn = n >> 1
    var t = hn
    var m = 2
    for _ in 1..log_n {
        let ht = t >> 1
        let hm = m >> 1
        var j1 = 0
        for i1 in 0..hm {
            let s_re = gm[(m + i1) << 1]
            let s_im = gm[((m + i1) << 1) + 1]
            for j in j1..j1 + ht {
                let x_re = f[j]
                let x_im = f[j + hn]
                let a_re = f[j + ht]
                let a_im = f[j + ht + hn]
                let y_re = a_re * s_re - a_im * s_im
                let y_im = a_re * s_im + a_im * s_re
                f[j] = x_re + y_re
                f[j + hn] = x_im + y_im
                f[j + ht] = x_re - y_re
                f[j + ht + hn] = x_im - y_im
            }
            j1 += t
        }
        t = ht
        m <<= 1
    }
}

fn inverse_fft(gm: f64[], f: f64[], log_n: i64) {
    let n = 1 << log_n
    let hn = n >> 1
    var t = 1
    var m = n
    for _ in 1..log_n {
        let hm = m >> 1
        let dt = t << 1
        var i1 = 0
        var j1 = 0
        for j1 < hn {
            let s_re = gm[(hm + i1) << 1]
            let s_im = -gm[((hm + i1) << 1) + 1]
            for j in j1..j1 + t {
                let x_re = f[j]
                let x_im = f[j + hn]
                let y_re = f[j + t]
                let y_im = f[j + t + hn]
                f[j] = x_re + y_re
                f[j + hn] = x_im + y_im
                let d_re = x_re - y_re
                let d_im = x_im - y_im
                f[j + t] = d_re * s_re - d_im * s_im
                f[j + t + hn] = d_re * s_im + d_im * s_re
            }
            i1 += 1
            j1 += dt
        }
        t = dt
        m = hm
    }
    if log_n > 0 {
        let ni = power_of_two_inverse(log_n)
        for u in 0..n {
            f[u] = f[u] * ni
        }
    }
}

fn power_of_two_inverse(log_n: i64) -> f64 {
    var x = 2.0
    for _ in 0..log_n {
        x = x * 0.5
    }
    x
}

fn poly_add(a: f64[], b: f64[], n: i64) {
    for u in 0..n {
        a[u] = a[u] + b[u]
    }
}

fn poly_sub(a: f64[], b: f64[], n: i64) {
    for u in 0..n {
        a[u] = a[u] - b[u]
    }
}

fn poly_neg(a: f64[], n: i64) {
    for u in 0..n {
        a[u] = -a[u]
    }
}

fn poly_mul_fft(a: f64[], b: f64[], n: i64) {
    let hn = n >> 1
    for u in 0..hn {
        let a_re = a[u]
        let a_im = a[u + hn]
        let b_re = b[u]
        let b_im = b[u + hn]
        a[u] = a_re * b_re - a_im * b_im
        a[u + hn] = a_re * b_im + a_im * b_re
    }
}

fn poly_muladj_fft(a: f64[], b: f64[], n: i64) {
    let hn = n >> 1
    for u in 0..hn {
        let a_re = a[u]
        let a_im = a[u + hn]
        let b_re = b[u]
        let b_im = -b[u + hn]
        a[u] = a_re * b_re - a_im * b_im
        a[u + hn] = a_re * b_im + a_im * b_re
    }
}

fn poly_mulselfadj_fft(a: f64[], n: i64) {
    let hn = n >> 1
    for u in 0..hn {
        let a_re = a[u]
        let a_im = a[u + hn]
        a[u] = a_re * a_re + a_im * a_im
        a[u + hn] = 0.0
    }
}

fn poly_mulconst(a: f64[], x: f64, n: i64) {
    for u in 0..n {
        a[u] = a[u] * x
    }
}

fn poly_ldl_fft(g00: f64[], g01: f64[], g11: f64[], n: i64) {
    let hn = n >> 1
    for u in 0..hn {
        let g00_re = g00[u]
        let g00_im = g00[u + hn]
        let g01_re = g01[u]
        let g01_im = g01[u + hn]
        let m = 1.0 / (g00_re * g00_re + g00_im * g00_im)
        let b_re = g00_re * m
        let b_im = -g00_im * m
        let mu_re = g01_re * b_re - g01_im * b_im
        let mu_im = g01_re * b_im + g01_im * b_re
        let c_im = -g01_im
        let p_re = mu_re * g01_re - mu_im * c_im
        let p_im = mu_re * c_im + mu_im * g01_re
        g11[u] = g11[u] - p_re
        g11[u + hn] = g11[u + hn] - p_im
        g01[u] = mu_re
        g01[u + hn] = -mu_im
    }
}

fn poly_split_fft(gm: f64[], f0: f64[], f1: f64[], f: f64[], n: i64) {
    let hn = n >> 1
    let qn = hn >> 1
    f0[0] = f[0]
    f1[0] = f[hn]
    for u in 0..qn {
        let a_re = f[u << 1]
        let a_im = f[(u << 1) + hn]
        let b_re = f[(u << 1) + 1]
        let b_im = f[(u << 1) + 1 + hn]
        f0[u] = (a_re + b_re) * 0.5
        f0[u + qn] = (a_im + b_im) * 0.5
        let t_re = a_re - b_re
        let t_im = a_im - b_im
        let s_re = gm[(u + hn) << 1]
        let s_im = -gm[((u + hn) << 1) + 1]
        f1[u] = (t_re * s_re - t_im * s_im) * 0.5
        f1[u + qn] = (t_re * s_im + t_im * s_re) * 0.5
    }
}

fn poly_merge_fft(gm: f64[], f: f64[], f0: f64[], f1: f64[], n: i64) {
    let hn = n >> 1
    let qn = hn >> 1
    f[0] = f0[0]
    f[hn] = f1[0]
    for u in 0..qn {
        let a_re = f0[u]
        let a_im = f0[u + qn]
        let c_re = f1[u]
        let c_im = f1[u + qn]
        let s_re = gm[(u + hn) << 1]
        let s_im = gm[((u + hn) << 1) + 1]
        let b_re = c_re * s_re - c_im * s_im
        let b_im = c_re * s_im + c_im * s_re
        f[u << 1] = a_re + b_re
        f[(u << 1) + hn] = a_im + b_im
        f[(u << 1) + 1] = a_re - b_re
        f[(u << 1) + 1 + hn] = a_im - b_im
    }
}
